[
  {
    "id": "sent_1",
    "text": "李白与杜甫是中国古典诗歌发展史上双峰并峙的双子星座，",
    "start": 0.0,
    "end": 5.08,
    "duration": 5.08
  },
  {
    "id": "sent_2",
    "text": "共同代表了唐诗繁荣的最高巅峰。",
    "start": 5.609,
    "end": 8.209,
    "duration": 2.6
  },
  {
    "id": "sent_3",
    "text": "身处盛唐极盛向安史之乱剧变转折的不同历史节点，",
    "start": 8.659,
    "end": 13.059,
    "duration": 4.4
  },
  {
    "id": "sent_4",
    "text": "李白承接开元天宝昂扬开放的盛世风貌，",
    "start": 13.509,
    "end": 16.829,
    "duration": 3.32
  },
  {
    "id": "sent_5",
    "text": "将追求绝对精神自由的浪漫主义推向极致；",
    "start": 17.279,
    "end": 20.759,
    "duration": 3.48
  },
  {
    "id": "sent_6",
    "text": "杜甫面对天宝以后盛极而衰的战乱浩劫，将悲悯苍生、",
    "start": 21.209,
    "end": 25.969,
    "duration": 4.76
  },
  {
    "id": "sent_7",
    "text": "关怀家国的现实主义推向极境。",
    "start": 26.419,
    "end": 28.939,
    "duration": 2.52
  },
  {
    "id": "sent_8",
    "text": "韩愈赞云 “李杜文章在，光焰万丈长”；",
    "start": 29.469,
    "end": 32.629,
    "duration": 3.16
  },
  {
    "id": "sent_9",
    "text": "严羽 《沧浪诗话》 称 “少陵诗法如孙吴，太白诗法如李广”。",
    "start": 33.079,
    "end": 37.559,
    "duration": 4.48
  },
  {
    "id": "sent_10",
    "text": "二人在艺术风格、文体造诣与精神品格上的异同，",
    "start": 38.009,
    "end": 41.769,
    "duration": 3.76
  },
  {
    "id": "sent_11",
    "text": "主要展现为以下四个核心维度：",
    "start": 42.219,
    "end": 44.739,
    "duration": 2.52
  },
  {
    "id": "sent_12",
    "text": "第一，在时代坐标与精神追求上，",
    "start": 45.189,
    "end": 47.989,
    "duration": 2.8
  },
  {
    "id": "sent_13",
    "text": "呈现追求个体精神解放与承担家国忧患的显著差异。",
    "start": 48.439,
    "end": 52.799,
    "duration": 4.36
  },
  {
    "id": "sent_14",
    "text": "李白身处开元全盛时期，",
    "start": 53.249,
    "end": 55.529,
    "duration": 2.28
  },
  {
    "id": "sent_15",
    "text": "其思想深受道家庄子哲学与纵横家侠义精神浸润，",
    "start": 55.979,
    "end": 60.019,
    "duration": 4.04
  },
  {
    "id": "sent_16",
    "text": "塑造了一个傲立王侯、追求绝对个体自由的抒情主体。",
    "start": 60.469,
    "end": 64.589,
    "duration": 4.12
  },
  {
    "id": "sent_17",
    "text": "他宣告 “安能摧眉折腰事权贵”，",
    "start": 65.039,
    "end": 67.559,
    "duration": 2.52
  },
  {
    "id": "sent_18",
    "text": "洋溢着盛世文人强烈的自我确信与超拔神采；",
    "start": 68.009,
    "end": 71.609,
    "duration": 3.6
  },
  {
    "id": "sent_19",
    "text": "杜甫则亲历天宝乱离与国家沦丧，",
    "start": 72.059,
    "end": 74.899,
    "duration": 2.84
  },
  {
    "id": "sent_20",
    "text": "其思想牢牢扎根于儒家“仁民爱物”与“穷则独善其身，",
    "start": 75.349,
    "end": 79.789,
    "duration": 4.44
  },
  {
    "id": "sent_21",
    "text": "达则兼济天下”的传统。",
    "start": 80.239,
    "end": 82.119,
    "duration": 1.88
  },
  {
    "id": "sent_22",
    "text": "他始终将自身身世之悲系于天下安危，",
    "start": 82.569,
    "end": 85.649,
    "duration": 3.08
  },
  {
    "id": "sent_23",
    "text": "在 《自京赴奉先》 中发出 “穷年忧黎元，",
    "start": 86.099,
    "end": 89.179,
    "duration": 3.08
  },
  {
    "id": "sent_24",
    "text": "叹息肠内热” 的沉痛关怀。",
    "start": 89.629,
    "end": 91.709,
    "duration": 2.08
  },
  {
    "id": "sent_25",
    "text": "李白是盛唐自信个性的飞扬体现，",
    "start": 92.159,
    "end": 94.879,
    "duration": 2.72
  },
  {
    "id": "sent_26",
    "text": "杜甫是盛唐精神走向深沉反思的理性结晶。",
    "start": 95.329,
    "end": 99.169,
    "duration": 3.84
  },
  {
    "id": "sent_27",
    "text": "第二，在审美风貌与情感机制上，",
    "start": 99.619,
    "end": 102.459,
    "duration": 2.84
  },
  {
    "id": "sent_28",
    "text": "呈现飘逸奔放的清水芙蓉与波澜低回的沉郁顿挫。",
    "start": 102.909,
    "end": 107.349,
    "duration": 4.44
  },
  {
    "id": "sent_29",
    "text": "在风格机制上，李白崇尚 “清水出芙蓉，天然去雕饰”，",
    "start": 107.799,
    "end": 112.359,
    "duration": 4.56
  },
  {
    "id": "sent_30",
    "text": "其情感如大江奔涌，喷薄欲出而一泻千里。",
    "start": 112.809,
    "end": 116.409,
    "duration": 3.6
  },
  {
    "id": "sent_31",
    "text": "在 《将进酒》 中，",
    "start": 116.859,
    "end": 118.099,
    "duration": 1.24
  },
  {
    "id": "sent_32",
    "text": "以 “君不见黄河之水天上来” 的宏阔狂飙破题，",
    "start": 118.549,
    "end": 122.189,
    "duration": 3.64
  },
  {
    "id": "sent_33",
    "text": "诗情起伏跌宕却豪放洒脱；",
    "start": 122.639,
    "end": 125.079,
    "duration": 2.44
  },
  {
    "id": "sent_34",
    "text": "杜甫则以 “沉郁顿挫” 称绝，思想感情沉深宏厚，",
    "start": 125.529,
    "end": 129.489,
    "duration": 3.96
  },
  {
    "id": "sent_35",
    "text": "表现章法反复低回。",
    "start": 129.939,
    "end": 131.699,
    "duration": 1.76
  },
  {
    "id": "sent_36",
    "text": "在 《登高》 中，",
    "start": 132.149,
    "end": 133.229,
    "duration": 1.08
  },
  {
    "id": "sent_37",
    "text": "将万里悲秋的壮阔江天与老病孤舟的残年身世绞合在一起；",
    "start": 133.679,
    "end": 138.239,
    "duration": 4.56
  },
  {
    "id": "sent_38",
    "text": "在 《自京赴奉先》 中，历经四起四落的情感克制转折。",
    "start": 138.689,
    "end": 143.009,
    "duration": 4.32
  },
  {
    "id": "sent_39",
    "text": "李白之美在于飞扬壮阔的奇崛俊逸，",
    "start": 143.459,
    "end": 146.379,
    "duration": 2.92
  },
  {
    "id": "sent_40",
    "text": "杜甫之美在于郁结盘旋的深沉悲凉。",
    "start": 146.829,
    "end": 149.989,
    "duration": 3.16
  },
  {
    "id": "sent_41",
    "text": "第三，在表现手法与文体体裁上，",
    "start": 150.439,
    "end": 153.079,
    "duration": 2.64
  },
  {
    "id": "sent_42",
    "text": "呈现天马行空的古体歌行与精严化境的近体律诗。",
    "start": 153.529,
    "end": 157.889,
    "duration": 4.36
  },
  {
    "id": "sent_43",
    "text": "李白极力突破格律的束缚，",
    "start": 158.339,
    "end": 160.379,
    "duration": 2.04
  },
  {
    "id": "sent_44",
    "text": "将主要创造力倾注于三五七言错落舒卷的古题乐府与长篇歌行。",
    "start": 160.829,
    "end": 166.269,
    "duration": 5.44
  },
  {
    "id": "sent_45",
    "text": "在 《梦游天姥吟留别》《蜀道难》 中，",
    "start": 166.719,
    "end": 169.279,
    "duration": 2.56
  },
  {
    "id": "sent_46",
    "text": "自由驱遣天界神仙与宇宙极境，极尽大胆奇幻的夸张之能事；",
    "start": 169.728,
    "end": 174.728,
    "duration": 5.0
  },
  {
    "id": "sent_47",
    "text": "杜甫虽亦擅长古体叙事，",
    "start": 175.178,
    "end": 177.378,
    "duration": 2.2
  },
  {
    "id": "sent_48",
    "text": "但其最高艺术造诣在于对律诗体制的全面集大成。",
    "start": 177.828,
    "end": 181.868,
    "duration": 4.04
  },
  {
    "id": "sent_49",
    "text": "杜甫精研声病，晚年做到 “晚节渐于诗律细”，",
    "start": 182.318,
    "end": 185.758,
    "duration": 3.44
  },
  {
    "id": "sent_50",
    "text": "更创立 “拗救” 与变格手法。",
    "start": 186.288,
    "end": 188.248,
    "duration": 1.96
  },
  {
    "id": "sent_51",
    "text": "其 《秋兴八首》 将七律组诗推向登峰造极，",
    "start": 188.698,
    "end": 192.458,
    "duration": 3.76
  },
  {
    "id": "sent_52",
    "text": "做到了形式精严而又浑融流转，代表了近体诗律化的终极最高成就。",
    "start": 192.908,
    "end": 198.268,
    "duration": 5.36
  },
  {
    "id": "sent_53",
    "text": "第四，共同构建中国古典诗歌的审美双璧，",
    "start": 198.718,
    "end": 202.198,
    "duration": 3.48
  },
  {
    "id": "sent_54",
    "text": "确立不可动摇的万代宗师地位。",
    "start": 202.648,
    "end": 204.928,
    "duration": 2.28
  },
  {
    "id": "sent_55",
    "text": "李白与杜甫并非相互排斥，",
    "start": 205.378,
    "end": 207.658,
    "duration": 2.28
  },
  {
    "id": "sent_56",
    "text": "而是共同构成了中国诗歌精神的阴阳双翼。",
    "start": 208.108,
    "end": 211.348,
    "duration": 3.24
  },
  {
    "id": "sent_57",
    "text": "李白为后代历代文人提供了超越尘世功利、",
    "start": 211.798,
    "end": 215.318,
    "duration": 3.52
  },
  {
    "id": "sent_58",
    "text": "守护自由心灵的浪漫飞翔之翼；",
    "start": 215.768,
    "end": 218.328,
    "duration": 2.56
  },
  {
    "id": "sent_59",
    "text": "杜甫为后代士人树立了扎根大地、关怀生民疾苦的现实良心之锚。",
    "start": 218.778,
    "end": 224.218,
    "duration": 5.44
  },
  {
    "id": "sent_60",
    "text": "中唐韩孟诗派与北宋苏轼得力于李白的浪漫狂放与豪迈气势；",
    "start": 224.668,
    "end": 229.948,
    "duration": 5.28
  },
  {
    "id": "sent_61",
    "text": "白居易新乐府运动、",
    "start": 230.398,
    "end": 231.838,
    "duration": 1.44
  },
  {
    "id": "sent_62",
    "text": "宋代黄庭坚与江西诗派则取法于杜甫的写实规矩与精严法度。",
    "start": 232.408,
    "end": 238.288,
    "duration": 5.88
  },
  {
    "id": "sent_63",
    "text": "李杜双峰并峙，共同奠定了中国诗歌史上不可逾越的审美巅峰。",
    "start": 238.738,
    "end": 243.818,
    "duration": 5.08
  }
]