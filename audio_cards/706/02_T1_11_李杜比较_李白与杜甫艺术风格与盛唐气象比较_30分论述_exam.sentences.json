[
  {
    "id": "sent_1",
    "text": "李白与杜甫是中国古典诗歌发展史上双峰并峙的双子星座，",
    "start": 0.1,
    "end": 5.779,
    "duration": 5.679
  },
  {
    "id": "sent_2",
    "text": "共同代表了唐诗繁荣的最高巅峰。",
    "start": 5.729,
    "end": 8.984,
    "duration": 3.255
  },
  {
    "id": "sent_3",
    "text": "身处盛唐极盛向安史之乱剧变转折的不同历史节点，",
    "start": 8.984,
    "end": 13.958,
    "duration": 4.974
  },
  {
    "id": "sent_4",
    "text": "李白承接开元天宝昂扬开放的盛世风貌，",
    "start": 13.958,
    "end": 17.773,
    "duration": 3.815
  },
  {
    "id": "sent_5",
    "text": "将追求绝对精神自由的浪漫主义推向极致；",
    "start": 17.773,
    "end": 22.083,
    "duration": 4.31
  },
  {
    "id": "sent_6",
    "text": "杜甫面对天宝以后盛极而衰的战乱浩劫，",
    "start": 22.083,
    "end": 25.937,
    "duration": 3.854
  },
  {
    "id": "sent_7",
    "text": "将悲悯苍生、关怀家国的现实主义推向极境。",
    "start": 25.938,
    "end": 30.691,
    "duration": 4.753
  },
  {
    "id": "sent_8",
    "text": "韩愈赞云 “李杜文章在，光焰万丈长”；",
    "start": 30.69,
    "end": 34.388,
    "duration": 3.698
  },
  {
    "id": "sent_9",
    "text": "严羽 《沧浪诗话》 称 “少陵诗法如孙吴，太白诗法如李广”。",
    "start": 34.388,
    "end": 39.427,
    "duration": 5.039
  },
  {
    "id": "sent_10",
    "text": "二人在艺术风格、文体造诣与精神品格上的异同，",
    "start": 39.427,
    "end": 44.128,
    "duration": 4.701
  },
  {
    "id": "sent_11",
    "text": "主要展现为以下四个核心维度：",
    "start": 44.128,
    "end": 47.435,
    "duration": 3.307
  },
  {
    "id": "sent_12",
    "text": "第一，在时代坐标与精神追求上，",
    "start": 47.435,
    "end": 50.886,
    "duration": 3.451
  },
  {
    "id": "sent_13",
    "text": "呈现追求个体精神解放与承担家国忧患的显著差异。",
    "start": 50.885,
    "end": 55.924,
    "duration": 5.039
  },
  {
    "id": "sent_14",
    "text": "李白身处开元全盛时期，",
    "start": 55.924,
    "end": 58.554,
    "duration": 2.63
  },
  {
    "id": "sent_15",
    "text": "其思想深受道家庄子哲学与纵横家侠义精神浸润，",
    "start": 58.555,
    "end": 63.815,
    "duration": 5.26
  },
  {
    "id": "sent_16",
    "text": "塑造了一个傲立王侯、追求绝对个体自由的抒情主体。",
    "start": 63.815,
    "end": 68.919,
    "duration": 5.104
  },
  {
    "id": "sent_17",
    "text": "他宣告 “安能摧眉折腰事权贵”，",
    "start": 68.919,
    "end": 72.096,
    "duration": 3.177
  },
  {
    "id": "sent_18",
    "text": "洋溢着盛世文人强烈的自我确信与超拔神采；",
    "start": 72.096,
    "end": 76.588,
    "duration": 4.492
  },
  {
    "id": "sent_19",
    "text": "杜甫则亲历天宝乱离与国家沦丧，",
    "start": 76.589,
    "end": 80.325,
    "duration": 3.736
  },
  {
    "id": "sent_20",
    "text": "其思想牢牢扎根于儒家“仁民爱物”与“穷则独善其身，",
    "start": 80.325,
    "end": 85.182,
    "duration": 4.857
  },
  {
    "id": "sent_21",
    "text": "达则兼济天下”的传统。",
    "start": 85.182,
    "end": 87.604,
    "duration": 2.422
  },
  {
    "id": "sent_22",
    "text": "他始终将自身身世之悲系于天下安危，",
    "start": 87.604,
    "end": 91.601,
    "duration": 3.997
  },
  {
    "id": "sent_23",
    "text": "在 《自京赴奉先》 中发出 “穷年忧黎元，",
    "start": 91.602,
    "end": 95.378,
    "duration": 3.776
  },
  {
    "id": "sent_24",
    "text": "叹息肠内热” 的沉痛关怀。",
    "start": 95.378,
    "end": 98.112,
    "duration": 2.734
  },
  {
    "id": "sent_25",
    "text": "李白是盛唐自信个性的飞扬体现，",
    "start": 98.112,
    "end": 101.667,
    "duration": 3.555
  },
  {
    "id": "sent_26",
    "text": "杜甫是盛唐精神走向深沉反思的理性结晶。",
    "start": 101.667,
    "end": 106.159,
    "duration": 4.492
  },
  {
    "id": "sent_27",
    "text": "第二，在审美风貌与情感机制上，",
    "start": 106.159,
    "end": 109.57,
    "duration": 3.411
  },
  {
    "id": "sent_28",
    "text": "呈现飘逸奔放的清水芙蓉与波澜低回的沉郁顿挫。",
    "start": 109.57,
    "end": 114.388,
    "duration": 4.818
  },
  {
    "id": "sent_29",
    "text": "在风格机制上，李白崇尚 “清水出芙蓉，天然去雕饰”，",
    "start": 114.388,
    "end": 119.492,
    "duration": 5.104
  },
  {
    "id": "sent_30",
    "text": "其情感如大江奔涌，喷薄欲出而一泻千里。",
    "start": 119.492,
    "end": 123.893,
    "duration": 4.401
  },
  {
    "id": "sent_31",
    "text": "在 《将进酒》 中，",
    "start": 123.893,
    "end": 125.729,
    "duration": 1.836
  },
  {
    "id": "sent_32",
    "text": "以 “君不见黄河之水天上来” 的宏阔狂飙破题，",
    "start": 125.729,
    "end": 129.935,
    "duration": 4.206
  },
  {
    "id": "sent_33",
    "text": "诗情起伏跌宕却豪放洒脱；",
    "start": 129.935,
    "end": 132.956,
    "duration": 3.021
  },
  {
    "id": "sent_34",
    "text": "杜甫则以 “沉郁顿挫” 称绝，思想感情沉深宏厚，",
    "start": 132.956,
    "end": 137.735,
    "duration": 4.779
  },
  {
    "id": "sent_35",
    "text": "表现章法反复低回。",
    "start": 137.734,
    "end": 140.091,
    "duration": 2.357
  },
  {
    "id": "sent_36",
    "text": "在 《登高》 中，",
    "start": 140.091,
    "end": 141.653,
    "duration": 1.562
  },
  {
    "id": "sent_37",
    "text": "将万里悲秋的壮阔江天与老病孤舟的残年身世绞合在一起；",
    "start": 141.654,
    "end": 147.37,
    "duration": 5.716
  },
  {
    "id": "sent_38",
    "text": "在 《自京赴奉先》 中，历经四起四落的情感克制转折。",
    "start": 147.37,
    "end": 152.396,
    "duration": 5.026
  },
  {
    "id": "sent_39",
    "text": "李白之美在于飞扬壮阔的奇崛俊逸，杜甫之美在于郁结盘旋的深沉悲凉。",
    "start": 152.396,
    "end": 159.753,
    "duration": 7.357
  },
  {
    "id": "sent_40",
    "text": "第三，在表现手法与文体体裁上，",
    "start": 159.753,
    "end": 163.191,
    "duration": 3.438
  },
  {
    "id": "sent_41",
    "text": "呈现天马行空的古体歌行与精严化境的近体律诗。",
    "start": 163.19,
    "end": 168.034,
    "duration": 4.844
  },
  {
    "id": "sent_42",
    "text": "李白极力突破格律的束缚，",
    "start": 168.034,
    "end": 170.677,
    "duration": 2.643
  },
  {
    "id": "sent_43",
    "text": "将主要创造力倾注于三五七言错落舒卷的古题乐府与长篇歌行。",
    "start": 170.677,
    "end": 176.822,
    "duration": 6.145
  },
  {
    "id": "sent_44",
    "text": "在 《梦游天姥吟留别》《蜀道难》 中，",
    "start": 176.822,
    "end": 180.091,
    "duration": 3.269
  },
  {
    "id": "sent_45",
    "text": "自由驱遣天界神仙与宇宙极境，极尽大胆奇幻的夸张之能事；",
    "start": 180.091,
    "end": 186.289,
    "duration": 6.198
  },
  {
    "id": "sent_46",
    "text": "杜甫虽亦擅长古体叙事，",
    "start": 186.289,
    "end": 188.997,
    "duration": 2.708
  },
  {
    "id": "sent_47",
    "text": "但其最高艺术造诣在于对律诗体制的全面集大成。",
    "start": 188.997,
    "end": 193.698,
    "duration": 4.701
  },
  {
    "id": "sent_48",
    "text": "杜甫精研声病，晚年做到 “晚节渐于诗律细”，",
    "start": 193.698,
    "end": 197.76,
    "duration": 4.062
  },
  {
    "id": "sent_49",
    "text": "更创立 “拗救” 与变格手法。",
    "start": 197.76,
    "end": 200.533,
    "duration": 2.773
  },
  {
    "id": "sent_50",
    "text": "其 《秋兴八首》 将七律组诗推向登峰造极，",
    "start": 200.534,
    "end": 204.636,
    "duration": 4.102
  },
  {
    "id": "sent_51",
    "text": "做到了形式精严而又浑融流转，代表了近体诗律化的终极最高成就。",
    "start": 204.635,
    "end": 210.976,
    "duration": 6.341
  },
  {
    "id": "sent_52",
    "text": "第四，共同构建中国古典诗歌的审美双璧，",
    "start": 210.977,
    "end": 215.131,
    "duration": 4.154
  },
  {
    "id": "sent_53",
    "text": "确立不可动摇的万代宗师地位。",
    "start": 215.13,
    "end": 218.242,
    "duration": 3.112
  },
  {
    "id": "sent_54",
    "text": "李白与杜甫并非相互排斥，而是共同构成了中国诗歌精神的阴阳双翼。",
    "start": 218.242,
    "end": 225.052,
    "duration": 6.81
  },
  {
    "id": "sent_55",
    "text": "李白为后代历代文人提供了超越尘世功利、守护自由心灵的浪漫飞翔之翼；",
    "start": 225.052,
    "end": 232.018,
    "duration": 6.966
  },
  {
    "id": "sent_56",
    "text": "杜甫为后代士人树立了扎根大地、关怀生民疾苦的现实良心之锚。",
    "start": 232.018,
    "end": 238.32,
    "duration": 6.302
  },
  {
    "id": "sent_57",
    "text": "中唐韩孟诗派与北宋苏轼得力于李白的浪漫狂放与豪迈气势；",
    "start": 238.32,
    "end": 244.336,
    "duration": 6.016
  },
  {
    "id": "sent_58",
    "text": "白居易新乐府运动、宋代黄庭坚与江西诗派则取法于杜甫的写实规矩与精严法度。",
    "start": 244.336,
    "end": 251.94,
    "duration": 7.604
  },
  {
    "id": "sent_59",
    "text": "李杜双峰并峙，共同奠定了中国诗歌史上不可逾越的审美巅峰。",
    "start": 251.94,
    "end": 257.878,
    "duration": 5.938
  }
]