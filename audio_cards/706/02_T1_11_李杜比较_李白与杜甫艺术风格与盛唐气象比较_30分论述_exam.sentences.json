[
  {
    "id": 1,
    "text": "试论李白与杜甫艺术风格的异同及其在唐代诗歌史上的地位。",
    "start": 0.28,
    "end": 5.56,
    "duration": 5.28
  },
  {
    "id": 2,
    "text": "李白与杜甫是中国古典诗歌史上双峰并峙的伟大诗人，共同代表了唐诗繁荣的高峰。",
    "start": 6.08,
    "end": 12.88,
    "duration": 6.8
  },
  {
    "id": 3,
    "text": "李白承接开元盛世昂扬开放的时代风貌，把浪漫主义诗风推向极盛；",
    "start": 13.4,
    "end": 18.84,
    "duration": 5.44
  },
  {
    "id": 4,
    "text": "杜甫亲历天宝由盛转衰的战乱浩劫，将关怀苍生的现实主义传统发扬光大。",
    "start": 19.36,
    "end": 25.2,
    "duration": 5.84
  },
  {
    "id": 5,
    "text": "杜甫赞李白“笔落惊风雨，诗成泣鬼神”，韩愈亦赞“李杜文章在，光焰万丈长”。",
    "start": 25.72,
    "end": 33.56,
    "duration": 7.84
  },
  {
    "id": 6,
    "text": "二人在思想追求、审美风貌、体裁造诣与诗史影响上的异同，主要体现在以下四个方面：",
    "start": 34.08,
    "end": 40.72,
    "duration": 6.64
  },
  {
    "id": 7,
    "text": "第一，分立个体精神解放与家国忧患之志，共映盛唐时代脉搏。",
    "start": 41.09,
    "end": 46.61,
    "duration": 5.52
  },
  {
    "id": 8,
    "text": "时代坐标与思想渊源塑造了二人不同的精神追求。",
    "start": 47.159,
    "end": 50.81,
    "duration": 3.651
  },
  {
    "id": 9,
    "text": "李白身处盛唐全盛之际，思想兼融道家逍遥、侠义任情与建功抱负，",
    "start": 51.33,
    "end": 57.89,
    "duration": 6.56
  },
  {
    "id": 10,
    "text": "塑造出傲立王侯、向往精神自由的抒情主体，",
    "start": 58.26,
    "end": 61.78,
    "duration": 3.52
  },
  {
    "id": 11,
    "text": "高呼“安能摧眉折腰事权贵”，洋溢着盛世文人的自信神采；",
    "start": 62.15,
    "end": 66.47,
    "duration": 4.32
  },
  {
    "id": 12,
    "text": "杜甫亲历安史乱离，思想深深扎根于儒家“仁民爱物”与“兼济天下”传统，",
    "start": 66.99,
    "end": 73.23,
    "duration": 6.24
  },
  {
    "id": 13,
    "text": "始终将身世之悲系于国家安危，",
    "start": 73.6,
    "end": 76.24,
    "duration": 2.64
  },
  {
    "id": 14,
    "text": "在《自京赴奉先县咏怀五百字》中发出“穷年忧黎元，叹息肠内热”的沉痛关怀。",
    "start": 76.72,
    "end": 84.24,
    "duration": 7.52
  },
  {
    "id": 15,
    "text": "李白体现了盛唐个性的飞扬，杜甫则体现了盛唐精神转向深沉反思的担当。",
    "start": 84.76,
    "end": 91.56,
    "duration": 6.8
  },
  {
    "id": 16,
    "text": "第二，分呈飘逸奔放与沉郁顿挫风貌，各臻抒情艺术化境。",
    "start": 92.08,
    "end": 97.76,
    "duration": 5.68
  },
  {
    "id": 17,
    "text": "在审美风貌与情感机制上，李白崇尚“清水出芙蓉，天然去雕饰”，情感如大江奔涌、一泻千里。",
    "start": 98.28,
    "end": 107.0,
    "duration": 8.72
  },
  {
    "id": 18,
    "text": "如《将进酒》以“君不见黄河之水天上来”破题，纵横狂放而豪迈洒脱；",
    "start": 107.52,
    "end": 113.68,
    "duration": 6.16
  },
  {
    "id": 19,
    "text": "杜甫则以“沉郁顿挫”称绝，情感沉深宏厚，表达反复低回。",
    "start": 114.2,
    "end": 119.966,
    "duration": 5.766
  },
  {
    "id": 20,
    "text": "如《登高》将万里悲秋的江天与百年多病的身世交融，",
    "start": 120.466,
    "end": 124.64,
    "duration": 4.174
  },
  {
    "id": 21,
    "text": "《自京赴奉先县咏怀五百字》历经四起四落的感情克制与回旋。",
    "start": 125.01,
    "end": 130.53,
    "duration": 5.52
  },
  {
    "id": 22,
    "text": "李白之美在于飞扬奇伟的豪迈俊逸，杜甫之美在于深沉悲慨的郁勃低回。",
    "start": 131.05,
    "end": 137.05,
    "duration": 6.0
  },
  {
    "id": 23,
    "text": "第三，一擅古体歌行之纵横驰骋，一集近体律诗之精严法度。",
    "start": 137.57,
    "end": 143.33,
    "duration": 5.76
  },
  {
    "id": 24,
    "text": "在文体与技法选择上，李白力求摆脱声律羁绊，",
    "start": 143.85,
    "end": 147.53,
    "duration": 3.68
  },
  {
    "id": 25,
    "text": "将主要才情倾注于三、五、七言杂陈的古题乐府与长篇歌行，",
    "start": 147.9,
    "end": 152.94,
    "duration": 5.04
  },
  {
    "id": 26,
    "text": "如《梦游天姥吟留别》《蜀道难》驱遣神话星辰，",
    "start": 153.31,
    "end": 157.63,
    "duration": 4.32
  },
  {
    "id": 27,
    "text": "极尽大胆夸张与奇幻想象之妙，且兼擅五、七言绝句的自然天成；",
    "start": 158.0,
    "end": 163.76,
    "duration": 5.76
  },
  {
    "id": 28,
    "text": "杜甫虽亦长于古体叙事，最高艺术成就却在集律诗之大成。",
    "start": 164.28,
    "end": 169.32,
    "duration": 5.04
  },
  {
    "id": 29,
    "text": "他精研声律对仗，晚年追求“晚节渐于诗律细”，善用“拗救”与组诗体制，",
    "start": 169.84,
    "end": 176.13,
    "duration": 6.29
  },
  {
    "id": 30,
    "text": "其《秋兴八首》将七律写得浑融流转而法度精严，代表了近体诗艺术的最高成就。",
    "start": 176.5,
    "end": 183.38,
    "duration": 6.88
  },
  {
    "id": 31,
    "text": "第四，共筑中国古典诗歌审美双璧，开启后代浪漫与写实两大流派。",
    "start": 183.9,
    "end": 189.58,
    "duration": 5.68
  },
  {
    "id": 32,
    "text": "李白与杜甫相辅相成，共同撑起中国古典诗歌的精神高度。",
    "start": 190.1,
    "end": 194.98,
    "duration": 4.88
  },
  {
    "id": 33,
    "text": "李白以其飘逸豪放与个性解放，启迪了中唐韩孟的奇崛诗思与宋代苏轼、陆游的豪迈诗风；",
    "start": 195.5,
    "end": 203.5,
    "duration": 8.0
  },
  {
    "id": 34,
    "text": "杜甫以其写实精神与精严法度，深刻启迪了中唐白居易的新乐府运动，并为宋代黄庭坚与江西诗派所宗尚。",
    "start": 204.02,
    "end": 213.06,
    "duration": 9.04
  },
  {
    "id": 35,
    "text": "李杜双峰并峙，在中国诗歌史上树立起浪漫与现实两大典范。",
    "start": 213.58,
    "end": 219.02,
    "duration": 5.44
  },
  {
    "id": 36,
    "text": "综上所述，李白与杜甫以各自鲜明的时代感受与艺术个性，",
    "start": 219.54,
    "end": 224.26,
    "duration": 4.72
  },
  {
    "id": 37,
    "text": "共同映照出盛唐由鼎盛转入动荡的完整历史脉搏。",
    "start": 224.63,
    "end": 228.79,
    "duration": 4.16
  },
  {
    "id": 38,
    "text": "李白以飘逸狂放拓展了古体歌行与绝句的浪漫境界，",
    "start": 229.31,
    "end": 233.87,
    "duration": 4.56
  },
  {
    "id": 39,
    "text": "杜甫则以沉郁顿挫与精严律法把写实诗史推至巅峰，二人互补共存，",
    "start": 234.24,
    "end": 240.32,
    "duration": 6.08
  },
  {
    "id": 40,
    "text": "开启了后代古典诗歌浪漫与现实并行的双流传统。",
    "start": 240.69,
    "end": 244.45,
    "duration": 3.76
  }
]
