[
  {
    "id": 1,
    "text": "试论李白与杜甫艺术风格的异同及其在唐代诗歌史上的地位。",
    "start": 0.134,
    "end": 4.626,
    "duration": 4.492
  },
  {
    "id": 2,
    "text": "李白与杜甫是中国古典诗歌史上双峰并峙的伟大诗人，共同代表了唐诗繁荣的高峰。",
    "start": 5.263,
    "end": 12.075,
    "duration": 6.812
  },
  {
    "id": 3,
    "text": "李白承接开元盛世昂扬开放的时代风貌，把浪漫主义诗风推向极盛；",
    "start": 12.793,
    "end": 15.965,
    "duration": 3.172
  },
  {
    "id": 4,
    "text": "杜甫亲历天宝由盛转衰的战乱浩劫，将关怀苍生的现实主义传统发扬光大。",
    "start": 16.494,
    "end": 18.466,
    "duration": 1.972
  },
  {
    "id": 5,
    "text": "杜甫赞李白“笔落惊风雨，诗成泣鬼神”，韩愈亦赞“李杜文章在，光焰万丈长”。",
    "start": 19.144,
    "end": 25.236,
    "duration": 6.092
  },
  {
    "id": 6,
    "text": "二人在思想追求、审美风貌、体裁造诣与诗史影响上的异同，主要体现在以下四个方面：",
    "start": 25.914,
    "end": 32.926,
    "duration": 7.012
  },
  {
    "id": 7,
    "text": "第一，分立个体精神解放与家国忧患之志，共映盛唐时代脉搏。",
    "start": 33.644,
    "end": 45.656,
    "duration": 12.012
  },
  {
    "id": 8,
    "text": "时代坐标与思想渊源塑造了二人不同的精神追求。",
    "start": 46.374,
    "end": 49.986,
    "duration": 3.612
  },
  {
    "id": 9,
    "text": "李白身处盛唐全盛之际，思想兼融道家逍遥、侠义任情与建功抱负，",
    "start": 50.704,
    "end": 56.636,
    "duration": 5.932
  },
  {
    "id": 10,
    "text": "塑造出傲立王侯、向往精神自由的抒情主体，",
    "start": 57.015,
    "end": 60.787,
    "duration": 3.772
  },
  {
    "id": 11,
    "text": "高呼“安能摧眉折腰事权贵”，洋溢着盛世文人的自信神采；",
    "start": 61.166,
    "end": 65.618,
    "duration": 4.452
  },
  {
    "id": 12,
    "text": "杜甫亲历安史乱离，思想深深扎根于儒家“仁民爱物”与“兼济天下”传统，",
    "start": 66.336,
    "end": 74.988,
    "duration": 8.652
  },
  {
    "id": 13,
    "text": "始终将身世之悲系于国家安危，",
    "start": 75.499,
    "end": 79.351,
    "duration": 3.852
  },
  {
    "id": 14,
    "text": "在《自京赴奉先县咏怀五百字》中发出“穷年忧黎元，叹息肠内热”的沉痛关怀。",
    "start": 79.73,
    "end": 81.702,
    "duration": 1.972
  },
  {
    "id": 15,
    "text": "李白体现了盛唐个性的飞扬，杜甫则体现了盛唐精神转向深沉反思的担当。",
    "start": 82.437,
    "end": 88.129,
    "duration": 5.692
  },
  {
    "id": 16,
    "text": "第二，分呈飘逸奔放与沉郁顿挫风貌，各臻抒情艺术化境。",
    "start": 88.807,
    "end": 93.499,
    "duration": 4.692
  },
  {
    "id": 17,
    "text": "在审美风貌与情感机制上，李白崇尚“清水出芙蓉，天然去雕饰”，情感如大江奔涌、一泻千里。",
    "start": 94.177,
    "end": 101.989,
    "duration": 7.812
  },
  {
    "id": 18,
    "text": "如《将进酒》以“君不见黄河之水天上来”破题，纵横狂放而豪迈洒脱；",
    "start": 102.707,
    "end": 106.119,
    "duration": 3.412
  },
  {
    "id": 19,
    "text": "杜甫则以“沉郁顿挫”称绝，情感沉深宏厚，表达反复低回。",
    "start": 106.648,
    "end": 108.46,
    "duration": 1.812
  },
  {
    "id": 20,
    "text": "如《登高》将万里悲秋的江天与百年多病的身世交融，",
    "start": 109.178,
    "end": 117.55,
    "duration": 8.372
  },
  {
    "id": 21,
    "text": "《自京赴奉先县咏怀五百字》历经四起四落的感情克制与回旋。",
    "start": 117.929,
    "end": 122.621,
    "duration": 4.692
  },
  {
    "id": 22,
    "text": "李白之美在于飞扬奇伟的豪迈俊逸，杜甫之美在于深沉悲慨的郁勃低回。",
    "start": 123.15,
    "end": 129.122,
    "duration": 5.972
  },
  {
    "id": 23,
    "text": "第三，一擅古体歌行之纵横驰骋，一集近体律诗之精严法度。",
    "start": 129.746,
    "end": 135.358,
    "duration": 5.612
  },
  {
    "id": 24,
    "text": "在文体与技法选择上，李白力求摆脱声律羁绊，",
    "start": 135.996,
    "end": 139.608,
    "duration": 3.612
  },
  {
    "id": 25,
    "text": "将主要才情倾注于三、五、七言杂陈的古题乐府与长篇歌行，",
    "start": 139.987,
    "end": 144.559,
    "duration": 4.572
  },
  {
    "id": 26,
    "text": "如《梦游天姥吟留别》《蜀道难》驱遣神话星辰，",
    "start": 145.109,
    "end": 148.721,
    "duration": 3.612
  },
  {
    "id": 27,
    "text": "极尽大胆夸张与奇幻想象之妙，且兼擅五、七言绝句的自然天成；",
    "start": 149.1,
    "end": 154.072,
    "duration": 4.972
  },
  {
    "id": 28,
    "text": "杜甫虽亦长于古体叙事，最高艺术成就却在集律诗之大成。",
    "start": 154.848,
    "end": 159.58,
    "duration": 4.732
  },
  {
    "id": 29,
    "text": "他精研声律对仗，晚年追求“晚节渐于诗律细”，善用“拗救”与组诗体制，",
    "start": 160.298,
    "end": 165.67,
    "duration": 5.372
  },
  {
    "id": 30,
    "text": "其《秋兴八首》将七律写得浑融流转而法度精严，代表了近体诗艺术的最高成就。",
    "start": 166.049,
    "end": 171.861,
    "duration": 5.812
  },
  {
    "id": 31,
    "text": "第四，共筑中国古典诗歌审美双璧，开启后代浪漫与写实两大流派。",
    "start": 172.499,
    "end": 178.071,
    "duration": 5.572
  },
  {
    "id": 32,
    "text": "李白与杜甫相辅相成，共同撑起中国古典诗歌的精神高度。",
    "start": 178.749,
    "end": 182.921,
    "duration": 4.172
  },
  {
    "id": 33,
    "text": "李白以其飘逸豪放与个性解放，启迪了中唐韩孟的奇崛诗思与宋代苏轼、陆游的豪迈诗风；",
    "start": 183.559,
    "end": 185.891,
    "duration": 2.332
  },
  {
    "id": 34,
    "text": "杜甫以其写实精神与精严法度，深刻启迪了中唐白居易的新乐府运动，并为宋代黄庭坚与江西诗派所宗尚。",
    "start": 186.42,
    "end": 191.152,
    "duration": 4.732
  },
  {
    "id": 35,
    "text": "李杜双峰并峙，在中国诗歌史上树立起浪漫与现实两大典范。",
    "start": 191.87,
    "end": 200.722,
    "duration": 8.852
  },
  {
    "id": 36,
    "text": "综上所述，李白与杜甫以各自鲜明的时代感受与艺术个性，",
    "start": 201.4,
    "end": 203.732,
    "duration": 2.332
  },
  {
    "id": 37,
    "text": "共同映照出盛唐由鼎盛转入动荡的完整历史脉搏。",
    "start": 204.111,
    "end": 206.483,
    "duration": 2.372
  },
  {
    "id": 38,
    "text": "李白以飘逸狂放拓展了古体歌行与绝句的浪漫境界，",
    "start": 207.161,
    "end": 211.893,
    "duration": 4.732
  },
  {
    "id": 39,
    "text": "杜甫则以沉郁顿挫与精严律法把写实诗史推至巅峰，二人互补共存，",
    "start": 212.272,
    "end": 227.187,
    "duration": 14.915
  },
  {
    "id": 40,
    "text": "开启了后代古典诗歌浪漫与现实并行的双流传统。",
    "start": 227.78,
    "end": 231.672,
    "duration": 3.892
  }
]