[
  {
    "id": 1,
    "text": "试论李白与杜甫艺术风格的异同及其在唐代诗歌史上的地位。",
    "start": 0.0,
    "end": 5.764,
    "duration": 5.764
  },
  {
    "id": 2,
    "text": "李白与杜甫是中国古典诗歌发展史上双峰并峙的双子星座，",
    "start": 5.764,
    "end": 11.076,
    "duration": 5.312
  },
  {
    "id": 3,
    "text": "共同代表了唐诗繁荣的最高巅峰。",
    "start": 11.076,
    "end": 14.614,
    "duration": 3.538
  },
  {
    "id": 4,
    "text": "身处盛唐极盛向安史之乱剧变转折的不同历史节点，",
    "start": 14.614,
    "end": 19.334,
    "duration": 4.72
  },
  {
    "id": 5,
    "text": "李白承接开元天宝昂扬开放的盛世风貌，",
    "start": 19.334,
    "end": 22.836,
    "duration": 3.502
  },
  {
    "id": 6,
    "text": "将追求绝对精神自由的浪漫主义推向极致；",
    "start": 22.836,
    "end": 26.458,
    "duration": 3.622
  },
  {
    "id": 7,
    "text": "杜甫面对天宝以后盛极而衰的战乱浩劫，将悲悯苍生、",
    "start": 26.458,
    "end": 31.364,
    "duration": 4.906
  },
  {
    "id": 8,
    "text": "关怀家国的现实主义推向极境。",
    "start": 31.364,
    "end": 34.301,
    "duration": 2.937
  },
  {
    "id": 9,
    "text": "韩愈赞云 “李杜文章在，光焰万丈长”；",
    "start": 34.301,
    "end": 39.809,
    "duration": 5.508
  },
  {
    "id": 10,
    "text": "严羽 《沧浪诗话》 称 “少陵诗法如孙吴，",
    "start": 39.809,
    "end": 41.878,
    "duration": 2.069
  },
  {
    "id": 11,
    "text": "太白诗法如李广”。",
    "start": 41.878,
    "end": 43.525,
    "duration": 1.647
  },
  {
    "id": 12,
    "text": "二人在艺术风格、文体造诣与精神品格上的异同，",
    "start": 43.525,
    "end": 49.974,
    "duration": 6.449
  },
  {
    "id": 13,
    "text": "主要展现为以下四个核心维度：",
    "start": 49.974,
    "end": 52.928,
    "duration": 2.954
  },
  {
    "id": 14,
    "text": "第一，在时代坐标与精神追求上，",
    "start": 52.928,
    "end": 55.182,
    "duration": 2.254
  },
  {
    "id": 15,
    "text": "呈现追求个体精神解放与承担家国忧患的显著差异。",
    "start": 55.182,
    "end": 59.858,
    "duration": 4.676
  },
  {
    "id": 16,
    "text": "李白身处开元全盛时期，",
    "start": 59.858,
    "end": 62.313,
    "duration": 2.455
  },
  {
    "id": 17,
    "text": "其思想深受道家庄子哲学与纵横家侠义精神浸润，",
    "start": 62.313,
    "end": 66.214,
    "duration": 3.901
  },
  {
    "id": 18,
    "text": "塑造了一个傲立王侯、追求绝对个体自由的抒情主体。",
    "start": 66.214,
    "end": 71.48,
    "duration": 5.266
  },
  {
    "id": 19,
    "text": "他宣告 “安能摧眉折腰事权贵”，",
    "start": 71.48,
    "end": 74.199,
    "duration": 2.719
  },
  {
    "id": 20,
    "text": "洋溢着盛世文人强烈的自我确信与超拔神采；",
    "start": 74.199,
    "end": 78.352,
    "duration": 4.153
  },
  {
    "id": 21,
    "text": "杜甫则亲历天宝乱离与国家沦丧，",
    "start": 78.352,
    "end": 81.736,
    "duration": 3.384
  },
  {
    "id": 22,
    "text": "其思想牢牢扎根于儒家“仁民爱物”与“穷则独善其身，",
    "start": 81.736,
    "end": 88.684,
    "duration": 6.948
  },
  {
    "id": 23,
    "text": "达则兼济天下”的传统。",
    "start": 88.684,
    "end": 90.765,
    "duration": 2.081
  },
  {
    "id": 24,
    "text": "他始终将自身身世之悲系于天下安危，",
    "start": 90.765,
    "end": 94.616,
    "duration": 3.851
  },
  {
    "id": 25,
    "text": "在 《自京赴奉先》 中发出 “穷年忧黎元，",
    "start": 94.616,
    "end": 97.552,
    "duration": 2.936
  },
  {
    "id": 26,
    "text": "叹息肠内热” 的沉痛关怀。",
    "start": 97.552,
    "end": 101.275,
    "duration": 3.723
  },
  {
    "id": 27,
    "text": "李白是盛唐自信个性的飞扬体现，",
    "start": 101.275,
    "end": 104.209,
    "duration": 2.934
  },
  {
    "id": 28,
    "text": "杜甫是盛唐精神走向深沉反思的理性结晶。",
    "start": 104.209,
    "end": 108.423,
    "duration": 4.214
  },
  {
    "id": 29,
    "text": "第二，在审美风貌与情感机制上，",
    "start": 108.423,
    "end": 109.716,
    "duration": 1.293
  },
  {
    "id": 30,
    "text": "呈现飘逸奔放的清水芙蓉与波澜低回的沉郁顿挫。",
    "start": 109.716,
    "end": 116.224,
    "duration": 6.508
  },
  {
    "id": 31,
    "text": "在风格机制上，李白崇尚 “清水出芙蓉，天然去雕饰”，",
    "start": 116.224,
    "end": 121.981,
    "duration": 5.757
  },
  {
    "id": 32,
    "text": "其情感如大江奔涌，喷薄欲出而一泻千里。",
    "start": 121.981,
    "end": 125.145,
    "duration": 3.164
  },
  {
    "id": 33,
    "text": "在 《将进酒》 中，",
    "start": 125.145,
    "end": 127.459,
    "duration": 2.314
  },
  {
    "id": 34,
    "text": "以 “君不见黄河之水天上来” 的宏阔狂飙破题，",
    "start": 127.459,
    "end": 131.366,
    "duration": 3.907
  },
  {
    "id": 35,
    "text": "诗情起伏跌宕却豪放洒脱；杜甫则以 “沉郁顿挫” 称绝，",
    "start": 131.366,
    "end": 134.767,
    "duration": 3.401
  },
  {
    "id": 36,
    "text": "思想感情沉深宏厚，表现章法反复低回。",
    "start": 134.767,
    "end": 137.983,
    "duration": 3.216
  },
  {
    "id": 37,
    "text": "在 《登高》 中，",
    "start": 137.983,
    "end": 139.843,
    "duration": 1.86
  },
  {
    "id": 38,
    "text": "将万里悲秋的壮阔江天与老病孤舟的残年身世绞合在一起；",
    "start": 139.843,
    "end": 145.915,
    "duration": 6.072
  },
  {
    "id": 39,
    "text": "在 《自京赴奉先》 中，历经四起四落的情感克制转折。",
    "start": 145.915,
    "end": 152.291,
    "duration": 6.376
  },
  {
    "id": 40,
    "text": "李白之美在于飞扬壮阔的奇崛俊逸，",
    "start": 152.291,
    "end": 154.862,
    "duration": 2.571
  },
  {
    "id": 41,
    "text": "杜甫之美在于郁结盘旋的深沉悲凉。",
    "start": 154.862,
    "end": 159.226,
    "duration": 4.364
  },
  {
    "id": 42,
    "text": "第三，在表现手法与文体体裁上，",
    "start": 159.226,
    "end": 164.765,
    "duration": 5.539
  },
  {
    "id": 43,
    "text": "呈现天马行空的古体歌行与精严化境的近体律诗。",
    "start": 164.765,
    "end": 170.639,
    "duration": 5.874
  },
  {
    "id": 44,
    "text": "李白极力突破格律的束缚，",
    "start": 170.639,
    "end": 173.307,
    "duration": 2.668
  },
  {
    "id": 45,
    "text": "将主要创造力倾注于三五七言错落舒卷的古题乐府与长篇歌行。",
    "start": 173.307,
    "end": 177.255,
    "duration": 3.948
  },
  {
    "id": 46,
    "text": "在 《梦游天姥吟留别》《蜀道难》 中，",
    "start": 177.255,
    "end": 181.308,
    "duration": 4.053
  },
  {
    "id": 47,
    "text": "自由驱遣天界神仙与宇宙极境，极尽大胆奇幻的夸张之能事；",
    "start": 181.308,
    "end": 186.457,
    "duration": 5.149
  },
  {
    "id": 48,
    "text": "杜甫虽亦擅长古体叙事，",
    "start": 186.457,
    "end": 187.811,
    "duration": 1.354
  },
  {
    "id": 49,
    "text": "但其最高艺术造诣在于对律诗体制的全面集大成。",
    "start": 187.811,
    "end": 191.928,
    "duration": 4.117
  },
  {
    "id": 50,
    "text": "杜甫精研声病，晚年做到 “晚节渐于诗律细”，",
    "start": 191.928,
    "end": 193.309,
    "duration": 1.381
  },
  {
    "id": 51,
    "text": "更创立 “拗救” 与变格手法。",
    "start": 193.309,
    "end": 196.427,
    "duration": 3.118
  },
  {
    "id": 52,
    "text": "其 《秋兴八首》 将七律组诗推向登峰造极，",
    "start": 196.427,
    "end": 197.202,
    "duration": 0.775
  },
  {
    "id": 53,
    "text": "做到了形式精严而又浑融流转，",
    "start": 197.202,
    "end": 200.145,
    "duration": 2.943
  },
  {
    "id": 54,
    "text": "代表了近体诗律化的终极最高成就。",
    "start": 200.145,
    "end": 202.774,
    "duration": 2.629
  },
  {
    "id": 55,
    "text": "第四，共同构建中国古典诗歌的审美双璧，",
    "start": 202.774,
    "end": 205.123,
    "duration": 2.349
  },
  {
    "id": 56,
    "text": "确立不可动摇的万代宗师地位。",
    "start": 205.123,
    "end": 208.564,
    "duration": 3.441
  },
  {
    "id": 57,
    "text": "李白与杜甫并非相互排斥，",
    "start": 208.564,
    "end": 212.118,
    "duration": 3.554
  },
  {
    "id": 58,
    "text": "而是共同构成了中国诗歌精神的阴阳双翼。",
    "start": 212.118,
    "end": 214.822,
    "duration": 2.704
  },
  {
    "id": 59,
    "text": "李白为后代历代文人提供了超越尘世功利、",
    "start": 214.822,
    "end": 220.749,
    "duration": 5.927
  },
  {
    "id": 60,
    "text": "守护自由心灵的浪漫飞翔之翼；",
    "start": 220.749,
    "end": 222.163,
    "duration": 1.414
  },
  {
    "id": 61,
    "text": "杜甫为后代士人树立了扎根大地、",
    "start": 222.163,
    "end": 225.168,
    "duration": 3.005
  },
  {
    "id": 62,
    "text": "关怀生民疾苦的现实良心之锚。",
    "start": 225.168,
    "end": 226.26,
    "duration": 1.092
  },
  {
    "id": 63,
    "text": "中唐韩孟诗派与北宋苏轼得力于李白的浪漫狂放与豪迈气势；",
    "start": 226.26,
    "end": 227.851,
    "duration": 1.591
  },
  {
    "id": 64,
    "text": "白居易新乐府运动、",
    "start": 227.851,
    "end": 229.936,
    "duration": 2.085
  },
  {
    "id": 65,
    "text": "宋代黄庭坚与江西诗派则取法于杜甫的写实规矩与精严法度。",
    "start": 229.936,
    "end": 233.207,
    "duration": 3.271
  },
  {
    "id": 66,
    "text": "李杜双峰并峙，共同奠定了中国诗歌史上不可逾越的审美巅峰。",
    "start": 233.207,
    "end": 237.901,
    "duration": 4.694
  }
]