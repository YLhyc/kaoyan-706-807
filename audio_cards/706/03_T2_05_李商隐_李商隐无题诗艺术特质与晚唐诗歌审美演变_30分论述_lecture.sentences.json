[
  {
    "id": 1,
    "text": "试论李商隐无题诗的艺术特质与晚唐诗歌审美演变。",
    "start": 0.104,
    "end": 4.517,
    "duration": 4.413
  },
  {
    "id": 2,
    "text": "李商隐是晚唐诗坛在唐诗盛极难继之际异军突起的抒情大家。",
    "start": 4.913,
    "end": 10.116,
    "duration": 5.203
  },
  {
    "id": 3,
    "text": "身处晚唐藩镇割据、宦官擅权、",
    "start": 10.424,
    "end": 13.153,
    "duration": 2.729
  },
  {
    "id": 4,
    "text": "牛李党争倾轧与国势衰颓的时代困局，",
    "start": 13.482,
    "end": 16.632,
    "duration": 3.15
  },
  {
    "id": 5,
    "text": "李商隐一生卷入党争夹缝，沉沦下僚、辗转幕府，",
    "start": 16.912,
    "end": 20.734,
    "duration": 3.822
  },
  {
    "id": 6,
    "text": "灵心善感的气质与坎坷身世交织，开创了深情绵邈、",
    "start": 20.993,
    "end": 25.697,
    "duration": 4.704
  },
  {
    "id": 7,
    "text": "绮丽精工的“无题诗”范式。",
    "start": 25.953,
    "end": 27.935,
    "duration": 1.982
  },
  {
    "id": 8,
    "text": "元好问在《论诗三十首》中赞其“诗家总爱西昆好，",
    "start": 28.341,
    "end": 33.071,
    "duration": 4.73
  },
  {
    "id": 9,
    "text": "独恨无人作郑笺”。",
    "start": 33.365,
    "end": 34.618,
    "duration": 1.253
  },
  {
    "id": 10,
    "text": "李商隐无题诗的艺术特质及其所体现的晚唐审美演变，",
    "start": 34.976,
    "end": 39.437,
    "duration": 4.461
  },
  {
    "id": 11,
    "text": "主要展现为以下四个方面：",
    "start": 39.778,
    "end": 41.706,
    "duration": 1.928
  },
  {
    "id": 12,
    "text": "第一，创制“无题”诗体，确立重心灵体验与朦胧多义的抒情范式。",
    "start": 42.337,
    "end": 47.852,
    "duration": 5.515
  },
  {
    "id": 13,
    "text": "李商隐在诗体题材上的重大革新，",
    "start": 48.411,
    "end": 50.764,
    "duration": 2.353
  },
  {
    "id": 14,
    "text": "在于打破了古典诗歌多依傍具体时事或明确题旨的习惯。",
    "start": 51.119,
    "end": 55.738,
    "duration": 4.619
  },
  {
    "id": 15,
    "text": "他或以“无题”名篇，或截取篇首二字为题，淡化具体的时间、",
    "start": 56.089,
    "end": 61.04,
    "duration": 4.951
  },
  {
    "id": 16,
    "text": "地点与事件背景，直接以心灵情绪和整个心境作为表现对象。",
    "start": 61.297,
    "end": 66.26,
    "duration": 4.963
  },
  {
    "id": 17,
    "text": "如《无题·相见时难别亦难》中“春蚕到死丝方尽，",
    "start": 66.715,
    "end": 71.097,
    "duration": 4.382
  },
  {
    "id": 18,
    "text": "蜡炬成灰泪始干”，以生死不渝的比喻写尽执着深情；",
    "start": 71.368,
    "end": 75.939,
    "duration": 4.571
  },
  {
    "id": 19,
    "text": "《锦瑟》以“锦瑟无端五十弦，一弦一柱思华年”统摄全篇。",
    "start": 76.36,
    "end": 80.953,
    "duration": 4.593
  },
  {
    "id": 20,
    "text": "由于省略了明确的逻辑因果与本事交代，",
    "start": 81.227,
    "end": 84.016,
    "duration": 2.789
  },
  {
    "id": 21,
    "text": "这类诗作既可作爱情深情之叹，亦可作身世政治之寄托，",
    "start": 84.371,
    "end": 88.987,
    "duration": 4.616
  },
  {
    "id": 22,
    "text": "形成了朦胧多义的解读空间。",
    "start": 89.39,
    "end": 91.546,
    "duration": 2.156
  },
  {
    "id": 23,
    "text": "第二，构筑凄美怅惘的抒情基调，",
    "start": 92.146,
    "end": 94.844,
    "duration": 2.698
  },
  {
    "id": 24,
    "text": "真切折射晚唐士人幻灭彷徨的时代心境。",
    "start": 95.153,
    "end": 98.644,
    "duration": 3.491
  },
  {
    "id": 25,
    "text": "李商隐的诗作流露出浓郁的晚唐末世伤感情调。",
    "start": 99.075,
    "end": 102.943,
    "duration": 3.868
  },
  {
    "id": 26,
    "text": "面对帝国不可挽回的没落趋势与自身仕途的屡屡受挫，",
    "start": 103.419,
    "end": 107.653,
    "duration": 4.234
  },
  {
    "id": 27,
    "text": "盛唐士人昂扬自信的英雄气概消退，代之以幽微深沉的孤独、",
    "start": 108.037,
    "end": 113.063,
    "duration": 5.026
  },
  {
    "id": 28,
    "text": "失落与无力感。",
    "start": 113.336,
    "end": 114.704,
    "duration": 1.368
  },
  {
    "id": 29,
    "text": "在《无题·昨夜星辰昨夜风》中，一面是“身无彩凤双飞翼，",
    "start": 115.427,
    "end": 120.525,
    "duration": 5.098
  },
  {
    "id": 30,
    "text": "心有灵犀一点通”的心灵契合，一面是“嗟余听鼓应官去，",
    "start": 120.91,
    "end": 126.084,
    "duration": 5.174
  },
  {
    "id": 31,
    "text": "走马兰台类转蓬”的身不由己；不仅无题诗如此，",
    "start": 126.445,
    "end": 130.663,
    "duration": 4.218
  },
  {
    "id": 32,
    "text": "其即景抒怀名篇《乐游原》中“夕阳无限好，",
    "start": 131.015,
    "end": 134.809,
    "duration": 3.794
  },
  {
    "id": 33,
    "text": "只是近黄昏”之叹，",
    "start": 135.112,
    "end": 136.369,
    "duration": 1.257
  },
  {
    "id": 34,
    "text": "更是整个晚唐士人面对繁华消逝与大厦将倾的普遍心声。",
    "start": 136.661,
    "end": 141.637,
    "duration": 4.976
  },
  {
    "id": 35,
    "text": "第三，精研深密典丽的意象与用典艺术，",
    "start": 142.29,
    "end": 145.755,
    "duration": 3.465
  },
  {
    "id": 36,
    "text": "达成“沉博绝丽”的诗美境界。",
    "start": 146.091,
    "end": 148.487,
    "duration": 2.396
  },
  {
    "id": 37,
    "text": "在表现技巧上，",
    "start": 148.659,
    "end": 149.612,
    "duration": 0.953
  },
  {
    "id": 38,
    "text": "李商隐创造了“绮密瑰妍”“沉博绝丽”的艺术风格。",
    "start": 149.976,
    "end": 153.902,
    "duration": 3.926
  },
  {
    "id": 39,
    "text": "他善于将内心朦胧的心象化为珠泪、玉烟、蓬山、",
    "start": 154.07,
    "end": 158.219,
    "duration": 4.149
  },
  {
    "id": 40,
    "text": "青鸟等非现实的精美意象，并以跳跃错综的方式加以组合，",
    "start": 158.304,
    "end": 163.092,
    "duration": 4.788
  },
  {
    "id": 41,
    "text": "营造如雾里看花的凄艳诗境；同时精于活用典故、推陈出新，",
    "start": 163.332,
    "end": 168.233,
    "duration": 4.901
  },
  {
    "id": 42,
    "text": "只取原典所含的情思韵味而不拘泥于原典事理。",
    "start": 168.632,
    "end": 172.646,
    "duration": 4.014
  },
  {
    "id": 43,
    "text": "《锦瑟》颔联“庄生晓梦迷蝴蝶，",
    "start": 172.889,
    "end": 175.63,
    "duration": 2.741
  },
  {
    "id": 44,
    "text": "望帝春心托杜鹃”借典喻示人生如梦的迷惘与伤春之哀，",
    "start": 175.913,
    "end": 180.936,
    "duration": 5.023
  },
  {
    "id": 45,
    "text": "颈联“沧海月明珠有泪，",
    "start": 181.415,
    "end": 183.666,
    "duration": 2.251
  },
  {
    "id": 46,
    "text": "蓝田日暖玉生烟”以迷离象喻写难言之痛，对仗精工、",
    "start": 183.971,
    "end": 189.208,
    "duration": 5.237
  },
  {
    "id": 47,
    "text": "音律谐美，将近体律诗的雕琢与浑融推向新境。",
    "start": 189.629,
    "end": 194.006,
    "duration": 4.377
  },
  {
    "id": 48,
    "text": "第四，引领唐诗向精微内向演进，",
    "start": 194.666,
    "end": 197.768,
    "duration": 3.102
  },
  {
    "id": 49,
    "text": "深刻影响宋初西昆体与晚唐五代词风。",
    "start": 198.088,
    "end": 201.471,
    "duration": 3.383
  },
  {
    "id": 50,
    "text": "李商隐的创作标志着唐诗由盛唐开阔壮大的外向气象，",
    "start": 201.905,
    "end": 206.503,
    "duration": 4.598
  },
  {
    "id": 51,
    "text": "转向内敛幽微的心灵世界开掘。",
    "start": 206.716,
    "end": 209.305,
    "duration": 2.589
  },
  {
    "id": 52,
    "text": "他专注于微观情绪的细腻体察与复杂心境的曲折传达，",
    "start": 209.825,
    "end": 214.329,
    "duration": 4.504
  },
  {
    "id": 53,
    "text": "在盛唐李杜与中唐韩白之后，为唐诗开辟了幽约深浑的新境。",
    "start": 214.792,
    "end": 220.142,
    "duration": 5.35
  },
  {
    "id": 54,
    "text": "这种凄艳精丽的诗风不仅直接催生了宋初杨亿、",
    "start": 220.431,
    "end": 224.225,
    "duration": 3.794
  },
  {
    "id": 55,
    "text": "钱惟演等人宗尚的“西昆体”诗歌流派，",
    "start": 224.429,
    "end": 227.618,
    "duration": 3.189
  },
  {
    "id": 56,
    "text": "其深情绵邈的意象经营与抒情方式，更对温庭筠、",
    "start": 227.791,
    "end": 232.123,
    "duration": 4.332
  },
  {
    "id": 57,
    "text": "李煜等晚唐五代词以及后世婉约词的发展产生了深远的滋养。",
    "start": 232.577,
    "end": 237.541,
    "duration": 4.964
  }
]