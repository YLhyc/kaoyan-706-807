[
  {
    "id": 1,
    "text": "试论王维山水田园诗的艺术成就与禅意空灵美学。",
    "start": 0.101,
    "end": 4.518,
    "duration": 4.417
  },
  {
    "id": 2,
    "text": "王维是盛唐山水田园诗派最具代表性的大家。",
    "start": 5.018,
    "end": 8.705,
    "duration": 3.687
  },
  {
    "id": 3,
    "text": "他早年怀抱功名热望，也曾赴边塞幕府写下壮阔边声，",
    "start": 9.205,
    "end": 13.76,
    "duration": 4.555
  },
  {
    "id": 4,
    "text": "经历仕途起伏与晚年隐居辋川别业后，将画理、音律与大乘禅理融入自然山水观照，",
    "start": 14.179,
    "end": 21.868,
    "duration": 7.689
  },
  {
    "id": 5,
    "text": "创造出静逸明秀、兴象玲珑的纯美诗境，把唐代山水诗推向空灵澄明的新境界。",
    "start": 22.218,
    "end": 28.99,
    "duration": 6.772
  },
  {
    "id": 6,
    "text": "其艺术成就主要体现在以下四个方面：",
    "start": 29.49,
    "end": 32.109,
    "duration": 2.619
  },
  {
    "id": 7,
    "text": "第一，融画法音律于写景，营造“诗中有画，画中有诗”的空间美感。",
    "start": 32.73,
    "end": 39.009,
    "duration": 6.279
  },
  {
    "id": 8,
    "text": "苏轼曾评王维“诗中有画，画中有诗”。",
    "start": 39.509,
    "end": 42.758,
    "duration": 3.249
  },
  {
    "id": 9,
    "text": "王维精通绘画与音乐，善于以画家敏锐之眼在动态中捕捉光影色彩的微妙对比与空间层次。",
    "start": 43.258,
    "end": 50.869,
    "duration": 7.611
  },
  {
    "id": 10,
    "text": "如《山居秋暝》“明月松间照，清泉石上流”，上句取月光穿透松林的静景构图，",
    "start": 51.369,
    "end": 58.16,
    "duration": 6.791
  },
  {
    "id": 11,
    "text": "下句写山泉流经青石的清音微动，声色相衬，令秋夜空山明澈如画；",
    "start": 58.51,
    "end": 64.263,
    "duration": 5.753
  },
  {
    "id": 12,
    "text": "《过香积寺》“泉声咽危石，日色冷青松”、《山中》“山路元无雨，空翠湿人衣”则妙用视觉条件色，",
    "start": 64.763,
    "end": 73.65,
    "duration": 8.887
  },
  {
    "id": 13,
    "text": "借青松浓荫与苍翠山气生出“冷”“湿”之感，写活物态天趣而不留人工雕琢痕迹。",
    "start": 74.0,
    "end": 81.241,
    "duration": 7.241
  },
  {
    "id": 14,
    "text": "第二，以禅宗空观观照自然，呈示物我冥合的“无我”禅境。",
    "start": 81.891,
    "end": 87.107,
    "duration": 5.216
  },
  {
    "id": 15,
    "text": "王维精研佛法，以静坐澄心体会“无生”之境，",
    "start": 87.607,
    "end": 91.752,
    "duration": 4.145
  },
  {
    "id": 16,
    "text": "使唐代山水诗从六朝玄言理路跃入以禅趣为主的直观审美观照。",
    "start": 92.197,
    "end": 98.213,
    "duration": 6.016
  },
  {
    "id": 17,
    "text": "如《终南别业》“行到水穷处，坐看云起时”，",
    "start": 98.785,
    "end": 102.794,
    "duration": 4.009
  },
  {
    "id": 18,
    "text": "诗人无意逢水、闲坐观云，淡泊无心之态与自然天光云影浑然契合；",
    "start": 103.169,
    "end": 109.787,
    "duration": 6.618
  },
  {
    "id": 19,
    "text": "《鹿柴》“空山不见人，但闻人语响。返景入深林，复照青苔上”与《辛夷坞》“涧户寂无人，纷纷开且落”，",
    "start": 110.287,
    "end": 120.048,
    "duration": 9.761
  },
  {
    "id": 20,
    "text": "更反复凸显无人无我的静寂，把孤寂转化为对自然造物生生不息的静观自得，",
    "start": 120.398,
    "end": 127.204,
    "duration": 6.806
  },
  {
    "id": 21,
    "text": "以微响、夕照反衬山林永恒的空静之美。",
    "start": 127.56,
    "end": 130.966,
    "duration": 3.406
  },
  {
    "id": 22,
    "text": "第三，兼善古近诸体精工音节，形成从壮大明朗到冲淡天然的风貌。",
    "start": 131.607,
    "end": 138.238,
    "duration": 6.631
  },
  {
    "id": 23,
    "text": "在体式语言上，王维各类诗体皆精，五律、五绝尤臻绝诣。",
    "start": 138.738,
    "end": 143.929,
    "duration": 5.191
  },
  {
    "id": 24,
    "text": "他早年出塞作品如《使至塞上》“大漠孤烟直，长河落日圆”，",
    "start": 144.429,
    "end": 150.105,
    "duration": 5.676
  },
  {
    "id": 25,
    "text": "以凝练对称的线条勾勒塞外雄浑阔景，正显盛唐气象；",
    "start": 150.576,
    "end": 155.068,
    "duration": 4.492
  },
  {
    "id": 26,
    "text": "晚年《辋川集》二十首及五言律诗则删繁就简，不尚险怪典故，",
    "start": 155.568,
    "end": 160.889,
    "duration": 5.321
  },
  {
    "id": 27,
    "text": "或以《山居秋暝》写“竹喧”“莲动”，或以辋川绝句写“青苔”“芙蓉”，仅用清浅自然意象配合舒徐圆转的音律，",
    "start": 161.303,
    "end": 170.0,
    "duration": 8.697
  },
  {
    "id": 28,
    "text": "既避免大历诗仅有佳句而格局狭小之弊，又形成通篇浑融一气的冲淡神韵。",
    "start": 170.391,
    "end": 176.326,
    "duration": 5.935
  },
  {
    "id": 29,
    "text": "第四，汇通前代清澹山水源流，垂范后世意境审美追求。",
    "start": 176.958,
    "end": 182.124,
    "duration": 5.166
  },
  {
    "id": 30,
    "text": "王维继承谢灵运、谢朓写景传统并上承张九龄“清澹”之源，",
    "start": 182.624,
    "end": 188.069,
    "duration": 5.445
  },
  {
    "id": 31,
    "text": "将“兴象”与“禅境”相契，与孟浩然共同确立盛唐山水田园诗派的宗主地位。",
    "start": 188.419,
    "end": 194.658,
    "duration": 6.239
  },
  {
    "id": 32,
    "text": "胡应麟在《诗薮》中指出盛唐诗人“本曲江之清澹，而益以风神”。",
    "start": 195.158,
    "end": 200.502,
    "duration": 5.344
  },
  {
    "id": 33,
    "text": "此后中唐大历诗人、韦应物、柳宗元乃至宋代山水画论、清代王士祯“神韵说”，",
    "start": 201.002,
    "end": 207.912,
    "duration": 6.91
  },
  {
    "id": 34,
    "text": "均从王维“水月镜花”般的空明诗境中汲取丰厚滋养。",
    "start": 208.483,
    "end": 212.768,
    "duration": 4.285
  },
  {
    "id": 35,
    "text": "合而观之，王维将画理构图、精工音律与禅宗空观引入自然观照，",
    "start": 213.268,
    "end": 218.919,
    "duration": 5.651
  },
  {
    "id": 36,
    "text": "营造出“诗中有画，画中有诗”且物我冥合的空灵诗境，",
    "start": 219.269,
    "end": 224.514,
    "duration": 5.245
  },
  {
    "id": 37,
    "text": "展现出盛唐山水田园诗的纯粹之美。",
    "start": 224.864,
    "end": 228.085,
    "duration": 3.221
  },
  {
    "id": 38,
    "text": "他汇通前代清澹山水源流，从大历诗人、韦应物、柳宗元直至清代王士祯“神韵说”，",
    "start": 228.585,
    "end": 235.479,
    "duration": 6.894
  },
  {
    "id": 39,
    "text": "在中国古典意境美学史上留下了长久回响。",
    "start": 235.829,
    "end": 239.423,
    "duration": 3.594
  }
]
