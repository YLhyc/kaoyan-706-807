[
  {
    "id": 1,
    "text": "试论王维山水田园诗的艺术成就与禅意空灵美学。",
    "start": 0.101,
    "end": 4.518,
    "duration": 4.417
  },
  {
    "id": 2,
    "text": "王维是盛唐山水田园诗派最具代表性的大家。",
    "start": 4.934,
    "end": 8.621,
    "duration": 3.687
  },
  {
    "id": 3,
    "text": "他早年怀抱功名热望，也曾赴边塞幕府写下壮阔边声，",
    "start": 8.948,
    "end": 13.503,
    "duration": 4.555
  },
  {
    "id": 4,
    "text": "经历仕途起伏与晚年隐居辋川别业后，将画理、音律与大乘禅理融入自然山水观照，",
    "start": 13.73,
    "end": 21.629,
    "duration": 7.899
  },
  {
    "id": 5,
    "text": "创造出静逸明秀、兴象玲珑的纯美诗境，把唐代山水诗推向空灵澄明的新境界。",
    "start": 21.899,
    "end": 28.671,
    "duration": 6.772
  },
  {
    "id": 6,
    "text": "其艺术成就主要体现在以下四个方面：",
    "start": 29.162,
    "end": 31.781,
    "duration": 2.619
  },
  {
    "id": 7,
    "text": "第一，融画法音律于写景，营造“诗中有画，画中有诗”的空间美感。",
    "start": 32.402,
    "end": 38.681,
    "duration": 6.279
  },
  {
    "id": 8,
    "text": "苏轼曾评王维“诗中有画，画中有诗”。",
    "start": 38.818,
    "end": 42.067,
    "duration": 3.249
  },
  {
    "id": 9,
    "text": "王维精通绘画与音乐，善于以画家敏锐之眼在动态中捕捉光影色彩的微妙对比与空间层次。",
    "start": 42.422,
    "end": 50.033,
    "duration": 7.611
  },
  {
    "id": 10,
    "text": "如《山居秋暝》“明月松间照，清泉石上流”，上句取月光穿透松林的静景构图，",
    "start": 50.241,
    "end": 57.222,
    "duration": 6.981
  },
  {
    "id": 11,
    "text": "下句写山泉流经青石的清音微动，声色相衬，令秋夜空山明澈如画；",
    "start": 57.222,
    "end": 63.123,
    "duration": 5.901
  },
  {
    "id": 12,
    "text": "《过香积寺》“泉声咽危石，日色冷青松”、《山中》“山路元无雨，空翠湿人衣”则妙用视觉条件色，",
    "start": 63.51,
    "end": 72.397,
    "duration": 8.887
  },
  {
    "id": 13,
    "text": "借青松浓荫与苍翠山气生出“冷”“湿”之感，写活物态天趣而不留人工雕琢痕迹。",
    "start": 72.629,
    "end": 79.881,
    "duration": 7.252
  },
  {
    "id": 14,
    "text": "第二，以禅宗空观观照自然，呈示物我冥合的“无我”禅境。",
    "start": 80.52,
    "end": 85.736,
    "duration": 5.216
  },
  {
    "id": 15,
    "text": "王维精研佛法，以静坐澄心体会“无生”之境，",
    "start": 86.213,
    "end": 90.358,
    "duration": 4.145
  },
  {
    "id": 16,
    "text": "使唐代山水诗从六朝玄言理路跃入以禅趣为主的直观审美观照。",
    "start": 90.803,
    "end": 96.819,
    "duration": 6.016
  },
  {
    "id": 17,
    "text": "如《终南别业》“行到水穷处，坐看云起时”，",
    "start": 97.391,
    "end": 101.4,
    "duration": 4.009
  },
  {
    "id": 18,
    "text": "诗人无意逢水、闲坐观云，淡泊无心之态与自然天光云影浑然契合；",
    "start": 101.775,
    "end": 108.393,
    "duration": 6.618
  },
  {
    "id": 19,
    "text": "《鹿柴》“空山不见人，但闻人语响。返景入深林，复照青苔上”与《辛夷坞》“涧户寂无人，纷纷开且落”，",
    "start": 108.889,
    "end": 118.65,
    "duration": 9.761
  },
  {
    "id": 20,
    "text": "更反复凸显无人无我的静寂，把孤寂转化为对自然造物生生不息的静观自得，",
    "start": 118.889,
    "end": 125.695,
    "duration": 6.806
  },
  {
    "id": 21,
    "text": "以微响、夕照反衬山林永恒的空静之美。",
    "start": 126.051,
    "end": 129.457,
    "duration": 3.406
  },
  {
    "id": 22,
    "text": "第三，兼善古近诸体精工音节，形成从壮大明朗到冲淡天然的风貌。",
    "start": 130.098,
    "end": 136.729,
    "duration": 6.631
  },
  {
    "id": 23,
    "text": "在体式语言上，王维各类诗体皆精，五律、五绝尤臻绝诣。",
    "start": 137.108,
    "end": 142.299,
    "duration": 5.191
  },
  {
    "id": 24,
    "text": "他早年出塞作品如《使至塞上》“大漠孤烟直，长河落日圆”，",
    "start": 142.527,
    "end": 148.263,
    "duration": 5.736
  },
  {
    "id": 25,
    "text": "以凝练对称的线条勾勒塞外雄浑阔景，正显盛唐气象；",
    "start": 148.451,
    "end": 153.208,
    "duration": 4.757
  },
  {
    "id": 26,
    "text": "晚年《辋川集》二十首及五言律诗则删繁就简，不尚险怪典故，",
    "start": 153.457,
    "end": 158.778,
    "duration": 5.321
  },
  {
    "id": 27,
    "text": "或以《山居秋暝》写“竹喧”“莲动”，或以辋川绝句写“青苔”“芙蓉”，仅用清浅自然意象配合舒徐圆转的音律，",
    "start": 159.139,
    "end": 168.005,
    "duration": 8.866
  },
  {
    "id": 28,
    "text": "既避免大历诗仅有佳句而格局狭小之弊，又形成通篇浑融一气的冲淡神韵。",
    "start": 168.28,
    "end": 174.215,
    "duration": 5.935
  },
  {
    "id": 29,
    "text": "第四，汇通前代清澹山水源流，垂范后世意境审美追求。",
    "start": 174.847,
    "end": 180.013,
    "duration": 5.166
  },
  {
    "id": 30,
    "text": "王维继承谢灵运、谢朓写景传统并上承张九龄“清澹”之源，",
    "start": 180.304,
    "end": 185.749,
    "duration": 5.445
  },
  {
    "id": 31,
    "text": "将“兴象”与“禅境”相契，与孟浩然共同确立盛唐山水田园诗派的宗主地位。",
    "start": 186.001,
    "end": 192.24,
    "duration": 6.239
  },
  {
    "id": 32,
    "text": "胡应麟在《诗薮》中指出盛唐诗人“本曲江之清澹，而益以风神”。",
    "start": 192.574,
    "end": 197.918,
    "duration": 5.344
  },
  {
    "id": 33,
    "text": "此后中唐大历诗人、韦应物、柳宗元乃至宋代山水画论、清代王士祯“神韵说”，",
    "start": 198.2,
    "end": 205.11,
    "duration": 6.91
  },
  {
    "id": 34,
    "text": "均从王维“水月镜花”般的空明诗境中汲取丰厚滋养。",
    "start": 205.681,
    "end": 209.966,
    "duration": 4.285
  },
  {
    "id": 35,
    "text": "合而观之，王维将画理构图、精工音律与禅宗空观引入自然观照，",
    "start": 210.158,
    "end": 216.138,
    "duration": 5.98
  },
  {
    "id": 36,
    "text": "营造出“诗中有画，画中有诗”且物我冥合的空灵诗境，",
    "start": 216.138,
    "end": 221.578,
    "duration": 5.44
  },
  {
    "id": 37,
    "text": "展现出盛唐山水田园诗的纯粹之美。",
    "start": 221.578,
    "end": 224.938,
    "duration": 3.36
  },
  {
    "id": 38,
    "text": "他汇通前代清澹山水源流，从大历诗人、韦应物、柳宗元直至清代王士祯“神韵说”，",
    "start": 224.938,
    "end": 231.938,
    "duration": 7.0
  },
  {
    "id": 39,
    "text": "在中国古典意境美学史上留下了长久回响。",
    "start": 231.938,
    "end": 235.642,
    "duration": 3.704
  }
]