[
  {
    "id": 1,
    "text": "试论王维山水田园诗的艺术成就与禅意空灵美学。",
    "start": 0.101,
    "end": 4.508,
    "duration": 4.407
  },
  {
    "id": 2,
    "text": "王维是盛唐山水田园诗派最具代表性的大家。",
    "start": 4.934,
    "end": 8.611,
    "duration": 3.677
  },
  {
    "id": 3,
    "text": "他早年怀抱功名热望，也曾赴边塞幕府写下壮阔边声，",
    "start": 8.948,
    "end": 13.496,
    "duration": 4.548
  },
  {
    "id": 4,
    "text": "经历仕途起伏与晚年隐居辋川别业后，将画理、",
    "start": 13.73,
    "end": 18.077,
    "duration": 4.347
  },
  {
    "id": 5,
    "text": "音律与大乘禅理融入自然山水观照，创造出静逸明秀、",
    "start": 18.56,
    "end": 23.546,
    "duration": 4.986
  },
  {
    "id": 6,
    "text": "兴象玲珑的纯美诗境，把唐代山水诗推向空灵澄明的新境界。",
    "start": 23.793,
    "end": 28.661,
    "duration": 4.868
  },
  {
    "id": 7,
    "text": "其艺术成就主要体现在以下四个方面：",
    "start": 29.162,
    "end": 31.771,
    "duration": 2.609
  },
  {
    "id": 8,
    "text": "第一，融画法音律于写景，营造“诗中有画，",
    "start": 32.402,
    "end": 36.913,
    "duration": 4.511
  },
  {
    "id": 9,
    "text": "画中有诗”的空间美感。",
    "start": 37.08,
    "end": 38.671,
    "duration": 1.591
  },
  {
    "id": 10,
    "text": "苏轼曾评王维“诗中有画，画中有诗”。",
    "start": 38.818,
    "end": 42.057,
    "duration": 3.239
  },
  {
    "id": 11,
    "text": "王维精通绘画与音乐，",
    "start": 42.422,
    "end": 44.036,
    "duration": 1.614
  },
  {
    "id": 12,
    "text": "善于以画家敏锐之眼在动态中捕捉光影色彩的微妙对比与空间层次。",
    "start": 44.439,
    "end": 50.023,
    "duration": 5.584
  },
  {
    "id": 13,
    "text": "如《山居秋暝》“明月松间照，清泉石上流”，",
    "start": 50.241,
    "end": 54.004,
    "duration": 3.763
  },
  {
    "id": 14,
    "text": "上句取月光穿透松林的静景构图，",
    "start": 54.229,
    "end": 57.021,
    "duration": 2.792
  },
  {
    "id": 15,
    "text": "下句写山泉流经青石的清音微动，声色相衬，",
    "start": 57.222,
    "end": 60.889,
    "duration": 3.667
  },
  {
    "id": 16,
    "text": "令秋夜空山明澈如画；《过香积寺》“泉声咽危石，",
    "start": 61.208,
    "end": 65.827,
    "duration": 4.619
  },
  {
    "id": 17,
    "text": "日色冷青松”、《山中》“山路元无雨，",
    "start": 66.11,
    "end": 69.254,
    "duration": 3.144
  },
  {
    "id": 18,
    "text": "空翠湿人衣”则妙用视觉条件色，",
    "start": 69.54,
    "end": 72.387,
    "duration": 2.847
  },
  {
    "id": 19,
    "text": "借青松浓荫与苍翠山气生出“冷”“湿”之感，",
    "start": 72.629,
    "end": 76.465,
    "duration": 3.836
  },
  {
    "id": 20,
    "text": "写活物态天趣而不留人工雕琢痕迹。",
    "start": 76.746,
    "end": 79.871,
    "duration": 3.125
  },
  {
    "id": 21,
    "text": "第二，以禅宗空观观照自然，呈示物我冥合的“无我”禅境。",
    "start": 80.52,
    "end": 85.726,
    "duration": 5.206
  },
  {
    "id": 22,
    "text": "王维精研佛法，以静坐澄心体会“无生”之境，",
    "start": 86.213,
    "end": 90.348,
    "duration": 4.135
  },
  {
    "id": 23,
    "text": "使唐代山水诗从六朝玄言理路跃入以禅趣为主的直观审美观照。",
    "start": 90.803,
    "end": 96.809,
    "duration": 6.006
  },
  {
    "id": 24,
    "text": "如《终南别业》“行到水穷处，坐看云起时”，诗人无意逢水、",
    "start": 97.391,
    "end": 103.097,
    "duration": 5.706
  },
  {
    "id": 25,
    "text": "闲坐观云，淡泊无心之态与自然天光云影浑然契合；",
    "start": 103.399,
    "end": 108.383,
    "duration": 4.984
  },
  {
    "id": 26,
    "text": "《鹿柴》“空山不见人，但闻人语响。",
    "start": 108.889,
    "end": 111.96,
    "duration": 3.071
  },
  {
    "id": 27,
    "text": "返景入深林，复照青苔上”与《辛夷坞》“涧户寂无人，",
    "start": 112.443,
    "end": 117.38,
    "duration": 4.937
  },
  {
    "id": 28,
    "text": "纷纷开且落”，更反复凸显无人无我的静寂，",
    "start": 117.619,
    "end": 121.311,
    "duration": 3.692
  },
  {
    "id": 29,
    "text": "把孤寂转化为对自然造物生生不息的静观自得，以微响、",
    "start": 121.686,
    "end": 126.589,
    "duration": 4.903
  },
  {
    "id": 30,
    "text": "夕照反衬山林永恒的空静之美。",
    "start": 126.954,
    "end": 129.447,
    "duration": 2.493
  },
  {
    "id": 31,
    "text": "第三，兼善古近诸体精工音节，形成从壮大明朗到冲淡天然的风貌。",
    "start": 130.098,
    "end": 136.72,
    "duration": 6.622
  },
  {
    "id": 32,
    "text": "在体式语言上，王维各类诗体皆精，五律、五绝尤臻绝诣。",
    "start": 137.108,
    "end": 142.289,
    "duration": 5.181
  },
  {
    "id": 33,
    "text": "他早年出塞作品如《使至塞上》“大漠孤烟直，长河落日圆”，",
    "start": 142.527,
    "end": 148.253,
    "duration": 5.726
  },
  {
    "id": 34,
    "text": "以凝练对称的线条勾勒塞外雄浑阔景，正显盛唐气象；",
    "start": 148.451,
    "end": 153.198,
    "duration": 4.747
  },
  {
    "id": 35,
    "text": "晚年《辋川集》二十首及五言律诗则删繁就简，不尚险怪典故，",
    "start": 153.457,
    "end": 158.768,
    "duration": 5.311
  },
  {
    "id": 36,
    "text": "仅用“竹喧”“莲动”“青苔”“芙蓉”等清浅自然意象，",
    "start": 159.139,
    "end": 162.911,
    "duration": 3.772
  },
  {
    "id": 37,
    "text": "配合舒徐圆转的音律，既避免大历诗仅有佳句而格局狭小之弊，",
    "start": 163.412,
    "end": 168.201,
    "duration": 4.789
  },
  {
    "id": 38,
    "text": "又形成通篇浑融一气的冲淡神韵。",
    "start": 168.393,
    "end": 171.103,
    "duration": 2.71
  },
  {
    "id": 39,
    "text": "第四，汇通前代清澹山水源流，垂范后世意境审美追求。",
    "start": 171.745,
    "end": 176.903,
    "duration": 5.158
  },
  {
    "id": 40,
    "text": "王维继承谢灵运、谢朓写景传统并上承张九龄“清澹”之源，",
    "start": 177.202,
    "end": 182.637,
    "duration": 5.435
  },
  {
    "id": 41,
    "text": "将“兴象”与“禅境”相契，",
    "start": 182.899,
    "end": 184.869,
    "duration": 1.97
  },
  {
    "id": 42,
    "text": "与孟浩然共同确立盛唐山水田园诗派的宗主地位。",
    "start": 185.208,
    "end": 189.129,
    "duration": 3.921
  },
  {
    "id": 43,
    "text": "胡应麟在《诗薮》中指出盛唐诗人“本曲江之清澹，而益以风神”。",
    "start": 189.472,
    "end": 194.806,
    "duration": 5.334
  },
  {
    "id": 44,
    "text": "此后中唐大历诗人、韦应物、柳宗元乃至宋代山水画论、",
    "start": 195.098,
    "end": 199.89,
    "duration": 4.792
  },
  {
    "id": 45,
    "text": "清代王士祯“神韵说”，",
    "start": 200.298,
    "end": 201.998,
    "duration": 1.7
  },
  {
    "id": 46,
    "text": "均从王维“水月镜花”般的空明诗境中汲取丰厚滋养。",
    "start": 202.579,
    "end": 206.864,
    "duration": 4.285
  }
]