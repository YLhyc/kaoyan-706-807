[
  {
    "id": 1,
    "text": "全局宏观破题与立论逻辑。",
    "start": 0.16,
    "end": 2.64,
    "duration": 2.48
  },
  {
    "id": 2,
    "text": "在考场下笔之前，必须先在宏观上审清这道三十分大题的核心考核意图。",
    "start": 2.64,
    "end": 8.48,
    "duration": 5.84
  },
  {
    "id": 3,
    "text": "本题表面上考查杜甫的一个美学荣誉标签，",
    "start": 8.48,
    "end": 11.84,
    "duration": 3.36
  },
  {
    "id": 4,
    "text": "本质上考查杜诗叙事体裁的历史性突破。",
    "start": 11.84,
    "end": 15.52,
    "duration": 3.68
  },
  {
    "id": 5,
    "text": "考场评分标准绝不满足于仅回答杜诗记录了哪些历史事件。",
    "start": 15.52,
    "end": 20.16,
    "duration": 4.64
  },
  {
    "id": 6,
    "text": "答题方向必须确立为“从历史客观真实，",
    "start": 20.48,
    "end": 23.84,
    "duration": 3.36
  },
  {
    "id": 7,
    "text": "推进到底层人道立场，再下沉至诗体革新机制，",
    "start": 23.84,
    "end": 27.92,
    "duration": 4.08
  },
  {
    "id": 8,
    "text": "最终升华至诗史同构的美学哲学”。",
    "start": 27.92,
    "end": 30.88,
    "duration": 2.96
  },
  {
    "id": 9,
    "text": "整道大题在宏观上划分为五个有机递进的逻辑层次：第一层，",
    "start": 30.88,
    "end": 35.6,
    "duration": 4.72
  },
  {
    "id": 10,
    "text": "开篇破题，交代“诗史”的文献定评、",
    "start": 35.6,
    "end": 38.56,
    "duration": 2.96
  },
  {
    "id": 11,
    "text": "教材权威界定与核心内涵。",
    "start": 38.56,
    "end": 40.64,
    "duration": 2.08
  },
  {
    "id": 12,
    "text": "第二层，论述叙事内容的广度，说明杜诗如何全景记录唐朝由盛转衰的历史进程。",
    "start": 40.88,
    "end": 48.32,
    "duration": 7.44
  },
  {
    "id": 13,
    "text": "第三层，论述叙事立场的转变，说明杜甫如何打破官方正史视角，",
    "start": 48.32,
    "end": 54.08,
    "duration": 5.76
  },
  {
    "id": 14,
    "text": "将镜头推向底层平民。",
    "start": 54.08,
    "end": 56.16,
    "duration": 2.08
  },
  {
    "id": 15,
    "text": "第四层，论述叙事技艺与体制，说明杜甫如何开创新题乐府，",
    "start": 56.16,
    "end": 61.76,
    "duration": 5.6
  },
  {
    "id": 16,
    "text": "以戏剧化细节支撑史诗。",
    "start": 61.76,
    "end": 63.76,
    "duration": 2.0
  },
  {
    "id": 17,
    "text": "第五层，升华至美学本体，阐释“客观实录之史”与“主观仁爱之诗”的辩证统一。",
    "start": 64.08,
    "end": 70.8,
    "duration": 6.72
  },
  {
    "id": 18,
    "text": "尾部收官，将结论放回文学史谱系，",
    "start": 70.8,
    "end": 74.16,
    "duration": 3.36
  },
  {
    "id": 19,
    "text": "交代其对中唐新乐府运动的直接催生。",
    "start": 74.16,
    "end": 77.52,
    "duration": 3.36
  },
  {
    "id": 20,
    "text": "这五个层次构成一条环环相扣的因果长链：界定概念是前提，",
    "start": 77.52,
    "end": 82.96,
    "duration": 5.44
  },
  {
    "id": 21,
    "text": "全景记录是基础，民间立场是灵魂，",
    "start": 82.96,
    "end": 86.16,
    "duration": 3.2
  },
  {
    "id": 22,
    "text": "文体革新是载体，诗心灌注是升华。",
    "start": 86.16,
    "end": 89.2,
    "duration": 3.04
  },
  {
    "id": 23,
    "text": "理顺了宏观全局思路，接下来进入每一段的具体推导与逐句表述。",
    "start": 89.52,
    "end": 94.96,
    "duration": 5.44
  },
  {
    "id": 24,
    "text": "--。第",
    "start": 94.96,
    "end": 95.12,
    "duration": 0.16
  },
  {
    "id": 25,
    "text": "一段：首段破题与概念定性。",
    "start": 95.12,
    "end": 98.0,
    "duration": 2.88
  },
  {
    "id": 26,
    "text": "逐句因果推导与答题表述。",
    "start": 98.0,
    "end": 100.64,
    "duration": 2.64
  },
  {
    "id": 27,
    "text": "首句必须直击核心概念，绝不绕弯。",
    "start": 100.64,
    "end": 103.84,
    "duration": 3.2
  },
  {
    "id": 28,
    "text": "所以表述为：“诗史”是后世对杜甫诗歌思想价值与纪实功能的高度定评。",
    "start": 103.84,
    "end": 110.24,
    "duration": 6.4
  },
  {
    "id": 29,
    "text": "次句紧承首句给出历史文献来源，证明概念的真实出处。",
    "start": 110.64,
    "end": 115.44,
    "duration": 4.8
  },
  {
    "id": 30,
    "text": "所以表述为：这一概念最早见于中唐孟起在《本事诗》中的评述。",
    "start": 115.44,
    "end": 120.64,
    "duration": 5.2
  },
  {
    "id": 31,
    "text": "第三句紧接着补充正史典籍记载，进一步夯实历史文献依据。",
    "start": 120.64,
    "end": 125.6,
    "duration": 4.96
  },
  {
    "id": 32,
    "text": "所以表述为：《新唐书•杜甫传》亦明确记载：“读其诗，",
    "start": 125.6,
    "end": 130.4,
    "duration": 4.8
  },
  {
    "id": 33,
    "text": "可以知其世，故当时谓之诗史”。",
    "start": 130.4,
    "end": 133.28,
    "duration": 2.88
  },
  {
    "id": 34,
    "text": "第四句必须引入考研权威教材的学术界定，",
    "start": 133.6,
    "end": 137.04,
    "duration": 3.44
  },
  {
    "id": 35,
    "text": "明确其现代诗学含义。",
    "start": 137.04,
    "end": 139.04,
    "duration": 2.0
  },
  {
    "id": 36,
    "text": "所以表述为：袁行配《中国文学史》指出，",
    "start": 139.04,
    "end": 142.16,
    "duration": 3.12
  },
  {
    "id": 37,
    "text": "杜甫的“诗史”实现了历史真实与主观抒情的完美融合。",
    "start": 142.16,
    "end": 146.48,
    "duration": 4.32
  },
  {
    "id": 38,
    "text": "第五句深入阐发教材定义，指出诗史既是社会变迁史，",
    "start": 146.768,
    "end": 151.408,
    "duration": 4.64
  },
  {
    "id": 39,
    "text": "更是士人心灵史。",
    "start": 151.408,
    "end": 153.088,
    "duration": 1.68
  },
  {
    "id": 40,
    "text": "所以表述为：它不仅客观展现了唐代由盛转衰的历史全景，",
    "start": 153.088,
    "end": 157.968,
    "duration": 4.88
  },
  {
    "id": 41,
    "text": "更展现了时代动荡下的士人心灵史。",
    "start": 157.968,
    "end": 160.928,
    "duration": 2.96
  },
  {
    "id": 42,
    "text": "第六句作为首段过渡句，宣告下文将从四个核心维度展开系统论证。",
    "start": 160.928,
    "end": 166.128,
    "duration": 5.2
  },
  {
    "id": 43,
    "text": "所以表述为：其核心艺术特征与叙事成就，",
    "start": 166.528,
    "end": 170.048,
    "duration": 3.52
  },
  {
    "id": 44,
    "text": "主要展现为以下四个维度：本段答题思路总结。",
    "start": 170.048,
    "end": 174.048,
    "duration": 4.0
  },
  {
    "id": 45,
    "text": "本段用六句话完成立论闭环：先直接亮出诗史的高度定评，",
    "start": 174.048,
    "end": 179.088,
    "duration": 5.04
  },
  {
    "id": 46,
    "text": "再接续《本事诗》与《新唐书》确立双重文献依据；",
    "start": 179.088,
    "end": 182.848,
    "duration": 3.76
  },
  {
    "id": 47,
    "text": "随即以袁行配教材将诗史提升到“客观历史全景与主体心灵史融合”的诗学高度；",
    "start": 182.848,
    "end": 189.008,
    "duration": 6.16
  },
  {
    "id": 48,
    "text": "最后自然转入四个维度的展开，开篇逻辑严密规范。",
    "start": 189.248,
    "end": 193.728,
    "duration": 4.48
  },
  {
    "id": 49,
    "text": "所以本段具体答题完整版为：“诗史”是后世对杜甫诗歌思想价值与纪实功能的高度定评。",
    "start": 193.728,
    "end": 201.728,
    "duration": 8.0
  },
  {
    "id": 50,
    "text": "这一概念最早见于中唐孟起在《本事诗》中的评述。",
    "start": 201.728,
    "end": 205.968,
    "duration": 4.24
  },
  {
    "id": 51,
    "text": "《新唐书•杜甫传》亦明确记载：“读其诗，",
    "start": 205.968,
    "end": 209.568,
    "duration": 3.6
  },
  {
    "id": 52,
    "text": "可以知其世，故当时谓之诗史”。",
    "start": 209.568,
    "end": 212.448,
    "duration": 2.88
  },
  {
    "id": 53,
    "text": "袁行配《中国文学史》指出，杜甫的“诗史”实现了历史真实与主观抒情的完美融合。",
    "start": 212.688,
    "end": 219.808,
    "duration": 7.12
  },
  {
    "id": 54,
    "text": "它不仅客观展现了唐代由盛转衰的历史全景，",
    "start": 219.808,
    "end": 223.808,
    "duration": 4.0
  },
  {
    "id": 55,
    "text": "更展现了时代动荡下的士人心灵史。",
    "start": 223.808,
    "end": 227.008,
    "duration": 3.2
  },
  {
    "id": 56,
    "text": "其核心艺术特征与叙事成就，主要展现为以下四个维度：第二段：第一分论点，",
    "start": 227.008,
    "end": 233.488,
    "duration": 6.48
  },
  {
    "id": 57,
    "text": "题材内容的广阔纪实（史之“真”）。",
    "start": 233.488,
    "end": 236.288,
    "duration": 2.8
  },
  {
    "id": 58,
    "text": "逐句因果推导与答题表述。",
    "start": 236.288,
    "end": 238.608,
    "duration": 2.32
  },
  {
    "id": 59,
    "text": "论述诗史，首先必须证明其记录的历史在广度上是否具备史诗特征。",
    "start": 238.608,
    "end": 244.688,
    "duration": 6.08
  },
  {
    "id": 60,
    "text": "首句确立分论点，指出杜甫打破狭隘私情，",
    "start": 244.688,
    "end": 248.528,
    "duration": 3.84
  },
  {
    "id": 61,
    "text": "以史家笔法直面社会现实。",
    "start": 248.528,
    "end": 250.688,
    "duration": 2.16
  },
  {
    "id": 62,
    "text": "所以表述为：杜甫诗歌打破了传统抒情诗局限于狭隘私情的弊端，",
    "start": 251.168,
    "end": 256.716,
    "duration": 5.548
  },
  {
    "id": 63,
    "text": "以广阔的史家笔法直面社会现实。",
    "start": 256.716,
    "end": 259.618,
    "duration": 2.902
  },
  {
    "id": 64,
    "text": "次句概括其反映的历史广度，完整涵盖了唐朝由盛转衰的完整脉络。",
    "start": 259.618,
    "end": 265.42,
    "duration": 5.802
  },
  {
    "id": 65,
    "text": "所以表述为：他完整记录了天宝后期政治腐败、",
    "start": 265.42,
    "end": 269.358,
    "duration": 3.938
  },
  {
    "id": 66,
    "text": "安史之乱爆发及战后凋敝的完整历史轨迹。",
    "start": 269.358,
    "end": 273.088,
    "duration": 3.73
  },
  {
    "id": 67,
    "text": "第三句调取安史之乱爆发前夕的代表作，",
    "start": 273.168,
    "end": 276.288,
    "duration": 3.12
  },
  {
    "id": 68,
    "text": "证明其对盛世危机的敏锐洞察。",
    "start": 276.288,
    "end": 279.008,
    "duration": 2.72
  },
  {
    "id": 69,
    "text": "所以表述为：天宝盛世表象之下，杜甫写下著名乐府名篇《兵车行》。",
    "start": 279.008,
    "end": 284.399,
    "duration": 5.391
  },
  {
    "id": 70,
    "text": "第四句直接引用《兵车行》极具画面感开篇的著名原句。",
    "start": 284.399,
    "end": 289.002,
    "duration": 4.603
  },
  {
    "id": 71,
    "text": "所以表述为：诗中写道：“车临临，",
    "start": 289.002,
    "end": 292.192,
    "duration": 3.19
  },
  {
    "id": 72,
    "text": "马萧萧，行人弓箭各在腰”。",
    "start": 292.192,
    "end": 294.912,
    "duration": 2.72
  },
  {
    "id": 73,
    "text": "第五句紧扣诗句展开历史阐析，揭示统治集团开边政策对百姓的残害。",
    "start": 294.912,
    "end": 300.832,
    "duration": 5.92
  },
  {
    "id": 74,
    "text": "所以表述为：诗人以震撼人心的征兵图景，",
    "start": 300.832,
    "end": 304.272,
    "duration": 3.44
  },
  {
    "id": 75,
    "text": "敏锐揭示了统治集团开边拓土给百姓带来的深重灾难。",
    "start": 304.272,
    "end": 308.672,
    "duration": 4.4
  },
  {
    "id": 76,
    "text": "第六句推进到安史之乱爆发之后，调取国都陷落时的经典诗篇。",
    "start": 308.992,
    "end": 313.632,
    "duration": 4.64
  },
  {
    "id": 77,
    "text": "所以表述为：长安沦陷之后，诗人又在《春望》中写道：“国破山河在，",
    "start": 313.632,
    "end": 318.992,
    "duration": 5.36
  },
  {
    "id": 78,
    "text": "城春草木深”。",
    "start": 318.992,
    "end": 320.352,
    "duration": 1.36
  },
  {
    "id": 79,
    "text": "第七句深入剖析诗句意境，说明国破与城春的反差是极具概括力的历史底片。",
    "start": 320.352,
    "end": 326.272,
    "duration": 5.92
  },
  {
    "id": 80,
    "text": "所以表述为：杜甫将国破之悲与城春之景交织，",
    "start": 326.592,
    "end": 330.743,
    "duration": 4.151
  },
  {
    "id": 81,
    "text": "成为展现安史之乱国破家亡的标志性历史底片。",
    "start": 330.743,
    "end": 335.177,
    "duration": 4.434
  },
  {
    "id": 82,
    "text": "第八句总结收束全段，指出这种准确把握时代大势的笔力赋予了杜诗史学价值。",
    "start": 335.177,
    "end": 342.494,
    "duration": 7.317
  },
  {
    "id": 83,
    "text": "所以表述为：这种对重大历史事件的准确把握，",
    "start": 342.494,
    "end": 346.706,
    "duration": 4.212
  },
  {
    "id": 84,
    "text": "赋予杜诗极为扎实的史学文献价值。",
    "start": 346.706,
    "end": 350.032,
    "duration": 3.326
  },
  {
    "id": 85,
    "text": "本段答题思路总结。",
    "start": 350.112,
    "end": 351.712,
    "duration": 1.6
  },
  {
    "id": 86,
    "text": "本段立足于客观历史真实的宏大视野：先从打破个人狭隘私情切入，",
    "start": 351.712,
    "end": 357.152,
    "duration": 5.44
  },
  {
    "id": 87,
    "text": "概括其涵盖由盛转衰的时代跨度；",
    "start": 357.152,
    "end": 359.792,
    "duration": 2.64
  },
  {
    "id": 88,
    "text": "随后调取战前的《兵车行》与沦陷期的《春望》进行前后对比验证；",
    "start": 359.792,
    "end": 364.592,
    "duration": 4.8
  },
  {
    "id": 89,
    "text": "证明杜诗不仅记录了具体战乱，更敏锐洞察了社会动荡的内在根源，",
    "start": 364.592,
    "end": 369.392,
    "duration": 4.8
  },
  {
    "id": 90,
    "text": "确立了诗史坚实的事实根基。",
    "start": 369.392,
    "end": 371.392,
    "duration": 2.0
  },
  {
    "id": 91,
    "text": "所以本段具体答题完整版为：一、题材内容的广阔纪实：唐代社会变迁的史诗级全景记录。",
    "start": 371.792,
    "end": 379.152,
    "duration": 7.36
  },
  {
    "id": 92,
    "text": "杜甫诗歌打破了传统抒情诗局限于狭隘私情的弊端，",
    "start": 379.152,
    "end": 383.392,
    "duration": 4.24
  },
  {
    "id": 93,
    "text": "以广阔的史家笔法直面社会现实。",
    "start": 383.392,
    "end": 386.112,
    "duration": 2.72
  },
  {
    "id": 94,
    "text": "他完整记录了天宝后期政治腐败、安史之乱爆发及战后凋敝的完整历史轨迹。",
    "start": 386.112,
    "end": 391.792,
    "duration": 5.68
  },
  {
    "id": 95,
    "text": "天宝盛世表象之下，杜甫写下著名乐府名篇《兵车行》。",
    "start": 392.032,
    "end": 396.912,
    "duration": 4.88
  },
  {
    "id": 96,
    "text": "诗中写道：“车临临，马萧萧，行人弓箭各在腰”。",
    "start": 396.912,
    "end": 401.472,
    "duration": 4.56
  },
  {
    "id": 97,
    "text": "诗人以震撼人心的征兵图景，敏锐揭示了统治集团开边拓土给百姓带来的深重灾难。",
    "start": 401.472,
    "end": 408.352,
    "duration": 6.88
  },
  {
    "id": 98,
    "text": "长安沦陷之后，诗人又在《春望》中写道：“国破山河在，",
    "start": 408.352,
    "end": 412.592,
    "duration": 4.24
  },
  {
    "id": 99,
    "text": "城春草木深”。",
    "start": 412.592,
    "end": 413.872,
    "duration": 1.28
  },
  {
    "id": 100,
    "text": "杜甫将国破之悲与城春之景交织，成为展现安史之乱国破家亡的标志性历史底片。",
    "start": 414.112,
    "end": 422.192,
    "duration": 8.08
  },
  {
    "id": 101,
    "text": "这种对重大历史事件的准确把握，赋予杜诗极为扎实的史学文献价值。",
    "start": 422.192,
    "end": 427.792,
    "duration": 5.6
  },
  {
    "id": 102,
    "text": "第三段：第二分论点，叙事立场的平民视角（史之“仁”）。",
    "start": 427.792,
    "end": 433.792,
    "duration": 6.0
  },
  {
    "id": 103,
    "text": "逐句因果推导与答题表述。",
    "start": 433.792,
    "end": 435.872,
    "duration": 2.08
  },
  {
    "id": 104,
    "text": "讲完记录历史的事件广度，本段必须进一步追问：杜甫是以什么立场来写史的。",
    "start": 436.336,
    "end": 442.336,
    "duration": 6.0
  },
  {
    "id": 105,
    "text": "首句确立分论点，对比传统正史的帝王将相，",
    "start": 442.336,
    "end": 446.176,
    "duration": 3.84
  },
  {
    "id": 106,
    "text": "指出杜甫开创了平民视角的修史范式。",
    "start": 446.176,
    "end": 449.376,
    "duration": 3.2
  },
  {
    "id": 107,
    "text": "所以表述为：不同于传统封建正史偏重帝王将相与政治权谋，",
    "start": 449.376,
    "end": 454.656,
    "duration": 5.28
  },
  {
    "id": 108,
    "text": "杜甫的叙事诗开创了平民视角的修史范式。",
    "start": 454.656,
    "end": 457.936,
    "duration": 3.28
  },
  {
    "id": 109,
    "text": "次句推导因果，说明这种立场决定了他必须将镜头对准底层受难者。",
    "start": 458.336,
    "end": 463.616,
    "duration": 5.28
  },
  {
    "id": 110,
    "text": "所以表述为：他将视线全面下移至处于战乱苦难之中的底层农夫、",
    "start": 463.616,
    "end": 469.471,
    "duration": 5.855
  },
  {
    "id": 111,
    "text": "老妇与弃卒。",
    "start": 469.471,
    "end": 470.536,
    "duration": 1.065
  },
  {
    "id": 112,
    "text": "第三句调取文学史上最著名的两组组诗，",
    "start": 470.536,
    "end": 474.155,
    "duration": 3.619
  },
  {
    "id": 113,
    "text": "确立本段的核心论据。",
    "start": 474.155,
    "end": 476.071,
    "duration": 1.916
  },
  {
    "id": 114,
    "text": "所以表述为：其叙事巅峰之作，当属乾元二年在战乱途中所作的《三吏》与《三别》。",
    "start": 476.071,
    "end": 484.016,
    "duration": 7.945
  },
  {
    "id": 115,
    "text": "第四句选取《石壕吏》作为解剖样本，",
    "start": 484.016,
    "end": 487.296,
    "duration": 3.28
  },
  {
    "id": 116,
    "text": "展现其冷静克制的入笔方式。",
    "start": 487.296,
    "end": 490.336,
    "duration": 3.04
  },
  {
    "id": 117,
    "text": "所以表述为：在名篇《石壕吏》中，",
    "start": 490.336,
    "end": 493.216,
    "duration": 2.88
  },
  {
    "id": 118,
    "text": "杜甫以客观投宿者的视角冷静起笔：“暮投石壕村，",
    "start": 493.216,
    "end": 497.856,
    "duration": 4.64
  },
  {
    "id": 119,
    "text": "有吏夜捉人”。",
    "start": 497.856,
    "end": 498.976,
    "duration": 1.12
  },
  {
    "id": 120,
    "text": "第五句紧扣老妇口述细节，剖析官吏残暴与平民牺牲的血淋淋现实。",
    "start": 499.296,
    "end": 505.296,
    "duration": 6.0
  },
  {
    "id": 121,
    "text": "所以表述为：随后通过老妇哭诉全家三男邺城从军的悲剧细节，",
    "start": 505.296,
    "end": 510.816,
    "duration": 5.52
  },
  {
    "id": 122,
    "text": "真实揭露了官差横征暴敛的残酷本质。",
    "start": 510.816,
    "end": 514.336,
    "duration": 3.52
  },
  {
    "id": 123,
    "text": "第六句深化人物内心矛盾，点出杜甫既同情百姓受难、",
    "start": 514.336,
    "end": 519.136,
    "duration": 4.8
  },
  {
    "id": 124,
    "text": "又深知平叛大局的复杂心理。",
    "start": 519.136,
    "end": 521.376,
    "duration": 2.24
  },
  {
    "id": 125,
    "text": "所以表述为：杜甫既痛心于黎民之惨烈牺牲，",
    "start": 521.696,
    "end": 525.426,
    "duration": 3.73
  },
  {
    "id": 126,
    "text": "又深明保卫社稷之历史大局。",
    "start": 525.426,
    "end": 527.946,
    "duration": 2.52
  },
  {
    "id": 127,
    "text": "第七句得出本段美学总结，指出饱含平民悲敏的书写赋予了诗歌超越正史的人性力量。",
    "start": 527.946,
    "end": 535.506,
    "duration": 7.56
  },
  {
    "id": 128,
    "text": "所以表述为：这种在矛盾中饱含同情的平民书写，",
    "start": 535.506,
    "end": 539.706,
    "duration": 4.2
  },
  {
    "id": 129,
    "text": "使诗歌具备了超越官方史书的深沉人性力量。",
    "start": 539.706,
    "end": 543.696,
    "duration": 3.99
  },
  {
    "id": 130,
    "text": "本段答题思路总结。",
    "start": 543.776,
    "end": 545.456,
    "duration": 1.68
  },
  {
    "id": 131,
    "text": "本段是整道大题思想深度的关键支撑：首先将杜诗视角与官方正史做鲜明对照，",
    "start": 545.456,
    "end": 552.656,
    "duration": 7.2
  },
  {
    "id": 132,
    "text": "指出平民视角的革命性意义；",
    "start": 552.656,
    "end": 554.896,
    "duration": 2.24
  },
  {
    "id": 133,
    "text": "接着以《石壕吏》为微观例证，分析老妇从军悲剧背后复杂的官民矛盾与家国冲突；",
    "start": 554.896,
    "end": 561.936,
    "duration": 7.04
  },
  {
    "id": 134,
    "text": "最后点明深沉人道同情正是杜甫“诗史”区别于冰冷编年史的根本所在。",
    "start": 561.936,
    "end": 567.456,
    "duration": 5.52
  },
  {
    "id": 135,
    "text": "所以本段具体答题完整版为：二、叙事立场的下移开拓：民间平民视角的悲敏关怀与血泪纪实。",
    "start": 567.776,
    "end": 575.456,
    "duration": 7.68
  },
  {
    "id": 136,
    "text": "不同于传统封建正史偏重帝王将相与政治权谋，",
    "start": 575.456,
    "end": 579.456,
    "duration": 4.0
  },
  {
    "id": 137,
    "text": "杜甫的叙事诗开创了平民视角的修史范式。",
    "start": 579.456,
    "end": 582.656,
    "duration": 3.2
  },
  {
    "id": 138,
    "text": "他将视线全面下移至处于战乱苦难之中的底层农夫、",
    "start": 582.944,
    "end": 587.584,
    "duration": 4.64
  },
  {
    "id": 139,
    "text": "老妇与弃卒。",
    "start": 587.584,
    "end": 589.264,
    "duration": 1.68
  },
  {
    "id": 140,
    "text": "其叙事巅峰之作，当属乾元二年在战乱途中所作的《三吏》与《三别》。",
    "start": 589.264,
    "end": 595.104,
    "duration": 5.84
  },
  {
    "id": 141,
    "text": "在名篇《石壕吏》中，杜甫以客观投宿者的视角冷静起笔：“暮投石壕村，",
    "start": 595.104,
    "end": 601.584,
    "duration": 6.48
  },
  {
    "id": 142,
    "text": "有吏夜捉人”。",
    "start": 601.584,
    "end": 602.704,
    "duration": 1.12
  },
  {
    "id": 143,
    "text": "随后通过老妇哭诉全家三男邺城从军的悲剧细节，",
    "start": 603.104,
    "end": 607.264,
    "duration": 4.16
  },
  {
    "id": 144,
    "text": "真实揭露了官差横征暴敛的残酷本质。",
    "start": 607.264,
    "end": 610.544,
    "duration": 3.28
  },
  {
    "id": 145,
    "text": "杜甫既痛心于黎民之惨烈牺牲，又深明保卫社稷之历史大局。",
    "start": 610.544,
    "end": 615.904,
    "duration": 5.36
  },
  {
    "id": 146,
    "text": "这种在矛盾中饱含同情的平民书写，",
    "start": 615.904,
    "end": 618.864,
    "duration": 2.96
  },
  {
    "id": 147,
    "text": "使诗歌具备了超越官方史书的深沉人性力量。",
    "start": 618.864,
    "end": 622.304,
    "duration": 3.44
  },
  {
    "id": 148,
    "text": "第四段：第三分论点，叙事文体与技艺的革新（体之“创”）。",
    "start": 622.544,
    "end": 627.824,
    "duration": 5.28
  },
  {
    "id": 149,
    "text": "逐句因果推导与答题表述。",
    "start": 627.824,
    "end": 630.064,
    "duration": 2.24
  },
  {
    "id": 150,
    "text": "前两段解决了历史内容与叙事立场，",
    "start": 630.064,
    "end": 632.944,
    "duration": 2.88
  },
  {
    "id": 151,
    "text": "本段必须回答这种宏大叙事依托怎样的文体技巧实现。",
    "start": 632.944,
    "end": 637.584,
    "duration": 4.64
  },
  {
    "id": 152,
    "text": "首句确立分论点，指出杜甫在文体与技法上打破了汉魏乐府旧题的桎梏。",
    "start": 637.584,
    "end": 643.344,
    "duration": 5.76
  },
  {
    "id": 153,
    "text": "所以表述为：杜甫在叙事文体与艺术表现上完成了突破性的创新，",
    "start": 643.744,
    "end": 649.43,
    "duration": 5.686
  },
  {
    "id": 154,
    "text": "彻底摆脱了汉魏乐府旧题的束缚。",
    "start": 649.43,
    "end": 652.405,
    "duration": 2.975
  },
  {
    "id": 155,
    "text": "次句引用中唐元稹的权威评语，明确指出其文体革命的核心贡献。",
    "start": 652.405,
    "end": 658.143,
    "duration": 5.738
  },
  {
    "id": 156,
    "text": "所以表述为：元稹在《唐故工部员外郎杜君墓志铭》中称赞其“即事名篇，",
    "start": 658.143,
    "end": 664.094,
    "duration": 5.951
  },
  {
    "id": 157,
    "text": "无复依傍”。",
    "start": 664.094,
    "end": 664.944,
    "duration": 0.85
  },
  {
    "id": 158,
    "text": "第三句解释即事名篇的机制，说明它依据眼前真实时事自创新题，",
    "start": 665.024,
    "end": 670.464,
    "duration": 5.44
  },
  {
    "id": 159,
    "text": "确立了新乐府范式。",
    "start": 670.464,
    "end": 672.144,
    "duration": 1.68
  },
  {
    "id": 160,
    "text": "所以表述为：杜甫完全依据眼前发生的真实历史事件创设新题，",
    "start": 672.144,
    "end": 677.344,
    "duration": 5.2
  },
  {
    "id": 161,
    "text": "奠定了后世新题乐府的体裁范式。",
    "start": 677.344,
    "end": 680.144,
    "duration": 2.8
  },
  {
    "id": 162,
    "text": "第四句由文体体制推进至微观技巧，",
    "start": 680.144,
    "end": 683.344,
    "duration": 3.2
  },
  {
    "id": 163,
    "text": "指出他善于捕捉戏剧化场面与生动人物对话。",
    "start": 683.344,
    "end": 686.624,
    "duration": 3.28
  },
  {
    "id": 164,
    "text": "所以表述为：在具体叙事技巧上，杜甫极善于抓取戏剧化场景与典型对话。",
    "start": 686.944,
    "end": 693.574,
    "duration": 6.63
  },
  {
    "id": 165,
    "text": "第五句调取代表作《新婚别》，剖析其借新娘独白展现的大义与悲剧性。",
    "start": 693.574,
    "end": 699.821,
    "duration": 6.247
  },
  {
    "id": 166,
    "text": "所以表述为：在《新婚别》中，他借新娘之口诉说新婚未满即奔赴死地的大义与绝望。",
    "start": 699.821,
    "end": 707.184,
    "duration": 7.363
  },
  {
    "id": 167,
    "text": "第六句从叙事学视角进行定型，说明第三人称白描与第一人称独白交织产生了动态张力。",
    "start": 707.264,
    "end": 714.944,
    "duration": 7.68
  },
  {
    "id": 168,
    "text": "所以表述为：全诗采用第三人称白描与第一人称独白交织的手法，",
    "start": 714.944,
    "end": 720.544,
    "duration": 5.6
  },
  {
    "id": 169,
    "text": "使叙事极富空间感与动态张力。",
    "start": 720.544,
    "end": 723.344,
    "duration": 2.8
  },
  {
    "id": 170,
    "text": "第七句总结本段，指出中国古典诗歌自杜甫开始从单纯抒情成熟演化为宏大叙事载体。",
    "start": 723.344,
    "end": 731.024,
    "duration": 7.68
  },
  {
    "id": 171,
    "text": "所以表述为：这表明古典诗歌在杜甫笔下，",
    "start": 731.024,
    "end": 734.76,
    "duration": 3.736
  },
  {
    "id": 172,
    "text": "已经由单纯的抒情符号演化为成熟的叙事载体。",
    "start": 734.76,
    "end": 738.84,
    "duration": 4.08
  },
  {
    "id": 173,
    "text": "本段答题思路总结。",
    "start": 738.84,
    "end": 740.68,
    "duration": 1.84
  },
  {
    "id": 174,
    "text": "本段聚焦于文学体制与叙事技艺的本体探索：先引入元稹“即事名篇”的定论，",
    "start": 740.68,
    "end": 746.92,
    "duration": 6.24
  },
  {
    "id": 175,
    "text": "说明摆脱乐府旧题在文体史上的开拓意义；",
    "start": 746.92,
    "end": 750.36,
    "duration": 3.44
  },
  {
    "id": 176,
    "text": "随后以《新婚别》的第一人称独白为例，",
    "start": 750.36,
    "end": 753.08,
    "duration": 2.72
  },
  {
    "id": 177,
    "text": "剖析戏剧化对话与多视角交织的叙事技巧；",
    "start": 753.08,
    "end": 756.68,
    "duration": 3.6
  },
  {
    "id": 178,
    "text": "最终落脚于古典诗歌从单纯抒情向成熟叙事的跨越，",
    "start": 757.0,
    "end": 761.72,
    "duration": 4.72
  },
  {
    "id": 179,
    "text": "论证了杜甫在诗体机制上的卓越贡献。",
    "start": 761.72,
    "end": 765.08,
    "duration": 3.36
  },
  {
    "id": 180,
    "text": "所以本段具体答题完整版为：三、叙事体制与技艺的革新：即事名篇的新题乐府与戏剧化细节展现。",
    "start": 765.08,
    "end": 774.04,
    "duration": 8.96
  },
  {
    "id": 181,
    "text": "杜甫在叙事文体与艺术表现上完成了突破性的创新，",
    "start": 774.04,
    "end": 778.52,
    "duration": 4.48
  },
  {
    "id": 182,
    "text": "彻底摆脱了汉魏乐府旧题的束缚。",
    "start": 778.52,
    "end": 781.0,
    "duration": 2.48
  },
  {
    "id": 183,
    "text": "元稹在《唐故工部员外郎杜君墓志铭》中称赞其“即事名篇，",
    "start": 781.24,
    "end": 786.6,
    "duration": 5.36
  },
  {
    "id": 184,
    "text": "无复依傍”。",
    "start": 786.6,
    "end": 787.64,
    "duration": 1.04
  },
  {
    "id": 185,
    "text": "杜甫完全依据眼前发生的真实历史事件创设新题，",
    "start": 787.64,
    "end": 791.64,
    "duration": 4.0
  },
  {
    "id": 186,
    "text": "奠定了后世新题乐府的体裁范式。",
    "start": 791.64,
    "end": 794.6,
    "duration": 2.96
  },
  {
    "id": 187,
    "text": "在具体叙事技巧上，杜甫极善于抓取戏剧化场景与典型对话。",
    "start": 794.6,
    "end": 799.48,
    "duration": 4.88
  },
  {
    "id": 188,
    "text": "在《新婚别》中，他借新娘之口诉说新婚未满即奔赴死地的大义与绝望。",
    "start": 799.8,
    "end": 806.12,
    "duration": 6.32
  },
  {
    "id": 189,
    "text": "全诗采用第三人称白描与第一人称独白交织的手法，",
    "start": 806.12,
    "end": 810.84,
    "duration": 4.72
  },
  {
    "id": 190,
    "text": "使叙事极富空间感与动态张力。",
    "start": 810.84,
    "end": 813.88,
    "duration": 3.04
  },
  {
    "id": 191,
    "text": "这表明古典诗歌在杜甫笔下，已经由单纯的抒情符号演化为成熟的叙事载体。",
    "start": 813.88,
    "end": 820.2,
    "duration": 6.32
  },
  {
    "id": 192,
    "text": "第五段：第四分论点，实录精神与主体诗心的统一（美之“核”）。",
    "start": 820.44,
    "end": 825.72,
    "duration": 5.28
  },
  {
    "id": 193,
    "text": "逐句因果推导与答题表述。",
    "start": 825.72,
    "end": 828.36,
    "duration": 2.64
  },
  {
    "id": 194,
    "text": "在剖析了内容、立场与文体之后，本段必须在美学与史学哲学的高度对“诗史”进行终极定性。",
    "start": 828.36,
    "end": 836.2,
    "duration": 7.84
  },
  {
    "id": 195,
    "text": "首句立论，指出诗史的根本原因在于它既是历史实录，",
    "start": 836.2,
    "end": 840.84,
    "duration": 4.64
  },
  {
    "id": 196,
    "text": "又始终保有诗歌的抒情本体。",
    "start": 840.84,
    "end": 842.84,
    "duration": 2.0
  },
  {
    "id": 197,
    "text": "所以表述为：杜诗之所以被称为“诗史”，",
    "start": 843.16,
    "end": 846.52,
    "duration": 3.36
  },
  {
    "id": 198,
    "text": "根本原因在于它既是“史”，但其底色依然是“诗”。",
    "start": 846.52,
    "end": 850.6,
    "duration": 4.08
  },
  {
    "id": 199,
    "text": "次句上溯史学源流，指出杜甫直接继承了司马迁《史记》的直笔实录风骨。",
    "start": 850.6,
    "end": 856.76,
    "duration": 6.16
  },
  {
    "id": 200,
    "text": "所以表述为：杜甫继承了司马迁《史记》的“不虚美，",
    "start": 856.76,
    "end": 860.76,
    "duration": 4.0
  },
  {
    "id": 201,
    "text": "不隐恶”的实录风骨，敢于直刺权贵之昏庸。",
    "start": 860.76,
    "end": 864.12,
    "duration": 3.36
  },
  {
    "id": 202,
    "text": "第三句紧承次句，说明杜诗没有沦为干燥编年史，",
    "start": 864.36,
    "end": 868.52,
    "duration": 4.16
  },
  {
    "id": 203,
    "text": "在于融入了儒家爱民的炽热诗心。",
    "start": 868.52,
    "end": 871.24,
    "duration": 2.72
  },
  {
    "id": 204,
    "text": "所以表述为：但他并未停留于冷冰冰的历史编年，",
    "start": 871.24,
    "end": 875.288,
    "duration": 4.048
  },
  {
    "id": 205,
    "text": "而是将强烈的儒家爱民诗心注入每一次叙事之中。",
    "start": 875.288,
    "end": 879.768,
    "duration": 4.48
  },
  {
    "id": 206,
    "text": "第四句调取其最宏大的抒情叙事长篇，",
    "start": 879.768,
    "end": 883.528,
    "duration": 3.76
  },
  {
    "id": 207,
    "text": "展现诗人将个人荣辱与天下危局交融的笔力。",
    "start": 883.528,
    "end": 888.328,
    "duration": 4.8
  },
  {
    "id": 208,
    "text": "所以表述为：在著名长篇《自京赴奉先县咏怀五百字》中，",
    "start": 888.328,
    "end": 893.768,
    "duration": 5.44
  },
  {
    "id": 209,
    "text": "诗人直面一己荣枯与天下危局。",
    "start": 893.768,
    "end": 896.728,
    "duration": 2.96
  },
  {
    "id": 210,
    "text": "第五句指出诗史的深层灵魂，在于诗人崇高的道德判断与悲敏胸怀。",
    "start": 896.968,
    "end": 903.208,
    "duration": 6.24
  },
  {
    "id": 211,
    "text": "所以表述为：诗史的内核是杜甫博大的胸襟与崇高的价值判断。",
    "start": 903.208,
    "end": 909.528,
    "duration": 6.32
  },
  {
    "id": 212,
    "text": "第六句得出哲学层面的结论，指出诗史不仅是客观外部事件的真实，",
    "start": 909.528,
    "end": 915.688,
    "duration": 6.16
  },
  {
    "id": 213,
    "text": "更是士人心灵搏击的真实。",
    "start": 915.688,
    "end": 917.768,
    "duration": 2.08
  },
  {
    "id": 214,
    "text": "所以表述为：它展现的不仅是外部历史事实的真实，",
    "start": 918.168,
    "end": 922.168,
    "duration": 4.0
  },
  {
    "id": 215,
    "text": "更是历史震荡中一代仁人志士心灵搏击的真实。",
    "start": 922.168,
    "end": 926.568,
    "duration": 4.4
  },
  {
    "id": 216,
    "text": "本段答题思路总结。",
    "start": 926.568,
    "end": 928.168,
    "duration": 1.6
  },
  {
    "id": 217,
    "text": "本段将诗史的讨论推向了美学最高境界：明确界定“诗”与“史”的辩证关系，",
    "start": 928.328,
    "end": 934.808,
    "duration": 6.48
  },
  {
    "id": 218,
    "text": "既承认其继承了司马迁直笔实录的史学风骨，",
    "start": 934.808,
    "end": 938.568,
    "duration": 3.76
  },
  {
    "id": 219,
    "text": "更强调了儒家仁民爱物的炽热诗心；",
    "start": 938.568,
    "end": 941.368,
    "duration": 2.8
  },
  {
    "id": 220,
    "text": "证明杜甫留下的绝非冷冰冰的政治档案，",
    "start": 941.688,
    "end": 944.808,
    "duration": 3.12
  },
  {
    "id": 221,
    "text": "而是外部事实真实与内部灵魂拷问高度融合的精神史诗，",
    "start": 944.808,
    "end": 949.688,
    "duration": 4.88
  },
  {
    "id": 222,
    "text": "完成了极具深度的立论拔高。",
    "start": 949.688,
    "end": 952.248,
    "duration": 2.56
  },
  {
    "id": 223,
    "text": "所以本段具体答题完整版为：四、诗美范式的内在升华：客观实录精神与主体仁爱诗心的辩证统一。",
    "start": 952.248,
    "end": 960.408,
    "duration": 8.16
  },
  {
    "id": 224,
    "text": "杜诗之所以被称为“诗史”，根本原因在于它既是“史”，",
    "start": 960.728,
    "end": 964.488,
    "duration": 3.76
  },
  {
    "id": 225,
    "text": "但其底色依然是“诗”。",
    "start": 964.488,
    "end": 966.248,
    "duration": 1.76
  },
  {
    "id": 226,
    "text": "杜甫继承了司马迁《史记》的“不虚美，",
    "start": 966.248,
    "end": 969.288,
    "duration": 3.04
  },
  {
    "id": 227,
    "text": "不隐恶”的实录风骨，敢于直刺权贵之昏庸。",
    "start": 969.288,
    "end": 972.728,
    "duration": 3.44
  },
  {
    "id": 228,
    "text": "但他并未停留于冷冰冰的历史编年，",
    "start": 972.728,
    "end": 975.208,
    "duration": 2.48
  },
  {
    "id": 229,
    "text": "而是将强烈的儒家爱民诗心注入每一次叙事之中。",
    "start": 975.208,
    "end": 978.968,
    "duration": 3.76
  },
  {
    "id": 230,
    "text": "在著名长篇《自京赴奉先县咏怀五百字》中，",
    "start": 979.368,
    "end": 983.528,
    "duration": 4.16
  },
  {
    "id": 231,
    "text": "诗人直面一己荣枯与天下危局。",
    "start": 983.528,
    "end": 986.568,
    "duration": 3.04
  },
  {
    "id": 232,
    "text": "诗史的内核是杜甫博大的胸襟与崇高的价值判断。",
    "start": 986.568,
    "end": 991.368,
    "duration": 4.8
  },
  {
    "id": 233,
    "text": "它展现的不仅是外部历史事实的真实，",
    "start": 991.368,
    "end": 994.248,
    "duration": 2.88
  },
  {
    "id": 234,
    "text": "更是历史震荡中一代仁人志士心灵搏击的真实。",
    "start": 994.248,
    "end": 998.408,
    "duration": 4.16
  },
  {
    "id": 235,
    "text": "--。第",
    "start": 998.408,
    "end": 998.568,
    "duration": 0.16
  },
  {
    "id": 236,
    "text": "六段：尾段收官与文学史谱系闭环。",
    "start": 998.568,
    "end": 1001.448,
    "duration": 2.88
  },
  {
    "id": 237,
    "text": "逐句因果推导与答题表述。",
    "start": 1001.688,
    "end": 1004.248,
    "duration": 2.56
  },
  {
    "id": 238,
    "text": "尾段作为三十分大题的收官，必须将杜甫诗史的成就置入纵向的文学史长河中完成传承闭环。",
    "start": 1004.248,
    "end": 1012.808,
    "duration": 8.56
  },
  {
    "id": 239,
    "text": "首句全面综合前文四个分论点，将实录精神与崇高诗心概括为一座文学丰碑。",
    "start": 1012.808,
    "end": 1019.848,
    "duration": 7.04
  },
  {
    "id": 240,
    "text": "所以表述为：综上所述，杜甫的“诗史”是求真史识与悲敏诗心相交融的文学丰碑。",
    "start": 1019.848,
    "end": 1027.073,
    "duration": 7.225
  },
  {
    "id": 241,
    "text": "次句从诗歌史的发展规律定型，指出它拓展了诗歌反映社会的深度，",
    "start": 1027.073,
    "end": 1033.113,
    "duration": 6.04
  },
  {
    "id": 242,
    "text": "实现了叙事诗的历史性飞跃。",
    "start": 1033.113,
    "end": 1035.701,
    "duration": 2.588
  },
  {
    "id": 243,
    "text": "所以表述为：它彻底拓展了古典诗歌反映社会生活的深度与广度，",
    "start": 1035.701,
    "end": 1041.524,
    "duration": 5.823
  },
  {
    "id": 244,
    "text": "实现了叙事诗体系的历史性飞跃。",
    "start": 1041.524,
    "end": 1044.544,
    "duration": 3.02
  },
  {
    "id": 245,
    "text": "第三句向中唐顺流推进，指出这一现实主义传统直接启迪了元结与顾况的写实探索。",
    "start": 1044.624,
    "end": 1052.224,
    "duration": 7.6
  },
  {
    "id": 246,
    "text": "所以表述为：这一艺术传统直接启迪了中唐元结、",
    "start": 1052.224,
    "end": 1056.304,
    "duration": 4.08
  },
  {
    "id": 247,
    "text": "顾况的写实探索。",
    "start": 1056.304,
    "end": 1057.664,
    "duration": 1.36
  },
  {
    "id": 248,
    "text": "第四句给出最终的流派传承定论，指出它是白居易、",
    "start": 1057.664,
    "end": 1061.984,
    "duration": 4.32
  },
  {
    "id": 249,
    "text": "元稹倡导新乐府运动的精神源头与艺术典范。",
    "start": 1061.984,
    "end": 1065.504,
    "duration": 3.52
  },
  {
    "id": 250,
    "text": "所以表述为：更是后世白居易、元稹倡导“新乐府运动”的核心精神源头与艺术楷模。",
    "start": 1065.824,
    "end": 1073.024,
    "duration": 7.2
  },
  {
    "id": 251,
    "text": "本段答题思路总结。",
    "start": 1073.024,
    "end": 1074.624,
    "duration": 1.6
  },
  {
    "id": 252,
    "text": "本段以扎实的文学史流变完成严密收束：先以两句话提炼杜诗在现实主义深度与叙事诗体制上的飞跃成就；",
    "start": 1074.624,
    "end": 1083.744,
    "duration": 9.12
  },
  {
    "id": 253,
    "text": "随即顺流而下，清晰勾勒出从杜甫出发，",
    "start": 1083.744,
    "end": 1087.344,
    "duration": 3.6
  },
  {
    "id": 254,
    "text": "经过中唐元结、顾况的过渡，最终汇入白居易、",
    "start": 1087.344,
    "end": 1090.944,
    "duration": 3.6
  },
  {
    "id": 255,
    "text": "元稹新乐府运动的历史脉络，使整道三十分大题在波澜壮阔的唐诗演进史中圆满收关。",
    "start": 1090.944,
    "end": 1097.824,
    "duration": 6.88
  },
  {
    "id": 256,
    "text": "所以本段具体答题完整版为：综上所述，",
    "start": 1098.144,
    "end": 1101.664,
    "duration": 3.52
  },
  {
    "id": 257,
    "text": "杜甫的“诗史”是求真史识与悲敏诗心相交融的文学丰碑。",
    "start": 1101.664,
    "end": 1107.024,
    "duration": 5.36
  },
  {
    "id": 258,
    "text": "它彻底拓展了古典诗歌反映社会生活的深度与广度，",
    "start": 1107.024,
    "end": 1111.584,
    "duration": 4.56
  },
  {
    "id": 259,
    "text": "实现了叙事诗体系的历史性飞跃。",
    "start": 1111.584,
    "end": 1114.224,
    "duration": 2.64
  },
  {
    "id": 260,
    "text": "这一艺术传统直接启迪了中唐元结、",
    "start": 1114.224,
    "end": 1117.104,
    "duration": 2.88
  },
  {
    "id": 261,
    "text": "顾况的写实探索。",
    "start": 1117.104,
    "end": 1118.624,
    "duration": 1.52
  },
  {
    "id": 262,
    "text": "更是后世白居易、元稹倡导“新乐府运动”的核心精神源头与艺术楷模。",
    "start": 1118.864,
    "end": 1125.344,
    "duration": 6.48
  },
  {
    "id": 263,
    "text": "整道大题的内在逻辑链总括。",
    "start": 1125.344,
    "end": 1127.904,
    "duration": 2.56
  },
  {
    "id": 264,
    "text": "这道三十分大题的本质，是一场极度严密的逻辑推演。",
    "start": 1127.904,
    "end": 1132.224,
    "duration": 4.32
  },
  {
    "id": 265,
    "text": "整篇答卷从头到尾遵循着“由概念定评、",
    "start": 1132.224,
    "end": 1135.824,
    "duration": 3.6
  },
  {
    "id": 266,
    "text": "到历史全景、到平民立场、到文体革新、",
    "start": 1135.824,
    "end": 1139.504,
    "duration": 3.68
  },
  {
    "id": 267,
    "text": "到诗史同构、最终回归文学史承续”的必然法则。",
    "start": 1139.504,
    "end": 1143.344,
    "duration": 3.84
  },
  {
    "id": 268,
    "text": "阅卷老师看到的绝不是孤立散乱的考点，",
    "start": 1143.584,
    "end": 1146.864,
    "duration": 3.28
  },
  {
    "id": 269,
    "text": "而是一条咬合紧密的因果长链：第一步是“立论定性”，",
    "start": 1146.864,
    "end": 1151.584,
    "duration": 4.72
  },
  {
    "id": 270,
    "text": "开门见山解决概念出处，确立社会全景与士人心灵史的二重内涵。",
    "start": 1151.584,
    "end": 1157.744,
    "duration": 6.16
  },
  {
    "id": 271,
    "text": "第二步是“时代全景”，以《兵车行》与《春望》证明杜诗反映由盛转衰历史事件的广度与真实。",
    "start": 1157.744,
    "end": 1164.784,
    "duration": 7.04
  },
  {
    "id": 272,
    "text": "第三步是“平民立场”，以《三吏》 《三别》证明杜甫打破官方正史视角，",
    "start": 1165.16,
    "end": 1170.76,
    "duration": 5.6
  },
  {
    "id": 273,
    "text": "开辟了关怀民生的修史新范式。",
    "start": 1170.76,
    "end": 1173.56,
    "duration": 2.8
  },
  {
    "id": 274,
    "text": "第四步是“体制革新”，以“即事名篇”与戏剧化独白，",
    "start": 1173.56,
    "end": 1178.12,
    "duration": 4.56
  },
  {
    "id": 275,
    "text": "证明杜诗在叙事机制与新题乐府上的体裁突破。",
    "start": 1178.12,
    "end": 1182.28,
    "duration": 4.16
  },
  {
    "id": 276,
    "text": "第五步是“美学升华”，阐明实录之史与仁爱之心的交融，",
    "start": 1182.28,
    "end": 1186.92,
    "duration": 4.64
  },
  {
    "id": 277,
    "text": "指出诗史的崇高底色是士人心灵史的真实。",
    "start": 1186.92,
    "end": 1190.44,
    "duration": 3.52
  },
  {
    "id": 278,
    "text": "第六步是“史学闭环”，把杜甫诗史传统自然引向中唐写实探索与白居易的新乐府运动。",
    "start": 1190.76,
    "end": 1199.0,
    "duration": 8.24
  },
  {
    "id": 279,
    "text": "这六步层层递进，前一步的结论必然成为后一步的前提。",
    "start": 1199.0,
    "end": 1203.8,
    "duration": 4.8
  },
  {
    "id": 280,
