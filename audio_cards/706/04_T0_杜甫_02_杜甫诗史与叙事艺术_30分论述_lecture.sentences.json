[
  {
    "id": 1,
    "text": "全局宏观破题与立论逻辑。",
    "start": 0.16,
    "end": 2.64,
    "duration": 2.48
  },
  {
    "id": 2,
    "text": "在考场下笔之前，必须先在宏观上审清这道三十分大题的核心考核意图。",
    "start": 2.64,
    "end": 8.48,
    "duration": 5.84
  },
  {
    "id": 3,
    "text": "本题表面上考查杜甫的一个美学荣誉标签，",
    "start": 8.48,
    "end": 11.84,
    "duration": 3.36
  },
  {
    "id": 4,
    "text": "本质上考查杜诗叙事体裁的历史性突破。",
    "start": 11.84,
    "end": 15.52,
    "duration": 3.68
  },
  {
    "id": 5,
    "text": "考场评分标准绝不满足于仅回答杜诗记录了哪些历史事件。",
    "start": 15.52,
    "end": 20.16,
    "duration": 4.64
  },
  {
    "id": 6,
    "text": "答题方向必须确立为“从历史客观真实，",
    "start": 20.48,
    "end": 23.84,
    "duration": 3.36
  },
  {
    "id": 7,
    "text": "推进到底层人道立场，再下沉至诗体革新机制，",
    "start": 23.84,
    "end": 27.92,
    "duration": 4.08
  },
  {
    "id": 8,
    "text": "最终升华至诗史同构的美学哲学”。",
    "start": 27.92,
    "end": 30.88,
    "duration": 2.96
  },
  {
    "id": 9,
    "text": "整道大题在宏观上划分为五个有机递进的逻辑层次：第一层，",
    "start": 30.88,
    "end": 35.6,
    "duration": 4.72
  },
  {
    "id": 10,
    "text": "开篇破题，交代“诗史”的文献定评、",
    "start": 35.6,
    "end": 38.56,
    "duration": 2.96
  },
  {
    "id": 11,
    "text": "教材权威界定与核心内涵。",
    "start": 38.56,
    "end": 40.64,
    "duration": 2.08
  },
  {
    "id": 12,
    "text": "第二层，论述叙事内容的广度，说明杜诗如何全景记录唐朝由盛转衰的历史进程。",
    "start": 40.88,
    "end": 48.32,
    "duration": 7.44
  },
  {
    "id": 13,
    "text": "第三层，论述叙事立场的转变，说明杜甫如何打破官方正史视角，",
    "start": 48.32,
    "end": 54.08,
    "duration": 5.76
  },
  {
    "id": 14,
    "text": "将镜头推向底层平民。",
    "start": 54.08,
    "end": 56.16,
    "duration": 2.08
  },
  {
    "id": 15,
    "text": "第四层，论述叙事技艺与体制，说明杜甫如何开创新题乐府，",
    "start": 56.16,
    "end": 61.76,
    "duration": 5.6
  },
  {
    "id": 16,
    "text": "以戏剧化细节支撑史诗。",
    "start": 61.76,
    "end": 63.76,
    "duration": 2.0
  },
  {
    "id": 17,
    "text": "第五层，升华至美学本体，阐释“客观实录之史”与“主观仁爱之诗”的辩证统一。",
    "start": 64.08,
    "end": 70.8,
    "duration": 6.72
  },
  {
    "id": 18,
    "text": "尾部收官，将结论放回文学史谱系，",
    "start": 70.8,
    "end": 74.16,
    "duration": 3.36
  },
  {
    "id": 19,
    "text": "交代其对中唐新乐府运动的直接催生。",
    "start": 74.16,
    "end": 77.52,
    "duration": 3.36
  },
  {
    "id": 20,
    "text": "这五个层次构成一条环环相扣的因果长链：界定概念是前提，",
    "start": 77.52,
    "end": 82.96,
    "duration": 5.44
  },
  {
    "id": 21,
    "text": "全景记录是基础，民间立场是灵魂，",
    "start": 82.96,
    "end": 86.16,
    "duration": 3.2
  },
  {
    "id": 22,
    "text": "文体革新是载体，诗心灌注是升华。",
    "start": 86.16,
    "end": 89.2,
    "duration": 3.04
  },
  {
    "id": 23,
    "text": "理顺了宏观全局思路，接下来进入每一段的具体推导与逐句表述。",
    "start": 89.52,
    "end": 95.04,
    "duration": 5.52
  },
  {
    "id": 24,
    "text": "第一段：首段破题与概念定性。",
    "start": 95.04,
    "end": 98.24,
    "duration": 3.2
  },
  {
    "id": 25,
    "text": "逐句因果推导与答题表述。",
    "start": 98.24,
    "end": 100.72,
    "duration": 2.48
  },
  {
    "id": 26,
    "text": "首句必须直击核心概念，绝不绕弯。",
    "start": 100.72,
    "end": 103.84,
    "duration": 3.12
  },
  {
    "id": 27,
    "text": "所以表述为：次句紧承首句给出历史文献来源，",
    "start": 103.84,
    "end": 108.08,
    "duration": 4.24
  },
  {
    "id": 28,
    "text": "证明概念的真实出处。",
    "start": 108.08,
    "end": 109.68,
    "duration": 1.6
  },
  {
    "id": 29,
    "text": "所以表述为：第三句紧接着补充正史典籍记载，",
    "start": 110.0,
    "end": 113.995,
    "duration": 3.995
  },
  {
    "id": 30,
    "text": "进一步夯实历史文献依据。",
    "start": 113.995,
    "end": 116.339,
    "duration": 2.344
  },
  {
    "id": 31,
    "text": "所以表述为：第四句必须引入考研权威教材的学术界定，",
    "start": 116.339,
    "end": 121.239,
    "duration": 4.9
  },
  {
    "id": 32,
    "text": "明确其现代诗学含义。",
    "start": 121.239,
    "end": 123.156,
    "duration": 1.917
  },
  {
    "id": 33,
    "text": "所以表述为：第五句深入阐发教材定义，",
    "start": 123.156,
    "end": 126.565,
    "duration": 3.409
  },
  {
    "id": 34,
    "text": "指出诗史既是社会变迁史，更是士人心灵史。",
    "start": 126.565,
    "end": 130.4,
    "duration": 3.835
  },
  {
    "id": 35,
    "text": "所以表述为：第六句作为首段过渡句，",
    "start": 130.56,
    "end": 133.881,
    "duration": 3.321
  },
  {
    "id": 36,
    "text": "宣告下文将从四个核心维度展开系统论证。",
    "start": 133.881,
    "end": 137.945,
    "duration": 4.064
  },
  {
    "id": 37,
    "text": "所以表述为：本段答题思路总结。",
    "start": 137.945,
    "end": 140.88,
    "duration": 2.935
  },
  {
    "id": 38,
    "text": "本段用六句话完成立论闭环：先直接亮出诗史的高度定评，",
    "start": 141.008,
    "end": 145.968,
    "duration": 4.96
  },
  {
    "id": 39,
    "text": "再接续《本事诗》与《新唐书》确立双重文献依据；",
    "start": 145.968,
    "end": 150.528,
    "duration": 4.56
  },
  {
    "id": 40,
    "text": "随即以袁行配教材将诗史提升到“客观历史全景与主体心灵史融合”的诗学高度；",
    "start": 150.528,
    "end": 157.728,
    "duration": 7.2
  },
  {
    "id": 41,
    "text": "最后自然转入四个维度的展开，开篇逻辑严密规范。",
    "start": 157.728,
    "end": 161.808,
    "duration": 4.08
  },
  {
    "id": 42,
    "text": "所以本段具体答题完整版为：第二段：第一分论点，",
    "start": 162.128,
    "end": 166.128,
    "duration": 4.0
  },
  {
    "id": 43,
    "text": "题材内容的广阔纪实（史之“真”）。",
    "start": 166.128,
    "end": 169.088,
    "duration": 2.96
  },
  {
    "id": 44,
    "text": "逐句因果推导与答题表述。",
    "start": 169.088,
    "end": 171.568,
    "duration": 2.48
  },
  {
    "id": 45,
    "text": "论述诗史，首先必须证明其记录的历史在广度上是否具备史诗特征。",
    "start": 171.568,
    "end": 177.888,
    "duration": 6.32
  },
  {
    "id": 46,
    "text": "首句确立分论点，指出杜甫打破狭隘私情，",
    "start": 177.888,
    "end": 181.568,
    "duration": 3.68
  },
  {
    "id": 47,
    "text": "以史家笔法直面社会现实。",
    "start": 181.568,
    "end": 183.728,
    "duration": 2.16
  },
  {
    "id": 48,
    "text": "所以表述为：次句概括其反映的历史广度，",
    "start": 184.128,
    "end": 187.638,
    "duration": 3.51
  },
  {
    "id": 49,
    "text": "完整涵盖了唐朝由盛转衰的完整脉络。",
    "start": 187.638,
    "end": 190.988,
    "duration": 3.35
  },
  {
    "id": 50,
    "text": "所以表述为：第三句调取安史之乱爆发前夕的代表作，",
    "start": 190.988,
    "end": 195.594,
    "duration": 4.606
  },
  {
    "id": 51,
    "text": "证明其对盛世危机的敏锐洞察。",
    "start": 195.594,
    "end": 198.315,
    "duration": 2.721
  },
  {
    "id": 52,
    "text": "所以表述为：第四句直接引用《兵车行》极具画面感开篇的著名原句。",
    "start": 198.315,
    "end": 203.968,
    "duration": 5.653
  },
  {
    "id": 53,
    "text": "所以表述为：第五句紧扣诗句展开历史阐析，",
    "start": 204.128,
    "end": 208.004,
    "duration": 3.876
  },
  {
    "id": 54,
    "text": "揭示统治集团开边政策对百姓的残害。",
    "start": 208.004,
    "end": 211.502,
    "duration": 3.498
  },
  {
    "id": 55,
    "text": "所以表述为：第六句推进到安史之乱爆发之后，",
    "start": 211.502,
    "end": 215.656,
    "duration": 4.154
  },
  {
    "id": 56,
    "text": "调取国都陷落时的经典诗篇。",
    "start": 215.656,
    "end": 218.279,
    "duration": 2.623
  },
  {
    "id": 57,
    "text": "所以表述为：第七句深入剖析诗句意境，",
    "start": 218.279,
    "end": 221.777,
    "duration": 3.498
  },
  {
    "id": 58,
    "text": "说明国破与城春的反差是极具概括力的历史底片。",
    "start": 221.777,
    "end": 226.368,
    "duration": 4.591
  },
  {
    "id": 59,
    "text": "所以表述为：第八句总结收束全段，",
    "start": 226.528,
    "end": 229.571,
    "duration": 3.043
  },
  {
    "id": 60,
    "text": "指出这种准确把握时代大势的笔力赋予了杜诗史学价值。",
    "start": 229.571,
    "end": 234.892,
    "duration": 5.321
  },
  {
    "id": 61,
    "text": "所以表述为：本段答题思路总结。",
    "start": 234.892,
    "end": 237.775,
    "duration": 2.883
  },
  {
    "id": 62,
    "text": "本段立足于客观历史真实的宏大视野：先从打破个人狭隘私情切入，",
    "start": 237.775,
    "end": 243.984,
    "duration": 6.209
  },
  {
    "id": 63,
    "text": "概括其涵盖由盛转衰的时代跨度；",
    "start": 243.984,
    "end": 247.088,
    "duration": 3.104
  },
  {
    "id": 64,
    "text": "随后调取战前的《兵车行》与沦陷期的《春望》进行前后对比验证；",
    "start": 247.248,
    "end": 252.448,
    "duration": 5.2
  },
  {
    "id": 65,
    "text": "证明杜诗不仅记录了具体战乱，更敏锐洞察了社会动荡的内在根源，",
    "start": 252.448,
    "end": 257.728,
    "duration": 5.28
  },
  {
    "id": 66,
    "text": "确立了诗史坚实的事实根基。",
    "start": 257.728,
    "end": 260.208,
    "duration": 2.48
  },
  {
    "id": 67,
    "text": "所以本段具体答题完整版为：第三段：第二分论点，",
    "start": 260.208,
    "end": 264.368,
    "duration": 4.16
  },
  {
    "id": 68,
    "text": "叙事立场的平民视角（史之“仁”）。",
    "start": 264.368,
    "end": 266.688,
    "duration": 2.32
  },
  {
    "id": 69,
    "text": "逐句因果推导与答题表述。",
    "start": 267.008,
    "end": 269.488,
    "duration": 2.48
  },
  {
    "id": 70,
    "text": "讲完记录历史的事件广度，本段必须进一步追问：杜甫是以什么立场来写史的。",
    "start": 269.488,
    "end": 275.408,
    "duration": 5.92
  },
  {
    "id": 71,
    "text": "首句确立分论点，对比传统正史的帝王将相，",
    "start": 275.408,
    "end": 278.928,
    "duration": 3.52
  },
  {
    "id": 72,
    "text": "指出杜甫开创了平民视角的修史范式。",
    "start": 278.928,
    "end": 282.048,
    "duration": 3.12
  },
  {
    "id": 73,
    "text": "所以表述为：次句推导因果，说明这种立场决定了他必须将镜头对准底层受难者。",
    "start": 282.048,
    "end": 288.528,
    "duration": 6.48
  },
  {
    "id": 74,
    "text": "所以表述为：第三句调取文学史上最著名的两组组诗，",
    "start": 288.528,
    "end": 293.376,
    "duration": 4.848
  },
  {
    "id": 75,
    "text": "确立本段的核心论据。",
    "start": 293.376,
    "end": 295.376,
    "duration": 2.0
  },
  {
    "id": 76,
    "text": "所以表述为：第四句选取《石壕吏》作为解剖样本，",
    "start": 295.376,
    "end": 299.65,
    "duration": 4.274
  },
  {
    "id": 77,
    "text": "展现其冷静克制的入笔方式。",
    "start": 299.65,
    "end": 302.393,
    "duration": 2.743
  },
  {
    "id": 78,
    "text": "所以表述为：第五句紧扣老妇口述细节，",
    "start": 302.393,
    "end": 306.05,
    "duration": 3.657
  },
  {
    "id": 79,
    "text": "剖析官吏残暴与平民牺牲的血淋淋现实。",
    "start": 306.05,
    "end": 309.936,
    "duration": 3.886
  },
  {
    "id": 80,
    "text": "所以表述为：第六句深化人物内心矛盾，",
    "start": 310.096,
    "end": 313.308,
    "duration": 3.212
  },
  {
    "id": 81,
    "text": "点出杜甫既同情百姓受难、又深知平叛大局的复杂心理。",
    "start": 313.308,
    "end": 317.988,
    "duration": 4.68
  },
  {
    "id": 82,
    "text": "所以表述为：第七句得出本段美学总结，",
    "start": 317.988,
    "end": 321.244,
    "duration": 3.256
  },
  {
    "id": 83,
    "text": "指出饱含平民悲敏的书写赋予了诗歌超越正史的人性力量。",
    "start": 321.244,
    "end": 326.331,
    "duration": 5.087
  },
  {
    "id": 84,
    "text": "所以表述为：本段答题思路总结。",
    "start": 326.331,
    "end": 328.976,
    "duration": 2.645
  },
  {
    "id": 85,
    "text": "本段是整道大题思想深度的关键支撑：首先将杜诗视角与官方正史做鲜明对照，",
    "start": 329.056,
    "end": 335.776,
    "duration": 6.72
  },
  {
    "id": 86,
    "text": "指出平民视角的革命性意义；",
    "start": 335.776,
    "end": 338.016,
    "duration": 2.24
  },
  {
    "id": 87,
    "text": "接着以《石壕吏》为微观例证，分析老妇从军悲剧背后复杂的官民矛盾与家国冲突；",
    "start": 338.016,
    "end": 344.496,
    "duration": 6.48
  },
  {
    "id": 88,
    "text": "最后点明深沉人道同情正是杜甫“诗史”区别于冰冷编年史的根本所在。",
    "start": 344.496,
    "end": 350.576,
    "duration": 6.08
  },
  {
    "id": 89,
    "text": "所以本段具体答题完整版为：第四段：第三分论点，",
    "start": 350.896,
    "end": 355.136,
    "duration": 4.24
  },
  {
    "id": 90,
    "text": "叙事文体与技艺的革新（体之“创”）。",
    "start": 355.136,
    "end": 358.256,
    "duration": 3.12
  },
  {
    "id": 91,
    "text": "逐句因果推导与答题表述。",
    "start": 358.256,
    "end": 361.056,
    "duration": 2.8
  },
  {
    "id": 92,
    "text": "前两段解决了历史内容与叙事立场，",
    "start": 361.056,
    "end": 364.096,
    "duration": 3.04
  },
  {
    "id": 93,
    "text": "本段必须回答这种宏大叙事依托怎样的文体技巧实现。",
    "start": 364.096,
    "end": 368.816,
    "duration": 4.72
  },
  {
    "id": 94,
    "text": "首句确立分论点，指出杜甫在文体与技法上打破了汉魏乐府旧题的桎梏。",
    "start": 368.816,
    "end": 374.576,
    "duration": 5.76
  },
  {
    "id": 95,
    "text": "所以表述为：次句引用中唐元稹的权威评语，",
    "start": 375.056,
    "end": 378.95,
    "duration": 3.894
  },
  {
    "id": 96,
    "text": "明确指出其文体革命的核心贡献。",
    "start": 378.95,
    "end": 382.025,
    "duration": 3.075
  },
  {
    "id": 97,
    "text": "所以表述为：第三句解释即事名篇的机制，",
    "start": 382.025,
    "end": 385.759,
    "duration": 3.734
  },
  {
    "id": 98,
    "text": "说明它依据眼前真实时事自创新题，",
    "start": 385.759,
    "end": 389.053,
    "duration": 3.294
  },
  {
    "id": 99,
    "text": "确立了新乐府范式。",
    "start": 389.053,
    "end": 390.81,
    "duration": 1.757
  },
  {
    "id": 100,
    "text": "所以表述为：第四句由文体体制推进至微观技巧，",
    "start": 390.81,
    "end": 395.203,
    "duration": 4.393
  },
  {
    "id": 101,
    "text": "指出他善于捕捉戏剧化场面与生动人物对话。",
    "start": 395.203,
    "end": 399.376,
    "duration": 4.173
  },
  {
    "id": 102,
    "text": "所以表述为：第五句调取代表作《新婚别》，",
    "start": 399.536,
    "end": 402.602,
    "duration": 3.066
  },
  {
    "id": 103,
    "text": "剖析其借新娘独白展现的大义与悲剧性。",
    "start": 402.602,
    "end": 405.896,
    "duration": 3.294
  },
  {
    "id": 104,
    "text": "所以表述为：第六句从叙事学视角进行定型，",
    "start": 405.896,
    "end": 409.384,
    "duration": 3.488
  },
  {
    "id": 105,
    "text": "说明第三人称白描与第一人称独白交织产生了动态张力。",
    "start": 409.384,
    "end": 414.034,
    "duration": 4.65
  },
  {
    "id": 106,
    "text": "所以表述为：第七句总结本段，指出中国古典诗歌自杜甫开始从单纯抒情成熟演化为宏大叙事载体。",
    "start": 414.034,
    "end": 421.977,
    "duration": 7.943
  },
  {
    "id": 107,
    "text": "所以表述为：本段答题思路总结。",
    "start": 421.977,
    "end": 424.496,
    "duration": 2.519
  },
  {
    "id": 108,
    "text": "本段聚焦于文学体制与叙事技艺的本体探索：先引入元稹“即事名篇”的定论，",
    "start": 424.64,
    "end": 431.28,
    "duration": 6.64
  },
  {
    "id": 109,
    "text": "说明摆脱乐府旧题在文体史上的开拓意义；",
    "start": 431.28,
    "end": 434.88,
    "duration": 3.6
  },
  {
    "id": 110,
    "text": "随后以《新婚别》的第一人称独白为例，",
    "start": 434.88,
    "end": 437.6,
    "duration": 2.72
  },
  {
    "id": 111,
    "text": "剖析戏剧化对话与多视角交织的叙事技巧；",
    "start": 437.6,
    "end": 441.28,
    "duration": 3.68
  },
  {
    "id": 112,
    "text": "最终落脚于古典诗歌从单纯抒情向成熟叙事的跨越，",
    "start": 441.28,
    "end": 446.24,
    "duration": 4.96
  },
  {
    "id": 113,
    "text": "论证了杜甫在诗体机制上的卓越贡献。",
    "start": 446.24,
    "end": 449.2,
    "duration": 2.96
  },
  {
    "id": 114,
    "text": "所以本段具体答题完整版为：第五段：第四分论点，",
    "start": 449.52,
    "end": 453.6,
    "duration": 4.08
  },
  {
    "id": 115,
    "text": "实录精神与主体诗心的统一（美之“核”）。",
    "start": 453.6,
    "end": 457.04,
    "duration": 3.44
  },
  {
    "id": 116,
    "text": "逐句因果推导与答题表述。",
    "start": 457.04,
    "end": 459.76,
    "duration": 2.72
  },
  {
    "id": 117,
    "text": "在剖析了内容、立场与文体之后，本段必须在美学与史学哲学的高度对“诗史”进行理论界定。",
    "start": 459.76,
    "end": 467.2,
    "duration": 7.44
  },
  {
    "id": 118,
    "text": "首句立论，指出诗史的根本原因在于它既是历史实录，",
    "start": 467.52,
    "end": 471.76,
    "duration": 4.24
  },
  {
    "id": 119,
    "text": "又始终保有诗歌的抒情本体。",
    "start": 471.76,
    "end": 474.16,
    "duration": 2.4
  },
  {
    "id": 120,
    "text": "所以表述为：次句上溯史学源流，指出杜甫直接继承了司马迁《史记》的直笔实录风骨。",
    "start": 474.16,
    "end": 480.88,
    "duration": 6.72
  },
  {
    "id": 121,
    "text": "所以表述为：第三句紧承次句，说明杜诗没有沦为干燥编年史，",
    "start": 480.88,
    "end": 486.16,
    "duration": 5.28
  },
  {
    "id": 122,
    "text": "在于融入了儒家爱民的炽热诗心。",
    "start": 486.16,
    "end": 488.4,
    "duration": 2.24
  },
  {
    "id": 123,
    "text": "所以表述为：第四句调取其最宏大的抒情叙事长篇，",
    "start": 488.8,
    "end": 493.319,
    "duration": 4.519
  },
  {
    "id": 124,
    "text": "展现诗人将个人荣辱与天下危局交融的笔力。",
    "start": 493.319,
    "end": 497.459,
    "duration": 4.14
  },
  {
    "id": 125,
    "text": "所以表述为：第五句指出诗史的深层灵魂，",
    "start": 497.459,
    "end": 501.164,
    "duration": 3.705
  },
  {
    "id": 126,
    "text": "在于诗人崇高的道德判断与悲敏胸怀。",
    "start": 501.164,
    "end": 504.651,
    "duration": 3.487
  },
  {
    "id": 127,
    "text": "所以表述为：第六句得出哲学层面的结论，",
    "start": 504.651,
    "end": 508.356,
    "duration": 3.705
  },
  {
    "id": 128,
    "text": "指出诗史不仅是客观外部事件的真实，",
    "start": 508.356,
    "end": 511.843,
    "duration": 3.487
  },
  {
    "id": 129,
    "text": "更是士人心灵搏击的真实。",
    "start": 511.843,
    "end": 514.24,
    "duration": 2.397
  },
  {
    "id": 130,
    "text": "所以表述为：本段答题思路总结。",
    "start": 514.32,
    "end": 517.2,
    "duration": 2.88
  },
  {
    "id": 131,
    "text": "本段将诗史的讨论推向了美学最高境界：明确界定“诗”与“史”的辩证关系，",
    "start": 517.2,
    "end": 523.36,
    "duration": 6.16
  },
  {
    "id": 132,
    "text": "既承认其继承了司马迁直笔实录的史学风骨，",
    "start": 523.36,
    "end": 527.12,
    "duration": 3.76
  },
  {
    "id": 133,
    "text": "更强调了儒家仁民爱物的炽热诗心；",
    "start": 527.12,
    "end": 530.32,
    "duration": 3.2
  },
  {
    "id": 134,
    "text": "证明杜甫留下的绝非冷冰冰的政治档案，",
    "start": 530.32,
    "end": 533.44,
    "duration": 3.12
  },
  {
    "id": 135,
    "text": "而是外部事实真实与内部灵魂拷问高度融合的精神史诗，",
    "start": 533.44,
    "end": 538.0,
    "duration": 4.56
  },
  {
    "id": 136,
    "text": "完成了极具深度的立论拔高。",
    "start": 538.0,
    "end": 540.08,
    "duration": 2.08
  },
  {
    "id": 137,
    "text": "所以本段具体答题完整版为：第六段：尾段收官与文学史谱系闭环。",
    "start": 540.4,
    "end": 546.56,
    "duration": 6.16
  },
  {
    "id": 138,
    "text": "逐句因果推导与答题表述。",
    "start": 546.56,
    "end": 548.96,
    "duration": 2.4
  },
  {
    "id": 139,
    "text": "尾段作为、三十分大题的收官，必须将杜甫诗史的成就置入纵向的文学史长河中完成传承闭环。",
    "start": 548.96,
    "end": 557.04,
    "duration": 8.08
  },
  {
    "id": 140,
    "text": "首句全面综合前文四个分论点，将实录精神与崇高诗心概括为一座文学丰碑。",
    "start": 557.04,
    "end": 563.6,
    "duration": 6.56
  },
  {
    "id": 141,
    "text": "所以表述为：次句从诗歌史的发展规律定型，",
    "start": 563.92,
    "end": 567.716,
    "duration": 3.796
  },
  {
    "id": 142,
    "text": "指出它拓展了诗歌反映社会的深度，",
    "start": 567.716,
    "end": 570.924,
    "duration": 3.208
  },
  {
    "id": 143,
    "text": "实现了叙事诗的历史性飞跃。",
    "start": 570.924,
    "end": 573.491,
    "duration": 2.567
  },
  {
    "id": 144,
    "text": "所以表述为：第三句向中唐顺流推进，",
    "start": 573.491,
    "end": 577.088,
    "duration": 3.597
  },
  {
    "id": 145,
    "text": "指出这一现实主义传统直接启迪了元结与顾况的写实探索。",
    "start": 577.088,
    "end": 581.888,
    "duration": 4.8
  },
  {
    "id": 146,
    "text": "所以表述为：第四句给出最终的流派传承定论，",
    "start": 581.888,
    "end": 585.648,
    "duration": 3.76
  },
  {
    "id": 147,
    "text": "指出它是白居易、元稹倡导新乐府运动的精神源头与艺术典范。",
    "start": 585.648,
    "end": 590.768,
    "duration": 5.12
  },
  {
    "id": 148,
    "text": "所以表述为：本段答题思路总结。",
    "start": 590.768,
    "end": 593.248,
    "duration": 2.48
  },
  {
    "id": 149,
    "text": "本段以扎实的文学史流变完成严密收束：先以两句话提炼杜诗在现实主义深度与叙事诗体制上的飞跃成就；",
    "start": 593.488,
    "end": 602.208,
    "duration": 8.72
  },
  {
    "id": 150,
    "text": "随即顺流而下，清晰勾勒出从杜甫出发，",
    "start": 602.208,
    "end": 606.208,
    "duration": 4.0
  },
  {
    "id": 151,
    "text": "经过中唐元结、顾况的过渡，最终汇入白居易、",
    "start": 606.208,
    "end": 610.288,
    "duration": 4.08
  },
  {
    "id": 152,
    "text": "元稹新乐府运动的历史脉络，使整道三十分大题在波澜壮阔的唐诗演进史中圆满收关。",
    "start": 610.288,
    "end": 617.728,
    "duration": 7.44
  },
  {
    "id": 153,
    "text": "所以本段具体答题完整版为：整道大题的内在逻辑链总括。",
    "start": 618.128,
    "end": 622.928,
    "duration": 4.8
  },
  {
    "id": 154,
    "text": "这道三十分大题的本质，是一场极度严密的逻辑推演。",
    "start": 622.928,
    "end": 627.168,
    "duration": 4.24
  },
  {
    "id": 155,
    "text": "整篇答卷从头到尾遵循着“由概念定评、",
    "start": 627.168,
    "end": 630.608,
    "duration": 3.44
  },
  {
    "id": 156,
    "text": "到历史全景、到平民立场、到文体革新、",
    "start": 630.608,
    "end": 634.608,
    "duration": 4.0
  },
  {
    "id": 157,
    "text": "到诗史同构、最终回归文学史承续”的必然法则。",
    "start": 634.608,
    "end": 638.528,
    "duration": 3.92
  },
  {
    "id": 158,
    "text": "阅卷老师看到的绝不是孤立散乱的考点，",
    "start": 638.768,
    "end": 642.048,
    "duration": 3.28
  },
  {
    "id": 159,
    "text": "而是一条咬合紧密的因果长链：第一步是“立论定性”，",
    "start": 642.048,
    "end": 646.768,
    "duration": 4.72
  },
  {
    "id": 160,
    "text": "开门见山解决概念出处，确立社会全景与士人心灵史的二重内涵。",
    "start": 646.768,
    "end": 652.928,
    "duration": 6.16
  },
  {
    "id": 161,
    "text": "第二步是“时代全景”，以《兵车行》与《春望》证明杜诗反映由盛转衰历史事件的广度与真实。",
    "start": 652.928,
    "end": 659.968,
    "duration": 7.04
  },
  {
    "id": 162,
    "text": "第三步是“平民立场”，以《三吏》 《三别》证明杜甫打破官方正史视角，",
    "start": 660.288,
    "end": 665.888,
    "duration": 5.6
  },
  {
    "id": 163,
    "text": "开辟了关怀民生的修史新范式。",
    "start": 665.888,
    "end": 668.688,
    "duration": 2.8
  },
  {
    "id": 164,
    "text": "第四步是“体制革新”，以“即事名篇”与戏剧化独白，",
    "start": 668.688,
    "end": 673.248,
    "duration": 4.56
  },
  {
    "id": 165,
    "text": "证明杜诗在叙事机制与新题乐府上的体裁突破。",
    "start": 673.248,
    "end": 677.408,
    "duration": 4.16
  },
  {
    "id": 166,
    "text": "第五步是“美学升华”，阐明实录之史与仁爱之心的交融，",
    "start": 677.408,
    "end": 682.048,
    "duration": 4.64
  },
  {
    "id": 167,
    "text": "指出诗史的崇高底色是士人心灵史的真实。",
    "start": 682.048,
    "end": 685.568,
    "duration": 3.52
  },
  {
    "id": 168,
    "text": "第六步是“史学闭环”，把杜甫诗史传统自然引向中唐写实探索与白居易的新乐府运动。",
    "start": 685.888,
    "end": 694.128,
    "duration": 8.24
  },
  {
    "id": 169,
    "text": "这六步层层递进，前一步的结论必然成为后一步的前提。",
    "start": 694.128,
    "end": 698.928,
    "duration": 4.8
  },
  {
    "id": 170,
    "text": "你在考场上顺着因果关系顺流而下，",
    "start": 698.928,
    "end": 701.968,
    "duration": 3.04
  },
  {
    "id": 171,
    "text": "就能自然写出近千字的满分答卷。",
    "start": 701.968,
    "end": 704.688,
    "duration": 2.72
  }
]