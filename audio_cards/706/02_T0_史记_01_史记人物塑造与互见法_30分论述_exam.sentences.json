[
  {
    "id": 1,
    "text": "《史记》是中国古代文学史上第一部纪传体通史。",
    "start": 0.0,
    "end": 3.909,
    "duration": 3.909
  },
  {
    "id": 2,
    "text": "鲁迅在《汉文学史纲要》中盛赞其为“史家之绝唱，",
    "start": 3.909,
    "end": 7.817,
    "duration": 3.908
  },
  {
    "id": 3,
    "text": "无韵之离骚”。",
    "start": 7.817,
    "end": 8.846,
    "duration": 1.029
  },
  {
    "id": 4,
    "text": "袁行配《中国文学史》将其确立为中国古代传记文学的最高典范。",
    "start": 8.846,
    "end": 14.194,
    "duration": 5.348
  },
  {
    "id": 5,
    "text": "司马迁开创了以人物为中心的修史体制，",
    "start": 14.194,
    "end": 17.691,
    "duration": 3.497
  },
  {
    "id": 6,
    "text": "构建起辉煌壮丽的人物画廊。",
    "start": 17.691,
    "end": 20.16,
    "duration": 2.469
  },
  {
    "id": 7,
    "text": "其卓越的人物塑造艺术与纪传体笔法，",
    "start": 20.24,
    "end": 23.44,
    "duration": 3.2
  },
  {
    "id": 8,
    "text": "主要体现在以下四个核心维度：“互见法”是司马迁在纪传体体制下首创的卓越人物塑造技巧。",
    "start": 23.44,
    "end": 31.52,
    "duration": 8.08
  },
  {
    "id": 9,
    "text": "所谓互见法，即在某人主传中突出其主导性格，",
    "start": 31.52,
    "end": 35.92,
    "duration": 4.4
  },
  {
    "id": 10,
    "text": "而将其不同甚至矛盾的侧面写入相关他人的传记。",
    "start": 35.92,
    "end": 39.52,
    "duration": 3.6
  },
  {
    "id": 11,
    "text": "这种笔法避免了主传叙事的杂乱，同时展现了人性的立体多面与历史的深层复杂。",
    "start": 39.76,
    "end": 47.04,
    "duration": 7.28
  },
  {
    "id": 12,
    "text": "在刻画汉高祖刘邦时，司马迁在《高祖本纪》中主要突出其知人善任、",
    "start": 47.04,
    "end": 53.04,
    "duration": 6.0
  },
  {
    "id": 13,
    "text": "豁达大度的帝王雄略。",
    "start": 53.04,
    "end": 55.04,
    "duration": 2.0
  },
  {
    "id": 14,
    "text": "然而在《项羽本纪》与《淮阴侯列传》中，",
    "start": 55.04,
    "end": 57.92,
    "duration": 2.88
  },
  {
    "id": 15,
    "text": "却补叙其无赖贪婪、背信弃义与屠戮功臣的阴暗面。",
    "start": 57.92,
    "end": 62.32,
    "duration": 4.4
  },
  {
    "id": 16,
    "text": "在刻画名将李广时，《李将军列传》极写其勇武消捷、",
    "start": 62.56,
    "end": 67.28,
    "duration": 4.72
  },
  {
    "id": 17,
    "text": "爱护士卒的天赋神勇。",
    "start": 67.28,
    "end": 69.28,
    "duration": 2.0
  },
  {
    "id": 18,
    "text": "而在《卫将军骠骑列传》中，又直笔载入其杀降霸陵尉与部伍散漫的偏狭行径。",
    "start": 69.28,
    "end": 75.92,
    "duration": 6.64
  },
  {
    "id": 19,
    "text": "互见法的精妙运用，彻底打破了脸谱化与扁平化，",
    "start": 75.92,
    "end": 80.24,
    "duration": 4.32
  },
  {
    "id": 20,
    "text": "真实还原了血肉丰满的活人。",
    "start": 80.24,
    "end": 82.32,
    "duration": 2.08
  },
  {
    "id": 21,
    "text": "司马迁善于选取历史风云激荡的关键转折点，",
    "start": 82.72,
    "end": 86.32,
    "duration": 3.6
  },
  {
    "id": 22,
    "text": "将人物置于尖锐的戏剧化冲突中展开刻画。",
    "start": 86.32,
    "end": 90.08,
    "duration": 3.76
  },
  {
    "id": 23,
    "text": "他通过生死攸关的重大场景，让人物在剧烈对峙中充分外化其性格特质。",
    "start": 90.08,
    "end": 96.24,
    "duration": 6.16
  },
  {
    "id": 24,
    "text": "这一艺术手法的最高范式，当属《项羽本纪》中的“鸿门宴”。",
    "start": 96.24,
    "end": 100.48,
    "duration": 4.24
  },
  {
    "id": 25,
    "text": "在短短一个宴席之间，各方势力的生死搏杀与权谋机变被推向了极限。",
    "start": 100.88,
    "end": 106.88,
    "duration": 6.0
  },
  {
    "id": 26,
    "text": "项羽的刚愎自负、刘邦的隐忍圆滑、",
    "start": 106.88,
    "end": 110.08,
    "duration": 3.2
  },
  {
    "id": 27,
    "text": "范增的焦躁毒辣、张良的从容沉着，",
    "start": 110.08,
    "end": 113.12,
    "duration": 3.04
  },
  {
    "id": 28,
    "text": "皆在剑拔弩张中展现无遗。",
    "start": 113.12,
    "end": 115.76,
    "duration": 2.64
  },
  {
    "id": 29,
    "text": "又如《廉颇赁相如列传》串联起完璧归赵、",
    "start": 115.76,
    "end": 119.28,
    "duration": 3.52
  },
  {
    "id": 30,
    "text": "渑池之会与负荆请罪三大高潮场面。",
    "start": 119.28,
    "end": 122.64,
    "duration": 3.36
  },
  {
    "id": 31,
    "text": "在国家存亡的外交风暴与将相内部的矛盾激化中，",
    "start": 122.96,
    "end": 127.12,
    "duration": 4.16
  },
  {
    "id": 32,
    "text": "赁相如的大智大勇与廉颇的磊落坦荡得到了淋漓尽致的呈现。",
    "start": 127.12,
    "end": 132.24,
    "duration": 5.12
  },
  {
    "id": 33,
    "text": "司马迁在刻画人物时精于白描技法，",
    "start": 132.24,
    "end": 135.04,
    "duration": 2.8
  },
  {
    "id": 34,
    "text": "极善于抓取富于个性特征的言谈与典型细节。",
    "start": 135.04,
    "end": 139.12,
    "duration": 4.08
  },
  {
    "id": 35,
    "text": "他深安不同阶层、不同性格人物的语言风味，",
    "start": 139.12,
    "end": 142.32,
    "duration": 3.2
  },
  {
    "id": 36,
    "text": "做到言如其人、神采毕现。",
    "start": 142.32,
    "end": 144.64,
    "duration": 2.32
  },
  {
    "id": 37,
    "text": "在面对秦始皇浩荡出巡时，项羽脱口而出：“彼可取而代也”，",
    "start": 145.096,
    "end": 149.896,
    "duration": 4.8
  },
  {
    "id": 38,
    "text": "尽显楚霸王豪迈拔山的狂傲霸气。",
    "start": 149.896,
    "end": 152.856,
    "duration": 2.96
  },
  {
    "id": 39,
    "text": "而刘邦见之则悄然叹曰：“嗟乎，大丈夫当如此也”，",
    "start": 152.856,
    "end": 157.096,
    "duration": 4.24
  },
  {
    "id": 40,
    "text": "尽显市井豪徒的艳羡狡黠与深沉野心。",
    "start": 157.096,
    "end": 160.536,
    "duration": 3.44
  },
  {
    "id": 41,
    "text": "两句对话形成鲜明对照，深刻揭示了两位历史消雄迥异的性格与政治格局。",
    "start": 160.536,
    "end": 166.376,
    "duration": 5.84
  },
  {
    "id": 42,
    "text": "在细节捕捉上，垓下重围时项羽慷慨悲歌泣下数行，",
    "start": 166.696,
    "end": 171.976,
    "duration": 5.28
  },
  {
    "id": 43,
    "text": "乌江自刎前赠头故人吕马童。",
    "start": 171.976,
    "end": 174.616,
    "duration": 2.64
  },
  {
    "id": 44,
    "text": "刘邦在鸿门宴借口如厕仓皇脱逃，被项羽射中胸口却俯身按足高呼“虏中吾指”。",
    "start": 174.616,
    "end": 182.296,
    "duration": 7.68
  },
  {
    "id": 45,
    "text": "这些极具戏剧感的传神细节，使两千年前的历史人物如在眼前、",
    "start": 182.296,
    "end": 187.576,
    "duration": 5.28
  },
  {
    "id": 46,
    "text": "历历在目。",
    "start": 187.576,
    "end": 188.456,
    "duration": 0.88
  },
  {
    "id": 47,
    "text": "司马迁在李陵之祸后秉持“发愤著书”之旨，",
    "start": 188.776,
    "end": 192.696,
    "duration": 3.92
  },
  {
    "id": 48,
    "text": "将深沉的生命血泪融入了历史人物的塑造。",
    "start": 192.696,
    "end": 196.376,
    "duration": 3.68
  },
  {
    "id": 49,
    "text": "他打破了成王败寇的封建世俗功利准则，",
    "start": 196.376,
    "end": 199.816,
    "duration": 3.44
  },
  {
    "id": 50,
    "text": "在字里行间倾注了极强的道德批判与悲敏情怀。",
    "start": 199.816,
    "end": 204.376,
    "duration": 4.56
  },
  {
    "id": 51,
    "text": "他为失败的悲剧英雄项羽立本纪，为揭竿而起的陈胜立世家，",
    "start": 204.376,
    "end": 209.816,
    "duration": 5.44
  },
  {
    "id": 52,
    "text": "更为刺客、游侠与微贱之人作传。",
    "start": 209.816,
    "end": 212.776,
    "duration": 2.96
  },
  {
    "id": 53,
    "text": "在叙事之末，司马迁常以“太史公曰”的史官赞语，",
    "start": 213.016,
    "end": 217.496,
    "duration": 4.48
  },
  {
    "id": 54,
    "text": "将隐忍内敛的叙事骤然升华为激昂的抒情议论。",
    "start": 217.496,
    "end": 222.056,
    "duration": 4.56
  },
  {
    "id": 55,
    "text": "这种融注了强烈主体情感与人文关怀的史笔，",
    "start": 222.056,
    "end": 225.896,
    "duration": 3.84
  },
  {
    "id": 56,
    "text": "赋予了整部传记壮烈深沉的悲剧崇高美。",
    "start": 225.896,
    "end": 229.576,
    "duration": 3.68
  },
  {
    "id": 57,
    "text": "综上所述，《史记》实现了求真史学与伟大文学的极致结合。",
    "start": 229.576,
    "end": 234.536,
    "duration": 4.96
  },
  {
    "id": 58,
    "text": "它开辟了纪传体传记文学的标准体例，",
    "start": 234.776,
    "end": 237.896,
    "duration": 3.12
  },
  {
    "id": 59,
    "text": "彻底奠定了中国叙事散文的崇高传统。",
    "start": 237.896,
    "end": 241.336,
    "duration": 3.44
  },
  {
    "id": 60,
    "text": "这一人物塑造艺术不仅为历代正史修撰树立了难以企及的规范。",
    "start": 241.336,
    "end": 246.936,
    "duration": 5.6
  },
  {
    "id": 61,
    "text": "更是后世唐宋传奇、宋元戏曲与明清长篇小说人物刻画的源头先导。--",
    "start": 246.936,
    "end": 253.416,
    "duration": 6.48
  }
]