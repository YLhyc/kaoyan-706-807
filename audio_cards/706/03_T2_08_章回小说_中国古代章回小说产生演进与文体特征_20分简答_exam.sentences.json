[
  {
    "id": 1,
    "text": "简述中国古代章回小说的产生演进历程与文体特征。",
    "start": 0.2,
    "end": 4.68,
    "duration": 4.48
  },
  {
    "id": 2,
    "text": "章回小说是中国古代长篇小说的主要体制，",
    "start": 5.2,
    "end": 8.48,
    "duration": 3.28
  },
  {
    "id": 3,
    "text": "孕育于宋元讲史等说话伎艺，在明代趋于定型并走向繁荣。",
    "start": 8.85,
    "end": 13.89,
    "duration": 5.04
  },
  {
    "id": 4,
    "text": "其产生演进历程与文体特征，主要体现在以下三个方面：",
    "start": 14.41,
    "end": 18.73,
    "duration": 4.32
  },
  {
    "id": 5,
    "text": "第一，脱胎于宋元说话讲史传统，由民间编创演进为文人独创。",
    "start": 19.1,
    "end": 24.78,
    "duration": 5.68
  },
  {
    "id": 6,
    "text": "章回小说源于宋元瓦舍中的“说话”伎艺，尤其是长篇分节讲说历代兴废战争的“讲史”话本。",
    "start": 25.3,
    "end": 32.82,
    "duration": 7.52
  },
  {
    "id": 7,
    "text": "艺人为吸引听众连续听讲，逐渐演化出分回标目与回末设悬的讲述技巧。",
    "start": 33.34,
    "end": 39.42,
    "duration": 6.08
  },
  {
    "id": 8,
    "text": "元末明初，文人在民间话本基础上加工写定《三国志通俗演义》与《水浒传》，标志着章回小说的正式确立；",
    "start": 39.94,
    "end": 48.58,
    "duration": 8.64
  },
  {
    "id": 9,
    "text": "明代后期《金瓶梅》问世，开启了文人独立创作长篇世情小说的阶段；",
    "start": 49.1,
    "end": 54.06,
    "duration": 4.96
  },
  {
    "id": 10,
    "text": "至清代《儒林外史》与《红楼梦》，章回小说达到艺术成熟的高峰。",
    "start": 54.58,
    "end": 59.38,
    "duration": 4.8
  },
  {
    "id": 11,
    "text": "第二，确立分回标目与回末设悬念的独特叙事体制。",
    "start": 59.9,
    "end": 64.38,
    "duration": 4.48
  },
  {
    "id": 12,
    "text": "章回小说以“回”为基本叙事单元，每回相对独立而又首尾勾连，构成统一整体。",
    "start": 64.9,
    "end": 72.26,
    "duration": 7.36
  },
  {
    "id": 13,
    "text": "每回之首冠以回目，经历了由宋元平话长短参差、嘉靖本《三国志通俗演义》单句七字目，",
    "start": 72.78,
    "end": 80.7,
    "duration": 7.92
  },
  {
    "id": 14,
    "text": "到万历本《水浒传》双句大致对偶，再到崇祯本《金瓶梅》双句工整对偶的定型过程，起到提纲挈领之效。",
    "start": 81.07,
    "end": 89.87,
    "duration": 8.8
  },
  {
    "id": 15,
    "text": "每回之末保留说话人惯例，在情节紧要处以“欲知后事如何，且听下回分解”煞尾，",
    "start": 90.39,
    "end": 98.2,
    "duration": 7.81
  },
  {
    "id": 16,
    "text": "既维系了读者期待，又串接起长篇结构的连贯脉络。",
    "start": 98.57,
    "end": 102.97,
    "duration": 4.4
  },
  {
    "id": 17,
    "text": "第三，沿用说话人口吻、韵散结合与不断精进的结构布局。",
    "start": 103.49,
    "end": 108.29,
    "duration": 4.8
  },
  {
    "id": 18,
    "text": "章回小说普遍模拟“说话人”讲故事的腔调统摄全篇，",
    "start": 108.81,
    "end": 113.21,
    "duration": 4.4
  },
  {
    "id": 19,
    "text": "正文常以“话说”“且说”发端，行文中兼插诗词曲赋以描摹场景、评赞人物；",
    "start": 113.58,
    "end": 119.66,
    "duration": 6.08
  },
  {
    "id": 20,
    "text": "语言融汇民间白话口语与文人雅化笔法，生动传神。",
    "start": 120.18,
    "end": 124.66,
    "duration": 4.48
  },
  {
    "id": 21,
    "text": "在长篇结构上，也逐步由《三国志演义》《水浒传》式的线性串联，",
    "start": 125.18,
    "end": 130.06,
    "duration": 4.88
  },
  {
    "id": 22,
    "text": "发展为《红楼梦》式的网状交叉布局，显示出中国古代长篇叙事艺术的持续深化。",
    "start": 130.43,
    "end": 136.99,
    "duration": 6.56
  }
]