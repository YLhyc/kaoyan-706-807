[
  {
    "id": 1,
    "text": "简述中国古代章回小说的产生演进历程与文体特征。",
    "start": 0.11,
    "end": 4.666,
    "duration": 4.556
  },
  {
    "id": 2,
    "text": "章回小说是中国古代长篇小说的主要体制，",
    "start": 5.166,
    "end": 8.374,
    "duration": 3.208
  },
  {
    "id": 3,
    "text": "孕育于宋元讲史等说话伎艺，在明代趋于定型并走向繁荣。",
    "start": 8.724,
    "end": 13.74,
    "duration": 5.016
  },
  {
    "id": 4,
    "text": "其产生演进历程与文体特征，主要体现在以下三个方面：",
    "start": 14.24,
    "end": 18.673,
    "duration": 4.433
  },
  {
    "id": 5,
    "text": "第一，脱胎于宋元说话讲史传统，由民间编创演进为文人独创。",
    "start": 19.365,
    "end": 24.972,
    "duration": 5.607
  },
  {
    "id": 6,
    "text": "章回小说源于宋元瓦舍中的“说话”伎艺，尤其是长篇分节讲说历代兴废战争的“讲史”话本。",
    "start": 25.472,
    "end": 33.149,
    "duration": 7.677
  },
  {
    "id": 7,
    "text": "艺人为吸引听众连续听讲，逐渐演化出分回标目与回末设悬的讲述技巧。",
    "start": 33.649,
    "end": 40.186,
    "duration": 6.537
  },
  {
    "id": 8,
    "text": "元末明初，文人在民间话本基础上加工写定《三国志通俗演义》与《水浒传》，标志着章回小说的正式确立；",
    "start": 40.686,
    "end": 49.265,
    "duration": 8.579
  },
  {
    "id": 9,
    "text": "明代后期《金瓶梅》问世，开启了文人独立创作长篇世情小说的阶段；",
    "start": 49.765,
    "end": 55.122,
    "duration": 5.357
  },
  {
    "id": 10,
    "text": "至清代《儒林外史》与《红楼梦》，章回小说达到艺术成熟的高峰。",
    "start": 55.73,
    "end": 60.461,
    "duration": 4.731
  },
  {
    "id": 11,
    "text": "第二，确立分回标目与回末设悬念的独特叙事体制。",
    "start": 61.119,
    "end": 65.738,
    "duration": 4.619
  },
  {
    "id": 12,
    "text": "章回小说以“回”为基本叙事单元，每回相对独立而又首尾勾连，构成统一整体。",
    "start": 66.238,
    "end": 72.349,
    "duration": 6.111
  },
  {
    "id": 13,
    "text": "每回之首冠以回目，经历了由宋元平话长短参差、嘉靖本《三国志通俗演义》单句七字目，",
    "start": 72.849,
    "end": 80.037,
    "duration": 7.188
  },
  {
    "id": 14,
    "text": "到万历本《水浒传》双句大致对偶，",
    "start": 80.387,
    "end": 82.883,
    "duration": 2.496
  },
  {
    "id": 15,
    "text": "再到崇祯本《金瓶梅》双句工整对偶的定型过程，起到提纲挈领之效。",
    "start": 83.302,
    "end": 88.646,
    "duration": 5.344
  },
  {
    "id": 16,
    "text": "每回之末保留说话人惯例，在情节紧要处以“欲知后事如何，且听下回分解”煞尾，",
    "start": 89.146,
    "end": 96.365,
    "duration": 7.219
  },
  {
    "id": 17,
    "text": "既维系了读者期待，又串接起长篇结构的连贯脉络。",
    "start": 96.715,
    "end": 100.918,
    "duration": 4.203
  },
  {
    "id": 18,
    "text": "第三，沿用说话人口吻、韵散结合与不断精进的结构布局。",
    "start": 101.543,
    "end": 106.491,
    "duration": 4.948
  },
  {
    "id": 19,
    "text": "章回小说普遍模拟“说话人”讲故事的腔调统摄全篇，",
    "start": 107.027,
    "end": 111.168,
    "duration": 4.141
  },
  {
    "id": 20,
    "text": "正文常以“话说”“且说”发端，行文中兼插诗词曲赋以描摹场景、评赞人物；",
    "start": 111.602,
    "end": 117.802,
    "duration": 6.2
  },
  {
    "id": 21,
    "text": "语言融汇民间白话口语与文人雅化笔法，生动传神。",
    "start": 118.302,
    "end": 122.559,
    "duration": 4.257
  },
  {
    "id": 22,
    "text": "在长篇结构上，也逐步由《三国志演义》《水浒传》式的线性串联，",
    "start": 123.059,
    "end": 127.971,
    "duration": 4.912
  },
  {
    "id": 23,
    "text": "发展为《红楼梦》式的网状交叉布局，显示出中国古代长篇叙事艺术的持续深化。",
    "start": 128.361,
    "end": 134.934,
    "duration": 6.573
  }
]
