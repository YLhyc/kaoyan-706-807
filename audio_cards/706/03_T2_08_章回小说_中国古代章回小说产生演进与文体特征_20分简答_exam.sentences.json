[
  {
    "id": 1,
    "text": "简述中国古代章回小说的产生演进历程与文体特征。",
    "start": 0.11,
    "end": 4.666,
    "duration": 4.556
  },
  {
    "id": 2,
    "text": "章回小说是中国古代长篇小说的主要体制，",
    "start": 4.927,
    "end": 8.135,
    "duration": 3.208
  },
  {
    "id": 3,
    "text": "孕育于宋元讲史等说话伎艺，在明代趋于定型并走向繁荣。",
    "start": 8.413,
    "end": 13.444,
    "duration": 5.031
  },
  {
    "id": 4,
    "text": "其产生演进历程与文体特征，主要体现在以下三个方面：",
    "start": 13.764,
    "end": 18.197,
    "duration": 4.433
  },
  {
    "id": 5,
    "text": "第一，脱胎于宋元说话讲史传统，由民间编创演进为文人独创。",
    "start": 18.889,
    "end": 24.496,
    "duration": 5.607
  },
  {
    "id": 6,
    "text": "章回小说源于宋元瓦舍中的“说话”伎艺，尤其是长篇分节讲说历代兴废战争的“讲史”话本。",
    "start": 24.912,
    "end": 32.589,
    "duration": 7.677
  },
  {
    "id": 7,
    "text": "艺人为吸引听众连续听讲，逐渐演化出分回标目与回末设悬的讲述技巧。",
    "start": 32.986,
    "end": 39.523,
    "duration": 6.537
  },
  {
    "id": 8,
    "text": "元末明初，文人在民间话本基础上加工写定《三国志通俗演义》与《水浒传》，",
    "start": 39.782,
    "end": 45.879,
    "duration": 6.097
  },
  {
    "id": 9,
    "text": "标志着章回小说的正式确立；",
    "start": 46.352,
    "end": 48.361,
    "duration": 2.009
  },
  {
    "id": 10,
    "text": "明代中叶《金瓶梅》问世，开启了文人独立创作长篇世情小说的阶段；",
    "start": 48.842,
    "end": 54.257,
    "duration": 5.415
  },
  {
    "id": 11,
    "text": "至清代《儒林外史》与《红楼梦》，章回小说达到艺术成熟的高峰。",
    "start": 54.765,
    "end": 59.496,
    "duration": 4.731
  },
  {
    "id": 12,
    "text": "第二，确立分回标目与回末设悬念的独特叙事体制。",
    "start": 60.154,
    "end": 64.773,
    "duration": 4.619
  },
  {
    "id": 13,
    "text": "章回小说以“回”为基本叙事单元，每回相对独立而又首尾勾连，构成统一整体。",
    "start": 65.094,
    "end": 71.205,
    "duration": 6.111
  },
  {
    "id": 14,
    "text": "每回之首冠以回目，经历了由宋元平话长短参差、嘉靖本《三国志通俗演义》单句七字目，",
    "start": 71.424,
    "end": 78.843,
    "duration": 7.419
  },
  {
    "id": 15,
    "text": "到万历本《水浒传》双句大致对偶，",
    "start": 79.114,
    "end": 81.61,
    "duration": 2.496
  },
  {
    "id": 16,
    "text": "再到崇祯本《金瓶梅》双句工整对偶的定型过程，起到提纲挈领之效。",
    "start": 82.029,
    "end": 87.373,
    "duration": 5.344
  },
  {
    "id": 17,
    "text": "每回之末保留说话人惯例，在情节紧要处以“欲知后事如何，且听下回分解”煞尾，",
    "start": 87.743,
    "end": 94.962,
    "duration": 7.219
  },
  {
    "id": 18,
    "text": "既维系了读者期待，又串接起长篇结构的连贯脉络。",
    "start": 95.223,
    "end": 99.426,
    "duration": 4.203
  },
  {
    "id": 19,
    "text": "第三，沿用说话人口吻、韵散结合与不断精进的结构布局。",
    "start": 100.051,
    "end": 104.999,
    "duration": 4.948
  },
  {
    "id": 20,
    "text": "章回小说普遍模拟“说话人”讲故事的腔调统摄全篇，",
    "start": 105.535,
    "end": 109.676,
    "duration": 4.141
  },
  {
    "id": 21,
    "text": "正文常以“话说”“且说”发端，行文中兼插诗词曲赋以描摹场景、评赞人物；",
    "start": 110.11,
    "end": 116.31,
    "duration": 6.2
  },
  {
    "id": 22,
    "text": "语言融汇民间白话口语与文人雅化笔法，生动传神。",
    "start": 116.716,
    "end": 120.973,
    "duration": 4.257
  },
  {
    "id": 23,
    "text": "在长篇结构上，也逐步由《三国志演义》《水浒传》式的线性串联，",
    "start": 121.261,
    "end": 126.173,
    "duration": 4.912
  },
  {
    "id": 24,
    "text": "发展为《红楼梦》式的网状交叉布局，显示出中国古代长篇叙事艺术的持续深化。",
    "start": 126.563,
    "end": 133.136,
    "duration": 6.573
  }
]