[
  {
    "id": 1,
    "text": "《红楼梦》是中国古代长篇白话小说的最高峰，",
    "start": 0.0,
    "end": 3.956,
    "duration": 3.956
  },
  {
    "id": 2,
    "text": "更是一部伟大的悲剧史诗。",
    "start": 3.956,
    "end": 6.373,
    "duration": 2.417
  },
  {
    "id": 3,
    "text": "王国维在《红楼梦评论》中开创了现代悲剧美学批评的先河。",
    "start": 6.373,
    "end": 11.648,
    "duration": 5.275
  },
  {
    "id": 4,
    "text": "他指出其悲剧并非由恶人作祟，而是由通常之道德、",
    "start": 11.648,
    "end": 16.263,
    "duration": 4.615
  },
  {
    "id": 5,
    "text": "通常之人情、通常之境遇所造成。",
    "start": 16.263,
    "end": 19.12,
    "duration": 2.857
  },
  {
    "id": 6,
    "text": "袁行配《中国文学史》指出，《红楼梦》彻底打破了中国古代戏曲小说大团圆的陈腐套路。",
    "start": 19.28,
    "end": 26.16,
    "duration": 6.88
  },
  {
    "id": 7,
    "text": "它从社会、家族、女性与哲学存在等多重层面，",
    "start": 26.16,
    "end": 30.32,
    "duration": 4.16
  },
  {
    "id": 8,
    "text": "展现出无处不在的悲剧力量。",
    "start": 30.32,
    "end": 32.72,
    "duration": 2.4
  },
  {
    "id": 9,
    "text": "其深刻的悲剧意蕴，主要展现在以下四个核心维度：宝黛爱情悲剧是全书的核心抒情脉络，",
    "start": 32.72,
    "end": 40.56,
    "duration": 7.84
  },
  {
    "id": 10,
    "text": "其实质是个性自由与封建正统宗法的激烈冲突。",
    "start": 40.56,
    "end": 44.8,
    "duration": 4.24
  },
  {
    "id": 11,
    "text": "贾宝玉与林黛玉建立在灵魂相通的知己基础上，",
    "start": 44.8,
    "end": 48.56,
    "duration": 3.76
  },
  {
    "id": 12,
    "text": "二人共同唾弃仕途经济与功名利禄。",
    "start": 48.56,
    "end": 51.68,
    "duration": 3.12
  },
  {
    "id": 13,
    "text": "然而贾府统治者出于家族政治利益与封建秩序维护，",
    "start": 51.68,
    "end": 56.16,
    "duration": 4.48
  },
  {
    "id": 14,
    "text": "强行炮制“金玉良缘”。",
    "start": 56.16,
    "end": 57.84,
    "duration": 1.68
  },
  {
    "id": 15,
    "text": "薛宝钗作为正统礼教妇德与仕途经济的化身，",
    "start": 58.16,
    "end": 61.68,
    "duration": 3.52
  },
  {
    "id": 16,
    "text": "被封建家长选定为理想的家族继承者配偶。",
    "start": 61.68,
    "end": 65.2,
    "duration": 3.52
  },
  {
    "id": 17,
    "text": "全书的高潮是黛玉焚稿断痴情与宝玉调包迎娶宝钗在同一时刻发生。",
    "start": 65.2,
    "end": 71.52,
    "duration": 6.32
  },
  {
    "id": 18,
    "text": "曹雪芹以剧烈的戏剧反差，无情粉碎了纯真美好的青春爱情理想。",
    "start": 71.52,
    "end": 76.56,
    "duration": 5.04
  },
  {
    "id": 19,
    "text": "这一悲剧宣告了带有近代启蒙色彩的自由个性，",
    "start": 76.8,
    "end": 80.88,
    "duration": 4.08
  },
  {
    "id": 20,
    "text": "在封建宗法铁幕下必然毁灭的历史宿命。",
    "start": 80.88,
    "end": 84.48,
    "duration": 3.6
  },
  {
    "id": 21,
    "text": "《红楼梦》以贾府四大家族为缩影，",
    "start": 84.48,
    "end": 87.36,
    "duration": 2.88
  },
  {
    "id": 22,
    "text": "深刻展示了中国封建社会走向末世的必然解体。",
    "start": 87.36,
    "end": 91.44,
    "duration": 4.08
  },
  {
    "id": 23,
    "text": "贾府在经济上入不敷出、坐吃山空，",
    "start": 91.44,
    "end": 94.48,
    "duration": 3.04
  },
  {
    "id": 24,
    "text": "主仆上下日渐安富尊荣、荒淫腐朽。",
    "start": 94.48,
    "end": 97.6,
    "duration": 3.12
  },
  {
    "id": 25,
    "text": "在政治上结党营私、权势衰退，最终落入被抄没夺爵的万劫不复之境。",
    "start": 97.92,
    "end": 104.48,
    "duration": 6.56
  },
  {
    "id": 26,
    "text": "探春理家试图兴利除弊，但终究无法挽救颓势，",
    "start": 104.48,
    "end": 108.8,
    "duration": 4.32
  },
  {
    "id": 27,
    "text": "发出令人警醒的深刻叹息。",
    "start": 108.8,
    "end": 111.2,
    "duration": 2.4
  },
  {
    "id": 28,
    "text": "她指出这样的大族人家，若从外头杀来一时是杀不死的，",
    "start": 111.2,
    "end": 115.76,
    "duration": 4.56
  },
  {
    "id": 29,
    "text": "必须先从家里自杀自灭起来。",
    "start": 115.76,
    "end": 117.92,
    "duration": 2.16
  },
  {
    "id": 30,
    "text": "作者通过生动的家族盛衰流变，深刻揭露了封建贵族制度内在不可调和的死结。",
    "start": 118.16,
    "end": 124.64,
    "duration": 6.48
  },
  {
    "id": 31,
    "text": "这一家族悲剧绝非偶然运势所致，而是整个封建宗法体制走向历史坟墓的宏大缩影。",
    "start": 124.64,
    "end": 131.84,
    "duration": 7.2
  },
  {
    "id": 32,
    "text": "《红楼梦》是一部为天下规阁被侮辱与被损害女性所立的泣血挽歌。",
    "start": 131.84,
    "end": 137.04,
    "duration": 5.2
  },
  {
    "id": 33,
    "text": "警幻仙子太虚幻境中仙茶名为“千红一窟”，",
    "start": 137.36,
    "end": 141.68,
    "duration": 4.32
  },
  {
    "id": 34,
    "text": "仙酒名为“万艳同杯”，点明了全体女性的命运底色。",
    "start": 141.68,
    "end": 146.0,
    "duration": 4.32
  },
  {
    "id": 35,
    "text": "无论是地位尊贵的贵族小姐，还是才智出众的当家媳妇，",
    "start": 146.288,
    "end": 150.688,
    "duration": 4.4
  },
  {
    "id": 36,
    "text": "皆逃不脱毁灭的归宿。",
    "start": 150.688,
    "end": 152.768,
    "duration": 2.08
  },
  {
    "id": 37,
    "text": "元春幽闭深宫如入牢狱，迎春误嫁中山狼被折磨至死，",
    "start": 152.768,
    "end": 157.808,
    "duration": 5.04
  },
  {
    "id": 38,
    "text": "探春远嫁荒服骨肉分离。",
    "start": 157.808,
    "end": 160.608,
    "duration": 2.8
  },
  {
    "id": 39,
    "text": "聪明绝顶如王熙凤，落得机关算尽反误了卿卿性命。",
    "start": 160.608,
    "end": 165.248,
    "duration": 4.64
  },
  {
    "id": 40,
    "text": "处于最底层的婢女更是命运凄惨，晴雯受缠夭折，",
    "start": 165.248,
    "end": 169.808,
    "duration": 4.56
  },
  {
    "id": 41,
    "text": "金钏蒙羞投井，司棋决绝殉情。",
    "start": 169.808,
    "end": 172.528,
    "duration": 2.72
  },
  {
    "id": 42,
    "text": "曹雪芹以博大悲敏的笔触，将一切美好灵秀的女性生命被践踏撕碎的过程展现于世，",
    "start": 172.848,
    "end": 180.048,
    "duration": 7.2
  },
  {
    "id": 43,
    "text": "展现出震撼人心的人道主义悲情。",
    "start": 180.048,
    "end": 182.928,
    "duration": 2.88
  },
  {
    "id": 44,
    "text": "《红楼梦》超越了世俗社会的政治批判，",
    "start": 182.928,
    "end": 185.728,
    "duration": 2.8
  },
  {
    "id": 45,
    "text": "上升到对人生存在本质与生存意义的哲学省思。",
    "start": 185.728,
    "end": 190.368,
    "duration": 4.64
  },
  {
    "id": 46,
    "text": "石头由无稽崖青埂峰下历经人间富贵繁华，",
    "start": 190.368,
    "end": 194.448,
    "duration": 4.08
  },
  {
    "id": 47,
    "text": "最终收束于“白茫茫大地真干净”的荒寒空无。",
    "start": 194.448,
    "end": 198.368,
    "duration": 3.92
  },
  {
    "id": 48,
    "text": "贾宝玉的核心人格是“情不情”，即对世间一切灵秀生命怀抱最深沉的真情与依恋。",
    "start": 198.688,
    "end": 206.368,
    "duration": 7.68
  },
  {
    "id": 49,
    "text": "然而他越是深情执着，目睹生命消逝与美的幻灭时，",
    "start": 206.368,
    "end": 210.848,
    "duration": 4.48
  },
  {
    "id": 50,
    "text": "内心的荒谬与虚无感便越是刻骨铭心。",
    "start": 210.848,
    "end": 214.288,
    "duration": 3.44
  },
  {
    "id": 51,
    "text": "最终贾宝玉悬崖撒手、遁入空门，不仅是对封建宗法家族的决绝背弃，",
    "start": 214.288,
    "end": 220.208,
    "duration": 5.92
  },
  {
    "id": 52,
    "text": "更是对人生虚妄的无可奈何的超越。",
    "start": 220.208,
    "end": 223.088,
    "duration": 2.88
  },
  {
    "id": 53,
    "text": "这种看破一切皆空却又深情难舍的精神悖论，",
    "start": 223.328,
    "end": 227.408,
    "duration": 4.08
  },
  {
    "id": 54,
    "text": "达到了中国文学前所未有的哲学悲剧深度。",
    "start": 227.408,
    "end": 231.568,
    "duration": 4.16
  },
  {
    "id": 55,
    "text": "综上所述，《红楼梦》将历史真实、",
    "start": 231.568,
    "end": 234.608,
    "duration": 3.04
  },
  {
    "id": 56,
    "text": "人文悲敏与存在哲学熔铸于一炉。",
    "start": 234.608,
    "end": 238.128,
    "duration": 3.52
  },
  {
    "id": 57,
    "text": "鲁迅在《中国小说的历史的变迁》中精辟总结为“悲凉之雾，",
    "start": 238.128,
    "end": 242.928,
    "duration": 4.8
  },
  {
    "id": 58,
    "text": "遍被华林”。",
    "start": 242.928,
    "end": 243.808,
    "duration": 0.88
  },
  {
    "id": 59,
    "text": "它不仅彻底颠覆了传统古典文学的大团圆思维定势，",
    "start": 244.128,
    "end": 248.288,
    "duration": 4.16
  },
  {
    "id": 60,
    "text": "更开创了中国古代悲剧文学的至高境地。",
    "start": 248.288,
    "end": 251.408,
    "duration": 3.12
  },
  {
    "id": 61,
    "text": "这一多维复合的悲剧意蕴，成为中国古典文学留给现代人类精神世界最丰厚的艺术宝藏。",
    "start": 251.408,
    "end": 258.048,
    "duration": 6.64
  }
]