[
  {
    "id": 1,
    "text": "《红楼梦》是中国古代长篇白话小说的最高峰，",
    "start": 0.0,
    "end": 3.956,
    "duration": 3.956
  },
  {
    "id": 2,
    "text": "更是一部伟大的悲剧史诗。",
    "start": 3.956,
    "end": 6.373,
    "duration": 2.417
  },
  {
    "id": 3,
    "text": "王国维在《红楼梦评论》中开创了现代悲剧美学批评的先河。",
    "start": 6.373,
    "end": 11.648,
    "duration": 5.275
  },
  {
    "id": 4,
    "text": "他指出其悲剧并非由恶人作祟，而是由通常之道德、",
    "start": 11.648,
    "end": 16.263,
    "duration": 4.615
  },
  {
    "id": 5,
    "text": "通常之人情、通常之境遇所造成。",
    "start": 16.263,
    "end": 19.12,
    "duration": 2.857
  },
  {
    "id": 6,
    "text": "袁行配《中国文学史》指出，《红楼梦》彻底打破了中国古代戏曲小说大团圆的陈腐套路。",
    "start": 19.28,
    "end": 25.84,
    "duration": 6.56
  },
  {
    "id": 7,
    "text": "它从社会、家族、女性与哲学存在等多重层面，",
    "start": 25.84,
    "end": 30.0,
    "duration": 4.16
  },
  {
    "id": 8,
    "text": "展现出无处不在的悲剧力量。",
    "start": 30.0,
    "end": 32.4,
    "duration": 2.4
  },
  {
    "id": 9,
    "text": "其深刻的悲剧意蕴，主要展现在以下四个核心维度：宝黛爱情悲剧是全书的核心抒情脉络，",
    "start": 32.4,
    "end": 40.24,
    "duration": 7.84
  },
  {
    "id": 10,
    "text": "其实质是个性自由与封建正统宗法的激烈冲突。",
    "start": 40.24,
    "end": 44.8,
    "duration": 4.56
  },
  {
    "id": 11,
    "text": "贾宝玉与林黛玉建立在灵魂相通的知己基础上，",
    "start": 44.8,
    "end": 48.96,
    "duration": 4.16
  },
  {
    "id": 12,
    "text": "二人共同唾弃仕途经济与功名利禄。",
    "start": 48.96,
    "end": 52.24,
    "duration": 3.28
  },
  {
    "id": 13,
    "text": "然而贾府统治者出于家族政治利益与封建秩序维护，",
    "start": 52.24,
    "end": 56.72,
    "duration": 4.48
  },
  {
    "id": 14,
    "text": "强行炮制“金玉良缘”。",
    "start": 56.72,
    "end": 58.56,
    "duration": 1.84
  },
  {
    "id": 15,
    "text": "薛宝钗作为正统礼教妇德与仕途经济的化身，",
    "start": 58.96,
    "end": 62.48,
    "duration": 3.52
  },
  {
    "id": 16,
    "text": "被封建家长选定为理想的家族继承者配偶。",
    "start": 62.48,
    "end": 66.0,
    "duration": 3.52
  },
  {
    "id": 17,
    "text": "全书的高潮是黛玉焚稿断痴情与宝玉调包迎娶宝钗在同一时刻发生。",
    "start": 66.0,
    "end": 72.32,
    "duration": 6.32
  },
  {
    "id": 18,
    "text": "曹雪芹以剧烈的戏剧反差，无情粉碎了纯真美好的青春爱情理想。",
    "start": 72.32,
    "end": 77.36,
    "duration": 5.04
  },
  {
    "id": 19,
    "text": "这一悲剧宣告了带有近代启蒙色彩的自由个性，",
    "start": 77.6,
    "end": 81.68,
    "duration": 4.08
  },
  {
    "id": 20,
    "text": "在封建宗法铁幕下必然毁灭的历史宿命。",
    "start": 81.68,
    "end": 85.28,
    "duration": 3.6
  },
  {
    "id": 21,
    "text": "《红楼梦》以贾府四大家族为缩影，",
    "start": 85.28,
    "end": 88.16,
    "duration": 2.88
  },
  {
    "id": 22,
    "text": "深刻展示了中国封建社会走向末世的必然解体。",
    "start": 88.16,
    "end": 92.24,
    "duration": 4.08
  },
  {
    "id": 23,
    "text": "贾府在经济上入不敷出、坐吃山空，",
    "start": 92.24,
    "end": 95.28,
    "duration": 3.04
  },
  {
    "id": 24,
    "text": "主仆上下日渐安富尊荣、荒淫腐朽。",
    "start": 95.28,
    "end": 98.4,
    "duration": 3.12
  },
  {
    "id": 25,
    "text": "在政治上结党营私、权势衰退，最终落入被抄没夺爵的万劫不复之境。",
    "start": 98.72,
    "end": 105.28,
    "duration": 6.56
  },
  {
    "id": 26,
    "text": "探春理家试图兴利除弊，但终究无法挽救颓势，",
    "start": 105.28,
    "end": 109.6,
    "duration": 4.32
  },
  {
    "id": 27,
    "text": "发出令人警醒的深刻叹息。",
    "start": 109.6,
    "end": 112.0,
    "duration": 2.4
  },
  {
    "id": 28,
    "text": "她指出这样的大族人家，若从外头杀来一时是杀不死的，",
    "start": 112.0,
    "end": 116.56,
    "duration": 4.56
  },
  {
    "id": 29,
    "text": "必须先从家里自杀自灭起来。",
    "start": 116.56,
    "end": 118.72,
    "duration": 2.16
  },
  {
    "id": 30,
    "text": "作者通过生动的家族盛衰流变，深刻揭露了封建贵族制度内在不可调和的死结。",
    "start": 118.96,
    "end": 125.44,
    "duration": 6.48
  },
  {
    "id": 31,
    "text": "这一家族悲剧绝非偶然运势所致，而是整个封建宗法体制走向历史坟墓的宏大缩影。",
    "start": 125.44,
    "end": 132.64,
    "duration": 7.2
  },
  {
    "id": 32,
    "text": "《红楼梦》是一部为天下规阁被侮辱与被损害女性所立的泣血挽歌。",
    "start": 132.64,
    "end": 137.84,
    "duration": 5.2
  },
  {
    "id": 33,
    "text": "警幻仙子太虚幻境中仙茶名为“千红一窟”，",
    "start": 138.16,
    "end": 142.48,
    "duration": 4.32
  },
  {
    "id": 34,
    "text": "仙酒名为“万艳同杯”，点明了全体女性的命运底色。",
    "start": 142.48,
    "end": 146.8,
    "duration": 4.32
  },
  {
    "id": 35,
    "text": "无论是地位尊贵的贵族小姐，还是才智出众的当家媳妇，",
    "start": 147.104,
    "end": 151.504,
    "duration": 4.4
  },
  {
    "id": 36,
    "text": "皆逃不脱毁灭的归宿。",
    "start": 151.504,
    "end": 153.584,
    "duration": 2.08
  },
  {
    "id": 37,
    "text": "元春幽闭深宫如入牢狱，迎春误嫁中山狼被折磨至死，",
    "start": 153.584,
    "end": 158.624,
    "duration": 5.04
  },
  {
    "id": 38,
    "text": "探春远嫁荒服骨肉分离。",
    "start": 158.624,
    "end": 161.424,
    "duration": 2.8
  },
  {
    "id": 39,
    "text": "聪明绝顶如王熙凤，落得机关算尽反误了卿卿性命。",
    "start": 161.424,
    "end": 166.064,
    "duration": 4.64
  },
  {
    "id": 40,
    "text": "处于最底层的婢女更是命运凄惨，晴雯受缠夭折，",
    "start": 166.064,
    "end": 170.624,
    "duration": 4.56
  },
  {
    "id": 41,
    "text": "金钏蒙羞投井，司棋决绝殉情。",
    "start": 170.624,
    "end": 173.344,
    "duration": 2.72
  },
  {
    "id": 42,
    "text": "曹雪芹以博大悲敏的笔触，将一切美好灵秀的女性生命被践踏撕碎的过程展现于世，",
    "start": 173.664,
    "end": 181.264,
    "duration": 7.6
  },
  {
    "id": 43,
    "text": "展现出震撼人心的人道主义悲情。",
    "start": 181.264,
    "end": 184.144,
    "duration": 2.88
  },
  {
    "id": 44,
    "text": "《红楼梦》超越了世俗社会的政治批判，",
    "start": 184.144,
    "end": 187.264,
    "duration": 3.12
  },
  {
    "id": 45,
    "text": "上升到对人生存在本质与终极价值的哲学省思。",
    "start": 187.264,
    "end": 191.744,
    "duration": 4.48
  },
  {
    "id": 46,
    "text": "石头由无稽崖青埂峰下历经人间富贵繁华，",
    "start": 191.744,
    "end": 196.064,
    "duration": 4.32
  },
  {
    "id": 47,
    "text": "最终收束于“白茫茫大地真干净”的荒寒空无。",
    "start": 196.064,
    "end": 199.904,
    "duration": 3.84
  },
  {
    "id": 48,
    "text": "贾宝玉的核心人格是“情不情”，即对世间一切灵秀生命怀抱最深沉的真情与依恋。",
    "start": 200.144,
    "end": 207.824,
    "duration": 7.68
  },
  {
    "id": 49,
    "text": "然而他越是深情执着，目睹生命消逝与美的幻灭时，",
    "start": 207.824,
    "end": 212.304,
    "duration": 4.48
  },
  {
    "id": 50,
    "text": "内心的荒谬与虚无感便越是刻骨铭心。",
    "start": 212.304,
    "end": 215.744,
    "duration": 3.44
  },
  {
    "id": 51,
    "text": "最终贾宝玉悬崖撒手、遁入空门，不仅是对封建宗法家族的决绝背弃，",
    "start": 215.744,
    "end": 221.664,
    "duration": 5.92
  },
  {
    "id": 52,
    "text": "更是对人生虚妄的无可奈何的超越。",
    "start": 221.664,
    "end": 224.544,
    "duration": 2.88
  },
  {
    "id": 53,
    "text": "这种看破一切皆空却又深情难舍的精神悖论，",
    "start": 224.784,
    "end": 228.864,
    "duration": 4.08
  },
  {
    "id": 54,
    "text": "达到了中国文学前所未有的哲学悲剧深度。",
    "start": 228.864,
    "end": 233.024,
    "duration": 4.16
  },
  {
    "id": 55,
    "text": "综上所述，《红楼梦》将历史真实、",
    "start": 233.024,
    "end": 236.064,
    "duration": 3.04
  },
  {
    "id": 56,
    "text": "人文悲敏与存在哲学熔铸于一炉。",
    "start": 236.064,
    "end": 239.584,
    "duration": 3.52
  },
  {
    "id": 57,
    "text": "鲁迅在《中国小说的历史的变迁》中精辟总结为“悲凉之雾，",
    "start": 239.584,
    "end": 244.384,
    "duration": 4.8
  },
  {
    "id": 58,
    "text": "遍被华林”。",
    "start": 244.384,
    "end": 245.264,
    "duration": 0.88
  },
  {
    "id": 59,
    "text": "它不仅彻底颠覆了传统古典文学的大团圆思维定势，",
    "start": 245.584,
    "end": 249.744,
    "duration": 4.16
  },
  {
    "id": 60,
    "text": "更开创了中国古代悲剧文学的至高境地。",
    "start": 249.744,
    "end": 253.184,
    "duration": 3.44
  },
  {
    "id": 61,
    "text": "这一多维复合的悲剧意蕴，成为中国古典文学留给现代人类精神世界最丰厚的艺术宝藏。--",
    "start": 253.184,
    "end": 260.144,
    "duration": 6.96
  }
]