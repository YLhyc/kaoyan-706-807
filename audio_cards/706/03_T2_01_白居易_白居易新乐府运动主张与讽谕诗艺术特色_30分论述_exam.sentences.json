[
  {
    "id": "sent_1",
    "text": "白居易是中唐新乐府运动的理论倡导者与卓越领袖。",
    "start": 0.0,
    "end": 4.48,
    "duration": 4.48
  },
  {
    "id": "sent_2",
    "text": "面对安史之乱后藩镇割据加剧、",
    "start": 4.929,
    "end": 7.569,
    "duration": 2.64
  },
  {
    "id": "sent_3",
    "text": "土地兼并严重与宦官弄权的社会危机，",
    "start": 8.019,
    "end": 10.979,
    "duration": 2.96
  },
  {
    "id": "sent_4",
    "text": "白居易上承 《诗经》 六义与杜甫即事名篇的现实主义传统，",
    "start": 11.429,
    "end": 15.829,
    "duration": 4.4
  },
  {
    "id": "sent_5",
    "text": "发起了中国文学史上最具自觉批判精神的诗歌革新运动。",
    "start": 16.279,
    "end": 20.879,
    "duration": 4.6
  },
  {
    "id": "sent_6",
    "text": "他主张恢复诗歌讽谕教化的政治功能，使文学成为干预现实、",
    "start": 21.329,
    "end": 26.209,
    "duration": 4.88
  },
  {
    "id": "sent_7",
    "text": "救济生民的强大思想武器。",
    "start": 26.659,
    "end": 28.779,
    "duration": 2.12
  },
  {
    "id": "sent_8",
    "text": "其新乐府理论主张与讽谕诗艺术特色，",
    "start": 29.229,
    "end": 32.469,
    "duration": 3.24
  },
  {
    "id": "sent_9",
    "text": "主要展现为以下四个核心维度：",
    "start": 32.919,
    "end": 35.439,
    "duration": 2.52
  },
  {
    "id": "sent_10",
    "text": "第一，系统确立“文章合为时而著，",
    "start": 35.889,
    "end": 38.569,
    "duration": 2.68
  },
  {
    "id": "sent_11",
    "text": "歌诗合为事而作”的现实主义诗学纲领。",
    "start": 39.019,
    "end": 42.059,
    "duration": 3.04
  },
  {
    "id": "sent_12",
    "text": "在著名的 《与元九书》 中，白居易全面阐释了其文学主张。",
    "start": 42.509,
    "end": 46.869,
    "duration": 4.36
  },
  {
    "id": "sent_13",
    "text": "他将诗歌与时代政治紧密相连，明确提出 “文章合为时而著，",
    "start": 47.319,
    "end": 52.199,
    "duration": 4.88
  },
  {
    "id": "sent_14",
    "text": "歌诗合为事而作”。",
    "start": 52.649,
    "end": 54.129,
    "duration": 1.48
  },
  {
    "id": "sent_15",
    "text": "白居易追溯诗歌源头，提出诗歌 “根情，苗言，华声，",
    "start": 54.659,
    "end": 59.179,
    "duration": 4.52
  },
  {
    "id": "sent_16",
    "text": "实义” 的有机整体观，强调诗歌的本质在于“实义”，",
    "start": 59.629,
    "end": 63.509,
    "duration": 3.88
  },
  {
    "id": "sent_17",
    "text": "即必须具备严肃的思想内容与社会功用；",
    "start": 63.959,
    "end": 67.119,
    "duration": 3.16
  },
  {
    "id": "sent_18",
    "text": "他极力提倡诗歌应当起到 “补察时政，",
    "start": 67.569,
    "end": 70.609,
    "duration": 3.04
  },
  {
    "id": "sent_19",
    "text": "泄导人情” 的批判讽谕作用。",
    "start": 71.059,
    "end": 73.219,
    "duration": 2.16
  },
  {
    "id": "sent_20",
    "text": "这一诗学纲领彻底扭转了齐梁余风与大历以来沉溺于吟咏风月、",
    "start": 73.669,
    "end": 78.869,
    "duration": 5.2
  },
  {
    "id": "sent_21",
    "text": "逃避现实的狭窄诗风，将文学引向直面国计民生的阔大正途。",
    "start": 79.319,
    "end": 84.519,
    "duration": 5.2
  },
  {
    "id": "sent_22",
    "text": "第二，确立“即事名篇，无复依傍”的创作原则，",
    "start": 84.969,
    "end": 88.489,
    "duration": 3.52
  },
  {
    "id": "sent_23",
    "text": "全面直面社会黑暗现实。",
    "start": 88.939,
    "end": 91.139,
    "duration": 2.2
  },
  {
    "id": "sent_24",
    "text": "在具体创作上，白居易与元稹倡导摆脱汉魏乐府古题的陈旧束缚，",
    "start": 91.589,
    "end": 96.869,
    "duration": 5.28
  },
  {
    "id": "sent_25",
    "text": "确立了 “新乐府” 这一全新范式。",
    "start": 97.319,
    "end": 99.759,
    "duration": 2.44
  },
  {
    "id": "sent_26",
    "text": "白居易所创作的 《新乐府》 五十首与 《秦中吟》 十首，",
    "start": 100.209,
    "end": 103.929,
    "duration": 3.72
  },
  {
    "id": "sent_27",
    "text": "严格恪守“因事立题，题称其事”的原则，",
    "start": 104.379,
    "end": 107.659,
    "duration": 3.28
  },
  {
    "id": "sent_28",
    "text": "取材全取自元和年间的当代社会矛盾。",
    "start": 108.109,
    "end": 111.229,
    "duration": 3.12
  },
  {
    "id": "sent_29",
    "text": "在代表作 《卖炭翁》 中，",
    "start": 111.679,
    "end": 113.519,
    "duration": 1.84
  },
  {
    "id": "sent_30",
    "text": "作者以 “心忧炭贱愿天寒” 极写底层劳动人民生存处境的艰难矛盾，",
    "start": 113.969,
    "end": 119.169,
    "duration": 5.2
  },
  {
    "id": "sent_31",
    "text": "以 “一车炭，千余斤，",
    "start": 119.619,
    "end": 121.339,
    "duration": 1.72
  },
  {
    "id": "sent_32",
    "text": "宫使驱将惜不得” 深刻揭露宫市掠夺的蛮横霸道；",
    "start": 121.789,
    "end": 125.629,
    "duration": 3.84
  },
  {
    "id": "sent_33",
    "text": "在 《观刈麦》 中，借妇儿提筐拾穗的凄凉细节，",
    "start": 126.079,
    "end": 129.719,
    "duration": 3.64
  },
  {
    "id": "sent_34",
    "text": "反思自身 “念此私自愧，尽日不能忘” 的士大夫愧怍之情。",
    "start": 130.169,
    "end": 135.049,
    "duration": 4.88
  },
  {
    "id": "sent_35",
    "text": "第三，实践“其辞质而径，其事核而实”的白描手法与平易诗风。",
    "start": 135.499,
    "end": 140.859,
    "duration": 5.36
  },
  {
    "id": "sent_36",
    "text": "为了达到让“天下之人受其赐”的社会传播目的，",
    "start": 141.309,
    "end": 144.789,
    "duration": 3.48
  },
  {
    "id": "sent_37",
    "text": "白居易在艺术形式上力求平易通俗。",
    "start": 145.239,
    "end": 148.159,
    "duration": 2.92
  },
  {
    "id": "sent_38",
    "text": "他明确要求讽谕诗必须做到 “其辞质而径，其事核而实，",
    "start": 148.609,
    "end": 153.209,
    "duration": 4.6
  },
  {
    "id": "sent_39",
    "text": "其体顺而肆，其音顺而哀”。",
    "start": 153.659,
    "end": 156.259,
    "duration": 2.6
  },
  {
    "id": "sent_40",
    "text": "在语言上，他坚持通俗明畅、少用生僻典故，",
    "start": 156.709,
    "end": 160.669,
    "duration": 3.96
  },
  {
    "id": "sent_41",
    "text": "甚至追求“老妪能解”的大众化审美；",
    "start": 161.119,
    "end": 163.799,
    "duration": 2.68
  },
  {
    "id": "sent_42",
    "text": "在表现技巧上，他善用白描手法与对比映衬，",
    "start": 164.249,
    "end": 167.929,
    "duration": 3.68
  },
  {
    "id": "sent_43",
    "text": "如 《轻肥》 中一边是贪官权贵 “樽罍溢九酝，",
    "start": 168.379,
    "end": 171.819,
    "duration": 3.44
  },
  {
    "id": "sent_44",
    "text": "水陆罗八珍” 的极度奢靡，",
    "start": 172.269,
    "end": 174.469,
    "duration": 2.2
  },
  {
    "id": "sent_45",
    "text": "一边是江南 “人吃人” 的赤地千里，两相对照，",
    "start": 174.919,
    "end": 178.199,
    "duration": 3.28
  },
  {
    "id": "sent_46",
    "text": "展现出震人心魄的批判力量。",
    "start": 178.648,
    "end": 180.928,
    "duration": 2.28
  },
  {
    "id": "sent_47",
    "text": "第四，以讽谕诗重构诗歌品类格局，",
    "start": 181.378,
    "end": 184.578,
    "duration": 3.2
  },
  {
    "id": "sent_48",
    "text": "确立中唐现实主义诗歌的高峰地位。",
    "start": 185.108,
    "end": 187.908,
    "duration": 2.8
  },
  {
    "id": "sent_49",
    "text": "白居易自编诗集，将自身诗歌划分为 “讽谕”、“闲适”、",
    "start": 188.358,
    "end": 192.638,
    "duration": 4.28
  },
  {
    "id": "sent_50",
    "text": "“感伤”、“杂律” 四大品类，并明确以讽谕诗居于首位。",
    "start": 193.168,
    "end": 197.208,
    "duration": 4.04
  },
  {
    "id": "sent_51",
    "text": "这种文体观念的重构，不仅彰显出其以济世为怀的崇高政治抱负，",
    "start": 197.658,
    "end": 202.858,
    "duration": 5.2
  },
  {
    "id": "sent_52",
    "text": "更直接启迪了元稹、张籍、王建等新乐府诗人的群体创作。",
    "start": 203.308,
    "end": 208.268,
    "duration": 4.96
  },
  {
    "id": "sent_53",
    "text": "白居易的讽谕诗以卓越的社会责任感与独特的平民化语言，",
    "start": 208.718,
    "end": 213.438,
    "duration": 4.72
  },
  {
    "id": "sent_54",
    "text": "构建起唐代现实主义诗歌传统中又一座承前启后的崇高丰碑。",
    "start": 213.888,
    "end": 219.168,
    "duration": 5.28
  }
]