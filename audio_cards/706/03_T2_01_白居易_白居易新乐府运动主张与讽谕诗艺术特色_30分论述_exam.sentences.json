[
  {
    "id": 1,
    "text": "试论白居易的新乐府运动主张与讽谕诗艺术特色。",
    "start": 0.079,
    "end": 3.747,
    "duration": 3.668
  },
  {
    "id": 2,
    "text": "白居易是中唐新乐府运动的理论倡导者与卓越领袖。",
    "start": 4.278,
    "end": 8.161,
    "duration": 3.883
  },
  {
    "id": 3,
    "text": "面对安史之乱后藩镇割据加剧、",
    "start": 8.495,
    "end": 11.002,
    "duration": 2.507
  },
  {
    "id": 4,
    "text": "土地兼并严重与宦官弄权的社会危机，",
    "start": 11.152,
    "end": 14.117,
    "duration": 2.965
  },
  {
    "id": 5,
    "text": "白居易上承 《诗经》 六义与杜甫即事名篇的现实主义传统，",
    "start": 14.583,
    "end": 18.7,
    "duration": 4.117
  },
  {
    "id": 6,
    "text": "发起了中国文学史上最具自觉批判精神的诗歌革新运动。",
    "start": 19.163,
    "end": 23.585,
    "duration": 4.422
  },
  {
    "id": 7,
    "text": "他主张恢复诗歌讽谕教化的政治功能，使文学成为干预现实、",
    "start": 23.773,
    "end": 28.658,
    "duration": 4.885
  },
  {
    "id": 8,
    "text": "救济生民的强大思想武器。",
    "start": 28.874,
    "end": 30.892,
    "duration": 2.018
  },
  {
    "id": 9,
    "text": "其新乐府理论主张与讽谕诗艺术特色，",
    "start": 31.449,
    "end": 34.447,
    "duration": 2.998
  },
  {
    "id": 10,
    "text": "主要展现为以下四个核心维度：",
    "start": 34.54,
    "end": 36.856,
    "duration": 2.316
  },
  {
    "id": 11,
    "text": "第一，系统确立“文章合为时而著，",
    "start": 37.261,
    "end": 40.163,
    "duration": 2.902
  },
  {
    "id": 12,
    "text": "歌诗合为事而作”的现实主义诗学纲领。",
    "start": 40.448,
    "end": 43.515,
    "duration": 3.067
  },
  {
    "id": 13,
    "text": "在著名的 《与元九书》 中，白居易全面阐释了其文学主张。",
    "start": 43.788,
    "end": 48.428,
    "duration": 4.64
  },
  {
    "id": 14,
    "text": "他将诗歌与时代政治紧密相连，明确提出 “文章合为时而著，",
    "start": 48.685,
    "end": 53.705,
    "duration": 5.02
  },
  {
    "id": 15,
    "text": "歌诗合为事而作”。",
    "start": 53.821,
    "end": 55.219,
    "duration": 1.398
  },
  {
    "id": 16,
    "text": "白居易追溯诗歌源头，提出诗歌 “根情，苗言，华声，",
    "start": 55.458,
    "end": 60.326,
    "duration": 4.868
  },
  {
    "id": 17,
    "text": "实义” 的有机整体观，强调诗歌的本质在于“实义”，",
    "start": 60.389,
    "end": 64.23,
    "duration": 3.841
  },
  {
    "id": 18,
    "text": "即必须具备严肃的思想内容与社会功用；",
    "start": 64.407,
    "end": 67.613,
    "duration": 3.206
  },
  {
    "id": 19,
    "text": "他极力提倡诗歌应当起到 “补察时政，",
    "start": 67.867,
    "end": 71.307,
    "duration": 3.44
  },
  {
    "id": 20,
    "text": "泄导人情” 的批判讽谕作用。",
    "start": 71.539,
    "end": 73.672,
    "duration": 2.133
  },
  {
    "id": 21,
    "text": "这一诗学纲领彻底扭转了齐梁余风与大历以来沉溺于吟咏风月、",
    "start": 73.964,
    "end": 79.599,
    "duration": 5.635
  },
  {
    "id": 22,
    "text": "逃避现实的狭窄诗风，将文学引向直面国计民生的阔大正途。",
    "start": 79.701,
    "end": 86.004,
    "duration": 6.303
  },
  {
    "id": 23,
    "text": "第二，确立“即事名篇，无复依傍”的创作原则，",
    "start": 86.632,
    "end": 89.969,
    "duration": 3.337
  },
  {
    "id": 24,
    "text": "全面直面社会黑暗现实。",
    "start": 90.265,
    "end": 92.387,
    "duration": 2.122
  },
  {
    "id": 25,
    "text": "在具体创作上，",
    "start": 92.589,
    "end": 93.743,
    "duration": 1.154
  },
  {
    "id": 26,
    "text": "白居易与元稹倡导摆脱汉魏乐府古题的陈旧束缚，",
    "start": 94.016,
    "end": 98.508,
    "duration": 4.492
  },
  {
    "id": 27,
    "text": "确立了 “新乐府” 这一全新范式。",
    "start": 98.532,
    "end": 100.87,
    "duration": 2.338
  },
  {
    "id": 28,
    "text": "白居易所创作的 《新乐府》 五十首与 《秦中吟》 十首，",
    "start": 100.891,
    "end": 104.437,
    "duration": 3.546
  },
  {
    "id": 29,
    "text": "严格恪守“因事立题，题称其事”的原则，",
    "start": 104.534,
    "end": 107.656,
    "duration": 3.122
  },
  {
    "id": 30,
    "text": "取材全取自元和年间的当代社会矛盾。",
    "start": 107.715,
    "end": 110.72,
    "duration": 3.005
  },
  {
    "id": 31,
    "text": "在代表作 《卖炭翁》 中，",
    "start": 110.989,
    "end": 112.88,
    "duration": 1.891
  },
  {
    "id": 32,
    "text": "作者以 “心忧炭贱愿天寒” 极写底层劳动人民生存处境的艰难矛盾，",
    "start": 113.075,
    "end": 118.876,
    "duration": 5.801
  },
  {
    "id": 33,
    "text": "以 “一车炭，千余斤，",
    "start": 119.257,
    "end": 121.083,
    "duration": 1.826
  },
  {
    "id": 34,
    "text": "宫使驱将惜不得” 深刻揭露宫市掠夺的蛮横霸道；",
    "start": 121.33,
    "end": 125.701,
    "duration": 4.371
  },
  {
    "id": 35,
    "text": "在 《观刈麦》 中，借妇儿提筐拾穗的凄凉细节，",
    "start": 125.807,
    "end": 129.734,
    "duration": 3.927
  },
  {
    "id": 36,
    "text": "反思自身 “念此私自愧，尽日不能忘” 的士大夫愧怍之情。",
    "start": 130.043,
    "end": 135.983,
    "duration": 5.94
  },
  {
    "id": 37,
    "text": "第三，实践“其辞质而径，其事核而实”的白描手法与平易诗风。",
    "start": 136.419,
    "end": 142.148,
    "duration": 5.729
  },
  {
    "id": 38,
    "text": "为了达到让“天下之人受其赐”的社会传播目的，",
    "start": 142.396,
    "end": 145.869,
    "duration": 3.473
  },
  {
    "id": 39,
    "text": "白居易在艺术形式上力求平易通俗。",
    "start": 146.132,
    "end": 148.962,
    "duration": 2.83
  },
  {
    "id": 40,
    "text": "他明确要求讽谕诗必须做到 “其辞质而径，其事核而实，",
    "start": 149.163,
    "end": 154.203,
    "duration": 5.04
  },
  {
    "id": 41,
    "text": "其体顺而肆，其音顺而哀”。",
    "start": 154.416,
    "end": 156.885,
    "duration": 2.469
  },
  {
    "id": 42,
    "text": "在语言上，他坚持通俗明畅、少用生僻典故，",
    "start": 157.133,
    "end": 160.757,
    "duration": 3.624
  },
  {
    "id": 43,
    "text": "甚至追求“老妪能解”的大众化审美；在表现技巧上，",
    "start": 161.034,
    "end": 165.198,
    "duration": 4.164
  },
  {
    "id": 44,
    "text": "他善用白描手法与对比映衬，",
    "start": 165.412,
    "end": 167.97,
    "duration": 2.558
  },
  {
    "id": 45,
    "text": "如 《轻肥》 中一边是贪官权贵 “樽罍溢九酝，",
    "start": 168.278,
    "end": 172.07,
    "duration": 3.792
  },
  {
    "id": 46,
    "text": "水陆罗八珍” 的极度奢靡，",
    "start": 172.274,
    "end": 174.321,
    "duration": 2.047
  },
  {
    "id": 47,
    "text": "一边是江南 “人吃人” 的赤地千里，两相对照，",
    "start": 174.637,
    "end": 178.461,
    "duration": 3.824
  },
  {
    "id": 48,
    "text": "展现出震人心魄的批判力量。",
    "start": 178.698,
    "end": 181.124,
    "duration": 2.426
  },
  {
    "id": 49,
    "text": "第四，以讽谕诗重构诗歌品类格局，",
    "start": 181.393,
    "end": 184.761,
    "duration": 3.368
  },
  {
    "id": 50,
    "text": "确立中唐现实主义诗歌的高峰地位。",
    "start": 185.114,
    "end": 187.686,
    "duration": 2.572
  },
  {
    "id": 51,
    "text": "白居易自编诗集，将自身诗歌划分为 “讽谕”、“闲适”、",
    "start": 187.912,
    "end": 192.967,
    "duration": 5.055
  },
  {
    "id": 52,
    "text": "“感伤”、“杂律” 四大品类，并明确以讽谕诗居于首位。",
    "start": 193.145,
    "end": 197.747,
    "duration": 4.602
  },
  {
    "id": 53,
    "text": "这种文体观念的重构，",
    "start": 198.221,
    "end": 199.661,
    "duration": 1.44
  },
  {
    "id": 54,
    "text": "不仅彰显出其以济世为怀的崇高政治抱负，更直接启迪了元稹、",
    "start": 199.888,
    "end": 205.633,
    "duration": 5.745
  },
  {
    "id": 55,
    "text": "张籍、王建等新乐府诗人的群体创作。",
    "start": 205.74,
    "end": 208.992,
    "duration": 3.252
  },
  {
    "id": 56,
    "text": "白居易的讽谕诗以卓越的社会责任感与独特的平民化语言，",
    "start": 209.193,
    "end": 213.717,
    "duration": 4.524
  },
  {
    "id": 57,
    "text": "构建起唐代现实主义诗歌传统中又一座承前启后的崇高丰碑。",
    "start": 213.855,
    "end": 218.664,
    "duration": 4.809
  }
]
