[
  {
    "id": 1,
    "text": "试论白居易的新乐府运动主张与讽谕诗艺术特色。",
    "start": 0.134,
    "end": 4.106,
    "duration": 3.972
  },
  {
    "id": 2,
    "text": "白居易是中唐新乐府运动的理论倡导者与卓越领袖。",
    "start": 4.783,
    "end": 9.075,
    "duration": 4.292
  },
  {
    "id": 3,
    "text": "面对安史之乱后藩镇割据、赋敛苛重与宦官专权的社会危机，",
    "start": 9.793,
    "end": 14.525,
    "duration": 4.732
  },
  {
    "id": 4,
    "text": "白居易上承《诗经》风雅比兴与杜甫即事名篇的现实主义传统，发起了自觉的诗歌革新运动。",
    "start": 14.904,
    "end": 21.716,
    "duration": 6.812
  },
  {
    "id": 5,
    "text": "他力主恢复诗歌美刺讽谕的政教功能，使诗歌成为针砭时弊、反映民生疾苦的有力武器。",
    "start": 22.354,
    "end": 29.406,
    "duration": 7.052
  },
  {
    "id": 6,
    "text": "其新乐府理论主张与讽谕诗艺术特色，主要体现在以下四个方面：",
    "start": 30.084,
    "end": 40.576,
    "duration": 10.492
  },
  {
    "id": 7,
    "text": "第一，确立“文章合为时而著，歌诗合为事而作”的现实主义诗学纲领。",
    "start": 41.254,
    "end": 45.626,
    "duration": 4.372
  },
  {
    "id": 8,
    "text": "在著名的《与元九书》中，白居易系统阐述了其诗学主张。",
    "start": 46.344,
    "end": 61.521,
    "duration": 15.177
  },
  {
    "id": 9,
    "text": "他把诗歌创作与时代政治紧密联系，",
    "start": 62.214,
    "end": 65.626,
    "duration": 3.412
  },
  {
    "id": 10,
    "text": "明确提出“文章合为时而著，歌诗合为事而作”的创作纲领，并提出诗歌“根情，苗言，华声，实义”的有机观，",
    "start": 66.005,
    "end": 71.377,
    "duration": 5.372
  },
  {
    "id": 11,
    "text": "强调诗的根本功用在于“补察时政，泄导人情”。",
    "start": 71.756,
    "end": 74.848,
    "duration": 3.092
  },
  {
    "id": 12,
    "text": "这一主张直接承接儒家诗教与杜甫写实道路，",
    "start": 75.526,
    "end": 77.378,
    "duration": 1.852
  },
  {
    "id": 13,
    "text": "有力扭转了齐梁余风及大历诗坛偏重吟咏风月、流连清雅的倾向，",
    "start": 77.757,
    "end": 79.249,
    "duration": 1.492
  },
  {
    "id": 14,
    "text": "将诗歌重新引向直面国计民生的正途。",
    "start": 79.628,
    "end": 81.04,
    "duration": 1.412
  },
  {
    "id": 15,
    "text": "第二，践行“即事名篇，无复依傍”的创作原则，尖锐揭露社会矛盾。",
    "start": 81.718,
    "end": 87.89,
    "duration": 6.172
  },
  {
    "id": 16,
    "text": "在创作实践上，白居易与元稹倡导摆脱汉魏乐府古题的旧壳，创立“新乐府”体式。",
    "start": 88.568,
    "end": 97.78,
    "duration": 9.212
  },
  {
    "id": 17,
    "text": "白居易所作《新乐府》五十首与《秦中吟》十首，大多一篇专咏一事，",
    "start": 98.458,
    "end": 103.23,
    "duration": 4.772
  },
  {
    "id": 18,
    "text": "“首句标其目，卒章显其志”，直接取材于元和年间的现实矛盾。",
    "start": 103.609,
    "end": 108.341,
    "duration": 4.732
  },
  {
    "id": 19,
    "text": "在《卖炭翁》中，以“心忧炭贱愿天寒”细摹老人艰难矛盾的心理，",
    "start": 109.019,
    "end": 112.111,
    "duration": 3.092
  },
  {
    "id": 20,
    "text": "以“一车炭，千余斤，宫使驱将惜不得”揭露宫市掠夺的横暴；",
    "start": 112.49,
    "end": 113.942,
    "duration": 1.452
  },
  {
    "id": 21,
    "text": "在《观刈麦》中，借贫妇拾穗的凄凉细节，发为“念此私自愧，尽日不能忘”的深刻自省，流露出深切的同情。",
    "start": 114.471,
    "end": 117.763,
    "duration": 3.292
  },
  {
    "id": 22,
    "text": "第三，遵循“其辞质而径，其言直而切”的标准，形成平易通俗的诗风。",
    "start": 118.387,
    "end": 123.959,
    "duration": 5.572
  },
  {
    "id": 23,
    "text": "为了使民情上达天听、教化广泛流传，",
    "start": 124.488,
    "end": 127.54,
    "duration": 3.052
  },
  {
    "id": 24,
    "text": "白居易在《新乐府序》中提出了明确的标准：",
    "start": 127.919,
    "end": 133.331,
    "duration": 5.412
  },
  {
    "id": 25,
    "text": "“其辞质而径，欲见之者易谕也；",
    "start": 134.009,
    "end": 134.981,
    "duration": 0.972
  },
  {
    "id": 26,
    "text": "其言直而切，欲闻之者深诫也；",
    "start": 135.51,
    "end": 135.722,
    "duration": 0.212
  },
  {
    "id": 27,
    "text": "其事核而实，使采之者传信也；",
    "start": 136.251,
    "end": 136.733,
    "duration": 0.482
  },
  {
    "id": 28,
    "text": "其体顺而肆，可以播于乐章歌曲也。”",
    "start": 137.262,
    "end": 137.864,
    "duration": 0.602
  },
  {
    "id": 29,
    "text": "他坚持语言浅显明畅、多用日常口语，",
    "start": 138.502,
    "end": 139.474,
    "duration": 0.972
  },
  {
    "id": 30,
    "text": "避免艰深用典，并善用白描与对比映衬手法。",
    "start": 139.853,
    "end": 141.265,
    "duration": 1.412
  },
  {
    "id": 31,
    "text": "如《轻肥》中，一边写内臣大夫“樽罍溢九酝，水陆罗八珍”的骄奢宴乐，",
    "start": 141.903,
    "end": 142.915,
    "duration": 1.012
  },
  {
    "id": 32,
    "text": "一边冷峻点出“是岁江南旱，衢州人食人”，形成震撼人心的强烈对照。",
    "start": 143.294,
    "end": 144.786,
    "duration": 1.492
  },
  {
    "id": 33,
    "text": "第四，以讽谕诗重塑诗歌品类格局，巩固中唐现实主义诗潮。",
    "start": 145.464,
    "end": 151.556,
    "duration": 6.092
  },
  {
    "id": 34,
    "text": "白居易自编诗集，将平生诗作划分为“讽谕”“闲适”“感伤”“杂律”四类，并把体现兼济之志的讽谕诗置诸首位。",
    "start": 152.194,
    "end": 163.366,
    "duration": 11.172
  },
  {
    "id": 35,
    "text": "这一分类凸显了其“惟歌生民病，愿得天子知”的社会抱负，",
    "start": 164.044,
    "end": 166.296,
    "duration": 2.252
  },
  {
    "id": 36,
    "text": "虽有时因过于偏重讽谏说教而稍损含蓄，却直接推动了元稹、张籍、王建等新乐府诗人的群体创作，",
    "start": 166.675,
    "end": 168.887,
    "duration": 2.212
  },
  {
    "id": 37,
    "text": "在中唐诗坛掀起了波澜壮阔的写实诗潮。",
    "start": 169.266,
    "end": 169.948,
    "duration": 0.682
  },
  {
    "id": 38,
    "text": "综上所述，白居易在中唐社会危机之中积极推行新乐府诗歌革新，",
    "start": 170.666,
    "end": 174.878,
    "duration": 4.212
  },
  {
    "id": 39,
    "text": "以“文章合为时而著，歌诗合为事而作”为纲领，借通俗明畅的叙事笔法直击民生疾苦。",
    "start": 175.257,
    "end": 179.909,
    "duration": 4.652
  },
  {
    "id": 40,
    "text": "虽然部分讽谕诗因刻意说教而略显直露，但其自觉发扬杜甫即事名篇的精神并带动元稹、张籍等诗人呼应，",
    "start": 180.587,
    "end": 206.722,
    "duration": 26.135
  },
  {
    "id": 41,
    "text": "在中唐诗坛重新高扬起关心世事的现实主义传统。",
    "start": 207.268,
    "end": 223.568,
    "duration": 16.3
  }
]