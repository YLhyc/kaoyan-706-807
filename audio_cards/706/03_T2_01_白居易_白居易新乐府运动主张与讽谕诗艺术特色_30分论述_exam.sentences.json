[
  {
    "id": 1,
    "text": "试论白居易的新乐府运动主张与讽谕诗艺术特色。",
    "start": 0.05,
    "end": 4.289,
    "duration": 4.239
  },
  {
    "id": 2,
    "text": "白居易是中唐新乐府运动的理论倡导者与卓越领袖。",
    "start": 4.289,
    "end": 9.935,
    "duration": 5.646
  },
  {
    "id": 3,
    "text": "面对安史之乱后藩镇割据加剧、",
    "start": 9.935,
    "end": 12.425,
    "duration": 2.49
  },
  {
    "id": 4,
    "text": "土地兼并严重与宦官弄权的社会危机，",
    "start": 12.425,
    "end": 16.217,
    "duration": 3.792
  },
  {
    "id": 5,
    "text": "白居易上承 《诗经》 六义与杜甫即事名篇的现实主义传统，",
    "start": 16.217,
    "end": 20.766,
    "duration": 4.549
  },
  {
    "id": 6,
    "text": "发起了中国文学史上最具自觉批判精神的诗歌革新运动。",
    "start": 20.766,
    "end": 26.817,
    "duration": 6.051
  },
  {
    "id": 7,
    "text": "他主张恢复诗歌讽谕教化的政治功能，使文学成为干预现实、",
    "start": 26.817,
    "end": 31.464,
    "duration": 4.647
  },
  {
    "id": 8,
    "text": "救济生民的强大思想武器。",
    "start": 31.464,
    "end": 34.761,
    "duration": 3.297
  },
  {
    "id": 9,
    "text": "其新乐府理论主张与讽谕诗艺术特色，",
    "start": 34.761,
    "end": 37.859,
    "duration": 3.098
  },
  {
    "id": 10,
    "text": "主要展现为以下四个核心维度：",
    "start": 37.859,
    "end": 40.459,
    "duration": 2.6
  },
  {
    "id": 11,
    "text": "第一，系统确立“文章合为时而著，",
    "start": 40.459,
    "end": 43.798,
    "duration": 3.339
  },
  {
    "id": 12,
    "text": "歌诗合为事而作”的现实主义诗学纲领。",
    "start": 43.798,
    "end": 48.695,
    "duration": 4.897
  },
  {
    "id": 13,
    "text": "在著名的 《与元九书》 中，白居易全面阐释了其文学主张。",
    "start": 48.695,
    "end": 53.831,
    "duration": 5.136
  },
  {
    "id": 14,
    "text": "他将诗歌与时代政治紧密相连，明确提出 “文章合为时而著，",
    "start": 53.831,
    "end": 58.264,
    "duration": 4.433
  },
  {
    "id": 15,
    "text": "歌诗合为事而作”。",
    "start": 58.264,
    "end": 59.805,
    "duration": 1.541
  },
  {
    "id": 16,
    "text": "白居易追溯诗歌源头，提出诗歌 “根情，苗言，华声，",
    "start": 59.805,
    "end": 63.495,
    "duration": 3.69
  },
  {
    "id": 17,
    "text": "实义” 的有机整体观，强调诗歌的本质在于“实义”，",
    "start": 63.495,
    "end": 67.877,
    "duration": 4.382
  },
  {
    "id": 18,
    "text": "即必须具备严肃的思想内容与社会功用；",
    "start": 67.877,
    "end": 71.551,
    "duration": 3.674
  },
  {
    "id": 19,
    "text": "他极力提倡诗歌应当起到 “补察时政，",
    "start": 71.551,
    "end": 75.148,
    "duration": 3.597
  },
  {
    "id": 20,
    "text": "泄导人情” 的批判讽谕作用。",
    "start": 75.148,
    "end": 78.129,
    "duration": 2.981
  },
  {
    "id": 21,
    "text": "这一诗学纲领彻底扭转了齐梁余风与大历以来沉溺于吟咏风月、",
    "start": 78.129,
    "end": 83.479,
    "duration": 5.35
  },
  {
    "id": 22,
    "text": "逃避现实的狭窄诗风，将文学引向直面国计民生的阔大正途。",
    "start": 83.479,
    "end": 88.401,
    "duration": 4.922
  },
  {
    "id": 23,
    "text": "第二，确立“即事名篇，无复依傍”的创作原则，",
    "start": 88.401,
    "end": 92.599,
    "duration": 4.198
  },
  {
    "id": 24,
    "text": "全面直面社会黑暗现实。",
    "start": 92.599,
    "end": 95.378,
    "duration": 2.779
  },
  {
    "id": 25,
    "text": "在具体创作上，",
    "start": 95.378,
    "end": 96.729,
    "duration": 1.351
  },
  {
    "id": 26,
    "text": "白居易与元稹倡导摆脱汉魏乐府古题的陈旧束缚，",
    "start": 96.729,
    "end": 101.283,
    "duration": 4.554
  },
  {
    "id": 27,
    "text": "确立了 “新乐府” 这一全新范式。",
    "start": 101.283,
    "end": 104.544,
    "duration": 3.261
  },
  {
    "id": 28,
    "text": "白居易所创作的 《新乐府》 五十首与 《秦中吟》 十首，",
    "start": 104.544,
    "end": 108.322,
    "duration": 3.778
  },
  {
    "id": 29,
    "text": "严格恪守“因事立题，题称其事”的原则，",
    "start": 108.322,
    "end": 112.023,
    "duration": 3.701
  },
  {
    "id": 30,
    "text": "取材全取自元和年间的当代社会矛盾。",
    "start": 112.023,
    "end": 115.709,
    "duration": 3.686
  },
  {
    "id": 31,
    "text": "在代表作 《卖炭翁》 中，",
    "start": 115.709,
    "end": 117.224,
    "duration": 1.515
  },
  {
    "id": 32,
    "text": "作者以 “心忧炭贱愿天寒” 极写底层劳动人民生存处境的艰难矛盾，",
    "start": 117.224,
    "end": 123.0,
    "duration": 5.776
  },
  {
    "id": 33,
    "text": "以 “一车炭，千余斤，",
    "start": 123.0,
    "end": 124.677,
    "duration": 1.677
  },
  {
    "id": 34,
    "text": "宫使驱将惜不得” 深刻揭露宫市掠夺的蛮横霸道；",
    "start": 124.677,
    "end": 130.056,
    "duration": 5.379
  },
  {
    "id": 35,
    "text": "在 《观刈麦》 中，借妇儿提筐拾穗的凄凉细节，",
    "start": 130.056,
    "end": 133.819,
    "duration": 3.763
  },
  {
    "id": 36,
    "text": "反思自身 “念此私自愧，尽日不能忘” 的士大夫愧怍之情。",
    "start": 133.819,
    "end": 138.684,
    "duration": 4.865
  },
  {
    "id": 37,
    "text": "第三，实践“其辞质而径，其事核而实”的白描手法与平易诗风。",
    "start": 138.684,
    "end": 143.101,
    "duration": 4.417
  },
  {
    "id": 38,
    "text": "为了达到让“天下之人受其赐”的社会传播目的，",
    "start": 143.101,
    "end": 147.242,
    "duration": 4.141
  },
  {
    "id": 39,
    "text": "白居易在艺术形式上力求平易通俗。",
    "start": 147.242,
    "end": 150.943,
    "duration": 3.701
  },
  {
    "id": 40,
    "text": "他明确要求讽谕诗必须做到 “其辞质而径，其事核而实，",
    "start": 150.943,
    "end": 155.682,
    "duration": 4.739
  },
  {
    "id": 41,
    "text": "其体顺而肆，其音顺而哀”。",
    "start": 155.682,
    "end": 158.0,
    "duration": 2.318
  },
  {
    "id": 42,
    "text": "在语言上，他坚持通俗明畅、少用生僻典故，",
    "start": 158.0,
    "end": 161.733,
    "duration": 3.733
  },
  {
    "id": 43,
    "text": "甚至追求“老妪能解”的大众化审美；在表现技巧上，",
    "start": 161.733,
    "end": 165.422,
    "duration": 3.689
  },
  {
    "id": 44,
    "text": "他善用白描手法与对比映衬，",
    "start": 165.422,
    "end": 169.224,
    "duration": 3.802
  },
  {
    "id": 45,
    "text": "如 《轻肥》 中一边是贪官权贵 “樽罍溢九酝，",
    "start": 169.224,
    "end": 172.292,
    "duration": 3.068
  },
  {
    "id": 46,
    "text": "水陆罗八珍” 的极度奢靡，",
    "start": 172.292,
    "end": 174.648,
    "duration": 2.356
  },
  {
    "id": 47,
    "text": "一边是江南 “人吃人” 的赤地千里，两相对照，",
    "start": 174.648,
    "end": 178.711,
    "duration": 4.063
  },
  {
    "id": 48,
    "text": "展现出震人心魄的批判力量。",
    "start": 178.711,
    "end": 181.403,
    "duration": 2.692
  },
  {
    "id": 49,
    "text": "第四，以讽谕诗重构诗歌品类格局，",
    "start": 181.403,
    "end": 185.125,
    "duration": 3.722
  },
  {
    "id": 50,
    "text": "确立中唐现实主义诗歌的高峰地位。",
    "start": 185.125,
    "end": 187.924,
    "duration": 2.799
  },
  {
    "id": 51,
    "text": "白居易自编诗集，将自身诗歌划分为 “讽谕”、“闲适”、",
    "start": 187.924,
    "end": 192.304,
    "duration": 4.38
  },
  {
    "id": 52,
    "text": "“感伤”、“杂律” 四大品类，并明确以讽谕诗居于首位。",
    "start": 192.304,
    "end": 196.306,
    "duration": 4.002
  },
  {
    "id": 53,
    "text": "这种文体观念的重构，",
    "start": 196.306,
    "end": 198.232,
    "duration": 1.926
  },
  {
    "id": 54,
    "text": "不仅彰显出其以济世为怀的崇高政治抱负，更直接启迪了元稹、",
    "start": 198.232,
    "end": 203.836,
    "duration": 5.604
  },
  {
    "id": 55,
    "text": "张籍、王建等新乐府诗人的群体创作。",
    "start": 203.836,
    "end": 209.203,
    "duration": 5.367
  },
  {
    "id": 56,
    "text": "白居易的讽谕诗以卓越的社会责任感与独特的平民化语言，",
    "start": 209.203,
    "end": 213.868,
    "duration": 4.665
  },
  {
    "id": 57,
    "text": "构建起唐代现实主义诗歌传统中又一座承前启后的崇高丰碑。",
    "start": 213.868,
    "end": 218.664,
    "duration": 4.796
  }
]