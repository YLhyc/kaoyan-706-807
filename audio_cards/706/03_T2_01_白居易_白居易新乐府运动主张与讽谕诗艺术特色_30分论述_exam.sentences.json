[
  {
    "id": 1,
    "text": "试论白居易的新乐府运动主张与讽谕诗艺术特色。",
    "start": 0.0,
    "end": 4.318,
    "duration": 4.318
  },
  {
    "id": 2,
    "text": "白居易是中唐新乐府运动的理论倡导者与卓越领袖。",
    "start": 4.318,
    "end": 8.535,
    "duration": 4.217
  },
  {
    "id": 3,
    "text": "面对安史之乱后藩镇割据加剧、",
    "start": 8.535,
    "end": 11.192,
    "duration": 2.657
  },
  {
    "id": 4,
    "text": "土地兼并严重与宦官弄权的社会危机，",
    "start": 11.192,
    "end": 14.623,
    "duration": 3.431
  },
  {
    "id": 5,
    "text": "白居易上承 《诗经》 六义与杜甫即事名篇的现实主义传统，",
    "start": 14.623,
    "end": 19.203,
    "duration": 4.58
  },
  {
    "id": 6,
    "text": "发起了中国文学史上最具自觉批判精神的诗歌革新运动。",
    "start": 19.203,
    "end": 23.813,
    "duration": 4.61
  },
  {
    "id": 7,
    "text": "他主张恢复诗歌讽谕教化的政治功能，使文学成为干预现实、",
    "start": 23.813,
    "end": 28.915,
    "duration": 5.102
  },
  {
    "id": 8,
    "text": "救济生民的强大思想武器。",
    "start": 28.915,
    "end": 31.489,
    "duration": 2.574
  },
  {
    "id": 9,
    "text": "其新乐府理论主张与讽谕诗艺术特色，",
    "start": 31.489,
    "end": 37.301,
    "duration": 5.812
  },
  {
    "id": 10,
    "text": "主要展现为以下四个核心维度：",
    "start": 37.301,
    "end": 40.489,
    "duration": 3.188
  },
  {
    "id": 11,
    "text": "第一，系统确立“文章合为时而著，",
    "start": 40.489,
    "end": 43.828,
    "duration": 3.339
  },
  {
    "id": 12,
    "text": "歌诗合为事而作”的现实主义诗学纲领。",
    "start": 43.828,
    "end": 46.108,
    "duration": 2.28
  },
  {
    "id": 13,
    "text": "在著名的 《与元九书》 中，白居易全面阐释了其文学主张。",
    "start": 46.108,
    "end": 52.271,
    "duration": 6.163
  },
  {
    "id": 14,
    "text": "他将诗歌与时代政治紧密相连，明确提出 “文章合为时而著，",
    "start": 52.271,
    "end": 58.294,
    "duration": 6.023
  },
  {
    "id": 15,
    "text": "歌诗合为事而作”。",
    "start": 58.294,
    "end": 59.789,
    "duration": 1.495
  },
  {
    "id": 16,
    "text": "白居易追溯诗歌源头，提出诗歌 “根情，苗言，华声，",
    "start": 59.789,
    "end": 64.448,
    "duration": 4.659
  },
  {
    "id": 17,
    "text": "实义” 的有机整体观，强调诗歌的本质在于“实义”，",
    "start": 64.448,
    "end": 69.477,
    "duration": 5.029
  },
  {
    "id": 18,
    "text": "即必须具备严肃的思想内容与社会功用；",
    "start": 69.477,
    "end": 74.004,
    "duration": 4.527
  },
  {
    "id": 19,
    "text": "他极力提倡诗歌应当起到 “补察时政，",
    "start": 74.004,
    "end": 77.109,
    "duration": 3.105
  },
  {
    "id": 20,
    "text": "泄导人情” 的批判讽谕作用。",
    "start": 77.109,
    "end": 79.741,
    "duration": 2.632
  },
  {
    "id": 21,
    "text": "这一诗学纲领彻底扭转了齐梁余风与大历以来沉溺于吟咏风月、",
    "start": 79.741,
    "end": 85.711,
    "duration": 5.97
  },
  {
    "id": 22,
    "text": "逃避现实的狭窄诗风，将文学引向直面国计民生的阔大正途。",
    "start": 85.711,
    "end": 88.431,
    "duration": 2.72
  },
  {
    "id": 23,
    "text": "第二，确立“即事名篇，无复依傍”的创作原则，",
    "start": 88.431,
    "end": 90.305,
    "duration": 1.874
  },
  {
    "id": 24,
    "text": "全面直面社会黑暗现实。",
    "start": 90.305,
    "end": 92.629,
    "duration": 2.324
  },
  {
    "id": 25,
    "text": "在具体创作上，",
    "start": 92.629,
    "end": 94.056,
    "duration": 1.427
  },
  {
    "id": 26,
    "text": "白居易与元稹倡导摆脱汉魏乐府古题的陈旧束缚，",
    "start": 94.056,
    "end": 111.029,
    "duration": 16.973
  },
  {
    "id": 27,
    "text": "确立了 “新乐府” 这一全新范式。",
    "start": 111.029,
    "end": 112.053,
    "duration": 1.024
  },
  {
    "id": 28,
    "text": "白居易所创作的 《新乐府》 五十首与 《秦中吟》 十首，",
    "start": 112.053,
    "end": 113.878,
    "duration": 1.825
  },
  {
    "id": 29,
    "text": "严格恪守“因事立题，题称其事”的原则，",
    "start": 113.878,
    "end": 119.298,
    "duration": 5.42
  },
  {
    "id": 30,
    "text": "取材全取自元和年间的当代社会矛盾。",
    "start": 119.298,
    "end": 123.026,
    "duration": 3.728
  },
  {
    "id": 31,
    "text": "在代表作 《卖炭翁》 中，",
    "start": 123.026,
    "end": 125.849,
    "duration": 2.823
  },
  {
    "id": 32,
    "text": "作者以 “心忧炭贱愿天寒” 极写底层劳动人民生存处境的艰难矛盾，",
    "start": 125.849,
    "end": 133.846,
    "duration": 7.997
  },
  {
    "id": 33,
    "text": "以 “一车炭，千余斤，",
    "start": 133.846,
    "end": 136.461,
    "duration": 2.615
  },
  {
    "id": 34,
    "text": "宫使驱将惜不得” 深刻揭露宫市掠夺的蛮横霸道；",
    "start": 136.461,
    "end": 142.437,
    "duration": 5.976
  },
  {
    "id": 35,
    "text": "在 《观刈麦》 中，借妇儿提筐拾穗的凄凉细节，",
    "start": 142.437,
    "end": 146.172,
    "duration": 3.735
  },
  {
    "id": 36,
    "text": "反思自身 “念此私自愧，尽日不能忘” 的士大夫愧怍之情。",
    "start": 146.172,
    "end": 150.973,
    "duration": 4.801
  },
  {
    "id": 37,
    "text": "第三，实践“其辞质而径，其事核而实”的白描手法与平易诗风。",
    "start": 150.973,
    "end": 158.03,
    "duration": 7.057
  },
  {
    "id": 38,
    "text": "为了达到让“天下之人受其赐”的社会传播目的，",
    "start": 158.03,
    "end": 164.046,
    "duration": 6.016
  },
  {
    "id": 39,
    "text": "白居易在艺术形式上力求平易通俗。",
    "start": 164.046,
    "end": 167.076,
    "duration": 3.03
  },
  {
    "id": 40,
    "text": "他明确要求讽谕诗必须做到 “其辞质而径，其事核而实，",
    "start": 167.076,
    "end": 172.314,
    "duration": 5.238
  },
  {
    "id": 41,
    "text": "其体顺而肆，其音顺而哀”。",
    "start": 172.314,
    "end": 174.677,
    "duration": 2.363
  },
  {
    "id": 42,
    "text": "在语言上，他坚持通俗明畅、少用生僻典故，",
    "start": 174.677,
    "end": 178.74,
    "duration": 4.063
  },
  {
    "id": 43,
    "text": "甚至追求“老妪能解”的大众化审美；在表现技巧上，",
    "start": 178.74,
    "end": 185.154,
    "duration": 6.414
  },
  {
    "id": 44,
    "text": "他善用白描手法与对比映衬，",
    "start": 185.154,
    "end": 187.952,
    "duration": 2.798
  },
  {
    "id": 45,
    "text": "如 《轻肥》 中一边是贪官权贵 “樽罍溢九酝，",
    "start": 187.952,
    "end": 191.469,
    "duration": 3.517
  },
  {
    "id": 46,
    "text": "水陆罗八珍” 的极度奢靡，",
    "start": 191.469,
    "end": 193.185,
    "duration": 1.716
  },
  {
    "id": 47,
    "text": "一边是江南 “人吃人” 的赤地千里，两相对照，",
    "start": 193.185,
    "end": 198.261,
    "duration": 5.076
  },
  {
    "id": 48,
    "text": "展现出震人心魄的批判力量。",
    "start": 198.261,
    "end": 199.928,
    "duration": 1.667
  },
  {
    "id": 49,
    "text": "第四，以讽谕诗重构诗歌品类格局，",
    "start": 199.928,
    "end": 201.039,
    "duration": 1.111
  },
  {
    "id": 50,
    "text": "确立中唐现实主义诗歌的高峰地位。",
    "start": 201.039,
    "end": 203.866,
    "duration": 2.827
  },
  {
    "id": 51,
    "text": "白居易自编诗集，将自身诗歌划分为 “讽谕”、“闲适”、",
    "start": 203.866,
    "end": 205.134,
    "duration": 1.268
  },
  {
    "id": 52,
    "text": "“感伤”、“杂律” 四大品类，并明确以讽谕诗居于首位。",
    "start": 205.134,
    "end": 205.78,
    "duration": 0.646
  },
  {
    "id": 53,
    "text": "这种文体观念的重构，",
    "start": 205.78,
    "end": 206.472,
    "duration": 0.692
  },
  {
    "id": 54,
    "text": "不仅彰显出其以济世为怀的崇高政治抱负，更直接启迪了元稹、",
    "start": 206.472,
    "end": 209.233,
    "duration": 2.761
  },
  {
    "id": 55,
    "text": "张籍、王建等新乐府诗人的群体创作。",
    "start": 209.233,
    "end": 210.517,
    "duration": 1.284
  },
  {
    "id": 56,
    "text": "白居易的讽谕诗以卓越的社会责任感与独特的平民化语言，",
    "start": 210.517,
    "end": 213.898,
    "duration": 3.381
  },
  {
    "id": 57,
    "text": "构建起唐代现实主义诗歌传统中又一座承前启后的崇高丰碑。",
    "start": 213.898,
    "end": 218.461,
    "duration": 4.563
  }
]