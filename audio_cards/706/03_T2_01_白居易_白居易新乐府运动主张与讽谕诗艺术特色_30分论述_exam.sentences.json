[
  {
    "id": 1,
    "text": "试论白居易的新乐府运动主张与讽谕诗艺术特色。",
    "start": 0.101,
    "end": 4.006,
    "duration": 3.905
  },
  {
    "id": 2,
    "text": "白居易是中唐新乐府运动的理论倡导者与卓越领袖。",
    "start": 4.506,
    "end": 8.521,
    "duration": 4.015
  },
  {
    "id": 3,
    "text": "面对安史之乱后藩镇割据、赋敛苛重与宦官专权的社会危机，",
    "start": 8.879,
    "end": 13.971,
    "duration": 5.092
  },
  {
    "id": 4,
    "text": "白居易上承《诗经》风雅比兴与杜甫即事名篇的现实主义传统，",
    "start": 14.345,
    "end": 18.977,
    "duration": 4.632
  },
  {
    "id": 5,
    "text": "发起了自觉的诗歌革新运动。",
    "start": 19.237,
    "end": 21.389,
    "duration": 2.152
  },
  {
    "id": 6,
    "text": "他力主恢复诗歌美刺讽谕的政教功能，使诗歌成为针砭时弊、",
    "start": 21.674,
    "end": 26.798,
    "duration": 5.124
  },
  {
    "id": 7,
    "text": "反映民生疾苦的有力武器。",
    "start": 27.167,
    "end": 29.047,
    "duration": 1.88
  },
  {
    "id": 8,
    "text": "其新乐府理论主张与讽谕诗艺术特色，主要体现在以下四个方面：",
    "start": 29.365,
    "end": 34.062,
    "duration": 4.697
  },
  {
    "id": 9,
    "text": "第一，确立“文章合为时而著，",
    "start": 34.729,
    "end": 37.441,
    "duration": 2.712
  },
  {
    "id": 10,
    "text": "歌诗合为事而作”的现实主义诗学纲领。",
    "start": 37.769,
    "end": 40.843,
    "duration": 3.074
  },
  {
    "id": 11,
    "text": "在著名的《与元九书》中，白居易系统阐述了其诗学主张。",
    "start": 41.211,
    "end": 45.415,
    "duration": 4.204
  },
  {
    "id": 12,
    "text": "他把诗歌创作与时代政治紧密联系，",
    "start": 45.842,
    "end": 48.874,
    "duration": 3.032
  },
  {
    "id": 13,
    "text": "明确提出“文章合为时而著，歌诗合为事而作”的创作纲领，",
    "start": 49.002,
    "end": 53.671,
    "duration": 4.669
  },
  {
    "id": 14,
    "text": "并提出诗歌“根情，苗言，华声，实义”的有机观，",
    "start": 53.998,
    "end": 58.278,
    "duration": 4.28
  },
  {
    "id": 15,
    "text": "强调诗的根本功用在于“补察时政，泄导人情”。",
    "start": 58.593,
    "end": 62.44,
    "duration": 3.847
  },
  {
    "id": 16,
    "text": "这一主张直接承接儒家诗教与杜甫写实道路，",
    "start": 62.782,
    "end": 66.361,
    "duration": 3.579
  },
  {
    "id": 17,
    "text": "有力扭转了齐梁余风及大历诗坛偏重吟咏风月、",
    "start": 66.684,
    "end": 70.898,
    "duration": 4.214
  },
  {
    "id": 18,
    "text": "流连清雅的倾向，将诗歌重新引向直面国计民生的正途。",
    "start": 71.223,
    "end": 75.968,
    "duration": 4.745
  },
  {
    "id": 19,
    "text": "第二，践行“即事名篇，无复依傍”的创作原则，",
    "start": 76.619,
    "end": 80.55,
    "duration": 3.931
  },
  {
    "id": 20,
    "text": "尖锐揭露社会矛盾。",
    "start": 80.858,
    "end": 82.21,
    "duration": 1.352
  },
  {
    "id": 21,
    "text": "在创作实践上，白居易与元稹倡导摆脱汉魏乐府古题的旧壳，",
    "start": 82.552,
    "end": 87.784,
    "duration": 5.232
  },
  {
    "id": 22,
    "text": "创立“新乐府”体式。",
    "start": 88.186,
    "end": 89.576,
    "duration": 1.39
  },
  {
    "id": 23,
    "text": "白居易所作《新乐府》五十首与《秦中吟》十首，",
    "start": 89.973,
    "end": 93.419,
    "duration": 3.446
  },
  {
    "id": 24,
    "text": "大多一篇专咏一事，“首句标其目，卒章显其志”，",
    "start": 93.664,
    "end": 97.927,
    "duration": 4.263
  },
  {
    "id": 25,
    "text": "直接取材于元和年间的现实矛盾。",
    "start": 98.235,
    "end": 100.674,
    "duration": 2.439
  },
  {
    "id": 26,
    "text": "在《卖炭翁》中，",
    "start": 101.139,
    "end": 102.066,
    "duration": 0.927
  },
  {
    "id": 27,
    "text": "以“心忧炭贱愿天寒”细摹老人艰难矛盾的心理，以“一车炭，",
    "start": 102.311,
    "end": 107.864,
    "duration": 5.553
  },
  {
    "id": 28,
    "text": "千余斤，宫使驱将惜不得”揭露宫市掠夺的横暴；",
    "start": 108.024,
    "end": 112.3,
    "duration": 4.276
  },
  {
    "id": 29,
    "text": "在《观刈麦》中，借贫妇拾穗的凄凉细节，发为“念此私自愧，",
    "start": 112.895,
    "end": 118.435,
    "duration": 5.54
  },
  {
    "id": 30,
    "text": "尽日不能忘”的深刻自省，流露出深切的同情。",
    "start": 118.703,
    "end": 122.302,
    "duration": 3.599
  },
  {
    "id": 31,
    "text": "第三，遵循“其辞质而径，其言直而切”的标准，",
    "start": 122.993,
    "end": 127.465,
    "duration": 4.472
  },
  {
    "id": 32,
    "text": "形成平易通俗的诗风。",
    "start": 127.887,
    "end": 129.627,
    "duration": 1.74
  },
  {
    "id": 33,
    "text": "为了使民情上达天听、教化广泛流传，",
    "start": 129.912,
    "end": 133.061,
    "duration": 3.149
  },
  {
    "id": 34,
    "text": "白居易在《新乐府序》中提出了明确的标准：“其辞质而径，",
    "start": 133.664,
    "end": 138.276,
    "duration": 4.612
  },
  {
    "id": 35,
    "text": "欲见之者易谕也；其言直而切，欲闻之者深诫也；其事核而实，",
    "start": 138.741,
    "end": 145.092,
    "duration": 6.351
  },
  {
    "id": 36,
    "text": "使采之者传信也；其体顺而肆，可以播于乐章歌曲也。",
    "start": 145.244,
    "end": 150.096,
    "duration": 4.852
  },
  {
    "id": 37,
    "text": "”他坚持语言浅显明畅、多用日常口语，避免艰深用典，",
    "start": 150.409,
    "end": 154.424,
    "duration": 4.015
  },
  {
    "id": 38,
    "text": "并善用白描与对比映衬手法。",
    "start": 154.634,
    "end": 156.799,
    "duration": 2.165
  },
  {
    "id": 39,
    "text": "如《轻肥》中，一边写内臣大夫“樽罍溢九酝，",
    "start": 157.153,
    "end": 160.801,
    "duration": 3.648
  },
  {
    "id": 40,
    "text": "水陆罗八珍”的骄奢宴乐，一边冷峻点出“是岁江南旱，",
    "start": 161.101,
    "end": 166.012,
    "duration": 4.911
  },
  {
    "id": 41,
    "text": "衢州人食人”，形成震撼人心的强烈对照。",
    "start": 166.149,
    "end": 169.443,
    "duration": 3.294
  },
  {
    "id": 42,
    "text": "第四，以讽谕诗重塑诗歌品类格局，巩固中唐现实主义诗潮。",
    "start": 170.09,
    "end": 175.251,
    "duration": 5.161
  },
  {
    "id": 43,
    "text": "白居易自编诗集，",
    "start": 175.604,
    "end": 176.856,
    "duration": 1.252
  },
  {
    "id": 44,
    "text": "将平生诗作划分为“讽谕”“闲适”“感伤”“杂律”四类，",
    "start": 176.936,
    "end": 182.339,
    "duration": 5.403
  },
  {
    "id": 45,
    "text": "并把体现兼济之志的讽谕诗置诸首位。",
    "start": 182.839,
    "end": 185.741,
    "duration": 2.902
  },
  {
    "id": 46,
    "text": "这一分类凸显了其“惟歌生民病，愿得天子知”的社会抱负，",
    "start": 186.367,
    "end": 191.12,
    "duration": 4.753
  },
  {
    "id": 47,
    "text": "虽有时因过于偏重讽谏说教而稍损含蓄，却直接推动了元稹、",
    "start": 191.363,
    "end": 196.43,
    "duration": 5.067
  },
  {
    "id": 48,
    "text": "张籍、王建等新乐府诗人的群体创作，",
    "start": 196.749,
    "end": 199.547,
    "duration": 2.798
  },
  {
    "id": 49,
    "text": "在中唐诗坛掀起了波澜壮阔的写实诗潮。",
    "start": 199.8,
    "end": 202.942,
    "duration": 3.142
  }
]