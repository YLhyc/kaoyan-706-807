[
  {
    "id": 1,
    "text": "试论白居易的新乐府运动主张与讽谕诗艺术特色。",
    "start": 0.101,
    "end": 4.016,
    "duration": 3.915
  },
  {
    "id": 2,
    "text": "白居易是中唐新乐府运动的理论倡导者与卓越领袖。",
    "start": 4.516,
    "end": 8.541,
    "duration": 4.025
  },
  {
    "id": 3,
    "text": "面对安史之乱后藩镇割据、赋敛苛重与宦官专权的社会危机，",
    "start": 9.041,
    "end": 14.143,
    "duration": 5.102
  },
  {
    "id": 4,
    "text": "白居易上承《诗经》风雅比兴与杜甫即事名篇的现实主义传统，发起了自觉的诗歌革新运动。",
    "start": 14.507,
    "end": 21.561,
    "duration": 7.054
  },
  {
    "id": 5,
    "text": "他力主恢复诗歌美刺讽谕的政教功能，使诗歌成为针砭时弊、反映民生疾苦的有力武器。",
    "start": 22.061,
    "end": 29.248,
    "duration": 7.187
  },
  {
    "id": 6,
    "text": "其新乐府理论主张与讽谕诗艺术特色，主要体现在以下四个方面：",
    "start": 29.748,
    "end": 34.455,
    "duration": 4.707
  },
  {
    "id": 7,
    "text": "第一，确立“文章合为时而著，歌诗合为事而作”的现实主义诗学纲领。",
    "start": 35.112,
    "end": 41.211,
    "duration": 6.099
  },
  {
    "id": 8,
    "text": "在著名的《与元九书》中，白居易系统阐述了其诗学主张。",
    "start": 41.711,
    "end": 45.925,
    "duration": 4.214
  },
  {
    "id": 9,
    "text": "他把诗歌创作与时代政治紧密联系，",
    "start": 46.425,
    "end": 49.208,
    "duration": 2.783
  },
  {
    "id": 10,
    "text": "明确提出“文章合为时而著，歌诗合为事而作”的创作纲领，并提出诗歌“根情，苗言，华声，实义”的有机观，",
    "start": 49.566,
    "end": 58.871,
    "duration": 9.305
  },
  {
    "id": 11,
    "text": "强调诗的根本功用在于“补察时政，泄导人情”。",
    "start": 59.221,
    "end": 63.078,
    "duration": 3.857
  },
  {
    "id": 12,
    "text": "这一主张直接承接儒家诗教与杜甫写实道路，",
    "start": 63.578,
    "end": 67.155,
    "duration": 3.577
  },
  {
    "id": 13,
    "text": "有力扭转了齐梁余风及大历诗坛偏重吟咏风月、流连清雅的倾向，",
    "start": 67.505,
    "end": 73.25,
    "duration": 5.745
  },
  {
    "id": 14,
    "text": "将诗歌重新引向直面国计民生的正途。",
    "start": 73.67,
    "end": 76.799,
    "duration": 3.129
  },
  {
    "id": 15,
    "text": "第二，践行“即事名篇，无复依傍”的创作原则，尖锐揭露社会矛盾。",
    "start": 77.44,
    "end": 83.041,
    "duration": 5.601
  },
  {
    "id": 16,
    "text": "在创作实践上，白居易与元稹倡导摆脱汉魏乐府古题的旧壳，创立“新乐府”体式。",
    "start": 83.541,
    "end": 90.575,
    "duration": 7.034
  },
  {
    "id": 17,
    "text": "白居易所作《新乐府》五十首与《秦中吟》十首，大多一篇专咏一事，",
    "start": 91.075,
    "end": 96.318,
    "duration": 5.243
  },
  {
    "id": 18,
    "text": "“首句标其目，卒章显其志”，直接取材于元和年间的现实矛盾。",
    "start": 96.668,
    "end": 101.792,
    "duration": 5.124
  },
  {
    "id": 19,
    "text": "在《卖炭翁》中，以“心忧炭贱愿天寒”细摹老人艰难矛盾的心理，",
    "start": 102.292,
    "end": 107.701,
    "duration": 5.409
  },
  {
    "id": 20,
    "text": "以“一车炭，千余斤，宫使驱将惜不得”揭露宫市掠夺的横暴；",
    "start": 108.284,
    "end": 113.463,
    "duration": 5.179
  },
  {
    "id": 21,
    "text": "在《观刈麦》中，借贫妇拾穗的凄凉细节，发为“念此私自愧，尽日不能忘”的深刻自省，流露出深切的同情。",
    "start": 114.048,
    "end": 123.465,
    "duration": 9.417
  },
  {
    "id": 22,
    "text": "第三，遵循“其辞质而径，其言直而切”的标准，形成平易通俗的诗风。",
    "start": 124.146,
    "end": 130.79,
    "duration": 6.644
  },
  {
    "id": 23,
    "text": "为了使民情上达天听、教化广泛流传，",
    "start": 131.29,
    "end": 134.449,
    "duration": 3.159
  },
  {
    "id": 24,
    "text": "白居易在《新乐府序》中提出了明确的标准：",
    "start": 135.042,
    "end": 137.864,
    "duration": 2.822
  },
  {
    "id": 25,
    "text": "“其辞质而径，欲见之者易谕也；",
    "start": 138.597,
    "end": 141.593,
    "duration": 2.996
  },
  {
    "id": 26,
    "text": "其言直而切，欲闻之者深诫也；",
    "start": 142.093,
    "end": 144.964,
    "duration": 2.871
  },
  {
    "id": 27,
    "text": "其事核而实，使采之者传信也；",
    "start": 145.464,
    "end": 148.387,
    "duration": 2.923
  },
  {
    "id": 28,
    "text": "其体顺而肆，可以播于乐章歌曲也。”",
    "start": 148.887,
    "end": 152.049,
    "duration": 3.162
  },
  {
    "id": 29,
    "text": "他坚持语言浅显明畅、多用日常口语，",
    "start": 152.549,
    "end": 155.356,
    "duration": 2.807
  },
  {
    "id": 30,
    "text": "避免艰深用典，并善用白描与对比映衬手法。",
    "start": 155.706,
    "end": 159.109,
    "duration": 3.403
  },
  {
    "id": 31,
    "text": "如《轻肥》中，一边写内臣大夫“樽罍溢九酝，水陆罗八珍”的骄奢宴乐，",
    "start": 159.609,
    "end": 165.693,
    "duration": 6.084
  },
  {
    "id": 32,
    "text": "一边冷峻点出“是岁江南旱，衢州人食人”，形成震撼人心的强烈对照。",
    "start": 166.043,
    "end": 172.035,
    "duration": 5.992
  },
  {
    "id": 33,
    "text": "第四，以讽谕诗重塑诗歌品类格局，巩固中唐现实主义诗潮。",
    "start": 172.672,
    "end": 177.843,
    "duration": 5.171
  },
  {
    "id": 34,
    "text": "白居易自编诗集，将平生诗作划分为“讽谕”“闲适”“感伤”“杂律”四类，并把体现兼济之志的讽谕诗置诸首位。",
    "start": 178.343,
    "end": 188.49,
    "duration": 10.147
  },
  {
    "id": 35,
    "text": "这一分类凸显了其“惟歌生民病，愿得天子知”的社会抱负，",
    "start": 189.106,
    "end": 193.869,
    "duration": 4.763
  },
  {
    "id": 36,
    "text": "虽有时因过于偏重讽谏说教而稍损含蓄，却直接推动了元稹、张籍、王建等新乐府诗人的群体创作，",
    "start": 194.219,
    "end": 202.413,
    "duration": 8.194
  },
  {
    "id": 37,
    "text": "在中唐诗坛掀起了波澜壮阔的写实诗潮。",
    "start": 202.763,
    "end": 205.905,
    "duration": 3.142
  },
  {
    "id": 38,
    "text": "综上所述，白居易在中唐社会危机之中积极推行新乐府诗歌革新，",
    "start": 206.405,
    "end": 211.683,
    "duration": 5.278
  },
  {
    "id": 39,
    "text": "以“文章合为时而著，歌诗合为事而作”为纲领，借通俗明畅的叙事笔法直击民生疾苦。",
    "start": 212.086,
    "end": 219.264,
    "duration": 7.178
  },
  {
    "id": 40,
    "text": "虽然部分讽谕诗因刻意说教而略显直露，但其自觉发扬杜甫即事名篇的精神并带动元稹、张籍等诗人呼应，",
    "start": 219.764,
    "end": 228.046,
    "duration": 8.282
  },
  {
    "id": 41,
    "text": "在中唐诗坛重新高扬起关心世事的现实主义传统。",
    "start": 228.396,
    "end": 233.387,
    "duration": 4.991
  }
]
