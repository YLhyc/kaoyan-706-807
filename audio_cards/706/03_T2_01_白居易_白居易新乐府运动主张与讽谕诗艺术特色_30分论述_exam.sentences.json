[
  {
    "id": "sent_1",
    "text": "白居易是中唐新乐府运动的理论倡导者与卓越领袖。",
    "start": 0.1,
    "end": 4.855,
    "duration": 4.755
  },
  {
    "id": "sent_2",
    "text": "面对安史之乱后藩镇割据加剧、土地兼并严重与宦官弄权的社会危机，",
    "start": 4.805,
    "end": 11.654,
    "duration": 6.849
  },
  {
    "id": "sent_3",
    "text": "白居易上承 《诗经》 六义与杜甫即事名篇的现实主义传统，",
    "start": 11.654,
    "end": 16.758,
    "duration": 5.104
  },
  {
    "id": "sent_4",
    "text": "发起了中国文学史上最具自觉批判精神的诗歌革新运动。",
    "start": 16.758,
    "end": 21.927,
    "duration": 5.169
  },
  {
    "id": "sent_5",
    "text": "他主张恢复诗歌讽谕教化的政治功能，",
    "start": 21.927,
    "end": 25.586,
    "duration": 3.659
  },
  {
    "id": "sent_6",
    "text": "使文学成为干预现实、救济生民的强大思想武器。",
    "start": 25.586,
    "end": 30.456,
    "duration": 4.87
  },
  {
    "id": "sent_7",
    "text": "其新乐府理论主张与讽谕诗艺术特色，主要展现为以下四个核心维度：",
    "start": 30.456,
    "end": 37.136,
    "duration": 6.68
  },
  {
    "id": "sent_8",
    "text": "第一，系统确立“文章合为时而著，",
    "start": 37.135,
    "end": 40.481,
    "duration": 3.346
  },
  {
    "id": "sent_9",
    "text": "歌诗合为事而作”的现实主义诗学纲领。",
    "start": 40.482,
    "end": 44.128,
    "duration": 3.646
  },
  {
    "id": "sent_10",
    "text": "在著名的 《与元九书》 中，白居易全面阐释了其文学主张。",
    "start": 44.128,
    "end": 49.18,
    "duration": 5.052
  },
  {
    "id": "sent_11",
    "text": "他将诗歌与时代政治紧密相连，明确提出 “文章合为时而著，",
    "start": 49.18,
    "end": 55.156,
    "duration": 5.976
  },
  {
    "id": "sent_12",
    "text": "歌诗合为事而作”。",
    "start": 55.156,
    "end": 57.123,
    "duration": 1.967
  },
  {
    "id": "sent_13",
    "text": "白居易追溯诗歌源头，提出诗歌 “根情，苗言，华声，",
    "start": 57.122,
    "end": 62.812,
    "duration": 5.69
  },
  {
    "id": "sent_14",
    "text": "实义” 的有机整体观，强调诗歌的本质在于“实义”，",
    "start": 62.813,
    "end": 67.487,
    "duration": 4.674
  },
  {
    "id": "sent_15",
    "text": "即必须具备严肃的思想内容与社会功用；",
    "start": 67.487,
    "end": 71.419,
    "duration": 3.932
  },
  {
    "id": "sent_16",
    "text": "他极力提倡诗歌应当起到 “补察时政，泄导人情” 的批判讽谕作用。",
    "start": 71.419,
    "end": 77.578,
    "duration": 6.159
  },
  {
    "id": "sent_17",
    "text": "这一诗学纲领彻底扭转了齐梁余风与大历以来沉溺于吟咏风月、逃避现实的狭窄诗风，",
    "start": 77.578,
    "end": 85.885,
    "duration": 8.307
  },
  {
    "id": "sent_18",
    "text": "将文学引向直面国计民生的阔大正途。",
    "start": 85.885,
    "end": 89.869,
    "duration": 3.984
  },
  {
    "id": "sent_19",
    "text": "第二，确立“即事名篇，无复依傍”的创作原则，",
    "start": 89.87,
    "end": 94.232,
    "duration": 4.362
  },
  {
    "id": "sent_20",
    "text": "全面直面社会黑暗现实。",
    "start": 94.232,
    "end": 96.784,
    "duration": 2.552
  },
  {
    "id": "sent_21",
    "text": "在具体创作上，白居易与元稹倡导摆脱汉魏乐府古题的陈旧束缚，",
    "start": 96.784,
    "end": 102.943,
    "duration": 6.159
  },
  {
    "id": "sent_22",
    "text": "确立了 “新乐府” 这一全新范式。",
    "start": 102.943,
    "end": 105.886,
    "duration": 2.943
  },
  {
    "id": "sent_23",
    "text": "白居易所创作的 《新乐府》 五十首与 《秦中吟》 十首，",
    "start": 105.885,
    "end": 110.247,
    "duration": 4.362
  },
  {
    "id": "sent_24",
    "text": "严格恪守“因事立题，题称其事”的原则，",
    "start": 110.247,
    "end": 114.01,
    "duration": 3.763
  },
  {
    "id": "sent_25",
    "text": "取材全取自元和年间的当代社会矛盾。",
    "start": 114.01,
    "end": 117.851,
    "duration": 3.841
  },
  {
    "id": "sent_26",
    "text": "在代表作 《卖炭翁》 中，",
    "start": 117.852,
    "end": 120.209,
    "duration": 2.357
  },
  {
    "id": "sent_27",
    "text": "作者以 “心忧炭贱愿天寒” 极写底层劳动人民生存处境的艰难矛盾，",
    "start": 120.208,
    "end": 126.458,
    "duration": 6.25
  },
  {
    "id": "sent_28",
    "text": "以 “一车炭，千余斤，",
    "start": 126.458,
    "end": 129.166,
    "duration": 2.708
  },
  {
    "id": "sent_29",
    "text": "宫使驱将惜不得” 深刻揭露宫市掠夺的蛮横霸道；",
    "start": 129.167,
    "end": 133.763,
    "duration": 4.596
  },
  {
    "id": "sent_30",
    "text": "在 《观刈麦》 中，借妇儿提筐拾穗的凄凉细节，",
    "start": 133.763,
    "end": 137.982,
    "duration": 4.219
  },
  {
    "id": "sent_31",
    "text": "反思自身 “念此私自愧，尽日不能忘” 的士大夫愧怍之情。",
    "start": 137.982,
    "end": 143.151,
    "duration": 5.169
  },
  {
    "id": "sent_32",
    "text": "第三，实践“其辞质而径，其事核而实”的白描手法与平易诗风。",
    "start": 143.151,
    "end": 149.075,
    "duration": 5.924
  },
  {
    "id": "sent_33",
    "text": "为了达到让“天下之人受其赐”的社会传播目的，",
    "start": 149.076,
    "end": 153.477,
    "duration": 4.401
  },
  {
    "id": "sent_34",
    "text": "白居易在艺术形式上力求平易通俗。",
    "start": 153.477,
    "end": 157.149,
    "duration": 3.672
  },
  {
    "id": "sent_35",
    "text": "他明确要求讽谕诗必须做到 “其辞质而径，其事核而实，其体顺而肆，",
    "start": 157.148,
    "end": 164.088,
    "duration": 6.94
  },
  {
    "id": "sent_36",
    "text": "其音顺而哀”。",
    "start": 164.089,
    "end": 165.912,
    "duration": 1.823
  },
  {
    "id": "sent_37",
    "text": "在语言上，他坚持通俗明畅、少用生僻典故，",
    "start": 165.911,
    "end": 170.572,
    "duration": 4.661
  },
  {
    "id": "sent_38",
    "text": "甚至追求“老妪能解”的大众化审美；",
    "start": 170.573,
    "end": 174.115,
    "duration": 3.542
  },
  {
    "id": "sent_39",
    "text": "在表现技巧上，他善用白描手法与对比映衬，",
    "start": 174.115,
    "end": 178.633,
    "duration": 4.518
  },
  {
    "id": "sent_40",
    "text": "如 《轻肥》 中一边是贪官权贵 “樽罍溢九酝，",
    "start": 178.633,
    "end": 183.086,
    "duration": 4.453
  },
  {
    "id": "sent_41",
    "text": "水陆罗八珍” 的极度奢靡，一边是江南 “人吃人” 的赤地千里，",
    "start": 183.085,
    "end": 188.437,
    "duration": 5.352
  },
  {
    "id": "sent_42",
    "text": "两相对照，展现出震人心魄的批判力量。",
    "start": 188.438,
    "end": 192.448,
    "duration": 4.01
  },
  {
    "id": "sent_43",
    "text": "第四，以讽谕诗重构诗歌品类格局，确立中唐现实主义诗歌的高峰地位。",
    "start": 192.448,
    "end": 199.245,
    "duration": 6.797
  },
  {
    "id": "sent_44",
    "text": "白居易自编诗集，",
    "start": 199.245,
    "end": 201.354,
    "duration": 2.109
  },
  {
    "id": "sent_45",
    "text": "将自身诗歌划分为 “讽谕”、“闲适”、“感伤”、“杂律” 四大品类，",
    "start": 201.354,
    "end": 207.435,
    "duration": 6.081
  },
  {
    "id": "sent_46",
    "text": "并明确以讽谕诗居于首位。",
    "start": 207.435,
    "end": 210.261,
    "duration": 2.826
  },
  {
    "id": "sent_47",
    "text": "这种文体观念的重构，不仅彰显出其以济世为怀的崇高政治抱负，",
    "start": 210.26,
    "end": 216.354,
    "duration": 6.094
  },
  {
    "id": "sent_48",
    "text": "更直接启迪了元稹、张籍、王建等新乐府诗人的群体创作。",
    "start": 216.354,
    "end": 222.252,
    "duration": 5.898
  },
  {
    "id": "sent_49",
    "text": "白居易的讽谕诗以卓越的社会责任感与独特的平民化语言，",
    "start": 222.253,
    "end": 227.305,
    "duration": 5.052
  },
  {
    "id": "sent_50",
    "text": "构建起唐代现实主义诗歌传统中又一座承前启后的崇高丰碑。",
    "start": 227.305,
    "end": 233.256,
    "duration": 5.951
  }
]