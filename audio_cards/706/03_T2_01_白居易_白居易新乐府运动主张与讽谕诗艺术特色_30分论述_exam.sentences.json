[
  {
    "id": 1,
    "text": "试论白居易的新乐府运动主张与讽谕诗艺术特色。",
    "start": 0.16,
    "end": 4.177,
    "duration": 4.017
  },
  {
    "id": 2,
    "text": "白居易是中唐新乐府运动的理论倡导者与卓越领袖。",
    "start": 4.177,
    "end": 8.618,
    "duration": 4.441
  },
  {
    "id": 3,
    "text": "面对安史之乱后藩镇割据加剧、",
    "start": 8.618,
    "end": 11.321,
    "duration": 2.703
  },
  {
    "id": 4,
    "text": "土地兼并严重与宦官弄权的社会危机，",
    "start": 11.321,
    "end": 14.604,
    "duration": 3.283
  },
  {
    "id": 5,
    "text": "白居易上承 《诗经》 六义与杜甫即事名篇的现实主义传统，",
    "start": 14.604,
    "end": 19.625,
    "duration": 5.021
  },
  {
    "id": 6,
    "text": "发起了中国文学史上最具自觉批判精神的诗歌革新运动。",
    "start": 19.625,
    "end": 24.48,
    "duration": 4.855
  },
  {
    "id": 7,
    "text": "他主张恢复诗歌讽谕教化的政治功能，使文学成为干预现实、",
    "start": 24.48,
    "end": 30.0,
    "duration": 5.52
  },
  {
    "id": 8,
    "text": "救济生民的强大思想武器。",
    "start": 30.0,
    "end": 32.48,
    "duration": 2.48
  },
  {
    "id": 9,
    "text": "其新乐府理论主张与讽谕诗艺术特色，",
    "start": 32.56,
    "end": 35.84,
    "duration": 3.28
  },
  {
    "id": 10,
    "text": "主要展现为以下四个核心维度：",
    "start": 35.84,
    "end": 39.12,
    "duration": 3.28
  },
  {
    "id": 11,
    "text": "第一，系统确立“文章合为时而著，",
    "start": 39.2,
    "end": 42.64,
    "duration": 3.44
  },
  {
    "id": 12,
    "text": "歌诗合为事而作”的现实主义诗学纲领。",
    "start": 42.64,
    "end": 46.8,
    "duration": 4.16
  },
  {
    "id": 13,
    "text": "在著名的 《与元九书》 中，白居易全面阐释了其文学主张。",
    "start": 46.8,
    "end": 52.0,
    "duration": 5.2
  },
  {
    "id": 14,
    "text": "他将诗歌与时代政治紧密相连，明确提出 “文章合为时而著，",
    "start": 52.24,
    "end": 57.92,
    "duration": 5.68
  },
  {
    "id": 15,
    "text": "歌诗合为事而作”。",
    "start": 58.16,
    "end": 60.96,
    "duration": 2.8
  },
  {
    "id": 16,
    "text": "白居易追溯诗歌源头，提出诗歌 “根情，苗言，华声，",
    "start": 60.96,
    "end": 65.92,
    "duration": 4.96
  },
  {
    "id": 17,
    "text": "实义” 的有机整体观，强调诗歌的本质在于“实义”，",
    "start": 65.92,
    "end": 71.28,
    "duration": 5.36
  },
  {
    "id": 18,
    "text": "即必须具备严肃的思想内容与社会功用；",
    "start": 71.52,
    "end": 75.36,
    "duration": 3.84
  },
  {
    "id": 19,
    "text": "他极力提倡诗歌应当起到 “补察时政，",
    "start": 75.36,
    "end": 78.96,
    "duration": 3.6
  },
  {
    "id": 20,
    "text": "泄导人情” 的批判讽谕作用。",
    "start": 78.96,
    "end": 81.92,
    "duration": 2.96
  },
  {
    "id": 21,
    "text": "这一诗学纲领彻底扭转了齐梁余风与大历以来沉溺于吟咏风月、",
    "start": 81.92,
    "end": 89.2,
    "duration": 7.28
  },
  {
    "id": 22,
    "text": "逃避现实的狭窄诗风，将文学引向直面国计民生的阔大正途。",
    "start": 89.2,
    "end": 95.52,
    "duration": 6.32
  },
  {
    "id": 23,
    "text": "第二，确立“即事名篇，无复依傍”的创作原则，",
    "start": 95.52,
    "end": 99.36,
    "duration": 3.84
  },
  {
    "id": 24,
    "text": "全面直面社会黑暗现实。",
    "start": 99.36,
    "end": 100.88,
    "duration": 1.52
  },
  {
    "id": 25,
    "text": "在具体创作上，",
    "start": 100.88,
    "end": 102.08,
    "duration": 1.2
  },
  {
    "id": 26,
    "text": "白居易与元稹倡导摆脱汉魏乐府古题的陈旧束缚，",
    "start": 102.16,
    "end": 106.56,
    "duration": 4.4
  },
  {
    "id": 27,
    "text": "确立了 “新乐府” 这一全新范式。",
    "start": 106.56,
    "end": 109.52,
    "duration": 2.96
  },
  {
    "id": 28,
    "text": "白居易所创作的 《新乐府》 五十首与 《秦中吟》 十首，",
    "start": 109.52,
    "end": 115.2,
    "duration": 5.68
  },
  {
    "id": 29,
    "text": "严格恪守“因事立题，题称其事”的原则，",
    "start": 115.2,
    "end": 119.36,
    "duration": 4.16
  },
  {
    "id": 30,
    "text": "取材全取自元和年间的当代社会矛盾。",
    "start": 119.44,
    "end": 123.84,
    "duration": 4.4
  },
  {
    "id": 31,
    "text": "在代表作 《卖炭翁》 中，",
    "start": 123.84,
    "end": 126.0,
    "duration": 2.16
  },
  {
    "id": 32,
    "text": "作者以 “心忧炭贱愿天寒” 极写底层劳动人民生存处境的艰难矛盾，",
    "start": 126.08,
    "end": 133.36,
    "duration": 7.28
  },
  {
    "id": 33,
    "text": "以 “一车炭，千余斤，",
    "start": 133.44,
    "end": 135.28,
    "duration": 1.84
  },
  {
    "id": 34,
    "text": "宫使驱将惜不得” 深刻揭露宫市掠夺的蛮横霸道；",
    "start": 135.52,
    "end": 141.68,
    "duration": 6.16
  },
  {
    "id": 35,
    "text": "在 《观刈麦》 中，借妇儿提筐拾穗的凄凉细节，",
    "start": 141.68,
    "end": 145.816,
    "duration": 4.136
  },
  {
    "id": 36,
    "text": "反思自身 “念此私自愧，尽日不能忘” 的士大夫愧怍之情。",
    "start": 146.056,
    "end": 151.336,
    "duration": 5.28
  },
  {
    "id": 37,
    "text": "第三，实践“其辞质而径，其事核而实”的白描手法与平易诗风。",
    "start": 151.336,
    "end": 158.696,
    "duration": 7.36
  },
  {
    "id": 38,
    "text": "为了达到让“天下之人受其赐”的社会传播目的，",
    "start": 158.696,
    "end": 163.496,
    "duration": 4.8
  },
  {
    "id": 39,
    "text": "白居易在艺术形式上力求平易通俗。",
    "start": 163.496,
    "end": 167.336,
    "duration": 3.84
  },
  {
    "id": 40,
    "text": "他明确要求讽谕诗必须做到 “其辞质而径，其事核而实，",
    "start": 167.336,
    "end": 173.416,
    "duration": 6.08
  },
  {
    "id": 41,
    "text": "其体顺而肆，其音顺而哀”。",
    "start": 173.416,
    "end": 176.376,
    "duration": 2.96
  },
  {
    "id": 42,
    "text": "在语言上，他坚持通俗明畅、少用生僻典故，",
    "start": 176.536,
    "end": 181.096,
    "duration": 4.56
  },
  {
    "id": 43,
    "text": "甚至追求“老妪能解”的大众化审美；在表现技巧上，",
    "start": 181.336,
    "end": 186.696,
    "duration": 5.36
  },
  {
    "id": 44,
    "text": "他善用白描手法与对比映衬，",
    "start": 186.696,
    "end": 189.656,
    "duration": 2.96
  },
  {
    "id": 45,
    "text": "如 《轻肥》 中一边是贪官权贵 “樽罍溢九酝，",
    "start": 189.656,
    "end": 195.736,
    "duration": 6.08
  },
  {
    "id": 46,
    "text": "水陆罗八珍” 的极度奢靡，",
    "start": 195.736,
    "end": 198.376,
    "duration": 2.64
  },
  {
    "id": 47,
    "text": "一边是江南 “人吃人” 的赤地千里，两相对照，",
    "start": 198.376,
    "end": 202.456,
    "duration": 4.08
  },
  {
    "id": 48,
    "text": "展现出震人心魄的批判力量。",
    "start": 202.456,
    "end": 205.336,
    "duration": 2.88
  },
  {
    "id": 49,
    "text": "第四，以讽谕诗重构诗歌品类格局，",
    "start": 205.736,
    "end": 208.936,
    "duration": 3.2
  },
  {
    "id": 50,
    "text": "确立中唐现实主义诗歌的高峰地位。",
    "start": 209.176,
    "end": 211.976,
    "duration": 2.8
  },
  {
    "id": 51,
    "text": "白居易自编诗集，将自身诗歌划分为 “讽谕”、“闲适”、",
    "start": 212.056,
    "end": 216.776,
    "duration": 4.72
  },
  {
    "id": 52,
    "text": "“感伤”、“杂律” 四大品类，并明确以讽谕诗居于首位。",
    "start": 216.776,
    "end": 218.456,
    "duration": 1.68
  },
  {
    "id": 53,
    "text": "这种文体观念的重构，",
    "start": 218.296,
    "end": 218.456,
    "duration": 0.16
  },
  {
    "id": 54,
    "text": "不仅彰显出其以济世为怀的崇高政治抱负，更直接启迪了元稹、",
    "start": 218.296,
    "end": 218.456,
    "duration": 0.16
  },
  {
    "id": 55,
    "text": "张籍、王建等新乐府诗人的群体创作。",
    "start": 218.296,
    "end": 218.456,
    "duration": 0.16
  },
  {
    "id": 56,
    "text": "白居易的讽谕诗以卓越的社会责任感与独特的平民化语言，",
    "start": 218.296,
    "end": 218.456,
    "duration": 0.16
  },
  {
    "id": 57,
    "text": "构建起唐代现实主义诗歌传统中又一座承前启后的崇高丰碑。",
    "start": 218.296,
    "end": 218.456,
    "duration": 0.16
  }
]