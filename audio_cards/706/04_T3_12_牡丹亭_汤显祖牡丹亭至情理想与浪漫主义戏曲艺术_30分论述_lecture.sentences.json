[
  {
    "id": 1,
    "text": "试论汤显祖《牡丹亭》的“至情”理想与浪漫主义戏曲艺术。",
    "start": 0.104,
    "end": 4.706,
    "duration": 4.602
  },
  {
    "id": 2,
    "text": "汤显祖是明代成就最高的戏曲作家，其代表作《牡丹亭》位列“临川四梦”之首。",
    "start": 5.597,
    "end": 11.621,
    "duration": 6.024
  },
  {
    "id": 3,
    "text": "面对晚明程朱理学对人性的重重束缚与商业市民思潮的兴起，",
    "start": 12.273,
    "end": 17.055,
    "duration": 4.782
  },
  {
    "id": 4,
    "text": "汤显祖秉持“以情反理”的创作理念，",
    "start": 17.519,
    "end": 20.44,
    "duration": 2.921
  },
  {
    "id": 5,
    "text": "将民间还魂故事改造为一部礼赞青春与自由的浪漫主义传奇。",
    "start": 20.757,
    "end": 25.996,
    "duration": 5.239
  },
  {
    "id": 6,
    "text": "全剧的思想高度与艺术魅力，主要体现在以下四个方面：",
    "start": 26.438,
    "end": 30.899,
    "duration": 4.461
  },
  {
    "id": 7,
    "text": "第一，张扬生死不渝的“至情”理想，直接反拨“存天理、灭人欲”的理学礼教。",
    "start": 31.535,
    "end": 38.064,
    "duration": 6.529
  },
  {
    "id": 8,
    "text": "全剧以“至情”为核心精神支柱。",
    "start": 38.547,
    "end": 40.972,
    "duration": 2.425
  },
  {
    "id": 9,
    "text": "汤显祖在《牡丹亭题词》中写道：",
    "start": 41.629,
    "end": 43.694,
    "duration": 2.065
  },
  {
    "id": 10,
    "text": "“情不知所起，一往而深。",
    "start": 44.235,
    "end": 46.234,
    "duration": 1.999
  },
  {
    "id": 11,
    "text": "生者可以死，死可以生。",
    "start": 46.715,
    "end": 48.785,
    "duration": 2.07
  },
  {
    "id": 12,
    "text": "生而不可与死，死而不可复生者，皆非情之至也。”",
    "start": 49.243,
    "end": 54.783,
    "duration": 5.54
  },
  {
    "id": 13,
    "text": "剧中的杜丽娘本是深闺千金，",
    "start": 54.839,
    "end": 55.936,
    "duration": 1.097
  },
  {
    "id": 14,
    "text": "在《闺塾》读《关雎》初萌春思，继而入园感受良辰美景，",
    "start": 56.173,
    "end": 60.418,
    "duration": 4.245
  },
  {
    "id": 15,
    "text": "在现实压抑中因情入梦、为情而死，又在鬼魂之身中与柳梦梅相依并终得复生。",
    "start": 60.892,
    "end": 68.043,
    "duration": 7.151
  },
  {
    "id": 16,
    "text": "从闺阁乖女到还魂抗争，她一次次跨过贞节关、鬼门关与朝廷金阶，",
    "start": 68.362,
    "end": 74.313,
    "duration": 5.951
  },
  {
    "id": 17,
    "text": "有力肯定了人的自然欲求与个性解放。",
    "start": 74.581,
    "end": 77.49,
    "duration": 2.909
  },
  {
    "id": 18,
    "text": "第二，融汇奇幻梦境与人间世态，构建虚实相生的浪漫主义戏剧冲突。",
    "start": 78.155,
    "end": 84.345,
    "duration": 6.19
  },
  {
    "id": 19,
    "text": "《牡丹亭》打破日常因果写实边界，以天上地下、人鬼幽明交错的奇想推动剧情。",
    "start": 84.607,
    "end": 91.467,
    "duration": 6.86
  },
  {
    "id": 20,
    "text": "汤显祖在《题词》中指出“梦中之情，何必非真”，",
    "start": 91.801,
    "end": 95.308,
    "duration": 3.507
  },
  {
    "id": 21,
    "text": "在《惊梦》《冥判》《魂游》等折以梦境鬼乡寄托“成人不自在”时的无拘自由。",
    "start": 95.654,
    "end": 101.56,
    "duration": 5.906
  },
  {
    "id": 22,
    "text": "但全剧并不浮悬于空幻，还魂复生后的杜丽娘重返现实即受礼法约束，",
    "start": 101.834,
    "end": 107.858,
    "duration": 6.024
  },
  {
    "id": 23,
    "text": "对柳梦梅坦言“前夕鬼也，今日人也。鬼可虚情，人须实礼”。",
    "start": 108.244,
    "end": 114.054,
    "duration": 5.81
  },
  {
    "id": 24,
    "text": "同时，以南安太守杜宝一味做官、死守礼教与陈最良迂腐说教作为对立面，",
    "start": 114.605,
    "end": 121.195,
    "duration": 6.59
  },
  {
    "id": 25,
    "text": "和春香、花神、胡判官形成鲜明正反阵营，使浪漫奇情深植于真实社会矛盾。",
    "start": 121.728,
    "end": 128.748,
    "duration": 7.02
  },
  {
    "id": 26,
    "text": "第三，锤炼诗化典雅曲辞，兼具悲喜交融的复合戏曲风格。",
    "start": 129.403,
    "end": 134.971,
    "duration": 5.568
  },
  {
    "id": 27,
    "text": "汤显祖以深厚诗才写曲，令全剧洋溢浓郁抒情氛围。",
    "start": 135.41,
    "end": 140.095,
    "duration": 4.685
  },
  {
    "id": 28,
    "text": "《惊梦》一折中，【皂罗袍】“原来姹紫嫣红开遍，似这般都付与断井颓垣。良辰美景奈何天，赏心乐事谁家院”一唱三叹，",
    "start": 140.72,
    "end": 152.086,
    "duration": 11.366
  },
  {
    "id": 29,
    "text": "将惜春叹命与向往自由抒发得动人心魄。",
    "start": 152.353,
    "end": 155.789,
    "duration": 3.436
  },
  {
    "id": 30,
    "text": "在结构情调上，全剧将《闹殇》《诀谒》的惨痛悲情与《闺塾》春香闹学、石道姑诙谐插科打诨融汇调度。",
    "start": 156.316,
    "end": 165.655,
    "duration": 9.339
  },
  {
    "id": 31,
    "text": "王思任评其“笑者真笑，笑即有声；啼者真啼，啼则有泪”，",
    "start": 166.188,
    "end": 171.65,
    "duration": 5.462
  },
  {
    "id": 32,
    "text": "正道出这种悲喜相映的独特艺术魅力。",
    "start": 171.856,
    "end": 174.92,
    "duration": 3.064
  },
  {
    "id": 33,
    "text": "第四，开晚明“临川派”主情先声，影响清代戏曲与小说创作。",
    "start": 175.522,
    "end": 180.629,
    "duration": 5.107
  },
  {
    "id": 34,
    "text": "《牡丹亭》是继《西厢记》之后古代爱情戏曲的又一座高峰。",
    "start": 181.066,
    "end": 185.146,
    "duration": 4.08
  },
  {
    "id": 35,
    "text": "明代沈德符《万历野获编》载：",
    "start": 185.561,
    "end": 187.573,
    "duration": 2.012
  },
  {
    "id": 36,
    "text": "“汤义仍《牡丹亭梦》一出，家传户诵，几令《西厢》减价。”",
    "start": 188.042,
    "end": 192.613,
    "duration": 4.571
  },
  {
    "id": 37,
    "text": "该剧不仅直接引领吴炳、孟称舜等玉茗堂派剧作家的主情创作，",
    "start": 192.613,
    "end": 197.181,
    "duration": 4.568
  },
  {
    "id": 38,
    "text": "更开启清代洪昇《长生殿》深情写史与孔尚任《桃花扇》离合寄兴之风；",
    "start": 197.495,
    "end": 202.845,
    "duration": 5.35
  },
  {
    "id": 39,
    "text": "曹雪芹在《红楼梦》第二十三回写林黛玉听闻“良辰美景”戏文而心动神摇、如痴如醉，亦见其深远沾溉。",
    "start": 203.24,
    "end": 211.299,
    "duration": 8.059
  }
]