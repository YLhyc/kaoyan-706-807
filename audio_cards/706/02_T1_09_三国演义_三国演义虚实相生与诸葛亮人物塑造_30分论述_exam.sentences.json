[
  {
    "id": "sent_1",
    "text": "《三国演义》 是中国古代第一部长篇章回体历史演义小说，",
    "start": 0.0,
    "end": 4.48,
    "duration": 4.48
  },
  {
    "id": "sent_2",
    "text": "开辟了中国古典小说“据史演义”的宏大传统。",
    "start": 4.929,
    "end": 8.289,
    "duration": 3.36
  },
  {
    "id": "sent_3",
    "text": "面对元末明初动荡不安的社会现实与人民对国家统一的渴求，",
    "start": 8.739,
    "end": 14.019,
    "duration": 5.28
  },
  {
    "id": "sent_4",
    "text": "罗贯中以陈寿 《三国志》 与裴松之注为基本史料框架，",
    "start": 14.469,
    "end": 18.629,
    "duration": 4.16
  },
  {
    "id": "sent_5",
    "text": "熔裁宋元民间讲史话本与戏曲积累，",
    "start": 19.079,
    "end": 22.039,
    "duration": 2.96
  },
  {
    "id": "sent_6",
    "text": "创造性地平衡了历史真实与艺术虚构的关系。",
    "start": 22.489,
    "end": 25.969,
    "duration": 3.48
  },
  {
    "id": "sent_7",
    "text": "章学诚在 《丙辰札记》 中精辟概括其特点为 “七分事态，",
    "start": 26.419,
    "end": 30.659,
    "duration": 4.24
  },
  {
    "id": "sent_8",
    "text": "三分虚构”。",
    "start": 31.109,
    "end": 32.109,
    "duration": 1.0
  },
  {
    "id": "sent_9",
    "text": "其虚实相生的叙事艺术与诸葛亮形象塑造，",
    "start": 32.559,
    "end": 36.199,
    "duration": 3.64
  },
  {
    "id": "sent_10",
    "text": "主要展现为以下四个核心维度：",
    "start": 36.649,
    "end": 39.169,
    "duration": 2.52
  },
  {
    "id": "sent_11",
    "text": "第一，确立“七分事实，三分虚构”的创作原则，",
    "start": 39.619,
    "end": 43.419,
    "duration": 3.8
  },
  {
    "id": "sent_12",
    "text": "达成历史规律与艺术传奇的有机统一。",
    "start": 43.869,
    "end": 46.869,
    "duration": 3.0
  },
  {
    "id": "sent_13",
    "text": "《三国演义》 严格遵循历史发展的基本脉络，",
    "start": 47.319,
    "end": 50.439,
    "duration": 3.12
  },
  {
    "id": "sent_14",
    "text": "三国鼎立的大局变迁、",
    "start": 50.889,
    "end": 52.729,
    "duration": 1.84
  },
  {
    "id": "sent_15",
    "text": "重大战役胜负与主要历史人物的生卒结局均据史直书，",
    "start": 53.179,
    "end": 57.699,
    "duration": 4.52
  },
  {
    "id": "sent_16",
    "text": "保持了历史演进的严肃逻辑。",
    "start": 58.149,
    "end": 60.349,
    "duration": 2.2
  },
  {
    "id": "sent_17",
    "text": "然而，作者绝不拘泥于史实细节的机械照搬，",
    "start": 60.799,
    "end": 64.479,
    "duration": 3.68
  },
  {
    "id": "sent_18",
    "text": "而是通过合情合理的虚构对历史缝隙进行艺术填充。",
    "start": 64.929,
    "end": 69.089,
    "duration": 4.16
  },
  {
    "id": "sent_19",
    "text": "例如 “关羽过五关斩六将”、“温酒斩华雄”、",
    "start": 69.539,
    "end": 72.819,
    "duration": 3.28
  },
  {
    "id": "sent_20",
    "text": "“草船借箭” 与 “借东风” 等脍炙人口的经典情节，",
    "start": 73.269,
    "end": 76.909,
    "duration": 3.64
  },
  {
    "id": "sent_21",
    "text": "多属艺术虚构或移花接木。",
    "start": 77.359,
    "end": 79.559,
    "duration": 2.2
  },
  {
    "id": "sent_22",
    "text": "这种虚实相生的笔法，既让读者深切把握历史兴亡的规律，",
    "start": 80.009,
    "end": 84.449,
    "duration": 4.44
  },
  {
    "id": "sent_23",
    "text": "又赋予了小说跌宕起伏的传奇色彩与文学感染力。",
    "start": 85.059,
    "end": 88.739,
    "duration": 3.68
  },
  {
    "id": "sent_24",
    "text": "第二，塑造“智绝”化身的诸葛亮形象，",
    "start": 89.189,
    "end": 92.149,
    "duration": 2.96
  },
  {
    "id": "sent_25",
    "text": "确立儒家贤相与智慧忠臣的至高典范。",
    "start": 92.599,
    "end": 95.679,
    "duration": 3.08
  },
  {
    "id": "sent_26",
    "text": "诸葛亮是全书倾注笔墨最多、形象最生动的核心人物。",
    "start": 96.209,
    "end": 100.569,
    "duration": 4.36
  },
  {
    "id": "sent_27",
    "text": "作者将其塑造为智慧与忠贞的高度综合体：在政治智慧上，",
    "start": 101.099,
    "end": 105.899,
    "duration": 4.8
  },
  {
    "id": "sent_28",
    "text": "他草庐对策即能预见天下三分大势；",
    "start": 106.349,
    "end": 109.269,
    "duration": 2.92
  },
  {
    "id": "sent_29",
    "text": "在外交军事谋略上，他舌战群儒、巧激周瑜、智算华容道、",
    "start": 109.719,
    "end": 114.479,
    "duration": 4.76
  },
  {
    "id": "sent_30",
    "text": "草船借箭，展现出运筹帷幄的卓越才华；",
    "start": 114.929,
    "end": 118.289,
    "duration": 3.36
  },
  {
    "id": "sent_31",
    "text": "在品格精神上，作者更是紧扣儒家伦理，突出其 “鞠躬尽瘁，",
    "start": 118.739,
    "end": 123.939,
    "duration": 5.2
  },
  {
    "id": "sent_32",
    "text": "死而后已” 的担当精神。",
    "start": 124.389,
    "end": 126.149,
    "duration": 1.76
  },
  {
    "id": "sent_33",
    "text": "尽管鲁迅曾评其 “状诸葛之多智而近妖”，",
    "start": 126.599,
    "end": 129.959,
    "duration": 3.36
  },
  {
    "id": "sent_34",
    "text": "指出了部分神魔化描写的夸饰失真，但不可否认，",
    "start": 130.409,
    "end": 134.289,
    "duration": 3.88
  },
  {
    "id": "sent_35",
    "text": "诸葛亮形象已成为中华民族忠诚智慧的集体文化原型。",
    "start": 134.819,
    "end": 139.219,
    "duration": 4.4
  },
  {
    "id": "sent_36",
    "text": "第三，长于全景式战争场面排布，",
    "start": 139.669,
    "end": 142.669,
    "duration": 3.0
  },
  {
    "id": "sent_37",
    "text": "在尖锐复杂的博弈中展开智谋较量。",
    "start": 143.119,
    "end": 146.039,
    "duration": 2.92
  },
  {
    "id": "sent_38",
    "text": "作为战争史诗巨制，",
    "start": 146.489,
    "end": 148.169,
    "duration": 1.68
  },
  {
    "id": "sent_39",
    "text": "《三国演义》 展现了极其高超的战争叙事功力。",
    "start": 148.619,
    "end": 152.059,
    "duration": 3.44
  },
  {
    "id": "sent_40",
    "text": "全书写了大小数十场战役，无一雷同。",
    "start": 152.589,
    "end": 155.829,
    "duration": 3.24
  },
  {
    "id": "sent_41",
    "text": "作者不仅写两军对垒的刀光剑影，",
    "start": 156.279,
    "end": 158.999,
    "duration": 2.72
  },
  {
    "id": "sent_42",
    "text": "更重在写战前各方势力的政治博弈、战略谋划与心理较量。",
    "start": 159.449,
    "end": 164.049,
    "duration": 4.6
  },
  {
    "id": "sent_43",
    "text": "在最具代表性的 “赤壁之战” 中，",
    "start": 164.499,
    "end": 166.779,
    "duration": 2.28
  },
  {
    "id": "sent_44",
    "text": "作者用大量篇幅铺垫蒋干中计、周瑜打黄盖、诸葛亮借箭、",
    "start": 167.229,
    "end": 171.709,
    "duration": 4.48
  },
  {
    "id": "sent_45",
    "text": "庞统献连环计等连环智谋，最终通过火烧赤壁达到矛盾总爆发；",
    "start": 172.239,
    "end": 177.399,
    "duration": 5.16
  },
  {
    "id": "sent_46",
    "text": "作者以多视角、多线索的宏阔笔触，深刻揭示了知己知彼、",
    "start": 177.848,
    "end": 182.528,
    "duration": 4.68
  },
  {
    "id": "sent_47",
    "text": "因势利导等深刻的辩证军事思想。",
    "start": 182.978,
    "end": 185.698,
    "duration": 2.72
  },
  {
    "id": "sent_48",
    "text": "第四，寄寓深切的“拥刘反曹”宗法观念，",
    "start": 186.148,
    "end": 189.468,
    "duration": 3.32
  },
  {
    "id": "sent_49",
    "text": "渗透天下分合的深刻历史哲学反思。",
    "start": 189.918,
    "end": 192.758,
    "duration": 2.84
  },
  {
    "id": "sent_50",
    "text": "在思想倾向层面，",
    "start": 193.328,
    "end": 194.848,
    "duration": 1.52
  },
  {
    "id": "sent_51",
    "text": "《三国演义》 鲜明贯彻了 “拥刘反曹” 的情感取向，",
    "start": 195.298,
    "end": 198.658,
    "duration": 3.36
  },
  {
    "id": "sent_52",
    "text": "借刘备集团的仁政仁德寄托人民反对残暴统治、",
    "start": 199.108,
    "end": 202.788,
    "duration": 3.68
  },
  {
    "id": "sent_53",
    "text": "渴求清明政治的美好愿望。",
    "start": 203.238,
    "end": 205.438,
    "duration": 2.2
  },
  {
    "id": "sent_54",
    "text": "同时，全书以 “天下大势，分久必合，合久必分” 统领全篇，",
    "start": 205.888,
    "end": 210.968,
    "duration": 5.08
  },
  {
    "id": "sent_55",
    "text": "卷首杨慎词 “滚滚长江东逝水，",
    "start": 211.418,
    "end": 214.058,
    "duration": 2.64
  },
  {
    "id": "sent_56",
    "text": "浪花淘尽英雄” 更是贯注着强烈的历史沧桑感。",
    "start": 214.588,
    "end": 218.348,
    "duration": 3.76
  },
  {
    "id": "sent_57",
    "text": "小说通过魏、蜀、吴三国的最终归晋，",
    "start": 218.798,
    "end": 221.758,
    "duration": 2.96
  },
  {
    "id": "sent_58",
    "text": "客观揭示了任何逆历史潮流的军阀纷争终将归于幻灭的深刻哲思。",
    "start": 222.208,
    "end": 227.448,
    "duration": 5.24
  }
]