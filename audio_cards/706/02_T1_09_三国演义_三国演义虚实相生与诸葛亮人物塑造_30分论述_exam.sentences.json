[
  {
    "id": 1,
    "text": "试论《三国演义》的“虚实相生”艺术与诸葛亮形象塑造。",
    "start": 0.134,
    "end": 3.946,
    "duration": 3.812
  },
  {
    "id": 2,
    "text": "《三国演义》是中国古代第一部长篇章回体历史演义小说，开辟了“据史演义”的小说传统。",
    "start": 4.623,
    "end": 11.355,
    "duration": 6.732
  },
  {
    "id": 3,
    "text": "罗贯中以陈寿《三国志》与裴松之注为历史框架，",
    "start": 12.073,
    "end": 15.685,
    "duration": 3.612
  },
  {
    "id": 4,
    "text": "熔裁宋元讲史话本与元代三国戏的民间积累，巧妙平衡了历史真实与艺术虚构的关系。",
    "start": 16.064,
    "end": 22.516,
    "duration": 6.452
  },
  {
    "id": 5,
    "text": "清代章学诚在《丙辰札记》中概括其特点为“七分事实，三分虚构”。",
    "start": 23.154,
    "end": 28.086,
    "duration": 4.932
  },
  {
    "id": 6,
    "text": "其虚实相生的叙事艺术与诸葛亮形象塑造，主要体现在以下四个方面：",
    "start": 29.604,
    "end": 40.936,
    "duration": 11.332
  },
  {
    "id": 7,
    "text": "第一，贯彻“七分事实，三分虚构”原则，以实托虚达成传奇与信史的统一。",
    "start": 41.654,
    "end": 51.146,
    "duration": 9.492
  },
  {
    "id": 8,
    "text": "《三国演义》遵循三国鼎立的历史大势，",
    "start": 51.824,
    "end": 55.516,
    "duration": 3.692
  },
  {
    "id": 9,
    "text": "重大战役胜负与主要历史人物的命运归宿均依傍史实基干，保持了演义正史的严肃脉络。",
    "start": 55.895,
    "end": 61.147,
    "duration": 5.252
  },
  {
    "id": 10,
    "text": "与此同时，作者并不拘泥于史料细节的机械照搬，",
    "start": 61.825,
    "end": 64.677,
    "duration": 2.852
  },
  {
    "id": 11,
    "text": "而是围绕美学理想对历史缝隙加以虚构生发，使实服从于虚。",
    "start": 65.056,
    "end": 69.468,
    "duration": 4.412
  },
  {
    "id": 12,
    "text": "例如“关羽过五关斩六将”“温酒斩华雄”“草船借箭”与“借东风”等经典情节，多属艺术虚构或移花接木。",
    "start": 70.106,
    "end": 76.438,
    "duration": 6.332
  },
  {
    "id": 13,
    "text": "这种虚实相生的笔法，既展现出历史兴亡的大局，又赋予小说跌宕起伏的传奇魅力。",
    "start": 77.076,
    "end": 82.328,
    "duration": 5.252
  },
  {
    "id": 14,
    "text": "第二，塑造“智绝”化身诸葛亮，树立儒家贤相与忠贞智慧典范。",
    "start": 83.046,
    "end": 87.658,
    "duration": 4.612
  },
  {
    "id": 15,
    "text": "诸葛亮是全书倾注理想最多的核心人物，集智慧与忠贞于一身。",
    "start": 88.376,
    "end": 92.348,
    "duration": 3.972
  },
  {
    "id": 16,
    "text": "在战略眼光上，他未出茅庐已能预见天下三分之势；",
    "start": 92.986,
    "end": 94.638,
    "duration": 1.652
  },
  {
    "id": 17,
    "text": "在外交与军事谋略上，他舌战群儒、巧激周瑜、草船借箭、空城退敌，展现出运筹帷幄的才华；",
    "start": 95.167,
    "end": 98.939,
    "duration": 3.772
  },
  {
    "id": 18,
    "text": "在道德品格上，作者紧扣儒家忠义伦理，凸显其“鞠躬尽瘁，死而后已”的担当精神。",
    "start": 99.468,
    "end": 101.36,
    "duration": 1.892
  },
  {
    "id": 19,
    "text": "尽管鲁迅曾批评其“状诸葛之多智而近妖”，指出了部分神化描写的夸饰之处，",
    "start": 102.038,
    "end": 112.41,
    "duration": 10.372
  },
  {
    "id": 20,
    "text": "诸葛亮形象依然成为古代文化中忠诚与智慧的经典化身。",
    "start": 112.925,
    "end": 120.057,
    "duration": 7.132
  },
  {
    "id": 21,
    "text": "第三，长于全景式战争叙事，在多方博弈中展开智谋与心理较量。",
    "start": 120.681,
    "end": 126.013,
    "duration": 5.332
  },
  {
    "id": 22,
    "text": "作为战争题材的章回巨制，《三国演义》在战争描写上技艺高超。",
    "start": 126.542,
    "end": 131.354,
    "duration": 4.812
  },
  {
    "id": 23,
    "text": "全书描写大小数十场战役，各具面貌而不雷同，既写战场厮杀的声势，更着重刻画战前各方势力的政治外交博弈与心理较量。",
    "start": 132.072,
    "end": 142.324,
    "duration": 10.252
  },
  {
    "id": 24,
    "text": "在代表性的“赤壁之战”中，作者以大量篇幅铺陈蒋干中计、周瑜打黄盖、诸葛亮借箭、庞统献连环计等连环谋略，",
    "start": 143.002,
    "end": 151.574,
    "duration": 8.572
  },
  {
    "id": 25,
    "text": "最终由火烧赤壁推向高潮，生动呈现出知己知彼、以弱胜强的战争智慧与辩证思维。",
    "start": 152.044,
    "end": 159.056,
    "duration": 7.012
  },
  {
    "id": 26,
    "text": "第四，贯注“拥刘反曹”道德倾向，渗透天下分合的沧桑之思。",
    "start": 159.792,
    "end": 164.444,
    "duration": 4.652
  },
  {
    "id": 27,
    "text": "在思想倾向上，《三国演义》鲜明体现出“拥刘反曹”的情感取向，借刘备集团的仁德宽厚寄托民众对清明政治的渴望。",
    "start": 165.162,
    "end": 173.774,
    "duration": 8.612
  },
  {
    "id": 28,
    "text": "同时，全书以“天下大势，分久必合，合久必分”统领兴衰，",
    "start": 174.452,
    "end": 179.184,
    "duration": 4.732
  },
  {
    "id": 29,
    "text": "清初毛纶、毛宗岗父子评改本更在卷首添置杨慎《临江仙》词“滚滚长江东逝水，浪花淘尽英雄”，",
    "start": 179.563,
    "end": 185.655,
    "duration": 6.092
  },
  {
    "id": 30,
    "text": "强化了深沉的历史沧桑感。",
    "start": 186.131,
    "end": 189.383,
    "duration": 3.252
  },
  {
    "id": 31,
    "text": "小说通过魏、蜀、吴三国终归于晋的结局，表达了对乱世纷争与英雄功业归于流逝的深长叹惋。",
    "start": 190.033,
    "end": 197.485,
    "duration": 7.452
  },
  {
    "id": 32,
    "text": "由是观之，《三国演义》依托“七分事实，三分虚构”的创作法则，",
    "start": 198.163,
    "end": 202.775,
    "duration": 4.612
  },
  {
    "id": 33,
    "text": "融通正史脉络与民间讲史传说，在波澜壮阔的战争博弈中塑造出诸葛亮等忠义智勇的艺术典型。",
    "start": 203.154,
    "end": 210.286,
    "duration": 7.132
  },
  {
    "id": 34,
    "text": "全书贯注“拥刘反曹”的民间道德理想与天下分合的历史沧桑感，",
    "start": 211.004,
    "end": 215.776,
    "duration": 4.772
  },
  {
    "id": 35,
    "text": "不仅确立了中国古代历史演义小说的体制规范，也深刻塑造了民族文化记忆中的忠义精神。",
    "start": 216.155,
    "end": 222.327,
    "duration": 6.172
  }
]