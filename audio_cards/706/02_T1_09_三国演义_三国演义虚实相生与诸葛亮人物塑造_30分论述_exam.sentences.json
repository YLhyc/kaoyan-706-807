[
  {
    "id": 1,
    "text": "试论《三国演义》的“虚实相生”艺术与诸葛亮形象塑造。",
    "start": 0.101,
    "end": 4.349,
    "duration": 4.248
  },
  {
    "id": 2,
    "text": "《三国演义》是中国古代第一部长篇章回体历史演义小说，",
    "start": 4.61,
    "end": 8.945,
    "duration": 4.335
  },
  {
    "id": 3,
    "text": "开辟了“据史演义”的小说传统。",
    "start": 9.305,
    "end": 11.351,
    "duration": 2.046
  },
  {
    "id": 4,
    "text": "罗贯中以陈寿《三国志》与裴松之注为历史框架，",
    "start": 11.818,
    "end": 15.681,
    "duration": 3.863
  },
  {
    "id": 5,
    "text": "熔裁宋元讲史话本与元代三国戏的民间积累，",
    "start": 16.121,
    "end": 19.882,
    "duration": 3.761
  },
  {
    "id": 6,
    "text": "巧妙平衡了历史真实与艺术虚构的关系。",
    "start": 20.198,
    "end": 23.619,
    "duration": 3.421
  },
  {
    "id": 7,
    "text": "清代章学诚在《丙辰札记》中概括其特点为“七分事实，",
    "start": 23.893,
    "end": 28.495,
    "duration": 4.602
  },
  {
    "id": 8,
    "text": "三分虚构”。",
    "start": 28.693,
    "end": 29.447,
    "duration": 0.754
  },
  {
    "id": 9,
    "text": "其虚实相生的叙事艺术与诸葛亮形象塑造，",
    "start": 29.742,
    "end": 33.458,
    "duration": 3.716
  },
  {
    "id": 10,
    "text": "主要体现在以下四个方面：",
    "start": 33.909,
    "end": 35.703,
    "duration": 1.794
  },
  {
    "id": 11,
    "text": "第一，贯彻“七分事实，三分虚构”原则，",
    "start": 36.334,
    "end": 39.757,
    "duration": 3.423
  },
  {
    "id": 12,
    "text": "以实托虚达成传奇与信史的统一。",
    "start": 39.992,
    "end": 42.892,
    "duration": 2.9
  },
  {
    "id": 13,
    "text": "《三国演义》遵循三国鼎立的历史大势，",
    "start": 43.222,
    "end": 45.787,
    "duration": 2.565
  },
  {
    "id": 14,
    "text": "重大战役胜负与主要历史人物的命运归宿均依傍史实基干，",
    "start": 45.95,
    "end": 50.596,
    "duration": 4.646
  },
  {
    "id": 15,
    "text": "保持了演义正史的严肃脉络。",
    "start": 50.852,
    "end": 52.851,
    "duration": 1.999
  },
  {
    "id": 16,
    "text": "与此同时，作者并不拘泥于史料细节的机械照搬，",
    "start": 53.288,
    "end": 56.857,
    "duration": 3.569
  },
  {
    "id": 17,
    "text": "而是围绕美学理想对历史缝隙加以虚构生发，使实服从于虚。",
    "start": 57.147,
    "end": 62.276,
    "duration": 5.129
  },
  {
    "id": 18,
    "text": "例如“关羽过五关斩六将”“温酒斩华雄”“草船借箭”与“借东风”等经典情节，",
    "start": 62.74,
    "end": 68.523,
    "duration": 5.783
  },
  {
    "id": 19,
    "text": "多属艺术虚构或移花接木。",
    "start": 68.648,
    "end": 70.752,
    "duration": 2.104
  },
  {
    "id": 20,
    "text": "这种虚实相生的笔法，既展现出历史兴亡的大局，",
    "start": 71.002,
    "end": 74.788,
    "duration": 3.786
  },
  {
    "id": 21,
    "text": "又赋予小说跌宕起伏的传奇魅力。",
    "start": 75.123,
    "end": 77.469,
    "duration": 2.346
  },
  {
    "id": 22,
    "text": "第二，塑造“智绝”化身诸葛亮，树立儒家贤相与忠贞智慧典范。",
    "start": 78.154,
    "end": 83.723,
    "duration": 5.569
  },
  {
    "id": 23,
    "text": "诸葛亮是全书倾注理想最多的核心人物，集智慧与忠贞于一身。",
    "start": 84.189,
    "end": 89.044,
    "duration": 4.855
  },
  {
    "id": 24,
    "text": "在战略眼光上，他未出茅庐已能预见天下三分之势；",
    "start": 89.449,
    "end": 93.574,
    "duration": 4.125
  },
  {
    "id": 25,
    "text": "在外交与军事谋略上，他舌战群儒、巧激周瑜、草船借箭、",
    "start": 94.077,
    "end": 99.04,
    "duration": 4.963
  },
  {
    "id": 26,
    "text": "空城退敌，展现出运筹帷幄的才华；在道德品格上，",
    "start": 99.268,
    "end": 103.804,
    "duration": 4.536
  },
  {
    "id": 27,
    "text": "作者紧扣儒家忠义伦理，凸显其“鞠躬尽瘁，",
    "start": 104.037,
    "end": 107.88,
    "duration": 3.843
  },
  {
    "id": 28,
    "text": "死而后已”的担当精神。",
    "start": 108.04,
    "end": 109.655,
    "duration": 1.615
  },
  {
    "id": 29,
    "text": "尽管鲁迅曾批评其“状诸葛之多智而近妖”，",
    "start": 109.927,
    "end": 113.412,
    "duration": 3.485
  },
  {
    "id": 30,
    "text": "指出了部分神化描写的夸饰之处，",
    "start": 113.792,
    "end": 116.281,
    "duration": 2.489
  },
  {
    "id": 31,
    "text": "诸葛亮形象依然成为古代文化中忠诚与智慧的经典化身。",
    "start": 116.909,
    "end": 121.701,
    "duration": 4.792
  },
  {
    "id": 32,
    "text": "第三，长于全景式战争叙事，在多方博弈中展开智谋与心理较量。",
    "start": 122.37,
    "end": 127.827,
    "duration": 5.457
  },
  {
    "id": 33,
    "text": "作为战争题材的章回巨制，《三国演义》在战争描写上技艺高超。",
    "start": 128.474,
    "end": 133.384,
    "duration": 4.91
  },
  {
    "id": 34,
    "text": "全书描写大小数十场战役，各具面貌而不雷同，",
    "start": 133.844,
    "end": 137.672,
    "duration": 3.828
  },
  {
    "id": 35,
    "text": "既写战场厮杀的声势，",
    "start": 138.053,
    "end": 139.641,
    "duration": 1.588
  },
  {
    "id": 36,
    "text": "更着重刻画战前各方势力的政治外交博弈与心理较量。",
    "start": 139.766,
    "end": 144.139,
    "duration": 4.373
  },
  {
    "id": 37,
    "text": "在代表性的“赤壁之战”中，作者以大量篇幅铺陈蒋干中计、",
    "start": 144.452,
    "end": 149.004,
    "duration": 4.552
  },
  {
    "id": 38,
    "text": "周瑜打黄盖、诸葛亮借箭、庞统献连环计等连环谋略，",
    "start": 149.347,
    "end": 153.547,
    "duration": 4.2
  },
  {
    "id": 39,
    "text": "最终由火烧赤壁推向高潮，生动呈现出知己知彼、",
    "start": 153.72,
    "end": 157.912,
    "duration": 4.192
  },
  {
    "id": 40,
    "text": "以弱胜强的战争智慧与辩证思维。",
    "start": 158.019,
    "end": 160.58,
    "duration": 2.561
  },
  {
    "id": 41,
    "text": "第四，贯注“拥刘反曹”道德倾向，渗透天下分合的沧桑之思。",
    "start": 161.233,
    "end": 166.139,
    "duration": 4.906
  },
  {
    "id": 42,
    "text": "在思想倾向上，",
    "start": 166.812,
    "end": 167.823,
    "duration": 1.011
  },
  {
    "id": 43,
    "text": "《三国演义》鲜明体现出“拥刘反曹”的情感取向，",
    "start": 168.122,
    "end": 171.346,
    "duration": 3.224
  },
  {
    "id": 44,
    "text": "借刘备集团的仁德宽厚寄托民众对清明政治的渴望。",
    "start": 171.74,
    "end": 175.61,
    "duration": 3.87
  },
  {
    "id": 45,
    "text": "同时，全书以“天下大势，分久必合，合久必分”统领兴衰，",
    "start": 176.152,
    "end": 180.281,
    "duration": 4.129
  },
  {
    "id": 46,
    "text": "清初毛纶、",
    "start": 180.501,
    "end": 181.431,
    "duration": 0.93
  },
  {
    "id": 47,
    "text": "毛宗岗父子评改本更在卷首添置杨慎《临江仙》词“滚滚长江东逝水，",
    "start": 181.708,
    "end": 188.175,
    "duration": 6.467
  },
  {
    "id": 48,
    "text": "浪花淘尽英雄”，强化了深沉的历史沧桑感。",
    "start": 188.544,
    "end": 192.157,
    "duration": 3.613
  },
  {
    "id": 49,
    "text": "小说通过魏、蜀、吴三国终归于晋的结局，",
    "start": 192.487,
    "end": 196.024,
    "duration": 3.537
  },
  {
    "id": 50,
    "text": "表达了对乱世纷争与英雄功业归于流逝的深长叹惋。",
    "start": 196.403,
    "end": 200.846,
    "duration": 4.443
  }
]