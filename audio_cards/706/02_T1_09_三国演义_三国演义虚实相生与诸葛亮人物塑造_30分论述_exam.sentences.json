[
  {
    "id": 1,
    "text": "试论《三国演义》的“虚实相生”艺术与诸葛亮形象塑造。",
    "start": 0.28,
    "end": 4.36,
    "duration": 4.08
  },
  {
    "id": 2,
    "text": "《三国演义》是中国古代第一部长篇章回体历史演义小说，开辟了“据史演义”的小说传统。",
    "start": 4.88,
    "end": 12.48,
    "duration": 7.6
  },
  {
    "id": 3,
    "text": "罗贯中以陈寿《三国志》与裴松之注为历史框架，",
    "start": 13.0,
    "end": 17.08,
    "duration": 4.08
  },
  {
    "id": 4,
    "text": "熔裁宋元讲史话本与元代三国戏的民间积累，巧妙平衡了历史真实与艺术虚构的关系。",
    "start": 17.45,
    "end": 25.29,
    "duration": 7.84
  },
  {
    "id": 5,
    "text": "清代章学诚在《丙辰札记》中概括其特点为“七分事实，三分虚构”。",
    "start": 25.81,
    "end": 31.57,
    "duration": 5.76
  },
  {
    "id": 6,
    "text": "其虚实相生的叙事艺术与诸葛亮形象塑造，主要体现在以下四个方面：",
    "start": 32.09,
    "end": 37.85,
    "duration": 5.76
  },
  {
    "id": 7,
    "text": "第一，贯彻“七分事实，三分虚构”原则，以实托虚达成传奇与信史的统一。",
    "start": 38.22,
    "end": 44.38,
    "duration": 6.16
  },
  {
    "id": 8,
    "text": "《三国演义》遵循三国鼎立的历史大势，",
    "start": 44.9,
    "end": 48.015,
    "duration": 3.115
  },
  {
    "id": 9,
    "text": "重大战役胜负与主要历史人物的命运归宿均依傍史实基干，保持了演义正史的严肃脉络。",
    "start": 48.385,
    "end": 56.07,
    "duration": 7.685
  },
  {
    "id": 10,
    "text": "与此同时，作者并不拘泥于史料细节的机械照搬，",
    "start": 56.59,
    "end": 60.59,
    "duration": 4.0
  },
  {
    "id": 11,
    "text": "而是围绕美学理想对历史缝隙加以虚构生发，使实服从于虚。",
    "start": 60.96,
    "end": 65.92,
    "duration": 4.96
  },
  {
    "id": 12,
    "text": "例如“关羽过五关斩六将”“温酒斩华雄”“草船借箭”与“借东风”等经典情节，多属艺术虚构或移花接木。",
    "start": 66.44,
    "end": 74.52,
    "duration": 8.08
  },
  {
    "id": 13,
    "text": "这种虚实相生的笔法，既展现出历史兴亡的大局，又赋予小说跌宕起伏的传奇魅力。",
    "start": 75.04,
    "end": 81.84,
    "duration": 6.8
  },
  {
    "id": 14,
    "text": "第二，塑造“智绝”化身诸葛亮，树立儒家贤相与忠贞智慧典范。",
    "start": 82.36,
    "end": 87.8,
    "duration": 5.44
  },
  {
    "id": 15,
    "text": "诸葛亮是全书倾注理想最多的核心人物，集智慧与忠贞于一身。",
    "start": 88.32,
    "end": 93.36,
    "duration": 5.04
  },
  {
    "id": 16,
    "text": "在战略眼光上，他未出茅庐已能预见天下三分之势；",
    "start": 93.88,
    "end": 98.04,
    "duration": 4.16
  },
  {
    "id": 17,
    "text": "在外交与军事谋略上，他舌战群儒、巧激周瑜、草船借箭、空城退敌，展现出运筹帷幄的才华；",
    "start": 98.56,
    "end": 106.72,
    "duration": 8.16
  },
  {
    "id": 18,
    "text": "在道德品格上，作者紧扣儒家忠义伦理，凸显其“鞠躬尽瘁，死而后已”的担当精神。",
    "start": 107.24,
    "end": 113.8,
    "duration": 6.56
  },
  {
    "id": 19,
    "text": "尽管鲁迅曾批评其“状诸葛之多智而近妖”，指出了部分神化描写的夸饰之处，",
    "start": 114.32,
    "end": 120.77,
    "duration": 6.45
  },
  {
    "id": 20,
    "text": "诸葛亮形象依然成为古代文化中忠诚与智慧的经典化身。",
    "start": 121.33,
    "end": 126.13,
    "duration": 4.8
  },
  {
    "id": 21,
    "text": "第三，长于全景式战争叙事，在多方博弈中展开智谋与心理较量。",
    "start": 126.65,
    "end": 132.57,
    "duration": 5.92
  },
  {
    "id": 22,
    "text": "作为战争题材的章回巨制，《三国演义》在战争描写上技艺高超。",
    "start": 133.09,
    "end": 138.21,
    "duration": 5.12
  },
  {
    "id": 23,
    "text": "全书描写大小数十场战役，各具面貌而不雷同，既写战场厮杀的声势，更着重刻画战前各方势力的政治外交博弈与心理较量。",
    "start": 138.785,
    "end": 149.384,
    "duration": 10.599
  },
  {
    "id": 24,
    "text": "在代表性的“赤壁之战”中，作者以大量篇幅铺陈蒋干中计、周瑜打黄盖、诸葛亮借箭、庞统献连环计等连环谋略，",
    "start": 149.884,
    "end": 159.035,
    "duration": 9.151
  },
  {
    "id": 25,
    "text": "最终由火烧赤壁推向高潮，生动呈现出知己知彼、以弱胜强的战争智慧与辩证思维。",
    "start": 159.405,
    "end": 166.365,
    "duration": 6.96
  },
  {
    "id": 26,
    "text": "第四，贯注“拥刘反曹”道德倾向，渗透天下分合的沧桑之思。",
    "start": 166.885,
    "end": 171.925,
    "duration": 5.04
  },
  {
    "id": 27,
    "text": "在思想倾向上，《三国演义》鲜明体现出“拥刘反曹”的情感取向，借刘备集团的仁德宽厚寄托民众对清明政治的渴望。",
    "start": 172.445,
    "end": 181.245,
    "duration": 8.8
  },
  {
    "id": 28,
    "text": "同时，全书以“天下大势，分久必合，合久必分”统领兴衰，",
    "start": 181.765,
    "end": 187.365,
    "duration": 5.6
  },
  {
    "id": 29,
    "text": "清初毛纶、毛宗岗父子评改本更在卷首添置杨慎《临江仙》词“滚滚长江东逝水，浪花淘尽英雄”，",
    "start": 187.735,
    "end": 196.055,
    "duration": 8.32
  },
  {
    "id": 30,
    "text": "强化了深沉的历史沧桑感。",
    "start": 196.425,
    "end": 198.414,
    "duration": 1.989
  },
  {
    "id": 31,
    "text": "小说通过魏、蜀、吴三国终归于晋的结局，表达了对乱世纷争与英雄功业归于流逝的深长叹惋。",
    "start": 198.914,
    "end": 207.111,
    "duration": 8.197
  },
  {
    "id": 32,
    "text": "由是观之，《三国演义》依托“七分事实，三分虚构”的创作法则，",
    "start": 207.611,
    "end": 212.505,
    "duration": 4.894
  },
  {
    "id": 33,
    "text": "融通正史脉络与民间讲史传说，在波澜壮阔的战争博弈中塑造出诸葛亮等忠义智勇的艺术典型。",
    "start": 212.875,
    "end": 221.275,
    "duration": 8.4
  },
  {
    "id": 34,
    "text": "全书贯注“拥刘反曹”的民间道德理想与天下分合的历史沧桑感，",
    "start": 221.795,
    "end": 226.595,
    "duration": 4.8
  },
  {
    "id": 35,
    "text": "不仅确立了中国古代历史演义小说的体制规范，也深刻塑造了民族文化记忆中的忠义精神。",
    "start": 226.965,
    "end": 233.605,
    "duration": 6.64
  }
]
