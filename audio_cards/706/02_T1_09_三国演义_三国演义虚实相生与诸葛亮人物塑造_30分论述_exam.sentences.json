[
  {
    "id": "sent_1",
    "text": "《三国演义》 是中国古代第一部长篇章回体历史演义小说，",
    "start": 0.1,
    "end": 5.428,
    "duration": 5.328
  },
  {
    "id": "sent_2",
    "text": "开辟了中国古典小说“据史演义”的宏大传统。",
    "start": 5.378,
    "end": 9.506,
    "duration": 4.128
  },
  {
    "id": "sent_3",
    "text": "面对元末明初动荡不安的社会现实与人民对国家统一的渴求，",
    "start": 9.505,
    "end": 15.586,
    "duration": 6.081
  },
  {
    "id": "sent_4",
    "text": "罗贯中以陈寿 《三国志》 与裴松之注为基本史料框架，",
    "start": 15.586,
    "end": 20.742,
    "duration": 5.156
  },
  {
    "id": "sent_5",
    "text": "熔裁宋元民间讲史话本与戏曲积累，",
    "start": 20.742,
    "end": 24.596,
    "duration": 3.854
  },
  {
    "id": "sent_6",
    "text": "创造性地平衡了历史真实与艺术虚构的关系。",
    "start": 24.596,
    "end": 28.789,
    "duration": 4.193
  },
  {
    "id": "sent_7",
    "text": "章学诚在 《丙辰札记》 中精辟概括其特点为 “七分事态，",
    "start": 28.789,
    "end": 33.971,
    "duration": 5.182
  },
  {
    "id": "sent_8",
    "text": "三分虚构”。",
    "start": 33.971,
    "end": 35.416,
    "duration": 1.445
  },
  {
    "id": "sent_9",
    "text": "其虚实相生的叙事艺术与诸葛亮形象塑造，",
    "start": 35.417,
    "end": 39.623,
    "duration": 4.206
  },
  {
    "id": "sent_10",
    "text": "主要展现为以下四个核心维度：",
    "start": 39.622,
    "end": 42.929,
    "duration": 3.307
  },
  {
    "id": "sent_11",
    "text": "第一，确立“七分事实，三分虚构”的创作原则，",
    "start": 42.93,
    "end": 47.344,
    "duration": 4.414
  },
  {
    "id": "sent_12",
    "text": "达成历史规律与艺术传奇的有机统一。",
    "start": 47.344,
    "end": 51.107,
    "duration": 3.763
  },
  {
    "id": "sent_13",
    "text": "《三国演义》 严格遵循历史发展的基本脉络，",
    "start": 51.107,
    "end": 55.169,
    "duration": 4.062
  },
  {
    "id": "sent_14",
    "text": "三国鼎立的大局变迁、重大战役胜负与主要历史人物的生卒结局均据史直书，",
    "start": 55.169,
    "end": 62.682,
    "duration": 7.513
  },
  {
    "id": "sent_15",
    "text": "保持了历史演进的严肃逻辑。",
    "start": 62.682,
    "end": 65.534,
    "duration": 2.852
  },
  {
    "id": "sent_16",
    "text": "然而，作者绝不拘泥于史实细节的机械照搬，",
    "start": 65.534,
    "end": 69.688,
    "duration": 4.154
  },
  {
    "id": "sent_17",
    "text": "而是通过合情合理的虚构对历史缝隙进行艺术填充。",
    "start": 69.688,
    "end": 74.805,
    "duration": 5.117
  },
  {
    "id": "sent_18",
    "text": "例如 “关羽过五关斩六将”、“温酒斩华雄”、“草船借箭” 与 “借东风” 等脍炙人口的经典情节，",
    "start": 74.804,
    "end": 82.591,
    "duration": 7.787
  },
  {
    "id": "sent_19",
    "text": "多属艺术虚构或移花接木。",
    "start": 82.591,
    "end": 85.469,
    "duration": 2.878
  },
  {
    "id": "sent_20",
    "text": "这种虚实相生的笔法，既让读者深切把握历史兴亡的规律，",
    "start": 85.469,
    "end": 91.159,
    "duration": 5.69
  },
  {
    "id": "sent_21",
    "text": "又赋予了小说跌宕起伏的传奇色彩与文学感染力。",
    "start": 91.159,
    "end": 95.86,
    "duration": 4.701
  },
  {
    "id": "sent_22",
    "text": "第二，塑造“智绝”化身的诸葛亮形象，",
    "start": 95.859,
    "end": 99.362,
    "duration": 3.503
  },
  {
    "id": "sent_23",
    "text": "确立儒家贤相与智慧忠臣的至高典范。",
    "start": 99.362,
    "end": 103.49,
    "duration": 4.128
  },
  {
    "id": "sent_24",
    "text": "诸葛亮是全书倾注笔墨最多、形象最生动的核心人物。",
    "start": 103.49,
    "end": 108.555,
    "duration": 5.065
  },
  {
    "id": "sent_25",
    "text": "作者将其塑造为智慧与忠贞的高度综合体：在政治智慧上，",
    "start": 108.555,
    "end": 114.154,
    "duration": 5.599
  },
  {
    "id": "sent_26",
    "text": "他草庐对策即能预见天下三分大势；",
    "start": 114.154,
    "end": 117.813,
    "duration": 3.659
  },
  {
    "id": "sent_27",
    "text": "在外交军事谋略上，他舌战群儒、巧激周瑜、智算华容道、草船借箭，",
    "start": 117.813,
    "end": 124.584,
    "duration": 6.771
  },
  {
    "id": "sent_28",
    "text": "展现出运筹帷幄的卓越才华；",
    "start": 124.583,
    "end": 127.682,
    "duration": 3.099
  },
  {
    "id": "sent_29",
    "text": "在品格精神上，作者更是紧扣儒家伦理，突出其 “鞠躬尽瘁，",
    "start": 127.682,
    "end": 133.879,
    "duration": 6.197
  },
  {
    "id": "sent_30",
    "text": "死而后已” 的担当精神。",
    "start": 133.88,
    "end": 136.263,
    "duration": 2.383
  },
  {
    "id": "sent_31",
    "text": "尽管鲁迅曾评其 “状诸葛之多智而近妖”，",
    "start": 136.263,
    "end": 140.442,
    "duration": 4.179
  },
  {
    "id": "sent_32",
    "text": "指出了部分神魔化描写的夸饰失真，但不可否认，",
    "start": 140.442,
    "end": 144.909,
    "duration": 4.467
  },
  {
    "id": "sent_33",
    "text": "诸葛亮形象已成为中华民族忠诚智慧的集体文化原型。",
    "start": 144.909,
    "end": 149.922,
    "duration": 5.013
  },
  {
    "id": "sent_34",
    "text": "第三，长于全景式战争场面排布，在尖锐复杂的博弈中展开智谋较量。",
    "start": 149.922,
    "end": 156.589,
    "duration": 6.667
  },
  {
    "id": "sent_35",
    "text": "作为战争史诗巨制，《三国演义》 展现了极其高超的战争叙事功力。",
    "start": 156.589,
    "end": 162.461,
    "duration": 5.872
  },
  {
    "id": "sent_36",
    "text": "全书写了大小数十场战役，无一雷同。",
    "start": 162.461,
    "end": 166.237,
    "duration": 3.776
  },
  {
    "id": "sent_37",
    "text": "作者不仅写两军对垒的刀光剑影，",
    "start": 166.237,
    "end": 169.675,
    "duration": 3.438
  },
  {
    "id": "sent_38",
    "text": "更重在写战前各方势力的政治博弈、战略谋划与心理较量。",
    "start": 169.674,
    "end": 175.259,
    "duration": 5.585
  },
  {
    "id": "sent_39",
    "text": "在最具代表性的 “赤壁之战” 中，",
    "start": 175.26,
    "end": 178.151,
    "duration": 2.891
  },
  {
    "id": "sent_40",
    "text": "作者用大量篇幅铺垫蒋干中计、周瑜打黄盖、诸葛亮借箭、庞统献连环计等连环智谋，",
    "start": 178.151,
    "end": 186.484,
    "duration": 8.333
  },
  {
    "id": "sent_41",
    "text": "最终通过火烧赤壁达到矛盾总爆发；",
    "start": 186.484,
    "end": 190.117,
    "duration": 3.633
  },
  {
    "id": "sent_42",
    "text": "作者以多视角、多线索的宏阔笔触，",
    "start": 190.117,
    "end": 193.685,
    "duration": 3.568
  },
  {
    "id": "sent_43",
    "text": "深刻揭示了知己知彼、因势利导等深刻的辩证军事思想。",
    "start": 193.685,
    "end": 199.349,
    "duration": 5.664
  },
  {
    "id": "sent_44",
    "text": "第四，寄寓深切的“拥刘反曹”宗法观念，",
    "start": 199.349,
    "end": 203.19,
    "duration": 3.841
  },
  {
    "id": "sent_45",
    "text": "渗透天下分合的深刻历史哲学反思。",
    "start": 203.19,
    "end": 206.771,
    "duration": 3.581
  },
  {
    "id": "sent_46",
    "text": "在思想倾向层面，",
    "start": 206.771,
    "end": 208.945,
    "duration": 2.174
  },
  {
    "id": "sent_47",
    "text": "《三国演义》 鲜明贯彻了 “拥刘反曹” 的情感取向，",
    "start": 208.945,
    "end": 213.268,
    "duration": 4.323
  },
  {
    "id": "sent_48",
    "text": "借刘备集团的仁政仁德寄托人民反对残暴统治、渴求清明政治的美好愿望。",
    "start": 213.268,
    "end": 220.234,
    "duration": 6.966
  },
  {
    "id": "sent_49",
    "text": "同时，全书以 “天下大势，分久必合，合久必分” 统领全篇，",
    "start": 220.234,
    "end": 226.054,
    "duration": 5.82
  },
  {
    "id": "sent_50",
    "text": "卷首杨慎词 “滚滚长江东逝水，",
    "start": 226.055,
    "end": 229.571,
    "duration": 3.516
  },
  {
    "id": "sent_51",
    "text": "浪花淘尽英雄” 更是贯注着强烈的历史沧桑感。",
    "start": 229.57,
    "end": 234.271,
    "duration": 4.701
  },
  {
    "id": "sent_52",
    "text": "小说通过魏、蜀、吴三国的最终归晋，",
    "start": 234.271,
    "end": 238.516,
    "duration": 4.245
  },
  {
    "id": "sent_53",
    "text": "客观揭示了任何逆历史潮流的军阀纷争终将归于幻灭的深刻哲思。",
    "start": 238.516,
    "end": 245.013,
    "duration": 6.497
  }
]