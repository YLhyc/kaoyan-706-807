[
  {
    "id": 1,
    "text": "题型，三十分论述题。",
    "start": 0.08,
    "end": 1.898,
    "duration": 1.818
  },
  {
    "id": 2,
    "text": "分值，三十分。",
    "start": 1.898,
    "end": 3.025,
    "duration": 1.127
  },
  {
    "id": 3,
    "text": "建议考场时间，三十五分钟。",
    "start": 3.025,
    "end": 5.504,
    "duration": 2.479
  },
  {
    "id": 4,
    "text": "目标字数，一千一百五十到一千三百字。",
    "start": 5.504,
    "end": 9.11,
    "duration": 3.606
  },
  {
    "id": 5,
    "text": "答题骨架，双璧源头定性、趋近于、",
    "start": 9.11,
    "end": 12.04,
    "duration": 2.93
  },
  {
    "id": 6,
    "text": "精神内核与人格追求之对比、趋近于、",
    "start": 12.04,
    "end": 15.421,
    "duration": 3.381
  },
  {
    "id": 7,
    "text": "艺术造境与象征意象之异同、趋近于、",
    "start": 15.421,
    "end": 18.802,
    "duration": 3.381
  },
  {
    "id": 8,
    "text": "文体建构与语言风格之分野、趋近于、",
    "start": 18.802,
    "end": 22.182,
    "duration": 3.38
  },
  {
    "id": 9,
    "text": "宏观文学史总结。",
    "start": 22.182,
    "end": 23.76,
    "duration": 1.578
  },
  {
    "id": 10,
    "text": "庄子与屈原是中国先秦浪漫主义文学的两大巍峨源头，",
    "start": 23.84,
    "end": 28.24,
    "duration": 4.4
  },
  {
    "id": 11,
    "text": "共同构成了楚地文化孕育出的精神双璧。",
    "start": 28.24,
    "end": 31.44,
    "duration": 3.2
  },
  {
    "id": 12,
    "text": "两者不仅以极其宏肆奇幻的想象力打破了先秦北方中原文学的现实规约，",
    "start": 31.44,
    "end": 37.28,
    "duration": 5.84
  },
  {
    "id": 13,
    "text": "更在精神品格、象征造境与文体创新上呈现出同源异流的壮阔景观。",
    "start": 37.28,
    "end": 43.28,
    "duration": 6.0
  },
  {
    "id": 14,
    "text": "第一，在思想精神与主体人格品格上，",
    "start": 43.52,
    "end": 47.2,
    "duration": 3.68
  },
  {
    "id": 15,
    "text": "庄子追求超脱世俗的绝对精神自由，",
    "start": 47.2,
    "end": 50.16,
    "duration": 2.96
  },
  {
    "id": 16,
    "text": "屈原则坚守九死不悔的家国情怀与悲壮抗争。",
    "start": 50.16,
    "end": 54.0,
    "duration": 3.84
  },
  {
    "id": 17,
    "text": "庄子身处战国中后期纷争乱世，深感现实体制对个体生命的异化与摧残，",
    "start": 54.0,
    "end": 60.08,
    "duration": 6.08
  },
  {
    "id": 18,
    "text": "因而主张“安时而处顺”，追求“乘天地之正，",
    "start": 60.08,
    "end": 63.92,
    "duration": 3.84
  },
  {
    "id": 19,
    "text": "而御六气之辩”的逍遥游境界。",
    "start": 63.92,
    "end": 66.56,
    "duration": 2.64
  },
  {
    "id": 20,
    "text": "他在《逍遥游》中借大鹏抟扶摇而上九万里的阔大境界，",
    "start": 66.8,
    "end": 71.44,
    "duration": 4.64
  },
  {
    "id": 21,
    "text": "展现对世俗名利羁绊的彻底扬弃，将精神安顿于超然物外的天地自然之中。",
    "start": 71.44,
    "end": 78.64,
    "duration": 7.2
  },
  {
    "id": 22,
    "text": "屈原则深植于楚国宗法贵族政治的血缘伦理，",
    "start": 78.64,
    "end": 82.72,
    "duration": 4.08
  },
  {
    "id": 23,
    "text": "将个人命运与楚国兴衰紧密维系。",
    "start": 82.72,
    "end": 85.92,
    "duration": 3.2
  },
  {
    "id": 24,
    "text": "面对楚怀王之昏庸与令尹子兰之缠毁，",
    "start": 85.92,
    "end": 89.52,
    "duration": 3.6
  },
  {
    "id": 25,
    "text": "屈原在《离骚》中毅然发出“亦余心之所善兮，",
    "start": 89.52,
    "end": 93.68,
    "duration": 4.16
  },
  {
    "id": 26,
    "text": "虽九死其犹未悔”的决绝誓言，宁可怀石自沉汨罗江也绝不同流合污，",
    "start": 93.68,
    "end": 100.4,
    "duration": 6.72
  },
  {
    "id": 27,
    "text": "展现出沉痛刚烈的人格力量与深沉的家国忧患。",
    "start": 100.4,
    "end": 104.64,
    "duration": 4.24
  },
  {
    "id": 28,
    "text": "第二，在艺术造境与浪漫主义象征意象上，",
    "start": 104.864,
    "end": 108.544,
    "duration": 3.68
  },
  {
    "id": 29,
    "text": "庄子长于打破万物物我界限的寓言造境，",
    "start": 108.544,
    "end": 112.064,
    "duration": 3.52
  },
  {
    "id": 30,
    "text": "屈原则构建了寄托政治品格与道德洁癖的香草美人意象系统。",
    "start": 112.064,
    "end": 117.344,
    "duration": 5.28
  },
  {
    "id": 31,
    "text": "庄子的想象具有强烈的解构色彩与泛神论倾向。",
    "start": 117.344,
    "end": 121.504,
    "duration": 4.16
  },
  {
    "id": 32,
    "text": "他突破现实世界的时空与形体限制，",
    "start": 121.504,
    "end": 124.384,
    "duration": 2.88
  },
  {
    "id": 33,
    "text": "让大椿、冥灵、姑射神人与混沌交织并存。",
    "start": 124.384,
    "end": 128.144,
    "duration": 3.76
  },
  {
    "id": 34,
    "text": "在《齐物论》的“庄周梦蝶”中，庄子膜糊了人与蝶、",
    "start": 128.544,
    "end": 132.544,
    "duration": 4.0
  },
  {
    "id": 35,
    "text": "虚与实的绝对界限，以“物化”的精妙造境诠释了齐万物、",
    "start": 132.544,
    "end": 137.344,
    "duration": 4.8
  },
  {
    "id": 36,
    "text": "等生死的深刻哲理。",
    "start": 137.344,
    "end": 139.024,
    "duration": 1.68
  },
  {
    "id": 37,
    "text": "屈原的浪漫主义想象则始终与现实政治道德紧密咬合。",
    "start": 139.024,
    "end": 143.584,
    "duration": 4.56
  },
  {
    "id": 38,
    "text": "屈原在《离骚》中不仅上天下地、周流六合以叩击天婚，",
    "start": 143.584,
    "end": 148.384,
    "duration": 4.8
  },
  {
    "id": 39,
    "text": "更开创性地运用“香草美人”的寄托手法。",
    "start": 148.384,
    "end": 151.744,
    "duration": 3.36
  },
  {
    "id": 40,
    "text": "诗人以江离、辟芷象征纯洁品德，以恶草椒兰象征缠邪奸佞，",
    "start": 152.064,
    "end": 157.904,
    "duration": 5.84
  },
  {
    "id": 41,
    "text": "以求女象征对贤君与明政的追求，将飞腾的神话想象完全熔铸于现实政治悲剧的深沉开掘之中。",
    "start": 157.904,
    "end": 166.384,
    "duration": 8.48
  },
  {
    "id": 42,
    "text": "第三，在文体建构与语言美学形态上，",
    "start": 166.384,
    "end": 169.664,
    "duration": 3.28
  },
  {
    "id": 43,
    "text": "庄子散文展现了汪洋恣肆、行云流水的智性风范，",
    "start": 169.664,
    "end": 173.824,
    "duration": 4.16
  },
  {
    "id": 44,
    "text": "屈原楚辞则奠定了句式铺排、沉郁幽艳的抒情诗体范式。",
    "start": 173.824,
    "end": 178.624,
    "duration": 4.8
  },
  {
    "id": 45,
    "text": "庄子散文“以谬悠之说，荒唐之言，",
    "start": 178.944,
    "end": 182.224,
    "duration": 3.28
  },
  {
    "id": 46,
    "text": "无端崖之辞”自居，通篇采用“寓言”、",
    "start": 182.224,
    "end": 185.824,
    "duration": 3.6
  },
  {
    "id": 47,
    "text": "“重言”与“之言”相互生发的开放式叙事结构，",
    "start": 185.824,
    "end": 189.664,
    "duration": 3.84
  },
  {
    "id": 48,
    "text": "语言奇变跌宕，文气如长风卷浪，极具思辨爆发力。",
    "start": 189.664,
    "end": 194.464,
    "duration": 4.8
  },
  {
    "id": 49,
    "text": "屈原楚辞则打破了《诗经》四言为主的短促节律，",
    "start": 194.624,
    "end": 198.544,
    "duration": 3.92
  },
  {
    "id": 50,
    "text": "大量吸收楚地民间巫风歌谣的语言养分，",
    "start": 198.544,
    "end": 201.824,
    "duration": 3.28
  },
  {
    "id": 51,
    "text": "创造出长短错落、参差多变的骚体诗形制。",
    "start": 201.824,
    "end": 205.744,
    "duration": 3.92
  },
  {
    "id": 52,
    "text": "屈原灵活运用“兮”字调控气息节奏，",
    "start": 206.064,
    "end": 209.344,
    "duration": 3.28
  },
  {
    "id": 53,
    "text": "句法铺排繁密，字句幽美峻洁，融神话传说、",
    "start": 209.344,
    "end": 214.224,
    "duration": 4.88
  },
  {
    "id": 54,
    "text": "历史典故与楚地方言于一炉，形成了音韵铿枪、",
    "start": 214.224,
    "end": 219.024,
    "duration": 4.8
  },
  {
    "id": 55,
    "text": "情辞并茂的悲剧抒情长调。",
    "start": 219.024,
    "end": 221.664,
    "duration": 2.64
  },
  {
    "id": 56,
    "text": "综上所述，庄子以其超然物外的出世哲学与奇诡超拔的寓言散文，",
    "start": 221.664,
    "end": 227.744,
    "duration": 6.08
  },
  {
    "id": 57,
    "text": "确立了中国文学追求心灵解放与自然自足的超逸传统。",
    "start": 227.744,
    "end": 232.864,
    "duration": 5.12
  },
  {
    "id": 58,
    "text": "屈原则以其殉身家国的政治执着与瑰丽悲壮的骚体辞赋，",
    "start": 233.184,
    "end": 238.384,
    "duration": 5.2
  },
  {
    "id": 59,
    "text": "铸就了中国士人忧国恤民与峻洁自持的崇高悲剧力量。",
    "start": 238.384,
    "end": 243.504,
    "duration": 5.12
  },
  {
    "id": 60,
    "text": "两者交相辉映，共同奠定了中国古典浪漫主义文学的坚固基石。",
    "start": 243.504,
    "end": 248.464,
    "duration": 4.96
  }
]