[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 2.88,
    "duration": 2.8
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 2.88,
    "end": 5.76,
    "duration": 2.88
  },
  {
    "id": 3,
    "text": "这道题考查古代汉语文字学史的核心母题。",
    "start": 5.76,
    "end": 9.04,
    "duration": 3.28
  },
  {
    "id": 4,
    "text": "在考场上，考生不能简单堆砌四人名字，",
    "start": 9.04,
    "end": 11.84,
    "duration": 2.8
  },
  {
    "id": 5,
    "text": "而必须紧扣“许慎的原初体例创见”与“清代学者的承继开掘”两条逻辑线索。",
    "start": 11.84,
    "end": 17.84,
    "duration": 6.0
  },
  {
    "id": 6,
    "text": "核心在于回答：许慎建立了怎样的字典体例，",
    "start": 18.08,
    "end": 21.6,
    "duration": 3.52
  },
  {
    "id": 7,
    "text": "而清代说文四大家又分别从哪一个独特的切入点将这一体例发扬光大。",
    "start": 21.6,
    "end": 27.12,
    "duration": 5.52
  },
  {
    "id": 8,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 27.12,
    "end": 29.92,
    "duration": 2.8
  },
  {
    "id": 9,
    "text": "答题必须摆脱死记硬背的罗列感，建立由“原著经典价值”到“后世学术发皇”的历史演进逻辑。",
    "start": 29.92,
    "end": 36.8,
    "duration": 6.88
  },
  {
    "id": 10,
    "text": "前半部分从字典学、形义学与六书分析三个层面剖析许书体例，",
    "start": 37.2,
    "end": 42.64,
    "duration": 5.44
  },
  {
    "id": 11,
    "text": "后半部分从训诂引申、文献实证、构形规则与音义系统四条学术路径准确定位四大家的具体贡献。",
    "start": 42.64,
    "end": 50.72,
    "duration": 8.08
  },
  {
    "id": 12,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 50.72,
    "end": 53.68,
    "duration": 2.96
  },
  {
    "id": 13,
    "text": "全题分为四个核心论述维度：-第一维度：界定《说文解字》在中国语言文字学史上的开创性坐标；",
    "start": 53.68,
    "end": 61.755,
    "duration": 8.075
  },
  {
    "id": 14,
    "text": "-第二维度：深入剖析《说文解字》在部首、",
    "start": 61.755,
    "end": 65.26,
    "duration": 3.505
  },
  {
    "id": 15,
    "text": "形义互求以及六书践行三大体例层面的划时代突破；",
    "start": 65.26,
    "end": 70.401,
    "duration": 5.141
  },
  {
    "id": 16,
    "text": "-第三维度：系统论述清代“说文四大家”（段玉裁、",
    "start": 70.401,
    "end": 74.607,
    "duration": 4.206
  },
  {
    "id": 17,
    "text": "桂馥、王筠、朱骏声）的代表著作与独创性学术贡献；",
    "start": 74.607,
    "end": 79.28,
    "duration": 4.673
  },
  {
    "id": 18,
    "text": "第四维度：宏观总结许慎与四大家共同构建的文字训诂学范式与典籍阐释价值。",
    "start": 79.36,
    "end": 86.48,
    "duration": 7.12
  },
  {
    "id": 19,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 86.48,
    "end": 90.08,
    "duration": 3.6
  },
  {
    "id": 20,
    "text": "全题逻辑严密咬合：第一步必须先确立许慎原著的源头经典地位。",
    "start": 90.08,
    "end": 95.68,
    "duration": 5.6
  },
  {
    "id": 21,
    "text": "第二步剖析该书之所以成为经典的原初体例机制，",
    "start": 95.68,
    "end": 100.16,
    "duration": 4.48
  },
  {
    "id": 22,
    "text": "即部首创制与六书解析。",
    "start": 100.16,
    "end": 102.4,
    "duration": 2.24
  },
  {
    "id": 23,
    "text": "第三步顺理成章承接清代乾嘉学者对该书的研究巅峰，",
    "start": 102.72,
    "end": 107.2,
    "duration": 4.48
  },
  {
    "id": 24,
    "text": "清晰辨析四大家在音、形、义、证四维上的分工推进。",
    "start": 107.2,
    "end": 112.24,
    "duration": 5.04
  },
  {
    "id": 25,
    "text": "第四步跳出单人单书，在整体传统语文学体系中完成宏观历史论证闭环。",
    "start": 112.24,
    "end": 118.0,
    "duration": 5.76
  },
  {
    "id": 26,
    "text": "二、各板块逐句咬合演练。",
    "start": 118.0,
    "end": 120.24,
    "duration": 2.24
  },
  {
    "id": 27,
    "text": "一、开头破题段内部咬合。",
    "start": 120.24,
    "end": 122.0,
    "duration": 1.76
  },
  {
    "id": 28,
    "text": "本段旨在开门见山确立立论基石。",
    "start": 122.32,
    "end": 125.76,
    "duration": 3.44
  },
  {
    "id": 29,
    "text": "首句直切经典定位，次句引出清代学术发皇，",
    "start": 125.76,
    "end": 130.16,
    "duration": 4.4
  },
  {
    "id": 30,
    "text": "形成跨越千年的学术渊源照应。",
    "start": 130.16,
    "end": 132.8,
    "duration": 2.64
  },
  {
    "id": 31,
    "text": "-首先，首句必须直接亮出该书在中国语言学史上的崇高地位，",
    "start": 133.008,
    "end": 137.538,
    "duration": 4.53
  },
  {
    "id": 32,
    "text": "具体表述到答题语句就是：东汉许慎所撰《说文解字》是中国语言学史上第一部系统完备的字典。，",
    "start": 137.538,
    "end": 144.606,
    "duration": 7.068
  },
  {
    "id": 33,
    "text": "这句话直接为全题定下了权威基调。",
    "start": 144.606,
    "end": 147.324,
    "duration": 2.718
  },
  {
    "id": 34,
    "text": "有了经典定性之后，次句必须迅速说明该书对后世学术的启发功能，",
    "start": 147.324,
    "end": 152.398,
    "duration": 5.074
  },
  {
    "id": 35,
    "text": "具体表述到答题语句就是：该书不仅创立了汉字形义系统分析的科学体例，",
    "start": 152.398,
    "end": 158.016,
    "duration": 5.618
  },
  {
    "id": 36,
    "text": "也为清代乾嘉学者开启了通向先秦两汉典籍的训诂门径。，",
    "start": 158.016,
    "end": 162.365,
    "duration": 4.349
  },
  {
    "id": 37,
    "text": "这句话点出了字典学与典籍训诂的双重意义。",
    "start": 162.365,
    "end": 165.808,
    "duration": 3.443
  },
  {
    "id": 38,
    "text": "-随后，末句干脆利落地将题目两问串联收束，",
    "start": 165.808,
    "end": 169.696,
    "duration": 3.888
  },
  {
    "id": 39,
    "text": "具体表述到答题语句就是：其体例价值与后世四大家研究共同构筑了中国文字学的基石。，",
    "start": 169.696,
    "end": 177.688,
    "duration": 7.992
  },
  {
    "id": 40,
    "text": "这句话直接开启下文两个大维度的展开。",
    "start": 177.688,
    "end": 181.36,
    "duration": 3.672
  },
  {
    "id": 41,
    "text": "东汉许慎所撰《说文解字》是中国语言学史上第一部系统完备的字典。",
    "start": 181.36,
    "end": 187.408,
    "duration": 6.048
  },
  {
    "id": 42,
    "text": "该书不仅创立了汉字形义系统分析的科学体例，",
    "start": 187.488,
    "end": 191.248,
    "duration": 3.76
  },
  {
    "id": 43,
    "text": "也为清代乾嘉学者开启了通向先秦两汉典籍的训诂门径。",
    "start": 191.248,
    "end": 196.048,
    "duration": 4.8
  },
  {
    "id": 44,
    "text": "其体例价值与后世四大家研究共同构筑了中国文字学的基石。",
    "start": 196.048,
    "end": 201.248,
    "duration": 5.2
  },
  {
    "id": 45,
    "text": "二、第二板块：《说文解字》三大体例价值内部咬合。",
    "start": 201.248,
    "end": 204.768,
    "duration": 3.52
  },
  {
    "id": 46,
    "text": "本段任务是深入剖析许慎体例的技术性贡献，",
    "start": 204.768,
    "end": 208.048,
    "duration": 3.28
  },
  {
    "id": 47,
    "text": "避免空洞赞美，必须落实到字数、部首数与六书说解逻辑。",
    "start": 208.048,
    "end": 212.368,
    "duration": 4.32
  },
  {
    "id": 48,
    "text": "-首先，段首给出统领性分论点，具体表述到答题语句就是：首先，",
    "start": 212.528,
    "end": 217.402,
    "duration": 4.874
  },
  {
    "id": 49,
    "text": "在体例价值方面，《说文解字》具有三大划时代的开创性贡献。",
    "start": 217.402,
    "end": 222.081,
    "duration": 4.679
  },
  {
    "id": 50,
    "text": "随后，展开第一大体例创新即部首法，",
    "start": 222.081,
    "end": 225.005,
    "duration": 2.924
  },
  {
    "id": 51,
    "text": "具体表述到答题语句就是：第一是首创“部首分类法”。，",
    "start": 225.005,
    "end": 229.099,
    "duration": 4.094
  },
  {
    "id": 52,
    "text": "紧接着用准确数据与逻辑原理解析部首机制：全书收录汉字九千三百五十三字，",
    "start": 229.099,
    "end": 235.532,
    "duration": 6.433
  },
  {
    "id": 53,
    "text": "重文一千一百六十三字，依据造字本义和六书形体，",
    "start": 235.532,
    "end": 239.626,
    "duration": 4.094
  },
  {
    "id": 54,
    "text": "设立五百四十个部首，按照“据形系联”与“始一终亥”的哲学逻辑组织字形，",
    "start": 239.626,
    "end": 245.28,
    "duration": 5.654
  },
  {
    "id": 55,
    "text": "彻底打破了此前字书散乱无序的编排格局。，",
    "start": 245.28,
    "end": 248.789,
    "duration": 3.509
  },
  {
    "id": 56,
    "text": "这一句实词密度极高，展现出扎实的文献学素养。",
    "start": 248.789,
    "end": 252.688,
    "duration": 3.899
  },
  {
    "id": 57,
    "text": "-紧接着，推进到形义关系的核心体例，",
    "start": 252.744,
    "end": 256.161,
    "duration": 3.417
  },
  {
    "id": 58,
    "text": "具体表述到答题语句就是：第二是奠定了“以形索义，",
    "start": 256.161,
    "end": 260.946,
    "duration": 4.785
  },
  {
    "id": 59,
    "text": "因形见义”的科学释字原则。，",
    "start": 260.946,
    "end": 263.452,
    "duration": 2.506
  },
  {
    "id": 60,
    "text": "随后阐明其单字排列步骤：全书先列小篆字形，",
    "start": 263.452,
    "end": 267.781,
    "duration": 4.329
  },
  {
    "id": 61,
    "text": "进而说解造字本义，再析六书构形理据，",
    "start": 267.781,
    "end": 271.426,
    "duration": 3.645
  },
  {
    "id": 62,
    "text": "将字形与本义紧密锚定。",
    "start": 271.426,
    "end": 273.704,
    "duration": 2.278
  },
  {
    "id": 63,
    "text": "-最后，推进到六书理论的具体实践，",
    "start": 273.704,
    "end": 276.64,
    "duration": 2.936
  },
  {
    "id": 64,
    "text": "具体表述到答题语句就是：第三是首次将六书理论系统运用于造字实践分析。，",
    "start": 276.64,
    "end": 283.352,
    "duration": 6.712
  },
  {
    "id": 65,
    "text": "并点明许慎的体例格式：许慎在每字说解后标明“象形”、",
    "start": 283.352,
    "end": 287.967,
    "duration": 4.615
  },
  {
    "id": 66,
    "text": "“从某从某会意”或“从某某声”，",
    "start": 287.967,
    "end": 290.274,
    "duration": 2.307
  },
  {
    "id": 67,
    "text": "使六书理论从宏观纲领转化为可操作的汉字结构解析工具。，",
    "start": 290.274,
    "end": 295.518,
    "duration": 5.244
  },
  {
    "id": 68,
    "text": "这三点层层递进，彻底讲透体例之功。",
    "start": 295.518,
    "end": 298.664,
    "duration": 3.146
  },
  {
    "id": 69,
    "text": "首先，在体例价值方面，《说文解字》具有三大划时代的开创性贡献。",
    "start": 298.824,
    "end": 304.744,
    "duration": 5.92
  },
  {
    "id": 70,
    "text": "第一是首创“部首分类法”。",
    "start": 304.744,
    "end": 307.064,
    "duration": 2.32
  },
  {
    "id": 71,
    "text": "全书收录汉字九千三百五十三字，重文一千一百六十三字，",
    "start": 307.064,
    "end": 312.024,
    "duration": 4.96
  },
  {
    "id": 72,
    "text": "依据造字本义和六书形体，设立五百四十个部首，",
    "start": 312.104,
    "end": 316.344,
    "duration": 4.24
  },
  {
    "id": 73,
    "text": "按照“据形系联”与“始一终亥”的哲学逻辑组织字形，",
    "start": 316.344,
    "end": 321.064,
    "duration": 4.72
  },
  {
    "id": 74,
    "text": "彻底打破了此前字书散乱无序的编排格局。",
    "start": 321.064,
    "end": 324.504,
    "duration": 3.44
  },
  {
    "id": 75,
    "text": "第二是奠定了“以形索义，因形见义”的科学释字原则。",
    "start": 324.744,
    "end": 330.024,
    "duration": 5.28
  },
  {
    "id": 76,
    "text": "全书先列小篆字形，进而说解造字本义，",
    "start": 330.024,
    "end": 333.704,
    "duration": 3.68
  },
  {
    "id": 77,
    "text": "再析六书构形理据，将字形与本义紧密锚定。",
    "start": 333.704,
    "end": 338.264,
    "duration": 4.56
  },
  {
    "id": 78,
    "text": "第三是首次将六书理论系统运用于造字实践分析。",
    "start": 338.264,
    "end": 342.824,
    "duration": 4.56
  },
  {
    "id": 79,
    "text": "许慎在每字说解后标明“象形”、“从某从某会意”或“从某某声”，",
    "start": 342.824,
    "end": 349.704,
    "duration": 6.88
  },
  {
    "id": 80,
    "text": "使六书理论从宏观纲领转化为可操作的汉字结构解析工具。",
    "start": 349.704,
    "end": 354.744,
    "duration": 5.04
  },
  {
    "id": 81,
    "text": "三、第三板块：清代“说文四大家”学术成就内部咬合。",
    "start": 355.064,
    "end": 359.704,
    "duration": 4.64
  },
  {
    "id": 82,
    "text": "本段任务是系统梳理段玉裁、桂馥、",
    "start": 359.704,
    "end": 362.824,
    "duration": 3.12
  },
  {
    "id": 83,
    "text": "王筠、朱骏声四大家的专著与学术特色，",
    "start": 362.824,
    "end": 366.344,
    "duration": 3.52
  },
  {
    "id": 84,
    "text": "必须做到人名、书名、核心研究法完全精准对应。",
    "start": 366.344,
    "end": 370.744,
    "duration": 4.4
  },
  {
    "id": 85,
    "text": "首先，段首承前启后点出乾嘉学派的贡献，",
    "start": 370.744,
    "end": 374.504,
    "duration": 3.76
  },
  {
    "id": 86,
    "text": "具体表述到答题语句就是：其次，清代乾嘉考据学派将《说文解字》研究推向巅峰，",
    "start": 374.504,
    "end": 381.064,
    "duration": 6.56
  },
  {
    "id": 87,
    "text": "形成了著名的“说文四大家”，各自从不同维度深化了文字训诂学。",
    "start": 381.064,
    "end": 385.624,
    "duration": 4.56
  },
  {
    "id": 88,
    "text": "-随后，解析第一位段玉裁的学术特色，",
    "start": 385.92,
    "end": 389.264,
    "duration": 3.344
  },
  {
    "id": 89,
    "text": "具体表述到答题语句就是：第一位是段玉裁，",
    "start": 389.264,
    "end": 393.276,
    "duration": 4.012
  },
  {
    "id": 90,
    "text": "所著《说文解字注》阐明“字有本义，",
    "start": 393.276,
    "end": 396.174,
    "duration": 2.898
  },
  {
    "id": 91,
    "text": "有引申义”，精辟提炼出“同声必同部”、",
    "start": 396.174,
    "end": 399.295,
    "duration": 3.121
  },
  {
    "id": 92,
    "text": "“本无其字，依声托事”的假借规律，",
    "start": 399.295,
    "end": 402.193,
    "duration": 2.898
  },
  {
    "id": 93,
    "text": "精于校勘与义理推演。，",
    "start": 402.193,
    "end": 404.199,
    "duration": 2.006
  },
  {
    "id": 94,
    "text": "直接点明段注在词义引申和古音学上的卓越建树。",
    "start": 404.199,
    "end": 408.88,
    "duration": 4.681
  },
  {
    "id": 95,
    "text": "-紧接着，解析第二位桂馥的文献实证法，",
    "start": 408.88,
    "end": 412.705,
    "duration": 3.825
  },
  {
    "id": 96,
    "text": "具体表述到答题语句就是：第二位是桂馥，",
    "start": 412.705,
    "end": 416.77,
    "duration": 4.065
  },
  {
    "id": 97,
    "text": "所著《说文解字义证》广辑先秦两汉经典例证，",
    "start": 416.77,
    "end": 421.074,
    "duration": 4.304
  },
  {
    "id": 98,
    "text": "主张“据古证古”，用严密翔实的古文献用例证实许慎释义的准确性。，",
    "start": 421.074,
    "end": 427.529,
    "duration": 6.455
  },
  {
    "id": 99,
    "text": "明确指出桂书长于求证。",
    "start": 427.529,
    "end": 429.92,
    "duration": 2.391
  },
  {
    "id": 100,
    "text": "-随后，解析第三位王筠的构形分析法，",
    "start": 429.92,
    "end": 432.972,
    "duration": 3.052
  },
  {
    "id": 101,
    "text": "具体表述到答题语句就是：第三位是王筠，",
    "start": 432.972,
    "end": 436.432,
    "duration": 3.46
  },
  {
    "id": 102,
    "text": "撰有《说文释例》与《说文句读》，",
    "start": 436.432,
    "end": 438.67,
    "duration": 2.238
  },
  {
    "id": 103,
    "text": "精于分析汉字形体与构字规律，发明了重意字、",
    "start": 438.67,
    "end": 442.537,
    "duration": 3.867
  },
  {
    "id": 104,
    "text": "转注字与形声加旁等新细则，深具汉字教学与结构学价值。，",
    "start": 442.537,
    "end": 447.421,
    "duration": 4.884
  },
  {
    "id": 105,
    "text": "点明王书在文字形体细部推演上的贡献。",
    "start": 447.421,
    "end": 450.88,
    "duration": 3.459
  },
  {
    "id": 106,
    "text": "-随后，解析第四位朱骏声的古音分类法，",
    "start": 450.88,
    "end": 454.459,
    "duration": 3.579
  },
  {
    "id": 107,
    "text": "具体表述到答题语句就是：第四位是朱骏声，",
    "start": 454.459,
    "end": 458.486,
    "duration": 4.027
  },
  {
    "id": 108,
    "text": "所著《说文通训定声》打破部首编排，",
    "start": 458.486,
    "end": 461.618,
    "duration": 3.132
  },
  {
    "id": 109,
    "text": "按古韵十八部重新系联字头，并在每字下列出本义、",
    "start": 461.618,
    "end": 466.316,
    "duration": 4.698
  },
  {
    "id": 110,
    "text": "转注与假借，彻底理清了词义演变与通假音理的网络。，",
    "start": 466.316,
    "end": 471.237,
    "duration": 4.921
  },
  {
    "id": 111,
    "text": "准确说明其以声音统摄文字的独特突破。",
    "start": 471.237,
    "end": 475.04,
    "duration": 3.803
  },
  {
    "id": 112,
    "text": "其次，清代乾嘉考据学派将《说文解字》研究推向巅峰，",
    "start": 475.264,
    "end": 480.064,
    "duration": 4.8
  },
  {
    "id": 113,
    "text": "形成了著名的“说文四大家”，各自从不同维度深化了文字训诂学。",
    "start": 480.064,
    "end": 485.664,
    "duration": 5.6
  },
  {
    "id": 114,
    "text": "第一位是段玉裁，所著《说文解字注》阐明“字有本义，",
    "start": 485.664,
    "end": 490.224,
    "duration": 4.56
  },
  {
    "id": 115,
    "text": "有引申义”，精辟提炼出“同声必同部”、",
    "start": 490.224,
    "end": 493.664,
    "duration": 3.44
  },
  {
    "id": 116,
    "text": "“本无其字，依声托事”的假借规律，",
    "start": 493.664,
    "end": 496.864,
    "duration": 3.2
  },
  {
    "id": 117,
    "text": "精于校勘与义理推演。",
    "start": 496.864,
    "end": 498.784,
    "duration": 1.92
  },
  {
    "id": 118,
    "text": "第二位是桂馥，所著《说文解字义证》广辑先秦两汉经典例证，",
    "start": 498.944,
    "end": 503.904,
    "duration": 4.96
  },
  {
    "id": 119,
    "text": "主张“据古证古”，用严密翔实的古文献用例证实许慎释义的准确性。",
    "start": 503.904,
    "end": 509.264,
    "duration": 5.36
  },
  {
    "id": 120,
    "text": "第三位是王筠，撰有《说文释例》与《说文句读》，",
    "start": 509.264,
    "end": 512.704,
    "duration": 3.44
  },
  {
    "id": 121,
    "text": "精于分析汉字形体与构字规律，发明了重意字、",
    "start": 512.704,
    "end": 516.544,
    "duration": 3.84
  },
  {
    "id": 122,
    "text": "转注字与形声加旁等新细则，深具汉字教学与结构学价值。",
    "start": 516.544,
    "end": 521.584,
    "duration": 5.04
  },
  {
    "id": 123,
    "text": "第四位是朱骏声，所著《说文通训定声》打破部首编排，",
    "start": 521.904,
    "end": 526.784,
    "duration": 4.88
  },
  {
    "id": 124,
    "text": "按古韵十八部重新系联字头，并在每字下列出本义、",
    "start": 526.784,
    "end": 531.424,
    "duration": 4.64
  },
  {
    "id": 125,
    "text": "转注与假借，彻底理清了词义演变与通假音理的网络。",
    "start": 531.424,
    "end": 536.544,
    "duration": 5.12
  },
  {
    "id": 126,
    "text": "四、结尾收束升华段内部咬合。",
    "start": 536.544,
    "end": 539.344,
    "duration": 2.8
  },
  {
    "id": 127,
    "text": "本段承担全篇论证成果的系统提炼与历史定位，",
    "start": 539.344,
    "end": 543.424,
    "duration": 4.08
  },
  {
    "id": 128,
    "text": "收束在具体的学术范式与典籍通达上。",
    "start": 543.424,
    "end": 546.624,
    "duration": 3.2
  },
  {
    "id": 129,
    "text": "-首先，全面回收前述许慎原著与清代四大家的内在关系，",
    "start": 546.864,
    "end": 551.999,
    "duration": 5.135
  },
  {
    "id": 130,
    "text": "具体表述到答题语句就是：综上所述，",
    "start": 551.999,
    "end": 555.348,
    "duration": 3.349
  },
  {
    "id": 131,
    "text": "许慎《说文解字》通过严谨部首体制与形义互求体例，",
    "start": 555.348,
    "end": 560.036,
    "duration": 4.688
  },
  {
    "id": 132,
    "text": "建立了汉字认知坐标。",
    "start": 560.036,
    "end": 562.045,
    "duration": 2.009
  },
  {
    "id": 133,
    "text": "紧接着，拔高到传统语言学体系的高度完成收官，",
    "start": 562.045,
    "end": 566.511,
    "duration": 4.466
  },
  {
    "id": 134,
    "text": "具体表述到答题语句就是：清代说文四大家则在音理、",
    "start": 566.511,
    "end": 571.422,
    "duration": 4.911
  },
  {
    "id": 135,
    "text": "例证、结构与词义网络上完成了对许书的全面开掘与理论升华，",
    "start": 571.422,
    "end": 577.227,
    "duration": 5.805
  },
  {
    "id": 136,
    "text": "共同确立了传统文字学经典阐释的权威范式。，",
    "start": 577.227,
    "end": 581.469,
    "duration": 4.242
  },
  {
    "id": 137,
    "text": "这句话文意整赤，完成宏观历史论证闭环。",
    "start": 581.469,
    "end": 585.264,
    "duration": 3.795
  },
  {
    "id": 138,
    "text": "综上所述，许慎《说文解字》通过严谨部首体制与形义互求体例，",
    "start": 585.344,
    "end": 591.264,
    "duration": 5.92
  },
  {
    "id": 139,
    "text": "建立了汉字认知坐标。",
    "start": 591.264,
    "end": 593.264,
    "duration": 2.0
  },
  {
    "id": 140,
    "text": "清代说文四大家则在音理、例证、结构与词义网络上完成了对许书的全面开掘与理论升华，",
    "start": 593.264,
    "end": 601.344,
    "duration": 8.08
  },
  {
    "id": 141,
    "text": "共同确立了传统文字学经典阐释的权威范式。",
    "start": 601.344,
    "end": 604.864,
    "duration": 3.52
  }
]