[
  {
    "id": 1,
    "text": "题型，二十分简答题。",
    "start": 0.08,
    "end": 1.839,
    "duration": 1.759
  },
  {
    "id": 2,
    "text": "分值，二十分。",
    "start": 1.839,
    "end": 2.924,
    "duration": 1.085
  },
  {
    "id": 3,
    "text": "建议考场时间，二十分钟。",
    "start": 2.924,
    "end": 5.095,
    "duration": 2.171
  },
  {
    "id": 4,
    "text": "目标字数，五百五十到六百五十字。",
    "start": 5.095,
    "end": 8.133,
    "duration": 3.038
  },
  {
    "id": 5,
    "text": "答题骨架，性质定性、趋近于《说文解字》三大体例价值、",
    "start": 8.133,
    "end": 12.691,
    "duration": 4.558
  },
  {
    "id": 6,
    "text": "趋近于、清代“说文四大家”学术贡献、",
    "start": 12.691,
    "end": 15.73,
    "duration": 3.039
  },
  {
    "id": 7,
    "text": "趋近于、总结史学地位。",
    "start": 15.73,
    "end": 17.683,
    "duration": 1.953
  },
  {
    "id": 8,
    "text": "东汉许慎所撰《说文解字》是中国语言学史上第一部系统完备的字典。",
    "start": 17.683,
    "end": 23.76,
    "duration": 6.077
  },
  {
    "id": 9,
    "text": "该书不仅创立了汉字形义系统分析的科学体例，",
    "start": 23.84,
    "end": 27.68,
    "duration": 3.84
  },
  {
    "id": 10,
    "text": "也为清代乾嘉学者开启了通向先秦两汉典籍的训诂门径。",
    "start": 27.68,
    "end": 32.88,
    "duration": 5.2
  },
  {
    "id": 11,
    "text": "其体例价值与后世四大家研究共同构筑了中国文字学的基石。",
    "start": 32.88,
    "end": 38.32,
    "duration": 5.44
  },
  {
    "id": 12,
    "text": "首先，在体例价值方面，《说文解字》具有三大划时代的开创性贡献。",
    "start": 38.32,
    "end": 43.52,
    "duration": 5.2
  },
  {
    "id": 13,
    "text": "第一是首创“部首分类法”。",
    "start": 43.76,
    "end": 46.0,
    "duration": 2.24
  },
  {
    "id": 14,
    "text": "全书收录汉字九千三百五十三字，重文一千一百六十三字，",
    "start": 46.0,
    "end": 51.12,
    "duration": 5.12
  },
  {
    "id": 15,
    "text": "依据造字本义和六书形体，设立五百四十个部首，",
    "start": 51.12,
    "end": 55.44,
    "duration": 4.32
  },
  {
    "id": 16,
    "text": "按照“据形系联”与“始一终亥”的哲学逻辑组织字形，",
    "start": 55.44,
    "end": 60.24,
    "duration": 4.8
  },
  {
    "id": 17,
    "text": "彻底打破了此前字书散乱无序的编排格局。",
    "start": 60.24,
    "end": 63.76,
    "duration": 3.52
  },
  {
    "id": 18,
    "text": "第二是奠定了“以形索义，因形见义”的科学释字原则。",
    "start": 64.08,
    "end": 69.36,
    "duration": 5.28
  },
  {
    "id": 19,
    "text": "全书先列小篆字形，进而说解造字本义，",
    "start": 69.36,
    "end": 73.12,
    "duration": 3.76
  },
  {
    "id": 20,
    "text": "再析六书构形理据，将字形与本义紧密锚定。",
    "start": 73.12,
    "end": 77.44,
    "duration": 4.32
  },
  {
    "id": 21,
    "text": "第三是首次将六书理论系统运用于造字实践分析。",
    "start": 77.44,
    "end": 82.0,
    "duration": 4.56
  },
  {
    "id": 22,
    "text": "许慎在每字说解后标明“象形”、“从某从某会意”或“从某某声”，",
    "start": 82.0,
    "end": 88.16,
    "duration": 6.16
  },
  {
    "id": 23,
    "text": "使六书理论从宏观纲领转化为可操作的汉字结构解析工具。",
    "start": 88.16,
    "end": 93.44,
    "duration": 5.28
  },
  {
    "id": 24,
    "text": "其次，清代乾嘉考据学派将《说文解字》研究推向巅峰，",
    "start": 93.904,
    "end": 98.544,
    "duration": 4.64
  },
  {
    "id": 25,
    "text": "形成了著名的“说文四大家”，各自从不同维度深化了文字训诂学。",
    "start": 98.544,
    "end": 103.984,
    "duration": 5.44
  },
  {
    "id": 26,
    "text": "第一位是段玉裁，所著《说文解字注》阐明“字有本义，",
    "start": 103.984,
    "end": 108.704,
    "duration": 4.72
  },
  {
    "id": 27,
    "text": "有引申义”，精辟提炼出“同声必同部”、",
    "start": 108.704,
    "end": 112.144,
    "duration": 3.44
  },
  {
    "id": 28,
    "text": "“本无其字，依声托事”的假借规律，",
    "start": 112.144,
    "end": 115.104,
    "duration": 2.96
  },
  {
    "id": 29,
    "text": "精于校勘与义理推演。",
    "start": 115.104,
    "end": 116.864,
    "duration": 1.76
  },
  {
    "id": 30,
    "text": "第二位是桂馥，所著《说文解字义证》广辑先秦两汉经典例证，",
    "start": 117.104,
    "end": 122.064,
    "duration": 4.96
  },
  {
    "id": 31,
    "text": "主张“据古证古”，用严密翔实的古文献用例证实许慎释义的准确性。",
    "start": 122.064,
    "end": 127.424,
    "duration": 5.36
  },
  {
    "id": 32,
    "text": "第三位是王筠，撰有《说文释例》与《说文句读》，",
    "start": 127.424,
    "end": 130.864,
    "duration": 3.44
  },
  {
    "id": 33,
    "text": "精于分析汉字形体与构字规律，发明了重意字、",
    "start": 130.864,
    "end": 134.704,
    "duration": 3.84
  },
  {
    "id": 34,
    "text": "转注字与形声加旁等新细则，深具汉字教学与结构学价值。",
    "start": 134.704,
    "end": 139.744,
    "duration": 5.04
  },
  {
    "id": 35,
    "text": "第四位是朱骏声，所著《说文通训定声》打破部首编排，",
    "start": 139.984,
    "end": 145.184,
    "duration": 5.2
  },
  {
    "id": 36,
    "text": "按古韵十八部重新系联字头，并在每字下列出本义、",
    "start": 145.184,
    "end": 150.224,
    "duration": 5.04
  },
  {
    "id": 37,
    "text": "转注与假借，彻底理清了词义演变与通假音理的网络。",
    "start": 150.224,
    "end": 155.264,
    "duration": 5.04
  },
  {
    "id": 38,
    "text": "综上所述，许慎《说文解字》通过严谨部首体制与形义互求体例，",
    "start": 155.264,
    "end": 161.024,
    "duration": 5.76
  },
  {
    "id": 39,
    "text": "建立了汉字认知坐标。",
    "start": 161.024,
    "end": 162.624,
    "duration": 1.6
  },
  {
    "id": 40,
    "text": "清代说文四大家则在音理、例证、结构与词义网络上完成了对许书的全面开掘与理论升华，",
    "start": 162.944,
    "end": 171.024,
    "duration": 8.08
  },
  {
    "id": 41,
    "text": "共同确立了传统文字学经典阐释的权威范式。",
    "start": 171.024,
    "end": 175.024,
    "duration": 4.0
  }
]