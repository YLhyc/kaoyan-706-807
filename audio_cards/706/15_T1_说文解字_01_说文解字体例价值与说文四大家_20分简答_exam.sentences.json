[
  {
    "id": 1,
    "start": 0.08,
    "end": 6.157,
    "text": "东汉许慎所撰《说文解字》是中国语言学史上第一部系统完备的字典。"
  },
  {
    "id": 2,
    "start": 6.237,
    "end": 10.077,
    "text": "该书不仅创立了汉字形义系统分析的科学体例，"
  },
  {
    "id": 3,
    "start": 10.077,
    "end": 15.277,
    "text": "也为清代乾嘉学者开启了通向先秦两汉典籍的训诂门径。"
  },
  {
    "id": 4,
    "start": 15.277,
    "end": 20.717,
    "text": "其体例价值与后世四大家研究共同构筑了中国文字学的基石。"
  },
  {
    "id": 5,
    "start": 20.717,
    "end": 25.917,
    "text": "首先，在体例价值方面，《说文解字》具有三大划时代的开创性贡献。"
  },
  {
    "id": 6,
    "start": 26.157,
    "end": 28.397,
    "text": "第一是首创“部首分类法”。"
  },
  {
    "id": 7,
    "start": 28.397,
    "end": 33.517,
    "text": "全书收录汉字九千三百五十三字，重文一千一百六十三字，"
  },
  {
    "id": 8,
    "start": 33.517,
    "end": 37.837,
    "text": "依据造字本义和六书形体，设立五百四十个部首，"
  },
  {
    "id": 9,
    "start": 37.837,
    "end": 42.637,
    "text": "按照“据形系联”与“始一终亥”的哲学逻辑组织字形，"
  },
  {
    "id": 10,
    "start": 42.637,
    "end": 46.157,
    "text": "彻底打破了此前字书散乱无序的编排格局。"
  },
  {
    "id": 11,
    "start": 46.477,
    "end": 51.757,
    "text": "第二是奠定了“以形索义，因形见义”的科学释字原则。"
  },
  {
    "id": 12,
    "start": 51.757,
    "end": 55.517,
    "text": "全书先列小篆字形，进而说解造字本义，"
  },
  {
    "id": 13,
    "start": 55.517,
    "end": 59.837,
    "text": "再析六书构形理据，将字形与本义紧密锚定。"
  },
  {
    "id": 14,
    "start": 59.837,
    "end": 64.397,
    "text": "第三是首次将六书理论系统运用于造字实践分析。"
  },
  {
    "id": 15,
    "start": 64.397,
    "end": 70.557,
    "text": "许慎在每字说解后标明“象形”、“从某从某会意”或“从某某声”，"
  },
  {
    "id": 16,
    "start": 70.557,
    "end": 75.837,
    "text": "使六书理论从宏观纲领转化为可操作的汉字结构解析工具。"
  },
  {
    "id": 17,
    "start": 76.301,
    "end": 80.941,
    "text": "其次，清代乾嘉考据学派将《说文解字》研究推向巅峰，"
  },
  {
    "id": 18,
    "start": 80.941,
    "end": 86.381,
    "text": "形成了著名的“说文四大家”，各自从不同维度深化了文字训诂学。"
  },
  {
    "id": 19,
    "start": 86.381,
    "end": 91.101,
    "text": "第一位是段玉裁，所著《说文解字注》阐明“字有本义，"
  },
  {
    "id": 20,
    "start": 91.101,
    "end": 94.541,
    "text": "有引申义”，精辟提炼出“同声必同部”、"
  },
  {
    "id": 21,
    "start": 94.541,
    "end": 97.501,
    "text": "“本无其字，依声托事”的假借规律，"
  },
  {
    "id": 22,
    "start": 97.501,
    "end": 99.261,
    "text": "精于校勘与义理推演。"
  },
  {
    "id": 23,
    "start": 99.501,
    "end": 104.461,
    "text": "第二位是桂馥，所著《说文解字义证》广辑先秦两汉经典例证，"
  },
  {
    "id": 24,
    "start": 104.461,
    "end": 109.821,
    "text": "主张“据古证古”，用严密翔实的古文献用例证实许慎释义的准确性。"
  },
  {
    "id": 25,
    "start": 109.821,
    "end": 113.261,
    "text": "第三位是王筠，撰有《说文释例》与《说文句读》，"
  },
  {
    "id": 26,
    "start": 113.261,
    "end": 117.101,
    "text": "精于分析汉字形体与构字规律，发明了重意字、"
  },
  {
    "id": 27,
    "start": 117.101,
    "end": 122.141,
    "text": "转注字与形声加旁等新细则，深具汉字教学与结构学价值。"
  },
  {
    "id": 28,
    "start": 122.381,
    "end": 127.581,
    "text": "第四位是朱骏声，所著《说文通训定声》打破部首编排，"
  },
  {
    "id": 29,
    "start": 127.581,
    "end": 132.621,
    "text": "按古韵十八部重新系联字头，并在每字下列出本义、"
  },
  {
    "id": 30,
    "start": 132.621,
    "end": 137.661,
    "text": "转注与假借，彻底理清了词义演变与通假音理的网络。"
  },
  {
    "id": 31,
    "start": 137.661,
    "end": 143.421,
    "text": "综上所述，许慎《说文解字》通过严谨部首体制与形义互求体例，"
  },
  {
    "id": 32,
    "start": 143.421,
    "end": 145.021,
    "text": "建立了汉字认知坐标。"
  },
  {
    "id": 33,
    "start": 145.341,
    "end": 153.421,
    "text": "清代说文四大家则在音理、例证、结构与词义网络上完成了对许书的全面开掘与理论升华，"
  },
  {
    "id": 34,
    "start": 153.421,
    "end": 157.421,
    "text": "共同确立了传统文字学经典阐释的权威范式。"
  }
]