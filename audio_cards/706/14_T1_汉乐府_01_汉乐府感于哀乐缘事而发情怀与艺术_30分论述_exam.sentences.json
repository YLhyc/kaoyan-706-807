[
  {
    "id": 1,
    "text": "汉乐府民歌是中国古代诗歌史上继《诗经》之后现实主义传统的又一座划时代丰碑，",
    "start": 0.08,
    "end": 6.88,
    "duration": 6.8
  },
  {
    "id": 2,
    "text": "东汉史学家班固在《汉书•艺文志》中精辟概括其精神源流为“感于哀乐，",
    "start": 6.88,
    "end": 12.88,
    "duration": 6.0
  },
  {
    "id": 3,
    "text": "缘事而发”。",
    "start": 12.88,
    "end": 14.16,
    "duration": 1.28
  },
  {
    "id": 4,
    "text": "在两汉社会阶级矛盾激化与底层民众流离失所的历史语境下，",
    "start": 14.16,
    "end": 18.96,
    "duration": 4.8
  },
  {
    "id": 5,
    "text": "汉代乐府机关采集民间歌谣，将市井小民最真实的呼声记录成篇。",
    "start": 18.96,
    "end": 24.32,
    "duration": 5.36
  },
  {
    "id": 6,
    "text": "汉乐府以极具写实性的现实观照、刚健质朴的抒情风格以及日臻成熟的叙事技巧，",
    "start": 24.56,
    "end": 31.84,
    "duration": 7.28
  },
  {
    "id": 7,
    "text": "开辟了中国古代叙事诗的新纪元。",
    "start": 31.84,
    "end": 34.64,
    "duration": 2.8
  },
  {
    "id": 8,
    "text": "首先，“感于哀乐，缘事而发”确立了汉乐府直面现实苦难与底层生民血泪的抒情底色。",
    "start": 34.64,
    "end": 42.64,
    "duration": 8.0
  },
  {
    "id": 9,
    "text": "所谓“感于哀乐”，是指诗歌彻底摆脱了贵族颂圣的虚饰，",
    "start": 42.64,
    "end": 47.28,
    "duration": 4.64
  },
  {
    "id": 10,
    "text": "完全源于底层平民在严酷现实中的真实痛感。",
    "start": 47.28,
    "end": 50.8,
    "duration": 3.52
  },
  {
    "id": 11,
    "text": "所谓“缘事而发”，是指诗作绝非空洞抽象抒情，",
    "start": 51.12,
    "end": 55.36,
    "duration": 4.24
  },
  {
    "id": 12,
    "text": "而是紧紧依附于具体的社会生活事件展开。",
    "start": 55.36,
    "end": 58.88,
    "duration": 3.52
  },
  {
    "id": 13,
    "text": "《东门行》中“拔剑出门去，舍中儿母牵衣啼”，",
    "start": 58.88,
    "end": 63.04,
    "duration": 4.16
  },
  {
    "id": 14,
    "text": "以极具生活化的镜头，记录了贫民在饥寒绝境中铤而走险的反抗选择。",
    "start": 63.04,
    "end": 68.96,
    "duration": 5.92
  },
  {
    "id": 15,
    "text": "《十五从军征》借八十老兵回乡见“兔从狗窦入，",
    "start": 68.96,
    "end": 73.04,
    "duration": 4.08
  },
  {
    "id": 16,
    "text": "雉从梁上飞”的残破荒凉，沉痛控诉了汉代不合理的兵役制度给人民带来的毁灭性浩劫。",
    "start": 73.04,
    "end": 80.64,
    "duration": 7.6
  },
  {
    "id": 17,
    "text": "其次，汉乐府以生死决绝的刚烈精神，",
    "start": 80.88,
    "end": 84.56,
    "duration": 3.68
  },
  {
    "id": 18,
    "text": "谱写了追求自由婚姻与反抗礼教压迫的心灵赞歌。",
    "start": 84.56,
    "end": 89.04,
    "duration": 4.48
  },
  {
    "id": 19,
    "text": "在封建家长制与宗法伦理的残酷禁锢下，",
    "start": 89.04,
    "end": 92.72,
    "duration": 3.68
  },
  {
    "id": 20,
    "text": "汉代平民展现出极为强悍的生命韧劲与叛逆意志。",
    "start": 92.72,
    "end": 97.2,
    "duration": 4.48
  },
  {
    "id": 21,
    "text": "《陌上桑》中秦罗敷面对使君的调戏，",
    "start": 97.2,
    "end": 100.56,
    "duration": 3.36
  },
  {
    "id": 22,
    "text": "机智威严地盛夸夫婿，辛辣嘲讽了权贵的荒淫丑态。",
    "start": 100.56,
    "end": 104.64,
    "duration": 4.08
  },
  {
    "id": 23,
    "text": "《孔雀东南飞》则是汉乐府叙事艺术的巅峰之作，",
    "start": 104.8,
    "end": 108.842,
    "duration": 4.042
  },
  {
    "id": 24,
    "text": "面对焦母与刘兄的无理逼迫，刘兰芝与焦仲卿以“揽裙脱丝履，",
    "start": 108.842,
    "end": 114.161,
    "duration": 5.319
  },
  {
    "id": 25,
    "text": "举身赴清池”和“自挂东南枝”的殉情抗争，",
    "start": 114.161,
    "end": 117.565,
    "duration": 3.404
  },
  {
    "id": 26,
    "text": "展现出对爱情忠贞不渝的高贵品格，",
    "start": 117.565,
    "end": 120.756,
    "duration": 3.191
  },
  {
    "id": 27,
    "text": "发出对封建礼教吃人本质的强烈控诉。",
    "start": 120.756,
    "end": 124.16,
    "duration": 3.404
  },
  {
    "id": 28,
    "text": "再次，在艺术表现上，汉乐府标志着中国古代叙事诗机制的全面确立与成熟。",
    "start": 124.304,
    "end": 130.704,
    "duration": 6.4
  },
  {
    "id": 29,
    "text": "与《诗经》重章叠句的抒情体式不同，",
    "start": 130.704,
    "end": 133.504,
    "duration": 2.8
  },
  {
    "id": 30,
    "text": "汉乐府成功塑造了具备鲜明性格特征的典型人物。",
    "start": 133.504,
    "end": 137.504,
    "duration": 4.0
  },
  {
    "id": 31,
    "text": "作品大量运用生动洗练的人物对话、",
    "start": 137.504,
    "end": 140.384,
    "duration": 2.88
  },
  {
    "id": 32,
    "text": "心理独白与细节刻画，具有极强的戏剧化情节张力。",
    "start": 140.384,
    "end": 144.544,
    "duration": 4.16
  },
  {
    "id": 33,
    "text": "在句式形式上，汉乐府打破了四言诗的僵化格局，",
    "start": 144.784,
    "end": 148.864,
    "duration": 4.08
  },
  {
    "id": 34,
    "text": "创造性地推进了五言诗与杂言诗的繁荣，",
    "start": 148.864,
    "end": 152.384,
    "duration": 3.52
  },
  {
    "id": 35,
    "text": "为建安文人五言诗的成熟奠定了不可或缺的体式土壤。",
    "start": 152.384,
    "end": 157.264,
    "duration": 4.88
  },
  {
    "id": 36,
    "text": "最后，汉乐府“感于哀乐，缘事而发”的诗学传统，",
    "start": 157.264,
    "end": 161.424,
    "duration": 4.16
  },
  {
    "id": 37,
    "text": "成为后世现实主义文学的核心源泉。",
    "start": 161.424,
    "end": 164.064,
    "duration": 2.64
  },
  {
    "id": 38,
    "text": "它直接催生了建安文人的乐府诗创作与杜甫“即事名篇”的叙事变革，",
    "start": 164.384,
    "end": 170.144,
    "duration": 5.76
  },
  {
    "id": 39,
    "text": "更成为中唐白居易、元稹新乐府运动的精神纲领，",
    "start": 170.144,
    "end": 173.984,
    "duration": 3.84
  },
  {
    "id": 40,
    "text": "在两千年中国诗歌史上始终闪耀着不灭的人道主义光芒。",
    "start": 173.984,
    "end": 178.464,
    "duration": 4.48
  }
]