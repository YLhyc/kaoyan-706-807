[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣《先声》“借离合之情，写兴亡之感”三层展开：",
    "start": 0.0,
    "end": 5.04,
    "duration": 5.04
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先看侯李聚散怎样跟南明忠奸兴亡绑死，",
    "start": 5.089,
    "end": 8.449,
    "duration": 3.36
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再追着“桃花扇”这一实物道具四次动作演变串起全剧四十出，",
    "start": 8.899,
    "end": 13.699,
    "duration": 4.8
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后落在白云庵打破大团圆“撕扇入道”的历史悲凉。",
    "start": 14.149,
    "end": 18.149,
    "duration": 4.0
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "孔尚任《桃花扇》与洪昇《长生殿》并称清初戏剧“双璧”，",
    "start": 18.599,
    "end": 22.799,
    "duration": 4.2
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "严守“征实求信”，试一出《先声》点明主旨：“借离合之情，写兴亡之感。”",
    "start": 23.249,
    "end": 28.729,
    "duration": 5.48
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 儿女情缘严密嵌入南明覆亡进程",
    "start": 29.179,
    "end": 32.819,
    "duration": 3.64
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "摆脱流连风月旧套，将侯方域与李香君聚散严密嵌入弘光朝廷建立、党争至覆亡进程；",
    "start": 33.269,
    "end": 40.549,
    "duration": 7.28
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "借浮沉揭马士英、阮大铖误国，歌颂史可法、李香君、柳敬亭气节；",
    "start": 40.999,
    "end": 46.799,
    "duration": 5.8
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "南明灭亡摧毁爱情归宿，国运支配个体离合。",
    "start": 47.329,
    "end": 51.009,
    "duration": 3.68
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · “桃花扇”贯穿四十出的精巧结构",
    "start": 51.539,
    "end": 54.979,
    "duration": 3.44
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "一柄“桃花扇”串联四十出：",
    "start": 55.429,
    "end": 57.629,
    "duration": 2.2
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "定情题诗赠扇→逼嫁香君溅血诗扇→杨龙友点染成桃花扇→终局张瑶星撕扇；",
    "start": 58.079,
    "end": 65.159,
    "duration": 7.08
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "既是定情信物、香君气节象征，又是南明政局盛衰见证，双线交错脉络贯通。",
    "start": 65.609,
    "end": 72.489,
    "duration": 6.88
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 白云庵撕扇入道、升华悲凉史诗格调",
    "start": 72.939,
    "end": 77.259,
    "duration": 4.32
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "突破“破镜重圆”俗套，南京栖霞山白云庵劫后重聚之际，",
    "start": 77.749,
    "end": 82.509,
    "duration": 4.76
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "张瑶星呵斥“两个痴虫，你看国在哪里？家在哪里？君在哪里？父在哪里？",
    "start": 83.039,
    "end": 88.279,
    "duration": 5.24
  },
  {
    "id": "sec2_step0_c2",
    "dom_key": "sec2_step0_c2",
    "text": "”随后撕碎桃花扇；",
    "start": 88.729,
    "end": 90.329,
    "duration": 1.6
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "二人如梦忽醒、双双入道，割断花月情根升华至国家兴亡沧桑反思，",
    "start": 90.779,
    "end": 97.219,
    "duration": 6.44
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "具史诗格调。",
    "start": 97.749,
    "end": 98.869,
    "duration": 1.12
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：清初戏曲“双璧”是孔尚任《桃花扇》与洪昇《长生殿》；",
    "start": 99.319,
    "end": 103.999,
    "duration": 4.68
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "《桃花扇》严守“征实求信”原则，结局是白云庵撕扇入道。",
    "start": 104.649,
    "end": 109.209,
    "duration": 4.56
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 《桃花扇》试一出《先声》的八字纲领与“征实求信”原则？",
    "start": 109.659,
    "end": 115.259,
    "duration": 5.6
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② “一柄桃花扇”经历哪四折动作并发挥哪三重结构与象征职能？",
    "start": 115.709,
    "end": 122.069,
    "duration": 6.36
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 复述白云庵结局的场景与张瑶星喝问如何升华史诗意蕴？",
    "start": 122.519,
    "end": 128.999,
    "duration": 6.48
  }
]