[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《窦娥冤》·关汉卿窦娥冤悲剧艺术成就与社会反抗精神",
    "start": 0.134,
    "end": 4.834,
    "duration": 4.7
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "写实土壤→人物觉醒→浪漫抗议→本色唱腔：先看底层寡妇窦娥如何被赛卢医、张驴儿、贪官桃杌步步逼死，",
    "start": 5.423,
    "end": 16.229,
    "duration": 10.806
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再追她由认命孝顺到【滚绣球】指天斥地的觉醒弧线，紧接三桩超现实誓愿为清白作证，",
    "start": 16.503,
    "end": 23.894,
    "duration": 7.391
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后赞其本色当行唱辞之震撼。",
    "start": 24.168,
    "end": 27.149,
    "duration": 2.981
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "关汉卿《窦娥冤》（全名《感天动地窦娥冤》）写元代黑暗下无辜寡妇冤案，",
    "start": 27.736,
    "end": 33.347,
    "duration": 5.611
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "王国维《宋元戏曲考》赞“即列之于世界大悲剧中，亦无愧色也”。",
    "start": 33.621,
    "end": 38.66,
    "duration": 5.038
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 植根严酷现实、塑善良坚贞女性",
    "start": 39.233,
    "end": 43.178,
    "duration": 3.944
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "童养媳早寡奉养蔡婆婆，遭赛卢医赖账、张驴儿父子勒索诬陷及贪官桃杌酷刑草菅人命；",
    "start": 43.752,
    "end": 53.165,
    "duration": 9.413
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "护婆免杖而屈招显仁孝，公堂法场拒逼婚见底层女性不屈尊严。",
    "start": 53.752,
    "end": 60.248,
    "duration": 6.496
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 写实交融浪漫、三桩誓愿感天动地",
    "start": 60.822,
    "end": 64.675,
    "duration": 3.853
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "第三折法场受刑化用东海孝妇传说，立“血溅白练”“六月飞雪”“亢旱三年”誓愿并一一体现；",
    "start": 65.249,
    "end": 74.167,
    "duration": 8.918
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "以超现实奇景证实清白，对贪官恶霸行警世裁决，将个人冤屈升华为撼动天地的社会抗议。",
    "start": 74.754,
    "end": 83.92,
    "duration": 9.166
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 由忍辱顺从到【滚绣球】愤慨斥天",
    "start": 84.507,
    "end": 88.269,
    "duration": 3.762
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "起初敬畏天命守分，幻想官府作主；酷刑铸冤后幻想击碎；",
    "start": 88.855,
    "end": 95.287,
    "duration": 6.431
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "【滚绣球】唱出“为善的受贫穷更命短……地也，你不分好歹何为地！天也，你错勘贤愚枉做天！”，直指天理权威。",
    "start": 95.861,
    "end": 106.785,
    "duration": 10.924
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 曲词本色当行而激越悲壮",
    "start": 107.371,
    "end": 110.469,
    "duration": 3.098
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "发挥元杂剧本色派所长，融市井口语、民间俗谚与精炼雅语，质朴自然无文饰艰深之弊；",
    "start": 111.043,
    "end": 119.792,
    "duration": 8.749
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "绝望悲愤处如泣如诉、韵律急促有力，确立古典戏曲悲剧崇高典范。",
    "start": 120.366,
    "end": 127.136,
    "duration": 6.77
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《窦娥冤》以底层寡妇由忍辱顺从到【滚绣球】斥天的抗争轨迹与三桩誓愿，",
    "start": 127.723,
    "end": 134.154,
    "duration": 6.431
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "将本色民间曲辞与尖锐冲突结合，无愧世界大悲剧之赞誉。",
    "start": 134.39,
    "end": 139.623,
    "duration": 5.233
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：王国维《宋元戏曲考》盛赞“即列之于世界大悲剧中，亦无愧色也”；",
    "start": 140.184,
    "end": 146.381,
    "duration": 6.197
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "注意第三折高潮曲牌为【滚绣球】，三桩誓愿为血溅白练、六月飞雪、亢旱三年。",
    "start": 146.629,
    "end": 154.011,
    "duration": 7.382
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 回答 2020 真题：《窦娥冤》为什么“含冤而死”，又为什么能“感天动地”？",
    "start": 154.572,
    "end": 161.641,
    "duration": 7.069
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 说出赛卢医、张驴儿、桃杌的作恶链条，以及三桩誓愿与【滚绣球】唱词？",
    "start": 162.228,
    "end": 169.805,
    "duration": 7.577
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 王国维《宋元戏曲考》对全剧给出什么至高定位？",
    "start": 170.392,
    "end": 175.743,
    "duration": 5.351
  }
]