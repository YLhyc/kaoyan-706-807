[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《窦娥冤》·关汉卿窦娥冤悲剧艺术成就与社会反抗精神",
    "start": 0.134,
    "end": 5.266,
    "duration": 5.132
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "写实土壤→人物觉醒→浪漫抗议→本色唱腔：先看底层寡妇窦娥如何被赛卢医、张驴儿、贪官桃杌步步逼死，",
    "start": 5.763,
    "end": 16.015,
    "duration": 10.252
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再追她由认命孝顺到【滚绣球】指天斥地的觉醒弧线，紧接三桩超现实誓愿为清白作证，",
    "start": 16.163,
    "end": 23.935,
    "duration": 7.772
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后赞其本色当行唱辞之震撼。",
    "start": 24.003,
    "end": 26.655,
    "duration": 2.652
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "关汉卿《窦娥冤》（全名《感天动地窦娥冤》）写元代黑暗下无辜寡妇冤案，",
    "start": 27.158,
    "end": 34.05,
    "duration": 6.892
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "王国维《宋元戏曲考》赞“即列之于世界大悲剧中，亦无愧色也”。",
    "start": 34.198,
    "end": 39.33,
    "duration": 5.132
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 植根严酷现实、塑善良坚贞女性",
    "start": 39.967,
    "end": 43.819,
    "duration": 3.852
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "童养媳早寡奉养蔡婆婆，遭赛卢医赖账、张驴儿父子勒索诬陷及贪官桃杌酷刑草菅人命；",
    "start": 44.347,
    "end": 55.399,
    "duration": 11.052
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "护婆免杖而屈招显仁孝，公堂法场拒逼婚见底层女性不屈尊严。",
    "start": 55.918,
    "end": 63.42,
    "duration": 7.502
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 写实交融浪漫、三桩誓愿感天动地",
    "start": 64.069,
    "end": 68.161,
    "duration": 4.092
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "第三折法场受刑化用东海孝妇传说，立“血溅白练”“六月飞雪”“亢旱三年”誓愿并一一体现；",
    "start": 68.689,
    "end": 78.861,
    "duration": 10.172
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "以超现实奇景证实清白，对贪官恶霸行警世裁决，将个人冤屈升华为撼动天地的社会抗议。",
    "start": 79.389,
    "end": 88.281,
    "duration": 8.892
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 由忍辱顺从到【滚绣球】愤慨斥天",
    "start": 88.918,
    "end": 92.85,
    "duration": 3.932
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "起初敬畏天命守分，幻想官府作主；酷刑铸冤后幻想击碎；",
    "start": 93.378,
    "end": 100.43,
    "duration": 7.052
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "【滚绣球】唱出“为善的受贫穷更命短……地也，你不分好歹何为地！天也，你错勘贤愚枉做天！”，直指天理权威。",
    "start": 100.917,
    "end": 113.245,
    "duration": 12.328
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 曲词本色当行而激越悲壮",
    "start": 113.577,
    "end": 117.453,
    "duration": 3.876
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "发挥元杂剧本色派所长，融市井口语、民间俗谚与精炼雅语，质朴自然无文饰艰深之弊；",
    "start": 117.795,
    "end": 126.527,
    "duration": 8.732
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "绝望悲愤处如泣如诉、韵律急促有力，确立古典戏曲悲剧崇高典范。",
    "start": 127.055,
    "end": 134.187,
    "duration": 7.132
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《窦娥冤》以底层寡妇由忍辱顺从到【滚绣球】斥天的抗争轨迹与三桩誓愿，",
    "start": 134.804,
    "end": 141.558,
    "duration": 6.754
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "将本色民间曲辞与尖锐冲突结合，无愧世界大悲剧之赞誉。",
    "start": 141.573,
    "end": 146.976,
    "duration": 5.403
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：王国维《宋元戏曲考》盛赞“即列之于世界大悲剧中，亦无愧色也”；",
    "start": 147.456,
    "end": 153.468,
    "duration": 6.012
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "注意第三折高潮曲牌为【滚绣球】，三桩誓愿为血溅白练、六月飞雪、亢旱三年。",
    "start": 153.746,
    "end": 160.558,
    "duration": 6.812
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 回答 2020 真题：《窦娥冤》为什么“含冤而死”，又为什么能“感天动地”？",
    "start": 161.266,
    "end": 167.918,
    "duration": 6.652
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 说出赛卢医、张驴儿、桃杌的作恶链条，以及三桩誓愿与【滚绣球】唱词？",
    "start": 168.385,
    "end": 174.877,
    "duration": 6.492
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 王国维《宋元戏曲考》对全剧给出什么至高定位？",
    "start": 175.339,
    "end": 180.071,
    "duration": 4.732
  }
]