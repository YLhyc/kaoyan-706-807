[
  {
    "id": 1,
    "text": "试论屈原《离骚》的思想意蕴与艺术成就。",
    "start": 0.16,
    "end": 3.361,
    "duration": 3.201
  },
  {
    "id": 2,
    "text": "《离骚》是中国古典文学史上篇幅宏大、抒情深沉的浪漫主义政治抒情长诗。",
    "start": 3.774,
    "end": 10.06,
    "duration": 6.286
  },
  {
    "id": 3,
    "text": "面对战国中后期楚国贵族腐朽、强秦逼迫的危局，",
    "start": 10.302,
    "end": 14.321,
    "duration": 4.019
  },
  {
    "id": 4,
    "text": "屈原打破了先秦诗歌集体歌唱与四言短小的格局，",
    "start": 14.782,
    "end": 18.948,
    "duration": 4.166
  },
  {
    "id": 5,
    "text": "树立了个体抒情主人公峻洁崇高的艺术形象。",
    "start": 19.229,
    "end": 22.945,
    "duration": 3.716
  },
  {
    "id": 6,
    "text": "司马迁在《史记·屈原贾生列传》中推崇备至，称其“虽与日月争光可也”。",
    "start": 23.538,
    "end": 29.966,
    "duration": 6.428
  },
  {
    "id": 7,
    "text": "其思想意蕴与艺术成就，主要体现在以下四个方面：",
    "start": 30.229,
    "end": 34.078,
    "duration": 3.849
  },
  {
    "id": 8,
    "text": "第一，确立“美政”政治理想，展现至死不渝的爱国忠贞与气节。",
    "start": 34.706,
    "end": 40.149,
    "duration": 5.443
  },
  {
    "id": 9,
    "text": "《离骚》的思想灵魂是屈原贯彻终生的“美政”理想，",
    "start": 40.612,
    "end": 44.378,
    "duration": 3.766
  },
  {
    "id": 10,
    "text": "即主张修明法度、举贤授能，明君贤臣共兴楚国。",
    "start": 44.966,
    "end": 49.691,
    "duration": 4.725
  },
  {
    "id": 11,
    "text": "面对楚国政局黑暗与宗国危殆，诗人怀抱深沉忧患，",
    "start": 50.179,
    "end": 54.541,
    "duration": 4.362
  },
  {
    "id": 12,
    "text": "发出“长太息以掩涕兮，哀民生之多艰”的悲切叹息。",
    "start": 54.783,
    "end": 59.828,
    "duration": 5.045
  },
  {
    "id": 13,
    "text": "即便惨遭党人谗害、君王疏远，他依然洁身自好、不随波逐流；",
    "start": 60.114,
    "end": 65.18,
    "duration": 5.066
  },
  {
    "id": 14,
    "text": "面对权贵围攻，诗人以决绝意志誓守人格操守，宣告“亦余心之所善兮，虽九死其犹未悔”。",
    "start": 65.434,
    "end": 73.924,
    "duration": 8.49
  },
  {
    "id": 15,
    "text": "这种将个体生命与祖国存亡紧系于一体的精神，铸就了古代士人崇高的忠贞气节。",
    "start": 74.261,
    "end": 80.836,
    "duration": 6.575
  },
  {
    "id": 16,
    "text": "第二，拓展比兴寄托传统，开创系统的“香草美人”象征体系。",
    "start": 81.476,
    "end": 87.083,
    "duration": 5.607
  },
  {
    "id": 17,
    "text": "屈原发展了《诗经》早期的比兴手法，建立起高度成熟的政治道德象征体系。",
    "start": 87.514,
    "end": 93.079,
    "duration": 5.565
  },
  {
    "id": 18,
    "text": "他以芳草嘉木、世俗男女寄寓高尚情操与君臣遇合：",
    "start": 93.491,
    "end": 97.883,
    "duration": 4.392
  },
  {
    "id": 19,
    "text": "全诗以辟芷、秋兰、木兰、宿莽等香草，象征自身纯洁志行与治国才能，",
    "start": 98.529,
    "end": 105.291,
    "duration": 6.762
  },
  {
    "id": 20,
    "text": "名句“朝饮木兰之坠露兮，夕餐秋菊之落英”生动呈现出其峻洁拔俗的修养；",
    "start": 105.433,
    "end": 112.485,
    "duration": 7.052
  },
  {
    "id": 21,
    "text": "与之相对，以萧艾等恶草比喻贪婪短视的谗谄宵小，以“美人”或求女寄托贤君知己之思。",
    "start": 112.737,
    "end": 121.262,
    "duration": 8.525
  },
  {
    "id": 22,
    "text": "这一象征体系使古典诗歌意象由单一物象比附，升华为蕴含人格理想与政治寓托的艺术符号。",
    "start": 121.511,
    "end": 129.623,
    "duration": 8.112
  },
  {
    "id": 23,
    "text": "第三，构筑虚实相生的宏伟构架，交织现实受挫与天界神游。",
    "start": 130.267,
    "end": 136.307,
    "duration": 6.04
  },
  {
    "id": 24,
    "text": "《离骚》在篇章结构上展现出奇伟的想象力，形成现实沉沦与幻想飞升交织的壮阔波澜。",
    "start": 136.768,
    "end": 144.317,
    "duration": 7.549
  },
  {
    "id": 25,
    "text": "全诗前半部分立足现实，自叙高贵出身、修身自励与遭谗被弃的悲愤；",
    "start": 144.659,
    "end": 150.981,
    "duration": 6.322
  },
  {
    "id": 26,
    "text": "后半部分笔锋飞升，借助神话传说展开天界上下求索。",
    "start": 151.229,
    "end": 156.104,
    "duration": 4.875
  },
  {
    "id": 27,
    "text": "诗人命羲和弭节、使望舒先驱、驾飞龙鸾凤叩击九重天门，",
    "start": 156.781,
    "end": 162.183,
    "duration": 5.402
  },
  {
    "id": 28,
    "text": "求女不遂后又从灵氛、巫咸之占寻找出路；",
    "start": 162.696,
    "end": 166.117,
    "duration": 3.421
  },
  {
    "id": 29,
    "text": "但当飞升云霓之上、俯瞰故土宗国之时，诗篇写道“陟升皇之赫戏兮，忽临睨夫旧乡”，",
    "start": 166.612,
    "end": 174.579,
    "duration": 7.967
  },
  {
    "id": 30,
    "text": "仆夫悲、马怀顾而不行，最终从神幻天界剧烈跌回现实悲剧，产生震撼人心的悲壮力量。",
    "start": 174.764,
    "end": 182.371,
    "duration": 7.607
  },
  {
    "id": 31,
    "text": "第四，创立骚体全新诗体，展现参差流转的语言张力与楚地声韵。",
    "start": 183.051,
    "end": 188.815,
    "duration": 5.764
  },
  {
    "id": 32,
    "text": "《离骚》在体式上打破了《诗经》四言为主的整齐格局。",
    "start": 189.117,
    "end": 192.916,
    "duration": 3.799
  },
  {
    "id": 33,
    "text": "屈原吸收楚地民歌与巫祭乐歌养分，创立了句式长短错落、舒卷自由的“骚体”，",
    "start": 193.316,
    "end": 200.078,
    "duration": 6.762
  },
  {
    "id": 34,
    "text": "全诗广泛运用荆楚方言语气词“兮”字调节声律。",
    "start": 200.464,
    "end": 204.492,
    "duration": 4.028
  },
  {
    "id": 35,
    "text": "“兮”字置于句中或句末，拖长了叹息与呼告的语流，营造出长歌当哭、凄婉回环的音乐节奏；",
    "start": 204.73,
    "end": 212.321,
    "duration": 7.591
  },
  {
    "id": 36,
    "text": "加之方言名物、双声叠韵与华美词采的融汇，",
    "start": 212.506,
    "end": 215.971,
    "duration": 3.465
  },
  {
    "id": 37,
    "text": "不仅直接孕育了汉代辞赋的产生，更极大地拓宽了中国古典诗歌的表现疆域。",
    "start": 216.01,
    "end": 221.907,
    "duration": 5.897
  },
  {
    "id": 38,
    "text": "由是观之，屈原在《离骚》中以楚国危局下的美政坚守为核心，",
    "start": 222.105,
    "end": 227.352,
    "duration": 5.247
  },
  {
    "id": 39,
    "text": "凭借“香草美人”象征体系、天界神游构架与回环流动的骚体句式，",
    "start": 227.769,
    "end": 233.286,
    "duration": 5.517
  },
  {
    "id": 40,
    "text": "完成了由先秦集体歌谣向文人个体抒情长诗的历史跨越。",
    "start": 233.63,
    "end": 238.507,
    "duration": 4.877
  },
  {
    "id": 41,
    "text": "作品所蕴含的九死未悔忠贞气节与奇伟瑰丽辞采，不仅直接孕育了汉代辞赋，",
    "start": 238.904,
    "end": 245.406,
    "duration": 6.502
  },
  {
    "id": 42,
    "text": "更在后世文人心灵中积淀为深厚的忧国爱国传统。",
    "start": 245.652,
    "end": 249.989,
    "duration": 4.337
  }
]