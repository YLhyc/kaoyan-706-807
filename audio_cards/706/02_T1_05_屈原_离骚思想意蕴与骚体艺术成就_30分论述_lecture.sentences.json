[
  {
    "id": 1,
    "text": "试论屈原《离骚》的思想意蕴与艺术成就。",
    "start": 0.16,
    "end": 3.361,
    "duration": 3.201
  },
  {
    "id": 2,
    "text": "《离骚》是中国古典文学史上篇幅宏大、抒情深沉的浪漫主义政治抒情长诗。",
    "start": 3.861,
    "end": 10.147,
    "duration": 6.286
  },
  {
    "id": 3,
    "text": "面对战国中后期楚国贵族腐朽、强秦逼迫的危局，屈原打破了先秦诗歌集体歌唱与四言短小的格局，",
    "start": 10.647,
    "end": 19.293,
    "duration": 8.646
  },
  {
    "id": 4,
    "text": "树立了个体抒情主人公峻洁崇高的艺术形象。",
    "start": 19.643,
    "end": 23.206,
    "duration": 3.563
  },
  {
    "id": 5,
    "text": "司马迁在《史记·屈原贾生列传》中推崇备至，称其“虽与日月争光可也”。",
    "start": 23.923,
    "end": 30.351,
    "duration": 6.428
  },
  {
    "id": 6,
    "text": "其思想意蕴与艺术成就，主要体现在以下四个方面：",
    "start": 30.851,
    "end": 34.7,
    "duration": 3.849
  },
  {
    "id": 7,
    "text": "第一，确立“美政”政治理想，展现至死不渝的爱国忠贞与气节。",
    "start": 35.328,
    "end": 40.771,
    "duration": 5.443
  },
  {
    "id": 8,
    "text": "《离骚》的思想灵魂是屈原贯彻终生的“美政”理想，",
    "start": 41.271,
    "end": 45.018,
    "duration": 3.747
  },
  {
    "id": 9,
    "text": "即主张修明法度、举贤授能，明君贤臣共兴楚国。",
    "start": 45.625,
    "end": 50.35,
    "duration": 4.725
  },
  {
    "id": 10,
    "text": "面对楚国政局黑暗与宗国危殆，诗人怀抱深沉忧患，发出“长太息以掩涕兮，哀民生之多艰”的悲切叹息。",
    "start": 50.85,
    "end": 60.499,
    "duration": 9.649
  },
  {
    "id": 11,
    "text": "即便惨遭党人谗害、君王疏远，他依然洁身自好、不随波逐流；",
    "start": 60.999,
    "end": 66.065,
    "duration": 5.066
  },
  {
    "id": 12,
    "text": "面对权贵围攻，诗人以决绝意志誓守人格操守，宣告“亦余心之所善兮，虽九死其犹未悔”。",
    "start": 66.565,
    "end": 75.055,
    "duration": 8.49
  },
  {
    "id": 13,
    "text": "这种将个体生命与祖国存亡紧系于一体的精神，铸就了古代士人崇高的忠贞气节。",
    "start": 75.555,
    "end": 82.13,
    "duration": 6.575
  },
  {
    "id": 14,
    "text": "第二，拓展比兴寄托传统，开创系统的“香草美人”象征体系。",
    "start": 82.77,
    "end": 88.377,
    "duration": 5.607
  },
  {
    "id": 15,
    "text": "屈原发展了《诗经》早期的比兴手法，建立起高度成熟的政治道德象征体系。",
    "start": 88.877,
    "end": 94.442,
    "duration": 5.565
  },
  {
    "id": 16,
    "text": "他以芳草嘉木、世俗男女寄寓高尚情操与君臣遇合：",
    "start": 94.942,
    "end": 99.334,
    "duration": 4.392
  },
  {
    "id": 17,
    "text": "全诗以辟芷、秋兰、木兰、宿莽等香草，象征自身纯洁志行与治国才能，",
    "start": 99.98,
    "end": 106.742,
    "duration": 6.762
  },
  {
    "id": 18,
    "text": "名句“朝饮木兰之坠露兮，夕餐秋菊之落英”生动呈现出其峻洁拔俗的修养；",
    "start": 107.092,
    "end": 114.144,
    "duration": 7.052
  },
  {
    "id": 19,
    "text": "与之相对，以萧艾等恶草比喻贪婪短视的谗谄宵小，以“美人”或求女寄托贤君知己之思。",
    "start": 114.644,
    "end": 123.169,
    "duration": 8.525
  },
  {
    "id": 20,
    "text": "这一象征体系使古典诗歌意象由单一物象比附，升华为蕴含人格理想与政治寓托的艺术符号。",
    "start": 123.669,
    "end": 131.781,
    "duration": 8.112
  },
  {
    "id": 21,
    "text": "第三，构筑虚实相生的宏伟构架，交织现实受挫与天界神游。",
    "start": 132.425,
    "end": 138.465,
    "duration": 6.04
  },
  {
    "id": 22,
    "text": "《离骚》在篇章结构上展现出奇伟的想象力，形成现实沉沦与幻想飞升交织的壮阔波澜。",
    "start": 138.965,
    "end": 146.514,
    "duration": 7.549
  },
  {
    "id": 23,
    "text": "全诗前半部分立足现实，自叙高贵出身、修身自励与遭谗被弃的悲愤；",
    "start": 147.014,
    "end": 153.336,
    "duration": 6.322
  },
  {
    "id": 24,
    "text": "后半部分笔锋飞升，借助神话传说展开天界上下求索。",
    "start": 153.836,
    "end": 158.711,
    "duration": 4.875
  },
  {
    "id": 25,
    "text": "诗人命羲和弭节、使望舒先驱、驾飞龙鸾凤叩击九重天门，",
    "start": 159.388,
    "end": 164.79,
    "duration": 5.402
  },
  {
    "id": 26,
    "text": "求女不遂后又从灵氛、巫咸之占寻找出路；",
    "start": 165.303,
    "end": 168.724,
    "duration": 3.421
  },
  {
    "id": 27,
    "text": "但当飞升云霓之上、俯瞰故土宗国之时，诗篇写道“陟升皇之赫戏兮，忽临睨夫旧乡”，",
    "start": 169.224,
    "end": 177.191,
    "duration": 7.967
  },
  {
    "id": 28,
    "text": "仆夫悲、马怀顾而不行，最终从神幻天界剧烈跌回现实悲剧，产生震撼人心的悲壮力量。",
    "start": 177.541,
    "end": 185.148,
    "duration": 7.607
  },
  {
    "id": 29,
    "text": "第四，创立骚体全新诗体，展现参差流转的语言张力与楚地声韵。",
    "start": 185.828,
    "end": 191.592,
    "duration": 5.764
  },
  {
    "id": 30,
    "text": "《离骚》在体式上打破了《诗经》四言为主的整齐格局。",
    "start": 192.092,
    "end": 195.891,
    "duration": 3.799
  },
  {
    "id": 31,
    "text": "屈原吸收楚地民歌与巫祭乐歌养分，创立了句式长短错落、舒卷自由的“骚体”，",
    "start": 196.391,
    "end": 203.153,
    "duration": 6.762
  },
  {
    "id": 32,
    "text": "全诗广泛运用荆楚方言语气词“兮”字调节声律。",
    "start": 203.539,
    "end": 207.567,
    "duration": 4.028
  },
  {
    "id": 33,
    "text": "“兮”字置于句中或句末，拖长了叹息与呼告的语流，营造出长歌当哭、凄婉回环的音乐节奏；",
    "start": 208.067,
    "end": 215.658,
    "duration": 7.591
  },
  {
    "id": 34,
    "text": "加之方言名物、双声叠韵与华美词采的融汇，",
    "start": 216.158,
    "end": 219.623,
    "duration": 3.465
  },
  {
    "id": 35,
    "text": "不仅直接孕育了汉代辞赋的产生，更极大地拓宽了中国古典诗歌的表现疆域。",
    "start": 219.973,
    "end": 225.87,
    "duration": 5.897
  },
  {
    "id": 36,
    "text": "由是观之，屈原在《离骚》中以楚国危局下的美政坚守为核心，",
    "start": 226.37,
    "end": 231.351,
    "duration": 4.981
  },
  {
    "id": 37,
    "text": "凭借“香草美人”象征体系、天界神游构架与回环流动的骚体句式，",
    "start": 231.768,
    "end": 237.275,
    "duration": 5.507
  },
  {
    "id": 38,
    "text": "完成了由先秦集体歌谣向文人个体抒情长诗的历史跨越。",
    "start": 237.629,
    "end": 242.496,
    "duration": 4.867
  },
  {
    "id": 39,
    "text": "作品所蕴含的九死未悔忠贞气节与奇伟瑰丽辞采，不仅直接孕育了汉代辞赋，",
    "start": 242.996,
    "end": 249.468,
    "duration": 6.472
  },
  {
    "id": 40,
    "text": "更在后世文人心灵中积淀为深厚的忧国爱国传统。",
    "start": 249.818,
    "end": 254.135,
    "duration": 4.317
  }
]
