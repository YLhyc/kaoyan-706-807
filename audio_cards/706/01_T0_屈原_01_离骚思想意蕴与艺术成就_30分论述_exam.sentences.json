[
  {
    "id": 1,
    "text": "《离骚》是中国古代文学史上篇幅最宏大、",
    "start": 0.0,
    "end": 3.311,
    "duration": 3.311
  },
  {
    "id": 2,
    "text": "抒情最深沉的浪漫主义政治抒情长诗。",
    "start": 3.311,
    "end": 6.623,
    "duration": 3.312
  },
  {
    "id": 3,
    "text": "司马迁在《史记•屈原贾生列传》中推崇备至：“推此志也，",
    "start": 6.623,
    "end": 10.969,
    "duration": 4.346
  },
  {
    "id": 4,
    "text": "虽与日月争光可也”。",
    "start": 10.969,
    "end": 12.624,
    "duration": 1.655
  },
  {
    "id": 5,
    "text": "袁行配《中国文学史》指出，《离骚》打破了先秦诗歌集体歌唱与篇幅简短的格局。",
    "start": 12.624,
    "end": 19.04,
    "duration": 6.416
  },
  {
    "id": 6,
    "text": "它首次树立起一个崇高峻洁、坚守真理的伟大抒情主人公形象。",
    "start": 19.12,
    "end": 24.64,
    "duration": 5.52
  },
  {
    "id": 7,
    "text": "其博大深邃的思想意蕴与杰出的艺术成就，",
    "start": 24.64,
    "end": 28.24,
    "duration": 3.6
  },
  {
    "id": 8,
    "text": "主要展现为以下四个核心维度：《离骚》的思想灵魂是屈原贯穿一生的“美政”政治理想。",
    "start": 28.24,
    "end": 35.12,
    "duration": 6.88
  },
  {
    "id": 9,
    "text": "所谓美政，即主张圣君贤相、修明法度、",
    "start": 35.12,
    "end": 38.64,
    "duration": 3.52
  },
  {
    "id": 10,
    "text": "任人唯贤并以黎民苍生为念。",
    "start": 38.64,
    "end": 40.96,
    "duration": 2.32
  },
  {
    "id": 11,
    "text": "面对楚国贵族集团结党营私与宗国危殆，",
    "start": 41.2,
    "end": 45.2,
    "duration": 4.0
  },
  {
    "id": 12,
    "text": "诗人满怀深情写道：“长太息以掩涕兮，",
    "start": 45.2,
    "end": 49.36,
    "duration": 4.16
  },
  {
    "id": 13,
    "text": "哀民生之多艰”。",
    "start": 49.36,
    "end": 50.8,
    "duration": 1.44
  },
  {
    "id": 14,
    "text": "即便自身惨遭缠产放逐，他依然对楚国命运怀抱刻骨铭心的忧患与深情。",
    "start": 50.8,
    "end": 57.6,
    "duration": 6.8
  },
  {
    "id": 15,
    "text": "面对权贵的围攻与威逼，诗人以九死不悔的决绝誓死捍卫人格：“亦余心之所善兮，",
    "start": 57.6,
    "end": 65.12,
    "duration": 7.52
  },
  {
    "id": 16,
    "text": "虽九死其犹未悔”。",
    "start": 65.12,
    "end": 66.88,
    "duration": 1.76
  },
  {
    "id": 17,
    "text": "这种将个体生命与祖国存亡生死相连的爱国忠贞，",
    "start": 67.2,
    "end": 71.28,
    "duration": 4.08
  },
  {
    "id": 18,
    "text": "铸就了中华民族士人的精神脊梁。",
    "start": 71.28,
    "end": 74.24,
    "duration": 2.96
  },
  {
    "id": 19,
    "text": "屈原极大拓展了《诗经》的比兴手法，",
    "start": 74.24,
    "end": 76.88,
    "duration": 2.64
  },
  {
    "id": 20,
    "text": "开创了完备的“香草美人”象征体系。",
    "start": 76.88,
    "end": 80.0,
    "duration": 3.12
  },
  {
    "id": 21,
    "text": "他将原本无生命的自然草木与世俗男女，",
    "start": 80.0,
    "end": 83.44,
    "duration": 3.44
  },
  {
    "id": 22,
    "text": "赋予了极其崇高的政治道德内涵。",
    "start": 83.44,
    "end": 85.92,
    "duration": 2.48
  },
  {
    "id": 23,
    "text": "全诗以辟芷、秋兰、木兰、秋菊等嘉草繁花，",
    "start": 86.32,
    "end": 91.2,
    "duration": 4.88
  },
  {
    "id": 24,
    "text": "象征自身纯洁高尚的情操与治国才具。",
    "start": 91.2,
    "end": 94.8,
    "duration": 3.6
  },
  {
    "id": 25,
    "text": "诗中名句写道：“朝饮木兰之坠露兮，",
    "start": 94.8,
    "end": 98.56,
    "duration": 3.76
  },
  {
    "id": 26,
    "text": "夕餐秋菊之落英”，生动呈现其峻洁拔俗的生命追求。",
    "start": 98.56,
    "end": 103.68,
    "duration": 5.12
  },
  {
    "id": 27,
    "text": "与此同时，诗人以艾草、萧艾等恶草恶木，",
    "start": 103.68,
    "end": 107.68,
    "duration": 4.0
  },
  {
    "id": 28,
    "text": "象征朝堂上贪婪短视的缠产宵小。",
    "start": 107.68,
    "end": 110.48,
    "duration": 2.8
  },
  {
    "id": 29,
    "text": "以“美人”寄托心驰神往的明君与求索未得的美政知己，",
    "start": 110.88,
    "end": 115.92,
    "duration": 5.04
  },
  {
    "id": 30,
    "text": "使政治抒情变得委婉缠绵。",
    "start": 115.92,
    "end": 118.16,
    "duration": 2.24
  },
  {
    "id": 31,
    "text": "这一体系使古典诗歌意象完成了由感官物象向崇高人格象征的伟大飞跃。",
    "start": 118.16,
    "end": 124.32,
    "duration": 6.16
  },
  {
    "id": 32,
    "text": "《离骚》在篇章构架上展现出飞腾壮丽的想象力，",
    "start": 124.32,
    "end": 128.24,
    "duration": 3.92
  },
  {
    "id": 33,
    "text": "构筑了虚实交织的宏大波澜。",
    "start": 128.24,
    "end": 130.48,
    "duration": 2.24
  },
  {
    "id": 34,
    "text": "前半部分立足于现实世界，沉痛自述高贵出身、",
    "start": 130.8,
    "end": 135.12,
    "duration": 4.32
  },
  {
    "id": 35,
    "text": "修身自励与遭缠见弃的政治悲剧。",
    "start": 135.12,
    "end": 138.16,
    "duration": 3.04
  },
  {
    "id": 36,
    "text": "后半部分笔锋骤然飞升，借助于神话传说展开天界与宇宙的自由驰骋。",
    "start": 138.16,
    "end": 144.96,
    "duration": 6.8
  },
  {
    "id": 37,
    "text": "诗人命羲和弭节、叫望舒先驱、驾飞龙鸾凤周流上下，",
    "start": 144.96,
    "end": 150.48,
    "duration": 5.52
  },
  {
    "id": 38,
    "text": "叩九重天门以求通达。",
    "start": 150.48,
    "end": 152.64,
    "duration": 2.16
  },
  {
    "id": 39,
    "text": "求女不遂后，诗人从灵氛之卜与巫咸之言，",
    "start": 153.016,
    "end": 157.016,
    "duration": 4.0
  },
  {
    "id": 40,
    "text": "在广袤宇宙间寻找精神出路。",
    "start": 157.016,
    "end": 159.736,
    "duration": 2.72
  },
  {
    "id": 41,
    "text": "然而正当飞升至云霓之上时，诗人猛然俯瞰故土宗国：“制升皇之赫戏兮，",
    "start": 159.736,
    "end": 166.616,
    "duration": 6.88
  },
  {
    "id": 42,
    "text": "忽临睨夫旧乡”。",
    "start": 166.616,
    "end": 168.296,
    "duration": 1.68
  },
  {
    "id": 43,
    "text": "驾车仆夫与所乘飞马皆悲鸣蜷局而不能前行，",
    "start": 168.296,
    "end": 172.856,
    "duration": 4.56
  },
  {
    "id": 44,
    "text": "最终从神幻九天剧烈跌回现实悲剧。",
    "start": 172.856,
    "end": 175.896,
    "duration": 3.04
  },
  {
    "id": 45,
    "text": "这种现实与神游的剧烈对撞，使全诗爆发出了震撼人心的悲壮力量。",
    "start": 176.136,
    "end": 182.296,
    "duration": 6.16
  },
  {
    "id": 46,
    "text": "《离骚》在体式形式上彻底打破了《诗经》四言为主的短促封闭格局。",
    "start": 182.296,
    "end": 187.896,
    "duration": 5.6
  },
  {
    "id": 47,
    "text": "屈原吸纳楚地民间歌谣的营养，创立了句式错落参差的全新诗体，",
    "start": 187.896,
    "end": 193.416,
    "duration": 5.52
  },
  {
    "id": 48,
    "text": "即“骚体”。",
    "start": 193.416,
    "end": 194.216,
    "duration": 0.8
  },
  {
    "id": 49,
    "text": "诗中大量运用具有鲜明荆楚地域色彩的助词“兮”字，",
    "start": 194.536,
    "end": 199.096,
    "duration": 4.56
  },
  {
    "id": 50,
    "text": "调节声律节奏。",
    "start": 199.096,
    "end": 200.616,
    "duration": 1.52
  },
  {
    "id": 51,
    "text": "“兮”字的延展呼告强化了长歌当哭的顿挫语流，",
    "start": 200.616,
    "end": 205.176,
    "duration": 4.56
  },
  {
    "id": 52,
    "text": "极具声泪俱下的悲凉音乐美。",
    "start": 205.176,
    "end": 207.736,
    "duration": 2.56
  },
  {
    "id": 53,
    "text": "在词汇运用上，《离骚》广泛吸纳方言土语、",
    "start": 207.736,
    "end": 211.336,
    "duration": 3.6
  },
  {
    "id": 54,
    "text": "双声叠韵与华美对仗。",
    "start": 211.336,
    "end": 213.576,
    "duration": 2.24
  },
  {
    "id": 55,
    "text": "这一文体创造不仅直接奠定了汉代辞赋的体制基础，",
    "start": 213.576,
    "end": 217.896,
    "duration": 4.32
  },
  {
    "id": 56,
    "text": "更极大地增强了诗歌的容量。",
    "start": 217.896,
    "end": 219.976,
    "duration": 2.08
  },
  {
    "id": 57,
    "text": "综上所述，《离骚》是中国古典文学浪漫主义艺术最崇高的源头活水。",
    "start": 220.216,
    "end": 225.576,
    "duration": 5.36
  },
  {
    "id": 58,
    "text": "它与《诗经》并称“风骚”，共同奠定了中国诗歌现实主义与浪漫主义的双重基石。",
    "start": 225.576,
    "end": 232.056,
    "duration": 6.48
  },
  {
    "id": 59,
    "text": "屈原所开创的美政理想、香草美人体系与上下求索的献身精神。",
    "start": 232.056,
    "end": 237.576,
    "duration": 5.52
  },
  {
    "id": 60,
    "text": "千百年来深远哺育了李白的豪放狂飙，",
    "start": 237.976,
    "end": 241.656,
    "duration": 3.68
  },
  {
    "id": 61,
    "text": "更成为历代爱国仁人志士的精神明灯。",
    "start": 241.656,
    "end": 244.616,
    "duration": 2.96
  }
]