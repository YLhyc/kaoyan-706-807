[
  {
    "id": 1,
    "text": "试论《西游记》的奇幻神话世界与审美特征。",
    "start": 0.16,
    "end": 3.313,
    "duration": 3.153
  },
  {
    "id": 2,
    "text": "《西游记》是中国古代长篇神魔小说的杰出代表，也是古典浪漫主义小说的艺术结晶。",
    "start": 3.872,
    "end": 10.02,
    "duration": 6.148
  },
  {
    "id": 3,
    "text": "在明代中后期心学流行、市民阶层壮大与个性意识高扬的文化背景下，",
    "start": 10.381,
    "end": 15.911,
    "duration": 5.53
  },
  {
    "id": 4,
    "text": "吴承恩依托玄奘取经的历史线索，融合宋元说话、戏曲与民间传说，",
    "start": 16.226,
    "end": 21.901,
    "duration": 5.675
  },
  {
    "id": 5,
    "text": "构筑了一个光怪陆离而又贴近世情的神魔世界。",
    "start": 22.131,
    "end": 25.981,
    "duration": 3.85
  },
  {
    "id": 6,
    "text": "鲁迅在《中国小说史略》中指出其艺术特质在于“神魔皆有人情，精魅亦通世故”。",
    "start": 26.294,
    "end": 33.222,
    "duration": 6.928
  },
  {
    "id": 7,
    "text": "全书奇幻世界的建构与审美特征，主要体现在以下四个方面：",
    "start": 33.497,
    "end": 38.178,
    "duration": 4.681
  },
  {
    "id": 8,
    "text": "第一，建构“极幻”与“极真”相融的神话世界，曲折折射社会现实。",
    "start": 38.806,
    "end": 44.42,
    "duration": 5.614
  },
  {
    "id": 9,
    "text": "《西游记》的奇幻构架根植于尘世生活，是现实人间的折光反射。",
    "start": 44.814,
    "end": 49.552,
    "duration": 4.738
  },
  {
    "id": 10,
    "text": "书中描绘的天宫、地府、龙宫与各处妖魔洞府，处处带有封建官僚体制的印记：",
    "start": 49.805,
    "end": 56.012,
    "duration": 6.207
  },
  {
    "id": 11,
    "text": "天庭等级森严，玉帝昏庸轻贤，判官可因魏徵一封书信而讲情变通；",
    "start": 56.195,
    "end": 61.889,
    "duration": 5.694
  },
  {
    "id": 12,
    "text": "取经路上的诸多妖魔鬼怪多为佛道仙尊的坐骑或童子，每逢危机便由后台主人出面领回免责；",
    "start": 62.471,
    "end": 70.061,
    "duration": 7.59
  },
  {
    "id": 13,
    "text": "比丘国君听信国丈残害幼童，车迟国道士蛊惑朝政、迫害僧侣。",
    "start": 70.512,
    "end": 75.946,
    "duration": 5.434
  },
  {
    "id": 14,
    "text": "作者借神魔世界之荒诞，对明代中叶皇权昏暗、官场徇私与厂卫横行的现实弊病作出了辛辣讽刺。",
    "start": 76.124,
    "end": 84.131,
    "duration": 8.007
  },
  {
    "id": 15,
    "text": "第二，塑造追求个性自由的孙悟空典型，统一物性、神性与人性。",
    "start": 84.778,
    "end": 90.369,
    "duration": 5.591
  },
  {
    "id": 16,
    "text": "孙悟空是全书最光彩照人的艺术形象，",
    "start": 90.852,
    "end": 93.818,
    "duration": 2.966
  },
  {
    "id": 17,
    "text": "集中体现了明代中后期反抗礼法拘束、张扬个性的时代思潮。",
    "start": 94.204,
    "end": 99.271,
    "duration": 5.067
  },
  {
    "id": 18,
    "text": "在前七回大闹天宫中，他因不满官居末流和虚衔受辱，",
    "start": 99.702,
    "end": 104.345,
    "duration": 4.643
  },
  {
    "id": 19,
    "text": "喊出“皇帝轮流做，明年到我家”的豪言，展现出冲破等级束缚的叛逆气概；",
    "start": 104.604,
    "end": 110.45,
    "duration": 5.846
  },
  {
    "id": 20,
    "text": "在取经途中，他历尽八十一难而不屈，成为降妖除魔、践行理想的英雄。",
    "start": 110.882,
    "end": 116.498,
    "duration": 5.616
  },
  {
    "id": 21,
    "text": "作者在孙悟空身上巧妙统一了“神性、人性与物性”：既有七十二变的神奇本领，",
    "start": 116.89,
    "end": 122.956,
    "duration": 6.066
  },
  {
    "id": 22,
    "text": "又保留毛脸雷公嘴、机敏好动的猴态，更有嫉恶如仇、重情守诺的人格光彩，生动而真实。",
    "start": 123.241,
    "end": 130.669,
    "duration": 7.428
  },
  {
    "id": 23,
    "text": "第三，融童真幻想与游戏笔墨于一体，形成奇幻而又诙谐的喜剧风貌。",
    "start": 131.322,
    "end": 138.093,
    "duration": 6.771
  },
  {
    "id": 24,
    "text": "《西游记》洋溢着天真活泼的想象力与“以戏言寓诸幻笔”的喜剧气息。",
    "start": 138.73,
    "end": 144.491,
    "duration": 5.761
  },
  {
    "id": 25,
    "text": "取经师徒四人性格迥异而又形成戏剧反差：唐僧善良执着而略显迂腐，",
    "start": 144.767,
    "end": 151.172,
    "duration": 6.405
  },
  {
    "id": 26,
    "text": "孙悟空机警高傲而急躁，猪八戒贪吃好色、好吹大话而又憨厚富有人情味，沙僧忠厚勤恳。",
    "start": 151.566,
    "end": 159.495,
    "duration": 7.929
  },
  {
    "id": 27,
    "text": "八戒与行者一路上的插科打诨、斗嘴取笑，以及作者把玉帝、如来、妖魔写得如同市井凡人的戏谑笔墨，",
    "start": 159.861,
    "end": 168.497,
    "duration": 8.636
  },
  {
    "id": 28,
    "text": "冲淡了宗教说教的枯燥呆板，使凶险漫长的取经路途充满了机趣幽默与人间欢笑。",
    "start": 168.862,
    "end": 175.734,
    "duration": 6.872
  },
  {
    "id": 29,
    "text": "第四，贯通三教合一的心学寓意，构筑“放心、定心、修心”的精神隐喻。",
    "start": 176.33,
    "end": 182.109,
    "duration": 5.779
  },
  {
    "id": 30,
    "text": "在深层哲理意蕴上，《西游记》融汇了明代儒、释、道三教合一的心学思想，暗含修心炼性的寓言结构。",
    "start": 182.394,
    "end": 190.925,
    "duration": 8.531
  },
  {
    "id": 31,
    "text": "书中孙悟空号称“心猿”，猪八戒别称“木母”，白龙马喻“意马”，",
    "start": 191.242,
    "end": 196.213,
    "duration": 4.971
  },
  {
    "id": 32,
    "text": "西牛贺洲学艺处名为“灵台方寸山，斜月三星洞”，皆暗指人心。",
    "start": 196.607,
    "end": 202.292,
    "duration": 5.685
  },
  {
    "id": 33,
    "text": "全书由大闹天宫的“放心”，经五行山下的“定心”，",
    "start": 202.522,
    "end": 206.617,
    "duration": 4.095
  },
  {
    "id": 34,
    "text": "到西行取经扫除心魔、最终成佛的“修心”历程，",
    "start": 206.936,
    "end": 210.826,
    "duration": 3.89
  },
  {
    "id": 35,
    "text": "使神魔历险具备了克制私欲、磨砺心志的哲理厚度，成为清代神怪小说的典范先声。",
    "start": 211.013,
    "end": 218.553,
    "duration": 7.54
  },
  {
    "id": 36,
    "text": "总而言之，《西游记》融汇民间取经传说与晚明心学思潮，",
    "start": 218.785,
    "end": 223.442,
    "duration": 4.657
  },
  {
    "id": 37,
    "text": "在“极幻”的神魔奇境中灌注“极真”的人情世态，",
    "start": 223.731,
    "end": 227.242,
    "duration": 3.511
  },
  {
    "id": 38,
    "text": "塑造出机智叛逆、历经磨砺而不失本心的孙悟空形象。",
    "start": 227.603,
    "end": 231.862,
    "duration": 4.259
  },
  {
    "id": 39,
    "text": "作品以童真幻想与诙谐游戏笔墨冲淡了说教的枯燥，",
    "start": 232.118,
    "end": 236.053,
    "duration": 3.935
  },
  {
    "id": 40,
    "text": "将神怪历险升华为“修心”寓言，",
    "start": 236.432,
    "end": 238.822,
    "duration": 2.39
  },
  {
    "id": 41,
    "text": "在中国古代长篇神魔小说史上树立起独树一帜的喜剧浪漫典范。",
    "start": 239.011,
    "end": 244.101,
    "duration": 5.09
  }
]