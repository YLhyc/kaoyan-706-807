[
  {
    "id": 1,
    "text": "试论《西游记》的奇幻神话世界与审美特征。",
    "start": 0.16,
    "end": 3.303,
    "duration": 3.143
  },
  {
    "id": 2,
    "text": "《西游记》是中国古代长篇神魔小说的杰出代表，",
    "start": 3.872,
    "end": 7.285,
    "duration": 3.413
  },
  {
    "id": 3,
    "text": "也是古典浪漫主义小说的艺术结晶。",
    "start": 7.427,
    "end": 10.011,
    "duration": 2.584
  },
  {
    "id": 4,
    "text": "在明代中后期心学流行、",
    "start": 10.381,
    "end": 12.236,
    "duration": 1.855
  },
  {
    "id": 5,
    "text": "市民阶层壮大与个性意识高扬的文化背景下，",
    "start": 12.623,
    "end": 15.901,
    "duration": 3.278
  },
  {
    "id": 6,
    "text": "吴承恩依托玄奘取经的历史线索，融合宋元说话、",
    "start": 16.226,
    "end": 20.039,
    "duration": 3.813
  },
  {
    "id": 7,
    "text": "戏曲与民间传说，",
    "start": 20.353,
    "end": 21.891,
    "duration": 1.538
  },
  {
    "id": 8,
    "text": "构筑了一个光怪陆离而又贴近世情的神魔世界。",
    "start": 22.131,
    "end": 25.982,
    "duration": 3.851
  },
  {
    "id": 9,
    "text": "鲁迅在《中国小说史略》中指出其艺术特质在于“神魔皆有人情，",
    "start": 26.294,
    "end": 31.783,
    "duration": 5.489
  },
  {
    "id": 10,
    "text": "精魅亦通世故”。",
    "start": 31.96,
    "end": 33.212,
    "duration": 1.252
  },
  {
    "id": 11,
    "text": "全书奇幻世界的建构与审美特征，主要体现在以下四个方面：",
    "start": 33.497,
    "end": 38.175,
    "duration": 4.678
  },
  {
    "id": 12,
    "text": "第一，建构“极幻”与“极真”相融的神话世界，",
    "start": 38.806,
    "end": 42.28,
    "duration": 3.474
  },
  {
    "id": 13,
    "text": "曲折折射社会现实。",
    "start": 42.777,
    "end": 44.41,
    "duration": 1.633
  },
  {
    "id": 14,
    "text": "《西游记》的奇幻构架根植于尘世生活，是现实人间的折光反射。",
    "start": 44.814,
    "end": 49.542,
    "duration": 4.728
  },
  {
    "id": 15,
    "text": "书中描绘的天宫、地府、龙宫与各处妖魔洞府，",
    "start": 49.805,
    "end": 53.701,
    "duration": 3.896
  },
  {
    "id": 16,
    "text": "处处带有封建官僚体制的印记：天庭等级森严，玉帝昏庸轻贤，",
    "start": 53.928,
    "end": 58.873,
    "duration": 4.945
  },
  {
    "id": 17,
    "text": "判官可因魏徵一封书信而讲情变通；",
    "start": 59.114,
    "end": 61.879,
    "duration": 2.765
  },
  {
    "id": 18,
    "text": "取经路上的诸多妖魔鬼怪多为佛道仙尊的坐骑或童子，",
    "start": 62.471,
    "end": 66.549,
    "duration": 4.078
  },
  {
    "id": 19,
    "text": "每逢危机便由后台主人出面领回免责；",
    "start": 66.941,
    "end": 70.051,
    "duration": 3.11
  },
  {
    "id": 20,
    "text": "比丘国君听信国丈残害幼童，车迟国道士蛊惑朝政、迫害僧侣。",
    "start": 70.512,
    "end": 75.936,
    "duration": 5.424
  },
  {
    "id": 21,
    "text": "作者借神魔世界之荒诞，对明代中叶皇权昏暗、",
    "start": 76.124,
    "end": 79.774,
    "duration": 3.65
  },
  {
    "id": 22,
    "text": "官场徇私与厂卫横行的现实弊病作出了辛辣讽刺。",
    "start": 80.004,
    "end": 84.117,
    "duration": 4.113
  },
  {
    "id": 23,
    "text": "第二，塑造追求个性自由的孙悟空典型，统一物性、神性与人性。",
    "start": 84.778,
    "end": 90.359,
    "duration": 5.581
  },
  {
    "id": 24,
    "text": "孙悟空是全书最光彩照人的艺术形象，",
    "start": 90.852,
    "end": 93.808,
    "duration": 2.956
  },
  {
    "id": 25,
    "text": "集中体现了明代中后期反抗礼法拘束、张扬个性的时代思潮。",
    "start": 94.204,
    "end": 99.273,
    "duration": 5.069
  },
  {
    "id": 26,
    "text": "在前七回大闹天宫中，他因不满官居末流和虚衔受辱，",
    "start": 99.702,
    "end": 104.335,
    "duration": 4.633
  },
  {
    "id": 27,
    "text": "喊出“皇帝轮流做，明年到我家”的豪言，",
    "start": 104.604,
    "end": 107.822,
    "duration": 3.218
  },
  {
    "id": 28,
    "text": "展现出冲破等级束缚的叛逆气概；在取经途中，",
    "start": 108.078,
    "end": 111.786,
    "duration": 3.708
  },
  {
    "id": 29,
    "text": "他历尽八十一难而不屈，成为降妖除魔、践行理想的英雄。",
    "start": 112.075,
    "end": 116.488,
    "duration": 4.413
  },
  {
    "id": 30,
    "text": "作者在孙悟空身上巧妙统一了“神性、人性与物性”：",
    "start": 116.89,
    "end": 120.881,
    "duration": 3.991
  },
  {
    "id": 31,
    "text": "既有七十二变的神奇本领，又保留毛脸雷公嘴、",
    "start": 121.256,
    "end": 124.758,
    "duration": 3.502
  },
  {
    "id": 32,
    "text": "机敏好动的猴态，更有嫉恶如仇、重情守诺的人格光彩，",
    "start": 125.016,
    "end": 129.497,
    "duration": 4.481
  },
  {
    "id": 33,
    "text": "生动而真实。",
    "start": 129.773,
    "end": 130.659,
    "duration": 0.886
  },
  {
    "id": 34,
    "text": "第三，融童真幻想与游戏笔墨于一体，",
    "start": 131.322,
    "end": 135.062,
    "duration": 3.74
  },
  {
    "id": 35,
    "text": "形成奇幻而又诙谐的喜剧风貌。",
    "start": 135.506,
    "end": 138.083,
    "duration": 2.577
  },
  {
    "id": 36,
    "text": "《西游记》洋溢着天真活泼的想象力与“以戏言寓诸幻笔”的喜剧气息。",
    "start": 138.73,
    "end": 144.481,
    "duration": 5.751
  },
  {
    "id": 37,
    "text": "取经师徒四人性格迥异而又形成戏剧反差：",
    "start": 144.767,
    "end": 148.258,
    "duration": 3.491
  },
  {
    "id": 38,
    "text": "唐僧善良执着而略显迂腐，孙悟空机警高傲而急躁，",
    "start": 148.816,
    "end": 153.545,
    "duration": 4.729
  },
  {
    "id": 39,
    "text": "猪八戒贪吃好色、好吹大话而又憨厚富有人情味，",
    "start": 153.79,
    "end": 158.03,
    "duration": 4.24
  },
  {
    "id": 40,
    "text": "沙僧忠厚勤恳。",
    "start": 158.242,
    "end": 159.485,
    "duration": 1.243
  },
  {
    "id": 41,
    "text": "八戒与行者一路上的插科打诨、斗嘴取笑，以及作者把玉帝、",
    "start": 159.861,
    "end": 164.445,
    "duration": 4.584
  },
  {
    "id": 42,
    "text": "如来、妖魔写得如同市井凡人的戏谑笔墨，",
    "start": 164.757,
    "end": 168.487,
    "duration": 3.73
  },
  {
    "id": 43,
    "text": "冲淡了宗教说教的枯燥呆板，",
    "start": 168.862,
    "end": 170.987,
    "duration": 2.125
  },
  {
    "id": 44,
    "text": "使凶险漫长的取经路途充满了机趣幽默与人间欢笑。",
    "start": 171.202,
    "end": 175.724,
    "duration": 4.522
  },
  {
    "id": 45,
    "text": "第四，贯通三教合一的心学寓意，构筑“放心、定心、",
    "start": 176.33,
    "end": 180.353,
    "duration": 4.023
  },
  {
    "id": 46,
    "text": "修心”的精神隐喻。",
    "start": 180.489,
    "end": 182.325,
    "duration": 1.836
  },
  {
    "id": 47,
    "text": "在深层哲理意蕴上，《西游记》融汇了明代儒、释、",
    "start": 182.412,
    "end": 185.867,
    "duration": 3.455
  },
  {
    "id": 48,
    "text": "道三教合一的心学思想，暗含修心炼性的寓言结构。",
    "start": 186.052,
    "end": 190.915,
    "duration": 4.863
  },
  {
    "id": 49,
    "text": "书中孙悟空号称“心猿”，猪八戒别称“木母”，",
    "start": 191.242,
    "end": 194.802,
    "duration": 3.56
  },
  {
    "id": 50,
    "text": "白龙马喻“意马”，花果山学艺处名为“灵台方寸山，",
    "start": 195.048,
    "end": 199.41,
    "duration": 4.362
  },
  {
    "id": 51,
    "text": "斜月三星洞”，皆暗指人心。",
    "start": 199.496,
    "end": 201.689,
    "duration": 2.193
  },
  {
    "id": 52,
    "text": "全书由大闹天宫的“放心”，经五行山下的“定心”，",
    "start": 201.929,
    "end": 206.014,
    "duration": 4.085
  },
  {
    "id": 53,
    "text": "到西行取经扫除心魔、最终成佛的“修心”历程，",
    "start": 206.343,
    "end": 210.223,
    "duration": 3.88
  },
  {
    "id": 54,
    "text": "使神魔历险具备了克制私欲、磨砺心志的哲理厚度，",
    "start": 210.42,
    "end": 215.113,
    "duration": 4.693
  },
  {
    "id": 55,
    "text": "成为清代神怪小说的典范先声。",
    "start": 215.284,
    "end": 217.96,
    "duration": 2.676
  }
]