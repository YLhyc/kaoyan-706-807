[
  {
    "id": 1,
    "text": "试论《西游记》的奇幻神话世界与审美特征。",
    "start": 0.2,
    "end": 3.48,
    "duration": 3.28
  },
  {
    "id": 2,
    "text": "《西游记》是中国古代长篇神魔小说的杰出代表，也是古典浪漫主义小说的艺术结晶。",
    "start": 4.0,
    "end": 10.794,
    "duration": 6.794
  },
  {
    "id": 3,
    "text": "在明代中后期心学流行、市民阶层壮大与个性意识高扬的文化背景下，",
    "start": 11.294,
    "end": 16.68,
    "duration": 5.386
  },
  {
    "id": 4,
    "text": "吴承恩依托玄奘取经的历史线索，融合宋元说话、戏曲与民间传说，",
    "start": 17.05,
    "end": 22.97,
    "duration": 5.92
  },
  {
    "id": 5,
    "text": "构筑了一个光怪陆离而又贴近世情的神魔世界。",
    "start": 23.34,
    "end": 27.58,
    "duration": 4.24
  },
  {
    "id": 6,
    "text": "鲁迅在《中国小说史略》中指出其艺术特质在于“神魔皆有人情，精魅亦通世故”。",
    "start": 28.1,
    "end": 34.816,
    "duration": 6.716
  },
  {
    "id": 7,
    "text": "全书奇幻世界的建构与审美特征，主要体现在以下四个方面：",
    "start": 35.316,
    "end": 39.66,
    "duration": 4.344
  },
  {
    "id": 8,
    "text": "第一，建构“极幻”与“极真”相融的神话世界，曲折折射社会现实。",
    "start": 40.03,
    "end": 44.91,
    "duration": 4.88
  },
  {
    "id": 9,
    "text": "《西游记》的奇幻构架根植于尘世生活，是现实人间的折光反射。",
    "start": 45.43,
    "end": 50.53,
    "duration": 5.1
  },
  {
    "id": 10,
    "text": "书中描绘的天宫、地府、龙宫与各处妖魔洞府，处处带有封建官僚体制的印记：",
    "start": 51.03,
    "end": 57.63,
    "duration": 6.6
  },
  {
    "id": 11,
    "text": "天庭等级森严，玉帝昏庸轻贤，判官可因魏徵一封书信而讲情变通；",
    "start": 58.0,
    "end": 64.32,
    "duration": 6.32
  },
  {
    "id": 12,
    "text": "取经路上的诸多妖魔鬼怪多为佛道仙尊的坐骑或童子，每逢危机便由后台主人出面领回免责；",
    "start": 64.84,
    "end": 73.16,
    "duration": 8.32
  },
  {
    "id": 13,
    "text": "比丘国君听信国丈残害幼童，车迟国道士蛊惑朝政、迫害僧侣。",
    "start": 73.68,
    "end": 79.76,
    "duration": 6.08
  },
  {
    "id": 14,
    "text": "作者借神魔世界之荒诞，对明代中叶皇权昏暗、官场徇私与厂卫横行的现实弊病作出了辛辣讽刺。",
    "start": 80.28,
    "end": 88.44,
    "duration": 8.16
  },
  {
    "id": 15,
    "text": "第二，塑造追求个性自由的孙悟空典型，统一物性、神性与人性。",
    "start": 88.96,
    "end": 94.72,
    "duration": 5.76
  },
  {
    "id": 16,
    "text": "孙悟空是全书最光彩照人的艺术形象，",
    "start": 95.286,
    "end": 98.36,
    "duration": 3.074
  },
  {
    "id": 17,
    "text": "集中体现了明代中后期反抗礼法拘束、张扬个性的时代思潮。",
    "start": 98.73,
    "end": 103.77,
    "duration": 5.04
  },
  {
    "id": 18,
    "text": "在前七回大闹天宫中，他因不满官居末流和虚衔受辱，喊出“皇帝轮流做，明年到我家”的豪言，展现出冲破等级束缚的叛逆气概；",
    "start": 104.29,
    "end": 115.318,
    "duration": 11.028
  },
  {
    "id": 19,
    "text": "在取经途中，他历尽八十一难而不屈，成为降妖除魔、践行理想的英雄。",
    "start": 115.818,
    "end": 121.85,
    "duration": 6.032
  },
  {
    "id": 20,
    "text": "作者在孙悟空身上巧妙统一了“神性、人性与物性”：既有七十二变的神奇本领，",
    "start": 122.37,
    "end": 128.607,
    "duration": 6.237
  },
  {
    "id": 21,
    "text": "又保留毛脸雷公嘴、机敏好动的猴态，更有嫉恶如仇、重情守诺的人格光彩，生动而真实。",
    "start": 128.957,
    "end": 136.58,
    "duration": 7.623
  },
  {
    "id": 22,
    "text": "第三，融童真幻想与游戏笔墨于一体，形成奇幻而又诙谐的喜剧风貌。",
    "start": 137.1,
    "end": 143.9,
    "duration": 6.8
  },
  {
    "id": 23,
    "text": "《西游记》洋溢着天真活泼的想象力与“以戏言寓诸幻笔”的喜剧气息。",
    "start": 144.42,
    "end": 150.246,
    "duration": 5.826
  },
  {
    "id": 24,
    "text": "取经师徒四人性格迥异而又形成戏剧反差：唐僧善良执着而略显迂腐，",
    "start": 150.746,
    "end": 157.26,
    "duration": 6.514
  },
  {
    "id": 25,
    "text": "孙悟空机警高傲而急躁，猪八戒贪吃好色、好吹大话而又憨厚富有人情味，沙僧忠厚勤恳。",
    "start": 157.663,
    "end": 165.63,
    "duration": 7.967
  },
  {
    "id": 26,
    "text": "八戒与行者一路上的插科打诨、斗嘴取笑，以及作者把玉帝、如来、妖魔写得如同市井凡人的戏谑笔墨，",
    "start": 166.15,
    "end": 174.36,
    "duration": 8.21
  },
  {
    "id": 27,
    "text": "冲淡了宗教说教的枯燥呆板，使凶险漫长的取经路途充满了机趣幽默与人间欢笑。",
    "start": 174.73,
    "end": 181.53,
    "duration": 6.8
  },
  {
    "id": 28,
    "text": "第四，贯通三教合一的心学寓意，构筑“放心、定心、修心”的精神隐喻。",
    "start": 182.05,
    "end": 187.89,
    "duration": 5.84
  },
  {
    "id": 29,
    "text": "在深层哲理意蕴上，《西游记》融汇了明代儒、释、道三教合一的心学思想，暗含修心炼性的寓言结构。",
    "start": 188.41,
    "end": 196.25,
    "duration": 7.84
  },
  {
    "id": 30,
    "text": "书中孙悟空号称“心猿”，猪八戒别称“木母”，白龙马喻“意马”，",
    "start": 196.795,
    "end": 202.42,
    "duration": 5.625
  },
  {
    "id": 31,
    "text": "西牛贺洲学艺处名为“灵台方寸山，斜月三星洞”，皆暗指人心。",
    "start": 202.82,
    "end": 208.82,
    "duration": 6.0
  },
  {
    "id": 32,
    "text": "全书由大闹天宫的“放心”，经五行山下的“定心”，",
    "start": 209.34,
    "end": 213.82,
    "duration": 4.48
  },
  {
    "id": 33,
    "text": "到西行取经扫除心魔、最终成佛的“修心”历程，",
    "start": 214.19,
    "end": 218.19,
    "duration": 4.0
  },
  {
    "id": 34,
    "text": "使神魔历险具备了克制私欲、磨砺心志的哲理厚度，成为清代神怪小说的典范先声。",
    "start": 218.55,
    "end": 225.84,
    "duration": 7.29
  },
  {
    "id": 35,
    "text": "总而言之，《西游记》融汇民间取经传说与晚明心学思潮，",
    "start": 226.36,
    "end": 231.0,
    "duration": 4.64
  },
  {
    "id": 36,
    "text": "在“极幻”的神魔奇境中灌注“极真”的人情世态，塑造出机智叛逆、历经磨砺而不失本心的孙悟空形象。",
    "start": 231.37,
    "end": 239.93,
    "duration": 8.56
  },
  {
    "id": 37,
    "text": "作品以童真幻想与诙谐游戏笔墨冲淡了说教的枯燥，",
    "start": 240.45,
    "end": 244.759,
    "duration": 4.309
  },
  {
    "id": 38,
    "text": "将神怪历险升华为“修心”寓言，",
    "start": 245.109,
    "end": 247.46,
    "duration": 2.351
  },
  {
    "id": 39,
    "text": "在中国古代长篇神魔小说史上树立起独树一帜的喜剧浪漫典范。",
    "start": 247.86,
    "end": 253.14,
    "duration": 5.28
  }
]
