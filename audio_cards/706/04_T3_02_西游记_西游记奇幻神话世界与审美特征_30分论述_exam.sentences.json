[
  {
    "id": 1,
    "text": "试论《西游记》的奇幻神话世界与审美特征。",
    "start": 0.05,
    "end": 3.97,
    "duration": 3.92
  },
  {
    "id": 2,
    "text": "《西游记》 是中国古典长篇神魔小说发展的至高巅峰，",
    "start": 3.97,
    "end": 8.154,
    "duration": 4.184
  },
  {
    "id": 3,
    "text": "也是古代浪漫主义小说的艺术瑰宝。",
    "start": 8.154,
    "end": 11.477,
    "duration": 3.323
  },
  {
    "id": 4,
    "text": "面对明代中后期王阳明心学崛起、",
    "start": 11.477,
    "end": 15.46,
    "duration": 3.983
  },
  {
    "id": 5,
    "text": "反抗程朱理学僵化与市民个性觉醒的时代思潮，",
    "start": 15.46,
    "end": 19.097,
    "duration": 3.637
  },
  {
    "id": 6,
    "text": "吴承恩借唐僧取经之历史线索，融合民间神话传说与宗教演义，",
    "start": 19.097,
    "end": 25.12,
    "duration": 6.023
  },
  {
    "id": 7,
    "text": "构建起一个光怪陆离而又饱含人间真理的神魔世界。",
    "start": 25.12,
    "end": 29.12,
    "duration": 4.0
  },
  {
    "id": 8,
    "text": "鲁迅在 《中国小说史略》 中深刻指出其艺术特质在于 “神魔皆有人情，",
    "start": 29.12,
    "end": 35.038,
    "duration": 5.918
  },
  {
    "id": 9,
    "text": "精魅亦通世故”。",
    "start": 35.038,
    "end": 36.129,
    "duration": 1.091
  },
  {
    "id": 10,
    "text": "其奇幻世界的建构与审美特征，主要展现为以下四个核心维度：",
    "start": 36.129,
    "end": 41.141,
    "duration": 5.012
  },
  {
    "id": 11,
    "text": "第一，建构“幻由人生”的奇幻神话世界，",
    "start": 41.141,
    "end": 44.032,
    "duration": 2.891
  },
  {
    "id": 12,
    "text": "寄托深刻的社会现实批判。",
    "start": 44.032,
    "end": 46.181,
    "duration": 2.149
  },
  {
    "id": 13,
    "text": "《西游记》 的奇幻构架绝非脱离尘世的虚妄臆想，",
    "start": 46.181,
    "end": 49.927,
    "duration": 3.746
  },
  {
    "id": 14,
    "text": "而是现实人间的折光反射。",
    "start": 49.927,
    "end": 52.216,
    "duration": 2.289
  },
  {
    "id": 15,
    "text": "小说中所构筑的天宫、地府、龙宫与妖魔洞府，",
    "start": 52.216,
    "end": 56.367,
    "duration": 4.151
  },
  {
    "id": 16,
    "text": "无一不是封建现实官僚体制的艺术化投射。",
    "start": 56.367,
    "end": 59.8,
    "duration": 3.433
  },
  {
    "id": 17,
    "text": "玉皇大帝昏庸无能、任人唯亲，阎王判官受贿舞弊、颠倒是非；",
    "start": 59.8,
    "end": 65.311,
    "duration": 5.511
  },
  {
    "id": 18,
    "text": "取经途中盘踞各地的妖魔鬼怪，",
    "start": 65.311,
    "end": 68.611,
    "duration": 3.3
  },
  {
    "id": 19,
    "text": "多与天界神佛存在千丝万缕的亲属或随从关系：",
    "start": 68.611,
    "end": 73.48,
    "duration": 4.869
  },
  {
    "id": 20,
    "text": "青狮白象是菩萨坐骑，金角银角是老君童子，",
    "start": 73.48,
    "end": 76.753,
    "duration": 3.273
  },
  {
    "id": 21,
    "text": "作恶多端却因有后台庇护而免遭惩处；",
    "start": 76.753,
    "end": 81.291,
    "duration": 4.538
  },
  {
    "id": 22,
    "text": "比丘国国王听信国丈残害小儿，车迟国道士蛊惑朝纲。",
    "start": 81.291,
    "end": 85.699,
    "duration": 4.408
  },
  {
    "id": 23,
    "text": "这种借助神魔之笔的荒诞呈现，对明代中叶皇权专制、",
    "start": 85.699,
    "end": 90.464,
    "duration": 4.765
  },
  {
    "id": 24,
    "text": "奸佞误国与黑恶横行的腐朽现实作出了极其辛辣的隐喻批判。",
    "start": 90.464,
    "end": 95.191,
    "duration": 4.727
  },
  {
    "id": 25,
    "text": "第二，成功塑造追求个性自由的孙悟空典型形象，",
    "start": 95.191,
    "end": 99.516,
    "duration": 4.325
  },
  {
    "id": 26,
    "text": "确立反抗权威的抗争范式。",
    "start": 99.516,
    "end": 102.74,
    "duration": 3.224
  },
  {
    "id": 27,
    "text": "孙悟空是全书最光彩夺目的艺术形象，",
    "start": 102.74,
    "end": 106.41,
    "duration": 3.67
  },
  {
    "id": 28,
    "text": "集中体现了明末追求个性解放的精神追求。",
    "start": 106.41,
    "end": 109.683,
    "duration": 3.273
  },
  {
    "id": 29,
    "text": "在前七回中，他由天地灵气所生，自封美猴王，",
    "start": 109.683,
    "end": 113.973,
    "duration": 4.29
  },
  {
    "id": 30,
    "text": "在反抗天庭权威中迸发出 “皇帝轮流做，",
    "start": 113.973,
    "end": 116.882,
    "duration": 2.909
  },
  {
    "id": 31,
    "text": "明年到我家” 的震撼呼声，",
    "start": 116.882,
    "end": 119.238,
    "duration": 2.356
  },
  {
    "id": 32,
    "text": "彻底打破了封建等级不可逾越的戒律；在取经途中，",
    "start": 119.238,
    "end": 123.982,
    "duration": 4.744
  },
  {
    "id": 33,
    "text": "他面对艰难险阻勇往直前、不畏强暴，",
    "start": 123.982,
    "end": 127.034,
    "duration": 3.052
  },
  {
    "id": 34,
    "text": "展现出扫清人间邪恶的英雄气概。",
    "start": 127.034,
    "end": 129.579,
    "duration": 2.545
  },
  {
    "id": 35,
    "text": "孙悟空兼备 “神性、人性与物性” 三重品格：",
    "start": 129.579,
    "end": 133.541,
    "duration": 3.962
  },
  {
    "id": 36,
    "text": "既有七十二变、腾云驾雾的神通，又有猴子抓耳挠腮、",
    "start": 133.541,
    "end": 137.359,
    "duration": 3.818
  },
  {
    "id": 37,
    "text": "急躁好动的物性，更有重情重义、嫉恶如仇的人格真性，",
    "start": 137.359,
    "end": 141.828,
    "duration": 4.469
  },
  {
    "id": 38,
    "text": "成为中国古典文学中反抗权威与追求自由的永恒典型。",
    "start": 141.828,
    "end": 146.692,
    "duration": 4.864
  },
  {
    "id": 39,
    "text": "第三，融“童心天真”与幽默讽刺于一体，",
    "start": 146.692,
    "end": 149.42,
    "duration": 2.728
  },
  {
    "id": 40,
    "text": "达成引人入胜的喜剧美学境界。",
    "start": 149.42,
    "end": 152.643,
    "duration": 3.223
  },
  {
    "id": 41,
    "text": "在美学风貌上，《西游记》 极具明快诙谐的喜剧色彩。",
    "start": 152.643,
    "end": 156.279,
    "duration": 3.636
  },
  {
    "id": 42,
    "text": "作者深刻践行了李贽倡导的 “童心说”，",
    "start": 156.279,
    "end": 160.316,
    "duration": 4.037
  },
  {
    "id": 43,
    "text": "以纯真无邪的天真之笔展开妙趣横生的艺术想象。",
    "start": 160.316,
    "end": 164.134,
    "duration": 3.818
  },
  {
    "id": 44,
    "text": "取经团队内部性格互补且充满戏剧张力：",
    "start": 164.134,
    "end": 169.004,
    "duration": 4.87
  },
  {
    "id": 45,
    "text": "唐僧迂腐善良而固执不察，孙悟空机警急躁而本领高强，",
    "start": 169.004,
    "end": 173.667,
    "duration": 4.663
  },
  {
    "id": 46,
    "text": "猪八戒贪吃好色、憨厚懒惰却富有人情味，沙僧忠诚老实。",
    "start": 173.667,
    "end": 177.849,
    "duration": 4.182
  },
  {
    "id": 47,
    "text": "八戒与行者之间的插科打诨、互不相让，",
    "start": 177.849,
    "end": 180.973,
    "duration": 3.124
  },
  {
    "id": 48,
    "text": "使充满生死的凶险旅途洋溢着市井生活的人间乐趣；",
    "start": 180.973,
    "end": 185.554,
    "duration": 4.581
  },
  {
    "id": 49,
    "text": "作者善于将深刻的讽刺包裹在风趣幽默的叙述之中，",
    "start": 185.554,
    "end": 189.554,
    "duration": 4.0
  },
  {
    "id": 50,
    "text": "展现出举重若轻的高超幽默艺术。",
    "start": 189.554,
    "end": 192.114,
    "duration": 2.56
  },
  {
    "id": 51,
    "text": "第四，贯通三教合一的哲学意蕴，",
    "start": 192.114,
    "end": 195.664,
    "duration": 3.55
  },
  {
    "id": 52,
    "text": "构筑心性修炼与战胜心魔的心灵隐喻。",
    "start": 195.664,
    "end": 199.805,
    "duration": 4.141
  },
  {
    "id": 53,
    "text": "从深层哲学意蕴而言，《西游记》 深受明代儒、释、",
    "start": 199.805,
    "end": 203.562,
    "duration": 3.757
  },
  {
    "id": 54,
    "text": "道三教合流思潮的影响，构筑了一部完整的人类心性修养寓言。",
    "start": 203.562,
    "end": 208.62,
    "duration": 5.058
  },
  {
    "id": 55,
    "text": "孙悟空号称 “心猿”，猪八戒被称为 “木母” 或意马；",
    "start": 208.62,
    "end": 212.952,
    "duration": 4.332
  },
  {
    "id": 56,
    "text": "孙悟空学艺之所名为 “灵台方寸山，斜月三星洞”，",
    "start": 212.952,
    "end": 216.732,
    "duration": 3.78
  },
  {
    "id": 57,
    "text": "皆暗指人心。",
    "start": 216.732,
    "end": 217.641,
    "duration": 0.909
  },
  {
    "id": 58,
    "text": "八十一难降妖伏魔的艰险征途，本质上是个体克制私欲、",
    "start": 217.641,
    "end": 223.08,
    "duration": 5.439
  },
  {
    "id": 59,
    "text": "战胜心魔、由狂傲不羁走向心性圆融成熟的精神升华历程。",
    "start": 223.08,
    "end": 227.444,
    "duration": 4.364
  },
  {
    "id": 60,
    "text": "这种多维度的哲学隐喻，赋予了神魔故事极其深邃的生命哲学厚度。",
    "start": 227.444,
    "end": 232.92,
    "duration": 5.476
  }
]