[
  {
    "id": "sent_1",
    "text": "《西游记》 是中国古典长篇神魔小说发展的至高巅峰，",
    "start": 0.1,
    "end": 5.597,
    "duration": 5.497
  },
  {
    "id": "sent_2",
    "text": "也是古代浪漫主义小说的艺术瑰宝。",
    "start": 5.547,
    "end": 8.919,
    "duration": 3.372
  },
  {
    "id": "sent_3",
    "text": "面对明代中后期王阳明心学崛起、反抗程朱理学僵化与市民个性觉醒的时代思潮，",
    "start": 8.919,
    "end": 17.018,
    "duration": 8.099
  },
  {
    "id": "sent_4",
    "text": "吴承恩借唐僧取经之历史线索，融合民间神话传说与宗教演义，",
    "start": 17.018,
    "end": 23.359,
    "duration": 6.341
  },
  {
    "id": "sent_5",
    "text": "构建起一个光怪陆离而又饱含人间真理的神魔世界。",
    "start": 23.359,
    "end": 28.294,
    "duration": 4.935
  },
  {
    "id": "sent_6",
    "text": "鲁迅在 《中国小说史略》 中深刻指出其艺术特质在于 “神魔皆有人情，",
    "start": 28.294,
    "end": 34.726,
    "duration": 6.432
  },
  {
    "id": "sent_7",
    "text": "精魅亦通世故”。",
    "start": 34.727,
    "end": 36.654,
    "duration": 1.927
  },
  {
    "id": "sent_8",
    "text": "其奇幻世界的建构与审美特征，主要展现为以下四个核心维度：",
    "start": 36.654,
    "end": 42.565,
    "duration": 5.911
  },
  {
    "id": "sent_9",
    "text": "第一，建构“幻由人生”的奇幻神话世界，寄托深刻的社会现实批判。",
    "start": 42.565,
    "end": 48.75,
    "duration": 6.185
  },
  {
    "id": "sent_10",
    "text": "《西游记》 的奇幻构架绝非脱离尘世的虚妄臆想，",
    "start": 48.75,
    "end": 53.294,
    "duration": 4.544
  },
  {
    "id": "sent_11",
    "text": "而是现实人间的折光反射。",
    "start": 53.294,
    "end": 56.159,
    "duration": 2.865
  },
  {
    "id": "sent_12",
    "text": "小说中所构筑的天宫、地府、龙宫与妖魔洞府，",
    "start": 56.159,
    "end": 61.276,
    "duration": 5.117
  },
  {
    "id": "sent_13",
    "text": "无一不是封建现实官僚体制的艺术化投射。",
    "start": 61.276,
    "end": 65.208,
    "duration": 3.932
  },
  {
    "id": "sent_14",
    "text": "玉皇大帝昏庸无能、任人唯亲，阎王判官受贿舞弊、颠倒是非；",
    "start": 65.208,
    "end": 71.237,
    "duration": 6.029
  },
  {
    "id": "sent_15",
    "text": "取经途中盘踞各地的妖魔鬼怪，",
    "start": 71.237,
    "end": 74.675,
    "duration": 3.438
  },
  {
    "id": "sent_16",
    "text": "多与天界神佛存在千丝万缕的亲属或随从关系：青狮白象是菩萨坐骑，",
    "start": 74.674,
    "end": 81.419,
    "duration": 6.745
  },
  {
    "id": "sent_17",
    "text": "金角银角是老君童子，作恶多端却因有后台庇护而免遭惩处；",
    "start": 81.419,
    "end": 87.656,
    "duration": 6.237
  },
  {
    "id": "sent_18",
    "text": "比丘国国王听信国丈残害小儿，车迟国道士蛊惑朝纲。",
    "start": 87.656,
    "end": 93.151,
    "duration": 5.495
  },
  {
    "id": "sent_19",
    "text": "这种借助神魔之笔的荒诞呈现，",
    "start": 93.151,
    "end": 96.406,
    "duration": 3.255
  },
  {
    "id": "sent_20",
    "text": "对明代中叶皇权专制、奸佞误国与黑恶横行的腐朽现实作出了极其辛辣的隐喻批判。",
    "start": 96.406,
    "end": 104.323,
    "duration": 7.917
  },
  {
    "id": "sent_21",
    "text": "第二，成功塑造追求个性自由的孙悟空典型形象，",
    "start": 104.323,
    "end": 109.024,
    "duration": 4.701
  },
  {
    "id": "sent_22",
    "text": "确立反抗权威的抗争范式。",
    "start": 109.023,
    "end": 111.901,
    "duration": 2.878
  },
  {
    "id": "sent_23",
    "text": "孙悟空是全书最光彩夺目的艺术形象，",
    "start": 111.901,
    "end": 115.69,
    "duration": 3.789
  },
  {
    "id": "sent_24",
    "text": "集中体现了明末追求个性解放的精神追求。",
    "start": 115.69,
    "end": 119.921,
    "duration": 4.231
  },
  {
    "id": "sent_25",
    "text": "在前七回中，他由天地灵气所生，自封美猴王，",
    "start": 119.921,
    "end": 124.583,
    "duration": 4.662
  },
  {
    "id": "sent_26",
    "text": "在反抗天庭权威中迸发出 “皇帝轮流做，明年到我家” 的震撼呼声，",
    "start": 124.583,
    "end": 130.989,
    "duration": 6.406
  },
  {
    "id": "sent_27",
    "text": "彻底打破了封建等级不可逾越的戒律；",
    "start": 130.99,
    "end": 134.766,
    "duration": 3.776
  },
  {
    "id": "sent_28",
    "text": "在取经途中，他面对艰难险阻勇往直前、不畏强暴，",
    "start": 134.765,
    "end": 139.844,
    "duration": 5.079
  },
  {
    "id": "sent_29",
    "text": "展现出扫清人间邪恶的英雄气概。",
    "start": 139.844,
    "end": 143.646,
    "duration": 3.802
  },
  {
    "id": "sent_30",
    "text": "孙悟空兼备 “神性、人性与物性” 三重品格：",
    "start": 143.646,
    "end": 147.852,
    "duration": 4.206
  },
  {
    "id": "sent_31",
    "text": "既有七十二变、腾云驾雾的神通，又有猴子抓耳挠腮、急躁好动的物性，",
    "start": 147.852,
    "end": 154.128,
    "duration": 6.276
  },
  {
    "id": "sent_32",
    "text": "更有重情重义、嫉恶如仇的人格真性，",
    "start": 154.128,
    "end": 157.956,
    "duration": 3.828
  },
  {
    "id": "sent_33",
    "text": "成为中国古典文学中反抗权威与追求自由的永恒典型。",
    "start": 157.956,
    "end": 163.36,
    "duration": 5.404
  },
  {
    "id": "sent_34",
    "text": "第三，融“童心天真”与幽默讽刺于一体，",
    "start": 163.359,
    "end": 167.421,
    "duration": 4.062
  },
  {
    "id": "sent_35",
    "text": "达成引人入胜的喜剧美学境界。",
    "start": 167.422,
    "end": 170.586,
    "duration": 3.164
  },
  {
    "id": "sent_36",
    "text": "在美学风貌上，《西游记》 极具明快诙谐的喜剧色彩。",
    "start": 170.586,
    "end": 175.56,
    "duration": 4.974
  },
  {
    "id": "sent_37",
    "text": "作者深刻践行了李贽倡导的 “童心说”，",
    "start": 175.56,
    "end": 179.18,
    "duration": 3.62
  },
  {
    "id": "sent_38",
    "text": "以纯真无邪的天真之笔展开妙趣横生的艺术想象。",
    "start": 179.18,
    "end": 184.128,
    "duration": 4.948
  },
  {
    "id": "sent_39",
    "text": "取经团队内部性格互补且充满戏剧张力：唐僧迂腐善良而固执不察，",
    "start": 184.128,
    "end": 191.003,
    "duration": 6.875
  },
  {
    "id": "sent_40",
    "text": "孙悟空机警急躁而本领高强，猪八戒贪吃好色、憨厚懒惰却富有人情味，",
    "start": 191.003,
    "end": 197.878,
    "duration": 6.875
  },
  {
    "id": "sent_41",
    "text": "沙僧忠诚老实。",
    "start": 197.878,
    "end": 199.766,
    "duration": 1.888
  },
  {
    "id": "sent_42",
    "text": "八戒与行者之间的插科打诨、互不相让，",
    "start": 199.766,
    "end": 203.659,
    "duration": 3.893
  },
  {
    "id": "sent_43",
    "text": "使充满生死的凶险旅途洋溢着市井生活的人间乐趣；",
    "start": 203.659,
    "end": 208.724,
    "duration": 5.065
  },
  {
    "id": "sent_44",
    "text": "作者善于将深刻的讽刺包裹在风趣幽默的叙述之中，",
    "start": 208.724,
    "end": 213.594,
    "duration": 4.87
  },
  {
    "id": "sent_45",
    "text": "展现出举重若轻的高超幽默艺术。",
    "start": 213.594,
    "end": 217.123,
    "duration": 3.529
  },
  {
    "id": "sent_46",
    "text": "第四，贯通三教合一的哲学意蕴，构筑心性修炼与战胜心魔的心灵隐喻。",
    "start": 217.122,
    "end": 224.323,
    "duration": 7.201
  },
  {
    "id": "sent_47",
    "text": "从深层哲学意蕴而言，",
    "start": 224.323,
    "end": 226.784,
    "duration": 2.461
  },
  {
    "id": "sent_48",
    "text": "《西游记》 深受明代儒、释、道三教合流思潮的影响，",
    "start": 226.784,
    "end": 231.979,
    "duration": 5.195
  },
  {
    "id": "sent_49",
    "text": "构筑了一部完整的人类心性修养寓言。",
    "start": 231.979,
    "end": 235.625,
    "duration": 3.646
  },
  {
    "id": "sent_50",
    "text": "孙悟空号称 “心猿”，猪八戒被称为 “木母” 或意马；",
    "start": 235.625,
    "end": 240.156,
    "duration": 4.531
  },
  {
    "id": "sent_51",
    "text": "孙悟空学艺之所名为 “灵台方寸山，斜月三星洞”，皆暗指人心。",
    "start": 240.156,
    "end": 246.028,
    "duration": 5.872
  },
  {
    "id": "sent_52",
    "text": "八十一难降妖伏魔的艰险征途，",
    "start": 246.029,
    "end": 249.44,
    "duration": 3.411
  },
  {
    "id": "sent_53",
    "text": "本质上是个体克制私欲、战胜心魔、由狂傲不羁走向心性圆融成熟的精神升华历程。",
    "start": 249.44,
    "end": 257.904,
    "duration": 8.464
  },
  {
    "id": "sent_54",
    "text": "这种多维度的哲学隐喻，赋予了神魔故事极其深邃的生命哲学厚度。",
    "start": 257.904,
    "end": 263.894,
    "duration": 5.99
  }
]