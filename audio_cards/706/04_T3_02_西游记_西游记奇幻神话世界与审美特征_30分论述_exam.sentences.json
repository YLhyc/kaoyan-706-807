[
  {
    "id": 1,
    "text": "试论《西游记》的奇幻神话世界与审美特征。",
    "start": 0.154,
    "end": 3.166,
    "duration": 3.012
  },
  {
    "id": 2,
    "text": "《西游记》是中国古代长篇神魔小说的杰出代表，也是古典浪漫主义小说的艺术结晶。",
    "start": 3.883,
    "end": 10.095,
    "duration": 6.212
  },
  {
    "id": 3,
    "text": "在明代中后期心学流行、市民阶层壮大与个性意识高扬的文化背景下，",
    "start": 10.813,
    "end": 16.265,
    "duration": 5.452
  },
  {
    "id": 4,
    "text": "吴承恩依托玄奘取经的历史线索，融合宋元说话、戏曲与民间传说，",
    "start": 16.644,
    "end": 22.418,
    "duration": 5.774
  },
  {
    "id": 5,
    "text": "构筑了一个光怪陆离而又贴近世情的神魔世界。",
    "start": 22.797,
    "end": 27.557,
    "duration": 4.76
  },
  {
    "id": 6,
    "text": "鲁迅在《中国小说史略》中指出其艺术特质在于“神魔皆有人情，精魅亦通世故”。",
    "start": 28.086,
    "end": 34.058,
    "duration": 5.972
  },
  {
    "id": 7,
    "text": "全书奇幻世界的建构与审美特征，主要体现在以下四个方面：",
    "start": 34.816,
    "end": 39.548,
    "duration": 4.732
  },
  {
    "id": 8,
    "text": "第一，建构“极幻”与“极真”相融的神话世界，曲折折射社会现实。",
    "start": 40.172,
    "end": 44.464,
    "duration": 4.292
  },
  {
    "id": 9,
    "text": "《西游记》的奇幻构架根植于尘世生活，是现实人间的折光反射。",
    "start": 44.993,
    "end": 50.535,
    "duration": 5.542
  },
  {
    "id": 10,
    "text": "书中描绘的天宫、地府、龙宫与各处妖魔洞府，处处带有封建官僚体制的印记：",
    "start": 51.064,
    "end": 58.606,
    "duration": 7.542
  },
  {
    "id": 11,
    "text": "天庭等级森严，玉帝昏庸轻贤，判官可因魏徵一封书信而讲情变通；",
    "start": 58.985,
    "end": 65.277,
    "duration": 6.292
  },
  {
    "id": 12,
    "text": "取经路上的诸多妖魔鬼怪多为佛道仙尊的坐骑或童子，每逢危机便由后台主人出面领回免责；",
    "start": 65.995,
    "end": 73.807,
    "duration": 7.812
  },
  {
    "id": 13,
    "text": "比丘国君听信国丈残害幼童，车迟国道士蛊惑朝政、迫害僧侣。",
    "start": 74.525,
    "end": 79.617,
    "duration": 5.092
  },
  {
    "id": 14,
    "text": "作者借神魔世界之荒诞，对明代中叶皇权昏暗、官场徇私与厂卫横行的现实弊病作出了辛辣讽刺。",
    "start": 80.146,
    "end": 88.928,
    "duration": 8.782
  },
  {
    "id": 15,
    "text": "第二，塑造追求个性自由的孙悟空典型，统一物性、神性与人性。",
    "start": 89.606,
    "end": 95.178,
    "duration": 5.572
  },
  {
    "id": 16,
    "text": "孙悟空是全书最光彩照人的艺术形象，",
    "start": 95.856,
    "end": 98.668,
    "duration": 2.812
  },
  {
    "id": 17,
    "text": "集中体现了明代中后期反抗礼法拘束、张扬个性的时代思潮。",
    "start": 99.047,
    "end": 104.739,
    "duration": 5.692
  },
  {
    "id": 18,
    "text": "在前七回大闹天宫中，他因不满官居末流和虚衔受辱，喊出“皇帝轮流做，明年到我家”的豪言，展现出冲破等级束缚的叛逆气概；",
    "start": 105.268,
    "end": 117.286,
    "duration": 12.018
  },
  {
    "id": 19,
    "text": "在取经途中，他历尽八十一难而不屈，成为降妖除魔、践行理想的英雄。",
    "start": 117.877,
    "end": 122.489,
    "duration": 4.612
  },
  {
    "id": 20,
    "text": "作者在孙悟空身上巧妙统一了“神性、人性与物性”：既有七十二变的神奇本领，",
    "start": 123.018,
    "end": 128.95,
    "duration": 5.932
  },
  {
    "id": 21,
    "text": "又保留毛脸雷公嘴、机敏好动的猴态，更有嫉恶如仇、重情守诺的人格光彩，生动而真实。",
    "start": 129.329,
    "end": 136.741,
    "duration": 7.412
  },
  {
    "id": 22,
    "text": "第三，融童真幻想与游戏笔墨于一体，形成奇幻而又诙谐的喜剧风貌。",
    "start": 137.365,
    "end": 143.137,
    "duration": 5.772
  },
  {
    "id": 23,
    "text": "《西游记》洋溢着天真活泼的想象力与“以戏言寓诸幻笔”的喜剧气息。",
    "start": 143.815,
    "end": 148.467,
    "duration": 4.652
  },
  {
    "id": 24,
    "text": "取经师徒四人性格迥异而又形成戏剧反差：唐僧善良执着而略显迂腐，",
    "start": 149.185,
    "end": 154.557,
    "duration": 5.372
  },
  {
    "id": 25,
    "text": "孙悟空机警高傲而急躁，猪八戒贪吃好色、好吹大话而又憨厚富有人情味，沙僧忠厚勤恳。",
    "start": 154.936,
    "end": 161.868,
    "duration": 6.932
  },
  {
    "id": 26,
    "text": "八戒与行者一路上的插科打诨、斗嘴取笑，以及作者把玉帝、如来、妖魔写得如同市井凡人的戏谑笔墨，",
    "start": 162.626,
    "end": 170.678,
    "duration": 8.052
  },
  {
    "id": 27,
    "text": "冲淡了宗教说教的枯燥呆板，使凶险漫长的取经路途充满了机趣幽默与人间欢笑。",
    "start": 171.057,
    "end": 177.796,
    "duration": 6.739
  },
  {
    "id": 28,
    "text": "第四，贯通三教合一的心学寓意，构筑“放心、定心、修心”的精神隐喻。",
    "start": 178.487,
    "end": 184.379,
    "duration": 5.892
  },
  {
    "id": 29,
    "text": "在深层哲理意蕴上，《西游记》融汇了明代儒、释、道三教合一的心学思想，暗含修心炼性的寓言结构。",
    "start": 185.057,
    "end": 192.989,
    "duration": 7.932
  },
  {
    "id": 30,
    "text": "书中孙悟空号称“心猿”，猪八戒别称“木母”，白龙马喻“意马”，",
    "start": 193.667,
    "end": 198.599,
    "duration": 4.932
  },
  {
    "id": 31,
    "text": "西牛贺洲学艺处名为“灵台方寸山，斜月三星洞”，皆暗指人心。",
    "start": 198.978,
    "end": 204.31,
    "duration": 5.332
  },
  {
    "id": 32,
    "text": "全书由大闹天宫的“放心”，经五行山下的“定心”，",
    "start": 204.988,
    "end": 208.32,
    "duration": 3.332
  },
  {
    "id": 33,
    "text": "到西行取经扫除心魔、最终成佛的“修心”历程，",
    "start": 208.699,
    "end": 212.351,
    "duration": 3.652
  },
  {
    "id": 34,
    "text": "使神魔历险具备了克制私欲、磨砺心志的哲理厚度，成为清代神怪小说的典范先声。",
    "start": 212.858,
    "end": 219.55,
    "duration": 6.692
  },
  {
    "id": 35,
    "text": "总而言之，《西游记》融汇民间取经传说与晚明心学思潮，",
    "start": 220.289,
    "end": 224.621,
    "duration": 4.332
  },
  {
    "id": 36,
    "text": "在“极幻”的神魔奇境中灌注“极真”的人情世态，塑造出机智叛逆、历经磨砺而不失本心的孙悟空形象。",
    "start": 225.0,
    "end": 232.159,
    "duration": 7.159
  },
  {
    "id": 37,
    "text": "作品以童真幻想与诙谐游戏笔墨冲淡了说教的枯燥，",
    "start": 232.903,
    "end": 236.715,
    "duration": 3.812
  },
  {
    "id": 38,
    "text": "将神怪历险升华为“修心”寓言，",
    "start": 237.094,
    "end": 239.666,
    "duration": 2.572
  },
  {
    "id": 39,
    "text": "在中国古代长篇神魔小说史上树立起独树一帜的喜剧浪漫典范。",
    "start": 240.045,
    "end": 244.807,
    "duration": 4.762
  }
]