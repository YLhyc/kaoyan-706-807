[
  {
    "id": "sent_1",
    "text": "《西游记》 是中国古典长篇神魔小说发展的至高巅峰，",
    "start": 0.0,
    "end": 4.36,
    "duration": 4.36
  },
  {
    "id": "sent_2",
    "text": "也是古代浪漫主义小说的艺术瑰宝。",
    "start": 4.809,
    "end": 7.289,
    "duration": 2.48
  },
  {
    "id": "sent_3",
    "text": "面对明代中后期王阳明心学崛起、",
    "start": 7.819,
    "end": 10.579,
    "duration": 2.76
  },
  {
    "id": "sent_4",
    "text": "反抗程朱理学僵化与市民个性觉醒的时代思潮，",
    "start": 11.029,
    "end": 14.869,
    "duration": 3.84
  },
  {
    "id": "sent_5",
    "text": "吴承恩借唐僧取经之历史线索，融合民间神话传说与宗教演义，",
    "start": 15.399,
    "end": 20.759,
    "duration": 5.36
  },
  {
    "id": "sent_6",
    "text": "构建起一个光怪陆离而又饱含人间真理的神魔世界。",
    "start": 21.209,
    "end": 25.449,
    "duration": 4.24
  },
  {
    "id": "sent_7",
    "text": "鲁迅在 《中国小说史略》 中深刻指出其艺术特质在于 “神魔皆有人情，",
    "start": 25.899,
    "end": 31.299,
    "duration": 5.4
  },
  {
    "id": "sent_8",
    "text": "精魅亦通世故”。",
    "start": 31.749,
    "end": 33.109,
    "duration": 1.36
  },
  {
    "id": "sent_9",
    "text": "其奇幻世界的建构与审美特征，主要展现为以下四个核心维度：",
    "start": 33.559,
    "end": 38.319,
    "duration": 4.76
  },
  {
    "id": "sent_10",
    "text": "第一，建构“幻由人生”的奇幻神话世界，",
    "start": 38.769,
    "end": 42.089,
    "duration": 3.32
  },
  {
    "id": "sent_11",
    "text": "寄托深刻的社会现实批判。",
    "start": 42.539,
    "end": 44.619,
    "duration": 2.08
  },
  {
    "id": "sent_12",
    "text": "《西游记》 的奇幻构架绝非脱离尘世的虚妄臆想，",
    "start": 45.069,
    "end": 48.829,
    "duration": 3.76
  },
  {
    "id": "sent_13",
    "text": "而是现实人间的折光反射。",
    "start": 49.279,
    "end": 51.559,
    "duration": 2.28
  },
  {
    "id": "sent_14",
    "text": "小说中所构筑的天宫、地府、龙宫与妖魔洞府，",
    "start": 52.009,
    "end": 56.009,
    "duration": 4.0
  },
  {
    "id": "sent_15",
    "text": "无一不是封建现实官僚体制的艺术化投射。",
    "start": 56.539,
    "end": 59.739,
    "duration": 3.2
  },
  {
    "id": "sent_16",
    "text": "玉皇大帝昏庸无能、任人唯亲，阎王判官受贿舞弊、颠倒是非；",
    "start": 60.269,
    "end": 65.589,
    "duration": 5.32
  },
  {
    "id": "sent_17",
    "text": "取经途中盘踞各地的妖魔鬼怪，",
    "start": 66.039,
    "end": 68.679,
    "duration": 2.64
  },
  {
    "id": "sent_18",
    "text": "多与天界神佛存在千丝万缕的亲属或随从关系：",
    "start": 69.129,
    "end": 73.089,
    "duration": 3.96
  },
  {
    "id": "sent_19",
    "text": "青狮白象是菩萨坐骑，金角银角是老君童子，",
    "start": 73.539,
    "end": 77.739,
    "duration": 4.2
  },
  {
    "id": "sent_20",
    "text": "作恶多端却因有后台庇护而免遭惩处；",
    "start": 78.189,
    "end": 81.349,
    "duration": 3.16
  },
  {
    "id": "sent_21",
    "text": "比丘国国王听信国丈残害小儿，车迟国道士蛊惑朝纲。",
    "start": 81.799,
    "end": 86.439,
    "duration": 4.64
  },
  {
    "id": "sent_22",
    "text": "这种借助神魔之笔的荒诞呈现，对明代中叶皇权专制、",
    "start": 86.889,
    "end": 91.129,
    "duration": 4.24
  },
  {
    "id": "sent_23",
    "text": "奸佞误国与黑恶横行的腐朽现实作出了极其辛辣的隐喻批判。",
    "start": 91.579,
    "end": 96.619,
    "duration": 5.04
  },
  {
    "id": "sent_24",
    "text": "第二，成功塑造追求个性自由的孙悟空典型形象，",
    "start": 97.069,
    "end": 100.989,
    "duration": 3.92
  },
  {
    "id": "sent_25",
    "text": "确立反抗权威的抗争范式。",
    "start": 101.439,
    "end": 103.719,
    "duration": 2.28
  },
  {
    "id": "sent_26",
    "text": "孙悟空是全书最光彩夺目的艺术形象，",
    "start": 104.169,
    "end": 107.249,
    "duration": 3.08
  },
  {
    "id": "sent_27",
    "text": "集中体现了明末追求个性解放的精神追求。",
    "start": 107.699,
    "end": 111.059,
    "duration": 3.36
  },
  {
    "id": "sent_28",
    "text": "在前七回中，他由天地灵气所生，自封美猴王，",
    "start": 111.509,
    "end": 115.469,
    "duration": 3.96
  },
  {
    "id": "sent_29",
    "text": "在反抗天庭权威中迸发出 “皇帝轮流做，",
    "start": 115.919,
    "end": 119.359,
    "duration": 3.44
  },
  {
    "id": "sent_30",
    "text": "明年到我家” 的震撼呼声，彻底打破了封建等级不可逾越的戒律；",
    "start": 119.809,
    "end": 124.489,
    "duration": 4.68
  },
  {
    "id": "sent_31",
    "text": "在取经途中，他面对艰难险阻勇往直前、不畏强暴，",
    "start": 125.019,
    "end": 129.219,
    "duration": 4.2
  },
  {
    "id": "sent_32",
    "text": "展现出扫清人间邪恶的英雄气概。",
    "start": 129.669,
    "end": 132.389,
    "duration": 2.72
  },
  {
    "id": "sent_33",
    "text": "孙悟空兼备 “神性、人性与物性” 三重品格：既有七十二变、",
    "start": 132.839,
    "end": 137.679,
    "duration": 4.84
  },
  {
    "id": "sent_34",
    "text": "腾云驾雾的神通，又有猴子抓耳挠腮、急躁好动的物性，",
    "start": 138.129,
    "end": 142.689,
    "duration": 4.56
  },
  {
    "id": "sent_35",
    "text": "更有重情重义、嫉恶如仇的人格真性，",
    "start": 143.139,
    "end": 146.179,
    "duration": 3.04
  },
  {
    "id": "sent_36",
    "text": "成为中国古典文学中反抗权威与追求自由的永恒典型。",
    "start": 146.709,
    "end": 151.309,
    "duration": 4.6
  },
  {
    "id": "sent_37",
    "text": "第三，融“童心天真”与幽默讽刺于一体，",
    "start": 151.759,
    "end": 155.359,
    "duration": 3.6
  },
  {
    "id": "sent_38",
    "text": "达成引人入胜的喜剧美学境界。",
    "start": 155.809,
    "end": 158.369,
    "duration": 2.56
  },
  {
    "id": "sent_39",
    "text": "在美学风貌上，《西游记》 极具明快诙谐的喜剧色彩。",
    "start": 158.819,
    "end": 162.939,
    "duration": 4.12
  },
  {
    "id": "sent_40",
    "text": "作者深刻践行了李贽倡导的 “童心说”，",
    "start": 163.389,
    "end": 166.149,
    "duration": 2.76
  },
  {
    "id": "sent_41",
    "text": "以纯真无邪的天真之笔展开妙趣横生的艺术想象。",
    "start": 166.599,
    "end": 170.799,
    "duration": 4.2
  },
  {
    "id": "sent_42",
    "text": "取经团队内部性格互补且充满戏剧张力：唐僧迂腐善良而固执不察，",
    "start": 171.249,
    "end": 176.649,
    "duration": 5.4
  },
  {
    "id": "sent_43",
    "text": "孙悟空机警急躁而本领高强，猪八戒贪吃好色、",
    "start": 177.099,
    "end": 181.139,
    "duration": 4.04
  },
  {
    "id": "sent_44",
    "text": "憨厚懒惰却富有人情味，沙僧忠诚老实。",
    "start": 181.589,
    "end": 184.989,
    "duration": 3.4
  },
  {
    "id": "sent_45",
    "text": "八戒与行者之间的插科打诨、互不相让，",
    "start": 185.439,
    "end": 188.319,
    "duration": 2.88
  },
  {
    "id": "sent_46",
    "text": "使充满生死的凶险旅途洋溢着市井生活的人间乐趣；",
    "start": 188.768,
    "end": 192.968,
    "duration": 4.2
  },
  {
    "id": "sent_47",
    "text": "作者善于将深刻的讽刺包裹在风趣幽默的叙述之中，",
    "start": 193.418,
    "end": 197.418,
    "duration": 4.0
  },
  {
    "id": "sent_48",
    "text": "展现出举重若轻的高超幽默艺术。",
    "start": 197.868,
    "end": 200.748,
    "duration": 2.88
  },
  {
    "id": "sent_49",
    "text": "第四，贯通三教合一的哲学意蕴，",
    "start": 201.198,
    "end": 203.838,
    "duration": 2.64
  },
  {
    "id": "sent_50",
    "text": "构筑心性修炼与战胜心魔的心灵隐喻。",
    "start": 204.288,
    "end": 207.368,
    "duration": 3.08
  },
  {
    "id": "sent_51",
    "text": "从深层哲学意蕴而言，《西游记》 深受明代儒、释、",
    "start": 207.818,
    "end": 212.218,
    "duration": 4.4
  },
  {
    "id": "sent_52",
    "text": "道三教合流思潮的影响，构筑了一部完整的人类心性修养寓言。",
    "start": 212.668,
    "end": 217.668,
    "duration": 5.0
  },
  {
    "id": "sent_53",
    "text": "孙悟空号称 “心猿”，猪八戒被称为 “木母” 或意马；",
    "start": 218.118,
    "end": 222.238,
    "duration": 4.12
  },
  {
    "id": "sent_54",
    "text": "孙悟空学艺之所名为 “灵台方寸山，斜月三星洞”，皆暗指人心。",
    "start": 222.688,
    "end": 228.048,
    "duration": 5.36
  },
  {
    "id": "sent_55",
    "text": "八十一难降妖伏魔的艰险征途，本质上是个体克制私欲、战胜心魔、",
    "start": 228.498,
    "end": 233.978,
    "duration": 5.48
  },
  {
    "id": "sent_56",
    "text": "由狂傲不羁走向心性圆融成熟的精神升华历程。",
    "start": 234.428,
    "end": 238.428,
    "duration": 4.0
  },
  {
    "id": "sent_57",
    "text": "这种多维度的哲学隐喻，赋予了神魔故事极其深邃的生命哲学厚度。",
    "start": 238.878,
    "end": 244.038,
    "duration": 5.16
  }
]