[
  {
    "id": 1,
    "text": "试论《西游记》的奇幻神话世界与审美特征。",
    "start": 0.0,
    "end": 4.0,
    "duration": 4.0
  },
  {
    "id": 2,
    "text": "《西游记》 是中国古典长篇神魔小说发展的至高巅峰，",
    "start": 4.0,
    "end": 8.184,
    "duration": 4.184
  },
  {
    "id": 3,
    "text": "也是古代浪漫主义小说的艺术瑰宝。",
    "start": 8.184,
    "end": 10.84,
    "duration": 2.656
  },
  {
    "id": 4,
    "text": "面对明代中后期王阳明心学崛起、",
    "start": 10.84,
    "end": 13.819,
    "duration": 2.979
  },
  {
    "id": 5,
    "text": "反抗程朱理学僵化与市民个性觉醒的时代思潮，",
    "start": 13.819,
    "end": 18.025,
    "duration": 4.206
  },
  {
    "id": 6,
    "text": "吴承恩借唐僧取经之历史线索，融合民间神话传说与宗教演义，",
    "start": 18.025,
    "end": 23.37,
    "duration": 5.345
  },
  {
    "id": 7,
    "text": "构建起一个光怪陆离而又饱含人间真理的神魔世界。",
    "start": 23.37,
    "end": 27.581,
    "duration": 4.211
  },
  {
    "id": 8,
    "text": "鲁迅在 《中国小说史略》 中深刻指出其艺术特质在于 “神魔皆有人情，",
    "start": 27.581,
    "end": 33.498,
    "duration": 5.917
  },
  {
    "id": 9,
    "text": "精魅亦通世故”。",
    "start": 33.498,
    "end": 35.068,
    "duration": 1.57
  },
  {
    "id": 10,
    "text": "其奇幻世界的建构与审美特征，主要展现为以下四个核心维度：",
    "start": 35.068,
    "end": 40.503,
    "duration": 5.435
  },
  {
    "id": 11,
    "text": "第一，建构“幻由人生”的奇幻神话世界，",
    "start": 40.503,
    "end": 44.06,
    "duration": 3.557
  },
  {
    "id": 12,
    "text": "寄托深刻的社会现实批判。",
    "start": 44.06,
    "end": 46.208,
    "duration": 2.148
  },
  {
    "id": 13,
    "text": "《西游记》 的奇幻构架绝非脱离尘世的虚妄臆想，",
    "start": 46.208,
    "end": 52.244,
    "duration": 6.036
  },
  {
    "id": 14,
    "text": "而是现实人间的折光反射。",
    "start": 52.244,
    "end": 54.661,
    "duration": 2.417
  },
  {
    "id": 15,
    "text": "小说中所构筑的天宫、地府、龙宫与妖魔洞府，",
    "start": 54.661,
    "end": 59.829,
    "duration": 5.168
  },
  {
    "id": 16,
    "text": "无一不是封建现实官僚体制的艺术化投射。",
    "start": 59.829,
    "end": 64.317,
    "duration": 4.488
  },
  {
    "id": 17,
    "text": "玉皇大帝昏庸无能、任人唯亲，阎王判官受贿舞弊、颠倒是非；",
    "start": 64.317,
    "end": 71.601,
    "duration": 7.284
  },
  {
    "id": 18,
    "text": "取经途中盘踞各地的妖魔鬼怪，",
    "start": 71.601,
    "end": 73.508,
    "duration": 1.907
  },
  {
    "id": 19,
    "text": "多与天界神佛存在千丝万缕的亲属或随从关系：",
    "start": 73.508,
    "end": 78.694,
    "duration": 5.186
  },
  {
    "id": 20,
    "text": "青狮白象是菩萨坐骑，金角银角是老君童子，",
    "start": 78.694,
    "end": 83.379,
    "duration": 4.685
  },
  {
    "id": 21,
    "text": "作恶多端却因有后台庇护而免遭惩处；",
    "start": 83.379,
    "end": 85.729,
    "duration": 2.35
  },
  {
    "id": 22,
    "text": "比丘国国王听信国丈残害小儿，车迟国道士蛊惑朝纲。",
    "start": 85.729,
    "end": 90.494,
    "duration": 4.765
  },
  {
    "id": 23,
    "text": "这种借助神魔之笔的荒诞呈现，对明代中叶皇权专制、",
    "start": 90.494,
    "end": 97.148,
    "duration": 6.654
  },
  {
    "id": 24,
    "text": "奸佞误国与黑恶横行的腐朽现实作出了极其辛辣的隐喻批判。",
    "start": 97.148,
    "end": 102.77,
    "duration": 5.622
  },
  {
    "id": 25,
    "text": "第二，成功塑造追求个性自由的孙悟空典型形象，",
    "start": 102.77,
    "end": 106.44,
    "duration": 3.67
  },
  {
    "id": 26,
    "text": "确立反抗权威的抗争范式。",
    "start": 106.44,
    "end": 109.294,
    "duration": 2.854
  },
  {
    "id": 27,
    "text": "孙悟空是全书最光彩夺目的艺术形象，",
    "start": 109.294,
    "end": 112.851,
    "duration": 3.557
  },
  {
    "id": 28,
    "text": "集中体现了明末追求个性解放的精神追求。",
    "start": 112.851,
    "end": 116.25,
    "duration": 3.399
  },
  {
    "id": 29,
    "text": "在前七回中，他由天地灵气所生，自封美猴王，",
    "start": 116.25,
    "end": 120.513,
    "duration": 4.263
  },
  {
    "id": 30,
    "text": "在反抗天庭权威中迸发出 “皇帝轮流做，",
    "start": 120.513,
    "end": 124.012,
    "duration": 3.499
  },
  {
    "id": 31,
    "text": "明年到我家” 的震撼呼声，",
    "start": 124.012,
    "end": 127.062,
    "duration": 3.05
  },
  {
    "id": 32,
    "text": "彻底打破了封建等级不可逾越的戒律；在取经途中，",
    "start": 127.062,
    "end": 130.933,
    "duration": 3.871
  },
  {
    "id": 33,
    "text": "他面对艰难险阻勇往直前、不畏强暴，",
    "start": 130.933,
    "end": 133.565,
    "duration": 2.632
  },
  {
    "id": 34,
    "text": "展现出扫清人间邪恶的英雄气概。",
    "start": 133.565,
    "end": 136.894,
    "duration": 3.329
  },
  {
    "id": 35,
    "text": "孙悟空兼备 “神性、人性与物性” 三重品格：",
    "start": 136.894,
    "end": 141.856,
    "duration": 4.962
  },
  {
    "id": 36,
    "text": "既有七十二变、腾云驾雾的神通，又有猴子抓耳挠腮、",
    "start": 141.856,
    "end": 146.722,
    "duration": 4.866
  },
  {
    "id": 37,
    "text": "急躁好动的物性，更有重情重义、嫉恶如仇的人格真性，",
    "start": 146.722,
    "end": 151.348,
    "duration": 4.626
  },
  {
    "id": 38,
    "text": "成为中国古典文学中反抗权威与追求自由的永恒典型。",
    "start": 151.348,
    "end": 155.388,
    "duration": 4.04
  },
  {
    "id": 39,
    "text": "第三，融“童心天真”与幽默讽刺于一体，",
    "start": 155.388,
    "end": 158.503,
    "duration": 3.115
  },
  {
    "id": 40,
    "text": "达成引人入胜的喜剧美学境界。",
    "start": 158.503,
    "end": 164.107,
    "duration": 5.604
  },
  {
    "id": 41,
    "text": "在美学风貌上，《西游记》 极具明快诙谐的喜剧色彩。",
    "start": 164.107,
    "end": 170.254,
    "duration": 6.147
  },
  {
    "id": 42,
    "text": "作者深刻践行了李贽倡导的 “童心说”，",
    "start": 170.254,
    "end": 173.696,
    "duration": 3.442
  },
  {
    "id": 43,
    "text": "以纯真无邪的天真之笔展开妙趣横生的艺术想象。",
    "start": 173.696,
    "end": 177.777,
    "duration": 4.081
  },
  {
    "id": 44,
    "text": "取经团队内部性格互补且充满戏剧张力：",
    "start": 177.777,
    "end": 181.003,
    "duration": 3.226
  },
  {
    "id": 45,
    "text": "唐僧迂腐善良而固执不察，孙悟空机警急躁而本领高强，",
    "start": 181.003,
    "end": 185.583,
    "duration": 4.58
  },
  {
    "id": 46,
    "text": "猪八戒贪吃好色、憨厚懒惰却富有人情味，沙僧忠诚老实。",
    "start": 185.583,
    "end": 191.429,
    "duration": 5.846
  },
  {
    "id": 47,
    "text": "八戒与行者之间的插科打诨、互不相让，",
    "start": 191.429,
    "end": 195.693,
    "duration": 4.264
  },
  {
    "id": 48,
    "text": "使充满生死的凶险旅途洋溢着市井生活的人间乐趣；",
    "start": 195.693,
    "end": 199.834,
    "duration": 4.141
  },
  {
    "id": 49,
    "text": "作者善于将深刻的讽刺包裹在风趣幽默的叙述之中，",
    "start": 199.834,
    "end": 203.591,
    "duration": 3.757
  },
  {
    "id": 50,
    "text": "展现出举重若轻的高超幽默艺术。",
    "start": 203.591,
    "end": 206.877,
    "duration": 3.286
  },
  {
    "id": 51,
    "text": "第四，贯通三教合一的哲学意蕴，",
    "start": 206.877,
    "end": 211.143,
    "duration": 4.266
  },
  {
    "id": 52,
    "text": "构筑心性修炼与战胜心魔的心灵隐喻。",
    "start": 211.143,
    "end": 215.547,
    "duration": 4.404
  },
  {
    "id": 53,
    "text": "从深层哲学意蕴而言，《西游记》 深受明代儒、释、",
    "start": 215.547,
    "end": 219.54,
    "duration": 3.993
  },
  {
    "id": 54,
    "text": "道三教合流思潮的影响，构筑了一部完整的人类心性修养寓言。",
    "start": 219.54,
    "end": 221.837,
    "duration": 2.297
  },
  {
    "id": 55,
    "text": "孙悟空号称 “心猿”，猪八戒被称为 “木母” 或意马；",
    "start": 221.837,
    "end": 223.11,
    "duration": 1.273
  },
  {
    "id": 56,
    "text": "孙悟空学艺之所名为 “灵台方寸山，斜月三星洞”，",
    "start": 223.11,
    "end": 224.286,
    "duration": 1.176
  },
  {
    "id": 57,
    "text": "皆暗指人心。",
    "start": 224.286,
    "end": 227.465,
    "duration": 3.179
  },
  {
    "id": 58,
    "text": "八十一难降妖伏魔的艰险征途，本质上是个体克制私欲、",
    "start": 227.465,
    "end": 229.366,
    "duration": 1.901
  },
  {
    "id": 59,
    "text": "战胜心魔、由狂傲不羁走向心性圆融成熟的精神升华历程。",
    "start": 229.366,
    "end": 230.77,
    "duration": 1.404
  },
  {
    "id": 60,
    "text": "这种多维度的哲学隐喻，赋予了神魔故事极其深邃的生命哲学厚度。",
    "start": 230.77,
    "end": 232.631,
    "duration": 1.861
  }
]