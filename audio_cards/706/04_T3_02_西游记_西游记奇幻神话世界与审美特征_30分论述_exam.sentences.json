[
  {
    "id": 1,
    "text": "试论《西游记》的奇幻神话世界与审美特征。",
    "start": 0.08,
    "end": 3.568,
    "duration": 3.488
  },
  {
    "id": 2,
    "text": "《西游记》 是中国古典长篇神魔小说发展的至高巅峰，",
    "start": 3.944,
    "end": 7.819,
    "duration": 3.875
  },
  {
    "id": 3,
    "text": "也是古代浪漫主义小说的艺术瑰宝。",
    "start": 7.997,
    "end": 10.379,
    "duration": 2.382
  },
  {
    "id": 4,
    "text": "面对明代中后期王阳明心学崛起、",
    "start": 10.8,
    "end": 13.452,
    "duration": 2.652
  },
  {
    "id": 5,
    "text": "反抗程朱理学僵化与市民个性觉醒的时代思潮，",
    "start": 13.779,
    "end": 17.542,
    "duration": 3.763
  },
  {
    "id": 6,
    "text": "吴承恩借唐僧取经之历史线索，融合民间神话传说与宗教演义，",
    "start": 17.985,
    "end": 23.07,
    "duration": 5.085
  },
  {
    "id": 7,
    "text": "构建起一个光怪陆离而又饱含人间真理的神魔世界。",
    "start": 23.33,
    "end": 27.309,
    "duration": 3.979
  },
  {
    "id": 8,
    "text": "鲁迅在 《中国小说史略》 中深刻指出其艺术特质在于 “神魔皆有人情，",
    "start": 27.541,
    "end": 33.283,
    "duration": 5.742
  },
  {
    "id": 9,
    "text": "精魅亦通世故”。",
    "start": 33.458,
    "end": 34.769,
    "duration": 1.311
  },
  {
    "id": 10,
    "text": "其奇幻世界的建构与审美特征，主要展现为以下四个核心维度：",
    "start": 35.028,
    "end": 39.978,
    "duration": 4.95
  },
  {
    "id": 11,
    "text": "第一，建构“幻由人生”的奇幻神话世界，",
    "start": 40.463,
    "end": 43.694,
    "duration": 3.231
  },
  {
    "id": 12,
    "text": "寄托深刻的社会现实批判。",
    "start": 44.02,
    "end": 45.978,
    "duration": 1.958
  },
  {
    "id": 13,
    "text": "《西游记》 的奇幻构架绝非脱离尘世的虚妄臆想，",
    "start": 46.165,
    "end": 49.843,
    "duration": 3.678
  },
  {
    "id": 14,
    "text": "而是现实人间的折光反射。",
    "start": 49.914,
    "end": 51.902,
    "duration": 1.988
  },
  {
    "id": 15,
    "text": "小说中所构筑的天宫、地府、龙宫与妖魔洞府，",
    "start": 52.203,
    "end": 56.053,
    "duration": 3.85
  },
  {
    "id": 16,
    "text": "无一不是封建现实官僚体制的艺术化投射。",
    "start": 56.356,
    "end": 59.358,
    "duration": 3.002
  },
  {
    "id": 17,
    "text": "玉皇大帝昏庸无能、任人唯亲，阎王判官受贿舞弊、颠倒是非；",
    "start": 59.789,
    "end": 65.078,
    "duration": 5.289
  },
  {
    "id": 18,
    "text": "取经途中盘踞各地的妖魔鬼怪，",
    "start": 65.296,
    "end": 67.531,
    "duration": 2.235
  },
  {
    "id": 19,
    "text": "多与天界神佛存在千丝万缕的亲属或随从关系：",
    "start": 67.626,
    "end": 71.38,
    "duration": 3.754
  },
  {
    "id": 20,
    "text": "青狮白象是菩萨坐骑，金角银角是老君童子，",
    "start": 71.56,
    "end": 75.196,
    "duration": 3.636
  },
  {
    "id": 21,
    "text": "作恶多端却因有后台庇护而免遭惩处；",
    "start": 75.332,
    "end": 78.474,
    "duration": 3.142
  },
  {
    "id": 22,
    "text": "比丘国国王听信国丈残害小儿，车迟国道士蛊惑朝纲。",
    "start": 78.654,
    "end": 83.184,
    "duration": 4.53
  },
  {
    "id": 23,
    "text": "这种借助神魔之笔的荒诞呈现，对明代中叶皇权专制、",
    "start": 83.338,
    "end": 87.47,
    "duration": 4.132
  },
  {
    "id": 24,
    "text": "奸佞误国与黑恶横行的腐朽现实作出了极其辛辣的隐喻批判。",
    "start": 87.562,
    "end": 92.383,
    "duration": 4.821
  },
  {
    "id": 25,
    "text": "第二，成功塑造追求个性自由的孙悟空典型形象，",
    "start": 92.573,
    "end": 96.652,
    "duration": 4.079
  },
  {
    "id": 26,
    "text": "确立反抗权威的抗争范式。",
    "start": 97.106,
    "end": 99.288,
    "duration": 2.182
  },
  {
    "id": 27,
    "text": "孙悟空是全书最光彩夺目的艺术形象，",
    "start": 99.503,
    "end": 102.481,
    "duration": 2.978
  },
  {
    "id": 28,
    "text": "集中体现了明末追求个性解放的精神追求。",
    "start": 102.729,
    "end": 105.972,
    "duration": 3.243
  },
  {
    "id": 29,
    "text": "在前七回中，他由天地灵气所生，自封美猴王，",
    "start": 106.397,
    "end": 110.269,
    "duration": 3.872
  },
  {
    "id": 30,
    "text": "在反抗天庭权威中迸发出 “皇帝轮流做，",
    "start": 110.502,
    "end": 113.803,
    "duration": 3.301
  },
  {
    "id": 31,
    "text": "明年到我家” 的震撼呼声，",
    "start": 113.963,
    "end": 115.912,
    "duration": 1.949
  },
  {
    "id": 32,
    "text": "彻底打破了封建等级不可逾越的戒律；在取经途中，",
    "start": 116.21,
    "end": 120.267,
    "duration": 4.057
  },
  {
    "id": 33,
    "text": "他面对艰难险阻勇往直前、不畏强暴，",
    "start": 120.473,
    "end": 123.728,
    "duration": 3.255
  },
  {
    "id": 34,
    "text": "展现出扫清人间邪恶的英雄气概。",
    "start": 123.972,
    "end": 126.813,
    "duration": 2.841
  },
  {
    "id": 35,
    "text": "孙悟空兼备 “神性、人性与物性” 三重品格：",
    "start": 127.02,
    "end": 130.565,
    "duration": 3.545
  },
  {
    "id": 36,
    "text": "既有七十二变、腾云驾雾的神通，又有猴子抓耳挠腮、",
    "start": 130.892,
    "end": 135.158,
    "duration": 4.266
  },
  {
    "id": 37,
    "text": "急躁好动的物性，更有重情重义、嫉恶如仇的人格真性，",
    "start": 135.158,
    "end": 139.659,
    "duration": 4.501
  },
  {
    "id": 38,
    "text": "成为中国古典文学中反抗权威与追求自由的永恒典型。",
    "start": 139.989,
    "end": 144.537,
    "duration": 4.548
  },
  {
    "id": 39,
    "text": "第三，融“童心天真”与幽默讽刺于一体，",
    "start": 144.796,
    "end": 148.268,
    "duration": 3.472
  },
  {
    "id": 40,
    "text": "达成引人入胜的喜剧美学境界。",
    "start": 148.624,
    "end": 150.831,
    "duration": 2.207
  },
  {
    "id": 41,
    "text": "在美学风貌上，《西游记》 极具明快诙谐的喜剧色彩。",
    "start": 151.306,
    "end": 155.235,
    "duration": 3.929
  },
  {
    "id": 42,
    "text": "作者深刻践行了李贽倡导的 “童心说”，",
    "start": 155.348,
    "end": 158.17,
    "duration": 2.822
  },
  {
    "id": 43,
    "text": "以纯真无邪的天真之笔展开妙趣横生的艺术想象。",
    "start": 158.462,
    "end": 162.148,
    "duration": 3.686
  },
  {
    "id": 44,
    "text": "取经团队内部性格互补且充满戏剧张力：",
    "start": 162.214,
    "end": 165.363,
    "duration": 3.149
  },
  {
    "id": 45,
    "text": "唐僧迂腐善良而固执不察，孙悟空机警急躁而本领高强，",
    "start": 165.363,
    "end": 169.915,
    "duration": 4.552
  },
  {
    "id": 46,
    "text": "猪八戒贪吃好色、憨厚懒惰却富有人情味，沙僧忠诚老实。",
    "start": 170.214,
    "end": 175.038,
    "duration": 4.824
  },
  {
    "id": 47,
    "text": "八戒与行者之间的插科打诨、互不相让，",
    "start": 175.276,
    "end": 178.491,
    "duration": 3.215
  },
  {
    "id": 48,
    "text": "使充满生死的凶险旅途洋溢着市井生活的人间乐趣；",
    "start": 178.815,
    "end": 183.139,
    "duration": 4.324
  },
  {
    "id": 49,
    "text": "作者善于将深刻的讽刺包裹在风趣幽默的叙述之中，",
    "start": 183.55,
    "end": 187.961,
    "duration": 4.411
  },
  {
    "id": 50,
    "text": "展现出举重若轻的高超幽默艺术。",
    "start": 188.008,
    "end": 190.911,
    "duration": 2.903
  },
  {
    "id": 51,
    "text": "第四，贯通三教合一的哲学意蕴，",
    "start": 191.389,
    "end": 194.078,
    "duration": 2.689
  },
  {
    "id": 52,
    "text": "构筑心性修炼与战胜心魔的心灵隐喻。",
    "start": 194.355,
    "end": 197.53,
    "duration": 3.175
  },
  {
    "id": 53,
    "text": "从深层哲学意蕴而言，《西游记》 深受明代儒、释、",
    "start": 197.759,
    "end": 201.39,
    "duration": 3.631
  },
  {
    "id": 54,
    "text": "道三教合流思潮的影响，构筑了一部完整的人类心性修养寓言。",
    "start": 201.39,
    "end": 206.343,
    "duration": 4.953
  },
  {
    "id": 55,
    "text": "孙悟空号称 “心猿”，猪八戒被称为 “木母” 或意马；",
    "start": 206.837,
    "end": 210.661,
    "duration": 3.824
  },
  {
    "id": 56,
    "text": "孙悟空学艺之所名为 “灵台方寸山，斜月三星洞”，",
    "start": 211.103,
    "end": 215.091,
    "duration": 3.988
  },
  {
    "id": 57,
    "text": "皆暗指人心。",
    "start": 215.507,
    "end": 216.507,
    "duration": 1.0
  },
  {
    "id": 58,
    "text": "八十一难降妖伏魔的艰险征途，本质上是个体克制私欲、",
    "start": 216.722,
    "end": 221.568,
    "duration": 4.846
  },
  {
    "id": 59,
    "text": "战胜心魔、由狂傲不羁走向心性圆融成熟的精神升华历程。",
    "start": 221.797,
    "end": 227.079,
    "duration": 5.282
  },
  {
    "id": 60,
    "text": "这种多维度的哲学隐喻，赋予了神魔故事极其深邃的生命哲学厚度。",
    "start": 227.424,
    "end": 232.92,
    "duration": 5.496
  }
]
