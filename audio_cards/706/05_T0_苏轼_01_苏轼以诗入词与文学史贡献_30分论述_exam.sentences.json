[
  {
    "id": 1,
    "text": "苏轼是北宋文坛领袖，更是中国词史上最伟大的文体变革家。",
    "start": 0.08,
    "end": 5.44,
    "duration": 5.36
  },
  {
    "id": 2,
    "text": "南宋刘辰翁在《辛稼轩词序》中极评其词：“词至东坡，",
    "start": 5.44,
    "end": 10.24,
    "duration": 4.8
  },
  {
    "id": 3,
    "text": "倾荡磊落，如诗，如文，如曲，无所不可”。",
    "start": 10.24,
    "end": 14.08,
    "duration": 3.84
  },
  {
    "id": 4,
    "text": "袁行配《中国文学史》指出，苏轼通过“以诗为词”推动了词体革命。",
    "start": 14.24,
    "end": 19.76,
    "duration": 5.52
  },
  {
    "id": 5,
    "text": "他彻底打破了五代以来词为“艳科、",
    "start": 20.08,
    "end": 22.96,
    "duration": 2.88
  },
  {
    "id": 6,
    "text": "小道”的世俗传统观念。",
    "start": 22.96,
    "end": 25.12,
    "duration": 2.16
  },
  {
    "id": 7,
    "text": "苏轼赋予了词与传统诗歌并驾齐驱的独立抒情地位与崇高美学品格。",
    "start": 25.28,
    "end": 31.92,
    "duration": 6.64
  },
  {
    "id": 8,
    "text": "其具体的文学史贡献与艺术机制，主要展现在以下四个核心维度：晚唐五代以来，",
    "start": 31.92,
    "end": 38.96,
    "duration": 7.04
  },
  {
    "id": 9,
    "text": "词被死死禁锢于男女相思、规阁离怨与樽前酒色的狭窄牢笼。",
    "start": 38.96,
    "end": 44.32,
    "duration": 5.36
  },
  {
    "id": 10,
    "text": "苏轼以开阔的胸襟打破这一藩篱，将诗歌所能涵盖的一切生活内容全面引入词中。",
    "start": 44.72,
    "end": 51.52,
    "duration": 6.8
  },
  {
    "id": 11,
    "text": "在怀古咏史时，《念奴娇•赤壁怀古》写出“大江东去，",
    "start": 51.52,
    "end": 56.64,
    "duration": 5.12
  },
  {
    "id": 12,
    "text": "浪淘尽，千古风流人物”的万古苍茫。",
    "start": 56.64,
    "end": 59.84,
    "duration": 3.2
  },
  {
    "id": 13,
    "text": "在报国杀敌时，《江城子•密州出猎》写出“会挽雕弓如满月，",
    "start": 59.84,
    "end": 64.96,
    "duration": 5.12
  },
  {
    "id": 14,
    "text": "西北望，射天狼”的边塞壮志。",
    "start": 64.96,
    "end": 67.36,
    "duration": 2.4
  },
  {
    "id": 15,
    "text": "在悼念亡妻时，《江城子•乙卯正月二十日夜记梦》写出“十年生死两茫茫”的至情哀痛。",
    "start": 67.68,
    "end": 75.76,
    "duration": 8.08
  },
  {
    "id": 16,
    "text": "在描摹田园时，《浣溪沙》写出“簌簌衣巾落枣花，",
    "start": 75.76,
    "end": 80.24,
    "duration": 4.48
  },
  {
    "id": 17,
    "text": "村南村北响骚车”的质朴生机。",
    "start": 80.24,
    "end": 83.44,
    "duration": 3.2
  },
  {
    "id": 18,
    "text": "苏轼真正做到了无事不可入词、无意不可表达，",
    "start": 83.44,
    "end": 87.76,
    "duration": 4.32
  },
  {
    "id": 19,
    "text": "使词具备了反映全部社会生活的广阔容量。",
    "start": 87.76,
    "end": 91.2,
    "duration": 3.44
  },
  {
    "id": 20,
    "text": "传统词体在情感格调上偏重企靡、柔弱与凄楚感伤，",
    "start": 91.52,
    "end": 96.4,
    "duration": 4.88
  },
  {
    "id": 21,
    "text": "充斥着羁旅与深规幽怨。",
    "start": 96.4,
    "end": 98.64,
    "duration": 2.24
  },
  {
    "id": 22,
    "text": "苏轼将士大夫崇高旷达的精神人格注入词中，",
    "start": 98.64,
    "end": 102.32,
    "duration": 3.68
  },
  {
    "id": 23,
    "text": "开创了豪放与旷达相济的美学新境。",
    "start": 102.32,
    "end": 105.2,
    "duration": 2.88
  },
  {
    "id": 24,
    "text": "黄州贬哲的逆境之中，他在《定风波》中写道：“竹杖芒鞋轻胜马，",
    "start": 105.2,
    "end": 109.92,
    "duration": 4.72
  },
  {
    "id": 25,
    "text": "谁怕？",
    "start": 109.92,
    "end": 110.4,
    "duration": 0.48
  },
  {
    "id": 26,
    "text": "一蓑烟雨任平生”。",
    "start": 110.8,
    "end": 113.12,
    "duration": 2.32
  },
  {
    "id": 27,
    "text": "面对人生的风雨泥泞与政治迫害，他展现出超然物外、",
    "start": 113.12,
    "end": 118.56,
    "duration": 5.44
  },
  {
    "id": 28,
    "text": "从容豁达的博大胸襟。",
    "start": 118.56,
    "end": 120.88,
    "duration": 2.32
  },
  {
    "id": 29,
    "text": "词的尾联更有“回首向来萧瑟处，归去，",
    "start": 120.88,
    "end": 125.28,
    "duration": 4.4
  },
  {
    "id": 30,
    "text": "也无风雨也无晴”的超凡通透。",
    "start": 125.28,
    "end": 128.48,
    "duration": 3.2
  },
  {
    "id": 31,
    "text": "词由此摆脱了娱宾遣兴的倡条冶叶性质，",
    "start": 128.48,
    "end": 132.32,
    "duration": 3.84
  },
  {
    "id": 32,
    "text": "升华为士大夫安顿生命风骨的高雅载体。",
    "start": 132.32,
    "end": 135.76,
    "duration": 3.44
  },
  {
    "id": 33,
    "text": "在体制机制上，传统词完全依附于音乐曲调，",
    "start": 136.08,
    "end": 139.92,
    "duration": 3.84
  },
  {
    "id": 34,
    "text": "以迎合听众与歌妓歌唱为单一目的。",
    "start": 139.92,
    "end": 142.96,
    "duration": 3.04
  },
  {
    "id": 35,
    "text": "苏轼推动了词从歌场案头化与读者化转变，",
    "start": 142.96,
    "end": 146.72,
    "duration": 3.76
  },
  {
    "id": 36,
    "text": "把词变成了可以独立阅读的文人文学。",
    "start": 146.72,
    "end": 149.68,
    "duration": 2.96
  },
  {
    "id": 37,
    "text": "他广泛确立了在词前配加“题序”与小传的体裁惯例。",
    "start": 149.68,
    "end": 154.16,
    "duration": 4.48
  },
  {
    "id": 38,
    "text": "如《水调歌头•明月几时有》题序写道：“丙辰中秋，",
    "start": 154.528,
    "end": 159.088,
    "duration": 4.56
  },
  {
    "id": 39,
    "text": "欢饮达旦，大醉，作此篇，兼怀子由”。",
    "start": 159.088,
    "end": 162.768,
    "duration": 3.68
  },
  {
    "id": 40,
    "text": "题序的加入赋予了词作清晰的时空背景、",
    "start": 162.768,
    "end": 166.048,
    "duration": 3.28
  },
  {
    "id": 41,
    "text": "叙事由头与真挚的人生情态。",
    "start": 166.048,
    "end": 168.848,
    "duration": 2.8
  },
  {
    "id": 42,
    "text": "在音律上，他敢于打破拘泥协律的绳墨，",
    "start": 168.848,
    "end": 172.448,
    "duration": 3.6
  },
  {
    "id": 43,
    "text": "虽然遭到李清照关于“词别是一家”的批评。",
    "start": 172.448,
    "end": 175.728,
    "duration": 3.28
  },
  {
    "id": 44,
    "text": "然而这恰恰标志着词彻底打破曲调奴役，",
    "start": 176.048,
    "end": 179.808,
    "duration": 3.76
  },
  {
    "id": 45,
    "text": "走上了纯文学抒情的自主道路。",
    "start": 179.808,
    "end": 182.448,
    "duration": 2.64
  },
  {
    "id": 46,
    "text": "苏轼在语言风格上进行了一场彻底的荡涤，",
    "start": 182.448,
    "end": 186.368,
    "duration": 3.92
  },
  {
    "id": 47,
    "text": "以诗文句法取代花间词浓艳的脂粉气。",
    "start": 186.368,
    "end": 190.288,
    "duration": 3.92
  },
  {
    "id": 48,
    "text": "他大量吸纳高古的诗歌语汇、经史典故与散文句式，",
    "start": 190.288,
    "end": 195.408,
    "duration": 5.12
  },
  {
    "id": 49,
    "text": "使词语呈现清雄雅健之风。",
    "start": 195.408,
    "end": 197.888,
    "duration": 2.48
  },
  {
    "id": 50,
    "text": "如描摹赤壁风光时写道：“乱石穿空，",
    "start": 198.208,
    "end": 201.648,
    "duration": 3.44
  },
  {
    "id": 51,
    "text": "惊涛拍岸，卷起千堆雪”，笔力遒劲生动。",
    "start": 201.648,
    "end": 205.648,
    "duration": 4.0
  },
  {
    "id": 52,
    "text": "全词骨力强劲、神采飞扬，丝毫没有传统艳词的雕琢粉饰与黏滞软媚。",
    "start": 205.648,
    "end": 212.368,
    "duration": 6.72
  },
  {
    "id": 53,
    "text": "这种以诗入词的语言革新，极大地增强了词体的表现力与张力，",
    "start": 212.368,
    "end": 217.248,
    "duration": 4.88
  },
  {
    "id": 54,
    "text": "达到了化境。",
    "start": 217.248,
    "end": 218.128,
    "duration": 0.88
  },
  {
    "id": 55,
    "text": "综上所述，苏轼的“以诗为词”是中国词史上最伟大、",
    "start": 218.368,
    "end": 223.168,
    "duration": 4.8
  },
  {
    "id": 56,
    "text": "最深刻的一场文体解放运动。",
    "start": 223.168,
    "end": 225.248,
    "duration": 2.08
  },
  {
    "id": 57,
    "text": "他不仅彻底改变了词的发展方向，更奠定了豪放词派的宏伟基石。",
    "start": 225.248,
    "end": 230.528,
    "duration": 5.28
  },
  {
    "id": 58,
    "text": "苏轼的开创直接启迪并哺育了南宋辛弃疾、",
    "start": 230.528,
    "end": 234.528,
    "duration": 4.0
  },
  {
    "id": 59,
    "text": "陈亮、刘过等爱国词人集团。",
    "start": 234.528,
    "end": 236.688,
    "duration": 2.16
  },
  {
    "id": 60,
    "text": "“苏辛”并称因而成为中国词史上豪迈雄奇精神的最崇高象征。--",
    "start": 236.848,
    "end": 242.288,
    "duration": 5.44
  }
]