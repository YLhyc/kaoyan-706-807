[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 3.2,
    "duration": 3.12
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 3.2,
    "end": 6.0,
    "duration": 2.8
  },
  {
    "id": 3,
    "text": "这道题考查中国古典戏曲史上的文人化巅峰《西厢记》。",
    "start": 6.24,
    "end": 11.12,
    "duration": 4.88
  },
  {
    "id": 4,
    "text": "在考场上，考生必须回答出该剧如何将唐传奇的封建悲剧转变为团圆喜剧背后的思想质变，",
    "start": 11.12,
    "end": 19.2,
    "duration": 8.08
  },
  {
    "id": 5,
    "text": "并紧扣人物塑造（尤其是张生转变与莺莺心理）和曲词艺术两大艺术支柱展开全面论证。",
    "start": 19.2,
    "end": 26.72,
    "duration": 7.52
  },
  {
    "id": 6,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 27.04,
    "end": 30.32,
    "duration": 3.28
  },
  {
    "id": 7,
    "text": "答题必须确立“思想抗争、趋近于、",
    "start": 30.32,
    "end": 33.03,
    "duration": 2.71
  },
  {
    "id": 8,
    "text": "人物性格、趋近于、形式艺术”三位一体的论述流线。",
    "start": 33.03,
    "end": 37.23,
    "duration": 4.2
  },
  {
    "id": 9,
    "text": "从反封建礼教的核心主题切入，落实到封建家长崔夫人与追求爱情的青年群像的戏剧冲突，",
    "start": 37.23,
    "end": 45.21,
    "duration": 7.98
  },
  {
    "id": 10,
    "text": "剖析张生形象演变与莺莺心理异变，",
    "start": 45.21,
    "end": 48.36,
    "duration": 3.15
  },
  {
    "id": 11,
    "text": "最后落脚于曲词典雅化美学与长亭送别名场面。",
    "start": 48.36,
    "end": 52.56,
    "duration": 4.2
  },
  {
    "id": 12,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 52.72,
    "end": 56.08,
    "duration": 3.36
  },
  {
    "id": 13,
    "text": "全题分为四个核心论述维度：第一维度：界定《西厢记》作为中国古典戏曲抒情艺术丰碑的文学史地位；",
    "start": 56.08,
    "end": 64.32,
    "duration": 8.24
  },
  {
    "id": 14,
    "text": "第二维度：深入剖析“愿普天下有情的都成了眷属”的反封建礼教思想意蕴与“情”对“礼”的抗争；",
    "start": 64.32,
    "end": 72.4,
    "duration": 8.08
  },
  {
    "id": 15,
    "text": "-第三维度：深刻论述张生形象的历史改造、",
    "start": 72.64,
    "end": 76.293,
    "duration": 3.653
  },
  {
    "id": 16,
    "text": "崔莺莺细腻心理矛盾与红娘机智反叛的人物塑造艺术；",
    "start": 76.293,
    "end": 81.234,
    "duration": 4.941
  },
  {
    "id": 17,
    "text": "-第四维度：精准剖析五本二十一折宏大体制与“花间美人”式的典雅诗化曲词美学；",
    "start": 81.234,
    "end": 88.325,
    "duration": 7.091
  },
  {
    "id": 18,
    "text": "-第五维度：宏观总结《西厢记》在思想启蒙与元杂剧文人化进程中的里程碑价值。",
    "start": 88.325,
    "end": 95.2,
    "duration": 6.875
  },
  {
    "id": 19,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 95.36,
    "end": 99.12,
    "duration": 3.76
  },
  {
    "id": 20,
    "text": "全题逻辑严密咬合：第一步先确立名著历史地位与对唐传奇的超越。",
    "start": 99.12,
    "end": 104.8,
    "duration": 5.68
  },
  {
    "id": 21,
    "text": "第二步深入思想母题，揭露礼教虚伪与歌颂纯真之情。",
    "start": 104.8,
    "end": 109.52,
    "duration": 4.72
  },
  {
    "id": 22,
    "text": "第三步剖析这一思想如何承载于具体人物的心理与性格转换上。",
    "start": 109.52,
    "end": 114.48,
    "duration": 4.96
  },
  {
    "id": 23,
    "text": "第四步剖析表现这些人物情感的高峰形式即戏剧结构与抒情曲词。",
    "start": 114.72,
    "end": 120.16,
    "duration": 5.44
  },
  {
    "id": 24,
    "text": "第五步完成宏观历史论证闭环。",
    "start": 120.16,
    "end": 123.04,
    "duration": 2.88
  },
  {
    "id": 25,
    "text": "二、各板块逐句咬合演练。",
    "start": 123.04,
    "end": 125.2,
    "duration": 2.16
  },
  {
    "id": 26,
    "text": "一、开头破题段内部咬合。",
    "start": 125.2,
    "end": 127.6,
    "duration": 2.4
  },
  {
    "id": 27,
    "text": "本段旨在开门见山确立戏曲丰碑的立论基石。",
    "start": 127.6,
    "end": 131.28,
    "duration": 3.68
  },
  {
    "id": 28,
    "text": "首句直切经典地位，次句交代对唐传奇的重构与审美标杆。",
    "start": 131.28,
    "end": 135.84,
    "duration": 4.56
  },
  {
    "id": 29,
    "text": "-首先，首句必须直接亮出该剧在戏曲史上的崇高地位，",
    "start": 136.128,
    "end": 140.649,
    "duration": 4.521
  },
  {
    "id": 30,
    "text": "具体表述到答题语句就是：元代王实甫所著《崔莺莺待月西厢记》是中国古典戏曲史上的抒情艺术丰碑。",
    "start": 140.649,
    "end": 149.279,
    "duration": 8.63
  },
  {
    "id": 31,
    "text": "有了经典定性之后，次句必须迅速说明其对前代题材的根本质变，",
    "start": 149.279,
    "end": 154.827,
    "duration": 5.548
  },
  {
    "id": 32,
    "text": "具体表述到答题语句就是：剧作以极其鲜明的反封建礼教锋芒与高度诗化的曲词文采，",
    "start": 154.827,
    "end": 162.224,
    "duration": 7.397
  },
  {
    "id": 33,
    "text": "将唐代元稹传奇《莺莺传》彻底重构为歌颂纯真爱情的青春赞歌，",
    "start": 162.224,
    "end": 167.567,
    "duration": 5.343
  },
  {
    "id": 34,
    "text": "确立了中国戏曲文学追求人性解放的崇高审美标杆。，",
    "start": 167.567,
    "end": 172.087,
    "duration": 4.52
  },
  {
    "id": 35,
    "text": "这句话直接铺陈出思想与艺术两翼齐飞的论述框架。",
    "start": 172.087,
    "end": 176.608,
    "duration": 4.521
  },
  {
    "id": 36,
    "text": "元代王实甫所著《崔莺莺待月西厢记》是中国古典戏曲史上的抒情艺术丰碑。",
    "start": 176.768,
    "end": 183.248,
    "duration": 6.48
  },
  {
    "id": 37,
    "text": "剧作以极其鲜明的反封建礼教锋芒与高度诗化的曲词文采，",
    "start": 183.248,
    "end": 188.688,
    "duration": 5.44
  },
  {
    "id": 38,
    "text": "将唐代元稹传奇《莺莺传》彻底重构为歌颂纯真爱情的青春赞歌，",
    "start": 188.688,
    "end": 194.608,
    "duration": 5.92
  },
  {
    "id": 39,
    "text": "确立了中国戏曲文学追求人性解放的崇高审美标杆。",
    "start": 194.608,
    "end": 198.768,
    "duration": 4.16
  },
  {
    "id": 40,
    "text": "二、第一维度：反封建礼教思想意蕴内部咬合。",
    "start": 199.088,
    "end": 202.848,
    "duration": 3.76
  },
  {
    "id": 41,
    "text": "本段任务是深入剖析“天下有情人终成眷属”的主题，",
    "start": 202.848,
    "end": 207.248,
    "duration": 4.4
  },
  {
    "id": 42,
    "text": "揭露崔夫人代表的礼教虚伪。",
    "start": 207.248,
    "end": 209.568,
    "duration": 2.32
  },
  {
    "id": 43,
    "text": "首先，段首给出结论先行的分论点，",
    "start": 209.568,
    "end": 212.448,
    "duration": 2.88
  },
  {
    "id": 44,
    "text": "具体表述到答题语句就是：第一，在思想意蕴上，",
    "start": 212.448,
    "end": 216.528,
    "duration": 4.08
  },
  {
    "id": 45,
    "text": "《西厢记》旗帜鲜明地确立了“愿普天下有情的都成了眷属”的进步主张，",
    "start": 216.528,
    "end": 221.888,
    "duration": 5.36
  },
  {
    "id": 46,
    "text": "深刻冲击了封建门阀婚姻与理学礼教网络。",
    "start": 221.888,
    "end": 225.488,
    "duration": 3.6
  },
  {
    "id": 47,
    "text": "-随后，阐释其爱情观对封建教条的否定，",
    "start": 225.728,
    "end": 229.156,
    "duration": 3.428
  },
  {
    "id": 48,
    "text": "具体表述到答题语句就是：全剧将爱情建立在男女双方性灵相契与才德相慕的真诚基础之上，",
    "start": 229.156,
    "end": 237.513,
    "duration": 8.357
  },
  {
    "id": 49,
    "text": "彻底否定了“父母之命，媒妁之言”的世俗功利准则。",
    "start": 237.513,
    "end": 241.798,
    "duration": 4.285
  },
  {
    "id": 50,
    "text": "紧接着，调取崔夫人退贼后赖婚的典型情节，",
    "start": 241.798,
    "end": 245.655,
    "duration": 3.857
  },
  {
    "id": 51,
    "text": "具体表述到答题语句就是：崔夫人作为封建家长制与门阀阶级的顽固代表，",
    "start": 245.655,
    "end": 252.297,
    "duration": 6.642
  },
  {
    "id": 52,
    "text": "在孙飞虎围困普救寺时许诺“退得贼兵者以莺莺妻之”，",
    "start": 252.297,
    "end": 257.011,
    "duration": 4.714
  },
  {
    "id": 53,
    "text": "事定之后却立即毁约赖婚，暴露出封建礼教虚伪冷酷的本质。",
    "start": 257.011,
    "end": 262.368,
    "duration": 5.357
  },
  {
    "id": 54,
    "text": "-最后，收束提炼该反抗斗争的思想价值，",
    "start": 262.416,
    "end": 265.973,
    "duration": 3.557
  },
  {
    "id": 55,
    "text": "具体表述到答题语句就是：全剧正是通过张生与崔莺莺在红娘协助下冲破这一重重阻挠的曲折斗争，",
    "start": 265.973,
    "end": 275.31,
    "duration": 9.337
  },
  {
    "id": 56,
    "text": "肯定了青年男女对自主爱情的执着追求，",
    "start": 275.31,
    "end": 279.09,
    "duration": 3.78
  },
  {
    "id": 57,
    "text": "使“情”战胜了“礼”，闪烁着早期启蒙主义的人性光辉。",
    "start": 279.09,
    "end": 283.536,
    "duration": 4.446
  },
  {
    "id": 58,
    "text": "第一，在思想意蕴上，《西厢记》旗帜鲜明地确立了“愿普天下有情的都成了眷属”的进步主张，",
    "start": 283.616,
    "end": 291.856,
    "duration": 8.24
  },
  {
    "id": 59,
    "text": "深刻冲击了封建门阀婚姻与理学礼教网络。",
    "start": 291.856,
    "end": 295.936,
    "duration": 4.08
  },
  {
    "id": 60,
    "text": "全剧将爱情建立在男女双方性灵相契与才德相慕的真诚基础之上，",
    "start": 295.936,
    "end": 302.336,
    "duration": 6.4
  },
  {
    "id": 61,
    "text": "彻底否定了“父母之命，媒妁之言”的世俗功利准则。",
    "start": 302.336,
    "end": 306.976,
    "duration": 4.64
  },
  {
    "id": 62,
    "text": "崔夫人作为封建家长制与门阀阶级的顽固代表，",
    "start": 307.296,
    "end": 310.896,
    "duration": 3.6
  },
  {
    "id": 63,
    "text": "在孙飞虎围困普救寺时许诺“退得贼兵者以莺莺妻之”，",
    "start": 310.896,
    "end": 315.456,
    "duration": 4.56
  },
  {
    "id": 64,
    "text": "事定之后却立即毁约赖婚，暴露出封建礼教虚伪冷酷的本质。",
    "start": 315.456,
    "end": 319.776,
    "duration": 4.32
  },
  {
    "id": 65,
    "text": "全剧正是通过张生与崔莺莺在红娘协助下冲破这一重重阻挠的曲折斗争，",
    "start": 319.776,
    "end": 325.296,
    "duration": 5.52
  },
  {
    "id": 66,
    "text": "肯定了青年男女对自主爱情的执着追求，",
    "start": 325.296,
    "end": 328.256,
    "duration": 2.96
  },
  {
    "id": 67,
    "text": "使“情”战胜了“礼”，闪烁着早期启蒙主义的人性光辉。",
    "start": 328.256,
    "end": 332.176,
    "duration": 3.92
  },
  {
    "id": 68,
    "text": "三、第二维度：人物塑造与历史演进机制内部咬合。",
    "start": 332.576,
    "end": 337.296,
    "duration": 4.72
  },
  {
    "id": 69,
    "text": "本段任务是全面剖析张生从负心到志诚的转变、",
    "start": 337.296,
    "end": 341.696,
    "duration": 4.4
  },
  {
    "id": 70,
    "text": "崔莺莺深规矛盾心理与红娘反抗性格。",
    "start": 341.696,
    "end": 345.216,
    "duration": 3.52
  },
  {
    "id": 71,
    "text": "首先，段首给出统领分论点，具体表述到答题语句就是：第二，",
    "start": 345.216,
    "end": 350.816,
    "duration": 5.6
  },
  {
    "id": 72,
    "text": "在人物形象塑造上，剧作实现了人物性格由历史旧范式向新型典型性格的成功转换，",
    "start": 350.816,
    "end": 358.176,
    "duration": 7.36
  },
  {
    "id": 73,
    "text": "呈现出细腻真实的心理流变。",
    "start": 358.176,
    "end": 360.336,
    "duration": 2.16
  },
  {
    "id": 74,
    "text": "-随后，剖析张生形象的历史性飞跃，",
    "start": 360.496,
    "end": 363.466,
    "duration": 2.97
  },
  {
    "id": 75,
    "text": "具体表述到答题语句就是：王实甫对历史题材进行了革命性改造。",
    "start": 363.466,
    "end": 369.194,
    "duration": 5.728
  },
  {
    "id": 76,
    "text": "唐传奇中“始乱终弃”的薄幸文人张生，",
    "start": 369.194,
    "end": 372.376,
    "duration": 3.182
  },
  {
    "id": 77,
    "text": "在剧中被重塑为对爱情忠贞不渝、甚至敢于蔑视功名的纯情士人，",
    "start": 372.376,
    "end": 378.104,
    "duration": 5.728
  },
  {
    "id": 78,
    "text": "其在寺中惊艳、隔墙酬和直至相思成疾，",
    "start": 378.104,
    "end": 381.498,
    "duration": 3.394
  },
  {
    "id": 79,
    "text": "皆洋溢着志诚君子的赤子之情。",
    "start": 381.498,
    "end": 384.256,
    "duration": 2.758
  },
  {
    "id": 80,
    "text": "-紧接着，深入剖析崔莺莺心理矛盾的细腻写实，",
    "start": 384.312,
    "end": 388.085,
    "duration": 3.773
  },
  {
    "id": 81,
    "text": "具体表述到答题语句就是：女主角崔莺莺的塑造更是深具艺术深度。",
    "start": 388.085,
    "end": 393.644,
    "duration": 5.559
  },
  {
    "id": 82,
    "text": "作为相国千金，崔莺莺既深受封建封建礼数长期浸染而自持自矜，",
    "start": 393.644,
    "end": 399.005,
    "duration": 5.361
  },
  {
    "id": 83,
    "text": "内心又充满对青春爱情的热烈渴望。，",
    "start": 399.005,
    "end": 401.983,
    "duration": 2.978
  },
  {
    "id": 84,
    "text": "并调取动作细节：王实甫极其细腻地刻画了她在“寄简”、",
    "start": 401.983,
    "end": 406.352,
    "duration": 4.369
  },
  {
    "id": 85,
    "text": "“闹简”到“赖简”过程中的心理震颤，",
    "start": 406.352,
    "end": 408.933,
    "duration": 2.581
  },
  {
    "id": 86,
    "text": "表面上的嗔怒掩盖不住内心的波澜，",
    "start": 408.933,
    "end": 411.911,
    "duration": 2.978
  },
  {
    "id": 87,
    "text": "真实呈现出一位深规少女由顾虑重重走向冲破罗网的觉醒轨迹。",
    "start": 411.911,
    "end": 417.272,
    "duration": 5.361
  },
  {
    "id": 88,
    "text": "-最后，点睛红娘的平民侠义与拷红名场面，",
    "start": 417.272,
    "end": 420.832,
    "duration": 3.56
  },
  {
    "id": 89,
    "text": "具体表述到答题语句就是：红娘则作为反叛精神的催化剂，",
    "start": 420.832,
    "end": 425.858,
    "duration": 5.026
  },
  {
    "id": 90,
    "text": "兼具机智侠义与平民智慧，在“拷红”一场面对崔夫人理直气壮据理力争，",
    "start": 425.858,
    "end": 431.931,
    "duration": 6.073
  },
  {
    "id": 91,
    "text": "成为古典戏剧中最生动鲜活的婢女形象。",
    "start": 431.931,
    "end": 435.491,
    "duration": 3.56
  },
  {
    "id": 92,
    "text": "第二，在人物形象塑造上，剧作实现了人物性格由历史旧范式向新型典型性格的成功转换，",
    "start": 435.491,
    "end": 443.239,
    "duration": 7.748
  },
  {
    "id": 93,
    "text": "呈现出细腻真实的心理流变。",
    "start": 443.239,
    "end": 445.752,
    "duration": 2.513
  },
  {
    "id": 94,
    "text": "王实甫对历史题材进行了革命性改造。",
    "start": 445.832,
    "end": 449.032,
    "duration": 3.2
  },
  {
    "id": 95,
    "text": "唐传奇中“始乱终弃”的薄幸文人张生，",
    "start": 449.032,
    "end": 452.392,
    "duration": 3.36
  },
  {
    "id": 96,
    "text": "在剧中被重塑为对爱情忠贞不渝、甚至敢于蔑视功名的纯情士人，",
    "start": 452.392,
    "end": 457.672,
    "duration": 5.28
  },
  {
    "id": 97,
    "text": "其在寺中惊艳、隔墙酬和直至相思成疾，",
    "start": 457.672,
    "end": 461.032,
    "duration": 3.36
  },
  {
    "id": 98,
    "text": "皆洋溢着志诚君子的赤子之情。",
    "start": 461.032,
    "end": 463.512,
    "duration": 2.48
  },
  {
    "id": 99,
    "text": "女主角崔莺莺的塑造更是深具艺术深度。",
    "start": 463.512,
    "end": 466.552,
    "duration": 3.04
  },
  {
    "id": 100,
    "text": "作为相国千金，崔莺莺既深受封建封建礼数长期浸染而自持自矜，",
    "start": 466.792,
    "end": 473.192,
    "duration": 6.4
  },
  {
    "id": 101,
    "text": "内心又充满对青春爱情的热烈渴望。",
    "start": 473.192,
    "end": 476.072,
    "duration": 2.88
  },
  {
    "id": 102,
    "text": "王实甫极其细腻地刻画了她在“寄简”、",
    "start": 476.072,
    "end": 479.272,
    "duration": 3.2
  },
  {
    "id": 103,
    "text": "“闹简”到“赖简”过程中的心理震颤，",
    "start": 479.272,
    "end": 482.152,
    "duration": 2.88
  },
  {
    "id": 104,
    "text": "表面上的嗔怒掩盖不住内心的波澜，",
    "start": 482.152,
    "end": 485.192,
    "duration": 3.04
  },
  {
    "id": 105,
    "text": "真实呈现出一位深规少女由顾虑重重走向冲破罗网的觉醒轨迹。",
    "start": 485.192,
    "end": 490.712,
    "duration": 5.52
  },
  {
    "id": 106,
    "text": "红娘则作为反叛精神的催化剂，兼具机智侠义与平民智慧，",
    "start": 490.952,
    "end": 495.912,
    "duration": 4.96
  },
  {
    "id": 107,
    "text": "在“拷红”一场面对崔夫人理直气壮据理力争，",
    "start": 495.912,
    "end": 499.672,
    "duration": 3.76
  },
  {
    "id": 108,
    "text": "成为古典戏剧中最生动鲜活的婢女形象。",
    "start": 499.672,
    "end": 503.192,
    "duration": 3.52
  },
  {
    "id": 109,
    "text": "四、第三维度：戏剧结构与诗化曲词美学内部咬合。",
    "start": 503.192,
    "end": 507.912,
    "duration": 4.72
  },
  {
    "id": 110,
    "text": "本段任务是落脚于戏剧艺术本体，评述五本二十一折宏大体制与长亭送别名篇曲词。",
    "start": 507.912,
    "end": 514.952,
    "duration": 7.04
  },
  {
    "id": 111,
    "text": "-首先，段首给出统领分论点，具体表述到答题语句就是：第三，",
    "start": 515.192,
    "end": 520.674,
    "duration": 5.482
  },
  {
    "id": 112,
    "text": "在戏剧结构与曲词艺术上，剧作打破了元杂剧四折一楔子的成规定制，",
    "start": 520.674,
    "end": 527.298,
    "duration": 6.624
  },
  {
    "id": 113,
    "text": "创造了五本二十一折的宏大叙事体制与典雅诗化风格。",
    "start": 527.298,
    "end": 532.552,
    "duration": 5.254
  },
  {
    "id": 114,
    "text": "-随后，说明情节节奏的紧凑连贯，",
    "start": 532.608,
    "end": 535.611,
    "duration": 3.003
  },
  {
    "id": 115,
    "text": "具体表述到答题语句就是：《西厢记》情节起伏跌宕，",
    "start": 535.611,
    "end": 540.231,
    "duration": 4.62
  },
  {
    "id": 116,
    "text": "寺警、酬韵、赖婚、琴挑、闹简、佳期、",
    "start": 540.231,
    "end": 543.002,
    "duration": 2.771
  },
  {
    "id": 117,
    "text": "长亭送别环环相扣，悬念丛生且节奏紧凑。",
    "start": 543.002,
    "end": 546.929,
    "duration": 3.927
  },
  {
    "id": 118,
    "text": "紧接着，引用明代评语点明其曲词风格，",
    "start": 546.929,
    "end": 550.625,
    "duration": 3.696
  },
  {
    "id": 119,
    "text": "具体表述到答题语句就是：在语言美学上，",
    "start": 550.625,
    "end": 554.552,
    "duration": 3.927
  },
  {
    "id": 120,
    "text": "明代谢榛评其“如花间美人”，剧作完全摆脱了元曲早期粗豪俚俗的习气，",
    "start": 554.552,
    "end": 561.25,
    "duration": 6.698
  },
  {
    "id": 121,
    "text": "将古典诗词的清词丽句完美融入通俗戏曲。",
    "start": 561.25,
    "end": 565.408,
    "duration": 4.158
  },
  {
    "id": 122,
    "text": "-最后，调取《长亭送别》千古绝唱完整剖析，",
    "start": 565.408,
    "end": 569.101,
    "duration": 3.693
  },
  {
    "id": 123,
    "text": "具体表述到答题语句就是：比如第四本第三折《长亭送别》中，",
    "start": 569.101,
    "end": 574.642,
    "duration": 5.541
  },
  {
    "id": 124,
    "text": "“碧云天，黄花地，西风紧，北雁南飞。",
    "start": 574.642,
    "end": 577.643,
    "duration": 3.001
  },
  {
    "id": 125,
    "text": "晓来谁染霜林醉？",
    "start": 577.643,
    "end": 579.258,
    "duration": 1.615
  },
  {
    "id": 126,
    "text": "总是离人泪”，不仅化用范仲淹诗词意境，",
    "start": 579.258,
    "end": 582.952,
    "duration": 3.694
  },
  {
    "id": 127,
    "text": "更将满目秋景与主人公肝肠寸断的离别深情融铸一炉，",
    "start": 582.952,
    "end": 588.261,
    "duration": 5.309
  },
  {
    "id": 128,
    "text": "达到了意象幽美与情感沉痛的高度统一，",
    "start": 588.261,
    "end": 592.185,
    "duration": 3.924
  },
  {
    "id": 129,
    "text": "成为中国抒情戏剧曲词的千古绝唱。",
    "start": 592.185,
    "end": 595.648,
    "duration": 3.463
  },
  {
    "id": 130,
    "text": "第三，在戏剧结构与曲词艺术上，剧作打破了元杂剧四折一楔子的成规定制，",
    "start": 595.728,
    "end": 602.608,
    "duration": 6.88
  },
  {
    "id": 131,
    "text": "创造了五本二十一折的宏大叙事体制与典雅诗化风格。",
    "start": 602.608,
    "end": 607.248,
    "duration": 4.64
  },
  {
    "id": 132,
    "text": "《西厢记》情节起伏跌宕，寺警、酬韵、",
    "start": 607.248,
    "end": 610.928,
    "duration": 3.68
  },
  {
    "id": 133,
    "text": "赖婚、琴挑、闹简、佳期、长亭送别环环相扣，",
    "start": 610.928,
    "end": 615.728,
    "duration": 4.8
  },
  {
    "id": 134,
    "text": "悬念丛生且节奏紧凑。",
    "start": 615.728,
    "end": 617.728,
    "duration": 2.0
  },
  {
    "id": 135,
    "text": "在语言美学上，明代谢榛评其“如花间美人”，",
    "start": 618.128,
    "end": 622.528,
    "duration": 4.4
  },
  {
    "id": 136,
    "text": "剧作完全摆脱了元曲早期粗豪俚俗的习气，",
    "start": 622.528,
    "end": 626.288,
    "duration": 3.76
  },
  {
    "id": 137,
    "text": "将古典诗词的清词丽句完美融入通俗戏曲。",
    "start": 626.288,
    "end": 630.368,
    "duration": 4.08
  },
  {
    "id": 138,
    "text": "比如第四本第三折《长亭送别》中，",
    "start": 630.368,
    "end": 633.248,
    "duration": 2.88
  },
  {
    "id": 139,
    "text": "“碧云天，黄花地，西风紧，北雁南飞。",
    "start": 633.248,
    "end": 637.088,
    "duration": 3.84
  },
  {
    "id": 140,
    "text": "晓来谁染霜林醉？",
    "start": 637.088,
    "end": 639.088,
    "duration": 2.0
  },
  {
    "id": 141,
    "text": "总是离人泪”，不仅化用范仲淹诗词意境，",
    "start": 639.168,
    "end": 642.608,
    "duration": 3.44
  },
  {
    "id": 142,
    "text": "更将满目秋景与主人公肝肠寸断的离别深情融铸一炉，",
    "start": 642.608,
    "end": 647.488,
    "duration": 4.88
  },
  {
    "id": 143,
    "text": "达到了意象幽美与情感沉痛的高度统一，",
    "start": 647.488,
    "end": 650.848,
    "duration": 3.36
  },
  {
    "id": 144,
    "text": "成为中国抒情戏剧曲词的千古绝唱。",
    "start": 650.848,
    "end": 653.648,
    "duration": 2.8
  },
  {
    "id": 145,
    "text": "五、结尾收束升华段内部咬合。",
    "start": 653.648,
    "end": 656.368,
    "duration": 2.72
  },
  {
    "id": 146,
    "text": "本段承担全篇论证成果的系统提炼与历史定位，",
    "start": 656.368,
    "end": 660.368,
    "duration": 4.0
  },
  {
    "id": 147,
    "text": "完成宏观历史论证闭环。",
    "start": 660.368,
    "end": 662.208,
    "duration": 1.84
  },
  {
    "id": 148,
    "text": "-首先，全面回收思想、人物与曲词三大成就，",
    "start": 662.448,
    "end": 666.015,
    "duration": 3.567
  },
  {
    "id": 149,
    "text": "具体表述到答题语句就是：综上所述，",
    "start": 666.015,
    "end": 669.162,
    "duration": 3.147
  },
  {
    "id": 150,
    "text": "王实甫《西厢记》以反封建礼教的深刻思想震撼了封建伦理根基，",
    "start": 669.162,
    "end": 674.617,
    "duration": 5.455
  },
  {
    "id": 151,
    "text": "以精微入微的心理开掘重构了中国戏剧人物塑造的高度，",
    "start": 674.617,
    "end": 679.653,
    "duration": 5.036
  },
  {
    "id": 152,
    "text": "以典雅华艳的诗化曲词奠定了元杂剧文人化的巅峰品格。",
    "start": 679.653,
    "end": 684.688,
    "duration": 5.035
  },
  {
    "id": 153,
    "text": "-紧接着，总结其深远的人性与美学价值，",
    "start": 684.744,
    "end": 687.963,
    "duration": 3.219
  },
  {
    "id": 154,
    "text": "具体表述到答题语句就是：它在文学史与戏剧史上长久滋养着中国人的精神世界，",
    "start": 687.963,
    "end": 694.802,
    "duration": 6.839
  },
  {
    "id": 155,
    "text": "具有永恒的审美生命力。",
    "start": 694.802,
    "end": 696.814,
    "duration": 2.012
  },
  {
    "id": 156,
    "text": "综上所述，王实甫《西厢记》以反封建礼教的深刻思想震撼了封建伦理根基，",
    "start": 696.814,
    "end": 702.848,
    "duration": 6.034
  },
  {
    "id": 157,
    "text": "以精微入微的心理开掘重构了中国戏剧人物塑造的高度，",
    "start": 702.848,
    "end": 707.676,
    "duration": 4.828
  },
  {
    "id": 158,
    "text": "以典雅华艳的诗化曲词奠定了元杂剧文人化的巅峰品格。",
    "start": 707.676,
    "end": 712.504,
    "duration": 4.828
  },
  {
    "id": 159,
    "text": "它在文学史与戏剧史上长久滋养着中国人的精神世界，",
    "start": 712.584,
    "end": 717.384,
    "duration": 4.8
  },
  {
    "id": 160,
    "text": "具有永恒的审美生命力。",
    "start": 717.384,
    "end": 719.064,
    "duration": 1.68
  }
]