[
  {
    "id": 1,
    "text": "全局宏观破题与立论逻辑。",
    "start": 0.16,
    "end": 2.48,
    "duration": 2.32
  },
  {
    "id": 2,
    "text": "在考场下笔之前，必须先在宏观上审清这道三十分大题的核心考核意图。",
    "start": 2.48,
    "end": 8.48,
    "duration": 6.0
  },
  {
    "id": 3,
    "text": "本题表面上考查诗经的艺术成就与手法，",
    "start": 8.48,
    "end": 11.52,
    "duration": 3.04
  },
  {
    "id": 4,
    "text": "本质上考查中国古典现实主义诗歌源头的建构过程。",
    "start": 11.52,
    "end": 15.6,
    "duration": 4.08
  },
  {
    "id": 5,
    "text": "考场评分标准绝不满足于仅列举几条孤立的名词概念。",
    "start": 15.6,
    "end": 19.76,
    "duration": 4.16
  },
  {
    "id": 6,
    "text": "答题方向必须确立为“从思想情感的求真写实，",
    "start": 20.0,
    "end": 24.32,
    "duration": 4.32
  },
  {
    "id": 7,
    "text": "推进到核心表现手法赋比兴，再下沉至体制声律技术，",
    "start": 24.32,
    "end": 29.92,
    "duration": 5.6
  },
  {
    "id": 8,
    "text": "最终升华至文化美学范式”的因果推进。",
    "start": 29.92,
    "end": 33.04,
    "duration": 3.12
  },
  {
    "id": 9,
    "text": "整道大题在宏观上划分为五个有机递进的逻辑层次：第一层，",
    "start": 33.04,
    "end": 38.08,
    "duration": 5.04
  },
  {
    "id": 10,
    "text": "开篇破题，交代《诗经》的源头地位、",
    "start": 38.08,
    "end": 41.2,
    "duration": 3.12
  },
  {
    "id": 11,
    "text": "现实主义定性与抒情传统开创。",
    "start": 41.2,
    "end": 43.68,
    "duration": 2.48
  },
  {
    "id": 12,
    "text": "第二层，论述思想内容的真实广阔，",
    "start": 44.0,
    "end": 47.28,
    "duration": 3.28
  },
  {
    "id": 13,
    "text": "说明诗经如何打破神话虚妄，确立直面人生的写实精神。",
    "start": 47.28,
    "end": 52.48,
    "duration": 5.2
  },
  {
    "id": 14,
    "text": "第三层，深剖赋比兴的核心技法，从朱熹的学术定义剖析到文本中的综合互融。",
    "start": 52.48,
    "end": 59.84,
    "duration": 7.36
  },
  {
    "id": 15,
    "text": "第四层，落地至体裁与形式，说明四言为主、",
    "start": 59.84,
    "end": 64.4,
    "duration": 4.56
  },
  {
    "id": 16,
    "text": "重章叠句与叠字声律如何支撑音乐之美。",
    "start": 64.4,
    "end": 67.76,
    "duration": 3.36
  },
  {
    "id": 17,
    "text": "第五层，升华为文化品格，阐释“思无邪”与“中和之美”的抒情克制传统。",
    "start": 68.0,
    "end": 74.16,
    "duration": 6.16
  },
  {
    "id": 18,
    "text": "尾部收官，将结论放回文学史谱系，",
    "start": 74.16,
    "end": 77.2,
    "duration": 3.04
  },
  {
    "id": 19,
    "text": "交代其对汉乐府、建安风骨与杜甫现实主义的滋养。",
    "start": 77.2,
    "end": 81.44,
    "duration": 4.24
  },
  {
    "id": 20,
    "text": "这五个层次构成一条不可逆的因果链条：写实精神是灵魂，",
    "start": 81.44,
    "end": 86.08,
    "duration": 4.64
  },
  {
    "id": 21,
    "text": "赋比兴是手段，体制声韵是载体，中和之美是境界，",
    "start": 86.08,
    "end": 90.64,
    "duration": 4.56
  },
  {
    "id": 22,
    "text": "史学流变是最终定型。",
    "start": 90.64,
    "end": 92.32,
    "duration": 1.68
  },
  {
    "id": 23,
    "text": "理顺了宏观全局思路，接下来进入每一段的具体推导与逐句表述。",
    "start": 92.64,
    "end": 98.16,
    "duration": 5.52
  },
  {
    "id": 24,
    "text": "第一段：首段破题与概念定性。",
    "start": 98.16,
    "end": 101.2,
    "duration": 3.04
  },
  {
    "id": 25,
    "text": "逐句因果推导与答题表述。",
    "start": 101.2,
    "end": 103.68,
    "duration": 2.48
  },
  {
    "id": 26,
    "text": "首句必须直击核心概念，绝不绕弯。",
    "start": 103.68,
    "end": 106.48,
    "duration": 2.8
  },
  {
    "id": 27,
    "text": "所以表述为：次句紧承首句说明其划时代的历史地位，",
    "start": 106.48,
    "end": 111.12,
    "duration": 4.64
  },
  {
    "id": 28,
    "text": "标志着古典诗歌走向自觉成熟。",
    "start": 111.12,
    "end": 113.52,
    "duration": 2.4
  },
  {
    "id": 29,
    "text": "所以表述为：第三句必须引入权威教材定论，",
    "start": 114.0,
    "end": 117.9,
    "duration": 3.9
  },
  {
    "id": 30,
    "text": "确立其现实主义传统的母体地位。",
    "start": 117.9,
    "end": 120.98,
    "duration": 3.08
  },
  {
    "id": 31,
    "text": "所以表述为：第四句进一步阐明其美学贡献，",
    "start": 120.98,
    "end": 124.94,
    "duration": 3.96
  },
  {
    "id": 32,
    "text": "说明它奠定了以抒情为主导的美学风范。",
    "start": 124.94,
    "end": 128.68,
    "duration": 3.74
  },
  {
    "id": 33,
    "text": "所以表述为：第五句顺理成章作为首段过渡句，",
    "start": 128.68,
    "end": 132.86,
    "duration": 4.18
  },
  {
    "id": 34,
    "text": "宣告下文将从四个核心维度展开系统论述。",
    "start": 132.86,
    "end": 136.82,
    "duration": 3.96
  },
  {
    "id": 35,
    "text": "所以表述为：本段答题思路总结。",
    "start": 136.82,
    "end": 139.68,
    "duration": 2.86
  },
  {
    "id": 36,
    "text": "本段用五句话完成立论闭环：先直接亮出文学史第一部诗歌总集的崇高坐标，",
    "start": 139.808,
    "end": 147.008,
    "duration": 7.2
  },
  {
    "id": 37,
    "text": "再点明其由原始歌谣向自觉抒情诗飞跃的性质；",
    "start": 147.008,
    "end": 151.488,
    "duration": 4.48
  },
  {
    "id": 38,
    "text": "随即以袁行配教材锚定其现实主义与抒情传统两大母体特征；",
    "start": 151.488,
    "end": 157.488,
    "duration": 6.0
  },
  {
    "id": 39,
    "text": "最后自然转入四个维度的展开，开篇严谨规范。",
    "start": 157.488,
    "end": 161.488,
    "duration": 4.0
  },
  {
    "id": 40,
    "text": "所以本段具体答题完整版为：第二段：第一分论点，",
    "start": 161.888,
    "end": 165.769,
    "duration": 3.881
  },
  {
    "id": 41,
    "text": "抒情机制与精神内核（意之“真”）。",
    "start": 165.769,
    "end": 168.35,
    "duration": 2.581
  },
  {
    "id": 42,
    "text": "逐句因果推导与答题表述。",
    "start": 168.35,
    "end": 170.716,
    "duration": 2.366
  },
  {
    "id": 43,
    "text": "首段确立了内容决定形式的原则，第二段必须首先解决《诗经》的写实精神与情感源泉。",
    "start": 170.716,
    "end": 178.245,
    "duration": 7.529
  },
  {
    "id": 44,
    "text": "首句立论，指出诗经打破了神话巫术的虚妄，",
    "start": 178.245,
    "end": 182.117,
    "duration": 3.872
  },
  {
    "id": 45,
    "text": "直面客观人生。",
    "start": 182.117,
    "end": 183.408,
    "duration": 1.291
  },
  {
    "id": 46,
    "text": "所以表述为：次句调取古代文论最核心的经典名言，",
    "start": 183.568,
    "end": 187.849,
    "duration": 4.281
  },
  {
    "id": 47,
    "text": "作为写实精神的文献定论。",
    "start": 187.849,
    "end": 190.116,
    "duration": 2.267
  },
  {
    "id": 48,
    "text": "所以表述为：第三句紧承名言推导因果，",
    "start": 190.116,
    "end": 193.413,
    "duration": 3.297
  },
  {
    "id": 49,
    "text": "说明诗作全面覆盖了周代世俗生活的方方面面。",
    "start": 193.413,
    "end": 197.534,
    "duration": 4.121
  },
  {
    "id": 50,
    "text": "所以表述为：第四句引入批判剥削的代表作，",
    "start": 197.534,
    "end": 201.243,
    "duration": 3.709
  },
  {
    "id": 51,
    "text": "调取愤怒质问统治者的千古名句。",
    "start": 201.243,
    "end": 204.128,
    "duration": 2.885
  },
  {
    "id": 52,
    "text": "所以表述为：第五句引入表现男女情爱的代表篇目，",
    "start": 204.288,
    "end": 209.019,
    "duration": 4.731
  },
  {
    "id": 53,
    "text": "调取家喻户晓的开篇名句。",
    "start": 209.019,
    "end": 211.534,
    "duration": 2.515
  },
  {
    "id": 54,
    "text": "所以表述为：第六句对文本情感进行美学定型，",
    "start": 211.534,
    "end": 215.877,
    "duration": 4.343
  },
  {
    "id": 55,
    "text": "指出其纯真坦诚、拒绝空洞教条。",
    "start": 215.877,
    "end": 218.848,
    "duration": 2.971
  },
  {
    "id": 56,
    "text": "所以表述为：第七句收束全段，指出直面民生与真情铸就了诗经深沉厚重的思想底色。",
    "start": 218.848,
    "end": 226.848,
    "duration": 8.0
  },
  {
    "id": 57,
    "text": "所以表述为：本段答题思路总结。",
    "start": 227.008,
    "end": 230.288,
    "duration": 3.28
  },
  {
    "id": 58,
    "text": "本段从思想精神层面建立论据支撑：先以何休“饥者歌其食”确立现实主义写实原则；",
    "start": 230.288,
    "end": 238.448,
    "duration": 8.16
  },
  {
    "id": 59,
    "text": "随后通过《伐檀》对不劳而获的尖锐质问，",
    "start": 238.448,
    "end": 241.968,
    "duration": 3.52
  },
  {
    "id": 60,
    "text": "以及《关雎》对纯朴爱情的真实描摹；",
    "start": 241.968,
    "end": 244.848,
    "duration": 2.88
  },
  {
    "id": 61,
    "text": "证明诗经摆脱了虚妄神学与浮夸辞藻，",
    "start": 244.848,
    "end": 248.688,
    "duration": 3.84
  },
  {
    "id": 62,
    "text": "牢牢扎根于世俗民生与真实人性，奠定了现实主义的基石。",
    "start": 248.688,
    "end": 253.488,
    "duration": 4.8
  },
  {
    "id": 63,
    "text": "所以本段具体答题完整版为：第三段：第二分论点，",
    "start": 253.888,
    "end": 257.808,
    "duration": 3.92
  },
  {
    "id": 64,
    "text": "表现手法的成熟体系（法之“巧”）。",
    "start": 257.808,
    "end": 260.528,
    "duration": 2.72
  },
  {
    "id": 65,
    "text": "逐句因果推导与答题表述。",
    "start": 260.528,
    "end": 262.928,
    "duration": 2.4
  },
  {
    "id": 66,
    "text": "第二段讲透了真实感情的源头，第三段必须正面攻克题干核心要求，",
    "start": 262.928,
    "end": 268.368,
    "duration": 5.44
  },
  {
    "id": 67,
    "text": "也就是赋比兴手法。",
    "start": 268.368,
    "end": 270.048,
    "duration": 1.68
  },
  {
    "id": 68,
    "text": "首句确立分论点，指出赋比兴是诗经最具代表性的表现体系。",
    "start": 270.048,
    "end": 274.608,
    "duration": 4.56
  },
  {
    "id": 69,
    "text": "所以表述为：次句搬出中国文论史最具权威性的界定者朱熹。",
    "start": 274.848,
    "end": 280.042,
    "duration": 5.194
  },
  {
    "id": 70,
    "text": "所以表述为：第三句交代“赋”的标准定义与功能机制。",
    "start": 280.042,
    "end": 284.406,
    "duration": 4.364
  },
  {
    "id": 71,
    "text": "所以表述为：第四句交代“比”的标准定义与功能机制。",
    "start": 284.406,
    "end": 288.769,
    "duration": 4.363
  },
  {
    "id": 72,
    "text": "所以表述为：第五句交代“兴”的标准定义与功能机制。",
    "start": 288.769,
    "end": 293.232,
    "duration": 4.463
  },
  {
    "id": 73,
    "text": "所以表述为：第六句提出高级论述视角，",
    "start": 293.232,
    "end": 296.272,
    "duration": 3.04
  },
  {
    "id": 74,
    "text": "指出创作中三者绝非割裂，而是综合交织。",
    "start": 296.272,
    "end": 299.792,
    "duration": 3.52
  },
  {
    "id": 75,
    "text": "所以表述为：第七句引入长篇叙事抒情名作《卫风•氓》，",
    "start": 299.792,
    "end": 304.432,
    "duration": 4.64
  },
  {
    "id": 76,
    "text": "分析其借桑树变迁喻示命运的精妙手法。",
    "start": 304.432,
    "end": 307.632,
    "duration": 3.2
  },
  {
    "id": 77,
    "text": "所以表述为：第八句对该文本进行技法定型，",
    "start": 307.952,
    "end": 312.053,
    "duration": 4.101
  },
  {
    "id": 78,
    "text": "剖析其将赋的叙事、比的喻意与兴的触物完美结合。",
    "start": 312.053,
    "end": 316.921,
    "duration": 4.868
  },
  {
    "id": 79,
    "text": "所以表述为：第九句得出总结，指出赋比兴极大拓展了中国诗歌情景交融的意象塑造能力。",
    "start": 316.921,
    "end": 325.498,
    "duration": 8.577
  },
  {
    "id": 80,
    "text": "所以表述为：本段答题思路总结。",
    "start": 325.498,
    "end": 328.512,
    "duration": 3.014
  },
  {
    "id": 81,
    "text": "本段聚焦于最具技术含量的表现手法：先完整背出朱熹《诗集传》对赋、",
    "start": 328.592,
    "end": 334.512,
    "duration": 5.92
  },
  {
    "id": 82,
    "text": "比、兴的三位一体权威定义；",
    "start": 334.512,
    "end": 336.672,
    "duration": 2.16
  },
  {
    "id": 83,
    "text": "紧接着跳出孤立解释概念的低幼答法，",
    "start": 336.672,
    "end": 339.792,
    "duration": 3.12
  },
  {
    "id": 84,
    "text": "以《氓》中桑树叶沃到叶落的经典隐喻为例，",
    "start": 339.792,
    "end": 343.072,
    "duration": 3.28
  },
  {
    "id": 85,
    "text": "深度剖析赋比兴综合一体的艺术机制，",
    "start": 343.072,
    "end": 346.352,
    "duration": 3.28
  },
  {
    "id": 86,
    "text": "证明其开辟了中国古典诗歌比德观念与情景交融的千古法门。",
    "start": 346.352,
    "end": 351.472,
    "duration": 5.12
  },
  {
    "id": 87,
    "text": "所以本段具体答题完整版为：第四段：第三分论点，",
    "start": 351.792,
    "end": 356.112,
    "duration": 4.32
  },
  {
    "id": 88,
    "text": "体制章法与声律建构（体之“美”）。",
    "start": 356.112,
    "end": 359.232,
    "duration": 3.12
  },
  {
    "id": 89,
    "text": "逐句因果推导与答题表述。",
    "start": 359.232,
    "end": 361.872,
    "duration": 2.64
  },
  {
    "id": 90,
    "text": "前两段解决了情与法，第四段必须进一步下沉到诗歌的语言体制与声律建构。",
    "start": 361.872,
    "end": 368.992,
    "duration": 7.12
  },
  {
    "id": 91,
    "text": "首句确立分论点，指出诗经在体式与音乐体制上确立了早期诗歌规范。",
    "start": 368.992,
    "end": 374.992,
    "duration": 6.0
  },
  {
    "id": 92,
    "text": "所以表述为：次句锁定核心句式，指明其以四言为主干并结合杂言。",
    "start": 375.312,
    "end": 381.162,
    "duration": 5.85
  },
  {
    "id": 93,
    "text": "所以表述为：第三句点出极具代表性的章法结构，",
    "start": 381.162,
    "end": 385.539,
    "duration": 4.377
  },
  {
    "id": 94,
    "text": "即重章叠句的复沓形式。",
    "start": 385.539,
    "end": 387.728,
    "duration": 2.189
  },
  {
    "id": 95,
    "text": "所以表述为：第四句分析重章叠句的音乐与情感机制，",
    "start": 387.728,
    "end": 392.542,
    "duration": 4.814
  },
  {
    "id": 96,
    "text": "字句微换而情感深化。",
    "start": 392.542,
    "end": 394.512,
    "duration": 1.97
  },
  {
    "id": 97,
    "text": "所以表述为：第五句调取代表篇目《周南•福以》，",
    "start": 394.672,
    "end": 398.705,
    "duration": 4.033
  },
  {
    "id": 98,
    "text": "剖析动词替换生动再现劳动的欢快节奏。",
    "start": 398.705,
    "end": 402.578,
    "duration": 3.873
  },
  {
    "id": 99,
    "text": "所以表述为：第六句由章法转入语言声律，",
    "start": 402.578,
    "end": 406.451,
    "duration": 3.873
  },
  {
    "id": 100,
    "text": "点出双声叠韵与叠字摹状的大量运用。",
    "start": 406.451,
    "end": 410.096,
    "duration": 3.645
  },
  {
    "id": 101,
    "text": "所以表述为：第七句调取千古写景抒情绝唱《小雅•采薇》的名句。",
    "start": 410.096,
    "end": 415.792,
    "duration": 5.696
  },
  {
    "id": 102,
    "text": "所以表述为：第八句展开微观语言分析，",
    "start": 415.952,
    "end": 419.327,
    "duration": 3.375
  },
  {
    "id": 103,
    "text": "解释“依依”与“霏霏”的音义结合之妙。",
    "start": 419.327,
    "end": 422.114,
    "duration": 2.787
  },
  {
    "id": 104,
    "text": "所以表述为：第九句总结收束全段，",
    "start": 422.114,
    "end": 425.115,
    "duration": 3.001
  },
  {
    "id": 105,
    "text": "指出这些语言特点赋予了诗经极强的音乐性与表现力。",
    "start": 425.115,
    "end": 430.045,
    "duration": 4.93
  },
  {
    "id": 106,
    "text": "所以表述为：本段答题思路总结。",
    "start": 430.045,
    "end": 432.832,
    "duration": 2.787
  },
  {
    "id": 107,
    "text": "本段展示了考生的形式美学功底：从四言为主的体制切入，",
    "start": 432.968,
    "end": 437.928,
    "duration": 4.96
  },
  {
    "id": 108,
    "text": "以《福以》为例剖析重章叠句回环往复的民歌复沓机制；",
    "start": 437.928,
    "end": 442.728,
    "duration": 4.8
  },
  {
    "id": 109,
    "text": "随即转向声律词汇，以《采薇》依依与霏霏的千古叠字为例，",
    "start": 442.728,
    "end": 448.088,
    "duration": 5.36
  },
  {
    "id": 110,
    "text": "论证双声叠韵与摹状词对意境营构的支撑，",
    "start": 448.088,
    "end": 452.088,
    "duration": 4.0
  },
  {
    "id": 111,
    "text": "展现出古典诗歌早期形式美与音乐美的成熟。",
    "start": 452.088,
    "end": 455.768,
    "duration": 3.68
  },
  {
    "id": 112,
    "text": "所以本段具体答题完整版为：第五段：第四分论点，",
    "start": 456.168,
    "end": 460.328,
    "duration": 4.16
  },
  {
    "id": 113,
    "text": "文化品格与审美范式（境之“和”）。",
    "start": 460.328,
    "end": 463.288,
    "duration": 2.96
  },
  {
    "id": 114,
    "text": "逐句因果推导与答题表述。",
    "start": 463.288,
    "end": 465.688,
    "duration": 2.4
  },
  {
    "id": 115,
    "text": "在解决了情、法、体之后，本段必须把诗经提升到儒家诗教与中国美学范式的高度。",
    "start": 465.688,
    "end": 473.288,
    "duration": 7.6
  },
  {
    "id": 116,
    "text": "首句确立分论点，指出诗经体现了先秦礼乐文明推崇的中和之美。",
    "start": 473.288,
    "end": 478.968,
    "duration": 5.68
  },
  {
    "id": 117,
    "text": "所以表述为：次句搬出儒家宗师孔子的经典总评，",
    "start": 479.288,
    "end": 483.566,
    "duration": 4.278
  },
  {
    "id": 118,
    "text": "作为思想精神的核心定语。",
    "start": 483.566,
    "end": 485.997,
    "duration": 2.431
  },
  {
    "id": 119,
    "text": "所以表述为：第三句深入阐释“思无邪”，",
    "start": 485.997,
    "end": 489.311,
    "duration": 3.314
  },
  {
    "id": 120,
    "text": "说明热烈真挚的情感始终受到理性节制。",
    "start": 489.311,
    "end": 493.067,
    "duration": 3.756
  },
  {
    "id": 121,
    "text": "所以表述为：第四句引入汉代《毛诗序》的经典诗教阐发。",
    "start": 493.067,
    "end": 497.928,
    "duration": 4.861
  },
  {
    "id": 122,
    "text": "所以表述为：第五句紧扣抒情机制，",
    "start": 498.088,
    "end": 501.234,
    "duration": 3.146
  },
  {
    "id": 123,
    "text": "指出怨刺诗篇也表现为怨而不怒的抒情克制。",
    "start": 501.234,
    "end": 505.598,
    "duration": 4.364
  },
  {
    "id": 124,
    "text": "所以表述为：第六句得出美学总结，",
    "start": 505.598,
    "end": 508.813,
    "duration": 3.215
  },
  {
    "id": 125,
    "text": "指出这种哀而不伤的范式奠定了民族的典雅诗学品格。",
    "start": 508.813,
    "end": 514.096,
    "duration": 5.283
  },
  {
    "id": 126,
    "text": "所以表述为：本段答题思路总结。",
    "start": 514.096,
    "end": 517.082,
    "duration": 2.986
  },
  {
    "id": 127,
    "text": "本段将文本分析上升为文化与诗教哲学的审视：以孔子“思无邪”和《毛诗序》“发乎情，",
    "start": 517.082,
    "end": 524.661,
    "duration": 7.579
  },
  {
    "id": 128,
    "text": "止乎礼义”为核心支柱；",
    "start": 524.661,
    "end": 526.728,
    "duration": 2.067
  },
  {
    "id": 129,
    "text": "深度阐发抒情自由与理性秩序之间的平衡统一；",
    "start": 526.888,
    "end": 530.808,
    "duration": 3.92
  },
  {
    "id": 130,
    "text": "证明诗经既非虚伪寡淡的礼教说教，",
    "start": 530.808,
    "end": 533.688,
    "duration": 2.88
  },
  {
    "id": 131,
    "text": "也非失控狂躁的情感宣泄，从而确立了中华文明“乐而不淫，",
    "start": 533.688,
    "end": 538.568,
    "duration": 4.88
  },
  {
    "id": 132,
    "text": "哀而不伤”的崇高中和典范。",
    "start": 538.568,
    "end": 540.888,
    "duration": 2.32
  },
  {
    "id": 133,
    "text": "所以本段具体答题完整版为：第六段：尾段收官与文学史谱系闭环。",
    "start": 540.888,
    "end": 546.008,
    "duration": 5.12
  },
  {
    "id": 134,
    "text": "逐句因果推导与答题表述。",
    "start": 546.328,
    "end": 548.648,
    "duration": 2.32
  },
  {
    "id": 135,
    "text": "尾段作为三十分大题的收官，必须将诗经放回三千年古典文学长河中进行历史定位。",
    "start": 548.648,
    "end": 555.288,
    "duration": 6.64
  },
  {
    "id": 136,
    "text": "首句综合前文四个维度，定评其为中国诗歌现实主义传统的源头活水。",
    "start": 555.288,
    "end": 561.288,
    "duration": 6.0
  },
  {
    "id": 137,
    "text": "所以表述为：次句概括其在技法、体裁与抒情机制上的开拓，",
    "start": 561.288,
    "end": 566.648,
    "duration": 5.36
  },
  {
    "id": 138,
    "text": "对后代产生了不可估量的深远影响。",
    "start": 566.648,
    "end": 569.048,
    "duration": 2.4
  },
  {
    "id": 139,
    "text": "所以表述为：第三句向汉魏与唐代顺流推进，",
    "start": 569.448,
    "end": 573.356,
    "duration": 3.908
  },
  {
    "id": 140,
    "text": "点明其对汉乐府民歌与建安风骨的直接启迪。",
    "start": 573.356,
    "end": 577.546,
    "duration": 4.19
  },
  {
    "id": 141,
    "text": "所以表述为：第四句落脚于唐代现实主义最高峰，",
    "start": 577.546,
    "end": 581.912,
    "duration": 4.366
  },
  {
    "id": 142,
    "text": "指出它是杜甫诗史与白居易新乐府运动的母体源头。",
    "start": 581.912,
    "end": 586.712,
    "duration": 4.8
  },
  {
    "id": 143,
    "text": "所以表述为：本段答题思路总结。",
    "start": 586.712,
    "end": 589.592,
    "duration": 2.88
  },
  {
    "id": 144,
    "text": "本段干净利落地完成文学史谱系收口：先用两句话总结其现实主义源头的不可动摇地位；",
    "start": 589.592,
    "end": 596.552,
    "duration": 6.96
  },
  {
    "id": 145,
    "text": "随后纵向贯通中国文学史，清晰点出由《诗经》出发，",
    "start": 596.552,
    "end": 600.872,
    "duration": 4.32
  },
  {
    "id": 146,
    "text": "历经两汉乐府、建安风骨，最终在唐代杜甫诗史与白居易新乐府运动中开花结果的演变脉络，",
    "start": 600.872,
    "end": 608.952,
    "duration": 8.08
  },
  {
    "id": 147,
    "text": "使全篇答卷在宏阔的历史视野中完美闭环。",
    "start": 608.952,
    "end": 612.152,
    "duration": 3.2
  },
  {
    "id": 148,
    "text": "所以本段具体答题完整版为：整道大题的内在逻辑链总括。",
    "start": 612.552,
    "end": 617.432,
    "duration": 4.88
  },
  {
    "id": 149,
    "text": "这道三十分大题的本质，是一场极度严密的逻辑推演。",
    "start": 617.432,
    "end": 621.752,
    "duration": 4.32
  },
  {
    "id": 150,
    "text": "整篇答卷从头到尾遵循着“由概念定评、",
    "start": 621.752,
    "end": 625.512,
    "duration": 3.76
  },
  {
    "id": 151,
    "text": "到真纯情志、到赋比兴手法、到四言声律、",
    "start": 625.512,
    "end": 629.352,
    "duration": 3.84
  },
  {
    "id": 152,
    "text": "到中和品格、最终回归文学史承续”的必然法则。",
    "start": 629.352,
    "end": 633.032,
    "duration": 3.68
  },
  {
    "id": 153,
    "text": "阅卷老师看到的绝不是散乱的答题点，",
    "start": 633.352,
    "end": 636.312,
    "duration": 2.96
  },
  {
    "id": 154,
    "text": "而是一条咬合紧密的因果长链：第一步是“立论定性”，",
    "start": 636.312,
    "end": 641.032,
    "duration": 4.72
  },
  {
    "id": 155,
    "text": "开门见山解决《诗经》的源头地位，",
    "start": 641.032,
    "end": 643.752,
    "duration": 2.72
  },
  {
    "id": 156,
    "text": "确立现实主义与抒情传统双重标杆。",
    "start": 643.752,
    "end": 646.952,
    "duration": 3.2
  },
  {
    "id": 157,
    "text": "第二步是“真纯情志”，以何休“饥者歌其食”及《伐檀》 《关雎》证明其直面人生的写实精神。",
    "start": 646.952,
    "end": 655.432,
    "duration": 8.48
  },
  {
    "id": 158,
    "text": "第三步是“赋比兴体系”，以朱熹经典三定义与《卫风•氓》的桑树意象，",
    "start": 655.672,
    "end": 661.672,
    "duration": 6.0
  },
  {
    "id": 159,
    "text": "剖析情景交融的表现技艺。",
    "start": 661.672,
    "end": 663.912,
    "duration": 2.24
  },
  {
    "id": 160,
    "text": "第四步是“体制声律”，以四言为主、",
    "start": 663.912,
    "end": 666.792,
    "duration": 2.88
  },
  {
    "id": 161,
    "text": "重章叠句与《采薇》叠字，证明早期诗歌成熟的音乐旋律美。",
    "start": 666.792,
    "end": 671.992,
    "duration": 5.2
  },
  {
    "id": 162,
    "text": "第五步是“中和范式”，以“思无邪”与“发乎情止乎礼义”，",
    "start": 671.992,
    "end": 676.632,
    "duration": 4.64
  },
  {
    "id": 163,
    "text": "阐明理性节制与哀而不伤的崇高文化品格。",
    "start": 676.632,
    "end": 680.072,
    "duration": 3.44
  },
  {
    "id": 164,
    "text": "第六步是“史学闭环”，把《诗经》的风雅精神自然延伸至汉乐府、",
    "start": 680.392,
    "end": 686.072,
    "duration": 5.68
  },
  {
    "id": 165,
    "text": "建安骨力与杜甫、白居易的现实主义巨流。",
    "start": 686.072,
    "end": 689.672,
    "duration": 3.6
  },
  {
    "id": 166,
    "text": "这六步层层递进，前一步的结论必然成为后一步的前提。",
    "start": 689.672,
    "end": 694.312,
    "duration": 4.64
  },
  {
    "id": 167,
    "text": "你在考场上顺着因果关系顺流而下，",
    "start": 694.312,
    "end": 697.272,
    "duration": 2.96
  },
  {
    "id": 168,
    "text": "就能自然写出近千字的满分答卷。",
    "start": 697.272,
    "end": 700.392,
    "duration": 3.12
  }
]