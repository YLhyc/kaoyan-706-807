[
  {
    "id": 1,
    "text": "全局宏观破题与立论逻辑。",
    "start": 0.16,
    "end": 2.48,
    "duration": 2.32
  },
  {
    "id": 2,
    "text": "在考场下笔之前，必须先在宏观上审清这道三十分大题的核心考核意图。",
    "start": 2.48,
    "end": 8.48,
    "duration": 6.0
  },
  {
    "id": 3,
    "text": "本题表面上考查诗经的艺术成就与手法，",
    "start": 8.48,
    "end": 11.52,
    "duration": 3.04
  },
  {
    "id": 4,
    "text": "本质上考查中国古典现实主义诗歌源头的建构过程。",
    "start": 11.52,
    "end": 15.6,
    "duration": 4.08
  },
  {
    "id": 5,
    "text": "考场评分标准绝不满足于仅列举几条孤立的名词概念。",
    "start": 15.6,
    "end": 19.76,
    "duration": 4.16
  },
  {
    "id": 6,
    "text": "答题方向必须确立为“从思想情感的求真写实，",
    "start": 20.0,
    "end": 24.32,
    "duration": 4.32
  },
  {
    "id": 7,
    "text": "推进到核心表现手法赋比兴，再下沉至体制声律技术，",
    "start": 24.32,
    "end": 29.92,
    "duration": 5.6
  },
  {
    "id": 8,
    "text": "最终升华至文化美学范式”的因果推进。",
    "start": 29.92,
    "end": 33.04,
    "duration": 3.12
  },
  {
    "id": 9,
    "text": "整道大题在宏观上划分为五个有机递进的逻辑层次：第一层，",
    "start": 33.04,
    "end": 38.08,
    "duration": 5.04
  },
  {
    "id": 10,
    "text": "开篇破题，交代《诗经》的源头地位、",
    "start": 38.08,
    "end": 41.2,
    "duration": 3.12
  },
  {
    "id": 11,
    "text": "现实主义定性与抒情传统开创。",
    "start": 41.2,
    "end": 43.68,
    "duration": 2.48
  },
  {
    "id": 12,
    "text": "第二层，论述思想内容的真实广阔，",
    "start": 44.0,
    "end": 47.28,
    "duration": 3.28
  },
  {
    "id": 13,
    "text": "说明诗经如何打破神话虚妄，确立直面人生的写实精神。",
    "start": 47.28,
    "end": 52.48,
    "duration": 5.2
  },
  {
    "id": 14,
    "text": "第三层，深剖赋比兴的核心技法，从朱熹的学术定义剖析到文本中的综合互融。",
    "start": 52.48,
    "end": 59.68,
    "duration": 7.2
  },
  {
    "id": 15,
    "text": "第四层，落地至体裁与形式，说明四言为主、",
    "start": 59.68,
    "end": 63.84,
    "duration": 4.16
  },
  {
    "id": 16,
    "text": "重章叠句与叠字声律如何支撑音乐之美。",
    "start": 63.84,
    "end": 67.6,
    "duration": 3.76
  },
  {
    "id": 17,
    "text": "第五层，升华为文化品格，阐释“思无邪”与“中和之美”的抒情克制传统。",
    "start": 67.76,
    "end": 73.92,
    "duration": 6.16
  },
  {
    "id": 18,
    "text": "尾部收官，将结论放回文学史谱系，",
    "start": 73.92,
    "end": 76.96,
    "duration": 3.04
  },
  {
    "id": 19,
    "text": "交代其对汉乐府、建安风骨与杜甫现实主义的滋养。",
    "start": 76.96,
    "end": 81.2,
    "duration": 4.24
  },
  {
    "id": 20,
    "text": "这五个层次构成一条不可逆的因果链条：写实精神是灵魂，",
    "start": 81.2,
    "end": 85.84,
    "duration": 4.64
  },
  {
    "id": 21,
    "text": "赋比兴是手段，体制声韵是载体，中和之美是境界，",
    "start": 85.84,
    "end": 90.4,
    "duration": 4.56
  },
  {
    "id": 22,
    "text": "史学流变是最终定型。",
    "start": 90.4,
    "end": 92.08,
    "duration": 1.68
  },
  {
    "id": 23,
    "text": "理顺了宏观全局思路，接下来进入每一段的具体推导与逐句表述。",
    "start": 92.4,
    "end": 97.68,
    "duration": 5.28
  },
  {
    "id": 24,
    "text": "--。第",
    "start": 97.68,
    "end": 97.84,
    "duration": 0.16
  },
  {
    "id": 25,
    "text": "一段：首段破题与概念定性。",
    "start": 97.84,
    "end": 100.24,
    "duration": 2.4
  },
  {
    "id": 26,
    "text": "逐句因果推导与答题表述。",
    "start": 100.24,
    "end": 102.48,
    "duration": 2.24
  },
  {
    "id": 27,
    "text": "首句必须直击核心概念，绝不绕弯。",
    "start": 102.48,
    "end": 105.6,
    "duration": 3.12
  },
  {
    "id": 28,
    "text": "所以表述为：《诗经》是中国古代文学史上第一部诗歌总集。",
    "start": 105.6,
    "end": 110.08,
    "duration": 4.48
  },
  {
    "id": 29,
    "text": "次句紧承首句说明其划时代的历史地位，",
    "start": 110.4,
    "end": 113.68,
    "duration": 3.28
  },
  {
    "id": 30,
    "text": "标志着古典诗歌走向自觉成熟。",
    "start": 113.68,
    "end": 116.56,
    "duration": 2.88
  },
  {
    "id": 31,
    "text": "所以表述为：它标志着中国诗歌从原始歌谣走向成熟自觉的抒情形态。",
    "start": 116.56,
    "end": 122.853,
    "duration": 6.293
  },
  {
    "id": 32,
    "text": "第三句必须引入权威教材定论，确立其现实主义传统的母体地位。",
    "start": 122.853,
    "end": 128.613,
    "duration": 5.76
  },
  {
    "id": 33,
    "text": "所以表述为：袁行配《中国文学史》指出，",
    "start": 128.613,
    "end": 132.08,
    "duration": 3.467
  },
  {
    "id": 34,
    "text": "《诗经》开创了中国古代诗歌灿烂的现实主义传统。",
    "start": 132.08,
    "end": 136.08,
    "duration": 4.0
  },
  {
    "id": 35,
    "text": "第四句进一步阐明其美学贡献，说明它奠定了以抒情为主导的美学风范。",
    "start": 136.08,
    "end": 142.16,
    "duration": 6.08
  },
  {
    "id": 36,
    "text": "所以表述为：它全面奠定了古典诗歌以抒情为主导的美学风范。",
    "start": 142.16,
    "end": 147.52,
    "duration": 5.36
  },
  {
    "id": 37,
    "text": "第五句顺理成章作为首段过渡句，宣告下文将从四个核心维度展开系统论述。",
    "start": 147.896,
    "end": 155.256,
    "duration": 7.36
  },
  {
    "id": 38,
    "text": "所以表述为：其杰出的艺术成就与表现手法，",
    "start": 155.256,
    "end": 159.176,
    "duration": 3.92
  },
  {
    "id": 39,
    "text": "主要体现在以下四个核心维度：本段答题思路总结。",
    "start": 159.176,
    "end": 164.136,
    "duration": 4.96
  },
  {
    "id": 40,
    "text": "本段用五句话完成立论闭环：先直接亮出文学史第一部诗歌总集的崇高坐标，",
    "start": 164.136,
    "end": 171.016,
    "duration": 6.88
  },
  {
    "id": 41,
    "text": "再点明其由原始歌谣向自觉抒情诗飞跃的性质；",
    "start": 171.016,
    "end": 175.176,
    "duration": 4.16
  },
  {
    "id": 42,
    "text": "随即以袁行配教材锚定其现实主义与抒情传统两大母体特征；",
    "start": 175.416,
    "end": 181.256,
    "duration": 5.84
  },
  {
    "id": 43,
    "text": "最后自然转入四个维度的展开，开篇严谨规范。",
    "start": 181.256,
    "end": 185.256,
    "duration": 4.0
  },
  {
    "id": 44,
    "text": "所以本段具体答题完整版为：《诗经》是中国古代文学史上第一部诗歌总集。",
    "start": 185.256,
    "end": 191.416,
    "duration": 6.16
  },
  {
    "id": 45,
    "text": "它标志着中国诗歌从原始歌谣走向成熟自觉的抒情形态。",
    "start": 191.416,
    "end": 196.376,
    "duration": 4.96
  },
  {
    "id": 46,
    "text": "袁行配《中国文学史》指出，《诗经》开创了中国古代诗歌灿烂的现实主义传统。",
    "start": 196.616,
    "end": 202.776,
    "duration": 6.16
  },
  {
    "id": 47,
    "text": "它全面奠定了古典诗歌以抒情为主导的美学风范。",
    "start": 202.776,
    "end": 207.176,
    "duration": 4.4
  },
  {
    "id": 48,
    "text": "其杰出的艺术成就与表现手法，主要体现在以下四个核心维度：……第二段：第一分论点，",
    "start": 207.176,
    "end": 214.296,
    "duration": 7.12
  },
  {
    "id": 49,
    "text": "抒情机制与精神内核（意之“真”）。",
    "start": 214.296,
    "end": 217.016,
    "duration": 2.72
  },
  {
    "id": 50,
    "text": "逐句因果推导与答题表述。",
    "start": 217.256,
    "end": 219.496,
    "duration": 2.24
  },
  {
    "id": 51,
    "text": "首段确立了内容决定形式的原则，第二段必须首先解决《诗经》的写实精神与情感源泉。",
    "start": 219.496,
    "end": 226.376,
    "duration": 6.88
  },
  {
    "id": 52,
    "text": "首句立论，指出诗经打破了神话巫术的虚妄，",
    "start": 226.376,
    "end": 230.056,
    "duration": 3.68
  },
  {
    "id": 53,
    "text": "直面客观人生。",
    "start": 230.056,
    "end": 231.576,
    "duration": 1.52
  },
  {
    "id": 54,
    "text": "所以表述为：《诗经》打破了神话巫术的虚幻迷雾，",
    "start": 231.576,
    "end": 235.336,
    "duration": 3.76
  },
  {
    "id": 55,
    "text": "展现出极强的写实主义精神。",
    "start": 235.336,
    "end": 237.576,
    "duration": 2.24
  },
  {
    "id": 56,
    "text": "次句调取古代文论最核心的经典名言，",
    "start": 237.896,
    "end": 241.016,
    "duration": 3.12
  },
  {
    "id": 57,
    "text": "作为写实精神的文献定论。",
    "start": 241.016,
    "end": 243.336,
    "duration": 2.32
  },
  {
    "id": 58,
    "text": "所以表述为：汉代何休在《春秋公羊传解诂》中提出著名的“饥者歌其食，",
    "start": 243.336,
    "end": 249.656,
    "duration": 6.32
  },
  {
    "id": 59,
    "text": "劳者歌其事”。",
    "start": 249.656,
    "end": 251.096,
    "duration": 1.44
  },
  {
    "id": 60,
    "text": "第三句紧承名言推导因果，说明诗作全面覆盖了周代世俗生活的方方面面。",
    "start": 251.096,
    "end": 256.936,
    "duration": 5.84
  },
  {
    "id": 61,
    "text": "所以表述为：诗作直面周代广阔的社会生活，",
    "start": 257.256,
    "end": 261.18,
    "duration": 3.924
  },
  {
    "id": 62,
    "text": "真实记录了劳动、婚恋、徭役与阶级压迫。",
    "start": 261.18,
    "end": 264.723,
    "duration": 3.543
  },
  {
    "id": 63,
    "text": "第四句引入批判剥削的代表作，调取愤怒质问统治者的千古名句。",
    "start": 264.723,
    "end": 270.701,
    "duration": 5.978
  },
  {
    "id": 64,
    "text": "所以表述为：在表现剥削与压迫时，",
    "start": 270.701,
    "end": 273.801,
    "duration": 3.1
  },
  {
    "id": 65,
    "text": "《伐檀》愤怒追问不劳而获的统治者：“不稼不瑟，",
    "start": 273.801,
    "end": 277.786,
    "duration": 3.985
  },
  {
    "id": 66,
    "text": "胡取禾三百缠兮”。",
    "start": 277.786,
    "end": 279.336,
    "duration": 1.55
  },
  {
    "id": 67,
    "text": "第五句引入表现男女情爱的代表篇目，",
    "start": 279.416,
    "end": 282.696,
    "duration": 3.28
  },
  {
    "id": 68,
    "text": "调取家喻户晓的开篇名句。",
    "start": 282.696,
    "end": 285.336,
    "duration": 2.64
  },
  {
    "id": 69,
    "text": "所以表述为：在表现男女情爱时，《周南•关雎》写出“窈窕淑女，",
    "start": 285.336,
    "end": 291.176,
    "duration": 5.84
  },
  {
    "id": 70,
    "text": "君子好逑”的天然质朴。",
    "start": 291.176,
    "end": 293.096,
    "duration": 1.92
  },
  {
    "id": 71,
    "text": "第六句对文本情感进行美学定型，指出其纯真坦诚、",
    "start": 293.384,
    "end": 298.344,
    "duration": 4.96
  },
  {
    "id": 72,
    "text": "拒绝空洞教条。",
    "start": 298.344,
    "end": 299.784,
    "duration": 1.44
  },
  {
    "id": 73,
    "text": "所以表述为：全诗情感真挚坦诚，既无虚饰矫情，",
    "start": 299.784,
    "end": 304.222,
    "duration": 4.438
  },
  {
    "id": 74,
    "text": "更无空洞说教。",
    "start": 304.222,
    "end": 305.621,
    "duration": 1.399
  },
  {
    "id": 75,
    "text": "第七句收束全段，指出直面民生与真情铸就了诗经深沉厚重的思想底色。",
    "start": 305.621,
    "end": 312.618,
    "duration": 6.997
  },
  {
    "id": 76,
    "text": "所以表述为：这种直面现实民生与生命真情的创作取向，",
    "start": 312.618,
    "end": 317.544,
    "duration": 4.926
  },
  {
    "id": 77,
    "text": "铸就了《诗经》深沉厚重的思想底色。",
    "start": 317.544,
    "end": 320.664,
    "duration": 3.12
  },
  {
    "id": 78,
    "text": "本段答题思路总结。",
    "start": 320.664,
    "end": 322.264,
    "duration": 1.6
  },
  {
    "id": 79,
    "text": "本段从思想精神层面建立论据支撑：先以何休“饥者歌其食”确立现实主义写实原则；",
    "start": 322.264,
    "end": 329.704,
    "duration": 7.44
  },
  {
    "id": 80,
    "text": "随后通过《伐檀》对不劳而获的尖锐质问，",
    "start": 329.704,
    "end": 332.824,
    "duration": 3.12
  },
  {
    "id": 81,
    "text": "以及《关雎》对纯朴爱情的真实描摹；",
    "start": 332.824,
    "end": 335.544,
    "duration": 2.72
  },
  {
    "id": 82,
    "text": "证明诗经摆脱了虚妄神学与浮夸辞藻，",
    "start": 335.864,
    "end": 339.544,
    "duration": 3.68
  },
  {
    "id": 83,
    "text": "牢牢扎根于世俗民生与真实人性，奠定了现实主义的基石。",
    "start": 339.544,
    "end": 344.904,
    "duration": 5.36
  },
  {
    "id": 84,
    "text": "所以本段具体答题完整版为：一、抒情机制与精神内核：饥者歌其食的写实精神与真纯情感。",
    "start": 344.904,
    "end": 354.264,
    "duration": 9.36
  },
  {
    "id": 85,
    "text": "《诗经》打破了神话巫术的虚幻迷雾，",
    "start": 354.264,
    "end": 357.064,
    "duration": 2.8
  },
  {
    "id": 86,
    "text": "展现出极强的写实主义精神。",
    "start": 357.064,
    "end": 359.384,
    "duration": 2.32
  },
  {
    "id": 87,
    "text": "汉代何休在《春秋公羊传解诂》中提出著名的“饥者歌其食，",
    "start": 359.624,
    "end": 365.304,
    "duration": 5.68
  },
  {
    "id": 88,
    "text": "劳者歌其事”。",
    "start": 365.304,
    "end": 366.824,
    "duration": 1.52
  },
  {
    "id": 89,
    "text": "诗作直面周代广阔的社会生活，真实记录了劳动、",
    "start": 366.824,
    "end": 371.224,
    "duration": 4.4
  },
  {
    "id": 90,
    "text": "婚恋、徭役与阶级压迫。",
    "start": 371.224,
    "end": 373.864,
    "duration": 2.64
  },
  {
    "id": 91,
    "text": "在表现剥削与压迫时，《伐檀》愤怒追问不劳而获的统治者：“不稼不瑟，",
    "start": 373.864,
    "end": 379.944,
    "duration": 6.08
  },
  {
    "id": 92,
    "text": "胡取禾三百缠兮”。",
    "start": 379.944,
    "end": 381.464,
    "duration": 1.52
  },
  {
    "id": 93,
    "text": "在表现男女情爱时，《周南•关雎》写出“窈窕淑女，",
    "start": 381.784,
    "end": 385.784,
    "duration": 4.0
  },
  {
    "id": 94,
    "text": "君子好逑”的天然质朴。",
    "start": 385.784,
    "end": 387.944,
    "duration": 2.16
  },
  {
    "id": 95,
    "text": "全诗情感真挚坦诚，既无虚饰矫情，",
    "start": 387.944,
    "end": 391.384,
    "duration": 3.44
  },
  {
    "id": 96,
    "text": "更无空洞说教。",
    "start": 391.384,
    "end": 392.904,
    "duration": 1.52
  },
  {
    "id": 97,
    "text": "这种直面现实民生与生命真情的创作取向，",
    "start": 392.904,
    "end": 396.584,
    "duration": 3.68
  },
  {
    "id": 98,
    "text": "铸就了《诗经》深沉厚重的思想底色。--。",
    "start": 396.584,
    "end": 399.144,
    "duration": 2.56
  },
  {
    "id": 99,
    "text": "第三段：第二分论点，表现手法的成熟体系（法之“巧”）。",
    "start": 399.384,
    "end": 404.264,
    "duration": 4.88
  },
  {
    "id": 100,
    "text": "逐句因果推导与答题表述。",
    "start": 404.264,
    "end": 406.664,
    "duration": 2.4
  },
  {
    "id": 101,
    "text": "第二段讲透了真实感情的源头，第三段必须正面攻克题干核心要求，",
    "start": 406.664,
    "end": 412.504,
    "duration": 5.84
  },
  {
    "id": 102,
    "text": "赋比兴手法。",
    "start": 412.504,
    "end": 413.784,
    "duration": 1.28
  },
  {
    "id": 103,
    "text": "首句确立分论点，指出赋比兴是诗经最具代表性的表现体系。",
    "start": 413.784,
    "end": 418.744,
    "duration": 4.96
  },
  {
    "id": 104,
    "text": "所以表述为：“赋、比、兴”是《诗经》最具标志性的艺术表现体系。",
    "start": 419.064,
    "end": 424.742,
    "duration": 5.678
  },
  {
    "id": 105,
    "text": "次句搬出中国文论史最具权威性的界定者朱熹。",
    "start": 424.742,
    "end": 429.686,
    "duration": 4.944
  },
  {
    "id": 106,
    "text": "所以表述为：宋代朱熹在《诗集传》中对此作出了经典权威的界定。",
    "start": 429.686,
    "end": 436.113,
    "duration": 6.427
  },
  {
    "id": 107,
    "text": "第三句交代“赋”的标准定义与功能机制。",
    "start": 436.113,
    "end": 440.068,
    "duration": 3.955
  },
  {
    "id": 108,
    "text": "所以表述为：所谓“赋者，敷陈其事而直言之者也”，",
    "start": 440.068,
    "end": 445.2,
    "duration": 5.132
  },
  {
    "id": 109,
    "text": "即直接铺陈叙述客观物象与内心动态。",
    "start": 445.2,
    "end": 448.88,
    "duration": 3.68
  },
  {
    "id": 110,
    "text": "第四句交代“比”的标准定义与功能机制。",
    "start": 448.88,
    "end": 452.08,
    "duration": 3.2
  },
  {
    "id": 111,
    "text": "所以表述为：所谓“比者，以彼物比此物也”，",
    "start": 452.08,
    "end": 456.16,
    "duration": 4.08
  },
  {
    "id": 112,
    "text": "即运用生动比喻寄托主观意旨。",
    "start": 456.16,
    "end": 458.8,
    "duration": 2.64
  },
  {
    "id": 113,
    "text": "第五句交代“兴”的标准定义与功能机制。",
    "start": 458.8,
    "end": 461.6,
    "duration": 2.8
  },
  {
    "id": 114,
    "text": "所以表述为：所谓“兴者，先言他物以引起所咏之词也”，",
    "start": 462.0,
    "end": 466.654,
    "duration": 4.654
  },
  {
    "id": 115,
    "text": "即借眼前自然事物引发内心情感。",
    "start": 466.654,
    "end": 469.8,
    "duration": 3.146
  },
  {
    "id": 116,
    "text": "第六句提出高级论述视角，指出创作中三者绝非割裂，",
    "start": 469.8,
    "end": 474.744,
    "duration": 4.944
  },
  {
    "id": 117,
    "text": "而是综合交织。",
    "start": 474.744,
    "end": 476.093,
    "duration": 1.349
  },
  {
    "id": 118,
    "text": "所以表述为：在实际创作中，三者绝非孤立割裂，",
    "start": 476.093,
    "end": 480.362,
    "duration": 4.269
  },
  {
    "id": 119,
    "text": "而是高度交融互化。",
    "start": 480.362,
    "end": 482.16,
    "duration": 1.798
  },
  {
    "id": 120,
    "text": "第七句引入长篇叙事抒情名作《卫风•氓》，",
    "start": 482.24,
    "end": 486.08,
    "duration": 3.84
  },
  {
    "id": 121,
    "text": "分析其借桑树变迁喻示命运的精妙手法。",
    "start": 486.08,
    "end": 490.08,
    "duration": 4.0
  },
  {
    "id": 122,
    "text": "所以表述为：在名篇《卫风•氓》中，",
    "start": 490.08,
    "end": 493.12,
    "duration": 3.04
  },
  {
    "id": 123,
    "text": "诗人借桑树由“其叶沃若”到“其叶黄落”的自然变迁。",
    "start": 493.12,
    "end": 498.16,
    "duration": 5.04
  },
  {
    "id": 124,
    "text": "第八句对该文本进行技法定型，剖析其将赋的叙事、",
    "start": 498.16,
    "end": 502.56,
    "duration": 4.4
  },
  {
    "id": 125,
    "text": "比的喻意与兴的触物完美结合。",
    "start": 502.56,
    "end": 505.12,
    "duration": 2.56
  },
  {
    "id": 126,
    "text": "所以表述为：将生动的比喻、起兴的灵动与直接的叙事融为一体，",
    "start": 505.52,
    "end": 511.001,
    "duration": 5.481
  },
  {
    "id": 127,
    "text": "形象喻示了女主人公容颜衰老与爱情破灭。",
    "start": 511.001,
    "end": 514.832,
    "duration": 3.831
  },
  {
    "id": 128,
    "text": "第九句得出总结，指出赋比兴极大拓展了中国诗歌情景交融的意象塑造能力。",
    "start": 514.832,
    "end": 521.643,
    "duration": 6.811
  },
  {
    "id": 129,
    "text": "所以表述为：赋比兴的广泛运用，极大地提升了古典诗歌情景交融的意象营构能力。",
    "start": 521.643,
    "end": 528.88,
    "duration": 7.237
  },
  {
    "id": 130,
    "text": "本段答题思路总结。",
    "start": 528.96,
    "end": 530.48,
    "duration": 1.52
  },
  {
    "id": 131,
    "text": "本段聚焦于最具技术含量的表现手法：先完整背出朱熹《诗集传》对赋、",
    "start": 530.48,
    "end": 536.32,
    "duration": 5.84
  },
  {
    "id": 132,
    "text": "比、兴的三位一体权威定义；",
    "start": 536.32,
    "end": 538.4,
    "duration": 2.08
  },
  {
    "id": 133,
    "text": "紧接着跳出孤立解释概念的低幼答法，",
    "start": 538.4,
    "end": 541.36,
    "duration": 2.96
  },
  {
    "id": 134,
    "text": "以《氓》中桑树叶沃到叶落的经典隐喻为例，",
    "start": 541.36,
    "end": 544.72,
    "duration": 3.36
  },
  {
    "id": 135,
    "text": "深度剖析赋比兴综合一体的艺术机制，",
    "start": 544.72,
    "end": 547.6,
    "duration": 2.88
  },
  {
    "id": 136,
    "text": "证明其开辟了中国古典诗歌比德观念与情景交融的千古法门。",
    "start": 547.6,
    "end": 552.32,
    "duration": 4.72
  },
  {
    "id": 137,
    "text": "所以本段具体答题完整版为：二、表现手法的成熟体系：赋比兴三者的界定演进与有机融合。",
    "start": 552.64,
    "end": 561.76,
    "duration": 9.12
  },
  {
    "id": 138,
    "text": "“赋、比、兴”是《诗经》最具标志性的艺术表现体系。",
    "start": 561.76,
    "end": 565.92,
    "duration": 4.16
  },
  {
    "id": 139,
    "text": "宋代朱熹在《诗集传》中对此作出了经典权威的界定。",
    "start": 565.92,
    "end": 570.4,
    "duration": 4.48
  },
  {
    "id": 140,
    "text": "所谓“赋者，敷陈其事而直言之者也”，",
    "start": 570.4,
    "end": 574.16,
    "duration": 3.76
  },
  {
    "id": 141,
    "text": "即直接铺陈叙述客观物象与内心动态。",
    "start": 574.16,
    "end": 577.44,
    "duration": 3.28
  },
  {
    "id": 142,
    "text": "所谓“比者，以彼物比此物也”，即运用生动比喻寄托主观意旨。",
    "start": 577.84,
    "end": 584.64,
    "duration": 6.8
  },
  {
    "id": 143,
    "text": "所谓“兴者，先言他物以引起所咏之词也”，",
    "start": 584.64,
    "end": 589.12,
    "duration": 4.48
  },
  {
    "id": 144,
    "text": "即借眼前自然事物引发内心情感。",
    "start": 589.12,
    "end": 592.0,
    "duration": 2.88
  },
  {
    "id": 145,
    "text": "在实际创作中，三者绝非孤立割裂，",
    "start": 592.304,
    "end": 595.424,
    "duration": 3.12
  },
  {
    "id": 146,
    "text": "而是高度交融互化。",
    "start": 595.424,
    "end": 597.184,
    "duration": 1.76
  },
  {
    "id": 147,
    "text": "在名篇《卫风•氓》中，诗人借桑树由“其叶沃若”到“其叶黄落”的自然变迁。",
    "start": 597.184,
    "end": 603.824,
    "duration": 6.64
  },
  {
    "id": 148,
    "text": "将生动的比喻、起兴的灵动与直接的叙事融为一体，",
    "start": 603.824,
    "end": 608.384,
    "duration": 4.56
  },
  {
    "id": 149,
    "text": "形象喻示了女主人公容颜衰老与爱情破灭。",
    "start": 608.384,
    "end": 611.744,
    "duration": 3.36
  },
  {
    "id": 150,
    "text": "赋比兴的广泛运用，极大地提升了古典诗歌情景交融的意象营构能力。。",
    "start": 612.064,
    "end": 617.984,
    "duration": 5.92
  },
  {
    "id": 151,
    "text": "第四段：第三分论点，体制章法与声律建构（体之“美”）。",
    "start": 617.984,
    "end": 623.264,
    "duration": 5.28
  },
  {
    "id": 152,
    "text": "逐句因果推导与答题表述。",
    "start": 623.264,
    "end": 625.504,
    "duration": 2.24
  },
  {
    "id": 153,
    "text": "前两段解决了情与法，第四段必须进一步下沉到诗歌的语言体制与声律建构。",
    "start": 625.504,
    "end": 632.144,
    "duration": 6.64
  },
  {
    "id": 154,
    "text": "首句确立分论点，指出诗经在体式与音乐体制上确立了早期诗歌规范。",
    "start": 632.384,
    "end": 638.624,
    "duration": 6.24
  },
  {
    "id": 155,
    "text": "所以表述为：《诗经》在文体形式与音乐体制上，",
    "start": 638.624,
    "end": 642.583,
    "duration": 3.959
  },
  {
    "id": 156,
    "text": "确立了早期诗歌整赤灵动的规范。",
    "start": 642.583,
    "end": 645.711,
    "duration": 3.128
  },
  {
    "id": 157,
    "text": "次句锁定核心句式，指明其以四言为主干并结合杂言。",
    "start": 645.711,
    "end": 650.627,
    "duration": 4.916
  },
  {
    "id": 158,
    "text": "所以表述为：全书在体制上以四言句式为主干，",
    "start": 650.627,
    "end": 655.264,
    "duration": 4.637
  },
  {
    "id": 159,
    "text": "同时根据抒情需要穿插杂言。",
    "start": 655.264,
    "end": 658.144,
    "duration": 2.88
  },
  {
    "id": 160,
    "text": "第三句点出极具代表性的章法结构，",
    "start": 658.144,
    "end": 661.104,
    "duration": 2.96
  },
  {
    "id": 161,
    "text": "重章叠句。",
    "start": 661.104,
    "end": 662.384,
    "duration": 1.28
  },
  {
    "id": 162,
    "text": "所以表述为：其篇章结构广泛采用独具匠心的“重章叠句”形式。",
    "start": 662.384,
    "end": 668.144,
    "duration": 5.76
  },
  {
    "id": 163,
    "text": "第四句分析重章叠句的音乐与情感机制，",
    "start": 668.144,
    "end": 671.664,
    "duration": 3.52
  },
  {
    "id": 164,
    "text": "字句微换而情感深化。",
    "start": 671.664,
    "end": 673.664,
    "duration": 2.0
  },
  {
    "id": 165,
    "text": "所以表述为：各章之间字句略有更替，",
    "start": 673.984,
    "end": 677.084,
    "duration": 3.1
  },
  {
    "id": 166,
    "text": "在回环往复的咏唱中使情感层层深化。",
    "start": 677.084,
    "end": 680.444,
    "duration": 3.36
  },
  {
    "id": 167,
    "text": "第五句调取代表篇目《周南•福以》，",
    "start": 680.444,
    "end": 683.174,
    "duration": 2.73
  },
  {
    "id": 168,
    "text": "剖析动词替换生动再现劳动的欢快节奏。",
    "start": 683.174,
    "end": 686.744,
    "duration": 3.57
  },
  {
    "id": 169,
    "text": "所以表述为：正如《周南•福以》通篇采用重章，",
    "start": 686.744,
    "end": 690.314,
    "duration": 3.57
  },
  {
    "id": 170,
    "text": "通过采、掇、捋等动词的递进，生动再现了妇女采桑劳动的欢快节律。",
    "start": 690.314,
    "end": 695.984,
    "duration": 5.67
  },
  {
    "id": 171,
    "text": "第六句由章法转入语言声律，点出双声叠韵与叠字摹状的大量运用。",
    "start": 696.064,
    "end": 702.784,
    "duration": 6.72
  },
  {
    "id": 172,
    "text": "所以表述为：在语言运用上，《诗经》大量使用双声叠韵与叠字摹状词。",
    "start": 702.784,
    "end": 709.0,
    "duration": 6.216
  },
  {
    "id": 173,
    "text": "第七句调取千古写景抒情绝唱《小雅•采薇》的名句。",
    "start": 709.0,
    "end": 713.659,
    "duration": 4.659
  },
  {
    "id": 174,
    "text": "所以表述为：如《小雅•采薇》中的名句：“昔我往矣，",
    "start": 713.659,
    "end": 717.852,
    "duration": 4.193
  },
  {
    "id": 175,
    "text": "杨柳依依。",
    "start": 717.852,
    "end": 718.784,
    "duration": 0.932
  },
  {
    "id": 176,
    "text": "今我来思，雨雪霏霏”。",
    "start": 718.864,
    "end": 721.184,
    "duration": 2.32
  },
  {
    "id": 177,
    "text": "第八句展开微观语言分析，解释“依依”与“霏霏”的音义结合之妙。",
    "start": 721.184,
    "end": 726.784,
    "duration": 5.6
  },
  {
    "id": 178,
    "text": "所以表述为：“依依”摹杨柳轻盈之态，",
    "start": 726.784,
    "end": 730.224,
    "duration": 3.44
  },
  {
    "id": 179,
    "text": "“霏霏”写雪落浓密之景。",
    "start": 730.224,
    "end": 733.104,
    "duration": 2.88
  },
  {
    "id": 180,
    "text": "第九句总结收束全段，指出这些语言特点赋予了诗经极强的音乐性与表现力。",
    "start": 733.104,
    "end": 739.744,
    "duration": 6.64
  },
  {
    "id": 181,
    "text": "所以表述为：这些声色兼备的语言，",
    "start": 739.744,
    "end": 742.768,
    "duration": 3.024
  },
  {
    "id": 182,
    "text": "使全书具备了极强的音乐旋律美与感官表现力。",
    "start": 742.768,
    "end": 746.848,
    "duration": 4.08
  },
  {
    "id": 183,
    "text": "本段答题思路总结。",
    "start": 746.848,
    "end": 748.768,
    "duration": 1.92
  },
  {
    "id": 184,
    "text": "本段展示了考生的形式美学功底：从四言为主的体制切入，",
    "start": 748.768,
    "end": 753.248,
    "duration": 4.48
  },
  {
    "id": 185,
    "text": "以《福以》为例剖析重章叠句回环往复的民歌复沓机制；",
    "start": 753.248,
    "end": 757.568,
    "duration": 4.32
  },
  {
    "id": 186,
    "text": "随即转向声律词汇，以《采薇》依依与霏霏的千古叠字为例，",
    "start": 757.568,
    "end": 762.448,
    "duration": 4.88
  },
  {
    "id": 187,
    "text": "论证双声叠韵与摹状词对意境营构的支撑，",
    "start": 762.448,
    "end": 766.128,
    "duration": 3.68
  },
  {
    "id": 188,
    "text": "展现出古典诗歌早期形式美与音乐美的成熟。",
    "start": 766.128,
    "end": 769.328,
    "duration": 3.2
  },
  {
    "id": 189,
    "text": "所以本段具体答题完整版为：三、体制章法与声律建构：四言为主的重章叠句与连绵韵律。",
    "start": 769.728,
    "end": 777.968,
    "duration": 8.24
  },
  {
    "id": 190,
    "text": "《诗经》在文体形式与音乐体制上，",
    "start": 777.968,
    "end": 780.688,
    "duration": 2.72
  },
  {
    "id": 191,
    "text": "确立了早期诗歌整赤灵动的规范。",
    "start": 780.688,
    "end": 783.888,
    "duration": 3.2
  },
  {
    "id": 192,
    "text": "全书在体制上以四言句式为主干，同时根据抒情需要穿插杂言。",
    "start": 783.888,
    "end": 789.168,
    "duration": 5.28
  },
  {
    "id": 193,
    "text": "其篇章结构广泛采用独具匠心的“重章叠句”形式。",
    "start": 789.568,
    "end": 793.808,
    "duration": 4.24
  },
  {
    "id": 194,
    "text": "各章之间字句略有更替，在回环往复的咏唱中使情感层层深化。",
    "start": 793.808,
    "end": 800.048,
    "duration": 6.24
  },
  {
    "id": 195,
    "text": "正如《周南•福以》通篇采用重章，",
    "start": 800.048,
    "end": 802.608,
    "duration": 2.56
  },
  {
    "id": 196,
    "text": "通过采、掇、捋等动词的递进，生动再现了妇女采桑劳动的欢快节律。",
    "start": 802.608,
    "end": 808.608,
    "duration": 6.0
  },
  {
    "id": 197,
    "text": "在语言运用上，《诗经》大量使用双声叠韵与叠字摹状词。",
    "start": 809.008,
    "end": 814.368,
    "duration": 5.36
  },
  {
    "id": 198,
    "text": "如《小雅•采薇》中的名句：“昔我往矣，",
    "start": 814.368,
    "end": 817.888,
    "duration": 3.52
  },
  {
    "id": 199,
    "text": "杨柳依依。",
    "start": 817.888,
    "end": 819.088,
    "duration": 1.2
  },
  {
    "id": 200,
    "text": "今我来思，雨雪霏霏”。",
    "start": 819.088,
    "end": 821.408,
    "duration": 2.32
  },
  {
    "id": 201,
    "text": "“依依”摹杨柳轻盈之态，“霏霏”写雪落浓密之景。",
    "start": 821.408,
    "end": 825.968,
    "duration": 4.56
  },
  {
    "id": 202,
    "text": "这些声色兼备的语言，使全书具备了极强的音乐旋律美与感官表现力。",
    "start": 825.968,
    "end": 831.808,
    "duration": 5.84
  },
  {
    "id": 203,
    "text": "第五段：第四分论点，文化品格与审美范式（境之“和”）。",
    "start": 832.048,
    "end": 837.328,
    "duration": 5.28
  },
  {
    "id": 204,
    "text": "逐句因果推导与答题表述。",
    "start": 837.328,
    "end": 840.128,
    "duration": 2.8
  },
  {
    "id": 205,
    "text": "在解决了情、法、体之后，本段必须把诗经提升到儒家诗教与中国美学范式的高度。",
    "start": 840.128,
    "end": 847.408,
    "duration": 7.28
  },
  {
    "id": 206,
    "text": "首句确立分论点，指出诗经体现了先秦礼乐文明推崇的中和之美。",
    "start": 847.408,
    "end": 853.008,
    "duration": 5.6
  },
  {
    "id": 207,
    "text": "所以表述为：《诗经》在美学品格上体现了先秦礼乐文明所推崇的“中和之美”。",
    "start": 853.248,
    "end": 859.774,
    "duration": 6.526
  },
  {
    "id": 208,
    "text": "次句搬出儒家宗师孔子的经典总评，",
    "start": 859.774,
    "end": 863.025,
    "duration": 3.251
  },
  {
    "id": 209,
    "text": "作为思想精神的核心定语。",
    "start": 863.025,
    "end": 865.409,
    "duration": 2.384
  },
  {
    "id": 210,
    "text": "所以表述为：孔子在《论语》中以“诗三百，",
    "start": 865.409,
    "end": 868.66,
    "duration": 3.251
  },
  {
    "id": 211,
    "text": "一言以蔽之，曰思无邪”概括其精神特质。",
    "start": 868.66,
    "end": 872.128,
    "duration": 3.468
  },
  {
    "id": 212,
    "text": "第三句深入阐释“思无邪”，说明热烈真挚的情感始终受到理性节制。",
    "start": 872.208,
    "end": 878.688,
    "duration": 6.48
  },
  {
    "id": 213,
    "text": "所以表述为：全诗情感表达热烈而真挚，",
    "start": 878.688,
    "end": 882.048,
    "duration": 3.36
  },
  {
    "id": 214,
    "text": "但始终保持在理性的节制与秩序之中。",
    "start": 882.048,
    "end": 885.728,
    "duration": 3.68
  },
  {
    "id": 215,
    "text": "第四句引入汉代《毛诗序》的经典诗教阐发。",
    "start": 885.728,
    "end": 888.848,
    "duration": 3.12
  },
  {
    "id": 216,
    "text": "所以表述为：汉代《毛诗序》进而将其阐发为“发乎情，",
    "start": 889.312,
    "end": 893.715,
    "duration": 4.403
  },
  {
    "id": 217,
    "text": "民之性也；",
    "start": 893.715,
    "end": 894.609,
    "duration": 0.894
  },
  {
    "id": 218,
    "text": "止乎礼义，国之情也”。",
    "start": 894.609,
    "end": 896.395,
    "duration": 1.786
  },
  {
    "id": 219,
    "text": "第五句紧扣抒情机制，指出怨刺诗篇也表现为怨而不怒的抒情克制。",
    "start": 896.395,
    "end": 902.649,
    "duration": 6.254
  },
  {
    "id": 220,
    "text": "所以表述为：即便是讽刺统治者暴政与控诉苦难的诗篇，",
    "start": 902.649,
    "end": 907.785,
    "duration": 5.136
  },
  {
    "id": 221,
    "text": "也多展现为怨而不怒的抒情克制。",
    "start": 907.785,
    "end": 910.912,
    "duration": 3.127
  },
  {
    "id": 222,
    "text": "第六句得出美学总结，指出这种哀而不伤的范式奠定了民族的典雅诗学品格。",
    "start": 910.992,
    "end": 917.712,
    "duration": 6.72
  },
  {
    "id": 223,
    "text": "所以表述为：这种哀而不伤、怨而不怒的中和审美范式，",
    "start": 917.712,
    "end": 922.432,
    "duration": 4.72
  },
  {
    "id": 224,
    "text": "奠定了中华民族含蓄典雅的诗学品格。",
    "start": 922.432,
    "end": 926.192,
    "duration": 3.76
  },
  {
    "id": 225,
    "text": "本段答题思路总结。",
    "start": 926.192,
    "end": 928.112,
    "duration": 1.92
  },
  {
    "id": 226,
    "text": "本段将文本分析上升为文化与诗教哲学的审视：以孔子“思无邪”和《毛诗序》“发乎情，",
    "start": 928.112,
    "end": 935.952,
    "duration": 7.84
  },
  {
    "id": 227,
    "text": "止乎礼义”为核心支柱；",
    "start": 935.952,
    "end": 937.712,
    "duration": 1.76
  },
  {
    "id": 228,
    "text": "深度阐发抒情自由与理性秩序之间的平衡统一；",
    "start": 938.032,
    "end": 942.112,
    "duration": 4.08
  },
  {
    "id": 229,
    "text": "证明诗经既非虚伪寡淡的礼教说教，",
    "start": 942.112,
    "end": 945.232,
    "duration": 3.12
  },
  {
    "id": 230,
    "text": "也非失控狂躁的情感宣泄，从而确立了中华文明“乐而不淫，",
    "start": 945.232,
    "end": 950.272,
    "duration": 5.04
  },
  {
    "id": 231,
    "text": "哀而不伤”的崇高中和典范。",
    "start": 950.272,
    "end": 952.672,
    "duration": 2.4
  },
  {
    "id": 232,
    "text": "所以本段具体答题完整版为：四、文化品格与审美范式：思无邪的纯朴风貌与中和之美。",
    "start": 952.672,
    "end": 960.192,
    "duration": 7.52
  },
  {
    "id": 233,
    "text": "《诗经》在美学品格上体现了先秦礼乐文明所推崇的“中和之美”。",
    "start": 960.352,
    "end": 966.187,
    "duration": 5.835
  },
  {
    "id": 234,
    "text": "孔子在《论语》中以“诗三百，一言以蔽之，",
    "start": 966.187,
    "end": 969.688,
    "duration": 3.501
  },
  {
    "id": 235,
    "text": "曰思无邪”概括其精神特质。",
    "start": 969.688,
    "end": 972.256,
    "duration": 2.568
  },
  {
    "id": 236,
    "text": "全诗情感表达热烈而真挚，但始终保持在理性的节制与秩序之中。",
    "start": 972.256,
    "end": 978.557,
    "duration": 6.301
  },
  {
    "id": 237,
    "text": "汉代《毛诗序》进而将其阐发为“发乎情，",
    "start": 978.557,
    "end": 982.058,
    "duration": 3.501
  },
  {
    "id": 238,
    "text": "民之性也；",
    "start": 982.058,
    "end": 982.992,
    "duration": 0.934
  },
  {
    "id": 239,
    "text": "止乎礼义，国之情也”。",
    "start": 983.072,
    "end": 984.912,
    "duration": 1.84
  },
  {
    "id": 240,
    "text": "即便是讽刺统治者暴政与控诉苦难的诗篇，",
    "start": 984.912,
    "end": 988.672,
    "duration": 3.76
  },
  {
    "id": 241,
    "text": "也多展现为怨而不怒的抒情克制。",
    "start": 988.672,
    "end": 991.792,
    "duration": 3.12
  },
  {
    "id": 242,
    "text": "这种哀而不伤、怨而不怒的中和审美范式，",
    "start": 991.792,
    "end": 995.152,
    "duration": 3.36
  },
  {
    "id": 243,
    "text": "奠定了中华民族含蓄典雅的诗学品格。",
    "start": 995.152,
    "end": 998.272,
    "duration": 3.12
  },
  {
    "id": 244,
    "text": "--。第",
    "start": 998.272,
    "end": 998.432,
    "duration": 0.16
  },
  {
    "id": 245,
    "text": "六段：尾段收官与文学史谱系闭环。",
    "start": 998.432,
    "end": 1001.472,
    "duration": 3.04
  },
  {
    "id": 246,
    "text": "逐句因果推导与答题表述。",
    "start": 1001.792,
    "end": 1004.352,
    "duration": 2.56
  },
  {
    "id": 247,
    "text": "尾段作为三十分大题的收官，必须将诗经放回三千年古典文学长河中进行历史定位。",
    "start": 1004.352,
    "end": 1011.232,
    "duration": 6.88
  },
  {
    "id": 248,
    "text": "首句综合前文四个维度，定评其为中国诗歌现实主义传统的源头活水。",
    "start": 1011.232,
    "end": 1017.472,
    "duration": 6.24
  },
  {
    "id": 249,
    "text": "所以表述为：综上所述，《诗经》是中国古典诗歌现实主义传统的源头活水。",
    "start": 1017.472,
    "end": 1023.552,
    "duration": 6.08
  },
  {
    "id": 250,
    "text": "次句概括其在技法、体裁与抒情机制上的开拓，",
    "start": 1023.872,
    "end": 1028.192,
    "duration": 4.32
  },
  {
    "id": 251,
    "text": "对后代产生了不可估量的深远影响。",
    "start": 1028.192,
    "end": 1031.152,
    "duration": 2.96
  },
  {
    "id": 252,
    "text": "所以表述为：它在赋比兴技法、四言诗体与抒情传统上的开拓，",
    "start": 1031.152,
    "end": 1036.648,
    "duration": 5.496
  },
  {
    "id": 253,
    "text": "对后世文学产生了不可估量的深远影响。",
    "start": 1036.648,
    "end": 1040.248,
    "duration": 3.6
  },
  {
    "id": 254,
    "text": "第三句向汉魏与唐代顺流推进，点明其对汉乐府民歌与建安风骨的直接启迪。",
    "start": 1040.248,
    "end": 1047.288,
    "duration": 7.04
  },
  {
    "id": 255,
    "text": "所以表述为：它不仅直接启迪了汉乐府民歌与建安风骨。",
    "start": 1047.288,
    "end": 1051.528,
    "duration": 4.24
  },
  {
    "id": 256,
    "text": "第四句落脚于唐代现实主义最高峰，",
    "start": 1051.768,
    "end": 1054.968,
    "duration": 3.2
  },
  {
    "id": 257,
    "text": "指出它是杜甫诗史与白居易新乐府运动的母体源头。",
    "start": 1054.968,
    "end": 1059.642,
    "duration": 4.674
  },
  {
    "id": 258,
    "text": "所以表述为：更是杜甫现实主义诗史与白居易新乐府运动的精神源头。",
    "start": 1059.642,
    "end": 1065.679,
    "duration": 6.037
  },
  {
    "id": 259,
    "text": "本段答题思路总结。",
    "start": 1065.679,
    "end": 1067.345,
    "duration": 1.666
  },
  {
    "id": 260,
    "text": "本段干净利落地完成文学史谱系收口：先用两句话总结其现实主义源头的不可动摇地位；",
    "start": 1067.345,
    "end": 1075.048,
    "duration": 7.703
  },
  {
    "id": 261,
    "text": "随后纵向贯通中国文学史，清晰点出由《诗经》出发，",
    "start": 1075.208,
    "end": 1079.928,
    "duration": 4.72
  },
  {
    "id": 262,
    "text": "历经两汉乐府、建安风骨，最终在唐代杜甫诗史与白居易新乐府运动中开花结果的演变脉络，",
    "start": 1079.928,
    "end": 1088.408,
    "duration": 8.48
  },
  {
    "id": 263,
    "text": "使全篇答卷在宏阔的历史视野中完美闭环。",
    "start": 1088.408,
    "end": 1092.408,
    "duration": 4.0
  },
  {
    "id": 264,
    "text": "所以本段具体答题完整版为：综上所述，",
    "start": 1092.408,
    "end": 1096.088,
    "duration": 3.68
  },
  {
    "id": 265,
    "text": "《诗经》是中国古典诗歌现实主义传统的源头活水。",
    "start": 1096.088,
    "end": 1099.848,
    "duration": 3.76
  },
  {
    "id": 266,
    "text": "它在赋比兴技法、四言诗体与抒情传统上的开拓，",
    "start": 1100.168,
    "end": 1104.488,
    "duration": 4.32
  },
  {
    "id": 267,
    "text": "对后世文学产生了不可估量的深远影响。",
    "start": 1104.488,
    "end": 1107.928,
    "duration": 3.44
  },
  {
    "id": 268,
    "text": "它不仅直接启迪了汉乐府民歌与建安风骨。",
    "start": 1107.928,
    "end": 1111.608,
    "duration": 3.68
  },
  {
    "id": 269,
    "text": "更是杜甫现实主义诗史与白居易新乐府运动的精神源头。",
    "start": 1111.608,
    "end": 1116.088,
    "duration": 4.48
  },
  {
    "id": 270,
    "text": "--。整",
    "start": 1116.088,
    "end": 1116.328,
    "duration": 0.24
  },
  {
    "id": 271,
    "text": "道大题的内在逻辑链总括。",
    "start": 1116.328,
    "end": 1118.168,
    "duration": 1.84
  },
  {
    "id": 272,
    "text": "这道三十分大题的本质，是一场极度严密的逻辑推演。",
    "start": 1118.488,
    "end": 1123.288,
    "duration": 4.8
  },
  {
    "id": 273,
    "text": "整篇答卷从头到尾遵循着“由概念定评、",
    "start": 1123.288,
    "end": 1126.968,
    "duration": 3.68
  },
  {
    "id": 274,
    "text": "到真纯情志、到赋比兴手法、到四言声律、",
    "start": 1126.968,
    "end": 1131.048,
    "duration": 4.08
  },
  {
    "id": 275,
    "text": "到中和品格、最终回归文学史承续”的必然法则。",
    "start": 1131.048,
    "end": 1135.688,
    "duration": 4.64
  },
  {
    "id": 276,
    "text": "阅卷老师看到的绝不是散乱的答题点，",
    "start": 1135.688,
    "end": 1138.888,
    "duration": 3.2
  },
  {
    "id": 277,
    "text": "而是一条咬合紧密的因果长链：第一步是“立论定性”，",
    "start": 1138.888,
    "end": 1143.368,
    "duration": 4.48
  },
  {
    "id": 278,
    "text": "开门见山解决《诗经》的源头地位，",
    "start": 1143.368,
    "end": 1146.328,
    "duration": 2.96
  },
  {
    "id": 279,
    "text": "确立现实主义与抒情传统双重标杆。",
    "start": 1146.328,
    "end": 1149.928,
    "duration": 3.6
  },
  {
    "id": 280,
    "text": "第二步是“真纯情志”，以何休“饥者歌其食”及《伐檀》 《关雎》证明其直面人生的写实精神。",
    "start": 1149.928,
    "end": 1158.008,
    "duration": 8.08
  },
  {
    "id": 281,
    "text": "第三步是“赋比兴体系”，以朱熹经典三定义与《卫风•氓》的桑树意象，",
    "start": 1158.008,
    "end": 1164.168,
    "duration": 6.16
  },
  {
    "id": 282,
    "text": "剖析情景交融的表现技艺。",
    "start": 1164.168,
    "end": 1166.408,
    "duration": 2.24
  },
  {
    "id": 283,
    "text": "第四步是“体制声律”，以四言为主、",
    "start": 1166.648,
    "end": 1169.608,
    "duration": 2.96
  },
  {
    "id": 284,
    "text": "重章叠句与《采薇》叠字，证明早期诗歌成熟的音乐旋律美。",
    "start": 1169.608,
    "end": 1174.488,
    "duration": 4.88
  },
  {
    "id": 285,
    "text": "第五步是“中和范式”，以“思无邪”与“发乎情止乎礼义”，",
    "start": 1174.488,
    "end": 1178.968,
    "duration": 4.48
  },
  {
    "id": 286,
    "text": "阐明理性节制与哀而不伤的崇高文化品格。",
    "start": 1178.968,
    "end": 1182.648,
    "duration": 3.68
  },
  {
    "id": 287,
    "text": "第六步是“史学闭环”，把《诗经》的风雅精神自然延伸至汉乐府、",
    "start": 1183.016,
    "end": 1188.696,
    "duration": 5.68
  },
  {
    "id": 288,
    "text": "建安骨力与杜甫、白居易的现实主义巨流。",
    "start": 1188.696,
    "end": 1192.296,
    "duration": 3.6
  },
  {
    "id": 289,
    "text": "这六步层层递进，前一步的结论必然成为后一步的前提。",
    "start": 1192.296,
    "end": 1196.936,
