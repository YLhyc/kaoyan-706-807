[
  {
    "id": 1,
    "text": "篇头：全题宏观破题与立论逻辑。",
    "start": 0.08,
    "end": 3.28,
    "duration": 3.2
  },
  {
    "id": 2,
    "text": "问题一：这道题到底在问什么？",
    "start": 3.28,
    "end": 6.08,
    "duration": 2.8
  },
  {
    "id": 3,
    "text": "这道题将“辛弃疾稼轩词的艺术成就”与“以文为词”紧密锚定在一起。",
    "start": 6.08,
    "end": 12.24,
    "duration": 6.16
  },
  {
    "id": 4,
    "text": "在考场上，考生绝不能泛泛罗列豪放诗句，",
    "start": 12.24,
    "end": 15.76,
    "duration": 3.52
  },
  {
    "id": 5,
    "text": "而必须深刻指出：辛弃疾作为“归正人”的英雄失路悲剧，",
    "start": 15.76,
    "end": 20.56,
    "duration": 4.8
  },
  {
    "id": 6,
    "text": "逼迫他必须突破传统词体的狭隘音律，",
    "start": 20.56,
    "end": 24.08,
    "duration": 3.52
  },
  {
    "id": 7,
    "text": "用散文经史的大笔墨来倾泻平生抱负。",
    "start": 24.08,
    "end": 27.28,
    "duration": 3.2
  },
  {
    "id": 8,
    "text": "“以文为词”正是其艺术成就集大成的核心机制。",
    "start": 27.44,
    "end": 31.877,
    "duration": 4.437
  },
  {
    "id": 9,
    "text": "问题二：宏观立论核心指向哪里？",
    "start": 31.877,
    "end": 34.912,
    "duration": 3.035
  },
  {
    "id": 10,
    "text": "立论核心必须紧扣“苏辛”词史脉络，",
    "start": 34.912,
    "end": 38.182,
    "duration": 3.27
  },
  {
    "id": 11,
    "text": "以及刘克庄在《辛稼轩集序》中对其词作的极高赞誉。",
    "start": 38.182,
    "end": 43.085,
    "duration": 4.903
  },
  {
    "id": 12,
    "text": "阐明辛弃疾将苏轼的以诗入词进一步推向以文为词，",
    "start": 43.085,
    "end": 48.223,
    "duration": 5.138
  },
  {
    "id": 13,
    "text": "完成了词体从音乐歌言向独立文体抒情的历史转变。",
    "start": 48.223,
    "end": 53.36,
    "duration": 5.137
  },
  {
    "id": 14,
    "text": "问题三：由浅入深拆解为哪几个答题维度？",
    "start": 53.44,
    "end": 57.28,
    "duration": 3.84
  },
  {
    "id": 15,
    "text": "本题按文学生成机制拆解为四个逻辑递进维度：第一维度，",
    "start": 57.28,
    "end": 61.84,
    "duration": 4.56
  },
  {
    "id": 16,
    "text": "身世底色与体制革新，从归正人英雄失路切入，",
    "start": 61.84,
    "end": 65.84,
    "duration": 4.0
  },
  {
    "id": 17,
    "text": "界定以文为词对艳科与拘束律调的打破。",
    "start": 65.84,
    "end": 69.6,
    "duration": 3.76
  },
  {
    "id": 18,
    "text": "第二维度，以文为词的句法与篇章，",
    "start": 69.6,
    "end": 72.48,
    "duration": 2.88
  },
  {
    "id": 19,
    "text": "剖析散文化句式、虚字呼应与波澜起伏的章法构造。",
    "start": 72.48,
    "end": 76.96,
    "duration": 4.48
  },
  {
    "id": 20,
    "text": "第三维度，用典艺术与经史入词，以《永遇乐•京口北固亭怀古》为代表，",
    "start": 77.2,
    "end": 83.2,
    "duration": 6.0
  },
  {
    "id": 21,
    "text": "深入阐述典故自况的历史纵深感。",
    "start": 83.2,
    "end": 86.0,
    "duration": 2.8
  },
  {
    "id": 22,
    "text": "第四维度，多元风格与美学境界，剖析雄奇豪放、",
    "start": 86.0,
    "end": 90.16,
    "duration": 4.16
  },
  {
    "id": 23,
    "text": "沉郁苍凉与幽默超脱的多元融合。",
    "start": 90.16,
    "end": 93.04,
    "duration": 2.88
  },
  {
    "id": 24,
    "text": "第五维度，文学史价值，总结其对南宋辛派词群的引领作用与崇高爱国品格的永恒价值。",
    "start": 93.04,
    "end": 100.0,
    "duration": 6.96
  },
  {
    "id": 25,
    "text": "问题四：各维度之间具备怎样不可逆的递进因果链条？",
    "start": 100.24,
    "end": 104.64,
    "duration": 4.4
  },
  {
    "id": 26,
    "text": "第一步必须由归正人特殊身世切入奠定全篇立论基调。",
    "start": 104.64,
    "end": 109.52,
    "duration": 4.88
  },
  {
    "id": 27,
    "text": "第二步阐明这种身世逼出的“以文为词”体裁体制突破。",
    "start": 109.52,
    "end": 114.24,
    "duration": 4.72
  },
  {
    "id": 28,
    "text": "第三步从宏观散文句法进一步深入到微观经史用典的精妙机制。",
    "start": 114.24,
    "end": 119.52,
    "duration": 5.28
  },
  {
    "id": 29,
    "text": "第四步由技法结构上升至词作的多元美学意境。",
    "start": 119.76,
    "end": 123.92,
    "duration": 4.16
  },
  {
    "id": 30,
    "text": "第五步跳出文本本身，在宋代词史演进与民族爱国精神维度完成宏观历史总结。",
    "start": 123.92,
    "end": 130.88,
    "duration": 6.96
  },
  {
    "id": 31,
    "text": "第一部分：破题立论与归正人身世悲剧。",
    "start": 130.88,
    "end": 134.48,
    "duration": 3.6
  },
  {
    "id": 32,
    "text": "逐句因果推导与答题表述。",
    "start": 134.48,
    "end": 136.96,
    "duration": 2.48
  },
  {
    "id": 33,
    "text": "为了开篇直击考点要害并确立学术基调，",
    "start": 136.96,
    "end": 140.72,
    "duration": 3.76
  },
  {
    "id": 34,
    "text": "第一句必须给出辛弃疾在豪放词史上的领袖地位与权威评价。",
    "start": 140.72,
    "end": 145.92,
    "duration": 5.2
  },
  {
    "id": 35,
    "text": "所以表述为：辛弃疾是南宋豪放派词人的杰出领袖与集大成者，",
    "start": 146.296,
    "end": 151.969,
    "duration": 5.673
  },
  {
    "id": 36,
    "text": "与北宋苏轼并称为“苏辛”。",
    "start": 151.969,
    "end": 154.174,
    "duration": 2.205
  },
  {
    "id": 37,
    "text": "紧接着必须点明其区别于普通南宋士大夫的特殊身份，",
    "start": 154.174,
    "end": 159.245,
    "duration": 5.071
  },
  {
    "id": 38,
    "text": "展现其投笔从戎的军事实践。",
    "start": 159.245,
    "end": 161.891,
    "duration": 2.646
  },
  {
    "id": 39,
    "text": "所以表述为：作为南渡“归正人”，",
    "start": 161.891,
    "end": 164.537,
    "duration": 2.646
  },
  {
    "id": 40,
    "text": "辛弃疾青年时期曾亲率五十骑突袭敌营生擒叛将，",
    "start": 164.537,
    "end": 169.168,
    "duration": 4.631
  },
  {
    "id": 41,
    "text": "具备极高的军事天才与抗金复国之志。",
    "start": 169.168,
    "end": 172.696,
    "duration": 3.528
  },
  {
    "id": 42,
    "text": "随后必须交代其南归后政治受挫的悲剧遭遇，",
    "start": 172.856,
    "end": 176.616,
    "duration": 3.76
  },
  {
    "id": 43,
    "text": "说明其强大精神苦闷的现实来源。",
    "start": 176.616,
    "end": 179.736,
    "duration": 3.12
  },
  {
    "id": 44,
    "text": "所以表述为：南归之后，他饱受南宋统治集团的猜忌排挤，",
    "start": 179.736,
    "end": 184.776,
    "duration": 5.04
  },
  {
    "id": 45,
    "text": "被迫落职闲居带湖与瓢泉二十载。",
    "start": 184.776,
    "end": 188.136,
    "duration": 3.36
  },
  {
    "id": 46,
    "text": "最后一句必须将身世悲剧与词史革新相咬合，",
    "start": 188.136,
    "end": 192.216,
    "duration": 4.08
  },
  {
    "id": 47,
    "text": "引申出题目要求的核心命题“以文为词”，",
    "start": 192.216,
    "end": 195.816,
    "duration": 3.6
  },
  {
    "id": 48,
    "text": "完成破题。",
    "start": 195.816,
    "end": 196.616,
    "duration": 0.8
  },
  {
    "id": 49,
    "text": "所以表述为：沉重的英雄失路之悲与狂放的政治抱负激烈撞击，",
    "start": 196.856,
    "end": 202.776,
    "duration": 5.92
  },
  {
    "id": 50,
    "text": "促使他继承并极大发展了苏轼“以诗入词”的传统，",
    "start": 202.776,
    "end": 207.176,
    "duration": 4.4
  },
  {
    "id": 51,
    "text": "创造性地开辟了“以文为词”的宏大审美格局，",
    "start": 207.176,
    "end": 210.856,
    "duration": 3.68
  },
  {
    "id": 52,
    "text": "将宋词的思想意蕴与艺术表现力推向了最高峰。",
    "start": 210.856,
    "end": 214.856,
    "duration": 4.0
  },
  {
    "id": 53,
    "text": "本段答题思路总结。",
    "start": 214.856,
    "end": 216.296,
    "duration": 1.44
  },
  {
    "id": 54,
    "text": "本段用四句话完成全篇破题：首句给出苏辛并称与豪放集大成者地位，",
    "start": 216.616,
    "end": 223.016,
    "duration": 6.4
  },
  {
    "id": 55,
    "text": "次句指出归正人与五十骑突袭的英雄底色，",
    "start": 223.016,
    "end": 226.536,
    "duration": 3.52
  },
  {
    "id": 56,
    "text": "第三句交代落职闲居带湖瓢泉的政治悲剧，",
    "start": 226.536,
    "end": 229.976,
    "duration": 3.44
  },
  {
    "id": 57,
    "text": "末句自然引渡至以文为词的最高成就，",
    "start": 229.976,
    "end": 233.096,
    "duration": 3.12
  },
  {
    "id": 58,
    "text": "立意深沉高远。",
    "start": 233.096,
    "end": 234.456,
    "duration": 1.36
  },
  {
    "id": 59,
    "text": "所以本段具体答题完整版为：辛弃疾是南宋豪放派词人的杰出领袖与集大成者，",
    "start": 234.456,
    "end": 241.256,
    "duration": 6.8
  },
  {
    "id": 60,
    "text": "与北宋苏轼并称为“苏辛”。",
    "start": 241.256,
    "end": 243.896,
    "duration": 2.64
  },
  {
    "id": 61,
    "text": "作为南渡“归正人”，辛弃疾青年时期曾亲率五十骑突袭敌营生擒叛将，",
    "start": 243.896,
    "end": 250.616,
    "duration": 6.72
  },
  {
    "id": 62,
    "text": "具备极高的军事天才与抗金复国之志。",
    "start": 250.616,
    "end": 254.376,
    "duration": 3.76
  },
  {
    "id": 63,
    "text": "南归之后，他饱受南宋统治集团的猜忌排挤，",
    "start": 254.376,
    "end": 258.376,
    "duration": 4.0
  },
  {
    "id": 64,
    "text": "被迫落职闲居带湖与瓢泉二十载。",
    "start": 258.376,
    "end": 261.416,
    "duration": 3.04
  },
  {
    "id": 65,
    "text": "沉重的英雄失路之悲与狂放的政治抱负激烈撞击，",
    "start": 261.736,
    "end": 266.616,
    "duration": 4.88
  },
  {
    "id": 66,
    "text": "促使他继承并极大发展了苏轼“以诗入词”的传统，",
    "start": 266.616,
    "end": 271.096,
    "duration": 4.48
  },
  {
    "id": 67,
    "text": "创造性地开辟了“以文为词”的宏大审美格局，",
    "start": 271.096,
    "end": 275.256,
    "duration": 4.16
  },
  {
    "id": 68,
    "text": "将宋词的思想意蕴与艺术表现力推向了最高峰。",
    "start": 275.256,
    "end": 279.336,
    "duration": 4.08
  },
  {
    "id": 69,
    "text": "第二部分：以文为词的体制突破与散文化句法。",
    "start": 279.336,
    "end": 283.656,
    "duration": 4.32
  },
  {
    "id": 70,
    "text": "逐句因果推导与答题表述。",
    "start": 283.896,
    "end": 286.296,
    "duration": 2.4
  },
  {
    "id": 71,
    "text": "进入具体论述的第一层，必须准确界定“以文为词”在文体学上的革命性意义。",
    "start": 286.296,
    "end": 292.296,
    "duration": 6.0
  },
  {
    "id": 72,
    "text": "所以表述为：首先，“以文为词”彻底打破了传统词体作为“艳科”的狭隘藩篱，",
    "start": 292.592,
    "end": 298.832,
    "duration": 6.24
  },
  {
    "id": 73,
    "text": "在体制与句法上实现了深度的散文化革新。",
    "start": 298.832,
    "end": 302.592,
    "duration": 3.76
  },
  {
    "id": 74,
    "text": "随后需要剖析这种革新的技术路径，",
    "start": 302.592,
    "end": 305.392,
    "duration": 2.8
  },
  {
    "id": 75,
    "text": "说明作者是如何将散文结构移植到词中的。",
    "start": 305.392,
    "end": 308.752,
    "duration": 3.36
  },
  {
    "id": 76,
    "text": "所以表述为：辛弃疾打破了音律与格律的严密束缚，",
    "start": 308.752,
    "end": 312.912,
    "duration": 4.16
  },
  {
    "id": 77,
    "text": "大胆将散文的篇章结构、经史论说与虚字呼应直接植入词作之中。",
    "start": 312.912,
    "end": 318.192,
    "duration": 5.28
  },
  {
    "id": 78,
    "text": "接着进一步分析其句法层面的活跃变化，",
    "start": 318.512,
    "end": 322.032,
    "duration": 3.52
  },
  {
    "id": 79,
    "text": "展现其摆脱声律束缚的自由与开河。",
    "start": 322.032,
    "end": 325.152,
    "duration": 3.12
  },
  {
    "id": 80,
    "text": "所以表述为：他大量运用设问、反诘与长短相建的生活口语，",
    "start": 325.152,
    "end": 330.592,
    "duration": 5.44
  },
  {
    "id": 81,
    "text": "使词的表达如行云流水般自由磅礴。",
    "start": 330.592,
    "end": 334.032,
    "duration": 3.44
  },
  {
    "id": 82,
    "text": "论点提出后必须立刻调取极具考场辨识度的《水龙吟》经典动作细节作为铁证。",
    "start": 334.032,
    "end": 339.952,
    "duration": 5.92
  },
  {
    "id": 83,
    "text": "所以表述为：《水龙吟•登建康赏心亭》中“把吴钩看了，",
    "start": 340.352,
    "end": 345.152,
    "duration": 4.8
  },
  {
    "id": 84,
    "text": "栏杆拍遍，无人会，登临意”，以极具散文化力度的动作连缀，",
    "start": 345.152,
    "end": 350.192,
    "duration": 5.04
  },
  {
    "id": 85,
    "text": "传达出英雄无用武之地的极度愤懑。",
    "start": 350.192,
    "end": 353.472,
    "duration": 3.28
  },
  {
    "id": 86,
    "text": "为了避免孤证，补充《摸鱼儿》的层层设问手法，",
    "start": 353.472,
    "end": 356.912,
    "duration": 3.44
  },
  {
    "id": 87,
    "text": "展现其沉郁多姿的散文结构。",
    "start": 356.912,
    "end": 359.072,
    "duration": 2.16
  },
  {
    "id": 88,
    "text": "所以表述为：《摸鱼儿》起首以“更能消几番风雨，",
    "start": 359.392,
    "end": 363.552,
    "duration": 4.16
  },
  {
    "id": 89,
    "text": "匆匆春又归去”的层层盘旋设问，借惜春之情寄寓对国势衰微的深沉忧患，",
    "start": 363.552,
    "end": 369.872,
    "duration": 6.32
  },
  {
    "id": 90,
    "text": "句法跌宕多姿。",
    "start": 369.872,
    "end": 371.152,
    "duration": 1.28
  },
  {
    "id": 91,
    "text": "本段答题思路总结。",
    "start": 371.152,
    "end": 372.672,
    "duration": 1.52
  },
  {
    "id": 92,
    "text": "本段透彻剖析以文为词的体制革新：从打破艳科与散文化界定起笔，",
    "start": 372.672,
    "end": 378.592,
    "duration": 5.92
  },
  {
    "id": 93,
    "text": "深挖虚字呼应与论说入词的机制，连出《水龙吟》把吴钩看了的动作连贯与《摸鱼儿》层层盘旋设问两大典型，",
    "start": 378.592,
    "end": 387.392,
    "duration": 8.8
  },
  {
    "id": 94,
    "text": "论证极其雄辩。",
    "start": 387.392,
    "end": 388.752,
    "duration": 1.36
  },
  {
    "id": 95,
    "text": "所以本段具体答题完整版为：首先，",
    "start": 388.752,
    "end": 391.68,
    "duration": 2.928
  },
  {
    "id": 96,
    "text": "“以文为词”彻底打破了传统词体作为“艳科”的狭隘藩篱，",
    "start": 391.68,
    "end": 396.72,
    "duration": 5.04
  },
  {
    "id": 97,
    "text": "在体制与句法上实现了深度的散文化革新。",
    "start": 396.72,
    "end": 400.64,
    "duration": 3.92
  },
  {
    "id": 98,
    "text": "辛弃疾打破了音律与格律的严密束缚，",
    "start": 400.64,
    "end": 404.0,
    "duration": 3.36
  },
  {
    "id": 99,
    "text": "大胆将散文的篇章结构、经史论说与虚字呼应直接植入词作之中。",
    "start": 404.0,
    "end": 409.76,
    "duration": 5.76
  },
  {
    "id": 100,
    "text": "他大量运用设问、反诘与长短相建的生活口语，",
    "start": 409.76,
    "end": 414.0,
    "duration": 4.24
  },
  {
    "id": 101,
    "text": "使词的表达如行云流水般自由磅礴。",
    "start": 414.0,
    "end": 417.12,
    "duration": 3.12
  },
  {
    "id": 102,
    "text": "《水龙吟•登建康赏心亭》中“把吴钩看了，",
    "start": 417.28,
    "end": 420.68,
    "duration": 3.4
  },
  {
    "id": 103,
    "text": "栏杆拍遍，无人会，登临意”，以极具散文化力度的动作连缀，",
    "start": 420.68,
    "end": 425.893,
    "duration": 5.213
  },
  {
    "id": 104,
    "text": "传达出英雄无用武之地的极度愤懑。",
    "start": 425.893,
    "end": 429.293,
    "duration": 3.4
  },
  {
    "id": 105,
    "text": "《摸鱼儿》起首以“更能消几番风雨，",
    "start": 429.293,
    "end": 432.24,
    "duration": 2.947
  },
  {
    "id": 106,
    "text": "匆匆春又归去”的层层盘旋设问，借惜春之情寄寓对国势衰微的深沉忧患，",
    "start": 432.24,
    "end": 439.04,
    "duration": 6.8
  },
  {
    "id": 107,
    "text": "句法跌宕多姿。",
    "start": 439.04,
    "end": 440.4,
    "duration": 1.36
  },
  {
    "id": 108,
    "text": "第三部分：典故熔铸与经史入词的历史纵深。",
    "start": 440.48,
    "end": 444.8,
    "duration": 4.32
  },
  {
    "id": 109,
    "text": "逐句因果推导与答题表述。",
    "start": 444.8,
    "end": 447.36,
    "duration": 2.56
  },
  {
    "id": 110,
    "text": "分析辛词艺术绝不能绕过其惊世骇俗的用典艺术，",
    "start": 447.36,
    "end": 452.16,
    "duration": 4.8
  },
  {
    "id": 111,
    "text": "首句必须立即给出用典在稼轩词中的核心地位与高度。",
    "start": 452.16,
    "end": 457.12,
    "duration": 4.96
  },
  {
    "id": 112,
    "text": "所以表述为：其次，辛弃疾在创作中实现了典故的大规模融铸，",
    "start": 457.12,
    "end": 462.96,
    "duration": 5.84
  },
  {
    "id": 113,
    "text": "达到了“经史百家无所不用”的化境。",
    "start": 462.96,
    "end": 465.84,
    "duration": 2.88
  },
  {
    "id": 114,
    "text": "紧接着必须引入南宋大批评家刘克庄的权威定论，",
    "start": 466.16,
    "end": 470.08,
    "duration": 3.92
  },
  {
    "id": 115,
    "text": "夯实学术论述底色。",
    "start": 470.08,
    "end": 471.68,
    "duration": 1.6
  },
  {
    "id": 116,
    "text": "所以表述为：刘克庄在《辛稼轩集序》中盛赞其词作才气超拔。",
    "start": 471.68,
    "end": 477.44,
    "duration": 5.76
  },
  {
    "id": 117,
    "text": "随后深刻辨析其用典与普通堆砌典故的本质区别，",
    "start": 477.44,
    "end": 481.44,
    "duration": 4.0
  },
  {
    "id": 118,
    "text": "说明其以古况今的心灵化机制。",
    "start": 481.44,
    "end": 484.08,
    "duration": 2.64
  },
  {
    "id": 119,
    "text": "所以表述为：辛词用典绝非盲目堆砌前人陈迹，",
    "start": 484.4,
    "end": 489.28,
    "duration": 4.88
  },
  {
    "id": 120,
    "text": "而是将历史典故与自身现实境遇高度融为一体。",
    "start": 489.28,
    "end": 493.2,
    "duration": 3.92
  },
  {
    "id": 121,
    "text": "接着必须搬出全书乃至文学史公认的用典巅峰名篇进行深度解剖。",
    "start": 493.2,
    "end": 499.04,
    "duration": 5.84
  },
  {
    "id": 122,
    "text": "所以表述为：《永遇乐•京口北固亭怀古》是其用典艺术的巅峰之作。",
    "start": 499.04,
    "end": 504.56,
    "duration": 5.52
  },
  {
    "id": 123,
    "text": "随后详细梳理词中五大历史典故的层层排布，",
    "start": 504.96,
    "end": 509.04,
    "duration": 4.08
  },
  {
    "id": 124,
    "text": "展现历史时空的交错辉映。",
    "start": 509.04,
    "end": 511.52,
    "duration": 2.48
  },
  {
    "id": 125,
    "text": "所以表述为：全词熔铸了孙仲谋、刘裕、",
    "start": 511.52,
    "end": 514.8,
    "duration": 3.28
  },
  {
    "id": 126,
    "text": "刘义隆、拓跋焘与廉颇五大历史人物典故。",
    "start": 514.8,
    "end": 518.56,
    "duration": 3.76
  },
  {
    "id": 127,
    "text": "接着点出作者用典的现实批判指向，",
    "start": 518.56,
    "end": 521.52,
    "duration": 2.96
  },
  {
    "id": 128,
    "text": "展现以古鉴今的政治智慧。",
    "start": 521.52,
    "end": 523.52,
    "duration": 2.0
  },
  {
    "id": 129,
    "text": "所以表述为：作者借刘义隆“赢得仓皇北顾”的史实，",
    "start": 523.84,
    "end": 528.08,
    "duration": 4.24
  },
  {
    "id": 130,
    "text": "深刻告诫当权者切勿草率北伐。",
    "start": 528.08,
    "end": 531.04,
    "duration": 2.96
  },
  {
    "id": 131,
    "text": "尾句以词末廉颇老矣的反问作结，将典故与作者自身悲剧命运的合一升华至极点。",
    "start": 531.04,
    "end": 537.76,
    "duration": 6.72
  },
  {
    "id": 132,
    "text": "所以表述为：结尾更以“凭谁问：廉颇老矣，",
    "start": 538.144,
    "end": 541.824,
    "duration": 3.68
  },
  {
    "id": 133,
    "text": "尚能饭否”的沉痛反问，将一腔报国无门的暮年悲慨托盘而出，",
    "start": 541.824,
    "end": 547.424,
    "duration": 5.6
  },
  {
    "id": 134,
    "text": "使词作具备了极其厚重的史诗质感。",
    "start": 547.424,
    "end": 550.944,
    "duration": 3.52
  },
  {
    "id": 135,
    "text": "本段答题思路总结。",
    "start": 550.944,
    "end": 553.024,
    "duration": 2.08
  },
  {
    "id": 136,
    "text": "本段深刻剖析辛词的典故熔铸艺术：引入刘克庄名评定性，",
    "start": 553.024,
    "end": 558.544,
    "duration": 5.52
  },
  {
    "id": 137,
    "text": "阐明用典与自身境遇的合一，精细拆解《永遇乐》京口怀古五大人物典故，",
    "start": 558.544,
    "end": 564.784,
    "duration": 6.24
  },
  {
    "id": 138,
    "text": "解构仓皇北顾的现实告诫与廉颇老矣的暮年悲慨，",
    "start": 564.784,
    "end": 569.104,
    "duration": 4.32
  },
  {
    "id": 139,
    "text": "极具考场得分说服力。",
    "start": 569.104,
    "end": 570.704,
    "duration": 1.6
  },
  {
    "id": 140,
    "text": "所以本段具体答题完整版为：其次，",
    "start": 571.024,
    "end": 574.144,
    "duration": 3.12
  },
  {
    "id": 141,
    "text": "辛弃疾在创作中实现了典故的大规模融铸，",
    "start": 574.144,
    "end": 577.904,
    "duration": 3.76
  },
  {
    "id": 142,
    "text": "达到了“经史百家无所不用”的化境。",
    "start": 577.904,
    "end": 581.184,
    "duration": 3.28
  },
  {
    "id": 143,
    "text": "刘克庄在《辛稼轩集序》中盛赞其词作才气超拔。",
    "start": 581.184,
    "end": 585.584,
    "duration": 4.4
  },
  {
    "id": 144,
    "text": "辛词用典绝非盲目堆砌前人陈迹，而是将历史典故与自身现实境遇高度融为一体。",
    "start": 585.584,
    "end": 592.544,
    "duration": 6.96
  },
  {
    "id": 145,
    "text": "《永遇乐•京口北固亭怀古》是其用典艺术的巅峰之作。",
    "start": 592.704,
    "end": 596.911,
    "duration": 4.207
  },
  {
    "id": 146,
    "text": "全词熔铸了孙仲谋、刘裕、刘义隆、",
    "start": 596.911,
    "end": 599.515,
    "duration": 2.604
  },
  {
    "id": 147,
    "text": "拓跋焘与廉颇五大历史人物典故。",
    "start": 599.515,
    "end": 602.319,
    "duration": 2.804
  },
  {
    "id": 148,
    "text": "作者借刘义隆“赢得仓皇北顾”的史实，",
    "start": 602.319,
    "end": 605.324,
    "duration": 3.005
  },
  {
    "id": 149,
    "text": "深刻告诫当权者切勿草率北伐。",
    "start": 605.324,
    "end": 607.928,
    "duration": 2.604
  },
  {
    "id": 150,
    "text": "结尾更以“凭谁问：廉颇老矣，尚能饭否”的沉痛反问，",
    "start": 607.928,
    "end": 611.934,
    "duration": 4.006
  },
  {
    "id": 151,
    "text": "将一腔报国无门的暮年悲慨托盘而出，",
    "start": 611.934,
    "end": 615.139,
    "duration": 3.205
  },
  {
    "id": 152,
    "text": "使词作具备了极其厚重的史诗质感。",
    "start": 615.139,
    "end": 618.144,
    "duration": 3.005
  },
  {
    "id": 153,
    "text": "第四部分：雄奇豪放与沉郁悲壮的多元意境。",
    "start": 618.224,
    "end": 622.304,
    "duration": 4.08
  },
  {
    "id": 154,
    "text": "逐句因果推导与答题表述。",
    "start": 622.304,
    "end": 624.704,
    "duration": 2.4
  },
  {
    "id": 155,
    "text": "在剖析完体制与技法后，论述必须上升到美学风格的多元光谱，",
    "start": 624.704,
    "end": 629.904,
    "duration": 5.2
  },
  {
    "id": 156,
    "text": "首句统摄其多元交融的特征。",
    "start": 629.904,
    "end": 632.464,
    "duration": 2.56
  },
  {
    "id": 157,
    "text": "所以表述为：再次，在风格意境上，",
    "start": 632.464,
    "end": 635.664,
    "duration": 3.2
  },
  {
    "id": 158,
    "text": "稼轩词融雄奇豪放、沉郁苍凉与幽默挥谐于一体，",
    "start": 635.664,
    "end": 640.544,
    "duration": 4.88
  },
  {
    "id": 159,
    "text": "呈现出极为多元的美学光谱。",
    "start": 640.544,
    "end": 642.624,
    "duration": 2.08
  },
  {
    "id": 160,
    "text": "随后立刻调取其豪放词的代表作，展现沙场梦境与残酷现实的断崖式跌落。",
    "start": 643.024,
    "end": 649.344,
    "duration": 6.32
  },
  {
    "id": 161,
    "text": "所以表述为：《破阵子•为陈同甫赋壮词以寄之》中“醉里挑灯看剑，",
    "start": 649.344,
    "end": 655.504,
    "duration": 6.16
  },
  {
    "id": 162,
    "text": "梦回吹角连营”，以排山倒海之势再现沙场壮景，",
    "start": 655.504,
    "end": 659.664,
    "duration": 4.16
  },
  {
    "id": 163,
    "text": "末句“可怜白发生”陡然跌落，形成极强的情感张力。",
    "start": 659.664,
    "end": 663.984,
    "duration": 4.32
  },
  {
    "id": 164,
    "text": "为了打破单调的豪放标签，补充其闲居期间物我相对的傲岸哲思。",
    "start": 664.224,
    "end": 670.304,
    "duration": 6.08
  },
  {
    "id": 165,
    "text": "所以表述为：《贺新郎》中“我见青山多五媚，",
    "start": 670.304,
    "end": 674.304,
    "duration": 4.0
  },
  {
    "id": 166,
    "text": "料青山见我应如是”，展现出物我相视的超拔傲岸。",
    "start": 674.304,
    "end": 678.864,
    "duration": 4.56
  },
  {
    "id": 167,
    "text": "进一步补充其充满生活情趣的田园词作，",
    "start": 678.864,
    "end": 682.384,
    "duration": 3.52
  },
  {
    "id": 168,
    "text": "印证其胸怀的博大与真率。",
    "start": 682.384,
    "end": 684.544,
    "duration": 2.16
  },
  {
    "id": 169,
    "text": "所以表述为：《清平乐•村居》则以白描展现乡村温情。",
    "start": 684.928,
    "end": 689.203,
    "duration": 4.275
  },
  {
    "id": 170,
    "text": "尾句对这种多元风格背后的崇高人格进行就地总结。",
    "start": 689.203,
    "end": 693.968,
    "duration": 4.765
  },
  {
    "id": 171,
    "text": "所以表述为：这种刚柔并济的意境创造，",
    "start": 693.968,
    "end": 697.433,
    "duration": 3.465
  },
  {
    "id": 172,
    "text": "彰显出词人博大深沉的精神境界。",
    "start": 697.433,
    "end": 700.466,
    "duration": 3.033
  },
  {
    "id": 173,
    "text": "本段答题思路总结。",
    "start": 700.466,
    "end": 702.198,
    "duration": 1.732
  },
  {
    "id": 174,
    "text": "本段全面展现稼轩词的多元美学风格：先立定多元光谱总纲，",
    "start": 702.198,
    "end": 707.613,
    "duration": 5.415
  },
  {
    "id": 175,
    "text": "接着用《破阵子》挑灯看剑与白发跌落展现悲壮豪放，",
    "start": 707.613,
    "end": 712.161,
    "duration": 4.548
  },
  {
    "id": 176,
    "text": "用《贺新郎》见青山展现孤高自赏，",
    "start": 712.161,
    "end": 714.977,
    "duration": 2.816
  },
  {
    "id": 177,
    "text": "用《清平乐》展现田园温情，充分体现出考生对辛词全貌的驾驭力。",
    "start": 714.977,
    "end": 720.608,
    "duration": 5.631
  },
  {
    "id": 178,
    "text": "所以本段具体答题完整版为：再次，",
    "start": 720.768,
    "end": 724.208,
    "duration": 3.44
  },
  {
    "id": 179,
    "text": "在风格意境上，稼轩词融雄奇豪放、",
    "start": 724.208,
    "end": 727.808,
    "duration": 3.6
  },
  {
    "id": 180,
    "text": "沉郁苍凉与幽默挥谐于一体，呈现出极为多元的美学光谱。",
    "start": 727.808,
    "end": 733.328,
    "duration": 5.52
  },
  {
    "id": 181,
    "text": "《破阵子•为陈同甫赋壮词以寄之》中“醉里挑灯看剑，",
    "start": 733.328,
    "end": 738.368,
    "duration": 5.04
  },
  {
    "id": 182,
    "text": "梦回吹角连营”，以排山倒海之势再现沙场壮景，",
    "start": 738.368,
    "end": 742.688,
    "duration": 4.32
  },
  {
    "id": 183,
    "text": "末句“可怜白发生”陡然跌落，形成极强的情感张力。",
    "start": 742.688,
    "end": 747.088,
    "duration": 4.4
  },
  {
    "id": 184,
    "text": "《贺新郎》中“我见青山多五媚，料青山见我应如是”，",
    "start": 747.328,
    "end": 751.661,
    "duration": 4.333
  },
  {
    "id": 185,
    "text": "展现出物我相视的超拔傲岸。",
    "start": 751.661,
    "end": 754.397,
    "duration": 2.736
  },
  {
    "id": 186,
    "text": "《清平乐•村居》则以白描展现乡村温情。",
    "start": 754.397,
    "end": 757.818,
    "duration": 3.421
  },
  {
    "id": 187,
    "text": "这种刚柔并济的意境创造，彰显出词人博大深沉的精神境界。",
    "start": 757.818,
    "end": 763.519,
    "duration": 5.701
  },
  {
    "id": 188,
    "text": "第五部分：总结升华与文学史巅峰价值。",
    "start": 763.519,
    "end": 767.168,
    "duration": 3.649
  },
  {
    "id": 189,
    "text": "逐句因果推导与答题表述。",
    "start": 767.248,
    "end": 769.728,
    "duration": 2.48
  },
  {
    "id": 190,
    "text": "经过以上四个维度的纵深展开，结尾段必须跳出个案本身，",
    "start": 769.728,
    "end": 774.528,
    "duration": 4.8
  },
  {
    "id": 191,
    "text": "在宋代词史演进与爱国精神传承中完成全篇立论升华。",
    "start": 774.528,
    "end": 779.728,
    "duration": 5.2
  },
  {
    "id": 192,
    "text": "所以表述为：最后，辛弃疾的稼轩词不仅推动了宋代词体演进的重大变革，",
    "start": 779.728,
    "end": 786.048,
    "duration": 6.32
  },
  {
    "id": 193,
    "text": "更直接催生了南宋辛派爱国词群。",
    "start": 786.048,
    "end": 788.768,
    "duration": 2.72
  },
  {
    "id": 194,
    "text": "最后一句必须将纯文学技法升华至中华民族的人格精神支柱，",
    "start": 789.088,
    "end": 793.728,
    "duration": 4.64
  },
  {
    "id": 195,
    "text": "完成大题圆满闭环。",
    "start": 793.728,
    "end": 795.328,
    "duration": 1.6
  },
  {
    "id": 196,
    "text": "所以表述为：他以文为词的大胆拓荒精神与深沉炽热的爱国主义精魂，",
    "start": 795.328,
    "end": 800.848,
    "duration": 5.52
  },
  {
    "id": 197,
    "text": "为后世树立了崇高的人格风范，成为中华民族文学史中无可替代的精神灯塔。",
    "start": 800.848,
    "end": 806.768,
    "duration": 5.92
  },
  {
    "id": 198,
    "text": "本段答题思路总结。",
    "start": 807.008,
    "end": 808.768,
    "duration": 1.76
  },
  {
    "id": 199,
    "text": "本段两句话干脆利落地完成大题闭环：首句立定词体演进的深刻蜕变与辛派爱国词群奠基者地位，",
    "start": 808.768,
    "end": 816.448,
    "duration": 7.68
  },
  {
    "id": 200,
    "text": "末句以文为词拓荒精神与爱国精魂升华至民族精神灯塔高度，",
    "start": 816.448,
    "end": 821.728,
    "duration": 5.28
  },
  {
    "id": 201,
    "text": "文气贯通，气象万千。",
    "start": 821.728,
    "end": 823.808,
    "duration": 2.08
  },
  {
    "id": 202,
    "text": "所以本段具体答题完整版为：最后，",
    "start": 823.808,
    "end": 826.832,
    "duration": 3.024
  },
  {
    "id": 203,
    "text": "辛弃疾的稼轩词不仅推动了宋代词体演进的重大变革，",
    "start": 826.832,
    "end": 831.952,
    "duration": 5.12
  },
  {
    "id": 204,
    "text": "更直接催生了南宋辛派爱国词群。",
    "start": 831.952,
    "end": 834.992,
    "duration": 3.04
  },
  {
    "id": 205,
    "text": "他以文为词的大胆拓荒精神与深沉炽热的爱国主义精魂，",
    "start": 834.992,
    "end": 839.952,
    "duration": 4.96
  },
  {
    "id": 206,
    "text": "为后世树立了崇高的人格风范，成为中华民族文学史中无可替代的精神灯塔。",
    "start": 839.952,
    "end": 846.192,
    "duration": 6.24
  },
  {
    "id": 207,
    "text": "篇尾：整道大题的内在逻辑链总括。",
    "start": 846.432,
    "end": 849.232,
    "duration": 2.8
  },
  {
    "id": 208,
    "text": "为了便于考生在脑海中建立极速调取机制，",
    "start": 849.232,
    "end": 852.512,
    "duration": 3.28
  },
  {
    "id": 209,
    "text": "整道大题的论证逻辑可提炼为如下不可逆的六步链条：一、",
    "start": 852.512,
    "end": 857.472,
    "duration": 4.96
  },
  {
    "id": 210,
    "text": "身世定性：开篇直接以苏辛并称与归正人英雄失路定性，",
    "start": 857.472,
    "end": 862.512,
    "duration": 5.04
  },
  {
    "id": 211,
    "text": "确立政治悲剧逼出以文为词的核心逻辑。",
    "start": 862.512,
    "end": 865.472,
    "duration": 2.96
  },
  {
    "id": 212,
    "text": "二、体制革新：打破艳科与律调拘束，",
    "start": 865.872,
    "end": 869.552,
    "duration": 3.68
  },
  {
    "id": 213,
    "text": "运用散文篇章结构与虚字呼应，以《水龙吟》《摸鱼儿》展现散文化句法。",
    "start": 869.552,
    "end": 876.032,
    "duration": 6.48
  },
  {
    "id": 214,
    "text": "三、经史入词：标举刘克庄无所不用名评，",
    "start": 876.032,
    "end": 879.952,
    "duration": 3.92
  },
  {
    "id": 215,
    "text": "剖析以古况今机制，以《永遇乐》五大典故与廉颇反问展厚重史诗质感。",
    "start": 879.952,
    "end": 885.792,
    "duration": 5.84
  },
  {
    "id": 216,
    "text": "四、多元意境：突破单一标签，以《破阵子》展悲壮豪放，",
    "start": 886.112,
    "end": 891.232,
    "duration": 5.12
  },
  {
    "id": 217,
    "text": "以《贺新郎》展孤傲物我，以《村居》展田园温情。",
    "start": 891.232,
    "end": 895.152,
    "duration": 3.92
  },
  {
    "id": 218,
    "text": "五、流派引领：纵向打通南宋词史脉络，",
    "start": 895.152,
    "end": 899.072,
    "duration": 3.92
  },
  {
    "id": 219,
    "text": "指出其不仅完成了词体演进蜕变，更催生了陈亮、",
    "start": 899.072,
    "end": 903.232,
    "duration": 4.16
  },
  {
    "id": 220,
    "text": "刘过等辛派爱国词群。",
    "start": 903.232,
    "end": 905.072,
    "duration": 1.84
  },
  {
    "id": 221,
    "text": "六、精神闭环：升华至民族爱国主义精魂与崇高人格风范，",
    "start": 905.312,
    "end": 910.432,
    "duration": 5.12
  },
  {
    "id": 222,
    "text": "完成作为中国古典文学精神灯塔的历史闭环。",
    "start": 910.432,
    "end": 913.872,
    "duration": 3.44
  }
]