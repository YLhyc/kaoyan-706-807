[
  {
    "id": 1,
    "text": "篇头：全题宏观破题与立论逻辑。",
    "start": 0.08,
    "end": 3.28,
    "duration": 3.2
  },
  {
    "id": 2,
    "text": "问题一：这道题到底在问什么？。",
    "start": 3.28,
    "end": 6.08,
    "duration": 2.8
  },
  {
    "id": 3,
    "text": "这道题将“辛弃疾稼轩词的艺术成就”与“以文为词”紧密锚定在一起。",
    "start": 6.08,
    "end": 12.24,
    "duration": 6.16
  },
  {
    "id": 4,
    "text": "在考场上，考生绝不能泛泛罗列豪放诗句，",
    "start": 12.24,
    "end": 15.76,
    "duration": 3.52
  },
  {
    "id": 5,
    "text": "而必须深刻指出：辛弃疾作为“归正人”的英雄失路悲剧，",
    "start": 15.76,
    "end": 20.56,
    "duration": 4.8
  },
  {
    "id": 6,
    "text": "逼迫他必须突破传统词体的狭隘音律，",
    "start": 20.56,
    "end": 24.08,
    "duration": 3.52
  },
  {
    "id": 7,
    "text": "用散文经史的大笔墨来倾泻平生抱负。",
    "start": 24.08,
    "end": 27.28,
    "duration": 3.2
  },
  {
    "id": 8,
    "text": "“以文为词”正是其艺术成就集大成的核心机制。",
    "start": 27.44,
    "end": 31.904,
    "duration": 4.464
  },
  {
    "id": 9,
    "text": "问题二：宏观立论核心指向哪里？。",
    "start": 31.904,
    "end": 34.959,
    "duration": 3.055
  },
  {
    "id": 10,
    "text": "立论核心必须紧扣“苏辛”词史脉络，",
    "start": 34.959,
    "end": 38.248,
    "duration": 3.289
  },
  {
    "id": 11,
    "text": "以及刘克庄在《辛稼轩集序》中对其词作的极高赞誉。",
    "start": 38.248,
    "end": 43.182,
    "duration": 4.934
  },
  {
    "id": 12,
    "text": "阐明辛弃疾将苏轼的以诗入词进一步推向以文为词，",
    "start": 43.182,
    "end": 48.351,
    "duration": 5.169
  },
  {
    "id": 13,
    "text": "完成了词体从音乐歌言向独立文体抒情的历史转变。",
    "start": 48.351,
    "end": 53.52,
    "duration": 5.169
  },
  {
    "id": 14,
    "text": "问题三：由浅入深拆解为哪几个答题维度？。",
    "start": 53.6,
    "end": 57.44,
    "duration": 3.84
  },
  {
    "id": 15,
    "text": "本题按文学生成机制拆解为四个逻辑递进维度：第一维度，",
    "start": 57.44,
    "end": 62.0,
    "duration": 4.56
  },
  {
    "id": 16,
    "text": "身世底色与体制革新，从归正人英雄失路切入，",
    "start": 62.0,
    "end": 66.0,
    "duration": 4.0
  },
  {
    "id": 17,
    "text": "界定以文为词对艳科与拘束律调的打破。",
    "start": 66.0,
    "end": 69.76,
    "duration": 3.76
  },
  {
    "id": 18,
    "text": "第二维度，以文为词的句法与篇章，",
    "start": 69.76,
    "end": 72.72,
    "duration": 2.96
  },
  {
    "id": 19,
    "text": "剖析散文化句式、虚字呼应与波澜起伏的章法构造。",
    "start": 72.72,
    "end": 77.36,
    "duration": 4.64
  },
  {
    "id": 20,
    "text": "第三维度，用典艺术与经史入词，以《永遇乐•京口北固亭怀古》为代表，",
    "start": 77.6,
    "end": 83.6,
    "duration": 6.0
  },
  {
    "id": 21,
    "text": "深入阐述典故自况的历史纵深感。",
    "start": 83.6,
    "end": 86.4,
    "duration": 2.8
  },
  {
    "id": 22,
    "text": "第四维度，多元风格与美学境界，剖析雄奇豪放、",
    "start": 86.4,
    "end": 90.4,
    "duration": 4.0
  },
  {
    "id": 23,
    "text": "沉郁苍凉与幽默超脱的多元融合。",
    "start": 90.4,
    "end": 93.28,
    "duration": 2.88
  },
  {
    "id": 24,
    "text": "第五维度，文学史价值，总结其对南宋辛派词群的引领作用与崇高爱国品格的永恒价值。",
    "start": 93.28,
    "end": 100.64,
    "duration": 7.36
  },
  {
    "id": 25,
    "text": "问题四：各维度之间具备怎样不可逆的递进因果链条？。",
    "start": 100.96,
    "end": 105.36,
    "duration": 4.4
  },
  {
    "id": 26,
    "text": "第一步必须由归正人特殊身世切入奠定全篇立论基调。",
    "start": 105.36,
    "end": 110.24,
    "duration": 4.88
  },
  {
    "id": 27,
    "text": "第二步阐明这种身世逼出的“以文为词”体裁体制突破。",
    "start": 110.24,
    "end": 114.96,
    "duration": 4.72
  },
  {
    "id": 28,
    "text": "第三步从宏观散文句法进一步深入到微观经史用典的精妙机制。",
    "start": 114.96,
    "end": 120.24,
    "duration": 5.28
  },
  {
    "id": 29,
    "text": "第四步由技法结构上升至词作的多元美学意境。",
    "start": 120.48,
    "end": 124.48,
    "duration": 4.0
  },
  {
    "id": 30,
    "text": "第五步跳出文本本身，在宋代词史演进与民族爱国精神维度完成终极历史闭环。",
    "start": 124.48,
    "end": 131.44,
    "duration": 6.96
  },
  {
    "id": 31,
    "text": "--。第",
    "start": 131.44,
    "end": 131.6,
    "duration": 0.16
  },
  {
    "id": 32,
    "text": "一部分：破题立论与归正人身世悲剧。",
    "start": 131.6,
    "end": 135.12,
    "duration": 3.52
  },
  {
    "id": 33,
    "text": "逐句因果推导与答题表述。",
    "start": 135.12,
    "end": 137.44,
    "duration": 2.32
  },
  {
    "id": 34,
    "text": "为了开篇直击考点要害并确立学术基调，",
    "start": 137.44,
    "end": 140.72,
    "duration": 3.28
  },
  {
    "id": 35,
    "text": "第一句必须给出辛弃疾在豪放词史上的领袖地位与权威评价。",
    "start": 140.72,
    "end": 145.36,
    "duration": 4.64
  },
  {
    "id": 36,
    "text": "所以表述为：辛弃疾是南宋豪放派词人的杰出领袖与集大成者，",
    "start": 145.816,
    "end": 151.707,
    "duration": 5.891
  },
  {
    "id": 37,
    "text": "与北宋苏轼并称为“苏辛”。。",
    "start": 151.707,
    "end": 154.0,
    "duration": 2.293
  },
  {
    "id": 38,
    "text": "紧接着必须点明其区别于普通南宋士大夫的特殊身份，",
    "start": 154.0,
    "end": 159.272,
    "duration": 5.272
  },
  {
    "id": 39,
    "text": "展现其投笔从戎的军事实践。",
    "start": 159.272,
    "end": 162.023,
    "duration": 2.751
  },
  {
    "id": 40,
    "text": "所以表述为：作为南渡“归正人”，",
    "start": 162.023,
    "end": 164.774,
    "duration": 2.751
  },
  {
    "id": 41,
    "text": "辛弃疾青年时期曾亲率五十骑突袭敌营生擒叛将，",
    "start": 164.774,
    "end": 169.588,
    "duration": 4.814
  },
  {
    "id": 42,
    "text": "具备极高的军事天才与抗金复国之志。。",
    "start": 169.588,
    "end": 173.256,
    "duration": 3.668
  },
  {
    "id": 43,
    "text": "随后必须交代其南归后政治受挫的悲剧遭遇，",
    "start": 173.416,
    "end": 177.176,
    "duration": 3.76
  },
  {
    "id": 44,
    "text": "说明其强大精神苦闷的现实来源。",
    "start": 177.176,
    "end": 180.296,
    "duration": 3.12
  },
  {
    "id": 45,
    "text": "所以表述为：南归之后，他饱受南宋统治集团的猜忌排挤，",
    "start": 180.296,
    "end": 185.336,
    "duration": 5.04
  },
  {
    "id": 46,
    "text": "被迫落职闲居带湖与瓢泉二十载。。",
    "start": 185.336,
    "end": 188.696,
    "duration": 3.36
  },
  {
    "id": 47,
    "text": "最后一句必须将身世悲剧与词史革新相咬合，",
    "start": 188.696,
    "end": 192.776,
    "duration": 4.08
  },
  {
    "id": 48,
    "text": "引申出题目要求的核心命题“以文为词”，",
    "start": 192.776,
    "end": 196.376,
    "duration": 3.6
  },
  {
    "id": 49,
    "text": "完成破题。",
    "start": 196.376,
    "end": 197.176,
    "duration": 0.8
  },
  {
    "id": 50,
    "text": "所以表述为：沉重的英雄失路之悲与狂放的政治抱负激烈撞击，",
    "start": 197.416,
    "end": 203.336,
    "duration": 5.92
  },
  {
    "id": 51,
    "text": "促使他继承并极大发展了苏轼“以诗入词”的传统，",
    "start": 203.336,
    "end": 207.736,
    "duration": 4.4
  },
  {
    "id": 52,
    "text": "创造性地开辟了“以文为词”的宏大审美格局，",
    "start": 207.736,
    "end": 211.416,
    "duration": 3.68
  },
  {
    "id": 53,
    "text": "将宋词的思想意蕴与艺术表现力推向了最高峰。。",
    "start": 211.416,
    "end": 215.336,
    "duration": 3.92
  },
  {
    "id": 54,
    "text": "本段答题思路总结。",
    "start": 215.336,
    "end": 216.776,
    "duration": 1.44
  },
  {
    "id": 55,
    "text": "本段用四句话完成全篇破题：首句给出苏辛并称与豪放集大成者地位，",
    "start": 217.096,
    "end": 223.496,
    "duration": 6.4
  },
  {
    "id": 56,
    "text": "次句指出归正人与五十骑突袭的英雄底色，",
    "start": 223.496,
    "end": 227.016,
    "duration": 3.52
  },
  {
    "id": 57,
    "text": "第三句交代落职闲居带湖瓢泉的政治悲剧，",
    "start": 227.016,
    "end": 230.456,
    "duration": 3.44
  },
  {
    "id": 58,
    "text": "末句自然引渡至以文为词的最高成就，",
    "start": 230.456,
    "end": 233.576,
    "duration": 3.12
  },
  {
    "id": 59,
    "text": "立意深沉高远。",
    "start": 233.576,
    "end": 234.936,
    "duration": 1.36
  },
  {
    "id": 60,
    "text": "所以本段具体答题完整版为：辛弃疾是南宋豪放派词人的杰出领袖与集大成者，",
    "start": 234.936,
    "end": 241.736,
    "duration": 6.8
  },
  {
    "id": 61,
    "text": "与北宋苏轼并称为“苏辛”。",
    "start": 241.736,
    "end": 244.376,
    "duration": 2.64
  },
  {
    "id": 62,
    "text": "作为南渡“归正人”，辛弃疾青年时期曾亲率五十骑突袭敌营生擒叛将，",
    "start": 244.376,
    "end": 251.096,
    "duration": 6.72
  },
  {
    "id": 63,
    "text": "具备极高的军事天才与抗金复国之志。",
    "start": 251.096,
    "end": 254.856,
    "duration": 3.76
  },
  {
    "id": 64,
    "text": "南归之后，他饱受南宋统治集团的猜忌排挤，",
    "start": 254.856,
    "end": 258.856,
    "duration": 4.0
  },
  {
    "id": 65,
    "text": "被迫落职闲居带湖与瓢泉二十载。",
    "start": 258.856,
    "end": 261.896,
    "duration": 3.04
  },
  {
    "id": 66,
    "text": "沉重的英雄失路之悲与狂放的政治抱负激烈撞击，",
    "start": 262.216,
    "end": 266.776,
    "duration": 4.56
  },
  {
    "id": 67,
    "text": "促使他继承并极大发展了苏轼“以诗入词”的传统，",
    "start": 266.776,
    "end": 271.016,
    "duration": 4.24
  },
  {
    "id": 68,
    "text": "创造性地开辟了“以文为词”的宏大审美格局，",
    "start": 271.016,
    "end": 274.936,
    "duration": 3.92
  },
  {
    "id": 69,
    "text": "将宋词的思想意蕴与艺术表现力推向了最高峰。",
    "start": 274.936,
    "end": 279.016,
    "duration": 4.08
  },
  {
    "id": 70,
    "text": "--。第",
    "start": 279.016,
    "end": 279.176,
    "duration": 0.16
  },
  {
    "id": 71,
    "text": "二部分：以文为词的体制突破与散文化句法。",
    "start": 279.176,
    "end": 283.096,
    "duration": 3.92
  },
  {
    "id": 72,
    "text": "逐句因果推导与答题表述。",
    "start": 283.336,
    "end": 285.736,
    "duration": 2.4
  },
  {
    "id": 73,
    "text": "进入具体论述的第一层，必须准确界定“以文为词”在文体学上的革命性意义。",
    "start": 285.736,
    "end": 291.816,
    "duration": 6.08
  },
  {
    "id": 74,
    "text": "所以表述为：首先，“以文为词”彻底打破了传统词体作为“艳科”的狭隘藩篱，",
    "start": 292.112,
    "end": 298.032,
    "duration": 5.92
  },
  {
    "id": 75,
    "text": "在体制与句法上实现了深度的散文化革新。。",
    "start": 298.032,
    "end": 301.712,
    "duration": 3.68
  },
  {
    "id": 76,
    "text": "随后需要剖析这种革新的技术路径，",
    "start": 301.712,
    "end": 304.352,
    "duration": 2.64
  },
  {
    "id": 77,
    "text": "说明作者是如何将散文结构移植到词中的。",
    "start": 304.352,
    "end": 307.792,
    "duration": 3.44
  },
  {
    "id": 78,
    "text": "所以表述为：辛弃疾打破了音律与格律的严密束缚，",
    "start": 307.792,
    "end": 311.952,
    "duration": 4.16
  },
  {
    "id": 79,
    "text": "大胆将散文的篇章结构、经史论说与虚字呼应直接植入词作之中。。",
    "start": 311.952,
    "end": 317.312,
    "duration": 5.36
  },
  {
    "id": 80,
    "text": "接着进一步分析其句法层面的活跃变化，",
    "start": 317.632,
    "end": 321.152,
    "duration": 3.52
  },
  {
    "id": 81,
    "text": "展现其摆脱声律束缚的自由与开河。",
    "start": 321.152,
    "end": 324.272,
    "duration": 3.12
  },
  {
    "id": 82,
    "text": "所以表述为：他大量运用设问、反诘与长短相建的生活口语，",
    "start": 324.272,
    "end": 329.712,
    "duration": 5.44
  },
  {
    "id": 83,
    "text": "使词的表达如行云流水般自由磅礴。。",
    "start": 329.712,
    "end": 333.152,
    "duration": 3.44
  },
  {
    "id": 84,
    "text": "论点提出后必须立刻调取极具考场辨识度的《水龙吟》经典动作细节作为铁证。",
    "start": 333.152,
    "end": 339.072,
    "duration": 5.92
  },
  {
    "id": 85,
    "text": "所以表述为：《水龙吟•登建康赏心亭》中“把吴钩看了，",
    "start": 339.472,
    "end": 344.272,
    "duration": 4.8
  },
  {
    "id": 86,
    "text": "栏杆拍遍，无人会，登临意”，以极具散文化力度的动作连缀，",
    "start": 344.272,
    "end": 349.312,
    "duration": 5.04
  },
  {
    "id": 87,
    "text": "传达出英雄无用武之地的极度愤懑。。",
    "start": 349.312,
    "end": 352.592,
    "duration": 3.28
  },
  {
    "id": 88,
    "text": "为了避免孤证，补充《摸鱼儿》的层层设问手法，",
    "start": 352.592,
    "end": 356.032,
    "duration": 3.44
  },
  {
    "id": 89,
    "text": "展现其沉郁多姿的散文结构。",
    "start": 356.032,
    "end": 358.192,
    "duration": 2.16
  },
  {
    "id": 90,
    "text": "所以表述为：《摸鱼儿》起首以“更能消几番风雨，",
    "start": 358.512,
    "end": 362.672,
    "duration": 4.16
  },
  {
    "id": 91,
    "text": "匆匆春又归去”的层层盘旋设问，借惜春之情寄寓对国势衰微的深沉忧患，",
    "start": 362.672,
    "end": 369.232,
    "duration": 6.56
  },
  {
    "id": 92,
    "text": "句法跌宕多姿。。",
    "start": 369.232,
    "end": 370.752,
    "duration": 1.52
  },
  {
    "id": 93,
    "text": "本段答题思路总结。",
    "start": 370.752,
    "end": 372.592,
    "duration": 1.84
  },
  {
    "id": 94,
    "text": "本段透彻剖析以文为词的体制革新：从打破艳科与散文化界定起笔，",
    "start": 372.592,
    "end": 378.752,
    "duration": 6.16
  },
  {
    "id": 95,
    "text": "深挖虚字呼应与论说入词的机制，连出《水龙吟》把吴钩看了的动作连贯与《摸鱼儿》层层盘旋设问两大典型，",
    "start": 378.752,
    "end": 388.032,
    "duration": 9.28
  },
  {
    "id": 96,
    "text": "论证极其雄辩。",
    "start": 388.032,
    "end": 389.552,
    "duration": 1.52
  },
  {
    "id": 97,
    "text": "所以本段具体答题完整版为：首先，",
    "start": 389.552,
    "end": 392.64,
    "duration": 3.088
  },
  {
    "id": 98,
    "text": "“以文为词”彻底打破了传统词体作为“艳科”的狭隘藩篱，",
    "start": 392.64,
    "end": 397.68,
    "duration": 5.04
  },
  {
    "id": 99,
    "text": "在体制与句法上实现了深度的散文化革新。",
    "start": 397.68,
    "end": 401.6,
    "duration": 3.92
  },
  {
    "id": 100,
    "text": "辛弃疾打破了音律与格律的严密束缚，",
    "start": 401.6,
    "end": 404.96,
    "duration": 3.36
  },
  {
    "id": 101,
    "text": "大胆将散文的篇章结构、经史论说与虚字呼应直接植入词作之中。",
    "start": 404.96,
    "end": 410.72,
    "duration": 5.76
  },
  {
    "id": 102,
    "text": "他大量运用设问、反诘与长短相建的生活口语，",
    "start": 410.72,
    "end": 414.96,
    "duration": 4.24
  },
  {
    "id": 103,
    "text": "使词的表达如行云流水般自由磅礴。",
    "start": 414.96,
    "end": 418.08,
    "duration": 3.12
  },
  {
    "id": 104,
    "text": "《水龙吟•登建康赏心亭》中“把吴钩看了，",
    "start": 418.24,
    "end": 421.64,
    "duration": 3.4
  },
  {
    "id": 105,
    "text": "栏杆拍遍，无人会，登临意”，以极具散文化力度的动作连缀，",
    "start": 421.64,
    "end": 426.853,
    "duration": 5.213
  },
  {
    "id": 106,
    "text": "传达出英雄无用武之地的极度愤懑。",
    "start": 426.853,
    "end": 430.253,
    "duration": 3.4
  },
  {
    "id": 107,
    "text": "《摸鱼儿》起首以“更能消几番风雨，",
    "start": 430.253,
    "end": 433.2,
    "duration": 2.947
  },
  {
    "id": 108,
    "text": "匆匆春又归去”的层层盘旋设问，借惜春之情寄寓对国势衰微的深沉忧患，",
    "start": 433.2,
    "end": 440.0,
    "duration": 6.8
  },
  {
    "id": 109,
    "text": "句法跌宕多姿。",
    "start": 440.0,
    "end": 441.36,
    "duration": 1.36
  },
  {
    "id": 110,
    "text": "---。第",
    "start": 441.36,
    "end": 441.588,
    "duration": 0.228
  },
  {
    "id": 111,
    "text": "三部分：典故熔铸与经史入词的历史纵深。",
    "start": 441.588,
    "end": 445.461,
    "duration": 3.873
  },
  {
    "id": 112,
    "text": "逐句因果推导与答题表述。",
    "start": 445.461,
    "end": 447.968,
    "duration": 2.507
  },
  {
    "id": 113,
    "text": "分析辛词艺术绝不能绕过其惊世骇俗的用典艺术，",
    "start": 447.968,
    "end": 452.753,
    "duration": 4.785
  },
  {
    "id": 114,
    "text": "首句必须立即给出用典在稼轩词中的核心地位与高度。",
    "start": 452.753,
    "end": 457.994,
    "duration": 5.241
  },
  {
    "id": 115,
    "text": "所以表述为：其次，辛弃疾在创作中实现了典故的大规模融铸，",
    "start": 457.994,
    "end": 463.69,
    "duration": 5.696
  },
  {
    "id": 116,
    "text": "达到了“经史百家无所不用”的化境。。",
    "start": 463.69,
    "end": 466.88,
    "duration": 3.19
  },
  {
    "id": 117,
    "text": "紧接着必须引入南宋大批评家刘克庄的权威定论，",
    "start": 467.04,
    "end": 470.96,
    "duration": 3.92
  },
  {
    "id": 118,
    "text": "夯实学术论述底色。",
    "start": 470.96,
    "end": 472.56,
    "duration": 1.6
  },
  {
    "id": 119,
    "text": "所以表述为：刘克庄在《辛稼轩集序》中盛赞其词作才气超拔。。",
    "start": 472.56,
    "end": 478.32,
    "duration": 5.76
  },
  {
    "id": 120,
    "text": "随后深刻辨析其用典与普通堆砌典故的本质区别，",
    "start": 478.32,
    "end": 482.32,
    "duration": 4.0
  },
  {
    "id": 121,
    "text": "说明其以古况今的心灵化机制。",
    "start": 482.32,
    "end": 484.96,
    "duration": 2.64
  },
  {
    "id": 122,
    "text": "所以表述为：辛词用典绝非盲目堆砌前人陈迹，",
    "start": 485.28,
    "end": 490.16,
    "duration": 4.88
  },
  {
    "id": 123,
    "text": "而是将历史典故与自身现实境遇高度融为一体。。",
    "start": 490.16,
    "end": 494.08,
    "duration": 3.92
  },
  {
    "id": 124,
    "text": "接着必须搬出全书乃至文学史公认的用典巅峰名篇进行深度解剖。",
    "start": 494.08,
    "end": 499.92,
    "duration": 5.84
  },
  {
    "id": 125,
    "text": "所以表述为：《永遇乐•京口北固亭怀古》是其用典艺术的巅峰之作。。",
    "start": 499.92,
    "end": 505.44,
    "duration": 5.52
  },
  {
    "id": 126,
    "text": "随后详细梳理词中五大历史典故的层层排布，",
    "start": 505.84,
    "end": 509.92,
    "duration": 4.08
  },
  {
    "id": 127,
    "text": "展现历史时空的交错辉映。",
    "start": 509.92,
    "end": 512.4,
    "duration": 2.48
  },
  {
    "id": 128,
    "text": "所以表述为：全词熔铸了孙仲谋、刘裕、",
    "start": 512.4,
    "end": 515.68,
    "duration": 3.28
  },
  {
    "id": 129,
    "text": "刘义隆、拓跋焘与廉颇五大历史人物典故。。",
    "start": 515.68,
    "end": 519.44,
    "duration": 3.76
  },
  {
    "id": 130,
    "text": "接着点出作者用典的现实批判指向，",
    "start": 519.44,
    "end": 522.4,
    "duration": 2.96
  },
  {
    "id": 131,
    "text": "展现以古鉴今的政治智慧。",
    "start": 522.4,
    "end": 524.4,
    "duration": 2.0
  },
  {
    "id": 132,
    "text": "所以表述为：作者借刘义隆“赢得仓皇北顾”的史实，",
    "start": 524.72,
    "end": 528.96,
    "duration": 4.24
  },
  {
    "id": 133,
    "text": "深刻告诫当权者切勿草率北伐。。",
    "start": 528.96,
    "end": 531.92,
    "duration": 2.96
  },
  {
    "id": 134,
    "text": "尾句以词末廉颇老矣的反问作结，将典故与作者自身悲剧命运的合一升华至极点。",
    "start": 531.92,
    "end": 538.64,
    "duration": 6.72
  },
  {
    "id": 135,
    "text": "所以表述为：结尾更以“凭谁问：廉颇老矣，",
    "start": 539.008,
    "end": 542.688,
    "duration": 3.68
  },
  {
    "id": 136,
    "text": "尚能饭否”的沉痛反问，将一腔报国无门的暮年悲慨托盘而出，",
    "start": 542.688,
    "end": 548.288,
    "duration": 5.6
  },
  {
    "id": 137,
    "text": "使词作具备了极其厚重的史诗质感。。",
    "start": 548.288,
    "end": 551.808,
    "duration": 3.52
  },
  {
    "id": 138,
    "text": "本段答题思路总结。",
    "start": 551.808,
    "end": 553.888,
    "duration": 2.08
  },
  {
    "id": 139,
    "text": "本段深刻剖析辛词的典故熔铸艺术：引入刘克庄名评定性，",
    "start": 553.888,
    "end": 559.408,
    "duration": 5.52
  },
  {
    "id": 140,
    "text": "阐明用典与自身境遇的合一，精细拆解《永遇乐》京口怀古五大人物典故，",
    "start": 559.408,
    "end": 565.648,
    "duration": 6.24
  },
  {
    "id": 141,
    "text": "解构仓皇北顾的现实告诫与廉颇老矣的暮年悲慨，",
    "start": 565.648,
    "end": 569.968,
    "duration": 4.32
  },
  {
    "id": 142,
    "text": "极具考场得分说服力。",
    "start": 569.968,
    "end": 571.568,
    "duration": 1.6
  },
  {
    "id": 143,
    "text": "所以本段具体答题完整版为：其次，",
    "start": 571.888,
    "end": 575.008,
    "duration": 3.12
  },
  {
    "id": 144,
    "text": "辛弃疾在创作中实现了典故的大规模融铸，",
    "start": 575.008,
    "end": 578.768,
    "duration": 3.76
  },
  {
    "id": 145,
    "text": "达到了“经史百家无所不用”的化境。",
    "start": 578.768,
    "end": 582.048,
    "duration": 3.28
  },
  {
    "id": 146,
    "text": "刘克庄在《辛稼轩集序》中盛赞其词作才气超拔。",
    "start": 582.048,
    "end": 586.448,
    "duration": 4.4
  },
  {
    "id": 147,
    "text": "辛词用典绝非盲目堆砌前人陈迹，而是将历史典故与自身现实境遇高度融为一体。",
    "start": 586.448,
    "end": 593.408,
    "duration": 6.96
  },
  {
    "id": 148,
    "text": "《永遇乐•京口北固亭怀古》是其用典艺术的巅峰之作。",
    "start": 593.568,
    "end": 597.775,
    "duration": 4.207
  },
  {
    "id": 149,
    "text": "全词熔铸了孙仲谋、刘裕、刘义隆、",
    "start": 597.775,
    "end": 600.379,
    "duration": 2.604
  },
  {
    "id": 150,
    "text": "拓跋焘与廉颇五大历史人物典故。",
    "start": 600.379,
    "end": 603.183,
    "duration": 2.804
  },
  {
    "id": 151,
    "text": "作者借刘义隆“赢得仓皇北顾”的史实，",
    "start": 603.183,
    "end": 606.188,
    "duration": 3.005
  },
  {
    "id": 152,
    "text": "深刻告诫当权者切勿草率北伐。",
    "start": 606.188,
    "end": 608.792,
    "duration": 2.604
  },
  {
    "id": 153,
    "text": "结尾更以“凭谁问：廉颇老矣，尚能饭否”的沉痛反问，",
    "start": 608.792,
    "end": 612.798,
    "duration": 4.006
  },
  {
    "id": 154,
    "text": "将一腔报国无门的暮年悲慨托盘而出，",
    "start": 612.798,
    "end": 616.003,
    "duration": 3.205
  },
  {
    "id": 155,
    "text": "使词作具备了极其厚重的史诗质感。",
    "start": 616.003,
    "end": 619.008,
    "duration": 3.005
  },
  {
    "id": 156,
    "text": "---。第",
    "start": 619.008,
    "end": 619.235,
    "duration": 0.227
  },
  {
    "id": 157,
    "text": "四部分：雄奇豪放与沉郁悲壮的多元意境。",
    "start": 619.235,
    "end": 623.097,
    "duration": 3.862
  },
  {
    "id": 158,
    "text": "逐句因果推导与答题表述。",
    "start": 623.097,
    "end": 625.595,
    "duration": 2.498
  },
  {
    "id": 159,
    "text": "在剖析完体制与技法后，论述必须上升到美学风格的多元光谱，",
    "start": 625.595,
    "end": 631.501,
    "duration": 5.906
  },
  {
    "id": 160,
    "text": "首句统摄其多元交融的特征。",
    "start": 631.501,
    "end": 634.227,
    "duration": 2.726
  },
  {
    "id": 161,
    "text": "所以表述为：再次，在风格意境上，",
    "start": 634.227,
    "end": 637.179,
    "duration": 2.952
  },
  {
    "id": 162,
    "text": "稼轩词融雄奇豪放、沉郁苍凉与幽默挥谐于一体，",
    "start": 637.179,
    "end": 641.722,
    "duration": 4.543
  },
  {
    "id": 163,
    "text": "呈现出极为多元的美学光谱。。",
    "start": 641.722,
    "end": 644.448,
    "duration": 2.726
  },
  {
    "id": 164,
    "text": "随后立刻调取其豪放词的代表作，展现沙场梦境与残酷现实的断崖式跌落。",
    "start": 644.608,
    "end": 650.928,
    "duration": 6.32
  },
  {
    "id": 165,
    "text": "所以表述为：《破阵子•为陈同甫赋壮词以寄之》中“醉里挑灯看剑，",
    "start": 650.928,
    "end": 657.088,
    "duration": 6.16
  },
  {
    "id": 166,
    "text": "梦回吹角连营”，以排山倒海之势再现沙场壮景，",
    "start": 657.088,
    "end": 661.248,
    "duration": 4.16
  },
  {
    "id": 167,
    "text": "末句“可怜白发生”陡然跌落，形成极强的情感张力。。",
    "start": 661.248,
    "end": 665.568,
    "duration": 4.32
  },
  {
    "id": 168,
    "text": "为了打破单调的豪放标签，补充其闲居期间物我相对的傲岸哲思。",
    "start": 665.808,
    "end": 671.888,
    "duration": 6.08
  },
  {
    "id": 169,
    "text": "所以表述为：《贺新郎》中“我见青山多五媚，",
    "start": 671.888,
    "end": 675.888,
    "duration": 4.0
  },
  {
    "id": 170,
    "text": "料青山见我应如是”，展现出物我相视的超拔傲岸。。",
    "start": 675.888,
    "end": 680.448,
    "duration": 4.56
  },
  {
    "id": 171,
    "text": "进一步补充其充满生活情趣的田园词作，",
    "start": 680.448,
    "end": 683.968,
    "duration": 3.52
  },
  {
    "id": 172,
    "text": "印证其胸怀的博大与真率。",
    "start": 683.968,
    "end": 686.128,
    "duration": 2.16
  },
  {
    "id": 173,
    "text": "所以表述为：《清平乐•村居》则以白描展现乡村温情。。",
    "start": 686.512,
    "end": 690.787,
    "duration": 4.275
  },
  {
    "id": 174,
    "text": "尾句对这种多元风格背后的崇高人格进行就地总结。",
    "start": 690.787,
    "end": 695.552,
    "duration": 4.765
  },
  {
    "id": 175,
    "text": "所以表述为：这种刚柔并济的意境创造，",
    "start": 695.552,
    "end": 699.017,
    "duration": 3.465
  },
  {
    "id": 176,
    "text": "彰显出词人博大深沉的精神境界。。",
    "start": 699.017,
    "end": 702.05,
    "duration": 3.033
  },
  {
    "id": 177,
    "text": "本段答题思路总结。",
    "start": 702.05,
    "end": 703.782,
    "duration": 1.732
  },
  {
    "id": 178,
    "text": "本段全面展现稼轩词的多元美学风格：先立定多元光谱总纲，",
    "start": 703.782,
    "end": 709.197,
    "duration": 5.415
  },
  {
    "id": 179,
    "text": "接着用《破阵子》挑灯看剑与白发跌落展现悲壮豪放，",
    "start": 709.197,
    "end": 713.745,
    "duration": 4.548
  },
  {
    "id": 180,
    "text": "用《贺新郎》见青山展现孤高自赏，",
    "start": 713.745,
    "end": 716.561,
    "duration": 2.816
  },
  {
    "id": 181,
    "text": "用《清平乐》展现田园温情，充分体现出考生对辛词全貌的驾驭力。",
    "start": 716.561,
    "end": 722.192,
    "duration": 5.631
  },
  {
    "id": 182,
    "text": "所以本段具体答题完整版为：再次，",
    "start": 722.352,
    "end": 725.792,
    "duration": 3.44
  },
  {
    "id": 183,
    "text": "在风格意境上，稼轩词融雄奇豪放、",
    "start": 725.792,
    "end": 729.392,
    "duration": 3.6
  },
  {
    "id": 184,
    "text": "沉郁苍凉与幽默挥谐于一体，呈现出极为多元的美学光谱。",
    "start": 729.392,
    "end": 734.912,
    "duration": 5.52
  },
  {
    "id": 185,
    "text": "《破阵子•为陈同甫赋壮词以寄之》中“醉里挑灯看剑，",
    "start": 734.912,
    "end": 739.952,
    "duration": 5.04
  },
  {
    "id": 186,
    "text": "梦回吹角连营”，以排山倒海之势再现沙场壮景，",
    "start": 739.952,
    "end": 744.272,
    "duration": 4.32
  },
  {
    "id": 187,
    "text": "末句“可怜白发生”陡然跌落，形成极强的情感张力。",
    "start": 744.272,
    "end": 748.672,
    "duration": 4.4
  },
  {
    "id": 188,
    "text": "《贺新郎》中“我见青山多五媚，料青山见我应如是”，",
    "start": 748.912,
    "end": 753.629,
    "duration": 4.717
  },
  {
    "id": 189,
    "text": "展现出物我相视的超拔傲岸。",
    "start": 753.629,
    "end": 756.609,
    "duration": 2.98
  },
  {
    "id": 190,
    "text": "《清平乐•村居》则以白描展现乡村温情。",
    "start": 756.609,
    "end": 760.333,
    "duration": 3.724
  },
  {
    "id": 191,
    "text": "这种刚柔并济的意境创造，彰显出词人博大深沉的精神境界。",
    "start": 760.333,
    "end": 766.54,
    "duration": 6.207
  },
  {
    "id": 192,
    "text": "--。第",
    "start": 766.54,
    "end": 766.788,
    "duration": 0.248
  },
  {
    "id": 193,
    "text": "五部分：总结升华与文学史巅峰价值。",
    "start": 766.788,
    "end": 770.512,
    "duration": 3.724
  },
  {
    "id": 194,
    "text": "逐句因果推导与答题表述。",
    "start": 770.592,
    "end": 773.472,
    "duration": 2.88
  },
  {
    "id": 195,
    "text": "经过以上四个维度的纵深展开，结尾段必须跳出个案本身，",
    "start": 773.472,
    "end": 778.912,
    "duration": 5.44
  },
  {
    "id": 196,
    "text": "在宋代词史演进与爱国精神传承中完成终极升华。",
    "start": 778.912,
    "end": 784.032,
    "duration": 5.12
  },
  {
    "id": 197,
    "text": "所以表述为：最后，辛弃疾的稼轩词不仅完成了宋代词体演进的终极蜕变，",
    "start": 784.032,
    "end": 790.352,
    "duration": 6.32
  },
  {
    "id": 198,
    "text": "更直接催生了南宋辛派爱国词群。。",
    "start": 790.352,
    "end": 793.312,
    "duration": 2.96
  },
  {
    "id": 199,
    "text": "最后一句必须将纯文学技法升华至中华民族的人格精神支柱，",
    "start": 793.632,
    "end": 798.272,
    "duration": 4.64
  },
  {
    "id": 200,
    "text": "完成大题圆满闭环。",
    "start": 798.272,
    "end": 799.872,
    "duration": 1.6
  },
  {
    "id": 201,
    "text": "所以表述为：他以文为词的大胆拓荒精神与深沉炽热的爱国主义精魂，",
    "start": 799.872,
    "end": 805.392,
    "duration": 5.52
  },
  {
    "id": 202,
    "text": "为后世树立了崇高的人格风范，成为中华民族文学史中无可替代的精神灯塔。。",
    "start": 805.392,
    "end": 811.312,
    "duration": 5.92
  },
  {
    "id": 203,
    "text": "本段答题思路总结。",
    "start": 811.552,
    "end": 813.392,
    "duration": 1.84
  },
  {
    "id": 204,
    "text": "本段两句话干脆利落地完成大题闭环：首句立定词体演进终极蜕变与辛派爱国词群奠基者地位，",
    "start": 813.392,
    "end": 821.472,
    "duration": 8.08
  },
  {
    "id": 205,
    "text": "末句以文为词拓荒精神与爱国精魂升华至民族精神灯塔高度，",
    "start": 821.472,
    "end": 826.992,
    "duration": 5.52
  },
  {
    "id": 206,
    "text": "文气贯通，气象万千。",
    "start": 826.992,
    "end": 828.992,
    "duration": 2.0
  },
  {
    "id": 207,
    "text": "所以本段具体答题完整版为：最后，",
    "start": 828.992,
    "end": 831.936,
    "duration": 2.944
  },
  {
    "id": 208,
    "text": "辛弃疾的稼轩词不仅完成了宋代词体演进的终极蜕变，",
    "start": 831.936,
    "end": 836.816,
    "duration": 4.88
  },
  {
    "id": 209,
    "text": "更直接催生了南宋辛派爱国词群。",
    "start": 836.816,
    "end": 840.096,
    "duration": 3.28
  },
  {
    "id": 210,
    "text": "他以文为词的大胆拓荒精神与深沉炽热的爱国主义精魂，",
    "start": 840.096,
    "end": 845.056,
    "duration": 4.96
  },
  {
    "id": 211,
    "text": "为后世树立了崇高的人格风范，成为中华民族文学史中无可替代的精神灯塔。",
    "start": 845.056,
    "end": 851.296,
    "duration": 6.24
  },
  {
    "id": 212,
    "text": "篇尾：整道大题的内在逻辑链总括。",
    "start": 851.536,
    "end": 854.336,
    "duration": 2.8
  },
  {
    "id": 213,
    "text": "为了便于考生在脑海中建立极速调取机制，",
    "start": 854.336,
    "end": 857.616,
    "duration": 3.28
  },
  {
    "id": 214,
    "text": "整道大题的论证逻辑可提炼为如下不可逆的六步链条：一、",
    "start": 857.616,
    "end": 862.576,
    "duration": 4.96
  },
  {
    "id": 215,
    "text": "身世定性：开篇直接以苏辛并称与归正人英雄失路定性，",
    "start": 862.576,
    "end": 867.616,
    "duration": 5.04
  },
  {
    "id": 216,
    "text": "确立政治悲剧逼出以文为词的核心逻辑。",
    "start": 867.616,
    "end": 870.576,
    "duration": 2.96
  },
  {
    "id": 217,
    "text": "二、体制革新：打破艳科与律调拘束，",
    "start": 870.976,
    "end": 874.656,
    "duration": 3.68
  },
  {
    "id": 218,
    "text": "运用散文篇章结构与虚字呼应，以《水龙吟》《摸鱼儿》展现散文化句法。",
    "start": 874.656,
    "end": 881.136,
    "duration": 6.48
  },
  {
    "id": 219,
    "text": "三、经史入词：标举刘克庄无所不用名评，",
    "start": 881.136,
    "end": 885.056,
    "duration": 3.92
  },
  {
    "id": 220,
    "text": "剖析以古况今机制，以《永遇乐》五大典故与廉颇反问展厚重史诗质感。",
    "start": 885.056,
    "end": 890.896,
    "duration": 5.84
  },
  {
    "id": 221,
    "text": "四、多元意境：突破单一标签，以《破阵子》展悲壮豪放，",
    "start": 891.216,
    "end": 896.336,
    "duration": 5.12
  },
  {
    "id": 222,
    "text": "以《贺新郎》展孤傲物我，以《村居》展田园温情。",
    "start": 896.336,
    "end": 900.256,
    "duration": 3.92
  },
  {
    "id": 223,
    "text": "五、流派引领：纵向打通南宋词史脉络，",
    "start": 900.256,
    "end": 904.176,
    "duration": 3.92
  },
  {
    "id": 224,
    "text": "指出其不仅完成了词体演进蜕变，更催生了陈亮、",
    "start": 904.176,
    "end": 908.336,
    "duration": 4.16
  },
  {
    "id": 225,
    "text": "刘过等辛派爱国词群。",
    "start": 908.336,
    "end": 910.176,
    "duration": 1.84
  },
  {
    "id": 226,
    "text": "六、精神闭环：升华至民族爱国主义精魂与崇高人格风范，",
    "start": 910.416,
    "end": 915.536,
    "duration": 5.12
  },
  {
    "id": 227,
    "text": "完成作为中国古典文学精神灯塔的历史闭环。",
    "start": 915.536,
    "end": 918.976,
    "duration": 3.44
  }
]