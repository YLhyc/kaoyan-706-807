[
  {
    "id": 1,
    "start": 0.08,
    "end": 3.2,
    "text": "苏轼与辛弃疾被后世并称为“苏辛”，"
  },
  {
    "id": 2,
    "start": 3.2,
    "end": 7.44,
    "text": "是中国宋代词史上开创豪放词风的并峙双峰。"
  },
  {
    "id": 3,
    "start": 7.44,
    "end": 12.08,
    "text": "苏轼以其超迈旷达之天才首开豪迈雄健之风，"
  },
  {
    "id": 4,
    "start": 12.08,
    "end": 15.44,
    "text": "使词从“歌妓之曲”迈向“士大夫之言”。"
  },
  {
    "id": 5,
    "start": 15.44,
    "end": 20.8,
    "text": "辛弃疾则在南宋民族危亡的历史语境中接续并深化这一传统，"
  },
  {
    "id": 6,
    "start": 20.8,
    "end": 24.0,
    "text": "形成了慷慨悲壮、沉郁抗坠的独特美学。"
  },
  {
    "id": 7,
    "start": 24.32,
    "end": 29.36,
    "text": "两者在精神底色、词境营造与文体技法上各具独创贡献。"
  },
  {
    "id": 8,
    "start": 29.36,
    "end": 32.72,
    "text": "第一，在主体精神品格与情感气象上，"
  },
  {
    "id": 9,
    "start": 32.72,
    "end": 36.0,
    "text": "苏轼词充溢着解脱旷达的哲理智慧，"
  },
  {
    "id": 10,
    "start": 36.0,
    "end": 39.84,
    "text": "辛弃疾词则激荡着英雄失路的悲愤沉雄。"
  },
  {
    "id": 11,
    "start": 39.84,
    "end": 44.0,
    "text": "苏轼虽一生屡遭贬哲，但深得儒释道三家滋养，"
  },
  {
    "id": 12,
    "start": 44.0,
    "end": 46.8,
    "text": "具有超越现实政治苦难的博大胸襟。"
  },
  {
    "id": 13,
    "start": 47.12,
    "end": 52.16,
    "text": "其在《定风波》中面对山头急雨，从容吟啸“莫听穿林打叶声，"
  },
  {
    "id": 14,
    "start": 52.16,
    "end": 57.84,
    "text": "何妨吟啸且徐行”，以“也无风雨也无晴”的通脱悟境化解人世沉浮。"
  },
  {
    "id": 15,
    "start": 57.84,
    "end": 61.52,
    "text": "辛弃疾则终生怀抱收复中原的雄图大略，"
  },
  {
    "id": 16,
    "start": 61.52,
    "end": 65.28,
    "text": "面对偏安朝廷的苟安妥协与自身的闲置弃用，"
  },
  {
    "id": 17,
    "start": 65.28,
    "end": 68.64,
    "text": "其词作内聚了强烈的用世热忱与英雄悲慨。"
  },
  {
    "id": 18,
    "start": 68.96,
    "end": 73.28,
    "text": "辛弃疾在《破阵子•为陈同甫赋壮词以寄之》中，"
  },
  {
    "id": 19,
    "start": 73.28,
    "end": 76.8,
    "text": "“梦回吹角连营”的沙场杀敌豪情，"
  },
  {
    "id": 20,
    "start": 76.8,
    "end": 81.2,
    "text": "与结笔“可怜白发生”的残酷现实构成剧烈落差，"
  },
  {
    "id": 21,
    "start": 81.2,
    "end": 85.12,
    "text": "全篇回荡着忠愤填膺而报国无门的壮烈悲歌。"
  },
  {
    "id": 22,
    "start": 85.504,
    "end": 88.944,
    "text": "第二，在词境开拓与题材指向形态上，"
  },
  {
    "id": 23,
    "start": 88.944,
    "end": 92.944,
    "text": "苏轼以泛舟江海的文人情怀拓展了词的生活面向，"
  },
  {
    "id": 24,
    "start": 92.944,
    "end": 98.944,
    "text": "辛弃疾则以抗金前线的金戈铁马赋予了词以沉重厚重的历史战火气息。"
  },
  {
    "id": 25,
    "start": 98.944,
    "end": 101.664,
    "text": "苏轼主张“无意不可入，无事不可言”，"
  },
  {
    "id": 26,
    "start": 101.664,
    "end": 106.784,
    "text": "将仕途感慨、田园风光、兄弟离合乃至农家起居尽数纳于词中。"
  },
  {
    "id": 27,
    "start": 107.104,
    "end": 113.504,
    "text": "比如《水调歌头•明月几时有》借中秋问月探讨宇宙人生哲理与人情相思，"
  },
  {
    "id": 28,
    "start": 113.504,
    "end": 118.384,
    "text": "《江城子•密州出猎》则抒发“老夫聊发少年狂”的豪情。"
  },
  {
    "id": 29,
    "start": 118.384,
    "end": 121.504,
    "text": "辛弃疾则将词完全政治化与战斗化。"
  },
  {
    "id": 30,
    "start": 121.504,
    "end": 125.344,
    "text": "辛词全面反映了南宋朝廷的主和与主战矛盾、"
  },
  {
    "id": 31,
    "start": 125.344,
    "end": 127.344,
    "text": "边疆烽岁与民生疾苦。"
  },
  {
    "id": 32,
    "start": 127.664,
    "end": 131.664,
    "text": "其在《永遇乐•京口北固亭怀古》中登高凭吊，"
  },
  {
    "id": 33,
    "start": 131.664,
    "end": 136.864,
    "text": "借孙权、刘裕之北伐伟业，反讽韩托骤之草率妄动，"
  },
  {
    "id": 34,
    "start": 136.864,
    "end": 141.184,
    "text": "将国家存亡之深谋远虑熔铸于词作骨骼之中。"
  },
  {
    "id": 35,
    "start": 141.184,
    "end": 146.864,
    "text": "第三，在文体技法与语言革新上，苏轼开创了“以诗入词”，"
  },
  {
    "id": 36,
    "start": 146.864,
    "end": 149.984,
    "text": "辛弃疾则深化发展为“以文为词”，"
  },
  {
    "id": 37,
    "start": 149.984,
    "end": 152.624,
    "text": "共同推动了词体性质的根本重塑。"
  },
  {
    "id": 38,
    "start": 152.944,
    "end": 157.744,
    "text": "苏轼的“以诗入词”，核心在于打破词原有的樽前艳科属性，"
  },
  {
    "id": 39,
    "start": 157.744,
    "end": 162.944,
    "text": "将诗歌的典雅格调、开阔意境与言志功能全面移植入词。"
  },
  {
    "id": 40,
    "start": 162.944,
    "end": 168.144,
    "text": "苏词洗净铅华，追求清雄刚健、超然绝俗的美学境界，"
  },
  {
    "id": 41,
    "start": 168.144,
    "end": 171.264,
    "text": "在语言上清新俊拔而不事雕琢。"
  },
  {
    "id": 42,
    "start": 171.264,
    "end": 176.384,
    "text": "辛弃疾的“以文为词”，则进一步突破了词的音律和格律界限，"
  },
  {
    "id": 43,
    "start": 176.384,
    "end": 180.064,
    "text": "大量吸收先秦诸子与经史散文的句法章法。"
  },
  {
    "id": 44,
    "start": 180.384,
    "end": 185.504,
    "text": "辛弃疾在词中广泛运用议论设问、虚字勾勒与叙事插话，"
  },
  {
    "id": 45,
    "start": 185.504,
    "end": 189.744,
    "text": "更是达到了“掉臂游行，熟能名其用典之迹”的化境。"
  },
  {
    "id": 46,
    "start": 189.744,
    "end": 194.384,
    "text": "在《摸鱼儿•更能消几番风雨》与《贺新郎•同父见和甚残》中，"
  },
  {
    "id": 47,
    "start": 194.384,
    "end": 197.824,
    "text": "辛弃疾经史子集信手拈来，用典如弹丸，"
  },
  {
    "id": 48,
    "start": 197.824,
    "end": 202.064,
    "text": "在严密的论辨气势中奔涌出如长江大河般的深厚气力。"
  },
  {
    "id": 49,
    "start": 202.384,
    "end": 208.784,
    "text": "综上所述，苏轼的“以诗入词”使词从形式附庸升华为独立的言志载体，"
  },
  {
    "id": 50,
    "start": 208.784,
    "end": 211.504,
    "text": "确立了词的士大夫独立品格。"
  },
  {
    "id": 51,
    "start": 211.504,
    "end": 216.704,
    "text": "辛弃疾的“以文为词”则将词的容量和表现力拓展至极境，"
  },
  {
    "id": 52,
    "start": 216.704,
    "end": 219.984,
    "text": "熔铸了炽热的家国命运与英雄情怀。"
  },
  {
    "id": 53,
    "start": 219.984,
    "end": 227.584,
    "text": "苏辛二人一开其疆、一尽其变，共同完成了宋词从柔媚艳科向崇高审美形态的全面蜕变，"
  },
  {
    "id": 54,
    "start": 227.584,
    "end": 231.424,
    "text": "在古代文学史册上留下了不可磨灭的划时代烙印。"
  }
]