[
  {
    "id": 1,
    "text": "题型，三十分论述题。",
    "start": 0.08,
    "end": 2.031,
    "duration": 1.951
  },
  {
    "id": 2,
    "text": "分值，三十分。",
    "start": 2.031,
    "end": 3.252,
    "duration": 1.221
  },
  {
    "id": 3,
    "text": "建议考场时间，三十五分钟。",
    "start": 3.252,
    "end": 5.94,
    "duration": 2.688
  },
  {
    "id": 4,
    "text": "目标字数，一千一百五十到一千三百字。",
    "start": 5.94,
    "end": 9.85,
    "duration": 3.91
  },
  {
    "id": 5,
    "text": "答题骨架，戏曲巅峰定性、趋近于、",
    "start": 9.85,
    "end": 13.027,
    "duration": 3.177
  },
  {
    "id": 6,
    "text": "反封建礼教思想意蕴与“情”的觉醒、",
    "start": 13.027,
    "end": 16.448,
    "duration": 3.421
  },
  {
    "id": 7,
    "text": "趋近于、人物形象立体塑造与历史演进机制、",
    "start": 16.448,
    "end": 20.847,
    "duration": 4.399
  },
  {
    "id": 8,
    "text": "趋近于、戏剧结构布局与诗化曲词美学、",
    "start": 20.847,
    "end": 24.756,
    "duration": 3.909
  },
  {
    "id": 9,
    "text": "趋近于、宏观文学史总结。",
    "start": 24.756,
    "end": 27.2,
    "duration": 2.444
  },
  {
    "id": 10,
    "text": "元代王实甫所著《崔莺莺待月西厢记》是中国古典戏曲史上的抒情艺术丰碑。",
    "start": 27.36,
    "end": 33.52,
    "duration": 6.16
  },
  {
    "id": 11,
    "text": "剧作以极其鲜明的反封建礼教锋芒与高度诗化的曲词文采，",
    "start": 33.52,
    "end": 38.56,
    "duration": 5.04
  },
  {
    "id": 12,
    "text": "将唐代元稹传奇《莺莺传》彻底重构为歌颂纯真爱情的青春赞歌，",
    "start": 38.56,
    "end": 44.24,
    "duration": 5.68
  },
  {
    "id": 13,
    "text": "确立了中国戏曲文学追求人性解放的崇高审美标杆。",
    "start": 44.24,
    "end": 48.0,
    "duration": 3.76
  },
  {
    "id": 14,
    "text": "第一，在思想意蕴上，《西厢记》旗帜鲜明地确立了“愿普天下有情的都成了眷属”的进步主张，",
    "start": 48.4,
    "end": 56.16,
    "duration": 7.76
  },
  {
    "id": 15,
    "text": "深刻冲击了封建门阀婚姻与理学礼教网络。",
    "start": 56.16,
    "end": 60.0,
    "duration": 3.84
  },
  {
    "id": 16,
    "text": "全剧将爱情建立在男女双方性灵相契与才德相慕的真诚基础之上，",
    "start": 60.0,
    "end": 65.84,
    "duration": 5.84
  },
  {
    "id": 17,
    "text": "彻底否定了“父母之命，媒妁之言”的世俗功利准则。",
    "start": 65.84,
    "end": 69.76,
    "duration": 3.92
  },
  {
    "id": 18,
    "text": "崔夫人作为封建家长制与门阀阶级的顽固代表，",
    "start": 70.08,
    "end": 73.68,
    "duration": 3.6
  },
  {
    "id": 19,
    "text": "在孙飞虎围困普救寺时许诺“退得贼兵者以莺莺妻之”，",
    "start": 73.68,
    "end": 78.24,
    "duration": 4.56
  },
  {
    "id": 20,
    "text": "事定之后却立即毁约赖婚，暴露出封建礼教虚伪冷酷的本质。",
    "start": 78.24,
    "end": 82.8,
    "duration": 4.56
  },
  {
    "id": 21,
    "text": "全剧正是通过张生与崔莺莺在红娘协助下冲破这一重重阻挠的曲折斗争，",
    "start": 82.8,
    "end": 88.32,
    "duration": 5.52
  },
  {
    "id": 22,
    "text": "肯定了青年男女对自主爱情的执着追求，",
    "start": 88.32,
    "end": 91.28,
    "duration": 2.96
  },
  {
    "id": 23,
    "text": "使“情”战胜了“礼”，闪烁着早期启蒙主义的人性光辉。",
    "start": 91.28,
    "end": 94.96,
    "duration": 3.68
  },
  {
    "id": 24,
    "text": "第二，在人物形象塑造上，剧作实现了人物性格由历史旧范式向新型典型性格的成功转换，",
    "start": 95.336,
    "end": 103.496,
    "duration": 8.16
  },
  {
    "id": 25,
    "text": "呈现出细腻真实的心理流变。",
    "start": 103.496,
    "end": 105.816,
    "duration": 2.32
  },
  {
    "id": 26,
    "text": "王实甫对历史题材进行了革命性改造。",
    "start": 105.816,
    "end": 108.856,
    "duration": 3.04
  },
  {
    "id": 27,
    "text": "唐传奇中“始乱终弃”的薄幸文人张生，",
    "start": 108.856,
    "end": 112.216,
    "duration": 3.36
  },
  {
    "id": 28,
    "text": "在剧中被重塑为对爱情忠贞不渝、甚至敢于蔑视功名的纯情士人，",
    "start": 112.216,
    "end": 117.736,
    "duration": 5.52
  },
  {
    "id": 29,
    "text": "其在寺中惊艳、隔墙酬和直至相思成疾，",
    "start": 117.736,
    "end": 121.176,
    "duration": 3.44
  },
  {
    "id": 30,
    "text": "皆洋溢着志诚君子的赤子之情。",
    "start": 121.176,
    "end": 123.736,
    "duration": 2.56
  },
  {
    "id": 31,
    "text": "女主角崔莺莺的塑造更是深具艺术深度。",
    "start": 124.056,
    "end": 127.416,
    "duration": 3.36
  },
  {
    "id": 32,
    "text": "作为相国千金，崔莺莺既深受封建封建礼数长期浸染而自持自矜，",
    "start": 127.416,
    "end": 133.656,
    "duration": 6.24
  },
  {
    "id": 33,
    "text": "内心又充满对青春爱情的热烈渴望。",
    "start": 133.656,
    "end": 136.616,
    "duration": 2.96
  },
  {
    "id": 34,
    "text": "王实甫极其细腻地刻画了她在“寄简”、",
    "start": 136.616,
    "end": 139.976,
    "duration": 3.36
  },
  {
    "id": 35,
    "text": "“闹简”到“赖简”过程中的心理震颤，",
    "start": 139.976,
    "end": 142.936,
    "duration": 2.96
  },
  {
    "id": 36,
    "text": "表面上的嗔怒掩盖不住内心的波澜，",
    "start": 142.936,
    "end": 145.976,
    "duration": 3.04
  },
  {
    "id": 37,
    "text": "真实呈现出一位深规少女由顾虑重重走向冲破罗网的觉醒轨迹。",
    "start": 145.976,
    "end": 151.896,
    "duration": 5.92
  },
  {
    "id": 38,
    "text": "红娘则作为反叛精神的催化剂，兼具机智侠义与平民智慧，",
    "start": 152.136,
    "end": 157.816,
    "duration": 5.68
  },
  {
    "id": 39,
    "text": "在“拷红”一场面对崔夫人理直气壮据理力争，",
    "start": 157.816,
    "end": 161.976,
    "duration": 4.16
  },
  {
    "id": 40,
    "text": "成为古典戏剧中最生动鲜活的婢女形象。",
    "start": 161.976,
    "end": 165.576,
    "duration": 3.6
  },
  {
    "id": 41,
    "text": "第三，在戏剧结构与曲词艺术上，剧作打破了元杂剧四折一楔子的成规定制，",
    "start": 165.576,
    "end": 172.456,
    "duration": 6.88
  },
  {
    "id": 42,
    "text": "创造了五本二十一折的宏大叙事体制与典雅诗化风格。",
    "start": 172.456,
    "end": 176.856,
    "duration": 4.4
  },
  {
    "id": 43,
    "text": "《西厢记》情节起伏跌宕，寺警、酬韵、",
    "start": 177.016,
    "end": 180.01,
    "duration": 2.994
  },
  {
    "id": 44,
    "text": "赖婚、琴挑、闹简、佳期、长亭送别环环相扣，",
    "start": 180.01,
    "end": 183.696,
    "duration": 3.686
  },
  {
    "id": 45,
    "text": "悬念丛生且节奏紧凑。",
    "start": 183.696,
    "end": 185.769,
    "duration": 2.073
  },
  {
    "id": 46,
    "text": "在语言美学上，明代谢榛评其“如花间美人”，",
    "start": 185.769,
    "end": 189.684,
    "duration": 3.915
  },
  {
    "id": 47,
    "text": "剧作完全摆脱了元曲早期粗豪俚俗的习气，",
    "start": 189.684,
    "end": 193.83,
    "duration": 4.146
  },
  {
    "id": 48,
    "text": "将古典诗词的清词丽句完美融入通俗戏曲。",
    "start": 193.83,
    "end": 197.976,
    "duration": 4.146
  },
  {
    "id": 49,
    "text": "比如第四本第三折《长亭送别》中，",
    "start": 198.056,
    "end": 201.016,
    "duration": 2.96
  },
  {
    "id": 50,
    "text": "“碧云天，黄花地，西风紧，北雁南飞。",
    "start": 201.016,
    "end": 204.696,
    "duration": 3.68
  },
  {
    "id": 51,
    "text": "晓来谁染霜林醉？",
    "start": 204.696,
    "end": 206.696,
    "duration": 2.0
  },
  {
    "id": 52,
    "text": "总是离人泪”，不仅化用范仲淹诗词意境，",
    "start": 206.696,
    "end": 210.456,
    "duration": 3.76
  },
  {
    "id": 53,
    "text": "更将满目秋景与主人公肝肠寸断的离别深情融铸一炉，",
    "start": 210.456,
    "end": 215.736,
    "duration": 5.28
  },
  {
    "id": 54,
    "text": "达到了意象幽美与情感沉痛的高度统一，",
    "start": 215.736,
    "end": 219.736,
    "duration": 4.0
  },
  {
    "id": 55,
    "text": "成为中国抒情戏剧曲词的千古绝唱。",
    "start": 219.736,
    "end": 222.696,
    "duration": 2.96
  },
  {
    "id": 56,
    "text": "综上所述，王实甫《西厢记》以反封建礼教的深刻思想震撼了封建伦理根基，",
    "start": 222.936,
    "end": 229.176,
    "duration": 6.24
  },
  {
    "id": 57,
    "text": "以精微入微的心理开掘重构了中国戏剧人物塑造的高度，",
    "start": 229.176,
    "end": 233.896,
    "duration": 4.72
  },
  {
    "id": 58,
    "text": "以典雅华艳的诗化曲词奠定了元杂剧文人化的巅峰品格。",
    "start": 233.896,
    "end": 239.336,
    "duration": 5.44
  },
  {
    "id": 59,
    "text": "它在文学史与戏剧史上长久滋养着中国人的精神世界，",
    "start": 239.336,
    "end": 243.656,
    "duration": 4.32
  },
  {
    "id": 60,
    "text": "具有永恒的审美生命力。",
    "start": 243.656,
    "end": 245.416,
    "duration": 1.76
  }
]