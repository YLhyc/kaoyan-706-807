[
  {
    "id": 1,
    "text": "全局宏观破题与立论逻辑。",
    "start": 0.16,
    "end": 2.96,
    "duration": 2.8
  },
  {
    "id": 2,
    "text": "在考场下笔之前，必须先在宏观上审清这道三十分大题的核心考核意图。",
    "start": 2.96,
    "end": 8.72,
    "duration": 5.76
  },
  {
    "id": 3,
    "text": "本题表面上考查苏轼词的艺术特点，",
    "start": 8.72,
    "end": 11.52,
    "duration": 2.8
  },
  {
    "id": 4,
    "text": "本质上考查宋代文人对词体文学属性的革命性重构。",
    "start": 11.52,
    "end": 16.16,
    "duration": 4.64
  },
  {
    "id": 5,
    "text": "考场评分标准绝不满足于仅列举几首豪放词的名句。",
    "start": 16.16,
    "end": 20.08,
    "duration": 3.92
  },
  {
    "id": 6,
    "text": "答题方向必须确立为“从题材打破艳科小道，",
    "start": 20.4,
    "end": 24.56,
    "duration": 4.16
  },
  {
    "id": 7,
    "text": "推进到情志升华豪迈旷达，再深入到摆脱音乐羁绊的机制变革，",
    "start": 24.56,
    "end": 31.04,
    "duration": 6.48
  },
  {
    "id": 8,
    "text": "最终落地至语言体制与后代辛派承续”的因果推进。",
    "start": 31.04,
    "end": 35.76,
    "duration": 4.72
  },
  {
    "id": 9,
    "text": "整道大题在宏观上划分为五个有机递进的逻辑层次：第一层，",
    "start": 35.76,
    "end": 40.96,
    "duration": 5.2
  },
  {
    "id": 10,
    "text": "开篇破题，借刘辰翁“倾荡磊落”定评与袁行配教材，",
    "start": 40.96,
    "end": 46.16,
    "duration": 5.2
  },
  {
    "id": 11,
    "text": "确立其作为词体革命领袖的至高坐标。",
    "start": 46.16,
    "end": 49.36,
    "duration": 3.2
  },
  {
    "id": 12,
    "text": "第二层，论述题材边界，剖析如何打破花间规阁局限，",
    "start": 49.6,
    "end": 54.24,
    "duration": 4.64
  },
  {
    "id": 13,
    "text": "实现无事不可入词、无意不可表达。",
    "start": 54.24,
    "end": 57.28,
    "duration": 3.04
  },
  {
    "id": 14,
    "text": "第三层，论述情志意境，以《定风波》“一蓑烟雨任平生”为例，",
    "start": 57.28,
    "end": 62.64,
    "duration": 5.36
  },
  {
    "id": 15,
    "text": "阐释由柔媚感伤转向崇高旷达的生命境界。",
    "start": 62.64,
    "end": 66.72,
    "duration": 4.08
  },
  {
    "id": 16,
    "text": "第四层，论述机制与功能，剖析脱离歌妓案头化、",
    "start": 66.72,
    "end": 71.12,
    "duration": 4.4
  },
  {
    "id": 17,
    "text": "增设题序，以及对李清照“词别是一家”争论的正确认知。",
    "start": 71.12,
    "end": 75.44,
    "duration": 4.32
  },
  {
    "id": 18,
    "text": "第五层，落地至语言体制，阐释以诗文句法入词，",
    "start": 75.76,
    "end": 80.4,
    "duration": 4.64
  },
  {
    "id": 19,
    "text": "实现清雄雅健、扫荡脂粉的语言革新。",
    "start": 80.4,
    "end": 83.92,
    "duration": 3.52
  },
  {
    "id": 20,
    "text": "尾部收官，以“苏辛并称”定性，交代其对南宋辛派爱国词人集团的伟大开拓。",
    "start": 83.92,
    "end": 90.56,
    "duration": 6.64
  },
  {
    "id": 21,
    "text": "这五个层次构成一条不可逆的因果链条：破除艳科是前提，",
    "start": 90.56,
    "end": 95.76,
    "duration": 5.2
  },
  {
    "id": 22,
    "text": "题材扩展是基础，旷达人格是灵魂，",
    "start": 95.76,
    "end": 98.96,
    "duration": 3.2
  },
  {
    "id": 23,
    "text": "自为读者是机制，诗化语言是载体，",
    "start": 98.96,
    "end": 102.16,
    "duration": 3.2
  },
  {
    "id": 24,
    "text": "苏辛并称是最终定型。",
    "start": 102.16,
    "end": 104.08,
    "duration": 1.92
  },
  {
    "id": 25,
    "text": "理顺了宏观全局思路，接下来进入每一段的具体推导与逐句表述。",
    "start": 104.4,
    "end": 109.6,
    "duration": 5.2
  },
  {
    "id": 26,
    "text": "第一段：首段破题与概念定性。",
    "start": 109.6,
    "end": 112.48,
    "duration": 2.88
  },
  {
    "id": 27,
    "text": "逐句因果推导与答题表述。",
    "start": 112.48,
    "end": 114.88,
    "duration": 2.4
  },
  {
    "id": 28,
    "text": "首句必须直击核心地位，确立其北宋文坛领袖与词体变革家身份。",
    "start": 114.88,
    "end": 120.24,
    "duration": 5.36
  },
  {
    "id": 29,
    "text": "所以表述为：次句必须引入南宋词评家刘辰翁的千古总评，",
    "start": 120.24,
    "end": 125.2,
    "duration": 4.96
  },
  {
    "id": 30,
    "text": "定型其词作倾荡磊落的宏大风貌。",
    "start": 125.2,
    "end": 128.08,
    "duration": 2.88
  },
  {
    "id": 31,
    "text": "所以表述为：第三句引入考研权威教材的学术界定，",
    "start": 128.4,
    "end": 132.463,
    "duration": 4.063
  },
  {
    "id": 32,
    "text": "明确指出其核心机制是“以诗为词”。",
    "start": 132.463,
    "end": 135.195,
    "duration": 2.732
  },
  {
    "id": 33,
    "text": "所以表述为：第四句点明这场革命的对象，",
    "start": 135.195,
    "end": 138.512,
    "duration": 3.317
  },
  {
    "id": 34,
    "text": "打破五代以来词为艳科小道的观念束缚。",
    "start": 138.512,
    "end": 141.83,
    "duration": 3.318
  },
  {
    "id": 35,
    "text": "所以表述为：第五句指出其美学成就，",
    "start": 141.83,
    "end": 144.757,
    "duration": 2.927
  },
  {
    "id": 36,
    "text": "使词具备了与诗歌并驾齐驱的独立抒情地位。",
    "start": 144.757,
    "end": 148.464,
    "duration": 3.707
  },
  {
    "id": 37,
    "text": "所以表述为：第六句作为首段过渡句，",
    "start": 148.464,
    "end": 151.496,
    "duration": 3.032
  },
  {
    "id": 38,
    "text": "宣告下文将从四个核心维度展开系统论述。",
    "start": 151.496,
    "end": 155.656,
    "duration": 4.16
  },
  {
    "id": 39,
    "text": "所以表述为：本段答题思路总结。",
    "start": 155.656,
    "end": 158.536,
    "duration": 2.88
  },
  {
    "id": 40,
    "text": "本段用六句话完成立论闭环：先直接亮出词体变革家定性；",
    "start": 158.536,
    "end": 163.816,
    "duration": 5.28
  },
  {
    "id": 41,
    "text": "随即引入刘辰翁“无所不可”的经典定评；",
    "start": 163.816,
    "end": 166.856,
    "duration": 3.04
  },
  {
    "id": 42,
    "text": "接着借助袁行配教材将“以诗为词”定型为核心机制，",
    "start": 166.856,
    "end": 171.336,
    "duration": 4.48
  },
  {
    "id": 43,
    "text": "点明破除艳科小道传统偏见的历史功绩；",
    "start": 171.336,
    "end": 174.616,
    "duration": 3.28
  },
  {
    "id": 44,
    "text": "最后自然引出四个分论点，开篇严谨规范。",
    "start": 174.856,
    "end": 178.376,
    "duration": 3.52
  },
  {
    "id": 45,
    "text": "所以本段具体答题完整版为：第二段：第一分论点，",
    "start": 178.376,
    "end": 182.696,
    "duration": 4.32
  },
  {
    "id": 46,
    "text": "题材边界的全面拓宽（境之“阔”）。",
    "start": 182.696,
    "end": 185.736,
    "duration": 3.04
  },
  {
    "id": 47,
    "text": "逐句因果推导与答题表述。",
    "start": 185.736,
    "end": 188.216,
    "duration": 2.48
  },
  {
    "id": 48,
    "text": "论述以诗入词，首先必须回答词的描写对象发生了怎样的翻天覆地变化。",
    "start": 188.216,
    "end": 194.136,
    "duration": 5.92
  },
  {
    "id": 49,
    "text": "首句确立分论点，指出晚唐五代以来词被死死禁锢于相思离怨与樽前酒色的狭窄牢笼。",
    "start": 194.456,
    "end": 202.216,
    "duration": 7.76
  },
  {
    "id": 50,
    "text": "所以表述为：次句指出苏轼的突破，",
    "start": 202.216,
    "end": 205.496,
    "duration": 3.28
  },
  {
    "id": 51,
    "text": "以开阔胸襟打破藩篱，将诗歌全部题材引入词中。",
    "start": 205.496,
    "end": 210.296,
    "duration": 4.8
  },
  {
    "id": 52,
    "text": "所以表述为：第三句调取怀古咏史的千古名篇，",
    "start": 210.296,
    "end": 214.456,
    "duration": 4.16
  },
  {
    "id": 53,
    "text": "展现赤壁万古风流的大境界。",
    "start": 214.456,
    "end": 216.616,
    "duration": 2.16
  },
  {
    "id": 54,
    "text": "所以表述为：第四句调取报国杀敌的密州出猎，",
    "start": 216.776,
    "end": 221.014,
    "duration": 4.238
  },
  {
    "id": 55,
    "text": "展现挽弓射天狼的边塞壮志。",
    "start": 221.014,
    "end": 223.69,
    "duration": 2.676
  },
  {
    "id": 56,
    "text": "所以表述为：第五句调取悼念亡妻的悼亡绝唱，",
    "start": 223.69,
    "end": 227.928,
    "duration": 4.238
  },
  {
    "id": 57,
    "text": "展现十年生死的真纯人伦情感。",
    "start": 227.928,
    "end": 230.827,
    "duration": 2.899
  },
  {
    "id": 58,
    "text": "所以表述为：第六句调取描写农村生活的生动词章，",
    "start": 230.827,
    "end": 235.511,
    "duration": 4.684
  },
  {
    "id": 59,
    "text": "展现枣花骚车、卖瓜老农的质朴生活。",
    "start": 235.511,
    "end": 238.856,
    "duration": 3.345
  },
  {
    "id": 60,
    "text": "所以表述为：第七句总结收束全段，",
    "start": 239.016,
    "end": 242.201,
    "duration": 3.185
  },
  {
    "id": 61,
    "text": "指出无事不可入词使词具备了反映全部社会的广阔容量。",
    "start": 242.201,
    "end": 247.785,
    "duration": 5.584
  },
  {
    "id": 62,
    "text": "所以表述为：本段答题思路总结。",
    "start": 247.785,
    "end": 250.809,
    "duration": 3.024
  },
  {
    "id": 63,
    "text": "本段是题材革命的核心展现：先揭示晚唐花间词狭隘的艳科牢笼；",
    "start": 250.809,
    "end": 257.091,
    "duration": 6.282
  },
  {
    "id": 64,
    "text": "随后以排比之势调取赤壁怀古之雄奇、",
    "start": 257.091,
    "end": 260.814,
    "duration": 3.723
  },
  {
    "id": 65,
    "text": "密州出猎之报国、悼念亡妻之真情、",
    "start": 260.814,
    "end": 264.071,
    "duration": 3.257
  },
  {
    "id": 66,
    "text": "田园乡村之清新四大经典文本；",
    "start": 264.071,
    "end": 267.096,
    "duration": 3.025
  },
  {
    "id": 67,
    "text": "全面论证了苏轼如何实现“无事不可入，",
    "start": 267.176,
    "end": 270.696,
    "duration": 3.52
  },
  {
    "id": 68,
    "text": "无意不可言”，彻底颠覆了词为花间软调的旧习。",
    "start": 270.696,
    "end": 275.176,
    "duration": 4.48
  },
  {
    "id": 69,
    "text": "所以本段具体答题完整版为：第三段：第二分论点，",
    "start": 275.176,
    "end": 279.736,
    "duration": 4.56
  },
  {
    "id": 70,
    "text": "情志品格与意境升华（志之“旷”）。",
    "start": 279.736,
    "end": 283.096,
    "duration": 3.36
  },
  {
    "id": 71,
    "text": "逐句因果推导与答题表述。",
    "start": 283.096,
    "end": 285.576,
    "duration": 2.48
  },
  {
    "id": 72,
    "text": "题材拓宽之后，第三段必须正面论述其情感格调上的根本跃升，",
    "start": 285.576,
    "end": 290.936,
    "duration": 5.36
  },
  {
    "id": 73,
    "text": "也就是旷达人格的注入。",
    "start": 290.936,
    "end": 292.776,
    "duration": 1.84
  },
  {
    "id": 74,
    "text": "首句立论，指出传统词在格调上偏重企靡柔弱与凄凉感伤。",
    "start": 293.096,
    "end": 298.776,
    "duration": 5.68
  },
  {
    "id": 75,
    "text": "所以表述为：次句指出苏轼的升华，",
    "start": 298.776,
    "end": 301.656,
    "duration": 2.88
  },
  {
    "id": 76,
    "text": "将士大夫崇高旷达的精神人格注入词中，",
    "start": 301.656,
    "end": 305.336,
    "duration": 3.68
  },
  {
    "id": 77,
    "text": "开创豪放与旷达新境。",
    "start": 305.336,
    "end": 307.336,
    "duration": 2.0
  },
  {
    "id": 78,
    "text": "所以表述为：第三句调取黄州乌台诗案后最具代表性的旷达绝唱《定风波》。",
    "start": 307.72,
    "end": 314.026,
    "duration": 6.306
  },
  {
    "id": 79,
    "text": "所以表述为：第四句剖析这种从容心态，",
    "start": 314.026,
    "end": 317.416,
    "duration": 3.39
  },
  {
    "id": 80,
    "text": "面对政治风雨与生死考验展现出超然脱俗的胸襟。",
    "start": 317.416,
    "end": 321.866,
    "duration": 4.45
  },
  {
    "id": 81,
    "text": "所以表述为：第五句追踪尾联，引用“也无风雨也无晴”的超凡通透之语。",
    "start": 321.866,
    "end": 327.8,
    "duration": 5.934
  },
  {
    "id": 82,
    "text": "所以表述为：第六句总结收束全段，",
    "start": 327.96,
    "end": 330.893,
    "duration": 2.933
  },
  {
    "id": 83,
    "text": "指出词摆脱了倡条冶叶性质，成为士大夫安顿生命风骨的高雅载体。",
    "start": 330.893,
    "end": 336.867,
    "duration": 5.974
  },
  {
    "id": 84,
    "text": "所以表述为：本段答题思路总结。",
    "start": 336.867,
    "end": 339.64,
    "duration": 2.773
  },
  {
    "id": 85,
    "text": "本段聚焦于词体精神品格的升华：对比传统艳词的凄楚感伤，",
    "start": 339.64,
    "end": 344.973,
    "duration": 5.333
  },
  {
    "id": 86,
    "text": "阐明苏轼以浩然之气入词的飞跃；",
    "start": 344.973,
    "end": 347.96,
    "duration": 2.987
  },
  {
    "id": 87,
    "text": "以黄州《定风波》为核心解剖切片，",
    "start": 348.04,
    "end": 350.92,
    "duration": 2.88
  },
  {
    "id": 88,
    "text": "剖析一蓑烟雨、竹杖芒鞋与也无风雨也无晴的崇高心境；",
    "start": 350.92,
    "end": 356.84,
    "duration": 5.92
  },
  {
    "id": 89,
    "text": "有力论证了词体从倡优歌妓手中的流行小调，",
    "start": 356.84,
    "end": 361.08,
    "duration": 4.24
  },
  {
    "id": 90,
    "text": "升华为士大夫安顿心灵、超越逆境的精神高地。",
    "start": 361.08,
    "end": 365.24,
    "duration": 4.16
  },
  {
    "id": 91,
    "text": "所以本段具体答题完整版为：第四段：第三分论点，",
    "start": 365.24,
    "end": 369.72,
    "duration": 4.48
  },
  {
    "id": 92,
    "text": "机制与功能的根本变革（体之“立”）。",
    "start": 369.72,
    "end": 372.92,
    "duration": 3.2
  },
  {
    "id": 93,
    "text": "逐句因果推导与答题表述。",
    "start": 373.16,
    "end": 375.56,
    "duration": 2.4
  },
  {
    "id": 94,
    "text": "前两段解决了内容与情志，第四段必须深入到词的体制机制与传播功能的根本转变。",
    "start": 375.56,
    "end": 382.84,
    "duration": 7.28
  },
  {
    "id": 95,
    "text": "首句立论，指出传统词完全依附于音乐曲调，",
    "start": 382.84,
    "end": 386.76,
    "duration": 3.92
  },
  {
    "id": 96,
    "text": "以迎合听众歌唱为单一目的。",
    "start": 386.76,
    "end": 389.16,
    "duration": 2.4
  },
  {
    "id": 97,
    "text": "所以表述为：次句指出苏轼的核心变革，",
    "start": 389.16,
    "end": 392.68,
    "duration": 3.52
  },
  {
    "id": 98,
    "text": "推动词走向案头化与读者化，使其成为独立的文人文学。",
    "start": 392.68,
    "end": 397.16,
    "duration": 4.48
  },
  {
    "id": 99,
    "text": "所以表述为：第三句指出体制创举，",
    "start": 397.56,
    "end": 400.699,
    "duration": 3.139
  },
  {
    "id": 100,
    "text": "广泛确立了在词前配加“题序”与小传的惯例。",
    "start": 400.699,
    "end": 404.824,
    "duration": 4.125
  },
  {
    "id": 101,
    "text": "所以表述为：第四句调取《水调歌头》欢饮达旦兼怀子由的著名题序原句。",
    "start": 404.824,
    "end": 411.47,
    "duration": 6.646
  },
  {
    "id": 102,
    "text": "所以表述为：第五句剖析题序的功能，",
    "start": 411.47,
    "end": 414.908,
    "duration": 3.438
  },
  {
    "id": 103,
    "text": "赋予了词作清晰的时空背景、创作由头与真实情态。",
    "start": 414.908,
    "end": 419.72,
    "duration": 4.812
  },
  {
    "id": 104,
    "text": "所以表述为：第六句回应李清照“词别是一家”的学术争论，",
    "start": 419.88,
    "end": 424.792,
    "duration": 4.912
  },
  {
    "id": 105,
    "text": "指出打破依声填词在文学史上的进步性。",
    "start": 424.792,
    "end": 428.464,
    "duration": 3.672
  },
  {
    "id": 106,
    "text": "所以表述为：第七句总结收束，指出这标志着词打破曲调奴役，",
    "start": 428.464,
    "end": 433.864,
    "duration": 5.4
  },
  {
    "id": 107,
    "text": "走上了纯文学抒情的自主道路。",
    "start": 433.864,
    "end": 436.672,
    "duration": 2.808
  },
  {
    "id": 108,
    "text": "所以表述为：本段答题思路总结。",
    "start": 436.672,
    "end": 439.48,
    "duration": 2.808
  },
  {
    "id": 109,
    "text": "本段体现了深刻的文学史机制辨析：先点明词从“歌妓口中歌唱”到“文人案头阅读”的功能位移；",
    "start": 439.616,
    "end": 447.776,
    "duration": 8.16
  },
  {
    "id": 110,
    "text": "接着论述增设题序对赋予词作独立叙事背景的关键作用；",
    "start": 447.776,
    "end": 452.496,
    "duration": 4.72
  },
  {
    "id": 111,
    "text": "最后辩证剖析李清照评其为“句读不气之诗”的公案，",
    "start": 452.496,
    "end": 456.896,
    "duration": 4.4
  },
  {
    "id": 112,
    "text": "指出打破音律绳墨正是词体走向纯文学自觉的必然代价与崇高胜利。",
    "start": 456.896,
    "end": 462.496,
    "duration": 5.6
  },
  {
    "id": 113,
    "text": "所以本段具体答题完整版为：第五段：第四分论点，",
    "start": 462.816,
    "end": 467.136,
    "duration": 4.32
  },
  {
    "id": 114,
    "text": "语言体制的清雄雅健（言之“劲”）。",
    "start": 467.136,
    "end": 470.176,
    "duration": 3.04
  },
  {
    "id": 115,
    "text": "逐句因果推导与答题表述。",
    "start": 470.176,
    "end": 472.496,
    "duration": 2.32
  },
  {
    "id": 116,
    "text": "在解决了体制机制之后，本段必须进一步下沉到语言文字与表现技法的具体革新。",
    "start": 472.496,
    "end": 479.456,
    "duration": 6.96
  },
  {
    "id": 117,
    "text": "首句确立分论点，指出苏轼在语言风格上进行荡涤，",
    "start": 479.456,
    "end": 483.856,
    "duration": 4.4
  },
  {
    "id": 118,
    "text": "以诗文句法取代脂粉气。",
    "start": 483.856,
    "end": 485.936,
    "duration": 2.08
  },
  {
    "id": 119,
    "text": "所以表述为：次句指出其语言渊源，",
    "start": 486.256,
    "end": 489.65,
    "duration": 3.394
  },
  {
    "id": 120,
    "text": "大量吸纳诗歌古文的炼字造句技法。",
    "start": 489.65,
    "end": 493.382,
    "duration": 3.732
  },
  {
    "id": 121,
    "text": "所以表述为：第三句调取赤壁怀古描摹壮景的名句，",
    "start": 493.382,
    "end": 498.607,
    "duration": 5.225
  },
  {
    "id": 122,
    "text": "乱石穿空惊涛拍岸。",
    "start": 498.607,
    "end": 500.597,
    "duration": 1.99
  },
  {
    "id": 123,
    "text": "所以表述为：第四句分析其审美效果，",
    "start": 500.597,
    "end": 504.329,
    "duration": 3.732
  },
  {
    "id": 124,
    "text": "骨力强劲、神采飞扬，毫无雕琢粉饰与黏滞软媚。",
    "start": 504.329,
    "end": 509.056,
    "duration": 4.727
  },
  {
    "id": 125,
    "text": "所以表述为：第五句总结本段，指出这种语言革新极大增强了词的表现力与张力，",
    "start": 509.216,
    "end": 516.188,
    "duration": 6.972
  },
  {
    "id": 126,
    "text": "达到了化境。",
    "start": 516.188,
    "end": 517.253,
    "duration": 1.065
  },
  {
    "id": 127,
    "text": "所以表述为：本段答题思路总结。",
    "start": 517.253,
    "end": 520.02,
    "duration": 2.767
  },
  {
    "id": 128,
    "text": "本段聚焦于词体语言本体的重铸：阐明苏轼以诗文劲挺骨力扫除传统词风的企靡甜腻；",
    "start": 520.02,
    "end": 527.684,
    "duration": 7.664
  },
  {
    "id": 129,
    "text": "以“乱石穿空，惊涛拍岸，卷起千堆雪”为例，",
    "start": 527.684,
    "end": 531.09,
    "duration": 3.406
  },
  {
    "id": 130,
    "text": "剖析其清雄雅健、开阔激荡的句法特征；",
    "start": 531.09,
    "end": 534.496,
    "duration": 3.406
  },
  {
    "id": 131,
    "text": "全面论证了以诗入词如何使词语从低回曼声中解脱出来，",
    "start": 534.576,
    "end": 540.336,
    "duration": 5.76
  },
  {
    "id": 132,
    "text": "具备了与唐诗相媲美的阳刚骨力。",
    "start": 540.336,
    "end": 543.456,
    "duration": 3.12
  },
  {
    "id": 133,
    "text": "所以本段具体答题完整版为：第六段：尾段收官与文学史谱系闭环。",
    "start": 543.456,
    "end": 549.856,
    "duration": 6.4
  },
  {
    "id": 134,
    "text": "逐句因果推导与答题表述。",
    "start": 549.856,
    "end": 552.656,
    "duration": 2.8
  },
  {
    "id": 135,
    "text": "尾段作为三十分大题的收官，必须将苏轼置于词史纵向流变的宏大长河中定型。",
    "start": 552.656,
    "end": 559.056,
    "duration": 6.4
  },
  {
    "id": 136,
    "text": "首句综合前述四个维度，定评以诗为词是中国词史上最深刻的文体解放运动。",
    "start": 559.376,
    "end": 566.496,
    "duration": 7.12
  },
  {
    "id": 137,
    "text": "所以表述为：次句确立其历史地位，",
    "start": 566.496,
    "end": 569.726,
    "duration": 3.23
  },
  {
    "id": 138,
    "text": "指出他彻底改变了词的发展方向，奠定了豪放词派基石。",
    "start": 569.726,
    "end": 575.016,
    "duration": 5.29
  },
  {
    "id": 139,
    "text": "所以表述为：第三句向南宋顺流推进，",
    "start": 575.016,
    "end": 578.466,
    "duration": 3.45
  },
  {
    "id": 140,
    "text": "点出其对辛弃疾、陈亮、刘过等爱国词人的直接哺育。",
    "start": 578.466,
    "end": 583.296,
    "duration": 4.83
  },
  {
    "id": 141,
    "text": "所以表述为：第四句以“苏辛并称”得出经典学术定评，",
    "start": 583.456,
    "end": 588.024,
    "duration": 4.568
  },
  {
    "id": 142,
    "text": "指出其成为词史上豪迈雄奇精神的最崇高象征。",
    "start": 588.024,
    "end": 592.431,
    "duration": 4.407
  },
  {
    "id": 143,
    "text": "所以表述为：本段答题思路总结。",
    "start": 592.431,
    "end": 595.296,
    "duration": 2.865
  },
  {
    "id": 144,
    "text": "本段以极其严密的流派谱系完成论证闭环：先用两句话提炼以诗为词在文体解放与豪放派奠基上的历史功绩；",
    "start": 595.424,
    "end": 605.344,
    "duration": 9.92
  },
  {
    "id": 145,
    "text": "随后顺流而下，清晰展现由北宋苏轼发端，",
    "start": 605.344,
    "end": 609.184,
    "duration": 3.84
  },
  {
    "id": 146,
    "text": "最终在南宋辛弃疾、陈亮爱国抗金词潮中蔚为大观的演进全貌；",
    "start": 609.184,
    "end": 614.784,
    "duration": 5.6
  },
  {
    "id": 147,
    "text": "以“苏辛并称”统摄全篇，使整道三十分大题在雄浑深远的宋词演进史中圆满收官。",
    "start": 614.784,
    "end": 622.064,
    "duration": 7.28
  },
  {
    "id": 148,
    "text": "所以本段具体答题完整版为：整道大题的内在逻辑链总括。",
    "start": 622.464,
    "end": 627.024,
    "duration": 4.56
  },
  {
    "id": 149,
    "text": "这道三十分大题的本质，是一场极度严密的逻辑推演。",
    "start": 627.024,
    "end": 631.184,
    "duration": 4.16
  },
  {
    "id": 150,
    "text": "整篇答卷从头到尾遵循着“由典范定评、",
    "start": 631.184,
    "end": 634.784,
    "duration": 3.6
  },
  {
    "id": 151,
    "text": "到题材拓宽、到旷达情志、到脱离歌妓、",
    "start": 634.784,
    "end": 638.304,
    "duration": 3.52
  },
  {
    "id": 152,
    "text": "到清雄语言、最终回归苏辛并称”的必然法则。",
    "start": 638.304,
    "end": 642.064,
    "duration": 3.76
  },
  {
    "id": 153,
    "text": "阅卷老师看到的绝不是散乱的答题点，",
    "start": 642.304,
    "end": 645.184,
    "duration": 2.88
  },
  {
    "id": 154,
    "text": "而是一条咬合紧密的因果长链：第一步是“立论定性”，",
    "start": 645.184,
    "end": 650.064,
    "duration": 4.88
  },
  {
    "id": 155,
    "text": "开门见山借刘辰翁“无所不可”与袁本教材，",
    "start": 650.064,
    "end": 654.064,
    "duration": 4.0
  },
  {
    "id": 156,
    "text": "确立苏轼“以诗为词”推动词体解放的至高坐标。",
    "start": 654.064,
    "end": 658.624,
    "duration": 4.56
  },
  {
    "id": 157,
    "text": "第二步是“题材突破”，以赤壁怀古、",
    "start": 658.624,
    "end": 661.504,
    "duration": 2.88
  },
  {
    "id": 158,
    "text": "密州射天狼、悼亡长恨与田园风光，",
    "start": 661.504,
    "end": 664.864,
    "duration": 3.36
  },
  {
    "id": 159,
    "text": "证明打破花间艳科藩篱与无事不可入词。",
    "start": 664.864,
    "end": 668.464,
    "duration": 3.6
  },
  {
    "id": 160,
    "text": "第三步是“情志升华”，以黄州《定风波》“一蓑烟雨任平生”，",
    "start": 668.784,
    "end": 673.904,
    "duration": 5.12
  },
  {
    "id": 161,
    "text": "阐明由柔媚感伤转向士大夫崇高旷达的生命境界。",
    "start": 673.904,
    "end": 678.144,
    "duration": 4.24
  },
  {
    "id": 162,
    "text": "第四步是“功能位移”，以摆脱歌场案头化与增设题序，",
    "start": 678.144,
    "end": 682.944,
    "duration": 4.8
  },
  {
    "id": 163,
    "text": "辩证回应李清照“词别是一家”，论证走向纯文学抒情的自主道路。",
    "start": 682.944,
    "end": 688.224,
    "duration": 5.28
  },
  {
    "id": 164,
    "text": "第五步是“语言重铸”，以“乱石穿空惊涛拍岸”，",
    "start": 688.464,
    "end": 693.024,
    "duration": 4.56
  },
  {
    "id": 165,
    "text": "阐明以诗文骨力取代脂粉软媚的清雄雅健之风。",
    "start": 693.024,
    "end": 697.904,
    "duration": 4.88
  },
  {
    "id": 166,
    "text": "第六步是“史学闭环”，把苏轼词自然引向南宋辛弃疾、",
    "start": 697.904,
    "end": 702.944,
    "duration": 5.04
  },
  {
    "id": 167,
    "text": "陈亮爱国词人集团，确立“苏辛并称”的千古豪放词史坐标。",
    "start": 702.944,
    "end": 708.384,
    "duration": 5.44
  },
  {
    "id": 168,
    "text": "这六步层层递进，前一步的结论必然成为后一步的前提。",
    "start": 708.384,
    "end": 713.024,
    "duration": 4.64
  },
  {
    "id": 169,
    "text": "你在考场上顺着因果关系顺流而下，",
    "start": 713.344,
    "end": 716.064,
    "duration": 2.72
  },
  {
    "id": 170,
    "text": "就能自然写出近千字的满分答卷。",
    "start": 716.064,
    "end": 718.304,
    "duration": 2.24
  }
]