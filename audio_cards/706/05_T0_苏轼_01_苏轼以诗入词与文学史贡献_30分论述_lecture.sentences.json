[
  {
    "id": 1,
    "text": "全局宏观破题与立论逻辑。",
    "start": 0.16,
    "end": 2.96,
    "duration": 2.8
  },
  {
    "id": 2,
    "text": "在考场下笔之前，必须先在宏观上审清这道三十分大题的核心考核意图。",
    "start": 2.96,
    "end": 8.72,
    "duration": 5.76
  },
  {
    "id": 3,
    "text": "本题表面上考查苏轼词的艺术特点，",
    "start": 8.72,
    "end": 11.52,
    "duration": 2.8
  },
  {
    "id": 4,
    "text": "本质上考查宋代文人对词体文学属性的革命性重构。",
    "start": 11.52,
    "end": 16.16,
    "duration": 4.64
  },
  {
    "id": 5,
    "text": "考场评分标准绝不满足于仅列举几首豪放词的名句。",
    "start": 16.16,
    "end": 20.08,
    "duration": 3.92
  },
  {
    "id": 6,
    "text": "答题方向必须确立为“从题材打破艳科小道，",
    "start": 20.4,
    "end": 24.56,
    "duration": 4.16
  },
  {
    "id": 7,
    "text": "推进到情志升华豪迈旷达，再深入到摆脱音乐羁绊的机制变革，",
    "start": 24.56,
    "end": 31.04,
    "duration": 6.48
  },
  {
    "id": 8,
    "text": "最终落地至语言体制与后代辛派承续”的因果推进。",
    "start": 31.04,
    "end": 35.84,
    "duration": 4.8
  },
  {
    "id": 9,
    "text": "整道大题在宏观上划分为五个有机递进的逻辑层次：第一层，",
    "start": 35.84,
    "end": 41.28,
    "duration": 5.44
  },
  {
    "id": 10,
    "text": "开篇破题，借刘辰翁“倾荡磊落”定评与袁行配教材，",
    "start": 41.28,
    "end": 46.64,
    "duration": 5.36
  },
  {
    "id": 11,
    "text": "确立其作为词体革命领袖的至高坐标。",
    "start": 46.64,
    "end": 49.6,
    "duration": 2.96
  },
  {
    "id": 12,
    "text": "第二层，论述题材边界，剖析如何打破花间规阁局限，",
    "start": 49.92,
    "end": 54.56,
    "duration": 4.64
  },
  {
    "id": 13,
    "text": "实现无事不可入词、无意不可表达。",
    "start": 54.56,
    "end": 57.52,
    "duration": 2.96
  },
  {
    "id": 14,
    "text": "第三层，论述情志意境，以《定风波》“一蓑烟雨任平生”为例，",
    "start": 57.52,
    "end": 62.4,
    "duration": 4.88
  },
  {
    "id": 15,
    "text": "阐释由柔媚感伤转向崇高旷达的生命境界。",
    "start": 62.4,
    "end": 66.24,
    "duration": 3.84
  },
  {
    "id": 16,
    "text": "第四层，论述机制与功能，剖析脱离歌妓案头化、",
    "start": 66.24,
    "end": 70.4,
    "duration": 4.16
  },
  {
    "id": 17,
    "text": "增设题序，以及对李清照“词别是一家”争论的正确认知。",
    "start": 70.4,
    "end": 74.48,
    "duration": 4.08
  },
  {
    "id": 18,
    "text": "第五层，落地至语言体制，阐释以诗文句法入词，",
    "start": 74.8,
    "end": 79.44,
    "duration": 4.64
  },
  {
    "id": 19,
    "text": "实现清雄雅健、扫荡脂粉的语言革新。",
    "start": 79.44,
    "end": 82.96,
    "duration": 3.52
  },
  {
    "id": 20,
    "text": "尾部收官，以“苏辛并称”定性，交代其对南宋辛派爱国词人集团的伟大开拓。",
    "start": 82.96,
    "end": 89.6,
    "duration": 6.64
  },
  {
    "id": 21,
    "text": "这五个层次构成一条不可逆的因果链条：破除艳科是前提，",
    "start": 89.6,
    "end": 94.8,
    "duration": 5.2
  },
  {
    "id": 22,
    "text": "题材扩展是基础，旷达人格是灵魂，",
    "start": 94.8,
    "end": 98.0,
    "duration": 3.2
  },
  {
    "id": 23,
    "text": "自为读者是机制，诗化语言是载体，",
    "start": 98.0,
    "end": 101.2,
    "duration": 3.2
  },
  {
    "id": 24,
    "text": "苏辛并称是最终定型。",
    "start": 101.2,
    "end": 103.12,
    "duration": 1.92
  },
  {
    "id": 25,
    "text": "理顺了宏观全局思路，接下来进入每一段的具体推导与逐句表述。",
    "start": 103.44,
    "end": 109.12,
    "duration": 5.68
  },
  {
    "id": 26,
    "text": "--。第",
    "start": 109.12,
    "end": 109.28,
    "duration": 0.16
  },
  {
    "id": 27,
    "text": "一段：首段破题与概念定性。",
    "start": 109.28,
    "end": 112.0,
    "duration": 2.72
  },
  {
    "id": 28,
    "text": "逐句因果推导与答题表述。",
    "start": 112.0,
    "end": 114.4,
    "duration": 2.4
  },
  {
    "id": 29,
    "text": "首句必须直击核心地位，确立其北宋文坛领袖与词体变革家身份。",
    "start": 114.4,
    "end": 119.92,
    "duration": 5.52
  },
  {
    "id": 30,
    "text": "所以表述为：苏轼是北宋文坛领袖，",
    "start": 119.92,
    "end": 123.2,
    "duration": 3.28
  },
  {
    "id": 31,
    "text": "更是中国词史上最伟大的文体变革家。",
    "start": 123.2,
    "end": 126.24,
    "duration": 3.04
  },
  {
    "id": 32,
    "text": "次句必须引入南宋词评家刘辰翁的千古总评，",
    "start": 126.56,
    "end": 130.48,
    "duration": 3.92
  },
  {
    "id": 33,
    "text": "定型其词作倾荡磊落的宏大风貌。",
    "start": 130.48,
    "end": 133.76,
    "duration": 3.28
  },
  {
    "id": 34,
    "text": "所以表述为：南宋刘辰翁在《辛稼轩词序》中极评其词：“词至东坡，",
    "start": 133.76,
    "end": 140.48,
    "duration": 6.72
  },
  {
    "id": 35,
    "text": "倾荡磊落，如诗，如文，如曲，无所不可”。",
    "start": 140.48,
    "end": 145.12,
    "duration": 4.64
  },
  {
    "id": 36,
    "text": "第三句引入考研权威教材的学术界定，",
    "start": 145.12,
    "end": 148.24,
    "duration": 3.12
  },
  {
    "id": 37,
    "text": "明确指出其核心机制是“以诗为词”。",
    "start": 148.24,
    "end": 151.6,
    "duration": 3.36
  },
  {
    "id": 38,
    "text": "所以表述为：袁行配《中国文学史》指出，",
    "start": 151.6,
    "end": 155.256,
    "duration": 3.656
  },
  {
    "id": 39,
    "text": "苏轼通过“以诗为词”推动了词体革命。",
    "start": 155.256,
    "end": 159.016,
    "duration": 3.76
  },
  {
    "id": 40,
    "text": "第四句点明这场革命的对象，打破五代以来词为艳科小道的观念束缚。",
    "start": 159.016,
    "end": 165.256,
    "duration": 6.24
  },
  {
    "id": 41,
    "text": "所以表述为：他彻底打破了五代以来词为“艳科、",
    "start": 165.256,
    "end": 169.416,
    "duration": 4.16
  },
  {
    "id": 42,
    "text": "小道”的世俗传统观念。",
    "start": 169.416,
    "end": 171.096,
    "duration": 1.68
  },
  {
    "id": 43,
    "text": "第五句指出其美学成就，使词具备了与诗歌并驾齐驱的独立抒情地位。",
    "start": 171.416,
    "end": 177.96,
    "duration": 6.544
  },
  {
    "id": 44,
    "text": "所以表述为：苏轼赋予了词与传统诗歌并驾齐驱的独立抒情地位与崇高美学品格。",
    "start": 177.96,
    "end": 185.471,
    "duration": 7.511
  },
  {
    "id": 45,
    "text": "第六句作为首段过渡句，宣告下文将从四个核心维度展开系统论述。",
    "start": 185.471,
    "end": 191.656,
    "duration": 6.185
  },
  {
    "id": 46,
    "text": "所以表述为：其具体的文学史贡献与艺术机制，",
    "start": 191.816,
    "end": 195.656,
    "duration": 3.84
  },
  {
    "id": 47,
    "text": "主要展现在以下四个核心维度：本段答题思路总结。",
    "start": 195.656,
    "end": 200.136,
    "duration": 4.48
  },
  {
    "id": 48,
    "text": "本段用六句话完成立论闭环：先直接亮出词体变革家定性；",
    "start": 200.136,
    "end": 205.336,
    "duration": 5.2
  },
  {
    "id": 49,
    "text": "随即引入刘辰翁“无所不可”的经典定评；",
    "start": 205.336,
    "end": 208.616,
    "duration": 3.28
  },
  {
    "id": 50,
    "text": "接着借助袁行配教材将“以诗为词”定型为核心机制，",
    "start": 208.616,
    "end": 213.416,
    "duration": 4.8
  },
  {
    "id": 51,
    "text": "点明破除艳科小道传统偏见的历史功绩；",
    "start": 213.416,
    "end": 216.616,
    "duration": 3.2
  },
  {
    "id": 52,
    "text": "最后自然引出四个分论点，开篇严谨规范。",
    "start": 216.936,
    "end": 220.216,
    "duration": 3.28
  },
  {
    "id": 53,
    "text": "所以本段具体答题完整版为：苏轼是北宋文坛领袖，",
    "start": 220.216,
    "end": 224.376,
    "duration": 4.16
  },
  {
    "id": 54,
    "text": "更是中国词史上最伟大的文体变革家。",
    "start": 224.376,
    "end": 227.496,
    "duration": 3.12
  },
  {
    "id": 55,
    "text": "南宋刘辰翁在《辛稼轩词序》中极评其词：“词至东坡，",
    "start": 227.496,
    "end": 232.136,
    "duration": 4.64
  },
  {
    "id": 56,
    "text": "倾荡磊落，如诗，如文，如曲，无所不可”。",
    "start": 232.136,
    "end": 235.896,
    "duration": 3.76
  },
  {
    "id": 57,
    "text": "袁行配《中国文学史》指出，苏轼通过“以诗为词”推动了词体革命。",
    "start": 236.216,
    "end": 241.576,
    "duration": 5.36
  },
  {
    "id": 58,
    "text": "他彻底打破了五代以来词为“艳科、",
    "start": 241.576,
    "end": 244.856,
    "duration": 3.28
  },
  {
    "id": 59,
    "text": "小道”的世俗传统观念。",
    "start": 244.856,
    "end": 247.016,
    "duration": 2.16
  },
  {
    "id": 60,
    "text": "苏轼赋予了词与传统诗歌并驾齐驱的独立抒情地位与崇高美学品格。",
    "start": 247.016,
    "end": 253.416,
    "duration": 6.4
  },
  {
    "id": 61,
    "text": "其具体的文学史贡献与艺术机制，主要展现在以下四个核心维度：第二段：第一分论点，",
    "start": 253.416,
    "end": 260.696,
    "duration": 7.28
  },
  {
    "id": 62,
    "text": "题材边界的全面拓宽（境之“阔”）。",
    "start": 260.696,
    "end": 263.656,
    "duration": 2.96
  },
  {
    "id": 63,
    "text": "逐句因果推导与答题表述。",
    "start": 263.656,
    "end": 266.216,
    "duration": 2.56
  },
  {
    "id": 64,
    "text": "论述以诗入词，首先必须回答词的描写对象发生了怎样的翻天覆地变化。",
    "start": 266.216,
    "end": 272.216,
    "duration": 6.0
  },
  {
    "id": 65,
    "text": "首句确立分论点，指出晚唐五代以来词被死死禁锢于相思离怨与樽前酒色的狭窄牢笼。",
    "start": 272.216,
    "end": 279.656,
    "duration": 7.44
  },
  {
    "id": 66,
    "text": "所以表述为：晚唐五代以来，词被死死禁锢于男女相思、",
    "start": 279.976,
    "end": 284.752,
    "duration": 4.776
  },
  {
    "id": 67,
    "text": "规阁离怨与樽前酒色的狭窄牢笼。",
    "start": 284.752,
    "end": 287.829,
    "duration": 3.077
  },
  {
    "id": 68,
    "text": "次句指出苏轼的突破，以开阔胸襟打破藩篱，",
    "start": 287.829,
    "end": 291.786,
    "duration": 3.957
  },
  {
    "id": 69,
    "text": "将诗歌全部题材引入词中。",
    "start": 291.786,
    "end": 294.204,
    "duration": 2.418
  },
  {
    "id": 70,
    "text": "所以表述为：苏轼以开阔的胸襟打破这一藩篱，",
    "start": 294.204,
    "end": 298.38,
    "duration": 4.176
  },
  {
    "id": 71,
    "text": "将诗歌所能涵盖的一切生活内容全面引入词中。",
    "start": 298.38,
    "end": 302.776,
    "duration": 4.396
  },
  {
    "id": 72,
    "text": "第三句调取怀古咏史的千古名篇，展现赤壁万古风流的大境界。",
    "start": 302.912,
    "end": 308.592,
    "duration": 5.68
  },
  {
    "id": 73,
    "text": "所以表述为：在怀古咏史时，《念奴娇•赤壁怀古》写出“大江东去，",
    "start": 308.592,
    "end": 314.672,
    "duration": 6.08
  },
  {
    "id": 74,
    "text": "浪淘尽，千古风流人物”的万古苍茫。",
    "start": 314.672,
    "end": 318.272,
    "duration": 3.6
  },
  {
    "id": 75,
    "text": "第四句调取报国杀敌的密州出猎，展现挽弓射天狼的边塞壮志。",
    "start": 318.272,
    "end": 323.712,
    "duration": 5.44
  },
  {
    "id": 76,
    "text": "所以表述为：在报国杀敌时，《江城子•密州出猎》写出“会挽雕弓如满月，",
    "start": 324.032,
    "end": 330.33,
    "duration": 6.298
  },
  {
    "id": 77,
    "text": "西北望，射天狼”的边塞壮志。",
    "start": 330.33,
    "end": 332.927,
    "duration": 2.597
  },
  {
    "id": 78,
    "text": "第五句调取悼念亡妻的悼亡绝唱，展现十年生死的真纯人伦情感。",
    "start": 332.927,
    "end": 339.301,
    "duration": 6.374
  },
  {
    "id": 79,
    "text": "所以表述为：在悼念亡妻时，《江城子•乙卯正月二十日夜记梦》写出“十年生死两茫茫”的至情哀痛。",
    "start": 339.301,
    "end": 348.272,
    "duration": 8.971
  },
  {
    "id": 80,
    "text": "第六句调取描写农村生活的生动词章，",
    "start": 348.352,
    "end": 351.712,
    "duration": 3.36
  },
  {
    "id": 81,
    "text": "展现枣花骚车、卖瓜老农的质朴生活。",
    "start": 351.712,
    "end": 355.392,
    "duration": 3.68
  },
  {
    "id": 82,
    "text": "所以表述为：在描摹田园时，《浣溪沙》写出“簌簌衣巾落枣花，",
    "start": 355.392,
    "end": 361.152,
    "duration": 5.76
  },
  {
    "id": 83,
    "text": "村南村北响骚车”的质朴生机。",
    "start": 361.152,
    "end": 364.032,
    "duration": 2.88
  },
  {
    "id": 84,
    "text": "第七句总结收束全段，指出无事不可入词使词具备了反映全部社会的广阔容量。",
    "start": 364.032,
    "end": 370.832,
    "duration": 6.8
  },
  {
    "id": 85,
    "text": "所以表述为：苏轼真正做到了无事不可入词、",
    "start": 371.152,
    "end": 375.472,
    "duration": 4.32
  },
  {
    "id": 86,
    "text": "无意不可表达，使词具备了反映全部社会生活的广阔容量。",
    "start": 375.472,
    "end": 381.152,
    "duration": 5.68
  },
  {
    "id": 87,
    "text": "本段答题思路总结。",
    "start": 381.152,
    "end": 382.992,
    "duration": 1.84
  },
  {
    "id": 88,
    "text": "本段是题材革命的核心展现：先揭示晚唐花间词狭隘的艳科牢笼；",
    "start": 382.992,
    "end": 389.632,
    "duration": 6.64
  },
  {
    "id": 89,
    "text": "随后以排比之势调取赤壁怀古之雄奇、",
    "start": 389.632,
    "end": 393.632,
    "duration": 4.0
  },
  {
    "id": 90,
    "text": "密州出猎之报国、悼念亡妻之真情、",
    "start": 393.632,
    "end": 397.312,
    "duration": 3.68
  },
  {
    "id": 91,
    "text": "田园乡村之清新四大经典文本；",
    "start": 397.312,
    "end": 400.432,
    "duration": 3.12
  },
  {
    "id": 92,
    "text": "全面论证了苏轼如何实现“无事不可入，",
    "start": 400.752,
    "end": 404.063,
    "duration": 3.311
  },
  {
    "id": 93,
    "text": "无意不可言”，彻底颠覆了词为花间软调的旧习。",
    "start": 404.063,
    "end": 408.389,
    "duration": 4.326
  },
  {
    "id": 94,
    "text": "所以本段具体答题完整版为：一、题材边界的全面拓宽：打破花间艳科藩篱与无事不可入词。",
    "start": 408.389,
    "end": 416.814,
    "duration": 8.425
  },
  {
    "id": 95,
    "text": "晚唐五代以来，词被死死禁锢于男女相思、",
    "start": 416.814,
    "end": 420.684,
    "duration": 3.87
  },
  {
    "id": 96,
    "text": "规阁离怨与樽前酒色的狭窄牢笼。",
    "start": 420.684,
    "end": 423.872,
    "duration": 3.188
  },
  {
    "id": 97,
    "text": "苏轼以开阔的胸襟打破这一藩篱，将诗歌所能涵盖的一切生活内容全面引入词中。",
    "start": 424.032,
    "end": 430.832,
    "duration": 6.8
  },
  {
    "id": 98,
    "text": "在怀古咏史时，《念奴娇•赤壁怀古》写出“大江东去，",
    "start": 430.832,
    "end": 435.952,
    "duration": 5.12
  },
  {
    "id": 99,
    "text": "浪淘尽，千古风流人物”的万古苍茫。",
    "start": 435.952,
    "end": 439.152,
    "duration": 3.2
  },
  {
    "id": 100,
    "text": "在报国杀敌时，《江城子•密州出猎》写出“会挽雕弓如满月，",
    "start": 439.152,
    "end": 444.272,
    "duration": 5.12
  },
  {
    "id": 101,
    "text": "西北望，射天狼”的边塞壮志。",
    "start": 444.272,
    "end": 446.672,
    "duration": 2.4
  },
  {
    "id": 102,
    "text": "在悼念亡妻时，《江城子•乙卯正月二十日夜记梦》写出“十年生死两茫茫”的至情哀痛。",
    "start": 446.992,
    "end": 453.632,
    "duration": 6.64
  },
  {
    "id": 103,
    "text": "在描摹田园时，《浣溪沙》写出“簌簌衣巾落枣花，",
    "start": 454.096,
    "end": 458.576,
    "duration": 4.48
  },
  {
    "id": 104,
    "text": "村南村北响骚车”的质朴生机。",
    "start": 458.576,
    "end": 461.616,
    "duration": 3.04
  },
  {
    "id": 105,
    "text": "苏轼真正做到了无事不可入词、无意不可表达，",
    "start": 461.616,
    "end": 466.096,
    "duration": 4.48
  },
  {
    "id": 106,
    "text": "使词具备了反映全部社会生活的广阔容量。。",
    "start": 466.096,
    "end": 469.936,
    "duration": 3.84
  },
  {
    "id": 107,
    "text": "第三段：第二分论点，情志品格与意境升华（志之“旷”）。",
    "start": 469.936,
    "end": 475.376,
    "duration": 5.44
  },
  {
    "id": 108,
    "text": "逐句因果推导与答题表述。",
    "start": 475.616,
    "end": 477.936,
    "duration": 2.32
  },
  {
    "id": 109,
    "text": "题材拓宽之后，第三段必须正面论述其情感格调上的根本跃升，",
    "start": 477.936,
    "end": 483.456,
    "duration": 5.52
  },
  {
    "id": 110,
    "text": "旷达人格的注入。",
    "start": 483.456,
    "end": 485.136,
    "duration": 1.68
  },
  {
    "id": 111,
    "text": "首句立论，指出传统词在格调上偏重企靡柔弱与凄凉感伤。",
    "start": 485.136,
    "end": 490.896,
    "duration": 5.76
  },
  {
    "id": 112,
    "text": "所以表述为：传统词体在情感格调上偏重企靡、",
    "start": 490.896,
    "end": 495.456,
    "duration": 4.56
  },
  {
    "id": 113,
    "text": "柔弱与凄楚感伤，充斥着羁旅与深规幽怨。",
    "start": 495.456,
    "end": 499.456,
    "duration": 4.0
  },
  {
    "id": 114,
    "text": "次句指出苏轼的升华，将士大夫崇高旷达的精神人格注入词中，",
    "start": 499.856,
    "end": 505.424,
    "duration": 5.568
  },
  {
    "id": 115,
    "text": "开创豪放与旷达新境。",
    "start": 505.424,
    "end": 507.44,
    "duration": 2.016
  },
  {
    "id": 116,
    "text": "所以表述为：苏轼将士大夫崇高旷达的精神人格注入词中，",
    "start": 507.44,
    "end": 512.816,
    "duration": 5.376
  },
  {
    "id": 117,
    "text": "开创了豪放与旷达相济的美学新境。",
    "start": 512.816,
    "end": 516.176,
    "duration": 3.36
  },
  {
    "id": 118,
    "text": "第三句调取黄州乌台诗案后最具代表性的旷达绝唱《定风波》。",
    "start": 516.176,
    "end": 521.776,
    "duration": 5.6
  },
  {
    "id": 119,
    "text": "所以表述为：黄州贬哲的逆境之中，",
    "start": 521.936,
    "end": 524.976,
    "duration": 3.04
  },
  {
    "id": 120,
    "text": "他在《定风波》中写道：“竹杖芒鞋轻胜马，",
    "start": 524.976,
    "end": 528.496,
    "duration": 3.52
  },
  {
    "id": 121,
    "text": "谁怕？",
    "start": 528.496,
    "end": 529.296,
    "duration": 0.8
  },
  {
    "id": 122,
    "text": "一蓑烟雨任平生”。",
    "start": 529.296,
    "end": 530.976,
    "duration": 1.68
  },
  {
    "id": 123,
    "text": "第四句剖析这种从容心态，面对政治风雨与生死考验展现出超然脱俗的胸襟。",
    "start": 530.976,
    "end": 537.456,
    "duration": 6.48
  },
  {
    "id": 124,
    "text": "所以表述为：面对人生的风雨泥泞与政治迫害，",
    "start": 537.456,
    "end": 541.376,
    "duration": 3.92
  },
  {
    "id": 125,
    "text": "他展现出超然物外、从容豁达的博大胸襟。",
    "start": 541.376,
    "end": 544.896,
    "duration": 3.52
  },
  {
    "id": 126,
    "text": "第五句追踪尾联，引用“也无风雨也无晴”的超凡通透之语。",
    "start": 545.216,
    "end": 550.638,
    "duration": 5.422
  },
  {
    "id": 127,
    "text": "所以表述为：词的尾联更有“回首向来萧瑟处，",
    "start": 550.638,
    "end": 554.713,
    "duration": 4.075
  },
  {
    "id": 128,
    "text": "归去，也无风雨也无晴”的超凡通透。",
    "start": 554.713,
    "end": 557.881,
    "duration": 3.168
  },
  {
    "id": 129,
    "text": "第六句总结收束全段，指出词摆脱了倡条冶叶性质，",
    "start": 557.881,
    "end": 562.635,
    "duration": 4.754
  },
  {
    "id": 130,
    "text": "成为士大夫安顿生命风骨的高雅载体。",
    "start": 562.635,
    "end": 566.256,
    "duration": 3.621
  },
  {
    "id": 131,
    "text": "所以表述为：词由此摆脱了娱宾遣兴的倡条冶叶性质，",
    "start": 566.336,
    "end": 571.136,
    "duration": 4.8
  },
  {
    "id": 132,
    "text": "升华为士大夫安顿生命风骨的高雅载体。",
    "start": 571.136,
    "end": 574.416,
    "duration": 3.28
  },
  {
    "id": 133,
    "text": "本段答题思路总结。",
    "start": 574.416,
    "end": 576.016,
    "duration": 1.6
  },
  {
    "id": 134,
    "text": "本段聚焦于词体精神品格的升华：对比传统艳词的凄楚感伤，",
    "start": 576.016,
    "end": 580.656,
    "duration": 4.64
  },
  {
    "id": 135,
    "text": "阐明苏轼以浩然之气入词的飞跃；",
    "start": 580.656,
    "end": 583.456,
    "duration": 2.8
  },
  {
    "id": 136,
    "text": "以黄州《定风波》为核心解剖切片，",
    "start": 583.456,
    "end": 585.936,
    "duration": 2.48
  },
  {
    "id": 137,
    "text": "剖析一蓑烟雨、竹杖芒鞋与也无风雨也无晴的崇高心境；",
    "start": 585.936,
    "end": 590.656,
    "duration": 4.72
  },
  {
    "id": 138,
    "text": "有力论证了词体从倡优歌妓手中的流行小调，",
    "start": 590.976,
    "end": 594.656,
    "duration": 3.68
  },
  {
    "id": 139,
    "text": "升华为士大夫安顿心灵、超越逆境的精神高地。",
    "start": 594.656,
    "end": 598.736,
    "duration": 4.08
  },
  {
    "id": 140,
    "text": "所以本段具体答题完整版为：二、情志品格与意境升华：由柔靡感伤转向豪迈超拔与旷达天真。",
    "start": 598.736,
    "end": 607.776,
    "duration": 9.04
  },
  {
    "id": 141,
    "text": "传统词体在情感格调上偏重企靡、柔弱与凄楚感伤，",
    "start": 608.152,
    "end": 613.032,
    "duration": 4.88
  },
  {
    "id": 142,
    "text": "充斥着羁旅与深规幽怨。",
    "start": 613.032,
    "end": 615.272,
    "duration": 2.24
  },
  {
    "id": 143,
    "text": "苏轼将士大夫崇高旷达的精神人格注入词中，",
    "start": 615.272,
    "end": 618.952,
    "duration": 3.68
  },
  {
    "id": 144,
    "text": "开创了豪放与旷达相济的美学新境。",
    "start": 618.952,
    "end": 621.832,
    "duration": 2.88
  },
  {
    "id": 145,
    "text": "黄州贬哲的逆境之中，他在《定风波》中写道：“竹杖芒鞋轻胜马，",
    "start": 621.832,
    "end": 626.552,
    "duration": 4.72
  },
  {
    "id": 146,
    "text": "谁怕？",
    "start": 626.552,
    "end": 627.032,
    "duration": 0.48
  },
  {
    "id": 147,
    "text": "一蓑烟雨任平生”。",
    "start": 627.432,
    "end": 629.752,
    "duration": 2.32
  },
  {
    "id": 148,
    "text": "面对人生的风雨泥泞与政治迫害，他展现出超然物外、",
    "start": 629.752,
    "end": 635.192,
    "duration": 5.44
  },
  {
    "id": 149,
    "text": "从容豁达的博大胸襟。",
    "start": 635.192,
    "end": 637.512,
    "duration": 2.32
  },
  {
    "id": 150,
    "text": "词的尾联更有“回首向来萧瑟处，归去，",
    "start": 637.512,
    "end": 641.912,
    "duration": 4.4
  },
  {
    "id": 151,
    "text": "也无风雨也无晴”的超凡通透。",
    "start": 641.912,
    "end": 645.112,
    "duration": 3.2
  },
  {
    "id": 152,
    "text": "词由此摆脱了娱宾遣兴的倡条冶叶性质，",
    "start": 645.112,
    "end": 648.952,
    "duration": 3.84
  },
  {
    "id": 153,
    "text": "升华为士大夫安顿生命风骨的高雅载体。",
    "start": 648.952,
    "end": 652.392,
    "duration": 3.44
  },
  {
    "id": 154,
    "text": "第四段：第三分论点，机制与功能的根本变革（体之“立”）。",
    "start": 652.632,
    "end": 657.592,
    "duration": 4.96
  },
  {
    "id": 155,
    "text": "逐句因果推导与答题表述。",
    "start": 657.592,
    "end": 660.152,
    "duration": 2.56
  },
  {
    "id": 156,
    "text": "前两段解决了内容与情志，第四段必须深入到词的体制机制与传播功能的根本转变。",
    "start": 660.152,
    "end": 667.272,
    "duration": 7.12
  },
  {
    "id": 157,
    "text": "首句立论，指出传统词完全依附于音乐曲调，",
    "start": 667.272,
    "end": 671.272,
    "duration": 4.0
  },
  {
    "id": 158,
    "text": "以迎合听众歌唱为单一目的。",
    "start": 671.272,
    "end": 673.432,
    "duration": 2.16
  },
  {
    "id": 159,
    "text": "所以表述为：在体制机制上，传统词完全依附于音乐曲调，",
    "start": 673.752,
    "end": 679.112,
    "duration": 5.36
  },
  {
    "id": 160,
    "text": "以迎合听众与歌妓歌唱为单一目的。",
    "start": 679.112,
    "end": 682.392,
    "duration": 3.28
  },
  {
    "id": 161,
    "text": "次句指出苏轼的核心变革，推动词走向案头化与读者化，",
    "start": 682.392,
    "end": 687.752,
    "duration": 5.36
  },
  {
    "id": 162,
    "text": "使其成为独立的文人文学。",
    "start": 687.752,
    "end": 690.072,
    "duration": 2.32
  },
  {
    "id": 163,
    "text": "所以表述为：苏轼推动了词从歌场案头化与读者化转变，",
    "start": 690.072,
    "end": 695.352,
    "duration": 5.28
  },
  {
    "id": 164,
    "text": "把词变成了可以独立阅读的文人文学。",
    "start": 695.352,
    "end": 698.312,
    "duration": 2.96
  },
  {
    "id": 165,
    "text": "第三句指出体制创举，广泛确立了在词前配加“题序”与小传的惯例。",
    "start": 698.552,
    "end": 704.335,
    "duration": 5.783
  },
  {
    "id": 166,
    "text": "所以表述为：他广泛确立了在词前配加“题序”与小传的体裁惯例。",
    "start": 704.335,
    "end": 710.278,
    "duration": 5.943
  },
  {
    "id": 167,
    "text": "第四句调取《水调歌头》欢饮达旦兼怀子由的著名题序原句。",
    "start": 710.278,
    "end": 715.763,
    "duration": 5.485
  },
  {
    "id": 168,
    "text": "所以表述为：如《水调歌头•明月几时有》题序写道：“丙辰中秋，",
    "start": 715.763,
    "end": 721.021,
    "duration": 5.258
  },
  {
    "id": 169,
    "text": "欢饮达旦，大醉，作此篇，兼怀子由”。",
    "start": 721.021,
    "end": 723.992,
    "duration": 2.971
  },
  {
    "id": 170,
    "text": "第五句剖析题序的功能，赋予了词作清晰的时空背景、",
    "start": 724.072,
    "end": 728.763,
    "duration": 4.691
  },
  {
    "id": 171,
    "text": "创作由头与真实情态。",
    "start": 728.763,
    "end": 730.761,
    "duration": 1.998
  },
  {
    "id": 172,
    "text": "所以表述为：题序的加入赋予了词作清晰的时空背景、",
    "start": 730.761,
    "end": 735.642,
    "duration": 4.881
  },
  {
    "id": 173,
    "text": "叙事由头与真挚的人生情态。",
    "start": 735.642,
    "end": 738.305,
    "duration": 2.663
  },
  {
    "id": 174,
    "text": "第六句回应李清照“词别是一家”的学术争论，",
    "start": 738.305,
    "end": 742.3,
    "duration": 3.995
  },
  {
    "id": 175,
    "text": "指出打破依声填词在文学史上的进步性。",
    "start": 742.3,
    "end": 746.072,
    "duration": 3.772
  },
  {
    "id": 176,
    "text": "所以表述为：在音律上，他敢于打破拘泥协律的绳墨，",
    "start": 746.232,
    "end": 750.851,
    "duration": 4.619
  },
  {
    "id": 177,
    "text": "虽然遭到李清照关于“词别是一家”的批评。",
    "start": 750.851,
    "end": 754.641,
    "duration": 3.79
  },
  {
    "id": 178,
    "text": "第七句总结收束，指出这标志着词打破曲调奴役，",
    "start": 754.641,
    "end": 759.099,
    "duration": 4.458
  },
  {
    "id": 179,
    "text": "走上了纯文学抒情的自主道路。",
    "start": 759.099,
    "end": 761.997,
    "duration": 2.898
  },
  {
    "id": 180,
    "text": "所以表述为：然而这恰恰标志着词彻底打破曲调奴役，",
    "start": 761.997,
    "end": 766.936,
    "duration": 4.939
  },
  {
    "id": 181,
    "text": "走上了纯文学抒情的自主道路。",
    "start": 766.936,
    "end": 769.416,
    "duration": 2.48
  },
  {
    "id": 182,
    "text": "本段答题思路总结。",
    "start": 769.416,
    "end": 771.096,
    "duration": 1.68
  },
  {
    "id": 183,
    "text": "本段体现了深刻的文学史机制辨析：先点明词从“歌妓口中歌唱”到“文人案头阅读”的功能位移；",
    "start": 771.096,
    "end": 779.096,
    "duration": 8.0
  },
  {
    "id": 184,
    "text": "接着论述增设题序对赋予词作独立叙事背景的关键作用；",
    "start": 779.096,
    "end": 783.656,
    "duration": 4.56
  },
  {
    "id": 185,
    "text": "最后辩证剖析李清照评其为“句读不气之诗”的公案，",
    "start": 783.976,
    "end": 788.376,
    "duration": 4.4
  },
  {
    "id": 186,
    "text": "指出打破音律绳墨正是词体走向纯文学自觉的必然代价与崇高胜利。",
    "start": 788.376,
    "end": 794.776,
    "duration": 6.4
  },
  {
    "id": 187,
    "text": "所以本段具体答题完整版为：三、机制与功能的根本变革：脱离歌妓案头化与小序自传体确立。",
    "start": 794.776,
    "end": 802.856,
    "duration": 8.08
  },
  {
    "id": 188,
    "text": "在体制机制上，传统词完全依附于音乐曲调，",
    "start": 803.016,
    "end": 806.936,
    "duration": 3.92
  },
  {
    "id": 189,
    "text": "以迎合听众与歌妓歌唱为单一目的。",
    "start": 806.936,
    "end": 809.976,
    "duration": 3.04
  },
  {
    "id": 190,
    "text": "苏轼推动了词从歌场案头化与读者化转变，",
    "start": 809.976,
    "end": 813.656,
    "duration": 3.68
  },
  {
    "id": 191,
    "text": "把词变成了可以独立阅读的文人文学。",
    "start": 813.656,
    "end": 816.936,
    "duration": 3.28
  },
  {
    "id": 192,
    "text": "他广泛确立了在词前配加“题序”与小传的体裁惯例。",
    "start": 816.936,
    "end": 821.976,
    "duration": 5.04
  },
  {
    "id": 193,
    "text": "如《水调歌头•明月几时有》题序写道：“丙辰中秋，",
    "start": 821.976,
    "end": 825.816,
    "duration": 3.84
  },
  {
    "id": 194,
    "text": "欢饮达旦，大醉，作此篇，兼怀子由”。",
    "start": 825.816,
    "end": 829.096,
    "duration": 3.28
  },
  {
    "id": 195,
    "text": "题序的加入赋予了词作清晰的时空背景、",
    "start": 829.416,
    "end": 832.616,
    "duration": 3.2
  },
  {
    "id": 196,
    "text": "叙事由头与真挚的人生情态。",
    "start": 832.616,
    "end": 835.016,
    "duration": 2.4
  },
  {
    "id": 197,
    "text": "在音律上，他敢于打破拘泥协律的绳墨，",
    "start": 835.016,
    "end": 838.536,
    "duration": 3.52
  },
  {
    "id": 198,
    "text": "虽然遭到李清照关于“词别是一家”的批评。",
    "start": 838.536,
    "end": 842.216,
    "duration": 3.68
  },
  {
    "id": 199,
    "text": "然而这恰恰标志着词彻底打破曲调奴役，",
    "start": 842.216,
    "end": 846.056,
    "duration": 3.84
  },
  {
    "id": 200,
    "text": "走上了纯文学抒情的自主道路。",
    "start": 846.056,
    "end": 848.216,
    "duration": 2.16
  },
  {
    "id": 201,
    "text": "第五段：第四分论点，语言体制的清雄雅健（言之“劲”）。",
    "start": 848.456,
    "end": 853.416,
    "duration": 4.96
  },
  {
    "id": 202,
    "text": "逐句因果推导与答题表述。",
    "start": 853.416,
    "end": 855.976,
    "duration": 2.56
  },
  {
    "id": 203,
    "text": "在解决了体制机制之后，本段必须进一步下沉到语言文字与表现技法的具体革新。",
    "start": 855.976,
    "end": 862.856,
    "duration": 6.88
  },
  {
    "id": 204,
    "text": "首句确立分论点，指出苏轼在语言风格上进行荡涤，",
    "start": 862.856,
    "end": 867.256,
    "duration": 4.4
  },
  {
    "id": 205,
    "text": "以诗文句法取代脂粉气。",
    "start": 867.256,
    "end": 869.176,
    "duration": 1.92
  },
  {
    "id": 206,
    "text": "所以表述为：苏轼在语言风格上进行了一场彻底的荡涤，",
    "start": 869.496,
    "end": 874.598,
    "duration": 5.102
  },
  {
    "id": 207,
    "text": "以诗文句法取代花间词浓艳的脂粉气。",
    "start": 874.598,
    "end": 878.193,
    "duration": 3.595
  },
  {
    "id": 208,
    "text": "次句指出其语言渊源，大量吸纳诗歌古文的炼字造句技法。",
    "start": 878.193,
    "end": 883.584,
    "duration": 5.391
  },
  {
    "id": 209,
    "text": "所以表述为：他大量吸纳高古的诗歌语汇、",
    "start": 883.584,
    "end": 887.403,
    "duration": 3.819
  },
  {
    "id": 210,
    "text": "经史典故与散文句式，使词语呈现清雄雅健之风。",
    "start": 887.403,
    "end": 891.896,
    "duration": 4.493
  },
  {
    "id": 211,
    "text": "第三句调取赤壁怀古描摹壮景的名句，",
    "start": 891.976,
    "end": 895.816,
    "duration": 3.84
  },
  {
    "id": 212,
    "text": "乱石穿空惊涛拍岸。",
    "start": 895.816,
    "end": 898.216,
    "duration": 2.4
  },
  {
    "id": 213,
    "text": "所以表述为：如描摹赤壁风光时写道：“乱石穿空，",
    "start": 898.216,
    "end": 902.803,
    "duration": 4.587
  },
  {
    "id": 214,
    "text": "惊涛拍岸，卷起千堆雪”，笔力遒劲生动。",
    "start": 902.803,
    "end": 906.493,
    "duration": 3.69
  },
  {
    "id": 215,
    "text": "第四句分析其审美效果，骨力强劲、",
    "start": 906.493,
    "end": 909.937,
    "duration": 3.444
  },
  {
    "id": 216,
    "text": "神采飞扬，毫无雕琢粉饰与黏滞软媚。",
    "start": 909.937,
    "end": 913.626,
    "duration": 3.689
  },
  {
    "id": 217,
    "text": "所以表述为：全词骨力强劲、神采飞扬，",
    "start": 913.626,
    "end": 917.624,
    "duration": 3.998
  },
  {
    "id": 218,
    "text": "丝毫没有传统艳词的雕琢粉饰与黏滞软媚。",
    "start": 917.624,
    "end": 921.704,
    "duration": 4.08
  },
  {
    "id": 219,
    "text": "第五句总结本段，指出这种语言革新极大增强了词的表现力与张力，",
    "start": 921.704,
    "end": 927.384,
    "duration": 5.68
  },
  {
    "id": 220,
    "text": "达到了化境。",
    "start": 927.384,
    "end": 928.504,
    "duration": 1.12
  },
  {
    "id": 221,
    "text": "所以表述为：这种以诗入词的语言革新，",
    "start": 928.504,
    "end": 931.784,
    "duration": 3.28
  },
  {
    "id": 222,
    "text": "极大地增强了词体的表现力与张力，",
    "start": 931.784,
    "end": 934.424,
    "duration": 2.64
  },
  {
    "id": 223,
    "text": "达到了化境。",
    "start": 934.424,
    "end": 935.224,
    "duration": 0.8
  },
  {
    "id": 224,
    "text": "本段答题思路总结。",
    "start": 935.544,
    "end": 937.384,
    "duration": 1.84
  },
  {
    "id": 225,
    "text": "本段聚焦于词体语言本体的重铸：阐明苏轼以诗文劲挺骨力扫除传统词风的企靡甜腻；",
    "start": 937.384,
    "end": 945.304,
    "duration": 7.92
  },
  {
    "id": 226,
    "text": "以“乱石穿空，惊涛拍岸，卷起千堆雪”为例，",
    "start": 945.304,
    "end": 949.464,
    "duration": 4.16
  },
  {
    "id": 227,
    "text": "剖析其清雄雅健、开阔激荡的句法特征；",
    "start": 949.464,
    "end": 953.384,
    "duration": 3.92
  },
  {
    "id": 228,
    "text": "全面论证了以诗入词如何使词语从低回曼声中解脱出来，",
    "start": 953.384,
    "end": 958.824,
    "duration": 5.44
  },
  {
    "id": 229,
    "text": "具备了与唐诗相媲美的阳刚骨力。",
    "start": 958.824,
    "end": 961.384,
    "duration": 2.56
  },
  {
    "id": 230,
    "text": "所以本段具体答题完整版为：四、语言体制的清雄雅健：荡涤脂粉软媚与注入诗文劲挺骨力。",
    "start": 961.784,
    "end": 970.424,
    "duration": 8.64
  },
  {
    "id": 231,
    "text": "苏轼在语言风格上进行了一场彻底的荡涤，",
    "start": 970.424,
    "end": 973.784,
    "duration": 3.36
  },
  {
    "id": 232,
    "text": "以诗文句法取代花间词浓艳的脂粉气。",
    "start": 973.784,
    "end": 977.224,
    "duration": 3.44
  },
  {
    "id": 233,
    "text": "他大量吸纳高古的诗歌语汇、经史典故与散文句式，",
    "start": 977.224,
    "end": 981.624,
    "duration": 4.4
  },
  {
    "id": 234,
    "text": "使词语呈现清雄雅健之风。",
    "start": 981.624,
    "end": 983.864,
    "duration": 2.24
  },
  {
    "id": 235,
    "text": "如描摹赤壁风光时写道：“乱石穿空，",
    "start": 984.264,
    "end": 987.704,
    "duration": 3.44
  },
  {
    "id": 236,
    "text": "惊涛拍岸，卷起千堆雪”，笔力遒劲生动。",
    "start": 987.704,
    "end": 991.704,
    "duration": 4.0
  },
  {
    "id": 237,
    "text": "全词骨力强劲、神采飞扬，丝毫没有传统艳词的雕琢粉饰与黏滞软媚。",
    "start": 991.704,
    "end": 998.424,
    "duration": 6.72
  },
  {
    "id": 238,
    "text": "这种以诗入词的语言革新，极大地增强了词体的表现力与张力，",
    "start": 998.424,
    "end": 1003.304,
    "duration": 4.88
  },
  {
    "id": 239,
    "text": "达到了化境。",
    "start": 1003.304,
    "end": 1004.184,
    "duration": 0.88
  },
  {
    "id": 240,
    "text": "第六段：尾段收官与文学史谱系闭环。",
    "start": 1004.424,
    "end": 1008.184,
    "duration": 3.76
  },
  {
    "id": 241,
    "text": "逐句因果推导与答题表述。",
    "start": 1008.184,
    "end": 1010.824,
    "duration": 2.64
  },
  {
    "id": 242,
    "text": "尾段作为三十分大题的收官，必须将苏轼置于词史纵向流变的宏大长河中定型。",
    "start": 1010.824,
    "end": 1017.624,
    "duration": 6.8
  },
  {
    "id": 243,
    "text": "首句综合前述四个维度，定评以诗为词是中国词史上最深刻的文体解放运动。",
    "start": 1017.624,
    "end": 1024.264,
    "duration": 6.64
  },
  {
    "id": 244,
    "text": "所以表述为：综上所述，苏轼的“以诗为词”是中国词史上最伟大、",
    "start": 1024.504,
    "end": 1030.264,
    "duration": 5.76
  },
  {
    "id": 245,
    "text": "最深刻的一场文体解放运动。",
    "start": 1030.264,
    "end": 1032.904,
    "duration": 2.64
  },
  {
    "id": 246,
    "text": "次句确立其历史地位，指出他彻底改变了词的发展方向，",
    "start": 1032.904,
    "end": 1037.464,
    "duration": 4.56
  },
  {
    "id": 247,
    "text": "奠定了豪放词派基石。",
    "start": 1037.464,
    "end": 1039.704,
    "duration": 2.24
  },
  {
    "id": 248,
    "text": "所以表述为：他不仅彻底改变了词的发展方向，",
    "start": 1039.704,
    "end": 1043.704,
    "duration": 4.0
  },
  {
    "id": 249,
    "text": "更奠定了豪放词派的宏伟基石。",
    "start": 1043.704,
    "end": 1046.344,
    "duration": 2.64
  },
  {
    "id": 250,
    "text": "第三句向南宋顺流推进，点出其对辛弃疾、",
    "start": 1046.664,
    "end": 1050.984,
    "duration": 4.32
  },
  {
    "id": 251,
    "text": "陈亮、刘过等爱国词人的直接哺育。",
    "start": 1050.984,
    "end": 1054.264,
    "duration": 3.28
  },
  {
    "id": 252,
    "text": "所以表述为：苏轼的开创直接启迪并哺育了南宋辛弃疾、",
    "start": 1054.264,
    "end": 1059.662,
    "duration": 5.398
  },
  {
    "id": 253,
    "text": "陈亮、刘过等爱国词人集团。",
    "start": 1059.662,
    "end": 1062.241,
    "duration": 2.579
  },
  {
    "id": 254,
    "text": "第四句以“苏辛并称”得出终极定评，",
    "start": 1062.241,
    "end": 1065.523,
    "duration": 3.282
  },
  {
    "id": 255,
    "text": "指出其成为词史上豪迈雄奇精神的最崇高象征。",
    "start": 1065.523,
    "end": 1070.212,
    "duration": 4.689
  },
  {
    "id": 256,
    "text": "所以表述为：“苏辛”并称因而成为中国词史上豪迈雄奇精神的最崇高象征。",
    "start": 1070.212,
    "end": 1076.645,
    "duration": 6.433
  },
  {
    "id": 257,
    "text": "本段答题思路总结。",
    "start": 1076.645,
    "end": 1078.313,
    "duration": 1.668
  },
  {
    "id": 258,
    "text": "本段以极其严密的流派谱系完成终极闭环：先用两句话提炼以诗为词在文体解放与豪放派奠基上的历史功绩；",
    "start": 1078.313,
    "end": 1087.905,
    "duration": 9.592
  },
  {
    "id": 259,
    "text": "随后顺流而下，清晰展现由北宋苏轼发端，",
    "start": 1087.905,
    "end": 1091.45,
    "duration": 3.545
  },
  {
    "id": 260,
    "text": "最终在南宋辛弃疾、陈亮爱国抗金词潮中蔚为大观的演进全貌；",
    "start": 1091.45,
    "end": 1096.872,
    "duration": 5.422
  },
  {
    "id": 261,
    "text": "以“苏辛并称”统摄全篇，使整道三十分大题在雄浑深远的宋词演进史中圆满收官。",
    "start": 1096.952,
    "end": 1104.472,
    "duration": 7.52
  },
  {
    "id": 262,
    "text": "所以本段具体答题完整版为：综上所述，",
    "start": 1104.472,
    "end": 1107.752,
    "duration": 3.28
  },
  {
    "id": 263,
    "text": "苏轼的“以诗为词”是中国词史上最伟大、",
    "start": 1107.752,
    "end": 1111.272,
    "duration": 3.52
  },
  {
    "id": 264,
    "text": "最深刻的一场文体解放运动。",
    "start": 1111.272,
    "end": 1113.592,
    "duration": 2.32
  },
  {
    "id": 265,
    "text": "他不仅彻底改变了词的发展方向，更奠定了豪放词派的宏伟基石。",
    "start": 1113.592,
    "end": 1118.392,
    "duration": 4.8
  },
  {
    "id": 266,
    "text": "苏轼的开创直接启迪并哺育了南宋辛弃疾、",
    "start": 1118.712,
    "end": 1122.712,
    "duration": 4.0
  },
  {
    "id": 267,
    "text": "陈亮、刘过等爱国词人集团。",
    "start": 1122.712,
    "end": 1125.192,
    "duration": 2.48
  },
  {
    "id": 268,
    "text": "“苏辛”并称因而成为中国词史上豪迈雄奇精神的最崇高象征。",
    "start": 1125.192,
    "end": 1130.472,
    "duration": 5.28
  },
  {
    "id": 269,
    "text": "整道大题的内在逻辑链总括。",
    "start": 1130.472,
    "end": 1132.632,
    "duration": 2.16
  },
  {
    "id": 270,
    "text": "这道三十分大题的本质，是一场极度严密的逻辑推演。",
    "start": 1132.632,
    "end": 1136.472,
    "duration": 3.84
  },
  {
    "id": 271,
    "text": "整篇答卷从头到尾遵循着“由典范定评、",
    "start": 1136.792,
    "end": 1140.632,
    "duration": 3.84
  },
  {
    "id": 272,
    "text": "到题材拓宽、到旷达情志、到脱离歌妓、",
    "start": 1140.632,
    "end": 1144.552,
    "duration": 3.92
  },
  {
    "id": 273,
    "text": "到清雄语言、最终回归苏辛并称”的必然法则。",
    "start": 1144.552,
    "end": 1148.552,
    "duration": 4.0
  },
  {
    "id": 274,
    "text": "阅卷老师看到的绝不是散乱的答题点，",
    "start": 1148.552,
    "end": 1151.672,
    "duration": 3.12
  },
  {
    "id": 275,
    "text": "而是一条咬合紧密的因果长链：第一步是“立论定性”，",
    "start": 1151.672,
    "end": 1156.712,
    "duration": 5.04
  },
  {
    "id": 276,
    "text": "开门见山借刘辰翁“无所不可”与袁本教材，",
    "start": 1156.712,
    "end": 1160.792,
    "duration": 4.08
  },
  {
    "id": 277,
    "text": "确立苏轼“以诗为词”推动词体解放的至高坐标。",
    "start": 1160.792,
    "end": 1165.192,
    "duration": 4.4
  },
  {
    "id": 278,
    "text": "第二步是“题材突破”，以赤壁怀古、",
    "start": 1165.432,
    "end": 1168.472,
    "duration": 3.04
  },
  {
    "id": 279,
    "text": "密州射天狼、悼亡长恨与田园风光，",
    "start": 1168.472,
    "end": 1171.752,
    "duration": 3.28
  },
  {
    "id": 280,
    "text": "证明打破花间艳科藩篱与无事不可入词。",
    "start": 1171.752,
    "end": 1175.592,
    "duration": 3.84
  },
  {
    "id": 281,
    "text": "第三步是“情志升华”，以黄州《定风波》“一蓑烟雨任平生”，",
    "start": 1175.592,
    "end": 1180.632,
    "duration": 5.04
  },
  {
    "id": 282,
    "text": "阐明由柔媚感伤转向士大夫崇高旷达的生命境界。",
    "start": 1180.632,
    "end": 1184.872,
    "duration": 4.24
  },
  {
    "id": 283,
    "text": "第四步是“功能位移”，以摆脱歌场案头化与增设题序，",
    "start": 1185.192,
    "end": 1189.752,
    "duration": 4.56
  },
  {
    "id": 284,
    "text": "辩证回应李清照“词别是一家”，论证走向纯文学抒情的自主道路。",
    "start": 1189.752,
    "end": 1195.592,
    "duration": 5.84
  },
  {
    "id": 285,
    "text": "第五步是“语言重铸”，以“乱石穿空惊涛拍岸”，",
    "start": 1195.592,
    "end": 1199.432,
    "duration": 3.84
  },
  {
    "id": 286,
    "text": "阐明以诗文骨力取代脂粉软媚的清雄雅健之风。",
    "start": 1199.432,
    "end": 1203.592,
    "duration": 4.16
  },
  {
    "id": 287,
    "text": "第六步是“史学闭环”，把苏轼词自然引向南宋辛弃疾、",
    "start": 1203.912,
    "end": 1208.872,
    "duration": 4.96
  },
  {
    "id": 288,
    "text": "陈亮爱国词人集团，确立“苏辛并称”的千古豪放词史坐标。",
    "start": 1208.872,
    "end": 1213.992,
    "duration": 5.12
  },
  {
    "id": 289,
    "text": "这六步层层递进，前一步的结论必然成为后一步的前提。",
    "start": 1213.992,
    "end": 1218.312,
    "duration": 4.32
  },
  {
    "id": 290,
    "text": "你在考场上顺着因果关系顺流而下，",
    "start": 1218.68,
    "end": 1221.4,
    "duration": 2.72
  },
  {
    "id": 291,
    "text": "就能自然写出近千字的满分答卷。",
    "start": 1221.4,
    "end": 1223.64,
    "duration": 2.24
  }
]