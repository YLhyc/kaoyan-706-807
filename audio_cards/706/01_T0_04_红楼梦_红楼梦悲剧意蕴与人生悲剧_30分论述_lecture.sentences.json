[
  {
    "id": 1,
    "text": "试论《红楼梦》的悲剧意蕴与叙事艺术成就。",
    "start": 0.05,
    "end": 4.014,
    "duration": 3.964
  },
  {
    "id": 2,
    "text": "《红楼梦》 是中国古典长篇章回小说艺术的终极集大成者，",
    "start": 4.014,
    "end": 8.743,
    "duration": 4.729
  },
  {
    "id": 3,
    "text": "也是中国封建社会走向没落时期的伟大百科全书。",
    "start": 8.743,
    "end": 12.796,
    "duration": 4.053
  },
  {
    "id": 4,
    "text": "面对清代康乾盛世表象下的深刻制度危机，",
    "start": 12.796,
    "end": 16.386,
    "duration": 3.59
  },
  {
    "id": 5,
    "text": "曹雪芹以自身家族败落的人生阅历，“披阅十载，增删五次”，",
    "start": 16.386,
    "end": 21.876,
    "duration": 5.49
  },
  {
    "id": 6,
    "text": "彻底打破了传统小说才子佳人大团圆的庸俗套路，",
    "start": 21.876,
    "end": 26.043,
    "duration": 4.167
  },
  {
    "id": 7,
    "text": "第一次将悲剧推向了前所未有的思想高度。",
    "start": 26.043,
    "end": 29.552,
    "duration": 3.509
  },
  {
    "id": 8,
    "text": "鲁迅在 《中国小说的历史的变迁》 中指出：“其悲剧之深，",
    "start": 29.552,
    "end": 34.746,
    "duration": 5.194
  },
  {
    "id": 9,
    "text": "在此；其于中国小说之价值，亦在此。",
    "start": 34.746,
    "end": 37.63,
    "duration": 2.884
  },
  {
    "id": 10,
    "text": "” 其悲剧意蕴与叙事艺术成就，主要展现为以下四个核心维度：",
    "start": 37.63,
    "end": 43.182,
    "duration": 5.552
  },
  {
    "id": 11,
    "text": "第一，构筑多重交织的深刻悲剧意蕴，",
    "start": 43.182,
    "end": 46.445,
    "duration": 3.263
  },
  {
    "id": 12,
    "text": "揭示封建宗法制度走向衰亡的必然命运。",
    "start": 46.445,
    "end": 49.718,
    "duration": 3.273
  },
  {
    "id": 13,
    "text": "《红楼梦》 的悲剧绝非偶然的巧合，",
    "start": 49.718,
    "end": 52.324,
    "duration": 2.606
  },
  {
    "id": 14,
    "text": "而是由不可调和的历史与社会矛盾构筑的多重必然悲剧。",
    "start": 52.324,
    "end": 56.813,
    "duration": 4.489
  },
  {
    "id": 15,
    "text": "它包含了三个层层递进的悲剧维度：",
    "start": 56.813,
    "end": 59.961,
    "duration": 3.148
  },
  {
    "id": 16,
    "text": "其一是青年反叛者的爱情婚姻悲剧，",
    "start": 59.961,
    "end": 63.094,
    "duration": 3.133
  },
  {
    "id": 17,
    "text": "贾宝玉与林黛玉追求精神契合的 “木石前盟”，",
    "start": 63.094,
    "end": 68.212,
    "duration": 5.118
  },
  {
    "id": 18,
    "text": "必然被封建正统宗法势力维护家族利益的 “金玉良缘” 所扼杀；",
    "start": 68.212,
    "end": 73.677,
    "duration": 5.465
  },
  {
    "id": 19,
    "text": "其二是大观园女性群体的命运悲剧，“千红一哭，万艳同悲”，",
    "start": 73.677,
    "end": 78.257,
    "duration": 4.58
  },
  {
    "id": 20,
    "text": "无论是高洁的晴雯、刚烈的鸳鸯还是柔顺的迎春，",
    "start": 78.257,
    "end": 81.893,
    "duration": 3.636
  },
  {
    "id": 21,
    "text": "皆难逃被摧残的厄运；",
    "start": 81.893,
    "end": 83.618,
    "duration": 1.725
  },
  {
    "id": 22,
    "text": "其三是封建贵族家族乃至制度的社会历史悲剧，",
    "start": 83.618,
    "end": 87.607,
    "duration": 3.989
  },
  {
    "id": 23,
    "text": "赫赫扬扬百载的贾府由盛转衰、不可挽回地走向崩塌，",
    "start": 87.607,
    "end": 91.607,
    "duration": 4.0
  },
  {
    "id": 24,
    "text": "最终落得 “落了片白茫茫大地真干净”。",
    "start": 91.607,
    "end": 94.616,
    "duration": 3.009
  },
  {
    "id": 25,
    "text": "这种悲剧揭示出封建末世各种美好价值必然破灭的宿命。",
    "start": 94.616,
    "end": 99.317,
    "duration": 4.701
  },
  {
    "id": 26,
    "text": "第二，确立多线并进的网络状网状叙事结构，",
    "start": 99.317,
    "end": 102.999,
    "duration": 3.682
  },
  {
    "id": 27,
    "text": "在日常生活细节中寄寓兴亡深思。",
    "start": 102.999,
    "end": 106.044,
    "duration": 3.045
  },
  {
    "id": 28,
    "text": "在叙事结构上，",
    "start": 106.044,
    "end": 107.361,
    "duration": 1.317
  },
  {
    "id": 29,
    "text": "《红楼梦》 彻底摆脱了中国早期小说线性单轨与单线串珠的简单模式，",
    "start": 107.361,
    "end": 113.12,
    "duration": 5.759
  },
  {
    "id": 30,
    "text": "创造了前所未有的网络状全景结构。",
    "start": 113.12,
    "end": 115.958,
    "duration": 2.838
  },
  {
    "id": 31,
    "text": "作者将贾府的家族盛衰史与宝黛的爱情发展史两条主线紧密纠结；",
    "start": 115.958,
    "end": 121.923,
    "duration": 5.965
  },
  {
    "id": 32,
    "text": "全书以大观园为中心，展开纵横交织的人事网，通过元妃省亲、",
    "start": 121.923,
    "end": 127.07,
    "duration": 5.147
  },
  {
    "id": 33,
    "text": "刘姥姥进大观园、抄检大观园三次重大波澜，",
    "start": 127.07,
    "end": 130.965,
    "duration": 3.895
  },
  {
    "id": 34,
    "text": "推动情节由极盛走向剧烈分化与彻底衰败。",
    "start": 130.965,
    "end": 135.152,
    "duration": 4.187
  },
  {
    "id": 35,
    "text": "作者长于在琐屑平静的饮酒作诗、家长里短的日常生活白描中，",
    "start": 135.152,
    "end": 140.791,
    "duration": 5.639
  },
  {
    "id": 36,
    "text": "暗伏生死兴亡的深刻线索，做到了草蛇灰线、",
    "start": 140.791,
    "end": 144.892,
    "duration": 4.101
  },
  {
    "id": 37,
    "text": "伏脉千里的结构化境。",
    "start": 144.892,
    "end": 146.797,
    "duration": 1.905
  },
  {
    "id": 38,
    "text": "第三，打破扁平化类型化的人物塑造套路，",
    "start": 146.797,
    "end": 150.287,
    "duration": 3.49
  },
  {
    "id": 39,
    "text": "创造出性格复杂多面的“圆形人物”群像。",
    "start": 150.287,
    "end": 153.592,
    "duration": 3.305
  },
  {
    "id": 40,
    "text": "曹雪芹在人物塑造上实现了中国小说美学的历史性飞跃。",
    "start": 153.592,
    "end": 159.924,
    "duration": 6.332
  },
  {
    "id": 41,
    "text": "他不再将人物简单定型为脸谱化的忠奸善恶，",
    "start": 159.924,
    "end": 163.98,
    "duration": 4.056
  },
  {
    "id": 42,
    "text": "而是以精微深刻的心理刻画与多维视角展现人物的复杂人性。",
    "start": 163.98,
    "end": 169.599,
    "duration": 5.619
  },
  {
    "id": 43,
    "text": "以王熙凤为例，她既是贪婪弄权、杀伐决断、",
    "start": 169.599,
    "end": 173.342,
    "duration": 3.743
  },
  {
    "id": 44,
    "text": "害死尤二姐的封建家族酷吏，又是精明能干、谈笑风生、",
    "start": 173.342,
    "end": 177.342,
    "duration": 4.0
  },
  {
    "id": 45,
    "text": "偶发恻隐周济刘姥姥的能者；林黛玉不仅有多愁善感、",
    "start": 177.342,
    "end": 181.828,
    "duration": 4.486
  },
  {
    "id": 46,
    "text": "任性孤高的一面，更有才情横溢、自尊自爱的诗人本色。",
    "start": 181.828,
    "end": 185.828,
    "duration": 4.0
  },
  {
    "id": 47,
    "text": "小说人物性格前后发展、自相矛盾又合情合理，",
    "start": 185.828,
    "end": 189.531,
    "duration": 3.703
  },
  {
    "id": 48,
    "text": "达到了极高的心理真实度。",
    "start": 189.531,
    "end": 191.677,
    "duration": 2.146
  },
  {
    "id": 49,
    "text": "第四，运用虚实相生的谶纬预叙笔法，",
    "start": 191.677,
    "end": 195.238,
    "duration": 3.561
  },
  {
    "id": 50,
    "text": "构筑宿命感与现实感高度统一的哲理空间。",
    "start": 195.238,
    "end": 199.087,
    "duration": 3.849
  },
  {
    "id": 51,
    "text": "在叙事手法上，《红楼梦》 巧妙融合了神话构架与写实细节。",
    "start": 199.087,
    "end": 203.849,
    "duration": 4.762
  },
  {
    "id": 52,
    "text": "开篇以女娲补天遗石与通灵宝玉展开神话预设，",
    "start": 203.849,
    "end": 208.429,
    "duration": 4.58
  },
  {
    "id": 53,
    "text": "以太虚幻境中的十二钗判词与红楼梦曲预言人物命运；",
    "start": 208.429,
    "end": 213.283,
    "duration": 4.854
  },
  {
    "id": 54,
    "text": "在现实叙事中，又借元宵灯谜、中秋联诗、",
    "start": 213.283,
    "end": 217.121,
    "duration": 3.838
  },
  {
    "id": 55,
    "text": "芙蓉女儿诔等日常细节作为谶语，提前透露悲剧结局。",
    "start": 217.121,
    "end": 221.539,
    "duration": 4.418
  },
  {
    "id": 56,
    "text": "这种“真事隐去，假语村言”的虚实结合，",
    "start": 221.539,
    "end": 224.606,
    "duration": 3.067
  },
  {
    "id": 57,
    "text": "使整部作品在极具生活质感的现实主义描摹之上，",
    "start": 224.606,
    "end": 228.424,
    "duration": 3.818
  },
  {
    "id": 58,
    "text": "笼罩着一层俯瞰人世苍凉的深邃哲学沉思。",
    "start": 228.424,
    "end": 231.864,
    "duration": 3.44
  }
]