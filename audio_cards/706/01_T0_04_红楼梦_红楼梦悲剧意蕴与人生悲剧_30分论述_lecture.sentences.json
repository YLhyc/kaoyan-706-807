[
  {
    "id": 1,
    "text": "试论《红楼梦》的悲剧意蕴与叙事艺术成就。",
    "start": 0.0,
    "end": 4.039,
    "duration": 4.039
  },
  {
    "id": 2,
    "text": "《红楼梦》 是中国古典长篇章回小说艺术的终极集大成者，",
    "start": 4.039,
    "end": 8.772,
    "duration": 4.733
  },
  {
    "id": 3,
    "text": "也是中国封建社会走向没落时期的伟大百科全书。",
    "start": 8.772,
    "end": 16.415,
    "duration": 7.643
  },
  {
    "id": 4,
    "text": "面对清代康乾盛世表象下的深刻制度危机，",
    "start": 16.415,
    "end": 17.298,
    "duration": 0.883
  },
  {
    "id": 5,
    "text": "曹雪芹以自身家族败落的人生阅历，“披阅十载，增删五次”，",
    "start": 17.298,
    "end": 21.906,
    "duration": 4.608
  },
  {
    "id": 6,
    "text": "彻底打破了传统小说才子佳人大团圆的庸俗套路，",
    "start": 21.906,
    "end": 26.073,
    "duration": 4.167
  },
  {
    "id": 7,
    "text": "第一次将悲剧推向了前所未有的思想高度。",
    "start": 26.073,
    "end": 29.582,
    "duration": 3.509
  },
  {
    "id": 8,
    "text": "鲁迅在 《中国小说的历史的变迁》 中指出：“其悲剧之深，",
    "start": 29.582,
    "end": 34.774,
    "duration": 5.192
  },
  {
    "id": 9,
    "text": "在此；其于中国小说之价值，亦在此。",
    "start": 34.774,
    "end": 37.659,
    "duration": 2.885
  },
  {
    "id": 10,
    "text": "” 其悲剧意蕴与叙事艺术成就，主要展现为以下四个核心维度：",
    "start": 37.659,
    "end": 43.212,
    "duration": 5.553
  },
  {
    "id": 11,
    "text": "第一，构筑多重交织的深刻悲剧意蕴，",
    "start": 43.212,
    "end": 46.475,
    "duration": 3.263
  },
  {
    "id": 12,
    "text": "揭示封建宗法制度走向衰亡的必然命运。",
    "start": 46.475,
    "end": 49.744,
    "duration": 3.269
  },
  {
    "id": 13,
    "text": "《红楼梦》 的悲剧绝非偶然的巧合，",
    "start": 49.744,
    "end": 52.351,
    "duration": 2.607
  },
  {
    "id": 14,
    "text": "而是由不可调和的历史与社会矛盾构筑的多重必然悲剧。",
    "start": 52.351,
    "end": 56.843,
    "duration": 4.492
  },
  {
    "id": 15,
    "text": "它包含了三个层层递进的悲剧维度：",
    "start": 56.843,
    "end": 59.563,
    "duration": 2.72
  },
  {
    "id": 16,
    "text": "其一是青年反叛者的爱情婚姻悲剧，",
    "start": 59.563,
    "end": 62.558,
    "duration": 2.995
  },
  {
    "id": 17,
    "text": "贾宝玉与林黛玉追求精神契合的 “木石前盟”，",
    "start": 62.558,
    "end": 68.242,
    "duration": 5.684
  },
  {
    "id": 18,
    "text": "必然被封建正统宗法势力维护家族利益的 “金玉良缘” 所扼杀；",
    "start": 68.242,
    "end": 73.705,
    "duration": 5.463
  },
  {
    "id": 19,
    "text": "其二是大观园女性群体的命运悲剧，“千红一哭，万艳同悲”，",
    "start": 73.705,
    "end": 79.782,
    "duration": 6.077
  },
  {
    "id": 20,
    "text": "无论是高洁的晴雯、刚烈的鸳鸯还是柔顺的迎春，",
    "start": 79.782,
    "end": 81.639,
    "duration": 1.857
  },
  {
    "id": 21,
    "text": "皆难逃被摧残的厄运；",
    "start": 81.639,
    "end": 85.821,
    "duration": 4.182
  },
  {
    "id": 22,
    "text": "其三是封建贵族家族乃至制度的社会历史悲剧，",
    "start": 85.821,
    "end": 88.724,
    "duration": 2.903
  },
  {
    "id": 23,
    "text": "赫赫扬扬百载的贾府由盛转衰、不可挽回地走向崩塌，",
    "start": 88.724,
    "end": 93.902,
    "duration": 5.178
  },
  {
    "id": 24,
    "text": "最终落得 “落了片白茫茫大地真干净”。",
    "start": 93.902,
    "end": 98.795,
    "duration": 4.893
  },
  {
    "id": 25,
    "text": "这种悲剧揭示出封建末世各种美好价值必然破灭的宿命。",
    "start": 98.795,
    "end": 101.447,
    "duration": 2.652
  },
  {
    "id": 26,
    "text": "第二，确立多线并进的网络状网状叙事结构，",
    "start": 101.447,
    "end": 106.07,
    "duration": 4.623
  },
  {
    "id": 27,
    "text": "在日常生活细节中寄寓兴亡深思。",
    "start": 106.07,
    "end": 107.391,
    "duration": 1.321
  },
  {
    "id": 28,
    "text": "在叙事结构上，",
    "start": 107.391,
    "end": 110.948,
    "duration": 3.557
  },
  {
    "id": 29,
    "text": "《红楼梦》 彻底摆脱了中国早期小说线性单轨与单线串珠的简单模式，",
    "start": 110.948,
    "end": 115.988,
    "duration": 5.04
  },
  {
    "id": 30,
    "text": "创造了前所未有的网络状全景结构。",
    "start": 115.988,
    "end": 118.271,
    "duration": 2.283
  },
  {
    "id": 31,
    "text": "作者将贾府的家族盛衰史与宝黛的爱情发展史两条主线紧密纠结；",
    "start": 118.271,
    "end": 125.759,
    "duration": 7.488
  },
  {
    "id": 32,
    "text": "全书以大观园为中心，展开纵横交织的人事网，通过元妃省亲、",
    "start": 125.759,
    "end": 128.695,
    "duration": 2.936
  },
  {
    "id": 33,
    "text": "刘姥姥进大观园、抄检大观园三次重大波澜，",
    "start": 128.695,
    "end": 131.976,
    "duration": 3.281
  },
  {
    "id": 34,
    "text": "推动情节由极盛走向剧烈分化与彻底衰败。",
    "start": 131.976,
    "end": 137.315,
    "duration": 5.339
  },
  {
    "id": 35,
    "text": "作者长于在琐屑平静的饮酒作诗、家长里短的日常生活白描中，",
    "start": 137.315,
    "end": 140.816,
    "duration": 3.501
  },
  {
    "id": 36,
    "text": "暗伏生死兴亡的深刻线索，做到了草蛇灰线、",
    "start": 140.816,
    "end": 144.902,
    "duration": 4.086
  },
  {
    "id": 37,
    "text": "伏脉千里的结构化境。",
    "start": 144.902,
    "end": 147.41,
    "duration": 2.508
  },
  {
    "id": 38,
    "text": "第三，打破扁平化类型化的人物塑造套路，",
    "start": 147.41,
    "end": 150.317,
    "duration": 2.907
  },
  {
    "id": 39,
    "text": "创造出性格复杂多面的“圆形人物”群像。",
    "start": 150.317,
    "end": 155.327,
    "duration": 5.01
  },
  {
    "id": 40,
    "text": "曹雪芹在人物塑造上实现了中国小说美学的历史性飞跃。",
    "start": 155.327,
    "end": 159.953,
    "duration": 4.626
  },
  {
    "id": 41,
    "text": "他不再将人物简单定型为脸谱化的忠奸善恶，",
    "start": 159.953,
    "end": 164.01,
    "duration": 4.057
  },
  {
    "id": 42,
    "text": "而是以精微深刻的心理刻画与多维视角展现人物的复杂人性。",
    "start": 164.01,
    "end": 166.753,
    "duration": 2.743
  },
  {
    "id": 43,
    "text": "以王熙凤为例，她既是贪婪弄权、杀伐决断、",
    "start": 166.753,
    "end": 173.173,
    "duration": 6.42
  },
  {
    "id": 44,
    "text": "害死尤二姐的封建家族酷吏，又是精明能干、谈笑风生、",
    "start": 173.173,
    "end": 175.744,
    "duration": 2.571
  },
  {
    "id": 45,
    "text": "偶发恻隐周济刘姥姥的能者；林黛玉不仅有多愁善感、",
    "start": 175.744,
    "end": 180.282,
    "duration": 4.538
  },
  {
    "id": 46,
    "text": "任性孤高的一面，更有才情横溢、自尊自爱的诗人本色。",
    "start": 180.282,
    "end": 185.079,
    "duration": 4.797
  },
  {
    "id": 47,
    "text": "小说人物性格前后发展、自相矛盾又合情合理，",
    "start": 185.079,
    "end": 191.707,
    "duration": 6.628
  },
  {
    "id": 48,
    "text": "达到了极高的心理真实度。",
    "start": 191.707,
    "end": 192.623,
    "duration": 0.916
  },
  {
    "id": 49,
    "text": "第四，运用虚实相生的谶纬预叙笔法，",
    "start": 192.623,
    "end": 195.268,
    "duration": 2.645
  },
  {
    "id": 50,
    "text": "构筑宿命感与现实感高度统一的哲理空间。",
    "start": 195.268,
    "end": 199.117,
    "duration": 3.849
  },
  {
    "id": 51,
    "text": "在叙事手法上，《红楼梦》 巧妙融合了神话构架与写实细节。",
    "start": 199.117,
    "end": 203.879,
    "duration": 4.762
  },
  {
    "id": 52,
    "text": "开篇以女娲补天遗石与通灵宝玉展开神话预设，",
    "start": 203.879,
    "end": 208.458,
    "duration": 4.579
  },
  {
    "id": 53,
    "text": "以太虚幻境中的十二钗判词与红楼梦曲预言人物命运；",
    "start": 208.458,
    "end": 212.084,
    "duration": 3.626
  },
  {
    "id": 54,
    "text": "在现实叙事中，又借元宵灯谜、中秋联诗、",
    "start": 212.084,
    "end": 215.975,
    "duration": 3.891
  },
  {
    "id": 55,
    "text": "芙蓉女儿诔等日常细节作为谶语，提前透露悲剧结局。",
    "start": 215.975,
    "end": 219.738,
    "duration": 3.763
  },
  {
    "id": 56,
    "text": "这种“真事隐去，假语村言”的虚实结合，",
    "start": 219.738,
    "end": 223.008,
    "duration": 3.27
  },
  {
    "id": 57,
    "text": "使整部作品在极具生活质感的现实主义描摹之上，",
    "start": 223.008,
    "end": 227.022,
    "duration": 4.014
  },
  {
    "id": 58,
    "text": "笼罩着一层俯瞰人世苍凉的深邃哲学沉思。",
    "start": 227.022,
    "end": 231.864,
    "duration": 4.842
  }
]