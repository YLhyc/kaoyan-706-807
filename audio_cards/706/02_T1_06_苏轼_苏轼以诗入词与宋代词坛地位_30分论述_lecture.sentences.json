[
  {
    "id": 1,
    "text": "试论苏轼对宋代词体发展的文学史贡献。",
    "start": 0.05,
    "end": 4.393,
    "duration": 4.343
  },
  {
    "id": 2,
    "text": "宋代词体由中晚唐五代的“艳科小道”跃升为一代文学之代表，",
    "start": 4.393,
    "end": 10.414,
    "duration": 6.021
  },
  {
    "id": 3,
    "text": "苏轼的文体解放之功最为卓著。",
    "start": 10.414,
    "end": 13.551,
    "duration": 3.137
  },
  {
    "id": 4,
    "text": "面对词体长期依附于酒筵歌席、迁就乐工歌伎的狭隘格局，",
    "start": 13.551,
    "end": 19.146,
    "duration": 5.595
  },
  {
    "id": 5,
    "text": "苏轼以崇高的文人主体意识推行 “以诗为词”，",
    "start": 19.146,
    "end": 23.377,
    "duration": 4.231
  },
  {
    "id": 6,
    "text": "全面打破了诗词分界的传统藩篱，",
    "start": 23.377,
    "end": 26.546,
    "duration": 3.169
  },
  {
    "id": 7,
    "text": "推动词体由娱人小道转变为与古诗平起平坐的独立抒情文体。",
    "start": 26.546,
    "end": 32.439,
    "duration": 5.893
  },
  {
    "id": 8,
    "text": "胡寅在 《酒边词序》 中赞其 “一洗绮罗香泽之态，",
    "start": 32.439,
    "end": 36.81,
    "duration": 4.371
  },
  {
    "id": 9,
    "text": "摆脱绸缪宛转之度，使人登高望远，举首高歌”。",
    "start": 36.81,
    "end": 40.219,
    "duration": 3.409
  },
  {
    "id": 10,
    "text": "其对词体文学发展的历史贡献，主要展现为以下四个核心维度：",
    "start": 40.219,
    "end": 46.399,
    "duration": 6.18
  },
  {
    "id": 11,
    "text": "第一，破除“词为艳科”传统，实现词体表现功能的案头言志转向。",
    "start": 46.399,
    "end": 52.033,
    "duration": 5.634
  },
  {
    "id": 12,
    "text": "自花间、南唐至北宋初年，",
    "start": 52.033,
    "end": 54.841,
    "duration": 2.808
  },
  {
    "id": 13,
    "text": "词作题材长期局限于闺怨相思与尊前欢谑，",
    "start": 54.841,
    "end": 58.964,
    "duration": 4.123
  },
  {
    "id": 14,
    "text": "文人内心严肃的政治抱负与人生哲思无法登堂入室。",
    "start": 58.964,
    "end": 63.173,
    "duration": 4.209
  },
  {
    "id": 15,
    "text": "苏轼从观念上确立“诗词一体”之说，指出词是“诗之苗裔”，",
    "start": 63.173,
    "end": 68.223,
    "duration": 5.05
  },
  {
    "id": 16,
    "text": "把词从歌女口中解放出来给士大夫案头阅读。",
    "start": 68.223,
    "end": 71.949,
    "duration": 3.726
  },
  {
    "id": 17,
    "text": "他将怀古、报国、悼亡、农村田园等宏大母题全面注入词中：",
    "start": 71.949,
    "end": 77.594,
    "duration": 5.645
  },
  {
    "id": 18,
    "text": "在密州写下 “会挽雕弓如满月，西北望，",
    "start": 77.594,
    "end": 80.559,
    "duration": 2.965
  },
  {
    "id": 19,
    "text": "射天狼” 的戍边雄心；",
    "start": 80.559,
    "end": 82.432,
    "duration": 1.873
  },
  {
    "id": 20,
    "text": "在悼念亡妻时写出 “十年生死两茫茫，不思量，",
    "start": 82.432,
    "end": 87.65,
    "duration": 5.218
  },
  {
    "id": 21,
    "text": "自难忘” 的深沉人伦；",
    "start": 87.65,
    "end": 89.105,
    "duration": 1.455
  },
  {
    "id": 22,
    "text": "在徐州农村写出 “敲门试问野人家” 的淳朴风貌。",
    "start": 89.105,
    "end": 94.581,
    "duration": 5.476
  },
  {
    "id": 23,
    "text": "这种题材的大幅度拓宽，彻底撕碎了词为艳科的狭隘格局。",
    "start": 94.581,
    "end": 99.85,
    "duration": 5.269
  },
  {
    "id": 24,
    "text": "第二，首创题序小传机制，确立叙事与抒情深度融合的篇章结构。",
    "start": 99.85,
    "end": 105.881,
    "duration": 6.031
  },
  {
    "id": 25,
    "text": "传统曲子词往往“有调无题”，情意模糊泛化。",
    "start": 105.881,
    "end": 108.972,
    "duration": 3.091
  },
  {
    "id": 26,
    "text": "苏轼借鉴近体诗作法，大量在词前创设长短题序，",
    "start": 108.972,
    "end": 112.636,
    "duration": 3.664
  },
  {
    "id": 27,
    "text": "以纪实笔法交代创作缘起、时间、地点与生活细节。",
    "start": 112.636,
    "end": 117.76,
    "duration": 5.124
  },
  {
    "id": 28,
    "text": "在 《水调歌头》 前以“丙辰中秋，欢饮达旦，大醉，",
    "start": 117.76,
    "end": 121.63,
    "duration": 3.87
  },
  {
    "id": 29,
    "text": "作此篇兼怀子由”交代本事；",
    "start": 121.63,
    "end": 123.969,
    "duration": 2.339
  },
  {
    "id": 30,
    "text": "在 《定风波》 前以“三月七日沙湖道中遇雨，雨具先去，",
    "start": 123.969,
    "end": 128.37,
    "duration": 4.401
  },
  {
    "id": 31,
    "text": "同行皆狼狈，余独不觉”铺叙生活波澜。",
    "start": 128.37,
    "end": 131.734,
    "duration": 3.364
  },
  {
    "id": 32,
    "text": "题序小传与正文词句互为表里，",
    "start": 131.734,
    "end": 135.204,
    "duration": 3.47
  },
  {
    "id": 33,
    "text": "使词体不仅具备了交代复杂事件的记实能力，",
    "start": 135.204,
    "end": 139.269,
    "duration": 4.065
  },
  {
    "id": 34,
    "text": "更营造出浓郁的生活现场感与历史真实感。",
    "start": 139.269,
    "end": 144.319,
    "duration": 5.05
  },
  {
    "id": 35,
    "text": "第三，以知人论世为心灵轴线，",
    "start": 144.319,
    "end": 146.554,
    "duration": 2.235
  },
  {
    "id": 36,
    "text": "构筑以旷达自适为主的多样化美学风貌。",
    "start": 146.554,
    "end": 151.316,
    "duration": 4.762
  },
  {
    "id": 37,
    "text": "苏轼之词绝非单一维度的豪迈，",
    "start": 151.316,
    "end": 153.68,
    "duration": 2.364
  },
  {
    "id": 38,
    "text": "而是其波澜起伏的人生心灵全息图景。",
    "start": 153.68,
    "end": 158.767,
    "duration": 5.087
  },
  {
    "id": 39,
    "text": "乌台诗案牢狱之灾与贬谪黄州的人生绝境，",
    "start": 158.767,
    "end": 162.349,
    "duration": 3.582
  },
  {
    "id": 40,
    "text": "不仅未曾将其精神压垮，反而逼发出超越苦难的生命哲思。",
    "start": 162.349,
    "end": 167.082,
    "duration": 4.733
  },
  {
    "id": 41,
    "text": "在定慧院中，他借 “拣尽寒枝不肯栖，",
    "start": 167.082,
    "end": 170.467,
    "duration": 3.385
  },
  {
    "id": 42,
    "text": "寂寞沙洲冷” 坚守孤高人格；在赤壁矶头，",
    "start": 170.467,
    "end": 174.047,
    "duration": 3.58
  },
  {
    "id": 43,
    "text": "他以 “人生如梦，一尊还酹江月” 消解现实得失；",
    "start": 174.047,
    "end": 178.665,
    "duration": 4.618
  },
  {
    "id": 44,
    "text": "至沙湖道中，最终升华为 “回首向来萧瑟处，归去，",
    "start": 178.665,
    "end": 182.659,
    "duration": 3.994
  },
  {
    "id": 45,
    "text": "也无风雨也无晴” 的超然胜境。",
    "start": 182.659,
    "end": 186.231,
    "duration": 3.572
  },
  {
    "id": 46,
    "text": "其词将道家随顺自适与佛禅理趣化解于儒家坚守之中，",
    "start": 186.231,
    "end": 191.444,
    "duration": 5.213
  },
  {
    "id": 47,
    "text": "确立了清旷雄健的士大夫审美典范。",
    "start": 191.444,
    "end": 194.476,
    "duration": 3.032
  },
  {
    "id": 48,
    "text": "第四，解放文体声律拘牵，直接启迪南宋辛派词人的英雄悲歌。",
    "start": 194.476,
    "end": 201.037,
    "duration": 6.561
  },
  {
    "id": 49,
    "text": "为了保障抒情自由，苏轼敢于为了表达意气而适度破律，",
    "start": 201.037,
    "end": 205.991,
    "duration": 4.954
  },
  {
    "id": 50,
    "text": "引发了李清照“句读不葺之诗”的文体辨析，",
    "start": 205.991,
    "end": 209.56,
    "duration": 3.569
  },
  {
    "id": 51,
    "text": "但王灼在 《碧鸡漫志》 中客观定评：",
    "start": 209.56,
    "end": 212.541,
    "duration": 2.981
  },
  {
    "id": 52,
    "text": "“东坡先生非心醉于音律者，偶尔作歌，指出向上一路，",
    "start": 212.541,
    "end": 217.555,
    "duration": 5.014
  },
  {
    "id": 53,
    "text": "新天下耳目。",
    "start": 217.555,
    "end": 218.946,
    "duration": 1.391
  },
  {
    "id": 54,
    "text": "” 苏轼使词走向诗意化与哲理化，",
    "start": 218.946,
    "end": 221.799,
    "duration": 2.853
  },
  {
    "id": 55,
    "text": "不仅确立了北宋豪放词派的宏大基石，",
    "start": 221.799,
    "end": 225.154,
    "duration": 3.355
  },
  {
    "id": 56,
    "text": "更直接启迪了南宋辛弃疾以文为词、融经铸史的艺术突围，",
    "start": 225.154,
    "end": 230.207,
    "duration": 5.053
  },
  {
    "id": 57,
    "text": "共同将宋词推向了古典抒情文学的至高殿堂。",
    "start": 230.207,
    "end": 233.784,
    "duration": 3.577
  }
]