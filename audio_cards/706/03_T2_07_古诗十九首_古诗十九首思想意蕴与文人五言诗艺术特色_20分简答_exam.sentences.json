[
  {
    "id": 1,
    "text": "简述《古诗十九首》的思想意蕴与文人五言诗艺术特色。",
    "start": 0.1,
    "end": 4.287,
    "duration": 4.187
  },
  {
    "id": 2,
    "text": "《古诗十九首》 是东汉末年文人五言诗成熟的标志性代表作。",
    "start": 4.628,
    "end": 9.444,
    "duration": 4.816
  },
  {
    "id": 3,
    "text": "这组诗作最早见于南朝梁萧统编选的 《文选》，",
    "start": 9.732,
    "end": 13.78,
    "duration": 4.048
  },
  {
    "id": 4,
    "text": "产生于东汉中后期宦官专权、外戚争衡、",
    "start": 13.933,
    "end": 17.459,
    "duration": 3.526
  },
  {
    "id": 5,
    "text": "士人社会地位动荡的乱世前夕。",
    "start": 17.696,
    "end": 19.972,
    "duration": 2.276
  },
  {
    "id": 6,
    "text": "刘勰在 《文心雕龙》 中盛赞其为 “五言之冠冕”，",
    "start": 20.178,
    "end": 23.9,
    "duration": 3.722
  },
  {
    "id": 7,
    "text": "钟嵘 《诗品》 誉其为 “惊心动魄，可谓几乎一字千金”。",
    "start": 24.214,
    "end": 28.585,
    "duration": 4.371
  },
  {
    "id": 8,
    "text": "《古诗十九首》 的思想意蕴与艺术特色，",
    "start": 29.136,
    "end": 31.747,
    "duration": 2.611
  },
  {
    "id": 9,
    "text": "主要展现为以下三个核心维度：",
    "start": 31.828,
    "end": 34.257,
    "duration": 2.429
  },
  {
    "id": 10,
    "text": "第一，抒发生命短促之焦灼与身世失意之悲叹，",
    "start": 34.688,
    "end": 38.613,
    "duration": 3.925
  },
  {
    "id": 11,
    "text": "展现深沉的文人觉醒意识。",
    "start": 39.039,
    "end": 41.08,
    "duration": 2.041
  },
  {
    "id": 12,
    "text": "《古诗十九首》 深刻折射了汉末下层文人在门阀垄断与社会动乱下的生存困境。",
    "start": 41.306,
    "end": 47.735,
    "duration": 6.429
  },
  {
    "id": 13,
    "text": "诗歌的核心母题集中于对时光流逝、",
    "start": 48.09,
    "end": 51.362,
    "duration": 3.272
  },
  {
    "id": 14,
    "text": "生命短促与功名无望的生存焦虑。",
    "start": 51.55,
    "end": 54.573,
    "duration": 3.023
  },
  {
    "id": 15,
    "text": "在 《生年不满百》 中，以 “生年不满百，常怀千岁忧。",
    "start": 54.968,
    "end": 59.132,
    "duration": 4.164
  },
  {
    "id": 16,
    "text": "昼短苦夜长，",
    "start": 59.592,
    "end": 60.777,
    "duration": 1.185
  },
  {
    "id": 17,
    "text": "何不秉烛游” 抒发生命短暂的紧迫感与及时行乐的愤懑；",
    "start": 60.939,
    "end": 65.809,
    "duration": 4.87
  },
  {
    "id": 18,
    "text": "在 《涉江采芙蓉》 与 《青青河畔草》 中，",
    "start": 66.023,
    "end": 68.941,
    "duration": 2.918
  },
  {
    "id": 19,
    "text": "则借游子逐客的羁旅之愁与思妇闺怨，写尽了关山阻隔、",
    "start": 69.122,
    "end": 74.318,
    "duration": 5.196
  },
  {
    "id": 20,
    "text": "相见无期的刻骨相思。",
    "start": 74.484,
    "end": 76.336,
    "duration": 1.852
  },
  {
    "id": 21,
    "text": "这种对个体生命价值的深切执着，标志着文人自我意识的真正觉醒。",
    "start": 76.562,
    "end": 81.897,
    "duration": 5.335
  },
  {
    "id": 22,
    "text": "第二，融汇赋比兴表现机制，确立文人五言诗意蕴绵长的审美范式。",
    "start": 82.175,
    "end": 87.862,
    "duration": 5.687
  },
  {
    "id": 23,
    "text": "在艺术表现上，",
    "start": 88.109,
    "end": 89.219,
    "duration": 1.11
  },
  {
    "id": 24,
    "text": "《古诗十九首》 承续 《诗经》 比兴传统并加以文人雅化。",
    "start": 89.329,
    "end": 93.485,
    "duration": 4.156
  },
  {
    "id": 25,
    "text": "作者善于以眼前寻常物象起兴，将外在物候与内在心理浑然交融。",
    "start": 93.713,
    "end": 99.313,
    "duration": 5.6
  },
  {
    "id": 26,
    "text": "如 《迢迢牵牛星》 借神话星汉起兴，以 “盈盈一水间，",
    "start": 99.43,
    "end": 103.618,
    "duration": 4.188
  },
  {
    "id": 27,
    "text": "脉脉不得语” 白描夫妇情思，意境深沉宛转。",
    "start": 103.689,
    "end": 107.439,
    "duration": 3.75
  },
  {
    "id": 28,
    "text": "全诗善用叠字摹态传情，如 “行行重行行”、",
    "start": 107.702,
    "end": 113.5,
    "duration": 5.798
  },
  {
    "id": 29,
    "text": "“青青河畔草”，音律和谐回环，营造出一种温厚低回、",
    "start": 113.5,
    "end": 118.495,
    "duration": 4.995
  },
  {
    "id": 30,
    "text": "哀而不伤的中和美感。",
    "start": 118.684,
    "end": 120.176,
    "duration": 1.492
  },
  {
    "id": 31,
    "text": "第三，语言浅近自然而洗练精醇，开创大白若浅的古典抒情风格。",
    "start": 120.439,
    "end": 126.615,
    "duration": 6.176
  },
  {
    "id": 32,
    "text": "《古诗十九首》 摆脱了汉赋追求奇僻辞藻与铺排堆砌的习气，",
    "start": 126.9,
    "end": 132.173,
    "duration": 5.273
  },
  {
    "id": 33,
    "text": "展现出大朴不雕的语言纯度。",
    "start": 132.254,
    "end": 134.446,
    "duration": 2.192
  },
  {
    "id": 34,
    "text": "全诗语言如家常说话般质朴清浅，无丝毫雕凿痕迹，",
    "start": 134.645,
    "end": 139.013,
    "duration": 4.368
  },
  {
    "id": 35,
    "text": "却能在极平淡中蕴含极深醇的情味，",
    "start": 139.323,
    "end": 142.24,
    "duration": 2.917
  },
  {
    "id": 36,
    "text": "确立了中国古典抒情诗平淡见奇、语短情长的高超艺术范式。",
    "start": 142.742,
    "end": 148.056,
    "duration": 5.314
  }
]
