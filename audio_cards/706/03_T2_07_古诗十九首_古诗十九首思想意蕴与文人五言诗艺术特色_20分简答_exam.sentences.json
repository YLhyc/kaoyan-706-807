[
  {
    "id": 1,
    "text": "简述《古诗十九首》的思想意蕴与文人五言诗艺术特色。",
    "start": 0.115,
    "end": 4.133,
    "duration": 4.018
  },
  {
    "id": 2,
    "text": "《古诗十九首》最早见录于南朝梁萧统编选的《文选》，",
    "start": 4.633,
    "end": 8.234,
    "duration": 3.601
  },
  {
    "id": 3,
    "text": "产生于东汉中后期宦官外戚专权、社会动荡之际，代表了汉代文人五言诗的最高成就。",
    "start": 8.584,
    "end": 14.943,
    "duration": 6.359
  },
  {
    "id": 4,
    "text": "刘勰《文心雕龙》称其“五言之冠冕”，钟嵘《诗品》评《古诗》及拟作“惊心动魄，可谓几乎一字千金”。",
    "start": 15.443,
    "end": 23.771,
    "duration": 8.328
  },
  {
    "id": 5,
    "text": "其思想意蕴与艺术特色，主要体现在以下三个方面：",
    "start": 24.271,
    "end": 28.294,
    "duration": 4.023
  },
  {
    "id": 6,
    "text": "第一，抒发人生短促之焦虑与游子思妇之悲怨，体现文人自我意识觉醒。",
    "start": 28.925,
    "end": 36.198,
    "duration": 7.273
  },
  {
    "id": 7,
    "text": "《古诗十九首》深刻反映了汉末中下层士人在仕途壅塞与乱世动荡中的生存困境。",
    "start": 36.698,
    "end": 43.475,
    "duration": 6.777
  },
  {
    "id": 8,
    "text": "诗中一方面写下层文人怀才不遇的愤懑以及对生命无常、时光流逝的焦虑，",
    "start": 43.975,
    "end": 50.727,
    "duration": 6.752
  },
  {
    "id": 9,
    "text": "如《生年不满百》以“生年不满百，常怀千岁忧。昼短苦夜长，何不秉烛游”抒发及时行乐背后的深切苦闷；",
    "start": 51.231,
    "end": 61.565,
    "duration": 10.334
  },
  {
    "id": 10,
    "text": "另一方面以真挚笔触书写游子羁旅与思妇闺怨，",
    "start": 62.065,
    "end": 66.668,
    "duration": 4.603
  },
  {
    "id": 11,
    "text": "如《涉江采芙蓉》道尽关山阻隔与人生漂泊之痛，",
    "start": 67.234,
    "end": 71.696,
    "duration": 4.462
  },
  {
    "id": 12,
    "text": "标志着东汉后期文人对个体生命与情感价值的深切觉醒。",
    "start": 72.058,
    "end": 77.264,
    "duration": 5.206
  },
  {
    "id": 13,
    "text": "第二，融汇比兴手法与景情交融之境，奠定文人五言诗含蓄韵味。",
    "start": 77.92,
    "end": 84.106,
    "duration": 6.186
  },
  {
    "id": 14,
    "text": "在艺术表现上，《古诗十九首》继承《诗经》比兴传统并加以文人化创造，",
    "start": 84.651,
    "end": 90.134,
    "duration": 5.483
  },
  {
    "id": 15,
    "text": "善于借眼前风物起兴造境，达到情景交融、物我浑化的境界。",
    "start": 90.635,
    "end": 96.076,
    "duration": 5.441
  },
  {
    "id": 16,
    "text": "如《迢迢牵牛星》通篇借神话星宿起兴，",
    "start": 96.576,
    "end": 100.215,
    "duration": 3.639
  },
  {
    "id": 17,
    "text": "以“盈盈一水间，脉脉不得语”白描隔河相望之苦，无一语直说自身苦衷而离愁自见。",
    "start": 100.565,
    "end": 108.888,
    "duration": 8.323
  },
  {
    "id": 18,
    "text": "同时，组诗善用叠字摹态传声，如“行行重行行”“青青河畔草”，",
    "start": 109.388,
    "end": 115.718,
    "duration": 6.33
  },
  {
    "id": 19,
    "text": "音调回环舒缓，营造出温厚绵邈、哀而不伤的抒情格调。",
    "start": 116.221,
    "end": 121.11,
    "duration": 4.889
  },
  {
    "id": 20,
    "text": "第三，语言浅近精醇而不事雕饰，形成深衷浅貌的古典抒情风范。",
    "start": 121.733,
    "end": 127.814,
    "duration": 6.081
  },
  {
    "id": 21,
    "text": "《古诗十九首》摆脱了汉赋奇字僻词与铺张堆砌的习气，语言如同家常絮语，",
    "start": 128.314,
    "end": 134.804,
    "duration": 6.49
  },
  {
    "id": 22,
    "text": "不作艰深晦涩之辞，却于极平淡的日常用语中浓缩了厚重的人生体悟。",
    "start": 135.154,
    "end": 140.927,
    "duration": 5.773
  },
  {
    "id": 23,
    "text": "这种“浅浅寄言，深深道款”的深衷浅貌风格，把五言诗的抒情表现力推向纯熟，",
    "start": 141.427,
    "end": 147.958,
    "duration": 6.531
  },
  {
    "id": 24,
    "text": "成为建安乃至魏晋南北朝文人五言诗竞相效法的艺术典范。",
    "start": 148.308,
    "end": 153.16,
    "duration": 4.852
  }
]
