[
  {
    "id": 1,
    "text": "简述《古诗十九首》的思想意蕴与文人五言诗艺术特色。",
    "start": 0.115,
    "end": 4.133,
    "duration": 4.018
  },
  {
    "id": 2,
    "text": "《古诗十九首》最早见录于南朝梁萧统编选的《文选》，",
    "start": 4.302,
    "end": 7.903,
    "duration": 3.601
  },
  {
    "id": 3,
    "text": "产生于东汉中后期宦官外戚专权、社会动荡之际，代表了汉代文人五言诗的最高成就。",
    "start": 8.062,
    "end": 14.421,
    "duration": 6.359
  },
  {
    "id": 4,
    "text": "刘勰《文心雕龙》称其“五言之冠冕”，钟嵘《诗品》评《古诗》及拟作“惊心动魄，可谓几乎一字千金”。",
    "start": 14.618,
    "end": 23.054,
    "duration": 8.436
  },
  {
    "id": 5,
    "text": "其思想意蕴与艺术特色，主要体现在以下三个方面：",
    "start": 23.337,
    "end": 27.36,
    "duration": 4.023
  },
  {
    "id": 6,
    "text": "第一，抒发人生短促之焦虑与游子思妇之悲怨，体现文人自我意识觉醒。",
    "start": 27.991,
    "end": 35.264,
    "duration": 7.273
  },
  {
    "id": 7,
    "text": "《古诗十九首》深刻反映了汉末中下层士人在仕途壅塞与乱世动荡中的生存困境。",
    "start": 35.662,
    "end": 42.439,
    "duration": 6.777
  },
  {
    "id": 8,
    "text": "诗中一方面写下层文人怀才不遇的愤懑以及对生命无常、时光流逝的焦虑，",
    "start": 42.834,
    "end": 49.586,
    "duration": 6.752
  },
  {
    "id": 9,
    "text": "如《生年不满百》以“生年不满百，常怀千岁忧。昼短苦夜长，何不秉烛游”抒发及时行乐背后的深切苦闷；",
    "start": 50.09,
    "end": 60.424,
    "duration": 10.334
  },
  {
    "id": 10,
    "text": "另一方面以真挚笔触书写游子羁旅与思妇闺怨，",
    "start": 60.914,
    "end": 65.517,
    "duration": 4.603
  },
  {
    "id": 11,
    "text": "如《涉江采芙蓉》道尽关山阻隔与人生漂泊之痛，",
    "start": 66.083,
    "end": 70.545,
    "duration": 4.462
  },
  {
    "id": 12,
    "text": "标志着东汉后期文人对个体生命与情感价值的深切觉醒。",
    "start": 70.907,
    "end": 76.113,
    "duration": 5.206
  },
  {
    "id": 13,
    "text": "第二，融汇比兴手法与景情交融之境，奠定文人五言诗含蓄韵味。",
    "start": 76.769,
    "end": 82.955,
    "duration": 6.186
  },
  {
    "id": 14,
    "text": "在艺术表现上，《古诗十九首》继承《诗经》比兴传统并加以文人化创造，",
    "start": 83.5,
    "end": 88.983,
    "duration": 5.483
  },
  {
    "id": 15,
    "text": "善于借眼前风物起兴造境，达到情景交融、物我浑化的境界。",
    "start": 89.484,
    "end": 94.925,
    "duration": 5.441
  },
  {
    "id": 16,
    "text": "如《迢迢牵牛星》通篇借神话星宿起兴，",
    "start": 95.396,
    "end": 99.035,
    "duration": 3.639
  },
  {
    "id": 17,
    "text": "以“盈盈一水间，脉脉不得语”白描隔河相望之苦，无一语直说自身苦衷而离愁自见。",
    "start": 99.378,
    "end": 107.701,
    "duration": 8.323
  },
  {
    "id": 18,
    "text": "同时，组诗善用叠字摹态传声，如“行行重行行”“青青河畔草”，",
    "start": 107.905,
    "end": 114.355,
    "duration": 6.45
  },
  {
    "id": 19,
    "text": "音调回环舒缓，营造出温厚绵邈、哀而不伤的抒情格调。",
    "start": 114.738,
    "end": 119.627,
    "duration": 4.889
  },
  {
    "id": 20,
    "text": "第三，语言浅近精醇而不事雕饰，形成深衷浅貌的古典抒情风范。",
    "start": 120.25,
    "end": 126.331,
    "duration": 6.081
  },
  {
    "id": 21,
    "text": "《古诗十九首》摆脱了汉赋奇字僻词与铺张堆砌的习气，语言如同家常絮语，",
    "start": 126.659,
    "end": 133.16,
    "duration": 6.501
  },
  {
    "id": 22,
    "text": "不作艰深晦涩之辞，却于极平淡的日常用语中浓缩了厚重的人生体悟。",
    "start": 133.444,
    "end": 139.217,
    "duration": 5.773
  },
  {
    "id": 23,
    "text": "这种“浅浅寄言，深深道款”的深衷浅貌风格，把五言诗的抒情表现力推向纯熟，",
    "start": 139.561,
    "end": 146.092,
    "duration": 6.531
  },
  {
    "id": 24,
    "text": "成为建安乃至魏晋南北朝文人五言诗竞相效法的艺术典范。",
    "start": 146.369,
    "end": 151.221,
    "duration": 4.852
  }
]