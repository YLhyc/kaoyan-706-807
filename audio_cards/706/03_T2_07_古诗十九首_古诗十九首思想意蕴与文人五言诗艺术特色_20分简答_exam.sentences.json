[
  {
    "id": 1,
    "text": "简述《古诗十九首》的思想意蕴与文人五言诗艺术特色。",
    "start": 0.16,
    "end": 4.72,
    "duration": 4.56
  },
  {
    "id": 2,
    "text": "《古诗十九首》 是东汉末年文人五言诗成熟的标志性代表作。",
    "start": 4.72,
    "end": 10.4,
    "duration": 5.68
  },
  {
    "id": 3,
    "text": "这组诗作最早见于南朝梁萧统编选的 《文选》，",
    "start": 10.48,
    "end": 15.12,
    "duration": 4.64
  },
  {
    "id": 4,
    "text": "产生于东汉中后期宦官专权、外戚争衡、",
    "start": 15.12,
    "end": 19.12,
    "duration": 4.0
  },
  {
    "id": 5,
    "text": "士人社会地位动荡的乱世前夕。",
    "start": 19.12,
    "end": 22.32,
    "duration": 3.2
  },
  {
    "id": 6,
    "text": "刘勰在 《文心雕龙》 中盛赞其为 “五言之冠冕”，",
    "start": 22.32,
    "end": 27.68,
    "duration": 5.36
  },
  {
    "id": 7,
    "text": "钟嵘 《诗品》 誉其为 “惊心动魄，可谓几乎一字千金”。",
    "start": 27.68,
    "end": 33.04,
    "duration": 5.36
  },
  {
    "id": 8,
    "text": "《古诗十九首》 的思想意蕴与艺术特色，",
    "start": 33.04,
    "end": 37.04,
    "duration": 4.0
  },
  {
    "id": 9,
    "text": "主要展现为以下三个核心维度：",
    "start": 37.04,
    "end": 40.08,
    "duration": 3.04
  },
  {
    "id": 10,
    "text": "第一，抒发生命短促之焦灼与身世失意之悲叹，",
    "start": 40.08,
    "end": 44.896,
    "duration": 4.816
  },
  {
    "id": 11,
    "text": "展现深沉的文人觉醒意识。",
    "start": 44.896,
    "end": 47.669,
    "duration": 2.773
  },
  {
    "id": 12,
    "text": "《古诗十九首》 深刻折射了汉末下层文人在门阀垄断与社会动乱下的生存困境。",
    "start": 47.669,
    "end": 55.524,
    "duration": 7.855
  },
  {
    "id": 13,
    "text": "诗歌的核心母题集中于对时光流逝、",
    "start": 55.524,
    "end": 59.22,
    "duration": 3.696
  },
  {
    "id": 14,
    "text": "生命短促与功名无望的生存焦虑。",
    "start": 59.22,
    "end": 62.686,
    "duration": 3.466
  },
  {
    "id": 15,
    "text": "在 《生年不满百》 中，以 “生年不满百，常怀千岁忧。",
    "start": 62.686,
    "end": 68.24,
    "duration": 5.554
  },
  {
    "id": 16,
    "text": "昼短苦夜长，",
    "start": 68.24,
    "end": 69.76,
    "duration": 1.52
  },
  {
    "id": 17,
    "text": "何不秉烛游” 抒发生命短暂的紧迫感与及时行乐的愤懑；",
    "start": 69.76,
    "end": 75.52,
    "duration": 5.76
  },
  {
    "id": 18,
    "text": "在 《涉江采芙蓉》 与 《青青河畔草》 中，",
    "start": 75.52,
    "end": 79.04,
    "duration": 3.52
  },
  {
    "id": 19,
    "text": "则借游子逐客的羁旅之愁与思妇闺怨，写尽了关山阻隔、",
    "start": 79.2,
    "end": 84.08,
    "duration": 4.88
  },
  {
    "id": 20,
    "text": "相见无期的刻骨相思。",
    "start": 84.08,
    "end": 86.08,
    "duration": 2.0
  },
  {
    "id": 21,
    "text": "这种对个体生命价值的深切执着，标志着文人自我意识的真正觉醒。",
    "start": 86.08,
    "end": 92.4,
    "duration": 6.32
  },
  {
    "id": 22,
    "text": "第二，融汇赋比兴表现机制，确立文人五言诗意蕴绵长的审美范式。",
    "start": 92.4,
    "end": 98.88,
    "duration": 6.48
  },
  {
    "id": 23,
    "text": "在艺术表现上，",
    "start": 98.88,
    "end": 100.48,
    "duration": 1.6
  },
  {
    "id": 24,
    "text": "《古诗十九首》 承续 《诗经》 比兴传统并加以文人雅化。",
    "start": 100.48,
    "end": 105.84,
    "duration": 5.36
  },
  {
    "id": 25,
    "text": "作者善于以眼前寻常物象起兴，将外在物候与内在心理浑然交融。",
    "start": 106.16,
    "end": 115.12,
    "duration": 8.96
  },
  {
    "id": 26,
    "text": "如 《迢迢牵牛星》 借神话星汉起兴，以 “盈盈一水间，",
    "start": 115.2,
    "end": 120.56,
    "duration": 5.36
  },
  {
    "id": 27,
    "text": "脉脉不得语” 白描夫妇情思，意境深沉宛转。",
    "start": 120.56,
    "end": 125.6,
    "duration": 5.04
  },
  {
    "id": 28,
    "text": "全诗善用叠字摹态传情，如 “行行重行行”、",
    "start": 125.6,
    "end": 129.76,
    "duration": 4.16
  },
  {
    "id": 29,
    "text": "“青青河畔草”，音律和谐回环，营造出一种温厚低回、",
    "start": 129.76,
    "end": 135.52,
    "duration": 5.76
  },
  {
    "id": 30,
    "text": "哀而不伤的中和美感。",
    "start": 135.52,
    "end": 137.44,
    "duration": 1.92
  },
  {
    "id": 31,
    "text": "第三，语言浅近自然而洗练精醇，开创大白若浅的古典抒情风格。",
    "start": 137.76,
    "end": 143.84,
    "duration": 6.08
  },
  {
    "id": 32,
    "text": "《古诗十九首》 摆脱了汉赋追求奇僻辞藻与铺排堆砌的习气，",
    "start": 143.84,
    "end": 147.84,
    "duration": 4.0
  },
  {
    "id": 33,
    "text": "展现出大朴不雕的语言纯度。",
    "start": 147.68,
    "end": 147.84,
    "duration": 0.16
  },
  {
    "id": 34,
    "text": "全诗语言如家常说话般质朴清浅，无丝毫雕凿痕迹，",
    "start": 147.68,
    "end": 147.84,
    "duration": 0.16
  },
  {
    "id": 35,
    "text": "却能在极平淡中蕴含极深醇的情味，",
    "start": 147.68,
    "end": 147.84,
    "duration": 0.16
  },
  {
    "id": 36,
    "text": "确立了中国古典抒情诗平淡见奇、语短情长的高超艺术范式。",
    "start": 147.68,
    "end": 147.84,
    "duration": 0.16
  }
]