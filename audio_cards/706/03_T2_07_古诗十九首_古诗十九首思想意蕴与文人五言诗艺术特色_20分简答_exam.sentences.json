[
  {
    "id": "sent_1",
    "text": "《古诗十九首》 是东汉末年文人五言诗成熟的标志性代表作。",
    "start": 0.1,
    "end": 5.363,
    "duration": 5.263
  },
  {
    "id": "sent_2",
    "text": "这组诗作最早见于南朝梁萧统编选的 《文选》，",
    "start": 5.313,
    "end": 9.545,
    "duration": 4.232
  },
  {
    "id": "sent_3",
    "text": "产生于东汉中后期宦官专权、外戚争衡、士人社会地位动荡的乱世前夕。",
    "start": 9.544,
    "end": 16.354,
    "duration": 6.81
  },
  {
    "id": "sent_4",
    "text": "刘勰在 《文心雕龙》 中盛赞其为 “五言之冠冕”，",
    "start": 16.354,
    "end": 20.521,
    "duration": 4.167
  },
  {
    "id": "sent_5",
    "text": "钟嵘 《诗品》 誉其为 “惊心动魄，可谓几乎一字千金”。",
    "start": 20.521,
    "end": 25.052,
    "duration": 4.531
  },
  {
    "id": "sent_6",
    "text": "《古诗十九首》 的思想意蕴与艺术特色，",
    "start": 25.052,
    "end": 28.555,
    "duration": 3.503
  },
  {
    "id": "sent_7",
    "text": "主要展现为以下三个核心维度：",
    "start": 28.555,
    "end": 31.836,
    "duration": 3.281
  },
  {
    "id": "sent_8",
    "text": "第一，抒发生命短促之焦灼与身世失意之悲叹，",
    "start": 31.836,
    "end": 36.589,
    "duration": 4.753
  },
  {
    "id": "sent_9",
    "text": "展现深沉的文人觉醒意识。",
    "start": 36.589,
    "end": 39.493,
    "duration": 2.904
  },
  {
    "id": "sent_10",
    "text": "《古诗十九首》 深刻折射了汉末下层文人在门阀垄断与社会动乱下的生存困境。",
    "start": 39.492,
    "end": 46.653,
    "duration": 7.161
  },
  {
    "id": "sent_11",
    "text": "诗歌的核心母题集中于对时光流逝、生命短促与功名无望的生存焦虑。",
    "start": 46.654,
    "end": 53.217,
    "duration": 6.563
  },
  {
    "id": "sent_12",
    "text": "在 《生年不满百》 中，以 “生年不满百，常怀千岁忧。",
    "start": 53.216,
    "end": 58.45,
    "duration": 5.234
  },
  {
    "id": "sent_13",
    "text": "昼短苦夜长，何不秉烛游” 抒发生命短暂的紧迫感与及时行乐的愤懑；",
    "start": 58.451,
    "end": 65.079,
    "duration": 6.628
  },
  {
    "id": "sent_14",
    "text": "在 《涉江采芙蓉》 与 《青青河畔草》 中，",
    "start": 65.078,
    "end": 68.685,
    "duration": 3.607
  },
  {
    "id": "sent_15",
    "text": "则借游子逐客的羁旅之愁与思妇闺怨，",
    "start": 68.685,
    "end": 72.643,
    "duration": 3.958
  },
  {
    "id": "sent_16",
    "text": "写尽了关山阻隔、相见无期的刻骨相思。",
    "start": 72.643,
    "end": 76.524,
    "duration": 3.881
  },
  {
    "id": "sent_17",
    "text": "这种对个体生命价值的深切执着，标志着文人自我意识的真正觉醒。",
    "start": 76.523,
    "end": 82.851,
    "duration": 6.328
  },
  {
    "id": "sent_18",
    "text": "第二，融汇赋比兴表现机制，确立文人五言诗意蕴绵长的审美范式。",
    "start": 82.852,
    "end": 88.92,
    "duration": 6.068
  },
  {
    "id": "sent_19",
    "text": "在艺术表现上，",
    "start": 88.919,
    "end": 90.755,
    "duration": 1.836
  },
  {
    "id": "sent_20",
    "text": "《古诗十九首》 承续 《诗经》 比兴传统并加以文人雅化。",
    "start": 90.755,
    "end": 95.508,
    "duration": 4.753
  },
  {
    "id": "sent_21",
    "text": "作者善于以眼前寻常物象起兴，将外在物候与内在心理浑然交融。",
    "start": 95.508,
    "end": 101.849,
    "duration": 6.341
  },
  {
    "id": "sent_22",
    "text": "如 《迢迢牵牛星》 借神话星汉起兴，以 “盈盈一水间，",
    "start": 101.849,
    "end": 106.927,
    "duration": 5.078
  },
  {
    "id": "sent_23",
    "text": "脉脉不得语” 白描夫妇情思，意境深沉宛转。",
    "start": 106.927,
    "end": 111.38,
    "duration": 4.453
  },
  {
    "id": "sent_24",
    "text": "全诗善用叠字摹态传情，如 “行行重行行”、“青青河畔草”，",
    "start": 111.38,
    "end": 117.018,
    "duration": 5.638
  },
  {
    "id": "sent_25",
    "text": "音律和谐回环，营造出一种温厚低回、哀而不伤的中和美感。",
    "start": 117.018,
    "end": 122.969,
    "duration": 5.951
  },
  {
    "id": "sent_26",
    "text": "第三，语言浅近自然而洗练精醇，开创大白若浅的古典抒情风格。",
    "start": 122.969,
    "end": 129.349,
    "duration": 6.38
  },
  {
    "id": "sent_27",
    "text": "《古诗十九首》 摆脱了汉赋追求奇僻辞藻与铺排堆砌的习气，",
    "start": 129.349,
    "end": 135.065,
    "duration": 5.716
  },
  {
    "id": "sent_28",
    "text": "展现出大朴不雕的语言纯度。",
    "start": 135.065,
    "end": 138.085,
    "duration": 3.02
  },
  {
    "id": "sent_29",
    "text": "全诗语言如家常说话般质朴清浅，无丝毫雕凿痕迹，",
    "start": 138.085,
    "end": 143.541,
    "duration": 5.456
  },
  {
    "id": "sent_30",
    "text": "却能在极平淡中蕴含极深醇的情味，",
    "start": 143.542,
    "end": 147.253,
    "duration": 3.711
  },
  {
    "id": "sent_31",
    "text": "确立了中国古典抒情诗平淡见奇、语短情长的高超艺术范式。",
    "start": 147.253,
    "end": 152.917,
    "duration": 5.664
  }
]