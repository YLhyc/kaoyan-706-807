[
  {
    "id": "sent_1",
    "text": "《古诗十九首》 是东汉末年文人五言诗成熟的标志性代表作。",
    "start": 0.0,
    "end": 4.52,
    "duration": 4.52
  },
  {
    "id": "sent_2",
    "text": "这组诗作最早见于南朝梁萧统编选的 《文选》，",
    "start": 4.969,
    "end": 8.689,
    "duration": 3.72
  },
  {
    "id": "sent_3",
    "text": "产生于东汉中后期宦官专权、外戚争衡、",
    "start": 9.139,
    "end": 12.859,
    "duration": 3.72
  },
  {
    "id": "sent_4",
    "text": "士人社会地位动荡的乱世前夕。",
    "start": 13.309,
    "end": 15.789,
    "duration": 2.48
  },
  {
    "id": "sent_5",
    "text": "刘勰在 《文心雕龙》 中盛赞其为 “五言之冠冕”，",
    "start": 16.319,
    "end": 19.679,
    "duration": 3.36
  },
  {
    "id": "sent_6",
    "text": "钟嵘 《诗品》 誉其为 “惊心动魄，可谓几乎一字千金”。",
    "start": 20.129,
    "end": 24.369,
    "duration": 4.24
  },
  {
    "id": "sent_7",
    "text": "《古诗十九首》 的思想意蕴与艺术特色，",
    "start": 24.819,
    "end": 27.779,
    "duration": 2.96
  },
  {
    "id": "sent_8",
    "text": "主要展现为以下三个核心维度：",
    "start": 28.229,
    "end": 30.629,
    "duration": 2.4
  },
  {
    "id": "sent_9",
    "text": "第一，抒发生命短促之焦灼与身世失意之悲叹，",
    "start": 31.079,
    "end": 35.479,
    "duration": 4.4
  },
  {
    "id": "sent_10",
    "text": "展现深沉的文人觉醒意识。",
    "start": 35.929,
    "end": 38.249,
    "duration": 2.32
  },
  {
    "id": "sent_11",
    "text": "《古诗十九首》 深刻折射了汉末下层文人在门阀垄断与社会动乱下的生存困境。",
    "start": 38.699,
    "end": 44.619,
    "duration": 5.92
  },
  {
    "id": "sent_12",
    "text": "诗歌的核心母题集中于对时光流逝、",
    "start": 45.069,
    "end": 48.269,
    "duration": 3.2
  },
  {
    "id": "sent_13",
    "text": "生命短促与功名无望的生存焦虑。",
    "start": 48.719,
    "end": 51.479,
    "duration": 2.76
  },
  {
    "id": "sent_14",
    "text": "在 《生年不满百》 中，以 “生年不满百，常怀千岁忧。",
    "start": 51.929,
    "end": 56.009,
    "duration": 4.08
  },
  {
    "id": "sent_15",
    "text": "昼短苦夜长，",
    "start": 56.459,
    "end": 57.739,
    "duration": 1.28
  },
  {
    "id": "sent_16",
    "text": "何不秉烛游” 抒发生命短暂的紧迫感与及时行乐的愤懑；",
    "start": 58.189,
    "end": 62.789,
    "duration": 4.6
  },
  {
    "id": "sent_17",
    "text": "在 《涉江采芙蓉》 与 《青青河畔草》 中，",
    "start": 63.239,
    "end": 65.959,
    "duration": 2.72
  },
  {
    "id": "sent_18",
    "text": "则借游子逐客的羁旅之愁与思妇闺怨，写尽了关山阻隔、",
    "start": 66.489,
    "end": 71.209,
    "duration": 4.72
  },
  {
    "id": "sent_19",
    "text": "相见无期的刻骨相思。",
    "start": 71.659,
    "end": 73.739,
    "duration": 2.08
  },
  {
    "id": "sent_20",
    "text": "这种对个体生命价值的深切执着，标志着文人自我意识的真正觉醒。",
    "start": 74.189,
    "end": 79.349,
    "duration": 5.16
  },
  {
    "id": "sent_21",
    "text": "第二，融汇赋比兴表现机制，确立文人五言诗意蕴绵长的审美范式。",
    "start": 79.799,
    "end": 85.199,
    "duration": 5.4
  },
  {
    "id": "sent_22",
    "text": "在艺术表现上，",
    "start": 85.649,
    "end": 86.929,
    "duration": 1.28
  },
  {
    "id": "sent_23",
    "text": "《古诗十九首》 承续 《诗经》 比兴传统并加以文人雅化。",
    "start": 87.379,
    "end": 91.379,
    "duration": 4.0
  },
  {
    "id": "sent_24",
    "text": "作者善于以眼前寻常物象起兴，将外在物候与内在心理浑然交融。",
    "start": 91.829,
    "end": 97.189,
    "duration": 5.36
  },
  {
    "id": "sent_25",
    "text": "如 《迢迢牵牛星》 借神话星汉起兴，以 “盈盈一水间，",
    "start": 97.639,
    "end": 101.879,
    "duration": 4.24
  },
  {
    "id": "sent_26",
    "text": "脉脉不得语” 白描夫妇情思，意境深沉宛转。",
    "start": 102.329,
    "end": 106.329,
    "duration": 4.0
  },
  {
    "id": "sent_27",
    "text": "全诗善用叠字摹态传情，如 “行行重行行”、“青青河畔草”，",
    "start": 106.779,
    "end": 112.019,
    "duration": 5.24
  },
  {
    "id": "sent_28",
    "text": "音律和谐回环，营造出一种温厚低回、哀而不伤的中和美感。",
    "start": 112.469,
    "end": 117.469,
    "duration": 5.0
  },
  {
    "id": "sent_29",
    "text": "第三，语言浅近自然而洗练精醇，开创大白若浅的古典抒情风格。",
    "start": 117.919,
    "end": 123.759,
    "duration": 5.84
  },
  {
    "id": "sent_30",
    "text": "《古诗十九首》 摆脱了汉赋追求奇僻辞藻与铺排堆砌的习气，",
    "start": 124.209,
    "end": 128.809,
    "duration": 4.6
  },
  {
    "id": "sent_31",
    "text": "展现出大朴不雕的语言纯度。",
    "start": 129.259,
    "end": 131.619,
    "duration": 2.36
  },
  {
    "id": "sent_32",
    "text": "全诗语言如家常说话般质朴清浅，无丝毫雕凿痕迹，",
    "start": 132.069,
    "end": 136.709,
    "duration": 4.64
  },
  {
    "id": "sent_33",
    "text": "却能在极平淡中蕴含极深醇的情味，",
    "start": 137.159,
    "end": 140.159,
    "duration": 3.0
  },
  {
    "id": "sent_34",
    "text": "确立了中国古典抒情诗平淡见奇、语短情长的高超艺术范式。",
    "start": 140.609,
    "end": 145.729,
    "duration": 5.12
  }
]