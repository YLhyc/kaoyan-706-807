[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "先共源、再分立两极、后点明唐宋诗史演进律：先定下孟范同宗陶渊明田园血脉（同），",
    "start": 0.222,
    "end": 8.863,
    "duration": 8.64
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再分别拆开盛唐隐士“只见桑麻不见劳苦”的空灵（孟）与南宋地方官直击“湖面亦收租”的稼穑纪实（范）（异），",
    "start": 9.616,
    "end": 19.234,
    "duration": 9.618
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后收束到唐诗重神韵与宋诗重纪实的历史转型。",
    "start": 19.949,
    "end": 24.626,
    "duration": 4.677
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "古代田园诗自陶渊明开创后经唐宋嬗变：",
    "start": 25.395,
    "end": 29.07,
    "duration": 3.676
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "盛唐孟浩然（山水田园）与南宋范成大（田园纪实）同承陶诗遗泽，",
    "start": 29.797,
    "end": 36.064,
    "duration": 6.267
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "却因时代与身份立场呈现出迥异风貌。",
    "start": 36.79,
    "end": 40.004,
    "duration": 3.214
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 同承陶渊明美学、观照乡村与人情",
    "start": 40.784,
    "end": 44.456,
    "duration": 3.672
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "均深承陶渊明田园诗风熏染，摆脱六朝空泛游仙隐逸套路，寄心乡村风光与草木；",
    "start": 45.177,
    "end": 52.263,
    "duration": 7.087
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "真切捕捉岁时节序与乡民淳厚风习，延续亲近自然、向往宁静真淳的田园传统。",
    "start": 53.035,
    "end": 60.242,
    "duration": 7.207
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 孟浩然：隐士闲适视角、写意清淡神韵",
    "start": 61.029,
    "end": 65.118,
    "duration": 4.089
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "盛唐气象与襄阳隐逸使孟浩然将田园视为抒写清高心境的审美空间；",
    "start": 65.826,
    "end": 72.116,
    "duration": 6.29
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《过故人庄》“绿树村边合，青山郭外斜……把酒话桑麻”虽及桑麻却全无耕作劳苦态，",
    "start": 72.875,
    "end": 79.323,
    "duration": 6.448
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "平淡清远而神韵自出，显高华格调。",
    "start": 80.061,
    "end": 83.357,
    "duration": 3.295
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 范成大：地方官视角、纪实农事与民苦",
    "start": 84.135,
    "end": 88.172,
    "duration": 4.036
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《四时田园杂兴》六十首合唐田园诗与农家讽谕传统，使农民成主角；",
    "start": 88.947,
    "end": 94.556,
    "duration": 5.609
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "“昼出耘田夜绩麻……也傍桑阴学种瓜”细录老少耕织；",
    "start": 95.271,
    "end": 99.423,
    "duration": 4.152
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "“采菱辛苦废犁锄……近来湖面亦收租”直面官豪苛税，深怀民生忧患。",
    "start": 100.108,
    "end": 105.903,
    "duration": 5.796
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 由空灵写意转向工细纪实、折射唐宋转型",
    "start": 106.697,
    "end": 111.508,
    "duration": 4.81
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "孟诗重神韵空灵意境，略琐碎农务求心境契合；范诗重纪实细节，纳耕织风俗赋税入诗；",
    "start": 112.279,
    "end": 120.049,
    "duration": 7.769
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "由隐士写意演进至稼穑民生，大幅拓宽古典田园诗的社会认识价值。",
    "start": 120.788,
    "end": 126.566,
    "duration": 5.777
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "孟浩然与范成大同承陶渊明诗脉，却分呈清淡写意与工细纪实两貌，",
    "start": 127.308,
    "end": 133.135,
    "duration": 5.826
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "从盛唐空灵闲适向宋代农事民生写实的演变，折射出唐宋诗歌向日常写实转型的历史规律。",
    "start": 133.893,
    "end": 141.704,
    "duration": 7.811
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：孟浩然盛唐代表作《过故人庄》“把酒话桑麻”全无劳苦态；",
    "start": 142.463,
    "end": 147.852,
    "duration": 5.389
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "范成大南宋代表作《四时田园杂兴》“昼出耘田夜绩麻”直面“湖面亦收租”。",
    "start": 148.649,
    "end": 154.464,
    "duration": 5.814
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出《过故人庄》与《四时田园杂兴》的两组对照核心名句？",
    "start": 155.249,
    "end": 160.771,
    "duration": 5.522
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合隐士 vs 地方官两种身份，解释孟浩然与范成大的观照差异？",
    "start": 161.485,
    "end": 168.255,
    "duration": 6.769
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 这组对比怎样折射出“唐诗重兴象神韵→宋诗重日常纪实”的历史转型？",
    "start": 169.007,
    "end": 176.594,
    "duration": 7.587
  }
]