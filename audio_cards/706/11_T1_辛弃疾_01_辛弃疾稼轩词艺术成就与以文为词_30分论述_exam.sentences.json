[
  {
    "id": 1,
    "text": "为了开篇直击考点要害并确立学术基调，",
    "start": 0.08,
    "end": 3.68,
    "duration": 3.6
  },
  {
    "id": 2,
    "text": "第一句必须给出辛弃疾在豪放词史上的领袖地位与权威评价。",
    "start": 3.68,
    "end": 9.2,
    "duration": 5.52
  },
  {
    "id": 3,
    "text": "所以表述为：辛弃疾是南宋豪放派词人的杰出领袖与集大成者，",
    "start": 9.2,
    "end": 14.88,
    "duration": 5.68
  },
  {
    "id": 4,
    "text": "与北宋苏轼并称为“苏辛”。。",
    "start": 14.88,
    "end": 17.68,
    "duration": 2.8
  },
  {
    "id": 5,
    "text": "紧接着必须点明其区别于普通南宋士大夫的特殊身份，",
    "start": 17.68,
    "end": 22.24,
    "duration": 4.56
  },
  {
    "id": 6,
    "text": "展现其投笔从戎的军事实践。",
    "start": 22.24,
    "end": 24.72,
    "duration": 2.48
  },
  {
    "id": 7,
    "text": "所以表述为：作为南渡“归正人”，",
    "start": 25.04,
    "end": 27.68,
    "duration": 2.64
  },
  {
    "id": 8,
    "text": "辛弃疾青年时期曾亲率五十骑突袭敌营生擒叛将，",
    "start": 27.68,
    "end": 32.56,
    "duration": 4.88
  },
  {
    "id": 9,
    "text": "具备极高的军事天才与抗金复国之志。。",
    "start": 32.56,
    "end": 35.84,
    "duration": 3.28
  },
  {
    "id": 10,
    "text": "随后必须交代其南归后政治受挫的悲剧遭遇，",
    "start": 35.84,
    "end": 39.6,
    "duration": 3.76
  },
  {
    "id": 11,
    "text": "说明其强大精神苦闷的现实来源。",
    "start": 39.6,
    "end": 42.72,
    "duration": 3.12
  },
  {
    "id": 12,
    "text": "所以表述为：南归之后，他饱受南宋统治集团的猜忌排挤，",
    "start": 42.72,
    "end": 47.52,
    "duration": 4.8
  },
  {
    "id": 13,
    "text": "被迫落职闲居带湖与瓢泉二十载。。",
    "start": 47.52,
    "end": 50.72,
    "duration": 3.2
  },
  {
    "id": 14,
    "text": "最后一句必须将身世悲剧与词史革新相咬合，",
    "start": 50.96,
    "end": 55.12,
    "duration": 4.16
  },
  {
    "id": 15,
    "text": "引申出题目要求的核心命题“以文为词”，",
    "start": 55.12,
    "end": 58.56,
    "duration": 3.44
  },
  {
    "id": 16,
    "text": "完成破题。",
    "start": 58.56,
    "end": 59.84,
    "duration": 1.28
  },
  {
    "id": 17,
    "text": "所以表述为：沉重的英雄失路之悲与狂放的政治抱负激烈撞击，",
    "start": 59.84,
    "end": 65.28,
    "duration": 5.44
  },
  {
    "id": 18,
    "text": "促使他继承并极大发展了苏轼“以诗入词”的传统，",
    "start": 65.28,
    "end": 69.76,
    "duration": 4.48
  },
  {
    "id": 19,
    "text": "创造性地开辟了“以文为词”的宏大审美格局，",
    "start": 69.76,
    "end": 73.68,
    "duration": 3.92
  },
  {
    "id": 20,
    "text": "将宋词的思想意蕴与艺术表现力推向了最高峰。。",
    "start": 73.68,
    "end": 77.6,
    "duration": 3.92
  },
  {
    "id": 21,
    "text": "本段用四句话完成全篇破题：首句给出苏辛并称与豪放集大成者地位，",
    "start": 77.84,
    "end": 84.0,
    "duration": 6.16
  },
  {
    "id": 22,
    "text": "次句指出归正人与五十骑突袭的英雄底色，",
    "start": 84.0,
    "end": 87.36,
    "duration": 3.36
  },
  {
    "id": 23,
    "text": "第三句交代落职闲居带湖瓢泉的政治悲剧，",
    "start": 87.36,
    "end": 90.8,
    "duration": 3.44
  },
  {
    "id": 24,
    "text": "末句自然引渡至以文为词的最高成就，",
    "start": 90.8,
    "end": 93.68,
    "duration": 2.88
  },
  {
    "id": 25,
    "text": "立意深沉高远。",
    "start": 93.68,
    "end": 94.88,
    "duration": 1.2
  },
  {
    "id": 26,
    "text": "所以本段具体答题完整版为：辛弃疾是南宋豪放派词人的杰出领袖与集大成者，",
    "start": 94.88,
    "end": 101.76,
    "duration": 6.88
  },
  {
    "id": 27,
    "text": "与北宋苏轼并称为“苏辛”。",
    "start": 101.76,
    "end": 104.4,
    "duration": 2.64
  },
  {
    "id": 28,
    "text": "作为南渡“归正人”，辛弃疾青年时期曾亲率五十骑突袭敌营生擒叛将，",
    "start": 104.4,
    "end": 111.12,
    "duration": 6.72
  },
  {
    "id": 29,
    "text": "具备极高的军事天才与抗金复国之志。",
    "start": 111.12,
    "end": 114.88,
    "duration": 3.76
  },
  {
    "id": 30,
    "text": "南归之后，他饱受南宋统治集团的猜忌排挤，",
    "start": 114.88,
    "end": 118.88,
    "duration": 4.0
  },
  {
    "id": 31,
    "text": "被迫落职闲居带湖与瓢泉二十载。",
    "start": 118.88,
    "end": 121.92,
    "duration": 3.04
  },
  {
    "id": 32,
    "text": "沉重的英雄失路之悲与狂放的政治抱负激烈撞击，",
    "start": 122.24,
    "end": 126.48,
    "duration": 4.24
  },
  {
    "id": 33,
    "text": "促使他继承并极大发展了苏轼“以诗入词”的传统，",
    "start": 126.48,
    "end": 131.04,
    "duration": 4.56
  },
  {
    "id": 34,
    "text": "创造性地开辟了“以文为词”的宏大审美格局，",
    "start": 131.04,
    "end": 134.96,
    "duration": 3.92
  },
  {
    "id": 35,
    "text": "将宋词的思想意蕴与艺术表现力推向了最高峰。--",
    "start": 134.96,
    "end": 138.72,
    "duration": 3.76
  }
]