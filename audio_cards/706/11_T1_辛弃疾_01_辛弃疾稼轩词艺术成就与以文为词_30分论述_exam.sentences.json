[
  {
    "id": 1,
    "text": "辛弃疾是南宋豪放派词人的杰出领袖与集大成者，",
    "start": 0.16,
    "end": 4.72,
    "duration": 4.56
  },
  {
    "id": 2,
    "text": "与北宋苏轼并称为“苏辛”。",
    "start": 4.72,
    "end": 7.36,
    "duration": 2.64
  },
  {
    "id": 3,
    "text": "作为南渡“归正人”，辛弃疾青年时期曾亲率五十骑突袭敌营生擒叛将，",
    "start": 7.36,
    "end": 14.08,
    "duration": 6.72
  },
  {
    "id": 4,
    "text": "具备极高的军事天才与抗金复国之志。",
    "start": 14.08,
    "end": 17.84,
    "duration": 3.76
  },
  {
    "id": 5,
    "text": "南归之后，他饱受南宋统治集团的猜忌排挤，",
    "start": 17.84,
    "end": 21.84,
    "duration": 4.0
  },
  {
    "id": 6,
    "text": "被迫落职闲居带湖与瓢泉二十载。",
    "start": 21.84,
    "end": 24.88,
    "duration": 3.04
  },
  {
    "id": 7,
    "text": "沉重的英雄失路之悲与狂放的政治抱负激烈撞击，",
    "start": 25.12,
    "end": 29.28,
    "duration": 4.16
  },
  {
    "id": 8,
    "text": "促使他继承并极大发展了苏轼“以诗入词”的传统，",
    "start": 29.28,
    "end": 33.68,
    "duration": 4.4
  },
  {
    "id": 9,
    "text": "创造性地开辟了“以文为词”的宏大审美格局，",
    "start": 33.68,
    "end": 37.6,
    "duration": 3.92
  },
  {
    "id": 10,
    "text": "将宋词的思想意蕴与艺术表现力推向了最高峰。",
    "start": 37.6,
    "end": 41.84,
    "duration": 4.24
  },
  {
    "id": 11,
    "text": "首先，“以文为词”彻底打破了传统词体作为“艳科”的狭隘藩篱，",
    "start": 41.84,
    "end": 47.04,
    "duration": 5.2
  },
  {
    "id": 12,
    "text": "在体制与句法上实现了深度的散文化革新。",
    "start": 47.04,
    "end": 50.48,
    "duration": 3.44
  },
  {
    "id": 13,
    "text": "辛弃疾打破了音律与格律的严密束缚，",
    "start": 50.8,
    "end": 53.92,
    "duration": 3.12
  },
  {
    "id": 14,
    "text": "大胆将散文的篇章结构、经史论说与虚字呼应直接植入词作之中。",
    "start": 53.92,
    "end": 60.4,
    "duration": 6.48
  },
  {
    "id": 15,
    "text": "他大量运用设问、反诘与长短相建的生活口语，",
    "start": 60.4,
    "end": 64.64,
    "duration": 4.24
  },
  {
    "id": 16,
    "text": "使词的表达如行云流水般自由磅礴。",
    "start": 64.64,
    "end": 67.92,
    "duration": 3.28
  },
  {
    "id": 17,
    "text": "《水龙吟•登建康赏心亭》中“把吴钩看了，",
    "start": 67.92,
    "end": 71.12,
    "duration": 3.2
  },
  {
    "id": 18,
    "text": "栏杆拍遍，无人会，登临意”，以极具散文化力度的动作连缀，",
    "start": 71.12,
    "end": 76.48,
    "duration": 5.36
  },
  {
    "id": 19,
    "text": "传达出英雄无用武之地的极度愤懑。",
    "start": 76.48,
    "end": 79.28,
    "duration": 2.8
  },
  {
    "id": 20,
    "text": "《摸鱼儿》起首以“更能消几番风雨，",
    "start": 79.44,
    "end": 82.285,
    "duration": 2.845
  },
  {
    "id": 21,
    "text": "匆匆春又归去”的层层盘旋设问，借惜春之情寄寓对国势衰微的深沉忧患，",
    "start": 82.285,
    "end": 88.849,
    "duration": 6.564
  },
  {
    "id": 22,
    "text": "句法跌宕多姿。",
    "start": 88.849,
    "end": 90.162,
    "duration": 1.313
  },
  {
    "id": 23,
    "text": "其次，辛弃疾在创作中实现了典故的大规模融铸，",
    "start": 90.162,
    "end": 94.539,
    "duration": 4.377
  },
  {
    "id": 24,
    "text": "达到了“经史百家无所不用”的化境。",
    "start": 94.539,
    "end": 97.602,
    "duration": 3.063
  },
  {
    "id": 25,
    "text": "刘克庄在《辛稼轩集序》中盛赞其词作才气超拔。",
    "start": 97.602,
    "end": 101.76,
    "duration": 4.158
  },
  {
    "id": 26,
    "text": "辛词用典绝非盲目堆砌前人陈迹，而是将历史典故与自身现实境遇高度融为一体。",
    "start": 101.92,
    "end": 109.28,
    "duration": 7.36
  },
  {
    "id": 27,
    "text": "《永遇乐•京口北固亭怀古》是其用典艺术的巅峰之作。",
    "start": 109.28,
    "end": 114.0,
    "duration": 4.72
  },
  {
    "id": 28,
    "text": "全词熔铸了孙仲谋、刘裕、刘义隆、",
    "start": 114.0,
    "end": 117.6,
    "duration": 3.6
  },
  {
    "id": 29,
    "text": "拓跋焘与廉颇五大历史人物典故。",
    "start": 117.6,
    "end": 120.72,
    "duration": 3.12
  },
  {
    "id": 30,
    "text": "作者借刘义隆“赢得仓皇北顾”的史实，",
    "start": 120.72,
    "end": 124.08,
    "duration": 3.36
  },
  {
    "id": 31,
    "text": "深刻告诫当权者切勿草率北伐。",
    "start": 124.08,
    "end": 126.8,
    "duration": 2.72
  },
  {
    "id": 32,
    "text": "结尾更以“凭谁问：廉颇老矣，尚能饭否”的沉痛反问，",
    "start": 127.04,
    "end": 132.16,
    "duration": 5.12
  },
  {
    "id": 33,
    "text": "将一腔报国无门的暮年悲慨托盘而出，",
    "start": 132.16,
    "end": 135.84,
    "duration": 3.68
  },
  {
    "id": 34,
    "text": "使词作具备了极其厚重的史诗质感。",
    "start": 135.84,
    "end": 138.56,
    "duration": 2.72
  },
  {
    "id": 35,
    "text": "再次，在风格意境上，稼轩词融雄奇豪放、",
    "start": 138.928,
    "end": 142.768,
    "duration": 3.84
  },
  {
    "id": 36,
    "text": "沉郁苍凉与幽默挥谐于一体，呈现出极为多元的美学光谱。",
    "start": 142.768,
    "end": 148.048,
    "duration": 5.28
  },
  {
    "id": 37,
    "text": "《破阵子•为陈同甫赋壮词以寄之》中“醉里挑灯看剑，",
    "start": 148.048,
    "end": 152.368,
    "duration": 4.32
  },
  {
    "id": 38,
    "text": "梦回吹角连营”，以排山倒海之势再现沙场壮景，",
    "start": 152.368,
    "end": 156.528,
    "duration": 4.16
  },
  {
    "id": 39,
    "text": "末句“可怜白发生”陡然跌落，形成极强的情感张力。",
    "start": 156.528,
    "end": 160.928,
    "duration": 4.4
  },
  {
    "id": 40,
    "text": "《贺新郎》中“我见青山多五媚，料青山见我应如是”，",
    "start": 161.088,
    "end": 164.985,
    "duration": 3.897
  },
  {
    "id": 41,
    "text": "展现出物我相视的超拔傲岸。",
    "start": 164.985,
    "end": 167.446,
    "duration": 2.461
  },
  {
    "id": 42,
    "text": "《清平乐•村居》则以白描展现乡村温情。",
    "start": 167.446,
    "end": 170.522,
    "duration": 3.076
  },
  {
    "id": 43,
    "text": "这种刚柔并济的意境创造，彰显出词人博大深沉的精神境界。",
    "start": 170.522,
    "end": 175.649,
    "duration": 5.127
  },
  {
    "id": 44,
    "text": "最后，辛弃疾的稼轩词不仅推动了宋代词体演进的重大变革，",
    "start": 175.649,
    "end": 180.777,
    "duration": 5.128
  },
  {
    "id": 45,
    "text": "更直接催生了南宋辛派爱国词群。",
    "start": 180.777,
    "end": 183.648,
    "duration": 2.871
  },
  {
    "id": 46,
    "text": "他以文为词的大胆拓荒精神与深沉炽热的爱国主义精魂，",
    "start": 183.728,
    "end": 188.368,
    "duration": 4.64
  },
  {
    "id": 47,
    "text": "为后世树立了崇高的人格风范，成为中华民族文学史中无可替代的精神灯塔。",
    "start": 188.368,
    "end": 194.528,
    "duration": 6.16
  }
]