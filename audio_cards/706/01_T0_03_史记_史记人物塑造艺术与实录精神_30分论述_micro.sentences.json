[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《史记》·人物塑造艺术与实录精神",
    "start": 0.134,
    "end": 3.586,
    "duration": 3.452
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "由宏入微再到史魂：先用体制性的“互见法”保持人物真实多面，",
    "start": 4.091,
    "end": 10.503,
    "duration": 6.412
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再以“鸿门宴”等戏剧冲突现场逼出性格光彩，紧接语言动作白描使如见其人，",
    "start": 10.731,
    "end": 18.183,
    "duration": 7.452
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后由“实录与发愤著书”点亮作品灵魂。",
    "start": 18.571,
    "end": 21.863,
    "duration": 3.292
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《史记》是中国古代第一部纪传体通史与古典传记典范。",
    "start": 22.308,
    "end": 27.28,
    "duration": 4.972
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "司马迁秉持发愤著书与实录精神，“究天人之际，通古今之变，成一家之言”，",
    "start": 27.478,
    "end": 34.29,
    "duration": 6.812
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "突破编年、国别局限以“人”为中心，鲁迅赞其“史家之绝唱，无韵之离骚”。",
    "start": 34.598,
    "end": 41.81,
    "duration": 7.212
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 独创“互见法”写多维立体性格",
    "start": 42.504,
    "end": 45.956,
    "duration": 3.452
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "为解决体例整肃与性格多面的矛盾，独创“互见法”（旁见侧出法）：主要事迹入本传，",
    "start": 46.484,
    "end": 53.936,
    "duration": 7.452
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "次要、矛盾或有损形象之事散见他传。",
    "start": 54.164,
    "end": 57.376,
    "duration": 3.212
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《高祖本纪》突出刘邦豁达大度、知人善任；",
    "start": 57.855,
    "end": 62.347,
    "duration": 4.492
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《项羽本纪》借范增之口道其贪财好色，《樊郦滕灌列传》记逃跑推子下车之冷酷，",
    "start": 62.545,
    "end": 69.993,
    "duration": 7.448
  },
  {
    "id": "sec0_step1_c2",
    "dom_key": "sec0_step1_c2",
    "text": "《淮阴侯列传》揭示云梦擒韩信之权谋；",
    "start": 70.008,
    "end": 74.477,
    "duration": 4.469
  },
  {
    "id": "sec0_step2_c0",
    "dom_key": "sec0_step2_c0",
    "text": "既维护本传体例整严，又打破非黑即白脸谱化写法。",
    "start": 74.879,
    "end": 80.091,
    "duration": 5.212
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 精选戏剧化历史场景彰显神采",
    "start": 80.766,
    "end": 84.378,
    "duration": 3.612
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "将漫长历史提炼为高度戏剧化冲突场面，在生死考验中显露人物神采。",
    "start": 84.906,
    "end": 91.718,
    "duration": 6.812
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《项羽本纪》“鸿门宴”以刘邦谢罪、范增举玦、项庄舞剑、樊哙闯帐、间道脱逃为主线：",
    "start": 92.233,
    "end": 100.405,
    "duration": 8.172
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "写尽项羽自矜寡谋、刘邦隐忍机警、张良沉着与范增急躁；",
    "start": 100.793,
    "end": 106.005,
    "duration": 5.212
  },
  {
    "id": "sec1_step2_c0",
    "dom_key": "sec1_step2_c0",
    "text": "渑池之会、完璧归赵、易水送别等名场面，皆以紧凑张力写活历史风神。",
    "start": 106.533,
    "end": 113.105,
    "duration": 6.572
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 个性化对话与传神细节白描",
    "start": 113.81,
    "end": 117.022,
    "duration": 3.212
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "对话肖其声口：陈胜仰天“王侯将相宁有种乎”尽显豪气；",
    "start": 117.55,
    "end": 123.562,
    "duration": 6.012
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "见秦皇出巡，项羽“彼可取而代也”显张扬强悍，刘邦叹“大丈夫当如此也”折出深沉欲望；",
    "start": 123.92,
    "end": 133.342,
    "duration": 9.422
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "李广一生不得封侯之“数奇”寡言、廉颇肉袒负荆请罪的诚挚勇毅，通过片言动作跃然纸上。",
    "start": 133.847,
    "end": 142.339,
    "duration": 8.492
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 贯注发愤著书激情与“实录”精神",
    "start": 143.025,
    "end": 146.717,
    "duration": 3.692
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "坚持班固所赞“不虚美，不隐恶”实录原则，既肯开国功业，亦不讳汉武帝晚年穷兵黩武与猜忌残酷；",
    "start": 147.215,
    "end": 158.187,
    "duration": 10.972
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "在《太史公自序》与卷尾“太史公曰”直抒胸臆，深情同情屈原、李广及刺客游侠；",
    "start": 158.715,
    "end": 166.807,
    "duration": 8.092
  },
  {
    "id": "sec3_step2_c0",
    "dom_key": "sec3_step2_c0",
    "text": "使《史记》兼具史学信实之风与强烈抒情感染力。",
    "start": 167.133,
    "end": 171.945,
    "duration": 4.812
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "司马迁以纪传体与互见法在冲突与白描细节中写活各阶层人物，",
    "start": 172.652,
    "end": 179.304,
    "duration": 6.652
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "将“不虚美，不隐恶”实录精神与发愤悲悯结合，既开创正史传记体制，",
    "start": 179.692,
    "end": 185.944,
    "duration": 6.252
  },
  {
    "id": "concl_c2",
    "dom_key": "concl_c2",
    "text": "亦直接启迪唐宋古文与后世叙事文学。",
    "start": 186.252,
    "end": 189.464,
    "duration": 3.212
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：《史记》首创纪传体通史与“互见法”；《汉书》则是我国第一部纪传体断代史。",
    "start": 190.144,
    "end": 196.716,
    "duration": 6.572
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 《史记》如何借刘邦本纪与他传落实“互见法”？",
    "start": 197.165,
    "end": 202.057,
    "duration": 4.892
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 鸿门宴五个转折点分别映照哪四位人物？",
    "start": 202.534,
    "end": 206.946,
    "duration": 4.412
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ “不虚美，不隐恶”与“太史公曰”怎样统一史学与文学？",
    "start": 207.47,
    "end": 213.082,
    "duration": 5.612
  }
]