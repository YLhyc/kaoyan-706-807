[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《史记》·人物塑造艺术与实录精神",
    "start": 0.134,
    "end": 2.945,
    "duration": 2.812
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "由宏入微再到史魂：先用体制性的“互见法”保持人物真实多面，",
    "start": 3.535,
    "end": 9.692,
    "duration": 6.158
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再以“鸿门宴”等戏剧冲突现场逼出性格光彩，紧接语言动作白描使如见其人，",
    "start": 10.019,
    "end": 16.932,
    "duration": 6.913
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后由“实录与发愤著书”点亮作品灵魂。",
    "start": 17.033,
    "end": 20.248,
    "duration": 3.215
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《史记》是中国古代第一部纪传体通史与古典传记典范。",
    "start": 20.835,
    "end": 25.391,
    "duration": 4.556
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "司马迁秉持发愤著书与实录精神，“究天人之际，通古今之变，成一家之言”，",
    "start": 25.978,
    "end": 32.462,
    "duration": 6.483
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "突破编年、国别局限以“人”为中心，鲁迅赞其“史家之绝唱，无韵之离骚”。",
    "start": 32.593,
    "end": 39.272,
    "duration": 6.679
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 独创“互见法”写多维立体性格",
    "start": 39.845,
    "end": 43.217,
    "duration": 3.371
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "为解决体例整肃与性格多面的矛盾，独创“互见法”（旁见侧出法）：主要事迹入本传，",
    "start": 43.791,
    "end": 51.329,
    "duration": 7.538
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "次要、矛盾或有损形象之事散见他传。",
    "start": 51.629,
    "end": 55.365,
    "duration": 3.736
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《高祖本纪》突出刘邦豁达大度、知人善任；",
    "start": 55.939,
    "end": 60.743,
    "duration": 4.804
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《项羽本纪》借范增之口道其贪财好色，《樊郦滕灌列传》记逃跑推子下车之冷酷，",
    "start": 60.952,
    "end": 68.321,
    "duration": 7.369
  },
  {
    "id": "sec0_step1_c2",
    "dom_key": "sec0_step1_c2",
    "text": "《淮阴侯列传》揭示云梦擒韩信之权谋；",
    "start": 68.608,
    "end": 72.032,
    "duration": 3.423
  },
  {
    "id": "sec0_step2_c0",
    "dom_key": "sec0_step2_c0",
    "text": "既维护本传体例整严，又打破非黑即白脸谱化写法。",
    "start": 72.606,
    "end": 77.683,
    "duration": 5.077
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 精选戏剧化历史场景彰显神采",
    "start": 78.27,
    "end": 81.941,
    "duration": 3.671
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "将漫长历史提炼为高度戏剧化冲突场面，在生死考验中显露人物神采。",
    "start": 82.515,
    "end": 89.285,
    "duration": 6.77
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《项羽本纪》“鸿门宴”以刘邦谢罪、范增举玦、项庄舞剑、樊哙闯帐、间道脱逃为主线：",
    "start": 89.858,
    "end": 98.23,
    "duration": 8.371
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "写尽项羽自矜寡谋、刘邦隐忍机警、张良沉着与范增急躁；",
    "start": 98.309,
    "end": 103.907,
    "duration": 5.598
  },
  {
    "id": "sec1_step2_c0",
    "dom_key": "sec1_step2_c0",
    "text": "渑池之会、完璧归赵、易水送别等名场面，皆以紧凑张力写活历史风神。",
    "start": 104.494,
    "end": 111.798,
    "duration": 7.304
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 个性化对话与传神细节白描",
    "start": 112.385,
    "end": 115.795,
    "duration": 3.41
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "对话肖其声口：陈胜仰天“王侯将相宁有种乎”尽显豪气；",
    "start": 116.382,
    "end": 121.902,
    "duration": 5.52
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "见秦皇出巡，项羽“彼可取而代也”显张扬强悍，刘邦叹“大丈夫当如此也”折出深沉欲望；",
    "start": 122.267,
    "end": 130.365,
    "duration": 8.098
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "李广一生不得封侯之“数奇”寡言、廉颇肉袒负荆请罪的诚挚勇毅，通过片言动作跃然纸上。",
    "start": 130.952,
    "end": 139.844,
    "duration": 8.892
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 贯注发愤著书激情与“实录”精神",
    "start": 140.431,
    "end": 144.037,
    "duration": 3.606
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "坚持班固所赞“不虚美，不隐恶”实录原则，既肯开国功业，亦不讳汉武帝晚年穷兵黩武与猜忌残酷；",
    "start": 144.611,
    "end": 154.141,
    "duration": 9.53
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "在《太史公自序》与卷尾“太史公曰”直抒胸臆，深情同情屈原、李广及刺客游侠；",
    "start": 154.715,
    "end": 163.074,
    "duration": 8.358
  },
  {
    "id": "sec3_step2_c0",
    "dom_key": "sec3_step2_c0",
    "text": "使《史记》兼具史学信实之风与强烈抒情感染力。",
    "start": 163.661,
    "end": 168.178,
    "duration": 4.517
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "司马迁以纪传体与互见法在冲突与白描细节中写活各阶层人物，",
    "start": 168.752,
    "end": 174.558,
    "duration": 5.806
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "将“不虚美，不隐恶”实录精神与发愤悲悯结合，既开创正史传记体制，",
    "start": 174.715,
    "end": 181.16,
    "duration": 6.444
  },
  {
    "id": "concl_c2",
    "dom_key": "concl_c2",
    "text": "亦直接启迪唐宋古文与后世叙事文学。",
    "start": 181.447,
    "end": 185.001,
    "duration": 3.554
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：《史记》首创纪传体通史与“互见法”；《汉书》则是我国第一部纪传体断代史。",
    "start": 185.588,
    "end": 192.618,
    "duration": 7.03
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 《史记》如何借刘邦本纪与他传落实“互见法”？",
    "start": 193.192,
    "end": 198.152,
    "duration": 4.96
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 鸿门宴五个转折点分别映照哪四位人物？",
    "start": 198.739,
    "end": 203.36,
    "duration": 4.621
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ “不虚美，不隐恶”与“太史公曰”怎样统一史学与文学？",
    "start": 203.947,
    "end": 209.844,
    "duration": 5.897
  }
]