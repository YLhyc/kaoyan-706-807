[
  {
    "id": 1,
    "text": "试论《水浒传》的叙事结构与林冲人物塑造。",
    "start": 0.16,
    "end": 4.0,
    "duration": 3.84
  },
  {
    "id": 2,
    "text": "《水浒传》 是中国文学史上第一部全面描写农民起义的长篇白话章回小说，",
    "start": 4.0,
    "end": 10.64,
    "duration": 6.64
  },
  {
    "id": 3,
    "text": "开创了中国古典英雄传奇小说的叙事高峰。",
    "start": 10.64,
    "end": 14.24,
    "duration": 3.6
  },
  {
    "id": 4,
    "text": "面对北宋末年黑暗腐朽的封建统治与阶级矛盾激化，",
    "start": 14.24,
    "end": 18.88,
    "duration": 4.64
  },
  {
    "id": 5,
    "text": "施耐庵吸纳宋元水浒话本与戏曲养分，",
    "start": 18.88,
    "end": 22.16,
    "duration": 3.28
  },
  {
    "id": 6,
    "text": "以宏伟的艺术笔触深刻揭示了 “官逼民反，",
    "start": 22.16,
    "end": 26.4,
    "duration": 4.24
  },
  {
    "id": 7,
    "text": "乱自上作” 的深刻历史必然性。",
    "start": 26.4,
    "end": 29.84,
    "duration": 3.44
  },
  {
    "id": 8,
    "text": "金圣叹评其 “文章不避重复，而自不重复”，",
    "start": 29.84,
    "end": 34.8,
    "duration": 4.96
  },
  {
    "id": 9,
    "text": "对其叙事与人物塑造推崇备至。",
    "start": 34.8,
    "end": 37.44,
    "duration": 2.64
  },
  {
    "id": 10,
    "text": "其叙事结构特征与林冲人物形象塑造，",
    "start": 37.44,
    "end": 41.44,
    "duration": 4.0
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：第一，",
    "start": 41.44,
    "end": 45.6,
    "duration": 4.16
  },
  {
    "id": 12,
    "text": "开创由单人传奇串联走向群体聚合的链条式单线演进叙事结构。",
    "start": 45.6,
    "end": 51.68,
    "duration": 6.08
  },
  {
    "id": 13,
    "text": "《水浒传》 在前七十回的架构上，",
    "start": 51.68,
    "end": 54.8,
    "duration": 3.12
  },
  {
    "id": 14,
    "text": "创造性地打破了全景网状模式，",
    "start": 54.8,
    "end": 57.36,
    "duration": 2.56
  },
  {
    "id": 15,
    "text": "采用了 “链条式” 的递进结构。",
    "start": 57.36,
    "end": 61.04,
    "duration": 3.68
  },
  {
    "id": 16,
    "text": "作者往往以一个英雄人物为叙事焦点，详细展开其受屈被害、",
    "start": 61.04,
    "end": 66.88,
    "duration": 5.84
  },
  {
    "id": 17,
    "text": "奋起反抗的完整独立传奇（如鲁智深大闹野猪林、",
    "start": 66.88,
    "end": 71.36,
    "duration": 4.48
  },
  {
    "id": 18,
    "text": "林冲风雪山神庙、杨志卖刀、武松景阳冈打虎与醉打蒋门神）；",
    "start": 71.36,
    "end": 76.64,
    "duration": 5.28
  },
  {
    "id": 19,
    "text": "当该英雄被逼入绝境逼上梁山时，",
    "start": 76.64,
    "end": 79.76,
    "duration": 3.12
  },
  {
    "id": 20,
    "text": "又顺势带出下一位好汉的命运。",
    "start": 79.84,
    "end": 82.8,
    "duration": 2.96
  },
  {
    "id": 21,
    "text": "这种如同链环互扣的单人传奇推进方式，",
    "start": 82.8,
    "end": 86.32,
    "duration": 3.52
  },
  {
    "id": 22,
    "text": "使小说情节既具短篇传奇的引人入胜，",
    "start": 86.88,
    "end": 90.4,
    "duration": 3.52
  },
  {
    "id": 23,
    "text": "又如百川归海般汇聚为梁山泊大聚义的壮阔史诗，",
    "start": 90.4,
    "end": 95.2,
    "duration": 4.8
  },
  {
    "id": 24,
    "text": "生动再现了起义力量由点到面的历史汇聚过程。第二，",
    "start": 95.2,
    "end": 100.88,
    "duration": 5.68
  },
  {
    "id": 25,
    "text": "以精微心理与行动细节塑造具有深刻发展性的性格典型（以林冲为例）。",
    "start": 100.88,
    "end": 107.76,
    "duration": 6.88
  },
  {
    "id": 26,
    "text": "在人物塑造上，",
    "start": 107.76,
    "end": 109.68,
    "duration": 1.92
  },
  {
    "id": 27,
    "text": "《水浒传》 摆脱了传统说书人物性格固定扁平的缺陷，",
    "start": 109.68,
    "end": 114.56,
    "duration": 4.88
  },
  {
    "id": 28,
    "text": "塑造出具有复杂心理演变与鲜明发展轨迹的典型性格。",
    "start": 114.88,
    "end": 119.44,
    "duration": 4.56
  },
  {
    "id": 29,
    "text": "其中 “豹子头林冲” 的塑造堪称绝笔：",
    "start": 119.44,
    "end": 122.88,
    "duration": 3.44
  },
  {
    "id": 30,
    "text": "作为东京八十万禁军教头，",
    "start": 122.88,
    "end": 125.6,
    "duration": 2.72
  },
  {
    "id": 31,
    "text": "林冲本属封建统治体制内的既得利益者。",
    "start": 125.6,
    "end": 129.76,
    "duration": 4.16
  },
  {
    "id": 32,
    "text": "在遭到高衙内调戏妻子、被陷害误入白虎堂后，",
    "start": 129.76,
    "end": 134.48,
    "duration": 4.72
  },
  {
    "id": 33,
    "text": "他首先表现出的是屈从隐忍、息事宁人的妥协心理；",
    "start": 134.48,
    "end": 139.6,
    "duration": 5.12
  },
  {
    "id": 34,
    "text": "在刺配沧州路上，董超、薛霸以沸水烫脚、野猪林行刺，",
    "start": 139.6,
    "end": 145.2,
    "duration": 5.6
  },
  {
    "id": 35,
    "text": "他依然委曲求全；直到草料场被点燃，",
    "start": 145.2,
    "end": 148.64,
    "duration": 3.44
  },
  {
    "id": 36,
    "text": "在山神庙前偷听到陆谦等人置其于死地的密谋，",
    "start": 148.64,
    "end": 153.104,
    "duration": 4.464
  },
  {
    "id": 37,
    "text": "林冲对体制的幻想才彻底破灭，愤而手刃仇敌、风雪上梁山。",
    "start": 153.104,
    "end": 158.304,
    "duration": 5.2
  },
  {
    "id": 38,
    "text": "这种由隐忍委曲到彻底反叛的性格蜕变，",
    "start": 158.304,
    "end": 161.584,
    "duration": 3.28
  },
  {
    "id": 39,
    "text": "深刻揭示了“逼上梁山”的历史必然规律。",
    "start": 161.584,
    "end": 165.344,
    "duration": 3.76
  },
  {
    "id": 40,
    "text": "第三，长于在极其相似的生活情节中展现绝不雷同的个性化风貌。",
    "start": 165.344,
    "end": 171.344,
    "duration": 6.0
  },
  {
    "id": 41,
    "text": "施耐庵具备极其出色的艺术提炼功力，",
    "start": 171.344,
    "end": 174.944,
    "duration": 3.6
  },
  {
    "id": 42,
    "text": "善于在同类题材中刻画人物之异。",
    "start": 174.944,
    "end": 178.304,
    "duration": 3.36
  },
  {
    "id": 43,
    "text": "金圣叹盛赞其写一百零八人，直是一百零八样。",
    "start": 178.304,
    "end": 183.424,
    "duration": 5.12
  },
  {
    "id": 44,
    "text": "以打虎为例，李逵在沂岭杀四虎，纯用蛮力直扑，",
    "start": 183.424,
    "end": 188.464,
    "duration": 5.04
  },
  {
    "id": 45,
    "text": "充溢着为母报仇的狂暴与悲切；武松在景阳冈打虎，",
    "start": 188.464,
    "end": 193.344,
    "duration": 4.88
  },
  {
    "id": 46,
    "text": "则兼备酒后豪气与惊险格斗中的机敏沉着。",
    "start": 193.344,
    "end": 198.064,
    "duration": 4.72
  },
  {
    "id": 47,
    "text": "同样是鲁莽粗豪，鲁智深粗中有细、见义勇为，",
    "start": 198.064,
    "end": 202.864,
    "duration": 4.8
  },
  {
    "id": 48,
    "text": "具有佛家慈悲怀抱；李逵则赤诚天真而滥杀无辜，",
    "start": 202.864,
    "end": 206.864,
    "duration": 4.0
  },
  {
    "id": 49,
    "text": "充满原始破坏力。",
    "start": 206.864,
    "end": 208.624,
    "duration": 1.76
  },
  {
    "id": 50,
    "text": "这种对人性幽微同异的精准把握，使水浒群像鲜活生动、历久弥新。",
    "start": 208.624,
    "end": 214.784,
    "duration": 6.16
  },
  {
    "id": 51,
    "text": "第四，创造出成熟生动的古代白话小说语言，",
    "start": 214.784,
    "end": 219.104,
    "duration": 4.32
  },
  {
    "id": 52,
    "text": "确立通俗叙事的纯正文风。",
    "start": 219.104,
    "end": 222.144,
    "duration": 3.04
  },
  {
    "id": 53,
    "text": "《水浒传》 在语言运用上实现了划时代的突破。",
    "start": 222.144,
    "end": 227.104,
    "duration": 4.96
  },
  {
    "id": 54,
    "text": "它彻底摆脱了文言史传文与骈俪浮词的束缚，",
    "start": 227.104,
    "end": 232.224,
    "duration": 5.12
  },
  {
    "id": 55,
    "text": "以宋元明成熟的北方白话口语为基础，经过艺术提炼，",
    "start": 232.224,
    "end": 237.344,
    "duration": 5.12
  },
  {
    "id": 56,
    "text": "创造出极其洗练、明快、生动的通俗叙事母语。",
    "start": 237.344,
    "end": 238.464,
    "duration": 1.12
  },
  {
    "id": 57,
    "text": "书中人物对话完全符合其身份、阶层与个性，",
    "start": 238.304,
    "end": 238.464,
    "duration": 0.16
  },
  {
    "id": 58,
    "text": "“其言如出其口”；在描写风雪、打斗等场面时，",
    "start": 238.304,
    "end": 238.464,
    "duration": 0.16
  },
  {
    "id": 59,
    "text": "动词运用精练准确，如林冲在山神庙用石头“把门拽开，",
    "start": 238.304,
    "end": 238.464,
    "duration": 0.16
  },
  {
    "id": 60,
    "text": "挺着朴刀”等动作描写，字字传神，",
    "start": 238.304,
    "end": 238.464,
    "duration": 0.16
  },
  {
    "id": 61,
    "text": "达到了中国古代白话小说语言艺术的极高成就。",
    "start": 238.304,
    "end": 238.464,
    "duration": 0.16
  }
]