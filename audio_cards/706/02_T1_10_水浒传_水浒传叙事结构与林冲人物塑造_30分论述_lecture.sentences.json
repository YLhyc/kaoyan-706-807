[
  {
    "id": 1,
    "text": "试论《水浒传》的叙事结构与林冲人物塑造。",
    "start": 0.104,
    "end": 3.536,
    "duration": 3.432
  },
  {
    "id": 2,
    "text": "《水浒传》是中国文学史上第一部全面描写农民起义的长篇白话章回小说，",
    "start": 3.824,
    "end": 9.734,
    "duration": 5.91
  },
  {
    "id": 3,
    "text": "开创了古典英雄传奇小说的创作高峰。",
    "start": 10.066,
    "end": 12.917,
    "duration": 2.851
  },
  {
    "id": 4,
    "text": "面对封建社会黑暗腐朽的政治现实，",
    "start": 13.295,
    "end": 15.964,
    "duration": 2.669
  },
  {
    "id": 5,
    "text": "施耐庵熔裁宋元水浒话本与戏曲养分，",
    "start": 16.078,
    "end": 19.554,
    "duration": 3.476
  },
  {
    "id": 6,
    "text": "以宏阔笔墨揭示了“官逼民反，乱自上作”的历史必然。",
    "start": 19.796,
    "end": 24.144,
    "duration": 4.348
  },
  {
    "id": 7,
    "text": "金圣叹评其“文章不避重复，而自不重复”，",
    "start": 24.405,
    "end": 27.97,
    "duration": 3.565
  },
  {
    "id": 8,
    "text": "对其结构与写人艺术推重备至。",
    "start": 28.191,
    "end": 30.432,
    "duration": 2.241
  },
  {
    "id": 9,
    "text": "其叙事结构与林冲形象塑造，主要体现在以下四个方面：",
    "start": 30.639,
    "end": 34.672,
    "duration": 4.033
  },
  {
    "id": 10,
    "text": "第一，采用单人传奇串联、百川入海的链条式结构推进全篇。",
    "start": 35.273,
    "end": 40.405,
    "duration": 5.132
  },
  {
    "id": 11,
    "text": "《水浒传》在前七十回创造性地采用了连环钩锁、",
    "start": 41.246,
    "end": 44.597,
    "duration": 3.351
  },
  {
    "id": 12,
    "text": "百川入海式的单线纵向结构。",
    "start": 44.951,
    "end": 47.457,
    "duration": 2.506
  },
  {
    "id": 13,
    "text": "作者往往集中数回专写一位或一组好汉的独立传奇，",
    "start": 48.014,
    "end": 52.176,
    "duration": 4.162
  },
  {
    "id": 14,
    "text": "如鲁智深大闹野猪林、林冲风雪山神庙、杨志卖刀、",
    "start": 52.829,
    "end": 57.068,
    "duration": 4.239
  },
  {
    "id": 15,
    "text": "武松景阳冈打虎等，待该英雄被逼投奔梁山时，",
    "start": 57.362,
    "end": 61.21,
    "duration": 3.848
  },
  {
    "id": 16,
    "text": "顺势引出下一位好汉的命运，而前人退居次席。",
    "start": 61.557,
    "end": 65.085,
    "duration": 3.528
  },
  {
    "id": 17,
    "text": "这种链条式结构兼顾了单篇传奇的紧凑曲折与长篇聚义的宏阔气势，",
    "start": 65.406,
    "end": 70.945,
    "duration": 5.539
  },
  {
    "id": 18,
    "text": "宛如百川汇聚成江海，",
    "start": 71.119,
    "end": 72.963,
    "duration": 1.844
  },
  {
    "id": 19,
    "text": "生动再现了起义队伍由点及面的汇聚历程。",
    "start": 73.28,
    "end": 76.886,
    "duration": 3.606
  },
  {
    "id": 20,
    "text": "第二，注重性格的流动性与层次性，塑造林冲这一发展型典型形象。",
    "start": 77.579,
    "end": 83.513,
    "duration": 5.934
  },
  {
    "id": 21,
    "text": "在人物塑造上，",
    "start": 83.992,
    "end": 84.991,
    "duration": 0.999
  },
  {
    "id": 22,
    "text": "《水浒传》摆脱了传统说书人物性格静态定型的局限，",
    "start": 85.245,
    "end": 89.177,
    "duration": 3.932
  },
  {
    "id": 23,
    "text": "写出人物性格在环境逼迫下的发展变化，",
    "start": 89.375,
    "end": 92.587,
    "duration": 3.212
  },
  {
    "id": 24,
    "text": "其中“豹子头林冲”最具代表性。",
    "start": 92.991,
    "end": 95.413,
    "duration": 2.422
  },
  {
    "id": 25,
    "text": "身为八十万禁军教头，林冲原是安于现状、",
    "start": 95.884,
    "end": 99.464,
    "duration": 3.58
  },
  {
    "id": 26,
    "text": "委曲求全的中下级军官：高衙内调戏其妻时，",
    "start": 99.741,
    "end": 103.76,
    "duration": 4.019
  },
  {
    "id": 27,
    "text": "他因怕得罪上司而强忍退让；误入白虎堂、",
    "start": 104.038,
    "end": 107.578,
    "duration": 3.54
  },
  {
    "id": 28,
    "text": "发配沧州及野猪林遇险，他仍抱有“重见天日”的幻想；",
    "start": 107.777,
    "end": 111.934,
    "duration": 4.157
  },
  {
    "id": 29,
    "text": "直到草料场起火，",
    "start": 112.403,
    "end": 113.659,
    "duration": 1.256
  },
  {
    "id": 30,
    "text": "在山神庙中偷听到陆谦等人置其于死地的密谋，",
    "start": 113.754,
    "end": 117.592,
    "duration": 3.838
  },
  {
    "id": 31,
    "text": "林冲的幻想破灭，遂挺枪杀仇、雪夜上梁山。",
    "start": 117.986,
    "end": 122.064,
    "duration": 4.078
  },
  {
    "id": 32,
    "text": "这一从隐忍妥协到决然反抗的性格转变，",
    "start": 122.381,
    "end": 125.504,
    "duration": 3.123
  },
  {
    "id": 33,
    "text": "深刻写出了“逼上梁山”的必然逻辑。",
    "start": 125.858,
    "end": 128.548,
    "duration": 2.69
  },
  {
    "id": 34,
    "text": "第三，于相似情节中刻画同而不同的群像个性，犯中求避。",
    "start": 129.162,
    "end": 134.177,
    "duration": 5.015
  },
  {
    "id": 35,
    "text": "施耐庵善于在相似冲突中写活人物性格之异，",
    "start": 134.547,
    "end": 138.148,
    "duration": 3.601
  },
  {
    "id": 36,
    "text": "金圣叹在《读第五才子书法》中盛赞其“把一百八个人性格都写出来”。",
    "start": 138.436,
    "end": 143.678,
    "duration": 5.242
  },
  {
    "id": 37,
    "text": "以打虎为例，",
    "start": 144.209,
    "end": 144.996,
    "duration": 0.787
  },
  {
    "id": 38,
    "text": "武松景阳冈打虎写出了醉酒后的神勇与紧要关头的机敏沉着，",
    "start": 145.21,
    "end": 149.928,
    "duration": 4.718
  },
  {
    "id": 39,
    "text": "李逵沂岭杀四虎则纯凭蛮力直扑，充溢着为母复仇的狂暴悲愤；",
    "start": 150.199,
    "end": 155.91,
    "duration": 5.711
  },
  {
    "id": 40,
    "text": "同为粗豪侠义，鲁智深粗中有细、仗义疏财，李逵却率真莽撞、",
    "start": 156.195,
    "end": 161.764,
    "duration": 5.569
  },
  {
    "id": 41,
    "text": "不顾法度。",
    "start": 162.061,
    "end": 162.726,
    "duration": 0.665
  },
  {
    "id": 42,
    "text": "这种“同而不同”的对比刻画，使水浒群像鲜明立体、跃然纸上。",
    "start": 162.931,
    "end": 167.635,
    "duration": 4.704
  },
  {
    "id": 43,
    "text": "第四，纯熟运用古代白话语体，以个性化对话与传神动作写景状物。",
    "start": 168.266,
    "end": 174.346,
    "duration": 6.08
  },
  {
    "id": 44,
    "text": "《水浒传》突破了文言史传与半文半白旧体的束缚，",
    "start": 174.487,
    "end": 178.217,
    "duration": 3.73
  },
  {
    "id": 45,
    "text": "在北方民间口语基础上提炼出洗练明快的文学白话。",
    "start": 178.386,
    "end": 182.67,
    "duration": 4.284
  },
  {
    "id": 46,
    "text": "全书人物对话切合身份个性，做到“一样人，",
    "start": 182.831,
    "end": 186.386,
    "duration": 3.555
  },
  {
    "id": 47,
    "text": "便还他一样说话”；写景状物亦字字传神，",
    "start": 186.526,
    "end": 190.339,
    "duration": 3.813
  },
  {
    "id": 48,
    "text": "如第十回“那雪正下得紧”的氛围烘托，",
    "start": 190.611,
    "end": 193.708,
    "duration": 3.097
  },
  {
    "id": 49,
    "text": "以及林冲在山神庙内先搬大石靠住庙门、听明阴谋后推石拽门、",
    "start": 194.093,
    "end": 200.026,
    "duration": 5.933
  },
  {
    "id": 50,
    "text": "挺着朴刀杀出等连续动作白描，精准有力，",
    "start": 200.141,
    "end": 203.534,
    "duration": 3.393
  },
  {
    "id": 51,
    "text": "标志着中国古代白话长篇小说语言艺术的成熟。",
    "start": 203.901,
    "end": 207.816,
    "duration": 3.915
  }
]