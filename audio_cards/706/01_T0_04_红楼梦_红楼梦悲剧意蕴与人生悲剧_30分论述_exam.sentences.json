[
  {
    "id": 1,
    "text": "试论《红楼梦》的悲剧意蕴与叙事艺术成就。",
    "start": 0.134,
    "end": 3.266,
    "duration": 3.132
  },
  {
    "id": 2,
    "text": "《红楼梦》是中国古典长篇章回小说的集大成之作，也是封建末世社会生活的百科全书。",
    "start": 4.023,
    "end": 10.195,
    "duration": 6.172
  },
  {
    "id": 3,
    "text": "面对清代康乾盛世表象下的深刻危机，曹雪芹以自身家族败落的切身体验，",
    "start": 10.873,
    "end": 16.845,
    "duration": 5.972
  },
  {
    "id": 4,
    "text": "“披阅十载，增删五次”，打破传统小说才子佳人大团圆的陈旧套路，",
    "start": 17.224,
    "end": 22.797,
    "duration": 5.573
  },
  {
    "id": 5,
    "text": "将古典悲剧推向全新的思想与艺术高度。",
    "start": 23.176,
    "end": 26.508,
    "duration": 3.332
  },
  {
    "id": 6,
    "text": "鲁迅赞许其“自有《红楼梦》出来以后，传统的思想和写法都打破了”。",
    "start": 27.165,
    "end": 31.697,
    "duration": 4.532
  },
  {
    "id": 7,
    "text": "其悲剧意蕴与叙事成就，主要体现在以下四个方面：",
    "start": 32.335,
    "end": 42.147,
    "duration": 9.812
  },
  {
    "id": 8,
    "text": "第一，构筑三重交织的悲剧意蕴，揭示封建宗法制度衰亡的历史必然。",
    "start": 42.865,
    "end": 58.12,
    "duration": 15.255
  },
  {
    "id": 9,
    "text": "《红楼梦》的悲剧根植于不可调和的社会与历史矛盾，",
    "start": 58.815,
    "end": 59.387,
    "duration": 0.572
  },
  {
    "id": 10,
    "text": "包含三重层层递进的必然悲剧：其一是青年反叛者的爱情婚姻悲剧，",
    "start": 59.766,
    "end": 61.778,
    "duration": 2.012
  },
  {
    "id": 11,
    "text": "贾宝玉与林黛玉追求精神契合的“木石前盟”，被维护家族利益的“金玉良缘”所扼杀；",
    "start": 62.157,
    "end": 63.849,
    "duration": 1.692
  },
  {
    "id": 12,
    "text": "其二是大观园女性群体的命运悲剧，“千红一哭，万艳同悲”，",
    "start": 64.378,
    "end": 65.59,
    "duration": 1.212
  },
  {
    "id": 13,
    "text": "无论是高洁的晴雯、刚烈的鸳鸯还是柔顺的迎春，皆难逃被摧残的厄运；",
    "start": 65.969,
    "end": 68.021,
    "duration": 2.052
  },
  {
    "id": 14,
    "text": "其三是封建贵族家族衰败的社会历史悲剧，赫赫扬扬百载的贾府由盛转衰、走向崩塌，",
    "start": 68.55,
    "end": 68.722,
    "duration": 0.172
  },
  {
    "id": 15,
    "text": "终致“落了片白茫茫大地真干净”，揭示了封建末世美好价值必然毁灭的命运。",
    "start": 69.101,
    "end": 70.433,
    "duration": 1.332
  },
  {
    "id": 16,
    "text": "第二，确立多线并进的网状叙事结构，于日常细节中暗伏兴亡线索。",
    "start": 71.111,
    "end": 84.803,
    "duration": 13.692
  },
  {
    "id": 17,
    "text": "在叙事结构上，《红楼梦》摆脱了早期小说单线纵进与串珠式的简单格局，",
    "start": 85.481,
    "end": 88.293,
    "duration": 2.812
  },
  {
    "id": 18,
    "text": "创造了宏阔严密的网状全景结构。",
    "start": 88.672,
    "end": 91.204,
    "duration": 2.532
  },
  {
    "id": 19,
    "text": "作者将贾府家族盛衰与宝黛爱情发展两条主线紧密交织，",
    "start": 91.882,
    "end": 97.334,
    "duration": 5.452
  },
  {
    "id": 20,
    "text": "以大观园为中心展开错综复杂的人事网络，借元妃省亲、宝玉挨打、抄检大观园与黛死钗嫁等重大事件为枢纽，",
    "start": 97.713,
    "end": 108.706,
    "duration": 10.993
  },
  {
    "id": 21,
    "text": "推动情节由繁盛走向剧烈分化与衰败。",
    "start": 109.253,
    "end": 117.625,
    "duration": 8.372
  },
  {
    "id": 22,
    "text": "作者长于在饮酒作诗、家长里短的日常白描中暗伏生死兴亡线索，",
    "start": 118.154,
    "end": 123.646,
    "duration": 5.492
  },
  {
    "id": 23,
    "text": "使大小事件互为因果、连环勾牵，做到了草蛇灰线、伏脉千里。",
    "start": 124.025,
    "end": 129.277,
    "duration": 5.252
  },
  {
    "id": 24,
    "text": "第三，打破类型化人物塑造套路，刻画性格复杂多面的人物群像。",
    "start": 129.901,
    "end": 134.473,
    "duration": 4.572
  },
  {
    "id": 25,
    "text": "曹雪芹突破了传统小说忠奸善恶的脸谱定型，",
    "start": 135.111,
    "end": 138.803,
    "duration": 3.692
  },
  {
    "id": 26,
    "text": "以精微的心理刻画与多维生活视角，写出人物性格的复杂真实。",
    "start": 139.182,
    "end": 144.314,
    "duration": 5.132
  },
  {
    "id": 27,
    "text": "以王熙凤为例，她既是贪婪弄权、逼死尤二姐的狠辣管家，又是精明能干、谈笑风生、偶发善心周济刘姥姥的能人；",
    "start": 144.992,
    "end": 154.044,
    "duration": 9.052
  },
  {
    "id": 28,
    "text": "林黛玉既有敏感孤高、多愁善感的一面，更有才情横溢、自尊自爱的诗人本色。",
    "start": 154.722,
    "end": 160.574,
    "duration": 5.852
  },
  {
    "id": 29,
    "text": "人物性格鲜活丰富且合情合理，代表了古代长篇小说人物塑造的最高水准。",
    "start": 161.252,
    "end": 167.024,
    "duration": 5.772
  },
  {
    "id": 30,
    "text": "第四，运用虚实相生的预叙笔法，融合生活质感与命运苍凉感。",
    "start": 167.662,
    "end": 172.714,
    "duration": 5.052
  },
  {
    "id": 31,
    "text": "在叙事手法上，《红楼梦》巧妙结合神话构架与写实细节。",
    "start": 173.352,
    "end": 177.604,
    "duration": 4.252
  },
  {
    "id": 32,
    "text": "开篇以女娲补天遗石与通灵宝玉展开神话缘起，",
    "start": 178.282,
    "end": 182.414,
    "duration": 4.132
  },
  {
    "id": 33,
    "text": "前五回借太虚幻境十二钗判词、《好了歌》及《红楼梦》十二支曲暗示人物与家族命运；",
    "start": 182.793,
    "end": 185.405,
    "duration": 2.612
  },
  {
    "id": 34,
    "text": "在现实叙事中，又以元宵灯谜、中秋联诗与大观园四时景致变化作为伏笔，呼应悲剧结局。",
    "start": 185.934,
    "end": 189.786,
    "duration": 3.852
  },
  {
    "id": 35,
    "text": "这种“真事隐去，假语村言”的虚实相生写法，",
    "start": 190.464,
    "end": 192.956,
    "duration": 2.492
  },
  {
    "id": 36,
    "text": "使作品在细腻的写实描摹之上，笼罩着一层深沉的人生感慨。",
    "start": 193.335,
    "end": 198.147,
    "duration": 4.812
  },
  {
    "id": 37,
    "text": "总而言之，《红楼梦》代表了中国古代长篇章回小说与悲剧艺术的高峰。",
    "start": 198.865,
    "end": 207.157,
    "duration": 8.292
  },
  {
    "id": 38,
    "text": "曹雪芹突破了传统“大团圆”的心理定势，",
    "start": 207.835,
    "end": 208.527,
    "duration": 0.692
  },
  {
    "id": 39,
    "text": "以真切的生活质感、立体丰满的人物群像与网状交织的叙事结构，写尽了封建家族与世俗美梦无可挽回的幻灭。",
    "start": 208.906,
    "end": 213.078,
    "duration": 4.172
  },
  {
    "id": 40,
    "text": "王国维在《红楼梦评论》中赞叹其为“悲剧中之悲剧”，",
    "start": 213.796,
    "end": 222.488,
    "duration": 8.692
  },
  {
    "id": 41,
    "text": "鲁迅亦论定其“悲凉之雾，遍被华林，然呼吸而领会之者，独宝玉一人而已”。",
    "start": 222.999,
    "end": 236.973,
    "duration": 13.974
  },
  {
    "id": 42,
    "text": "这部巨著对封建制度危机与人生悲剧的深刻开掘，使其具备了跨越时空的永恒艺术魅力。",
    "start": 237.502,
    "end": 244.394,
    "duration": 6.892
  }
]