[
  {
    "id": "sent_1",
    "text": "《红楼梦》 是中国古典长篇章回小说艺术的终极集大成者，",
    "start": 0.0,
    "end": 4.44,
    "duration": 4.44
  },
  {
    "id": "sent_2",
    "text": "也是中国封建社会走向没落时期的伟大百科全书。",
    "start": 4.889,
    "end": 8.689,
    "duration": 3.8
  },
  {
    "id": "sent_3",
    "text": "面对清代康乾盛世表象下的深刻制度危机，",
    "start": 9.139,
    "end": 12.659,
    "duration": 3.52
  },
  {
    "id": "sent_4",
    "text": "曹雪芹以自身家族败落的人生阅历，“披阅十载，增删五次”，",
    "start": 13.109,
    "end": 18.109,
    "duration": 5.0
  },
  {
    "id": "sent_5",
    "text": "彻底打破了传统小说才子佳人大团圆的庸俗套路，",
    "start": 18.559,
    "end": 22.439,
    "duration": 3.88
  },
  {
    "id": "sent_6",
    "text": "第一次将悲剧推向了前所未有的思想高度。",
    "start": 22.889,
    "end": 26.209,
    "duration": 3.32
  },
  {
    "id": "sent_7",
    "text": "鲁迅在 《中国小说的历史的变迁》 中指出：“其悲剧之深，",
    "start": 26.659,
    "end": 30.659,
    "duration": 4.0
  },
  {
    "id": "sent_8",
    "text": "在此；",
    "start": 31.109,
    "end": 34.829,
    "duration": 3.72
  },
  {
    "id": "sent_9",
    "text": "其于中国小说之价值，亦在此。",
    "start": 35.279,
    "end": 40.119,
    "duration": 4.84
  },
  {
    "id": "sent_10",
    "text": "” 其悲剧意蕴与叙事艺术成就，主要展现为以下四个核心维度：",
    "start": 40.569,
    "end": 43.569,
    "duration": 3.0
  },
  {
    "id": "sent_11",
    "text": "第一，构筑多重交织的深刻悲剧意蕴，",
    "start": 44.019,
    "end": 47.299,
    "duration": 3.28
  },
  {
    "id": "sent_12",
    "text": "揭示封建宗法制度走向衰亡的必然命运。",
    "start": 47.749,
    "end": 50.269,
    "duration": 2.52
  },
  {
    "id": "sent_13",
    "text": "《红楼梦》 的悲剧绝非偶然的巧合，",
    "start": 50.719,
    "end": 55.079,
    "duration": 4.36
  },
  {
    "id": "sent_14",
    "text": "而是由不可调和的历史与社会矛盾构筑的多重必然悲剧。",
    "start": 55.529,
    "end": 58.169,
    "duration": 2.64
  },
  {
    "id": "sent_15",
    "text": "它包含了三个层层递进的悲剧维度：",
    "start": 58.619,
    "end": 61.619,
    "duration": 3.0
  },
  {
    "id": "sent_16",
    "text": "其一是青年反叛者的爱情婚姻悲剧，",
    "start": 62.069,
    "end": 65.549,
    "duration": 3.48
  },
  {
    "id": "sent_17",
    "text": "贾宝玉与林黛玉追求精神契合的 “木石前盟”，",
    "start": 65.999,
    "end": 70.559,
    "duration": 4.56
  },
  {
    "id": "sent_18",
    "text": "必然被封建正统宗法势力维护家族利益的 “金玉良缘” 所扼杀；",
    "start": 71.129,
    "end": 75.969,
    "duration": 4.84
  },
  {
    "id": "sent_19",
    "text": "其二是大观园女性群体的命运悲剧，“千红一哭，万艳同悲”，",
    "start": 76.419,
    "end": 80.259,
    "duration": 3.84
  },
  {
    "id": "sent_20",
    "text": "无论是高洁的晴雯、刚烈的鸳鸯还是柔顺的迎春，",
    "start": 80.709,
    "end": 82.469,
    "duration": 1.76
  },
  {
    "id": "sent_21",
    "text": "皆难逃被摧残的厄运；",
    "start": 82.919,
    "end": 86.799,
    "duration": 3.88
  },
  {
    "id": "sent_22",
    "text": "其三是封建贵族家族乃至制度的社会历史悲剧，",
    "start": 87.249,
    "end": 91.649,
    "duration": 4.4
  },
  {
    "id": "sent_23",
    "text": "赫赫扬扬百载的贾府由盛转衰、不可挽回地走向崩塌，",
    "start": 92.099,
    "end": 95.259,
    "duration": 3.16
  },
  {
    "id": "sent_24",
    "text": "最终落得 “落了片白茫茫大地真干净”。",
    "start": 95.709,
    "end": 100.189,
    "duration": 4.48
  },
  {
    "id": "sent_25",
    "text": "这种悲剧揭示出封建末世各种美好价值必然破灭的宿命。",
    "start": 100.639,
    "end": 104.239,
    "duration": 3.6
  },
  {
    "id": "sent_26",
    "text": "第二，确立多线并进的网络状网状叙事结构，",
    "start": 104.689,
    "end": 107.569,
    "duration": 2.88
  },
  {
    "id": "sent_27",
    "text": "在日常生活细节中寄寓兴亡深思。",
    "start": 108.019,
    "end": 109.339,
    "duration": 1.32
  },
  {
    "id": "sent_28",
    "text": "在叙事结构上，",
    "start": 109.789,
    "end": 115.309,
    "duration": 5.52
  },
  {
    "id": "sent_29",
    "text": "《红楼梦》 彻底摆脱了中国早期小说线性单轨与单线串珠的简单模式，",
    "start": 115.759,
    "end": 118.639,
    "duration": 2.88
  },
  {
    "id": "sent_30",
    "text": "创造了前所未有的网络状全景结构。",
    "start": 119.089,
    "end": 124.369,
    "duration": 5.28
  },
  {
    "id": "sent_31",
    "text": "作者将贾府的家族盛衰史与宝黛的爱情发展史两条主线紧密纠结；",
    "start": 124.819,
    "end": 129.779,
    "duration": 4.96
  },
  {
    "id": "sent_32",
    "text": "全书以大观园为中心，展开纵横交织的人事网，通过元妃省亲、",
    "start": 130.309,
    "end": 134.069,
    "duration": 3.76
  },
  {
    "id": "sent_33",
    "text": "刘姥姥进大观园、抄检大观园三次重大波澜，",
    "start": 134.519,
    "end": 137.959,
    "duration": 3.44
  },
  {
    "id": "sent_34",
    "text": "推动情节由极盛走向剧烈分化与彻底衰败。",
    "start": 138.409,
    "end": 143.489,
    "duration": 5.08
  },
  {
    "id": "sent_35",
    "text": "作者长于在琐屑平静的饮酒作诗、家长里短的日常生活白描中，",
    "start": 143.939,
    "end": 149.699,
    "duration": 5.76
  },
  {
    "id": "sent_36",
    "text": "暗伏生死兴亡的深刻线索，做到了草蛇灰线、伏脉千里的结构化境。",
    "start": 150.149,
    "end": 153.429,
    "duration": 3.28
  },
  {
    "id": "sent_37",
    "text": "第三，打破扁平化类型化的人物塑造套路，",
    "start": 153.879,
    "end": 157.039,
    "duration": 3.16
  },
  {
    "id": "sent_38",
    "text": "创造出性格复杂多面的“圆形人物”群像。",
    "start": 157.489,
    "end": 161.929,
    "duration": 4.44
  },
  {
    "id": "sent_39",
    "text": "曹雪芹在人物塑造上实现了中国小说美学的历史性飞跃。",
    "start": 162.379,
    "end": 165.979,
    "duration": 3.6
  },
  {
    "id": "sent_40",
    "text": "他不再将人物简单定型为脸谱化的忠奸善恶，",
    "start": 166.429,
    "end": 170.909,
    "duration": 4.48
  },
  {
    "id": "sent_41",
    "text": "而是以精微深刻的心理刻画与多维视角展现人物的复杂人性。",
    "start": 171.439,
    "end": 175.039,
    "duration": 3.6
  },
  {
    "id": "sent_42",
    "text": "以王熙凤为例，她既是贪婪弄权、杀伐决断、",
    "start": 175.569,
    "end": 179.809,
    "duration": 4.24
  },
  {
    "id": "sent_43",
    "text": "害死尤二姐的封建家族酷吏，又是精明能干、谈笑风生、",
    "start": 180.259,
    "end": 182.499,
    "duration": 2.24
  },
  {
    "id": "sent_44",
    "text": "偶发恻隐周济刘姥姥的能者；",
    "start": 182.949,
    "end": 187.629,
    "duration": 4.68
  },
  {
    "id": "sent_45",
    "text": "林黛玉不仅有多愁善感、任性孤高的一面，更有才情横溢、",
    "start": 188.079,
    "end": 189.959,
    "duration": 1.88
  },
  {
    "id": "sent_46",
    "text": "自尊自爱的诗人本色。",
    "start": 190.408,
    "end": 194.328,
    "duration": 3.92
  },
  {
    "id": "sent_47",
    "text": "小说人物性格前后发展、自相矛盾又合情合理，",
    "start": 194.778,
    "end": 196.898,
    "duration": 2.12
  },
  {
    "id": "sent_48",
    "text": "达到了极高的心理真实度。",
    "start": 197.348,
    "end": 200.668,
    "duration": 3.32
  },
  {
    "id": "sent_49",
    "text": "第四，运用虚实相生的谶纬预叙笔法，",
    "start": 201.118,
    "end": 204.318,
    "duration": 3.2
  },
  {
    "id": "sent_50",
    "text": "构筑宿命感与现实感高度统一的哲理空间。",
    "start": 204.768,
    "end": 209.768,
    "duration": 5.0
  },
  {
    "id": "sent_51",
    "text": "在叙事手法上，《红楼梦》 巧妙融合了神话构架与写实细节。",
    "start": 210.218,
    "end": 214.698,
    "duration": 4.48
  },
  {
    "id": "sent_52",
    "text": "开篇以女娲补天遗石与通灵宝玉展开神话预设，",
    "start": 215.148,
    "end": 219.668,
    "duration": 4.52
  },
  {
    "id": "sent_53",
    "text": "以太虚幻境中的十二钗判词与红楼梦曲预言人物命运；",
