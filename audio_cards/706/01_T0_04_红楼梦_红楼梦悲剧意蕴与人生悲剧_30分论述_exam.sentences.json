[
  {
    "id": 1,
    "text": "试论《红楼梦》的悲剧意蕴与叙事艺术成就。",
    "start": 0.12,
    "end": 3.7,
    "duration": 3.58
  },
  {
    "id": 2,
    "text": "《红楼梦》是中国古典长篇章回小说的集大成之作，也是封建末世社会生活的百科全书。",
    "start": 4.22,
    "end": 10.969,
    "duration": 6.749
  },
  {
    "id": 3,
    "text": "面对清代康乾盛世表象下的深刻危机，曹雪芹以自身家族败落的切身体验，",
    "start": 11.489,
    "end": 17.851,
    "duration": 6.362
  },
  {
    "id": 4,
    "text": "“披阅十载，增删五次”，打破传统小说才子佳人大团圆的陈旧套路，",
    "start": 18.234,
    "end": 23.867,
    "duration": 5.633
  },
  {
    "id": 5,
    "text": "将古典悲剧推向全新的思想与艺术高度。",
    "start": 24.237,
    "end": 27.464,
    "duration": 3.227
  },
  {
    "id": 6,
    "text": "鲁迅赞许其“自有《红楼梦》出来以后，传统的思想和写法都打破了”。",
    "start": 28.009,
    "end": 33.157,
    "duration": 5.148
  },
  {
    "id": 7,
    "text": "其悲剧意蕴与叙事成就，主要体现在以下四个方面：",
    "start": 33.677,
    "end": 37.541,
    "duration": 3.864
  },
  {
    "id": 8,
    "text": "第一，构筑三重交织的悲剧意蕴，揭示封建宗法制度衰亡的历史必然。",
    "start": 37.911,
    "end": 43.175,
    "duration": 5.264
  },
  {
    "id": 9,
    "text": "《红楼梦》的悲剧根植于不可调和的社会与历史矛盾，",
    "start": 43.695,
    "end": 47.587,
    "duration": 3.892
  },
  {
    "id": 10,
    "text": "包含三重层层递进的必然悲剧：其一是青年反叛者的爱情婚姻悲剧，",
    "start": 47.957,
    "end": 53.465,
    "duration": 5.508
  },
  {
    "id": 11,
    "text": "贾宝玉与林黛玉追求精神契合的“木石前盟”，被维护家族利益的“金玉良缘”所扼杀；",
    "start": 53.835,
    "end": 60.208,
    "duration": 6.373
  },
  {
    "id": 12,
    "text": "其二是大观园女性群体的命运悲剧，“千红一哭，万艳同悲”，",
    "start": 60.728,
    "end": 65.786,
    "duration": 5.058
  },
  {
    "id": 13,
    "text": "无论是高洁的晴雯、刚烈的鸳鸯还是柔顺的迎春，皆难逃被摧残的厄运；",
    "start": 66.156,
    "end": 72.353,
    "duration": 6.197
  },
  {
    "id": 14,
    "text": "其三是封建贵族家族衰败的社会历史悲剧，赫赫扬扬百载的贾府由盛转衰、走向崩塌，",
    "start": 72.873,
    "end": 80.612,
    "duration": 7.739
  },
  {
    "id": 15,
    "text": "终致“落了片白茫茫大地真干净”，揭示了封建末世美好价值必然毁灭的命运。",
    "start": 81.1,
    "end": 87.224,
    "duration": 6.124
  },
  {
    "id": 16,
    "text": "第二，确立多线并进的网状叙事结构，于日常细节中暗伏兴亡线索。",
    "start": 87.744,
    "end": 93.576,
    "duration": 5.832
  },
  {
    "id": 17,
    "text": "在叙事结构上，《红楼梦》摆脱了早期小说单线纵进与串珠式的简单格局，",
    "start": 94.118,
    "end": 99.814,
    "duration": 5.696
  },
  {
    "id": 18,
    "text": "创造了宏阔严密的网状全景结构。",
    "start": 100.195,
    "end": 103.019,
    "duration": 2.824
  },
  {
    "id": 19,
    "text": "作者将贾府家族盛衰与宝黛爱情发展两条主线紧密交织，",
    "start": 103.63,
    "end": 108.43,
    "duration": 4.8
  },
  {
    "id": 20,
    "text": "以大观园为中心展开错综复杂的人事网络，借元妃省亲、宝玉挨打、抄检大观园与黛死钗嫁等重大事件为枢纽，",
    "start": 108.8,
    "end": 118.407,
    "duration": 9.607
  },
  {
    "id": 21,
    "text": "推动情节由繁盛走向剧烈分化与衰败。",
    "start": 118.777,
    "end": 122.083,
    "duration": 3.306
  },
  {
    "id": 22,
    "text": "作者长于在饮酒作诗、家长里短的日常白描中暗伏生死兴亡线索，",
    "start": 122.603,
    "end": 128.138,
    "duration": 5.535
  },
  {
    "id": 23,
    "text": "使大小事件互为因果、连环勾牵，做到了草蛇灰线、伏脉千里。",
    "start": 128.508,
    "end": 133.693,
    "duration": 5.185
  },
  {
    "id": 24,
    "text": "第三，打破类型化人物塑造套路，刻画性格复杂多面的人物群像。",
    "start": 134.213,
    "end": 139.537,
    "duration": 5.324
  },
  {
    "id": 25,
    "text": "曹雪芹突破了传统小说忠奸善恶的脸谱定型，",
    "start": 140.057,
    "end": 143.544,
    "duration": 3.487
  },
  {
    "id": 26,
    "text": "以精微的心理刻画与多维生活视角，写出人物性格的复杂真实。",
    "start": 144.076,
    "end": 148.96,
    "duration": 4.884
  },
  {
    "id": 27,
    "text": "以王熙凤为例，她既是贪婪弄权、逼死尤二姐的狠辣管家，又是精明能干、谈笑风生、偶发善心周济刘姥姥的能人；",
    "start": 149.48,
    "end": 158.933,
    "duration": 9.453
  },
  {
    "id": 28,
    "text": "林黛玉既有敏感孤高、多愁善感的一面，更有才情横溢、自尊自爱的诗人本色。",
    "start": 159.453,
    "end": 166.102,
    "duration": 6.649
  },
  {
    "id": 29,
    "text": "人物性格鲜活丰富且合情合理，代表了古代长篇小说人物塑造的最高水准。",
    "start": 166.624,
    "end": 173.387,
    "duration": 6.763
  },
  {
    "id": 30,
    "text": "第四，运用虚实相生的预叙笔法，融合生活质感与命运苍凉感。",
    "start": 173.916,
    "end": 179.755,
    "duration": 5.839
  },
  {
    "id": 31,
    "text": "在叙事手法上，《红楼梦》巧妙结合神话构架与写实细节。",
    "start": 180.275,
    "end": 185.094,
    "duration": 4.819
  },
  {
    "id": 32,
    "text": "开篇以女娲补天遗石与通灵宝玉展开神话缘起，",
    "start": 185.614,
    "end": 189.909,
    "duration": 4.295
  },
  {
    "id": 33,
    "text": "前五回借太虚幻境十二钗判词、《好了歌》及《红楼梦》十二支曲暗示人物与家族命运；",
    "start": 190.486,
    "end": 197.181,
    "duration": 6.695
  },
  {
    "id": 34,
    "text": "在现实叙事中，又以元宵灯谜、中秋联诗与大观园四时景致变化作为伏笔，呼应悲剧结局。",
    "start": 197.701,
    "end": 205.06,
    "duration": 7.359
  },
  {
    "id": 35,
    "text": "这种“真事隐去，假语村言”的虚实相生写法，",
    "start": 205.58,
    "end": 209.195,
    "duration": 3.615
  },
  {
    "id": 36,
    "text": "使作品在细腻的写实描摹之上，笼罩着一层深沉的人生感慨。",
    "start": 209.565,
    "end": 214.611,
    "duration": 5.046
  },
  {
    "id": 37,
    "text": "总而言之，《红楼梦》代表了中国古代长篇章回小说与悲剧艺术的高峰。",
    "start": 215.131,
    "end": 220.522,
    "duration": 5.391
  },
  {
    "id": 38,
    "text": "曹雪芹突破了传统“大团圆”的心理定势，",
    "start": 221.042,
    "end": 224.081,
    "duration": 3.039
  },
  {
    "id": 39,
    "text": "以真切的生活质感、立体丰满的人物群像与网状交织的叙事结构，写尽了封建家族与世俗美梦无可挽回的幻灭。",
    "start": 224.451,
    "end": 234.196,
    "duration": 9.745
  },
  {
    "id": 40,
    "text": "王国维在《红楼梦评论》中赞叹其为“悲剧中之悲剧”，",
    "start": 234.716,
    "end": 238.787,
    "duration": 4.071
  },
  {
    "id": 41,
    "text": "鲁迅亦论定其“悲凉之雾，遍被华林，然呼吸而领会之者，独宝玉一人而已”。",
    "start": 239.157,
    "end": 246.053,
    "duration": 6.896
  },
  {
    "id": 42,
    "text": "这部巨著对封建制度危机与人生悲剧的深刻开掘，使其具备了跨越时空的永恒艺术魅力。",
    "start": 246.573,
    "end": 254.316,
    "duration": 7.743
  }
]