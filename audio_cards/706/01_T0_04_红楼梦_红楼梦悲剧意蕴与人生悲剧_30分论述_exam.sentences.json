[
  {
    "id": 1,
    "text": "试论《红楼梦》的悲剧意蕴与叙事艺术成就。",
    "start": 0.1,
    "end": 3.74,
    "duration": 3.64
  },
  {
    "id": 2,
    "text": "《红楼梦》 是中国古典长篇章回小说艺术的终极集大成者，",
    "start": 4.06,
    "end": 8.61,
    "duration": 4.55
  },
  {
    "id": 3,
    "text": "也是中国封建社会走向没落时期的伟大百科全书。",
    "start": 8.74,
    "end": 12.73,
    "duration": 3.99
  },
  {
    "id": 4,
    "text": "面对清代康乾盛世表象下的深刻制度危机，",
    "start": 12.79,
    "end": 16.28,
    "duration": 3.49
  },
  {
    "id": 5,
    "text": "曹雪芹以自身家族败落的人生阅历，“披阅十载，增删五次”，",
    "start": 16.4,
    "end": 21.69,
    "duration": 5.29
  },
  {
    "id": 6,
    "text": "彻底打破了传统小说才子佳人大团圆的庸俗套路，",
    "start": 21.87,
    "end": 25.96,
    "duration": 4.09
  },
  {
    "id": 7,
    "text": "第一次将悲剧推向了前所未有的思想高度。",
    "start": 26.04,
    "end": 29.3,
    "duration": 3.26
  },
  {
    "id": 8,
    "text": "鲁迅在 《中国小说的历史的变迁》 中指出：“其悲剧之深，",
    "start": 29.54,
    "end": 33.875,
    "duration": 4.335
  },
  {
    "id": 9,
    "text": "在此；其于中国小说之价值，亦在此。",
    "start": 33.875,
    "end": 37.21,
    "duration": 3.335
  },
  {
    "id": 10,
    "text": "” 其悲剧意蕴与叙事艺术成就，主要展现为以下四个核心维度：",
    "start": 37.65,
    "end": 42.69,
    "duration": 5.04
  },
  {
    "id": 11,
    "text": "第一，构筑多重交织的深刻悲剧意蕴，",
    "start": 43.19,
    "end": 46.12,
    "duration": 2.93
  },
  {
    "id": 12,
    "text": "揭示封建宗法制度走向衰亡的必然命运。",
    "start": 46.48,
    "end": 49.53,
    "duration": 3.05
  },
  {
    "id": 13,
    "text": "《红楼梦》 的悲剧绝非偶然的巧合，",
    "start": 49.72,
    "end": 52.04,
    "duration": 2.32
  },
  {
    "id": 14,
    "text": "而是由不可调和的历史与社会矛盾构筑的多重必然悲剧。",
    "start": 52.32,
    "end": 56.49,
    "duration": 4.17
  },
  {
    "id": 15,
    "text": "它包含了三个层层递进的悲剧维度：",
    "start": 56.84,
    "end": 59.22,
    "duration": 2.38
  },
  {
    "id": 16,
    "text": "其一是青年反叛者的爱情婚姻悲剧，",
    "start": 59.54,
    "end": 62.24,
    "duration": 2.7
  },
  {
    "id": 17,
    "text": "贾宝玉与林黛玉追求精神契合的 “木石前盟”，",
    "start": 62.55,
    "end": 65.87,
    "duration": 3.32
  },
  {
    "id": 18,
    "text": "必然被封建正统宗法势力维护家族利益的 “金玉良缘” 所扼杀；",
    "start": 66.06,
    "end": 70.65,
    "duration": 4.59
  },
  {
    "id": 19,
    "text": "其二是大观园女性群体的命运悲剧，“千红一哭，万艳同悲”，",
    "start": 70.83,
    "end": 75.53,
    "duration": 4.7
  },
  {
    "id": 20,
    "text": "无论是高洁的晴雯、刚烈的鸳鸯还是柔顺的迎春，",
    "start": 75.77,
    "end": 79.49,
    "duration": 3.72
  },
  {
    "id": 21,
    "text": "皆难逃被摧残的厄运；",
    "start": 79.78,
    "end": 81.41,
    "duration": 1.63
  },
  {
    "id": 22,
    "text": "其三是封建贵族家族乃至制度的社会历史悲剧，",
    "start": 81.61,
    "end": 85.52,
    "duration": 3.91
  },
  {
    "id": 23,
    "text": "赫赫扬扬百载的贾府由盛转衰、不可挽回地走向崩塌，",
    "start": 85.79,
    "end": 90.51,
    "duration": 4.72
  },
  {
    "id": 24,
    "text": "最终落得 “落了片白茫茫大地真干净”。",
    "start": 90.61,
    "end": 93.64,
    "duration": 3.03
  },
  {
    "id": 25,
    "text": "这种悲剧揭示出封建末世各种美好价值必然破灭的宿命。",
    "start": 93.87,
    "end": 98.31,
    "duration": 4.44
  },
  {
    "id": 26,
    "text": "第二，确立多线并进的网络状网状叙事结构，",
    "start": 98.77,
    "end": 102.55,
    "duration": 3.78
  },
  {
    "id": 27,
    "text": "在日常生活细节中寄寓兴亡深思。",
    "start": 103.02,
    "end": 105.6,
    "duration": 2.58
  },
  {
    "id": 28,
    "text": "在叙事结构上，",
    "start": 106.07,
    "end": 107.1,
    "duration": 1.03
  },
  {
    "id": 29,
    "text": "《红楼梦》 彻底摆脱了中国早期小说线性单轨与单线串珠的简单模式，",
    "start": 107.41,
    "end": 112.72,
    "duration": 5.31
  },
  {
    "id": 30,
    "text": "创造了前所未有的网络状全景结构。",
    "start": 113.12,
    "end": 115.77,
    "duration": 2.65
  },
  {
    "id": 31,
    "text": "作者将贾府的家族盛衰史与宝黛的爱情发展史两条主线紧密纠结；",
    "start": 115.96,
    "end": 121.64,
    "duration": 5.68
  },
  {
    "id": 32,
    "text": "全书以大观园为中心，展开纵横交织的人事网，通过元妃省亲、",
    "start": 121.94,
    "end": 126.91,
    "duration": 4.97
  },
  {
    "id": 33,
    "text": "刘姥姥进大观园、抄检大观园三次重大波澜，",
    "start": 127.06,
    "end": 130.78,
    "duration": 3.72
  },
  {
    "id": 34,
    "text": "推动情节由极盛走向剧烈分化与彻底衰败。",
    "start": 131.02,
    "end": 134.96,
    "duration": 3.94
  },
  {
    "id": 35,
    "text": "作者长于在琐屑平静的饮酒作诗、家长里短的日常生活白描中，",
    "start": 135.2,
    "end": 140.54,
    "duration": 5.34
  },
  {
    "id": 36,
    "text": "暗伏生死兴亡的深刻线索，做到了草蛇灰线、",
    "start": 140.78,
    "end": 144.69,
    "duration": 3.91
  },
  {
    "id": 37,
    "text": "伏脉千里的结构化境。",
    "start": 144.99,
    "end": 146.53,
    "duration": 1.54
  },
  {
    "id": 38,
    "text": "第三，打破扁平化类型化的人物塑造套路，",
    "start": 146.8,
    "end": 150.03,
    "duration": 3.23
  },
  {
    "id": 39,
    "text": "创造出性格复杂多面的“圆形人物”群像。",
    "start": 150.28,
    "end": 153.31,
    "duration": 3.03
  },
  {
    "id": 40,
    "text": "曹雪芹在人物塑造上实现了中国小说美学的历史性飞跃。",
    "start": 153.61,
    "end": 157.72,
    "duration": 4.11
  },
  {
    "id": 41,
    "text": "他不再将人物简单定型为脸谱化的忠奸善恶，",
    "start": 157.91,
    "end": 161.45,
    "duration": 3.54
  },
  {
    "id": 42,
    "text": "而是以精微深刻的心理刻画与多维视角展现人物的复杂人性。",
    "start": 161.76,
    "end": 166.47,
    "duration": 4.71
  },
  {
    "id": 43,
    "text": "以王熙凤为例，她既是贪婪弄权、杀伐决断、",
    "start": 166.72,
    "end": 170.62,
    "duration": 3.9
  },
  {
    "id": 44,
    "text": "害死尤二姐的封建家族酷吏，又是精明能干、谈笑风生、",
    "start": 170.83,
    "end": 175.51,
    "duration": 4.68
  },
  {
    "id": 45,
    "text": "偶发恻隐周济刘姥姥的能者；林黛玉不仅有多愁善感、",
    "start": 175.71,
    "end": 180.08,
    "duration": 4.37
  },
  {
    "id": 46,
    "text": "任性孤高的一面，更有才情横溢、自尊自爱的诗人本色。",
    "start": 180.25,
    "end": 184.81,
    "duration": 4.56
  },
  {
    "id": 47,
    "text": "小说人物性格前后发展、自相矛盾又合情合理，",
    "start": 185.24,
    "end": 189.26,
    "duration": 4.02
  },
  {
    "id": 48,
    "text": "达到了极高的心理真实度。",
    "start": 189.53,
    "end": 191.43,
    "duration": 1.9
  },
  {
    "id": 49,
    "text": "第四，运用虚实相生的谶纬预叙笔法，",
    "start": 191.68,
    "end": 194.99,
    "duration": 3.31
  },
  {
    "id": 50,
    "text": "构筑宿命感与现实感高度统一的哲理空间。",
    "start": 195.23,
    "end": 198.78,
    "duration": 3.55
  },
  {
    "id": 51,
    "text": "在叙事手法上，《红楼梦》 巧妙融合了神话构架与写实细节。",
    "start": 199.11,
    "end": 203.68,
    "duration": 4.57
  },
  {
    "id": 52,
    "text": "开篇以女娲补天遗石与通灵宝玉展开神话预设，",
    "start": 203.84,
    "end": 208.05,
    "duration": 4.21
  },
  {
    "id": 53,
    "text": "以太虚幻境中的十二钗判词与红楼梦曲预言人物命运；",
    "start": 208.42,
    "end": 213.05,
    "duration": 4.63
  },
  {
    "id": 54,
    "text": "在现实叙事中，又借元宵灯谜、中秋联诗、",
    "start": 213.28,
    "end": 216.85,
    "duration": 3.57
  },
  {
    "id": 55,
    "text": "芙蓉女儿诔等日常细节作为谶语，提前透露悲剧结局。",
    "start": 217.24,
    "end": 221.43,
    "duration": 4.19
  },
  {
    "id": 56,
    "text": "这种“真事隐去，假语村言”的虚实结合，",
    "start": 221.53,
    "end": 224.54,
    "duration": 3.01
  },
  {
    "id": 57,
    "text": "使整部作品在极具生活质感的现实主义描摹之上，",
    "start": 224.75,
    "end": 228.24,
    "duration": 3.49
  },
  {
    "id": 58,
    "text": "笼罩着一层俯瞰人世苍凉的深邃哲学沉思。",
    "start": 228.49,
    "end": 231.72,
    "duration": 3.23
  },
  {
    "id": 59,
    "text": "综上所述，",
    "start": 232.12,
    "end": 232.95,
    "duration": 0.83
  },
  {
    "id": 60,
    "text": "《红楼梦》的悲剧成就不仅代表了中国古代长篇章回体小说的巅峰，",
    "start": 233.66,
    "end": 238.76,
    "duration": 5.1
  },
  {
    "id": 61,
    "text": "更标志着中国古典悲剧美学的最高范式。",
    "start": 239.45,
    "end": 242.8,
    "duration": 3.35
  },
  {
    "id": 62,
    "text": "曹雪芹突破了中国传统‘大团圆’的大众心理定势，",
    "start": 243.5,
    "end": 247.09,
    "duration": 3.59
  },
  {
    "id": 63,
    "text": "以高度的现实批判精神、",
    "start": 247.73,
    "end": 249.6,
    "duration": 1.87
  },
  {
    "id": 64,
    "text": "立体丰满的‘圆形人物’塑造和网状多线交织的宏大史诗结构，",
    "start": 250.33,
    "end": 255.05,
    "duration": 4.72
  },
  {
    "id": 65,
    "text": "深刻揭示了封建家族乃至整个封建文明无可挽回走向崩塌的历史必然。",
    "start": 255.77,
    "end": 261.86,
    "duration": 6.09
  },
  {
    "id": 66,
    "text": "王国维在《红楼梦评论》中赞叹其为‘悲剧中之悲剧’，",
    "start": 262.75,
    "end": 266.62,
    "duration": 3.87
  },
  {
    "id": 67,
    "text": "鲁迅亦论定其‘悲凉之雾，遍被华林，然呼吸而领会之者，",
    "start": 267.3,
    "end": 272.22,
    "duration": 4.92
  },
  {
    "id": 68,
    "text": "独宝玉一人而已’。",
    "start": 273.03,
    "end": 274.27,
    "duration": 1.24
  },
  {
    "id": 69,
    "text": "《红楼梦》对人生存在困境、",
    "start": 275.08,
    "end": 276.91,
    "duration": 1.83
  },
  {
    "id": 70,
    "text": "人性多维复杂性与生命虚无感所展开的终极哲思，",
    "start": 277.76,
    "end": 281.83,
    "duration": 4.07
  },
  {
    "id": 71,
    "text": "使其超越了具体的历史时空，具备了与西方莎士比亚、",
    "start": 282.75,
    "end": 286.78,
    "duration": 4.03
  },
  {
    "id": 72,
    "text": "陀思妥耶夫斯基等巨著相媲美的世界文学高度，",
    "start": 287.51,
    "end": 291.03,
    "duration": 3.52
  },
  {
    "id": 73,
    "text": "在中国文学史上矗立起一座不可逾越的美学丰碑。",
    "start": 291.77,
    "end": 295.95,
    "duration": 4.18
  }
]
