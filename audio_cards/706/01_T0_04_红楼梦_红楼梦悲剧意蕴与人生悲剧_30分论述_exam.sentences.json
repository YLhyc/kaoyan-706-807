[
  {
    "id": "sent_1",
    "text": "《红楼梦》 是中国古典长篇章回小说艺术的终极集大成者，",
    "start": 0.1,
    "end": 5.623,
    "duration": 5.523
  },
  {
    "id": "sent_2",
    "text": "也是中国封建社会走向没落时期的伟大百科全书。",
    "start": 5.573,
    "end": 10.091,
    "duration": 4.518
  },
  {
    "id": "sent_3",
    "text": "面对清代康乾盛世表象下的深刻制度危机，",
    "start": 10.091,
    "end": 14.245,
    "duration": 4.154
  },
  {
    "id": "sent_4",
    "text": "曹雪芹以自身家族败落的人生阅历，“披阅十载，增删五次”，",
    "start": 14.245,
    "end": 19.896,
    "duration": 5.651
  },
  {
    "id": "sent_5",
    "text": "彻底打破了传统小说才子佳人大团圆的庸俗套路，",
    "start": 19.896,
    "end": 24.479,
    "duration": 4.583
  },
  {
    "id": "sent_6",
    "text": "第一次将悲剧推向了前所未有的思想高度。",
    "start": 24.479,
    "end": 28.476,
    "duration": 3.997
  },
  {
    "id": "sent_7",
    "text": "鲁迅在 《中国小说的历史的变迁》 中指出：“其悲剧之深，在此；",
    "start": 28.477,
    "end": 34.024,
    "duration": 5.547
  },
  {
    "id": "sent_8",
    "text": "其于中国小说之价值，亦在此。",
    "start": 34.023,
    "end": 37.174,
    "duration": 3.151
  },
  {
    "id": "sent_9",
    "text": "” 其悲剧意蕴与叙事艺术成就，主要展现为以下四个核心维度：",
    "start": 37.174,
    "end": 43.229,
    "duration": 6.055
  },
  {
    "id": "sent_10",
    "text": "第一，构筑多重交织的深刻悲剧意蕴，",
    "start": 43.229,
    "end": 47.148,
    "duration": 3.919
  },
  {
    "id": "sent_11",
    "text": "揭示封建宗法制度走向衰亡的必然命运。",
    "start": 47.148,
    "end": 51.21,
    "duration": 4.062
  },
  {
    "id": "sent_12",
    "text": "《红楼梦》 的悲剧绝非偶然的巧合，",
    "start": 51.211,
    "end": 54.375,
    "duration": 3.164
  },
  {
    "id": "sent_13",
    "text": "而是由不可调和的历史与社会矛盾构筑的多重必然悲剧。",
    "start": 54.375,
    "end": 59.596,
    "duration": 5.221
  },
  {
    "id": "sent_14",
    "text": "它包含了三个层层递进的悲剧维度：其一是青年反叛者的爱情婚姻悲剧，",
    "start": 59.596,
    "end": 65.873,
    "duration": 6.277
  },
  {
    "id": "sent_15",
    "text": "贾宝玉与林黛玉追求精神契合的 “木石前盟”，",
    "start": 65.872,
    "end": 70.104,
    "duration": 4.232
  },
  {
    "id": "sent_16",
    "text": "必然被封建正统宗法势力维护家族利益的 “金玉良缘” 所扼杀；",
    "start": 70.104,
    "end": 75.833,
    "duration": 5.729
  },
  {
    "id": "sent_17",
    "text": "其二是大观园女性群体的命运悲剧，“千红一哭，万艳同悲”，",
    "start": 75.833,
    "end": 81.419,
    "duration": 5.586
  },
  {
    "id": "sent_18",
    "text": "无论是高洁的晴雯、刚烈的鸳鸯还是柔顺的迎春，皆难逃被摧残的厄运；",
    "start": 81.419,
    "end": 87.982,
    "duration": 6.563
  },
  {
    "id": "sent_19",
    "text": "其三是封建贵族家族乃至制度的社会历史悲剧，",
    "start": 87.982,
    "end": 92.591,
    "duration": 4.609
  },
  {
    "id": "sent_20",
    "text": "赫赫扬扬百载的贾府由盛转衰、不可挽回地走向崩塌，",
    "start": 92.591,
    "end": 97.786,
    "duration": 5.195
  },
  {
    "id": "sent_21",
    "text": "最终落得 “落了片白茫茫大地真干净”。",
    "start": 97.786,
    "end": 101.562,
    "duration": 3.776
  },
  {
    "id": "sent_22",
    "text": "这种悲剧揭示出封建末世各种美好价值必然破灭的宿命。",
    "start": 101.563,
    "end": 107.188,
    "duration": 5.625
  },
  {
    "id": "sent_23",
    "text": "第二，确立多线并进的网络状网状叙事结构，",
    "start": 107.188,
    "end": 111.381,
    "duration": 4.193
  },
  {
    "id": "sent_24",
    "text": "在日常生活细节中寄寓兴亡深思。",
    "start": 111.38,
    "end": 114.909,
    "duration": 3.529
  },
  {
    "id": "sent_25",
    "text": "在叙事结构上，",
    "start": 114.909,
    "end": 116.732,
    "duration": 1.823
  },
  {
    "id": "sent_26",
    "text": "《红楼梦》 彻底摆脱了中国早期小说线性单轨与单线串珠的简单模式，",
    "start": 116.732,
    "end": 123.034,
    "duration": 6.302
  },
  {
    "id": "sent_27",
    "text": "创造了前所未有的网络状全景结构。",
    "start": 123.034,
    "end": 126.602,
    "duration": 3.568
  },
  {
    "id": "sent_28",
    "text": "作者将贾府的家族盛衰史与宝黛的爱情发展史两条主线紧密纠结；",
    "start": 126.602,
    "end": 132.969,
    "duration": 6.367
  },
  {
    "id": "sent_29",
    "text": "全书以大观园为中心，展开纵横交织的人事网，",
    "start": 132.969,
    "end": 137.617,
    "duration": 4.648
  },
  {
    "id": "sent_30",
    "text": "通过元妃省亲、刘姥姥进大观园、抄检大观园三次重大波澜，",
    "start": 137.617,
    "end": 144.01,
    "duration": 6.393
  },
  {
    "id": "sent_31",
    "text": "推动情节由极盛走向剧烈分化与彻底衰败。",
    "start": 144.01,
    "end": 148.477,
    "duration": 4.467
  },
  {
    "id": "sent_32",
    "text": "作者长于在琐屑平静的饮酒作诗、家长里短的日常生活白描中，",
    "start": 148.477,
    "end": 154.388,
    "duration": 5.911
  },
  {
    "id": "sent_33",
    "text": "暗伏生死兴亡的深刻线索，做到了草蛇灰线、伏脉千里的结构化境。",
    "start": 154.388,
    "end": 160.859,
    "duration": 6.471
  },
  {
    "id": "sent_34",
    "text": "第三，打破扁平化类型化的人物塑造套路，",
    "start": 160.859,
    "end": 164.7,
    "duration": 3.841
  },
  {
    "id": "sent_35",
    "text": "创造出性格复杂多面的“圆形人物”群像。",
    "start": 164.701,
    "end": 168.36,
    "duration": 3.659
  },
  {
    "id": "sent_36",
    "text": "曹雪芹在人物塑造上实现了中国小说美学的历史性飞跃。",
    "start": 168.359,
    "end": 173.489,
    "duration": 5.13
  },
  {
    "id": "sent_37",
    "text": "他不再将人物简单定型为脸谱化的忠奸善恶，",
    "start": 173.49,
    "end": 177.709,
    "duration": 4.219
  },
  {
    "id": "sent_38",
    "text": "而是以精微深刻的心理刻画与多维视角展现人物的复杂人性。",
    "start": 177.708,
    "end": 183.45,
    "duration": 5.742
  },
  {
    "id": "sent_39",
    "text": "以王熙凤为例，",
    "start": 183.45,
    "end": 185.378,
    "duration": 1.928
  },
  {
    "id": "sent_40",
    "text": "她既是贪婪弄权、杀伐决断、害死尤二姐的封建家族酷吏，",
    "start": 185.378,
    "end": 191.029,
    "duration": 5.651
  },
  {
    "id": "sent_41",
    "text": "又是精明能干、谈笑风生、偶发恻隐周济刘姥姥的能者；",
    "start": 191.029,
    "end": 196.342,
    "duration": 5.313
  },
  {
    "id": "sent_42",
    "text": "林黛玉不仅有多愁善感、任性孤高的一面，",
    "start": 196.341,
    "end": 200.469,
    "duration": 4.128
  },
  {
    "id": "sent_43",
    "text": "更有才情横溢、自尊自爱的诗人本色。",
    "start": 200.469,
    "end": 204.466,
    "duration": 3.997
  },
  {
    "id": "sent_44",
    "text": "小说人物性格前后发展、自相矛盾又合情合理，",
    "start": 204.466,
    "end": 209.284,
    "duration": 4.818
  },
  {
    "id": "sent_45",
    "text": "达到了极高的心理真实度。",
    "start": 209.284,
    "end": 211.927,
    "duration": 2.643
  },
  {
    "id": "sent_46",
    "text": "第四，运用虚实相生的谶纬预叙笔法，",
    "start": 211.927,
    "end": 215.885,
    "duration": 3.958
  },
  {
    "id": "sent_47",
    "text": "构筑宿命感与现实感高度统一的哲理空间。",
    "start": 215.885,
    "end": 220.221,
    "duration": 4.336
  },
  {
    "id": "sent_48",
    "text": "在叙事手法上，《红楼梦》 巧妙融合了神话构架与写实细节。",
    "start": 220.221,
    "end": 225.95,
    "duration": 5.729
  },
  {
    "id": "sent_49",
    "text": "开篇以女娲补天遗石与通灵宝玉展开神话预设，",
    "start": 225.951,
    "end": 230.678,
    "duration": 4.727
  },
  {
    "id": "sent_50",
    "text": "以太虚幻境中的十二钗判词与红楼梦曲预言人物命运；",
    "start": 230.677,
    "end": 235.898,
    "duration": 5.221
  },
  {
    "id": "sent_51",
    "text": "在现实叙事中，",
    "start": 235.898,
    "end": 237.8,
    "duration": 1.902
  },
  {
    "id": "sent_52",
    "text": "又借元宵灯谜、中秋联诗、芙蓉女儿诔等日常细节作为谶语，",
    "start": 237.799,
    "end": 243.71,
    "duration": 5.911
  },
  {
    "id": "sent_53",
    "text": "提前透露悲剧结局。",
    "start": 243.711,
    "end": 246.042,
    "duration": 2.331
  },
  {
    "id": "sent_54",
    "text": "这种“真事隐去，假语村言”的虚实结合，",
    "start": 246.042,
    "end": 249.974,
    "duration": 3.932
  },
  {
    "id": "sent_55",
    "text": "使整部作品在极具生活质感的现实主义描摹之上，",
    "start": 249.974,
    "end": 254.896,
    "duration": 4.922
  },
  {
    "id": "sent_56",
    "text": "笼罩着一层俯瞰人世苍凉的深邃哲学沉思。",
    "start": 254.896,
    "end": 259.297,
    "duration": 4.401
  }
]