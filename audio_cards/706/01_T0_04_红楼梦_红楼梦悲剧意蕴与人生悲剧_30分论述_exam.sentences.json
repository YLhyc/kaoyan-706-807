[
  {
    "id": 1,
    "text": "试论《红楼梦》的悲剧意蕴与叙事艺术成就。",
    "start": 0.16,
    "end": 4.16,
    "duration": 4.0
  },
  {
    "id": 2,
    "text": "《红楼梦》 是中国古典长篇章回小说艺术的终极集大成者，",
    "start": 4.16,
    "end": 9.36,
    "duration": 5.2
  },
  {
    "id": 3,
    "text": "也是中国封建社会走向没落时期的伟大百科全书。",
    "start": 9.36,
    "end": 13.68,
    "duration": 4.32
  },
  {
    "id": 4,
    "text": "面对清代康乾盛世表象下的深刻制度危机，",
    "start": 13.68,
    "end": 17.76,
    "duration": 4.08
  },
  {
    "id": 5,
    "text": "曹雪芹以自身家族败落的人生阅历，“披阅十载，增删五次”，",
    "start": 17.76,
    "end": 24.08,
    "duration": 6.32
  },
  {
    "id": 6,
    "text": "彻底打破了传统小说才子佳人大团圆的庸俗套路，",
    "start": 24.08,
    "end": 28.24,
    "duration": 4.16
  },
  {
    "id": 7,
    "text": "第一次将悲剧推向了前所未有的思想高度。",
    "start": 28.24,
    "end": 31.76,
    "duration": 3.52
  },
  {
    "id": 8,
    "text": "鲁迅在 《中国小说的历史的变迁》 中指出：“其悲剧之深，",
    "start": 31.76,
    "end": 38.32,
    "duration": 6.56
  },
  {
    "id": 9,
    "text": "在此；其于中国小说之价值，亦在此。",
    "start": 38.32,
    "end": 41.92,
    "duration": 3.6
  },
  {
    "id": 10,
    "text": "” 其悲剧意蕴与叙事艺术成就，主要展现为以下四个核心维度：",
    "start": 41.92,
    "end": 48.08,
    "duration": 6.16
  },
  {
    "id": 11,
    "text": "第一，构筑多重交织的深刻悲剧意蕴，",
    "start": 48.08,
    "end": 51.328,
    "duration": 3.248
  },
  {
    "id": 12,
    "text": "揭示封建宗法制度走向衰亡的必然命运。",
    "start": 51.328,
    "end": 54.784,
    "duration": 3.456
  },
  {
    "id": 13,
    "text": "《红楼梦》 的悲剧绝非偶然的巧合，",
    "start": 54.784,
    "end": 57.856,
    "duration": 3.072
  },
  {
    "id": 14,
    "text": "而是由不可调和的历史与社会矛盾构筑的多重必然悲剧。",
    "start": 57.856,
    "end": 62.656,
    "duration": 4.8
  },
  {
    "id": 15,
    "text": "它包含了三个层层递进的悲剧维度：",
    "start": 62.656,
    "end": 65.728,
    "duration": 3.072
  },
  {
    "id": 16,
    "text": "其一是青年反叛者的爱情婚姻悲剧，",
    "start": 65.728,
    "end": 68.8,
    "duration": 3.072
  },
  {
    "id": 17,
    "text": "贾宝玉与林黛玉追求精神契合的 “木石前盟”，",
    "start": 68.8,
    "end": 72.72,
    "duration": 3.92
  },
  {
    "id": 18,
    "text": "必然被封建正统宗法势力维护家族利益的 “金玉良缘” 所扼杀；",
    "start": 72.72,
    "end": 78.72,
    "duration": 6.0
  },
  {
    "id": 19,
    "text": "其二是大观园女性群体的命运悲剧，“千红一哭，万艳同悲”，",
    "start": 78.72,
    "end": 84.64,
    "duration": 5.92
  },
  {
    "id": 20,
    "text": "无论是高洁的晴雯、刚烈的鸳鸯还是柔顺的迎春，",
    "start": 84.64,
    "end": 89.36,
    "duration": 4.72
  },
  {
    "id": 21,
    "text": "皆难逃被摧残的厄运；",
    "start": 89.36,
    "end": 91.6,
    "duration": 2.24
  },
  {
    "id": 22,
    "text": "其三是封建贵族家族乃至制度的社会历史悲剧，",
    "start": 91.6,
    "end": 95.92,
    "duration": 4.32
  },
  {
    "id": 23,
    "text": "赫赫扬扬百载的贾府由盛转衰、不可挽回地走向崩塌，",
    "start": 96.0,
    "end": 101.04,
    "duration": 5.04
  },
  {
    "id": 24,
    "text": "最终落得 “落了片白茫茫大地真干净”。",
    "start": 101.04,
    "end": 104.96,
    "duration": 3.92
  },
  {
    "id": 25,
    "text": "这种悲剧揭示出封建末世各种美好价值必然破灭的宿命。",
    "start": 104.96,
    "end": 110.24,
    "duration": 5.28
  },
  {
    "id": 26,
    "text": "第二，确立多线并进的网络状网状叙事结构，",
    "start": 110.24,
    "end": 114.4,
    "duration": 4.16
  },
  {
    "id": 27,
    "text": "在日常生活细节中寄寓兴亡深思。",
    "start": 114.4,
    "end": 117.36,
    "duration": 2.96
  },
  {
    "id": 28,
    "text": "在叙事结构上，",
    "start": 117.36,
    "end": 118.88,
    "duration": 1.52
  },
  {
    "id": 29,
    "text": "《红楼梦》 彻底摆脱了中国早期小说线性单轨与单线串珠的简单模式，",
    "start": 118.88,
    "end": 125.28,
    "duration": 6.4
  },
  {
    "id": 30,
    "text": "创造了前所未有的网络状全景结构。",
    "start": 125.28,
    "end": 129.04,
    "duration": 3.76
  },
  {
    "id": 31,
    "text": "作者将贾府的家族盛衰史与宝黛的爱情发展史两条主线紧密纠结；",
    "start": 129.04,
    "end": 135.28,
    "duration": 6.24
  },
  {
    "id": 32,
    "text": "全书以大观园为中心，展开纵横交织的人事网，通过元妃省亲、",
    "start": 135.28,
    "end": 141.44,
    "duration": 6.16
  },
  {
    "id": 33,
    "text": "刘姥姥进大观园、抄检大观园三次重大波澜，",
    "start": 141.44,
    "end": 145.76,
    "duration": 4.32
  },
  {
    "id": 34,
    "text": "推动情节由极盛走向剧烈分化与彻底衰败。",
    "start": 145.76,
    "end": 149.568,
    "duration": 3.808
  },
  {
    "id": 35,
    "text": "作者长于在琐屑平静的饮酒作诗、家长里短的日常生活白描中，",
    "start": 149.568,
    "end": 155.488,
    "duration": 5.92
  },
  {
    "id": 36,
    "text": "暗伏生死兴亡的深刻线索，做到了草蛇灰线、",
    "start": 155.488,
    "end": 158.768,
    "duration": 3.28
  },
  {
    "id": 37,
    "text": "伏脉千里的结构化境。",
    "start": 158.768,
    "end": 160.848,
    "duration": 2.08
  },
  {
    "id": 38,
    "text": "第三，打破扁平化类型化的人物塑造套路，",
    "start": 160.848,
    "end": 164.688,
    "duration": 3.84
  },
  {
    "id": 39,
    "text": "创造出性格复杂多面的“圆形人物”群像。",
    "start": 164.688,
    "end": 168.448,
    "duration": 3.76
  },
  {
    "id": 40,
    "text": "曹雪芹在人物塑造上实现了中国小说美学的历史性飞跃。",
    "start": 168.448,
    "end": 174.048,
    "duration": 5.6
  },
  {
    "id": 41,
    "text": "他不再将人物简单定型为脸谱化的忠奸善恶，",
    "start": 174.048,
    "end": 178.368,
    "duration": 4.32
  },
  {
    "id": 42,
    "text": "而是以精微深刻的心理刻画与多维视角展现人物的复杂人性。",
    "start": 178.368,
    "end": 183.968,
    "duration": 5.6
  },
  {
    "id": 43,
    "text": "以王熙凤为例，她既是贪婪弄权、杀伐决断、",
    "start": 183.968,
    "end": 188.688,
    "duration": 4.72
  },
  {
    "id": 44,
    "text": "害死尤二姐的封建家族酷吏，又是精明能干、谈笑风生、",
    "start": 188.688,
    "end": 194.288,
    "duration": 5.6
  },
  {
    "id": 45,
    "text": "偶发恻隐周济刘姥姥的能者；林黛玉不仅有多愁善感、",
    "start": 194.288,
    "end": 199.248,
    "duration": 4.96
  },
  {
    "id": 46,
    "text": "任性孤高的一面，更有才情横溢、自尊自爱的诗人本色。",
    "start": 199.248,
    "end": 203.968,
    "duration": 4.72
  },
  {
    "id": 47,
    "text": "小说人物性格前后发展、自相矛盾又合情合理，",
    "start": 203.968,
    "end": 208.768,
    "duration": 4.8
  },
  {
    "id": 48,
    "text": "达到了极高的心理真实度。",
    "start": 208.768,
    "end": 211.248,
    "duration": 2.48
  },
  {
    "id": 49,
    "text": "第四，运用虚实相生的谶纬预叙笔法，",
    "start": 211.248,
    "end": 214.928,
    "duration": 3.68
  },
  {
    "id": 50,
    "text": "构筑宿命感与现实感高度统一的哲理空间。",
    "start": 214.928,
    "end": 219.088,
    "duration": 4.16
  },
  {
    "id": 51,
    "text": "在叙事手法上，《红楼梦》 巧妙融合了神话构架与写实细节。",
    "start": 219.088,
    "end": 224.848,
    "duration": 5.76
  },
  {
    "id": 52,
    "text": "开篇以女娲补天遗石与通灵宝玉展开神话预设，",
    "start": 224.848,
    "end": 228.608,
    "duration": 3.76
  },
  {
    "id": 53,
    "text": "以太虚幻境中的十二钗判词与红楼梦曲预言人物命运；",
    "start": 228.608,
    "end": 231.568,
    "duration": 2.96
  },
  {
    "id": 54,
    "text": "在现实叙事中，又借元宵灯谜、中秋联诗、",
    "start": 231.408,
    "end": 231.568,
    "duration": 0.16
  },
  {
    "id": 55,
    "text": "芙蓉女儿诔等日常细节作为谶语，提前透露悲剧结局。",
    "start": 231.408,
    "end": 231.568,
    "duration": 0.16
  },
  {
    "id": 56,
    "text": "这种“真事隐去，假语村言”的虚实结合，",
    "start": 231.408,
    "end": 231.568,
    "duration": 0.16
  },
  {
    "id": 57,
    "text": "使整部作品在极具生活质感的现实主义描摹之上，",
    "start": 231.408,
    "end": 231.568,
    "duration": 0.16
  },
  {
    "id": 58,
    "text": "笼罩着一层俯瞰人世苍凉的深邃哲学沉思。",
    "start": 231.408,
    "end": 231.568,
    "duration": 0.16
  }
]