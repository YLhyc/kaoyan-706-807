[
  {
    "id": 1,
    "text": "试论《红楼梦》的悲剧意蕴与叙事艺术成就。",
    "start": 0.101,
    "end": 3.721,
    "duration": 3.62
  },
  {
    "id": 2,
    "text": "《红楼梦》是中国古典长篇章回小说的集大成之作，",
    "start": 4.256,
    "end": 8.216,
    "duration": 3.96
  },
  {
    "id": 3,
    "text": "也是封建末世社会生活的百科全书。",
    "start": 8.415,
    "end": 11.313,
    "duration": 2.898
  },
  {
    "id": 4,
    "text": "面对清代康乾盛世表象下的深刻危机，",
    "start": 11.947,
    "end": 14.912,
    "duration": 2.965
  },
  {
    "id": 5,
    "text": "曹雪芹以自身家族败落的切身体验，“披阅十载，增删五次”，",
    "start": 15.184,
    "end": 20.433,
    "duration": 5.249
  },
  {
    "id": 6,
    "text": "打破传统小说才子佳人大团圆的陈旧套路，",
    "start": 20.675,
    "end": 24.005,
    "duration": 3.33
  },
  {
    "id": 7,
    "text": "将古典悲剧推向全新的思想与艺术高度。",
    "start": 24.373,
    "end": 27.66,
    "duration": 3.287
  },
  {
    "id": 8,
    "text": "鲁迅在《中国小说的历史的变迁》中赞许其“自有《红楼梦》出来以后，",
    "start": 28.035,
    "end": 32.482,
    "duration": 4.447
  },
  {
    "id": 9,
    "text": "传统的思想和写法都打破了”。",
    "start": 32.586,
    "end": 34.662,
    "duration": 2.076
  },
  {
    "id": 10,
    "text": "其悲剧意蕴与叙事成就，主要体现在以下四个方面：",
    "start": 35.147,
    "end": 38.973,
    "duration": 3.826
  },
  {
    "id": 11,
    "text": "第一，构筑三重交织的悲剧意蕴，",
    "start": 39.601,
    "end": 42.485,
    "duration": 2.884
  },
  {
    "id": 12,
    "text": "揭示封建宗法制度衰亡的历史必然。",
    "start": 42.833,
    "end": 45.747,
    "duration": 2.914
  },
  {
    "id": 13,
    "text": "《红楼梦》的悲剧根植于不可调和的社会与历史矛盾，",
    "start": 46.024,
    "end": 49.607,
    "duration": 3.583
  },
  {
    "id": 14,
    "text": "包含三重层层递进的必然悲剧：",
    "start": 49.911,
    "end": 52.461,
    "duration": 2.55
  },
  {
    "id": 15,
    "text": "其一是青年反叛者的爱情婚姻悲剧，",
    "start": 52.918,
    "end": 55.786,
    "duration": 2.868
  },
  {
    "id": 16,
    "text": "贾宝玉与林黛玉追求精神契合的“木石前盟”，",
    "start": 56.317,
    "end": 59.908,
    "duration": 3.591
  },
  {
    "id": 17,
    "text": "被维护家族利益的“金玉良缘”所扼杀；",
    "start": 60.157,
    "end": 62.905,
    "duration": 2.748
  },
  {
    "id": 18,
    "text": "其二是大观园女性群体的命运悲剧，“千红一哭，万艳同悲”，",
    "start": 63.4,
    "end": 68.858,
    "duration": 5.458
  },
  {
    "id": 19,
    "text": "无论是高洁的晴雯、刚烈的鸳鸯还是柔顺的迎春，",
    "start": 69.361,
    "end": 73.193,
    "duration": 3.832
  },
  {
    "id": 20,
    "text": "皆难逃被摧残的厄运；",
    "start": 73.551,
    "end": 75.166,
    "duration": 1.615
  },
  {
    "id": 21,
    "text": "其三是封建贵族家族衰败的社会历史悲剧，",
    "start": 75.481,
    "end": 78.601,
    "duration": 3.12
  },
  {
    "id": 22,
    "text": "赫赫扬扬百载的贾府由盛转衰、走向崩塌，",
    "start": 78.884,
    "end": 82.268,
    "duration": 3.384
  },
  {
    "id": 23,
    "text": "终致“落了片白茫茫大地真干净”，",
    "start": 82.632,
    "end": 85.239,
    "duration": 2.607
  },
  {
    "id": 24,
    "text": "揭示了封建末世美好价值必然毁灭的命运。",
    "start": 85.655,
    "end": 88.912,
    "duration": 3.257
  },
  {
    "id": 25,
    "text": "第二，确立多线并进的网状叙事结构，于日常细节中暗伏兴亡线索。",
    "start": 89.579,
    "end": 95.446,
    "duration": 5.867
  },
  {
    "id": 26,
    "text": "在叙事结构上，",
    "start": 95.973,
    "end": 97.061,
    "duration": 1.088
  },
  {
    "id": 27,
    "text": "《红楼梦》摆脱了早期小说单线纵进与串珠式的简单格局，",
    "start": 97.302,
    "end": 101.475,
    "duration": 4.173
  },
  {
    "id": 28,
    "text": "创造了宏阔严密的网状全景结构。",
    "start": 101.946,
    "end": 104.546,
    "duration": 2.6
  },
  {
    "id": 29,
    "text": "作者将贾府家族盛衰与宝黛爱情发展两条主线紧密交织，",
    "start": 105.07,
    "end": 109.72,
    "duration": 4.65
  },
  {
    "id": 30,
    "text": "以大观园为中心展开错综复杂的人事网络，借元妃省亲、",
    "start": 109.989,
    "end": 114.855,
    "duration": 4.866
  },
  {
    "id": 31,
    "text": "宝玉挨打、抄检大观园与黛死钗嫁等重大事件为枢纽，",
    "start": 115.42,
    "end": 119.888,
    "duration": 4.468
  },
  {
    "id": 32,
    "text": "推动情节由繁盛走向剧烈分化与衰败。",
    "start": 120.394,
    "end": 123.599,
    "duration": 3.205
  },
  {
    "id": 33,
    "text": "作者长于在饮酒作诗、",
    "start": 124.229,
    "end": 126.193,
    "duration": 1.964
  },
  {
    "id": 34,
    "text": "家长里短的日常白描中暗伏生死兴亡线索，",
    "start": 126.869,
    "end": 130.435,
    "duration": 3.566
  },
  {
    "id": 35,
    "text": "使大小事件互为因果、连环勾牵，做到了草蛇灰线、伏脉千里。",
    "start": 130.829,
    "end": 136.453,
    "duration": 5.624
  },
  {
    "id": 36,
    "text": "第三，打破类型化人物塑造套路，刻画性格复杂多面的人物群像。",
    "start": 137.071,
    "end": 142.138,
    "duration": 5.067
  },
  {
    "id": 37,
    "text": "曹雪芹突破了传统小说忠奸善恶的脸谱定型，",
    "start": 142.461,
    "end": 146.101,
    "duration": 3.64
  },
  {
    "id": 38,
    "text": "以精微的心理刻画与多维生活视角，写出人物性格的复杂真实。",
    "start": 146.408,
    "end": 151.01,
    "duration": 4.602
  },
  {
    "id": 39,
    "text": "以王熙凤为例，她既是贪婪弄权、逼死尤二姐的狠辣管家，",
    "start": 151.335,
    "end": 155.399,
    "duration": 4.064
  },
  {
    "id": 40,
    "text": "又是精明能干、谈笑风生、偶发善心周济刘姥姥的能人；",
    "start": 155.643,
    "end": 159.677,
    "duration": 4.034
  },
  {
    "id": 41,
    "text": "林黛玉既有敏感孤高、多愁善感的一面，更有才情横溢、",
    "start": 160.096,
    "end": 164.23,
    "duration": 4.134
  },
  {
    "id": 42,
    "text": "自尊自爱的诗人本色。",
    "start": 164.414,
    "end": 165.909,
    "duration": 1.495
  },
  {
    "id": 43,
    "text": "人物性格鲜活丰富且合情合理，",
    "start": 166.349,
    "end": 168.485,
    "duration": 2.136
  },
  {
    "id": 44,
    "text": "代表了古代长篇小说人物塑造的最高水准。",
    "start": 168.641,
    "end": 171.461,
    "duration": 2.82
  },
  {
    "id": 45,
    "text": "第四，运用虚实相生的预叙笔法，融合生活质感与命运苍凉感。",
    "start": 172.105,
    "end": 177.74,
    "duration": 5.635
  },
  {
    "id": 46,
    "text": "在叙事手法上，《红楼梦》巧妙结合神话构架与写实细节。",
    "start": 178.082,
    "end": 182.514,
    "duration": 4.432
  },
  {
    "id": 47,
    "text": "开篇以女娲补天遗石与通灵宝玉展开神话缘起，",
    "start": 182.933,
    "end": 186.811,
    "duration": 3.878
  },
  {
    "id": 48,
    "text": "前五回借太虚幻境十二钗判词、",
    "start": 187.073,
    "end": 189.677,
    "duration": 2.604
  },
  {
    "id": 49,
    "text": "《好了歌》及《红楼梦》十二支曲暗示人物与家族命运；",
    "start": 189.896,
    "end": 193.782,
    "duration": 3.886
  },
  {
    "id": 50,
    "text": "在现实叙事中，又以元宵灯谜、",
    "start": 194.035,
    "end": 196.69,
    "duration": 2.655
  },
  {
    "id": 51,
    "text": "中秋联诗与大观园四时景致变化作为伏笔，呼应悲剧结局。",
    "start": 197.225,
    "end": 202.055,
    "duration": 4.83
  },
  {
    "id": 52,
    "text": "这种“真事隐去，假语村言”的虚实相生写法，",
    "start": 202.426,
    "end": 206.392,
    "duration": 3.966
  },
  {
    "id": 53,
    "text": "使作品在细腻的写实描摹之上，笼罩着一层深沉的人生感慨。",
    "start": 206.652,
    "end": 211.708,
    "duration": 5.056
  },
  {
    "id": 54,
    "text": "总而言之，",
    "start": 212.319,
    "end": 212.985,
    "duration": 0.666
  },
  {
    "id": 55,
    "text": "《红楼梦》代表了中国古代长篇章回小说与悲剧艺术的高峰。",
    "start": 213.128,
    "end": 217.449,
    "duration": 4.321
  },
  {
    "id": 56,
    "text": "曹雪芹突破了传统“大团圆”的心理定势，以真切的生活质感、",
    "start": 217.978,
    "end": 222.569,
    "duration": 4.591
  },
  {
    "id": 57,
    "text": "立体丰满的人物群像与网状交织的叙事结构，",
    "start": 223.107,
    "end": 226.583,
    "duration": 3.476
  },
  {
    "id": 58,
    "text": "写尽了封建家族与世俗美梦无可挽回的幻灭。",
    "start": 226.884,
    "end": 230.408,
    "duration": 3.524
  },
  {
    "id": 59,
    "text": "王国维在《红楼梦评论》中赞叹其为“悲剧中之悲剧”，",
    "start": 230.714,
    "end": 234.957,
    "duration": 4.243
  },
  {
    "id": 60,
    "text": "鲁迅亦论定其“悲凉之雾，遍被华林，然呼吸而领会之者，",
    "start": 235.212,
    "end": 240.369,
    "duration": 5.157
  },
  {
    "id": 61,
    "text": "独宝玉一人而已”。",
    "start": 240.612,
    "end": 241.902,
    "duration": 1.29
  },
  {
    "id": 62,
    "text": "这部巨著对封建制度危机与人生悲剧的深刻开掘，",
    "start": 242.174,
    "end": 246.367,
    "duration": 4.193
  },
  {
    "id": 63,
    "text": "使其具备了跨越时空的永恒艺术魅力。",
    "start": 246.614,
    "end": 249.832,
    "duration": 3.218
  }
]