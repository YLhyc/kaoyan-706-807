[
  {
    "id": 1,
    "text": "试论《红楼梦》的悲剧意蕴与叙事艺术成就。",
    "start": 0.12,
    "end": 3.7,
    "duration": 3.58
  },
  {
    "id": 2,
    "text": "《红楼梦》是中国古典长篇章回小说的集大成之作，也是封建末世社会生活的百科全书。",
    "start": 4.2,
    "end": 10.949,
    "duration": 6.749
  },
  {
    "id": 3,
    "text": "面对清代康乾盛世表象下的深刻危机，曹雪芹以自身家族败落的切身体验，",
    "start": 11.449,
    "end": 17.811,
    "duration": 6.362
  },
  {
    "id": 4,
    "text": "“披阅十载，增删五次”，打破传统小说才子佳人大团圆的陈旧套路，",
    "start": 18.194,
    "end": 23.827,
    "duration": 5.633
  },
  {
    "id": 5,
    "text": "将古典悲剧推向全新的思想与艺术高度。",
    "start": 24.177,
    "end": 27.404,
    "duration": 3.227
  },
  {
    "id": 6,
    "text": "鲁迅赞许其“自有《红楼梦》出来以后，传统的思想和写法都打破了”。",
    "start": 27.949,
    "end": 33.097,
    "duration": 5.148
  },
  {
    "id": 7,
    "text": "其悲剧意蕴与叙事成就，主要体现在以下四个方面：",
    "start": 33.597,
    "end": 37.461,
    "duration": 3.864
  },
  {
    "id": 8,
    "text": "第一，构筑三重交织的悲剧意蕴，揭示封建宗法制度衰亡的历史必然。",
    "start": 37.811,
    "end": 43.075,
    "duration": 5.264
  },
  {
    "id": 9,
    "text": "《红楼梦》的悲剧根植于不可调和的社会与历史矛盾，",
    "start": 43.575,
    "end": 47.467,
    "duration": 3.892
  },
  {
    "id": 10,
    "text": "包含三重层层递进的必然悲剧：其一是青年反叛者的爱情婚姻悲剧，",
    "start": 47.817,
    "end": 53.325,
    "duration": 5.508
  },
  {
    "id": 11,
    "text": "贾宝玉与林黛玉追求精神契合的“木石前盟”，被维护家族利益的“金玉良缘”所扼杀；",
    "start": 53.675,
    "end": 60.048,
    "duration": 6.373
  },
  {
    "id": 12,
    "text": "其二是大观园女性群体的命运悲剧，“千红一哭，万艳同悲”，",
    "start": 60.548,
    "end": 65.606,
    "duration": 5.058
  },
  {
    "id": 13,
    "text": "无论是高洁的晴雯、刚烈的鸳鸯还是柔顺的迎春，皆难逃被摧残的厄运；",
    "start": 65.956,
    "end": 72.153,
    "duration": 6.197
  },
  {
    "id": 14,
    "text": "其三是封建贵族家族衰败的社会历史悲剧，赫赫扬扬百载的贾府由盛转衰、走向崩塌，",
    "start": 72.653,
    "end": 80.392,
    "duration": 7.739
  },
  {
    "id": 15,
    "text": "终致“落了片白茫茫大地真干净”，揭示了封建末世美好价值必然毁灭的命运。",
    "start": 80.88,
    "end": 87.004,
    "duration": 6.124
  },
  {
    "id": 16,
    "text": "第二，确立多线并进的网状叙事结构，于日常细节中暗伏兴亡线索。",
    "start": 87.504,
    "end": 93.336,
    "duration": 5.832
  },
  {
    "id": 17,
    "text": "在叙事结构上，《红楼梦》摆脱了早期小说单线纵进与串珠式的简单格局，",
    "start": 93.878,
    "end": 99.574,
    "duration": 5.696
  },
  {
    "id": 18,
    "text": "创造了宏阔严密的网状全景结构。",
    "start": 99.955,
    "end": 102.779,
    "duration": 2.824
  },
  {
    "id": 19,
    "text": "作者将贾府家族盛衰与宝黛爱情发展两条主线紧密交织，",
    "start": 103.39,
    "end": 108.19,
    "duration": 4.8
  },
  {
    "id": 20,
    "text": "以大观园为中心展开错综复杂的人事网络，借元妃省亲、宝玉挨打、抄检大观园与黛死钗嫁等重大事件为枢纽，",
    "start": 108.54,
    "end": 118.147,
    "duration": 9.607
  },
  {
    "id": 21,
    "text": "推动情节由繁盛走向剧烈分化与衰败。",
    "start": 118.497,
    "end": 121.803,
    "duration": 3.306
  },
  {
    "id": 22,
    "text": "作者长于在饮酒作诗、家长里短的日常白描中暗伏生死兴亡线索，",
    "start": 122.303,
    "end": 127.838,
    "duration": 5.535
  },
  {
    "id": 23,
    "text": "使大小事件互为因果、连环勾牵，做到了草蛇灰线、伏脉千里。",
    "start": 128.188,
    "end": 133.373,
    "duration": 5.185
  },
  {
    "id": 24,
    "text": "第三，打破类型化人物塑造套路，刻画性格复杂多面的人物群像。",
    "start": 133.873,
    "end": 139.197,
    "duration": 5.324
  },
  {
    "id": 25,
    "text": "曹雪芹突破了传统小说忠奸善恶的脸谱定型，",
    "start": 139.697,
    "end": 143.184,
    "duration": 3.487
  },
  {
    "id": 26,
    "text": "以精微的心理刻画与多维生活视角，写出人物性格的复杂真实。",
    "start": 143.716,
    "end": 148.6,
    "duration": 4.884
  },
  {
    "id": 27,
    "text": "以王熙凤为例，她既是贪婪弄权、逼死尤二姐的狠辣管家，又是精明能干、谈笑风生、偶发善心周济刘姥姥的能人；",
    "start": 149.1,
    "end": 158.553,
    "duration": 9.453
  },
  {
    "id": 28,
    "text": "林黛玉既有敏感孤高、多愁善感的一面，更有才情横溢、自尊自爱的诗人本色。",
    "start": 159.053,
    "end": 165.702,
    "duration": 6.649
  },
  {
    "id": 29,
    "text": "人物性格鲜活丰富且合情合理，代表了古代长篇小说人物塑造的最高水准。",
    "start": 166.224,
    "end": 172.987,
    "duration": 6.763
  },
  {
    "id": 30,
    "text": "第四，运用虚实相生的预叙笔法，融合生活质感与命运苍凉感。",
    "start": 173.516,
    "end": 179.355,
    "duration": 5.839
  },
  {
    "id": 31,
    "text": "在叙事手法上，《红楼梦》巧妙结合神话构架与写实细节。",
    "start": 179.855,
    "end": 184.674,
    "duration": 4.819
  },
  {
    "id": 32,
    "text": "开篇以女娲补天遗石与通灵宝玉展开神话缘起，",
    "start": 185.174,
    "end": 189.469,
    "duration": 4.295
  },
  {
    "id": 33,
    "text": "前五回借太虚幻境十二钗判词、《好了歌》及《红楼梦》十二支曲暗示人物与家族命运；",
    "start": 190.046,
    "end": 196.741,
    "duration": 6.695
  },
  {
    "id": 34,
    "text": "在现实叙事中，又以元宵灯谜、中秋联诗与大观园四时景致变化作为伏笔，呼应悲剧结局。",
    "start": 197.241,
    "end": 204.6,
    "duration": 7.359
  },
  {
    "id": 35,
    "text": "这种“真事隐去，假语村言”的虚实相生写法，",
    "start": 205.1,
    "end": 208.715,
    "duration": 3.615
  },
  {
    "id": 36,
    "text": "使作品在细腻的写实描摹之上，笼罩着一层深沉的人生感慨。",
    "start": 209.079,
    "end": 214.125,
    "duration": 5.046
  },
  {
    "id": 37,
    "text": "总而言之，《红楼梦》代表了中国古代长篇章回小说与悲剧艺术的高峰。",
    "start": 214.625,
    "end": 220.016,
    "duration": 5.391
  },
  {
    "id": 38,
    "text": "曹雪芹突破了传统“大团圆”的心理定势，",
    "start": 220.516,
    "end": 223.555,
    "duration": 3.039
  },
  {
    "id": 39,
    "text": "以真切的生活质感、立体丰满的人物群像与网状交织的叙事结构，写尽了封建家族与世俗美梦无可挽回的幻灭。",
    "start": 223.905,
    "end": 233.65,
    "duration": 9.745
  },
  {
    "id": 40,
    "text": "王国维在《红楼梦评论》中赞叹其为“悲剧中之悲剧”，",
    "start": 234.15,
    "end": 238.221,
    "duration": 4.071
  },
  {
    "id": 41,
    "text": "鲁迅亦论定其“悲凉之雾，遍被华林，然呼吸而领会之者，独宝玉一人而已”。",
    "start": 238.571,
    "end": 245.467,
    "duration": 6.896
  },
  {
    "id": 42,
    "text": "这部巨著对封建制度危机与人生悲剧的深刻开掘，使其具备了跨越时空的永恒艺术魅力。",
    "start": 245.967,
    "end": 253.71,
    "duration": 7.743
  }
]
