[
  {
    "id": 1,
    "text": "题型，三十分论述题。",
    "start": 0.08,
    "end": 1.93,
    "duration": 1.85
  },
  {
    "id": 2,
    "text": "分值，三十分。",
    "start": 1.93,
    "end": 3.08,
    "duration": 1.15
  },
  {
    "id": 3,
    "text": "建议考场时间，三十五分钟。",
    "start": 3.08,
    "end": 5.61,
    "duration": 2.53
  },
  {
    "id": 4,
    "text": "目标字数，一千一百五十到一千三百字。",
    "start": 5.61,
    "end": 9.29,
    "duration": 3.68
  },
  {
    "id": 5,
    "text": "答题骨架，时代双峰定性、趋近于、",
    "start": 9.29,
    "end": 12.28,
    "duration": 2.99
  },
  {
    "id": 6,
    "text": "精神品格与时代投射之异同、趋近于、",
    "start": 12.28,
    "end": 15.73,
    "duration": 3.45
  },
  {
    "id": 7,
    "text": "抒情形态与审美意境之对比、趋近于、",
    "start": 15.73,
    "end": 19.18,
    "duration": 3.45
  },
  {
    "id": 8,
    "text": "体裁选择与诗律建构之分流、趋近于、",
    "start": 19.18,
    "end": 22.63,
    "duration": 3.45
  },
  {
    "id": 9,
    "text": "宏观文学史总结。",
    "start": 22.63,
    "end": 24.24,
    "duration": 1.61
  },
  {
    "id": 10,
    "text": "李白与杜甫是中国古典诗歌发展巅峰上并峙的双峰，",
    "start": 24.32,
    "end": 28.8,
    "duration": 4.48
  },
  {
    "id": 11,
    "text": "共同从不同侧面烛照并铸就了盛唐气象的博大格局。",
    "start": 28.8,
    "end": 33.36,
    "duration": 4.56
  },
  {
    "id": 12,
    "text": "两者在精神追求、抒情机制与体裁建构上各具卓异特质，",
    "start": 33.36,
    "end": 38.32,
    "duration": 4.96
  },
  {
    "id": 13,
    "text": "展现了唐代诗歌从激昂蓬勃走向深沉浑厚的全景演进。",
    "start": 38.32,
    "end": 43.76,
    "duration": 5.44
  },
  {
    "id": 14,
    "text": "第一，在时代精神投射与主体人格品格上，",
    "start": 43.76,
    "end": 47.44,
    "duration": 3.68
  },
  {
    "id": 15,
    "text": "李白展现了盛唐蓬勃自信的自由精神，",
    "start": 47.44,
    "end": 50.88,
    "duration": 3.44
  },
  {
    "id": 16,
    "text": "杜甫则体现了盛唐兼济天下的忧患意识与博大胸襟。",
    "start": 50.88,
    "end": 55.2,
    "duration": 4.32
  },
  {
    "id": 17,
    "text": "盛唐社会的空前繁荣与开放风气，赋予李白强烈的自我主体意识与蔑视权贵的豪侠气概。",
    "start": 55.6,
    "end": 63.04,
    "duration": 7.44
  },
  {
    "id": 18,
    "text": "李白在《将进酒》中高唱“天生我材必有用，",
    "start": 63.04,
    "end": 66.56,
    "duration": 3.52
  },
  {
    "id": 19,
    "text": "千金散尽还复来”，在《梦游天姥吟留别》中断喝“安能摧眉折腰事权贵，",
    "start": 66.56,
    "end": 72.96,
    "duration": 6.4
  },
  {
    "id": 20,
    "text": "使我不得开心颜”，将盛唐士人的自信自尊与对精神自由的追寻推向顶点。",
    "start": 72.96,
    "end": 79.12,
    "duration": 6.16
  },
  {
    "id": 21,
    "text": "杜甫则根植于儒家仁政理想与民胞物与的情怀，",
    "start": 79.36,
    "end": 83.52,
    "duration": 4.16
  },
  {
    "id": 22,
    "text": "在开元盛世转向安史之乱的剧烈转折中，",
    "start": 83.52,
    "end": 86.88,
    "duration": 3.36
  },
  {
    "id": 23,
    "text": "将个人的漂泊困顿与国家民族的存亡紧密相连。",
    "start": 86.88,
    "end": 91.04,
    "duration": 4.16
  },
  {
    "id": 24,
    "text": "杜甫在《茅屋为秋风所破歌》中发出“安得广厦千万间，",
    "start": 91.04,
    "end": 95.44,
    "duration": 4.4
  },
  {
    "id": 25,
    "text": "大庇天下寒士俱欢颜”的宏大呼喊，",
    "start": 95.44,
    "end": 98.32,
    "duration": 2.88
  },
  {
    "id": 26,
    "text": "在推己及人中展现出悲天敏人的博大胸襟，",
    "start": 98.32,
    "end": 102.0,
    "duration": 3.68
  },
  {
    "id": 27,
    "text": "从深层揭示了盛唐气象沉雄深厚的一面。",
    "start": 102.0,
    "end": 105.28,
    "duration": 3.28
  },
  {
    "id": 28,
    "text": "第二，在抒情机制与审美形态上，李白长于喷薄而出的主观抒情与超现实想象，",
    "start": 105.584,
    "end": 112.384,
    "duration": 6.8
  },
  {
    "id": 29,
    "text": "杜甫长于沉郁顿挫的情感蓄积与高度写实的诗史叙事。",
    "start": 112.384,
    "end": 117.424,
    "duration": 5.04
  },
  {
    "id": 30,
    "text": "李白的抒情方式具有强烈的主观化与跳跃性特征。",
    "start": 117.424,
    "end": 121.504,
    "duration": 4.08
  },
  {
    "id": 31,
    "text": "诗人往往打破现实时空逻辑，调动天马行空的神话意象与夸张手法，",
    "start": 121.504,
    "end": 126.944,
    "duration": 5.44
  },
  {
    "id": 32,
    "text": "形成飘逸奔放的浪漫主义美学。",
    "start": 126.944,
    "end": 129.264,
    "duration": 2.32
  },
  {
    "id": 33,
    "text": "比如在《蜀道难》中，诗人以“上有六龙回日之高标，",
    "start": 129.504,
    "end": 133.744,
    "duration": 4.24
  },
  {
    "id": 34,
    "text": "下有冲波逆折之回川”的惊人奇想，",
    "start": 133.744,
    "end": 136.704,
    "duration": 2.96
  },
  {
    "id": 35,
    "text": "借蜀道艰险抒发人生幻灭与宏阔感慨。",
    "start": 136.704,
    "end": 139.984,
    "duration": 3.28
  },
  {
    "id": 36,
    "text": "杜甫的抒情则深沉蕴藉，情感在曲折回旋中徐徐展开。",
    "start": 139.984,
    "end": 145.024,
    "duration": 5.04
  },
  {
    "id": 37,
    "text": "其诗歌以写实见长，深刻记录了时代动荡与民间疾苦，",
    "start": 145.024,
    "end": 150.064,
    "duration": 5.04
  },
  {
    "id": 38,
    "text": "具备鲜明的“诗史”性质。",
    "start": 150.064,
    "end": 151.744,
    "duration": 1.68
  },
  {
    "id": 39,
    "text": "比如在《石壕吏》与《新安吏》等叙事名篇中，",
    "start": 151.984,
    "end": 155.264,
    "duration": 3.28
  },
  {
    "id": 40,
    "text": "杜甫通过客观冷静的细节白描与老妇自诉，",
    "start": 155.264,
    "end": 159.184,
    "duration": 3.92
  },
  {
    "id": 41,
    "text": "深刻揭露了战乱对平民家庭的残酷摧残，",
    "start": 159.184,
    "end": 162.944,
    "duration": 3.76
  },
  {
    "id": 42,
    "text": "叙事之中寄托着深沉的悲愤与同情，",
    "start": 162.944,
    "end": 166.064,
    "duration": 3.12
  },
  {
    "id": 43,
    "text": "形成了悲壮沉郁的美学风格。",
    "start": 166.064,
    "end": 168.464,
    "duration": 2.4
  },
  {
    "id": 44,
    "text": "第三，在体裁选择与诗律建构上，李白醉心于古体诗与绝句的自由纵逸，",
    "start": 168.464,
    "end": 174.944,
    "duration": 6.48
  },
  {
    "id": 45,
    "text": "杜甫则在近体律诗的严整规范中实现了集大成的历史跨越。",
    "start": 174.944,
    "end": 179.424,
    "duration": 4.48
  },
  {
    "id": 46,
    "text": "李白追求不受格律束缚的心灵自适，",
    "start": 179.664,
    "end": 182.464,
    "duration": 2.8
  },
  {
    "id": 47,
    "text": "其代表作大多集中于古风、乐府与七言绝句。",
    "start": 182.464,
    "end": 186.144,
    "duration": 3.68
  },
  {
    "id": 48,
    "text": "诗人在歌行体中大量运用长短错落的杂言句式与平仄互换，",
    "start": 186.144,
    "end": 190.784,
    "duration": 4.64
  },
  {
    "id": 49,
    "text": "如《宣州谢窕楼建别校书叔云》的开篇长句，",
    "start": 190.784,
    "end": 194.304,
    "duration": 3.52
  },
  {
    "id": 50,
    "text": "气势如奔马骤至。",
    "start": 194.304,
    "end": 195.664,
    "duration": 1.36
  },
  {
    "id": 51,
    "text": "杜甫则致力于律诗规则的深密营构，",
    "start": 195.664,
    "end": 198.544,
    "duration": 2.88
  },
  {
    "id": 52,
    "text": "尤其在七言律诗的艺术探索上达到了前无古人的境界。",
    "start": 198.544,
    "end": 202.224,
    "duration": 3.68
  },
  {
    "id": 53,
    "text": "杜甫严格遵循平仄、对仗与黏对规范，",
    "start": 202.544,
    "end": 205.984,
    "duration": 3.44
  },
  {
    "id": 54,
    "text": "却能在森严法度之中自如驾驭极其复杂深沉的历史感慨。",
    "start": 205.984,
    "end": 210.704,
    "duration": 4.72
  },
  {
    "id": 55,
    "text": "比如晚年名作《登高》全诗八句四联皆工整对仗，",
    "start": 210.704,
    "end": 215.184,
    "duration": 4.48
  },
  {
    "id": 56,
    "text": "以“无边落木萧萧下，不尽长江滚滚来”的雄阔对仗，",
    "start": 215.184,
    "end": 219.664,
    "duration": 4.48
  },
  {
    "id": 57,
    "text": "将壮阔时空与个人衰病身世浑然融为一体，",
    "start": 219.664,
    "end": 223.424,
    "duration": 3.76
  },
  {
    "id": 58,
    "text": "达到了声律和谐与气象万千的高度统一。",
    "start": 223.424,
    "end": 226.624,
    "duration": 3.2
  },
  {
    "id": 59,
    "text": "综上所述，李白以其豪迈奔放的天才神采，",
    "start": 226.944,
    "end": 230.544,
    "duration": 3.6
  },
  {
    "id": 60,
    "text": "代表了盛唐昂扬向上、追求自由的精神高峰。",
    "start": 230.544,
    "end": 234.144,
    "duration": 3.6
  },
  {
    "id": 61,
    "text": "杜甫以其沉雄沉郁的博大胸襟与精严诗律，",
    "start": 234.144,
    "end": 237.984,
    "duration": 3.84
  },
  {
    "id": 62,
    "text": "代表了盛唐深沉博大、关怀现实的最高典范。",
    "start": 237.984,
    "end": 242.064,
    "duration": 4.08
  },
  {
    "id": 63,
    "text": "李杜双峰并峙，互为表里，共同确立了盛唐气象的博大审美疆域，",
    "start": 242.064,
    "end": 247.504,
    "duration": 5.44
  },
  {
    "id": 64,
    "text": "对后世诗歌创作产生了深远而持久的典范影响。",
    "start": 247.504,
    "end": 251.024,
    "duration": 3.52
  }
]