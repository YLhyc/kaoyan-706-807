[
  {
    "id": 1,
    "start": 0.08,
    "end": 4.56,
    "text": "李白与杜甫是中国古典诗歌发展巅峰上并峙的双峰，"
  },
  {
    "id": 2,
    "start": 4.56,
    "end": 9.12,
    "text": "共同从不同侧面烛照并铸就了盛唐气象的博大格局。"
  },
  {
    "id": 3,
    "start": 9.12,
    "end": 14.08,
    "text": "两者在精神追求、抒情机制与体裁建构上各具卓异特质，"
  },
  {
    "id": 4,
    "start": 14.08,
    "end": 19.52,
    "text": "展现了唐代诗歌从激昂蓬勃走向深沉浑厚的全景演进。"
  },
  {
    "id": 5,
    "start": 19.52,
    "end": 23.2,
    "text": "第一，在时代精神投射与主体人格品格上，"
  },
  {
    "id": 6,
    "start": 23.2,
    "end": 26.64,
    "text": "李白展现了盛唐蓬勃自信的自由精神，"
  },
  {
    "id": 7,
    "start": 26.64,
    "end": 30.96,
    "text": "杜甫则体现了盛唐兼济天下的忧患意识与博大胸襟。"
  },
  {
    "id": 8,
    "start": 31.36,
    "end": 38.8,
    "text": "盛唐社会的空前繁荣与开放风气，赋予李白强烈的自我主体意识与蔑视权贵的豪侠气概。"
  },
  {
    "id": 9,
    "start": 38.8,
    "end": 42.32,
    "text": "李白在《将进酒》中高唱“天生我材必有用，"
  },
  {
    "id": 10,
    "start": 42.32,
    "end": 48.72,
    "text": "千金散尽还复来”，在《梦游天姥吟留别》中断喝“安能摧眉折腰事权贵，"
  },
  {
    "id": 11,
    "start": 48.72,
    "end": 54.88,
    "text": "使我不得开心颜”，将盛唐士人的自信自尊与对精神自由的追寻推向顶点。"
  },
  {
    "id": 12,
    "start": 55.12,
    "end": 59.28,
    "text": "杜甫则根植于儒家仁政理想与民胞物与的情怀，"
  },
  {
    "id": 13,
    "start": 59.28,
    "end": 62.64,
    "text": "在开元盛世转向安史之乱的剧烈转折中，"
  },
  {
    "id": 14,
    "start": 62.64,
    "end": 66.8,
    "text": "将个人的漂泊困顿与国家民族的存亡紧密相连。"
  },
  {
    "id": 15,
    "start": 66.8,
    "end": 71.2,
    "text": "杜甫在《茅屋为秋风所破歌》中发出“安得广厦千万间，"
  },
  {
    "id": 16,
    "start": 71.2,
    "end": 74.08,
    "text": "大庇天下寒士俱欢颜”的宏大呼喊，"
  },
  {
    "id": 17,
    "start": 74.08,
    "end": 77.76,
    "text": "在推己及人中展现出悲天敏人的博大胸襟，"
  },
  {
    "id": 18,
    "start": 77.76,
    "end": 81.04,
    "text": "从深层揭示了盛唐气象沉雄深厚的一面。"
  },
  {
    "id": 19,
    "start": 81.344,
    "end": 88.144,
    "text": "第二，在抒情机制与审美形态上，李白长于喷薄而出的主观抒情与超现实想象，"
  },
  {
    "id": 20,
    "start": 88.144,
    "end": 93.184,
    "text": "杜甫长于沉郁顿挫的情感蓄积与高度写实的诗史叙事。"
  },
  {
    "id": 21,
    "start": 93.184,
    "end": 97.264,
    "text": "李白的抒情方式具有强烈的主观化与跳跃性特征。"
  },
  {
    "id": 22,
    "start": 97.264,
    "end": 102.704,
    "text": "诗人往往打破现实时空逻辑，调动天马行空的神话意象与夸张手法，"
  },
  {
    "id": 23,
    "start": 102.704,
    "end": 105.024,
    "text": "形成飘逸奔放的浪漫主义美学。"
  },
  {
    "id": 24,
    "start": 105.264,
    "end": 109.504,
    "text": "比如在《蜀道难》中，诗人以“上有六龙回日之高标，"
  },
  {
    "id": 25,
    "start": 109.504,
    "end": 112.464,
    "text": "下有冲波逆折之回川”的惊人奇想，"
  },
  {
    "id": 26,
    "start": 112.464,
    "end": 115.744,
    "text": "借蜀道艰险抒发人生幻灭与宏阔感慨。"
  },
  {
    "id": 27,
    "start": 115.744,
    "end": 120.784,
    "text": "杜甫的抒情则深沉蕴藉，情感在曲折回旋中徐徐展开。"
  },
  {
    "id": 28,
    "start": 120.784,
    "end": 125.824,
    "text": "其诗歌以写实见长，深刻记录了时代动荡与民间疾苦，"
  },
  {
    "id": 29,
    "start": 125.824,
    "end": 127.504,
    "text": "具备鲜明的“诗史”性质。"
  },
  {
    "id": 30,
    "start": 127.744,
    "end": 131.024,
    "text": "比如在《石壕吏》与《新安吏》等叙事名篇中，"
  },
  {
    "id": 31,
    "start": 131.024,
    "end": 134.944,
    "text": "杜甫通过客观冷静的细节白描与老妇自诉，"
  },
  {
    "id": 32,
    "start": 134.944,
    "end": 138.704,
    "text": "深刻揭露了战乱对平民家庭的残酷摧残，"
  },
  {
    "id": 33,
    "start": 138.704,
    "end": 141.824,
    "text": "叙事之中寄托着深沉的悲愤与同情，"
  },
  {
    "id": 34,
    "start": 141.824,
    "end": 144.224,
    "text": "形成了悲壮沉郁的美学风格。"
  },
  {
    "id": 35,
    "start": 144.224,
    "end": 150.704,
    "text": "第三，在体裁选择与诗律建构上，李白醉心于古体诗与绝句的自由纵逸，"
  },
  {
    "id": 36,
    "start": 150.704,
    "end": 155.184,
    "text": "杜甫则在近体律诗的严整规范中实现了集大成的历史跨越。"
  },
  {
    "id": 37,
    "start": 155.424,
    "end": 158.224,
    "text": "李白追求不受格律束缚的心灵自适，"
  },
  {
    "id": 38,
    "start": 158.224,
    "end": 161.904,
    "text": "其代表作大多集中于古风、乐府与七言绝句。"
  },
  {
    "id": 39,
    "start": 161.904,
    "end": 166.544,
    "text": "诗人在歌行体中大量运用长短错落的杂言句式与平仄互换，"
  },
  {
    "id": 40,
    "start": 166.544,
    "end": 170.064,
    "text": "如《宣州谢窕楼建别校书叔云》的开篇长句，"
  },
  {
    "id": 41,
    "start": 170.064,
    "end": 171.424,
    "text": "气势如奔马骤至。"
  },
  {
    "id": 42,
    "start": 171.424,
    "end": 174.304,
    "text": "杜甫则致力于律诗规则的深密营构，"
  },
  {
    "id": 43,
    "start": 174.304,
    "end": 177.984,
    "text": "尤其在七言律诗的艺术探索上达到了前无古人的境界。"
  },
  {
    "id": 44,
    "start": 178.304,
    "end": 181.744,
    "text": "杜甫严格遵循平仄、对仗与黏对规范，"
  },
  {
    "id": 45,
    "start": 181.744,
    "end": 186.464,
    "text": "却能在森严法度之中自如驾驭极其复杂深沉的历史感慨。"
  },
  {
    "id": 46,
    "start": 186.464,
    "end": 190.944,
    "text": "比如晚年名作《登高》全诗八句四联皆工整对仗，"
  },
  {
    "id": 47,
    "start": 190.944,
    "end": 195.424,
    "text": "以“无边落木萧萧下，不尽长江滚滚来”的雄阔对仗，"
  },
  {
    "id": 48,
    "start": 195.424,
    "end": 199.184,
    "text": "将壮阔时空与个人衰病身世浑然融为一体，"
  },
  {
    "id": 49,
    "start": 199.184,
    "end": 202.384,
    "text": "达到了声律和谐与气象万千的高度统一。"
  },
  {
    "id": 50,
    "start": 202.704,
    "end": 206.304,
    "text": "综上所述，李白以其豪迈奔放的天才神采，"
  },
  {
    "id": 51,
    "start": 206.304,
    "end": 209.904,
    "text": "代表了盛唐昂扬向上、追求自由的精神高峰。"
  },
  {
    "id": 52,
    "start": 209.904,
    "end": 213.744,
    "text": "杜甫以其沉雄沉郁的博大胸襟与精严诗律，"
  },
  {
    "id": 53,
    "start": 213.744,
    "end": 217.824,
    "text": "代表了盛唐深沉博大、关怀现实的最高典范。"
  },
  {
    "id": 54,
    "start": 217.824,
    "end": 223.264,
    "text": "李杜双峰并峙，互为表里，共同确立了盛唐气象的博大审美疆域，"
  },
  {
    "id": 55,
    "start": 223.264,
    "end": 226.784,
    "text": "对后世诗歌创作产生了深远而持久的典范影响。"
  }
]