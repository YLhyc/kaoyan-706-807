[
  {
    "id": 1,
    "text": "试论李白诗歌的艺术特质与盛唐气象。",
    "start": 0.05,
    "end": 3.817,
    "duration": 3.767
  },
  {
    "id": 2,
    "text": "李白是中国古典诗歌浪漫主义传统的最高巅峰，",
    "start": 3.817,
    "end": 7.937,
    "duration": 4.12
  },
  {
    "id": 3,
    "text": "也是 “盛唐气象” 最杰出的艺术人格代表。",
    "start": 7.937,
    "end": 12.698,
    "duration": 4.761
  },
  {
    "id": 4,
    "text": "身处开元天宝大唐国力极盛的历史节点，",
    "start": 12.698,
    "end": 17.011,
    "duration": 4.313
  },
  {
    "id": 5,
    "text": "李白承接了时代自信开放、昂扬开拓的精神底色，",
    "start": 17.011,
    "end": 21.665,
    "duration": 4.654
  },
  {
    "id": 6,
    "text": "以追求精神绝对自由的崇高傲骨，",
    "start": 21.665,
    "end": 24.21,
    "duration": 2.545
  },
  {
    "id": 7,
    "text": "将盛唐诗歌推向了飞扬奇伟的艺术极境。",
    "start": 24.21,
    "end": 27.639,
    "duration": 3.429
  },
  {
    "id": 8,
    "text": "韩愈赞其 “李杜文章在，光焰万丈长”；",
    "start": 27.639,
    "end": 30.958,
    "duration": 3.319
  },
  {
    "id": 9,
    "text": "严羽 《沧浪诗话》 称其 “如羚羊挂角，无迹可求”。",
    "start": 30.958,
    "end": 35.815,
    "duration": 4.857
  },
  {
    "id": 10,
    "text": "李白诗歌绝非孤立的书生吟咏，而是盛唐时代精神的集中审美体现。",
    "start": 35.815,
    "end": 40.906,
    "duration": 5.091
  },
  {
    "id": 11,
    "text": "其艺术特质主要展现为以下四个核心维度：",
    "start": 40.906,
    "end": 45.584,
    "duration": 4.678
  },
  {
    "id": 12,
    "text": "第一，标举追求精神自由的主体人格，",
    "start": 45.584,
    "end": 48.312,
    "duration": 2.728
  },
  {
    "id": 13,
    "text": "集中体现傲岸自信的时代气象。",
    "start": 48.312,
    "end": 51.288,
    "duration": 2.976
  },
  {
    "id": 14,
    "text": "李白诗歌最震撼人心的力量，在于塑造了一个傲立王侯、",
    "start": 51.288,
    "end": 55.755,
    "duration": 4.467
  },
  {
    "id": 15,
    "text": "追求绝对精神解放的抒情主人公形象。",
    "start": 55.755,
    "end": 60.544,
    "duration": 4.789
  },
  {
    "id": 16,
    "text": "在政治权贵面前，他傲岸宣告 “安能摧眉折腰事权贵，",
    "start": 60.544,
    "end": 64.633,
    "duration": 4.089
  },
  {
    "id": 17,
    "text": "使我不得开心颜”；面对仕途坎坷，",
    "start": 64.633,
    "end": 68.117,
    "duration": 3.484
  },
  {
    "id": 18,
    "text": "他始终坚信 “长风破浪会有时，直挂云帆济沧海”；",
    "start": 68.117,
    "end": 72.609,
    "duration": 4.492
  },
  {
    "id": 19,
    "text": "在狂饮痛饮之中，依然满怀 “天生我材必有用，",
    "start": 72.609,
    "end": 76.105,
    "duration": 3.496
  },
  {
    "id": 20,
    "text": "千金散尽还复来” 的豪迈自信。",
    "start": 76.105,
    "end": 78.303,
    "duration": 2.198
  },
  {
    "id": 21,
    "text": "李白将道家的神仙求索、",
    "start": 78.303,
    "end": 81.107,
    "duration": 2.804
  },
  {
    "id": 22,
    "text": "纵横家的建功立业与儒家的济世抱负融为一体；",
    "start": 81.107,
    "end": 85.904,
    "duration": 4.797
  },
  {
    "id": 23,
    "text": "这种强烈的自我确信与英雄气概，正是盛唐士人昂扬奋进、",
    "start": 85.904,
    "end": 91.149,
    "duration": 5.245
  },
  {
    "id": 24,
    "text": "开阔自信时代脉搏的最高艺术凝结。",
    "start": 91.149,
    "end": 95.9,
    "duration": 4.751
  },
  {
    "id": 25,
    "text": "第二，展开吞吐宇宙的奇幻想象与宏大夸张，",
    "start": 95.9,
    "end": 99.173,
    "duration": 3.273
  },
  {
    "id": 26,
    "text": "构筑雄奇壮伟的意境空间。",
    "start": 99.173,
    "end": 101.173,
    "duration": 2.0
  },
  {
    "id": 27,
    "text": "在艺术表现上，",
    "start": 101.173,
    "end": 102.527,
    "duration": 1.354
  },
  {
    "id": 28,
    "text": "李白善于运用极其大胆的夸张与变幻莫测的时空想象，",
    "start": 102.527,
    "end": 107.809,
    "duration": 5.282
  },
  {
    "id": 29,
    "text": "营造飞腾奇崛的审美境界。",
    "start": 107.809,
    "end": 110.72,
    "duration": 2.911
  },
  {
    "id": 30,
    "text": "他常常突破人间现实的物理边界，自由驱遣神话传说与日月星辰。",
    "start": 110.72,
    "end": 115.984,
    "duration": 5.264
  },
  {
    "id": 31,
    "text": "在 《梦游天姥吟留别》 中，以 “天姥连天向天横，",
    "start": 115.984,
    "end": 121.09,
    "duration": 5.106
  },
  {
    "id": 32,
    "text": "势拔五岳掩赤城” 的宏阔巨笔开篇，随即展开青冥浩荡、",
    "start": 121.09,
    "end": 125.204,
    "duration": 4.114
  },
  {
    "id": 33,
    "text": "神仙列坐的绚烂幻境；在 《蜀道难》 中，",
    "start": 125.204,
    "end": 128.498,
    "duration": 3.294
  },
  {
    "id": 34,
    "text": "以 “上有六龙回日之高标，",
    "start": 128.498,
    "end": 131.52,
    "duration": 3.022
  },
  {
    "id": 35,
    "text": "下有冲波逆折之回川” 的极致夸张，",
    "start": 131.52,
    "end": 135.393,
    "duration": 3.873
  },
  {
    "id": 36,
    "text": "将自然险阻升华为一种令人战栗的壮美奇观；",
    "start": 135.393,
    "end": 139.241,
    "duration": 3.848
  },
  {
    "id": 37,
    "text": "他写愁思为 “白发三千丈”，",
    "start": 139.241,
    "end": 141.245,
    "duration": 2.004
  },
  {
    "id": 38,
    "text": "写飞瀑为 “疑是银河落九天”。",
    "start": 141.245,
    "end": 143.39,
    "duration": 2.145
  },
  {
    "id": 39,
    "text": "这种汪洋恣肆的浪漫想象，",
    "start": 143.39,
    "end": 145.67,
    "duration": 2.28
  },
  {
    "id": 40,
    "text": "展现出不可羁绊的才情与蓬勃的盛唐艺术魄力。",
    "start": 145.67,
    "end": 150.278,
    "duration": 4.608
  },
  {
    "id": 41,
    "text": "第三，打破近体声律拘牵，以长短歌行与古题乐府开辟抒情长河。",
    "start": 150.278,
    "end": 157.054,
    "duration": 6.776
  },
  {
    "id": 42,
    "text": "李白并不热衷于齐梁沈宋以来讲究粘对对仗的近体律诗，",
    "start": 157.054,
    "end": 161.417,
    "duration": 4.363
  },
  {
    "id": 43,
    "text": "而是将主要创造力倾注于抒情空间更为自由的古题乐府与古体歌行。",
    "start": 161.417,
    "end": 168.474,
    "duration": 7.057
  },
  {
    "id": 44,
    "text": "他继承汉魏乐府精神，借古题以抒写当代豪情。",
    "start": 168.474,
    "end": 172.227,
    "duration": 3.753
  },
  {
    "id": 45,
    "text": "《将进酒》《行路难》 等篇章，句式由三言、五言、",
    "start": 172.227,
    "end": 175.142,
    "duration": 2.915
  },
  {
    "id": 46,
    "text": "七言直至杂言自由变换，如大河奔涌、一泻千里；",
    "start": 175.142,
    "end": 179.436,
    "duration": 4.294
  },
  {
    "id": 47,
    "text": "其诗歌节奏随情感起伏而骤起骤落，",
    "start": 179.436,
    "end": 183.764,
    "duration": 4.328
  },
  {
    "id": 48,
    "text": "完全打破了音律的死板节拍，呈现出天马行空、",
    "start": 183.764,
    "end": 187.364,
    "duration": 3.6
  },
  {
    "id": 49,
    "text": "行云流水的纯自然之美，实践了其倡导的 “清水出芙蓉，",
    "start": 187.364,
    "end": 191.515,
    "duration": 4.151
  },
  {
    "id": 50,
    "text": "天然去雕饰” 的至高美学追求。",
    "start": 191.515,
    "end": 195.285,
    "duration": 3.77
  },
  {
    "id": 51,
    "text": "第四，创造兼备豪放与清新的双重美学品格，",
    "start": 195.285,
    "end": 199.085,
    "duration": 3.8
  },
  {
    "id": 52,
    "text": "确立古典浪漫主义的万代宗师地位。",
    "start": 199.085,
    "end": 203.058,
    "duration": 3.973
  },
  {
    "id": 53,
    "text": "李白之诗绝非仅有豪放狂飙，其诗风同样兼备空灵澄澈的清新俊逸。",
    "start": 203.058,
    "end": 209.444,
    "duration": 6.386
  },
  {
    "id": 54,
    "text": "在七言绝句中，他以炉火纯青的天然之笔，",
    "start": 209.444,
    "end": 213.069,
    "duration": 3.625
  },
  {
    "id": 55,
    "text": "写下 《早发白帝城》 的轻舟顺流与 《望庐山瀑布》 的紫烟日照；",
    "start": 213.069,
    "end": 218.857,
    "duration": 5.788
  },
  {
    "id": 56,
    "text": "在五言古诗中，写下 《静夜思》 的纯净真挚。",
    "start": 218.857,
    "end": 222.572,
    "duration": 3.715
  },
  {
    "id": 57,
    "text": "李白将豪迈奔放与清新飘逸圆融统一，",
    "start": 222.572,
    "end": 226.113,
    "duration": 3.541
  },
  {
    "id": 58,
    "text": "与杜甫的沉郁顿挫双峰并峙，",
    "start": 226.113,
    "end": 228.911,
    "duration": 2.798
  },
  {
    "id": 59,
    "text": "共同确立了唐代诗歌无可逾越的双子星座，",
    "start": 228.911,
    "end": 232.693,
    "duration": 3.782
  },
  {
    "id": 60,
    "text": "成为后世历代浪漫主义诗人的精神航标。",
    "start": 232.693,
    "end": 235.872,
    "duration": 3.179
  }
]