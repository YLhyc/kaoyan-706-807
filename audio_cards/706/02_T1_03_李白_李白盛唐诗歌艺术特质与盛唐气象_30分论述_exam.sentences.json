[
  {
    "id": 1,
    "text": "试论李白诗歌的艺术特质与盛唐气象。",
    "start": 0.134,
    "end": 2.906,
    "duration": 2.772
  },
  {
    "id": 2,
    "text": "李白是中国古典诗歌浪漫主义传统的杰出代表，也是“盛唐气象”最鲜明的人格化身。",
    "start": 3.583,
    "end": 9.755,
    "duration": 6.172
  },
  {
    "id": 3,
    "text": "身处开元、天宝年间国力鼎盛的历史时期，李白承接时代开放自信、昂扬奋进的精神风貌，",
    "start": 10.433,
    "end": 17.645,
    "duration": 7.212
  },
  {
    "id": 4,
    "text": "以独立不羁的人格风骨与奔放才情，将盛唐诗歌的浪漫之美推向高峰。",
    "start": 18.024,
    "end": 23.636,
    "duration": 5.612
  },
  {
    "id": 5,
    "text": "杜甫赞其“笔落惊风雨，诗成泣鬼神”，韩愈亦赞“李杜文章在，光焰万丈长”。",
    "start": 24.354,
    "end": 30.126,
    "duration": 5.772
  },
  {
    "id": 6,
    "text": "李白诗歌正是盛唐时代精神的集中审美体现，其艺术特质主要体现在以下四个方面：",
    "start": 30.844,
    "end": 41.776,
    "duration": 10.932
  },
  {
    "id": 7,
    "text": "第一，塑造追求精神自由的主体人格，彰显傲岸自信的时代气象。",
    "start": 42.534,
    "end": 49.306,
    "duration": 6.772
  },
  {
    "id": 8,
    "text": "李白诗歌最震撼人心的力量，在于塑造了一个傲立王侯、追求自由人生的抒情主人公形象。",
    "start": 49.984,
    "end": 55.356,
    "duration": 5.372
  },
  {
    "id": 9,
    "text": "在权贵面前，他昂然宣告“安能摧眉折腰事权贵，使我不得开心颜”；",
    "start": 56.074,
    "end": 57.206,
    "duration": 1.132
  },
  {
    "id": 10,
    "text": "面对仕途坎坷，他依然坚信“长风破浪会有时，直挂云帆济沧海”；",
    "start": 57.735,
    "end": 60.147,
    "duration": 2.412
  },
  {
    "id": 11,
    "text": "在酒酣放歌之中，仍怀“天生我材必有用，千金散尽还复来”的豪迈自信。",
    "start": 60.676,
    "end": 62.128,
    "duration": 1.452
  },
  {
    "id": 12,
    "text": "李白把道家的超脱求索、纵横家的济世雄心与侠义精神融为一体；",
    "start": 62.806,
    "end": 66.058,
    "duration": 3.252
  },
  {
    "id": 13,
    "text": "这种强烈的自我确信与豪迈气概，正是盛唐士人蓬勃向上、自信进取时代脉搏的生动凝结。",
    "start": 66.587,
    "end": 68.959,
    "duration": 2.372
  },
  {
    "id": 14,
    "text": "第二，展开奇幻莫测的想象与大胆夸张，构筑雄奇壮伟的意境空间。",
    "start": 69.597,
    "end": 75.009,
    "duration": 5.412
  },
  {
    "id": 15,
    "text": "在艺术表现上，李白善于运用大胆的夸张与发想无端的奇特想象，营造变幻莫测的审美境界。",
    "start": 75.647,
    "end": 82.859,
    "duration": 7.212
  },
  {
    "id": 16,
    "text": "他常常突破现实物象的物理边界，自由驱遣神话传说与日月星辰。",
    "start": 83.537,
    "end": 100.995,
    "duration": 17.458
  },
  {
    "id": 17,
    "text": "在《梦游天姥吟留别》中，开篇以“天姥连天向天横，势拔五岳掩赤城”蓄势，",
    "start": 101.524,
    "end": 107.416,
    "duration": 5.892
  },
  {
    "id": 18,
    "text": "随即展开青冥浩荡、仙人列坐的绚烂幻境；",
    "start": 107.795,
    "end": 111.327,
    "duration": 3.532
  },
  {
    "id": 19,
    "text": "在《蜀道难》中，以“上有六龙回日之高标，下有冲波逆折之回川”的雄奇夸张，",
    "start": 111.856,
    "end": 117.868,
    "duration": 6.012
  },
  {
    "id": 20,
    "text": "将山川险阻化为令人惊心动魄的壮观奇景；",
    "start": 118.247,
    "end": 121.859,
    "duration": 3.612
  },
  {
    "id": 21,
    "text": "他写愁思为“白发三千丈”，写飞瀑为“疑是银河落九天”。",
    "start": 122.388,
    "end": 127.0,
    "duration": 4.612
  },
  {
    "id": 22,
    "text": "这种纵横驰骋的浪漫想象，充分展露出其奔放才情与盛唐诗歌的阳刚魄力。",
    "start": 127.529,
    "end": 133.381,
    "duration": 5.852
  },
  {
    "id": 23,
    "text": "第三，突破近体声律羁绊，以古题乐府与杂言歌行纵情抒怀。",
    "start": 134.059,
    "end": 138.951,
    "duration": 4.892
  },
  {
    "id": 24,
    "text": "李白并不拘泥于声律严整、讲究粘对的近体律诗，",
    "start": 139.669,
    "end": 143.241,
    "duration": 3.572
  },
  {
    "id": 25,
    "text": "而是将主要才力倾注于抒情空间更为自由的古题乐府与长篇歌行。",
    "start": 143.62,
    "end": 148.592,
    "duration": 4.972
  },
  {
    "id": 26,
    "text": "他继承汉魏乐府精神，借古题以抒写己怀，如《将进酒》《行路难》等篇，",
    "start": 149.31,
    "end": 155.122,
    "duration": 5.812
  },
  {
    "id": 27,
    "text": "句式由三言、五言、七言直至杂言参差错落，如大河奔涌、一泻千里；",
    "start": 155.501,
    "end": 161.113,
    "duration": 5.612
  },
  {
    "id": 28,
    "text": "其诗节奏随情感起伏而大开大合，打破了格律的整齐节拍，",
    "start": 161.751,
    "end": 166.323,
    "duration": 4.572
  },
  {
    "id": 29,
    "text": "呈现出天马行空、行云流水的天然风貌，生动践行了“清水出芙蓉，天然去雕饰”的美学追求。",
    "start": 166.702,
    "end": 173.994,
    "duration": 7.292
  },
  {
    "id": 30,
    "text": "第四，兼备豪迈奔放与清新俊逸双重风神，树立古典浪漫主义典范。",
    "start": 174.712,
    "end": 179.764,
    "duration": 5.052
  },
  {
    "id": 31,
    "text": "李白诗歌不仅雄奇豪放，同样兼备空灵明净的清新俊逸，尤集中于五、七言绝句之中。",
    "start": 180.442,
    "end": 187.534,
    "duration": 7.092
  },
  {
    "id": 32,
    "text": "他以自然天成之笔，在七言绝句中写下《早发白帝城》的轻舟顺流与《望庐山瀑布》的紫烟飞瀑，",
    "start": 188.212,
    "end": 195.224,
    "duration": 7.012
  },
  {
    "id": 33,
    "text": "在五言绝句中写下《静夜思》的明快真挚，",
    "start": 195.611,
    "end": 198.543,
    "duration": 2.932
  },
  {
    "id": 34,
    "text": "正如胡应麟《诗薮》所称“太白五七言绝，字字神境，篇篇神物”。",
    "start": 198.922,
    "end": 204.134,
    "duration": 5.212
  },
  {
    "id": 35,
    "text": "李白将豪迈飘逸与清新明丽圆融统一，与杜甫的沉郁顿挫双峰并峙，",
    "start": 204.833,
    "end": 210.045,
    "duration": 5.212
  },
  {
    "id": 36,
    "text": "成为后代浪漫主义诗人仰慕与追随的不朽典范。",
    "start": 210.424,
    "end": 213.956,
    "duration": 3.532
  },
  {
    "id": 37,
    "text": "合而观之，李白以其不羁的布衣傲骨、飞动雄奇的浪漫想象与纵横开阖的歌行乐府，",
    "start": 214.634,
    "end": 221.326,
    "duration": 6.692
  },
  {
    "id": 38,
    "text": "把盛唐气象化为极具个人神采的诗美风貌。",
    "start": 221.705,
    "end": 224.957,
    "duration": 3.252
  },
  {
    "id": 39,
    "text": "他既能在古体长歌中纵情驰骋，又能以自然明丽、浑然天成的五七言绝句独擅神境，与杜甫双峰并峙，",
    "start": 225.486,
    "end": 233.698,
    "duration": 8.212
  },
  {
    "id": 40,
    "text": "共同开拓了中国古典诗歌抒情自由与个性张扬的广阔天地。",
    "start": 234.077,
    "end": 238.369,
    "duration": 4.292
  }
]