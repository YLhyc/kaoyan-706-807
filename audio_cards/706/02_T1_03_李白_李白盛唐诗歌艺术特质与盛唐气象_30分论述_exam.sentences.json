[
  {
    "id": 1,
    "text": "试论李白诗歌的艺术特质与盛唐气象。",
    "start": 0.079,
    "end": 3.532,
    "duration": 3.453
  },
  {
    "id": 2,
    "text": "李白是中国古典诗歌浪漫主义传统的最高巅峰，",
    "start": 3.805,
    "end": 7.518,
    "duration": 3.713
  },
  {
    "id": 3,
    "text": "也是 “盛唐气象” 最杰出的艺术人格代表。",
    "start": 7.923,
    "end": 10.95,
    "duration": 3.027
  },
  {
    "id": 4,
    "text": "身处开元天宝大唐国力极盛的历史节点，",
    "start": 11.306,
    "end": 14.627,
    "duration": 3.321
  },
  {
    "id": 5,
    "text": "李白承接了时代自信开放、昂扬开拓的精神底色，",
    "start": 14.931,
    "end": 18.656,
    "duration": 3.725
  },
  {
    "id": 6,
    "text": "以追求精神绝对自由的崇高傲骨，",
    "start": 18.822,
    "end": 21.398,
    "duration": 2.576
  },
  {
    "id": 7,
    "text": "将盛唐诗歌推向了飞扬奇伟的艺术极境。",
    "start": 21.652,
    "end": 25.049,
    "duration": 3.397
  },
  {
    "id": 8,
    "text": "韩愈赞其 “李杜文章在，光焰万丈长”；",
    "start": 25.285,
    "end": 28.77,
    "duration": 3.485
  },
  {
    "id": 9,
    "text": "严羽 《沧浪诗话》 称其 “如羚羊挂角，无迹可求”。",
    "start": 29.023,
    "end": 32.916,
    "duration": 3.893
  },
  {
    "id": 10,
    "text": "李白诗歌绝非孤立的书生吟咏，而是盛唐时代精神的集中审美体现。",
    "start": 33.218,
    "end": 38.672,
    "duration": 5.454
  },
  {
    "id": 11,
    "text": "其艺术特质主要展现为以下四个核心维度：",
    "start": 38.871,
    "end": 42.434,
    "duration": 3.563
  },
  {
    "id": 12,
    "text": "第一，标举追求精神自由的主体人格，",
    "start": 42.596,
    "end": 45.435,
    "duration": 2.839
  },
  {
    "id": 13,
    "text": "集中体现傲岸自信的时代气象。",
    "start": 45.574,
    "end": 47.995,
    "duration": 2.421
  },
  {
    "id": 14,
    "text": "李白诗歌最震撼人心的力量，在于塑造了一个傲立王侯、",
    "start": 48.177,
    "end": 52.62,
    "duration": 4.443
  },
  {
    "id": 15,
    "text": "追求绝对精神解放的抒情主人公形象。",
    "start": 52.661,
    "end": 55.617,
    "duration": 2.956
  },
  {
    "id": 16,
    "text": "在政治权贵面前，他傲岸宣告 “安能摧眉折腰事权贵，",
    "start": 55.745,
    "end": 60.528,
    "duration": 4.783
  },
  {
    "id": 17,
    "text": "使我不得开心颜”；面对仕途坎坷，",
    "start": 60.528,
    "end": 63.294,
    "duration": 2.766
  },
  {
    "id": 18,
    "text": "他始终坚信 “长风破浪会有时，直挂云帆济沧海”；",
    "start": 63.348,
    "end": 67.909,
    "duration": 4.561
  },
  {
    "id": 19,
    "text": "在狂饮痛饮之中，依然满怀 “天生我材必有用，",
    "start": 68.107,
    "end": 72.726,
    "duration": 4.619
  },
  {
    "id": 20,
    "text": "千金散尽还复来” 的豪迈自信。",
    "start": 72.726,
    "end": 75.531,
    "duration": 2.805
  },
  {
    "id": 21,
    "text": "李白将道家的神仙求索、",
    "start": 76.094,
    "end": 78.077,
    "duration": 1.983
  },
  {
    "id": 22,
    "text": "纵横家的建功立业与儒家的济世抱负融为一体；",
    "start": 78.293,
    "end": 82.276,
    "duration": 3.983
  },
  {
    "id": 23,
    "text": "这种强烈的自我确信与英雄气概，正是盛唐士人昂扬奋进、",
    "start": 82.63,
    "end": 87.933,
    "duration": 5.303
  },
  {
    "id": 24,
    "text": "开阔自信时代脉搏的最高艺术凝结。",
    "start": 88.006,
    "end": 90.91,
    "duration": 2.904
  },
  {
    "id": 25,
    "text": "第二，展开吞吐宇宙的奇幻想象与宏大夸张，",
    "start": 91.139,
    "end": 95.842,
    "duration": 4.703
  },
  {
    "id": 26,
    "text": "构筑雄奇壮伟的意境空间。",
    "start": 95.89,
    "end": 98.216,
    "duration": 2.326
  },
  {
    "id": 27,
    "text": "在艺术表现上，",
    "start": 99.033,
    "end": 100.162,
    "duration": 1.129
  },
  {
    "id": 28,
    "text": "李白善于运用极其大胆的夸张与变幻莫测的时空想象，",
    "start": 100.442,
    "end": 105.031,
    "duration": 4.589
  },
  {
    "id": 29,
    "text": "营造飞腾奇崛的审美境界。",
    "start": 105.095,
    "end": 107.188,
    "duration": 2.093
  },
  {
    "id": 30,
    "text": "他常常突破人间现实的物理边界，自由驱遣神话传说与日月星辰。",
    "start": 107.797,
    "end": 113.554,
    "duration": 5.757
  },
  {
    "id": 31,
    "text": "在 《梦游天姥吟留别》 中，以 “天姥连天向天横，",
    "start": 113.788,
    "end": 117.857,
    "duration": 4.069
  },
  {
    "id": 32,
    "text": "势拔五岳掩赤城” 的宏阔巨笔开篇，随即展开青冥浩荡、",
    "start": 117.91,
    "end": 122.91,
    "duration": 5.0
  },
  {
    "id": 33,
    "text": "神仙列坐的绚烂幻境；在 《蜀道难》 中，",
    "start": 123.097,
    "end": 126.097,
    "duration": 3.0
  },
  {
    "id": 34,
    "text": "以 “上有六龙回日之高标，",
    "start": 126.394,
    "end": 128.269,
    "duration": 1.875
  },
  {
    "id": 35,
    "text": "下有冲波逆折之回川” 的极致夸张，",
    "start": 128.486,
    "end": 131.178,
    "duration": 2.692
  },
  {
    "id": 36,
    "text": "将自然险阻升华为一种令人战栗的壮美奇观；",
    "start": 131.508,
    "end": 135.151,
    "duration": 3.643
  },
  {
    "id": 37,
    "text": "他写愁思为 “白发三千丈”，",
    "start": 135.382,
    "end": 137.845,
    "duration": 2.463
  },
  {
    "id": 38,
    "text": "写飞瀑为 “疑是银河落九天”。",
    "start": 138.054,
    "end": 140.954,
    "duration": 2.9
  },
  {
    "id": 39,
    "text": "这种汪洋恣肆的浪漫想象，",
    "start": 141.235,
    "end": 143.098,
    "duration": 1.863
  },
  {
    "id": 40,
    "text": "展现出不可羁绊的才情与蓬勃的盛唐艺术魄力。",
    "start": 143.371,
    "end": 147.373,
    "duration": 4.002
  },
  {
    "id": 41,
    "text": "第三，打破近体声律拘牵，以长短歌行与古题乐府开辟抒情长河。",
    "start": 147.727,
    "end": 153.882,
    "duration": 6.155
  },
  {
    "id": 42,
    "text": "李白并不热衷于齐梁沈宋以来讲究粘对对仗的近体律诗，",
    "start": 154.155,
    "end": 159.213,
    "duration": 5.058
  },
  {
    "id": 43,
    "text": "而是将主要创造力倾注于抒情空间更为自由的古题乐府与古体歌行。",
    "start": 159.444,
    "end": 166.009,
    "duration": 6.565
  },
  {
    "id": 44,
    "text": "他继承汉魏乐府精神，借古题以抒写当代豪情。",
    "start": 166.497,
    "end": 170.881,
    "duration": 4.384
  },
  {
    "id": 45,
    "text": "《将进酒》《行路难》 等篇章，句式由三言、五言、",
    "start": 171.32,
    "end": 175.68,
    "duration": 4.36
  },
  {
    "id": 46,
    "text": "七言直至杂言自由变换，如大河奔涌、一泻千里；",
    "start": 175.68,
    "end": 180.198,
    "duration": 4.518
  },
  {
    "id": 47,
    "text": "其诗歌节奏随情感起伏而骤起骤落，",
    "start": 180.393,
    "end": 183.408,
    "duration": 3.015
  },
  {
    "id": 48,
    "text": "完全打破了音律的死板节拍，呈现出天马行空、",
    "start": 183.576,
    "end": 187.587,
    "duration": 4.011
  },
  {
    "id": 49,
    "text": "行云流水的纯自然之美，实践了其倡导的 “清水出芙蓉，",
    "start": 187.587,
    "end": 192.66,
    "duration": 5.073
  },
  {
    "id": 50,
    "text": "天然去雕饰” 的至高美学追求。",
    "start": 192.66,
    "end": 194.851,
    "duration": 2.191
  },
  {
    "id": 51,
    "text": "第四，创造兼备豪放与清新的双重美学品格，",
    "start": 195.271,
    "end": 199.25,
    "duration": 3.979
  },
  {
    "id": 52,
    "text": "确立古典浪漫主义的万代宗师地位。",
    "start": 199.287,
    "end": 201.879,
    "duration": 2.592
  },
  {
    "id": 53,
    "text": "李白之诗绝非仅有豪放狂飙，其诗风同样兼备空灵澄澈的清新俊逸。",
    "start": 202.075,
    "end": 208.644,
    "duration": 6.569
  },
  {
    "id": 54,
    "text": "在七言绝句中，他以炉火纯青的天然之笔，",
    "start": 209.432,
    "end": 212.807,
    "duration": 3.375
  },
  {
    "id": 55,
    "text": "写下 《早发白帝城》 的轻舟顺流与 《望庐山瀑布》 的紫烟日照；",
    "start": 213.057,
    "end": 218.192,
    "duration": 5.135
  },
  {
    "id": 56,
    "text": "在五言古诗中，写下 《静夜思》 的纯净真挚。",
    "start": 218.846,
    "end": 222.313,
    "duration": 3.467
  },
  {
    "id": 57,
    "text": "李白将豪迈奔放与清新飘逸圆融统一，",
    "start": 222.561,
    "end": 225.936,
    "duration": 3.375
  },
  {
    "id": 58,
    "text": "与杜甫的沉郁顿挫双峰并峙，",
    "start": 226.103,
    "end": 228.64,
    "duration": 2.537
  },
  {
    "id": 59,
    "text": "共同确立了唐代诗歌无可逾越的双子星座，",
    "start": 228.901,
    "end": 232.432,
    "duration": 3.531
  },
  {
    "id": 60,
    "text": "成为后世历代浪漫主义诗人的精神航标。",
    "start": 232.683,
    "end": 235.872,
    "duration": 3.189
  }
]
