[
  {
    "id": "sent_1",
    "text": "李白是中国古典诗歌浪漫主义传统的最高巅峰，",
    "start": 0.1,
    "end": 4.477,
    "duration": 4.377
  },
  {
    "id": "sent_2",
    "text": "也是 “盛唐气象” 最杰出的艺术人格代表。",
    "start": 4.427,
    "end": 8.138,
    "duration": 3.711
  },
  {
    "id": "sent_3",
    "text": "身处开元天宝大唐国力极盛的历史节点，",
    "start": 8.138,
    "end": 12.018,
    "duration": 3.88
  },
  {
    "id": "sent_4",
    "text": "李白承接了时代自信开放、昂扬开拓的精神底色，",
    "start": 12.018,
    "end": 16.823,
    "duration": 4.805
  },
  {
    "id": "sent_5",
    "text": "以追求精神绝对自由的崇高傲骨，",
    "start": 16.823,
    "end": 20.117,
    "duration": 3.294
  },
  {
    "id": "sent_6",
    "text": "将盛唐诗歌推向了飞扬奇伟的艺术极境。",
    "start": 20.117,
    "end": 24.179,
    "duration": 4.062
  },
  {
    "id": "sent_7",
    "text": "韩愈赞其 “李杜文章在，光焰万丈长”；",
    "start": 24.18,
    "end": 27.852,
    "duration": 3.672
  },
  {
    "id": "sent_8",
    "text": "严羽 《沧浪诗话》 称其 “如羚羊挂角，无迹可求”。",
    "start": 27.852,
    "end": 32.37,
    "duration": 4.518
  },
  {
    "id": "sent_9",
    "text": "李白诗歌绝非孤立的书生吟咏，而是盛唐时代精神的集中审美体现。",
    "start": 32.37,
    "end": 38.802,
    "duration": 6.432
  },
  {
    "id": "sent_10",
    "text": "其艺术特质主要展现为以下四个核心维度：",
    "start": 38.802,
    "end": 43.125,
    "duration": 4.323
  },
  {
    "id": "sent_11",
    "text": "第一，标举追求精神自由的主体人格，集中体现傲岸自信的时代气象。",
    "start": 43.125,
    "end": 49.492,
    "duration": 6.367
  },
  {
    "id": "sent_12",
    "text": "李白诗歌最震撼人心的力量，",
    "start": 49.492,
    "end": 52.422,
    "duration": 2.93
  },
  {
    "id": "sent_13",
    "text": "在于塑造了一个傲立王侯、追求绝对精神解放的抒情主人公形象。",
    "start": 52.422,
    "end": 58.386,
    "duration": 5.964
  },
  {
    "id": "sent_14",
    "text": "在政治权贵面前，他傲岸宣告 “安能摧眉折腰事权贵，",
    "start": 58.385,
    "end": 63.502,
    "duration": 5.117
  },
  {
    "id": "sent_15",
    "text": "使我不得开心颜”；",
    "start": 63.503,
    "end": 65.508,
    "duration": 2.005
  },
  {
    "id": "sent_16",
    "text": "面对仕途坎坷，他始终坚信 “长风破浪会有时，直挂云帆济沧海”；",
    "start": 65.508,
    "end": 71.706,
    "duration": 6.198
  },
  {
    "id": "sent_17",
    "text": "在狂饮痛饮之中，依然满怀 “天生我材必有用，",
    "start": 71.706,
    "end": 76.315,
    "duration": 4.609
  },
  {
    "id": "sent_18",
    "text": "千金散尽还复来” 的豪迈自信。",
    "start": 76.315,
    "end": 79.388,
    "duration": 3.073
  },
  {
    "id": "sent_19",
    "text": "李白将道家的神仙求索、纵横家的建功立业与儒家的济世抱负融为一体；",
    "start": 79.388,
    "end": 86.328,
    "duration": 6.94
  },
  {
    "id": "sent_20",
    "text": "这种强烈的自我确信与英雄气概，",
    "start": 86.328,
    "end": 89.961,
    "duration": 3.633
  },
  {
    "id": "sent_21",
    "text": "正是盛唐士人昂扬奋进、开阔自信时代脉搏的最高艺术凝结。",
    "start": 89.961,
    "end": 96.133,
    "duration": 6.172
  },
  {
    "id": "sent_22",
    "text": "第二，展开吞吐宇宙的奇幻想象与宏大夸张，构筑雄奇壮伟的意境空间。",
    "start": 96.133,
    "end": 103.19,
    "duration": 7.057
  },
  {
    "id": "sent_23",
    "text": "在艺术表现上，李白善于运用极其大胆的夸张与变幻莫测的时空想象，",
    "start": 103.19,
    "end": 109.779,
    "duration": 6.589
  },
  {
    "id": "sent_24",
    "text": "营造飞腾奇崛的审美境界。",
    "start": 109.779,
    "end": 112.631,
    "duration": 2.852
  },
  {
    "id": "sent_25",
    "text": "他常常突破人间现实的物理边界，自由驱遣神话传说与日月星辰。",
    "start": 112.63,
    "end": 118.945,
    "duration": 6.315
  },
  {
    "id": "sent_26",
    "text": "在 《梦游天姥吟留别》 中，以 “天姥连天向天横，",
    "start": 118.945,
    "end": 123.268,
    "duration": 4.323
  },
  {
    "id": "sent_27",
    "text": "势拔五岳掩赤城” 的宏阔巨笔开篇，",
    "start": 123.268,
    "end": 126.588,
    "duration": 3.32
  },
  {
    "id": "sent_28",
    "text": "随即展开青冥浩荡、神仙列坐的绚烂幻境；",
    "start": 126.589,
    "end": 130.938,
    "duration": 4.349
  },
  {
    "id": "sent_29",
    "text": "在 《蜀道难》 中，以 “上有六龙回日之高标，",
    "start": 130.938,
    "end": 134.831,
    "duration": 3.893
  },
  {
    "id": "sent_30",
    "text": "下有冲波逆折之回川” 的极致夸张，",
    "start": 134.831,
    "end": 138.177,
    "duration": 3.346
  },
  {
    "id": "sent_31",
    "text": "将自然险阻升华为一种令人战栗的壮美奇观；",
    "start": 138.177,
    "end": 142.734,
    "duration": 4.557
  },
  {
    "id": "sent_32",
    "text": "他写愁思为 “白发三千丈”，写飞瀑为 “疑是银河落九天”。",
    "start": 142.734,
    "end": 148.268,
    "duration": 5.534
  },
  {
    "id": "sent_33",
    "text": "这种汪洋恣肆的浪漫想象，",
    "start": 148.268,
    "end": 151.172,
    "duration": 2.904
  },
  {
    "id": "sent_34",
    "text": "展现出不可羁绊的才情与蓬勃的盛唐艺术魄力。",
    "start": 151.172,
    "end": 155.638,
    "duration": 4.466
  },
  {
    "id": "sent_35",
    "text": "第三，打破近体声律拘牵，以长短歌行与古题乐府开辟抒情长河。",
    "start": 155.638,
    "end": 162.422,
    "duration": 6.784
  },
  {
    "id": "sent_36",
    "text": "李白并不热衷于齐梁沈宋以来讲究粘对对仗的近体律诗，",
    "start": 162.422,
    "end": 167.565,
    "duration": 5.143
  },
  {
    "id": "sent_37",
    "text": "而是将主要创造力倾注于抒情空间更为自由的古题乐府与古体歌行。",
    "start": 167.565,
    "end": 174.296,
    "duration": 6.731
  },
  {
    "id": "sent_38",
    "text": "他继承汉魏乐府精神，借古题以抒写当代豪情。",
    "start": 174.296,
    "end": 179.283,
    "duration": 4.987
  },
  {
    "id": "sent_39",
    "text": "《将进酒》《行路难》 等篇章，",
    "start": 179.283,
    "end": 181.875,
    "duration": 2.592
  },
  {
    "id": "sent_40",
    "text": "句式由三言、五言、七言直至杂言自由变换，如大河奔涌、一泻千里；",
    "start": 181.875,
    "end": 188.971,
    "duration": 7.096
  },
  {
    "id": "sent_41",
    "text": "其诗歌节奏随情感起伏而骤起骤落，完全打破了音律的死板节拍，",
    "start": 188.971,
    "end": 195.195,
    "duration": 6.224
  },
  {
    "id": "sent_42",
    "text": "呈现出天马行空、行云流水的纯自然之美，",
    "start": 195.195,
    "end": 199.401,
    "duration": 4.206
  },
  {
    "id": "sent_43",
    "text": "实践了其倡导的 “清水出芙蓉，天然去雕饰” 的至高美学追求。",
    "start": 199.401,
    "end": 205.091,
    "duration": 5.69
  },
  {
    "id": "sent_44",
    "text": "第四，创造兼备豪放与清新的双重美学品格，",
    "start": 205.091,
    "end": 209.583,
    "duration": 4.492
  },
  {
    "id": "sent_45",
    "text": "确立古典浪漫主义的万代宗师地位。",
    "start": 209.583,
    "end": 213.06,
    "duration": 3.477
  },
  {
    "id": "sent_46",
    "text": "李白之诗绝非仅有豪放狂飙，其诗风同样兼备空灵澄澈的清新俊逸。",
    "start": 213.06,
    "end": 219.675,
    "duration": 6.615
  },
  {
    "id": "sent_47",
    "text": "在七言绝句中，他以炉火纯青的天然之笔，",
    "start": 219.674,
    "end": 223.802,
    "duration": 4.128
  },
  {
    "id": "sent_48",
    "text": "写下 《早发白帝城》 的轻舟顺流与 《望庐山瀑布》 的紫烟日照；",
    "start": 223.802,
    "end": 229.167,
    "duration": 5.365
  },
  {
    "id": "sent_49",
    "text": "在五言古诗中，写下 《静夜思》 的纯净真挚。",
    "start": 229.167,
    "end": 233.047,
    "duration": 3.88
  },
  {
    "id": "sent_50",
    "text": "李白将豪迈奔放与清新飘逸圆融统一，与杜甫的沉郁顿挫双峰并峙，",
    "start": 233.047,
    "end": 239.974,
    "duration": 6.927
  },
  {
    "id": "sent_51",
    "text": "共同确立了唐代诗歌无可逾越的双子星座，",
    "start": 239.974,
    "end": 244.153,
    "duration": 4.179
  },
  {
    "id": "sent_52",
    "text": "成为后世历代浪漫主义诗人的精神航标。",
    "start": 244.153,
    "end": 247.89,
    "duration": 3.737
  }
]