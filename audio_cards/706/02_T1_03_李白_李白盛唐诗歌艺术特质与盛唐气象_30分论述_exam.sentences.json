[
  {
    "id": "sent_1",
    "text": "李白是中国古典诗歌浪漫主义传统的最高巅峰，",
    "start": 0.0,
    "end": 3.68,
    "duration": 3.68
  },
  {
    "id": "sent_2",
    "text": "也是 “盛唐气象” 最杰出的艺术人格代表。",
    "start": 4.129,
    "end": 7.049,
    "duration": 2.92
  },
  {
    "id": "sent_3",
    "text": "身处开元天宝大唐国力极盛的历史节点，李白承接了时代自信开放、",
    "start": 7.499,
    "end": 13.139,
    "duration": 5.64
  },
  {
    "id": "sent_4",
    "text": "昂扬开拓的精神底色，以追求精神绝对自由的崇高傲骨，",
    "start": 13.589,
    "end": 18.269,
    "duration": 4.68
  },
  {
    "id": "sent_5",
    "text": "将盛唐诗歌推向了飞扬奇伟的艺术极境。",
    "start": 18.719,
    "end": 21.999,
    "duration": 3.28
  },
  {
    "id": "sent_6",
    "text": "韩愈赞其 “李杜文章在，光焰万丈长”；",
    "start": 22.529,
    "end": 25.649,
    "duration": 3.12
  },
  {
    "id": "sent_7",
    "text": "严羽 《沧浪诗话》 称其 “如羚羊挂角，无迹可求”。",
    "start": 26.099,
    "end": 29.619,
    "duration": 3.52
  },
  {
    "id": "sent_8",
    "text": "李白诗歌绝非孤立的书生吟咏，而是盛唐时代精神的集中审美体现。",
    "start": 30.229,
    "end": 35.509,
    "duration": 5.28
  },
  {
    "id": "sent_9",
    "text": "其艺术特质主要展现为以下四个核心维度：",
    "start": 35.959,
    "end": 39.559,
    "duration": 3.6
  },
  {
    "id": "sent_10",
    "text": "第一，标举追求精神自由的主体人格，",
    "start": 40.009,
    "end": 43.289,
    "duration": 3.28
  },
  {
    "id": "sent_11",
    "text": "集中体现傲岸自信的时代气象。",
    "start": 43.739,
    "end": 46.099,
    "duration": 2.36
  },
  {
    "id": "sent_12",
    "text": "李白诗歌最震撼人心的力量，在于塑造了一个傲立王侯、",
    "start": 46.549,
    "end": 50.709,
    "duration": 4.16
  },
  {
    "id": "sent_13",
    "text": "追求绝对精神解放的抒情主人公形象。",
    "start": 51.159,
    "end": 54.279,
    "duration": 3.12
  },
  {
    "id": "sent_14",
    "text": "在政治权贵面前，他傲岸宣告 “安能摧眉折腰事权贵，",
    "start": 54.729,
    "end": 58.849,
    "duration": 4.12
  },
  {
    "id": "sent_15",
    "text": "使我不得开心颜”；",
    "start": 59.299,
    "end": 60.859,
    "duration": 1.56
  },
  {
    "id": "sent_16",
    "text": "面对仕途坎坷，他始终坚信 “长风破浪会有时，",
    "start": 61.309,
    "end": 65.389,
    "duration": 4.08
  },
  {
    "id": "sent_17",
    "text": "直挂云帆济沧海”；",
    "start": 65.959,
    "end": 67.519,
    "duration": 1.56
  },
  {
    "id": "sent_18",
    "text": "在狂饮痛饮之中，依然满怀 “天生我材必有用，",
    "start": 67.969,
    "end": 71.769,
    "duration": 3.8
  },
  {
    "id": "sent_19",
    "text": "千金散尽还复来” 的豪迈自信。",
    "start": 72.219,
    "end": 74.579,
    "duration": 2.36
  },
  {
    "id": "sent_20",
    "text": "李白将道家的神仙求索、",
    "start": 75.029,
    "end": 77.229,
    "duration": 2.2
  },
  {
    "id": "sent_21",
    "text": "纵横家的建功立业与儒家的济世抱负融为一体；",
    "start": 77.679,
    "end": 81.799,
    "duration": 4.12
  },
  {
    "id": "sent_22",
    "text": "这种强烈的自我确信与英雄气概，正是盛唐士人昂扬奋进、",
    "start": 82.249,
    "end": 87.329,
    "duration": 5.08
  },
  {
    "id": "sent_23",
    "text": "开阔自信时代脉搏的最高艺术凝结。",
    "start": 87.779,
    "end": 90.499,
    "duration": 2.72
  },
  {
    "id": "sent_24",
    "text": "第二，展开吞吐宇宙的奇幻想象与宏大夸张，",
    "start": 90.949,
    "end": 94.709,
    "duration": 3.76
  },
  {
    "id": "sent_25",
    "text": "构筑雄奇壮伟的意境空间。",
    "start": 95.159,
    "end": 97.319,
    "duration": 2.16
  },
  {
    "id": "sent_26",
    "text": "在艺术表现上，",
    "start": 97.769,
    "end": 99.049,
    "duration": 1.28
  },
  {
    "id": "sent_27",
    "text": "李白善于运用极其大胆的夸张与变幻莫测的时空想象，",
    "start": 99.499,
    "end": 103.419,
    "duration": 3.92
  },
  {
    "id": "sent_28",
    "text": "营造飞腾奇崛的审美境界。",
    "start": 103.869,
    "end": 105.909,
    "duration": 2.04
  },
  {
    "id": "sent_29",
    "text": "他常常突破人间现实的物理边界，自由驱遣神话传说与日月星辰。",
    "start": 106.359,
    "end": 111.919,
    "duration": 5.56
  },
  {
    "id": "sent_30",
    "text": "在 《梦游天姥吟留别》 中，以 “天姥连天向天横，",
    "start": 112.369,
    "end": 116.369,
    "duration": 4.0
  },
  {
    "id": "sent_31",
    "text": "势拔五岳掩赤城” 的宏阔巨笔开篇，随即展开青冥浩荡、",
    "start": 116.819,
    "end": 121.659,
    "duration": 4.84
  },
  {
    "id": "sent_32",
    "text": "神仙列坐的绚烂幻境；",
    "start": 122.109,
    "end": 124.149,
    "duration": 2.04
  },
  {
    "id": "sent_33",
    "text": "在 《蜀道难》 中，以 “上有六龙回日之高标，",
    "start": 124.599,
    "end": 127.839,
    "duration": 3.24
  },
  {
    "id": "sent_34",
    "text": "下有冲波逆折之回川” 的极致夸张，",
    "start": 128.289,
    "end": 131.089,
    "duration": 2.8
  },
  {
    "id": "sent_35",
    "text": "将自然险阻升华为一种令人战栗的壮美奇观；",
    "start": 131.539,
    "end": 135.099,
    "duration": 3.56
  },
  {
    "id": "sent_36",
    "text": "他写愁思为 “白发三千丈”，写飞瀑为 “疑是银河落九天”。",
    "start": 135.549,
    "end": 140.429,
    "duration": 4.88
  },
  {
    "id": "sent_37",
    "text": "这种汪洋恣肆的浪漫想象，",
    "start": 140.879,
    "end": 142.879,
    "duration": 2.0
  },
  {
    "id": "sent_38",
    "text": "展现出不可羁绊的才情与蓬勃的盛唐艺术魄力。",
    "start": 143.329,
    "end": 147.289,
    "duration": 3.96
  },
  {
    "id": "sent_39",
    "text": "第三，打破近体声律拘牵，以长短歌行与古题乐府开辟抒情长河。",
    "start": 147.739,
    "end": 153.699,
    "duration": 5.96
  },
  {
    "id": "sent_40",
    "text": "李白并不热衷于齐梁沈宋以来讲究粘对对仗的近体律诗，",
    "start": 154.149,
    "end": 159.069,
    "duration": 4.92
  },
  {
    "id": "sent_41",
    "text": "而是将主要创造力倾注于抒情空间更为自由的古题乐府与古体歌行。",
    "start": 159.519,
    "end": 164.719,
    "duration": 5.2
  },
  {
    "id": "sent_42",
    "text": "他继承汉魏乐府精神，借古题以抒写当代豪情。",
    "start": 165.169,
    "end": 169.129,
    "duration": 3.96
  },
  {
    "id": "sent_43",
    "text": "《将进酒》《行路难》 等篇章，句式由三言、五言、",
    "start": 169.579,
    "end": 173.739,
    "duration": 4.16
  },
  {
    "id": "sent_44",
    "text": "七言直至杂言自由变换，如大河奔涌、一泻千里；",
    "start": 174.189,
    "end": 178.469,
    "duration": 4.28
  },
  {
    "id": "sent_45",
    "text": "其诗歌节奏随情感起伏而骤起骤落，完全打破了音律的死板节拍，",
    "start": 178.919,
    "end": 183.959,
    "duration": 5.04
  },
  {
    "id": "sent_46",
    "text": "呈现出天马行空、行云流水的纯自然之美，",
    "start": 184.408,
    "end": 188.088,
    "duration": 3.68
  },
  {
    "id": "sent_47",
    "text": "实践了其倡导的 “清水出芙蓉，天然去雕饰” 的至高美学追求。",
    "start": 188.538,
    "end": 193.258,
    "duration": 4.72
  },
  {
    "id": "sent_48",
    "text": "第四，创造兼备豪放与清新的双重美学品格，",
    "start": 193.708,
    "end": 197.428,
    "duration": 3.72
  },
  {
    "id": "sent_49",
    "text": "确立古典浪漫主义的万代宗师地位。",
    "start": 197.878,
    "end": 200.598,
    "duration": 2.72
  },
  {
    "id": "sent_50",
    "text": "李白之诗绝非仅有豪放狂飙，其诗风同样兼备空灵澄澈的清新俊逸。",
    "start": 201.048,
    "end": 206.728,
    "duration": 5.68
  },
  {
    "id": "sent_51",
    "text": "在七言绝句中，他以炉火纯青的天然之笔，",
    "start": 207.178,
    "end": 210.738,
    "duration": 3.56
  },
  {
    "id": "sent_52",
    "text": "写下 《早发白帝城》 的轻舟顺流与 《望庐山瀑布》 的紫烟日照；",
    "start": 211.188,
    "end": 215.588,
    "duration": 4.4
  },
  {
    "id": "sent_53",
    "text": "在五言古诗中，写下 《静夜思》 的纯净真挚。",
    "start": 216.038,
    "end": 219.398,
    "duration": 3.36
  },
  {
    "id": "sent_54",
    "text": "李白将豪迈奔放与清新飘逸圆融统一，与杜甫的沉郁顿挫双峰并峙，",
    "start": 219.848,
    "end": 225.568,
    "duration": 5.72
  },
  {
    "id": "sent_55",
    "text": "共同确立了唐代诗歌无可逾越的双子星座，",
    "start": 226.098,
    "end": 229.498,
    "duration": 3.4
  },
  {
    "id": "sent_56",
    "text": "成为后世历代浪漫主义诗人的精神航标。",
    "start": 229.948,
    "end": 232.988,
    "duration": 3.04
  }
]