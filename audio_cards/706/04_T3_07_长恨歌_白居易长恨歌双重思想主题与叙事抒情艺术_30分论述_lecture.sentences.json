[
  {
    "id": 1,
    "text": "试论白居易《长恨歌》的双重思想主题与叙事抒情艺术。",
    "start": 0.101,
    "end": 4.918,
    "duration": 4.817
  },
  {
    "id": 2,
    "text": "白居易的《长恨歌》是唐代极具影响力的长篇叙事抒情诗。",
    "start": 5.456,
    "end": 10.285,
    "duration": 4.829
  },
  {
    "id": 3,
    "text": "该诗作于唐宪宗元和元年，白居易与友人陈鸿、王质夫同游仙游寺，",
    "start": 10.703,
    "end": 16.643,
    "duration": 5.94
  },
  {
    "id": 4,
    "text": "感怀唐玄宗与杨贵妃遗事而作此诗，陈鸿随之作《长恨歌传》。",
    "start": 17.039,
    "end": 22.193,
    "duration": 5.154
  },
  {
    "id": 5,
    "text": "全诗以安史之乱前后唐王朝由盛转衰为历史背景，将帝王家国兴亡与男女生死恋情交织其中。",
    "start": 22.321,
    "end": 30.73,
    "duration": 8.409
  },
  {
    "id": 6,
    "text": "陈鸿在《长恨歌传》中点明其主旨为“意者不但感其事，亦欲惩尤物，窒乱阶，垂于将来者也”。",
    "start": 30.974,
    "end": 39.069,
    "duration": 8.095
  },
  {
    "id": 7,
    "text": "《长恨歌》的双重思想主题与叙事抒情艺术，主要体现在以下四个方面：",
    "start": 39.306,
    "end": 44.859,
    "duration": 5.553
  },
  {
    "id": 8,
    "text": "第一，兼寓讽谕荒淫误国与同情生死深情，构成复杂的双重思想意蕴。",
    "start": 45.527,
    "end": 52.449,
    "duration": 6.922
  },
  {
    "id": 9,
    "text": "《长恨歌》耐人寻味之处在于其主题的双重性。",
    "start": 53.018,
    "end": 56.21,
    "duration": 3.192
  },
  {
    "id": 10,
    "text": "诗作前半部分带有明显的政治讽谕意味，",
    "start": 56.597,
    "end": 60.284,
    "duration": 3.687
  },
  {
    "id": 11,
    "text": "借“汉皇重色思倾国，御宇多年求不得”“春宵苦短日高起，从此君王不早朝”及杨氏一门荣宠等描写，",
    "start": 60.464,
    "end": 69.359,
    "duration": 8.895
  },
  {
    "id": 12,
    "text": "婉讽唐玄宗荒废朝政、酿成安史之乱的历史教训；",
    "start": 69.694,
    "end": 73.836,
    "duration": 4.142
  },
  {
    "id": 13,
    "text": "而在马嵬事变杨贵妃缢死之后，诗意笔锋一转，",
    "start": 74.149,
    "end": 78.089,
    "duration": 3.94
  },
  {
    "id": 14,
    "text": "用大量篇幅倾情写玄宗西行还京后的刻骨思念与仙界重温盟誓，对其生死相恋寄予深切同情。",
    "start": 78.403,
    "end": 87.449,
    "duration": 9.046
  },
  {
    "id": 15,
    "text": "这种讽谕与感伤的矛盾交织，真实折射出中唐士人既反思盛世倾覆教训、又感叹世事无常的复杂心态。",
    "start": 87.695,
    "end": 96.57,
    "duration": 8.875
  },
  {
    "id": 16,
    "text": "第二，将宏阔历史兴衰融入生死恋情叙事，展现跌宕起伏的戏剧张力。",
    "start": 97.186,
    "end": 103.738,
    "duration": 6.552
  },
  {
    "id": 17,
    "text": "在叙事布局上，《长恨歌》紧扣盛极而衰、惊变惨裂、余恨绵绵的情节链条，张弛有度。",
    "start": 104.147,
    "end": 111.379,
    "duration": 7.232
  },
  {
    "id": 18,
    "text": "前段极力渲染华清池、骊宫的繁华温存与梨园歌舞，",
    "start": 111.858,
    "end": 116.418,
    "duration": 4.56
  },
  {
    "id": 19,
    "text": "旋即以“渔阳鼙鼓动地来，惊破霓裳羽衣曲”造成急转直下的剧变，将战火陡然推至眼前；",
    "start": 116.775,
    "end": 124.915,
    "duration": 8.14
  },
  {
    "id": 20,
    "text": "紧接着马嵬坡前“六军不发无奈何，宛转蛾眉马前死”，把全诗冲突推向惨烈顶点。",
    "start": 125.441,
    "end": 133.257,
    "duration": 7.816
  },
  {
    "id": 21,
    "text": "盛衰两极的剧烈反差，使家国巨变与个人命运紧咬在一起，赋予长诗惊心动魄的叙事张力。",
    "start": 133.964,
    "end": 141.414,
    "duration": 7.45
  },
  {
    "id": 22,
    "text": "第三，运用虚实相生与仙境幻想手法，将世俗悲剧升华为永恒深情。",
    "start": 142.05,
    "end": 148.447,
    "duration": 6.397
  },
  {
    "id": 23,
    "text": "诗作后半部分打破纯写实的时空界限，由实入虚，展开缥缈迷离的仙境想象。",
    "start": 148.648,
    "end": 155.665,
    "duration": 7.017
  },
  {
    "id": 24,
    "text": "诗人先实写玄宗入蜀途中与还京后“行宫见月伤心色，夜雨闻铃肠断声”“孤灯挑尽未成眠”的凄苦孤寂，",
    "start": 155.841,
    "end": 165.748,
    "duration": 9.907
  },
  {
    "id": 25,
    "text": "再借临邛道士“上穷碧落下黄泉”的求索，",
    "start": 166.023,
    "end": 169.627,
    "duration": 3.604
  },
  {
    "id": 26,
    "text": "引出“忽闻海上有仙山，山在虚无缥缈间”的梦幻图景。",
    "start": 169.89,
    "end": 175.1,
    "duration": 5.21
  },
  {
    "id": 27,
    "text": "仙界中的杨玉环“梨花一枝春带雨”，",
    "start": 175.331,
    "end": 177.902,
    "duration": 2.571
  },
  {
    "id": 28,
    "text": "以定情金钗钿盒寄托“在天愿作比翼鸟，在地愿为连理枝”的长生殿旧盟。",
    "start": 178.044,
    "end": 184.941,
    "duration": 6.897
  },
  {
    "id": 29,
    "text": "这种幻化处理冲淡了现实政治的冷峻，使全诗超越宫廷旧事，升华为对坚贞爱情的永恒咏叹。",
    "start": 185.183,
    "end": 192.511,
    "duration": 7.328
  },
  {
    "id": 30,
    "text": "第四，融汇叙事、抒情与七言歌行声律，成就流丽宛转的歌行典范。",
    "start": 193.181,
    "end": 199.732,
    "duration": 6.551
  },
  {
    "id": 31,
    "text": "在艺术形式上，白居易将七言歌行的音律流美与长篇叙事功能融会贯通。",
    "start": 200.116,
    "end": 205.952,
    "duration": 5.836
  },
  {
    "id": 32,
    "text": "全诗语言清丽晓畅、不事僻典，兼取民间说唱的流畅自然与文人诗赋的精工锤炼；",
    "start": 206.44,
    "end": 213.252,
    "duration": 6.812
  },
  {
    "id": 33,
    "text": "叙事之中处处渗入浓烈抒情，情随事转、回环往复；",
    "start": 213.5,
    "end": 218.016,
    "duration": 4.516
  },
  {
    "id": 34,
    "text": "通篇转韵自然严整，节奏随悲喜起伏而抑扬顿挫，",
    "start": 218.343,
    "end": 222.362,
    "duration": 4.019
  },
  {
    "id": 35,
    "text": "结尾“天长地久有时尽，此恨绵绵无绝期”余韵悠长、荡气回肠，",
    "start": 222.607,
    "end": 228.562,
    "duration": 5.955
  },
  {
    "id": 36,
    "text": "成就了中国古典长篇叙事抒情诗的典范之作。",
    "start": 228.705,
    "end": 232.277,
    "duration": 3.572
  },
  {
    "id": 37,
    "text": "总而言之，白居易《长恨歌》将唐玄宗由盛转衰的历史殷鉴与杨玉环生死相思的深情缠绵融为一体，",
    "start": 232.475,
    "end": 240.016,
    "duration": 7.541
  },
  {
    "id": 38,
    "text": "在政治讽谕与爱情同情的交织中展现出复杂的双重意蕴。",
    "start": 240.115,
    "end": 245.683,
    "duration": 5.568
  },
  {
    "id": 39,
    "text": "全诗融通虚实幻想构架、细节抒情笔法与七言歌行流丽转韵，",
    "start": 246.182,
    "end": 250.846,
    "duration": 4.664
  },
  {
    "id": 40,
    "text": "不仅成为中唐长篇叙事抒情诗的代表作，也深刻影响了后世《梧桐雨》《长生殿》等戏曲题材的演进。",
    "start": 250.904,
    "end": 259.303,
    "duration": 8.399
  }
]