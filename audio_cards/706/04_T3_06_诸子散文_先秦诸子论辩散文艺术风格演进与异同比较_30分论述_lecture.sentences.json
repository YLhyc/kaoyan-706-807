[
  {
    "id": 1,
    "text": "春秋战国时期是中国古代社会经历剧烈大变革，大分化的剧动时代。",
    "start": 0.1,
    "end": 6.678,
    "duration": 6.578
  },
  {
    "id": 2,
    "text": "随着周天子失驭，宗法礼乐制度崩坏，私学兴起与士阶层的迅速崛起，形成了思想空前活跃的 “百家争鸣” 格局。",
    "start": 6.628,
    "end": 16.433,
    "duration": 9.805
  },
  {
    "id": 3,
    "text": "先秦诸子论辩散文伴随时代思想探索的深入，实现了中国古代论说文体的历史定型。",
    "start": 16.432,
    "end": 24.427,
    "duration": 7.995
  },
  {
    "id": 4,
    "text": "其文体演进历程与各派风格之异同比较，主要展现为以下四个核心维度，",
    "start": 24.427,
    "end": 31.419,
    "duration": 6.992
  },
  {
    "id": 5,
    "text": "第一，历经从语录体到对话式论辩再到成熟专题论文的文体演进序列。",
    "start": 31.419,
    "end": 38.151,
    "duration": 6.732
  },
  {
    "id": 6,
    "text": "先秦诸子散文的形式发展呈现出严整的历史逻辑。",
    "start": 38.151,
    "end": 43.047,
    "duration": 4.896
  },
  {
    "id": 7,
    "text": "春秋末期产生的 《论语》 以 “语录体” 为主，短小简括，言简意赅，多为孔子及其弟子的言行实录；战国中期的 《孟子》 与 《庄子》 发展为 “对话式论辩体”，篇幅大为拓展，善于在问难驳斥中展开丰富的情节与生动的比喻；至战国末期的 《荀子》 与 《韩非子》，则彻底摆脱了随手记录言行的零散形式，确立了由作者独立撰写的 “专题论文体”。",
    "start": 43.047,
    "end": 72.105,
    "duration": 29.058
  },
  {
    "id": 8,
    "text": "全书标题即论题，结构严整，论证周密，逻辑谨严，标志着先秦论辩散文文体完全走向成熟。",
    "start": 72.105,
    "end": 81.272,
    "duration": 9.167
  },
  {
    "id": 9,
    "text": "第二，儒家散文由从容温雅走向气势磅礴，贯穿深沉的政治理想与道义担当。",
    "start": 81.272,
    "end": 88.863,
    "duration": 7.591
  },
  {
    "id": 10,
    "text": "儒家散文以救世为旨归，追求明礼行仁。",
    "start": 88.863,
    "end": 93.146,
    "duration": 4.283
  },
  {
    "id": 11,
    "text": "论语》 风格雍容雅致，循循善诱，在平实对话中彰显智者风范与深沉的仁德修养；至战国中期，面对礼崩乐坏加剧与杨墨学术竞争，孟子承担起卫道大任，其文风大变，展现出 “雄辩” 特征。",
    "start": 93.146,
    "end": 110.864,
    "duration": 17.718
  },
  {
    "id": 12,
    "text": "孟子自称 “予岂好辩哉，予不得已也”。",
    "start": 110.864,
    "end": 114.601,
    "duration": 3.737
  },
  {
    "id": 13,
    "text": "他长于修辞，大量运用排比，对偶形成凌厉攻势，善设机巧与类比设阱，如以 “五十步笑百步” 启发梁惠王，以 “揠苗助长” 阐说心性修养，文章辞气磅礴，锋芒毕露，洋溢着刚健从容的大丈夫气概。",
    "start": 114.601,
    "end": 132.891,
    "duration": 18.29
  },
  {
    "id": 14,
    "text": "第三，道家散文打破逻辑名辩桎梏，以奇幻寓言与汪洋恣肆展现超旷美学境界。",
    "start": 132.891,
    "end": 140.469,
    "duration": 7.578
  },
  {
    "id": 15,
    "text": "道家散文以追求个体心灵绝对自由与天地之道为归宿。",
    "start": 140.469,
    "end": 146.041,
    "duration": 5.572
  },
  {
    "id": 16,
    "text": "老子》 文约义丰，韵散结合，多用正言若反的辩证格言；战国中期的 《庄子》 则将道家论辩推向浪漫主义极致。",
    "start": 146.042,
    "end": 156.433,
    "duration": 10.391
  },
  {
    "id": 17,
    "text": "庄子摒弃了儒墨两家逻辑辩驳的常规路径，以 “寓言”，“重言”，“卮言” 构筑独特的表达体系。",
    "start": 156.433,
    "end": 164.884,
    "duration": 8.451
  },
  {
    "id": 18,
    "text": "在 《逍遥游》 中，他虚构了翼若垂天之云，抟扶摇而上九万里的北冥大鹏，以及野马尘埃，蜩与学鸠的鲜明对照，在天马行空的瑰丽想象与荒诞奇诡的物象变幻中，消解世俗是非名利。",
    "start": 164.883,
    "end": 181.129,
    "duration": 16.246
  },
  {
    "id": 19,
    "text": "其文辞汪洋恣肆，仪态万方，达到了哲理与诗意高度浑融的化境。",
    "start": 181.13,
    "end": 186.924,
    "duration": 5.794
  },
  {
    "id": 20,
    "text": "第四，法家与晚期诸子倡导冷峻严密剖析，确立说理文结构谨严的论证法度。",
    "start": 186.924,
    "end": 194.424,
    "duration": 7.5
  },
  {
    "id": 21,
    "text": "战国末期兼并战争白热化，讲求富国强兵，以法统政的法家散文应运而生。",
    "start": 194.424,
    "end": 201.494,
    "duration": 7.07
  },
  {
    "id": 22,
    "text": "韩非集法家思想之大成，其散文冷峻深邃，锋利如刀。",
    "start": 201.494,
    "end": 207.002,
    "duration": 5.508
  },
  {
    "id": 23,
    "text": "韩非立足于人性自私的功利立场，在 《孤愤》，《说难》 等篇中，洞察君臣权谋世情，解剖鞭辟入里。",
    "start": 207.002,
    "end": 215.934,
    "duration": 8.932
  },
  {
    "id": 24,
    "text": "韩非善于运用历史事实与民间寓言相互发明，如 “买椟还珠”，“自相矛盾”，“守株待兔”，使抽象的法治权术说理变得生动而具无可辩驳的逻辑说服力；结合荀子散文由博反约，反复推求的长篇论说，共同奠定了后世古代说理散文严谨谨饬的法度典范。",
    "start": 215.934,
    "end": 238.847,
    "duration": 22.913
  },
  {
    "id": 25,
    "text": "1. 本题在先秦文学中的总括性坐标为何？",
    "start": 238.847,
    "end": 242.701,
    "duration": 3.854
  },
  {
    "id": 26,
    "text": "破题必须直击社会剧变，百家争鸣与士阶层崛起，点明诸子论辩散文是先秦思想交锋与文体成熟的核心标志。",
    "start": 242.701,
    "end": 252.909,
    "duration": 10.208
  },
  {
    "id": 27,
    "text": "2. 诸子散文文体形态演进的三大阶段为何？",
    "start": 252.909,
    "end": 257.193,
    "duration": 4.284
  },
  {
    "id": 28,
    "text": "语录体（论语） $",
    "start": 257.193,
    "end": 259.433,
    "duration": 2.24
  },
  {
    "id": 29,
    "text": "ightarrow$ 对话对话式论辩体（孟子，庄子） $",
    "start": 259.433,
    "end": 264.381,
    "duration": 4.948
  },
  {
    "id": 30,
    "text": "ightarrow$ 专论式论说文（荀子，韩非子）。",
    "start": 264.381,
    "end": 268.352,
    "duration": 3.971
  },
  {
    "id": 31,
    "text": "3. 儒，道，法三家论辩风格的本质差异何在？",
    "start": 268.352,
    "end": 273.026,
    "duration": 4.674
  },
  {
    "id": 32,
    "text": "儒家，重伦理道德，由论语温润到孟子雄辩滔滔；",
    "start": 273.027,
    "end": 278.326,
    "duration": 5.299
  },
  {
    "id": 33,
    "text": "道家，重超越自由，庄子以寓言，三言打破逻辑，汪洋恣肆；",
    "start": 278.548,
    "end": 284.891,
    "duration": 6.343
  },
  {
    "id": 34,
    "text": "法家，重权谋实用，韩非子冷峻深刻，逻辑严密，寓言服务于法治。",
    "start": 284.841,
    "end": 291.338,
    "duration": 6.497
  },
  {
    "id": 35,
    "text": "4. 如何将诸子散文的演进总结为文学史法则？",
    "start": 291.339,
    "end": 295.857,
    "duration": 4.518
  },
  {
    "id": 36,
    "text": "由碎片微言走向宏篇大制，由言语记录走向文人独立著述，开创了后世论说文的基本规制。",
    "start": 295.857,
    "end": 304.347,
    "duration": 8.49
  },
  {
    "id": 37,
    "text": "因，春秋时期学术下移，夫子讲学随口教导；",
    "start": 304.346,
    "end": 308.89,
    "duration": 4.544
  },
  {
    "id": 38,
    "text": "果，形成篇幅短小，只存主干言论的语录体（《论语》）。",
    "start": 308.891,
    "end": 314.125,
    "duration": 5.234
  },
  {
    "id": 39,
    "text": "因，战国中期学派辩驳激烈，孟子欲行王道，庄子欲求解脱；",
    "start": 314.125,
    "end": 320.363,
    "duration": 6.238
  },
  {
    "id": 40,
    "text": "果，论辩篇幅大幅伸展，分别发展出排比辞气（孟子）与奇幻寓言（庄子）。",
    "start": 320.362,
    "end": 327.693,
    "duration": 7.331
  },
  {
    "id": 41,
    "text": "因，战国末期兼并临近统一，政治要求系统性治国大纲；",
    "start": 327.693,
    "end": 333.318,
    "duration": 5.625
  },
  {
    "id": 42,
    "text": "果，催生了命题明确，论据详备，首尾完结的长篇专题论说文（荀子，韩非子）。",
    "start": 333.318,
    "end": 340.896,
    "duration": 7.578
  }
]