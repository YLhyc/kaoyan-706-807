[
  {
    "id": 1,
    "text": "试论先秦诸子论辩散文的艺术风格演进历程与主要流派异同比较。",
    "start": 0.101,
    "end": 5.615,
    "duration": 5.514
  },
  {
    "id": 2,
    "text": "春秋战国时期礼崩乐坏、私学兴起与士阶层崛起，",
    "start": 6.234,
    "end": 10.73,
    "duration": 4.496
  },
  {
    "id": 3,
    "text": "催生了思想空前活跃的“百家争鸣”局面。",
    "start": 11.036,
    "end": 13.775,
    "duration": 2.739
  },
  {
    "id": 4,
    "text": "先秦诸子散文伴随各派学说争鸣不断发展，",
    "start": 14.038,
    "end": 17.505,
    "duration": 3.467
  },
  {
    "id": 5,
    "text": "逐步奠定了中国古代说理散文的文体法度与风格谱系。",
    "start": 17.688,
    "end": 22.311,
    "duration": 4.623
  },
  {
    "id": 6,
    "text": "其演进历程与主要流派之异同，主要体现在以下四个方面：",
    "start": 22.593,
    "end": 27.325,
    "duration": 4.732
  },
  {
    "id": 7,
    "text": "第一，历经从语录体到对话式论辩再到专题论文的文体演进序列。",
    "start": 28.0,
    "end": 34.007,
    "duration": 6.007
  },
  {
    "id": 8,
    "text": "先秦诸子散文的体制演变呈现出清晰的发展脉络。",
    "start": 34.393,
    "end": 38.604,
    "duration": 4.211
  },
  {
    "id": 9,
    "text": "春秋末期的《论语》以“语录体”为主，短小简括，",
    "start": 39.125,
    "end": 43.003,
    "duration": 3.878
  },
  {
    "id": 10,
    "text": "多为孔子与弟子答问的片言记录；",
    "start": 43.343,
    "end": 45.92,
    "duration": 2.577
  },
  {
    "id": 11,
    "text": "战国中期的《墨子》《孟子》向“对话式论辩体”过渡，",
    "start": 46.45,
    "end": 50.123,
    "duration": 3.673
  },
  {
    "id": 12,
    "text": "章节围绕同一论题反复辩难，篇幅扩大而善用譬喻，",
    "start": 50.417,
    "end": 54.489,
    "duration": 4.072
  },
  {
    "id": 13,
    "text": "而《庄子》更以寓言构篇，富于抒情色彩；",
    "start": 54.904,
    "end": 57.803,
    "duration": 2.899
  },
  {
    "id": 14,
    "text": "至战国末期的《荀子》与《韩非子》，",
    "start": 58.377,
    "end": 60.401,
    "duration": 2.024
  },
  {
    "id": 15,
    "text": "则摆脱了对话记录的零散形式，确立了标有篇名、中心明确、",
    "start": 60.627,
    "end": 65.25,
    "duration": 4.623
  },
  {
    "id": 16,
    "text": "结构完整的“专题论文体”，标志着古代说理散文体制的成熟。",
    "start": 65.552,
    "end": 69.94,
    "duration": 4.388
  },
  {
    "id": 17,
    "text": "第二，儒家散文由雍容温雅走向气势磅礴，",
    "start": 70.608,
    "end": 74.743,
    "duration": 4.135
  },
  {
    "id": 18,
    "text": "贯穿救世理想与道义担当。",
    "start": 75.24,
    "end": 77.431,
    "duration": 2.191
  },
  {
    "id": 19,
    "text": "儒家散文以仁政教化为旨归。",
    "start": 77.799,
    "end": 80.273,
    "duration": 2.474
  },
  {
    "id": 20,
    "text": "《论语》文风雍容雅致、言近旨远，",
    "start": 80.849,
    "end": 83.616,
    "duration": 2.767
  },
  {
    "id": 21,
    "text": "于平实对话中显现智者风范与深厚仁心；至战国中期，",
    "start": 83.975,
    "end": 88.856,
    "duration": 4.881
  },
  {
    "id": 22,
    "text": "面对杨朱、墨翟学说盛行，孟子自称“予岂好辩哉，",
    "start": 89.219,
    "end": 93.805,
    "duration": 4.586
  },
  {
    "id": 23,
    "text": "予不得已也”，文风转为犀利雄辩。",
    "start": 94.07,
    "end": 97.019,
    "duration": 2.949
  },
  {
    "id": 24,
    "text": "他善于类比推理、欲擒故纵，大量运用排比、",
    "start": 97.518,
    "end": 101.223,
    "duration": 3.705
  },
  {
    "id": 25,
    "text": "对偶营造汹涌文势，",
    "start": 101.557,
    "end": 103.035,
    "duration": 1.478
  },
  {
    "id": 26,
    "text": "如以“五十步笑百步”启发梁惠王反思仁政，",
    "start": 103.366,
    "end": 106.855,
    "duration": 3.489
  },
  {
    "id": 27,
    "text": "以“揠苗助长”阐说涵养“浩然之气”之道，辞气充沛、",
    "start": 107.259,
    "end": 111.652,
    "duration": 4.393
  },
  {
    "id": 28,
    "text": "锋芒毕露，洋溢着刚健不阿的大丈夫气概。",
    "start": 112.097,
    "end": 115.525,
    "duration": 3.428
  },
  {
    "id": 29,
    "text": "第三，道家散文突破常规名辩，",
    "start": 116.204,
    "end": 118.702,
    "duration": 2.498
  },
  {
    "id": 30,
    "text": "以奇幻寓言与汪洋恣肆展现超旷境界。",
    "start": 119.137,
    "end": 122.765,
    "duration": 3.628
  },
  {
    "id": 31,
    "text": "道家散文着意探求天地自然之道与个体精神自由。",
    "start": 123.128,
    "end": 127.399,
    "duration": 4.271
  },
  {
    "id": 32,
    "text": "《老子》言约义丰、韵散结合，多用正言若反的辩证格言；",
    "start": 127.855,
    "end": 132.873,
    "duration": 5.018
  },
  {
    "id": 33,
    "text": "战国中期的《庄子》则把说理推向了哲理与诗意交融的高峰。",
    "start": 133.198,
    "end": 137.83,
    "duration": 4.632
  },
  {
    "id": 34,
    "text": "庄子摒弃儒墨正面逻辑驳难的套路，",
    "start": 138.113,
    "end": 141.273,
    "duration": 3.16
  },
  {
    "id": 35,
    "text": "借助“寓言”“重言”“卮言”展开论述。",
    "start": 141.494,
    "end": 144.334,
    "duration": 2.84
  },
  {
    "id": 36,
    "text": "在《逍遥游》中，他虚构了搏扶摇而上九万里的北冥大鹏，",
    "start": 144.551,
    "end": 148.693,
    "duration": 4.142
  },
  {
    "id": 37,
    "text": "以及野马尘埃、蜩与学鸠等鲜明意象对照，",
    "start": 148.977,
    "end": 152.362,
    "duration": 3.385
  },
  {
    "id": 38,
    "text": "于瑰丽奇诡的想象变幻中超脱世俗功名是非，文辞汪洋恣肆、",
    "start": 152.631,
    "end": 157.894,
    "duration": 5.263
  },
  {
    "id": 39,
    "text": "仪态万方，自成一格。",
    "start": 158.252,
    "end": 159.883,
    "duration": 1.631
  },
  {
    "id": 40,
    "text": "第四，法家与战国末期诸子倡导冷峻剖析，",
    "start": 160.49,
    "end": 164.377,
    "duration": 3.887
  },
  {
    "id": 41,
    "text": "确立说理文谨严的论证法度。",
    "start": 164.694,
    "end": 167.027,
    "duration": 2.333
  },
  {
    "id": 42,
    "text": "战国末期兼并日烈，讲求法治权术与富国强兵的法家散文应运而生。",
    "start": 167.478,
    "end": 173.134,
    "duration": 5.656
  },
  {
    "id": 43,
    "text": "韩非集法家思想之大成，其文冷峻犀利、剖析入微。",
    "start": 173.475,
    "end": 177.891,
    "duration": 4.416
  },
  {
    "id": 44,
    "text": "他立足功利人性论，",
    "start": 178.305,
    "end": 179.65,
    "duration": 1.345
  },
  {
    "id": 45,
    "text": "在《孤愤》《说难》等篇中洞察君臣利害与政局世情，",
    "start": 179.974,
    "end": 184.122,
    "duration": 4.148
  },
  {
    "id": 46,
    "text": "条分缕析、层层推进；",
    "start": 184.411,
    "end": 186.263,
    "duration": 1.852
  },
  {
    "id": 47,
    "text": "同时善用简洁精悍的历史故事与民间寓言阐发法理，",
    "start": 186.526,
    "end": 190.812,
    "duration": 4.286
  },
  {
    "id": 48,
    "text": "如“买椟还珠”“自相矛盾”“守株待兔”，",
    "start": 191.19,
    "end": 194.362,
    "duration": 3.172
  },
  {
    "id": 49,
    "text": "使抽象说理生动透辟。",
    "start": 194.7,
    "end": 196.602,
    "duration": 1.902
  },
  {
    "id": 50,
    "text": "它与荀子博学详密的论说文一道，",
    "start": 196.797,
    "end": 199.299,
    "duration": 2.502
  },
  {
    "id": 51,
    "text": "共同奠定了后世说理散文结构严谨、逻辑周密的论证典范。",
    "start": 199.426,
    "end": 204.323,
    "duration": 4.897
  }
]