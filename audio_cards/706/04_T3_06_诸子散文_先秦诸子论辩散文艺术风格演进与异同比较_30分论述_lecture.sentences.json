[
  {
    "id": 1,
    "text": "试论先秦诸子论辩散文的艺术风格演进历程与主要流派异同比较。",
    "start": 0.101,
    "end": 5.625,
    "duration": 5.524
  },
  {
    "id": 2,
    "text": "春秋战国时期礼崩乐坏、私学兴起与士阶层崛起，催生了思想空前活跃的“百家争鸣”局面。",
    "start": 6.234,
    "end": 13.784,
    "duration": 7.55
  },
  {
    "id": 3,
    "text": "先秦诸子散文伴随各派学说争鸣不断发展，",
    "start": 14.284,
    "end": 17.76,
    "duration": 3.476
  },
  {
    "id": 4,
    "text": "逐步奠定了中国古代说理散文的文体法度与风格谱系。",
    "start": 18.115,
    "end": 22.566,
    "duration": 4.451
  },
  {
    "id": 5,
    "text": "其演进历程与主要流派之异同，主要体现在以下四个方面：",
    "start": 23.066,
    "end": 27.808,
    "duration": 4.742
  },
  {
    "id": 6,
    "text": "第一，历经从语录体到对话式论辩再到专题论文的文体演进序列。",
    "start": 28.473,
    "end": 34.49,
    "duration": 6.017
  },
  {
    "id": 7,
    "text": "先秦诸子散文的体制演变呈现出清晰的发展脉络。",
    "start": 34.99,
    "end": 39.211,
    "duration": 4.221
  },
  {
    "id": 8,
    "text": "春秋末期的《论语》以“语录体”为主，短小简括，多为孔子与弟子答问的片言记录；",
    "start": 39.722,
    "end": 46.527,
    "duration": 6.805
  },
  {
    "id": 9,
    "text": "战国中期的《墨子》《孟子》向“对话式论辩体”过渡，章节围绕同一论题反复辩难，",
    "start": 47.047,
    "end": 53.2,
    "duration": 6.153
  },
  {
    "id": 10,
    "text": "篇幅扩大而善用譬喻，而《庄子》更以寓言构篇，富于抒情色彩；",
    "start": 53.55,
    "end": 58.462,
    "duration": 4.912
  },
  {
    "id": 11,
    "text": "至战国末期的《荀子》与《韩非子》，则摆脱了对话记录的零散形式，",
    "start": 59.026,
    "end": 63.318,
    "duration": 4.292
  },
  {
    "id": 12,
    "text": "确立了标有篇名、中心明确、结构完整的“专题论文体”，标志着古代说理散文体制的成熟。",
    "start": 63.706,
    "end": 70.599,
    "duration": 6.893
  },
  {
    "id": 13,
    "text": "第二，儒家散文由雍容温雅走向气势磅礴，贯穿救世理想与道义担当。",
    "start": 71.257,
    "end": 78.069,
    "duration": 6.812
  },
  {
    "id": 14,
    "text": "儒家散文以仁政教化为旨归。",
    "start": 78.569,
    "end": 81.053,
    "duration": 2.484
  },
  {
    "id": 15,
    "text": "《论语》文风雍容雅致、言近旨远，于平实对话中显现智者风范与深厚仁心；",
    "start": 81.619,
    "end": 88.358,
    "duration": 6.739
  },
  {
    "id": 16,
    "text": "至战国中期，面对杨朱、墨翟学说盛行，",
    "start": 88.858,
    "end": 92.267,
    "duration": 3.409
  },
  {
    "id": 17,
    "text": "孟子自称“予岂好辩哉，予不得已也”，文风转为犀利雄辩。",
    "start": 92.639,
    "end": 97.922,
    "duration": 5.283
  },
  {
    "id": 18,
    "text": "他善于类比推理、欲擒故纵，大量运用排比、对偶营造汹涌文势，",
    "start": 98.422,
    "end": 103.949,
    "duration": 5.527
  },
  {
    "id": 19,
    "text": "如以“五十步笑百步”启发梁惠王反思仁政，以“揠苗助长”阐说涵养“浩然之气”之道，",
    "start": 104.299,
    "end": 111.363,
    "duration": 7.064
  },
  {
    "id": 20,
    "text": "辞气充沛、锋芒毕露，洋溢着刚健不阿的大丈夫气概。",
    "start": 111.753,
    "end": 116.468,
    "duration": 4.715
  },
  {
    "id": 21,
    "text": "第三，道家散文突破常规名辩，以奇幻寓言与汪洋恣肆展现超旷境界。",
    "start": 117.137,
    "end": 123.708,
    "duration": 6.571
  },
  {
    "id": 22,
    "text": "道家散文着意探求天地自然之道与个体精神自由。",
    "start": 124.208,
    "end": 128.484,
    "duration": 4.276
  },
  {
    "id": 23,
    "text": "《老子》言约义丰、韵散结合，多用正言若反的辩证格言；",
    "start": 128.984,
    "end": 134.012,
    "duration": 5.028
  },
  {
    "id": 24,
    "text": "战国中期的《庄子》则把说理推向了哲理与诗意交融的高峰。",
    "start": 134.512,
    "end": 139.154,
    "duration": 4.642
  },
  {
    "id": 25,
    "text": "庄子摒弃儒墨正面逻辑驳难的套路，借助“寓言”“重言”“卮言”展开论述。",
    "start": 139.654,
    "end": 145.885,
    "duration": 6.231
  },
  {
    "id": 26,
    "text": "在《逍遥游》中，他虚构了搏扶摇而上九万里的北冥大鹏，以及野马尘埃、蜩与学鸠等鲜明意象对照，",
    "start": 146.385,
    "end": 154.206,
    "duration": 7.821
  },
  {
    "id": 27,
    "text": "于瑰丽奇诡的想象变幻中超脱世俗功名是非，文辞汪洋恣肆、仪态万方，自成一格。",
    "start": 154.556,
    "end": 161.802,
    "duration": 7.246
  },
  {
    "id": 28,
    "text": "第四，法家与战国末期诸子倡导冷峻剖析，确立说理文谨严的论证法度。",
    "start": 162.415,
    "end": 168.962,
    "duration": 6.547
  },
  {
    "id": 29,
    "text": "战国末期兼并日烈，讲求法治权术与富国强兵的法家散文应运而生。",
    "start": 169.462,
    "end": 175.128,
    "duration": 5.666
  },
  {
    "id": 30,
    "text": "韩非集法家思想之大成，其文冷峻犀利、剖析入微。",
    "start": 175.628,
    "end": 180.054,
    "duration": 4.426
  },
  {
    "id": 31,
    "text": "他立足功利人性论，在《孤愤》《说难》等篇中洞察君臣利害与政局世情，条分缕析、层层推进；",
    "start": 180.554,
    "end": 188.522,
    "duration": 7.968
  },
  {
    "id": 32,
    "text": "同时善用简洁精悍的历史故事与民间寓言阐发法理，",
    "start": 189.022,
    "end": 193.318,
    "duration": 4.296
  },
  {
    "id": 33,
    "text": "如“买椟还珠”“自相矛盾”“守株待兔”，使抽象说理生动透辟。",
    "start": 193.686,
    "end": 199.108,
    "duration": 5.422
  },
  {
    "id": 34,
    "text": "它与荀子博学详密的论说文一道，共同奠定了后世说理散文结构严谨、逻辑周密的论证典范。",
    "start": 199.608,
    "end": 207.134,
    "duration": 7.526
  },
  {
    "id": 35,
    "text": "综观先秦诸子散文的流变，其文体经历了从语录体、对话体向结构严密专题论文的渐进成熟，",
    "start": 207.634,
    "end": 216.277,
    "duration": 8.643
  },
  {
    "id": 36,
    "text": "并形成了儒家道义雄辩、道家寓言奇想与法家冷峻剖析并峙的风格谱系。",
    "start": 216.648,
    "end": 223.054,
    "duration": 6.406
  },
  {
    "id": 37,
    "text": "在“百家争鸣”的思想激荡中锤炼出的说理章法与寓言比喻传统，为中国古代散文的发展立下了论辩法度与文学风范。",
    "start": 223.554,
    "end": 233.723,
    "duration": 10.169
  }
]
