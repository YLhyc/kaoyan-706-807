[
  {
    "id": 1,
    "text": "试论先秦诸子论辩散文的艺术风格演进历程与主要流派异同比较。",
    "start": 0.0,
    "end": 6.974,
    "duration": 6.974
  },
  {
    "id": 2,
    "text": "春秋战国时期是中国古代社会经历剧烈大变革、大分化的剧动时代。",
    "start": 6.974,
    "end": 13.133,
    "duration": 6.159
  },
  {
    "id": 3,
    "text": "随着周天子失驭、宗法礼乐制度崩坏、",
    "start": 13.133,
    "end": 14.774,
    "duration": 1.641
  },
  {
    "id": 4,
    "text": "私学兴起与士阶层的迅速崛起，",
    "start": 14.774,
    "end": 16.487,
    "duration": 1.713
  },
  {
    "id": 5,
    "text": "形成了思想空前活跃的 “百家争鸣” 格局。",
    "start": 16.487,
    "end": 22.536,
    "duration": 6.049
  },
  {
    "id": 6,
    "text": "先秦诸子论辩散文伴随时代思想探索的深入，",
    "start": 22.536,
    "end": 26.425,
    "duration": 3.889
  },
  {
    "id": 7,
    "text": "实现了中国古代论说文体的历史定型。",
    "start": 26.425,
    "end": 29.551,
    "duration": 3.126
  },
  {
    "id": 8,
    "text": "其文体演进历程与各派风格之异同比较，",
    "start": 29.551,
    "end": 33.173,
    "duration": 3.622
  },
  {
    "id": 9,
    "text": "主要展现为以下四个核心维度：第一，",
    "start": 33.173,
    "end": 35.969,
    "duration": 2.796
  },
  {
    "id": 10,
    "text": "历经从语录体到对话式论辩再到成熟专题论文的文体演进序列。",
    "start": 35.969,
    "end": 42.296,
    "duration": 6.327
  },
  {
    "id": 11,
    "text": "先秦诸子散文的形式发展呈现出严整的历史逻辑。",
    "start": 42.296,
    "end": 46.301,
    "duration": 4.005
  },
  {
    "id": 12,
    "text": "春秋末期产生的 《论语》 以 “语录体” 为主，",
    "start": 46.301,
    "end": 49.343,
    "duration": 3.042
  },
  {
    "id": 13,
    "text": "短小简括、言简意赅，多为孔子及其弟子的言行实录；",
    "start": 49.343,
    "end": 51.292,
    "duration": 1.949
  },
  {
    "id": 14,
    "text": "战国中期的 《孟子》 与 《庄子》 发展为 “对话式论辩体”，",
    "start": 51.292,
    "end": 54.004,
    "duration": 2.712
  },
  {
    "id": 15,
    "text": "篇幅大为拓展，",
    "start": 54.004,
    "end": 56.025,
    "duration": 2.021
  },
  {
    "id": 16,
    "text": "善于在问难驳斥中展开丰富的情节与生动的比喻；",
    "start": 56.025,
    "end": 57.916,
    "duration": 1.891
  },
  {
    "id": 17,
    "text": "至战国末期的 《荀子》 与 《韩非子》，",
    "start": 57.916,
    "end": 63.249,
    "duration": 5.333
  },
  {
    "id": 18,
    "text": "则彻底摆脱了随手记录言行的零散形式，",
    "start": 63.249,
    "end": 65.2,
    "duration": 1.951
  },
  {
    "id": 19,
    "text": "确立了由作者独立撰写的 “专题论文体”。",
    "start": 65.2,
    "end": 69.939,
    "duration": 4.739
  },
  {
    "id": 20,
    "text": "全书标题即论题，结构严整、论证周密、逻辑谨严，",
    "start": 69.939,
    "end": 73.995,
    "duration": 4.056
  },
  {
    "id": 21,
    "text": "标志着先秦论辩散文文体完全走向成熟。",
    "start": 73.995,
    "end": 76.936,
    "duration": 2.941
  },
  {
    "id": 22,
    "text": "第二，儒家散文由从容温雅走向气势磅礴，",
    "start": 76.936,
    "end": 81.657,
    "duration": 4.721
  },
  {
    "id": 23,
    "text": "贯穿深沉的政治理想与道义担当。",
    "start": 81.657,
    "end": 83.81,
    "duration": 2.153
  },
  {
    "id": 24,
    "text": "儒家散文以救世为旨归，追求明礼行仁。",
    "start": 83.81,
    "end": 87.349,
    "duration": 3.539
  },
  {
    "id": 25,
    "text": "《论语》 风格雍容雅致、循循善诱，",
    "start": 87.349,
    "end": 90.142,
    "duration": 2.793
  },
  {
    "id": 26,
    "text": "在平实对话中彰显智者风范与深沉的仁德修养；至战国中期，",
    "start": 90.142,
    "end": 95.243,
    "duration": 5.101
  },
  {
    "id": 27,
    "text": "面对礼崩乐坏加剧与杨墨学术竞争，孟子承担起卫道大任，",
    "start": 95.243,
    "end": 100.685,
    "duration": 5.442
  },
  {
    "id": 28,
    "text": "其文风大变，展现出 “雄辩” 特征。",
    "start": 100.685,
    "end": 103.471,
    "duration": 2.786
  },
  {
    "id": 29,
    "text": "孟子自称 “予岂好辩哉，予不得已也”。",
    "start": 103.471,
    "end": 108.972,
    "duration": 5.501
  },
  {
    "id": 30,
    "text": "他长于修辞，大量运用排比、对偶形成凌厉攻势，",
    "start": 108.972,
    "end": 112.804,
    "duration": 3.832
  },
  {
    "id": 31,
    "text": "善设机巧与类比设阱，如以 “五十步笑百步” 启发梁惠王，",
    "start": 112.804,
    "end": 118.494,
    "duration": 5.69
  },
  {
    "id": 32,
    "text": "以 “揠苗助长” 阐说心性修养，文章辞气磅礴、锋芒毕露，",
    "start": 118.494,
    "end": 123.994,
    "duration": 5.5
  },
  {
    "id": 33,
    "text": "洋溢着刚健从容的大丈夫气概。",
    "start": 123.994,
    "end": 126.623,
    "duration": 2.629
  },
  {
    "id": 34,
    "text": "第三，道家散文打破逻辑名辩桎梏，",
    "start": 126.623,
    "end": 129.258,
    "duration": 2.635
  },
  {
    "id": 35,
    "text": "以奇幻寓言与汪洋恣肆展现超旷美学境界。",
    "start": 129.258,
    "end": 132.945,
    "duration": 3.687
  },
  {
    "id": 36,
    "text": "道家散文以追求个体心灵绝对自由与天地之道为归宿。",
    "start": 132.945,
    "end": 137.329,
    "duration": 4.384
  },
  {
    "id": 37,
    "text": "《老子》 文约义丰、韵散结合，多用正言若反的辩证格言；",
    "start": 137.329,
    "end": 143.813,
    "duration": 6.484
  },
  {
    "id": 38,
    "text": "战国中期的 《庄子》 则将道家论辩推向浪漫主义极致。",
    "start": 143.813,
    "end": 148.41,
    "duration": 4.597
  },
  {
    "id": 39,
    "text": "庄子摒弃了儒墨两家逻辑辩驳的常规路径，以 “寓言”、",
    "start": 148.41,
    "end": 153.064,
    "duration": 4.654
  },
  {
    "id": 40,
    "text": "“重言”、“卮言” 构筑独特的表达体系。",
    "start": 153.064,
    "end": 157.283,
    "duration": 4.219
  },
  {
    "id": 41,
    "text": "在 《逍遥游》 中，他虚构了翼若垂天之云、",
    "start": 157.283,
    "end": 161.17,
    "duration": 3.887
  },
  {
    "id": 42,
    "text": "抟扶摇而上九万里的北冥大鹏，以及野马尘埃、",
    "start": 161.17,
    "end": 165.752,
    "duration": 4.582
  },
  {
    "id": 43,
    "text": "蜩与学鸠的鲜明对照，",
    "start": 165.752,
    "end": 169.19,
    "duration": 3.438
  },
  {
    "id": 44,
    "text": "在天马行空的瑰丽想象与荒诞奇诡的物象变幻中，",
    "start": 169.19,
    "end": 173.388,
    "duration": 4.198
  },
  {
    "id": 45,
    "text": "消解世俗是非名利。",
    "start": 173.388,
    "end": 175.207,
    "duration": 1.819
  },
  {
    "id": 46,
    "text": "其文辞汪洋恣肆、仪态万方，达到了哲理与诗意高度浑融的化境。",
    "start": 175.207,
    "end": 180.833,
    "duration": 5.626
  },
  {
    "id": 47,
    "text": "第四，法家与晚期诸子倡导冷峻严密剖析，",
    "start": 180.833,
    "end": 183.318,
    "duration": 2.485
  },
  {
    "id": 48,
    "text": "确立说理文结构谨严的论证法度。",
    "start": 183.318,
    "end": 185.599,
    "duration": 2.281
  },
  {
    "id": 49,
    "text": "战国末期兼并战争白热化，讲求富国强兵、",
    "start": 185.599,
    "end": 188.701,
    "duration": 3.102
  },
  {
    "id": 50,
    "text": "以法统政的法家散文应运而生。",
    "start": 188.701,
    "end": 192.725,
    "duration": 4.024
  },
  {
    "id": 51,
    "text": "韩非集法家思想之大成，其散文冷峻深邃、锋利如刀。",
    "start": 192.725,
    "end": 197.798,
    "duration": 5.073
  },
  {
    "id": 52,
    "text": "韩非立足于人性自私的功利立场，在 《孤愤》、",
    "start": 197.798,
    "end": 200.805,
    "duration": 3.007
  },
  {
    "id": 53,
    "text": "《说难》 等篇中，洞察君臣权谋世情，解剖鞭辟入里。",
    "start": 200.805,
    "end": 207.587,
    "duration": 6.782
  },
  {
    "id": 54,
    "text": "韩非善于运用历史事实与民间寓言相互发明，",
    "start": 207.587,
    "end": 209.08,
    "duration": 1.493
  },
  {
    "id": 55,
    "text": "如 “买椟还珠”、“自相矛盾”、“守株待兔”，",
    "start": 209.08,
    "end": 214.923,
    "duration": 5.843
  },
  {
    "id": 56,
    "text": "使抽象的法治权术说理变得生动而具无可辩驳的逻辑说服力；",
    "start": 214.923,
    "end": 220.875,
    "duration": 5.952
  },
  {
    "id": 57,
    "text": "结合荀子散文由博反约、反复推求的长篇论说，",
    "start": 220.875,
    "end": 224.922,
    "duration": 4.047
  },
  {
    "id": 58,
    "text": "共同奠定了后世古代说理散文严谨谨饬的法度典范。",
    "start": 224.922,
    "end": 229.152,
    "duration": 4.23
  }
]