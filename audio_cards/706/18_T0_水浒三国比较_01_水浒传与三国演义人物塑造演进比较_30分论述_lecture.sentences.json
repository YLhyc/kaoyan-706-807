[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 3.28,
    "duration": 3.2
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 3.28,
    "end": 6.0,
    "duration": 2.72
  },
  {
    "id": 3,
    "text": "这道题考查中国古代长篇小说人物塑造艺术的演进规律。",
    "start": 6.0,
    "end": 10.64,
    "duration": 4.64
  },
  {
    "id": 4,
    "text": "在考场上，考生不能简单分别讲一遍三国和水浒的故事，",
    "start": 10.64,
    "end": 15.04,
    "duration": 4.4
  },
  {
    "id": 5,
    "text": "而必须紧扣“演进与突破”这一核心题眼。",
    "start": 15.04,
    "end": 18.32,
    "duration": 3.28
  },
  {
    "id": 6,
    "text": "核心在于回答：《水浒传》究竟在哪些具体小说美学维度上，",
    "start": 18.48,
    "end": 23.36,
    "duration": 4.88
  },
  {
    "id": 7,
    "text": "超越了《三国演义》依傍史传的旧传统，",
    "start": 23.36,
    "end": 26.56,
    "duration": 3.2
  },
  {
    "id": 8,
    "text": "走向了纯正的文学写实。",
    "start": 26.56,
    "end": 28.72,
    "duration": 2.16
  },
  {
    "id": 9,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 28.72,
    "end": 31.68,
    "duration": 2.96
  },
  {
    "id": 10,
    "text": "答题必须确立“由表及里、由形态到机制再到形式”的专业小说学视角。",
    "start": 31.68,
    "end": 37.28,
    "duration": 5.6
  },
  {
    "id": 11,
    "text": "第一步从外在性格形态（类型化到多维化）切入，",
    "start": 37.52,
    "end": 41.68,
    "duration": 4.16
  },
  {
    "id": 12,
    "text": "第二步深入内在心理生成机制（道德定型到环境逼迫），",
    "start": 41.68,
    "end": 46.08,
    "duration": 4.4
  },
  {
    "id": 13,
    "text": "第三步落脚于语言与细节描写本体（浅近文言到市井白话），",
    "start": 46.08,
    "end": 51.44,
    "duration": 5.36
  },
  {
    "id": 14,
    "text": "最后在长篇白话小说的成熟脉络中升华。",
    "start": 51.44,
    "end": 55.04,
    "duration": 3.6
  },
  {
    "id": 15,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 55.04,
    "end": 57.68,
    "duration": 2.64
  },
  {
    "id": 16,
    "text": "全题分为四个核心论述维度：第一维度：界定两部名著在中国长篇章回小说史上的演进坐标；",
    "start": 58.0,
    "end": 65.92,
    "duration": 7.92
  },
  {
    "id": 17,
    "text": "第二维度：深入剖析人物性格由《三国演义》的“特征化、",
    "start": 65.92,
    "end": 70.24,
    "duration": 4.32
  },
  {
    "id": 18,
    "text": "类型化”向《水浒传》的“多维复杂性格化”的飞跃；",
    "start": 70.24,
    "end": 74.24,
    "duration": 4.0
  },
  {
    "id": 19,
    "text": "第三维度：深刻对比性格生成机制由“天命道德预设”向“严酷社会逼迫与动态心理流变”的转变；",
    "start": 74.24,
    "end": 82.16,
    "duration": 7.92
  },
  {
    "id": 20,
    "text": "第四维度：精准辨析描写笔法由“史传粗陈梗概与浅近文言”向“市井生活精微白描与个性化生动口语”的革新；",
    "start": 82.48,
    "end": 92.8,
    "duration": 10.32
  },
  {
    "id": 21,
    "text": "第五维度：宏观总结《水浒传》对后世世情写实小说的开拓性奠基价值。",
    "start": 92.8,
    "end": 98.96,
    "duration": 6.16
  },
  {
    "id": 22,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 98.96,
    "end": 102.8,
    "duration": 3.84
  },
  {
    "id": 23,
    "text": "全题逻辑严密咬合：第一步先确立两者前承后继的历史地位。",
    "start": 102.96,
    "end": 107.92,
    "duration": 4.96
  },
  {
    "id": 24,
    "text": "第二步剖析人物性格本身的质变，以鲁迅评语和金圣叹评语为学术支点。",
    "start": 107.92,
    "end": 113.52,
    "duration": 5.6
  },
  {
    "id": 25,
    "text": "第三步探究为什么性格会发生质变，",
    "start": 113.52,
    "end": 116.16,
    "duration": 2.64
  },
  {
    "id": 26,
    "text": "归结于社会现实压迫机制和心理流变。",
    "start": 116.16,
    "end": 119.12,
    "duration": 2.96
  },
  {
    "id": 27,
    "text": "第四步说明这种复杂的性格必须通过怎样的微观细节和语言形式来传达。",
    "start": 119.12,
    "end": 124.48,
    "duration": 5.36
  },
  {
    "id": 28,
    "text": "第五步完成宏观历史论证闭环。",
    "start": 124.72,
    "end": 127.68,
    "duration": 2.96
  },
  {
    "id": 29,
    "text": "二、各板块逐句咬合演练。",
    "start": 127.68,
    "end": 130.0,
    "duration": 2.32
  },
  {
    "id": 30,
    "text": "一、开头破题段内部咬合。",
    "start": 130.0,
    "end": 132.32,
    "duration": 2.32
  },
  {
    "id": 31,
    "text": "本段旨在开门见山确立两书的阶梯演进关系。",
    "start": 132.32,
    "end": 136.08,
    "duration": 3.76
  },
  {
    "id": 32,
    "text": "首句定性，次句直接揭示从史传向写实成熟期的跨越。",
    "start": 136.08,
    "end": 140.24,
    "duration": 4.16
  },
  {
    "id": 33,
    "text": "-首先，首句必须直接亮出两部著作在小说史上的标志性地位，",
    "start": 140.448,
    "end": 145.036,
    "duration": 4.588
  },
  {
    "id": 34,
    "text": "具体表述到答题语句就是：《三国演义》与《水浒传》代表了中国古代长篇章回小说演进的两大关键里程碑。",
    "start": 145.036,
    "end": 152.743,
    "duration": 7.707
  },
  {
    "id": 35,
    "text": "有了里程碑定性之后，次句必须迅速说明后者的超越性，",
    "start": 152.743,
    "end": 156.964,
    "duration": 4.221
  },
  {
    "id": 36,
    "text": "具体表述到答题语句就是：《三国演义》初创了英雄传奇与历史演义的宏大叙事范式，",
    "start": 156.964,
    "end": 163.203,
    "duration": 6.239
  },
  {
    "id": 37,
    "text": "而《水浒传》则在此基础上实现了重大艺术跨越，",
    "start": 163.203,
    "end": 166.69,
    "duration": 3.487
  },
  {
    "id": 38,
    "text": "标志着中国小说人物塑造艺术从依傍史传的类型化叙事，",
    "start": 166.69,
    "end": 171.094,
    "duration": 4.404
  },
  {
    "id": 39,
    "text": "全面迈向关注个体生存境遇与复杂性格演变的写实成熟期。，",
    "start": 171.094,
    "end": 175.681,
    "duration": 4.587
  },
  {
    "id": 40,
    "text": "这句话精准概括了下文展开的三大演进维度。",
    "start": 175.681,
    "end": 179.168,
    "duration": 3.487
  },
  {
    "id": 41,
    "text": "《三国演义》与《水浒传》代表了中国古代长篇章回小说演进的两大关键里程碑。",
    "start": 179.168,
    "end": 185.754,
    "duration": 6.586
  },
  {
    "id": 42,
    "text": "《三国演义》初创了英雄传奇与历史演义的宏大叙事范式，",
    "start": 185.754,
    "end": 190.641,
    "duration": 4.887
  },
  {
    "id": 43,
    "text": "而《水浒传》则在此基础上实现了重大艺术跨越，",
    "start": 190.641,
    "end": 194.678,
    "duration": 4.037
  },
  {
    "id": 44,
    "text": "标志着中国小说人物塑造艺术从依傍史传的类型化叙事，",
    "start": 194.678,
    "end": 199.777,
    "duration": 5.099
  },
  {
    "id": 45,
    "text": "全面迈向关注个体生存境遇与复杂性格演变的写实成熟期。",
    "start": 199.777,
    "end": 205.088,
    "duration": 5.311
  },
  {
    "id": 46,
    "text": "二、第一维度：性格形态从类型化向多维性格化飞跃内部咬合。",
    "start": 205.248,
    "end": 211.408,
    "duration": 6.16
  },
  {
    "id": 47,
    "text": "本段任务是运用鲁迅与金圣叹的权威论断，",
    "start": 211.408,
    "end": 215.008,
    "duration": 3.6
  },
  {
    "id": 48,
    "text": "对比三国的三绝脸谱化与水浒的百人百面。",
    "start": 215.008,
    "end": 218.848,
    "duration": 3.84
  },
  {
    "id": 49,
    "text": "首先，段首给出结论先行的分论点，",
    "start": 218.848,
    "end": 222.048,
    "duration": 3.2
  },
  {
    "id": 50,
    "text": "具体表述到答题语句就是：第一，在人物性格形态上，",
    "start": 222.048,
    "end": 226.208,
    "duration": 4.16
  },
  {
    "id": 51,
    "text": "《水浒传》实现了从“类型化特征化”向“多维性格化”的深刻飞跃。",
    "start": 226.208,
    "end": 230.928,
    "duration": 4.72
  },
  {
    "id": 52,
    "text": "-随后，剖析《三国演义》人物性格的固定与单一特征，",
    "start": 231.088,
    "end": 235.45,
    "duration": 4.362
  },
  {
    "id": 53,
    "text": "具体表述到答题语句就是：《三国演义》受传统史传春秋笔法与民间说唱定型影响，",
    "start": 235.45,
    "end": 242.646,
    "duration": 7.196
  },
  {
    "id": 54,
    "text": "人物性格多呈现鲜明的特征化倾向，",
    "start": 242.646,
    "end": 245.918,
    "duration": 3.272
  },
  {
    "id": 55,
    "text": "鲁迅在《中国小说史略》中精辟概括其“欲显刘备之长厚而似伪，",
    "start": 245.918,
    "end": 251.37,
    "duration": 5.452
  },
  {
    "id": 56,
    "text": "状诸葛之多智而近妖”，关羽之绝伦义气、",
    "start": 251.37,
    "end": 254.859,
    "duration": 3.489
  },
  {
    "id": 57,
    "text": "曹操之奸诈雄制亦高度凝固于某种道德文化类型。，",
    "start": 254.859,
    "end": 259.439,
    "duration": 4.58
  },
  {
    "id": 58,
    "text": "鲁迅名言引用极为精准，学术分量极高。",
    "start": 259.439,
    "end": 262.928,
    "duration": 3.489
  },
  {
    "id": 59,
    "text": "-紧接着，转入《水浒传》的多面性分析，",
    "start": 262.992,
    "end": 266.045,
    "duration": 3.053
  },
  {
    "id": 60,
    "text": "具体表述到答题语句就是：相比之下，",
    "start": 266.045,
    "end": 269.317,
    "duration": 3.272
  },
  {
    "id": 61,
    "text": "《水浒传》则突破了单一维度的脸谱化建构，",
    "start": 269.317,
    "end": 273.025,
    "duration": 3.708
  },
  {
    "id": 62,
    "text": "赋予人物极其丰富复杂的性格层次。，",
    "start": 273.025,
    "end": 276.296,
    "duration": 3.271
  },
  {
    "id": 63,
    "text": "并引用金圣叹评语：金圣叹评水浒“人有其性情，",
    "start": 276.296,
    "end": 280.44,
    "duration": 4.144
  },
  {
    "id": 64,
    "text": "人有其气质，人有其形状，人有其声口”。",
    "start": 280.44,
    "end": 283.712,
    "duration": 3.272
  },
  {
    "id": 65,
    "text": "-最后，调取宋江的多维性格进行严密例证，",
    "start": 283.712,
    "end": 287.602,
    "duration": 3.89
  },
  {
    "id": 66,
    "text": "具体表述到答题语句就是：以宋江为例，",
    "start": 287.602,
    "end": 291.264,
    "duration": 3.662
  },
  {
    "id": 67,
    "text": "他既有仗义疏财、扶危济困的“及时雨”美德，",
    "start": 291.264,
    "end": 295.155,
    "duration": 3.891
  },
  {
    "id": 68,
    "text": "又有身受儒家伦理浸染、渴望招安封妻荫子的软弱妥协，",
    "start": 295.155,
    "end": 300.418,
    "duration": 5.263
  },
  {
    "id": 69,
    "text": "更有循阳楼题反诗时压抑已久的狂放野心，",
    "start": 300.418,
    "end": 304.538,
    "duration": 4.12
  },
  {
    "id": 70,
    "text": "其性格充满了忠义与反叛、仁厚与权术的深刻撕裂，",
    "start": 304.538,
    "end": 309.343,
    "duration": 4.805
  },
  {
    "id": 71,
    "text": "呈现出真实的人性深度。",
    "start": 309.343,
    "end": 311.632,
    "duration": 2.289
  },
  {
    "id": 72,
    "text": "第一，在人物性格形态上，《水浒传》实现了从“类型化特征化”向“多维性格化”的深刻飞跃。",
    "start": 311.712,
    "end": 319.472,
    "duration": 7.76
  },
  {
    "id": 73,
    "text": "《三国演义》受传统史传春秋笔法与民间说唱定型影响，",
    "start": 319.472,
    "end": 324.432,
    "duration": 4.96
  },
  {
    "id": 74,
    "text": "人物性格多呈现鲜明的特征化倾向，",
    "start": 324.432,
    "end": 327.472,
    "duration": 3.04
  },
  {
    "id": 75,
    "text": "鲁迅在《中国小说史略》中精辟概括其“欲显刘备之长厚而似伪，",
    "start": 327.472,
    "end": 333.232,
    "duration": 5.76
  },
  {
    "id": 76,
    "text": "状诸葛之多智而近妖”，关羽之绝伦义气、",
    "start": 333.232,
    "end": 336.992,
    "duration": 3.76
  },
  {
    "id": 77,
    "text": "曹操之奸诈雄制亦高度凝固于某种道德文化类型。",
    "start": 336.992,
    "end": 341.232,
    "duration": 4.24
  },
  {
    "id": 78,
    "text": "相比之下，《水浒传》则突破了单一维度的脸谱化建构，",
    "start": 341.552,
    "end": 345.472,
    "duration": 3.92
  },
  {
    "id": 79,
    "text": "赋予人物极其丰富复杂的性格层次。",
    "start": 345.472,
    "end": 348.192,
    "duration": 2.72
  },
  {
    "id": 80,
    "text": "金圣叹评水浒“人有其性情，人有其气质，",
    "start": 348.192,
    "end": 351.552,
    "duration": 3.36
  },
  {
    "id": 81,
    "text": "人有其形状，人有其声口”。",
    "start": 351.552,
    "end": 353.632,
    "duration": 2.08
  },
  {
    "id": 82,
    "text": "以宋江为例，他既有仗义疏财、扶危济困的“及时雨”美德，",
    "start": 353.632,
    "end": 358.032,
    "duration": 4.4
  },
  {
    "id": 83,
    "text": "又有身受儒家伦理浸染、渴望招安封妻荫子的软弱妥协，",
    "start": 358.032,
    "end": 362.192,
    "duration": 4.16
  },
  {
    "id": 84,
    "text": "更有循阳楼题反诗时压抑已久的狂放野心，",
    "start": 362.192,
    "end": 365.872,
    "duration": 3.68
  },
  {
    "id": 85,
    "text": "其性格充满了忠义与反叛、仁厚与权术的深刻撕裂，",
    "start": 365.872,
    "end": 369.952,
    "duration": 4.08
  },
  {
    "id": 86,
    "text": "呈现出真实的人性深度。",
    "start": 369.952,
    "end": 371.632,
    "duration": 1.68
  },
  {
    "id": 87,
    "text": "三、第二维度：性格生成机制从道德命定到环境逼迫内部咬合。",
    "start": 371.952,
    "end": 377.712,
    "duration": 5.76
  },
  {
    "id": 88,
    "text": "本段任务是剖析环境逼迫与心理动态轨迹，",
    "start": 377.712,
    "end": 381.232,
    "duration": 3.52
  },
  {
    "id": 89,
    "text": "以林冲为核心案例讲透机制。",
    "start": 381.232,
    "end": 383.792,
    "duration": 2.56
  },
  {
    "id": 90,
    "text": "首先，段首给出结论先行的分论点，",
    "start": 383.792,
    "end": 386.832,
    "duration": 3.04
  },
  {
    "id": 91,
    "text": "具体表述到答题语句就是：第二，在性格生成机制上，",
    "start": 386.832,
    "end": 390.992,
    "duration": 4.16
  },
  {
    "id": 92,
    "text": "《水浒传》实现了从“先天道德预设”向“社会环境逼迫与心理流变”的根本转变。",
    "start": 390.992,
    "end": 397.152,
    "duration": 6.16
  },
  {
    "id": 93,
    "text": "-随后，剖析《三国演义》人物性格缺乏动态变化的机制，",
    "start": 397.368,
    "end": 401.485,
    "duration": 4.117
  },
  {
    "id": 94,
    "text": "具体表述到答题语句就是：《三国演义》中的主要人物性格在登场伊始便基本定型，",
    "start": 401.485,
    "end": 407.954,
    "duration": 6.469
  },
  {
    "id": 95,
    "text": "其命运演进主要受天命大势与政治军事对抗推动，",
    "start": 407.954,
    "end": 412.071,
    "duration": 4.117
  },
  {
    "id": 96,
    "text": "较少展现人物心理与性格的发展轨迹。",
    "start": 412.071,
    "end": 415.208,
    "duration": 3.137
  },
  {
    "id": 97,
    "text": "-紧接着，引出《水浒传》“官逼民反”的写实机制，",
    "start": 415.208,
    "end": 418.632,
    "duration": 3.424
  },
  {
    "id": 98,
    "text": "具体表述到答题语句就是：《水浒传》则首次将人物性格的生成与严酷的社会生存现实紧密咬合，",
    "start": 418.632,
    "end": 426.488,
    "duration": 7.856
  },
  {
    "id": 99,
    "text": "开创了“官逼民反”的写实机制。",
    "start": 426.488,
    "end": 428.905,
    "duration": 2.417
  },
  {
    "id": 100,
    "text": "随后，调取林冲经典例证展开完整推演，",
    "start": 428.905,
    "end": 432.128,
    "duration": 3.223
  },
  {
    "id": 101,
    "text": "具体表述到答题语句就是：最典型的例证便是林冲形象的动态发展。",
    "start": 432.128,
    "end": 437.768,
    "duration": 5.64
  },
  {
    "id": 102,
    "text": "作为八十万禁军教头，林冲起初具有极深厚的体制依附心理，",
    "start": 437.928,
    "end": 442.888,
    "duration": 4.96
  },
  {
    "id": 103,
    "text": "面对高衙内调戏爱妻一再忍气吞声，",
    "start": 442.888,
    "end": 446.088,
    "duration": 3.2
  },
  {
    "id": 104,
    "text": "发配沧州途中面对董超、薛霸的折磨甚至野猪林的残害依然逆来顺受，",
    "start": 446.088,
    "end": 451.608,
    "duration": 5.52
  },
  {
    "id": 105,
    "text": "直至风雪山神庙偶听陆谦密谋方彻底梦醒，",
    "start": 451.608,
    "end": 455.288,
    "duration": 3.68
  },
  {
    "id": 106,
    "text": "最终提刀手刃仇敌雪夜上梁山。",
    "start": 455.288,
    "end": 458.088,
    "duration": 2.8
  },
  {
    "id": 107,
    "text": "-最后，收束总结该机制的文学价值，",
    "start": 458.248,
    "end": 461.158,
    "duration": 2.91
  },
  {
    "id": 108,
    "text": "具体表述到答题语句就是：这种在恶劣社会环境与步步紧逼的生存危机中展开的心理流变，",
    "start": 461.158,
    "end": 469.056,
    "duration": 7.898
  },
  {
    "id": 109,
    "text": "赋予人物性格极强的现实逻辑力量。",
    "start": 469.056,
    "end": 472.174,
    "duration": 3.118
  },
  {
    "id": 110,
    "text": "第二，在性格生成机制上，《水浒传》实现了从“先天道德预设”向“社会环境逼迫与心理流变”的根本转变。",
    "start": 472.174,
    "end": 480.488,
    "duration": 8.314
  },
  {
    "id": 111,
    "text": "《三国演义》中的主要人物性格在登场伊始便基本定型，",
    "start": 480.488,
    "end": 485.306,
    "duration": 4.818
  },
  {
    "id": 112,
    "text": "其命运演进主要受天命大势与政治军事对抗推动，",
    "start": 485.306,
    "end": 489.905,
    "duration": 4.599
  },
  {
    "id": 113,
    "text": "较少展现人物心理与性格的发展轨迹。",
    "start": 489.905,
    "end": 493.408,
    "duration": 3.503
  },
  {
    "id": 114,
    "text": "《水浒传》则首次将人物性格的生成与严酷的社会生存现实紧密咬合，",
    "start": 493.408,
    "end": 499.54,
    "duration": 6.132
  },
  {
    "id": 115,
    "text": "开创了“官逼民反”的写实机制。",
    "start": 499.54,
    "end": 502.168,
    "duration": 2.628
  },
  {
