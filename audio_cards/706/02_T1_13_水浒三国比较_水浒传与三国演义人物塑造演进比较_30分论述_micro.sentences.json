[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "水浒三国比较·水浒传与三国演义人物塑造演进比较",
    "start": 0.134,
    "end": 4.86,
    "duration": 4.726
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "四重“由先向后”的长篇写人演进史：先是从道德类型（三绝）进化到复杂性格（宋江李逵），",
    "start": 5.449,
    "end": 14.172,
    "duration": 8.723
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再从出场即定型进化到环境逼变（林冲），接着从朝堂战场下沉到市井细事，",
    "start": 14.433,
    "end": 22.01,
    "duration": 7.577
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后由文白语体升级为纯熟个性口语。",
    "start": 22.124,
    "end": 25.456,
    "duration": 3.332
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《三国演义》与《水浒传》同胎息宋元说话伎艺。",
    "start": 26.043,
    "end": 29.91,
    "duration": 3.866
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "从前者到后者标志古代小说写人由“特征化”走向“性格化”演进，",
    "start": 30.496,
    "end": 35.782,
    "duration": 5.285
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "唐顺之、王慎中赞《水浒传》“《史记》而下，便是此书”。",
    "start": 36.095,
    "end": 40.6,
    "duration": 4.504
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 塑造观念：道德类型化 → 复杂性格化",
    "start": 41.161,
    "end": 45.144,
    "duration": 3.983
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "受正统观念与史实制约，偏重特征化定型，毛宗岗概括“智绝”诸葛、“义绝”关羽、“奸绝”曹操，高大却略单一；",
    "start": 45.731,
    "end": 56.824,
    "duration": 11.093
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "投向普通人与复杂人性：宋江兼具仗义豪气与忠君权谋，李逵兼有赤诚天真与粗鲁暴躁，打破非黑即白。",
    "start": 57.385,
    "end": 68.399,
    "duration": 11.015
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 性格机制：静态定型 → 环境逼出动态发展",
    "start": 68.986,
    "end": 73.751,
    "duration": 4.765
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "人物往往出场即定型，靠重大事件反复渲染既定特征；",
    "start": 74.338,
    "end": 80.287,
    "duration": 5.949
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "着力表现环境逼迫下的流动转变：林冲遭高太尉陷害初时屈从，野猪林后仍存幻想，",
    "start": 80.861,
    "end": 89.245,
    "duration": 8.384
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "直待山神庙听明毒计方杀仇上梁山，具深厚现实主义力。",
    "start": 89.533,
    "end": 94.714,
    "duration": 5.181
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 活动空间：庙堂战阵 → 市井江湖日常",
    "start": 95.275,
    "end": 99.441,
    "duration": 4.166
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "人物多活跃于朝堂谋议、会盟与沙场，富帝王将相威仪，少生活细碎描写；",
    "start": 100.015,
    "end": 107.657,
    "duration": 7.642
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "把英雄置入集市酒肆细民之间，",
    "start": 108.244,
    "end": 111.902,
    "duration": 3.658
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "擅写烟火动作：杨志卖刀之窘迫、武松醉打猛虎与在嫂嫂挑逗下从礼貌推辞到怒斥的细致过渡。",
    "start": 112.085,
    "end": 120.834,
    "duration": 8.749
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 叙事语言：浅近文白 → 纯熟个性化白话",
    "start": 121.421,
    "end": 126.173,
    "duration": 4.752
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "浅近文言文白相杂，庄重典雅却限制个性化口吻；",
    "start": 126.76,
    "end": 133.048,
    "duration": 6.288
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "纯熟北方白话口语达到金圣叹《读第五才子书法》所赞“一样人，便还他一样说话”：鲁智深豪爽、林冲斯文、李逵粗野跃然纸上。",
    "start": 133.621,
    "end": 145.469,
    "duration": 11.848
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "从《三国演义》到《水浒传》，长篇小说完成由政治类型向市井性格的跨越，",
    "start": 146.056,
    "end": 152.449,
    "duration": 6.392
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "由静态向动态、文白向纯熟白话演进，为《金瓶梅》《红楼梦》开辟道路。",
    "start": 152.723,
    "end": 159.454,
    "duration": 6.731
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：毛宗岗概括《三国演义》“智绝”“义绝”“奸绝”；",
    "start": 160.041,
    "end": 165.04,
    "duration": 4.999
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "明人唐顺之、王慎中赞《水浒传》“《史记》而下，便是此书”。",
    "start": 165.171,
    "end": 169.988,
    "duration": 4.817
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 《三国》到《水浒》在“观念、机制、空间、语言”四维完成了哪四次跃升？",
    "start": 170.549,
    "end": 178.269,
    "duration": 7.72
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 用“三绝”对比宋江/李逵/林冲，讲清“特征化”与“性格化”之别？",
    "start": 178.856,
    "end": 186.355,
    "duration": 7.499
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 列出《三国》《水浒》人物语言差异与金圣叹《读第五才子书法》名评？",
    "start": 186.929,
    "end": 193.985,
    "duration": 7.056
  }
]