[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "水浒三国比较·水浒传与三国演义人物塑造演进比较",
    "start": 0.354,
    "end": 4.806,
    "duration": 4.452
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "四重“由先向后”的长篇写人演进史：先是从道德类型（三绝）进化到复杂性格（宋江李逵），",
    "start": 5.774,
    "end": 15.186,
    "duration": 9.412
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再从出场即定型进化到环境逼变（林冲），接着从朝堂战场下沉到市井细事，",
    "start": 15.574,
    "end": 22.306,
    "duration": 6.732
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后由文白语体升级为纯熟个性口语。",
    "start": 22.694,
    "end": 25.746,
    "duration": 3.052
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《三国演义》与《水浒传》同胎息宋元说话伎艺。",
    "start": 26.714,
    "end": 30.606,
    "duration": 3.892
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "从前者到后者标志古代小说写人由“特征化”走向“性格化”演进，",
    "start": 31.574,
    "end": 38.266,
    "duration": 6.692
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "唐顺之、王慎中赞《水浒传》“《史记》而下，便是此书”。",
    "start": 38.654,
    "end": 43.466,
    "duration": 4.812
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 塑造观念：道德类型化 → 复杂性格化",
    "start": 44.354,
    "end": 48.606,
    "duration": 4.252
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "受正统观念与史实制约，偏重特征化定型，毛宗岗概括“智绝”诸葛、“义绝”关羽、“奸绝”曹操，高大却略单一；",
    "start": 49.694,
    "end": 60.906,
    "duration": 11.212
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "投向普通人与复杂人性：宋江兼具仗义豪气与忠君权谋，李逵兼有赤诚天真与粗鲁暴躁，打破非黑即白。",
    "start": 61.914,
    "end": 73.286,
    "duration": 11.372
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 性格机制：静态定型 → 环境逼出动态发展",
    "start": 74.254,
    "end": 78.426,
    "duration": 4.172
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "人物往往出场即定型，靠重大事件反复渲染既定特征；",
    "start": 79.474,
    "end": 85.206,
    "duration": 5.732
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "着力表现环境逼迫下的流动转变：林冲遭高太尉陷害初时屈从，野猪林后仍存幻想，",
    "start": 86.254,
    "end": 94.986,
    "duration": 8.732
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "直待山神庙听明毒计方杀仇上梁山，具深厚现实主义力。",
    "start": 95.294,
    "end": 100.986,
    "duration": 5.692
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 活动空间：庙堂战阵 → 市井江湖日常",
    "start": 101.914,
    "end": 106.646,
    "duration": 4.732
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "人物多活跃于朝堂谋议、会盟与沙场，富帝王将相威仪，少生活细碎描写；",
    "start": 107.514,
    "end": 115.246,
    "duration": 7.732
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "把英雄置入集市酒肆细民之间，",
    "start": 116.214,
    "end": 120.546,
    "duration": 4.332
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "擅写烟火动作：杨志卖刀之窘迫、武松醉打猛虎与在嫂嫂挑逗下从礼貌推辞到怒斥的细致过渡。",
    "start": 120.934,
    "end": 130.546,
    "duration": 9.612
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 叙事语言：浅近文白 → 纯熟个性化白话",
    "start": 131.514,
    "end": 136.406,
    "duration": 4.892
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "浅近文言文白相杂，庄重典雅却限制个性化口吻；",
    "start": 137.494,
    "end": 143.466,
    "duration": 5.972
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "纯熟北方白话口语达到金圣叹《读第五才子书法》所赞“一样人，便还他一样说话”：鲁智深豪爽、林冲斯文、李逵粗野跃然纸上。",
    "start": 144.474,
    "end": 157.686,
    "duration": 13.212
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "从《三国演义》到《水浒传》，长篇小说完成由政治类型向市井性格的跨越，",
    "start": 158.734,
    "end": 164.946,
    "duration": 6.212
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "由静态向动态、文白向纯熟白话演进，为《金瓶梅》《红楼梦》开辟道路。",
    "start": 165.374,
    "end": 172.586,
    "duration": 7.212
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：毛宗岗概括《三国演义》“智绝”“义绝”“奸绝”；",
    "start": 173.634,
    "end": 178.086,
    "duration": 4.452
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "明人唐顺之、王慎中赞《水浒传》“《史记》而下，便是此书”。",
    "start": 179.134,
    "end": 184.106,
    "duration": 4.972
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 《三国》到《水浒》在“观念、机制、空间、语言”四维完成了哪四次跃升？",
    "start": 185.074,
    "end": 192.806,
    "duration": 7.732
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 用“三绝”对比宋江/李逵/林冲，讲清“特征化”与“性格化”之别？",
    "start": 193.774,
    "end": 200.546,
    "duration": 6.772
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 列出《三国》《水浒》人物语言差异与金圣叹《读第五才子书法》名评？",
    "start": 201.554,
    "end": 208.486,
    "duration": 6.932
  }
]