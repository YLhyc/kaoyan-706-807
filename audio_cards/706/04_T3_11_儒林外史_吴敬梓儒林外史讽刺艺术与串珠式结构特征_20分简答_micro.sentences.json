[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《儒林外史》·吴敬梓儒林外史讽刺艺术与串珠式结构特征",
    "start": 0.134,
    "end": 4.86,
    "duration": 4.726
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "笔法→结构→理想三层收束：先用鲁迅“戚而能谐，婉而多讽”解透白描自露丑态的高段讽刺法，",
    "start": 5.449,
    "end": 14.536,
    "duration": 9.088
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再拆解“楔子王冕—中间接力—末回幽榜”的串珠结构，",
    "start": 14.798,
    "end": 19.601,
    "duration": 4.804
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后点明写批判之外仍设杜少卿等“真儒”精神标尺。",
    "start": 19.702,
    "end": 24.219,
    "duration": 4.517
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "吴敬梓《儒林外史》标志古代长篇讽刺小说成熟，",
    "start": 24.793,
    "end": 29.024,
    "duration": 4.231
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "鲁迅《中国小说史略》赞“秉持公心，指摘时弊……其文又戚而能谐，婉而多讽”。",
    "start": 29.312,
    "end": 36.068,
    "duration": 6.757
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 客观白描与矛盾对照：戚而能谐、婉而多讽",
    "start": 36.642,
    "end": 41.107,
    "duration": 4.465
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "摒弃浅露谩骂，用冷峻客观白描让人物在日常矛盾中自露真相，“无一贬词而情伪毕露”；",
    "start": 41.681,
    "end": 50.678,
    "duration": 8.996
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "严监生临终因两茎灯草不肯断气；",
    "start": 51.252,
    "end": 55.274,
    "duration": 4.022
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "范进中举前受尽胡屠户唾骂、发疯后则被奉为“文曲星”卑躬屈膝，滑稽中蕴受科举戕害之悲哀。",
    "start": 55.575,
    "end": 64.493,
    "duration": 8.918
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 首创以功名富贵为纲的“串珠式”结构",
    "start": 65.067,
    "end": 68.933,
    "duration": 3.866
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "鲁迅评“全书无主干，仅驱使各种人物，行列而来……虽云长篇，颇同短制”；",
    "start": 69.507,
    "end": 76.602,
    "duration": 7.095
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "以士人对功名富贵态度为内在主线，第一回王冕“楔子”敷陈大义，末回“幽榜”呼应，如丝穿珠串起两百余名人物。",
    "start": 77.189,
    "end": 87.475,
    "duration": 10.285
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 批判锋芒与“真儒理想”标尺并存",
    "start": 88.062,
    "end": 91.837,
    "duration": 3.775
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "剖析周进、范进、匡超人精神堕落之余，特意安排王冕、杜少卿、庄绍光及市井四大奇人不慕荣利、自食其力；",
    "start": 92.424,
    "end": 103.959,
    "duration": 11.535
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "树立崇尚德行与独立人格的标尺，深刻影响晚清谴责小说发展。",
    "start": 104.533,
    "end": 110.587,
    "duration": 6.054
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅《中国小说史略》评《儒林外史》“戚而能谐，婉而多讽”；",
    "start": 111.174,
    "end": 116.876,
    "duration": 5.702
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "概括结构为“虽云长篇，颇同短制”；",
    "start": 117.176,
    "end": 120.17,
    "duration": 2.994
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "第一回“楔子”是王冕，末回是“幽榜”。",
    "start": 120.379,
    "end": 123.282,
    "duration": 2.903
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背诵鲁迅《中国小说史略》评价《儒林外史》讽刺与结构的两句名言？",
    "start": 123.856,
    "end": 130.938,
    "duration": 7.082
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合严监生两茎灯草与范进胡屠户，解释何为“白描矛盾、无一贬词”？",
    "start": 131.525,
    "end": 139.35,
    "duration": 7.824
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ “功名富贵”串珠结构与“真儒理想”正面人物怎样互为支撑？",
    "start": 139.937,
    "end": 146.264,
    "duration": 6.327
  }
]