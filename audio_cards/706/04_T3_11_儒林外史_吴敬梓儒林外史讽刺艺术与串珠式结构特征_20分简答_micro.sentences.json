[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "笔法→结构→理想三层收束：先用鲁迅“戚而能谐，",
    "start": 0.0,
    "end": 5.24,
    "duration": 5.24
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "婉而多讽”解透白描自露丑态的高段讽刺法，",
    "start": 5.289,
    "end": 8.969,
    "duration": 3.68
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再拆解“楔子王冕—中间接力—末回幽榜”的串珠结构，",
    "start": 9.419,
    "end": 13.579,
    "duration": 4.16
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后点明写批判之外仍设杜少卿等“真儒”精神标尺。",
    "start": 14.029,
    "end": 18.389,
    "duration": 4.36
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "吴敬梓《儒林外史》标志古代长篇讽刺小说成熟，",
    "start": 18.919,
    "end": 22.519,
    "duration": 3.6
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "鲁迅《中国小说史略》赞“秉持公心，指摘时弊……其文又戚而能谐，婉而多讽”。",
    "start": 23.049,
    "end": 28.849,
    "duration": 5.8
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 客观白描与矛盾对照：戚而能谐、婉而多讽",
    "start": 29.299,
    "end": 33.579,
    "duration": 4.28
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "摒弃浅露谩骂，用冷峻客观白描让人物在日常矛盾中自露真相，",
    "start": 34.029,
    "end": 39.509,
    "duration": 5.48
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "“无一贬词而情伪毕露”；",
    "start": 39.959,
    "end": 41.919,
    "duration": 1.96
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "严监生临终因两茎灯草不肯断气；",
    "start": 42.369,
    "end": 45.409,
    "duration": 3.04
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "范进中举前受尽胡屠户唾骂、发疯后则被奉为“文曲星”卑躬屈膝，",
    "start": 45.859,
    "end": 51.259,
    "duration": 5.4
  },
  {
    "id": "sec0_step1_c2",
    "dom_key": "sec0_step1_c2",
    "text": "滑稽中蕴受科举戕害之悲哀。",
    "start": 51.789,
    "end": 54.109,
    "duration": 2.32
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 首创以功名富贵为纲的“串珠式”结构",
    "start": 54.559,
    "end": 58.399,
    "duration": 3.84
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "鲁迅评“全书无主干，仅驱使各种人物，行列而来……虽云长篇，颇同短制”；",
    "start": 58.849,
    "end": 64.769,
    "duration": 5.92
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "以士人对功名富贵态度为内在主线，第一回王冕“楔子”敷陈大义，",
    "start": 65.219,
    "end": 70.499,
    "duration": 5.28
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "末回“幽榜”呼应，如丝穿珠串起两百余名人物。",
    "start": 71.029,
    "end": 74.749,
    "duration": 3.72
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 批判锋芒与“真儒理想”标尺并存",
    "start": 75.319,
    "end": 78.959,
    "duration": 3.64
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "剖析周进、范进、匡超人精神堕落之余，",
    "start": 79.409,
    "end": 83.009,
    "duration": 3.6
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "特意安排王冕、杜少卿、庄绍光及市井四大奇人不慕荣利、自食其力；",
    "start": 83.459,
    "end": 88.979,
    "duration": 5.52
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "树立崇尚德行与独立人格的标尺，深刻影响晚清谴责小说发展。",
    "start": 89.429,
    "end": 94.669,
    "duration": 5.24
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅《中国小说史略》评《儒林外史》“戚而能谐，婉而多讽”；",
    "start": 95.119,
    "end": 100.599,
    "duration": 5.48
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "概括结构为“虽云长篇，颇同短制”；",
    "start": 101.049,
    "end": 104.049,
    "duration": 3.0
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "第一回“楔子”是王冕，末回是“幽榜”。",
    "start": 104.579,
    "end": 107.219,
    "duration": 2.64
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背诵鲁迅《中国小说史略》评价《儒林外史》讽刺与结构的两句名言？",
    "start": 107.669,
    "end": 113.869,
    "duration": 6.2
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合严监生两茎灯草与范进胡屠户，解释何为“白描矛盾、无一贬词”？",
    "start": 114.319,
    "end": 121.439,
    "duration": 7.12
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ “功名富贵”串珠结构与“真儒理想”正面人物怎样互为支撑？",
    "start": 121.889,
    "end": 127.849,
    "duration": 5.96
  }
]