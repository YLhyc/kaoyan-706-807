[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《儒林外史》·吴敬梓儒林外史讽刺艺术与串珠式结构特征",
    "start": 0.314,
    "end": 5.406,
    "duration": 5.092
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "笔法→结构→理想三层收束：先用鲁迅“戚而能谐，婉而多讽”解透白描自露丑态的高段讽刺法，",
    "start": 6.414,
    "end": 15.706,
    "duration": 9.292
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再拆解“楔子王冕—中间接力—末回幽榜”的串珠结构，",
    "start": 16.134,
    "end": 20.706,
    "duration": 4.572
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后点明写批判之外仍设杜少卿等“真儒”精神标尺。",
    "start": 21.134,
    "end": 25.706,
    "duration": 4.572
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "吴敬梓《儒林外史》标志古代长篇讽刺小说成熟，",
    "start": 26.634,
    "end": 30.566,
    "duration": 3.932
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "鲁迅《中国小说史略》赞“秉持公心，指摘时弊……其文又戚而能谐，婉而多讽”。",
    "start": 30.754,
    "end": 36.486,
    "duration": 5.732
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 客观白描与矛盾对照：戚而能谐、婉而多讽",
    "start": 37.414,
    "end": 42.306,
    "duration": 4.892
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "摒弃浅露谩骂，用冷峻客观白描让人物在日常矛盾中自露真相，“无一贬词而情伪毕露”；",
    "start": 43.314,
    "end": 52.406,
    "duration": 9.092
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "严监生临终因两茎灯草不肯断气；",
    "start": 53.414,
    "end": 57.226,
    "duration": 3.812
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "范进中举前受尽胡屠户唾骂、发疯后则被奉为“文曲星”卑躬屈膝，滑稽中蕴受科举戕害之悲哀。",
    "start": 58.194,
    "end": 67.486,
    "duration": 9.292
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 首创以功名富贵为纲的“串珠式”结构",
    "start": 68.454,
    "end": 72.826,
    "duration": 4.372
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "鲁迅评“全书无主干，仅驱使各种人物，行列而来……虽云长篇，颇同短制”；",
    "start": 73.794,
    "end": 81.646,
    "duration": 7.852
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "以士人对功名富贵态度为内在主线，第一回王冕“楔子”敷陈大义，末回“幽榜”呼应，如丝穿珠串起两百余名人物。",
    "start": 82.574,
    "end": 93.306,
    "duration": 10.732
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 批判锋芒与“真儒理想”标尺并存",
    "start": 94.194,
    "end": 97.806,
    "duration": 3.612
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "剖析周进、范进、匡超人精神堕落之余，特意安排王冕、杜少卿、庄绍光及市井四大奇人不慕荣利、自食其力；",
    "start": 98.594,
    "end": 108.246,
    "duration": 9.652
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "树立崇尚德行与独立人格的标尺，深刻影响晚清谴责小说发展。",
    "start": 109.294,
    "end": 115.626,
    "duration": 6.332
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅《中国小说史略》评《儒林外史》“戚而能谐，婉而多讽”；",
    "start": 116.634,
    "end": 122.446,
    "duration": 5.812
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "概括结构为“虽云长篇，颇同短制”；",
    "start": 123.414,
    "end": 126.706,
    "duration": 3.292
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "第一回“楔子”是王冕，末回是“幽榜”。",
    "start": 127.674,
    "end": 130.566,
    "duration": 2.892
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背诵鲁迅《中国小说史略》评价《儒林外史》讽刺与结构的两句名言？",
    "start": 131.494,
    "end": 139.346,
    "duration": 7.852
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合严监生两茎灯草与范进胡屠户，解释何为“白描矛盾、无一贬词”？",
    "start": 140.354,
    "end": 148.646,
    "duration": 8.292
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ “功名富贵”串珠结构与“真儒理想”正面人物怎样互为支撑？",
    "start": 149.144,
    "end": 155.716,
    "duration": 6.572
  }
]