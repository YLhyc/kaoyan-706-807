[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《儒林外史》·吴敬梓儒林外史讽刺艺术与串珠式结构特征",
    "start": 0.134,
    "end": 4.786,
    "duration": 4.652
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "笔法→结构→理想三层收束：先用鲁迅“戚而能谐，婉而多讽”解透白描自露丑态的高段讽刺法，",
    "start": 5.26,
    "end": 15.432,
    "duration": 10.172
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再拆解“楔子王冕—中间接力—末回幽榜”的串珠结构，",
    "start": 15.74,
    "end": 20.952,
    "duration": 5.212
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后点明写批判之外仍设杜少卿等“真儒”精神标尺。",
    "start": 21.26,
    "end": 26.392,
    "duration": 5.132
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "吴敬梓《儒林外史》标志古代长篇讽刺小说成熟，",
    "start": 26.885,
    "end": 30.657,
    "duration": 3.772
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "鲁迅《中国小说史略》赞“秉持公心，指摘时弊……其文又戚而能谐，婉而多讽”。",
    "start": 30.885,
    "end": 37.777,
    "duration": 6.892
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 客观白描与矛盾对照：戚而能谐、婉而多讽",
    "start": 38.396,
    "end": 43.128,
    "duration": 4.732
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "摒弃浅露谩骂，用冷峻客观白描让人物在日常矛盾中自露真相，“无一贬词而情伪毕露”；",
    "start": 43.604,
    "end": 53.136,
    "duration": 9.532
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "严监生临终因两茎灯草不肯断气；",
    "start": 53.598,
    "end": 57.93,
    "duration": 4.332
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "范进中举前受尽胡屠户唾骂、发疯后则被奉为“文曲星”卑躬屈膝，滑稽中蕴受科举戕害之悲哀。",
    "start": 58.368,
    "end": 68.14,
    "duration": 9.772
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 首创以功名富贵为纲的“串珠式”结构",
    "start": 68.831,
    "end": 72.763,
    "duration": 3.932
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "鲁迅评“全书无主干，仅驱使各种人物，行列而来……虽云长篇，颇同短制”；",
    "start": 73.264,
    "end": 80.796,
    "duration": 7.532
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "以士人对功名富贵态度为内在主线，第一回王冕“楔子”敷陈大义，末回“幽榜”呼应，如丝穿珠串起两百余名人物。",
    "start": 81.274,
    "end": 91.286,
    "duration": 10.012
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 批判锋芒与“真儒理想”标尺并存",
    "start": 91.952,
    "end": 95.164,
    "duration": 3.212
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "剖析周进、范进、匡超人精神堕落之余，特意安排王冕、杜少卿、庄绍光及市井四大奇人不慕荣利、自食其力；",
    "start": 95.692,
    "end": 105.784,
    "duration": 10.092
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "树立崇尚德行与独立人格的标尺，深刻影响晚清谴责小说发展。",
    "start": 106.305,
    "end": 112.797,
    "duration": 6.492
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅《中国小说史略》评《儒林外史》“戚而能谐，婉而多讽”；",
    "start": 113.449,
    "end": 119.141,
    "duration": 5.692
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "概括结构为“虽云长篇，颇同短制”；",
    "start": 119.419,
    "end": 122.551,
    "duration": 3.132
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "第一回“楔子”是王冕，末回是“幽榜”。",
    "start": 122.829,
    "end": 125.641,
    "duration": 2.812
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背诵鲁迅《中国小说史略》评价《儒林外史》讽刺与结构的两句名言？",
    "start": 126.271,
    "end": 132.843,
    "duration": 6.572
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合严监生两茎灯草与范进胡屠户，解释何为“白描矛盾、无一贬词”？",
    "start": 133.368,
    "end": 140.58,
    "duration": 7.212
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ “功名富贵”串珠结构与“真儒理想”正面人物怎样互为支撑？",
    "start": 141.094,
    "end": 146.946,
    "duration": 5.852
  }
]