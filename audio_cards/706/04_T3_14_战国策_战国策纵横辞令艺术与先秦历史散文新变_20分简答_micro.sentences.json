[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《战国策》·纵横辞令艺术与先秦历史散文新变",
    "start": 0.134,
    "end": 4.339,
    "duration": 4.205
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "中心人物→说理策略→语言风势三步新变：先看出《战国策》如何从写国君礼法转为以“士”为主角甚至大胆虚构戏剧冲突，",
    "start": 4.915,
    "end": 16.932,
    "duration": 12.017
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再看策士游说人主怎样靠《邹忌》《触龙》及寓言化解政争，",
    "start": 17.232,
    "end": 22.149,
    "duration": 4.917
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后标举“辩丽横肆”铺张雄风直启贾谊《过秦论》与《史记》。",
    "start": 22.398,
    "end": 27.136,
    "duration": 4.739
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《战国策》经西汉刘向编校定名，记录战国策士游说诸侯之谋议论辩，",
    "start": 27.723,
    "end": 33.633,
    "duration": 5.91
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "跳出《左传》《国语》礼法写史框范，彰显士阶层崛起。",
    "start": 33.856,
    "end": 38.412,
    "duration": 4.556
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 以“士”阶层为中心、自觉运用虚构想象",
    "start": 38.999,
    "end": 42.865,
    "duration": 3.866
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "较之《左传》重国君卿相，张扬“士贵耳，王者不贵”，聚焦苏秦、张仪、荆轲、鲁仲连等各色策士；",
    "start": 43.452,
    "end": 53.113,
    "duration": 9.66
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "突破实录限制，靠夸张动作与戏剧冲突写活神采，如《荆轲刺秦王》易水饯行、“图穷而匕首见”富有小说感。",
    "start": 53.7,
    "end": 64.506,
    "duration": 10.806
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 善借寓言譬喻婉转讽谏、增强机锋",
    "start": 65.08,
    "end": 69.128,
    "duration": 4.049
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "以小见大化解政争：《齐策》邹忌借与徐公比美剖析受蔽之由；",
    "start": 69.715,
    "end": 75.782,
    "duration": 6.067
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "《赵策》触龙以“父母之爱子，则为之计深远”打动赵太后；",
    "start": 76.043,
    "end": 80.808,
    "duration": 4.765
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "辅以狐假虎威、画蛇添足等生动寓言，说理透辟余味盎然。",
    "start": 81.395,
    "end": 87.501,
    "duration": 6.106
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 由雅驯转向“辩丽横肆”、启迪汉代文风",
    "start": 88.088,
    "end": 92.54,
    "duration": 4.452
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "春秋辞令从容婉转，《战国策》善排比、铺张、层层设难压倒对方，谓之“辩丽横肆”（如苏秦合纵雄辩）；",
    "start": 93.127,
    "end": 103.686,
    "duration": 10.559
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "标志先秦叙事语言新高度，直接影响汉代贾谊《过秦论》气势及《史记》策士群像刻画。",
    "start": 104.26,
    "end": 112.67,
    "duration": 8.41
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：由西汉刘向编校定名；前人概括其文风为“辩丽横肆”；",
    "start": 113.257,
    "end": 119.206,
    "duration": 5.95
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "核心名篇记住《荆轲刺秦王》《邹忌讽齐王纳谏》《触龙说赵太后》。",
    "start": 119.52,
    "end": 125.001,
    "duration": 5.481
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 何人编校定名《战国策》？",
    "start": 125.588,
    "end": 129.063,
    "duration": 3.476
  },
  {
    "id": "drill0_c1",
    "dom_key": "drill0_c1",
    "text": "前人概括其文风为哪四个字？",
    "start": 129.637,
    "end": 131.915,
    "duration": 2.278
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 《战国策》相对《左传》完成了哪三大叙事新变？",
    "start": 132.489,
    "end": 137.553,
    "duration": 5.064
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 熟记《荆轲》《邹忌》《触龙》三名篇及对贾谊《过秦论》《史记》的影响？",
    "start": 138.127,
    "end": 145.157,
    "duration": 7.03
  }
]