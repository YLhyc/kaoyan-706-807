[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《战国策》·纵横辞令艺术与先秦历史散文新变",
    "start": 0.134,
    "end": 4.706,
    "duration": 4.572
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "中心人物→说理策略→语言风势三步新变：先看出《战国策》如何从写国君礼法转为以“士”为主角甚至大胆虚构戏剧冲突，",
    "start": 5.173,
    "end": 16.705,
    "duration": 11.532
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再看策士游说人主怎样靠《邹忌》《触龙》及寓言化解政争，",
    "start": 17.013,
    "end": 21.825,
    "duration": 4.812
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后标举“辩丽横肆”铺张雄风直启贾谊《过秦论》与《史记》。",
    "start": 22.053,
    "end": 27.105,
    "duration": 5.052
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《战国策》经西汉刘向编校定名，记录战国策士游说诸侯之谋议论辩，",
    "start": 27.533,
    "end": 34.445,
    "duration": 6.912
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "跳出《左传》《国语》礼法写史框范，彰显士阶层崛起。",
    "start": 34.46,
    "end": 39.465,
    "duration": 5.005
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 以“士”阶层为中心、自觉运用虚构想象",
    "start": 39.935,
    "end": 44.187,
    "duration": 4.252
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "较之《左传》重国君卿相，张扬“士贵耳，王者不贵”，聚焦苏秦、张仪、荆轲、鲁仲连等各色策士；",
    "start": 44.715,
    "end": 53.767,
    "duration": 9.052
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "突破实录限制，靠夸张动作与戏剧冲突写活神采，如《荆轲刺秦王》易水饯行、“图穷而匕首见”富有小说感。",
    "start": 54.295,
    "end": 65.027,
    "duration": 10.732
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 善借寓言譬喻婉转讽谏、增强机锋",
    "start": 65.646,
    "end": 69.658,
    "duration": 4.012
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "以小见大化解政争：《齐策》邹忌借与徐公比美剖析受蔽之由；",
    "start": 70.186,
    "end": 76.598,
    "duration": 6.412
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "《赵策》触龙以“父母之爱子，则为之计深远”打动赵太后；",
    "start": 76.876,
    "end": 81.688,
    "duration": 4.812
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "辅以狐假虎威、画蛇添足等生动寓言，说理透辟余味盎然。",
    "start": 81.946,
    "end": 89.238,
    "duration": 7.292
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 由雅驯转向“辩丽横肆”、启迪汉代文风",
    "start": 89.859,
    "end": 94.511,
    "duration": 4.652
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "春秋辞令从容婉转，《战国策》善排比、铺张、层层设难压倒对方，谓之“辩丽横肆”（如苏秦合纵雄辩）；",
    "start": 95.005,
    "end": 105.977,
    "duration": 10.972
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "标志先秦叙事语言新高度，直接影响汉代贾谊《过秦论》气势及《史记》策士群像刻画。",
    "start": 106.505,
    "end": 114.757,
    "duration": 8.252
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：由西汉刘向编校定名；前人概括其文风为“辩丽横肆”；",
    "start": 115.46,
    "end": 121.682,
    "duration": 6.222
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "核心名篇记住《荆轲刺秦王》《邹忌讽齐王纳谏》《触龙说赵太后》。",
    "start": 122.04,
    "end": 127.732,
    "duration": 5.692
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 何人编校定名《战国策》？",
    "start": 128.384,
    "end": 131.836,
    "duration": 3.452
  },
  {
    "id": "drill0_c1",
    "dom_key": "drill0_c1",
    "text": "前人概括其文风为哪四个字？",
    "start": 132.194,
    "end": 134.446,
    "duration": 2.252
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 《战国策》相对《左传》完成了哪三大叙事新变？",
    "start": 134.925,
    "end": 139.497,
    "duration": 4.572
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 熟记《荆轲》《邹忌》《触龙》三名篇及对贾谊《过秦论》《史记》的影响？",
    "start": 139.921,
    "end": 146.493,
    "duration": 6.572
  }
]