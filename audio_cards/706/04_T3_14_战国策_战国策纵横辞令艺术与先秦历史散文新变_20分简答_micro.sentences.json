[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《战国策》·纵横辞令艺术与先秦历史散文新变",
    "start": 0.314,
    "end": 4.646,
    "duration": 4.332
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "中心人物→说理策略→语言风势三步新变：先看出《战国策》如何从写国君礼法转为以“士”为主角甚至大胆虚构戏剧冲突，",
    "start": 5.614,
    "end": 17.546,
    "duration": 11.932
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再看策士游说人主怎样靠《邹忌》《触龙》及寓言化解政争，",
    "start": 17.774,
    "end": 22.946,
    "duration": 5.172
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后标举“辩丽横肆”铺张雄风直启贾谊《过秦论》与《史记》。",
    "start": 23.334,
    "end": 28.106,
    "duration": 4.772
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《战国策》经西汉刘向编校定名，记录战国策士游说诸侯之谋议论辩，",
    "start": 29.074,
    "end": 35.246,
    "duration": 6.172
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "跳出《左传》《国语》礼法写史框范，彰显士阶层崛起。",
    "start": 35.394,
    "end": 40.086,
    "duration": 4.692
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 以“士”阶层为中心、自觉运用虚构想象",
    "start": 41.054,
    "end": 45.066,
    "duration": 4.012
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "较之《左传》重国君卿相，张扬“士贵耳，王者不贵”，聚焦苏秦、张仪、荆轲、鲁仲连等各色策士；",
    "start": 46.114,
    "end": 55.446,
    "duration": 9.332
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "突破实录限制，靠夸张动作与戏剧冲突写活神采，如《荆轲刺秦王》易水饯行、“图穷而匕首见”富有小说感。",
    "start": 56.454,
    "end": 68.026,
    "duration": 11.572
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 善借寓言譬喻婉转讽谏、增强机锋",
    "start": 68.994,
    "end": 72.966,
    "duration": 3.972
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "以小见大化解政争：《齐策》邹忌借与徐公比美剖析受蔽之由；",
    "start": 74.054,
    "end": 80.866,
    "duration": 6.812
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "《赵策》触龙以“父母之爱子，则为之计深远”打动赵太后；",
    "start": 81.914,
    "end": 86.606,
    "duration": 4.692
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "辅以狐假虎威、画蛇添足等生动寓言，说理透辟余味盎然。",
    "start": 87.614,
    "end": 93.626,
    "duration": 6.012
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 由雅驯转向“辩丽横肆”、启迪汉代文风",
    "start": 94.634,
    "end": 99.006,
    "duration": 4.372
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "春秋辞令从容婉转，《战国策》善排比、铺张、层层设难压倒对方，谓之“辩丽横肆”（如苏秦合纵雄辩）；",
    "start": 99.746,
    "end": 109.438,
    "duration": 9.692
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "标志先秦叙事语言新高度，直接影响汉代贾谊《过秦论》气势及《史记》策士群像刻画。",
    "start": 110.446,
    "end": 118.618,
    "duration": 8.172
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：由西汉刘向编校定名；前人概括其文风为“辩丽横肆”；",
    "start": 119.666,
    "end": 126.038,
    "duration": 6.372
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "核心名篇记住《荆轲刺秦王》《邹忌讽齐王纳谏》《触龙说赵太后》。",
    "start": 127.086,
    "end": 132.858,
    "duration": 5.772
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 何人编校定名《战国策》？",
    "start": 133.826,
    "end": 137.038,
    "duration": 3.212
  },
  {
    "id": "drill0_c1",
    "dom_key": "drill0_c1",
    "text": "前人概括其文风为哪四个字？",
    "start": 138.046,
    "end": 140.498,
    "duration": 2.452
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 《战国策》相对《左传》完成了哪三大叙事新变？",
    "start": 140.902,
    "end": 145.994,
    "duration": 5.092
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 熟记《荆轲》《邹忌》《触龙》三名篇及对贾谊《过秦论》《史记》的影响？",
    "start": 146.922,
    "end": 154.854,
    "duration": 7.932
  }
]