[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "中心人物→说理策略→语言风势三步新变：先看出《战国策》如何从写国君礼法转为以“士”为主角甚至大胆虚构戏剧冲突，",
    "start": 0.222,
    "end": 11.21,
    "duration": 10.988
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再看策士游说人主怎样靠《邹忌》《触龙》及寓言化解政争，",
    "start": 11.956,
    "end": 16.834,
    "duration": 4.878
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后标举“辩丽横肆”铺张雄风直启贾谊《过秦论》与《史记》。",
    "start": 17.586,
    "end": 21.995,
    "duration": 4.409
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《战国策》经西汉刘向编校定名，记录战国策士游说诸侯之谋议论辩，",
    "start": 22.729,
    "end": 28.539,
    "duration": 5.81
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "跳出《左传》《国语》礼法写史框范，彰显士阶层崛起。",
    "start": 29.295,
    "end": 33.392,
    "duration": 4.097
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 以“士”阶层为中心、自觉运用虚构想象",
    "start": 34.131,
    "end": 37.889,
    "duration": 3.757
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "较之《左传》重国君卿相，张扬“士贵耳，王者不贵”，聚焦苏秦、张仪、荆轲、鲁仲连等各色策士；",
    "start": 38.622,
    "end": 47.16,
    "duration": 8.538
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "突破实录限制，靠夸张动作与戏剧冲突写活神采，",
    "start": 47.863,
    "end": 52.41,
    "duration": 4.547
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "如《荆轲刺秦王》易水饯行、“图穷而匕首见”富有小说感。",
    "start": 53.193,
    "end": 57.89,
    "duration": 4.697
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 善借寓言譬喻婉转讽谏、增强机锋",
    "start": 58.639,
    "end": 62.581,
    "duration": 3.942
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "以小见大化解政争：《齐策》邹忌借与徐公比美剖析受蔽之由；",
    "start": 63.315,
    "end": 68.232,
    "duration": 4.917
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "《赵策》触龙以“父母之爱子，则为之计深远”打动赵太后；",
    "start": 68.953,
    "end": 73.119,
    "duration": 4.166
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "辅以狐假虎威、画蛇添足等生动寓言，说理透辟余味盎然。",
    "start": 73.854,
    "end": 78.789,
    "duration": 4.935
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 由雅驯转向“辩丽横肆”、启迪汉代文风",
    "start": 79.476,
    "end": 83.803,
    "duration": 4.327
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "春秋辞令从容婉转，《战国策》善排比、铺张、层层设难压倒对方，",
    "start": 84.515,
    "end": 90.261,
    "duration": 5.746
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "谓之“辩丽横肆”（如苏秦合纵雄辩）；",
    "start": 90.995,
    "end": 93.941,
    "duration": 2.946
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "标志先秦叙事语言新高度，直接影响汉代贾谊《过秦论》气势及《史记》策士群像刻画。",
    "start": 94.677,
    "end": 101.656,
    "duration": 6.979
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：由西汉刘向编校定名；",
    "start": 102.446,
    "end": 105.243,
    "duration": 2.798
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "前人概括其文风为“辩丽横肆”；",
    "start": 105.977,
    "end": 108.4,
    "duration": 2.423
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "核心名篇记住《荆轲刺秦王》《邹忌讽齐王纳谏》《触龙说赵太后》。",
    "start": 109.196,
    "end": 114.425,
    "duration": 5.229
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 何人编校定名《战国策》？",
    "start": 115.178,
    "end": 118.474,
    "duration": 3.296
  },
  {
    "id": "drill0_c1",
    "dom_key": "drill0_c1",
    "text": "前人概括其文风为哪四个字？",
    "start": 119.189,
    "end": 121.356,
    "duration": 2.167
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 《战国策》相对《左传》完成了哪三大叙事新变？",
    "start": 122.063,
    "end": 126.949,
    "duration": 4.886
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 熟记《荆轲》《邹忌》《触龙》三名篇及对贾谊《过秦论》《史记》的影响？",
    "start": 127.731,
    "end": 134.32,
    "duration": 6.589
  }
]