[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "中心人物→说理策略→语言风势三步新变：",
    "start": 0.0,
    "end": 4.48,
    "duration": 4.48
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先看出《战国策》如何从写国君礼法转为以“士”为主角甚至大胆虚构戏剧冲突，",
    "start": 4.529,
    "end": 10.609,
    "duration": 6.08
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再看策士游说人主怎样靠《邹忌》《触龙》及寓言化解政争，",
    "start": 11.059,
    "end": 15.539,
    "duration": 4.48
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后标举“辩丽横肆”铺张雄风直启贾谊《过秦论》与《史记》。",
    "start": 15.989,
    "end": 20.709,
    "duration": 4.72
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《战国策》经西汉刘向编校定名，记录战国策士游说诸侯之谋议论辩，",
    "start": 21.279,
    "end": 26.559,
    "duration": 5.28
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "跳出《左传》《国语》礼法写史框范，彰显士阶层崛起。",
    "start": 27.009,
    "end": 30.689,
    "duration": 3.68
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 以“士”阶层为中心、自觉运用虚构想象",
    "start": 31.219,
    "end": 35.059,
    "duration": 3.84
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "较之《左传》重国君卿相，张扬“士贵耳，王者不贵”，",
    "start": 35.509,
    "end": 39.589,
    "duration": 4.08
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "聚焦苏秦、张仪、荆轲、鲁仲连等各色策士；",
    "start": 40.119,
    "end": 44.119,
    "duration": 4.0
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "突破实录限制，靠夸张动作与戏剧冲突写活神采，",
    "start": 44.569,
    "end": 48.809,
    "duration": 4.24
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "如《荆轲刺秦王》易水饯行、“图穷而匕首见”富有小说感。",
    "start": 49.259,
    "end": 53.819,
    "duration": 4.56
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 善借寓言譬喻婉转讽谏、增强机锋",
    "start": 54.269,
    "end": 58.269,
    "duration": 4.0
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "以小见大化解政争：《齐策》邹忌借与徐公比美剖析受蔽之由；",
    "start": 58.719,
    "end": 63.959,
    "duration": 5.24
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "《赵策》触龙以“父母之爱子，则为之计深远”打动赵太后；",
    "start": 64.409,
    "end": 68.689,
    "duration": 4.28
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "辅以狐假虎威、画蛇添足等生动寓言，说理透辟余味盎然。",
    "start": 69.219,
    "end": 74.299,
    "duration": 5.08
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 由雅驯转向“辩丽横肆”、启迪汉代文风",
    "start": 74.749,
    "end": 78.829,
    "duration": 4.08
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "春秋辞令从容婉转，《战国策》善排比、铺张、层层设难压倒对方，",
    "start": 79.279,
    "end": 84.839,
    "duration": 5.56
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "谓之“辩丽横肆”（如苏秦合纵雄辩）；",
    "start": 85.369,
    "end": 88.209,
    "duration": 2.84
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "标志先秦叙事语言新高度，",
    "start": 88.659,
    "end": 90.859,
    "duration": 2.2
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "直接影响汉代贾谊《过秦论》气势及《史记》策士群像刻画。",
    "start": 91.309,
    "end": 95.869,
    "duration": 4.56
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：由西汉刘向编校定名；",
    "start": 96.319,
    "end": 98.959,
    "duration": 2.64
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "前人概括其文风为“辩丽横肆”；",
    "start": 99.409,
    "end": 101.929,
    "duration": 2.52
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "核心名篇记住《荆轲刺秦王》《邹忌讽齐王纳谏》《触龙说赵太后》。",
    "start": 102.459,
    "end": 108.059,
    "duration": 5.6
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 何人编校定名《战国策》？",
    "start": 108.509,
    "end": 111.149,
    "duration": 2.64
  },
  {
    "id": "drill0_c1",
    "dom_key": "drill0_c1",
    "text": "前人概括其文风为哪四个字？",
    "start": 111.679,
    "end": 113.999,
    "duration": 2.32
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 《战国策》相对《左传》完成了哪三大叙事新变？",
    "start": 114.449,
    "end": 119.249,
    "duration": 4.8
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 熟记《荆轲》《邹忌》《触龙》三名篇及对贾谊《过秦论》《史记》的影响？",
    "start": 119.699,
    "end": 126.419,
    "duration": 6.72
  }
]