[
  {
    "id": 1,
    "text": "试论陆游爱国诗作的艺术特质及其在南宋诗坛的历史地位。",
    "start": 0.28,
    "end": 4.92,
    "duration": 4.64
  },
  {
    "id": 2,
    "text": "陆游是“中兴四大诗人”之中成就最著的代表，也是中国古代最为杰出的爱国诗人。",
    "start": 5.44,
    "end": 12.0,
    "duration": 6.56
  },
  {
    "id": 3,
    "text": "面对靖康南渡后半壁江山沦丧、朝廷偷安的严酷现实，",
    "start": 12.52,
    "end": 16.52,
    "duration": 4.0
  },
  {
    "id": 4,
    "text": "陆游终生高擎抗敌复国大旗，在吸取江西诗派“活法”基础上融合李白飘逸与杜甫沉郁，",
    "start": 16.89,
    "end": 24.65,
    "duration": 7.76
  },
  {
    "id": 5,
    "text": "以九千余首宏富创作为疲弱萎靡的南宋诗风注入刚健昂扬的时代强音。",
    "start": 25.02,
    "end": 31.34,
    "duration": 6.32
  },
  {
    "id": 6,
    "text": "其创作成就主要体现在以下四个方面：",
    "start": 31.86,
    "end": 34.66,
    "duration": 2.8
  },
  {
    "id": 7,
    "text": "第一，以抗敌复国贯穿一生创作，抒发壮志难酬与忧民痛国之慨。",
    "start": 35.03,
    "end": 41.43,
    "duration": 6.4
  },
  {
    "id": 8,
    "text": "民族矛盾与收复失地的渴望是陆诗最核心的精神命脉。",
    "start": 41.95,
    "end": 46.43,
    "duration": 4.48
  },
  {
    "id": 9,
    "text": "南宋绍兴和议以后诸多士人趋向消极，陆游却至死不渝。",
    "start": 46.95,
    "end": 51.75,
    "duration": 4.8
  },
  {
    "id": 10,
    "text": "他写《关山月》“和戎诏下十五年，将军不战空临边”，",
    "start": 52.27,
    "end": 56.83,
    "duration": 4.56
  },
  {
    "id": 11,
    "text": "借老戍卒视角痛斥权贵苟安、征人老死沙场；",
    "start": 57.2,
    "end": 61.024,
    "duration": 3.824
  },
  {
    "id": 12,
    "text": "写《书愤》追怀“楼船夜雪瓜洲渡，铁马秋风大散关”的豪情，",
    "start": 61.524,
    "end": 66.89,
    "duration": 5.366
  },
  {
    "id": 13,
    "text": "继以“塞上长城空自许，镜中衰鬓已先斑”抒报国无门之痛；",
    "start": 67.26,
    "end": 72.86,
    "duration": 5.6
  },
  {
    "id": 14,
    "text": "临终《示儿》仍嘱咐“王师北定中原日，家祭无忘告乃翁”。",
    "start": 73.38,
    "end": 78.9,
    "duration": 5.52
  },
  {
    "id": 15,
    "text": "清末梁启超赞其“亘古男儿一放翁”，足证其爱国精神穿透千古的感染力。",
    "start": 79.465,
    "end": 85.591,
    "duration": 6.126
  },
  {
    "id": 16,
    "text": "第二，兼融李白飘逸奇想与杜甫沉郁悲凉，于豪放中寓平易晓畅。",
    "start": 86.111,
    "end": 92.271,
    "duration": 6.16
  },
  {
    "id": 17,
    "text": "理想与现实的尖锐矛盾造就了陆诗刚健又沉痛的艺术风貌。",
    "start": 92.791,
    "end": 97.823,
    "duration": 5.032
  },
  {
    "id": 18,
    "text": "因现实报国无路，陆游常借助梦幻奇想排遣壮志，",
    "start": 98.323,
    "end": 102.511,
    "duration": 4.188
  },
  {
    "id": 19,
    "text": "如《十一月四日风雨大作》“夜阑卧听风吹雨，铁马冰河入梦来”，如李白般奔放驰骋；",
    "start": 102.881,
    "end": 110.161,
    "duration": 7.28
  },
  {
    "id": 20,
    "text": "而在《三月十七日夜醉中作》里写梦醒回归孤灯破驿，",
    "start": 110.681,
    "end": 114.921,
    "duration": 4.24
  },
  {
    "id": 21,
    "text": "则流露“破驿梦回灯欲死，打窗风雨正三更”的沉郁悲慨，直追杜甫之沉雄。",
    "start": 115.291,
    "end": 121.451,
    "duration": 6.16
  },
  {
    "id": 22,
    "text": "同时，陆游虽师承曾几并私淑吕本中，却跳出江西诗派堆砌生涩典故的牢笼，",
    "start": 121.971,
    "end": 128.981,
    "duration": 7.01
  },
  {
    "id": 23,
    "text": "用明朗晓畅的语言驾驭严整章法，正合赵翼《瓯北诗话》“看似奔放实则谨严”之评。",
    "start": 129.381,
    "end": 137.061,
    "duration": 7.68
  },
  {
    "id": 24,
    "text": "第三，广摄村居日常与沈园真情，尤擅对仗工稳的七言律绝。",
    "start": 137.581,
    "end": 143.661,
    "duration": 6.08
  },
  {
    "id": 25,
    "text": "除了沙场铁马，陆游亦善于从田园琐事与人生真情中采撷诗意。",
    "start": 144.225,
    "end": 149.621,
    "duration": 5.396
  },
  {
    "id": 26,
    "text": "《游山西村》“山重水复疑无路，柳暗花明又一村”与《临安春雨初霁》“小楼一夜听春雨，深巷明朝卖杏花”，",
    "start": 150.141,
    "end": 159.951,
    "duration": 9.81
  },
  {
    "id": 27,
    "text": "清丽自然中见和平生活之爱；",
    "start": 160.321,
    "end": 162.961,
    "duration": 2.64
  },
  {
    "id": 28,
    "text": "晚年《沈园》二首追忆前妻唐氏，“伤心桥下春波绿，曾是惊鸿照影来”，深挚动人。",
    "start": 163.481,
    "end": 170.761,
    "duration": 7.28
  },
  {
    "id": 29,
    "text": "体裁上，陆游七古、七律、七绝均造诣极高，",
    "start": 171.281,
    "end": 175.281,
    "duration": 4.0
  },
  {
    "id": 30,
    "text": "尤以七律对仗工整而不显纤巧著称，刘克庄赞其“古人好对偶被放翁用尽”。",
    "start": 175.651,
    "end": 182.931,
    "duration": 7.28
  },
  {
    "id": 31,
    "text": "第四，扭转南宋中后期颓靡诗风，激励后代爱国救亡文学。",
    "start": 183.451,
    "end": 188.651,
    "duration": 5.2
  },
  {
    "id": 32,
    "text": "陆游以黄钟大吕之音取代江西诗派末流的枯燥乏味，与杨万里、范成大等共同推动宋诗在南渡后开辟新生面。",
    "start": 189.171,
    "end": 198.999,
    "duration": 9.828
  },
  {
    "id": 33,
    "text": "宋末爱国诗人林景熙称赞其继承杜甫诗史传统，江湖诗派戴复古、刘克庄亦深受其诗风熏陶。",
    "start": 199.499,
    "end": 207.931,
    "duration": 8.432
  },
  {
    "id": 34,
    "text": "尽管晚年部分闲居诗作稍显滑易重复，但其毕生秉持的家国大义，",
    "start": 208.451,
    "end": 214.131,
    "duration": 5.68
  },
  {
    "id": 35,
    "text": "在近代国难之际持续感召后世救亡诗篇。",
    "start": 214.501,
    "end": 217.861,
    "duration": 3.36
  },
  {
    "id": 36,
    "text": "综上所述，陆游面对南宋偏安危局，",
    "start": 218.381,
    "end": 221.421,
    "duration": 3.04
  },
  {
    "id": 37,
    "text": "将抗敌复国的终身执念与平易晓畅的诗风融为一体，",
    "start": 221.791,
    "end": 225.951,
    "duration": 4.16
  },
  {
    "id": 38,
    "text": "在吸收江西诗派句法的同时兼融李白豪迈与杜甫沉郁，以九千余首创作为南宋诗坛注入刚健气象。",
    "start": 226.321,
    "end": 234.801,
    "duration": 8.48
  },
  {
    "id": 39,
    "text": "他与杨万里、范成大等共同推动宋诗挣脱末流枯燥而开出新生面，",
    "start": 235.321,
    "end": 241.081,
    "duration": 5.76
  },
  {
    "id": 40,
    "text": "其爱国精神与雄浑声调亦在后代国难文学中持续激荡。",
    "start": 241.451,
    "end": 246.251,
    "duration": 4.8
  }
]
