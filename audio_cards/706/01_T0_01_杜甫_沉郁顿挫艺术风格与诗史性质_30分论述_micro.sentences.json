[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "杜甫·沉郁顿挫艺术风格与诗史性质",
    "start": 0.134,
    "end": 3.492,
    "duration": 3.358
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "安史乱世激发儒家仁心，先定下“沉郁顿挫”审美底色，",
    "start": 4.081,
    "end": 9.562,
    "duration": 5.481
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "进而迫使其突破盛唐兴象写下古体“诗史”，同时把家国悲慨注入近体律诗锤炼至极，",
    "start": 9.889,
    "end": 17.661,
    "duration": 7.772
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最终承前启后为唐宋三派确立宗师法门。",
    "start": 17.762,
    "end": 21.654,
    "duration": 3.892
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "杜甫是中国古典诗歌现实主义传统集大成者。",
    "start": 22.228,
    "end": 26.029,
    "duration": 3.801
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "安史之乱之际，他将个人身世之悲与国家兴亡之痛融为一体，以沉郁顿挫风范与即事名篇笔法，",
    "start": 26.616,
    "end": 35.001,
    "duration": 8.384
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "真实记录动乱年代民生疾苦，确立“诗圣”地位。",
    "start": 35.314,
    "end": 39.454,
    "duration": 4.14
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 标举“沉郁顿挫”核心风格",
    "start": 40.041,
    "end": 42.982,
    "duration": 2.942
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "标举“沉郁顿挫”风格特质：“沉郁”侧重悲慨深厚（源于仁心）；",
    "start": 43.569,
    "end": 49.376,
    "duration": 5.806
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "“顿挫”指声调抑扬、波浪起伏与反复低回（源于儒家中和节制）。",
    "start": 49.676,
    "end": 55.287,
    "duration": 5.611
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《自京赴奉先县咏怀五百字》：①抱负落空郁勃→②转骊山行乐→③揭“朱门酒肉臭，路有冻死骨”叹“荣枯咫尺异”→④惊闻幼子饿卒仍忧念失业流民与远戍士卒；",
    "start": 55.874,
    "end": 73.968,
    "duration": 18.094
  },
  {
    "id": "sec0_step2_c0",
    "dom_key": "sec0_step2_c0",
    "text": "意深法曲，将忧国伤时之情写得余韵无穷。",
    "start": 74.555,
    "end": 79.098,
    "duration": 4.543
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 确立“诗史”实录叙事传统",
    "start": 79.685,
    "end": 82.47,
    "duration": 2.785
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "确立“诗史”叙事传统：不仅据实记录安史之乱前后风貌，更以仁者情怀写出战乱中下层百姓辛酸境遇。",
    "start": 83.044,
    "end": 92.536,
    "duration": 9.491
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "打破盛唐偏重玲珑兴象格局，以五七言古体即事名篇，着力生活细节真实刻画；",
    "start": 93.123,
    "end": 100.908,
    "duration": 7.785
  },
  {
    "id": "sec1_step2_c0",
    "dom_key": "sec1_step2_c0",
    "text": "“三吏三别”《石壕吏》客观测写差吏夜捉与老妇泣诉；",
    "start": 101.495,
    "end": 106.338,
    "duration": 4.843
  },
  {
    "id": "sec1_step2_c1",
    "dom_key": "sec1_step2_c1",
    "text": "《茅屋为秋风所破歌》困窘中呼号“安得广厦千万间，大庇天下寒士俱欢颜”；",
    "start": 106.69,
    "end": 113.187,
    "duration": 6.496
  },
  {
    "id": "sec1_step3_c0",
    "dom_key": "sec1_step3_c0",
    "text": "使诗史兼有历史实录之真与深厚人道关怀。",
    "start": 113.774,
    "end": 118.603,
    "duration": 4.83
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 集古典律诗声律表现之大成",
    "start": 119.19,
    "end": 122.497,
    "duration": 3.306
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "打破早先近体应酬咏物狭隘格局，将重大时事与家国悲慨引入近体，",
    "start": 123.07,
    "end": 129.905,
    "duration": 6.835
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "并以组诗拓展幅度：《秋兴八首》将山城秋色、漂泊与故国之思层层推进。",
    "start": 130.153,
    "end": 136.611,
    "duration": 6.457
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "技艺上追求“晚节渐于诗律细”（刘熙载称“少陵炼神”），善用“拗救”变体；",
    "start": 137.198,
    "end": 143.707,
    "duration": 6.509
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "《登高》八句皆对而流转自如，融万里悲秋与百年多病为一气；",
    "start": 144.034,
    "end": 149.71,
    "duration": 5.676
  },
  {
    "id": "sec2_step2_c0",
    "dom_key": "sec2_step2_c0",
    "text": "胡应麟《诗薮》赞为“古今七言律第一”，足见其将律诗写得浑融流转、无迹可寻的造诣。",
    "start": 150.284,
    "end": 157.757,
    "duration": 7.473
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 承前启后开辟后世诗歌法门",
    "start": 158.344,
    "end": 161.872,
    "duration": 3.528
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "元稹盛赞“上薄风骚，下该沈、宋……尽得古今之体势”，公允概括其集六朝盛唐诗歌之大成的枢纽地位。",
    "start": 162.445,
    "end": 172.497,
    "duration": 10.051
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "中唐元白继承其缘事而发写生民疾苦路线，韩孟诗派得力奇崛造语与炼字之功，",
    "start": 173.083,
    "end": 181.65,
    "duration": 8.567
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "宋代黄庭坚与江西诗派奉为宗、取法句法锤炼与老成境界；",
    "start": 181.886,
    "end": 187.236,
    "duration": 5.351
  },
  {
    "id": "sec3_step2_c0",
    "dom_key": "sec3_step2_c0",
    "text": "使杜甫成为历代诗坛共同推尊的典范。",
    "start": 187.823,
    "end": 191.689,
    "duration": 3.866
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "杜甫以儒家仁爱之心统摄沉郁顿挫诗风与即事名篇笔法，把个体遭际与唐代盛衰巨变融为一体，",
    "start": 192.276,
    "end": 201.22,
    "duration": 8.944
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "集古近体格律之大成，又为中唐新乐府运动开先声并深远影响宋代江西诗派。",
    "start": 201.508,
    "end": 208.069,
    "duration": 6.561
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：杜甫“即事名篇”开中唐新乐府先声；元白“新乐府运动”倡导“文章合为时而著，歌诗合为事而作”。",
    "start": 208.656,
    "end": 218.161,
    "duration": 9.504
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 《自京赴奉先》四起四落哪四幕？",
    "start": 218.748,
    "end": 223.017,
    "duration": 4.27
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 杜甫以何种新题法突破盛唐“玲珑兴象”？",
    "start": 223.578,
    "end": 228.916,
    "duration": 5.337
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 胡应麟如何评《登高》？元白/韩孟/江西各学杜诗何处？",
    "start": 229.503,
    "end": 236.481,
    "duration": 6.978
  }
]