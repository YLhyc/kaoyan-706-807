[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "杜甫·沉郁顿挫艺术风格与诗史性质",
    "start": 0.154,
    "end": 3.526,
    "duration": 3.372
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "安史乱世激发儒家仁心，先定下“沉郁顿挫”审美底色，",
    "start": 4.212,
    "end": 10.304,
    "duration": 6.092
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "进而迫使其突破盛唐兴象写下古体“诗史”，同时把家国悲慨注入近体律诗锤炼至极，",
    "start": 10.612,
    "end": 18.544,
    "duration": 7.932
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最终承前启后为唐宋三派确立宗师法门。",
    "start": 18.852,
    "end": 22.544,
    "duration": 3.692
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "杜甫是中国古典诗歌现实主义传统集大成者。",
    "start": 23.038,
    "end": 27.21,
    "duration": 4.172
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "安史之乱之际，他将个人身世之悲与国家兴亡之痛融为一体，以沉郁顿挫风范与即事名篇笔法，",
    "start": 27.488,
    "end": 35.98,
    "duration": 8.492
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "真实记录动乱年代民生疾苦，确立“诗圣”地位。",
    "start": 36.288,
    "end": 40.22,
    "duration": 3.932
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 标举“沉郁顿挫”核心风格",
    "start": 40.875,
    "end": 43.767,
    "duration": 2.892
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "标举“沉郁顿挫”风格特质：“沉郁”侧重悲慨深厚（源于仁心）；",
    "start": 44.293,
    "end": 50.545,
    "duration": 6.252
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "“顿挫”指声调抑扬、波浪起伏与反复低回（源于儒家中和节制）。",
    "start": 50.823,
    "end": 56.195,
    "duration": 5.372
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《自京赴奉先县咏怀五百字》：①抱负落空郁勃→②转骊山行乐→③揭“朱门酒肉臭，路有冻死骨”叹“荣枯咫尺异”→④惊闻幼子饿卒仍忧念失业流民与远戍士卒；",
    "start": 56.584,
    "end": 76.296,
    "duration": 19.712
  },
  {
    "id": "sec0_step2_c0",
    "dom_key": "sec0_step2_c0",
    "text": "意深法曲，将忧国伤时之情写得余韵无穷。",
    "start": 76.824,
    "end": 81.316,
    "duration": 4.492
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 确立“诗史”实录叙事传统",
    "start": 81.912,
    "end": 84.654,
    "duration": 2.742
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "确立“诗史”叙事传统：不仅据实记录安史之乱前后风貌，更以仁者情怀写出战乱中下层百姓辛酸境遇。",
    "start": 85.182,
    "end": 94.446,
    "duration": 9.264
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "打破盛唐偏重玲珑兴象格局，以五七言古体即事名篇，着力生活细节真实刻画；",
    "start": 94.974,
    "end": 103.004,
    "duration": 8.03
  },
  {
    "id": "sec1_step2_c0",
    "dom_key": "sec1_step2_c0",
    "text": "“三吏三别”《石壕吏》客观测写差吏夜捉与老妇泣诉；",
    "start": 103.308,
    "end": 108.76,
    "duration": 5.452
  },
  {
    "id": "sec1_step2_c1",
    "dom_key": "sec1_step2_c1",
    "text": "《茅屋为秋风所破歌》困窘中呼号“安得广厦千万间，大庇天下寒士俱欢颜”；",
    "start": 108.908,
    "end": 115.64,
    "duration": 6.732
  },
  {
    "id": "sec1_step3_c0",
    "dom_key": "sec1_step3_c0",
    "text": "使诗史兼有历史实录之真与深厚人道关怀。",
    "start": 116.168,
    "end": 121.46,
    "duration": 5.292
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 集古典律诗声律表现之大成",
    "start": 122.148,
    "end": 125.36,
    "duration": 3.212
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "打破早先近体应酬咏物狭隘格局，将重大时事与家国悲慨引入近体，",
    "start": 125.888,
    "end": 133.42,
    "duration": 7.532
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "并以组诗拓展幅度：《秋兴八首》将山城秋色、漂泊与故国之思层层推进。",
    "start": 133.648,
    "end": 140.78,
    "duration": 7.132
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "技艺上追求“晚节渐于诗律细”（刘熙载称“少陵炼神”），善用“拗救”变体；",
    "start": 141.236,
    "end": 148.368,
    "duration": 7.132
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "《登高》八句皆对而流转自如，融万里悲秋与百年多病为一气；",
    "start": 148.566,
    "end": 154.418,
    "duration": 5.852
  },
  {
    "id": "sec2_step2_c0",
    "dom_key": "sec2_step2_c0",
    "text": "胡应麟《诗薮》赞为“古今七言律第一”，足见其将律诗写得浑融流转、无迹可寻的造诣。",
    "start": 154.742,
    "end": 162.914,
    "duration": 8.172
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 承前启后开辟后世诗歌法门",
    "start": 163.579,
    "end": 166.951,
    "duration": 3.372
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "元稹盛赞“上薄风骚，下该沈、宋……尽得古今之体势”，公允概括其集六朝盛唐诗歌之大成的枢纽地位。",
    "start": 167.479,
    "end": 177.731,
    "duration": 10.252
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "中唐元白继承其缘事而发写生民疾苦路线，韩孟诗派得力奇崛造语与炼字之功，",
    "start": 178.259,
    "end": 186.991,
    "duration": 8.732
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "宋代黄庭坚与江西诗派奉为宗、取法句法锤炼与老成境界；",
    "start": 187.219,
    "end": 192.511,
    "duration": 5.292
  },
  {
    "id": "sec3_step2_c0",
    "dom_key": "sec3_step2_c0",
    "text": "使杜甫成为历代诗坛共同推尊的典范。",
    "start": 193.001,
    "end": 197.013,
    "duration": 4.012
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "杜甫以儒家仁爱之心统摄沉郁顿挫诗风与即事名篇笔法，把个体遭际与唐代盛衰巨变融为一体，",
    "start": 197.618,
    "end": 206.59,
    "duration": 8.972
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "集古近体格律之大成，又为中唐新乐府运动开先声并深远影响宋代江西诗派。",
    "start": 206.978,
    "end": 214.11,
    "duration": 7.132
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：杜甫“即事名篇”开中唐新乐府先声；元白“新乐府运动”倡导“文章合为时而著，歌诗合为事而作”。",
    "start": 214.774,
    "end": 225.236,
    "duration": 10.462
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 《自京赴奉先》四起四落哪四幕？",
    "start": 225.867,
    "end": 230.039,
    "duration": 4.172
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 杜甫以何种新题法突破盛唐“玲珑兴象”？",
    "start": 230.541,
    "end": 235.273,
    "duration": 4.732
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 胡应麟如何评《登高》？元白/韩孟/江西各学杜诗何处？",
    "start": 235.801,
    "end": 242.693,
    "duration": 6.892
  }
]