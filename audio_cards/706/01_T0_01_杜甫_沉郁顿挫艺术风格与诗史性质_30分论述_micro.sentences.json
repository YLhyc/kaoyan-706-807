[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "杜甫·沉郁顿挫艺术风格与诗史性质",
    "start": 0.314,
    "end": 3.806,
    "duration": 3.492
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "安史乱世激发儒家仁心，先定下“沉郁顿挫”审美底色，",
    "start": 4.814,
    "end": 10.306,
    "duration": 5.492
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "进而迫使其突破盛唐兴象写下古体“诗史”，同时把家国悲慨注入近体律诗锤炼至极，",
    "start": 10.694,
    "end": 18.106,
    "duration": 7.412
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最终承前启后为唐宋三派确立宗师法门。",
    "start": 18.494,
    "end": 22.146,
    "duration": 3.652
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "杜甫是中国古典诗歌现实主义传统集大成者。",
    "start": 23.154,
    "end": 27.406,
    "duration": 4.252
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "安史之乱之际，他将个人身世之悲与国家兴亡之痛融为一体，以沉郁顿挫风范与即事名篇笔法，",
    "start": 28.414,
    "end": 36.786,
    "duration": 8.372
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "真实记录动乱年代民生疾苦，确立“诗圣”地位。",
    "start": 37.054,
    "end": 41.186,
    "duration": 4.132
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 标举“沉郁顿挫”核心风格",
    "start": 42.114,
    "end": 45.166,
    "duration": 3.052
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "标举“沉郁顿挫”风格特质：“沉郁”侧重悲慨深厚（源于仁心）；",
    "start": 46.094,
    "end": 52.546,
    "duration": 6.452
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "“顿挫”指声调抑扬、波浪起伏与反复低回（源于儒家中和节制）。",
    "start": 53.514,
    "end": 59.046,
    "duration": 5.532
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《自京赴奉先县咏怀五百字》：①抱负落空郁勃→②转骊山行乐→③揭“朱门酒肉臭，路有冻死骨”叹“荣枯咫尺异”→④惊闻幼子饿卒仍忧念失业流民与远戍士卒；",
    "start": 60.054,
    "end": 79.306,
    "duration": 19.252
  },
  {
    "id": "sec0_step2_c0",
    "dom_key": "sec0_step2_c0",
    "text": "意深法曲，将忧国伤时之情写得余韵无穷。",
    "start": 80.394,
    "end": 84.966,
    "duration": 4.572
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 确立“诗史”实录叙事传统",
    "start": 85.674,
    "end": 88.686,
    "duration": 3.012
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "确立“诗史”叙事传统：不仅据实记录安史之乱前后风貌，更以仁者情怀写出战乱中下层百姓辛酸境遇。",
    "start": 89.171,
    "end": 99.223,
    "duration": 10.052
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "打破盛唐偏重玲珑兴象格局，以五七言古体即事名篇，着力生活细节真实刻画；",
    "start": 99.675,
    "end": 107.367,
    "duration": 7.692
  },
  {
    "id": "sec1_step2_c0",
    "dom_key": "sec1_step2_c0",
    "text": "“三吏三别”《石壕吏》客观测写差吏夜捉与老妇泣诉；",
    "start": 108.155,
    "end": 114.647,
    "duration": 6.492
  },
  {
    "id": "sec1_step2_c1",
    "dom_key": "sec1_step2_c1",
    "text": "《茅屋为秋风所破歌》困窘中呼号“安得广厦千万间，大庇天下寒士俱欢颜”；",
    "start": 115.115,
    "end": 123.327,
    "duration": 8.212
  },
  {
    "id": "sec1_step3_c0",
    "dom_key": "sec1_step3_c0",
    "text": "使诗史兼有历史实录之真与深厚人道关怀。",
    "start": 124.375,
    "end": 129.467,
    "duration": 5.092
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 集古典律诗声律表现之大成",
    "start": 130.435,
    "end": 134.047,
    "duration": 3.612
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "打破早先近体应酬咏物狭隘格局，将重大时事与家国悲慨引入近体，",
    "start": 135.095,
    "end": 142.547,
    "duration": 7.452
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "并以组诗拓展幅度：《秋兴八首》将山城秋色、漂泊与故国之思层层推进。",
    "start": 142.775,
    "end": 149.907,
    "duration": 7.132
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "技艺上追求“晚节渐于诗律细”（刘熙载称“少陵炼神”），善用“拗救”变体；",
    "start": 150.875,
    "end": 157.967,
    "duration": 7.092
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "《登高》八句皆对而流转自如，融万里悲秋与百年多病为一气；",
    "start": 158.935,
    "end": 164.227,
    "duration": 5.292
  },
  {
    "id": "sec2_step2_c0",
    "dom_key": "sec2_step2_c0",
    "text": "胡应麟《诗薮》赞为“古今七言律第一”，足见其将律诗写得浑融流转、无迹可寻的造诣。",
    "start": 165.155,
    "end": 172.487,
    "duration": 7.332
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 承前启后开辟后世诗歌法门",
    "start": 173.415,
    "end": 176.787,
    "duration": 3.372
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "元稹盛赞“上薄风骚，下该沈、宋……尽得古今之体势”，公允概括其集六朝盛唐诗歌之大成的枢纽地位。",
    "start": 177.795,
    "end": 187.447,
    "duration": 9.652
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "中唐元白继承其缘事而发写生民疾苦路线，韩孟诗派得力奇崛造语与炼字之功，",
    "start": 188.455,
    "end": 197.907,
    "duration": 9.452
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "宋代黄庭坚与江西诗派奉为宗、取法句法锤炼与老成境界；",
    "start": 198.335,
    "end": 204.347,
    "duration": 6.012
  },
  {
    "id": "sec3_step2_c0",
    "dom_key": "sec3_step2_c0",
    "text": "使杜甫成为历代诗坛共同推尊的典范。",
    "start": 205.235,
    "end": 209.167,
    "duration": 3.932
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "杜甫以儒家仁爱之心统摄沉郁顿挫诗风与即事名篇笔法，把个体遭际与唐代盛衰巨变融为一体，",
    "start": 209.875,
    "end": 219.807,
    "duration": 9.932
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "集古近体格律之大成，又为中唐新乐府运动开先声并深远影响宋代江西诗派。",
    "start": 220.275,
    "end": 227.647,
    "duration": 7.372
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：杜甫“即事名篇”开中唐新乐府先声；元白“新乐府运动”倡导“文章合为时而著，歌诗合为事而作”。",
    "start": 228.695,
    "end": 240.007,
    "duration": 11.312
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 《自京赴奉先》四起四落哪四幕？",
    "start": 240.935,
    "end": 245.307,
    "duration": 4.372
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 杜甫以何种新题法突破盛唐“玲珑兴象”？",
    "start": 246.275,
    "end": 251.247,
    "duration": 4.972
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 胡应麟如何评《登高》？元白/韩孟/江西各学杜诗何处？",
    "start": 252.175,
    "end": 259.307,
    "duration": 7.132
  }
]