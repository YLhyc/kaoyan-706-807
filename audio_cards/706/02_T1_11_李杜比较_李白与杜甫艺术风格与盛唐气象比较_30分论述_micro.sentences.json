[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "李杜比较·李白与杜甫艺术风格与盛唐气象比较",
    "start": 0.354,
    "end": 4.806,
    "duration": 4.452
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "比较题严格按“横切四维”逐段对敲：先比两人盛唐转型坐标与儒道侠思想根基，",
    "start": 5.814,
    "end": 14.426,
    "duration": 8.612
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再比一泻千里与四起四落的情感审美，进而落到破律歌行与守律七律的体裁分化，",
    "start": 14.774,
    "end": 22.346,
    "duration": 7.572
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后收束为唐宋浪漫与写实两大源流。",
    "start": 22.574,
    "end": 25.786,
    "duration": 3.212
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "李白与杜甫是古典诗歌双峰并峙的伟大诗人：李白把浪漫主义推向极盛，杜甫将现实主义发扬光大。",
    "start": 26.794,
    "end": 36.006,
    "duration": 9.212
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "韩愈赞“李杜文章在，光焰万丈长”。",
    "start": 36.974,
    "end": 40.266,
    "duration": 3.292
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 思想追求：个体精神解放 vs 家国忧患",
    "start": 41.274,
    "end": 45.326,
    "duration": 4.052
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "身处盛唐全盛之际，兼融道家逍遥、侠义任情与建功抱负，傲立王侯高呼“安能摧眉折腰事权贵”；",
    "start": 46.294,
    "end": 55.866,
    "duration": 9.572
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "亲历安史乱离，深扎儒家“仁民爱物”与“兼济天下”，",
    "start": 56.834,
    "end": 61.406,
    "duration": 4.572
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "在《自京赴奉先县咏怀五百字》发出“穷年忧黎元，叹息肠内热”；",
    "start": 61.594,
    "end": 67.766,
    "duration": 6.172
  },
  {
    "id": "sec0_step2_c0",
    "dom_key": "sec0_step2_c0",
    "text": "李白现盛唐个性飞扬，杜甫显盛唐转向深沉反思的担当。",
    "start": 68.774,
    "end": 74.226,
    "duration": 5.452
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 审美风貌：飘逸奔放 vs 沉郁顿挫",
    "start": 75.154,
    "end": 78.979,
    "duration": 3.825
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "崇尚“清水出芙蓉，天然去雕饰”，《将进酒》“君不见黄河之水天上来”一泻千里、纵横狂放；",
    "start": 80.174,
    "end": 88.626,
    "duration": 8.452
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "以“沉郁顿挫”称绝，《登高》交融悲秋与多病，《咏怀五百字》历经四起四落；",
    "start": 89.594,
    "end": 96.326,
    "duration": 6.732
  },
  {
    "id": "sec1_step2_c0",
    "dom_key": "sec1_step2_c0",
    "text": "李白美在飞扬奇伟的豪迈俊逸，杜甫美在深沉悲慨的郁勃低回。",
    "start": 97.098,
    "end": 104.27,
    "duration": 7.172
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 体裁法度：古体歌行绝句 vs 近体律诗",
    "start": 105.318,
    "end": 110.37,
    "duration": 5.052
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "摆脱声律羁绊，倾情古题乐府与歌行，《梦游天姥吟留别》《蜀道难》驱遣神话夸张，兼擅五七言绝句自然天成；",
    "start": 111.338,
    "end": 122.87,
    "duration": 11.532
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "最高成就在集律诗大成，追求“晚节渐于诗律细”、善用“拗救”与组诗，《秋兴八首》浑融流转而法度精严。",
    "start": 123.958,
    "end": 133.97,
    "duration": 10.012
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 诗史流派：开启后世浪漫与写实双源",
    "start": 135.018,
    "end": 139.27,
    "duration": 4.252
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "以飘逸豪放与个性解放，启迪中唐韩孟奇崛诗思与宋代苏轼、陆游豪迈诗风；",
    "start": 140.278,
    "end": 148.89,
    "duration": 8.612
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "以写实精神与精严法度，启迪中唐白居易新乐府运动，并为宋代黄庭坚与江西诗派所宗尚；",
    "start": 149.858,
    "end": 159.71,
    "duration": 9.852
  },
  {
    "id": "sec3_step2_c0",
    "dom_key": "sec3_step2_c0",
    "text": "共同在诗歌史上树立浪漫与现实两大典范。",
    "start": 160.758,
    "end": 165.53,
    "duration": 4.772
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "李白以飘逸狂放拓展古体歌行与绝句境界，杜甫则以沉郁顿挫与精严律法把写实诗史推至巅峰，",
    "start": 166.498,
    "end": 175.07,
    "duration": 8.572
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "二人开启浪漫与现实并行的双流传统。",
    "start": 175.298,
    "end": 178.35,
    "duration": 3.052
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：杜甫赞李白“笔落惊风雨，诗成泣鬼神”；李白赞杜甫有别集赠诗；韩愈合赞“李杜文章在，光焰万丈长”。",
    "start": 179.398,
    "end": 190.39,
    "duration": 10.992
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 李白与杜甫在“思想渊源”和“体裁法度”上各有哪些鲜明对照？",
    "start": 191.162,
    "end": 197.574,
    "duration": 6.412
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《将进酒》与《登高》《秋兴八首》对比飘逸与沉郁顿挫？",
    "start": 198.582,
    "end": 205.74,
    "duration": 7.158
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 列出唐宋诗坛分别继承李白、杜甫的具体诗人及流派？",
    "start": 206.962,
    "end": 213.414,
    "duration": 6.452
  }
]