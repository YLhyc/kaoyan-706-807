[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "李杜比较·李白与杜甫艺术风格与盛唐气象比较",
    "start": 0.154,
    "end": 4.006,
    "duration": 3.852
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "比较题严格按“横切四维”逐段对敲：先比两人盛唐转型坐标与儒道侠思想根基，",
    "start": 4.698,
    "end": 13.03,
    "duration": 8.332
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再比一泻千里与四起四落的情感审美，进而落到破律歌行与守律七律的体裁分化，",
    "start": 13.338,
    "end": 20.39,
    "duration": 7.052
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后收束为唐宋浪漫与写实两大源流。",
    "start": 20.618,
    "end": 24.31,
    "duration": 3.692
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "李白与杜甫是古典诗歌双峰并峙的伟大诗人：李白把浪漫主义推向极盛，杜甫将现实主义发扬光大。",
    "start": 24.763,
    "end": 33.335,
    "duration": 8.572
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "韩愈赞“李杜文章在，光焰万丈长”。",
    "start": 33.613,
    "end": 36.985,
    "duration": 3.372
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 思想追求：个体精神解放 vs 家国忧患",
    "start": 37.674,
    "end": 41.846,
    "duration": 4.172
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "身处盛唐全盛之际，兼融道家逍遥、侠义任情与建功抱负，傲立王侯高呼“安能摧眉折腰事权贵”；",
    "start": 42.289,
    "end": 52.781,
    "duration": 10.492
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "亲历安史乱离，深扎儒家“仁民爱物”与“兼济天下”，",
    "start": 53.21,
    "end": 58.102,
    "duration": 4.892
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "在《自京赴奉先县咏怀五百字》发出“穷年忧黎元，叹息肠内热”；",
    "start": 58.41,
    "end": 65.222,
    "duration": 6.812
  },
  {
    "id": "sec0_step2_c0",
    "dom_key": "sec0_step2_c0",
    "text": "李白现盛唐个性飞扬，杜甫显盛唐转向深沉反思的担当。",
    "start": 65.75,
    "end": 72.082,
    "duration": 6.332
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 审美风貌：飘逸奔放 vs 沉郁顿挫",
    "start": 72.762,
    "end": 76.694,
    "duration": 3.932
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "崇尚“清水出芙蓉，天然去雕饰”，《将进酒》“君不见黄河之水天上来”一泻千里、纵横狂放；",
    "start": 77.174,
    "end": 85.266,
    "duration": 8.092
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "以“沉郁顿挫”称绝，《登高》交融悲秋与多病，《咏怀五百字》历经四起四落；",
    "start": 85.716,
    "end": 92.688,
    "duration": 6.972
  },
  {
    "id": "sec1_step2_c0",
    "dom_key": "sec1_step2_c0",
    "text": "李白美在飞扬奇伟的豪迈俊逸，杜甫美在深沉悲慨的郁勃低回。",
    "start": 93.203,
    "end": 100.815,
    "duration": 7.612
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 体裁法度：古体歌行绝句 vs 近体律诗",
    "start": 101.459,
    "end": 106.031,
    "duration": 4.572
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "摆脱声律羁绊，倾情古题乐府与歌行，《梦游天姥吟留别》《蜀道难》驱遣神话夸张，兼擅五七言绝句自然天成；",
    "start": 106.559,
    "end": 117.931,
    "duration": 11.372
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "最高成就在集律诗大成，追求“晚节渐于诗律细”、善用“拗救”与组诗，《秋兴八首》浑融流转而法度精严。",
    "start": 118.428,
    "end": 128.6,
    "duration": 10.172
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 诗史流派：开启后世浪漫与写实双源",
    "start": 129.258,
    "end": 133.59,
    "duration": 4.332
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "以飘逸豪放与个性解放，启迪中唐韩孟奇崛诗思与宋代苏轼、陆游豪迈诗风；",
    "start": 134.118,
    "end": 143.33,
    "duration": 9.212
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "以写实精神与精严法度，启迪中唐白居易新乐府运动，并为宋代黄庭坚与江西诗派所宗尚；",
    "start": 143.812,
    "end": 153.904,
    "duration": 10.092
  },
  {
    "id": "sec3_step2_c0",
    "dom_key": "sec3_step2_c0",
    "text": "共同在诗歌史上树立浪漫与现实两大典范。",
    "start": 154.432,
    "end": 159.004,
    "duration": 4.572
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "李白以飘逸狂放拓展古体歌行与绝句境界，杜甫则以沉郁顿挫与精严律法把写实诗史推至巅峰，",
    "start": 159.658,
    "end": 168.31,
    "duration": 8.652
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "二人开启浪漫与现实并行的双流传统。",
    "start": 168.618,
    "end": 171.75,
    "duration": 3.132
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：杜甫赞李白“笔落惊风雨，诗成泣鬼神”；李白赞杜甫有别集赠诗；韩愈合赞“李杜文章在，光焰万丈长”。",
    "start": 172.355,
    "end": 183.297,
    "duration": 10.942
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 李白与杜甫在“思想渊源”和“体裁法度”上各有哪些鲜明对照？",
    "start": 183.947,
    "end": 190.279,
    "duration": 6.332
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《将进酒》与《登高》《秋兴八首》对比飘逸与沉郁顿挫？",
    "start": 190.795,
    "end": 196.407,
    "duration": 5.612
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 列出唐宋诗坛分别继承李白、杜甫的具体诗人及流派？",
    "start": 196.872,
    "end": 202.644,
    "duration": 5.772
  }
]