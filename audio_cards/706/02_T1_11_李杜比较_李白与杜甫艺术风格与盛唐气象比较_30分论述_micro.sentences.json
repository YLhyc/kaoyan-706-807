[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "李杜比较·李白与杜甫艺术风格与盛唐气象比较",
    "start": 0.134,
    "end": 4.209,
    "duration": 4.075
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "比较题严格按“横切四维”逐段对敲：先比两人盛唐转型坐标与儒道侠思想根基，",
    "start": 4.785,
    "end": 12.414,
    "duration": 7.629
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再比一泻千里与四起四落的情感审美，进而落到破律歌行与守律七律的体裁分化，",
    "start": 12.714,
    "end": 19.836,
    "duration": 7.121
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后收束为唐宋浪漫与写实两大源流。",
    "start": 19.95,
    "end": 23.503,
    "duration": 3.554
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "李白与杜甫是古典诗歌双峰并峙的伟大诗人：李白把浪漫主义推向极盛，杜甫将现实主义发扬光大。",
    "start": 24.09,
    "end": 32.488,
    "duration": 8.397
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "韩愈赞“李杜文章在，光焰万丈长”。",
    "start": 33.075,
    "end": 35.886,
    "duration": 2.811
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 思想追求：个体精神解放 vs 家国忧患",
    "start": 36.447,
    "end": 40.886,
    "duration": 4.439
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "身处盛唐全盛之际，兼融道家逍遥、侠义任情与建功抱负，傲立王侯高呼“安能摧眉折腰事权贵”；",
    "start": 41.473,
    "end": 51.094,
    "duration": 9.621
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "亲历安史乱离，深扎儒家“仁民爱物”与“兼济天下”，",
    "start": 51.668,
    "end": 56.459,
    "duration": 4.791
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "在《自京赴奉先县咏怀五百字》发出“穷年忧黎元，叹息肠内热”；",
    "start": 56.72,
    "end": 62.279,
    "duration": 5.559
  },
  {
    "id": "sec0_step2_c0",
    "dom_key": "sec0_step2_c0",
    "text": "李白现盛唐个性飞扬，杜甫显盛唐转向深沉反思的担当。",
    "start": 62.866,
    "end": 68.803,
    "duration": 5.936
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 审美风貌：飘逸奔放 vs 沉郁顿挫",
    "start": 69.39,
    "end": 73.139,
    "duration": 3.749
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "崇尚“清水出芙蓉，天然去雕饰”，《将进酒》“君不见黄河之水天上来”一泻千里、纵横狂放；",
    "start": 73.726,
    "end": 82.162,
    "duration": 8.437
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "以“沉郁顿挫”称绝，《登高》交融悲秋与多病，《咏怀五百字》历经四起四落；",
    "start": 82.736,
    "end": 89.48,
    "duration": 6.744
  },
  {
    "id": "sec1_step2_c0",
    "dom_key": "sec1_step2_c0",
    "text": "李白美在飞扬奇伟的豪迈俊逸，杜甫美在深沉悲慨的郁勃低回。",
    "start": 90.067,
    "end": 96.042,
    "duration": 5.976
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 体裁法度：古体歌行绝句 vs 近体律诗",
    "start": 96.629,
    "end": 100.977,
    "duration": 4.348
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "摆脱声律羁绊，倾情古题乐府与歌行，《梦游天姥吟留别》《蜀道难》驱遣神话夸张，兼擅五七言绝句自然天成；",
    "start": 101.551,
    "end": 111.98,
    "duration": 10.429
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "最高成就在集律诗大成，追求“晚节渐于诗律细”、善用“拗救”与组诗，《秋兴八首》浑融流转而法度精严。",
    "start": 112.554,
    "end": 122.175,
    "duration": 9.621
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 诗史流派：开启后世浪漫与写实双源",
    "start": 122.749,
    "end": 126.98,
    "duration": 4.231
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "以飘逸豪放与个性解放，启迪中唐韩孟奇崛诗思与宋代苏轼、陆游豪迈诗风；",
    "start": 127.567,
    "end": 135.209,
    "duration": 7.642
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "以写实精神与精严法度，启迪中唐白居易新乐府运动，并为宋代黄庭坚与江西诗派所宗尚；",
    "start": 135.796,
    "end": 144.519,
    "duration": 8.723
  },
  {
    "id": "sec3_step2_c0",
    "dom_key": "sec3_step2_c0",
    "text": "共同在诗歌史上树立浪漫与现实两大典范。",
    "start": 145.08,
    "end": 149.571,
    "duration": 4.491
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "李白以飘逸狂放拓展古体歌行与绝句境界，杜甫则以沉郁顿挫与精严律法把写实诗史推至巅峰，",
    "start": 150.158,
    "end": 159.141,
    "duration": 8.983
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "二人开启浪漫与现实并行的双流传统。",
    "start": 159.338,
    "end": 162.605,
    "duration": 3.267
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：杜甫赞李白“笔落惊风雨，诗成泣鬼神”；李白赞杜甫有别集赠诗；韩愈合赞“李杜文章在，光焰万丈长”。",
    "start": 163.192,
    "end": 173.49,
    "duration": 10.298
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 李白与杜甫在“思想渊源”和“体裁法度”上各有哪些鲜明对照？",
    "start": 174.064,
    "end": 180.222,
    "duration": 6.158
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《将进酒》与《登高》《秋兴八首》对比飘逸与沉郁顿挫？",
    "start": 180.796,
    "end": 187.175,
    "duration": 6.379
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 列出唐宋诗坛分别继承李白、杜甫的具体诗人及流派？",
    "start": 187.762,
    "end": 194.167,
    "duration": 6.405
  }
]