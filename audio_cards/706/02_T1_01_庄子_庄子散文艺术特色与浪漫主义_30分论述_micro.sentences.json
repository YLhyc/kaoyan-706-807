[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《庄子》·散文艺术特色与浪漫主义",
    "start": 0.134,
    "end": 3.186,
    "duration": 3.052
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "先解决“拿什么说理”（三言寓言），再放飞“思绪怎么飞”（鲲鹏梦蝶奇想），",
    "start": 3.698,
    "end": 11.23,
    "duration": 7.532
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "落成“文章怎么排”（汪洋恣肆章法），",
    "start": 11.378,
    "end": 14.91,
    "duration": 3.532
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后亮出“如何回看俗世与传给后代”（辛辣讽刺+滋养太白东坡）。",
    "start": 15.058,
    "end": 21.55,
    "duration": 6.492
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《庄子》是先秦诸子散文高峰与浪漫主义源头。",
    "start": 21.921,
    "end": 26.413,
    "duration": 4.492
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "庄子突破语录与专题论辩板滞，以奇幻想象融哲思于诗意，",
    "start": 26.531,
    "end": 32.463,
    "duration": 5.932
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "鲁迅在《汉文学史纲要》赞其“晚周诸子之作，莫能先也”。",
    "start": 32.611,
    "end": 37.423,
    "duration": 4.812
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 善用“三言”与寓言化理为象",
    "start": 38.033,
    "end": 41.165,
    "duration": 3.132
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "建立“寓言”“重言”“卮言”为主体的表述，秉持“寓言十九，藉外论之”；",
    "start": 41.642,
    "end": 48.134,
    "duration": 6.492
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《庖丁解牛》以游刃有余喻养生，《秋水》河伯北海喻认知有限，《人间世》“螳臂当车”警示，",
    "start": 48.662,
    "end": 58.034,
    "duration": 9.372
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《养生主》薪火相传譬喻，化抽象哲理为鲜活形象。",
    "start": 58.182,
    "end": 62.514,
    "duration": 4.332
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 展开雄奇飞腾的浪漫想象",
    "start": 63.176,
    "end": 66.228,
    "duration": 3.052
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《逍遥游》开篇写鲲鹏“水击三千里，抟扶摇而上者九万里”，以壮阔图景寄寓精神超越；",
    "start": 66.697,
    "end": 74.869,
    "duration": 8.172
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《齐物论》末以轻灵笔触写庄周梦蝶，借物我泯灭展现物化互通诗意，注入自由浪漫气息。",
    "start": 75.337,
    "end": 84.709,
    "duration": 9.372
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 形成汪洋恣肆的自由章法气势",
    "start": 85.417,
    "end": 88.789,
    "duration": 3.372
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "刘熙载《艺概》评其“意出尘外，怪生笔端”。",
    "start": 89.265,
    "end": 94.077,
    "duration": 4.812
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "不设呆板提纲，由核心意象随物赋形、层层生发；",
    "start": 94.567,
    "end": 99.459,
    "duration": 4.892
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "常连类比喻、正反翻案，句式长短错落，如巨澜奔涌或机锋毕露，与其自由主旨互为表里。",
    "start": 99.817,
    "end": 107.909,
    "duration": 8.092
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 诙谐辛辣讽刺与深远文学滋养",
    "start": 108.595,
    "end": 112.287,
    "duration": 3.692
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "《秋水》将梁国相印比作腐鼠、高洁志趣比鹓雏；《列御寇》以曹商舔痔得车讽阿附权贵，显独立风骨；",
    "start": 112.815,
    "end": 124.557,
    "duration": 11.742
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "以汪洋文风与寓言传统滋养司马迁、阮籍、李白、苏轼，成文人安顿心灵的精神源泉。",
    "start": 124.853,
    "end": 133.585,
    "duration": 8.732
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《庄子》借“三言”寓言、奇幻想象与汪洋恣肆章法将哲理化为诗意散文，",
    "start": 134.198,
    "end": 140.536,
    "duration": 6.338
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "其自由与讽世品格深远影响汉赋、魏晋玄风及李白、苏轼等后代作家。",
    "start": 140.551,
    "end": 147.57,
    "duration": 7.019
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅在《汉文学史纲要》赞其“晚周诸子之作，莫能先也”；刘熙载《艺概》评其“意出尘外，怪生笔端”。",
    "start": 148.081,
    "end": 158.543,
    "duration": 10.462
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 庄子“三言”与四个核心寓言篇目各是什么？",
    "start": 159.245,
    "end": 164.057,
    "duration": 4.812
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 《逍遥游》《齐物论》与《列御寇》各体现哪一项特质？",
    "start": 164.585,
    "end": 169.557,
    "duration": 4.972
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 鲁迅《汉文学史纲要》与刘熙载《艺概》两句评语？",
    "start": 169.954,
    "end": 175.806,
    "duration": 5.852
  }
]