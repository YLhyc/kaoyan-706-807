[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "先解决“拿什么说理”（三言寓言），再放飞“思绪怎么飞”（鲲鹏梦蝶奇想），",
    "start": 0.226,
    "end": 6.853,
    "duration": 6.627
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "落成“文章怎么排”（汪洋恣肆章法），",
    "start": 7.649,
    "end": 10.153,
    "duration": 2.504
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后亮出“如何回看俗世与传给后代”（辛辣讽刺+滋养太白东坡）。",
    "start": 10.954,
    "end": 16.449,
    "duration": 5.495
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《庄子》是先秦诸子散文高峰与浪漫主义源头。",
    "start": 17.183,
    "end": 20.734,
    "duration": 3.551
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "庄子突破语录与专题论辩板滞，以奇幻想象融哲思于诗意，",
    "start": 21.473,
    "end": 26.686,
    "duration": 5.213
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "鲁迅在《汉文学史纲要》赞其“晚周诸子之作，莫能先也”。",
    "start": 27.418,
    "end": 31.801,
    "duration": 4.383
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 善用“三言”与寓言化理为象",
    "start": 32.515,
    "end": 35.325,
    "duration": 2.81
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "建立“寓言”“重言”“卮言”为主体的表述，秉持“寓言十九，藉外论之”；",
    "start": 36.065,
    "end": 41.713,
    "duration": 5.648
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《庖丁解牛》以游刃有余喻养生，《秋水》河伯北海喻认知有限，",
    "start": 42.461,
    "end": 47.218,
    "duration": 4.757
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《人间世》“螳臂当车”警示，《养生主》薪火相传譬喻，化抽象哲理为鲜活形象。",
    "start": 48.011,
    "end": 54.321,
    "duration": 6.31
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 展开雄奇飞腾的浪漫想象",
    "start": 55.044,
    "end": 57.991,
    "duration": 2.946
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《逍遥游》开篇写鲲鹏“水击三千里，抟扶摇而上者九万里”，以壮阔图景寄寓精神超越；",
    "start": 58.743,
    "end": 65.825,
    "duration": 7.082
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《齐物论》末以轻灵笔触写庄周梦蝶，借物我泯灭展现物化互通诗意，注入自由浪漫气息。",
    "start": 66.54,
    "end": 74.02,
    "duration": 7.48
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 形成汪洋恣肆的自由章法气势",
    "start": 74.723,
    "end": 77.93,
    "duration": 3.207
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "刘熙载《艺概》评其“意出尘外，怪生笔端”。",
    "start": 78.66,
    "end": 81.693,
    "duration": 3.033
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "不设呆板提纲，由核心意象随物赋形、层层生发；",
    "start": 82.433,
    "end": 86.627,
    "duration": 4.194
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "常连类比喻、正反翻案，句式长短错落，如巨澜奔涌或机锋毕露，与其自由主旨互为表里。",
    "start": 87.338,
    "end": 95.188,
    "duration": 7.85
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 诙谐辛辣讽刺与深远文学滋养",
    "start": 95.952,
    "end": 99.282,
    "duration": 3.33
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "《秋水》将梁国相印比作腐鼠、高洁志趣比鹓雏；《列御寇》以曹商舔痔得车讽阿附权贵，显独立风骨；",
    "start": 100.114,
    "end": 108.716,
    "duration": 8.602
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "以汪洋文风与寓言传统滋养司马迁、阮籍、李白、苏轼，成文人安顿心灵的精神源泉。",
    "start": 109.496,
    "end": 117.324,
    "duration": 7.828
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《庄子》借“三言”寓言、奇幻想象与汪洋恣肆章法将哲理化为诗意散文，",
    "start": 118.044,
    "end": 124.07,
    "duration": 6.027
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "其自由与讽世品格深远影响汉赋、魏晋玄风及李白、苏轼等后代作家。",
    "start": 124.927,
    "end": 131.529,
    "duration": 6.602
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅在《汉文学史纲要》赞其“晚周诸子之作，莫能先也”；",
    "start": 132.269,
    "end": 137.4,
    "duration": 5.13
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "刘熙载《艺概》评其“意出尘外，怪生笔端”。",
    "start": 138.158,
    "end": 141.191,
    "duration": 3.033
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 庄子“三言”与四个核心寓言篇目各是什么？",
    "start": 141.903,
    "end": 146.666,
    "duration": 4.763
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 《逍遥游》《齐物论》与《列御寇》各体现哪一项特质？",
    "start": 147.392,
    "end": 152.331,
    "duration": 4.939
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 鲁迅《汉文学史纲要》与刘熙载《艺概》两句评语？",
    "start": 153.039,
    "end": 158.063,
    "duration": 5.024
  }
]