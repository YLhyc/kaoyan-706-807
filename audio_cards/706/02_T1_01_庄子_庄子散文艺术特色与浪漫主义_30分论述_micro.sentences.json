[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《庄子》·散文艺术特色与浪漫主义",
    "start": 0.274,
    "end": 3.166,
    "duration": 2.892
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "先解决“拿什么说理”（三言寓言），再放飞“思绪怎么飞”（鲲鹏梦蝶奇想），",
    "start": 4.094,
    "end": 10.626,
    "duration": 6.532
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "落成“文章怎么排”（汪洋恣肆章法），",
    "start": 10.774,
    "end": 13.426,
    "duration": 2.652
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后亮出“如何回看俗世与传给后代”（辛辣讽刺+滋养太白东坡）。",
    "start": 13.894,
    "end": 19.626,
    "duration": 5.732
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《庄子》是先秦诸子散文高峰与浪漫主义源头。",
    "start": 20.554,
    "end": 24.966,
    "duration": 4.412
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "庄子突破语录与专题论辩板滞，以奇幻想象融哲思于诗意，",
    "start": 26.014,
    "end": 32.186,
    "duration": 6.172
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "鲁迅在《汉文学史纲要》赞其“晚周诸子之作，莫能先也”。",
    "start": 32.534,
    "end": 37.626,
    "duration": 5.092
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 善用“三言”与寓言化理为象",
    "start": 38.554,
    "end": 42.246,
    "duration": 3.692
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "建立“寓言”“重言”“卮言”为主体的表述，秉持“寓言十九，藉外论之”；",
    "start": 43.214,
    "end": 50.066,
    "duration": 6.852
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《庖丁解牛》以游刃有余喻养生，《秋水》河伯北海喻认知有限，《人间世》“螳臂当车”警示，",
    "start": 51.154,
    "end": 60.766,
    "duration": 9.612
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《养生主》薪火相传譬喻，化抽象哲理为鲜活形象。",
    "start": 61.114,
    "end": 65.166,
    "duration": 4.052
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 展开雄奇飞腾的浪漫想象",
    "start": 66.174,
    "end": 69.146,
    "duration": 2.972
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《逍遥游》开篇写鲲鹏“水击三千里，抟扶摇而上者九万里”，以壮阔图景寄寓精神超越；",
    "start": 70.154,
    "end": 79.446,
    "duration": 9.292
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《齐物论》末以轻灵笔触写庄周梦蝶，借物我泯灭展现物化互通诗意，注入自由浪漫气息。",
    "start": 80.454,
    "end": 89.626,
    "duration": 9.172
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 形成汪洋恣肆的自由章法气势",
    "start": 90.594,
    "end": 94.086,
    "duration": 3.492
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "刘熙载《艺概》评其“意出尘外，怪生笔端”。",
    "start": 94.698,
    "end": 98.63,
    "duration": 3.932
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "不设呆板提纲，由核心意象随物赋形、层层生发；",
    "start": 99.638,
    "end": 104.53,
    "duration": 4.892
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "常连类比喻、正反翻案，句式长短错落，如巨澜奔涌或机锋毕露，与其自由主旨互为表里。",
    "start": 105.538,
    "end": 113.87,
    "duration": 8.332
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 诙谐辛辣讽刺与深远文学滋养",
    "start": 114.838,
    "end": 118.49,
    "duration": 3.652
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "《秋水》将梁国相印比作腐鼠、高洁志趣比鹓雏；《列御寇》以曹商舔痔得车讽阿附权贵，显独立风骨；",
    "start": 119.498,
    "end": 131.57,
    "duration": 12.072
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "以汪洋文风与寓言传统滋养司马迁、阮籍、李白、苏轼，成文人安顿心灵的精神源泉。",
    "start": 132.538,
    "end": 141.63,
    "duration": 9.092
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《庄子》借“三言”寓言、奇幻想象与汪洋恣肆章法将哲理化为诗意散文，",
    "start": 142.598,
    "end": 149.25,
    "duration": 6.652
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "其自由与讽世品格深远影响汉赋、魏晋玄风及李白、苏轼等后代作家。",
    "start": 149.478,
    "end": 156.37,
    "duration": 6.892
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅在《汉文学史纲要》赞其“晚周诸子之作，莫能先也”；刘熙载《艺概》评其“意出尘外，怪生笔端”。",
    "start": 157.418,
    "end": 166.81,
    "duration": 9.392
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 庄子“三言”与四个核心寓言篇目各是什么？",
    "start": 167.858,
    "end": 172.75,
    "duration": 4.892
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 《逍遥游》《齐物论》与《列御寇》各体现哪一项特质？",
    "start": 173.618,
    "end": 179.55,
    "duration": 5.932
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 鲁迅《汉文学史纲要》与刘熙载《艺概》两句评语？",
    "start": 180.138,
    "end": 186.91,
    "duration": 6.772
  }
]