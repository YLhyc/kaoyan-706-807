[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《庄子》·散文艺术特色与浪漫主义",
    "start": 0.134,
    "end": 3.102,
    "duration": 2.968
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "先解决“拿什么说理”（三言寓言），再放飞“思绪怎么飞”（鲲鹏梦蝶奇想），",
    "start": 3.691,
    "end": 10.252,
    "duration": 6.561
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "落成“文章怎么排”（汪洋恣肆章法），",
    "start": 10.462,
    "end": 13.273,
    "duration": 2.811
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后亮出“如何回看俗世与传给后代”（辛辣讽刺+滋养太白东坡）。",
    "start": 13.574,
    "end": 19.198,
    "duration": 5.624
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《庄子》是先秦诸子散文高峰与浪漫主义源头。",
    "start": 19.784,
    "end": 23.845,
    "duration": 4.062
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "庄子突破语录与专题论辩板滞，以奇幻想象融哲思于诗意，",
    "start": 24.42,
    "end": 29.731,
    "duration": 5.311
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "鲁迅在《汉文学史纲要》赞其“晚周诸子之作，莫能先也”。",
    "start": 30.084,
    "end": 34.614,
    "duration": 4.53
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 善用“三言”与寓言化理为象",
    "start": 35.188,
    "end": 38.247,
    "duration": 3.059
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "建立“寓言”“重言”“卮言”为主体的表述，秉持“寓言十九，藉外论之”；",
    "start": 38.834,
    "end": 45.161,
    "duration": 6.327
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《庖丁解牛》以游刃有余喻养生，《秋水》河伯北海喻认知有限，《人间世》“螳臂当车”警示，",
    "start": 45.735,
    "end": 54.849,
    "duration": 9.114
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《养生主》薪火相传譬喻，化抽象哲理为鲜活形象。",
    "start": 55.084,
    "end": 59.549,
    "duration": 4.465
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 展开雄奇飞腾的浪漫想象",
    "start": 60.123,
    "end": 63.208,
    "duration": 3.085
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《逍遥游》开篇写鲲鹏“水击三千里，抟扶摇而上者九万里”，以壮阔图景寄寓精神超越；",
    "start": 63.795,
    "end": 71.372,
    "duration": 7.577
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《齐物论》末以轻灵笔触写庄周梦蝶，借物我泯灭展现物化互通诗意，注入自由浪漫气息。",
    "start": 71.959,
    "end": 80.578,
    "duration": 8.619
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 形成汪洋恣肆的自由章法气势",
    "start": 81.165,
    "end": 84.497,
    "duration": 3.332
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "刘熙载《艺概》评其“意出尘外，怪生笔端”。",
    "start": 85.071,
    "end": 88.846,
    "duration": 3.775
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "不设呆板提纲，由核心意象随物赋形、层层生发；",
    "start": 89.42,
    "end": 94.458,
    "duration": 5.038
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "常连类比喻、正反翻案，句式长短错落，如巨澜奔涌或机锋毕露，与其自由主旨互为表里。",
    "start": 94.745,
    "end": 102.987,
    "duration": 8.241
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 诙谐辛辣讽刺与深远文学滋养",
    "start": 103.561,
    "end": 107.114,
    "duration": 3.554
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "《秋水》将梁国相印比作腐鼠、高洁志趣比鹓雏；《列御寇》以曹商舔痔得车讽阿附权贵，显独立风骨；",
    "start": 107.701,
    "end": 118.195,
    "duration": 10.494
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "以汪洋文风与寓言传统滋养司马迁、阮籍、李白、苏轼，成文人安顿心灵的精神源泉。",
    "start": 118.782,
    "end": 128.338,
    "duration": 9.556
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《庄子》借“三言”寓言、奇幻想象与汪洋恣肆章法将哲理化为诗意散文，",
    "start": 128.925,
    "end": 135.448,
    "duration": 6.522
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "其自由与讽世品格深远影响汉赋、魏晋玄风及李白、苏轼等后代作家。",
    "start": 135.735,
    "end": 142.687,
    "duration": 6.952
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅在《汉文学史纲要》赞其“晚周诸子之作，莫能先也”；刘熙载《艺概》评其“意出尘外，怪生笔端”。",
    "start": 143.274,
    "end": 152.257,
    "duration": 8.983
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 庄子“三言”与四个核心寓言篇目各是什么？",
    "start": 152.844,
    "end": 157.83,
    "duration": 4.986
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 《逍遥游》《齐物论》与《列御寇》各体现哪一项特质？",
    "start": 158.391,
    "end": 163.677,
    "duration": 5.285
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 鲁迅《汉文学史纲要》与刘熙载《艺概》两句评语？",
    "start": 164.251,
    "end": 169.471,
    "duration": 5.22
  }
]