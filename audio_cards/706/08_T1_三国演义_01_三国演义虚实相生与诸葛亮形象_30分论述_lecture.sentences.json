[
  {
    "id": 1,
    "text": "篇头：全题宏观破题与立论逻辑。",
    "start": 0.08,
    "end": 3.68,
    "duration": 3.6
  },
  {
    "id": 2,
    "text": "问题一：这道题到底在问什么？。",
    "start": 3.68,
    "end": 6.8,
    "duration": 3.12
  },
  {
    "id": 3,
    "text": "这道题将“虚实相生艺术”与“诸葛亮形象塑造”双轴并置。",
    "start": 6.8,
    "end": 11.642,
    "duration": 4.842
  },
  {
    "id": 4,
    "text": "在考场上，考生绝不能把技法与人物割裂开来。",
    "start": 11.642,
    "end": 15.908,
    "duration": 4.266
  },
  {
    "id": 5,
    "text": "必须深刻指出：虚实相生是创造诸葛亮这一千古艺术形象的核心叙事机制，",
    "start": 15.908,
    "end": 22.869,
    "duration": 6.961
  },
  {
    "id": 6,
    "text": "而诸葛亮则是虚实相生原则最集中的美学载体。",
    "start": 22.869,
    "end": 27.36,
    "duration": 4.491
  },
  {
    "id": 7,
    "text": "问题二：宏观立论核心指向哪里？。",
    "start": 27.44,
    "end": 30.4,
    "duration": 2.96
  },
  {
    "id": 8,
    "text": "立论核心必须紧扣章学诚《文史通义》中“七分实事，",
    "start": 30.4,
    "end": 34.96,
    "duration": 4.56
  },
  {
    "id": 9,
    "text": "三分虚构”的权威定评，以及毛宗岗对诸葛亮“智绝”的评价。",
    "start": 34.96,
    "end": 39.68,
    "duration": 4.72
  },
  {
    "id": 10,
    "text": "阐明小说通过大事不虚、小事不拘的叙事智慧，",
    "start": 39.68,
    "end": 43.84,
    "duration": 4.16
  },
  {
    "id": 11,
    "text": "将历史真实转化为崇高的文学典型。",
    "start": 43.84,
    "end": 46.56,
    "duration": 2.72
  },
  {
    "id": 12,
    "text": "问题三：由浅入深拆解为哪几个答题维度？。",
    "start": 46.8,
    "end": 50.64,
    "duration": 3.84
  },
  {
    "id": 13,
    "text": "本题按叙事机制向人物纵深开掘拆解为四个逻辑维度：第一维度，",
    "start": 50.64,
    "end": 56.24,
    "duration": 5.6
  },
  {
    "id": 14,
    "text": "叙事法度，界定“七分实事，三分虚构”的内涵，",
    "start": 56.24,
    "end": 59.76,
    "duration": 3.52
  },
  {
    "id": 15,
    "text": "剖析历史真实与艺术虚构的辩证关系。",
    "start": 59.76,
    "end": 62.88,
    "duration": 3.12
  },
  {
    "id": 16,
    "text": "第二维度，智绝塑造，由宏观战略到微观谋略，",
    "start": 62.88,
    "end": 66.64,
    "duration": 3.76
  },
  {
    "id": 17,
    "text": "辨析虚构手法如何强化其超凡智慧并客观评价鲁迅之论。",
    "start": 66.64,
    "end": 71.52,
    "duration": 4.88
  },
  {
    "id": 18,
    "text": "第三维度，忠绝人格与悲剧意蕴，深入精神伦理层面，",
    "start": 71.76,
    "end": 76.64,
    "duration": 4.88
  },
  {
    "id": 19,
    "text": "分析出师表誓言与知其不可而为之的崇高悲剧感。",
    "start": 76.64,
    "end": 81.44,
    "duration": 4.8
  },
  {
    "id": 20,
    "text": "第四维度，文学史影响，总结其对历史演义体裁范式的确立，",
    "start": 81.44,
    "end": 86.88,
    "duration": 5.44
  },
  {
    "id": 21,
    "text": "以及对民族文化心理的深远塑造。",
    "start": 86.88,
    "end": 89.92,
    "duration": 3.04
  },
  {
    "id": 22,
    "text": "问题四：各维度之间具备怎样不可逆的递进因果链条？。",
    "start": 89.92,
    "end": 94.32,
    "duration": 4.4
  },
  {
    "id": 23,
    "text": "第一步必须先在宏观上确立历史演义小说的体裁地位与虚实总纲。",
    "start": 94.64,
    "end": 100.0,
    "duration": 5.36
  },
  {
    "id": 24,
    "text": "第二步深入剖析虚实相生的具体运作法则。",
    "start": 100.0,
    "end": 103.52,
    "duration": 3.52
  },
  {
    "id": 25,
    "text": "第三步顺理成章将这种法则落实在人物的智谋表现上。",
    "start": 103.52,
    "end": 108.0,
    "duration": 4.48
  },
  {
    "id": 26,
    "text": "第四步由外在智谋进一步向内下沉至忠贞伦理与悲剧宿命的哲学高度。",
    "start": 108.0,
    "end": 113.76,
    "duration": 5.76
  },
  {
    "id": 27,
    "text": "第五步由人物个体回收到文学史脉络，",
    "start": 114.0,
    "end": 117.68,
    "duration": 3.68
  },
  {
    "id": 28,
    "text": "完成对体裁范式与民族心理认同的历史闭环。",
    "start": 117.68,
    "end": 122.0,
    "duration": 4.32
  },
  {
    "id": 29,
    "text": "--。第",
    "start": 122.0,
    "end": 122.16,
    "duration": 0.16
  },
  {
    "id": 30,
    "text": "一部分：破题立论与体裁范式确立。",
    "start": 122.16,
    "end": 125.36,
    "duration": 3.2
  },
  {
    "id": 31,
    "text": "逐句因果推导与答题表述。",
    "start": 125.36,
    "end": 127.92,
    "duration": 2.56
  },
  {
    "id": 32,
    "text": "为了开篇直击考点要害并确立学术基调，",
    "start": 127.92,
    "end": 131.6,
    "duration": 3.68
  },
  {
    "id": 33,
    "text": "第一句必须给出小说在体裁史上的开创性地位与章学诚的权威定评。",
    "start": 131.6,
    "end": 137.28,
    "duration": 5.68
  },
  {
    "id": 34,
    "text": "所以表述为：《三国演义》是中国文学史上第一部成熟的章回体长篇历史演义小说，",
    "start": 137.648,
    "end": 144.608,
    "duration": 6.96
  },
  {
    "id": 35,
    "text": "清代史学家章学诚在《文史通义》中精辟概括其艺术精髓为“七分实事，",
    "start": 144.608,
    "end": 151.248,
    "duration": 6.64
  },
  {
    "id": 36,
    "text": "三分虚构”。。",
    "start": 151.248,
    "end": 152.688,
    "duration": 1.44
  },
  {
    "id": 37,
    "text": "紧接着必须点明作者罗贯中的历史依据与核心创作范式，",
    "start": 152.688,
    "end": 157.488,
    "duration": 4.8
  },
  {
    "id": 38,
    "text": "引出全书的艺术本质。",
    "start": 157.488,
    "end": 159.408,
    "duration": 1.92
  },
  {
    "id": 39,
    "text": "所以表述为：作者罗贯中依托汉末三国波澜壮阔的历史风云，",
    "start": 159.808,
    "end": 164.724,
    "duration": 4.916
  },
  {
    "id": 40,
    "text": "开创了虚实相生的美学范式。。",
    "start": 164.724,
    "end": 167.102,
    "duration": 2.378
  },
  {
    "id": 41,
    "text": "随后必须立即引入题目所指涉的核心人物，",
    "start": 167.102,
    "end": 170.669,
    "duration": 3.567
  },
  {
    "id": 42,
    "text": "指出诸葛亮在全书宏大人物网络中的顶峰地位。",
    "start": 170.669,
    "end": 174.632,
    "duration": 3.963
  },
  {
    "id": 43,
    "text": "所以表述为：在全书星罗棋布的英雄谱系中，",
    "start": 174.632,
    "end": 178.199,
    "duration": 3.567
  },
  {
    "id": 44,
    "text": "诸葛亮是全书塑造最为成功的核心典型。。",
    "start": 178.199,
    "end": 181.568,
    "duration": 3.369
  },
  {
    "id": 45,
    "text": "最后一句必须引入毛宗岗的权威评语，",
    "start": 181.728,
    "end": 184.928,
    "duration": 3.2
  },
  {
    "id": 46,
    "text": "并从道德理想与艺术虚构的交融维度进行立论收束。",
    "start": 184.928,
    "end": 189.728,
    "duration": 4.8
  },
  {
    "id": 47,
    "text": "所以表述为：清代毛宗岗尊其为三国“三绝”中之“智绝”，",
    "start": 189.728,
    "end": 195.088,
    "duration": 5.36
  },
  {
    "id": 48,
    "text": "生动体现了崇高儒家道德理想与浪漫主义艺术虚构的完美熔铸。。",
    "start": 195.088,
    "end": 200.528,
    "duration": 5.44
  },
  {
    "id": 49,
    "text": "本段答题思路总结。",
    "start": 200.768,
    "end": 202.128,
    "duration": 1.36
  },
  {
    "id": 50,
    "text": "本段用四句话完成全篇破题：首句给出章回体演义鼻祖地位与章学诚名评，",
    "start": 202.128,
    "end": 208.768,
    "duration": 6.64
  },
  {
    "id": 51,
    "text": "次句标举虚实相生总原则，第三四句迅速聚焦诸葛亮核心典型，",
    "start": 208.768,
    "end": 214.288,
    "duration": 5.52
  },
  {
    "id": 52,
    "text": "引入毛宗岗智绝定评并点出道德与艺术虚构的统一，",
    "start": 214.288,
    "end": 219.088,
    "duration": 4.8
  },
  {
    "id": 53,
    "text": "下笔沉稳极具章法。",
    "start": 219.088,
    "end": 220.688,
    "duration": 1.6
  },
  {
    "id": 54,
    "text": "所以本段具体答题完整版为：《三国演义》是中国文学史上第一部成熟的章回体长篇历史演义小说，",
    "start": 221.008,
    "end": 229.008,
    "duration": 8.0
  },
  {
    "id": 55,
    "text": "清代史学家章学诚在《文史通义》中精辟概括其艺术精髓为“七分实事，",
    "start": 229.008,
    "end": 234.928,
    "duration": 5.92
  },
  {
    "id": 56,
    "text": "三分虚构”。",
    "start": 234.928,
    "end": 235.968,
    "duration": 1.04
  },
  {
    "id": 57,
    "text": "作者罗贯中依托汉末三国波澜壮阔的历史风云，",
    "start": 235.968,
    "end": 239.968,
    "duration": 4.0
  },
  {
    "id": 58,
    "text": "开创了虚实相生的美学范式。",
    "start": 239.968,
    "end": 242.368,
    "duration": 2.4
  },
  {
    "id": 59,
    "text": "在全书星罗棋布的英雄谱系中，诸葛亮是全书塑造最为成功的核心典型。",
    "start": 242.608,
    "end": 248.928,
    "duration": 6.32
  },
  {
    "id": 60,
    "text": "清代毛宗岗尊其为三国“三绝”中之“智绝”，",
    "start": 248.928,
    "end": 252.768,
    "duration": 3.84
  },
  {
    "id": 61,
    "text": "生动体现了崇高儒家道德理想与浪漫主义艺术虚构的完美熔铸。",
    "start": 252.768,
    "end": 258.288,
    "duration": 5.52
  },
  {
    "id": 62,
    "text": "--。第",
    "start": 258.288,
    "end": 258.448,
    "duration": 0.16
  },
  {
    "id": 63,
    "text": "二部分：虚实相生的叙事法则与艺术机制。",
    "start": 258.448,
    "end": 261.968,
    "duration": 3.52
  },
  {
    "id": 64,
    "text": "逐句因果推导与答题表述。",
    "start": 262.208,
    "end": 264.848,
    "duration": 2.64
  },
  {
    "id": 65,
    "text": "进入具体论述的第一层，必须首先把“七分实事，",
    "start": 264.848,
    "end": 269.008,
    "duration": 4.16
  },
  {
    "id": 66,
    "text": "三分虚构”的理论内涵彻底讲透，确立分析基准。",
    "start": 269.008,
    "end": 273.328,
    "duration": 4.32
  },
  {
    "id": 67,
    "text": "所以表述为：首先，“七分实事，三分虚构”确立了历史演义小说虚实相生的叙事法度。。",
    "start": 273.328,
    "end": 281.008,
    "duration": 7.68
  },
  {
    "id": 68,
    "text": "随后必须拆解分析“实事”这一极，",
    "start": 281.392,
    "end": 284.192,
    "duration": 2.8
  },
  {
    "id": 69,
    "text": "明确其在史实尊重上的边界与功能。",
    "start": 284.192,
    "end": 287.392,
    "duration": 3.2
  },
  {
    "id": 70,
    "text": "所以表述为：所谓“实事”，是指作品严格遵循《三国志》等正史的大体框架。。",
    "start": 287.392,
    "end": 293.792,
    "duration": 6.4
  },
  {
    "id": 71,
    "text": "接着用最具代表性的标志性历史大战与大格局进行举证，",
    "start": 293.792,
    "end": 298.592,
    "duration": 4.8
  },
  {
    "id": 72,
    "text": "说明历史的真实基石。",
    "start": 298.592,
    "end": 300.272,
    "duration": 1.68
  },
  {
    "id": 73,
    "text": "所以表述为：赤壁之战、官渡之战、",
    "start": 300.592,
    "end": 303.472,
    "duration": 2.88
  },
  {
    "id": 74,
    "text": "天下三分等重大历史走向与帝王年号绝不凭空捏造，",
    "start": 303.472,
    "end": 308.272,
    "duration": 4.8
  },
  {
    "id": 75,
    "text": "维持了历史叙事的坚实真实感。。",
    "start": 308.272,
    "end": 310.912,
    "duration": 2.64
  },
  {
    "id": 76,
    "text": "然后转换角度剖析“虚构”这一极，",
    "start": 310.912,
    "end": 314.032,
    "duration": 3.12
  },
  {
    "id": 77,
    "text": "阐明文学艺术是如何利用想象空间完成审美重塑的。",
    "start": 314.032,
    "end": 318.672,
    "duration": 4.64
  },
  {
    "id": 78,
    "text": "所以表述为：所谓“虚构”，是指作者在微观细节、",
    "start": 318.672,
    "end": 322.752,
    "duration": 4.08
  },
  {
    "id": 79,
    "text": "人物对白、机锋谋略中融入了丰富的民间传说与艺术想象。。",
    "start": 322.752,
    "end": 327.552,
    "duration": 4.8
  },
  {
    "id": 80,
    "text": "接着列出大众耳熟能详、极具考场辨识度的标志性虚构情节作为铁证。",
    "start": 327.872,
    "end": 334.032,
    "duration": 6.16
  },
  {
    "id": 81,
    "text": "所以表述为：草船借箭、借东风、空城计等经典情节皆为艺术虚构。。",
    "start": 334.032,
    "end": 339.786,
    "duration": 5.754
  },
  {
    "id": 82,
    "text": "本段尾句必须从美学辩证法的高度，",
    "start": 339.786,
    "end": 343.094,
    "duration": 3.308
  },
  {
    "id": 83,
    "text": "总结大事不虚与小事不拘的统一。",
    "start": 343.094,
    "end": 346.182,
    "duration": 3.088
  },
  {
    "id": 84,
    "text": "所以表述为：作品达成“大事不虚，",
    "start": 346.182,
    "end": 349.05,
    "duration": 2.868
  },
  {
    "id": 85,
    "text": "小事不拘”的和谐辩证，以真实历史为骨架，",
    "start": 349.05,
    "end": 352.799,
    "duration": 3.749
  },
  {
    "id": 86,
    "text": "以艺术虚构为血肉，实现了史学品格与文学审美的统一。。",
    "start": 352.799,
    "end": 357.872,
    "duration": 5.073
  },
  {
    "id": 87,
    "text": "本段答题思路总结。",
    "start": 357.952,
    "end": 359.632,
    "duration": 1.68
  },
  {
    "id": 88,
    "text": "本段逻辑严丝合缝：先揭示虚实相生的法则，",
    "start": 359.632,
    "end": 363.472,
    "duration": 3.84
  },
  {
    "id": 89,
    "text": "再分别拆解实事与虚构的各自功能，",
    "start": 363.472,
    "end": 366.672,
    "duration": 3.2
  },
  {
    "id": 90,
    "text": "连出正史骨架与草船借箭、空城计等经典情节，",
    "start": 366.672,
    "end": 371.312,
    "duration": 4.64
  },
  {
    "id": 91,
    "text": "最后以大事不虚、小事不拘的美学公式升华收束，",
    "start": 371.312,
    "end": 375.872,
    "duration": 4.56
  },
  {
    "id": 92,
    "text": "展现出极其纯熟的文学史剖析功底。",
    "start": 375.872,
    "end": 378.752,
    "duration": 2.88
  },
  {
    "id": 93,
    "text": "所以本段具体答题完整版为：首先，",
    "start": 379.072,
    "end": 382.112,
    "duration": 3.04
  },
  {
    "id": 94,
    "text": "“七分实事，三分虚构”确立了历史演义小说虚实相生的叙事法度。",
    "start": 382.112,
    "end": 387.152,
    "duration": 5.04
  },
  {
    "id": 95,
    "text": "所谓“实事”，是指作品严格遵循《三国志》等正史的大体框架。",
    "start": 387.152,
    "end": 391.312,
    "duration": 4.16
  },
  {
    "id": 96,
    "text": "赤壁之战、官渡之战、天下三分等重大历史走向与帝王年号绝不凭空捏造，",
    "start": 391.312,
    "end": 396.912,
    "duration": 5.6
  },
  {
    "id": 97,
    "text": "维持了历史叙事的坚实真实感。",
    "start": 396.912,
    "end": 399.152,
    "duration": 2.24
  },
  {
    "id": 98,
    "text": "所谓“虚构”，是指作者在微观细节、",
    "start": 399.472,
    "end": 402.352,
    "duration": 2.88
  },
  {
    "id": 99,
    "text": "人物对白、机锋谋略中融入了丰富的民间传说与艺术想象。",
    "start": 402.352,
    "end": 407.632,
    "duration": 5.28
  },
  {
    "id": 100,
    "text": "草船借箭、借东风、空城计等经典情节皆为艺术虚构。",
    "start": 407.632,
    "end": 412.672,
    "duration": 5.04
  },
  {
    "id": 101,
    "text": "作品达成“大事不虚，小事不拘”的和谐辩证，",
    "start": 412.672,
    "end": 416.272,
    "duration": 3.6
  },
  {
    "id": 102,
    "text": "以真实历史为骨架，以艺术虚构为血肉，",
    "start": 416.272,
    "end": 419.792,
    "duration": 3.52
  },
  {
    "id": 103,
    "text": "实现了史学品格与文学审美的统一。",
    "start": 419.792,
    "end": 422.592,
    "duration": 2.8
  },
  {
    "id": 104,
    "text": "---。第",
    "start": 422.832,
    "end": 423.076,
    "duration": 0.244
  },
  {
    "id": 105,
    "text": "三部分：智绝形象的超凡智慧与艺术夸张。",
    "start": 423.076,
    "end": 427.232,
    "duration": 4.156
  },
  {
    "id": 106,
    "text": "逐句因果推导与答题表述。",
    "start": 427.376,
    "end": 429.696,
    "duration": 2.32
  },
  {
    "id": 107,
    "text": "将虚实法则落实在人物上，首当其冲的是展现诸葛亮最为世人所称道的智慧特征，",
    "start": 429.696,
    "end": 436.976,
    "duration": 7.28
  },
  {
    "id": 108,
    "text": "首句必须立论明确。",
    "start": 436.976,
    "end": 439.056,
    "duration": 2.08
  },
  {
    "id": 109,
    "text": "所以表述为：其次，在诸葛亮形象塑造上，",
    "start": 439.056,
    "end": 442.816,
    "duration": 3.76
  },
  {
    "id": 110,
    "text": "虚实相生赋予其超凡入圣的“智绝”特质。。",
    "start": 442.816,
    "end": 446.176,
    "duration": 3.36
  },
  {
    "id": 111,
    "text": "分析智慧绝不能停留在单一故事，必须先从宏观战略格局展开，",
    "start": 446.416,
    "end": 452.016,
    "duration": 5.6
  },
  {
    "id": 112,
    "text": "彰显其作为战略家的理性智慧。",
    "start": 452.016,
    "end": 454.896,
    "duration": 2.88
  },
  {
    "id": 113,
    "text": "所以表述为：在宏观战略上，隆中对精准预判天下三分大势，",
    "start": 454.896,
    "end": 460.576,
    "duration": 5.68
  },
  {
    "id": 114,
    "text": "展现出高瞻远瞩的政治眼光。。",
    "start": 460.576,
    "end": 463.136,
    "duration": 2.56
  },
  {
    "id": 115,
    "text": "接着转向微观具体谋略，剖析作者是如何借助虚构手法实现民间集体智慧的汇聚。",
    "start": 463.136,
    "end": 470.096,
    "duration": 6.96
  },
  {
    "id": 116,
    "text": "所以表述为：在微观谋略上，作者将大量集体智慧与民间神异融入其一身。。",
    "start": 470.416,
    "end": 477.133,
    "duration": 6.717
  },
  {
    "id": 117,
    "text": "随后迅速调取赤壁大战期间具有代表性的标志性名场面予以印证。",
    "start": 477.133,
    "end": 483.463,
    "duration": 6.33
  },
  {
    "id": 118,
    "text": "所以表述为：赤壁大战中舌战群儒、",
    "start": 483.463,
    "end": 486.628,
    "duration": 3.165
  },
  {
    "id": 119,
    "text": "草船借箭与祭借东风，将军事韬略与奇门遁甲融合。。",
    "start": 486.628,
    "end": 491.376,
    "duration": 4.748
  },
  {
    "id": 120,
    "text": "为了展现深度心理战，进一步补充空城计这一家喻户晓的典型例证。",
    "start": 491.456,
    "end": 497.136,
    "duration": 5.68
  },
  {
    "id": 121,
    "text": "所以表述为：西城空城计则以抚琴弄险展示出知己知彼的超绝心理博弈。。",
    "start": 497.136,
    "end": 503.696,
    "duration": 6.56
  },
  {
    "id": 122,
    "text": "尾句必须直面鲁迅在《中国小说史略》中的经典定评，",
    "start": 503.696,
    "end": 508.096,
    "duration": 4.4
  },
  {
    "id": 123,
    "text": "并给出科学辩证的文学机制解释，防止踩入误区。",
    "start": 508.096,
    "end": 511.696,
    "duration": 3.6
  },
  {
    "id": 124,
    "text": "所以表述为：鲁迅在《中国小说史略》中虽指出其“状诸葛之多智而近妖”，",
    "start": 512.016,
    "end": 518.496,
    "duration": 6.48
  },
  {
    "id": 125,
    "text": "但这种夸张正是为了强化其作为全人类最高智慧化身的审美感染力。。",
    "start": 518.496,
    "end": 524.336,
    "duration": 5.84
  },
  {
    "id": 126,
    "text": "本段答题思路总结。",
    "start": 524.336,
    "end": 525.936,
    "duration": 1.6
  },
  {
    "id": 127,
    "text": "本段多维拆解其智谋体系：从宏观隆中对战略布局，",
    "start": 525.936,
    "end": 530.496,
    "duration": 4.56
  },
  {
    "id": 128,
    "text": "推进到微观赤壁大战、空城计谋略，",
    "start": 530.496,
    "end": 533.696,
    "duration": 3.2
  },
  {
    "id": 129,
    "text": "既有军事韬略又有心理博弈，最后主动引入鲁迅多智近妖的名评完成学理辩证，",
    "start": 533.696,
    "end": 540.416,
    "duration": 6.72
  },
  {
    "id": 130,
    "text": "不仅论据扎实而且具有极强的专业思辨性。",
    "start": 540.416,
    "end": 543.936,
    "duration": 3.52
  },
  {
    "id": 131,
    "text": "所以本段具体答题完整版为：其次，",
    "start": 543.936,
    "end": 546.8,
    "duration": 2.864
  },
  {
    "id": 132,
    "text": "在诸葛亮形象塑造上，虚实相生赋予其超凡入圣的“智绝”特质。",
    "start": 546.8,
    "end": 552.48,
    "duration": 5.68
  },
  {
    "id": 133,
    "text": "在宏观战略上，隆中对精准预判天下三分大势，",
    "start": 552.48,
    "end": 556.72,
    "duration": 4.24
  },
  {
    "id": 134,
    "text": "展现出高瞻远瞩的政治眼光。",
    "start": 556.72,
    "end": 559.04,
    "duration": 2.32
  },
  {
    "id": 135,
    "text": "在微观谋略上，作者将大量集体智慧与民间神异融入其一身。",
    "start": 559.04,
    "end": 564.16,
    "duration": 5.12
  },
  {
    "id": 136,
    "text": "赤壁大战中舌战群儒、草船借箭与祭借东风，",
    "start": 564.16,
    "end": 568.4,
    "duration": 4.24
  },
  {
    "id": 137,
    "text": "将军事韬略与奇门遁甲融合。",
    "start": 568.4,
    "end": 570.8,
    "duration": 2.4
  },
  {
    "id": 138,
    "text": "西城空城计则以抚琴弄险展示出知己知彼的超绝心理博弈。",
    "start": 571.12,
    "end": 576.16,
    "duration": 5.04
  },
  {
    "id": 139,
    "text": "鲁迅在《中国小说史略》中虽指出其“状诸葛之多智而近妖”，",
    "start": 576.16,
    "end": 581.44,
    "duration": 5.28
  },
  {
    "id": 140,
    "text": "但这种夸张正是为了强化其作为全人类最高智慧化身的审美感染力。",
    "start": 581.44,
    "end": 587.12,
    "duration": 5.68
  },
  {
    "id": 141,
    "text": "--。第",
    "start": 587.12,
    "end": 587.36,
    "duration": 0.24
  },
  {
    "id": 142,
    "text": "四部分：忠绝人格的伦理光辉与历史悲剧崇高。",
    "start": 587.36,
    "end": 591.2,
    "duration": 3.84
  },
  {
    "id": 143,
    "text": "逐句因果推导与答题表述。",
    "start": 591.52,
    "end": 594.08,
    "duration": 2.56
  },
  {
    "id": 144,
    "text": "超越机谋层面，人物论述必须深入精神灵魂，",
    "start": 594.08,
    "end": 598.16,
    "duration": 4.08
  },
  {
    "id": 145,
    "text": "首句直接揭示其“忠绝”人格与崇高悲剧性的深刻结合。",
    "start": 598.16,
    "end": 602.96,
    "duration": 4.8
  },
  {
    "id": 146,
    "text": "所以表述为：再次，虚实相生更熔铸了诸葛亮鞠躬尽瘁的“忠绝”人格与崇高历史悲剧意蕴。。",
    "start": 602.96,
    "end": 610.48,
    "duration": 7.52
  },
  {
    "id": 147,
    "text": "接着剖析小说的思想倾向，阐明作者尊刘贬曹正统观如何借诸葛亮落实为儒家理想人格。",
    "start": 610.72,
    "end": 618.88,
    "duration": 8.16
  },
  {
    "id": 148,
    "text": "所以表述为：罗贯中在尊刘贬曹的正统伦理倾向下，",
    "start": 618.88,
    "end": 623.6,
    "duration": 4.72
  },
  {
    "id": 149,
    "text": "将诸葛亮塑造成儒家内圣外王人格的完美化身。。",
    "start": 623.6,
    "end": 628.0,
    "duration": 4.4
  },
  {
    "id": 150,
    "text": "随后连缀三顾茅庐、白帝城托孤等关键节点，",
    "start": 628.0,
    "end": 632.0,
    "duration": 4.0
  },
  {
    "id": 151,
    "text": "并以《出师表》核心警句作为人格誓言的铁证。",
    "start": 632.0,
    "end": 635.28,
    "duration": 3.28
  },
  {
    "id": 152,
    "text": "所以表述为：从三顾茅庐的感遇知恩，",
    "start": 635.6,
    "end": 638.784,
    "duration": 3.184
  },
  {
    "id": 153,
    "text": "到白帝托孤的受命于危难，诸葛亮用一生践行了《出师表》中“鞠躬尽瘁，",
    "start": 638.784,
    "end": 644.832,
    "duration": 6.048
  },
  {
    "id": 154,
    "text": "死而后已”的政治誓言。。",
    "start": 644.832,
    "end": 646.776,
    "duration": 1.944
  },
  {
    "id": 155,
    "text": "接着深入晚年北伐的历史宿命，剖析明知不可为而为之的壮烈意志。",
    "start": 646.776,
    "end": 652.824,
    "duration": 6.048
  },
  {
    "id": 156,
    "text": "所以表述为：晚年他六出祁山、九伐中原，",
    "start": 652.824,
    "end": 656.28,
    "duration": 3.456
  },
  {
    "id": 157,
    "text": "明知汉室不可复兴、天命难以逆转，",
    "start": 656.28,
    "end": 659.304,
    "duration": 3.024
  },
  {
    "id": 158,
    "text": "依然决然知其不可而为之。。",
    "start": 659.304,
    "end": 661.68,
    "duration": 2.376
  },
  {
    "id": 159,
    "text": "本段收束句以五丈原星落的标志性悲剧场景收束，",
    "start": 661.76,
    "end": 665.84,
    "duration": 4.08
  },
  {
    "id": 160,
    "text": "将人物形象彻底升华至崇高悲剧美学顶峰。",
    "start": 665.84,
    "end": 669.52,
    "duration": 3.68
  },
  {
    "id": 161,
    "text": "所以表述为：最终病殁五丈原，流露出英雄失路、",
    "start": 669.52,
    "end": 674.16,
    "duration": 4.64
  },
  {
    "id": 162,
    "text": "苍天不佑的深沉悲壮，使诸葛亮的人格超越了成败功利，",
    "start": 674.16,
    "end": 678.8,
    "duration": 4.64
  },
  {
    "id": 163,
    "text": "升华到崇高悲剧美学巅峰。。",
    "start": 678.8,
    "end": 681.28,
    "duration": 2.48
  },
  {
    "id": 164,
    "text": "本段答题思路总结。",
    "start": 681.28,
    "end": 682.56,
    "duration": 1.28
  },
  {
    "id": 165,
    "text": "本段将人物塑造推向思想精神的顶峰：揭示内圣外王与尊刘正统的伦理根源，",
    "start": 682.928,
    "end": 689.888,
    "duration": 6.96
  },
  {
    "id": 166,
    "text": "以出师表鞠躬尽瘁誓言串联三顾茅庐与托孤，",
    "start": 689.888,
    "end": 694.048,
    "duration": 4.16
  },
  {
    "id": 167,
    "text": "深挖明知不可为而为之的悲壮哲学，",
    "start": 694.048,
    "end": 697.568,
    "duration": 3.52
  },
  {
    "id": 168,
    "text": "最终收束于五丈原的崇高悲剧感，极具撼人心魄的艺术感染力。",
    "start": 697.568,
    "end": 703.088,
    "duration": 5.52
  },
  {
    "id": 169,
    "text": "所以本段具体答题完整版为：再次，",
    "start": 703.088,
    "end": 706.368,
    "duration": 3.28
  },
  {
    "id": 170,
    "text": "虚实相生更熔铸了诸葛亮鞠躬尽瘁的“忠绝”人格与崇高历史悲剧意蕴。",
    "start": 706.368,
    "end": 712.448,
    "duration": 6.08
  },
  {
    "id": 171,
    "text": "罗贯中在尊刘贬曹的正统伦理倾向下，",
    "start": 712.448,
    "end": 716.048,
    "duration": 3.6
  },
  {
    "id": 172,
    "text": "将诸葛亮塑造成儒家内圣外王人格的完美化身。",
    "start": 716.048,
    "end": 720.448,
    "duration": 4.4
  },
  {
    "id": 173,
    "text": "从三顾茅庐的感遇知恩，到白帝托孤的受命于危难，",
    "start": 720.448,
    "end": 724.928,
    "duration": 4.48
  },
  {
    "id": 174,
    "text": "诸葛亮用一生践行了《出师表》中“鞠躬尽瘁，",
    "start": 724.928,
    "end": 728.688,
    "duration": 3.76
  },
  {
    "id": 175,
    "text": "死而后已”的政治誓言。",
    "start": 728.688,
    "end": 730.528,
    "duration": 1.84
  },
  {
    "id": 176,
    "text": "晚年他六出祁山、九伐中原，明知汉室不可复兴、",
    "start": 730.848,
    "end": 735.568,
    "duration": 4.72
  },
  {
    "id": 177,
    "text": "天命难以逆转，依然决然知其不可而为之。",
    "start": 735.568,
    "end": 740.288,
    "duration": 4.72
  },
  {
    "id": 178,
    "text": "最终病殁五丈原，流露出英雄失路、",
    "start": 740.288,
    "end": 743.568,
    "duration": 3.28
  },
  {
    "id": 179,
    "text": "苍天不佑的深沉悲壮，使诸葛亮的人格超越了成败功利，",
    "start": 743.568,
    "end": 748.768,
    "duration": 5.2
  },
  {
    "id": 180,
    "text": "升华到崇高悲剧美学巅峰。",
    "start": 748.768,
    "end": 752.048,
    "duration": 3.28
  },
  {
    "id": 181,
    "text": "--。第",
    "start": 752.048,
    "end": 752.208,
    "duration": 0.16
  },
  {
    "id": 182,
    "text": "五部分：总结升华与文学史范式价值。",
    "start": 752.208,
    "end": 755.568,
    "duration": 3.36
  },
  {
    "id": 183,
    "text": "逐句因果推导与答题表述。",
    "start": 755.888,
    "end": 758.368,
    "duration": 2.48
  },
  {
    "id": 184,
    "text": "经过以上四个维度的完整展开，结尾段必须跳出文本本身，",
    "start": 758.368,
    "end": 763.488,
    "duration": 5.12
  },
  {
    "id": 185,
    "text": "在长篇小说史与民族文化心理中确立其恒久价值。",
    "start": 763.488,
    "end": 768.048,
    "duration": 4.56
  },
  {
    "id": 186,
    "text": "所以表述为：最后，《三国演义》的虚实相生艺术与诸葛亮形象，",
    "start": 768.048,
    "end": 773.168,
    "duration": 5.12
  },
  {
    "id": 187,
    "text": "对后世文学创作树立了永恒的范式标杆。。",
    "start": 773.168,
    "end": 776.448,
    "duration": 3.28
  },
  {
    "id": 188,
    "text": "第二句话需要从纯文学体裁演变角度，",
    "start": 776.768,
    "end": 779.968,
    "duration": 3.2
  },
  {
    "id": 189,
    "text": "点明其对中国古代历史演义小说流派的奠基意义。",
    "start": 779.968,
    "end": 784.048,
    "duration": 4.08
  },
  {
    "id": 190,
    "text": "所以表述为：它成功解决了历史真实与艺术虚构的内在张力，",
    "start": 784.048,
    "end": 789.488,
    "duration": 5.44
  },
  {
    "id": 191,
    "text": "直接奠定了后世历史演义小说的创作规范。。",
    "start": 789.488,
    "end": 792.848,
    "duration": 3.36
  },
  {
    "id": 192,
    "text": "第三句话必须超越文学技巧，指出诸葛亮作为文化符号对整个中华民族精神认同的深远铸造，",
    "start": 792.848,
    "end": 800.608,
    "duration": 7.76
  },
  {
    "id": 193,
    "text": "完成大题圆满闭环。",
    "start": 800.608,
    "end": 802.368,
    "duration": 1.76
  },
  {
    "id": 194,
    "text": "所以表述为：诸葛亮身上所凝结的超绝智慧、",
    "start": 802.688,
    "end": 806.288,
    "duration": 3.6
  },
  {
    "id": 195,
    "text": "忠贞品格与悲剧宿命，深刻塑造了中华民族对理想贤相与崇高英雄的文化认同，",
    "start": 806.288,
    "end": 813.088,
    "duration": 6.8
  },
  {
    "id": 196,
    "text": "成为中国古代叙事文学中最璀璨的艺术丰碑。。",
    "start": 813.088,
    "end": 816.848,
    "duration": 3.76
  },
  {
    "id": 197,
    "text": "本段答题思路总结。",
    "start": 816.848,
    "end": 818.448,
    "duration": 1.6
  },
  {
    "id": 198,
    "text": "本段以宏阔的史学与文化视界完成总结：首句立定范式标杆地位，",
    "start": 818.448,
    "end": 823.728,
    "duration": 5.28
  },
  {
    "id": 199,
    "text": "次句阐明化解历史与虚构张力的体式贡献，",
    "start": 823.728,
    "end": 827.248,
    "duration": 3.52
  },
  {
    "id": 200,
    "text": "尾句升华至民族精神认同与理想贤相典范，",
    "start": 827.248,
    "end": 831.168,
    "duration": 3.92
  },
  {
    "id": 201,
    "text": "结构周严，气魄沉雄。",
    "start": 831.168,
    "end": 833.088,
    "duration": 1.92
  },
  {
    "id": 202,
    "text": "所以本段具体答题完整版为：最后，",
    "start": 833.088,
    "end": 836.184,
    "duration": 3.096
  },
  {
    "id": 203,
    "text": "《三国演义》的虚实相生艺术与诸葛亮形象，",
    "start": 836.184,
    "end": 839.944,
    "duration": 3.76
  },
  {
    "id": 204,
    "text": "对后世文学创作树立了永恒的范式标杆。",
    "start": 839.944,
    "end": 843.544,
    "duration": 3.6
  },
  {
    "id": 205,
    "text": "它成功解决了历史真实与艺术虚构的内在张力，",
    "start": 843.544,
    "end": 847.624,
    "duration": 4.08
  },
  {
    "id": 206,
    "text": "直接奠定了后世历史演义小说的创作规范。",
    "start": 847.624,
    "end": 851.064,
    "duration": 3.44
  },
  {
    "id": 207,
    "text": "诸葛亮身上所凝结的超绝智慧、忠贞品格与悲剧宿命，",
    "start": 851.064,
    "end": 855.864,
    "duration": 4.8
  },
  {
    "id": 208,
    "text": "深刻塑造了中华民族对理想贤相与崇高英雄的文化认同，",
    "start": 855.864,
    "end": 861.064,
    "duration": 5.2
  },
  {
    "id": 209,
    "text": "成为中国古代叙事文学中最璀璨的艺术丰碑。",
    "start": 861.064,
    "end": 864.824,
    "duration": 3.76
  },
  {
    "id": 210,
    "text": "篇尾：整道大题的内在逻辑链总括。",
    "start": 865.144,
    "end": 868.424,
    "duration": 3.28
  },
  {
    "id": 211,
    "text": "为了便于考生在脑海中建立极速调取机制，",
    "start": 868.424,
    "end": 872.104,
    "duration": 3.68
  },
  {
    "id": 212,
    "text": "整道大题的论证逻辑可提炼为如下不可逆的六步链条：一、",
    "start": 872.104,
    "end": 877.464,
    "duration": 5.36
  },
  {
    "id": 213,
    "text": "文体定性：开篇直接以章学诚“七分实事，",
    "start": 877.464,
    "end": 881.384,
    "duration": 3.92
  },
  {
    "id": 214,
    "text": "三分虚构”与毛宗岗“智绝”定性，",
    "start": 881.384,
    "end": 884.184,
    "duration": 2.8
  },
  {
    "id": 215,
    "text": "确立虚实叙事与人物载体。",
    "start": 884.184,
    "end": 886.424,
    "duration": 2.24
  },
  {
    "id": 216,
    "text": "二、机制拆解：严密界定大事不虚的正史骨架与小事不拘的草船借箭、",
    "start": 886.824,
    "end": 892.664,
    "duration": 5.84
  },
  {
    "id": 217,
    "text": "空城计虚构，阐明虚实相生的辩证法。",
    "start": 892.664,
    "end": 895.784,
    "duration": 3.12
  },
  {
    "id": 218,
    "text": "三、智绝展现：宏观以隆中对展战略远见，",
    "start": 895.784,
    "end": 899.384,
    "duration": 3.6
  },
  {
    "id": 219,
    "text": "微观以舌战借风空城展神机妙算，并科学辨析鲁迅多智近妖之论。",
    "start": 899.384,
    "end": 905.144,
    "duration": 5.76
  },
  {
    "id": 220,
    "text": "四、忠绝升华：以尊刘正统内圣外王为底色，",
    "start": 905.144,
    "end": 908.744,
    "duration": 3.6
  },
  {
    "id": 221,
    "text": "以出师表鞠躬尽瘁串联托孤，展现知其不可而为之的英雄担当。",
    "start": 908.744,
    "end": 913.784,
    "duration": 5.04
  },
  {
    "id": 222,
    "text": "五、悲剧崇高：定格五丈原星落秋风，",
    "start": 914.184,
    "end": 918.664,
    "duration": 4.48
  },
  {
    "id": 223,
    "text": "将人物从凡俗成败功利拔高至超越命运的崇高悲剧美学巅峰。",
    "start": 918.664,
    "end": 925.064,
    "duration": 6.4
  },
  {
    "id": 224,
    "text": "六、文化闭环：确立历史演义小说的最高创作规式，",
    "start": 925.064,
    "end": 929.784,
    "duration": 4.72
  },
  {
    "id": 225,
    "text": "点明其作为中华民族理想贤相与精神图腾的永恒价值。",
    "start": 929.784,
    "end": 934.984,
    "duration": 5.2
  }
]