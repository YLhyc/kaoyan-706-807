[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "陶渊明·田园诗艺术特色与文化品格",
    "start": 0.154,
    "end": 3.526,
    "duration": 3.372
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "写什么→怎么写→何等人→遗泽谁：先开创亲身躬耕的“田园题材”，",
    "start": 4.234,
    "end": 11.206,
    "duration": 6.972
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "为适配这种生活自然洗净雕饰写成“平淡自然”白描语言，",
    "start": 11.514,
    "end": 16.566,
    "duration": 5.052
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "背后支撑这一选择的是儒道兼融、不为五斗米折腰的人格风骨，",
    "start": 16.794,
    "end": 21.766,
    "duration": 4.972
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最终成为王孟苏轼安身立命的精神家园。",
    "start": 21.914,
    "end": 25.606,
    "duration": 3.692
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "陶渊明是古典田园诗开创者，辞官归隐后突破玄言说理与雕琢风气，首将亲身农耕引入诗歌。",
    "start": 26.126,
    "end": 34.938,
    "duration": 8.812
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "苏轼《与苏辙书》赞其“质而实绮，癯而实腴”。",
    "start": 35.296,
    "end": 39.308,
    "duration": 4.012
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 开创田园题材、躬耕融于诗意",
    "start": 40.016,
    "end": 43.468,
    "duration": 3.452
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "非只赏景，而是以士大夫身份亲身躬耕，将耕作甘苦升华为精神选择；",
    "start": 43.996,
    "end": 50.728,
    "duration": 6.732
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《归园田居·其一》绘“方宅十余亩，草屋八九间”村居；",
    "start": 51.256,
    "end": 57.828,
    "duration": 6.572
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《其三》写“晨兴理荒秽，带月荷锄归”与“衣沾不足惜，但使愿无违”。",
    "start": 58.026,
    "end": 65.798,
    "duration": 7.772
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 追求“平淡自然”、淡中见警策",
    "start": 66.275,
    "end": 69.967,
    "duration": 3.692
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "摆脱玄言抽象说理与晋宋偶对雕饰，取家常口语白描，朴素中见绮丽；",
    "start": 70.484,
    "end": 79.216,
    "duration": 8.732
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《饮酒·其五》“采菊东篱下，悠然见南山”物我两忘，“此中有真意，欲辨已忘言”化悟为言有尽意无穷之直觉。",
    "start": 79.744,
    "end": 91.516,
    "duration": 11.772
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 儒道兼融、树立固穷守节士格",
    "start": 92.023,
    "end": 95.555,
    "duration": 3.532
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "融儒家“安贫乐道、独善其身”与道家顺应自然旷达于一体，践行“不为五斗米折腰向乡里小儿”；",
    "start": 96.045,
    "end": 104.937,
    "duration": 8.892
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《桃花源记》构想“不知有汉，无论魏晋”、自食其力的和平村落，寄托理想秩序向往。",
    "start": 105.44,
    "end": 113.132,
    "duration": 7.692
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 构筑唐宋士大夫精神家园",
    "start": 113.793,
    "end": 116.845,
    "duration": 3.052
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "经萧统推崇及宋代苏轼、朱熹发扬，地位日益崇高；",
    "start": 117.312,
    "end": 123.084,
    "duration": 5.772
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "盛唐王维、孟浩然与中唐韦应物、柳宗元推高山水田园诗；",
    "start": 123.609,
    "end": 130.181,
    "duration": 6.572
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "苏轼晚年作大量“和陶诗”，借其平淡旷达抚慰创伤，成为后世守节归宿。",
    "start": 130.539,
    "end": 138.391,
    "duration": 7.852
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "陶渊明以质朴白描与儒道兼融节操开辟诗意栖居新境，",
    "start": 139.088,
    "end": 144.94,
    "duration": 5.852
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "其“质而实绮，癯而实腴”艺术追求与守节典范启迪盛唐王孟并长久安顿后代士大夫心灵。",
    "start": 145.328,
    "end": 155.26,
    "duration": 9.932
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：苏轼在《与苏辙书》赞陶诗“质而实绮，癯而实腴”；",
    "start": 155.968,
    "end": 161.26,
    "duration": 5.292
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "注意区分陶渊明（偏重亲身躬耕与归隐田园）与谢灵运（山水游览模山范水）。",
    "start": 161.778,
    "end": 169.23,
    "duration": 7.452
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 苏轼《与苏辙书》评陶诗哪八个字？",
    "start": 169.863,
    "end": 174.915,
    "duration": 5.052
  },
  {
    "id": "drill0_c1",
    "dom_key": "drill0_c1",
    "text": "怎么印证在《归园田居》与《饮酒》中？",
    "start": 175.273,
    "end": 177.605,
    "duration": 2.332
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 陶渊明如何融汇儒家操守与道家顺应自然？",
    "start": 178.075,
    "end": 183.047,
    "duration": 4.972
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 列出萧统、唐代山水田园四家与苏轼对陶渊明的接受史？",
    "start": 183.425,
    "end": 189.757,
    "duration": 6.332
  }
]