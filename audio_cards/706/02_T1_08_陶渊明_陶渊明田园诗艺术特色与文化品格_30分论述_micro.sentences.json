[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "陶渊明·田园诗艺术特色与文化品格",
    "start": 0.134,
    "end": 3.57,
    "duration": 3.437
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "写什么→怎么写→何等人→遗泽谁：先开创亲身躬耕的“田园题材”，",
    "start": 4.16,
    "end": 10.851,
    "duration": 6.692
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "为适配这种生活自然洗净雕饰写成“平淡自然”白描语言，",
    "start": 11.178,
    "end": 15.968,
    "duration": 4.791
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "背后支撑这一选择的是儒道兼融、不为五斗米折腰的人格风骨，",
    "start": 16.256,
    "end": 21.433,
    "duration": 5.177
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最终成为王孟苏轼安身立命的精神家园。",
    "start": 21.629,
    "end": 24.988,
    "duration": 3.358
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "陶渊明是古典田园诗开创者，辞官归隐后突破玄言说理与雕琢风气，首将亲身农耕引入诗歌。",
    "start": 25.575,
    "end": 34.584,
    "duration": 9.009
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "苏轼《与苏辙书》赞其“质而实绮，癯而实腴”。",
    "start": 35.171,
    "end": 38.933,
    "duration": 3.762
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 开创田园题材、躬耕融于诗意",
    "start": 39.52,
    "end": 42.943,
    "duration": 3.423
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "非只赏景，而是以士大夫身份亲身躬耕，将耕作甘苦升华为精神选择；",
    "start": 43.53,
    "end": 50.522,
    "duration": 6.991
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《归园田居·其一》绘“方宅十余亩，草屋八九间”村居；",
    "start": 51.108,
    "end": 56.563,
    "duration": 5.455
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《其三》写“晨兴理荒秽，带月荷锄归”与“衣沾不足惜，但使愿无违”。",
    "start": 56.903,
    "end": 62.995,
    "duration": 6.093
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 追求“平淡自然”、淡中见警策",
    "start": 63.569,
    "end": 66.993,
    "duration": 3.423
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "摆脱玄言抽象说理与晋宋偶对雕饰，取家常口语白描，朴素中见绮丽；",
    "start": 67.58,
    "end": 74.428,
    "duration": 6.848
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《饮酒·其五》“采菊东篱下，悠然见南山”物我两忘，“此中有真意，欲辨已忘言”化悟为言有尽意无穷之直觉。",
    "start": 74.989,
    "end": 84.675,
    "duration": 9.686
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 儒道兼融、树立固穷守节士格",
    "start": 85.249,
    "end": 88.92,
    "duration": 3.671
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "融儒家“安贫乐道、独善其身”与道家顺应自然旷达于一体，践行“不为五斗米折腰向乡里小儿”；",
    "start": 89.507,
    "end": 98.347,
    "duration": 8.84
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《桃花源记》构想“不知有汉，无论魏晋”、自食其力的和平村落，寄托理想秩序向往。",
    "start": 98.921,
    "end": 106.264,
    "duration": 7.343
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 构筑唐宋士大夫精神家园",
    "start": 106.838,
    "end": 110.053,
    "duration": 3.215
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "经萧统推崇及宋代苏轼、朱熹发扬，地位日益崇高；",
    "start": 110.64,
    "end": 116.199,
    "duration": 5.559
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "盛唐王维、孟浩然与中唐韦应物、柳宗元推高山水田园诗；",
    "start": 116.786,
    "end": 122.67,
    "duration": 5.884
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "苏轼晚年作大量“和陶诗”，借其平淡旷达抚慰创伤，成为后世守节归宿。",
    "start": 122.97,
    "end": 129.415,
    "duration": 6.444
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "陶渊明以质朴白描与儒道兼融节操开辟诗意栖居新境，",
    "start": 129.989,
    "end": 135.066,
    "duration": 5.077
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "其“质而实绮，癯而实腴”艺术追求与守节典范启迪盛唐王孟并长久安顿后代士大夫心灵。",
    "start": 135.353,
    "end": 143.269,
    "duration": 7.916
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：苏轼在《与苏辙书》赞陶诗“质而实绮，癯而实腴”；",
    "start": 143.843,
    "end": 148.907,
    "duration": 5.064
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "注意区分陶渊明（偏重亲身躬耕与归隐田园）与谢灵运（山水游览模山范水）。",
    "start": 149.194,
    "end": 156.12,
    "duration": 6.926
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 苏轼《与苏辙书》评陶诗哪八个字？",
    "start": 156.694,
    "end": 161.042,
    "duration": 4.348
  },
  {
    "id": "drill0_c1",
    "dom_key": "drill0_c1",
    "text": "怎么印证在《归园田居》与《饮酒》中？",
    "start": 161.616,
    "end": 164.402,
    "duration": 2.785
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 陶渊明如何融汇儒家操守与道家顺应自然？",
    "start": 164.976,
    "end": 170.287,
    "duration": 5.311
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 列出萧统、唐代山水田园四家与苏轼对陶渊明的接受史？",
    "start": 170.874,
    "end": 177.709,
    "duration": 6.835
  }
]