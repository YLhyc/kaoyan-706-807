[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "感官画境→心法禅境→体式音律→宗派传承：",
    "start": 0.0,
    "end": 4.56,
    "duration": 4.56
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先看他如何凭画家之眼在声光动静中写活“诗中有画”，",
    "start": 4.609,
    "end": 8.809,
    "duration": 4.2
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再揭开佛法静观如何将山水跃入“无我”禅境，",
    "start": 9.259,
    "end": 12.819,
    "duration": 3.56
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "继而辨明其非唯独孤寂亦工边塞雄浑与五言圆转，",
    "start": 13.269,
    "end": 18.069,
    "duration": 4.8
  },
  {
    "id": "hook_c4",
    "dom_key": "hook_c4",
    "text": "最后上承张九龄谢灵运、下启王士祯“神韵说”。",
    "start": 18.519,
    "end": 22.279,
    "duration": 3.76
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "王维是盛唐山水田园诗派最著大家，",
    "start": 22.889,
    "end": 25.929,
    "duration": 3.04
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "晚隐辋川将画理、音律与大乘禅理融入山水观照，",
    "start": 26.379,
    "end": 30.499,
    "duration": 4.12
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "创造静逸明秀、兴象玲珑之纯美诗境。",
    "start": 30.949,
    "end": 34.389,
    "duration": 3.44
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 融画法音律写景、“诗中有画”空间感",
    "start": 34.839,
    "end": 38.759,
    "duration": 3.92
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "苏轼评“诗中有画，画中有诗”，敏锐捕捉动态光影色彩与空间层次；",
    "start": 39.209,
    "end": 44.609,
    "duration": 5.4
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《山居秋暝》“明月松间照，清泉石上流”静画动音相衬；",
    "start": 45.059,
    "end": 49.459,
    "duration": 4.4
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《过香积寺》“日色冷青松”与《山中》“空翠湿人衣”妙用条件色生“冷”“湿”之感。",
    "start": 49.909,
    "end": 55.589,
    "duration": 5.68
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 禅宗空观观照、呈现“无我”禅境",
    "start": 56.039,
    "end": 59.679,
    "duration": 3.64
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "以澄心体会“无生”，令山水诗由六朝玄言理路跃入直观审美观照；",
    "start": 60.129,
    "end": 65.489,
    "duration": 5.36
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《终南别业》“行到水穷处，坐看云起时”无心冥合；",
    "start": 65.939,
    "end": 69.819,
    "duration": 3.88
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "《鹿柴》人语夕照、《辛夷坞》“纷纷开且落”借微响生机反衬永恒空静。",
    "start": 70.269,
    "end": 75.509,
    "duration": 5.24
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 兼善古近诸体、从壮大到冲淡神韵",
    "start": 76.039,
    "end": 80.359,
    "duration": 4.32
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "五律五绝尤绝：早年出塞《使至塞上》“大漠孤烟直，",
    "start": 80.809,
    "end": 84.569,
    "duration": 3.76
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "长河落日圆”线条雄浑；",
    "start": 85.019,
    "end": 87.179,
    "duration": 2.16
  },
  {
    "id": "sec2_step0_c2",
    "dom_key": "sec2_step0_c2",
    "text": "晚年《辋川集》与五律不尚险怪；",
    "start": 87.629,
    "end": 90.109,
    "duration": 2.48
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "用“竹喧”“莲动”“青苔”清浅意象配圆转音律，免大历佳句局促之弊，",
    "start": 90.559,
    "end": 95.919,
    "duration": 5.36
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "成冲淡神韵。",
    "start": 96.369,
    "end": 97.649,
    "duration": 1.28
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 汇通清澹源流、垂范后世意境审美",
    "start": 98.179,
    "end": 102.059,
    "duration": 3.88
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "承二谢写景及张九龄“清澹”之源，胡应麟《诗薮》评“本曲江之清澹，",
    "start": 102.509,
    "end": 107.909,
    "duration": 5.4
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "而益以风神”，与孟浩然共立山水田园宗主；",
    "start": 108.359,
    "end": 111.959,
    "duration": 3.6
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "滋养大历诗人、韦柳、宋代山水画论及清代王士祯“神韵说”。",
    "start": 112.409,
    "end": 117.289,
    "duration": 4.88
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "王维融画理构图、音律与禅宗空观营造“诗中有画，",
    "start": 117.899,
    "end": 121.939,
    "duration": 4.04
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "画中有诗”及物我冥合空灵境，汇通清澹源流，",
    "start": 122.389,
    "end": 126.429,
    "duration": 4.04
  },
  {
    "id": "concl_c2",
    "dom_key": "concl_c2",
    "text": "从大历诗人、韦柳直至清代王士祯“神韵说”留长久回响。",
    "start": 126.879,
    "end": 131.479,
    "duration": 4.6
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：苏轼评王维“诗中有画，画中有诗”；",
    "start": 132.009,
    "end": 135.569,
    "duration": 3.56
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "胡应麟评“本曲江之清澹，而益以风神”；",
    "start": 136.019,
    "end": 139.339,
    "duration": 3.32
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "清代王士祯“神韵说”即远宗王维。",
    "start": 139.789,
    "end": 142.469,
    "duration": 2.68
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 结合苏轼评语与三首诗句，分析王维捕捉光线声音的“画意”技巧？",
    "start": 142.919,
    "end": 149.119,
    "duration": 6.2
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《终南别业》《鹿柴》《辛夷坞》讲透什么是“无我”禅境？",
    "start": 149.569,
    "end": 154.889,
    "duration": 5.32
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 梳理“二谢、张九龄→王孟→韦柳、大历、王士祯神韵说”的诗歌意境传承链？",
    "start": 155.339,
    "end": 162.899,
    "duration": 7.56
  }
]