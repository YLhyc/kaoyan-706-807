[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "古文运动·唐代古文运动发生机制理论主张与韩柳散文艺术",
    "start": 0.154,
    "end": 5.366,
    "duration": 5.212
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "背景→理论→文体→双家实绩：先剖析为何中唐危局呼唤“假复古行革新”，",
    "start": 5.823,
    "end": 13.515,
    "duration": 7.692
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再系统梳理“文以明道/气盛言宜/不平则鸣”纲领，",
    "start": 13.743,
    "end": 17.595,
    "duration": 3.852
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "继而讲透散体如何在不排斥骈语精华下打破声病束缚，",
    "start": 17.903,
    "end": 22.715,
    "duration": 4.812
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后落到韩愈雄健与柳宗元峭拔、启蒙北宋革新。",
    "start": 23.023,
    "end": 27.195,
    "duration": 4.172
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "唐代古文运动是由韩愈、柳宗元领导的中唐散文革新运动，",
    "start": 27.723,
    "end": 32.615,
    "duration": 4.892
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "旨在恢复先秦两汉散文传统以破六朝骈俪浮靡，苏轼赞韩愈“文起八代之衰，道济天下之溺”。",
    "start": 33.163,
    "end": 42.455,
    "duration": 9.292
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 立足中唐危局与“假复古行革新”机制",
    "start": 43.133,
    "end": 47.065,
    "duration": 3.932
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "安史乱后藩镇割据、佛老削弱儒家伦理财税；声律对偶、浮靡的六朝骈体文难载严肃经世之道；",
    "start": 47.593,
    "end": 59.095,
    "duration": 11.502
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "韩柳效法先秦两汉散体，假复古之名行革新之实，以儒学复兴统摄文风变革。",
    "start": 59.623,
    "end": 68.115,
    "duration": 8.492
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 提出“文以明道”“气盛言宜”理论纲领",
    "start": 68.786,
    "end": 72.558,
    "duration": 3.772
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "韩倡导“文以明道”，柳主张“辅时及物”；方法上倡导“唯陈言之务去”、“师其意不师其辞”；",
    "start": 73.028,
    "end": 83.09,
    "duration": 10.062
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "提出“气盛则言之短长与声之高下者皆宜”，以“大凡物不得其平则鸣”揭示抒愤动因。",
    "start": 83.618,
    "end": 92.27,
    "duration": 8.652
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 革除骈靡、以单行散体拓表现空间",
    "start": 92.919,
    "end": 97.091,
    "duration": 4.172
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "打破排比对偶与声病音律长期束缚，倡导单行散体，句式长短错落、随情意自由舒卷；",
    "start": 97.619,
    "end": 105.471,
    "duration": 7.852
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "不盲排骈文，融合先秦两汉文言、六朝骈语精华与鲜活时语，力求“文从字顺”兼自铸新词，恢复叙史论辩描景之功。",
    "start": 105.999,
    "end": 118.331,
    "duration": 12.332
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 韩柳各擅胜场、奠定唐宋古文格局",
    "start": 118.968,
    "end": 123.14,
    "duration": 4.172
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "气势雄健、汪洋恣肆：《师说》批判耻师陋习，《马说》抒写人才埋没悲愤；",
    "start": 123.668,
    "end": 131.12,
    "duration": 7.452
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "峭拔清峻、笔锋犀利：《捕蛇者说》揭赋敛酷毒，《永州八记》融身世悲凉于自然清幽；",
    "start": 131.615,
    "end": 139.867,
    "duration": 8.252
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "二人同奠北宋欧苏诗文革新根基。",
    "start": 140.225,
    "end": 143.357,
    "duration": 3.132
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "唐代古文运动以复兴儒学与“文以明道”“气盛言宜”打破骈体束缚，",
    "start": 144.06,
    "end": 150.712,
    "duration": 6.652
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "韩愈雄奇与柳宗元清幽相得益彰，使散体回归正宗并先声启迪北宋欧苏诗文革新。",
    "start": 151.02,
    "end": 157.992,
    "duration": 6.972
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：苏轼赞韩愈“文起八代之衰，道济天下之溺”；",
    "start": 158.675,
    "end": 163.647,
    "duration": 4.972
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "韩愈核心主张“文以明道”“气盛言宜”“唯陈言之务去”“不平则鸣”，柳宗元核心主张“辅时及物”。",
    "start": 163.925,
    "end": 172.577,
    "duration": 8.652
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 概括中唐古文运动“以复古为革新”的社会与文体双重原因？",
    "start": 173.025,
    "end": 179.277,
    "duration": 6.252
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 完整背出韩柳散文四大理论核心及原句出处？",
    "start": 179.805,
    "end": 185.017,
    "duration": 5.212
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 结合《师说》《捕蛇者说》《永州八记》比较韩愈与柳宗元散文之别？",
    "start": 185.352,
    "end": 191.524,
    "duration": 6.172
  }
]