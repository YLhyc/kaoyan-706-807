[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "背景→理论→文体→双家实绩：先剖析为何中唐危局呼唤“假复古行革新”，",
    "start": 0.0,
    "end": 7.72,
    "duration": 7.72
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再系统梳理“文以明道/气盛言宜/不平则鸣”纲领，",
    "start": 7.769,
    "end": 11.609,
    "duration": 3.84
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "继而讲透散体如何在不排斥骈语精华下打破声病束缚，",
    "start": 12.059,
    "end": 16.419,
    "duration": 4.36
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后落到韩愈雄健与柳宗元峭拔、启蒙北宋革新。",
    "start": 16.869,
    "end": 21.149,
    "duration": 4.28
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "唐代古文运动是由韩愈、柳宗元领导的中唐散文革新运动，",
    "start": 21.599,
    "end": 26.359,
    "duration": 4.76
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "旨在恢复先秦两汉散文传统以破六朝骈俪浮靡，苏轼赞韩愈“文起八代之衰，",
    "start": 26.809,
    "end": 33.329,
    "duration": 6.52
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "道济天下之溺”。",
    "start": 33.779,
    "end": 35.139,
    "duration": 1.36
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 立足中唐危局与“假复古行革新”机制",
    "start": 35.589,
    "end": 39.509,
    "duration": 3.92
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "安史乱后藩镇割据、佛老削弱儒家伦理财税；",
    "start": 39.959,
    "end": 43.879,
    "duration": 3.92
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "声律对偶、浮靡的六朝骈体文难载严肃经世之道；",
    "start": 44.329,
    "end": 48.809,
    "duration": 4.48
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "韩柳效法先秦两汉散体，假复古之名行革新之实，以儒学复兴统摄文风变革。",
    "start": 49.339,
    "end": 56.259,
    "duration": 6.92
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 提出“文以明道”“气盛言宜”理论纲领",
    "start": 56.709,
    "end": 60.349,
    "duration": 3.64
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "韩倡导“文以明道”，柳主张“辅时及物”；",
    "start": 60.799,
    "end": 64.039,
    "duration": 3.24
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "方法上倡导“唯陈言之务去”、“师其意不师其辞”；",
    "start": 64.489,
    "end": 68.089,
    "duration": 3.6
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "提出“气盛则言之短长与声之高下者皆宜”，",
    "start": 68.619,
    "end": 72.179,
    "duration": 3.56
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "以“大凡物不得其平则鸣”揭示抒愤动因。",
    "start": 72.629,
    "end": 75.949,
    "duration": 3.32
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 革除骈靡、以单行散体拓表现空间",
    "start": 76.399,
    "end": 80.319,
    "duration": 3.92
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "打破排比对偶与声病音律长期束缚，倡导单行散体，",
    "start": 80.769,
    "end": 85.049,
    "duration": 4.28
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "句式长短错落、随情意自由舒卷；",
    "start": 85.579,
    "end": 88.379,
    "duration": 2.8
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "不盲排骈文，融合先秦两汉文言、六朝骈语精华与鲜活时语，",
    "start": 88.909,
    "end": 94.029,
    "duration": 5.12
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "力求“文从字顺”兼自铸新词，恢复叙史论辩描景之功。",
    "start": 94.559,
    "end": 99.159,
    "duration": 4.6
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 韩柳各擅胜场、奠定唐宋古文格局",
    "start": 99.609,
    "end": 103.489,
    "duration": 3.88
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "气势雄健、汪洋恣肆：《师说》批判耻师陋习，《马说》抒写人才埋没悲愤；",
    "start": 103.939,
    "end": 109.699,
    "duration": 5.76
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "峭拔清峻、笔锋犀利：《捕蛇者说》揭赋敛酷毒，",
    "start": 110.229,
    "end": 113.989,
    "duration": 3.76
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "《永州八记》融身世悲凉于自然清幽；",
    "start": 114.439,
    "end": 117.239,
    "duration": 2.8
  },
  {
    "id": "sec3_step1_c2",
    "dom_key": "sec3_step1_c2",
    "text": "二人同奠北宋欧苏诗文革新根基。",
    "start": 117.809,
    "end": 120.809,
    "duration": 3.0
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "唐代古文运动以复兴儒学与“文以明道”“气盛言宜”打破骈体束缚，",
    "start": 121.259,
    "end": 126.579,
    "duration": 5.32
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "韩愈雄奇与柳宗元清幽相得益彰，",
    "start": 127.029,
    "end": 129.949,
    "duration": 2.92
  },
  {
    "id": "concl_c2",
    "dom_key": "concl_c2",
    "text": "使散体回归正宗并先声启迪北宋欧苏诗文革新。",
    "start": 130.399,
    "end": 134.559,
    "duration": 4.16
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：苏轼赞韩愈“文起八代之衰，道济天下之溺”；",
    "start": 135.009,
    "end": 139.369,
    "duration": 4.36
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "韩愈核心主张“文以明道”“气盛言宜”“唯陈言之务去”“不平则鸣”，",
    "start": 139.819,
    "end": 144.539,
    "duration": 4.72
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "柳宗元核心主张“辅时及物”。",
    "start": 145.069,
    "end": 147.309,
    "duration": 2.24
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 概括中唐古文运动“以复古为革新”的社会与文体双重原因？",
    "start": 147.759,
    "end": 153.879,
    "duration": 6.12
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 完整背出韩柳散文四大理论核心及原句出处？",
    "start": 154.329,
    "end": 159.689,
    "duration": 5.36
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 结合《师说》《捕蛇者说》《永州八记》比较韩愈与柳宗元散文之别？",
    "start": 160.139,
    "end": 166.659,
    "duration": 6.52
  }
]