[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "古文运动·唐代古文运动发生机制理论主张与韩柳散文艺术",
    "start": 0.274,
    "end": 5.406,
    "duration": 5.132
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "背景→理论→文体→双家实绩：先剖析为何中唐危局呼唤“假复古行革新”，",
    "start": 6.414,
    "end": 14.026,
    "duration": 7.612
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再系统梳理“文以明道/气盛言宜/不平则鸣”纲领，",
    "start": 14.254,
    "end": 18.106,
    "duration": 3.852
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "继而讲透散体如何在不排斥骈语精华下打破声病束缚，",
    "start": 18.254,
    "end": 23.586,
    "duration": 5.332
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后落到韩愈雄健与柳宗元峭拔、启蒙北宋革新。",
    "start": 23.694,
    "end": 27.986,
    "duration": 4.292
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "唐代古文运动是由韩愈、柳宗元领导的中唐散文革新运动，",
    "start": 28.914,
    "end": 33.686,
    "duration": 4.772
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "旨在恢复先秦两汉散文传统以破六朝骈俪浮靡，苏轼赞韩愈“文起八代之衰，道济天下之溺”。",
    "start": 33.834,
    "end": 42.566,
    "duration": 8.732
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 立足中唐危局与“假复古行革新”机制",
    "start": 43.614,
    "end": 47.586,
    "duration": 3.972
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "安史乱后藩镇割据、佛老削弱儒家伦理财税；声律对偶、浮靡的六朝骈体文难载严肃经世之道；",
    "start": 48.634,
    "end": 61.866,
    "duration": 13.232
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "韩柳效法先秦两汉散体，假复古之名行革新之实，以儒学复兴统摄文风变革。",
    "start": 62.794,
    "end": 71.086,
    "duration": 8.292
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 提出“文以明道”“气盛言宜”理论纲领",
    "start": 72.094,
    "end": 75.786,
    "duration": 3.692
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "韩倡导“文以明道”，柳主张“辅时及物”；方法上倡导“唯陈言之务去”、“师其意不师其辞”；",
    "start": 76.794,
    "end": 86.786,
    "duration": 9.992
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "提出“气盛则言之短长与声之高下者皆宜”，以“大凡物不得其平则鸣”揭示抒愤动因。",
    "start": 87.794,
    "end": 97.326,
    "duration": 9.532
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 革除骈靡、以单行散体拓表现空间",
    "start": 98.028,
    "end": 102.32,
    "duration": 4.292
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "打破排比对偶与声病音律长期束缚，倡导单行散体，句式长短错落、随情意自由舒卷；",
    "start": 103.108,
    "end": 111.64,
    "duration": 8.532
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "不盲排骈文，融合先秦两汉文言、六朝骈语精华与鲜活时语，力求“文从字顺”兼自铸新词，恢复叙史论辩描景之功。",
    "start": 112.608,
    "end": 124.86,
    "duration": 12.252
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 韩柳各擅胜场、奠定唐宋古文格局",
    "start": 125.868,
    "end": 129.64,
    "duration": 3.772
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "气势雄健、汪洋恣肆：《师说》批判耻师陋习，《马说》抒写人才埋没悲愤；",
    "start": 130.648,
    "end": 138.06,
    "duration": 7.412
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "峭拔清峻、笔锋犀利：《捕蛇者说》揭赋敛酷毒，《永州八记》融身世悲凉于自然清幽；",
    "start": 139.028,
    "end": 146.76,
    "duration": 7.732
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "二人同奠北宋欧苏诗文革新根基。",
    "start": 147.768,
    "end": 151.06,
    "duration": 3.292
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "唐代古文运动以复兴儒学与“文以明道”“气盛言宜”打破骈体束缚，",
    "start": 152.028,
    "end": 158.92,
    "duration": 6.892
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "韩愈雄奇与柳宗元清幽相得益彰，使散体回归正宗并先声启迪北宋欧苏诗文革新。",
    "start": 159.148,
    "end": 166.96,
    "duration": 7.812
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：苏轼赞韩愈“文起八代之衰，道济天下之溺”；",
    "start": 168.008,
    "end": 173.02,
    "duration": 5.012
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "韩愈核心主张“文以明道”“气盛言宜”“唯陈言之务去”“不平则鸣”，柳宗元核心主张“辅时及物”。",
    "start": 174.068,
    "end": 182.6,
    "duration": 8.532
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 概括中唐古文运动“以复古为革新”的社会与文体双重原因？",
    "start": 183.528,
    "end": 190.42,
    "duration": 6.892
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 完整背出韩柳散文四大理论核心及原句出处？",
    "start": 191.428,
    "end": 196.64,
    "duration": 5.212
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 结合《师说》《捕蛇者说》《永州八记》比较韩愈与柳宗元散文之别？",
    "start": 197.168,
    "end": 204.3,
    "duration": 7.132
  }
]