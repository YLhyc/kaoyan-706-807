[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "源流→回目与回末装置→语言结构演进：",
    "start": 0.0,
    "end": 4.2,
    "duration": 4.2
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先从宋元瓦舍讲史追溯至《三国》《水浒》《金瓶梅》《红楼梦》四代演进，",
    "start": 4.249,
    "end": 9.969,
    "duration": 5.72
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再重点拆解“分回标目4步定型 + 欲知后事如何设悬”，",
    "start": 10.419,
    "end": 14.539,
    "duration": 4.12
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后落到说话人口吻、韵散结合与结构升级。",
    "start": 14.989,
    "end": 18.749,
    "duration": 3.76
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "章回小说是中国古代长篇小说主要体制，孕育于宋元讲史等说话伎艺，",
    "start": 19.199,
    "end": 24.839,
    "duration": 5.64
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "在明代趋于定型并走向繁荣。",
    "start": 25.369,
    "end": 27.929,
    "duration": 2.56
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 脱胎宋元说话讲史、由集体向独创演进",
    "start": 28.379,
    "end": 32.619,
    "duration": 4.24
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "源于宋元瓦舍“说话”特别是“讲史”话本，",
    "start": 33.069,
    "end": 35.869,
    "duration": 2.8
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "艺人分节讲说演化出分回标目与回末设悬；",
    "start": 36.319,
    "end": 39.719,
    "duration": 3.4
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "元末明初文人加工写定《三国志通俗演义》《水浒传》确立；",
    "start": 40.249,
    "end": 44.529,
    "duration": 4.28
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《金瓶梅》开启文人独创世情；",
    "start": 44.979,
    "end": 47.299,
    "duration": 2.32
  },
  {
    "id": "sec0_step1_c2",
    "dom_key": "sec0_step1_c2",
    "text": "至《儒林外史》《红楼梦》达成熟高峰。",
    "start": 47.749,
    "end": 50.269,
    "duration": 2.52
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 确立分回标目与回末设悬叙事体制",
    "start": 50.799,
    "end": 54.599,
    "duration": 3.8
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "由宋元平话长短参差→嘉靖本《三国》单句七字目→万历本《水浒》双句大致对偶→崇祯本《金瓶梅》双句工整对偶；",
    "start": 55.049,
    "end": 63.489,
    "duration": 8.44
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "每回首尾勾连，紧要处以“欲知后事如何，且听下回分解”煞尾，",
    "start": 64.019,
    "end": 69.259,
    "duration": 5.24
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "维系期待、串接长篇。",
    "start": 69.709,
    "end": 71.589,
    "duration": 1.88
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 说话人口吻、韵散结合与结构演进",
    "start": 72.039,
    "end": 75.839,
    "duration": 3.8
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "保留“话说”“且说”说话人口吻；",
    "start": 76.289,
    "end": 78.489,
    "duration": 2.2
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "行文韵散结合（插诗词评赞场景），融白话口语与雅化笔法；",
    "start": 78.939,
    "end": 84.299,
    "duration": 5.36
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "由《三国》《水浒》线性串联演进为《红楼梦》网状交叉布局，",
    "start": 84.749,
    "end": 88.869,
    "duration": 4.12
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "显示叙事艺术持续深化。",
    "start": 89.319,
    "end": 91.479,
    "duration": 2.16
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：记住回目定型三步：",
    "start": 91.929,
    "end": 93.969,
    "duration": 2.04
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "宋元平话长短不一 → 嘉靖本《三国》单句七字目 → 万历本《水浒》双句大致对偶 → 崇祯本《金瓶梅》双句工整对偶。",
    "start": 94.419,
    "end": 103.379,
    "duration": 8.96
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 说出章回小说从“讲史话本”到《红楼梦》的四代演进代表作品？",
    "start": 103.909,
    "end": 110.149,
    "duration": 6.24
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 默背回目对偶定型的三个关键版本里程碑？",
    "start": 110.599,
    "end": 115.119,
    "duration": 4.52
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 概括章回小说在“发端语、韵散夹杂、回末设悬、结构趋势”上的文体特征？",
    "start": 115.569,
    "end": 122.929,
    "duration": 7.36
  }
]