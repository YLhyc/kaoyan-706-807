[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "章回小说·中国古代章回小说产生演进与文体特征",
    "start": 0.134,
    "end": 4.847,
    "duration": 4.713
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "源流→回目与回末装置→语言结构演进：先从宋元瓦舍讲史追溯至《三国》《水浒》《金瓶梅》《红楼梦》四代演进，",
    "start": 5.423,
    "end": 17.049,
    "duration": 11.627
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再重点拆解“分回标目4步定型 + 欲知后事如何设悬”，",
    "start": 17.219,
    "end": 22.14,
    "duration": 4.921
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后落到说话人口吻、韵散结合与结构升级。",
    "start": 22.241,
    "end": 26.277,
    "duration": 4.035
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "章回小说是中国古代长篇小说主要体制，孕育于宋元讲史等说话伎艺，在明代趋于定型并走向繁荣。",
    "start": 26.864,
    "end": 35.691,
    "duration": 8.827
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 脱胎宋元说话讲史、由集体向独创演进",
    "start": 36.265,
    "end": 40.587,
    "duration": 4.322
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "源于宋元瓦舍“说话”特别是“讲史”话本，艺人分节讲说演化出分回标目与回末设悬；",
    "start": 41.174,
    "end": 48.907,
    "duration": 7.733
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "元末明初文人加工写定《三国志通俗演义》《水浒传》确立；《金瓶梅》开启文人独创世情；",
    "start": 49.494,
    "end": 58.1,
    "duration": 8.606
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "至《儒林外史》《红楼梦》达成熟高峰。",
    "start": 58.387,
    "end": 61.732,
    "duration": 3.345
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 确立分回标目与回末设悬叙事体制",
    "start": 62.306,
    "end": 66.16,
    "duration": 3.853
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "由宋元平话长短参差→嘉靖本《三国》单句七字目→万历本《水浒》双句大致对偶→崇祯本《金瓶梅》双句工整对偶；",
    "start": 66.746,
    "end": 78.308,
    "duration": 11.561
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "每回首尾勾连，紧要处以“欲知后事如何，且听下回分解”煞尾，维系期待、串接长篇。",
    "start": 78.869,
    "end": 87.383,
    "duration": 8.515
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 说话人口吻、韵散结合与结构演进",
    "start": 87.97,
    "end": 92.11,
    "duration": 4.14
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "保留“话说”“且说”说话人口吻；行文韵散结合（插诗词评赞场景），融白话口语与雅化笔法；",
    "start": 92.697,
    "end": 102.136,
    "duration": 9.439
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "由《三国》《水浒》线性串联演进为《红楼梦》网状交叉布局，显示叙事艺术持续深化。",
    "start": 102.723,
    "end": 110.912,
    "duration": 8.189
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：记住回目定型三步：宋元平话长短不一 → 嘉靖本《三国》单句七字目 → 万历本《水浒》双句大致对偶 → 崇祯本《金瓶梅》双句工整对偶。",
    "start": 111.499,
    "end": 124.441,
    "duration": 12.942
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 说出章回小说从“讲史话本”到《红楼梦》的四代演进代表作品？",
    "start": 125.002,
    "end": 131.329,
    "duration": 6.327
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 默背回目对偶定型的三个关键版本里程碑？",
    "start": 131.916,
    "end": 136.693,
    "duration": 4.778
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 概括章回小说在“发端语、韵散夹杂、回末设悬、结构趋势”上的文体特征？",
    "start": 137.28,
    "end": 145.404,
    "duration": 8.124
  }
]