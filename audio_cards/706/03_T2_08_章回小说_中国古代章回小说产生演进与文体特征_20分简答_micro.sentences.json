[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "源流→回目与回末装置→语言结构演进：先从宋元瓦舍讲史追溯至《三国》《水浒》《金瓶梅》《红楼梦》四代演进，",
    "start": 0.237,
    "end": 11.09,
    "duration": 10.854
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再重点拆解“分回标目4步定型 + 欲知后事如何设悬”，",
    "start": 11.828,
    "end": 16.153,
    "duration": 4.326
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后落到说话人口吻、韵散结合与结构升级。",
    "start": 16.953,
    "end": 21.038,
    "duration": 4.085
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "章回小说是中国古代长篇小说主要体制，孕育于宋元讲史等说话伎艺，在明代趋于定型并走向繁荣。",
    "start": 21.761,
    "end": 30.299,
    "duration": 8.537
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 脱胎宋元说话讲史、由集体向独创演进",
    "start": 31.132,
    "end": 35.35,
    "duration": 4.218
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "源于宋元瓦舍“说话”特别是“讲史”话本，艺人分节讲说演化出分回标目与回末设悬；",
    "start": 36.097,
    "end": 42.941,
    "duration": 6.844
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "元末明初文人加工写定《三国志通俗演义》《水浒传》确立；",
    "start": 43.769,
    "end": 48.437,
    "duration": 4.669
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《金瓶梅》开启文人独创世情；",
    "start": 49.186,
    "end": 51.625,
    "duration": 2.439
  },
  {
    "id": "sec0_step1_c2",
    "dom_key": "sec0_step1_c2",
    "text": "至《儒林外史》《红楼梦》达成熟高峰。",
    "start": 52.364,
    "end": 55.189,
    "duration": 2.825
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 确立分回标目与回末设悬叙事体制",
    "start": 55.915,
    "end": 59.659,
    "duration": 3.744
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "由宋元平话长短参差→嘉靖本《三国》单句七字目→万历本《水浒》双句大致对偶",
    "start": 60.399,
    "end": 67.161,
    "duration": 6.762
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "→崇祯本《金瓶梅》双句工整对偶；",
    "start": 67.986,
    "end": 70.347,
    "duration": 2.361
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "每回首尾勾连，紧要处以“欲知后事如何，且听下回分解”煞尾，维系期待、串接长篇。",
    "start": 71.102,
    "end": 78.524,
    "duration": 7.423
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 说话人口吻、韵散结合与结构演进",
    "start": 79.283,
    "end": 83.269,
    "duration": 3.986
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "保留“话说”“且说”说话人口吻；行文韵散结合（插诗词评赞场景），融白话口语与雅化笔法；",
    "start": 84.036,
    "end": 91.987,
    "duration": 7.95
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "由《三国》《水浒》线性串联演进为《红楼梦》网状交叉布局，显示叙事艺术持续深化。",
    "start": 92.779,
    "end": 100.01,
    "duration": 7.231
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：记住回目定型三步：宋元平话长短不一 → 嘉靖本《三国》单句七字目 ",
    "start": 100.843,
    "end": 107.389,
    "duration": 6.546
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "→ 万历本《水浒》双句大致对偶 → 崇祯本《金瓶梅》双句工整对偶。",
    "start": 108.208,
    "end": 112.93,
    "duration": 4.722
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 说出章回小说从“讲史话本”到《红楼梦》的四代演进代表作品？",
    "start": 113.703,
    "end": 119.704,
    "duration": 6.001
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 默背回目对偶定型的三个关键版本里程碑？",
    "start": 120.446,
    "end": 125.104,
    "duration": 4.658
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 概括章回小说在“发端语、韵散夹杂、回末设悬、结构趋势”上的文体特征？",
    "start": 125.835,
    "end": 133.872,
    "duration": 8.037
  }
]