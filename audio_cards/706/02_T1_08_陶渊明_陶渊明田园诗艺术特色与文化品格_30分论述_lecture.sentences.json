[
  {
    "id": 1,
    "text": "试论陶渊明田园诗的艺术特色与文化品格。",
    "start": 0.101,
    "end": 4.02,
    "duration": 3.919
  },
  {
    "id": 2,
    "text": "陶渊明是中国古典田园诗派的开创者，也是魏晋风流与士人人格独立的杰出代表。",
    "start": 4.479,
    "end": 11.035,
    "duration": 6.556
  },
  {
    "id": 3,
    "text": "身处东晋刘宋易代之际的政治动荡与门阀专权现实之中，陶渊明辞官归隐，",
    "start": 11.434,
    "end": 17.543,
    "duration": 6.109
  },
  {
    "id": 4,
    "text": "突破了东晋玄言诗枯燥说理与晋宋诗坛偏重雕琢的藩篱，",
    "start": 17.926,
    "end": 22.781,
    "duration": 4.855
  },
  {
    "id": 5,
    "text": "首次将亲身参与的农耕劳作与乡村日常生活全面引入诗歌。",
    "start": 23.065,
    "end": 28.366,
    "duration": 5.301
  },
  {
    "id": 6,
    "text": "苏轼在《与苏辙书》中赞其诗“质而实绮，癯而实腴”。",
    "start": 28.91,
    "end": 33.693,
    "duration": 4.783
  },
  {
    "id": 7,
    "text": "陶渊明田园诗的艺术特色与文化品格，主要体现在以下四个方面：",
    "start": 33.918,
    "end": 38.957,
    "duration": 5.039
  },
  {
    "id": 8,
    "text": "第一，开创田园诗全新题材，将平凡农耕劳作与诗意人生融为一体。",
    "start": 39.601,
    "end": 45.595,
    "duration": 5.994
  },
  {
    "id": 9,
    "text": "陶渊明在题材上的开拓性贡献，不仅在于流连恬美的农村风光，",
    "start": 45.817,
    "end": 50.732,
    "duration": 4.915
  },
  {
    "id": 10,
    "text": "更在于以士大夫的身份亲身躬耕，并将农耕甘苦升华为诗意人生的载体。",
    "start": 50.882,
    "end": 57.317,
    "duration": 6.435
  },
  {
    "id": 11,
    "text": "在《归园田居·其一》中，",
    "start": 57.527,
    "end": 59.203,
    "duration": 1.676
  },
  {
    "id": 12,
    "text": "他以亲切笔触描摹“方宅十余亩，草屋八九间。榆柳荫后檐，桃李罗堂前”的幽静村居；",
    "start": 59.48,
    "end": 67.605,
    "duration": 8.125
  },
  {
    "id": 13,
    "text": "在《其三》中，如实写出“晨兴理荒秽，带月荷锄归”的劳作艰辛，",
    "start": 67.804,
    "end": 73.764,
    "duration": 5.96
  },
  {
    "id": 14,
    "text": "并以“衣沾不足惜，但使愿无违”的坚定情志，",
    "start": 74.064,
    "end": 78.237,
    "duration": 4.173
  },
  {
    "id": 15,
    "text": "把体力耕作转化为守护人格纯洁的精神选择，确立了人与自然和谐相亲的审美典范。",
    "start": 78.484,
    "end": 85.925,
    "duration": 7.441
  },
  {
    "id": 16,
    "text": "第二，追求“平淡自然”的美学风范，达成平淡中见警策的语言化境。",
    "start": 86.52,
    "end": 91.879,
    "duration": 5.359
  },
  {
    "id": 17,
    "text": "在艺术表现上，陶诗以平淡自然、真淳质朴著称，",
    "start": 92.459,
    "end": 96.443,
    "duration": 3.984
  },
  {
    "id": 18,
    "text": "摆脱了东晋玄言诗抽象说理与晋宋之际渐趋偶对雕饰的风气。",
    "start": 96.909,
    "end": 101.588,
    "duration": 4.679
  },
  {
    "id": 19,
    "text": "陶渊明遣词用字多取家常口语与白描手法，不事藻饰而平淡中见警策、朴素中见绮丽。",
    "start": 101.995,
    "end": 109.514,
    "duration": 7.519
  },
  {
    "id": 20,
    "text": "其代表作《饮酒·其五》中，“采菊东篱下，悠然见南山。山气日夕佳，飞鸟相与还”，",
    "start": 110.111,
    "end": 117.354,
    "duration": 7.243
  },
  {
    "id": 21,
    "text": "信手拈来日常景物，毫无斧凿痕迹，却营造出物我两忘、心境浑融的意境；",
    "start": 117.404,
    "end": 124.486,
    "duration": 7.082
  },
  {
    "id": 22,
    "text": "结语“此中有真意，欲辨已忘言”，更将生活中的生命体悟化为言有尽而意无穷的诗意直觉。",
    "start": 124.689,
    "end": 132.856,
    "duration": 8.167
  },
  {
    "id": 23,
    "text": "第三，兼融儒道两家思想精髓，树立固穷守节、超然自适的士人人格。",
    "start": 133.458,
    "end": 141.003,
    "duration": 7.545
  },
  {
    "id": 24,
    "text": "陶渊明诗文不仅是田园生活的写照，也是一部独立士人的心灵史。",
    "start": 141.437,
    "end": 146.627,
    "duration": 5.19
  },
  {
    "id": 25,
    "text": "他将儒家“安贫乐道”“穷则独善其身”的操守，",
    "start": 146.941,
    "end": 150.671,
    "duration": 3.73
  },
  {
    "id": 26,
    "text": "与道家顺应自然、齐同生死得失的旷达融为一体。",
    "start": 151.058,
    "end": 155.209,
    "duration": 4.151
  },
  {
    "id": 27,
    "text": "面对官场污浊，他践行“不为五斗米折腰向乡里小儿”的气节；",
    "start": 155.456,
    "end": 160.372,
    "duration": 4.916
  },
  {
    "id": 28,
    "text": "在《桃花源记》中，他构想了一个“不知有汉，无论魏晋”、人人自食其力的和平村落，",
    "start": 160.748,
    "end": 166.715,
    "duration": 5.967
  },
  {
    "id": 29,
    "text": "寄托了对社会苦难的关切以及对理想人生秩序的向往。",
    "start": 167.008,
    "end": 170.974,
    "duration": 3.966
  },
  {
    "id": 30,
    "text": "第四，构筑后代士大夫的精神家园，对唐宋诗坛产生深远文化影响。",
    "start": 171.602,
    "end": 177.208,
    "duration": 5.606
  },
  {
    "id": 31,
    "text": "陶渊明的人格风范与诗艺造诣在中国文学史上具有深远坐标意义。",
    "start": 177.474,
    "end": 182.287,
    "duration": 4.813
  },
  {
    "id": 32,
    "text": "经过萧统推崇与宋代苏轼、朱熹等人的发扬，其地位日益崇高：",
    "start": 182.594,
    "end": 187.448,
    "duration": 4.854
  },
  {
    "id": 33,
    "text": "唐代王维、孟浩然、韦应物、柳宗元承接其脉络，开创了盛唐山水田园诗派；",
    "start": 187.672,
    "end": 193.933,
    "duration": 6.261
  },
  {
    "id": 34,
    "text": "北宋苏轼晚年屡遭贬谪，作大量“和陶诗”，借陶渊明的平淡旷达抚慰心灵创伤。",
    "start": 194.293,
    "end": 201.452,
    "duration": 7.159
  },
  {
    "id": 35,
    "text": "陶渊明以躬耕自资的操守与真淳自然的诗境，",
    "start": 201.579,
    "end": 205.113,
    "duration": 3.534
  },
  {
    "id": 36,
    "text": "成为后世士人在仕途坎坷时安顿心灵、守护尊严的精神归宿。",
    "start": 205.289,
    "end": 210.41,
    "duration": 5.121
  },
  {
    "id": 37,
    "text": "总而言之，陶渊明在晋宋玄言、山水诗风盛行之际毅然归耕田园，",
    "start": 210.656,
    "end": 216.196,
    "duration": 5.54
  },
  {
    "id": 38,
    "text": "以质朴自然的白描语言与儒道兼融的固穷节操，开辟出诗意栖居的全新审美境域。",
    "start": 216.196,
    "end": 222.636,
    "duration": 6.44
  },
  {
    "id": 39,
    "text": "这种“质而实绮，癯而实腴”的艺术追求与独立守节的人格典范，",
    "start": 222.636,
    "end": 227.356,
    "duration": 4.72
  },
  {
    "id": 40,
    "text": "不仅直接启迪了盛唐王维、孟浩然等山水田园诗人，",
    "start": 227.356,
    "end": 231.076,
    "duration": 3.72
  },
  {
    "id": 41,
    "text": "也长久成为后代士大夫安顿身心的精神家园。",
    "start": 231.076,
    "end": 234.46,
    "duration": 3.384
  }
]