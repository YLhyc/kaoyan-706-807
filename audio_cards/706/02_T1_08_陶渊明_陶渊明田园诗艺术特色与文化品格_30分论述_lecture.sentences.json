[
  {
    "id": 1,
    "text": "试论陶渊明田园诗的艺术特色与文化品格。",
    "start": 0.101,
    "end": 4.011,
    "duration": 3.91
  },
  {
    "id": 2,
    "text": "陶渊明是中国古典田园诗派的开创者，",
    "start": 4.479,
    "end": 7.214,
    "duration": 2.735
  },
  {
    "id": 3,
    "text": "也是魏晋风流与士人人格独立的杰出代表。",
    "start": 7.635,
    "end": 11.025,
    "duration": 3.39
  },
  {
    "id": 4,
    "text": "身处东晋刘宋易代之际的政治动荡与门阀专权现实之中，",
    "start": 11.434,
    "end": 15.913,
    "duration": 4.479
  },
  {
    "id": 5,
    "text": "陶渊明辞官归隐，",
    "start": 16.238,
    "end": 17.533,
    "duration": 1.295
  },
  {
    "id": 6,
    "text": "突破了东晋玄言诗枯燥说理与晋宋诗坛偏重雕琢的藩篱，",
    "start": 17.926,
    "end": 22.771,
    "duration": 4.845
  },
  {
    "id": 7,
    "text": "首次将亲身参与的农耕劳作与乡村日常生活全面引入诗歌。",
    "start": 23.065,
    "end": 28.359,
    "duration": 5.294
  },
  {
    "id": 8,
    "text": "苏轼在《与苏辙书》中赞其诗“质而实绮，癯而实腴”。",
    "start": 28.91,
    "end": 33.683,
    "duration": 4.773
  },
  {
    "id": 9,
    "text": "陶渊明田园诗的艺术特色与文化品格，主要体现在以下四个方面：",
    "start": 33.918,
    "end": 38.947,
    "duration": 5.029
  },
  {
    "id": 10,
    "text": "第一，开创田园诗全新题材，将平凡农耕劳作与诗意人生融为一体。",
    "start": 39.601,
    "end": 45.586,
    "duration": 5.985
  },
  {
    "id": 11,
    "text": "陶渊明在题材上的开拓性贡献，不仅在于流连恬美的农村风光，",
    "start": 45.817,
    "end": 50.722,
    "duration": 4.905
  },
  {
    "id": 12,
    "text": "更在于以士大夫的身份亲身躬耕，",
    "start": 50.882,
    "end": 53.751,
    "duration": 2.869
  },
  {
    "id": 13,
    "text": "并将农耕甘苦升华为诗意人生的载体。",
    "start": 54.119,
    "end": 57.307,
    "duration": 3.188
  },
  {
    "id": 14,
    "text": "在《归园田居·其一》中，他以亲切笔触描摹“方宅十余亩，",
    "start": 57.527,
    "end": 62.56,
    "duration": 5.033
  },
  {
    "id": 15,
    "text": "草屋八九间。",
    "start": 62.801,
    "end": 63.953,
    "duration": 1.152
  },
  {
    "id": 16,
    "text": "榆柳荫后檐，桃李罗堂前”的幽静村居；在《其三》中，",
    "start": 64.323,
    "end": 68.749,
    "duration": 4.426
  },
  {
    "id": 17,
    "text": "如实写出“晨兴理荒秽，带月荷锄归”的劳作艰辛，",
    "start": 69.019,
    "end": 73.754,
    "duration": 4.735
  },
  {
    "id": 18,
    "text": "并以“衣沾不足惜，但使愿无违”的坚定情志，",
    "start": 74.064,
    "end": 78.227,
    "duration": 4.163
  },
  {
    "id": 19,
    "text": "把体力耕作转化为守护人格纯洁的精神选择，",
    "start": 78.484,
    "end": 82.372,
    "duration": 3.888
  },
  {
    "id": 20,
    "text": "确立了人与自然和谐相亲的审美典范。",
    "start": 82.838,
    "end": 85.915,
    "duration": 3.077
  },
  {
    "id": 21,
    "text": "第二，追求“平淡自然”的美学风范，",
    "start": 86.52,
    "end": 89.308,
    "duration": 2.788
  },
  {
    "id": 22,
    "text": "达成平淡中见警策的语言化境。",
    "start": 89.611,
    "end": 91.869,
    "duration": 2.258
  },
  {
    "id": 23,
    "text": "在艺术表现上，陶诗以平淡自然、真淳质朴著称，",
    "start": 92.459,
    "end": 96.433,
    "duration": 3.974
  },
  {
    "id": 24,
    "text": "摆脱了东晋玄言诗抽象说理与晋宋之际渐趋偶对雕饰的风气。",
    "start": 96.909,
    "end": 101.578,
    "duration": 4.669
  },
  {
    "id": 25,
    "text": "陶渊明遣词用字多取家常口语与白描手法，",
    "start": 101.995,
    "end": 105.265,
    "duration": 3.27
  },
  {
    "id": 26,
    "text": "不事藻饰而平淡中见警策、朴素中见绮丽。",
    "start": 105.576,
    "end": 109.504,
    "duration": 3.928
  },
  {
    "id": 27,
    "text": "其代表作《饮酒·其五》中，“采菊东篱下，悠然见南山。",
    "start": 110.111,
    "end": 114.653,
    "duration": 4.542
  },
  {
    "id": 28,
    "text": "山气日夕佳，飞鸟相与还”，信手拈来日常景物，",
    "start": 115.021,
    "end": 119.42,
    "duration": 4.399
  },
  {
    "id": 29,
    "text": "毫无斧凿痕迹，却营造出物我两忘、心境浑融的意境；",
    "start": 119.685,
    "end": 124.476,
    "duration": 4.791
  },
  {
    "id": 30,
    "text": "结语“此中有真意，欲辨已忘言”，",
    "start": 124.689,
    "end": 127.538,
    "duration": 2.849
  },
  {
    "id": 31,
    "text": "更将生活中的生命体悟化为言有尽而意无穷的诗意直觉。",
    "start": 127.813,
    "end": 132.846,
    "duration": 5.033
  },
  {
    "id": 32,
    "text": "第三，兼融儒道两家思想精髓，树立固穷守节、",
    "start": 133.458,
    "end": 138.583,
    "duration": 5.125
  },
  {
    "id": 33,
    "text": "超然自适的士人人格。",
    "start": 139.292,
    "end": 140.993,
    "duration": 1.701
  },
  {
    "id": 34,
    "text": "陶渊明诗文不仅是田园生活的写照，也是一部独立士人的心灵史。",
    "start": 141.437,
    "end": 146.618,
    "duration": 5.181
  },
  {
    "id": 35,
    "text": "他将儒家“安贫乐道”“穷则独善其身”的操守，",
    "start": 146.941,
    "end": 150.673,
    "duration": 3.732
  },
  {
    "id": 36,
    "text": "与道家顺应自然、齐同生死得失的旷达融为一体。",
    "start": 151.058,
    "end": 155.199,
    "duration": 4.141
  },
  {
    "id": 37,
    "text": "面对官场污浊，他践行“不为五斗米折腰向乡里小儿”的气节；",
    "start": 155.456,
    "end": 160.362,
    "duration": 4.906
  },
  {
    "id": 38,
    "text": "在《桃花源记》中，他构想了一个“不知有汉，无论魏晋”、",
    "start": 160.748,
    "end": 164.576,
    "duration": 3.828
  },
  {
    "id": 39,
    "text": "人人自食其力的和平村落，",
    "start": 164.976,
    "end": 166.707,
    "duration": 1.731
  },
  {
    "id": 40,
    "text": "寄托了对社会苦难的关切以及对理想人生秩序的向往。",
    "start": 167.008,
    "end": 170.964,
    "duration": 3.956
  },
  {
    "id": 41,
    "text": "第四，构筑后代士大夫的精神家园，对唐宋诗坛产生深远文化影响。",
    "start": 171.602,
    "end": 177.198,
    "duration": 5.596
  },
  {
    "id": 42,
    "text": "陶渊明的人格风范与诗艺造诣在中国文学史上具有深远坐标意义。",
    "start": 177.474,
    "end": 182.277,
    "duration": 4.803
  },
  {
    "id": 43,
    "text": "经过萧统推崇与宋代苏轼、朱熹等人的发扬，其地位日益崇高：",
    "start": 182.594,
    "end": 187.438,
    "duration": 4.844
  },
  {
    "id": 44,
    "text": "唐代王维、孟浩然、韦应物、柳宗元承接其脉络，",
    "start": 187.672,
    "end": 191.598,
    "duration": 3.926
  },
  {
    "id": 45,
    "text": "开创了盛唐山水田园诗派；北宋苏轼晚年屡遭贬谪，",
    "start": 191.832,
    "end": 196.465,
    "duration": 4.633
  },
  {
    "id": 46,
    "text": "作大量“和陶诗”，借陶渊明的平淡旷达抚慰心灵创伤。",
    "start": 196.607,
    "end": 201.442,
    "duration": 4.835
  },
  {
    "id": 47,
    "text": "陶渊明以躬耕自资的操守与真淳自然的诗境，",
    "start": 201.579,
    "end": 205.103,
    "duration": 3.524
  },
  {
    "id": 48,
    "text": "成为后世士人在仕途坎坷时安顿心灵、守护尊严的精神归宿。",
    "start": 205.289,
    "end": 210.41,
    "duration": 5.121
  }
]