[
  {
    "id": 1,
    "text": "《庄子》是先秦诸子散文发展的最高峰，",
    "start": 0.0,
    "end": 3.032,
    "duration": 3.032
  },
  {
    "id": 2,
    "text": "更是中国古代文学浪漫主义的哲学源头。",
    "start": 3.032,
    "end": 6.469,
    "duration": 3.437
  },
  {
    "id": 3,
    "text": "鲁迅在《汉文学史纲要》中极口称赞：“汪洋辟河，",
    "start": 6.469,
    "end": 10.108,
    "duration": 3.639
  },
  {
    "id": 4,
    "text": "仪态万方，晚周诸子之作，莫能先也”。",
    "start": 10.108,
    "end": 12.938,
    "duration": 2.83
  },
  {
    "id": 5,
    "text": "袁行配《中国文学史》指出，《庄子》打破了传统说理散文枯燥逻辑论辩的桎梏。",
    "start": 12.938,
    "end": 18.8,
    "duration": 5.862
  },
  {
    "id": 6,
    "text": "它将深奥超逸的道家哲理，完全熔铸于生动绚烂的文学意象与奇崛想象之中。",
    "start": 18.88,
    "end": 25.84,
    "duration": 6.96
  },
  {
    "id": 7,
    "text": "其杰出的散文艺术与浪漫主义表现，",
    "start": 25.84,
    "end": 28.72,
    "duration": 2.88
  },
  {
    "id": 8,
    "text": "主要展现在以下四个核心维度：《庄子》彻底摆脱了先秦诸子板滞的对话体模式，",
    "start": 28.72,
    "end": 35.12,
    "duration": 6.4
  },
  {
    "id": 9,
    "text": "构建起独特的哲学说理体系。",
    "start": 35.12,
    "end": 37.44,
    "duration": 2.32
  },
  {
    "id": 10,
    "text": "《寓言》篇明确提出其创作机制：“寓言十九，",
    "start": 37.68,
    "end": 41.423,
    "duration": 3.743
  },
  {
    "id": 11,
    "text": "重言十七，之言日出，和以天倪”。",
    "start": 41.423,
    "end": 44.23,
    "duration": 2.807
  },
  {
    "id": 12,
    "text": "所谓寓言，即借虚构的故事与生动形象寄托深奥的哲理，",
    "start": 44.23,
    "end": 49.61,
    "duration": 5.38
  },
  {
    "id": 13,
    "text": "化抽象思辨为感性具象。",
    "start": 49.61,
    "end": 51.949,
    "duration": 2.339
  },
  {
    "id": 14,
    "text": "所谓重言，即假托古昔圣贤与历史名人之言，",
    "start": 51.949,
    "end": 56.159,
    "duration": 4.21
  },
  {
    "id": 15,
    "text": "借以增强论说的庄重与说服力。",
    "start": 56.159,
    "end": 59.2,
    "duration": 3.041
  },
  {
    "id": 16,
    "text": "所谓之言，即随顺万物变化、不固执定见的无心之言，",
    "start": 59.36,
    "end": 64.32,
    "duration": 4.96
  },
  {
    "id": 17,
    "text": "使论述空灵流动而不露斧凿之痕。",
    "start": 64.32,
    "end": 67.76,
    "duration": 3.44
  },
  {
    "id": 18,
    "text": "三者高度交融互摄，使《庄子》的散文呈现出虚实相生、",
    "start": 67.76,
    "end": 72.56,
    "duration": 4.8
  },
  {
    "id": 19,
    "text": "波决云诡的艺术生机。",
    "start": 72.56,
    "end": 74.64,
    "duration": 2.08
  },
  {
    "id": 20,
    "text": "这一机制彻底改变了古典散文的形态，",
    "start": 74.64,
    "end": 77.52,
    "duration": 2.88
  },
  {
    "id": 21,
    "text": "开启了中国古代叙事文学借象明理的传统。",
    "start": 77.52,
    "end": 80.88,
    "duration": 3.36
  },
  {
    "id": 22,
    "text": "庄子拥有先秦文学中最开阔惊艳的浪漫想象力，",
    "start": 81.12,
    "end": 85.44,
    "duration": 4.32
  },
  {
    "id": 23,
    "text": "善于跨越时空界限建构壮美大象。",
    "start": 85.44,
    "end": 88.32,
    "duration": 2.88
  },
  {
    "id": 24,
    "text": "这一艺术特质在名篇《逍遥游》开篇中得到了极致的挥洒。",
    "start": 88.32,
    "end": 92.88,
    "duration": 4.56
  },
  {
    "id": 25,
    "text": "文中写道：“北冥有鱼，其名为坤。",
    "start": 92.88,
    "end": 96.0,
    "duration": 3.12
  },
  {
    "id": 26,
    "text": "坤之大，不知其几千里也。",
    "start": 96.0,
    "end": 98.48,
    "duration": 2.48
  },
  {
    "id": 27,
    "text": "化而为鸟，其名为鹏”。",
    "start": 98.48,
    "end": 100.24,
    "duration": 1.76
  },
  {
    "id": 28,
    "text": "作者以极度夸张的笔墨，描摹大鹏背若泰山、",
    "start": 100.64,
    "end": 104.72,
    "duration": 4.08
  },
  {
    "id": 29,
    "text": "翼若垂天之云、水击三千里的恢弘气势。",
    "start": 104.72,
    "end": 108.4,
    "duration": 3.68
  },
  {
    "id": 30,
    "text": "坤鹏由溟海腾跃而起飞向南海的意象，",
    "start": 108.4,
    "end": 112.56,
    "duration": 4.16
  },
  {
    "id": 31,
    "text": "象征着个体生命挣脱羁绊追求绝对自由的崇高冲动。",
    "start": 112.56,
    "end": 117.28,
    "duration": 4.72
  },
  {
    "id": 32,
    "text": "紧接着以条与学鸠的嘲笑形成鲜明对比，",
    "start": 117.28,
    "end": 120.88,
    "duration": 3.6
  },
  {
    "id": 33,
    "text": "在大小之辨中展开精神层次的深刻思辨。",
    "start": 120.88,
    "end": 124.56,
    "duration": 3.68
  },
  {
    "id": 34,
    "text": "这种奇崛宏大的想象，不仅极大地拓展了文学的意象疆域，",
    "start": 124.8,
    "end": 129.44,
    "duration": 4.64
  },
  {
    "id": 35,
    "text": "更展现出非凡的精神张力。",
    "start": 129.44,
    "end": 132.08,
    "duration": 2.64
  },
  {
    "id": 36,
    "text": "《庄子》散文的魅力在于哲理不再是干燥的概念，",
    "start": 132.08,
    "end": 135.84,
    "duration": 3.76
  },
  {
    "id": 37,
    "text": "而是纯粹空灵的诗意七居。",
    "start": 135.84,
    "end": 138.48,
    "duration": 2.64
  },
  {
    "id": 38,
    "text": "庄子善于运用富于启发性的自然物象，",
    "start": 138.48,
    "end": 141.76,
    "duration": 3.28
  },
  {
    "id": 39,
    "text": "让形而上的“道”在视觉意象中自然显现。",
    "start": 141.76,
    "end": 144.96,
    "duration": 3.2
  },
  {
    "id": 40,
    "text": "最为著名的当属《齐物论》中的“庄周梦蝶”寓言。",
    "start": 145.28,
    "end": 149.6,
    "duration": 4.32
  },
  {
    "id": 41,
    "text": "庄子自述梦为蝴蝶栩栩然，醒后不知是庄周梦蝶还是蝴蝶梦庄周。",
    "start": 149.984,
    "end": 156.624,
    "duration": 6.64
  },
  {
    "id": 42,
    "text": "这一著名的哲理意象超越了主客体对立，",
    "start": 156.624,
    "end": 160.064,
    "duration": 3.44
  },
  {
    "id": 43,
    "text": "以诗化笔触阐明了齐物合一、物化无界的虚静境界。",
    "start": 160.064,
    "end": 165.024,
    "duration": 4.96
  },
  {
    "id": 44,
    "text": "又如《养生主》中的“庖丁解牛”，",
    "start": 165.024,
    "end": 167.424,
    "duration": 2.4
  },
  {
    "id": 45,
    "text": "将血腥屠宰升华为依乎天理、游刃有余的生命艺术体验。",
    "start": 167.424,
    "end": 172.464,
    "duration": 5.04
  },
  {
    "id": 46,
    "text": "意象本身兼具多义性与象征性，达到了言有尽而意无穷的至高审美境界。",
    "start": 172.704,
    "end": 179.024,
    "duration": 6.32
  },
  {
    "id": 47,
    "text": "《庄子》表面看似清虚超脱、任运随顺，",
    "start": 179.024,
    "end": 182.624,
    "duration": 3.6
  },
  {
    "id": 48,
    "text": "骨子里却蕴含着对战乱现实最深沉的激愤。",
    "start": 182.624,
    "end": 186.224,
    "duration": 3.6
  },
  {
    "id": 49,
    "text": "庄子生逢战国乱世，目睹道德沦丧、",
    "start": 186.224,
    "end": 189.344,
    "duration": 3.12
  },
  {
    "id": 50,
    "text": "生灵涂炭与强权暴虐，内心怀抱着深刻的人性悲哀。",
    "start": 189.344,
    "end": 193.984,
    "duration": 4.64
  },
  {
    "id": 51,
    "text": "他愤激痛斥“窃钩者诛，窃国者为诸侯”，",
    "start": 194.304,
    "end": 198.544,
    "duration": 4.24
  },
  {
    "id": 52,
    "text": "以辛辣幽默的语言撕开封建仁义礼法的虚伪面具。",
    "start": 198.544,
    "end": 202.864,
    "duration": 4.32
  },
  {
    "id": 53,
    "text": "在面对生死与困顿的绝境时，他以鼓盆而歌、",
    "start": 202.864,
    "end": 206.624,
    "duration": 3.76
  },
  {
    "id": 54,
    "text": "坦然受死的冷峻态度抵抗世俗异化。",
    "start": 206.624,
    "end": 210.144,
    "duration": 3.52
  },
  {
    "id": 55,
    "text": "这种激愤之情化为散文中奔腾恣肆的语流，",
    "start": 210.144,
    "end": 213.904,
    "duration": 3.76
  },
  {
    "id": 56,
    "text": "行文如天赖倾泻，跌宕起伏而不可阻遏。",
    "start": 213.904,
    "end": 217.984,
    "duration": 4.08
  },
  {
    "id": 57,
    "text": "冷酷嘲讽的背面是极致的悲敏，构成了庄子散文雄浑峻拔的人格精神力量。",
    "start": 218.064,
    "end": 224.384,
    "duration": 6.32
  },
  {
    "id": 58,
    "text": "综上所述，《庄子》实现了深刻哲学思辨与杰出文学才华的天才结合。",
    "start": 224.384,
    "end": 229.744,
    "duration": 5.36
  },
  {
    "id": 59,
    "text": "它开创了中国古代诗意哲学与浪漫主义散文的宏伟范式。",
    "start": 229.744,
    "end": 234.144,
    "duration": 4.4
  },
  {
    "id": 60,
    "text": "这一传统直接哺育了魏晋阮籍、嵇康的傲岸风骨，",
    "start": 234.144,
    "end": 238.224,
    "duration": 4.08
  },
  {
    "id": 61,
    "text": "陶渊明的归真美学，李白的狂放诗风与苏轼的旷达文采。",
    "start": 238.224,
    "end": 243.024,
    "duration": 4.8
  },
  {
    "id": 62,
    "text": "《庄子》因而成为中华民族精神自由与文学创造力取之不尽的源头活水。--",
    "start": 243.184,
    "end": 249.824,
    "duration": 6.64
  }
]