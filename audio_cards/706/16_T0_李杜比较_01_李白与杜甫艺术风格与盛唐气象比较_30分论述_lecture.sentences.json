[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 3.12,
    "duration": 3.04
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 3.12,
    "end": 6.16,
    "duration": 3.04
  },
  {
    "id": 3,
    "text": "这道题考查盛唐诗歌巅峰李杜二人的审美对比。",
    "start": 6.32,
    "end": 10.56,
    "duration": 4.24
  },
  {
    "id": 4,
    "text": "在考场上，考生不能简单分别介绍李白和杜甫的生平，",
    "start": 10.56,
    "end": 14.96,
    "duration": 4.4
  },
  {
    "id": 5,
    "text": "而必须将两人置于“盛唐气象”的统一历史坐标中，",
    "start": 14.96,
    "end": 18.96,
    "duration": 4.0
  },
  {
    "id": 6,
    "text": "回答出李杜如何以两种截然不同却高度互补的艺术路径，",
    "start": 18.96,
    "end": 23.6,
    "duration": 4.64
  },
  {
    "id": 7,
    "text": "共同托举起盛唐诗歌的伟大格局。",
    "start": 23.6,
    "end": 26.32,
    "duration": 2.72
  },
  {
    "id": 8,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 26.64,
    "end": 30.08,
    "duration": 3.44
  },
  {
    "id": 9,
    "text": "答题必须确立“横向对比加纵向贯通”的学术视野。",
    "start": 30.08,
    "end": 34.4,
    "duration": 4.32
  },
  {
    "id": 10,
    "text": "从思想精神、艺术机制、体裁文体三个层面展开对仗式剖析，",
    "start": 34.4,
    "end": 39.92,
    "duration": 5.52
  },
  {
    "id": 11,
    "text": "最后在盛唐气象的总体框架下完成归纳总结，",
    "start": 39.92,
    "end": 43.92,
    "duration": 4.0
  },
  {
    "id": 12,
    "text": "避免出现“前一半写李白、后一半写杜甫”的割裂拼凑。",
    "start": 43.92,
    "end": 48.32,
    "duration": 4.4
  },
  {
    "id": 13,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 48.64,
    "end": 52.08,
    "duration": 3.44
  },
  {
    "id": 14,
    "text": "全题分为四个核心论述维度：第一维度：界定李杜二人作为盛唐双峰的文学史地位；",
    "start": 52.08,
    "end": 59.84,
    "duration": 7.76
  },
  {
    "id": 15,
    "text": "第二维度：深入剖析两者在人格追求与时代精神投射上的异同（自信放达versus忧患兼济）；",
    "start": 59.84,
    "end": 68.16,
    "duration": 8.32
  },
  {
    "id": 16,
    "text": "第三维度：深刻对比两者在抒情机制与审美形态上的不同范式（飘逸奔放的浪漫主义versus沉郁顿挫的现实主义）；",
    "start": 68.16,
    "end": 77.36,
    "duration": 9.2
  },
  {
    "id": 17,
    "text": "第四维度：精准辨析两者在体裁文体与语言格律上的取向分流（古风绝句的天然纵逸versus近体律诗的精严集大成）；",
    "start": 77.6,
    "end": 88.48,
    "duration": 10.88
  },
  {
    "id": 18,
    "text": "第五维度：宏观总结李杜互补对盛唐气象整体建构的典范价值。",
    "start": 88.48,
    "end": 93.76,
    "duration": 5.28
  },
  {
    "id": 19,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 93.76,
    "end": 97.44,
    "duration": 3.68
  },
  {
    "id": 20,
    "text": "全题逻辑严密咬合：第一步宏观立论，",
    "start": 97.6,
    "end": 101.2,
    "duration": 3.6
  },
  {
    "id": 21,
    "text": "确立李杜与盛唐气象的内在关联。",
    "start": 101.2,
    "end": 103.84,
    "duration": 2.64
  },
  {
    "id": 22,
    "text": "第二步从精神灵魂层面入手，探讨盛唐时代如何在二人身上投射为不同的心理结构。",
    "start": 103.84,
    "end": 110.64,
    "duration": 6.8
  },
  {
    "id": 23,
    "text": "第三步顺理成章将精神内核转化为审美形态，",
    "start": 110.64,
    "end": 114.4,
    "duration": 3.76
  },
  {
    "id": 24,
    "text": "剖析浪漫抒情与诗史纪实。",
    "start": 114.4,
    "end": 116.56,
    "duration": 2.16
  },
  {
    "id": 25,
    "text": "第四步再将审美落实到最微观的形式与诗律层面，",
    "start": 116.88,
    "end": 121.2,
    "duration": 4.32
  },
  {
    "id": 26,
    "text": "对比歌行古体与律体诗章。",
    "start": 121.2,
    "end": 123.84,
    "duration": 2.64
  },
  {
    "id": 27,
    "text": "第五步完成宏观历史论证闭环。",
    "start": 123.84,
    "end": 126.56,
    "duration": 2.72
  },
  {
    "id": 28,
    "text": "二、各板块逐句咬合演练。",
    "start": 126.56,
    "end": 129.04,
    "duration": 2.48
  },
  {
    "id": 29,
    "text": "一、开头破题段内部咬合。",
    "start": 129.04,
    "end": 131.28,
    "duration": 2.24
  },
  {
    "id": 30,
    "text": "本段旨在开门见山确立双峰并峙的立论基石。",
    "start": 131.28,
    "end": 135.28,
    "duration": 4.0
  },
  {
    "id": 31,
    "text": "首句直切李杜经典地位，次句交代全篇对比向度。",
    "start": 135.28,
    "end": 139.36,
    "duration": 4.08
  },
  {
    "id": 32,
    "text": "-首先，首句必须直接亮出李杜并立的学术共识，",
    "start": 139.584,
    "end": 143.408,
    "duration": 3.824
  },
  {
    "id": 33,
    "text": "具体表述到答题语句就是：李白与杜甫是中国古典诗歌发展巅峰上并峙的双峰，",
    "start": 143.408,
    "end": 150.05,
    "duration": 6.642
  },
  {
    "id": 34,
    "text": "共同从不同侧面烛照并铸就了盛唐气象的博大格局。，",
    "start": 150.05,
    "end": 154.477,
    "duration": 4.427
  },
  {
    "id": 35,
    "text": "这句话将两人紧密绑定在盛唐气象的命题核心上。",
    "start": 154.477,
    "end": 158.704,
    "duration": 4.227
  },
  {
    "id": 36,
    "text": "-有了核心地位之后，次句必须迅速说明两者的对比维度，",
    "start": 158.704,
    "end": 163.663,
    "duration": 4.959
  },
  {
    "id": 37,
    "text": "具体表述到答题语句就是：两者在精神追求、",
    "start": 163.663,
    "end": 167.544,
    "duration": 3.881
  },
  {
    "id": 38,
    "text": "抒情机制与体裁建构上各具卓异特质，",
    "start": 167.544,
    "end": 170.994,
    "duration": 3.45
  },
  {
    "id": 39,
    "text": "展现了唐代诗歌从激昂蓬勃走向深沉浑厚的全景演进。，",
    "start": 170.994,
    "end": 175.954,
    "duration": 4.96
  },
  {
    "id": 40,
    "text": "这句话干脆利落地搭建起全篇三个对比分论点的论证骨架。",
    "start": 175.954,
    "end": 181.344,
    "duration": 5.39
  },
  {
    "id": 41,
    "text": "李白与杜甫是中国古典诗歌发展巅峰上并峙的双峰，",
    "start": 181.424,
    "end": 185.984,
    "duration": 4.56
  },
  {
    "id": 42,
    "text": "共同从不同侧面烛照并铸就了盛唐气象的博大格局。",
    "start": 185.984,
    "end": 190.944,
    "duration": 4.96
  },
  {
    "id": 43,
    "text": "两者在精神追求、抒情机制与体裁建构上各具卓异特质，",
    "start": 190.944,
    "end": 196.144,
    "duration": 5.2
  },
  {
    "id": 44,
    "text": "展现了唐代诗歌从激昂蓬勃走向深沉浑厚的全景演进。",
    "start": 196.144,
    "end": 201.104,
    "duration": 4.96
  },
  {
    "id": 45,
    "text": "二、第一维度：精神品格与时代精神投射对比内部咬合。",
    "start": 201.104,
    "end": 205.584,
    "duration": 4.48
  },
  {
    "id": 46,
    "text": "本段任务是深入剖析时代在两尊诗人灵魂中激荡出的不同品格，",
    "start": 205.824,
    "end": 211.504,
    "duration": 5.68
  },
  {
    "id": 47,
    "text": "从宏观社会氛围推进到具体诗篇名句。",
    "start": 211.504,
    "end": 215.024,
    "duration": 3.52
  },
  {
    "id": 48,
    "text": "首先，段首给出结论先行的分论点，",
    "start": 215.024,
    "end": 217.664,
    "duration": 2.64
  },
  {
    "id": 49,
    "text": "具体表述到答题语句就是：第一，在时代精神投射与主体人格品格上，",
    "start": 217.664,
    "end": 223.344,
    "duration": 5.68
  },
  {
    "id": 50,
    "text": "李白展现了盛唐蓬勃自信的自由精神，",
    "start": 223.344,
    "end": 226.384,
    "duration": 3.04
  },
  {
    "id": 51,
    "text": "杜甫则体现了盛唐兼济天下的忧患意识与博大胸襟。",
    "start": 226.384,
    "end": 230.464,
    "duration": 4.08
  },
  {
    "id": 52,
    "text": "-随后，展开李白精神机制的分析，",
    "start": 230.704,
    "end": 233.449,
    "duration": 2.745
  },
  {
    "id": 53,
    "text": "具体表述到答题语句就是：盛唐社会的空前繁荣与开放风气，",
    "start": 233.449,
    "end": 238.729,
    "duration": 5.28
  },
  {
    "id": 54,
    "text": "赋予李白强烈的自我主体意识与蔑视权贵的豪侠气概。",
    "start": 238.729,
    "end": 243.586,
    "duration": 4.857
  },
  {
    "id": 55,
    "text": "紧接着，调取李白典型名句做论据支撑，",
    "start": 243.586,
    "end": 246.965,
    "duration": 3.379
  },
  {
    "id": 56,
    "text": "具体表述到答题语句就是：李白在《将进酒》中高唱“天生我材必有用，",
    "start": 246.965,
    "end": 252.667,
    "duration": 5.702
  },
  {
    "id": 57,
    "text": "千金散尽还复来”，在《梦游天姥吟留别》中断喝“安能摧眉折腰事权贵，",
    "start": 252.667,
    "end": 258.369,
    "duration": 5.702
  },
  {
    "id": 58,
    "text": "使我不得开心颜”，将盛唐士人的自信自尊与对精神自由的追寻推向顶点。",
    "start": 258.369,
    "end": 264.704,
    "duration": 6.335
  },
  {
    "id": 59,
    "text": "-随后，自然转向杜甫的精神深析，",
    "start": 264.704,
    "end": 267.549,
    "duration": 2.845
  },
  {
    "id": 60,
    "text": "形成强烈对比，具体表述到答题语句就是：杜甫则根植于儒家仁政理想与民胞物与的情怀，",
    "start": 267.549,
    "end": 275.647,
    "duration": 8.098
  },
  {
    "id": 61,
    "text": "在开元盛世转向安史之乱的剧烈转折中，",
    "start": 275.647,
    "end": 279.367,
    "duration": 3.72
  },
  {
    "id": 62,
    "text": "将个人的漂泊困顿与国家民族的存亡紧密相连。",
    "start": 279.367,
    "end": 283.744,
    "duration": 4.377
  },
  {
    "id": 63,
    "text": "-最后，调取杜甫典型篇目与名句，",
    "start": 283.8,
    "end": 286.56,
    "duration": 2.76
  },
  {
    "id": 64,
    "text": "提炼其精神力量，具体表述到答题语句就是：杜甫在《茅屋为秋风所破歌》中发出“安得广厦千万间，",
    "start": 286.56,
    "end": 294.838,
    "duration": 8.278
  },
  {
    "id": 65,
    "text": "大庇天下寒士俱欢颜”的宏大呼喊，",
    "start": 294.838,
    "end": 297.81,
    "duration": 2.972
  },
  {
    "id": 66,
    "text": "在推己及人中展现出悲天敏人的博大胸襟，",
    "start": 297.81,
    "end": 301.631,
    "duration": 3.821
  },
  {
    "id": 67,
    "text": "从深层揭示了盛唐气象沉雄深厚的一面。",
    "start": 301.631,
    "end": 305.24,
    "duration": 3.609
  },
  {
    "id": 68,
    "text": "第一，在时代精神投射与主体人格品格上，",
    "start": 305.32,
    "end": 309.0,
    "duration": 3.68
  },
  {
    "id": 69,
    "text": "李白展现了盛唐蓬勃自信的自由精神，",
    "start": 309.0,
    "end": 312.04,
    "duration": 3.04
  },
  {
    "id": 70,
    "text": "杜甫则体现了盛唐兼济天下的忧患意识与博大胸襟。",
    "start": 312.04,
    "end": 316.92,
    "duration": 4.88
  },
  {
    "id": 71,
    "text": "盛唐社会的空前繁荣与开放风气，赋予李白强烈的自我主体意识与蔑视权贵的豪侠气概。",
    "start": 316.92,
    "end": 324.36,
    "duration": 7.44
  },
  {
    "id": 72,
    "text": "李白在《将进酒》中高唱“天生我材必有用，",
    "start": 324.36,
    "end": 327.64,
    "duration": 3.28
  },
  {
    "id": 73,
    "text": "千金散尽还复来”，在《梦游天姥吟留别》中断喝“安能摧眉折腰事权贵，",
    "start": 327.64,
    "end": 333.64,
    "duration": 6.0
  },
  {
    "id": 74,
    "text": "使我不得开心颜”，将盛唐士人的自信自尊与对精神自由的追寻推向顶点。",
    "start": 333.64,
    "end": 339.88,
    "duration": 6.24
  },
  {
    "id": 75,
    "text": "杜甫则根植于儒家仁政理想与民胞物与的情怀，",
    "start": 340.12,
    "end": 344.28,
    "duration": 4.16
  },
  {
    "id": 76,
    "text": "在开元盛世转向安史之乱的剧烈转折中，",
    "start": 344.28,
    "end": 347.64,
    "duration": 3.36
  },
  {
    "id": 77,
    "text": "将个人的漂泊困顿与国家民族的存亡紧密相连。",
    "start": 347.64,
    "end": 351.8,
    "duration": 4.16
  },
  {
    "id": 78,
    "text": "杜甫在《茅屋为秋风所破歌》中发出“安得广厦千万间，",
    "start": 351.8,
    "end": 356.2,
    "duration": 4.4
  },
  {
    "id": 79,
    "text": "大庇天下寒士俱欢颜”的宏大呼喊，",
    "start": 356.2,
    "end": 359.08,
    "duration": 2.88
  },
  {
    "id": 80,
    "text": "在推己及人中展现出悲天敏人的博大胸襟，",
    "start": 359.08,
    "end": 362.76,
    "duration": 3.68
  },
  {
    "id": 81,
    "text": "从深层揭示了盛唐气象沉雄深厚的一面。",
    "start": 362.76,
    "end": 366.04,
    "duration": 3.28
  },
  {
    "id": 82,
    "text": "三、第二维度：抒情机制与审美形态对比内部咬合。",
    "start": 366.36,
    "end": 370.92,
    "duration": 4.56
  },
  {
    "id": 83,
    "text": "本段任务是从内在机制剖析浪漫主义奇想与现实主义诗史的生成差异。",
    "start": 370.92,
    "end": 377.08,
    "duration": 6.16
  },
  {
    "id": 84,
    "text": "首先，段首给出结论先行的分论点，",
    "start": 377.08,
    "end": 380.04,
    "duration": 2.96
  },
  {
    "id": 85,
    "text": "具体表述到答题语句就是：第二，在抒情机制与审美形态上，",
    "start": 380.04,
    "end": 385.16,
    "duration": 5.12
  },
  {
    "id": 86,
    "text": "李白长于喷薄而出的主观抒情与超现实想象，",
    "start": 385.16,
    "end": 389.24,
    "duration": 4.08
  },
  {
    "id": 87,
    "text": "杜甫长于沉郁顿挫的情感蓄积与高度写实的诗史叙事。",
    "start": 389.24,
    "end": 394.2,
    "duration": 4.96
  },
  {
    "id": 88,
    "text": "-随后，剖析李白打破时空常理的浪漫抒情特征，",
    "start": 394.44,
    "end": 398.449,
    "duration": 4.009
  },
  {
    "id": 89,
    "text": "具体表述到答题语句就是：李白的抒情方式具有强烈的主观化与跳跃性特征。，",
    "start": 398.449,
    "end": 405.2,
    "duration": 6.751
  },
  {
    "id": 90,
    "text": "紧接着指出其造境手法：诗人往往打破现实时空逻辑，",
    "start": 405.2,
    "end": 409.842,
    "duration": 4.642
  },
  {
    "id": 91,
    "text": "调动天马行空的神话意象与夸张手法，",
    "start": 409.842,
    "end": 413.217,
    "duration": 3.375
  },
  {
    "id": 92,
    "text": "形成飘逸奔放的浪漫主义美学。",
    "start": 413.217,
    "end": 415.96,
    "duration": 2.743
  },
  {
    "id": 93,
    "text": "-紧接着，举出教材典型名篇论证李白，",
    "start": 416.016,
    "end": 419.152,
    "duration": 3.136
  },
  {
    "id": 94,
    "text": "具体表述到答题语句就是：比如在《蜀道难》中，",
    "start": 419.152,
    "end": 422.916,
    "duration": 3.764
  },
  {
    "id": 95,
    "text": "诗人以“上有六龙回日之高标，下有冲波逆折之回川”的惊人奇想，",
    "start": 422.916,
    "end": 428.352,
    "duration": 5.436
  },
  {
    "id": 96,
    "text": "借蜀道艰险抒发人生幻灭与宏阔感慨。",
    "start": 428.352,
    "end": 431.697,
    "duration": 3.345
  },
  {
    "id": 97,
    "text": "随后，转向杜甫沉郁顿挫的叙事抒情剖析，",
    "start": 431.697,
    "end": 435.251,
    "duration": 3.554
  },
  {
    "id": 98,
    "text": "具体表述到答题语句就是：杜甫的抒情则深沉蕴藉，",
    "start": 435.251,
    "end": 439.642,
    "duration": 4.391
  },
  {
    "id": 99,
    "text": "情感在曲折回旋中徐徐展开。，",
    "start": 439.642,
    "end": 442.151,
    "duration": 2.509
  },
  {
    "id": 100,
    "text": "阐释其诗史机制：其诗歌以写实见长，",
    "start": 442.151,
    "end": 445.287,
    "duration": 3.136
  },
  {
    "id": 101,
    "text": "深刻记录了时代动荡与民间疾苦，具备鲜明的“诗史”性质。",
    "start": 445.287,
    "end": 450.096,
    "duration": 4.809
  },
  {
    "id": 102,
    "text": "-最后，调取“三吏”叙事细节作闭环支撑，",
    "start": 450.096,
    "end": 453.258,
    "duration": 3.162
  },
  {
    "id": 103,
    "text": "具体表述到答题语句就是：比如在《石壕吏》与《新安吏》等叙事名篇中，",
    "start": 453.258,
    "end": 458.948,
    "duration": 5.69
  },
  {
    "id": 104,
    "text": "杜甫通过客观冷静的细节白描与老妇自诉，",
    "start": 458.948,
    "end": 462.742,
    "duration": 3.794
  },
  {
    "id": 105,
    "text": "深刻揭露了战乱对平民家庭的残酷摧残，",
    "start": 462.742,
    "end": 466.325,
    "duration": 3.583
  },
  {
    "id": 106,
    "text": "叙事之中寄托着深沉的悲愤与同情，",
    "start": 466.325,
    "end": 469.487,
    "duration": 3.162
  },
  {
    "id": 107,
    "text": "形成了悲壮沉郁的美学风格。",
    "start": 469.487,
    "end": 472.016,
    "duration": 2.529
  },
  {
    "id": 108,
    "text": "第二，在抒情机制与审美形态上，李白长于喷薄而出的主观抒情与超现实想象，",
    "start": 472.096,
    "end": 479.376,
    "duration": 7.28
  },
  {
    "id": 109,
    "text": "杜甫长于沉郁顿挫的情感蓄积与高度写实的诗史叙事。",
    "start": 479.376,
    "end": 484.096,
    "duration": 4.72
  },
  {
    "id": 110,
    "text": "李白的抒情方式具有强烈的主观化与跳跃性特征。",
    "start": 484.096,
    "end": 488.336,
    "duration": 4.24
  },
  {
    "id": 111,
    "text": "诗人往往打破现实时空逻辑，调动天马行空的神话意象与夸张手法，",
    "start": 488.336,
    "end": 494.176,
    "duration": 5.84
  },
  {
    "id": 112,
    "text": "形成飘逸奔放的浪漫主义美学。",
    "start": 494.176,
    "end": 496.496,
    "duration": 2.32
  },
  {
    "id": 113,
    "text": "比如在《蜀道难》中，诗人以“上有六龙回日之高标，",
    "start": 496.816,
    "end": 501.056,
    "duration": 4.24
  },
  {
    "id": 114,
    "text": "下有冲波逆折之回川”的惊人奇想，",
    "start": 501.056,
    "end": 504.016,
    "duration": 2.96
  },
  {
    "id": 115,
    "text": "借蜀道艰险抒发人生幻灭与宏阔感慨。",
    "start": 504.016,
    "end": 507.296,
    "duration": 3.28
  },
  {
    "id": 116,
    "text": "杜甫的抒情则深沉蕴藉，情感在曲折回旋中徐徐展开。",
    "start": 507.296,
    "end": 512.336,
    "duration": 5.04
  },
  {
    "id": 117,
    "text": "其诗歌以写实见长，深刻记录了时代动荡与民间疾苦，",
    "start": 512.336,
    "end": 517.376,
    "duration": 5.04
  },
  {
    "id": 118,
    "text": "具备鲜明的“诗史”性质。",
    "start": 517.376,
    "end": 519.056,
    "duration": 1.68
  },
  {
    "id": 119,
    "text": "比如在《石壕吏》与《新安吏》等叙事名篇中，",
    "start": 519.296,
    "end": 522.576,
    "duration": 3.28
  },
  {
    "id": 120,
    "text": "杜甫通过客观冷静的细节白描与老妇自诉，",
    "start": 522.576,
    "end": 526.736,
    "duration": 4.16
  },
  {
    "id": 121,
    "text": "深刻揭露了战乱对平民家庭的残酷摧残，",
    "start": 526.736,
    "end": 530.336,
    "duration": 3.6
  },
  {
    "id": 122,
    "text": "叙事之中寄托着深沉的悲愤与同情，",
    "start": 530.336,
    "end": 533.616,
    "duration": 3.28
  },
  {
    "id": 123,
    "text": "形成了悲壮沉郁的美学风格。",
    "start": 533.616,
    "end": 536.176,
    "duration": 2.56
  },
  {
    "id": 124,
    "text": "四、第三维度：体裁选择与诗律建构分流内部咬合。",
    "start": 536.176,
    "end": 541.216,
    "duration": 5.04
  },
  {
    "id": 125,
    "text": "本段任务是落脚于文学形式本体，对比古体歌行与近体律诗在二人手中的不同成就。",
    "start": 541.456,
    "end": 548.656,
    "duration": 7.2
  },
  {
    "id": 126,
    "text": "-首先，段首给出统领分论点，具体表述到答题语句就是：第三，",
    "start": 548.952,
    "end": 553.842,
    "duration": 4.89
  },
  {
    "id": 127,
    "text": "在体裁选择与诗律建构上，李白醉心于古体诗与绝句的自由纵逸，",
    "start": 553.842,
    "end": 559.343,
    "duration": 5.501
  },
  {
    "id": 128,
    "text": "杜甫则在近体律诗的严整规范中实现了集大成的历史跨越。",
    "start": 559.343,
    "end": 564.437,
    "duration": 5.094
  },
  {
    "id": 129,
    "text": "随后，解析李白为什么偏爱古风乐府，",
    "start": 564.437,
    "end": 567.493,
    "duration": 3.056
  },
  {
    "id": 130,
    "text": "具体表述到答题语句就是：李白追求不受格律束缚的心灵自适，",
    "start": 567.493,
    "end": 572.791,
    "duration": 5.298
  },
  {
    "id": 131,
    "text": "其代表作大多集中于古风、乐府与七言绝句。，",
    "start": 572.791,
    "end": 576.458,
    "duration": 3.667
  },
  {
    "id": 132,
    "text": "并指明其句法机制：诗人在歌行体中大量运用长短错落的杂言句式与平仄互换，",
    "start": 576.458,
    "end": 583.182,
    "duration": 6.724
  },
  {
    "id": 133,
    "text": "如《宣州谢窕楼建别校书叔云》的开篇长句，",
    "start": 583.182,
    "end": 586.646,
    "duration": 3.464
  },
  {
    "id": 134,
    "text": "气势如奔马骤至。",
    "start": 586.646,
    "end": 588.072,
    "duration": 1.426
  },
  {
    "id": 135,
    "text": "-紧接着，深入论述杜甫对律诗的集大成贡献，",
    "start": 588.072,
    "end": 591.651,
    "duration": 3.579
  },
  {
    "id": 136,
    "text": "具体表述到答题语句就是：杜甫则致力于律诗规则的深密营构，",
    "start": 591.651,
    "end": 596.822,
    "duration": 5.171
  },
  {
    "id": 137,
    "text": "尤其在七言律诗的艺术探索上达到了前无古人的境界。",
    "start": 596.822,
    "end": 601.395,
    "duration": 4.573
  },
  {
    "id": 138,
    "text": "随后，点出杜甫在严整律法中容纳宏大意蕴的惊人技巧，",
    "start": 601.395,
    "end": 605.969,
    "duration": 4.574
  },
  {
    "id": 139,
    "text": "具体表述到答题语句就是：杜甫严格遵循平仄、",
    "start": 605.969,
    "end": 609.747,
    "duration": 3.778
  },
  {
    "id": 140,
    "text": "对仗与黏对规范，却能在森严法度之中自如驾驭极其复杂深沉的历史感慨。",
    "start": 609.747,
    "end": 615.912,
    "duration": 6.165
  },
  {
    "id": 141,
    "text": "-最后，调取《登高》作为压卷例证，",
    "start": 615.912,
    "end": 618.584,
    "duration": 2.672
  },
  {
    "id": 142,
    "text": "具体表述到答题语句就是：比如晚年名作《登高》全诗八句四联皆工整对仗，",
    "start": 618.584,
    "end": 625.265,
    "duration": 6.681
  },
  {
    "id": 143,
    "text": "以“无边落木萧萧下，不尽长江滚滚来”的雄阔对仗，",
    "start": 625.265,
    "end": 629.718,
    "duration": 4.453
  },
  {
    "id": 144,
    "text": "将壮阔时空与个人衰病身世浑然融为一体，",
    "start": 629.718,
    "end": 633.726,
    "duration": 4.008
  },
  {
    "id": 145,
    "text": "达到了声律和谐与气象万千的高度统一。",
    "start": 633.726,
    "end": 637.512,
    "duration": 3.786
  },
  {
    "id": 146,
    "text": "第三，在体裁选择与诗律建构上，李白醉心于古体诗与绝句的自由纵逸，",
    "start": 637.64,
    "end": 644.76,
    "duration": 7.12
  },
  {
    "id": 147,
    "text": "杜甫则在近体律诗的严整规范中实现了集大成的历史跨越。",
    "start": 644.76,
    "end": 649.96,
    "duration": 5.2
  },
  {
    "id": 148,
    "text": "李白追求不受格律束缚的心灵自适，",
    "start": 649.96,
    "end": 653.16,
    "duration": 3.2
  },
  {
    "id": 149,
    "text": "其代表作大多集中于古风、乐府与七言绝句。",
    "start": 653.16,
    "end": 657.32,
    "duration": 4.16
  },
  {
    "id": 150,
    "text": "诗人在歌行体中大量运用长短错落的杂言句式与平仄互换，",
    "start": 657.32,
    "end": 662.68,
    "duration": 5.36
  },
  {
    "id": 151,
    "text": "如《宣州谢窕楼建别校书叔云》的开篇长句，",
    "start": 662.68,
    "end": 667.0,
    "duration": 4.32
  },
  {
    "id": 152,
    "text": "气势如奔马骤至。",
    "start": 667.0,
    "end": 668.44,
    "duration": 1.44
  },
  {
    "id": 153,
    "text": "杜甫则致力于律诗规则的深密营构，",
    "start": 668.68,
    "end": 671.88,
    "duration": 3.2
  },
  {
    "id": 154,
    "text": "尤其在七言律诗的艺术探索上达到了前无古人的境界。",
    "start": 671.88,
    "end": 676.04,
    "duration": 4.16
  },
  {
    "id": 155,
    "text": "杜甫严格遵循平仄、对仗与黏对规范，",
    "start": 676.04,
    "end": 679.64,
    "duration": 3.6
  },
  {
    "id": 156,
    "text": "却能在森严法度之中自如驾驭极其复杂深沉的历史感慨。",
    "start": 679.64,
    "end": 684.52,
    "duration": 4.88
  },
  {
    "id": 157,
    "text": "比如晚年名作《登高》全诗八句四联皆工整对仗，",
    "start": 684.52,
    "end": 688.68,
    "duration": 4.16
  },
  {
    "id": 158,
    "text": "以“无边落木萧萧下，不尽长江滚滚来”的雄阔对仗，",
    "start": 688.68,
    "end": 693.64,
    "duration": 4.96
  },
  {
    "id": 159,
    "text": "将壮阔时空与个人衰病身世浑然融为一体，",
    "start": 693.64,
    "end": 697.64,
    "duration": 4.0
  },
  {
    "id": 160,
    "text": "达到了声律和谐与气象万千的高度统一。",
    "start": 697.64,
    "end": 701.24,
    "duration": 3.6
  },
  {
    "id": 161,
    "text": "五、结尾收束升华段内部咬合。",
    "start": 701.56,
    "end": 705.0,
    "duration": 3.44
  },
  {
    "id": 162,
    "text": "本段承担全篇论证成果的系统提炼与历史定位，",
    "start": 705.0,
    "end": 709.4,
    "duration": 4.4
  },
  {
    "id": 163,
    "text": "完成宏观历史论证闭环。",
    "start": 709.4,
    "end": 711.64,
    "duration": 2.24
  },
  {
    "id": 164,
    "text": "首先，全面回收李白的审美特质，具体表述到答题语句就是：综上所述，",
    "start": 711.64,
    "end": 717.72,
    "duration": 6.08
  },
  {
    "id": 165,
    "text": "李白以其豪迈奔放的天才神采，代表了盛唐昂扬向上、",
    "start": 717.72,
    "end": 722.44,
    "duration": 4.72
  },
  {
    "id": 166,
    "text": "追求自由的精神高峰。",
    "start": 722.44,
    "end": 723.8,
    "duration": 1.36
  },
  {
    "id": 167,
    "text": "-紧接着，回收杜甫的沉郁特质，具体表述到答题语句就是：杜甫以其沉雄沉郁的博大胸襟与精严诗律，",
    "start": 724.04,
    "end": 732.227,
    "duration": 8.187
  },
  {
    "id": 168,
    "text": "代表了盛唐深沉博大、关怀现实的最高典范。",
    "start": 732.227,
    "end": 735.822,
    "duration": 3.595
  },
  {
    "id": 169,
    "text": "最后，将两者合流收束在后世影响上，",
    "start": 735.822,
    "end": 738.817,
    "duration": 2.995
  },
  {
    "id": 170,
    "text": "具体表述到答题语句就是：李杜双峰并峙，",
    "start": 738.817,
    "end": 742.212,
    "duration": 3.395
  },
  {
    "id": 171,
    "text": "互为表里，共同确立了盛唐气象的博大审美疆域，",
    "start": 742.212,
    "end": 746.206,
    "duration": 3.994
  },
  {
    "id": 172,
    "text": "对后世诗歌创作产生了深远而持久的典范影响。",
    "start": 746.206,
    "end": 750.2,
    "duration": 3.994
  },
  {
    "id": 173,
    "text": "综上所述，李白以其豪迈奔放的天才神采，",
    "start": 750.28,
    "end": 754.12,
    "duration": 3.84
  },
  {
    "id": 174,
    "text": "代表了盛唐昂扬向上、追求自由的精神高峰。",
    "start": 754.12,
    "end": 757.96,
    "duration": 3.84
  },
  {
    "id": 175,
    "text": "杜甫以其沉雄沉郁的博大胸襟与精严诗律，",
    "start": 757.96,
    "end": 761.96,
    "duration": 4.0
  },
  {
    "id": 176,
    "text": "代表了盛唐深沉博大、关怀现实的最高典范。",
    "start": 761.96,
    "end": 765.88,
    "duration": 3.92
  },
  {
    "id": 177,
    "text": "李杜双峰并峙，互为表里，共同确立了盛唐气象的博大审美疆域，",
    "start": 765.88,
    "end": 771.4,
    "duration": 5.52
  },
  {
    "id": 178,
    "text": "对后世诗歌创作产生了深远而持久的典范影响。",
    "start": 771.4,
    "end": 775.32,
    "duration": 3.92
  }
]