[
  {
    "id": 1,
    "text": "全局宏观破题与立论逻辑。",
    "start": 0.16,
    "end": 2.64,
    "duration": 2.48
  },
  {
    "id": 2,
    "text": "在考场下笔之前，必须先在宏观上审清这道三十分大题的核心考核意图。",
    "start": 2.64,
    "end": 8.24,
    "duration": 5.6
  },
  {
    "id": 3,
    "text": "本题表面上考查史记的写人技巧与互见法，",
    "start": 8.24,
    "end": 11.68,
    "duration": 3.44
  },
  {
    "id": 4,
    "text": "本质上考查中国古代纪传体传记文学的建构机制。",
    "start": 11.68,
    "end": 15.6,
    "duration": 3.92
  },
  {
    "id": 5,
    "text": "考场评分标准绝不满足于仅孤立解释互见法的定义。",
    "start": 15.6,
    "end": 19.6,
    "duration": 4.0
  },
  {
    "id": 6,
    "text": "答题方向必须确立为“从整体篇章的互见结构，",
    "start": 19.84,
    "end": 23.84,
    "duration": 4.0
  },
  {
    "id": 7,
    "text": "推进到典型冲突场面，再深入到微观言语细节，",
    "start": 23.84,
    "end": 28.0,
    "duration": 4.16
  },
  {
    "id": 8,
    "text": "最终升华到作者主体精神情感”的逻辑纵深。",
    "start": 28.0,
    "end": 31.68,
    "duration": 3.68
  },
  {
    "id": 9,
    "text": "整道大题在宏观上划分为五个有机递进的逻辑层次：第一层，",
    "start": 31.68,
    "end": 36.56,
    "duration": 4.88
  },
  {
    "id": 10,
    "text": "开篇破题，交代《史记》的文学史坐标、",
    "start": 36.56,
    "end": 39.68,
    "duration": 3.12
  },
  {
    "id": 11,
    "text": "鲁迅定评与传记文学最高典范地位。",
    "start": 39.68,
    "end": 42.4,
    "duration": 2.72
  },
  {
    "id": 12,
    "text": "第二层，论述篇章层面的互见法，说明司马迁如何通过多篇互见打破脸谱化，",
    "start": 42.64,
    "end": 49.36,
    "duration": 6.72
  },
  {
    "id": 13,
    "text": "呈现真实立体人性。",
    "start": 49.36,
    "end": 51.28,
    "duration": 1.92
  },
  {
    "id": 14,
    "text": "第三层，论述宏观场面层面的戏剧化冲突，",
    "start": 51.28,
    "end": 55.12,
    "duration": 3.84
  },
  {
    "id": 15,
    "text": "说明如何在生死攸关的重大关头让性格外化。",
    "start": 55.12,
    "end": 58.96,
    "duration": 3.84
  },
  {
    "id": 16,
    "text": "第四层，落地至微观语言与细节，说明个性化言语与传神白描如何实现以形传神。",
    "start": 58.96,
    "end": 66.16,
    "duration": 7.2
  },
  {
    "id": 17,
    "text": "第五层，升华为史家的主体精神，阐释发愤著书、",
    "start": 66.48,
    "end": 70.8,
    "duration": 4.32
  },
  {
    "id": 18,
    "text": "不以成败论英雄与悲剧崇高感。",
    "start": 70.8,
    "end": 73.68,
    "duration": 2.88
  },
  {
    "id": 19,
    "text": "尾部收官，将结论放回文学史谱系，",
    "start": 73.68,
    "end": 76.72,
    "duration": 3.04
  },
  {
    "id": 20,
    "text": "交代其对后世正史修撰与戏剧小说的深远哺育。",
    "start": 76.72,
    "end": 80.96,
    "duration": 4.24
  },
  {
    "id": 21,
    "text": "这五个层次构成一条不可逆的因果链条：互见法是结构框架，",
    "start": 80.96,
    "end": 86.08,
    "duration": 5.12
  },
  {
    "id": 22,
    "text": "典型场面是舞台，细节语言是血肉，",
    "start": 86.08,
    "end": 89.28,
    "duration": 3.2
  },
  {
    "id": 23,
    "text": "发愤著书是灵魂，后世流变是最终定型。",
    "start": 89.28,
    "end": 92.8,
    "duration": 3.52
  },
  {
    "id": 24,
    "text": "理顺了宏观全局思路，接下来进入每一段的具体推导与逐句表述。",
    "start": 93.12,
    "end": 98.24,
    "duration": 5.12
  },
  {
    "id": 25,
    "text": "--。第",
    "start": 98.24,
    "end": 98.4,
    "duration": 0.16
  },
  {
    "id": 26,
    "text": "一段：首段破题与概念定性。",
    "start": 98.4,
    "end": 101.04,
    "duration": 2.64
  },
  {
    "id": 27,
    "text": "逐句因果推导与答题表述。",
    "start": 101.04,
    "end": 103.44,
    "duration": 2.4
  },
  {
    "id": 28,
    "text": "首句必须直击核心体裁，交代其划时代的历史地位。",
    "start": 103.44,
    "end": 107.84,
    "duration": 4.4
  },
  {
    "id": 29,
    "text": "所以表述为：《史记》是中国古代文学史上第一部纪传体通史。",
    "start": 107.84,
    "end": 112.48,
    "duration": 4.64
  },
  {
    "id": 30,
    "text": "次句紧承首句引用中国文学评论史最具分量的最高定评。",
    "start": 112.8,
    "end": 117.76,
    "duration": 4.96
  },
  {
    "id": 31,
    "text": "所以表述为：鲁迅在《汉文学史纲要》中盛赞其为“史家之绝唱，",
    "start": 117.76,
    "end": 122.706,
    "duration": 4.946
  },
  {
    "id": 32,
    "text": "无韵之离骚”。",
    "start": 122.706,
    "end": 123.729,
    "duration": 1.023
  },
  {
    "id": 33,
    "text": "第三句引入考研主教材权威定义，确立其在传记文学中的典范地位。",
    "start": 123.729,
    "end": 129.457,
    "duration": 5.728
  },
  {
    "id": 34,
    "text": "所以表述为：袁行配《中国文学史》将其界定为中国古代传记文学的最高典范。",
    "start": 129.457,
    "end": 136.0,
    "duration": 6.543
  },
  {
    "id": 35,
    "text": "第四句指出其体制变革的核心，说明纪传体以人物为中心开创了宏伟画廊。",
    "start": 136.0,
    "end": 142.4,
    "duration": 6.4
  },
  {
    "id": 36,
    "text": "所以表述为：司马迁开创了以人物为中心的修史体制，",
    "start": 142.4,
    "end": 147.424,
    "duration": 5.024
  },
  {
    "id": 37,
    "text": "构建起辉煌壮丽的人物画廊。",
    "start": 147.424,
    "end": 150.064,
    "duration": 2.64
  },
  {
    "id": 38,
    "text": "第五句作为首段过渡句，宣告下文将从四个核心维度展开系统论述。",
    "start": 150.064,
    "end": 156.064,
    "duration": 6.0
  },
  {
    "id": 39,
    "text": "所以表述为：其卓越的人物塑造艺术与纪传体笔法，",
    "start": 156.064,
    "end": 160.784,
    "duration": 4.72
  },
  {
    "id": 40,
    "text": "主要体现在以下四个核心维度：本段答题思路总结。",
    "start": 160.784,
    "end": 164.784,
    "duration": 4.0
  },
  {
    "id": 41,
    "text": "本段用五句话完成首段破题：先以纪传体通史之祖立论，",
    "start": 164.784,
    "end": 169.424,
    "duration": 4.64
  },
  {
    "id": 42,
    "text": "迅速调取引证鲁迅“史家绝唱、无韵离骚”的千古定评；",
    "start": 169.424,
    "end": 173.744,
    "duration": 4.32
  },
  {
    "id": 43,
    "text": "随即以袁行配教材将《史记》定型为传记文学最高典范；",
    "start": 173.744,
    "end": 178.144,
    "duration": 4.4
  },
  {
    "id": 44,
    "text": "最后交代其以人为中心的体制特点并顺畅引出四个分论点，",
    "start": 178.144,
    "end": 183.024,
    "duration": 4.88
  },
  {
    "id": 45,
    "text": "开篇沉稳开阔。",
    "start": 183.024,
    "end": 184.224,
    "duration": 1.2
  },
  {
    "id": 46,
    "text": "所以本段具体答题完整版为：《史记》是中国古代文学史上第一部纪传体通史。",
    "start": 184.544,
    "end": 190.864,
    "duration": 6.32
  },
  {
    "id": 47,
    "text": "鲁迅在《汉文学史纲要》中盛赞其为“史家之绝唱，",
    "start": 190.864,
    "end": 195.664,
    "duration": 4.8
  },
  {
    "id": 48,
    "text": "无韵之离骚”。",
    "start": 195.664,
    "end": 197.024,
    "duration": 1.36
  },
  {
    "id": 49,
    "text": "袁行配《中国文学史》将其界定为中国古代传记文学的最高典范。",
    "start": 197.024,
    "end": 201.984,
    "duration": 4.96
  },
  {
    "id": 50,
    "text": "司马迁开创了以人物为中心的修史体制，",
    "start": 202.304,
    "end": 205.904,
    "duration": 3.6
  },
  {
    "id": 51,
    "text": "构建起辉煌壮丽的人物画廊。",
    "start": 205.904,
    "end": 208.464,
    "duration": 2.56
  },
  {
    "id": 52,
    "text": "其卓越的人物塑造艺术与纪传体笔法，",
    "start": 208.464,
    "end": 211.824,
    "duration": 3.36
  },
  {
    "id": 53,
    "text": "主要体现在以下四个核心维度：。",
    "start": 211.824,
    "end": 214.704,
    "duration": 2.88
  },
  {
    "id": 54,
    "text": "第二段：第一分论点，篇章结构的“互见法”（构之“妙”）。",
    "start": 214.704,
    "end": 218.864,
    "duration": 4.16
  },
  {
    "id": 55,
    "text": "逐句因果推导与答题表述。",
    "start": 218.864,
    "end": 221.184,
    "duration": 2.32
  },
  {
    "id": 56,
    "text": "题干直接包含了互见法，因此第一分论点必须优先攻克这一核心结构笔法。",
    "start": 221.504,
    "end": 227.584,
    "duration": 6.08
  },
  {
    "id": 57,
    "text": "首句确立分论点，指出互见法是司马迁在纪传体体制下的独创艺术手段。",
    "start": 227.584,
    "end": 233.504,
    "duration": 5.92
  },
  {
    "id": 58,
    "text": "所以表述为：“互见法”是司马迁在纪传体体制下首创的卓越人物塑造技巧。",
    "start": 233.504,
    "end": 239.344,
    "duration": 5.84
  },
  {
    "id": 59,
    "text": "次句严格界定互见法的具体操作机制，",
    "start": 239.744,
    "end": 242.624,
    "duration": 2.88
  },
  {
    "id": 60,
    "text": "说明主传与他传的合理分工。",
    "start": 242.624,
    "end": 244.944,
    "duration": 2.32
  },
  {
    "id": 61,
    "text": "所以表述为：所谓互见法，即在某人主传中突出其主导性格，",
    "start": 244.944,
    "end": 249.984,
    "duration": 5.04
  },
  {
    "id": 62,
    "text": "而将其不同甚至矛盾的侧面写入相关他人的传记。",
    "start": 249.984,
    "end": 253.984,
    "duration": 4.0
  },
  {
    "id": 63,
    "text": "第三句指出这种机制的审美效果，既避免了主线杂乱，",
    "start": 253.984,
    "end": 257.904,
    "duration": 3.92
  },
  {
    "id": 64,
    "text": "又展现了人性的多维真实。",
    "start": 257.904,
    "end": 259.744,
    "duration": 1.84
  },
  {
    "id": 65,
    "text": "所以表述为：这种笔法避免了主传叙事的杂乱，",
    "start": 260.144,
    "end": 264.264,
    "duration": 4.12
  },
  {
    "id": 66,
    "text": "同时展现了人性的立体多面与历史的深层复杂。",
    "start": 264.264,
    "end": 268.664,
    "duration": 4.4
  },
  {
    "id": 67,
    "text": "第四句调取开国皇帝刘邦作为第一核心样本，",
    "start": 268.664,
    "end": 272.844,
    "duration": 4.18
  },
  {
    "id": 68,
    "text": "指出主传中的雄才大略。",
    "start": 272.844,
    "end": 275.044,
    "duration": 2.2
  },
  {
    "id": 69,
    "text": "所以表述为：在刻画汉高祖刘邦时，",
    "start": 275.044,
    "end": 278.124,
    "duration": 3.08
  },
  {
    "id": 70,
    "text": "司马迁在《高祖本纪》中主要突出其知人善任、",
    "start": 278.124,
    "end": 282.084,
    "duration": 3.96
  },
  {
    "id": 71,
    "text": "豁达大度的帝王雄略。",
    "start": 282.084,
    "end": 284.064,
    "duration": 1.98
  },
  {
    "id": 72,
    "text": "第五句翻出他传中的反差记录，指出其狡诈阴暗面的补充。",
    "start": 284.144,
    "end": 288.624,
    "duration": 4.48
  },
  {
    "id": 73,
    "text": "所以表述为：然而在《项羽本纪》与《淮阴侯列传》中，",
    "start": 288.624,
    "end": 292.84,
    "duration": 4.216
  },
  {
    "id": 74,
    "text": "却补叙其无赖贪婪、背信弃义与屠戮功臣的阴暗面。",
    "start": 292.84,
    "end": 297.64,
    "duration": 4.8
  },
  {
    "id": 75,
    "text": "第六句调取名将李广作为第二核心样本，",
    "start": 297.64,
    "end": 301.24,
    "duration": 3.6
  },
  {
    "id": 76,
    "text": "指出主传中勇武爱卒的正面特征。",
    "start": 301.24,
    "end": 304.44,
    "duration": 3.2
  },
  {
    "id": 77,
    "text": "所以表述为：在刻画名将李广时，《李将军列传》极写其勇武消捷、",
    "start": 304.44,
    "end": 310.6,
    "duration": 6.16
  },
  {
    "id": 78,
    "text": "爱护士卒的天赋神勇。",
    "start": 310.6,
    "end": 312.44,
    "duration": 1.84
  },
  {
    "id": 79,
    "text": "第七句结合卫将军传记，补入其杀降霸陵尉与部伍散漫的负面细节。",
    "start": 312.68,
    "end": 319.222,
    "duration": 6.542
  },
  {
    "id": 80,
    "text": "所以表述为：而在《卫将军骠骑列传》中，",
    "start": 319.222,
    "end": 322.526,
    "duration": 3.304
  },
  {
    "id": 81,
    "text": "又直笔载入其杀降霸陵尉与部伍散漫的偏狭行径。",
    "start": 322.526,
    "end": 327.152,
    "duration": 4.626
  },
  {
    "id": 82,
    "text": "第八句总结收束全段，指出互见法彻底打破了脸谱化，",
    "start": 327.152,
    "end": 331.997,
    "duration": 4.845
  },
  {
    "id": 83,
    "text": "呈现出血肉丰满的活人。",
    "start": 331.997,
    "end": 334.2,
    "duration": 2.203
  },
  {
    "id": 84,
    "text": "所以表述为：互见法的精妙运用，彻底打破了脸谱化与扁平化，",
    "start": 334.36,
    "end": 339.56,
    "duration": 5.2
  },
  {
    "id": 85,
    "text": "真实还原了血肉丰满的活人。",
    "start": 339.56,
    "end": 341.88,
    "duration": 2.32
  },
  {
    "id": 86,
    "text": "本段答题思路总结。",
    "start": 341.88,
    "end": 343.56,
    "duration": 1.68
  },
  {
    "id": 87,
    "text": "本段是本题最具区分度的技术硬核：首先给出了互见法精准清晰的机制定义；",
    "start": 343.56,
    "end": 349.72,
    "duration": 6.16
  },
  {
    "id": 88,
    "text": "紧接着调取“刘邦”与“李广”两大最具代表性的教材铁证；",
    "start": 349.72,
    "end": 353.96,
    "duration": 4.24
  },
  {
    "id": 89,
    "text": "通过《高祖本纪》与《项羽本纪》、",
    "start": 354.2,
    "end": 356.76,
    "duration": 2.56
  },
  {
    "id": 90,
    "text": "《李将军列传》与《卫将军列传》的前后互见对照，",
    "start": 356.76,
    "end": 360.52,
    "duration": 3.76
  },
  {
    "id": 91,
    "text": "透辟阐明主传立干、他传见枝的艺术奥妙，",
    "start": 360.52,
    "end": 364.68,
    "duration": 4.16
  },
  {
    "id": 92,
    "text": "彻底论证了其塑造立体复杂人物的机制。",
    "start": 364.68,
    "end": 367.88,
    "duration": 3.2
  },
  {
    "id": 93,
    "text": "所以本段具体答题完整版为：一、篇章结构的“互见法”：多维立体呈现人物性格的复杂本真。",
    "start": 367.88,
    "end": 375.08,
    "duration": 7.2
  },
  {
    "id": 94,
    "text": "“互见法”是司马迁在纪传体体制下首创的卓越人物塑造技巧。",
    "start": 375.32,
    "end": 380.754,
    "duration": 5.434
  },
  {
    "id": 95,
    "text": "所谓互见法，即在某人主传中突出其主导性格，",
    "start": 380.754,
    "end": 384.884,
    "duration": 4.13
  },
  {
    "id": 96,
    "text": "而将其不同甚至矛盾的侧面写入相关他人的传记。",
    "start": 384.884,
    "end": 389.449,
    "duration": 4.565
  },
  {
    "id": 97,
    "text": "这种笔法避免了主传叙事的杂乱，同时展现了人性的立体多面与历史的深层复杂。",
    "start": 389.449,
    "end": 396.84,
    "duration": 7.391
  },
  {
    "id": 98,
    "text": "在刻画汉高祖刘邦时，司马迁在《高祖本纪》中主要突出其知人善任、",
    "start": 397.0,
    "end": 402.84,
    "duration": 5.84
  },
  {
    "id": 99,
    "text": "豁达大度的帝王雄略。",
    "start": 402.84,
    "end": 404.84,
    "duration": 2.0
  },
  {
    "id": 100,
    "text": "然而在《项羽本纪》与《淮阴侯列传》中，",
    "start": 404.84,
    "end": 407.88,
    "duration": 3.04
  },
  {
    "id": 101,
    "text": "却补叙其无赖贪婪、背信弃义与屠戮功臣的阴暗面。",
    "start": 407.88,
    "end": 412.68,
    "duration": 4.8
  },
  {
    "id": 102,
    "text": "在刻画名将李广时，《李将军列传》极写其勇武消捷、",
    "start": 412.68,
    "end": 417.48,
    "duration": 4.8
  },
  {
    "id": 103,
    "text": "爱护士卒的天赋神勇。",
    "start": 417.48,
    "end": 419.08,
    "duration": 1.6
  },
  {
    "id": 104,
    "text": "而在《卫将军骠骑列传》中，又直笔载入其杀降霸陵尉与部伍散漫的偏狭行径。",
    "start": 419.32,
    "end": 426.68,
    "duration": 7.36
  },
  {
    "id": 105,
    "text": "互见法的精妙运用，彻底打破了脸谱化与扁平化，",
    "start": 426.68,
    "end": 431.0,
    "duration": 4.32
  },
  {
    "id": 106,
    "text": "真实还原了血肉丰满的活人。。",
    "start": 431.0,
    "end": 433.48,
    "duration": 2.48
  },
  {
    "id": 107,
    "text": "第三段：第二分论点，典型场面的戏剧化冲突（境之“烈”）。",
    "start": 433.48,
    "end": 438.2,
    "duration": 4.72
  },
  {
    "id": 108,
    "text": "逐句因果推导与答题表述。",
    "start": 438.584,
    "end": 440.984,
    "duration": 2.4
  },
  {
    "id": 109,
    "text": "第二段解决了篇章结构的分工，第三段必须回答人物是在怎样的具体情境中立起来的。",
    "start": 440.984,
    "end": 447.544,
    "duration": 6.56
  },
  {
    "id": 110,
    "text": "首句确立分论点，指出司马迁善于选取重大关头，",
    "start": 447.544,
    "end": 451.544,
    "duration": 4.0
  },
  {
    "id": 111,
    "text": "将人物置于尖锐的戏剧化冲突中。",
    "start": 451.544,
    "end": 454.264,
    "duration": 2.72
  },
  {
    "id": 112,
    "text": "所以表述为：司马迁善于选取历史风云激荡的关键转折点，",
    "start": 454.264,
    "end": 459.064,
    "duration": 4.8
  },
  {
    "id": 113,
    "text": "将人物置于尖锐的戏剧化冲突中展开刻画。",
    "start": 459.064,
    "end": 462.264,
    "duration": 3.2
  },
  {
    "id": 114,
    "text": "次句推导因果，说明在生死存亡的严酷考验下，",
    "start": 462.664,
    "end": 466.664,
    "duration": 4.0
  },
  {
    "id": 115,
    "text": "人物性格必然会充分暴露外化。",
    "start": 466.664,
    "end": 469.464,
    "duration": 2.8
  },
  {
    "id": 116,
    "text": "所以表述为：他通过生死攸关的重大场景，",
    "start": 469.464,
    "end": 473.096,
    "duration": 3.632
  },
  {
    "id": 117,
    "text": "让人物在剧烈对峙中充分外化其性格特质。",
    "start": 473.096,
    "end": 476.912,
    "duration": 3.816
  },
  {
    "id": 118,
    "text": "第三句调取全书最具戏剧性与张力的第一名场面。",
    "start": 476.912,
    "end": 481.364,
    "duration": 4.452
  },
  {
    "id": 119,
    "text": "所以表述为：这一艺术手法的最高范式，",
    "start": 481.364,
    "end": 484.504,
    "duration": 3.14
  },
  {
    "id": 120,
    "text": "当属《项羽本纪》中的“鸿门宴”。",
    "start": 484.504,
    "end": 486.744,
    "duration": 2.24
  },
  {
    "id": 121,
    "text": "第四句剖析鸿门宴的环境特征，短短片刻汇聚了最高强度的生死对决。",
    "start": 486.744,
    "end": 492.504,
    "duration": 5.76
  },
  {
    "id": 122,
    "text": "所以表述为：在短短一个宴席之间，",
    "start": 492.504,
    "end": 495.304,
    "duration": 2.8
  },
  {
    "id": 123,
    "text": "各方势力的生死搏杀与权谋机变被推向了极限。",
    "start": 495.304,
    "end": 499.624,
    "duration": 4.32
  },
  {
    "id": 124,
    "text": "第五句分析群像在冲突中的个性呈现，",
    "start": 499.864,
    "end": 503.144,
    "duration": 3.28
  },
  {
    "id": 125,
    "text": "各方性格在对峙中自然显现。",
    "start": 503.144,
    "end": 505.704,
    "duration": 2.56
  },
  {
    "id": 126,
    "text": "所以表述为：项羽的刚愎自负、刘邦的隐忍圆滑、",
    "start": 505.704,
    "end": 509.784,
    "duration": 4.08
  },
  {
    "id": 127,
    "text": "范增的焦躁毒辣、张良的从容沉着，",
    "start": 509.784,
    "end": 513.384,
    "duration": 3.6
  },
  {
    "id": 128,
    "text": "皆在剑拔弩张中展现无遗。",
    "start": 513.384,
    "end": 515.944,
    "duration": 2.56
  },
  {
    "id": 129,
    "text": "第六句引入第二篇巨作《廉颇赁相如列传》，",
    "start": 515.944,
    "end": 519.624,
    "duration": 3.68
  },
  {
    "id": 130,
    "text": "列出其著名的三大典型场面。",
    "start": 519.624,
    "end": 521.704,
    "duration": 2.08
  },
  {
    "id": 131,
    "text": "所以表述为：又如《廉颇赁相如列传》串联起完璧归赵、",
    "start": 522.104,
    "end": 526.459,
    "duration": 4.355
  },
  {
    "id": 132,
    "text": "渑池之会与负荆请罪三大高潮场面。",
    "start": 526.459,
    "end": 529.605,
    "duration": 3.146
  },
  {
    "id": 133,
    "text": "第七句总结收束全段，指出外战内斗的多重冲突充分凸显了将相的性情风采。",
    "start": 529.605,
    "end": 536.317,
    "duration": 6.712
  },
  {
    "id": 134,
    "text": "所以表述为：在国家存亡的外交风暴与将相内部的矛盾激化中，",
    "start": 536.317,
    "end": 541.771,
    "duration": 5.454
  },
  {
    "id": 135,
    "text": "赁相如的大智大勇与廉颇的磊落坦荡得到了淋漓尽致的呈现。",
    "start": 541.771,
    "end": 547.224,
    "duration": 5.453
  },
  {
    "id": 136,
    "text": "本段答题思路总结。",
    "start": 547.304,
    "end": 548.824,
    "duration": 1.52
  },
  {
    "id": 137,
    "text": "本段聚焦于戏剧化场面的组织功力：先确立以重大生死冲突展现性格的原则；",
    "start": 548.824,
    "end": 555.144,
    "duration": 6.32
  },
  {
    "id": 138,
    "text": "随即深度剖析“鸿门宴”上项羽、刘邦、",
    "start": 555.144,
    "end": 558.344,
    "duration": 3.2
  },
  {
    "id": 139,
    "text": "范增、张良在剑拔弩张中的各异表现；",
    "start": 558.344,
    "end": 561.944,
    "duration": 3.6
  },
  {
    "id": 140,
    "text": "随后以《廉颇赁相如列传》的三大场面为佐证，",
    "start": 561.944,
    "end": 565.544,
    "duration": 3.6
  },
  {
    "id": 141,
    "text": "论证了司马迁如何将干燥的历史纪事营造成惊心动魄、",
    "start": 565.544,
    "end": 570.184,
    "duration": 4.64
  },
  {
    "id": 142,
    "text": "性情毕现的戏剧化巅峰。",
    "start": 570.184,
    "end": 572.184,
    "duration": 2.0
  },
  {
    "id": 143,
    "text": "所以本段具体答题完整版为：二、典型场面的戏剧化冲突：在重大历史关头彰显人物性情。",
    "start": 572.504,
    "end": 580.424,
    "duration": 7.92
  },
  {
    "id": 144,
    "text": "司马迁善于选取历史风云激荡的关键转折点，",
    "start": 580.424,
    "end": 583.944,
    "duration": 3.52
  },
  {
    "id": 145,
    "text": "将人物置于尖锐的戏剧化冲突中展开刻画。",
    "start": 583.944,
    "end": 587.224,
    "duration": 3.28
  },
  {
    "id": 146,
    "text": "他通过生死攸关的重大场景，让人物在剧烈对峙中充分外化其性格特质。",
    "start": 587.528,
    "end": 593.608,
    "duration": 6.08
  },
  {
    "id": 147,
    "text": "这一艺术手法的最高范式，当属《项羽本纪》中的“鸿门宴”。",
    "start": 593.608,
    "end": 598.008,
    "duration": 4.4
  },
  {
    "id": 148,
    "text": "在短短一个宴席之间，各方势力的生死搏杀与权谋机变被推向了极限。",
    "start": 598.008,
    "end": 604.168,
    "duration": 6.16
  },
  {
    "id": 149,
    "text": "项羽的刚愎自负、刘邦的隐忍圆滑、",
    "start": 604.168,
    "end": 607.208,
    "duration": 3.04
  },
  {
    "id": 150,
    "text": "范增的焦躁毒辣、张良的从容沉着，",
    "start": 607.208,
    "end": 610.408,
    "duration": 3.2
  },
  {
    "id": 151,
    "text": "皆在剑拔弩张中展现无遗。",
    "start": 610.408,
    "end": 612.728,
    "duration": 2.32
  },
  {
    "id": 152,
    "text": "又如《廉颇赁相如列传》串联起完璧归赵、",
    "start": 612.888,
    "end": 616.808,
    "duration": 3.92
  },
  {
    "id": 153,
    "text": "渑池之会与负荆请罪三大高潮场面。",
    "start": 616.808,
    "end": 620.488,
    "duration": 3.68
  },
  {
    "id": 154,
    "text": "在国家存亡的外交风暴与将相内部的矛盾激化中，",
    "start": 620.488,
    "end": 624.488,
    "duration": 4.0
  },
  {
    "id": 155,
    "text": "赁相如的大智大勇与廉颇的磊落坦荡得到了淋漓尽致的呈现。。",
    "start": 624.488,
    "end": 630.088,
    "duration": 5.6
  },
  {
    "id": 156,
    "text": "第四段：第三分论点，传神细节与个性化言行（微之“精”）。",
    "start": 630.088,
    "end": 635.128,
    "duration": 5.04
  },
  {
    "id": 157,
    "text": "逐句因果推导与答题表述。",
    "start": 635.368,
    "end": 637.928,
    "duration": 2.56
  },
  {
    "id": 158,
    "text": "大场面构建完毕之后，第四段必须下沉到人物言语与动作神态的微观刻画。",
    "start": 637.928,
    "end": 645.048,
    "duration": 7.12
  },
  {
    "id": 159,
    "text": "首句立论，指出司马迁精于白描，极善于抓取富于个性特征的言谈与细节。",
    "start": 645.048,
    "end": 652.008,
    "duration": 6.96
  },
  {
    "id": 160,
    "text": "所以表述为：司马迁在刻画人物时精于白描技法，",
    "start": 652.008,
    "end": 656.248,
    "duration": 4.24
  },
  {
    "id": 161,
    "text": "极善于抓取富于个性特征的言谈与典型细节。",
    "start": 656.248,
    "end": 660.248,
    "duration": 4.0
  },
  {
    "id": 162,
    "text": "次句指出其语言特点，做到深安阶层风味、",
    "start": 660.488,
    "end": 664.008,
    "duration": 3.52
  },
  {
    "id": 163,
    "text": "言如其人。",
    "start": 664.008,
    "end": 665.208,
    "duration": 1.2
  },
  {
    "id": 164,
    "text": "所以表述为：他深安不同阶层、不同性格人物的语言风味，",
    "start": 665.208,
    "end": 670.088,
    "duration": 4.88
  },
  {
    "id": 165,
    "text": "做到言如其人、神采毕现。",
    "start": 670.088,
    "end": 672.728,
    "duration": 2.64
  },
  {
    "id": 166,
    "text": "第三句调取项羽面对始皇出巡时的狂傲狂言。",
    "start": 672.728,
    "end": 676.968,
    "duration": 4.24
  },
  {
    "id": 167,
    "text": "所以表述为：在面对秦始皇浩荡出巡时，",
    "start": 676.968,
    "end": 680.808,
    "duration": 3.84
  },
  {
    "id": 168,
    "text": "项羽脱口而出：“彼可取而代也”，",
    "start": 680.808,
    "end": 683.688,
    "duration": 2.88
  },
  {
    "id": 169,
    "text": "尽显楚霸王豪迈拔山的狂傲霸气。",
    "start": 683.688,
    "end": 686.808,
    "duration": 3.12
  },
  {
    "id": 170,
    "text": "第四句并置刘邦面对同一场面时的感叹，",
    "start": 687.048,
    "end": 690.328,
    "duration": 3.28
  },
  {
    "id": 171,
    "text": "形成绝妙对照。",
    "start": 690.328,
    "end": 691.448,
    "duration": 1.12
  },
  {
    "id": 172,
    "text": "所以表述为：而刘邦见之则悄然叹曰：“嗟乎，",
    "start": 691.448,
    "end": 695.368,
    "duration": 3.92
  },
  {
    "id": 173,
    "text": "大丈夫当如此也”，尽显市井豪徒的艳羡狡黠与深沉野心。",
    "start": 695.368,
    "end": 700.408,
    "duration": 5.04
  },
  {
    "id": 174,
    "text": "第五句对这两句对话展开深入点评，",
    "start": 700.408,
    "end": 703.208,
    "duration": 2.8
  },
  {
    "id": 175,
    "text": "指出其揭示了二人性格与政治结局的本质根源。",
    "start": 703.208,
    "end": 706.568,
    "duration": 3.36
  },
  {
    "id": 176,
    "text": "所以表述为：两句对话形成鲜明对照，",
    "start": 706.888,
    "end": 710.568,
    "duration": 3.68
  },
  {
    "id": 177,
    "text": "深刻揭示了两位历史消雄迥异的性格与政治格局。",
    "start": 710.568,
    "end": 715.448,
    "duration": 4.88
  },
  {
    "id": 178,
    "text": "第六句转入动作神态细节，调取项羽垓下之围与赠头故人的悲壮细节。",
    "start": 715.448,
    "end": 722.008,
    "duration": 6.56
  },
  {
    "id": 179,
    "text": "所以表述为：在细节捕捉上，垓下重围时项羽慷慨悲歌泣下数行，",
    "start": 722.008,
    "end": 728.168,
    "duration": 6.16
  },
  {
    "id": 180,
    "text": "乌江自刎前赠头故人吕马童。",
    "start": 728.168,
    "end": 730.808,
    "duration": 2.64
  },
  {
    "id": 181,
    "text": "第七句对调刘邦在鸿门宴借口如厕脱逃、",
    "start": 731.128,
    "end": 734.808,
    "duration": 3.68
  },
  {
    "id": 182,
    "text": "中箭后按足自保的传神细节。",
    "start": 734.808,
    "end": 737.528,
    "duration": 2.72
  },
  {
    "id": 183,
    "text": "所以表述为：刘邦在鸿门宴借口如厕仓皇脱逃，",
    "start": 737.528,
    "end": 741.736,
    "duration": 4.208
  },
  {
    "id": 184,
    "text": "被项羽射中胸口却俯身按足高呼“虏中吾指”。",
    "start": 741.736,
    "end": 745.736,
    "duration": 4.0
  },
  {
    "id": 185,
    "text": "第八句总结收束全段，指出这些传神细节让历史人物跃然纸上、",
    "start": 745.736,
    "end": 750.936,
    "duration": 5.2
  },
  {
    "id": 186,
    "text": "宛如眼前。",
    "start": 750.936,
    "end": 752.056,
    "duration": 1.12
  },
  {
    "id": 187,
    "text": "所以表述为：这些极具戏剧感的传神细节，",
    "start": 752.056,
    "end": 755.576,
    "duration": 3.52
  },
  {
    "id": 188,
    "text": "使两千年前的历史人物如在眼前、历历在目。",
    "start": 755.576,
    "end": 759.176,
    "duration": 3.6
  },
  {
    "id": 189,
    "text": "本段答题思路总结。",
    "start": 759.416,
    "end": 760.936,
    "duration": 1.52
  },
  {
    "id": 190,
    "text": "本段展现了教科书级的微观文本剖析：通过项羽“彼可取而代也”与刘邦“大丈夫当如此也”的一语定性对比，",
    "start": 760.936,
    "end": 770.136,
    "duration": 9.2
  },
  {
    "id": 191,
    "text": "揭示二人精神风貌的天壤之别；",
    "start": 770.136,
    "end": 772.616,
    "duration": 2.48
  },
  {
    "id": 192,
    "text": "随后列举项羽泣歌赠头、刘邦中胸抚足的经典动作细节，",
    "start": 772.616,
    "end": 777.496,
    "duration": 4.88
  },
  {
    "id": 193,
    "text": "证明司马迁善于以微见著、以形传神，",
    "start": 777.496,
    "end": 780.776,
    "duration": 3.28
  },
  {
    "id": 194,
    "text": "赋予了历史人物极其强烈的肉身感与生命力。",
    "start": 780.776,
    "end": 783.896,
    "duration": 3.12
  },
  {
    "id": 195,
    "text": "所以本段具体答题完整版为：三、传神细节与个性化言行：以形传神的白描勾勒与个性语言。",
    "start": 784.216,
    "end": 792.296,
    "duration": 8.08
  },
  {
    "id": 196,
    "text": "司马迁在刻画人物时精于白描技法，",
    "start": 792.296,
    "end": 795.256,
    "duration": 2.96
  },
  {
    "id": 197,
    "text": "极善于抓取富于个性特征的言谈与典型细节。",
    "start": 795.256,
    "end": 799.176,
    "duration": 3.92
  },
  {
    "id": 198,
    "text": "他深安不同阶层、不同性格人物的语言风味，",
    "start": 799.176,
    "end": 802.616,
    "duration": 3.44
  },
  {
    "id": 199,
    "text": "做到言如其人、神采毕现。",
    "start": 802.616,
    "end": 804.616,
    "duration": 2.0
  },
  {
    "id": 200,
    "text": "在面对秦始皇浩荡出巡时，项羽脱口而出：“彼可取而代也”，",
    "start": 805.016,
    "end": 809.816,
    "duration": 4.8
  },
  {
    "id": 201,
    "text": "尽显楚霸王豪迈拔山的狂傲霸气。",
    "start": 809.816,
    "end": 812.776,
    "duration": 2.96
  },
  {
    "id": 202,
    "text": "而刘邦见之则悄然叹曰：“嗟乎，大丈夫当如此也”，",
    "start": 812.776,
    "end": 817.016,
    "duration": 4.24
  },
  {
    "id": 203,
    "text": "尽显市井豪徒的艳羡狡黠与深沉野心。",
    "start": 817.016,
    "end": 820.456,
    "duration": 3.44
  },
  {
    "id": 204,
    "text": "两句对话形成鲜明对照，深刻揭示了两位历史消雄迥异的性格与政治格局。",
    "start": 820.456,
    "end": 826.296,
    "duration": 5.84
  },
  {
    "id": 205,
    "text": "在细节捕捉上，垓下重围时项羽慷慨悲歌泣下数行，",
    "start": 826.616,
    "end": 831.896,
    "duration": 5.28
  },
  {
    "id": 206,
    "text": "乌江自刎前赠头故人吕马童。",
    "start": 831.896,
    "end": 834.536,
    "duration": 2.64
  },
  {
    "id": 207,
    "text": "刘邦在鸿门宴借口如厕仓皇脱逃，被项羽射中胸口却俯身按足高呼“虏中吾指”。",
    "start": 834.536,
    "end": 842.216,
    "duration": 7.68
  },
  {
    "id": 208,
    "text": "这些极具戏剧感的传神细节，使两千年前的历史人物如在眼前、",
    "start": 842.216,
    "end": 847.496,
    "duration": 5.28
  },
  {
    "id": 209,
    "text": "历历在目。",
    "start": 847.496,
    "end": 848.376,
    "duration": 0.88
  },
  {
    "id": 210,
    "text": "第五段：第四分论点，发愤著书的抒情笔触（魂之“深”）。",
    "start": 848.616,
    "end": 853.176,
    "duration": 4.56
  },
  {
    "id": 211,
    "text": "逐句因果推导与答题表述。",
    "start": 853.176,
    "end": 855.656,
    "duration": 2.48
  },
  {
    "id": 212,
    "text": "在剖析了构架、场面与细节之后，本段必须进入人物塑造的精神灵魂，",
    "start": 855.656,
    "end": 861.416,
    "duration": 5.76
  },
  {
    "id": 213,
    "text": "即司马迁的主体情志。",
    "start": 861.416,
    "end": 863.576,
    "duration": 2.16
  },
  {
    "id": 214,
    "text": "首句立论，指出司马迁秉持发愤著书之旨，",
    "start": 863.576,
    "end": 867.736,
    "duration": 4.16
  },
  {
    "id": 215,
    "text": "将自身的血泪体验融入人物刻画。",
    "start": 867.736,
    "end": 870.456,
    "duration": 2.72
  },
  {
    "id": 216,
    "text": "所以表述为：司马迁在李陵之祸后秉持“发愤著书”之旨，",
    "start": 870.856,
    "end": 875.976,
    "duration": 5.12
  },
  {
    "id": 217,
    "text": "将深沉的生命血泪融入了历史人物的塑造。",
    "start": 875.976,
    "end": 879.816,
    "duration": 3.84
  },
  {
    "id": 218,
    "text": "次句指出其进步的历史观，说明他打破成王败寇的世俗准则，",
    "start": 879.816,
    "end": 884.936,
    "duration": 5.12
  },
  {
    "id": 219,
    "text": "倾注了强烈的道德批判与悲敏。",
    "start": 884.936,
    "end": 887.816,
    "duration": 2.88
  },
  {
    "id": 220,
    "text": "所以表述为：他打破了成王败寇的封建世俗功利准则，",
    "start": 887.816,
    "end": 892.904,
    "duration": 5.088
  },
  {
    "id": 221,
    "text": "在字里行间倾注了极强的道德批判与悲敏情怀。",
    "start": 892.904,
    "end": 897.544,
    "duration": 4.64
  },
  {
    "id": 222,
    "text": "第三句调取体例安排上的证据，项羽入本纪、",
    "start": 897.544,
    "end": 901.864,
    "duration": 4.32
  },
  {
    "id": 223,
    "text": "陈胜入世家，并为下层立传。",
    "start": 901.864,
    "end": 904.744,
    "duration": 2.88
  },
  {
    "id": 224,
    "text": "所以表述为：他为失败的悲剧英雄项羽立本纪，",
    "start": 904.744,
    "end": 908.824,
    "duration": 4.08
  },
  {
    "id": 225,
    "text": "为揭竿而起的陈胜立世家，更为刺客、",
    "start": 908.824,
    "end": 912.104,
    "duration": 3.28
  },
  {
    "id": 226,
    "text": "游侠与微贱之人作传。",
    "start": 912.104,
    "end": 914.104,
    "duration": 2.0
  },
  {
    "id": 227,
    "text": "第四句引入史官赞语体制，指出“太史公曰”将克制叙事转化为激昂抒情。",
    "start": 914.344,
    "end": 920.984,
    "duration": 6.64
  },
  {
    "id": 228,
    "text": "所以表述为：在叙事之末，司马迁常以“太史公曰”的史官赞语，",
    "start": 920.984,
    "end": 925.784,
    "duration": 4.8
  },
  {
    "id": 229,
    "text": "将隐忍内敛的叙事骤然升华为激昂的抒情议论。",
    "start": 925.784,
    "end": 929.864,
    "duration": 4.08
  },
  {
    "id": 230,
    "text": "第五句总结全段，指出强烈的作者主体精神赋予了整部作品壮烈深沉的悲剧崇高美。",
    "start": 929.864,
    "end": 936.664,
    "duration": 6.8
  },
  {
    "id": 231,
    "text": "所以表述为：这种融注了强烈主体情感与人文关怀的史笔，",
    "start": 936.984,
    "end": 941.864,
    "duration": 4.88
  },
  {
    "id": 232,
    "text": "赋予了整部传记壮烈深沉的悲剧崇高美。",
    "start": 941.864,
    "end": 945.944,
    "duration": 4.08
  },
  {
    "id": 233,
    "text": "本段答题思路总结。",
    "start": 945.944,
    "end": 947.864,
    "duration": 1.92
  },
  {
    "id": 234,
    "text": "本段将人物塑造提升到最高的美学与作家论高度：紧扣司马迁“发愤著书”的心理动力，",
    "start": 947.864,
    "end": 955.304,
    "duration": 7.44
  },
  {
    "id": 235,
    "text": "阐发其打破“成王败寇”世俗权贵视角的崇高风骨；",
    "start": 955.304,
    "end": 959.464,
    "duration": 4.16
  },
  {
    "id": 236,
    "text": "以项羽入本纪、陈涉入世家、下层刺客游侠入传为制度铁证，",
    "start": 959.864,
    "end": 965.944,
    "duration": 6.08
  },
  {
    "id": 237,
    "text": "结合“太史公曰”的直抒胸臆，有力证明了《史记》之伟大正在于史官直笔与悲敏诗心的生死熔铸。",
    "start": 965.944,
    "end": 974.504,
    "duration": 8.56
  },
  {
    "id": 238,
    "text": "所以本段具体答题完整版为：四、发愤著书的抒情笔触：爱憎分明的史家风骨与悲剧崇高感。",
    "start": 974.504,
    "end": 982.344,
    "duration": 7.84
  },
  {
    "id": 239,
    "text": "司马迁在李陵之祸后秉持“发愤著书”之旨，",
    "start": 982.664,
    "end": 986.584,
    "duration": 3.92
  },
  {
    "id": 240,
    "text": "将深沉的生命血泪融入了历史人物的塑造。",
    "start": 986.584,
    "end": 990.264,
    "duration": 3.68
  },
  {
    "id": 241,
    "text": "他打破了成王败寇的封建世俗功利准则，",
    "start": 990.264,
    "end": 993.704,
    "duration": 3.44
  },
  {
    "id": 242,
    "text": "在字里行间倾注了极强的道德批判与悲敏情怀。",
    "start": 993.704,
    "end": 998.264,
    "duration": 4.56
  },
  {
    "id": 243,
    "text": "他为失败的悲剧英雄项羽立本纪，为揭竿而起的陈胜立世家，",
    "start": 998.264,
    "end": 1003.704,
    "duration": 5.44
  },
  {
    "id": 244,
    "text": "更为刺客、游侠与微贱之人作传。",
    "start": 1003.704,
    "end": 1006.664,
    "duration": 2.96
  },
  {
    "id": 245,
    "text": "在叙事之末，司马迁常以“太史公曰”的史官赞语，",
    "start": 1006.984,
    "end": 1010.984,
    "duration": 4.0
  },
  {
    "id": 246,
    "text": "将隐忍内敛的叙事骤然升华为激昂的抒情议论。",
    "start": 1010.984,
    "end": 1014.904,
    "duration": 3.92
  },
  {
    "id": 247,
    "text": "这种融注了强烈主体情感与人文关怀的史笔，",
    "start": 1014.904,
    "end": 1018.664,
    "duration": 3.76
  },
  {
    "id": 248,
    "text": "赋予了整部传记壮烈深沉的悲剧崇高美。",
    "start": 1018.664,
    "end": 1022.264,
    "duration": 3.6
  },
  {
    "id": 249,
    "text": "--。第",
    "start": 1022.264,
    "end": 1022.424,
    "duration": 0.16
  },
  {
    "id": 250,
    "text": "六段：尾段收官与文学史谱系闭环。",
    "start": 1022.424,
    "end": 1025.304,
    "duration": 2.88
  },
  {
    "id": 251,
    "text": "逐句因果推导与答题表述。",
    "start": 1025.624,
    "end": 1028.024,
    "duration": 2.4
  },
  {
    "id": 252,
    "text": "尾段作为三十分大题的收官，必须将《史记》置入两千年叙事文学长河中进行历史定位。",
    "start": 1028.024,
    "end": 1035.144,
    "duration": 7.12
  },
  {
    "id": 253,
    "text": "首句综合前述四个维度，盛赞其实现了求真史学与伟大文学的极致结合。",
    "start": 1035.144,
    "end": 1041.464,
    "duration": 6.32
  },
  {
    "id": 254,
    "text": "所以表述为：综上所述，《史记》实现了求真史学与伟大文学的极致结合。",
    "start": 1041.464,
    "end": 1047.84,
    "duration": 6.376
  },
  {
    "id": 255,
    "text": "次句确立其文体史地位，指出其开辟了纪传体传记文学的标准体例。",
    "start": 1047.84,
    "end": 1053.189,
    "duration": 5.349
  },
  {
    "id": 256,
    "text": "所以表述为：它开辟了纪传体传记文学的标准体例，",
    "start": 1053.189,
    "end": 1057.509,
    "duration": 4.32
  },
  {
    "id": 257,
    "text": "彻底奠定了中国叙事散文的崇高传统。",
    "start": 1057.509,
    "end": 1060.8,
    "duration": 3.291
  },
  {
    "id": 258,
    "text": "第三句向史学史延伸，指出其为历代正史修撰树立了规范。",
    "start": 1060.88,
    "end": 1066.236,
    "duration": 5.356
  },
  {
    "id": 259,
    "text": "所以表述为：这一人物塑造艺术不仅为历代正史修撰树立了难以企及的规范。",
    "start": 1066.236,
    "end": 1073.196,
    "duration": 6.96
  },
  {
    "id": 260,
    "text": "第四句向小说戏剧史延伸，指出它是唐宋传奇、",
    "start": 1073.196,
    "end": 1077.329,
    "duration": 4.133
  },
  {
    "id": 261,
    "text": "宋元戏曲与明清长篇小说人物塑造的源头先导。",
    "start": 1077.329,
    "end": 1081.68,
    "duration": 4.351
  },
  {
    "id": 262,
    "text": "所以表述为：更是后世唐宋传奇、宋元戏曲与明清长篇小说人物刻画的源头先导。",
    "start": 1081.84,
    "end": 1088.88,
    "duration": 7.04
  },
  {
    "id": 263,
    "text": "本段答题思路总结。",
    "start": 1088.88,
    "end": 1090.56,
    "duration": 1.68
  },
  {
    "id": 264,
    "text": "本段实现了极具历史纵深感的收官：两句话确立其“求真史学与伟大文学结合”的崇高地位；",
    "start": 1090.56,
    "end": 1097.44,
    "duration": 6.88
  },
  {
    "id": 265,
    "text": "接着向外辐射，既指明其对后世二十四史编撰的规制确立，",
    "start": 1097.44,
    "end": 1101.76,
    "duration": 4.32
  },
  {
    "id": 266,
    "text": "更着重揭示其人物塑造传统对唐宋传奇、",
    "start": 1101.76,
    "end": 1105.44,
    "duration": 3.68
  },
  {
    "id": 267,
    "text": "宋元戏曲乃至明清长篇小说的血脉哺育，",
    "start": 1105.44,
    "end": 1108.72,
    "duration": 3.28
  },
  {
    "id": 268,
    "text": "使整道大题在宏阔深远的叙事文学演进谱系中完美定稿。",
    "start": 1108.72,
    "end": 1113.28,
    "duration": 4.56
  },
  {
    "id": 269,
    "text": "所以本段具体答题完整版为：综上所述，",
    "start": 1113.6,
    "end": 1116.88,
    "duration": 3.28
  },
  {
    "id": 270,
    "text": "《史记》实现了求真史学与伟大文学的极致结合。",
    "start": 1116.88,
    "end": 1121.2,
    "duration": 4.32
  },
  {
    "id": 271,
    "text": "它开辟了纪传体传记文学的标准体例，",
    "start": 1121.2,
    "end": 1124.4,
    "duration": 3.2
  },
  {
    "id": 272,
    "text": "彻底奠定了中国叙事散文的崇高传统。",
    "start": 1124.4,
    "end": 1127.6,
    "duration": 3.2
  },
  {
    "id": 273,
    "text": "这一人物塑造艺术不仅为历代正史修撰树立了难以企及的规范。",
    "start": 1127.6,
    "end": 1132.56,
    "duration": 4.96
  },
  {
    "id": 274,
    "text": "更是后世唐宋传奇、宋元戏曲与明清长篇小说人物刻画的源头先导。",
    "start": 1132.8,
    "end": 1138.96,
    "duration": 6.16
  },
  {
    "id": 275,
    "text": "整道大题的内在逻辑链总括。",
    "start": 1138.96,
    "end": 1141.28,
    "duration": 2.32
  },
  {
    "id": 276,
    "text": "这道三十分大题的本质，是一场极度严密的逻辑推演。",
    "start": 1141.28,
    "end": 1145.28,
    "duration": 4.0
  },
  {
    "id": 277,
    "text": "整篇答卷从头到尾遵循着“由典范定评、",
    "start": 1145.28,
    "end": 1149.36,
    "duration": 4.08
  },
  {
    "id": 278,
    "text": "到篇章互见、到尖锐冲突、到传神细节、",
    "start": 1149.36,
    "end": 1153.28,
    "duration": 3.92
  },
  {
    "id": 279,
    "text": "到主体情志、最终回归文学史承续”的必然法则。",
    "start": 1153.28,
    "end": 1157.04,
    "duration": 3.76
  },
  {
    "id": 280,
    "text": "阅卷老师看到的绝不是散乱的答题点，",
    "start": 1157.36,
    "end": 1160.4,
    "duration": 3.04
  },
  {
    "id": 281,
    "text": "而是一条咬合紧密的因果长链：第一步是“立论定性”，",
    "start": 1160.4,
    "end": 1164.56,
    "duration": 4.16
  },
  {
    "id": 282,
    "text": "开门见山解决《史记》的传记文学典范地位，",
    "start": 1164.56,
    "end": 1168.08,
    "duration": 3.52
  },
  {
    "id": 283,
    "text": "确立纪传体修史的核心体制。",
    "start": 1168.08,
    "end": 1170.64,
    "duration": 2.56
  },
  {
    "id": 284,
    "text": "第二步是“互见笔法”，以刘邦与李广为例，",
    "start": 1170.64,
    "end": 1173.92,
    "duration": 3.28
  },
  {
    "id": 285,
    "text": "透析“主传立干、他传见枝”如何打破脸谱化呈现立体人性。",
    "start": 1173.92,
    "end": 1179.04,
    "duration": 5.12
  },
  {
    "id": 286,
    "text": "第三步是“典型场面”，以“鸿门宴”与“廉颇赁相如”三大关头，",
    "start": 1179.36,
    "end": 1184.64,
    "duration": 5.28
  },
  {
    "id": 287,
    "text": "论证在重大生死冲突中展现性格的大开大合。",
    "start": 1184.64,
    "end": 1188.64,
    "duration": 4.0
  },
  {
    "id": 288,
    "text": "第四步是“言语细节”，以项羽刘邦观始皇出巡的对话对比与神态白描，",
    "start": 1189.016,
    "end": 1194.536,
    "duration": 5.52
  },
  {
    "id": 289,
    "text": "展现言如其人、以形写神的精妙。",
    "start": 1194.536,
    "end": 1197.416,
    "duration": 2.88
  },
  {
    "id": 290,
    "text": "第五步是“发愤著书”，以不以成败论英雄与“太史公曰”，",
    "start": 1197.416,
    "end": 1201.736,
    "duration": 4.32
  },
  {
    "id": 291,
    "text": "阐明史家直笔与悲敏诗心熔铸的崇高悲剧美。",
    "start": 1201.736,
    "end": 1205.496,
    "duration": 3.76
  },
  {
    "id": 292,
    "text": "第六步是“史学闭环”，把《史记》的人物塑造传统自然引向后代正史与唐宋传奇、",
    "start": 1205.496,
    "end": 1212.456,
    "duration": 6.96
  },
  {
    "id": 293,
    "text": "明清小说的叙事洪流。",
    "start": 1212.456,
    "end": 1214.056,
    "duration": 1.6
  },
  {
    "id": 294,
    "text": "这六步层层递进，前一步的结论必然成为后一步的前提。",
    "start": 1214.296,
    "end": 1218.696,
    "duration": 4.4
  },
  {
    "id": 295,
    "text": "你在考场上顺着因果关系顺流而下，",
    "start": 1218.696,
    "end": 1221.656,
    "duration": 2.96
  },
  {
    "id": 296,
    "text": "就能自然写出近千字的满分答卷。",
    "start": 1221.656,
    "end": 1224.216,
    "duration": 2.56
  }
]