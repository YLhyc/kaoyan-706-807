[
  {
    "id": 1,
    "text": "简述李清照词作艺术风格的演进历程及其“词别是一家”的理论主张与贡献。",
    "start": 0.16,
    "end": 6.24,
    "duration": 6.08
  },
  {
    "id": 2,
    "text": "李清照是两宋之交成就卓绝的婉约词派代表词人，",
    "start": 6.24,
    "end": 10.56,
    "duration": 4.32
  },
  {
    "id": 3,
    "text": "被誉为 “词家一大宗”。",
    "start": 10.56,
    "end": 12.72,
    "duration": 2.16
  },
  {
    "id": 4,
    "text": "她不仅在创作上开创了独树一帜的 “易安体”，",
    "start": 12.72,
    "end": 16.56,
    "duration": 3.84
  },
  {
    "id": 5,
    "text": "更在词论上建立了具有独立文体自觉的理论体系。",
    "start": 16.56,
    "end": 20.48,
    "duration": 3.92
  },
  {
    "id": 6,
    "text": "李清照词作风格的演进历程及其理论贡献，",
    "start": 20.48,
    "end": 24.24,
    "duration": 3.76
  },
  {
    "id": 7,
    "text": "主要展现为以下三个核心维度：",
    "start": 24.24,
    "end": 27.92,
    "duration": 3.68
  },
  {
    "id": 8,
    "text": "第一，在《词论》中提出“词别是一家”的主张，",
    "start": 27.92,
    "end": 32.96,
    "duration": 5.04
  },
  {
    "id": 9,
    "text": "确立词体独立的文体边界与声律典范。",
    "start": 32.96,
    "end": 36.16,
    "duration": 3.2
  },
  {
    "id": 10,
    "text": "李清照在著名理论专论 《词论》 中，",
    "start": 36.16,
    "end": 39.84,
    "duration": 3.68
  },
  {
    "id": 11,
    "text": "系统梳理了词的发展史，",
    "start": 39.84,
    "end": 42.08,
    "duration": 2.24
  },
  {
    "id": 12,
    "text": "明确提出 “词别是一家” 的纲领性论断。",
    "start": 42.08,
    "end": 46.0,
    "duration": 3.92
  },
  {
    "id": 13,
    "text": "她强调词作为一种独立的新文体，",
    "start": 46.0,
    "end": 49.28,
    "duration": 3.28
  },
  {
    "id": 14,
    "text": "必须严格恪守其自身独特的艺术规范：",
    "start": 49.28,
    "end": 53.84,
    "duration": 4.56
  },
  {
    "id": 15,
    "text": "一是高度重视协律与音乐美，讲求五音六律与清浊轻重，",
    "start": 53.92,
    "end": 59.92,
    "duration": 6.0
  },
  {
    "id": 16,
    "text": "批评苏轼、欧阳修等人虽博学高妙，却 “往往不协音律”，",
    "start": 59.92,
    "end": 66.4,
    "duration": 6.48
  },
  {
    "id": 17,
    "text": "直指其为 “句读不葺之诗”；二是主张 “尚雅”，",
    "start": 66.4,
    "end": 71.52,
    "duration": 5.12
  },
  {
    "id": 18,
    "text": "批评柳永词调虽合音律却 “词语尘下”，缺乏典雅品格；",
    "start": 71.52,
    "end": 76.4,
    "duration": 4.88
  },
  {
    "id": 19,
    "text": "三是提倡用典精审与感情真挚。",
    "start": 76.4,
    "end": 79.68,
    "duration": 3.28
  },
  {
    "id": 20,
    "text": "这一主张有力维护了词体的本体独立性，",
    "start": 79.68,
    "end": 83.36,
    "duration": 3.68
  },
  {
    "id": 21,
    "text": "确立了词体纯正的音乐与文体格范。",
    "start": 83.36,
    "end": 86.64,
    "duration": 3.28
  },
  {
    "id": 22,
    "text": "第二，以南渡为界展现由前期清新明丽向后期凄凉沉痛的历史演进。",
    "start": 86.64,
    "end": 92.48,
    "duration": 5.84
  },
  {
    "id": 23,
    "text": "靖康之变的国破家亡与流离失所，",
    "start": 92.48,
    "end": 96.0,
    "duration": 3.52
  },
  {
    "id": 24,
    "text": "使李清照的词作风格发生了深刻裂变。",
    "start": 96.0,
    "end": 99.52,
    "duration": 3.52
  },
  {
    "id": 25,
    "text": "前期生活优渥圆满，词作多描写少女闺中情趣与相思离愁，",
    "start": 99.68,
    "end": 105.04,
    "duration": 5.36
  },
  {
    "id": 26,
    "text": "如 《如梦令》 中的 “常记溪亭日暮，沉醉不知归路”，",
    "start": 105.04,
    "end": 109.68,
    "duration": 4.64
  },
  {
    "id": 27,
    "text": "洋溢着青春欢愉与对自然人生的热爱；南渡以后，",
    "start": 109.68,
    "end": 113.92,
    "duration": 4.24
  },
  {
    "id": 28,
    "text": "面对金兵侵凌、国土沦丧、",
    "start": 113.92,
    "end": 116.8,
    "duration": 2.88
  },
  {
    "id": 29,
    "text": "丈夫赵明诚病故与半生金石文物丧失的沉重打击，",
    "start": 116.8,
    "end": 121.36,
    "duration": 4.56
  },
  {
    "id": 30,
    "text": "词作转入对漂泊身世与家国沦亡的悲叹，",
    "start": 121.36,
    "end": 125.28,
    "duration": 3.92
  },
  {
    "id": 31,
    "text": "如 《声声慢》 中开篇连用十四个叠字 “寻寻觅觅，",
    "start": 125.28,
    "end": 130.4,
    "duration": 5.12
  },
  {
    "id": 32,
    "text": "冷冷清清，凄凄惨惨戚戚”，极写晚年孤苦无依的凄凉绝境，",
    "start": 130.4,
    "end": 135.744,
    "duration": 5.344
  },
  {
    "id": 33,
    "text": "将个人流离与国家动荡紧密交融，词风深沉凄苦、格调苍凉。",
    "start": 135.744,
    "end": 141.344,
    "duration": 5.6
  },
  {
    "id": 34,
    "text": "第三，擅用家常口语入词与精工炼字，",
    "start": 141.344,
    "end": 144.944,
    "duration": 3.6
  },
  {
    "id": 35,
    "text": "形成自然纯朴的“易安体”语言风范。",
    "start": 144.944,
    "end": 148.704,
    "duration": 3.76
  },
  {
    "id": 36,
    "text": "在语言表现上，李清照开创了自然天成的语言风格。",
    "start": 148.704,
    "end": 152.624,
    "duration": 3.92
  },
  {
    "id": 37,
    "text": "她善于化寻常口语为精妙词句，如 “生怕闲愁暗恨，多少事、",
    "start": 152.384,
    "end": 152.624,
    "duration": 0.24
  },
  {
    "id": 38,
    "text": "欲说还休”，大白若浅却深挚感人；同时精于炼字造境，",
    "start": 152.384,
    "end": 152.624,
    "duration": 0.24
  },
  {
    "id": 39,
    "text": "如 《如梦令》 中以 “绿肥红瘦” 描写暮春雨后景象，",
    "start": 152.384,
    "end": 152.624,
    "duration": 0.24
  },
  {
    "id": 40,
    "text": "清新脱俗，展现出极高超的语言表现力。",
    "start": 152.384,
    "end": 152.624,
    "duration": 0.24
  }
]