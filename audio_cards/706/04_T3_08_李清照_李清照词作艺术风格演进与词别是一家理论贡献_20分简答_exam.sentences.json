[
  {
    "id": 1,
    "text": "简述李清照词作艺术风格的演进历程及其“词别是一家”的理论贡献。",
    "start": 0.12,
    "end": 5.446,
    "duration": 5.326
  },
  {
    "id": 2,
    "text": "李清照是两宋之交杰出的婉约词派代表词人，自成“易安体”，在词作与词论上均贡献卓著。",
    "start": 6.115,
    "end": 13.444,
    "duration": 7.329
  },
  {
    "id": 3,
    "text": "其词风演进历程与“词别是一家”的理论主张，主要体现在以下三个方面：",
    "start": 13.964,
    "end": 19.147,
    "duration": 5.183
  },
  {
    "id": 4,
    "text": "第一，在《词论》中提出“词别是一家”，从本体上确立词体独立地位。",
    "start": 19.755,
    "end": 25.956,
    "duration": 6.201
  },
  {
    "id": 5,
    "text": "李清照在《词论》中系统回顾词史，明确提出“词别是一家”的纲领，将词与诗严格区分开来。",
    "start": 26.476,
    "end": 34.428,
    "duration": 7.952
  },
  {
    "id": 6,
    "text": "她强调词对音律与节奏有独特要求，须“分五音，又分五声，又分六律，又分清浊轻重”，",
    "start": 34.948,
    "end": 43.39,
    "duration": 8.442
  },
  {
    "id": 7,
    "text": "批评苏轼、欧阳修词“往往不协音律”，直指其为“句读不葺之诗”；",
    "start": 43.76,
    "end": 49.281,
    "duration": 5.521
  },
  {
    "id": 8,
    "text": "同时推崇词格高雅典重，批评柳永词“词语尘下”，并主张铺叙曲折、讲究故实与情致浑成。",
    "start": 49.801,
    "end": 58.32,
    "duration": 8.519
  },
  {
    "id": 9,
    "text": "这一主张有力维护了词作为独立抒情文体的艺术边界。",
    "start": 58.84,
    "end": 62.861,
    "duration": 4.021
  },
  {
    "id": 10,
    "text": "第二，以南渡为界，词风由前期清丽明快转为后期沉痛苍凉。",
    "start": 63.491,
    "end": 69.577,
    "duration": 6.086
  },
  {
    "id": 11,
    "text": "靖康之变带来的国破家亡与流离孤苦，使李清照词风发生鲜明转折。",
    "start": 70.097,
    "end": 75.945,
    "duration": 5.848
  },
  {
    "id": 12,
    "text": "前期生活美满，多写闺中情趣、自然游赏与甜蜜相思，",
    "start": 76.465,
    "end": 81.192,
    "duration": 4.727
  },
  {
    "id": 13,
    "text": "如《如梦令》“常记溪亭日暮，沉醉不知归路”，清丽轻快、生机盎然；",
    "start": 81.562,
    "end": 87.445,
    "duration": 5.883
  },
  {
    "id": 14,
    "text": "南渡之后，历经夫亡物散与飘零之苦，词境转为沉重哀伤，",
    "start": 87.965,
    "end": 93.7,
    "duration": 5.735
  },
  {
    "id": 15,
    "text": "如《声声慢》开篇连用十四个叠字“寻寻觅觅，冷冷清清，凄凄惨惨戚戚”，",
    "start": 94.308,
    "end": 100.826,
    "duration": 6.518
  },
  {
    "id": 16,
    "text": "将晚年孤寂与家国悲痛交融一处，格调凄苦苍凉。",
    "start": 101.341,
    "end": 105.831,
    "duration": 4.49
  },
  {
    "id": 17,
    "text": "第三，善用寻常口语与白描炼字，开创清新素雅的“易安体”语言风范。",
    "start": 106.508,
    "end": 112.877,
    "duration": 6.369
  },
  {
    "id": 18,
    "text": "李清照词善于选取日常生活细节展现微妙心理，以浅近明白的家常语言传出深情，",
    "start": 113.397,
    "end": 120.453,
    "duration": 7.056
  },
  {
    "id": 19,
    "text": "如《凤凰台上忆吹箫》“生怕离怀别苦，多少事、欲说还休”，自然浅淡却真挚动人；",
    "start": 120.823,
    "end": 128.345,
    "duration": 7.522
  },
  {
    "id": 20,
    "text": "又长于白描造境与精工炼字，如“绿肥红瘦”“人比黄花瘦”，",
    "start": 128.865,
    "end": 134.554,
    "duration": 5.689
  },
  {
    "id": 21,
    "text": "素雅清婉、风韵天成，使“易安体”成为宋代婉约词坛的杰出风范。",
    "start": 134.995,
    "end": 140.754,
    "duration": 5.759
  }
]