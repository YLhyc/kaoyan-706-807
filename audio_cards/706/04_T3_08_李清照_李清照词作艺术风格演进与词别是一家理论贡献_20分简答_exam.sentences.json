[
  {
    "id": "sent_1",
    "text": "李清照是两宋之交成就卓绝的婉约词派代表词人，",
    "start": 0.0,
    "end": 4.16,
    "duration": 4.16
  },
  {
    "id": "sent_2",
    "text": "被誉为 “词家一大宗”。",
    "start": 4.609,
    "end": 6.329,
    "duration": 1.72
  },
  {
    "id": "sent_3",
    "text": "她不仅在创作上开创了独树一帜的 “易安体”，",
    "start": 6.779,
    "end": 9.979,
    "duration": 3.2
  },
  {
    "id": "sent_4",
    "text": "更在词论上建立了具有独立文体自觉的理论体系。",
    "start": 10.429,
    "end": 14.189,
    "duration": 3.76
  },
  {
    "id": "sent_5",
    "text": "李清照词作风格的演进历程及其理论贡献，",
    "start": 14.639,
    "end": 18.199,
    "duration": 3.56
  },
  {
    "id": "sent_6",
    "text": "主要展现为以下三个核心维度：",
    "start": 18.649,
    "end": 21.049,
    "duration": 2.4
  },
  {
    "id": "sent_7",
    "text": "第一，在《词论》中提出“词别是一家”的主张，",
    "start": 21.499,
    "end": 25.139,
    "duration": 3.64
  },
  {
    "id": "sent_8",
    "text": "确立词体独立的文体边界与声律典范。",
    "start": 25.589,
    "end": 28.789,
    "duration": 3.2
  },
  {
    "id": "sent_9",
    "text": "李清照在著名理论专论 《词论》 中，系统梳理了词的发展史，",
    "start": 29.239,
    "end": 33.959,
    "duration": 4.72
  },
  {
    "id": "sent_10",
    "text": "明确提出 “词别是一家” 的纲领性论断。",
    "start": 34.409,
    "end": 37.209,
    "duration": 2.8
  },
  {
    "id": "sent_11",
    "text": "她强调词作为一种独立的新文体，",
    "start": 37.659,
    "end": 40.259,
    "duration": 2.6
  },
  {
    "id": "sent_12",
    "text": "必须严格恪守其自身独特的艺术规范：一是高度重视协律与音乐美，",
    "start": 40.709,
    "end": 45.989,
    "duration": 5.28
  },
  {
    "id": "sent_13",
    "text": "讲求五音六律与清浊轻重，批评苏轼、欧阳修等人虽博学高妙，",
    "start": 46.439,
    "end": 51.999,
    "duration": 5.56
  },
  {
    "id": "sent_14",
    "text": "却 “往往不协音律”，直指其为 “句读不葺之诗”；",
    "start": 52.449,
    "end": 55.889,
    "duration": 3.44
  },
  {
    "id": "sent_15",
    "text": "二是主张 “尚雅”，批评柳永词调虽合音律却 “词语尘下”，",
    "start": 56.419,
    "end": 60.939,
    "duration": 4.52
  },
  {
    "id": "sent_16",
    "text": "缺乏典雅品格；",
    "start": 61.389,
    "end": 62.829,
    "duration": 1.44
  },
  {
    "id": "sent_17",
    "text": "三是提倡用典精审与感情真挚。",
    "start": 63.359,
    "end": 66.279,
    "duration": 2.92
  },
  {
    "id": "sent_18",
    "text": "这一主张有力维护了词体的本体独立性，",
    "start": 66.729,
    "end": 69.729,
    "duration": 3.0
  },
  {
    "id": "sent_19",
    "text": "确立了词体纯正的音乐与文体格范。",
    "start": 70.179,
    "end": 73.019,
    "duration": 2.84
  },
  {
    "id": "sent_20",
    "text": "第二，以南渡为界展现由前期清新明丽向后期凄凉沉痛的历史演进。",
    "start": 73.469,
    "end": 79.429,
    "duration": 5.96
  },
  {
    "id": "sent_21",
    "text": "靖康之变的国破家亡与流离失所，",
    "start": 79.879,
    "end": 82.439,
    "duration": 2.56
  },
  {
    "id": "sent_22",
    "text": "使李清照的词作风格发生了深刻裂变。",
    "start": 82.889,
    "end": 85.729,
    "duration": 2.84
  },
  {
    "id": "sent_23",
    "text": "前期生活优渥圆满，词作多描写少女闺中情趣与相思离愁，",
    "start": 86.179,
    "end": 91.059,
    "duration": 4.88
  },
  {
    "id": "sent_24",
    "text": "如 《如梦令》 中的 “常记溪亭日暮，沉醉不知归路”，",
    "start": 91.509,
    "end": 95.509,
    "duration": 4.0
  },
  {
    "id": "sent_25",
    "text": "洋溢着青春欢愉与对自然人生的热爱；",
    "start": 95.959,
    "end": 99.039,
    "duration": 3.08
  },
  {
    "id": "sent_26",
    "text": "南渡以后，面对金兵侵凌、国土沦丧、",
    "start": 99.489,
    "end": 102.809,
    "duration": 3.32
  },
  {
    "id": "sent_27",
    "text": "丈夫赵明诚病故与半生金石文物丧失的沉重打击，",
    "start": 103.259,
    "end": 107.499,
    "duration": 4.24
  },
  {
    "id": "sent_28",
    "text": "词作转入对漂泊身世与家国沦亡的悲叹，",
    "start": 107.949,
    "end": 111.469,
    "duration": 3.52
  },
  {
    "id": "sent_29",
    "text": "如 《声声慢》 中开篇连用十四个叠字 “寻寻觅觅，冷冷清清，",
    "start": 111.919,
    "end": 116.839,
    "duration": 4.92
  },
  {
    "id": "sent_30",
    "text": "凄凄惨惨戚戚”，极写晚年孤苦无依的凄凉绝境，",
    "start": 117.289,
    "end": 121.329,
    "duration": 4.04
  },
  {
    "id": "sent_31",
    "text": "将个人流离与国家动荡紧密交融，词风深沉凄苦、格调苍凉。",
    "start": 121.779,
    "end": 126.699,
    "duration": 4.92
  },
  {
    "id": "sent_32",
    "text": "第三，擅用家常口语入词与精工炼字，",
    "start": 127.149,
    "end": 130.309,
    "duration": 3.16
  },
  {
    "id": "sent_33",
    "text": "形成自然纯朴的“易安体”语言风范。",
    "start": 130.759,
    "end": 133.399,
    "duration": 2.64
  },
  {
    "id": "sent_34",
    "text": "在语言表现上，李清照开创了自然天成的语言风格。",
    "start": 133.849,
    "end": 137.889,
    "duration": 4.04
  },
  {
    "id": "sent_35",
    "text": "她善于化寻常口语为精妙词句，如 “生怕闲愁暗恨，多少事、",
    "start": 138.339,
    "end": 143.379,
    "duration": 5.04
  },
  {
    "id": "sent_36",
    "text": "欲说还休”，大白若浅却深挚感人；",
    "start": 143.829,
    "end": 146.909,
    "duration": 3.08
  },
  {
    "id": "sent_37",
    "text": "同时精于炼字造境，",
    "start": 147.359,
    "end": 148.959,
    "duration": 1.6
  },
  {
    "id": "sent_38",
    "text": "如 《如梦令》 中以 “绿肥红瘦” 描写暮春雨后景象，",
    "start": 149.489,
    "end": 153.449,
    "duration": 3.96
  },
  {
    "id": "sent_39",
    "text": "清新脱俗，展现出极高超的语言表现力。",
    "start": 153.899,
    "end": 156.979,
    "duration": 3.08
  }
]