[
  {
    "id": "sent_1",
    "text": "李清照是两宋之交成就卓绝的婉约词派代表词人，",
    "start": 0.1,
    "end": 5.128,
    "duration": 5.028
  },
  {
    "id": "sent_2",
    "text": "被誉为 “词家一大宗”。",
    "start": 5.078,
    "end": 7.357,
    "duration": 2.279
  },
  {
    "id": "sent_3",
    "text": "她不仅在创作上开创了独树一帜的 “易安体”，",
    "start": 7.357,
    "end": 11.563,
    "duration": 4.206
  },
  {
    "id": "sent_4",
    "text": "更在词论上建立了具有独立文体自觉的理论体系。",
    "start": 11.563,
    "end": 16.107,
    "duration": 4.544
  },
  {
    "id": "sent_5",
    "text": "李清照词作风格的演进历程及其理论贡献，",
    "start": 16.107,
    "end": 20.677,
    "duration": 4.57
  },
  {
    "id": "sent_6",
    "text": "主要展现为以下三个核心维度：",
    "start": 20.677,
    "end": 23.958,
    "duration": 3.281
  },
  {
    "id": "sent_7",
    "text": "第一，在《词论》中提出“词别是一家”的主张，",
    "start": 23.958,
    "end": 27.76,
    "duration": 3.802
  },
  {
    "id": "sent_8",
    "text": "确立词体独立的文体边界与声律典范。",
    "start": 27.76,
    "end": 31.497,
    "duration": 3.737
  },
  {
    "id": "sent_9",
    "text": "李清照在著名理论专论 《词论》 中，系统梳理了词的发展史，",
    "start": 31.497,
    "end": 36.484,
    "duration": 4.987
  },
  {
    "id": "sent_10",
    "text": "明确提出 “词别是一家” 的纲领性论断。",
    "start": 36.484,
    "end": 39.922,
    "duration": 3.438
  },
  {
    "id": "sent_11",
    "text": "她强调词作为一种独立的新文体，必须严格恪守其自身独特的艺术规范：",
    "start": 39.922,
    "end": 46.797,
    "duration": 6.875
  },
  {
    "id": "sent_12",
    "text": "一是高度重视协律与音乐美，讲求五音六律与清浊轻重，",
    "start": 46.797,
    "end": 52.448,
    "duration": 5.651
  },
  {
    "id": "sent_13",
    "text": "批评苏轼、欧阳修等人虽博学高妙，却 “往往不协音律”，",
    "start": 52.448,
    "end": 57.8,
    "duration": 5.352
  },
  {
    "id": "sent_14",
    "text": "直指其为 “句读不葺之诗”；",
    "start": 57.799,
    "end": 60.364,
    "duration": 2.565
  },
  {
    "id": "sent_15",
    "text": "二是主张 “尚雅”，批评柳永词调虽合音律却 “词语尘下”，",
    "start": 60.365,
    "end": 65.625,
    "duration": 5.26
  },
  {
    "id": "sent_16",
    "text": "缺乏典雅品格；",
    "start": 65.625,
    "end": 67.578,
    "duration": 1.953
  },
  {
    "id": "sent_17",
    "text": "三是提倡用典精审与感情真挚。",
    "start": 67.578,
    "end": 70.976,
    "duration": 3.398
  },
  {
    "id": "sent_18",
    "text": "这一主张有力维护了词体的本体独立性，",
    "start": 70.977,
    "end": 74.87,
    "duration": 3.893
  },
  {
    "id": "sent_19",
    "text": "确立了词体纯正的音乐与文体格范。",
    "start": 74.87,
    "end": 78.36,
    "duration": 3.49
  },
  {
    "id": "sent_20",
    "text": "第二，以南渡为界展现由前期清新明丽向后期凄凉沉痛的历史演进。",
    "start": 78.359,
    "end": 85.026,
    "duration": 6.667
  },
  {
    "id": "sent_21",
    "text": "靖康之变的国破家亡与流离失所，使李清照的词作风格发生了深刻裂变。",
    "start": 85.026,
    "end": 92.044,
    "duration": 7.018
  },
  {
    "id": "sent_22",
    "text": "前期生活优渥圆满，词作多描写少女闺中情趣与相思离愁，",
    "start": 92.044,
    "end": 97.851,
    "duration": 5.807
  },
  {
    "id": "sent_23",
    "text": "如 《如梦令》 中的 “常记溪亭日暮，沉醉不知归路”，",
    "start": 97.852,
    "end": 102.526,
    "duration": 4.674
  },
  {
    "id": "sent_24",
    "text": "洋溢着青春欢愉与对自然人生的热爱；",
    "start": 102.526,
    "end": 106.224,
    "duration": 3.698
  },
  {
    "id": "sent_25",
    "text": "南渡以后，",
    "start": 106.224,
    "end": 107.617,
    "duration": 1.393
  },
  {
    "id": "sent_26",
    "text": "面对金兵侵凌、国土沦丧、丈夫赵明诚病故与半生金石文物丧失的沉重打击，",
    "start": 107.617,
    "end": 115.312,
    "duration": 7.695
  },
  {
    "id": "sent_27",
    "text": "词作转入对漂泊身世与家国沦亡的悲叹，",
    "start": 115.313,
    "end": 119.505,
    "duration": 4.192
  },
  {
    "id": "sent_28",
    "text": "如 《声声慢》 中开篇连用十四个叠字 “寻寻觅觅，冷冷清清，",
    "start": 119.505,
    "end": 124.987,
    "duration": 5.482
  },
  {
    "id": "sent_29",
    "text": "凄凄惨惨戚戚”，极写晚年孤苦无依的凄凉绝境，",
    "start": 124.986,
    "end": 129.687,
    "duration": 4.701
  },
  {
    "id": "sent_30",
    "text": "将个人流离与国家动荡紧密交融，词风深沉凄苦、格调苍凉。",
    "start": 129.688,
    "end": 136.277,
    "duration": 6.589
  },
  {
    "id": "sent_31",
    "text": "第三，擅用家常口语入词与精工炼字，",
    "start": 136.276,
    "end": 140.26,
    "duration": 3.984
  },
  {
    "id": "sent_32",
    "text": "形成自然纯朴的“易安体”语言风范。",
    "start": 140.26,
    "end": 143.502,
    "duration": 3.242
  },
  {
    "id": "sent_33",
    "text": "在语言表现上，李清照开创了自然天成的语言风格。",
    "start": 143.503,
    "end": 148.256,
    "duration": 4.753
  },
  {
    "id": "sent_34",
    "text": "她善于化寻常口语为精妙词句，如 “生怕闲愁暗恨，",
    "start": 148.255,
    "end": 153.893,
    "duration": 5.638
  },
  {
    "id": "sent_35",
    "text": "多少事、欲说还休”，大白若浅却深挚感人；",
    "start": 153.893,
    "end": 158.503,
    "duration": 4.61
  },
  {
    "id": "sent_36",
    "text": "同时精于炼字造境，",
    "start": 158.503,
    "end": 160.808,
    "duration": 2.305
  },
  {
    "id": "sent_37",
    "text": "如 《如梦令》 中以 “绿肥红瘦” 描写暮春雨后景象，清新脱俗，",
    "start": 160.807,
    "end": 166.627,
    "duration": 5.82
  },
  {
    "id": "sent_38",
    "text": "展现出极高超的语言表现力。",
    "start": 166.628,
    "end": 169.636,
    "duration": 3.008
  }
]