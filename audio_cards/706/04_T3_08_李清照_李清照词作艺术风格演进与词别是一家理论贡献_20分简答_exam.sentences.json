[
  {
    "id": 1,
    "text": "简述李清照词作艺术风格的演进历程及其“词别是一家”的理论贡献。",
    "start": 0.134,
    "end": 5.146,
    "duration": 5.012
  },
  {
    "id": 2,
    "text": "李清照是两宋之交杰出的婉约词派代表词人，自成“易安体”，在词作与词论上均贡献卓著。",
    "start": 5.823,
    "end": 12.875,
    "duration": 7.052
  },
  {
    "id": 3,
    "text": "其词风演进历程与“词别是一家”的理论主张，主要体现在以下三个方面：",
    "start": 13.513,
    "end": 23.605,
    "duration": 10.092
  },
  {
    "id": 4,
    "text": "第一，在《词论》中提出“词别是一家”，从本体上确立词体独立地位。",
    "start": 24.243,
    "end": 31.215,
    "duration": 6.972
  },
  {
    "id": 5,
    "text": "李清照在《词论》中系统回顾词史，明确提出“词别是一家”的纲领，将词与诗严格区分开来。",
    "start": 31.933,
    "end": 43.465,
    "duration": 11.532
  },
  {
    "id": 6,
    "text": "她强调词对音律与节奏有独特要求，须“分五音，又分五声，又分六律，又分清浊轻重”，",
    "start": 44.143,
    "end": 45.955,
    "duration": 1.812
  },
  {
    "id": 7,
    "text": "批评苏轼、欧阳修词“往往不协音律”，直指其为“句读不葺之诗”；",
    "start": 46.334,
    "end": 47.946,
    "duration": 1.612
  },
  {
    "id": 8,
    "text": "同时推崇词格高雅典重，批评柳永词“词语尘下”，并主张铺叙曲折、讲究故实与情致浑成。",
    "start": 48.475,
    "end": 51.527,
    "duration": 3.052
  },
  {
    "id": 9,
    "text": "这一主张有力维护了词作为独立抒情文体的艺术边界。",
    "start": 52.205,
    "end": 56.057,
    "duration": 3.852
  },
  {
    "id": 10,
    "text": "第二，以南渡为界，词风由前期清丽明快转为后期沉痛苍凉。",
    "start": 56.735,
    "end": 62.067,
    "duration": 5.332
  },
  {
    "id": 11,
    "text": "靖康之变带来的国破家亡与流离孤苦，使李清照词风发生鲜明转折。",
    "start": 62.785,
    "end": 68.157,
    "duration": 5.372
  },
  {
    "id": 12,
    "text": "前期生活美满，多写闺中情趣、自然游赏与甜蜜相思，",
    "start": 68.875,
    "end": 69.967,
    "duration": 1.092
  },
  {
    "id": 13,
    "text": "如《如梦令》“常记溪亭日暮，沉醉不知归路”，清丽轻快、生机盎然；",
    "start": 70.346,
    "end": 73.278,
    "duration": 2.932
  },
  {
    "id": 14,
    "text": "南渡之后，历经夫亡物散与飘零之苦，词境转为沉重哀伤，",
    "start": 73.807,
    "end": 75.819,
    "duration": 2.012
  },
  {
    "id": 15,
    "text": "如《声声慢》开篇连用十四个叠字“寻寻觅觅，冷冷清清，凄凄惨惨戚戚”，",
    "start": 76.198,
    "end": 77.33,
    "duration": 1.132
  },
  {
    "id": 16,
    "text": "将晚年孤寂与家国悲痛交融一处，格调凄苦苍凉。",
    "start": 77.709,
    "end": 79.281,
    "duration": 1.572
  },
  {
    "id": 17,
    "text": "第三，善用寻常口语与白描炼字，开创清新素雅的“易安体”语言风范。",
    "start": 79.959,
    "end": 101.099,
    "duration": 21.14
  },
  {
    "id": 18,
    "text": "李清照词善于选取日常生活细节展现微妙心理，以浅近明白的家常语言传出深情，",
    "start": 101.628,
    "end": 108.32,
    "duration": 6.692
  },
  {
    "id": 19,
    "text": "如《凤凰台上忆吹箫》“生怕离怀别苦，多少事、欲说还休”，自然浅淡却真挚动人；",
    "start": 108.699,
    "end": 116.118,
    "duration": 7.419
  },
  {
    "id": 20,
    "text": "又长于白描造境与精工炼字，如“绿肥红瘦”“人比黄花瘦”，",
    "start": 116.647,
    "end": 123.339,
    "duration": 6.692
  },
  {
    "id": 21,
    "text": "素雅清婉、风韵天成，使“易安体”成为宋代婉约词坛的杰出风范。",
    "start": 123.932,
    "end": 127.144,
    "duration": 3.212
  }
]