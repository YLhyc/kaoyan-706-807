[
  {
    "id": 1,
    "text": "简述李清照词作艺术风格的演进历程及其“词别是一家”的理论主张与贡献。",
    "start": 0.0,
    "end": 6.181,
    "duration": 6.181
  },
  {
    "id": 2,
    "text": "李清照是两宋之交成就卓绝的婉约词派代表词人，",
    "start": 6.181,
    "end": 10.326,
    "duration": 4.145
  },
  {
    "id": 3,
    "text": "被誉为 “词家一大宗”。",
    "start": 10.326,
    "end": 11.995,
    "duration": 1.669
  },
  {
    "id": 4,
    "text": "她不仅在创作上开创了独树一帜的 “易安体”，",
    "start": 11.995,
    "end": 15.193,
    "duration": 3.198
  },
  {
    "id": 5,
    "text": "更在词论上建立了具有独立文体自觉的理论体系。",
    "start": 15.193,
    "end": 19.018,
    "duration": 3.825
  },
  {
    "id": 6,
    "text": "李清照词作风格的演进历程及其理论贡献，",
    "start": 19.018,
    "end": 22.658,
    "duration": 3.64
  },
  {
    "id": 7,
    "text": "主要展现为以下三个核心维度：",
    "start": 22.658,
    "end": 25.194,
    "duration": 2.536
  },
  {
    "id": 8,
    "text": "第一，在《词论》中提出“词别是一家”的主张，",
    "start": 25.194,
    "end": 29.262,
    "duration": 4.068
  },
  {
    "id": 9,
    "text": "确立词体独立的文体边界与声律典范。",
    "start": 29.262,
    "end": 32.851,
    "duration": 3.589
  },
  {
    "id": 10,
    "text": "李清照在著名理论专论 《词论》 中，",
    "start": 32.851,
    "end": 35.412,
    "duration": 2.561
  },
  {
    "id": 11,
    "text": "系统梳理了词的发展史，",
    "start": 35.412,
    "end": 37.602,
    "duration": 2.19
  },
  {
    "id": 12,
    "text": "明确提出 “词别是一家” 的纲领性论断。",
    "start": 37.602,
    "end": 43.719,
    "duration": 6.117
  },
  {
    "id": 13,
    "text": "她强调词作为一种独立的新文体，",
    "start": 43.719,
    "end": 47.219,
    "duration": 3.5
  },
  {
    "id": 14,
    "text": "必须严格恪守其自身独特的艺术规范：",
    "start": 47.219,
    "end": 50.081,
    "duration": 2.862
  },
  {
    "id": 15,
    "text": "一是高度重视协律与音乐美，讲求五音六律与清浊轻重，",
    "start": 50.081,
    "end": 56.396,
    "duration": 6.315
  },
  {
    "id": 16,
    "text": "批评苏轼、欧阳修等人虽博学高妙，却 “往往不协音律”，",
    "start": 56.396,
    "end": 62.366,
    "duration": 5.97
  },
  {
    "id": 17,
    "text": "直指其为 “句读不葺之诗”；二是主张 “尚雅”，",
    "start": 62.366,
    "end": 67.301,
    "duration": 4.935
  },
  {
    "id": 18,
    "text": "批评柳永词调虽合音律却 “词语尘下”，缺乏典雅品格；",
    "start": 67.301,
    "end": 73.841,
    "duration": 6.54
  },
  {
    "id": 19,
    "text": "三是提倡用典精审与感情真挚。",
    "start": 73.841,
    "end": 76.874,
    "duration": 3.033
  },
  {
    "id": 20,
    "text": "这一主张有力维护了词体的本体独立性，",
    "start": 76.874,
    "end": 80.556,
    "duration": 3.682
  },
  {
    "id": 21,
    "text": "确立了词体纯正的音乐与文体格范。",
    "start": 80.556,
    "end": 83.232,
    "duration": 2.676
  },
  {
    "id": 22,
    "text": "第二，以南渡为界展现由前期清新明丽向后期凄凉沉痛的历史演进。",
    "start": 83.232,
    "end": 90.8,
    "duration": 7.568
  },
  {
    "id": 23,
    "text": "靖康之变的国破家亡与流离失所，",
    "start": 90.8,
    "end": 93.217,
    "duration": 2.417
  },
  {
    "id": 24,
    "text": "使李清照的词作风格发生了深刻裂变。",
    "start": 93.217,
    "end": 97.086,
    "duration": 3.869
  },
  {
    "id": 25,
    "text": "前期生活优渥圆满，词作多描写少女闺中情趣与相思离愁，",
    "start": 97.086,
    "end": 103.723,
    "duration": 6.637
  },
  {
    "id": 26,
    "text": "如 《如梦令》 中的 “常记溪亭日暮，沉醉不知归路”，",
    "start": 103.723,
    "end": 105.935,
    "duration": 2.212
  },
  {
    "id": 27,
    "text": "洋溢着青春欢愉与对自然人生的热爱；南渡以后，",
    "start": 105.935,
    "end": 112.048,
    "duration": 6.113
  },
  {
    "id": 28,
    "text": "面对金兵侵凌、国土沦丧、",
    "start": 112.048,
    "end": 114.599,
    "duration": 2.551
  },
  {
    "id": 29,
    "text": "丈夫赵明诚病故与半生金石文物丧失的沉重打击，",
    "start": 114.599,
    "end": 120.728,
    "duration": 6.129
  },
  {
    "id": 30,
    "text": "词作转入对漂泊身世与家国沦亡的悲叹，",
    "start": 120.728,
    "end": 123.693,
    "duration": 2.965
  },
  {
    "id": 31,
    "text": "如 《声声慢》 中开篇连用十四个叠字 “寻寻觅觅，",
    "start": 123.693,
    "end": 125.961,
    "duration": 2.268
  },
  {
    "id": 32,
    "text": "冷冷清清，凄凄惨惨戚戚”，极写晚年孤苦无依的凄凉绝境，",
    "start": 125.961,
    "end": 132.532,
    "duration": 6.571
  },
  {
    "id": 33,
    "text": "将个人流离与国家动荡紧密交融，词风深沉凄苦、格调苍凉。",
    "start": 132.532,
    "end": 136.445,
    "duration": 3.913
  },
  {
    "id": 34,
    "text": "第三，擅用家常口语入词与精工炼字，",
    "start": 136.445,
    "end": 139.138,
    "duration": 2.693
  },
  {
    "id": 35,
    "text": "形成自然纯朴的“易安体”语言风范。",
    "start": 139.138,
    "end": 142.262,
    "duration": 3.124
  },
  {
    "id": 36,
    "text": "在语言表现上，李清照开创了自然天成的语言风格。",
    "start": 142.262,
    "end": 144.121,
    "duration": 1.859
  },
  {
    "id": 37,
    "text": "她善于化寻常口语为精妙词句，如 “生怕闲愁暗恨，多少事、",
    "start": 144.121,
    "end": 145.842,
    "duration": 1.721
  },
  {
    "id": 38,
    "text": "欲说还休”，大白若浅却深挚感人；同时精于炼字造境，",
    "start": 145.842,
    "end": 149.635,
    "duration": 3.793
  },
  {
    "id": 39,
    "text": "如 《如梦令》 中以 “绿肥红瘦” 描写暮春雨后景象，",
    "start": 149.635,
    "end": 150.741,
    "duration": 1.106
  },
  {
    "id": 40,
    "text": "清新脱俗，展现出极高超的语言表现力。",
    "start": 150.741,
    "end": 152.561,
    "duration": 1.82
  }
]