[
  {
    "id": 1,
    "text": "简述李清照词作艺术风格的演进历程及其“词别是一家”的理论贡献。",
    "start": 0.115,
    "end": 5.431,
    "duration": 5.316
  },
  {
    "id": 2,
    "text": "李清照是两宋之交杰出的婉约词派代表词人，自成“易安体”，",
    "start": 6.11,
    "end": 10.811,
    "duration": 4.701
  },
  {
    "id": 3,
    "text": "在词作与词论上均贡献卓著。",
    "start": 11.111,
    "end": 13.429,
    "duration": 2.318
  },
  {
    "id": 4,
    "text": "其词风演进历程与“词别是一家”的理论主张，",
    "start": 13.886,
    "end": 17.215,
    "duration": 3.329
  },
  {
    "id": 5,
    "text": "主要体现在以下三个方面：",
    "start": 17.409,
    "end": 19.059,
    "duration": 1.65
  },
  {
    "id": 6,
    "text": "第一，在《词论》中提出“词别是一家”，",
    "start": 19.677,
    "end": 23.151,
    "duration": 3.474
  },
  {
    "id": 7,
    "text": "从本体上确立词体独立地位。",
    "start": 23.484,
    "end": 25.868,
    "duration": 2.384
  },
  {
    "id": 8,
    "text": "李清照在《词论》中系统回顾词史，",
    "start": 26.304,
    "end": 29.144,
    "duration": 2.84
  },
  {
    "id": 9,
    "text": "明确提出“词别是一家”的纲领，将词与诗严格区分开来。",
    "start": 29.299,
    "end": 34.246,
    "duration": 4.947
  },
  {
    "id": 10,
    "text": "她强调词对音律与节奏有独特要求，须“分五音，又分五声，",
    "start": 34.767,
    "end": 40.464,
    "duration": 5.697
  },
  {
    "id": 11,
    "text": "又分六律，又分清浊轻重”，批评苏轼、",
    "start": 40.726,
    "end": 44.139,
    "duration": 3.413
  },
  {
    "id": 12,
    "text": "欧阳修词“往往不协音律”，直指其为“句读不葺之诗”；",
    "start": 44.406,
    "end": 48.956,
    "duration": 4.55
  },
  {
    "id": 13,
    "text": "同时推崇词格高雅典重，批评柳永词“词语尘下”，",
    "start": 49.434,
    "end": 53.965,
    "duration": 4.531
  },
  {
    "id": 14,
    "text": "并主张铺叙曲折、讲究故实与情致浑成。",
    "start": 54.291,
    "end": 57.943,
    "duration": 3.652
  },
  {
    "id": 15,
    "text": "这一主张有力维护了词作为独立抒情文体的艺术边界。",
    "start": 58.359,
    "end": 62.37,
    "duration": 4.011
  },
  {
    "id": 16,
    "text": "第二，以南渡为界，词风由前期清丽明快转为后期沉痛苍凉。",
    "start": 63.01,
    "end": 69.086,
    "duration": 6.076
  },
  {
    "id": 17,
    "text": "靖康之变带来的国破家亡与流离孤苦，使李清照词风发生鲜明转折。",
    "start": 69.523,
    "end": 75.361,
    "duration": 5.838
  },
  {
    "id": 18,
    "text": "前期生活美满，多写闺中情趣、自然游赏与甜蜜相思，",
    "start": 75.702,
    "end": 80.419,
    "duration": 4.717
  },
  {
    "id": 19,
    "text": "如《如梦令》“常记溪亭日暮，沉醉不知归路”，清丽轻快、",
    "start": 80.704,
    "end": 85.337,
    "duration": 4.633
  },
  {
    "id": 20,
    "text": "生机盎然；南渡之后，历经夫亡物散与飘零之苦，",
    "start": 85.645,
    "end": 90.593,
    "duration": 4.948
  },
  {
    "id": 21,
    "text": "词境转为沉重哀伤，",
    "start": 90.92,
    "end": 92.728,
    "duration": 1.808
  },
  {
    "id": 22,
    "text": "如《声声慢》开篇连用十四个叠字“寻寻觅觅，冷冷清清，",
    "start": 93.345,
    "end": 98.174,
    "duration": 4.829
  },
  {
    "id": 23,
    "text": "凄凄惨惨戚戚”，将晚年孤寂与家国悲痛交融一处，",
    "start": 98.285,
    "end": 103.105,
    "duration": 4.82
  },
  {
    "id": 24,
    "text": "格调凄苦苍凉。",
    "start": 103.32,
    "end": 104.858,
    "duration": 1.538
  },
  {
    "id": 25,
    "text": "第三，善用寻常口语与白描炼字，",
    "start": 105.545,
    "end": 108.561,
    "duration": 3.016
  },
  {
    "id": 26,
    "text": "开创清新素雅的“易安体”语言风范。",
    "start": 108.917,
    "end": 111.904,
    "duration": 2.987
  },
  {
    "id": 27,
    "text": "李清照词善于选取日常生活细节展现微妙心理，",
    "start": 112.172,
    "end": 116.034,
    "duration": 3.862
  },
  {
    "id": 28,
    "text": "以浅近明白的家常语言传出深情，",
    "start": 116.388,
    "end": 119.218,
    "duration": 2.83
  },
  {
    "id": 29,
    "text": "如《凤凰台上忆吹箫》“生怕离怀别苦，多少事、欲说还休”，",
    "start": 119.578,
    "end": 124.687,
    "duration": 5.109
  },
  {
    "id": 30,
    "text": "自然浅淡却真挚动人；又长于白描造境与精工炼字，",
    "start": 125.022,
    "end": 129.886,
    "duration": 4.864
  },
  {
    "id": 31,
    "text": "如“绿肥红瘦”“人比黄花瘦”，素雅清婉、风韵天成，",
    "start": 130.483,
    "end": 135.488,
    "duration": 5.005
  },
  {
    "id": 32,
    "text": "使“易安体”成为宋代婉约词坛的杰出风范。",
    "start": 135.761,
    "end": 139.286,
    "duration": 3.525
  }
]