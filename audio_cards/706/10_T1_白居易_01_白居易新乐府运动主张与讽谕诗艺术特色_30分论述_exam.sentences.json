[
  {
    "id": 1,
    "text": "白居易是中唐新乐府运动的杰出领袖，",
    "start": 0.08,
    "end": 3.36,
    "duration": 3.28
  },
  {
    "id": 2,
    "text": "他与元稹共同倡导了中国古代文学史上最具自觉批判精神的诗歌革新浪潮。",
    "start": 3.36,
    "end": 9.2,
    "duration": 5.84
  },
  {
    "id": 3,
    "text": "针对中唐安史之乱后藩镇割据、宦官专权与民生凋敝的残酷现实，",
    "start": 9.2,
    "end": 14.56,
    "duration": 5.36
  },
  {
    "id": 4,
    "text": "白居易上承《诗经》六义与杜甫“诗史”传统，",
    "start": 14.56,
    "end": 17.76,
    "duration": 3.2
  },
  {
    "id": 5,
    "text": "在《与元九书》中系统建构了现实主义诗学纲领。",
    "start": 17.76,
    "end": 21.2,
    "duration": 3.44
  },
  {
    "id": 6,
    "text": "他以高度的政治使命感开辟了以《新乐府》和《秦中吟》为代表的讽谕诗创作，",
    "start": 21.52,
    "end": 28.24,
    "duration": 6.72
  },
  {
    "id": 7,
    "text": "将中国古典诗歌干预现实的政教功能推向了历史巅峰。",
    "start": 28.24,
    "end": 33.52,
    "duration": 5.28
  },
  {
    "id": 8,
    "text": "首先，白居易在理论上确立了“文章合为时而著，",
    "start": 33.52,
    "end": 37.76,
    "duration": 4.24
  },
  {
    "id": 9,
    "text": "歌诗合为事而作”的划时代主张。",
    "start": 37.76,
    "end": 40.8,
    "duration": 3.04
  },
  {
    "id": 10,
    "text": "针对六朝以来雕章琢句、脱离现实的唯美颓风，",
    "start": 40.8,
    "end": 45.28,
    "duration": 4.48
  },
  {
    "id": 11,
    "text": "白居易强调诗歌必须紧扣时代脉搏、",
    "start": 45.28,
    "end": 48.48,
    "duration": 3.2
  },
  {
    "id": 12,
    "text": "关切现实社会。",
    "start": 48.48,
    "end": 49.68,
    "duration": 1.2
  },
  {
    "id": 13,
    "text": "在《与元九书》中，他提出诗歌应当“上以补察时政，",
    "start": 49.92,
    "end": 54.96,
    "duration": 5.04
  },
  {
    "id": 14,
    "text": "下以泄导人情”，把诗歌明确定位为国家政治治理与民众情感疏导的双向利器。",
    "start": 54.96,
    "end": 62.16,
    "duration": 7.2
  },
  {
    "id": 15,
    "text": "在诗歌生成机制上，他提炼出“根情，",
    "start": 62.16,
    "end": 65.28,
    "duration": 3.12
  },
  {
    "id": 16,
    "text": "苗言，华声，实义”的经典理论，将思想批判的“实义”确立为诗歌的根本宗旨。",
    "start": 65.28,
    "end": 71.12,
    "duration": 5.84
  },
  {
    "id": 17,
    "text": "他更发出“唯歌生民病，愿得天子知”的博大誓言，",
    "start": 71.36,
    "end": 76.08,
    "duration": 4.72
  },
  {
    "id": 18,
    "text": "明确了诗歌为底层黎民疾苦请命的崇高价值取向。",
    "start": 76.08,
    "end": 80.72,
    "duration": 4.64
  },
  {
    "id": 19,
    "text": "其次，在讽谕诗的创作实践中，白居易展现出直面现实矛盾的深刻批判锋芒。",
    "start": 80.72,
    "end": 87.84,
    "duration": 7.12
  },
  {
    "id": 20,
    "text": "他的讽谕诗以天下苍生为念，真实记录了中唐社会阶级对立的血泪画卷。",
    "start": 87.84,
    "end": 94.48,
    "duration": 6.64
  },
  {
    "id": 21,
    "text": "《秦中吟》其一《重赋》直陈“私家无钱炉，",
    "start": 94.72,
    "end": 98.09,
    "duration": 3.37
  },
  {
    "id": 22,
    "text": "平地无铜山。",
    "start": 98.09,
    "end": 99.293,
    "duration": 1.203
  },
  {
    "id": 23,
    "text": "胡为秋夏税，岁岁催升合”，痛斥赋税苛繁剥削下民之苦。",
    "start": 99.293,
    "end": 104.589,
    "duration": 5.296
  },
  {
    "id": 24,
    "text": "《新乐府》中的经典名篇《卖炭翁》，",
    "start": 104.589,
    "end": 107.478,
    "duration": 2.889
  },
  {
    "id": 25,
    "text": "细致刻画了“满面尘灰烟黑色，两鬓苍苍十指黑”的老翁形象，",
    "start": 107.478,
    "end": 113.255,
    "duration": 5.777
  },
  {
    "id": 26,
    "text": "以“半匹红消一丈灵，系向牛头充炭直”的残酷对照，",
    "start": 113.255,
    "end": 118.069,
    "duration": 4.814
  },
  {
    "id": 27,
    "text": "将宦官“宫市”巧取豪夺的罪恶暴露无遗。",
    "start": 118.069,
    "end": 121.92,
    "duration": 3.851
  },
  {
    "id": 28,
    "text": "诗作真实无妄地反映了社会的深层黑暗，",
    "start": 122.08,
    "end": 125.44,
    "duration": 3.36
  },
  {
    "id": 29,
    "text": "体现出强烈的批判现实主义品格。",
    "start": 125.44,
    "end": 127.76,
    "duration": 2.32
  },
  {
    "id": 30,
    "text": "再次，在艺术表现上，白居易讽谕诗形成了章法严整与通俗晓畅的美学风貌。",
    "start": 128.224,
    "end": 135.024,
    "duration": 6.8
  },
  {
    "id": 31,
    "text": "在章法体制上，他践行“首句标其目，",
    "start": 135.024,
    "end": 138.544,
    "duration": 3.52
  },
  {
    "id": 32,
    "text": "卒章显其志”的结构范式。",
    "start": 138.544,
    "end": 140.704,
    "duration": 2.16
  },
  {
    "id": 33,
    "text": "诗歌题目即点明所讽主题，尾句以强烈议论直接阐发讽谕主旨，",
    "start": 140.704,
    "end": 146.784,
    "duration": 6.08
  },
  {
    "id": 34,
    "text": "如《观意麦》尾联以“念此私自愧，",
    "start": 146.784,
    "end": 150.144,
    "duration": 3.36
  },
  {
    "id": 35,
    "text": "尽日不能忘”表达士大夫的反躬自省。",
    "start": 150.144,
    "end": 153.264,
    "duration": 3.12
  },
  {
    "id": 36,
    "text": "在语言风格上，他追求“其言直而切，",
    "start": 153.584,
    "end": 156.944,
    "duration": 3.36
  },
  {
    "id": 37,
    "text": "其事核而实，其体顺而肆”。",
    "start": 156.944,
    "end": 159.664,
    "duration": 2.72
  },
  {
    "id": 38,
    "text": "白居易摆脱了古雅生僻词汇，大量汲取民间生动口语，",
    "start": 159.664,
    "end": 163.664,
    "duration": 4.0
  },
  {
    "id": 39,
    "text": "相传达到“老域能解”的极高通俗化境界，",
    "start": 163.664,
    "end": 166.864,
    "duration": 3.2
  },
  {
    "id": 40,
    "text": "极大强化了诗歌的社会传播力与道德教化力。",
    "start": 166.864,
    "end": 170.384,
    "duration": 3.52
  },
  {
    "id": 41,
    "text": "最后，白居易的新乐府主张与讽谕诗创作树立了中国古代现实主义诗歌的不朽丰碑。",
    "start": 170.384,
    "end": 176.304,
    "duration": 5.92
  },
  {
    "id": 42,
    "text": "尽管其部分篇章因政治目的过强而略带议论过露之憾，",
    "start": 176.624,
    "end": 181.504,
    "duration": 4.88
  },
  {
    "id": 43,
    "text": "但他将文学创作自觉融入拯救苍生与改良时政的博大胸襟，",
    "start": 181.504,
    "end": 186.464,
    "duration": 4.96
  },
  {
    "id": 44,
    "text": "深刻启迪了宋代欧阳修、王安石、苏轼等诗文革新运动名家，",
    "start": 186.464,
    "end": 191.504,
    "duration": 5.04
  },
  {
    "id": 45,
    "text": "成为中国文人忧国恤民精神传统的最强音。",
    "start": 191.504,
    "end": 194.944,
    "duration": 3.44
  }
]