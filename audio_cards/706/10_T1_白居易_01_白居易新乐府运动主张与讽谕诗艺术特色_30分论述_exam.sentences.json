[
  {
    "id": 1,
    "text": "为了开篇直击考点要害并确立学术基调，",
    "start": 0.08,
    "end": 3.68,
    "duration": 3.6
  },
  {
    "id": 2,
    "text": "第一句必须给出白居易在中唐诗坛的宗师领袖地位与新乐府运动性质。",
    "start": 3.68,
    "end": 10.48,
    "duration": 6.8
  },
  {
    "id": 3,
    "text": "所以表述为：白居易是中唐新乐府运动的杰出领袖，",
    "start": 10.48,
    "end": 15.12,
    "duration": 4.64
  },
  {
    "id": 4,
    "text": "他与元稹共同倡导了中国古代文学史上最具自觉批判精神的诗歌革新浪潮。。",
    "start": 15.12,
    "end": 21.68,
    "duration": 6.56
  },
  {
    "id": 5,
    "text": "紧接着必须点明新乐府运动爆发的时代土壤，",
    "start": 22.0,
    "end": 26.0,
    "duration": 4.0
  },
  {
    "id": 6,
    "text": "展现历史背景与现实诱因。",
    "start": 26.0,
    "end": 28.48,
    "duration": 2.48
  },
  {
    "id": 7,
    "text": "所以表述为：针对中唐安史之乱后藩镇割据、",
    "start": 28.48,
    "end": 32.24,
    "duration": 3.76
  },
  {
    "id": 8,
    "text": "宦官专权与民生凋敝的残酷现实，白居易上承《诗经》六义与杜甫“诗史”传统，",
    "start": 32.24,
    "end": 39.04,
    "duration": 6.8
  },
  {
    "id": 9,
    "text": "在《与元九书》中系统建构了现实主义诗学纲领。。",
    "start": 39.04,
    "end": 42.72,
    "duration": 3.68
  },
  {
    "id": 10,
    "text": "最后一句必须将理论纲领引渡至题目要求的核心创作载体上，",
    "start": 42.96,
    "end": 47.76,
    "duration": 4.8
  },
  {
    "id": 11,
    "text": "完成全篇立论收束。",
    "start": 47.76,
    "end": 49.76,
    "duration": 2.0
  },
  {
    "id": 12,
    "text": "所以表述为：他以高度的政治使命感开辟了以《新乐府》和《秦中吟》为代表的讽谕诗创作，",
    "start": 49.76,
    "end": 57.44,
    "duration": 7.68
  },
  {
    "id": 13,
    "text": "将中国古典诗歌干预现实的政教功能推向了历史巅峰。。",
    "start": 57.44,
    "end": 62.16,
    "duration": 4.72
  },
  {
    "id": 14,
    "text": "本段用三句话完成全篇破题：首句给出新乐府运动领袖地位与批判精神，",
    "start": 62.48,
    "end": 68.72,
    "duration": 6.24
  },
  {
    "id": 15,
    "text": "次句交代安史之乱后的时代危机与杜甫诗史渊源，",
    "start": 68.72,
    "end": 72.96,
    "duration": 4.24
  },
  {
    "id": 16,
    "text": "末句点明《与元九书》纲领与讽谕诗创作实践，",
    "start": 72.96,
    "end": 77.28,
    "duration": 4.32
  },
  {
    "id": 17,
    "text": "下笔宏阔，紧扣题旨。",
    "start": 77.28,
    "end": 79.2,
    "duration": 1.92
  },
  {
    "id": 18,
    "text": "所以本段具体答题完整版为：白居易是中唐新乐府运动的杰出领袖，",
    "start": 79.2,
    "end": 84.64,
    "duration": 5.44
  },
  {
    "id": 19,
    "text": "他与元稹共同倡导了中国古代文学史上最具自觉批判精神的诗歌革新浪潮。",
    "start": 84.64,
    "end": 90.48,
    "duration": 5.84
  },
  {
    "id": 20,
    "text": "针对中唐安史之乱后藩镇割据、宦官专权与民生凋敝的残酷现实，",
    "start": 90.48,
    "end": 95.84,
    "duration": 5.36
  },
  {
    "id": 21,
    "text": "白居易上承《诗经》六义与杜甫“诗史”传统，",
    "start": 95.84,
    "end": 99.04,
    "duration": 3.2
  },
  {
    "id": 22,
    "text": "在《与元九书》中系统建构了现实主义诗学纲领。",
    "start": 99.04,
    "end": 102.48,
    "duration": 3.44
  },
  {
    "id": 23,
    "text": "他以高度的政治使命感开辟了以《新乐府》和《秦中吟》为代表的讽谕诗创作，",
    "start": 102.8,
    "end": 108.96,
    "duration": 6.16
  },
  {
    "id": 24,
    "text": "将中国古典诗歌干预现实的政教功能推向了历史巅峰。--",
    "start": 108.96,
    "end": 113.68,
    "duration": 4.72
  }
]