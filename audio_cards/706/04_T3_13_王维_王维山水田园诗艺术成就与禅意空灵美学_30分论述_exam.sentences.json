[
  {
    "id": 1,
    "text": "试论王维山水田园诗的艺术成就与禅意空灵美学。",
    "start": 0.28,
    "end": 4.6,
    "duration": 4.32
  },
  {
    "id": 2,
    "text": "王维是盛唐山水田园诗派最具代表性的大家。",
    "start": 5.12,
    "end": 8.88,
    "duration": 3.76
  },
  {
    "id": 3,
    "text": "他早年怀抱功名热望，也曾赴边塞幕府写下壮阔边声，",
    "start": 9.4,
    "end": 14.36,
    "duration": 4.96
  },
  {
    "id": 4,
    "text": "经历仕途起伏与晚年隐居辋川别业后，将画理、音律与大乘禅理融入自然山水观照，",
    "start": 14.73,
    "end": 22.41,
    "duration": 7.68
  },
  {
    "id": 5,
    "text": "创造出静逸明秀、兴象玲珑的纯美诗境，把唐代山水诗推向空灵澄明的新境界。",
    "start": 22.78,
    "end": 30.14,
    "duration": 7.36
  },
  {
    "id": 6,
    "text": "其艺术成就主要体现在以下四个方面：",
    "start": 30.694,
    "end": 33.38,
    "duration": 2.686
  },
  {
    "id": 7,
    "text": "第一，融画法音律于写景，营造“诗中有画，画中有诗”的空间美感。",
    "start": 33.75,
    "end": 39.43,
    "duration": 5.68
  },
  {
    "id": 8,
    "text": "苏轼曾评王维“诗中有画，画中有诗”。",
    "start": 39.95,
    "end": 43.07,
    "duration": 3.12
  },
  {
    "id": 9,
    "text": "王维精通绘画与音乐，善于以画家敏锐之眼在动态中捕捉光影色彩的微妙对比与空间层次。",
    "start": 43.59,
    "end": 51.91,
    "duration": 8.32
  },
  {
    "id": 10,
    "text": "如《山居秋暝》“明月松间照，清泉石上流”，上句取月光穿透松林的静景构图，",
    "start": 52.43,
    "end": 59.68,
    "duration": 7.25
  },
  {
    "id": 11,
    "text": "下句写山泉流经青石的清音微动，声色相衬，令秋夜空山明澈如画；",
    "start": 60.16,
    "end": 66.8,
    "duration": 6.64
  },
  {
    "id": 12,
    "text": "《过香积寺》“泉声咽危石，日色冷青松”、《山中》“山路元无雨，空翠湿人衣”则妙用视觉条件色，",
    "start": 67.32,
    "end": 76.17,
    "duration": 8.85
  },
  {
    "id": 13,
    "text": "借青松浓荫与苍翠山气生出“冷”“湿”之感，写活物态天趣而不留人工雕琢痕迹。",
    "start": 76.54,
    "end": 83.58,
    "duration": 7.04
  },
  {
    "id": 14,
    "text": "第二，以禅宗空观观照自然，呈示物我冥合的“无我”禅境。",
    "start": 84.1,
    "end": 89.3,
    "duration": 5.2
  },
  {
    "id": 15,
    "text": "王维精研佛法，以静坐澄心体会“无生”之境，",
    "start": 89.82,
    "end": 93.9,
    "duration": 4.08
  },
  {
    "id": 16,
    "text": "使唐代山水诗从六朝玄言理路跃入以禅趣为主的直观审美观照。",
    "start": 94.304,
    "end": 100.266,
    "duration": 5.962
  },
  {
    "id": 17,
    "text": "如《终南别业》“行到水穷处，坐看云起时”，",
    "start": 100.766,
    "end": 104.71,
    "duration": 3.944
  },
  {
    "id": 18,
    "text": "诗人无意逢水、闲坐观云，淡泊无心之态与自然天光云影浑然契合；",
    "start": 105.19,
    "end": 111.59,
    "duration": 6.4
  },
  {
    "id": 19,
    "text": "《鹿柴》“空山不见人，但闻人语响。返景入深林，复照青苔上”与《辛夷坞》“涧户寂无人，纷纷开且落”，",
    "start": 112.11,
    "end": 123.09,
    "duration": 10.98
  },
  {
    "id": 20,
    "text": "更反复凸显无人无我的静寂，把孤寂转化为对自然造物生生不息的静观自得，",
    "start": 123.49,
    "end": 130.53,
    "duration": 7.04
  },
  {
    "id": 21,
    "text": "以微响、夕照反衬山林永恒的空静之美。",
    "start": 130.93,
    "end": 134.53,
    "duration": 3.6
  },
  {
    "id": 22,
    "text": "第三，兼善古近诸体精工音节，形成从壮大明朗到冲淡天然的风貌。",
    "start": 135.05,
    "end": 141.123,
    "duration": 6.073
  },
  {
    "id": 23,
    "text": "在体式语言上，王维各类诗体皆精，五律、五绝尤臻绝诣。",
    "start": 141.623,
    "end": 146.53,
    "duration": 4.907
  },
  {
    "id": 24,
    "text": "他早年出塞作品如《使至塞上》“大漠孤烟直，长河落日圆”，",
    "start": 147.05,
    "end": 152.89,
    "duration": 5.84
  },
  {
    "id": 25,
    "text": "以凝练对称的线条勾勒塞外雄浑阔景，正显盛唐气象；",
    "start": 153.26,
    "end": 158.14,
    "duration": 4.88
  },
  {
    "id": 26,
    "text": "晚年《辋川集》二十首及五言律诗则删繁就简，不尚险怪典故，",
    "start": 158.66,
    "end": 164.15,
    "duration": 5.49
  },
  {
    "id": 27,
    "text": "或以《山居秋暝》写“竹喧”“莲动”，或以辋川绝句写“青苔”“芙蓉”，仅用清浅自然意象配合舒徐圆转的音律，",
    "start": 164.52,
    "end": 174.17,
    "duration": 9.65
  },
  {
    "id": 28,
    "text": "既避免大历诗仅有佳句而格局狭小之弊，又形成通篇浑融一气的冲淡神韵。",
    "start": 174.65,
    "end": 181.61,
    "duration": 6.96
  },
  {
    "id": 29,
    "text": "第四，汇通前代清澹山水源流，垂范后世意境审美追求。",
    "start": 182.13,
    "end": 187.17,
    "duration": 5.04
  },
  {
    "id": 30,
    "text": "王维继承谢灵运、谢朓写景传统并上承张九龄“清澹”之源，",
    "start": 187.69,
    "end": 192.97,
    "duration": 5.28
  },
  {
    "id": 31,
    "text": "将“兴象”与“禅境”相契，与孟浩然共同确立盛唐山水田园诗派的宗主地位。",
    "start": 193.34,
    "end": 199.34,
    "duration": 6.0
  },
  {
    "id": 32,
    "text": "胡应麟在《诗薮》中指出盛唐诗人“本曲江之清澹，而益以风神”。",
    "start": 199.86,
    "end": 205.3,
    "duration": 5.44
  },
  {
    "id": 33,
    "text": "此后中唐大历诗人、韦应物、柳宗元乃至宋代山水画论、清代王士祯“神韵说”，",
    "start": 205.852,
    "end": 212.54,
    "duration": 6.688
  },
  {
    "id": 34,
    "text": "均从王维“水月镜花”般的空明诗境中汲取丰厚滋养。",
    "start": 212.91,
    "end": 217.31,
    "duration": 4.4
  },
  {
    "id": 35,
    "text": "合而观之，王维将画理构图、精工音律与禅宗空观引入自然观照，",
    "start": 217.83,
    "end": 223.83,
    "duration": 6.0
  },
  {
    "id": 36,
    "text": "营造出“诗中有画，画中有诗”且物我冥合的空灵诗境，",
    "start": 224.2,
    "end": 228.76,
    "duration": 4.56
  },
  {
    "id": 37,
    "text": "展现出盛唐山水田园诗的纯粹之美。",
    "start": 229.13,
    "end": 232.25,
    "duration": 3.12
  },
  {
    "id": 38,
    "text": "他汇通前代清澹山水源流，从大历诗人、韦应物、柳宗元直至清代王士祯“神韵说”，",
    "start": 232.77,
    "end": 240.93,
    "duration": 8.16
  },
  {
    "id": 39,
    "text": "在中国古典意境美学史上留下了长久回响。",
    "start": 241.344,
    "end": 245.14,
    "duration": 3.796
  }
]
