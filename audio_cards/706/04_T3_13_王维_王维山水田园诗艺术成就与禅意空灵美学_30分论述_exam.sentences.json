[
  {
    "id": 1,
    "text": "试论王维山水田园诗的艺术成就与禅意空灵美学。",
    "start": 0.134,
    "end": 4.106,
    "duration": 3.972
  },
  {
    "id": 2,
    "text": "王维是盛唐山水田园诗派最具代表性的大家。",
    "start": 4.943,
    "end": 8.235,
    "duration": 3.292
  },
  {
    "id": 3,
    "text": "他早年怀抱功名热望，也曾赴边塞幕府写下壮阔边声，",
    "start": 8.913,
    "end": 13.085,
    "duration": 4.172
  },
  {
    "id": 4,
    "text": "经历仕途起伏与晚年隐居辋川别业后，将画理、音律与大乘禅理融入自然山水观照，",
    "start": 13.464,
    "end": 20.556,
    "duration": 7.092
  },
  {
    "id": 5,
    "text": "创造出静逸明秀、兴象玲珑的纯美诗境，把唐代山水诗推向空灵澄明的新境界。",
    "start": 20.935,
    "end": 27.467,
    "duration": 6.532
  },
  {
    "id": 6,
    "text": "其艺术成就主要体现在以下四个方面：",
    "start": 28.165,
    "end": 35.977,
    "duration": 7.812
  },
  {
    "id": 7,
    "text": "第一，融画法音律于写景，营造“诗中有画，画中有诗”的空间美感。",
    "start": 36.615,
    "end": 39.907,
    "duration": 3.292
  },
  {
    "id": 8,
    "text": "苏轼曾评王维“诗中有画，画中有诗”。",
    "start": 40.665,
    "end": 47.717,
    "duration": 7.052
  },
  {
    "id": 9,
    "text": "王维精通绘画与音乐，善于以画家敏锐之眼在动态中捕捉光影色彩的微妙对比与空间层次。",
    "start": 48.355,
    "end": 59.687,
    "duration": 11.332
  },
  {
    "id": 10,
    "text": "如《山居秋暝》“明月松间照，清泉石上流”，上句取月光穿透松林的静景构图，",
    "start": 60.445,
    "end": 63.357,
    "duration": 2.912
  },
  {
    "id": 11,
    "text": "下句写山泉流经青石的清音微动，声色相衬，令秋夜空山明澈如画；",
    "start": 63.736,
    "end": 67.988,
    "duration": 4.252
  },
  {
    "id": 12,
    "text": "《过香积寺》“泉声咽危石，日色冷青松”、《山中》“山路元无雨，空翠湿人衣”则妙用视觉条件色，",
    "start": 68.517,
    "end": 71.729,
    "duration": 3.212
  },
  {
    "id": 13,
    "text": "借青松浓荫与苍翠山气生出“冷”“湿”之感，写活物态天趣而不留人工雕琢痕迹。",
    "start": 72.108,
    "end": 75.24,
    "duration": 3.132
  },
  {
    "id": 14,
    "text": "第二，以禅宗空观观照自然，呈示物我冥合的“无我”禅境。",
    "start": 75.898,
    "end": 80.59,
    "duration": 4.692
  },
  {
    "id": 15,
    "text": "王维精研佛法，以静坐澄心体会“无生”之境，",
    "start": 81.228,
    "end": 84.8,
    "duration": 3.572
  },
  {
    "id": 16,
    "text": "使唐代山水诗从六朝玄言理路跃入以禅趣为主的直观审美观照。",
    "start": 85.179,
    "end": 90.791,
    "duration": 5.612
  },
  {
    "id": 17,
    "text": "如《终南别业》“行到水穷处，坐看云起时”，",
    "start": 91.469,
    "end": 94.481,
    "duration": 3.012
  },
  {
    "id": 18,
    "text": "诗人无意逢水、闲坐观云，淡泊无心之态与自然天光云影浑然契合；",
    "start": 94.86,
    "end": 100.312,
    "duration": 5.452
  },
  {
    "id": 19,
    "text": "《鹿柴》“空山不见人，但闻人语响。返景入深林，复照青苔上”与《辛夷坞》“涧户寂无人，纷纷开且落”，",
    "start": 100.841,
    "end": 108.573,
    "duration": 7.732
  },
  {
    "id": 20,
    "text": "更反复凸显无人无我的静寂，把孤寂转化为对自然造物生生不息的静观自得，",
    "start": 109.119,
    "end": 115.251,
    "duration": 6.132
  },
  {
    "id": 21,
    "text": "以微响、夕照反衬山林永恒的空静之美。",
    "start": 115.63,
    "end": 119.162,
    "duration": 3.532
  },
  {
    "id": 22,
    "text": "第三，兼善古近诸体精工音节，形成从壮大明朗到冲淡天然的风貌。",
    "start": 119.786,
    "end": 125.478,
    "duration": 5.692
  },
  {
    "id": 23,
    "text": "在体式语言上，王维各类诗体皆精，五律、五绝尤臻绝诣。",
    "start": 126.007,
    "end": 130.499,
    "duration": 4.492
  },
  {
    "id": 24,
    "text": "他早年出塞作品如《使至塞上》“大漠孤烟直，长河落日圆”，",
    "start": 131.177,
    "end": 135.669,
    "duration": 4.492
  },
  {
    "id": 25,
    "text": "以凝练对称的线条勾勒塞外雄浑阔景，正显盛唐气象；",
    "start": 136.048,
    "end": 140.1,
    "duration": 4.052
  },
  {
    "id": 26,
    "text": "晚年《辋川集》二十首及五言律诗则删繁就简，不尚险怪典故，",
    "start": 140.778,
    "end": 145.71,
    "duration": 4.932
  },
  {
    "id": 27,
    "text": "或以《山居秋暝》写“竹喧”“莲动”，或以辋川绝句写“青苔”“芙蓉”，仅用清浅自然意象配合舒徐圆转的音律，",
    "start": 146.089,
    "end": 155.101,
    "duration": 9.012
  },
  {
    "id": 28,
    "text": "既避免大历诗仅有佳句而格局狭小之弊，又形成通篇浑融一气的冲淡神韵。",
    "start": 155.624,
    "end": 161.676,
    "duration": 6.052
  },
  {
    "id": 29,
    "text": "第四，汇通前代清澹山水源流，垂范后世意境审美追求。",
    "start": 162.399,
    "end": 167.371,
    "duration": 4.972
  },
  {
    "id": 30,
    "text": "王维继承谢灵运、谢朓写景传统并上承张九龄“清澹”之源，",
    "start": 168.129,
    "end": 172.541,
    "duration": 4.412
  },
  {
    "id": 31,
    "text": "将“兴象”与“禅境”相契，与孟浩然共同确立盛唐山水田园诗派的宗主地位。",
    "start": 172.92,
    "end": 178.332,
    "duration": 5.412
  },
  {
    "id": 32,
    "text": "胡应麟在《诗薮》中指出盛唐诗人“本曲江之清澹，而益以风神”。",
    "start": 178.97,
    "end": 183.702,
    "duration": 4.732
  },
  {
    "id": 33,
    "text": "此后中唐大历诗人、韦应物、柳宗元乃至宋代山水画论、清代王士祯“神韵说”，",
    "start": 184.46,
    "end": 190.712,
    "duration": 6.252
  },
  {
    "id": 34,
    "text": "均从王维“水月镜花”般的空明诗境中汲取丰厚滋养。",
    "start": 191.091,
    "end": 194.823,
    "duration": 3.732
  },
  {
    "id": 35,
    "text": "合而观之，王维将画理构图、精工音律与禅宗空观引入自然观照，",
    "start": 195.541,
    "end": 200.793,
    "duration": 5.252
  },
  {
    "id": 36,
    "text": "营造出“诗中有画，画中有诗”且物我冥合的空灵诗境，",
    "start": 201.172,
    "end": 205.504,
    "duration": 4.332
  },
  {
    "id": 37,
    "text": "展现出盛唐山水田园诗的纯粹之美。",
    "start": 205.883,
    "end": 208.695,
    "duration": 2.812
  },
  {
    "id": 38,
    "text": "他汇通前代清澹山水源流，从大历诗人、韦应物、柳宗元直至清代王士祯“神韵说”，",
    "start": 209.333,
    "end": 215.905,
    "duration": 6.572
  },
  {
    "id": 39,
    "text": "在中国古典意境美学史上留下了长久回响。",
    "start": 216.284,
    "end": 219.696,
    "duration": 3.412
  }
]