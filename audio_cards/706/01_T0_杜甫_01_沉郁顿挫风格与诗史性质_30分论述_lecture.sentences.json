[
  {
    "id": 1,
    "text": "一、全题宏观破题与总揽。",
    "start": 0.08,
    "end": 2.96,
    "duration": 2.88
  },
  {
    "id": 2,
    "text": "一、这一问到底在考什么？",
    "start": 2.96,
    "end": 4.96,
    "duration": 2.0
  },
  {
    "id": 3,
    "text": "本题考查西华师大七零六古代文学首屈一指的T零考点，",
    "start": 5.12,
    "end": 10.56,
    "duration": 5.44
  },
  {
    "id": 4,
    "text": "杜甫的诗歌艺术成就。",
    "start": 10.56,
    "end": 12.24,
    "duration": 1.68
  },
  {
    "id": 5,
    "text": "考生必须准确把握“沉郁顿挫”的风格内涵、",
    "start": 12.24,
    "end": 16.0,
    "duration": 3.76
  },
  {
    "id": 6,
    "text": "“诗史”性质与叙事突破、律诗集大成造诣以及后世深远影响。",
    "start": 16.0,
    "end": 20.96,
    "duration": 4.96
  },
  {
    "id": 7,
    "text": "二、答题的总方向是什么？",
    "start": 21.28,
    "end": 23.52,
    "duration": 2.24
  },
  {
    "id": 8,
    "text": "立足袁行配《中国文学史》第二卷关于杜甫章节的权威论述。",
    "start": 23.52,
    "end": 28.24,
    "duration": 4.72
  },
  {
    "id": 9,
    "text": "紧扣“诗圣”与盛唐向中唐历史转折的知人论世视角，",
    "start": 28.24,
    "end": 32.8,
    "duration": 4.56
  },
  {
    "id": 10,
    "text": "讲清思想感情之厚（沉郁）与艺术表现之曲（顿挫）的内在机制，",
    "start": 32.8,
    "end": 36.911,
    "duration": 4.111
  },
  {
    "id": 11,
    "text": "绝不能空洞夸耀。",
    "start": 36.911,
    "end": 38.08,
    "duration": 1.169
  },
  {
    "id": 12,
    "text": "三、分几个板块展开？",
    "start": 38.24,
    "end": 40.24,
    "duration": 2.0
  },
  {
    "id": 13,
    "text": "全篇按四大经典维度层层递进：第一板块：“沉郁顿挫”美学特质与深层机制（沉郁之情厚、",
    "start": 40.24,
    "end": 48.0,
    "duration": 7.76
  },
  {
    "id": 14,
    "text": "顿挫之法曲、登高与自京赴奉先县）。",
    "start": 48.0,
    "end": 51.28,
    "duration": 3.28
  },
  {
    "id": 15,
    "text": "第二板块：“诗史”品格与人道主义叙事突破（补史之阙更记录心灵史、",
    "start": 51.28,
    "end": 57.12,
    "duration": 5.84
  },
  {
    "id": 16,
    "text": "三吏三别与茅屋为秋风所破歌）。",
    "start": 57.12,
    "end": 59.84,
    "duration": 2.72
  },
  {
    "id": 17,
    "text": "第三板块：律诗体制集大成与形式登峰造极（拓宽题材、",
    "start": 60.16,
    "end": 64.96,
    "duration": 4.8
  },
  {
    "id": 18,
    "text": "拗救之法、登高八句皆对之极境）。",
    "start": 64.96,
    "end": 67.68,
    "duration": 2.72
  },
  {
    "id": 19,
    "text": "第四板块：文学史深远影响与后世流变（新乐府运动源头、",
    "start": 67.68,
    "end": 72.32,
    "duration": 4.64
  },
  {
    "id": 20,
    "text": "宋诗苏黄江西诗派之祖）。",
    "start": 72.32,
    "end": 74.4,
    "duration": 2.08
  },
  {
    "id": 21,
    "text": "四、全篇内在逻辑链条是什么？",
    "start": 74.4,
    "end": 76.72,
    "duration": 2.32
  },
  {
    "id": 22,
    "text": "由知人论世之时代剧变切入（时代与地位破题）趋近于剖析其最核心的标志性审美风格（风格之骨）趋近于深入其直面社会的叙事内容与思想灵魂（精神之魂）趋近于展现其将格律推向极境的形式创造（形式之法）趋近于升华至对古代诗歌史的长远滋养（历史之流）。",
    "start": 76.72,
    "end": 96.56,
    "duration": 19.84
  },
  {
    "id": 23,
    "text": "层层拓深，气势磅礴。",
    "start": 96.88,
    "end": 98.96,
    "duration": 2.08
  },
  {
    "id": 24,
    "text": "--。二",
    "start": 98.96,
    "end": 99.12,
    "duration": 0.16
  },
  {
    "id": 25,
    "text": "、各板块逐句咬合推演。",
    "start": 99.44,
    "end": 101.76,
    "duration": 2.32
  },
  {
    "id": 26,
    "text": "（一）宏观定性与破题总起板块。",
    "start": 101.76,
    "end": 104.48,
    "duration": 2.72
  },
  {
    "id": 27,
    "text": "破题推演逻辑：开头必须高屋建瓴。",
    "start": 104.48,
    "end": 107.92,
    "duration": 3.44
  },
  {
    "id": 28,
    "text": "界定杜甫在现实主义传统中的至高地位，",
    "start": 107.92,
    "end": 111.36,
    "duration": 3.44
  },
  {
    "id": 29,
    "text": "交代安史之乱盛极而衰的特殊时代坐标。",
    "start": 111.36,
    "end": 115.2,
    "duration": 3.84
  },
  {
    "id": 30,
    "text": "指出其个人命运与国运民生的深度焊接，",
    "start": 115.2,
    "end": 118.88,
    "duration": 3.68
  },
  {
    "id": 31,
    "text": "最后概括风格、诗史、格律与人道四大要素，",
    "start": 118.88,
    "end": 123.2,
    "duration": 4.32
  },
  {
    "id": 32,
    "text": "引出分述。",
    "start": 123.2,
    "end": 124.0,
    "duration": 0.8
  },
  {
    "id": 33,
    "text": "-逐句咬合推导：具体表述到答题语句就是：杜甫是中国古代诗歌现实主义精神的集大成者与至高巅峰。，",
    "start": 124.16,
    "end": 132.44,
    "duration": 8.28
  },
  {
    "id": 34,
    "text": "这是对考察对象的历史最高定性。",
    "start": 132.44,
    "end": 135.2,
    "duration": 2.76
  },
  {
    "id": 35,
    "text": "紧接着交代其知人论世的时代历史节点，",
    "start": 135.344,
    "end": 138.544,
    "duration": 3.2
  },
  {
    "id": 36,
    "text": "具体表述到答题语句就是：他身处唐帝国由盛转衰的安史之乱剧变节点。。",
    "start": 138.544,
    "end": 144.8,
    "duration": 6.256
  },
  {
    "id": 37,
    "text": "随后指出其将小我与苍生紧密联系的儒者胸怀，",
    "start": 144.8,
    "end": 149.004,
    "duration": 4.204
  },
  {
    "id": 38,
    "text": "具体表述到答题语句就是：杜甫以强烈的儒家仁民爱物精神，",
    "start": 149.004,
    "end": 154.26,
    "duration": 5.256
  },
  {
    "id": 39,
    "text": "将个人的漂泊坎坷同国家民族的存亡紧密焊接。。",
    "start": 154.26,
    "end": 158.464,
    "duration": 4.204
  },
  {
    "id": 40,
    "text": "紧接着说明其反映时代的宏阔广度，",
    "start": 158.544,
    "end": 161.824,
    "duration": 3.28
  },
  {
    "id": 41,
    "text": "具体表述到答题语句就是：他以广阔的历史视野与炉火纯青的格律造诣，",
    "start": 161.824,
    "end": 167.826,
    "duration": 6.002
  },
  {
    "id": 42,
    "text": "为盛衰之交的时代铸造了一部鲜活壮阔的心灵全史。。",
    "start": 167.826,
    "end": 172.291,
    "duration": 4.465
  },
  {
    "id": 43,
    "text": "最后落到诗圣地位与四大成就的凝练概括，",
    "start": 172.291,
    "end": 175.944,
    "duration": 3.653
  },
  {
    "id": 44,
    "text": "具体表述到答题语句就是：杜甫以沉郁顿挫的艺术风格、",
    "start": 175.944,
    "end": 180.612,
    "duration": 4.668
  },
  {
    "id": 45,
    "text": "感时伤事的诗史品格、精严化境的律诗造诣与博大深沉的人道主义情怀，",
    "start": 180.612,
    "end": 186.7,
    "duration": 6.088
  },
  {
    "id": 46,
    "text": "确立了其无可争议的“诗圣”崇高地位。。",
    "start": 186.7,
    "end": 189.744,
    "duration": 3.044
  },
  {
    "id": 47,
    "text": "杜甫是中国古代诗歌现实主义精神的集大成者与至高巅峰。",
    "start": 189.824,
    "end": 194.864,
    "duration": 5.04
  },
  {
    "id": 48,
    "text": "他身处唐帝国由盛转衰的安史之乱剧变节点。",
    "start": 194.864,
    "end": 199.264,
    "duration": 4.4
  },
  {
    "id": 49,
    "text": "杜甫以强烈的儒家仁民爱物精神，将个人的漂泊坎坷同国家民族的存亡紧密焊接。",
    "start": 199.264,
    "end": 206.784,
    "duration": 7.52
  },
  {
    "id": 50,
    "text": "他以广阔的历史视野与炉火纯青的格律造诣，",
    "start": 206.784,
    "end": 210.544,
    "duration": 3.76
  },
  {
    "id": 51,
    "text": "为盛衰之交的时代铸造了一部鲜活壮阔的心灵全史。",
    "start": 210.544,
    "end": 214.864,
    "duration": 4.32
  },
  {
    "id": 52,
    "text": "杜甫以沉郁顿挫的艺术风格、感时伤事的诗史品格、",
    "start": 215.104,
    "end": 219.664,
    "duration": 4.56
  },
  {
    "id": 53,
    "text": "精严化境的律诗造诣与博大深沉的人道主义情怀，",
    "start": 219.664,
    "end": 224.144,
    "duration": 4.48
  },
  {
    "id": 54,
    "text": "确立了其无可争议的“诗圣”崇高地位。",
    "start": 224.144,
    "end": 227.504,
    "duration": 3.36
  },
  {
    "id": 55,
    "text": "--。（二",
    "start": 227.504,
    "end": 227.664,
    "duration": 0.16
  },
  {
    "id": 56,
    "text": "）第一板块：“沉郁顿挫”美学特质与深层机制。",
    "start": 227.824,
    "end": 231.664,
    "duration": 3.84
  },
  {
    "id": 57,
    "text": "论证推演逻辑：讲透沉郁顿挫，不能望文生义。",
    "start": 231.664,
    "end": 235.984,
    "duration": 4.32
  },
  {
    "id": 58,
    "text": "必须先准确拆解学术内涵：“沉郁”指思想感情的深厚博大，",
    "start": 235.984,
    "end": 241.104,
    "duration": 5.12
  },
  {
    "id": 59,
    "text": "“顿挫”指表现手法的跌宕转折波澜起伏。",
    "start": 241.104,
    "end": 244.544,
    "duration": 3.44
  },
  {
    "id": 60,
    "text": "接着深入历史心理机制：理想破灭与天下大乱，",
    "start": 244.544,
    "end": 248.144,
    "duration": 3.6
  },
  {
    "id": 61,
    "text": "使情感不能一泻直下，只能盘旋沉咽。",
    "start": 248.144,
    "end": 251.424,
    "duration": 3.28
  },
  {
    "id": 62,
    "text": "结合《自京赴奉先县咏怀五百字》与《登高》的经典诗境进行实证。",
    "start": 251.424,
    "end": 256.784,
    "duration": 5.36
  },
  {
    "id": 63,
    "text": "-逐句咬合推导：具体表述到答题语句就是：首先，",
    "start": 256.944,
    "end": 261.074,
    "duration": 4.13
  },
  {
    "id": 64,
    "text": "在美学风格上，“沉郁顿挫”是杜甫诗歌最核心、",
    "start": 261.074,
    "end": 264.986,
    "duration": 3.912
  },
  {
    "id": 65,
    "text": "最具统摄力的美学特质。，",
    "start": 264.986,
    "end": 267.159,
    "duration": 2.173
  },
  {
    "id": 66,
    "text": "这是第一分论点的核心立桩。",
    "start": 267.159,
    "end": 269.767,
    "duration": 2.608
  },
  {
    "id": 67,
    "text": "紧接着拆解“沉郁”的学术内涵，具体表述到答题语句就是：沉郁指思想感情的深沉、",
    "start": 269.767,
    "end": 276.94,
    "duration": 7.173
  },
  {
    "id": 68,
    "text": "宽厚与博大，展现出诗人关怀现实苍生的深重悲敏。。",
    "start": 276.94,
    "end": 281.504,
    "duration": 4.564
  },
  {
    "id": 69,
    "text": "随后拆解“顿挫”的表现技法，具体表述到答题语句就是：顿挫指表现手法的波澜起伏、",
    "start": 281.728,
    "end": 288.981,
    "duration": 7.253
  },
  {
    "id": 70,
    "text": "跌宕转折与感情表达的郁结盘旋。。",
    "start": 288.981,
    "end": 291.968,
    "duration": 2.987
  },
  {
    "id": 71,
    "text": "紧接着揭示这一风格形成的时代心理机制，",
    "start": 291.968,
    "end": 295.808,
    "duration": 3.84
  },
  {
    "id": 72,
    "text": "具体表述到答题语句就是：这一风格根植于知人论世的历史真实。。",
    "start": 295.808,
    "end": 301.568,
    "duration": 5.76
  },
  {
    "id": 73,
    "text": "进一步阐明理想受挫带来的情感压抑，",
    "start": 301.648,
    "end": 304.928,
    "duration": 3.28
  },
  {
    "id": 74,
    "text": "具体表述到答题语句就是：盛唐气象的破灭与致君尧舜理想的受挫，",
    "start": 304.928,
    "end": 310.679,
    "duration": 5.751
  },
  {
    "id": 75,
    "text": "使杜甫的情感郁结在胸而无法平直倾泻。。",
    "start": 310.679,
    "end": 314.149,
    "duration": 3.47
  },
  {
    "id": 76,
    "text": "随后切入第一部经典名作实证，具体表述到答题语句就是：在《自京赴奉先县咏怀五百字》中，",
    "start": 314.149,
    "end": 321.701,
    "duration": 7.552
  },
  {
    "id": 77,
    "text": "“朱门酒肉臭，路有冻死骨”将阶级对立的严酷现实化为深沉浩叹。。",
    "start": 321.701,
    "end": 327.008,
    "duration": 5.307
  },
  {
    "id": 78,
    "text": "紧接着切入第二部晚年律诗极境实证，",
    "start": 327.088,
    "end": 330.448,
    "duration": 3.36
  },
  {
    "id": 79,
    "text": "具体表述到答题语句就是：在《登高》中，",
    "start": 330.448,
    "end": 333.527,
    "duration": 3.079
  },
  {
    "id": 80,
    "text": "面对万里悲秋的壮阔江天，诗人将老病孤舟的个人迟暮与百年世事之多艰融为一体。。",
    "start": 333.527,
    "end": 341.146,
    "duration": 7.619
  },
  {
    "id": 81,
    "text": "最后总结这种章法与心绪融合带来的震撼美感，",
    "start": 341.146,
    "end": 345.5,
    "duration": 4.354
  },
  {
    "id": 82,
    "text": "具体表述到答题语句就是：盘旋吞吐的章法与苍凉厚重的心绪交融，",
    "start": 345.5,
    "end": 351.596,
    "duration": 6.096
  },
  {
    "id": 83,
    "text": "形成了撼人心魄的沉郁之美。。",
    "start": 351.596,
    "end": 354.208,
    "duration": 2.612
  },
  {
    "id": 84,
    "text": "首先，在美学风格上，“沉郁顿挫”是杜甫诗歌最核心、",
    "start": 354.368,
    "end": 359.008,
    "duration": 4.64
  },
  {
    "id": 85,
    "text": "最具统摄力的美学特质。",
    "start": 359.008,
    "end": 361.008,
    "duration": 2.0
  },
  {
    "id": 86,
    "text": "沉郁指思想感情的深沉、宽厚与博大，",
    "start": 361.008,
    "end": 364.368,
    "duration": 3.36
  },
  {
    "id": 87,
    "text": "展现出诗人关怀现实苍生的深重悲敏。",
    "start": 364.368,
    "end": 367.568,
    "duration": 3.2
  },
  {
    "id": 88,
    "text": "顿挫指表现手法的波澜起伏、跌宕转折与感情表达的郁结盘旋。",
    "start": 367.568,
    "end": 372.848,
    "duration": 5.28
  },
  {
    "id": 89,
    "text": "这一风格根植于知人论世的历史真实。",
    "start": 372.848,
    "end": 375.488,
    "duration": 2.64
  },
  {
    "id": 90,
    "text": "盛唐气象的破灭与致君尧舜理想的受挫，",
    "start": 375.968,
    "end": 379.808,
    "duration": 3.84
  },
  {
    "id": 91,
    "text": "使杜甫的情感郁结在胸而无法平直倾泻。",
    "start": 379.808,
    "end": 384.288,
    "duration": 4.48
  },
  {
    "id": 92,
    "text": "在《自京赴奉先县咏怀五百字》中，",
    "start": 384.288,
    "end": 387.488,
    "duration": 3.2
  },
  {
    "id": 93,
    "text": "“朱门酒肉臭，路有冻死骨”将阶级对立的严酷现实化为深沉浩叹。",
    "start": 387.488,
    "end": 394.848,
    "duration": 7.36
  },
  {
    "id": 94,
    "text": "在《登高》中，面对万里悲秋的壮阔江天，",
    "start": 394.848,
    "end": 398.448,
    "duration": 3.6
  },
  {
    "id": 95,
    "text": "诗人将老病孤舟的个人迟暮与百年世事之多艰融为一体。",
    "start": 398.448,
    "end": 403.648,
    "duration": 5.2
  },
  {
    "id": 96,
    "text": "盘旋吞吐的章法与苍凉厚重的心绪交融，",
    "start": 403.888,
    "end": 407.568,
    "duration": 3.68
  },
  {
    "id": 97,
    "text": "形成了撼人心魄的沉郁之美。",
    "start": 407.568,
    "end": 410.048,
    "duration": 2.48
  },
  {
    "id": 98,
    "text": "--。（三",
    "start": 410.048,
    "end": 410.128,
    "duration": 0.08
  },
  {
    "id": 99,
    "text": "）第二板块：“诗史”品格与人道主义叙事突破。",
    "start": 410.368,
    "end": 414.288,
    "duration": 3.92
  },
  {
    "id": 100,
    "text": "论证推演逻辑：“诗史”是杜甫最著名的评价。",
    "start": 414.288,
    "end": 418.008,
    "duration": 3.72
  },
  {
    "id": 101,
    "text": "必须阐述诗史不仅是客观编年，而是饱含主观心灵震颤的“人史”。",
    "start": 418.008,
    "end": 423.452,
    "duration": 5.444
  },
  {
    "id": 102,
    "text": "分析感时伤事的叙事突破，以“三吏三别”特别是《石壕吏》的平民视角与客观叙事为证据，",
    "start": 423.452,
    "end": 430.782,
    "duration": 7.33
  },
  {
    "id": 103,
    "text": "以《茅屋为秋风所破歌》推己及人的大爱为证据，",
    "start": 430.782,
    "end": 434.76,
    "duration": 3.978
  },
  {
    "id": 104,
    "text": "论证其崇高人道主义光芒。",
    "start": 434.76,
    "end": 437.064,
    "duration": 2.304
  },
  {
    "id": 105,
    "text": "-逐句咬合推导：具体表述到答题语句就是：其次，",
    "start": 437.064,
    "end": 440.945,
    "duration": 3.881
  },
  {
    "id": 106,
    "text": "在思想主旨上，杜甫诗歌展现了记录时代沧桑的“诗史”品格与博大的人道主义悲敏。，",
    "start": 440.945,
    "end": 447.889,
    "duration": 6.944
  },
  {
    "id": 107,
    "text": "这是第二分论点的观点立桩。",
    "start": 447.889,
    "end": 450.34,
    "duration": 2.451
  },
  {
    "id": 108,
    "text": "紧接着阐明诗史超越普通历史编纂的心灵深度，",
    "start": 450.34,
    "end": 454.425,
    "duration": 4.085
  },
  {
    "id": 109,
    "text": "具体表述到答题语句就是：杜甫的诗史价值不仅在于据实补史书之阙，",
    "start": 454.425,
    "end": 460.348,
    "duration": 5.923
  },
  {
    "id": 110,
    "text": "更在于深刻记录了时代民众的心灵苦难史。。",
    "start": 460.348,
    "end": 464.024,
    "duration": 3.676
  },
  {
    "id": 111,
    "text": "随后指出其叙事传统的确立，具体表述到答题语句就是：他开辟了感时伤事的现实叙事新传统。。",
    "start": 464.184,
    "end": 471.418,
    "duration": 7.234
  },
  {
    "id": 112,
    "text": "紧接着切入“三吏三别”的宏阔概括，",
    "start": 471.418,
    "end": 474.17,
    "duration": 2.752
  },
  {
    "id": 113,
    "text": "具体表述到答题语句就是：“三吏三别”以平民视角直面征兵战乱的惨烈真相。。",
    "start": 474.17,
    "end": 480.264,
    "duration": 6.094
  },
  {
    "id": 114,
    "text": "随后以《石壕吏》为例剖析克制叙事中的悲敏，",
    "start": 480.424,
    "end": 483.544,
    "duration": 3.12
  },
  {
    "id": 115,
    "text": "具体表述到答题语句就是：《石壕吏》在客观克制的夜捉叙述中，",
    "start": 483.544,
    "end": 488.524,
    "duration": 4.98
  },
  {
    "id": 116,
    "text": "通过老妇凄苦的泣诉，揭露了战争强加给下层小民的无情摧残。。",
    "start": 488.524,
    "end": 493.7,
    "duration": 5.176
  },
  {
    "id": 117,
    "text": "进一步指出民胞物与的仁者博爱，具体表述到答题语句就是：杜甫以民胞物与的仁者胸怀体恤苍生。。",
    "start": 493.7,
    "end": 501.864,
    "duration": 8.164
  },
  {
    "id": 118,
    "text": "随后引用《茅屋为秋风所破歌》名句实证，",
    "start": 502.024,
    "end": 505.704,
    "duration": 3.68
  },
  {
    "id": 119,
    "text": "具体表述到答题语句就是：《茅屋为秋风所破歌》在自身床头屋漏的绝境中，",
    "start": 505.704,
    "end": 511.972,
    "duration": 6.268
  },
  {
    "id": 120,
    "text": "迸发出“安得广厦千万间，大庇天下寒士俱欢颜”的宏伟祈愿。。",
    "start": 511.972,
    "end": 517.071,
    "duration": 5.099
  },
  {
    "id": 121,
    "text": "最后升华这种大仁大爱的超越性价值，",
    "start": 517.071,
    "end": 520.47,
    "duration": 3.399
  },
  {
    "id": 122,
    "text": "具体表述到答题语句就是：这种超越小我、",
    "start": 520.47,
    "end": 524.081,
    "duration": 3.611
  },
  {
    "id": 123,
    "text": "怀抱天下生灵的大仁大爱，使他的现实记录闪耀着超越时代的崇高人道主义光芒。。",
    "start": 524.081,
    "end": 531.304,
    "duration": 7.223
  },
  {
    "id": 124,
    "text": "其次，在思想主旨上，杜甫诗歌展现了记录时代沧桑的“诗史”品格与博大的人道主义悲敏。",
    "start": 531.52,
    "end": 539.44,
    "duration": 7.92
  },
  {
    "id": 125,
    "text": "杜甫的诗史价值不仅在于据实补史书之阙，",
    "start": 539.44,
    "end": 543.52,
    "duration": 4.08
  },
  {
    "id": 126,
    "text": "更在于深刻记录了时代民众的心灵苦难史。",
    "start": 543.52,
    "end": 547.04,
    "duration": 3.52
  },
  {
    "id": 127,
    "text": "他开辟了感时伤事的现实叙事新传统。",
    "start": 547.04,
    "end": 550.32,
    "duration": 3.28
  },
  {
    "id": 128,
    "text": "“三吏三别”以平民视角直面征兵战乱的惨烈真相。",
    "start": 550.32,
    "end": 554.32,
    "duration": 4.0
  },
  {
    "id": 129,
    "text": "《石壕吏》在客观克制的夜捉叙述中，",
    "start": 554.56,
    "end": 557.773,
    "duration": 3.213
  },
  {
    "id": 130,
    "text": "通过老妇凄苦的泣诉，揭露了战争强加给下层小民的无情摧残。",
    "start": 557.773,
    "end": 563.74,
    "duration": 5.967
  },
  {
    "id": 131,
    "text": "杜甫以民胞物与的仁者胸怀体恤苍生。",
    "start": 563.74,
    "end": 567.412,
    "duration": 3.672
  },
  {
    "id": 132,
    "text": "《茅屋为秋风所破歌》在自身床头屋漏的绝境中，",
    "start": 567.412,
    "end": 571.772,
    "duration": 4.36
  },
  {
    "id": 133,
    "text": "迸发出“安得广厦千万间，大庇天下寒士俱欢颜”的宏伟祈愿。",
    "start": 571.772,
    "end": 577.28,
    "duration": 5.508
  },
  {
    "id": 134,
    "text": "这种超越小我、怀抱天下生灵的大仁大爱，",
    "start": 577.44,
    "end": 580.96,
    "duration": 3.52
  },
  {
    "id": 135,
    "text": "使他的现实记录闪耀着超越时代的崇高人道主义光芒。",
    "start": 580.96,
    "end": 585.12,
    "duration": 4.16
  },
  {
    "id": 136,
    "text": "--。（四",
    "start": 585.12,
    "end": 585.335,
    "duration": 0.215
  },
  {
    "id": 137,
    "text": "）第三板块：律诗体制集大成与形式登峰造极。",
    "start": 585.335,
    "end": 589.214,
    "duration": 3.879
  },
  {
    "id": 138,
    "text": "论证推演逻辑：杜甫被尊为诗圣，形式上的集大成至关重要。",
    "start": 589.214,
    "end": 594.386,
    "duration": 5.172
  },
  {
    "id": 139,
    "text": "必须说明其打破齐梁浮艳声色，拓展题材容量。",
    "start": 594.386,
    "end": 598.48,
    "duration": 4.094
  },
  {
    "id": 140,
    "text": "阐述其将对仗、音韵与“拗救”变格融为一体的高超手段。",
    "start": 598.56,
    "end": 603.12,
    "duration": 4.56
  },
  {
    "id": 141,
    "text": "以《登高》八句皆对、气象雄浑、骨力老健为例，",
    "start": 603.12,
    "end": 606.64,
    "duration": 3.52
  },
  {
    "id": 142,
    "text": "证明其将汉语古典诗歌格律推向极致。",
    "start": 606.64,
    "end": 609.52,
    "duration": 2.88
  },
  {
    "id": 143,
    "text": "逐句咬合推导：具体表述到答题语句就是：第三，",
    "start": 609.68,
    "end": 613.28,
    "duration": 3.6
  },
  {
    "id": 144,
    "text": "在体制艺术上，杜甫实现了中国古代律诗艺术的全面集大成与形式登峰造极。，",
    "start": 613.28,
    "end": 619.36,
    "duration": 6.08
  },
  {
    "id": 145,
    "text": "这是第三分论点的提纲窃领。",
    "start": 619.36,
    "end": 621.36,
    "duration": 2.0
  },
  {
    "id": 146,
    "text": "紧接着说明其打破前代声律狭隘格式的突破，",
    "start": 621.6,
    "end": 625.52,
    "duration": 3.92
  },
  {
    "id": 147,
    "text": "具体表述到答题语句就是：杜甫彻底打破了齐梁以来律诗偏于声色浮艳的狭隘格式。。",
    "start": 625.52,
    "end": 633.217,
    "duration": 7.697
  },
  {
    "id": 148,
    "text": "随后阐明题材容量的扩充与苦心锤炼，",
    "start": 633.217,
    "end": 636.726,
    "duration": 3.509
  },
  {
    "id": 149,
    "text": "具体表述到答题语句就是：他极大拓宽了律诗的题材边界与抒情容量，",
    "start": 636.726,
    "end": 643.087,
    "duration": 6.361
  },
  {
    "id": 150,
    "text": "做到了“语不惊人死不休”。。",
    "start": 643.087,
    "end": 645.28,
    "duration": 2.193
  },
  {
    "id": 151,
    "text": "紧接着指出其规范与变通并重的技巧，",
    "start": 645.36,
    "end": 648.64,
    "duration": 3.28
  },
  {
    "id": 152,
    "text": "具体表述到答题语句就是：他不仅将五七言律诗锻造得音韵协调、",
    "start": 648.64,
    "end": 654.364,
    "duration": 5.724
  },
  {
    "id": 153,
    "text": "对仗极其工稳，更创立了“拗救”与变格手法，",
    "start": 654.364,
    "end": 658.027,
    "duration": 3.663
  },
  {
    "id": 154,
    "text": "实现了形式规范与情感起伏的自由融合。。",
    "start": 658.027,
    "end": 661.69,
    "duration": 3.663
  },
  {
    "id": 155,
    "text": "随后切入古今七律第一的《登高》实证，",
    "start": 661.69,
    "end": 664.921,
    "duration": 3.231
  },
  {
    "id": 156,
    "text": "具体表述到答题语句就是：其代表作《登高》八句皆对，",
    "start": 664.921,
    "end": 669.446,
    "duration": 4.525
  },
  {
    "id": 157,
    "text": "首联句中自对，沉着开阔。。",
    "start": 669.446,
    "end": 671.6,
    "duration": 2.154
  },
  {
    "id": 158,
    "text": "紧接着分析其中联的气象与骨力，具体表述到答题语句就是：汉联与颈联对仗天造地设，",
    "start": 671.744,
    "end": 679.019,
    "duration": 7.275
  },
  {
    "id": 159,
    "text": "气象雄浑而骨力老健。。",
    "start": 679.019,
    "end": 680.834,
    "duration": 1.815
  },
  {
    "id": 160,
    "text": "最后总结其在格律艺术上的终极高度，",
    "start": 680.834,
    "end": 684.061,
    "duration": 3.227
  },
  {
    "id": 161,
    "text": "具体表述到答题语句就是：杜甫以千锤百炼的语言功夫，",
    "start": 684.061,
    "end": 688.699,
    "duration": 4.638
  },
  {
    "id": 162,
    "text": "将汉语律诗的声律对仗与章法结构推向了前无古人的艺术极致。。",
    "start": 688.699,
    "end": 694.144,
    "duration": 5.445
  },
  {
    "id": 163,
    "text": "第三，在体制艺术上，杜甫实现了中国古代律诗艺术的全面集大成与形式登峰造极。",
    "start": 694.224,
    "end": 701.984,
    "duration": 7.76
  },
  {
    "id": 164,
    "text": "杜甫彻底打破了齐梁以来律诗偏于声色浮艳的狭隘格式。",
    "start": 701.984,
    "end": 707.744,
    "duration": 5.76
  },
  {
    "id": 165,
    "text": "他极大拓宽了律诗的题材边界与抒情容量，",
    "start": 707.744,
    "end": 711.744,
    "duration": 4.0
  },
  {
    "id": 166,
    "text": "做到了“语不惊人死不休”。",
    "start": 711.744,
    "end": 713.824,
    "duration": 2.08
  },
  {
    "id": 167,
    "text": "他不仅将五七言律诗锻造得音韵协调、",
    "start": 713.824,
    "end": 717.264,
    "duration": 3.44
  },
  {
    "id": 168,
    "text": "对仗极其工稳，更创立了“拗救”与变格手法，",
    "start": 717.264,
    "end": 721.344,
    "duration": 4.08
  },
  {
    "id": 169,
    "text": "实现了形式规范与情感起伏的自由融合。",
    "start": 721.344,
    "end": 724.784,
    "duration": 3.44
  },
  {
    "id": 170,
    "text": "其代表作《登高》八句皆对，首联句中自对，",
    "start": 725.184,
    "end": 729.104,
    "duration": 3.92
  },
  {
    "id": 171,
    "text": "沉着开阔。",
    "start": 729.104,
    "end": 730.624,
    "duration": 1.52
  },
  {
    "id": 172,
    "text": "汉联与颈联对仗天造地设，气象雄浑而骨力老健。",
    "start": 730.624,
    "end": 735.744,
    "duration": 5.12
  },
  {
    "id": 173,
    "text": "杜甫以千锤百炼的语言功夫，将汉语律诗的声律对仗与章法结构推向了前无古人的艺术极致。",
    "start": 735.744,
    "end": 745.104,
    "duration": 9.36
  },
  {
    "id": 174,
    "text": "--。（五",
    "start": 745.104,
    "end": 745.344,
    "duration": 0.24
  },
  {
    "id": 175,
    "text": "）第四板块：文学史深远影响与后世流变。",
    "start": 745.664,
    "end": 749.264,
    "duration": 3.6
  },
  {
    "id": 176,
    "text": "-论证推演逻辑：论述大题必须有长时段的文学史眼光。",
    "start": 749.424,
    "end": 754.235,
    "duration": 4.811
  },
  {
    "id": 177,
    "text": "说明杜甫对唐代及后世诗歌的深远滋养：叙事与现实传统直接开启了中唐白居易、",
    "start": 754.235,
    "end": 761.669,
    "duration": 7.434
  },
  {
    "id": 178,
    "text": "元稹的新乐府运动，字句锤炼与以文入诗开宋诗苏轼、",
    "start": 761.669,
    "end": 766.48,
    "duration": 4.811
  },
  {
    "id": 179,
    "text": "黄庭坚及江西诗派法门。",
    "start": 766.48,
    "end": 768.667,
    "duration": 2.187
  },
  {
    "id": 180,
    "text": "总结其人格与诗艺高度合一的崇高丰碑。",
    "start": 768.667,
    "end": 772.384,
    "duration": 3.717
  },
  {
    "id": 181,
    "text": "-逐句咬合推导：具体表述到答题语句就是：最后，",
    "start": 772.384,
    "end": 775.949,
    "duration": 3.565
  },
  {
    "id": 182,
    "text": "在文学史上，杜甫确立了中国古代诗歌艺术的崇高典范，",
    "start": 775.949,
    "end": 780.263,
    "duration": 4.314
  },
  {
    "id": 183,
    "text": "对后世产生了不可估量的深远影响。，",
    "start": 780.263,
    "end": 783.078,
    "duration": 2.815
  },
  {
    "id": 184,
    "text": "这是第四分论点的核心观点立桩。",
    "start": 783.078,
    "end": 785.704,
    "duration": 2.626
  },
  {
    "id": 185,
    "text": "紧接着切入对唐代中后期的现实主义影响，",
    "start": 785.704,
    "end": 789.081,
    "duration": 3.377
  },
  {
    "id": 186,
    "text": "具体表述到答题语句就是：杜甫对现实生活的直面观察与叙事长诗的成熟创造，",
    "start": 789.081,
    "end": 795.272,
    "duration": 6.191
  },
  {
    "id": 187,
    "text": "直接启迪了中唐白居易、元稹倡导的新乐府运动。。",
    "start": 795.272,
    "end": 799.024,
    "duration": 3.752
  },
  {
    "id": 188,
    "text": "随后切入对宋代诗歌与江西诗派的深远启迪，",
    "start": 799.184,
    "end": 803.424,
    "duration": 4.24
  },
  {
    "id": 189,
    "text": "具体表述到答题语句就是：杜甫深沉含蓄的遣词炼字与以文为诗、",
    "start": 803.424,
    "end": 809.584,
    "duration": 6.16
  },
  {
    "id": 190,
    "text": "以议论入诗的艺术探索，成为北宋苏轼、",
    "start": 809.584,
    "end": 812.864,
    "duration": 3.28
  },
  {
    "id": 191,
    "text": "黄庭坚及江西诗派奉为圭聂的美学法宝。。",
    "start": 812.864,
    "end": 816.624,
    "duration": 3.76
  },
  {
    "id": 192,
    "text": "最后总结诗教传统与人格力量合一的典范意义，",
    "start": 816.92,
    "end": 821.08,
    "duration": 4.16
  },
  {
    "id": 193,
    "text": "具体表述到答题语句就是：杜甫将儒家诗教传统与卓越的艺术创造完美统一，",
    "start": 821.08,
    "end": 827.8,
    "duration": 6.72
  },
  {
    "id": 194,
    "text": "为后代诗人树立了艺术水准与人格力量高度契合的崇高丰碑。。",
    "start": 827.8,
    "end": 833.08,
    "duration": 5.28
  },
  {
    "id": 195,
    "text": "最后，在文学史上，杜甫确立了中国古代诗歌艺术的崇高典范，",
    "start": 833.08,
    "end": 838.2,
    "duration": 5.12
  },
  {
    "id": 196,
    "text": "对后世产生了不可估量的深远影响。",
    "start": 838.2,
    "end": 841.08,
    "duration": 2.88
  },
  {
    "id": 197,
    "text": "杜甫对现实生活的直面观察与叙事长诗的成熟创造，",
    "start": 841.32,
    "end": 845.8,
    "duration": 4.48
  },
  {
    "id": 198,
    "text": "直接启迪了中唐白居易、元稹倡导的新乐府运动。",
    "start": 845.8,
    "end": 850.2,
    "duration": 4.4
  },
  {
    "id": 199,
    "text": "杜甫深沉含蓄的遣词炼字与以文为诗、",
    "start": 850.2,
    "end": 854.2,
    "duration": 4.0
  },
  {
    "id": 200,
    "text": "以议论入诗的艺术探索，成为北宋苏轼、",
    "start": 854.2,
    "end": 857.32,
    "duration": 3.12
  },
  {
    "id": 201,
    "text": "黄庭坚及江西诗派奉为圭聂的美学法宝。",
    "start": 857.32,
    "end": 861.08,
    "duration": 3.76
  },
  {
    "id": 202,
    "text": "杜甫将儒家诗教传统与卓越的艺术创造完美统一，",
    "start": 861.08,
    "end": 865.24,
    "duration": 4.16
  },
  {
    "id": 203,
    "text": "为后代诗人树立了艺术水准与人格力量高度契合的崇高丰碑。",
    "start": 865.24,
    "end": 870.04,
    "duration": 4.8
  },
  {
    "id": 204,
    "text": "---。（六",
    "start": 870.2,
    "end": 870.418,
    "duration": 0.218
  },
  {
    "id": 205,
    "text": "）总结升华板块。",
    "start": 870.418,
    "end": 871.724,
    "duration": 1.306
  },
  {
    "id": 206,
    "text": "收口推演逻辑：统领全篇论述，综合美学风格、",
    "start": 871.724,
    "end": 875.643,
    "duration": 3.919
  },
  {
    "id": 207,
    "text": "诗史胸襟与形式集大成三大支柱，再次确立杜甫作为古典诗歌史上承前启后宗师的最高定论，",
    "start": 875.643,
    "end": 884.135,
    "duration": 8.492
  },
  {
    "id": 208,
    "text": "圆满收束全卷。",
    "start": 884.135,
    "end": 885.442,
    "duration": 1.307
  },
  {
    "id": 209,
    "text": "逐句咬合推导：具体表述到答题语句就是：综上所述，",
    "start": 885.442,
    "end": 890.014,
    "duration": 4.572
  },
  {
    "id": 210,
    "text": "杜甫以沉郁顿挫的美学风范包孕了沉重悲壮的盛衰时代。。",
    "start": 890.014,
    "end": 895.24,
    "duration": 5.226
  },
  {
    "id": 211,
    "text": "最后以一句话完成古典诗歌巅峰坐标的定论，",
    "start": 895.32,
    "end": 899.24,
    "duration": 3.92
  },
  {
    "id": 212,
    "text": "具体表述到答题语句就是：他以诗史的胸襟记录了民族创伤，",
    "start": 899.24,
    "end": 904.28,
    "duration": 5.04
  },
  {
    "id": 213,
    "text": "以集大成的形式推高了律诗极限，是中国古典诗歌史上承前启后、",
    "start": 904.28,
    "end": 909.96,
    "duration": 5.68
  },
  {
    "id": 214,
    "text": "万代敬仰的艺术宗师。。",
    "start": 909.96,
    "end": 912.04,
    "duration": 2.08
  },
  {
    "id": 215,
    "text": "综上所述，杜甫以沉郁顿挫的美学风范包孕了沉重悲壮的盛衰时代。",
    "start": 912.04,
    "end": 917.56,
    "duration": 5.52
  },
  {
    "id": 216,
    "text": "他以诗史的胸襟记录了民族创伤，以集大成的形式推高了律诗极限，",
    "start": 917.88,
    "end": 923.88,
    "duration": 6.0
  },
  {
    "id": 217,
    "text": "是中国古典诗歌史上承前启后、万代敬仰的艺术宗师。",
    "start": 923.88,
    "end": 928.52,
    "duration": 4.64
  }
]