[
  {
    "id": 1,
    "text": "一、全题宏观破题与总揽。",
    "start": 0.08,
    "end": 2.72,
    "duration": 2.64
  },
  {
    "id": 2,
    "text": "一、这一问到底在考什么？",
    "start": 2.72,
    "end": 4.64,
    "duration": 1.92
  },
  {
    "id": 3,
    "text": "本题考查西华师大七零六古代文学首屈一指的核心考点，",
    "start": 4.64,
    "end": 9.28,
    "duration": 4.64
  },
  {
    "id": 4,
    "text": "即杜甫的诗歌艺术成就。",
    "start": 9.28,
    "end": 11.36,
    "duration": 2.08
  },
  {
    "id": 5,
    "text": "考生必须准确把握“沉郁顿挫”的风格内涵、",
    "start": 11.36,
    "end": 14.8,
    "duration": 3.44
  },
  {
    "id": 6,
    "text": "“诗史”性质与叙事突破、律诗集大成造诣以及后世深远影响。",
    "start": 14.8,
    "end": 19.6,
    "duration": 4.8
  },
  {
    "id": 7,
    "text": "二、答题的总方向是什么？",
    "start": 19.92,
    "end": 22.16,
    "duration": 2.24
  },
  {
    "id": 8,
    "text": "立足袁行配《中国文学史》第二卷关于杜甫章节的权威论述。",
    "start": 22.16,
    "end": 27.28,
    "duration": 5.12
  },
  {
    "id": 9,
    "text": "紧扣“诗圣”与盛唐向中唐历史转折的知人论世视角，",
    "start": 27.28,
    "end": 31.76,
    "duration": 4.48
  },
  {
    "id": 10,
    "text": "讲清思想感情之厚（沉郁）与艺术表现之曲（顿挫）的内在机制，",
    "start": 31.76,
    "end": 36.96,
    "duration": 5.2
  },
  {
    "id": 11,
    "text": "绝不能空洞夸耀。",
    "start": 36.96,
    "end": 38.32,
    "duration": 1.36
  },
  {
    "id": 12,
    "text": "三、分几个板块展开？",
    "start": 38.72,
    "end": 40.72,
    "duration": 2.0
  },
  {
    "id": 13,
    "text": "全篇按四大经典维度层层递进：第一板块：“沉郁顿挫”美学特质与深层机制（沉郁之情厚、",
    "start": 40.72,
    "end": 48.32,
    "duration": 7.6
  },
  {
    "id": 14,
    "text": "顿挫之法曲、登高与自京赴奉先县）。",
    "start": 48.32,
    "end": 51.44,
    "duration": 3.12
  },
  {
    "id": 15,
    "text": "第二板块：“诗史”品格与人道主义叙事突破（补史之阙更记录心灵史、",
    "start": 51.44,
    "end": 57.28,
    "duration": 5.84
  },
  {
    "id": 16,
    "text": "三吏三别与茅屋为秋风所破歌）。",
    "start": 57.28,
    "end": 60.0,
    "duration": 2.72
  },
  {
    "id": 17,
    "text": "第三板块：律诗体制集大成与形式登峰造极（拓宽题材、",
    "start": 60.24,
    "end": 64.64,
    "duration": 4.4
  },
  {
    "id": 18,
    "text": "拗救之法、登高八句皆对之极境）。",
    "start": 64.64,
    "end": 67.52,
    "duration": 2.88
  },
  {
    "id": 19,
    "text": "第四板块：文学史深远影响与后世流变（新乐府运动源头、",
    "start": 67.52,
    "end": 72.16,
    "duration": 4.64
  },
  {
    "id": 20,
    "text": "宋诗苏黄江西诗派之祖）。",
    "start": 72.16,
    "end": 74.08,
    "duration": 1.92
  },
  {
    "id": 21,
    "text": "四、全篇内在逻辑链条是什么？",
    "start": 74.08,
    "end": 76.4,
    "duration": 2.32
  },
  {
    "id": 22,
    "text": "由知人论世之时代剧变切入（时代与地位破题）趋近于剖析其最核心的标志性审美风格（风格之骨）趋近于深入其直面社会的叙事内容与思想灵魂（精神之魂）趋近于展现其将格律推向极境的形式创造（形式之法）趋近于升华至对古代诗歌史的长远滋养（历史之流）。",
    "start": 76.4,
    "end": 96.08,
    "duration": 19.68
  },
  {
    "id": 23,
    "text": "层层拓深，气势磅礴。",
    "start": 96.4,
    "end": 98.64,
    "duration": 2.24
  },
  {
    "id": 24,
    "text": "二、各板块逐句咬合推演。",
    "start": 98.64,
    "end": 101.52,
    "duration": 2.88
  },
  {
    "id": 25,
    "text": "（一）宏观定性与破题总起板块。",
    "start": 101.52,
    "end": 104.64,
    "duration": 3.12
  },
  {
    "id": 26,
    "text": "破题推演逻辑：开头必须高屋建瓴。",
    "start": 104.64,
    "end": 107.92,
    "duration": 3.28
  },
  {
    "id": 27,
    "text": "界定杜甫在现实主义传统中的至高地位，",
    "start": 107.92,
    "end": 111.2,
    "duration": 3.28
  },
  {
    "id": 28,
    "text": "交代安史之乱盛极而衰的特殊时代坐标。",
    "start": 111.2,
    "end": 114.88,
    "duration": 3.68
  },
  {
    "id": 29,
    "text": "指出其个人命运与国运民生的深度焊接，",
    "start": 114.88,
    "end": 118.32,
    "duration": 3.44
  },
  {
    "id": 30,
    "text": "最后概括风格、诗史、格律与人道四大要素，",
    "start": 118.32,
    "end": 122.32,
    "duration": 4.0
  },
  {
    "id": 31,
    "text": "引出分述。",
    "start": 122.32,
    "end": 123.12,
    "duration": 0.8
  },
  {
    "id": 32,
    "text": "-逐句咬合推导：具体表述到答题语句就是：杜甫是中国古代诗歌现实主义精神的集大成者与至高巅峰。，",
    "start": 123.36,
    "end": 131.64,
    "duration": 8.28
  },
  {
    "id": 33,
    "text": "这是对考察对象的历史最高定性。",
    "start": 131.64,
    "end": 134.4,
    "duration": 2.76
  },
  {
    "id": 34,
    "text": "紧接着交代其知人论世的时代历史节点，",
    "start": 134.528,
    "end": 137.728,
    "duration": 3.2
  },
  {
    "id": 35,
    "text": "具体表述到答题语句就是：他身处唐帝国由盛转衰的安史之乱剧变节点。",
    "start": 137.728,
    "end": 143.984,
    "duration": 6.256
  },
  {
    "id": 36,
    "text": "随后指出其将小我与苍生紧密联系的儒者胸怀，",
    "start": 143.984,
    "end": 148.188,
    "duration": 4.204
  },
  {
    "id": 37,
    "text": "具体表述到答题语句就是：杜甫以强烈的儒家仁民爱物精神，",
    "start": 148.188,
    "end": 153.444,
    "duration": 5.256
  },
  {
    "id": 38,
    "text": "将个人的漂泊坎坷同国家民族的存亡紧密焊接。",
    "start": 153.444,
    "end": 157.648,
    "duration": 4.204
  },
  {
    "id": 39,
    "text": "紧接着说明其反映时代的宏阔广度，",
    "start": 157.728,
    "end": 160.608,
    "duration": 2.88
  },
  {
    "id": 40,
    "text": "具体表述到答题语句就是：他以广阔的历史视野与炉火纯青的格律造诣，",
    "start": 160.608,
    "end": 166.961,
    "duration": 6.353
  },
  {
    "id": 41,
    "text": "为盛衰之交的时代铸造了一部鲜活壮阔的心灵全史。",
    "start": 166.961,
    "end": 171.599,
    "duration": 4.638
  },
  {
    "id": 42,
    "text": "最后落到诗圣地位与四大成就的凝练概括，",
    "start": 171.599,
    "end": 175.393,
    "duration": 3.794
  },
  {
    "id": 43,
    "text": "具体表述到答题语句就是：杜甫以沉郁顿挫的艺术风格、",
    "start": 175.393,
    "end": 180.242,
    "duration": 4.849
  },
  {
    "id": 44,
    "text": "感时伤事的诗史品格、精严化境的律诗造诣与博大深沉的人道主义情怀，",
    "start": 180.242,
    "end": 186.566,
    "duration": 6.324
  },
  {
    "id": 45,
    "text": "确立了其无可争议的“诗圣”崇高地位。",
    "start": 186.566,
    "end": 189.728,
    "duration": 3.162
  },
  {
    "id": 46,
    "text": "杜甫是中国古代诗歌现实主义精神的集大成者与至高巅峰。",
    "start": 189.808,
    "end": 194.848,
    "duration": 5.04
  },
  {
    "id": 47,
    "text": "他身处唐帝国由盛转衰的安史之乱剧变节点。",
    "start": 194.848,
    "end": 199.248,
    "duration": 4.4
  },
  {
    "id": 48,
    "text": "杜甫以强烈的儒家仁民爱物精神，将个人的漂泊坎坷同国家民族的存亡紧密焊接。",
    "start": 199.248,
    "end": 206.768,
    "duration": 7.52
  },
  {
    "id": 49,
    "text": "他以广阔的历史视野与炉火纯青的格律造诣，",
    "start": 206.768,
    "end": 210.528,
    "duration": 3.76
  },
  {
    "id": 50,
    "text": "为盛衰之交的时代铸造了一部鲜活壮阔的心灵全史。",
    "start": 210.528,
    "end": 214.848,
    "duration": 4.32
  },
  {
    "id": 51,
    "text": "杜甫以沉郁顿挫的艺术风格、感时伤事的诗史品格、",
    "start": 215.088,
    "end": 219.888,
    "duration": 4.8
  },
  {
    "id": 52,
    "text": "精严化境的律诗造诣与博大深沉的人道主义情怀，",
    "start": 219.888,
    "end": 224.288,
    "duration": 4.4
  },
  {
    "id": 53,
    "text": "确立了其无可争议的“诗圣”崇高地位。",
    "start": 224.288,
    "end": 227.728,
    "duration": 3.44
  },
  {
    "id": 54,
    "text": "（二）第一板块：“沉郁顿挫”美学特质与深层机制。",
    "start": 227.728,
    "end": 232.048,
    "duration": 4.32
  },
  {
    "id": 55,
    "text": "论证推演逻辑：讲透沉郁顿挫，不能望文生义。",
    "start": 232.048,
    "end": 235.888,
    "duration": 3.84
  },
  {
    "id": 56,
    "text": "必须先准确拆解学术内涵：“沉郁”指思想感情的深厚博大，",
    "start": 236.128,
    "end": 241.568,
    "duration": 5.44
  },
  {
    "id": 57,
    "text": "“顿挫”指表现手法的跌宕转折波澜起伏。",
    "start": 241.568,
    "end": 245.328,
    "duration": 3.76
  },
  {
    "id": 58,
    "text": "接着深入历史心理机制：理想破灭与天下大乱，",
    "start": 245.328,
    "end": 249.328,
    "duration": 4.0
  },
  {
    "id": 59,
    "text": "使情感不能一泻直下，只能盘旋沉咽。",
    "start": 249.328,
    "end": 252.528,
    "duration": 3.2
  },
  {
    "id": 60,
    "text": "结合《自京赴奉先县咏怀五百字》与《登高》的经典诗境进行实证。",
    "start": 252.528,
    "end": 258.208,
    "duration": 5.68
  },
  {
    "id": 61,
    "text": "-逐句咬合推导：具体表述到答题语句就是：首先，",
    "start": 258.368,
    "end": 262.39,
    "duration": 4.022
  },
  {
    "id": 62,
    "text": "在美学风格上，“沉郁顿挫”是杜甫诗歌最核心、",
    "start": 262.39,
    "end": 266.2,
    "duration": 3.81
  },
  {
    "id": 63,
    "text": "最具统摄力的美学特质。，",
    "start": 266.2,
    "end": 268.317,
    "duration": 2.117
  },
  {
    "id": 64,
    "text": "这是第一分论点的核心立桩。",
    "start": 268.317,
    "end": 270.857,
    "duration": 2.54
  },
  {
    "id": 65,
    "text": "紧接着拆解“沉郁”的学术内涵，具体表述到答题语句就是：沉郁指思想感情的深沉、",
    "start": 270.857,
    "end": 277.843,
    "duration": 6.986
  },
  {
    "id": 66,
    "text": "宽厚与博大，展现出诗人关怀现实苍生的深重悲敏。",
    "start": 277.843,
    "end": 282.288,
    "duration": 4.445
  },
  {
    "id": 67,
    "text": "随后拆解“顿挫”的表现技法，具体表述到答题语句就是：顿挫指表现手法的波澜起伏、",
    "start": 282.496,
    "end": 289.749,
    "duration": 7.253
  },
  {
    "id": 68,
    "text": "跌宕转折与感情表达的郁结盘旋。",
    "start": 289.749,
    "end": 292.736,
    "duration": 2.987
  },
  {
    "id": 69,
    "text": "紧接着揭示这一风格形成的时代心理机制，",
    "start": 292.736,
    "end": 296.576,
    "duration": 3.84
  },
  {
    "id": 70,
    "text": "具体表述到答题语句就是：这一风格根植于知人论世的历史真实。",
    "start": 296.576,
    "end": 302.336,
    "duration": 5.76
  },
  {
    "id": 71,
    "text": "进一步阐明理想受挫带来的情感压抑，",
    "start": 302.416,
    "end": 305.696,
    "duration": 3.28
  },
  {
    "id": 72,
    "text": "具体表述到答题语句就是：盛唐气象的破灭与致君尧舜理想的受挫，",
    "start": 305.696,
    "end": 311.447,
    "duration": 5.751
  },
  {
    "id": 73,
    "text": "使杜甫的情感郁结在胸而无法平直倾泻。",
    "start": 311.447,
    "end": 314.917,
    "duration": 3.47
  },
  {
    "id": 74,
    "text": "随后切入第一部经典名作实证，具体表述到答题语句就是：在《自京赴奉先县咏怀五百字》中，",
    "start": 314.917,
    "end": 322.469,
    "duration": 7.552
  },
  {
    "id": 75,
    "text": "“朱门酒肉臭，路有冻死骨”将阶级对立的严酷现实化为深沉浩叹。",
    "start": 322.469,
    "end": 327.776,
    "duration": 5.307
  },
  {
    "id": 76,
    "text": "紧接着切入第二部晚年律诗极境实证，",
    "start": 327.856,
    "end": 331.216,
    "duration": 3.36
  },
  {
    "id": 77,
    "text": "具体表述到答题语句就是：在《登高》中，",
    "start": 331.216,
    "end": 334.295,
    "duration": 3.079
  },
  {
    "id": 78,
    "text": "面对万里悲秋的壮阔江天，诗人将老病孤舟的个人迟暮与百年世事之多艰融为一体。",
    "start": 334.295,
    "end": 341.914,
    "duration": 7.619
  },
  {
    "id": 79,
    "text": "最后总结这种章法与心绪融合带来的震撼美感，",
    "start": 341.914,
    "end": 346.268,
    "duration": 4.354
  },
  {
    "id": 80,
    "text": "具体表述到答题语句就是：盘旋吞吐的章法与苍凉厚重的心绪交融，",
    "start": 346.268,
    "end": 352.364,
    "duration": 6.096
  },
  {
    "id": 81,
    "text": "形成了撼人心魄的沉郁之美。",
    "start": 352.364,
    "end": 354.976,
    "duration": 2.612
  },
  {
    "id": 82,
    "text": "首先，在美学风格上，“沉郁顿挫”是杜甫诗歌最核心、",
    "start": 355.136,
    "end": 359.056,
    "duration": 3.92
  },
  {
    "id": 83,
    "text": "最具统摄力的美学特质。",
    "start": 359.056,
    "end": 360.736,
    "duration": 1.68
  },
  {
    "id": 84,
    "text": "沉郁指思想感情的深沉、宽厚与博大，",
    "start": 360.736,
    "end": 363.616,
    "duration": 2.88
  },
  {
    "id": 85,
    "text": "展现出诗人关怀现实苍生的深重悲敏。",
    "start": 363.616,
    "end": 366.496,
    "duration": 2.88
  },
  {
    "id": 86,
    "text": "顿挫指表现手法的波澜起伏、跌宕转折与感情表达的郁结盘旋。",
    "start": 366.496,
    "end": 371.616,
    "duration": 5.12
  },
  {
    "id": 87,
    "text": "这一风格根植于知人论世的历史真实。",
    "start": 371.616,
    "end": 374.336,
    "duration": 2.72
  },
  {
    "id": 88,
    "text": "盛唐气象的破灭与致君尧舜理想的受挫，",
    "start": 374.736,
    "end": 378.576,
    "duration": 3.84
  },
  {
    "id": 89,
    "text": "使杜甫的情感郁结在胸而无法平直倾泻。",
    "start": 378.576,
    "end": 383.216,
    "duration": 4.64
  },
  {
    "id": 90,
    "text": "在《自京赴奉先县咏怀五百字》中，",
    "start": 383.216,
    "end": 386.496,
    "duration": 3.28
  },
  {
    "id": 91,
    "text": "“朱门酒肉臭，路有冻死骨”将阶级对立的严酷现实化为深沉浩叹。",
    "start": 386.496,
    "end": 393.056,
    "duration": 6.56
  },
  {
    "id": 92,
    "text": "在《登高》中，面对万里悲秋的壮阔江天，",
    "start": 393.056,
    "end": 396.656,
    "duration": 3.6
  },
  {
    "id": 93,
    "text": "诗人将老病孤舟的个人迟暮与百年世事之多艰融为一体。",
    "start": 396.656,
    "end": 402.256,
    "duration": 5.6
  },
  {
    "id": 94,
    "text": "盘旋吞吐的章法与苍凉厚重的心绪交融，",
    "start": 402.496,
    "end": 405.936,
    "duration": 3.44
  },
  {
    "id": 95,
    "text": "形成了撼人心魄的沉郁之美。",
    "start": 405.936,
    "end": 408.736,
    "duration": 2.8
  },
  {
    "id": 96,
    "text": "（三）第二板块：“诗史”品格与人道主义叙事突破。",
    "start": 408.736,
    "end": 412.976,
    "duration": 4.24
  },
  {
    "id": 97,
    "text": "论证推演逻辑：“诗史”是杜甫最著名的评价。",
    "start": 412.976,
    "end": 416.784,
    "duration": 3.808
  },
  {
    "id": 98,
    "text": "必须阐述诗史不仅是客观编年，而是饱含主观心灵震颤的“人史”。",
    "start": 416.784,
    "end": 422.228,
    "duration": 5.444
  },
  {
    "id": 99,
    "text": "分析感时伤事的叙事突破，以“三吏三别”特别是《石壕吏》的平民视角与客观叙事为证据，",
    "start": 422.228,
    "end": 429.558,
    "duration": 7.33
  },
  {
    "id": 100,
    "text": "以《茅屋为秋风所破歌》推己及人的大爱为证据，",
    "start": 429.558,
    "end": 433.536,
    "duration": 3.978
  },
  {
    "id": 101,
    "text": "论证其崇高人道主义光芒。",
    "start": 433.536,
    "end": 435.84,
    "duration": 2.304
  },
  {
    "id": 102,
    "text": "-逐句咬合推导：具体表述到答题语句就是：其次，",
    "start": 435.84,
    "end": 439.79,
    "duration": 3.95
  },
  {
    "id": 103,
    "text": "在思想主旨上，杜甫诗歌展现了记录时代沧桑的“诗史”品格与博大的人道主义悲敏。，",
    "start": 439.79,
    "end": 446.858,
    "duration": 7.068
  },
  {
    "id": 104,
    "text": "这是第二分论点的观点立桩。",
    "start": 446.858,
    "end": 449.352,
    "duration": 2.494
  },
  {
    "id": 105,
    "text": "紧接着阐明诗史超越普通历史编纂的心灵深度，",
    "start": 449.352,
    "end": 453.51,
    "duration": 4.158
  },
  {
    "id": 106,
    "text": "具体表述到答题语句就是：杜甫的诗史价值不仅在于据实补史书之阙，",
    "start": 453.51,
    "end": 459.538,
    "duration": 6.028
  },
  {
    "id": 107,
    "text": "更在于深刻记录了时代民众的心灵苦难史。",
    "start": 459.538,
    "end": 463.28,
    "duration": 3.742
  },
  {
    "id": 108,
    "text": "随后指出其叙事传统的确立，具体表述到答题语句就是：他开辟了感时伤事的现实叙事新传统。",
    "start": 463.44,
    "end": 470.674,
    "duration": 7.234
  },
  {
    "id": 109,
    "text": "紧接着切入“三吏三别”的宏阔概括，",
    "start": 470.674,
    "end": 473.426,
    "duration": 2.752
  },
  {
    "id": 110,
    "text": "具体表述到答题语句就是：“三吏三别”以平民视角直面征兵战乱的惨烈真相。",
    "start": 473.426,
    "end": 479.52,
    "duration": 6.094
  },
  {
    "id": 111,
    "text": "随后以《石壕吏》为例剖析克制叙事中的悲敏，",
    "start": 479.68,
    "end": 482.8,
    "duration": 3.12
  },
  {
    "id": 112,
    "text": "具体表述到答题语句就是：《石壕吏》在客观克制的夜捉叙述中，",
    "start": 482.8,
    "end": 487.78,
    "duration": 4.98
  },
  {
    "id": 113,
    "text": "通过老妇凄苦的泣诉，揭露了战争强加给下层小民的无情摧残。",
    "start": 487.78,
    "end": 492.956,
    "duration": 5.176
  },
  {
    "id": 114,
    "text": "进一步指出民胞物与的仁者博爱，具体表述到答题语句就是：杜甫以民胞物与的仁者胸怀体恤苍生。",
    "start": 492.956,
    "end": 501.12,
    "duration": 8.164
  },
  {
    "id": 115,
    "text": "随后引用《茅屋为秋风所破歌》名句实证，",
    "start": 501.28,
    "end": 505.12,
    "duration": 3.84
  },
  {
    "id": 116,
    "text": "具体表述到答题语句就是：《茅屋为秋风所破歌》在自身床头屋漏的绝境中，",
    "start": 505.12,
    "end": 511.446,
    "duration": 6.326
  },
  {
    "id": 117,
    "text": "迸发出“安得广厦千万间，大庇天下寒士俱欢颜”的宏伟祈愿。",
    "start": 511.446,
    "end": 516.572,
    "duration": 5.126
  },
  {
    "id": 118,
    "text": "最后升华这种大仁大爱的超越性价值，",
    "start": 516.572,
    "end": 519.988,
    "duration": 3.416
  },
  {
    "id": 119,
    "text": "具体表述到答题语句就是：这种超越小我、",
    "start": 519.988,
    "end": 523.619,
    "duration": 3.631
  },
  {
    "id": 120,
    "text": "怀抱天下生灵的大仁大爱，使他的现实记录闪耀着超越时代的崇高人道主义光芒。",
    "start": 523.619,
    "end": 530.88,
    "duration": 7.261
  },
  {
    "id": 121,
    "text": "其次，在思想主旨上，杜甫诗歌展现了记录时代沧桑的“诗史”品格与博大的人道主义悲敏。",
    "start": 531.088,
    "end": 539.008,
    "duration": 7.92
  },
  {
    "id": 122,
    "text": "杜甫的诗史价值不仅在于据实补史书之阙，",
    "start": 539.008,
    "end": 543.088,
    "duration": 4.08
  },
  {
    "id": 123,
    "text": "更在于深刻记录了时代民众的心灵苦难史。",
    "start": 543.088,
    "end": 546.608,
    "duration": 3.52
  },
  {
    "id": 124,
    "text": "他开辟了感时伤事的现实叙事新传统。",
    "start": 546.608,
    "end": 549.888,
    "duration": 3.28
  },
  {
    "id": 125,
    "text": "“三吏三别”以平民视角直面征兵战乱的惨烈真相。",
    "start": 549.888,
    "end": 553.888,
    "duration": 4.0
  },
  {
    "id": 126,
    "text": "《石壕吏》在客观克制的夜捉叙述中，",
    "start": 554.128,
    "end": 557.341,
    "duration": 3.213
  },
  {
    "id": 127,
    "text": "通过老妇凄苦的泣诉，揭露了战争强加给下层小民的无情摧残。",
    "start": 557.341,
    "end": 563.308,
    "duration": 5.967
  },
  {
    "id": 128,
    "text": "杜甫以民胞物与的仁者胸怀体恤苍生。",
    "start": 563.308,
    "end": 566.98,
    "duration": 3.672
  },
  {
    "id": 129,
    "text": "《茅屋为秋风所破歌》在自身床头屋漏的绝境中，",
    "start": 566.98,
    "end": 571.34,
    "duration": 4.36
  },
  {
    "id": 130,
    "text": "迸发出“安得广厦千万间，大庇天下寒士俱欢颜”的宏伟祈愿。",
    "start": 571.34,
    "end": 576.848,
    "duration": 5.508
  },
  {
    "id": 131,
    "text": "这种超越小我、怀抱天下生灵的大仁大爱，",
    "start": 577.008,
    "end": 580.528,
    "duration": 3.52
  },
  {
    "id": 132,
    "text": "使他的现实记录闪耀着超越时代的崇高人道主义光芒。",
    "start": 580.528,
    "end": 585.328,
    "duration": 4.8
  },
  {
    "id": 133,
    "text": "（四）第三板块：律诗体制集大成与形式登峰造极。",
    "start": 585.328,
    "end": 590.128,
    "duration": 4.8
  },
  {
    "id": 134,
    "text": "论证推演逻辑：杜甫被尊为诗圣，形式上的集大成至关重要。",
    "start": 590.128,
    "end": 595.408,
    "duration": 5.28
  },
  {
    "id": 135,
    "text": "必须说明其打破齐梁浮艳声色，拓展题材容量。",
    "start": 595.408,
    "end": 599.248,
    "duration": 3.84
  },
  {
    "id": 136,
    "text": "阐述其将对仗、音韵与“拗救”变格融为一体的高超手段。",
    "start": 599.488,
    "end": 604.048,
    "duration": 4.56
  },
  {
    "id": 137,
    "text": "以《登高》八句皆对、气象雄浑、骨力老健为例，",
    "start": 604.048,
    "end": 607.568,
    "duration": 3.52
  },
  {
    "id": 138,
    "text": "证明其将汉语古典诗歌格律推向极致。",
    "start": 607.568,
    "end": 610.448,
    "duration": 2.88
  },
  {
    "id": 139,
    "text": "逐句咬合推导：具体表述到答题语句就是：第三，",
    "start": 610.608,
    "end": 614.208,
    "duration": 3.6
  },
  {
    "id": 140,
    "text": "在体制艺术上，杜甫实现了中国古代律诗艺术的全面集大成与形式登峰造极。，",
    "start": 614.208,
    "end": 620.288,
    "duration": 6.08
  },
  {
    "id": 141,
    "text": "这是第三分论点的提纲窃领。",
    "start": 620.288,
    "end": 622.288,
    "duration": 2.0
  },
  {
    "id": 142,
    "text": "紧接着说明其打破前代声律狭隘格式的突破，",
    "start": 622.528,
    "end": 626.528,
    "duration": 4.0
  },
  {
    "id": 143,
    "text": "具体表述到答题语句就是：杜甫彻底打破了齐梁以来律诗偏于声色浮艳的狭隘格式。",
    "start": 626.528,
    "end": 633.889,
    "duration": 7.361
  },
  {
    "id": 144,
    "text": "随后阐明题材容量的扩充与苦心锤炼，",
    "start": 633.889,
    "end": 637.24,
    "duration": 3.351
  },
  {
    "id": 145,
    "text": "具体表述到答题语句就是：他极大拓宽了律诗的题材边界与抒情容量，",
    "start": 637.24,
    "end": 643.314,
    "duration": 6.074
  },
  {
    "id": 146,
    "text": "做到了“语不惊人死不休”。",
    "start": 643.314,
    "end": 645.408,
    "duration": 2.094
  },
  {
    "id": 147,
    "text": "紧接着指出其规范与变通并重的技巧，",
    "start": 645.488,
    "end": 648.688,
    "duration": 3.2
  },
  {
    "id": 148,
    "text": "具体表述到答题语句就是：他不仅将五七言律诗锻造得音韵协调、",
    "start": 648.688,
    "end": 654.128,
    "duration": 5.44
  },
  {
    "id": 149,
    "text": "对仗极其工稳，更创立了“拗救”与变格手法，",
    "start": 654.128,
    "end": 658.288,
    "duration": 4.16
  },
  {
    "id": 150,
    "text": "实现了形式规范与情感起伏的自由融合。",
    "start": 658.288,
    "end": 661.888,
    "duration": 3.6
  },
  {
    "id": 151,
    "text": "随后切入古今七律第一的《登高》实证，",
    "start": 661.888,
    "end": 664.688,
    "duration": 2.8
  },
  {
    "id": 152,
    "text": "具体表述到答题语句就是：其代表作《登高》八句皆对，",
    "start": 664.688,
    "end": 669.328,
    "duration": 4.64
  },
  {
    "id": 153,
    "text": "首联句中自对，沉着开阔。",
    "start": 669.328,
    "end": 671.408,
    "duration": 2.08
  },
  {
    "id": 154,
    "text": "紧接着分析其中联的气象与骨力，具体表述到答题语句就是：汉联与颈联对仗天造地设，",
    "start": 671.696,
    "end": 679.285,
    "duration": 7.589
  },
  {
    "id": 155,
    "text": "气象雄浑而骨力老健。",
    "start": 679.285,
    "end": 681.165,
    "duration": 1.88
  },
  {
    "id": 156,
    "text": "最后总结其在格律艺术上达到的崇高境界，",
    "start": 681.165,
    "end": 684.927,
    "duration": 3.762
  },
  {
    "id": 157,
    "text": "具体表述到答题语句就是：杜甫以千锤百炼的语言功夫，",
    "start": 684.927,
    "end": 689.734,
    "duration": 4.807
  },
  {
    "id": 158,
    "text": "将汉语律诗的声律对仗与章法结构推向了前无古人的艺术极致。",
    "start": 689.734,
    "end": 695.376,
    "duration": 5.642
  },
  {
    "id": 159,
    "text": "第三，在体制艺术上，杜甫实现了中国古代律诗艺术的全面集大成与形式登峰造极。",
    "start": 695.456,
    "end": 703.216,
    "duration": 7.76
  },
  {
    "id": 160,
    "text": "杜甫彻底打破了齐梁以来律诗偏于声色浮艳的狭隘格式。",
    "start": 703.216,
    "end": 708.976,
    "duration": 5.76
  },
  {
    "id": 161,
    "text": "他极大拓宽了律诗的题材边界与抒情容量，",
    "start": 708.976,
    "end": 712.976,
    "duration": 4.0
  },
  {
    "id": 162,
    "text": "做到了“语不惊人死不休”。",
    "start": 712.976,
    "end": 715.056,
    "duration": 2.08
  },
  {
    "id": 163,
    "text": "他不仅将五七言律诗锻造得音韵协调、",
    "start": 715.056,
    "end": 718.496,
    "duration": 3.44
  },
  {
    "id": 164,
    "text": "对仗极其工稳，更创立了“拗救”与变格手法，",
    "start": 718.496,
    "end": 722.576,
    "duration": 4.08
  },
  {
    "id": 165,
    "text": "实现了形式规范与情感起伏的自由融合。",
    "start": 722.576,
    "end": 726.016,
    "duration": 3.44
  },
  {
    "id": 166,
    "text": "其代表作《登高》八句皆对，首联句中自对，",
    "start": 726.416,
    "end": 730.176,
    "duration": 3.76
  },
  {
    "id": 167,
    "text": "沉着开阔。",
    "start": 730.176,
    "end": 731.376,
    "duration": 1.2
  },
  {
    "id": 168,
    "text": "汉联与颈联对仗天造地设，气象雄浑而骨力老健。",
    "start": 731.376,
    "end": 736.576,
    "duration": 5.2
  },
  {
    "id": 169,
    "text": "杜甫以千锤百炼的语言功夫，将汉语律诗的声律对仗与章法结构推向了前无古人的艺术极致。",
    "start": 736.576,
    "end": 744.976,
    "duration": 8.4
  },
  {
    "id": 170,
    "text": "（五）第四板块：文学史深远影响与后世流变。",
    "start": 744.976,
    "end": 748.736,
    "duration": 3.76
  },
  {
    "id": 171,
    "text": "-论证推演逻辑：论述大题必须有长时段的文学史眼光。",
    "start": 748.976,
    "end": 753.787,
    "duration": 4.811
  },
  {
    "id": 172,
    "text": "说明杜甫对唐代及后世诗歌的深远滋养：叙事与现实传统直接开启了中唐白居易、",
    "start": 753.787,
    "end": 761.221,
    "duration": 7.434
  },
  {
    "id": 173,
    "text": "元稹的新乐府运动，字句锤炼与以文入诗开宋诗苏轼、",
    "start": 761.221,
    "end": 766.032,
    "duration": 4.811
  },
  {
    "id": 174,
    "text": "黄庭坚及江西诗派法门。",
    "start": 766.032,
    "end": 768.219,
    "duration": 2.187
  },
  {
    "id": 175,
    "text": "总结其人格与诗艺高度合一的崇高丰碑。",
    "start": 768.219,
    "end": 771.936,
    "duration": 3.717
  },
  {
    "id": 176,
    "text": "-逐句咬合推导：具体表述到答题语句就是：最后，",
    "start": 771.936,
    "end": 775.501,
    "duration": 3.565
  },
  {
    "id": 177,
    "text": "在文学史上，杜甫确立了中国古代诗歌艺术的崇高典范，",
    "start": 775.501,
    "end": 779.815,
    "duration": 4.314
  },
  {
    "id": 178,
    "text": "对后世产生了不可估量的深远影响。，",
    "start": 779.815,
    "end": 782.63,
    "duration": 2.815
  },
  {
    "id": 179,
    "text": "这是第四分论点的核心观点立桩。",
    "start": 782.63,
    "end": 785.256,
    "duration": 2.626
  },
  {
    "id": 180,
    "text": "紧接着切入对唐代中后期的现实主义影响，",
    "start": 785.256,
    "end": 788.633,
    "duration": 3.377
  },
  {
    "id": 181,
    "text": "具体表述到答题语句就是：杜甫对现实生活的直面观察与叙事长诗的成熟创造，",
    "start": 788.633,
    "end": 794.824,
    "duration": 6.191
  },
  {
    "id": 182,
    "text": "直接启迪了中唐白居易、元稹倡导的新乐府运动。",
    "start": 794.824,
    "end": 798.576,
    "duration": 3.752
  },
  {
    "id": 183,
    "text": "随后切入对宋代诗歌与江西诗派的深远启迪，",
    "start": 798.736,
    "end": 802.976,
    "duration": 4.24
  },
  {
    "id": 184,
    "text": "具体表述到答题语句就是：杜甫深沉含蓄的遣词炼字与以文为诗、",
    "start": 802.976,
    "end": 809.136,
    "duration": 6.16
  },
  {
    "id": 185,
    "text": "以议论入诗的艺术探索，成为北宋苏轼、",
    "start": 809.136,
    "end": 812.416,
    "duration": 3.28
  },
  {
    "id": 186,
    "text": "黄庭坚及江西诗派奉为圭聂的美学法宝。",
    "start": 812.416,
    "end": 816.176,
    "duration": 3.76
  },
  {
    "id": 187,
    "text": "最后总结诗教传统与人格力量合一的典范意义，",
    "start": 816.464,
    "end": 820.624,
    "duration": 4.16
  },
  {
    "id": 188,
    "text": "具体表述到答题语句就是：杜甫将儒家诗教传统与卓越的艺术创造完美统一，",
    "start": 820.624,
    "end": 827.344,
    "duration": 6.72
  },
  {
    "id": 189,
    "text": "为后代诗人树立了艺术水准与人格力量高度契合的崇高丰碑。",
    "start": 827.344,
    "end": 832.624,
    "duration": 5.28
  },
  {
    "id": 190,
    "text": "最后，在文学史上，杜甫确立了中国古代诗歌艺术的崇高典范，",
    "start": 832.624,
    "end": 837.744,
    "duration": 5.12
  },
  {
    "id": 191,
    "text": "对后世产生了不可估量的深远影响。",
    "start": 837.744,
    "end": 840.624,
    "duration": 2.88
  },
  {
    "id": 192,
    "text": "杜甫对现实生活的直面观察与叙事长诗的成熟创造，",
    "start": 840.864,
    "end": 845.344,
    "duration": 4.48
  },
  {
    "id": 193,
    "text": "直接启迪了中唐白居易、元稹倡导的新乐府运动。",
    "start": 845.344,
    "end": 849.744,
    "duration": 4.4
  },
  {
    "id": 194,
    "text": "杜甫深沉含蓄的遣词炼字与以文为诗、",
    "start": 849.744,
    "end": 853.744,
    "duration": 4.0
  },
  {
    "id": 195,
    "text": "以议论入诗的艺术探索，成为北宋苏轼、",
    "start": 853.744,
    "end": 856.864,
    "duration": 3.12
  },
  {
    "id": 196,
    "text": "黄庭坚及江西诗派奉为圭聂的美学法宝。",
    "start": 856.864,
    "end": 860.624,
    "duration": 3.76
  },
  {
    "id": 197,
    "text": "杜甫将儒家诗教传统与卓越的艺术创造完美统一，",
    "start": 860.624,
    "end": 864.784,
    "duration": 4.16
  },
  {
    "id": 198,
    "text": "为后代诗人树立了艺术水准与人格力量高度契合的崇高丰碑。",
    "start": 864.784,
    "end": 869.584,
    "duration": 4.8
  },
  {
    "id": 199,
    "text": "（六）总结升华板块。",
    "start": 869.744,
    "end": 871.142,
    "duration": 1.398
  },
  {
    "id": 200,
    "text": "收口推演逻辑：统领全篇论述，综合美学风格、",
    "start": 871.142,
    "end": 874.735,
    "duration": 3.593
  },
  {
    "id": 201,
    "text": "诗史胸襟与形式集大成三大支柱，再次确立杜甫作为古典诗歌史上承前启后宗师的最高定论，",
    "start": 874.735,
    "end": 882.522,
    "duration": 7.787
  },
  {
    "id": 202,
    "text": "圆满收束全卷。",
    "start": 882.522,
    "end": 883.72,
    "duration": 1.198
  },
  {
    "id": 203,
    "text": "逐句咬合推导：具体表述到答题语句就是：综上所述，",
    "start": 883.72,
    "end": 887.912,
    "duration": 4.192
  },
  {
    "id": 204,
    "text": "杜甫以沉郁顿挫的美学风范包孕了沉重悲壮的盛衰时代。",
    "start": 887.912,
    "end": 892.704,
    "duration": 4.792
  },
  {
    "id": 205,
    "text": "最后以一句话完成古典诗歌巅峰坐标的定论，",
    "start": 892.784,
    "end": 896.704,
    "duration": 3.92
  },
  {
    "id": 206,
    "text": "具体表述到答题语句就是：他以诗史的胸襟记录了民族创伤，",
    "start": 896.704,
    "end": 901.744,
    "duration": 5.04
  },
  {
    "id": 207,
    "text": "以集大成的形式推高了律诗极限，是中国古典诗歌史上承前启后、",
    "start": 901.744,
    "end": 907.424,
    "duration": 5.68
  },
  {
    "id": 208,
    "text": "万代敬仰的艺术宗师。",
    "start": 907.424,
    "end": 909.504,
    "duration": 2.08
  },
  {
    "id": 209,
    "text": "综上所述，杜甫以沉郁顿挫的美学风范包孕了沉重悲壮的盛衰时代。",
    "start": 909.504,
    "end": 915.024,
    "duration": 5.52
  },
  {
    "id": 210,
    "text": "他以诗史的胸襟记录了民族创伤，以集大成的形式推高了律诗极限，",
    "start": 915.344,
    "end": 921.584,
    "duration": 6.24
  },
  {
    "id": 211,
    "text": "是中国古典诗歌史上承前启后、万代敬仰的艺术宗师。",
    "start": 921.584,
    "end": 926.224,
    "duration": 4.64
  }
]