[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "柳永·对词体发展的文学史贡献",
    "start": 0.314,
    "end": 2.726,
    "duration": 2.412
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "体制决定手法，视野呼唤语言：因为先借坊曲扩大篇幅为“慢词长调”，",
    "start": 3.774,
    "end": 10.266,
    "duration": 6.492
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "词里才能装下“铺叙展衍”的复杂时空转换，进而把主题扩到“羁旅行役+市民生活”，",
    "start": 10.534,
    "end": 17.466,
    "duration": 6.932
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后匹配通俗晓畅的“俚俗口语”传唱井水饮处。",
    "start": 17.814,
    "end": 22.306,
    "duration": 4.492
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "柳永是北宋第一位专力作词的专业词人，顺应都市市民音乐全方位革新词体。",
    "start": 23.314,
    "end": 29.446,
    "duration": 6.132
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "叶梦得《避暑录话》载“凡有井水饮处，即能歌柳词”。",
    "start": 30.494,
    "end": 34.626,
    "duration": 4.132
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 大力创作慢词长调、完备词调体制",
    "start": 35.594,
    "end": 39.286,
    "duration": 3.692
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "吸纳坊曲新声，现存慢词八十七调一百二十五首，两宋百余调为其首创或首用，令、引、近、慢体制完备；",
    "start": 40.294,
    "end": 51.466,
    "duration": 11.172
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "改变小令仅截取片断之限，使词得以容纳曲折叙事与细致铺排，开启苏辛周等大家天地。",
    "start": 52.474,
    "end": 63.166,
    "duration": 10.692
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 革新表现手法、确立“铺叙展衍”与白描",
    "start": 64.134,
    "end": 68.226,
    "duration": 4.092
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "将赋法移植入词，确立“铺叙展衍”与白描配合：善用时空转换，从现在回想过去、由己方设想对方。",
    "start": 69.274,
    "end": 78.566,
    "duration": 9.292
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《八声甘州》由“对潇潇暮雨洒江天”写秋景，下片由思乡陡转设想“佳人妆楼颙望”，主客双向铺叙；",
    "start": 79.614,
    "end": 90.266,
    "duration": 10.652
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "《雨霖铃》从都门帐饮写至酒醒杨柳岸，章法绵密。",
    "start": 91.234,
    "end": 95.806,
    "duration": 4.572
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 开拓羁旅行役与市井世俗题材",
    "start": 96.514,
    "end": 99.886,
    "duration": 3.372
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "将自身仕途落魄与浪迹江湖融入词中，开创“羁旅行役”自我抒情新路；",
    "start": 100.626,
    "end": 108.118,
    "duration": 7.492
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "贴近歌妓平民悲欢并写都市繁华，如《望海潮》“市列珠玑，户盈罗绮，竞豪奢”，使宋词从书斋走向世俗生活。",
    "start": 109.126,
    "end": 121.818,
    "duration": 12.692
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 吸纳市井俚俗口语形成晓畅风貌",
    "start": 122.866,
    "end": 126.518,
    "duration": 3.652
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "打破晚唐雕琢，广纳日常俚俗口语，如《忆帝京》“系我一生心，负你千行泪”，",
    "start": 127.486,
    "end": 134.938,
    "duration": 7.452
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "《蝶恋花》“衣带渐宽终不悔，为伊消得人憔悴”；",
    "start": 135.326,
    "end": 139.258,
    "duration": 3.932
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "亦能写出“渐霜风凄紧，关河冷落，残照当楼”清健佳句，为苏周创作奠基。",
    "start": 140.226,
    "end": 149.318,
    "duration": 9.092
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "柳永以慢词长调、铺叙白描与俗语雅化打破小令狭小格局，将词从尊前欢宴拓展至羁旅与市井世情，",
    "start": 150.326,
    "end": 160.778,
    "duration": 10.452
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "为苏轼革新及周邦彦精研格律铺平道路。",
    "start": 161.206,
    "end": 165.538,
    "duration": 4.332
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：柳永“铺叙展衍”长调与苏轼“以诗为词”是北宋词史两大转折；叶梦得记“凡有井水饮处，即能歌柳词”。",
    "start": 166.546,
    "end": 177.818,
    "duration": 11.272
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 柳永慢词体制数字及“令、引、近、慢”四字口诀？",
    "start": 178.786,
    "end": 185.558,
    "duration": 6.772
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《八声甘州》讲清“赋法入词/铺叙展衍”机制？",
    "start": 186.526,
    "end": 192.298,
    "duration": 5.772
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 用《望海潮》《蝶恋花》与“渐霜风凄紧”说明题材与雅俗兼融？",
    "start": 193.226,
    "end": 200.078,
    "duration": 6.852
  }
]