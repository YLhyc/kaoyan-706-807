[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "体制决定手法，视野呼唤语言：因为先借坊曲扩大篇幅为“慢词长调”，",
    "start": 0.22,
    "end": 6.951,
    "duration": 6.731
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "词里才能装下“铺叙展衍”的复杂时空转换，进而把主题扩到“羁旅行役+市民生活”，",
    "start": 7.726,
    "end": 14.327,
    "duration": 6.601
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后匹配通俗晓畅的“俚俗口语”传唱井水饮处。",
    "start": 15.07,
    "end": 18.84,
    "duration": 3.77
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "柳永是北宋第一位专力作词的专业词人，顺应都市市民音乐全方位革新词体。",
    "start": 19.567,
    "end": 25.967,
    "duration": 6.399
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "叶梦得《避暑录话》载“凡有井水饮处，即能歌柳词”。",
    "start": 26.727,
    "end": 30.707,
    "duration": 3.98
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 大力创作慢词长调、完备词调体制",
    "start": 31.394,
    "end": 35.048,
    "duration": 3.654
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "吸纳坊曲新声，现存慢词八十七调一百二十五首，两宋百余调为其首创或首用，",
    "start": 35.749,
    "end": 42.666,
    "duration": 6.917
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "令、引、近、慢体制完备；",
    "start": 43.424,
    "end": 46.087,
    "duration": 2.662
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "改变小令仅截取片断之限，使词得以容纳曲折叙事与细致铺排，开启苏辛周等大家天地。",
    "start": 46.791,
    "end": 54.782,
    "duration": 7.991
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 革新表现手法、确立“铺叙展衍”与白描",
    "start": 55.488,
    "end": 59.636,
    "duration": 4.148
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "将赋法移植入词，确立“铺叙展衍”与白描配合：善用时空转换，从现在回想过去、由己方设想对方。",
    "start": 60.388,
    "end": 68.867,
    "duration": 8.479
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《八声甘州》由“对潇潇暮雨洒江天”写秋景，下片由思乡陡转设想“佳人妆楼颙望”，主客双向铺叙；",
    "start": 69.607,
    "end": 78.041,
    "duration": 8.434
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "《雨霖铃》从都门帐饮写至酒醒杨柳岸，章法绵密。",
    "start": 78.75,
    "end": 82.805,
    "duration": 4.055
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 开拓羁旅行役与市井世俗题材",
    "start": 83.494,
    "end": 86.942,
    "duration": 3.447
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "将自身仕途落魄与浪迹江湖融入词中，开创“羁旅行役”自我抒情新路；",
    "start": 87.657,
    "end": 93.453,
    "duration": 5.797
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "贴近歌妓平民悲欢并写都市繁华，如《望海潮》“市列珠玑，户盈罗绮，竞豪奢”，",
    "start": 94.235,
    "end": 100.699,
    "duration": 6.463
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "使宋词从书斋走向世俗生活。",
    "start": 101.409,
    "end": 104.057,
    "duration": 2.647
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 吸纳市井俚俗口语形成晓畅风貌",
    "start": 104.787,
    "end": 108.479,
    "duration": 3.692
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "打破晚唐雕琢，广纳日常俚俗口语，如《忆帝京》“系我一生心，负你千行泪”，",
    "start": 109.219,
    "end": 115.384,
    "duration": 6.165
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "《蝶恋花》“衣带渐宽终不悔，为伊消得人憔悴”；",
    "start": 116.122,
    "end": 119.618,
    "duration": 3.497
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "亦能写出“渐霜风凄紧，关河冷落，残照当楼”清健佳句，为苏周创作奠基。",
    "start": 120.395,
    "end": 126.793,
    "duration": 6.398
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "柳永以慢词长调、铺叙白描与俗语雅化打破小令狭小格局，",
    "start": 127.524,
    "end": 133.036,
    "duration": 5.512
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "将词从尊前欢宴拓展至羁旅与市井世情，为苏轼革新及周邦彦精研格律铺平道路。",
    "start": 133.782,
    "end": 140.992,
    "duration": 7.21
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：柳永“铺叙展衍”长调与苏轼“以诗为词”是北宋词史两大转折；",
    "start": 141.914,
    "end": 147.828,
    "duration": 5.915
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "叶梦得记“凡有井水饮处，即能歌柳词”。",
    "start": 148.582,
    "end": 151.869,
    "duration": 3.287
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 柳永慢词体制数字及“令、引、近、慢”四字口诀？",
    "start": 152.617,
    "end": 158.915,
    "duration": 6.298
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《八声甘州》讲清“赋法入词/铺叙展衍”机制？",
    "start": 159.638,
    "end": 165.086,
    "duration": 5.448
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 用《望海潮》《蝶恋花》与“渐霜风凄紧”说明题材与雅俗兼融？",
    "start": 165.817,
    "end": 172.011,
    "duration": 6.194
  }
]