[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "柳永·对词体发展的文学史贡献",
    "start": 0.134,
    "end": 2.919,
    "duration": 2.785
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "体制决定手法，视野呼唤语言：因为先借坊曲扩大篇幅为“慢词长调”，",
    "start": 3.508,
    "end": 10.018,
    "duration": 6.509
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "词里才能装下“铺叙展衍”的复杂时空转换，进而把主题扩到“羁旅行役+市民生活”，",
    "start": 10.305,
    "end": 17.023,
    "duration": 6.718
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后匹配通俗晓畅的“俚俗口语”传唱井水饮处。",
    "start": 17.124,
    "end": 20.782,
    "duration": 3.658
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "柳永是北宋第一位专力作词的专业词人，顺应都市市民音乐全方位革新词体。",
    "start": 21.369,
    "end": 27.904,
    "duration": 6.535
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "叶梦得《避暑录话》载“凡有井水饮处，即能歌柳词”。",
    "start": 28.491,
    "end": 32.566,
    "duration": 4.075
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 大力创作慢词长调、完备词调体制",
    "start": 33.144,
    "end": 36.893,
    "duration": 3.749
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "吸纳坊曲新声，现存慢词八十七调一百二十五首，两宋百余调为其首创或首用，令、引、近、慢体制完备；",
    "start": 37.48,
    "end": 48.091,
    "duration": 10.611
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "改变小令仅截取片断之限，使词得以容纳曲折叙事与细致铺排，开启苏辛周等大家天地。",
    "start": 48.678,
    "end": 57.427,
    "duration": 8.749
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 革新表现手法、确立“铺叙展衍”与白描",
    "start": 58.014,
    "end": 62.309,
    "duration": 4.296
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "将赋法移植入词，确立“铺叙展衍”与白描配合：善用时空转换，从现在回想过去、由己方设想对方。",
    "start": 62.883,
    "end": 72.101,
    "duration": 9.218
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《八声甘州》由“对潇潇暮雨洒江天”写秋景，下片由思乡陡转设想“佳人妆楼颙望”，主客双向铺叙；",
    "start": 72.675,
    "end": 82.765,
    "duration": 10.09
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "《雨霖铃》从都门帐饮写至酒醒杨柳岸，章法绵密。",
    "start": 83.079,
    "end": 87.622,
    "duration": 4.543
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 开拓羁旅行役与市井世俗题材",
    "start": 88.209,
    "end": 91.75,
    "duration": 3.541
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "将自身仕途落魄与浪迹江湖融入词中，开创“羁旅行役”自我抒情新路；",
    "start": 92.337,
    "end": 99.224,
    "duration": 6.887
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "贴近歌妓平民悲欢并写都市繁华，如《望海潮》“市列珠玑，户盈罗绮，竞豪奢”，使宋词从书斋走向世俗生活。",
    "start": 99.797,
    "end": 110.565,
    "duration": 10.767
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 吸纳市井俚俗口语形成晓畅风貌",
    "start": 111.152,
    "end": 114.992,
    "duration": 3.84
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "打破晚唐雕琢，广纳日常俚俗口语，如《忆帝京》“系我一生心，负你千行泪”，",
    "start": 115.566,
    "end": 123.273,
    "duration": 7.707
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "《蝶恋花》“衣带渐宽终不悔，为伊消得人憔悴”；",
    "start": 123.43,
    "end": 127.27,
    "duration": 3.84
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "亦能写出“渐霜风凄紧，关河冷落，残照当楼”清健佳句，为苏周创作奠基。",
    "start": 127.844,
    "end": 135.057,
    "duration": 7.213
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "柳永以慢词长调、铺叙白描与俗语雅化打破小令狭小格局，将词从尊前欢宴拓展至羁旅与市井世情，",
    "start": 135.644,
    "end": 145.382,
    "duration": 9.739
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "为苏轼革新及周邦彦精研格律铺平道路。",
    "start": 145.67,
    "end": 149.067,
    "duration": 3.397
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：柳永“铺叙展衍”长调与苏轼“以诗为词”是北宋词史两大转折；叶梦得记“凡有井水饮处，即能歌柳词”。",
    "start": 149.641,
    "end": 159.627,
    "duration": 9.986
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 柳永慢词体制数字及“令、引、近、慢”四字口诀？",
    "start": 160.188,
    "end": 166.919,
    "duration": 6.731
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《八声甘州》讲清“赋法入词/铺叙展衍”机制？",
    "start": 167.493,
    "end": 173.117,
    "duration": 5.624
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 用《望海潮》《蝶恋花》与“渐霜风凄紧”说明题材与雅俗兼融？",
    "start": 173.691,
    "end": 180.617,
    "duration": 6.926
  }
]