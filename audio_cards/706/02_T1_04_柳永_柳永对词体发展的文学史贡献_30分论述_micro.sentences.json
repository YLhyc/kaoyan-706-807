[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "体制决定手法，视野呼唤语言：因为先借坊曲扩大篇幅为“慢词长调”，",
    "start": 0.0,
    "end": 6.44,
    "duration": 6.44
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "词里才能装下“铺叙展衍”的复杂时空转换，",
    "start": 6.569,
    "end": 9.769,
    "duration": 3.2
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "进而把主题扩到“羁旅行役+市民生活”，",
    "start": 10.219,
    "end": 13.779,
    "duration": 3.56
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后匹配通俗晓畅的“俚俗口语”传唱井水饮处。",
    "start": 14.229,
    "end": 18.069,
    "duration": 3.84
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "柳永是北宋第一位专力作词的专业词人，顺应都市市民音乐全方位革新词体。",
    "start": 18.599,
    "end": 24.719,
    "duration": 6.12
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "叶梦得《避暑录话》载“凡有井水饮处，即能歌柳词”。",
    "start": 25.249,
    "end": 29.449,
    "duration": 4.2
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 大力创作慢词长调、完备词调体制",
    "start": 29.979,
    "end": 33.459,
    "duration": 3.48
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "吸纳坊曲新声，现存慢词八十七调一百二十五首，",
    "start": 33.909,
    "end": 38.149,
    "duration": 4.24
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "两宋百余调为其首创或首用，令、引、近、慢体制完备；",
    "start": 38.599,
    "end": 43.399,
    "duration": 4.8
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "改变小令仅截取片断之限，使词得以容纳曲折叙事与细致铺排，",
    "start": 43.849,
    "end": 49.129,
    "duration": 5.28
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "开启苏辛周等大家天地。",
    "start": 49.659,
    "end": 51.619,
    "duration": 1.96
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 革新表现手法、确立“铺叙展衍”与白描",
    "start": 52.069,
    "end": 56.189,
    "duration": 4.12
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "将赋法移植入词，确立“铺叙展衍”与白描配合：善用时空转换，",
    "start": 56.639,
    "end": 61.799,
    "duration": 5.16
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "从现在回想过去、由己方设想对方。",
    "start": 62.249,
    "end": 65.209,
    "duration": 2.96
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《八声甘州》由“对潇潇暮雨洒江天”写秋景，",
    "start": 65.659,
    "end": 69.099,
    "duration": 3.44
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "下片由思乡陡转设想“佳人妆楼颙望”，主客双向铺叙；",
    "start": 69.549,
    "end": 74.389,
    "duration": 4.84
  },
  {
    "id": "sec1_step1_c2",
    "dom_key": "sec1_step1_c2",
    "text": "《雨霖铃》从都门帐饮写至酒醒杨柳岸，章法绵密。",
    "start": 74.839,
    "end": 79.079,
    "duration": 4.24
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 开拓羁旅行役与市井世俗题材",
    "start": 79.529,
    "end": 83.209,
    "duration": 3.68
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "将自身仕途落魄与浪迹江湖融入词中，开创“羁旅行役”自我抒情新路；",
    "start": 83.659,
    "end": 89.459,
    "duration": 5.8
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "贴近歌妓平民悲欢并写都市繁华，如《望海潮》“市列珠玑，户盈罗绮，",
    "start": 89.909,
    "end": 96.029,
    "duration": 6.12
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "竞豪奢”，使宋词从书斋走向世俗生活。",
    "start": 96.479,
    "end": 100.199,
    "duration": 3.72
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 吸纳市井俚俗口语形成晓畅风貌",
    "start": 100.729,
    "end": 104.409,
    "duration": 3.68
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "打破晚唐雕琢，广纳日常俚俗口语，如《忆帝京》“系我一生心，",
    "start": 104.859,
    "end": 109.939,
    "duration": 5.08
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "负你千行泪”，《蝶恋花》“衣带渐宽终不悔，为伊消得人憔悴”；",
    "start": 110.389,
    "end": 115.229,
    "duration": 4.84
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "亦能写出“渐霜风凄紧，关河冷落，残照当楼”清健佳句，为苏周创作奠基。",
    "start": 115.679,
    "end": 121.999,
    "duration": 6.32
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "柳永以慢词长调、铺叙白描与俗语雅化打破小令狭小格局，",
    "start": 122.529,
    "end": 127.449,
    "duration": 4.92
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "将词从尊前欢宴拓展至羁旅与市井世情，",
    "start": 127.899,
    "end": 131.499,
    "duration": 3.6
  },
  {
    "id": "concl_c2",
    "dom_key": "concl_c2",
    "text": "为苏轼革新及周邦彦精研格律铺平道路。",
    "start": 132.109,
    "end": 135.469,
    "duration": 3.36
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：柳永“铺叙展衍”长调与苏轼“以诗为词”是北宋词史两大转折；",
    "start": 135.919,
    "end": 141.959,
    "duration": 6.04
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "叶梦得记“凡有井水饮处，即能歌柳词”。",
    "start": 142.409,
    "end": 145.609,
    "duration": 3.2
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 柳永慢词体制数字及“令、引、近、慢”四字口诀？",
    "start": 146.059,
    "end": 151.859,
    "duration": 5.8
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《八声甘州》讲清“赋法入词/铺叙展衍”机制？",
    "start": 152.309,
    "end": 157.749,
    "duration": 5.44
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 用《望海潮》《蝶恋花》与“渐霜风凄紧”说明题材与雅俗兼融？",
    "start": 158.199,
    "end": 164.479,
    "duration": 6.28
  }
]