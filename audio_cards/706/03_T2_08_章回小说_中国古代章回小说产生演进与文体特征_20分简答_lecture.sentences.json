[
  {
    "id": 1,
    "text": "简述中国古代章回小说的产生演进历程与文体特征。",
    "start": 0.095,
    "end": 4.468,
    "duration": 4.373
  },
  {
    "id": 2,
    "text": "中国古代章回小说是宋元讲史话本与文人长篇独创相结合而诞生的一种极具民族特色的叙事文学体制。",
    "start": 4.799,
    "end": 13.69,
    "duration": 8.891
  },
  {
    "id": 3,
    "text": "章回小说的产生与演进历程及其独树一帜的文体特征，",
    "start": 13.914,
    "end": 18.378,
    "duration": 4.464
  },
  {
    "id": 4,
    "text": "主要展现为以下三个核心维度：",
    "start": 18.443,
    "end": 20.884,
    "duration": 2.441
  },
  {
    "id": 5,
    "text": "第一，根植宋元说话讲史传统，",
    "start": 21.135,
    "end": 23.796,
    "duration": 2.661
  },
  {
    "id": 6,
    "text": "完成由民间话本向文人独立创作的历史跃迁。",
    "start": 24.17,
    "end": 27.623,
    "duration": 3.453
  },
  {
    "id": 7,
    "text": "章回小说孕育于宋元瓦舍勾栏中的 “说话” 伎艺，",
    "start": 28.024,
    "end": 31.894,
    "duration": 3.87
  },
  {
    "id": 8,
    "text": "特别是讲说历代征战兴亡的 “讲史” 话本。",
    "start": 32.227,
    "end": 35.44,
    "duration": 3.213
  },
  {
    "id": 9,
    "text": "民间艺人在瓦舍长篇分段说唱，为吸引听众再次光临，",
    "start": 35.82,
    "end": 40.318,
    "duration": 4.498
  },
  {
    "id": 10,
    "text": "演化出分回标目与回末设悬念的讲叙技巧。",
    "start": 40.589,
    "end": 44.631,
    "duration": 4.042
  },
  {
    "id": 11,
    "text": "元末明初，",
    "start": 44.828,
    "end": 45.757,
    "duration": 0.929
  },
  {
    "id": 12,
    "text": "文人学者对民间讲史话本进行整理加工与文学再创作，",
    "start": 45.835,
    "end": 50.577,
    "duration": 4.742
  },
  {
    "id": 13,
    "text": "产生了 《三国志通俗演义》 与 《水浒传》，",
    "start": 50.819,
    "end": 53.594,
    "duration": 2.775
  },
  {
    "id": 14,
    "text": "标志着章回小说文体的正式确立。",
    "start": 53.75,
    "end": 56.106,
    "duration": 2.356
  },
  {
    "id": 15,
    "text": "明代中叶 《金瓶梅》 的问世，",
    "start": 56.333,
    "end": 58.157,
    "duration": 1.824
  },
  {
    "id": 16,
    "text": "实现了从依傍历史与说唱底本向文人独立创作长篇家庭世情小说的里程碑式转变；",
    "start": 58.396,
    "end": 65.526,
    "duration": 7.13
  },
  {
    "id": 17,
    "text": "清代 《儒林外史》 与 《红楼梦》 的诞生，",
    "start": 65.699,
    "end": 68.463,
    "duration": 2.764
  },
  {
    "id": 18,
    "text": "则将章回小说推向了中国古典小说艺术的最高峰。",
    "start": 68.709,
    "end": 72.526,
    "duration": 3.817
  },
  {
    "id": 19,
    "text": "第二，确立分章回标目与回末设悬念的独特叙事体制。",
    "start": 72.908,
    "end": 77.915,
    "duration": 5.007
  },
  {
    "id": 20,
    "text": "章回小说在形式结构上以 “回” 为最小叙事单位，",
    "start": 78.108,
    "end": 82.264,
    "duration": 4.156
  },
  {
    "id": 21,
    "text": "全书由若干回组合连接而成。",
    "start": 82.499,
    "end": 85.026,
    "duration": 2.527
  },
  {
    "id": 22,
    "text": "每回之首冠以回目，",
    "start": 85.216,
    "end": 86.648,
    "duration": 1.432
  },
  {
    "id": 23,
    "text": "经历了由早期的单句标目到明代中叶成熟定型的双句偶合格律化回目的演变，",
    "start": 86.78,
    "end": 92.537,
    "duration": 5.757
  },
  {
    "id": 24,
    "text": "具有提纲挈领、点明主旨的作用。",
    "start": 92.653,
    "end": 94.91,
    "duration": 2.257
  },
  {
    "id": 25,
    "text": "每回之末则严格保留宋元说话人招徕听众的传统遗存，",
    "start": 95.022,
    "end": 99.2,
    "duration": 4.178
  },
  {
    "id": 26,
    "text": "以 “且听下回分解” 截断情节，",
    "start": 99.287,
    "end": 101.378,
    "duration": 2.091
  },
  {
    "id": 27,
    "text": "在此设置扣人心弦的悬念关口，",
    "start": 101.469,
    "end": 103.717,
    "duration": 2.248
  },
  {
    "id": 28,
    "text": "既增强了读者持续阅读的期待心理，",
    "start": 103.761,
    "end": 106.234,
    "duration": 2.473
  },
  {
    "id": 29,
    "text": "又保证了长篇宏制在分合转换中的内在连贯性。",
    "start": 106.389,
    "end": 110.532,
    "duration": 4.143
  },
  {
    "id": 30,
    "text": "第三，保留说书人全知叙事视角与文白相杂的语言体制。",
    "start": 110.723,
    "end": 115.686,
    "duration": 4.963
  },
  {
    "id": 31,
    "text": "章回小说普遍采用拟想的 “说话人” 视角统摄全局，",
    "start": 115.993,
    "end": 120.046,
    "duration": 4.053
  },
  {
    "id": 32,
    "text": "叙述者常以 “话表”、“话说”、“且说” 引领叙事，",
    "start": 120.331,
    "end": 124.47,
    "duration": 4.139
  },
  {
    "id": 33,
    "text": "并随时以诗词韵文对人物容貌、",
    "start": 124.819,
    "end": 127.433,
    "duration": 2.614
  },
  {
    "id": 34,
    "text": "争斗场面或道德教训加以插叙评论。",
    "start": 127.734,
    "end": 130.629,
    "duration": 2.895
  },
  {
    "id": 35,
    "text": "在长篇结构布局上，",
    "start": 130.831,
    "end": 132.314,
    "duration": 1.483
  },
  {
    "id": 36,
    "text": "呈现出由 《水浒传》 式的连环短篇串联向 《红楼梦》 式网状宏阔结构的深刻演进。",
    "start": 132.481,
    "end": 139.287,
    "duration": 6.806
  },
  {
    "id": 37,
    "text": "其语言熔通俗白话与文言笔法于一炉，",
    "start": 139.619,
    "end": 143.005,
    "duration": 3.386
  },
  {
    "id": 38,
    "text": "既具备民间语言的生动传神，又具备文人雅化的典雅精工。",
    "start": 143.411,
    "end": 148.296,
    "duration": 4.885
  }
]
