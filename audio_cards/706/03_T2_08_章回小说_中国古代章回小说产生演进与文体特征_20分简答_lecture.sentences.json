[
  {
    "id": 1,
    "text": "简述中国古代章回小说的产生演进历程与文体特征。",
    "start": 0.11,
    "end": 4.656,
    "duration": 4.546
  },
  {
    "id": 2,
    "text": "章回小说是中国古代长篇小说的主要体制，",
    "start": 4.927,
    "end": 8.125,
    "duration": 3.198
  },
  {
    "id": 3,
    "text": "孕育于宋元讲史等说话伎艺，在明代趋于定型并走向繁荣。",
    "start": 8.413,
    "end": 13.435,
    "duration": 5.022
  },
  {
    "id": 4,
    "text": "其产生演进历程与文体特征，主要体现在以下三个方面：",
    "start": 13.764,
    "end": 18.186,
    "duration": 4.422
  },
  {
    "id": 5,
    "text": "第一，脱胎于宋元说话讲史传统，由民间编创演进为文人独创。",
    "start": 18.889,
    "end": 24.486,
    "duration": 5.597
  },
  {
    "id": 6,
    "text": "章回小说源于宋元瓦舍中的“说话”伎艺，",
    "start": 24.912,
    "end": 28.316,
    "duration": 3.404
  },
  {
    "id": 7,
    "text": "尤其是长篇分节讲说历代兴废战争的“讲史”话本。",
    "start": 28.633,
    "end": 32.579,
    "duration": 3.946
  },
  {
    "id": 8,
    "text": "艺人为吸引听众连续听讲，",
    "start": 32.986,
    "end": 34.972,
    "duration": 1.986
  },
  {
    "id": 9,
    "text": "逐渐演化出分回标目与回末设悬的讲述技巧。",
    "start": 35.282,
    "end": 39.514,
    "duration": 4.232
  },
  {
    "id": 10,
    "text": "元末明初，",
    "start": 39.782,
    "end": 40.539,
    "duration": 0.757
  },
  {
    "id": 11,
    "text": "文人在民间话本基础上加工写定《三国志通俗演义》与《水浒传》，",
    "start": 40.614,
    "end": 45.87,
    "duration": 5.256
  },
  {
    "id": 12,
    "text": "标志着章回小说的正式确立；明代中叶《金瓶梅》问世，",
    "start": 46.352,
    "end": 50.558,
    "duration": 4.206
  },
  {
    "id": 13,
    "text": "开启了文人独立创作长篇世情小说的阶段；",
    "start": 50.739,
    "end": 54.247,
    "duration": 3.508
  },
  {
    "id": 14,
    "text": "至清代《儒林外史》与《红楼梦》，",
    "start": 54.765,
    "end": 56.892,
    "duration": 2.127
  },
  {
    "id": 15,
    "text": "章回小说达到艺术成熟的高峰。",
    "start": 56.994,
    "end": 59.486,
    "duration": 2.492
  },
  {
    "id": 16,
    "text": "第二，确立分回标目与回末设悬念的独特叙事体制。",
    "start": 60.154,
    "end": 64.763,
    "duration": 4.609
  },
  {
    "id": 17,
    "text": "章回小说以“回”为基本叙事单元，",
    "start": 65.094,
    "end": 67.535,
    "duration": 2.441
  },
  {
    "id": 18,
    "text": "每回相对独立而又首尾勾连，构成统一整体。",
    "start": 67.942,
    "end": 71.195,
    "duration": 3.253
  },
  {
    "id": 19,
    "text": "每回之首冠以回目，经历了由宋元平话长短参差、",
    "start": 71.424,
    "end": 75.622,
    "duration": 4.198
  },
  {
    "id": 20,
    "text": "嘉靖本《三国志通俗演义》单句七字目，",
    "start": 76.087,
    "end": 78.833,
    "duration": 2.746
  },
  {
    "id": 21,
    "text": "到万历本《水浒传》双句大致对偶，",
    "start": 79.114,
    "end": 81.601,
    "duration": 2.487
  },
  {
    "id": 22,
    "text": "再到崇祯本《金瓶梅》双句工整对偶的定型过程，",
    "start": 82.029,
    "end": 85.414,
    "duration": 3.385
  },
  {
    "id": 23,
    "text": "起到提纲挈领之效。",
    "start": 85.743,
    "end": 87.364,
    "duration": 1.621
  },
  {
    "id": 24,
    "text": "每回之末保留说话人惯例，在情节紧要处以“欲知后事如何，",
    "start": 87.743,
    "end": 93.267,
    "duration": 5.524
  },
  {
    "id": 25,
    "text": "且听下回分解”煞尾，既维系了读者期待，",
    "start": 93.504,
    "end": 96.57,
    "duration": 3.066
  },
  {
    "id": 26,
    "text": "又串接起长篇结构的连贯脉络。",
    "start": 96.861,
    "end": 99.416,
    "duration": 2.555
  },
  {
    "id": 27,
    "text": "第三，沿用说话人口吻、韵散结合与不断精进的结构布局。",
    "start": 100.051,
    "end": 104.989,
    "duration": 4.938
  },
  {
    "id": 28,
    "text": "章回小说普遍模拟“说话人”讲故事的腔调统摄全篇，",
    "start": 105.535,
    "end": 109.666,
    "duration": 4.131
  },
  {
    "id": 29,
    "text": "正文常以“话说”“且说”发端，",
    "start": 110.11,
    "end": 112.033,
    "duration": 1.923
  },
  {
    "id": 30,
    "text": "行文中兼插诗词曲赋以描摹场景、评赞人物；",
    "start": 112.494,
    "end": 116.3,
    "duration": 3.806
  },
  {
    "id": 31,
    "text": "语言融汇民间白话口语与文人雅化笔法，生动传神。",
    "start": 116.716,
    "end": 120.97,
    "duration": 4.254
  },
  {
    "id": 32,
    "text": "在长篇结构上，",
    "start": 121.261,
    "end": 122.406,
    "duration": 1.145
  },
  {
    "id": 33,
    "text": "也逐步由《三国志演义》《水浒传》式的线性串联，",
    "start": 122.519,
    "end": 126.163,
    "duration": 3.644
  },
  {
    "id": 34,
    "text": "发展为《红楼梦》式的网状交叉布局，",
    "start": 126.563,
    "end": 129.202,
    "duration": 2.639
  },
  {
    "id": 35,
    "text": "显示出中国古代长篇叙事艺术的持续深化。",
    "start": 129.54,
    "end": 133.136,
    "duration": 3.596
  }
]