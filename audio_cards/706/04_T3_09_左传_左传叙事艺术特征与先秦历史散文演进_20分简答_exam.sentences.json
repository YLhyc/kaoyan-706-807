[
  {
    "id": 1,
    "text": "简述《左传》的叙事艺术特征及其对先秦历史散文演进的文学史贡献。",
    "start": 0.05,
    "end": 6.45,
    "duration": 6.4
  },
  {
    "id": 2,
    "text": "《左传》（全称 《春秋左氏传》） 是中国古代第一部记事完备、",
    "start": 6.45,
    "end": 11.148,
    "duration": 4.698
  },
  {
    "id": 3,
    "text": "叙事宏富的编年体史学与文学巨著。",
    "start": 11.148,
    "end": 14.14,
    "duration": 2.992
  },
  {
    "id": 4,
    "text": "它突破了早期历史散文零散简略的局限，",
    "start": 14.14,
    "end": 17.579,
    "duration": 3.439
  },
  {
    "id": 5,
    "text": "标志着先秦叙事散文走向全面成熟。",
    "start": 17.579,
    "end": 20.749,
    "duration": 3.17
  },
  {
    "id": 6,
    "text": "刘知幾在 《史通》 中盛赞其 “其言简而要，其事详而博”。",
    "start": 20.749,
    "end": 24.486,
    "duration": 3.737
  },
  {
    "id": 7,
    "text": "《左传》 的叙事艺术特征及其在历史散文演进中的文学史贡献，",
    "start": 24.486,
    "end": 30.793,
    "duration": 6.307
  },
  {
    "id": 8,
    "text": "主要展现为以下三个核心维度：",
    "start": 30.793,
    "end": 33.418,
    "duration": 2.625
  },
  {
    "id": 9,
    "text": "第一，确立编年详博之叙事规制，",
    "start": 33.418,
    "end": 36.649,
    "duration": 3.231
  },
  {
    "id": 10,
    "text": "实现由记言为主向记事写人为主的历史飞跃。",
    "start": 36.649,
    "end": 40.58,
    "duration": 3.931
  },
  {
    "id": 11,
    "text": "《尚书》 与春秋前期的史书多偏重于政治誓词与言论的记载（记言），",
    "start": 40.58,
    "end": 45.538,
    "duration": 4.958
  },
  {
    "id": 12,
    "text": "而 《春秋》 经文则由于微言大义而过于简括。",
    "start": 45.538,
    "end": 49.15,
    "duration": 3.612
  },
  {
    "id": 13,
    "text": "《左传》 以鲁国十二公为纲，以时间为经，以事件为纬，",
    "start": 49.15,
    "end": 54.063,
    "duration": 4.913
  },
  {
    "id": 14,
    "text": "详尽记录了春秋二百五十余年间列国争霸、",
    "start": 54.063,
    "end": 58.83,
    "duration": 4.767
  },
  {
    "id": 15,
    "text": "政权兴亡与社会变迁的完整历程。",
    "start": 58.83,
    "end": 61.622,
    "duration": 2.792
  },
  {
    "id": 16,
    "text": "全书不仅记述历史事件的始末缘由，",
    "start": 61.622,
    "end": 64.416,
    "duration": 2.794
  },
  {
    "id": 17,
    "text": "更细致描写事件发展的前因后果，",
    "start": 64.416,
    "end": 67.189,
    "duration": 2.773
  },
  {
    "id": 18,
    "text": "展现出波澜起伏的长篇结构组织能力，",
    "start": 67.189,
    "end": 70.44,
    "duration": 3.251
  },
  {
    "id": 19,
    "text": "奠定了中国古代叙事文学的坚实基石。",
    "start": 70.44,
    "end": 73.423,
    "duration": 2.983
  },
  {
    "id": 20,
    "text": "第二，长于全景式展现战争场面，",
    "start": 73.423,
    "end": 76.531,
    "duration": 3.108
  },
  {
    "id": 21,
    "text": "开创谋略铺陈与戏剧性交锋之描写范式。",
    "start": 76.531,
    "end": 80.321,
    "duration": 3.79
  },
  {
    "id": 22,
    "text": "《左传》 写战争不单纯写两军肉搏厮杀，",
    "start": 80.321,
    "end": 83.749,
    "duration": 3.428
  },
  {
    "id": 23,
    "text": "而是将战争视为政治、外交、人心的全方位交锋。",
    "start": 83.749,
    "end": 87.719,
    "duration": 3.97
  },
  {
    "id": 24,
    "text": "在 “城濮之战”、“邲之战”、“崤之战” 等著名战役中，",
    "start": 87.719,
    "end": 91.903,
    "duration": 4.184
  },
  {
    "id": 25,
    "text": "作者详写战前君臣谋划、军事情报刺探、",
    "start": 91.903,
    "end": 95.293,
    "duration": 3.39
  },
  {
    "id": 26,
    "text": "阵前外交折冲与战略退让（如重耳 “退避三舍”），",
    "start": 95.293,
    "end": 98.627,
    "duration": 3.334
  },
  {
    "id": 27,
    "text": "随后以精练笔触白描决战胜负，",
    "start": 98.627,
    "end": 101.143,
    "duration": 2.516
  },
  {
    "id": 28,
    "text": "并在战后以君子之言总结胜败根源。",
    "start": 101.143,
    "end": 105.581,
    "duration": 4.438
  },
  {
    "id": 29,
    "text": "整场战争叙事主次分明、跌宕起伏，极富戏剧冲突张力。",
    "start": 105.581,
    "end": 110.343,
    "duration": 4.762
  },
  {
    "id": 30,
    "text": "第三，精于塑造立体生动的人物群像，",
    "start": 110.343,
    "end": 113.925,
    "duration": 3.582
  },
  {
    "id": 31,
    "text": "展现辞采斐然的行人外交辞令。",
    "start": 113.925,
    "end": 116.808,
    "duration": 2.883
  },
  {
    "id": 32,
    "text": "《左传》 善于在尖锐的利益冲突与言行细节中刻画人物。",
    "start": 116.808,
    "end": 121.309,
    "duration": 4.501
  },
  {
    "id": 33,
    "text": "无论是雄才大略的晋文公、阴险机诈的郑庄公，",
    "start": 121.309,
    "end": 125.036,
    "duration": 3.727
  },
  {
    "id": 34,
    "text": "还是深明大义的烛之武、子产，皆形神兼备。",
    "start": 125.036,
    "end": 128.712,
    "duration": 3.676
  },
  {
    "id": 35,
    "text": "书中大量记载列国外交辞令（“行人辞令”），",
    "start": 128.712,
    "end": 131.966,
    "duration": 3.254
  },
  {
    "id": 36,
    "text": "如 《烛之武退秦师》 中烛之武利用秦晋地缘矛盾瓦解秦军，",
    "start": 131.966,
    "end": 136.805,
    "duration": 4.839
  },
  {
    "id": 37,
    "text": "言辞委婉含蓄、切中利害、理直气壮，",
    "start": 136.805,
    "end": 139.922,
    "duration": 3.117
  },
  {
    "id": 38,
    "text": "不仅具备高超的辩论说服力，更具有极高的文学辞采，",
    "start": 139.922,
    "end": 143.922,
    "duration": 4.0
  },
  {
    "id": 39,
    "text": "对后世战国策士散文与史传文学产生了深远启迪。",
    "start": 143.922,
    "end": 148.032,
    "duration": 4.11
  }
]