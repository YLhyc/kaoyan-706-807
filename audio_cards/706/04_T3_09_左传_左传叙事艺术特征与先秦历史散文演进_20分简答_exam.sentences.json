[
  {
    "id": "sent_1",
    "text": "《左传》（全称 《春秋左氏传》） 是中国古代第一部记事完备、叙事宏富的编年体史学与文学巨著。",
    "start": 0.1,
    "end": 8.422,
    "duration": 8.322
  },
  {
    "id": "sent_2",
    "text": "它突破了早期历史散文零散简略的局限，",
    "start": 8.372,
    "end": 12.161,
    "duration": 3.789
  },
  {
    "id": "sent_3",
    "text": "标志着先秦叙事散文走向全面成熟。",
    "start": 12.161,
    "end": 16.132,
    "duration": 3.971
  },
  {
    "id": "sent_4",
    "text": "刘知幾在 《史通》 中盛赞其 “其言简而要，其事详而博”。",
    "start": 16.133,
    "end": 21.081,
    "duration": 4.948
  },
  {
    "id": "sent_5",
    "text": "《左传》 的叙事艺术特征及其在历史散文演进中的文学史贡献，",
    "start": 21.081,
    "end": 26.706,
    "duration": 5.625
  },
  {
    "id": "sent_6",
    "text": "主要展现为以下三个核心维度：",
    "start": 26.706,
    "end": 29.987,
    "duration": 3.281
  },
  {
    "id": "sent_7",
    "text": "第一，确立编年详博之叙事规制，",
    "start": 29.987,
    "end": 33.229,
    "duration": 3.242
  },
  {
    "id": "sent_8",
    "text": "实现由记言为主向记事写人为主的历史飞跃。",
    "start": 33.229,
    "end": 37.604,
    "duration": 4.375
  },
  {
    "id": "sent_9",
    "text": "《尚书》 与春秋前期的史书多偏重于政治誓词与言论的记载（记言），",
    "start": 37.604,
    "end": 43.672,
    "duration": 6.068
  },
  {
    "id": "sent_10",
    "text": "而 《春秋》 经文则由于微言大义而过于简括。",
    "start": 43.672,
    "end": 48.086,
    "duration": 4.414
  },
  {
    "id": "sent_11",
    "text": "《左传》 以鲁国十二公为纲，以时间为经，以事件为纬，",
    "start": 48.085,
    "end": 53.255,
    "duration": 5.17
  },
  {
    "id": "sent_12",
    "text": "详尽记录了春秋二百五十余年间列国争霸、政权兴亡与社会变迁的完整历程。",
    "start": 53.255,
    "end": 60.807,
    "duration": 7.552
  },
  {
    "id": "sent_13",
    "text": "全书不仅记述历史事件的始末缘由，更细致描写事件发展的前因后果，",
    "start": 60.807,
    "end": 67.383,
    "duration": 6.576
  },
  {
    "id": "sent_14",
    "text": "展现出波澜起伏的长篇结构组织能力，",
    "start": 67.383,
    "end": 71.159,
    "duration": 3.776
  },
  {
    "id": "sent_15",
    "text": "奠定了中国古代叙事文学的坚实基石。",
    "start": 71.159,
    "end": 74.766,
    "duration": 3.607
  },
  {
    "id": "sent_16",
    "text": "第二，长于全景式展现战争场面，",
    "start": 74.766,
    "end": 78.438,
    "duration": 3.672
  },
  {
    "id": "sent_17",
    "text": "开创谋略铺陈与戏剧性交锋之描写范式。",
    "start": 78.438,
    "end": 82.67,
    "duration": 4.232
  },
  {
    "id": "sent_18",
    "text": "《左传》 写战争不单纯写两军肉搏厮杀，",
    "start": 82.669,
    "end": 86.784,
    "duration": 4.115
  },
  {
    "id": "sent_19",
    "text": "而是将战争视为政治、外交、人心的全方位交锋。",
    "start": 86.784,
    "end": 91.862,
    "duration": 5.078
  },
  {
    "id": "sent_20",
    "text": "在 “城濮之战”、“邲之战”、“崤之战” 等著名战役中，",
    "start": 91.862,
    "end": 96.445,
    "duration": 4.583
  },
  {
    "id": "sent_21",
    "text": "作者详写战前君臣谋划、军事情报刺探、阵前外交折冲与战略退让（如重耳 “退避三舍”），",
    "start": 96.445,
    "end": 104.817,
    "duration": 8.372
  },
  {
    "id": "sent_22",
    "text": "随后以精练笔触白描决战胜负，并在战后以君子之言总结胜败根源。",
    "start": 104.818,
    "end": 111.615,
    "duration": 6.797
  },
  {
    "id": "sent_23",
    "text": "整场战争叙事主次分明、跌宕起伏，极富戏剧冲突张力。",
    "start": 111.615,
    "end": 117.253,
    "duration": 5.638
  },
  {
    "id": "sent_24",
    "text": "第三，精于塑造立体生动的人物群像，展现辞采斐然的行人外交辞令。",
    "start": 117.253,
    "end": 123.633,
    "duration": 6.38
  },
  {
    "id": "sent_25",
    "text": "《左传》 善于在尖锐的利益冲突与言行细节中刻画人物。",
    "start": 123.633,
    "end": 128.906,
    "duration": 5.273
  },
  {
    "id": "sent_26",
    "text": "无论是雄才大略的晋文公、阴险机诈的郑庄公，",
    "start": 128.906,
    "end": 133.424,
    "duration": 4.518
  },
  {
    "id": "sent_27",
    "text": "还是深明大义的烛之武、子产，皆形神兼备。",
    "start": 133.424,
    "end": 138.098,
    "duration": 4.674
  },
  {
    "id": "sent_28",
    "text": "书中大量记载列国外交辞令（“行人辞令”），",
    "start": 138.099,
    "end": 142.409,
    "duration": 4.31
  },
  {
    "id": "sent_29",
    "text": "如 《烛之武退秦师》 中烛之武利用秦晋地缘矛盾瓦解秦军，",
    "start": 142.409,
    "end": 147.748,
    "duration": 5.339
  },
  {
    "id": "sent_30",
    "text": "言辞委婉含蓄、切中利害、理直气壮，不仅具备高超的辩论说服力，",
    "start": 147.747,
    "end": 154.075,
    "duration": 6.328
  },
  {
    "id": "sent_31",
    "text": "更具有极高的文学辞采，",
    "start": 154.076,
    "end": 156.641,
    "duration": 2.565
  },
  {
    "id": "sent_32",
    "text": "对后世战国策士散文与史传文学产生了深远启迪。",
    "start": 156.641,
    "end": 161.693,
    "duration": 5.052
  }
]