[
  {
    "id": 1,
    "text": "简述《左传》的叙事艺术特征及其对先秦历史散文演进的文学史贡献。",
    "start": 0.28,
    "end": 5.32,
    "duration": 5.04
  },
  {
    "id": 2,
    "text": "《左传》（全称《春秋左氏传》）是我国第一部记事完备的编年体史书，",
    "start": 5.84,
    "end": 11.056,
    "duration": 5.216
  },
  {
    "id": 3,
    "text": "标志着先秦叙事散文的全面成熟。",
    "start": 11.426,
    "end": 14.13,
    "duration": 2.704
  },
  {
    "id": 4,
    "text": "刘知幾在《史通》中盛赞其“盖左氏为书，叙事之最”。",
    "start": 14.65,
    "end": 19.13,
    "duration": 4.48
  },
  {
    "id": 5,
    "text": "其叙事艺术特征与演进贡献，主要体现在以下三个方面：",
    "start": 19.65,
    "end": 23.81,
    "duration": 4.16
  },
  {
    "id": 6,
    "text": "第一，确立编年详博之叙事体制，推动历史散文由记言转向记事写人。",
    "start": 24.18,
    "end": 30.9,
    "duration": 6.72
  },
  {
    "id": 7,
    "text": "《尚书》与春秋早期史书偏重记言，《春秋》经文则过于简括。",
    "start": 31.42,
    "end": 36.46,
    "duration": 5.04
  },
  {
    "id": 8,
    "text": "《左传》以《春秋》记事为纲，记录春秋二百余年间列国争霸与政权兴亡，",
    "start": 36.98,
    "end": 43.46,
    "duration": 6.48
  },
  {
    "id": 9,
    "text": "不仅交代事件始末与因果脉络，还穿插倒叙、预叙等灵活笔法，",
    "start": 43.83,
    "end": 49.27,
    "duration": 5.44
  },
  {
    "id": 10,
    "text": "并开创以“君子曰”直接评价史事人物的新体式。",
    "start": 49.64,
    "end": 53.8,
    "duration": 4.16
  },
  {
    "id": 11,
    "text": "这种写法将简短纲目发展为血肉丰满的长篇叙事散文，奠定了后世史传文学的基础。",
    "start": 54.32,
    "end": 60.8,
    "duration": 6.48
  },
  {
    "id": 12,
    "text": "第二，长于全景描写重大战争，注重揭示战争因果与政治谋略。",
    "start": 61.32,
    "end": 66.68,
    "duration": 5.36
  },
  {
    "id": 13,
    "text": "《左传》写战争不局限于两军厮杀过程，而是从政治、外交与礼义角度揭示胜败根源。",
    "start": 67.2,
    "end": 74.24,
    "duration": 7.04
  },
  {
    "id": 14,
    "text": "在“城濮之战”“崤之战”“邲之战”等名战中，作者详写战前君臣谋划、外交折冲与战略退让（如晋文公“退避三舍”），",
    "start": 74.76,
    "end": 84.81,
    "duration": 10.05
  },
  {
    "id": 15,
    "text": "略写交锋厮杀却能抓住要害细节，战后又总结胜败教训。",
    "start": 85.18,
    "end": 90.06,
    "duration": 4.88
  },
  {
    "id": 16,
    "text": "叙事主次分明、波澜起伏，极富戏剧冲突色彩。",
    "start": 90.614,
    "end": 94.42,
    "duration": 3.806
  },
  {
    "id": 17,
    "text": "第三，善借言行细节刻画鲜活人物，并展现典雅精练的外交辞令。",
    "start": 94.94,
    "end": 100.54,
    "duration": 5.6
  },
  {
    "id": 18,
    "text": "《左传》极少静止肖像描摹，而善于通过人物在重大冲突中的动作与言谈展现性格，",
    "start": 101.06,
    "end": 107.46,
    "duration": 6.4
  },
  {
    "id": 19,
    "text": "如晋文公的成长、郑庄公的机诈及诸武士的忠义，皆形神兼备；",
    "start": 107.83,
    "end": 113.51,
    "duration": 5.68
  },
  {
    "id": 20,
    "text": "同时注重以生动细节传神。",
    "start": 114.03,
    "end": 116.03,
    "duration": 2.0
  },
  {
    "id": 21,
    "text": "书中保留了大量被《史通》誉为“文典而美，语博而奥”的列国“行人辞令”，如《烛之武退秦师》紧扣秦晋利害，",
    "start": 116.55,
    "end": 125.64,
    "duration": 9.09
  },
  {
    "id": 22,
    "text": "委婉切理、不卑不亢，以辞令微言扭转国势危机，",
    "start": 126.01,
    "end": 130.65,
    "duration": 4.64
  },
  {
    "id": 23,
    "text": "深远启迪了战国策士散文与后世史传创作。",
    "start": 131.05,
    "end": 134.97,
    "duration": 3.92
  }
]
