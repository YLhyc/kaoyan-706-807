[
  {
    "id": 1,
    "text": "简述《左传》的叙事艺术特征及其对先秦历史散文演进的文学史贡献。",
    "start": 0.0,
    "end": 6.47,
    "duration": 6.47
  },
  {
    "id": 2,
    "text": "《左传》（全称 《春秋左氏传》） 是中国古代第一部记事完备、",
    "start": 6.47,
    "end": 11.178,
    "duration": 4.708
  },
  {
    "id": 3,
    "text": "叙事宏富的编年体史学与文学巨著。",
    "start": 11.178,
    "end": 14.17,
    "duration": 2.992
  },
  {
    "id": 4,
    "text": "它突破了早期历史散文零散简略的局限，",
    "start": 14.17,
    "end": 17.609,
    "duration": 3.439
  },
  {
    "id": 5,
    "text": "标志着先秦叙事散文走向全面成熟。",
    "start": 17.609,
    "end": 20.779,
    "duration": 3.17
  },
  {
    "id": 6,
    "text": "刘知幾在 《史通》 中盛赞其 “其言简而要，其事详而博”。",
    "start": 20.779,
    "end": 24.516,
    "duration": 3.737
  },
  {
    "id": 7,
    "text": "《左传》 的叙事艺术特征及其在历史散文演进中的文学史贡献，",
    "start": 24.516,
    "end": 26.201,
    "duration": 1.685
  },
  {
    "id": 8,
    "text": "主要展现为以下三个核心维度：",
    "start": 26.201,
    "end": 33.448,
    "duration": 7.247
  },
  {
    "id": 9,
    "text": "第一，确立编年详博之叙事规制，",
    "start": 33.448,
    "end": 34.264,
    "duration": 0.816
  },
  {
    "id": 10,
    "text": "实现由记言为主向记事写人为主的历史飞跃。",
    "start": 34.264,
    "end": 36.67,
    "duration": 2.406
  },
  {
    "id": 11,
    "text": "《尚书》 与春秋前期的史书多偏重于政治誓词与言论的记载（记言），",
    "start": 36.67,
    "end": 42.814,
    "duration": 6.144
  },
  {
    "id": 12,
    "text": "而 《春秋》 经文则由于微言大义而过于简括。",
    "start": 42.814,
    "end": 46.764,
    "duration": 3.95
  },
  {
    "id": 13,
    "text": "《左传》 以鲁国十二公为纲，以时间为经，以事件为纬，",
    "start": 46.764,
    "end": 52.671,
    "duration": 5.907
  },
  {
    "id": 14,
    "text": "详尽记录了春秋二百五十余年间列国争霸、",
    "start": 52.671,
    "end": 55.277,
    "duration": 2.606
  },
  {
    "id": 15,
    "text": "政权兴亡与社会变迁的完整历程。",
    "start": 55.277,
    "end": 58.856,
    "duration": 3.579
  },
  {
    "id": 16,
    "text": "全书不仅记述历史事件的始末缘由，",
    "start": 58.856,
    "end": 61.649,
    "duration": 2.793
  },
  {
    "id": 17,
    "text": "更细致描写事件发展的前因后果，",
    "start": 61.649,
    "end": 64.449,
    "duration": 2.8
  },
  {
    "id": 18,
    "text": "展现出波澜起伏的长篇结构组织能力，",
    "start": 64.449,
    "end": 70.47,
    "duration": 6.021
  },
  {
    "id": 19,
    "text": "奠定了中国古代叙事文学的坚实基石。",
    "start": 70.47,
    "end": 73.453,
    "duration": 2.983
  },
  {
    "id": 20,
    "text": "第二，长于全景式展现战争场面，",
    "start": 73.453,
    "end": 74.136,
    "duration": 0.683
  },
  {
    "id": 21,
    "text": "开创谋略铺陈与戏剧性交锋之描写范式。",
    "start": 74.136,
    "end": 76.561,
    "duration": 2.425
  },
  {
    "id": 22,
    "text": "《左传》 写战争不单纯写两军肉搏厮杀，",
    "start": 76.561,
    "end": 80.351,
    "duration": 3.79
  },
  {
    "id": 23,
    "text": "而是将战争视为政治、外交、人心的全方位交锋。",
    "start": 80.351,
    "end": 85.517,
    "duration": 5.166
  },
  {
    "id": 24,
    "text": "在 “城濮之战”、“邲之战”、“崤之战” 等著名战役中，",
    "start": 85.517,
    "end": 89.869,
    "duration": 4.352
  },
  {
    "id": 25,
    "text": "作者详写战前君臣谋划、军事情报刺探、",
    "start": 89.869,
    "end": 91.933,
    "duration": 2.064
  },
  {
    "id": 26,
    "text": "阵前外交折冲与战略退让（如重耳 “退避三舍”），",
    "start": 91.933,
    "end": 97.803,
    "duration": 5.87
  },
  {
    "id": 27,
    "text": "随后以精练笔触白描决战胜负，",
    "start": 97.803,
    "end": 99.683,
    "duration": 1.88
  },
  {
    "id": 28,
    "text": "并在战后以君子之言总结胜败根源。",
    "start": 99.683,
    "end": 102.555,
    "duration": 2.872
  },
  {
    "id": 29,
    "text": "整场战争叙事主次分明、跌宕起伏，极富戏剧冲突张力。",
    "start": 102.555,
    "end": 107.866,
    "duration": 5.311
  },
  {
    "id": 30,
    "text": "第三，精于塑造立体生动的人物群像，",
    "start": 107.866,
    "end": 111.191,
    "duration": 3.325
  },
  {
    "id": 31,
    "text": "展现辞采斐然的行人外交辞令。",
    "start": 111.191,
    "end": 113.955,
    "duration": 2.764
  },
  {
    "id": 32,
    "text": "《左传》 善于在尖锐的利益冲突与言行细节中刻画人物。",
    "start": 113.955,
    "end": 119.183,
    "duration": 5.228
  },
  {
    "id": 33,
    "text": "无论是雄才大略的晋文公、阴险机诈的郑庄公，",
    "start": 119.183,
    "end": 125.058,
    "duration": 5.875
  },
  {
    "id": 34,
    "text": "还是深明大义的烛之武、子产，皆形神兼备。",
    "start": 125.058,
    "end": 127.445,
    "duration": 2.387
  },
  {
    "id": 35,
    "text": "书中大量记载列国外交辞令（“行人辞令”），",
    "start": 127.445,
    "end": 130.967,
    "duration": 3.522
  },
  {
    "id": 36,
    "text": "如 《烛之武退秦师》 中烛之武利用秦晋地缘矛盾瓦解秦军，",
    "start": 130.967,
    "end": 136.834,
    "duration": 5.867
  },
  {
    "id": 37,
    "text": "言辞委婉含蓄、切中利害、理直气壮，",
    "start": 136.834,
    "end": 139.051,
    "duration": 2.217
  },
  {
    "id": 38,
    "text": "不仅具备高超的辩论说服力，更具有极高的文学辞采，",
    "start": 139.051,
    "end": 143.902,
    "duration": 4.851
  },
  {
    "id": 39,
    "text": "对后世战国策士散文与史传文学产生了深远启迪。",
    "start": 143.902,
    "end": 148.032,
    "duration": 4.13
  }
]