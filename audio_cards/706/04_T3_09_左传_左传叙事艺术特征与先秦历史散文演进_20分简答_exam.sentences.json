[
  {
    "id": "sent_1",
    "text": "《左传》（全称 《春秋左氏传》） 是中国古代第一部记事完备、",
    "start": 0.0,
    "end": 4.12,
    "duration": 4.12
  },
  {
    "id": "sent_2",
    "text": "叙事宏富的编年体史学与文学巨著。",
    "start": 4.569,
    "end": 7.609,
    "duration": 3.04
  },
  {
    "id": "sent_3",
    "text": "它突破了早期历史散文零散简略的局限，",
    "start": 8.059,
    "end": 11.139,
    "duration": 3.08
  },
  {
    "id": "sent_4",
    "text": "标志着先秦叙事散文走向全面成熟。",
    "start": 11.589,
    "end": 14.509,
    "duration": 2.92
  },
  {
    "id": "sent_5",
    "text": "刘知幾在 《史通》 中盛赞其 “其言简而要，其事详而博”。",
    "start": 15.039,
    "end": 19.519,
    "duration": 4.48
  },
  {
    "id": "sent_6",
    "text": "《左传》 的叙事艺术特征及其在历史散文演进中的文学史贡献，",
    "start": 19.969,
    "end": 24.729,
    "duration": 4.76
  },
  {
    "id": "sent_7",
    "text": "主要展现为以下三个核心维度：",
    "start": 25.179,
    "end": 27.579,
    "duration": 2.4
  },
  {
    "id": "sent_8",
    "text": "第一，确立编年详博之叙事规制，",
    "start": 28.029,
    "end": 30.869,
    "duration": 2.84
  },
  {
    "id": "sent_9",
    "text": "实现由记言为主向记事写人为主的历史飞跃。",
    "start": 31.319,
    "end": 34.999,
    "duration": 3.68
  },
  {
    "id": "sent_10",
    "text": "《尚书》 与春秋前期的史书多偏重于政治誓词与言论的记载（记言），",
    "start": 35.449,
    "end": 40.689,
    "duration": 5.24
  },
  {
    "id": "sent_11",
    "text": "而 《春秋》 经文则由于微言大义而过于简括。",
    "start": 41.139,
    "end": 44.499,
    "duration": 3.36
  },
  {
    "id": "sent_12",
    "text": "《左传》 以鲁国十二公为纲，以时间为经，以事件为纬，",
    "start": 44.949,
    "end": 49.509,
    "duration": 4.56
  },
  {
    "id": "sent_13",
    "text": "详尽记录了春秋二百五十余年间列国争霸、",
    "start": 49.959,
    "end": 53.559,
    "duration": 3.6
  },
  {
    "id": "sent_14",
    "text": "政权兴亡与社会变迁的完整历程。",
    "start": 54.009,
    "end": 56.689,
    "duration": 2.68
  },
  {
    "id": "sent_15",
    "text": "全书不仅记述历史事件的始末缘由，",
    "start": 57.139,
    "end": 60.099,
    "duration": 2.96
  },
  {
    "id": "sent_16",
    "text": "更细致描写事件发展的前因后果，",
    "start": 60.549,
    "end": 63.109,
    "duration": 2.56
  },
  {
    "id": "sent_17",
    "text": "展现出波澜起伏的长篇结构组织能力，",
    "start": 63.559,
    "end": 66.599,
    "duration": 3.04
  },
  {
    "id": "sent_18",
    "text": "奠定了中国古代叙事文学的坚实基石。",
    "start": 67.049,
    "end": 70.009,
    "duration": 2.96
  },
  {
    "id": "sent_19",
    "text": "第二，长于全景式展现战争场面，",
    "start": 70.459,
    "end": 73.339,
    "duration": 2.88
  },
  {
    "id": "sent_20",
    "text": "开创谋略铺陈与戏剧性交锋之描写范式。",
    "start": 73.789,
    "end": 77.269,
    "duration": 3.48
  },
  {
    "id": "sent_21",
    "text": "《左传》 写战争不单纯写两军肉搏厮杀，而是将战争视为政治、",
    "start": 77.719,
    "end": 82.759,
    "duration": 5.04
  },
  {
    "id": "sent_22",
    "text": "外交、人心的全方位交锋。",
    "start": 83.289,
    "end": 85.409,
    "duration": 2.12
  },
  {
    "id": "sent_23",
    "text": "在 “城濮之战”、“邲之战”、“崤之战” 等著名战役中，",
    "start": 85.859,
    "end": 89.619,
    "duration": 3.76
  },
  {
    "id": "sent_24",
    "text": "作者详写战前君臣谋划、军事情报刺探、",
    "start": 90.069,
    "end": 93.509,
    "duration": 3.44
  },
  {
    "id": "sent_25",
    "text": "阵前外交折冲与战略退让（如重耳 “退避三舍”），",
    "start": 93.959,
    "end": 97.999,
    "duration": 4.04
  },
  {
    "id": "sent_26",
    "text": "随后以精练笔触白描决战胜负，并在战后以君子之言总结胜败根源。",
    "start": 98.449,
    "end": 104.169,
    "duration": 5.72
  },
  {
    "id": "sent_27",
    "text": "整场战争叙事主次分明、跌宕起伏，极富戏剧冲突张力。",
    "start": 104.619,
    "end": 109.019,
    "duration": 4.4
  },
  {
    "id": "sent_28",
    "text": "第三，精于塑造立体生动的人物群像，",
    "start": 109.549,
    "end": 112.749,
    "duration": 3.2
  },
  {
    "id": "sent_29",
    "text": "展现辞采斐然的行人外交辞令。",
    "start": 113.199,
    "end": 115.879,
    "duration": 2.68
  },
  {
    "id": "sent_30",
    "text": "《左传》 善于在尖锐的利益冲突与言行细节中刻画人物。",
    "start": 116.329,
    "end": 120.409,
    "duration": 4.08
  },
  {
    "id": "sent_31",
    "text": "无论是雄才大略的晋文公、阴险机诈的郑庄公，",
    "start": 120.859,
    "end": 124.539,
    "duration": 3.68
  },
  {
    "id": "sent_32",
    "text": "还是深明大义的烛之武、子产，皆形神兼备。",
    "start": 125.069,
    "end": 128.669,
    "duration": 3.6
  },
  {
    "id": "sent_33",
    "text": "书中大量记载列国外交辞令（“行人辞令”），",
    "start": 129.119,
    "end": 132.359,
    "duration": 3.24
  },
  {
    "id": "sent_34",
    "text": "如 《烛之武退秦师》 中烛之武利用秦晋地缘矛盾瓦解秦军，",
    "start": 132.809,
    "end": 137.409,
    "duration": 4.6
  },
  {
    "id": "sent_35",
    "text": "言辞委婉含蓄、切中利害、理直气壮，不仅具备高超的辩论说服力，",
    "start": 137.859,
    "end": 142.779,
    "duration": 4.92
  },
  {
    "id": "sent_36",
    "text": "更具有极高的文学辞采，",
    "start": 143.309,
    "end": 145.229,
    "duration": 1.92
  },
  {
    "id": "sent_37",
    "text": "对后世战国策士散文与史传文学产生了深远启迪。",
    "start": 145.759,
    "end": 149.919,
    "duration": 4.16
  }
]