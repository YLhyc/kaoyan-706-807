[
  {
    "id": 1,
    "text": "试论汤显祖《牡丹亭》的“至情”理想与浪漫主义戏曲艺术。",
    "start": 0.104,
    "end": 4.698,
    "duration": 4.594
  },
  {
    "id": 2,
    "text": "汤显祖是明代成就最高的戏曲作家，",
    "start": 5.597,
    "end": 8.118,
    "duration": 2.521
  },
  {
    "id": 3,
    "text": "其代表作《牡丹亭》位列“临川四梦”之首。",
    "start": 8.29,
    "end": 11.611,
    "duration": 3.321
  },
  {
    "id": 4,
    "text": "面对晚明程朱理学对人性的重重束缚与商业市民思潮的兴起，",
    "start": 12.273,
    "end": 17.048,
    "duration": 4.775
  },
  {
    "id": 5,
    "text": "汤显祖秉持“以情反理”的创作理念，",
    "start": 17.519,
    "end": 20.43,
    "duration": 2.911
  },
  {
    "id": 6,
    "text": "将民间还魂故事改造为一部礼赞青春与自由的浪漫主义传奇。",
    "start": 20.757,
    "end": 25.986,
    "duration": 5.229
  },
  {
    "id": 7,
    "text": "全剧的思想高度与艺术魅力，主要体现在以下四个方面：",
    "start": 26.438,
    "end": 30.889,
    "duration": 4.451
  },
  {
    "id": 8,
    "text": "第一，张扬生死不渝的“至情”理想，直接反拨“存天理、",
    "start": 31.535,
    "end": 36.344,
    "duration": 4.809
  },
  {
    "id": 9,
    "text": "灭人欲”的理学礼教。",
    "start": 36.446,
    "end": 38.055,
    "duration": 1.609
  },
  {
    "id": 10,
    "text": "全剧以“至情”为核心精神支柱。",
    "start": 38.547,
    "end": 40.962,
    "duration": 2.415
  },
  {
    "id": 11,
    "text": "汤显祖在《牡丹亭题词》中写道：“情不知所起，一往而深。",
    "start": 41.629,
    "end": 46.224,
    "duration": 4.595
  },
  {
    "id": 12,
    "text": "生者可以死，死可以生。",
    "start": 46.715,
    "end": 48.775,
    "duration": 2.06
  },
  {
    "id": 13,
    "text": "生而不可与死，死而不可复生者，皆非情之至也。",
    "start": 49.243,
    "end": 53.426,
    "duration": 4.183
  },
  {
    "id": 14,
    "text": "”剧中的杜丽娘本是深闺千金，",
    "start": 53.698,
    "end": 55.928,
    "duration": 2.23
  },
  {
    "id": 15,
    "text": "在《闺塾》读《关雎》初萌春思，继而入园感受良辰美景，",
    "start": 56.173,
    "end": 60.408,
    "duration": 4.235
  },
  {
    "id": 16,
    "text": "在现实压抑中因情入梦、为情而死，",
    "start": 60.892,
    "end": 63.942,
    "duration": 3.05
  },
  {
    "id": 17,
    "text": "又在鬼魂之身中与柳梦梅相依并终得复生。",
    "start": 64.471,
    "end": 68.033,
    "duration": 3.562
  },
  {
    "id": 18,
    "text": "从闺阁乖女到还魂抗争，她一次次跨过贞节关、",
    "start": 68.362,
    "end": 72.322,
    "duration": 3.96
  },
  {
    "id": 19,
    "text": "鬼门关与朝廷金阶，有力肯定了人的自然欲求与个性解放。",
    "start": 72.784,
    "end": 77.481,
    "duration": 4.697
  },
  {
    "id": 20,
    "text": "第二，融汇奇幻梦境与人间世态，",
    "start": 78.155,
    "end": 81.008,
    "duration": 2.853
  },
  {
    "id": 21,
    "text": "构建虚实相生的浪漫主义戏剧冲突。",
    "start": 81.394,
    "end": 84.335,
    "duration": 2.941
  },
  {
    "id": 22,
    "text": "《牡丹亭》打破日常因果写实边界，以天上地下、",
    "start": 84.607,
    "end": 88.503,
    "duration": 3.896
  },
  {
    "id": 23,
    "text": "人鬼幽明交错的奇想推动剧情。",
    "start": 88.869,
    "end": 91.457,
    "duration": 2.588
  },
  {
    "id": 24,
    "text": "汤显祖在《题词》中指出“梦中之情，何必非真”，",
    "start": 91.801,
    "end": 95.298,
    "duration": 3.497
  },
  {
    "id": 25,
    "text": "在《惊梦》《冥判》《魂游》等折以梦境鬼乡寄托“成人不自在”时的无拘自由。",
    "start": 95.654,
    "end": 101.55,
    "duration": 5.896
  },
  {
    "id": 26,
    "text": "但全剧并不浮悬于空幻，",
    "start": 101.834,
    "end": 103.731,
    "duration": 1.897
  },
  {
    "id": 27,
    "text": "还魂复生后的杜丽娘重返现实即受礼法约束，",
    "start": 104.109,
    "end": 107.849,
    "duration": 3.74
  },
  {
    "id": 28,
    "text": "对柳梦梅坦言“前夕鬼也，今日人也。",
    "start": 108.244,
    "end": 111.602,
    "duration": 3.358
  },
  {
    "id": 29,
    "text": "鬼可虚情，人须实礼”。",
    "start": 112.044,
    "end": 114.044,
    "duration": 2.0
  },
  {
    "id": 30,
    "text": "同时，以南安太守杜宝一味做官、",
    "start": 114.605,
    "end": 117.261,
    "duration": 2.656
  },
  {
    "id": 31,
    "text": "死守礼教与陈最良迂腐说教作为对立面，和春香、花神、",
    "start": 117.698,
    "end": 123.161,
    "duration": 5.463
  },
  {
    "id": 32,
    "text": "胡判官形成鲜明正反阵营，使浪漫奇情深植于真实社会矛盾。",
    "start": 123.446,
    "end": 128.738,
    "duration": 5.292
  },
  {
    "id": 33,
    "text": "第三，锤炼诗化典雅曲辞，兼具悲喜交融的复合戏曲风格。",
    "start": 129.403,
    "end": 134.961,
    "duration": 5.558
  },
  {
    "id": 34,
    "text": "汤显祖以深厚诗才写曲，令全剧洋溢浓郁抒情氛围。",
    "start": 135.41,
    "end": 140.085,
    "duration": 4.675
  },
  {
    "id": 35,
    "text": "《惊梦》一折中，【皂罗袍】“原来姹紫嫣红开遍，",
    "start": 140.72,
    "end": 144.523,
    "duration": 3.803
  },
  {
    "id": 36,
    "text": "似这般都付与断井颓垣。",
    "start": 144.881,
    "end": 147.175,
    "duration": 2.294
  },
  {
    "id": 37,
    "text": "良辰美景奈何天，赏心乐事谁家院”一唱三叹，",
    "start": 147.619,
    "end": 152.076,
    "duration": 4.457
  },
  {
    "id": 38,
    "text": "将惜春叹命与向往自由抒发得动人心魄。",
    "start": 152.353,
    "end": 155.779,
    "duration": 3.426
  },
  {
    "id": 39,
    "text": "在结构情调上，",
    "start": 156.316,
    "end": 157.365,
    "duration": 1.049
  },
  {
    "id": 40,
    "text": "全剧将《闹殇》《诀谒》的惨痛悲情与《闺塾》春香闹学、",
    "start": 157.691,
    "end": 162.253,
    "duration": 4.562
  },
  {
    "id": 41,
    "text": "石道姑诙谐插科打诨融汇调度。",
    "start": 162.769,
    "end": 165.645,
    "duration": 2.876
  },
  {
    "id": 42,
    "text": "王思任评其“笑者真笑，笑即有声；啼者真啼，啼则有泪”，",
    "start": 166.188,
    "end": 171.64,
    "duration": 5.452
  },
  {
    "id": 43,
    "text": "正道出这种悲喜相映的独特艺术魅力。",
    "start": 171.856,
    "end": 174.91,
    "duration": 3.054
  },
  {
    "id": 44,
    "text": "第四，开晚明“临川派”主情先声，影响清代戏曲与小说创作。",
    "start": 175.522,
    "end": 180.619,
    "duration": 5.097
  },
  {
    "id": 45,
    "text": "《牡丹亭》是继《西厢记》之后古代爱情戏曲的又一座高峰。",
    "start": 181.066,
    "end": 185.136,
    "duration": 4.07
  },
  {
    "id": 46,
    "text": "明代沈德符《万历野获编》载：“汤义仍《牡丹亭梦》一出，",
    "start": 185.561,
    "end": 189.678,
    "duration": 4.117
  },
  {
    "id": 47,
    "text": "家传户诵，几令《西厢》减价。",
    "start": 190.04,
    "end": 192.143,
    "duration": 2.103
  },
  {
    "id": 48,
    "text": "”该剧不仅直接引领吴炳、",
    "start": 192.428,
    "end": 194.281,
    "duration": 1.853
  },
  {
    "id": 49,
    "text": "孟称舜等玉茗堂派剧作家的主情创作，",
    "start": 194.492,
    "end": 197.171,
    "duration": 2.679
  },
  {
    "id": 50,
    "text": "更开启清代洪昇《长生殿》深情写史与孔尚任《桃花扇》离合寄兴之风；",
    "start": 197.495,
    "end": 202.835,
    "duration": 5.34
  },
  {
    "id": 51,
    "text": "曹雪芹在《红楼梦》第二十三回写林黛玉听闻“良辰美景”戏文而心动神摇、",
    "start": 203.24,
    "end": 208.667,
    "duration": 5.427
  },
  {
    "id": 52,
    "text": "如痴如醉，亦见其深远沾溉。",
    "start": 209.169,
    "end": 211.299,
    "duration": 2.13
  }
]