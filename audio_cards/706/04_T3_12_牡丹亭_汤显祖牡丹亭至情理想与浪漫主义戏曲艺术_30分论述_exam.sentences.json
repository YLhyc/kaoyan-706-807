[
  {
    "id": 1,
    "text": "试论汤显祖《牡丹亭》的“至情”理想与浪漫主义戏曲艺术。",
    "start": 0.104,
    "end": 4.706,
    "duration": 4.602
  },
  {
    "id": 2,
    "text": "汤显祖是明代成就最高的戏曲作家，其《牡丹亭》堪称“临川四梦”最具代表性的杰作。",
    "start": 5.597,
    "end": 12.177,
    "duration": 6.58
  },
  {
    "id": 3,
    "text": "面对晚明程朱理学对人性的重重束缚与商业市民思潮的兴起，汤显祖秉持“以情反理”的创作理念，",
    "start": 12.935,
    "end": 21.102,
    "duration": 8.167
  },
  {
    "id": 4,
    "text": "将民间还魂故事改造为一部礼赞青春与自由的浪漫主义传奇。",
    "start": 21.452,
    "end": 26.691,
    "duration": 5.239
  },
  {
    "id": 5,
    "text": "全剧的思想高度与艺术魅力，主要体现在以下四个方面：",
    "start": 27.191,
    "end": 31.652,
    "duration": 4.461
  },
  {
    "id": 6,
    "text": "第一，张扬生死不渝的“至情”理想，直接反拨“存天理、灭人欲”的理学礼教。",
    "start": 32.288,
    "end": 38.817,
    "duration": 6.529
  },
  {
    "id": 7,
    "text": "全剧以“至情”为核心精神支柱。",
    "start": 39.317,
    "end": 41.742,
    "duration": 2.425
  },
  {
    "id": 8,
    "text": "汤显祖在《牡丹亭题词》中写道：",
    "start": 42.399,
    "end": 44.464,
    "duration": 2.065
  },
  {
    "id": 9,
    "text": "“情不知所起，一往而深。生者可以死，死可以生。生而不可与死，死而不可复生者，皆非情之至也。”",
    "start": 45.005,
    "end": 54.211,
    "duration": 9.206
  },
  {
    "id": 10,
    "text": "剧中的杜丽娘本是深闺千金，在《闺塾》读《关雎》初萌春思，继而入园感受良辰美景，",
    "start": 54.711,
    "end": 61.45,
    "duration": 6.739
  },
  {
    "id": 11,
    "text": "在现实压抑中因情入梦、为情而死，又在鬼魂之身中与柳梦梅相依并终得复生。",
    "start": 61.924,
    "end": 69.075,
    "duration": 7.151
  },
  {
    "id": 12,
    "text": "从闺阁乖女到还魂抗争，她一次次跨过贞节关、鬼门关与朝廷金阶，有力肯定了人的自然欲求与个性解放。",
    "start": 69.575,
    "end": 78.703,
    "duration": 9.128
  },
  {
    "id": 13,
    "text": "第二，融汇奇幻梦境与人间世态，构建虚实相生的浪漫主义戏剧冲突。",
    "start": 79.368,
    "end": 85.546,
    "duration": 6.178
  },
  {
    "id": 14,
    "text": "《牡丹亭》打破日常因果写实边界，以天上地下、人鬼幽明交错的奇想推动剧情。",
    "start": 86.046,
    "end": 92.906,
    "duration": 6.86
  },
  {
    "id": 15,
    "text": "汤显祖在《题词》中指出“梦中之情，何必非真”，",
    "start": 93.406,
    "end": 96.913,
    "duration": 3.507
  },
  {
    "id": 16,
    "text": "在《惊梦》《冥判》《魂游》等折以梦境鬼乡寄托“成人不自在”时的无拘自由。",
    "start": 97.263,
    "end": 103.169,
    "duration": 5.906
  },
  {
    "id": 17,
    "text": "但全剧并不浮悬于空幻，还魂复生后的杜丽娘重返现实即受礼法约束，",
    "start": 103.669,
    "end": 109.693,
    "duration": 6.024
  },
  {
    "id": 18,
    "text": "对柳梦梅坦言“前夕鬼也，今日人也。鬼可虚情，人须实礼”。",
    "start": 110.079,
    "end": 115.889,
    "duration": 5.81
  },
  {
    "id": 19,
    "text": "同时，以南安太守杜宝一味做官、死守礼教与陈最良迂腐说教作为对立面，",
    "start": 116.44,
    "end": 123.03,
    "duration": 6.59
  },
  {
    "id": 20,
    "text": "和春香、花神、胡判官形成鲜明正反阵营，使浪漫奇情深植于真实社会矛盾。",
    "start": 123.563,
    "end": 130.583,
    "duration": 7.02
  },
  {
    "id": 21,
    "text": "第三，锤炼诗化典雅曲辞，兼具悲喜交融的复合戏曲风格。",
    "start": 131.238,
    "end": 136.806,
    "duration": 5.568
  },
  {
    "id": 22,
    "text": "汤显祖以深厚诗才写曲，令全剧洋溢浓郁抒情氛围。",
    "start": 137.306,
    "end": 141.991,
    "duration": 4.685
  },
  {
    "id": 23,
    "text": "《惊梦》一折中，【皂罗袍】“原来姹紫嫣红开遍，似这般都付与断井颓垣。良辰美景奈何天，赏心乐事谁家院”一唱三叹，",
    "start": 142.616,
    "end": 153.982,
    "duration": 11.366
  },
  {
    "id": 24,
    "text": "将惜春叹命与向往自由抒发得动人心魄。",
    "start": 154.332,
    "end": 157.768,
    "duration": 3.436
  },
  {
    "id": 25,
    "text": "在结构情调上，全剧将《闹殇》《写真》的惨痛悲情与《闺塾》春香闹学、石道姑诙谐插科打诨融汇调度。",
    "start": 158.295,
    "end": 167.961,
    "duration": 9.666
  },
  {
    "id": 26,
    "text": "王思任评其“笑者真笑，笑即有声；啼者真啼，啼即有泪”，",
    "start": 168.606,
    "end": 173.365,
    "duration": 4.759
  },
  {
    "id": 27,
    "text": "正道出这种悲喜相映的独特艺术魅力。",
    "start": 173.922,
    "end": 176.766,
    "duration": 2.844
  },
  {
    "id": 28,
    "text": "第四，开晚明“临川派”主情先声，影响清代戏曲与小说创作。",
    "start": 177.368,
    "end": 182.475,
    "duration": 5.107
  },
  {
    "id": 29,
    "text": "《牡丹亭》是继《西厢记》之后古代爱情戏曲的又一座高峰。",
    "start": 182.975,
    "end": 187.055,
    "duration": 4.08
  },
  {
    "id": 30,
    "text": "明代沈德符《万历野获编》载：“汤义仍《牡丹亭梦》一出，家传户诵，几令《西厢》减价。”",
    "start": 187.555,
    "end": 194.148,
    "duration": 6.593
  },
  {
    "id": 31,
    "text": "该剧不仅直接引领吴炳、孟称舜等玉茗堂派剧作家的主情创作，更开启清代洪昇《长生殿》深情写史与孔尚任《桃花扇》离合寄兴之风；",
    "start": 194.648,
    "end": 205.065,
    "duration": 10.417
  },
  {
    "id": 32,
    "text": "曹雪芹在《红楼梦》第二十三回写林黛玉听闻“良辰美景”戏文而心动神摇、如痴如醉，亦见其深远沾溉。",
    "start": 205.565,
    "end": 213.624,
    "duration": 8.059
  },
  {
    "id": 33,
    "text": "由是观之，汤显祖在《牡丹亭》中秉持“以情反理”信念，",
    "start": 214.124,
    "end": 218.766,
    "duration": 4.642
  },
  {
    "id": 34,
    "text": "通过杜丽娘因情而死、复因情而生的奇幻结构与典雅诗化曲辞，有力冲破了晚明程朱理学的思想禁锢。",
    "start": 219.116,
    "end": 228.041,
    "duration": 8.925
  },
  {
    "id": 35,
    "text": "全剧将浪漫主义激情与人间世态讽刺融于一炉，",
    "start": 228.541,
    "end": 232.557,
    "duration": 4.016
  },
  {
    "id": 36,
    "text": "既开启晚明“临川派”主情戏剧潮流，又深远滋养了清代《长生殿》《桃花扇》及《红楼梦》的审美精神。",
    "start": 233.031,
    "end": 241.436,
    "duration": 8.405
  }
]
