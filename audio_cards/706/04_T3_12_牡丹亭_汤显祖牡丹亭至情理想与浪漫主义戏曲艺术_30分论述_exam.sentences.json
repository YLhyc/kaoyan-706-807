[
  {
    "id": 1,
    "text": "试论汤显祖《牡丹亭》的“至情”理想与浪漫主义戏曲艺术。",
    "start": 0.104,
    "end": 4.706,
    "duration": 4.602
  },
  {
    "id": 2,
    "text": "汤显祖是明代成就最高的戏曲作家，其《牡丹亭》堪称“临川四梦”最具代表性的杰作。",
    "start": 5.597,
    "end": 12.283,
    "duration": 6.686
  },
  {
    "id": 3,
    "text": "面对晚明程朱理学对人性的重重束缚与商业市民思潮的兴起，",
    "start": 12.935,
    "end": 17.717,
    "duration": 4.782
  },
  {
    "id": 4,
    "text": "汤显祖秉持“以情反理”的创作理念，",
    "start": 18.181,
    "end": 21.102,
    "duration": 2.921
  },
  {
    "id": 5,
    "text": "将民间还魂故事改造为一部礼赞青春与自由的浪漫主义传奇。",
    "start": 21.419,
    "end": 26.658,
    "duration": 5.239
  },
  {
    "id": 6,
    "text": "全剧的思想高度与艺术魅力，主要体现在以下四个方面：",
    "start": 27.1,
    "end": 31.561,
    "duration": 4.461
  },
  {
    "id": 7,
    "text": "第一，张扬生死不渝的“至情”理想，直接反拨“存天理、灭人欲”的理学礼教。",
    "start": 32.197,
    "end": 38.726,
    "duration": 6.529
  },
  {
    "id": 8,
    "text": "全剧以“至情”为核心精神支柱。",
    "start": 39.209,
    "end": 41.634,
    "duration": 2.425
  },
  {
    "id": 9,
    "text": "汤显祖在《牡丹亭题词》中写道：",
    "start": 42.291,
    "end": 44.356,
    "duration": 2.065
  },
  {
    "id": 10,
    "text": "“情不知所起，一往而深。生者可以死，死可以生。生而不可与死，死而不可复生者，皆非情之至也。”",
    "start": 44.897,
    "end": 54.113,
    "duration": 9.216
  },
  {
    "id": 11,
    "text": "剧中的杜丽娘本是深闺千金，在《闺塾》读《关雎》初萌春思，继而入园感受良辰美景，",
    "start": 54.341,
    "end": 61.08,
    "duration": 6.739
  },
  {
    "id": 12,
    "text": "在现实压抑中因情入梦、为情而死，又在鬼魂之身中与柳梦梅相依并终得复生。",
    "start": 61.554,
    "end": 68.705,
    "duration": 7.151
  },
  {
    "id": 13,
    "text": "从闺阁乖女到还魂抗争，她一次次跨过贞节关、鬼门关与朝廷金阶，",
    "start": 69.024,
    "end": 74.975,
    "duration": 5.951
  },
  {
    "id": 14,
    "text": "有力肯定了人的自然欲求与个性解放。",
    "start": 75.243,
    "end": 78.152,
    "duration": 2.909
  },
  {
    "id": 15,
    "text": "第二，融汇奇幻梦境与人间世态，构建虚实相生的浪漫主义戏剧冲突。",
    "start": 78.817,
    "end": 85.007,
    "duration": 6.19
  },
  {
    "id": 16,
    "text": "《牡丹亭》打破日常因果写实边界，以天上地下、人鬼幽明交错的奇想推动剧情。",
    "start": 85.269,
    "end": 92.129,
    "duration": 6.86
  },
  {
    "id": 17,
    "text": "汤显祖在《题词》中指出“梦中之情，何必非真”，",
    "start": 92.463,
    "end": 95.97,
    "duration": 3.507
  },
  {
    "id": 18,
    "text": "在《惊梦》《冥判》《魂游》等折以梦境鬼乡寄托“成人不自在”时的无拘自由。",
    "start": 96.316,
    "end": 102.222,
    "duration": 5.906
  },
  {
    "id": 19,
    "text": "但全剧并不浮悬于空幻，还魂复生后的杜丽娘重返现实即受礼法约束，",
    "start": 102.496,
    "end": 108.52,
    "duration": 6.024
  },
  {
    "id": 20,
    "text": "对柳梦梅坦言“前夕鬼也，今日人也。鬼可虚情，人须实礼”。",
    "start": 108.906,
    "end": 114.716,
    "duration": 5.81
  },
  {
    "id": 21,
    "text": "同时，以南安太守杜宝一味做官、死守礼教与陈最良迂腐说教作为对立面，",
    "start": 115.267,
    "end": 121.857,
    "duration": 6.59
  },
  {
    "id": 22,
    "text": "和春香、花神、胡判官形成鲜明正反阵营，使浪漫奇情深植于真实社会矛盾。",
    "start": 122.39,
    "end": 129.41,
    "duration": 7.02
  },
  {
    "id": 23,
    "text": "第三，锤炼诗化典雅曲辞，兼具悲喜交融的复合戏曲风格。",
    "start": 130.065,
    "end": 135.633,
    "duration": 5.568
  },
  {
    "id": 24,
    "text": "汤显祖以深厚诗才写曲，令全剧洋溢浓郁抒情氛围。",
    "start": 136.072,
    "end": 140.757,
    "duration": 4.685
  },
  {
    "id": 25,
    "text": "《惊梦》一折中，【皂罗袍】“原来姹紫嫣红开遍，似这般都付与断井颓垣。良辰美景奈何天，赏心乐事谁家院”一唱三叹，",
    "start": 141.382,
    "end": 152.748,
    "duration": 11.366
  },
  {
    "id": 26,
    "text": "将惜春叹命与向往自由抒发得动人心魄。",
    "start": 153.015,
    "end": 156.451,
    "duration": 3.436
  },
  {
    "id": 27,
    "text": "在结构情调上，全剧将《闹殇》《写真》的惨痛悲情与《闺塾》春香闹学、石道姑诙谐插科打诨融汇调度。",
    "start": 156.978,
    "end": 166.755,
    "duration": 9.777
  },
  {
    "id": 28,
    "text": "王思任评其“笑者真笑，笑即有声；啼者真啼，啼即有泪”，",
    "start": 167.289,
    "end": 172.18,
    "duration": 4.891
  },
  {
    "id": 29,
    "text": "正道出这种悲喜相映的独特艺术魅力。",
    "start": 172.385,
    "end": 175.449,
    "duration": 3.064
  },
  {
    "id": 30,
    "text": "第四，开晚明“临川派”主情先声，影响清代戏曲与小说创作。",
    "start": 176.051,
    "end": 181.158,
    "duration": 5.107
  },
  {
    "id": 31,
    "text": "《牡丹亭》是继《西厢记》之后古代爱情戏曲的又一座高峰。",
    "start": 181.595,
    "end": 185.675,
    "duration": 4.08
  },
  {
    "id": 32,
    "text": "明代沈德符《万历野获编》载：",
    "start": 186.09,
    "end": 188.102,
    "duration": 2.012
  },
  {
    "id": 33,
    "text": "“汤义仍《牡丹亭梦》一出，家传户诵，几令《西厢》减价。”",
    "start": 188.571,
    "end": 192.693,
    "duration": 4.122
  },
  {
    "id": 34,
    "text": "该剧不仅直接引领吴炳、孟称舜等玉茗堂派剧作家的主情创作，更开启清代洪昇《长生殿》深情写史与孔尚任《桃花扇》离合寄兴之风；",
    "start": 192.937,
    "end": 203.374,
    "duration": 10.437
  },
  {
    "id": 35,
    "text": "曹雪芹在《红楼梦》第二十三回写林黛玉听闻“良辰美景”戏文而心动神摇、如痴如醉，亦见其深远沾溉。",
    "start": 203.769,
    "end": 211.828,
    "duration": 8.059
  },
  {
    "id": 36,
    "text": "由是观之，汤显祖在《牡丹亭》中秉持“以情反理”信念，",
    "start": 212.001,
    "end": 216.908,
    "duration": 4.907
  },
  {
    "id": 37,
    "text": "通过杜丽娘因情而死、复因情而生的奇幻结构与典雅诗化曲辞，",
    "start": 217.235,
    "end": 223.014,
    "duration": 5.779
  },
  {
    "id": 38,
    "text": "有力冲破了晚明程朱理学的思想禁锢。",
    "start": 223.246,
    "end": 226.18,
    "duration": 2.934
  },
  {
    "id": 39,
    "text": "全剧将浪漫主义激情与人间世态讽刺融于一炉，",
    "start": 226.634,
    "end": 230.67,
    "duration": 4.036
  },
  {
    "id": 40,
    "text": "既开启晚明“临川派”主情戏剧潮流，又深远滋养了清代《长生殿》《桃花扇》及《红楼梦》的审美精神。",
    "start": 231.144,
    "end": 239.549,
    "duration": 8.405
  }
]