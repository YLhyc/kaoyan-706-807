[
  {
    "id": 1,
    "text": "试论汤显祖《牡丹亭》的“至情”理想与浪漫主义戏曲艺术。",
    "start": 0.28,
    "end": 4.36,
    "duration": 4.08
  },
  {
    "id": 2,
    "text": "汤显祖是明代成就最高的戏曲作家，其《牡丹亭》堪称“临川四梦”最具代表性的杰作。",
    "start": 4.88,
    "end": 11.28,
    "duration": 6.4
  },
  {
    "id": 3,
    "text": "面对晚明程朱理学对人性的重重束缚与商业市民思潮的兴起，汤显祖秉持“以情反理”的创作理念，",
    "start": 11.8,
    "end": 20.73,
    "duration": 8.93
  },
  {
    "id": 4,
    "text": "将民间还魂故事改造为一部礼赞青春与自由的浪漫主义传奇。",
    "start": 21.1,
    "end": 26.38,
    "duration": 5.28
  },
  {
    "id": 5,
    "text": "全剧的思想高度与艺术魅力，主要体现在以下四个方面：",
    "start": 26.933,
    "end": 31.06,
    "duration": 4.127
  },
  {
    "id": 6,
    "text": "第一，张扬生死不渝的“至情”理想，直接反拨“存天理、灭人欲”的理学礼教。",
    "start": 31.43,
    "end": 37.59,
    "duration": 6.16
  },
  {
    "id": 7,
    "text": "全剧以“至情”为核心精神支柱。",
    "start": 38.11,
    "end": 40.83,
    "duration": 2.72
  },
  {
    "id": 8,
    "text": "汤显祖在《牡丹亭题词》中写道：“情不知所起，一往而深。生者可以死，死可以生。生而不可与死，死而不可复生者，皆非情之至也。”",
    "start": 41.35,
    "end": 54.57,
    "duration": 13.22
  },
  {
    "id": 9,
    "text": "剧中的杜丽娘本是深闺千金，在《闺塾》读《关雎》初萌春思，继而入园感受良辰美景，",
    "start": 55.09,
    "end": 62.41,
    "duration": 7.32
  },
  {
    "id": 10,
    "text": "在现实压抑中因情入梦、为情而死，又在鬼魂之身中与柳梦梅相依并终得复生。",
    "start": 62.78,
    "end": 70.088,
    "duration": 7.308
  },
  {
    "id": 11,
    "text": "从闺阁乖女到还魂抗争，她一次次跨过贞节关、鬼门关与朝廷金阶，有力肯定了人的自然欲求与个性解放。",
    "start": 70.588,
    "end": 79.58,
    "duration": 8.992
  },
  {
    "id": 12,
    "text": "第二，融汇奇幻梦境与人间世态，构建虚实相生的浪漫主义戏剧冲突。",
    "start": 80.1,
    "end": 85.46,
    "duration": 5.36
  },
  {
    "id": 13,
    "text": "《牡丹亭》打破日常因果写实边界，以天上地下、人鬼幽明交错的奇想推动剧情。",
    "start": 85.98,
    "end": 93.02,
    "duration": 7.04
  },
  {
    "id": 14,
    "text": "汤显祖在《题词》中指出“梦中之情，何必非真”，",
    "start": 93.54,
    "end": 97.54,
    "duration": 4.0
  },
  {
    "id": 15,
    "text": "在《惊梦》《冥判》《魂游》等折以梦境鬼乡寄托“成人不自在”时的无拘自由。",
    "start": 97.91,
    "end": 104.55,
    "duration": 6.64
  },
  {
    "id": 16,
    "text": "但全剧并不浮悬于空幻，还魂复生后的杜丽娘重返现实即受礼法约束，",
    "start": 105.07,
    "end": 111.07,
    "duration": 6.0
  },
  {
    "id": 17,
    "text": "对柳梦梅坦言“前夕鬼也，今日人也。鬼可虚情，人须实礼”。",
    "start": 111.44,
    "end": 117.41,
    "duration": 5.97
  },
  {
    "id": 18,
    "text": "同时，以南安太守杜宝一味做官、死守礼教与陈最良迂腐说教作为对立面，",
    "start": 117.93,
    "end": 124.09,
    "duration": 6.16
  },
  {
    "id": 19,
    "text": "和春香、花神、胡判官形成鲜明正反阵营，使浪漫奇情深植于真实社会矛盾。",
    "start": 124.46,
    "end": 131.74,
    "duration": 7.28
  },
  {
    "id": 20,
    "text": "第三，锤炼诗化典雅曲辞，兼具悲喜交融的复合戏曲风格。",
    "start": 132.26,
    "end": 137.62,
    "duration": 5.36
  },
  {
    "id": 21,
    "text": "汤显祖以深厚诗才写曲，令全剧洋溢浓郁抒情氛围。",
    "start": 138.14,
    "end": 142.78,
    "duration": 4.64
  },
  {
    "id": 22,
    "text": "《惊梦》一折中，【皂罗袍】“原来姹紫嫣红开遍，似这般都付与断井颓垣。良辰美景奈何天，赏心乐事谁家院”一唱三叹，",
    "start": 143.3,
    "end": 154.79,
    "duration": 11.49
  },
  {
    "id": 23,
    "text": "将惜春叹命与向往自由抒发得动人心魄。",
    "start": 155.16,
    "end": 158.994,
    "duration": 3.834
  },
  {
    "id": 24,
    "text": "在结构情调上，全剧将《闹殇》《写真》的惨痛悲情与《闺塾》春香闹学、石道姑诙谐插科打诨融汇调度。",
    "start": 159.494,
    "end": 167.84,
    "duration": 8.346
  },
  {
    "id": 25,
    "text": "王思任评其“笑者真笑，笑即有声；啼者真啼，啼即有泪”，",
    "start": 168.36,
    "end": 173.93,
    "duration": 5.57
  },
  {
    "id": 26,
    "text": "正道出这种悲喜相映的独特艺术魅力。",
    "start": 174.3,
    "end": 177.18,
    "duration": 2.88
  },
  {
    "id": 27,
    "text": "第四，开晚明“临川派”主情先声，影响清代戏曲与小说创作。",
    "start": 177.7,
    "end": 182.98,
    "duration": 5.28
  },
  {
    "id": 28,
    "text": "《牡丹亭》是继《西厢记》之后古代爱情戏曲的又一座高峰。",
    "start": 183.5,
    "end": 188.06,
    "duration": 4.56
  },
  {
    "id": 29,
    "text": "明代沈德符《万历野获编》载：“汤义仍《牡丹亭梦》一出，家传户诵，几令《西厢》减价。”",
    "start": 188.58,
    "end": 195.38,
    "duration": 6.8
  },
  {
    "id": 30,
    "text": "该剧不仅直接引领吴炳、孟称舜等玉茗堂派剧作家的主情创作，更开启清代洪昇《长生殿》深情写史与孔尚任《桃花扇》离合寄兴之风；",
    "start": 195.9,
    "end": 207.66,
    "duration": 11.76
  },
  {
    "id": 31,
    "text": "曹雪芹在《红楼梦》第二十三回写林黛玉听闻“良辰美景”戏文而心动神摇、如痴如醉，亦见其深远沾溉。",
    "start": 208.18,
    "end": 216.18,
    "duration": 8.0
  },
  {
    "id": 32,
    "text": "由是观之，汤显祖在《牡丹亭》中秉持“以情反理”信念，",
    "start": 216.7,
    "end": 221.42,
    "duration": 4.72
  },
  {
    "id": 33,
    "text": "通过杜丽娘因情而死、复因情而生的奇幻结构与典雅诗化曲辞，有力冲破了晚明程朱理学的思想禁锢。",
    "start": 221.79,
    "end": 230.83,
    "duration": 9.04
  },
  {
    "id": 34,
    "text": "全剧将浪漫主义激情与人间世态讽刺融于一炉，",
    "start": 231.35,
    "end": 235.27,
    "duration": 3.92
  },
  {
    "id": 35,
    "text": "既开启晚明“临川派”主情戏剧潮流，又深远滋养了清代《长生殿》《桃花扇》及《红楼梦》的审美精神。",
    "start": 235.64,
    "end": 243.48,
    "duration": 7.84
  }
]
