[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《聊斋志异》·花妖狐魅形象塑造与社会批判",
    "start": 0.134,
    "end": 3.906,
    "duration": 3.772
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "写妖反衬人→讽科举抒孤愤→鞭贪虐伸正义→志怪传奇合璧：",
    "start": 4.411,
    "end": 13.383,
    "duration": 8.972
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先看蒲松龄如何把吃人妖怪改造成婴宁黄英般真纯理想化身，",
    "start": 13.691,
    "end": 19.863,
    "duration": 6.172
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "转头把积愤投向八股试官与阳间冥府黑暗，最后用鲁迅“用传奇法，而以志怪”概括其文言巅峰技。",
    "start": 20.011,
    "end": 29.143,
    "duration": 9.132
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《聊斋志异》是文言短篇小说巅峰。",
    "start": 29.552,
    "end": 32.524,
    "duration": 2.972
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "蒲松龄寄孤愤于狐鬼世界，鲁迅评其“用传奇法，而以志怪”，郭沫若赞“写鬼写妖高人一等，刺贪刺虐入骨三分”。",
    "start": 32.642,
    "end": 43.454,
    "duration": 10.812
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 塑造真纯美好花妖狐魅反衬冷酷",
    "start": 44.162,
    "end": 48.174,
    "duration": 4.012
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "扭转传统志怪妖异害人套路，既保物性特征又赋真挚纯善人性人情；",
    "start": 48.687,
    "end": 55.979,
    "duration": 7.292
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《婴宁》天真憨直笑对虚伪礼法；",
    "start": 56.507,
    "end": 60.279,
    "duration": 3.772
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《黄英》种菊致富破士大夫清高迂腐；",
    "start": 60.557,
    "end": 64.169,
    "duration": 3.612
  },
  {
    "id": "sec0_step1_c2",
    "dom_key": "sec0_step1_c2",
    "text": "《阿绣》感于痴情成人之美，以异类反衬人间势利。",
    "start": 64.207,
    "end": 69.019,
    "duration": 4.812
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 辛辣讽刺八股科举弊端、抒士人苦闷",
    "start": 69.522,
    "end": 73.534,
    "duration": 4.012
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《司文郎》盲僧鼻嗅辨文，怒斥考官“仆虽盲于目，而不盲于鼻，今帘中人并鼻盲矣”；",
    "start": 74.055,
    "end": 83.187,
    "duration": 9.132
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《王子安》摹落魄秀才醉中连捷幻觉，讽逐名利丑态亦寓怀才不遇自伤。",
    "start": 83.69,
    "end": 91.862,
    "duration": 8.172
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 无情鞭挞贪官恶霸、替民伸张正义",
    "start": 92.454,
    "end": 96.546,
    "duration": 4.092
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《促织》借微虫致百姓倾家，末冷讽“一人飞升，仙及鸡犬”直刺帝王官僚；",
    "start": 96.987,
    "end": 106.119,
    "duration": 9.132
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《席方平》写城隍、郡司、冥王各级衙门贪赃酷虐尤胜阳间，锋芒犀利。",
    "start": 106.636,
    "end": 113.928,
    "duration": 7.292
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 兼融志怪传奇之长、创诗意简练叙事",
    "start": 114.542,
    "end": 119.274,
    "duration": 4.732
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "跳出六朝粗陈梗概，融先秦两汉典雅文言与山东方言俗语，文约事丰、因人庄谐；",
    "start": 119.802,
    "end": 129.014,
    "duration": 9.212
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "善写环境动作心理，引入诗词意象与“偶见鹘突，知复非人”含蓄笔法，令幻境幽婚富有诗意回味。",
    "start": 129.542,
    "end": 140.194,
    "duration": 10.652
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "蒲松龄在《聊斋志异》中以理想异类反衬世态炎凉，尖锐刺击科举与贪政，",
    "start": 140.836,
    "end": 146.928,
    "duration": 6.092
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "“用传奇法，而以志怪”融简练文言与诗意于一体，成文言短篇集大成之作。",
    "start": 147.236,
    "end": 154.448,
    "duration": 7.212
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅《中国小说史略》评“用传奇法，而以志怪”；郭沫若赞“写鬼写妖高人一等，刺贪刺虐入骨三分”。",
    "start": 155.057,
    "end": 165.519,
    "duration": 10.462
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 鲁迅与郭沫若对《聊斋》分别有何经典评语？",
    "start": 166.216,
    "end": 170.788,
    "duration": 4.572
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 从《婴宁》《黄英》《司文郎》《促织》《席方平》各提炼核心讽喻点？",
    "start": 171.217,
    "end": 177.789,
    "duration": 6.572
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 解释什么是“用传奇法，而以志怪”及“偶见鹘突，知复非人”笔法？",
    "start": 178.317,
    "end": 185.769,
    "duration": 7.452
  }
]