[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "写妖反衬人→讽科举抒孤愤→鞭贪虐伸正义→志怪传奇合璧：",
    "start": 0.0,
    "end": 6.44,
    "duration": 6.44
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先看蒲松龄如何把吃人妖怪改造成婴宁黄英般真纯理想化身，",
    "start": 6.489,
    "end": 11.729,
    "duration": 5.24
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "转头把积愤投向八股试官与阳间冥府黑暗，最后用鲁迅“用传奇法，",
    "start": 12.179,
    "end": 17.379,
    "duration": 5.2
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "而以志怪”概括其文言巅峰技。",
    "start": 17.829,
    "end": 20.309,
    "duration": 2.48
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《聊斋志异》是文言短篇小说巅峰。",
    "start": 20.759,
    "end": 23.439,
    "duration": 2.68
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "蒲松龄寄孤愤于狐鬼世界，鲁迅评其“用传奇法，而以志怪”，",
    "start": 23.889,
    "end": 28.769,
    "duration": 4.88
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "郭沫若赞“写鬼写妖高人一等，刺贪刺虐入骨三分”。",
    "start": 29.219,
    "end": 33.819,
    "duration": 4.6
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 塑造真纯美好花妖狐魅反衬冷酷",
    "start": 34.269,
    "end": 38.149,
    "duration": 3.88
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "扭转传统志怪妖异害人套路，既保物性特征又赋真挚纯善人性人情；",
    "start": 38.599,
    "end": 44.599,
    "duration": 6.0
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《婴宁》天真憨直笑对虚伪礼法；",
    "start": 45.049,
    "end": 47.689,
    "duration": 2.64
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《黄英》种菊致富破士大夫清高迂腐；",
    "start": 48.139,
    "end": 50.699,
    "duration": 2.56
  },
  {
    "id": "sec0_step1_c2",
    "dom_key": "sec0_step1_c2",
    "text": "《阿绣》感于痴情成人之美，以异类反衬人间势利。",
    "start": 51.149,
    "end": 55.229,
    "duration": 4.08
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 辛辣讽刺八股科举弊端、抒士人苦闷",
    "start": 55.679,
    "end": 60.079,
    "duration": 4.4
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《司文郎》盲僧鼻嗅辨文，怒斥考官“仆虽盲于目，而不盲于鼻，",
    "start": 60.529,
    "end": 65.849,
    "duration": 5.32
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "今帘中人并鼻盲矣”；",
    "start": 66.299,
    "end": 68.259,
    "duration": 1.96
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《王子安》摹落魄秀才醉中连捷幻觉，讽逐名利丑态亦寓怀才不遇自伤。",
    "start": 68.709,
    "end": 74.469,
    "duration": 5.76
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 无情鞭挞贪官恶霸、替民伸张正义",
    "start": 74.919,
    "end": 78.919,
    "duration": 4.0
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《促织》借微虫致百姓倾家，末冷讽“一人飞升，仙及鸡犬”直刺帝王官僚；",
    "start": 79.369,
    "end": 85.049,
    "duration": 5.68
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《席方平》写城隍、郡司、冥王各级衙门贪赃酷虐尤胜阳间，锋芒犀利。",
    "start": 85.499,
    "end": 90.899,
    "duration": 5.4
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 兼融志怪传奇之长、创诗意简练叙事",
    "start": 91.429,
    "end": 95.389,
    "duration": 3.96
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "跳出六朝粗陈梗概，融先秦两汉典雅文言与山东方言俗语，",
    "start": 95.839,
    "end": 101.039,
    "duration": 5.2
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "文约事丰、因人庄谐；",
    "start": 101.569,
    "end": 103.369,
    "duration": 1.8
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "善写环境动作心理，引入诗词意象与“偶见鹘突，知复非人”含蓄笔法，",
    "start": 103.819,
    "end": 109.499,
    "duration": 5.68
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "令幻境幽婚富有诗意回味。",
    "start": 109.949,
    "end": 112.309,
    "duration": 2.36
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "蒲松龄在《聊斋志异》中以理想异类反衬世态炎凉，尖锐刺击科举与贪政，",
    "start": 112.759,
    "end": 118.599,
    "duration": 5.84
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "“用传奇法，而以志怪”融简练文言与诗意于一体，成文言短篇集大成之作。",
    "start": 119.049,
    "end": 125.449,
    "duration": 6.4
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅《中国小说史略》评“用传奇法，而以志怪”；",
    "start": 125.899,
    "end": 130.299,
    "duration": 4.4
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "郭沫若赞“写鬼写妖高人一等，刺贪刺虐入骨三分”。",
    "start": 130.749,
    "end": 135.349,
    "duration": 4.6
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 鲁迅与郭沫若对《聊斋》分别有何经典评语？",
    "start": 135.799,
    "end": 140.919,
    "duration": 5.12
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 从《婴宁》《黄英》《司文郎》《促织》《席方平》各提炼核心讽喻点？",
    "start": 141.369,
    "end": 147.929,
    "duration": 6.56
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 解释什么是“用传奇法，而以志怪”及“偶见鹘突，知复非人”笔法？",
    "start": 148.379,
    "end": 155.099,
    "duration": 6.72
  }
]