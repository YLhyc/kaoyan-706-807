[
  {
    "id": 1,
    "text": "简述初唐四杰的文学史贡献及其对律诗体式的奠基作用。",
    "start": 0.112,
    "end": 4.755,
    "duration": 4.643
  },
  {
    "id": 2,
    "text": "初唐四杰（王勃、杨炯、卢照邻、",
    "start": 5.054,
    "end": 8.087,
    "duration": 3.033
  },
  {
    "id": 3,
    "text": "骆宾王）是唐高宗至武后时期诗风革新的先驱，",
    "start": 8.306,
    "end": 12.431,
    "duration": 4.125
  },
  {
    "id": 4,
    "text": "标志着唐诗摆脱六朝绮靡余习、走向盛唐气象的关键转折。",
    "start": 12.597,
    "end": 17.821,
    "duration": 5.224
  },
  {
    "id": 5,
    "text": "四杰的文学史贡献与律诗奠基作用，主要体现在以下三个方面：",
    "start": 18.073,
    "end": 22.887,
    "duration": 4.814
  },
  {
    "id": 6,
    "text": "第一，扫除齐梁宫体浮艳旧习，拓展诗歌题材并重振刚健骨气。",
    "start": 23.516,
    "end": 28.747,
    "duration": 5.231
  },
  {
    "id": 7,
    "text": "四杰针对上官体“争构纤微、骨气都尽”的宫廷流弊，",
    "start": 29.049,
    "end": 33.181,
    "duration": 4.132
  },
  {
    "id": 8,
    "text": "提出反对纤巧绮靡、提倡刚健骨气的诗学主张。",
    "start": 33.462,
    "end": 37.352,
    "duration": 3.89
  },
  {
    "id": 9,
    "text": "他们将诗歌题材从狭小的宫廷应制与闺阁吟咏，",
    "start": 37.653,
    "end": 41.474,
    "duration": 3.821
  },
  {
    "id": 10,
    "text": "拓展至市井都邑、边塞军旅、羁旅送别与身世感怀。",
    "start": 41.676,
    "end": 45.811,
    "duration": 4.135
  },
  {
    "id": 11,
    "text": "如杨炯《从军行》以“宁为百夫长，",
    "start": 46.089,
    "end": 48.926,
    "duration": 2.837
  },
  {
    "id": 12,
    "text": "胜作一书生”抒发投笔从戎的昂扬志气；",
    "start": 49.033,
    "end": 52.385,
    "duration": 3.352
  },
  {
    "id": 13,
    "text": "卢照邻《长安古意》与骆宾王《帝京篇》以七言歌行铺写帝京兴衰，",
    "start": 52.568,
    "end": 57.807,
    "duration": 5.239
  },
  {
    "id": 14,
    "text": "夹叙夹议，为初唐诗歌注入了壮大的气势与真挚的悲慨。",
    "start": 58.004,
    "end": 62.423,
    "duration": 4.419
  },
  {
    "id": 15,
    "text": "第二，推动五言律诗趋于定型，推进排律与对仗声律规范。",
    "start": 63.01,
    "end": 67.805,
    "duration": 4.795
  },
  {
    "id": 16,
    "text": "四杰特别是王勃、杨炯，",
    "start": 68.367,
    "end": 70.267,
    "duration": 1.9
  },
  {
    "id": 17,
    "text": "在五言律诗声律与对仗的成熟过程中发挥了重要奠基作用。",
    "start": 70.575,
    "end": 75.148,
    "duration": 4.573
  },
  {
    "id": 18,
    "text": "杨炯现存五律已完全合于近体黏式律，",
    "start": 75.811,
    "end": 78.974,
    "duration": 3.163
  },
  {
    "id": 19,
    "text": "逐步摆脱了齐梁永明体繁琐的病犯束缚与失黏现象。",
    "start": 79.348,
    "end": 83.539,
    "duration": 4.191
  },
  {
    "id": 20,
    "text": "王勃《送杜少府之任蜀州》声律谐畅、对仗工稳，",
    "start": 83.81,
    "end": 87.991,
    "duration": 4.181
  },
  {
    "id": 21,
    "text": "“海内存知己，",
    "start": 88.302,
    "end": 89.316,
    "duration": 1.014
  },
  {
    "id": 22,
    "text": "天涯若比邻”更以开阔高朗的境界洗净了传统送别诗的悲酸儿女态，",
    "start": 89.49,
    "end": 94.659,
    "duration": 5.169
  },
  {
    "id": 23,
    "text": "成为初唐五律名篇；同时四杰还大力创作五言长律，",
    "start": 94.788,
    "end": 98.847,
    "duration": 4.059
  },
  {
    "id": 24,
    "text": "丰富了近体诗的篇制容量。",
    "start": 99.051,
    "end": 100.87,
    "duration": 1.819
  },
  {
    "id": 25,
    "text": "第三，转变诗人身份立场，推动诗歌从宫廷台阁走向寒士抒怀。",
    "start": 101.539,
    "end": 107.801,
    "duration": 6.262
  },
  {
    "id": 26,
    "text": "四杰才高位卑、沉沦下僚，却怀抱功名理想与不甘平庸的自负。",
    "start": 108.295,
    "end": 114.028,
    "duration": 5.733
  },
  {
    "id": 27,
    "text": "他们打破了齐梁以来文人依附宫廷权贵的应制旧习，",
    "start": 114.518,
    "end": 118.884,
    "duration": 4.366
  },
  {
    "id": 28,
    "text": "在诗中直抒寒士不平之鸣与建功立业之志。",
    "start": 119.227,
    "end": 123.541,
    "duration": 4.314
  },
  {
    "id": 29,
    "text": "诚如闻一多在《唐诗杂论》中所指出，",
    "start": 123.781,
    "end": 126.284,
    "duration": 2.503
  },
  {
    "id": 30,
    "text": "四杰使诗境从宫廷台阁走向江山与塞漠，",
    "start": 126.832,
    "end": 130.641,
    "duration": 3.809
  },
  {
    "id": 31,
    "text": "从根本上扭转了贞观以来的台阁风气，与陈子昂、",
    "start": 130.832,
    "end": 134.934,
    "duration": 4.102
  },
  {
    "id": 32,
    "text": "沈宋等人一道，为开元盛唐诗坛的全面繁荣铺平了道路。",
    "start": 135.013,
    "end": 139.683,
    "duration": 4.67
  }
]