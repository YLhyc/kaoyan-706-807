[
  {
    "id": 1,
    "text": "简述初唐四杰的文学史贡献及其对律诗体式的奠基作用。",
    "start": 0.08,
    "end": 5.44,
    "duration": 5.36
  },
  {
    "id": 2,
    "text": "初唐四杰（王勃、杨炯、卢照邻、",
    "start": 5.44,
    "end": 9.44,
    "duration": 4.0
  },
  {
    "id": 3,
    "text": "骆宾王）是初唐高宗至武后年间诗歌革新的先驱群体，",
    "start": 9.44,
    "end": 14.4,
    "duration": 4.96
  },
  {
    "id": 4,
    "text": "标志着唐诗从六朝绮靡余风走向盛唐昂扬气象的关键转折。",
    "start": 14.4,
    "end": 20.0,
    "duration": 5.6
  },
  {
    "id": 5,
    "text": "四杰在诗坛上的突破性贡献及其对律诗体式的奠基，",
    "start": 20.0,
    "end": 24.32,
    "duration": 4.32
  },
  {
    "id": 6,
    "text": "主要展现为以下三个核心维度：",
    "start": 24.32,
    "end": 27.44,
    "duration": 3.12
  },
  {
    "id": 7,
    "text": "第一，破除齐梁宫体浮靡旧习，拓展诗歌题材题材与骨气力量。",
    "start": 27.44,
    "end": 33.787,
    "duration": 6.347
  },
  {
    "id": 8,
    "text": "四杰在文学观念与创作实践上，",
    "start": 33.787,
    "end": 36.96,
    "duration": 3.173
  },
  {
    "id": 9,
    "text": "自觉向齐梁以来的梁陈宫体诗风发起冲击。",
    "start": 36.96,
    "end": 41.267,
    "duration": 4.307
  },
  {
    "id": 10,
    "text": "他们反对轻浮虚泛的声色描摹，",
    "start": 41.267,
    "end": 44.44,
    "duration": 3.173
  },
  {
    "id": 11,
    "text": "将诗歌题材从狭小的宫廷台阁与闺房情爱，",
    "start": 44.44,
    "end": 48.747,
    "duration": 4.307
  },
  {
    "id": 12,
    "text": "大幅拓展至广袤壮阔的边塞关山、羁旅离别与身世政治感怀。",
    "start": 48.747,
    "end": 55.2,
    "duration": 6.453
  },
  {
    "id": 13,
    "text": "如杨炯 《从军行》 中 “宁为百夫长，胜作一书生”，",
    "start": 55.2,
    "end": 60.48,
    "duration": 5.28
  },
  {
    "id": 14,
    "text": "展现出投笔从戎、建功立业的昂扬意气；",
    "start": 60.48,
    "end": 64.4,
    "duration": 3.92
  },
  {
    "id": 15,
    "text": "卢照邻 《长安古意》 与骆宾王 《帝京篇》 则开创了宏大繁复的都邑长篇歌行体，",
    "start": 64.4,
    "end": 72.24,
    "duration": 7.84
  },
  {
    "id": 16,
    "text": "熔叙事、抒情与哲理反思于一炉，",
    "start": 72.24,
    "end": 75.84,
    "duration": 3.6
  },
  {
    "id": 17,
    "text": "赋予了唐诗刚健充沛的骨气与昂扬博大的时代气魄。",
    "start": 76.08,
    "end": 81.6,
    "duration": 5.52
  },
  {
    "id": 18,
    "text": "第二，推动五言律诗成熟定型，奠定排律与对仗规范之形式基石。",
    "start": 81.6,
    "end": 87.92,
    "duration": 6.32
  },
  {
    "id": 19,
    "text": "四杰是近体五言律诗体式成熟的决定性奠基者。",
    "start": 87.92,
    "end": 92.56,
    "duration": 4.64
  },
  {
    "id": 20,
    "text": "四杰在五律的声律、粘对、押韵与对仗技巧上进行了严整探索，",
    "start": 92.56,
    "end": 98.96,
    "duration": 6.4
  },
  {
    "id": 21,
    "text": "使律诗彻底摆脱了齐梁永明体音律不谐、结构松散的过渡状态。",
    "start": 98.96,
    "end": 106.88,
    "duration": 7.92
  },
  {
    "id": 22,
    "text": "王勃的 《送杜少府之任蜀州》 全篇声律和美、气韵流转，",
    "start": 106.88,
    "end": 112.96,
    "duration": 6.08
  },
  {
    "id": 23,
    "text": "首联 “城阙辅三秦，风烟望五津” 对仗天衣无缝，",
    "start": 112.96,
    "end": 118.0,
    "duration": 5.04
  },
  {
    "id": 24,
    "text": "颈联 “海内存知己，天涯若比邻” 境界超迈雄浑，",
    "start": 118.0,
    "end": 122.48,
    "duration": 4.48
  },
  {
    "id": 25,
    "text": "成为初唐五言律诗成熟的典范之作；",
    "start": 122.8,
    "end": 126.24,
    "duration": 3.44
  },
  {
    "id": 26,
    "text": "同时四杰大力创制长篇排律，",
    "start": 126.24,
    "end": 129.12,
    "duration": 2.88
  },
  {
    "id": 27,
    "text": "拓展了律诗的篇幅规制与艺术容量。",
    "start": 129.52,
    "end": 132.88,
    "duration": 3.36
  },
  {
    "id": 28,
    "text": "第三，提升士人独立人格地位，",
    "start": 132.88,
    "end": 135.44,
    "duration": 2.56
  },
  {
    "id": 29,
    "text": "实现作家身份从宫廷帮闲向独立文人的跃迁。",
    "start": 135.44,
    "end": 139.92,
    "duration": 4.48
  },
  {
    "id": 30,
    "text": "四杰身处下僚，仕途坎坷，却怀抱自负与抗争精神。",
    "start": 139.92,
    "end": 144.48,
    "duration": 4.56
  },
  {
    "id": 31,
    "text": "他们彻底终结了六朝以来文人依附于权贵宫廷的帮闲地位，",
    "start": 144.48,
    "end": 150.24,
    "duration": 5.76
  },
  {
    "id": 32,
    "text": "在诗歌中直抒寒士不平之鸣，",
    "start": 150.24,
    "end": 153.04,
    "duration": 2.8
  },
  {
    "id": 33,
    "text": "赋予诗歌以强烈的个体主体性与独立人格力量。",
    "start": 153.04,
    "end": 154.24,
    "duration": 1.2
  },
  {
    "id": 34,
    "text": "闻一多在 《唐诗杂论》 中高度评价四杰，",
    "start": 154.08,
    "end": 154.24,
    "duration": 0.16
  },
  {
    "id": 35,
    "text": "指出他们将诗歌从宫廷引入市井旷野，",
    "start": 154.08,
    "end": 154.24,
    "duration": 0.16
  },
  {
    "id": 36,
    "text": "以鲜活生命力为盛唐气象的到来拉开了壮丽序幕。",
    "start": 154.08,
    "end": 154.24,
    "duration": 0.16
  }
]