[
  {
    "id": 1,
    "text": "简述初唐四杰的文学史贡献及其对律诗体式的奠基作用。",
    "start": 0.097,
    "end": 4.614,
    "duration": 4.517
  },
  {
    "id": 2,
    "text": "初唐四杰（王勃、杨炯、卢照邻、",
    "start": 5.245,
    "end": 7.96,
    "duration": 2.715
  },
  {
    "id": 3,
    "text": "骆宾王）是初唐高宗至武后年间诗歌革新的先驱群体，",
    "start": 8.064,
    "end": 12.626,
    "duration": 4.562
  },
  {
    "id": 4,
    "text": "标志着唐诗从六朝绮靡余风走向盛唐昂扬气象的关键转折。",
    "start": 13.124,
    "end": 18.644,
    "duration": 5.52
  },
  {
    "id": 5,
    "text": "四杰在诗坛上的突破性贡献及其对律诗体式的奠基，",
    "start": 18.705,
    "end": 22.598,
    "duration": 3.893
  },
  {
    "id": 6,
    "text": "主要展现为以下三个核心维度：",
    "start": 22.815,
    "end": 24.952,
    "duration": 2.137
  },
  {
    "id": 7,
    "text": "第一，破除齐梁宫体浮靡旧习，拓展诗歌题材题材与骨气力量。",
    "start": 25.138,
    "end": 30.453,
    "duration": 5.315
  },
  {
    "id": 8,
    "text": "四杰在文学观念与创作实践上，",
    "start": 30.927,
    "end": 33.5,
    "duration": 2.573
  },
  {
    "id": 9,
    "text": "自觉向齐梁以来的梁陈宫体诗风发起冲击。",
    "start": 33.778,
    "end": 37.457,
    "duration": 3.679
  },
  {
    "id": 10,
    "text": "他们反对轻浮虚泛的声色描摹，",
    "start": 38.0,
    "end": 40.711,
    "duration": 2.711
  },
  {
    "id": 11,
    "text": "将诗歌题材从狭小的宫廷台阁与闺房情爱，",
    "start": 40.766,
    "end": 44.562,
    "duration": 3.796
  },
  {
    "id": 12,
    "text": "大幅拓展至广袤壮阔的边塞关山、羁旅离别与身世政治感怀。",
    "start": 44.885,
    "end": 50.425,
    "duration": 5.54
  },
  {
    "id": 13,
    "text": "如杨炯 《从军行》 中 “宁为百夫长，胜作一书生”，",
    "start": 50.666,
    "end": 54.711,
    "duration": 4.045
  },
  {
    "id": 14,
    "text": "展现出投笔从戎、建功立业的昂扬意气；",
    "start": 54.929,
    "end": 58.349,
    "duration": 3.42
  },
  {
    "id": 15,
    "text": "卢照邻 《长安古意》 与骆宾王 《帝京篇》 则开创了宏大繁复的都邑长篇歌行体，",
    "start": 58.773,
    "end": 65.329,
    "duration": 6.556
  },
  {
    "id": 16,
    "text": "熔叙事、抒情与哲理反思于一炉，",
    "start": 65.362,
    "end": 68.4,
    "duration": 3.038
  },
  {
    "id": 17,
    "text": "赋予了唐诗刚健充沛的骨气与昂扬博大的时代气魄。",
    "start": 68.446,
    "end": 72.846,
    "duration": 4.4
  },
  {
    "id": 18,
    "text": "第二，推动五言律诗成熟定型，奠定排律与对仗规范之形式基石。",
    "start": 73.059,
    "end": 79.275,
    "duration": 6.216
  },
  {
    "id": 19,
    "text": "四杰是近体五言律诗体式成熟的决定性奠基者。",
    "start": 79.898,
    "end": 83.689,
    "duration": 3.791
  },
  {
    "id": 20,
    "text": "四杰在五律的声律、粘对、押韵与对仗技巧上进行了严整探索，",
    "start": 83.982,
    "end": 89.961,
    "duration": 5.979
  },
  {
    "id": 21,
    "text": "使律诗彻底摆脱了齐梁永明体音律不谐、结构松散的过渡状态。",
    "start": 90.038,
    "end": 95.498,
    "duration": 5.46
  },
  {
    "id": 22,
    "text": "王勃的 《送杜少府之任蜀州》 全篇声律和美、气韵流转，",
    "start": 95.7,
    "end": 100.688,
    "duration": 4.988
  },
  {
    "id": 23,
    "text": "首联 “城阙辅三秦，风烟望五津” 对仗天衣无缝，",
    "start": 101.225,
    "end": 105.81,
    "duration": 4.585
  },
  {
    "id": 24,
    "text": "颈联 “海内存知己，天涯若比邻” 境界超迈雄浑，",
    "start": 106.056,
    "end": 110.84,
    "duration": 4.784
  },
  {
    "id": 25,
    "text": "成为初唐五言律诗成熟的典范之作；",
    "start": 110.894,
    "end": 113.838,
    "duration": 2.944
  },
  {
    "id": 26,
    "text": "同时四杰大力创制长篇排律，",
    "start": 114.427,
    "end": 117.085,
    "duration": 2.658
  },
  {
    "id": 27,
    "text": "拓展了律诗的篇幅规制与艺术容量。",
    "start": 117.142,
    "end": 119.923,
    "duration": 2.781
  },
  {
    "id": 28,
    "text": "第三，提升士人独立人格地位，",
    "start": 120.101,
    "end": 122.5,
    "duration": 2.399
  },
  {
    "id": 29,
    "text": "实现作家身份从宫廷帮闲向独立文人的跃迁。",
    "start": 122.826,
    "end": 126.84,
    "duration": 4.014
  },
  {
    "id": 30,
    "text": "四杰身处下僚，仕途坎坷，却怀抱自负与抗争精神。",
    "start": 127.083,
    "end": 131.565,
    "duration": 4.482
  },
  {
    "id": 31,
    "text": "他们彻底终结了六朝以来文人依附于权贵宫廷的帮闲地位，",
    "start": 131.964,
    "end": 136.589,
    "duration": 4.625
  },
  {
    "id": 32,
    "text": "在诗歌中直抒寒士不平之鸣，",
    "start": 136.663,
    "end": 139.119,
    "duration": 2.456
  },
  {
    "id": 33,
    "text": "赋予诗歌以强烈的个体主体性与独立人格力量。",
    "start": 139.495,
    "end": 143.149,
    "duration": 3.654
  },
  {
    "id": 34,
    "text": "闻一多在 《唐诗杂论》 中高度评价四杰，",
    "start": 143.379,
    "end": 146.462,
    "duration": 3.083
  },
  {
    "id": 35,
    "text": "指出他们将诗歌从宫廷引入市井旷野，",
    "start": 146.588,
    "end": 150.124,
    "duration": 3.536
  },
  {
    "id": 36,
    "text": "以鲜活生命力为盛唐气象的到来拉开了壮丽序幕。",
    "start": 150.159,
    "end": 154.464,
    "duration": 4.305
  }
]
