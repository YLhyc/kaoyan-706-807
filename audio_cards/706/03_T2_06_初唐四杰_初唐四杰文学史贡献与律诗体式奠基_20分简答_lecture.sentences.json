[
  {
    "id": 1,
    "text": "简述初唐四杰的文学史贡献及其对律诗体式的奠基作用。",
    "start": 0.05,
    "end": 5.255,
    "duration": 5.205
  },
  {
    "id": 2,
    "text": "初唐四杰（王勃、杨炯、卢照邻、",
    "start": 5.255,
    "end": 8.077,
    "duration": 2.822
  },
  {
    "id": 3,
    "text": "骆宾王）是初唐高宗至武后年间诗歌革新的先驱群体，",
    "start": 8.077,
    "end": 13.144,
    "duration": 5.067
  },
  {
    "id": 4,
    "text": "标志着唐诗从六朝绮靡余风走向盛唐昂扬气象的关键转折。",
    "start": 13.144,
    "end": 18.727,
    "duration": 5.583
  },
  {
    "id": 5,
    "text": "四杰在诗坛上的突破性贡献及其对律诗体式的奠基，",
    "start": 18.727,
    "end": 22.83,
    "duration": 4.103
  },
  {
    "id": 6,
    "text": "主要展现为以下三个核心维度：",
    "start": 22.83,
    "end": 25.8,
    "duration": 2.97
  },
  {
    "id": 7,
    "text": "第一，破除齐梁宫体浮靡旧习，拓展诗歌题材题材与骨气力量。",
    "start": 25.8,
    "end": 30.947,
    "duration": 5.147
  },
  {
    "id": 8,
    "text": "四杰在文学观念与创作实践上，",
    "start": 30.947,
    "end": 33.788,
    "duration": 2.841
  },
  {
    "id": 9,
    "text": "自觉向齐梁以来的梁陈宫体诗风发起冲击。",
    "start": 33.788,
    "end": 38.01,
    "duration": 4.222
  },
  {
    "id": 10,
    "text": "他们反对轻浮虚泛的声色描摹，",
    "start": 38.01,
    "end": 40.778,
    "duration": 2.768
  },
  {
    "id": 11,
    "text": "将诗歌题材从狭小的宫廷台阁与闺房情爱，",
    "start": 40.778,
    "end": 44.895,
    "duration": 4.117
  },
  {
    "id": 12,
    "text": "大幅拓展至广袤壮阔的边塞关山、羁旅离别与身世政治感怀。",
    "start": 44.895,
    "end": 52.51,
    "duration": 7.615
  },
  {
    "id": 13,
    "text": "如杨炯 《从军行》 中 “宁为百夫长，胜作一书生”，",
    "start": 52.51,
    "end": 56.601,
    "duration": 4.091
  },
  {
    "id": 14,
    "text": "展现出投笔从戎、建功立业的昂扬意气；",
    "start": 56.601,
    "end": 59.51,
    "duration": 2.909
  },
  {
    "id": 15,
    "text": "卢照邻 《长安古意》 与骆宾王 《帝京篇》 则开创了宏大繁复的都邑长篇歌行体，",
    "start": 59.51,
    "end": 65.379,
    "duration": 5.869
  },
  {
    "id": 16,
    "text": "熔叙事、抒情与哲理反思于一炉，",
    "start": 65.379,
    "end": 68.485,
    "duration": 3.106
  },
  {
    "id": 17,
    "text": "赋予了唐诗刚健充沛的骨气与昂扬博大的时代气魄。",
    "start": 68.485,
    "end": 73.753,
    "duration": 5.268
  },
  {
    "id": 18,
    "text": "第二，推动五言律诗成熟定型，奠定排律与对仗规范之形式基石。",
    "start": 73.753,
    "end": 79.913,
    "duration": 6.16
  },
  {
    "id": 19,
    "text": "四杰是近体五言律诗体式成熟的决定性奠基者。",
    "start": 79.913,
    "end": 84.158,
    "duration": 4.245
  },
  {
    "id": 20,
    "text": "四杰在五律的声律、粘对、押韵与对仗技巧上进行了严整探索，",
    "start": 84.158,
    "end": 90.052,
    "duration": 5.894
  },
  {
    "id": 21,
    "text": "使律诗彻底摆脱了齐梁永明体音律不谐、结构松散的过渡状态。",
    "start": 90.052,
    "end": 95.711,
    "duration": 5.659
  },
  {
    "id": 22,
    "text": "王勃的 《送杜少府之任蜀州》 全篇声律和美、气韵流转，",
    "start": 95.711,
    "end": 99.752,
    "duration": 4.041
  },
  {
    "id": 23,
    "text": "首联 “城阙辅三秦，风烟望五津” 对仗天衣无缝，",
    "start": 99.752,
    "end": 104.685,
    "duration": 4.933
  },
  {
    "id": 24,
    "text": "颈联 “海内存知己，天涯若比邻” 境界超迈雄浑，",
    "start": 104.685,
    "end": 109.07,
    "duration": 4.385
  },
  {
    "id": 25,
    "text": "成为初唐五言律诗成熟的典范之作；",
    "start": 109.07,
    "end": 111.797,
    "duration": 2.727
  },
  {
    "id": 26,
    "text": "同时四杰大力创制长篇排律，",
    "start": 111.797,
    "end": 114.438,
    "duration": 2.641
  },
  {
    "id": 27,
    "text": "拓展了律诗的篇幅规制与艺术容量。",
    "start": 114.438,
    "end": 119.053,
    "duration": 4.615
  },
  {
    "id": 28,
    "text": "第三，提升士人独立人格地位，",
    "start": 119.053,
    "end": 121.235,
    "duration": 2.182
  },
  {
    "id": 29,
    "text": "实现作家身份从宫廷帮闲向独立文人的跃迁。",
    "start": 121.235,
    "end": 125.32,
    "duration": 4.085
  },
  {
    "id": 30,
    "text": "四杰身处下僚，仕途坎坷，却怀抱自负与抗争精神。",
    "start": 125.32,
    "end": 129.532,
    "duration": 4.212
  },
  {
    "id": 31,
    "text": "他们彻底终结了六朝以来文人依附于权贵宫廷的帮闲地位，",
    "start": 129.532,
    "end": 136.68,
    "duration": 7.148
  },
  {
    "id": 32,
    "text": "在诗歌中直抒寒士不平之鸣，",
    "start": 136.68,
    "end": 139.512,
    "duration": 2.832
  },
  {
    "id": 33,
    "text": "赋予诗歌以强烈的个体主体性与独立人格力量。",
    "start": 139.512,
    "end": 143.39,
    "duration": 3.878
  },
  {
    "id": 34,
    "text": "闻一多在 《唐诗杂论》 中高度评价四杰，",
    "start": 143.39,
    "end": 146.598,
    "duration": 3.208
  },
  {
    "id": 35,
    "text": "指出他们将诗歌从宫廷引入市井旷野，",
    "start": 146.598,
    "end": 150.169,
    "duration": 3.571
  },
  {
    "id": 36,
    "text": "以鲜活生命力为盛唐气象的到来拉开了壮丽序幕。",
    "start": 150.169,
    "end": 154.464,
    "duration": 4.295
  }
]