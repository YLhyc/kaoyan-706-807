[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣“破浮艳→立律法→转视角”三步短平快推演：",
    "start": 0.0,
    "end": 5.32,
    "duration": 5.32
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先批上官体扩题材为塞漠歌行，再由王杨把五言律诗音律黏对定型，",
    "start": 5.369,
    "end": 11.489,
    "duration": 6.12
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后按闻一多定评收束到寒士走出宫廷台阁的时代意义。",
    "start": 11.939,
    "end": 16.539,
    "duration": 4.6
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "初唐四杰（王勃、杨炯、卢照邻、骆宾王）是唐高宗至武后时期革新先驱，",
    "start": 16.989,
    "end": 23.389,
    "duration": 6.4
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "标志唐诗摆脱六朝绮靡、走向盛唐气象的关键转折。",
    "start": 23.839,
    "end": 28.439,
    "duration": 4.6
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 扫除齐梁宫体、重振刚健骨气",
    "start": 28.969,
    "end": 32.529,
    "duration": 3.56
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "反上官体“争构纤微、骨气都尽”，倡刚健骨气；",
    "start": 32.979,
    "end": 37.099,
    "duration": 4.12
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "扩题材至市井、边塞、羁旅；",
    "start": 37.629,
    "end": 40.189,
    "duration": 2.56
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "杨炯《从军行》“宁为百夫长，胜作一书生”；",
    "start": 40.639,
    "end": 44.079,
    "duration": 3.44
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "卢照邻《长安古意》、骆宾王《帝京篇》铺写帝京兴衰，注入壮大悲慨。",
    "start": 44.609,
    "end": 49.929,
    "duration": 5.32
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 推动五言律诗定型、丰富排律篇制",
    "start": 50.459,
    "end": 54.139,
    "duration": 3.68
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "杨炯五律已合近体黏式律，摆脱永明体失黏繁琐；",
    "start": 54.589,
    "end": 58.629,
    "duration": 4.04
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "兼写五言长律丰富篇制；",
    "start": 59.079,
    "end": 61.239,
    "duration": 2.16
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "王勃《送杜少府之任蜀州》声律谐畅对仗工稳，“海内存知己，",
    "start": 61.769,
    "end": 66.889,
    "duration": 5.12
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "天涯若比邻”洗净悲酸儿女态。",
    "start": 67.339,
    "end": 69.819,
    "duration": 2.48
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 从宫廷台阁走向江山塞漠寒士抒怀",
    "start": 70.269,
    "end": 74.429,
    "duration": 4.16
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "才高位卑却怀抱建功自负，打破依附权贵应制旧习，直抒寒士不平与抱负；",
    "start": 74.879,
    "end": 81.399,
    "duration": 6.52
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "如闻一多《唐诗杂论》所论“从宫廷台阁走向江山与塞漠”，",
    "start": 81.849,
    "end": 86.129,
    "duration": 4.28
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "与陈子昂、沈宋同为盛唐铺路。",
    "start": 86.579,
    "end": 89.299,
    "duration": 2.72
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：初唐四杰指王勃、杨炯、卢照邻、骆宾王；",
    "start": 89.749,
    "end": 94.029,
    "duration": 4.28
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "闻一多《唐诗杂论》赞四杰使诗境“从宫廷台阁走向江山与塞漠”。",
    "start": 94.479,
    "end": 99.599,
    "duration": 5.12
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出初唐四杰全名、各自代表名篇及《送杜少府》声律价值？",
    "start": 100.049,
    "end": 106.529,
    "duration": 6.48
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 四杰是怎样摆脱永明体束缚确立五言律诗定型的？",
    "start": 107.059,
    "end": 112.699,
    "duration": 5.64
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 解释闻一多《唐诗杂论》“从宫廷台阁走向江山与塞漠”的深层含义？",
    "start": 113.149,
    "end": 119.749,
    "duration": 6.6
  }
]