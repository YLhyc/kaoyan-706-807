[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "初唐四杰·文学史贡献与律诗体式奠基",
    "start": 0.134,
    "end": 3.701,
    "duration": 3.567
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣“破浮艳→立律法→转视角”三步短平快推演：先批上官体扩题材为塞漠歌行，",
    "start": 4.29,
    "end": 11.984,
    "duration": 7.694
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再由王杨把五言律诗音律黏对定型，最后按闻一多定评收束到寒士走出宫廷台阁的时代意义。",
    "start": 12.298,
    "end": 19.897,
    "duration": 7.599
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "初唐四杰（王勃、杨炯、卢照邻、骆宾王）是唐高宗至武后时期革新先驱，",
    "start": 20.483,
    "end": 27.488,
    "duration": 7.004
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "标志唐诗摆脱六朝绮靡、走向盛唐气象的关键转折。",
    "start": 27.775,
    "end": 32.41,
    "duration": 4.634
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 扫除齐梁宫体、重振刚健骨气",
    "start": 32.996,
    "end": 36.667,
    "duration": 3.671
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "反上官体“争构纤微、骨气都尽”，倡刚健骨气；扩题材至市井、边塞、羁旅；",
    "start": 37.241,
    "end": 45.509,
    "duration": 8.267
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "杨炯《从军行》“宁为百夫长，胜作一书生”；",
    "start": 46.082,
    "end": 50.522,
    "duration": 4.439
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "卢照邻《长安古意》、骆宾王《帝京篇》铺写帝京兴衰，注入壮大悲慨。",
    "start": 50.679,
    "end": 56.472,
    "duration": 5.793
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 推动五言律诗定型、丰富排律篇制",
    "start": 57.059,
    "end": 60.665,
    "duration": 3.606
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "杨炯五律已合近体黏式律，摆脱永明体失黏繁琐；兼写五言长律丰富篇制；",
    "start": 61.252,
    "end": 68.751,
    "duration": 7.499
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "王勃《送杜少府之任蜀州》声律谐畅对仗工稳，“海内存知己，天涯若比邻”洗净悲酸儿女态。",
    "start": 69.325,
    "end": 78.1,
    "duration": 8.775
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 从宫廷台阁走向江山塞漠寒士抒怀",
    "start": 78.687,
    "end": 82.995,
    "duration": 4.309
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "才高位卑却怀抱建功自负，打破依附权贵应制旧习，直抒寒士不平与抱负；",
    "start": 83.582,
    "end": 91.42,
    "duration": 7.838
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "如闻一多《唐诗杂论》所论“从宫廷台阁走向江山与塞漠”，与陈子昂、沈宋同为盛唐铺路。",
    "start": 92.007,
    "end": 100.404,
    "duration": 8.397
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：初唐四杰指王勃、杨炯、卢照邻、骆宾王；闻一多《唐诗杂论》赞四杰使诗境“从宫廷台阁走向江山与塞漠”。",
    "start": 100.991,
    "end": 112.07,
    "duration": 11.08
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出初唐四杰全名、各自代表名篇及《送杜少府》声律价值？",
    "start": 112.658,
    "end": 119.428,
    "duration": 6.77
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 四杰是怎样摆脱永明体束缚确立五言律诗定型的？",
    "start": 120.015,
    "end": 125.717,
    "duration": 5.702
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 解释闻一多《唐诗杂论》“从宫廷台阁走向江山与塞漠”的深层含义？",
    "start": 126.291,
    "end": 133.373,
    "duration": 7.082
  }
]