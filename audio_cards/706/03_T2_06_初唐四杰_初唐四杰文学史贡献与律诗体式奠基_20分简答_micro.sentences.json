[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "初唐四杰·文学史贡献与律诗体式奠基",
    "start": 0.154,
    "end": 3.766,
    "duration": 3.612
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣“破浮艳→立律法→转视角”三步短平快推演：先批上官体扩题材为塞漠歌行，",
    "start": 4.468,
    "end": 13.44,
    "duration": 8.972
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再由王杨把五言律诗音律黏对定型，最后按闻一多定评收束到寒士走出宫廷台阁的时代意义。",
    "start": 13.748,
    "end": 22.56,
    "duration": 8.812
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "初唐四杰（王勃、杨炯、卢照邻、骆宾王）是唐高宗至武后时期革新先驱，",
    "start": 23.045,
    "end": 29.537,
    "duration": 6.492
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "标志唐诗摆脱六朝绮靡、走向盛唐气象的关键转折。",
    "start": 29.925,
    "end": 34.257,
    "duration": 4.332
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 扫除齐梁宫体、重振刚健骨气",
    "start": 34.894,
    "end": 38.266,
    "duration": 3.372
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "反上官体“争构纤微、骨气都尽”，倡刚健骨气；扩题材至市井、边塞、羁旅；",
    "start": 38.782,
    "end": 47.404,
    "duration": 8.622
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "杨炯《从军行》“宁为百夫长，胜作一书生”；",
    "start": 47.884,
    "end": 53.176,
    "duration": 5.292
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "卢照邻《长安古意》、骆宾王《帝京篇》铺写帝京兴衰，注入壮大悲慨。",
    "start": 53.454,
    "end": 59.546,
    "duration": 6.092
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 推动五言律诗定型、丰富排律篇制",
    "start": 60.223,
    "end": 63.915,
    "duration": 3.692
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "杨炯五律已合近体黏式律，摆脱永明体失黏繁琐；兼写五言长律丰富篇制；",
    "start": 64.377,
    "end": 73.319,
    "duration": 8.942
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "王勃《送杜少府之任蜀州》声律谐畅对仗工稳，“海内存知己，天涯若比邻”洗净悲酸儿女态。",
    "start": 73.713,
    "end": 84.045,
    "duration": 10.332
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 从宫廷台阁走向江山塞漠寒士抒怀",
    "start": 84.696,
    "end": 89.748,
    "duration": 5.052
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "才高位卑却怀抱建功自负，打破依附权贵应制旧习，直抒寒士不平与抱负；",
    "start": 90.276,
    "end": 98.208,
    "duration": 7.932
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "如闻一多《唐诗杂论》所论“从宫廷台阁走向江山与塞漠”，与陈子昂、沈宋同为盛唐铺路。",
    "start": 98.736,
    "end": 108.108,
    "duration": 9.372
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：初唐四杰指王勃、杨炯、卢照邻、骆宾王；闻一多《唐诗杂论》赞四杰使诗境“从宫廷台阁走向江山与塞漠”。",
    "start": 108.757,
    "end": 120.499,
    "duration": 11.742
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出初唐四杰全名、各自代表名篇及《送杜少府》声律价值？",
    "start": 121.182,
    "end": 127.274,
    "duration": 6.092
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 四杰是怎样摆脱永明体束缚确立五言律诗定型的？",
    "start": 127.802,
    "end": 133.094,
    "duration": 5.292
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 解释闻一多《唐诗杂论》“从宫廷台阁走向江山与塞漠”的深层含义？",
    "start": 133.622,
    "end": 140.114,
    "duration": 6.492
  }
]