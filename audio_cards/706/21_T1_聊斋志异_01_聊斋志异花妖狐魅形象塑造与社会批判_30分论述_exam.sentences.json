[
  {
    "id": 1,
    "text": "题型，三十分论述题。",
    "start": 0.08,
    "end": 1.919,
    "duration": 1.839
  },
  {
    "id": 2,
    "text": "分值，三十分。",
    "start": 1.919,
    "end": 3.06,
    "duration": 1.141
  },
  {
    "id": 3,
    "text": "建议考场时间，三十五分钟。",
    "start": 3.06,
    "end": 5.572,
    "duration": 2.512
  },
  {
    "id": 4,
    "text": "目标字数，一千一百五十到一千三百字。",
    "start": 5.572,
    "end": 9.226,
    "duration": 3.654
  },
  {
    "id": 5,
    "text": "答题骨架，文言巅峰定性、趋近于、",
    "start": 9.226,
    "end": 12.195,
    "duration": 2.969
  },
  {
    "id": 6,
    "text": "花妖狐魅人性化与理想人格建构、趋近于“刺贪刺虐”对吏治与科举之深沉批判、",
    "start": 12.195,
    "end": 19.503,
    "duration": 7.308
  },
  {
    "id": 7,
    "text": "趋近于、虚实相生叙事与精雅文言笔法、",
    "start": 19.503,
    "end": 23.156,
    "duration": 3.653
  },
  {
    "id": 8,
    "text": "趋近于、宏观文学史总结。",
    "start": 23.156,
    "end": 25.44,
    "duration": 2.284
  },
  {
    "id": 9,
    "text": "清代蒲松龄所著《聊斋志异》是中国文言文短篇小说的集大成巅峰之作。",
    "start": 25.6,
    "end": 31.68,
    "duration": 6.08
  },
  {
    "id": 10,
    "text": "鲁迅在《中国小说史略》中精辟概括其“用传奇法，",
    "start": 31.68,
    "end": 36.0,
    "duration": 4.32
  },
  {
    "id": 11,
    "text": "而以志怪”，指出其虽写幽冥异类，",
    "start": 36.0,
    "end": 39.04,
    "duration": 3.04
  },
  {
    "id": 12,
    "text": "实则深刻观照现实人世。",
    "start": 39.04,
    "end": 41.28,
    "duration": 2.24
  },
  {
    "id": 13,
    "text": "全书借幻设的狐鬼花妖世界，寄托作者坎坷孤愤之怀，",
    "start": 41.28,
    "end": 46.0,
    "duration": 4.72
  },
  {
    "id": 14,
    "text": "在浪漫瑰丽的形象塑造与尖锐深刻的社会批判中熔铸出独具特色的艺术光彩。",
    "start": 46.0,
    "end": 52.32,
    "duration": 6.32
  },
  {
    "id": 15,
    "text": "第一，在形象塑造艺术上，作品将传统志怪中可怖怪诞的异类精魅全面人性化，",
    "start": 52.56,
    "end": 59.68,
    "duration": 7.12
  },
  {
    "id": 16,
    "text": "塑造出一批寄托理想美德与纯真人性的花妖狐魅形象。",
    "start": 59.68,
    "end": 64.88,
    "duration": 5.2
  },
  {
    "id": 17,
    "text": "纪晓兰曾评聊斋“才子之笔，非著书者之笔”，",
    "start": 64.88,
    "end": 68.88,
    "duration": 4.0
  },
  {
    "id": 18,
    "text": "其核心正在于蒲松龄赋予狐鬼以超越世俗凡人的人情美与生命力。",
    "start": 68.88,
    "end": 74.64,
    "duration": 5.76
  },
  {
    "id": 19,
    "text": "在爱情题材中，这些女性精魅不慕虚荣，",
    "start": 74.96,
    "end": 78.56,
    "duration": 3.6
  },
  {
    "id": 20,
    "text": "不计门第，主动热烈追求真挚爱情。",
    "start": 78.56,
    "end": 81.6,
    "duration": 3.04
  },
  {
    "id": 21,
    "text": "比如《婴宁》中的狐女婴宁，天真烂漫，",
    "start": 81.6,
    "end": 84.64,
    "duration": 3.04
  },
  {
    "id": 22,
    "text": "嗜笑如痴，在草木掩映的自然天地中保留了毫无机巧污浊的赤子之心，",
    "start": 84.64,
    "end": 90.56,
    "duration": 5.92
  },
  {
    "id": 23,
    "text": "成为人性自然与淳朴的化身。",
    "start": 90.56,
    "end": 92.88,
    "duration": 2.32
  },
  {
    "id": 24,
    "text": "又如《小翠》中的狐仙小翠，面对官场倾轧机智挥谐，",
    "start": 92.88,
    "end": 97.28,
    "duration": 4.4
  },
  {
    "id": 25,
    "text": "以游戏人间的姿态巧妙惩治权奸并报答恩德。",
    "start": 97.28,
    "end": 101.44,
    "duration": 4.16
  },
  {
    "id": 26,
    "text": "这些精灵形象情真意切，其高洁无私的品质与人世间虚伪冷酷的伦理道德形成鲜明反差，",
    "start": 101.68,
    "end": 109.68,
    "duration": 8.0
  },
  {
    "id": 27,
    "text": "寄寓着作者对自由天性与美好人际关系的深情向往。",
    "start": 109.68,
    "end": 113.68,
    "duration": 4.0
  },
  {
    "id": 28,
    "text": "第二，在思想精神上，作品展现出强烈的现实介入品格，",
    "start": 113.984,
    "end": 118.464,
    "duration": 4.48
  },
  {
    "id": 29,
    "text": "以“刺贪刺虐，入骨三分”的批判锋芒深刻揭露了封建社会的政治黑暗与科举腐朽。",
    "start": 118.464,
    "end": 125.184,
    "duration": 6.72
  },
  {
    "id": 30,
    "text": "蒲松龄一生屡制科场，对底层疾苦与体制罪恶具有痛彻骨髓的体察。",
    "start": 125.184,
    "end": 130.944,
    "duration": 5.76
  },
  {
    "id": 31,
    "text": "在揭露暴政与吏治黑暗方面，《促织》堪称经典名篇。",
    "start": 130.944,
    "end": 134.784,
    "duration": 3.84
  },
  {
    "id": 32,
    "text": "作品通过成名一家因一只蟋蟀而家破人亡的悲惨遭遇，",
    "start": 135.104,
    "end": 139.984,
    "duration": 4.88
  },
  {
    "id": 33,
    "text": "以小见大，深刻剖析了“天子一跬步，",
    "start": 139.984,
    "end": 143.344,
    "duration": 3.36
  },
  {
    "id": 34,
    "text": "皆关民命”的残酷现实，将批判矛头直指荒淫享乐的最高统治集团。",
    "start": 143.344,
    "end": 149.104,
    "duration": 5.76
  },
  {
    "id": 35,
    "text": "在《席方平》中，作者更是描绘了一个冥界地狱从城隍、",
    "start": 149.104,
    "end": 153.504,
    "duration": 4.4
  },
  {
    "id": 36,
    "text": "郡司直至阎罗皆上下通贿、屈打良善的黑暗罗网，",
    "start": 153.504,
    "end": 158.224,
    "duration": 4.72
  },
  {
    "id": 37,
    "text": "发出“金光盖地，因使阎罗稽首”的沉痛控诉。",
    "start": 158.224,
    "end": 162.544,
    "duration": 4.32
  },
  {
    "id": 38,
    "text": "在批判科举制度方面，《司文郎》中借盲僧用鼻子闻出文章优劣、",
    "start": 162.784,
    "end": 168.224,
    "duration": 5.44
  },
  {
    "id": 39,
    "text": "盲僧叹息“文字盲者方可中选”的荒诞寓言，",
    "start": 168.224,
    "end": 172.064,
    "duration": 3.84
  },
  {
    "id": 40,
    "text": "以及《贾奉雉》中贾生游戏作荒谬低劣之文却高中解元的反讽，",
    "start": 172.064,
    "end": 177.824,
    "duration": 5.76
  },
  {
    "id": 41,
    "text": "对是非颠倒、扼杀真才的八股取士制度进行了淋漓尽致的解剖。",
    "start": 177.824,
    "end": 183.344,
    "duration": 5.52
  },
  {
    "id": 42,
    "text": "第三，在叙事机制与语言美学上，作品实现了“以虚写实、",
    "start": 183.584,
    "end": 188.944,
    "duration": 5.36
  },
  {
    "id": 43,
    "text": "幻由人生”的艺术造境，达到了文言小说语言精炼雅洁的最高境界。",
    "start": 188.944,
    "end": 194.944,
    "duration": 6.0
  },
  {
    "id": 44,
    "text": "《聊斋志异》极善于打破人界与冥界、",
    "start": 194.944,
    "end": 198.224,
    "duration": 3.28
  },
  {
    "id": 45,
    "text": "现实与虚幻的时空壁障，情节离奇曲折却始终符合世情常理。",
    "start": 198.224,
    "end": 204.144,
    "duration": 5.92
  },
  {
    "id": 46,
    "text": "比如在《梦狼》中，白翁入梦见其为官之子官署内白骨如山、",
    "start": 204.304,
    "end": 209.184,
    "duration": 4.88
  },
  {
    "id": 47,
    "text": "巨狼噬人，将贪官之凶残贪婪转化为视觉震撼力极强的荒诞意象，",
    "start": 209.184,
    "end": 214.864,
    "duration": 5.68
  },
  {
    "id": 48,
    "text": "达到了寓意深刻的象征效果。",
    "start": 214.864,
    "end": 216.784,
    "duration": 1.92
  },
  {
    "id": 49,
    "text": "在语言形式上，蒲松龄融铸先秦两汉散文的苍劲骨力、",
    "start": 216.784,
    "end": 221.504,
    "duration": 4.72
  },
  {
    "id": 50,
    "text": "六朝骈力的藻饰之美与唐宋传奇的流利丰神，",
    "start": 221.504,
    "end": 225.264,
    "duration": 3.76
  },
  {
    "id": 51,
    "text": "更创造性地吸收方言俗语之生动活力，",
    "start": 225.264,
    "end": 228.384,
    "duration": 3.12
  },
  {
    "id": 52,
    "text": "使叙事绘声绘色，写人神情毕现，文笔熔裁精妙。",
    "start": 228.384,
    "end": 232.384,
    "duration": 4.0
  },
  {
    "id": 53,
    "text": "综上所述，蒲松龄《聊斋志异》借鬼狐以照现实，",
    "start": 232.624,
    "end": 236.944,
    "duration": 4.32
  },
  {
    "id": 54,
    "text": "以幽冥异境寄托孤愤与理想，以犀利笔锋解剖世态罪恶。",
    "start": 236.944,
    "end": 241.984,
    "duration": 5.04
  },
  {
    "id": 55,
    "text": "它在人性开掘的深度、社会批判的广度与文言艺术的高度上，",
    "start": 241.984,
    "end": 246.704,
    "duration": 4.72
  },
  {
    "id": 56,
    "text": "皆达到了中国文言短篇小说前所未有的峰孪，",
    "start": 246.704,
    "end": 250.544,
    "duration": 3.84
  },
  {
    "id": 57,
    "text": "成为中国文学宝库中历久弥新的光辉经典。",
    "start": 250.544,
    "end": 253.984,
    "duration": 3.44
  }
]