[
  {
    "id": 1,
    "text": "试论“建安风骨”的美学内涵与“三曹”诗歌艺术。",
    "start": 0.16,
    "end": 5.36,
    "duration": 5.2
  },
  {
    "id": 2,
    "text": "汉末魏初是中国文学走向自觉的关键转折时期。",
    "start": 5.36,
    "end": 9.68,
    "duration": 4.32
  },
  {
    "id": 3,
    "text": "面对黄巾起义爆发、",
    "start": 9.68,
    "end": 11.6,
    "duration": 1.92
  },
  {
    "id": 4,
    "text": "军阀割据混战与瘟疫流行造成的社会剧烈动荡，",
    "start": 11.6,
    "end": 15.76,
    "duration": 4.16
  },
  {
    "id": 5,
    "text": "建安文人一方面深感生命苦短与朝不保夕的严峻生存现实，",
    "start": 15.76,
    "end": 21.12,
    "duration": 5.36
  },
  {
    "id": 6,
    "text": "另一方面又怀抱平定天下、建功立业的强烈时代责任感。",
    "start": 21.12,
    "end": 26.08,
    "duration": 4.96
  },
  {
    "id": 7,
    "text": "这种在时代阵痛中迸发出的昂扬志气与深沉忧患，",
    "start": 26.08,
    "end": 30.56,
    "duration": 4.48
  },
  {
    "id": 8,
    "text": "造就了中国诗歌史上极具生命力的 “建安风骨”。",
    "start": 30.56,
    "end": 35.12,
    "duration": 4.56
  },
  {
    "id": 9,
    "text": "鲁迅称这一时期为 “文学的自觉时代”；",
    "start": 35.44,
    "end": 39.52,
    "duration": 4.08
  },
  {
    "id": 10,
    "text": "刘勰在 《文心雕龙·时序》 中赞其 “志深而笔长，",
    "start": 39.52,
    "end": 44.08,
    "duration": 4.56
  },
  {
    "id": 11,
    "text": "故慷慨而多气也”。",
    "start": 44.08,
    "end": 45.76,
    "duration": 1.68
  },
  {
    "id": 12,
    "text": "其美学内涵与三曹诗歌艺术，主要展现为以下四个核心维度：",
    "start": 46.0,
    "end": 52.32,
    "duration": 6.32
  },
  {
    "id": 13,
    "text": "第一，标举“慷慨悲凉”与“爽朗刚健”的美学内涵，",
    "start": 52.32,
    "end": 58.0,
    "duration": 5.68
  },
  {
    "id": 14,
    "text": "确立情志与文辞的高度统一。",
    "start": 58.0,
    "end": 60.72,
    "duration": 2.72
  },
  {
    "id": 15,
    "text": "从美学范畴而言，“建安风骨” 是“风”与“骨”的有机融合。",
    "start": 60.72,
    "end": 66.64,
    "duration": 5.92
  },
  {
    "id": 16,
    "text": "所谓 “风”，指诗歌充沛真挚、",
    "start": 66.64,
    "end": 69.84,
    "duration": 3.2
  },
  {
    "id": 17,
    "text": "感人至深的思想感情与精神力量；所谓 “骨”，",
    "start": 69.84,
    "end": 74.88,
    "duration": 5.04
  },
  {
    "id": 18,
    "text": "指表达这种感情的事理逻辑与刚健挺拔的文辞骨力。",
    "start": 74.88,
    "end": 79.84,
    "duration": 4.96
  },
  {
    "id": 19,
    "text": "曹丕在 《典论·论文》 中提出 “文以气为主，",
    "start": 79.84,
    "end": 84.24,
    "duration": 4.4
  },
  {
    "id": 20,
    "text": "气之清浊有体，不可力强而致”，",
    "start": 84.24,
    "end": 87.36,
    "duration": 3.12
  },
  {
    "id": 21,
    "text": "强调作家的内在生命气质与才情格调。",
    "start": 87.36,
    "end": 90.72,
    "duration": 3.36
  },
  {
    "id": 22,
    "text": "建安诗人摆脱了两汉经学教条的死板束缚，直抒胸臆、",
    "start": 90.72,
    "end": 96.16,
    "duration": 5.44
  },
  {
    "id": 23,
    "text": "缘情而发，使诗歌既具备悲天悯人的现实忧患，",
    "start": 96.16,
    "end": 100.864,
    "duration": 4.704
  },
  {
    "id": 24,
    "text": "又充满蓬勃刚健的进取精神，形成了悲壮而不消沉、",
    "start": 101.104,
    "end": 106.704,
    "duration": 5.6
  },
  {
    "id": 25,
    "text": "刚健而不浅薄的独特风貌。",
    "start": 106.704,
    "end": 109.424,
    "duration": 2.72
  },
  {
    "id": 26,
    "text": "第二，以“三曹”为核心展现多元艺术风貌，",
    "start": 109.424,
    "end": 113.824,
    "duration": 4.4
  },
  {
    "id": 27,
    "text": "推动五言古诗全面走向成熟。",
    "start": 113.984,
    "end": 117.264,
    "duration": 3.28
  },
  {
    "id": 28,
    "text": "建安诗坛以曹操、曹丕、曹植父子为核心领袖，",
    "start": 117.264,
    "end": 122.704,
    "duration": 5.44
  },
  {
    "id": 29,
    "text": "形成了同中有异的创作格局。",
    "start": 122.704,
    "end": 125.744,
    "duration": 3.04
  },
  {
    "id": 30,
    "text": "曹操诗歌风格 “古直悲凉”，善用旧题乐府反映汉末现实，",
    "start": 125.744,
    "end": 130.064,
    "duration": 4.32
  },
  {
    "id": 31,
    "text": "在 《蒿里行》 中以沉痛笔触写出 “白骨露于野，",
    "start": 130.064,
    "end": 134.704,
    "duration": 4.64
  },
  {
    "id": 32,
    "text": "千里无鸡鸣”，在 《短歌行》 中写下 “对酒当歌，",
    "start": 134.704,
    "end": 140.144,
    "duration": 5.44
  },
  {
    "id": 33,
    "text": "人生几何”，气象雄浑、气吞山河；",
    "start": 140.144,
    "end": 143.664,
    "duration": 3.52
  },
  {
    "id": 34,
    "text": "曹丕诗歌风格 “便娟婉约”，",
    "start": 143.664,
    "end": 146.544,
    "duration": 2.88
  },
  {
    "id": 35,
    "text": "其 《燕歌行》 是中国文学史上现存最早成熟的文人七言诗，",
    "start": 146.544,
    "end": 152.624,
    "duration": 6.08
  },
  {
    "id": 36,
    "text": "情致深婉流丽；曹植则代表了建安诗歌的最高成就，",
    "start": 152.624,
    "end": 157.424,
    "duration": 4.8
  },
  {
    "id": 37,
    "text": "其诗 “骨气奇高，词采华茂”，",
    "start": 157.744,
    "end": 160.144,
    "duration": 2.4
  },
  {
    "id": 38,
    "text": "前期 《白马篇》 塑造英勇报国的游侠少年，",
    "start": 160.384,
    "end": 164.384,
    "duration": 4.0
  },
  {
    "id": 39,
    "text": "后期 《赠白马王彪》 展现身遭猜忌的抑郁悲愤，",
    "start": 164.384,
    "end": 168.704,
    "duration": 4.32
  },
  {
    "id": 40,
    "text": "将深沉的情志与华美的藻饰完美结合。",
    "start": 168.704,
    "end": 171.984,
    "duration": 3.28
  },
  {
    "id": 41,
    "text": "第三，贯穿深沉的生命忧患与建功立业抱负，",
    "start": 171.984,
    "end": 176.064,
    "duration": 4.08
  },
  {
    "id": 42,
    "text": "实现个体自觉与社会担当的统一。",
    "start": 176.064,
    "end": 179.504,
    "duration": 3.44
  },
  {
    "id": 43,
    "text": "建安诗歌最震撼人心的思想力量，",
    "start": 179.504,
    "end": 183.744,
    "duration": 4.24
  },
  {
    "id": 44,
    "text": "在于其在深刻体认生命短暂的同时，",
    "start": 183.744,
    "end": 187.744,
    "duration": 4.0
  },
  {
    "id": 45,
    "text": "展现出对永恒价值的主动追寻。",
    "start": 187.744,
    "end": 190.544,
    "duration": 2.8
  },
  {
    "id": 46,
    "text": "乱世中的动荡离乱使文人普遍产生强烈的生死无常之感，",
    "start": 190.544,
    "end": 195.184,
    "duration": 4.64
  },
  {
    "id": 47,
    "text": "但他们并未陷入道家消极避世的虚无泥淖，",
    "start": 195.184,
    "end": 199.184,
    "duration": 4.0
  },
  {
    "id": 48,
    "text": "而是选择以建功立业、著书立说对抗死亡。",
    "start": 199.184,
    "end": 203.344,
    "duration": 4.16
  },
  {
    "id": 49,
    "text": "曹丕明确提出 “年寿有时而尽，",
    "start": 203.344,
    "end": 206.144,
    "duration": 2.8
  },
  {
    "id": 50,
    "text": "荣乐止乎其身……未若文章之无穷”；",
    "start": 206.144,
    "end": 209.424,
    "duration": 3.28
  },
  {
    "id": 51,
    "text": "曹植发出 “捐躯赴国难，视死忽如归” 的慷慨誓言。",
    "start": 209.424,
    "end": 214.464,
    "duration": 5.04
  },
  {
    "id": 52,
    "text": "这种在悲凉中激荡着英雄气概的精神品质，",
    "start": 214.464,
    "end": 218.704,
    "duration": 4.24
  },
  {
    "id": 53,
    "text": "赋予了建安文学超越时代的崇高审美价值。",
    "start": 218.704,
    "end": 222.704,
    "duration": 4.0
  },
  {
    "id": 54,
    "text": "第四，树立中国古典诗歌的刚健风范，",
    "start": 222.784,
    "end": 226.704,
    "duration": 3.92
  },
  {
    "id": 55,
    "text": "成为后代反抗靡丽文风的美学旗帜。",
    "start": 226.704,
    "end": 230.064,
    "duration": 3.36
  },
  {
    "id": 56,
    "text": "建安风骨以其刚健明朗的骨力与充沛的真情，",
    "start": 230.064,
    "end": 233.904,
    "duration": 3.84
  },
  {
    "id": 57,
    "text": "成为后世历代诗歌革新运动的精神渊薮。",
    "start": 233.744,
    "end": 233.904,
    "duration": 0.16
  },
  {
    "id": 58,
    "text": "南朝齐梁时期诗歌走向形式主义与声色浮艳，",
    "start": 233.744,
    "end": 233.904,
    "duration": 0.16
  },
  {
    "id": 59,
    "text": "初唐陈子昂在 《修竹篇序》 中大声疾呼 “汉魏风骨，",
    "start": 233.744,
    "end": 233.904,
    "duration": 0.16
  },
  {
    "id": 60,
    "text": "晋宋莫传”，借建安风骨扫除齐梁余习；",
    "start": 233.744,
    "end": 233.904,
    "duration": 0.16
  },
  {
    "id": 61,
    "text": "李白亦在 《古风》 中高唱 “蓬莱文章建安骨”。",
    "start": 233.744,
    "end": 233.904,
    "duration": 0.16
  },
  {
    "id": 62,
    "text": "建安风骨所确立的真情实感、刚健骨力与时代担当，",
    "start": 233.744,
    "end": 233.904,
    "duration": 0.16
  },
  {
    "id": 63,
    "text": "成为中国古典诗歌优良传统中不可磨灭的精神灯塔。",
    "start": 233.744,
    "end": 233.904,
    "duration": 0.16
  }
]