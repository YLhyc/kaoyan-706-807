[
  {
    "id": "sent_1",
    "text": "汉末魏初是中国文学走向自觉的关键转折时期。",
    "start": 0.1,
    "end": 4.92,
    "duration": 4.82
  },
  {
    "id": "sent_2",
    "text": "面对黄巾起义爆发、军阀割据混战与瘟疫流行造成的社会剧烈动荡，",
    "start": 4.87,
    "end": 11.38,
    "duration": 6.51
  },
  {
    "id": "sent_3",
    "text": "建安文人一方面深感生命苦短与朝不保夕的严峻生存现实，",
    "start": 11.38,
    "end": 17.304,
    "duration": 5.924
  },
  {
    "id": "sent_4",
    "text": "另一方面又怀抱平定天下、建功立业的强烈时代责任感。",
    "start": 17.305,
    "end": 22.435,
    "duration": 5.13
  },
  {
    "id": "sent_5",
    "text": "这种在时代阵痛中迸发出的昂扬志气与深沉忧患，",
    "start": 22.435,
    "end": 27.617,
    "duration": 5.182
  },
  {
    "id": "sent_6",
    "text": "造就了中国诗歌史上极具生命力的 “建安风骨”。",
    "start": 27.617,
    "end": 32.005,
    "duration": 4.388
  },
  {
    "id": "sent_7",
    "text": "鲁迅称这一时期为 “文学的自觉时代”；",
    "start": 32.005,
    "end": 35.469,
    "duration": 3.464
  },
  {
    "id": "sent_8",
    "text": "刘勰在 《文心雕龙·时序》 中赞其 “志深而笔长，",
    "start": 35.469,
    "end": 40.222,
    "duration": 4.753
  },
  {
    "id": "sent_9",
    "text": "故慷慨而多气也”。",
    "start": 40.221,
    "end": 42.526,
    "duration": 2.305
  },
  {
    "id": "sent_10",
    "text": "其美学内涵与三曹诗歌艺术，主要展现为以下四个核心维度：",
    "start": 42.526,
    "end": 48.516,
    "duration": 5.99
  },
  {
    "id": "sent_11",
    "text": "第一，标举“慷慨悲凉”与“爽朗刚健”的美学内涵，",
    "start": 48.516,
    "end": 52.995,
    "duration": 4.479
  },
  {
    "id": "sent_12",
    "text": "确立情志与文辞的高度统一。",
    "start": 52.995,
    "end": 56.055,
    "duration": 3.06
  },
  {
    "id": "sent_13",
    "text": "从美学范畴而言，“建安风骨” 是“风”与“骨”的有机融合。",
    "start": 56.055,
    "end": 61.341,
    "duration": 5.286
  },
  {
    "id": "sent_14",
    "text": "所谓 “风”，指诗歌充沛真挚、感人至深的思想感情与精神力量；",
    "start": 61.341,
    "end": 67.292,
    "duration": 5.951
  },
  {
    "id": "sent_15",
    "text": "所谓 “骨”，指表达这种感情的事理逻辑与刚健挺拔的文辞骨力。",
    "start": 67.292,
    "end": 72.917,
    "duration": 5.625
  },
  {
    "id": "sent_16",
    "text": "曹丕在 《典论·论文》 中提出 “文以气为主，气之清浊有体，",
    "start": 72.917,
    "end": 78.373,
    "duration": 5.456
  },
  {
    "id": "sent_17",
    "text": "不可力强而致”，强调作家的内在生命气质与才情格调。",
    "start": 78.372,
    "end": 83.515,
    "duration": 5.143
  },
  {
    "id": "sent_18",
    "text": "建安诗人摆脱了两汉经学教条的死板束缚，直抒胸臆、缘情而发，",
    "start": 83.516,
    "end": 89.883,
    "duration": 6.367
  },
  {
    "id": "sent_19",
    "text": "使诗歌既具备悲天悯人的现实忧患，又充满蓬勃刚健的进取精神，",
    "start": 89.883,
    "end": 96.081,
    "duration": 6.198
  },
  {
    "id": "sent_20",
    "text": "形成了悲壮而不消沉、刚健而不浅薄的独特风貌。",
    "start": 96.081,
    "end": 101.172,
    "duration": 5.091
  },
  {
    "id": "sent_21",
    "text": "第二，以“三曹”为核心展现多元艺术风貌，",
    "start": 101.172,
    "end": 105.365,
    "duration": 4.193
  },
  {
    "id": "sent_22",
    "text": "推动五言古诗全面走向成熟。",
    "start": 105.365,
    "end": 108.568,
    "duration": 3.203
  },
  {
    "id": "sent_23",
    "text": "建安诗坛以曹操、曹丕、曹植父子为核心领袖，",
    "start": 108.568,
    "end": 114.115,
    "duration": 5.547
  },
  {
    "id": "sent_24",
    "text": "形成了同中有异的创作格局。",
    "start": 114.115,
    "end": 117.071,
    "duration": 2.956
  },
  {
    "id": "sent_25",
    "text": "曹操诗歌风格 “古直悲凉”，善用旧题乐府反映汉末现实，",
    "start": 117.07,
    "end": 122.448,
    "duration": 5.378
  },
  {
    "id": "sent_26",
    "text": "在 《蒿里行》 中以沉痛笔触写出 “白骨露于野，千里无鸡鸣”，",
    "start": 122.448,
    "end": 127.76,
    "duration": 5.312
  },
  {
    "id": "sent_27",
    "text": "在 《短歌行》 中写下 “对酒当歌，人生几何”，",
    "start": 127.76,
    "end": 131.875,
    "duration": 4.115
  },
  {
    "id": "sent_28",
    "text": "气象雄浑、气吞山河；",
    "start": 131.875,
    "end": 134.557,
    "duration": 2.682
  },
  {
    "id": "sent_29",
    "text": "曹丕诗歌风格 “便娟婉约”，",
    "start": 134.557,
    "end": 137.33,
    "duration": 2.773
  },
  {
    "id": "sent_30",
    "text": "其 《燕歌行》 是中国文学史上现存最早成熟的文人七言诗，",
    "start": 137.331,
    "end": 142.696,
    "duration": 5.365
  },
  {
    "id": "sent_31",
    "text": "情致深婉流丽；",
    "start": 142.695,
    "end": 144.57,
    "duration": 1.875
  },
  {
    "id": "sent_32",
    "text": "曹植则代表了建安诗歌的最高成就，其诗 “骨气奇高，词采华茂”，",
    "start": 144.57,
    "end": 150.586,
    "duration": 6.016
  },
  {
    "id": "sent_33",
    "text": "前期 《白马篇》 塑造英勇报国的游侠少年，",
    "start": 150.586,
    "end": 154.57,
    "duration": 3.984
  },
  {
    "id": "sent_34",
    "text": "后期 《赠白马王彪》 展现身遭猜忌的抑郁悲愤，",
    "start": 154.57,
    "end": 159.114,
    "duration": 4.544
  },
  {
    "id": "sent_35",
    "text": "将深沉的情志与华美的藻饰完美结合。",
    "start": 159.115,
    "end": 163.295,
    "duration": 4.18
  },
  {
    "id": "sent_36",
    "text": "第三，贯穿深沉的生命忧患与建功立业抱负，",
    "start": 163.294,
    "end": 167.864,
    "duration": 4.57
  },
  {
    "id": "sent_37",
    "text": "实现个体自觉与社会担当的统一。",
    "start": 167.865,
    "end": 171.563,
    "duration": 3.698
  },
  {
    "id": "sent_38",
    "text": "建安诗歌最震撼人心的思想力量，在于其在深刻体认生命短暂的同时，",
    "start": 171.563,
    "end": 177.969,
    "duration": 6.406
  },
  {
    "id": "sent_39",
    "text": "展现出对永恒价值的主动追寻。",
    "start": 177.969,
    "end": 181.276,
    "duration": 3.307
  },
  {
    "id": "sent_40",
    "text": "乱世中的动荡离乱使文人普遍产生强烈的生死无常之感，",
    "start": 181.276,
    "end": 186.719,
    "duration": 5.443
  },
  {
    "id": "sent_41",
    "text": "但他们并未陷入道家消极避世的虚无泥淖，",
    "start": 186.719,
    "end": 190.834,
    "duration": 4.115
  },
  {
    "id": "sent_42",
    "text": "而是选择以建功立业、著书立说对抗死亡。",
    "start": 190.833,
    "end": 195.338,
    "duration": 4.505
  },
  {
    "id": "sent_43",
    "text": "曹丕明确提出 “年寿有时而尽，荣乐止乎其身……未若文章之无穷”；",
    "start": 195.338,
    "end": 201.445,
    "duration": 6.107
  },
  {
    "id": "sent_44",
    "text": "曹植发出 “捐躯赴国难，视死忽如归” 的慷慨誓言。",
    "start": 201.445,
    "end": 206.289,
    "duration": 4.844
  },
  {
    "id": "sent_45",
    "text": "这种在悲凉中激荡着英雄气概的精神品质，",
    "start": 206.289,
    "end": 210.625,
    "duration": 4.336
  },
  {
    "id": "sent_46",
    "text": "赋予了建安文学超越时代的崇高审美价值。",
    "start": 210.625,
    "end": 214.779,
    "duration": 4.154
  },
  {
    "id": "sent_47",
    "text": "第四，树立中国古典诗歌的刚健风范，",
    "start": 214.779,
    "end": 218.737,
    "duration": 3.958
  },
  {
    "id": "sent_48",
    "text": "成为后代反抗靡丽文风的美学旗帜。",
    "start": 218.737,
    "end": 222.201,
    "duration": 3.464
  },
  {
    "id": "sent_49",
    "text": "建安风骨以其刚健明朗的骨力与充沛的真情，",
    "start": 222.201,
    "end": 226.641,
    "duration": 4.44
  },
  {
    "id": "sent_50",
    "text": "成为后世历代诗歌革新运动的精神渊薮。",
    "start": 226.641,
    "end": 230.638,
    "duration": 3.997
  },
  {
    "id": "sent_51",
    "text": "南朝齐梁时期诗歌走向形式主义与声色浮艳，",
    "start": 230.638,
    "end": 235.468,
    "duration": 4.83
  },
  {
    "id": "sent_52",
    "text": "初唐陈子昂在 《修竹篇序》 中大声疾呼 “汉魏风骨，晋宋莫传”，",
    "start": 235.468,
    "end": 241.432,
    "duration": 5.964
  },
  {
    "id": "sent_53",
    "text": "借建安风骨扫除齐梁余习；",
    "start": 241.432,
    "end": 244.44,
    "duration": 3.008
  },
  {
    "id": "sent_54",
    "text": "李白亦在 《古风》 中高唱 “蓬莱文章建安骨”。",
    "start": 244.44,
    "end": 248.255,
    "duration": 3.815
  },
  {
    "id": "sent_55",
    "text": "建安风骨所确立的真情实感、刚健骨力与时代担当，",
    "start": 248.255,
    "end": 253.359,
    "duration": 5.104
  },
  {
    "id": "sent_56",
    "text": "成为中国古典诗歌优良传统中不可磨灭的精神灯塔。",
    "start": 253.359,
    "end": 258.203,
    "duration": 4.844
  }
]