[
  {
    "id": 1,
    "text": "试论“建安风骨”的美学内涵与“三曹”诗歌艺术。",
    "start": 0.101,
    "end": 3.61,
    "duration": 3.509
  },
  {
    "id": 2,
    "text": "汉末魏初是中国文学走向自觉的关键转折时期。",
    "start": 3.894,
    "end": 7.467,
    "duration": 3.573
  },
  {
    "id": 3,
    "text": "面对群雄割据、战乱频仍与瘟疫横行的社会动荡，",
    "start": 7.821,
    "end": 11.635,
    "duration": 3.814
  },
  {
    "id": 4,
    "text": "建安文人一方面深感生命短促、朝不保夕，",
    "start": 12.035,
    "end": 15.175,
    "duration": 3.14
  },
  {
    "id": 5,
    "text": "另一方面又怀抱平定天下、建功立业的时代抱负。",
    "start": 15.592,
    "end": 19.172,
    "duration": 3.58
  },
  {
    "id": 6,
    "text": "这种在乱世阵痛中迸发出的昂扬志气与深沉忧患，",
    "start": 19.466,
    "end": 23.775,
    "duration": 4.309
  },
  {
    "id": 7,
    "text": "造就了中国诗歌史上极具生命力的“建安风骨”。",
    "start": 24.306,
    "end": 27.82,
    "duration": 3.514
  },
  {
    "id": 8,
    "text": "鲁迅称这一时期为“文学的自觉时代”；",
    "start": 28.398,
    "end": 31.236,
    "duration": 2.838
  },
  {
    "id": 9,
    "text": "刘勰在《文心雕龙·时序》中赞其“志深而笔长，",
    "start": 31.807,
    "end": 35.673,
    "duration": 3.866
  },
  {
    "id": 10,
    "text": "故梗概而多气也”。",
    "start": 35.943,
    "end": 37.353,
    "duration": 1.41
  },
  {
    "id": 11,
    "text": "其美学内涵与三曹诗歌艺术，主要体现在以下四个方面：",
    "start": 37.946,
    "end": 42.187,
    "duration": 4.241
  },
  {
    "id": 12,
    "text": "第一，标举“慷慨悲凉”与“爽朗刚健”的风貌，",
    "start": 42.817,
    "end": 45.999,
    "duration": 3.182
  },
  {
    "id": 13,
    "text": "达成情志与文辞的统一。",
    "start": 46.312,
    "end": 48.25,
    "duration": 1.938
  },
  {
    "id": 14,
    "text": "从诗学内涵而言，“建安风骨”是“风”与“骨”的有机统一。",
    "start": 48.612,
    "end": 52.821,
    "duration": 4.209
  },
  {
    "id": 15,
    "text": "“风”指诗歌充沛真挚、感人至深的思想感情，",
    "start": 53.428,
    "end": 56.645,
    "duration": 3.217
  },
  {
    "id": 16,
    "text": "“骨”指表达情志的事理逻辑与刚健挺拔的文辞骨力。",
    "start": 56.986,
    "end": 61.209,
    "duration": 4.223
  },
  {
    "id": 17,
    "text": "曹丕在《典论·论文》中提出“文以气为主，气之清浊有体，",
    "start": 61.459,
    "end": 66.092,
    "duration": 4.633
  },
  {
    "id": 18,
    "text": "不可力强而致”，强调作家的气质才情与作品风貌的密切关联。",
    "start": 66.355,
    "end": 71.037,
    "duration": 4.682
  },
  {
    "id": 19,
    "text": "建安诗人摆脱了两汉经学教条的束缚，直抒胸臆、缘情而发，",
    "start": 71.274,
    "end": 76.036,
    "duration": 4.762
  },
  {
    "id": 20,
    "text": "使诗歌既具悲天悯人的现实忧患，又充满蓬勃刚健的进取精神，",
    "start": 76.122,
    "end": 81.347,
    "duration": 5.225
  },
  {
    "id": 21,
    "text": "形成了悲壮而不消沉、刚健而不浅薄的独特风貌。",
    "start": 81.618,
    "end": 85.641,
    "duration": 4.023
  },
  {
    "id": 22,
    "text": "第二，以“三曹”为核心展现多元艺术风貌，",
    "start": 86.314,
    "end": 89.751,
    "duration": 3.437
  },
  {
    "id": 23,
    "text": "推动五言古诗全面成熟。",
    "start": 90.088,
    "end": 92.116,
    "duration": 2.028
  },
  {
    "id": 24,
    "text": "建安诗坛以曹操、曹丕、曹植父子为核心，",
    "start": 92.425,
    "end": 95.909,
    "duration": 3.484
  },
  {
    "id": 25,
    "text": "形成了同中有异的创作格局。",
    "start": 96.013,
    "end": 98.002,
    "duration": 1.989
  },
  {
    "id": 26,
    "text": "曹操诗歌“古直悲凉”，善用乐府旧题写汉末时事，",
    "start": 98.581,
    "end": 102.838,
    "duration": 4.257
  },
  {
    "id": 27,
    "text": "在《蒿里行》中沉痛写出“白骨露于野，千里无鸡鸣”，",
    "start": 103.089,
    "end": 107.96,
    "duration": 4.871
  },
  {
    "id": 28,
    "text": "在《短歌行》中叹咏“对酒当歌，人生几何”，气象雄浑苍凉；",
    "start": 108.236,
    "end": 113.67,
    "duration": 5.434
  },
  {
    "id": 29,
    "text": "曹丕诗歌“便娟婉约”，",
    "start": 114.055,
    "end": 115.759,
    "duration": 1.704
  },
  {
    "id": 30,
    "text": "其《燕歌行》是中国文学史上现存最早完整的文人七言诗，",
    "start": 116.125,
    "end": 120.77,
    "duration": 4.645
  },
  {
    "id": 31,
    "text": "情致深婉流丽；曹植代表建安诗歌的最高成就，",
    "start": 121.14,
    "end": 124.931,
    "duration": 3.791
  },
  {
    "id": 32,
    "text": "其诗“骨气奇高，词采华茂”，",
    "start": 125.244,
    "end": 127.82,
    "duration": 2.576
  },
  {
    "id": 33,
    "text": "前期《白马篇》歌颂游侠少年报国之志，",
    "start": 128.07,
    "end": 131.345,
    "duration": 3.275
  },
  {
    "id": 34,
    "text": "后期《赠白马王彪》抒发身遭猜忌的抑郁悲愤，",
    "start": 131.838,
    "end": 135.478,
    "duration": 3.64
  },
  {
    "id": 35,
    "text": "将深沉情志与华美词采融为一体。",
    "start": 135.855,
    "end": 138.857,
    "duration": 3.002
  },
  {
    "id": 36,
    "text": "第三，深沉忧生而奋发立功，统一了个体觉醒与济世担当。",
    "start": 139.483,
    "end": 144.849,
    "duration": 5.366
  },
  {
    "id": 37,
    "text": "建安诗歌最动人的思想力量，",
    "start": 145.142,
    "end": 147.343,
    "duration": 2.201
  },
  {
    "id": 38,
    "text": "在于其在清醒体认生命短暂的同时，主动追寻不朽的人生价值。",
    "start": 147.535,
    "end": 152.911,
    "duration": 5.376
  },
  {
    "id": 39,
    "text": "乱世离乱使文人普遍产生生死无常之感，",
    "start": 153.495,
    "end": 156.951,
    "duration": 3.456
  },
  {
    "id": 40,
    "text": "但他们并未沉溺于消极避世，而是选择以建功立业、",
    "start": 157.102,
    "end": 161.028,
    "duration": 3.926
  },
  {
    "id": 41,
    "text": "著书立说对抗流年。",
    "start": 161.326,
    "end": 163.127,
    "duration": 1.801
  },
  {
    "id": 42,
    "text": "曹丕在《典论·论文》中明确提出“年寿有时而尽，",
    "start": 163.357,
    "end": 167.711,
    "duration": 4.354
  },
  {
    "id": 43,
    "text": "荣乐止乎其身……未若文章之无穷”；曹植发出“捐躯赴国难，",
    "start": 168.041,
    "end": 173.762,
    "duration": 5.721
  },
  {
    "id": 44,
    "text": "视死忽如归”的慷慨誓言。",
    "start": 174.042,
    "end": 176.228,
    "duration": 2.186
  },
  {
    "id": 45,
    "text": "这种于悲凉中激荡英雄气概的精神品格，",
    "start": 176.611,
    "end": 179.787,
    "duration": 3.176
  },
  {
    "id": 46,
    "text": "赋予了建安文学超越时代的崇高美感。",
    "start": 180.124,
    "end": 183.324,
    "duration": 3.2
  },
  {
    "id": 47,
    "text": "第四，树立古典诗歌刚健风范，成为后代革新浮靡文风的精神旗帜。",
    "start": 183.938,
    "end": 189.237,
    "duration": 5.299
  },
  {
    "id": 48,
    "text": "建安风骨以其刚健明朗的骨力与充沛真情，",
    "start": 189.69,
    "end": 193.209,
    "duration": 3.519
  },
  {
    "id": 49,
    "text": "成为后世历代诗歌革新运动的重要旗帜。",
    "start": 193.57,
    "end": 196.324,
    "duration": 2.754
  },
  {
    "id": 50,
    "text": "南朝齐梁时期诗歌趋于声色浮艳，",
    "start": 196.461,
    "end": 199.074,
    "duration": 2.613
  },
  {
    "id": 51,
    "text": "初唐陈子昂在《修竹篇序》中疾呼“汉魏风骨，晋宋莫传”，",
    "start": 199.318,
    "end": 203.726,
    "duration": 4.408
  },
  {
    "id": 52,
    "text": "借建安传统扫除齐梁余习；",
    "start": 204.014,
    "end": 206.356,
    "duration": 2.342
  },
  {
    "id": 53,
    "text": "李白亦在《宣州谢朓楼饯别校书叔云》中高唱“蓬莱文章建安骨”。",
    "start": 206.648,
    "end": 212.046,
    "duration": 5.398
  },
  {
    "id": 54,
    "text": "建安风骨所确立的真情实感、刚健气韵与时代担当，",
    "start": 212.416,
    "end": 216.433,
    "duration": 4.017
  },
  {
    "id": 55,
    "text": "成为中国古典诗歌史上薪火相传的宝贵精神财富。",
    "start": 216.629,
    "end": 220.601,
    "duration": 3.972
  }
]