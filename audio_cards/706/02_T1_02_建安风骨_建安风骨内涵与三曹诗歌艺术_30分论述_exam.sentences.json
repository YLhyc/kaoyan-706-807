[
  {
    "id": 1,
    "text": "试论“建安风骨”的美学内涵与“三曹”诗歌艺术。",
    "start": 0.134,
    "end": 3.386,
    "duration": 3.252
  },
  {
    "id": 2,
    "text": "汉末魏初是中国文学走向自觉的关键转折时期。",
    "start": 4.063,
    "end": 7.715,
    "duration": 3.652
  },
  {
    "id": 3,
    "text": "面对群雄割据、战乱频仍与瘟疫横行的社会动荡，",
    "start": 8.473,
    "end": 12.245,
    "duration": 3.772
  },
  {
    "id": 4,
    "text": "建安文人一方面深感生命短促、朝不保夕，另一方面又怀抱平定天下、建功立业的时代抱负。",
    "start": 12.624,
    "end": 20.116,
    "duration": 7.492
  },
  {
    "id": 5,
    "text": "这种在乱世阵痛中迸发出的昂扬志气与深沉忧患，",
    "start": 20.714,
    "end": 24.846,
    "duration": 4.132
  },
  {
    "id": 6,
    "text": "造就了中国诗歌史上极具生命力的“建安风骨”。",
    "start": 25.225,
    "end": 28.597,
    "duration": 3.372
  },
  {
    "id": 7,
    "text": "鲁迅称这一时期为“文学的自觉时代”；",
    "start": 29.235,
    "end": 30.647,
    "duration": 1.412
  },
  {
    "id": 8,
    "text": "刘勰在《文心雕龙·时序》中赞其“志深而笔长，故梗概而多气也”。",
    "start": 31.176,
    "end": 32.428,
    "duration": 1.252
  },
  {
    "id": 9,
    "text": "其美学内涵与三曹诗歌艺术，主要体现在以下四个方面：",
    "start": 33.186,
    "end": 37.918,
    "duration": 4.732
  },
  {
    "id": 10,
    "text": "第一，标举“慷慨悲凉”与“爽朗刚健”的风貌，达成情志与文辞的统一。",
    "start": 38.556,
    "end": 47.888,
    "duration": 9.332
  },
  {
    "id": 11,
    "text": "从诗学内涵而言，“建安风骨”是“风”与“骨”的有机统一。",
    "start": 48.566,
    "end": 52.658,
    "duration": 4.092
  },
  {
    "id": 12,
    "text": "“风”指诗歌充沛真挚、感人至深的思想感情，",
    "start": 53.376,
    "end": 57.068,
    "duration": 3.692
  },
  {
    "id": 13,
    "text": "“骨”指表达情志的事理逻辑与刚健挺拔的文辞骨力。",
    "start": 57.447,
    "end": 61.539,
    "duration": 4.092
  },
  {
    "id": 14,
    "text": "曹丕在《典论·论文》中提出“文以气为主，气之清浊有体，不可力强而致”，",
    "start": 62.177,
    "end": 67.229,
    "duration": 5.052
  },
  {
    "id": 15,
    "text": "强调作家的气质才情与作品风貌的密切关联。",
    "start": 67.608,
    "end": 70.78,
    "duration": 3.172
  },
  {
    "id": 16,
    "text": "建安诗人摆脱了两汉经学教条的束缚，直抒胸臆、缘情而发，",
    "start": 71.458,
    "end": 76.23,
    "duration": 4.772
  },
  {
    "id": 17,
    "text": "使诗歌既具悲天悯人的现实忧患，又充满蓬勃刚健的进取精神，",
    "start": 76.609,
    "end": 81.941,
    "duration": 5.332
  },
  {
    "id": 18,
    "text": "形成了悲壮而不消沉、刚健而不浅薄的独特风貌。",
    "start": 82.32,
    "end": 86.412,
    "duration": 4.092
  },
  {
    "id": 19,
    "text": "第二，以“三曹”为核心展现多元艺术风貌，推动五言古诗全面成熟。",
    "start": 87.05,
    "end": 91.942,
    "duration": 4.892
  },
  {
    "id": 20,
    "text": "建安诗坛以曹操、曹丕、曹植父子为核心，形成了同中有异的创作格局。",
    "start": 92.58,
    "end": 98.552,
    "duration": 5.972
  },
  {
    "id": 21,
    "text": "曹操诗歌“古直悲凉”，善用乐府旧题写汉末时事，",
    "start": 99.291,
    "end": 100.983,
    "duration": 1.692
  },
  {
    "id": 22,
    "text": "在《蒿里行》中沉痛写出“白骨露于野，千里无鸡鸣”，",
    "start": 101.362,
    "end": 107.894,
    "duration": 6.532
  },
  {
    "id": 23,
    "text": "在《短歌行》中叹咏“对酒当歌，人生几何”，气象雄浑苍凉；",
    "start": 108.273,
    "end": 111.525,
    "duration": 3.252
  },
  {
    "id": 24,
    "text": "曹丕诗歌“便娟婉约”，其《燕歌行》是中国文学史上现存最早完整的文人七言诗，情致深婉流丽；",
    "start": 112.084,
    "end": 120.044,
    "duration": 7.96
  },
  {
    "id": 25,
    "text": "曹植代表建安诗歌的最高成就，其诗“骨气奇高，词采华茂”，",
    "start": 120.573,
    "end": 130.145,
    "duration": 9.572
  },
  {
    "id": 26,
    "text": "前期《白马篇》歌颂游侠少年报国之志，",
    "start": 130.695,
    "end": 134.067,
    "duration": 3.372
  },
  {
    "id": 27,
    "text": "后期《赠白马王彪》抒发身遭猜忌的抑郁悲愤，将深沉情志与华美词采融为一体。",
    "start": 134.446,
    "end": 137.458,
    "duration": 3.012
  },
  {
    "id": 28,
    "text": "第三，深沉忧生而奋发立功，统一了个体觉醒与济世担当。",
    "start": 138.082,
    "end": 143.014,
    "duration": 4.932
  },
  {
    "id": 29,
    "text": "建安诗歌最动人的思想力量，在于其在清醒体认生命短暂的同时，主动追寻不朽的人生价值。",
    "start": 143.692,
    "end": 151.024,
    "duration": 7.332
  },
  {
    "id": 30,
    "text": "乱世离乱使文人普遍产生生死无常之感，但他们并未沉溺于消极避世，而是选择以建功立业、著书立说对抗流年。",
    "start": 151.822,
    "end": 160.994,
    "duration": 9.172
  },
  {
    "id": 31,
    "text": "曹丕在《典论·论文》中明确提出“年寿有时而尽，荣乐止乎其身……未若文章之无穷”；",
    "start": 161.752,
    "end": 167.884,
    "duration": 6.132
  },
  {
    "id": 32,
    "text": "曹植发出“捐躯赴国难，视死忽如归”的慷慨誓言。",
    "start": 168.642,
    "end": 172.414,
    "duration": 3.772
  },
  {
    "id": 33,
    "text": "这种于悲凉中激荡英雄气概的精神品格，赋予了建安文学超越时代的崇高美感。",
    "start": 173.132,
    "end": 179.064,
    "duration": 5.932
  },
  {
    "id": 34,
    "text": "第四，树立古典诗歌刚健风范，成为后代革新浮靡文风的精神旗帜。",
    "start": 179.702,
    "end": 185.354,
    "duration": 5.652
  },
  {
    "id": 35,
    "text": "建安风骨以其刚健明朗的骨力与充沛真情，成为后世历代诗歌革新运动的重要旗帜。",
    "start": 185.992,
    "end": 192.284,
    "duration": 6.292
  },
  {
    "id": 36,
    "text": "南朝齐梁时期诗歌趋于声色浮艳，",
    "start": 192.922,
    "end": 195.814,
    "duration": 2.892
  },
  {
    "id": 37,
    "text": "初唐陈子昂在《修竹篇序》中疾呼“汉魏风骨，晋宋莫传”，借建安传统扫除齐梁余习；",
    "start": 196.193,
    "end": 199.765,
    "duration": 3.572
  },
  {
    "id": 38,
    "text": "李白亦在《宣州谢朓楼饯别校书叔云》中高唱“蓬莱文章建安骨”。",
    "start": 200.294,
    "end": 203.706,
    "duration": 3.412
  },
  {
    "id": 39,
    "text": "建安风骨所确立的真情实感、刚健气韵与时代担当，",
    "start": 204.424,
    "end": 211.596,
    "duration": 7.172
  },
  {
    "id": 40,
    "text": "成为中国古典诗歌史上薪火相传的宝贵精神财富。",
    "start": 211.975,
    "end": 217.267,
    "duration": 5.292
  },
  {
    "id": 41,
    "text": "综上所述，建安风骨在汉末乱世阵痛中实现了个体生命觉醒与济世抱负的统一，",
    "start": 217.796,
    "end": 224.408,
    "duration": 6.612
  },
  {
    "id": 42,
    "text": "呈现出慷慨悲凉而爽朗刚健的审美气象。",
    "start": 224.787,
    "end": 227.999,
    "duration": 3.212
  },
  {
    "id": 43,
    "text": "“三曹”立足五言古诗与乐府旧题推陈出新，",
    "start": 228.528,
    "end": 231.86,
    "duration": 3.332
  },
  {
    "id": 44,
    "text": "推动文人诗歌告别汉代经学附庸而走向自觉；其重真情、尚风力的诗学传统，",
    "start": 232.239,
    "end": 238.781,
    "duration": 6.542
  },
  {
    "id": 45,
    "text": "成为陈子昂、李白等后代诗人革除浮靡诗风的精神典范。",
    "start": 239.16,
    "end": 243.812,
    "duration": 4.652
  }
]