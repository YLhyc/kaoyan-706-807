[
  {
    "id": "sent_1",
    "text": "汉末魏初是中国文学走向自觉的关键转折时期。",
    "start": 0.0,
    "end": 3.88,
    "duration": 3.88
  },
  {
    "id": "sent_2",
    "text": "面对黄巾起义爆发、军阀割据混战与瘟疫流行造成的社会剧烈动荡，",
    "start": 4.329,
    "end": 9.849,
    "duration": 5.52
  },
  {
    "id": "sent_3",
    "text": "建安文人一方面深感生命苦短与朝不保夕的严峻生存现实，",
    "start": 10.299,
    "end": 15.139,
    "duration": 4.84
  },
  {
    "id": "sent_4",
    "text": "另一方面又怀抱平定天下、建功立业的强烈时代责任感。",
    "start": 15.669,
    "end": 20.069,
    "duration": 4.4
  },
  {
    "id": "sent_5",
    "text": "这种在时代阵痛中迸发出的昂扬志气与深沉忧患，",
    "start": 20.519,
    "end": 24.879,
    "duration": 4.36
  },
  {
    "id": "sent_6",
    "text": "造就了中国诗歌史上极具生命力的 “建安风骨”。",
    "start": 25.329,
    "end": 28.889,
    "duration": 3.56
  },
  {
    "id": "sent_7",
    "text": "鲁迅称这一时期为 “文学的自觉时代”；",
    "start": 29.339,
    "end": 32.219,
    "duration": 2.88
  },
  {
    "id": "sent_8",
    "text": "刘勰在 《文心雕龙·时序》 中赞其 “志深而笔长，",
    "start": 32.749,
    "end": 36.549,
    "duration": 3.8
  },
  {
    "id": "sent_9",
    "text": "故慷慨而多气也”。",
    "start": 37.079,
    "end": 38.479,
    "duration": 1.4
  },
  {
    "id": "sent_10",
    "text": "其美学内涵与三曹诗歌艺术，主要展现为以下四个核心维度：",
    "start": 38.929,
    "end": 43.449,
    "duration": 4.52
  },
  {
    "id": "sent_11",
    "text": "第一，标举“慷慨悲凉”与“爽朗刚健”的美学内涵，",
    "start": 43.899,
    "end": 47.819,
    "duration": 3.92
  },
  {
    "id": "sent_12",
    "text": "确立情志与文辞的高度统一。",
    "start": 48.269,
    "end": 50.909,
    "duration": 2.64
  },
  {
    "id": "sent_13",
    "text": "从美学范畴而言，“建安风骨” 是“风”与“骨”的有机融合。",
    "start": 51.359,
    "end": 55.319,
    "duration": 3.96
  },
  {
    "id": "sent_14",
    "text": "所谓 “风”，指诗歌充沛真挚、感人至深的思想感情与精神力量；",
    "start": 55.769,
    "end": 61.009,
    "duration": 5.24
  },
  {
    "id": "sent_15",
    "text": "所谓 “骨”，指表达这种感情的事理逻辑与刚健挺拔的文辞骨力。",
    "start": 61.459,
    "end": 66.659,
    "duration": 5.2
  },
  {
    "id": "sent_16",
    "text": "曹丕在 《典论·论文》 中提出 “文以气为主，气之清浊有体，",
    "start": 67.109,
    "end": 71.269,
    "duration": 4.16
  },
  {
    "id": "sent_17",
    "text": "不可力强而致”，强调作家的内在生命气质与才情格调。",
    "start": 71.799,
    "end": 76.359,
    "duration": 4.56
  },
  {
    "id": "sent_18",
    "text": "建安诗人摆脱了两汉经学教条的死板束缚，直抒胸臆、缘情而发，",
    "start": 76.809,
    "end": 81.969,
    "duration": 5.16
  },
  {
    "id": "sent_19",
    "text": "使诗歌既具备悲天悯人的现实忧患，又充满蓬勃刚健的进取精神，",
    "start": 82.419,
    "end": 87.939,
    "duration": 5.52
  },
  {
    "id": "sent_20",
    "text": "形成了悲壮而不消沉、刚健而不浅薄的独特风貌。",
    "start": 88.389,
    "end": 92.589,
    "duration": 4.2
  },
  {
    "id": "sent_21",
    "text": "第二，以“三曹”为核心展现多元艺术风貌，",
    "start": 93.039,
    "end": 96.519,
    "duration": 3.48
  },
  {
    "id": "sent_22",
    "text": "推动五言古诗全面走向成熟。",
    "start": 96.969,
    "end": 99.449,
    "duration": 2.48
  },
  {
    "id": "sent_23",
    "text": "建安诗坛以曹操、曹丕、曹植父子为核心领袖，",
    "start": 99.899,
    "end": 104.059,
    "duration": 4.16
  },
  {
    "id": "sent_24",
    "text": "形成了同中有异的创作格局。",
    "start": 104.509,
    "end": 106.909,
    "duration": 2.4
  },
  {
    "id": "sent_25",
    "text": "曹操诗歌风格 “古直悲凉”，善用旧题乐府反映汉末现实，",
    "start": 107.359,
    "end": 112.079,
    "duration": 4.72
  },
  {
    "id": "sent_26",
    "text": "在 《蒿里行》 中以沉痛笔触写出 “白骨露于野，",
    "start": 112.529,
    "end": 116.289,
    "duration": 3.76
  },
  {
    "id": "sent_27",
    "text": "千里无鸡鸣”，在 《短歌行》 中写下 “对酒当歌，",
    "start": 116.739,
    "end": 120.579,
    "duration": 3.84
  },
  {
    "id": "sent_28",
    "text": "人生几何”，气象雄浑、气吞山河；",
    "start": 121.029,
    "end": 123.949,
    "duration": 2.92
  },
  {
    "id": "sent_29",
    "text": "曹丕诗歌风格 “便娟婉约”，",
    "start": 124.399,
    "end": 126.639,
    "duration": 2.24
  },
  {
    "id": "sent_30",
    "text": "其 《燕歌行》 是中国文学史上现存最早成熟的文人七言诗，",
    "start": 127.089,
    "end": 131.769,
    "duration": 4.68
  },
  {
    "id": "sent_31",
    "text": "情致深婉流丽；",
    "start": 132.219,
    "end": 133.619,
    "duration": 1.4
  },
  {
    "id": "sent_32",
    "text": "曹植则代表了建安诗歌的最高成就，其诗 “骨气奇高，",
    "start": 134.069,
    "end": 138.469,
    "duration": 4.4
  },
  {
    "id": "sent_33",
    "text": "词采华茂”，前期 《白马篇》 塑造英勇报国的游侠少年，",
    "start": 138.999,
    "end": 143.279,
    "duration": 4.28
  },
  {
    "id": "sent_34",
    "text": "后期 《赠白马王彪》 展现身遭猜忌的抑郁悲愤，",
    "start": 143.809,
    "end": 147.329,
    "duration": 3.52
  },
  {
    "id": "sent_35",
    "text": "将深沉的情志与华美的藻饰完美结合。",
    "start": 147.779,
    "end": 150.939,
    "duration": 3.16
  },
  {
    "id": "sent_36",
    "text": "第三，贯穿深沉的生命忧患与建功立业抱负，",
    "start": 151.389,
    "end": 155.309,
    "duration": 3.92
  },
  {
    "id": "sent_37",
    "text": "实现个体自觉与社会担当的统一。",
    "start": 155.759,
    "end": 158.599,
    "duration": 2.84
  },
  {
    "id": "sent_38",
    "text": "建安诗歌最震撼人心的思想力量，",
    "start": 159.049,
    "end": 161.569,
    "duration": 2.52
  },
  {
    "id": "sent_39",
    "text": "在于其在深刻体认生命短暂的同时，展现出对永恒价值的主动追寻。",
    "start": 162.019,
    "end": 167.659,
    "duration": 5.64
  },
  {
    "id": "sent_40",
    "text": "乱世中的动荡离乱使文人普遍产生强烈的生死无常之感，",
    "start": 168.189,
    "end": 172.589,
    "duration": 4.4
  },
  {
    "id": "sent_41",
    "text": "但他们并未陷入道家消极避世的虚无泥淖，而是选择以建功立业、",
    "start": 173.119,
    "end": 178.079,
    "duration": 4.96
  },
  {
    "id": "sent_42",
    "text": "著书立说对抗死亡。",
    "start": 178.609,
    "end": 180.289,
    "duration": 1.68
  },
  {
    "id": "sent_43",
    "text": "曹丕明确提出 “年寿有时而尽，",
    "start": 180.739,
    "end": 183.339,
    "duration": 2.6
  },
  {
    "id": "sent_44",
    "text": "荣乐止乎其身……未若文章之无穷”；",
    "start": 183.869,
    "end": 185.149,
    "duration": 1.28
  },
  {
    "id": "sent_45",
    "text": "曹植发出 “捐躯赴国难，视死忽如归” 的慷慨誓言。",
    "start": 185.679,
    "end": 187.039,
    "duration": 1.36
  },
  {
    "id": "sent_46",
    "text": "这种在悲凉中激荡着英雄气概的精神品质，",
    "start": 187.608,
    "end": 191.648,
    "duration": 4.04
  },
  {
    "id": "sent_47",
    "text": "赋予了建安文学超越时代的崇高审美价值。",
    "start": 192.098,
    "end": 195.418,
    "duration": 3.32
  },
  {
    "id": "sent_48",
    "text": "第四，树立中国古典诗歌的刚健风范，",
    "start": 195.868,
    "end": 199.268,
    "duration": 3.4
  },
  {
    "id": "sent_49",
    "text": "成为后代反抗靡丽文风的美学旗帜。",
    "start": 199.718,
    "end": 202.838,
    "duration": 3.12
  },
  {
    "id": "sent_50",
    "text": "建安风骨以其刚健明朗的骨力与充沛的真情，",
    "start": 203.288,
    "end": 206.168,
    "duration": 2.88
  },
  {
    "id": "sent_51",
    "text": "成为后世历代诗歌革新运动的精神渊薮。",
    "start": 206.618,
    "end": 210.218,
    "duration": 3.6
  },
  {
    "id": "sent_52",
    "text": "南朝齐梁时期诗歌走向形式主义与声色浮艳，",
    "start": 210.668,
    "end": 213.948,
    "duration": 3.28
  },
  {
    "id": "sent_53",
    "text": "初唐陈子昂在 《修竹篇序》 中大声疾呼 “汉魏风骨，",
    "start": 214.398,
    "end": 218.438,
    "duration": 4.04
  },
  {
    "id": "sent_54",
    "text": "晋宋莫传”，借建安风骨扫除齐梁余习；",
    "start": 218.888,
    "end": 222.848,
    "duration": 3.96
  },
  {
    "id": "sent_55",
    "text": "李白亦在 《古风》 中高唱 “蓬莱文章建安骨”。",
    "start": 223.298,
    "end": 226.778,
    "duration": 3.48
  },
  {
    "id": "sent_56",
    "text": "建安风骨所确立的真情实感、刚健骨力与时代担当，",
    "start": 227.228,
    "end": 230.548,
    "duration": 3.32
  },
  {
    "id": "sent_57",
    "text": "成为中国古典诗歌优良传统中不可磨灭的精神灯塔。",
    "start": 230.998,
    "end": 235.598,
    "duration": 4.6
  }
]