[
  {
    "id": 1,
    "text": "试论“建安风骨”的美学内涵与“三曹”诗歌艺术。",
    "start": 0.12,
    "end": 3.639,
    "duration": 3.519
  },
  {
    "id": 2,
    "text": "汉末魏初是中国文学走向自觉的关键转折时期。",
    "start": 4.159,
    "end": 7.742,
    "duration": 3.583
  },
  {
    "id": 3,
    "text": "面对群雄割据、战乱频仍与瘟疫横行的社会动荡，",
    "start": 8.262,
    "end": 12.085,
    "duration": 3.823
  },
  {
    "id": 4,
    "text": "建安文人一方面深感生命短促、朝不保夕，另一方面又怀抱平定天下、建功立业的时代抱负。",
    "start": 12.476,
    "end": 19.596,
    "duration": 7.12
  },
  {
    "id": 5,
    "text": "这种在乱世阵痛中迸发出的昂扬志气与深沉忧患，",
    "start": 20.116,
    "end": 24.435,
    "duration": 4.319
  },
  {
    "id": 6,
    "text": "造就了中国诗歌史上极具生命力的“建安风骨”。",
    "start": 24.956,
    "end": 28.48,
    "duration": 3.524
  },
  {
    "id": 7,
    "text": "鲁迅称这一时期为“文学的自觉时代”；",
    "start": 29.048,
    "end": 31.896,
    "duration": 2.848
  },
  {
    "id": 8,
    "text": "刘勰在《文心雕龙·时序》中赞其“志深而笔长，故梗概而多气也”。",
    "start": 32.457,
    "end": 38.013,
    "duration": 5.556
  },
  {
    "id": 9,
    "text": "其美学内涵与三曹诗歌艺术，主要体现在以下四个方面：",
    "start": 38.596,
    "end": 42.847,
    "duration": 4.251
  },
  {
    "id": 10,
    "text": "第一，标举“慷慨悲凉”与“爽朗刚健”的风貌，达成情志与文辞的统一。",
    "start": 43.467,
    "end": 48.91,
    "duration": 5.443
  },
  {
    "id": 11,
    "text": "从诗学内涵而言，“建安风骨”是“风”与“骨”的有机统一。",
    "start": 49.43,
    "end": 53.649,
    "duration": 4.219
  },
  {
    "id": 12,
    "text": "“风”指诗歌充沛真挚、感人至深的思想感情，",
    "start": 54.246,
    "end": 57.473,
    "duration": 3.227
  },
  {
    "id": 13,
    "text": "“骨”指表达情志的事理逻辑与刚健挺拔的文辞骨力。",
    "start": 57.843,
    "end": 62.076,
    "duration": 4.233
  },
  {
    "id": 14,
    "text": "曹丕在《典论·论文》中提出“文以气为主，气之清浊有体，不可力强而致”，",
    "start": 62.596,
    "end": 68.5,
    "duration": 5.904
  },
  {
    "id": 15,
    "text": "强调作家的气质才情与作品风貌的密切关联。",
    "start": 68.87,
    "end": 72.419,
    "duration": 3.549
  },
  {
    "id": 16,
    "text": "建安诗人摆脱了两汉经学教条的束缚，直抒胸臆、缘情而发，",
    "start": 72.939,
    "end": 77.706,
    "duration": 4.767
  },
  {
    "id": 17,
    "text": "使诗歌既具悲天悯人的现实忧患，又充满蓬勃刚健的进取精神，",
    "start": 78.076,
    "end": 83.324,
    "duration": 5.248
  },
  {
    "id": 18,
    "text": "形成了悲壮而不消沉、刚健而不浅薄的独特风貌。",
    "start": 83.694,
    "end": 87.726,
    "duration": 4.032
  },
  {
    "id": 19,
    "text": "第二，以“三曹”为核心展现多元艺术风貌，推动五言古诗全面成熟。",
    "start": 88.39,
    "end": 94.186,
    "duration": 5.796
  },
  {
    "id": 20,
    "text": "建安诗坛以曹操、曹丕、曹植父子为核心，形成了同中有异的创作格局。",
    "start": 94.719,
    "end": 100.088,
    "duration": 5.369
  },
  {
    "id": 21,
    "text": "曹操诗歌“古直悲凉”，善用乐府旧题写汉末时事，",
    "start": 100.657,
    "end": 104.924,
    "duration": 4.267
  },
  {
    "id": 22,
    "text": "在《蒿里行》中沉痛写出“白骨露于野，千里无鸡鸣”，",
    "start": 105.392,
    "end": 110.046,
    "duration": 4.654
  },
  {
    "id": 23,
    "text": "在《短歌行》中叹咏“对酒当歌，人生几何”，气象雄浑苍凉；",
    "start": 110.416,
    "end": 115.86,
    "duration": 5.444
  },
  {
    "id": 24,
    "text": "曹丕诗歌“便娟婉约”，其《燕歌行》是中国文学史上现存最早完整的文人七言诗，情致深婉流丽；",
    "start": 116.38,
    "end": 124.594,
    "duration": 8.214
  },
  {
    "id": 25,
    "text": "曹植代表建安诗歌的最高成就，其诗“骨气奇高，词采华茂”，",
    "start": 125.114,
    "end": 130.323,
    "duration": 5.209
  },
  {
    "id": 26,
    "text": "前期《白马篇》歌颂游侠少年报国之志，",
    "start": 130.693,
    "end": 133.978,
    "duration": 3.285
  },
  {
    "id": 27,
    "text": "后期《赠白马王彪》抒发身遭猜忌的抑郁悲愤，将深沉情志与华美词采融为一体。",
    "start": 134.461,
    "end": 141.49,
    "duration": 7.029
  },
  {
    "id": 28,
    "text": "第三，深沉忧生而奋发立功，统一了个体觉醒与济世担当。",
    "start": 142.106,
    "end": 147.482,
    "duration": 5.376
  },
  {
    "id": 29,
    "text": "建安诗歌最动人的思想力量，在于其在清醒体认生命短暂的同时，主动追寻不朽的人生价值。",
    "start": 148.002,
    "end": 155.77,
    "duration": 7.768
  },
  {
    "id": 30,
    "text": "乱世离乱使文人普遍产生生死无常之感，但他们并未沉溺于消极避世，而是选择以建功立业、著书立说对抗流年。",
    "start": 156.355,
    "end": 165.997,
    "duration": 9.642
  },
  {
    "id": 31,
    "text": "曹丕在《典论·论文》中明确提出“年寿有时而尽，荣乐止乎其身……未若文章之无穷”；",
    "start": 166.517,
    "end": 174.383,
    "duration": 7.866
  },
  {
    "id": 32,
    "text": "曹植发出“捐躯赴国难，视死忽如归”的慷慨誓言。",
    "start": 174.903,
    "end": 179.507,
    "duration": 4.604
  },
  {
    "id": 33,
    "text": "这种于悲凉中激荡英雄气概的精神品格，赋予了建安文学超越时代的崇高美感。",
    "start": 180.027,
    "end": 186.749,
    "duration": 6.722
  },
  {
    "id": 34,
    "text": "第四，树立古典诗歌刚健风范，成为后代革新浮靡文风的精神旗帜。",
    "start": 187.354,
    "end": 192.663,
    "duration": 5.309
  },
  {
    "id": 35,
    "text": "建安风骨以其刚健明朗的骨力与充沛真情，成为后世历代诗歌革新运动的重要旗帜。",
    "start": 193.183,
    "end": 199.827,
    "duration": 6.644
  },
  {
    "id": 36,
    "text": "南朝齐梁时期诗歌趋于声色浮艳，",
    "start": 200.347,
    "end": 202.97,
    "duration": 2.623
  },
  {
    "id": 37,
    "text": "初唐陈子昂在《修竹篇序》中疾呼“汉魏风骨，晋宋莫传”，借建安传统扫除齐梁余习；",
    "start": 203.34,
    "end": 210.388,
    "duration": 7.048
  },
  {
    "id": 38,
    "text": "李白亦在《宣州谢朓楼饯别校书叔云》中高唱“蓬莱文章建安骨”。",
    "start": 210.908,
    "end": 216.303,
    "duration": 5.395
  },
  {
    "id": 39,
    "text": "建安风骨所确立的真情实感、刚健气韵与时代担当，",
    "start": 216.823,
    "end": 220.839,
    "duration": 4.016
  },
  {
    "id": 40,
    "text": "成为中国古典诗歌史上薪火相传的宝贵精神财富。",
    "start": 221.209,
    "end": 225.181,
    "duration": 3.972
  },
  {
    "id": 41,
    "text": "综上所述，建安风骨在汉末乱世阵痛中实现了个体生命觉醒与济世抱负的统一，",
    "start": 225.701,
    "end": 232.379,
    "duration": 6.678
  },
  {
    "id": 42,
    "text": "呈现出慷慨悲凉而爽朗刚健的审美气象。",
    "start": 232.824,
    "end": 236.023,
    "duration": 3.199
  },
  {
    "id": 43,
    "text": "“三曹”立足五言古诗与乐府旧题推陈出新，",
    "start": 236.543,
    "end": 240.19,
    "duration": 3.647
  },
  {
    "id": 44,
    "text": "推动文人诗歌告别汉代经学附庸而走向自觉；其重真情、尚风力的诗学传统，",
    "start": 240.56,
    "end": 246.797,
    "duration": 6.237
  },
  {
    "id": 45,
    "text": "成为陈子昂、李白等后代诗人革除浮靡诗风的精神典范。",
    "start": 247.167,
    "end": 252.049,
    "duration": 4.882
  }
]