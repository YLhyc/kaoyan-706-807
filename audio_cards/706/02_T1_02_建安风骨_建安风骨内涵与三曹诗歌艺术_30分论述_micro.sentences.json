[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "先说清何谓“风”“骨”与曹丕“文气”理论，",
    "start": 0.0,
    "end": 3.68,
    "duration": 3.68
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再落到曹操、曹丕、曹植三父子各自艺术风貌与体裁突破，",
    "start": 3.729,
    "end": 8.249,
    "duration": 4.52
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "继而深挖乱世背后“惜年寿更欲不朽”的悲壮精神，",
    "start": 8.819,
    "end": 12.939,
    "duration": 4.12
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最终指向陈子昂、李白高举“建安骨”革除浮靡的历史回响。",
    "start": 13.389,
    "end": 18.189,
    "duration": 4.8
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "汉末魏初乱世阵痛中迸发出的昂扬志气与深沉忧患，造就“建安风骨”。",
    "start": 18.719,
    "end": 24.799,
    "duration": 6.08
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "鲁迅称之为“文学的自觉时代”，刘勰《文心雕龙·时序》赞“志深而笔长，",
    "start": 25.249,
    "end": 30.889,
    "duration": 5.64
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "故梗概而多气也”。",
    "start": 31.419,
    "end": 32.739,
    "duration": 1.32
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · “风”“骨”交融与“文以气为主”",
    "start": 33.189,
    "end": 35.989,
    "duration": 2.8
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "“风”指充沛真挚的思想感情，“骨”指事理逻辑与刚健挺拔的文辞骨力。",
    "start": 36.439,
    "end": 41.959,
    "duration": 5.52
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "曹丕《典论·论文》提出“文以气为主，气之清浊有体，不可力强而致”，",
    "start": 42.409,
    "end": 48.009,
    "duration": 5.6
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "摆脱汉儒经学附庸，直抒胸臆而悲壮不消沉、刚健不浅薄。",
    "start": 48.459,
    "end": 53.499,
    "duration": 5.04
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · “三曹”并起与五言七言体裁推进",
    "start": 53.949,
    "end": 57.869,
    "duration": 3.92
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "“古直悲凉”，借乐府旧题写时事：《蒿里行》“白骨露于野，",
    "start": 58.399,
    "end": 63.039,
    "duration": 4.64
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "千里无鸡鸣”，《短歌行》“对酒当歌，人生几何”，气象雄浑；",
    "start": 63.489,
    "end": 68.449,
    "duration": 4.96
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "“便娟婉约”，《燕歌行》为现存最早完整文人七言诗，深婉流丽；",
    "start": 68.899,
    "end": 74.179,
    "duration": 5.28
  },
  {
    "id": "sec1_step2_c0",
    "dom_key": "sec1_step2_c0",
    "text": "“骨气奇高，词采华茂”，前期《白马篇》咏游侠报国，",
    "start": 74.709,
    "end": 79.429,
    "duration": 4.72
  },
  {
    "id": "sec1_step2_c1",
    "dom_key": "sec1_step2_c1",
    "text": "后期《赠白马王彪》抒猜忌悲愤，情辞并茂，代表建安最高成就。",
    "start": 79.959,
    "end": 84.919,
    "duration": 4.96
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 深沉忧生而奋发立功的济世品格",
    "start": 85.369,
    "end": 89.089,
    "duration": 3.72
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "清醒体认生命短促而不沉溺消极避世，选择建功立业、著书立说对抗流年。",
    "start": 89.539,
    "end": 95.619,
    "duration": 6.08
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "曹丕《典论·论文》论“年寿有时而尽……未若文章之无穷”；",
    "start": 96.069,
    "end": 100.829,
    "duration": 4.76
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "曹植誓言“捐躯赴国难，视死忽如归”，于悲凉中激荡崇高英雄气概。",
    "start": 101.279,
    "end": 107.239,
    "duration": 5.96
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 树立后代革新浮靡诗风的精神旗帜",
    "start": 107.769,
    "end": 111.609,
    "duration": 3.84
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "针对南朝齐梁浮艳声色，初唐陈子昂《修竹篇序》疾呼“汉魏风骨，晋宋莫传”；",
    "start": 112.059,
    "end": 118.299,
    "duration": 6.24
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "盛唐李白高唱“蓬莱文章建安骨”；",
    "start": 118.749,
    "end": 121.509,
    "duration": 2.76
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "真情实感与刚健气韵成为古典诗歌薪火相传的宝贵财富。",
    "start": 121.959,
    "end": 126.599,
    "duration": 4.64
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "建安风骨在乱世中统一了生命觉醒与济世抱负；",
    "start": 127.049,
    "end": 130.889,
    "duration": 3.84
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "“三曹”推动五言古诗与文人乐府自觉独立，",
    "start": 131.339,
    "end": 134.699,
    "duration": 3.36
  },
  {
    "id": "concl_c2",
    "dom_key": "concl_c2",
    "text": "其重真情、尚风力传统成为陈子昂、李白革除浮靡诗风的精神典范。",
    "start": 135.149,
    "end": 140.909,
    "duration": 5.76
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅称建安为“文学的自觉时代”；",
    "start": 141.359,
    "end": 144.799,
    "duration": 3.44
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "刘勰《文心雕龙》赞“志深而笔长，故梗概而多气也”；",
    "start": 145.329,
    "end": 149.209,
    "duration": 3.88
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "曹丕《燕歌行》为现存最早完整文人七言诗。",
    "start": 149.659,
    "end": 153.299,
    "duration": 3.64
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 鲁迅与刘勰如何界定建安文学的历史地位？",
    "start": 153.749,
    "end": 158.789,
    "duration": 5.04
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② “三曹”各自风格评语、突破体裁与代表作各是什么？",
    "start": 159.239,
    "end": 164.719,
    "duration": 5.48
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 曹丕“文章不朽”与陈子昂《修竹篇序》有何呼应？",
    "start": 165.169,
    "end": 170.329,
    "duration": 5.16
  }
]