[
  {
    "id": 1,
    "text": "柳永是北宋词坛由小令走向慢词的划时代关键人物，",
    "start": 0.08,
    "end": 4.88,
    "duration": 4.8
  },
  {
    "id": 2,
    "text": "被宋代叶梦得在《避暑录话》中赞誉为“凡有井水饮处，",
    "start": 4.88,
    "end": 9.52,
    "duration": 4.64
  },
  {
    "id": 3,
    "text": "皆能歌柳词”。",
    "start": 9.52,
    "end": 10.72,
    "duration": 1.2
  },
  {
    "id": 4,
    "text": "在北宋城市经济繁荣与市民阶层崛起的历史背景下，",
    "start": 10.72,
    "end": 14.96,
    "duration": 4.24
  },
  {
    "id": 5,
    "text": "柳永科举屡挫，自称“奉旨填词柳三变”，",
    "start": 14.96,
    "end": 18.64,
    "duration": 3.68
  },
  {
    "id": 6,
    "text": "长期流连于市井勾栏。",
    "start": 18.64,
    "end": 20.32,
    "duration": 1.68
  },
  {
    "id": 7,
    "text": "他将毕生才情倾注于民间词曲，彻底打破了晚唐五代以来文人词专事花间令词的狭隘传统。",
    "start": 20.64,
    "end": 28.88,
    "duration": 8.24
  },
  {
    "id": 8,
    "text": "柳永从体制调式、表现手法、题材风貌与语言质感四个维度进行了全方位开拓，",
    "start": 28.88,
    "end": 35.92,
    "duration": 7.04
  },
  {
    "id": 9,
    "text": "成为宋词演进史上承前启后的巨擘。",
    "start": 35.92,
    "end": 39.36,
    "duration": 3.44
  },
  {
    "id": 10,
    "text": "首先，在体裁体制上，柳永大规模创制长调慢词，",
    "start": 39.36,
    "end": 43.92,
    "duration": 4.56
  },
  {
    "id": 11,
    "text": "终结了小令一统天下的单一格局。",
    "start": 43.92,
    "end": 46.48,
    "duration": 2.56
  },
  {
    "id": 12,
    "text": "晚唐五代词作绝大多数为五六十字以内的小令，",
    "start": 46.72,
    "end": 50.56,
    "duration": 3.84
  },
  {
    "id": 13,
    "text": "容量狭促，难以承载复杂的社会现实。",
    "start": 50.56,
    "end": 53.6,
    "duration": 3.04
  },
  {
    "id": 14,
    "text": "柳永通晓音律，充分利用民间教坊新声，",
    "start": 53.6,
    "end": 56.88,
    "duration": 3.28
  },
  {
    "id": 15,
    "text": "翻改或创制了一百余个慢词调式。",
    "start": 56.88,
    "end": 59.76,
    "duration": 2.88
  },
  {
    "id": 16,
    "text": "他拓展了长调慢词的篇幅与体制，使慢词由边缘杂调上升为主流词体。",
    "start": 59.76,
    "end": 65.44,
    "duration": 5.68
  },
  {
    "id": 17,
    "text": "《雨霖铃》《八声甘州》《望海潮》等名作皆为长调范式。",
    "start": 65.6,
    "end": 69.715,
    "duration": 4.115
  },
  {
    "id": 18,
    "text": "这种体制扩容极大扩展了词的时空容量与思想跨度，",
    "start": 69.715,
    "end": 74.479,
    "duration": 4.764
  },
  {
    "id": 19,
    "text": "为宋词由案头浅唱迈向宏大抒情奠定了物质载体。",
    "start": 74.479,
    "end": 79.027,
    "duration": 4.548
  },
  {
    "id": 20,
    "text": "其次，在艺术手法上，柳永创造性地开拓了以铺叙、",
    "start": 79.027,
    "end": 83.358,
    "duration": 4.331
  },
  {
    "id": 21,
    "text": "羁旅行役与融情入景为核心的表现机制。",
    "start": 83.358,
    "end": 87.04,
    "duration": 3.682
  },
  {
    "id": 22,
    "text": "传统小令讲究含蓄蕴藉与意象并置，",
    "start": 87.12,
    "end": 90.64,
    "duration": 3.52
  },
  {
    "id": 23,
    "text": "柳永则变含蓄为铺叙，采用章法井然的时空顺叙与波澜起伏的结构。",
    "start": 90.64,
    "end": 96.96,
    "duration": 6.32
  },
  {
    "id": 24,
    "text": "《雨霖铃》铺叙长亭离别，先以“寒蝉凄切，",
    "start": 96.96,
    "end": 100.72,
    "duration": 3.76
  },
  {
    "id": 25,
    "text": "对长亭晚，骤雨初歇”渲染环境，继以“执手相看泪眼，",
    "start": 100.72,
    "end": 105.52,
    "duration": 4.8
  },
  {
    "id": 26,
    "text": "竟无语凝噎”白描情态，最后以“便纵有千种风情，",
    "start": 105.52,
    "end": 110.08,
    "duration": 4.56
  },
  {
    "id": 27,
    "text": "更与何人说”虚设别后情境，层层顿挫。",
    "start": 110.08,
    "end": 113.6,
    "duration": 3.52
  },
  {
    "id": 28,
    "text": "苏轼极赞其《八声甘州》中“渐霜风凄紧，",
    "start": 113.92,
    "end": 117.6,
    "duration": 3.68
  },
  {
    "id": 29,
    "text": "关河冷落，残照当楼”，认为其“不减唐人高处”，",
    "start": 117.6,
    "end": 122.0,
    "duration": 4.4
  },
  {
    "id": 30,
    "text": "足见其景中融情、苍凉博大的笔力。",
    "start": 122.0,
    "end": 125.04,
    "duration": 3.04
  },
  {
    "id": 31,
    "text": "再次，在题材与语言上，柳永实现了审美趣味的市井化转向，",
    "start": 125.336,
    "end": 130.536,
    "duration": 5.2
  },
  {
    "id": 32,
    "text": "开创了世俗市民词风。",
    "start": 130.536,
    "end": 132.616,
    "duration": 2.08
  },
  {
    "id": 33,
    "text": "他突破了士大夫文人歌儿舞女的规阁视角，",
    "start": 132.616,
    "end": 136.136,
    "duration": 3.52
  },
  {
    "id": 34,
    "text": "大胆将市井风情、青楼歌妓与下层市民生活写入词篇。",
    "start": 136.136,
    "end": 141.176,
    "duration": 5.04
  },
  {
    "id": 35,
    "text": "《望海潮》以“东南形胜，三吴都会，",
    "start": 141.176,
    "end": 144.456,
    "duration": 3.28
  },
  {
    "id": 36,
    "text": "钱塘自古繁华”的铺张彩笔，全景描摹了北宋杭州的物阜民丰。",
    "start": 144.456,
    "end": 149.896,
    "duration": 5.44
  },
  {
    "id": 37,
    "text": "在语言上，他大量吸收市井生动的白话口语，",
    "start": 150.296,
    "end": 153.736,
    "duration": 3.44
  },
  {
    "id": 38,
    "text": "如《定风波》中“自念晏婴轻巧，计较无凭。",
    "start": 153.736,
    "end": 157.256,
    "duration": 3.52
  },
  {
    "id": 39,
    "text": "早知恁么，悔最初、不教恁去”，语言平易晓畅、",
    "start": 157.256,
    "end": 161.176,
    "duration": 3.92
  },
  {
    "id": 40,
    "text": "贴近生活，展现出真率动人的市民心声。",
    "start": 161.176,
    "end": 164.376,
    "duration": 3.2
  },
  {
    "id": 41,
    "text": "最后，柳永对词体发展的历史贡献具有奠基性与开创性意义。",
    "start": 164.376,
    "end": 169.416,
    "duration": 5.04
  },
  {
    "id": 42,
    "text": "他不仅为长调慢词建立了规范典范，",
    "start": 169.496,
    "end": 172.456,
    "duration": 2.96
  },
  {
    "id": 43,
    "text": "更其铺叙体制与宏阔笔墨，直接启迪了苏轼、",
    "start": 172.456,
    "end": 176.616,
    "duration": 4.16
  },
  {
    "id": 44,
    "text": "辛弃疾豪放词风的形成。",
    "start": 176.616,
    "end": 178.776,
    "duration": 2.16
  },
  {
    "id": 45,
    "text": "他在词史上完成的文体转型与普及，",
    "start": 178.776,
    "end": 181.736,
    "duration": 2.96
  },
  {
    "id": 46,
    "text": "使宋词真正成为代表两宋一代文学的独立巅峰文体，",
    "start": 181.736,
    "end": 186.216,
    "duration": 4.48
  },
  {
    "id": 47,
    "text": "其文学史地位不可磨灭。",
    "start": 186.216,
    "end": 188.136,
    "duration": 1.92
  }
]