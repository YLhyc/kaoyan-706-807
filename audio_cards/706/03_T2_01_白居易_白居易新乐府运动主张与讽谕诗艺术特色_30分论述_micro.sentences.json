[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "白居易·新乐府运动主张与讽谕诗艺术特色",
    "start": 0.134,
    "end": 3.701,
    "duration": 3.567
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "理论→题材→语言→格局四层步步推进：先在《与元九书》立定“合为时合为事”总纲，",
    "start": 4.29,
    "end": 12.14,
    "duration": 7.851
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再实践“即事名篇”创《新乐府》《秦中吟》写卖炭刈麦，",
    "start": 12.493,
    "end": 16.958,
    "duration": 4.465
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "进而在《新乐府序》提出通俗浅白与对比讽谕标准，最后把讽谕诗置为四类之首推动中唐写实诗潮。",
    "start": 17.059,
    "end": 25.86,
    "duration": 8.801
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "白居易是中唐新乐府运动领袖，承《诗经》风雅与杜甫即事名篇传统，",
    "start": 26.434,
    "end": 32.357,
    "duration": 5.923
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "力主恢复诗歌美刺讽谕政教功能以反映民生疾苦。",
    "start": 32.58,
    "end": 36.967,
    "duration": 4.387
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 确立“合为时而著、合为事而作”纲领",
    "start": 37.541,
    "end": 41.277,
    "duration": 3.736
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "《与元九书》提出“文章合为时而著，歌诗合为事而作”，提出“根情，苗言，华声，实义”有机观；",
    "start": 41.864,
    "end": 50.535,
    "duration": 8.671
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "强调“补察时政，泄导人情”，扭转齐梁及大历吟风弄月流弊，引回直面民生正途。",
    "start": 51.121,
    "end": 59.245,
    "duration": 8.124
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 践行“即事名篇，无复依傍”原则",
    "start": 59.832,
    "end": 63.282,
    "duration": 3.45
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "摆脱古题旧壳，《新乐府》五十首与《秦中吟》十首专咏一事，“首句标其目，卒章显其志”；",
    "start": 63.869,
    "end": 72.019,
    "duration": 8.15
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《卖炭翁》“心忧炭贱愿天寒”写矛盾心理与宫市横暴；《观刈麦》“念此私自愧，尽日不能忘”深切自省同情。",
    "start": 72.593,
    "end": 82.501,
    "duration": 9.908
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · “其辞质而径，其言直而切”通俗诗风",
    "start": 83.088,
    "end": 86.993,
    "duration": 3.905
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《新乐府序》定下质径、直切、核实、顺肆四准，浅显口语、免僻典、利播传；",
    "start": 87.567,
    "end": 95.574,
    "duration": 8.007
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《轻肥》以白描对比映衬：“樽罍溢九酝，水陆罗八珍”直对“是岁江南旱，衢州人食人”，震撼人心。",
    "start": 96.148,
    "end": 104.975,
    "duration": 8.827
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 以讽谕诗重塑品类、领起中唐写实潮",
    "start": 105.562,
    "end": 109.701,
    "duration": 4.14
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "将诗集分“讽谕”“闲适”“感伤”“杂律”四类并置讽谕居首，凸显“惟歌生民病”抱负；",
    "start": 110.275,
    "end": 118.464,
    "duration": 8.189
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "虽有时偏重说教稍损含蓄，却带动元稹、张籍、王建群起创作，掀起中唐写实诗潮。",
    "start": 119.038,
    "end": 127.943,
    "duration": 8.905
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "白居易以“合为时为事”为纲，借通俗叙事直击民生疾苦；",
    "start": 128.53,
    "end": 133.66,
    "duration": 5.129
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "虽部分讽谕诗略显直露说教，但其发扬杜甫精神并带动元稹、张籍等，在中唐高扬现实主义传统。",
    "start": 133.908,
    "end": 142.956,
    "duration": 9.049
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：白居易主张“文章合为时而著，歌诗合为事而作”，理论文献是《与元九书》和《新乐府序》；",
    "start": 143.53,
    "end": 151.758,
    "duration": 8.228
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "诗集分“讽谕、闲适、感伤、杂律”四类。",
    "start": 152.059,
    "end": 155.652,
    "duration": 3.593
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背诵《与元九书》核心主张与《新乐府序》四标准？",
    "start": 156.226,
    "end": 161.485,
    "duration": 5.259
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 《卖炭翁》《观刈麦》《轻肥》各体现新乐府哪些写实与对比技巧？",
    "start": 162.059,
    "end": 168.881,
    "duration": 6.822
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 白居易诗集“四分法”与同时代元稹/张籍/王建的群体意义？",
    "start": 169.468,
    "end": 176.225,
    "duration": 6.757
  }
]