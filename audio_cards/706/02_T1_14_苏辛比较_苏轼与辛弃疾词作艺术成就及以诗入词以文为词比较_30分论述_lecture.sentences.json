[
  {
    "id": 1,
    "text": "试论苏轼与辛弃疾词作艺术成就及“以诗入词”与“以文为词”之异同。",
    "start": 0.16,
    "end": 6.586,
    "duration": 6.426
  },
  {
    "id": 2,
    "text": "苏轼与辛弃疾是宋代豪放词派双峰并峙的两大大家，",
    "start": 7.041,
    "end": 11.852,
    "duration": 4.811
  },
  {
    "id": 3,
    "text": "共同将宋词推向文学史高峰。",
    "start": 12.267,
    "end": 14.906,
    "duration": 2.639
  },
  {
    "id": 4,
    "text": "面对“词为艳科”的旧习，苏轼以“以诗为词”拓宽词境，",
    "start": 15.272,
    "end": 19.819,
    "duration": 4.547
  },
  {
    "id": 5,
    "text": "辛弃疾以“以文为词”深化变革，二人一承一继，",
    "start": 20.173,
    "end": 24.784,
    "duration": 4.611
  },
  {
    "id": 6,
    "text": "使词挣脱樽前娱人的局限，成为与诗并立的抒情言志之体。",
    "start": 25.061,
    "end": 30.679,
    "duration": 5.618
  },
  {
    "id": 7,
    "text": "周济在《宋四家词选》中评道：“苏、辛并称。",
    "start": 31.516,
    "end": 35.364,
    "duration": 3.848
  },
  {
    "id": 8,
    "text": "东坡天趣独到处，殆成绝诣，而苦不经意，完璧甚少。",
    "start": 35.991,
    "end": 40.921,
    "duration": 4.93
  },
  {
    "id": 9,
    "text": "稼轩则沉着痛快，有辙可循。",
    "start": 41.546,
    "end": 44.112,
    "duration": 2.566
  },
  {
    "id": 10,
    "text": "”二人在词史贡献与创作风格上的异同，主要体现在以下四个方面：",
    "start": 44.537,
    "end": 49.282,
    "duration": 4.745
  },
  {
    "id": 11,
    "text": "第一，革除词为艳科传统，由“以诗为词”递进至“以文为词”。",
    "start": 49.92,
    "end": 55.844,
    "duration": 5.924
  },
  {
    "id": 12,
    "text": "苏辛共同的历史功绩在于打破声律与题材对词体的束缚，",
    "start": 56.212,
    "end": 60.999,
    "duration": 4.787
  },
  {
    "id": 13,
    "text": "而在革新路径上层层递进。",
    "start": 61.458,
    "end": 63.6,
    "duration": 2.142
  },
  {
    "id": 14,
    "text": "苏轼确立“诗词一体”之说，称词“盖诗之裔”，",
    "start": 64.111,
    "end": 68.516,
    "duration": 4.405
  },
  {
    "id": 15,
    "text": "力主“自是一家”，广用标题小序，将诗歌的思想立意、",
    "start": 69.024,
    "end": 73.809,
    "duration": 4.785
  },
  {
    "id": 16,
    "text": "题材范围与抒情手法移植入词，使词走向诗意化与哲理化；",
    "start": 74.085,
    "end": 79.097,
    "duration": 5.012
  },
  {
    "id": 17,
    "text": "辛弃疾则在苏轼基础上推进“以文为词”，",
    "start": 79.504,
    "end": 82.819,
    "duration": 3.315
  },
  {
    "id": 18,
    "text": "进一步打破对称句式的限制，",
    "start": 83.239,
    "end": 85.271,
    "duration": 2.032
  },
  {
    "id": 19,
    "text": "把先秦两汉散文及辞赋的章法结构、",
    "start": 85.648,
    "end": 88.476,
    "duration": 2.828
  },
  {
    "id": 20,
    "text": "问答设论与古文句法融入词中，",
    "start": 88.934,
    "end": 91.695,
    "duration": 2.761
  },
  {
    "id": 21,
    "text": "使词兼具散文化的纵横气势与严密逻辑，",
    "start": 92.087,
    "end": 95.604,
    "duration": 3.517
  },
  {
    "id": 22,
    "text": "大幅拓展了词的艺术容量。",
    "start": 95.962,
    "end": 97.773,
    "duration": 1.811
  },
  {
    "id": 23,
    "text": "第二，立足不同时代际遇，分呈清旷超然与英雄悲壮的情感底色。",
    "start": 98.458,
    "end": 103.887,
    "duration": 5.429
  },
  {
    "id": 24,
    "text": "时代境遇与人生身份的差异塑造了二人不同的词风质感。",
    "start": 104.36,
    "end": 108.729,
    "duration": 4.369
  },
  {
    "id": 25,
    "text": "苏轼生活在北宋承平时期，矛盾主要在于仕途升降与党争挫败。",
    "start": 109.387,
    "end": 114.851,
    "duration": 5.464
  },
  {
    "id": 26,
    "text": "经历乌台诗案与黄州贬谪后，他凭借佛道哲思超越现实困顿，",
    "start": 115.401,
    "end": 120.717,
    "duration": 5.316
  },
  {
    "id": 27,
    "text": "词风清雄旷达：在定慧院守持“拣尽寒枝不肯栖”的孤高，",
    "start": 121.018,
    "end": 126.963,
    "duration": 5.945
  },
  {
    "id": 28,
    "text": "在赤壁矶头以“一尊还酹江月”排遣得失，",
    "start": 127.151,
    "end": 131.095,
    "duration": 3.944
  },
  {
    "id": 29,
    "text": "在沙湖道中升华为“也无风雨也无晴”的超然；",
    "start": 131.501,
    "end": 135.494,
    "duration": 3.993
  },
  {
    "id": 30,
    "text": "辛弃疾则身处南宋偏安、中原沦丧的民族危局，",
    "start": 136.045,
    "end": 140.001,
    "duration": 3.956
  },
  {
    "id": 31,
    "text": "身为沙场豪杰而备受猜忌排挤，报国无门而“把吴钩看了，",
    "start": 140.453,
    "end": 145.972,
    "duration": 5.519
  },
  {
    "id": 32,
    "text": "阑干拍遍”，",
    "start": 146.22,
    "end": 147.102,
    "duration": 0.882
  },
  {
    "id": 33,
    "text": "在《破阵子》中由梦回吹角连营骤转“可怜白发生”，",
    "start": 147.286,
    "end": 151.651,
    "duration": 4.365
  },
  {
    "id": 34,
    "text": "词风充溢着英雄失路的沉郁悲壮。",
    "start": 151.922,
    "end": 154.937,
    "duration": 3.015
  },
  {
    "id": 35,
    "text": "第三，同擅使事用典，分呈浑化无痕与用经用史讽世之艺术风貌。",
    "start": 155.548,
    "end": 161.388,
    "duration": 5.84
  },
  {
    "id": 36,
    "text": "在用典手法上，苏轼以作诗之法入词，",
    "start": 162.001,
    "end": 164.979,
    "duration": 2.978
  },
  {
    "id": 37,
    "text": "善于点化历史典故而浑然天成、如水中着盐。",
    "start": 165.28,
    "end": 169.064,
    "duration": 3.784
  },
  {
    "id": 38,
    "text": "如《江城子·密州出猎》中随手化用孙权射虎与冯唐持节两典，",
    "start": 169.559,
    "end": 174.719,
    "duration": 5.16
  },
  {
    "id": 39,
    "text": "抒发报国豪情而全无堆砌之感；",
    "start": 175.128,
    "end": 177.828,
    "duration": 2.7
  },
  {
    "id": 40,
    "text": "辛弃疾则独创“用经用史”之法，",
    "start": 178.194,
    "end": 180.907,
    "duration": 2.713
  },
  {
    "id": 41,
    "text": "刘辰翁赞其“牵雅颂入郑卫”，",
    "start": 181.189,
    "end": 183.658,
    "duration": 2.469
  },
  {
    "id": 42,
    "text": "将经史典故化为政治讽喻的利器。",
    "start": 184.082,
    "end": 186.704,
    "duration": 2.622
  },
  {
    "id": 43,
    "text": "在《永遇乐·京口北固亭怀古》中，",
    "start": 187.003,
    "end": 189.664,
    "duration": 2.661
  },
  {
    "id": 44,
    "text": "全词不足百字密集连用孙权、刘裕、刘义隆、",
    "start": 189.764,
    "end": 193.607,
    "duration": 3.843
  },
  {
    "id": 45,
    "text": "佛狸祠与廉颇五典，借古讽今，切中南宋草率北伐的时弊，",
    "start": 193.786,
    "end": 198.615,
    "duration": 4.829
  },
  {
    "id": 46,
    "text": "表现出强烈的现实批判力度。",
    "start": 198.796,
    "end": 200.931,
    "duration": 2.135
  },
  {
    "id": 47,
    "text": "第四，共筑宋代豪放词派基石，树立与五七言古诗并峙的词史地位。",
    "start": 201.627,
    "end": 207.423,
    "duration": 5.796
  },
  {
    "id": 48,
    "text": "苏轼与辛弃疾均在豪放主调之外兼备多样的词风造诣。",
    "start": 207.668,
    "end": 212.3,
    "duration": 4.632
  },
  {
    "id": 49,
    "text": "苏词兼有《江城子》“十年生死两茫茫”的深沉悼亡与清幽婉转；",
    "start": 212.549,
    "end": 217.622,
    "duration": 5.073
  },
  {
    "id": 50,
    "text": "辛词亦兼有《清平乐·村居》的田园天真与谐谑自嘲。",
    "start": 218.023,
    "end": 222.387,
    "duration": 4.364
  },
  {
    "id": 51,
    "text": "苏轼为词坛指明了向上一路，",
    "start": 222.655,
    "end": 224.925,
    "duration": 2.27
  },
  {
    "id": 52,
    "text": "辛弃疾则率领南宋辛派词人将爱国悲歌推向高峰。",
    "start": 225.398,
    "end": 229.947,
    "duration": 4.549
  },
  {
    "id": 53,
    "text": "苏辛并称，共同奠定了豪放一派在宋词史上的崇高地位。",
    "start": 230.264,
    "end": 235.189,
    "duration": 4.925
  }
]