[
  {
    "id": 1,
    "text": "试论苏轼与辛弃疾词作艺术成就及“以诗入词”与“以文为词”之异同。",
    "start": 0.16,
    "end": 6.596,
    "duration": 6.436
  },
  {
    "id": 2,
    "text": "苏轼与辛弃疾是宋代豪放词派双峰并峙的两大大家，共同将宋词推向文学史高峰。",
    "start": 7.096,
    "end": 14.96,
    "duration": 7.864
  },
  {
    "id": 3,
    "text": "面对“词为艳科”的旧习，苏轼以“以诗为词”拓宽词境，辛弃疾以“以文为词”深化变革，",
    "start": 15.46,
    "end": 23.293,
    "duration": 7.833
  },
  {
    "id": 4,
    "text": "二人一承一继，使词挣脱樽前娱人的局限，成为与诗并立的抒情言志之体。",
    "start": 23.765,
    "end": 30.877,
    "duration": 7.112
  },
  {
    "id": 5,
    "text": "周济在《宋四家词选》中评道：",
    "start": 31.704,
    "end": 34.652,
    "duration": 2.948
  },
  {
    "id": 6,
    "text": "“苏、辛并称。东坡天趣独到处，殆成绝诣，而苦不经意，完璧甚少。稼轩则沉着痛快，有辙可循。”",
    "start": 35.002,
    "end": 44.535,
    "duration": 9.533
  },
  {
    "id": 7,
    "text": "二人在词史贡献与创作风格上的异同，主要体现在以下四个方面：",
    "start": 45.035,
    "end": 49.796,
    "duration": 4.761
  },
  {
    "id": 8,
    "text": "第一，革除词为艳科传统，由“以诗为词”递进至“以文为词”。",
    "start": 50.438,
    "end": 56.372,
    "duration": 5.934
  },
  {
    "id": 9,
    "text": "苏辛共同的历史功绩在于打破声律与题材对词体的束缚，而在革新路径上层层递进。",
    "start": 56.872,
    "end": 64.27,
    "duration": 7.398
  },
  {
    "id": 10,
    "text": "苏轼确立“诗词一体”之说，称词“盖诗之裔”，力主“自是一家”，广用标题小序，",
    "start": 64.771,
    "end": 72.713,
    "duration": 7.942
  },
  {
    "id": 11,
    "text": "将诗歌的思想立意、题材范围与抒情手法移植入词，使词走向诗意化与哲理化；",
    "start": 73.063,
    "end": 79.839,
    "duration": 6.776
  },
  {
    "id": 12,
    "text": "辛弃疾则在苏轼基础上推进“以文为词”，进一步打破对称句式的限制，",
    "start": 80.339,
    "end": 86.116,
    "duration": 5.777
  },
  {
    "id": 13,
    "text": "把先秦两汉散文及辞赋的章法结构、问答设论与古文句法融入词中，",
    "start": 86.483,
    "end": 92.54,
    "duration": 6.057
  },
  {
    "id": 14,
    "text": "使词兼具散文化的纵横气势与严密逻辑，大幅拓展了词的艺术容量。",
    "start": 92.922,
    "end": 98.618,
    "duration": 5.696
  },
  {
    "id": 15,
    "text": "第二，立足不同时代际遇，分呈清旷超然与英雄悲壮的情感底色。",
    "start": 99.293,
    "end": 104.715,
    "duration": 5.422
  },
  {
    "id": 16,
    "text": "时代境遇与人生身份的差异塑造了二人不同的词风质感。",
    "start": 105.215,
    "end": 109.592,
    "duration": 4.377
  },
  {
    "id": 17,
    "text": "苏轼生活在北宋承平时期，矛盾主要在于仕途升降与党争挫败。",
    "start": 110.242,
    "end": 115.716,
    "duration": 5.474
  },
  {
    "id": 18,
    "text": "经历乌台诗案与黄州贬谪后，他凭借佛道哲思超越现实困顿，",
    "start": 116.256,
    "end": 121.582,
    "duration": 5.326
  },
  {
    "id": 19,
    "text": "词风清雄旷达：在定慧院守持“拣尽寒枝不肯栖”的孤高，",
    "start": 121.932,
    "end": 127.886,
    "duration": 5.954
  },
  {
    "id": 20,
    "text": "在赤壁矶头以“一尊还酹江月”排遣得失，在沙湖道中升华为“也无风雨也无晴”的超然；",
    "start": 128.279,
    "end": 136.417,
    "duration": 8.138
  },
  {
    "id": 21,
    "text": "辛弃疾则身处南宋偏安、中原沦丧的民族危局，身为沙场豪杰而备受猜忌排挤，",
    "start": 136.959,
    "end": 144.283,
    "duration": 7.324
  },
  {
    "id": 22,
    "text": "报国无门而“把吴钩看了，阑干拍遍”，",
    "start": 144.846,
    "end": 148.026,
    "duration": 3.18
  },
  {
    "id": 23,
    "text": "在《破阵子》中由梦回吹角连营骤转“可怜白发生”，词风充溢着英雄失路的沉郁悲壮。",
    "start": 148.376,
    "end": 156.037,
    "duration": 7.661
  },
  {
    "id": 24,
    "text": "第三，同擅使事用典，分呈浑化无痕与用经用史讽世之艺术风貌。",
    "start": 156.638,
    "end": 162.488,
    "duration": 5.85
  },
  {
    "id": 25,
    "text": "在用典手法上，苏轼以作诗之法入词，善于点化历史典故而浑然天成、如水中着盐。",
    "start": 163.091,
    "end": 170.164,
    "duration": 7.073
  },
  {
    "id": 26,
    "text": "如《江城子·密州出猎》中随手化用孙权射虎与冯唐持节两典，抒发报国豪情而全无堆砌之感；",
    "start": 170.664,
    "end": 178.943,
    "duration": 8.279
  },
  {
    "id": 27,
    "text": "辛弃疾则精于“用经用史”之法，",
    "start": 179.443,
    "end": 182.014,
    "duration": 2.571
  },
  {
    "id": 28,
    "text": "刘辰翁赞其“牵雅颂入郑卫”，将经史典故化为政治讽喻的利器。",
    "start": 182.397,
    "end": 187.922,
    "duration": 5.525
  },
  {
    "id": 29,
    "text": "在《永遇乐·京口北固亭怀古》中，全词百余字内密集连用孙权、刘裕、刘义隆、佛狸祠与廉颇五典，",
    "start": 188.422,
    "end": 197.409,
    "duration": 8.987
  },
  {
    "id": 30,
    "text": "借古讽今，切中南宋草率北伐的时弊，表现出强烈的现实批判力度。",
    "start": 197.759,
    "end": 203.28,
    "duration": 5.521
  },
  {
    "id": 31,
    "text": "第四，共筑宋代豪放词派基石，树立与五七言古诗并峙的词史地位。",
    "start": 203.966,
    "end": 209.771,
    "duration": 5.805
  },
  {
    "id": 32,
    "text": "苏轼与辛弃疾均在豪放主调之外兼备多样的词风造诣。",
    "start": 210.271,
    "end": 214.913,
    "duration": 4.642
  },
  {
    "id": 33,
    "text": "苏词兼有《江城子》“十年生死两茫茫”的深沉悼亡与清幽婉转；",
    "start": 215.413,
    "end": 220.474,
    "duration": 5.061
  },
  {
    "id": 34,
    "text": "辛词亦兼有《清平乐·村居》的田园天真与谐谑自嘲。",
    "start": 220.974,
    "end": 225.348,
    "duration": 4.374
  },
  {
    "id": 35,
    "text": "苏轼为词坛指明了向上一路，辛弃疾则率领南宋辛派词人将爱国悲歌推向高峰。",
    "start": 225.848,
    "end": 233.134,
    "duration": 7.286
  },
  {
    "id": 36,
    "text": "苏辛并称，共同奠定了豪放一派在宋词史上的崇高地位。",
    "start": 233.634,
    "end": 238.559,
    "duration": 4.925
  },
  {
    "id": 37,
    "text": "综观苏辛之变，苏轼的“以诗为词”重在突破“词为艳科”藩篱、注入清旷自适的文人胸襟，",
    "start": 239.059,
    "end": 246.57,
    "duration": 7.511
  },
  {
    "id": 38,
    "text": "辛弃疾的“以文为词”则进一步融化经史典故与散文句法，抒写恢复中原的英雄悲慨。",
    "start": 246.92,
    "end": 253.704,
    "duration": 6.784
  },
  {
    "id": 39,
    "text": "二人一承一继、同而不同，彻底拓宽了词体的题材格局与表现力，",
    "start": 254.204,
    "end": 259.353,
    "duration": 5.149
  },
  {
    "id": 40,
    "text": "将宋代豪放词派推向与五、七言诗歌并峙的高度。",
    "start": 259.703,
    "end": 263.85,
    "duration": 4.147
  }
]
