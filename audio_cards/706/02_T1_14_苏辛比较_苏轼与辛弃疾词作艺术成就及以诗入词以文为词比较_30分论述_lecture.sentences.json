[
  {
    "id": 1,
    "text": "试论苏轼与辛弃疾词作艺术成就及“以诗入词”与“以文为词”之异同。",
    "start": 0.0,
    "end": 7.295,
    "duration": 7.295
  },
  {
    "id": 2,
    "text": "苏轼与辛弃疾是宋代词坛豪放词派双峰并峙的两大巨匠，",
    "start": 7.295,
    "end": 10.532,
    "duration": 3.237
  },
  {
    "id": 3,
    "text": "共同代表了宋代词体文学发展的最高成就。",
    "start": 10.532,
    "end": 16.275,
    "duration": 5.743
  },
  {
    "id": 4,
    "text": "面对中晚唐五代以来“词为艳科”的传统藩篱，苏轼开辟道路，",
    "start": 16.275,
    "end": 20.463,
    "duration": 4.188
  },
  {
    "id": 5,
    "text": "推行 “以诗为词”；辛弃疾登峰造极，推展 “以文为词”。",
    "start": 20.463,
    "end": 25.093,
    "duration": 4.63
  },
  {
    "id": 6,
    "text": "二人一承一续，",
    "start": 25.093,
    "end": 27.069,
    "duration": 1.976
  },
  {
    "id": 7,
    "text": "共同推动词体完成了由樽前娱人小道向独立言志抒怀文学的历史性飞跃。",
    "start": 27.069,
    "end": 31.936,
    "duration": 4.867
  },
  {
    "id": 8,
    "text": "刘熙载在 《艺概》 中精辟定评：“东坡词颇似老杜诗，",
    "start": 31.936,
    "end": 37.799,
    "duration": 5.863
  },
  {
    "id": 9,
    "text": "稼轩词颇似左氏《春秋》及《离骚》。",
    "start": 37.799,
    "end": 39.814,
    "duration": 2.015
  },
  {
    "id": 10,
    "text": "” 二人在艺术成就与表现机制上的异同，",
    "start": 39.814,
    "end": 45.819,
    "duration": 6.005
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：",
    "start": 45.819,
    "end": 48.538,
    "duration": 2.719
  },
  {
    "id": 12,
    "text": "第一，在文体解放观念上一脉相承，",
    "start": 48.538,
    "end": 51.814,
    "duration": 3.276
  },
  {
    "id": 13,
    "text": "实现由“以诗为词”向“以文为词”的递进深化。",
    "start": 51.814,
    "end": 56.073,
    "duration": 4.259
  },
  {
    "id": 14,
    "text": "苏辛二人共同的历史功勋在于打破了词调音乐对文学表达的绝对束缚。",
    "start": 56.073,
    "end": 60.256,
    "duration": 4.183
  },
  {
    "id": 15,
    "text": "苏轼确立“诗词一体”之说，指出词是“诗之苗裔”，",
    "start": 60.256,
    "end": 64.673,
    "duration": 4.417
  },
  {
    "id": 16,
    "text": "主张将近体诗的思想立意、题材范围与表现手法全面移植入词，",
    "start": 64.673,
    "end": 69.402,
    "duration": 4.729
  },
  {
    "id": 17,
    "text": "把词从歌女口中解放出来给士大夫案头阅读；",
    "start": 69.402,
    "end": 73.049,
    "duration": 3.647
  },
  {
    "id": 18,
    "text": "辛弃疾在苏轼的基础上更进一步，",
    "start": 73.049,
    "end": 77.008,
    "duration": 3.959
  },
  {
    "id": 19,
    "text": "大胆打破诗歌声律对称的拘束，",
    "start": 77.008,
    "end": 82.363,
    "duration": 5.355
  },
  {
    "id": 20,
    "text": "吸纳先秦两汉散文的论辩说理与古文句法入词。",
    "start": 82.363,
    "end": 85.293,
    "duration": 2.93
  },
  {
    "id": 21,
    "text": "苏轼使词走向诗意化与哲理化，",
    "start": 85.293,
    "end": 86.898,
    "duration": 1.605
  },
  {
    "id": 22,
    "text": "辛弃疾使词走向散文化与史传化，二人层层递进，",
    "start": 86.898,
    "end": 89.749,
    "duration": 2.851
  },
  {
    "id": 23,
    "text": "彻底解放了词体的抒情容量。",
    "start": 89.749,
    "end": 94.328,
    "duration": 4.579
  },
  {
    "id": 24,
    "text": "第二，在时代语境与情感底色上，",
    "start": 94.328,
    "end": 97.099,
    "duration": 2.771
  },
  {
    "id": 25,
    "text": "呈现北宋承平的超然旷达与南宋偏安的英雄悲壮。",
    "start": 97.099,
    "end": 101.902,
    "duration": 4.803
  },
  {
    "id": 26,
    "text": "作家身份与时代际遇的差异深刻塑造了二人的情感质感。",
    "start": 101.902,
    "end": 106.409,
    "duration": 4.507
  },
  {
    "id": 27,
    "text": "苏轼身处北宋承平时期，",
    "start": 106.409,
    "end": 108.712,
    "duration": 2.303
  },
  {
    "id": 28,
    "text": "矛盾主要体现为个人仕途升沉与新旧党争挫折。",
    "start": 108.712,
    "end": 112.54,
    "duration": 3.828
  },
  {
    "id": 29,
    "text": "在乌台诗案牢狱之灾与黄州贬谪绝境中，",
    "start": 112.54,
    "end": 115.42,
    "duration": 2.88
  },
  {
    "id": 30,
    "text": "他凭借佛道哲思超越现实苦难，词风呈现清旷自适：",
    "start": 115.42,
    "end": 118.926,
    "duration": 3.506
  },
  {
    "id": 31,
    "text": "在定慧院坚守 “拣尽寒枝不肯栖” 的孤高，",
    "start": 118.926,
    "end": 123.729,
    "duration": 4.803
  },
  {
    "id": 32,
    "text": "在赤壁矶头以 “一尊还酹江月” 消解得失，",
    "start": 123.729,
    "end": 127.251,
    "duration": 3.522
  },
  {
    "id": 33,
    "text": "最终升华为沙湖道中 “也无风雨也无晴” 的超然；",
    "start": 127.251,
    "end": 133.158,
    "duration": 5.907
  },
  {
    "id": 34,
    "text": "辛弃疾则身处南宋半壁江山沉沦、金兵压境的民族危难时期。",
    "start": 133.158,
    "end": 138.477,
    "duration": 5.319
  },
  {
    "id": 35,
    "text": "作为早年亲率骑兵突袭敌营的沙场将领，",
    "start": 138.477,
    "end": 140.936,
    "duration": 2.459
  },
  {
    "id": 36,
    "text": "他作为“归正人”备受主和派猜忌排挤，报国无门，",
    "start": 140.936,
    "end": 144.234,
    "duration": 3.298
  },
  {
    "id": 37,
    "text": "“把吴钩看了，阑干拍遍”；在 《破阵子》 中，",
    "start": 144.234,
    "end": 150.36,
    "duration": 6.126
  },
  {
    "id": 38,
    "text": "由梦回沙场的雄壮骤然逆转为 “可怜白发生” 的悲凉。",
    "start": 150.36,
    "end": 155.929,
    "duration": 5.569
  },
  {
    "id": 39,
    "text": "苏词偏于哲理旷达，辛词充溢着慷慨悲壮的救亡忠愤。",
    "start": 155.929,
    "end": 161.441,
    "duration": 5.512
  },
  {
    "id": 40,
    "text": "第三，在用典表现艺术上，",
    "start": 161.441,
    "end": 161.991,
    "duration": 0.55
  },
  {
    "id": 41,
    "text": "呈现羚羊挂角的自然化用与融经铸史的密集讽喻。",
    "start": 161.991,
    "end": 165.827,
    "duration": 3.836
  },
  {
    "id": 42,
    "text": "在用典手法上，苏轼以作诗之法入词，",
    "start": 165.827,
    "end": 169.549,
    "duration": 3.722
  },
  {
    "id": 43,
    "text": "善于将历史典故自然点化，做到融化无痕、如水中着盐。",
    "start": 169.549,
    "end": 174.198,
    "duration": 4.649
  },
  {
    "id": 44,
    "text": "在 《江城子·密州出猎》 中，",
    "start": 174.198,
    "end": 177.153,
    "duration": 2.955
  },
  {
    "id": 45,
    "text": "随手化用孙权射虎与冯唐持节两典以抒报国雄心，",
    "start": 177.153,
    "end": 182.476,
    "duration": 5.323
  },
  {
    "id": 46,
    "text": "全无堆砌窒碍之感；",
    "start": 182.476,
    "end": 183.857,
    "duration": 1.381
  },
  {
    "id": 47,
    "text": "辛弃疾则将用典艺术推向了“融经铸史”的极致境界，",
    "start": 183.857,
    "end": 188.146,
    "duration": 4.289
  },
  {
    "id": 48,
    "text": "直接以经史典故作为政治批判的利器。",
    "start": 188.146,
    "end": 193.036,
    "duration": 4.89
  },
  {
    "id": 49,
    "text": "在 《永遇乐·京口北固亭怀古》 中，",
    "start": 193.036,
    "end": 195.696,
    "duration": 2.66
  },
  {
    "id": 50,
    "text": "全词不足百字密集连用孙权、刘裕、刘义隆、",
    "start": 195.696,
    "end": 199.573,
    "duration": 3.877
  },
  {
    "id": 51,
    "text": "佛狸祠与廉颇五典，借古讽今，严正警示盲目北伐的战略危机，",
    "start": 199.573,
    "end": 205.199,
    "duration": 5.626
  },
  {
    "id": 52,
    "text": "将典故的政治批判穿透力发挥到前所未有的高度。",
    "start": 205.199,
    "end": 209.147,
    "duration": 3.948
  },
  {
    "id": 53,
    "text": "第四，共同筑牢宋代豪放词派基石，",
    "start": 209.147,
    "end": 212.757,
    "duration": 3.61
  },
  {
    "id": 54,
    "text": "确立与五七言古诗抗衡的崇高文学史地位。",
    "start": 212.757,
    "end": 216.764,
    "duration": 4.007
  },
  {
    "id": 55,
    "text": "苏轼与辛弃疾非但没有割裂宋词传统，",
    "start": 216.764,
    "end": 220.108,
    "duration": 3.344
  },
  {
    "id": 56,
    "text": "反而在豪放主调之外皆兼备高超的多样化艺术造诣。",
    "start": 220.108,
    "end": 224.469,
    "duration": 4.361
  },
  {
    "id": 57,
    "text": "苏词兼有 《江城子》“十年生死两茫茫” 的沉痛悼亡与清幽婉约；",
    "start": 224.469,
    "end": 230.096,
    "duration": 5.627
  },
  {
    "id": 58,
    "text": "辛词兼有 《清平乐·村居》 的质朴田园与谐谑自嘲。",
    "start": 230.096,
    "end": 234.446,
    "duration": 4.35
  },
  {
    "id": 59,
    "text": "苏轼打破了小道观念，为词坛指明了向上一路；",
    "start": 234.446,
    "end": 238.285,
    "duration": 3.839
  },
  {
    "id": 60,
    "text": "辛弃疾聚拢南宋辛派词人群体，将爱国主义悲歌唱彻两宋长空。",
    "start": 238.285,
    "end": 243.91,
    "duration": 5.625
  },
  {
    "id": 61,
    "text": "苏辛双峰并峙，共同确立了宋词作为一代文学标志的永恒历史地位。",
    "start": 243.91,
    "end": 249.552,
    "duration": 5.642
  }
]