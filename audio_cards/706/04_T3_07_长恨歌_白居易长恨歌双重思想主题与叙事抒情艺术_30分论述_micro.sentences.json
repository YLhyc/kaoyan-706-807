[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "先破译全诗历来争议的“讽谕 vs 深情”双重主题，",
    "start": 0.0,
    "end": 4.88,
    "duration": 4.88
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再按故事节奏看前段如何从华清繁华陡转安史烽烟与马嵬死别，",
    "start": 4.929,
    "end": 10.169,
    "duration": 5.24
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "接着看后半段如何由宫中苦思化入蓬莱仙山把世俗悲剧升华，",
    "start": 10.619,
    "end": 15.539,
    "duration": 4.92
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后落在声律转韵的七言歌行美。",
    "start": 16.069,
    "end": 18.749,
    "duration": 2.68
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《长恨歌》作于元和元年，陈鸿同作《长恨歌传》言其“不但感其事，",
    "start": 19.199,
    "end": 24.479,
    "duration": 5.28
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "亦欲惩尤物，窒乱阶”。",
    "start": 24.929,
    "end": 26.809,
    "duration": 1.88
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "全诗将唐代盛衰兴亡与帝妃生死恋情融为一体。",
    "start": 27.339,
    "end": 31.139,
    "duration": 3.8
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 讽谕误国与同情深情的双重主题",
    "start": 31.589,
    "end": 35.229,
    "duration": 3.64
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "“汉皇重色思倾国”“从此君王不早朝”及杨氏荣宠，",
    "start": 35.679,
    "end": 39.879,
    "duration": 4.2
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "婉讽玄宗荒政酿安史之乱教训；",
    "start": 40.409,
    "end": 43.089,
    "duration": 2.68
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "马嵬缢死后倾情写玄宗返京思念与仙界重盟，对其生死恋情深切同情，",
    "start": 43.539,
    "end": 49.859,
    "duration": 6.32
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "折射士人反思盛衰与感叹世事的矛盾心态。",
    "start": 50.309,
    "end": 53.709,
    "duration": 3.4
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 融入历史兴衰、呈现戏剧张力",
    "start": 54.159,
    "end": 57.599,
    "duration": 3.44
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "先极力渲染华清池、骊宫霓裳歌舞繁华，旋以“渔阳鼙鼓动地来，",
    "start": 58.049,
    "end": 63.449,
    "duration": 5.4
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "惊破霓裳羽衣曲”陡然拉入战火；",
    "start": 63.899,
    "end": 66.579,
    "duration": 2.68
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "马嵬坡“六军不发无奈何，宛转蛾眉马前死”推至惨烈顶点，",
    "start": 67.109,
    "end": 72.349,
    "duration": 5.24
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "以盛衰反差紧咬家国与个人命运。",
    "start": 72.799,
    "end": 75.639,
    "duration": 2.84
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 虚实相生仙境、悲剧升华为永恒情",
    "start": 76.089,
    "end": 80.569,
    "duration": 4.48
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "入蜀还京“行宫见月伤心色，夜雨闻铃肠断声”“孤灯挑尽未成眠”；",
    "start": 81.099,
    "end": 86.619,
    "duration": 5.52
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "借道士“上穷碧落下黄泉”引出虚无缥缈仙山与“梨花一枝春带雨”杨妃，",
    "start": 87.069,
    "end": 93.149,
    "duration": 6.08
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "以金钗钿盒寄托“比翼鸟、连理枝”长生殿旧盟，冲淡冷峻政治感。",
    "start": 93.599,
    "end": 98.919,
    "duration": 5.32
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 融叙事抒情与七言歌行流丽声律",
    "start": 99.449,
    "end": 103.249,
    "duration": 3.8
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "七言歌行清丽晓畅不事僻典，兼取说唱流畅与诗赋精炼；",
    "start": 103.819,
    "end": 108.739,
    "duration": 4.92
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "叙事渗入浓烈抒情、情随事转；",
    "start": 109.189,
    "end": 111.869,
    "duration": 2.68
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "通篇转韵严整而抑扬顿挫，结尾“天长地久有时尽，",
    "start": 112.319,
    "end": 116.639,
    "duration": 4.32
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "此恨绵绵无绝期”荡气回肠，成歌行典范。",
    "start": 117.089,
    "end": 120.809,
    "duration": 3.72
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《长恨歌》把玄宗兴亡殷鉴与生死恋情融为双重意蕴，",
    "start": 121.259,
    "end": 125.539,
    "duration": 4.28
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "融虚实幻想、细节抒情与七言歌行转韵成中唐长诗典范，",
    "start": 125.989,
    "end": 130.869,
    "duration": 4.88
  },
  {
    "id": "concl_c2",
    "dom_key": "concl_c2",
    "text": "深远影响元代《梧桐雨》与清代《长生殿》。",
    "start": 131.319,
    "end": 134.679,
    "duration": 3.36
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：作于元和元年，陈鸿同作《长恨歌传》并记“不但感其事，",
    "start": 135.209,
    "end": 140.929,
    "duration": 5.72
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "亦欲惩尤物，窒乱阶”；",
    "start": 141.379,
    "end": 143.259,
    "duration": 1.88
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "注意影响清代《长生殿》、元代《梧桐雨》。",
    "start": 143.709,
    "end": 146.709,
    "duration": 3.0
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 陈鸿《长恨歌传》交代了怎样的写作缘起与惩戒本意？",
    "start": 147.159,
    "end": 152.439,
    "duration": 5.28
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 如何看待《长恨歌》“政治讽谕”与“生死深情”的双重矛盾主题？",
    "start": 152.889,
    "end": 159.049,
    "duration": 6.16
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 梳理全诗由华清欢娱→渔阳惊变→马嵬死别→孤灯悲思→仙山寄盟的虚实节奏？",
    "start": 159.579,
    "end": 168.099,
    "duration": 8.52
  }
]