[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《长恨歌》·白居易长恨歌双重思想主题与叙事抒情艺术",
    "start": 0.154,
    "end": 5.398,
    "duration": 5.244
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "先破译全诗历来争议的“讽谕 vs 深情”双重主题，",
    "start": 6.366,
    "end": 11.418,
    "duration": 5.052
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再按故事节奏看前段如何从华清繁华陡转安史烽烟与马嵬死别，",
    "start": 11.846,
    "end": 18.378,
    "duration": 6.532
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "接着看后半段如何由宫中苦思化入蓬莱仙山把世俗悲剧升华，最后落在声律转韵的七言歌行美。",
    "start": 18.926,
    "end": 27.458,
    "duration": 8.532
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《长恨歌》作于元和元年，陈鸿同作《长恨歌传》言其“不但感其事，亦欲惩尤物，窒乱阶”。",
    "start": 28.274,
    "end": 35.438,
    "duration": 7.164
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "全诗将唐代盛衰兴亡与帝妃生死恋情融为一体。",
    "start": 36.526,
    "end": 40.818,
    "duration": 4.292
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 讽谕误国与同情深情的双重主题",
    "start": 41.826,
    "end": 45.758,
    "duration": 3.932
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "“汉皇重色思倾国”“从此君王不早朝”及杨氏荣宠，婉讽玄宗荒政酿安史之乱教训；",
    "start": 46.766,
    "end": 55.738,
    "duration": 8.972
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "马嵬缢死后倾情写玄宗返京思念与仙界重盟，对其生死恋情深切同情，折射士人反思盛衰与感叹世事的矛盾心态。",
    "start": 56.786,
    "end": 69.398,
    "duration": 12.612
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 融入历史兴衰、呈现戏剧张力",
    "start": 70.406,
    "end": 73.858,
    "duration": 3.452
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "先极力渲染华清池、骊宫霓裳歌舞繁华，旋以“渔阳鼙鼓动地来，惊破霓裳羽衣曲”陡然拉入战火；",
    "start": 74.826,
    "end": 85.518,
    "duration": 10.692
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "马嵬坡“六军不发无奈何，宛转蛾眉马前死”推至惨烈顶点，以盛衰反差紧咬家国与个人命运。",
    "start": 86.446,
    "end": 96.858,
    "duration": 10.412
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 虚实相生仙境、悲剧升华为永恒情",
    "start": 97.826,
    "end": 102.958,
    "duration": 5.132
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "入蜀还京“行宫见月伤心色，夜雨闻铃肠断声”“孤灯挑尽未成眠”；",
    "start": 103.69,
    "end": 111.502,
    "duration": 7.812
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "借道士“上穷碧落下黄泉”引出虚无缥缈仙山与“梨花一枝春带雨”杨妃，",
    "start": 112.59,
    "end": 121.202,
    "duration": 8.612
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "以金钗钿盒寄托“比翼鸟、连理枝”长生殿旧盟，冲淡冷峻政治感。",
    "start": 121.59,
    "end": 127.882,
    "duration": 6.292
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 融叙事抒情与七言歌行流丽声律",
    "start": 128.85,
    "end": 132.982,
    "duration": 4.132
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "七言歌行清丽晓畅不事僻典，兼取说唱流畅与诗赋精炼；叙事渗入浓烈抒情、情随事转；",
    "start": 133.95,
    "end": 145.102,
    "duration": 11.152
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "通篇转韵严整而抑扬顿挫，结尾“天长地久有时尽，此恨绵绵无绝期”荡气回肠，成歌行典范。",
    "start": 145.63,
    "end": 154.522,
    "duration": 8.892
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《长恨歌》把玄宗兴亡殷鉴与生死恋情融为双重意蕴，",
    "start": 155.354,
    "end": 160.742,
    "duration": 5.388
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "融虚实幻想、细节抒情与七言歌行转韵成中唐长诗典范，",
    "start": 161.09,
    "end": 167.782,
    "duration": 6.692
  },
  {
    "id": "concl_c2",
    "dom_key": "concl_c2",
    "text": "深远影响元代《梧桐雨》与清代《长生殿》。",
    "start": 168.25,
    "end": 171.582,
    "duration": 3.332
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：作于元和元年，陈鸿同作《长恨歌传》并记“不但感其事，亦欲惩尤物，窒乱阶”；",
    "start": 172.63,
    "end": 181.762,
    "duration": 9.132
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "注意影响清代《长生殿》、元代《梧桐雨》。",
    "start": 182.77,
    "end": 186.222,
    "duration": 3.452
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 陈鸿《长恨歌传》交代了怎样的写作缘起与惩戒本意？",
    "start": 187.15,
    "end": 193.442,
    "duration": 6.292
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 如何看待《长恨歌》“政治讽谕”与“生死深情”的双重矛盾主题？",
    "start": 194.37,
    "end": 201.262,
    "duration": 6.892
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 梳理全诗由华清欢娱→渔阳惊变→马嵬死别→孤灯悲思→仙山寄盟的虚实节奏？",
    "start": 202.31,
    "end": 212.882,
    "duration": 10.572
  }
]