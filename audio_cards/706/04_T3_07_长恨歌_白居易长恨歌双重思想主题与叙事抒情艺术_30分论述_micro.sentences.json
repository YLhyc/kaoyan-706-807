[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《长恨歌》·白居易长恨歌双重思想主题与叙事抒情艺术",
    "start": 0.134,
    "end": 5.185,
    "duration": 5.051
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "先破译全诗历来争议的“讽谕 vs 深情”双重主题，",
    "start": 5.774,
    "end": 10.565,
    "duration": 4.791
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再按故事节奏看前段如何从华清繁华陡转安史烽烟与马嵬死别，",
    "start": 10.904,
    "end": 16.88,
    "duration": 5.976
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "接着看后半段如何由宫中苦思化入蓬莱仙山把世俗悲剧升华，最后落在声律转韵的七言歌行美。",
    "start": 16.981,
    "end": 25.183,
    "duration": 8.202
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《长恨歌》作于元和元年，陈鸿同作《长恨歌传》言其“不但感其事，亦欲惩尤物，窒乱阶”。",
    "start": 25.757,
    "end": 33.699,
    "duration": 7.942
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "全诗将唐代盛衰兴亡与帝妃生死恋情融为一体。",
    "start": 34.273,
    "end": 38.647,
    "duration": 4.374
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 讽谕误国与同情深情的双重主题",
    "start": 39.233,
    "end": 42.8,
    "duration": 3.567
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "“汉皇重色思倾国”“从此君王不早朝”及杨氏荣宠，婉讽玄宗荒政酿安史之乱教训；",
    "start": 43.387,
    "end": 51.667,
    "duration": 8.28
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "马嵬缢死后倾情写玄宗返京思念与仙界重盟，对其生死恋情深切同情，折射士人反思盛衰与感叹世事的矛盾心态。",
    "start": 52.254,
    "end": 64.024,
    "duration": 11.77
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 融入历史兴衰、呈现戏剧张力",
    "start": 64.611,
    "end": 67.956,
    "duration": 3.345
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "先极力渲染华清池、骊宫霓裳歌舞繁华，旋以“渔阳鼙鼓动地来，惊破霓裳羽衣曲”陡然拉入战火；",
    "start": 68.53,
    "end": 77.995,
    "duration": 9.465
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "马嵬坡“六军不发无奈何，宛转蛾眉马前死”推至惨烈顶点，以盛衰反差紧咬家国与个人命运。",
    "start": 78.582,
    "end": 87.605,
    "duration": 9.022
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 虚实相生仙境、悲剧升华为永恒情",
    "start": 88.192,
    "end": 92.527,
    "duration": 4.335
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "入蜀还京“行宫见月伤心色，夜雨闻铃肠断声”“孤灯挑尽未成眠”；",
    "start": 93.114,
    "end": 100.235,
    "duration": 7.121
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "借道士“上穷碧落下黄泉”引出虚无缥缈仙山与“梨花一枝春带雨”杨妃，",
    "start": 100.822,
    "end": 107.865,
    "duration": 7.043
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "以金钗钿盒寄托“比翼鸟、连理枝”长生殿旧盟，冲淡冷峻政治感。",
    "start": 108.166,
    "end": 114.011,
    "duration": 5.845
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 融叙事抒情与七言歌行流丽声律",
    "start": 114.598,
    "end": 118.425,
    "duration": 3.827
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "七言歌行清丽晓畅不事僻典，兼取说唱流畅与诗赋精炼；叙事渗入浓烈抒情、情随事转；",
    "start": 119.012,
    "end": 128.451,
    "duration": 9.439
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "通篇转韵严整而抑扬顿挫，结尾“天长地久有时尽，此恨绵绵无绝期”荡气回肠，成歌行典范。",
    "start": 129.038,
    "end": 138.425,
    "duration": 9.387
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《长恨歌》把玄宗兴亡殷鉴与生死恋情融为双重意蕴，",
    "start": 139.012,
    "end": 143.816,
    "duration": 4.804
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "融虚实幻想、细节抒情与七言歌行转韵成中唐长诗典范，",
    "start": 144.051,
    "end": 149.519,
    "duration": 5.468
  },
  {
    "id": "concl_c2",
    "dom_key": "concl_c2",
    "text": "深远影响元代《梧桐雨》与清代《长生殿》。",
    "start": 149.78,
    "end": 153.191,
    "duration": 3.41
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：作于元和元年，陈鸿同作《长恨歌传》并记“不但感其事，亦欲惩尤物，窒乱阶”；",
    "start": 153.778,
    "end": 161.759,
    "duration": 7.981
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "注意影响清代《长生殿》、元代《梧桐雨》。",
    "start": 161.994,
    "end": 165.235,
    "duration": 3.241
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 陈鸿《长恨歌传》交代了怎样的写作缘起与惩戒本意？",
    "start": 165.822,
    "end": 171.85,
    "duration": 6.028
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 如何看待《长恨歌》“政治讽谕”与“生死深情”的双重矛盾主题？",
    "start": 172.437,
    "end": 178.594,
    "duration": 6.158
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 梳理全诗由华清欢娱→渔阳惊变→马嵬死别→孤灯悲思→仙山寄盟的虚实节奏？",
    "start": 179.181,
    "end": 188.894,
    "duration": 9.713
  }
]