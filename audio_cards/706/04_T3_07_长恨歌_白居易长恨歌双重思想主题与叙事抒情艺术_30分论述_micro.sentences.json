[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "先破译全诗历来争议的“讽谕 vs 深情”双重主题，",
    "start": 0.22,
    "end": 4.956,
    "duration": 4.735
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再按故事节奏看前段如何从华清繁华陡转安史烽烟与马嵬死别，",
    "start": 5.706,
    "end": 11.461,
    "duration": 5.754
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "接着看后半段如何由宫中苦思化入蓬莱仙山把世俗悲剧升华，",
    "start": 12.167,
    "end": 17.264,
    "duration": 5.097
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后落在声律转韵的七言歌行美。",
    "start": 18.0,
    "end": 20.671,
    "duration": 2.67
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《长恨歌》作于元和元年，陈鸿同作《长恨歌传》言其“不但感其事，亦欲惩尤物，窒乱阶”。",
    "start": 21.47,
    "end": 29.117,
    "duration": 7.647
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "全诗将唐代盛衰兴亡与帝妃生死恋情融为一体。",
    "start": 29.838,
    "end": 34.047,
    "duration": 4.209
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 讽谕误国与同情深情的双重主题",
    "start": 34.793,
    "end": 38.243,
    "duration": 3.45
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "“汉皇重色思倾国”“从此君王不早朝”及杨氏荣宠，婉讽玄宗荒政酿安史之乱教训；",
    "start": 38.976,
    "end": 46.233,
    "duration": 7.257
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "马嵬缢死后倾情写玄宗返京思念与仙界重盟，对其生死恋情深切同情，",
    "start": 46.963,
    "end": 53.541,
    "duration": 6.578
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "折射士人反思盛衰与感叹世事的矛盾心态。",
    "start": 54.36,
    "end": 57.88,
    "duration": 3.519
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 融入历史兴衰、呈现戏剧张力",
    "start": 58.609,
    "end": 61.842,
    "duration": 3.233
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "先极力渲染华清池、骊宫霓裳歌舞繁华，旋以“渔阳鼙鼓动地来，惊破霓裳羽衣曲”陡然拉入战火；",
    "start": 62.544,
    "end": 70.686,
    "duration": 8.141
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "马嵬坡“六军不发无奈何，宛转蛾眉马前死”推至惨烈顶点，以盛衰反差紧咬家国与个人命运。",
    "start": 71.459,
    "end": 79.739,
    "duration": 8.28
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 虚实相生仙境、悲剧升华为永恒情",
    "start": 80.459,
    "end": 84.691,
    "duration": 4.232
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "入蜀还京“行宫见月伤心色，夜雨闻铃肠断声”“孤灯挑尽未成眠”；",
    "start": 85.421,
    "end": 90.868,
    "duration": 5.447
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "借道士“上穷碧落下黄泉”引出虚无缥缈仙山与“梨花一枝春带雨”杨妃，",
    "start": 91.69,
    "end": 97.432,
    "duration": 5.741
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "以金钗钿盒寄托“比翼鸟、连理枝”长生殿旧盟，冲淡冷峻政治感。",
    "start": 98.144,
    "end": 103.593,
    "duration": 5.449
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 融叙事抒情与七言歌行流丽声律",
    "start": 104.39,
    "end": 108.05,
    "duration": 3.661
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "七言歌行清丽晓畅不事僻典，兼取说唱流畅与诗赋精炼；叙事渗入浓烈抒情、情随事转；",
    "start": 108.781,
    "end": 116.802,
    "duration": 8.021
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "通篇转韵严整而抑扬顿挫，结尾“天长地久有时尽，此恨绵绵无绝期”荡气回肠，成歌行典范。",
    "start": 117.606,
    "end": 125.81,
    "duration": 8.204
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《长恨歌》把玄宗兴亡殷鉴与生死恋情融为双重意蕴，",
    "start": 126.572,
    "end": 131.212,
    "duration": 4.64
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "融虚实幻想、细节抒情与七言歌行转韵成中唐长诗典范，",
    "start": 131.995,
    "end": 137.392,
    "duration": 5.397
  },
  {
    "id": "concl_c2",
    "dom_key": "concl_c2",
    "text": "深远影响元代《梧桐雨》与清代《长生殿》。",
    "start": 138.184,
    "end": 141.287,
    "duration": 3.103
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：作于元和元年，陈鸿同作《长恨歌传》并记“不但感其事，亦欲惩尤物，窒乱阶”；",
    "start": 142.074,
    "end": 149.867,
    "duration": 7.793
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "注意影响清代《长生殿》、元代《梧桐雨》。",
    "start": 150.582,
    "end": 153.356,
    "duration": 2.773
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 陈鸿《长恨歌传》交代了怎样的写作缘起与惩戒本意？",
    "start": 154.241,
    "end": 159.858,
    "duration": 5.617
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 如何看待《长恨歌》“政治讽谕”与“生死深情”的双重矛盾主题？",
    "start": 160.603,
    "end": 166.608,
    "duration": 6.005
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 梳理全诗由华清欢娱→渔阳惊变→马嵬死别→孤灯悲思→仙山寄盟的虚实节奏？",
    "start": 167.33,
    "end": 175.99,
    "duration": 8.66
  }
]