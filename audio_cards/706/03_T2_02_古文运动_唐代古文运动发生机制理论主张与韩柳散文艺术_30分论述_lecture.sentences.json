[
  {
    "id": 1,
    "text": "试论唐代古文运动的发生机制、理论主张与韩柳散文艺术。",
    "start": 0.16,
    "end": 5.28,
    "duration": 5.12
  },
  {
    "id": 2,
    "text": "唐代古文运动是由韩愈、",
    "start": 5.28,
    "end": 7.36,
    "duration": 2.08
  },
  {
    "id": 3,
    "text": "柳宗元在中唐时期发起并领导的一场划时代的散文革新与思想复兴运动。",
    "start": 7.36,
    "end": 13.36,
    "duration": 6.0
  },
  {
    "id": 4,
    "text": "面对安史之乱后藩镇割据加剧、朝政衰败、",
    "start": 13.36,
    "end": 17.44,
    "duration": 4.08
  },
  {
    "id": 5,
    "text": "佛道盛行冲击儒家正统，以及六朝以来骈俪文风雕琢声色、",
    "start": 17.44,
    "end": 22.64,
    "duration": 5.2
  },
  {
    "id": 6,
    "text": "形式主义泛滥的历史困境，韩柳以“复古”为旗帜，",
    "start": 22.64,
    "end": 27.2,
    "duration": 4.56
  },
  {
    "id": 7,
    "text": "掀起了旨在恢复先秦两汉散文传统的文体革命。",
    "start": 27.2,
    "end": 31.6,
    "duration": 4.4
  },
  {
    "id": 8,
    "text": "苏轼在 《潮州韩文公庙碑》 中赞韩愈 “文起八代之衰，",
    "start": 31.68,
    "end": 37.2,
    "duration": 5.52
  },
  {
    "id": 9,
    "text": "而道济天下之溺”。",
    "start": 37.2,
    "end": 39.04,
    "duration": 1.84
  },
  {
    "id": 10,
    "text": "古文运动的发生机制、理论纲领与韩柳散文艺术，",
    "start": 39.04,
    "end": 43.36,
    "duration": 4.32
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：",
    "start": 43.36,
    "end": 46.56,
    "duration": 3.2
  },
  {
    "id": 12,
    "text": "第一，立足中唐社会危局与儒学复兴诉求，",
    "start": 46.56,
    "end": 50.08,
    "duration": 3.52
  },
  {
    "id": 13,
    "text": "确立“以复古为革新”的发生机制。",
    "start": 50.08,
    "end": 53.04,
    "duration": 2.96
  },
  {
    "id": 14,
    "text": "古文运动绝非单纯的文体文字改革，",
    "start": 53.04,
    "end": 56.16,
    "duration": 3.12
  },
  {
    "id": 15,
    "text": "其实质是一场深刻的思想政治运动。",
    "start": 56.16,
    "end": 59.04,
    "duration": 2.88
  },
  {
    "id": 16,
    "text": "中唐安史之乱打破了大唐帝国繁荣统一的政治神话，",
    "start": 59.04,
    "end": 63.28,
    "duration": 4.24
  },
  {
    "id": 17,
    "text": "士大夫深感皇权衰落与社会道德解体，",
    "start": 63.28,
    "end": 66.56,
    "duration": 3.28
  },
  {
    "id": 18,
    "text": "迫切需要重构具有统治力的意识形态。",
    "start": 66.56,
    "end": 69.44,
    "duration": 2.88
  },
  {
    "id": 19,
    "text": "韩愈认为佛道虚无思想瓦解了国家纲常伦理，",
    "start": 69.44,
    "end": 73.6,
    "duration": 4.16
  },
  {
    "id": 20,
    "text": "而南朝以来讲求平仄对仗、空洞无物的骈偶四六文，",
    "start": 73.6,
    "end": 78.32,
    "duration": 4.72
  },
  {
    "id": 21,
    "text": "根本无法承载严肃的政治思想与历史批判。",
    "start": 78.32,
    "end": 82.72,
    "duration": 4.4
  },
  {
    "id": 22,
    "text": "于是，他们假借恢复先秦西汉散文古体之名，",
    "start": 82.72,
    "end": 87.44,
    "duration": 4.72
  },
  {
    "id": 23,
    "text": "以复古为革新武器，意在打破形式主义桎梏，",
    "start": 87.52,
    "end": 91.84,
    "duration": 4.32
  },
  {
    "id": 24,
    "text": "重塑儒家道统的权威。",
    "start": 91.84,
    "end": 93.76,
    "duration": 1.92
  },
  {
    "id": 25,
    "text": "第二，系统提出“文以明道”与“气盛言宜”的文学理论纲领。",
    "start": 93.76,
    "end": 100.16,
    "duration": 6.4
  },
  {
    "id": 26,
    "text": "在理论建设上，韩愈与柳宗元构建了完整的散文美学体系。",
    "start": 100.16,
    "end": 106.64,
    "duration": 6.48
  },
  {
    "id": 27,
    "text": "在文道关系上，韩愈倡导 “文以明道”，",
    "start": 106.64,
    "end": 111.2,
    "duration": 4.56
  },
  {
    "id": 28,
    "text": "强调文学必须以阐发儒家仁义道德为核心宗旨；在创作方法上，",
    "start": 111.52,
    "end": 118.32,
    "duration": 6.8
  },
  {
    "id": 29,
    "text": "提出 “唯陈言之务去”，坚决反对因袭剽窃前人陈腐字句；",
    "start": 118.32,
    "end": 123.44,
    "duration": 5.12
  },
  {
    "id": 30,
    "text": "在文气驱动上，提出 “气盛则言之短长与声之高下者皆宜”，",
    "start": 123.44,
    "end": 130.32,
    "duration": 6.88
  },
  {
    "id": 31,
    "text": "认为作家内在精神修养的浩然之气，",
    "start": 130.32,
    "end": 133.52,
    "duration": 3.2
  },
  {
    "id": 32,
    "text": "是决定文章气势与音律和谐的根本力量；在情感动机上，",
    "start": 133.52,
    "end": 139.68,
    "duration": 6.16
  },
  {
    "id": 33,
    "text": "韩愈提出 “大凡物不得其平则鸣”，",
    "start": 139.68,
    "end": 142.704,
    "duration": 3.024
  },
  {
    "id": 34,
    "text": "深刻揭示了文学创作源于对现实不公与人生困顿的抒愤机制。",
    "start": 142.704,
    "end": 148.224,
    "duration": 5.52
  },
  {
    "id": 35,
    "text": "第三，推行文体形式的彻底解放，",
    "start": 148.224,
    "end": 151.824,
    "duration": 3.6
  },
  {
    "id": 36,
    "text": "以单行散体打破骈偶对称的千年牢笼。",
    "start": 151.824,
    "end": 155.264,
    "duration": 3.44
  },
  {
    "id": 37,
    "text": "古文运动在艺术上的最大贡献，",
    "start": 155.264,
    "end": 158.064,
    "duration": 2.8
  },
  {
    "id": 38,
    "text": "在于彻底打破了南朝沈宋以来排比对偶与声病音律的严密束缚。",
    "start": 158.064,
    "end": 163.904,
    "duration": 5.84
  },
  {
    "id": 39,
    "text": "韩柳主张散体单行，句式长短错落、参差多变，",
    "start": 163.904,
    "end": 167.904,
    "duration": 4.0
  },
  {
    "id": 40,
    "text": "根据表达情意的需要自由舒卷。",
    "start": 167.904,
    "end": 170.624,
    "duration": 2.72
  },
  {
    "id": 41,
    "text": "散文语言由刻板雕饰走向洗练生动，",
    "start": 170.624,
    "end": 173.904,
    "duration": 3.28
  },
  {
    "id": 42,
    "text": "吸收先秦两汉典雅文言的同时，大胆吸纳民间活泼口语，",
    "start": 173.904,
    "end": 179.824,
    "duration": 5.92
  },
  {
    "id": 43,
    "text": "使散文重新恢复了交代复杂历史事实、",
    "start": 179.824,
    "end": 183.744,
    "duration": 3.92
  },
  {
    "id": 44,
    "text": "展开缜密逻辑论辩与描摹细致客观景物的宏大功能，",
    "start": 183.744,
    "end": 189.264,
    "duration": 5.52
  },
  {
    "id": 45,
    "text": "极大地开拓了散文的文体表现空间。",
    "start": 189.264,
    "end": 192.384,
    "duration": 3.12
  },
  {
    "id": 46,
    "text": "第四，韩柳散文各具卓越风貌，全面确立中国古典散文的至高典范。",
    "start": 192.384,
    "end": 199.344,
    "duration": 6.96
  },
  {
    "id": 47,
    "text": "韩愈与柳宗元在创作实践上同中有异、相得益彰。",
    "start": 199.344,
    "end": 204.944,
    "duration": 5.6
  },
  {
    "id": 48,
    "text": "韩愈散文以雄健奇崛著称，如大江奔流、汪洋恣肆，",
    "start": 204.944,
    "end": 209.504,
    "duration": 4.56
  },
  {
    "id": 49,
    "text": "在 《师说》 中以严密论辩批判士大夫耻于从师的弊病，",
    "start": 209.504,
    "end": 214.784,
    "duration": 5.28
  },
  {
    "id": 50,
    "text": "在 《马说》 中借千里马之悲愤斥封建统治者埋没人才；",
    "start": 214.784,
    "end": 219.824,
    "duration": 5.04
  },
  {
    "id": 51,
    "text": "柳宗元散文则以峭拔清峻见长，思虑深沉、笔锋犀利。",
    "start": 219.824,
    "end": 224.624,
    "duration": 4.8
  },
  {
    "id": 52,
    "text": "柳宗元在传记散文 《捕蛇者说》 中借苛政猛于虎揭露横征暴敛，",
    "start": 224.624,
    "end": 225.984,
    "duration": 1.36
  },
  {
    "id": 53,
    "text": "更在山水游记 《永州八记》 中开辟了融身世之悲于自然清幽的极高意境。",
    "start": 225.824,
    "end": 225.984,
    "duration": 0.16
  },
  {
    "id": 54,
    "text": "韩柳散文不仅彻底终结了骈体文的独霸地位，",
    "start": 225.824,
    "end": 225.984,
    "duration": 0.16
  },
  {
    "id": 55,
    "text": "更直接开启了北宋欧苏等唐宋八大家的散文极盛时代。",
    "start": 225.824,
    "end": 225.984,
    "duration": 0.16
  }
]