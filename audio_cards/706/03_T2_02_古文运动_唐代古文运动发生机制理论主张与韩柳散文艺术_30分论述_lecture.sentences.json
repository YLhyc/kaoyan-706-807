[
  {
    "id": 1,
    "text": "试论唐代古文运动的发生机制、理论主张与韩柳散文艺术。",
    "start": 0.104,
    "end": 5.037,
    "duration": 4.933
  },
  {
    "id": 2,
    "text": "唐代古文运动是由韩愈、",
    "start": 5.687,
    "end": 7.545,
    "duration": 1.858
  },
  {
    "id": 3,
    "text": "柳宗元在中唐时期领导的一场散文文体与文风革新运动。",
    "start": 7.868,
    "end": 12.425,
    "duration": 4.557
  },
  {
    "id": 4,
    "text": "面对安史之乱后藩镇割据加剧、朝政衰败、",
    "start": 13.0,
    "end": 16.504,
    "duration": 3.504
  },
  {
    "id": 5,
    "text": "佛老盛行冲击儒学正统，以及六朝以来骈俪文风雕琢辞藻、",
    "start": 17.144,
    "end": 21.947,
    "duration": 4.803
  },
  {
    "id": 6,
    "text": "内容空虚的局面，韩柳以复古为号召，",
    "start": 22.19,
    "end": 25.199,
    "duration": 3.009
  },
  {
    "id": 7,
    "text": "掀起了旨在恢复先秦两汉散文传统的文学变革。",
    "start": 25.495,
    "end": 29.393,
    "duration": 3.898
  },
  {
    "id": 8,
    "text": "苏轼在《潮州韩文公庙碑》中赞韩愈“文起八代之衰，",
    "start": 29.663,
    "end": 34.43,
    "duration": 4.767
  },
  {
    "id": 9,
    "text": "道济天下之溺”。",
    "start": 34.711,
    "end": 35.814,
    "duration": 1.103
  },
  {
    "id": 10,
    "text": "古文运动的发生机制、理论纲领与韩柳散文艺术，",
    "start": 36.456,
    "end": 40.427,
    "duration": 3.971
  },
  {
    "id": 11,
    "text": "主要体现在以下四个方面：",
    "start": 40.699,
    "end": 42.418,
    "duration": 1.719
  },
  {
    "id": 12,
    "text": "第一，立足中唐社会危局与儒学复兴诉求，",
    "start": 43.057,
    "end": 46.645,
    "duration": 3.588
  },
  {
    "id": 13,
    "text": "确立以复古为革新的发生机制。",
    "start": 46.827,
    "end": 49.136,
    "duration": 2.309
  },
  {
    "id": 14,
    "text": "古文运动不仅是一场文体文字改革，",
    "start": 49.468,
    "end": 51.886,
    "duration": 2.418
  },
  {
    "id": 15,
    "text": "更与中唐政治革新与儒学复兴思潮紧密相连。",
    "start": 52.128,
    "end": 55.577,
    "duration": 3.449
  },
  {
    "id": 16,
    "text": "安史之乱打破了大唐盛世的繁荣局面，",
    "start": 55.926,
    "end": 58.501,
    "duration": 2.575
  },
  {
    "id": 17,
    "text": "士大夫深感国势衰落与纲常解体，迫切要求重建儒家思想权威、",
    "start": 58.832,
    "end": 63.81,
    "duration": 4.978
  },
  {
    "id": 18,
    "text": "革除时弊。",
    "start": 64.087,
    "end": 64.827,
    "duration": 0.74
  },
  {
    "id": 19,
    "text": "韩愈认为佛老学说削弱了国家伦理与财税根基，",
    "start": 65.105,
    "end": 69.308,
    "duration": 4.203
  },
  {
    "id": 20,
    "text": "而魏晋六朝以来讲求声律对偶、流于浮靡的骈体文，",
    "start": 69.659,
    "end": 74.006,
    "duration": 4.347
  },
  {
    "id": 21,
    "text": "难以承载严肃的政治议论与经世之道。",
    "start": 74.195,
    "end": 77.238,
    "duration": 3.043
  },
  {
    "id": 22,
    "text": "于是韩柳主张效法先秦两汉散体古文，假复古之名行革新之实，",
    "start": 77.684,
    "end": 83.398,
    "duration": 5.714
  },
  {
    "id": 23,
    "text": "破除形式主义积弊，重振儒家道统与致用精神。",
    "start": 83.528,
    "end": 87.219,
    "duration": 3.691
  },
  {
    "id": 24,
    "text": "第二，系统提出“文以明道”与“气盛言宜”的散文理论纲领。",
    "start": 87.917,
    "end": 92.27,
    "duration": 4.353
  },
  {
    "id": 25,
    "text": "在理论建设上，韩愈与柳宗元构建了系统的散文美学主张。",
    "start": 92.878,
    "end": 97.089,
    "duration": 4.211
  },
  {
    "id": 26,
    "text": "在文道关系上，韩愈倡导“文以明道”，",
    "start": 97.557,
    "end": 100.359,
    "duration": 2.802
  },
  {
    "id": 27,
    "text": "柳宗元亦主张“辅时及物”，强调文章必须以阐发儒家义理、",
    "start": 100.742,
    "end": 105.322,
    "duration": 4.58
  },
  {
    "id": 28,
    "text": "干预现实政治为核心宗旨；在创作方法上，",
    "start": 105.595,
    "end": 108.99,
    "duration": 3.395
  },
  {
    "id": 29,
    "text": "提出“唯陈言之务去”，主张“师其意不师其辞”，",
    "start": 109.427,
    "end": 113.511,
    "duration": 4.084
  },
  {
    "id": 30,
    "text": "坚决反对因袭剽窃前人陈词；在文气修养上，",
    "start": 113.885,
    "end": 117.994,
    "duration": 4.109
  },
  {
    "id": 31,
    "text": "提出“气盛则言之短长与声之高下者皆宜”，",
    "start": 118.397,
    "end": 122.214,
    "duration": 3.817
  },
  {
    "id": 32,
    "text": "认为作家内在的道德修养与精神气象决定文章的声气和谐；",
    "start": 122.607,
    "end": 127.324,
    "duration": 4.717
  },
  {
    "id": 33,
    "text": "在抒情动因上，韩愈提出“大凡物不得其平则鸣”，",
    "start": 127.614,
    "end": 131.797,
    "duration": 4.183
  },
  {
    "id": 34,
    "text": "揭示了文学创作源于现实不平与内心郁积的抒愤机制。",
    "start": 131.942,
    "end": 136.442,
    "duration": 4.5
  },
  {
    "id": 35,
    "text": "第三，革除骈体浮靡积弊，以单行散体打破排比对偶的文体束缚。",
    "start": 137.106,
    "end": 142.877,
    "duration": 5.771
  },
  {
    "id": 36,
    "text": "古文运动在文体形式上的突出贡献，",
    "start": 143.201,
    "end": 145.758,
    "duration": 2.557
  },
  {
    "id": 37,
    "text": "在于打破了六朝以来排比对偶与声病音律对文章表达的长期束缚。",
    "start": 145.913,
    "end": 151.351,
    "duration": 5.438
  },
  {
    "id": 38,
    "text": "韩柳倡导单行散体，句式长短错落、参差多变，",
    "start": 151.647,
    "end": 155.788,
    "duration": 4.141
  },
  {
    "id": 39,
    "text": "随情意表达的需要自由舒卷。",
    "start": 156.07,
    "end": 158.304,
    "duration": 2.234
  },
  {
    "id": 40,
    "text": "他们又并不全盘排斥骈文，",
    "start": 158.545,
    "end": 160.527,
    "duration": 1.982
  },
  {
    "id": 41,
    "text": "而是吸收先秦两汉典雅文言与六朝骈语精华，",
    "start": 160.931,
    "end": 164.835,
    "duration": 3.904
  },
  {
    "id": 42,
    "text": "同时吸纳时下鲜活词语，如“文从字顺”与自铸新词，",
    "start": 165.251,
    "end": 170.072,
    "duration": 4.821
  },
  {
    "id": 43,
    "text": "使散文重新恢复了叙写复杂史事、",
    "start": 170.43,
    "end": 172.9,
    "duration": 2.47
  },
  {
    "id": 44,
    "text": "展开严密论辩与描摹客观景物的表现力，",
    "start": 173.304,
    "end": 176.49,
    "duration": 3.186
  },
  {
    "id": 45,
    "text": "大幅拓展了散文的体裁边界与艺术空间。",
    "start": 176.887,
    "end": 179.852,
    "duration": 2.965
  },
  {
    "id": 46,
    "text": "第四，韩柳散文各擅胜场，共同奠定唐宋古文运动的典范格局。",
    "start": 180.529,
    "end": 185.841,
    "duration": 5.312
  },
  {
    "id": 47,
    "text": "韩愈与柳宗元在散文创作上同中有异、相得益彰。",
    "start": 186.183,
    "end": 190.505,
    "duration": 4.322
  },
  {
    "id": 48,
    "text": "韩愈散文气势雄健、汪洋恣肆，",
    "start": 190.91,
    "end": 193.253,
    "duration": 2.343
  },
  {
    "id": 49,
    "text": "在《师说》中以严密论辩批判士大夫耻于从师的陋习，",
    "start": 193.681,
    "end": 197.923,
    "duration": 4.242
  },
  {
    "id": 50,
    "text": "在《马说》中借千里马遭遇抒发人才被埋没的悲愤；",
    "start": 198.398,
    "end": 202.13,
    "duration": 3.732
  },
  {
    "id": 51,
    "text": "柳宗元散文则峭拔清峻、笔锋犀利，",
    "start": 202.373,
    "end": 205.388,
    "duration": 3.015
  },
  {
    "id": 52,
    "text": "在杂说名篇《捕蛇者说》中借蒋氏三代遭遇揭示“孰知赋敛之毒有甚是蛇者乎”的主题，",
    "start": 205.627,
    "end": 212.826,
    "duration": 7.199
  },
  {
    "id": 53,
    "text": "在山水游记《永州八记》中开辟了融身世之悲于自然清幽的独特意境。",
    "start": 213.014,
    "end": 218.84,
    "duration": 5.826
  },
  {
    "id": 54,
    "text": "韩柳散文使散体取代骈体占据文坛主位，为北宋欧阳修、",
    "start": 219.035,
    "end": 224.118,
    "duration": 5.083
  },
  {
    "id": 55,
    "text": "苏轼等人的诗文革新奠定了坚实基础。",
    "start": 224.293,
    "end": 227.216,
    "duration": 2.923
  }
]