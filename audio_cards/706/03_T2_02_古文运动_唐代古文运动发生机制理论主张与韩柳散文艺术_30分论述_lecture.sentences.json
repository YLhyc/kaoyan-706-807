[
  {
    "id": 1,
    "text": "试论唐代古文运动的发生机制、理论主张与韩柳散文艺术。",
    "start": 0.05,
    "end": 5.164,
    "duration": 5.114
  },
  {
    "id": 2,
    "text": "唐代古文运动是由韩愈、柳宗元在中唐时期领导的一场散文文体与文风革新运动。",
    "start": 5.585,
    "end": 12.709,
    "duration": 7.124
  },
  {
    "id": 3,
    "text": "面对安史之乱后藩镇割据加剧、朝政衰败、佛老盛行冲击儒学正统，",
    "start": 13.112,
    "end": 18.924,
    "duration": 5.812
  },
  {
    "id": 4,
    "text": "以及六朝以来骈俪文风雕琢辞藻、内容空虚的局面，",
    "start": 19.177,
    "end": 23.665,
    "duration": 4.488
  },
  {
    "id": 5,
    "text": "韩柳以复古为号召，掀起了旨在恢复先秦两汉散文传统的文学变革。",
    "start": 23.845,
    "end": 29.628,
    "duration": 5.783
  },
  {
    "id": 6,
    "text": "苏轼赞韩愈“文起八代之衰，道济天下之溺”。",
    "start": 29.764,
    "end": 33.624,
    "duration": 3.86
  },
  {
    "id": 7,
    "text": "古文运动的发生机制、理论纲领与韩柳散文艺术，主要体现在以下四个方面：",
    "start": 33.735,
    "end": 40.044,
    "duration": 6.309
  },
  {
    "id": 8,
    "text": "第一，立足中唐社会危局与儒学复兴诉求，确立以复古为革新的发生机制。",
    "start": 40.208,
    "end": 45.787,
    "duration": 5.579
  },
  {
    "id": 9,
    "text": "古文运动不仅是一场文体文字改革，更与中唐政治革新与儒学复兴思潮紧密相连。",
    "start": 46.01,
    "end": 53.086,
    "duration": 7.076
  },
  {
    "id": 10,
    "text": "安史之乱打破了大唐盛世的繁荣局面，士大夫深感国势衰落与纲常解体，",
    "start": 54.04,
    "end": 60.086,
    "duration": 6.046
  },
  {
    "id": 11,
    "text": "迫切要求重建儒家思想权威、革除时弊。",
    "start": 60.471,
    "end": 63.729,
    "duration": 3.258
  },
  {
    "id": 12,
    "text": "韩愈认为佛老学说削弱了国家伦理与财税根基，",
    "start": 64.196,
    "end": 68.285,
    "duration": 4.089
  },
  {
    "id": 13,
    "text": "而魏晋六朝以来讲求声律对偶、流于浮靡的骈体文，难以承载严肃的政治议论与经世之道。",
    "start": 68.505,
    "end": 76.884,
    "duration": 8.379
  },
  {
    "id": 14,
    "text": "于是韩柳主张效法先秦两汉散体古文，假复古之名行革新之实，",
    "start": 77.442,
    "end": 83.935,
    "duration": 6.493
  },
  {
    "id": 15,
    "text": "破除形式主义积弊，重振儒家道统与致用精神。",
    "start": 84.357,
    "end": 88.538,
    "duration": 4.181
  },
  {
    "id": 16,
    "text": "第二，系统提出“文以明道”与“气盛言宜”的散文理论纲领。",
    "start": 88.884,
    "end": 93.898,
    "duration": 5.014
  },
  {
    "id": 17,
    "text": "在理论建设上，韩愈与柳宗元构建了系统的散文美学主张。",
    "start": 94.183,
    "end": 100.358,
    "duration": 6.175
  },
  {
    "id": 18,
    "text": "在文道关系上，韩愈倡导“文以明道”，柳宗元亦主张“辅时及物”，",
    "start": 100.516,
    "end": 105.955,
    "duration": 5.439
  },
  {
    "id": 19,
    "text": "强调文章必须以阐发儒家义理、干预现实政治为核心宗旨；",
    "start": 106.033,
    "end": 111.289,
    "duration": 5.256
  },
  {
    "id": 20,
    "text": "在创作方法上，提出“唯陈言之务去”，",
    "start": 111.619,
    "end": 115.04,
    "duration": 3.421
  },
  {
    "id": 21,
    "text": "主张“师其意不师其辞”，坚决反对因袭剽窃前人陈词；",
    "start": 115.178,
    "end": 119.341,
    "duration": 4.163
  },
  {
    "id": 22,
    "text": "在文气修养上，提出“气盛则言之短长与声之高下者皆宜”，",
    "start": 119.85,
    "end": 123.583,
    "duration": 3.733
  },
  {
    "id": 23,
    "text": "认为作家内在的道德修养与精神气象决定文章的声气和谐；",
    "start": 123.818,
    "end": 129.094,
    "duration": 5.276
  },
  {
    "id": 24,
    "text": "在抒情动因上，韩愈提出“大凡物不得其平则鸣”，",
    "start": 129.168,
    "end": 133.527,
    "duration": 4.359
  },
  {
    "id": 25,
    "text": "揭示了文学创作源于现实不平与内心郁积的抒愤机制。",
    "start": 133.917,
    "end": 138.995,
    "duration": 5.078
  },
  {
    "id": 26,
    "text": "第三，革除骈体浮靡积弊，以单行散体打破排比对偶的文体束缚。",
    "start": 139.095,
    "end": 147.119,
    "duration": 8.024
  },
  {
    "id": 27,
    "text": "古文运动在文体形式上的突出贡献，",
    "start": 147.342,
    "end": 149.97,
    "duration": 2.628
  },
  {
    "id": 28,
    "text": "在于打破了六朝以来排比对偶与声病音律对文章表达的长期束缚。",
    "start": 150.319,
    "end": 155.791,
    "duration": 5.472
  },
  {
    "id": 29,
    "text": "韩柳倡导单行散体，句式长短错落、参差多变，随情意表达的需要自由舒卷。",
    "start": 156.016,
    "end": 162.422,
    "duration": 6.406
  },
  {
    "id": 30,
    "text": "他们又并不全盘排斥骈文，而是吸收先秦两汉典雅文言与六朝骈语精华，",
    "start": 162.718,
    "end": 168.64,
    "duration": 5.922
  },
  {
    "id": 31,
    "text": "同时吸纳时下鲜活词语，如“文从字顺”与自铸新词，",
    "start": 169.015,
    "end": 173.687,
    "duration": 4.672
  },
  {
    "id": 32,
    "text": "使散文重新恢复了叙写复杂史事、展开严密论辩与描摹客观景物的表现力，",
    "start": 174.022,
    "end": 180.036,
    "duration": 6.014
  },
  {
    "id": 33,
    "text": "大幅拓展了散文的体裁边界与艺术空间。",
    "start": 180.343,
    "end": 183.987,
    "duration": 3.644
  },
  {
    "id": 34,
    "text": "第四，韩柳散文各擅胜场，共同奠定唐宋古文运动的典范格局。",
    "start": 184.39,
    "end": 189.517,
    "duration": 5.127
  },
  {
    "id": 35,
    "text": "韩愈与柳宗元在散文创作上同中有异、相得益彰。",
    "start": 189.818,
    "end": 193.942,
    "duration": 4.124
  },
  {
    "id": 36,
    "text": "韩愈散文气势雄健、汪洋恣肆，在《师说》中以严密论辩批判士大夫耻于从师的陋习，",
    "start": 194.54,
    "end": 201.808,
    "duration": 7.268
  },
  {
    "id": 37,
    "text": "在《马说》中借千里马遭遇抒发人才被埋没的悲愤；",
    "start": 202.289,
    "end": 206.201,
    "duration": 3.912
  },
  {
    "id": 38,
    "text": "柳宗元散文则峭拔清峻、笔锋犀利，",
    "start": 206.402,
    "end": 209.605,
    "duration": 3.203
  },
  {
    "id": 39,
    "text": "在杂说名篇《捕蛇者说》中借蒋氏三代遭遇揭示“孰知赋敛之毒有甚是蛇者乎”的主题，",
    "start": 210.019,
    "end": 217.47,
    "duration": 7.451
  },
  {
    "id": 40,
    "text": "在山水游记《永州八记》中开辟了融身世之悲于自然清幽的独特意境。",
    "start": 217.6,
    "end": 223.205,
    "duration": 5.605
  },
  {
    "id": 41,
    "text": "韩柳散文使散体取代骈体占据文坛主位，为北宋欧阳修、苏轼等人的诗文革新奠定了坚实基础。",
    "start": 223.52,
    "end": 231.802,
    "duration": 8.282
  },
  {
    "id": 42,
    "text": "总而言之，唐代古文运动以复兴儒学与革新文风为内在动力，",
    "start": 232.2,
    "end": 237.519,
    "duration": 5.319
  },
  {
    "id": 43,
    "text": "依托“文以明道”与“气盛言宜”的理论建设，",
    "start": 237.977,
    "end": 241.257,
    "duration": 3.28
  },
  {
    "id": 44,
    "text": "以单行散体打破了六朝以来骈俪文风的形式束缚。",
    "start": 241.675,
    "end": 246.223,
    "duration": 4.548
  },
  {
    "id": 45,
    "text": "韩愈的雄奇奔放与柳宗元的精深清幽相得益彰，使散体散文重回文坛正宗，",
    "start": 246.586,
    "end": 253.43,
    "duration": 6.844
  },
  {
    "id": 46,
    "text": "更为北宋欧阳修、苏轼推进诗文革新运动确立了思想与文体先声。",
    "start": 253.674,
    "end": 259.676,
    "duration": 6.002
  }
]