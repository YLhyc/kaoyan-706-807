[
  {
    "id": 1,
    "text": "试论唐代古文运动的发生机制、理论主张与韩柳散文艺术。",
    "start": 0.05,
    "end": 5.154,
    "duration": 5.104
  },
  {
    "id": 2,
    "text": "唐代古文运动是由韩愈、柳宗元在中唐时期领导的一场散文文体与文风革新运动。",
    "start": 5.654,
    "end": 12.758,
    "duration": 7.104
  },
  {
    "id": 3,
    "text": "面对安史之乱后藩镇割据加剧、朝政衰败、佛老盛行冲击儒学正统，以及六朝以来骈俪文风雕琢辞藻、内容空虚的局面，",
    "start": 13.258,
    "end": 23.781,
    "duration": 10.523
  },
  {
    "id": 4,
    "text": "韩柳以复古为号召，掀起了旨在恢复先秦两汉散文传统的文学变革。",
    "start": 24.131,
    "end": 29.914,
    "duration": 5.783
  },
  {
    "id": 5,
    "text": "苏轼赞韩愈“文起八代之衰，道济天下之溺”。",
    "start": 30.414,
    "end": 34.274,
    "duration": 3.86
  },
  {
    "id": 6,
    "text": "古文运动的发生机制、理论纲领与韩柳散文艺术，主要体现在以下四个方面：",
    "start": 34.774,
    "end": 41.083,
    "duration": 6.309
  },
  {
    "id": 7,
    "text": "第一，立足中唐社会危局与儒学复兴诉求，确立以复古为革新的发生机制。",
    "start": 41.433,
    "end": 47.002,
    "duration": 5.569
  },
  {
    "id": 8,
    "text": "古文运动不仅是一场文体文字改革，更与中唐政治革新与儒学复兴思潮紧密相连。",
    "start": 47.502,
    "end": 54.578,
    "duration": 7.076
  },
  {
    "id": 9,
    "text": "安史之乱打破了大唐盛世的繁荣局面，士大夫深感国势衰落与纲常解体，",
    "start": 55.532,
    "end": 61.568,
    "duration": 6.036
  },
  {
    "id": 10,
    "text": "迫切要求重建儒家思想权威、革除时弊。",
    "start": 61.983,
    "end": 65.221,
    "duration": 3.238
  },
  {
    "id": 11,
    "text": "韩愈认为佛老学说削弱了国家伦理与财税根基，",
    "start": 65.721,
    "end": 69.81,
    "duration": 4.089
  },
  {
    "id": 12,
    "text": "而魏晋六朝以来讲求声律对偶、流于浮靡的骈体文，难以承载严肃的政治议论与经世之道。",
    "start": 70.16,
    "end": 78.529,
    "duration": 8.369
  },
  {
    "id": 13,
    "text": "于是韩柳主张效法先秦两汉散体古文，假复古之名行革新之实，",
    "start": 79.097,
    "end": 85.58,
    "duration": 6.483
  },
  {
    "id": 14,
    "text": "破除形式主义积弊，重振儒家道统与致用精神。",
    "start": 86.032,
    "end": 90.193,
    "duration": 4.161
  },
  {
    "id": 15,
    "text": "第二，系统提出“文以明道”与“气盛言宜”的散文理论纲领。",
    "start": 90.693,
    "end": 95.707,
    "duration": 5.014
  },
  {
    "id": 16,
    "text": "在理论建设上，韩愈与柳宗元构建了系统的散文美学主张。",
    "start": 96.207,
    "end": 102.382,
    "duration": 6.175
  },
  {
    "id": 17,
    "text": "在文道关系上，韩愈倡导“文以明道”，柳宗元亦主张“辅时及物”，",
    "start": 102.882,
    "end": 108.321,
    "duration": 5.439
  },
  {
    "id": 18,
    "text": "强调文章必须以阐发儒家义理、干预现实政治为核心宗旨；",
    "start": 108.671,
    "end": 113.917,
    "duration": 5.246
  },
  {
    "id": 19,
    "text": "在创作方法上，提出“唯陈言之务去”，",
    "start": 114.417,
    "end": 117.818,
    "duration": 3.401
  },
  {
    "id": 20,
    "text": "主张“师其意不师其辞”，坚决反对因袭剽窃前人陈词；",
    "start": 118.168,
    "end": 122.321,
    "duration": 4.153
  },
  {
    "id": 21,
    "text": "在文气修养上，提出“气盛则言之短长与声之高下者皆宜”，",
    "start": 122.84,
    "end": 126.573,
    "duration": 3.733
  },
  {
    "id": 22,
    "text": "认为作家内在的道德修养与精神气象决定文章的声气和谐；",
    "start": 126.923,
    "end": 132.199,
    "duration": 5.276
  },
  {
    "id": 23,
    "text": "在抒情动因上，韩愈提出“大凡物不得其平则鸣”，",
    "start": 132.699,
    "end": 137.048,
    "duration": 4.349
  },
  {
    "id": 24,
    "text": "揭示了文学创作源于现实不平与内心郁积的抒愤机制。",
    "start": 137.448,
    "end": 142.526,
    "duration": 5.078
  },
  {
    "id": 25,
    "text": "第三，革除骈体浮靡积弊，以单行散体打破排比对偶的文体束缚。",
    "start": 143.026,
    "end": 151.05,
    "duration": 8.024
  },
  {
    "id": 26,
    "text": "古文运动在文体形式上的突出贡献，",
    "start": 151.55,
    "end": 154.178,
    "duration": 2.628
  },
  {
    "id": 27,
    "text": "在于打破了六朝以来排比对偶与声病音律对文章表达的长期束缚。",
    "start": 154.528,
    "end": 160.0,
    "duration": 5.472
  },
  {
    "id": 28,
    "text": "韩柳倡导单行散体，句式长短错落、参差多变，随情意表达的需要自由舒卷。",
    "start": 160.5,
    "end": 166.906,
    "duration": 6.406
  },
  {
    "id": 29,
    "text": "他们又并不全盘排斥骈文，而是吸收先秦两汉典雅文言与六朝骈语精华，",
    "start": 167.406,
    "end": 173.328,
    "duration": 5.922
  },
  {
    "id": 30,
    "text": "同时吸纳时下鲜活词语，如“文从字顺”与自铸新词，",
    "start": 173.723,
    "end": 178.375,
    "duration": 4.652
  },
  {
    "id": 31,
    "text": "使散文重新恢复了叙写复杂史事、展开严密论辩与描摹客观景物的表现力，",
    "start": 178.73,
    "end": 184.724,
    "duration": 5.994
  },
  {
    "id": 32,
    "text": "大幅拓展了散文的体裁边界与艺术空间。",
    "start": 185.074,
    "end": 188.708,
    "duration": 3.634
  },
  {
    "id": 33,
    "text": "第四，韩柳散文各擅胜场，共同奠定唐宋古文运动的典范格局。",
    "start": 189.208,
    "end": 194.325,
    "duration": 5.117
  },
  {
    "id": 34,
    "text": "韩愈与柳宗元在散文创作上同中有异、相得益彰。",
    "start": 194.825,
    "end": 198.919,
    "duration": 4.094
  },
  {
    "id": 35,
    "text": "韩愈散文气势雄健、汪洋恣肆，在《师说》中以严密论辩批判士大夫耻于从师的陋习，",
    "start": 199.527,
    "end": 206.795,
    "duration": 7.268
  },
  {
    "id": 36,
    "text": "在《马说》中借千里马遭遇抒发人才被埋没的悲愤；",
    "start": 207.276,
    "end": 211.178,
    "duration": 3.902
  },
  {
    "id": 37,
    "text": "柳宗元散文则峭拔清峻、笔锋犀利，",
    "start": 211.678,
    "end": 214.851,
    "duration": 3.173
  },
  {
    "id": 38,
    "text": "在杂说名篇《捕蛇者说》中借蒋氏三代遭遇揭示“孰知赋敛之毒有甚是蛇者乎”的主题，",
    "start": 215.275,
    "end": 222.726,
    "duration": 7.451
  },
  {
    "id": 39,
    "text": "在山水游记《永州八记》中开辟了融身世之悲于自然清幽的独特意境。",
    "start": 223.076,
    "end": 228.671,
    "duration": 5.595
  },
  {
    "id": 40,
    "text": "韩柳散文使散体取代骈体占据文坛主位，为北宋欧阳修、苏轼等人的诗文革新奠定了坚实基础。",
    "start": 229.171,
    "end": 237.443,
    "duration": 8.272
  },
  {
    "id": 41,
    "text": "总而言之，唐代古文运动以复兴儒学与革新文风为内在动力，",
    "start": 237.943,
    "end": 243.232,
    "duration": 5.289
  },
  {
    "id": 42,
    "text": "依托“文以明道”与“气盛言宜”的理论建设，",
    "start": 243.72,
    "end": 246.97,
    "duration": 3.25
  },
  {
    "id": 43,
    "text": "以单行散体打破了六朝以来骈俪文风的形式束缚。",
    "start": 247.418,
    "end": 251.946,
    "duration": 4.528
  },
  {
    "id": 44,
    "text": "韩愈的雄奇奔放与柳宗元的精深清幽相得益彰，使散体散文重回文坛正宗，",
    "start": 252.446,
    "end": 259.28,
    "duration": 6.834
  },
  {
    "id": 45,
    "text": "更为北宋欧阳修、苏轼推进诗文革新运动确立了思想与文体先声。",
    "start": 259.63,
    "end": 265.632,
    "duration": 6.002
  }
]
