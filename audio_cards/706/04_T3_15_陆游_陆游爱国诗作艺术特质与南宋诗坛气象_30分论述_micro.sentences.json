[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "陆游·爱国诗作艺术特质与南宋诗坛气象",
    "start": 0.314,
    "end": 3.966,
    "duration": 3.652
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "精神内核→艺术来源→体裁多元→时代影响：先树立“终生复国大旗”的精神高度，",
    "start": 4.974,
    "end": 12.546,
    "duration": 7.572
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再解释艺术上如何破开江西诗派生涩、融合李白狂想与杜甫沉郁，",
    "start": 12.854,
    "end": 18.506,
    "duration": 5.652
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "继而补充他并不单一刚猛、更有游山西村与沈园七律工稳，最后定格振起南宋、激励后世救亡。",
    "start": 18.934,
    "end": 27.346,
    "duration": 8.412
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "陆游是南宋“中兴四大诗人”成就最著者。",
    "start": 28.354,
    "end": 32.246,
    "duration": 3.892
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "面对偏安沦丧现实，他吸取江西“活法”融汇李白飘逸与杜甫沉郁，九千余首为南宋注入刚健时代强音。",
    "start": 33.254,
    "end": 44.466,
    "duration": 11.212
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 抗敌复国贯穿一生、忧民痛国之慨",
    "start": 45.554,
    "end": 49.846,
    "duration": 4.292
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "绍兴和议后矢志不渝：《关山月》痛斥和戎偷安；",
    "start": 50.894,
    "end": 56.306,
    "duration": 5.412
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "《书愤》“楼船夜雪瓜洲渡，铁马秋风大散关”对照“镜中衰鬓”抒报国无门痛；临终《示儿》遗嘱；",
    "start": 57.394,
    "end": 67.746,
    "duration": 10.352
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "清末梁启超赞其“亘古男儿一放翁”，感染力穿透千古。",
    "start": 68.274,
    "end": 73.126,
    "duration": 4.852
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 融李白飘逸与杜甫沉郁、豪放而谨严",
    "start": 74.094,
    "end": 77.986,
    "duration": 3.892
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《十一月四日风雨大作》“铁马冰河入梦来”如李白驰骋；",
    "start": 78.994,
    "end": 84.286,
    "duration": 5.292
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "《三月十七日夜醉中作》“破驿梦回灯欲死”直追杜甫沉雄；",
    "start": 85.414,
    "end": 90.386,
    "duration": 4.972
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "虽师从曾几并私淑吕本中，却跳出江西堆砌生涩牢笼，明朗晓畅驾驭严整章法，",
    "start": 90.913,
    "end": 100.205,
    "duration": 9.292
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "合赵翼《瓯北诗话》“看似奔放实则谨严”。",
    "start": 100.673,
    "end": 103.725,
    "duration": 3.052
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 广摄村居与沈园真情、尤擅七律工对",
    "start": 104.42,
    "end": 108.912,
    "duration": 4.492
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《游山西村》“山重水复疑无路，柳暗花明又一村”、《临安春雨初霁》见生活之爱；",
    "start": 109.652,
    "end": 118.184,
    "duration": 8.532
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "晚年《沈园》追忆唐氏“曾是惊鸿照影来”；",
    "start": 118.652,
    "end": 122.104,
    "duration": 3.452
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "七古七律七绝均精，尤以七律对仗工整而不纤巧，刘克庄赞“古人好对偶被放翁用尽”。",
    "start": 123.152,
    "end": 132.404,
    "duration": 9.252
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 扭转南宋颓靡诗风、激励救亡文学",
    "start": 133.372,
    "end": 137.624,
    "duration": 4.252
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "以黄钟大吕取代江西末流枯燥，与杨万里、范成大等共推宋诗南渡后开辟新生面；",
    "start": 138.592,
    "end": 146.644,
    "duration": 8.052
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "林景熙赞其承杜甫诗史，江湖派戴复古、刘克庄受其熏陶；虽闲居作偶滑易，家国大义长久感召近代救亡诗篇。",
    "start": 147.612,
    "end": 161.804,
    "duration": 14.192
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "陆游将抗敌复国执念与平易晓畅融为一体，兼融李白豪迈与杜甫沉郁，",
    "start": 162.812,
    "end": 169.584,
    "duration": 6.772
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "与杨万里、范成大推动宋诗开新生面，爱国雄声激荡后代国难文学。",
    "start": 169.852,
    "end": 176.184,
    "duration": 6.332
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：南宋“中兴四大诗人”（杨万里、范成大、陆游、尤袤）中陆游成就最高；",
    "start": 177.192,
    "end": 184.324,
    "duration": 7.132
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "梁启超赞“亘古男儿一放翁”，赵翼评“看似奔放，实则谨严”，刘克庄赞“古人好对偶被放翁用尽”。",
    "start": 185.412,
    "end": 194.024,
    "duration": 8.612
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背诵梁启超、赵翼《瓯北诗话》、刘克庄评价陆游的三句名评？",
    "start": 194.992,
    "end": 201.084,
    "duration": 6.092
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 如何说明陆游在学习江西“活法”的同时兼融了李白豪放与杜甫沉郁？",
    "start": 202.132,
    "end": 209.224,
    "duration": 7.092
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 兼顾爱国壮怀、日常村居、沈园悼情列出六首陆游核心代表作？",
    "start": 209.674,
    "end": 216.966,
    "duration": 7.292
  }
]