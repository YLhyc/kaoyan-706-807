[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "陆游·爱国诗作艺术特质与南宋诗坛气象",
    "start": 0.134,
    "end": 3.935,
    "duration": 3.801
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "精神内核→艺术来源→体裁多元→时代影响：先树立“终生复国大旗”的精神高度，",
    "start": 4.524,
    "end": 12.075,
    "duration": 7.551
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再解释艺术上如何破开江西诗派生涩、融合李白狂想与杜甫沉郁，",
    "start": 12.389,
    "end": 18.403,
    "duration": 6.015
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "继而补充他并不单一刚猛、更有游山西村与沈园七律工稳，最后定格振起南宋、激励后世救亡。",
    "start": 18.504,
    "end": 26.759,
    "duration": 8.254
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "陆游是南宋“中兴四大诗人”成就最著者。",
    "start": 27.345,
    "end": 30.574,
    "duration": 3.228
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "面对偏安沦丧现实，他吸取江西“活法”融汇李白飘逸与杜甫沉郁，九千余首为南宋注入刚健时代强音。",
    "start": 31.148,
    "end": 41.29,
    "duration": 10.142
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 抗敌复国贯穿一生、忧民痛国之慨",
    "start": 41.877,
    "end": 45.73,
    "duration": 3.853
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "绍兴和议后矢志不渝：《关山月》痛斥和戎偷安；",
    "start": 46.304,
    "end": 51.068,
    "duration": 4.765
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "《书愤》“楼船夜雪瓜洲渡，铁马秋风大散关”对照“镜中衰鬓”抒报国无门痛；临终《示儿》遗嘱；",
    "start": 51.382,
    "end": 59.337,
    "duration": 7.955
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "清末梁启超赞其“亘古男儿一放翁”，感染力穿透千古。",
    "start": 59.924,
    "end": 64.975,
    "duration": 5.051
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 融李白飘逸与杜甫沉郁、豪放而谨严",
    "start": 65.562,
    "end": 69.818,
    "duration": 4.257
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《十一月四日风雨大作》“铁马冰河入梦来”如李白驰骋；",
    "start": 70.405,
    "end": 75.417,
    "duration": 5.012
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "《三月十七日夜醉中作》“破驿梦回灯欲死”直追杜甫沉雄；",
    "start": 75.77,
    "end": 80.105,
    "duration": 4.335
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "虽师从曾几并私淑吕本中，却跳出江西堆砌生涩牢笼，明朗晓畅驾驭严整章法，",
    "start": 80.679,
    "end": 89.206,
    "duration": 8.528
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "合赵翼《瓯北诗话》“看似奔放实则谨严”。",
    "start": 89.468,
    "end": 92.514,
    "duration": 3.046
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 广摄村居与沈园真情、尤擅七律工对",
    "start": 93.101,
    "end": 97.423,
    "duration": 4.322
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《游山西村》“山重水复疑无路，柳暗花明又一村”、《临安春雨初霁》见生活之爱；",
    "start": 97.996,
    "end": 105.561,
    "duration": 7.564
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "晚年《沈园》追忆唐氏“曾是惊鸿照影来”；",
    "start": 105.874,
    "end": 109.35,
    "duration": 3.476
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "七古七律七绝均精，尤以七律对仗工整而不纤巧，刘克庄赞“古人好对偶被放翁用尽”。",
    "start": 109.924,
    "end": 118.477,
    "duration": 8.554
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 扭转南宋颓靡诗风、激励救亡文学",
    "start": 119.051,
    "end": 122.865,
    "duration": 3.814
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "以黄钟大吕取代江西末流枯燥，与杨万里、范成大等共推宋诗南渡后开辟新生面；",
    "start": 123.439,
    "end": 131.967,
    "duration": 8.528
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "林景熙赞其承杜甫诗史，江湖派戴复古、刘克庄受其熏陶；虽闲居作偶滑易，家国大义长久感召近代救亡诗篇。",
    "start": 132.554,
    "end": 144.05,
    "duration": 11.496
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "陆游将抗敌复国执念与平易晓畅融为一体，兼融李白豪迈与杜甫沉郁，",
    "start": 144.637,
    "end": 151.277,
    "duration": 6.64
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "与杨万里、范成大推动宋诗开新生面，爱国雄声激荡后代国难文学。",
    "start": 151.603,
    "end": 157.657,
    "duration": 6.054
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：南宋“中兴四大诗人”（杨万里、范成大、陆游、尤袤）中陆游成就最高；",
    "start": 158.244,
    "end": 165.717,
    "duration": 7.473
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "梁启超赞“亘古男儿一放翁”，赵翼评“看似奔放，实则谨严”，刘克庄赞“古人好对偶被放翁用尽”。",
    "start": 165.874,
    "end": 173.998,
    "duration": 8.124
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背诵梁启超、赵翼《瓯北诗话》、刘克庄评价陆游的三句名评？",
    "start": 174.585,
    "end": 181.29,
    "duration": 6.705
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 如何说明陆游在学习江西“活法”的同时兼融了李白豪放与杜甫沉郁？",
    "start": 181.864,
    "end": 188.92,
    "duration": 7.056
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 兼顾爱国壮怀、日常村居、沈园悼情列出六首陆游核心代表作？",
    "start": 189.507,
    "end": 196.654,
    "duration": 7.147
  }
]