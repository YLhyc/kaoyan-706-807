[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "精神内核→艺术来源→体裁多元→时代影响：先树立“终生复国大旗”的精神高度，",
    "start": 0.238,
    "end": 7.772,
    "duration": 7.535
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再解释艺术上如何破开江西诗派生涩、融合李白狂想与杜甫沉郁，",
    "start": 8.576,
    "end": 13.975,
    "duration": 5.399
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "继而补充他并不单一刚猛、更有游山西村与沈园七律工稳，",
    "start": 14.692,
    "end": 19.452,
    "duration": 4.76
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后定格振起南宋、激励后世救亡。",
    "start": 20.211,
    "end": 23.08,
    "duration": 2.869
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "陆游是南宋“中兴四大诗人”成就最著者。",
    "start": 23.8,
    "end": 27.072,
    "duration": 3.272
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "面对偏安沦丧现实，他吸取江西“活法”融汇李白飘逸与杜甫沉郁，九千余首为南宋注入刚健时代强音。",
    "start": 27.78,
    "end": 37.168,
    "duration": 9.388
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 抗敌复国贯穿一生、忧民痛国之慨",
    "start": 37.867,
    "end": 41.469,
    "duration": 3.602
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "绍兴和议后矢志不渝：《关山月》痛斥和戎偷安；",
    "start": 42.212,
    "end": 45.951,
    "duration": 3.739
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "《书愤》“楼船夜雪瓜洲渡，铁马秋风大散关”对照“镜中衰鬓”抒报国无门痛；临终《示儿》遗嘱；",
    "start": 46.707,
    "end": 54.454,
    "duration": 7.748
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "清末梁启超赞其“亘古男儿一放翁”，感染力穿透千古。",
    "start": 55.184,
    "end": 59.365,
    "duration": 4.181
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 融李白飘逸与杜甫沉郁、豪放而谨严",
    "start": 60.15,
    "end": 64.375,
    "duration": 4.225
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《十一月四日风雨大作》“铁马冰河入梦来”如李白驰骋；",
    "start": 65.116,
    "end": 69.389,
    "duration": 4.273
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "《三月十七日夜醉中作》“破驿梦回灯欲死”直追杜甫沉雄；",
    "start": 70.142,
    "end": 74.552,
    "duration": 4.41
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "虽师从曾几并私淑吕本中，却跳出江西堆砌生涩牢笼，明朗晓畅驾驭严整章法，",
    "start": 75.3,
    "end": 82.558,
    "duration": 7.259
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "合赵翼《瓯北诗话》“看似奔放实则谨严”。",
    "start": 83.428,
    "end": 86.407,
    "duration": 2.978
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 广摄村居与沈园真情、尤擅七律工对",
    "start": 87.139,
    "end": 91.336,
    "duration": 4.197
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《游山西村》“山重水复疑无路，柳暗花明又一村”、《临安春雨初霁》见生活之爱；",
    "start": 92.135,
    "end": 98.484,
    "duration": 6.349
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "晚年《沈园》追忆唐氏“曾是惊鸿照影来”；",
    "start": 99.271,
    "end": 102.131,
    "duration": 2.86
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "七古七律七绝均精，尤以七律对仗工整而不纤巧，刘克庄赞“古人好对偶被放翁用尽”。",
    "start": 102.849,
    "end": 110.178,
    "duration": 7.329
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 扭转南宋颓靡诗风、激励救亡文学",
    "start": 110.934,
    "end": 114.594,
    "duration": 3.66
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "以黄钟大吕取代江西末流枯燥，与杨万里、范成大等共推宋诗南渡后开辟新生面；",
    "start": 115.341,
    "end": 122.854,
    "duration": 7.513
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "林景熙赞其承杜甫诗史，江湖派戴复古、刘克庄受其熏陶；",
    "start": 123.639,
    "end": 129.048,
    "duration": 5.409
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "虽闲居作偶滑易，家国大义长久感召近代救亡诗篇。",
    "start": 129.808,
    "end": 134.315,
    "duration": 4.507
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "陆游将抗敌复国执念与平易晓畅融为一体，兼融李白豪迈与杜甫沉郁，",
    "start": 135.08,
    "end": 141.41,
    "duration": 6.329
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "与杨万里、范成大推动宋诗开新生面，爱国雄声激荡后代国难文学。",
    "start": 142.12,
    "end": 147.907,
    "duration": 5.788
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：南宋“中兴四大诗人”（杨万里、范成大、陆游、尤袤）中陆游成就最高；",
    "start": 148.704,
    "end": 156.206,
    "duration": 7.501
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "梁启超赞“亘古男儿一放翁”，赵翼评“看似奔放，实则谨严”，",
    "start": 156.926,
    "end": 161.51,
    "duration": 4.584
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "刘克庄赞“古人好对偶被放翁用尽”。",
    "start": 162.232,
    "end": 164.819,
    "duration": 2.586
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背诵梁启超、赵翼《瓯北诗话》、刘克庄评价陆游的三句名评？",
    "start": 165.567,
    "end": 171.845,
    "duration": 6.278
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 如何说明陆游在学习江西“活法”的同时兼融了李白豪放与杜甫沉郁？",
    "start": 172.651,
    "end": 179.541,
    "duration": 6.89
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 兼顾爱国壮怀、日常村居、沈园悼情列出六首陆游核心代表作？",
    "start": 180.284,
    "end": 187.275,
    "duration": 6.991
  }
]