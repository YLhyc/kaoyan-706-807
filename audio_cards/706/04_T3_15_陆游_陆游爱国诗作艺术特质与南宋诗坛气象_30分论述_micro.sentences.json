[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "精神内核→艺术来源→体裁多元→时代影响：",
    "start": 0.0,
    "end": 4.44,
    "duration": 4.44
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先树立“终生复国大旗”的精神高度，",
    "start": 4.489,
    "end": 7.289,
    "duration": 2.8
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再解释艺术上如何破开江西诗派生涩、融合李白狂想与杜甫沉郁，",
    "start": 7.739,
    "end": 13.099,
    "duration": 5.36
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "继而补充他并不单一刚猛、更有游山西村与沈园七律工稳，",
    "start": 13.549,
    "end": 18.109,
    "duration": 4.56
  },
  {
    "id": "hook_c4",
    "dom_key": "hook_c4",
    "text": "最后定格振起南宋、激励后世救亡。",
    "start": 18.559,
    "end": 21.439,
    "duration": 2.88
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "陆游是南宋“中兴四大诗人”成就最著者。",
    "start": 21.969,
    "end": 25.049,
    "duration": 3.08
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "面对偏安沦丧现实，他吸取江西“活法”融汇李白飘逸与杜甫沉郁，",
    "start": 25.499,
    "end": 30.979,
    "duration": 5.48
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "九千余首为南宋注入刚健时代强音。",
    "start": 31.429,
    "end": 34.509,
    "duration": 3.08
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 抗敌复国贯穿一生、忧民痛国之慨",
    "start": 34.959,
    "end": 38.679,
    "duration": 3.72
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "绍兴和议后矢志不渝：《关山月》痛斥和戎偷安；",
    "start": 39.129,
    "end": 43.169,
    "duration": 4.04
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "《书愤》“楼船夜雪瓜洲渡，",
    "start": 43.619,
    "end": 45.619,
    "duration": 2.0
  },
  {
    "id": "sec0_step0_c2",
    "dom_key": "sec0_step0_c2",
    "text": "铁马秋风大散关”对照“镜中衰鬓”抒报国无门痛；",
    "start": 46.069,
    "end": 50.109,
    "duration": 4.04
  },
  {
    "id": "sec0_step0_c3",
    "dom_key": "sec0_step0_c3",
    "text": "临终《示儿》遗嘱；",
    "start": 50.559,
    "end": 51.679,
    "duration": 1.12
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "清末梁启超赞其“亘古男儿一放翁”，感染力穿透千古。",
    "start": 52.209,
    "end": 56.409,
    "duration": 4.2
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 融李白飘逸与杜甫沉郁、豪放而谨严",
    "start": 56.859,
    "end": 61.379,
    "duration": 4.52
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《十一月四日风雨大作》“铁马冰河入梦来”如李白驰骋；",
    "start": 61.829,
    "end": 66.149,
    "duration": 4.32
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "《三月十七日夜醉中作》“破驿梦回灯欲死”直追杜甫沉雄；",
    "start": 66.599,
    "end": 71.159,
    "duration": 4.56
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "虽师从曾几并私淑吕本中，却跳出江西堆砌生涩牢笼，",
    "start": 71.609,
    "end": 76.209,
    "duration": 4.6
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "明朗晓畅驾驭严整章法，合赵翼《瓯北诗话》“看似奔放实则谨严”。",
    "start": 76.739,
    "end": 82.419,
    "duration": 5.68
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 广摄村居与沈园真情、尤擅七律工对",
    "start": 82.869,
    "end": 87.629,
    "duration": 4.76
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《游山西村》“山重水复疑无路，",
    "start": 88.079,
    "end": 90.279,
    "duration": 2.2
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "柳暗花明又一村”、《临安春雨初霁》见生活之爱；",
    "start": 90.809,
    "end": 94.409,
    "duration": 3.6
  },
  {
    "id": "sec2_step0_c2",
    "dom_key": "sec2_step0_c2",
    "text": "晚年《沈园》追忆唐氏“曾是惊鸿照影来”；",
    "start": 94.859,
    "end": 98.179,
    "duration": 3.32
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "七古七律七绝均精，尤以七律对仗工整而不纤巧，",
    "start": 98.629,
    "end": 102.949,
    "duration": 4.32
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "刘克庄赞“古人好对偶被放翁用尽”。",
    "start": 103.479,
    "end": 106.199,
    "duration": 2.72
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 扭转南宋颓靡诗风、激励救亡文学",
    "start": 106.729,
    "end": 110.609,
    "duration": 3.88
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "以黄钟大吕取代江西末流枯燥，",
    "start": 111.059,
    "end": 113.659,
    "duration": 2.6
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "与杨万里、范成大等共推宋诗南渡后开辟新生面；",
    "start": 114.189,
    "end": 118.189,
    "duration": 4.0
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "林景熙赞其承杜甫诗史，江湖派戴复古、刘克庄受其熏陶；",
    "start": 118.719,
    "end": 123.599,
    "duration": 4.88
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "虽闲居作偶滑易，家国大义长久感召近代救亡诗篇。",
    "start": 124.049,
    "end": 128.529,
    "duration": 4.48
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "陆游将抗敌复国执念与平易晓畅融为一体，兼融李白豪迈与杜甫沉郁，",
    "start": 129.059,
    "end": 134.859,
    "duration": 5.8
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "与杨万里、范成大推动宋诗开新生面，爱国雄声激荡后代国难文学。",
    "start": 135.309,
    "end": 140.949,
    "duration": 5.64
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：南宋“中兴四大诗人”（杨万里、范成大、陆游、尤袤）中陆游成就最高；",
    "start": 141.399,
    "end": 147.959,
    "duration": 6.56
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "梁启超赞“亘古男儿一放翁”，赵翼评“看似奔放，实则谨严”，",
    "start": 148.409,
    "end": 153.009,
    "duration": 4.6
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "刘克庄赞“古人好对偶被放翁用尽”。",
    "start": 153.459,
    "end": 156.179,
    "duration": 2.72
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背诵梁启超、赵翼《瓯北诗话》、刘克庄评价陆游的三句名评？",
    "start": 156.629,
    "end": 163.189,
    "duration": 6.56
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 如何说明陆游在学习江西“活法”的同时兼融了李白豪放与杜甫沉郁？",
    "start": 163.639,
    "end": 170.679,
    "duration": 7.04
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 兼顾爱国壮怀、日常村居、沈园悼情列出六首陆游核心代表作？",
    "start": 171.129,
    "end": 177.929,
    "duration": 6.8
  }
]