[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "陆游·爱国诗作艺术特质与南宋诗坛气象",
    "start": 0.154,
    "end": 3.686,
    "duration": 3.532
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "精神内核→艺术来源→体裁多元→时代影响：先树立“终生复国大旗”的精神高度，",
    "start": 4.358,
    "end": 11.97,
    "duration": 7.612
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再解释艺术上如何破开江西诗派生涩、融合李白狂想与杜甫沉郁，",
    "start": 12.198,
    "end": 17.97,
    "duration": 5.772
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "继而补充他并不单一刚猛、更有游山西村与沈园七律工稳，最后定格振起南宋、激励后世救亡。",
    "start": 18.278,
    "end": 27.17,
    "duration": 8.892
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "陆游是南宋“中兴四大诗人”成就最著者。",
    "start": 27.645,
    "end": 31.017,
    "duration": 3.372
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "面对偏安沦丧现实，他吸取江西“活法”融汇李白飘逸与杜甫沉郁，九千余首为南宋注入刚健时代强音。",
    "start": 31.295,
    "end": 41.867,
    "duration": 10.572
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 抗敌复国贯穿一生、忧民痛国之慨",
    "start": 42.575,
    "end": 46.427,
    "duration": 3.852
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "绍兴和议后矢志不渝：《关山月》痛斥和戎偷安；",
    "start": 46.935,
    "end": 51.747,
    "duration": 4.812
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "《书愤》“楼船夜雪瓜洲渡，铁马秋风大散关”对照“镜中衰鬓”抒报国无门痛；临终《示儿》遗嘱；",
    "start": 51.945,
    "end": 61.447,
    "duration": 9.502
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "清末梁启超赞其“亘古男儿一放翁”，感染力穿透千古。",
    "start": 61.972,
    "end": 67.104,
    "duration": 5.132
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 融李白飘逸与杜甫沉郁、豪放而谨严",
    "start": 67.793,
    "end": 72.205,
    "duration": 4.412
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《十一月四日风雨大作》“铁马冰河入梦来”如李白驰骋；",
    "start": 72.702,
    "end": 78.074,
    "duration": 5.372
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "《三月十七日夜醉中作》“破驿梦回灯欲死”直追杜甫沉雄；",
    "start": 78.302,
    "end": 83.114,
    "duration": 4.812
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "虽师从曾几并私淑吕本中，却跳出江西堆砌生涩牢笼，明朗晓畅驾驭严整章法，",
    "start": 83.59,
    "end": 92.322,
    "duration": 8.732
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "合赵翼《瓯北诗话》“看似奔放实则谨严”。",
    "start": 92.47,
    "end": 95.682,
    "duration": 3.212
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 广摄村居与沈园真情、尤擅七律工对",
    "start": 96.39,
    "end": 100.402,
    "duration": 4.012
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《游山西村》“山重水复疑无路，柳暗花明又一村”、《临安春雨初霁》见生活之爱；",
    "start": 100.93,
    "end": 108.622,
    "duration": 7.692
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "晚年《沈园》追忆唐氏“曾是惊鸿照影来”；",
    "start": 108.85,
    "end": 112.142,
    "duration": 3.292
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "七古七律七绝均精，尤以七律对仗工整而不纤巧，刘克庄赞“古人好对偶被放翁用尽”。",
    "start": 112.67,
    "end": 121.642,
    "duration": 8.972
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 扭转南宋颓靡诗风、激励救亡文学",
    "start": 122.332,
    "end": 126.344,
    "duration": 4.012
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "以黄钟大吕取代江西末流枯燥，与杨万里、范成大等共推宋诗南渡后开辟新生面；",
    "start": 126.872,
    "end": 134.564,
    "duration": 7.692
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "林景熙赞其承杜甫诗史，江湖派戴复古、刘克庄受其熏陶；虽闲居作偶滑易，家国大义长久感召近代救亡诗篇。",
    "start": 135.083,
    "end": 148.025,
    "duration": 12.942
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "陆游将抗敌复国执念与平易晓畅融为一体，兼融李白豪迈与杜甫沉郁，",
    "start": 148.73,
    "end": 155.382,
    "duration": 6.652
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "与杨万里、范成大推动宋诗开新生面，爱国雄声激荡后代国难文学。",
    "start": 155.61,
    "end": 161.542,
    "duration": 5.932
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：南宋“中兴四大诗人”（杨万里、范成大、陆游、尤袤）中陆游成就最高；",
    "start": 162.229,
    "end": 169.201,
    "duration": 6.972
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "梁启超赞“亘古男儿一放翁”，赵翼评“看似奔放，实则谨严”，刘克庄赞“古人好对偶被放翁用尽”。",
    "start": 169.559,
    "end": 178.211,
    "duration": 8.652
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背诵梁启超、赵翼《瓯北诗话》、刘克庄评价陆游的三句名评？",
    "start": 178.841,
    "end": 185.813,
    "duration": 6.972
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 如何说明陆游在学习江西“活法”的同时兼融了李白豪放与杜甫沉郁？",
    "start": 186.3,
    "end": 192.952,
    "duration": 6.652
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 兼顾爱国壮怀、日常村居、沈园悼情列出六首陆游核心代表作？",
    "start": 193.401,
    "end": 200.373,
    "duration": 6.972
  }
]