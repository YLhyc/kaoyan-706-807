[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "诗体→心境→技艺→流向：先理解李商隐为何“摘题省事”改写无题心灵诗，",
    "start": 0.0,
    "end": 7.36,
    "duration": 7.36
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "从而制造多义空间；",
    "start": 7.409,
    "end": 9.009,
    "duration": 1.6
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "接着揭开晚唐党争与帝国暮景下的凄美底色；",
    "start": 9.459,
    "end": 13.099,
    "duration": 3.64
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "随后看他用珠泪、蝴蝶、玉烟与活用典故达到“沉博绝丽”；",
    "start": 13.629,
    "end": 18.549,
    "duration": 4.92
  },
  {
    "id": "hook_c4",
    "dom_key": "hook_c4",
    "text": "最终落于唐诗向内向精微、西昆与婉约词演变之枢纽。",
    "start": 18.999,
    "end": 23.679,
    "duration": 4.68
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "李商隐身处晚唐藩镇党争夹缝，开创深情绵邈、绮丽精工“无题诗”范式，",
    "start": 24.129,
    "end": 30.369,
    "duration": 6.24
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "元好问《论诗三十首》赞“诗家总爱西昆好，独恨无人作郑笺”。",
    "start": 30.819,
    "end": 35.899,
    "duration": 5.08
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 创“无题”诗体、重心灵体验与多义",
    "start": 36.429,
    "end": 39.869,
    "duration": 3.44
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "淡化具体时地事件，或题“无题”或截取首二字，",
    "start": 40.319,
    "end": 44.159,
    "duration": 3.84
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "直接表现心灵情绪与整体心境；",
    "start": 44.609,
    "end": 47.249,
    "duration": 2.64
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《无题》“春蚕到死丝方尽，蜡炬成灰泪始干”写执着深情，",
    "start": 47.699,
    "end": 52.539,
    "duration": 4.84
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《锦瑟》“一弦一柱思华年”统摄全篇，省略本事因果，",
    "start": 52.989,
    "end": 57.429,
    "duration": 4.44
  },
  {
    "id": "sec0_step1_c2",
    "dom_key": "sec0_step1_c2",
    "text": "兼容爱情与身世政治寄托。",
    "start": 57.879,
    "end": 60.199,
    "duration": 2.32
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 构筑凄美怅惘基调、折射晚唐心境",
    "start": 60.649,
    "end": 64.849,
    "duration": 4.2
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "随帝国没落与党争失意，盛唐豪迈消退，代之以幽微孤独、失落与无力感；",
    "start": 65.299,
    "end": 71.299,
    "duration": 6.0
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《昨夜星辰》写“心有灵犀一点通”契合与“走马兰台类转蓬”无奈；",
    "start": 71.749,
    "end": 76.429,
    "duration": 4.68
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "《乐游原》“夕阳无限好，只是近黄昏”成盛衰幻灭共声。",
    "start": 76.879,
    "end": 81.199,
    "duration": 4.32
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 精研意象用典、臻“沉博绝丽”境",
    "start": 81.729,
    "end": 85.449,
    "duration": 3.72
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "现“绮密瑰妍”“沉博绝丽”之风：",
    "start": 85.899,
    "end": 88.379,
    "duration": 2.48
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "化情绪为珠泪、玉烟、蓬山、青鸟跳跃组合，营造雾里看花凄艳诗境；",
    "start": 88.829,
    "end": 94.589,
    "duration": 5.76
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "取情韵而不拘原事，《锦瑟》“庄生晓梦迷蝴蝶，望帝春心托杜鹃”喻迷惘，",
    "start": 95.039,
    "end": 101.639,
    "duration": 6.6
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "颈联“沧海月明珠有泪”等对仗浑融、哀痛难言。",
    "start": 102.089,
    "end": 105.969,
    "duration": 3.88
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 引领内向演进、启西昆体与婉约词",
    "start": 106.499,
    "end": 110.579,
    "duration": 4.08
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "标志唐诗由盛唐开阔外向转向幽微内心世界开掘，",
    "start": 111.029,
    "end": 115.429,
    "duration": 4.4
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "在李杜韩白后辟幽约深浑新境；",
    "start": 115.879,
    "end": 118.559,
    "duration": 2.68
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "催生宋初杨亿、钱惟演“西昆体”，并与温庭筠同滋养李煜及两宋婉约词风。",
    "start": 119.009,
    "end": 125.649,
    "duration": 6.64
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "李商隐无题诗以晚唐怅惘为底，",
    "start": 126.099,
    "end": 128.939,
    "duration": 2.84
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "借典丽多义意象把盛唐外向诗风转向幽深内向，",
    "start": 129.389,
    "end": 133.549,
    "duration": 4.16
  },
  {
    "id": "concl_c2",
    "dom_key": "concl_c2",
    "text": "这种“沉博绝丽”美学既孕育宋初西昆体，也深厚滋养晚唐两宋婉约词风。",
    "start": 133.999,
    "end": 139.959,
    "duration": 5.96
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：元好问《论诗三十首》赞“诗家总爱西昆好，独恨无人作郑笺”；",
    "start": 140.409,
    "end": 145.889,
    "duration": 5.48
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "注意李商隐“沉博绝丽”开宋初西昆体与晚唐五代婉约词风。",
    "start": 146.339,
    "end": 151.459,
    "duration": 5.12
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 元好问对李商隐哪句诗评价最经典？",
    "start": 151.909,
    "end": 155.549,
    "duration": 3.64
  },
  {
    "id": "drill0_c1",
    "dom_key": "drill0_c1",
    "text": "“无题”命名机制有何妙处？",
    "start": 155.999,
    "end": 157.999,
    "duration": 2.0
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《锦瑟》“庄生晓梦”与“沧海月明”两联解释“沉博绝丽”？",
    "start": 158.449,
    "end": 164.249,
    "duration": 5.8
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 概括李商隐在盛唐、中唐、宋初诗体与晚唐五代词之间的枢纽地位？",
    "start": 164.699,
    "end": 171.499,
    "duration": 6.8
  }
]