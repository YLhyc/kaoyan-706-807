[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "李商隐·无题诗艺术特质与晚唐诗歌审美演变",
    "start": 0.134,
    "end": 4.339,
    "duration": 4.205
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "诗体→心境→技艺→流向：先理解李商隐为何“摘题省事”改写无题心灵诗，从而制造多义空间；",
    "start": 4.928,
    "end": 14.211,
    "duration": 9.283
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "接着揭开晚唐党争与帝国暮景下的凄美底色；",
    "start": 14.511,
    "end": 18.638,
    "duration": 4.127
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "随后看他用珠泪、蝴蝶、玉烟与活用典故达到“沉博绝丽”；",
    "start": 18.977,
    "end": 24.259,
    "duration": 5.281
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最终落于唐诗向内向精微、西昆与婉约词演变之枢纽。",
    "start": 24.546,
    "end": 29.675,
    "duration": 5.129
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "李商隐身处晚唐藩镇党争夹缝，开创深情绵邈、绮丽精工“无题诗”范式，",
    "start": 30.262,
    "end": 36.394,
    "duration": 6.132
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "元好问《论诗三十首》赞“诗家总爱西昆好，独恨无人作郑笺”。",
    "start": 36.707,
    "end": 41.759,
    "duration": 5.051
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 创“无题”诗体、重心灵体验与多义",
    "start": 42.332,
    "end": 45.834,
    "duration": 3.502
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "淡化具体时地事件，或题“无题”或截取首二字，直接表现心灵情绪与整体心境；",
    "start": 46.42,
    "end": 54.089,
    "duration": 7.668
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《无题》“春蚕到死丝方尽，蜡炬成灰泪始干”写执着深情，",
    "start": 54.663,
    "end": 60.691,
    "duration": 6.028
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《锦瑟》“一弦一柱思华年”统摄全篇，省略本事因果，兼容爱情与身世政治寄托。",
    "start": 60.991,
    "end": 67.761,
    "duration": 6.77
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 构筑凄美怅惘基调、折射晚唐心境",
    "start": 68.348,
    "end": 72.084,
    "duration": 3.736
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "随帝国没落与党争失意，盛唐豪迈消退，代之以幽微孤独、失落与无力感；",
    "start": 72.671,
    "end": 80.235,
    "duration": 7.564
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《昨夜星辰》写“心有灵犀一点通”契合与“走马兰台类转蓬”无奈；",
    "start": 80.809,
    "end": 87.709,
    "duration": 6.9
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "《乐游原》“夕阳无限好，只是近黄昏”成盛衰幻灭共声。",
    "start": 87.931,
    "end": 92.553,
    "duration": 4.621
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 精研意象用典、臻“沉博绝丽”境",
    "start": 93.14,
    "end": 96.993,
    "duration": 3.853
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "现“绮密瑰妍”“沉博绝丽”之风：化情绪为珠泪、玉烟、蓬山、青鸟跳跃组合，营造雾里看花凄艳诗境；",
    "start": 97.58,
    "end": 107.618,
    "duration": 10.038
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "取情韵而不拘原事，《锦瑟》“庄生晓梦迷蝴蝶，望帝春心托杜鹃”喻迷惘，",
    "start": 108.192,
    "end": 115.235,
    "duration": 7.043
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "颈联“沧海月明珠有泪”等对仗浑融、哀痛难言。",
    "start": 115.47,
    "end": 119.428,
    "duration": 3.957
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 引领内向演进、启西昆体与婉约词",
    "start": 120.015,
    "end": 124.141,
    "duration": 4.127
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "标志唐诗由盛唐开阔外向转向幽微内心世界开掘，在李杜韩白后辟幽约深浑新境；",
    "start": 124.715,
    "end": 133.165,
    "duration": 8.449
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "催生宋初杨亿、钱惟演“西昆体”，并与温庭筠同滋养李煜及两宋婉约词风。",
    "start": 133.739,
    "end": 142.071,
    "duration": 8.332
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "李商隐无题诗以晚唐怅惘为底，借典丽多义意象把盛唐外向诗风转向幽深内向，",
    "start": 142.645,
    "end": 150.339,
    "duration": 7.694
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "这种“沉博绝丽”美学既孕育宋初西昆体，也深厚滋养晚唐两宋婉约词风。",
    "start": 150.653,
    "end": 157.201,
    "duration": 6.548
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：元好问《论诗三十首》赞“诗家总爱西昆好，独恨无人作郑笺”；",
    "start": 157.762,
    "end": 163.686,
    "duration": 5.923
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "注意李商隐“沉博绝丽”开宋初西昆体与晚唐五代婉约词风。",
    "start": 163.999,
    "end": 169.154,
    "duration": 5.155
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 元好问对李商隐哪句诗评价最经典？“无题”命名机制有何妙处？",
    "start": 169.715,
    "end": 176.837,
    "duration": 7.121
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《锦瑟》“庄生晓梦”与“沧海月明”两联解释“沉博绝丽”？",
    "start": 177.411,
    "end": 183.477,
    "duration": 6.067
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 概括李商隐在盛唐、中唐、宋初诗体与晚唐五代词之间的枢纽地位？",
    "start": 184.064,
    "end": 191.915,
    "duration": 7.851
  }
]