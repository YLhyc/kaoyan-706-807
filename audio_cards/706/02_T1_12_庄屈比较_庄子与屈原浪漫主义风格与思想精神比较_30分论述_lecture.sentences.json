[
  {
    "id": 1,
    "text": "试论庄子与屈原浪漫主义风格与思想精神的异同。",
    "start": 0.101,
    "end": 4.335,
    "duration": 4.234
  },
  {
    "id": 2,
    "text": "庄子与屈原是中国古代浪漫主义文学的两大源头，",
    "start": 4.625,
    "end": 8.653,
    "duration": 4.028
  },
  {
    "id": 3,
    "text": "分别代表了先秦北方中原文化与南方荆楚文化的杰出成就。",
    "start": 9.085,
    "end": 13.965,
    "duration": 4.88
  },
  {
    "id": 4,
    "text": "面对战国中后期诸侯兼并、礼崩乐坏的时代危机，",
    "start": 14.435,
    "end": 18.211,
    "duration": 3.776
  },
  {
    "id": 5,
    "text": "庄子以道家哲人的超脱追求个体精神自由，",
    "start": 18.686,
    "end": 21.868,
    "duration": 3.182
  },
  {
    "id": 6,
    "text": "屈原以楚国大夫的爱国忠忱坚守政治理想。",
    "start": 22.101,
    "end": 25.584,
    "duration": 3.483
  },
  {
    "id": 7,
    "text": "庄子奇幻诡谲，鲁迅赞其“晚周诸子之作，莫能先也”；",
    "start": 25.877,
    "end": 30.399,
    "duration": 4.522
  },
  {
    "id": 8,
    "text": "屈原奇伟瑰丽，开创辞赋与浪漫诗风之先河。",
    "start": 30.658,
    "end": 34.192,
    "duration": 3.534
  },
  {
    "id": 9,
    "text": "二人在思想精神与浪漫主义风格上的异同，",
    "start": 34.348,
    "end": 37.293,
    "duration": 2.945
  },
  {
    "id": 10,
    "text": "主要体现在以下四个方面：",
    "start": 37.407,
    "end": 39.042,
    "duration": 1.635
  },
  {
    "id": 11,
    "text": "第一，一求无待逍遥之顺世超脱，一守美政理想之爱国忠贞。",
    "start": 39.697,
    "end": 45.204,
    "duration": 5.507
  },
  {
    "id": 12,
    "text": "面对黑暗乱世，二人选择了截然不同的生命道路。",
    "start": 45.64,
    "end": 49.206,
    "duration": 3.566
  },
  {
    "id": 13,
    "text": "庄子立足道家“道”的境界，主张顺应自然、齐同物我，",
    "start": 49.802,
    "end": 54.14,
    "duration": 4.338
  },
  {
    "id": 14,
    "text": "将个体从世俗名利与政治倾轧中解脱出来，",
    "start": 54.529,
    "end": 58.013,
    "duration": 3.484
  },
  {
    "id": 15,
    "text": "宁可“曳尾于涂中”也不受庙堂束缚，",
    "start": 58.491,
    "end": 61.314,
    "duration": 2.823
  },
  {
    "id": 16,
    "text": "在生死祸福面前保持超然自适；",
    "start": 61.623,
    "end": 64.376,
    "duration": 2.753
  },
  {
    "id": 17,
    "text": "屈原则怀抱炽热的爱国忠君情怀，",
    "start": 64.967,
    "end": 67.961,
    "duration": 2.994
  },
  {
    "id": 18,
    "text": "始终将个人命运与楚国存亡紧密相连，终生坚持选贤任能、",
    "start": 68.465,
    "end": 73.919,
    "duration": 5.454
  },
  {
    "id": 19,
    "text": "修明法度的“美政”理想，",
    "start": 74.622,
    "end": 76.239,
    "duration": 1.617
  },
  {
    "id": 20,
    "text": "面对谗谄围攻仍宣告“亦余心之所善兮，虽九死其犹未悔”。",
    "start": 76.635,
    "end": 82.52,
    "duration": 5.885
  },
  {
    "id": 21,
    "text": "庄子以退隐护守心灵自由，屈原则以殉道彰显烈士风骨。",
    "start": 83.263,
    "end": 88.461,
    "duration": 5.198
  },
  {
    "id": 22,
    "text": "第二，庄子以“三言”寓言阐发玄理，",
    "start": 89.115,
    "end": 91.912,
    "duration": 2.797
  },
  {
    "id": 23,
    "text": "屈原以“香草美人”寄托忠爱。",
    "start": 92.405,
    "end": 94.76,
    "duration": 2.355
  },
  {
    "id": 24,
    "text": "在浪漫主义的表现载体上，庄子重在说“理”，",
    "start": 95.158,
    "end": 98.43,
    "duration": 3.272
  },
  {
    "id": 25,
    "text": "建立起“寓言”“重言”“卮言”相辅的表意方式。",
    "start": 98.861,
    "end": 102.406,
    "duration": 3.545
  },
  {
    "id": 26,
    "text": "无论是《庖丁解牛》的依乎天理，",
    "start": 102.856,
    "end": 105.151,
    "duration": 2.295
  },
  {
    "id": 27,
    "text": "还是《秋水》中以鹓雏腐鼠讽喻功名利禄，",
    "start": 105.473,
    "end": 108.863,
    "duration": 3.39
  },
  {
    "id": 28,
    "text": "皆以形象寓言嘲弄世俗机心；屈原则重在抒“情”，",
    "start": 109.112,
    "end": 113.587,
    "duration": 4.475
  },
  {
    "id": 29,
    "text": "拓展了《诗经》的比兴传统，",
    "start": 113.967,
    "end": 115.622,
    "duration": 1.655
  },
  {
    "id": 30,
    "text": "创立了系统的“香草美人”象征体系，以辟芷、秋兰、",
    "start": 115.791,
    "end": 120.363,
    "duration": 4.572
  },
  {
    "id": 31,
    "text": "木兰等芳草自喻高洁品格与才具，以恶草比附奸佞宵小，",
    "start": 121.033,
    "end": 125.724,
    "duration": 4.691
  },
  {
    "id": 32,
    "text": "以美人寄托贤君知己。",
    "start": 126.013,
    "end": 127.705,
    "duration": 1.692
  },
  {
    "id": 33,
    "text": "庄子借寓言破除执念，屈原借象征高扬人格。",
    "start": 128.026,
    "end": 131.939,
    "duration": 3.913
  },
  {
    "id": 34,
    "text": "第三，同具吞吐宇宙之奇想，而庄子神游超脱尘世，",
    "start": 132.584,
    "end": 137.466,
    "duration": 4.882
  },
  {
    "id": 35,
    "text": "屈原升腾终归故乡。",
    "start": 137.677,
    "end": 139.481,
    "duration": 1.804
  },
  {
    "id": 36,
    "text": "二者均拥有超越常轨的奇伟想象力，但虚实运思的方向不同。",
    "start": 140.0,
    "end": 145.129,
    "duration": 5.129
  },
  {
    "id": 37,
    "text": "庄子的想象向外无限展开且无所牵挂，在《逍遥游》中，",
    "start": 145.521,
    "end": 150.002,
    "duration": 4.481
  },
  {
    "id": 38,
    "text": "大鹏“水击三千里，抟扶摇而上者九万里”，",
    "start": 150.312,
    "end": 153.971,
    "duration": 3.659
  },
  {
    "id": 39,
    "text": "神思在无穷宇宙中自在遨游，",
    "start": 154.205,
    "end": 156.714,
    "duration": 2.509
  },
  {
    "id": 40,
    "text": "现实世界在其哲学俯瞰下化为虚空；",
    "start": 157.019,
    "end": 159.99,
    "duration": 2.971
  },
  {
    "id": 41,
    "text": "屈原在《离骚》中的天界神游，则是现实受挫后的悲愤求索，",
    "start": 160.259,
    "end": 164.837,
    "duration": 4.578
  },
  {
    "id": 42,
    "text": "诗人虽驾鸾凤周流上下、叩九重天门，",
    "start": 165.148,
    "end": 168.374,
    "duration": 3.226
  },
  {
    "id": 43,
    "text": "但飞升云霓之上忽然俯瞰故土，“陟升皇之赫戏兮，",
    "start": 168.659,
    "end": 173.001,
    "duration": 4.342
  },
  {
    "id": 44,
    "text": "忽临睨夫旧乡”，仆夫悲、马怀而不前，",
    "start": 173.235,
    "end": 176.613,
    "duration": 3.378
  },
  {
    "id": 45,
    "text": "最终剧烈跌回现实悲剧。",
    "start": 177.212,
    "end": 179.079,
    "duration": 1.867
  },
  {
    "id": 46,
    "text": "庄子的神游导向精神解脱，屈原的神游归于现实悲壮。",
    "start": 179.573,
    "end": 184.288,
    "duration": 4.715
  },
  {
    "id": 47,
    "text": "第四，共筑中国古典浪漫主义审美基因，深远滋养后代文人心灵。",
    "start": 184.922,
    "end": 190.183,
    "duration": 5.261
  },
  {
    "id": 48,
    "text": "庄子汪洋恣肆的散文气势与超脱思想，",
    "start": 190.713,
    "end": 193.683,
    "duration": 2.97
  },
  {
    "id": 49,
    "text": "为中国文学注入了自由旷达的灵气，深刻启迪了魏晋玄风、",
    "start": 194.015,
    "end": 198.503,
    "duration": 4.488
  },
  {
    "id": 50,
    "text": "陶渊明的隐逸情趣与李白的盛唐豪迈；",
    "start": 198.825,
    "end": 201.861,
    "duration": 3.036
  },
  {
    "id": 51,
    "text": "屈原忠贞不渝的爱国精神、悲壮美感与香草美人传统，",
    "start": 202.285,
    "end": 206.586,
    "duration": 4.301
  },
  {
    "id": 52,
    "text": "则培育了中国士人担当家国的品格，",
    "start": 206.849,
    "end": 209.505,
    "duration": 2.656
  },
  {
    "id": 53,
    "text": "滋养了杜甫的沉郁诗史与历代爱国诗文。",
    "start": 209.764,
    "end": 213.065,
    "duration": 3.301
  },
  {
    "id": 54,
    "text": "庄屈双峰并立，",
    "start": 213.582,
    "end": 214.721,
    "duration": 1.139
  },
  {
    "id": 55,
    "text": "共同构成了中华民族浪漫主义精神不可或缺的两大基石。",
    "start": 215.062,
    "end": 219.462,
    "duration": 4.4
  }
]