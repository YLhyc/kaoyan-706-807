[
  {
    "id": 1,
    "text": "试论庄子与屈原浪漫主义风格与思想精神的异同。",
    "start": 0.0,
    "end": 4.883,
    "duration": 4.883
  },
  {
    "id": 2,
    "text": "庄子与屈原是中国古代浪漫主义文学的两大源头，",
    "start": 4.883,
    "end": 8.547,
    "duration": 3.664
  },
  {
    "id": 3,
    "text": "分别代表了先秦时期北方中原文化与南方荆楚文化交融发展的最高精神硕果。",
    "start": 8.547,
    "end": 15.17,
    "duration": 6.623
  },
  {
    "id": 4,
    "text": "面对战国中后期诸侯兼并激烈、",
    "start": 15.17,
    "end": 17.757,
    "duration": 2.587
  },
  {
    "id": 5,
    "text": "礼崩乐坏与个体生命朝不保夕的历史危机，",
    "start": 17.757,
    "end": 21.271,
    "duration": 3.514
  },
  {
    "id": 6,
    "text": "庄子以道家哲人的超脱智慧寻求个体生命的绝对精神解放；",
    "start": 21.271,
    "end": 26.138,
    "duration": 4.867
  },
  {
    "id": 7,
    "text": "屈原以楚国贵族大夫的忠爱胸襟执着坚守政治理想。",
    "start": 26.138,
    "end": 31.794,
    "duration": 5.656
  },
  {
    "id": 8,
    "text": "郭沫若指出，庄子与屈原二人并峙，",
    "start": 31.794,
    "end": 33.857,
    "duration": 2.063
  },
  {
    "id": 9,
    "text": "“实可代表战国时代之艺术诸峰”。",
    "start": 33.857,
    "end": 36.598,
    "duration": 2.741
  },
  {
    "id": 10,
    "text": "二人在思想精神与浪漫主义艺术风格上的异同，",
    "start": 36.598,
    "end": 42.659,
    "duration": 6.061
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：",
    "start": 42.659,
    "end": 45.617,
    "duration": 2.958
  },
  {
    "id": 12,
    "text": "第一，在价值追求与生命抉择上，",
    "start": 45.617,
    "end": 49.831,
    "duration": 4.214
  },
  {
    "id": 13,
    "text": "展现超脱自适的无待逍遥与至死不渝的宗国坚守。",
    "start": 49.831,
    "end": 52.148,
    "duration": 2.317
  },
  {
    "id": 14,
    "text": "庄子立足道家虚无之境，主张顺应自然、忘却物我，",
    "start": 52.148,
    "end": 56.183,
    "duration": 4.035
  },
  {
    "id": 15,
    "text": "将个体从世俗名利与政治争斗的罗网中解放出来。",
    "start": 56.183,
    "end": 60.45,
    "duration": 4.267
  },
  {
    "id": 16,
    "text": "他宁肯 “曳尾于涂中”，亦不愿受制于庙堂卿相；",
    "start": 60.45,
    "end": 64.459,
    "duration": 4.009
  },
  {
    "id": 17,
    "text": "面对生死祸福，他倡导齐生死、齐贵贱的相对主义超脱；",
    "start": 64.459,
    "end": 70.126,
    "duration": 5.667
  },
  {
    "id": 18,
    "text": "屈原则秉持崇高的儒法结合情操，",
    "start": 70.126,
    "end": 73.032,
    "duration": 2.906
  },
  {
    "id": 19,
    "text": "始终将个体命运与楚国宗庙存亡紧密相连。",
    "start": 73.032,
    "end": 77.635,
    "duration": 4.603
  },
  {
    "id": 20,
    "text": "他终生坚守 “美政” 理想，面对朝廷谗谄围攻，",
    "start": 77.635,
    "end": 81.531,
    "duration": 3.896
  },
  {
    "id": 21,
    "text": "依然誓死捍卫人格操守，发出 “亦余心之所善兮，",
    "start": 81.531,
    "end": 86.918,
    "duration": 5.387
  },
  {
    "id": 22,
    "text": "虽九死其犹未悔” 的铿锵誓言。",
    "start": 86.918,
    "end": 90.914,
    "duration": 3.996
  },
  {
    "id": 23,
    "text": "庄子选择以退隐顺世守护内心的清虚自由，",
    "start": 90.914,
    "end": 95.101,
    "duration": 4.187
  },
  {
    "id": 24,
    "text": "屈原则以殉道自沉展现了刚烈不屈的士人风骨。",
    "start": 95.101,
    "end": 95.702,
    "duration": 0.601
  },
  {
    "id": 25,
    "text": "第二，在艺术构思与表现载体上，",
    "start": 95.702,
    "end": 98.114,
    "duration": 2.412
  },
  {
    "id": 26,
    "text": "展现托物消解的哲理寓言与寄托忠爱的香草美人。",
    "start": 98.114,
    "end": 104.812,
    "duration": 6.698
  },
  {
    "id": 27,
    "text": "在浪漫主义的表现手法上，庄子重在“理”，",
    "start": 104.812,
    "end": 107.721,
    "duration": 2.909
  },
  {
    "id": 28,
    "text": "以 “三言” 寓言系统作为阐发哲理的核心载体。",
    "start": 107.721,
    "end": 113.193,
    "duration": 5.472
  },
  {
    "id": 29,
    "text": "他善于在生活琐事中发现大道，",
    "start": 113.193,
    "end": 115.62,
    "duration": 2.427
  },
  {
    "id": 30,
    "text": "无论是 《庖丁解牛》 的依乎天理，",
    "start": 115.62,
    "end": 119.513,
    "duration": 3.893
  },
  {
    "id": 31,
    "text": "还是 《秋水》 中以鹓雏腐鼠嘲弄权贵名利，",
    "start": 119.513,
    "end": 123.257,
    "duration": 3.744
  },
  {
    "id": 32,
    "text": "皆以形象生动的寓言故事消解世俗机心；屈原则重在“情”，",
    "start": 123.257,
    "end": 127.784,
    "duration": 4.527
  },
  {
    "id": 33,
    "text": "极力拓展 《诗经》 比兴寄托传统，",
    "start": 127.784,
    "end": 131.195,
    "duration": 3.411
  },
  {
    "id": 34,
    "text": "开创了系统的 “香草美人” 象征体系。",
    "start": 131.195,
    "end": 133.384,
    "duration": 2.189
  },
  {
    "id": 35,
    "text": "全诗以辟芷、秋兰、",
    "start": 133.384,
    "end": 136.438,
    "duration": 3.054
  },
  {
    "id": 36,
    "text": "木兰等香草象征自身的道德操守与治国才具，",
    "start": 136.438,
    "end": 140.466,
    "duration": 4.028
  },
  {
    "id": 37,
    "text": "以恶草比喻谗谄宵小，以美人寄托明君知己。",
    "start": 140.466,
    "end": 145.383,
    "duration": 4.917
  },
  {
    "id": 38,
    "text": "庄子借寓言打破名相执念，屈原借象征建立崇高的人格丰碑。",
    "start": 145.383,
    "end": 149.14,
    "duration": 3.757
  },
  {
    "id": 39,
    "text": "第三，在想象空间与虚实机制上，",
    "start": 149.14,
    "end": 151.667,
    "duration": 2.527
  },
  {
    "id": 40,
    "text": "展现无拘无束的宇宙漫游与现实跌回的天界神游。",
    "start": 151.667,
    "end": 155.86,
    "duration": 4.193
  },
  {
    "id": 41,
    "text": "二者均具备吞吐宇宙的雄奇想象力，但在虚实机制的走向截然不同。",
    "start": 155.86,
    "end": 162.474,
    "duration": 6.614
  },
  {
    "id": 42,
    "text": "庄子之想象是向外无限展开且物我两忘的，",
    "start": 162.474,
    "end": 166.459,
    "duration": 3.985
  },
  {
    "id": 43,
    "text": "在 《逍遥游》 中，大鹏 “水击三千里，",
    "start": 166.459,
    "end": 167.688,
    "duration": 1.229
  },
  {
    "id": 44,
    "text": "抟扶摇而上者九万里”，任由神思在无穷宇宙中自在翱翔，",
    "start": 167.688,
    "end": 171.554,
    "duration": 3.866
  },
  {
    "id": 45,
    "text": "现实世界在其哲学俯瞰下被彻底消解；",
    "start": 171.554,
    "end": 177.955,
    "duration": 6.401
  },
  {
    "id": 46,
    "text": "屈原在 《离骚》 中的天界神游，",
    "start": 177.955,
    "end": 180.071,
    "duration": 2.116
  },
  {
    "id": 47,
    "text": "本质上是现实受挫后的悲愤宣泄。",
    "start": 180.071,
    "end": 182.985,
    "duration": 2.914
  },
  {
    "id": 48,
    "text": "诗人虽驾鸾凤周流上下，叩九重天门求神女不遂，",
    "start": 182.985,
    "end": 187.645,
    "duration": 4.66
  },
  {
    "id": 49,
    "text": "但当行至云霓之上，忽猛醒俯瞰故土宗国，“陟升皇之赫戏兮，",
    "start": 187.645,
    "end": 191.308,
    "duration": 3.663
  },
  {
    "id": 50,
    "text": "忽临睨夫旧乡”，驾车仆夫与飞马悲鸣蜷局而不能前行，",
    "start": 191.308,
    "end": 194.516,
    "duration": 3.208
  },
  {
    "id": 51,
    "text": "最终从神幻九天剧烈跌回现实悲剧。",
    "start": 194.516,
    "end": 201.147,
    "duration": 6.631
  },
  {
    "id": 52,
    "text": "庄子的神游走向精神解脱，屈原的神游走向悲壮殉道。",
    "start": 201.147,
    "end": 206.019,
    "duration": 4.872
  },
  {
    "id": 53,
    "text": "第四，共同筑牢中国古典浪漫主义的审美基因，",
    "start": 206.019,
    "end": 209.755,
    "duration": 3.736
  },
  {
    "id": 54,
    "text": "对后代文人心灵产生深远滋养。",
    "start": 209.755,
    "end": 212.397,
    "duration": 2.642
  },
  {
    "id": 55,
    "text": "庄子散文汪洋恣肆的文体气势与自由思想，",
    "start": 212.397,
    "end": 216.103,
    "duration": 3.706
  },
  {
    "id": 56,
    "text": "为中国文学注入了超脱旷达的灵气，深远启迪了魏晋玄学诗文、",
    "start": 216.103,
    "end": 221.66,
    "duration": 5.557
  },
  {
    "id": 57,
    "text": "陶渊明田园隐逸情趣与李白的盛唐豪迈；",
    "start": 221.66,
    "end": 223.857,
    "duration": 2.197
  },
  {
    "id": 58,
    "text": "屈原忠贞不渝的爱国情操、悲剧崇高意蕴与香草美人寄托，",
    "start": 223.857,
    "end": 230.436,
    "duration": 6.579
  },
  {
    "id": 59,
    "text": "则铸就了中国士大夫担当天下的政治品格，",
    "start": 230.436,
    "end": 233.92,
    "duration": 3.484
  },
  {
    "id": 60,
    "text": "培育了杜甫沉郁顿挫的诗史品格与历代爱国主义文学。",
    "start": 233.92,
    "end": 238.707,
    "duration": 4.787
  },
  {
    "id": 61,
    "text": "庄屈双峰并立，",
    "start": 238.707,
    "end": 240.065,
    "duration": 1.358
  },
  {
    "id": 62,
    "text": "共同构成了中华民族古典浪漫主义精神不可或缺的两大基石。",
    "start": 240.065,
    "end": 244.68,
    "duration": 4.615
  }
]