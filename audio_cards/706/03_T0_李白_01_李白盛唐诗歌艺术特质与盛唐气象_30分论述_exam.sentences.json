[
  {
    "id": 1,
    "text": "李白是中国古典浪漫主义诗歌的巅峰集大成者，",
    "start": 0.08,
    "end": 4.0,
    "duration": 3.92
  },
  {
    "id": 2,
    "text": "后世尊称为“诗仙”。",
    "start": 4.0,
    "end": 6.0,
    "duration": 2.0
  },
  {
    "id": 3,
    "text": "杜甫在《春日忆李白》中盛赞其“白也诗无敌，",
    "start": 6.0,
    "end": 9.92,
    "duration": 3.92
  },
  {
    "id": 4,
    "text": "飘然思不群”，极写其绝世才华。",
    "start": 9.92,
    "end": 13.44,
    "duration": 3.52
  },
  {
    "id": 5,
    "text": "严羽在《沧浪诗话》中指出李白与杜甫“一结盛唐之局”，",
    "start": 13.44,
    "end": 18.16,
    "duration": 4.72
  },
  {
    "id": 6,
    "text": "确立了盛唐诗歌的至高法则。",
    "start": 18.16,
    "end": 20.32,
    "duration": 2.16
  },
  {
    "id": 7,
    "text": "袁行配《中国文学史》指出，李白诗歌是盛唐时代精神最集中、",
    "start": 20.64,
    "end": 25.92,
    "duration": 5.28
  },
  {
    "id": 8,
    "text": "最绚烂的诗学投影。",
    "start": 25.92,
    "end": 27.6,
    "duration": 1.68
  },
  {
    "id": 9,
    "text": "他以昂扬自信的精神气度与飞扬凌厉的艺术天才，",
    "start": 27.6,
    "end": 31.28,
    "duration": 3.68
  },
  {
    "id": 10,
    "text": "将古典浪漫主义推上了空前绝后的境地。",
    "start": 31.28,
    "end": 34.32,
    "duration": 3.04
  },
  {
    "id": 11,
    "text": "其核心艺术特质与盛唐气象的交融，",
    "start": 34.32,
    "end": 37.04,
    "duration": 2.72
  },
  {
    "id": 12,
    "text": "主要展现在以下四个核心维度：李白诗歌的灵魂是盛唐强盛国力催生出的蓬勃自信，",
    "start": 37.04,
    "end": 44.16,
    "duration": 7.12
  },
  {
    "id": 13,
    "text": "以及强烈的自我主体意识。",
    "start": 44.16,
    "end": 46.48,
    "duration": 2.32
  },
  {
    "id": 14,
    "text": "盛唐政治开明与文化繁荣的氛围，赋予李白傲视公卿、",
    "start": 46.56,
    "end": 51.12,
    "duration": 4.56
  },
  {
    "id": 15,
    "text": "怀才自负的豪迈精神气概。",
    "start": 51.12,
    "end": 53.6,
    "duration": 2.48
  },
  {
    "id": 16,
    "text": "在《宣州谢窕楼建别校书叔云》中，",
    "start": 53.6,
    "end": 56.48,
    "duration": 2.88
  },
  {
    "id": 17,
    "text": "他豪迈写道：“俱怀逸兴壮思飞，欲上青天揽明月”。",
    "start": 56.48,
    "end": 61.12,
    "duration": 4.64
  },
  {
    "id": 18,
    "text": "即便在政治受挫、行路艰难的绝境中，",
    "start": 61.44,
    "end": 64.88,
    "duration": 3.44
  },
  {
    "id": 19,
    "text": "他在《行路难》中依然坚信：“长风破浪会有时，",
    "start": 64.88,
    "end": 69.12,
    "duration": 4.24
  },
  {
    "id": 20,
    "text": "直挂云帆济沧海”。",
    "start": 69.12,
    "end": 70.88,
    "duration": 1.76
  },
  {
    "id": 21,
    "text": "更为崇高的是其独立不阿的人格尊严，",
    "start": 70.88,
    "end": 74.16,
    "duration": 3.28
  },
  {
    "id": 22,
    "text": "在《梦游天姥吟留别》尾联中怒吼：“安能摧眉折腰事权贵，",
    "start": 74.16,
    "end": 78.8,
    "duration": 4.64
  },
  {
    "id": 23,
    "text": "使我不得开心颜”。",
    "start": 78.8,
    "end": 80.08,
    "duration": 1.28
  },
  {
    "id": 24,
    "text": "这种将个体尊严置于皇权权贵之上的反叛精神，",
    "start": 80.48,
    "end": 84.24,
    "duration": 3.76
  },
  {
    "id": 25,
    "text": "成为盛唐士人最壮丽的心灵写照。",
    "start": 84.24,
    "end": 87.04,
    "duration": 2.8
  },
  {
    "id": 26,
    "text": "李白拥有古典诗歌史上最不受拘束的浪漫想象力，",
    "start": 87.04,
    "end": 91.12,
    "duration": 4.08
  },
  {
    "id": 27,
    "text": "长于融铸神话与极度夸张构建幻境。",
    "start": 91.12,
    "end": 94.8,
    "duration": 3.68
  },
  {
    "id": 28,
    "text": "在名作《梦游天姥吟留别》中，他以超现实笔墨描摹出光怪陆离的仙界图景。",
    "start": 94.8,
    "end": 100.96,
    "duration": 6.16
  },
  {
    "id": 29,
    "text": "诗中写道：“霓为衣兮风为马，云之君兮纷纷而来下。",
    "start": 101.36,
    "end": 107.36,
    "duration": 6.0
  },
  {
    "id": 30,
    "text": "虎鼓瑟兮鸾回车，仙之人兮列如麻”。",
    "start": 107.36,
    "end": 111.76,
    "duration": 4.4
  },
  {
    "id": 31,
    "text": "璀璨瑰丽的群仙盛宴与污浊逼仄的长安朝廷形成强烈反差，",
    "start": 111.76,
    "end": 117.52,
    "duration": 5.76
  },
  {
    "id": 32,
    "text": "极具精神解脱的崇高美。",
    "start": 117.52,
    "end": 119.76,
    "duration": 2.24
  },
  {
    "id": 33,
    "text": "在日常抒情中，他善于以极度夸张捕捉物象惊心动魄之美。",
    "start": 119.76,
    "end": 124.96,
    "duration": 5.2
  },
  {
    "id": 34,
    "text": "如《望庐山瀑布》中的“飞流直下三千尺，",
    "start": 125.28,
    "end": 128.64,
    "duration": 3.36
  },
  {
    "id": 35,
    "text": "疑是银河落九天”。",
    "start": 128.64,
    "end": 130.56,
    "duration": 1.92
  },
  {
    "id": 36,
    "text": "又如《秋浦歌》中的“白发三千丈，",
    "start": 130.56,
    "end": 133.68,
    "duration": 3.12
  },
  {
    "id": 37,
    "text": "缘愁似个长”。",
    "start": 133.68,
    "end": 135.44,
    "duration": 1.76
  },
  {
    "id": 38,
    "text": "这些脱口而出的夸张大胆奇特而又纯真浑然，",
    "start": 135.44,
    "end": 139.84,
    "duration": 4.4
  },
  {
    "id": 39,
    "text": "丝毫不见斧凿雕琢的痕迹。",
    "start": 139.84,
    "end": 142.32,
    "duration": 2.48
  },
  {
    "id": 40,
    "text": "李白打破了古典诗歌循序渐进的起承转合规则，",
    "start": 142.32,
    "end": 146.64,
    "duration": 4.32
  },
  {
    "id": 41,
    "text": "善于让诗情以决堤之势喷薄奔涌。",
    "start": 146.64,
    "end": 149.44,
    "duration": 2.8
  },
  {
    "id": 42,
    "text": "其七言歌行节奏转换神速，情感如天风海雨般大起大落。",
    "start": 149.824,
    "end": 155.184,
    "duration": 5.36
  },
  {
    "id": 43,
    "text": "这一特征在七古绝唱《将进酒》中展现得最为淋漓尽致。",
    "start": 155.184,
    "end": 160.144,
    "duration": 4.96
  },
  {
    "id": 44,
    "text": "开篇以江河奔流之势突兀而起：“君不见，",
    "start": 160.144,
    "end": 163.744,
    "duration": 3.6
  },
  {
    "id": 45,
    "text": "黄河之水天上来，奔流到海不复回”。",
    "start": 163.744,
    "end": 167.584,
    "duration": 3.84
  },
  {
    "id": 46,
    "text": "紧接着骤然跌入人生苦短的浩叹：“君不见，",
    "start": 167.584,
    "end": 171.824,
    "duration": 4.24
  },
  {
    "id": 47,
    "text": "高堂明镜悲白发，朝如青丝暮成雪”。",
    "start": 171.824,
    "end": 175.744,
    "duration": 3.92
  },
  {
    "id": 48,
    "text": "随后笔锋陡转飞升，高呼“天生我材必有用，",
    "start": 175.904,
    "end": 179.984,
    "duration": 4.08
  },
  {
    "id": 49,
    "text": "千金散尽还复来”，极度亢奋。",
    "start": 179.984,
    "end": 182.944,
    "duration": 2.96
  },
  {
    "id": 50,
    "text": "最后收束于“与尔同销万古愁”的悲凉深沉，",
    "start": 182.944,
    "end": 186.944,
    "duration": 4.0
  },
  {
    "id": 51,
    "text": "章法如悬崖飞瀑，跌宕莫测。",
    "start": 186.944,
    "end": 189.504,
    "duration": 2.56
  },
  {
    "id": 52,
    "text": "李白在艺术美学上推崇天然纯真，旗帜鲜明地主张“清水出芙蓉，",
    "start": 189.504,
    "end": 195.584,
    "duration": 6.08
  },
  {
    "id": 53,
    "text": "天然去雕饰”。",
    "start": 195.584,
    "end": 196.624,
    "duration": 1.04
  },
  {
    "id": 54,
    "text": "他极力荡涤齐梁以来雕琢企靡的浮艳形式，",
    "start": 196.864,
    "end": 200.704,
    "duration": 3.84
  },
  {
    "id": 55,
    "text": "使诗歌语言回归纯净明丽与流转圆融。",
    "start": 200.704,
    "end": 204.144,
    "duration": 3.44
  },
  {
    "id": 56,
    "text": "他善于借助汉魏乐府古题自铸伟词，",
    "start": 204.144,
    "end": 207.344,
    "duration": 3.2
  },
  {
    "id": 57,
    "text": "彻底翻出崭新的盛唐时代精神与个人性情。",
    "start": 207.344,
    "end": 210.864,
    "duration": 3.52
  },
  {
    "id": 58,
    "text": "在近体诗中，李白尤以绝句成就最高，",
    "start": 210.864,
    "end": 213.984,
    "duration": 3.12
  },
  {
    "id": 59,
    "text": "达到了羚羊挂角、无迹可求的神化境地。",
    "start": 213.984,
    "end": 217.024,
    "duration": 3.04
  },
  {
    "id": 60,
    "text": "如名篇《早发白帝城》：“朝辞白帝彩云间，",
    "start": 217.344,
    "end": 220.944,
    "duration": 3.6
  },
  {
    "id": 61,
    "text": "千里江陵一日还。",
    "start": 220.944,
    "end": 222.464,
    "duration": 1.52
  },
  {
    "id": 62,
    "text": "两岸猿声啼不住，轻舟已过万重山”。",
    "start": 222.464,
    "end": 225.344,
    "duration": 2.88
  },
  {
    "id": 63,
    "text": "全诗情景完全相生，语意如行云流水自然淌出，",
    "start": 225.344,
    "end": 229.184,
    "duration": 3.84
  },
  {
    "id": 64,
    "text": "展现出一种大音希声的天赖之美。",
    "start": 229.184,
    "end": 231.904,
    "duration": 2.72
  },
  {
    "id": 65,
    "text": "综上所述，李白以非凡的天才融铸了盛唐气象的博大气魄与宏伟情操。",
    "start": 231.904,
    "end": 237.344,
    "duration": 5.44
  },
  {
    "id": 66,
    "text": "他与杜甫并峙为盛唐诗歌的两座最高峰，",
    "start": 237.664,
    "end": 240.944,
    "duration": 3.28
  },
  {
    "id": 67,
    "text": "确立了中国古典浪漫主义的最高范式。",
    "start": 240.944,
    "end": 243.984,
    "duration": 3.04
  },
  {
    "id": 68,
    "text": "李白的豪放狂飙不仅直接启迪了中唐韩愈、",
    "start": 243.984,
    "end": 247.424,
    "duration": 3.44
  },
  {
    "id": 69,
    "text": "李贺的奇崛造语，更在宋代苏轼的豪迈词章中得到承续。",
    "start": 247.424,
    "end": 251.824,
    "duration": 4.4
  },
  {
    "id": 70,
    "text": "李白诗歌因而成为中华文明蓬勃朝气与精神自由的永恒象征。",
    "start": 251.824,
    "end": 257.184,
    "duration": 5.36
  },
  {
    "id": 71,
    "text": "--",
    "start": 257.184,
    "end": 257.264,
    "duration": 0.08
  }
]