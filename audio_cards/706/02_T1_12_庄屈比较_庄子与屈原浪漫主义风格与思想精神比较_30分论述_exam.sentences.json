[
  {
    "id": 1,
    "text": "试论庄子与屈原浪漫主义风格与思想精神的异同。",
    "start": 0.101,
    "end": 4.326,
    "duration": 4.225
  },
  {
    "id": 2,
    "text": "庄子与屈原是中国古代浪漫主义文学的两大源头，",
    "start": 4.625,
    "end": 8.663,
    "duration": 4.038
  },
  {
    "id": 3,
    "text": "分别代表了先秦北方中原文化与南方荆楚文化的杰出成就。",
    "start": 9.085,
    "end": 13.975,
    "duration": 4.89
  },
  {
    "id": 4,
    "text": "面对战国中后期诸侯兼并、礼崩乐坏的时代危机，",
    "start": 14.435,
    "end": 18.221,
    "duration": 3.786
  },
  {
    "id": 5,
    "text": "庄子以道家哲人的超脱追求个体精神自由，屈原以楚国大夫的爱国忠忱坚守政治理想。",
    "start": 18.686,
    "end": 25.594,
    "duration": 6.908
  },
  {
    "id": 6,
    "text": "庄子奇幻诡谲，鲁迅赞其“晚周诸子之作，莫能先也”；",
    "start": 25.877,
    "end": 30.409,
    "duration": 4.532
  },
  {
    "id": 7,
    "text": "屈原奇伟瑰丽，开创辞赋与浪漫诗风之先河。",
    "start": 30.658,
    "end": 34.196,
    "duration": 3.538
  },
  {
    "id": 8,
    "text": "二人在思想精神与浪漫主义风格上的异同，主要体现在以下四个方面：",
    "start": 34.348,
    "end": 39.052,
    "duration": 4.704
  },
  {
    "id": 9,
    "text": "第一，一求无待逍遥之顺世超脱，一守美政理想之爱国忠贞。",
    "start": 39.697,
    "end": 45.214,
    "duration": 5.517
  },
  {
    "id": 10,
    "text": "面对黑暗乱世，二人选择了截然不同的生命道路。",
    "start": 45.64,
    "end": 49.216,
    "duration": 3.576
  },
  {
    "id": 11,
    "text": "庄子立足道家“道”的境界，主张顺应自然、齐同物我，",
    "start": 49.802,
    "end": 54.149,
    "duration": 4.347
  },
  {
    "id": 12,
    "text": "将个体从世俗名利与政治倾轧中解脱出来，",
    "start": 54.529,
    "end": 58.023,
    "duration": 3.494
  },
  {
    "id": 13,
    "text": "宁可“曳尾于涂中”也不受庙堂束缚，在生死祸福面前保持超然自适；",
    "start": 58.491,
    "end": 64.386,
    "duration": 5.895
  },
  {
    "id": 14,
    "text": "屈原则怀抱炽热的爱国忠君情怀，始终将个人命运与楚国存亡紧密相连，",
    "start": 64.967,
    "end": 71.815,
    "duration": 6.848
  },
  {
    "id": 15,
    "text": "终生坚持选贤任能、修明法度的“美政”理想，",
    "start": 72.265,
    "end": 76.249,
    "duration": 3.984
  },
  {
    "id": 16,
    "text": "面对谗谄围攻仍宣告“亦余心之所善兮，虽九死其犹未悔”。",
    "start": 76.635,
    "end": 82.53,
    "duration": 5.895
  },
  {
    "id": 17,
    "text": "庄子以退隐护守心灵自由，屈原则以殉道彰显烈士风骨。",
    "start": 83.263,
    "end": 88.471,
    "duration": 5.208
  },
  {
    "id": 18,
    "text": "第二，庄子以“三言”寓言阐发玄理，屈原以“香草美人”寄托忠爱。",
    "start": 89.115,
    "end": 94.77,
    "duration": 5.655
  },
  {
    "id": 19,
    "text": "在浪漫主义的表现载体上，庄子重在说“理”，",
    "start": 95.158,
    "end": 98.44,
    "duration": 3.282
  },
  {
    "id": 20,
    "text": "建立起“寓言”“重言”“卮言”相辅的表意方式。",
    "start": 98.861,
    "end": 102.416,
    "duration": 3.555
  },
  {
    "id": 21,
    "text": "无论是《庖丁解牛》的依乎天理，",
    "start": 102.856,
    "end": 105.161,
    "duration": 2.305
  },
  {
    "id": 22,
    "text": "还是《秋水》中以鹓雏腐鼠讽喻功名利禄，皆以形象寓言嘲弄世俗机心；",
    "start": 105.473,
    "end": 111.548,
    "duration": 6.075
  },
  {
    "id": 23,
    "text": "屈原则重在抒“情”，拓展了《诗经》的比兴传统，",
    "start": 111.895,
    "end": 115.632,
    "duration": 3.737
  },
  {
    "id": 24,
    "text": "创立了系统的“香草美人”象征体系，以辟芷、秋兰、木兰等芳草自喻高洁品格与才具，",
    "start": 115.791,
    "end": 123.546,
    "duration": 7.755
  },
  {
    "id": 25,
    "text": "以恶草比附奸佞宵小，以美人寄托贤君知己。",
    "start": 123.935,
    "end": 127.715,
    "duration": 3.78
  },
  {
    "id": 26,
    "text": "庄子借寓言破除执念，屈原借象征高扬人格。",
    "start": 128.026,
    "end": 131.949,
    "duration": 3.923
  },
  {
    "id": 27,
    "text": "第三，同具吞吐宇宙之奇想，而庄子神游超脱尘世，屈原升腾终归故乡。",
    "start": 132.584,
    "end": 139.491,
    "duration": 6.907
  },
  {
    "id": 28,
    "text": "二者均拥有超越常轨的奇伟想象力，但虚实运思的方向不同。",
    "start": 140.0,
    "end": 145.139,
    "duration": 5.139
  },
  {
    "id": 29,
    "text": "庄子的想象向外无限展开且无所牵挂，在《逍遥游》中，",
    "start": 145.521,
    "end": 150.012,
    "duration": 4.491
  },
  {
    "id": 30,
    "text": "大鹏“水击三千里，抟扶摇而上者九万里”，",
    "start": 150.312,
    "end": 153.94,
    "duration": 3.628
  },
  {
    "id": 31,
    "text": "神思在无穷宇宙中自在遨游，现实世界在其哲学俯瞰下化为虚空；",
    "start": 154.205,
    "end": 160.0,
    "duration": 5.795
  },
  {
    "id": 32,
    "text": "屈原在《离骚》中的天界神游，则是现实受挫后的悲愤求索，",
    "start": 160.259,
    "end": 164.845,
    "duration": 4.586
  },
  {
    "id": 33,
    "text": "诗人虽驾鸾凤周流上下、叩九重天门，但飞升云霓之上忽然俯瞰故土，",
    "start": 165.148,
    "end": 171.167,
    "duration": 6.019
  },
  {
    "id": 34,
    "text": "“陟升皇之赫戏兮，忽临睨夫旧乡”，仆夫悲、马怀而不前，最终剧烈跌回现实悲剧。",
    "start": 171.438,
    "end": 179.089,
    "duration": 7.651
  },
  {
    "id": 35,
    "text": "庄子的神游导向精神解脱，屈原的神游归于现实悲壮。",
    "start": 179.573,
    "end": 184.298,
    "duration": 4.725
  },
  {
    "id": 36,
    "text": "第四，共筑中国古典浪漫主义审美基因，深远滋养后代文人心灵。",
    "start": 184.922,
    "end": 190.193,
    "duration": 5.271
  },
  {
    "id": 37,
    "text": "庄子汪洋恣肆的散文气势与超脱思想，为中国文学注入了自由旷达的灵气，",
    "start": 190.713,
    "end": 196.48,
    "duration": 5.767
  },
  {
    "id": 38,
    "text": "深刻启迪了魏晋玄风、陶渊明的隐逸情趣与李白的盛唐豪迈；",
    "start": 196.84,
    "end": 201.877,
    "duration": 5.037
  },
  {
    "id": 39,
    "text": "屈原忠贞不渝的爱国精神、悲壮美感与香草美人传统，",
    "start": 202.285,
    "end": 206.595,
    "duration": 4.31
  },
  {
    "id": 40,
    "text": "则培育了中国士人担当家国的品格，滋养了杜甫的沉郁诗史与历代爱国诗文。",
    "start": 206.849,
    "end": 213.075,
    "duration": 6.226
  },
  {
    "id": 41,
    "text": "庄屈双峰并立，共同构成了中华民族浪漫主义精神不可或缺的两大基石。",
    "start": 213.582,
    "end": 219.462,
    "duration": 5.88
  }
]