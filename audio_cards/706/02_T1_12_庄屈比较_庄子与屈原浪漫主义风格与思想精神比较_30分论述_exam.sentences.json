[
  {
    "id": 1,
    "text": "试论庄子与屈原浪漫主义风格与思想精神的异同。",
    "start": 0.12,
    "end": 4.345,
    "duration": 4.225
  },
  {
    "id": 2,
    "text": "庄子与屈原是中国古代浪漫主义文学的两大源头，",
    "start": 4.937,
    "end": 8.682,
    "duration": 3.745
  },
  {
    "id": 3,
    "text": "分别代表了先秦北方中原文化与南方荆楚文化的杰出成就。",
    "start": 9.104,
    "end": 13.994,
    "duration": 4.89
  },
  {
    "id": 4,
    "text": "面对战国中后期诸侯兼并、礼崩乐坏的时代危机，",
    "start": 14.514,
    "end": 18.3,
    "duration": 3.786
  },
  {
    "id": 5,
    "text": "庄子以道家哲人的超脱追求个体精神自由，屈原以楚国大夫的爱国忠忱坚守政治理想。",
    "start": 18.765,
    "end": 25.673,
    "duration": 6.908
  },
  {
    "id": 6,
    "text": "庄子奇幻诡谲，鲁迅赞其“晚周诸子之作，莫能先也”；",
    "start": 26.193,
    "end": 30.725,
    "duration": 4.532
  },
  {
    "id": 7,
    "text": "屈原奇伟瑰丽，开创辞赋与浪漫诗风之先河。",
    "start": 31.245,
    "end": 34.783,
    "duration": 3.538
  },
  {
    "id": 8,
    "text": "二人在思想精神与浪漫主义风格上的异同，主要体现在以下四个方面：",
    "start": 35.303,
    "end": 40.007,
    "duration": 4.704
  },
  {
    "id": 9,
    "text": "第一，一求无待逍遥之顺世超脱，一守美政理想之爱国忠贞。",
    "start": 40.652,
    "end": 46.169,
    "duration": 5.517
  },
  {
    "id": 10,
    "text": "面对黑暗乱世，二人选择了截然不同的生命道路。",
    "start": 46.689,
    "end": 50.265,
    "duration": 3.576
  },
  {
    "id": 11,
    "text": "庄子立足道家“道”的境界，主张顺应自然、齐同物我，",
    "start": 50.851,
    "end": 55.187,
    "duration": 4.336
  },
  {
    "id": 12,
    "text": "将个体从世俗名利与政治倾轧中解脱出来，",
    "start": 55.578,
    "end": 59.072,
    "duration": 3.494
  },
  {
    "id": 13,
    "text": "宁可“曳尾于涂中”也不受庙堂束缚，在生死祸福面前保持超然自适；",
    "start": 59.54,
    "end": 65.435,
    "duration": 5.895
  },
  {
    "id": 14,
    "text": "屈原则怀抱炽热的爱国忠君情怀，始终将个人命运与楚国存亡紧密相连，",
    "start": 66.016,
    "end": 72.864,
    "duration": 6.848
  },
  {
    "id": 15,
    "text": "终生坚持选贤任能、修明法度的“美政”理想，",
    "start": 73.314,
    "end": 77.298,
    "duration": 3.984
  },
  {
    "id": 16,
    "text": "面对谗谄围攻仍宣告“亦余心之所善兮，虽九死其犹未悔”。",
    "start": 77.684,
    "end": 83.579,
    "duration": 5.895
  },
  {
    "id": 17,
    "text": "庄子以退隐护守心灵自由，屈原则以殉道彰显烈士风骨。",
    "start": 84.312,
    "end": 89.52,
    "duration": 5.208
  },
  {
    "id": 18,
    "text": "第二，庄子以“三言”寓言阐发玄理，屈原以“香草美人”寄托忠爱。",
    "start": 90.164,
    "end": 95.819,
    "duration": 5.655
  },
  {
    "id": 19,
    "text": "在浪漫主义的表现载体上，庄子重在说“理”，建立起“寓言”“重言”“卮言”相辅的表意方式。",
    "start": 96.339,
    "end": 103.597,
    "duration": 7.258
  },
  {
    "id": 20,
    "text": "无论是《庖丁解牛》的依乎天理，还是《秋水》中以鹓雏腐鼠讽喻功名利禄，皆以形象寓言嘲弄世俗机心；",
    "start": 104.117,
    "end": 112.809,
    "duration": 8.692
  },
  {
    "id": 21,
    "text": "屈原则重在抒“情”，拓展了《诗经》的比兴传统，",
    "start": 113.329,
    "end": 117.05,
    "duration": 3.721
  },
  {
    "id": 22,
    "text": "创立了系统的“香草美人”象征体系，以辟芷、秋兰、木兰等芳草自喻高洁品格与才具，",
    "start": 117.42,
    "end": 125.016,
    "duration": 7.596
  },
  {
    "id": 23,
    "text": "以恶草比附奸佞宵小，以美人寄托贤君知己。",
    "start": 125.405,
    "end": 129.185,
    "duration": 3.78
  },
  {
    "id": 24,
    "text": "庄子借寓言破除执念，屈原借象征高扬人格。",
    "start": 129.705,
    "end": 133.628,
    "duration": 3.923
  },
  {
    "id": 25,
    "text": "第三，同具吞吐宇宙之奇想，而庄子神游超脱尘世，屈原升腾终归故乡。",
    "start": 134.263,
    "end": 141.17,
    "duration": 6.907
  },
  {
    "id": 26,
    "text": "二者均拥有超越常轨的奇伟想象力，但虚实运思的方向不同。",
    "start": 141.69,
    "end": 146.829,
    "duration": 5.139
  },
  {
    "id": 27,
    "text": "庄子的想象向外无限展开且无所牵挂，在《逍遥游》中，",
    "start": 147.349,
    "end": 151.84,
    "duration": 4.491
  },
  {
    "id": 28,
    "text": "大鹏“水击三千里，抟扶摇而上者九万里”，",
    "start": 152.21,
    "end": 155.838,
    "duration": 3.628
  },
  {
    "id": 29,
    "text": "神思在无穷宇宙中自在遨游，现实世界在其哲学俯瞰下化为虚空；",
    "start": 156.208,
    "end": 162.003,
    "duration": 5.795
  },
  {
    "id": 30,
    "text": "屈原在《离骚》中的天界神游，则是现实受挫后的悲愤求索，",
    "start": 162.523,
    "end": 167.109,
    "duration": 4.586
  },
  {
    "id": 31,
    "text": "诗人虽驾鸾凤周流上下、叩九重天门，但飞升云霓之上忽然俯瞰故土，",
    "start": 167.479,
    "end": 173.498,
    "duration": 6.019
  },
  {
    "id": 32,
    "text": "“陟升皇之赫戏兮，忽临睨夫旧乡”，仆夫悲、马怀而不前，最终剧烈跌回现实悲剧。",
    "start": 173.868,
    "end": 181.519,
    "duration": 7.651
  },
  {
    "id": 33,
    "text": "庄子的神游导向精神解脱，屈原的神游归于现实悲壮。",
    "start": 182.039,
    "end": 186.764,
    "duration": 4.725
  },
  {
    "id": 34,
    "text": "第四，共筑中国古典浪漫主义审美基因，深远滋养后代文人心灵。",
    "start": 187.388,
    "end": 192.659,
    "duration": 5.271
  },
  {
    "id": 35,
    "text": "庄子汪洋恣肆的散文气势与超脱思想，为中国文学注入了自由旷达的灵气，",
    "start": 193.179,
    "end": 198.946,
    "duration": 5.767
  },
  {
    "id": 36,
    "text": "深刻启迪了魏晋玄风、陶渊明的隐逸情趣与李白的盛唐豪迈；",
    "start": 199.316,
    "end": 204.353,
    "duration": 5.037
  },
  {
    "id": 37,
    "text": "屈原忠贞不渝的爱国精神、悲壮美感与香草美人传统，",
    "start": 204.873,
    "end": 209.183,
    "duration": 4.31
  },
  {
    "id": 38,
    "text": "则培育了中国士人担当家国的品格，滋养了杜甫的沉郁诗史与历代爱国诗文。",
    "start": 209.553,
    "end": 215.779,
    "duration": 6.226
  },
  {
    "id": 39,
    "text": "庄屈双峰并立，共同构成了中华民族浪漫主义精神不可或缺的两大基石。",
    "start": 216.299,
    "end": 222.179,
    "duration": 5.88
  },
  {
    "id": 40,
    "text": "由此观之，庄子与屈原分居南北文化传统之中，",
    "start": 222.699,
    "end": 226.384,
    "duration": 3.685
  },
  {
    "id": 41,
    "text": "各自将奇特瑰丽的浪漫想象推向极致，却走向超脱尘网与坚守家国的不同精神归宿。",
    "start": 226.754,
    "end": 234.041,
    "duration": 7.287
  },
  {
    "id": 42,
    "text": "庄子的寓言思辨为后代文学注入清旷超逸的哲理气韵，",
    "start": 234.561,
    "end": 239.026,
    "duration": 4.465
  },
  {
    "id": 43,
    "text": "屈原的香草美人与忠爱热忱则培育了士人担当家国的深沉品格，",
    "start": 239.396,
    "end": 244.729,
    "duration": 5.333
  },
  {
    "id": 44,
    "text": "二人共筑中国古典浪漫主义文学的源头传统。",
    "start": 245.099,
    "end": 248.451,
    "duration": 3.352
  }
]