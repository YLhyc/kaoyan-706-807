[
  {
    "id": 1,
    "text": "试论庄子与屈原浪漫主义风格与思想精神的异同。",
    "start": 0.134,
    "end": 3.866,
    "duration": 3.732
  },
  {
    "id": 2,
    "text": "庄子与屈原是中国古代浪漫主义文学的两大源头，",
    "start": 4.623,
    "end": 8.235,
    "duration": 3.612
  },
  {
    "id": 3,
    "text": "分别代表了先秦北方中原文化与南方荆楚文化的杰出成就。",
    "start": 8.623,
    "end": 13.035,
    "duration": 4.412
  },
  {
    "id": 4,
    "text": "面对战国中后期诸侯兼并、礼崩乐坏的时代危机，",
    "start": 13.793,
    "end": 17.405,
    "duration": 3.612
  },
  {
    "id": 5,
    "text": "庄子以道家哲人的超脱追求个体精神自由，屈原以楚国大夫的爱国忠忱坚守政治理想。",
    "start": 17.784,
    "end": 24.076,
    "duration": 6.292
  },
  {
    "id": 6,
    "text": "庄子奇幻诡谲，鲁迅赞其“晚周诸子之作，莫能先也”；",
    "start": 24.754,
    "end": 26.886,
    "duration": 2.132
  },
  {
    "id": 7,
    "text": "屈原奇伟瑰丽，开创辞赋与浪漫诗风之先河。",
    "start": 27.415,
    "end": 29.467,
    "duration": 2.052
  },
  {
    "id": 8,
    "text": "二人在思想精神与浪漫主义风格上的异同，主要体现在以下四个方面：",
    "start": 30.145,
    "end": 33.677,
    "duration": 3.532
  },
  {
    "id": 9,
    "text": "第一，一求无待逍遥之顺世超脱，一守美政理想之爱国忠贞。",
    "start": 34.435,
    "end": 45.407,
    "duration": 10.972
  },
  {
    "id": 10,
    "text": "面对黑暗乱世，二人选择了截然不同的生命道路。",
    "start": 46.205,
    "end": 49.617,
    "duration": 3.412
  },
  {
    "id": 11,
    "text": "庄子立足道家“道”的境界，主张顺应自然、齐同物我，",
    "start": 50.255,
    "end": 54.467,
    "duration": 4.212
  },
  {
    "id": 12,
    "text": "将个体从世俗名利与政治倾轧中解脱出来，",
    "start": 54.846,
    "end": 58.058,
    "duration": 3.212
  },
  {
    "id": 13,
    "text": "宁可“曳尾于涂中”也不受庙堂束缚，在生死祸福面前保持超然自适；",
    "start": 58.437,
    "end": 64.049,
    "duration": 5.612
  },
  {
    "id": 14,
    "text": "屈原则怀抱炽热的爱国忠君情怀，始终将个人命运与楚国存亡紧密相连，",
    "start": 64.727,
    "end": 70.739,
    "duration": 6.012
  },
  {
    "id": 15,
    "text": "终生坚持选贤任能、修明法度的“美政”理想，",
    "start": 71.118,
    "end": 74.93,
    "duration": 3.812
  },
  {
    "id": 16,
    "text": "面对谗谄围攻仍宣告“亦余心之所善兮，虽九死其犹未悔”。",
    "start": 75.309,
    "end": 80.161,
    "duration": 4.852
  },
  {
    "id": 17,
    "text": "庄子以退隐护守心灵自由，屈原则以殉道彰显烈士风骨。",
    "start": 80.799,
    "end": 85.331,
    "duration": 4.532
  },
  {
    "id": 18,
    "text": "第二，庄子以“三言”寓言阐发玄理，屈原以“香草美人”寄托忠爱。",
    "start": 85.969,
    "end": 90.821,
    "duration": 4.852
  },
  {
    "id": 19,
    "text": "在浪漫主义的表现载体上，庄子重在说“理”，建立起“寓言”“重言”“卮言”相辅的表意方式。",
    "start": 91.459,
    "end": 97.871,
    "duration": 6.412
  },
  {
    "id": 20,
    "text": "无论是《庖丁解牛》的依乎天理，还是《秋水》中以鹓雏腐鼠讽喻功名利禄，皆以形象寓言嘲弄世俗机心；",
    "start": 98.549,
    "end": 108.521,
    "duration": 9.972
  },
  {
    "id": 21,
    "text": "屈原则重在抒“情”，拓展了《诗经》的比兴传统，",
    "start": 109.155,
    "end": 110.807,
    "duration": 1.652
  },
  {
    "id": 22,
    "text": "创立了系统的“香草美人”象征体系，以辟芷、秋兰、木兰等芳草自喻高洁品格与才具，",
    "start": 111.186,
    "end": 118.038,
    "duration": 6.852
  },
  {
    "id": 23,
    "text": "以恶草比附奸佞宵小，以美人寄托贤君知己。",
    "start": 118.587,
    "end": 122.799,
    "duration": 4.212
  },
  {
    "id": 24,
    "text": "庄子借寓言破除执念，屈原借象征高扬人格。",
    "start": 123.328,
    "end": 126.98,
    "duration": 3.652
  },
  {
    "id": 25,
    "text": "第三，同具吞吐宇宙之奇想，而庄子神游超脱尘世，屈原升腾终归故乡。",
    "start": 127.604,
    "end": 133.696,
    "duration": 6.092
  },
  {
    "id": 26,
    "text": "二者均拥有超越常轨的奇伟想象力，但虚实运思的方向不同。",
    "start": 134.374,
    "end": 138.946,
    "duration": 4.572
  },
  {
    "id": 27,
    "text": "庄子的想象向外无限展开且无所牵挂，在《逍遥游》中，",
    "start": 139.624,
    "end": 143.596,
    "duration": 3.972
  },
  {
    "id": 28,
    "text": "大鹏“水击三千里，抟扶摇而上者九万里”，",
    "start": 143.975,
    "end": 147.027,
    "duration": 3.052
  },
  {
    "id": 29,
    "text": "神思在无穷宇宙中自在遨游，现实世界在其哲学俯瞰下化为虚空；",
    "start": 147.406,
    "end": 152.378,
    "duration": 4.972
  },
  {
    "id": 30,
    "text": "屈原在《离骚》中的天界神游，则是现实受挫后的悲愤求索，",
    "start": 153.056,
    "end": 157.468,
    "duration": 4.412
  },
  {
    "id": 31,
    "text": "诗人虽驾鸾凤周流上下、叩九重天门，但飞升云霓之上忽然俯瞰故土，",
    "start": 157.847,
    "end": 164.059,
    "duration": 6.212
  },
  {
    "id": 32,
    "text": "“陟升皇之赫戏兮，忽临睨夫旧乡”，仆夫悲、马怀而不前，最终剧烈跌回现实悲剧。",
    "start": 164.534,
    "end": 171.826,
    "duration": 7.292
  },
  {
    "id": 33,
    "text": "庄子的神游导向精神解脱，屈原的神游归于现实悲壮。",
    "start": 172.517,
    "end": 176.809,
    "duration": 4.292
  },
  {
    "id": 34,
    "text": "第四，共筑中国古典浪漫主义审美基因，深远滋养后代文人心灵。",
    "start": 177.487,
    "end": 182.579,
    "duration": 5.092
  },
  {
    "id": 35,
    "text": "庄子汪洋恣肆的散文气势与超脱思想，为中国文学注入了自由旷达的灵气，",
    "start": 183.257,
    "end": 186.349,
    "duration": 3.092
  },
  {
    "id": 36,
    "text": "深刻启迪了魏晋玄风、陶渊明的隐逸情趣与李白的盛唐豪迈；",
    "start": 186.728,
    "end": 189.34,
    "duration": 2.612
  },
  {
    "id": 37,
    "text": "屈原忠贞不渝的爱国精神、悲壮美感与香草美人传统，",
    "start": 189.869,
    "end": 191.641,
    "duration": 1.772
  },
  {
    "id": 38,
    "text": "则培育了中国士人担当家国的品格，滋养了杜甫的沉郁诗史与历代爱国诗文。",
    "start": 192.02,
    "end": 195.232,
    "duration": 3.212
  },
  {
    "id": 39,
    "text": "庄屈双峰并立，共同构成了中华民族浪漫主义精神不可或缺的两大基石。",
    "start": 195.87,
    "end": 206.642,
    "duration": 10.772
  },
  {
    "id": 40,
    "text": "由此观之，庄子与屈原分居南北文化传统之中，",
    "start": 207.4,
    "end": 208.572,
    "duration": 1.172
  },
  {
    "id": 41,
    "text": "各自将奇特瑰丽的浪漫想象推向极致，却走向超脱尘网与坚守家国的不同精神归宿。",
    "start": 208.951,
    "end": 213.083,
    "duration": 4.132
  },
  {
    "id": 42,
    "text": "庄子的寓言思辨为后代文学注入清旷超逸的哲理气韵，",
    "start": 213.801,
    "end": 220.613,
    "duration": 6.812
  },
  {
    "id": 43,
    "text": "屈原的香草美人与忠爱热忱则培育了士人担当家国的深沉品格，",
    "start": 220.992,
    "end": 233.91,
    "duration": 12.918
  },
  {
    "id": 44,
    "text": "二人共筑中国古典浪漫主义文学的源头传统。",
    "start": 234.46,
    "end": 237.672,
    "duration": 3.212
  }
]