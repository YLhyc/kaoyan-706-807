[
  {
    "id": 1,
    "text": "简述《左传》的叙事艺术特征及其对先秦历史散文演进的文学史贡献。",
    "start": 0.098,
    "end": 5.868,
    "duration": 5.77
  },
  {
    "id": 2,
    "text": "《左传》（全称 《春秋左氏传》） 是中国古代第一部记事完备、",
    "start": 6.422,
    "end": 10.931,
    "duration": 4.509
  },
  {
    "id": 3,
    "text": "叙事宏富的编年体史学与文学巨著。",
    "start": 11.136,
    "end": 14.09,
    "duration": 2.954
  },
  {
    "id": 4,
    "text": "它突破了早期历史散文零散简略的局限，",
    "start": 14.13,
    "end": 17.479,
    "duration": 3.349
  },
  {
    "id": 5,
    "text": "标志着先秦叙事散文走向全面成熟。",
    "start": 17.569,
    "end": 20.518,
    "duration": 2.949
  },
  {
    "id": 6,
    "text": "刘知幾在 《史通》 中盛赞其 “其言简而要，其事详而博”。",
    "start": 20.739,
    "end": 25.61,
    "duration": 4.871
  },
  {
    "id": 7,
    "text": "《左传》 的叙事艺术特征及其在历史散文演进中的文学史贡献，",
    "start": 26.161,
    "end": 30.707,
    "duration": 4.546
  },
  {
    "id": 8,
    "text": "主要展现为以下三个核心维度：",
    "start": 30.764,
    "end": 33.174,
    "duration": 2.41
  },
  {
    "id": 9,
    "text": "第一，确立编年详博之叙事规制，",
    "start": 33.408,
    "end": 36.363,
    "duration": 2.955
  },
  {
    "id": 10,
    "text": "实现由记言为主向记事写人为主的历史飞跃。",
    "start": 36.629,
    "end": 40.341,
    "duration": 3.712
  },
  {
    "id": 11,
    "text": "《尚书》 与春秋前期的史书多偏重于政治誓词与言论的记载（记言），",
    "start": 40.566,
    "end": 46.103,
    "duration": 5.537
  },
  {
    "id": 12,
    "text": "而 《春秋》 经文则由于微言大义而过于简括。",
    "start": 46.724,
    "end": 50.048,
    "duration": 3.324
  },
  {
    "id": 13,
    "text": "《左传》 以鲁国十二公为纲，以时间为经，以事件为纬，",
    "start": 50.509,
    "end": 54.976,
    "duration": 4.467
  },
  {
    "id": 14,
    "text": "详尽记录了春秋二百五十余年间列国争霸、",
    "start": 55.234,
    "end": 58.781,
    "duration": 3.547
  },
  {
    "id": 15,
    "text": "政权兴亡与社会变迁的完整历程。",
    "start": 58.816,
    "end": 61.437,
    "duration": 2.621
  },
  {
    "id": 16,
    "text": "全书不仅记述历史事件的始末缘由，",
    "start": 61.608,
    "end": 64.342,
    "duration": 2.734
  },
  {
    "id": 17,
    "text": "更细致描写事件发展的前因后果，",
    "start": 64.406,
    "end": 67.13,
    "duration": 2.724
  },
  {
    "id": 18,
    "text": "展现出波澜起伏的长篇结构组织能力，",
    "start": 67.179,
    "end": 70.3,
    "duration": 3.121
  },
  {
    "id": 19,
    "text": "奠定了中国古代叙事文学的坚实基石。",
    "start": 70.43,
    "end": 73.145,
    "duration": 2.715
  },
  {
    "id": 20,
    "text": "第二，长于全景式展现战争场面，",
    "start": 73.413,
    "end": 76.266,
    "duration": 2.853
  },
  {
    "id": 21,
    "text": "开创谋略铺陈与戏剧性交锋之描写范式。",
    "start": 76.521,
    "end": 79.983,
    "duration": 3.462
  },
  {
    "id": 22,
    "text": "《左传》 写战争不单纯写两军肉搏厮杀，",
    "start": 80.311,
    "end": 83.444,
    "duration": 3.133
  },
  {
    "id": 23,
    "text": "而是将战争视为政治、外交、人心的全方位交锋。",
    "start": 83.732,
    "end": 87.504,
    "duration": 3.772
  },
  {
    "id": 24,
    "text": "在 “城濮之战”、“邲之战”、“崤之战” 等著名战役中，",
    "start": 87.709,
    "end": 91.674,
    "duration": 3.965
  },
  {
    "id": 25,
    "text": "作者详写战前君臣谋划、军事情报刺探、",
    "start": 91.893,
    "end": 95.178,
    "duration": 3.285
  },
  {
    "id": 26,
    "text": "阵前外交折冲与战略退让（如重耳 “退避三舍”），",
    "start": 95.283,
    "end": 99.479,
    "duration": 4.196
  },
  {
    "id": 27,
    "text": "随后以精练笔触白描决战胜负，",
    "start": 99.637,
    "end": 102.331,
    "duration": 2.694
  },
  {
    "id": 28,
    "text": "并在战后以君子之言总结胜败根源。",
    "start": 102.515,
    "end": 105.524,
    "duration": 3.009
  },
  {
    "id": 29,
    "text": "整场战争叙事主次分明、跌宕起伏，极富戏剧冲突张力。",
    "start": 105.564,
    "end": 110.159,
    "duration": 4.595
  },
  {
    "id": 30,
    "text": "第三，精于塑造立体生动的人物群像，",
    "start": 110.332,
    "end": 113.505,
    "duration": 3.173
  },
  {
    "id": 31,
    "text": "展现辞采斐然的行人外交辞令。",
    "start": 113.915,
    "end": 116.484,
    "duration": 2.569
  },
  {
    "id": 32,
    "text": "《左传》 善于在尖锐的利益冲突与言行细节中刻画人物。",
    "start": 116.798,
    "end": 121.009,
    "duration": 4.211
  },
  {
    "id": 33,
    "text": "无论是雄才大略的晋文公、阴险机诈的郑庄公，",
    "start": 121.297,
    "end": 124.845,
    "duration": 3.548
  },
  {
    "id": 34,
    "text": "还是深明大义的烛之武、子产，皆形神兼备。",
    "start": 125.012,
    "end": 128.485,
    "duration": 3.473
  },
  {
    "id": 35,
    "text": "书中大量记载列国外交辞令（“行人辞令”），",
    "start": 128.697,
    "end": 131.784,
    "duration": 3.087
  },
  {
    "id": 36,
    "text": "如 《烛之武退秦师》 中烛之武利用秦晋地缘矛盾瓦解秦军，",
    "start": 131.955,
    "end": 136.604,
    "duration": 4.649
  },
  {
    "id": 37,
    "text": "言辞委婉含蓄、切中利害、理直气壮，",
    "start": 136.787,
    "end": 139.715,
    "duration": 2.928
  },
  {
    "id": 38,
    "text": "不仅具备高超的辩论说服力，更具有极高的文学辞采，",
    "start": 139.912,
    "end": 143.704,
    "duration": 3.792
  },
  {
    "id": 39,
    "text": "对后世战国策士散文与史传文学产生了深远启迪。",
    "start": 143.862,
    "end": 148.032,
    "duration": 4.17
  }
]
