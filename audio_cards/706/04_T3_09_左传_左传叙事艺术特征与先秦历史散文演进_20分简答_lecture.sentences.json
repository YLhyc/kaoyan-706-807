[
  {
    "id": 1,
    "text": "简述《左传》的叙事艺术特征及其对先秦历史散文演进的文学史贡献。",
    "start": 0.113,
    "end": 5.616,
    "duration": 5.503
  },
  {
    "id": 2,
    "text": "《左传》（全称《春秋左氏传》）是我国第一部记事完备的编年体史书，",
    "start": 6.056,
    "end": 11.003,
    "duration": 4.947
  },
  {
    "id": 3,
    "text": "标志着先秦叙事散文的全面成熟。",
    "start": 11.423,
    "end": 13.898,
    "duration": 2.475
  },
  {
    "id": 4,
    "text": "刘知幾在《史通》中盛赞其“盖左氏为书，叙事之最”。",
    "start": 14.255,
    "end": 18.73,
    "duration": 4.475
  },
  {
    "id": 5,
    "text": "其叙事艺术特征与演进贡献，主要体现在以下三个方面：",
    "start": 18.993,
    "end": 23.533,
    "duration": 4.54
  },
  {
    "id": 6,
    "text": "第一，确立编年详博之叙事体制，",
    "start": 24.164,
    "end": 27.157,
    "duration": 2.993
  },
  {
    "id": 7,
    "text": "推动历史散文由记言转向记事写人。",
    "start": 27.533,
    "end": 30.789,
    "duration": 3.256
  },
  {
    "id": 8,
    "text": "《尚书》与春秋早期史书偏重记言，《春秋》经文则过于简括。",
    "start": 31.007,
    "end": 35.859,
    "duration": 4.852
  },
  {
    "id": 9,
    "text": "《左传》以《春秋》记事为纲，",
    "start": 36.162,
    "end": 37.826,
    "duration": 1.664
  },
  {
    "id": 10,
    "text": "记录春秋二百余年间列国争霸与政权兴亡，",
    "start": 38.055,
    "end": 41.793,
    "duration": 3.738
  },
  {
    "id": 11,
    "text": "不仅交代事件始末与因果脉络，还穿插倒叙、预叙等灵活笔法，",
    "start": 42.132,
    "end": 47.318,
    "duration": 5.186
  },
  {
    "id": 12,
    "text": "并开创以“君子曰”直接评价史事人物的新体式。",
    "start": 47.531,
    "end": 51.221,
    "duration": 3.69
  },
  {
    "id": 13,
    "text": "这种写法将简短纲目发展为血肉丰满的长篇叙事散文，",
    "start": 51.525,
    "end": 56.11,
    "duration": 4.585
  },
  {
    "id": 14,
    "text": "奠定了后世史传文学的基础。",
    "start": 56.468,
    "end": 58.472,
    "duration": 2.004
  },
  {
    "id": 15,
    "text": "第二，长于全景描写重大战争，注重揭示战争因果与政治谋略。",
    "start": 59.089,
    "end": 64.234,
    "duration": 5.145
  },
  {
    "id": 16,
    "text": "《左传》写战争不局限于两军厮杀过程，而是从政治、",
    "start": 64.779,
    "end": 68.838,
    "duration": 4.059
  },
  {
    "id": 17,
    "text": "外交与礼义角度揭示胜败根源。",
    "start": 69.359,
    "end": 71.655,
    "duration": 2.296
  },
  {
    "id": 18,
    "text": "在“城濮之战”“崤之战”“邲之战”等名战中，",
    "start": 72.229,
    "end": 75.123,
    "duration": 2.894
  },
  {
    "id": 19,
    "text": "作者详写战前君臣谋划、",
    "start": 75.576,
    "end": 77.319,
    "duration": 1.743
  },
  {
    "id": 20,
    "text": "外交折冲与战略退让（如晋文公“退避三舍”），",
    "start": 77.581,
    "end": 81.423,
    "duration": 3.842
  },
  {
    "id": 21,
    "text": "略写交锋厮杀却能抓住要害细节，战后又总结胜败教训。",
    "start": 81.734,
    "end": 86.138,
    "duration": 4.404
  },
  {
    "id": 22,
    "text": "叙事主次分明、波澜起伏，极富戏剧冲突色彩。",
    "start": 86.559,
    "end": 90.426,
    "duration": 3.867
  },
  {
    "id": 23,
    "text": "第三，善借言行细节刻画鲜活人物，并展现典雅精练的外交辞令。",
    "start": 91.075,
    "end": 97.136,
    "duration": 6.061
  },
  {
    "id": 24,
    "text": "《左传》极少静止肖像描摹，",
    "start": 97.584,
    "end": 99.755,
    "duration": 2.171
  },
  {
    "id": 25,
    "text": "而善于通过人物在重大冲突中的动作与言谈展现性格，",
    "start": 100.072,
    "end": 104.472,
    "duration": 4.4
  },
  {
    "id": 26,
    "text": "如晋文公的成长、郑庄公的机诈及诸武士的忠义，皆形神兼备；",
    "start": 104.836,
    "end": 110.476,
    "duration": 5.64
  },
  {
    "id": 27,
    "text": "同时注重以生动细节传神。",
    "start": 110.844,
    "end": 112.899,
    "duration": 2.055
  },
  {
    "id": 28,
    "text": "书中保留了大量列国“行人辞令”，",
    "start": 113.147,
    "end": 115.723,
    "duration": 2.576
  },
  {
    "id": 29,
    "text": "如《烛之武退秦师》紧扣秦晋利害，委婉切理、不卑不亢，",
    "start": 116.088,
    "end": 120.982,
    "duration": 4.894
  },
  {
    "id": 30,
    "text": "被《史通》誉为“文典而美，语博而奥”，",
    "start": 121.233,
    "end": 124.211,
    "duration": 2.978
  },
  {
    "id": 31,
    "text": "深远启迪了战国策士散文与后世史传创作。",
    "start": 124.474,
    "end": 128.259,
    "duration": 3.785
  }
]