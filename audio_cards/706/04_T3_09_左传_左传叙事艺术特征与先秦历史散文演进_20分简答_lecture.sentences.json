[
  {
    "id": 1,
    "text": "简述《左传》的叙事艺术特征及其对先秦历史散文演进的文学史贡献。",
    "start": 0.16,
    "end": 5.6,
    "duration": 5.44
  },
  {
    "id": 2,
    "text": "《左传》（全称 《春秋左氏传》） 是中国古代第一部记事完备、",
    "start": 5.6,
    "end": 11.44,
    "duration": 5.84
  },
  {
    "id": 3,
    "text": "叙事宏富的编年体史学与文学巨著。",
    "start": 11.44,
    "end": 14.24,
    "duration": 2.8
  },
  {
    "id": 4,
    "text": "它突破了早期历史散文零散简略的局限，",
    "start": 14.24,
    "end": 17.84,
    "duration": 3.6
  },
  {
    "id": 5,
    "text": "标志着先秦叙事散文走向全面成熟。",
    "start": 17.84,
    "end": 21.28,
    "duration": 3.44
  },
  {
    "id": 6,
    "text": "刘知幾在 《史通》 中盛赞其 “其言简而要，其事详而博”。",
    "start": 21.28,
    "end": 27.12,
    "duration": 5.84
  },
  {
    "id": 7,
    "text": "《左传》 的叙事艺术特征及其在历史散文演进中的文学史贡献，",
    "start": 27.12,
    "end": 32.4,
    "duration": 5.28
  },
  {
    "id": 8,
    "text": "主要展现为以下三个核心维度：",
    "start": 32.4,
    "end": 35.6,
    "duration": 3.2
  },
  {
    "id": 9,
    "text": "第一，确立编年详博之叙事规制，",
    "start": 35.6,
    "end": 38.88,
    "duration": 3.28
  },
  {
    "id": 10,
    "text": "实现由记言为主向记事写人为主的历史飞跃。",
    "start": 38.88,
    "end": 43.083,
    "duration": 4.203
  },
  {
    "id": 11,
    "text": "《尚书》 与春秋前期的史书多偏重于政治誓词与言论的记载（记言），",
    "start": 43.083,
    "end": 49.807,
    "duration": 6.724
  },
  {
    "id": 12,
    "text": "而 《春秋》 经文则由于微言大义而过于简括。",
    "start": 49.807,
    "end": 53.711,
    "duration": 3.904
  },
  {
    "id": 13,
    "text": "《左传》 以鲁国十二公为纲，以时间为经，以事件为纬，",
    "start": 53.711,
    "end": 59.134,
    "duration": 5.423
  },
  {
    "id": 14,
    "text": "详尽记录了春秋二百五十余年间列国争霸、",
    "start": 59.134,
    "end": 63.04,
    "duration": 3.906
  },
  {
    "id": 15,
    "text": "政权兴亡与社会变迁的完整历程。",
    "start": 63.04,
    "end": 65.84,
    "duration": 2.8
  },
  {
    "id": 16,
    "text": "全书不仅记述历史事件的始末缘由，",
    "start": 65.84,
    "end": 68.96,
    "duration": 3.12
  },
  {
    "id": 17,
    "text": "更细致描写事件发展的前因后果，",
    "start": 68.96,
    "end": 71.76,
    "duration": 2.8
  },
  {
    "id": 18,
    "text": "展现出波澜起伏的长篇结构组织能力，",
    "start": 71.76,
    "end": 75.68,
    "duration": 3.92
  },
  {
    "id": 19,
    "text": "奠定了中国古代叙事文学的坚实基石。",
    "start": 75.68,
    "end": 79.44,
    "duration": 3.76
  },
  {
    "id": 20,
    "text": "第二，长于全景式展现战争场面，",
    "start": 79.44,
    "end": 82.08,
    "duration": 2.64
  },
  {
    "id": 21,
    "text": "开创谋略铺陈与戏剧性交锋之描写范式。",
    "start": 82.08,
    "end": 85.84,
    "duration": 3.76
  },
  {
    "id": 22,
    "text": "《左传》 写战争不单纯写两军肉搏厮杀，",
    "start": 86.0,
    "end": 90.32,
    "duration": 4.32
  },
  {
    "id": 23,
    "text": "而是将战争视为政治、外交、人心的全方位交锋。",
    "start": 90.32,
    "end": 94.88,
    "duration": 4.56
  },
  {
    "id": 24,
    "text": "在 “城濮之战”、“邲之战”、“崤之战” 等著名战役中，",
    "start": 94.88,
    "end": 100.96,
    "duration": 6.08
  },
  {
    "id": 25,
    "text": "作者详写战前君臣谋划、军事情报刺探、",
    "start": 101.04,
    "end": 104.88,
    "duration": 3.84
  },
  {
    "id": 26,
    "text": "阵前外交折冲与战略退让（如重耳 “退避三舍”），",
    "start": 104.88,
    "end": 109.28,
    "duration": 4.4
  },
  {
    "id": 27,
    "text": "随后以精练笔触白描决战胜负，",
    "start": 109.28,
    "end": 112.48,
    "duration": 3.2
  },
  {
    "id": 28,
    "text": "并在战后以君子之言总结胜败根源。",
    "start": 112.48,
    "end": 115.92,
    "duration": 3.44
  },
  {
    "id": 29,
    "text": "整场战争叙事主次分明、跌宕起伏，极富戏剧冲突张力。",
    "start": 115.92,
    "end": 120.698,
    "duration": 4.778
  },
  {
    "id": 30,
    "text": "第三，精于塑造立体生动的人物群像，",
    "start": 120.698,
    "end": 124.107,
    "duration": 3.409
  },
  {
    "id": 31,
    "text": "展现辞采斐然的行人外交辞令。",
    "start": 124.107,
    "end": 126.914,
    "duration": 2.807
  },
  {
    "id": 32,
    "text": "《左传》 善于在尖锐的利益冲突与言行细节中刻画人物。",
    "start": 126.914,
    "end": 131.927,
    "duration": 5.013
  },
  {
    "id": 33,
    "text": "无论是雄才大略的晋文公、阴险机诈的郑庄公，",
    "start": 131.927,
    "end": 136.138,
    "duration": 4.211
  },
  {
    "id": 34,
    "text": "还是深明大义的烛之武、子产，皆形神兼备。",
    "start": 136.138,
    "end": 140.148,
    "duration": 4.01
  },
  {
    "id": 35,
    "text": "书中大量记载列国外交辞令（“行人辞令”），",
    "start": 140.148,
    "end": 144.359,
    "duration": 4.211
  },
  {
    "id": 36,
    "text": "如 《烛之武退秦师》 中烛之武利用秦晋地缘矛盾瓦解秦军，",
    "start": 144.359,
    "end": 147.968,
    "duration": 3.609
  },
  {
    "id": 37,
    "text": "言辞委婉含蓄、切中利害、理直气壮，",
    "start": 147.767,
    "end": 147.968,
    "duration": 0.201
  },
  {
    "id": 38,
    "text": "不仅具备高超的辩论说服力，更具有极高的文学辞采，",
    "start": 147.767,
    "end": 147.968,
    "duration": 0.201
  },
  {
    "id": 39,
    "text": "对后世战国策士散文与史传文学产生了深远启迪。",
    "start": 147.767,
    "end": 147.968,
    "duration": 0.201
  }
]