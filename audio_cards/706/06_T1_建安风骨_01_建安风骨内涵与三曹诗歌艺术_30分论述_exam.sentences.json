[
  {
    "id": 1,
    "text": "汉末建安时期是中国文学史上极具划时代意义的觉醒期。",
    "start": 0.08,
    "end": 5.6,
    "duration": 5.52
  },
  {
    "id": 2,
    "text": "鲁迅在《魏晋风度及文章与药及酒之关系》中，",
    "start": 5.6,
    "end": 9.68,
    "duration": 4.08
  },
  {
    "id": 3,
    "text": "将该时期确立为“文学的自觉时代”。",
    "start": 9.68,
    "end": 13.28,
    "duration": 3.6
  },
  {
    "id": 4,
    "text": "“建安风骨”则是这一时期文学成就集大成的核心美学风貌。",
    "start": 13.28,
    "end": 18.88,
    "duration": 5.6
  },
  {
    "id": 5,
    "text": "刘协在《文心雕龙•风骨》中精辟界定：“情之待风，",
    "start": 18.88,
    "end": 23.6,
    "duration": 4.72
  },
  {
    "id": 6,
    "text": "如形之包气；",
    "start": 23.6,
    "end": 24.72,
    "duration": 1.12
  },
  {
    "id": 7,
    "text": "辞之待骨，如体之树骸”。",
    "start": 25.04,
    "end": 27.44,
    "duration": 2.4
  },
  {
    "id": 8,
    "text": "袁行配《中国文学史》指出，建安风骨是充沛激昂的政治情志与劲健刚拔的语言质力的完美融合。",
    "start": 27.44,
    "end": 35.84,
    "duration": 8.4
  },
  {
    "id": 9,
    "text": "其深厚的历史内涵与三曹诗歌的艺术探索，",
    "start": 35.84,
    "end": 39.76,
    "duration": 3.92
  },
  {
    "id": 10,
    "text": "主要展现在以下四个核心维度：建安风骨的形成根植于东汉末年军阀割据、",
    "start": 39.76,
    "end": 45.84,
    "duration": 6.08
  },
  {
    "id": 11,
    "text": "白骨露野的空前历史浩劫。",
    "start": 45.84,
    "end": 47.92,
    "duration": 2.08
  },
  {
    "id": 12,
    "text": "大动乱不仅粉碎了腐朽的汉代经学教条，",
    "start": 48.16,
    "end": 51.6,
    "duration": 3.44
  },
  {
    "id": 13,
    "text": "更唤醒了士人深沉的生命短促之悲。",
    "start": 51.6,
    "end": 54.96,
    "duration": 3.36
  },
  {
    "id": 14,
    "text": "然而建安文人并未陷入消极颓废的虚无之中，",
    "start": 54.96,
    "end": 58.56,
    "duration": 3.6
  },
  {
    "id": 15,
    "text": "而是将其转化为建功立业的强烈渴望。",
    "start": 58.56,
    "end": 62.0,
    "duration": 3.44
  },
  {
    "id": 16,
    "text": "曹操唯才是举打破世家垄断，使广大士人阶层个性高扬，",
    "start": 62.0,
    "end": 66.88,
    "duration": 4.88
  },
  {
    "id": 17,
    "text": "渴望在乱世留名青史。",
    "start": 66.88,
    "end": 69.04,
    "duration": 2.16
  },
  {
    "id": 18,
    "text": "诗人们一方面深沉抚慰民生凋敝之痛，",
    "start": 69.36,
    "end": 72.64,
    "duration": 3.28
  },
  {
    "id": 19,
    "text": "一方面洋溢着削平天下、重整乾坤的慷慨豪情。",
    "start": 72.64,
    "end": 77.28,
    "duration": 4.64
  },
  {
    "id": 20,
    "text": "这种忧患深沉与昂扬刚健的奇妙统一，",
    "start": 77.28,
    "end": 80.8,
    "duration": 3.52
  },
  {
    "id": 21,
    "text": "构成了建安风骨最独特的时代精神底色。",
    "start": 80.8,
    "end": 84.48,
    "duration": 3.68
  },
  {
    "id": 22,
    "text": "曹操是建安文学集团的领袖与灵魂，",
    "start": 84.48,
    "end": 87.52,
    "duration": 3.04
  },
  {
    "id": 23,
    "text": "钟融在《诗品》中评其诗“曹公古直，",
    "start": 87.52,
    "end": 90.96,
    "duration": 3.44
  },
  {
    "id": 24,
    "text": "甚有悲凉之句”。",
    "start": 90.96,
    "end": 92.08,
    "duration": 1.12
  },
  {
    "id": 25,
    "text": "曹操打破了汉代民间乐府的限制，开创了借乐府旧题直面书写当代时事的宏大范式。",
    "start": 92.4,
    "end": 99.2,
    "duration": 6.8
  },
  {
    "id": 26,
    "text": "在《蒿里行》中，他直笔揭露战乱惨景：“白骨露于野，",
    "start": 99.2,
    "end": 103.52,
    "duration": 4.32
  },
  {
    "id": 27,
    "text": "千里无鸡鸣。",
    "start": 103.52,
    "end": 104.8,
    "duration": 1.28
  },
  {
    "id": 28,
    "text": "生民百遗一，念之断人肠”。",
    "start": 104.8,
    "end": 107.44,
    "duration": 2.64
  },
  {
    "id": 29,
    "text": "在名作《短歌行》中，他感慨人生如朝露，",
    "start": 107.44,
    "end": 110.8,
    "duration": 3.36
  },
  {
    "id": 30,
    "text": "但最终落脚于“周公吐哺，天下归心”的宏伟抱负。",
    "start": 110.8,
    "end": 114.72,
    "duration": 3.92
  },
  {
    "id": 31,
    "text": "更为壮阔的是在《观沧海》中，描摹“日月之行，",
    "start": 114.96,
    "end": 118.88,
    "duration": 3.92
  },
  {
    "id": 32,
    "text": "若出其中；",
    "start": 118.88,
    "end": 119.902,
    "duration": 1.022
  },
  {
    "id": 33,
    "text": "星汉灿烂，若出其里”。",
    "start": 119.902,
    "end": 121.945,
    "duration": 2.043
  },
  {
    "id": 34,
    "text": "曹操以统帅与政治家的博大胸襟入诗，",
    "start": 121.945,
    "end": 126.033,
    "duration": 4.088
  },
  {
    "id": 35,
    "text": "使诗歌气吞山河、苍茫深邃，奠定了建安风骨的骨力根基。",
    "start": 126.033,
    "end": 131.908,
    "duration": 5.875
  },
  {
    "id": 36,
    "text": "曹植是建安文学成就最高的集大成者，",
    "start": 131.908,
    "end": 135.995,
    "duration": 4.087
  },
  {
    "id": 37,
    "text": "钟融在《诗品》中推为上品，盛赞其“骨气奇高，",
    "start": 135.995,
    "end": 140.338,
    "duration": 4.343
  },
  {
    "id": 38,
    "text": "辞采华茂”。",
    "start": 140.338,
    "end": 141.36,
    "duration": 1.022
  },
  {
    "id": 39,
    "text": "曹植的创作以曹丕称帝为界，呈现出极为鲜明的前后期飞跃。",
    "start": 141.52,
    "end": 146.8,
    "duration": 5.28
  },
  {
    "id": 40,
    "text": "前期生活在邺下幕府，诗风昂扬激越，",
    "start": 147.104,
    "end": 150.864,
    "duration": 3.76
  },
  {
    "id": 41,
    "text": "在《白马篇》中塑造出“捐躯赴国难，",
    "start": 150.864,
    "end": 154.064,
    "duration": 3.2
  },
  {
    "id": 42,
    "text": "视死忽如归”的英勇游侠形象。",
    "start": 154.064,
    "end": 156.864,
    "duration": 2.8
  },
  {
    "id": 43,
    "text": "后期曹植惨遭曹丕、曹瑞父子严酷的政治猜忌与软禁，",
    "start": 156.864,
    "end": 162.064,
    "duration": 5.2
  },
  {
    "id": 44,
    "text": "诗风转入悲愤幽怨与深沉自怜。",
    "start": 162.064,
    "end": 165.424,
    "duration": 3.36
  },
  {
    "id": 45,
    "text": "在《野田黄雀行》中借黄雀被缚倾诉绝望，",
    "start": 165.424,
    "end": 169.424,
    "duration": 4.0
  },
  {
    "id": 46,
    "text": "在《赠白马王彪》中借远行诀别痛陈骨肉相残。",
    "start": 169.424,
    "end": 173.504,
    "duration": 4.08
  },
  {
    "id": 47,
    "text": "曹植将建安风骨的刚劲骨力与华美藻饰完美融为一体，",
    "start": 173.904,
    "end": 178.544,
    "duration": 4.64
  },
  {
    "id": 48,
    "text": "开创了五言诗抒情的典范。",
    "start": 178.544,
    "end": 180.784,
    "duration": 2.24
  },
  {
    "id": 49,
    "text": "三曹之中曹丕诗风别具一格，钟融在《诗品》中评其“良称便娟，",
    "start": 180.784,
    "end": 186.464,
    "duration": 5.68
  },
  {
    "id": 50,
    "text": "婉约之词”。",
    "start": 186.464,
    "end": 187.584,
    "duration": 1.12
  },
  {
    "id": 51,
    "text": "曹丕善于描摹细腻纤巧的情感，《燕歌行》成为中国现存最早成熟的文人七言诗。",
    "start": 187.584,
    "end": 193.824,
    "duration": 6.24
  },
  {
    "id": 52,
    "text": "与此同时，建安七子与女诗人蔡琰共同丰富了建安风骨的广度。",
    "start": 194.144,
    "end": 199.584,
    "duration": 5.44
  },
  {
    "id": 53,
    "text": "王灿在《七哀诗》中写道“出门无所见，",
    "start": 199.584,
    "end": 203.104,
    "duration": 3.52
  },
  {
    "id": 54,
    "text": "白骨蔽平原”，纪实深沉入木三分。",
    "start": 203.104,
    "end": 206.464,
    "duration": 3.36
  },
  {
    "id": 55,
    "text": "蔡琰的名篇《悲愤诗》则是五言自传体长篇叙事诗的开山绝唱，",
    "start": 206.464,
    "end": 211.904,
    "duration": 5.44
  },
  {
    "id": 56,
    "text": "血泪控诉胡骑掠夺。",
    "start": 211.904,
    "end": 213.504,
    "duration": 1.6
  },
  {
    "id": 57,
    "text": "这表明建安风骨绝非单一的雄迈，而是刚柔互济、",
    "start": 213.824,
    "end": 218.064,
    "duration": 4.24
  },
  {
    "id": 58,
    "text": "悲慨与凄美相生相成的丰富艺术世界。",
    "start": 218.064,
    "end": 221.584,
    "duration": 3.52
  },
  {
    "id": 59,
    "text": "综上所述，建安风骨是中国古典诗歌史上现实精神与崇高阳刚品格的第一座高峰。",
    "start": 221.584,
    "end": 228.624,
    "duration": 7.04
  },
  {
    "id": 60,
    "text": "它确立了五言诗成熟的文学正统地位，",
    "start": 228.624,
    "end": 231.824,
    "duration": 3.2
  },
  {
    "id": 61,
    "text": "树立了后代文人力抗靡丽浮华的思想武器。",
    "start": 231.824,
    "end": 235.184,
    "duration": 3.36
  },
  {
    "id": 62,
    "text": "从西晋左思追求风力，到初唐陈子昂倡导风骨，",
    "start": 235.504,
    "end": 240.064,
    "duration": 4.56
  },
  {
    "id": 63,
    "text": "再到盛唐李杜的高唱，建安风骨成为流淌在中国诗学血脉中的永恒力量。--",
    "start": 240.064,
    "end": 246.384,
    "duration": 6.32
  }
]