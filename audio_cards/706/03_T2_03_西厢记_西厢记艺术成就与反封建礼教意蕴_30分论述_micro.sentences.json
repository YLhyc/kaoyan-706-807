[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《西厢记》·艺术成就与反封建礼教意蕴",
    "start": 0.134,
    "end": 3.906,
    "duration": 3.772
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "主题→人物→结构→曲词：先树起“婚姻自主/以情抗礼”的思想旗帜，",
    "start": 4.416,
    "end": 12.108,
    "duration": 7.692
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再看旗帜下莺莺、张生、红娘各有分寸的反抗心理交锋，",
    "start": 12.416,
    "end": 18.188,
    "duration": 5.772
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "进而看“五本二十折”如何破除一本四折成规扣紧冲突，",
    "start": 18.576,
    "end": 23.548,
    "duration": 4.972
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后品读《长亭送别》文采与本色兼美之曲词。",
    "start": 23.936,
    "end": 28.108,
    "duration": 4.172
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《西厢记》是元杂剧文人创作高峰。",
    "start": 28.561,
    "end": 32.093,
    "duration": 3.532
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "王实甫脱胎元稹《莺莺传》与董解元《西厢记诸宫调》，喊出“愿普天下有情的都成了眷属”，",
    "start": 32.211,
    "end": 39.503,
    "duration": 7.292
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "朱权《太和正音谱》赞“花间美人”。",
    "start": 39.651,
    "end": 42.543,
    "duration": 2.892
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 确立以情抗礼、婚姻自主的主题",
    "start": 43.251,
    "end": 46.863,
    "duration": 3.612
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "否定“父母之命，媒妁之言”，崔张冲破名分门第礼法，把真诚爱情置于功名与礼教之上；",
    "start": 47.391,
    "end": 56.603,
    "duration": 9.212
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "揭破老夫人借“不招白衣女婿”赖婚逼考之虚伪，摆脱依附功名“报恩合礼”旧套，升华为反礼教思想力。",
    "start": 57.071,
    "end": 67.483,
    "duration": 10.412
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 精细刻画内心矛盾、塑反抗群像",
    "start": 68.165,
    "end": 71.937,
    "duration": 3.772
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "莺莺相国千金，于“闹简”“赖简”中呈现内热外冷的羞涩试探；张生志诚痴情、抛却功名乃至跳墙；",
    "start": 72.375,
    "end": 81.957,
    "duration": 9.582
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "侍女红娘机智泼辣，“拷红”中面对严刑巧用礼教信义反客为主，逼使老夫人屈服。",
    "start": 82.485,
    "end": 90.628,
    "duration": 8.143
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 首创“五本二十折”宏大严密结构",
    "start": 91.336,
    "end": 95.297,
    "duration": 3.961
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "突破一本四折及单角独唱成规，首创“五本二十折”联套，〔络丝娘煞尾〕接续前后、末旦轮唱；",
    "start": 95.639,
    "end": 104.371,
    "duration": 8.732
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "主辅双线由佛殿奇遇、兵围普救寺、白马解围至赖婚、琴心、拷红、长亭送别，环环相扣。",
    "start": 104.899,
    "end": 113.951,
    "duration": 9.052
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 兼备诗词雅趣与戏曲本色语言",
    "start": 114.642,
    "end": 118.574,
    "duration": 3.932
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "徐复祚赞“字字当行，言言本色”：第四本第三折“长亭送别”“碧云天，黄花地……总是离人泪”化范仲淹词境声泪俱下，红娘宾白则俏皮犀利；",
    "start": 119.026,
    "end": 132.638,
    "duration": 13.612
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "直接启迪明清《牡丹亭》《红楼梦》等反礼教名著。",
    "start": 133.166,
    "end": 137.738,
    "duration": 4.572
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "王实甫《西厢记》借崔张红反抗高扬婚姻自主，以五本联套与文采本色曲词登顶元杂剧，",
    "start": 138.341,
    "end": 147.153,
    "duration": 8.812
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "直接启迪明代《牡丹亭》与清代《红楼梦》反礼教精神。",
    "start": 147.381,
    "end": 151.553,
    "duration": 4.172
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：脱胎自唐代元稹《莺莺传》（悲剧收尾）与金代董解元《西厢记诸宫调》；",
    "start": 152.261,
    "end": 159.313,
    "duration": 7.052
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "朱权《太和正音谱》赞其曲词如“花间美人”，徐复祚赞“字字当行，言言本色”。",
    "start": 159.671,
    "end": 166.883,
    "duration": 7.212
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 《西厢记》经历了从唐代元稹到金代董解元再到王实甫的哪三次蜕变？",
    "start": 167.535,
    "end": 175.627,
    "duration": 8.092
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释“五本二十折”联套体制及“拷红”“长亭送别”的戏剧功能？",
    "start": 176.116,
    "end": 181.888,
    "duration": 5.772
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 朱权与徐复祚各用哪四字/八字评语高度概括该剧曲词艺术？",
    "start": 182.398,
    "end": 189.21,
    "duration": 6.812
  }
]