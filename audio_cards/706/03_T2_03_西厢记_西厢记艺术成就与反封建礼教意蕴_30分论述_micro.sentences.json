[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《西厢记》·艺术成就与反封建礼教意蕴",
    "start": 0.394,
    "end": 3.486,
    "duration": 3.092
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "主题→人物→结构→曲词：先树起“婚姻自主/以情抗礼”的思想旗帜，",
    "start": 4.494,
    "end": 11.186,
    "duration": 6.692
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再看旗帜下莺莺、张生、红娘各有分寸的反抗心理交锋，",
    "start": 11.614,
    "end": 17.146,
    "duration": 5.532
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "进而看“五本二十折”如何破除一本四折成规扣紧冲突，",
    "start": 17.534,
    "end": 22.066,
    "duration": 4.532
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后品读《长亭送别》文采与本色兼美之曲词。",
    "start": 22.454,
    "end": 25.906,
    "duration": 3.452
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《西厢记》是元杂剧文人创作高峰。",
    "start": 26.914,
    "end": 29.446,
    "duration": 2.532
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "王实甫脱胎元稹《莺莺传》与董解元《西厢记诸宫调》，喊出“愿普天下有情的都成了眷属”，",
    "start": 30.454,
    "end": 38.226,
    "duration": 7.772
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "朱权《太和正音谱》赞“花间美人”。",
    "start": 38.374,
    "end": 41.266,
    "duration": 2.892
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 确立以情抗礼、婚姻自主的主题",
    "start": 42.274,
    "end": 45.646,
    "duration": 3.372
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "否定“父母之命，媒妁之言”，崔张冲破名分门第礼法，把真诚爱情置于功名与礼教之上；",
    "start": 46.654,
    "end": 55.786,
    "duration": 9.132
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "揭破老夫人借“不招白衣女婿”赖婚逼考之虚伪，摆脱依附功名“报恩合礼”旧套，升华为反礼教思想力。",
    "start": 56.834,
    "end": 66.566,
    "duration": 9.732
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 精细刻画内心矛盾、塑反抗群像",
    "start": 67.574,
    "end": 71.346,
    "duration": 3.772
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "莺莺相国千金，于“闹简”“赖简”中呈现内热外冷的羞涩试探；张生志诚痴情、抛却功名乃至跳墙；",
    "start": 72.354,
    "end": 82.946,
    "duration": 10.592
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "侍女红娘机智泼辣，“拷红”中面对严刑巧用礼教信义反客为主，逼使老夫人屈服。",
    "start": 84.074,
    "end": 92.846,
    "duration": 8.772
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 首创“五本二十折”宏大严密结构",
    "start": 93.5,
    "end": 96.872,
    "duration": 3.372
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "突破一本四折及单角独唱成规，首创“五本二十折”联套，〔络丝娘煞尾〕接续前后、末旦轮唱；",
    "start": 97.572,
    "end": 106.544,
    "duration": 8.972
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "主辅双线由佛殿奇遇、兵围普救寺、白马解围至赖婚、琴心、拷红、长亭送别，环环相扣。",
    "start": 107.512,
    "end": 116.524,
    "duration": 9.012
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 兼备诗词雅趣与戏曲本色语言",
    "start": 117.412,
    "end": 120.984,
    "duration": 3.572
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "徐复祚赞“字字当行，言言本色”：第四本第三折“长亭送别”“碧云天，黄花地……总是离人泪”化范仲淹词境声泪俱下，红娘宾白则俏皮犀利；",
    "start": 121.992,
    "end": 137.364,
    "duration": 15.372
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "直接启迪明清《牡丹亭》《红楼梦》等反礼教名著。",
    "start": 138.412,
    "end": 142.784,
    "duration": 4.372
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "王实甫《西厢记》借崔张红反抗高扬婚姻自主，以五本联套与文采本色曲词登顶元杂剧，",
    "start": 143.752,
    "end": 153.324,
    "duration": 9.572
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "直接启迪明代《牡丹亭》与清代《红楼梦》反礼教精神。",
    "start": 153.672,
    "end": 158.284,
    "duration": 4.612
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：脱胎自唐代元稹《莺莺传》（悲剧收尾）与金代董解元《西厢记诸宫调》；",
    "start": 159.332,
    "end": 165.704,
    "duration": 6.372
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "朱权《太和正音谱》赞其曲词如“花间美人”，徐复祚赞“字字当行，言言本色”。",
    "start": 166.672,
    "end": 173.484,
    "duration": 6.812
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 《西厢记》经历了从唐代元稹到金代董解元再到王实甫的哪三次蜕变？",
    "start": 174.492,
    "end": 182.064,
    "duration": 7.572
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释“五本二十折”联套体制及“拷红”“长亭送别”的戏剧功能？",
    "start": 183.032,
    "end": 188.924,
    "duration": 5.892
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 朱权与徐复祚各用哪四字/八字评语高度概括该剧曲词艺术？",
    "start": 189.972,
    "end": 196.904,
    "duration": 6.932
  }
]