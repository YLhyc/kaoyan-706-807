[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《西厢记》·艺术成就与反封建礼教意蕴",
    "start": 0.134,
    "end": 3.466,
    "duration": 3.332
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "主题→人物→结构→曲词：先树起“婚姻自主/以情抗礼”的思想旗帜，",
    "start": 4.042,
    "end": 11.047,
    "duration": 7.004
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再看旗帜下莺莺、张生、红娘各有分寸的反抗心理交锋，",
    "start": 11.334,
    "end": 16.815,
    "duration": 5.481
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "进而看“五本二十折”如何破除一本四折成规扣紧冲突，",
    "start": 16.916,
    "end": 21.498,
    "duration": 4.582
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后品读《长亭送别》文采与本色兼美之曲词。",
    "start": 21.76,
    "end": 25.665,
    "duration": 3.905
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《西厢记》是元杂剧文人创作高峰。",
    "start": 26.239,
    "end": 29.245,
    "duration": 3.007
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "王实甫脱胎元稹《莺莺传》与董解元《西厢记诸宫调》，喊出“愿普天下有情的都成了眷属”，",
    "start": 29.819,
    "end": 37.266,
    "duration": 7.447
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "朱权《太和正音谱》赞“花间美人”。",
    "start": 37.45,
    "end": 40.222,
    "duration": 2.772
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 确立以情抗礼、婚姻自主的主题",
    "start": 40.809,
    "end": 44.389,
    "duration": 3.58
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "否定“父母之命，媒妁之言”，崔张冲破名分门第礼法，把真诚爱情置于功名与礼教之上；",
    "start": 44.976,
    "end": 54.272,
    "duration": 9.296
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "揭破老夫人借“不招白衣女婿”赖婚逼考之虚伪，摆脱依附功名“报恩合礼”旧套，升华为反礼教思想力。",
    "start": 54.845,
    "end": 64.545,
    "duration": 9.7
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 精细刻画内心矛盾、塑反抗群像",
    "start": 65.119,
    "end": 68.647,
    "duration": 3.528
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "莺莺相国千金，于“闹简”“赖简”中呈现内热外冷的羞涩试探；张生志诚痴情、抛却功名乃至跳墙；",
    "start": 69.233,
    "end": 79.285,
    "duration": 10.051
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "侍女红娘机智泼辣，“拷红”中面对严刑巧用礼教信义反客为主，逼使老夫人屈服。",
    "start": 79.858,
    "end": 87.839,
    "duration": 7.981
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 首创“五本二十折”宏大严密结构",
    "start": 88.426,
    "end": 91.902,
    "duration": 3.476
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "突破一本四折及单角独唱成规，首创“五本二十折”联套，〔络丝娘煞尾〕接续前后、末旦轮唱；",
    "start": 92.489,
    "end": 100.769,
    "duration": 8.28
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "主辅双线由佛殿奇遇、兵围普救寺、白马解围至赖婚、琴心、拷红、长亭送别，环环相扣。",
    "start": 101.356,
    "end": 110.587,
    "duration": 9.231
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 兼备诗词雅趣与戏曲本色语言",
    "start": 111.161,
    "end": 114.844,
    "duration": 3.684
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "徐复祚赞“字字当行，言言本色”：第四本第三折“长亭送别”“碧云天，黄花地……总是离人泪”化范仲淹词境声泪俱下，红娘宾白则俏皮犀利；",
    "start": 115.431,
    "end": 129.324,
    "duration": 13.892
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "直接启迪明清《牡丹亭》《红楼梦》等反礼教名著。",
    "start": 129.898,
    "end": 134.402,
    "duration": 4.504
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "王实甫《西厢记》借崔张红反抗高扬婚姻自主，以五本联套与文采本色曲词登顶元杂剧，",
    "start": 134.989,
    "end": 142.852,
    "duration": 7.864
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "直接启迪明代《牡丹亭》与清代《红楼梦》反礼教精神。",
    "start": 143.14,
    "end": 147.462,
    "duration": 4.322
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：脱胎自唐代元稹《莺莺传》（悲剧收尾）与金代董解元《西厢记诸宫调》；",
    "start": 148.049,
    "end": 154.48,
    "duration": 6.431
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "朱权《太和正音谱》赞其曲词如“花间美人”，徐复祚赞“字字当行，言言本色”。",
    "start": 154.78,
    "end": 161.212,
    "duration": 6.431
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 《西厢记》经历了从唐代元稹到金代董解元再到王实甫的哪三次蜕变？",
    "start": 161.799,
    "end": 169.154,
    "duration": 7.356
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释“五本二十折”联套体制及“拷红”“长亭送别”的戏剧功能？",
    "start": 169.741,
    "end": 176.094,
    "duration": 6.353
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 朱权与徐复祚各用哪四字/八字评语高度概括该剧曲词艺术？",
    "start": 176.668,
    "end": 183.998,
    "duration": 7.33
  }
]