[
  {
    "id": 1,
    "text": "为了在一开篇就牢牢锚定考点核心并展示深厚的文学史素养，",
    "start": 0.08,
    "end": 5.2,
    "duration": 5.12
  },
  {
    "id": 2,
    "text": "第一句话必须首先给出陶渊明在文学史上的绝对地位与权威历史评语。",
    "start": 5.2,
    "end": 11.52,
    "duration": 6.32
  },
  {
    "id": 3,
    "text": "所以表述为：陶渊明是中国文学史上第一位开辟田园诗派的伟大诗人，",
    "start": 11.52,
    "end": 17.44,
    "duration": 5.92
  },
  {
    "id": 4,
    "text": "被钟融《诗品》尊为“古今隐逸诗人之宗”。。",
    "start": 17.44,
    "end": 20.72,
    "duration": 3.28
  },
  {
    "id": 5,
    "text": "紧接着必须讲明陶渊明归隐的时代土壤与生命抉择，",
    "start": 20.96,
    "end": 25.12,
    "duration": 4.16
  },
  {
    "id": 6,
    "text": "说明其文化品格形成的深刻政治动因。",
    "start": 25.12,
    "end": 28.48,
    "duration": 3.36
  },
  {
    "id": 7,
    "text": "所以表述为：在东晋门阀垄断与晋宋易代的剧烈动荡中，",
    "start": 28.48,
    "end": 33.68,
    "duration": 5.2
  },
  {
    "id": 8,
    "text": "陶渊明历经数次出仕与归隐，最终彻底勘破官场伪饰。。",
    "start": 33.68,
    "end": 39.04,
    "duration": 5.36
  },
  {
    "id": 9,
    "text": "随后需要引入标志性历史细节与士人风骨誓言，",
    "start": 39.04,
    "end": 43.28,
    "duration": 4.24
  },
  {
    "id": 10,
    "text": "生动展现其独立人格的挺立。",
    "start": 43.28,
    "end": 45.52,
    "duration": 2.24
  },
  {
    "id": 11,
    "text": "所以表述为：他发出“岂能为五斗米折腰向乡里小儿”的绝决誓言，",
    "start": 45.84,
    "end": 51.633,
    "duration": 5.793
  },
  {
    "id": 12,
    "text": "毅然解授归田。。",
    "start": 51.633,
    "end": 52.984,
    "duration": 1.351
  },
  {
    "id": 13,
    "text": "接下来要引申出陶渊明自我人格的核心哲学定义，",
    "start": 52.984,
    "end": 57.716,
    "duration": 4.732
  },
  {
    "id": 14,
    "text": "揭示其顺从天性的思想本源。",
    "start": 57.716,
    "end": 60.42,
    "duration": 2.704
  },
  {
    "id": 15,
    "text": "所以表述为：陶渊明将“质性自然，",
    "start": 60.42,
    "end": 63.349,
    "duration": 2.929
  },
  {
    "id": 16,
    "text": "非矫厉所得”的生命意志与乡村天地完全融为一体。。",
    "start": 63.349,
    "end": 68.08,
    "duration": 4.731
  },
  {
    "id": 17,
    "text": "确立了时代与人生抉择之后，尾句需要从文学题材突破与士人精神重构两个宏观向度统摄全篇论点。",
    "start": 68.24,
    "end": 77.36,
    "duration": 9.12
  },
  {
    "id": 18,
    "text": "所以表述为：他的田园诗不仅实现了中古诗歌题材的革命性突破，",
    "start": 77.36,
    "end": 82.72,
    "duration": 5.36
  },
  {
    "id": 19,
    "text": "更铸就了安贫乐道、任真自得的魏晋士人文化品格，",
    "start": 82.72,
    "end": 87.12,
    "duration": 4.4
  },
  {
    "id": 20,
    "text": "确立了中国士大夫阶层精神心灵的永恒归宿。。",
    "start": 87.12,
    "end": 90.56,
    "duration": 3.44
  },
  {
    "id": 21,
    "text": "本段用五句话完成全篇破题立论：首句亮出田园诗开派宗师地位与钟融权威评定，",
    "start": 90.88,
    "end": 98.24,
    "duration": 7.36
  },
  {
    "id": 22,
    "text": "次句指出门阀政治与归隐抉择，第三四句通过不折腰誓言与质性自然剖析其独立人格，",
    "start": 98.24,
    "end": 106.16,
    "duration": 7.92
  },
  {
    "id": 23,
    "text": "末句从题材革命与文化品格两端完成立论总括，",
    "start": 106.16,
    "end": 110.64,
    "duration": 4.48
  },
  {
    "id": 24,
    "text": "为后文具体维度的展开确立了清晰的答题主线。",
    "start": 110.64,
    "end": 114.72,
    "duration": 4.08
  },
  {
    "id": 25,
    "text": "所以本段具体答题完整版为：陶渊明是中国文学史上第一位开辟田园诗派的伟大诗人，",
    "start": 114.72,
    "end": 122.384,
    "duration": 7.664
  },
  {
    "id": 26,
    "text": "被钟融《诗品》尊为“古今隐逸诗人之宗”。",
    "start": 122.384,
    "end": 126.144,
    "duration": 3.76
  },
  {
    "id": 27,
    "text": "在东晋门阀垄断与晋宋易代的剧烈动荡中，",
    "start": 126.144,
    "end": 129.824,
    "duration": 3.68
  },
  {
    "id": 28,
    "text": "陶渊明历经数次出仕与归隐，最终彻底勘破官场伪饰。",
    "start": 129.824,
    "end": 134.624,
    "duration": 4.8
  },
  {
    "id": 29,
    "text": "他发出“岂能为五斗米折腰向乡里小儿”的绝决誓言，",
    "start": 134.624,
    "end": 139.424,
    "duration": 4.8
  },
  {
    "id": 30,
    "text": "毅然解授归田。",
    "start": 139.424,
    "end": 140.704,
    "duration": 1.28
  },
  {
    "id": 31,
    "text": "陶渊明将“质性自然，非矫厉所得”的生命意志与乡村天地完全融为一体。",
    "start": 140.944,
    "end": 147.504,
    "duration": 6.56
  },
  {
    "id": 32,
    "text": "他的田园诗不仅实现了中古诗歌题材的革命性突破，",
    "start": 147.504,
    "end": 151.744,
    "duration": 4.24
  },
  {
    "id": 33,
    "text": "更铸就了安贫乐道、任真自得的魏晋士人文化品格，",
    "start": 151.744,
    "end": 156.384,
    "duration": 4.64
  },
  {
    "id": 34,
    "text": "确立了中国士大夫阶层精神心灵的永恒归宿。--",
    "start": 156.384,
    "end": 159.904,
    "duration": 3.52
  }
]