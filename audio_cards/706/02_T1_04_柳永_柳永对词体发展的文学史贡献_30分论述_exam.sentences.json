[
  {
    "id": 1,
    "text": "试论柳永对词体发展的文学史贡献。",
    "start": 0.101,
    "end": 3.031,
    "duration": 2.93
  },
  {
    "id": 2,
    "text": "柳永是北宋第一位专力作词的专业词人。",
    "start": 3.531,
    "end": 6.792,
    "duration": 3.261
  },
  {
    "id": 3,
    "text": "面对五代至宋初词坛偏重小令、题材局限于士大夫尊前欢宴的狭隘格局，",
    "start": 7.292,
    "end": 13.645,
    "duration": 6.353
  },
  {
    "id": 4,
    "text": "柳永顺应宋代都市繁华与市民音乐兴盛的潮流，全方位革新词体，使宋词面貌为之一变。",
    "start": 14.042,
    "end": 21.71,
    "duration": 7.668
  },
  {
    "id": 5,
    "text": "叶梦得在《避暑录话》中记录其盛况曰：“凡有井水饮处，即能歌柳词。”其对词体发展的开拓性贡献，主要体现在以下四个方面：",
    "start": 22.21,
    "end": 32.257,
    "duration": 10.047
  },
  {
    "id": 6,
    "text": "第一，大力创作慢词长调，打破小令一统天下的狭小格局。",
    "start": 32.893,
    "end": 37.888,
    "duration": 4.995
  },
  {
    "id": 7,
    "text": "柳永以前，唐五代与宋初词坛均以数十余字的小令为主。",
    "start": 38.483,
    "end": 43.217,
    "duration": 4.734
  },
  {
    "id": 8,
    "text": "柳永充分吸纳坊曲新声，大力创作篇幅宏阔的慢词长调。",
    "start": 43.717,
    "end": 48.769,
    "duration": 5.052
  },
  {
    "id": 9,
    "text": "在现存宋词中，柳永一人就创作了慢词八十七调一百二十五首，",
    "start": 49.418,
    "end": 54.602,
    "duration": 5.184
  },
  {
    "id": 10,
    "text": "两宋所用词调中有一百多调为柳永首创或首次使用，令、引、近、慢体制自此完备。",
    "start": 54.952,
    "end": 62.8,
    "duration": 7.848
  },
  {
    "id": 11,
    "text": "慢词长调的勃兴，从根本上改变了小令短小精约、只宜截取片断的体制限制，",
    "start": 63.3,
    "end": 69.463,
    "duration": 6.163
  },
  {
    "id": 12,
    "text": "使词得以容纳曲折叙事、多层次抒情与细致铺排，",
    "start": 69.877,
    "end": 73.968,
    "duration": 4.091
  },
  {
    "id": 13,
    "text": "为苏轼、辛弃疾、周邦彦等后代词大家开辟了广阔的创作天地。",
    "start": 74.318,
    "end": 79.634,
    "duration": 5.316
  },
  {
    "id": 14,
    "text": "第二，革新词体表现手法，确立“铺叙展衍”与白描写景章法。",
    "start": 80.309,
    "end": 85.271,
    "duration": 4.962
  },
  {
    "id": 15,
    "text": "与小令注重意象跳跃、含蓄烘托不同，柳永将赋法移植入词，",
    "start": 85.799,
    "end": 90.805,
    "duration": 5.006
  },
  {
    "id": 16,
    "text": "开创了“铺叙展衍”与白描相配合的表现手法。",
    "start": 91.155,
    "end": 94.295,
    "duration": 3.14
  },
  {
    "id": 17,
    "text": "他善于利用时空转换，从现在回想过去、由己方设想对方，铺陈心理波澜。",
    "start": 94.85,
    "end": 100.942,
    "duration": 6.092
  },
  {
    "id": 18,
    "text": "在《八声甘州》中，先以“对潇潇暮雨洒江天，一番洗清秋”铺写秋江高远之景；",
    "start": 101.442,
    "end": 108.271,
    "duration": 6.829
  },
  {
    "id": 19,
    "text": "下片先以“不忍登高临远，望故乡渺邈，归思难收”直抒身世之慨；",
    "start": 108.771,
    "end": 114.743,
    "duration": 5.972
  },
  {
    "id": 20,
    "text": "继而笔锋陡转，虚设“想佳人、妆楼颙望，误几回、天际识归舟”，主客双向铺叙，情深意长；",
    "start": 115.243,
    "end": 124.338,
    "duration": 9.095
  },
  {
    "id": 21,
    "text": "《雨霖铃》则由都门帐饮、执手泪眼写到酒醒杨柳岸，层层敷衍，章法绵密。",
    "start": 124.919,
    "end": 131.532,
    "duration": 6.613
  },
  {
    "id": 22,
    "text": "第三，开拓羁旅行役与市井世俗题材，拓展词体审美视野。",
    "start": 132.194,
    "end": 137.619,
    "duration": 5.425
  },
  {
    "id": 23,
    "text": "柳永打破了传统文人词局限于闺怨相思与尊前恋情的旧套，",
    "start": 138.131,
    "end": 143.171,
    "duration": 5.04
  },
  {
    "id": 24,
    "text": "将自身仕途落魄、浪迹江湖的切身感受写入词中，开创了“羁旅行役”的自我化抒情新路。",
    "start": 143.647,
    "end": 150.905,
    "duration": 7.258
  },
  {
    "id": 25,
    "text": "同时，柳永贴近茶坊酒肆与市井大众，既同情下层歌妓与平民女性的悲欢，",
    "start": 151.405,
    "end": 157.908,
    "duration": 6.503
  },
  {
    "id": 26,
    "text": "也着力描绘北宋都市的繁华气象，如《望海潮》中“市列珠玑，户盈罗绮，竞豪奢”，",
    "start": 158.372,
    "end": 166.097,
    "duration": 7.725
  },
  {
    "id": 27,
    "text": "生动勾勒出钱塘都会的富庶风情，推动宋词从士大夫清雅书斋走向广阔的世俗生活。",
    "start": 166.572,
    "end": 174.29,
    "duration": 7.718
  },
  {
    "id": 28,
    "text": "第四，吸纳市井俚俗口语入词，形成通俗明畅的全新语言风貌。",
    "start": 174.915,
    "end": 180.669,
    "duration": 5.754
  },
  {
    "id": 29,
    "text": "在词的语言风格上，柳永突破了晚唐五代文人词一味求雅的雕琢积习，",
    "start": 181.169,
    "end": 186.869,
    "duration": 5.7
  },
  {
    "id": 30,
    "text": "大胆吸纳日常口语、方言俚语与市民俗语入词。",
    "start": 187.349,
    "end": 191.249,
    "duration": 3.9
  },
  {
    "id": 31,
    "text": "他的词句自然浅近、宛如面对面诉说，如《忆帝京》“系我一生心，负你千行泪”，",
    "start": 191.749,
    "end": 198.47,
    "duration": 6.721
  },
  {
    "id": 32,
    "text": "《蝶恋花》“衣带渐宽终不悔，为伊消得人憔悴”，直白晓畅而动人心弦。",
    "start": 198.82,
    "end": 204.88,
    "duration": 6.06
  },
  {
    "id": 33,
    "text": "同时，他也能写出“渐霜风凄紧，关河冷落，残照当楼”这样清健苍凉的写景佳句。",
    "start": 205.38,
    "end": 212.435,
    "duration": 7.055
  },
  {
    "id": 34,
    "text": "柳永的全面革新，直接启迪了苏轼与周邦彦的创作，为两宋词坛的繁荣兴盛奠定了坚实基础。",
    "start": 212.935,
    "end": 220.255,
    "duration": 7.32
  },
  {
    "id": 35,
    "text": "总而言之，柳永顺应北宋都市市民文化与燕乐新声的发展趋势，",
    "start": 220.764,
    "end": 225.993,
    "duration": 5.229
  },
  {
    "id": 36,
    "text": "以慢词长调、铺叙白描与俗语雅化打破了唐五代小令的狭小格局。",
    "start": 226.343,
    "end": 231.606,
    "duration": 5.263
  },
  {
    "id": 37,
    "text": "他将词的抒情视角从士大夫尊前欢宴拓展至羁旅飘零与市井世情，",
    "start": 232.106,
    "end": 237.773,
    "duration": 5.667
  },
  {
    "id": 38,
    "text": "不仅扩大了宋词的体制容量与社会接受面，也为苏轼革新词风及周邦彦精研格律铺平了道路。",
    "start": 238.123,
    "end": 245.456,
    "duration": 7.333
  }
]
