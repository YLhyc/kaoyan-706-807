[
  {
    "id": "sent_1",
    "text": "柳永是北宋词坛第一位全身心投入创作的专业词人。",
    "start": 0.1,
    "end": 4.972,
    "duration": 4.872
  },
  {
    "id": "sent_2",
    "text": "面对五代至宋初词坛小令题材局限于士大夫尊前欢宴、体式短狭的格局，",
    "start": 4.922,
    "end": 11.94,
    "duration": 7.018
  },
  {
    "id": "sent_3",
    "text": "柳永以毕生精力顺应市民音乐与坊市文化繁荣的历史潮流，",
    "start": 11.94,
    "end": 17.721,
    "duration": 5.781
  },
  {
    "id": "sent_4",
    "text": "对词体进行了全方位的开创性革新。",
    "start": 17.721,
    "end": 21.159,
    "duration": 3.438
  },
  {
    "id": "sent_5",
    "text": "叶梦得在 《避暑录话》 中记录其盛况：“凡有井水饮处，",
    "start": 21.159,
    "end": 25.807,
    "duration": 4.648
  },
  {
    "id": "sent_6",
    "text": "皆能歌柳词。",
    "start": 25.807,
    "end": 27.656,
    "duration": 1.849
  },
  {
    "id": "sent_7",
    "text": "” 其对宋代词体发展的划时代贡献，主要展现为以下四个核心维度：",
    "start": 27.656,
    "end": 33.698,
    "duration": 6.042
  },
  {
    "id": "sent_8",
    "text": "第一，大力创制慢词长调，全面打破小令狭隘格局以拓展篇幅容量。",
    "start": 33.698,
    "end": 40.56,
    "duration": 6.862
  },
  {
    "id": "sent_9",
    "text": "在柳永之前，词坛以五代花间以来数十至六七十字的小令为主。",
    "start": 40.56,
    "end": 46.693,
    "duration": 6.133
  },
  {
    "id": "sent_10",
    "text": "柳永充分吸纳坊市新声，大量创制百字以上的慢词长调。",
    "start": 46.693,
    "end": 52.084,
    "duration": 5.391
  },
  {
    "id": "sent_11",
    "text": "在两宋存世的数百个词调中，柳永创制和首先使用的慢词就达一百余个。",
    "start": 52.083,
    "end": 58.75,
    "duration": 6.667
  },
  {
    "id": "sent_12",
    "text": "慢词长调的普及，从根本上改变了词体短小轻灵的截取片断特征，",
    "start": 58.75,
    "end": 65.352,
    "duration": 6.602
  },
  {
    "id": "sent_13",
    "text": "使词具备了容纳复杂曲折叙事、多层次抒情与细致景物铺排的宏大体制，",
    "start": 65.352,
    "end": 72.175,
    "duration": 6.823
  },
  {
    "id": "sent_14",
    "text": "实现了由文人樽前余技向长篇独立抒情文学的体制跃升。",
    "start": 72.174,
    "end": 77.682,
    "duration": 5.508
  },
  {
    "id": "sent_15",
    "text": "第二，革新词体表现手法，确立“铺叙展衍”与白描写景的章法传统。",
    "start": 77.682,
    "end": 84.036,
    "duration": 6.354
  },
  {
    "id": "sent_16",
    "text": "与小令注重意象瞬间跳跃、含蓄凝练不同，",
    "start": 84.036,
    "end": 88.476,
    "duration": 4.44
  },
  {
    "id": "sent_17",
    "text": "柳永开创了 “铺叙展衍” 的赋体手法。",
    "start": 88.477,
    "end": 91.719,
    "duration": 3.242
  },
  {
    "id": "sent_18",
    "text": "他善于在时间和空间轴线上层层推进情节与情感。",
    "start": 91.719,
    "end": 96.797,
    "duration": 5.078
  },
  {
    "id": "sent_19",
    "text": "在 《八声甘州》 中，先以 “对潇潇暮雨洒江天，",
    "start": 96.797,
    "end": 100.755,
    "duration": 3.958
  },
  {
    "id": "sent_20",
    "text": "一番洗清秋” 极力铺写秋江寥落景象；",
    "start": 100.755,
    "end": 104.648,
    "duration": 3.893
  },
  {
    "id": "sent_21",
    "text": "接着以 “不忍登高临远，望故乡渺邈，归思难收” 直抒身世之慨；",
    "start": 104.648,
    "end": 110.703,
    "duration": 6.055
  },
  {
    "id": "sent_22",
    "text": "后半阕笔锋陡转，虚设对方之景，“想佳人，妆楼颙望，",
    "start": 110.703,
    "end": 116.146,
    "duration": 5.443
  },
  {
    "id": "sent_23",
    "text": "误几回、天际识归舟”，通过主客双向铺叙将相思羁旅推向极境；",
    "start": 116.146,
    "end": 122.643,
    "duration": 6.497
  },
  {
    "id": "sent_24",
    "text": "在 《雨霖铃》 中，由留恋执手到千种风情，",
    "start": 122.643,
    "end": 126.497,
    "duration": 3.854
  },
  {
    "id": "sent_25",
    "text": "全篇章法井然、顿挫有致。",
    "start": 126.497,
    "end": 129.336,
    "duration": 2.839
  },
  {
    "id": "sent_26",
    "text": "第三，开拓羁旅行役与市民世俗题材，实现审美趣味的平民化转向。",
    "start": 129.336,
    "end": 135.833,
    "duration": 6.497
  },
  {
    "id": "sent_27",
    "text": "柳永彻底打破了传统文人词局限于深闺怨妇与欢场作乐的陈旧主题，",
    "start": 135.833,
    "end": 142.278,
    "duration": 6.445
  },
  {
    "id": "sent_28",
    "text": "第一次将落魄士人的 “羁旅行役之苦” 写入词中。",
    "start": 142.279,
    "end": 146.485,
    "duration": 4.206
  },
  {
    "id": "sent_29",
    "text": "他将自身仕途受挫、浪迹江湖的真实漂泊体验倾注于词，",
    "start": 146.484,
    "end": 152.057,
    "duration": 5.573
  },
  {
    "id": "sent_30",
    "text": "开创了词史上的羁旅新传统。",
    "start": 152.057,
    "end": 155.013,
    "duration": 2.956
  },
  {
    "id": "sent_31",
    "text": "同时，柳永长期沉溺市井瓦舍，",
    "start": 155.013,
    "end": 158.385,
    "duration": 3.372
  },
  {
    "id": "sent_32",
    "text": "大量描写市井烟火、市民男女婚恋与都市繁华，",
    "start": 158.385,
    "end": 163.138,
    "duration": 4.753
  },
  {
    "id": "sent_33",
    "text": "如 《望海潮》 中 “市列珠玑，户盈罗绮，竞豪奢”，",
    "start": 163.138,
    "end": 167.552,
    "duration": 4.414
  },
  {
    "id": "sent_34",
    "text": "生动勾勒出北宋杭州的富庶气象，",
    "start": 167.552,
    "end": 171.003,
    "duration": 3.451
  },
  {
    "id": "sent_35",
    "text": "实现了宋词由士大夫书斋向大众世俗生活的深层沉降。",
    "start": 171.003,
    "end": 176.472,
    "duration": 5.469
  },
  {
    "id": "sent_36",
    "text": "第四，吸纳市井俚语与俗曲口语，形成通俗明畅的全新词体语言风格。",
    "start": 176.471,
    "end": 183.32,
    "duration": 6.849
  },
  {
    "id": "sent_37",
    "text": "在词的语言风格上，柳永敢于突破传统文人雕琢藻饰的清雅格调，",
    "start": 183.32,
    "end": 189.466,
    "duration": 6.146
  },
  {
    "id": "sent_38",
    "text": "大胆吸纳民间口语、俚俗方言与勾栏市井俗语。",
    "start": 189.466,
    "end": 194.193,
    "duration": 4.727
  },
  {
    "id": "sent_39",
    "text": "他的语言自然浅近、明白如话，如 “系我一生心，",
    "start": 194.193,
    "end": 199.193,
    "duration": 5.0
  },
  {
    "id": "sent_40",
    "text": "负你千行泪”、“衣带渐宽终不悔，为伊消得人憔悴”，",
    "start": 199.193,
    "end": 203.867,
    "duration": 4.674
  },
  {
    "id": "sent_41",
    "text": "直白晓畅而回肠荡气。",
    "start": 203.867,
    "end": 206.536,
    "duration": 2.669
  },
  {
    "id": "sent_42",
    "text": "苏轼对其诗化名句极度推崇，赞其 “霜风凄紧，关河冷落，",
    "start": 206.536,
    "end": 212.474,
    "duration": 5.938
  },
  {
    "id": "sent_43",
    "text": "残照当楼” 具有不减唐人高境之风骨。",
    "start": 212.474,
    "end": 216.341,
    "duration": 3.867
  },
  {
    "id": "sent_44",
    "text": "柳永的词体创造不仅直接启迪了苏轼、周邦彦等后代词学大家，",
    "start": 216.341,
    "end": 222.461,
    "duration": 6.12
  },
  {
    "id": "sent_45",
    "text": "更为两宋慢词的极盛繁荣奠定了基石。",
    "start": 222.461,
    "end": 226.276,
    "duration": 3.815
  }
]