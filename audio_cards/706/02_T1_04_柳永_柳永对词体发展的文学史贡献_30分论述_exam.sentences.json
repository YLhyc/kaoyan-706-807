[
  {
    "id": 1,
    "text": "试论柳永对词体发展的文学史贡献。",
    "start": 0.0,
    "end": 3.969,
    "duration": 3.969
  },
  {
    "id": 2,
    "text": "柳永是北宋词坛第一位全身心投入创作的专业词人。",
    "start": 3.969,
    "end": 8.499,
    "duration": 4.53
  },
  {
    "id": 3,
    "text": "面对五代至宋初词坛小令题材局限于士大夫尊前欢宴、",
    "start": 8.499,
    "end": 13.814,
    "duration": 5.315
  },
  {
    "id": 4,
    "text": "体式短狭的格局，",
    "start": 13.814,
    "end": 15.635,
    "duration": 1.821
  },
  {
    "id": 5,
    "text": "柳永以毕生精力顺应市民音乐与坊市文化繁荣的历史潮流，",
    "start": 15.635,
    "end": 20.646,
    "duration": 5.011
  },
  {
    "id": 6,
    "text": "对词体进行了全方位的开创性革新。",
    "start": 20.646,
    "end": 23.664,
    "duration": 3.018
  },
  {
    "id": 7,
    "text": "叶梦得在 《避暑录话》 中记录其盛况：“凡有井水饮处，",
    "start": 23.664,
    "end": 28.106,
    "duration": 4.442
  },
  {
    "id": 8,
    "text": "皆能歌柳词。",
    "start": 28.106,
    "end": 29.48,
    "duration": 1.374
  },
  {
    "id": 9,
    "text": "” 其对宋代词体发展的划时代贡献，",
    "start": 29.48,
    "end": 32.284,
    "duration": 2.804
  },
  {
    "id": 10,
    "text": "主要展现为以下四个核心维度：",
    "start": 32.284,
    "end": 35.478,
    "duration": 3.194
  },
  {
    "id": 11,
    "text": "第一，大力创制慢词长调，全面打破小令狭隘格局以拓展篇幅容量。",
    "start": 35.478,
    "end": 41.276,
    "duration": 5.798
  },
  {
    "id": 12,
    "text": "在柳永之前，词坛以五代花间以来数十至六七十字的小令为主。",
    "start": 41.276,
    "end": 46.625,
    "duration": 5.349
  },
  {
    "id": 13,
    "text": "柳永充分吸纳坊市新声，大量创制百字以上的慢词长调。",
    "start": 46.625,
    "end": 51.916,
    "duration": 5.291
  },
  {
    "id": 14,
    "text": "在两宋存世的数百个词调中，",
    "start": 51.916,
    "end": 54.276,
    "duration": 2.36
  },
  {
    "id": 15,
    "text": "柳永创制和首先使用的慢词就达一百余个。",
    "start": 54.276,
    "end": 56.902,
    "duration": 2.626
  },
  {
    "id": 16,
    "text": "慢词长调的普及，",
    "start": 56.902,
    "end": 58.415,
    "duration": 1.513
  },
  {
    "id": 17,
    "text": "从根本上改变了词体短小轻灵的截取片断特征，",
    "start": 58.415,
    "end": 64.473,
    "duration": 6.058
  },
  {
    "id": 18,
    "text": "使词具备了容纳复杂曲折叙事、",
    "start": 64.473,
    "end": 71.239,
    "duration": 6.766
  },
  {
    "id": 19,
    "text": "多层次抒情与细致景物铺排的宏大体制，",
    "start": 71.239,
    "end": 75.978,
    "duration": 4.739
  },
  {
    "id": 20,
    "text": "实现了由文人樽前余技向长篇独立抒情文学的体制跃升。",
    "start": 75.978,
    "end": 79.672,
    "duration": 3.694
  },
  {
    "id": 21,
    "text": "第二，革新词体表现手法，",
    "start": 79.672,
    "end": 81.946,
    "duration": 2.274
  },
  {
    "id": 22,
    "text": "确立“铺叙展衍”与白描写景的章法传统。",
    "start": 81.946,
    "end": 85.966,
    "duration": 4.02
  },
  {
    "id": 23,
    "text": "与小令注重意象瞬间跳跃、含蓄凝练不同，",
    "start": 85.966,
    "end": 89.081,
    "duration": 3.115
  },
  {
    "id": 24,
    "text": "柳永开创了 “铺叙展衍” 的赋体手法。",
    "start": 89.081,
    "end": 95.196,
    "duration": 6.115
  },
  {
    "id": 25,
    "text": "他善于在时间和空间轴线上层层推进情节与情感。",
    "start": 95.196,
    "end": 101.662,
    "duration": 6.466
  },
  {
    "id": 26,
    "text": "在 《八声甘州》 中，先以 “对潇潇暮雨洒江天，",
    "start": 101.662,
    "end": 104.979,
    "duration": 3.317
  },
  {
    "id": 27,
    "text": "一番洗清秋” 极力铺写秋江寥落景象；",
    "start": 104.979,
    "end": 110.153,
    "duration": 5.174
  },
  {
    "id": 28,
    "text": "接着以 “不忍登高临远，望故乡渺邈，",
    "start": 110.153,
    "end": 112.214,
    "duration": 2.061
  },
  {
    "id": 29,
    "text": "归思难收” 直抒身世之慨；后半阕笔锋陡转，虚设对方之景，",
    "start": 112.214,
    "end": 119.212,
    "duration": 6.998
  },
  {
    "id": 30,
    "text": "“想佳人，妆楼颙望，误几回、天际识归舟”，",
    "start": 119.212,
    "end": 123.644,
    "duration": 4.432
  },
  {
    "id": 31,
    "text": "通过主客双向铺叙将相思羁旅推向极境；在 《雨霖铃》 中，",
    "start": 123.644,
    "end": 129.719,
    "duration": 6.075
  },
  {
    "id": 32,
    "text": "由留恋执手到千种风情，全篇章法井然、顿挫有致。",
    "start": 129.719,
    "end": 133.531,
    "duration": 3.812
  },
  {
    "id": 33,
    "text": "第三，开拓羁旅行役与市民世俗题材，实现审美趣味的平民化转向。",
    "start": 133.531,
    "end": 141.827,
    "duration": 8.296
  },
  {
    "id": 34,
    "text": "柳永彻底打破了传统文人词局限于深闺怨妇与欢场作乐的陈旧主题，",
    "start": 141.827,
    "end": 150.897,
    "duration": 9.07
  },
  {
    "id": 35,
    "text": "第一次将落魄士人的 “羁旅行役之苦” 写入词中。",
    "start": 150.897,
    "end": 156.582,
    "duration": 5.685
  },
  {
    "id": 36,
    "text": "他将自身仕途受挫、浪迹江湖的真实漂泊体验倾注于词，",
    "start": 156.582,
    "end": 162.833,
    "duration": 6.251
  },
  {
    "id": 37,
    "text": "开创了词史上的羁旅新传统。",
    "start": 162.833,
    "end": 165.357,
    "duration": 2.524
  },
  {
    "id": 38,
    "text": "同时，柳永长期沉溺市井瓦舍，大量描写市井烟火、",
    "start": 165.357,
    "end": 171.093,
    "duration": 5.736
  },
  {
    "id": 39,
    "text": "市民男女婚恋与都市繁华，如 《望海潮》 中 “市列珠玑，",
    "start": 171.093,
    "end": 174.761,
    "duration": 3.668
  },
  {
    "id": 40,
    "text": "户盈罗绮，竞豪奢”，生动勾勒出北宋杭州的富庶气象，",
    "start": 174.761,
    "end": 180.129,
    "duration": 5.368
  },
  {
    "id": 41,
    "text": "实现了宋词由士大夫书斋向大众世俗生活的深层沉降。",
    "start": 180.129,
    "end": 184.455,
    "duration": 4.326
  },
  {
    "id": 42,
    "text": "第四，吸纳市井俚语与俗曲口语，",
    "start": 184.455,
    "end": 187.135,
    "duration": 2.68
  },
  {
    "id": 43,
    "text": "形成通俗明畅的全新词体语言风格。",
    "start": 187.135,
    "end": 190.029,
    "duration": 2.894
  },
  {
    "id": 44,
    "text": "在词的语言风格上，",
    "start": 190.029,
    "end": 191.547,
    "duration": 1.518
  },
  {
    "id": 45,
    "text": "柳永敢于突破传统文人雕琢藻饰的清雅格调，",
    "start": 191.547,
    "end": 193.239,
    "duration": 1.692
  },
  {
    "id": 46,
    "text": "大胆吸纳民间口语、俚俗方言与勾栏市井俗语。",
    "start": 193.239,
    "end": 195.383,
    "duration": 2.144
  },
  {
    "id": 47,
    "text": "他的语言自然浅近、明白如话，如 “系我一生心，",
    "start": 195.383,
    "end": 197.993,
    "duration": 2.61
  },
  {
    "id": 48,
    "text": "负你千行泪”、“衣带渐宽终不悔，为伊消得人憔悴”，",
    "start": 197.993,
    "end": 199.568,
    "duration": 1.575
  },
  {
    "id": 49,
    "text": "直白晓畅而回肠荡气。",
    "start": 199.568,
    "end": 200.508,
    "duration": 0.94
  },
  {
    "id": 50,
    "text": "苏轼对其诗化名句极度推崇，赞其 “霜风凄紧，关河冷落，",
    "start": 200.508,
    "end": 203.638,
    "duration": 3.13
  },
  {
    "id": 51,
    "text": "残照当楼” 具有不减唐人高境之风骨。",
    "start": 203.638,
    "end": 208.672,
    "duration": 5.034
  },
  {
    "id": 52,
    "text": "柳永的词体创造不仅直接启迪了苏轼、周邦彦等后代词学大家，",
    "start": 208.672,
    "end": 210.812,
    "duration": 2.14
  },
  {
    "id": 53,
    "text": "更为两宋慢词的极盛繁荣奠定了基石。",
    "start": 210.812,
    "end": 211.594,
    "duration": 0.782
  }
]