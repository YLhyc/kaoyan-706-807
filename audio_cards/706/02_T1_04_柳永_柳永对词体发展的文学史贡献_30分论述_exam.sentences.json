[
  {
    "id": "sent_1",
    "text": "柳永是北宋词坛第一位全身心投入创作的专业词人。",
    "start": 0.0,
    "end": 3.92,
    "duration": 3.92
  },
  {
    "id": "sent_2",
    "text": "面对五代至宋初词坛小令题材局限于士大夫尊前欢宴、",
    "start": 4.369,
    "end": 8.809,
    "duration": 4.44
  },
  {
    "id": "sent_3",
    "text": "体式短狭的格局，",
    "start": 9.259,
    "end": 10.739,
    "duration": 1.48
  },
  {
    "id": "sent_4",
    "text": "柳永以毕生精力顺应市民音乐与坊市文化繁荣的历史潮流，",
    "start": 11.269,
    "end": 15.669,
    "duration": 4.4
  },
  {
    "id": "sent_5",
    "text": "对词体进行了全方位的开创性革新。",
    "start": 16.279,
    "end": 18.999,
    "duration": 2.72
  },
  {
    "id": "sent_6",
    "text": "叶梦得在 《避暑录话》 中记录其盛况：“凡有井水饮处，",
    "start": 19.529,
    "end": 23.569,
    "duration": 4.04
  },
  {
    "id": "sent_7",
    "text": "皆能歌柳词。",
    "start": 24.019,
    "end": 25.219,
    "duration": 1.2
  },
  {
    "id": "sent_8",
    "text": "” 其对宋代词体发展的划时代贡献，",
    "start": 25.669,
    "end": 28.349,
    "duration": 2.68
  },
  {
    "id": "sent_9",
    "text": "主要展现为以下四个核心维度：",
    "start": 28.799,
    "end": 31.319,
    "duration": 2.52
  },
  {
    "id": "sent_10",
    "text": "第一，大力创制慢词长调，全面打破小令狭隘格局以拓展篇幅容量。",
    "start": 31.769,
    "end": 36.929,
    "duration": 5.16
  },
  {
    "id": "sent_11",
    "text": "在柳永之前，词坛以五代花间以来数十至六七十字的小令为主。",
    "start": 37.459,
    "end": 42.699,
    "duration": 5.24
  },
  {
    "id": "sent_12",
    "text": "柳永充分吸纳坊市新声，大量创制百字以上的慢词长调。",
    "start": 43.229,
    "end": 47.749,
    "duration": 4.52
  },
  {
    "id": "sent_13",
    "text": "在两宋存世的数百个词调中，",
    "start": 48.199,
    "end": 50.599,
    "duration": 2.4
  },
  {
    "id": "sent_14",
    "text": "柳永创制和首先使用的慢词就达一百余个。",
    "start": 51.129,
    "end": 54.489,
    "duration": 3.36
  },
  {
    "id": "sent_15",
    "text": "慢词长调的普及，从根本上改变了词体短小轻灵的截取片断特征，",
    "start": 54.939,
    "end": 60.419,
    "duration": 5.48
  },
  {
    "id": "sent_16",
    "text": "使词具备了容纳复杂曲折叙事、",
    "start": 60.869,
    "end": 63.469,
    "duration": 2.6
  },
  {
    "id": "sent_17",
    "text": "多层次抒情与细致景物铺排的宏大体制，",
    "start": 63.919,
    "end": 67.159,
    "duration": 3.24
  },
  {
    "id": "sent_18",
    "text": "实现了由文人樽前余技向长篇独立抒情文学的体制跃升。",
    "start": 67.609,
    "end": 72.129,
    "duration": 4.52
  },
  {
    "id": "sent_19",
    "text": "第二，革新词体表现手法，",
    "start": 72.579,
    "end": 74.539,
    "duration": 1.96
  },
  {
    "id": "sent_20",
    "text": "确立“铺叙展衍”与白描写景的章法传统。",
    "start": 74.989,
    "end": 78.109,
    "duration": 3.12
  },
  {
    "id": "sent_21",
    "text": "与小令注重意象瞬间跳跃、含蓄凝练不同，",
    "start": 78.559,
    "end": 82.079,
    "duration": 3.52
  },
  {
    "id": "sent_22",
    "text": "柳永开创了 “铺叙展衍” 的赋体手法。",
    "start": 82.609,
    "end": 85.209,
    "duration": 2.6
  },
  {
    "id": "sent_23",
    "text": "他善于在时间和空间轴线上层层推进情节与情感。",
    "start": 85.659,
    "end": 89.939,
    "duration": 4.28
  },
  {
    "id": "sent_24",
    "text": "在 《八声甘州》 中，先以 “对潇潇暮雨洒江天，",
    "start": 90.389,
    "end": 93.749,
    "duration": 3.36
  },
  {
    "id": "sent_25",
    "text": "一番洗清秋” 极力铺写秋江寥落景象；",
    "start": 94.199,
    "end": 97.279,
    "duration": 3.08
  },
  {
    "id": "sent_26",
    "text": "接着以 “不忍登高临远，望故乡渺邈，",
    "start": 97.729,
    "end": 100.609,
    "duration": 2.88
  },
  {
    "id": "sent_27",
    "text": "归思难收” 直抒身世之慨；",
    "start": 101.139,
    "end": 103.299,
    "duration": 2.16
  },
  {
    "id": "sent_28",
    "text": "后半阕笔锋陡转，虚设对方之景，“想佳人，妆楼颙望，误几回、",
    "start": 103.829,
    "end": 109.269,
    "duration": 5.44
  },
  {
    "id": "sent_29",
    "text": "天际识归舟”，通过主客双向铺叙将相思羁旅推向极境；",
    "start": 109.799,
    "end": 114.519,
    "duration": 4.72
  },
  {
    "id": "sent_30",
    "text": "在 《雨霖铃》 中，由留恋执手到千种风情，全篇章法井然、",
    "start": 114.969,
    "end": 119.769,
    "duration": 4.8
  },
  {
    "id": "sent_31",
    "text": "顿挫有致。",
    "start": 120.219,
    "end": 121.219,
    "duration": 1.0
  },
  {
    "id": "sent_32",
    "text": "第三，开拓羁旅行役与市民世俗题材，实现审美趣味的平民化转向。",
    "start": 121.669,
    "end": 127.189,
    "duration": 5.52
  },
  {
    "id": "sent_33",
    "text": "柳永彻底打破了传统文人词局限于深闺怨妇与欢场作乐的陈旧主题，",
    "start": 127.639,
    "end": 133.399,
    "duration": 5.76
  },
  {
    "id": "sent_34",
    "text": "第一次将落魄士人的 “羁旅行役之苦” 写入词中。",
    "start": 133.849,
    "end": 137.289,
    "duration": 3.44
  },
  {
    "id": "sent_35",
    "text": "他将自身仕途受挫、浪迹江湖的真实漂泊体验倾注于词，",
    "start": 137.739,
    "end": 142.339,
    "duration": 4.6
  },
  {
    "id": "sent_36",
    "text": "开创了词史上的羁旅新传统。",
    "start": 142.789,
    "end": 145.149,
    "duration": 2.36
  },
  {
    "id": "sent_37",
    "text": "同时，柳永长期沉溺市井瓦舍，大量描写市井烟火、",
    "start": 145.599,
    "end": 149.759,
    "duration": 4.16
  },
  {
    "id": "sent_38",
    "text": "市民男女婚恋与都市繁华，如 《望海潮》 中 “市列珠玑，",
    "start": 150.209,
    "end": 154.369,
    "duration": 4.16
  },
  {
    "id": "sent_39",
    "text": "户盈罗绮，竞豪奢”，生动勾勒出北宋杭州的富庶气象，",
    "start": 154.819,
    "end": 159.419,
    "duration": 4.6
  },
  {
    "id": "sent_40",
    "text": "实现了宋词由士大夫书斋向大众世俗生活的深层沉降。",
    "start": 159.869,
    "end": 164.549,
    "duration": 4.68
  },
  {
    "id": "sent_41",
    "text": "第四，吸纳市井俚语与俗曲口语，",
    "start": 164.999,
    "end": 168.079,
    "duration": 3.08
  },
  {
    "id": "sent_42",
    "text": "形成通俗明畅的全新词体语言风格。",
    "start": 168.529,
    "end": 171.809,
    "duration": 3.28
  },
  {
    "id": "sent_43",
    "text": "在词的语言风格上，柳永敢于突破传统文人雕琢藻饰的清雅格调，",
    "start": 172.259,
    "end": 177.539,
    "duration": 5.28
  },
  {
    "id": "sent_44",
    "text": "大胆吸纳民间口语、俚俗方言与勾栏市井俗语。",
    "start": 177.989,
    "end": 181.909,
    "duration": 3.92
  },
  {
    "id": "sent_45",
    "text": "他的语言自然浅近、明白如话，如 “系我一生心，负你千行泪”、",
    "start": 182.439,
    "end": 187.719,
    "duration": 5.28
  },
  {
    "id": "sent_46",
    "text": "“衣带渐宽终不悔，为伊消得人憔悴”，直白晓畅而回肠荡气。",
    "start": 188.168,
    "end": 193.488,
    "duration": 5.32
  },
  {
    "id": "sent_47",
    "text": "苏轼对其诗化名句极度推崇，赞其 “霜风凄紧，关河冷落，",
    "start": 193.938,
    "end": 199.138,
    "duration": 5.2
  },
  {
    "id": "sent_48",
    "text": "残照当楼” 具有不减唐人高境之风骨。",
    "start": 199.588,
    "end": 202.468,
    "duration": 2.88
  },
  {
    "id": "sent_49",
    "text": "柳永的词体创造不仅直接启迪了苏轼、周邦彦等后代词学大家，",
    "start": 202.998,
    "end": 207.998,
    "duration": 5.0
  },
  {
    "id": "sent_50",
    "text": "更为两宋慢词的极盛繁荣奠定了基石。",
    "start": 208.448,
    "end": 211.728,
    "duration": 3.28
  }
]