[
  {
    "id": 1,
    "text": "试论中国古代文学“悲秋”母题的流变与文人心态机制。",
    "start": 0.101,
    "end": 4.676,
    "duration": 4.575
  },
  {
    "id": 2,
    "text": "“悲秋”是中国古代文学史上源远流长、",
    "start": 5.049,
    "end": 7.95,
    "duration": 2.901
  },
  {
    "id": 3,
    "text": "最具代表性的抒情母题之一。",
    "start": 8.198,
    "end": 10.198,
    "duration": 2.0
  },
  {
    "id": 4,
    "text": "自战国宋玉发出“悲哉秋之为气也”的浩叹以来，",
    "start": 10.762,
    "end": 14.727,
    "duration": 3.965
  },
  {
    "id": 5,
    "text": "悲秋由最初的自然物候感伤，",
    "start": 15.013,
    "end": 17.222,
    "duration": 2.209
  },
  {
    "id": 6,
    "text": "逐步积淀为古代士人观照生命流逝、",
    "start": 17.534,
    "end": 20.411,
    "duration": 2.877
  },
  {
    "id": 7,
    "text": "身世漂泊与家国兴亡的审美传统。",
    "start": 20.673,
    "end": 23.457,
    "duration": 2.784
  },
  {
    "id": 8,
    "text": "陆机《文赋》概括文人感物心态云：“遵四时以叹逝，",
    "start": 24.115,
    "end": 28.034,
    "duration": 3.919
  },
  {
    "id": 9,
    "text": "瞻万物而思纷。",
    "start": 28.169,
    "end": 29.315,
    "duration": 1.146
  },
  {
    "id": 10,
    "text": "悲落叶于劲秋，喜柔条于芳春。",
    "start": 29.474,
    "end": 32.059,
    "duration": 2.585
  },
  {
    "id": 11,
    "text": "”悲秋母题的千年演进与文人心态机制，主要体现在以下四个方面：",
    "start": 32.179,
    "end": 36.69,
    "duration": 4.511
  },
  {
    "id": 12,
    "text": "第一，宋玉《九辩》奠定悲秋先声，",
    "start": 37.292,
    "end": 40.009,
    "duration": 2.717
  },
  {
    "id": 13,
    "text": "确立秋景凋零与士人失意的交织。",
    "start": 40.24,
    "end": 43.12,
    "duration": 2.88
  },
  {
    "id": 14,
    "text": "先秦《诗经》虽已有零星秋景描写，",
    "start": 43.43,
    "end": 46.154,
    "duration": 2.724
  },
  {
    "id": 15,
    "text": "但尚未将秋气与身世悲慨定型为固定母题。",
    "start": 46.282,
    "end": 49.826,
    "duration": 3.544
  },
  {
    "id": 16,
    "text": "宋玉在《九辩》开篇高吟“悲哉秋之为气也！",
    "start": 50.069,
    "end": 53.602,
    "duration": 3.533
  },
  {
    "id": 17,
    "text": "萧瑟兮草木摇落而变衰”，第一次将深秋草木枯槁、",
    "start": 53.755,
    "end": 58.371,
    "duration": 4.616
  },
  {
    "id": 18,
    "text": "寒风萧瑟的肃杀物候，",
    "start": 58.649,
    "end": 60.4,
    "duration": 1.751
  },
  {
    "id": 19,
    "text": "与寒门士人“坎廪兮贫士失职而志不平”的政治失意紧密相连。",
    "start": 60.667,
    "end": 66.097,
    "duration": 5.43
  },
  {
    "id": 20,
    "text": "作者敏锐捕捉燕雀南归、霜露降落等秋令意象，",
    "start": 66.428,
    "end": 70.287,
    "duration": 3.859
  },
  {
    "id": 21,
    "text": "把自身忠而见疑、抱负难伸的屈辱投射于萧瑟秋气之中，",
    "start": 70.677,
    "end": 75.395,
    "duration": 4.718
  },
  {
    "id": 22,
    "text": "由此确立了古典文学因秋起兴、",
    "start": 75.762,
    "end": 78.51,
    "duration": 2.748
  },
  {
    "id": 23,
    "text": "以自然零落感伤生命沉沦的原型范式。",
    "start": 78.811,
    "end": 81.923,
    "duration": 3.112
  },
  {
    "id": 24,
    "text": "第二，汉魏六朝拓展悲秋内涵，注入生命短促与乱世流离之忧。",
    "start": 82.546,
    "end": 88.535,
    "duration": 5.989
  },
  {
    "id": 25,
    "text": "两汉魏晋时期，",
    "start": 88.849,
    "end": 90.045,
    "duration": 1.196
  },
  {
    "id": 26,
    "text": "政局动荡与生命无常之感促使文人自我意识觉醒，",
    "start": 90.326,
    "end": 94.48,
    "duration": 4.154
  },
  {
    "id": 27,
    "text": "悲秋进一步深化为对青春易逝与人生飘零的感喟。",
    "start": 94.804,
    "end": 99.078,
    "duration": 4.274
  },
  {
    "id": 28,
    "text": "汉武帝《秋风辞》以“秋风起兮白云飞，",
    "start": 99.35,
    "end": 102.654,
    "duration": 3.304
  },
  {
    "id": 29,
    "text": "草木黄落兮雁南归”生发盛极而衰的感慨，",
    "start": 102.865,
    "end": 106.937,
    "duration": 4.072
  },
  {
    "id": 30,
    "text": "发出“少壮几时兮奈老何”的叹息；",
    "start": 107.323,
    "end": 110.842,
    "duration": 3.519
  },
  {
    "id": 31,
    "text": "曹丕《燕歌行》以“秋风萧瑟天气凉，",
    "start": 111.067,
    "end": 114.145,
    "duration": 3.078
  },
  {
    "id": 32,
    "text": "草木摇落露为霜”渲染思妇秋夜孤寂；",
    "start": 114.392,
    "end": 117.802,
    "duration": 3.41
  },
  {
    "id": 33,
    "text": "潘岳《秋兴赋》则借秋气感伤宦途蹉跎、华发早生。",
    "start": 118.067,
    "end": 122.429,
    "duration": 4.362
  },
  {
    "id": 34,
    "text": "至此，秋天成为文人感叹年华老大、",
    "start": 122.656,
    "end": 125.591,
    "duration": 2.935
  },
  {
    "id": 35,
    "text": "离别漂泊与乱世浮沉的普遍情感寄托。",
    "start": 125.809,
    "end": 128.952,
    "duration": 3.143
  },
  {
    "id": 36,
    "text": "第三，盛唐杜甫推向诗史高峰，",
    "start": 129.57,
    "end": 132.441,
    "duration": 2.871
  },
  {
    "id": 37,
    "text": "将一己悲秋升华为忧国忧民之沉郁悲慨。",
    "start": 132.795,
    "end": 136.312,
    "duration": 3.517
  },
  {
    "id": 38,
    "text": "悲秋母题在杜甫笔下突破了以往多偏于个人身世自怜的格局，",
    "start": 137.016,
    "end": 141.868,
    "duration": 4.852
  },
  {
    "id": 39,
    "text": "把一己飘零与安史之乱后的家国危机融为一体。",
    "start": 142.127,
    "end": 146.05,
    "duration": 3.923
  },
  {
    "id": 40,
    "text": "在七律名篇《登高》中，“无边落木萧萧下，",
    "start": 146.35,
    "end": 149.971,
    "duration": 3.621
  },
  {
    "id": 41,
    "text": "不尽长江滚滚来”以阔大苍茫的江天秋色拓开沉雄境界；",
    "start": 150.201,
    "end": 155.323,
    "duration": 5.122
  },
  {
    "id": 42,
    "text": "颈联“万里悲秋常作客，百年多病独登台”更将万里客居、",
    "start": 155.686,
    "end": 161.224,
    "duration": 5.538
  },
  {
    "id": 43,
    "text": "百年多病与时代多艰凝练于十四字中；",
    "start": 161.659,
    "end": 164.867,
    "duration": 3.208
  },
  {
    "id": 44,
    "text": "《秋兴八首》则借夔州秋气遥望长安，把个人身世之悲、",
    "start": 165.24,
    "end": 169.906,
    "duration": 4.666
  },
  {
    "id": 45,
    "text": "衰年之叹与国家兴衰之痛融汇一体，",
    "start": 170.263,
    "end": 173.313,
    "duration": 3.05
  },
  {
    "id": 46,
    "text": "使悲秋达到沉郁顿挫的现实主义高峰。",
    "start": 173.703,
    "end": 176.606,
    "duration": 2.903
  },
  {
    "id": 47,
    "text": "第四，宋代诗词转向细腻内省与哲理超脱，",
    "start": 177.217,
    "end": 181.224,
    "duration": 4.007
  },
  {
    "id": 48,
    "text": "展现悲秋传统的审美新变。",
    "start": 181.395,
    "end": 183.791,
    "duration": 2.396
  },
  {
    "id": 49,
    "text": "入宋以后，",
    "start": 184.077,
    "end": 184.759,
    "duration": 0.682
  },
  {
    "id": 50,
    "text": "文人对秋的体认由宏阔史诗感慨转向精细的心灵内省与理趣超越。",
    "start": 185.051,
    "end": 191.748,
    "duration": 6.697
  },
  {
    "id": 51,
    "text": "柳永《八声甘州》以“对潇潇暮雨洒江天，",
    "start": 191.988,
    "end": 195.565,
    "duration": 3.577
  },
  {
    "id": 52,
    "text": "一番洗清秋”抒发羁旅漂泊之愁；",
    "start": 195.675,
    "end": 198.885,
    "duration": 3.21
  },
  {
    "id": 53,
    "text": "辛弃疾《丑奴儿》借“却道天凉好个秋”道出饱经沧桑后欲说还休的深沉苦闷；",
    "start": 199.127,
    "end": 205.83,
    "duration": 6.703
  },
  {
    "id": 54,
    "text": "而苏轼在《赤壁赋》中于“清风徐来，",
    "start": 206.119,
    "end": 209.062,
    "duration": 2.943
  },
  {
    "id": 55,
    "text": "水波不兴”的秋夜泛舟之际，",
    "start": 209.229,
    "end": 211.42,
    "duration": 2.191
  },
  {
    "id": 56,
    "text": "以物我“变与不变”的哲思化解万物凋零之悲，",
    "start": 211.867,
    "end": 215.524,
    "duration": 3.657
  },
  {
    "id": 57,
    "text": "赋予延续两千年的悲秋传统以旷达超逸的哲理智慧。",
    "start": 215.795,
    "end": 220.173,
    "duration": 4.378
  }
]