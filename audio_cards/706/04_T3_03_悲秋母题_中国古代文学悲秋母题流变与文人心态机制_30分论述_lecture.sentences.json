[
  {
    "id": 1,
    "text": "试论中国古代文学“悲秋”母题的流变与文人心态机制。",
    "start": 0.101,
    "end": 4.686,
    "duration": 4.585
  },
  {
    "id": 2,
    "text": "“悲秋”是中国古代文学史上源远流长、最具代表性的抒情母题之一。",
    "start": 5.049,
    "end": 10.208,
    "duration": 5.159
  },
  {
    "id": 3,
    "text": "自战国宋玉发出“悲哉秋之为气也”的浩叹以来，悲秋由最初的自然物候感伤，",
    "start": 10.762,
    "end": 17.232,
    "duration": 6.47
  },
  {
    "id": 4,
    "text": "逐步积淀为古代士人观照生命流逝、身世漂泊与家国兴亡的审美传统。",
    "start": 17.534,
    "end": 23.467,
    "duration": 5.933
  },
  {
    "id": 5,
    "text": "陆机《文赋》概括文人感物心态云：",
    "start": 24.115,
    "end": 26.551,
    "duration": 2.436
  },
  {
    "id": 6,
    "text": "“遵四时以叹逝，瞻万物而思纷。",
    "start": 26.87,
    "end": 29.325,
    "duration": 2.455
  },
  {
    "id": 7,
    "text": "悲落叶于劲秋，喜柔条于芳春。”",
    "start": 29.474,
    "end": 32.346,
    "duration": 2.872
  },
  {
    "id": 8,
    "text": "悲秋母题的千年演进与文人心态机制，",
    "start": 32.346,
    "end": 34.96,
    "duration": 2.614
  },
  {
    "id": 9,
    "text": "主要体现在以下四个方面：",
    "start": 35.081,
    "end": 36.7,
    "duration": 1.619
  },
  {
    "id": 10,
    "text": "第一，宋玉《九辩》奠定悲秋先声，确立秋景凋零与士人失意的交织。",
    "start": 37.292,
    "end": 43.43,
    "duration": 6.138
  },
  {
    "id": 11,
    "text": "先秦《诗经》虽已有零星秋景描写，但尚未将秋气与身世悲慨定型为固定母题。",
    "start": 43.43,
    "end": 49.835,
    "duration": 6.405
  },
  {
    "id": 12,
    "text": "宋玉在《九辩》开篇高吟“悲哉秋之为气也！萧瑟兮草木摇落而变衰”，",
    "start": 50.069,
    "end": 56.038,
    "duration": 5.969
  },
  {
    "id": 13,
    "text": "第一次将深秋草木枯槁、寒风萧瑟的肃杀物候，",
    "start": 56.199,
    "end": 60.41,
    "duration": 4.211
  },
  {
    "id": 14,
    "text": "与寒门士人“坎廪兮贫士失职而志不平”的政治失意紧密相连。",
    "start": 60.667,
    "end": 66.101,
    "duration": 5.434
  },
  {
    "id": 15,
    "text": "作者敏锐捕捉燕雀南归、霜露降落等秋令意象，",
    "start": 66.428,
    "end": 70.297,
    "duration": 3.869
  },
  {
    "id": 16,
    "text": "把自身忠而见疑、抱负难伸的屈辱投射于萧瑟秋气之中，",
    "start": 70.677,
    "end": 75.396,
    "duration": 4.719
  },
  {
    "id": 17,
    "text": "由此确立了古典文学因秋起兴、以自然零落感伤生命沉沦的原型范式。",
    "start": 75.762,
    "end": 81.933,
    "duration": 6.171
  },
  {
    "id": 18,
    "text": "第二，汉魏六朝拓展悲秋内涵，注入生命短促与乱世流离之忧。",
    "start": 82.546,
    "end": 88.545,
    "duration": 5.999
  },
  {
    "id": 19,
    "text": "两汉魏晋时期，政局动荡与生命无常之感促使文人自我意识觉醒，",
    "start": 88.849,
    "end": 94.49,
    "duration": 5.641
  },
  {
    "id": 20,
    "text": "悲秋进一步深化为对青春易逝与人生飘零的感喟。",
    "start": 94.804,
    "end": 99.088,
    "duration": 4.284
  },
  {
    "id": 21,
    "text": "汉武帝《秋风辞》以“秋风起兮白云飞，草木黄落兮雁南归”生发盛极而衰的感慨，",
    "start": 99.35,
    "end": 106.947,
    "duration": 7.597
  },
  {
    "id": 22,
    "text": "发出“少壮几时兮奈老何”的叹息；",
    "start": 107.323,
    "end": 110.852,
    "duration": 3.529
  },
  {
    "id": 23,
    "text": "曹丕《燕歌行》以“秋风萧瑟天气凉，草木摇落露为霜”渲染思妇秋夜孤寂；",
    "start": 111.067,
    "end": 117.812,
    "duration": 6.745
  },
  {
    "id": 24,
    "text": "潘岳《秋兴赋》则借秋气感伤宦途蹉跎、华发早生。",
    "start": 118.067,
    "end": 122.439,
    "duration": 4.372
  },
  {
    "id": 25,
    "text": "至此，秋天成为文人感叹年华老大、离别漂泊与乱世浮沉的普遍情感寄托。",
    "start": 122.656,
    "end": 128.962,
    "duration": 6.306
  },
  {
    "id": 26,
    "text": "第三，盛唐杜甫推向诗史高峰，将一己悲秋升华为忧国忧民之沉郁悲慨。",
    "start": 129.57,
    "end": 136.322,
    "duration": 6.752
  },
  {
    "id": 27,
    "text": "悲秋母题在杜甫笔下突破了以往多偏于个人身世自怜的格局，",
    "start": 137.016,
    "end": 141.877,
    "duration": 4.861
  },
  {
    "id": 28,
    "text": "把一己飘零与安史之乱后的家国危机融为一体。",
    "start": 142.127,
    "end": 146.058,
    "duration": 3.931
  },
  {
    "id": 29,
    "text": "在七律名篇《登高》中，",
    "start": 146.35,
    "end": 148.149,
    "duration": 1.799
  },
  {
    "id": 30,
    "text": "“无边落木萧萧下，不尽长江滚滚来”以阔大苍茫的江天秋色拓开沉雄境界；",
    "start": 148.515,
    "end": 155.332,
    "duration": 6.817
  },
  {
    "id": 31,
    "text": "颈联“万里悲秋常作客，百年多病独登台”更将万里客居、百年多病与时代多艰凝练于十四字中；",
    "start": 155.686,
    "end": 164.877,
    "duration": 9.191
  },
  {
    "id": 32,
    "text": "《秋兴八首》则借夔州秋气遥望长安，",
    "start": 165.24,
    "end": 168.257,
    "duration": 3.017
  },
  {
    "id": 33,
    "text": "把个人身世之悲、衰年之叹与国家兴衰之痛融汇一体，使悲秋达到沉郁顿挫的现实主义高峰。",
    "start": 168.609,
    "end": 176.616,
    "duration": 8.007
  },
  {
    "id": 34,
    "text": "第四，宋代诗词转向细腻内省与哲理超脱，展现悲秋传统的审美新变。",
    "start": 177.217,
    "end": 183.801,
    "duration": 6.584
  },
  {
    "id": 35,
    "text": "入宋以后，文人对秋的体认由宏阔史诗感慨转向精细的心灵内省与理趣超越。",
    "start": 184.077,
    "end": 191.758,
    "duration": 7.681
  },
  {
    "id": 36,
    "text": "柳永《八声甘州》以“对潇潇暮雨洒江天，一番洗清秋”抒发羁旅漂泊之愁；",
    "start": 191.988,
    "end": 198.895,
    "duration": 6.907
  },
  {
    "id": 37,
    "text": "辛弃疾《丑奴儿》借“却道天凉好个秋”道出饱经沧桑后欲说还休的深沉苦闷；",
    "start": 199.127,
    "end": 205.84,
    "duration": 6.713
  },
  {
    "id": 38,
    "text": "而苏轼在《赤壁赋》中于“清风徐来，水波不兴”的秋夜泛舟之际，",
    "start": 206.119,
    "end": 211.43,
    "duration": 5.311
  },
  {
    "id": 39,
    "text": "以物我“变与不变”的哲思化解万物凋零之悲，",
    "start": 211.867,
    "end": 215.534,
    "duration": 3.667
  },
  {
    "id": 40,
    "text": "赋予延续两千年的悲秋传统以旷达超逸的哲理智慧。",
    "start": 215.795,
    "end": 220.173,
    "duration": 4.378
  }
]