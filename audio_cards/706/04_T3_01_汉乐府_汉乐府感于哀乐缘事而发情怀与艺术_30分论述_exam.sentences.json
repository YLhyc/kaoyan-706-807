[
  {
    "id": "sent_1",
    "text": "两汉乐府民歌是中国古典诗歌现实主义叙事传统的划时代高峰。",
    "start": 0.0,
    "end": 5.28,
    "duration": 5.28
  },
  {
    "id": "sent_2",
    "text": "面对汉武帝以后徭役繁重、战争连年、",
    "start": 5.729,
    "end": 8.689,
    "duration": 2.96
  },
  {
    "id": "sent_3",
    "text": "阶级分化与门阀宗法礼教压迫的严酷现实，",
    "start": 9.139,
    "end": 12.779,
    "duration": 3.64
  },
  {
    "id": "sent_4",
    "text": "汉代乐府官署深入民间采集歌谣，",
    "start": 13.229,
    "end": 16.109,
    "duration": 2.88
  },
  {
    "id": "sent_5",
    "text": "全面继承并发展了 《诗经》 的风雅精神。",
    "start": 16.559,
    "end": 19.399,
    "duration": 2.84
  },
  {
    "id": "sent_6",
    "text": "班固在 《汉书·艺文志》 中精辟概括其特质为 “感于哀乐，",
    "start": 19.849,
    "end": 23.929,
    "duration": 4.08
  },
  {
    "id": "sent_7",
    "text": "缘事而发”。",
    "start": 24.379,
    "end": 25.419,
    "duration": 1.04
  },
  {
    "id": "sent_8",
    "text": "汉乐府彻底摆脱了西汉辞赋粉饰大一统盛世的浮华积习，",
    "start": 25.869,
    "end": 30.829,
    "duration": 4.96
  },
  {
    "id": "sent_9",
    "text": "第一次以质朴深沉的民间心声构建起生动的生活画卷。",
    "start": 31.279,
    "end": 35.599,
    "duration": 4.32
  },
  {
    "id": "sent_10",
    "text": "其现实情怀与叙事艺术成就，主要展现为以下四个核心维度：",
    "start": 36.049,
    "end": 40.769,
    "duration": 4.72
  },
  {
    "id": "sent_11",
    "text": "第一，确立“感于哀乐，缘事而发”的现实主义批判精神，",
    "start": 41.219,
    "end": 45.379,
    "duration": 4.16
  },
  {
    "id": "sent_12",
    "text": "深沉直面民生苦难。",
    "start": 45.829,
    "end": 47.589,
    "duration": 1.76
  },
  {
    "id": "sent_13",
    "text": "“感于哀乐，缘事而发” 是汉乐府最根本的现实主义灵魂。",
    "start": 48.039,
    "end": 52.479,
    "duration": 4.44
  },
  {
    "id": "sent_14",
    "text": "所谓“缘事而发”，即诗歌紧扣社会生活中的真实事件展开，",
    "start": 52.929,
    "end": 57.569,
    "duration": 4.64
  },
  {
    "id": "sent_15",
    "text": "不作凭空的玄虚之论；",
    "start": 58.019,
    "end": 59.939,
    "duration": 1.92
  },
  {
    "id": "sent_16",
    "text": "所谓“感于哀乐”，即深刻倾注劳动人民真实的喜怒哀乐。",
    "start": 60.389,
    "end": 64.989,
    "duration": 4.6
  },
  {
    "id": "sent_17",
    "text": "其作品题材极为广泛：在 《十五从军征》 中，",
    "start": 65.439,
    "end": 68.759,
    "duration": 3.32
  },
  {
    "id": "sent_18",
    "text": "以 “十五从军征，",
    "start": 69.289,
    "end": 70.809,
    "duration": 1.52
  },
  {
    "id": "sent_19",
    "text": "八十始得归” 控诉兵役制度对个体生命的残酷剥夺，",
    "start": 71.339,
    "end": 75.259,
    "duration": 3.92
  },
  {
    "id": "sent_20",
    "text": "展现老年残兵归家唯见草木坟茔的极致悲酸；",
    "start": 75.709,
    "end": 79.549,
    "duration": 3.84
  },
  {
    "id": "sent_21",
    "text": "在 《东门行》 中，写下底层贫民拔剑而起的绝望愤怒；",
    "start": 79.999,
    "end": 84.119,
    "duration": 4.12
  },
  {
    "id": "sent_22",
    "text": "在 《妇病行》 中，写病妇临终托孤的凄惨景象。",
    "start": 84.569,
    "end": 88.289,
    "duration": 3.72
  },
  {
    "id": "sent_23",
    "text": "这些作品真切反映了底层百姓水深火热的生活图景，",
    "start": 88.739,
    "end": 92.739,
    "duration": 4.0
  },
  {
    "id": "sent_24",
    "text": "洋溢着强烈的反抗与批判力量。",
    "start": 93.269,
    "end": 95.629,
    "duration": 2.36
  },
  {
    "id": "sent_25",
    "text": "第二，推动诗歌体式由四言向五言叙事诗演进，",
    "start": 96.079,
    "end": 100.079,
    "duration": 4.0
  },
  {
    "id": "sent_26",
    "text": "奠定古典长篇叙事诗体制基石。",
    "start": 100.529,
    "end": 103.369,
    "duration": 2.84
  },
  {
    "id": "sent_27",
    "text": "汉乐府在文体形式上作出了开创性贡献，",
    "start": 103.819,
    "end": 106.979,
    "duration": 3.16
  },
  {
    "id": "sent_28",
    "text": "它冲破了四言诗句式的封闭局限，",
    "start": 107.509,
    "end": 109.949,
    "duration": 2.44
  },
  {
    "id": "sent_29",
    "text": "推动了中国古代文人五言诗的成熟。",
    "start": 110.479,
    "end": 113.239,
    "duration": 2.76
  },
  {
    "id": "sent_30",
    "text": "尤其是乐府民歌中叙事成分的大幅度提升，",
    "start": 113.689,
    "end": 117.049,
    "duration": 3.36
  },
  {
    "id": "sent_31",
    "text": "使诗歌具备了交代完整事件前因后果与人物命运起伏的能力。",
    "start": 117.499,
    "end": 122.579,
    "duration": 5.08
  },
  {
    "id": "sent_32",
    "text": "其长篇叙事绝唱 《孔雀东南飞》，长达一千七百余字，",
    "start": 123.029,
    "end": 127.509,
    "duration": 4.48
  },
  {
    "id": "sent_33",
    "text": "全篇情节严整，围绕兰芝自请遣归、阿兄逼嫁、",
    "start": 127.959,
    "end": 132.079,
    "duration": 4.12
  },
  {
    "id": "sent_34",
    "text": "焦刘双双殉情的线索层层推进，波澜起伏、扣人心弦，",
    "start": 132.529,
    "end": 137.169,
    "duration": 4.64
  },
  {
    "id": "sent_35",
    "text": "标志着中国古代叙事诗艺术达到了完全成熟的阶段。",
    "start": 137.619,
    "end": 141.739,
    "duration": 4.12
  },
  {
    "id": "sent_36",
    "text": "第三，",
    "start": 142.189,
    "end": 148.469,
    "duration": 6.28
  },
  {
    "id": "sent_37",
    "text": "长于在激烈矛盾冲突中运用个性化语言与传神细节塑造性格典型。",
    "start": 148.919,
    "end": 153.559,
    "duration": 4.64
  },
  {
    "id": "sent_38",
    "text": "汉乐府极善于借助戏剧化的冲突与对话白描刻画人物灵魂。",
    "start": 154.009,
    "end": 157.929,
    "duration": 3.92
  },
  {
    "id": "sent_39",
    "text": "《孔雀东南飞》 塑造了一组性格极具反差的人物群像：",
    "start": 158.459,
    "end": 162.899,
    "duration": 4.44
  },
  {
    "id": "sent_40",
    "text": "刘兰芝坚贞自尊、外柔内刚，在被逐出门时 “精做衣服，",
    "start": 163.349,
    "end": 166.669,
    "duration": 3.32
  },
  {
    "id": "sent_41",
    "text": "事事四五通”，以此捍卫自身的人格尊严；",
    "start": 167.119,
    "end": 172.439,
    "duration": 5.32
  },
  {
    "id": "sent_42",
    "text": "焦仲卿深情重义却性格懦弱，在专横跋扈的焦母面前进退两难；",
    "start": 172.889,
    "end": 175.129,
    "duration": 2.24
  },
  {
    "id": "sent_43",
    "text": "焦母唯我独尊、蛮横专断；",
    "start": 175.579,
    "end": 178.299,
    "duration": 2.72
  },
  {
    "id": "sent_44",
    "text": "阿兄市侩冷酷、趋炎附势。",
    "start": 178.749,
    "end": 182.749,
    "duration": 4.0
  },
  {
    "id": "sent_45",
    "text": "在 《陌上桑》 中，女主人公秦罗敷面对使君调戏，",
    "start": 183.199,
    "end": 186.039,
    "duration": 2.84
  },
  {
    "id": "sent_46",
    "text": "以极具夸饰的机智言辞赞美夫婿，",
    "start": 186.488,
    "end": 191.888,
    "duration": 5.4
  },
  {
    "id": "sent_47",
    "text": "言笑晏晏间将权贵的丑恶嘴脸嘲弄殆尽，人物性格鲜活饱满。",
    "start": 192.338,
    "end": 195.338,
    "duration": 3.0
  },
  {
    "id": "sent_48",
    "text": "第四，丰富了古典抒情手法的表现力，",
    "start": 195.788,
    "end": 198.828,
    "duration": 3.04
  },
  {
    "id": "sent_49",
    "text": "直接哺育建安风骨与杜甫即事名篇。",
    "start": 199.278,
    "end": 201.878,
    "duration": 2.6
  },
  {
    "id": "sent_50",
    "text": "汉乐府不仅以现实主义叙事著称，",
    "start": 202.328,
    "end": 206.768,
    "duration": 4.44
  },
  {
    "id": "sent_51",
    "text": "同样开创了融浪漫想象与托物起兴于一体的高超抒情技艺。",
    "start": 207.218,
    "end": 210.098,
    "duration": 2.88
  },
  {
    "id": "sent_52",
    "text": "《孔雀东南飞》 开篇以 “孔雀东南飞，",
    "start": 210.628,
    "end": 215.668,
    "duration": 5.04
  },
  {
    "id": "sent_53",
    "text": "五里一徘徊” 起兴营造悲怆基调，结尾以两人合葬化为相思树、",
    "start": 216.198,
    "end": 219.678,
    "duration": 3.48
  },
  {
    "id": "sent_54",
    "text": "鸳鸯飞鸣的神话想象，表达了人民反抗礼教、",
    "start": 220.128,
    "end": 222.328,
    "duration": 2.2
  },
  {
    "id": "sent_55",
    "text": "追求爱情永恒的浪漫理想；",
    "start": 222.778,
    "end": 226.938,
    "duration": 4.16
  },
  {
    "id": "sent_56",
    "text": "《江南》 运用 “莲叶何田田，鱼戏莲叶东” 的复沓民歌手法，",
    "start": 227.388,
    "end": 229.508,
    "duration": 2.12
  },
  {
    "id": "sent_57",
    "text": "极具民间音乐的明朗灵动。",
    "start": 229.958,
    "end": 235.118,
    "duration": 5.16
  },
  {
    "id": "sent_58",
    "text": "汉乐府这种直面现实、长于叙事的优良传统，直接哺育了曹操、",
    "start": 235.568,
    "end": 237.208,
    "duration": 1.64
  },
  {
    "id": "sent_59",
    "text": "曹植的建安文学，",
    "start": 237.658,
    "end": 242.418,
    "duration": 4.76
  }
]