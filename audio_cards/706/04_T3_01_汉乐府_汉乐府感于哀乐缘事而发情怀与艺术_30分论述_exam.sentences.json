[
  {
    "id": "sent_1",
    "text": "两汉乐府民歌是中国古典诗歌现实主义叙事传统的划时代高峰。",
    "start": 0.1,
    "end": 5.909,
    "duration": 5.809
  },
  {
    "id": "sent_2",
    "text": "面对汉武帝以后徭役繁重、战争连年、阶级分化与门阀宗法礼教压迫的严酷现实，",
    "start": 5.859,
    "end": 14.153,
    "duration": 8.294
  },
  {
    "id": "sent_3",
    "text": "汉代乐府官署深入民间采集歌谣，",
    "start": 14.154,
    "end": 17.761,
    "duration": 3.607
  },
  {
    "id": "sent_4",
    "text": "全面继承并发展了 《诗经》 的风雅精神。",
    "start": 17.76,
    "end": 21.302,
    "duration": 3.542
  },
  {
    "id": "sent_5",
    "text": "班固在 《汉书·艺文志》 中精辟概括其特质为 “感于哀乐，",
    "start": 21.302,
    "end": 26.706,
    "duration": 5.404
  },
  {
    "id": "sent_6",
    "text": "缘事而发”。",
    "start": 26.706,
    "end": 28.151,
    "duration": 1.445
  },
  {
    "id": "sent_7",
    "text": "汉乐府彻底摆脱了西汉辞赋粉饰大一统盛世的浮华积习，",
    "start": 28.151,
    "end": 33.763,
    "duration": 5.612
  },
  {
    "id": "sent_8",
    "text": "第一次以质朴深沉的民间心声构建起生动的生活画卷。",
    "start": 33.763,
    "end": 38.88,
    "duration": 5.117
  },
  {
    "id": "sent_9",
    "text": "其现实情怀与叙事艺术成就，主要展现为以下四个核心维度：",
    "start": 38.88,
    "end": 44.909,
    "duration": 6.029
  },
  {
    "id": "sent_10",
    "text": "第一，确立“感于哀乐，缘事而发”的现实主义批判精神，",
    "start": 44.909,
    "end": 50.0,
    "duration": 5.091
  },
  {
    "id": "sent_11",
    "text": "深沉直面民生苦难。",
    "start": 50.0,
    "end": 52.487,
    "duration": 2.487
  },
  {
    "id": "sent_12",
    "text": "“感于哀乐，缘事而发” 是汉乐府最根本的现实主义灵魂。",
    "start": 52.487,
    "end": 57.37,
    "duration": 4.883
  },
  {
    "id": "sent_13",
    "text": "所谓“缘事而发”，即诗歌紧扣社会生活中的真实事件展开，",
    "start": 57.37,
    "end": 62.513,
    "duration": 5.143
  },
  {
    "id": "sent_14",
    "text": "不作凭空的玄虚之论；",
    "start": 62.513,
    "end": 64.857,
    "duration": 2.344
  },
  {
    "id": "sent_15",
    "text": "所谓“感于哀乐”，即深刻倾注劳动人民真实的喜怒哀乐。",
    "start": 64.857,
    "end": 69.961,
    "duration": 5.104
  },
  {
    "id": "sent_16",
    "text": "其作品题材极为广泛：在 《十五从军征》 中，以 “十五从军征，",
    "start": 69.961,
    "end": 75.352,
    "duration": 5.391
  },
  {
    "id": "sent_17",
    "text": "八十始得归” 控诉兵役制度对个体生命的残酷剥夺，",
    "start": 75.352,
    "end": 80.013,
    "duration": 4.661
  },
  {
    "id": "sent_18",
    "text": "展现老年残兵归家唯见草木坟茔的极致悲酸；",
    "start": 80.013,
    "end": 84.661,
    "duration": 4.648
  },
  {
    "id": "sent_19",
    "text": "在 《东门行》 中，写下底层贫民拔剑而起的绝望愤怒；",
    "start": 84.661,
    "end": 89.362,
    "duration": 4.701
  },
  {
    "id": "sent_20",
    "text": "在 《妇病行》 中，写病妇临终托孤的凄惨景象。",
    "start": 89.362,
    "end": 93.711,
    "duration": 4.349
  },
  {
    "id": "sent_21",
    "text": "这些作品真切反映了底层百姓水深火热的生活图景，",
    "start": 93.711,
    "end": 98.802,
    "duration": 5.091
  },
  {
    "id": "sent_22",
    "text": "洋溢着强烈的反抗与批判力量。",
    "start": 98.802,
    "end": 101.966,
    "duration": 3.164
  },
  {
    "id": "sent_23",
    "text": "第二，推动诗歌体式由四言向五言叙事诗演进，",
    "start": 101.966,
    "end": 106.784,
    "duration": 4.818
  },
  {
    "id": "sent_24",
    "text": "奠定古典长篇叙事诗体制基石。",
    "start": 106.784,
    "end": 110.039,
    "duration": 3.255
  },
  {
    "id": "sent_25",
    "text": "汉乐府在文体形式上作出了开创性贡献，",
    "start": 110.039,
    "end": 113.932,
    "duration": 3.893
  },
  {
    "id": "sent_26",
    "text": "它冲破了四言诗句式的封闭局限，推动了中国古代文人五言诗的成熟。",
    "start": 113.932,
    "end": 120.143,
    "duration": 6.211
  },
  {
    "id": "sent_27",
    "text": "尤其是乐府民歌中叙事成分的大幅度提升，",
    "start": 120.143,
    "end": 124.245,
    "duration": 4.102
  },
  {
    "id": "sent_28",
    "text": "使诗歌具备了交代完整事件前因后果与人物命运起伏的能力。",
    "start": 124.245,
    "end": 129.805,
    "duration": 5.56
  },
  {
    "id": "sent_29",
    "text": "其长篇叙事绝唱 《孔雀东南飞》，长达一千七百余字，全篇情节严整，",
    "start": 129.805,
    "end": 136.159,
    "duration": 6.354
  },
  {
    "id": "sent_30",
    "text": "围绕兰芝自请遣归、阿兄逼嫁、焦刘双双殉情的线索层层推进，",
    "start": 136.159,
    "end": 142.396,
    "duration": 6.237
  },
  {
    "id": "sent_31",
    "text": "波澜起伏、扣人心弦，",
    "start": 142.396,
    "end": 144.909,
    "duration": 2.513
  },
  {
    "id": "sent_32",
    "text": "标志着中国古代叙事诗艺术达到了完全成熟的阶段。",
    "start": 144.908,
    "end": 149.661,
    "duration": 4.753
  },
  {
    "id": "sent_33",
    "text": "第三，长于在激烈矛盾冲突中运用个性化语言与传神细节塑造性格典型。",
    "start": 149.661,
    "end": 156.822,
    "duration": 7.161
  },
  {
    "id": "sent_34",
    "text": "汉乐府极善于借助戏剧化的冲突与对话白描刻画人物灵魂。",
    "start": 156.823,
    "end": 162.162,
    "duration": 5.339
  },
  {
    "id": "sent_35",
    "text": "《孔雀东南飞》 塑造了一组性格极具反差的人物群像：",
    "start": 162.161,
    "end": 166.94,
    "duration": 4.779
  },
  {
    "id": "sent_36",
    "text": "刘兰芝坚贞自尊、外柔内刚，在被逐出门时 “精做衣服，",
    "start": 166.94,
    "end": 172.253,
    "duration": 5.313
  },
  {
    "id": "sent_37",
    "text": "事事四五通”，以此捍卫自身的人格尊严；",
    "start": 172.253,
    "end": 176.211,
    "duration": 3.958
  },
  {
    "id": "sent_38",
    "text": "焦仲卿深情重义却性格懦弱，在专横跋扈的焦母面前进退两难；",
    "start": 176.211,
    "end": 182.474,
    "duration": 6.263
  },
  {
    "id": "sent_39",
    "text": "焦母唯我独尊、蛮横专断；",
    "start": 182.474,
    "end": 185.286,
    "duration": 2.812
  },
  {
    "id": "sent_40",
    "text": "阿兄市侩冷酷、趋炎附势。",
    "start": 185.286,
    "end": 188.072,
    "duration": 2.786
  },
  {
    "id": "sent_41",
    "text": "在 《陌上桑》 中，女主人公秦罗敷面对使君调戏，",
    "start": 188.073,
    "end": 192.526,
    "duration": 4.453
  },
  {
    "id": "sent_42",
    "text": "以极具夸饰的机智言辞赞美夫婿，",
    "start": 192.526,
    "end": 196.107,
    "duration": 3.581
  },
  {
    "id": "sent_43",
    "text": "言笑晏晏间将权贵的丑恶嘴脸嘲弄殆尽，人物性格鲜活饱满。",
    "start": 196.107,
    "end": 202.084,
    "duration": 5.977
  },
  {
    "id": "sent_44",
    "text": "第四，丰富了古典抒情手法的表现力，",
    "start": 202.083,
    "end": 205.638,
    "duration": 3.555
  },
  {
    "id": "sent_45",
    "text": "直接哺育建安风骨与杜甫即事名篇。",
    "start": 205.638,
    "end": 209.362,
    "duration": 3.724
  },
  {
    "id": "sent_46",
    "text": "汉乐府不仅以现实主义叙事著称，",
    "start": 209.362,
    "end": 212.513,
    "duration": 3.151
  },
  {
    "id": "sent_47",
    "text": "同样开创了融浪漫想象与托物起兴于一体的高超抒情技艺。",
    "start": 212.513,
    "end": 218.255,
    "duration": 5.742
  },
  {
    "id": "sent_48",
    "text": "《孔雀东南飞》 开篇以 “孔雀东南飞，",
    "start": 218.255,
    "end": 221.68,
    "duration": 3.425
  },
  {
    "id": "sent_49",
    "text": "五里一徘徊” 起兴营造悲怆基调，",
    "start": 221.68,
    "end": 225.013,
    "duration": 3.333
  },
  {
    "id": "sent_50",
    "text": "结尾以两人合葬化为相思树、鸳鸯飞鸣的神话想象，",
    "start": 225.013,
    "end": 230.0,
    "duration": 4.987
  },
  {
    "id": "sent_51",
    "text": "表达了人民反抗礼教、追求爱情永恒的浪漫理想；",
    "start": 230.0,
    "end": 234.661,
    "duration": 4.661
  },
  {
    "id": "sent_52",
    "text": "《江南》 运用 “莲叶何田田，鱼戏莲叶东” 的复沓民歌手法，",
    "start": 234.661,
    "end": 239.557,
    "duration": 4.896
  },
  {
    "id": "sent_53",
    "text": "极具民间音乐的明朗灵动。",
    "start": 239.557,
    "end": 242.317,
    "duration": 2.76
  },
  {
    "id": "sent_54",
    "text": "汉乐府这种直面现实、长于叙事的优良传统，",
    "start": 242.318,
    "end": 246.628,
    "duration": 4.31
  },
  {
    "id": "sent_55",
    "text": "直接哺育了曹操、曹植的建安文学，",
    "start": 246.628,
    "end": 250.3,
    "duration": 3.672
  },
  {
    "id": "sent_56",
    "text": "并成为唐代杜甫即事名篇与白居易新乐府运动的母体源头。",
    "start": 250.299,
    "end": 255.625,
    "duration": 5.326
  }
]