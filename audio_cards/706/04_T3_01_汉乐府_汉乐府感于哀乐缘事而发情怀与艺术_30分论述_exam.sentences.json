[
  {
    "id": 1,
    "text": "试论汉乐府“感于哀乐，缘事而发”的现实情怀与叙事艺术成就。",
    "start": 0.134,
    "end": 4.946,
    "duration": 4.812
  },
  {
    "id": 2,
    "text": "两汉乐府民歌是中国古代诗歌现实主义叙事传统的高峰。",
    "start": 5.57,
    "end": 9.942,
    "duration": 4.372
  },
  {
    "id": 3,
    "text": "面对汉武帝以后徭役繁重、战争频仍、贫富悬殊以及豪强兼并与宗法礼教的压迫，",
    "start": 10.7,
    "end": 17.072,
    "duration": 6.372
  },
  {
    "id": 4,
    "text": "乐府官署深入民间采诗，继承并发展了《诗经》的风雅精神。",
    "start": 17.451,
    "end": 21.943,
    "duration": 4.492
  },
  {
    "id": 5,
    "text": "班固在《汉书·艺文志》中概括其特质为“感于哀乐，缘事而发”。",
    "start": 22.621,
    "end": 26.713,
    "duration": 4.092
  },
  {
    "id": 6,
    "text": "汉乐府摆脱了西汉大赋铺张润色盛世的浮华风气，以质朴生动的民间心声再现社会百态。",
    "start": 27.431,
    "end": 34.363,
    "duration": 6.932
  },
  {
    "id": 7,
    "text": "其现实情怀与叙事艺术成就，主要体现在以下四个方面：",
    "start": 35.041,
    "end": 44.813,
    "duration": 9.772
  },
  {
    "id": 8,
    "text": "第一，确立“感于哀乐，缘事而发”的现实精神，直面底层民生疾苦。",
    "start": 45.451,
    "end": 49.623,
    "duration": 4.172
  },
  {
    "id": 9,
    "text": "“感于哀乐，缘事而发”是汉乐府民歌最核心的思想灵魂。",
    "start": 50.421,
    "end": 57.633,
    "duration": 7.212
  },
  {
    "id": 10,
    "text": "“缘事而发”指诗歌紧扣生活中的具体事件生发，",
    "start": 58.351,
    "end": 64.283,
    "duration": 5.932
  },
  {
    "id": 11,
    "text": "“感于哀乐”则倾注了普通百姓真挚的苦乐爱恨。",
    "start": 64.662,
    "end": 68.354,
    "duration": 3.692
  },
  {
    "id": 12,
    "text": "如《十五从军征》以“十五从军征，八十始得归”控诉长期兵役制度对人生的摧残，",
    "start": 69.032,
    "end": 70.364,
    "duration": 1.332
  },
  {
    "id": 13,
    "text": "写出老兵归家唯见冢累累、松柏萧条的凄凉；",
    "start": 70.743,
    "end": 72.035,
    "duration": 1.292
  },
  {
    "id": 14,
    "text": "《东门行》写贫民在“盎中无斗米储”的绝境下拔剑而起；",
    "start": 72.564,
    "end": 72.696,
    "duration": 0.132
  },
  {
    "id": 15,
    "text": "《妇病行》刻画病妇临终托孤、孤儿啼号乞食的惨状。",
    "start": 73.225,
    "end": 74.187,
    "duration": 0.962
  },
  {
    "id": 16,
    "text": "这些作品真实揭示了社会两极分化，饱含深切的人道同情与反抗精神。",
    "start": 74.945,
    "end": 79.077,
    "duration": 4.132
  },
  {
    "id": 17,
    "text": "第二，推动诗体由四言向杂言、五言演进，标志着古代叙事诗的成熟。",
    "start": 79.755,
    "end": 85.327,
    "duration": 5.572
  },
  {
    "id": 18,
    "text": "两汉乐府打破了《诗经》以来四言诗的整齐拘束，吸收楚声与民间曲调，",
    "start": 85.965,
    "end": 88.577,
    "duration": 2.612
  },
  {
    "id": 19,
    "text": "发展出灵活多变的杂言体与日臻成熟的五言诗体，为文人五言诗的兴盛奠定了形式基础。",
    "start": 88.956,
    "end": 91.968,
    "duration": 3.012
  },
  {
    "id": 20,
    "text": "更重要的是，乐府民歌大幅提升了诗歌的叙事功能，",
    "start": 92.646,
    "end": 102.538,
    "duration": 9.892
  },
  {
    "id": 21,
    "text": "能够从容交代完整的情节因果与人物命运起伏。",
    "start": 102.917,
    "end": 113.81,
    "duration": 10.893
  },
  {
    "id": 22,
    "text": "长篇叙事诗《孔雀东南飞》全诗一千七百余字，",
    "start": 114.339,
    "end": 118.391,
    "duration": 4.052
  },
  {
    "id": 23,
    "text": "围绕刘兰芝被遣归、阿兄逼嫁、焦刘双双殉情双线交错展开，情节波澜起伏、详略得当，标志着中国古代叙事诗艺术走向成熟。",
    "start": 118.77,
    "end": 129.742,
    "duration": 10.972
  },
  {
    "id": 24,
    "text": "第三，长于在戏剧冲突中运用个性化语言与细节刻画鲜活人物。",
    "start": 130.366,
    "end": 135.258,
    "duration": 4.892
  },
  {
    "id": 25,
    "text": "汉乐府极善于借助尖锐冲突、人物对话与服饰动作细节塑造性格典型。",
    "start": 135.896,
    "end": 141.308,
    "duration": 5.412
  },
  {
    "id": 26,
    "text": "《孔雀东南飞》刻画了一组个性鲜明的人物群像：刘兰芝坚贞自尊、外柔内刚，",
    "start": 142.146,
    "end": 145.438,
    "duration": 3.292
  },
  {
    "id": 27,
    "text": "离别之际晨起严妆，“著我绣裌裙，事事四五通”，以从容庄重的举止维护自身尊严；",
    "start": 145.817,
    "end": 150.069,
    "duration": 4.252
  },
  {
    "id": 28,
    "text": "焦仲卿重情守义却软弱无奈；",
    "start": 150.598,
    "end": 152.77,
    "duration": 2.172
  },
  {
    "id": 29,
    "text": "焦母专横跋扈，刘兄市侩势利，形象无不肖其声情。",
    "start": 153.299,
    "end": 155.831,
    "duration": 2.532
  },
  {
    "id": 30,
    "text": "在《陌上桑》中，采桑女秦罗敷面对太守无礼调戏，",
    "start": 156.549,
    "end": 159.121,
    "duration": 2.572
  },
  {
    "id": 31,
    "text": "巧以夸耀夫婿的诙谐言辞戏弄权贵，在言笑晏晏间彰显出聪明机智与刚正骨气。",
    "start": 159.799,
    "end": 164.291,
    "duration": 4.492
  },
  {
    "id": 32,
    "text": "第四，丰富了比兴、复沓与浪漫想象手法，深远哺育后世现实主义诗风。",
    "start": 165.009,
    "end": 175.261,
    "duration": 10.252
  },
  {
    "id": 33,
    "text": "汉乐府不仅长于白描叙事，也融合了生动的抒情与浪漫想象技艺。",
    "start": 175.939,
    "end": 181.591,
    "duration": 5.652
  },
  {
    "id": 34,
    "text": "《孔雀东南飞》开篇以“孔雀东南飞，五里一徘徊”起兴定下悲怆基调，",
    "start": 182.309,
    "end": 184.361,
    "duration": 2.052
  },
  {
    "id": 35,
    "text": "结尾以合葬化鸟寄托坚贞爱情理想；",
    "start": 184.74,
    "end": 185.632,
    "duration": 0.892
  },
  {
    "id": 36,
    "text": "《江南》运用“莲叶何田田，鱼戏莲叶东”的复沓民歌格调，活泼明朗，富有乐感。",
    "start": 186.161,
    "end": 188.003,
    "duration": 1.842
  },
  {
    "id": 37,
    "text": "汉乐府直面现实、缘事而发的创作精神与叙事技巧，直接哺育了建安曹氏父子等人的乐府诗作，",
    "start": 188.761,
    "end": 194.013,
    "duration": 5.252
  },
  {
    "id": 38,
    "text": "并成为唐代杜甫“即事名篇”与白居易“新乐府运动”的重要源头。",
    "start": 194.392,
    "end": 197.084,
    "duration": 2.692
  },
  {
    "id": 39,
    "text": "综上所述，两汉乐府民歌立足“感于哀乐，缘事而发”的写实精神，",
    "start": 197.842,
    "end": 210.979,
    "duration": 13.137
  },
  {
    "id": 40,
    "text": "摆脱了汉代大赋铺张润色盛世的浮华风气，",
    "start": 211.407,
    "end": 217.219,
    "duration": 5.812
  },
  {
    "id": 41,
    "text": "以真切质朴的歌谣写出了下层民众的悲欢抗争。",
    "start": 217.769,
    "end": 229.659,
    "duration": 11.89
  },
  {
    "id": 42,
    "text": "它在体裁上完成了从四言向杂言、五言叙事诗的关键过渡，",
    "start": 230.188,
    "end": 234.6,
    "duration": 4.412
  },
  {
    "id": 43,
    "text": "其缘事写人传统直接哺育了建安文学及唐代杜甫、白居易的现实主义诗歌创作。",
    "start": 234.979,
    "end": 240.711,
    "duration": 5.732
  }
]