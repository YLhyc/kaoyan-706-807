[
  {
    "id": 1,
    "text": "试论汉乐府“感于哀乐，缘事而发”的现实情怀与叙事艺术成就。",
    "start": 0.101,
    "end": 5.582,
    "duration": 5.481
  },
  {
    "id": 2,
    "text": "两汉乐府民歌是中国古代诗歌现实主义叙事传统的高峰。",
    "start": 6.029,
    "end": 10.209,
    "duration": 4.18
  },
  {
    "id": 3,
    "text": "面对汉武帝以后徭役繁重、战争频仍、",
    "start": 10.605,
    "end": 13.492,
    "duration": 2.887
  },
  {
    "id": 4,
    "text": "贫富悬殊以及豪强兼并与宗法礼教的压迫，",
    "start": 13.815,
    "end": 17.187,
    "duration": 3.372
  },
  {
    "id": 5,
    "text": "乐府官署深入民间采诗，继承并发展了《诗经》的风雅精神。",
    "start": 17.514,
    "end": 22.357,
    "duration": 4.843
  },
  {
    "id": 6,
    "text": "班固在《汉书·艺文志》中概括其特质为“感于哀乐，缘事而发”。",
    "start": 22.599,
    "end": 27.832,
    "duration": 5.233
  },
  {
    "id": 7,
    "text": "汉乐府摆脱了西汉大赋铺张润色盛世的浮华风气，",
    "start": 28.221,
    "end": 32.054,
    "duration": 3.833
  },
  {
    "id": 8,
    "text": "以质朴生动的民间心声再现社会百态。",
    "start": 32.439,
    "end": 35.531,
    "duration": 3.092
  },
  {
    "id": 9,
    "text": "其现实情怀与叙事艺术成就，主要体现在以下四个方面：",
    "start": 35.864,
    "end": 40.186,
    "duration": 4.322
  },
  {
    "id": 10,
    "text": "第一，确立“感于哀乐，缘事而发”的现实精神，",
    "start": 40.799,
    "end": 44.347,
    "duration": 3.548
  },
  {
    "id": 11,
    "text": "直面底层民生疾苦。",
    "start": 44.65,
    "end": 46.188,
    "duration": 1.538
  },
  {
    "id": 12,
    "text": "“感于哀乐，缘事而发”是汉乐府民歌最核心的思想灵魂。",
    "start": 46.456,
    "end": 50.753,
    "duration": 4.297
  },
  {
    "id": 13,
    "text": "“缘事而发”指诗歌紧扣生活中的具体事件生发，",
    "start": 51.135,
    "end": 54.507,
    "duration": 3.372
  },
  {
    "id": 14,
    "text": "“感于哀乐”则倾注了普通百姓真挚的苦乐爱恨。",
    "start": 54.932,
    "end": 58.512,
    "duration": 3.58
  },
  {
    "id": 15,
    "text": "如《十五从军征》以“十五从军征，",
    "start": 58.805,
    "end": 61.465,
    "duration": 2.66
  },
  {
    "id": 16,
    "text": "八十始得归”控诉长期兵役制度对人生的摧残，",
    "start": 61.703,
    "end": 65.698,
    "duration": 3.995
  },
  {
    "id": 17,
    "text": "写出老兵归家唯见冢累累、松柏萧条的凄凉；",
    "start": 66.121,
    "end": 70.325,
    "duration": 4.204
  },
  {
    "id": 18,
    "text": "《东门行》写贫民在“盎中无斗米储”的绝境下拔剑而起；",
    "start": 70.777,
    "end": 75.267,
    "duration": 4.49
  },
  {
    "id": 19,
    "text": "《妇病行》刻画病妇临终托孤、孤儿啼号乞食的惨状。",
    "start": 75.826,
    "end": 79.954,
    "duration": 4.128
  },
  {
    "id": 20,
    "text": "这些作品真实揭示了社会两极分化，",
    "start": 80.235,
    "end": 82.84,
    "duration": 2.605
  },
  {
    "id": 21,
    "text": "饱含深切的人道同情与反抗精神。",
    "start": 83.317,
    "end": 86.064,
    "duration": 2.747
  },
  {
    "id": 22,
    "text": "第二，推动诗体由四言向杂言、五言演进，",
    "start": 86.698,
    "end": 89.993,
    "duration": 3.295
  },
  {
    "id": 23,
    "text": "标志着古代叙事诗的成熟。",
    "start": 90.493,
    "end": 92.395,
    "duration": 1.902
  },
  {
    "id": 24,
    "text": "两汉乐府打破了《诗经》以来四言诗的整齐拘束，",
    "start": 92.846,
    "end": 96.153,
    "duration": 3.307
  },
  {
    "id": 25,
    "text": "吸收楚声与民间曲调，",
    "start": 96.66,
    "end": 98.458,
    "duration": 1.798
  },
  {
    "id": 26,
    "text": "发展出灵活多变的杂言体与日臻成熟的五言诗体，",
    "start": 98.861,
    "end": 102.735,
    "duration": 3.874
  },
  {
    "id": 27,
    "text": "为文人五言诗的兴盛奠定了形式基础。",
    "start": 103.195,
    "end": 106.023,
    "duration": 2.828
  },
  {
    "id": 28,
    "text": "更重要的是，乐府民歌大幅提升了诗歌的叙事功能，",
    "start": 106.298,
    "end": 110.016,
    "duration": 3.718
  },
  {
    "id": 29,
    "text": "能够从容交代完整的情节因果与人物命运起伏。",
    "start": 110.18,
    "end": 113.954,
    "duration": 3.774
  },
  {
    "id": 30,
    "text": "长篇叙事诗《孔雀东南飞》全诗一千七百余字，",
    "start": 114.242,
    "end": 117.775,
    "duration": 3.533
  },
  {
    "id": 31,
    "text": "围绕刘兰芝被遣归、阿兄逼嫁、焦刘双双殉情双线交错展开，",
    "start": 117.937,
    "end": 122.969,
    "duration": 5.032
  },
  {
    "id": 32,
    "text": "情节波澜起伏、详略得当，",
    "start": 123.095,
    "end": 125.134,
    "duration": 2.039
  },
  {
    "id": 33,
    "text": "标志着中国古代叙事诗艺术走向成熟。",
    "start": 125.36,
    "end": 128.351,
    "duration": 2.991
  },
  {
    "id": 34,
    "text": "第三，长于在戏剧冲突中运用个性化语言与细节刻画鲜活人物。",
    "start": 128.996,
    "end": 134.456,
    "duration": 5.46
  },
  {
    "id": 35,
    "text": "汉乐府极善于借助尖锐冲突、",
    "start": 134.783,
    "end": 137.052,
    "duration": 2.269
  },
  {
    "id": 36,
    "text": "人物对话与服饰动作细节塑造性格典型。",
    "start": 137.231,
    "end": 140.637,
    "duration": 3.406
  },
  {
    "id": 37,
    "text": "《孔雀东南飞》刻画了一组个性鲜明的人物群像：",
    "start": 140.944,
    "end": 143.994,
    "duration": 3.05
  },
  {
    "id": 38,
    "text": "刘兰芝坚贞自尊、外柔内刚，离别之际晨起严妆，",
    "start": 144.272,
    "end": 148.683,
    "duration": 4.411
  },
  {
    "id": 39,
    "text": "“著我绣裌裙，事事四五通”，",
    "start": 148.998,
    "end": 151.4,
    "duration": 2.402
  },
  {
    "id": 40,
    "text": "以从容庄重的举止维护自身尊严；焦仲卿重情守义却软弱无奈；",
    "start": 151.673,
    "end": 156.716,
    "duration": 5.043
  },
  {
    "id": 41,
    "text": "焦母专横跋扈，刘兄市侩势利，形象无不肖其声情。",
    "start": 156.991,
    "end": 161.259,
    "duration": 4.268
  },
  {
    "id": 42,
    "text": "在《陌上桑》中，采桑女秦罗敷面对太守无礼调戏，",
    "start": 161.453,
    "end": 165.585,
    "duration": 4.132
  },
  {
    "id": 43,
    "text": "巧以夸耀夫婿的诙谐言辞戏弄权贵，",
    "start": 165.732,
    "end": 168.457,
    "duration": 2.725
  },
  {
    "id": 44,
    "text": "在言笑晏晏间彰显出聪明机智与刚正骨气。",
    "start": 168.705,
    "end": 172.519,
    "duration": 3.814
  },
  {
    "id": 45,
    "text": "第四，丰富了比兴、复沓与浪漫想象手法，",
    "start": 173.137,
    "end": 176.947,
    "duration": 3.81
  },
  {
    "id": 46,
    "text": "深远哺育后世现实主义诗风。",
    "start": 177.449,
    "end": 179.748,
    "duration": 2.299
  },
  {
    "id": 47,
    "text": "汉乐府不仅长于白描叙事，也融合了生动的抒情与浪漫想象技艺。",
    "start": 179.898,
    "end": 185.414,
    "duration": 5.516
  },
  {
    "id": 48,
    "text": "《孔雀东南飞》开篇以“孔雀东南飞，",
    "start": 185.551,
    "end": 188.088,
    "duration": 2.537
  },
  {
    "id": 49,
    "text": "五里一徘徊”起兴定下悲怆基调，",
    "start": 188.326,
    "end": 190.818,
    "duration": 2.492
  },
  {
    "id": 50,
    "text": "结尾以合葬化鸟寄托坚贞爱情理想；",
    "start": 191.161,
    "end": 194.08,
    "duration": 2.919
  },
  {
    "id": 51,
    "text": "《江南》运用“莲叶何田田，鱼戏莲叶东”的复沓民歌格调，",
    "start": 194.342,
    "end": 198.721,
    "duration": 4.379
  },
  {
    "id": 52,
    "text": "活泼明朗，富有乐感。",
    "start": 198.731,
    "end": 200.636,
    "duration": 1.905
  },
  {
    "id": 53,
    "text": "汉乐府直面现实、缘事而发的创作精神与叙事技巧，",
    "start": 200.791,
    "end": 205.243,
    "duration": 4.452
  },
  {
    "id": 54,
    "text": "直接哺育了建安曹氏父子等人的乐府诗作，",
    "start": 205.44,
    "end": 209.838,
    "duration": 4.398
  },
  {
    "id": 55,
    "text": "并成为唐代杜甫“即事名篇”与白居易“新乐府运动”的重要源头。",
    "start": 210.027,
    "end": 215.32,
    "duration": 5.293
  }
]