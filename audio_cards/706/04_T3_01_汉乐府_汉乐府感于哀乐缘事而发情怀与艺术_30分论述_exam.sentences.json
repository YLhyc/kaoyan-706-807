[
  {
    "id": 1,
    "text": "试论汉乐府“感于哀乐，缘事而发”的现实情怀与叙事艺术成就。",
    "start": 0.0,
    "end": 6.717,
    "duration": 6.717
  },
  {
    "id": 2,
    "text": "两汉乐府民歌是中国古典诗歌现实主义叙事传统的划时代高峰。",
    "start": 6.717,
    "end": 12.754,
    "duration": 6.037
  },
  {
    "id": 3,
    "text": "面对汉武帝以后徭役繁重、战争连年、",
    "start": 12.754,
    "end": 16.172,
    "duration": 3.418
  },
  {
    "id": 4,
    "text": "阶级分化与门阀宗法礼教压迫的严酷现实，",
    "start": 16.172,
    "end": 20.279,
    "duration": 4.107
  },
  {
    "id": 5,
    "text": "汉代乐府官署深入民间采集歌谣，",
    "start": 20.279,
    "end": 23.611,
    "duration": 3.332
  },
  {
    "id": 6,
    "text": "全面继承并发展了 《诗经》 的风雅精神。",
    "start": 23.611,
    "end": 26.863,
    "duration": 3.252
  },
  {
    "id": 7,
    "text": "班固在 《汉书·艺文志》 中精辟概括其特质为 “感于哀乐，",
    "start": 26.863,
    "end": 30.378,
    "duration": 3.515
  },
  {
    "id": 8,
    "text": "缘事而发”。",
    "start": 30.378,
    "end": 31.342,
    "duration": 0.964
  },
  {
    "id": 9,
    "text": "汉乐府彻底摆脱了西汉辞赋粉饰大一统盛世的浮华积习，",
    "start": 31.342,
    "end": 36.917,
    "duration": 5.575
  },
  {
    "id": 10,
    "text": "第一次以质朴深沉的民间心声构建起生动的生活画卷。",
    "start": 36.917,
    "end": 41.569,
    "duration": 4.652
  },
  {
    "id": 11,
    "text": "其现实情怀与叙事艺术成就，主要展现为以下四个核心维度：",
    "start": 41.569,
    "end": 46.216,
    "duration": 4.647
  },
  {
    "id": 12,
    "text": "第一，确立“感于哀乐，缘事而发”的现实主义批判精神，",
    "start": 46.216,
    "end": 51.79,
    "duration": 5.574
  },
  {
    "id": 13,
    "text": "深沉直面民生苦难。",
    "start": 51.79,
    "end": 54.401,
    "duration": 2.611
  },
  {
    "id": 14,
    "text": "“感于哀乐，缘事而发” 是汉乐府最根本的现实主义灵魂。",
    "start": 54.401,
    "end": 59.383,
    "duration": 4.982
  },
  {
    "id": 15,
    "text": "所谓“缘事而发”，即诗歌紧扣社会生活中的真实事件展开，",
    "start": 59.383,
    "end": 66.957,
    "duration": 7.574
  },
  {
    "id": 16,
    "text": "不作凭空的玄虚之论；所谓“感于哀乐”，",
    "start": 66.957,
    "end": 71.659,
    "duration": 4.702
  },
  {
    "id": 17,
    "text": "即深刻倾注劳动人民真实的喜怒哀乐。",
    "start": 71.659,
    "end": 75.201,
    "duration": 3.542
  },
  {
    "id": 18,
    "text": "其作品题材极为广泛：在 《十五从军征》 中，",
    "start": 75.201,
    "end": 84.156,
    "duration": 8.955
  },
  {
    "id": 19,
    "text": "以 “十五从军征，",
    "start": 84.156,
    "end": 85.299,
    "duration": 1.143
  },
  {
    "id": 20,
    "text": "八十始得归” 控诉兵役制度对个体生命的残酷剥夺，",
    "start": 85.299,
    "end": 89.296,
    "duration": 3.997
  },
  {
    "id": 21,
    "text": "展现老年残兵归家唯见草木坟茔的极致悲酸；",
    "start": 89.296,
    "end": 91.81,
    "duration": 2.514
  },
  {
    "id": 22,
    "text": "在 《东门行》 中，写下底层贫民拔剑而起的绝望愤怒；",
    "start": 91.81,
    "end": 95.983,
    "duration": 4.173
  },
  {
    "id": 23,
    "text": "在 《妇病行》 中，写病妇临终托孤的凄惨景象。",
    "start": 95.983,
    "end": 100.553,
    "duration": 4.57
  },
  {
    "id": 24,
    "text": "这些作品真切反映了底层百姓水深火热的生活图景，",
    "start": 100.553,
    "end": 105.782,
    "duration": 5.229
  },
  {
    "id": 25,
    "text": "洋溢着强烈的反抗与批判力量。",
    "start": 105.782,
    "end": 108.98,
    "duration": 3.198
  },
  {
    "id": 26,
    "text": "第二，推动诗歌体式由四言向五言叙事诗演进，",
    "start": 108.98,
    "end": 111.646,
    "duration": 2.666
  },
  {
    "id": 27,
    "text": "奠定古典长篇叙事诗体制基石。",
    "start": 111.646,
    "end": 114.71,
    "duration": 3.064
  },
  {
    "id": 28,
    "text": "汉乐府在文体形式上作出了开创性贡献，",
    "start": 114.71,
    "end": 118.534,
    "duration": 3.824
  },
  {
    "id": 29,
    "text": "它冲破了四言诗句式的封闭局限，",
    "start": 118.534,
    "end": 121.624,
    "duration": 3.09
  },
  {
    "id": 30,
    "text": "推动了中国古代文人五言诗的成熟。",
    "start": 121.624,
    "end": 125.33,
    "duration": 3.706
  },
  {
    "id": 31,
    "text": "尤其是乐府民歌中叙事成分的大幅度提升，",
    "start": 125.33,
    "end": 130.537,
    "duration": 5.207
  },
  {
    "id": 32,
    "text": "使诗歌具备了交代完整事件前因后果与人物命运起伏的能力。",
    "start": 130.537,
    "end": 136.829,
    "duration": 6.292
  },
  {
    "id": 33,
    "text": "其长篇叙事绝唱 《孔雀东南飞》，长达一千七百余字，",
    "start": 136.829,
    "end": 141.32,
    "duration": 4.491
  },
  {
    "id": 34,
    "text": "全篇情节严整，围绕兰芝自请遣归、阿兄逼嫁、",
    "start": 141.32,
    "end": 146.046,
    "duration": 4.726
  },
  {
    "id": 35,
    "text": "焦刘双双殉情的线索层层推进，波澜起伏、扣人心弦，",
    "start": 146.046,
    "end": 149.943,
    "duration": 3.897
  },
  {
    "id": 36,
    "text": "标志着中国古代叙事诗艺术达到了完全成熟的阶段。第三，",
    "start": 149.943,
    "end": 155.229,
    "duration": 5.286
  },
  {
    "id": 37,
    "text": "长于在激烈矛盾冲突中运用个性化语言与传神细节塑造性格典型。",
    "start": 155.229,
    "end": 159.287,
    "duration": 4.058
  },
  {
    "id": 38,
    "text": "汉乐府极善于借助戏剧化的冲突与对话白描刻画人物灵魂。",
    "start": 159.287,
    "end": 166.562,
    "duration": 7.275
  },
  {
    "id": 39,
    "text": "《孔雀东南飞》 塑造了一组性格极具反差的人物群像：",
    "start": 166.562,
    "end": 171.945,
    "duration": 5.383
  },
  {
    "id": 40,
    "text": "刘兰芝坚贞自尊、外柔内刚，在被逐出门时 “精做衣服，",
    "start": 171.945,
    "end": 177.261,
    "duration": 5.316
  },
  {
    "id": 41,
    "text": "事事四五通”，以此捍卫自身的人格尊严；",
    "start": 177.261,
    "end": 181.019,
    "duration": 3.758
  },
  {
    "id": 42,
    "text": "焦仲卿深情重义却性格懦弱，在专横跋扈的焦母面前进退两难；",
    "start": 181.019,
    "end": 187.478,
    "duration": 6.459
  },
  {
    "id": 43,
    "text": "焦母唯我独尊、蛮横专断；阿兄市侩冷酷、趋炎附势。",
    "start": 187.478,
    "end": 192.435,
    "duration": 4.957
  },
  {
    "id": 44,
    "text": "在 《陌上桑》 中，女主人公秦罗敷面对使君调戏，",
    "start": 192.435,
    "end": 195.704,
    "duration": 3.269
  },
  {
    "id": 45,
    "text": "以极具夸饰的机智言辞赞美夫婿，",
    "start": 195.704,
    "end": 198.543,
    "duration": 2.839
  },
  {
    "id": 46,
    "text": "言笑晏晏间将权贵的丑恶嘴脸嘲弄殆尽，人物性格鲜活饱满。",
    "start": 198.543,
    "end": 202.744,
    "duration": 4.201
  },
  {
    "id": 47,
    "text": "第四，丰富了古典抒情手法的表现力，",
    "start": 202.744,
    "end": 204.108,
    "duration": 1.364
  },
  {
    "id": 48,
    "text": "直接哺育建安风骨与杜甫即事名篇。",
    "start": 204.108,
    "end": 205.816,
    "duration": 1.708
  },
  {
    "id": 49,
    "text": "汉乐府不仅以现实主义叙事著称，",
    "start": 205.816,
    "end": 206.986,
    "duration": 1.17
  },
  {
    "id": 50,
    "text": "同样开创了融浪漫想象与托物起兴于一体的高超抒情技艺。",
    "start": 206.986,
    "end": 209.539,
    "duration": 2.553
  },
  {
    "id": 51,
    "text": "《孔雀东南飞》 开篇以 “孔雀东南飞，",
    "start": 209.539,
    "end": 217.868,
    "duration": 8.329
  },
  {
    "id": 52,
    "text": "五里一徘徊” 起兴营造悲怆基调，",
    "start": 217.868,
    "end": 220.244,
    "duration": 2.376
  },
  {
    "id": 53,
    "text": "结尾以两人合葬化为相思树、鸳鸯飞鸣的神话想象，",
    "start": 220.244,
    "end": 222.657,
    "duration": 2.413
  },
  {
    "id": 54,
    "text": "表达了人民反抗礼教、追求爱情永恒的浪漫理想；",
    "start": 222.657,
    "end": 224.872,
    "duration": 2.215
  },
  {
    "id": 55,
    "text": "《江南》 运用 “莲叶何田田，",
    "start": 224.872,
    "end": 226.906,
    "duration": 2.034
  },
  {
    "id": 56,
    "text": "鱼戏莲叶东” 的复沓民歌手法，极具民间音乐的明朗灵动。",
    "start": 226.906,
    "end": 228.647,
    "duration": 1.741
  },
  {
    "id": 57,
    "text": "汉乐府这种直面现实、长于叙事的优良传统，直接哺育了曹操、",
    "start": 228.647,
    "end": 231.52,
    "duration": 2.873
  },
  {
    "id": 58,
    "text": "曹植的建安文学，",
    "start": 231.52,
    "end": 233.802,
    "duration": 2.282
  },
  {
    "id": 59,
    "text": "并成为唐代杜甫即事名篇与白居易新乐府运动的母体源头。",
    "start": 233.802,
    "end": 236.138,
    "duration": 2.336
  }
]