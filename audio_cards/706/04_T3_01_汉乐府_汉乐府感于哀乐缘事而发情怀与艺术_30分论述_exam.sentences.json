[
  {
    "id": 1,
    "text": "试论汉乐府“感于哀乐，缘事而发”的现实情怀与叙事艺术成就。",
    "start": 0.05,
    "end": 4.783,
    "duration": 4.733
  },
  {
    "id": 2,
    "text": "两汉乐府民歌是中国古典诗歌现实主义叙事传统的划时代高峰。",
    "start": 4.783,
    "end": 11.451,
    "duration": 6.668
  },
  {
    "id": 3,
    "text": "面对汉武帝以后徭役繁重、战争连年、",
    "start": 11.451,
    "end": 15.094,
    "duration": 3.643
  },
  {
    "id": 4,
    "text": "阶级分化与门阀宗法礼教压迫的严酷现实，",
    "start": 15.094,
    "end": 18.366,
    "duration": 3.272
  },
  {
    "id": 5,
    "text": "汉代乐府官署深入民间采集歌谣，",
    "start": 18.366,
    "end": 21.607,
    "duration": 3.241
  },
  {
    "id": 6,
    "text": "全面继承并发展了 《诗经》 的风雅精神。",
    "start": 21.607,
    "end": 24.807,
    "duration": 3.2
  },
  {
    "id": 7,
    "text": "班固在 《汉书·艺文志》 中精辟概括其特质为 “感于哀乐，",
    "start": 24.807,
    "end": 30.348,
    "duration": 5.541
  },
  {
    "id": 8,
    "text": "缘事而发”。",
    "start": 30.348,
    "end": 31.315,
    "duration": 0.967
  },
  {
    "id": 9,
    "text": "汉乐府彻底摆脱了西汉辞赋粉饰大一统盛世的浮华积习，",
    "start": 31.315,
    "end": 36.895,
    "duration": 5.58
  },
  {
    "id": 10,
    "text": "第一次以质朴深沉的民间心声构建起生动的生活画卷。",
    "start": 36.895,
    "end": 41.539,
    "duration": 4.644
  },
  {
    "id": 11,
    "text": "其现实情怀与叙事艺术成就，主要展现为以下四个核心维度：",
    "start": 41.539,
    "end": 46.186,
    "duration": 4.647
  },
  {
    "id": 12,
    "text": "第一，确立“感于哀乐，缘事而发”的现实主义批判精神，",
    "start": 46.186,
    "end": 51.769,
    "duration": 5.583
  },
  {
    "id": 13,
    "text": "深沉直面民生苦难。",
    "start": 51.769,
    "end": 53.223,
    "duration": 1.454
  },
  {
    "id": 14,
    "text": "“感于哀乐，缘事而发” 是汉乐府最根本的现实主义灵魂。",
    "start": 53.223,
    "end": 57.223,
    "duration": 4.0
  },
  {
    "id": 15,
    "text": "所谓“缘事而发”，即诗歌紧扣社会生活中的真实事件展开，",
    "start": 57.223,
    "end": 61.843,
    "duration": 4.62
  },
  {
    "id": 16,
    "text": "不作凭空的玄虚之论；所谓“感于哀乐”，",
    "start": 61.843,
    "end": 64.612,
    "duration": 2.769
  },
  {
    "id": 17,
    "text": "即深刻倾注劳动人民真实的喜怒哀乐。",
    "start": 64.612,
    "end": 68.686,
    "duration": 4.074
  },
  {
    "id": 18,
    "text": "其作品题材极为广泛：在 《十五从军征》 中，",
    "start": 68.686,
    "end": 71.629,
    "duration": 2.943
  },
  {
    "id": 19,
    "text": "以 “十五从军征，",
    "start": 71.629,
    "end": 73.631,
    "duration": 2.002
  },
  {
    "id": 20,
    "text": "八十始得归” 控诉兵役制度对个体生命的残酷剥夺，",
    "start": 73.631,
    "end": 77.945,
    "duration": 4.314
  },
  {
    "id": 21,
    "text": "展现老年残兵归家唯见草木坟茔的极致悲酸；",
    "start": 77.945,
    "end": 81.971,
    "duration": 4.026
  },
  {
    "id": 22,
    "text": "在 《东门行》 中，写下底层贫民拔剑而起的绝望愤怒；",
    "start": 81.971,
    "end": 86.198,
    "duration": 4.227
  },
  {
    "id": 23,
    "text": "在 《妇病行》 中，写病妇临终托孤的凄惨景象。",
    "start": 86.198,
    "end": 91.78,
    "duration": 5.582
  },
  {
    "id": 24,
    "text": "这些作品真切反映了底层百姓水深火热的生活图景，",
    "start": 91.78,
    "end": 95.956,
    "duration": 4.176
  },
  {
    "id": 25,
    "text": "洋溢着强烈的反抗与批判力量。",
    "start": 95.956,
    "end": 98.599,
    "duration": 2.643
  },
  {
    "id": 26,
    "text": "第二，推动诗歌体式由四言向五言叙事诗演进，",
    "start": 98.599,
    "end": 102.874,
    "duration": 4.275
  },
  {
    "id": 27,
    "text": "奠定古典长篇叙事诗体制基石。",
    "start": 102.874,
    "end": 105.759,
    "duration": 2.885
  },
  {
    "id": 28,
    "text": "汉乐府在文体形式上作出了开创性贡献，",
    "start": 105.759,
    "end": 108.95,
    "duration": 3.191
  },
  {
    "id": 29,
    "text": "它冲破了四言诗句式的封闭局限，",
    "start": 108.95,
    "end": 111.631,
    "duration": 2.681
  },
  {
    "id": 30,
    "text": "推动了中国古代文人五言诗的成熟。",
    "start": 111.631,
    "end": 114.68,
    "duration": 3.049
  },
  {
    "id": 31,
    "text": "尤其是乐府民歌中叙事成分的大幅度提升，",
    "start": 114.68,
    "end": 118.513,
    "duration": 3.833
  },
  {
    "id": 32,
    "text": "使诗歌具备了交代完整事件前因后果与人物命运起伏的能力。",
    "start": 118.513,
    "end": 123.788,
    "duration": 5.275
  },
  {
    "id": 33,
    "text": "其长篇叙事绝唱 《孔雀东南飞》，长达一千七百余字，",
    "start": 123.788,
    "end": 128.794,
    "duration": 5.006
  },
  {
    "id": 34,
    "text": "全篇情节严整，围绕兰芝自请遣归、阿兄逼嫁、",
    "start": 128.794,
    "end": 132.462,
    "duration": 3.668
  },
  {
    "id": 35,
    "text": "焦刘双双殉情的线索层层推进，波澜起伏、扣人心弦，",
    "start": 132.462,
    "end": 136.799,
    "duration": 4.337
  },
  {
    "id": 36,
    "text": "标志着中国古代叙事诗艺术达到了完全成熟的阶段。第三，",
    "start": 136.799,
    "end": 141.29,
    "duration": 4.491
  },
  {
    "id": 37,
    "text": "长于在激烈矛盾冲突中运用个性化语言与传神细节塑造性格典型。",
    "start": 141.29,
    "end": 147.416,
    "duration": 6.126
  },
  {
    "id": 38,
    "text": "汉乐府极善于借助戏剧化的冲突与对话白描刻画人物灵魂。",
    "start": 147.416,
    "end": 152.952,
    "duration": 5.536
  },
  {
    "id": 39,
    "text": "《孔雀东南飞》 塑造了一组性格极具反差的人物群像：",
    "start": 152.952,
    "end": 159.257,
    "duration": 6.305
  },
  {
    "id": 40,
    "text": "刘兰芝坚贞自尊、外柔内刚，在被逐出门时 “精做衣服，",
    "start": 159.257,
    "end": 163.075,
    "duration": 3.818
  },
  {
    "id": 41,
    "text": "事事四五通”，以此捍卫自身的人格尊严；",
    "start": 163.075,
    "end": 166.532,
    "duration": 3.457
  },
  {
    "id": 42,
    "text": "焦仲卿深情重义却性格懦弱，在专横跋扈的焦母面前进退两难；",
    "start": 166.532,
    "end": 171.917,
    "duration": 5.385
  },
  {
    "id": 43,
    "text": "焦母唯我独尊、蛮横专断；阿兄市侩冷酷、趋炎附势。",
    "start": 171.917,
    "end": 176.15,
    "duration": 4.233
  },
  {
    "id": 44,
    "text": "在 《陌上桑》 中，女主人公秦罗敷面对使君调戏，",
    "start": 176.15,
    "end": 179.423,
    "duration": 3.273
  },
  {
    "id": 45,
    "text": "以极具夸饰的机智言辞赞美夫婿，",
    "start": 179.423,
    "end": 183.858,
    "duration": 4.435
  },
  {
    "id": 46,
    "text": "言笑晏晏间将权贵的丑恶嘴脸嘲弄殆尽，人物性格鲜活饱满。",
    "start": 183.858,
    "end": 189.237,
    "duration": 5.379
  },
  {
    "id": 47,
    "text": "第四，丰富了古典抒情手法的表现力，",
    "start": 189.237,
    "end": 192.405,
    "duration": 3.168
  },
  {
    "id": 48,
    "text": "直接哺育建安风骨与杜甫即事名篇。",
    "start": 192.405,
    "end": 195.677,
    "duration": 3.272
  },
  {
    "id": 49,
    "text": "汉乐府不仅以现实主义叙事著称，",
    "start": 195.677,
    "end": 198.513,
    "duration": 2.836
  },
  {
    "id": 50,
    "text": "同样开创了融浪漫想象与托物起兴于一体的高超抒情技艺。",
    "start": 198.513,
    "end": 204.083,
    "duration": 5.57
  },
  {
    "id": 51,
    "text": "《孔雀东南飞》 开篇以 “孔雀东南飞，",
    "start": 204.083,
    "end": 206.956,
    "duration": 2.873
  },
  {
    "id": 52,
    "text": "五里一徘徊” 起兴营造悲怆基调，",
    "start": 206.956,
    "end": 209.509,
    "duration": 2.553
  },
  {
    "id": 53,
    "text": "结尾以两人合葬化为相思树、鸳鸯飞鸣的神话想象，",
    "start": 209.509,
    "end": 213.822,
    "duration": 4.313
  },
  {
    "id": 54,
    "text": "表达了人民反抗礼教、追求爱情永恒的浪漫理想；",
    "start": 213.822,
    "end": 217.844,
    "duration": 4.022
  },
  {
    "id": 55,
    "text": "《江南》 运用 “莲叶何田田，",
    "start": 217.844,
    "end": 220.214,
    "duration": 2.37
  },
  {
    "id": 56,
    "text": "鱼戏莲叶东” 的复沓民歌手法，极具民间音乐的明朗灵动。",
    "start": 220.214,
    "end": 224.842,
    "duration": 4.628
  },
  {
    "id": 57,
    "text": "汉乐府这种直面现实、长于叙事的优良传统，直接哺育了曹操、",
    "start": 224.842,
    "end": 229.388,
    "duration": 4.546
  },
  {
    "id": 58,
    "text": "曹植的建安文学，",
    "start": 229.388,
    "end": 231.49,
    "duration": 2.102
  },
  {
    "id": 59,
    "text": "并成为唐代杜甫即事名篇与白居易新乐府运动的母体源头。",
    "start": 231.49,
    "end": 236.352,
    "duration": 4.862
  }
]