[
  {
    "id": "sent_1",
    "text": "初唐四杰（王勃、杨炯、卢照邻、骆宾王）是初唐高宗至武后年间诗歌革新的先驱群体，",
    "start": 0.1,
    "end": 9.152,
    "duration": 9.052
  },
  {
    "id": "sent_2",
    "text": "标志着唐诗从六朝绮靡余风走向盛唐昂扬气象的关键转折。",
    "start": 9.102,
    "end": 14.857,
    "duration": 5.755
  },
  {
    "id": "sent_3",
    "text": "四杰在诗坛上的突破性贡献及其对律诗体式的奠基，",
    "start": 14.857,
    "end": 19.74,
    "duration": 4.883
  },
  {
    "id": "sent_4",
    "text": "主要展现为以下三个核心维度：",
    "start": 19.74,
    "end": 23.021,
    "duration": 3.281
  },
  {
    "id": "sent_5",
    "text": "第一，破除齐梁宫体浮靡旧习，拓展诗歌题材题材与骨气力量。",
    "start": 23.021,
    "end": 29.115,
    "duration": 6.094
  },
  {
    "id": "sent_6",
    "text": "四杰在文学观念与创作实践上，",
    "start": 29.115,
    "end": 32.435,
    "duration": 3.32
  },
  {
    "id": "sent_7",
    "text": "自觉向齐梁以来的梁陈宫体诗风发起冲击。",
    "start": 32.435,
    "end": 36.653,
    "duration": 4.218
  },
  {
    "id": "sent_8",
    "text": "他们反对轻浮虚泛的声色描摹，",
    "start": 36.653,
    "end": 39.856,
    "duration": 3.203
  },
  {
    "id": "sent_9",
    "text": "将诗歌题材从狭小的宫廷台阁与闺房情爱，",
    "start": 39.856,
    "end": 44.479,
    "duration": 4.623
  },
  {
    "id": "sent_10",
    "text": "大幅拓展至广袤壮阔的边塞关山、羁旅离别与身世政治感怀。",
    "start": 44.479,
    "end": 50.495,
    "duration": 6.016
  },
  {
    "id": "sent_11",
    "text": "如杨炯 《从军行》 中 “宁为百夫长，胜作一书生”，",
    "start": 50.495,
    "end": 55.156,
    "duration": 4.661
  },
  {
    "id": "sent_12",
    "text": "展现出投笔从戎、建功立业的昂扬意气；",
    "start": 55.156,
    "end": 59.153,
    "duration": 3.997
  },
  {
    "id": "sent_13",
    "text": "卢照邻 《长安古意》 与骆宾王 《帝京篇》 则开创了宏大繁复的都邑长篇歌行体，",
    "start": 59.154,
    "end": 65.612,
    "duration": 6.458
  },
  {
    "id": "sent_14",
    "text": "熔叙事、抒情与哲理反思于一炉，",
    "start": 65.612,
    "end": 69.245,
    "duration": 3.633
  },
  {
    "id": "sent_15",
    "text": "赋予了唐诗刚健充沛的骨气与昂扬博大的时代气魄。",
    "start": 69.245,
    "end": 74.102,
    "duration": 4.857
  },
  {
    "id": "sent_16",
    "text": "第二，推动五言律诗成熟定型，奠定排律与对仗规范之形式基石。",
    "start": 74.102,
    "end": 80.274,
    "duration": 6.172
  },
  {
    "id": "sent_17",
    "text": "四杰是近体五言律诗体式成熟的决定性奠基者。",
    "start": 80.273,
    "end": 84.869,
    "duration": 4.596
  },
  {
    "id": "sent_18",
    "text": "四杰在五律的声律、粘对、押韵与对仗技巧上进行了严整探索，",
    "start": 84.87,
    "end": 91.185,
    "duration": 6.315
  },
  {
    "id": "sent_19",
    "text": "使律诗彻底摆脱了齐梁永明体音律不谐、结构松散的过渡状态。",
    "start": 91.185,
    "end": 97.227,
    "duration": 6.042
  },
  {
    "id": "sent_20",
    "text": "王勃的 《送杜少府之任蜀州》 全篇声律和美、气韵流转，",
    "start": 97.227,
    "end": 102.513,
    "duration": 5.286
  },
  {
    "id": "sent_21",
    "text": "首联 “城阙辅三秦，风烟望五津” 对仗天衣无缝，",
    "start": 102.513,
    "end": 106.888,
    "duration": 4.375
  },
  {
    "id": "sent_22",
    "text": "颈联 “海内存知己，天涯若比邻” 境界超迈雄浑，",
    "start": 106.888,
    "end": 111.458,
    "duration": 4.57
  },
  {
    "id": "sent_23",
    "text": "成为初唐五言律诗成熟的典范之作；",
    "start": 111.458,
    "end": 114.882,
    "duration": 3.424
  },
  {
    "id": "sent_24",
    "text": "同时四杰大力创制长篇排律，拓展了律诗的篇幅规制与艺术容量。",
    "start": 114.883,
    "end": 121.406,
    "duration": 6.523
  },
  {
    "id": "sent_25",
    "text": "第三，提升士人独立人格地位，",
    "start": 121.406,
    "end": 124.466,
    "duration": 3.06
  },
  {
    "id": "sent_26",
    "text": "实现作家身份从宫廷帮闲向独立文人的跃迁。",
    "start": 124.466,
    "end": 128.984,
    "duration": 4.518
  },
  {
    "id": "sent_27",
    "text": "四杰身处下僚，仕途坎坷，却怀抱自负与抗争精神。",
    "start": 128.984,
    "end": 134.336,
    "duration": 5.352
  },
  {
    "id": "sent_28",
    "text": "他们彻底终结了六朝以来文人依附于权贵宫廷的帮闲地位，",
    "start": 134.336,
    "end": 139.987,
    "duration": 5.651
  },
  {
    "id": "sent_29",
    "text": "在诗歌中直抒寒士不平之鸣，",
    "start": 139.986,
    "end": 143.164,
    "duration": 3.178
  },
  {
    "id": "sent_30",
    "text": "赋予诗歌以强烈的个体主体性与独立人格力量。",
    "start": 143.164,
    "end": 147.851,
    "duration": 4.687
  },
  {
    "id": "sent_31",
    "text": "闻一多在 《唐诗杂论》 中高度评价四杰，",
    "start": 147.851,
    "end": 151.536,
    "duration": 3.685
  },
  {
    "id": "sent_32",
    "text": "指出他们将诗歌从宫廷引入市井旷野，",
    "start": 151.536,
    "end": 155.481,
    "duration": 3.945
  },
  {
    "id": "sent_33",
    "text": "以鲜活生命力为盛唐气象的到来拉开了壮丽序幕。",
    "start": 155.482,
    "end": 160.261,
    "duration": 4.779
  }
]