[
  {
    "id": 1,
    "text": "简述初唐四杰的文学史贡献及其对律诗体式的奠基作用。",
    "start": 0.0,
    "end": 5.285,
    "duration": 5.285
  },
  {
    "id": 2,
    "text": "初唐四杰（王勃、杨炯、卢照邻、",
    "start": 5.285,
    "end": 8.107,
    "duration": 2.822
  },
  {
    "id": 3,
    "text": "骆宾王）是初唐高宗至武后年间诗歌革新的先驱群体，",
    "start": 8.107,
    "end": 13.164,
    "duration": 5.057
  },
  {
    "id": 4,
    "text": "标志着唐诗从六朝绮靡余风走向盛唐昂扬气象的关键转折。",
    "start": 13.164,
    "end": 18.751,
    "duration": 5.587
  },
  {
    "id": 5,
    "text": "四杰在诗坛上的突破性贡献及其对律诗体式的奠基，",
    "start": 18.751,
    "end": 22.855,
    "duration": 4.104
  },
  {
    "id": 6,
    "text": "主要展现为以下三个核心维度：",
    "start": 22.855,
    "end": 25.822,
    "duration": 2.967
  },
  {
    "id": 7,
    "text": "第一，破除齐梁宫体浮靡旧习，拓展诗歌题材题材与骨气力量。",
    "start": 25.822,
    "end": 33.818,
    "duration": 7.996
  },
  {
    "id": 8,
    "text": "四杰在文学观念与创作实践上，",
    "start": 33.818,
    "end": 38.04,
    "duration": 4.222
  },
  {
    "id": 9,
    "text": "自觉向齐梁以来的梁陈宫体诗风发起冲击。",
    "start": 38.04,
    "end": 40.808,
    "duration": 2.768
  },
  {
    "id": 10,
    "text": "他们反对轻浮虚泛的声色描摹，",
    "start": 40.808,
    "end": 43.676,
    "duration": 2.868
  },
  {
    "id": 11,
    "text": "将诗歌题材从狭小的宫廷台阁与闺房情爱，",
    "start": 43.676,
    "end": 48.133,
    "duration": 4.457
  },
  {
    "id": 12,
    "text": "大幅拓展至广袤壮阔的边塞关山、羁旅离别与身世政治感怀。",
    "start": 48.133,
    "end": 54.969,
    "duration": 6.836
  },
  {
    "id": 13,
    "text": "如杨炯 《从军行》 中 “宁为百夫长，胜作一书生”，",
    "start": 54.969,
    "end": 58.813,
    "duration": 3.844
  },
  {
    "id": 14,
    "text": "展现出投笔从戎、建功立业的昂扬意气；",
    "start": 58.813,
    "end": 65.402,
    "duration": 6.589
  },
  {
    "id": 15,
    "text": "卢照邻 《长安古意》 与骆宾王 《帝京篇》 则开创了宏大繁复的都邑长篇歌行体，",
    "start": 65.402,
    "end": 68.515,
    "duration": 3.113
  },
  {
    "id": 16,
    "text": "熔叙事、抒情与哲理反思于一炉，",
    "start": 68.515,
    "end": 73.1,
    "duration": 4.585
  },
  {
    "id": 17,
    "text": "赋予了唐诗刚健充沛的骨气与昂扬博大的时代气魄。",
    "start": 73.1,
    "end": 79.942,
    "duration": 6.842
  },
  {
    "id": 18,
    "text": "第二，推动五言律诗成熟定型，奠定排律与对仗规范之形式基石。",
    "start": 79.942,
    "end": 86.686,
    "duration": 6.744
  },
  {
    "id": 19,
    "text": "四杰是近体五言律诗体式成熟的决定性奠基者。",
    "start": 86.686,
    "end": 91.836,
    "duration": 5.15
  },
  {
    "id": 20,
    "text": "四杰在五律的声律、粘对、押韵与对仗技巧上进行了严整探索，",
    "start": 91.836,
    "end": 98.347,
    "duration": 6.511
  },
  {
    "id": 21,
    "text": "使律诗彻底摆脱了齐梁永明体音律不谐、结构松散的过渡状态。",
    "start": 98.347,
    "end": 103.408,
    "duration": 5.061
  },
  {
    "id": 22,
    "text": "王勃的 《送杜少府之任蜀州》 全篇声律和美、气韵流转，",
    "start": 103.408,
    "end": 109.09,
    "duration": 5.682
  },
  {
    "id": 23,
    "text": "首联 “城阙辅三秦，风烟望五津” 对仗天衣无缝，",
    "start": 109.09,
    "end": 114.468,
    "duration": 5.378
  },
  {
    "id": 24,
    "text": "颈联 “海内存知己，天涯若比邻” 境界超迈雄浑，",
    "start": 114.468,
    "end": 120.141,
    "duration": 5.673
  },
  {
    "id": 25,
    "text": "成为初唐五言律诗成熟的典范之作；",
    "start": 120.141,
    "end": 124.179,
    "duration": 4.038
  },
  {
    "id": 26,
    "text": "同时四杰大力创制长篇排律，",
    "start": 124.179,
    "end": 127.123,
    "duration": 2.944
  },
  {
    "id": 27,
    "text": "拓展了律诗的篇幅规制与艺术容量。",
    "start": 127.123,
    "end": 129.559,
    "duration": 2.436
  },
  {
    "id": 28,
    "text": "第三，提升士人独立人格地位，",
    "start": 129.559,
    "end": 132.004,
    "duration": 2.445
  },
  {
    "id": 29,
    "text": "实现作家身份从宫廷帮闲向独立文人的跃迁。",
    "start": 132.004,
    "end": 136.709,
    "duration": 4.705
  },
  {
    "id": 30,
    "text": "四杰身处下僚，仕途坎坷，却怀抱自负与抗争精神。",
    "start": 136.709,
    "end": 139.54,
    "duration": 2.831
  },
  {
    "id": 31,
    "text": "他们彻底终结了六朝以来文人依附于权贵宫廷的帮闲地位，",
    "start": 139.54,
    "end": 143.42,
    "duration": 3.88
  },
  {
    "id": 32,
    "text": "在诗歌中直抒寒士不平之鸣，",
    "start": 143.42,
    "end": 146.628,
    "duration": 3.208
  },
  {
    "id": 33,
    "text": "赋予诗歌以强烈的个体主体性与独立人格力量。",
    "start": 146.628,
    "end": 150.03,
    "duration": 3.402
  },
  {
    "id": 34,
    "text": "闻一多在 《唐诗杂论》 中高度评价四杰，",
    "start": 150.03,
    "end": 151.464,
    "duration": 1.434
  },
  {
    "id": 35,
    "text": "指出他们将诗歌从宫廷引入市井旷野，",
    "start": 151.464,
    "end": 153.154,
    "duration": 1.69
  },
  {
    "id": 36,
    "text": "以鲜活生命力为盛唐气象的到来拉开了壮丽序幕。",
    "start": 153.154,
    "end": 154.25,
    "duration": 1.096
  }
]