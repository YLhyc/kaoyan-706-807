[
  {
    "id": 1,
    "text": "简述初唐四杰的文学史贡献及其对律诗体式的奠基作用。",
    "start": 0.134,
    "end": 4.346,
    "duration": 4.212
  },
  {
    "id": 2,
    "text": "初唐四杰（王勃、杨炯、卢照邻、骆宾王）是唐高宗至武后时期诗风革新的先驱，",
    "start": 4.983,
    "end": 11.915,
    "duration": 6.932
  },
  {
    "id": 3,
    "text": "标志着唐诗摆脱六朝绮靡余习、走向盛唐气象的关键转折。",
    "start": 12.294,
    "end": 17.306,
    "duration": 5.012
  },
  {
    "id": 4,
    "text": "四杰的文学史贡献与律诗奠基作用，主要体现在以下三个方面：",
    "start": 18.024,
    "end": 28.676,
    "duration": 10.652
  },
  {
    "id": 5,
    "text": "第一，扫除齐梁宫体浮艳旧习，拓展诗歌题材并重振刚健骨气。",
    "start": 29.354,
    "end": 37.326,
    "duration": 7.972
  },
  {
    "id": 6,
    "text": "四杰针对上官体“争构纤微、骨气都尽”的宫廷流弊，",
    "start": 38.044,
    "end": 41.776,
    "duration": 3.732
  },
  {
    "id": 7,
    "text": "提出反对纤巧绮靡、提倡刚健骨气的诗学主张。",
    "start": 42.155,
    "end": 46.527,
    "duration": 4.372
  },
  {
    "id": 8,
    "text": "他们将诗歌题材从狭小的宫廷应制与闺阁吟咏，",
    "start": 47.285,
    "end": 49.697,
    "duration": 2.412
  },
  {
    "id": 9,
    "text": "拓展至市井都邑、边塞军旅、羁旅送别与身世感怀。",
    "start": 50.076,
    "end": 52.968,
    "duration": 2.892
  },
  {
    "id": 10,
    "text": "如杨炯《从军行》以“宁为百夫长，胜作一书生”抒发投笔从戎的昂扬志气；",
    "start": 53.606,
    "end": 58.738,
    "duration": 5.132
  },
  {
    "id": 11,
    "text": "卢照邻《长安古意》与骆宾王《帝京篇》以七言歌行铺写帝京兴衰，",
    "start": 59.267,
    "end": 59.959,
    "duration": 0.692
  },
  {
    "id": 12,
    "text": "夹叙夹议，为初唐诗歌注入了壮大的气势与真挚的悲慨。",
    "start": 60.338,
    "end": 63.75,
    "duration": 3.412
  },
  {
    "id": 13,
    "text": "第二，推动五言律诗趋于定型，推进排律与对仗声律规范。",
    "start": 64.428,
    "end": 69.08,
    "duration": 4.652
  },
  {
    "id": 14,
    "text": "四杰特别是王勃、杨炯，在五言律诗声律与对仗的成熟过程中发挥了重要奠基作用。",
    "start": 69.718,
    "end": 76.77,
    "duration": 7.052
  },
  {
    "id": 15,
    "text": "杨炯现存五律已完全合于近体黏式律，逐步摆脱了齐梁永明体繁琐的病犯束缚与失黏现象。",
    "start": 77.408,
    "end": 84.86,
    "duration": 7.452
  },
  {
    "id": 16,
    "text": "王勃《送杜少府之任蜀州》声律谐畅、对仗工稳，",
    "start": 85.538,
    "end": 88.23,
    "duration": 2.692
  },
  {
    "id": 17,
    "text": "“海内存知己，天涯若比邻”更以开阔高朗的境界洗净了传统送别诗的悲酸儿女态，成为初唐五律名篇；",
    "start": 88.609,
    "end": 95.661,
    "duration": 7.052
  },
  {
    "id": 18,
    "text": "同时四杰还大力创作五言长律，丰富了近体诗的篇制容量。",
    "start": 96.19,
    "end": 97.562,
    "duration": 1.372
  },
  {
    "id": 19,
    "text": "第三，转变诗人身份立场，推动诗歌从宫廷台阁走向寒士抒怀。",
    "start": 98.28,
    "end": 102.852,
    "duration": 4.572
  },
  {
    "id": 20,
    "text": "四杰才高位卑、沉沦下僚，却怀抱功名理想与不甘平庸的自负。",
    "start": 103.49,
    "end": 109.022,
    "duration": 5.532
  },
  {
    "id": 21,
    "text": "他们打破了齐梁以来文人依附宫廷权贵的应制旧习，在诗中直抒寒士不平之鸣与建功立业之志。",
    "start": 109.74,
    "end": 122.752,
    "duration": 13.012
  },
  {
    "id": 22,
    "text": "诚如闻一多在《唐诗杂论》中所指出，四杰使诗境从宫廷台阁走向江山与塞漠，",
    "start": 123.281,
    "end": 129.653,
    "duration": 6.372
  },
  {
    "id": 23,
    "text": "从根本上扭转了贞观以来的台阁风气，与陈子昂、沈宋等人一道，为开元盛唐诗坛的全面繁荣铺平了道路。",
    "start": 130.032,
    "end": 138.809,
    "duration": 8.777
  }
]