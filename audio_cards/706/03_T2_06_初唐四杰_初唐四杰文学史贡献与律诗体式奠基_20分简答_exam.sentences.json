[
  {
    "id": 1,
    "text": "简述初唐四杰的文学史贡献及其对律诗体式的奠基作用。",
    "start": 0.112,
    "end": 4.765,
    "duration": 4.653
  },
  {
    "id": 2,
    "text": "初唐四杰（王勃、杨炯、卢照邻、骆宾王）是唐高宗至武后时期诗风革新的先驱，",
    "start": 5.265,
    "end": 12.651,
    "duration": 7.386
  },
  {
    "id": 3,
    "text": "标志着唐诗摆脱六朝绮靡余习、走向盛唐气象的关键转折。",
    "start": 13.001,
    "end": 18.234,
    "duration": 5.233
  },
  {
    "id": 4,
    "text": "四杰的文学史贡献与律诗奠基作用，主要体现在以下三个方面：",
    "start": 18.734,
    "end": 23.558,
    "duration": 4.824
  },
  {
    "id": 5,
    "text": "第一，扫除齐梁宫体浮艳旧习，拓展诗歌题材并重振刚健骨气。",
    "start": 24.177,
    "end": 29.418,
    "duration": 5.241
  },
  {
    "id": 6,
    "text": "四杰针对上官体“争构纤微、骨气都尽”的宫廷流弊，",
    "start": 29.918,
    "end": 34.06,
    "duration": 4.142
  },
  {
    "id": 7,
    "text": "提出反对纤巧绮靡、提倡刚健骨气的诗学主张。",
    "start": 34.41,
    "end": 38.31,
    "duration": 3.9
  },
  {
    "id": 8,
    "text": "他们将诗歌题材从狭小的宫廷应制与闺阁吟咏，",
    "start": 38.81,
    "end": 42.641,
    "duration": 3.831
  },
  {
    "id": 9,
    "text": "拓展至市井都邑、边塞军旅、羁旅送别与身世感怀。",
    "start": 42.991,
    "end": 47.136,
    "duration": 4.145
  },
  {
    "id": 10,
    "text": "如杨炯《从军行》以“宁为百夫长，胜作一书生”抒发投笔从戎的昂扬志气；",
    "start": 47.636,
    "end": 53.942,
    "duration": 6.306
  },
  {
    "id": 11,
    "text": "卢照邻《长安古意》与骆宾王《帝京篇》以七言歌行铺写帝京兴衰，",
    "start": 54.442,
    "end": 59.69,
    "duration": 5.248
  },
  {
    "id": 12,
    "text": "夹叙夹议，为初唐诗歌注入了壮大的气势与真挚的悲慨。",
    "start": 60.04,
    "end": 64.469,
    "duration": 4.429
  },
  {
    "id": 13,
    "text": "第二，推动五言律诗趋于定型，推进排律与对仗声律规范。",
    "start": 65.046,
    "end": 69.851,
    "duration": 4.805
  },
  {
    "id": 14,
    "text": "四杰特别是王勃、杨炯，在五言律诗声律与对仗的成熟过程中发挥了重要奠基作用。",
    "start": 70.403,
    "end": 77.194,
    "duration": 6.791
  },
  {
    "id": 15,
    "text": "杨炯现存五律已完全合于近体黏式律，逐步摆脱了齐梁永明体繁琐的病犯束缚与失黏现象。",
    "start": 77.847,
    "end": 85.585,
    "duration": 7.738
  },
  {
    "id": 16,
    "text": "王勃《送杜少府之任蜀州》声律谐畅、对仗工稳，",
    "start": 86.085,
    "end": 90.276,
    "duration": 4.191
  },
  {
    "id": 17,
    "text": "“海内存知己，天涯若比邻”更以开阔高朗的境界洗净了传统送别诗的悲酸儿女态，成为初唐五律名篇；",
    "start": 90.626,
    "end": 98.578,
    "duration": 7.952
  },
  {
    "id": 18,
    "text": "同时四杰还大力创作五言长律，丰富了近体诗的篇制容量。",
    "start": 99.078,
    "end": 103.448,
    "duration": 4.37
  },
  {
    "id": 19,
    "text": "第三，转变诗人身份立场，推动诗歌从宫廷台阁走向寒士抒怀。",
    "start": 104.107,
    "end": 110.379,
    "duration": 6.272
  },
  {
    "id": 20,
    "text": "四杰才高位卑、沉沦下僚，却怀抱功名理想与不甘平庸的自负。",
    "start": 110.879,
    "end": 116.618,
    "duration": 5.739
  },
  {
    "id": 21,
    "text": "他们打破了齐梁以来文人依附宫廷权贵的应制旧习，在诗中直抒寒士不平之鸣与建功立业之志。",
    "start": 117.118,
    "end": 126.151,
    "duration": 9.033
  },
  {
    "id": 22,
    "text": "诚如闻一多在《唐诗杂论》中所指出，四杰使诗境从宫廷台阁走向江山与塞漠，",
    "start": 126.651,
    "end": 133.521,
    "duration": 6.87
  },
  {
    "id": 23,
    "text": "从根本上扭转了贞观以来的台阁风气，与陈子昂、沈宋等人一道，为开元盛唐诗坛的全面繁荣铺平了道路。",
    "start": 133.871,
    "end": 142.562,
    "duration": 8.691
  }
]
