[
  {
    "id": "sent_1",
    "text": "初唐四杰（王勃、杨炯、卢照邻、",
    "start": 0.0,
    "end": 3.28,
    "duration": 3.28
  },
  {
    "id": "sent_2",
    "text": "骆宾王）是初唐高宗至武后年间诗歌革新的先驱群体，",
    "start": 3.409,
    "end": 7.969,
    "duration": 4.56
  },
  {
    "id": "sent_3",
    "text": "标志着唐诗从六朝绮靡余风走向盛唐昂扬气象的关键转折。",
    "start": 8.419,
    "end": 13.739,
    "duration": 5.32
  },
  {
    "id": "sent_4",
    "text": "四杰在诗坛上的突破性贡献及其对律诗体式的奠基，",
    "start": 14.189,
    "end": 18.189,
    "duration": 4.0
  },
  {
    "id": "sent_5",
    "text": "主要展现为以下三个核心维度：",
    "start": 18.639,
    "end": 21.039,
    "duration": 2.4
  },
  {
    "id": "sent_6",
    "text": "第一，破除齐梁宫体浮靡旧习，拓展诗歌题材题材与骨气力量。",
    "start": 21.489,
    "end": 26.929,
    "duration": 5.44
  },
  {
    "id": "sent_7",
    "text": "四杰在文学观念与创作实践上，",
    "start": 27.379,
    "end": 29.899,
    "duration": 2.52
  },
  {
    "id": "sent_8",
    "text": "自觉向齐梁以来的梁陈宫体诗风发起冲击。",
    "start": 30.349,
    "end": 33.829,
    "duration": 3.48
  },
  {
    "id": "sent_9",
    "text": "他们反对轻浮虚泛的声色描摹，",
    "start": 34.279,
    "end": 36.919,
    "duration": 2.64
  },
  {
    "id": "sent_10",
    "text": "将诗歌题材从狭小的宫廷台阁与闺房情爱，",
    "start": 37.369,
    "end": 41.169,
    "duration": 3.8
  },
  {
    "id": "sent_11",
    "text": "大幅拓展至广袤壮阔的边塞关山、羁旅离别与身世政治感怀。",
    "start": 41.619,
    "end": 46.739,
    "duration": 5.12
  },
  {
    "id": "sent_12",
    "text": "如杨炯 《从军行》 中 “宁为百夫长，胜作一书生”，",
    "start": 47.229,
    "end": 51.149,
    "duration": 3.92
  },
  {
    "id": "sent_13",
    "text": "展现出投笔从戎、建功立业的昂扬意气；",
    "start": 51.599,
    "end": 54.839,
    "duration": 3.24
  },
  {
    "id": "sent_14",
    "text": "卢照邻 《长安古意》 与骆宾王 《帝京篇》 则开创了宏大繁复的都邑长篇歌行体，",
    "start": 55.289,
    "end": 61.289,
    "duration": 6.0
  },
  {
    "id": "sent_15",
    "text": "熔叙事、抒情与哲理反思于一炉，",
    "start": 61.819,
    "end": 64.779,
    "duration": 2.96
  },
  {
    "id": "sent_16",
    "text": "赋予了唐诗刚健充沛的骨气与昂扬博大的时代气魄。",
    "start": 65.229,
    "end": 69.589,
    "duration": 4.36
  },
  {
    "id": "sent_17",
    "text": "第二，推动五言律诗成熟定型，奠定排律与对仗规范之形式基石。",
    "start": 70.039,
    "end": 75.359,
    "duration": 5.32
  },
  {
    "id": "sent_18",
    "text": "四杰是近体五言律诗体式成熟的决定性奠基者。",
    "start": 75.809,
    "end": 79.569,
    "duration": 3.76
  },
  {
    "id": "sent_19",
    "text": "四杰在五律的声律、粘对、押韵与对仗技巧上进行了严整探索，",
    "start": 80.019,
    "end": 85.179,
    "duration": 5.16
  },
  {
    "id": "sent_20",
    "text": "使律诗彻底摆脱了齐梁永明体音律不谐、结构松散的过渡状态。",
    "start": 85.629,
    "end": 90.909,
    "duration": 5.28
  },
  {
    "id": "sent_21",
    "text": "王勃的 《送杜少府之任蜀州》 全篇声律和美、气韵流转，",
    "start": 91.439,
    "end": 95.839,
    "duration": 4.4
  },
  {
    "id": "sent_22",
    "text": "首联 “城阙辅三秦，风烟望五津” 对仗天衣无缝，",
    "start": 96.289,
    "end": 100.409,
    "duration": 4.12
  },
  {
    "id": "sent_23",
    "text": "颈联 “海内存知己，天涯若比邻” 境界超迈雄浑，",
    "start": 100.859,
    "end": 105.019,
    "duration": 4.16
  },
  {
    "id": "sent_24",
    "text": "成为初唐五言律诗成熟的典范之作；",
    "start": 105.469,
    "end": 108.309,
    "duration": 2.84
  },
  {
    "id": "sent_25",
    "text": "同时四杰大力创制长篇排律，拓展了律诗的篇幅规制与艺术容量。",
    "start": 108.759,
    "end": 113.959,
    "duration": 5.2
  },
  {
    "id": "sent_26",
    "text": "第三，提升士人独立人格地位，",
    "start": 114.409,
    "end": 117.089,
    "duration": 2.68
  },
  {
    "id": "sent_27",
    "text": "实现作家身份从宫廷帮闲向独立文人的跃迁。",
    "start": 117.539,
    "end": 121.459,
    "duration": 3.92
  },
  {
    "id": "sent_28",
    "text": "四杰身处下僚，仕途坎坷，却怀抱自负与抗争精神。",
    "start": 121.909,
    "end": 126.469,
    "duration": 4.56
  },
  {
    "id": "sent_29",
    "text": "他们彻底终结了六朝以来文人依附于权贵宫廷的帮闲地位，",
    "start": 126.919,
    "end": 131.199,
    "duration": 4.28
  },
  {
    "id": "sent_30",
    "text": "在诗歌中直抒寒士不平之鸣，",
    "start": 131.729,
    "end": 134.489,
    "duration": 2.76
  },
  {
    "id": "sent_31",
    "text": "赋予诗歌以强烈的个体主体性与独立人格力量。",
    "start": 134.939,
    "end": 138.659,
    "duration": 3.72
  },
  {
    "id": "sent_32",
    "text": "闻一多在 《唐诗杂论》 中高度评价四杰，",
    "start": 139.109,
    "end": 142.189,
    "duration": 3.08
  },
  {
    "id": "sent_33",
    "text": "指出他们将诗歌从宫廷引入市井旷野，",
    "start": 142.639,
    "end": 145.719,
    "duration": 3.08
  },
  {
    "id": "sent_34",
    "text": "以鲜活生命力为盛唐气象的到来拉开了壮丽序幕。",
    "start": 146.249,
    "end": 150.129,
    "duration": 3.88
  }
]