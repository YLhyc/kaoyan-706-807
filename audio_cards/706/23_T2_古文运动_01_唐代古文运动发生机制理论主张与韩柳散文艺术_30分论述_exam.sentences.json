[
  {
    "id": 1,
    "start": 0.08,
    "end": 3.68,
    "text": "唐代中叶由韩愈、柳宗元倡导的“古文运动”，"
  },
  {
    "id": 2,
    "start": 3.68,
    "end": 8.96,
    "text": "是中国古代散文史上最具变革意义的文体革新与思想复兴思潮。"
  },
  {
    "id": 3,
    "start": 8.96,
    "end": 15.84,
    "text": "运动打着“复古”的旗帜，实质上实现了散文文体从六朝形式至上的骈力束缚中彻底解放，"
  },
  {
    "id": 4,
    "start": 15.84,
    "end": 21.28,
    "text": "建立了文道合一的独立言说体系，奠定了后世中国散文的基本审美规范。"
  },
  {
    "id": 5,
    "start": 21.52,
    "end": 25.84,
    "text": "第一，在历史发生机制上，古文运动是中唐政治危机、"
  },
  {
    "id": 6,
    "start": 25.84,
    "end": 29.68,
    "text": "儒学复兴与文体演进合力催生的历史必然。"
  },
  {
    "id": 7,
    "start": 29.68,
    "end": 33.6,
    "text": "安史之乱后，藩镇割据加剧，宦官专权日甚，"
  },
  {
    "id": 8,
    "start": 33.6,
    "end": 40.0,
    "text": "佛教与道教思想广泛浸染，李唐王朝的中央权威与封建秩序陷入深刻危机。"
  },
  {
    "id": 9,
    "start": 40.0,
    "end": 46.4,
    "text": "面对此种危局，以韩愈、柳宗元为代表的中唐士大夫力图通过复兴儒家道统，"
  },
  {
    "id": 10,
    "start": 46.4,
    "end": 48.32,
    "text": "重构政治伦理与社会秩序。"
  },
  {
    "id": 11,
    "start": 48.64,
    "end": 53.36,
    "text": "而魏晋六朝以来盛行的骈力文体，讲求声律平仄、"
  },
  {
    "id": 12,
    "start": 53.36,
    "end": 61.12,
    "text": "对偶藻饰与用典堆砌，其形式僵化已无法承载现实政治批判与深沉的思想论辨。"
  },
  {
    "id": 13,
    "start": 61.12,
    "end": 65.92,
    "text": "因此，倡导先秦两汉单行流畅、明切适用的“古文”，"
  },
  {
    "id": 14,
    "start": 65.92,
    "end": 71.36,
    "text": "便成为中唐知识阶层以文载道、经世致用的强劲文化武器。"
  },
  {
    "id": 15,
    "start": 71.664,
    "end": 76.224,
    "text": "第二，在理论主张上，古文运动构建了融政治功用、"
  },
  {
    "id": 16,
    "start": 76.224,
    "end": 80.304,
    "text": "思想抒发与语言革新于一体的严密理论系统。"
  },
  {
    "id": 17,
    "start": 80.304,
    "end": 84.544,
    "text": "首先是确立“文以明道”与“文道合一”的核心宗旨。"
  },
  {
    "id": 18,
    "start": 84.544,
    "end": 88.944,
    "text": "韩愈在《原道》中明确将道统归结为尧舜禹汤、"
  },
  {
    "id": 19,
    "start": 88.944,
    "end": 94.864,
    "text": "文武周公孔孟的儒家仁义道德，主张文是阐明儒道的形式载体，"
  },
  {
    "id": 20,
    "start": 94.864,
    "end": 97.104,
    "text": "反对脱离教化的浮艳虚辞。"
  },
  {
    "id": 21,
    "start": 97.504,
    "end": 100.624,
    "text": "其次是提出“不平则鸣”的抒情动力说。"
  },
  {
    "id": 22,
    "start": 100.624,
    "end": 104.944,
    "text": "韩愈在《送孟东野序》中指出，大凡物不得其平则鸣，"
  },
  {
    "id": 23,
    "start": 104.944,
    "end": 109.344,
    "text": "将士人在现实中的沉沦坎坷视为文学创作的深层源泉。"
  },
  {
    "id": 24,
    "start": 109.344,
    "end": 114.544,
    "text": "最后是制定了“唯陈言之务去”与“气盛言宜”的语言美学法则。"
  },
  {
    "id": 25,
    "start": 114.544,
    "end": 118.224,
    "text": "韩愈强调“词必己出”，坚决剔除陈腐套语，"
  },
  {
    "id": 26,
    "start": 118.224,
    "end": 122.864,
    "text": "并在《答李翊书》中指出“气盛则言之短长与声之高下皆宜”，"
  },
  {
    "id": 27,
    "start": 122.864,
    "end": 127.584,
    "text": "将作者充沛的主体道德精神视为驾驭文章音律与句式的根本动力。"
  },
  {
    "id": 28,
    "start": 127.824,
    "end": 132.864,
    "text": "第三，在散文创作艺术上，韩愈与柳宗元各辟蹊径，"
  },
  {
    "id": 29,
    "start": 132.864,
    "end": 136.784,
    "text": "共同拓展了古代散文的审美边界与文体样式。"
  },
  {
    "id": 30,
    "start": 136.784,
    "end": 141.504,
    "text": "韩愈长于议论文的严密论辩与史传文的情感灌注。"
  },
  {
    "id": 31,
    "start": 141.504,
    "end": 145.584,
    "text": "其议论散文如《师说》，以三层对比剖析时弊，"
  },
  {
    "id": 32,
    "start": 145.584,
    "end": 149.744,
    "text": "句式骈散结合，逻辑环环相扣，文气雄肆奔放。"
  },
  {
    "id": 33,
    "start": 150.064,
    "end": 155.504,
    "text": "其传记文如《张中丞传后序》，借南计云拔刀断指等动人细节，"
  },
  {
    "id": 34,
    "start": 155.504,
    "end": 160.224,
    "text": "刻画出壮烈殉国的英雄气概，兼具史家严谨与小说生动。"
  },
  {
    "id": 35,
    "start": 160.224,
    "end": 164.864,
    "text": "其抒情散文《祭十二郎文》则以家常语倾泻肺腑真情，"
  },
  {
    "id": 36,
    "start": 164.864,
    "end": 169.424,
    "text": "“字字是血，字字是泪”，创造了叙事抒情散文的极高境界。"
  },
  {
    "id": 37,
    "start": 169.664,
    "end": 173.744,
    "text": "柳宗元则在贬哲永州、柳州的幽囚境遇中，"
  },
  {
    "id": 38,
    "start": 173.744,
    "end": 177.504,
    "text": "开拓出山水游记与寓言散文的新境界。"
  },
  {
    "id": 39,
    "start": 177.504,
    "end": 181.744,
    "text": "其《永州八记》如《小石潭记》，语言冷峻峻洁，"
  },
  {
    "id": 40,
    "start": 181.744,
    "end": 186.624,
    "text": "以“潭中鱼可百许头，皆若空游无所依”的白描神笔，"
  },
  {
    "id": 41,
    "start": 186.624,
    "end": 190.384,
    "text": "借清冷景物折射自身孤寂高洁的贬哲心境。"
  },
  {
    "id": 42,
    "start": 190.784,
    "end": 193.824,
    "text": "其寓言散文如《三戒》与《捕蛇者说》，"
  },
  {
    "id": 43,
    "start": 193.824,
    "end": 198.464,
    "text": "以小见大，借黔之驴的虚骄与苛政猛于虎的残酷现实，"
  },
  {
    "id": 44,
    "start": 198.464,
    "end": 201.344,
    "text": "展现出极强的讽刺艺术与批判力量。"
  },
  {
    "id": 45,
    "start": 201.344,
    "end": 205.184,
    "text": "综上所述，唐代古文运动以儒家道统为灵魂，"
  },
  {
    "id": 46,
    "start": 205.184,
    "end": 208.624,
    "text": "以散体文法为骨骼，以韩柳名作为血肉，"
  },
  {
    "id": 47,
    "start": 208.624,
    "end": 211.984,
    "text": "彻底扭转了骈丽文风一统天下的僵化格局。"
  },
  {
    "id": 48,
    "start": 212.304,
    "end": 215.504,
    "text": "它不仅在唐代实现了文体的空前解放，"
  },
  {
    "id": 49,
    "start": 215.504,
    "end": 219.264,
    "text": "更经由宋代欧阳修、苏轼等人的接续发扬，"
  },
  {
    "id": 50,
    "start": 219.264,
    "end": 222.784,
    "text": "构筑了中国古代散文延绵千年的正统脉络。"
  }
]