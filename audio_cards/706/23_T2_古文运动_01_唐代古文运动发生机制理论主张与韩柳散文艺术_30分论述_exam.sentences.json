[
  {
    "id": 1,
    "text": "题型，三十分论述题。",
    "start": 0.08,
    "end": 1.78,
    "duration": 1.7
  },
  {
    "id": 2,
    "text": "分值，三十分。",
    "start": 1.78,
    "end": 2.822,
    "duration": 1.042
  },
  {
    "id": 3,
    "text": "建议考场时间，三十五分钟。",
    "start": 2.822,
    "end": 5.116,
    "duration": 2.294
  },
  {
    "id": 4,
    "text": "目标字数，一千一百五十到一千三百字。",
    "start": 5.116,
    "end": 8.452,
    "duration": 3.336
  },
  {
    "id": 5,
    "text": "答题骨架，文体变革定性、趋近于、",
    "start": 8.452,
    "end": 11.163,
    "duration": 2.711
  },
  {
    "id": 6,
    "text": "历史发生机制剖析、趋近于、核心理论主张构建、",
    "start": 11.163,
    "end": 15.124,
    "duration": 3.961
  },
  {
    "id": 7,
    "text": "趋近于、韩柳散文艺术独创成就、趋近于、",
    "start": 15.124,
    "end": 18.46,
    "duration": 3.336
  },
  {
    "id": 8,
    "text": "宏观文学史总结。",
    "start": 18.46,
    "end": 19.92,
    "duration": 1.46
  },
  {
    "id": 9,
    "text": "唐代中叶由韩愈、柳宗元倡导的“古文运动”，",
    "start": 20.08,
    "end": 23.68,
    "duration": 3.6
  },
  {
    "id": 10,
    "text": "是中国古代散文史上最具变革意义的文体革新与思想复兴思潮。",
    "start": 23.68,
    "end": 28.96,
    "duration": 5.28
  },
  {
    "id": 11,
    "text": "运动打着“复古”的旗帜，实质上实现了散文文体从六朝形式至上的骈力束缚中彻底解放，",
    "start": 28.96,
    "end": 35.84,
    "duration": 6.88
  },
  {
    "id": 12,
    "text": "建立了文道合一的独立言说体系，奠定了后世中国散文的基本审美规范。",
    "start": 35.84,
    "end": 41.28,
    "duration": 5.44
  },
  {
    "id": 13,
    "text": "第一，在历史发生机制上，古文运动是中唐政治危机、",
    "start": 41.52,
    "end": 45.84,
    "duration": 4.32
  },
  {
    "id": 14,
    "text": "儒学复兴与文体演进合力催生的历史必然。",
    "start": 45.84,
    "end": 49.68,
    "duration": 3.84
  },
  {
    "id": 15,
    "text": "安史之乱后，藩镇割据加剧，宦官专权日甚，",
    "start": 49.68,
    "end": 53.6,
    "duration": 3.92
  },
  {
    "id": 16,
    "text": "佛教与道教思想广泛浸染，李唐王朝的中央权威与封建秩序陷入深刻危机。",
    "start": 53.6,
    "end": 60.0,
    "duration": 6.4
  },
  {
    "id": 17,
    "text": "面对此种危局，以韩愈、柳宗元为代表的中唐士大夫力图通过复兴儒家道统，",
    "start": 60.0,
    "end": 66.4,
    "duration": 6.4
  },
  {
    "id": 18,
    "text": "重构政治伦理与社会秩序。",
    "start": 66.4,
    "end": 68.32,
    "duration": 1.92
  },
  {
    "id": 19,
    "text": "而魏晋六朝以来盛行的骈力文体，讲求声律平仄、",
    "start": 68.64,
    "end": 73.36,
    "duration": 4.72
  },
  {
    "id": 20,
    "text": "对偶藻饰与用典堆砌，其形式僵化已无法承载现实政治批判与深沉的思想论辨。",
    "start": 73.36,
    "end": 81.12,
    "duration": 7.76
  },
  {
    "id": 21,
    "text": "因此，倡导先秦两汉单行流畅、明切适用的“古文”，",
    "start": 81.12,
    "end": 85.92,
    "duration": 4.8
  },
  {
    "id": 22,
    "text": "便成为中唐知识阶层以文载道、经世致用的强劲文化武器。",
    "start": 85.92,
    "end": 91.36,
    "duration": 5.44
  },
  {
    "id": 23,
    "text": "第二，在理论主张上，古文运动构建了融政治功用、",
    "start": 91.664,
    "end": 96.224,
    "duration": 4.56
  },
  {
    "id": 24,
    "text": "思想抒发与语言革新于一体的严密理论系统。",
    "start": 96.224,
    "end": 100.304,
    "duration": 4.08
  },
  {
    "id": 25,
    "text": "首先是确立“文以明道”与“文道合一”的核心宗旨。",
    "start": 100.304,
    "end": 104.544,
    "duration": 4.24
  },
  {
    "id": 26,
    "text": "韩愈在《原道》中明确将道统归结为尧舜禹汤、",
    "start": 104.544,
    "end": 108.944,
    "duration": 4.4
  },
  {
    "id": 27,
    "text": "文武周公孔孟的儒家仁义道德，主张文是阐明儒道的形式载体，",
    "start": 108.944,
    "end": 114.864,
    "duration": 5.92
  },
  {
    "id": 28,
    "text": "反对脱离教化的浮艳虚辞。",
    "start": 114.864,
    "end": 117.104,
    "duration": 2.24
  },
  {
    "id": 29,
    "text": "其次是提出“不平则鸣”的抒情动力说。",
    "start": 117.504,
    "end": 120.624,
    "duration": 3.12
  },
  {
    "id": 30,
    "text": "韩愈在《送孟东野序》中指出，大凡物不得其平则鸣，",
    "start": 120.624,
    "end": 124.944,
    "duration": 4.32
  },
  {
    "id": 31,
    "text": "将士人在现实中的沉沦坎坷视为文学创作的深层源泉。",
    "start": 124.944,
    "end": 129.344,
    "duration": 4.4
  },
  {
    "id": 32,
    "text": "最后是制定了“唯陈言之务去”与“气盛言宜”的语言美学法则。",
    "start": 129.344,
    "end": 134.544,
    "duration": 5.2
  },
  {
    "id": 33,
    "text": "韩愈强调“词必己出”，坚决剔除陈腐套语，",
    "start": 134.544,
    "end": 138.224,
    "duration": 3.68
  },
  {
    "id": 34,
    "text": "并在《答李翊书》中指出“气盛则言之短长与声之高下皆宜”，",
    "start": 138.224,
    "end": 142.864,
    "duration": 4.64
  },
  {
    "id": 35,
    "text": "将作者充沛的主体道德精神视为驾驭文章音律与句式的根本动力。",
    "start": 142.864,
    "end": 147.584,
    "duration": 4.72
  },
  {
    "id": 36,
    "text": "第三，在散文创作艺术上，韩愈与柳宗元各辟蹊径，",
    "start": 147.824,
    "end": 152.864,
    "duration": 5.04
  },
  {
    "id": 37,
    "text": "共同拓展了古代散文的审美边界与文体样式。",
    "start": 152.864,
    "end": 156.784,
    "duration": 3.92
  },
  {
    "id": 38,
    "text": "韩愈长于议论文的严密论辩与史传文的情感灌注。",
    "start": 156.784,
    "end": 161.504,
    "duration": 4.72
  },
  {
    "id": 39,
    "text": "其议论散文如《师说》，以三层对比剖析时弊，",
    "start": 161.504,
    "end": 165.584,
    "duration": 4.08
  },
  {
    "id": 40,
    "text": "句式骈散结合，逻辑环环相扣，文气雄肆奔放。",
    "start": 165.584,
    "end": 169.744,
    "duration": 4.16
  },
  {
    "id": 41,
    "text": "其传记文如《张中丞传后序》，借南计云拔刀断指等动人细节，",
    "start": 170.064,
    "end": 175.504,
    "duration": 5.44
  },
  {
    "id": 42,
    "text": "刻画出壮烈殉国的英雄气概，兼具史家严谨与小说生动。",
    "start": 175.504,
    "end": 180.224,
    "duration": 4.72
  },
  {
    "id": 43,
    "text": "其抒情散文《祭十二郎文》则以家常语倾泻肺腑真情，",
    "start": 180.224,
    "end": 184.864,
    "duration": 4.64
  },
  {
    "id": 44,
    "text": "“字字是血，字字是泪”，创造了叙事抒情散文的极高境界。",
    "start": 184.864,
    "end": 189.424,
    "duration": 4.56
  },
  {
    "id": 45,
    "text": "柳宗元则在贬哲永州、柳州的幽囚境遇中，",
    "start": 189.664,
    "end": 193.744,
    "duration": 4.08
  },
  {
    "id": 46,
    "text": "开拓出山水游记与寓言散文的新境界。",
    "start": 193.744,
    "end": 197.504,
    "duration": 3.76
  },
  {
    "id": 47,
    "text": "其《永州八记》如《小石潭记》，语言冷峻峻洁，",
    "start": 197.504,
    "end": 201.744,
    "duration": 4.24
  },
  {
    "id": 48,
    "text": "以“潭中鱼可百许头，皆若空游无所依”的白描神笔，",
    "start": 201.744,
    "end": 206.624,
    "duration": 4.88
  },
  {
    "id": 49,
    "text": "借清冷景物折射自身孤寂高洁的贬哲心境。",
    "start": 206.624,
    "end": 210.384,
    "duration": 3.76
  },
  {
    "id": 50,
    "text": "其寓言散文如《三戒》与《捕蛇者说》，",
    "start": 210.784,
    "end": 213.824,
    "duration": 3.04
  },
  {
    "id": 51,
    "text": "以小见大，借黔之驴的虚骄与苛政猛于虎的残酷现实，",
    "start": 213.824,
    "end": 218.464,
    "duration": 4.64
  },
  {
    "id": 52,
    "text": "展现出极强的讽刺艺术与批判力量。",
    "start": 218.464,
    "end": 221.344,
    "duration": 2.88
  },
  {
    "id": 53,
    "text": "综上所述，唐代古文运动以儒家道统为灵魂，",
    "start": 221.344,
    "end": 225.184,
    "duration": 3.84
  },
  {
    "id": 54,
    "text": "以散体文法为骨骼，以韩柳名作为血肉，",
    "start": 225.184,
    "end": 228.624,
    "duration": 3.44
  },
  {
    "id": 55,
    "text": "彻底扭转了骈丽文风一统天下的僵化格局。",
    "start": 228.624,
    "end": 231.984,
    "duration": 3.36
  },
  {
    "id": 56,
    "text": "它不仅在唐代实现了文体的空前解放，",
    "start": 232.304,
    "end": 235.504,
    "duration": 3.2
  },
  {
    "id": 57,
    "text": "更经由宋代欧阳修、苏轼等人的接续发扬，",
    "start": 235.504,
    "end": 239.264,
    "duration": 3.76
  },
  {
    "id": 58,
    "text": "构筑了中国古代散文延绵千年的正统脉络。",
    "start": 239.264,
    "end": 242.784,
    "duration": 3.52
  }
]