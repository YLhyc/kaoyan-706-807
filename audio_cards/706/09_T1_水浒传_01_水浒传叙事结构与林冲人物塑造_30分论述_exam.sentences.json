[
  {
    "id": 1,
    "text": "为了开篇直击考点要害并确立学术基调，",
    "start": 0.08,
    "end": 3.28,
    "duration": 3.2
  },
  {
    "id": 2,
    "text": "第一句必须给出小说在体裁史上的开创性地位与金圣叹的权威定评。",
    "start": 3.28,
    "end": 9.2,
    "duration": 5.92
  },
  {
    "id": 3,
    "text": "所以表述为：《水浒传》是中国文学史上第一部描写农民起义历程的长篇白话小说，",
    "start": 9.2,
    "end": 15.92,
    "duration": 6.72
  },
  {
    "id": 4,
    "text": "明末清初评点家金圣叹在《读第五才子书法》中盛赞其塑造英雄“人有其性情，",
    "start": 15.92,
    "end": 22.88,
    "duration": 6.96
  },
  {
    "id": 5,
    "text": "人有其气质”。",
    "start": 22.88,
    "end": 23.92,
    "duration": 1.04
  },
  {
    "id": 6,
    "text": "紧接着必须点明全书的核心思想主题，",
    "start": 24.16,
    "end": 27.6,
    "duration": 3.44
  },
  {
    "id": 7,
    "text": "说明起义爆发的根本社会根源。",
    "start": 27.6,
    "end": 30.0,
    "duration": 2.4
  },
  {
    "id": 8,
    "text": "所以表述为：全书深刻揭示出“乱自上作，",
    "start": 30.0,
    "end": 33.6,
    "duration": 3.6
  },
  {
    "id": 9,
    "text": "官逼民反”的社会历史本质。",
    "start": 33.6,
    "end": 35.84,
    "duration": 2.24
  },
  {
    "id": 10,
    "text": "随后必须立即引入题目所指涉的叙事结构特色，",
    "start": 35.84,
    "end": 39.36,
    "duration": 3.52
  },
  {
    "id": 11,
    "text": "指出链式叙事的独创贡献。",
    "start": 39.36,
    "end": 41.12,
    "duration": 1.76
  },
  {
    "id": 12,
    "text": "所以表述为：在艺术表现上，施耐庵创造性地构建了环环相扣的链式叙事网络。",
    "start": 41.52,
    "end": 48.312,
    "duration": 6.792
  },
  {
    "id": 13,
    "text": "最后一句必须将结构引渡至核心人物林冲身上，",
    "start": 48.312,
    "end": 52.591,
    "duration": 4.279
  },
  {
    "id": 14,
    "text": "确立其性格动态发展在中国文学人物史上的巅峰地位。",
    "start": 52.591,
    "end": 57.512,
    "duration": 4.921
  },
  {
    "id": 15,
    "text": "所以表述为：林冲作为全书塑造最为深刻的典型人物，",
    "start": 57.512,
    "end": 62.218,
    "duration": 4.706
  },
  {
    "id": 16,
    "text": "其从安分守己到决然反抗的动态轨迹，",
    "start": 62.218,
    "end": 65.641,
    "duration": 3.423
  },
  {
    "id": 17,
    "text": "成为中国古典叙事文学中性格刻画的巅峰典范。",
    "start": 65.641,
    "end": 69.92,
    "duration": 4.279
  },
  {
    "id": 18,
    "text": "本段用四句话完成全篇破题：首句给出长篇白话起义小说鼻祖地位与金圣叹名评，",
    "start": 70.0,
    "end": 77.36,
    "duration": 7.36
  },
  {
    "id": 19,
    "text": "次句标举官逼民反社会本质，第三四句迅速聚焦链式叙事与林冲性格演进，",
    "start": 77.36,
    "end": 84.32,
    "duration": 6.96
  },
  {
    "id": 20,
    "text": "结构严密，立论铿枪。",
    "start": 84.32,
    "end": 86.32,
    "duration": 2.0
  },
  {
    "id": 21,
    "text": "所以本段具体答题完整版为：《水浒传》是中国文学史上第一部描写农民起义历程的长篇白话小说，",
    "start": 86.32,
    "end": 94.48,
    "duration": 8.16
  },
  {
    "id": 22,
    "text": "明末清初评点家金圣叹在《读第五才子书法》中盛赞其塑造英雄“人有其性情，",
    "start": 94.48,
    "end": 101.52,
    "duration": 7.04
  },
  {
    "id": 23,
    "text": "人有其气质”。",
    "start": 101.52,
    "end": 102.56,
    "duration": 1.04
  },
  {
    "id": 24,
    "text": "全书深刻揭示出“乱自上作，官逼民反”的社会历史本质。",
    "start": 102.88,
    "end": 107.44,
    "duration": 4.56
  },
  {
    "id": 25,
    "text": "在艺术表现上，施耐庵创造性地构建了环环相扣的链式叙事网络。",
    "start": 107.44,
    "end": 112.72,
    "duration": 5.28
  },
  {
    "id": 26,
    "text": "林冲作为全书塑造最为深刻的典型人物，",
    "start": 112.72,
    "end": 116.0,
    "duration": 3.28
  },
  {
    "id": 27,
    "text": "其从安分守己到决然反抗的动态轨迹，",
    "start": 116.0,
    "end": 119.52,
    "duration": 3.52
  },
  {
    "id": 28,
    "text": "成为中国古典叙事文学中性格刻画的巅峰典范。--",
    "start": 119.52,
    "end": 123.36,
    "duration": 3.84
  }
]