[
  {
    "id": 1,
    "text": "篇头：全题宏观破题与立论逻辑。",
    "start": 0.08,
    "end": 3.36,
    "duration": 3.28
  },
  {
    "id": 2,
    "text": "问题一：这道题到底在问什么？。",
    "start": 3.36,
    "end": 6.24,
    "duration": 2.88
  },
  {
    "id": 3,
    "text": "这道题考查陶渊明田园诗的“艺术特色”与“文化品格”。",
    "start": 6.24,
    "end": 10.48,
    "duration": 4.24
  },
  {
    "id": 4,
    "text": "在考场上，考生绝对不能把艺术形式与文化精神割裂开来。",
    "start": 10.48,
    "end": 15.2,
    "duration": 4.72
  },
  {
    "id": 5,
    "text": "必须说明陶渊明选择归隐与田园题材并非逃避消极，",
    "start": 15.2,
    "end": 20.08,
    "duration": 4.88
  },
  {
    "id": 6,
    "text": "而是其崇尚任真的文化品格在文学形式上的必然投射。",
    "start": 20.08,
    "end": 24.72,
    "duration": 4.64
  },
  {
    "id": 7,
    "text": "问题二：宏观立论核心指向哪里？。",
    "start": 25.04,
    "end": 28.0,
    "duration": 2.96
  },
  {
    "id": 8,
    "text": "立论核心必须紧扣钟融《诗品》对其“古今隐逸诗人之宗”的定评，",
    "start": 28.0,
    "end": 33.44,
    "duration": 5.44
  },
  {
    "id": 9,
    "text": "以及苏轼对其诗风“质而企，真且醇”的经典论断。",
    "start": 33.44,
    "end": 37.68,
    "duration": 4.24
  },
  {
    "id": 10,
    "text": "阐明他开创田园诗体不仅实现了题材的划时代革命，",
    "start": 37.68,
    "end": 42.0,
    "duration": 4.32
  },
  {
    "id": 11,
    "text": "更重构了中国古代士人的精神生态。",
    "start": 42.0,
    "end": 44.56,
    "duration": 2.56
  },
  {
    "id": 12,
    "text": "问题三：由浅入深拆解为哪几个答题维度？。",
    "start": 44.88,
    "end": 48.8,
    "duration": 3.92
  },
  {
    "id": 13,
    "text": "本题按文学生成机制拆解为四个层层递进的逻辑维度：第一维度，",
    "start": 48.8,
    "end": 54.24,
    "duration": 5.44
  },
  {
    "id": 14,
    "text": "身世抉择与文化品格定性，由东晋乱世中不为五斗米折腰的任真风骨切入。",
    "start": 54.24,
    "end": 61.12,
    "duration": 6.88
  },
  {
    "id": 15,
    "text": "第二维度，题材开拓，打破贵族山水游赏与耻言耕稼传统，",
    "start": 61.12,
    "end": 66.24,
    "duration": 5.12
  },
  {
    "id": 16,
    "text": "将躬耕劳作提升为审美对象。",
    "start": 66.24,
    "end": 68.56,
    "duration": 2.32
  },
  {
    "id": 17,
    "text": "第三维度，艺术风格，追求平淡自然与语言真淳，",
    "start": 68.8,
    "end": 72.8,
    "duration": 4.0
  },
  {
    "id": 18,
    "text": "呈现绚烂至极归于平淡的美学特质。",
    "start": 72.8,
    "end": 75.68,
    "duration": 2.88
  },
  {
    "id": 19,
    "text": "第四维度，哲思境界与意象提炼，情景理高度融彻，",
    "start": 75.68,
    "end": 79.92,
    "duration": 4.24
  },
  {
    "id": 20,
    "text": "将老庄名理化为意象静观，达到物我两忘。",
    "start": 79.92,
    "end": 83.68,
    "duration": 3.76
  },
  {
    "id": 21,
    "text": "第五维度，文学史价值，承前启后，",
    "start": 83.68,
    "end": 86.56,
    "duration": 2.88
  },
  {
    "id": 22,
    "text": "直接滋养唐宋田园流派并确立士大夫退守心灵的精神范式。",
    "start": 86.56,
    "end": 91.04,
    "duration": 4.48
  },
  {
    "id": 23,
    "text": "问题四：各维度之间具备怎样不可逆的递进因果链条？。",
    "start": 91.28,
    "end": 95.68,
    "duration": 4.4
  },
  {
    "id": 24,
    "text": "第一步必须先由时代与身世切入确立文化品格的根基。",
    "start": 95.68,
    "end": 100.16,
    "duration": 4.48
  },
  {
    "id": 25,
    "text": "第二步说明这种品格直接逼出田园农耕这一全新题材。",
    "start": 100.16,
    "end": 104.88,
    "duration": 4.72
  },
  {
    "id": 26,
    "text": "第三步阐述全新题材必然要求洗尽铅华的平淡自然语言。",
    "start": 104.88,
    "end": 109.92,
    "duration": 5.04
  },
  {
    "id": 27,
    "text": "第四步由外在语言生活自然上升到内在精神哲思的超越境界。",
    "start": 109.92,
    "end": 114.8,
    "duration": 4.88
  },
  {
    "id": 28,
    "text": "第五步将个人创造推演至文学史长河，",
    "start": 115.04,
    "end": 118.64,
    "duration": 3.6
  },
  {
    "id": 29,
    "text": "完成对后世山水田园流派与士人人格滋养的历史闭环。",
    "start": 118.64,
    "end": 123.84,
    "duration": 5.2
  },
  {
    "id": 30,
    "text": "--。第",
    "start": 123.84,
    "end": 124.0,
    "duration": 0.16
  },
  {
    "id": 31,
    "text": "一部分：破题立论与文化品格定性。",
    "start": 124.0,
    "end": 127.04,
    "duration": 3.04
  },
  {
    "id": 32,
    "text": "逐句因果推导与答题表述。",
    "start": 127.04,
    "end": 129.68,
    "duration": 2.64
  },
  {
    "id": 33,
    "text": "为了在一开篇就牢牢锚定考点核心并展示深厚的文学史素养，",
    "start": 129.68,
    "end": 135.12,
    "duration": 5.44
  },
  {
    "id": 34,
    "text": "第一句话必须首先给出陶渊明在文学史上的绝对地位与权威历史评语。",
    "start": 135.12,
    "end": 141.12,
    "duration": 6.0
  },
  {
    "id": 35,
    "text": "所以表述为：陶渊明是中国文学史上第一位开辟田园诗派的伟大诗人，",
    "start": 141.424,
    "end": 147.184,
    "duration": 5.76
  },
  {
    "id": 36,
    "text": "被钟融《诗品》尊为“古今隐逸诗人之宗”。。",
    "start": 147.184,
    "end": 150.864,
    "duration": 3.68
  },
  {
    "id": 37,
    "text": "紧接着必须讲明陶渊明归隐的时代土壤与生命抉择，",
    "start": 150.864,
    "end": 154.944,
    "duration": 4.08
  },
  {
    "id": 38,
    "text": "说明其文化品格形成的深刻政治动因。",
    "start": 154.944,
    "end": 158.144,
    "duration": 3.2
  },
  {
    "id": 39,
    "text": "所以表述为：在东晋门阀垄断与晋宋易代的剧烈动荡中，",
    "start": 158.144,
    "end": 162.864,
    "duration": 4.72
  },
  {
    "id": 40,
    "text": "陶渊明历经数次出仕与归隐，最终彻底勘破官场伪饰。。",
    "start": 162.864,
    "end": 167.504,
    "duration": 4.64
  },
  {
    "id": 41,
    "text": "随后需要引入标志性历史细节与士人风骨誓言，",
    "start": 167.824,
    "end": 172.224,
    "duration": 4.4
  },
  {
    "id": 42,
    "text": "生动展现其独立人格的挺立。",
    "start": 172.224,
    "end": 174.704,
    "duration": 2.48
  },
  {
    "id": 43,
    "text": "所以表述为：他发出“岂能为五斗米折腰向乡里小儿”的绝决誓言，",
    "start": 174.704,
    "end": 180.784,
    "duration": 6.08
  },
  {
    "id": 44,
    "text": "毅然解授归田。。",
    "start": 180.784,
    "end": 182.464,
    "duration": 1.68
  },
  {
    "id": 45,
    "text": "接下来要引申出陶渊明自我人格的核心哲学定义，",
    "start": 182.464,
    "end": 186.544,
    "duration": 4.08
  },
  {
    "id": 46,
    "text": "揭示其顺从天性的思想本源。",
    "start": 186.544,
    "end": 188.864,
    "duration": 2.32
  },
  {
    "id": 47,
    "text": "所以表述为：陶渊明将“质性自然，",
    "start": 189.264,
    "end": 192.544,
    "duration": 3.28
  },
  {
    "id": 48,
    "text": "非矫厉所得”的生命意志与乡村天地完全融为一体。。",
    "start": 192.544,
    "end": 197.184,
    "duration": 4.64
  },
  {
    "id": 49,
    "text": "确立了时代与人生抉择之后，尾句需要从文学题材突破与士人精神重构两个宏观向度统摄全篇论点。",
    "start": 197.184,
    "end": 206.464,
    "duration": 9.28
  },
  {
    "id": 50,
    "text": "所以表述为：他的田园诗不仅实现了中古诗歌题材的革命性突破，",
    "start": 206.464,
    "end": 211.824,
    "duration": 5.36
  },
  {
    "id": 51,
    "text": "更铸就了安贫乐道、任真自得的魏晋士人文化品格，",
    "start": 211.824,
    "end": 216.464,
    "duration": 4.64
  },
  {
    "id": 52,
    "text": "确立了中国士大夫阶层精神心灵的永恒归宿。。",
    "start": 216.464,
    "end": 220.384,
    "duration": 3.92
  },
  {
    "id": 53,
    "text": "本段答题思路总结。",
    "start": 220.624,
    "end": 222.144,
    "duration": 1.52
  },
  {
    "id": 54,
    "text": "本段用五句话完成全篇破题立论：首句亮出田园诗开派宗师地位与钟融权威评定，",
    "start": 222.144,
    "end": 229.504,
    "duration": 7.36
  },
  {
    "id": 55,
    "text": "次句指出门阀政治与归隐抉择，第三四句通过不折腰誓言与质性自然剖析其独立人格，",
    "start": 229.504,
    "end": 237.344,
    "duration": 7.84
  },
  {
    "id": 56,
    "text": "末句从题材革命与文化品格两端完成立论总括，",
    "start": 237.344,
    "end": 241.264,
    "duration": 3.92
  },
  {
    "id": 57,
    "text": "为后文具体维度的展开确立了清晰的答题主线。",
    "start": 241.264,
    "end": 244.944,
    "duration": 3.68
  },
  {
    "id": 58,
    "text": "所以本段具体答题完整版为：陶渊明是中国文学史上第一位开辟田园诗派的伟大诗人，",
    "start": 245.264,
    "end": 252.144,
    "duration": 6.88
  },
  {
    "id": 59,
    "text": "被钟融《诗品》尊为“古今隐逸诗人之宗”。",
    "start": 252.144,
    "end": 255.824,
    "duration": 3.68
  },
  {
    "id": 60,
    "text": "在东晋门阀垄断与晋宋易代的剧烈动荡中，",
    "start": 255.824,
    "end": 259.664,
    "duration": 3.84
  },
  {
    "id": 61,
    "text": "陶渊明历经数次出仕与归隐，最终彻底勘破官场伪饰。",
    "start": 259.664,
    "end": 264.464,
    "duration": 4.8
  },
  {
    "id": 62,
    "text": "他发出“岂能为五斗米折腰向乡里小儿”的绝决誓言，",
    "start": 264.704,
    "end": 269.984,
    "duration": 5.28
  },
  {
    "id": 63,
    "text": "毅然解授归田。",
    "start": 269.984,
    "end": 271.744,
    "duration": 1.76
  },
  {
    "id": 64,
    "text": "陶渊明将“质性自然，非矫厉所得”的生命意志与乡村天地完全融为一体。",
    "start": 271.744,
    "end": 279.184,
    "duration": 7.44
  },
  {
    "id": 65,
    "text": "他的田园诗不仅实现了中古诗歌题材的革命性突破，",
    "start": 279.184,
    "end": 283.664,
    "duration": 4.48
  },
  {
    "id": 66,
    "text": "更铸就了安贫乐道、任真自得的魏晋士人文化品格，",
    "start": 283.664,
    "end": 288.544,
    "duration": 4.88
  },
  {
    "id": 67,
    "text": "确立了中国士大夫阶层精神心灵的永恒归宿。--",
    "start": 288.544,
    "end": 292.544,
    "duration": 4.0
  },
  {
    "id": 68,
    "text": "第二部分：题材开拓与躬耕劳作的生活图景。",
    "start": 292.928,
    "end": 296.688,
    "duration": 3.76
  },
  {
    "id": 69,
    "text": "逐句因果推导与答题表述。",
    "start": 296.688,
    "end": 299.168,
    "duration": 2.48
  },
  {
    "id": 70,
    "text": "进入具体论述的第一层，必须从诗歌最表层的题材切入，",
    "start": 299.168,
    "end": 303.728,
    "duration": 4.56
  },
  {
    "id": 71,
    "text": "阐明陶渊明对以往贵族诗歌传统的重大突破。",
    "start": 303.728,
    "end": 307.728,
    "duration": 4.0
  },
  {
    "id": 72,
    "text": "所以表述为：首先，陶渊明打破了汉魏以来贵族文人耻言耕稼的诗学传统，",
    "start": 307.728,
    "end": 313.968,
    "duration": 6.24
  },
  {
    "id": 73,
    "text": "在题材上完成了对平凡田园劳作的深情开拓。。",
    "start": 313.968,
    "end": 317.488,
    "duration": 3.52
  },
  {
    "id": 74,
    "text": "为了显示学术深度，第二句可以通过与同时代谢灵运山水诗的鲜明对比，",
    "start": 317.728,
    "end": 323.888,
    "duration": 6.16
  },
  {
    "id": 75,
    "text": "精准界定陶诗立足土地的根本特质。",
    "start": 323.888,
    "end": 327.488,
    "duration": 3.6
  },
  {
    "id": 76,
    "text": "所以表述为：谢灵运山水诗多描绘贵族游赏之景，",
    "start": 327.488,
    "end": 332.448,
    "duration": 4.96
  },
  {
    "id": 77,
    "text": "陶渊明则将视线投向大地本身的生产劳作。。",
    "start": 332.448,
    "end": 336.448,
    "duration": 4.0
  },
  {
    "id": 78,
    "text": "接着具体展开陶诗所包含的田园生活图景的各个具体侧面，",
    "start": 336.448,
    "end": 341.408,
    "duration": 4.96
  },
  {
    "id": 79,
    "text": "指出日常生活被审美化的价值。",
    "start": 341.408,
    "end": 343.968,
    "duration": 2.56
  },
  {
    "id": 80,
    "text": "所以表述为：他将躬耕陇亩、稼瑟艰难与乡村邻里风俗全面写入诗篇，",
    "start": 344.368,
    "end": 351.008,
    "duration": 6.64
  },
  {
    "id": 81,
    "text": "赋予日常生活以崇高的审美价值。。",
    "start": 351.008,
    "end": 354.288,
    "duration": 3.28
  },
  {
    "id": 82,
    "text": "论点提出后必须立刻调取极具代表性的文本证据，",
    "start": 354.288,
    "end": 358.528,
    "duration": 4.24
  },
  {
    "id": 83,
    "text": "首先选取描摹乡村居住环境的标志性名句以实证其白描画境。",
    "start": 358.528,
    "end": 364.048,
    "duration": 5.52
  },
  {
    "id": 84,
    "text": "所以表述为：《归园田居》其一中“方宅十余亩，",
    "start": 364.048,
    "end": 368.368,
    "duration": 4.32
  },
  {
    "id": 85,
    "text": "草屋八九间。",
    "start": 368.368,
    "end": 369.488,
    "duration": 1.12
  },
  {
    "id": 86,
    "text": "榆柳荫后檐，桃李罗堂前”，以纯朴白描勾勒出乡村居所的宁静自足。。",
    "start": 369.808,
    "end": 376.208,
    "duration": 6.4
  },
  {
    "id": 87,
    "text": "为了避免证据单一，需要进一步引入描摹躬耕劳作辛苦与精神自得的经典诗句，",
    "start": 376.208,
    "end": 383.008,
    "duration": 6.8
  },
  {
    "id": 88,
    "text": "展现其与土地的肉身相接。",
    "start": 383.008,
    "end": 385.248,
    "duration": 2.24
  },
  {
    "id": 89,
    "text": "所以表述为：《归园田居》其三中“晨兴理荒秽，",
    "start": 385.248,
    "end": 389.248,
    "duration": 4.0
  },
  {
    "id": 90,
    "text": "带月荷雏归”，真实记录了诗人亲事农耕的劳作细节与从容心境。。",
    "start": 389.248,
    "end": 394.528,
    "duration": 5.28
  },
  {
    "id": 91,
    "text": "在举证完毕后，尾句必须就地总结其题材开拓对扭转当时诗坛风气的重大文学史价值。",
    "start": 394.848,
    "end": 402.288,
    "duration": 7.44
  },
  {
    "id": 92,
    "text": "所以表述为：这种题材拓展彻底扭转了汉魏以来贵族文学浮华虚饰的弊病，",
    "start": 402.288,
    "end": 408.928,
    "duration": 6.64
  },
  {
    "id": 93,
    "text": "使中国古代诗歌首次深植于劳作大地的肥沃土壤。。",
    "start": 408.928,
    "end": 413.088,
    "duration": 4.16
  },
  {
    "id": 94,
    "text": "本段答题思路总结。",
    "start": 413.088,
    "end": 414.448,
    "duration": 1.36
  },
  {
    "id": 95,
    "text": "本段聚焦题材维度的突破：先立论指出打破贵族耻言耕稼传统，",
    "start": 414.768,
    "end": 421.008,
    "duration": 6.24
  },
  {
    "id": 96,
    "text": "接着借助谢灵运游赏之景的反衬凸显其生产劳作本质，",
    "start": 421.008,
    "end": 426.208,
    "duration": 5.2
  },
  {
    "id": 97,
    "text": "随后连出《归园田居》质朴居所与带月荷雏两组核心文本论据，",
    "start": 426.208,
    "end": 432.288,
    "duration": 6.08
  },
  {
    "id": 98,
    "text": "最后升华到扭转浮华虚饰诗风的高度，",
    "start": 432.288,
    "end": 435.728,
    "duration": 3.44
  },
  {
    "id": 99,
    "text": "论证严密扎实。",
    "start": 435.728,
    "end": 437.568,
    "duration": 1.84
  },
  {
    "id": 100,
    "text": "所以本段具体答题完整版为：首先，",
    "start": 437.568,
    "end": 440.984,
    "duration": 3.416
  },
  {
    "id": 101,
    "text": "陶渊明打破了汉魏以来贵族文人耻言耕稼的诗学传统，",
    "start": 440.984,
    "end": 445.784,
    "duration": 4.8
  },
  {
    "id": 102,
    "text": "在题材上完成了对平凡田园劳作的深情开拓。",
    "start": 445.784,
    "end": 450.264,
    "duration": 4.48
  },
  {
    "id": 103,
    "text": "谢灵运山水诗多描绘贵族游赏之景，",
    "start": 450.264,
    "end": 453.704,
    "duration": 3.44
  },
  {
    "id": 104,
    "text": "陶渊明则将视线投向大地本身的生产劳作。",
    "start": 453.704,
    "end": 457.464,
    "duration": 3.76
  },
  {
    "id": 105,
    "text": "他将躬耕陇亩、稼瑟艰难与乡村邻里风俗全面写入诗篇，",
    "start": 457.464,
    "end": 462.824,
    "duration": 5.36
  },
  {
    "id": 106,
    "text": "赋予日常生活以崇高的审美价值。",
    "start": 462.824,
    "end": 465.464,
    "duration": 2.64
  },
  {
    "id": 107,
    "text": "《归园田居》其一中“方宅十余亩，",
    "start": 465.624,
    "end": 468.609,
    "duration": 2.985
  },
  {
    "id": 108,
    "text": "草屋八九间。",
    "start": 468.609,
    "end": 469.853,
    "duration": 1.244
  },
  {
    "id": 109,
    "text": "榆柳荫后檐，桃李罗堂前”，以纯朴白描勾勒出乡村居所的宁静自足。",
    "start": 469.853,
    "end": 476.57,
    "duration": 6.717
  },
  {
    "id": 110,
    "text": "《归园田居》其三中“晨兴理荒秽，",
    "start": 476.57,
    "end": 479.556,
    "duration": 2.986
  },
  {
    "id": 111,
    "text": "带月荷雏归”，真实记录了诗人亲事农耕的劳作细节与从容心境。",
    "start": 479.556,
    "end": 486.024,
    "duration": 6.468
  },
  {
    "id": 112,
    "text": "这种题材拓展彻底扭转了汉魏以来贵族文学浮华虚饰的弊病，",
    "start": 486.184,
    "end": 491.144,
    "duration": 4.96
  },
  {
    "id": 113,
    "text": "使中国古代诗歌首次深植于劳作大地的肥沃土壤。",
    "start": 491.144,
    "end": 495.304,
    "duration": 4.16
  },
  {
    "id": 114,
    "text": "--。第",
    "start": 495.304,
    "end": 495.464,
    "duration": 0.16
  },
  {
    "id": 115,
    "text": "三部分：平淡自然与质而企真且醇的美学风貌。",
    "start": 495.464,
    "end": 499.704,
    "duration": 4.24
  },
  {
    "id": 116,
    "text": "逐句因果推导与答题表述。",
    "start": 499.704,
    "end": 501.944,
    "duration": 2.24
  },
  {
    "id": 117,
    "text": "题材确定后，分析必然推进至语言风格与美学形态，",
    "start": 501.944,
    "end": 506.104,
    "duration": 4.16
  },
  {
    "id": 118,
    "text": "首句必须立刻抛出文学史公认的标志性美学定义与苏轼名评。",
    "start": 506.104,
    "end": 511.224,
    "duration": 5.12
  },
  {
    "id": 119,
    "text": "所以表述为：其次，在艺术风貌上，",
    "start": 511.624,
    "end": 514.984,
    "duration": 3.36
  },
  {
    "id": 120,
    "text": "陶渊明田园诗达到了平淡自然、真淳质朴的化境，",
    "start": 514.984,
    "end": 519.144,
    "duration": 4.16
  },
  {
    "id": 121,
    "text": "苏轼精辟概括其为“质而企，真且醇”。。",
    "start": 519.144,
    "end": 522.664,
    "duration": 3.52
  },
  {
    "id": 122,
    "text": "随后需要对苏轼这一千古定论进行极其深入的文论拆解，",
    "start": 522.664,
    "end": 526.984,
    "duration": 4.32
  },
  {
    "id": 123,
    "text": "先阐明“质而企”的美学机制。",
    "start": 526.984,
    "end": 528.904,
    "duration": 1.92
  },
  {
    "id": 124,
    "text": "所以表述为：所谓“质而企”，是指其外在语言看似粗茶淡饭般平实，",
    "start": 529.224,
    "end": 534.504,
    "duration": 5.28
  },
  {
    "id": 125,
    "text": "内部却织就了极其精妙纯正的文采韵味。。",
    "start": 534.504,
    "end": 537.986,
    "duration": 3.482
  },
  {
    "id": 126,
    "text": "接着进一步拆解“真且醇”的情感特质，",
    "start": 537.986,
    "end": 541.058,
    "duration": 3.072
  },
  {
    "id": 127,
    "text": "揭示其情感深厚绵长之美。",
    "start": 541.058,
    "end": 543.31,
    "duration": 2.252
  },
  {
    "id": 128,
    "text": "所以表述为：所谓“真且醇”，是指其情感绝对真挚真实，",
    "start": 543.31,
    "end": 547.611,
    "duration": 4.301
  },
  {
    "id": 129,
    "text": "如同陈年佳酿般愈久弥香。。",
    "start": 547.611,
    "end": 549.864,
    "duration": 2.253
  },
  {
    "id": 130,
    "text": "然后剖析这种风格产生的时代反拨机制，",
    "start": 550.024,
    "end": 553.384,
    "duration": 3.36
  },
  {
    "id": 131,
    "text": "说明陶诗是如何肃清晋宋浮靡雕琢之风的。",
    "start": 553.384,
    "end": 557.784,
    "duration": 4.4
  },
  {
    "id": 132,
    "text": "所以表述为：陶诗彻底洗净了玄言诗的干瘪说理与太康诗风的雕章琢句，",
    "start": 557.784,
    "end": 564.584,
    "duration": 6.8
  },
  {
    "id": 133,
    "text": "用极平淡通俗的生活语言表达极为深厚的人生体验。。",
    "start": 564.584,
    "end": 569.464,
    "duration": 4.88
  },
  {
    "id": 134,
    "text": "紧接着深入剖析其语言与情感的内在辩证关系，",
    "start": 569.464,
    "end": 573.624,
    "duration": 4.16
  },
  {
    "id": 135,
    "text": "阐明天然去雕饰的诗学追求。",
    "start": 573.624,
    "end": 576.024,
    "duration": 2.4
  },
  {
    "id": 136,
    "text": "所以表述为：其诗语言不事藻饰却蕴含深意，",
    "start": 576.344,
    "end": 580.424,
    "duration": 4.08
  },
  {
    "id": 137,
    "text": "绝无斧凿之痕。。",
    "start": 580.424,
    "end": 581.864,
    "duration": 1.44
  },
  {
    "id": 138,
    "text": "为了支撑其平淡通俗且充满人情味的论点，",
    "start": 581.864,
    "end": 585.464,
    "duration": 3.6
  },
  {
    "id": 139,
    "text": "引入描写邻里真诚相处、把酒话农桑的经典诗篇作为论据。",
    "start": 585.464,
    "end": 590.104,
    "duration": 4.64
  },
  {
    "id": 140,
    "text": "所以表述为：《移居》中描绘“过门更相呼，",
    "start": 590.56,
    "end": 594.0,
    "duration": 3.44
  },
  {
    "id": 141,
    "text": "有酒斟酌之。",
    "start": 594.0,
    "end": 595.44,
    "duration": 1.44
  },
  {
    "id": 142,
    "text": "农务各自归，闲暇辄相思”，以纯粹口语传达出邻里往来的质朴温情。。",
    "start": 595.44,
    "end": 601.68,
    "duration": 6.24
  },
  {
    "id": 143,
    "text": "本段收束句必须将这种语言风貌上升到古代美学最高范畴进行定型总结。",
    "start": 601.68,
    "end": 608.08,
    "duration": 6.4
  },
  {
    "id": 144,
    "text": "所以表述为：这种表面平淡实则深沉的语言质感，",
    "start": 608.08,
    "end": 612.32,
    "duration": 4.24
  },
  {
    "id": 145,
    "text": "体现出绚烂至极归于平淡的最高美学境界。。",
    "start": 612.32,
    "end": 616.16,
    "duration": 3.84
  },
  {
    "id": 146,
    "text": "本段答题思路总结。",
    "start": 616.4,
    "end": 617.92,
    "duration": 1.52
  },
  {
    "id": 147,
    "text": "本段深刻剖析其平淡自然的美学内核：以苏轼名评开局，",
    "start": 617.92,
    "end": 622.4,
    "duration": 4.48
  },
  {
    "id": 148,
    "text": "逐层细致拆解“质而企”与“真且醇”的文论内涵，",
    "start": 622.4,
    "end": 626.48,
    "duration": 4.08
  },
  {
    "id": 149,
    "text": "分析其对浮华雕琢诗风的反拨，再用《移居》的日常口语温情作为铁证，",
    "start": 626.48,
    "end": 631.6,
    "duration": 5.12
  },
  {
    "id": 150,
    "text": "最终定型于绚烂之极归于平淡的至高境界，",
    "start": 631.6,
    "end": 634.96,
    "duration": 3.36
  },
  {
    "id": 151,
    "text": "具有极其惊艳的学术底蕴。",
    "start": 634.96,
    "end": 636.8,
    "duration": 1.84
  },
  {
    "id": 152,
    "text": "所以本段具体答题完整版为：其次，",
    "start": 637.2,
    "end": 640.4,
    "duration": 3.2
  },
  {
    "id": 153,
    "text": "在艺术风貌上，陶渊明田园诗达到了平淡自然、",
    "start": 640.4,
    "end": 644.88,
    "duration": 4.48
  },
  {
    "id": 154,
    "text": "真淳质朴的化境，苏轼精辟概括其为“质而企，",
    "start": 644.88,
    "end": 649.68,
    "duration": 4.8
  },
  {
    "id": 155,
    "text": "真且醇”。",
    "start": 649.68,
    "end": 650.88,
    "duration": 1.2
  },
  {
    "id": 156,
    "text": "所谓“质而企”，是指其外在语言看似粗茶淡饭般平实，",
    "start": 650.88,
    "end": 656.0,
    "duration": 5.12
  },
  {
    "id": 157,
    "text": "内部却织就了极其精妙纯正的文采韵味。",
    "start": 656.0,
    "end": 659.28,
    "duration": 3.28
  },
  {
    "id": 158,
    "text": "所谓“真且醇”，是指其情感绝对真挚真实，",
    "start": 659.6,
    "end": 663.52,
    "duration": 3.92
  },
  {
    "id": 159,
    "text": "如同陈年佳酿般愈久弥香。",
    "start": 663.52,
    "end": 666.16,
    "duration": 2.64
  },
  {
    "id": 160,
    "text": "陶诗彻底洗净了玄言诗的干瘪说理与太康诗风的雕章琢句，",
    "start": 666.16,
    "end": 671.6,
    "duration": 5.44
  },
  {
    "id": 161,
    "text": "用极平淡通俗的生活语言表达极为深厚的人生体验。",
    "start": 671.6,
    "end": 676.24,
    "duration": 4.64
  },
  {
    "id": 162,
    "text": "其诗语言不事藻饰却蕴含深意，绝无斧凿之痕。",
    "start": 676.24,
    "end": 680.72,
    "duration": 4.48
  },
  {
    "id": 163,
    "text": "《移居》中描绘“过门更相呼，有酒斟酌之。",
    "start": 680.96,
    "end": 684.295,
    "duration": 3.335
  },
  {
    "id": 164,
    "text": "农务各自归，闲暇辄相思”，以纯粹口语传达出邻里往来的质朴温情。",
    "start": 684.295,
    "end": 690.297,
    "duration": 6.002
  },
  {
    "id": 165,
    "text": "这种表面平淡实则深沉的语言质感，",
    "start": 690.297,
    "end": 693.632,
    "duration": 3.335
  },
  {
    "id": 166,
    "text": "体现出绚烂至极归于平淡的最高美学境界。",
    "start": 693.632,
    "end": 697.634,
    "duration": 4.002
  },
  {
    "id": 167,
    "text": "--。第",
    "start": 697.634,
    "end": 697.856,
    "duration": 0.222
  },
  {
    "id": 168,
    "text": "四部分：物我合一的哲思境界与经典意象提炼。",
    "start": 697.856,
    "end": 702.08,
    "duration": 4.224
  },
  {
    "id": 169,
    "text": "逐句因果推导与答题表述。",
    "start": 702.16,
    "end": 704.64,
    "duration": 2.48
  },
  {
    "id": 170,
    "text": "由外在的题材与语言进一步向作品内部精神深处开掘，",
    "start": 704.64,
    "end": 709.44,
    "duration": 4.8
  },
  {
    "id": 171,
    "text": "第四段必须探讨陶渊明诗歌深层的哲学意蕴与审美超越。",
    "start": 709.44,
    "end": 714.64,
    "duration": 5.2
  },
  {
    "id": 172,
    "text": "所以表述为：再次，在哲理表现上，",
    "start": 714.64,
    "end": 717.92,
    "duration": 3.28
  },
  {
    "id": 173,
    "text": "陶渊明田园诗实现了情、景、理的融彻无迹与物我两忘的审美超脱。。",
    "start": 717.92,
    "end": 724.32,
    "duration": 6.4
  },
  {
    "id": 174,
    "text": "接着剖析其哲学渊源与艺术转化机制，",
    "start": 724.56,
    "end": 728.32,
    "duration": 3.76
  },
  {
    "id": 175,
    "text": "讲清他是如何将玄学思潮转化为鲜活诗歌生命的。",
    "start": 728.32,
    "end": 733.12,
    "duration": 4.8
  },
  {
    "id": 176,
    "text": "所以表述为：陶渊明深受老庄道家自然哲学滋养，",
    "start": 733.12,
    "end": 737.36,
    "duration": 4.24
  },
  {
    "id": 177,
    "text": "却彻底消解了东晋玄言诗枯燥抽象的弊端。。",
    "start": 737.36,
    "end": 740.88,
    "duration": 3.52
  },
  {
    "id": 178,
    "text": "然后具体点出陶渊明是如何将生命哲思寄寓于具体鲜明的自然意象之中，",
    "start": 741.176,
    "end": 747.388,
    "duration": 6.212
  },
  {
    "id": 179,
    "text": "展示其高超的象征手法。",
    "start": 747.388,
    "end": 749.518,
    "duration": 2.13
  },
  {
    "id": 180,
    "text": "所以表述为：他将生命的本真哲思寄寓于具体鲜明的自然意象之中，",
    "start": 749.518,
    "end": 755.483,
    "duration": 5.965
  },
  {
    "id": 181,
    "text": "使草木景物皆具道德与精神投影。。",
    "start": 755.483,
    "end": 758.465,
    "duration": 2.982
  },
  {
    "id": 182,
    "text": "为了夯实论据，立刻枚举其诗中具有高度凝练文化隐喻的三组经典意象。",
    "start": 758.465,
    "end": 764.856,
    "duration": 6.391
  },
  {
    "id": 183,
    "text": "所以表述为：其诗中之菊象征高洁避俗，",
    "start": 765.016,
    "end": 768.653,
    "duration": 3.637
  },
  {
    "id": 184,
    "text": "孤松象征凌霜坚守，日暮归鸟象征生命归宿。。",
    "start": 768.653,
    "end": 772.826,
    "duration": 4.173
  },
  {
    "id": 185,
    "text": "紧接着必须给出陶渊明全集中认知度最高的千古绝唱，",
    "start": 772.826,
    "end": 778.158,
    "duration": 5.332
  },
  {
    "id": 186,
    "text": "展现其物我契合的心灵瞬间。",
    "start": 778.158,
    "end": 780.94,
    "duration": 2.782
  },
  {
    "id": 187,
    "text": "所以表述为：《饮酒》其五中“采菊东篱下，",
    "start": 780.94,
    "end": 784.417,
    "duration": 3.477
  },
  {
    "id": 188,
    "text": "悠然见南山。",
    "start": 784.417,
    "end": 785.576,
    "duration": 1.159
  },
  {
    "id": 189,
    "text": "山气日夕佳，飞鸟相与还”，人与自然在不期而遇中达成精神默契。。",
    "start": 785.736,
    "end": 791.736,
    "duration": 6.0
  },
  {
    "id": 190,
    "text": "引出名句后不能裸引，必须对“此中有真意”进行深层学术阐释，",
    "start": 791.736,
    "end": 797.176,
    "duration": 5.44
  },
  {
    "id": 191,
    "text": "解构言意之辩在诗境中的圆满落脚。",
    "start": 797.176,
    "end": 800.216,
    "duration": 3.04
  },
  {
    "id": 192,
    "text": "所以表述为：结尾以“此中有真意，",
    "start": 800.216,
    "end": 803.336,
    "duration": 3.12
  },
  {
    "id": 193,
    "text": "欲辨已忘言”收束，表明诗人通过对自然物候的静观默会，",
    "start": 803.336,
    "end": 808.056,
    "duration": 4.72
  },
  {
    "id": 194,
    "text": "领悟到了天道自然与生命安顿的本体真谛，",
    "start": 808.056,
    "end": 811.576,
    "duration": 3.52
  },
  {
    "id": 195,
    "text": "达到了言意两忘的至美哲思高境。。",
    "start": 811.576,
    "end": 814.216,
    "duration": 2.64
  },
  {
    "id": 196,
    "text": "本段答题思路总结。",
    "start": 814.456,
    "end": 815.976,
    "duration": 1.52
  },
  {
    "id": 197,
    "text": "本段将论证推向哲学与意境的高潮：指出情景理融合与物我两忘的核心特征，",
    "start": 815.976,
    "end": 822.696,
    "duration": 6.72
  },
  {
    "id": 198,
    "text": "点明老庄自然哲学向意象画面的艺术化转化，",
    "start": 822.696,
    "end": 826.376,
    "duration": 3.68
  },
  {
    "id": 199,
    "text": "提炼菊、松、归鸟的文化象征，精细拆解《饮酒》采菊见南山的心灵图景，",
    "start": 826.376,
    "end": 832.376,
    "duration": 6.0
  },
  {
    "id": 200,
    "text": "最后以忘言得意收束，展现出极高的考场专业素养。",
    "start": 832.376,
    "end": 836.456,
    "duration": 4.08
  },
  {
    "id": 201,
    "text": "所以本段具体答题完整版为：再次，",
    "start": 836.776,
    "end": 839.736,
    "duration": 2.96
  },
  {
    "id": 202,
    "text": "在哲理表现上，陶渊明田园诗实现了情、",
    "start": 839.736,
    "end": 843.496,
    "duration": 3.76
  },
  {
    "id": 203,
    "text": "景、理的融彻无迹与物我两忘的审美超脱。",
    "start": 843.496,
    "end": 847.656,
    "duration": 4.16
  },
  {
    "id": 204,
    "text": "陶渊明深受老庄道家自然哲学滋养，",
    "start": 847.656,
    "end": 850.616,
    "duration": 2.96
  },
  {
    "id": 205,
    "text": "却彻底消解了东晋玄言诗枯燥抽象的弊端。",
    "start": 850.616,
    "end": 854.536,
    "duration": 3.92
  },
  {
    "id": 206,
    "text": "他将生命的本真哲思寄寓于具体鲜明的自然意象之中，",
    "start": 854.536,
    "end": 859.416,
    "duration": 4.88
  },
  {
    "id": 207,
    "text": "使草木景物皆具道德与精神投影。",
    "start": 859.416,
    "end": 862.216,
    "duration": 2.8
  },
  {
    "id": 208,
    "text": "其诗中之菊象征高洁避俗，孤松象征凌霜坚守，",
    "start": 862.456,
    "end": 867.336,
    "duration": 4.88
  },
  {
    "id": 209,
    "text": "日暮归鸟象征生命归宿。",
    "start": 867.336,
    "end": 869.656,
    "duration": 2.32
  },
  {
    "id": 210,
    "text": "《饮酒》其五中“采菊东篱下，悠然见南山。",
    "start": 869.656,
    "end": 873.496,
    "duration": 3.84
  },
  {
    "id": 211,
    "text": "山气日夕佳，飞鸟相与还”，人与自然在不期而遇中达成精神默契。",
    "start": 873.496,
    "end": 879.736,
    "duration": 6.24
  },
  {
    "id": 212,
    "text": "结尾以“此中有真意，欲辨已忘言”收束，",
    "start": 879.736,
    "end": 883.256,
    "duration": 3.52
  },
  {
    "id": 213,
    "text": "表明诗人通过对自然物候的静观默会，",
    "start": 883.256,
    "end": 886.616,
    "duration": 3.36
  },
  {
    "id": 214,
    "text": "领悟到了天道自然与生命安顿的本体真谛，",
    "start": 886.616,
    "end": 890.456,
    "duration": 3.84
  },
  {
    "id": 215,
    "text": "达到了言意两忘的至美哲思高境。--",
    "start": 890.456,
    "end": 893.176,
    "duration": 2.72
  },
  {
    "id": 216,
    "text": "第五部分：总结升华与文学史承续价值。",
    "start": 893.552,
    "end": 897.232,
    "duration": 3.68
  },
  {
    "id": 217,
    "text": "逐句因果推导与答题表述。",
    "start": 897.232,
    "end": 899.632,
    "duration": 2.4
  },
  {
    "id": 218,
    "text": "经过以上四个维度的纵深阐析，结尾段必须跳出个案本身，",
    "start": 899.632,
    "end": 904.512,
    "duration": 4.88
  },
  {
    "id": 219,
    "text": "把陶渊明置于中国文学与思想发展的宏观长河中进行总结升华。",
    "start": 904.512,
    "end": 910.112,
    "duration": 5.6
  },
  {
    "id": 220,
    "text": "所以表述为：最后，陶渊明田园诗在文学史上树立起崇高的美学范式，",
    "start": 910.112,
    "end": 915.952,
    "duration": 5.84
  },
  {
    "id": 221,
    "text": "对后世诗歌与士人人格产生了极为深远的历史影响。。",
    "start": 915.952,
    "end": 920.112,
    "duration": 4.16
  },
  {
    "id": 222,
    "text": "第二句话需要从纯文学创作角度，明确指出其对唐代山水田园诗派以及宋代苏轼的直接传承关系。",
    "start": 920.432,
    "end": 928.832,
    "duration": 8.4
  },
  {
    "id": 223,
    "text": "所以表述为：在文学创作上，他开创的田园诗体，",
    "start": 928.832,
    "end": 932.832,
    "duration": 4.0
  },
  {
    "id": 224,
    "text": "直接滋养了盛唐孟浩然、王维、储光羲及中唐韦应物、",
    "start": 932.832,
    "end": 938.272,
    "duration": 5.44
  },
  {
    "id": 225,
    "text": "柳宗元等山水田园诗派名家，并深刻启发了苏轼“独好渊明之诗”的宋诗新风。。",
    "start": 938.272,
    "end": 944.672,
    "duration": 6.4
  },
  {
    "id": 226,
    "text": "第三句话必须从文学技巧跨越到文化精神层面，",
    "start": 944.912,
    "end": 948.752,
    "duration": 3.84
  },
  {
    "id": 227,
    "text": "明确点明陶渊明隐士品格对中国士大夫精神世界的奠基意义。",
    "start": 948.752,
    "end": 954.272,
    "duration": 5.52
  },
  {
    "id": 228,
    "text": "所以表述为：在文化精神上，陶渊明塑造的安贫乐道、",
    "start": 954.272,
    "end": 958.592,
    "duration": 4.32
  },
  {
    "id": 229,
    "text": "崇尚任真、不事权贵的隐士品格，成为中国士大夫退守心灵的精神支柱。。",
    "start": 958.592,
    "end": 964.272,
    "duration": 5.68
  },
  {
    "id": 230,
    "text": "最后一句话必须揭示这种文化品格在士人遭遇困顿时的心理抚慰与救赎机制，",
    "start": 964.512,
    "end": 970.352,
    "duration": 5.84
  },
  {
    "id": 231,
    "text": "完美呼应题目要求的“文化品格”，",
    "start": 970.352,
    "end": 973.072,
    "duration": 2.72
  },
  {
    "id": 232,
    "text": "完成全篇大题圆满闭环。",
    "start": 973.072,
    "end": 975.232,
    "duration": 2.16
  },
  {
    "id": 233,
    "text": "所以表述为：每当后代文人遭遇政治风浪与人生困顿，",
    "start": 975.232,
    "end": 979.712,
    "duration": 4.48
  },
  {
    "id": 234,
    "text": "陶渊明的生活选择与诗意天地便成为最强大的精神避难所，",
    "start": 979.712,
    "end": 984.352,
    "duration": 4.64
  },
  {
    "id": 235,
    "text": "其艺术成就与文化品格永垂青史。。",
    "start": 984.352,
    "end": 987.152,
    "duration": 2.8
  },
  {
    "id": 236,
    "text": "本段答题思路总结。",
    "start": 987.472,
    "end": 989.232,
    "duration": 1.76
  },
  {
    "id": 237,
    "text": "本段以宏大的文学史视野收束全篇：首句统摄艺术与人格双重影响，",
    "start": 989.232,
    "end": 995.072,
    "duration": 5.84
  },
  {
    "id": 238,
    "text": "次句点出唐宋田园诗脉的承续谱系，",
    "start": 995.072,
    "end": 998.112,
    "duration": 3.04
  },
  {
    "id": 239,
    "text": "第三四句深刻提炼出安贫乐道与崇尚任真的人格精神，",
    "start": 998.112,
    "end": 1002.672,
    "duration": 4.56
  },
  {
    "id": 240,
    "text": "点明其作为士人后退精神港湾的永恒价值，",
    "start": 1002.672,
    "end": 1006.112,
    "duration": 3.44
  },
  {
    "id": 241,
    "text": "立论沉稳宏阔。",
    "start": 1006.112,
    "end": 1007.712,
    "duration": 1.6
  },
  {
    "id": 242,
    "text": "所以本段具体答题完整版为：最后，",
    "start": 1007.712,
    "end": 1010.72,
    "duration": 3.008
  },
  {
    "id": 243,
    "text": "陶渊明田园诗在文学史上树立起崇高的美学范式，",
    "start": 1010.72,
    "end": 1015.36,
    "duration": 4.64
  },
  {
    "id": 244,
    "text": "对后世诗歌与士人人格产生了极为深远的历史影响。",
    "start": 1015.36,
    "end": 1020.24,
    "duration": 4.88
  },
  {
    "id": 245,
    "text": "在文学创作上，他开创的田园诗体，",
    "start": 1020.24,
    "end": 1023.36,
    "duration": 3.12
  },
  {
    "id": 246,
    "text": "直接滋养了盛唐孟浩然、王维、储光羲及中唐韦应物、",
    "start": 1023.36,
    "end": 1028.72,
    "duration": 5.36
  },
  {
    "id": 247,
    "text": "柳宗元等山水田园诗派名家，并深刻启发了苏轼“独好渊明之诗”的宋诗新风。",
    "start": 1028.72,
    "end": 1035.2,
    "duration": 6.48
  },
  {
    "id": 248,
    "text": "在文化精神上，陶渊明塑造的安贫乐道、",
    "start": 1035.6,
    "end": 1038.8,
    "duration": 3.2
  },
  {
    "id": 249,
    "text": "崇尚任真、不事权贵的隐士品格，成为中国士大夫退守心灵的精神支柱。",
    "start": 1038.8,
    "end": 1044.8,
    "duration": 6.0
  },
  {
    "id": 250,
    "text": "每当后代文人遭遇政治风浪与人生困顿，",
    "start": 1044.8,
    "end": 1048.0,
    "duration": 3.2
  },
  {
    "id": 251,
    "text": "陶渊明的生活选择与诗意天地便成为最强大的精神避难所，",
    "start": 1048.0,
    "end": 1052.72,
    "duration": 4.72
  },
  {
    "id": 252,
    "text": "其艺术成就与文化品格永垂青史。",
    "start": 1052.72,
    "end": 1055.6,
    "duration": 2.88
  },
  {
    "id": 253,
    "text": "篇尾：整道大题的内在逻辑链总括。",
    "start": 1055.84,
    "end": 1058.8,
    "duration": 2.96
  },
  {
    "id": 254,
    "text": "为了便于考生在脑海中建立极速调取机制，",
    "start": 1058.8,
    "end": 1062.32,
    "duration": 3.52
  },
  {
    "id": 255,
    "text": "整道大题的论证逻辑可提炼为如下不可逆的六步链条：一、",
    "start": 1062.32,
    "end": 1067.28,
    "duration": 4.96
  },
  {
    "id": 256,
    "text": "历史定性：开篇直接以“古今隐逸诗人之宗”与不折腰誓言定性，",
    "start": 1067.28,
    "end": 1072.24,
    "duration": 4.96
  },
  {
    "id": 257,
    "text": "立定题材革命与文化品格两大核心。",
    "start": 1072.24,
    "end": 1074.8,
    "duration": 2.56
  },
  {
    "id": 258,
    "text": "二、题材突破：对比谢灵运游赏之景，",
    "start": 1075.2,
    "end": 1078.88,
    "duration": 3.68
  },
  {
    "id": 259,
    "text": "打破耻言耕稼传统，以《归园田居》白描农舍与荷雏劳作，",
    "start": 1078.88,
    "end": 1084.32,
    "duration": 5.44
  },
  {
    "id": 260,
    "text": "将生活审美化。",
    "start": 1084.32,
    "end": 1085.92,
    "duration": 1.6
  },
  {
    "id": 261,
    "text": "三、美学特质：精准解构苏轼“质而企，",
    "start": 1085.92,
    "end": 1089.84,
    "duration": 3.92
  },
  {
    "id": 262,
    "text": "真且醇”，以《移居》纯朴口语展现绚烂之极归于平淡之美。",
    "start": 1089.84,
    "end": 1095.2,
    "duration": 5.36
  },
  {
    "id": 263,
    "text": "四、意象提炼：提炼孤松、高菊与归鸟象征，",
    "start": 1095.2,
    "end": 1099.6,
    "duration": 4.4
  },
  {
    "id": 264,
    "text": "以《饮酒》采菊见南山，展现物我相融与言意两忘的至美哲思。",
    "start": 1099.6,
    "end": 1105.04,
    "duration": 5.44
  },
  {
    "id": 265,
    "text": "五、流派承续：纵向打通诗歌脉络，",
    "start": 1105.36,
    "end": 1108.48,
    "duration": 3.12
  },
  {
    "id": 266,
    "text": "指出其不仅孕育了王维、孟浩然的山水田园诗派，",
    "start": 1108.48,
    "end": 1112.24,
    "duration": 3.76
  },
  {
    "id": 267,
    "text": "更启迪了苏轼宋诗风骨。",
    "start": 1112.24,
    "end": 1114.32,
    "duration": 2.08
  },
  {
    "id": 268,
    "text": "六、精神闭环：升华至士大夫安贫乐道与崇尚任真的人格精神，",
    "start": 1114.32,
    "end": 1119.68,
    "duration": 5.36
  },
  {
    "id": 269,
    "text": "点明其作为历代文人精神退守避难所的永恒价值。",
    "start": 1119.68,
    "end": 1123.52,
    "duration": 3.84
  }
]