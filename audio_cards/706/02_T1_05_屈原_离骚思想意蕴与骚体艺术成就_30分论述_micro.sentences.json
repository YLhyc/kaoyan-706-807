[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "屈原·离骚思想意蕴与骚体艺术成就",
    "start": 0.154,
    "end": 3.606,
    "duration": 3.452
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "由“心”到“象”再到“架”与“体”：全诗灵魂在九死未悔的“美政”忠贞，",
    "start": 4.259,
    "end": 10.431,
    "duration": 6.172
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "这份人格洁癖外化为系统的“香草美人”象征，受挫后飞升天界求索却因俯瞰旧乡跌回悲剧，",
    "start": 10.739,
    "end": 19.071,
    "duration": 8.332
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最终以长短“兮”字骚体铸成奇伟诗章。",
    "start": 19.299,
    "end": 23.151,
    "duration": 3.852
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《离骚》是浪漫主义政治抒情长诗，打破集体歌唱与四言格局，",
    "start": 23.679,
    "end": 28.96,
    "duration": 5.281
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "司马迁《史记·屈原贾生列传》赞其“虽与日月争光可也”。",
    "start": 28.975,
    "end": 33.648,
    "duration": 4.673
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 确立“美政”理想与忠贞气节",
    "start": 34.106,
    "end": 37.078,
    "duration": 2.972
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "贯彻修明法度、举贤授能之“美政”，忧国哀叹“长太息以掩涕兮，哀民生之多艰”。",
    "start": 37.606,
    "end": 46.978,
    "duration": 9.372
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "遭谗疏远仍不随流俗，宣告“亦余心之所善兮，虽九死其犹未悔”，将生命系于楚国存亡。",
    "start": 47.506,
    "end": 56.318,
    "duration": 8.812
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 开创系统的“香草美人”象征体系",
    "start": 56.995,
    "end": 60.047,
    "duration": 3.052
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "拓展《诗经》比兴，以辟芷、秋兰、木兰、宿莽等喻纯洁志行，“朝饮木兰之坠露兮，夕餐秋菊之落英”；",
    "start": 60.575,
    "end": 70.827,
    "duration": 10.252
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "以萧艾喻谗谄宵小，以“美人”及求女寄托贤君知己，升华为人格与政治寓托符号。",
    "start": 71.355,
    "end": 79.607,
    "duration": 8.252
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 构筑虚实交织的天界神游构架",
    "start": 80.3,
    "end": 83.752,
    "duration": 3.452
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "前半立足现实自叙出身修身与遭谗；后半命羲和、望舒、驾飞龙叩九重天门并从灵氛巫咸之占上下求索；",
    "start": 84.28,
    "end": 94.772,
    "duration": 10.492
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "云霓之上“陟升皇之赫戏兮，忽临睨夫旧乡”，仆夫悲、马怀顾，从神界剧烈跌回现实悲剧。",
    "start": 95.255,
    "end": 104.467,
    "duration": 9.212
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 创立“骚体”新体与楚地声韵",
    "start": 105.122,
    "end": 108.014,
    "duration": 2.892
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "吸收楚地民歌与巫祭乐歌创立长短错落“骚体”，打破《诗经》四言整齐格局；",
    "start": 108.5,
    "end": 116.272,
    "duration": 7.772
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "广用方言语气词“兮”置于句中或句末，拖长叹息呼告营造长歌当哭节奏，融名物词采直接孕育汉代辞赋。",
    "start": 116.8,
    "end": 127.052,
    "duration": 10.252
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "屈原以美政坚守为核心，借“香草美人”象征、天界神游与骚体句式完成由集体歌谣向个体长诗跨越，",
    "start": 127.76,
    "end": 136.572,
    "duration": 8.812
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "孕育汉代辞赋并积淀深厚爱国传统。",
    "start": 136.8,
    "end": 140.492,
    "duration": 3.692
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：司马迁赞屈原“虽与日月争光可也”；",
    "start": 141.141,
    "end": 145.633,
    "duration": 4.492
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "注意区分屈原与庄子：庄子神游超脱尘世，屈原升腾终因“忽临睨夫旧乡”跌回现实悲剧。",
    "start": 145.911,
    "end": 153.443,
    "duration": 7.532
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 《离骚》“香草/恶草/美人”三层象征体系怎么对应？",
    "start": 154.058,
    "end": 158.95,
    "duration": 4.892
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 为什么说屈原天界神游最终仍跌回现实悲剧？",
    "start": 159.478,
    "end": 164.77,
    "duration": 5.292
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 司马迁与“骚体”分别如何概括《离骚》的地位与体式特征？",
    "start": 165.267,
    "end": 171.199,
    "duration": 5.932
  }
]