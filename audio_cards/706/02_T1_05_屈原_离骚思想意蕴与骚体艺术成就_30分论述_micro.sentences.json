[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "屈原·离骚思想意蕴与骚体艺术成就",
    "start": 0.314,
    "end": 3.926,
    "duration": 3.612
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "由“心”到“象”再到“架”与“体”：全诗灵魂在九死未悔的“美政”忠贞，",
    "start": 4.934,
    "end": 11.026,
    "duration": 6.092
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "这份人格洁癖外化为系统的“香草美人”象征，受挫后飞升天界求索却因俯瞰旧乡跌回悲剧，",
    "start": 11.374,
    "end": 18.826,
    "duration": 7.452
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最终以长短“兮”字骚体铸成奇伟诗章。",
    "start": 19.014,
    "end": 22.626,
    "duration": 3.612
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《离骚》是浪漫主义政治抒情长诗，打破集体歌唱与四言格局，",
    "start": 23.514,
    "end": 28.406,
    "duration": 4.892
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "司马迁《史记·屈原贾生列传》赞其“虽与日月争光可也”。",
    "start": 28.594,
    "end": 33.166,
    "duration": 4.572
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 确立“美政”理想与忠贞气节",
    "start": 34.174,
    "end": 37.586,
    "duration": 3.412
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "贯彻修明法度、举贤授能之“美政”，忧国哀叹“长太息以掩涕兮，哀民生之多艰”。",
    "start": 38.594,
    "end": 47.046,
    "duration": 8.452
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "遭谗疏远仍不随流俗，宣告“亦余心之所善兮，虽九死其犹未悔”，将生命系于楚国存亡。",
    "start": 48.174,
    "end": 57.106,
    "duration": 8.932
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 开创系统的“香草美人”象征体系",
    "start": 58.034,
    "end": 61.646,
    "duration": 3.612
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "拓展《诗经》比兴，以辟芷、秋兰、木兰、宿莽等喻纯洁志行，“朝饮木兰之坠露兮，夕餐秋菊之落英”；",
    "start": 62.654,
    "end": 72.066,
    "duration": 9.412
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "以萧艾喻谗谄宵小，以“美人”及求女寄托贤君知己，升华为人格与政治寓托符号。",
    "start": 73.154,
    "end": 81.846,
    "duration": 8.692
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 构筑虚实交织的天界神游构架",
    "start": 82.774,
    "end": 86.706,
    "duration": 3.932
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "前半立足现实自叙出身修身与遭谗；后半命羲和、望舒、驾飞龙叩九重天门并从灵氛巫咸之占上下求索；",
    "start": 87.786,
    "end": 99.398,
    "duration": 11.612
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "云霓之上“陟升皇之赫戏兮，忽临睨夫旧乡”，仆夫悲、马怀顾，从神界剧烈跌回现实悲剧。",
    "start": 100.486,
    "end": 110.578,
    "duration": 10.092
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 创立“骚体”新体与楚地声韵",
    "start": 111.586,
    "end": 114.958,
    "duration": 3.372
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "吸收楚地民歌与巫祭乐歌创立长短错落“骚体”，打破《诗经》四言整齐格局；",
    "start": 115.926,
    "end": 123.658,
    "duration": 7.732
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "广用方言语气词“兮”置于句中或句末，拖长叹息呼告营造长歌当哭节奏，融名物词采直接孕育汉代辞赋。",
    "start": 124.706,
    "end": 135.798,
    "duration": 11.092
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "屈原以美政坚守为核心，借“香草美人”象征、天界神游与骚体句式完成由集体歌谣向个体长诗跨越，",
    "start": 136.806,
    "end": 146.898,
    "duration": 10.092
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "孕育汉代辞赋并积淀深厚爱国传统。",
    "start": 147.206,
    "end": 151.138,
    "duration": 3.932
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：司马迁赞屈原“虽与日月争光可也”；",
    "start": 152.146,
    "end": 155.798,
    "duration": 3.652
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "注意区分屈原与庄子：庄子神游超脱尘世，屈原升腾终因“忽临睨夫旧乡”跌回现实悲剧。",
    "start": 156.766,
    "end": 165.258,
    "duration": 8.492
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 《离骚》“香草/恶草/美人”三层象征体系怎么对应？",
    "start": 166.226,
    "end": 171.918,
    "duration": 5.692
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 为什么说屈原天界神游最终仍跌回现实悲剧？",
    "start": 172.886,
    "end": 178.618,
    "duration": 5.732
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 司马迁与“骚体”分别如何概括《离骚》的地位与体式特征？",
    "start": 179.586,
    "end": 186.118,
    "duration": 6.532
  }
]