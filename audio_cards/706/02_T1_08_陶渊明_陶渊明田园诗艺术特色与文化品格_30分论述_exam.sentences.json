[
  {
    "id": 1,
    "text": "试论陶渊明田园诗的艺术特色与文化品格。",
    "start": 0.134,
    "end": 3.546,
    "duration": 3.412
  },
  {
    "id": 2,
    "text": "陶渊明是中国古典田园诗派的开创者，也是魏晋风流与士人人格独立的杰出代表。",
    "start": 4.263,
    "end": 10.475,
    "duration": 6.212
  },
  {
    "id": 3,
    "text": "身处东晋刘宋易代之际的政治动荡与门阀专权现实之中，陶渊明辞官归隐，",
    "start": 11.153,
    "end": 16.925,
    "duration": 5.772
  },
  {
    "id": 4,
    "text": "突破了东晋玄言诗枯燥说理与晋宋诗坛偏重雕琢的藩篱，",
    "start": 17.304,
    "end": 21.996,
    "duration": 4.692
  },
  {
    "id": 5,
    "text": "首次将亲身参与的农耕劳作与乡村日常生活全面引入诗歌。",
    "start": 22.511,
    "end": 27.043,
    "duration": 4.532
  },
  {
    "id": 6,
    "text": "苏轼在《与苏辙书》中赞其诗“质而实绮，癯而实腴”。",
    "start": 27.734,
    "end": 31.946,
    "duration": 4.212
  },
  {
    "id": 7,
    "text": "陶渊明田园诗的艺术特色与文化品格，主要体现在以下四个方面：",
    "start": 32.704,
    "end": 44.036,
    "duration": 11.332
  },
  {
    "id": 8,
    "text": "第一，开创田园诗全新题材，将平凡农耕劳作与诗意人生融为一体。",
    "start": 44.714,
    "end": 55.486,
    "duration": 10.772
  },
  {
    "id": 9,
    "text": "陶渊明在题材上的开拓性贡献，不仅在于流连恬美的农村风光，",
    "start": 56.204,
    "end": 57.736,
    "duration": 1.532
  },
  {
    "id": 10,
    "text": "更在于以士大夫的身份亲身躬耕，并将农耕甘苦升华为诗意人生的载体。",
    "start": 58.115,
    "end": 61.727,
    "duration": 3.612
  },
  {
    "id": 11,
    "text": "在《归园田居·其一》中，他以亲切笔触描摹“方宅十余亩，草屋八九间。榆柳荫后檐，桃李罗堂前”的幽静村居；",
    "start": 62.525,
    "end": 63.337,
    "duration": 0.812
  },
  {
    "id": 12,
    "text": "在《其三》中，如实写出“晨兴理荒秽，带月荷锄归”的劳作艰辛，并以“衣沾不足惜，但使愿无违”的坚定情志，",
    "start": 63.866,
    "end": 64.918,
    "duration": 1.052
  },
  {
    "id": 13,
    "text": "把体力耕作转化为守护人格纯洁的精神选择，确立了人与自然和谐相亲的审美典范。",
    "start": 65.297,
    "end": 66.259,
    "duration": 0.962
  },
  {
    "id": 14,
    "text": "第二，追求“平淡自然”的美学风范，达成平淡中见警策的语言化境。",
    "start": 66.937,
    "end": 81.95,
    "duration": 15.013
  },
  {
    "id": 15,
    "text": "在艺术表现上，陶诗以平淡自然、真淳质朴著称，摆脱了东晋玄言诗抽象说理与晋宋之际渐趋偶对雕饰的风气。",
    "start": 82.607,
    "end": 87.619,
    "duration": 5.012
  },
  {
    "id": 16,
    "text": "陶渊明遣词用字多取家常口语与白描手法，不事藻饰而平淡中见警策、朴素中见绮丽。",
    "start": 88.297,
    "end": 104.892,
    "duration": 16.595
  },
  {
    "id": 17,
    "text": "其代表作《饮酒·其五》中，“采菊东篱下，悠然见南山。山气日夕佳，飞鸟相与还”，",
    "start": 105.421,
    "end": 112.313,
    "duration": 6.892
  },
  {
    "id": 18,
    "text": "信手拈来日常景物，毫无斧凿痕迹，却营造出物我两忘、心境浑融的意境；",
    "start": 112.692,
    "end": 119.19,
    "duration": 6.498
  },
  {
    "id": 19,
    "text": "结语“此中有真意，欲辨已忘言”，更将生活中的生命体悟化为言有尽而意无穷的诗意直觉。",
    "start": 119.719,
    "end": 127.451,
    "duration": 7.732
  },
  {
    "id": 20,
    "text": "第三，兼融儒道两家思想精髓，树立固穷守节、超然自适的士人人格。",
    "start": 128.075,
    "end": 133.767,
    "duration": 5.692
  },
  {
    "id": 21,
    "text": "陶渊明诗文不仅是田园生活的写照，也是一部独立士人的心灵史。",
    "start": 134.445,
    "end": 139.097,
    "duration": 4.652
  },
  {
    "id": 22,
    "text": "他将儒家“安贫乐道”“穷则独善其身”的操守，与道家顺应自然、齐同生死得失的旷达融为一体。",
    "start": 139.735,
    "end": 147.227,
    "duration": 7.492
  },
  {
    "id": 23,
    "text": "面对官场污浊，他践行“不为五斗米折腰向乡里小儿”的气节；",
    "start": 147.985,
    "end": 152.437,
    "duration": 4.452
  },
  {
    "id": 24,
    "text": "在《桃花源记》中，他构想了一个“不知有汉，无论魏晋”、人人自食其力的和平村落，",
    "start": 153.155,
    "end": 159.327,
    "duration": 6.172
  },
  {
    "id": 25,
    "text": "寄托了对社会苦难的关切以及对理想人生秩序的向往。",
    "start": 159.706,
    "end": 164.038,
    "duration": 4.332
  },
  {
    "id": 26,
    "text": "第四，构筑后代士大夫的精神家园，对唐宋诗坛产生深远文化影响。",
    "start": 164.716,
    "end": 169.888,
    "duration": 5.172
  },
  {
    "id": 27,
    "text": "陶渊明的人格风范与诗艺造诣在中国文学史上具有深远坐标意义。",
    "start": 170.566,
    "end": 175.658,
    "duration": 5.092
  },
  {
    "id": 28,
    "text": "经过萧统推崇与宋代苏轼、朱熹等人的发扬，其地位日益崇高：",
    "start": 176.296,
    "end": 188.268,
    "duration": 11.972
  },
  {
    "id": 29,
    "text": "盛唐王维、孟浩然与中唐韦应物、柳宗元承接其脉络，将山水田园诗推向高峰；",
    "start": 188.986,
    "end": 192.238,
    "duration": 3.252
  },
  {
    "id": 30,
    "text": "北宋苏轼晚年屡遭贬谪，作大量“和陶诗”，借陶渊明的平淡旷达抚慰心灵创伤。",
    "start": 192.767,
    "end": 195.859,
    "duration": 3.092
  },
  {
    "id": 31,
    "text": "陶渊明以躬耕自资的操守与真淳自然的诗境，成为后世士人在仕途坎坷时安顿心灵、守护尊严的精神归宿。",
    "start": 196.577,
    "end": 204.989,
    "duration": 8.412
  },
  {
    "id": 32,
    "text": "总而言之，陶渊明在晋宋玄言、山水诗风盛行之际毅然归耕田园，",
    "start": 205.627,
    "end": 211.519,
    "duration": 5.892
  },
  {
    "id": 33,
    "text": "以质朴自然的白描语言与儒道兼融的固穷节操，开辟出诗意栖居的全新审美境域。",
    "start": 211.898,
    "end": 218.79,
    "duration": 6.892
  },
  {
    "id": 34,
    "text": "这种“质而实绮，癯而实腴”的艺术追求与独立守节的人格典范，",
    "start": 219.428,
    "end": 224.12,
    "duration": 4.692
  },
  {
    "id": 35,
    "text": "不仅直接启迪了盛唐王维、孟浩然等山水田园诗人，也长久成为后代士大夫安顿身心的精神家园。",
    "start": 224.499,
    "end": 231.791,
    "duration": 7.292
  }
]