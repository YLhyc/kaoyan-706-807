[
  {
    "id": 1,
    "text": "试论陶渊明田园诗的艺术特色与文化品格。",
    "start": 0.05,
    "end": 4.186,
    "duration": 4.136
  },
  {
    "id": 2,
    "text": "陶渊明是中国古典诗歌田园诗派的开山宗师，",
    "start": 4.186,
    "end": 8.171,
    "duration": 3.985
  },
  {
    "id": 3,
    "text": "也是魏晋士人人格独立的至高精神象征。",
    "start": 8.171,
    "end": 11.754,
    "duration": 3.583
  },
  {
    "id": 4,
    "text": "身处东晋刘宋易代的政治剧变与门阀专权的残酷现实之中，",
    "start": 11.754,
    "end": 18.879,
    "duration": 7.125
  },
  {
    "id": 5,
    "text": "陶渊明毅然辞官归隐，",
    "start": 18.879,
    "end": 20.516,
    "duration": 1.637
  },
  {
    "id": 6,
    "text": "彻底打破了东晋诗坛玄言诗枯燥说理与山水诗偏于客观摹写的外在藩篱，",
    "start": 20.516,
    "end": 28.475,
    "duration": 7.959
  },
  {
    "id": 7,
    "text": "第一次将平凡纯朴的乡村日常生活与农耕劳作全面引入诗歌创作。",
    "start": 28.475,
    "end": 34.04,
    "duration": 5.565
  },
  {
    "id": 8,
    "text": "苏轼在 《东坡题跋》 中赞其诗 “质而实绮，癯而实腴”。",
    "start": 34.04,
    "end": 38.626,
    "duration": 4.586
  },
  {
    "id": 9,
    "text": "陶渊明田园诗的艺术特色与文化品格，",
    "start": 38.626,
    "end": 42.589,
    "duration": 3.963
  },
  {
    "id": 10,
    "text": "主要展现为以下四个核心维度：",
    "start": 42.589,
    "end": 45.76,
    "duration": 3.171
  },
  {
    "id": 11,
    "text": "第一，开创“田园诗”全新审美题材，",
    "start": 45.76,
    "end": 48.123,
    "duration": 2.363
  },
  {
    "id": 12,
    "text": "实现平凡劳作与诗意人生的圆融交织。",
    "start": 48.123,
    "end": 52.242,
    "duration": 4.119
  },
  {
    "id": 13,
    "text": "陶渊明在题材上的开拓性贡献，",
    "start": 52.242,
    "end": 55.063,
    "duration": 2.821
  },
  {
    "id": 14,
    "text": "在于他不仅流连于田园自然风光，",
    "start": 55.063,
    "end": 57.608,
    "duration": 2.545
  },
  {
    "id": 15,
    "text": "更将切身参与的农业劳作升华为精神诗意的重要载体。",
    "start": 57.608,
    "end": 62.084,
    "duration": 4.476
  },
  {
    "id": 16,
    "text": "在 《归园田居·其一》 中，",
    "start": 62.084,
    "end": 63.843,
    "duration": 1.759
  },
  {
    "id": 17,
    "text": "他以极其亲切的笔触描摹 “方宅十余亩，草屋八九间。",
    "start": 63.843,
    "end": 68.288,
    "duration": 4.445
  },
  {
    "id": 18,
    "text": "榆柳荫后檐，桃李罗堂前” 的清幽村居；在 《其三》 中，",
    "start": 68.288,
    "end": 73.182,
    "duration": 4.894
  },
  {
    "id": 19,
    "text": "他直白叙述 “晨兴理荒秽，带月荷锄归” 的耕作艰辛，",
    "start": 73.182,
    "end": 77.082,
    "duration": 3.9
  },
  {
    "id": 20,
    "text": "更以 “衣沾不足惜，但使愿无违” 的坚定情志，",
    "start": 77.082,
    "end": 81.395,
    "duration": 4.313
  },
  {
    "id": 21,
    "text": "将繁重的体力劳动转化为捍卫精神纯洁的道德仪式。",
    "start": 81.395,
    "end": 86.028,
    "duration": 4.633
  },
  {
    "id": 22,
    "text": "陶诗使自然山水与世俗劳作摆脱了功利色彩，",
    "start": 86.028,
    "end": 90.538,
    "duration": 4.51
  },
  {
    "id": 23,
    "text": "确立了中国古典文学中人与自然亲密和谐的最高典范。",
    "start": 90.538,
    "end": 95.243,
    "duration": 4.705
  },
  {
    "id": 24,
    "text": "第二，追求“平淡自然”的至高美学风范，",
    "start": 95.243,
    "end": 99.943,
    "duration": 4.7
  },
  {
    "id": 25,
    "text": "达成无矫饰的纯净语言化境。",
    "start": 99.943,
    "end": 103.008,
    "duration": 3.065
  },
  {
    "id": 26,
    "text": "在艺术表现上，陶诗以平淡自然、真淳质朴著称，",
    "start": 103.008,
    "end": 108.184,
    "duration": 5.176
  },
  {
    "id": 27,
    "text": "完全摆脱了齐梁以后刻意追求偶对声律与雕琢藻饰的积习。",
    "start": 108.184,
    "end": 114.099,
    "duration": 5.915
  },
  {
    "id": 28,
    "text": "陶渊明遣词用字极为朴素，多用日常口语与生活白描，",
    "start": 114.099,
    "end": 118.865,
    "duration": 4.766
  },
  {
    "id": 29,
    "text": "不施脂粉而韵味无穷。",
    "start": 118.865,
    "end": 121.361,
    "duration": 2.496
  },
  {
    "id": 30,
    "text": "其代表作 《饮酒·其五》 中，“采菊东篱下，悠然见南山。",
    "start": 121.361,
    "end": 125.574,
    "duration": 4.213
  },
  {
    "id": 31,
    "text": "山气日夕佳，飞鸟相与还”，诗人信手拈来日常景物，",
    "start": 125.574,
    "end": 129.288,
    "duration": 3.714
  },
  {
    "id": 32,
    "text": "毫无斧凿痕迹，却营造出物我两忘、空灵澄澈的无上化境；",
    "start": 129.288,
    "end": 134.828,
    "duration": 5.54
  },
  {
    "id": 33,
    "text": "结语 “此中有真意，欲辨已忘言”，",
    "start": 134.828,
    "end": 137.12,
    "duration": 2.292
  },
  {
    "id": 34,
    "text": "更是将道家忘言自足的哲理体悟化为了无法言说的诗意直觉。",
    "start": 137.12,
    "end": 143.115,
    "duration": 5.995
  },
  {
    "id": 35,
    "text": "第三，融铸儒道两家精神精髓，",
    "start": 143.115,
    "end": 145.569,
    "duration": 2.454
  },
  {
    "id": 36,
    "text": "确立固穷守节与超然自适的独立士人人格。",
    "start": 145.569,
    "end": 149.334,
    "duration": 3.765
  },
  {
    "id": 37,
    "text": "陶渊明诗歌不仅是风景与劳作的记录，",
    "start": 149.334,
    "end": 153.062,
    "duration": 3.728
  },
  {
    "id": 38,
    "text": "更是一部独立士人的人格心灵史。",
    "start": 153.062,
    "end": 158.088,
    "duration": 5.026
  },
  {
    "id": 39,
    "text": "他将儒家“安贫乐道”、“穷则独善其身”的操守，",
    "start": 158.088,
    "end": 161.179,
    "duration": 3.091
  },
  {
    "id": 40,
    "text": "与道家“顺应自然”、“齐彭殇齐得失”的旷达紧密结合。",
    "start": 161.179,
    "end": 164.913,
    "duration": 3.734
  },
  {
    "id": 41,
    "text": "面对官场污浊与门阀压迫，",
    "start": 164.913,
    "end": 166.975,
    "duration": 2.062
  },
  {
    "id": 42,
    "text": "他践行了“不为五斗米折腰向乡里小儿”的气节；",
    "start": 166.975,
    "end": 173.295,
    "duration": 6.32
  },
  {
    "id": 43,
    "text": "在其名篇 《桃花源记》 中，他虚构了一个“不知有汉，",
    "start": 173.295,
    "end": 176.775,
    "duration": 3.48
  },
  {
    "id": 44,
    "text": "无论魏晋”、人人劳作自足的理想社会，",
    "start": 176.775,
    "end": 179.502,
    "duration": 2.727
  },
  {
    "id": 45,
    "text": "寄托了对暴政剥削的深刻否定与对人类和平自由生活的永恒向往。",
    "start": 179.502,
    "end": 187.084,
    "duration": 7.582
  },
  {
    "id": 46,
    "text": "第四，构筑中国知识分子精神归宿，",
    "start": 187.084,
    "end": 190.289,
    "duration": 3.205
  },
  {
    "id": 47,
    "text": "对唐宋文人产生深远悠长的文化影响。",
    "start": 190.289,
    "end": 193.614,
    "duration": 3.325
  },
  {
    "id": 48,
    "text": "陶渊明的人格追求与诗风造诣，在中国文化史上具有坐标意义。",
    "start": 193.614,
    "end": 199.175,
    "duration": 5.561
  },
  {
    "id": 49,
    "text": "唐代王维、孟浩然、韦应物、柳宗元继承其田园山水脉络，",
    "start": 199.175,
    "end": 204.266,
    "duration": 5.091
  },
  {
    "id": 50,
    "text": "开创了盛唐田园山水诗派；北宋苏轼更是晚年以陶为师，",
    "start": 204.266,
    "end": 209.415,
    "duration": 5.149
  },
  {
    "id": 51,
    "text": "写下大量 “和陶诗”，",
    "start": 209.415,
    "end": 211.215,
    "duration": 1.8
  },
  {
    "id": 52,
    "text": "借陶渊明的平淡旷达消解自身屡遭贬谪的政治创伤。",
    "start": 211.215,
    "end": 215.943,
    "duration": 4.728
  },
  {
    "id": 53,
    "text": "陶渊明以躬耕自资的实践与天真纯朴的诗境，",
    "start": 215.943,
    "end": 220.06,
    "duration": 4.117
  },
  {
    "id": 54,
    "text": "为中国古代士大夫在面对现实政治压迫时，",
    "start": 220.06,
    "end": 223.843,
    "duration": 3.783
  },
  {
    "id": 55,
    "text": "提供了一座安顿心灵、守护精神尊严的永恒家园。",
    "start": 223.843,
    "end": 228.192,
    "duration": 4.349
  }
]