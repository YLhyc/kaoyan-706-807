[
  {
    "id": 1,
    "text": "试论陶渊明田园诗的艺术特色与文化品格。",
    "start": 0.28,
    "end": 4.04,
    "duration": 3.76
  },
  {
    "id": 2,
    "text": "陶渊明是中国古典田园诗派的开创者，也是魏晋风流与士人人格独立的杰出代表。",
    "start": 4.56,
    "end": 11.104,
    "duration": 6.544
  },
  {
    "id": 3,
    "text": "身处东晋刘宋易代之际的政治动荡与门阀专权现实之中，陶渊明辞官归隐，",
    "start": 11.604,
    "end": 17.69,
    "duration": 6.086
  },
  {
    "id": 4,
    "text": "突破了东晋玄言诗枯燥说理与晋宋诗坛偏重雕琢的藩篱，",
    "start": 18.06,
    "end": 23.095,
    "duration": 5.035
  },
  {
    "id": 5,
    "text": "首次将亲身参与的农耕劳作与乡村日常生活全面引入诗歌。",
    "start": 23.445,
    "end": 28.43,
    "duration": 4.985
  },
  {
    "id": 6,
    "text": "苏轼在《与苏辙书》中赞其诗“质而实绮，癯而实腴”。",
    "start": 28.95,
    "end": 33.75,
    "duration": 4.8
  },
  {
    "id": 7,
    "text": "陶渊明田园诗的艺术特色与文化品格，主要体现在以下四个方面：",
    "start": 34.28,
    "end": 39.08,
    "duration": 4.8
  },
  {
    "id": 8,
    "text": "第一，开创田园诗全新题材，将平凡农耕劳作与诗意人生融为一体。",
    "start": 39.45,
    "end": 45.53,
    "duration": 6.08
  },
  {
    "id": 9,
    "text": "陶渊明在题材上的开拓性贡献，不仅在于流连恬美的农村风光，",
    "start": 46.05,
    "end": 51.28,
    "duration": 5.23
  },
  {
    "id": 10,
    "text": "更在于以士大夫的身份亲身躬耕，并将农耕甘苦升华为诗意人生的载体。",
    "start": 51.65,
    "end": 58.096,
    "duration": 6.446
  },
  {
    "id": 11,
    "text": "在《归园田居·其一》中，他以亲切笔触描摹“方宅十余亩，草屋八九间。榆柳荫后檐，桃李罗堂前”的幽静村居；",
    "start": 58.596,
    "end": 68.35,
    "duration": 9.754
  },
  {
    "id": 12,
    "text": "在《其三》中，如实写出“晨兴理荒秽，带月荷锄归”的劳作艰辛，并以“衣沾不足惜，但使愿无违”的坚定情志，",
    "start": 68.87,
    "end": 78.31,
    "duration": 9.44
  },
  {
    "id": 13,
    "text": "把体力耕作转化为守护人格纯洁的精神选择，确立了人与自然和谐相亲的审美典范。",
    "start": 78.68,
    "end": 86.2,
    "duration": 7.52
  },
  {
    "id": 14,
    "text": "第二，追求“平淡自然”的美学风范，达成平淡中见警策的语言化境。",
    "start": 86.72,
    "end": 92.883,
    "duration": 6.163
  },
  {
    "id": 15,
    "text": "在艺术表现上，陶诗以平淡自然、真淳质朴著称，摆脱了东晋玄言诗抽象说理与晋宋之际渐趋偶对雕饰的风气。",
    "start": 93.383,
    "end": 102.92,
    "duration": 9.537
  },
  {
    "id": 16,
    "text": "陶渊明遣词用字多取家常口语与白描手法，不事藻饰而平淡中见警策、朴素中见绮丽。",
    "start": 103.44,
    "end": 111.92,
    "duration": 8.48
  },
  {
    "id": 17,
    "text": "其代表作《饮酒·其五》中，“采菊东篱下，悠然见南山。山气日夕佳，飞鸟相与还”，",
    "start": 112.44,
    "end": 120.33,
    "duration": 7.89
  },
  {
    "id": 18,
    "text": "信手拈来日常景物，毫无斧凿痕迹，却营造出物我两忘、心境浑融的意境；",
    "start": 120.81,
    "end": 127.61,
    "duration": 6.8
  },
  {
    "id": 19,
    "text": "结语“此中有真意，欲辨已忘言”，更将生活中的生命体悟化为言有尽而意无穷的诗意直觉。",
    "start": 128.13,
    "end": 136.69,
    "duration": 8.56
  },
  {
    "id": 20,
    "text": "第三，兼融儒道两家思想精髓，树立固穷守节、超然自适的士人人格。",
    "start": 137.21,
    "end": 143.29,
    "duration": 6.08
  },
  {
    "id": 21,
    "text": "陶渊明诗文不仅是田园生活的写照，也是一部独立士人的心灵史。",
    "start": 143.81,
    "end": 148.77,
    "duration": 4.96
  },
  {
    "id": 22,
    "text": "他将儒家“安贫乐道”“穷则独善其身”的操守，与道家顺应自然、齐同生死得失的旷达融为一体。",
    "start": 149.29,
    "end": 157.85,
    "duration": 8.56
  },
  {
    "id": 23,
    "text": "面对官场污浊，他践行“不为五斗米折腰向乡里小儿”的气节；",
    "start": 158.37,
    "end": 163.25,
    "duration": 4.88
  },
  {
    "id": 24,
    "text": "在《桃花源记》中，他构想了一个“不知有汉，无论魏晋”、人人自食其力的和平村落，",
    "start": 163.77,
    "end": 170.7,
    "duration": 6.93
  },
  {
    "id": 25,
    "text": "寄托了对社会苦难的关切以及对理想人生秩序的向往。",
    "start": 171.07,
    "end": 175.31,
    "duration": 4.24
  },
  {
    "id": 26,
    "text": "第四，构筑后代士大夫的精神家园，对唐宋诗坛产生深远文化影响。",
    "start": 175.83,
    "end": 181.35,
    "duration": 5.52
  },
  {
    "id": 27,
    "text": "陶渊明的人格风范与诗艺造诣在中国文学史上具有深远坐标意义。",
    "start": 181.87,
    "end": 187.39,
    "duration": 5.52
  },
  {
    "id": 28,
    "text": "经过萧统推崇与宋代苏轼、朱熹等人的发扬，其地位日益崇高：",
    "start": 187.91,
    "end": 193.43,
    "duration": 5.52
  },
  {
    "id": 29,
    "text": "盛唐王维、孟浩然与中唐韦应物、柳宗元承接其脉络，将山水田园诗推向高峰；",
    "start": 193.829,
    "end": 201.4,
    "duration": 7.571
  },
  {
    "id": 30,
    "text": "北宋苏轼晚年屡遭贬谪，作大量“和陶诗”，借陶渊明的平淡旷达抚慰心灵创伤。",
    "start": 201.92,
    "end": 208.8,
    "duration": 6.88
  },
  {
    "id": 31,
    "text": "陶渊明以躬耕自资的操守与真淳自然的诗境，成为后世士人在仕途坎坷时安顿心灵、守护尊严的精神归宿。",
    "start": 209.32,
    "end": 218.594,
    "duration": 9.274
  },
  {
    "id": 32,
    "text": "总而言之，陶渊明在晋宋玄言、山水诗风盛行之际毅然归耕田园，",
    "start": 219.094,
    "end": 224.88,
    "duration": 5.786
  },
  {
    "id": 33,
    "text": "以质朴自然的白描语言与儒道兼融的固穷节操，开辟出诗意栖居的全新审美境域。",
    "start": 225.25,
    "end": 232.37,
    "duration": 7.12
  },
  {
    "id": 34,
    "text": "这种“质而实绮，癯而实腴”的艺术追求与独立守节的人格典范，",
    "start": 232.89,
    "end": 237.93,
    "duration": 5.04
  },
  {
    "id": 35,
    "text": "不仅直接启迪了盛唐王维、孟浩然等山水田园诗人，也长久成为后代士大夫安顿身心的精神家园。",
    "start": 238.3,
    "end": 246.7,
    "duration": 8.4
  }
]
