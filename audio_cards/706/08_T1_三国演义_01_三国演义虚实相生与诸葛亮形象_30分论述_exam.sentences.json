[
  {
    "id": 1,
    "text": "为了开篇直击考点要害并确立学术基调，",
    "start": 0.08,
    "end": 3.44,
    "duration": 3.36
  },
  {
    "id": 2,
    "text": "第一句必须给出小说在体裁史上的开创性地位与章学诚的权威定评。",
    "start": 3.44,
    "end": 9.44,
    "duration": 6.0
  },
  {
    "id": 3,
    "text": "所以表述为：《三国演义》是中国文学史上第一部成熟的章回体长篇历史演义小说，",
    "start": 9.44,
    "end": 16.32,
    "duration": 6.88
  },
  {
    "id": 4,
    "text": "清代史学家章学诚在《文史通义》中精辟概括其艺术精髓为“七分实事，",
    "start": 16.32,
    "end": 22.32,
    "duration": 6.0
  },
  {
    "id": 5,
    "text": "三分虚构”。",
    "start": 22.32,
    "end": 23.04,
    "duration": 0.72
  },
  {
    "id": 6,
    "text": "紧接着必须点明作者罗贯中的历史依据与核心创作范式，",
    "start": 23.36,
    "end": 27.92,
    "duration": 4.56
  },
  {
    "id": 7,
    "text": "引出全书的艺术本质。",
    "start": 27.92,
    "end": 29.84,
    "duration": 1.92
  },
  {
    "id": 8,
    "text": "所以表述为：作者罗贯中依托汉末三国波澜壮阔的历史风云，",
    "start": 29.84,
    "end": 34.72,
    "duration": 4.88
  },
  {
    "id": 9,
    "text": "开创了虚实相生的美学范式。",
    "start": 34.72,
    "end": 37.12,
    "duration": 2.4
  },
  {
    "id": 10,
    "text": "随后必须立即引入题目所指涉的核心人物，",
    "start": 37.12,
    "end": 40.48,
    "duration": 3.36
  },
  {
    "id": 11,
    "text": "指出诸葛亮在全书宏大人物网络中的顶峰地位。",
    "start": 40.48,
    "end": 44.0,
    "duration": 3.52
  },
  {
    "id": 12,
    "text": "所以表述为：在全书星罗棋布的英雄谱系中，",
    "start": 44.32,
    "end": 47.92,
    "duration": 3.6
  },
  {
    "id": 13,
    "text": "诸葛亮是全书塑造最为成功的核心典型。",
    "start": 47.92,
    "end": 51.28,
    "duration": 3.36
  },
  {
    "id": 14,
    "text": "最后一句必须引入毛宗岗的权威评语，",
    "start": 51.28,
    "end": 54.16,
    "duration": 2.88
  },
  {
    "id": 15,
    "text": "并从道德理想与艺术虚构的交融维度进行立论收束。",
    "start": 54.16,
    "end": 58.24,
    "duration": 4.08
  },
  {
    "id": 16,
    "text": "所以表述为：清代毛宗岗尊其为三国“三绝”中之“智绝”，",
    "start": 58.24,
    "end": 62.8,
    "duration": 4.56
  },
  {
    "id": 17,
    "text": "生动体现了崇高儒家道德理想与浪漫主义艺术虚构的完美熔铸。",
    "start": 62.8,
    "end": 67.52,
    "duration": 4.72
  },
  {
    "id": 18,
    "text": "本段用四句话完成全篇破题：首句给出章回体演义鼻祖地位与章学诚名评，",
    "start": 67.76,
    "end": 74.48,
    "duration": 6.72
  },
  {
    "id": 19,
    "text": "次句标举虚实相生总原则，第三四句迅速聚焦诸葛亮核心典型，",
    "start": 74.48,
    "end": 80.0,
    "duration": 5.52
  },
  {
    "id": 20,
    "text": "引入毛宗岗智绝定评并点出道德与艺术虚构的统一，",
    "start": 80.0,
    "end": 84.8,
    "duration": 4.8
  },
  {
    "id": 21,
    "text": "下笔沉稳极具章法。",
    "start": 84.8,
    "end": 86.64,
    "duration": 1.84
  },
  {
    "id": 22,
    "text": "所以本段具体答题完整版为：《三国演义》是中国文学史上第一部成熟的章回体长篇历史演义小说，",
    "start": 86.64,
    "end": 94.553,
    "duration": 7.913
  },
  {
    "id": 23,
    "text": "清代史学家章学诚在《文史通义》中精辟概括其艺术精髓为“七分实事，",
    "start": 94.553,
    "end": 100.226,
    "duration": 5.673
  },
  {
    "id": 24,
    "text": "三分虚构”。",
    "start": 100.226,
    "end": 101.037,
    "duration": 0.811
  },
  {
    "id": 25,
    "text": "作者罗贯中依托汉末三国波澜壮阔的历史风云，",
    "start": 101.037,
    "end": 105.089,
    "duration": 4.052
  },
  {
    "id": 26,
    "text": "开创了虚实相生的美学范式。",
    "start": 105.089,
    "end": 107.52,
    "duration": 2.431
  },
  {
    "id": 27,
    "text": "在全书星罗棋布的英雄谱系中，诸葛亮是全书塑造最为成功的核心典型。",
    "start": 107.6,
    "end": 114.0,
    "duration": 6.4
  },
  {
    "id": 28,
    "text": "清代毛宗岗尊其为三国“三绝”中之“智绝”，",
    "start": 114.0,
    "end": 117.6,
    "duration": 3.6
  },
  {
    "id": 29,
    "text": "生动体现了崇高儒家道德理想与浪漫主义艺术虚构的完美熔铸。--",
    "start": 117.6,
    "end": 122.96,
    "duration": 5.36
  }
]