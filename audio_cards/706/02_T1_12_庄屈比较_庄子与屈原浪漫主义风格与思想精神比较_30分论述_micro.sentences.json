[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "庄屈比较·庄子与屈原浪漫主义风格与思想精神比较",
    "start": 0.154,
    "end": 4.886,
    "duration": 4.732
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣先秦南北文化双源对比：先切开“顺世逍遥 vs 殉道美政”的人生根本分歧，",
    "start": 5.525,
    "end": 13.297,
    "duration": 7.772
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "由此解释各自为何一个用“寓言破执”、一个用“香草立志”，",
    "start": 13.605,
    "end": 18.417,
    "duration": 4.812
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "进而点出同样神游九天、庄子超脱虚空而屈原回首旧乡的决定性差异，最后合论浪漫双基。",
    "start": 18.645,
    "end": 26.657,
    "duration": 8.012
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "庄子与屈原是古代浪漫主义两大源头，分表北方中原文化与南方荆楚文化。",
    "start": 27.178,
    "end": 33.59,
    "duration": 6.412
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "庄子奇幻诡谲（鲁迅赞“晚周诸子之作，莫能先也”），屈原奇伟瑰丽开创辞赋诗风。",
    "start": 33.868,
    "end": 41.24,
    "duration": 7.372
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 生命道路：无待逍遥 vs 美政忠贞",
    "start": 41.948,
    "end": 45.96,
    "duration": 4.012
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "立足“道”齐同物我，从名利倾轧中解脱，宁“曳尾于涂中”不受庙堂束缚，以退隐护守心灵自由；",
    "start": 46.488,
    "end": 58.18,
    "duration": 11.692
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "紧系个人与楚国存亡，坚持修明法度、举贤授能“美政”理想，誓言“虽九死其犹未悔”，以殉道彰显风骨。",
    "start": 58.558,
    "end": 69.53,
    "duration": 10.972
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 表现载体：三言寓言阐理 vs 香草美人抒情",
    "start": 69.995,
    "end": 74.407,
    "duration": 4.412
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "建“寓言、重言、卮言”，借《庖丁解牛》依乎天理、《秋水》鹓雏腐鼠嘲弄机心，破除执念；",
    "start": 74.876,
    "end": 84.568,
    "duration": 9.692
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "创立“香草美人”体系：辟芷秋兰喻高洁，恶草喻奸佞，美人寄托贤君知己，借象征高扬人格。",
    "start": 85.096,
    "end": 94.548,
    "duration": 9.452
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 神游方向：超脱尘世 vs 俯瞰跌回旧乡",
    "start": 95.248,
    "end": 99.74,
    "duration": 4.492
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《逍遥游》大鹏“水击三千里，抟扶摇而上者九万里”，自在遨游而现实化为虚空，导向精神解脱；",
    "start": 100.247,
    "end": 110.179,
    "duration": 9.932
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《离骚》叩九重天门却于云霓之上“陟升皇之赫戏兮，忽临睨夫旧乡”，仆夫悲、马怀而不前，剧烈跌回现实悲剧。",
    "start": 110.707,
    "end": 123.919,
    "duration": 13.212
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 共筑浪漫基因、双向滋养后代",
    "start": 124.594,
    "end": 127.966,
    "duration": 3.372
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "以汪洋气势与超脱灵气启迪魏晋玄风、陶渊明隐逸及李白盛唐豪迈；",
    "start": 128.419,
    "end": 136.191,
    "duration": 7.772
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "以忠贞与香草美人培育士人担当，滋养杜甫沉郁诗史与历代爱国诗文，共成浪漫两大基石。",
    "start": 136.719,
    "end": 146.491,
    "duration": 9.772
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "庄屈将奇伟浪漫想象推向极致，却分归超脱尘网与坚守家国：庄子寓言注入清旷哲理，",
    "start": 147.199,
    "end": 155.451,
    "duration": 8.252
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "屈原香草美人培育家国品格，共筑古典浪漫源头。",
    "start": 155.759,
    "end": 160.171,
    "duration": 4.412
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：庄子代表先秦北方中原道家文化，屈原代表南方荆楚文化；庄屈在想象方向上极易混淆，关键句记“忽临睨夫旧乡”。",
    "start": 160.879,
    "end": 172.781,
    "duration": 11.902
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 庄子与屈原在“文化地域、生命态度、表意载体”上的三重对照？",
    "start": 173.463,
    "end": 180.035,
    "duration": 6.572
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 如何用“忽临睨夫旧乡”一句点穿庄屈神游想象的本质分野？",
    "start": 180.546,
    "end": 187.198,
    "duration": 6.652
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 二者分别启迪了后世哪几家代表作家或诗风？",
    "start": 187.726,
    "end": 192.698,
    "duration": 4.972
  }
]