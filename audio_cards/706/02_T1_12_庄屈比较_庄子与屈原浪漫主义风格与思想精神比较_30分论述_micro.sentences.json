[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣先秦南北文化双源对比：",
    "start": 0.0,
    "end": 3.32,
    "duration": 3.32
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先切开“顺世逍遥 vs 殉道美政”的人生根本分歧，",
    "start": 3.369,
    "end": 7.209,
    "duration": 3.84
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "由此解释各自为何一个用“寓言破执”、一个用“香草立志”，",
    "start": 7.659,
    "end": 11.819,
    "duration": 4.16
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "进而点出同样神游九天、庄子超脱虚空而屈原回首旧乡的决定性差异，",
    "start": 12.269,
    "end": 17.749,
    "duration": 5.48
  },
  {
    "id": "hook_c4",
    "dom_key": "hook_c4",
    "text": "最后合论浪漫双基。",
    "start": 18.199,
    "end": 19.879,
    "duration": 1.68
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "庄子与屈原是古代浪漫主义两大源头，分表北方中原文化与南方荆楚文化。",
    "start": 20.329,
    "end": 26.409,
    "duration": 6.08
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "庄子奇幻诡谲（鲁迅赞“晚周诸子之作，莫能先也”），",
    "start": 26.859,
    "end": 30.699,
    "duration": 3.84
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "屈原奇伟瑰丽开创辞赋诗风。",
    "start": 31.229,
    "end": 33.949,
    "duration": 2.72
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 生命道路：无待逍遥 vs 美政忠贞",
    "start": 34.399,
    "end": 38.239,
    "duration": 3.84
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "立足“道”齐同物我，从名利倾轧中解脱，宁“曳尾于涂中”不受庙堂束缚，",
    "start": 38.769,
    "end": 44.689,
    "duration": 5.92
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "以退隐护守心灵自由；",
    "start": 45.139,
    "end": 47.019,
    "duration": 1.88
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "紧系个人与楚国存亡，坚持修明法度、举贤授能“美政”理想，",
    "start": 47.469,
    "end": 52.189,
    "duration": 4.72
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "誓言“虽九死其犹未悔”，以殉道彰显风骨。",
    "start": 52.639,
    "end": 56.319,
    "duration": 3.68
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 表现载体：三言寓言阐理 vs 香草美人抒情",
    "start": 56.769,
    "end": 61.329,
    "duration": 4.56
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "建“寓言、重言、卮言”，",
    "start": 61.779,
    "end": 63.899,
    "duration": 2.12
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "借《庖丁解牛》依乎天理、《秋水》鹓雏腐鼠嘲弄机心，破除执念；",
    "start": 64.349,
    "end": 69.429,
    "duration": 5.08
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "创立“香草美人”体系：辟芷秋兰喻高洁，恶草喻奸佞，美人寄托贤君知己，",
    "start": 69.879,
    "end": 75.879,
    "duration": 6.0
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "借象征高扬人格。",
    "start": 76.409,
    "end": 77.929,
    "duration": 1.52
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 神游方向：超脱尘世 vs 俯瞰跌回旧乡",
    "start": 78.459,
    "end": 82.819,
    "duration": 4.36
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《逍遥游》大鹏“水击三千里，抟扶摇而上者九万里”，",
    "start": 83.269,
    "end": 87.269,
    "duration": 4.0
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "自在遨游而现实化为虚空，导向精神解脱；",
    "start": 87.719,
    "end": 91.239,
    "duration": 3.52
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《离骚》叩九重天门却于云霓之上“陟升皇之赫戏兮，忽临睨夫旧乡”，",
    "start": 91.689,
    "end": 97.089,
    "duration": 5.4
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "仆夫悲、马怀而不前，剧烈跌回现实悲剧。",
    "start": 97.539,
    "end": 100.899,
    "duration": 3.36
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 共筑浪漫基因、双向滋养后代",
    "start": 101.349,
    "end": 104.749,
    "duration": 3.4
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "以汪洋气势与超脱灵气启迪魏晋玄风、陶渊明隐逸及李白盛唐豪迈；",
    "start": 105.199,
    "end": 111.159,
    "duration": 5.96
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "以忠贞与香草美人培育士人担当，滋养杜甫沉郁诗史与历代爱国诗文，",
    "start": 111.609,
    "end": 117.329,
    "duration": 5.72
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "共成浪漫两大基石。",
    "start": 117.779,
    "end": 119.459,
    "duration": 1.68
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "庄屈将奇伟浪漫想象推向极致，却分归超脱尘网与坚守家国：",
    "start": 119.909,
    "end": 125.349,
    "duration": 5.44
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "庄子寓言注入清旷哲理，屈原香草美人培育家国品格，共筑古典浪漫源头。",
    "start": 125.799,
    "end": 131.999,
    "duration": 6.2
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：庄子代表先秦北方中原道家文化，屈原代表南方荆楚文化；",
    "start": 132.449,
    "end": 138.169,
    "duration": 5.72
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "庄屈在想象方向上极易混淆，关键句记“忽临睨夫旧乡”。",
    "start": 138.619,
    "end": 143.339,
    "duration": 4.72
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 庄子与屈原在“文化地域、生命态度、表意载体”上的三重对照？",
    "start": 143.789,
    "end": 150.069,
    "duration": 6.28
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 如何用“忽临睨夫旧乡”一句点穿庄屈神游想象的本质分野？",
    "start": 150.519,
    "end": 156.719,
    "duration": 6.2
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 二者分别启迪了后世哪几家代表作家或诗风？",
    "start": 157.249,
    "end": 162.449,
    "duration": 5.2
  }
]