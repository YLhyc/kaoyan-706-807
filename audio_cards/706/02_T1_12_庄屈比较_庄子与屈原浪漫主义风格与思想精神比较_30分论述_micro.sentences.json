[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "庄屈比较·庄子与屈原浪漫主义风格与思想精神比较",
    "start": 0.274,
    "end": 4.926,
    "duration": 4.652
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣先秦南北文化双源对比：先切开“顺世逍遥 vs 殉道美政”的人生根本分歧，",
    "start": 5.974,
    "end": 13.986,
    "duration": 8.012
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "由此解释各自为何一个用“寓言破执”、一个用“香草立志”，",
    "start": 14.374,
    "end": 18.826,
    "duration": 4.452
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "进而点出同样神游九天、庄子超脱虚空而屈原回首旧乡的决定性差异，最后合论浪漫双基。",
    "start": 19.134,
    "end": 27.226,
    "duration": 8.092
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "庄子与屈原是古代浪漫主义两大源头，分表北方中原文化与南方荆楚文化。",
    "start": 28.194,
    "end": 35.406,
    "duration": 7.212
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "庄子奇幻诡谲（鲁迅赞“晚周诸子之作，莫能先也”），屈原奇伟瑰丽开创辞赋诗风。",
    "start": 36.414,
    "end": 44.266,
    "duration": 7.852
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 生命道路：无待逍遥 vs 美政忠贞",
    "start": 45.234,
    "end": 48.846,
    "duration": 3.612
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "立足“道”齐同物我，从名利倾轧中解脱，宁“曳尾于涂中”不受庙堂束缚，以退隐护守心灵自由；",
    "start": 49.894,
    "end": 58.146,
    "duration": 8.252
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "紧系个人与楚国存亡，坚持修明法度、举贤授能“美政”理想，誓言“虽九死其犹未悔”，以殉道彰显风骨。",
    "start": 59.354,
    "end": 69.486,
    "duration": 10.132
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 表现载体：三言寓言阐理 vs 香草美人抒情",
    "start": 70.374,
    "end": 75.426,
    "duration": 5.052
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "建“寓言、重言、卮言”，借《庖丁解牛》依乎天理、《秋水》鹓雏腐鼠嘲弄机心，破除执念；",
    "start": 76.474,
    "end": 86.006,
    "duration": 9.532
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "创立“香草美人”体系：辟芷秋兰喻高洁，恶草喻奸佞，美人寄托贤君知己，借象征高扬人格。",
    "start": 87.014,
    "end": 95.946,
    "duration": 8.932
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 神游方向：超脱尘世 vs 俯瞰跌回旧乡",
    "start": 96.994,
    "end": 101.526,
    "duration": 4.532
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《逍遥游》大鹏“水击三千里，抟扶摇而上者九万里”，自在遨游而现实化为虚空，导向精神解脱；",
    "start": 102.274,
    "end": 112.326,
    "duration": 10.052
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《离骚》叩九重天门却于云霓之上“陟升皇之赫戏兮，忽临睨夫旧乡”，仆夫悲、马怀而不前，剧烈跌回现实悲剧。",
    "start": 113.294,
    "end": 124.426,
    "duration": 11.132
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 共筑浪漫基因、双向滋养后代",
    "start": 125.434,
    "end": 128.726,
    "duration": 3.292
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "以汪洋气势与超脱灵气启迪魏晋玄风、陶渊明隐逸及李白盛唐豪迈；",
    "start": 129.734,
    "end": 137.426,
    "duration": 7.692
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "以忠贞与香草美人培育士人担当，滋养杜甫沉郁诗史与历代爱国诗文，共成浪漫两大基石。",
    "start": 138.474,
    "end": 148.046,
    "duration": 9.572
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "庄屈将奇伟浪漫想象推向极致，却分归超脱尘网与坚守家国：庄子寓言注入清旷哲理，",
    "start": 149.054,
    "end": 158.666,
    "duration": 9.612
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "屈原香草美人培育家国品格，共筑古典浪漫源头。",
    "start": 159.054,
    "end": 163.546,
    "duration": 4.492
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：庄子代表先秦北方中原道家文化，屈原代表南方荆楚文化；庄屈在想象方向上极易混淆，关键句记“忽临睨夫旧乡”。",
    "start": 164.594,
    "end": 177.106,
    "duration": 12.512
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 庄子与屈原在“文化地域、生命态度、表意载体”上的三重对照？",
    "start": 178.114,
    "end": 184.886,
    "duration": 6.772
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 如何用“忽临睨夫旧乡”一句点穿庄屈神游想象的本质分野？",
    "start": 185.854,
    "end": 193.106,
    "duration": 7.252
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 二者分别启迪了后世哪几家代表作家或诗风？",
    "start": 194.074,
    "end": 199.206,
    "duration": 5.132
  }
]