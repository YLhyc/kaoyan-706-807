[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "急救卡·古代文学跨代母题链与比较四维法",
    "start": 0.134,
    "end": 3.922,
    "duration": 3.788
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "双引擎考试急救工具：遇未背跨代演变大题直接抽出“诗史、浪漫、市井女性、隐逸田园”四条纵向母题链拼装；",
    "start": 4.498,
    "end": 15.057,
    "duration": 10.559
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "遇陌生双家比较题一律套用“题材→心态→技法→史位”四维横切同框对敲，严禁前甲后乙两张皮！",
    "start": 15.37,
    "end": 24.05,
    "duration": 8.68
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "考场遇手卷未收原题的跨代演变或陌生比较大题，可调取已背单篇要点，",
    "start": 24.624,
    "end": 31.238,
    "duration": 6.614
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "依托“四条纵向母题链”与“比较横切四维法”快速拼装成篇。",
    "start": 31.447,
    "end": 35.938,
    "duration": 4.491
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 链条一：现实主义与“诗史”精神链",
    "start": 36.525,
    "end": 40.222,
    "duration": 3.697
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "《诗经》风雅写民苦→汉乐府“感于哀乐，缘事而发”重叙事→杜甫即事名篇立“诗史”→白居易新乐府倡讽谕救时弊；",
    "start": 40.809,
    "end": 52.11,
    "duration": 11.301
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "由民间自然咏叹、两汉底层叙事定型，演进至唐代儒者自觉记录动乱与针砭政治。",
    "start": 52.697,
    "end": 61.081,
    "duration": 8.384
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 链条二：浪漫抒情与狂狷精神链",
    "start": 61.668,
    "end": 65.352,
    "duration": 3.684
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《庄子》寓言汪洋恣肆→屈原《离骚》香草美人铸忠怨→李白放歌抒盛唐狂傲→苏轼“以诗为词”拓旷达超脱；",
    "start": 65.939,
    "end": 77.071,
    "duration": 11.132
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "战国逍遥与抗争交汇，在盛唐张扬为个体自信，经宋代贬谪淬炼化为逆境自适境界。",
    "start": 77.658,
    "end": 86.745,
    "duration": 9.088
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 链条三：市井觉醒与女性悲剧链",
    "start": 87.332,
    "end": 91.16,
    "duration": 3.827
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《窦娥冤》控酷吏冤狱→《西厢记》争婚姻自主→《牡丹亭》倡生死至情→《红楼梦》写宝黛情殇与宗法挽歌；",
    "start": 91.733,
    "end": 102.735,
    "duration": 11.002
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "随市民阶层壮大，由承受外部官僚迫害抗争，转向礼教压抑追问直至揭示整个宗法体制腐朽衰落。",
    "start": 103.322,
    "end": 113.008,
    "duration": 9.686
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 链条四：隐逸情怀与山水田园链",
    "start": 113.595,
    "end": 117.423,
    "duration": 3.827
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "陶渊明躬耕冲淡真淳→王维静逸禅意、孟浩然清淡自然→范成大《四时田园杂兴》直面农事劳苦；",
    "start": 118.01,
    "end": 128.412,
    "duration": 10.403
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "由六朝守节独善、盛唐空灵观照，发展到南宋兼纳写实令稼穑租税成重心。",
    "start": 128.986,
    "end": 136.772,
    "duration": 7.785
  },
  {
    "id": "sec4_title_c0",
    "dom_key": "sec4_title_c0",
    "text": "05 · 技法总纲：比较题“横切四维法”拼装公式",
    "start": 137.358,
    "end": 141.316,
    "duration": 3.957
  },
  {
    "id": "sec4_step0_c0",
    "dom_key": "sec4_step0_c0",
    "text": "严禁先写完甲再写完乙！",
    "start": 141.903,
    "end": 145.365,
    "duration": 3.463
  },
  {
    "id": "sec4_step0_c1",
    "dom_key": "sec4_step0_c1",
    "text": "统一“横切四维法”同框对敲：一比题材选材取向、二比创作心态与时代境遇、三比意象结构与语言声律、四比文体演变承接地位；",
    "start": 145.939,
    "end": 157.084,
    "duration": 11.145
  },
  {
    "id": "sec4_step1_c0",
    "dom_key": "sec4_step1_c0",
    "text": "每段紧扣各自一句代表作或人物交错对读，稳固不失点。",
    "start": 157.658,
    "end": 163.712,
    "duration": 6.054
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：考场遇陌生比较大题，严禁“先写完甲再写完乙（两张皮）”，必须按“四维横切”每段同时对敲甲乙！",
    "start": 164.286,
    "end": 174.05,
    "duration": 9.765
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 合书一口气背全古代文学“现实诗史 / 浪漫狂狷 / 女性市井 / 山水田园”4条×4节点母题链？",
    "start": 174.637,
    "end": 184.936,
    "duration": 10.298
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 面对陌生比较题（如柳永vs周邦彦/高适vs岑参）怎样即时套出四段大纲？",
    "start": 185.51,
    "end": 194.141,
    "duration": 8.632
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 考场比较题的大忌是什么？每段例证该如何安排？",
    "start": 194.715,
    "end": 200.73,
    "duration": 6.015
  }
]