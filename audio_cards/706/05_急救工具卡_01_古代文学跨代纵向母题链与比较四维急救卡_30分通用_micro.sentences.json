[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "急救卡·古代文学跨代母题链与比较四维法",
    "start": 0.314,
    "end": 4.166,
    "duration": 3.852
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "双引擎考试急救工具：遇未背跨代演变大题直接抽出“诗史、浪漫、市井女性、隐逸田园”四条纵向母题链拼装；",
    "start": 5.174,
    "end": 15.586,
    "duration": 10.412
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "遇陌生双家比较题一律套用“题材→心态→技法→史位”四维横切同框对敲，严禁前甲后乙两张皮！",
    "start": 16.634,
    "end": 25.406,
    "duration": 8.772
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "考场遇手卷未收原题的跨代演变或陌生比较大题，可调取已背单篇要点，",
    "start": 26.454,
    "end": 32.906,
    "duration": 6.452
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "依托“四条纵向母题链”与“比较横切四维法”快速拼装成篇。",
    "start": 33.294,
    "end": 38.146,
    "duration": 4.852
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 链条一：现实主义与“诗史”精神链",
    "start": 39.194,
    "end": 42.846,
    "duration": 3.652
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "《诗经》风雅写民苦→汉乐府“感于哀乐，缘事而发”重叙事→杜甫即事名篇立“诗史”→白居易新乐府倡讽谕救时弊；",
    "start": 43.814,
    "end": 57.466,
    "duration": 13.652
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "由民间自然咏叹、两汉底层叙事定型，演进至唐代儒者自觉记录动乱与针砭政治。",
    "start": 58.434,
    "end": 67.366,
    "duration": 8.932
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 链条二：浪漫抒情与狂狷精神链",
    "start": 68.294,
    "end": 71.906,
    "duration": 3.612
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《庄子》寓言汪洋恣肆→屈原《离骚》香草美人铸忠怨→李白放歌抒盛唐狂傲→苏轼“以诗为词”拓旷达超脱；",
    "start": 72.834,
    "end": 85.246,
    "duration": 12.412
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "战国逍遥与抗争交汇，在盛唐张扬为个体自信，经宋代贬谪淬炼化为逆境自适境界。",
    "start": 86.174,
    "end": 95.226,
    "duration": 9.052
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 链条三：市井觉醒与女性悲剧链",
    "start": 96.154,
    "end": 99.526,
    "duration": 3.372
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《窦娥冤》控酷吏冤狱→《西厢记》争婚姻自主→《牡丹亭》倡生死至情→《红楼梦》写宝黛情殇与宗法挽歌；",
    "start": 100.226,
    "end": 112.838,
    "duration": 12.612
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "随市民阶层壮大，由承受外部官僚迫害抗争，转向礼教压抑追问直至揭示整个宗法体制腐朽衰落。",
    "start": 113.846,
    "end": 124.258,
    "duration": 10.412
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 链条四：隐逸情怀与山水田园链",
    "start": 125.226,
    "end": 129.078,
    "duration": 3.852
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "陶渊明躬耕冲淡真淳→王维静逸禅意、孟浩然清淡自然→范成大《四时田园杂兴》直面农事劳苦；",
    "start": 130.086,
    "end": 140.698,
    "duration": 10.612
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "由六朝守节独善、盛唐空灵观照，发展到南宋兼纳写实令稼穑租税成重心。",
    "start": 141.626,
    "end": 150.118,
    "duration": 8.492
  },
  {
    "id": "sec4_title_c0",
    "dom_key": "sec4_title_c0",
    "text": "05 · 技法总纲：比较题“横切四维法”拼装公式",
    "start": 151.006,
    "end": 155.218,
    "duration": 4.212
  },
  {
    "id": "sec4_step0_c0",
    "dom_key": "sec4_step0_c0",
    "text": "严禁先写完甲再写完乙！",
    "start": 156.226,
    "end": 159.398,
    "duration": 3.172
  },
  {
    "id": "sec4_step0_c1",
    "dom_key": "sec4_step0_c1",
    "text": "统一“横切四维法”同框对敲：一比题材选材取向、二比创作心态与时代境遇、三比意象结构与语言声律、四比文体演变承接地位；",
    "start": 160.326,
    "end": 170.898,
    "duration": 10.572
  },
  {
    "id": "sec4_step1_c0",
    "dom_key": "sec4_step1_c0",
    "text": "每段紧扣各自一句代表作或人物交错对读，稳固不失点。",
    "start": 171.826,
    "end": 177.398,
    "duration": 5.572
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：考场遇陌生比较大题，严禁“先写完甲再写完乙（两张皮）”，必须按“四维横切”每段同时对敲甲乙！",
    "start": 178.406,
    "end": 188.338,
    "duration": 9.932
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 合书一口气背全古代文学“现实诗史 / 浪漫狂狷 / 女性市井 / 山水田园”4条×4节点母题链？",
    "start": 189.266,
    "end": 199.518,
    "duration": 10.252
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 面对陌生比较题（如柳永vs周邦彦/高适vs岑参）怎样即时套出四段大纲？",
    "start": 200.186,
    "end": 209.278,
    "duration": 9.092
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 考场比较题的大忌是什么？每段例证该如何安排？",
    "start": 210.286,
    "end": 216.558,
    "duration": 6.272
  }
]