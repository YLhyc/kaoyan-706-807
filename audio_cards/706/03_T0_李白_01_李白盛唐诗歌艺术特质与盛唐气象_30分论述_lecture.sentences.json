[
  {
    "id": 1,
    "text": "全局宏观破题与立论逻辑。",
    "start": 0.16,
    "end": 2.88,
    "duration": 2.72
  },
  {
    "id": 2,
    "text": "在考场下笔之前，必须先在宏观上审清这道三十分大题的核心考核意图。",
    "start": 2.88,
    "end": 9.36,
    "duration": 6.48
  },
  {
    "id": 3,
    "text": "本题表面上考查李白的艺术特色，本质上考查盛唐时代气象与诗人主体人格的诗学同构。",
    "start": 9.36,
    "end": 17.36,
    "duration": 8.0
  },
  {
    "id": 4,
    "text": "考场评分标准绝不满足于仅孤立背诵豪放狂放等成语标签。",
    "start": 17.36,
    "end": 22.24,
    "duration": 4.88
  },
  {
    "id": 5,
    "text": "答题方向必须确立为“从盛唐气象投射出的昂扬主体人格，",
    "start": 22.56,
    "end": 28.08,
    "duration": 5.52
  },
  {
    "id": 6,
    "text": "推进到极度夸张的浪漫想象与超现实幻境，",
    "start": 28.08,
    "end": 32.32,
    "duration": 4.24
  },
  {
    "id": 7,
    "text": "再深入到奔腾起伏的篇章音乐结构，",
    "start": 32.32,
    "end": 35.52,
    "duration": 3.2
  },
  {
    "id": 8,
    "text": "最终落地至天然纯净的绝句语言与乐府新变”的因果推进。",
    "start": 35.52,
    "end": 40.96,
    "duration": 5.44
  },
  {
    "id": 9,
    "text": "整道大题在宏观上划分为五个有机递进的逻辑层次：第一层，",
    "start": 40.96,
    "end": 46.4,
    "duration": 5.44
  },
  {
    "id": 10,
    "text": "开篇破题，借杜甫“诗无敌”与严羽“结盛唐之局”，",
    "start": 46.4,
    "end": 51.36,
    "duration": 4.96
  },
  {
    "id": 11,
    "text": "确立李白作为盛唐浪漫主义第一峰的崇高地位。",
    "start": 51.36,
    "end": 55.28,
    "duration": 3.92
  },
  {
    "id": 12,
    "text": "第二层，论述时代与人格，剖析盛唐大一统时代自信与“安能摧眉折腰”傲岸品格的内在交融。",
    "start": 55.28,
    "end": 63.84,
    "duration": 8.56
  },
  {
    "id": 13,
    "text": "第三层，论述宏观想象力，以《梦游天姥吟留别》仙境与飞流三千尺为例，",
    "start": 63.84,
    "end": 70.48,
    "duration": 6.64
  },
  {
    "id": 14,
    "text": "阐释超现实空间建构。",
    "start": 70.48,
    "end": 72.16,
    "duration": 1.68
  },
  {
    "id": 15,
    "text": "第四层，论述篇章与节奏，以《将进酒》为例，",
    "start": 72.48,
    "end": 76.4,
    "duration": 3.92
  },
  {
    "id": 16,
    "text": "剖析黄河之水天上来起势与大起大落的情感喷薄。",
    "start": 76.4,
    "end": 81.44,
    "duration": 5.04
  },
  {
    "id": 17,
    "text": "第五层，落地至诗体与语言，阐释“清水出芙蓉”的天然诗美与绝句浑然天成的神韵。",
    "start": 81.44,
    "end": 89.76,
    "duration": 8.32
  },
  {
    "id": 18,
    "text": "尾部收官，以李杜并峙为总结，交代其对韩愈、",
    "start": 89.76,
    "end": 93.84,
    "duration": 4.08
  },
  {
    "id": 19,
    "text": "李贺奇崛风貌与苏轼豪迈词派的深远启迪。",
    "start": 93.84,
    "end": 97.6,
    "duration": 3.76
  },
  {
    "id": 20,
    "text": "这五个层次构成一条不可逆的因果链条：盛唐时代是土壤，",
    "start": 97.84,
    "end": 103.2,
    "duration": 5.36
  },
  {
    "id": 21,
    "text": "傲岸自信是灵魂，奇崛想象是翅膀，",
    "start": 103.2,
    "end": 106.56,
    "duration": 3.36
  },
  {
    "id": 22,
    "text": "喷薄语流是脉络，清水芙蓉是语言，",
    "start": 106.56,
    "end": 109.92,
    "duration": 3.36
  },
  {
    "id": 23,
    "text": "李杜并峙是历史定型。",
    "start": 109.92,
    "end": 112.0,
    "duration": 2.08
  },
  {
    "id": 24,
    "text": "理顺了宏观全局思路，接下来进入每一段的具体推导与逐句表述。--。",
    "start": 112.0,
    "end": 117.04,
    "duration": 5.04
  },
  {
    "id": 25,
    "text": "第一段：首段破题与概念定性。",
    "start": 117.36,
    "end": 120.08,
    "duration": 2.72
  },
  {
    "id": 26,
    "text": "逐句因果推导与答题表述。",
    "start": 120.08,
    "end": 122.72,
    "duration": 2.64
  },
  {
    "id": 27,
    "text": "首句必须直击核心地位，确立其浪漫主义诗歌巅峰与“诗仙”尊号。",
    "start": 122.72,
    "end": 128.32,
    "duration": 5.6
  },
  {
    "id": 28,
    "text": "所以表述为：李白是中国古典浪漫主义诗歌的巅峰集大成者，",
    "start": 128.32,
    "end": 133.84,
    "duration": 5.52
  },
  {
    "id": 29,
    "text": "后世尊称为“诗仙”。",
    "start": 133.84,
    "end": 135.6,
    "duration": 1.76
  },
  {
    "id": 30,
    "text": "次句必须引入同代诗圣杜甫的至高赞誉，",
    "start": 135.6,
    "end": 139.2,
    "duration": 3.6
  },
  {
    "id": 31,
    "text": "确立才绝古今的文学史公论。",
    "start": 139.2,
    "end": 141.6,
    "duration": 2.4
  },
  {
    "id": 32,
    "text": "所以表述为：杜甫在《春日忆李白》中盛赞其“白也诗无敌，",
    "start": 141.92,
    "end": 146.88,
    "duration": 4.96
  },
  {
    "id": 33,
    "text": "飘然思不群”，极写其绝世才华。",
    "start": 146.88,
    "end": 149.68,
    "duration": 2.8
  },
  {
    "id": 34,
    "text": "第三句引入诗论权威严羽在《沧浪诗话》中的终极定评，",
    "start": 149.68,
    "end": 153.92,
    "duration": 4.24
  },
  {
    "id": 35,
    "text": "点明其终结盛唐格局的地位。",
    "start": 153.92,
    "end": 156.32,
    "duration": 2.4
  },
  {
    "id": 36,
    "text": "所以表述为：严羽在《沧浪诗话》中指出李白与杜甫“一结盛唐之局”，",
    "start": 156.32,
    "end": 162.376,
    "duration": 6.056
  },
  {
    "id": 37,
    "text": "确立了盛唐诗歌的至高法则。",
    "start": 162.376,
    "end": 164.856,
    "duration": 2.48
  },
  {
    "id": 38,
    "text": "第四句引入考研权威教材依据，指出李白诗歌是盛唐时代精神的绚烂投影。",
    "start": 164.856,
    "end": 171.096,
    "duration": 6.24
  },
  {
    "id": 39,
    "text": "所以表述为：袁行配《中国文学史》指出，",
    "start": 171.096,
    "end": 174.456,
    "duration": 3.36
  },
  {
    "id": 40,
    "text": "李白诗歌是盛唐时代精神最集中、最绚烂的诗学投影。",
    "start": 174.456,
    "end": 178.856,
    "duration": 4.4
  },
  {
    "id": 41,
    "text": "第五句概括其美学风貌，说明他将古典浪漫主义推上了空前绝后的境地。",
    "start": 179.096,
    "end": 185.298,
    "duration": 6.202
  },
  {
    "id": 42,
    "text": "所以表述为：他以昂扬自信的精神气度与飞扬凌厉的艺术天才，",
    "start": 185.298,
    "end": 191.024,
    "duration": 5.726
  },
  {
    "id": 43,
    "text": "将古典浪漫主义推上了空前绝后的境地。",
    "start": 191.024,
    "end": 194.769,
    "duration": 3.745
  },
  {
    "id": 44,
    "text": "第六句作为首段过渡句，宣告下文将从四个核心维度展开系统论述。",
    "start": 194.769,
    "end": 200.936,
    "duration": 6.167
  },
  {
    "id": 45,
    "text": "所以表述为：其核心艺术特质与盛唐气象的交融，",
    "start": 201.096,
    "end": 205.096,
    "duration": 4.0
  },
  {
    "id": 46,
    "text": "主要展现在以下四个核心维度：本段答题思路总结。",
    "start": 205.096,
    "end": 209.096,
    "duration": 4.0
  },
  {
    "id": 47,
    "text": "本段用六句话完成立论闭环：先直接亮出浪漫主义巅峰与“诗仙”坐标；",
    "start": 209.096,
    "end": 214.856,
    "duration": 5.76
  },
  {
    "id": 48,
    "text": "随后调引杜甫“白也诗无敌”与严羽“一结盛唐之局”的双重权威定论；",
    "start": 214.856,
    "end": 220.296,
    "duration": 5.44
  },
  {
    "id": 49,
    "text": "接着借助袁行配教材将李白确立为盛唐时代精神的至高投影；",
    "start": 220.536,
    "end": 225.576,
    "duration": 5.04
  },
  {
    "id": 50,
    "text": "最后自然转入四个维度的展开，开篇严谨大气。",
    "start": 225.576,
    "end": 229.976,
    "duration": 4.4
  },
  {
    "id": 51,
    "text": "所以本段具体答题完整版为：李白是中国古典浪漫主义诗歌的巅峰集大成者，",
    "start": 229.976,
    "end": 235.976,
    "duration": 6.0
  },
  {
    "id": 52,
    "text": "后世尊称为“诗仙”。",
    "start": 235.976,
    "end": 237.976,
    "duration": 2.0
  },
  {
    "id": 53,
    "text": "杜甫在《春日忆李白》中盛赞其“白也诗无敌，",
    "start": 237.976,
    "end": 241.816,
    "duration": 3.84
  },
  {
    "id": 54,
    "text": "飘然思不群”，极写其绝世才华。",
    "start": 241.816,
    "end": 245.176,
    "duration": 3.36
  },
  {
    "id": 55,
    "text": "严羽在《沧浪诗话》中指出李白与杜甫“一结盛唐之局”，",
    "start": 245.416,
    "end": 249.976,
    "duration": 4.56
  },
  {
    "id": 56,
    "text": "确立了盛唐诗歌的至高法则。",
    "start": 249.976,
    "end": 252.456,
    "duration": 2.48
  },
  {
    "id": 57,
    "text": "袁行配《中国文学史》指出，李白诗歌是盛唐时代精神最集中、",
    "start": 252.456,
    "end": 257.896,
    "duration": 5.44
  },
  {
    "id": 58,
    "text": "最绚烂的诗学投影。",
    "start": 257.896,
    "end": 259.656,
    "duration": 1.76
  },
  {
    "id": 59,
    "text": "他以昂扬自信的精神气度与飞扬凌厉的艺术天才，",
    "start": 259.656,
    "end": 263.656,
    "duration": 4.0
  },
  {
    "id": 60,
    "text": "将古典浪漫主义推上了空前绝后的境地。",
    "start": 263.656,
    "end": 266.856,
    "duration": 3.2
  },
  {
    "id": 61,
    "text": "其核心艺术特质与盛唐气象的交融，",
    "start": 267.176,
    "end": 270.296,
    "duration": 3.12
  },
  {
    "id": 62,
    "text": "主要展现在以下四个核心维度：。",
    "start": 270.296,
    "end": 272.776,
    "duration": 2.48
  },
  {
    "id": 63,
    "text": "第二段：第一分论点，盛唐气象的人格投射（骨之“傲”）。",
    "start": 272.776,
    "end": 277.336,
    "duration": 4.56
  },
  {
    "id": 64,
    "text": "逐句因果推导与答题表述。",
    "start": 277.336,
    "end": 279.816,
    "duration": 2.48
  },
  {
    "id": 65,
    "text": "论述李白，首先必须回答他与盛唐气象的内在关系，",
    "start": 279.816,
    "end": 284.376,
    "duration": 4.56
  },
  {
    "id": 66,
    "text": "这是他诗歌精神力量的泉源。",
    "start": 284.376,
    "end": 286.376,
    "duration": 2.0
  },
  {
    "id": 67,
    "text": "首句确立分论点，指出李白诗歌的灵魂是盛唐国力催生的时代自信与自我主体意识。",
    "start": 286.696,
    "end": 294.696,
    "duration": 8.0
  },
  {
    "id": 68,
    "text": "所以表述为：李白诗歌的灵魂是盛唐强盛国力催生出的蓬勃自信，",
    "start": 294.696,
    "end": 300.776,
    "duration": 6.08
  },
  {
    "id": 69,
    "text": "以及强烈的自我主体意识。",
    "start": 300.776,
    "end": 302.936,
    "duration": 2.16
  },
  {
    "id": 70,
    "text": "次句推导因果，说明盛唐开明包容的环境造就了他傲视公卿、",
    "start": 303.304,
    "end": 308.824,
    "duration": 5.52
  },
  {
    "id": 71,
    "text": "任侠狂放的豪迈气概。",
    "start": 308.824,
    "end": 311.064,
    "duration": 2.24
  },
  {
    "id": 72,
    "text": "所以表述为：盛唐政治开明与文化繁荣的氛围，",
    "start": 311.064,
    "end": 315.224,
    "duration": 4.16
  },
  {
    "id": 73,
    "text": "赋予李白傲视公卿、怀才自负的豪迈精神气概。",
    "start": 315.224,
    "end": 319.544,
    "duration": 4.32
  },
  {
    "id": 74,
    "text": "第三句调取名作《宣州谢窕楼建别校书叔云》展现凌云壮志的原句。",
    "start": 319.544,
    "end": 325.864,
    "duration": 6.32
  },
  {
    "id": 75,
    "text": "所以表述为：在《宣州谢窕楼建别校书叔云》中，",
    "start": 326.184,
    "end": 330.012,
    "duration": 3.828
  },
  {
    "id": 76,
    "text": "他豪迈写道：“俱怀逸兴壮思飞，欲上青天揽明月”。",
    "start": 330.012,
    "end": 334.112,
    "duration": 4.1
  },
  {
    "id": 77,
    "text": "第四句即便身处挫折逆境，在《行路难》中依然展现出对未来的坚强信念。",
    "start": 334.112,
    "end": 340.37,
    "duration": 6.258
  },
  {
    "id": 78,
    "text": "所以表述为：即便在政治受挫、行路艰难的绝境中，",
    "start": 340.37,
    "end": 344.685,
    "duration": 4.315
  },
  {
    "id": 79,
    "text": "他在《行路难》中依然坚信：“长风破浪会有时，",
    "start": 344.685,
    "end": 348.354,
    "duration": 3.669
  },
  {
    "id": 80,
    "text": "直挂云帆济沧海”。",
    "start": 348.354,
    "end": 349.864,
    "duration": 1.51
  },
  {
    "id": 81,
    "text": "第五句调取其人格精神最拔俗的高潮，",
    "start": 349.944,
    "end": 353.224,
    "duration": 3.28
  },
  {
    "id": 82,
    "text": "引用傲视权贵的千古绝唱。",
    "start": 353.224,
    "end": 355.784,
    "duration": 2.56
  },
  {
    "id": 83,
    "text": "所以表述为：更为崇高的是其独立不阿的人格尊严，",
    "start": 355.784,
    "end": 359.944,
    "duration": 4.16
  },
  {
    "id": 84,
    "text": "在《梦游天姥吟留别》尾联中怒吼：“安能摧眉折腰事权贵，",
    "start": 359.944,
    "end": 364.504,
    "duration": 4.56
  },
  {
    "id": 85,
    "text": "使我不得开心颜”。",
    "start": 364.504,
    "end": 366.104,
    "duration": 1.6
  },
  {
    "id": 86,
    "text": "第六句收束全段，指出将个体尊严置于权贵之上的反叛精神是盛唐士人最壮丽的写照。",
    "start": 366.104,
    "end": 373.384,
    "duration": 7.28
  },
  {
    "id": 87,
    "text": "所以表述为：这种将个体尊严置于皇权权贵之上的反叛精神，",
    "start": 373.704,
    "end": 379.624,
    "duration": 5.92
  },
  {
    "id": 88,
    "text": "成为盛唐士人最壮丽的心灵写照。",
    "start": 379.624,
    "end": 382.504,
    "duration": 2.88
  },
  {
    "id": 89,
    "text": "本段答题思路总结。",
    "start": 382.504,
    "end": 384.344,
    "duration": 1.84
  },
  {
    "id": 90,
    "text": "本段深入剖析盛唐气象与诗人主体人格的血脉同构：先从盛唐强盛开放的时代背景切入，",
    "start": 384.344,
    "end": 391.704,
    "duration": 7.36
  },
  {
    "id": 91,
    "text": "推导出昂扬自信的主体性格；",
    "start": 391.704,
    "end": 393.944,
    "duration": 2.24
  },
  {
    "id": 92,
    "text": "随后紧扣“欲上青天揽明月”的飞扬壮思、",
    "start": 394.104,
    "end": 398.184,
    "duration": 4.08
  },
  {
    "id": 93,
    "text": "“长风破浪会有时”的百折不挠，以及“安能摧眉折腰”的傲岸风骨；",
    "start": 398.184,
    "end": 404.344,
    "duration": 6.16
  },
  {
    "id": 94,
    "text": "全面论证了李白诗歌正是盛唐士人精神自由与尊严觉醒的最强音。",
    "start": 404.344,
    "end": 410.424,
    "duration": 6.08
  },
  {
    "id": 95,
    "text": "所以本段具体答题完整版为：一、盛唐气象的人格投射：昂扬自信的士人心态与傲视权贵的自由品格。",
    "start": 410.424,
    "end": 418.584,
    "duration": 8.16
  },
  {
    "id": 96,
    "text": "李白诗歌的灵魂是盛唐强盛国力催生出的蓬勃自信，",
    "start": 418.904,
    "end": 423.624,
    "duration": 4.72
  },
  {
    "id": 97,
    "text": "以及强烈的自我主体意识。",
    "start": 423.624,
    "end": 425.944,
    "duration": 2.32
  },
  {
    "id": 98,
    "text": "盛唐政治开明与文化繁荣的氛围，赋予李白傲视公卿、",
    "start": 426.024,
    "end": 430.584,
    "duration": 4.56
  },
  {
    "id": 99,
    "text": "怀才自负的豪迈精神气概。",
    "start": 430.584,
    "end": 433.064,
    "duration": 2.48
  },
  {
    "id": 100,
    "text": "在《宣州谢窕楼建别校书叔云》中，",
    "start": 433.064,
    "end": 435.944,
    "duration": 2.88
  },
  {
    "id": 101,
    "text": "他豪迈写道：“俱怀逸兴壮思飞，欲上青天揽明月”。",
    "start": 435.944,
    "end": 440.584,
    "duration": 4.64
  },
  {
    "id": 102,
    "text": "即便在政治受挫、行路艰难的绝境中，",
    "start": 440.904,
    "end": 444.104,
    "duration": 3.2
  },
  {
    "id": 103,
    "text": "他在《行路难》中依然坚信：“长风破浪会有时，",
    "start": 444.104,
    "end": 448.264,
    "duration": 4.16
  },
  {
    "id": 104,
    "text": "直挂云帆济沧海”。",
    "start": 448.264,
    "end": 449.864,
    "duration": 1.6
  },
  {
    "id": 105,
    "text": "更为崇高的是其独立不阿的人格尊严，",
    "start": 450.152,
    "end": 453.272,
    "duration": 3.12
  },
  {
    "id": 106,
    "text": "在《梦游天姥吟留别》尾联中怒吼：“安能摧眉折腰事权贵，",
    "start": 453.272,
    "end": 458.152,
    "duration": 4.88
  },
  {
    "id": 107,
    "text": "使我不得开心颜”。",
    "start": 458.152,
    "end": 459.592,
    "duration": 1.44
  },
  {
    "id": 108,
    "text": "这种将个体尊严置于皇权权贵之上的反叛精神，",
    "start": 459.592,
    "end": 463.272,
    "duration": 3.68
  },
  {
    "id": 109,
    "text": "成为盛唐士人最壮丽的心灵写照。。",
    "start": 463.272,
    "end": 465.832,
    "duration": 2.56
  },
  {
    "id": 110,
    "text": "第三段：第二分论点，奇绝宏肆的浪漫想象（象之“奇”）。",
    "start": 465.832,
    "end": 469.912,
    "duration": 4.08
  },
  {
    "id": 111,
    "text": "逐句因果推导与答题表述。",
    "start": 470.312,
    "end": 472.792,
    "duration": 2.48
  },
  {
    "id": 112,
    "text": "第二段讲透了内在人格，第三段必须正面攻克其最惊艳的艺术手段，",
    "start": 472.792,
    "end": 478.312,
    "duration": 5.52
  },
  {
    "id": 113,
    "text": "极度开阔的浪漫想象。",
    "start": 478.312,
    "end": 480.072,
    "duration": 1.76
  },
  {
    "id": 114,
    "text": "首句确立分论点，指出李白拥有不受时空限制的想象力，",
    "start": 480.072,
    "end": 484.712,
    "duration": 4.64
  },
  {
    "id": 115,
    "text": "善于融铸神话构建宏大幻境。",
    "start": 484.712,
    "end": 487.272,
    "duration": 2.56
  },
  {
    "id": 116,
    "text": "所以表述为：李白拥有古典诗歌史上最不受拘束的浪漫想象力，",
    "start": 487.272,
    "end": 492.472,
    "duration": 5.2
  },
  {
    "id": 117,
    "text": "长于融铸神话与极度夸张构建幻境。",
    "start": 492.472,
    "end": 495.832,
    "duration": 3.36
  },
  {
    "id": 118,
    "text": "次句调取全书最具代表性的浪漫主义仙境名作《梦游天姥吟留别》。",
    "start": 495.832,
    "end": 501.592,
    "duration": 5.76
  },
  {
    "id": 119,
    "text": "所以表述为：在名作《梦游天姥吟留别》中，",
    "start": 501.592,
    "end": 505.352,
    "duration": 3.76
  },
  {
    "id": 120,
    "text": "他以超现实笔墨描摹出光怪陆离的仙界图景。",
    "start": 505.352,
    "end": 509.192,
    "duration": 3.84
  },
  {
    "id": 121,
    "text": "第三句直接引用群仙盛宴的著名四句原诗。",
    "start": 509.512,
    "end": 514.152,
    "duration": 4.64
  },
  {
    "id": 122,
    "text": "所以表述为：诗中写道：“霓为衣兮风为马，",
    "start": 514.152,
    "end": 518.632,
    "duration": 4.48
  },
  {
    "id": 123,
    "text": "云之君兮纷纷而来下。",
    "start": 518.632,
    "end": 521.192,
    "duration": 2.56
  },
  {
    "id": 124,
    "text": "虎鼓瑟兮鸾回车，仙之人兮列如麻”。",
    "start": 521.192,
    "end": 525.672,
    "duration": 4.48
  },
  {
    "id": 125,
    "text": "第四句剖析这一超现实幻境的审美功能，",
    "start": 525.672,
    "end": 528.952,
    "duration": 3.28
  },
  {
    "id": 126,
    "text": "仙境的自由与朝廷的逼仄形成强烈对撞。",
    "start": 528.952,
    "end": 532.392,
    "duration": 3.44
  },
  {
    "id": 127,
    "text": "所以表述为：璀璨瑰丽的群仙盛宴与污浊逼仄的长安朝廷形成强烈反差，",
    "start": 532.712,
    "end": 539.322,
    "duration": 6.61
  },
  {
    "id": 128,
    "text": "极具精神解脱的崇高美。",
    "start": 539.322,
    "end": 541.546,
    "duration": 2.224
  },
  {
    "id": 129,
    "text": "第五句由幻境转向日常意象，说明他善于以极度夸张捕捉物象惊心动魄之美。",
    "start": 541.546,
    "end": 548.662,
    "duration": 7.116
  },
  {
    "id": 130,
    "text": "所以表述为：在日常抒情中，他善于以极度夸张捕捉物象惊心动魄之美。",
    "start": 548.662,
    "end": 555.112,
    "duration": 6.45
  },
  {
    "id": 131,
    "text": "第六句列出庐山瀑布飞流三千尺的千古名句。",
    "start": 555.192,
    "end": 559.592,
    "duration": 4.4
  },
  {
    "id": 132,
    "text": "所以表述为：如《望庐山瀑布》中的“飞流直下三千尺，",
    "start": 559.592,
    "end": 564.553,
    "duration": 4.961
  },
  {
    "id": 133,
    "text": "疑是银河落九天”。",
    "start": 564.553,
    "end": 566.293,
    "duration": 1.74
  },
  {
    "id": 134,
    "text": "第七句补列秋浦歌白发三千丈的奇崛夸张。",
    "start": 566.293,
    "end": 570.765,
    "duration": 4.472
  },
  {
    "id": 135,
    "text": "所以表述为：又如《秋浦歌》中的“白发三千丈，",
    "start": 570.765,
    "end": 574.99,
    "duration": 4.225
  },
  {
    "id": 136,
    "text": "缘愁似个长”。",
    "start": 574.99,
    "end": 576.232,
    "duration": 1.242
  },
  {
    "id": 137,
    "text": "第八句总结收束全段，指出其夸张大胆奇特而又浑然天成，",
    "start": 576.312,
    "end": 581.192,
    "duration": 4.88
  },
  {
    "id": 138,
    "text": "毫无斧凿雕琢痕迹。",
    "start": 581.192,
    "end": 583.112,
    "duration": 1.92
  },
  {
    "id": 139,
    "text": "所以表述为：这些脱口而出的夸张大胆奇特而又纯真浑然，",
    "start": 583.112,
    "end": 588.232,
    "duration": 5.12
  },
  {
    "id": 140,
    "text": "丝毫不见斧凿雕琢的痕迹。",
    "start": 588.232,
    "end": 590.472,
    "duration": 2.24
  },
  {
    "id": 141,
    "text": "本段答题思路总结。",
    "start": 590.472,
    "end": 591.912,
    "duration": 1.44
  },
  {
    "id": 142,
    "text": "本段聚焦于浪漫主义核心表现手段：以《梦游天姥吟留别》仙人列如麻的宏大幻境为例，",
    "start": 592.208,
    "end": 599.808,
    "duration": 7.6
  },
  {
    "id": 143,
    "text": "剖析超现实神话世界的营造机制与精神解脱功能；",
    "start": 599.808,
    "end": 604.368,
    "duration": 4.56
  },
  {
    "id": 144,
    "text": "紧接着列举飞流直下三千尺、白发三千丈等极致夸张，",
    "start": 604.368,
    "end": 609.168,
    "duration": 4.8
  },
  {
    "id": 145,
    "text": "透彻阐明李白如何打破物理常识局限、",
    "start": 609.168,
    "end": 612.528,
    "duration": 3.36
  },
  {
    "id": 146,
    "text": "以主观情感重构天地物象，达到化腐朽为神奇的浪漫绝顶。",
    "start": 612.528,
    "end": 617.568,
    "duration": 5.04
  },
  {
    "id": 147,
    "text": "所以本段具体答题完整版为：二、奇绝宏肆的浪漫想象：极度夸张的宇宙空间与超现实幻境营构。",
    "start": 617.888,
    "end": 626.448,
    "duration": 8.56
  },
  {
    "id": 148,
    "text": "李白拥有古典诗歌史上最不受拘束的浪漫想象力，",
    "start": 626.448,
    "end": 630.368,
    "duration": 3.92
  },
  {
    "id": 149,
    "text": "长于融铸神话与极度夸张构建幻境。",
    "start": 630.368,
    "end": 633.808,
    "duration": 3.44
  },
  {
    "id": 150,
    "text": "在名作《梦游天姥吟留别》中，他以超现实笔墨描摹出光怪陆离的仙界图景。",
    "start": 633.808,
    "end": 639.488,
    "duration": 5.68
  },
  {
    "id": 151,
    "text": "诗中写道：“霓为衣兮风为马，云之君兮纷纷而来下。",
    "start": 639.808,
    "end": 645.808,
    "duration": 6.0
  },
  {
    "id": 152,
    "text": "虎鼓瑟兮鸾回车，仙之人兮列如麻”。",
    "start": 645.808,
    "end": 650.208,
    "duration": 4.4
  },
  {
    "id": 153,
    "text": "璀璨瑰丽的群仙盛宴与污浊逼仄的长安朝廷形成强烈反差，",
    "start": 650.208,
    "end": 655.968,
    "duration": 5.76
  },
  {
    "id": 154,
    "text": "极具精神解脱的崇高美。",
    "start": 655.968,
    "end": 658.208,
    "duration": 2.24
  },
  {
    "id": 155,
    "text": "在日常抒情中，他善于以极度夸张捕捉物象惊心动魄之美。",
    "start": 658.208,
    "end": 663.408,
    "duration": 5.2
  },
  {
    "id": 156,
    "text": "如《望庐山瀑布》中的“飞流直下三千尺，",
    "start": 663.648,
    "end": 667.008,
    "duration": 3.36
  },
  {
    "id": 157,
    "text": "疑是银河落九天”。",
    "start": 667.008,
    "end": 668.688,
    "duration": 1.68
  },
  {
    "id": 158,
    "text": "又如《秋浦歌》中的“白发三千丈，",
    "start": 668.688,
    "end": 671.408,
    "duration": 2.72
  },
  {
    "id": 159,
    "text": "缘愁似个长”。",
    "start": 671.408,
    "end": 672.768,
    "duration": 1.36
  },
  {
    "id": 160,
    "text": "这些脱口而出的夸张大胆奇特而又纯真浑然，",
    "start": 672.768,
    "end": 676.368,
    "duration": 3.6
  },
  {
    "id": 161,
    "text": "丝毫不见斧凿雕琢的痕迹。。",
    "start": 676.368,
    "end": 678.528,
    "duration": 2.16
  },
  {
    "id": 162,
    "text": "第四段：第三分论点，奔腾恣肆的篇章结构（势之“疾”）。",
    "start": 678.528,
    "end": 682.688,
    "duration": 4.16
  },
  {
    "id": 163,
    "text": "逐句因果推导与答题表述。",
    "start": 683.088,
    "end": 685.968,
    "duration": 2.88
  },
  {
    "id": 164,
    "text": "有了开阔想象，第四段必须进一步探究李白诗歌在宏观篇章与情感节律上的惊人爆发力。",
    "start": 685.968,
    "end": 693.968,
    "duration": 8.0
  },
  {
    "id": 165,
    "text": "首句立论，指出李白打破起承转合规则，",
    "start": 693.968,
    "end": 697.808,
    "duration": 3.84
  },
  {
    "id": 166,
    "text": "让诗情以决堤之势喷薄奔涌。",
    "start": 697.808,
    "end": 700.848,
    "duration": 3.04
  },
  {
    "id": 167,
    "text": "所以表述为：李白打破了古典诗歌循序渐进的起承转合规则，",
    "start": 700.848,
    "end": 706.688,
    "duration": 5.84
  },
  {
    "id": 168,
    "text": "善于让诗情以决堤之势喷薄奔涌。",
    "start": 706.688,
    "end": 709.568,
    "duration": 2.88
  },
  {
    "id": 169,
    "text": "次句概括其七言歌行的音乐节奏，转换神速且大起大落。",
    "start": 709.888,
    "end": 714.938,
    "duration": 5.05
  },
  {
    "id": 170,
    "text": "所以表述为：其七言歌行节奏转换神速，",
    "start": 714.938,
    "end": 718.517,
    "duration": 3.579
  },
  {
    "id": 171,
    "text": "情感如天风海雨般大起大落。",
    "start": 718.517,
    "end": 721.201,
    "duration": 2.684
  },
  {
    "id": 172,
    "text": "第三句调取全书最具代表性、也是篇章起伏最剧烈的代表绝唱《将进酒》。",
    "start": 721.201,
    "end": 727.688,
    "duration": 6.487
  },
  {
    "id": 173,
    "text": "所以表述为：这一特征在七古绝唱《将进酒》中展现得最为淋漓尽致。",
    "start": 727.688,
    "end": 733.728,
    "duration": 6.04
  },
  {
    "id": 174,
    "text": "第四句分析天上来起势，如同江河决口不可阻挡。",
    "start": 733.808,
    "end": 738.048,
    "duration": 4.24
  },
  {
    "id": 175,
    "text": "所以表述为：开篇以江河奔流之势突兀而起：“君不见，",
    "start": 738.048,
    "end": 742.608,
    "duration": 4.56
  },
  {
    "id": 176,
    "text": "黄河之水天上来，奔流到海不复回”。",
    "start": 742.608,
    "end": 745.808,
    "duration": 3.2
  },
  {
    "id": 177,
    "text": "第五句紧承上句骤然跌落，转入对高堂明镜白发的人生苦短浩叹。",
    "start": 746.192,
    "end": 752.272,
    "duration": 6.08
  },
  {
    "id": 178,
    "text": "所以表述为：紧接着骤然跌入人生苦短的浩叹：“君不见，",
    "start": 752.272,
    "end": 756.832,
    "duration": 4.56
  },
  {
    "id": 179,
    "text": "高堂明镜悲白发，朝如青丝暮成雪”。",
    "start": 756.832,
    "end": 760.832,
    "duration": 4.0
  },
  {
    "id": 180,
    "text": "第六句笔锋陡转腾跃，高唱天生我材必有用的极致狂放自信。",
    "start": 760.832,
    "end": 766.112,
    "duration": 5.28
  },
  {
    "id": 181,
    "text": "所以表述为：随后笔锋陡转飞升，高呼“天生我材必有用，",
    "start": 766.432,
    "end": 771.404,
    "duration": 4.972
  },
  {
    "id": 182,
    "text": "千金散尽还复来”，极度亢奋。",
    "start": 771.404,
    "end": 773.925,
    "duration": 2.521
  },
  {
    "id": 183,
    "text": "第七句总结本段，全篇收束于同销万古愁的沉郁悲凉，",
    "start": 773.925,
    "end": 778.967,
    "duration": 5.042
  },
  {
    "id": 184,
    "text": "章法如悬崖飞瀑莫测。",
    "start": 778.967,
    "end": 781.03,
    "duration": 2.063
  },
  {
    "id": 185,
    "text": "所以表述为：最后收束于“与尔同销万古愁”的悲凉深沉，",
    "start": 781.03,
    "end": 786.071,
    "duration": 5.041
  },
  {
    "id": 186,
    "text": "章法如悬崖飞瀑，跌宕莫测。",
    "start": 786.071,
    "end": 788.592,
    "duration": 2.521
  },
  {
    "id": 187,
    "text": "本段答题思路总结。",
    "start": 788.672,
    "end": 790.352,
    "duration": 1.68
  },
  {
    "id": 188,
    "text": "本段聚焦于七言歌行的宏观结构与音乐律动：以《将进酒》为解剖样本，",
    "start": 790.352,
    "end": 796.272,
    "duration": 5.92
  },
  {
    "id": 189,
    "text": "层层追踪其开篇黄河万里的排空而起、",
    "start": 796.272,
    "end": 799.792,
    "duration": 3.52
  },
  {
    "id": 190,
    "text": "高堂明镜的骤然悲叹、天生我材的激昂高潮、",
    "start": 799.792,
    "end": 803.792,
    "duration": 4.0
  },
  {
    "id": 191,
    "text": "以及与尔同销万古愁的余韵深远；",
    "start": 803.792,
    "end": 806.912,
    "duration": 3.12
  },
  {
    "id": 192,
    "text": "深刻揭示李白诗歌不拘常格、情随神行、",
    "start": 806.912,
    "end": 810.512,
    "duration": 3.6
  },
  {
    "id": 193,
    "text": "如江河奔腾一泻千里的大气象。",
    "start": 810.512,
    "end": 812.992,
    "duration": 2.48
  },
  {
    "id": 194,
    "text": "所以本段具体答题完整版为：三、奔腾恣肆的篇章结构：喷薄而出的情感语流与跌宕起伏的乐感。",
    "start": 813.312,
    "end": 821.792,
    "duration": 8.48
  },
  {
    "id": 195,
    "text": "李白打破了古典诗歌循序渐进的起承转合规则，",
    "start": 821.792,
    "end": 826.192,
    "duration": 4.4
  },
  {
    "id": 196,
    "text": "善于让诗情以决堤之势喷薄奔涌。",
    "start": 826.192,
    "end": 829.632,
    "duration": 3.44
  },
  {
    "id": 197,
    "text": "其七言歌行节奏转换神速，情感如天风海雨般大起大落。",
    "start": 829.632,
    "end": 834.992,
    "duration": 5.36
  },
  {
    "id": 198,
    "text": "这一特征在七古绝唱《将进酒》中展现得最为淋漓尽致。",
    "start": 835.232,
    "end": 840.032,
    "duration": 4.8
  },
  {
    "id": 199,
    "text": "开篇以江河奔流之势突兀而起：“君不见，",
    "start": 840.032,
    "end": 843.952,
    "duration": 3.92
  },
  {
    "id": 200,
    "text": "黄河之水天上来，奔流到海不复回”。",
    "start": 843.952,
    "end": 847.312,
    "duration": 3.36
  },
  {
    "id": 201,
    "text": "紧接着骤然跌入人生苦短的浩叹：“君不见，",
    "start": 847.312,
    "end": 851.152,
    "duration": 3.84
  },
  {
    "id": 202,
    "text": "高堂明镜悲白发，朝如青丝暮成雪”。",
    "start": 851.152,
    "end": 854.512,
    "duration": 3.36
  },
  {
    "id": 203,
    "text": "随后笔锋陡转飞升，高呼“天生我材必有用，",
    "start": 854.832,
    "end": 859.312,
    "duration": 4.48
  },
  {
    "id": 204,
    "text": "千金散尽还复来”，极度亢奋。",
    "start": 859.312,
    "end": 862.752,
    "duration": 3.44
  },
  {
    "id": 205,
    "text": "最后收束于“与尔同销万古愁”的悲凉深沉，",
    "start": 862.752,
    "end": 866.992,
    "duration": 4.24
  },
  {
    "id": 206,
    "text": "章法如悬崖飞瀑，跌宕莫测。。",
    "start": 866.992,
    "end": 870.352,
    "duration": 3.36
  },
  {
    "id": 207,
    "text": "第五段：第四分论点，清水芙蓉的自然诗美（韵之“逸”）。",
    "start": 870.352,
    "end": 874.992,
    "duration": 4.64
  },
  {
    "id": 208,
    "text": "逐句因果推导与答题表述。",
    "start": 875.232,
    "end": 878.272,
    "duration": 3.04
  },
  {
    "id": 209,
    "text": "在剖析了宏大的歌行之后，本段必须下沉到李白诗歌语言的天然本色与绝句艺术。",
    "start": 878.272,
    "end": 885.712,
    "duration": 7.44
  },
  {
    "id": 210,
    "text": "首句确立分论点，指出李白推崇天然纯真，",
    "start": 885.712,
    "end": 889.872,
    "duration": 4.16
  },
  {
    "id": 211,
    "text": "以“清水出芙蓉”为核心美学追求。",
    "start": 889.872,
    "end": 893.072,
    "duration": 3.2
  },
  {
    "id": 212,
    "text": "所以表述为：李白在艺术美学上推崇天然纯真，",
    "start": 893.072,
    "end": 897.232,
    "duration": 4.16
  },
  {
    "id": 213,
    "text": "旗帜鲜明地主张“清水出芙蓉，天然去雕饰”。",
    "start": 897.232,
    "end": 901.152,
    "duration": 3.92
  },
  {
    "id": 214,
    "text": "次句指出其文学史革新功绩，荡涤齐梁以来的浮艳雕琢，",
    "start": 901.448,
    "end": 906.728,
    "duration": 5.28
  },
  {
    "id": 215,
    "text": "让语言回归流转明丽。",
    "start": 906.728,
    "end": 908.888,
    "duration": 2.16
  },
  {
    "id": 216,
    "text": "所以表述为：他极力荡涤齐梁以来雕琢企靡的浮艳形式，",
    "start": 908.888,
    "end": 913.928,
    "duration": 5.04
  },
  {
    "id": 217,
    "text": "使诗歌语言回归纯净明丽与流转圆融。",
    "start": 913.928,
    "end": 917.928,
    "duration": 4.0
  },
  {
    "id": 218,
    "text": "第三句指出其在乐府体裁上的突破，",
    "start": 917.928,
    "end": 920.888,
    "duration": 2.96
  },
  {
    "id": 219,
    "text": "借古题自铸伟词，翻出全新盛唐气象。",
    "start": 920.888,
    "end": 924.328,
    "duration": 3.44
  },
  {
    "id": 220,
    "text": "所以表述为：他善于借助汉魏乐府古题自铸伟词，",
    "start": 924.728,
    "end": 929.289,
    "duration": 4.561
  },
  {
    "id": 221,
    "text": "彻底翻出崭新的盛唐时代精神与个人性情。",
    "start": 929.289,
    "end": 933.458,
    "duration": 4.169
  },
  {
    "id": 222,
    "text": "第四句指出其在近体诗上的绝顶造诣，",
    "start": 933.458,
    "end": 937.164,
    "duration": 3.706
  },
  {
    "id": 223,
    "text": "五七言绝句达到无迹可求的神化境地。",
    "start": 937.164,
    "end": 940.87,
    "duration": 3.706
  },
  {
    "id": 224,
    "text": "所以表述为：在近体诗中，李白尤以绝句成就最高，",
    "start": 940.87,
    "end": 945.502,
    "duration": 4.632
  },
  {
    "id": 225,
    "text": "达到了羚羊挂角、无迹可求的神化境地。",
    "start": 945.502,
    "end": 949.208,
    "duration": 3.706
  },
  {
    "id": 226,
    "text": "第五句调取绝句代表名篇《早发白帝城》完整四句。",
    "start": 949.288,
    "end": 953.891,
    "duration": 4.603
  },
  {
    "id": 227,
    "text": "所以表述为：如名篇《早发白帝城》：“朝辞白帝彩云间，",
    "start": 953.891,
    "end": 958.999,
    "duration": 5.108
  },
  {
    "id": 228,
    "text": "千里江陵一日还。",
    "start": 958.999,
    "end": 960.786,
    "duration": 1.787
  },
  {
    "id": 229,
    "text": "两岸猿声啼不住，轻舟已过万重山”。",
    "start": 960.786,
    "end": 964.362,
    "duration": 3.576
  },
  {
    "id": 230,
    "text": "第六句总结本段，指出情景相生、行云流水展现出大音希声的天赖之美。",
    "start": 964.362,
    "end": 971.768,
    "duration": 7.406
  },
  {
    "id": 231,
    "text": "所以表述为：全诗情景完全相生，语意如行云流水自然淌出，",
    "start": 971.928,
    "end": 977.528,
    "duration": 5.6
  },
  {
    "id": 232,
    "text": "展现出一种大音希声的天赖之美。",
    "start": 977.528,
    "end": 980.808,
    "duration": 3.28
  },
  {
    "id": 233,
    "text": "本段答题思路总结。",
    "start": 980.808,
    "end": 982.328,
    "duration": 1.52
  },
  {
    "id": 234,
    "text": "本段是李白艺术特色的重要升华：由宏大歌行自然下沉到绝句本色，",
    "start": 982.328,
    "end": 988.088,
    "duration": 5.76
  },
  {
    "id": 235,
    "text": "以“清水出芙蓉，天然去雕饰”为审美核心；",
    "start": 988.088,
    "end": 991.768,
    "duration": 3.68
  },
  {
    "id": 236,
    "text": "分析其借乐府古题自铸伟词的时代飞跃；",
    "start": 992.008,
    "end": 995.688,
    "duration": 3.68
  },
  {
    "id": 237,
    "text": "并以《早发白帝城》的千里一日与轻舟万重为例，",
    "start": 995.688,
    "end": 999.688,
    "duration": 4.0
  },
  {
    "id": 238,
    "text": "论证语言纯净剔透、不著一字尽得风流的天赖境界，",
    "start": 999.688,
    "end": 1004.568,
    "duration": 4.88
  },
  {
    "id": 239,
    "text": "全面展现其诗仙的飘逸神韵。",
    "start": 1004.568,
    "end": 1007.528,
    "duration": 2.96
  },
  {
    "id": 240,
    "text": "所以本段具体答题完整版为：四、清水芙蓉的自然诗美：乐府古题的新变与绝句的神韵天成。",
    "start": 1007.528,
    "end": 1015.848,
    "duration": 8.32
  },
  {
    "id": 241,
    "text": "李白在艺术美学上推崇天然纯真，旗帜鲜明地主张“清水出芙蓉，",
    "start": 1016.168,
    "end": 1021.768,
    "duration": 5.6
  },
  {
    "id": 242,
    "text": "天然去雕饰”。",
    "start": 1021.768,
    "end": 1023.208,
    "duration": 1.44
  },
  {
    "id": 243,
    "text": "他极力荡涤齐梁以来雕琢企靡的浮艳形式，",
    "start": 1023.208,
    "end": 1027.208,
    "duration": 4.0
  },
  {
    "id": 244,
    "text": "使诗歌语言回归纯净明丽与流转圆融。",
    "start": 1027.208,
    "end": 1030.968,
    "duration": 3.76
  },
  {
    "id": 245,
    "text": "他善于借助汉魏乐府古题自铸伟词，",
    "start": 1030.968,
    "end": 1034.408,
    "duration": 3.44
  },
  {
    "id": 246,
    "text": "彻底翻出崭新的盛唐时代精神与个人性情。",
    "start": 1034.408,
    "end": 1037.848,
    "duration": 3.44
  },
  {
    "id": 247,
    "text": "在近体诗中，李白尤以绝句成就最高，",
    "start": 1038.168,
    "end": 1041.528,
    "duration": 3.36
  },
  {
    "id": 248,
    "text": "达到了羚羊挂角、无迹可求的神化境地。",
    "start": 1041.528,
    "end": 1045.048,
    "duration": 3.52
  },
  {
    "id": 249,
    "text": "如名篇《早发白帝城》：“朝辞白帝彩云间，",
    "start": 1045.048,
    "end": 1049.128,
    "duration": 4.08
  },
  {
    "id": 250,
    "text": "千里江陵一日还。",
    "start": 1049.128,
    "end": 1051.048,
    "duration": 1.92
  },
  {
    "id": 251,
    "text": "两岸猿声啼不住，轻舟已过万重山”。",
    "start": 1051.048,
    "end": 1055.208,
    "duration": 4.16
  },
  {
    "id": 252,
    "text": "全诗情景完全相生，语意如行云流水自然淌出，",
    "start": 1055.208,
    "end": 1059.688,
    "duration": 4.48
  },
  {
    "id": 253,
    "text": "展现出一种大音希声的天赖之美。--",
    "start": 1059.688,
    "end": 1062.408,
    "duration": 2.72
  },
  {
    "id": 254,
    "text": "第六段：尾段收官与文学史谱系闭环。",
    "start": 1062.704,
    "end": 1066.624,
    "duration": 3.92
  },
  {
    "id": 255,
    "text": "逐句因果推导与答题表述。",
    "start": 1066.624,
    "end": 1069.344,
    "duration": 2.72
  },
  {
    "id": 256,
    "text": "尾段作为、三十分大题的收官，必须将李白置于唐诗高峰与后世流变的宏大谱系中定型。",
    "start": 1069.344,
    "end": 1077.424,
    "duration": 8.08
  },
  {
    "id": 257,
    "text": "首句全面综合前述四个维度，盛赞其以天才熔铸了盛唐气象的博大气魄。",
    "start": 1077.424,
    "end": 1083.824,
    "duration": 6.4
  },
  {
    "id": 258,
    "text": "所以表述为：综上所述，李白以非凡的天才融铸了盛唐气象的博大气魄与宏伟情操。",
    "start": 1084.144,
    "end": 1091.073,
    "duration": 6.929
  },
  {
    "id": 259,
    "text": "次句确立历史地位，指出他与杜甫并峙为盛唐两座最高峰，",
    "start": 1091.073,
    "end": 1096.054,
    "duration": 4.981
  },
  {
    "id": 260,
    "text": "树立了浪漫主义最高范式。",
    "start": 1096.054,
    "end": 1098.337,
    "duration": 2.283
  },
  {
    "id": 261,
    "text": "所以表述为：他与杜甫并峙为盛唐诗歌的两座最高峰，",
    "start": 1098.337,
    "end": 1102.903,
    "duration": 4.566
  },
  {
    "id": 262,
    "text": "确立了中国古典浪漫主义的最高范式。",
    "start": 1102.903,
    "end": 1106.224,
    "duration": 3.321
  },
  {
    "id": 263,
    "text": "第三句向中唐与宋代纵向延伸，点明其对韩孟奇崛与苏轼豪迈的深远启迪。",
    "start": 1106.304,
    "end": 1114.304,
    "duration": 8.0
  },
  {
    "id": 264,
    "text": "所以表述为：李白的豪放狂飙不仅直接启迪了中唐韩愈、",
    "start": 1114.304,
    "end": 1119.104,
    "duration": 4.8
  },
  {
    "id": 265,
    "text": "李贺的奇崛造语，更在宋代苏轼的豪迈词章中得到承续。",
    "start": 1119.104,
    "end": 1124.224,
    "duration": 5.12
  },
  {
    "id": 266,
    "text": "第四句得出终极定评，指出李白诗歌成为中华文明朝气与精神自由的永恒象征。",
    "start": 1124.224,
    "end": 1131.344,
    "duration": 7.12
  },
  {
    "id": 267,
    "text": "所以表述为：李白诗歌因而成为中华文明蓬勃朝气与精神自由的永恒象征。",
    "start": 1131.744,
    "end": 1138.064,
    "duration": 6.32
  },
  {
    "id": 268,
    "text": "本段答题思路总结。",
    "start": 1138.064,
    "end": 1139.824,
    "duration": 1.76
  },
  {
    "id": 269,
    "text": "本段完成了极具学术高度的总结：先以盛唐气象的人格化熔铸为总括；",
    "start": 1139.824,
    "end": 1145.424,
    "duration": 5.6
  },
  {
    "id": 270,
    "text": "随后将李杜并峙并提，确立双峰并峙的历史法则；",
    "start": 1145.424,
    "end": 1149.744,
    "duration": 4.32
  },
  {
    "id": 271,
    "text": "紧接着清晰勾勒出从李白出发，经中唐韩愈、",
    "start": 1149.744,
    "end": 1153.984,
    "duration": 4.24
  },
  {
    "id": 272,
    "text": "李贺奇险造语的过渡，最终汇入宋代苏轼豪迈旷达词风的发展脉络，",
    "start": 1153.984,
    "end": 1159.904,
    "duration": 5.92
  },
  {
    "id": 273,
    "text": "使整道、三十、分大题在雄浑壮丽的诗歌演变史中完美收官。",
    "start": 1159.904,
    "end": 1164.944,
    "duration": 5.04
  },
  {
    "id": 274,
    "text": "所以本段具体答题完整版为：综上所述，",
    "start": 1165.264,
    "end": 1168.864,
    "duration": 3.6
  },
  {
    "id": 275,
    "text": "李白以非凡的天才融铸了盛唐气象的博大气魄与宏伟情操。",
    "start": 1168.864,
    "end": 1174.544,
    "duration": 5.68
  },
  {
    "id": 276,
    "text": "他与杜甫并峙为盛唐诗歌的两座最高峰，",
    "start": 1174.544,
    "end": 1177.984,
    "duration": 3.44
  },
  {
    "id": 277,
    "text": "确立了中国古典浪漫主义的最高范式。",
    "start": 1177.984,
    "end": 1181.104,
    "duration": 3.12
  },
  {
    "id": 278,
    "text": "李白的豪放狂飙不仅直接启迪了中唐韩愈、",
    "start": 1181.104,
    "end": 1184.784,
    "duration": 3.68
  },
  {
    "id": 279,
    "text": "李贺的奇崛造语，更在宋代苏轼的豪迈词章中得到承续。",
    "start": 1184.784,
    "end": 1189.184,
    "duration": 4.4
  },
  {
    "id": 280,
    "text": "李白诗歌因而成为中华文明蓬勃朝气与精神自由的永恒象征。",
    "start": 1189.424,
    "end": 1194.784,
    "duration": 5.36
  },
  {
    "id": 281,
    "text": "整道大题的内在逻辑链总括。",
    "start": 1194.784,
    "end": 1197.184,
    "duration": 2.4
  },
  {
    "id": 282,
    "text": "这道三十分大题的本质，是一场极度严密的逻辑推演。",
    "start": 1197.184,
    "end": 1201.424,
    "duration": 4.24
  },
  {
    "id": 283,
    "text": "整篇答卷从头到尾遵循着“由典范定评、",
    "start": 1201.424,
    "end": 1205.344,
    "duration": 3.92
  },
  {
    "id": 284,
    "text": "到时代人格、到奇崛想象、到奔腾篇章、",
    "start": 1205.344,
    "end": 1209.344,
    "duration": 4.0
  },
  {
    "id": 285,
    "text": "到自然天赖、最终回归李杜并峙”的必然法则。",
    "start": 1209.344,
    "end": 1213.024,
    "duration": 3.68
  },
  {
    "id": 286,
    "text": "阅卷老师看到的绝不是散乱的答题点，",
    "start": 1213.344,
    "end": 1216.464,
    "duration": 3.12
  },
  {
    "id": 287,
    "text": "而是一条咬合紧密的因果长链：第一步是“立论定性”，",
    "start": 1216.464,
    "end": 1221.328,
    "duration": 4.864
  },
  {
    "id": 288,
    "text": "开门见山借严羽“一结盛唐之局”与袁本教材，",
    "start": 1221.328,
    "end": 1226.368,
    "duration": 5.04
  },
  {
    "id": 289,
    "text": "确立李白作为盛唐浪漫主义最高投影的坐标。",
    "start": 1226.368,
    "end": 1230.368,
    "duration": 4.0
  },
  {
    "id": 290,
    "text": "第二步是“盛唐人格”，以“欲上青天”的壮志与“安能折腰”的傲骨，",
    "start": 1230.368,
    "end": 1236.048,
    "duration": 5.68
  },
  {
    "id": 291,
    "text": "剖析大一统繁盛时代催生出的主体自由品格。",
    "start": 1236.048,
    "end": 1240.128,
    "duration": 4.08
  },
  {
    "id": 292,
    "text": "第三步是“超然想象”，以《梦游天姥》仙境与飞流直下三千尺，",
    "start": 1240.448,
    "end": 1245.648,
    "duration": 5.2
  },
  {
    "id": 293,
    "text": "论证极度夸张打破物理时空的浪漫飞升。",
    "start": 1245.648,
    "end": 1249.008,
    "duration": 3.36
  },
  {
    "id": 294,
    "text": "第四步是“奔腾章法”，以《将进酒》黄河之水天上来与大起大落，",
    "start": 1249.008,
    "end": 1254.448,
    "duration": 5.44
  },
  {
    "id": 295,
    "text": "展现决堤喷薄的情感语流与惊人乐感。",
    "start": 1254.448,
    "end": 1257.968,
    "duration": 3.52
  },
  {
    "id": 296,
    "text": "第五步是“天然神韵”，以“清水出芙蓉”与《早发白帝城》绝句天赖，",
    "start": 1257.968,
    "end": 1262.928,
    "duration": 4.96
  },
  {
    "id": 297,
    "text": "阐明洗尽雕饰、情景相生的纯净本色。",
    "start": 1262.928,
    "end": 1266.208,
    "duration": 3.28
  },
  {
    "id": 298,
    "text": "第六步是“史学闭环”，把李白与杜甫双峰并提，",
    "start": 1266.448,
    "end": 1270.528,
    "duration": 4.08
  },
  {
    "id": 299,
    "text": "自然引向中唐韩贺奇崛与两宋苏轼豪放旷达的浩瀚传承。",
    "start": 1270.528,
    "end": 1276.208,
    "duration": 5.68
  },
  {
    "id": 300,
    "text": "这六步层层递进，前一步的结论必然成为后一步的前提。",
    "start": 1276.208,
    "end": 1280.288,
    "duration": 4.08
  },
  {
    "id": 301,
    "text": "你在考场上顺着因果关系顺流而下，",
    "start": 1280.288,
    "end": 1283.088,
    "duration": 2.8
  },
  {
    "id": 302,
    "text": "就能自然写出近千字的满分答卷。",
    "start": 1283.088,
    "end": 1285.728,
    "duration": 2.64
  }
]