[
  {
    "id": 1,
    "text": "全局宏观破题与立论逻辑。",
    "start": 0.16,
    "end": 2.88,
    "duration": 2.72
  },
  {
    "id": 2,
    "text": "在考场下笔之前，必须先在宏观上审清这道三十分大题的核心考核意图。",
    "start": 2.88,
    "end": 9.36,
    "duration": 6.48
  },
  {
    "id": 3,
    "text": "本题表面上考查李白的艺术特色，本质上考查盛唐时代气象与诗人主体人格的诗学同构。",
    "start": 9.36,
    "end": 17.36,
    "duration": 8.0
  },
  {
    "id": 4,
    "text": "考场评分标准绝不满足于仅孤立背诵豪放狂放等成语标签。",
    "start": 17.36,
    "end": 22.24,
    "duration": 4.88
  },
  {
    "id": 5,
    "text": "答题方向必须确立为“从盛唐气象投射出的昂扬主体人格，",
    "start": 22.56,
    "end": 28.08,
    "duration": 5.52
  },
  {
    "id": 6,
    "text": "推进到极度夸张的浪漫想象与超现实幻境，",
    "start": 28.08,
    "end": 32.32,
    "duration": 4.24
  },
  {
    "id": 7,
    "text": "再深入到奔腾起伏的篇章音乐结构，",
    "start": 32.32,
    "end": 35.52,
    "duration": 3.2
  },
  {
    "id": 8,
    "text": "最终落地至天然纯净的绝句语言与乐府新变”的因果推进。",
    "start": 35.52,
    "end": 40.96,
    "duration": 5.44
  },
  {
    "id": 9,
    "text": "整道大题在宏观上划分为五个有机递进的逻辑层次：第一层，",
    "start": 40.96,
    "end": 46.48,
    "duration": 5.52
  },
  {
    "id": 10,
    "text": "开篇破题，借杜甫“诗无敌”与严羽“结盛唐之局”，",
    "start": 46.48,
    "end": 51.44,
    "duration": 4.96
  },
  {
    "id": 11,
    "text": "确立李白作为盛唐浪漫主义第一峰的崇高地位。",
    "start": 51.44,
    "end": 55.36,
    "duration": 3.92
  },
  {
    "id": 12,
    "text": "第二层，论述时代与人格，剖析盛唐大一统时代自信与“安能摧眉折腰”傲岸品格的内在交融。",
    "start": 55.36,
    "end": 63.92,
    "duration": 8.56
  },
  {
    "id": 13,
    "text": "第三层，论述宏观想象力，以《梦游天姥吟留别》仙境与飞流三千尺为例，",
    "start": 63.92,
    "end": 70.56,
    "duration": 6.64
  },
  {
    "id": 14,
    "text": "阐释超现实空间建构。",
    "start": 70.56,
    "end": 72.24,
    "duration": 1.68
  },
  {
    "id": 15,
    "text": "第四层，论述篇章与节奏，以《将进酒》为例，",
    "start": 72.56,
    "end": 76.48,
    "duration": 3.92
  },
  {
    "id": 16,
    "text": "剖析黄河之水天上来起势与大起大落的情感喷薄。",
    "start": 76.48,
    "end": 81.52,
    "duration": 5.04
  },
  {
    "id": 17,
    "text": "第五层，落地至诗体与语言，阐释“清水出芙蓉”的天然诗美与绝句浑然天成的神韵。",
    "start": 81.52,
    "end": 89.84,
    "duration": 8.32
  },
  {
    "id": 18,
    "text": "尾部收官，以李杜并峙为总结，交代其对韩愈、",
    "start": 89.84,
    "end": 93.92,
    "duration": 4.08
  },
  {
    "id": 19,
    "text": "李贺奇崛风貌与苏轼豪迈词派的深远启迪。",
    "start": 93.92,
    "end": 97.68,
    "duration": 3.76
  },
  {
    "id": 20,
    "text": "这五个层次构成一条不可逆的因果链条：盛唐时代是土壤，",
    "start": 97.92,
    "end": 102.88,
    "duration": 4.96
  },
  {
    "id": 21,
    "text": "傲岸自信是灵魂，奇崛想象是翅膀，",
    "start": 102.88,
    "end": 106.16,
    "duration": 3.28
  },
  {
    "id": 22,
    "text": "喷薄语流是脉络，清水芙蓉是语言，",
    "start": 106.16,
    "end": 109.44,
    "duration": 3.28
  },
  {
    "id": 23,
    "text": "李杜并峙是历史定型。",
    "start": 109.44,
    "end": 111.6,
    "duration": 2.16
  },
  {
    "id": 24,
    "text": "理顺了宏观全局思路，接下来进入每一段的具体推导与逐句表述。",
    "start": 111.6,
    "end": 116.72,
    "duration": 5.12
  },
  {
    "id": 25,
    "text": "第一段：首段破题与概念定性。",
    "start": 116.72,
    "end": 119.68,
    "duration": 2.96
  },
  {
    "id": 26,
    "text": "逐句因果推导与答题表述。",
    "start": 120.0,
    "end": 122.64,
    "duration": 2.64
  },
  {
    "id": 27,
    "text": "首句必须直击核心地位，确立其浪漫主义诗歌巅峰与“诗仙”尊号。",
    "start": 122.64,
    "end": 128.48,
    "duration": 5.84
  },
  {
    "id": 28,
    "text": "所以表述为：次句必须引入同代诗圣杜甫的至高赞誉，",
    "start": 128.48,
    "end": 133.28,
    "duration": 4.8
  },
  {
    "id": 29,
    "text": "确立才绝古今的文学史公论。",
    "start": 133.28,
    "end": 136.0,
    "duration": 2.72
  },
  {
    "id": 30,
    "text": "所以表述为：第三句引入诗论权威严羽在《沧浪诗话》中的权威定评，",
    "start": 136.0,
    "end": 142.56,
    "duration": 6.56
  },
  {
    "id": 31,
    "text": "点明其终结盛唐格局的地位。",
    "start": 142.56,
    "end": 144.8,
    "duration": 2.24
  },
  {
    "id": 32,
    "text": "所以表述为：第四句引入考研权威教材依据，",
    "start": 145.04,
    "end": 149.008,
    "duration": 3.968
  },
  {
    "id": 33,
    "text": "指出李白诗歌是盛唐时代精神的绚烂投影。",
    "start": 149.008,
    "end": 153.04,
    "duration": 4.032
  },
  {
    "id": 34,
    "text": "所以表述为：第五句概括其美学风貌，",
    "start": 153.04,
    "end": 156.4,
    "duration": 3.36
  },
  {
    "id": 35,
    "text": "说明他将古典浪漫主义推上了空前绝后的境地。",
    "start": 156.4,
    "end": 160.88,
    "duration": 4.48
  },
  {
    "id": 36,
    "text": "所以表述为：第六句作为首段过渡句，",
    "start": 161.104,
    "end": 164.165,
    "duration": 3.061
  },
  {
    "id": 37,
    "text": "宣告下文将从四个核心维度展开系统论述。",
    "start": 164.165,
    "end": 167.894,
    "duration": 3.729
  },
  {
    "id": 38,
    "text": "所以表述为：本段答题思路总结。",
    "start": 167.894,
    "end": 170.588,
    "duration": 2.694
  },
  {
    "id": 39,
    "text": "本段用六句话完成立论闭环：先直接亮出浪漫主义巅峰与“诗仙”坐标；",
    "start": 170.588,
    "end": 176.39,
    "duration": 5.802
  },
  {
    "id": 40,
    "text": "随后调引杜甫“白也诗无敌”与严羽“一结盛唐之局”的双重权威定论；",
    "start": 176.39,
    "end": 181.984,
    "duration": 5.594
  },
  {
    "id": 41,
    "text": "接着借助袁行配教材将李白确立为盛唐时代精神的至高投影；",
    "start": 182.064,
    "end": 187.824,
    "duration": 5.76
  },
  {
    "id": 42,
    "text": "最后自然转入四个维度的展开，开篇严谨大气。",
    "start": 187.824,
    "end": 192.064,
    "duration": 4.24
  },
  {
    "id": 43,
    "text": "所以本段具体答题完整版为：第二段：第一分论点，",
    "start": 192.064,
    "end": 196.224,
    "duration": 4.16
  },
  {
    "id": 44,
    "text": "盛唐气象的人格投射（骨之“傲”）。",
    "start": 196.224,
    "end": 199.344,
    "duration": 3.12
  },
  {
    "id": 45,
    "text": "逐句因果推导与答题表述。",
    "start": 199.344,
    "end": 201.744,
    "duration": 2.4
  },
  {
    "id": 46,
    "text": "论述李白，首先必须回答他与盛唐气象的内在关系，",
    "start": 201.984,
    "end": 206.384,
    "duration": 4.4
  },
  {
    "id": 47,
    "text": "这是他诗歌精神力量的泉源。",
    "start": 206.384,
    "end": 208.784,
    "duration": 2.4
  },
  {
    "id": 48,
    "text": "首句确立分论点，指出李白诗歌的灵魂是盛唐国力催生的时代自信与自我主体意识。",
    "start": 208.784,
    "end": 216.544,
    "duration": 7.76
  },
  {
    "id": 49,
    "text": "所以表述为：次句推导因果，说明盛唐开明包容的环境造就了他傲视公卿、",
    "start": 216.544,
    "end": 223.424,
    "duration": 6.88
  },
  {
    "id": 50,
    "text": "任侠狂放的豪迈气概。",
    "start": 223.424,
    "end": 225.504,
    "duration": 2.08
  },
  {
    "id": 51,
    "text": "所以表述为：第三句调取名作《宣州谢窕楼建别校书叔云》展现凌云壮志的原句。",
    "start": 225.744,
    "end": 232.909,
    "duration": 7.165
  },
  {
    "id": 52,
    "text": "所以表述为：第四句即便身处挫折逆境，",
    "start": 232.909,
    "end": 236.525,
    "duration": 3.616
  },
  {
    "id": 53,
    "text": "在《行路难》中依然展现出对未来的坚强信念。",
    "start": 236.525,
    "end": 240.593,
    "duration": 4.068
  },
  {
    "id": 54,
    "text": "所以表述为：第五句调取其人格精神最拔俗的高潮，",
    "start": 240.593,
    "end": 245.338,
    "duration": 4.745
  },
  {
    "id": 55,
    "text": "引用傲视权贵的千古绝唱。",
    "start": 245.338,
    "end": 247.824,
    "duration": 2.486
  },
  {
    "id": 56,
    "text": "所以表述为：第六句收束全段，指出将个体尊严置于权贵之上的反叛精神是盛唐士人最壮丽的写照。",
    "start": 247.984,
    "end": 257.054,
    "duration": 9.07
  },
  {
    "id": 57,
    "text": "所以表述为：本段答题思路总结。",
    "start": 257.054,
    "end": 259.949,
    "duration": 2.895
  },
  {
    "id": 58,
    "text": "本段深入剖析盛唐气象与诗人主体人格的血脉同构：先从盛唐强盛开放的时代背景切入，",
    "start": 259.949,
    "end": 268.191,
    "duration": 8.242
  },
  {
    "id": 59,
    "text": "推导出昂扬自信的主体性格；",
    "start": 268.191,
    "end": 270.864,
    "duration": 2.673
  },
  {
    "id": 60,
    "text": "随后紧扣“欲上青天揽明月”的飞扬壮思、",
    "start": 271.024,
    "end": 274.864,
    "duration": 3.84
  },
  {
    "id": 61,
    "text": "“长风破浪会有时”的百折不挠，以及“安能摧眉折腰”的傲岸风骨；",
    "start": 274.864,
    "end": 280.464,
    "duration": 5.6
  },
  {
    "id": 62,
    "text": "全面论证了李白诗歌正是盛唐士人精神自由与尊严觉醒的最强音。",
    "start": 280.464,
    "end": 286.384,
    "duration": 5.92
  },
  {
    "id": 63,
    "text": "所以本段具体答题完整版为：第三段：第二分论点，",
    "start": 286.384,
    "end": 290.304,
    "duration": 3.92
  },
  {
    "id": 64,
    "text": "奇绝宏肆的浪漫想象（象之“奇”）。",
    "start": 290.304,
    "end": 293.424,
    "duration": 3.12
  },
  {
    "id": 65,
    "text": "逐句因果推导与答题表述。",
    "start": 293.744,
    "end": 296.544,
    "duration": 2.8
  },
  {
    "id": 66,
    "text": "第二段讲透了内在人格，第三段必须正面攻克其最突出的艺术手段，",
    "start": 296.544,
    "end": 302.384,
    "duration": 5.84
  },
  {
    "id": 67,
    "text": "也就是极度开阔的浪漫想象。",
    "start": 302.384,
    "end": 305.184,
    "duration": 2.8
  },
  {
    "id": 68,
    "text": "首句确立分论点，指出李白拥有不受时空限制的想象力，",
    "start": 305.184,
    "end": 309.824,
    "duration": 4.64
  },
  {
    "id": 69,
    "text": "善于融铸神话构建宏大幻境。",
    "start": 309.824,
    "end": 312.784,
    "duration": 2.96
  },
  {
    "id": 70,
    "text": "所以表述为：次句调取全书最具代表性的浪漫主义仙境名作《梦游天姥吟留别》。",
    "start": 312.784,
    "end": 319.728,
    "duration": 6.944
  },
  {
    "id": 71,
    "text": "所以表述为：第三句直接引用群仙盛宴的著名四句原诗。",
    "start": 319.728,
    "end": 324.86,
    "duration": 5.132
  },
  {
    "id": 72,
    "text": "所以表述为：第四句剖析这一超现实幻境的审美功能，",
    "start": 324.86,
    "end": 329.817,
    "duration": 4.957
  },
  {
    "id": 73,
    "text": "仙境的自由与朝廷的逼仄形成强烈对撞。",
    "start": 329.817,
    "end": 333.648,
    "duration": 3.831
  },
  {
    "id": 74,
    "text": "所以表述为：第五句由幻境转向日常意象，",
    "start": 333.808,
    "end": 337.212,
    "duration": 3.404
  },
  {
    "id": 75,
    "text": "说明他善于以极度夸张捕捉物象惊心动魄之美。",
    "start": 337.212,
    "end": 341.266,
    "duration": 4.054
  },
  {
    "id": 76,
    "text": "所以表述为：第六句列出庐山瀑布飞流三千尺的千古名句。",
    "start": 341.266,
    "end": 346.132,
    "duration": 4.866
  },
  {
    "id": 77,
    "text": "所以表述为：第七句补列秋浦歌白发三千丈的奇崛夸张。",
    "start": 346.132,
    "end": 350.794,
    "duration": 4.662
  },
  {
    "id": 78,
    "text": "所以表述为：第八句总结收束全段，",
    "start": 350.794,
    "end": 353.888,
    "duration": 3.094
  },
  {
    "id": 79,
    "text": "指出其夸张大胆奇特而又浑然天成，",
    "start": 353.888,
    "end": 357.408,
    "duration": 3.52
  },
  {
    "id": 80,
    "text": "毫无斧凿雕琢痕迹。",
    "start": 357.408,
    "end": 359.248,
    "duration": 1.84
  },
  {
    "id": 81,
    "text": "所以表述为：本段答题思路总结。",
    "start": 359.248,
    "end": 362.048,
    "duration": 2.8
  },
  {
    "id": 82,
    "text": "本段聚焦于浪漫主义核心表现手段：以《梦游天姥吟留别》仙人列如麻的宏大幻境为例，",
    "start": 362.048,
    "end": 368.608,
    "duration": 6.56
  },
  {
    "id": 83,
    "text": "剖析超现实神话世界的营造机制与精神解脱功能；",
    "start": 368.608,
    "end": 372.608,
    "duration": 4.0
  },
  {
    "id": 84,
    "text": "紧接着列举飞流直下三千尺、白发三千丈等极致夸张，",
    "start": 372.928,
    "end": 377.888,
    "duration": 4.96
  },
  {
    "id": 85,
    "text": "透彻阐明李白如何打破物理常识局限、",
    "start": 377.888,
    "end": 381.088,
    "duration": 3.2
  },
  {
    "id": 86,
    "text": "以主观情感重构天地物象，达到化腐朽为神奇的浪漫绝顶。",
    "start": 381.088,
    "end": 385.808,
    "duration": 4.72
  },
  {
    "id": 87,
    "text": "所以本段具体答题完整版为：第四段：第三分论点，",
    "start": 385.808,
    "end": 389.728,
    "duration": 3.92
  },
  {
    "id": 88,
    "text": "奔腾恣肆的篇章结构（势之“疾”）。",
    "start": 389.728,
    "end": 392.528,
    "duration": 2.8
  },
  {
    "id": 89,
    "text": "逐句因果推导与答题表述。",
    "start": 392.848,
    "end": 395.328,
    "duration": 2.48
  },
  {
    "id": 90,
    "text": "有了开阔想象，第四段必须进一步探究李白诗歌在宏观篇章与情感节律上的惊人爆发力。",
    "start": 395.328,
    "end": 403.168,
    "duration": 7.84
  },
  {
    "id": 91,
    "text": "首句立论，指出李白打破起承转合规则，",
    "start": 403.168,
    "end": 406.928,
    "duration": 3.76
  },
  {
    "id": 92,
    "text": "让诗情以决堤之势喷薄奔涌。",
    "start": 406.928,
    "end": 409.888,
    "duration": 2.96
  },
  {
    "id": 93,
    "text": "所以表述为：次句概括其七言歌行的音乐节奏，",
    "start": 409.888,
    "end": 413.888,
    "duration": 4.0
  },
  {
    "id": 94,
    "text": "转换神速且大起大落。",
    "start": 413.888,
    "end": 415.808,
    "duration": 1.92
  },
  {
    "id": 95,
    "text": "所以表述为：第三句调取全书最具代表性、",
    "start": 416.128,
    "end": 420.1,
    "duration": 3.972
  },
  {
    "id": 96,
    "text": "也是篇章起伏最剧烈的代表绝唱《将进酒》。",
    "start": 420.1,
    "end": 424.149,
    "duration": 4.049
  },
  {
    "id": 97,
    "text": "所以表述为：第四句分析天上来起势，",
    "start": 424.149,
    "end": 427.723,
    "duration": 3.574
  },
  {
    "id": 98,
    "text": "如同江河决口不可阻挡。",
    "start": 427.723,
    "end": 430.105,
    "duration": 2.382
  },
  {
    "id": 99,
    "text": "所以表述为：第五句紧承上句骤然跌落，",
    "start": 430.105,
    "end": 433.916,
    "duration": 3.811
  },
  {
    "id": 100,
    "text": "转入对高堂明镜白发的人生苦短浩叹。",
    "start": 433.916,
    "end": 437.728,
    "duration": 3.812
  },
  {
    "id": 101,
    "text": "所以表述为：第六句笔锋陡转腾跃，",
    "start": 437.888,
    "end": 440.981,
    "duration": 3.093
  },
  {
    "id": 102,
    "text": "高唱天生我材必有用的极致狂放自信。",
    "start": 440.981,
    "end": 444.592,
    "duration": 3.611
  },
  {
    "id": 103,
    "text": "所以表述为：第七句总结本段，全篇收束于同销万古愁的沉郁悲凉，",
    "start": 444.592,
    "end": 450.684,
    "duration": 6.092
  },
  {
    "id": 104,
    "text": "章法如悬崖飞瀑莫测。",
    "start": 450.684,
    "end": 452.715,
    "duration": 2.031
  },
  {
    "id": 105,
    "text": "所以表述为：本段答题思路总结。",
    "start": 452.715,
    "end": 455.648,
    "duration": 2.933
  },
  {
    "id": 106,
    "text": "本段聚焦于七言歌行的宏观结构与音乐律动：以《将进酒》为解剖样本，",
    "start": 455.792,
    "end": 461.792,
    "duration": 6.0
  },
  {
    "id": 107,
    "text": "层层追踪其开篇黄河万里的排空而起、",
    "start": 461.792,
    "end": 465.312,
    "duration": 3.52
  },
  {
    "id": 108,
    "text": "高堂明镜的骤然悲叹、天生我材的激昂高潮、",
    "start": 465.312,
    "end": 468.992,
    "duration": 3.68
  },
  {
    "id": 109,
    "text": "以及与尔同销万古愁的余韵深远；",
    "start": 468.992,
    "end": 472.112,
    "duration": 3.12
  },
  {
    "id": 110,
    "text": "深刻揭示李白诗歌不拘常格、情随神行、",
    "start": 472.112,
    "end": 475.952,
    "duration": 3.84
  },
  {
    "id": 111,
    "text": "如江河奔腾一泻千里的大气象。",
    "start": 475.952,
    "end": 478.592,
    "duration": 2.64
  },
  {
    "id": 112,
    "text": "所以本段具体答题完整版为：第五段：第四分论点，",
    "start": 478.912,
    "end": 483.472,
    "duration": 4.56
  },
  {
    "id": 113,
    "text": "清水芙蓉的自然诗美（韵之“逸”）。",
    "start": 483.472,
    "end": 486.672,
    "duration": 3.2
  },
  {
    "id": 114,
    "text": "逐句因果推导与答题表述。",
    "start": 486.672,
    "end": 489.312,
    "duration": 2.64
  },
  {
    "id": 115,
    "text": "在剖析了宏大的歌行之后，本段必须下沉到李白诗歌语言的天然本色与绝句艺术。",
    "start": 489.312,
    "end": 496.512,
    "duration": 7.2
  },
  {
    "id": 116,
    "text": "首句确立分论点，指出李白推崇天然纯真，",
    "start": 496.512,
    "end": 500.432,
    "duration": 3.92
  },
  {
    "id": 117,
    "text": "以“清水出芙蓉”为核心美学追求。",
    "start": 500.432,
    "end": 503.152,
    "duration": 2.72
  },
  {
    "id": 118,
    "text": "所以表述为：次句指出其文学史革新功绩，",
    "start": 503.472,
    "end": 507.306,
    "duration": 3.834
  },
  {
    "id": 119,
    "text": "荡涤齐梁以来的浮艳雕琢，让语言回归流转明丽。",
    "start": 507.306,
    "end": 511.899,
    "duration": 4.593
  },
  {
    "id": 120,
    "text": "所以表述为：第三句指出其在乐府体裁上的突破，",
    "start": 511.899,
    "end": 516.491,
    "duration": 4.592
  },
  {
    "id": 121,
    "text": "借古题自铸伟词，翻出全新盛唐气象。",
    "start": 516.491,
    "end": 519.936,
    "duration": 3.445
  },
  {
    "id": 122,
    "text": "所以表述为：第四句指出其在近体诗上的绝顶造诣，",
    "start": 519.936,
    "end": 524.758,
    "duration": 4.822
  },
  {
    "id": 123,
    "text": "五七言绝句达到无迹可求的神化境地。",
    "start": 524.758,
    "end": 528.432,
    "duration": 3.674
  },
  {
    "id": 124,
    "text": "所以表述为：第五句调取绝句代表名篇《早发白帝城》完整四句。",
    "start": 528.592,
    "end": 534.262,
    "duration": 5.67
  },
  {
    "id": 125,
    "text": "所以表述为：第六句总结本段，指出情景相生、",
    "start": 534.262,
    "end": 538.394,
    "duration": 4.132
  },
  {
    "id": 126,
    "text": "行云流水展现出大音希声的天赖之美。",
    "start": 538.394,
    "end": 542.067,
    "duration": 3.673
  },
  {
    "id": 127,
    "text": "所以表述为：本段答题思路总结。",
    "start": 542.067,
    "end": 545.051,
    "duration": 2.984
  },
  {
    "id": 128,
    "text": "本段是李白艺术特色的重要升华：由宏大歌行自然下沉到绝句本色，",
    "start": 545.051,
    "end": 551.479,
    "duration": 6.428
  },
  {
    "id": 129,
    "text": "以“清水出芙蓉，天然去雕饰”为审美核心；",
    "start": 551.479,
    "end": 555.152,
    "duration": 3.673
  },
  {
    "id": 130,
    "text": "分析其借乐府古题自铸伟词的时代飞跃；",
    "start": 555.232,
    "end": 559.152,
    "duration": 3.92
  },
  {
    "id": 131,
    "text": "并以《早发白帝城》的千里一日与轻舟万重为例，",
    "start": 559.152,
    "end": 562.992,
    "duration": 3.84
  },
  {
    "id": 132,
    "text": "论证语言纯净剔透、不著一字尽得风流的天赖境界，",
    "start": 562.992,
    "end": 567.792,
    "duration": 4.8
  },
  {
    "id": 133,
    "text": "全面展现其诗仙的飘逸神韵。",
    "start": 567.792,
    "end": 570.432,
    "duration": 2.64
  },
  {
    "id": 134,
    "text": "所以本段具体答题完整版为：第六段：尾段收官与文学史谱系闭环。",
    "start": 570.432,
    "end": 575.232,
    "duration": 4.8
  },
  {
    "id": 135,
    "text": "逐句因果推导与答题表述。",
    "start": 575.552,
    "end": 577.872,
    "duration": 2.32
  },
  {
    "id": 136,
    "text": "尾段作为三十分大题的收官，必须将李白置于唐诗高峰与后世流变的宏大谱系中定型。",
    "start": 577.872,
    "end": 584.912,
    "duration": 7.04
  },
  {
    "id": 137,
    "text": "首句全面综合前述四个维度，盛赞其以天才熔铸了盛唐气象的博大气魄。",
    "start": 584.912,
    "end": 591.232,
    "duration": 6.32
  },
  {
    "id": 138,
    "text": "所以表述为：次句确立历史地位，指出他与杜甫并峙为盛唐两座最高峰，",
    "start": 591.232,
    "end": 597.392,
    "duration": 6.16
  },
  {
    "id": 139,
    "text": "树立了浪漫主义最高范式。",
    "start": 597.392,
    "end": 599.392,
    "duration": 2.0
  },
  {
    "id": 140,
    "text": "所以表述为：第三句向中唐与宋代纵向延伸，",
    "start": 599.712,
    "end": 603.68,
    "duration": 3.968
  },
  {
    "id": 141,
    "text": "点明其对韩孟奇崛与苏轼豪迈的深远启迪。",
    "start": 603.68,
    "end": 607.712,
    "duration": 4.032
  },
  {
    "id": 142,
    "text": "所以表述为：第四句得出宏观历史定评，",
    "start": 607.712,
    "end": 611.52,
    "duration": 3.808
  },
  {
    "id": 143,
    "text": "指出李白诗歌成为中华文明朝气与精神自由的永恒象征。",
    "start": 611.52,
    "end": 617.28,
    "duration": 5.76
  },
  {
    "id": 144,
    "text": "所以表述为：本段答题思路总结。",
    "start": 617.28,
    "end": 620.16,
    "duration": 2.88
  },
  {
    "id": 145,
    "text": "本段完成了极具学术高度的总结：先以盛唐气象的人格化熔铸为总括；",
    "start": 620.16,
    "end": 626.16,
    "duration": 6.0
  },
  {
    "id": 146,
    "text": "随后将李杜并峙并提，确立双峰并峙的历史法则；",
    "start": 626.16,
    "end": 630.32,
    "duration": 4.16
  },
  {
    "id": 147,
    "text": "紧接着清晰勾勒出从李白出发，经中唐韩愈、",
    "start": 630.64,
    "end": 634.64,
    "duration": 4.0
  },
  {
    "id": 148,
    "text": "李贺奇险造语的过渡，最终汇入宋代苏轼豪迈旷达词风的发展脉络，",
    "start": 634.64,
    "end": 640.56,
    "duration": 5.92
  },
  {
    "id": 149,
    "text": "使整道三十分大题在雄浑壮丽的诗歌演变史中完美收官。",
    "start": 640.56,
    "end": 645.44,
    "duration": 4.88
  },
  {
    "id": 150,
    "text": "所以本段具体答题完整版为：整道大题的内在逻辑链总括。",
    "start": 645.44,
    "end": 649.68,
    "duration": 4.24
  },
  {
    "id": 151,
    "text": "这道三十分大题的本质，是一场极度严密的逻辑推演。",
    "start": 650.0,
    "end": 654.16,
    "duration": 4.16
  },
  {
    "id": 152,
    "text": "整篇答卷从头到尾遵循着“由典范定评、",
    "start": 654.16,
    "end": 657.36,
    "duration": 3.2
  },
  {
    "id": 153,
    "text": "到时代人格、到奇崛想象、到奔腾篇章、",
    "start": 657.36,
    "end": 660.96,
    "duration": 3.6
  },
  {
    "id": 154,
    "text": "到自然天赖、最终回归李杜并峙”的必然法则。",
    "start": 660.96,
    "end": 664.56,
    "duration": 3.6
  },
  {
    "id": 155,
    "text": "阅卷老师看到的绝不是散乱的答题点，",
    "start": 664.56,
    "end": 667.52,
    "duration": 2.96
  },
  {
    "id": 156,
    "text": "而是一条咬合紧密的因果长链：第一步是“立论定性”，",
    "start": 667.52,
    "end": 671.92,
    "duration": 4.4
  },
  {
    "id": 157,
    "text": "开门见山借严羽“一结盛唐之局”与袁本教材，",
    "start": 671.92,
    "end": 676.96,
    "duration": 5.04
  },
  {
    "id": 158,
    "text": "确立李白作为盛唐浪漫主义最高投影的坐标。",
    "start": 676.96,
    "end": 680.96,
    "duration": 4.0
  },
  {
    "id": 159,
    "text": "第二步是“盛唐人格”，以“欲上青天”的壮志与“安能折腰”的傲骨，",
    "start": 680.96,
    "end": 686.64,
    "duration": 5.68
  },
  {
    "id": 160,
    "text": "剖析大一统繁盛时代催生出的主体自由品格。",
    "start": 686.64,
    "end": 690.72,
    "duration": 4.08
  },
  {
    "id": 161,
    "text": "第三步是“超然想象”，以《梦游天姥》仙境与飞流直下三千尺，",
    "start": 691.04,
    "end": 696.24,
    "duration": 5.2
  },
  {
    "id": 162,
    "text": "论证极度夸张打破物理时空的浪漫飞升。",
    "start": 696.24,
    "end": 699.6,
    "duration": 3.36
  },
  {
    "id": 163,
    "text": "第四步是“奔腾章法”，以《将进酒》黄河之水天上来与大起大落，",
    "start": 699.6,
    "end": 705.04,
    "duration": 5.44
  },
  {
    "id": 164,
    "text": "展现决堤喷薄的情感语流与惊人乐感。",
    "start": 705.04,
    "end": 708.56,
    "duration": 3.52
  },
  {
    "id": 165,
    "text": "第五步是“天然神韵”，以“清水出芙蓉”与《早发白帝城》绝句天赖，",
    "start": 708.56,
    "end": 713.52,
    "duration": 4.96
  },
  {
    "id": 166,
    "text": "阐明洗尽雕饰、情景相生的纯净本色。",
    "start": 713.52,
    "end": 716.8,
    "duration": 3.28
  },
  {
    "id": 167,
    "text": "第六步是“史学闭环”，把李白与杜甫双峰并提，",
    "start": 717.04,
    "end": 721.04,
    "duration": 4.0
  },
  {
    "id": 168,
    "text": "自然引向中唐韩贺奇崛与两宋苏轼豪放旷达的浩瀚传承。",
    "start": 721.04,
    "end": 726.88,
    "duration": 5.84
  },
  {
    "id": 169,
    "text": "这六步层层递进，前一步的结论必然成为后一步的前提。",
    "start": 726.88,
    "end": 731.2,
    "duration": 4.32
  },
  {
    "id": 170,
    "text": "你在考场上顺着因果关系顺流而下，",
    "start": 731.2,
    "end": 734.08,
    "duration": 2.88
  },
  {
    "id": 171,
    "text": "就能自然写出近千字的满分答卷。",
    "start": 734.08,
    "end": 736.64,
    "duration": 2.56
  }
]