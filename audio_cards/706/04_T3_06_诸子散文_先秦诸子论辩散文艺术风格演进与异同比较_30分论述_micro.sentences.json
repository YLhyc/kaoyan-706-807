[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "先一条线串完体裁三阶段总脉络（语录体→对话论辩→专题论文），",
    "start": 0.22,
    "end": 6.514,
    "duration": 6.294
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再按先秦思想三大学派依次分家对比：《论语》至《孟子》儒家雄辩演化、《老子》至《庄子》道家哲诗奇想、最后到法家韩非与荀子立起冷峻周密论证法度。",
    "start": 7.332,
    "end": 19.8,
    "duration": 12.469
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "春秋战国“百家争鸣”催生先秦诸子散文，伴随学说争鸣逐步奠定古代说理散文的文体法度与风格谱系。",
    "start": 20.636,
    "end": 29.73,
    "duration": 9.094
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 文体演进三阶：语录 → 对话 → 专题论文",
    "start": 30.443,
    "end": 34.377,
    "duration": 3.935
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "春秋末《论语》呈短小“语录体”，辞约义丰；",
    "start": 35.154,
    "end": 38.667,
    "duration": 3.513
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "战国中《墨子》《孟子》转“对话式论辩体”（《庄子》寓言构篇抒情）；",
    "start": 39.403,
    "end": 44.506,
    "duration": 5.103
  },
  {
    "id": "sec0_step2_c0",
    "dom_key": "sec0_step2_c0",
    "text": "战国末《荀子》《韩非子》标有篇名、结构完整，成“专题论文体”成熟范式。",
    "start": 45.29,
    "end": 51.456,
    "duration": 6.166
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 儒家：由《论语》雍容转向《孟子》气势雄辩",
    "start": 52.153,
    "end": 56.437,
    "duration": 4.283
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《论语》雍容雅致、言近旨远；孟子“予岂好辩哉，予不得已也”，转而犀利雄辩；",
    "start": 57.161,
    "end": 63.764,
    "duration": 6.602
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "擅类比、欲擒故纵与排比对偶，“五十步笑百步”讽梁惠王，",
    "start": 64.476,
    "end": 69.256,
    "duration": 4.78
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "“揠苗助长”阐养“浩然之气”，充沛刚健。",
    "start": 70.026,
    "end": 72.924,
    "duration": 2.897
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 道家：突破名辩、以寓言奇想显超旷境",
    "start": 73.655,
    "end": 78.253,
    "duration": 4.598
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《老子》言约义丰、韵散结合、多正言若反格言；《庄子》推至哲诗交融高峰；",
    "start": 79.021,
    "end": 85.495,
    "duration": 6.473
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "弃正面逻辑驳难，用“寓言、重言、卮言”，《逍遥游》借北冥大鹏与蜩学鸠对照，汪洋恣肆仪态万方。",
    "start": 86.221,
    "end": 94.919,
    "duration": 8.698
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 法家与末期诸子：冷峻剖析与谨严论证法度",
    "start": 95.654,
    "end": 100.291,
    "duration": 4.637
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "立足功利人性论，《孤愤》《说难》洞察君臣利害，条分缕析；",
    "start": 101.033,
    "end": 105.847,
    "duration": 4.814
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "善借“买椟还珠”“自相矛盾”“守株待兔”透辟说理；",
    "start": 106.553,
    "end": 110.504,
    "duration": 3.951
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "同荀子博学详密论说文一道，奠定后世说理文结构严谨、逻辑周密典范。",
    "start": 111.246,
    "end": 117.557,
    "duration": 6.311
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "先秦诸子散文历经语录体、对话体向专题论文成熟，",
    "start": 118.281,
    "end": 123.021,
    "duration": 4.741
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "形成儒家道义雄辩、道家寓言奇想与法家冷峻剖析并峙的风格谱系，",
    "start": 123.83,
    "end": 129.665,
    "duration": 5.835
  },
  {
    "id": "concl_c2",
    "dom_key": "concl_c2",
    "text": "立下古代散文论辩法度。",
    "start": 130.367,
    "end": 132.375,
    "duration": 2.007
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：严格记住体制演进三步：《论语》语录体 ",
    "start": 133.197,
    "end": 137.014,
    "duration": 3.817
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "→ 《墨》《孟》对话式论辩体（《庄子》以寓言构篇） ",
    "start": 137.773,
    "end": 141.485,
    "duration": 3.712
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "→ 《荀子》《韩非子》专题论文体。",
    "start": 142.21,
    "end": 144.42,
    "duration": 2.21
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背全先秦诸子散文“语录体→对话论辩体→专题论文体”三阶代表作？",
    "start": 145.236,
    "end": 152.346,
    "duration": 7.11
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 对照孟子“五十步笑百步”雄辩、庄子“北冥大鹏”汪洋、韩非“买椟还珠”冷峻之风格差异？",
    "start": 153.108,
    "end": 161.555,
    "duration": 8.447
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2017 年真题：《荀子》《孟子》《庄子》《韩非子》四家论辩异同怎么抓要点？",
    "start": 162.325,
    "end": 170.37,
    "duration": 8.045
  }
]