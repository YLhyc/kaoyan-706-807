[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "诸子散文·先秦诸子论辩散文艺术风格演进与异同比较",
    "start": 0.134,
    "end": 5.159,
    "duration": 5.025
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "先一条线串完体裁三阶段总脉络（语录体→对话论辩→专题论文），",
    "start": 5.748,
    "end": 12.192,
    "duration": 6.444
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再按先秦思想三大学派依次分家对比：《论语》至《孟子》儒家雄辩演化、《老子》至《庄子》道家哲诗奇想、最后到法家韩非与荀子立起冷峻周密论证法度。",
    "start": 12.48,
    "end": 25.613,
    "duration": 13.133
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "春秋战国“百家争鸣”催生先秦诸子散文，伴随学说争鸣逐步奠定古代说理散文的文体法度与风格谱系。",
    "start": 26.187,
    "end": 35.443,
    "duration": 9.257
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 文体演进三阶：语录 → 对话 → 专题论文",
    "start": 36.03,
    "end": 40.3,
    "duration": 4.27
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "春秋末《论语》呈短小“语录体”，辞约义丰；",
    "start": 40.887,
    "end": 45.639,
    "duration": 4.752
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "战国中《墨子》《孟子》转“对话式论辩体”（《庄子》寓言构篇抒情）；",
    "start": 46.226,
    "end": 53.139,
    "duration": 6.913
  },
  {
    "id": "sec0_step2_c0",
    "dom_key": "sec0_step2_c0",
    "text": "战国末《荀子》《韩非子》标有篇名、结构完整，成“专题论文体”成熟范式。",
    "start": 53.713,
    "end": 61.667,
    "duration": 7.955
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 儒家：由《论语》雍容转向《孟子》气势雄辩",
    "start": 62.263,
    "end": 66.467,
    "duration": 4.205
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《论语》雍容雅致、言近旨远；孟子“予岂好辩哉，予不得已也”，转而犀利雄辩；",
    "start": 67.054,
    "end": 75.061,
    "duration": 8.007
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "擅类比、欲擒故纵与排比对偶，“五十步笑百步”讽梁惠王，“揠苗助长”阐养“浩然之气”，充沛刚健。",
    "start": 75.648,
    "end": 85.413,
    "duration": 9.765
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 道家：突破名辩、以寓言奇想显超旷境",
    "start": 86.0,
    "end": 90.751,
    "duration": 4.752
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《老子》言约义丰、韵散结合、多正言若反格言；《庄子》推至哲诗交融高峰；",
    "start": 91.338,
    "end": 99.201,
    "duration": 7.864
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "弃正面逻辑驳难，用“寓言、重言、卮言”，《逍遥游》借北冥大鹏与蜩学鸠对照，汪洋恣肆仪态万方。",
    "start": 99.776,
    "end": 109.71,
    "duration": 9.934
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 法家与末期诸子：冷峻剖析与谨严论证法度",
    "start": 110.297,
    "end": 115.139,
    "duration": 4.843
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "立足功利人性论，《孤愤》《说难》洞察君臣利害，条分缕析；",
    "start": 115.713,
    "end": 121.884,
    "duration": 6.171
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "善借“买椟还珠”“自相矛盾”“守株待兔”透辟说理；",
    "start": 122.119,
    "end": 126.48,
    "duration": 4.361
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "同荀子博学详密论说文一道，奠定后世说理文结构严谨、逻辑周密典范。",
    "start": 127.067,
    "end": 134.605,
    "duration": 7.538
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "先秦诸子散文历经语录体、对话体向专题论文成熟，",
    "start": 135.192,
    "end": 140.061,
    "duration": 4.869
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "形成儒家道义雄辩、道家寓言奇想与法家冷峻剖析并峙的风格谱系，立下古代散文论辩法度。",
    "start": 140.336,
    "end": 148.759,
    "duration": 8.423
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：严格记住体制演进三步：《论语》语录体 → 《墨》《孟》对话式论辩体（《庄子》以寓言构篇） → 《荀子》《韩非子》专题论文体。",
    "start": 149.346,
    "end": 160.764,
    "duration": 11.418
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背全先秦诸子散文“语录体→对话论辩体→专题论文体”三阶代表作？",
    "start": 161.338,
    "end": 168.642,
    "duration": 7.304
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 对照孟子“五十步笑百步”雄辩、庄子“北冥大鹏”汪洋、韩非“买椟还珠”冷峻之风格差异？",
    "start": 169.229,
    "end": 178.29,
    "duration": 9.062
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2017 年真题：《荀子》《孟子》《庄子》《韩非子》四家论辩异同怎么抓要点？",
    "start": 178.864,
    "end": 187.457,
    "duration": 8.593
  }
]