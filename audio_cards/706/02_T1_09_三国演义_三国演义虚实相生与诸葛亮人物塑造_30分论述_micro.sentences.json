[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《三国演义》·虚实相生与诸葛亮人物塑造",
    "start": 0.354,
    "end": 3.806,
    "duration": 3.452
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "法→人→战→思四步推进：先立定历史演义“七分事实，三分虚构”的基本法则，",
    "start": 4.814,
    "end": 11.466,
    "duration": 6.652
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再聚焦虚实熔铸出的第一理想人物诸葛亮，随后把智慧人物放进“赤壁之战”全景博弈中检验，",
    "start": 11.614,
    "end": 18.546,
    "duration": 6.932
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最终点出全书“拥刘反曹”倾向与分合沧桑慨叹。",
    "start": 18.694,
    "end": 22.506,
    "duration": 3.812
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《三国演义》是中国古代第一部长篇章回历史演义小说。",
    "start": 23.594,
    "end": 27.806,
    "duration": 4.212
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "罗贯中以《三国志》及裴注为框架熔裁话本戏曲，清代章学诚《丙辰札记》概括为“七分事实，三分虚构”。",
    "start": 28.814,
    "end": 38.346,
    "duration": 9.532
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 贯彻“七分事实，三分虚构”原则",
    "start": 39.354,
    "end": 43.286,
    "duration": 3.932
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "依傍三国鼎立大势、重大战役胜负与归宿之“实”；围绕美学理想虚构生发历史缝隙，令实服从虚。",
    "start": 44.214,
    "end": 54.846,
    "duration": 10.632
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "“关羽过五关斩六将”“温酒斩华雄”“草船借箭”“借东风”多属艺术虚构或移花接木，兼具大局信实与传奇魅力。",
    "start": 55.814,
    "end": 66.826,
    "duration": 11.012
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 塑造“智绝”兼忠贞化身诸葛亮",
    "start": 67.794,
    "end": 71.606,
    "duration": 3.812
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "战略预见三分；外交军事舌战群儒、巧激周瑜、草船借箭、空城退敌；品格紧扣“鞠躬尽瘁，死而后已”；",
    "start": 72.574,
    "end": 84.806,
    "duration": 12.232
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "虽鲁迅评“状诸葛之多智而近妖”指部分夸饰之弊，仍为忠诚智慧的经典化身。",
    "start": 85.28,
    "end": 94.092,
    "duration": 8.812
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 长于全景式战争与心理谋略博弈",
    "start": 94.8,
    "end": 98.532,
    "duration": 3.732
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "数十场战役各具面貌，不重纯厮杀，着力写战前政治外交与心理较量。",
    "start": 99.192,
    "end": 105.924,
    "duration": 6.732
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "铺陈蒋干中计、周瑜打黄盖、诸葛亮借箭、庞统献连环计，终以火烧赤壁收束，呈现以弱胜强的战争辩证智慧。",
    "start": 106.932,
    "end": 118.104,
    "duration": 11.172
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 贯注“拥刘反曹”倾向与分合沧桑",
    "start": 118.992,
    "end": 123.044,
    "duration": 4.052
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "鲜明“拥刘反曹”，借刘备宽厚寄托民众对清明政治的渴望；",
    "start": 124.012,
    "end": 130.744,
    "duration": 6.732
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "以“天下大势，分久必合，合久必分”统领兴衰，",
    "start": 131.752,
    "end": 137.084,
    "duration": 5.332
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "毛宗岗本卷首添杨慎《临江仙》“浪花淘尽英雄”，于三国归晋中叹惋纷争流逝。",
    "start": 137.352,
    "end": 144.564,
    "duration": 7.212
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《三国演义》依托“七分事实，三分虚构”法则，在战争博弈中塑造诸葛亮等忠义典型，",
    "start": 145.612,
    "end": 152.344,
    "duration": 6.732
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "贯注“拥刘反曹”理想与分合沧桑感，确立历史演义体制规范。",
    "start": 152.772,
    "end": 158.264,
    "duration": 5.492
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：清代章学诚《丙辰札记》评“七分事实，三分虚构”；",
    "start": 159.272,
    "end": 164.284,
    "duration": 5.012
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "鲁迅评“状诸葛之多智而近妖”，并概括“三绝”（智绝诸葛、义绝关羽、奸绝曹操）。",
    "start": 165.332,
    "end": 172.464,
    "duration": 7.132
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 章学诚与鲁迅分别如何评《三国》虚实法则与诸葛亮？",
    "start": 173.392,
    "end": 179.404,
    "duration": 6.012
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 诸葛亮的四个智谋名段与赤壁之战四个连环谋略各是什么？",
    "start": 180.372,
    "end": 186.664,
    "duration": 6.292
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 怎样理解全书“拥刘反曹”与“分久必合”苍凉感之间的张力？",
    "start": 187.592,
    "end": 194.004,
    "duration": 6.412
  }
]