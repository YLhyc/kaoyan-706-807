[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《三国演义》·虚实相生与诸葛亮人物塑造",
    "start": 0.134,
    "end": 3.826,
    "duration": 3.692
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "法→人→战→思四步推进：先立定历史演义“七分事实，三分虚构”的基本法则，",
    "start": 4.313,
    "end": 12.325,
    "duration": 8.012
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再聚焦虚实熔铸出的第一理想人物诸葛亮，随后把智慧人物放进“赤壁之战”全景博弈中检验，",
    "start": 12.473,
    "end": 20.165,
    "duration": 7.692
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最终点出全书“拥刘反曹”倾向与分合沧桑慨叹。",
    "start": 20.313,
    "end": 24.885,
    "duration": 4.572
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《三国演义》是中国古代第一部长篇章回历史演义小说。",
    "start": 25.303,
    "end": 30.275,
    "duration": 4.972
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "罗贯中以《三国志》及裴注为框架熔裁话本戏曲，清代章学诚《丙辰札记》概括为“七分事实，三分虚构”。",
    "start": 30.393,
    "end": 39.765,
    "duration": 9.372
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 贯彻“七分事实，三分虚构”原则",
    "start": 40.389,
    "end": 43.921,
    "duration": 3.532
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "依傍三国鼎立大势、重大战役胜负与归宿之“实”；围绕美学理想虚构生发历史缝隙，令实服从虚。",
    "start": 44.449,
    "end": 54.111,
    "duration": 9.662
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "“关羽过五关斩六将”“温酒斩华雄”“草船借箭”“借东风”多属艺术虚构或移花接木，兼具大局信实与传奇魅力。",
    "start": 54.639,
    "end": 64.651,
    "duration": 10.012
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 塑造“智绝”兼忠贞化身诸葛亮",
    "start": 65.32,
    "end": 68.772,
    "duration": 3.452
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "战略预见三分；外交军事舌战群儒、巧激周瑜、草船借箭、空城退敌；品格紧扣“鞠躬尽瘁，死而后已”；",
    "start": 69.252,
    "end": 79.874,
    "duration": 10.622
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "虽鲁迅评“状诸葛之多智而近妖”指部分夸饰之弊，仍为忠诚智慧的经典化身。",
    "start": 80.422,
    "end": 88.834,
    "duration": 8.412
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 长于全景式战争与心理谋略博弈",
    "start": 89.459,
    "end": 92.831,
    "duration": 3.372
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "数十场战役各具面貌，不重纯厮杀，着力写战前政治外交与心理较量。",
    "start": 93.312,
    "end": 100.764,
    "duration": 7.452
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "铺陈蒋干中计、周瑜打黄盖、诸葛亮借箭、庞统献连环计，终以火烧赤壁收束，呈现以弱胜强的战争辩证智慧。",
    "start": 101.256,
    "end": 111.588,
    "duration": 10.332
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 贯注“拥刘反曹”倾向与分合沧桑",
    "start": 112.265,
    "end": 115.717,
    "duration": 3.452
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "鲜明“拥刘反曹”，借刘备宽厚寄托民众对清明政治的渴望；",
    "start": 116.245,
    "end": 122.977,
    "duration": 6.732
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "以“天下大势，分久必合，合久必分”统领兴衰，",
    "start": 123.482,
    "end": 128.214,
    "duration": 4.732
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "毛宗岗本卷首添杨慎《临江仙》“浪花淘尽英雄”，于三国归晋中叹惋纷争流逝。",
    "start": 128.522,
    "end": 135.334,
    "duration": 6.812
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《三国演义》依托“七分事实，三分虚构”法则，在战争博弈中塑造诸葛亮等忠义典型，",
    "start": 135.912,
    "end": 143.413,
    "duration": 7.501
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "贯注“拥刘反曹”理想与分合沧桑感，确立历史演义体制规范。",
    "start": 143.428,
    "end": 149.524,
    "duration": 6.096
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：清代章学诚《丙辰札记》评“七分事实，三分虚构”；",
    "start": 150.047,
    "end": 155.419,
    "duration": 5.372
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "鲁迅评“状诸葛之多智而近妖”，并概括“三绝”（智绝诸葛、义绝关羽、奸绝曹操）。",
    "start": 155.697,
    "end": 162.349,
    "duration": 6.652
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 章学诚与鲁迅分别如何评《三国》虚实法则与诸葛亮？",
    "start": 163.057,
    "end": 168.669,
    "duration": 5.612
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 诸葛亮的四个智谋名段与赤壁之战四个连环谋略各是什么？",
    "start": 169.155,
    "end": 175.647,
    "duration": 6.492
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 怎样理解全书“拥刘反曹”与“分久必合”苍凉感之间的张力？",
    "start": 176.167,
    "end": 182.259,
    "duration": 6.092
  }
]