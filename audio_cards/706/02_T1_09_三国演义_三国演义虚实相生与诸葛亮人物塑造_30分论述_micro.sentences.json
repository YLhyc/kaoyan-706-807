[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "法→人→战→思四步推进：先立定历史演义“七分事实，三分虚构”的基本法则，",
    "start": 0.224,
    "end": 7.931,
    "duration": 7.706
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再聚焦虚实熔铸出的第一理想人物诸葛亮，",
    "start": 8.632,
    "end": 11.853,
    "duration": 3.221
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "随后把智慧人物放进“赤壁之战”全景博弈中检验，",
    "start": 12.584,
    "end": 16.486,
    "duration": 3.902
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最终点出全书“拥刘反曹”倾向与分合沧桑慨叹。",
    "start": 17.235,
    "end": 21.462,
    "duration": 4.226
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《三国演义》是中国古代第一部长篇章回历史演义小说。",
    "start": 22.223,
    "end": 26.61,
    "duration": 4.388
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "罗贯中以《三国志》及裴注为框架熔裁话本戏曲，",
    "start": 27.351,
    "end": 31.352,
    "duration": 4.001
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "清代章学诚《丙辰札记》概括为“七分事实，三分虚构”。",
    "start": 32.118,
    "end": 36.425,
    "duration": 4.308
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 贯彻“七分事实，三分虚构”原则",
    "start": 37.171,
    "end": 40.541,
    "duration": 3.37
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "依傍三国鼎立大势、重大战役胜负与归宿之“实”；围绕美学理想虚构生发历史缝隙，令实服从虚。",
    "start": 41.266,
    "end": 49.445,
    "duration": 8.179
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "“关羽过五关斩六将”“温酒斩华雄”“草船借箭”“借东风”多属艺术虚构或移花接木，",
    "start": 50.18,
    "end": 57.005,
    "duration": 6.824
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "兼具大局信实与传奇魅力。",
    "start": 57.729,
    "end": 60.068,
    "duration": 2.339
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 塑造“智绝”兼忠贞化身诸葛亮",
    "start": 60.764,
    "end": 64.045,
    "duration": 3.282
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "战略预见三分；",
    "start": 64.832,
    "end": 66.054,
    "duration": 1.222
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "外交军事舌战群儒、巧激周瑜、草船借箭、空城退敌；",
    "start": 66.804,
    "end": 71.683,
    "duration": 4.879
  },
  {
    "id": "sec1_step0_c2",
    "dom_key": "sec1_step0_c2",
    "text": "品格紧扣“鞠躬尽瘁，死而后已”；",
    "start": 72.386,
    "end": 75.065,
    "duration": 2.679
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "虽鲁迅评“状诸葛之多智而近妖”指部分夸饰之弊，仍为忠诚智慧的经典化身。",
    "start": 75.813,
    "end": 82.63,
    "duration": 6.818
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 长于全景式战争与心理谋略博弈",
    "start": 83.402,
    "end": 87.031,
    "duration": 3.629
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "数十场战役各具面貌，不重纯厮杀，着力写战前政治外交与心理较量。",
    "start": 87.773,
    "end": 93.528,
    "duration": 5.755
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "铺陈蒋干中计、周瑜打黄盖、诸葛亮借箭、庞统献连环计，终以火烧赤壁收束，",
    "start": 94.345,
    "end": 101.113,
    "duration": 6.768
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "呈现以弱胜强的战争辩证智慧。",
    "start": 101.851,
    "end": 104.507,
    "duration": 2.655
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 贯注“拥刘反曹”倾向与分合沧桑",
    "start": 105.253,
    "end": 108.892,
    "duration": 3.639
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "鲜明“拥刘反曹”，借刘备宽厚寄托民众对清明政治的渴望；",
    "start": 109.595,
    "end": 114.496,
    "duration": 4.901
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "以“天下大势，分久必合，合久必分”统领兴衰，",
    "start": 115.215,
    "end": 119.235,
    "duration": 4.02
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "毛宗岗本卷首添杨慎《临江仙》“浪花淘尽英雄”，于三国归晋中叹惋纷争流逝。",
    "start": 119.959,
    "end": 126.6,
    "duration": 6.641
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《三国演义》依托“七分事实，三分虚构”法则，在战争博弈中塑造诸葛亮等忠义典型，",
    "start": 127.338,
    "end": 134.679,
    "duration": 7.341
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "贯注“拥刘反曹”理想与分合沧桑感，确立历史演义体制规范。",
    "start": 135.47,
    "end": 140.87,
    "duration": 5.4
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：清代章学诚《丙辰札记》评“七分事实，三分虚构”；",
    "start": 141.691,
    "end": 146.466,
    "duration": 4.776
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "鲁迅评“状诸葛之多智而近妖”，并概括“三绝”（智绝诸葛、义绝关羽、奸绝曹操）。",
    "start": 147.238,
    "end": 154.04,
    "duration": 6.801
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 章学诚与鲁迅分别如何评《三国》虚实法则与诸葛亮？",
    "start": 154.777,
    "end": 160.679,
    "duration": 5.901
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 诸葛亮的四个智谋名段与赤壁之战四个连环谋略各是什么？",
    "start": 161.435,
    "end": 167.773,
    "duration": 6.339
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 怎样理解全书“拥刘反曹”与“分久必合”苍凉感之间的张力？",
    "start": 168.522,
    "end": 174.518,
    "duration": 5.996
  }
]