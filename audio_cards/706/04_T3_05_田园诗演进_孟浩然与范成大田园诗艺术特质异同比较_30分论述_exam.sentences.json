[
  {
    "id": 1,
    "text": "中国古典田园诗自东晋陶渊明开创以来，历经盛唐繁荣与两宋嬗变，形成了源远流长而风貌各异的审美传统。",
    "start": 0.1,
    "end": 10.961,
    "duration": 10.861
  },
  {
    "id": 2,
    "text": "盛唐孟浩然与南宋范成大，分别代表了盛唐山水田园诗与宋代田园纪实诗的最高艺术成就。",
    "start": 10.911,
    "end": 19.7,
    "duration": 8.789
  },
  {
    "id": 3,
    "text": "两人同承陶渊明审美遗泽，却因时代语境，阶层身份与诗学理念的差异，展现出截然不同的艺术风貌。",
    "start": 19.701,
    "end": 29.05,
    "duration": 9.349
  },
  {
    "id": 4,
    "text": "比较两人的田园诗艺术特质异同并审视其流变轨迹，主要展现为以下四个核心维度，",
    "start": 29.049,
    "end": 36.666,
    "duration": 7.617
  },
  {
    "id": 5,
    "text": "第一，同具对田园自然之审美观照，承续陶渊明开创之田园诗歌美学血脉。",
    "start": 36.667,
    "end": 43.672,
    "duration": 7.005
  },
  {
    "id": 6,
    "text": "孟浩然与范成大在精神品格上，均深受陶渊明归隐田园情怀的深刻熏染。",
    "start": 43.672,
    "end": 50.612,
    "duration": 6.94
  },
  {
    "id": 7,
    "text": "二人皆以真挚清新的笔触，将远离官场喧嚣的乡村风光与淳朴乡野作为心灵寄托之所。",
    "start": 50.612,
    "end": 59.453,
    "duration": 8.841
  },
  {
    "id": 8,
    "text": "无论孟浩然笔下的农家待客之乐，还是范成大笔下的田间节令之美，都摆脱了汉魏古诗中空泛的游仙隐逸陈套，表现出对大自然草木岁时变化的敏锐体察与对农村淳朴风习的深厚眷恋，共同维系了中国古代田园诗返璞归真，宁静平和的抒情主旨。",
    "start": 59.453,
    "end": 80.725,
    "duration": 21.272
  },
  {
    "id": 9,
    "text": "第二，孟浩然以隐逸士人视角观照田园，偏重写意宁静与人情淳厚之闲适意境。",
    "start": 80.725,
    "end": 88.316,
    "duration": 7.591
  },
  {
    "id": 10,
    "text": "盛唐开元盛世的时代氛围与孟浩然长年隐居襄阳鹿门山的身世际遇，决定了他诗中田园的纯粹性与审美化特征。",
    "start": 88.316,
    "end": 98.629,
    "duration": 10.313
  },
  {
    "id": 11,
    "text": "孟浩然视田园为忘却名利沉浮的世外桃源，其创作立足于悠游林下的隐士视角。",
    "start": 98.629,
    "end": 106.298,
    "duration": 7.669
  },
  {
    "id": 12,
    "text": "在代表作 《过故人庄》 中，以 “故人具鸡黍，邀我至田家。",
    "start": 106.298,
    "end": 111.207,
    "duration": 4.909
  },
  {
    "id": 13,
    "text": "绿树村边合，青山郭外斜。",
    "start": 111.207,
    "end": 114.098,
    "duration": 2.891
  },
  {
    "id": 14,
    "text": "开轩面场圃，把酒话桑麻” 开篇入画，诗中虽提及 “桑麻”，却毫无农夫耕作之艰辛疲顿，着力表现的是绿树青山环抱下的恬淡幽静与宾主把酒言欢的淳朴人情。",
    "start": 114.097,
    "end": 128.615,
    "duration": 14.518
  },
  {
    "id": 15,
    "text": "其诗风平淡幽远，神韵超然，体现了盛唐诗歌意象空灵，情景交融的高超境界。",
    "start": 128.616,
    "end": 136.35,
    "duration": 7.734
  },
  {
    "id": 16,
    "text": "第三，范成大以地方官吏与生活参与者视角深入田舍，偏重写实农事与民生疾苦之社会关怀。",
    "start": 136.35,
    "end": 145.491,
    "duration": 9.141
  },
  {
    "id": 17,
    "text": "南宋中后期民族危机未靖，阶级矛盾尖锐的社会现实，促使范成大以更加严肃冷峻的现实主义眼光审视农村。",
    "start": 145.491,
    "end": 155.934,
    "duration": 10.443
  },
  {
    "id": 18,
    "text": "晚年退居石湖后所作的 《四时田园杂兴》 六十首，被誉为 “田园诗集大成之作”。",
    "start": 155.933,
    "end": 162.561,
    "duration": 6.628
  },
  {
    "id": 19,
    "text": "范成大不仅描写农村四时物候与自然风光，更以参与者和细致观察者的视角全方位记录农耕劳作。",
    "start": 162.561,
    "end": 171.545,
    "duration": 8.984
  },
  {
    "id": 20,
    "text": "在 《四时田园杂兴·夏日》 中写道，“昼出耘田夜绩麻，村庄儿女各当家。",
    "start": 171.545,
    "end": 177.925,
    "duration": 6.38
  },
  {
    "id": 21,
    "text": "童孙未解供耕织，也傍桑阴学种瓜。",
    "start": 177.926,
    "end": 181.663,
    "duration": 3.737
  },
  {
    "id": 22,
    "text": "诗作展现了男女老少全力稼穑的真实图景；更为深刻的是，范诗直面残酷剥削，写出了 “租船又报到关西”，“采菱辛苦废南亩” 等官府苛捐杂税逼迫下的农家生存困境，展现出深切关怀民生疾苦的忧患意识。",
    "start": 181.663,
    "end": 199.927,
    "duration": 18.264
  },
  {
    "id": 23,
    "text": "第四，从盛唐空灵神韵向宋代工细纪实的演进，全面体现了唐宋诗歌美学转型之历史法则。",
    "start": 199.927,
    "end": 208.872,
    "duration": 8.945
  },
  {
    "id": 24,
    "text": "孟浩然与范成大的艺术差异，深刻折射了古典田园诗由唐入宋的文体演变规律。",
    "start": 208.872,
    "end": 215.929,
    "duration": 7.057
  },
  {
    "id": 25,
    "text": "盛唐孟诗重 “神韵” 与 “意境”，善于舍弃具体琐碎的生活细节，以白描勾勒山川神貌，追寻心灵与自然的契合，具有浑融冲淡的美学品格；南宋范诗则重 “纪实” 与 “事理”，将丰富的农业生产知识，民俗乡规，甚至俚俗语言全面引入诗中，笔触精细如画工写真。",
    "start": 215.929,
    "end": 238.855,
    "duration": 22.926
  },
  {
    "id": 26,
    "text": "这一从 “隐士避世写意” 向 “稼穑纪实民生” 的深化，使古代田园诗获得了更加深厚的现实社会厚度与认识价值。",
    "start": 238.855,
    "end": 248.139,
    "duration": 9.284
  },
  {
    "id": 27,
    "text": "1. 本题的文学史比较坐标为何？",
    "start": 248.139,
    "end": 251.056,
    "duration": 2.917
  },
  {
    "id": 28,
    "text": "破题必须确立陶渊明为源头，孟浩然（盛唐写意隐逸）与范成大（南宋写实农事）为两大高峰，展示唐宋文风转变规律。",
    "start": 251.055,
    "end": 262.422,
    "duration": 11.367
  },
  {
    "id": 29,
    "text": "2. 两者的核心“同”在哪里？",
    "start": 262.422,
    "end": 265.326,
    "duration": 2.904
  },
  {
    "id": 30,
    "text": "同宗陶渊明，热爱田园自然风土，以乡村宁静对抗世俗名利羁绊。",
    "start": 265.326,
    "end": 271.576,
    "duration": 6.25
  },
  {
    "id": 31,
    "text": "3. 两者的本质“异”在哪里？",
    "start": 271.576,
    "end": 274.258,
    "duration": 2.682
  },
  {
    "id": 32,
    "text": "视角与题材，孟浩然是客居隐士，看景看人情，不写苦难；范成大是参与者与地方官，写农耕，写节令，写剥削赋税；",
    "start": 274.444,
    "end": 285.878,
    "duration": 11.434
  },
  {
    "id": 33,
    "text": "美学追求，孟诗重神韵冲淡，范诗重纪实细密。",
    "start": 285.828,
    "end": 290.802,
    "duration": 4.974
  },
  {
    "id": 34,
    "text": "4. 如何将个体比较上升到唐宋诗歌演进机制？",
    "start": 290.802,
    "end": 295.463,
    "duration": 4.661
  },
  {
    "id": 35,
    "text": "唐诗主“情韵意象”，宋诗主“筋骨事理”，范成大《四时田园杂兴》是集大成者，将田园诗推向全景式农耕图景。",
    "start": 295.464,
    "end": 305.659,
    "duration": 10.195
  },
  {
    "id": 36,
    "text": "因，盛唐国力充沛，孟浩然身为隐士悠游山水；",
    "start": 305.659,
    "end": 310.477,
    "duration": 4.818
  },
  {
    "id": 37,
    "text": "果，诗中田园不染尘俗，重在抒发自我超脱的闲适心境。",
    "start": 310.477,
    "end": 316.128,
    "duration": 5.651
  },
  {
    "id": 38,
    "text": "因，南宋偏安一隅，农战关乎社稷，范成大晚年亲历石湖农事；",
    "start": 316.128,
    "end": 322.651,
    "duration": 6.523
  },
  {
    "id": 39,
    "text": "果，以工笔详写“昼出耘田夜绩麻”之稼穑，并揭露官赋剥削之残酷。",
    "start": 322.651,
    "end": 329.292,
    "duration": 6.641
  },
  {
    "id": 40,
    "text": "因，诗歌艺术从重意境向重纪实演进；",
    "start": 329.292,
    "end": 333.407,
    "duration": 4.115
  },
  {
    "id": 41,
    "text": "果，田园诗由“独善其身的精神庇护所”走向“全景展现农村现实的社会画卷”。",
    "start": 333.407,
    "end": 340.113,
    "duration": 6.706
  }
]