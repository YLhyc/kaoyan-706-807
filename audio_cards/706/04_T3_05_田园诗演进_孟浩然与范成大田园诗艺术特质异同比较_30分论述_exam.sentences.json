[
  {
    "id": 1,
    "text": "试比较孟浩然与范成大田园诗艺术特质之异同，",
    "start": 0.101,
    "end": 4.151,
    "duration": 4.05
  },
  {
    "id": 2,
    "text": "并论析古代田园诗之演进。",
    "start": 4.314,
    "end": 6.467,
    "duration": 2.153
  },
  {
    "id": 3,
    "text": "中国古代田园诗自东晋陶渊明开创以来，历经唐宋嬗变，",
    "start": 6.76,
    "end": 11.585,
    "duration": 4.825
  },
  {
    "id": 4,
    "text": "形成风貌各异的艺术脉络。",
    "start": 11.866,
    "end": 13.753,
    "duration": 1.887
  },
  {
    "id": 5,
    "text": "盛唐孟浩然与南宋范成大，",
    "start": 14.101,
    "end": 16.295,
    "duration": 2.194
  },
  {
    "id": 6,
    "text": "分别是盛唐山水田园诗与宋代田园纪实诗的代表大家。",
    "start": 16.452,
    "end": 21.099,
    "duration": 4.647
  },
  {
    "id": 7,
    "text": "二人同承陶渊明遗泽，却因时代境遇、",
    "start": 21.395,
    "end": 24.658,
    "duration": 3.263
  },
  {
    "id": 8,
    "text": "身份立场与诗学观念不同而呈现迥异风貌。",
    "start": 24.98,
    "end": 28.51,
    "duration": 3.53
  },
  {
    "id": 9,
    "text": "比较二人的艺术异同并审视田园诗的演进轨迹，",
    "start": 28.867,
    "end": 32.709,
    "duration": 3.842
  },
  {
    "id": 10,
    "text": "主要体现在以下四个方面：",
    "start": 32.883,
    "end": 34.833,
    "duration": 1.95
  },
  {
    "id": 11,
    "text": "第一，同承陶渊明田园美学血脉，",
    "start": 35.517,
    "end": 38.208,
    "duration": 2.691
  },
  {
    "id": 12,
    "text": "以真挚笔触观照乡村自然与淳朴人情。",
    "start": 38.442,
    "end": 41.915,
    "duration": 3.473
  },
  {
    "id": 13,
    "text": "孟浩然与范成大在创作情怀上，均深受陶渊明归隐田园诗风的熏染。",
    "start": 42.24,
    "end": 47.55,
    "duration": 5.31
  },
  {
    "id": 14,
    "text": "二人都自觉摆脱六朝以来空泛游仙的隐逸套路，",
    "start": 48.13,
    "end": 51.668,
    "duration": 3.538
  },
  {
    "id": 15,
    "text": "将远离尘嚣的乡村风光与自然草木作为寄托心灵之所。",
    "start": 51.862,
    "end": 56.6,
    "duration": 4.738
  },
  {
    "id": 16,
    "text": "无论是孟浩然笔下的田家聚饮之乐，",
    "start": 56.89,
    "end": 59.787,
    "duration": 2.897
  },
  {
    "id": 17,
    "text": "还是范成大笔下的四时物候之美，",
    "start": 60.142,
    "end": 62.949,
    "duration": 2.807
  },
  {
    "id": 18,
    "text": "都真切捕捉了农村岁时节序的变化与乡民淳厚朴实的风习，",
    "start": 63.173,
    "end": 68.71,
    "duration": 5.537
  },
  {
    "id": 19,
    "text": "共同延续了中国古典田园诗亲近自然、",
    "start": 69.158,
    "end": 72.385,
    "duration": 3.227
  },
  {
    "id": 20,
    "text": "向往宁静真淳的抒情传统。",
    "start": 72.624,
    "end": 74.763,
    "duration": 2.139
  },
  {
    "id": 21,
    "text": "第二，孟浩然立足隐士闲适视角，偏重写意宁静与清淡自然的意境。",
    "start": 75.418,
    "end": 81.642,
    "duration": 6.224
  },
  {
    "id": 22,
    "text": "盛唐开元时期的社会氛围与孟浩然长期隐居鹿门山一带的人生际遇，",
    "start": 81.898,
    "end": 87.181,
    "duration": 5.283
  },
  {
    "id": 23,
    "text": "使他常将田园视作抒写清高心境的审美空间。",
    "start": 87.454,
    "end": 90.833,
    "duration": 3.379
  },
  {
    "id": 24,
    "text": "在代表作《过故人庄》中，“故人具鸡黍，邀我至田家。",
    "start": 91.101,
    "end": 95.306,
    "duration": 4.205
  },
  {
    "id": 25,
    "text": "绿树村边合，青山郭外斜。",
    "start": 95.583,
    "end": 98.197,
    "duration": 2.614
  },
  {
    "id": 26,
    "text": "开轩面场圃，把酒话桑麻”，全诗即景而咏、不假雕琢，",
    "start": 98.694,
    "end": 103.959,
    "duration": 5.265
  },
  {
    "id": 27,
    "text": "虽及“桑麻”却全无耕作劳苦之态，",
    "start": 104.435,
    "end": 107.189,
    "duration": 2.754
  },
  {
    "id": 28,
    "text": "着力表现绿树青山环抱的恬静氛围与宾主把酒言欢的淳朴人情。",
    "start": 107.69,
    "end": 113.239,
    "duration": 5.549
  },
  {
    "id": 29,
    "text": "其诗语自然纯净，平淡清远而神韵自出，",
    "start": 113.93,
    "end": 117.681,
    "duration": 3.751
  },
  {
    "id": 30,
    "text": "展现了盛唐诗情思净化、情景浑融的高华格调。",
    "start": 117.985,
    "end": 122.672,
    "duration": 4.687
  },
  {
    "id": 31,
    "text": "第三，范成大立足地方官与观察者视角，偏重写实农事与民生疾苦。",
    "start": 123.309,
    "end": 129.094,
    "duration": 5.785
  },
  {
    "id": 32,
    "text": "南宋偏安积弱、苛捐杂税繁重的现实，",
    "start": 129.496,
    "end": 132.399,
    "duration": 2.903
  },
  {
    "id": 33,
    "text": "促使曾长年担任地方官的范成大以冷静写实的目光审视农村。",
    "start": 132.693,
    "end": 137.542,
    "duration": 4.849
  },
  {
    "id": 34,
    "text": "其晚年退隐石湖所作六十首《四时田园杂兴》，",
    "start": 137.967,
    "end": 141.67,
    "duration": 3.703
  },
  {
    "id": 35,
    "text": "把唐代田园风景诗与“农家词”讽谕传统合二为一，",
    "start": 141.866,
    "end": 145.808,
    "duration": 3.942
  },
  {
    "id": 36,
    "text": "使农民真正成为田园诗的主人公。",
    "start": 146.013,
    "end": 148.5,
    "duration": 2.487
  },
  {
    "id": 37,
    "text": "在“昼出耘田夜绩麻，村庄儿女各当家。",
    "start": 149.198,
    "end": 152.651,
    "duration": 3.453
  },
  {
    "id": 38,
    "text": "童孙未解供耕织，也傍桑阴学种瓜”中，",
    "start": 152.981,
    "end": 156.386,
    "duration": 3.405
  },
  {
    "id": 39,
    "text": "细致记录了农村老少劳作的日常图景；而在“采菱辛苦废犁锄，",
    "start": 156.658,
    "end": 161.819,
    "duration": 5.161
  },
  {
    "id": 40,
    "text": "血指流丹鬼质枯。",
    "start": 162.024,
    "end": 163.592,
    "duration": 1.568
  },
  {
    "id": 41,
    "text": "无力买田聊种水，近来湖面亦收租”中，",
    "start": 164.178,
    "end": 167.471,
    "duration": 3.293
  },
  {
    "id": 42,
    "text": "更直面官府与豪强连湖面都要收租的残酷盘剥，",
    "start": 167.789,
    "end": 171.932,
    "duration": 4.143
  },
  {
    "id": 43,
    "text": "展现出深切的民生忧患。",
    "start": 172.256,
    "end": 174.559,
    "duration": 2.303
  },
  {
    "id": 44,
    "text": "第四，由盛唐空灵写意转向宋代工细纪实，鲜明折射唐宋诗风转型。",
    "start": 175.201,
    "end": 181.825,
    "duration": 6.624
  },
  {
    "id": 45,
    "text": "孟浩然与范成大的差异，",
    "start": 182.085,
    "end": 183.861,
    "duration": 1.776
  },
  {
    "id": 46,
    "text": "清晰勾勒出古代田园诗由唐入宋的演变规律。",
    "start": 184.008,
    "end": 187.825,
    "duration": 3.817
  },
  {
    "id": 47,
    "text": "盛唐孟诗重神韵与空灵意境，略去琐碎农务细节，",
    "start": 188.293,
    "end": 192.77,
    "duration": 4.477
  },
  {
    "id": 48,
    "text": "以白描勾勒山水田园的静谧之姿，追求心境与自然的契合；",
    "start": 193.149,
    "end": 197.789,
    "duration": 4.64
  },
  {
    "id": 49,
    "text": "南宋范诗重纪实与细节刻画，将耕织农事、",
    "start": 198.083,
    "end": 202.44,
    "duration": 4.357
  },
  {
    "id": 50,
    "text": "乡规风俗乃至赋税困苦全面纳入诗境，笔触细密、贴近真实。",
    "start": 202.741,
    "end": 208.093,
    "duration": 5.352
  },
  {
    "id": 51,
    "text": "这一从隐士抒情写意到稼穑纪实民生的演进，",
    "start": 208.574,
    "end": 212.019,
    "duration": 3.445
  },
  {
    "id": 52,
    "text": "使古典田园诗获得了更为厚实的社会内容与认识价值。",
    "start": 212.38,
    "end": 216.57,
    "duration": 4.19
  }
]