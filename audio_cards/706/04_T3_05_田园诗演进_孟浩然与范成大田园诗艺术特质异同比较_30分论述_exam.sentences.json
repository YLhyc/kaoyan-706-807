[
  {
    "id": 1,
    "text": "试比较孟浩然与范成大田园诗艺术特质之异同，并论析古代田园诗之演进。",
    "start": 0.101,
    "end": 6.477,
    "duration": 6.376
  },
  {
    "id": 2,
    "text": "中国古代田园诗自东晋陶渊明开创以来，历经唐宋嬗变，形成风貌各异的艺术脉络。",
    "start": 6.977,
    "end": 13.97,
    "duration": 6.993
  },
  {
    "id": 3,
    "text": "盛唐孟浩然与南宋范成大，分别是盛唐山水田园诗与宋代田园纪实诗的代表大家。",
    "start": 14.47,
    "end": 21.478,
    "duration": 7.008
  },
  {
    "id": 4,
    "text": "二人同承陶渊明遗泽，却因时代境遇、身份立场与诗学观念不同而呈现迥异风貌。",
    "start": 21.978,
    "end": 29.09,
    "duration": 7.112
  },
  {
    "id": 5,
    "text": "比较二人的艺术异同并审视田园诗的演进轨迹，主要体现在以下四个方面：",
    "start": 29.59,
    "end": 35.566,
    "duration": 5.976
  },
  {
    "id": 6,
    "text": "第一，同承陶渊明田园美学血脉，以真挚笔触观照乡村自然与淳朴人情。",
    "start": 36.24,
    "end": 42.648,
    "duration": 6.408
  },
  {
    "id": 7,
    "text": "孟浩然与范成大在创作情怀上，均深受陶渊明归隐田园诗风的熏染。",
    "start": 43.148,
    "end": 48.468,
    "duration": 5.32
  },
  {
    "id": 8,
    "text": "二人都自觉摆脱六朝以来空泛游仙的隐逸套路，",
    "start": 49.038,
    "end": 52.586,
    "duration": 3.548
  },
  {
    "id": 9,
    "text": "将远离尘嚣的乡村风光与自然草木作为寄托心灵之所。",
    "start": 52.936,
    "end": 57.617,
    "duration": 4.681
  },
  {
    "id": 10,
    "text": "无论是孟浩然笔下的田家聚饮之乐，还是范成大笔下的四时物候之美，",
    "start": 58.117,
    "end": 64.163,
    "duration": 6.046
  },
  {
    "id": 11,
    "text": "都真切捕捉了农村岁时节序的变化与乡民淳厚朴实的风习，",
    "start": 64.581,
    "end": 69.947,
    "duration": 5.366
  },
  {
    "id": 12,
    "text": "共同延续了中国古典田园诗亲近自然、向往宁静真淳的抒情传统。",
    "start": 70.385,
    "end": 76.0,
    "duration": 5.615
  },
  {
    "id": 13,
    "text": "第二，孟浩然立足隐士闲适视角，偏重写意宁静与清淡自然的意境。",
    "start": 76.645,
    "end": 82.879,
    "duration": 6.234
  },
  {
    "id": 14,
    "text": "盛唐开元时期的社会氛围与孟浩然久居襄阳、曾隐鹿门山一带的人生际遇，",
    "start": 83.379,
    "end": 89.655,
    "duration": 6.276
  },
  {
    "id": 15,
    "text": "使他常将田园视作抒写清高心境的审美空间。",
    "start": 90.1,
    "end": 93.411,
    "duration": 3.311
  },
  {
    "id": 16,
    "text": "在代表作《过故人庄》中，“故人具鸡黍，邀我至田家。绿树村边合，青山郭外斜。开轩面场圃，把酒话桑麻”，",
    "start": 93.911,
    "end": 103.974,
    "duration": 10.063
  },
  {
    "id": 17,
    "text": "全诗即景而咏、不假雕琢，虽及“桑麻”却全无耕作劳苦之态，",
    "start": 104.558,
    "end": 109.878,
    "duration": 5.32
  },
  {
    "id": 18,
    "text": "着力表现绿树青山环抱的恬静氛围与宾主把酒言欢的淳朴人情。",
    "start": 110.369,
    "end": 115.928,
    "duration": 5.559
  },
  {
    "id": 19,
    "text": "其诗语自然纯净，平淡清远而神韵自出，展现了盛唐诗情思净化、情景浑融的高华格调。",
    "start": 116.609,
    "end": 125.361,
    "duration": 8.752
  },
  {
    "id": 20,
    "text": "第三，范成大立足地方官与观察者视角，偏重写实农事与民生疾苦。",
    "start": 125.988,
    "end": 131.77,
    "duration": 5.782
  },
  {
    "id": 21,
    "text": "南宋偏安积弱、苛捐杂税繁重的现实，",
    "start": 132.27,
    "end": 135.183,
    "duration": 2.913
  },
  {
    "id": 22,
    "text": "促使曾长年担任地方官的范成大以冷静写实的目光审视农村。",
    "start": 135.533,
    "end": 140.379,
    "duration": 4.846
  },
  {
    "id": 23,
    "text": "其晚年退隐石湖所作六十首《四时田园杂兴》，",
    "start": 140.879,
    "end": 144.592,
    "duration": 3.713
  },
  {
    "id": 24,
    "text": "把唐代田园风景诗与“农家词”讽谕传统合二为一，使农民真正成为田园诗的主人公。",
    "start": 144.942,
    "end": 151.573,
    "duration": 6.631
  },
  {
    "id": 25,
    "text": "在“昼出耘田夜绩麻，村庄儿女各当家。童孙未解供耕织，也傍桑阴学种瓜”中，",
    "start": 152.274,
    "end": 159.484,
    "duration": 7.21
  },
  {
    "id": 26,
    "text": "细致记录了农村老少劳作的日常图景；",
    "start": 159.834,
    "end": 162.685,
    "duration": 2.851
  },
  {
    "id": 27,
    "text": "而在“采菱辛苦废犁锄，血指流丹鬼质枯。无力买田聊种水，近来湖面亦收租”中，",
    "start": 163.185,
    "end": 170.865,
    "duration": 7.68
  },
  {
    "id": 28,
    "text": "更直面官府与豪强连湖面都要收租的残酷盘剥，展现出深切的民生忧患。",
    "start": 171.215,
    "end": 177.995,
    "duration": 6.78
  },
  {
    "id": 29,
    "text": "第四，由盛唐空灵写意转向宋代工细纪实，鲜明折射唐宋诗风转型。",
    "start": 178.627,
    "end": 185.261,
    "duration": 6.634
  },
  {
    "id": 30,
    "text": "孟浩然与范成大的差异，清晰勾勒出古代田园诗由唐入宋的演变规律。",
    "start": 185.761,
    "end": 191.512,
    "duration": 5.751
  },
  {
    "id": 31,
    "text": "盛唐孟诗重神韵与空灵意境，略去琐碎农务细节，",
    "start": 192.012,
    "end": 196.499,
    "duration": 4.487
  },
  {
    "id": 32,
    "text": "以白描勾勒山水田园的静谧之姿，追求心境与自然的契合；",
    "start": 196.868,
    "end": 201.497,
    "duration": 4.629
  },
  {
    "id": 33,
    "text": "南宋范诗重纪实与细节刻画，将耕织农事、乡规风俗乃至赋税困苦全面纳入诗境，笔触细密、贴近真实。",
    "start": 201.997,
    "end": 212.017,
    "duration": 10.02
  },
  {
    "id": 34,
    "text": "这一从隐士抒情写意到稼穑纪实民生的演进，",
    "start": 212.517,
    "end": 215.971,
    "duration": 3.454
  },
  {
    "id": 35,
    "text": "使古典田园诗获得了更为厚实的社会内容与认识价值。",
    "start": 216.323,
    "end": 220.513,
    "duration": 4.19
  },
  {
    "id": 36,
    "text": "综上所述，孟浩然与范成大同承陶渊明田园诗脉，",
    "start": 221.033,
    "end": 225.067,
    "duration": 4.034
  },
  {
    "id": 37,
    "text": "却因盛唐与南宋的时代语境及隐士与官僚的身份立场差异，",
    "start": 225.505,
    "end": 230.318,
    "duration": 4.813
  },
  {
    "id": 38,
    "text": "呈现出清淡写意与工细纪实两种迥异风貌。",
    "start": 230.668,
    "end": 234.511,
    "duration": 3.843
  },
  {
    "id": 39,
    "text": "这一从盛唐空灵闲适向宋代农事民生写实的演变轨迹，",
    "start": 235.144,
    "end": 239.924,
    "duration": 4.78
  },
  {
    "id": 40,
    "text": "不仅拓宽了古典田园诗的社会认识价值，也鲜明折射出唐宋诗歌由抒情兴象向贴近日常写实转型的历史规律。",
    "start": 240.274,
    "end": 249.501,
    "duration": 9.227
  }
]
