[
  {
    "id": 1,
    "text": "试比较孟浩然与范成大田园诗艺术特质之异同，并论析古代田园诗之演进。",
    "start": 0.28,
    "end": 6.6,
    "duration": 6.32
  },
  {
    "id": 2,
    "text": "中国古代田园诗自东晋陶渊明开创以来，历经唐宋嬗变，形成风貌各异的艺术脉络。",
    "start": 7.12,
    "end": 14.4,
    "duration": 7.28
  },
  {
    "id": 3,
    "text": "盛唐孟浩然与南宋范成大，分别是盛唐山水田园诗与宋代田园纪实诗的代表大家。",
    "start": 14.92,
    "end": 22.6,
    "duration": 7.68
  },
  {
    "id": 4,
    "text": "二人同承陶渊明遗泽，却因时代境遇、身份立场与诗学观念不同而呈现迥异风貌。",
    "start": 23.12,
    "end": 29.92,
    "duration": 6.8
  },
  {
    "id": 5,
    "text": "比较二人的艺术异同并审视田园诗的演进轨迹，主要体现在以下四个方面：",
    "start": 30.44,
    "end": 36.28,
    "duration": 5.84
  },
  {
    "id": 6,
    "text": "第一，同承陶渊明田园美学血脉，以真挚笔触观照乡村自然与淳朴人情。",
    "start": 36.65,
    "end": 43.05,
    "duration": 6.4
  },
  {
    "id": 7,
    "text": "孟浩然与范成大在创作情怀上，均深受陶渊明归隐田园诗风的熏染。",
    "start": 43.57,
    "end": 49.57,
    "duration": 6.0
  },
  {
    "id": 8,
    "text": "二人都自觉摆脱六朝以来空泛游仙的隐逸套路，",
    "start": 50.09,
    "end": 53.93,
    "duration": 3.84
  },
  {
    "id": 9,
    "text": "将远离尘嚣的乡村风光与自然草木作为寄托心灵之所。",
    "start": 54.33,
    "end": 59.13,
    "duration": 4.8
  },
  {
    "id": 10,
    "text": "无论是孟浩然笔下的田家聚饮之乐，还是范成大笔下的四时物候之美，",
    "start": 59.65,
    "end": 65.3,
    "duration": 5.65
  },
  {
    "id": 11,
    "text": "都真切捕捉了农村岁时节序的变化与乡民淳厚朴实的风习，",
    "start": 65.67,
    "end": 70.55,
    "duration": 4.88
  },
  {
    "id": 12,
    "text": "共同延续了中国古典田园诗亲近自然、向往宁静真淳的抒情传统。",
    "start": 70.92,
    "end": 76.36,
    "duration": 5.44
  },
  {
    "id": 13,
    "text": "第二，孟浩然立足隐士闲适视角，偏重写意宁静与清淡自然的意境。",
    "start": 76.88,
    "end": 83.094,
    "duration": 6.214
  },
  {
    "id": 14,
    "text": "盛唐开元时期的社会氛围与孟浩然久居襄阳、曾隐鹿门山一带的人生际遇，",
    "start": 83.594,
    "end": 89.72,
    "duration": 6.126
  },
  {
    "id": 15,
    "text": "使他常将田园视作抒写清高心境的审美空间。",
    "start": 90.134,
    "end": 93.93,
    "duration": 3.796
  },
  {
    "id": 16,
    "text": "在代表作《过故人庄》中，“故人具鸡黍，邀我至田家。绿树村边合，青山郭外斜。开轩面场圃，把酒话桑麻”，",
    "start": 94.45,
    "end": 105.11,
    "duration": 10.66
  },
  {
    "id": 17,
    "text": "全诗即景而咏、不假雕琢，虽及“桑麻”却全无耕作劳苦之态，",
    "start": 105.51,
    "end": 110.95,
    "duration": 5.44
  },
  {
    "id": 18,
    "text": "着力表现绿树青山环抱的恬静氛围与宾主把酒言欢的淳朴人情。",
    "start": 111.32,
    "end": 117.16,
    "duration": 5.84
  },
  {
    "id": 19,
    "text": "其诗语自然纯净，平淡清远而神韵自出，展现了盛唐诗情思净化、情景浑融的高华格调。",
    "start": 117.722,
    "end": 126.24,
    "duration": 8.518
  },
  {
    "id": 20,
    "text": "第三，范成大立足地方官与观察者视角，偏重写实农事与民生疾苦。",
    "start": 126.76,
    "end": 132.2,
    "duration": 5.44
  },
  {
    "id": 21,
    "text": "南宋偏安积弱、苛捐杂税繁重的现实，促使曾长年担任地方官的范成大以冷静写实的目光审视农村。",
    "start": 132.72,
    "end": 141.44,
    "duration": 8.72
  },
  {
    "id": 22,
    "text": "其晚年退隐石湖所作六十首《四时田园杂兴》，",
    "start": 141.96,
    "end": 145.56,
    "duration": 3.6
  },
  {
    "id": 23,
    "text": "把唐代田园风景诗与“农家词”讽谕传统合二为一，使农民真正成为田园诗的主人公。",
    "start": 145.93,
    "end": 153.13,
    "duration": 7.2
  },
  {
    "id": 24,
    "text": "在“昼出耘田夜绩麻，村庄儿女各当家。童孙未解供耕织，也傍桑阴学种瓜”中，",
    "start": 153.65,
    "end": 161.38,
    "duration": 7.73
  },
  {
    "id": 25,
    "text": "细致记录了农村老少劳作的日常图景；",
    "start": 161.75,
    "end": 164.71,
    "duration": 2.96
  },
  {
    "id": 26,
    "text": "而在“采菱辛苦废犁锄，血指流丹鬼质枯。无力买田聊种水，近来湖面亦收租”中，",
    "start": 165.23,
    "end": 173.12,
    "duration": 7.89
  },
  {
    "id": 27,
    "text": "更直面官府与豪强连湖面都要收租的残酷盘剥，展现出深切的民生忧患。",
    "start": 173.49,
    "end": 180.05,
    "duration": 6.56
  },
  {
    "id": 28,
    "text": "第四，由盛唐空灵写意转向宋代工细纪实，鲜明折射唐宋诗风转型。",
    "start": 180.57,
    "end": 186.89,
    "duration": 6.32
  },
  {
    "id": 29,
    "text": "孟浩然与范成大的差异，清晰勾勒出古代田园诗由唐入宋的演变规律。",
    "start": 187.41,
    "end": 193.01,
    "duration": 5.6
  },
  {
    "id": 30,
    "text": "盛唐孟诗重神韵与空灵意境，略去琐碎农务细节，",
    "start": 193.53,
    "end": 197.85,
    "duration": 4.32
  },
  {
    "id": 31,
    "text": "以白描勾勒山水田园的静谧之姿，追求心境与自然的契合；",
    "start": 198.22,
    "end": 203.02,
    "duration": 4.8
  },
  {
    "id": 32,
    "text": "南宋范诗重纪实与细节刻画，将耕织农事、乡规风俗乃至赋税困苦全面纳入诗境，笔触细密、贴近真实。",
    "start": 203.54,
    "end": 212.18,
    "duration": 8.64
  },
  {
    "id": 33,
    "text": "这一从隐士抒情写意到稼穑纪实民生的演进，",
    "start": 212.7,
    "end": 216.3,
    "duration": 3.6
  },
  {
    "id": 34,
    "text": "使古典田园诗获得了更为厚实的社会内容与认识价值。",
    "start": 216.67,
    "end": 220.91,
    "duration": 4.24
  },
  {
    "id": 35,
    "text": "综上所述，孟浩然与范成大同承陶渊明田园诗脉，",
    "start": 221.43,
    "end": 225.67,
    "duration": 4.24
  },
  {
    "id": 36,
    "text": "却因盛唐与南宋的时代语境及隐士与官僚的身份立场差异，",
    "start": 226.04,
    "end": 231.0,
    "duration": 4.96
  },
  {
    "id": 37,
    "text": "呈现出清淡写意与工细纪实两种迥异风貌。",
    "start": 231.37,
    "end": 235.45,
    "duration": 4.08
  },
  {
    "id": 38,
    "text": "这一从盛唐空灵闲适向宋代农事民生写实的演变轨迹，",
    "start": 235.97,
    "end": 240.37,
    "duration": 4.4
  },
  {
    "id": 39,
    "text": "不仅拓宽了古典田园诗的社会认识价值，也鲜明折射出唐宋诗歌由抒情兴象向贴近日常写实转型的历史规律。",
    "start": 240.77,
    "end": 250.05,
    "duration": 9.28
  }
]
