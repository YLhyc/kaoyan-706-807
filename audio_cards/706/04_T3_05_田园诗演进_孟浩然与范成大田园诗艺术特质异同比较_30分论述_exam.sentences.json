[
  {
    "id": 1,
    "text": "试比较孟浩然与范成大田园诗艺术特质之异同，",
    "start": 0.0,
    "end": 4.465,
    "duration": 4.465
  },
  {
    "id": 2,
    "text": "并论析古代田园诗之演进。",
    "start": 4.465,
    "end": 6.715,
    "duration": 2.25
  },
  {
    "id": 3,
    "text": "中国古典田园诗自东晋陶渊明开创以来，",
    "start": 6.715,
    "end": 10.435,
    "duration": 3.72
  },
  {
    "id": 4,
    "text": "历经盛唐繁荣与两宋嬗变，",
    "start": 10.435,
    "end": 12.716,
    "duration": 2.281
  },
  {
    "id": 5,
    "text": "形成了源远流长而风貌各异的审美传统。",
    "start": 12.716,
    "end": 16.121,
    "duration": 3.405
  },
  {
    "id": 6,
    "text": "盛唐孟浩然与南宋范成大，",
    "start": 16.121,
    "end": 18.541,
    "duration": 2.42
  },
  {
    "id": 7,
    "text": "分别代表了盛唐山水田园诗与宋代田园纪实诗的最高艺术成就。",
    "start": 18.541,
    "end": 23.739,
    "duration": 5.198
  },
  {
    "id": 8,
    "text": "两人同承陶渊明审美遗泽，却因时代语境、",
    "start": 23.739,
    "end": 27.369,
    "duration": 3.63
  },
  {
    "id": 9,
    "text": "阶层身份与诗学理念的差异，展现出截然不同的艺术风貌。",
    "start": 27.369,
    "end": 32.481,
    "duration": 5.112
  },
  {
    "id": 10,
    "text": "比较两人的田园诗艺术特质异同并审视其流变轨迹，",
    "start": 32.481,
    "end": 36.9,
    "duration": 4.419
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：",
    "start": 36.9,
    "end": 39.548,
    "duration": 2.648
  },
  {
    "id": 12,
    "text": "第一，同具对田园自然之审美观照，",
    "start": 39.548,
    "end": 42.869,
    "duration": 3.321
  },
  {
    "id": 13,
    "text": "承续陶渊明开创之田园诗歌美学血脉。",
    "start": 42.869,
    "end": 45.982,
    "duration": 3.113
  },
  {
    "id": 14,
    "text": "孟浩然与范成大在精神品格上，",
    "start": 45.982,
    "end": 48.618,
    "duration": 2.636
  },
  {
    "id": 15,
    "text": "均深受陶渊明归隐田园情怀的深刻熏染。",
    "start": 48.618,
    "end": 52.059,
    "duration": 3.441
  },
  {
    "id": 16,
    "text": "二人皆以真挚清新的笔触，",
    "start": 52.059,
    "end": 54.16,
    "duration": 2.101
  },
  {
    "id": 17,
    "text": "将远离官场喧嚣的乡村风光与淳朴乡野作为心灵寄托之所。",
    "start": 54.16,
    "end": 59.158,
    "duration": 4.998
  },
  {
    "id": 18,
    "text": "无论孟浩然笔下的农家待客之乐，",
    "start": 59.158,
    "end": 61.637,
    "duration": 2.479
  },
  {
    "id": 19,
    "text": "还是范成大笔下的田间节令之美，",
    "start": 61.637,
    "end": 64.233,
    "duration": 2.596
  },
  {
    "id": 20,
    "text": "都摆脱了汉魏古诗中空泛的游仙隐逸陈套，",
    "start": 64.233,
    "end": 67.984,
    "duration": 3.751
  },
  {
    "id": 21,
    "text": "表现出对大自然草木岁时变化的敏锐体察与对农村淳朴风习的深厚眷恋，",
    "start": 67.984,
    "end": 73.939,
    "duration": 5.955
  },
  {
    "id": 22,
    "text": "共同维系了中国古代田园诗返璞归真、宁静平和的抒情主旨。",
    "start": 73.939,
    "end": 79.856,
    "duration": 5.917
  },
  {
    "id": 23,
    "text": "第二，孟浩然以隐逸士人视角观照田园，",
    "start": 79.856,
    "end": 84.574,
    "duration": 4.718
  },
  {
    "id": 24,
    "text": "偏重写意宁静与人情淳厚之闲适意境。",
    "start": 84.574,
    "end": 89.087,
    "duration": 4.513
  },
  {
    "id": 25,
    "text": "盛唐开元盛世的时代氛围与孟浩然长年隐居襄阳鹿门山的身世际遇，",
    "start": 89.087,
    "end": 98.03,
    "duration": 8.943
  },
  {
    "id": 26,
    "text": "决定了他诗中田园的纯粹性与审美化特征。",
    "start": 98.03,
    "end": 104.148,
    "duration": 6.118
  },
  {
    "id": 27,
    "text": "孟浩然视田园为忘却名利沉浮的世外桃源，",
    "start": 104.148,
    "end": 107.785,
    "duration": 3.637
  },
  {
    "id": 28,
    "text": "其创作立足于悠游林下的隐士视角。",
    "start": 107.785,
    "end": 111.821,
    "duration": 4.036
  },
  {
    "id": 29,
    "text": "在代表作 《过故人庄》 中，以 “故人具鸡黍，邀我至田家。",
    "start": 111.821,
    "end": 115.417,
    "duration": 3.596
  },
  {
    "id": 30,
    "text": "绿树村边合，青山郭外斜。",
    "start": 115.417,
    "end": 117.049,
    "duration": 1.632
  },
  {
    "id": 31,
    "text": "开轩面场圃，把酒话桑麻” 开篇入画，",
    "start": 117.049,
    "end": 121.052,
    "duration": 4.003
  },
  {
    "id": 32,
    "text": "诗中虽提及 “桑麻”，却毫无农夫耕作之艰辛疲顿，",
    "start": 121.052,
    "end": 126.378,
    "duration": 5.326
  },
  {
    "id": 33,
    "text": "着力表现的是绿树青山环抱下的恬淡幽静与宾主把酒言欢的淳朴人情。",
    "start": 126.378,
    "end": 133.658,
    "duration": 7.28
  },
  {
    "id": 34,
    "text": "其诗风平淡幽远、神韵超然，体现了盛唐诗歌意象空灵、",
    "start": 133.658,
    "end": 139.74,
    "duration": 6.082
  },
  {
    "id": 35,
    "text": "情景交融的高超境界。",
    "start": 139.74,
    "end": 141.88,
    "duration": 2.14
  },
  {
    "id": 36,
    "text": "第三，范成大以地方官吏与生活参与者视角深入田舍，",
    "start": 141.88,
    "end": 148.056,
    "duration": 6.176
  },
  {
    "id": 37,
    "text": "偏重写实农事与民生疾苦之社会关怀。",
    "start": 148.056,
    "end": 151.917,
    "duration": 3.861
  },
  {
    "id": 38,
    "text": "南宋中后期民族危机未靖、阶级矛盾尖锐的社会现实，",
    "start": 151.917,
    "end": 156.23,
    "duration": 4.313
  },
  {
    "id": 39,
    "text": "促使范成大以更加严肃冷峻的现实主义眼光审视农村。",
    "start": 156.23,
    "end": 161.299,
    "duration": 5.069
  },
  {
    "id": 40,
    "text": "晚年退居石湖后所作的 《四时田园杂兴》 六十首，",
    "start": 161.299,
    "end": 167.172,
    "duration": 5.873
  },
  {
    "id": 41,
    "text": "被誉为 “田园诗集大成之作”。",
    "start": 167.172,
    "end": 169.831,
    "duration": 2.659
  },
  {
    "id": 42,
    "text": "范成大不仅描写农村四时物候与自然风光，",
    "start": 169.831,
    "end": 173.608,
    "duration": 3.777
  },
  {
    "id": 43,
    "text": "更以参与者和细致观察者的视角全方位记录农耕劳作。",
    "start": 173.608,
    "end": 177.303,
    "duration": 3.695
  },
  {
    "id": 44,
    "text": "在 《四时田园杂兴·夏日》 中写道：“昼出耘田夜绩麻，",
    "start": 177.303,
    "end": 184.067,
    "duration": 6.764
  },
  {
    "id": 45,
    "text": "村庄儿女各当家。",
    "start": 184.067,
    "end": 186.569,
    "duration": 2.502
  },
  {
    "id": 46,
    "text": "童孙未解供耕织，也傍桑阴学种瓜。",
    "start": 186.569,
    "end": 191.843,
    "duration": 5.274
  },
  {
    "id": 47,
    "text": "” 诗作展现了男女老少全力稼穑的真实图景；更为深刻的是，",
    "start": 191.843,
    "end": 197.688,
    "duration": 5.845
  },
  {
    "id": 48,
    "text": "范诗直面残酷剥削，写出了 “租船又报到关西”、",
    "start": 197.688,
    "end": 204.325,
    "duration": 6.637
  },
  {
    "id": 49,
    "text": "“采菱辛苦废南亩” 等官府苛捐杂税逼迫下的农家生存困境，",
    "start": 204.325,
    "end": 208.791,
    "duration": 4.466
  },
  {
    "id": 50,
    "text": "展现出深切关怀民生疾苦的忧患意识。",
    "start": 208.791,
    "end": 211.281,
    "duration": 2.49
  },
  {
    "id": 51,
    "text": "第四，从盛唐空灵神韵向宋代工细纪实的演进，",
    "start": 211.281,
    "end": 214.033,
    "duration": 2.752
  },
  {
    "id": 52,
    "text": "全面体现了唐宋诗歌美学转型之历史法则。",
    "start": 214.033,
    "end": 218.967,
    "duration": 4.934
  },
  {
    "id": 53,
    "text": "孟浩然与范成大的艺术差异，",
    "start": 218.967,
    "end": 221.123,
    "duration": 2.156
  },
  {
    "id": 54,
    "text": "深刻折射了古典田园诗由唐入宋的文体演变规律。",
    "start": 221.123,
    "end": 223.483,
    "duration": 2.36
  },
  {
    "id": 55,
    "text": "盛唐孟诗重 “神韵” 与 “意境”，",
    "start": 223.483,
    "end": 226.464,
    "duration": 2.981
  },
  {
    "id": 56,
    "text": "善于舍弃具体琐碎的生活细节，以白描勾勒山川神貌，",
    "start": 226.464,
    "end": 228.597,
    "duration": 2.133
  },
  {
    "id": 57,
    "text": "追寻心灵与自然的契合，具有浑融冲淡的美学品格；",
    "start": 228.597,
    "end": 232.537,
    "duration": 3.94
  },
  {
    "id": 58,
    "text": "南宋范诗则重 “纪实” 与 “事理”，",
    "start": 232.537,
    "end": 234.789,
    "duration": 2.252
  },
  {
    "id": 59,
    "text": "将丰富的农业生产知识、民俗乡规、",
    "start": 234.789,
    "end": 237.024,
    "duration": 2.235
  },
  {
    "id": 60,
    "text": "甚至俚俗语言全面引入诗中，笔触精细如画工写真。",
    "start": 237.024,
    "end": 239.331,
    "duration": 2.307
  },
  {
    "id": 61,
    "text": "这一从 “隐士避世写意” 向 “稼穑纪实民生” 的深化，",
    "start": 239.331,
    "end": 240.673,
    "duration": 1.342
  },
  {
    "id": 62,
    "text": "使古代田园诗获得了更加深厚的现实社会厚度与认识价值。",
    "start": 240.673,
    "end": 244.239,
    "duration": 3.566
  }
]