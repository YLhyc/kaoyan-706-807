[
  {
    "id": 1,
    "text": "试论杜甫诗歌“沉郁顿挫”的艺术风格与“诗史”性质。",
    "start": 0.134,
    "end": 4.146,
    "duration": 4.012
  },
  {
    "id": 2,
    "text": "杜甫是中国古典诗歌现实主义传统的集大成者。",
    "start": 4.823,
    "end": 8.315,
    "duration": 3.492
  },
  {
    "id": 3,
    "text": "面对安史之乱爆发、唐王朝由盛转衰的历史剧变，杜甫秉持仁民爱物之心，",
    "start": 9.073,
    "end": 15.125,
    "duration": 6.052
  },
  {
    "id": 4,
    "text": "将个人身世之悲与国家兴亡之痛融为一体，以沉郁顿挫的美学风范与即事名篇的写实笔法，",
    "start": 15.504,
    "end": 23.082,
    "duration": 7.578
  },
  {
    "id": 5,
    "text": "真实记录了动乱年代的民生疾苦与时代心声，确立了其万代宗仰的“诗圣”地位。",
    "start": 23.461,
    "end": 29.393,
    "duration": 5.932
  },
  {
    "id": 6,
    "text": "其艺术造诣与诗史品格，主要体现在以下四个方面：",
    "start": 30.085,
    "end": 40.177,
    "duration": 10.092
  },
  {
    "id": 7,
    "text": "第一，标举“沉郁顿挫”风格特质，展现悲慨深厚的情感与起伏低回的章法。",
    "start": 40.855,
    "end": 43.667,
    "duration": 2.812
  },
  {
    "id": 8,
    "text": "“沉郁顿挫”是杜诗最核心的风格标识。",
    "start": 44.385,
    "end": 48.917,
    "duration": 4.532
  },
  {
    "id": 9,
    "text": "“沉郁”侧重思想感情的悲慨深厚，源于关怀苍生的仁者之心；",
    "start": 49.595,
    "end": 51.847,
    "duration": 2.252
  },
  {
    "id": 10,
    "text": "“顿挫”既指声调的抑扬变化，也指情感表达的波浪起伏与反复低回，",
    "start": 52.376,
    "end": 55.388,
    "duration": 3.012
  },
  {
    "id": 11,
    "text": "源于儒家中和处世心态对悲愤喷薄的节制。",
    "start": 55.767,
    "end": 59.139,
    "duration": 3.372
  },
  {
    "id": 12,
    "text": "安史动乱与抱负落空，使杜甫胸中积蓄深沉忧思，发为百折千回的诗情。",
    "start": 59.777,
    "end": 65.709,
    "duration": 5.932
  },
  {
    "id": 13,
    "text": "在《自京赴奉先县咏怀五百字》中，全诗情感四起四落：",
    "start": 66.467,
    "end": 74.159,
    "duration": 7.692
  },
  {
    "id": 14,
    "text": "先写抱负落空的郁勃，随即转向骊山行乐；",
    "start": 74.837,
    "end": 76.129,
    "duration": 1.292
  },
  {
    "id": 15,
    "text": "揭露“朱门酒肉臭，路有冻死骨”后，愤懑化为“荣枯咫尺异”的深沉叹息；",
    "start": 76.658,
    "end": 77.67,
    "duration": 1.012
  },
  {
    "id": 16,
    "text": "归家惊闻幼子饿卒，悲痛欲绝之际又转而忧念失业流民与远戍士卒，",
    "start": 78.199,
    "end": 79.811,
    "duration": 1.612
  },
  {
    "id": 17,
    "text": "意深法曲，将忧国伤时之情写得余韵无穷。",
    "start": 80.19,
    "end": 81.202,
    "duration": 1.012
  },
  {
    "id": 18,
    "text": "第二，确立“诗史”叙事传统，展现正视历史、关怀苍生的人道情怀。",
    "start": 82.0,
    "end": 91.612,
    "duration": 9.612
  },
  {
    "id": 19,
    "text": "所谓“诗史”，不仅在于据实记录安史之乱前后的时代风貌，更在于以仁者情怀写出战争浩劫中下层百姓的辛酸境遇。",
    "start": 92.33,
    "end": 97.422,
    "duration": 5.092
  },
  {
    "id": 20,
    "text": "杜甫打破盛唐诗偏重玲珑兴象的格局，以五、七言古体即事名篇，",
    "start": 98.1,
    "end": 102.672,
    "duration": 4.572
  },
  {
    "id": 21,
    "text": "着力于生活细节的真实刻画，使叙事诗具有浓郁的生活质感。",
    "start": 103.051,
    "end": 107.823,
    "duration": 4.772
  },
  {
    "id": 22,
    "text": "“三吏三别”直面征兵惨状：在《石壕吏》中，诗人以客观克制的笔法记录差吏夜捉与老妇泣诉，揭露战乱对底层家庭的摧残；",
    "start": 108.461,
    "end": 114.313,
    "duration": 5.852
  },
  {
    "id": 23,
    "text": "在《茅屋为秋风所破歌》中，身处床头屋漏的困窘境遇，",
    "start": 114.842,
    "end": 116.894,
    "duration": 2.052
  },
  {
    "id": 24,
    "text": "仍迸发出“安得广厦千万间，大庇天下寒士俱欢颜”的崇高呼号，",
    "start": 117.273,
    "end": 118.645,
    "duration": 1.372
  },
  {
    "id": 25,
    "text": "使诗史兼有历史实录之真与深厚人道关怀。",
    "start": 119.024,
    "end": 120.156,
    "duration": 1.132
  },
  {
    "id": 26,
    "text": "第三，集古典律诗之大成，拓宽近体表现容量并精研声律通变。",
    "start": 120.834,
    "end": 130.286,
    "duration": 9.452
  },
  {
    "id": 27,
    "text": "杜甫对律诗体裁贡献尤著。",
    "start": 131.004,
    "end": 143.816,
    "duration": 12.812
  },
  {
    "id": 28,
    "text": "他打破早先近体诗偏于应酬咏物的狭隘格局，",
    "start": 144.454,
    "end": 146.666,
    "duration": 2.212
  },
  {
    "id": 29,
    "text": "将重大政治时事与家国悲慨引入近体，并以组诗拓展其表现幅度。",
    "start": 147.045,
    "end": 149.857,
    "duration": 2.812
  },
  {
    "id": 30,
    "text": "七律组诗《秋兴八首》将山城秋色、身世漂泊与故国之思层层推进，情思脉络绵密连贯。",
    "start": 150.535,
    "end": 152.467,
    "duration": 1.932
  },
  {
    "id": 31,
    "text": "在格律技艺上，杜甫追求“晚节渐于诗律细”，既精于字句锤炼，",
    "start": 153.145,
    "end": 156.477,
    "duration": 3.332
  },
  {
    "id": 32,
    "text": "以致刘熙载称其“少陵炼神”，又善用“拗救”与变体以求变化中的完整。",
    "start": 156.856,
    "end": 162.348,
    "duration": 5.492
  },
  {
    "id": 33,
    "text": "名作《登高》八句皆对而流转自如，将万里悲秋与百年多病融为一气，",
    "start": 162.986,
    "end": 166.118,
    "duration": 3.132
  },
  {
    "id": 34,
    "text": "胡应麟《诗薮》赞为“古今七言律第一”，足见其将律诗写得浑融流转、无迹可寻的造诣。",
    "start": 166.497,
    "end": 170.669,
    "duration": 4.172
  },
  {
    "id": 35,
    "text": "第四，承前启后开辟无数法门，奠定后世诗歌演进的宗师典范。",
    "start": 171.387,
    "end": 182.279,
    "duration": 10.892
  },
  {
    "id": 36,
    "text": "杜甫在诗歌史上具有承先启后的枢纽地位。",
    "start": 182.957,
    "end": 194.329,
    "duration": 11.372
  },
  {
    "id": 37,
    "text": "元稹盛赞其“上薄风骚，下该沈、宋，言夺苏、李，气吞曹、刘，掩颜、谢之孤高，杂徐、庾之流丽，尽得古今之体势，而兼人人之所独专矣”，",
    "start": 194.967,
    "end": 199.659,
    "duration": 4.692
  },
  {
    "id": 38,
    "text": "公允概括了其集六朝盛唐诗歌之大成的成就。",
    "start": 200.038,
    "end": 200.49,
    "duration": 0.452
  },
  {
    "id": 39,
    "text": "他对后代诗坛影响深远：中唐元白继承其缘事而发、写生民疾苦的路线，",
    "start": 201.168,
    "end": 202.3,
    "duration": 1.132
  },
  {
    "id": 40,
    "text": "韩孟诗派得力于其奇崛造语与炼字之功，宋代黄庭坚与江西诗派则奉其为宗，",
    "start": 202.679,
    "end": 203.881,
    "duration": 1.202
  },
  {
    "id": 41,
    "text": "取法其句法锤炼与老成境界，使杜甫成为历代诗坛共同推尊的典范。",
    "start": 204.26,
    "end": 205.182,
    "duration": 0.922
  },
  {
    "id": 42,
    "text": "综上所述，杜甫以儒家仁爱之心统摄沉郁顿挫诗风与即事名篇笔法，",
    "start": 205.86,
    "end": 215.752,
    "duration": 9.892
  },
  {
    "id": 43,
    "text": "把个体遭际与唐代盛衰巨变融为一体。",
    "start": 216.265,
    "end": 221.477,
    "duration": 5.212
  },
  {
    "id": 44,
    "text": "他既集六朝盛唐古近体格律之大成，又以直面民生疾苦的写实传统为中唐新乐府运动开先声，",
    "start": 222.17,
    "end": 241.506,
    "duration": 19.336
  },
  {
    "id": 45,
    "text": "并深远影响宋代江西诗派炼字句法，在中国诗歌史上树立起兼顾时代良知与艺术法度的高峰。",
    "start": 242.057,
    "end": 265.715,
    "duration": 23.658
  }
]