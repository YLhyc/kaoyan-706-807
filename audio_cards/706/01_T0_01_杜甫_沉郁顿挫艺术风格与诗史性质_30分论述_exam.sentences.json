[
  {
    "id": 1,
    "text": "试论杜甫诗歌“沉郁顿挫”的艺术风格与“诗史”性质。",
    "start": 0.12,
    "end": 3.6,
    "duration": 3.48
  },
  {
    "id": 2,
    "text": "杜甫是中国古典诗歌现实主义传统的集大成者。",
    "start": 3.6,
    "end": 8.16,
    "duration": 4.56
  },
  {
    "id": 3,
    "text": "面对安史之乱爆发、唐王朝由盛转衰的历史剧变，杜甫秉持仁民爱物之心，",
    "start": 8.16,
    "end": 14.88,
    "duration": 6.72
  },
  {
    "id": 4,
    "text": "将个人身世之悲与国家兴亡之痛融为一体，以沉郁顿挫的美学风范与即事名篇的写实笔法，",
    "start": 14.88,
    "end": 22.4,
    "duration": 7.52
  },
  {
    "id": 5,
    "text": "真实记录了动乱年代的民生疾苦与时代心声，确立了其万代宗仰的“诗圣”地位。",
    "start": 22.4,
    "end": 29.2,
    "duration": 6.8
  },
  {
    "id": 6,
    "text": "其艺术造诣与诗史品格，主要体现在以下四个方面：",
    "start": 29.2,
    "end": 33.603,
    "duration": 4.403
  },
  {
    "id": 7,
    "text": "第一，标举“沉郁顿挫”风格特质，展现悲慨深厚的情感与起伏低回的章法。",
    "start": 33.677,
    "end": 39.735,
    "duration": 6.058
  },
  {
    "id": 8,
    "text": "“沉郁顿挫”是杜诗最核心的风格标识。",
    "start": 39.982,
    "end": 42.378,
    "duration": 2.396
  },
  {
    "id": 9,
    "text": "“沉郁”侧重思想感情的悲慨深厚，源于关怀苍生的仁者之心；",
    "start": 42.378,
    "end": 47.633,
    "duration": 5.255
  },
  {
    "id": 10,
    "text": "“顿挫”既指声调的抑扬变化，也指情感表达的波浪起伏与反复低回，",
    "start": 47.633,
    "end": 53.424,
    "duration": 5.791
  },
  {
    "id": 11,
    "text": "源于儒家中和处世心态对悲愤喷薄的节制。",
    "start": 53.424,
    "end": 57.596,
    "duration": 4.172
  },
  {
    "id": 12,
    "text": "安史动乱与抱负落空，使杜甫胸中积蓄深沉忧思，发为百折千回的诗情。",
    "start": 57.596,
    "end": 64.079,
    "duration": 6.483
  },
  {
    "id": 13,
    "text": "在《自京赴奉先县咏怀五百字》中，全诗情感四起四落：",
    "start": 64.079,
    "end": 69.261,
    "duration": 5.182
  },
  {
    "id": 14,
    "text": "先写抱负落空的郁勃，随即转向骊山行乐；",
    "start": 69.261,
    "end": 73.04,
    "duration": 3.779
  },
  {
    "id": 15,
    "text": "揭露“朱门酒肉臭，路有冻死骨”后，愤懑化为“荣枯咫尺异”的深沉叹息；",
    "start": 73.04,
    "end": 79.84,
    "duration": 6.8
  },
  {
    "id": 16,
    "text": "归家惊闻幼子饿卒，悲痛欲绝之际又转而忧念失业流民与远戍士卒，",
    "start": 79.84,
    "end": 86.4,
    "duration": 6.56
  },
  {
    "id": 17,
    "text": "意深法曲，将忧国伤时之情写得余韵无穷。",
    "start": 86.4,
    "end": 90.88,
    "duration": 4.48
  },
  {
    "id": 18,
    "text": "第二，确立“诗史”叙事传统，展现正视历史、关怀苍生的人道情怀。",
    "start": 90.88,
    "end": 97.68,
    "duration": 6.8
  },
  {
    "id": 19,
    "text": "所谓“诗史”，不仅在于据实记录安史之乱前后的时代风貌，",
    "start": 97.68,
    "end": 102.8,
    "duration": 5.12
  },
  {
    "id": 20,
    "text": "更在于以仁者情怀写出战争浩劫中下层百姓的辛酸境遇。",
    "start": 102.8,
    "end": 108.16,
    "duration": 5.36
  },
  {
    "id": 21,
    "text": "杜甫打破盛唐诗偏重玲珑兴象的格局，以五、七言古体即事名篇，",
    "start": 108.16,
    "end": 113.059,
    "duration": 4.899
  },
  {
    "id": 22,
    "text": "着力于生活细节的真实刻画，使叙事诗具有浓郁的生活质感。",
    "start": 113.059,
    "end": 118.72,
    "duration": 5.661
  },
  {
    "id": 23,
    "text": "“三吏三别”直面征兵惨状：在《石壕吏》中，",
    "start": 118.72,
    "end": 122.0,
    "duration": 3.28
  },
  {
    "id": 24,
    "text": "诗人以客观克制的笔法记录差吏夜捉与老妇泣诉，揭露战乱对底层家庭的摧残；",
    "start": 122.0,
    "end": 129.44,
    "duration": 7.44
  },
  {
    "id": 25,
    "text": "在《茅屋为秋风所破歌》中，身处床头屋漏的困窘境遇，",
    "start": 129.44,
    "end": 134.08,
    "duration": 4.64
  },
  {
    "id": 26,
    "text": "仍迸发出“安得广厦千万间，大庇天下寒士俱欢颜”的崇高呼号，",
    "start": 134.08,
    "end": 140.56,
    "duration": 6.48
  },
  {
    "id": 27,
    "text": "使诗史兼有历史实录之真与深厚人道关怀。",
    "start": 140.56,
    "end": 144.4,
    "duration": 3.84
  },
  {
    "id": 28,
    "text": "第三，集古典律诗之大成，拓宽近体表现容量并精研声律通变。",
    "start": 144.4,
    "end": 150.011,
    "duration": 5.611
  },
  {
    "id": 29,
    "text": "杜甫对律诗体裁贡献尤著。",
    "start": 150.233,
    "end": 152.4,
    "duration": 2.167
  },
  {
    "id": 30,
    "text": "他打破齐梁以来律诗偏于应酬咏物的狭隘格局，",
    "start": 152.4,
    "end": 156.56,
    "duration": 4.16
  },
  {
    "id": 31,
    "text": "将重大政治时事与家国悲慨引入近体，并以组诗拓展其表现幅度。",
    "start": 156.56,
    "end": 163.176,
    "duration": 6.616
  },
  {
    "id": 32,
    "text": "七律组诗《秋兴八首》将山城秋色、身世漂泊与故国之思层层推进，情思脉络绵密连贯。",
    "start": 163.176,
    "end": 172.014,
    "duration": 8.838
  },
  {
    "id": 33,
    "text": "在格律技艺上，杜甫追求“晚节渐于诗律细”，既精于字句锤炼，",
    "start": 172.014,
    "end": 177.176,
    "duration": 5.162
  },
  {
    "id": 34,
    "text": "以致刘熙载称其“少陵炼神”，又善用“拗救”与变体以求变化中的完整。",
    "start": 177.176,
    "end": 183.256,
    "duration": 6.08
  },
  {
    "id": 35,
    "text": "名作《登高》八句皆对而流转自如，将万里悲秋与百年多病融为一气，",
    "start": 183.256,
    "end": 189.728,
    "duration": 6.472
  },
  {
    "id": 36,
    "text": "胡应麟《诗薮》赞为“古今七言律第一”，足见其将律诗写得浑融流转、无迹可寻的造诣。",
    "start": 189.728,
    "end": 197.736,
    "duration": 8.008
  },
  {
    "id": 37,
    "text": "第四，承前启后开辟无数法门，奠定后世诗歌演进的宗师典范。",
    "start": 197.736,
    "end": 203.253,
    "duration": 5.517
  },
  {
    "id": 38,
    "text": "杜甫在诗歌史上具有承先启后的枢纽地位。",
    "start": 203.336,
    "end": 207.336,
    "duration": 4.0
  },
  {
    "id": 39,
    "text": "元稹盛赞其“上薄风骚，下该沈、宋，言夺苏、李，气吞曹、刘，掩颜、谢之孤高，杂徐、庾之流丽，尽得古今之体势，而兼人人之所独专矣”，",
    "start": 207.336,
    "end": 220.162,
    "duration": 12.826
  },
  {
    "id": 40,
    "text": "公允概括了其集六朝盛唐诗歌之大成的成就。",
    "start": 220.225,
    "end": 224.056,
    "duration": 3.831
  },
  {
    "id": 41,
    "text": "他对后代诗坛影响深远：中唐元白继承其缘事而发、写生民疾苦的路线，",
    "start": 224.056,
    "end": 231.0,
    "duration": 6.944
  },
  {
    "id": 42,
    "text": "韩孟诗派得力于其奇崛造语与炼字之功，宋代黄庭坚与江西诗派则奉其为宗，",
    "start": 231.0,
    "end": 237.566,
    "duration": 6.566
  },
  {
    "id": 43,
    "text": "取法其句法锤炼与老成境界，使杜甫成为历代诗坛共同推尊的典范。",
    "start": 237.566,
    "end": 243.118,
    "duration": 5.552
  }
]