[
  {
    "id": "sent_1",
    "text": "杜甫是中国古典诗歌现实主义精神的集大成者。",
    "start": 0.0,
    "end": 3.8,
    "duration": 3.8
  },
  {
    "id": "sent_2",
    "text": "面对安史之乱爆发、唐帝国由盛转衰的历史巨变，",
    "start": 4.329,
    "end": 8.489,
    "duration": 4.16
  },
  {
    "id": "sent_3",
    "text": "杜甫秉持仁民爱物的博大胸襟，",
    "start": 8.939,
    "end": 11.619,
    "duration": 2.68
  },
  {
    "id": "sent_4",
    "text": "将个人身世之悲与国家兴亡之痛融为一体。",
    "start": 12.069,
    "end": 15.589,
    "duration": 3.52
  },
  {
    "id": "sent_5",
    "text": "在创作上，他以沉郁顿挫的美学风范，",
    "start": 16.039,
    "end": 18.999,
    "duration": 2.96
  },
  {
    "id": "sent_6",
    "text": "全面反映时代剧变与民生疾苦；",
    "start": 19.449,
    "end": 22.049,
    "duration": 2.6
  },
  {
    "id": "sent_7",
    "text": "以即事名篇的写实笔法，生动展现一代民众的心灵受难史。",
    "start": 22.499,
    "end": 27.179,
    "duration": 4.68
  },
  {
    "id": "sent_8",
    "text": "杜甫集六朝盛唐诗歌之大成，开中晚唐乃至两宋无数法门，",
    "start": 27.629,
    "end": 32.709,
    "duration": 5.08
  },
  {
    "id": "sent_9",
    "text": "确立了其万代宗仰的 “诗圣” 地位。",
    "start": 33.159,
    "end": 35.719,
    "duration": 2.56
  },
  {
    "id": "sent_10",
    "text": "其艺术造诣与诗史品格，主要展现为以下四个核心维度：",
    "start": 36.169,
    "end": 40.689,
    "duration": 4.52
  },
  {
    "id": "sent_11",
    "text": "第一，标举“沉郁顿挫”风格特质，",
    "start": 41.139,
    "end": 44.019,
    "duration": 2.88
  },
  {
    "id": "sent_12",
    "text": "展现思想感情的深厚沉雄与表现手法的曲折起伏。",
    "start": 44.469,
    "end": 48.389,
    "duration": 3.92
  },
  {
    "id": "sent_13",
    "text": "“沉郁顿挫” 是杜甫诗歌最核心的风格标识。",
    "start": 48.839,
    "end": 52.239,
    "duration": 3.4
  },
  {
    "id": "sent_14",
    "text": "“沉郁” 侧重思想内容的深沉宽广，源于关怀苍生的仁者之心；",
    "start": 52.769,
    "end": 57.689,
    "duration": 4.92
  },
  {
    "id": "sent_15",
    "text": "“顿挫” 侧重章法波澜的回环转折，",
    "start": 58.139,
    "end": 60.779,
    "duration": 2.64
  },
  {
    "id": "sent_16",
    "text": "源于内心情感与儒家中和心态的制约。",
    "start": 61.229,
    "end": 64.389,
    "duration": 3.16
  },
  {
    "id": "sent_17",
    "text": "安史动乱与抱负破灭，使杜甫胸中积蓄深沉忧愤，",
    "start": 64.919,
    "end": 69.039,
    "duration": 4.12
  },
  {
    "id": "sent_18",
    "text": "通过反复低回的语流展现出来。",
    "start": 69.489,
    "end": 71.729,
    "duration": 2.24
  },
  {
    "id": "sent_19",
    "text": "在名作 《自京赴奉先县咏怀五百字》 中，全诗情感四起四落：",
    "start": 72.179,
    "end": 77.139,
    "duration": 4.96
  },
  {
    "id": "sent_20",
    "text": "由抱负落空的郁勃，骤转入骊山行乐的批判；",
    "start": 77.589,
    "end": 81.229,
    "duration": 3.64
  },
  {
    "id": "sent_21",
    "text": "揭露 “朱门酒肉臭，路有冻死骨” 后，愤懑化为深沉叹息；",
    "start": 81.679,
    "end": 86.359,
    "duration": 4.68
  },
  {
    "id": "sent_22",
    "text": "归家惊闻幼子饿卒，",
    "start": 86.809,
    "end": 88.369,
    "duration": 1.56
  },
  {
    "id": "sent_23",
    "text": "悲痛之余笔锋复转入对更悲惨远戍卒的深切关怀。",
    "start": 88.939,
    "end": 93.139,
    "duration": 4.2
  },
  {
    "id": "sent_24",
    "text": "刘熙载 《艺概》 评其意深而法曲，",
    "start": 93.669,
    "end": 96.149,
    "duration": 2.48
  },
  {
    "id": "sent_25",
    "text": "达到了古典抒情艺术的极高境界。",
    "start": 96.599,
    "end": 99.119,
    "duration": 2.52
  },
  {
    "id": "sent_26",
    "text": "第二，确立“诗史”叙事传统，展现感时伤事的深厚人道主义情怀。",
    "start": 99.569,
    "end": 104.409,
    "duration": 4.84
  },
  {
    "id": "sent_27",
    "text": "所谓 “诗史”，其本质不仅在于据实补正史书阙载，",
    "start": 104.939,
    "end": 109.059,
    "duration": 4.12
  },
  {
    "id": "sent_28",
    "text": "更在于以微观平民视角，",
    "start": 109.509,
    "end": 111.469,
    "duration": 1.96
  },
  {
    "id": "sent_29",
    "text": "真实记录战争浩劫中下层百姓的心灵受难史。",
    "start": 111.919,
    "end": 115.679,
    "duration": 3.76
  },
  {
    "id": "sent_30",
    "text": "杜甫打破盛唐诗偏于玲珑兴象的格局，开辟了即事名篇的叙事范式。",
    "start": 116.129,
    "end": 122.129,
    "duration": 6.0
  },
  {
    "id": "sent_31",
    "text": "“三吏三别” 直面征兵惨烈真相：在 《石壕吏》 中，",
    "start": 122.579,
    "end": 126.139,
    "duration": 3.56
  },
  {
    "id": "sent_32",
    "text": "诗人以客观克制的冷笔夜捉叙述，在拍门呼喝与老妇泣诉间，",
    "start": 126.589,
    "end": 131.589,
    "duration": 5.0
  },
  {
    "id": "sent_33",
    "text": "深刻揭露战争对底层家庭伦理的摧残。",
    "start": 132.039,
    "end": 135.119,
    "duration": 3.08
  },
  {
    "id": "sent_34",
    "text": "在 《茅屋为秋风所破歌》 中，面对床头屋漏的困厄，",
    "start": 135.569,
    "end": 139.369,
    "duration": 3.8
  },
  {
    "id": "sent_35",
    "text": "依然迸发出 “安得广厦千万间，",
    "start": 139.899,
    "end": 142.299,
    "duration": 2.4
  },
  {
    "id": "sent_36",
    "text": "大庇天下寒士俱欢颜” 的崇高呼号，",
    "start": 142.749,
    "end": 145.709,
    "duration": 2.96
  },
  {
    "id": "sent_37",
    "text": "展现出超越时代的人道主义光辉。",
    "start": 146.159,
    "end": 148.839,
    "duration": 2.68
  },
  {
    "id": "sent_38",
    "text": "第三，实现古典律诗之集大成，",
    "start": 149.289,
    "end": 152.209,
    "duration": 2.92
  },
  {
    "id": "sent_39",
    "text": "达成内容拓展与形式通变的圆融境界。",
    "start": 152.659,
    "end": 155.779,
    "duration": 3.12
  },
  {
    "id": "sent_40",
    "text": "杜甫对律诗体裁做出了极大开拓。",
    "start": 156.229,
    "end": 158.909,
    "duration": 2.68
  },
  {
    "id": "sent_41",
    "text": "他打破齐梁以来律诗偏于应酬浮艳的狭隘格式，将重大政治时事、",
    "start": 159.359,
    "end": 164.839,
    "duration": 5.48
  },
  {
    "id": "sent_42",
    "text": "社会现实与生民疾苦引入近体，极大地扩大了律诗表现容量。",
    "start": 165.289,
    "end": 170.249,
    "duration": 4.96
  },
  {
    "id": "sent_43",
    "text": "其七律组诗 《秋兴八首》 将身世漂泊、",
    "start": 170.699,
    "end": 174.179,
    "duration": 3.48
  },
  {
    "id": "sent_44",
    "text": "长安旧梦与时局之忧层层递进，把组诗格局推向极境。",
    "start": 174.629,
    "end": 179.309,
    "duration": 4.68
  },
  {
    "id": "sent_45",
    "text": "在格律技艺上，杜甫精研声病，",
    "start": 179.759,
    "end": 182.239,
    "duration": 2.48
  },
  {
    "id": "sent_46",
    "text": "既追求 “晚节渐于诗律细” 的工稳，",
    "start": 182.688,
    "end": 185.288,
    "duration": 2.6
  },
  {
    "id": "sent_47",
    "text": "又敢于创制 “拗救” 与变体。",
    "start": 185.738,
    "end": 187.898,
    "duration": 2.16
  },
  {
    "id": "sent_48",
    "text": "其名作 《登高》 八句皆对，",
    "start": 188.348,
    "end": 190.308,
    "duration": 1.96
  },
  {
    "id": "sent_49",
    "text": "将孤舟残年身世与万里悲秋江天融为一体，",
    "start": 190.758,
    "end": 194.358,
    "duration": 3.6
  },
  {
    "id": "sent_50",
    "text": "胡应麟 《诗薮》 赞为 “古今七言律第一”，",
    "start": 194.808,
    "end": 197.648,
    "duration": 2.84
  },
  {
    "id": "sent_51",
    "text": "标志着近体诗艺术的巅峰成熟。",
    "start": 198.098,
    "end": 200.578,
    "duration": 2.48
  },
  {
    "id": "sent_52",
    "text": "第四，承前启后开辟无数法门，构筑影响后代诗国走向的美学渊薮。",
    "start": 201.028,
    "end": 206.988,
    "duration": 5.96
  },
  {
    "id": "sent_53",
    "text": "杜甫在诗歌史上的地位具有枢纽意义。",
    "start": 207.438,
    "end": 210.398,
    "duration": 2.96
  },
  {
    "id": "sent_54",
    "text": "他以深沉的社会批判精神直接启迪了中唐新乐府运动；",
    "start": 210.848,
    "end": 215.248,
    "duration": 4.4
  },
  {
    "id": "sent_55",
    "text": "以奇崛奥衍、炼字锻句的苦心造诣开启了韩孟诗派；",
    "start": 215.698,
    "end": 220.258,
    "duration": 4.56
  },
  {
    "id": "sent_56",
    "text": "而其点化日常、化俗为雅的理趣追求，则成为宋代江西诗派与苏轼、",
    "start": 220.708,
    "end": 226.108,
    "duration": 5.4
  },
  {
    "id": "sent_57",
    "text": "黄庭坚立派的核心基石。",
    "start": 226.558,
    "end": 228.718,
    "duration": 2.16
  },
  {
    "id": "sent_58",
    "text": "元稹在 《唐故工部员外郎杜君墓系铭》 中盛赞其 “上薄风骚，",
    "start": 229.168,
    "end": 233.728,
    "duration": 4.56
  },
  {
    "id": "sent_59",
    "text": "下该沈宋，言夺苏李，气吞曹刘，奄有魏晋，兼备古今之体势”，",
    "start": 234.178,
    "end": 239.298,
    "duration": 5.12
  },
  {
    "id": "sent_60",
    "text": "公允确立了其集古典诗歌之大成的崇高地位。",
    "start": 239.948,
    "end": 243.628,
    "duration": 3.68
  }
]