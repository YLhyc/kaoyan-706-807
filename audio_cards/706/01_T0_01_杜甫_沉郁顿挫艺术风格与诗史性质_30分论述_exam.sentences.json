[
  {
    "id": 1,
    "text": "试论杜甫诗歌“沉郁顿挫”的艺术风格与“诗史”性质。",
    "start": 0.28,
    "end": 4.68,
    "duration": 4.4
  },
  {
    "id": 2,
    "text": "杜甫是中国古典诗歌现实主义传统的集大成者。",
    "start": 5.2,
    "end": 8.72,
    "duration": 3.52
  },
  {
    "id": 3,
    "text": "面对安史之乱爆发、唐王朝由盛转衰的历史剧变，杜甫秉持仁民爱物之心，",
    "start": 9.24,
    "end": 15.77,
    "duration": 6.53
  },
  {
    "id": 4,
    "text": "将个人身世之悲与国家兴亡之痛融为一体，以沉郁顿挫的美学风范与即事名篇的写实笔法，",
    "start": 16.14,
    "end": 24.19,
    "duration": 8.05
  },
  {
    "id": 5,
    "text": "真实记录了动乱年代的民生疾苦与时代心声，确立了其万代宗仰的“诗圣”地位。",
    "start": 24.56,
    "end": 31.423,
    "duration": 6.863
  },
  {
    "id": 6,
    "text": "其艺术造诣与诗史品格，主要体现在以下四个方面：",
    "start": 31.923,
    "end": 35.96,
    "duration": 4.037
  },
  {
    "id": 7,
    "text": "第一，标举“沉郁顿挫”风格特质，展现悲慨深厚的情感与起伏低回的章法。",
    "start": 36.33,
    "end": 42.89,
    "duration": 6.56
  },
  {
    "id": 8,
    "text": "“沉郁顿挫”是杜诗最核心的风格标识。",
    "start": 43.41,
    "end": 47.09,
    "duration": 3.68
  },
  {
    "id": 9,
    "text": "“沉郁”侧重思想感情的悲慨深厚，源于关怀苍生的仁者之心；",
    "start": 47.61,
    "end": 52.81,
    "duration": 5.2
  },
  {
    "id": 10,
    "text": "“顿挫”既指声调的抑扬变化，也指情感表达的波浪起伏与反复低回，",
    "start": 53.33,
    "end": 59.09,
    "duration": 5.76
  },
  {
    "id": 11,
    "text": "源于儒家中和处世心态对悲愤喷薄的节制。",
    "start": 59.46,
    "end": 63.62,
    "duration": 4.16
  },
  {
    "id": 12,
    "text": "安史动乱与抱负落空，使杜甫胸中积蓄深沉忧思，发为百折千回的诗情。",
    "start": 64.14,
    "end": 70.85,
    "duration": 6.71
  },
  {
    "id": 13,
    "text": "在《自京赴奉先县咏怀五百字》中，全诗情感四起四落：",
    "start": 71.35,
    "end": 76.02,
    "duration": 4.67
  },
  {
    "id": 14,
    "text": "先写抱负落空的郁勃，随即转向骊山行乐；",
    "start": 76.39,
    "end": 79.99,
    "duration": 3.6
  },
  {
    "id": 15,
    "text": "揭露“朱门酒肉臭，路有冻死骨”后，愤懑化为“荣枯咫尺异”的深沉叹息；",
    "start": 80.51,
    "end": 87.63,
    "duration": 7.12
  },
  {
    "id": 16,
    "text": "归家惊闻幼子饿卒，悲痛欲绝之际又转而忧念失业流民与远戍士卒，",
    "start": 88.15,
    "end": 94.71,
    "duration": 6.56
  },
  {
    "id": 17,
    "text": "意深法曲，将忧国伤时之情写得余韵无穷。",
    "start": 95.08,
    "end": 99.08,
    "duration": 4.0
  },
  {
    "id": 18,
    "text": "第二，确立“诗史”叙事传统，展现正视历史、关怀苍生的人道情怀。",
    "start": 99.6,
    "end": 105.44,
    "duration": 5.84
  },
  {
    "id": 19,
    "text": "所谓“诗史”，不仅在于据实记录安史之乱前后的时代风貌，更在于以仁者情怀写出战争浩劫中下层百姓的辛酸境遇。",
    "start": 106.001,
    "end": 115.96,
    "duration": 9.959
  },
  {
    "id": 20,
    "text": "杜甫打破盛唐诗偏重玲珑兴象的格局，以五、七言古体即事名篇，",
    "start": 116.48,
    "end": 121.97,
    "duration": 5.49
  },
  {
    "id": 21,
    "text": "着力于生活细节的真实刻画，使叙事诗具有浓郁的生活质感。",
    "start": 122.34,
    "end": 127.22,
    "duration": 4.88
  },
  {
    "id": 22,
    "text": "“三吏三别”直面征兵惨状：在《石壕吏》中，诗人以客观克制的笔法记录差吏夜捉与老妇泣诉，揭露战乱对底层家庭的摧残；",
    "start": 127.74,
    "end": 138.67,
    "duration": 10.93
  },
  {
    "id": 23,
    "text": "在《茅屋为秋风所破歌》中，身处床头屋漏的困窘境遇，",
    "start": 139.19,
    "end": 143.72,
    "duration": 4.53
  },
  {
    "id": 24,
    "text": "仍迸发出“安得广厦千万间，大庇天下寒士俱欢颜”的崇高呼号，",
    "start": 144.09,
    "end": 149.631,
    "duration": 5.541
  },
  {
    "id": 25,
    "text": "使诗史兼有历史实录之真与深厚人道关怀。",
    "start": 150.277,
    "end": 153.77,
    "duration": 3.493
  },
  {
    "id": 26,
    "text": "第三，集古典律诗之大成，拓宽近体表现容量并精研声律通变。",
    "start": 154.29,
    "end": 159.81,
    "duration": 5.52
  },
  {
    "id": 27,
    "text": "杜甫对律诗体裁贡献尤著。",
    "start": 160.33,
    "end": 162.49,
    "duration": 2.16
  },
  {
    "id": 28,
    "text": "他打破早先近体诗偏于应酬咏物的狭隘格局，",
    "start": 163.01,
    "end": 166.77,
    "duration": 3.76
  },
  {
    "id": 29,
    "text": "将重大政治时事与家国悲慨引入近体，并以组诗拓展其表现幅度。",
    "start": 167.14,
    "end": 172.82,
    "duration": 5.68
  },
  {
    "id": 30,
    "text": "七律组诗《秋兴八首》将山城秋色、身世漂泊与故国之思层层推进，情思脉络绵密连贯。",
    "start": 173.373,
    "end": 181.5,
    "duration": 8.127
  },
  {
    "id": 31,
    "text": "在格律技艺上，杜甫追求“晚节渐于诗律细”，既精于字句锤炼，",
    "start": 182.02,
    "end": 187.43,
    "duration": 5.41
  },
  {
    "id": 32,
    "text": "以致刘熙载称其“少陵炼神”，又善用“拗救”与变体以求变化中的完整。",
    "start": 187.8,
    "end": 194.44,
    "duration": 6.64
  },
  {
    "id": 33,
    "text": "名作《登高》八句皆对而流转自如，将万里悲秋与百年多病融为一气，",
    "start": 194.96,
    "end": 201.04,
    "duration": 6.08
  },
  {
    "id": 34,
    "text": "胡应麟《诗薮》赞为“古今七言律第一”，足见其将律诗写得浑融流转、无迹可寻的造诣。",
    "start": 201.41,
    "end": 209.01,
    "duration": 7.6
  },
  {
    "id": 35,
    "text": "第四，承前启后开辟无数法门，奠定后世诗歌演进的宗师典范。",
    "start": 209.53,
    "end": 215.05,
    "duration": 5.52
  },
  {
    "id": 36,
    "text": "杜甫在诗歌史上具有承先启后的枢纽地位。",
    "start": 215.57,
    "end": 218.85,
    "duration": 3.28
  },
  {
    "id": 37,
    "text": "元稹盛赞其“上薄风骚，下该沈、宋，言夺苏、李，气吞曹、刘，掩颜、谢之孤高，杂徐、庾之流丽，尽得古今之体势，而兼人人之所独专矣”，",
    "start": 219.37,
    "end": 233.26,
    "duration": 13.89
  },
  {
    "id": 38,
    "text": "公允概括了其集六朝盛唐诗歌之大成的成就。",
    "start": 233.63,
    "end": 237.23,
    "duration": 3.6
  },
  {
    "id": 39,
    "text": "他对后代诗坛影响深远：中唐元白继承其缘事而发、写生民疾苦的路线，",
    "start": 237.75,
    "end": 244.23,
    "duration": 6.48
  },
  {
    "id": 40,
    "text": "韩孟诗派得力于其奇崛造语与炼字之功，宋代黄庭坚与江西诗派则奉其为宗，",
    "start": 244.6,
    "end": 251.93,
    "duration": 7.33
  },
  {
    "id": 41,
    "text": "取法其句法锤炼与老成境界，使杜甫成为历代诗坛共同推尊的典范。",
    "start": 252.3,
    "end": 258.46,
    "duration": 6.16
  },
  {
    "id": 42,
    "text": "综上所述，杜甫以儒家仁爱之心统摄沉郁顿挫诗风与即事名篇笔法，",
    "start": 258.98,
    "end": 264.82,
    "duration": 5.84
  },
  {
    "id": 43,
    "text": "把个体遭际与唐代盛衰巨变融为一体。",
    "start": 265.19,
    "end": 268.31,
    "duration": 3.12
  },
  {
    "id": 44,
    "text": "他既集六朝盛唐古近体格律之大成，又以直面民生疾苦的写实传统为中唐新乐府运动开先声，",
    "start": 268.83,
    "end": 277.16,
    "duration": 8.33
  },
  {
    "id": 45,
    "text": "并深远影响宋代江西诗派炼字句法，在中国诗歌史上树立起兼顾时代良知与艺术法度的高峰。",
    "start": 277.53,
    "end": 285.89,
    "duration": 8.36
  }
]
