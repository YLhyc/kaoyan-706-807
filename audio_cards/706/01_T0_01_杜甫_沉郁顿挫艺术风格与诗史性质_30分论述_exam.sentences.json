[
  {
    "id": "sent_1",
    "text": "杜甫是中国古典诗歌现实主义精神的集大成者。",
    "start": 0.1,
    "end": 4.568,
    "duration": 4.468
  },
  {
    "id": "sent_2",
    "text": "面对安史之乱爆发、唐帝国由盛转衰的历史巨变，",
    "start": 4.518,
    "end": 9.127,
    "duration": 4.609
  },
  {
    "id": "sent_3",
    "text": "杜甫秉持仁民爱物的博大胸襟，",
    "start": 9.128,
    "end": 12.097,
    "duration": 2.969
  },
  {
    "id": "sent_4",
    "text": "将个人身世之悲与国家兴亡之痛融为一体。",
    "start": 12.096,
    "end": 16.536,
    "duration": 4.44
  },
  {
    "id": "sent_5",
    "text": "在创作上，他以沉郁顿挫的美学风范，全面反映时代剧变与民生疾苦；",
    "start": 16.536,
    "end": 23.138,
    "duration": 6.602
  },
  {
    "id": "sent_6",
    "text": "以即事名篇的写实笔法，生动展现一代民众的心灵受难史。",
    "start": 23.138,
    "end": 28.555,
    "duration": 5.417
  },
  {
    "id": "sent_7",
    "text": "杜甫集六朝盛唐诗歌之大成，开中晚唐乃至两宋无数法门，",
    "start": 28.555,
    "end": 34.583,
    "duration": 6.028
  },
  {
    "id": "sent_8",
    "text": "确立了其万代宗仰的 “诗圣” 地位。",
    "start": 34.583,
    "end": 37.695,
    "duration": 3.112
  },
  {
    "id": "sent_9",
    "text": "其艺术造诣与诗史品格，主要展现为以下四个核心维度：",
    "start": 37.695,
    "end": 43.359,
    "duration": 5.664
  },
  {
    "id": "sent_10",
    "text": "第一，标举“沉郁顿挫”风格特质，",
    "start": 43.359,
    "end": 46.549,
    "duration": 3.19
  },
  {
    "id": "sent_11",
    "text": "展现思想感情的深厚沉雄与表现手法的曲折起伏。",
    "start": 46.549,
    "end": 51.588,
    "duration": 5.039
  },
  {
    "id": "sent_12",
    "text": "“沉郁顿挫” 是杜甫诗歌最核心的风格标识。",
    "start": 51.589,
    "end": 55.625,
    "duration": 4.036
  },
  {
    "id": "sent_13",
    "text": "“沉郁” 侧重思想内容的深沉宽广，源于关怀苍生的仁者之心；",
    "start": 55.625,
    "end": 61.354,
    "duration": 5.729
  },
  {
    "id": "sent_14",
    "text": "“顿挫” 侧重章法波澜的回环转折，",
    "start": 61.354,
    "end": 64.674,
    "duration": 3.32
  },
  {
    "id": "sent_15",
    "text": "源于内心情感与儒家中和心态的制约。",
    "start": 64.674,
    "end": 68.463,
    "duration": 3.789
  },
  {
    "id": "sent_16",
    "text": "安史动乱与抱负破灭，使杜甫胸中积蓄深沉忧愤，",
    "start": 68.464,
    "end": 73.373,
    "duration": 4.909
  },
  {
    "id": "sent_17",
    "text": "通过反复低回的语流展现出来。",
    "start": 73.372,
    "end": 76.496,
    "duration": 3.124
  },
  {
    "id": "sent_18",
    "text": "在名作 《自京赴奉先县咏怀五百字》 中，全诗情感四起四落：",
    "start": 76.497,
    "end": 82.24,
    "duration": 5.743
  },
  {
    "id": "sent_19",
    "text": "由抱负落空的郁勃，骤转入骊山行乐的批判；",
    "start": 82.24,
    "end": 86.537,
    "duration": 4.297
  },
  {
    "id": "sent_20",
    "text": "揭露 “朱门酒肉臭，路有冻死骨” 后，愤懑化为深沉叹息；",
    "start": 86.536,
    "end": 91.835,
    "duration": 5.299
  },
  {
    "id": "sent_21",
    "text": "归家惊闻幼子饿卒，悲痛之余笔锋复转入对更悲惨远戍卒的深切关怀。",
    "start": 91.836,
    "end": 98.685,
    "duration": 6.849
  },
  {
    "id": "sent_22",
    "text": "刘熙载 《艺概》 评其意深而法曲，达到了古典抒情艺术的极高境界。",
    "start": 98.685,
    "end": 104.518,
    "duration": 5.833
  },
  {
    "id": "sent_23",
    "text": "第二，确立“诗史”叙事传统，展现感时伤事的深厚人道主义情怀。",
    "start": 104.518,
    "end": 110.898,
    "duration": 6.38
  },
  {
    "id": "sent_24",
    "text": "所谓 “诗史”，其本质不仅在于据实补正史书阙载，",
    "start": 110.898,
    "end": 115.559,
    "duration": 4.661
  },
  {
    "id": "sent_25",
    "text": "更在于以微观平民视角，真实记录战争浩劫中下层百姓的心灵受难史。",
    "start": 115.56,
    "end": 122.331,
    "duration": 6.771
  },
  {
    "id": "sent_26",
    "text": "杜甫打破盛唐诗偏于玲珑兴象的格局，开辟了即事名篇的叙事范式。",
    "start": 122.331,
    "end": 128.503,
    "duration": 6.172
  },
  {
    "id": "sent_27",
    "text": "“三吏三别” 直面征兵惨烈真相：在 《石壕吏》 中，",
    "start": 128.503,
    "end": 132.761,
    "duration": 4.258
  },
  {
    "id": "sent_28",
    "text": "诗人以客观克制的冷笔夜捉叙述，在拍门呼喝与老妇泣诉间，",
    "start": 132.76,
    "end": 138.372,
    "duration": 5.612
  },
  {
    "id": "sent_29",
    "text": "深刻揭露战争对底层家庭伦理的摧残。",
    "start": 138.372,
    "end": 142.252,
    "duration": 3.88
  },
  {
    "id": "sent_30",
    "text": "在 《茅屋为秋风所破歌》 中，面对床头屋漏的困厄，",
    "start": 142.253,
    "end": 146.81,
    "duration": 4.557
  },
  {
    "id": "sent_31",
    "text": "依然迸发出 “安得广厦千万间，大庇天下寒士俱欢颜” 的崇高呼号，",
    "start": 146.81,
    "end": 152.982,
    "duration": 6.172
  },
  {
    "id": "sent_32",
    "text": "展现出超越时代的人道主义光辉。",
    "start": 152.982,
    "end": 156.354,
    "duration": 3.372
  },
  {
    "id": "sent_33",
    "text": "第三，实现古典律诗之集大成，达成内容拓展与形式通变的圆融境界。",
    "start": 156.354,
    "end": 163.203,
    "duration": 6.849
  },
  {
    "id": "sent_34",
    "text": "杜甫对律诗体裁做出了极大开拓。",
    "start": 163.203,
    "end": 166.719,
    "duration": 3.516
  },
  {
    "id": "sent_35",
    "text": "他打破齐梁以来律诗偏于应酬浮艳的狭隘格式，",
    "start": 166.719,
    "end": 171.146,
    "duration": 4.427
  },
  {
    "id": "sent_36",
    "text": "将重大政治时事、社会现实与生民疾苦引入近体，",
    "start": 171.146,
    "end": 176.406,
    "duration": 5.26
  },
  {
    "id": "sent_37",
    "text": "极大地扩大了律诗表现容量。",
    "start": 176.406,
    "end": 179.336,
    "duration": 2.93
  },
  {
    "id": "sent_38",
    "text": "其七律组诗 《秋兴八首》 将身世漂泊、长安旧梦与时局之忧层层递进，",
    "start": 179.336,
    "end": 185.925,
    "duration": 6.589
  },
  {
    "id": "sent_39",
    "text": "把组诗格局推向极境。",
    "start": 185.924,
    "end": 188.619,
    "duration": 2.695
  },
  {
    "id": "sent_40",
    "text": "在格律技艺上，杜甫精研声病，既追求 “晚节渐于诗律细” 的工稳，",
    "start": 188.619,
    "end": 194.453,
    "duration": 5.834
  },
  {
    "id": "sent_41",
    "text": "又敢于创制 “拗救” 与变体。",
    "start": 194.453,
    "end": 197.343,
    "duration": 2.89
  },
  {
    "id": "sent_42",
    "text": "其名作 《登高》 八句皆对，",
    "start": 197.343,
    "end": 199.987,
    "duration": 2.644
  },
  {
    "id": "sent_43",
    "text": "将孤舟残年身世与万里悲秋江天融为一体，",
    "start": 199.987,
    "end": 204.401,
    "duration": 4.414
  },
  {
    "id": "sent_44",
    "text": "胡应麟 《诗薮》 赞为 “古今七言律第一”，",
    "start": 204.401,
    "end": 207.708,
    "duration": 3.307
  },
  {
    "id": "sent_45",
    "text": "标志着近体诗艺术的巅峰成熟。",
    "start": 207.708,
    "end": 210.911,
    "duration": 3.203
  },
  {
    "id": "sent_46",
    "text": "第四，承前启后开辟无数法门，构筑影响后代诗国走向的美学渊薮。",
    "start": 210.911,
    "end": 217.63,
    "duration": 6.719
  },
  {
    "id": "sent_47",
    "text": "杜甫在诗歌史上的地位具有枢纽意义。",
    "start": 217.63,
    "end": 221.198,
    "duration": 3.568
  },
  {
    "id": "sent_48",
    "text": "他以深沉的社会批判精神直接启迪了中唐新乐府运动；",
    "start": 221.198,
    "end": 226.198,
    "duration": 5.0
  },
  {
    "id": "sent_49",
    "text": "以奇崛奥衍、炼字锻句的苦心造诣开启了韩孟诗派；",
    "start": 226.198,
    "end": 231.185,
    "duration": 4.987
  },
  {
    "id": "sent_50",
    "text": "而其点化日常、化俗为雅的理趣追求，",
    "start": 231.185,
    "end": 235.117,
    "duration": 3.932
  },
  {
    "id": "sent_51",
    "text": "则成为宋代江西诗派与苏轼、黄庭坚立派的核心基石。",
    "start": 235.117,
    "end": 240.416,
    "duration": 5.299
  },
  {
    "id": "sent_52",
    "text": "元稹在 《唐故工部员外郎杜君墓系铭》 中盛赞其 “上薄风骚，",
    "start": 240.416,
    "end": 246.002,
    "duration": 5.586
  },
  {
    "id": "sent_53",
    "text": "下该沈宋，言夺苏李，气吞曹刘，奄有魏晋，兼备古今之体势”，",
    "start": 246.003,
    "end": 252.513,
    "duration": 6.51
  },
  {
    "id": "sent_54",
    "text": "公允确立了其集古典诗歌之大成的崇高地位。",
    "start": 252.513,
    "end": 256.745,
    "duration": 4.232
  }
]