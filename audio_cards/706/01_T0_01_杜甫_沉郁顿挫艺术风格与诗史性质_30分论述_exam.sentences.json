[
  {
    "id": 1,
    "text": "试论杜甫诗歌“沉郁顿挫”的艺术风格与“诗史”性质。",
    "start": 0.0,
    "end": 4.974,
    "duration": 4.974
  },
  {
    "id": 2,
    "text": "杜甫是中国古典诗歌现实主义精神的集大成者。",
    "start": 4.974,
    "end": 9.196,
    "duration": 4.222
  },
  {
    "id": 3,
    "text": "面对安史之乱爆发、唐帝国由盛转衰的历史巨变，",
    "start": 9.196,
    "end": 13.554,
    "duration": 4.358
  },
  {
    "id": 4,
    "text": "杜甫秉持仁民爱物的博大胸襟，",
    "start": 13.554,
    "end": 16.609,
    "duration": 3.055
  },
  {
    "id": 5,
    "text": "将个人身世之悲与国家兴亡之痛融为一体。",
    "start": 16.609,
    "end": 20.232,
    "duration": 3.623
  },
  {
    "id": 6,
    "text": "在创作上，他以沉郁顿挫的美学风范，",
    "start": 20.232,
    "end": 23.218,
    "duration": 2.986
  },
  {
    "id": 7,
    "text": "全面反映时代剧变与民生疾苦；以即事名篇的写实笔法，",
    "start": 23.218,
    "end": 28.25,
    "duration": 5.032
  },
  {
    "id": 8,
    "text": "生动展现一代民众的心灵受难史。",
    "start": 28.25,
    "end": 31.23,
    "duration": 2.98
  },
  {
    "id": 9,
    "text": "杜甫集六朝盛唐诗歌之大成，开中晚唐乃至两宋无数法门，",
    "start": 31.23,
    "end": 36.443,
    "duration": 5.213
  },
  {
    "id": 10,
    "text": "确立了其万代宗仰的 “诗圣” 地位。",
    "start": 36.443,
    "end": 39.099,
    "duration": 2.656
  },
  {
    "id": 11,
    "text": "其艺术造诣与诗史品格，主要展现为以下四个核心维度：",
    "start": 39.099,
    "end": 44.59,
    "duration": 5.491
  },
  {
    "id": 12,
    "text": "第一，标举“沉郁顿挫”风格特质，",
    "start": 44.59,
    "end": 49.171,
    "duration": 4.581
  },
  {
    "id": 13,
    "text": "展现思想感情的深厚沉雄与表现手法的曲折起伏。",
    "start": 49.171,
    "end": 52.27,
    "duration": 3.099
  },
  {
    "id": 14,
    "text": "“沉郁顿挫” 是杜甫诗歌最核心的风格标识。",
    "start": 52.27,
    "end": 57.747,
    "duration": 5.477
  },
  {
    "id": 15,
    "text": "“沉郁” 侧重思想内容的深沉宽广，",
    "start": 57.747,
    "end": 60.138,
    "duration": 2.391
  },
  {
    "id": 16,
    "text": "源于关怀苍生的仁者之心；",
    "start": 60.138,
    "end": 63.158,
    "duration": 3.02
  },
  {
    "id": 17,
    "text": "“顿挫” 侧重章法波澜的回环转折，",
    "start": 63.158,
    "end": 66.795,
    "duration": 3.637
  },
  {
    "id": 18,
    "text": "源于内心情感与儒家中和心态的制约。",
    "start": 66.795,
    "end": 68.639,
    "duration": 1.844
  },
  {
    "id": 19,
    "text": "安史动乱与抱负破灭，使杜甫胸中积蓄深沉忧愤，",
    "start": 68.639,
    "end": 73.907,
    "duration": 5.268
  },
  {
    "id": 20,
    "text": "通过反复低回的语流展现出来。",
    "start": 73.907,
    "end": 77.739,
    "duration": 3.832
  },
  {
    "id": 21,
    "text": "在名作 《自京赴奉先县咏怀五百字》 中，",
    "start": 77.739,
    "end": 79.74,
    "duration": 2.001
  },
  {
    "id": 22,
    "text": "全诗情感四起四落：由抱负落空的郁勃，",
    "start": 79.74,
    "end": 83.578,
    "duration": 3.838
  },
  {
    "id": 23,
    "text": "骤转入骊山行乐的批判；揭露 “朱门酒肉臭，",
    "start": 83.578,
    "end": 88.555,
    "duration": 4.977
  },
  {
    "id": 24,
    "text": "路有冻死骨” 后，愤懑化为深沉叹息；归家惊闻幼子饿卒，",
    "start": 88.555,
    "end": 95.131,
    "duration": 6.576
  },
  {
    "id": 25,
    "text": "悲痛之余笔锋复转入对更悲惨远戍卒的深切关怀。",
    "start": 95.131,
    "end": 96.463,
    "duration": 1.332
  },
  {
    "id": 26,
    "text": "刘熙载 《艺概》 评其意深而法曲，",
    "start": 96.463,
    "end": 100.955,
    "duration": 4.492
  },
  {
    "id": 27,
    "text": "达到了古典抒情艺术的极高境界。",
    "start": 100.955,
    "end": 106.455,
    "duration": 5.5
  },
  {
    "id": 28,
    "text": "第二，确立“诗史”叙事传统，展现感时伤事的深厚人道主义情怀。",
    "start": 106.455,
    "end": 110.879,
    "duration": 4.424
  },
  {
    "id": 29,
    "text": "所谓 “诗史”，其本质不仅在于据实补正史书阙载，",
    "start": 110.879,
    "end": 114.763,
    "duration": 3.884
  },
  {
    "id": 30,
    "text": "更在于以微观平民视角，",
    "start": 114.763,
    "end": 117.115,
    "duration": 2.352
  },
  {
    "id": 31,
    "text": "真实记录战争浩劫中下层百姓的心灵受难史。",
    "start": 117.115,
    "end": 120.801,
    "duration": 3.686
  },
  {
    "id": 32,
    "text": "杜甫打破盛唐诗偏于玲珑兴象的格局，开辟了即事名篇的叙事范式。",
    "start": 120.801,
    "end": 127.159,
    "duration": 6.358
  },
  {
    "id": 33,
    "text": "“三吏三别” 直面征兵惨烈真相：在 《石壕吏》 中，",
    "start": 127.159,
    "end": 130.225,
    "duration": 3.066
  },
  {
    "id": 34,
    "text": "诗人以客观克制的冷笔夜捉叙述，在拍门呼喝与老妇泣诉间，",
    "start": 130.225,
    "end": 132.617,
    "duration": 2.392
  },
  {
    "id": 35,
    "text": "深刻揭露战争对底层家庭伦理的摧残。",
    "start": 132.617,
    "end": 137.919,
    "duration": 5.302
  },
  {
    "id": 36,
    "text": "在 《茅屋为秋风所破歌》 中，面对床头屋漏的困厄，",
    "start": 137.919,
    "end": 140.954,
    "duration": 3.035
  },
  {
    "id": 37,
    "text": "依然迸发出 “安得广厦千万间，",
    "start": 140.954,
    "end": 145.927,
    "duration": 4.973
  },
  {
    "id": 38,
    "text": "大庇天下寒士俱欢颜” 的崇高呼号，",
    "start": 145.927,
    "end": 148.675,
    "duration": 2.748
  },
  {
    "id": 39,
    "text": "展现出超越时代的人道主义光辉。",
    "start": 148.675,
    "end": 152.067,
    "duration": 3.392
  },
  {
    "id": 40,
    "text": "第三，实现古典律诗之集大成，",
    "start": 152.067,
    "end": 155.556,
    "duration": 3.489
  },
  {
    "id": 41,
    "text": "达成内容拓展与形式通变的圆融境界。",
    "start": 155.556,
    "end": 158.32,
    "duration": 2.764
  },
  {
    "id": 42,
    "text": "杜甫对律诗体裁做出了极大开拓。",
    "start": 158.32,
    "end": 160.297,
    "duration": 1.977
  },
  {
    "id": 43,
    "text": "他打破齐梁以来律诗偏于应酬浮艳的狭隘格式，",
    "start": 160.297,
    "end": 164.395,
    "duration": 4.098
  },
  {
    "id": 44,
    "text": "将重大政治时事、社会现实与生民疾苦引入近体，",
    "start": 164.395,
    "end": 169.396,
    "duration": 5.001
  },
  {
    "id": 45,
    "text": "极大地扩大了律诗表现容量。",
    "start": 169.396,
    "end": 171.488,
    "duration": 2.092
  },
  {
    "id": 46,
    "text": "其七律组诗 《秋兴八首》 将身世漂泊、",
    "start": 171.488,
    "end": 174.762,
    "duration": 3.274
  },
  {
    "id": 47,
    "text": "长安旧梦与时局之忧层层递进，把组诗格局推向极境。",
    "start": 174.762,
    "end": 179.502,
    "duration": 4.74
  },
  {
    "id": 48,
    "text": "在格律技艺上，杜甫精研声病，",
    "start": 179.502,
    "end": 183.633,
    "duration": 4.131
  },
  {
    "id": 49,
    "text": "既追求 “晚节渐于诗律细” 的工稳，",
    "start": 183.633,
    "end": 185.818,
    "duration": 2.185
  },
  {
    "id": 50,
    "text": "又敢于创制 “拗救” 与变体。",
    "start": 185.818,
    "end": 187.786,
    "duration": 1.968
  },
  {
    "id": 51,
    "text": "其名作 《登高》 八句皆对，",
    "start": 187.786,
    "end": 191.479,
    "duration": 3.693
  },
  {
    "id": 52,
    "text": "将孤舟残年身世与万里悲秋江天融为一体，",
    "start": 191.479,
    "end": 194.57,
    "duration": 3.091
  },
  {
    "id": 53,
    "text": "胡应麟 《诗薮》 赞为 “古今七言律第一”，",
    "start": 194.57,
    "end": 197.075,
    "duration": 2.505
  },
  {
    "id": 54,
    "text": "标志着近体诗艺术的巅峰成熟。",
    "start": 197.075,
    "end": 200.592,
    "duration": 3.517
  },
  {
    "id": 55,
    "text": "第四，承前启后开辟无数法门，构筑影响后代诗国走向的美学渊薮。",
    "start": 200.592,
    "end": 206.705,
    "duration": 6.113
  },
  {
    "id": 56,
    "text": "杜甫在诗歌史上的地位具有枢纽意义。",
    "start": 206.705,
    "end": 208.756,
    "duration": 2.051
  },
  {
    "id": 57,
    "text": "他以深沉的社会批判精神直接启迪了中唐新乐府运动；",
    "start": 208.756,
    "end": 215.741,
    "duration": 6.985
  },
  {
    "id": 58,
    "text": "以奇崛奥衍、炼字锻句的苦心造诣开启了韩孟诗派；",
    "start": 215.741,
    "end": 218.925,
    "duration": 3.184
  },
  {
    "id": 59,
    "text": "而其点化日常、化俗为雅的理趣追求，",
    "start": 218.925,
    "end": 223.565,
    "duration": 4.64
  },
  {
    "id": 60,
    "text": "则成为宋代江西诗派与苏轼、黄庭坚立派的核心基石。",
    "start": 223.565,
    "end": 228.068,
    "duration": 4.503
  },
  {
    "id": 61,
    "text": "元稹在 《唐故工部员外郎杜君墓系铭》 中盛赞其 “上薄风骚，",
    "start": 228.068,
    "end": 229.19,
    "duration": 1.122
  },
  {
    "id": 62,
    "text": "下该沈宋，言夺苏李，气吞曹刘，奄有魏晋，",
    "start": 229.19,
    "end": 233.102,
    "duration": 3.912
  },
  {
    "id": 63,
    "text": "兼备古今之体势”，",
    "start": 233.102,
    "end": 234.921,
    "duration": 1.819
  },
  {
    "id": 64,
    "text": "公允确立了其集古典诗歌之大成的崇高地位。",
    "start": 234.921,
    "end": 238.2,
    "duration": 3.279
  }
]