[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《左传》·叙事艺术特征与先秦历史散文演进",
    "start": 0.134,
    "end": 4.052,
    "duration": 3.918
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "体制革新→宏大战事→微观辞令人物：先指出它比《尚书》《春秋》前进了一大步——建构有血有肉的编年叙事体制，",
    "start": 4.641,
    "end": 14.797,
    "duration": 10.155
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再看写战争如何重战前外交谋略而不只写砍杀，",
    "start": 15.11,
    "end": 19.289,
    "duration": 4.179
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后收束到言行细节写人与“文典而美”的行人辞令。",
    "start": 19.39,
    "end": 23.438,
    "duration": 4.048
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《左传》（全称《春秋左氏传》）是我国第一部记事完备的编年体史书，标志先秦叙事散文成熟。",
    "start": 24.025,
    "end": 31.654,
    "duration": 7.629
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "刘知幾《史通》赞“盖左氏为书，叙事之最”。",
    "start": 32.241,
    "end": 35.443,
    "duration": 3.202
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 确立编年详博体制、由记言转向写人",
    "start": 36.03,
    "end": 40.066,
    "duration": 4.035
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "摆脱《尚书》偏重记言与《春秋》过于简括，以《春秋》为纲详记二百余年列国争霸兴亡；",
    "start": 40.64,
    "end": 48.503,
    "duration": 7.864
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "交代因果脉络，穿插倒叙预叙，并开创“君子曰”直接评价史事人物，奠定史传文学基础。",
    "start": 49.077,
    "end": 57.344,
    "duration": 8.267
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 全景描写战争、重政治谋略与胜败因果",
    "start": 57.918,
    "end": 62.292,
    "duration": 4.374
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "不局限两军厮杀，从政治、外交与礼义揭示胜败根源；",
    "start": 62.879,
    "end": 68.712,
    "duration": 5.832
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "于“城濮之战”“崤之战”“邲之战”详写战前君臣谋划与“退避三舍”外交退让，",
    "start": 69.299,
    "end": 76.537,
    "duration": 7.239
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "略写厮杀抓要害，战后总结教训，主次分明。",
    "start": 76.825,
    "end": 80.782,
    "duration": 3.957
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 言行细节刻画人物与典雅行人辞令",
    "start": 81.369,
    "end": 85.209,
    "duration": 3.84
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "少静止肖像，借冲突中动作言谈刻画晋文公成长、郑庄公机诈与武士忠义，细节传神；",
    "start": 85.796,
    "end": 94.962,
    "duration": 9.166
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "保留《史通》誉“文典而美，语博而奥”的“行人辞令”，",
    "start": 95.549,
    "end": 100.235,
    "duration": 4.686
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "如《烛之武退秦师》扣紧利害、委婉切理扭转危机，启迪战国策士散文。",
    "start": 100.562,
    "end": 107.097,
    "duration": 6.535
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：唐代刘知幾《史通》赞《左传》“盖左氏为书，叙事之最”，赞其行人辞令“文典而美，语博而奥”。",
    "start": 107.671,
    "end": 116.329,
    "duration": 8.658
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 刘知幾《史通》对《左传》叙事和辞令的经典评语各是什么？",
    "start": 116.89,
    "end": 122.891,
    "duration": 6.002
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 从《尚书》《春秋》到《左传》，先秦史传完成了哪两大转型？",
    "start": 123.465,
    "end": 130.326,
    "duration": 6.861
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 结合城濮之战与《烛之武退秦师》概括《左传》写战与辞令特色？",
    "start": 130.9,
    "end": 137.722,
    "duration": 6.822
  }
]