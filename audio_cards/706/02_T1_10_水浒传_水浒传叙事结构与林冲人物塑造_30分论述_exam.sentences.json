[
  {
    "id": 1,
    "text": "试论《水浒传》的叙事结构与林冲人物塑造。",
    "start": 0.0,
    "end": 3.861,
    "duration": 3.861
  },
  {
    "id": 2,
    "text": "《水浒传》 是中国文学史上第一部全面描写农民起义的长篇白话章回小说，",
    "start": 3.861,
    "end": 10.051,
    "duration": 6.19
  },
  {
    "id": 3,
    "text": "开创了中国古典英雄传奇小说的叙事高峰。",
    "start": 10.051,
    "end": 13.424,
    "duration": 3.373
  },
  {
    "id": 4,
    "text": "面对北宋末年黑暗腐朽的封建统治与阶级矛盾激化，",
    "start": 13.424,
    "end": 17.786,
    "duration": 4.362
  },
  {
    "id": 5,
    "text": "施耐庵吸纳宋元水浒话本与戏曲养分，",
    "start": 17.786,
    "end": 21.156,
    "duration": 3.37
  },
  {
    "id": 6,
    "text": "以宏伟的艺术笔触深刻揭示了 “官逼民反，",
    "start": 21.156,
    "end": 27.179,
    "duration": 6.023
  },
  {
    "id": 7,
    "text": "乱自上作” 的深刻历史必然性。",
    "start": 27.179,
    "end": 31.464,
    "duration": 4.285
  },
  {
    "id": 8,
    "text": "金圣叹评其 “文章不避重复，而自不重复”，",
    "start": 31.464,
    "end": 34.614,
    "duration": 3.15
  },
  {
    "id": 9,
    "text": "对其叙事与人物塑造推崇备至。",
    "start": 34.614,
    "end": 37.981,
    "duration": 3.367
  },
  {
    "id": 10,
    "text": "其叙事结构特征与林冲人物形象塑造，",
    "start": 37.981,
    "end": 40.625,
    "duration": 2.644
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：第一，",
    "start": 40.625,
    "end": 41.357,
    "duration": 0.732
  },
  {
    "id": 12,
    "text": "开创由单人传奇串联走向群体聚合的链条式单线演进叙事结构。",
    "start": 41.357,
    "end": 48.105,
    "duration": 6.748
  },
  {
    "id": 13,
    "text": "《水浒传》 在前七十回的架构上，",
    "start": 48.105,
    "end": 50.489,
    "duration": 2.384
  },
  {
    "id": 14,
    "text": "创造性地打破了全景网状模式，",
    "start": 50.489,
    "end": 53.292,
    "duration": 2.803
  },
  {
    "id": 15,
    "text": "采用了 “链条式” 的递进结构。",
    "start": 53.292,
    "end": 55.508,
    "duration": 2.216
  },
  {
    "id": 16,
    "text": "作者往往以一个英雄人物为叙事焦点，详细展开其受屈被害、",
    "start": 55.508,
    "end": 60.9,
    "duration": 5.392
  },
  {
    "id": 17,
    "text": "奋起反抗的完整独立传奇（如鲁智深大闹野猪林、",
    "start": 60.9,
    "end": 66.78,
    "duration": 5.88
  },
  {
    "id": 18,
    "text": "林冲风雪山神庙、杨志卖刀、武松景阳冈打虎与醉打蒋门神）；",
    "start": 66.78,
    "end": 67.742,
    "duration": 0.962
  },
  {
    "id": 19,
    "text": "当该英雄被逼入绝境逼上梁山时，",
    "start": 67.742,
    "end": 75.329,
    "duration": 7.587
  },
  {
    "id": 20,
    "text": "又顺势带出下一位好汉的命运。",
    "start": 75.329,
    "end": 78.852,
    "duration": 3.523
  },
  {
    "id": 21,
    "text": "这种如同链环互扣的单人传奇推进方式，",
    "start": 78.852,
    "end": 79.999,
    "duration": 1.147
  },
  {
    "id": 22,
    "text": "使小说情节既具短篇传奇的引人入胜，",
    "start": 79.999,
    "end": 83.858,
    "duration": 3.859
  },
  {
    "id": 23,
    "text": "又如百川归海般汇聚为梁山泊大聚义的壮阔史诗，",
    "start": 83.858,
    "end": 86.979,
    "duration": 3.121
  },
  {
    "id": 24,
    "text": "生动再现了起义力量由点到面的历史汇聚过程。第二，",
    "start": 86.979,
    "end": 91.997,
    "duration": 5.018
  },
  {
    "id": 25,
    "text": "以精微心理与行动细节塑造具有深刻发展性的性格典型（以林冲为例）。",
    "start": 91.997,
    "end": 98.223,
    "duration": 6.226
  },
  {
    "id": 26,
    "text": "在人物塑造上，",
    "start": 98.223,
    "end": 99.743,
    "duration": 1.52
  },
  {
    "id": 27,
    "text": "《水浒传》 摆脱了传统说书人物性格固定扁平的缺陷，",
    "start": 99.743,
    "end": 104.361,
    "duration": 4.618
  },
  {
    "id": 28,
    "text": "塑造出具有复杂心理演变与鲜明发展轨迹的典型性格。",
    "start": 104.361,
    "end": 109.551,
    "duration": 5.19
  },
  {
    "id": 29,
    "text": "其中 “豹子头林冲” 的塑造堪称绝笔：",
    "start": 109.551,
    "end": 112.733,
    "duration": 3.182
  },
  {
    "id": 30,
    "text": "作为东京八十万禁军教头，",
    "start": 112.733,
    "end": 115.061,
    "duration": 2.328
  },
  {
    "id": 31,
    "text": "林冲本属封建统治体制内的既得利益者。",
    "start": 115.061,
    "end": 118.224,
    "duration": 3.163
  },
  {
    "id": 32,
    "text": "在遭到高衙内调戏妻子、被陷害误入白虎堂后，",
    "start": 118.224,
    "end": 122.167,
    "duration": 3.943
  },
  {
    "id": 33,
    "text": "他首先表现出的是屈从隐忍、息事宁人的妥协心理；",
    "start": 122.167,
    "end": 126.682,
    "duration": 4.515
  },
  {
    "id": 34,
    "text": "在刺配沧州路上，董超、薛霸以沸水烫脚、野猪林行刺，",
    "start": 126.682,
    "end": 131.684,
    "duration": 5.002
  },
  {
    "id": 35,
    "text": "他依然委曲求全；直到草料场被点燃，",
    "start": 131.684,
    "end": 135.04,
    "duration": 3.356
  },
  {
    "id": 36,
    "text": "在山神庙前偷听到陆谦等人置其于死地的密谋，",
    "start": 135.04,
    "end": 139.332,
    "duration": 4.292
  },
  {
    "id": 37,
    "text": "林冲对体制的幻想才彻底破灭，愤而手刃仇敌、风雪上梁山。",
    "start": 139.332,
    "end": 144.701,
    "duration": 5.369
  },
  {
    "id": 38,
    "text": "这种由隐忍委曲到彻底反叛的性格蜕变，",
    "start": 144.701,
    "end": 148.049,
    "duration": 3.348
  },
  {
    "id": 39,
    "text": "深刻揭示了“逼上梁山”的历史必然规律。",
    "start": 148.049,
    "end": 151.243,
    "duration": 3.194
  },
  {
    "id": 40,
    "text": "第三，长于在极其相似的生活情节中展现绝不雷同的个性化风貌。",
    "start": 151.243,
    "end": 156.992,
    "duration": 5.749
  },
  {
    "id": 41,
    "text": "施耐庵具备极其出色的艺术提炼功力，",
    "start": 156.992,
    "end": 159.861,
    "duration": 2.869
  },
  {
    "id": 42,
    "text": "善于在同类题材中刻画人物之异。",
    "start": 159.861,
    "end": 162.656,
    "duration": 2.795
  },
  {
    "id": 43,
    "text": "金圣叹盛赞其写一百零八人，直是一百零八样。",
    "start": 162.656,
    "end": 167.29,
    "duration": 4.634
  },
  {
    "id": 44,
    "text": "以打虎为例，李逵在沂岭杀四虎，纯用蛮力直扑，",
    "start": 167.29,
    "end": 172.924,
    "duration": 5.634
  },
  {
    "id": 45,
    "text": "充溢着为母报仇的狂暴与悲切；武松在景阳冈打虎，",
    "start": 172.924,
    "end": 176.384,
    "duration": 3.46
  },
  {
    "id": 46,
    "text": "则兼备酒后豪气与惊险格斗中的机敏沉着。",
    "start": 176.384,
    "end": 180.427,
    "duration": 4.043
  },
  {
    "id": 47,
    "text": "同样是鲁莽粗豪，鲁智深粗中有细、见义勇为，",
    "start": 180.427,
    "end": 183.18,
    "duration": 2.753
  },
  {
    "id": 48,
    "text": "具有佛家慈悲怀抱；李逵则赤诚天真而滥杀无辜，",
    "start": 183.18,
    "end": 187.711,
    "duration": 4.531
  },
  {
    "id": 49,
    "text": "充满原始破坏力。",
    "start": 187.711,
    "end": 189.203,
    "duration": 1.492
  },
  {
    "id": 50,
    "text": "这种对人性幽微同异的精准把握，使水浒群像鲜活生动、历久弥新。",
    "start": 189.203,
    "end": 195.91,
    "duration": 6.707
  },
  {
    "id": 51,
    "text": "第四，创造出成熟生动的古代白话小说语言，",
    "start": 195.91,
    "end": 199.654,
    "duration": 3.744
  },
  {
    "id": 52,
    "text": "确立通俗叙事的纯正文风。",
    "start": 199.654,
    "end": 201.91,
    "duration": 2.256
  },
  {
    "id": 53,
    "text": "《水浒传》 在语言运用上实现了划时代的突破。",
    "start": 201.91,
    "end": 205.669,
    "duration": 3.759
  },
  {
    "id": 54,
    "text": "它彻底摆脱了文言史传文与骈俪浮词的束缚，",
    "start": 205.669,
    "end": 209.469,
    "duration": 3.8
  },
  {
    "id": 55,
    "text": "以宋元明成熟的北方白话口语为基础，经过艺术提炼，",
    "start": 209.469,
    "end": 213.923,
    "duration": 4.454
  },
  {
    "id": 56,
    "text": "创造出极其洗练、明快、生动的通俗叙事母语。",
    "start": 213.923,
    "end": 219.079,
    "duration": 5.156
  },
  {
    "id": 57,
    "text": "书中人物对话完全符合其身份、阶层与个性，",
    "start": 219.079,
    "end": 221.917,
    "duration": 2.838
  },
  {
    "id": 58,
    "text": "“其言如出其口”；在描写风雪、打斗等场面时，",
    "start": 221.917,
    "end": 226.218,
    "duration": 4.301
  },
  {
    "id": 59,
    "text": "动词运用精练准确，如林冲在山神庙用石头“把门拽开，",
    "start": 226.218,
    "end": 231.718,
    "duration": 5.5
  },
  {
    "id": 60,
    "text": "挺着朴刀”等动作描写，字字传神，",
    "start": 231.718,
    "end": 234.204,
    "duration": 2.486
  },
  {
    "id": 61,
    "text": "达到了中国古代白话小说语言艺术的极高成就。",
    "start": 234.204,
    "end": 238.68,
    "duration": 4.476
  }
]