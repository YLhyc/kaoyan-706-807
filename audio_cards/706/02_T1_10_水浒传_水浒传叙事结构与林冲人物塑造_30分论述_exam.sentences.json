[
  {
    "id": "sent_1",
    "text": "《水浒传》 是中国文学史上第一部全面描写农民起义的长篇白话章回小说，",
    "start": 0.1,
    "end": 6.443,
    "duration": 6.343
  },
  {
    "id": "sent_2",
    "text": "开创了中国古典英雄传奇小说的叙事高峰。",
    "start": 6.393,
    "end": 10.547,
    "duration": 4.154
  },
  {
    "id": "sent_3",
    "text": "面对北宋末年黑暗腐朽的封建统治与阶级矛盾激化，",
    "start": 10.547,
    "end": 15.69,
    "duration": 5.143
  },
  {
    "id": "sent_4",
    "text": "施耐庵吸纳宋元水浒话本与戏曲养分，",
    "start": 15.69,
    "end": 19.531,
    "duration": 3.841
  },
  {
    "id": "sent_5",
    "text": "以宏伟的艺术笔触深刻揭示了 “官逼民反，",
    "start": 19.531,
    "end": 23.672,
    "duration": 4.141
  },
  {
    "id": "sent_6",
    "text": "乱自上作” 的深刻历史必然性。",
    "start": 23.672,
    "end": 26.602,
    "duration": 2.93
  },
  {
    "id": "sent_7",
    "text": "金圣叹评其 “文章不避重复，而自不重复”，",
    "start": 26.602,
    "end": 30.808,
    "duration": 4.206
  },
  {
    "id": "sent_8",
    "text": "对其叙事与人物塑造推崇备至。",
    "start": 30.807,
    "end": 34.062,
    "duration": 3.255
  },
  {
    "id": "sent_9",
    "text": "其叙事结构特征与林冲人物形象塑造，主要展现为以下四个核心维度：",
    "start": 34.063,
    "end": 41.055,
    "duration": 6.992
  },
  {
    "id": "sent_10",
    "text": "第一，开创由单人传奇串联走向群体聚合的链条式单线演进叙事结构。",
    "start": 41.055,
    "end": 47.904,
    "duration": 6.849
  },
  {
    "id": "sent_11",
    "text": "《水浒传》 在前七十回的架构上，创造性地打破了全景网状模式，",
    "start": 47.904,
    "end": 53.672,
    "duration": 5.768
  },
  {
    "id": "sent_12",
    "text": "采用了 “链条式” 的递进结构。",
    "start": 53.672,
    "end": 56.367,
    "duration": 2.695
  },
  {
    "id": "sent_13",
    "text": "作者往往以一个英雄人物为叙事焦点，",
    "start": 56.367,
    "end": 60.13,
    "duration": 3.763
  },
  {
    "id": "sent_14",
    "text": "详细展开其受屈被害、奋起反抗的完整独立传奇（如鲁智深大闹野猪林、林冲风雪山神庙、杨志卖刀、武松景阳冈打虎与醉打蒋门神）；",
    "start": 60.13,
    "end": 73.398,
    "duration": 13.268
  },
  {
    "id": "sent_15",
    "text": "当该英雄被逼入绝境逼上梁山时，又顺势带出下一位好汉的命运。",
    "start": 73.398,
    "end": 79.596,
    "duration": 6.198
  },
  {
    "id": "sent_16",
    "text": "这种如同链环互扣的单人传奇推进方式，",
    "start": 79.596,
    "end": 83.476,
    "duration": 3.88
  },
  {
    "id": "sent_17",
    "text": "使小说情节既具短篇传奇的引人入胜，",
    "start": 83.477,
    "end": 87.618,
    "duration": 4.141
  },
  {
    "id": "sent_18",
    "text": "又如百川归海般汇聚为梁山泊大聚义的壮阔史诗，",
    "start": 87.617,
    "end": 92.37,
    "duration": 4.753
  },
  {
    "id": "sent_19",
    "text": "生动再现了起义力量由点到面的历史汇聚过程。",
    "start": 92.37,
    "end": 97.162,
    "duration": 4.792
  },
  {
    "id": "sent_20",
    "text": "第二，",
    "start": 97.161,
    "end": 98.242,
    "duration": 1.081
  },
  {
    "id": "sent_21",
    "text": "以精微心理与行动细节塑造具有深刻发展性的性格典型（以林冲为例）。",
    "start": 98.242,
    "end": 104.818,
    "duration": 6.576
  },
  {
    "id": "sent_22",
    "text": "在人物塑造上，《水浒传》 摆脱了传统说书人物性格固定扁平的缺陷，",
    "start": 104.818,
    "end": 111.055,
    "duration": 6.237
  },
  {
    "id": "sent_23",
    "text": "塑造出具有复杂心理演变与鲜明发展轨迹的典型性格。",
    "start": 111.055,
    "end": 116.328,
    "duration": 5.273
  },
  {
    "id": "sent_24",
    "text": "其中 “豹子头林冲” 的塑造堪称绝笔：作为东京八十万禁军教头，",
    "start": 116.328,
    "end": 122.018,
    "duration": 5.69
  },
  {
    "id": "sent_25",
    "text": "林冲本属封建统治体制内的既得利益者。",
    "start": 122.018,
    "end": 125.846,
    "duration": 3.828
  },
  {
    "id": "sent_26",
    "text": "在遭到高衙内调戏妻子、被陷害误入白虎堂后，",
    "start": 125.846,
    "end": 130.39,
    "duration": 4.544
  },
  {
    "id": "sent_27",
    "text": "他首先表现出的是屈从隐忍、息事宁人的妥协心理；",
    "start": 130.391,
    "end": 135.352,
    "duration": 4.961
  },
  {
    "id": "sent_28",
    "text": "在刺配沧州路上，董超、薛霸以沸水烫脚、野猪林行刺，",
    "start": 135.352,
    "end": 141.237,
    "duration": 5.885
  },
  {
    "id": "sent_29",
    "text": "他依然委曲求全；",
    "start": 141.237,
    "end": 143.333,
    "duration": 2.096
  },
  {
    "id": "sent_30",
    "text": "直到草料场被点燃，在山神庙前偷听到陆谦等人置其于死地的密谋，",
    "start": 143.333,
    "end": 150.168,
    "duration": 6.835
  },
  {
    "id": "sent_31",
    "text": "林冲对体制的幻想才彻底破灭，愤而手刃仇敌、风雪上梁山。",
    "start": 150.169,
    "end": 156.198,
    "duration": 6.029
  },
  {
    "id": "sent_32",
    "text": "这种由隐忍委曲到彻底反叛的性格蜕变，",
    "start": 156.198,
    "end": 160.247,
    "duration": 4.049
  },
  {
    "id": "sent_33",
    "text": "深刻揭示了“逼上梁山”的历史必然规律。",
    "start": 160.247,
    "end": 164.023,
    "duration": 3.776
  },
  {
    "id": "sent_34",
    "text": "第三，长于在极其相似的生活情节中展现绝不雷同的个性化风貌。",
    "start": 164.023,
    "end": 170.299,
    "duration": 6.276
  },
  {
    "id": "sent_35",
    "text": "施耐庵具备极其出色的艺术提炼功力，善于在同类题材中刻画人物之异。",
    "start": 170.299,
    "end": 176.731,
    "duration": 6.432
  },
  {
    "id": "sent_36",
    "text": "金圣叹盛赞其写一百零八人，直是一百零八样。",
    "start": 176.732,
    "end": 181.42,
    "duration": 4.688
  },
  {
    "id": "sent_37",
    "text": "以打虎为例，李逵在沂岭杀四虎，纯用蛮力直扑，",
    "start": 181.419,
    "end": 186.523,
    "duration": 5.104
  },
  {
    "id": "sent_38",
    "text": "充溢着为母报仇的狂暴与悲切；",
    "start": 186.523,
    "end": 189.583,
    "duration": 3.06
  },
  {
    "id": "sent_39",
    "text": "武松在景阳冈打虎，则兼备酒后豪气与惊险格斗中的机敏沉着。",
    "start": 189.583,
    "end": 196.028,
    "duration": 6.445
  },
  {
    "id": "sent_40",
    "text": "同样是鲁莽粗豪，鲁智深粗中有细、见义勇为，具有佛家慈悲怀抱；",
    "start": 196.029,
    "end": 202.618,
    "duration": 6.589
  },
  {
    "id": "sent_41",
    "text": "李逵则赤诚天真而滥杀无辜，充满原始破坏力。",
    "start": 202.617,
    "end": 207.539,
    "duration": 4.922
  },
  {
    "id": "sent_42",
    "text": "这种对人性幽微同异的精准把握，使水浒群像鲜活生动、历久弥新。",
    "start": 207.539,
    "end": 214.18,
    "duration": 6.641
  },
  {
    "id": "sent_43",
    "text": "第四，创造出成熟生动的古代白话小说语言，确立通俗叙事的纯正文风。",
    "start": 214.18,
    "end": 221.302,
    "duration": 7.122
  },
  {
    "id": "sent_44",
    "text": "《水浒传》 在语言运用上实现了划时代的突破。",
    "start": 221.302,
    "end": 225.378,
    "duration": 4.076
  },
  {
    "id": "sent_45",
    "text": "它彻底摆脱了文言史传文与骈俪浮词的束缚，",
    "start": 225.378,
    "end": 229.857,
    "duration": 4.479
  },
  {
    "id": "sent_46",
    "text": "以宋元明成熟的北方白话口语为基础，经过艺术提炼，",
    "start": 229.857,
    "end": 234.896,
    "duration": 5.039
  },
  {
    "id": "sent_47",
    "text": "创造出极其洗练、明快、生动的通俗叙事母语。",
    "start": 234.896,
    "end": 239.714,
    "duration": 4.818
  },
  {
    "id": "sent_48",
    "text": "书中人物对话完全符合其身份、阶层与个性，“其言如出其口”；",
    "start": 239.714,
    "end": 245.586,
    "duration": 5.872
  },
  {
    "id": "sent_49",
    "text": "在描写风雪、打斗等场面时，动词运用精练准确，",
    "start": 245.586,
    "end": 250.651,
    "duration": 5.065
  },
  {
    "id": "sent_50",
    "text": "如林冲在山神庙用石头“把门拽开，挺着朴刀”等动作描写，字字传神，",
    "start": 250.651,
    "end": 257.357,
    "duration": 6.706
  },
  {
    "id": "sent_51",
    "text": "达到了中国古代白话小说语言艺术的极高成就。",
    "start": 257.357,
    "end": 261.849,
    "duration": 4.492
  }
]