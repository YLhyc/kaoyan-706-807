[
  {
    "id": 1,
    "text": "试论《水浒传》的叙事结构与林冲人物塑造。",
    "start": 0.05,
    "end": 3.836,
    "duration": 3.786
  },
  {
    "id": 2,
    "text": "《水浒传》 是中国文学史上第一部全面描写农民起义的长篇白话章回小说，",
    "start": 3.836,
    "end": 10.021,
    "duration": 6.185
  },
  {
    "id": 3,
    "text": "开创了中国古典英雄传奇小说的叙事高峰。",
    "start": 10.021,
    "end": 13.395,
    "duration": 3.374
  },
  {
    "id": 4,
    "text": "面对北宋末年黑暗腐朽的封建统治与阶级矛盾激化，",
    "start": 13.395,
    "end": 17.756,
    "duration": 4.361
  },
  {
    "id": 5,
    "text": "施耐庵吸纳宋元水浒话本与戏曲养分，",
    "start": 17.756,
    "end": 22.62,
    "duration": 4.864
  },
  {
    "id": 6,
    "text": "以宏伟的艺术笔触深刻揭示了 “官逼民反，",
    "start": 22.62,
    "end": 27.149,
    "duration": 4.529
  },
  {
    "id": 7,
    "text": "乱自上作” 的深刻历史必然性。",
    "start": 27.149,
    "end": 29.968,
    "duration": 2.819
  },
  {
    "id": 8,
    "text": "金圣叹评其 “文章不避重复，而自不重复”，",
    "start": 29.968,
    "end": 32.877,
    "duration": 2.909
  },
  {
    "id": 9,
    "text": "对其叙事与人物塑造推崇备至。",
    "start": 32.877,
    "end": 35.241,
    "duration": 2.364
  },
  {
    "id": 10,
    "text": "其叙事结构特征与林冲人物形象塑造，",
    "start": 35.241,
    "end": 38.48,
    "duration": 3.239
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：第一，",
    "start": 38.48,
    "end": 41.327,
    "duration": 2.847
  },
  {
    "id": 12,
    "text": "开创由单人传奇串联走向群体聚合的链条式单线演进叙事结构。",
    "start": 41.327,
    "end": 48.086,
    "duration": 6.759
  },
  {
    "id": 13,
    "text": "《水浒传》 在前七十回的架构上，",
    "start": 48.086,
    "end": 50.459,
    "duration": 2.373
  },
  {
    "id": 14,
    "text": "创造性地打破了全景网状模式，",
    "start": 50.459,
    "end": 53.262,
    "duration": 2.803
  },
  {
    "id": 15,
    "text": "采用了 “链条式” 的递进结构。",
    "start": 53.262,
    "end": 55.478,
    "duration": 2.216
  },
  {
    "id": 16,
    "text": "作者往往以一个英雄人物为叙事焦点，详细展开其受屈被害、",
    "start": 55.478,
    "end": 60.877,
    "duration": 5.399
  },
  {
    "id": 17,
    "text": "奋起反抗的完整独立传奇（如鲁智深大闹野猪林、",
    "start": 60.877,
    "end": 65.176,
    "duration": 4.299
  },
  {
    "id": 18,
    "text": "林冲风雪山神庙、杨志卖刀、武松景阳冈打虎与醉打蒋门神）；",
    "start": 65.176,
    "end": 70.366,
    "duration": 5.19
  },
  {
    "id": 19,
    "text": "当该英雄被逼入绝境逼上梁山时，",
    "start": 70.366,
    "end": 73.024,
    "duration": 2.658
  },
  {
    "id": 20,
    "text": "又顺势带出下一位好汉的命运。",
    "start": 73.024,
    "end": 76.106,
    "duration": 3.082
  },
  {
    "id": 21,
    "text": "这种如同链环互扣的单人传奇推进方式，",
    "start": 76.106,
    "end": 79.969,
    "duration": 3.863
  },
  {
    "id": 22,
    "text": "使小说情节既具短篇传奇的引人入胜，",
    "start": 79.969,
    "end": 83.854,
    "duration": 3.885
  },
  {
    "id": 23,
    "text": "又如百川归海般汇聚为梁山泊大聚义的壮阔史诗，",
    "start": 83.854,
    "end": 88.017,
    "duration": 4.163
  },
  {
    "id": 24,
    "text": "生动再现了起义力量由点到面的历史汇聚过程。第二，",
    "start": 88.017,
    "end": 92.202,
    "duration": 4.185
  },
  {
    "id": 25,
    "text": "以精微心理与行动细节塑造具有深刻发展性的性格典型（以林冲为例）。",
    "start": 92.202,
    "end": 98.193,
    "duration": 5.991
  },
  {
    "id": 26,
    "text": "在人物塑造上，",
    "start": 98.193,
    "end": 99.713,
    "duration": 1.52
  },
  {
    "id": 27,
    "text": "《水浒传》 摆脱了传统说书人物性格固定扁平的缺陷，",
    "start": 99.713,
    "end": 104.331,
    "duration": 4.618
  },
  {
    "id": 28,
    "text": "塑造出具有复杂心理演变与鲜明发展轨迹的典型性格。",
    "start": 104.331,
    "end": 109.521,
    "duration": 5.19
  },
  {
    "id": 29,
    "text": "其中 “豹子头林冲” 的塑造堪称绝笔：",
    "start": 109.521,
    "end": 112.703,
    "duration": 3.182
  },
  {
    "id": 30,
    "text": "作为东京八十万禁军教头，",
    "start": 112.703,
    "end": 115.032,
    "duration": 2.329
  },
  {
    "id": 31,
    "text": "林冲本属封建统治体制内的既得利益者。",
    "start": 115.032,
    "end": 118.194,
    "duration": 3.162
  },
  {
    "id": 32,
    "text": "在遭到高衙内调戏妻子、被陷害误入白虎堂后，",
    "start": 118.194,
    "end": 122.138,
    "duration": 3.944
  },
  {
    "id": 33,
    "text": "他首先表现出的是屈从隐忍、息事宁人的妥协心理；",
    "start": 122.138,
    "end": 126.652,
    "duration": 4.514
  },
  {
    "id": 34,
    "text": "在刺配沧州路上，董超、薛霸以沸水烫脚、野猪林行刺，",
    "start": 126.652,
    "end": 131.654,
    "duration": 5.002
  },
  {
    "id": 35,
    "text": "他依然委曲求全；直到草料场被点燃，",
    "start": 131.654,
    "end": 135.011,
    "duration": 3.357
  },
  {
    "id": 36,
    "text": "在山神庙前偷听到陆谦等人置其于死地的密谋，",
    "start": 135.011,
    "end": 139.302,
    "duration": 4.291
  },
  {
    "id": 37,
    "text": "林冲对体制的幻想才彻底破灭，愤而手刃仇敌、风雪上梁山。",
    "start": 139.302,
    "end": 144.671,
    "duration": 5.369
  },
  {
    "id": 38,
    "text": "这种由隐忍委曲到彻底反叛的性格蜕变，",
    "start": 144.671,
    "end": 148.019,
    "duration": 3.348
  },
  {
    "id": 39,
    "text": "深刻揭示了“逼上梁山”的历史必然规律。",
    "start": 148.019,
    "end": 151.213,
    "duration": 3.194
  },
  {
    "id": 40,
    "text": "第三，长于在极其相似的生活情节中展现绝不雷同的个性化风貌。",
    "start": 151.213,
    "end": 156.971,
    "duration": 5.758
  },
  {
    "id": 41,
    "text": "施耐庵具备极其出色的艺术提炼功力，",
    "start": 156.971,
    "end": 160.612,
    "duration": 3.641
  },
  {
    "id": 42,
    "text": "善于在同类题材中刻画人物之异。",
    "start": 160.612,
    "end": 164.953,
    "duration": 4.341
  },
  {
    "id": 43,
    "text": "金圣叹盛赞其写一百零八人，直是一百零八样。",
    "start": 164.953,
    "end": 168.971,
    "duration": 4.018
  },
  {
    "id": 44,
    "text": "以打虎为例，李逵在沂岭杀四虎，纯用蛮力直扑，",
    "start": 168.971,
    "end": 172.898,
    "duration": 3.927
  },
  {
    "id": 45,
    "text": "充溢着为母报仇的狂暴与悲切；武松在景阳冈打虎，",
    "start": 172.898,
    "end": 176.716,
    "duration": 3.818
  },
  {
    "id": 46,
    "text": "则兼备酒后豪气与惊险格斗中的机敏沉着。",
    "start": 176.716,
    "end": 180.4,
    "duration": 3.684
  },
  {
    "id": 47,
    "text": "同样是鲁莽粗豪，鲁智深粗中有细、见义勇为，",
    "start": 180.4,
    "end": 184.961,
    "duration": 4.561
  },
  {
    "id": 48,
    "text": "具有佛家慈悲怀抱；李逵则赤诚天真而滥杀无辜，",
    "start": 184.961,
    "end": 189.175,
    "duration": 4.214
  },
  {
    "id": 49,
    "text": "充满原始破坏力。",
    "start": 189.175,
    "end": 190.447,
    "duration": 1.272
  },
  {
    "id": 50,
    "text": "这种对人性幽微同异的精准把握，使水浒群像鲜活生动、历久弥新。",
    "start": 190.447,
    "end": 195.88,
    "duration": 5.433
  },
  {
    "id": 51,
    "text": "第四，创造出成熟生动的古代白话小说语言，",
    "start": 195.88,
    "end": 199.625,
    "duration": 3.745
  },
  {
    "id": 52,
    "text": "确立通俗叙事的纯正文风。",
    "start": 199.625,
    "end": 202.755,
    "duration": 3.13
  },
  {
    "id": 53,
    "text": "《水浒传》 在语言运用上实现了划时代的突破。",
    "start": 202.755,
    "end": 207.705,
    "duration": 4.95
  },
  {
    "id": 54,
    "text": "它彻底摆脱了文言史传文与骈俪浮词的束缚，",
    "start": 207.705,
    "end": 211.16,
    "duration": 3.455
  },
  {
    "id": 55,
    "text": "以宋元明成熟的北方白话口语为基础，经过艺术提炼，",
    "start": 211.16,
    "end": 215.515,
    "duration": 4.355
  },
  {
    "id": 56,
    "text": "创造出极其洗练、明快、生动的通俗叙事母语。",
    "start": 215.515,
    "end": 219.049,
    "duration": 3.534
  },
  {
    "id": 57,
    "text": "书中人物对话完全符合其身份、阶层与个性，",
    "start": 219.049,
    "end": 223.75,
    "duration": 4.701
  },
  {
    "id": 58,
    "text": "“其言如出其口”；在描写风雪、打斗等场面时，",
    "start": 223.75,
    "end": 228.192,
    "duration": 4.442
  },
  {
    "id": 59,
    "text": "动词运用精练准确，如林冲在山神庙用石头“把门拽开，",
    "start": 228.192,
    "end": 232.656,
    "duration": 4.464
  },
  {
    "id": 60,
    "text": "挺着朴刀”等动作描写，字字传神，",
    "start": 232.656,
    "end": 235.127,
    "duration": 2.471
  },
  {
    "id": 61,
    "text": "达到了中国古代白话小说语言艺术的极高成就。",
    "start": 235.127,
    "end": 238.68,
    "duration": 3.553
  }
]