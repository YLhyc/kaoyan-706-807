[
  {
    "id": 1,
    "text": "试论《水浒传》的叙事结构与林冲人物塑造。",
    "start": 0.104,
    "end": 3.546,
    "duration": 3.442
  },
  {
    "id": 2,
    "text": "《水浒传》是中国文学史上第一部全面描写农民起义的长篇白话章回小说，",
    "start": 3.824,
    "end": 9.744,
    "duration": 5.92
  },
  {
    "id": 3,
    "text": "开创了古典英雄传奇小说的创作高峰。",
    "start": 10.066,
    "end": 12.927,
    "duration": 2.861
  },
  {
    "id": 4,
    "text": "面对封建社会黑暗腐朽的政治现实，施耐庵熔裁宋元水浒话本与戏曲养分，",
    "start": 13.295,
    "end": 19.564,
    "duration": 6.269
  },
  {
    "id": 5,
    "text": "以宏阔笔墨揭示了“官逼民反，乱自上作”的历史必然。",
    "start": 19.796,
    "end": 24.154,
    "duration": 4.358
  },
  {
    "id": 6,
    "text": "金圣叹评其“文章不避重复，而自不重复”，对其结构与写人艺术推重备至。",
    "start": 24.405,
    "end": 30.442,
    "duration": 6.037
  },
  {
    "id": 7,
    "text": "其叙事结构与林冲形象塑造，主要体现在以下四个方面：",
    "start": 30.639,
    "end": 34.682,
    "duration": 4.043
  },
  {
    "id": 8,
    "text": "第一，采用单人传奇串联、百川入海的链条式结构推进全篇。",
    "start": 35.273,
    "end": 40.414,
    "duration": 5.141
  },
  {
    "id": 9,
    "text": "《水浒传》在前七十回创造性地采用了连环钩锁、百川入海式的单线纵向结构。",
    "start": 41.246,
    "end": 47.467,
    "duration": 6.221
  },
  {
    "id": 10,
    "text": "作者往往集中数回专写一位或一组好汉的独立传奇，",
    "start": 48.014,
    "end": 52.185,
    "duration": 4.171
  },
  {
    "id": 11,
    "text": "如鲁智深大闹野猪林、林冲风雪山神庙、杨志卖刀、武松景阳冈打虎等，",
    "start": 52.829,
    "end": 58.751,
    "duration": 5.922
  },
  {
    "id": 12,
    "text": "待该英雄被逼投奔梁山时，顺势引出下一位好汉的命运，而前人退居次席。",
    "start": 59.027,
    "end": 65.095,
    "duration": 6.068
  },
  {
    "id": 13,
    "text": "这种链条式结构兼顾了单篇传奇的紧凑曲折与长篇聚义的宏阔气势，",
    "start": 65.406,
    "end": 70.955,
    "duration": 5.549
  },
  {
    "id": 14,
    "text": "宛如百川汇聚成江海，生动再现了起义队伍由点及面的汇聚历程。",
    "start": 71.119,
    "end": 76.896,
    "duration": 5.777
  },
  {
    "id": 15,
    "text": "第二，注重性格的流动性与层次性，塑造林冲这一发展型典型形象。",
    "start": 77.579,
    "end": 83.523,
    "duration": 5.944
  },
  {
    "id": 16,
    "text": "在人物塑造上，《水浒传》摆脱了传统说书人物性格静态定型的局限，",
    "start": 83.992,
    "end": 89.187,
    "duration": 5.195
  },
  {
    "id": 17,
    "text": "写出人物性格在环境逼迫下的发展变化，其中“豹子头林冲”最具代表性。",
    "start": 89.375,
    "end": 95.423,
    "duration": 6.048
  },
  {
    "id": 18,
    "text": "身为八十万禁军教头，林冲原是安于现状、委曲求全的中下级军官：",
    "start": 95.884,
    "end": 101.598,
    "duration": 5.714
  },
  {
    "id": 19,
    "text": "高衙内调戏其妻时，他因怕得罪上司而强忍退让；",
    "start": 102.257,
    "end": 106.389,
    "duration": 4.132
  },
  {
    "id": 20,
    "text": "误入白虎堂、发配沧州及野猪林遇险，他仍抱有“重见天日”的幻想；",
    "start": 106.662,
    "end": 111.933,
    "duration": 5.271
  },
  {
    "id": 21,
    "text": "直到草料场起火，在山神庙中偷听到陆谦等人置其于死地的密谋，",
    "start": 112.403,
    "end": 117.602,
    "duration": 5.199
  },
  {
    "id": 22,
    "text": "林冲的幻想破灭，遂挺枪杀仇、雪夜上梁山。",
    "start": 117.986,
    "end": 122.074,
    "duration": 4.088
  },
  {
    "id": 23,
    "text": "这一从隐忍妥协到决然反抗的性格转变，深刻写出了“逼上梁山”的必然逻辑。",
    "start": 122.381,
    "end": 128.558,
    "duration": 6.177
  },
  {
    "id": 24,
    "text": "第三，于相似情节中刻画同而不同的群像个性，犯中求避。",
    "start": 129.162,
    "end": 134.187,
    "duration": 5.025
  },
  {
    "id": 25,
    "text": "施耐庵善于在相似冲突中写活人物性格之异，",
    "start": 134.547,
    "end": 138.158,
    "duration": 3.611
  },
  {
    "id": 26,
    "text": "金圣叹在《读第五才子书法》中盛赞其“把一百八个人性格都写出来”。",
    "start": 138.436,
    "end": 143.687,
    "duration": 5.251
  },
  {
    "id": 27,
    "text": "以打虎为例，武松景阳冈打虎写出了醉酒后的神勇与紧要关头的机敏沉着，",
    "start": 144.209,
    "end": 149.938,
    "duration": 5.729
  },
  {
    "id": 28,
    "text": "李逵沂岭杀四虎则纯凭蛮力直扑，充溢着为母复仇的狂暴悲愤；",
    "start": 150.199,
    "end": 155.92,
    "duration": 5.721
  },
  {
    "id": 29,
    "text": "同为粗豪侠义，鲁智深粗中有细、仗义疏财，李逵却率真莽撞、不顾法度。",
    "start": 156.195,
    "end": 162.736,
    "duration": 6.541
  },
  {
    "id": 30,
    "text": "这种“同而不同”的对比刻画，使水浒群像鲜明立体、跃然纸上。",
    "start": 162.931,
    "end": 167.645,
    "duration": 4.714
  },
  {
    "id": 31,
    "text": "第四，纯熟运用古代白话语体，以个性化对话与传神动作写景状物。",
    "start": 168.266,
    "end": 174.356,
    "duration": 6.09
  },
  {
    "id": 32,
    "text": "《水浒传》突破了文言史传与半文半白旧体的束缚，",
    "start": 174.487,
    "end": 178.227,
    "duration": 3.74
  },
  {
    "id": 33,
    "text": "在北方民间口语基础上提炼出洗练明快的文学白话。",
    "start": 178.386,
    "end": 182.68,
    "duration": 4.294
  },
  {
    "id": 34,
    "text": "全书人物对话切合身份个性，做到“一样人，便还他一样说话”；",
    "start": 182.831,
    "end": 187.847,
    "duration": 5.016
  },
  {
    "id": 35,
    "text": "写景状物亦字字传神，如第十回“那雪正下得紧”的氛围烘托，",
    "start": 188.1,
    "end": 193.718,
    "duration": 5.618
  },
  {
    "id": 36,
    "text": "以及林冲在山神庙内先搬大石靠住庙门、听明阴谋后推石拽门、挺起花枪与拔刀杀敌等连续动作白描，",
    "start": 194.093,
    "end": 203.185,
    "duration": 9.092
  },
  {
    "id": 37,
    "text": "精准有力，标志着中国古代白话长篇小说语言艺术的成熟。",
    "start": 203.387,
    "end": 208.426,
    "duration": 5.039
  },
  {
    "id": 38,
    "text": "合而观之，《水浒传》借单人传奇串联起百川归海的链条式结构，",
    "start": 208.578,
    "end": 214.323,
    "duration": 5.745
  },
  {
    "id": 39,
    "text": "于林冲等人物性格由隐忍到反抗的动态演变中，揭示了“官逼民反”的时代必然。",
    "start": 214.734,
    "end": 221.323,
    "duration": 6.589
  },
  {
    "id": 40,
    "text": "作者擅长在相似事件中求同存异，并以传神准确的古代白话口语与细节白描刻画人物神态，",
    "start": 221.787,
    "end": 229.777,
    "duration": 7.99
  },
  {
    "id": 41,
    "text": "标志着中国古代白话英雄传奇小说艺术的全面成熟。",
    "start": 230.11,
    "end": 234.302,
    "duration": 4.192
  }
]