[
  {
    "id": "sent_1",
    "text": "《水浒传》 是中国文学史上第一部全面描写农民起义的长篇白话章回小说，",
    "start": 0.0,
    "end": 5.6,
    "duration": 5.6
  },
  {
    "id": "sent_2",
    "text": "开创了中国古典英雄传奇小说的叙事高峰。",
    "start": 6.049,
    "end": 9.249,
    "duration": 3.2
  },
  {
    "id": "sent_3",
    "text": "面对北宋末年黑暗腐朽的封建统治与阶级矛盾激化，",
    "start": 9.699,
    "end": 14.259,
    "duration": 4.56
  },
  {
    "id": "sent_4",
    "text": "施耐庵吸纳宋元水浒话本与戏曲养分，",
    "start": 14.789,
    "end": 17.989,
    "duration": 3.2
  },
  {
    "id": "sent_5",
    "text": "以宏伟的艺术笔触深刻揭示了 “官逼民反，",
    "start": 18.439,
    "end": 21.479,
    "duration": 3.04
  },
  {
    "id": "sent_6",
    "text": "乱自上作” 的深刻历史必然性。",
    "start": 21.929,
    "end": 24.209,
    "duration": 2.28
  },
  {
    "id": "sent_7",
    "text": "金圣叹评其 “文章不避重复，而自不重复”，",
    "start": 24.739,
    "end": 28.139,
    "duration": 3.4
  },
  {
    "id": "sent_8",
    "text": "对其叙事与人物塑造推崇备至。",
    "start": 28.669,
    "end": 31.069,
    "duration": 2.4
  },
  {
    "id": "sent_9",
    "text": "其叙事结构特征与林冲人物形象塑造，",
    "start": 31.519,
    "end": 34.639,
    "duration": 3.12
  },
  {
    "id": "sent_10",
    "text": "主要展现为以下四个核心维度：",
    "start": 35.089,
    "end": 37.609,
    "duration": 2.52
  },
  {
    "id": "sent_11",
    "text": "第一，",
    "start": 38.059,
    "end": 43.939,
    "duration": 5.88
  },
  {
    "id": "sent_12",
    "text": "开创由单人传奇串联走向群体聚合的链条式单线演进叙事结构。",
    "start": 44.389,
    "end": 49.269,
    "duration": 4.88
  },
  {
    "id": "sent_13",
    "text": "《水浒传》 在前七十回的架构上，创造性地打破了全景网状模式，",
    "start": 49.719,
    "end": 51.879,
    "duration": 2.16
  },
  {
    "id": "sent_14",
    "text": "采用了 “链条式” 的递进结构。",
    "start": 52.329,
    "end": 57.369,
    "duration": 5.04
  },
  {
    "id": "sent_15",
    "text": "作者往往以一个英雄人物为叙事焦点，详细展开其受屈被害、",
    "start": 57.819,
    "end": 63.539,
    "duration": 5.72
  },
  {
    "id": "sent_16",
    "text": "奋起反抗的完整独立传奇（如鲁智深大闹野猪林、林冲风雪山神庙、",
    "start": 63.989,
    "end": 67.789,
    "duration": 3.8
  },
  {
    "id": "sent_17",
    "text": "杨志卖刀、武松景阳冈打虎与醉打蒋门神）；",
    "start": 68.239,
    "end": 73.479,
    "duration": 5.24
  },
  {
    "id": "sent_18",
    "text": "当该英雄被逼入绝境逼上梁山时，又顺势带出下一位好汉的命运。",
    "start": 73.929,
    "end": 77.449,
    "duration": 3.52
  },
  {
    "id": "sent_19",
    "text": "这种如同链环互扣的单人传奇推进方式，",
    "start": 77.899,
    "end": 81.139,
    "duration": 3.24
  },
  {
    "id": "sent_20",
    "text": "使小说情节既具短篇传奇的引人入胜，",
    "start": 81.589,
    "end": 85.749,
    "duration": 4.16
  },
  {
    "id": "sent_21",
    "text": "又如百川归海般汇聚为梁山泊大聚义的壮阔史诗，",
    "start": 86.199,
    "end": 89.839,
    "duration": 3.64
  },
  {
    "id": "sent_22",
    "text": "生动再现了起义力量由点到面的历史汇聚过程。",
    "start": 90.289,
    "end": 96.249,
    "duration": 5.96
  },
  {
    "id": "sent_23",
    "text": "第二，",
    "start": 96.699,
    "end": 97.899,
    "duration": 1.2
  },
  {
    "id": "sent_24",
    "text": "以精微心理与行动细节塑造具有深刻发展性的性格典型（以林冲为例）。",
    "start": 98.349,
    "end": 102.429,
    "duration": 4.08
  },
  {
    "id": "sent_25",
    "text": "在人物塑造上，",
    "start": 102.879,
    "end": 107.319,
    "duration": 4.44
  },
  {
    "id": "sent_26",
    "text": "《水浒传》 摆脱了传统说书人物性格固定扁平的缺陷，",
    "start": 107.769,
    "end": 110.449,
    "duration": 2.68
  },
  {
    "id": "sent_27",
    "text": "塑造出具有复杂心理演变与鲜明发展轨迹的典型性格。",
    "start": 110.899,
    "end": 116.299,
    "duration": 5.4
  },
  {
    "id": "sent_28",
    "text": "其中 “豹子头林冲” 的塑造堪称绝笔：",
    "start": 116.749,
    "end": 120.629,
    "duration": 3.88
  },
  {
    "id": "sent_29",
    "text": "作为东京八十万禁军教头，林冲本属封建统治体制内的既得利益者。",
    "start": 121.079,
    "end": 125.039,
    "duration": 3.96
  },
  {
    "id": "sent_30",
    "text": "在遭到高衙内调戏妻子、被陷害误入白虎堂后，",
    "start": 125.489,
    "end": 130.209,
    "duration": 4.72
  },
  {
    "id": "sent_31",
    "text": "他首先表现出的是屈从隐忍、息事宁人的妥协心理；",
    "start": 130.659,
    "end": 132.059,
    "duration": 1.4
  },
  {
    "id": "sent_32",
    "text": "在刺配沧州路上，董超、薛霸以沸水烫脚、野猪林行刺，",
    "start": 132.509,
    "end": 138.029,
    "duration": 5.52
  },
  {
    "id": "sent_33",
    "text": "他依然委曲求全；",
    "start": 138.479,
    "end": 143.559,
    "duration": 5.08
  },
  {
    "id": "sent_34",
    "text": "直到草料场被点燃，在山神庙前偷听到陆谦等人置其于死地的密谋，",
    "start": 144.009,
    "end": 147.249,
    "duration": 3.24
  },
  {
    "id": "sent_35",
    "text": "林冲对体制的幻想才彻底破灭，愤而手刃仇敌、风雪上梁山。",
    "start": 147.699,
    "end": 150.699,
    "duration": 3.0
  },
  {
    "id": "sent_36",
    "text": "这种由隐忍委曲到彻底反叛的性格蜕变，",
    "start": 151.149,
    "end": 156.349,
    "duration": 5.2
  },
  {
    "id": "sent_37",
    "text": "深刻揭示了“逼上梁山”的历史必然规律。",
    "start": 156.799,
    "end": 159.719,
    "duration": 2.92
  },
  {
    "id": "sent_38",
    "text": "第三，长于在极其相似的生活情节中展现绝不雷同的个性化风貌。",
    "start": 160.169,
    "end": 162.689,
    "duration": 2.52
  },
  {
    "id": "sent_39",
    "text": "施耐庵具备极其出色的艺术提炼功力，",
    "start": 163.139,
    "end": 166.819,
    "duration": 3.68
  },
  {
    "id": "sent_40",
    "text": "善于在同类题材中刻画人物之异。",
    "start": 167.349,
    "end": 171.349,
    "duration": 4.0
  },
  {
    "id": "sent_41",
    "text": "金圣叹盛赞其写一百零八人，直是一百零八样。",
    "start": 171.799,
    "end": 174.239,
    "duration": 2.44
  },
  {
    "id": "sent_42",
    "text": "以打虎为例，李逵在沂岭杀四虎，纯用蛮力直扑，",
    "start": 174.689,
    "end": 180.049,
    "duration": 5.36
  },
  {
    "id": "sent_43",
    "text": "充溢着为母报仇的狂暴与悲切；",
    "start": 180.499,
    "end": 186.059,
    "duration": 5.56
  },
  {
    "id": "sent_44",
    "text": "武松在景阳冈打虎，则兼备酒后豪气与惊险格斗中的机敏沉着。",
    "start": 186.589,
    "end": 190.549,
    "duration": 3.96
  },
  {
    "id": "sent_45",
    "text": "同样是鲁莽粗豪，鲁智深粗中有细、见义勇为，具有佛家慈悲怀抱；",
    "start": 190.999,
    "end": 196.799,
    "duration": 5.8
  },
  {
    "id": "sent_46",
    "text": "李逵则赤诚天真而滥杀无辜，充满原始破坏力。",
    "start": 197.248,
    "end": 201.048,
    "duration": 3.8
  },
  {
    "id": "sent_47",
    "text": "这种对人性幽微同异的精准把握，使水浒群像鲜活生动、历久弥新。",
    "start": 201.498,
    "end": 203.818,
    "duration": 2.32
  },
  {
    "id": "sent_48",
    "text": "第四，创造出成熟生动的古代白话小说语言，",
    "start": 204.268,
    "end": 207.428,
    "duration": 3.16
  },
  {
    "id": "sent_49",
    "text": "确立通俗叙事的纯正文风。",
    "start": 207.878,
    "end": 211.558,
    "duration": 3.68
  },
  {
    "id": "sent_50",
    "text": "《水浒传》 在语言运用上实现了划时代的突破。",
    "start": 212.008,
    "end": 216.368,
    "duration": 4.36
  },
  {
    "id": "sent_51",
    "text": "它彻底摆脱了文言史传文与骈俪浮词的束缚，",
    "start": 216.818,
    "end": 220.658,
    "duration": 3.84
  },
  {
    "id": "sent_52",
    "text": "以宋元明成熟的北方白话口语为基础，经过艺术提炼，",
    "start": 221.108,
    "end": 226.268,
    "duration": 5.16
  },
  {
    "id": "sent_53",
    "text": "创造出极其洗练、明快、生动的通俗叙事母语。",
    "start": 226.718,
    "end": 230.638,
    "duration": 3.92
  },
  {
    "id": "sent_54",
    "text": "书中人物对话完全符合其身份、阶层与个性，“其言如出其口”；",
    "start": 231.088,
    "end": 235.808,
    "duration": 4.72
  },
  {
    "id": "sent_55",
    "text": "在描写风雪、打斗等场面时，动词运用精练准确，",
    "start": 236.258,
    "end": 240.778,
    "duration": 4.52
  }
]