[
  {
    "id": 1,
    "text": "试论《水浒传》的叙事结构与林冲人物塑造。",
    "start": 0.28,
    "end": 3.72,
    "duration": 3.44
  },
  {
    "id": 2,
    "text": "《水浒传》是中国文学史上第一部全面描写农民起义的长篇白话章回小说，",
    "start": 4.24,
    "end": 10.188,
    "duration": 5.948
  },
  {
    "id": 3,
    "text": "开创了古典英雄传奇小说的创作高峰。",
    "start": 10.558,
    "end": 13.73,
    "duration": 3.172
  },
  {
    "id": 4,
    "text": "面对封建社会黑暗腐朽的政治现实，施耐庵熔裁宋元水浒话本与戏曲养分，",
    "start": 14.25,
    "end": 20.86,
    "duration": 6.61
  },
  {
    "id": 5,
    "text": "以宏阔笔墨揭示了“官逼民反，乱自上作”的历史必然。",
    "start": 21.23,
    "end": 25.63,
    "duration": 4.4
  },
  {
    "id": 6,
    "text": "金圣叹评其“文章不避重复，而自不重复”，对其结构与写人艺术推重备至。",
    "start": 26.15,
    "end": 32.39,
    "duration": 6.24
  },
  {
    "id": 7,
    "text": "其叙事结构与林冲形象塑造，主要体现在以下四个方面：",
    "start": 32.91,
    "end": 37.15,
    "duration": 4.24
  },
  {
    "id": 8,
    "text": "第一，采用单人传奇串联、百川入海的链条式结构推进全篇。",
    "start": 37.52,
    "end": 42.32,
    "duration": 4.8
  },
  {
    "id": 9,
    "text": "《水浒传》在前七十回创造性地采用了连环钩锁、百川入海式的单线纵向结构。",
    "start": 42.84,
    "end": 49.8,
    "duration": 6.96
  },
  {
    "id": 10,
    "text": "作者往往集中数回专写一位或一组好汉的独立传奇，",
    "start": 50.32,
    "end": 54.64,
    "duration": 4.32
  },
  {
    "id": 11,
    "text": "如鲁智深大闹野猪林、林冲风雪山神庙、杨志卖刀、武松景阳冈打虎等，",
    "start": 55.01,
    "end": 60.85,
    "duration": 5.84
  },
  {
    "id": 12,
    "text": "待该英雄被逼投奔梁山时，顺势引出下一位好汉的命运，而前人退居次席。",
    "start": 61.22,
    "end": 66.9,
    "duration": 5.68
  },
  {
    "id": 13,
    "text": "这种链条式结构兼顾了单篇传奇的紧凑曲折与长篇聚义的宏阔气势，",
    "start": 67.464,
    "end": 73.27,
    "duration": 5.806
  },
  {
    "id": 14,
    "text": "宛如百川汇聚成江海，生动再现了起义队伍由点及面的汇聚历程。",
    "start": 73.64,
    "end": 79.32,
    "duration": 5.68
  },
  {
    "id": 15,
    "text": "第二，注重性格的流动性与层次性，塑造林冲这一发展型典型形象。",
    "start": 79.84,
    "end": 85.52,
    "duration": 5.68
  },
  {
    "id": 16,
    "text": "在人物塑造上，《水浒传》摆脱了传统说书人物性格静态定型的局限，",
    "start": 86.04,
    "end": 91.24,
    "duration": 5.2
  },
  {
    "id": 17,
    "text": "写出人物性格在环境逼迫下的发展变化，其中“豹子头林冲”最具代表性。",
    "start": 91.61,
    "end": 96.97,
    "duration": 5.36
  },
  {
    "id": 18,
    "text": "身为八十万禁军教头，林冲原是安于现状、委曲求全的中下级军官：",
    "start": 97.519,
    "end": 103.57,
    "duration": 6.051
  },
  {
    "id": 19,
    "text": "高衙内调戏其妻时，他因怕得罪上司而强忍退让；",
    "start": 103.94,
    "end": 108.58,
    "duration": 4.64
  },
  {
    "id": 20,
    "text": "误入白虎堂、发配沧州及野猪林遇险，他仍抱有“重见天日”的幻想；",
    "start": 109.1,
    "end": 113.9,
    "duration": 4.8
  },
  {
    "id": 21,
    "text": "直到草料场起火，在山神庙中偷听到陆谦等人置其于死地的密谋，",
    "start": 114.42,
    "end": 119.86,
    "duration": 5.44
  },
  {
    "id": 22,
    "text": "林冲的幻想破灭，遂挺枪杀仇、雪夜上梁山。",
    "start": 120.26,
    "end": 124.18,
    "duration": 3.92
  },
  {
    "id": 23,
    "text": "这一从隐忍妥协到决然反抗的性格转变，深刻写出了“逼上梁山”的必然逻辑。",
    "start": 124.7,
    "end": 131.26,
    "duration": 6.56
  },
  {
    "id": 24,
    "text": "第三，于相似情节中刻画同而不同的群像个性，犯中求避。",
    "start": 131.78,
    "end": 136.555,
    "duration": 4.775
  },
  {
    "id": 25,
    "text": "施耐庵善于在相似冲突中写活人物性格之异，",
    "start": 137.055,
    "end": 140.86,
    "duration": 3.805
  },
  {
    "id": 26,
    "text": "金圣叹在《读第五才子书法》中盛赞其“把一百八个人性格都写出来”。",
    "start": 141.23,
    "end": 146.99,
    "duration": 5.76
  },
  {
    "id": 27,
    "text": "以打虎为例，武松景阳冈打虎写出了醉酒后的神勇与紧要关头的机敏沉着，",
    "start": 147.51,
    "end": 153.35,
    "duration": 5.84
  },
  {
    "id": 28,
    "text": "李逵沂岭杀四虎则纯凭蛮力直扑，充溢着为母复仇的狂暴悲愤；",
    "start": 153.72,
    "end": 159.32,
    "duration": 5.6
  },
  {
    "id": 29,
    "text": "同为粗豪侠义，鲁智深粗中有细、仗义疏财，李逵却率真莽撞、不顾法度。",
    "start": 159.84,
    "end": 166.56,
    "duration": 6.72
  },
  {
    "id": 30,
    "text": "这种“同而不同”的对比刻画，使水浒群像鲜明立体、跃然纸上。",
    "start": 167.125,
    "end": 172.12,
    "duration": 4.995
  },
  {
    "id": 31,
    "text": "第四，纯熟运用古代白话语体，以个性化对话与传神动作写景状物。",
    "start": 172.64,
    "end": 178.88,
    "duration": 6.24
  },
  {
    "id": 32,
    "text": "《水浒传》突破了文言史传与半文半白旧体的束缚，",
    "start": 179.4,
    "end": 183.286,
    "duration": 3.886
  },
  {
    "id": 33,
    "text": "在北方民间口语基础上提炼出洗练明快的文学白话。",
    "start": 183.656,
    "end": 187.93,
    "duration": 4.274
  },
  {
    "id": 34,
    "text": "全书人物对话切合身份个性，做到“一样人，便还他一样说话”；",
    "start": 188.45,
    "end": 193.556,
    "duration": 5.106
  },
  {
    "id": 35,
    "text": "写景状物亦字字传神，如第十回“那雪正下得紧”的氛围烘托，",
    "start": 194.056,
    "end": 199.69,
    "duration": 5.634
  },
  {
    "id": 36,
    "text": "以及林冲在山神庙内先搬大石靠住庙门、听明阴谋后推石拽门、挺起花枪与拔刀杀敌等连续动作白描，",
    "start": 200.06,
    "end": 208.86,
    "duration": 8.8
  },
  {
    "id": 37,
    "text": "精准有力，标志着中国古代白话长篇小说语言艺术的成熟。",
    "start": 209.23,
    "end": 213.79,
    "duration": 4.56
  },
  {
    "id": 38,
    "text": "合而观之，《水浒传》借单人传奇串联起百川归海的链条式结构，",
    "start": 214.31,
    "end": 220.23,
    "duration": 5.92
  },
  {
    "id": 39,
    "text": "于林冲等人物性格由隐忍到反抗的动态演变中，揭示了“官逼民反”的时代必然。",
    "start": 220.63,
    "end": 227.03,
    "duration": 6.4
  },
  {
    "id": 40,
    "text": "作者擅长在相似事件中求同存异，并以传神准确的古代白话口语与细节白描刻画人物神态，",
    "start": 227.55,
    "end": 235.47,
    "duration": 7.92
  },
  {
    "id": 41,
    "text": "标志着中国古代白话英雄传奇小说艺术的全面成熟。",
    "start": 235.84,
    "end": 240.48,
    "duration": 4.64
  }
]
