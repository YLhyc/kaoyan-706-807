[
  {
    "id": 1,
    "text": "试论《水浒传》的叙事结构与林冲人物塑造。",
    "start": 0.086,
    "end": 3.562,
    "duration": 3.476
  },
  {
    "id": 2,
    "text": "《水浒传》 是中国文学史上第一部全面描写农民起义的长篇白话章回小说，",
    "start": 3.818,
    "end": 9.911,
    "duration": 6.093
  },
  {
    "id": 3,
    "text": "开创了中国古典英雄传奇小说的叙事高峰。",
    "start": 10.011,
    "end": 13.274,
    "duration": 3.263
  },
  {
    "id": 4,
    "text": "面对北宋末年黑暗腐朽的封建统治与阶级矛盾激化，",
    "start": 13.384,
    "end": 17.506,
    "duration": 4.122
  },
  {
    "id": 5,
    "text": "施耐庵吸纳宋元水浒话本与戏曲养分，",
    "start": 17.743,
    "end": 20.998,
    "duration": 3.255
  },
  {
    "id": 6,
    "text": "以宏伟的艺术笔触深刻揭示了 “官逼民反，",
    "start": 21.116,
    "end": 24.59,
    "duration": 3.474
  },
  {
    "id": 7,
    "text": "乱自上作” 的深刻历史必然性。",
    "start": 24.652,
    "end": 26.95,
    "duration": 2.298
  },
  {
    "id": 8,
    "text": "金圣叹评其 “文章不避重复，而自不重复”，",
    "start": 27.139,
    "end": 31.027,
    "duration": 3.888
  },
  {
    "id": 9,
    "text": "对其叙事与人物塑造推崇备至。",
    "start": 31.424,
    "end": 34.528,
    "duration": 3.104
  },
  {
    "id": 10,
    "text": "其叙事结构特征与林冲人物形象塑造，",
    "start": 34.572,
    "end": 37.697,
    "duration": 3.125
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：第一，",
    "start": 37.768,
    "end": 40.935,
    "duration": 3.167
  },
  {
    "id": 12,
    "text": "开创由单人传奇串联走向群体聚合的链条式单线演进叙事结构。",
    "start": 41.317,
    "end": 47.989,
    "duration": 6.672
  },
  {
    "id": 13,
    "text": "《水浒传》 在前七十回的架构上，",
    "start": 48.065,
    "end": 50.282,
    "duration": 2.217
  },
  {
    "id": 14,
    "text": "创造性地打破了全景网状模式，",
    "start": 50.282,
    "end": 52.972,
    "duration": 2.69
  },
  {
    "id": 15,
    "text": "采用了 “链条式” 的递进结构。",
    "start": 53.252,
    "end": 55.238,
    "duration": 1.986
  },
  {
    "id": 16,
    "text": "作者往往以一个英雄人物为叙事焦点，详细展开其受屈被害、",
    "start": 55.468,
    "end": 60.69,
    "duration": 5.222
  },
  {
    "id": 17,
    "text": "奋起反抗的完整独立传奇（如鲁智深大闹野猪林、",
    "start": 60.816,
    "end": 65.085,
    "duration": 4.269
  },
  {
    "id": 18,
    "text": "林冲风雪山神庙、杨志卖刀、武松景阳冈打虎与醉打蒋门神）；",
    "start": 65.164,
    "end": 70.267,
    "duration": 5.103
  },
  {
    "id": 19,
    "text": "当该英雄被逼入绝境逼上梁山时，",
    "start": 70.356,
    "end": 72.773,
    "duration": 2.417
  },
  {
    "id": 20,
    "text": "又顺势带出下一位好汉的命运。",
    "start": 72.813,
    "end": 75.042,
    "duration": 2.229
  },
  {
    "id": 21,
    "text": "这种如同链环互扣的单人传奇推进方式，",
    "start": 75.289,
    "end": 78.496,
    "duration": 3.207
  },
  {
    "id": 22,
    "text": "使小说情节既具短篇传奇的引人入胜，",
    "start": 78.812,
    "end": 81.824,
    "duration": 3.012
  },
  {
    "id": 23,
    "text": "又如百川归海般汇聚为梁山泊大聚义的壮阔史诗，",
    "start": 82.313,
    "end": 86.451,
    "duration": 4.138
  },
  {
    "id": 24,
    "text": "生动再现了起义力量由点到面的历史汇聚过程。第二，",
    "start": 86.936,
    "end": 91.824,
    "duration": 4.888
  },
  {
    "id": 25,
    "text": "以精微心理与行动细节塑造具有深刻发展性的性格典型（以林冲为例）。",
    "start": 91.956,
    "end": 97.936,
    "duration": 5.98
  },
  {
    "id": 26,
    "text": "在人物塑造上，",
    "start": 98.183,
    "end": 99.393,
    "duration": 1.21
  },
  {
    "id": 27,
    "text": "《水浒传》 摆脱了传统说书人物性格固定扁平的缺陷，",
    "start": 99.701,
    "end": 104.241,
    "duration": 4.54
  },
  {
    "id": 28,
    "text": "塑造出具有复杂心理演变与鲜明发展轨迹的典型性格。",
    "start": 104.318,
    "end": 109.424,
    "duration": 5.106
  },
  {
    "id": 29,
    "text": "其中 “豹子头林冲” 的塑造堪称绝笔：",
    "start": 109.508,
    "end": 112.216,
    "duration": 2.708
  },
  {
    "id": 30,
    "text": "作为东京八十万禁军教头，",
    "start": 112.505,
    "end": 114.608,
    "duration": 2.103
  },
  {
    "id": 31,
    "text": "林冲本属封建统治体制内的既得利益者。",
    "start": 115.021,
    "end": 117.996,
    "duration": 2.975
  },
  {
    "id": 32,
    "text": "在遭到高衙内调戏妻子、被陷害误入白虎堂后，",
    "start": 118.183,
    "end": 121.829,
    "duration": 3.646
  },
  {
    "id": 33,
    "text": "他首先表现出的是屈从隐忍、息事宁人的妥协心理；",
    "start": 122.127,
    "end": 126.334,
    "duration": 4.207
  },
  {
    "id": 34,
    "text": "在刺配沧州路上，董超、薛霸以沸水烫脚、野猪林行刺，",
    "start": 126.479,
    "end": 131.469,
    "duration": 4.99
  },
  {
    "id": 35,
    "text": "他依然委曲求全；直到草料场被点燃，",
    "start": 131.644,
    "end": 134.805,
    "duration": 3.161
  },
  {
    "id": 36,
    "text": "在山神庙前偷听到陆谦等人置其于死地的密谋，",
    "start": 135.0,
    "end": 139.012,
    "duration": 4.012
  },
  {
    "id": 37,
    "text": "林冲对体制的幻想才彻底破灭，愤而手刃仇敌、风雪上梁山。",
    "start": 139.292,
    "end": 144.431,
    "duration": 5.139
  },
  {
    "id": 38,
    "text": "这种由隐忍委曲到彻底反叛的性格蜕变，",
    "start": 144.659,
    "end": 147.803,
    "duration": 3.144
  },
  {
    "id": 39,
    "text": "深刻揭示了“逼上梁山”的历史必然规律。",
    "start": 148.008,
    "end": 150.965,
    "duration": 2.957
  },
  {
    "id": 40,
    "text": "第三，长于在极其相似的生活情节中展现绝不雷同的个性化风貌。",
    "start": 151.203,
    "end": 156.592,
    "duration": 5.389
  },
  {
    "id": 41,
    "text": "施耐庵具备极其出色的艺术提炼功力，",
    "start": 156.95,
    "end": 159.598,
    "duration": 2.648
  },
  {
    "id": 42,
    "text": "善于在同类题材中刻画人物之异。",
    "start": 159.814,
    "end": 162.348,
    "duration": 2.534
  },
  {
    "id": 43,
    "text": "金圣叹盛赞其写一百零八人，直是一百零八样。",
    "start": 162.615,
    "end": 165.997,
    "duration": 3.382
  },
  {
    "id": 44,
    "text": "以打虎为例，李逵在沂岭杀四虎，纯用蛮力直扑，",
    "start": 166.248,
    "end": 170.118,
    "duration": 3.87
  },
  {
    "id": 45,
    "text": "充溢着为母报仇的狂暴与悲切；武松在景阳冈打虎，",
    "start": 170.354,
    "end": 174.489,
    "duration": 4.135
  },
  {
    "id": 46,
    "text": "则兼备酒后豪气与惊险格斗中的机敏沉着。",
    "start": 174.606,
    "end": 178.574,
    "duration": 3.968
  },
  {
    "id": 47,
    "text": "同样是鲁莽粗豪，鲁智深粗中有细、见义勇为，",
    "start": 178.843,
    "end": 182.847,
    "duration": 4.004
  },
  {
    "id": 48,
    "text": "具有佛家慈悲怀抱；李逵则赤诚天真而滥杀无辜，",
    "start": 182.963,
    "end": 187.487,
    "duration": 4.524
  },
  {
    "id": 49,
    "text": "充满原始破坏力。",
    "start": 187.671,
    "end": 188.974,
    "duration": 1.303
  },
  {
    "id": 50,
    "text": "这种对人性幽微同异的精准把握，使水浒群像鲜活生动、历久弥新。",
    "start": 189.159,
    "end": 194.934,
    "duration": 5.775
  },
  {
    "id": 51,
    "text": "第四，创造出成熟生动的古代白话小说语言，",
    "start": 195.123,
    "end": 199.554,
    "duration": 4.431
  },
  {
    "id": 52,
    "text": "确立通俗叙事的纯正文风。",
    "start": 199.613,
    "end": 201.585,
    "duration": 1.972
  },
  {
    "id": 53,
    "text": "《水浒传》 在语言运用上实现了划时代的突破。",
    "start": 201.868,
    "end": 205.238,
    "duration": 3.37
  },
  {
    "id": 54,
    "text": "它彻底摆脱了文言史传文与骈俪浮词的束缚，",
    "start": 205.629,
    "end": 209.128,
    "duration": 3.499
  },
  {
    "id": 55,
    "text": "以宋元明成熟的北方白话口语为基础，经过艺术提炼，",
    "start": 209.426,
    "end": 213.614,
    "duration": 4.188
  },
  {
    "id": 56,
    "text": "创造出极其洗练、明快、生动的通俗叙事母语。",
    "start": 213.883,
    "end": 217.606,
    "duration": 3.723
  },
  {
    "id": 57,
    "text": "书中人物对话完全符合其身份、阶层与个性，",
    "start": 217.753,
    "end": 221.81,
    "duration": 4.057
  },
  {
    "id": 58,
    "text": "“其言如出其口”；在描写风雪、打斗等场面时，",
    "start": 221.876,
    "end": 225.915,
    "duration": 4.039
  },
  {
    "id": 59,
    "text": "动词运用精练准确，如林冲在山神庙用石头“把门拽开，",
    "start": 226.177,
    "end": 231.53,
    "duration": 5.353
  },
  {
    "id": 60,
    "text": "挺着朴刀”等动作描写，字字传神，",
    "start": 231.677,
    "end": 235.031,
    "duration": 3.354
  },
  {
    "id": 61,
    "text": "达到了中国古代白话小说语言艺术的极高成就。",
    "start": 235.117,
    "end": 238.68,
    "duration": 3.563
  }
]
