[
  {
    "id": 1,
    "text": "试论中国古代文学“悲秋”母题的流变与文人心态机制。",
    "start": 0.101,
    "end": 4.686,
    "duration": 4.585
  },
  {
    "id": 2,
    "text": "“悲秋”是中国古代文学史上源远流长、最具代表性的抒情母题之一。",
    "start": 5.049,
    "end": 10.208,
    "duration": 5.159
  },
  {
    "id": 3,
    "text": "自战国宋玉发出“悲哉秋之为气也”的浩叹以来，悲秋由最初的自然物候感伤，",
    "start": 10.762,
    "end": 17.232,
    "duration": 6.47
  },
  {
    "id": 4,
    "text": "逐步积淀为古代士人观照生命流逝、身世漂泊与家国兴亡的审美传统。",
    "start": 17.534,
    "end": 23.467,
    "duration": 5.933
  },
  {
    "id": 5,
    "text": "陆机《文赋》概括文人感物心态云：“遵四时以叹逝，瞻万物而思纷。悲落叶于劲秋，喜柔条于芳春。”",
    "start": 24.115,
    "end": 32.346,
    "duration": 8.231
  },
  {
    "id": 6,
    "text": "悲秋母题的千年演进与文人心态机制，主要体现在以下四个方面：",
    "start": 32.346,
    "end": 36.7,
    "duration": 4.354
  },
  {
    "id": 7,
    "text": "第一，宋玉《九辩》奠定悲秋先声，确立秋景凋零与士人失意的交织。",
    "start": 37.292,
    "end": 43.43,
    "duration": 6.138
  },
  {
    "id": 8,
    "text": "先秦《诗经》虽已有零星秋景描写，但尚未将秋气与身世悲慨定型为固定母题。",
    "start": 43.43,
    "end": 49.835,
    "duration": 6.405
  },
  {
    "id": 9,
    "text": "宋玉在《九辩》开篇高吟“悲哉秋之为气也！萧瑟兮草木摇落而变衰”，",
    "start": 50.069,
    "end": 56.038,
    "duration": 5.969
  },
  {
    "id": 10,
    "text": "第一次将深秋草木枯槁、寒风萧瑟的肃杀物候，与寒门士人“坎廪兮贫士失职而志不平”的政治失意紧密相连。",
    "start": 56.199,
    "end": 66.101,
    "duration": 9.902
  },
  {
    "id": 11,
    "text": "作者敏锐捕捉雁南游、燕辞归、霜露降等秋令意象，",
    "start": 66.428,
    "end": 71.09,
    "duration": 4.662
  },
  {
    "id": 12,
    "text": "把自身忠而见疑、抱负难伸的屈辱投射于萧瑟秋气之中，",
    "start": 71.47,
    "end": 76.189,
    "duration": 4.719
  },
  {
    "id": 13,
    "text": "由此确立了古典文学因秋起兴、以自然零落感伤生命沉沦的原型范式。",
    "start": 76.555,
    "end": 82.726,
    "duration": 6.171
  },
  {
    "id": 14,
    "text": "第二，汉魏六朝拓展悲秋内涵，注入生命短促与乱世流离之忧。",
    "start": 83.339,
    "end": 89.338,
    "duration": 5.999
  },
  {
    "id": 15,
    "text": "两汉魏晋时期，政局动荡与生命无常之感促使文人自我意识觉醒，",
    "start": 89.642,
    "end": 95.283,
    "duration": 5.641
  },
  {
    "id": 16,
    "text": "悲秋进一步深化为对青春易逝与人生飘零的感喟。",
    "start": 95.597,
    "end": 99.881,
    "duration": 4.284
  },
  {
    "id": 17,
    "text": "汉武帝《秋风辞》以“秋风起兮白云飞，草木黄落兮雁南归”生发盛极而衰的感慨，",
    "start": 100.143,
    "end": 107.74,
    "duration": 7.597
  },
  {
    "id": 18,
    "text": "发出“少壮几时兮奈老何”的叹息；",
    "start": 108.116,
    "end": 111.645,
    "duration": 3.529
  },
  {
    "id": 19,
    "text": "曹丕《燕歌行》以“秋风萧瑟天气凉，草木摇落露为霜”渲染思妇秋夜孤寂；",
    "start": 111.86,
    "end": 118.605,
    "duration": 6.745
  },
  {
    "id": 20,
    "text": "潘岳《秋兴赋》则借秋气感伤宦途蹉跎、华发早生。",
    "start": 118.86,
    "end": 123.232,
    "duration": 4.372
  },
  {
    "id": 21,
    "text": "至此，秋天成为文人感叹年华老大、离别漂泊与乱世浮沉的普遍情感寄托。",
    "start": 123.449,
    "end": 129.755,
    "duration": 6.306
  },
  {
    "id": 22,
    "text": "第三，盛唐杜甫推向诗史高峰，将一己悲秋升华为忧国忧民之沉郁悲慨。",
    "start": 130.363,
    "end": 137.115,
    "duration": 6.752
  },
  {
    "id": 23,
    "text": "悲秋母题在杜甫笔下突破了以往多偏于个人身世自怜的格局，",
    "start": 137.809,
    "end": 142.67,
    "duration": 4.861
  },
  {
    "id": 24,
    "text": "把一己飘零与安史之乱后的家国危机融为一体。",
    "start": 142.92,
    "end": 146.851,
    "duration": 3.931
  },
  {
    "id": 25,
    "text": "在七律名篇《登高》中，“无边落木萧萧下，不尽长江滚滚来”以阔大苍茫的江天秋色拓开沉雄境界；",
    "start": 147.143,
    "end": 156.125,
    "duration": 8.982
  },
  {
    "id": 26,
    "text": "颈联“万里悲秋常作客，百年多病独登台”更将万里客居、百年多病与时代多艰凝练于十四字中；",
    "start": 156.479,
    "end": 165.67,
    "duration": 9.191
  },
  {
    "id": 27,
    "text": "《秋兴八首》则借夔州秋气遥望长安，",
    "start": 166.033,
    "end": 169.05,
    "duration": 3.017
  },
  {
    "id": 28,
    "text": "把个人身世之悲、衰年之叹与国家兴衰之痛融汇一体，使悲秋达到沉郁顿挫的现实主义高峰，而中唐刘禹锡《秋词》“自古逢秋悲寂寥，我言秋日胜春朝”更以豪迈清朗反拨悲叹。",
    "start": 169.402,
    "end": 184.846,
    "duration": 8.007
  },
  {
    "id": 29,
    "text": "第四，宋代诗词转向细腻内省与哲理超脱，展现悲秋传统的审美新变。",
    "start": 185.447,
    "end": 192.031,
    "duration": 6.584
  },
  {
    "id": 30,
    "text": "入宋以后，文人对秋的体认由宏阔史诗感慨转向精细的心灵内省与理趣超越。",
    "start": 192.307,
    "end": 199.988,
    "duration": 7.681
  },
  {
    "id": 31,
    "text": "柳永《八声甘州》以“对潇潇暮雨洒江天，一番洗清秋”抒发羁旅漂泊之愁；",
    "start": 200.218,
    "end": 207.125,
    "duration": 6.907
  },
  {
    "id": 32,
    "text": "辛弃疾《丑奴儿》借“却道天凉好个秋”道出饱经沧桑后欲说还休的深沉苦闷；",
    "start": 207.357,
    "end": 214.07,
    "duration": 6.713
  },
  {
    "id": 33,
    "text": "而苏轼在《赤壁赋》中于“清风徐来，水波不兴”的秋夜泛舟之际，",
    "start": 214.349,
    "end": 219.66,
    "duration": 5.311
  },
  {
    "id": 34,
    "text": "以物我“变与不变”的哲思化解万物凋零之悲，",
    "start": 220.097,
    "end": 223.764,
    "duration": 3.667
  },
  {
    "id": 35,
    "text": "此前欧阳修《秋声赋》亦从“物过盛而当杀”的自然天道体认秋声之变，共同赋予延续两千年的悲秋传统以旷达超逸的哲理智慧。",
    "start": 224.025,
    "end": 234.577,
    "duration": 4.378
  },
  {
    "id": 36,
    "text": "由此观之，中国古代悲秋母题从宋玉《九辩》草木零落之叹发端，",
    "start": 234.756,
    "end": 240.936,
    "duration": 6.18
  },
  {
    "id": 37,
    "text": "经汉魏六朝对生命流逝与乱世离索的抒写，",
    "start": 240.936,
    "end": 245.096,
    "duration": 4.16
  },
  {
    "id": 38,
    "text": "至盛唐杜甫升华为忧国忧民的沉郁悲慨，",
    "start": 245.096,
    "end": 249.296,
    "duration": 4.2
  },
  {
    "id": 39,
    "text": "再在宋代诗词赋中转向深沉内省与哲理超脱。",
    "start": 249.296,
    "end": 253.896,
    "duration": 4.6
  },
  {
    "id": 40,
    "text": "这一跨越千年的审美流变，集中映照出古代士人感物咏怀、在时间悲叹与家国担当之间寻求精神安顿的文化心态。",
    "start": 253.896,
    "end": 264.872,
    "duration": 10.976
  }
]