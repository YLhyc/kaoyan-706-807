[
  {
    "id": 1,
    "text": "试论中国古代文学“悲秋”母题的流变与文人心态机制。",
    "start": 0.134,
    "end": 4.186,
    "duration": 4.052
  },
  {
    "id": 2,
    "text": "“悲秋”是中国古代文学史上源远流长、最具代表性的抒情母题之一。",
    "start": 4.863,
    "end": 9.675,
    "duration": 4.812
  },
  {
    "id": 3,
    "text": "自战国宋玉发出“悲哉秋之为气也”的浩叹以来，悲秋由最初的自然物候感伤，",
    "start": 10.313,
    "end": 16.405,
    "duration": 6.092
  },
  {
    "id": 4,
    "text": "逐步积淀为古代士人观照生命流逝、身世漂泊与家国兴亡的审美传统。",
    "start": 16.784,
    "end": 22.596,
    "duration": 5.812
  },
  {
    "id": 5,
    "text": "陆机《文赋》概括文人感物心态云：“遵四时以叹逝，瞻万物而思纷。悲落叶于劲秋，喜柔条于芳春。”",
    "start": 23.354,
    "end": 28.406,
    "duration": 5.052
  },
  {
    "id": 6,
    "text": "悲秋母题的千年演进与文人心态机制，主要体现在以下四个方面：",
    "start": 29.124,
    "end": 31.656,
    "duration": 2.532
  },
  {
    "id": 7,
    "text": "第一，宋玉《九辩》奠定悲秋先声，确立秋景凋零与士人失意的交织。",
    "start": 32.374,
    "end": 43.266,
    "duration": 10.892
  },
  {
    "id": 8,
    "text": "先秦《诗经》虽已有零星秋景描写，但尚未将秋气与身世悲慨定型为固定母题。",
    "start": 43.944,
    "end": 50.276,
    "duration": 6.332
  },
  {
    "id": 9,
    "text": "宋玉在《九辩》开篇高吟“悲哉秋之为气也！萧瑟兮草木摇落而变衰”，",
    "start": 50.994,
    "end": 56.976,
    "duration": 5.982
  },
  {
    "id": 10,
    "text": "第一次将深秋草木枯槁、寒风萧瑟的肃杀物候，与寒门士人“坎廪兮贫士失职而志不平”的政治失意紧密相连。",
    "start": 57.355,
    "end": 66.327,
    "duration": 8.972
  },
  {
    "id": 11,
    "text": "作者敏锐捕捉雁南游、燕辞归、霜露降等秋令意象，",
    "start": 67.045,
    "end": 71.177,
    "duration": 4.132
  },
  {
    "id": 12,
    "text": "把自身忠而见疑、抱负难伸的屈辱投射于萧瑟秋气之中，",
    "start": 71.556,
    "end": 76.008,
    "duration": 4.452
  },
  {
    "id": 13,
    "text": "由此确立了古典文学因秋起兴、以自然零落感伤生命沉沦的原型范式。",
    "start": 76.387,
    "end": 81.839,
    "duration": 5.452
  },
  {
    "id": 14,
    "text": "第二，汉魏六朝拓展悲秋内涵，注入生命短促与乱世流离之忧。",
    "start": 82.517,
    "end": 87.289,
    "duration": 4.772
  },
  {
    "id": 15,
    "text": "两汉魏晋时期，政局动荡与生命无常之感促使文人自我意识觉醒，",
    "start": 88.007,
    "end": 93.139,
    "duration": 5.132
  },
  {
    "id": 16,
    "text": "悲秋进一步深化为对青春易逝与人生飘零的感喟。",
    "start": 93.567,
    "end": 97.619,
    "duration": 4.052
  },
  {
    "id": 17,
    "text": "汉武帝《秋风辞》以“秋风起兮白云飞，草木黄落兮雁南归”生发盛极而衰的感慨，",
    "start": 98.377,
    "end": 101.309,
    "duration": 2.932
  },
  {
    "id": 18,
    "text": "发出“少壮几时兮奈老何”的叹息；",
    "start": 101.688,
    "end": 103.54,
    "duration": 1.852
  },
  {
    "id": 19,
    "text": "曹丕《燕歌行》以“秋风萧瑟天气凉，草木摇落露为霜”渲染思妇秋夜孤寂；",
    "start": 104.069,
    "end": 105.921,
    "duration": 1.852
  },
  {
    "id": 20,
    "text": "潘岳《秋兴赋》则借秋气感伤宦途蹉跎、华发早生。",
    "start": 106.45,
    "end": 109.142,
    "duration": 2.692
  },
  {
    "id": 21,
    "text": "至此，秋天成为文人感叹年华老大、离别漂泊与乱世浮沉的普遍情感寄托。",
    "start": 109.82,
    "end": 126.56,
    "duration": 16.74
  },
  {
    "id": 22,
    "text": "第三，盛唐杜甫推向诗史高峰，将一己悲秋升华为忧国忧民之沉郁悲慨。",
    "start": 127.184,
    "end": 133.636,
    "duration": 6.452
  },
  {
    "id": 23,
    "text": "悲秋母题在杜甫笔下突破了以往多偏于个人身世自怜的格局，",
    "start": 134.165,
    "end": 139.137,
    "duration": 4.972
  },
  {
    "id": 24,
    "text": "把一己飘零与安史之乱后的家国危机融为一体。",
    "start": 139.516,
    "end": 143.088,
    "duration": 3.572
  },
  {
    "id": 25,
    "text": "在七律名篇《登高》中，“无边落木萧萧下，不尽长江滚滚来”以阔大苍茫的江天秋色拓开沉雄境界；",
    "start": 143.726,
    "end": 146.738,
    "duration": 3.012
  },
  {
    "id": 26,
    "text": "颈联“万里悲秋常作客，百年多病独登台”更将万里客居、百年多病与时代多艰凝练于十四字中；",
    "start": 147.267,
    "end": 151.879,
    "duration": 4.612
  },
  {
    "id": 27,
    "text": "《秋兴八首》则借夔州秋气遥望长安，",
    "start": 152.557,
    "end": 154.369,
    "duration": 1.812
  },
  {
    "id": 28,
    "text": "把个人身世之悲、衰年之叹与国家兴衰之痛融汇一体，使悲秋达到沉郁顿挫的现实主义高峰，",
    "start": 154.748,
    "end": 157.48,
    "duration": 2.732
  },
  {
    "id": 29,
    "text": "而中唐刘禹锡《秋词》“自古逢秋悲寂寥，我言秋日胜春朝”更以豪迈清朗反拨悲叹。",
    "start": 157.859,
    "end": 160.551,
    "duration": 2.692
  },
  {
    "id": 30,
    "text": "第四，宋代诗词转向细腻内省与哲理超脱，展现悲秋传统的审美新变。",
    "start": 161.269,
    "end": 178.327,
    "duration": 17.058
  },
  {
    "id": 31,
    "text": "入宋以后，文人对秋的体认由宏阔史诗感慨转向精细的心灵内省与理趣超越。",
    "start": 179.019,
    "end": 185.031,
    "duration": 6.012
  },
  {
    "id": 32,
    "text": "柳永《八声甘州》以“对潇潇暮雨洒江天，一番洗清秋”抒发羁旅漂泊之愁；",
    "start": 185.709,
    "end": 186.401,
    "duration": 0.692
  },
  {
    "id": 33,
    "text": "辛弃疾《丑奴儿》借“却道天凉好个秋”道出饱经沧桑后欲说还休的深沉苦闷；",
    "start": 186.93,
    "end": 187.862,
    "duration": 0.932
  },
  {
    "id": 34,
    "text": "而苏轼在《赤壁赋》中于“清风徐来，水波不兴”的秋夜泛舟之际，",
    "start": 188.391,
    "end": 190.323,
    "duration": 1.932
  },
  {
    "id": 35,
    "text": "以物我“变与不变”的哲思化解万物凋零之悲，",
    "start": 190.702,
    "end": 191.074,
    "duration": 0.372
  },
  {
    "id": 36,
    "text": "此前欧阳修《秋声赋》亦从“物过盛而当杀”的自然天道体认秋声之变，共同赋予延续两千年的悲秋传统以旷达超逸的哲理智慧。",
    "start": 191.453,
    "end": 193.585,
    "duration": 2.132
  },
  {
    "id": 37,
    "text": "由此观之，中国古代悲秋母题从宋玉《九辩》草木零落之叹发端，",
    "start": 194.223,
    "end": 195.475,
    "duration": 1.252
  },
  {
    "id": 38,
    "text": "经汉魏六朝对生命流逝与乱世离索的抒写，",
    "start": 195.854,
    "end": 197.346,
    "duration": 1.492
  },
  {
    "id": 39,
    "text": "至盛唐杜甫升华为忧国忧民的沉郁悲慨，",
    "start": 197.725,
    "end": 198.577,
    "duration": 0.852
  },
  {
    "id": 40,
    "text": "再在宋代诗词赋中转向深沉内省与哲理超脱。",
    "start": 198.956,
    "end": 200.488,
    "duration": 1.532
  },
  {
    "id": 41,
    "text": "这一跨越千年的审美流变，集中映照出古代士人感物咏怀、在时间悲叹与家国担当之间寻求精神安顿的文化心态。",
    "start": 201.206,
    "end": 254.397,
    "duration": 53.191
  }
]