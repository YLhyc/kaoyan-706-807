[
  {
    "id": 1,
    "text": "试论中国古代文学“悲秋”母题的流变与文人心态机制。",
    "start": 0.079,
    "end": 4.335,
    "duration": 4.256
  },
  {
    "id": 2,
    "text": "“悲秋” 是中国古代文学史上延续两千余年、",
    "start": 4.453,
    "end": 7.509,
    "duration": 3.056
  },
  {
    "id": 3,
    "text": "最具代表性的文化心理原型母题。",
    "start": 7.561,
    "end": 9.945,
    "duration": 2.384
  },
  {
    "id": 4,
    "text": "自战国末期宋玉发出 “悲哉秋之为气也” 的千古浩叹以来，",
    "start": 9.998,
    "end": 14.753,
    "duration": 4.755
  },
  {
    "id": 5,
    "text": "悲秋便由原初直观的自然物候感伤，",
    "start": 14.861,
    "end": 17.739,
    "duration": 2.878
  },
  {
    "id": 6,
    "text": "逐步沉淀为中国古代知识分子观照生命困境、",
    "start": 17.739,
    "end": 21.131,
    "duration": 3.392
  },
  {
    "id": 7,
    "text": "身世漂泊与家国兴亡的深层审美隐喻。",
    "start": 21.21,
    "end": 24.324,
    "duration": 3.114
  },
  {
    "id": 8,
    "text": "陆机在 《文赋》 中精辟总结文人感知机制为 “遵四时以叹逝，",
    "start": 24.497,
    "end": 29.612,
    "duration": 5.115
  },
  {
    "id": 9,
    "text": "瞻万物而思纷。",
    "start": 29.819,
    "end": 31.206,
    "duration": 1.387
  },
  {
    "id": 10,
    "text": "悲落叶于劲秋，喜柔条于芳春”。",
    "start": 31.704,
    "end": 34.633,
    "duration": 2.929
  },
  {
    "id": 11,
    "text": "悲秋母题的千年历史演进与文人心态机制，",
    "start": 34.839,
    "end": 38.277,
    "duration": 3.438
  },
  {
    "id": 12,
    "text": "主要展现为以下四个核心维度：",
    "start": 38.491,
    "end": 40.789,
    "duration": 2.298
  },
  {
    "id": 13,
    "text": "第一，宋玉《九辩》奠定悲秋母题先声，",
    "start": 41.414,
    "end": 44.883,
    "duration": 3.469
  },
  {
    "id": 14,
    "text": "确立自然物候凋零与士人失意的原始交织。",
    "start": 45.09,
    "end": 48.515,
    "duration": 3.425
  },
  {
    "id": 15,
    "text": "在先秦文学中，《诗经》 虽已有秋景描写，",
    "start": 48.749,
    "end": 51.797,
    "duration": 3.048
  },
  {
    "id": 16,
    "text": "但尚未将秋与深沉悲慨系统锁定。",
    "start": 52.086,
    "end": 55.093,
    "duration": 3.007
  },
  {
    "id": 17,
    "text": "宋玉在 《九辩》 开篇高唱 “悲哉秋之为气也！",
    "start": 55.413,
    "end": 58.713,
    "duration": 3.3
  },
  {
    "id": 18,
    "text": "萧瑟兮草木摇落而变衰”，第一次将深秋草木枯槁、",
    "start": 58.845,
    "end": 63.105,
    "duration": 4.26
  },
  {
    "id": 19,
    "text": "寒风萧索的自然衰败，",
    "start": 63.318,
    "end": 64.944,
    "duration": 1.626
  },
  {
    "id": 20,
    "text": "与寒门士人 “贫士失职而志不平” 的政治失意紧密咬合。",
    "start": 65.227,
    "end": 69.722,
    "duration": 4.495
  },
  {
    "id": 21,
    "text": "宋玉在诗中敏锐捕捉到燕雀南翔、霜露降落等秋令意象，",
    "start": 69.932,
    "end": 75.108,
    "duration": 5.176
  },
  {
    "id": 22,
    "text": "将自身作为楚国小臣政治抱负无法实现的屈辱，",
    "start": 75.361,
    "end": 79.291,
    "duration": 3.93
  },
  {
    "id": 23,
    "text": "投射于肃杀秋气之中，",
    "start": 79.519,
    "end": 81.613,
    "duration": 2.094
  },
  {
    "id": 24,
    "text": "从而确立了中国古典文学中自然枯落引发生命零落感伤的原型密码。",
    "start": 81.94,
    "end": 87.816,
    "duration": 5.876
  },
  {
    "id": 25,
    "text": "第二，两汉魏晋时期的深化发展，",
    "start": 88.108,
    "end": 91.015,
    "duration": 2.907
  },
  {
    "id": 26,
    "text": "注入个体生命短暂之悲与时代动荡忧思。",
    "start": 91.268,
    "end": 94.922,
    "duration": 3.654
  },
  {
    "id": 27,
    "text": "汉魏时期，",
    "start": 95.135,
    "end": 96.189,
    "duration": 1.054
  },
  {
    "id": 28,
    "text": "动乱分裂与瘟疫频发使文人的生命忧患意识急剧觉醒，",
    "start": 96.302,
    "end": 100.966,
    "duration": 4.664
  },
  {
    "id": 29,
    "text": "悲秋母题进一步泛化为对生命无常的哲思。",
    "start": 101.244,
    "end": 104.821,
    "duration": 3.577
  },
  {
    "id": 30,
    "text": "汉武帝在 《秋风辞》 中以 “秋风起兮白云飞，",
    "start": 105.06,
    "end": 108.799,
    "duration": 3.739
  },
  {
    "id": 31,
    "text": "草木黄落兮雁南归” 见盛极而衰之叹，",
    "start": 108.985,
    "end": 113.345,
    "duration": 4.36
  },
  {
    "id": 32,
    "text": "感喟 “少壮几时兮奈老何”；",
    "start": 113.494,
    "end": 115.281,
    "duration": 1.787
  },
  {
    "id": 33,
    "text": "曹丕在 《燕歌行》 中以 “秋风萧瑟天气凉，",
    "start": 115.544,
    "end": 119.135,
    "duration": 3.591
  },
  {
    "id": 34,
    "text": "草木摇落露为霜” 写尽思妇秋夜的孤绝；",
    "start": 119.25,
    "end": 122.9,
    "duration": 3.65
  },
  {
    "id": 35,
    "text": "潘岳在 《秋兴赋》 中借斑白两鬓感伤仕途蹉跎。",
    "start": 123.469,
    "end": 127.773,
    "duration": 4.304
  },
  {
    "id": 36,
    "text": "在这一时期，秋天成为了文人感悟青春逝去、",
    "start": 128.081,
    "end": 131.73,
    "duration": 3.649
  },
  {
    "id": 37,
    "text": "迟暮降临与乱世生存危机的普遍情感载体。",
    "start": 131.958,
    "end": 135.801,
    "duration": 3.843
  },
  {
    "id": 38,
    "text": "第三，盛唐杜甫实现悲秋母题的集大成，",
    "start": 136.019,
    "end": 139.425,
    "duration": 3.406
  },
  {
    "id": 39,
    "text": "升华为将个人飘零与国家兴亡融铸的诗史境界。",
    "start": 139.71,
    "end": 143.505,
    "duration": 3.795
  },
  {
    "id": 40,
    "text": "悲秋母题在唐代杜甫笔下完成了思想格局的历史性飞跃。",
    "start": 143.762,
    "end": 148.509,
    "duration": 4.747
  },
  {
    "id": 41,
    "text": "杜甫彻底打破了以往文人沉溺于个人身世哀叹的狭窄格局，",
    "start": 149.036,
    "end": 153.657,
    "duration": 4.621
  },
  {
    "id": 42,
    "text": "将悲秋与安史之乱后整个民族的心灵创伤融为一体。",
    "start": 153.931,
    "end": 158.463,
    "duration": 4.532
  },
  {
    "id": 43,
    "text": "其巅峰名作 《登高》 中，“无边落木萧萧下，",
    "start": 159.076,
    "end": 162.984,
    "duration": 3.908
  },
  {
    "id": 44,
    "text": "不尽长江滚滚来”，以阔大江天拓开雄浑境界；",
    "start": 163.231,
    "end": 167.707,
    "duration": 4.476
  },
  {
    "id": 45,
    "text": "紧接以 “万里悲秋常作客，百年多病独登台”，",
    "start": 167.925,
    "end": 171.802,
    "duration": 3.877
  },
  {
    "id": 46,
    "text": "将万里漂泊之远、百年多病之身与国家多艰之痛完美熔为一炉；",
    "start": 171.867,
    "end": 177.088,
    "duration": 5.221
  },
  {
    "id": 47,
    "text": "其七律组诗 《秋兴八首》 更借夔州清秋的阴晦云水，",
    "start": 177.355,
    "end": 181.74,
    "duration": 4.385
  },
  {
    "id": 48,
    "text": "深沉关照长安沦陷后的国家命运，",
    "start": 181.992,
    "end": 184.933,
    "duration": 2.941
  },
  {
    "id": 49,
    "text": "将悲秋推向了沉郁悲壮的现实主义巅峰。",
    "start": 184.933,
    "end": 188.248,
    "duration": 3.315
  },
  {
    "id": 50,
    "text": "第四，宋代词人的内倾化与哲理超越，",
    "start": 188.482,
    "end": 192.015,
    "duration": 3.533
  },
  {
    "id": 51,
    "text": "展现羁旅乡愁与生命释怀的双重审美向度。",
    "start": 192.276,
    "end": 196.024,
    "duration": 3.748
  },
  {
    "id": 52,
    "text": "降至宋代，",
    "start": 196.48,
    "end": 197.26,
    "duration": 0.78
  },
  {
    "id": 53,
    "text": "文人对秋天的体认由外在的史诗悲慨转向细腻的心灵内省与哲理超越。",
    "start": 197.532,
    "end": 203.724,
    "duration": 6.192
  },
  {
    "id": 54,
    "text": "柳永在 《八声甘州》 中以 “对潇潇暮雨洒江天，",
    "start": 204.151,
    "end": 207.974,
    "duration": 3.823
  },
  {
    "id": 55,
    "text": "一番洗清秋”，将悲秋具象化为落魄士人浪迹江湖的羁旅愁思；",
    "start": 208.145,
    "end": 213.995,
    "duration": 5.85
  },
  {
    "id": 56,
    "text": "辛弃疾在 《丑奴儿》 中借 “天凉好个秋” 表达饱经沧桑后的欲说还休；",
    "start": 214.152,
    "end": 219.886,
    "duration": 5.734
  },
  {
    "id": 57,
    "text": "而苏轼则在 《赤壁赋》 中借 “清风徐来，",
    "start": 220.066,
    "end": 223.265,
    "duration": 3.199
  },
  {
    "id": 58,
    "text": "水波不兴” 的秋夜泛舟，",
    "start": 223.265,
    "end": 224.796,
    "duration": 1.531
  },
  {
    "id": 59,
    "text": "以变与不变的哲理体悟消解了万物凋零之悲，",
    "start": 224.928,
    "end": 228.439,
    "duration": 3.511
  },
  {
    "id": 60,
    "text": "在随顺自然中实现了精神的旷达解脱，",
    "start": 228.586,
    "end": 231.847,
    "duration": 3.261
  },
  {
    "id": 61,
    "text": "为延续两千年的悲秋传统注入了高迈的哲理智慧。",
    "start": 231.924,
    "end": 235.968,
    "duration": 4.044
  }
]
