[
  {
    "id": 1,
    "text": "篇头：全题宏观破题与立论逻辑。",
    "start": 0.08,
    "end": 3.36,
    "duration": 3.28
  },
  {
    "id": 2,
    "text": "问题一：这道题到底在问什么？",
    "start": 3.36,
    "end": 6.48,
    "duration": 3.12
  },
  {
    "id": 3,
    "text": "这道题考查柳永在“词体发展史”上的奠基性贡献。",
    "start": 6.48,
    "end": 10.64,
    "duration": 4.16
  },
  {
    "id": 4,
    "text": "在考场上，考生绝不能仅仅停留在背诵几首柳词名句，",
    "start": 10.64,
    "end": 15.44,
    "duration": 4.8
  },
  {
    "id": 5,
    "text": "而必须紧扣“体裁演进机制”。",
    "start": 15.44,
    "end": 18.32,
    "duration": 2.88
  },
  {
    "id": 6,
    "text": "核心在于回答：柳永究竟通过怎样的体制、",
    "start": 18.32,
    "end": 21.92,
    "duration": 3.6
  },
  {
    "id": 7,
    "text": "手法、题材与语言创新，使词从小令的狭窄天地一跃成为长调慢词大放异彩的全新时代。",
    "start": 21.92,
    "end": 30.56,
    "duration": 8.64
  },
  {
    "id": 8,
    "text": "问题二：宏观立论核心指向哪里？",
    "start": 30.8,
    "end": 34.4,
    "duration": 3.6
  },
  {
    "id": 9,
    "text": "立论核心必须紧扣宋代叶梦得《避暑录话》中“凡有井水饮处，",
    "start": 34.4,
    "end": 39.76,
    "duration": 5.36
  },
  {
    "id": 10,
    "text": "皆能歌柳词”的极高社会传播度定评。",
    "start": 39.76,
    "end": 42.88,
    "duration": 3.12
  },
  {
    "id": 11,
    "text": "结合北宋商品经济繁荣与市民阶层崛起的背景，",
    "start": 42.88,
    "end": 46.8,
    "duration": 3.92
  },
  {
    "id": 12,
    "text": "阐明他如何从底层反哺文体，实现文人词向大众世俗化的重大转向。",
    "start": 46.8,
    "end": 52.48,
    "duration": 5.68
  },
  {
    "id": 13,
    "text": "问题三：由浅入深拆解为哪几个答题维度？",
    "start": 52.72,
    "end": 56.32,
    "duration": 3.6
  },
  {
    "id": 14,
    "text": "本题按文学生成与演进机制拆解为四个逻辑维度：第一维度，",
    "start": 56.32,
    "end": 61.2,
    "duration": 4.88
  },
  {
    "id": 15,
    "text": "体制革新，由小令向慢词的飞跃，大规模翻改创制慢词调式，",
    "start": 61.2,
    "end": 66.72,
    "duration": 5.52
  },
  {
    "id": 16,
    "text": "拓展词体容量。",
    "start": 66.72,
    "end": 68.0,
    "duration": 1.28
  },
  {
    "id": 17,
    "text": "第二维度，手法开拓，打破传统含蓄并置，",
    "start": 68.0,
    "end": 71.76,
    "duration": 3.76
  },
  {
    "id": 18,
    "text": "确立铺叙白描与情景交融的时空结构法则。",
    "start": 71.76,
    "end": 75.04,
    "duration": 3.28
  },
  {
    "id": 19,
    "text": "第三维度，题材与审美转向，深入市民阶层，",
    "start": 75.28,
    "end": 79.28,
    "duration": 4.0
  },
  {
    "id": 20,
    "text": "描摹都市繁华与羁旅离愁，融入通俗俚俗口语。",
    "start": 79.28,
    "end": 83.76,
    "duration": 4.48
  },
  {
    "id": 21,
    "text": "第四维度，文学史价值，总结其对长调规范的奠定，",
    "start": 83.76,
    "end": 88.4,
    "duration": 4.64
  },
  {
    "id": 22,
    "text": "以及对苏轼豪放派与后世词史的深远沾溉。",
    "start": 88.4,
    "end": 92.0,
    "duration": 3.6
  },
  {
    "id": 23,
    "text": "问题四：各维度之间具备怎样不可逆的递进因果链条？",
    "start": 92.0,
    "end": 96.16,
    "duration": 4.16
  },
  {
    "id": 24,
    "text": "第一步必须先在宏观上确立柳永在词史转折期的枢纽地位与时代土壤。",
    "start": 96.48,
    "end": 102.56,
    "duration": 6.08
  },
  {
    "id": 25,
    "text": "第二步说明体制扩容是所有艺术创新的物质载体，",
    "start": 102.56,
    "end": 106.8,
    "duration": 4.24
  },
  {
    "id": 26,
    "text": "必须先有慢词长篇。",
    "start": 106.8,
    "end": 108.72,
    "duration": 1.92
  },
  {
    "id": 27,
    "text": "第三步说明篇幅变长后必然逼出铺叙手法。",
    "start": 108.72,
    "end": 112.48,
    "duration": 3.76
  },
  {
    "id": 28,
    "text": "第四步说明生活场域的改变直接带来市井题材与俚俗语言的审美下沉。",
    "start": 112.48,
    "end": 118.4,
    "duration": 5.92
  },
  {
    "id": 29,
    "text": "第五步跳出文本本身，在宋代词史脉络中完成对豪放词乃至整个词史演进的历史闭环。",
    "start": 118.72,
    "end": 126.96,
    "duration": 8.24
  },
  {
    "id": 30,
    "text": "第一部分：破题立论与词史转折地位。",
    "start": 126.96,
    "end": 130.64,
    "duration": 3.68
  },
  {
    "id": 31,
    "text": "逐句因果推导与答题表述。",
    "start": 130.64,
    "end": 133.44,
    "duration": 2.8
  },
  {
    "id": 32,
    "text": "为了开篇直击考点要害并确立学术基调，",
    "start": 133.44,
    "end": 137.2,
    "duration": 3.76
  },
  {
    "id": 33,
    "text": "第一句必须给出柳永在宋代词体演进中的枢纽地位与叶梦得的权威定评。",
    "start": 137.2,
    "end": 143.52,
    "duration": 6.32
  },
  {
    "id": 34,
    "text": "所以表述为：柳永是北宋词坛由小令走向慢词的划时代关键人物，",
    "start": 143.92,
    "end": 149.36,
    "duration": 5.44
  },
  {
    "id": 35,
    "text": "被宋代叶梦得在《避暑录话》中赞誉为“凡有井水饮处，",
    "start": 149.36,
    "end": 154.0,
    "duration": 4.64
  },
  {
    "id": 36,
    "text": "皆能歌柳词”。",
    "start": 154.0,
    "end": 155.04,
    "duration": 1.04
  },
  {
    "id": 37,
    "text": "紧接着必须点明北宋城市经济繁荣的时代背景，",
    "start": 155.408,
    "end": 159.248,
    "duration": 3.84
  },
  {
    "id": 38,
    "text": "以及柳永自身科场失意流连市井的生命轨迹。",
    "start": 159.248,
    "end": 163.168,
    "duration": 3.92
  },
  {
    "id": 39,
    "text": "所以表述为：在北宋城市经济繁荣与市民阶层崛起的历史背景下，",
    "start": 163.168,
    "end": 168.688,
    "duration": 5.52
  },
  {
    "id": 40,
    "text": "柳永科举屡挫，自称“奉旨填词柳三变”，",
    "start": 168.688,
    "end": 172.368,
    "duration": 3.68
  },
  {
    "id": 41,
    "text": "长期流连于市井勾栏。",
    "start": 172.368,
    "end": 174.128,
    "duration": 1.76
  },
  {
    "id": 42,
    "text": "随后必须指出其对花间派及传统文人词藩篱的决然打破，",
    "start": 174.448,
    "end": 179.408,
    "duration": 4.96
  },
  {
    "id": 43,
    "text": "展现文体转型的力度。",
    "start": 179.408,
    "end": 181.168,
    "duration": 1.76
  },
  {
    "id": 44,
    "text": "所以表述为：他将毕生才情倾注于民间词曲，",
    "start": 181.168,
    "end": 185.088,
    "duration": 3.92
  },
  {
    "id": 45,
    "text": "彻底打破了晚唐五代以来文人词专事花间令词的狭隘传统。",
    "start": 185.088,
    "end": 190.208,
    "duration": 5.12
  },
  {
    "id": 46,
    "text": "最后一句必须从体制、手法、题材、",
    "start": 190.208,
    "end": 193.408,
    "duration": 3.2
  },
  {
    "id": 47,
    "text": "语言四个维度全面收束立论，为后文展开铺设严整路标。",
    "start": 193.408,
    "end": 197.968,
    "duration": 4.56
  },
  {
    "id": 48,
    "text": "所以表述为：柳永从体制调式、表现手法、",
    "start": 198.288,
    "end": 202.288,
    "duration": 4.0
  },
  {
    "id": 49,
    "text": "题材风貌与语言质感四个维度进行了全方位开拓，",
    "start": 202.288,
    "end": 206.848,
    "duration": 4.56
  },
  {
    "id": 50,
    "text": "成为宋词演进史上承前启后的巨擘。",
    "start": 206.848,
    "end": 210.288,
    "duration": 3.44
  },
  {
    "id": 51,
    "text": "本段答题思路总结。",
    "start": 210.288,
    "end": 212.048,
    "duration": 1.76
  },
  {
    "id": 52,
    "text": "本段用四句话完成全篇破题：首句亮出小令走向慢词的枢纽地位与叶梦得名言，",
    "start": 212.048,
    "end": 219.168,
    "duration": 7.12
  },
  {
    "id": 53,
    "text": "次句指出北宋城市经济与奉旨填词的士人境遇，",
    "start": 219.168,
    "end": 223.328,
    "duration": 4.16
  },
  {
    "id": 54,
    "text": "第三句点明打破花间狭隘传统，末句以四个维度确立全篇答题框架，",
    "start": 223.328,
    "end": 229.408,
    "duration": 6.08
  },
  {
    "id": 55,
    "text": "下笔气度严整。",
    "start": 229.408,
    "end": 230.528,
    "duration": 1.12
  },
  {
    "id": 56,
    "text": "所以本段具体答题完整版为：柳永是北宋词坛由小令走向慢词的划时代关键人物，",
    "start": 230.848,
    "end": 237.968,
    "duration": 7.12
  },
  {
    "id": 57,
    "text": "被宋代叶梦得在《避暑录话》中赞誉为“凡有井水饮处，",
    "start": 237.968,
    "end": 242.528,
    "duration": 4.56
  },
  {
    "id": 58,
    "text": "皆能歌柳词”。",
    "start": 242.528,
    "end": 243.888,
    "duration": 1.36
  },
  {
    "id": 59,
    "text": "在北宋城市经济繁荣与市民阶层崛起的历史背景下，",
    "start": 243.888,
    "end": 248.128,
    "duration": 4.24
  },
  {
    "id": 60,
    "text": "柳永科举屡挫，自称“奉旨填词柳三变”，",
    "start": 248.128,
    "end": 251.728,
    "duration": 3.6
  },
  {
    "id": 61,
    "text": "长期流连于市井勾栏。",
    "start": 251.728,
    "end": 253.168,
    "duration": 1.44
  },
  {
    "id": 62,
    "text": "他将毕生才情倾注于民间词曲，彻底打破了晚唐五代以来文人词专事花间令词的狭隘传统。",
    "start": 253.488,
    "end": 261.808,
    "duration": 8.32
  },
  {
    "id": 63,
    "text": "柳永从体制调式、表现手法、题材风貌与语言质感四个维度进行了全方位开拓，",
    "start": 261.808,
    "end": 269.008,
    "duration": 7.2
  },
  {
    "id": 64,
    "text": "成为宋词演进史上承前启后的巨擘。",
    "start": 269.008,
    "end": 272.288,
    "duration": 3.28
  },
  {
    "id": 65,
    "text": "第二部分：体制革新与长调慢词的大规模创制。",
    "start": 272.288,
    "end": 276.208,
    "duration": 3.92
  },
  {
    "id": 66,
    "text": "逐句因果推导与答题表述。",
    "start": 276.528,
    "end": 279.008,
    "duration": 2.48
  },
  {
    "id": 67,
    "text": "进入具体论述的第一层，必须从词的体裁体制切入，",
    "start": 279.008,
    "end": 283.248,
    "duration": 4.24
  },
  {
    "id": 68,
    "text": "明确长调慢词创制对宋词格局的重构作用。",
    "start": 283.248,
    "end": 287.168,
    "duration": 3.92
  },
  {
    "id": 69,
    "text": "所以表述为：首先，在体裁体制上，",
    "start": 287.168,
    "end": 290.368,
    "duration": 3.2
  },
  {
    "id": 70,
    "text": "柳永大规模创制长调慢词，终结了小令一统天下的单一格局。",
    "start": 290.368,
    "end": 295.328,
    "duration": 4.96
  },
  {
    "id": 71,
    "text": "随后深刻剖析五代及宋初小令的文体局限，",
    "start": 295.728,
    "end": 299.568,
    "duration": 3.84
  },
  {
    "id": 72,
    "text": "说明慢词兴起的客观必然性。",
    "start": 299.568,
    "end": 301.808,
    "duration": 2.24
  },
  {
    "id": 73,
    "text": "所以表述为：晚唐五代词作绝大多数为五六十字以内的小令，",
    "start": 302.176,
    "end": 307.057,
    "duration": 4.881
  },
  {
    "id": 74,
    "text": "容量狭促，难以承载复杂的社会现实。",
    "start": 307.057,
    "end": 310.007,
    "duration": 2.95
  },
  {
    "id": 75,
    "text": "接着指出柳永精通音律的个人艺术修养，",
    "start": 310.007,
    "end": 313.351,
    "duration": 3.344
  },
  {
    "id": 76,
    "text": "以及他如何借教坊民间音乐完成调式创制。",
    "start": 313.351,
    "end": 316.892,
    "duration": 3.541
  },
  {
    "id": 77,
    "text": "所以表述为：柳永通晓音律，充分利用民间教坊新声，",
    "start": 316.892,
    "end": 321.022,
    "duration": 4.13
  },
  {
    "id": 78,
    "text": "翻改或创制了一百余个慢词调式。",
    "start": 321.022,
    "end": 323.776,
    "duration": 2.754
  },
  {
    "id": 79,
    "text": "随后调取极具考场辨识度的标志性长调词调名作为坚实论据。",
    "start": 323.936,
    "end": 330.016,
    "duration": 6.08
  },
  {
    "id": 80,
    "text": "所以表述为：他拓展了长调慢词的篇幅与体制，",
    "start": 330.016,
    "end": 334.336,
    "duration": 4.32
  },
  {
    "id": 81,
    "text": "使慢词由边缘杂调上升为主流词体。",
    "start": 334.336,
    "end": 338.096,
    "duration": 3.76
  },
  {
    "id": 82,
    "text": "《雨霖铃》《八声甘州》《望海潮》等名作皆为长调范式。",
    "start": 338.096,
    "end": 342.896,
    "duration": 4.8
  },
  {
    "id": 83,
    "text": "尾句必须就地总结这种体制扩容对宋词思想情感承载力的划时代贡献。",
    "start": 342.896,
    "end": 348.416,
    "duration": 5.52
  },
  {
    "id": 84,
    "text": "所以表述为：这种体制扩容极大扩展了词的时空容量与思想跨度，",
    "start": 348.736,
    "end": 354.576,
    "duration": 5.84
  },
  {
    "id": 85,
    "text": "为宋词由案头浅唱迈向宏大抒情奠定了物质载体。",
    "start": 354.576,
    "end": 359.296,
    "duration": 4.72
  },
  {
    "id": 86,
    "text": "本段答题思路总结。",
    "start": 359.296,
    "end": 361.136,
    "duration": 1.84
  },
  {
    "id": 87,
    "text": "本段聚焦体制革新的首功：从小令终结者起笔，",
    "start": 361.136,
    "end": 365.456,
    "duration": 4.32
  },
  {
    "id": 88,
    "text": "剖析小令容量狭促的局限，揭示柳永通晓音律并翻制百余慢词调式的创举，",
    "start": 365.456,
    "end": 372.256,
    "duration": 6.8
  },
  {
    "id": 89,
    "text": "连出《雨霖铃》《八声甘州》等经典名调，",
    "start": 372.256,
    "end": 375.776,
    "duration": 3.52
  },
  {
    "id": 90,
    "text": "最终升华到为宏大抒情奠定载体的高度，",
    "start": 375.776,
    "end": 379.456,
    "duration": 3.68
  },
  {
    "id": 91,
    "text": "层次极其分明。",
    "start": 379.456,
    "end": 380.816,
    "duration": 1.36
  },
  {
    "id": 92,
    "text": "所以本段具体答题完整版为：首先，",
    "start": 381.136,
    "end": 384.016,
    "duration": 2.88
  },
  {
    "id": 93,
    "text": "在体裁体制上，柳永大规模创制长调慢词，",
    "start": 384.016,
    "end": 387.936,
    "duration": 3.92
  },
  {
    "id": 94,
    "text": "终结了小令一统天下的单一格局。",
    "start": 387.936,
    "end": 390.576,
    "duration": 2.64
  },
  {
    "id": 95,
    "text": "晚唐五代词作绝大多数为五六十字以内的小令，",
    "start": 390.576,
    "end": 394.336,
    "duration": 3.76
  },
  {
    "id": 96,
    "text": "容量狭促，难以承载复杂的社会现实。",
    "start": 394.336,
    "end": 397.536,
    "duration": 3.2
  },
  {
    "id": 97,
    "text": "柳永通晓音律，充分利用民间教坊新声，",
    "start": 397.536,
    "end": 401.056,
    "duration": 3.52
  },
  {
    "id": 98,
    "text": "翻改或创制了一百余个慢词调式。",
    "start": 401.056,
    "end": 403.536,
    "duration": 2.48
  },
  {
    "id": 99,
    "text": "他拓展了长调慢词的篇幅与体制，使慢词由边缘杂调上升为主流词体。",
    "start": 403.776,
    "end": 409.936,
    "duration": 6.16
  },
  {
    "id": 100,
    "text": "《雨霖铃》《八声甘州》《望海潮》等名作皆为长调范式。",
    "start": 409.936,
    "end": 414.656,
    "duration": 4.72
  },
  {
    "id": 101,
    "text": "这种体制扩容极大扩展了词的时空容量与思想跨度，",
    "start": 414.656,
    "end": 418.816,
    "duration": 4.16
  },
  {
    "id": 102,
    "text": "为宋词由案头浅唱迈向宏大抒情奠定了物质载体。",
    "start": 418.816,
    "end": 423.616,
    "duration": 4.8
  },
  {
    "id": 103,
    "text": "第三部分：手法突破与铺叙白描的叙事建构。",
    "start": 423.856,
    "end": 428.016,
    "duration": 4.16
  },
  {
    "id": 104,
    "text": "逐句因果推导与答题表述。",
    "start": 428.016,
    "end": 430.416,
    "duration": 2.4
  },
  {
    "id": 105,
    "text": "篇幅扩展为长调之后，必须有全新的表现手法来加以填充，",
    "start": 430.416,
    "end": 435.616,
    "duration": 5.2
  },
  {
    "id": 106,
    "text": "首句直接给出铺叙、白描的手法核心。",
    "start": 435.616,
    "end": 439.216,
    "duration": 3.6
  },
  {
    "id": 107,
    "text": "所以表述为：其次，在艺术手法上，",
    "start": 439.216,
    "end": 442.416,
    "duration": 3.2
  },
  {
    "id": 108,
    "text": "柳永创造性地开拓了以铺叙、羁旅行役与融情入景为核心的表现机制。",
    "start": 442.416,
    "end": 448.896,
    "duration": 6.48
  },
  {
    "id": 109,
    "text": "随后对比传统小令与柳词手法的根本差异，",
    "start": 449.216,
    "end": 452.736,
    "duration": 3.52
  },
  {
    "id": 110,
    "text": "指出其时空顺叙的叙事化特质。",
    "start": 452.736,
    "end": 455.056,
    "duration": 2.32
  },
  {
    "id": 111,
    "text": "所以表述为：传统小令讲究含蓄蕴藉与意象并置，",
    "start": 455.512,
    "end": 460.232,
    "duration": 4.72
  },
  {
    "id": 112,
    "text": "柳永则变含蓄为铺叙，采用章法井然的时空顺叙与波澜起伏的结构。",
    "start": 460.232,
    "end": 466.552,
    "duration": 6.32
  },
  {
    "id": 113,
    "text": "接着必须精细拆解千古名作《雨霖铃》的铺叙章法，",
    "start": 466.552,
    "end": 471.192,
    "duration": 4.64
  },
  {
    "id": 114,
    "text": "从景到人再到虚设别后，层层剖析。",
    "start": 471.192,
    "end": 474.472,
    "duration": 3.28
  },
  {
    "id": 115,
    "text": "所以表述为：《雨霖铃》铺叙长亭离别，",
    "start": 474.472,
    "end": 477.672,
    "duration": 3.2
  },
  {
    "id": 116,
    "text": "先以“寒蝉凄切，对长亭晚，骤雨初歇”渲染环境，",
    "start": 477.672,
    "end": 482.232,
    "duration": 4.56
  },
  {
    "id": 117,
    "text": "继以“执手相看泪眼，竟无语凝噎”白描情态，",
    "start": 482.232,
    "end": 486.232,
    "duration": 4.0
  },
  {
    "id": 118,
    "text": "最后以“便纵有千种风情，更与何人说”虚设别后情境，",
    "start": 486.232,
    "end": 491.032,
    "duration": 4.8
  },
  {
    "id": 119,
    "text": "层层顿挫。",
    "start": 491.032,
    "end": 491.832,
    "duration": 0.8
  },
  {
    "id": 120,
    "text": "为了展现其苍凉雄阔的另一面，必须引入苏轼对《八声甘州》的崇高赞誉，",
    "start": 492.152,
    "end": 497.992,
    "duration": 5.84
  },
  {
    "id": 121,
    "text": "强化答题说服力。",
    "start": 497.992,
    "end": 499.592,
    "duration": 1.6
  },
  {
    "id": 122,
    "text": "所以表述为：苏轼极赞其《八声甘州》中“渐霜风凄紧，",
    "start": 499.592,
    "end": 504.392,
    "duration": 4.8
  },
  {
    "id": 123,
    "text": "关河冷落，残照当楼”，认为其“不减唐人高处”，",
    "start": 504.392,
    "end": 508.952,
    "duration": 4.56
  },
  {
    "id": 124,
    "text": "足见其景中融情、苍凉博大的笔力。",
    "start": 508.952,
    "end": 511.992,
    "duration": 3.04
  },
  {
    "id": 125,
    "text": "本段答题思路总结。",
    "start": 512.232,
    "end": 513.832,
    "duration": 1.6
  },
  {
    "id": 126,
    "text": "本段深刻剖析柳词手法革命：从变含蓄为铺叙切入，",
    "start": 513.832,
    "end": 518.392,
    "duration": 4.56
  },
  {
    "id": 127,
    "text": "细致解构《雨霖铃》别前、别时、别后的三叠式叙事推演，",
    "start": 518.392,
    "end": 522.712,
    "duration": 4.32
  },
  {
    "id": 128,
    "text": "随后引入苏轼评《八声甘州》不减唐人高处的经典评语，",
    "start": 522.712,
    "end": 526.872,
    "duration": 4.16
  },
  {
    "id": 129,
    "text": "全方位证明其艺术表现力的大幅度跃升。",
    "start": 526.872,
    "end": 529.752,
    "duration": 2.88
  },
  {
    "id": 130,
    "text": "所以本段具体答题完整版为：其次，",
    "start": 530.152,
    "end": 533.192,
    "duration": 3.04
  },
  {
    "id": 131,
    "text": "在艺术手法上，柳永创造性地开拓了以铺叙、",
    "start": 533.192,
    "end": 536.872,
    "duration": 3.68
  },
  {
    "id": 132,
    "text": "羁旅行役与融情入景为核心的表现机制。",
    "start": 536.872,
    "end": 540.312,
    "duration": 3.44
  },
  {
    "id": 133,
    "text": "传统小令讲究含蓄蕴藉与意象并置，",
    "start": 540.312,
    "end": 543.672,
    "duration": 3.36
  },
  {
    "id": 134,
    "text": "柳永则变含蓄为铺叙，采用章法井然的时空顺叙与波澜起伏的结构。",
    "start": 543.672,
    "end": 549.592,
    "duration": 5.92
  },
  {
    "id": 135,
    "text": "《雨霖铃》铺叙长亭离别，先以“寒蝉凄切，",
    "start": 549.752,
    "end": 553.571,
    "duration": 3.819
  },
  {
    "id": 136,
    "text": "对长亭晚，骤雨初歇”渲染环境，继以“执手相看泪眼，",
    "start": 553.571,
    "end": 558.663,
    "duration": 5.092
  },
  {
    "id": 137,
    "text": "竟无语凝噎”白描情态，最后以“便纵有千种风情，",
    "start": 558.663,
    "end": 563.501,
    "duration": 4.838
  },
  {
    "id": 138,
    "text": "更与何人说”虚设别后情境，层层顿挫。",
    "start": 563.501,
    "end": 567.32,
    "duration": 3.819
  },
  {
    "id": 139,
    "text": "苏轼极赞其《八声甘州》中“渐霜风凄紧，",
    "start": 567.32,
    "end": 571.139,
    "duration": 3.819
  },
  {
    "id": 140,
    "text": "关河冷落，残照当楼”，认为其“不减唐人高处”，",
    "start": 571.139,
    "end": 575.467,
    "duration": 4.328
  },
  {
    "id": 141,
    "text": "足见其景中融情、苍凉博大的笔力。",
    "start": 575.467,
    "end": 579.032,
    "duration": 3.565
  },
  {
    "id": 142,
    "text": "第四部分：审美下沉与市井风情与市民心声。",
    "start": 579.112,
    "end": 583.432,
    "duration": 4.32
  },
  {
    "id": 143,
    "text": "逐句因果推导与答题表述。",
    "start": 583.432,
    "end": 586.072,
    "duration": 2.64
  },
  {
    "id": 144,
    "text": "手法之外，柳词对词体精神面貌的根本重塑在于题材与语言的世俗化，",
    "start": 586.072,
    "end": 592.312,
    "duration": 6.24
  },
  {
    "id": 145,
    "text": "首句必须标定审美下沉的总纲。",
    "start": 592.312,
    "end": 595.192,
    "duration": 2.88
  },
  {
    "id": 146,
    "text": "所以表述为：再次，在题材与语言上，",
    "start": 595.192,
    "end": 599.032,
    "duration": 3.84
  },
  {
    "id": 147,
    "text": "柳永实现了审美趣味的市井化转向，",
    "start": 599.032,
    "end": 601.912,
    "duration": 2.88
  },
  {
    "id": 148,
    "text": "开创了世俗市民词风。",
    "start": 601.912,
    "end": 603.672,
    "duration": 1.76
  },
  {
    "id": 149,
    "text": "接着剖析其突破士大夫贵族趣味的创新，",
    "start": 604.04,
    "end": 607.64,
    "duration": 3.6
  },
  {
    "id": 150,
    "text": "指出其深入民间底层生活。",
    "start": 607.64,
    "end": 610.28,
    "duration": 2.64
  },
  {
    "id": 151,
    "text": "所以表述为：他突破了士大夫文人歌儿舞女的规阁视角，",
    "start": 610.28,
    "end": 614.84,
    "duration": 4.56
  },
  {
    "id": 152,
    "text": "大胆将市井风情、青楼歌妓与下层市民生活写入词篇。",
    "start": 614.84,
    "end": 619.96,
    "duration": 5.12
  },
  {
    "id": 153,
    "text": "随后立刻调取描写都市全景风貌的千古名篇《望海潮》，",
    "start": 619.96,
    "end": 624.76,
    "duration": 4.8
  },
  {
    "id": 154,
    "text": "展现城市文学的崛起。",
    "start": 624.76,
    "end": 626.44,
    "duration": 1.68
  },
  {
    "id": 155,
    "text": "所以表述为：《望海潮》以“东南形胜，",
    "start": 626.76,
    "end": 629.435,
    "duration": 2.675
  },
  {
    "id": 156,
    "text": "三吴都会，钱塘自古繁华”的铺张彩笔，",
    "start": 629.435,
    "end": 632.755,
    "duration": 3.32
  },
  {
    "id": 157,
    "text": "全景描摹了北宋杭州的物阜民丰。",
    "start": 632.755,
    "end": 635.854,
    "duration": 3.099
  },
  {
    "id": 158,
    "text": "接下来转向语言风格，分析其吸收民间口语的平易晓畅之美。",
    "start": 635.854,
    "end": 641.388,
    "duration": 5.534
  },
  {
    "id": 159,
    "text": "所以表述为：在语言上，他大量吸收市井生动的白话口语，",
    "start": 641.388,
    "end": 646.48,
    "duration": 5.092
  },
  {
    "id": 160,
    "text": "如《定风波》中“自念晏婴轻巧，计较无凭。",
    "start": 646.48,
    "end": 649.8,
    "duration": 3.32
  },
  {
    "id": 161,
    "text": "早知恁么，悔最初、不教恁去”，语言平易晓畅、",
    "start": 649.88,
    "end": 654.44,
    "duration": 4.56
  },
  {
    "id": 162,
    "text": "贴近生活，展现出真率动人的市民心声。",
    "start": 654.44,
    "end": 658.04,
    "duration": 3.6
  },
  {
    "id": 163,
    "text": "本段答题思路总结。",
    "start": 658.04,
    "end": 659.72,
    "duration": 1.68
  },
  {
    "id": 164,
    "text": "本段聚焦市民题材与白话语言：先立定市井化转向，",
    "start": 659.72,
    "end": 664.04,
    "duration": 4.32
  },
  {
    "id": 165,
    "text": "再以《望海潮》的东南形胜展现宋代都市全景，",
    "start": 664.04,
    "end": 667.72,
    "duration": 3.68
  },
  {
    "id": 166,
    "text": "随后以《定风波》的口语白描展现市民男女的真率情感，",
    "start": 667.72,
    "end": 671.8,
    "duration": 4.08
  },
  {
    "id": 167,
    "text": "彻底讲明柳词风靡天下的平民美学根基。",
    "start": 671.8,
    "end": 675.24,
    "duration": 3.44
  },
  {
    "id": 168,
    "text": "所以本段具体答题完整版为：再次，",
    "start": 675.56,
    "end": 678.68,
    "duration": 3.12
  },
  {
    "id": 169,
    "text": "在题材与语言上，柳永实现了审美趣味的市井化转向，",
    "start": 678.68,
    "end": 683.4,
    "duration": 4.72
  },
  {
    "id": 170,
    "text": "开创了世俗市民词风。",
    "start": 683.4,
    "end": 685.48,
    "duration": 2.08
  },
  {
    "id": 171,
    "text": "他突破了士大夫文人歌儿舞女的规阁视角，",
    "start": 685.48,
    "end": 689.24,
    "duration": 3.76
  },
  {
    "id": 172,
    "text": "大胆将市井风情、青楼歌妓与下层市民生活写入词篇。",
    "start": 689.24,
    "end": 694.44,
    "duration": 5.2
  },
  {
    "id": 173,
    "text": "《望海潮》以“东南形胜，三吴都会，",
    "start": 694.44,
    "end": 697.48,
    "duration": 3.04
  },
  {
    "id": 174,
    "text": "钱塘自古繁华”的铺张彩笔，全景描摹了北宋杭州的物阜民丰。",
    "start": 697.48,
    "end": 702.68,
    "duration": 5.2
  },
  {
    "id": 175,
    "text": "在语言上，他大量吸收市井生动的白话口语，",
    "start": 703.0,
    "end": 706.68,
    "duration": 3.68
  },
  {
    "id": 176,
    "text": "如《定风波》中“自念晏婴轻巧，计较无凭。",
    "start": 706.68,
    "end": 710.36,
    "duration": 3.68
  },
  {
    "id": 177,
    "text": "早知恁么，悔最初、不教恁去”，语言平易晓畅、",
    "start": 710.36,
    "end": 714.28,
    "duration": 3.92
  },
  {
    "id": 178,
    "text": "贴近生活，展现出真率动人的市民心声。",
    "start": 714.28,
    "end": 717.32,
    "duration": 3.04
  },
  {
    "id": 179,
    "text": "第五部分：总结升华与文学史沾溉价值。",
    "start": 717.32,
    "end": 720.68,
    "duration": 3.36
  },
  {
    "id": 180,
    "text": "逐句因果推导与答题表述。",
    "start": 720.92,
    "end": 723.4,
    "duration": 2.48
  },
  {
    "id": 181,
    "text": "经过以上四个维度的完整展开，结尾段必须跳出作家个案，",
    "start": 723.4,
    "end": 728.44,
    "duration": 5.04
  },
  {
    "id": 182,
    "text": "在整个宋词演进脉络中确立其不可撼动的历史地位。",
    "start": 728.44,
    "end": 732.84,
    "duration": 4.4
  },
  {
    "id": 183,
    "text": "所以表述为：最后，柳永对词体发展的历史贡献具有奠基性与开创性意义。",
    "start": 732.84,
    "end": 739.0,
    "duration": 6.16
  },
  {
    "id": 184,
    "text": "第二句话需要明确指出其对后世豪放词派的先导作用，",
    "start": 739.0,
    "end": 743.56,
    "duration": 4.56
  },
  {
    "id": 185,
    "text": "展现其对苏辛词风的深远沾溉。",
    "start": 743.56,
    "end": 745.96,
    "duration": 2.4
  },
  {
    "id": 186,
    "text": "所以表述为：他不仅为长调慢词建立了规范典范，",
    "start": 746.344,
    "end": 750.664,
    "duration": 4.32
  },
  {
    "id": 187,
    "text": "更其铺叙体制与宏阔笔墨，直接启迪了苏轼、",
    "start": 750.664,
    "end": 754.744,
    "duration": 4.08
  },
  {
    "id": 188,
    "text": "辛弃疾豪放词风的形成。",
    "start": 754.744,
    "end": 756.824,
    "duration": 2.08
  },
  {
    "id": 189,
    "text": "最后一句必须将柳永置于两宋文学代表体裁确立的高度完成升华，",
    "start": 756.824,
    "end": 762.664,
    "duration": 5.84
  },
  {
    "id": 190,
    "text": "实现大题圆满闭环。",
    "start": 762.664,
    "end": 764.664,
    "duration": 2.0
  },
  {
    "id": 191,
    "text": "所以表述为：他在词史上完成的文体转型与普及，",
    "start": 764.664,
    "end": 769.064,
    "duration": 4.4
  },
  {
    "id": 192,
    "text": "使宋词真正成为代表两宋一代文学的独立巅峰文体，",
    "start": 769.064,
    "end": 773.704,
    "duration": 4.64
  },
  {
    "id": 193,
    "text": "其文学史地位不可磨灭。",
    "start": 773.704,
    "end": 775.784,
    "duration": 2.08
  },
  {
    "id": 194,
    "text": "本段答题思路总结。",
    "start": 776.024,
    "end": 777.864,
    "duration": 1.84
  },
  {
    "id": 195,
    "text": "本段以沉稳大气的词史视野完成闭环：首句立定奠基性开创性定位，",
    "start": 777.864,
    "end": 784.504,
    "duration": 6.64
  },
  {
    "id": 196,
    "text": "次句点出其慢词铺叙对苏轼豪放派的直接滋养，",
    "start": 784.504,
    "end": 788.904,
    "duration": 4.4
  },
  {
    "id": 197,
    "text": "末句将评价拔高至宋代一代文学标志的高度，",
    "start": 788.904,
    "end": 792.664,
    "duration": 3.76
  },
  {
    "id": 198,
    "text": "收束极具说服力。",
    "start": 792.664,
    "end": 794.424,
    "duration": 1.76
  },
  {
    "id": 199,
    "text": "所以本段具体答题完整版为：最后，",
    "start": 794.424,
    "end": 797.704,
    "duration": 3.28
  },
  {
    "id": 200,
    "text": "柳永对词体发展的历史贡献具有奠基性与开创性意义。",
    "start": 797.704,
    "end": 802.504,
    "duration": 4.8
  },
  {
    "id": 201,
    "text": "他不仅为长调慢词建立了规范典范，",
    "start": 802.504,
    "end": 805.624,
    "duration": 3.12
  },
  {
    "id": 202,
    "text": "更其铺叙体制与宏阔笔墨，直接启迪了苏轼、",
    "start": 805.624,
    "end": 809.624,
    "duration": 4.0
  },
  {
    "id": 203,
    "text": "辛弃疾豪放词风的形成。",
    "start": 809.624,
    "end": 812.024,
    "duration": 2.4
  },
  {
    "id": 204,
    "text": "他在词史上完成的文体转型与普及，",
    "start": 812.024,
    "end": 815.144,
    "duration": 3.12
  },
  {
    "id": 205,
    "text": "使宋词真正成为代表两宋一代文学的独立巅峰文体，",
    "start": 815.144,
    "end": 819.944,
    "duration": 4.8
  },
  {
    "id": 206,
    "text": "其文学史地位不可磨灭。",
    "start": 819.944,
    "end": 821.704,
    "duration": 1.76
  },
  {
    "id": 207,
    "text": "篇尾：整道大题的内在逻辑链总括。",
    "start": 822.024,
    "end": 824.984,
    "duration": 2.96
  },
  {
    "id": 208,
    "text": "为了便于考生在脑海中建立极速调取机制，",
    "start": 824.984,
    "end": 828.504,
    "duration": 3.52
  },
  {
    "id": 209,
    "text": "整道大题的论证逻辑可提炼为如下不可逆的六步链条：一、",
    "start": 828.504,
    "end": 833.464,
    "duration": 4.96
  },
  {
    "id": 210,
    "text": "文体定位：开篇直接以小令走向慢词的枢纽定性，",
    "start": 833.464,
    "end": 837.624,
    "duration": 4.16
  },
  {
    "id": 211,
    "text": "引用叶梦得凡有井水处皆能歌词与奉旨填词身世破题。",
    "start": 837.624,
    "end": 842.264,
    "duration": 4.64
  },
  {
    "id": 212,
    "text": "二、体制扩容：终结小令一统天下局限，",
    "start": 842.584,
    "end": 845.704,
    "duration": 3.12
  },
  {
    "id": 213,
    "text": "利用教坊新声翻制百余慢词调式，确立长调慢词主流地位与容量。",
    "start": 845.704,
    "end": 850.904,
    "duration": 5.2
  },
  {
    "id": 214,
    "text": "三、手法开拓：变含蓄蕴藉为时空铺叙，",
    "start": 850.904,
    "end": 854.184,
    "duration": 3.28
  },
  {
    "id": 215,
    "text": "以《雨霖铃》展三叠式结构，以《八声甘州》引苏轼不减唐人高处定评。",
    "start": 854.184,
    "end": 859.784,
    "duration": 5.6
  },
  {
    "id": 216,
    "text": "四、题材下沉：打破士大夫规阁狭小视角，",
    "start": 859.784,
    "end": 863.304,
    "duration": 3.52
  },
  {
    "id": 217,
    "text": "以《望海潮》全景展现北宋都市繁荣，",
    "start": 863.304,
    "end": 866.184,
    "duration": 2.88
  },
  {
    "id": 218,
    "text": "确立市民文学审美向度。",
    "start": 866.184,
    "end": 867.864,
    "duration": 1.68
  },
  {
    "id": 219,
    "text": "五、俚俗语言：大量吸纳民间活态白话口语，",
    "start": 868.184,
    "end": 871.784,
    "duration": 3.6
  },
  {
    "id": 220,
    "text": "以《定风波》展现真率市民心声，实现诗词的大众化传播。",
    "start": 871.784,
    "end": 876.264,
    "duration": 4.48
  },
  {
    "id": 221,
    "text": "六、史学闭环：确立慢词规范，阐明其铺叙体制对苏轼、",
    "start": 876.264,
    "end": 881.144,
    "duration": 4.88
  },
  {
    "id": 222,
    "text": "辛弃疾豪放词风的直接先导启迪，完成一代词史总结。",
    "start": 881.144,
    "end": 885.304,
    "duration": 4.16
  }
]