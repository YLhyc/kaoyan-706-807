[
  {
    "id": 1,
    "text": "试论《水浒传》与《三国演义》人物塑造艺术的异同与演进。",
    "start": 0.089,
    "end": 4.458,
    "duration": 4.369
  },
  {
    "id": 2,
    "text": "《三国演义》 与 《水浒传》 是中国古典长篇章回小说发展初期的两座巍峨丰碑。",
    "start": 4.858,
    "end": 10.447,
    "duration": 5.589
  },
  {
    "id": 3,
    "text": "二者同诞生于元末明初讲史话本与市井文化的繁荣土壤，",
    "start": 10.854,
    "end": 15.596,
    "duration": 4.742
  },
  {
    "id": 4,
    "text": "分别开创了中国历史演义小说与英雄传奇小说的宏大格局。",
    "start": 15.996,
    "end": 20.781,
    "duration": 4.785
  },
  {
    "id": 5,
    "text": "然而，从 《三国演义》 走向 《水浒传》，",
    "start": 20.966,
    "end": 23.584,
    "duration": 2.618
  },
  {
    "id": 6,
    "text": "标志着中国古代小说在人物塑造艺术上，",
    "start": 23.878,
    "end": 27.126,
    "duration": 3.248
  },
  {
    "id": 7,
    "text": "实现了一次由“政治道德类型化”向“现实生活性格化与发展性”的历史性跨越。",
    "start": 27.306,
    "end": 33.904,
    "duration": 6.598
  },
  {
    "id": 8,
    "text": "金圣叹在评述两书时指出，水浒人物刻画之工绝不减于史记。",
    "start": 34.235,
    "end": 39.466,
    "duration": 5.231
  },
  {
    "id": 9,
    "text": "二人在人物塑造艺术上的同异与演进规律，",
    "start": 39.688,
    "end": 43.093,
    "duration": 3.405
  },
  {
    "id": 10,
    "text": "主要展现为以下四个核心维度：",
    "start": 43.435,
    "end": 45.622,
    "duration": 2.187
  },
  {
    "id": 11,
    "text": "第一，在人物塑造观念上，",
    "start": 46.254,
    "end": 48.255,
    "duration": 2.001
  },
  {
    "id": 12,
    "text": "呈现由政治伦理类型化向个性鲜明性格化的历史演进。",
    "start": 48.531,
    "end": 52.906,
    "duration": 4.375
  },
  {
    "id": 13,
    "text": "《三国演义》 的人物塑造深刻受制于“尊刘贬曹”的正统政治倾向与史传编年体例，",
    "start": 53.141,
    "end": 59.485,
    "duration": 6.344
  },
  {
    "id": 14,
    "text": "人物往往偏于政治道德的象征化定型。",
    "start": 59.762,
    "end": 62.642,
    "duration": 2.88
  },
  {
    "id": 15,
    "text": "鲁迅精辟概括其主要人物具有 “智绝”（诸葛亮）、",
    "start": 62.824,
    "end": 66.237,
    "duration": 3.413
  },
  {
    "id": 16,
    "text": "“义绝”（关羽）、“奸绝”（曹操）的典型特征，",
    "start": 66.451,
    "end": 69.722,
    "duration": 3.271
  },
  {
    "id": 17,
    "text": "人物一出场其性格便基本定型，鲜有内因导致的剧烈改变；",
    "start": 70.027,
    "end": 74.603,
    "duration": 4.576
  },
  {
    "id": 18,
    "text": "而 《水浒传》 则突破了政治伦理概念的预设，",
    "start": 75.095,
    "end": 77.898,
    "duration": 2.803
  },
  {
    "id": 19,
    "text": "将人物扎根于社会生活的土壤中。",
    "start": 77.942,
    "end": 80.416,
    "duration": 2.474
  },
  {
    "id": 20,
    "text": "作者不再将人物定性为非黑即白的扁平脸谱，",
    "start": 80.661,
    "end": 84.058,
    "duration": 3.397
  },
  {
    "id": 21,
    "text": "而是刻画出活生生的人性真实，如宋江的仁义仗义与权谋妥协，",
    "start": 84.415,
    "end": 89.862,
    "duration": 5.447
  },
  {
    "id": 22,
    "text": "李逵的赤诚天真与野蛮滥杀，",
    "start": 90.151,
    "end": 92.499,
    "duration": 2.348
  },
  {
    "id": 23,
    "text": "人物性格丰富而具备真实的生活毛边。",
    "start": 92.882,
    "end": 95.638,
    "duration": 2.756
  },
  {
    "id": 24,
    "text": "第二，在性格表现机制上，",
    "start": 95.988,
    "end": 98.09,
    "duration": 2.102
  },
  {
    "id": 25,
    "text": "展现由静态特征强化向动态性格发展的深层飞跃。",
    "start": 98.367,
    "end": 102.321,
    "duration": 3.954
  },
  {
    "id": 26,
    "text": "在人物命运演变轨迹上，",
    "start": 102.565,
    "end": 104.424,
    "duration": 1.859
  },
  {
    "id": 27,
    "text": "《三国演义》 的人物性格具有高度的稳定性，",
    "start": 104.478,
    "end": 107.41,
    "duration": 2.932
  },
  {
    "id": 28,
    "text": "叙事重点在于历史事件与政治智谋的较量，",
    "start": 107.779,
    "end": 111.121,
    "duration": 3.342
  },
  {
    "id": 29,
    "text": "人物多是在各种情境中反复印证其既定品质；",
    "start": 111.575,
    "end": 115.398,
    "duration": 3.823
  },
  {
    "id": 30,
    "text": "而 《水浒传》 则首次成功塑造了具有严密心理演变与鲜明阶段发展的性格典型。",
    "start": 115.835,
    "end": 122.159,
    "duration": 6.324
  },
  {
    "id": 31,
    "text": "最突出的代表当属林冲：作为八十万禁军教头，",
    "start": 122.395,
    "end": 126.432,
    "duration": 4.037
  },
  {
    "id": 32,
    "text": "他起初对封建官场怀抱幻想，面对高太尉迫害表现出屈从隐忍、",
    "start": 126.563,
    "end": 132.368,
    "duration": 5.805
  },
  {
    "id": 33,
    "text": "息事宁人；然而在野猪林遇险、草料场被焚、",
    "start": 132.398,
    "end": 136.51,
    "duration": 4.112
  },
  {
    "id": 34,
    "text": "山神庙手刃仇敌等一系列残酷打击下，",
    "start": 136.58,
    "end": 139.923,
    "duration": 3.343
  },
  {
    "id": 35,
    "text": "其内心的正统幻想被彻底粉碎，最终性格发生深刻突变，",
    "start": 139.959,
    "end": 144.95,
    "duration": 4.991
  },
  {
    "id": 36,
    "text": "毅然雪夜上梁山。",
    "start": 144.996,
    "end": 146.407,
    "duration": 1.411
  },
  {
    "id": 37,
    "text": "这种动态的性格成长，展现了卓越的现实主义深度。",
    "start": 146.624,
    "end": 150.43,
    "duration": 3.806
  },
  {
    "id": 38,
    "text": "第三，在生存空间与生活视野上，",
    "start": 150.71,
    "end": 153.412,
    "duration": 2.702
  },
  {
    "id": 39,
    "text": "呈现由庙堂军事全景向市井江湖微观日常的下沉。",
    "start": 153.783,
    "end": 158.211,
    "duration": 4.428
  },
  {
    "id": 40,
    "text": "二者人物活动环境的差异深刻影响了人物性格的质感。",
    "start": 158.53,
    "end": 162.454,
    "duration": 3.924
  },
  {
    "id": 41,
    "text": "《三国演义》 的人物活跃于朝堂营帐、",
    "start": 162.589,
    "end": 165.319,
    "duration": 2.73
  },
  {
    "id": 42,
    "text": "割据诸侯与沙场战阵之间，",
    "start": 165.545,
    "end": 167.695,
    "duration": 2.15
  },
  {
    "id": 43,
    "text": "人物语言与行事风范多具帝王将相的宏阔威仪与政治谋略，",
    "start": 167.829,
    "end": 172.803,
    "duration": 4.974
  },
  {
    "id": 44,
    "text": "缺乏细碎的日常生活气息；",
    "start": 172.998,
    "end": 175.126,
    "duration": 2.128
  },
  {
    "id": 45,
    "text": "《水浒传》 则把聚光灯对准了城镇集市、村舍客栈、",
    "start": 175.345,
    "end": 179.847,
    "duration": 4.502
  },
  {
    "id": 46,
    "text": "荒郊野店与押解大道。",
    "start": 180.135,
    "end": 182.094,
    "duration": 1.959
  },
  {
    "id": 47,
    "text": "作者极善于通过平凡而具体的市井生活细节展现好汉性格，",
    "start": 182.415,
    "end": 187.606,
    "duration": 5.191
  },
  {
    "id": 48,
    "text": "如杨志卖刀时的穷困失意、",
    "start": 187.892,
    "end": 190.121,
    "duration": 2.229
  },
  {
    "id": 49,
    "text": "武松在快活林醉打蒋门神时的江湖机敏。",
    "start": 190.471,
    "end": 193.966,
    "duration": 3.495
  },
  {
    "id": 50,
    "text": "这种向市井民间的深度下沉，使水浒人物具备了更加浓郁的血肉感。",
    "start": 194.177,
    "end": 199.581,
    "duration": 5.404
  },
  {
    "id": 51,
    "text": "第四，在语言体式运用上，",
    "start": 199.834,
    "end": 202.069,
    "duration": 2.235
  },
  {
    "id": 52,
    "text": "呈现由文白相间的史传文言向纯熟生动的白话口语的飞跃。",
    "start": 202.275,
    "end": 207.787,
    "duration": 5.512
  },
  {
    "id": 53,
    "text": "在人物语言塑造上，",
    "start": 208.279,
    "end": 209.659,
    "duration": 1.38
  },
  {
    "id": 54,
    "text": "《三国演义》 采用的是经过提炼的浅近文言与文白夹杂体式，",
    "start": 209.889,
    "end": 215.332,
    "duration": 5.443
  },
  {
    "id": 55,
    "text": "庄重典雅、概括力强，切合历史正剧的严肃氛围，",
    "start": 215.374,
    "end": 219.389,
    "duration": 4.015
  },
  {
    "id": 56,
    "text": "但人物个性化口吻稍显受限；",
    "start": 219.694,
    "end": 222.045,
    "duration": 2.351
  },
  {
    "id": 57,
    "text": "《水浒传》 则全面吸纳宋元以来的北方白话口语，",
    "start": 222.222,
    "end": 226.094,
    "duration": 3.872
  },
  {
    "id": 58,
    "text": "创造出高度成熟、生动洗练的白话叙事语言。",
    "start": 226.428,
    "end": 230.232,
    "duration": 3.804
  },
  {
    "id": 59,
    "text": "好汉们的对话 “各极其声，见其人即可辨其言”：",
    "start": 230.447,
    "end": 234.168,
    "duration": 3.721
  },
  {
    "id": 60,
    "text": "鲁智深的豪迈粗中有细，李逵的粗鲁直率，林冲的谦抑自抑，",
    "start": 234.445,
    "end": 239.879,
    "duration": 5.434
  },
  {
    "id": 61,
    "text": "无不通过活泼纯正的白话口语精准流露，",
    "start": 240.131,
    "end": 243.09,
    "duration": 2.959
  },
  {
    "id": 62,
    "text": "标志着中国古代小说语言艺术走向成熟独立。",
    "start": 243.509,
    "end": 247.32,
    "duration": 3.811
  }
]
