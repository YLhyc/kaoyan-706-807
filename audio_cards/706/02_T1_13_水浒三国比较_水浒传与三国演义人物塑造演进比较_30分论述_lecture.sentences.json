[
  {
    "id": 1,
    "text": "试论《水浒传》与《三国演义》人物塑造艺术的异同与演进。",
    "start": 0.16,
    "end": 5.68,
    "duration": 5.52
  },
  {
    "id": 2,
    "text": "《三国演义》 与 《水浒传》 是中国古典长篇章回小说发展初期的两座巍峨丰碑。",
    "start": 5.68,
    "end": 12.8,
    "duration": 7.12
  },
  {
    "id": 3,
    "text": "二者同诞生于元末明初讲史话本与市井文化的繁荣土壤，",
    "start": 12.8,
    "end": 17.92,
    "duration": 5.12
  },
  {
    "id": 4,
    "text": "分别开创了中国历史演义小说与英雄传奇小说的宏大格局。",
    "start": 17.92,
    "end": 23.52,
    "duration": 5.6
  },
  {
    "id": 5,
    "text": "然而，从 《三国演义》 走向 《水浒传》，",
    "start": 23.84,
    "end": 27.52,
    "duration": 3.68
  },
  {
    "id": 6,
    "text": "标志着中国古代小说在人物塑造艺术上，",
    "start": 27.52,
    "end": 31.36,
    "duration": 3.84
  },
  {
    "id": 7,
    "text": "实现了一次由“政治道德类型化”向“现实生活性格化与发展性”的历史性跨越。",
    "start": 31.36,
    "end": 39.2,
    "duration": 7.84
  },
  {
    "id": 8,
    "text": "金圣叹在评述两书时指出，水浒人物刻画之工绝不减于史记。",
    "start": 39.2,
    "end": 44.8,
    "duration": 5.6
  },
  {
    "id": 9,
    "text": "二人在人物塑造艺术上的同异与演进规律，",
    "start": 44.8,
    "end": 49.36,
    "duration": 4.56
  },
  {
    "id": 10,
    "text": "主要展现为以下四个核心维度：",
    "start": 49.36,
    "end": 52.08,
    "duration": 2.72
  },
  {
    "id": 11,
    "text": "第一，在人物塑造观念上，",
    "start": 52.08,
    "end": 54.08,
    "duration": 2.0
  },
  {
    "id": 12,
    "text": "呈现由政治伦理类型化向个性鲜明性格化的历史演进。",
    "start": 54.08,
    "end": 59.28,
    "duration": 5.2
  },
  {
    "id": 13,
    "text": "《三国演义》 的人物塑造深刻受制于“尊刘贬曹”的正统政治倾向与史传编年体例，",
    "start": 59.28,
    "end": 66.8,
    "duration": 7.52
  },
  {
    "id": 14,
    "text": "人物往往偏于政治道德的象征化定型。",
    "start": 67.04,
    "end": 71.2,
    "duration": 4.16
  },
  {
    "id": 15,
    "text": "鲁迅精辟概括其主要人物具有 “智绝”（诸葛亮）、",
    "start": 71.2,
    "end": 75.92,
    "duration": 4.72
  },
  {
    "id": 16,
    "text": "“义绝”（关羽）、“奸绝”（曹操）的典型特征，",
    "start": 75.92,
    "end": 79.84,
    "duration": 3.92
  },
  {
    "id": 17,
    "text": "人物一出场其性格便基本定型，鲜有内因导致的剧烈改变；",
    "start": 79.84,
    "end": 84.96,
    "duration": 5.12
  },
  {
    "id": 18,
    "text": "而 《水浒传》 则突破了政治伦理概念的预设，",
    "start": 84.96,
    "end": 89.36,
    "duration": 4.4
  },
  {
    "id": 19,
    "text": "将人物扎根于社会生活的土壤中。",
    "start": 89.36,
    "end": 93.04,
    "duration": 3.68
  },
  {
    "id": 20,
    "text": "作者不再将人物定性为非黑即白的扁平脸谱，",
    "start": 93.04,
    "end": 97.2,
    "duration": 4.16
  },
  {
    "id": 21,
    "text": "而是刻画出活生生的人性真实，如宋江的仁义仗义与权谋妥协，",
    "start": 97.2,
    "end": 102.24,
    "duration": 5.04
  },
  {
    "id": 22,
    "text": "李逵的赤诚天真与野蛮滥杀，",
    "start": 102.616,
    "end": 105.016,
    "duration": 2.4
  },
  {
    "id": 23,
    "text": "人物性格丰富而具备真实的生活毛边。",
    "start": 105.016,
    "end": 108.296,
    "duration": 3.28
  },
  {
    "id": 24,
    "text": "第二，在性格表现机制上，",
    "start": 108.296,
    "end": 110.616,
    "duration": 2.32
  },
  {
    "id": 25,
    "text": "展现由静态特征强化向动态性格发展的深层飞跃。",
    "start": 110.616,
    "end": 115.336,
    "duration": 4.72
  },
  {
    "id": 26,
    "text": "在人物命运演变轨迹上，",
    "start": 115.656,
    "end": 117.816,
    "duration": 2.16
  },
  {
    "id": 27,
    "text": "《三国演义》 的人物性格具有高度的稳定性，",
    "start": 117.816,
    "end": 121.896,
    "duration": 4.08
  },
  {
    "id": 28,
    "text": "叙事重点在于历史事件与政治智谋的较量，",
    "start": 121.896,
    "end": 126.136,
    "duration": 4.24
  },
  {
    "id": 29,
    "text": "人物多是在各种情境中反复印证其既定品质；",
    "start": 126.136,
    "end": 130.616,
    "duration": 4.48
  },
  {
    "id": 30,
    "text": "而 《水浒传》 则首次成功塑造了具有严密心理演变与鲜明阶段发展的性格典型。",
    "start": 130.856,
    "end": 138.616,
    "duration": 7.76
  },
  {
    "id": 31,
    "text": "最突出的代表当属林冲：作为八十万禁军教头，",
    "start": 138.616,
    "end": 143.336,
    "duration": 4.72
  },
  {
    "id": 32,
    "text": "他起初对封建官场怀抱幻想，面对高太尉迫害表现出屈从隐忍、",
    "start": 143.336,
    "end": 149.336,
    "duration": 6.0
  },
  {
    "id": 33,
    "text": "息事宁人；然而在野猪林遇险、草料场被焚、",
    "start": 149.336,
    "end": 153.336,
    "duration": 4.0
  },
  {
    "id": 34,
    "text": "山神庙手刃仇敌等一系列残酷打击下，",
    "start": 153.736,
    "end": 157.416,
    "duration": 3.68
  },
  {
    "id": 35,
    "text": "其内心的正统幻想被彻底粉碎，最终性格发生深刻突变，",
    "start": 157.416,
    "end": 162.056,
    "duration": 4.64
  },
  {
    "id": 36,
    "text": "毅然雪夜上梁山。",
    "start": 162.056,
    "end": 163.736,
    "duration": 1.68
  },
  {
    "id": 37,
    "text": "这种动态的性格成长，展现了卓越的现实主义深度。",
    "start": 163.736,
    "end": 168.616,
    "duration": 4.88
  },
  {
    "id": 38,
    "text": "第三，在生存空间与生活视野上，",
    "start": 168.616,
    "end": 171.576,
    "duration": 2.96
  },
  {
    "id": 39,
    "text": "呈现由庙堂军事全景向市井江湖微观日常的下沉。",
    "start": 171.576,
    "end": 176.379,
    "duration": 4.803
  },
  {
    "id": 40,
    "text": "二者人物活动环境的差异深刻影响了人物性格的质感。",
    "start": 176.379,
    "end": 181.769,
    "duration": 5.39
  },
  {
    "id": 41,
    "text": "《三国演义》 的人物活跃于朝堂营帐、",
    "start": 181.769,
    "end": 185.587,
    "duration": 3.818
  },
  {
    "id": 42,
    "text": "割据诸侯与沙场战阵之间，",
    "start": 185.587,
    "end": 188.282,
    "duration": 2.695
  },
  {
    "id": 43,
    "text": "人物语言与行事风范多具帝王将相的宏阔威仪与政治谋略，",
    "start": 188.282,
    "end": 193.672,
    "duration": 5.39
  },
  {
    "id": 44,
    "text": "缺乏细碎的日常生活气息；",
    "start": 193.672,
    "end": 196.367,
    "duration": 2.695
  },
  {
    "id": 45,
    "text": "《水浒传》 则把聚光灯对准了城镇集市、村舍客栈、",
    "start": 196.367,
    "end": 201.656,
    "duration": 5.289
  },
  {
    "id": 46,
    "text": "荒郊野店与押解大道。",
    "start": 201.656,
    "end": 204.216,
    "duration": 2.56
  },
  {
    "id": 47,
    "text": "作者极善于通过平凡而具体的市井生活细节展现好汉性格，",
    "start": 204.216,
    "end": 210.056,
    "duration": 5.84
  },
  {
    "id": 48,
    "text": "如杨志卖刀时的穷困失意、",
    "start": 210.056,
    "end": 212.376,
    "duration": 2.32
  },
  {
    "id": 49,
    "text": "武松在快活林醉打蒋门神时的江湖机敏。",
    "start": 212.376,
    "end": 216.776,
    "duration": 4.4
  },
  {
    "id": 50,
    "text": "这种向市井民间的深度下沉，使水浒人物具备了更加浓郁的血肉感。",
    "start": 216.776,
    "end": 223.447,
    "duration": 6.671
  },
  {
    "id": 51,
    "text": "第四，在语言体式运用上，",
    "start": 223.447,
    "end": 226.068,
    "duration": 2.621
  },
  {
    "id": 52,
    "text": "呈现由文白相间的史传文言向纯熟生动的白话口语的飞跃。",
    "start": 226.068,
    "end": 231.747,
    "duration": 5.679
  },
  {
    "id": 53,
    "text": "在人物语言塑造上，",
    "start": 231.747,
    "end": 233.713,
    "duration": 1.966
  },
  {
    "id": 54,
    "text": "《三国演义》 采用的是经过提炼的浅近文言与文白夹杂体式，",
    "start": 233.713,
    "end": 239.611,
    "duration": 5.898
  },
  {
    "id": 55,
    "text": "庄重典雅、概括力强，切合历史正剧的严肃氛围，",
    "start": 239.611,
    "end": 244.416,
    "duration": 4.805
  },
  {
    "id": 56,
    "text": "但人物个性化口吻稍显受限；",
    "start": 244.416,
    "end": 247.256,
    "duration": 2.84
  },
  {
    "id": 57,
    "text": "《水浒传》 则全面吸纳宋元以来的北方白话口语，",
    "start": 247.038,
    "end": 247.256,
    "duration": 0.218
  },
  {
    "id": 58,
    "text": "创造出高度成熟、生动洗练的白话叙事语言。",
    "start": 247.038,
    "end": 247.256,
    "duration": 0.218
  },
  {
    "id": 59,
    "text": "好汉们的对话 “各极其声，见其人即可辨其言”：",
    "start": 247.038,
    "end": 247.256,
    "duration": 0.218
  },
  {
    "id": 60,
    "text": "鲁智深的豪迈粗中有细，李逵的粗鲁直率，林冲的谦抑自抑，",
    "start": 247.038,
    "end": 247.256,
    "duration": 0.218
  },
  {
    "id": 61,
    "text": "无不通过活泼纯正的白话口语精准流露，",
    "start": 247.038,
    "end": 247.256,
    "duration": 0.218
  },
  {
    "id": 62,
    "text": "标志着中国古代小说语言艺术走向成熟独立。",
    "start": 247.038,
    "end": 247.256,
    "duration": 0.218
  }
]