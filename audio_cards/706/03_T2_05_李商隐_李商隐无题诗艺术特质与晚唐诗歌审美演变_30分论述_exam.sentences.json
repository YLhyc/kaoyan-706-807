[
  {
    "id": 1,
    "text": "试论李商隐无题诗的艺术特质与晚唐诗歌审美演变。",
    "start": 0.104,
    "end": 4.527,
    "duration": 4.423
  },
  {
    "id": 2,
    "text": "李商隐是晚唐诗坛在唐诗盛极难继之际异军突起的抒情大家。",
    "start": 4.913,
    "end": 10.125,
    "duration": 5.212
  },
  {
    "id": 3,
    "text": "身处晚唐藩镇割据、宦官擅权、牛李党争倾轧与国势衰颓的时代困局，",
    "start": 10.424,
    "end": 16.641,
    "duration": 6.217
  },
  {
    "id": 4,
    "text": "李商隐一生卷入党争夹缝，沉沦下僚、辗转幕府，",
    "start": 16.912,
    "end": 20.744,
    "duration": 3.832
  },
  {
    "id": 5,
    "text": "灵心善感的气质与坎坷身世交织，开创了深情绵邈、绮丽精工的“无题诗”范式。",
    "start": 20.993,
    "end": 27.945,
    "duration": 6.952
  },
  {
    "id": 6,
    "text": "元好问在《论诗三十首》中赞其“诗家总爱西昆好，独恨无人作郑笺”。",
    "start": 28.341,
    "end": 34.628,
    "duration": 6.287
  },
  {
    "id": 7,
    "text": "李商隐无题诗的艺术特质及其所体现的晚唐审美演变，主要展现为以下四个方面：",
    "start": 34.976,
    "end": 41.716,
    "duration": 6.74
  },
  {
    "id": 8,
    "text": "第一，创制“无题”诗体，确立重心灵体验与朦胧多义的抒情范式。",
    "start": 42.337,
    "end": 47.857,
    "duration": 5.52
  },
  {
    "id": 9,
    "text": "李商隐在诗体题材上的重大革新，在于打破了古典诗歌多依傍具体时事或明确题旨的习惯。",
    "start": 48.411,
    "end": 55.748,
    "duration": 7.337
  },
  {
    "id": 10,
    "text": "他或以“无题”名篇，或截取篇首二字为题，",
    "start": 56.089,
    "end": 59.492,
    "duration": 3.403
  },
  {
    "id": 11,
    "text": "淡化具体的时间、地点与事件背景，直接以心灵情绪和整个心境作为表现对象。",
    "start": 59.853,
    "end": 66.27,
    "duration": 6.417
  },
  {
    "id": 12,
    "text": "如《无题·相见时难别亦难》中“春蚕到死丝方尽，蜡炬成灰泪始干”，",
    "start": 66.715,
    "end": 72.771,
    "duration": 6.056
  },
  {
    "id": 13,
    "text": "以生死不渝的比喻写尽执着深情；",
    "start": 73.251,
    "end": 75.949,
    "duration": 2.698
  },
  {
    "id": 14,
    "text": "《锦瑟》以“锦瑟无端五十弦，一弦一柱思华年”统摄全篇。",
    "start": 76.36,
    "end": 80.958,
    "duration": 4.598
  },
  {
    "id": 15,
    "text": "由于省略了明确的逻辑因果与本事交代，这类诗作既可作爱情深情之叹，",
    "start": 81.227,
    "end": 86.87,
    "duration": 5.643
  },
  {
    "id": 16,
    "text": "亦可作身世政治之寄托，形成了朦胧多义的解读空间。",
    "start": 87.229,
    "end": 91.556,
    "duration": 4.327
  },
  {
    "id": 17,
    "text": "第二，构筑凄美怅惘的抒情基调，真切折射晚唐士人幻灭彷徨的时代心境。",
    "start": 92.146,
    "end": 98.654,
    "duration": 6.508
  },
  {
    "id": 18,
    "text": "李商隐的诗作流露出浓郁的晚唐末世伤感情调。",
    "start": 99.075,
    "end": 102.953,
    "duration": 3.878
  },
  {
    "id": 19,
    "text": "面对帝国不可挽回的没落趋势与自身仕途的屡屡受挫，",
    "start": 103.419,
    "end": 107.663,
    "duration": 4.244
  },
  {
    "id": 20,
    "text": "盛唐士人昂扬自信的英雄气概消退，代之以幽微深沉的孤独、失落与无力感。",
    "start": 108.037,
    "end": 114.714,
    "duration": 6.677
  },
  {
    "id": 21,
    "text": "在《无题·昨夜星辰昨夜风》中，一面是“身无彩凤双飞翼，心有灵犀一点通”的心灵契合，",
    "start": 115.427,
    "end": 123.278,
    "duration": 7.851
  },
  {
    "id": 22,
    "text": "一面是“嗟余听鼓应官去，走马兰台类转蓬”的身不由己；",
    "start": 123.977,
    "end": 128.858,
    "duration": 4.881
  },
  {
    "id": 23,
    "text": "不仅无题诗如此，其即景抒怀名篇《乐游原》中“夕阳无限好，只是近黄昏”之叹，",
    "start": 129.468,
    "end": 136.379,
    "duration": 6.911
  },
  {
    "id": 24,
    "text": "更是整个晚唐士人面对繁华消逝与大厦将倾的普遍心声。",
    "start": 136.661,
    "end": 141.647,
    "duration": 4.986
  },
  {
    "id": 25,
    "text": "第三，精研深密典丽的意象与用典艺术，达成“沉博绝丽”的诗美境界。",
    "start": 142.29,
    "end": 148.497,
    "duration": 6.207
  },
  {
    "id": 26,
    "text": "在表现技巧上，李商隐创造了“绮密瑰妍”“沉博绝丽”的艺术风格。",
    "start": 148.659,
    "end": 153.912,
    "duration": 5.253
  },
  {
    "id": 27,
    "text": "他善于将内心朦胧的心象化为珠泪、玉烟、蓬山、青鸟等非现实的精美意象，",
    "start": 154.07,
    "end": 160.389,
    "duration": 6.319
  },
  {
    "id": 28,
    "text": "并以跳跃错综的方式加以组合，营造如雾里看花的凄艳诗境；",
    "start": 160.529,
    "end": 165.592,
    "duration": 5.063
  },
  {
    "id": 29,
    "text": "同时精于活用典故、推陈出新，只取原典所含的情思韵味而不拘泥于原典事理。",
    "start": 165.963,
    "end": 172.656,
    "duration": 6.693
  },
  {
    "id": 30,
    "text": "《锦瑟》颔联“庄生晓梦迷蝴蝶，望帝春心托杜鹃”借典喻示人生如梦的迷惘与伤春之哀，",
    "start": 172.889,
    "end": 180.946,
    "duration": 8.057
  },
  {
    "id": 31,
    "text": "颈联“沧海月明珠有泪，蓝田日暖玉生烟”以迷离象喻写难言之痛，",
    "start": 181.415,
    "end": 188.242,
    "duration": 6.827
  },
  {
    "id": 32,
    "text": "对仗精工、音律谐美，将近体律诗的雕琢与浑融推向新境。",
    "start": 188.37,
    "end": 194.016,
    "duration": 5.646
  },
  {
    "id": 33,
    "text": "第四，引领唐诗向精微内向演进，深刻影响宋初西昆体与晚唐五代词风。",
    "start": 194.666,
    "end": 201.48,
    "duration": 6.814
  },
  {
    "id": 34,
    "text": "李商隐的创作标志着唐诗由盛唐开阔壮大的外向气象，转向内敛幽微的心灵世界开掘。",
    "start": 201.905,
    "end": 209.315,
    "duration": 7.41
  },
  {
    "id": 35,
    "text": "他专注于微观情绪的细腻体察与复杂心境的曲折传达，",
    "start": 209.825,
    "end": 214.339,
    "duration": 4.514
  },
  {
    "id": 36,
    "text": "在盛唐李杜与中唐韩白之后，为唐诗开辟了幽约深浑的新境。",
    "start": 214.792,
    "end": 220.152,
    "duration": 5.36
  },
  {
    "id": 37,
    "text": "这种凄艳精丽的诗风不仅直接催生了宋初杨亿、钱惟演等人宗尚的“西昆体”诗歌流派，",
    "start": 220.431,
    "end": 227.628,
    "duration": 7.197
  },
  {
    "id": 38,
    "text": "其深情绵邈的意象经营与抒情方式，",
    "start": 227.791,
    "end": 231.014,
    "duration": 3.223
  },
  {
    "id": 39,
    "text": "更对温庭筠、李煜等晚唐五代词以及后世婉约词的发展产生了深远的滋养。",
    "start": 231.104,
    "end": 237.541,
    "duration": 6.437
  },
  {
    "id": 40,
    "text": "综观全诗，李商隐无题诗以身处晚唐党争夹缝中的怅惘心境为底色，",
    "start": 237.728,
    "end": 244.388,
    "duration": 6.66
  },
  {
    "id": 41,
    "text": "通过精微典丽、朦胧多义的意象组合，",
    "start": 244.388,
    "end": 247.548,
    "duration": 3.16
  },
  {
    "id": 42,
    "text": "把盛唐外向雄阔的诗风转向幽深内向的心灵体认。",
    "start": 247.548,
    "end": 252.468,
    "duration": 4.92
  },
  {
    "id": 43,
    "text": "这种“沉博绝丽”的美学新境既孕育了宋初西昆体的修辞追求，",
    "start": 252.468,
    "end": 257.668,
    "duration": 5.2
  },
  {
    "id": 44,
    "text": "也以缠绵深沉的抒情格调深刻滋养了晚唐五代及两宋婉约词风的成熟。",
    "start": 257.668,
    "end": 264.412,
    "duration": 6.744
  }
]