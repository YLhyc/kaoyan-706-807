[
  {
    "id": 1,
    "text": "试论李商隐无题诗的艺术特质与晚唐诗歌审美演变。",
    "start": 0.16,
    "end": 5.36,
    "duration": 5.2
  },
  {
    "id": 2,
    "text": "李商隐是中国古典诗歌在晚唐夕阳残照下绽放出的一座沉潜幽微的艺术奇峰。",
    "start": 5.36,
    "end": 12.8,
    "duration": 7.44
  },
  {
    "id": 3,
    "text": "面对晚唐藩镇割据加剧、宦官擅权专政、",
    "start": 12.8,
    "end": 17.12,
    "duration": 4.32
  },
  {
    "id": 4,
    "text": "牛李党争倾轧与大唐帝国不可逆转走向衰亡的历史绝境，",
    "start": 17.12,
    "end": 22.08,
    "duration": 4.96
  },
  {
    "id": 5,
    "text": "李商隐身陷党争夹缝，一生沉沦下僚、备受排挤。",
    "start": 22.08,
    "end": 27.28,
    "duration": 5.2
  },
  {
    "id": 6,
    "text": "他将身世浮沉之悲与隐秘的心灵求索融为一体，",
    "start": 27.28,
    "end": 32.24,
    "duration": 4.96
  },
  {
    "id": 7,
    "text": "开创了深情绵邈、绮丽精工的 “无题诗” 范式。",
    "start": 32.24,
    "end": 36.88,
    "duration": 4.64
  },
  {
    "id": 8,
    "text": "元好问在 《论诗三十首》 中赞其 “诗家总爱西昆好，",
    "start": 37.2,
    "end": 42.64,
    "duration": 5.44
  },
  {
    "id": 9,
    "text": "独恨无人作郑笺”。",
    "start": 42.64,
    "end": 44.48,
    "duration": 1.84
  },
  {
    "id": 10,
    "text": "李商隐无题诗的艺术特质及其所昭示的晚唐诗歌审美演变，",
    "start": 44.48,
    "end": 50.24,
    "duration": 5.76
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：",
    "start": 50.24,
    "end": 53.68,
    "duration": 3.44
  },
  {
    "id": 12,
    "text": "第一，创制“无题”诗体制，",
    "start": 53.68,
    "end": 56.56,
    "duration": 2.88
  },
  {
    "id": 13,
    "text": "确立纯粹内倾与朦胧多义的心灵抒情范式。",
    "start": 56.56,
    "end": 60.08,
    "duration": 3.52
  },
  {
    "id": 14,
    "text": "李商隐在诗歌题材体制上的重大突破，",
    "start": 60.08,
    "end": 63.76,
    "duration": 3.68
  },
  {
    "id": 15,
    "text": "在于打破了以往古典诗歌必须紧密依傍具体政治事件或日常生活题目的传统。",
    "start": 63.76,
    "end": 71.04,
    "duration": 7.28
  },
  {
    "id": 16,
    "text": "他以 “无题” 或取首句二字为题，",
    "start": 71.04,
    "end": 74.64,
    "duration": 3.6
  },
  {
    "id": 17,
    "text": "刻意抽空了具体的现实事件背景与人物原委，",
    "start": 74.64,
    "end": 79.68,
    "duration": 5.04
  },
  {
    "id": 18,
    "text": "将诗意纯粹聚焦于幽微隐秘的心灵体验。",
    "start": 79.68,
    "end": 83.92,
    "duration": 4.24
  },
  {
    "id": 19,
    "text": "在 《无题·相见时难别亦难》 中，以 “春蚕到死丝方尽，",
    "start": 83.92,
    "end": 89.84,
    "duration": 5.92
  },
  {
    "id": 20,
    "text": "蜡炬成灰泪始干” 极写深情阻隔与生命执念；",
    "start": 90.0,
    "end": 94.32,
    "duration": 4.32
  },
  {
    "id": 21,
    "text": "在 《锦瑟》 中，以 “锦瑟无端五十弦，",
    "start": 94.32,
    "end": 97.84,
    "duration": 3.52
  },
  {
    "id": 22,
    "text": "一弦一柱思华年” 笼罩全篇。",
    "start": 97.84,
    "end": 100.64,
    "duration": 2.8
  },
  {
    "id": 23,
    "text": "这种主观情感的抽离呈现，使诗歌具备了多重解读的可能，",
    "start": 100.64,
    "end": 105.92,
    "duration": 5.28
  },
  {
    "id": 24,
    "text": "既可解为深挚爱情，亦可解为政治寄托或身世之叹，",
    "start": 105.92,
    "end": 110.64,
    "duration": 4.72
  },
  {
    "id": 25,
    "text": "开创了古典诗歌多义朦胧的美学新范式。",
    "start": 110.64,
    "end": 114.08,
    "duration": 3.44
  },
  {
    "id": 26,
    "text": "第二，构筑凄美迷惘的伤感情调，",
    "start": 114.08,
    "end": 117.36,
    "duration": 3.28
  },
  {
    "id": 27,
    "text": "深刻折射晚唐士人幻灭彷徨的时代心境。",
    "start": 117.36,
    "end": 121.04,
    "duration": 3.68
  },
  {
    "id": 28,
    "text": "李商隐无题诗展现出一种浓郁的世纪末伤感美。",
    "start": 121.28,
    "end": 125.36,
    "duration": 4.08
  },
  {
    "id": 29,
    "text": "身处党争夹缝与帝国没落的黄昏期，",
    "start": 125.36,
    "end": 128.64,
    "duration": 3.28
  },
  {
    "id": 30,
    "text": "盛唐士人昂扬自信的英雄气概荡然无存，",
    "start": 128.64,
    "end": 133.04,
    "duration": 4.4
  },
  {
    "id": 31,
    "text": "取而代之的是深刻的精神困境与幻灭感。",
    "start": 133.2,
    "end": 136.88,
    "duration": 3.68
  },
  {
    "id": 32,
    "text": "诗中充满着相逢难聚的失落、时光飞逝的恐慌与无端相思的虚无。",
    "start": 136.88,
    "end": 142.48,
    "duration": 5.6
  },
  {
    "id": 33,
    "text": "在 《无题·昨夜星辰昨夜风》 中，",
    "start": 142.48,
    "end": 145.6,
    "duration": 3.12
  },
  {
    "id": 34,
    "text": "一边是 “身无彩凤双飞翼，心有灵犀一点通” 的灵魂相通，",
    "start": 145.6,
    "end": 151.416,
    "duration": 5.816
  },
  {
    "id": 35,
    "text": "一边是 “嗟余听鼓应官去，走马兰台类转蓬” 的身不由己；",
    "start": 151.416,
    "end": 157.176,
    "duration": 5.76
  },
  {
    "id": 36,
    "text": "名句 “夕阳无限好，",
    "start": 157.176,
    "end": 158.936,
    "duration": 1.76
  },
  {
    "id": 37,
    "text": "只是近黄昏” 更是整个晚唐士人无力挽回大厦将倾的普遍时代精神写照。",
    "start": 158.936,
    "end": 165.816,
    "duration": 6.88
  },
  {
    "id": 38,
    "text": "第三，精研深密典丽的意象修辞，达成“用事沉博，",
    "start": 165.816,
    "end": 170.376,
    "duration": 4.56
  },
  {
    "id": 39,
    "text": "辞采秾丽”的语言化境。",
    "start": 170.376,
    "end": 172.776,
    "duration": 2.4
  },
  {
    "id": 40,
    "text": "在艺术表现技艺上，",
    "start": 172.936,
    "end": 175.163,
    "duration": 2.227
  },
  {
    "id": 41,
    "text": "李商隐代表了古代诗歌辞采雕饰与用典艺术的巅峰。",
    "start": 175.163,
    "end": 180.608,
    "duration": 5.445
  },
  {
    "id": 42,
    "text": "他极善于化用神话传说与史书秘辛，打破传统的理性逻辑因果，",
    "start": 180.608,
    "end": 187.537,
    "duration": 6.929
  },
  {
    "id": 43,
    "text": "通过高密度的意象拼接营造出神秘凄清的诗境。",
    "start": 187.537,
    "end": 192.734,
    "duration": 5.197
  },
  {
    "id": 44,
    "text": "《锦瑟》 颔联 “庄生晓梦迷蝴蝶，望帝春心托杜鹃”，",
    "start": 192.734,
    "end": 198.674,
    "duration": 5.94
  },
  {
    "id": 45,
    "text": "将道家哲思与蜀国冤魂并列；颈联 “沧海月明珠有泪，",
    "start": 198.674,
    "end": 204.136,
    "duration": 5.462
  },
  {
    "id": 46,
    "text": "蓝田日暖玉生烟”，借鲛人滴泪成珠与温玉生烟的奇幻意象，",
    "start": 204.136,
    "end": 209.816,
    "duration": 5.68
  },
  {
    "id": 47,
    "text": "创造出如梦如幻的凄凉意境。",
    "start": 209.816,
    "end": 212.456,
    "duration": 2.64
  },
  {
    "id": 48,
    "text": "其诗对仗极其精工、辞藻华美凝练，音律协调流转，",
    "start": 212.456,
    "end": 217.416,
    "duration": 4.96
  },
  {
    "id": 49,
    "text": "达到了秾丽深博的语言极境。",
    "start": 217.416,
    "end": 219.496,
    "duration": 2.08
  },
  {
    "id": 50,
    "text": "第四，引领唐代诗歌审美转向，",
    "start": 219.896,
    "end": 222.136,
    "duration": 2.24
  },
  {
    "id": 51,
    "text": "成为晚唐诗歌走向精微内向的历史标志。",
    "start": 222.136,
    "end": 225.576,
    "duration": 3.44
  },
  {
    "id": 52,
    "text": "李商隐的诗歌创作标志着唐诗由盛唐开阔宏大的外向追求，",
    "start": 225.576,
    "end": 231.016,
    "duration": 5.44
  },
  {
    "id": 53,
    "text": "彻底走向了内敛精微的情感深掘。",
    "start": 231.016,
    "end": 233.976,
    "duration": 2.96
  },
  {
    "id": 54,
    "text": "他不再追求山河江天的宏阔气象，",
    "start": 233.976,
    "end": 237.176,
    "duration": 3.2
  },
  {
    "id": 55,
    "text": "而是专注于微观心灵世界的震颤；",
    "start": 237.176,
    "end": 239.976,
    "duration": 2.8
  },
  {
    "id": 56,
    "text": "这一审美转向不仅宣告了古典诗歌抒情深度的进一步拓展，",
    "start": 239.816,
    "end": 239.976,
    "duration": 0.16
  },
  {
    "id": 57,
    "text": "更直接影响了后世宋初杨亿、",
    "start": 239.816,
    "end": 239.976,
    "duration": 0.16
  },
  {
    "id": 58,
    "text": "钱惟演等人掀起的 “西昆体” 诗歌流派，",
    "start": 239.816,
    "end": 239.976,
    "duration": 0.16
  },
  {
    "id": 59,
    "text": "并对晚唐五代词的发展产生了深刻的哺育作用。",
    "start": 239.816,
    "end": 239.976,
    "duration": 0.16
  },
  {
    "id": 60,
    "text": "李商隐以其无题诗的纯粹诗美，",
    "start": 239.816,
    "end": 239.976,
    "duration": 0.16
  },
  {
    "id": 61,
    "text": "铸就了古典抒情诗史上又一座千古高峰。",
    "start": 239.816,
    "end": 239.976,
    "duration": 0.16
  }
]