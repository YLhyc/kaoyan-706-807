[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 2.88,
    "duration": 2.8
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 2.88,
    "end": 5.92,
    "duration": 3.04
  },
  {
    "id": 3,
    "text": "这道题考查唐宋散文史上的最大文体革新，",
    "start": 5.92,
    "end": 9.36,
    "duration": 3.44
  },
  {
    "id": 4,
    "text": "古文运动。",
    "start": 9.36,
    "end": 10.32,
    "duration": 0.96
  },
  {
    "id": 5,
    "text": "在考场上，考生不能简单只写“韩柳反对骈文”，",
    "start": 10.32,
    "end": 14.24,
    "duration": 3.92
  },
  {
    "id": 6,
    "text": "而必须紧扣“发生机制”、“理论主张”与“创作艺术成就”三大核心要素。",
    "start": 14.24,
    "end": 19.28,
    "duration": 5.04
  },
  {
    "id": 7,
    "text": "核心在于回答：古文运动为什么在中唐爆发，",
    "start": 19.52,
    "end": 23.04,
    "duration": 3.52
  },
  {
    "id": 8,
    "text": "韩柳提出了哪些成体系的理论，以及两人留下了怎样的散文典范。",
    "start": 23.04,
    "end": 27.84,
    "duration": 4.8
  },
  {
    "id": 9,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 27.84,
    "end": 30.48,
    "duration": 2.64
  },
  {
    "id": 10,
    "text": "答题必须确立“知人论世、由外入内”的历史与文本双重流线。",
    "start": 30.48,
    "end": 35.36,
    "duration": 4.88
  },
  {
    "id": 11,
    "text": "首先从政治危机、儒学复兴与文体矛盾剖析其历史发生机制，",
    "start": 35.36,
    "end": 40.08,
    "duration": 4.72
  },
  {
    "id": 12,
    "text": "然后系统总结文道合一、不平则鸣、",
    "start": 40.08,
    "end": 42.96,
    "duration": 2.88
  },
  {
    "id": 13,
    "text": "去陈言气盛言宜三大理论，随后通过韩愈与柳宗元各自的代表作展开论证，",
    "start": 42.96,
    "end": 48.8,
    "duration": 5.84
  },
  {
    "id": 14,
    "text": "最后升华其文学史正统地位。",
    "start": 48.8,
    "end": 50.88,
    "duration": 2.08
  },
  {
    "id": 15,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 51.2,
    "end": 54.32,
    "duration": 3.12
  },
  {
    "id": 16,
    "text": "全题分为四个核心论述维度：第一维度：界定古文运动作为古代散文史上最具变革意义的思想文体思潮；",
    "start": 54.32,
    "end": 62.56,
    "duration": 8.24
  },
  {
    "id": 17,
    "text": "第二维度：深入剖析古文运动在政治危机、",
    "start": 62.56,
    "end": 66.24,
    "duration": 3.68
  },
  {
    "id": 18,
    "text": "儒学复兴与骈体衰微三大层面的历史发生机制；",
    "start": 66.24,
    "end": 70.0,
    "duration": 3.76
  },
  {
    "id": 19,
    "text": "-第三维度：系统论述“文以明道”、",
    "start": 70.16,
    "end": 72.605,
    "duration": 2.445
  },
  {
    "id": 20,
    "text": "“不平则鸣”、“唯陈言之务去与气盛言宜”的理论主张；",
    "start": 72.605,
    "end": 76.679,
    "duration": 4.074
  },
  {
    "id": 21,
    "text": "-第四维度：精细剖析韩愈议论传记散文与柳宗元山水游记寓言的艺术独创性；",
    "start": 76.679,
    "end": 83.198,
    "duration": 6.519
  },
  {
    "id": 22,
    "text": "-第五维度：宏观总结古文运动对唐宋乃至后世千年散文传统的确立与深远影响。",
    "start": 83.198,
    "end": 89.92,
    "duration": 6.722
  },
  {
    "id": 23,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 90.08,
    "end": 93.92,
    "duration": 3.84
  },
  {
    "id": 24,
    "text": "全题逻辑严密咬合：第一步先确立古文运动的历史变革性质。",
    "start": 93.92,
    "end": 98.88,
    "duration": 4.96
  },
  {
    "id": 25,
    "text": "第二步探究为什么会发生，从政治社会与文体危机中寻找根源。",
    "start": 98.88,
    "end": 104.08,
    "duration": 5.2
  },
  {
    "id": 26,
    "text": "第三步剖析运动的行动纲领，即韩柳建立的文道与语言理论体系。",
    "start": 104.08,
    "end": 109.36,
    "duration": 5.28
  },
  {
    "id": 27,
    "text": "第四步剖析这些理论在韩柳具体作品中的卓越实践。",
    "start": 109.6,
    "end": 113.92,
    "duration": 4.32
  },
  {
    "id": 28,
    "text": "第五步完成宏观历史论证闭环。",
    "start": 113.92,
    "end": 116.72,
    "duration": 2.8
  },
  {
    "id": 29,
    "text": "二、各板块逐句咬合演练。",
    "start": 116.72,
    "end": 119.36,
    "duration": 2.64
  },
  {
    "id": 30,
    "text": "一、开头破题段内部咬合。",
    "start": 119.36,
    "end": 121.92,
    "duration": 2.56
  },
  {
    "id": 31,
    "text": "本段旨在开门见山确立文体革新与思想复兴的立论基石。",
    "start": 121.92,
    "end": 126.8,
    "duration": 4.88
  },
  {
    "id": 32,
    "text": "首句直切经典地位，次句交代复古旗帜下的实质革新。",
    "start": 126.8,
    "end": 131.12,
    "duration": 4.32
  },
  {
    "id": 33,
    "text": "-首先，首句必须直接亮出该运动在散文史上的最高坐标，",
    "start": 131.424,
    "end": 136.094,
    "duration": 4.67
  },
  {
    "id": 34,
    "text": "具体表述到答题语句就是：唐代中叶由韩愈、",
    "start": 136.094,
    "end": 139.749,
    "duration": 3.655
  },
  {
    "id": 35,
    "text": "柳宗元倡导的“古文运动”，是中国古代散文史上最具变革意义的文体革新与思想复兴思潮。",
    "start": 139.749,
    "end": 147.262,
    "duration": 7.513
  },
  {
    "id": 36,
    "text": "有了经典定性之后，次句必须迅速说明其“以复古为革新”的文体解放实质，",
    "start": 147.262,
    "end": 153.353,
    "duration": 6.091
  },
  {
    "id": 37,
    "text": "具体表述到答题语句就是：运动打着“复古”的旗帜，",
    "start": 153.353,
    "end": 157.414,
    "duration": 4.061
  },
  {
    "id": 38,
    "text": "实质上实现了散文文体从六朝形式至上的骈力束缚中彻底解放，",
    "start": 157.414,
    "end": 162.896,
    "duration": 5.482
  },
  {
    "id": 39,
    "text": "建立了文道合一的独立言说体系，奠定了后世中国散文的基本审美规范。，",
    "start": 162.896,
    "end": 168.988,
    "duration": 6.092
  },
  {
    "id": 40,
    "text": "这句话为下文机制、理论与艺术的三维展开奠定了坚实基调。",
    "start": 168.988,
    "end": 174.064,
    "duration": 5.076
  },
  {
    "id": 41,
    "text": "唐代中叶由韩愈、柳宗元倡导的“古文运动”，",
    "start": 174.224,
    "end": 177.984,
    "duration": 3.76
  },
  {
    "id": 42,
    "text": "是中国古代散文史上最具变革意义的文体革新与思想复兴思潮。",
    "start": 177.984,
    "end": 183.424,
    "duration": 5.44
  },
  {
    "id": 43,
    "text": "运动打着“复古”的旗帜，实质上实现了散文文体从六朝形式至上的骈力束缚中彻底解放，",
    "start": 183.424,
    "end": 191.264,
    "duration": 7.84
  },
  {
    "id": 44,
    "text": "建立了文道合一的独立言说体系，奠定了后世中国散文的基本审美规范。",
    "start": 191.264,
    "end": 196.864,
    "duration": 5.6
  },
  {
    "id": 45,
    "text": "二、第一维度：历史发生机制内部咬合。",
    "start": 197.264,
    "end": 200.944,
    "duration": 3.68
  },
  {
    "id": 46,
    "text": "本段任务是深入剖析安史之乱后政治动荡、",
    "start": 200.944,
    "end": 204.384,
    "duration": 3.44
  },
  {
    "id": 47,
    "text": "儒学衰落与骈文形式僵化三大动力。",
    "start": 204.384,
    "end": 207.584,
    "duration": 3.2
  },
  {
    "id": 48,
    "text": "首先，段首给出结论先行的分论点，",
    "start": 207.584,
    "end": 210.464,
    "duration": 2.88
  },
  {
    "id": 49,
    "text": "具体表述到答题语句就是：第一，在历史发生机制上，",
    "start": 210.464,
    "end": 214.784,
    "duration": 4.32
  },
  {
    "id": 50,
    "text": "古文运动是中唐政治危机、儒学复兴与文体演进合力催生的历史必然。",
    "start": 214.784,
    "end": 220.384,
    "duration": 5.6
  },
  {
    "id": 51,
    "text": "-随后，剖析中唐严峻的政治与思想危机，",
    "start": 220.624,
    "end": 223.88,
    "duration": 3.256
  },
  {
    "id": 52,
    "text": "具体表述到答题语句就是：安史之乱后，",
    "start": 223.88,
    "end": 227.136,
    "duration": 3.256
  },
  {
    "id": 53,
    "text": "藩镇割据加剧，宦官专权日甚，佛教与道教思想广泛浸染，",
    "start": 227.136,
    "end": 231.816,
    "duration": 4.68
  },
  {
    "id": 54,
    "text": "李唐王朝的中央权威与封建秩序陷入深刻危机。",
    "start": 231.816,
    "end": 235.886,
    "duration": 4.07
  },
  {
    "id": 55,
    "text": "紧接着，指出士大夫力图通过儒学重塑秩序的心态，",
    "start": 235.886,
    "end": 240.159,
    "duration": 4.273
  },
  {
    "id": 56,
    "text": "具体表述到答题语句就是：面对此种危局，",
    "start": 240.159,
    "end": 243.618,
    "duration": 3.459
  },
  {
    "id": 57,
    "text": "以韩愈、柳宗元为代表的中唐士大夫力图通过复兴儒家道统，",
    "start": 243.618,
    "end": 248.706,
    "duration": 5.088
  },
  {
    "id": 58,
    "text": "重构政治伦理与社会秩序。",
    "start": 248.706,
    "end": 250.944,
    "duration": 2.238
  },
  {
    "id": 59,
    "text": "-随后，揭露骈文形式僵化无法承载现实思考的文体矛盾，",
    "start": 250.944,
    "end": 255.681,
    "duration": 4.737
  },
  {
    "id": 60,
    "text": "具体表述到答题语句就是：而魏晋六朝以来盛行的骈力文体，",
    "start": 255.681,
    "end": 260.831,
    "duration": 5.15
  },
  {
    "id": 61,
    "text": "讲求声律平仄、对偶藻饰与用典堆砌，",
    "start": 260.831,
    "end": 263.921,
    "duration": 3.09
  },
  {
    "id": 62,
    "text": "其形式僵化已无法承载现实政治批判与深沉的思想论辨。",
    "start": 263.921,
    "end": 268.864,
    "duration": 4.943
  },
  {
    "id": 63,
    "text": "-最后，顺理成章得出倡导古文的历史必然性，",
    "start": 268.92,
    "end": 272.838,
    "duration": 3.918
  },
  {
    "id": 64,
    "text": "具体表述到答题语句就是：因此，倡导先秦两汉单行流畅、",
    "start": 272.838,
    "end": 277.844,
    "duration": 5.006
  },
  {
    "id": 65,
    "text": "明切适用的“古文”，便成为中唐知识阶层以文载道、",
    "start": 277.844,
    "end": 282.197,
    "duration": 4.353
  },
  {
    "id": 66,
    "text": "经世致用的强劲文化武器。",
    "start": 282.197,
    "end": 284.591,
    "duration": 2.394
  },
  {
    "id": 67,
    "text": "第一，在历史发生机制上，古文运动是中唐政治危机、",
    "start": 284.591,
    "end": 289.162,
    "duration": 4.571
  },
  {
    "id": 68,
    "text": "儒学复兴与文体演进合力催生的历史必然。",
    "start": 289.162,
    "end": 293.08,
    "duration": 3.918
  },
  {
    "id": 69,
    "text": "安史之乱后，藩镇割据加剧，宦官专权日甚，",
    "start": 293.16,
    "end": 297.0,
    "duration": 3.84
  },
  {
    "id": 70,
    "text": "佛教与道教思想广泛浸染，李唐王朝的中央权威与封建秩序陷入深刻危机。",
    "start": 297.0,
    "end": 303.08,
    "duration": 6.08
  },
  {
    "id": 71,
    "text": "面对此种危局，以韩愈、柳宗元为代表的中唐士大夫力图通过复兴儒家道统，",
    "start": 303.08,
    "end": 309.16,
    "duration": 6.08
  },
  {
    "id": 72,
    "text": "重构政治伦理与社会秩序。",
    "start": 309.16,
    "end": 311.16,
    "duration": 2.0
  },
  {
    "id": 73,
    "text": "而魏晋六朝以来盛行的骈力文体，讲求声律平仄、",
    "start": 311.16,
    "end": 315.08,
    "duration": 3.92
  },
  {
    "id": 74,
    "text": "对偶藻饰与用典堆砌，其形式僵化已无法承载现实政治批判与深沉的思想论辨。",
    "start": 315.08,
    "end": 321.48,
    "duration": 6.4
  },
  {
    "id": 75,
    "text": "因此，倡导先秦两汉单行流畅、明切适用的“古文”，",
    "start": 321.64,
    "end": 326.52,
    "duration": 4.88
  },
  {
    "id": 76,
    "text": "便成为中唐知识阶层以文载道、经世致用的强劲文化武器。",
    "start": 326.52,
    "end": 332.04,
    "duration": 5.52
  },
  {
    "id": 77,
    "text": "三、第二维度：核心理论主张建构内部咬合。",
    "start": 332.04,
    "end": 336.2,
    "duration": 4.16
  },
  {
    "id": 78,
    "text": "本段任务是系统梳理文道合一、不平则鸣、",
    "start": 336.2,
    "end": 340.12,
    "duration": 3.92
  },
  {
    "id": 79,
    "text": "去陈言气盛言宜三大命题。",
    "start": 340.12,
    "end": 342.44,
    "duration": 2.32
  },
  {
    "id": 80,
    "text": "-首先，段首给出统领分论点，具体表述到答题语句就是：第二，",
    "start": 342.6,
    "end": 347.931,
    "duration": 5.331
  },
  {
    "id": 81,
    "text": "在理论主张上，古文运动构建了融政治功用、",
    "start": 347.931,
    "end": 351.93,
    "duration": 3.999
  },
  {
    "id": 82,
    "text": "思想抒发与语言革新于一体的严密理论系统。",
    "start": 351.93,
    "end": 356.15,
    "duration": 4.22
  },
  {
    "id": 83,
    "text": "随后，剖析第一主张“文以明道”，",
    "start": 356.15,
    "end": 358.816,
    "duration": 2.666
  },
  {
    "id": 84,
    "text": "具体表述到答题语句就是：首先是确立“文以明道”与“文道合一”的核心宗旨。",
    "start": 358.816,
    "end": 365.48,
    "duration": 6.664
  },
  {
    "id": 85,
    "text": "韩愈在《原道》中明确将道统归结为尧舜禹汤、",
    "start": 365.56,
    "end": 370.04,
    "duration": 4.48
  },
  {
    "id": 86,
    "text": "文武周公孔孟的儒家仁义道德，主张文是阐明儒道的形式载体，",
    "start": 370.04,
    "end": 375.96,
    "duration": 5.92
  },
  {
    "id": 87,
    "text": "反对脱离教化的浮艳虚辞。",
    "start": 375.96,
    "end": 378.44,
    "duration": 2.48
  },
  {
    "id": 88,
    "text": "紧接着，剖析第二主张“不平则鸣”，",
    "start": 378.44,
    "end": 381.72,
    "duration": 3.28
  },
  {
    "id": 89,
    "text": "具体表述到答题语句就是：其次是提出“不平则鸣”的抒情动力说。",
    "start": 381.72,
    "end": 387.0,
    "duration": 5.28
  },
  {
    "id": 90,
    "text": "韩愈在《送孟东野序》中指出，大凡物不得其平则鸣，",
    "start": 387.24,
    "end": 392.04,
    "duration": 4.8
  },
  {
    "id": 91,
    "text": "将士人在现实中的沉沦坎坷视为文学创作的深层源泉。",
    "start": 392.04,
    "end": 396.52,
    "duration": 4.48
  },
  {
    "id": 92,
    "text": "-最后，剖析第三主张语言美学原则，",
    "start": 396.816,
    "end": 399.848,
    "duration": 3.032
  },
  {
    "id": 93,
    "text": "具体表述到答题语句就是：最后是制定了“唯陈言之务去”与“气盛言宜”的语言美学法则。",
    "start": 399.848,
    "end": 407.427,
    "duration": 7.579
  },
  {
    "id": 94,
    "text": "韩愈强调“词必己出”，坚决剔除陈腐套语，",
    "start": 407.427,
    "end": 410.892,
    "duration": 3.465
  },
  {
    "id": 95,
    "text": "并在《答李翊书》中指出“气盛则言之短长与声之高下皆宜”，",
    "start": 410.892,
    "end": 415.873,
    "duration": 4.981
  },
  {
    "id": 96,
    "text": "将作者充沛的主体道德精神视为驾驭文章音律与句式的根本动力。",
    "start": 415.873,
    "end": 421.936,
    "duration": 6.063
  },
  {
    "id": 97,
    "text": "第二，在理论主张上，古文运动构建了融政治功用、",
    "start": 422.016,
    "end": 426.496,
    "duration": 4.48
  },
  {
    "id": 98,
    "text": "思想抒发与语言革新于一体的严密理论系统。",
    "start": 426.496,
    "end": 430.496,
    "duration": 4.0
  },
  {
    "id": 99,
    "text": "首先是确立“文以明道”与“文道合一”的核心宗旨。",
    "start": 430.496,
    "end": 434.256,
    "duration": 3.76
  },
  {
    "id": 100,
    "text": "韩愈在《原道》中明确将道统归结为尧舜禹汤、",
    "start": 434.256,
    "end": 438.416,
    "duration": 4.16
  },
  {
    "id": 101,
    "text": "文武周公孔孟的儒家仁义道德，主张文是阐明儒道的形式载体，",
    "start": 438.416,
    "end": 444.016,
    "duration": 5.6
  },
  {
    "id": 102,
    "text": "反对脱离教化的浮艳虚辞。",
    "start": 444.016,
    "end": 446.336,
    "duration": 2.32
  },
  {
    "id": 103,
    "text": "其次是提出“不平则鸣”的抒情动力说。",
    "start": 446.736,
    "end": 449.856,
    "duration": 3.12
  },
  {
    "id": 104,
    "text": "韩愈在《送孟东野序》中指出，大凡物不得其平则鸣，",
    "start": 449.856,
    "end": 454.176,
    "duration": 4.32
  },
  {
    "id": 105,
    "text": "将士人在现实中的沉沦坎坷视为文学创作的深层源泉。",
    "start": 454.176,
    "end": 458.576,
    "duration": 4.4
  },
  {
    "id": 106,
    "text": "最后是制定了“唯陈言之务去”与“气盛言宜”的语言美学法则。",
    "start": 458.576,
    "end": 463.776,
    "duration": 5.2
  },
  {
    "id": 107,
    "text": "韩愈强调“词必己出”，坚决剔除陈腐套语，",
    "start": 463.776,
    "end": 467.456,
    "duration": 3.68
  },
  {
    "id": 108,
    "text": "并在《答李翊书》中指出“气盛则言之短长与声之高下皆宜”，",
    "start": 467.456,
    "end": 472.096,
    "duration": 4.64
  },
  {
    "id": 109,
    "text": "将作者充沛的主体道德精神视为驾驭文章音律与句式的根本动力。",
    "start": 472.096,
    "end": 476.816,
    "duration": 4.72
  },
  {
    "id": 110,
    "text": "四、第三维度：韩柳散文艺术独创成就内部咬合。",
    "start": 477.136,
    "end": 481.536,
    "duration": 4.4
  },
  {
    "id": 111,
    "text": "本段任务是分述韩愈的雄肆议论传记与柳宗元的清冷山水寓言，",
    "start": 481.536,
    "end": 486.816,
    "duration": 5.28
  },
  {
    "id": 112,
    "text": "落实作品细节。",
    "start": 486.816,
    "end": 488.256,
    "duration": 1.44
  },
  {
    "id": 113,
    "text": "首先，段首给出统领分论点，具体表述到答题语句就是：第三，",
    "start": 488.256,
    "end": 493.616,
    "duration": 5.36
  },
  {
    "id": 114,
    "text": "在散文创作艺术上，韩愈与柳宗元各辟蹊径，",
    "start": 493.616,
    "end": 497.696,
    "duration": 4.08
  },
  {
    "id": 115,
    "text": "共同拓展了古代散文的审美边界与文体样式。",
    "start": 497.696,
    "end": 501.056,
    "duration": 3.36
  },
  {
    "id": 116,
    "text": "-随后，剖析韩愈议论文《师说》与传记文《张中丞传后序》，",
    "start": 501.296,
    "end": 506.069,
    "duration": 4.773
  },
  {
    "id": 117,
    "text": "具体表述到答题语句就是：韩愈长于议论文的严密论辩与史传文的情感灌注。",
    "start": 506.069,
    "end": 513.341,
    "duration": 7.272
  },
  {
    "id": 118,
    "text": "其议论散文如《师说》，以三层对比剖析时弊，",
    "start": 513.341,
    "end": 517.205,
    "duration": 3.864
  },
  {
    "id": 119,
    "text": "句式骈散结合，逻辑环环相扣，文气雄肆奔放。",
    "start": 517.205,
    "end": 521.296,
    "duration": 4.091
  },
  {
    "id": 120,
    "text": "其传记文如《张中丞传后序》，借南计云拔刀断指等动人细节，",
    "start": 521.456,
    "end": 526.736,
    "duration": 5.28
  },
  {
    "id": 121,
    "text": "刻画出壮烈殉国的英雄气概，兼具史家严谨与小说生动。",
    "start": 526.736,
    "end": 531.456,
    "duration": 4.72
  },
  {
    "id": 122,
    "text": "-紧接着，调取《祭十二郎文》的抒情成就：其抒情散文《祭十二郎文》则以家常语倾泻肺腑真情，",
    "start": 531.672,
    "end": 539.721,
    "duration": 8.049
  },
  {
    "id": 123,
    "text": "“字字是血，字字是泪”，创造了叙事抒情散文的极高境界。",
    "start": 539.721,
    "end": 544.64,
    "duration": 4.919
  },
  {
    "id": 124,
    "text": "随后，转向柳宗元山水游记的独创性，",
    "start": 544.64,
    "end": 547.994,
    "duration": 3.354
  },
  {
    "id": 125,
    "text": "具体表述到答题语句就是：柳宗元则在贬哲永州、",
    "start": 547.994,
    "end": 552.466,
    "duration": 4.472
  },
  {
    "id": 126,
    "text": "柳州的幽囚境遇中，开拓出山水游记与寓言散文的新境界。",
    "start": 552.466,
    "end": 557.832,
    "duration": 5.366
  },
  {
    "id": 127,
    "text": "其《永州八记》如《小石潭记》，语言冷峻峻洁，",
    "start": 557.992,
    "end": 561.752,
    "duration": 3.76
  },
  {
    "id": 128,
    "text": "以“潭中鱼可百许头，皆若空游无所依”的白描神笔，",
    "start": 561.752,
    "end": 566.472,
    "duration": 4.72
  },
  {
    "id": 129,
    "text": "借清冷景物折射自身孤寂高洁的贬哲心境。",
    "start": 566.472,
    "end": 570.232,
    "duration": 3.76
  },
  {
    "id": 130,
    "text": "最后，调取其寓言散文的讽刺成就，",
    "start": 570.232,
    "end": 573.272,
    "duration": 3.04
  },
  {
    "id": 131,
    "text": "具体表述到答题语句就是：其寓言散文如《三戒》与《捕蛇者说》，",
    "start": 573.272,
    "end": 578.232,
    "duration": 4.96
  },
  {
    "id": 132,
    "text": "以小见大，借黔之驴的虚骄与苛政猛于虎的残酷现实，",
    "start": 578.232,
    "end": 583.032,
    "duration": 4.8
  },
  {
    "id": 133,
    "text": "展现出极强的讽刺艺术与批判力量。",
    "start": 583.032,
    "end": 585.752,
    "duration": 2.72
  },
  {
    "id": 134,
    "text": "第三，在散文创作艺术上，韩愈与柳宗元各辟蹊径，",
    "start": 586.072,
    "end": 590.952,
    "duration": 4.88
  },
  {
    "id": 135,
    "text": "共同拓展了古代散文的审美边界与文体样式。",
    "start": 590.952,
    "end": 594.872,
    "duration": 3.92
  },
  {
    "id": 136,
    "text": "韩愈长于议论文的严密论辩与史传文的情感灌注。",
    "start": 594.872,
    "end": 599.432,
    "duration": 4.56
  },
  {
    "id": 137,
    "text": "其议论散文如《师说》，以三层对比剖析时弊，",
    "start": 599.432,
    "end": 603.672,
    "duration": 4.24
  },
  {
    "id": 138,
    "text": "句式骈散结合，逻辑环环相扣，文气雄肆奔放。",
    "start": 603.672,
    "end": 607.912,
    "duration": 4.24
  },
  {
    "id": 139,
    "text": "其传记文如《张中丞传后序》，借南计云拔刀断指等动人细节，",
    "start": 608.232,
    "end": 614.072,
    "duration": 5.84
  },
  {
    "id": 140,
    "text": "刻画出壮烈殉国的英雄气概，兼具史家严谨与小说生动。",
    "start": 614.072,
    "end": 619.112,
    "duration": 5.04
  },
  {
    "id": 141,
    "text": "其抒情散文《祭十二郎文》则以家常语倾泻肺腑真情，",
    "start": 619.112,
    "end": 623.752,
    "duration": 4.64
  },
  {
    "id": 142,
    "text": "“字字是血，字字是泪”，创造了叙事抒情散文的极高境界。",
    "start": 623.752,
    "end": 628.472,
    "duration": 4.72
  },
  {
    "id": 143,
    "text": "柳宗元则在贬哲永州、柳州的幽囚境遇中，",
    "start": 628.792,
    "end": 632.712,
    "duration": 3.92
  },
  {
    "id": 144,
    "text": "开拓出山水游记与寓言散文的新境界。",
    "start": 632.712,
    "end": 636.392,
    "duration": 3.68
  },
  {
    "id": 145,
    "text": "其《永州八记》如《小石潭记》，语言冷峻峻洁，",
    "start": 636.392,
    "end": 641.032,
    "duration": 4.64
  },
  {
    "id": 146,
    "text": "以“潭中鱼可百许头，皆若空游无所依”的白描神笔，",
    "start": 641.032,
    "end": 645.832,
    "duration": 4.8
  },
  {
    "id": 147,
    "text": "借清冷景物折射自身孤寂高洁的贬哲心境。",
    "start": 645.832,
    "end": 649.512,
    "duration": 3.68
  },
  {
    "id": 148,
    "text": "其寓言散文如《三戒》与《捕蛇者说》，",
    "start": 649.752,
    "end": 653.112,
    "duration": 3.36
  },
  {
    "id": 149,
    "text": "以小见大，借黔之驴的虚骄与苛政猛于虎的残酷现实，",
    "start": 653.112,
    "end": 658.712,
    "duration": 5.6
  },
  {
    "id": 150,
    "text": "展现出极强的讽刺艺术与批判力量。",
    "start": 658.712,
    "end": 661.832,
    "duration": 3.12
  },
  {
    "id": 151,
    "text": "五、结尾收束升华段内部咬合。",
    "start": 661.832,
    "end": 664.952,
    "duration": 3.12
  },
  {
    "id": 152,
    "text": "本段承担全篇论证成果的系统提炼与历史定位，",
    "start": 664.952,
    "end": 668.952,
    "duration": 4.0
  },
  {
    "id": 153,
    "text": "收束在唐宋八大家散文正统的建构上。",
    "start": 668.952,
    "end": 672.072,
    "duration": 3.12
  },
  {
    "id": 154,
    "text": "-首先，全面回收道统、散体与名家成果，",
    "start": 672.288,
    "end": 675.25,
    "duration": 2.962
  },
  {
    "id": 155,
    "text": "具体表述到答题语句就是：综上所述，",
    "start": 675.25,
    "end": 678.213,
    "duration": 2.963
  },
  {
    "id": 156,
    "text": "唐代古文运动以儒家道统为灵魂，以散体文法为骨骼，",
    "start": 678.213,
    "end": 682.558,
    "duration": 4.345
  },
  {
    "id": 157,
    "text": "以韩柳名作为血肉，彻底扭转了骈丽文风一统天下的僵化格局。",
    "start": 682.558,
    "end": 687.693,
    "duration": 5.135
  },
  {
    "id": 158,
    "text": "紧接着，总结对宋代欧苏及后世千年的深远奠基，",
    "start": 687.693,
    "end": 691.643,
    "duration": 3.95
  },
  {
    "id": 159,
    "text": "具体表述到答题语句就是：它不仅在唐代实现了文体的空前解放，",
    "start": 691.643,
    "end": 696.976,
    "duration": 5.333
  },
  {
    "id": 160,
    "text": "更经由宋代欧阳修、苏轼等人的接续发扬，",
    "start": 696.976,
    "end": 700.333,
    "duration": 3.357
  },
  {
    "id": 161,
    "text": "构筑了中国古代散文延绵千年的正统脉络。",
    "start": 700.333,
    "end": 703.888,
    "duration": 3.555
  },
  {
    "id": 162,
    "text": "综上所述，唐代古文运动以儒家道统为灵魂，",
    "start": 703.968,
    "end": 708.128,
    "duration": 4.16
  },
  {
    "id": 163,
    "text": "以散体文法为骨骼，以韩柳名作为血肉，",
    "start": 708.128,
    "end": 712.128,
    "duration": 4.0
  },
  {
    "id": 164,
    "text": "彻底扭转了骈丽文风一统天下的僵化格局。",
    "start": 712.128,
    "end": 715.808,
    "duration": 3.68
  },
  {
    "id": 165,
    "text": "它不仅在唐代实现了文体的空前解放，",
    "start": 715.808,
    "end": 719.168,
    "duration": 3.36
  },
  {
    "id": 166,
    "text": "更经由宋代欧阳修、苏轼等人的接续发扬，",
    "start": 719.168,
    "end": 723.008,
    "duration": 3.84
  },
  {
    "id": 167,
    "text": "构筑了中国古代散文延绵千年的正统脉络。",
    "start": 723.008,
    "end": 726.768,
    "duration": 3.76
  }
]