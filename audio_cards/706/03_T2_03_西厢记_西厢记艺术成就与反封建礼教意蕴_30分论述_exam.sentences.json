[
  {
    "id": 1,
    "text": "试论《西厢记》的艺术成就与反封建礼教意蕴。",
    "start": 0.099,
    "end": 3.77,
    "duration": 3.671
  },
  {
    "id": 2,
    "text": "《西厢记》是元代杂剧文人创作的艺术高峰，也是中国古典戏曲中反抗封建礼教的代表作。",
    "start": 4.27,
    "end": 11.166,
    "duration": 6.896
  },
  {
    "id": 3,
    "text": "王实甫在唐代元稹《莺莺传》与金代董解元《西厢记诸宫调》的基础上推陈出新，",
    "start": 11.666,
    "end": 17.701,
    "duration": 6.035
  },
  {
    "id": 4,
    "text": "将才子佳人故事改造为追求婚姻自主的戏剧冲突，",
    "start": 18.051,
    "end": 22.084,
    "duration": 4.033
  },
  {
    "id": 5,
    "text": "在剧终响亮喊出“愿普天下有情的都成了眷属”。",
    "start": 22.522,
    "end": 26.675,
    "duration": 4.153
  },
  {
    "id": 6,
    "text": "朱权在《太和正音谱》中赞其曲词如“花间美人”。",
    "start": 27.212,
    "end": 31.687,
    "duration": 4.475
  },
  {
    "id": 7,
    "text": "全剧的思想意蕴与艺术成就，主要体现在以下四个方面：",
    "start": 32.189,
    "end": 36.427,
    "duration": 4.238
  },
  {
    "id": 8,
    "text": "第一，高扬反抗封建礼教旗帜，确立以情抗礼与婚姻自主的进步主题。",
    "start": 37.063,
    "end": 43.306,
    "duration": 6.243
  },
  {
    "id": 9,
    "text": "《西厢记》的突出意义，在于正面否定了封建家长包办婚姻的“父母之命，媒妁之言”。",
    "start": 43.806,
    "end": 49.925,
    "duration": 6.119
  },
  {
    "id": 10,
    "text": "剧中崔莺莺与张生冲破名分、门第与礼法的重重束缚，",
    "start": 50.425,
    "end": 54.981,
    "duration": 4.556
  },
  {
    "id": 11,
    "text": "将男女双方的真诚爱恋置于功名利禄与宗法礼教之上；",
    "start": 55.489,
    "end": 60.004,
    "duration": 4.515
  },
  {
    "id": 12,
    "text": "剧作无情揭露并批判了封建礼教卫道士崔老夫人的虚伪与冷酷，",
    "start": 60.504,
    "end": 65.912,
    "duration": 5.408
  },
  {
    "id": 13,
    "text": "撕破其借“不招白衣女婿”为名赖婚逼考的假面。",
    "start": 66.323,
    "end": 70.54,
    "duration": 4.217
  },
  {
    "id": 14,
    "text": "王实甫摆脱了传统才子佳人故事依附科举功名或“报恩合礼”的旧套，",
    "start": 71.04,
    "end": 76.792,
    "duration": 5.752
  },
  {
    "id": 15,
    "text": "肯定个体正当情感的合理性，使爱情题材上升为冲决封建道德枷锁的思想力量。",
    "start": 77.2,
    "end": 83.53,
    "duration": 6.33
  },
  {
    "id": 16,
    "text": "第二，着力刻画人物内心矛盾，塑造性格鲜明的反抗者群像。",
    "start": 84.213,
    "end": 89.354,
    "duration": 5.141
  },
  {
    "id": 17,
    "text": "在人物塑造上，王实甫精于揭示人物细微复杂的恋爱心理。",
    "start": 89.926,
    "end": 94.702,
    "duration": 4.776
  },
  {
    "id": 18,
    "text": "崔莺莺身为相国千金，长期受深闺礼教熏陶，性格兼具热情与矜持：",
    "start": 95.244,
    "end": 101.598,
    "duration": 6.354
  },
  {
    "id": 19,
    "text": "她初遇张生即暗生情愫，却因礼教拘束而在“闹简”“赖简”中屡屡做出内热外冷的试探与掩饰；",
    "start": 102.07,
    "end": 110.443,
    "duration": 8.373
  },
  {
    "id": 20,
    "text": "张生志诚笃厚、执着痴情，为爱情不惜抛却功名，甚至相思成疾、误解诗谜而跳墙；",
    "start": 110.943,
    "end": 118.35,
    "duration": 7.407
  },
  {
    "id": 21,
    "text": "侍女红娘则机智泼辣、富于侠义，在关键戏眼“拷红”中面对老夫人严刑威逼，",
    "start": 118.85,
    "end": 125.013,
    "duration": 6.163
  },
  {
    "id": 22,
    "text": "巧用礼教信义反客为主，逼使老夫人屈服，成为维护青年恋情的坚定助力。",
    "start": 125.363,
    "end": 131.507,
    "duration": 6.144
  },
  {
    "id": 23,
    "text": "第三，突破元杂剧四折常规体制，创造宏大而又紧凑严密的五本联套结构。",
    "start": 132.111,
    "end": 138.688,
    "duration": 6.577
  },
  {
    "id": 24,
    "text": "在戏剧体制上，王实甫打破了元杂剧一本四折及由单一主角主唱的成规，",
    "start": 139.297,
    "end": 145.122,
    "duration": 5.825
  },
  {
    "id": 25,
    "text": "首创“五本二十折”的宏大联套体制，并用〔络丝娘煞尾〕沟通前后两本，",
    "start": 145.57,
    "end": 151.113,
    "duration": 5.543
  },
  {
    "id": 26,
    "text": "在部分折子中采用末旦轮唱，增强了舞台表现力。",
    "start": 151.463,
    "end": 155.249,
    "duration": 3.786
  },
  {
    "id": 27,
    "text": "全剧围绕老夫人与青年一代、以及崔张红三人之间的主辅两条矛盾线索展开，",
    "start": 155.749,
    "end": 161.317,
    "duration": 5.568
  },
  {
    "id": 28,
    "text": "从佛殿奇遇、月下联吟、孙飞虎兵围普救寺与白马解围，",
    "start": 161.667,
    "end": 166.291,
    "duration": 4.624
  },
  {
    "id": 29,
    "text": "到老夫人赖婚、琴心传情、拷红许婚与长亭送别，矛盾起伏跌宕、环环相扣，",
    "start": 166.641,
    "end": 173.075,
    "duration": 6.434
  },
  {
    "id": 30,
    "text": "既具长篇巨制的规模，又保持了场次衔接的紧凑严密。",
    "start": 173.425,
    "end": 177.664,
    "duration": 4.239
  },
  {
    "id": 31,
    "text": "第四，兼备诗词雅趣与戏曲本色，达到元代剧作语言的典范境界。",
    "start": 178.258,
    "end": 184.189,
    "duration": 5.931
  },
  {
    "id": 32,
    "text": "《西厢记》的语言艺术被徐复祚赞为“字字当行，言言本色”。",
    "start": 184.821,
    "end": 189.767,
    "duration": 4.946
  },
  {
    "id": 33,
    "text": "王实甫在曲词中巧妙融汇唐诗宋词的清雅意象与元代民间口语，且能因人设辞、贴合舞台表演动作。",
    "start": 190.35,
    "end": 199.763,
    "duration": 9.413
  },
  {
    "id": 34,
    "text": "第四本第三折“长亭送别”开篇“碧云天，黄花地，西风紧，北雁南飞。晓来谁染霜林醉？总是离人泪”，",
    "start": 200.263,
    "end": 210.263,
    "duration": 10.0
  },
  {
    "id": 35,
    "text": "化用范仲淹词境而情景交融、声泪俱下；",
    "start": 210.823,
    "end": 214.135,
    "duration": 3.312
  },
  {
    "id": 36,
    "text": "红娘的宾白与唱词则明快犀利、俏皮生动。",
    "start": 214.635,
    "end": 218.406,
    "duration": 3.771
  },
  {
    "id": 37,
    "text": "这种文采与本色相生的艺术风貌，直接启迪了后世《牡丹亭》《红楼梦》等反礼教名著。",
    "start": 218.973,
    "end": 225.702,
    "duration": 6.729
  },
  {
    "id": 38,
    "text": "由是观之，王实甫《西厢记》脱胎于唐传奇与金代诸宫调而大胆翻新，",
    "start": 226.202,
    "end": 232.047,
    "duration": 5.845
  },
  {
    "id": 39,
    "text": "借张生、崔莺莺与红娘的反礼教抗争，",
    "start": 232.397,
    "end": 235.215,
    "duration": 2.818
  },
  {
    "id": 40,
    "text": "高扬了“愿普天下有情的都成了眷属”的婚姻自主理想。",
    "start": 235.565,
    "end": 239.824,
    "duration": 4.259
  },
  {
    "id": 41,
    "text": "全剧以五本联套宏大结构与兼具文采本色的曲词成就元杂剧巅峰，",
    "start": 240.324,
    "end": 246.054,
    "duration": 5.73
  },
  {
    "id": 42,
    "text": "直接启迪了明代《牡丹亭》主情戏曲与清代《红楼梦》等反对礼教压迫的经典之作。",
    "start": 246.404,
    "end": 252.928,
    "duration": 6.524
  }
]
