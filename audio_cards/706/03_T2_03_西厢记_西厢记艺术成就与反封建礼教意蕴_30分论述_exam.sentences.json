[
  {
    "id": 1,
    "text": "试论《西厢记》的艺术成就与反封建礼教意蕴。",
    "start": 0.0,
    "end": 4.014,
    "duration": 4.014
  },
  {
    "id": 2,
    "text": "《西厢记》 是元代杂剧文人创作艺术的至高巅峰，",
    "start": 4.014,
    "end": 7.737,
    "duration": 3.723
  },
  {
    "id": 3,
    "text": "也是中国古典戏曲中反抗封建礼教的里程碑巨作。",
    "start": 7.737,
    "end": 12.115,
    "duration": 4.378
  },
  {
    "id": 4,
    "text": "面对元代激烈的民族压迫与封建正统礼教对人性欲望的残酷扼杀，",
    "start": 12.115,
    "end": 19.648,
    "duration": 7.533
  },
  {
    "id": 5,
    "text": "王实甫改造了唐代元稹 《莺莺传》 始乱终弃的才子负心模式与宋金董解元 《西厢记诸宫调》 的说唱体制，",
    "start": 19.648,
    "end": 22.654,
    "duration": 3.006
  },
  {
    "id": 6,
    "text": "第一次以宏伟优美的戏剧结构，",
    "start": 22.654,
    "end": 26.393,
    "duration": 3.739
  },
  {
    "id": 7,
    "text": "将一桩男欢女爱的风流韵事重构为追求婚恋自由的正义斗争。",
    "start": 26.393,
    "end": 33.329,
    "duration": 6.936
  },
  {
    "id": 8,
    "text": "全剧响亮喊出 “愿普天下有情的都成了眷属” 的时代最强音。",
    "start": 33.329,
    "end": 38.712,
    "duration": 5.383
  },
  {
    "id": 9,
    "text": "朱权在 《太和正音谱》 中评其曲词如 “花间美人”。",
    "start": 38.712,
    "end": 41.812,
    "duration": 3.1
  },
  {
    "id": 10,
    "text": "其思想意蕴与艺术成就，主要展现为以下四个核心维度：",
    "start": 41.812,
    "end": 47.826,
    "duration": 6.014
  },
  {
    "id": 11,
    "text": "第一，高扬反抗封建礼教大旗，",
    "start": 47.826,
    "end": 50.493,
    "duration": 2.667
  },
  {
    "id": 12,
    "text": "确立以情抗礼与婚姻自主的进步思想主题。",
    "start": 50.493,
    "end": 55.943,
    "duration": 5.45
  },
  {
    "id": 13,
    "text": "《西厢记》 的划时代意义，",
    "start": 55.943,
    "end": 59.89,
    "duration": 3.947
  },
  {
    "id": 14,
    "text": "在于彻底否定了封建宗法门阀制度支配婚姻的 “父母之命，",
    "start": 59.89,
    "end": 64.437,
    "duration": 4.547
  },
  {
    "id": 15,
    "text": "媒妁之言”。",
    "start": 64.437,
    "end": 67.08,
    "duration": 2.643
  },
  {
    "id": 16,
    "text": "剧中崔莺莺与张生冲破名分、门第与封建节烈的重重罗网，",
    "start": 67.08,
    "end": 72.334,
    "duration": 5.254
  },
  {
    "id": 17,
    "text": "将男女双方内在的精神契合与真挚爱恋置于一切礼法之上；",
    "start": 72.334,
    "end": 77.214,
    "duration": 4.88
  },
  {
    "id": 18,
    "text": "剧作对封建礼教的卫道士崔老夫人进行了无情的解剖与批判，",
    "start": 77.214,
    "end": 83.731,
    "duration": 6.517
  },
  {
    "id": 19,
    "text": "揭露其借守制之名悔婚赖婚的虚伪与冷酷。",
    "start": 83.731,
    "end": 88.999,
    "duration": 5.268
  },
  {
    "id": 20,
    "text": "王实甫冲破了传统小说教化团圆的陈腐说教，",
    "start": 88.999,
    "end": 94.051,
    "duration": 5.052
  },
  {
    "id": 21,
    "text": "肯定了个体人性欲望的合理性，",
    "start": 94.051,
    "end": 97.043,
    "duration": 2.992
  },
  {
    "id": 22,
    "text": "使爱情题材上升为摧毁封建道德枷锁的精神利刃。",
    "start": 97.043,
    "end": 101.077,
    "duration": 4.034
  },
  {
    "id": 23,
    "text": "第二，成功塑造立体鲜活的反抗者形象，",
    "start": 101.077,
    "end": 104.212,
    "duration": 3.135
  },
  {
    "id": 24,
    "text": "确立性格各异的典型人物谱系。",
    "start": 104.212,
    "end": 108.55,
    "duration": 4.338
  },
  {
    "id": 25,
    "text": "在人物塑造上，王实甫展现了卓越的心灵解剖技巧。",
    "start": 108.55,
    "end": 113.95,
    "duration": 5.4
  },
  {
    "id": 26,
    "text": "崔莺莺身处相国千金与深闺礼教的重重禁锢之下，",
    "start": 113.95,
    "end": 119.771,
    "duration": 5.821
  },
  {
    "id": 27,
    "text": "性格具有深沉的复杂性：她既对张生怀抱强烈的爱慕与追求，",
    "start": 119.771,
    "end": 125.806,
    "duration": 6.035
  },
  {
    "id": 28,
    "text": "又不得不顾及名节教养而表现出矜持、退缩乃至矛盾伪饰；",
    "start": 125.806,
    "end": 131.26,
    "duration": 5.454
  },
  {
    "id": 29,
    "text": "张生志诚笃厚、多情执着，为了爱情不惜功名利禄，",
    "start": 131.26,
    "end": 135.165,
    "duration": 3.905
  },
  {
    "id": 30,
    "text": "甚至相思成疾；侍女红娘则是全剧最具光彩的反叛典型，",
    "start": 135.165,
    "end": 139.593,
    "duration": 4.428
  },
  {
    "id": 31,
    "text": "她机智勇敢、不畏强暴，在最核心的戏眼 “拷红” 中，",
    "start": 139.593,
    "end": 145.313,
    "duration": 5.72
  },
  {
    "id": 32,
    "text": "面对老夫人的严刑拷打，",
    "start": 145.313,
    "end": 147.905,
    "duration": 2.592
  },
  {
    "id": 33,
    "text": "义正辞严地揭露老夫人言而无信与治家不严的丑行，",
    "start": 147.905,
    "end": 153.832,
    "duration": 5.927
  },
  {
    "id": 34,
    "text": "以婢女身份反客为主审判主子，成为正义与勇气的化身。",
    "start": 153.832,
    "end": 158.391,
    "duration": 4.559
  },
  {
    "id": 35,
    "text": "第三，打破元杂剧四折常规体制，",
    "start": 158.391,
    "end": 161.327,
    "duration": 2.936
  },
  {
    "id": 36,
    "text": "创造宏大繁复而又严密严谨的五本联套结构。",
    "start": 161.327,
    "end": 165.712,
    "duration": 4.385
  },
  {
    "id": 37,
    "text": "在戏曲形式上，王实甫打破了元杂剧传统单一由主角一人主唱、",
    "start": 165.712,
    "end": 172.556,
    "duration": 6.844
  },
  {
    "id": 38,
    "text": "一剧仅有四折一楔子的狭小体制。",
    "start": 172.556,
    "end": 176.291,
    "duration": 3.735
  },
  {
    "id": 39,
    "text": "作者首创了 “五本二十一折” 的长篇戏曲鸿篇巨制：",
    "start": 176.291,
    "end": 182.398,
    "duration": 6.107
  },
  {
    "id": 40,
    "text": "以张崔二人由寺院偶遇、联吟定情、兵围借兵、老夫人赖婚、",
    "start": 182.398,
    "end": 188.365,
    "duration": 5.967
  },
  {
    "id": 41,
    "text": "琴心传情、病笃跳墙，到拷红完聚与长亭送别，",
    "start": 188.365,
    "end": 191.714,
    "duration": 3.349
  },
  {
    "id": 42,
    "text": "全剧矛盾冲突跌宕起伏，主线突出而支线交织；情节张弛有度、",
    "start": 191.714,
    "end": 196.351,
    "duration": 4.637
  },
  {
    "id": 43,
    "text": "前后照应，既具长篇戏剧的宏大规模，",
    "start": 196.351,
    "end": 200.61,
    "duration": 4.259
  },
  {
    "id": 44,
    "text": "又保持了场次转换的紧凑严密，",
    "start": 200.61,
    "end": 202.997,
    "duration": 2.387
  },
  {
    "id": 45,
    "text": "标志着元杂剧叙事结构走向高度成熟。",
    "start": 202.997,
    "end": 207.509,
    "duration": 4.512
  },
  {
    "id": 46,
    "text": "第四，创造兼备诗词雅趣与市井生机的曲词艺术，",
    "start": 207.509,
    "end": 211.534,
    "duration": 4.025
  },
  {
    "id": 47,
    "text": "达到古典戏曲语言的至高境界。",
    "start": 211.534,
    "end": 213.783,
    "duration": 2.249
  },
  {
    "id": 48,
    "text": "《西厢记》 的语言艺术代表了元曲审美的最高水准。",
    "start": 213.783,
    "end": 218.454,
    "duration": 4.671
  },
  {
    "id": 49,
    "text": "王实甫在曲词中巧妙融合了唐诗宋词的典雅意境与元代民间白话的活泼口吻，",
    "start": 218.454,
    "end": 219.492,
    "duration": 1.038
  },
  {
    "id": 50,
    "text": "做到了文质彬彬、珠圆玉润。",
    "start": 219.492,
    "end": 221.792,
    "duration": 2.3
  },
  {
    "id": 51,
    "text": "在千古绝唱 《长亭送别》 中，以 “碧云天，黄花地，",
    "start": 221.792,
    "end": 223.056,
    "duration": 1.264
  },
  {
    "id": 52,
    "text": "西风紧，北雁南飞。",
    "start": 223.056,
    "end": 223.738,
    "duration": 0.682
  },
  {
    "id": 53,
    "text": "晓来谁染霜林醉？",
    "start": 223.738,
    "end": 226.295,
    "duration": 2.557
  },
  {
    "id": 54,
    "text": "总是离人泪” 开篇，作者信手点染范仲淹词境，以景衬情、",
    "start": 226.295,
    "end": 228.279,
    "duration": 1.984
  },
  {
    "id": 55,
    "text": "声泪俱下；在人物宾白中，红娘语言明快犀利、",
    "start": 228.279,
    "end": 233.168,
    "duration": 4.889
  },
  {
    "id": 56,
    "text": "插科打诨自然熨帖。",
    "start": 233.168,
    "end": 237.399,
    "duration": 4.231
  },
  {
    "id": 57,
    "text": "这种雅俗共赏的曲词风貌，成为后世明清戏曲无可逾越的艺术典范。",
    "start": 237.399,
    "end": 238.96,
    "duration": 1.561
  }
]