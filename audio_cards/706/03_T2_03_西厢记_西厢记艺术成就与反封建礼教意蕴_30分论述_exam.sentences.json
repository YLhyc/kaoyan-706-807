[
  {
    "id": 1,
    "text": "试论《西厢记》的艺术成就与反封建礼教意蕴。",
    "start": 0.134,
    "end": 3.306,
    "duration": 3.172
  },
  {
    "id": 2,
    "text": "《西厢记》是元代杂剧文人创作的艺术高峰，也是中国古典戏曲中反抗封建礼教的代表作。",
    "start": 3.983,
    "end": 10.515,
    "duration": 6.532
  },
  {
    "id": 3,
    "text": "王实甫在唐代元稹《莺莺传》与金代董解元《西厢记诸宫调》的基础上推陈出新，",
    "start": 11.233,
    "end": 17.525,
    "duration": 6.292
  },
  {
    "id": 4,
    "text": "将才子佳人故事改造为追求婚姻自主的戏剧冲突，",
    "start": 17.904,
    "end": 21.876,
    "duration": 3.972
  },
  {
    "id": 5,
    "text": "在剧终响亮喊出“愿普天下有情的都成了眷属”。",
    "start": 22.255,
    "end": 25.777,
    "duration": 3.522
  },
  {
    "id": 6,
    "text": "朱权在《太和正音谱》中赞其曲词如“花间美人”。",
    "start": 26.415,
    "end": 29.987,
    "duration": 3.572
  },
  {
    "id": 7,
    "text": "全剧的思想意蕴与艺术成就，主要体现在以下四个方面：",
    "start": 30.825,
    "end": 40.757,
    "duration": 9.932
  },
  {
    "id": 8,
    "text": "第一，高扬反抗封建礼教旗帜，确立以情抗礼与婚姻自主的进步主题。",
    "start": 41.435,
    "end": 47.247,
    "duration": 5.812
  },
  {
    "id": 9,
    "text": "《西厢记》的突出意义，在于正面否定了封建家长包办婚姻的“父母之命，媒妁之言”。",
    "start": 47.965,
    "end": 56.977,
    "duration": 9.012
  },
  {
    "id": 10,
    "text": "剧中崔莺莺与张生冲破名分、门第与礼法的重重束缚，",
    "start": 57.695,
    "end": 59.747,
    "duration": 2.052
  },
  {
    "id": 11,
    "text": "将男女双方的真诚爱恋置于功名利禄与宗法礼教之上；",
    "start": 60.126,
    "end": 63.048,
    "duration": 2.922
  },
  {
    "id": 12,
    "text": "剧作无情揭露并批判了封建礼教卫道士崔老夫人的虚伪与冷酷，",
    "start": 63.577,
    "end": 65.949,
    "duration": 2.372
  },
  {
    "id": 13,
    "text": "撕破其借“不招白衣女婿”为名赖婚逼考的假面。",
    "start": 66.328,
    "end": 67.74,
    "duration": 1.412
  },
  {
    "id": 14,
    "text": "王实甫摆脱了传统才子佳人故事依附科举功名或“报恩合礼”的旧套，",
    "start": 68.378,
    "end": 73.31,
    "duration": 4.932
  },
  {
    "id": 15,
    "text": "肯定个体正当情感的合理性，使爱情题材上升为冲决封建道德枷锁的思想力量。",
    "start": 73.689,
    "end": 79.421,
    "duration": 5.732
  },
  {
    "id": 16,
    "text": "第二，着力刻画人物内心矛盾，塑造性格鲜明的反抗者群像。",
    "start": 80.099,
    "end": 85.071,
    "duration": 4.972
  },
  {
    "id": 17,
    "text": "在人物塑造上，王实甫精于揭示人物细微复杂的恋爱心理。",
    "start": 85.709,
    "end": 90.121,
    "duration": 4.412
  },
  {
    "id": 18,
    "text": "崔莺莺身为相国千金，长期受深闺礼教熏陶，性格兼具热情与矜持：",
    "start": 90.759,
    "end": 96.411,
    "duration": 5.652
  },
  {
    "id": 19,
    "text": "她初遇张生即暗生情愫，却因礼教拘束而在“闹简”“赖简”中屡屡做出内热外冷的试探与掩饰；",
    "start": 96.79,
    "end": 107.042,
    "duration": 10.252
  },
  {
    "id": 20,
    "text": "张生志诚笃厚、执着痴情，为爱情不惜抛却功名，甚至相思成疾、误解诗谜而跳墙；",
    "start": 107.676,
    "end": 112.128,
    "duration": 4.452
  },
  {
    "id": 21,
    "text": "侍女红娘则机智泼辣、富于侠义，在关键戏眼“拷红”中面对老夫人严刑威逼，",
    "start": 112.657,
    "end": 118.189,
    "duration": 5.532
  },
  {
    "id": 22,
    "text": "巧用礼教信义反客为主，逼使老夫人屈服，成为维护青年恋情的坚定助力。",
    "start": 118.568,
    "end": 123.9,
    "duration": 5.332
  },
  {
    "id": 23,
    "text": "第三，突破元杂剧四折常规体制，创造宏大而又紧凑严密的五本联套结构。",
    "start": 124.524,
    "end": 130.736,
    "duration": 6.212
  },
  {
    "id": 24,
    "text": "在戏剧体制上，王实甫打破了元杂剧一本四折及由单一主角主唱的成规，",
    "start": 131.374,
    "end": 136.986,
    "duration": 5.612
  },
  {
    "id": 25,
    "text": "首创“五本二十折”的宏大联套体制，并用〔络丝娘煞尾〕沟通前后两本，",
    "start": 137.365,
    "end": 140.177,
    "duration": 2.812
  },
  {
    "id": 26,
    "text": "在部分折子中采用末旦轮唱，增强了舞台表现力。",
    "start": 140.768,
    "end": 147.26,
    "duration": 6.492
  },
  {
    "id": 27,
    "text": "全剧围绕老夫人与青年一代、以及崔张红三人之间的主辅两条矛盾线索展开，",
    "start": 147.995,
    "end": 153.927,
    "duration": 5.932
  },
  {
    "id": 28,
    "text": "从佛殿奇遇、月下联吟、孙飞虎兵围普救寺与白马解围，",
    "start": 154.355,
    "end": 158.847,
    "duration": 4.492
  },
  {
    "id": 29,
    "text": "到老夫人赖婚、琴心传情、拷红许婚与长亭送别，矛盾起伏跌宕、环环相扣，",
    "start": 159.403,
    "end": 165.535,
    "duration": 6.132
  },
  {
    "id": 30,
    "text": "既具长篇巨制的规模，又保持了场次衔接的紧凑严密。",
    "start": 165.914,
    "end": 170.086,
    "duration": 4.172
  },
  {
    "id": 31,
    "text": "第四，兼备诗词雅趣与戏曲本色，达到元代剧作语言的典范境界。",
    "start": 170.776,
    "end": 176.268,
    "duration": 5.492
  },
  {
    "id": 32,
    "text": "《西厢记》的语言艺术被徐复祚赞为“字字当行，言言本色”。",
    "start": 176.946,
    "end": 181.198,
    "duration": 4.252
  },
  {
    "id": 33,
    "text": "王实甫在曲词中巧妙融汇唐诗宋词的清雅意象与元代民间口语，且能因人设辞、贴合舞台表演动作。",
    "start": 181.956,
    "end": 190.688,
    "duration": 8.732
  },
  {
    "id": 34,
    "text": "第四本第三折“长亭送别”开篇“碧云天，黄花地，西风紧，北雁南飞。晓来谁染霜林醉？总是离人泪”，",
    "start": 191.366,
    "end": 194.778,
    "duration": 3.412
  },
  {
    "id": 35,
    "text": "化用范仲淹词境而情景交融、声泪俱下；",
    "start": 195.157,
    "end": 196.529,
    "duration": 1.372
  },
  {
    "id": 36,
    "text": "红娘的宾白与唱词则明快犀利、俏皮生动。",
    "start": 197.058,
    "end": 199.84,
    "duration": 2.782
  },
  {
    "id": 37,
    "text": "这种文采与本色相生的艺术风貌，直接启迪了后世《牡丹亭》《红楼梦》等反礼教名著。",
    "start": 200.518,
    "end": 216.099,
    "duration": 15.581
  },
  {
    "id": 38,
    "text": "由是观之，王实甫《西厢记》脱胎于唐传奇与金代诸宫调而大胆翻新，",
    "start": 216.628,
    "end": 221.92,
    "duration": 5.292
  },
  {
    "id": 39,
    "text": "借张生、崔莺莺与红娘的反礼教抗争，",
    "start": 222.299,
    "end": 224.951,
    "duration": 2.652
  },
  {
    "id": 40,
    "text": "高扬了“愿普天下有情的都成了眷属”的婚姻自主理想。",
    "start": 225.33,
    "end": 228.862,
    "duration": 3.532
  },
  {
    "id": 41,
    "text": "全剧以五本联套宏大结构与兼具文采本色的曲词成就元杂剧巅峰，",
    "start": 229.391,
    "end": 234.803,
    "duration": 5.412
  },
  {
    "id": 42,
    "text": "直接启迪了明代《牡丹亭》主情戏曲与清代《红楼梦》等反对礼教压迫的经典之作。",
    "start": 235.182,
    "end": 240.954,
    "duration": 5.772
  }
]