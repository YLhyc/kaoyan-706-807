[
  {
    "id": 1,
    "text": "试论汉乐府“感于哀乐，缘事而发”的现实情怀与叙事艺术成就。",
    "start": 0.085,
    "end": 6.13,
    "duration": 6.045
  },
  {
    "id": 2,
    "text": "两汉乐府民歌是中国古典诗歌现实主义叙事传统的划时代高峰。",
    "start": 6.677,
    "end": 12.376,
    "duration": 5.699
  },
  {
    "id": 3,
    "text": "面对汉武帝以后徭役繁重、战争连年、",
    "start": 12.714,
    "end": 15.956,
    "duration": 3.242
  },
  {
    "id": 4,
    "text": "阶级分化与门阀宗法礼教压迫的严酷现实，",
    "start": 16.132,
    "end": 19.902,
    "duration": 3.77
  },
  {
    "id": 5,
    "text": "汉代乐府官署深入民间采集歌谣，",
    "start": 20.235,
    "end": 23.311,
    "duration": 3.076
  },
  {
    "id": 6,
    "text": "全面继承并发展了 《诗经》 的风雅精神。",
    "start": 23.571,
    "end": 26.577,
    "duration": 3.006
  },
  {
    "id": 7,
    "text": "班固在 《汉书·艺文志》 中精辟概括其特质为 “感于哀乐，",
    "start": 26.821,
    "end": 31.147,
    "duration": 4.326
  },
  {
    "id": 8,
    "text": "缘事而发”。",
    "start": 31.302,
    "end": 32.221,
    "duration": 0.919
  },
  {
    "id": 9,
    "text": "汉乐府彻底摆脱了西汉辞赋粉饰大一统盛世的浮华积习，",
    "start": 32.619,
    "end": 37.125,
    "duration": 4.506
  },
  {
    "id": 10,
    "text": "第一次以质朴深沉的民间心声构建起生动的生活画卷。",
    "start": 37.183,
    "end": 41.317,
    "duration": 4.134
  },
  {
    "id": 11,
    "text": "其现实情怀与叙事艺术成就，主要展现为以下四个核心维度：",
    "start": 41.526,
    "end": 46.577,
    "duration": 5.051
  },
  {
    "id": 12,
    "text": "第一，确立“感于哀乐，缘事而发”的现实主义批判精神，",
    "start": 46.959,
    "end": 51.441,
    "duration": 4.482
  },
  {
    "id": 13,
    "text": "深沉直面民生苦难。",
    "start": 51.749,
    "end": 53.634,
    "duration": 1.885
  },
  {
    "id": 14,
    "text": "“感于哀乐，缘事而发” 是汉乐府最根本的现实主义灵魂。",
    "start": 54.361,
    "end": 58.867,
    "duration": 4.506
  },
  {
    "id": 15,
    "text": "所谓“缘事而发”，即诗歌紧扣社会生活中的真实事件展开，",
    "start": 59.338,
    "end": 64.261,
    "duration": 4.923
  },
  {
    "id": 16,
    "text": "不作凭空的玄虚之论；所谓“感于哀乐”，",
    "start": 64.345,
    "end": 68.269,
    "duration": 3.924
  },
  {
    "id": 17,
    "text": "即深刻倾注劳动人民真实的喜怒哀乐。",
    "start": 68.299,
    "end": 71.413,
    "duration": 3.114
  },
  {
    "id": 18,
    "text": "其作品题材极为广泛：在 《十五从军征》 中，",
    "start": 71.619,
    "end": 74.926,
    "duration": 3.307
  },
  {
    "id": 19,
    "text": "以 “十五从军征，",
    "start": 75.16,
    "end": 76.239,
    "duration": 1.079
  },
  {
    "id": 20,
    "text": "八十始得归” 控诉兵役制度对个体生命的残酷剥夺，",
    "start": 76.239,
    "end": 80.031,
    "duration": 3.792
  },
  {
    "id": 21,
    "text": "展现老年残兵归家唯见草木坟茔的极致悲酸；",
    "start": 80.099,
    "end": 83.814,
    "duration": 3.715
  },
  {
    "id": 22,
    "text": "在 《东门行》 中，写下底层贫民拔剑而起的绝望愤怒；",
    "start": 84.115,
    "end": 88.012,
    "duration": 3.897
  },
  {
    "id": 23,
    "text": "在 《妇病行》 中，写病妇临终托孤的凄惨景象。",
    "start": 88.107,
    "end": 91.6,
    "duration": 3.493
  },
  {
    "id": 24,
    "text": "这些作品真切反映了底层百姓水深火热的生活图景，",
    "start": 91.77,
    "end": 95.792,
    "duration": 4.022
  },
  {
    "id": 25,
    "text": "洋溢着强烈的反抗与批判力量。",
    "start": 95.942,
    "end": 98.321,
    "duration": 2.379
  },
  {
    "id": 26,
    "text": "第二，推动诗歌体式由四言向五言叙事诗演进，",
    "start": 98.589,
    "end": 102.758,
    "duration": 4.169
  },
  {
    "id": 27,
    "text": "奠定古典长篇叙事诗体制基石。",
    "start": 102.864,
    "end": 105.55,
    "duration": 2.686
  },
  {
    "id": 28,
    "text": "汉乐府在文体形式上作出了开创性贡献，",
    "start": 105.742,
    "end": 108.768,
    "duration": 3.026
  },
  {
    "id": 29,
    "text": "它冲破了四言诗句式的封闭局限，",
    "start": 108.938,
    "end": 111.819,
    "duration": 2.881
  },
  {
    "id": 30,
    "text": "推动了中国古代文人五言诗的成熟。",
    "start": 111.864,
    "end": 114.415,
    "duration": 2.551
  },
  {
    "id": 31,
    "text": "尤其是乐府民歌中叙事成分的大幅度提升，",
    "start": 114.67,
    "end": 118.181,
    "duration": 3.511
  },
  {
    "id": 32,
    "text": "使诗歌具备了交代完整事件前因后果与人物命运起伏的能力。",
    "start": 118.494,
    "end": 123.206,
    "duration": 4.712
  },
  {
    "id": 33,
    "text": "其长篇叙事绝唱 《孔雀东南飞》，长达一千七百余字，",
    "start": 123.771,
    "end": 128.27,
    "duration": 4.499
  },
  {
    "id": 34,
    "text": "全篇情节严整，围绕兰芝自请遣归、阿兄逼嫁、",
    "start": 128.777,
    "end": 133.293,
    "duration": 4.516
  },
  {
    "id": 35,
    "text": "焦刘双双殉情的线索层层推进，波澜起伏、扣人心弦，",
    "start": 133.673,
    "end": 138.613,
    "duration": 4.94
  },
  {
    "id": 36,
    "text": "标志着中国古代叙事诗艺术达到了完全成熟的阶段。第三，",
    "start": 139.052,
    "end": 143.695,
    "duration": 4.643
  },
  {
    "id": 37,
    "text": "长于在激烈矛盾冲突中运用个性化语言与传神细节塑造性格典型。",
    "start": 144.048,
    "end": 149.646,
    "duration": 5.598
  },
  {
    "id": 38,
    "text": "汉乐府极善于借助戏剧化的冲突与对话白描刻画人物灵魂。",
    "start": 149.896,
    "end": 155.07,
    "duration": 5.174
  },
  {
    "id": 39,
    "text": "《孔雀东南飞》 塑造了一组性格极具反差的人物群像：",
    "start": 155.189,
    "end": 158.977,
    "duration": 3.788
  },
  {
    "id": 40,
    "text": "刘兰芝坚贞自尊、外柔内刚，在被逐出门时 “精做衣服，",
    "start": 159.247,
    "end": 163.521,
    "duration": 4.274
  },
  {
    "id": 41,
    "text": "事事四五通”，以此捍卫自身的人格尊严；",
    "start": 163.542,
    "end": 166.361,
    "duration": 2.819
  },
  {
    "id": 42,
    "text": "焦仲卿深情重义却性格懦弱，在专横跋扈的焦母面前进退两难；",
    "start": 166.522,
    "end": 171.697,
    "duration": 5.175
  },
  {
    "id": 43,
    "text": "焦母唯我独尊、蛮横专断；阿兄市侩冷酷、趋炎附势。",
    "start": 171.896,
    "end": 176.994,
    "duration": 5.098
  },
  {
    "id": 44,
    "text": "在 《陌上桑》 中，女主人公秦罗敷面对使君调戏，",
    "start": 177.22,
    "end": 180.743,
    "duration": 3.523
  },
  {
    "id": 45,
    "text": "以极具夸饰的机智言辞赞美夫婿，",
    "start": 180.979,
    "end": 183.596,
    "duration": 2.617
  },
  {
    "id": 46,
    "text": "言笑晏晏间将权贵的丑恶嘴脸嘲弄殆尽，人物性格鲜活饱满。",
    "start": 183.846,
    "end": 188.922,
    "duration": 5.076
  },
  {
    "id": 47,
    "text": "第四，丰富了古典抒情手法的表现力，",
    "start": 189.227,
    "end": 192.035,
    "duration": 2.808
  },
  {
    "id": 48,
    "text": "直接哺育建安风骨与杜甫即事名篇。",
    "start": 192.395,
    "end": 195.474,
    "duration": 3.079
  },
  {
    "id": 49,
    "text": "汉乐府不仅以现实主义叙事著称，",
    "start": 195.662,
    "end": 198.3,
    "duration": 2.638
  },
  {
    "id": 50,
    "text": "同样开创了融浪漫想象与托物起兴于一体的高超抒情技艺。",
    "start": 198.328,
    "end": 203.959,
    "duration": 5.631
  },
  {
    "id": 51,
    "text": "《孔雀东南飞》 开篇以 “孔雀东南飞，",
    "start": 204.068,
    "end": 206.808,
    "duration": 2.74
  },
  {
    "id": 52,
    "text": "五里一徘徊” 起兴营造悲怆基调，",
    "start": 206.946,
    "end": 209.384,
    "duration": 2.438
  },
  {
    "id": 53,
    "text": "结尾以两人合葬化为相思树、鸳鸯飞鸣的神话想象，",
    "start": 209.499,
    "end": 213.721,
    "duration": 4.222
  },
  {
    "id": 54,
    "text": "表达了人民反抗礼教、追求爱情永恒的浪漫理想；",
    "start": 213.812,
    "end": 217.599,
    "duration": 3.787
  },
  {
    "id": 55,
    "text": "《江南》 运用 “莲叶何田田，",
    "start": 217.828,
    "end": 220.002,
    "duration": 2.174
  },
  {
    "id": 56,
    "text": "鱼戏莲叶东” 的复沓民歌手法，极具民间音乐的明朗灵动。",
    "start": 220.204,
    "end": 224.681,
    "duration": 4.477
  },
  {
    "id": 57,
    "text": "汉乐府这种直面现实、长于叙事的优良传统，直接哺育了曹操、",
    "start": 224.83,
    "end": 229.793,
    "duration": 4.963
  },
  {
    "id": 58,
    "text": "曹植的建安文学，",
    "start": 229.793,
    "end": 231.169,
    "duration": 1.376
  },
  {
    "id": 59,
    "text": "并成为唐代杜甫即事名篇与白居易新乐府运动的母体源头。",
    "start": 231.333,
    "end": 236.352,
    "duration": 5.019
  }
]
