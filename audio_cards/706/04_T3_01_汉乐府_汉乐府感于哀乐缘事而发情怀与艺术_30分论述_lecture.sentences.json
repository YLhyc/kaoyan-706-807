[
  {
    "id": 1,
    "text": "试论汉乐府“感于哀乐，缘事而发”的现实情怀与叙事艺术成就。",
    "start": 0.16,
    "end": 6.276,
    "duration": 6.116
  },
  {
    "id": 2,
    "text": "两汉乐府民歌是中国古典诗歌现实主义叙事传统的划时代高峰。",
    "start": 6.276,
    "end": 12.498,
    "duration": 6.222
  },
  {
    "id": 3,
    "text": "面对汉武帝以后徭役繁重、战争连年、",
    "start": 12.498,
    "end": 16.276,
    "duration": 3.778
  },
  {
    "id": 4,
    "text": "阶级分化与门阀宗法礼教压迫的严酷现实，",
    "start": 16.276,
    "end": 20.498,
    "duration": 4.222
  },
  {
    "id": 5,
    "text": "汉代乐府官署深入民间采集歌谣，",
    "start": 20.498,
    "end": 23.831,
    "duration": 3.333
  },
  {
    "id": 6,
    "text": "全面继承并发展了 《诗经》 的风雅精神。",
    "start": 23.831,
    "end": 27.92,
    "duration": 4.089
  },
  {
    "id": 7,
    "text": "班固在 《汉书·艺文志》 中精辟概括其特质为 “感于哀乐，",
    "start": 27.92,
    "end": 33.44,
    "duration": 5.52
  },
  {
    "id": 8,
    "text": "缘事而发”。",
    "start": 33.44,
    "end": 34.4,
    "duration": 0.96
  },
  {
    "id": 9,
    "text": "汉乐府彻底摆脱了西汉辞赋粉饰大一统盛世的浮华积习，",
    "start": 34.4,
    "end": 39.2,
    "duration": 4.8
  },
  {
    "id": 10,
    "text": "第一次以质朴深沉的民间心声构建起生动的生活画卷。",
    "start": 39.2,
    "end": 44.0,
    "duration": 4.8
  },
  {
    "id": 11,
    "text": "其现实情怀与叙事艺术成就，主要展现为以下四个核心维度：",
    "start": 44.0,
    "end": 50.4,
    "duration": 6.4
  },
  {
    "id": 12,
    "text": "第一，确立“感于哀乐，缘事而发”的现实主义批判精神，",
    "start": 50.4,
    "end": 56.8,
    "duration": 6.4
  },
  {
    "id": 13,
    "text": "深沉直面民生苦难。",
    "start": 56.8,
    "end": 58.32,
    "duration": 1.52
  },
  {
    "id": 14,
    "text": "“感于哀乐，缘事而发” 是汉乐府最根本的现实主义灵魂。",
    "start": 58.32,
    "end": 64.16,
    "duration": 5.84
  },
  {
    "id": 15,
    "text": "所谓“缘事而发”，即诗歌紧扣社会生活中的真实事件展开，",
    "start": 64.48,
    "end": 70.72,
    "duration": 6.24
  },
  {
    "id": 16,
    "text": "不作凭空的玄虚之论；所谓“感于哀乐”，",
    "start": 70.72,
    "end": 74.804,
    "duration": 4.084
  },
  {
    "id": 17,
    "text": "即深刻倾注劳动人民真实的喜怒哀乐。",
    "start": 74.804,
    "end": 78.219,
    "duration": 3.415
  },
  {
    "id": 18,
    "text": "其作品题材极为广泛：在 《十五从军征》 中，",
    "start": 78.219,
    "end": 82.237,
    "duration": 4.018
  },
  {
    "id": 19,
    "text": "以 “十五从军征，",
    "start": 82.237,
    "end": 83.845,
    "duration": 1.608
  },
  {
    "id": 20,
    "text": "八十始得归” 控诉兵役制度对个体生命的残酷剥夺，",
    "start": 83.845,
    "end": 88.465,
    "duration": 4.62
  },
  {
    "id": 21,
    "text": "展现老年残兵归家唯见草木坟茔的极致悲酸；",
    "start": 88.465,
    "end": 92.48,
    "duration": 4.015
  },
  {
    "id": 22,
    "text": "在 《东门行》 中，写下底层贫民拔剑而起的绝望愤怒；",
    "start": 92.48,
    "end": 96.96,
    "duration": 4.48
  },
  {
    "id": 23,
    "text": "在 《妇病行》 中，写病妇临终托孤的凄惨景象。",
    "start": 96.96,
    "end": 101.68,
    "duration": 4.72
  },
  {
    "id": 24,
    "text": "这些作品真切反映了底层百姓水深火热的生活图景，",
    "start": 101.68,
    "end": 106.32,
    "duration": 4.64
  },
  {
    "id": 25,
    "text": "洋溢着强烈的反抗与批判力量。",
    "start": 106.32,
    "end": 108.72,
    "duration": 2.4
  },
  {
    "id": 26,
    "text": "第二，推动诗歌体式由四言向五言叙事诗演进，",
    "start": 108.88,
    "end": 112.88,
    "duration": 4.0
  },
  {
    "id": 27,
    "text": "奠定古典长篇叙事诗体制基石。",
    "start": 112.88,
    "end": 115.52,
    "duration": 2.64
  },
  {
    "id": 28,
    "text": "汉乐府在文体形式上作出了开创性贡献，",
    "start": 115.52,
    "end": 119.36,
    "duration": 3.84
  },
  {
    "id": 29,
    "text": "它冲破了四言诗句式的封闭局限，",
    "start": 119.36,
    "end": 122.16,
    "duration": 2.8
  },
  {
    "id": 30,
    "text": "推动了中国古代文人五言诗的成熟。",
    "start": 122.16,
    "end": 125.92,
    "duration": 3.76
  },
  {
    "id": 31,
    "text": "尤其是乐府民歌中叙事成分的大幅度提升，",
    "start": 125.92,
    "end": 131.04,
    "duration": 5.12
  },
  {
    "id": 32,
    "text": "使诗歌具备了交代完整事件前因后果与人物命运起伏的能力。",
    "start": 131.04,
    "end": 137.92,
    "duration": 6.88
  },
  {
    "id": 33,
    "text": "其长篇叙事绝唱 《孔雀东南飞》，长达一千七百余字，",
    "start": 137.92,
    "end": 142.8,
    "duration": 4.88
  },
  {
    "id": 34,
    "text": "全篇情节严整，围绕兰芝自请遣归、阿兄逼嫁、",
    "start": 142.8,
    "end": 147.52,
    "duration": 4.72
  },
  {
    "id": 35,
    "text": "焦刘双双殉情的线索层层推进，波澜起伏、扣人心弦，",
    "start": 147.52,
    "end": 152.128,
    "duration": 4.608
  },
  {
    "id": 36,
    "text": "标志着中国古代叙事诗艺术达到了完全成熟的阶段。第三，",
    "start": 152.128,
    "end": 157.568,
    "duration": 5.44
  },
  {
    "id": 37,
    "text": "长于在激烈矛盾冲突中运用个性化语言与传神细节塑造性格典型。",
    "start": 157.568,
    "end": 163.408,
    "duration": 5.84
  },
  {
    "id": 38,
    "text": "汉乐府极善于借助戏剧化的冲突与对话白描刻画人物灵魂。",
    "start": 163.568,
    "end": 168.448,
    "duration": 4.88
  },
  {
    "id": 39,
    "text": "《孔雀东南飞》 塑造了一组性格极具反差的人物群像：",
    "start": 168.448,
    "end": 173.808,
    "duration": 5.36
  },
  {
    "id": 40,
    "text": "刘兰芝坚贞自尊、外柔内刚，在被逐出门时 “精做衣服，",
    "start": 173.808,
    "end": 179.648,
    "duration": 5.84
  },
  {
    "id": 41,
    "text": "事事四五通”，以此捍卫自身的人格尊严；",
    "start": 179.648,
    "end": 183.568,
    "duration": 3.92
  },
  {
    "id": 42,
    "text": "焦仲卿深情重义却性格懦弱，在专横跋扈的焦母面前进退两难；",
    "start": 183.808,
    "end": 189.328,
    "duration": 5.52
  },
  {
    "id": 43,
    "text": "焦母唯我独尊、蛮横专断；阿兄市侩冷酷、趋炎附势。",
    "start": 189.328,
    "end": 194.368,
    "duration": 5.04
  },
  {
    "id": 44,
    "text": "在 《陌上桑》 中，女主人公秦罗敷面对使君调戏，",
    "start": 194.368,
    "end": 198.848,
    "duration": 4.48
  },
  {
    "id": 45,
    "text": "以极具夸饰的机智言辞赞美夫婿，",
    "start": 198.848,
    "end": 202.048,
    "duration": 3.2
  },
  {
    "id": 46,
    "text": "言笑晏晏间将权贵的丑恶嘴脸嘲弄殆尽，人物性格鲜活饱满。",
    "start": 202.048,
    "end": 208.128,
    "duration": 6.08
  },
  {
    "id": 47,
    "text": "第四，丰富了古典抒情手法的表现力，",
    "start": 208.128,
    "end": 211.408,
    "duration": 3.28
  },
  {
    "id": 48,
    "text": "直接哺育建安风骨与杜甫即事名篇。",
    "start": 211.408,
    "end": 214.528,
    "duration": 3.12
  },
  {
    "id": 49,
    "text": "汉乐府不仅以现实主义叙事著称，",
    "start": 214.528,
    "end": 217.488,
    "duration": 2.96
  },
  {
    "id": 50,
    "text": "同样开创了融浪漫想象与托物起兴于一体的高超抒情技艺。",
    "start": 217.728,
    "end": 222.917,
    "duration": 5.189
  },
  {
    "id": 51,
    "text": "《孔雀东南飞》 开篇以 “孔雀东南飞，",
    "start": 222.917,
    "end": 226.31,
    "duration": 3.393
  },
  {
    "id": 52,
    "text": "五里一徘徊” 起兴营造悲怆基调，",
    "start": 226.31,
    "end": 229.303,
    "duration": 2.993
  },
  {
    "id": 53,
    "text": "结尾以两人合葬化为相思树、鸳鸯飞鸣的神话想象，",
    "start": 229.303,
    "end": 233.893,
    "duration": 4.59
  },
  {
    "id": 54,
    "text": "表达了人民反抗礼教、追求爱情永恒的浪漫理想；",
    "start": 233.893,
    "end": 236.288,
    "duration": 2.395
  },
  {
    "id": 55,
    "text": "《江南》 运用 “莲叶何田田，",
    "start": 236.088,
    "end": 236.288,
    "duration": 0.2
  },
  {
    "id": 56,
    "text": "鱼戏莲叶东” 的复沓民歌手法，极具民间音乐的明朗灵动。",
    "start": 236.088,
    "end": 236.288,
    "duration": 0.2
  },
  {
    "id": 57,
    "text": "汉乐府这种直面现实、长于叙事的优良传统，直接哺育了曹操、",
    "start": 236.088,
    "end": 236.288,
    "duration": 0.2
  },
  {
    "id": 58,
    "text": "曹植的建安文学，",
    "start": 236.088,
    "end": 236.288,
    "duration": 0.2
  },
  {
    "id": 59,
    "text": "并成为唐代杜甫即事名篇与白居易新乐府运动的母体源头。",
    "start": 236.088,
    "end": 236.288,
    "duration": 0.2
  }
]