[
  {
    "id": 1,
    "text": "试论汉乐府“感于哀乐，缘事而发”的现实情怀与叙事艺术成就。",
    "start": 0.101,
    "end": 5.592,
    "duration": 5.491
  },
  {
    "id": 2,
    "text": "两汉乐府民歌是中国古代诗歌现实主义叙事传统的高峰。",
    "start": 6.092,
    "end": 10.282,
    "duration": 4.19
  },
  {
    "id": 3,
    "text": "面对汉武帝以后徭役繁重、战争频仍、贫富悬殊以及豪强兼并与宗法礼教的压迫，",
    "start": 10.782,
    "end": 17.374,
    "duration": 6.592
  },
  {
    "id": 4,
    "text": "乐府官署深入民间采诗，继承并发展了《诗经》的风雅精神。",
    "start": 17.724,
    "end": 22.576,
    "duration": 4.852
  },
  {
    "id": 5,
    "text": "班固在《汉书·艺文志》中概括其特质为“感于哀乐，缘事而发”。",
    "start": 23.076,
    "end": 28.319,
    "duration": 5.243
  },
  {
    "id": 6,
    "text": "汉乐府摆脱了西汉大赋铺张润色盛世的浮华风气，以质朴生动的民间心声再现社会百态。",
    "start": 28.819,
    "end": 36.137,
    "duration": 7.318
  },
  {
    "id": 7,
    "text": "其现实情怀与叙事艺术成就，主要体现在以下四个方面：",
    "start": 36.637,
    "end": 40.969,
    "duration": 4.332
  },
  {
    "id": 8,
    "text": "第一，确立“感于哀乐，缘事而发”的现实精神，直面底层民生疾苦。",
    "start": 41.572,
    "end": 46.931,
    "duration": 5.359
  },
  {
    "id": 9,
    "text": "“感于哀乐，缘事而发”是汉乐府民歌最核心的思想灵魂。",
    "start": 47.431,
    "end": 51.738,
    "duration": 4.307
  },
  {
    "id": 10,
    "text": "“缘事而发”指诗歌紧扣生活中的具体事件生发，",
    "start": 52.238,
    "end": 55.62,
    "duration": 3.382
  },
  {
    "id": 11,
    "text": "“感于哀乐”则倾注了普通百姓真挚的苦乐爱恨。",
    "start": 56.035,
    "end": 59.625,
    "duration": 3.59
  },
  {
    "id": 12,
    "text": "如《十五从军征》以“十五从军征，八十始得归”控诉长期兵役制度对人生的摧残，",
    "start": 60.125,
    "end": 67.028,
    "duration": 6.903
  },
  {
    "id": 13,
    "text": "写出老兵归家唯见冢累累、松柏萧条的凄凉；",
    "start": 67.441,
    "end": 71.655,
    "duration": 4.214
  },
  {
    "id": 14,
    "text": "《东门行》写贫民在“盎中无斗米储”的绝境下拔剑而起；",
    "start": 72.155,
    "end": 76.655,
    "duration": 4.5
  },
  {
    "id": 15,
    "text": "《妇病行》刻画病妇临终托孤、孤儿啼号乞食的惨状。",
    "start": 77.204,
    "end": 81.342,
    "duration": 4.138
  },
  {
    "id": 16,
    "text": "这些作品真实揭示了社会两极分化，饱含深切的人道同情与反抗精神。",
    "start": 81.842,
    "end": 87.664,
    "duration": 5.822
  },
  {
    "id": 17,
    "text": "第二，推动诗体由四言向杂言、五言演进，标志着古代叙事诗的成熟。",
    "start": 88.305,
    "end": 94.012,
    "duration": 5.707
  },
  {
    "id": 18,
    "text": "两汉乐府打破了《诗经》以来四言诗的整齐拘束，吸收楚声与民间曲调，",
    "start": 94.512,
    "end": 100.133,
    "duration": 5.621
  },
  {
    "id": 19,
    "text": "发展出灵活多变的杂言体与日臻成熟的五言诗体，为文人五言诗的兴盛奠定了形式基础。",
    "start": 100.527,
    "end": 107.698,
    "duration": 7.171
  },
  {
    "id": 20,
    "text": "更重要的是，乐府民歌大幅提升了诗歌的叙事功能，",
    "start": 108.198,
    "end": 111.926,
    "duration": 3.728
  },
  {
    "id": 21,
    "text": "能够从容交代完整的情节因果与人物命运起伏。",
    "start": 112.276,
    "end": 116.06,
    "duration": 3.784
  },
  {
    "id": 22,
    "text": "长篇叙事诗《孔雀东南飞》全诗一千七百余字，",
    "start": 116.56,
    "end": 120.103,
    "duration": 3.543
  },
  {
    "id": 23,
    "text": "围绕刘兰芝被遣归、阿兄逼嫁、焦刘双双殉情双线交错展开，情节波澜起伏、详略得当，标志着中国古代叙事诗艺术走向成熟。",
    "start": 120.453,
    "end": 130.877,
    "duration": 10.424
  },
  {
    "id": 24,
    "text": "第三，长于在戏剧冲突中运用个性化语言与细节刻画鲜活人物。",
    "start": 131.512,
    "end": 136.982,
    "duration": 5.47
  },
  {
    "id": 25,
    "text": "汉乐府极善于借助尖锐冲突、人物对话与服饰动作细节塑造性格典型。",
    "start": 137.482,
    "end": 143.346,
    "duration": 5.864
  },
  {
    "id": 26,
    "text": "《孔雀东南飞》刻画了一组个性鲜明的人物群像：刘兰芝坚贞自尊、外柔内刚，",
    "start": 143.846,
    "end": 149.421,
    "duration": 5.575
  },
  {
    "id": 27,
    "text": "离别之际晨起严妆，“著我绣裌裙，事事四五通”，以从容庄重的举止维护自身尊严；",
    "start": 149.899,
    "end": 156.847,
    "duration": 6.948
  },
  {
    "id": 28,
    "text": "焦仲卿重情守义却软弱无奈；",
    "start": 157.347,
    "end": 159.859,
    "duration": 2.512
  },
  {
    "id": 29,
    "text": "焦母专横跋扈，刘兄市侩势利，形象无不肖其声情。",
    "start": 160.359,
    "end": 164.637,
    "duration": 4.278
  },
  {
    "id": 30,
    "text": "在《陌上桑》中，采桑女秦罗敷面对太守无礼调戏，",
    "start": 165.137,
    "end": 169.279,
    "duration": 4.142
  },
  {
    "id": 31,
    "text": "巧以夸耀夫婿的诙谐言辞戏弄权贵，在言笑晏晏间彰显出聪明机智与刚正骨气。",
    "start": 169.629,
    "end": 176.425,
    "duration": 6.796
  },
  {
    "id": 32,
    "text": "第四，丰富了比兴、复沓与浪漫想象手法，深远哺育后世现实主义诗风。",
    "start": 177.034,
    "end": 183.655,
    "duration": 6.621
  },
  {
    "id": 33,
    "text": "汉乐府不仅长于白描叙事，也融合了生动的抒情与浪漫想象技艺。",
    "start": 184.155,
    "end": 189.68,
    "duration": 5.525
  },
  {
    "id": 34,
    "text": "《孔雀东南飞》开篇以“孔雀东南飞，五里一徘徊”起兴定下悲怆基调，",
    "start": 190.18,
    "end": 195.445,
    "duration": 5.265
  },
  {
    "id": 35,
    "text": "结尾以合葬化鸟寄托坚贞爱情理想；",
    "start": 195.795,
    "end": 198.724,
    "duration": 2.929
  },
  {
    "id": 36,
    "text": "《江南》运用“莲叶何田田，鱼戏莲叶东”的复沓民歌格调，活泼明朗，富有乐感。",
    "start": 199.224,
    "end": 205.515,
    "duration": 6.291
  },
  {
    "id": 37,
    "text": "汉乐府直面现实、缘事而发的创作精神与叙事技巧，直接哺育了建安曹氏父子等人的乐府诗作，",
    "start": 206.015,
    "end": 215.071,
    "duration": 9.056
  },
  {
    "id": 38,
    "text": "并成为唐代杜甫“即事名篇”与白居易“新乐府运动”的重要源头。",
    "start": 215.421,
    "end": 220.714,
    "duration": 5.293
  },
  {
    "id": 39,
    "text": "综上所述，两汉乐府民歌立足“感于哀乐，缘事而发”的写实精神，",
    "start": 221.214,
    "end": 227.038,
    "duration": 5.824
  },
  {
    "id": 40,
    "text": "摆脱了汉代大赋铺张润色盛世的浮华风气，",
    "start": 227.489,
    "end": 230.515,
    "duration": 3.026
  },
  {
    "id": 41,
    "text": "以真切质朴的歌谣写出了下层民众的悲欢抗争。",
    "start": 230.865,
    "end": 235.84,
    "duration": 4.975
  },
  {
    "id": 42,
    "text": "它在体裁上完成了从四言向杂言、五言叙事诗的关键过渡，",
    "start": 236.425,
    "end": 241.371,
    "duration": 4.946
  },
  {
    "id": 43,
    "text": "其缘事写人传统直接哺育了建安文学及唐代杜甫、白居易的现实主义诗歌创作。",
    "start": 241.843,
    "end": 248.916,
    "duration": 7.073
  }
]
