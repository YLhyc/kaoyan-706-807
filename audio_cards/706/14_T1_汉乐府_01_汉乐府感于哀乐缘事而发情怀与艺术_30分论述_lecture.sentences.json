[
  {
    "id": 1,
    "text": "篇头：全题宏观破题与立论逻辑。",
    "start": 0.08,
    "end": 3.44,
    "duration": 3.36
  },
  {
    "id": 2,
    "text": "问题一：这道题到底在问什么？",
    "start": 3.44,
    "end": 6.32,
    "duration": 2.88
  },
  {
    "id": 3,
    "text": "这道题考查汉乐府民歌的核心精神命题“感于哀乐，",
    "start": 6.32,
    "end": 10.56,
    "duration": 4.24
  },
  {
    "id": 4,
    "text": "缘事而发”的“情怀特征”与“艺术成就”。",
    "start": 10.56,
    "end": 13.84,
    "duration": 3.28
  },
  {
    "id": 5,
    "text": "在考场上，考生绝不能仅仅背诵故事，",
    "start": 13.84,
    "end": 16.96,
    "duration": 3.12
  },
  {
    "id": 6,
    "text": "而必须紧扣“现实主义叙事生成机制”。",
    "start": 16.96,
    "end": 19.68,
    "duration": 2.72
  },
  {
    "id": 7,
    "text": "核心在于回答：这两句话如何界定了汉乐府直面民生疾苦的精神底色，",
    "start": 19.92,
    "end": 25.68,
    "duration": 5.76
  },
  {
    "id": 8,
    "text": "又如何在爱情、战争、婚姻等题材中落实为成熟的叙事艺术范式。",
    "start": 25.68,
    "end": 31.2,
    "duration": 5.52
  },
  {
    "id": 9,
    "text": "问题二：宏观立论核心指向哪里？",
    "start": 31.2,
    "end": 33.84,
    "duration": 2.64
  },
  {
    "id": 10,
    "text": "立论核心必须紧扣班固在《汉书•艺文志》中的权威论断，",
    "start": 33.84,
    "end": 38.16,
    "duration": 4.32
  },
  {
    "id": 11,
    "text": "阐明汉乐府承接《诗经》现实主义传统并实现叙事诗跨越的文学史地位。",
    "start": 38.16,
    "end": 43.6,
    "duration": 5.44
  },
  {
    "id": 12,
    "text": "问题三：由浅入深拆解为哪几个答题维度？",
    "start": 43.92,
    "end": 47.68,
    "duration": 3.76
  },
  {
    "id": 13,
    "text": "本题按思想情怀向艺术机制层层开掘拆解为四个逻辑维度：第一维度，",
    "start": 47.68,
    "end": 53.84,
    "duration": 6.16
  },
  {
    "id": 14,
    "text": "精神命题内涵与民生疾苦，界定“感于哀乐”与“缘事而发”的客观写实本质，",
    "start": 53.84,
    "end": 60.24,
    "duration": 6.4
  },
  {
    "id": 15,
    "text": "以《东门行》《十五从军征》为实证。",
    "start": 60.24,
    "end": 62.64,
    "duration": 2.4
  },
  {
    "id": 16,
    "text": "第二维度，婚姻爱情与抗争意志，深入底层女性心灵，",
    "start": 62.96,
    "end": 67.2,
    "duration": 4.24
  },
  {
    "id": 17,
    "text": "以《陌上桑》《孔雀东南飞》展现对礼教逼迫的誓死决裂。",
    "start": 67.2,
    "end": 71.68,
    "duration": 4.48
  },
  {
    "id": 18,
    "text": "第三维度，叙事艺术与体式变革，剖析典型人物塑造、",
    "start": 71.68,
    "end": 75.92,
    "duration": 4.24
  },
  {
    "id": 19,
    "text": "对话与细节描摹，以及五言诗体的成熟。",
    "start": 75.92,
    "end": 78.96,
    "duration": 3.04
  },
  {
    "id": 20,
    "text": "第四维度，文学史承续，总结其对建安乐府、",
    "start": 78.96,
    "end": 82.88,
    "duration": 3.92
  },
  {
    "id": 21,
    "text": "杜甫新题乐府及白居易新乐府运动的深远滋养。",
    "start": 82.88,
    "end": 86.72,
    "duration": 3.84
  },
  {
    "id": 22,
    "text": "问题四：各维度之间具备怎样不可逆的递进因果链条？",
    "start": 86.96,
    "end": 91.76,
    "duration": 4.8
  },
  {
    "id": 23,
    "text": "第一步必须先在宏观上确立汉代乐府民歌的历史地位与班固的核心命题。",
    "start": 91.76,
    "end": 97.68,
    "duration": 5.92
  },
  {
    "id": 24,
    "text": "第二步深入剖析该命题在反映阶级压迫与民生血泪层面的具体呈现。",
    "start": 97.68,
    "end": 103.12,
    "duration": 5.44
  },
  {
    "id": 25,
    "text": "第三步由社会生存进一步开掘至人性深处的伦理爱情抗争。",
    "start": 103.12,
    "end": 108.0,
    "duration": 4.88
  },
  {
    "id": 26,
    "text": "第四步深入剖析承载这种情怀的叙事机制与五言体式突破。",
    "start": 108.32,
    "end": 113.6,
    "duration": 5.28
  },
  {
    "id": 27,
    "text": "第五步跳出文本本身，在两千年古典现实主义诗歌史脉络中完成宏观历史论证闭环。",
    "start": 113.6,
    "end": 120.88,
    "duration": 7.28
  },
  {
    "id": 28,
    "text": "第一部分：破题立论与乐府源流定性。",
    "start": 120.88,
    "end": 124.08,
    "duration": 3.2
  },
  {
    "id": 29,
    "text": "逐句因果推导与答题表述。",
    "start": 124.08,
    "end": 126.4,
    "duration": 2.32
  },
  {
    "id": 30,
    "text": "为了开篇直击考点要害并确立学术基调，",
    "start": 126.4,
    "end": 129.76,
    "duration": 3.36
  },
  {
    "id": 31,
    "text": "第一句必须给出汉乐府在诗歌史上的现实主义承接地位与班固在《汉书•艺文志》中的权威论断。",
    "start": 129.76,
    "end": 137.2,
    "duration": 7.44
  },
  {
    "id": 32,
    "text": "所以表述为：汉乐府民歌是中国古代诗歌史上继《诗经》之后现实主义传统的又一座划时代丰碑，",
    "start": 137.584,
    "end": 145.584,
    "duration": 8.0
  },
  {
    "id": 33,
    "text": "东汉史学家班固在《汉书•艺文志》中精辟概括其精神源流为“感于哀乐，",
    "start": 145.584,
    "end": 151.904,
    "duration": 6.32
  },
  {
    "id": 34,
    "text": "缘事而发”。",
    "start": 151.904,
    "end": 153.024,
    "duration": 1.12
  },
  {
    "id": 35,
    "text": "紧接着必须点明汉代采诗的历史语境，",
    "start": 153.024,
    "end": 156.144,
    "duration": 3.12
  },
  {
    "id": 36,
    "text": "说明民间乐府诗生成的制度与社会背景。",
    "start": 156.144,
    "end": 159.264,
    "duration": 3.12
  },
  {
    "id": 37,
    "text": "所以表述为：在两汉社会阶级矛盾激化与底层民众流离失所的历史语境下，",
    "start": 159.584,
    "end": 165.904,
    "duration": 6.32
  },
  {
    "id": 38,
    "text": "汉代乐府机关采集民间歌谣，将市井小民最真实的呼声记录成篇。",
    "start": 165.904,
    "end": 171.664,
    "duration": 5.76
  },
  {
    "id": 39,
    "text": "最后一句必须将时代背景引渡至题目要求的叙事艺术成就，",
    "start": 171.664,
    "end": 176.704,
    "duration": 5.04
  },
  {
    "id": 40,
    "text": "完成全篇大题的立论收束。",
    "start": 176.704,
    "end": 178.944,
    "duration": 2.24
  },
  {
    "id": 41,
    "text": "所以表述为：汉乐府以极具写实性的现实观照、",
    "start": 179.344,
    "end": 183.344,
    "duration": 4.0
  },
  {
    "id": 42,
    "text": "刚健质朴的抒情风格以及日臻成熟的叙事技巧，",
    "start": 183.344,
    "end": 187.264,
    "duration": 3.92
  },
  {
    "id": 43,
    "text": "开辟了中国古代叙事诗的新纪元。",
    "start": 187.264,
    "end": 189.904,
    "duration": 2.64
  },
  {
    "id": 44,
    "text": "本段答题思路总结。",
    "start": 189.904,
    "end": 191.664,
    "duration": 1.76
  },
  {
    "id": 45,
    "text": "本段用三句话完成全篇破题：首句给出继诗经之后现实主义丰碑地位与班固名论，",
    "start": 191.664,
    "end": 198.624,
    "duration": 6.96
  },
  {
    "id": 46,
    "text": "次句交代阶级矛盾与乐府采诗制度，",
    "start": 198.624,
    "end": 201.904,
    "duration": 3.28
  },
  {
    "id": 47,
    "text": "末句标举写实情怀与开辟叙事诗新纪元的崇高价值，",
    "start": 201.904,
    "end": 206.304,
    "duration": 4.4
  },
  {
    "id": 48,
    "text": "立论沉稳有力。",
    "start": 206.304,
    "end": 207.504,
    "duration": 1.2
  },
  {
    "id": 49,
    "text": "所以本段具体答题完整版为：汉乐府民歌是中国古代诗歌史上继《诗经》之后现实主义传统的又一座划时代丰碑，",
    "start": 207.824,
    "end": 216.304,
    "duration": 8.48
  },
  {
    "id": 50,
    "text": "东汉史学家班固在《汉书•艺文志》中精辟概括其精神源流为“感于哀乐，",
    "start": 216.304,
    "end": 222.064,
    "duration": 5.76
  },
  {
    "id": 51,
    "text": "缘事而发”。",
    "start": 222.064,
    "end": 223.104,
    "duration": 1.04
  },
  {
    "id": 52,
    "text": "在两汉社会阶级矛盾激化与底层民众流离失所的历史语境下，",
    "start": 223.104,
    "end": 227.824,
    "duration": 4.72
  },
  {
    "id": 53,
    "text": "汉代乐府机关采集民间歌谣，将市井小民最真实的呼声记录成篇。",
    "start": 227.824,
    "end": 233.024,
    "duration": 5.2
  },
  {
    "id": 54,
    "text": "汉乐府以极具写实性的现实观照、刚健质朴的抒情风格以及日臻成熟的叙事技巧，",
    "start": 233.344,
    "end": 240.864,
    "duration": 7.52
  },
  {
    "id": 55,
    "text": "开辟了中国古代叙事诗的新纪元。",
    "start": 240.864,
    "end": 243.664,
    "duration": 2.8
  },
  {
    "id": 56,
    "text": "第二部分：感于哀乐缘事而发的精神内涵与民生苦难。",
    "start": 243.664,
    "end": 248.784,
    "duration": 5.12
  },
  {
    "id": 57,
    "text": "逐句因果推导与答题表述。",
    "start": 248.784,
    "end": 251.344,
    "duration": 2.56
  },
  {
    "id": 58,
    "text": "进入具体论述的第一层，必须首先把“感于哀乐，",
    "start": 251.344,
    "end": 255.264,
    "duration": 3.92
  },
  {
    "id": 59,
    "text": "缘事而发”的理论内涵彻底讲透，作为立论第一基石。",
    "start": 255.264,
    "end": 259.584,
    "duration": 4.32
  },
  {
    "id": 60,
    "text": "所以表述为：首先，“感于哀乐，缘事而发”确立了汉乐府直面现实苦难与底层生民血泪的抒情底色。",
    "start": 259.984,
    "end": 269.424,
    "duration": 9.44
  },
  {
    "id": 61,
    "text": "随后逐字拆解剖析“感于哀乐”的本质，",
    "start": 269.424,
    "end": 272.864,
    "duration": 3.44
  },
  {
    "id": 62,
    "text": "强调其彻底洗净贵族浮华虚饰。",
    "start": 272.864,
    "end": 275.344,
    "duration": 2.48
  },
  {
    "id": 63,
    "text": "所以表述为：所谓“感于哀乐”，是指诗歌彻底摆脱了贵族颂圣的虚饰，",
    "start": 275.8,
    "end": 282.04,
    "duration": 6.24
  },
  {
    "id": 64,
    "text": "完全源于底层平民在严酷现实中的真实痛感。",
    "start": 282.04,
    "end": 286.2,
    "duration": 4.16
  },
  {
    "id": 65,
    "text": "接着拆解剖析“缘事而发”的本质，",
    "start": 286.2,
    "end": 289.4,
    "duration": 3.2
  },
  {
    "id": 66,
    "text": "强调其基于真实生活事件的写实特征。",
    "start": 289.4,
    "end": 292.68,
    "duration": 3.28
  },
  {
    "id": 67,
    "text": "所以表述为：所谓“缘事而发”，是指诗作绝非空洞抽象抒情，",
    "start": 292.68,
    "end": 298.2,
    "duration": 5.52
  },
  {
    "id": 68,
    "text": "而是紧紧依附于具体的社会生活事件展开。",
    "start": 298.2,
    "end": 301.32,
    "duration": 3.12
  },
  {
    "id": 69,
    "text": "随后立刻调取展现贫民铤而走险反抗压迫的千古名篇《东门行》作为铁证。",
    "start": 301.72,
    "end": 308.44,
    "duration": 6.72
  },
  {
    "id": 70,
    "text": "所以表述为：《东门行》中“拔剑出门去，",
    "start": 308.44,
    "end": 311.88,
    "duration": 3.44
  },
  {
    "id": 71,
    "text": "舍中儿母牵衣啼”，以极具生活化的镜头，",
    "start": 311.88,
    "end": 315.8,
    "duration": 3.92
  },
  {
    "id": 72,
    "text": "记录了贫民在饥寒绝境中铤而走险的反抗选择。",
    "start": 315.8,
    "end": 320.04,
    "duration": 4.24
  },
  {
    "id": 73,
    "text": "为了避免孤证，进一步补充兵役苦难主题的标志性名篇《十五从军征》，",
    "start": 320.04,
    "end": 325.8,
    "duration": 5.76
  },
  {
    "id": 74,
    "text": "控诉残酷兵役。",
    "start": 325.8,
    "end": 327.0,
    "duration": 1.2
  },
  {
    "id": 75,
    "text": "所以表述为：《十五从军征》借八十老兵回乡见“兔从狗窦入，",
    "start": 327.32,
    "end": 332.44,
    "duration": 5.12
  },
  {
    "id": 76,
    "text": "雉从梁上飞”的残破荒凉，沉痛控诉了汉代不合理的兵役制度给人民带来的毁灭性浩劫。",
    "start": 332.44,
    "end": 339.48,
    "duration": 7.04
  },
  {
    "id": 77,
    "text": "本段答题思路总结。",
    "start": 339.48,
    "end": 341.08,
    "duration": 1.6
  },
  {
    "id": 78,
    "text": "本段以极其严密的学理展开：从抒情底色切入，",
    "start": 341.08,
    "end": 344.76,
    "duration": 3.68
  },
  {
    "id": 79,
    "text": "分别精准拆解“感于哀乐”的痛感来源与“缘事而发”的事件依附，",
    "start": 344.76,
    "end": 349.4,
    "duration": 4.64
  },
  {
    "id": 80,
    "text": "随后连出《东门行》铤而走险与《十五从军征》老兵还乡两组核心文本铁证，",
    "start": 349.4,
    "end": 355.64,
    "duration": 6.24
  },
  {
    "id": 81,
    "text": "论据极其扎实。",
    "start": 355.64,
    "end": 356.84,
    "duration": 1.2
  },
  {
    "id": 82,
    "text": "所以本段具体答题完整版为：首先，",
    "start": 357.24,
    "end": 360.2,
    "duration": 2.96
  },
  {
    "id": 83,
    "text": "“感于哀乐，缘事而发”确立了汉乐府直面现实苦难与底层生民血泪的抒情底色。",
    "start": 360.2,
    "end": 366.84,
    "duration": 6.64
  },
  {
    "id": 84,
    "text": "所谓“感于哀乐”，是指诗歌彻底摆脱了贵族颂圣的虚饰，",
    "start": 366.84,
    "end": 371.48,
    "duration": 4.64
  },
  {
    "id": 85,
    "text": "完全源于底层平民在严酷现实中的真实痛感。",
    "start": 371.48,
    "end": 375.24,
    "duration": 3.76
  },
  {
    "id": 86,
    "text": "所谓“缘事而发”，是指诗作绝非空洞抽象抒情，",
    "start": 375.24,
    "end": 379.32,
    "duration": 4.08
  },
  {
    "id": 87,
    "text": "而是紧紧依附于具体的社会生活事件展开。",
    "start": 379.32,
    "end": 382.28,
    "duration": 2.96
  },
  {
    "id": 88,
    "text": "《东门行》中“拔剑出门去，舍中儿母牵衣啼”，",
    "start": 382.52,
    "end": 386.295,
    "duration": 3.775
  },
  {
    "id": 89,
    "text": "以极具生活化的镜头，记录了贫民在饥寒绝境中铤而走险的反抗选择。",
    "start": 386.295,
    "end": 393.138,
    "duration": 6.843
  },
  {
    "id": 90,
    "text": "《十五从军征》借八十老兵回乡见“兔从狗窦入，",
    "start": 393.138,
    "end": 397.385,
    "duration": 4.247
  },
  {
    "id": 91,
    "text": "雉从梁上飞”的残破荒凉，沉痛控诉了汉代不合理的兵役制度给人民带来的毁灭性浩劫。",
    "start": 397.385,
    "end": 405.88,
    "duration": 8.495
  },
  {
    "id": 92,
    "text": "第三部分：反抗专制礼教与纯真爱情的生死决绝。",
    "start": 405.96,
    "end": 410.2,
    "duration": 4.24
  },
  {
    "id": 93,
    "text": "逐句因果推导与答题表述。",
    "start": 410.2,
    "end": 412.76,
    "duration": 2.56
  },
  {
    "id": 94,
    "text": "由宏观社会苦难深入到微观伦理精神层面，",
    "start": 412.76,
    "end": 416.36,
    "duration": 3.6
  },
  {
    "id": 95,
    "text": "首句必须标定汉乐府在反抗礼教与追求爱情上的刚烈气魄。",
    "start": 416.36,
    "end": 421.16,
    "duration": 4.8
  },
  {
    "id": 96,
    "text": "所以表述为：其次，汉乐府以生死决绝的刚烈精神，",
    "start": 421.528,
    "end": 425.835,
    "duration": 4.307
  },
  {
    "id": 97,
    "text": "谱写了追求自由婚姻与反抗礼教压迫的心灵赞歌。",
    "start": 425.835,
    "end": 430.418,
    "duration": 4.583
  },
  {
    "id": 98,
    "text": "紧接着指出在家长制压迫下，汉代平民展现出不屈的生命韧性与叛逆意志。",
    "start": 430.418,
    "end": 437.183,
    "duration": 6.765
  },
  {
    "id": 99,
    "text": "所以表述为：在封建家长制与宗法伦理的残酷禁锢下，",
    "start": 437.183,
    "end": 441.985,
    "duration": 4.802
  },
  {
    "id": 100,
    "text": "汉代平民展现出极为强悍的生命韧劲与叛逆意志。",
    "start": 441.985,
    "end": 446.568,
    "duration": 4.583
  },
  {
    "id": 101,
    "text": "随后立刻引入极具考场辨识度的《陌上桑》，",
    "start": 446.728,
    "end": 450.008,
    "duration": 3.28
  },
  {
    "id": 102,
    "text": "展现底层女子面对权贵的智勇交锋。",
    "start": 450.008,
    "end": 453.608,
    "duration": 3.6
  },
  {
    "id": 103,
    "text": "所以表述为：《陌上桑》中秦罗敷面对使君的调戏，",
    "start": 453.608,
    "end": 457.928,
    "duration": 4.32
  },
  {
    "id": 104,
    "text": "机智威严地盛夸夫婿，辛辣嘲讽了权贵的荒淫丑态。",
    "start": 457.928,
    "end": 462.568,
    "duration": 4.64
  },
  {
    "id": 105,
    "text": "接着搬出叙事诗巅峰之作《孔雀东南飞》，",
    "start": 462.568,
    "end": 466.088,
    "duration": 3.52
  },
  {
    "id": 106,
    "text": "深刻剖析双双殉情抗争的高贵与沉痛。",
    "start": 466.088,
    "end": 469.288,
    "duration": 3.2
  },
  {
    "id": 107,
    "text": "所以表述为：《孔雀东南飞》则是汉乐府叙事艺术的巅峰之作，",
    "start": 469.688,
    "end": 474.808,
    "duration": 5.12
  },
  {
    "id": 108,
    "text": "面对焦母与刘兄的无理逼迫，刘兰芝与焦仲卿以“揽裙脱丝履，",
    "start": 474.808,
    "end": 480.648,
    "duration": 5.84
  },
  {
    "id": 109,
    "text": "举身赴清池”和“自挂东南枝”的殉情抗争，",
    "start": 480.648,
    "end": 484.248,
    "duration": 3.6
  },
  {
    "id": 110,
    "text": "展现出对爱情忠贞不渝的高贵品格，",
    "start": 484.248,
    "end": 487.288,
    "duration": 3.04
  },
  {
    "id": 111,
    "text": "发出对封建礼教吃人本质的强烈控诉。",
    "start": 487.288,
    "end": 490.248,
    "duration": 2.96
  },
  {
    "id": 112,
    "text": "本段答题思路总结。",
    "start": 490.568,
    "end": 492.248,
    "duration": 1.68
  },
  {
    "id": 113,
    "text": "本段聚焦反抗礼教的精神维度：先立定义无反顾的刚烈赞歌，",
    "start": 492.248,
    "end": 497.128,
    "duration": 4.88
  },
  {
    "id": 114,
    "text": "继而揭示平民叛逆韧性，随后用《陌上桑》罗敷盛夸夫婿嘲弄权贵与《孔雀东南飞》兰芝赴水仲卿挂枝的壮烈殉情形成互证，",
    "start": 497.128,
    "end": 507.448,
    "duration": 10.32
  },
  {
    "id": 115,
    "text": "将反抗封建宗法的主题推向最高潮。",
    "start": 507.448,
    "end": 510.408,
    "duration": 2.96
  },
  {
    "id": 116,
    "text": "所以本段具体答题完整版为：其次，",
    "start": 510.808,
    "end": 513.848,
    "duration": 3.04
  },
  {
    "id": 117,
    "text": "汉乐府以生死决绝的刚烈精神，谱写了追求自由婚姻与反抗礼教压迫的心灵赞歌。",
    "start": 513.848,
    "end": 521.048,
    "duration": 7.2
  },
  {
    "id": 118,
    "text": "在封建家长制与宗法伦理的残酷禁锢下，",
    "start": 521.048,
    "end": 524.888,
    "duration": 3.84
  },
  {
    "id": 119,
    "text": "汉代平民展现出极为强悍的生命韧劲与叛逆意志。",
    "start": 524.888,
    "end": 529.368,
    "duration": 4.48
  },
  {
    "id": 120,
    "text": "《陌上桑》中秦罗敷面对使君的调戏，",
    "start": 529.368,
    "end": 532.488,
    "duration": 3.12
  },
  {
    "id": 121,
    "text": "机智威严地盛夸夫婿，辛辣嘲讽了权贵的荒淫丑态。",
    "start": 532.488,
    "end": 536.808,
    "duration": 4.32
  },
  {
    "id": 122,
    "text": "《孔雀东南飞》则是汉乐府叙事艺术的巅峰之作，",
    "start": 536.968,
    "end": 540.943,
    "duration": 3.975
  },
  {
    "id": 123,
    "text": "面对焦母与刘兄的无理逼迫，刘兰芝与焦仲卿以“揽裙脱丝履，",
    "start": 540.943,
    "end": 546.174,
    "duration": 5.231
  },
  {
    "id": 124,
    "text": "举身赴清池”和“自挂东南枝”的殉情抗争，",
    "start": 546.174,
    "end": 549.522,
    "duration": 3.348
  },
  {
    "id": 125,
    "text": "展现出对爱情忠贞不渝的高贵品格，",
    "start": 549.522,
    "end": 552.66,
    "duration": 3.138
  },
  {
    "id": 126,
    "text": "发出对封建礼教吃人本质的强烈控诉。",
    "start": 552.66,
    "end": 556.008,
    "duration": 3.348
  },
  {
    "id": 127,
    "text": "第四部分：叙事性成熟与人物塑造的戏剧张力。",
    "start": 556.088,
    "end": 560.568,
    "duration": 4.48
  },
  {
    "id": 128,
    "text": "逐句因果推导与答题表述。",
    "start": 560.568,
    "end": 562.728,
    "duration": 2.16
  },
  {
    "id": 129,
    "text": "在剖析完思想内容之后，论述必须深入至文体学与叙事机制，",
    "start": 563.096,
    "end": 568.536,
    "duration": 5.44
  },
  {
    "id": 130,
    "text": "首句明确指出其在叙事诗机制确立上的划时代贡献。",
    "start": 568.536,
    "end": 573.096,
    "duration": 4.56
  },
  {
    "id": 131,
    "text": "所以表述为：再次，在艺术表现上，",
    "start": 573.096,
    "end": 576.616,
    "duration": 3.52
  },
  {
    "id": 132,
    "text": "汉乐府标志着中国古代叙事诗机制的全面确立与成熟。",
    "start": 576.616,
    "end": 581.336,
    "duration": 4.72
  },
  {
    "id": 133,
    "text": "随后对比《诗经》的抒情体裁，强调汉乐府成功塑造了具备鲜明性格特征的人物形象。",
    "start": 581.336,
    "end": 587.816,
    "duration": 6.48
  },
  {
    "id": 134,
    "text": "所以表述为：与《诗经》重章叠句的抒情体式不同，",
    "start": 588.136,
    "end": 592.296,
    "duration": 4.16
  },
  {
    "id": 135,
    "text": "汉乐府成功塑造了具备鲜明性格特征的典型人物。",
    "start": 592.296,
    "end": 596.963,
    "duration": 4.667
  },
  {
    "id": 136,
    "text": "接着阐述其具体技法，指出生动对话、",
    "start": 596.963,
    "end": 600.296,
    "duration": 3.333
  },
  {
    "id": 137,
    "text": "心理独白与情节的戏剧化张力。",
    "start": 600.296,
    "end": 603.185,
    "duration": 2.889
  },
  {
    "id": 138,
    "text": "所以表述为：作品大量运用生动洗练的人物对话、",
    "start": 603.185,
    "end": 607.629,
    "duration": 4.444
  },
  {
    "id": 139,
    "text": "心理独白与细节刻画，具有极强的戏剧化情节张力。",
    "start": 607.629,
    "end": 612.296,
    "duration": 4.667
  },
  {
    "id": 140,
    "text": "最后一句必须从体式演进的高度，指出汉乐府打破四言、",
    "start": 612.376,
    "end": 616.856,
    "duration": 4.48
  },
  {
    "id": 141,
    "text": "孕育五言诗的体裁革命贡献。",
    "start": 616.856,
    "end": 619.176,
    "duration": 2.32
  },
  {
    "id": 142,
    "text": "所以表述为：在句式形式上，汉乐府打破了四言诗的僵化格局，",
    "start": 619.176,
    "end": 624.216,
    "duration": 5.04
  },
  {
    "id": 143,
    "text": "创造性地推进了五言诗与杂言诗的繁荣，",
    "start": 624.216,
    "end": 627.416,
    "duration": 3.2
  },
  {
    "id": 144,
    "text": "为建安文人五言诗的成熟奠定了不可或缺的体式土壤。",
    "start": 627.416,
    "end": 631.656,
    "duration": 4.24
  },
  {
    "id": 145,
    "text": "本段答题思路总结。",
    "start": 631.896,
    "end": 633.656,
    "duration": 1.76
  },
  {
    "id": 146,
    "text": "本段深刻剖析叙事机制与体式革命：从叙事诗机制确立切入，",
    "start": 633.656,
    "end": 639.336,
    "duration": 5.68
  },
  {
    "id": 147,
    "text": "对比《诗经》凸显个性化人物塑造，",
    "start": 639.336,
    "end": 641.976,
    "duration": 2.64
  },
  {
    "id": 148,
    "text": "详述对话、心理与戏剧张力，尾句上升到打破四言僵局、",
    "start": 641.976,
    "end": 647.336,
    "duration": 5.36
  },
  {
    "id": 149,
    "text": "孕育建安五言诗的体式高度，展现极其全面的理论素养。",
    "start": 647.336,
    "end": 652.136,
    "duration": 4.8
  },
  {
    "id": 150,
    "text": "所以本段具体答题完整版为：再次，",
    "start": 652.456,
    "end": 655.336,
    "duration": 2.88
  },
  {
    "id": 151,
    "text": "在艺术表现上，汉乐府标志着中国古代叙事诗机制的全面确立与成熟。",
    "start": 655.336,
    "end": 661.736,
    "duration": 6.4
  },
  {
    "id": 152,
    "text": "与《诗经》重章叠句的抒情体式不同，",
    "start": 661.736,
    "end": 664.776,
    "duration": 3.04
  },
  {
    "id": 153,
    "text": "汉乐府成功塑造了具备鲜明性格特征的典型人物。",
    "start": 664.776,
    "end": 668.856,
    "duration": 4.08
  },
  {
    "id": 154,
    "text": "作品大量运用生动洗练的人物对话、",
    "start": 668.856,
    "end": 671.976,
    "duration": 3.12
  },
  {
    "id": 155,
    "text": "心理独白与细节刻画，具有极强的戏剧化情节张力。",
    "start": 671.976,
    "end": 676.376,
    "duration": 4.4
  },
  {
    "id": 156,
    "text": "在句式形式上，汉乐府打破了四言诗的僵化格局，",
    "start": 676.616,
    "end": 680.856,
    "duration": 4.24
  },
  {
    "id": 157,
    "text": "创造性地推进了五言诗与杂言诗的繁荣，",
    "start": 680.856,
    "end": 684.136,
    "duration": 3.28
  },
  {
    "id": 158,
    "text": "为建安文人五言诗的成熟奠定了不可或缺的体式土壤。",
    "start": 684.136,
    "end": 688.856,
    "duration": 4.72
  },
  {
    "id": 159,
    "text": "第五部分：总结升华与文学史承续价值。",
    "start": 689.016,
    "end": 693.016,
    "duration": 4.0
  },
  {
    "id": 160,
    "text": "逐句因果推导与答题表述。",
    "start": 693.016,
    "end": 695.496,
    "duration": 2.48
  },
  {
    "id": 161,
    "text": "经过以上四个维度的完整展开，结尾段必须跳出作品本身，",
    "start": 695.496,
    "end": 700.296,
    "duration": 4.8
  },
  {
    "id": 162,
    "text": "在中国诗歌现实主义演进长河中确立其不可磨灭的源头地位。",
    "start": 700.296,
    "end": 705.016,
    "duration": 4.72
  },
  {
    "id": 163,
    "text": "所以表述为：最后，汉乐府“感于哀乐，",
    "start": 705.416,
    "end": 709.016,
    "duration": 3.6
  },
  {
    "id": 164,
    "text": "缘事而发”的诗学传统，成为后世现实主义文学的核心源泉。",
    "start": 709.016,
    "end": 713.576,
    "duration": 4.56
  },
  {
    "id": 165,
    "text": "最后一句必须纵向贯通建安诗歌、杜甫叙事变革与中唐新乐府运动，",
    "start": 713.864,
    "end": 719.417,
    "duration": 5.553
  },
  {
    "id": 166,
    "text": "实现全篇大题圆满闭环。",
    "start": 719.417,
    "end": 721.501,
    "duration": 2.084
  },
  {
    "id": 167,
    "text": "所以表述为：它直接催生了建安文人的乐府诗创作与杜甫“即事名篇”的叙事变革，",
    "start": 721.501,
    "end": 728.377,
    "duration": 6.876
  },
  {
    "id": 168,
    "text": "更成为中唐白居易、元稹新乐府运动的精神纲领，",
    "start": 728.377,
    "end": 732.544,
    "duration": 4.167
  },
  {
    "id": 169,
    "text": "在两千年中国诗歌史上始终闪耀着不灭的人道主义光芒。",
    "start": 732.544,
    "end": 737.544,
    "duration": 5.0
  },
  {
    "id": 170,
    "text": "本段答题思路总结。",
    "start": 737.624,
    "end": 739.224,
    "duration": 1.6
  },
  {
    "id": 171,
    "text": "本段两句话干脆利落地完成大题闭环：首句立定后世现实主义源泉地位，",
    "start": 739.224,
    "end": 744.904,
    "duration": 5.68
  },
  {
    "id": 172,
    "text": "末句纵向串通建安、杜甫即事名篇与元白新乐府运动三大里程碑，",
    "start": 744.904,
    "end": 750.504,
    "duration": 5.6
  },
  {
    "id": 173,
    "text": "以不灭的人道主义光芒升华收官，气韵深厚。",
    "start": 750.504,
    "end": 754.184,
    "duration": 3.68
  },
  {
    "id": 174,
    "text": "所以本段具体答题完整版为：最后，",
    "start": 754.184,
    "end": 756.984,
    "duration": 2.8
  },
  {
    "id": 175,
    "text": "汉乐府“感于哀乐，缘事而发”的诗学传统，",
    "start": 756.984,
    "end": 760.584,
    "duration": 3.6
  },
  {
    "id": 176,
    "text": "成为后世现实主义文学的核心源泉。",
    "start": 760.584,
    "end": 763.304,
    "duration": 2.72
  },
  {
    "id": 177,
    "text": "它直接催生了建安文人的乐府诗创作与杜甫“即事名篇”的叙事变革，",
    "start": 763.304,
    "end": 769.064,
    "duration": 5.76
  },
  {
    "id": 178,
    "text": "更成为中唐白居易、元稹新乐府运动的精神纲领，",
    "start": 769.064,
    "end": 772.824,
    "duration": 3.76
  },
  {
    "id": 179,
    "text": "在两千年中国诗歌史上始终闪耀着不灭的人道主义光芒。",
    "start": 772.824,
    "end": 777.224,
    "duration": 4.4
  },
  {
    "id": 180,
    "text": "篇尾：整道大题的内在逻辑链总括。",
    "start": 777.464,
    "end": 780.424,
    "duration": 2.96
  },
  {
    "id": 181,
    "text": "为了便于考生在脑海中建立极速调取机制，",
    "start": 780.424,
    "end": 783.544,
    "duration": 3.12
  },
  {
    "id": 182,
    "text": "整道大题的论证逻辑可提炼为如下不可逆的六步链条：一、",
    "start": 783.544,
    "end": 788.104,
    "duration": 4.56
  },
  {
    "id": 183,
    "text": "源流定性：开篇直接以班固《汉书•艺文志》 “感于哀乐，",
    "start": 788.104,
    "end": 792.264,
    "duration": 4.16
  },
  {
    "id": 184,
    "text": "缘事而发”定名，确立其继诗经之后的叙事诗丰碑地位。",
    "start": 792.264,
    "end": 796.744,
    "duration": 4.48
  },
  {
    "id": 185,
    "text": "二、命题拆解：精准阐释感于哀乐源于平民痛感，",
    "start": 797.064,
    "end": 801.624,
    "duration": 4.56
  },
  {
    "id": 186,
    "text": "缘事而发依附具体事件，以《东门行》与《十五从军征》证实民生疾苦。",
    "start": 801.624,
    "end": 807.224,
    "duration": 5.6
  },
  {
    "id": 187,
    "text": "三、精神抗争：展现反抗礼教禁锢的刚烈赞歌，",
    "start": 807.224,
    "end": 811.224,
    "duration": 4.0
  },
  {
    "id": 188,
    "text": "以《陌上桑》嘲弄权贵丑态，以《孔雀东南飞》殉情誓言控诉宗法压迫。",
    "start": 811.224,
    "end": 816.424,
    "duration": 5.2
  },
  {
    "id": 189,
    "text": "四、叙事机制：对比《诗经》阐明典型人物塑造，",
