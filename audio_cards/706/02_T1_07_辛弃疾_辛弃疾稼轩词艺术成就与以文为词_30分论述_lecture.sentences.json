[
  {
    "id": 1,
    "text": "试论辛弃疾稼轩词的艺术成就与“以文为词”。",
    "start": 0.08,
    "end": 4.007,
    "duration": 3.927
  },
  {
    "id": 2,
    "text": "辛弃疾是南宋词坛豪放词派的至高集大成者。",
    "start": 4.04,
    "end": 7.617,
    "duration": 3.577
  },
  {
    "id": 3,
    "text": "身处南宋小朝廷偏安江南、中原故土沦丧、",
    "start": 7.8,
    "end": 11.323,
    "duration": 3.523
  },
  {
    "id": 4,
    "text": "自身作为“归正人”备受主和派猜忌排挤的历史绝境，",
    "start": 11.383,
    "end": 15.426,
    "duration": 4.043
  },
  {
    "id": 5,
    "text": "辛弃疾以沙场英雄的壮烈怀抱与治国安邦之才入词，",
    "start": 15.509,
    "end": 19.752,
    "duration": 4.243
  },
  {
    "id": 6,
    "text": "在继承苏轼“以诗为词”的基础上更进一步，",
    "start": 19.818,
    "end": 22.979,
    "duration": 3.161
  },
  {
    "id": 7,
    "text": "推行 “以文为词”，彻底打破了词体原有的体裁边界。",
    "start": 23.203,
    "end": 27.078,
    "duration": 3.875
  },
  {
    "id": 8,
    "text": "刘熙载在 《艺概》 中评其词 “颇似左氏《春秋》及《离骚》”；",
    "start": 27.299,
    "end": 31.942,
    "duration": 4.643
  },
  {
    "id": 9,
    "text": "梁启超赞其为 “一代豪杰之词”。",
    "start": 32.238,
    "end": 34.848,
    "duration": 2.61
  },
  {
    "id": 10,
    "text": "其稼轩词的艺术成就与以文为词机制，",
    "start": 35.156,
    "end": 38.872,
    "duration": 3.716
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：",
    "start": 39.153,
    "end": 41.62,
    "duration": 2.467
  },
  {
    "id": 12,
    "text": "第一，推行“以文为词”的文体革命，",
    "start": 41.878,
    "end": 44.751,
    "duration": 2.873
  },
  {
    "id": 13,
    "text": "全面吸纳散文句法与论辩逻辑入词。",
    "start": 45.143,
    "end": 48.736,
    "duration": 3.593
  },
  {
    "id": 14,
    "text": "辛弃疾对词体最重大的文体革新，",
    "start": 48.898,
    "end": 51.833,
    "duration": 2.935
  },
  {
    "id": 15,
    "text": "在于大胆打破诗歌声律对称的拘牵，",
    "start": 52.086,
    "end": 54.959,
    "duration": 2.873
  },
  {
    "id": 16,
    "text": "将先秦两汉散文的章法结构、句式与逻辑说理全盘注入词体。",
    "start": 55.461,
    "end": 60.935,
    "duration": 5.474
  },
  {
    "id": 17,
    "text": "他广泛借用 《论语》《孟子》《庄子》 与 《史记》 的散文句法，",
    "start": 61.478,
    "end": 65.856,
    "duration": 4.378
  },
  {
    "id": 18,
    "text": "大量运用长短错落的散文化句式与虚字呼应。",
    "start": 66.069,
    "end": 69.904,
    "duration": 3.835
  },
  {
    "id": 19,
    "text": "在 《摸鱼儿·更能消几番风雨》 中，",
    "start": 70.107,
    "end": 72.396,
    "duration": 2.289
  },
  {
    "id": 20,
    "text": "以如散文策论般的层层设问、",
    "start": 72.578,
    "end": 74.892,
    "duration": 2.314
  },
  {
    "id": 21,
    "text": "环环相扣铺叙身世之感与宗国之悲；这种以散文笔调直发议论、",
    "start": 75.011,
    "end": 80.974,
    "duration": 5.963
  },
  {
    "id": 22,
    "text": "腾挪转折的表现方式，",
    "start": 81.135,
    "end": 82.862,
    "duration": 1.727
  },
  {
    "id": 23,
    "text": "赋予了词体前所未有的开阔气势与深沉的思辨力量。",
    "start": 82.945,
    "end": 87.668,
    "duration": 4.723
  },
  {
    "id": 24,
    "text": "第二，确立“融经铸史”的用典艺术，",
    "start": 88.196,
    "end": 91.181,
    "duration": 2.985
  },
  {
    "id": 25,
    "text": "以密集史实典故作为政治批判武器。",
    "start": 91.502,
    "end": 94.385,
    "duration": 2.883
  },
  {
    "id": 26,
    "text": "辛弃疾将古典用典艺术推向了登峰造极的境地。",
    "start": 94.569,
    "end": 98.472,
    "duration": 3.903
  },
  {
    "id": 27,
    "text": "他不再停留于字句的表面借用，而是将经史典故作为借古讽今、",
    "start": 98.769,
    "end": 104.245,
    "duration": 5.476
  },
  {
    "id": 28,
    "text": "表达政治忧患的隐微载体。",
    "start": 104.473,
    "end": 106.614,
    "duration": 2.141
  },
  {
    "id": 29,
    "text": "其晚年登临名作 《永遇乐·京口北固亭怀古》，",
    "start": 107.2,
    "end": 110.797,
    "duration": 3.597
  },
  {
    "id": 30,
    "text": "全篇不足百字连用五典：借 “千古江山，",
    "start": 111.213,
    "end": 114.94,
    "duration": 3.727
  },
  {
    "id": 31,
    "text": "英雄无觅孙仲谋处” 讽刺南宋当政者的苟且偷安；",
    "start": 115.113,
    "end": 119.371,
    "duration": 4.258
  },
  {
    "id": 32,
    "text": "借刘裕 “气吞万里如虎” 对照刘义隆 “赢得仓皇北顾” 的冒进惨败，",
    "start": 119.543,
    "end": 124.741,
    "duration": 5.198
  },
  {
    "id": 33,
    "text": "警示韩侂胄草率北伐的致命危机；借 “廉颇老矣，",
    "start": 124.949,
    "end": 129.562,
    "duration": 4.613
  },
  {
    "id": 34,
    "text": "尚能饭否” 抒发自身报国无门的英雄迟暮之悲。",
    "start": 129.71,
    "end": 133.71,
    "duration": 4.0
  },
  {
    "id": 35,
    "text": "密集典故与现实政治紧密结合，化为沉痛的政治批判武器。",
    "start": 134.251,
    "end": 139.155,
    "duration": 4.904
  },
  {
    "id": 36,
    "text": "第三，贯注沙场英雄的豪壮气概，",
    "start": 139.379,
    "end": 142.308,
    "duration": 2.929
  },
  {
    "id": 37,
    "text": "构筑悲壮激越的爱国主义美学典范。",
    "start": 142.607,
    "end": 145.57,
    "duration": 2.963
  },
  {
    "id": 38,
    "text": "辛弃疾早年亲率五十骑突袭金营生擒叛徒，",
    "start": 145.816,
    "end": 149.808,
    "duration": 3.992
  },
  {
    "id": 39,
    "text": "具备深厚的将帅军事韬略，",
    "start": 150.199,
    "end": 152.404,
    "duration": 2.205
  },
  {
    "id": 40,
    "text": "这种沙场英豪气概在词史上绝无仅有。",
    "start": 152.664,
    "end": 156.482,
    "duration": 3.818
  },
  {
    "id": 41,
    "text": "在 《破阵子·为陈同甫赋壮词以寄之》 中，",
    "start": 156.78,
    "end": 160.073,
    "duration": 3.293
  },
  {
    "id": 42,
    "text": "“醉里挑灯看剑，梦回吹角连营。",
    "start": 160.232,
    "end": 162.899,
    "duration": 2.667
  },
  {
    "id": 43,
    "text": "八百里分麾下炙，五十弦翻塞外声，沙场秋点兵”，",
    "start": 163.205,
    "end": 167.619,
    "duration": 4.414
  },
  {
    "id": 44,
    "text": "以极其雄壮的节奏重现沙场阅兵征战的壮烈图景；",
    "start": 167.804,
    "end": 172.233,
    "duration": 4.429
  },
  {
    "id": 45,
    "text": "结语笔锋却陡然逆转为 “可怜白发生”，",
    "start": 172.463,
    "end": 175.786,
    "duration": 3.323
  },
  {
    "id": 46,
    "text": "将满腔报国热忱与现实压抑的剧烈矛盾推向顶点，",
    "start": 176.08,
    "end": 180.387,
    "duration": 4.307
  },
  {
    "id": 47,
    "text": "迸发出沉雄悲壮的精神震撼力。",
    "start": 180.774,
    "end": 183.223,
    "duration": 2.449
  },
  {
    "id": 48,
    "text": "第四，展现丰富多样化的审美风貌，兼备清新田园与幽默谐谑之趣。",
    "start": 183.539,
    "end": 189.544,
    "duration": 6.005
  },
  {
    "id": 49,
    "text": "稼轩词虽以豪放悲壮为主调，但其风格同样具有极广阔的多样性。",
    "start": 190.046,
    "end": 195.141,
    "duration": 5.095
  },
  {
    "id": 50,
    "text": "在带湖、瓢泉闲居期间，",
    "start": 195.356,
    "end": 197.596,
    "duration": 2.24
  },
  {
    "id": 51,
    "text": "他创作了大量清新活泼的农村词与幽默小品。",
    "start": 197.783,
    "end": 201.845,
    "duration": 4.062
  },
  {
    "id": 52,
    "text": "在 《西江月·夜行黄沙道中》 中，写下 “明月别枝惊鹊，",
    "start": 202.251,
    "end": 207.578,
    "duration": 5.327
  },
  {
    "id": 53,
    "text": "清风半夜鸣蝉。",
    "start": 207.763,
    "end": 209.526,
    "duration": 1.763
  },
  {
    "id": 54,
    "text": "稻花香里说丰年，听取蛙声一片” 的静谧田园；",
    "start": 209.547,
    "end": 213.75,
    "duration": 4.203
  },
  {
    "id": 55,
    "text": "在 《清平乐·村居》 中，以 “最喜小儿亡赖，",
    "start": 214.015,
    "end": 217.661,
    "duration": 3.646
  },
  {
    "id": 56,
    "text": "溪头卧剥莲蓬” 白描农村人伦真趣；更以词写戒酒、止酒，",
    "start": 217.963,
    "end": 223.289,
    "duration": 5.326
  },
  {
    "id": 57,
    "text": "谐谑生动。",
    "start": 223.385,
    "end": 224.255,
    "duration": 0.87
  },
  {
    "id": 58,
    "text": "这种多样化的艺术造诣，证明了其在词史上全能大师的崇高地位。",
    "start": 224.316,
    "end": 229.224,
    "duration": 4.908
  }
]
