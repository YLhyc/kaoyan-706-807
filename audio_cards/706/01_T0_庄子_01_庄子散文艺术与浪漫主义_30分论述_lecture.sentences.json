[
  {
    "id": 1,
    "text": "全局宏观破题与立论逻辑。",
    "start": 0.16,
    "end": 2.64,
    "duration": 2.48
  },
  {
    "id": 2,
    "text": "在考场下笔之前，必须先在宏观上审清这道三十分大题的核心考核意图。",
    "start": 2.64,
    "end": 8.64,
    "duration": 6.0
  },
  {
    "id": 3,
    "text": "本题表面上考查庄子散文的艺术特征，",
    "start": 8.64,
    "end": 11.84,
    "duration": 3.2
  },
  {
    "id": 4,
    "text": "本质上考查中国哲学思想诗意化表达的美学机制。",
    "start": 11.84,
    "end": 16.08,
    "duration": 4.24
  },
  {
    "id": 5,
    "text": "考场评分标准绝不满足于仅孤立复述几个寓言故事。",
    "start": 16.08,
    "end": 20.16,
    "duration": 4.08
  },
  {
    "id": 6,
    "text": "答题方向必须确立为“从体制性的三言叙事结构，",
    "start": 20.48,
    "end": 24.72,
    "duration": 4.24
  },
  {
    "id": 7,
    "text": "推进到宏观的浪漫想象与意象营构，",
    "start": 24.72,
    "end": 28.08,
    "duration": 3.36
  },
  {
    "id": 8,
    "text": "再下沉至诗意哲理的融铸机制，最终升华至深层人格情志与社会批判”的纵深脉络。",
    "start": 28.08,
    "end": 35.6,
    "duration": 7.52
  },
  {
    "id": 9,
    "text": "整道大题在宏观上划分为五个有机递进的逻辑层次：第一层，",
    "start": 35.6,
    "end": 40.96,
    "duration": 5.36
  },
  {
    "id": 10,
    "text": "开篇破题，借鲁迅“莫能先也”定评与袁行配教材，",
    "start": 40.96,
    "end": 45.52,
    "duration": 4.56
  },
  {
    "id": 11,
    "text": "确立其作为浪漫主义哲学源头的学术坐标。",
    "start": 45.52,
    "end": 48.8,
    "duration": 3.28
  },
  {
    "id": 12,
    "text": "第二层，论述叙事机制，剖析“三言”（寓言、",
    "start": 49.04,
    "end": 52.96,
    "duration": 3.92
  },
  {
    "id": 13,
    "text": "重言、之言）如何重构古代说理散文的体制。",
    "start": 52.96,
    "end": 56.72,
    "duration": 3.76
  },
  {
    "id": 14,
    "text": "第三层，论述宏观浪漫想象，以《逍遥游》坤鹏大象为例，",
    "start": 56.72,
    "end": 61.6,
    "duration": 4.88
  },
  {
    "id": 15,
    "text": "阐释绝对精神自由的空间象征。",
    "start": 61.6,
    "end": 64.08,
    "duration": 2.48
  },
  {
    "id": 16,
    "text": "第四层，论述意象的哲理融铸，以“庄周梦蝶”与“庖丁解牛”为例，",
    "start": 64.08,
    "end": 69.36,
    "duration": 5.28
  },
  {
    "id": 17,
    "text": "阐发象外有理、物我两忘的诗意七居。",
    "start": 69.36,
    "end": 72.16,
    "duration": 2.8
  },
  {
    "id": 18,
    "text": "第五层，升华至内在情志，揭示超脱外表下“窃国者侯”的冷峻批判与深层悲敏。",
    "start": 72.4,
    "end": 80.16,
    "duration": 7.76
  },
  {
    "id": 19,
    "text": "尾部收官，将结论放回文学史谱系，",
    "start": 80.16,
    "end": 83.44,
    "duration": 3.28
  },
  {
    "id": 20,
    "text": "交代其对陶渊明、李白、苏轼等文学巨擘的人格哺育。",
    "start": 83.44,
    "end": 88.08,
    "duration": 4.64
  },
  {
    "id": 21,
    "text": "这五个层次构成一条不可逆的因果链条：三言是机制，",
    "start": 88.08,
    "end": 92.88,
    "duration": 4.8
  },
  {
    "id": 22,
    "text": "坤鹏是气魄，梦蝶是意境，悲愤是血肉，",
    "start": 92.88,
    "end": 96.56,
    "duration": 3.68
  },
  {
    "id": 23,
    "text": "后代承续是最终定型。",
    "start": 96.56,
    "end": 98.48,
    "duration": 1.92
  },
  {
    "id": 24,
    "text": "理顺了宏观全局思路，接下来进入每一段的具体推导与逐句表述。",
    "start": 98.8,
    "end": 104.24,
    "duration": 5.44
  },
  {
    "id": 25,
    "text": "--。第",
    "start": 104.24,
    "end": 104.4,
    "duration": 0.16
  },
  {
    "id": 26,
    "text": "一段：首段破题与概念定性。",
    "start": 104.4,
    "end": 107.6,
    "duration": 3.2
  },
  {
    "id": 27,
    "text": "逐句因果推导与答题表述。",
    "start": 107.6,
    "end": 110.24,
    "duration": 2.64
  },
  {
    "id": 28,
    "text": "首句必须直击核心地位，确立其在先秦散文与浪漫主义长河中的顶峰坐标。",
    "start": 110.24,
    "end": 116.48,
    "duration": 6.24
  },
  {
    "id": 29,
    "text": "所以表述为：《庄子》是先秦诸子散文发展的最高峰，",
    "start": 116.48,
    "end": 120.625,
    "duration": 4.145
  },
  {
    "id": 30,
    "text": "更是中国古代文学浪漫主义的哲学源头。",
    "start": 120.625,
    "end": 124.053,
    "duration": 3.428
  },
  {
    "id": 31,
    "text": "次句必须引入鲁迅在文学史上的权威总评，",
    "start": 124.053,
    "end": 127.683,
    "duration": 3.63
  },
  {
    "id": 32,
    "text": "展现扎实的学术积累。",
    "start": 127.683,
    "end": 129.498,
    "duration": 1.815
  },
  {
    "id": 33,
    "text": "所以表述为：鲁迅在《汉文学史纲要》中极口称赞：“汪洋辟河，",
    "start": 129.498,
    "end": 134.137,
    "duration": 4.639
  },
  {
    "id": 34,
    "text": "仪态万方，晚周诸子之作，莫能先也”。",
    "start": 134.137,
    "end": 136.96,
    "duration": 2.823
  },
  {
    "id": 35,
    "text": "第三句引入考研权威教材的学术界定，",
    "start": 137.04,
    "end": 140.32,
    "duration": 3.28
  },
  {
    "id": 36,
    "text": "指出其打破逻辑论辩的重大突破。",
    "start": 140.32,
    "end": 143.36,
    "duration": 3.04
  },
  {
    "id": 37,
    "text": "所以表述为：袁行配《中国文学史》指出，",
    "start": 143.36,
    "end": 146.776,
    "duration": 3.416
  },
  {
    "id": 38,
    "text": "《庄子》打破了传统说理散文枯燥逻辑论辩的桎梏。",
    "start": 146.776,
    "end": 150.776,
    "duration": 4.0
  },
  {
    "id": 39,
    "text": "第四句阐发其美学贡献，说明它将道家深奥哲思熔铸于感性意象之中。",
    "start": 150.776,
    "end": 156.776,
    "duration": 6.0
  },
  {
    "id": 40,
    "text": "所以表述为：它将深奥超逸的道家哲理，",
    "start": 156.776,
    "end": 159.896,
    "duration": 3.12
  },
  {
    "id": 41,
    "text": "完全熔铸于生动绚烂的文学意象与奇崛想象之中。",
    "start": 159.896,
    "end": 163.976,
    "duration": 4.08
  },
  {
    "id": 42,
    "text": "第五句作为首段过渡句，宣告下文将从四个核心维度展开系统剖析。",
    "start": 164.216,
    "end": 170.536,
    "duration": 6.32
  },
  {
    "id": 43,
    "text": "所以表述为：其杰出的散文艺术与浪漫主义表现，",
    "start": 170.536,
    "end": 175.176,
    "duration": 4.64
  },
  {
    "id": 44,
    "text": "主要展现在以下四个核心维度：本段答题思路总结。",
    "start": 175.176,
    "end": 179.656,
    "duration": 4.48
  },
  {
    "id": 45,
    "text": "本段用五句话完成立论闭环：先直接亮出先秦诸子与浪漫主义双重顶峰的坐标；",
    "start": 179.656,
    "end": 187.016,
    "duration": 7.36
  },
  {
    "id": 46,
    "text": "随即精准引用鲁迅“汪洋辟河，莫能先也”的定论；",
    "start": 187.336,
    "end": 192.136,
    "duration": 4.8
  },
  {
    "id": 47,
    "text": "接着借助袁行配教材指出其超越干燥逻辑论辩的文学史飞跃；",
    "start": 192.136,
    "end": 197.656,
    "duration": 5.52
  },
  {
    "id": 48,
    "text": "最后引出四个分论点，开篇气度宏大。",
    "start": 197.656,
    "end": 201.016,
    "duration": 3.36
  },
  {
    "id": 49,
    "text": "所以本段具体答题完整版为：《庄子》是先秦诸子散文发展的最高峰，",
    "start": 201.016,
    "end": 206.376,
    "duration": 5.36
  },
  {
    "id": 50,
    "text": "更是中国古代文学浪漫主义的哲学源头。",
    "start": 206.376,
    "end": 209.736,
    "duration": 3.36
  },
  {
    "id": 51,
    "text": "鲁迅在《汉文学史纲要》中极口称赞：“汪洋辟河，",
    "start": 209.816,
    "end": 213.656,
    "duration": 3.84
  },
  {
    "id": 52,
    "text": "仪态万方，晚周诸子之作，莫能先也”。",
    "start": 213.656,
    "end": 217.176,
    "duration": 3.52
  },
  {
    "id": 53,
    "text": "袁行配《中国文学史》指出，《庄子》打破了传统说理散文枯燥逻辑论辩的桎梏。",
    "start": 217.176,
    "end": 223.896,
    "duration": 6.72
  },
  {
    "id": 54,
    "text": "它将深奥超逸的道家哲理，完全熔铸于生动绚烂的文学意象与奇崛想象之中。",
    "start": 223.896,
    "end": 230.536,
    "duration": 6.64
  },
  {
    "id": 55,
    "text": "其杰出的散文艺术与浪漫主义表现，",
    "start": 230.856,
    "end": 233.656,
    "duration": 2.8
  },
  {
    "id": 56,
    "text": "主要展现在以下四个核心维度：。",
    "start": 233.656,
    "end": 236.216,
    "duration": 2.56
  },
  {
    "id": 57,
    "text": "第二段：第一分论点，独具匠心的“三言”结构（体之“巧”）。",
    "start": 236.216,
    "end": 240.696,
    "duration": 4.48
  },
  {
    "id": 58,
    "text": "逐句因果推导与答题表述。",
    "start": 240.696,
    "end": 243.176,
    "duration": 2.48
  },
  {
    "id": 59,
    "text": "首段确立了其打破逻辑桎梏的前提，",
    "start": 243.176,
    "end": 246.376,
    "duration": 3.2
  },
  {
    "id": 60,
    "text": "第二段必须首先解答其叙事与说理体制的奥秘。",
    "start": 246.376,
    "end": 249.896,
    "duration": 3.52
  },
  {
    "id": 61,
    "text": "首句确立分论点，指出庄子摆脱了板滞的问答体，",
    "start": 250.136,
    "end": 254.856,
    "duration": 4.72
  },
  {
    "id": 62,
    "text": "建立了独特的哲学说理体系。",
    "start": 254.856,
    "end": 257.336,
    "duration": 2.48
  },
  {
    "id": 63,
    "text": "所以表述为：《庄子》彻底摆脱了先秦诸子板滞的对话体模式，",
    "start": 257.336,
    "end": 262.456,
    "duration": 5.12
  },
  {
    "id": 64,
    "text": "构建起独特的哲学说理体系。",
    "start": 262.456,
    "end": 265.096,
    "duration": 2.64
  },
  {
    "id": 65,
    "text": "次句直接引用《庄子》原文关于自身创作机制的千古名论。",
    "start": 265.096,
    "end": 269.336,
    "duration": 4.24
  },
  {
    "id": 66,
    "text": "所以表述为：《寓言》篇明确提出其创作机制：“寓言十九，",
    "start": 269.736,
    "end": 274.34,
    "duration": 4.604
  },
  {
    "id": 67,
    "text": "重言十七，之言日出，和以天倪”。",
    "start": 274.34,
    "end": 277.007,
    "duration": 2.667
  },
  {
    "id": 68,
    "text": "第三句深入界定“寓言”的机制，说明借虚构故事化抽象思辨为感性具象。",
    "start": 277.007,
    "end": 283.452,
    "duration": 6.445
  },
  {
    "id": 69,
    "text": "所以表述为：所谓寓言，即借虚构的故事与生动形象寄托深奥的哲理，",
    "start": 283.452,
    "end": 289.674,
    "duration": 6.222
  },
  {
    "id": 70,
    "text": "化抽象思辨为感性具象。",
    "start": 289.674,
    "end": 291.896,
    "duration": 2.222
  },
  {
    "id": 71,
    "text": "第四句界定“重言”的机制，说明托名圣贤长者以增加论说的权威厚度。",
    "start": 292.04,
    "end": 297.96,
    "duration": 5.92
  },
  {
    "id": 72,
    "text": "所以表述为：所谓重言，即假托古昔圣贤与历史名人之言，",
    "start": 297.96,
    "end": 303.4,
    "duration": 5.44
  },
  {
    "id": 73,
    "text": "借以增强论说的庄重与说服力。",
    "start": 303.4,
    "end": 306.2,
    "duration": 2.8
  },
  {
    "id": 74,
    "text": "第五句界定“之言”的机制，说明随顺万物、",
    "start": 306.2,
    "end": 309.56,
    "duration": 3.36
  },
  {
    "id": 75,
    "text": "空灵流动的论述无心境界。",
    "start": 309.56,
    "end": 311.56,
    "duration": 2.0
  },
  {
    "id": 76,
    "text": "所以表述为：所谓之言，即随顺万物变化、",
    "start": 311.88,
    "end": 315.411,
    "duration": 3.531
  },
  {
    "id": 77,
    "text": "不固执定见的无心之言，使论述空灵流动而不露斧凿之痕。",
    "start": 315.411,
    "end": 320.806,
    "duration": 5.395
  },
  {
    "id": 78,
    "text": "第六句揭示三者的综合效果，指出其让散文呈现虚实相生、",
    "start": 320.806,
    "end": 326.2,
    "duration": 5.394
  },
  {
    "id": 79,
    "text": "波决云诡的生机。",
    "start": 326.2,
    "end": 327.773,
    "duration": 1.573
  },
  {
    "id": 80,
    "text": "所以表述为：三者高度交融互摄，使《庄子》的散文呈现出虚实相生、",
    "start": 327.773,
    "end": 333.617,
    "duration": 5.844
  },
  {
    "id": 81,
    "text": "波决云诡的艺术生机。",
    "start": 333.617,
    "end": 335.64,
    "duration": 2.023
  },
  {
    "id": 82,
    "text": "第七句得出文学史总结，指出三言机制开启了中国叙事文学借象明理的传统。",
    "start": 335.72,
    "end": 342.92,
    "duration": 7.2
  },
  {
    "id": 83,
    "text": "所以表述为：这一机制彻底改变了古典散文的形态，",
    "start": 342.92,
    "end": 347.24,
    "duration": 4.32
  },
  {
    "id": 84,
    "text": "开启了中国古代叙事文学借象明理的传统。",
    "start": 347.24,
    "end": 351.08,
    "duration": 3.84
  },
  {
    "id": 85,
    "text": "本段答题思路总结。",
    "start": 351.08,
    "end": 352.92,
    "duration": 1.84
  },
  {
    "id": 86,
    "text": "本段聚焦于文学体制的革命性创新：以庄子自述的“三言”（寓言十九、",
    "start": 352.92,
    "end": 359.08,
    "duration": 6.16
  },
  {
    "id": 87,
    "text": "重言十七、之言日出）为核心抓手；",
    "start": 359.08,
    "end": 361.8,
    "duration": 2.72
  },
  {
    "id": 88,
    "text": "清晰阐明虚构故事、借重先贤与灵动之言各自的修辞功能与综合形态；",
    "start": 362.04,
    "end": 367.88,
    "duration": 5.84
  },
  {
    "id": 89,
    "text": "透辟论证了这种叙事机制如何将枯燥的说理转化为充满波澜与神采的艺术天地。",
    "start": 367.88,
    "end": 374.68,
    "duration": 6.8
  },
  {
    "id": 90,
    "text": "所以本段具体答题完整版为：一、独具匠心的“三言”结构：寓言、",
    "start": 374.68,
    "end": 379.72,
    "duration": 5.04
  },
  {
    "id": 91,
    "text": "重言与之言的哲学叙事机制。",
    "start": 379.72,
    "end": 381.56,
    "duration": 1.84
  },
  {
    "id": 92,
    "text": "《庄子》彻底摆脱了先秦诸子板滞的对话体模式，",
    "start": 381.72,
    "end": 386.065,
    "duration": 4.345
  },
  {
    "id": 93,
    "text": "构建起独特的哲学说理体系。",
    "start": 386.065,
    "end": 388.81,
    "duration": 2.745
  },
  {
    "id": 94,
    "text": "《寓言》篇明确提出其创作机制：“寓言十九，",
    "start": 388.81,
    "end": 392.469,
    "duration": 3.659
  },
  {
    "id": 95,
    "text": "重言十七，之言日出，和以天倪”。",
    "start": 392.469,
    "end": 395.213,
    "duration": 2.744
  },
  {
    "id": 96,
    "text": "所谓寓言，即借虚构的故事与生动形象寄托深奥的哲理，",
    "start": 395.213,
    "end": 400.473,
    "duration": 5.26
  },
  {
    "id": 97,
    "text": "化抽象思辨为感性具象。",
    "start": 400.473,
    "end": 402.76,
    "duration": 2.287
  },
  {
    "id": 98,
    "text": "所谓重言，即假托古昔圣贤与历史名人之言，",
    "start": 402.92,
    "end": 407.24,
    "duration": 4.32
  },
  {
    "id": 99,
    "text": "借以增强论说的庄重与说服力。",
    "start": 407.24,
    "end": 409.8,
    "duration": 2.56
  },
  {
    "id": 100,
    "text": "所谓之言，即随顺万物变化、不固执定见的无心之言，",
    "start": 409.8,
    "end": 414.44,
    "duration": 4.64
  },
  {
    "id": 101,
    "text": "使论述空灵流动而不露斧凿之痕。",
    "start": 414.44,
    "end": 417.64,
    "duration": 3.2
  },
  {
    "id": 102,
    "text": "三者高度交融互摄，使《庄子》的散文呈现出虚实相生、",
    "start": 417.64,
    "end": 422.52,
    "duration": 4.88
  },
  {
    "id": 103,
    "text": "波决云诡的艺术生机。",
    "start": 422.52,
    "end": 424.2,
    "duration": 1.68
  },
  {
    "id": 104,
    "text": "这一机制彻底改变了古典散文的形态，",
    "start": 424.6,
    "end": 427.8,
    "duration": 3.2
  },
  {
    "id": 105,
    "text": "开启了中国古代叙事文学借象明理的传统。。",
    "start": 427.8,
    "end": 431.72,
    "duration": 3.92
  },
  {
    "id": 106,
    "text": "第三段：第二分论点，奇崛宏肆的浪漫想象（象之“大”）。",
    "start": 431.72,
    "end": 436.2,
    "duration": 4.48
  },
  {
    "id": 107,
    "text": "逐句因果推导与答题表述。",
    "start": 436.2,
    "end": 438.28,
    "duration": 2.08
  },
  {
    "id": 108,
    "text": "第二段解决了说理的机制，第三段必须正面攻克庄子最耀眼的美学特质，",
    "start": 438.656,
    "end": 444.256,
    "duration": 5.6
  },
  {
    "id": 109,
    "text": "极度博大的浪漫想象。",
    "start": 444.256,
    "end": 446.256,
    "duration": 2.0
  },
  {
    "id": 110,
    "text": "首句立论，指出庄子拥有开阔惊艳的浪漫想象力，",
    "start": 446.256,
    "end": 450.496,
    "duration": 4.24
  },
  {
    "id": 111,
    "text": "长于营构跨越时空的壮美大象。",
    "start": 450.496,
    "end": 453.536,
    "duration": 3.04
  },
  {
    "id": 112,
    "text": "所以表述为：庄子拥有先秦文学中最开阔惊艳的浪漫想象力，",
    "start": 453.536,
    "end": 459.056,
    "duration": 5.52
  },
  {
    "id": 113,
    "text": "善于跨越时空界限建构壮美大象。",
    "start": 459.056,
    "end": 462.016,
    "duration": 2.96
  },
  {
    "id": 114,
    "text": "次句指出这一特质在名作《逍遥游》开篇中得到了最极致的体现。",
    "start": 462.336,
    "end": 467.536,
    "duration": 5.2
  },
  {
    "id": 115,
    "text": "所以表述为：这一艺术特质在名篇《逍遥游》开篇中得到了极致的挥洒。",
    "start": 467.536,
    "end": 473.784,
    "duration": 6.248
  },
  {
    "id": 116,
    "text": "第三句直接引用描摹坤鹏变化的千古奇观原句。",
    "start": 473.784,
    "end": 478.234,
    "duration": 4.45
  },
  {
    "id": 117,
    "text": "所以表述为：文中写道：“北冥有鱼，",
    "start": 478.234,
    "end": 481.126,
    "duration": 2.892
  },
  {
    "id": 118,
    "text": "其名为坤。",
    "start": 481.126,
    "end": 482.016,
    "duration": 0.89
  },
  {
    "id": 119,
    "text": "坤之大，不知其几千里也。",
    "start": 482.096,
    "end": 484.656,
    "duration": 2.56
  },
  {
    "id": 120,
    "text": "化而为鸟，其名为鹏”。",
    "start": 484.656,
    "end": 486.656,
    "duration": 2.0
  },
  {
    "id": 121,
    "text": "第四句剖析夸张手法的运用，大鹏背若泰山、",
    "start": 486.656,
    "end": 490.416,
    "duration": 3.76
  },
  {
    "id": 122,
    "text": "水击三千里的大空间铺排。",
    "start": 490.416,
    "end": 492.896,
    "duration": 2.48
  },
  {
    "id": 123,
    "text": "所以表述为：作者以极度夸张的笔墨，",
    "start": 492.896,
    "end": 495.936,
    "duration": 3.04
  },
  {
    "id": 124,
    "text": "描摹大鹏背若泰山、翼若垂天之云、",
    "start": 495.936,
    "end": 499.376,
    "duration": 3.44
  },
  {
    "id": 125,
    "text": "水击三千里的恢弘气势。",
    "start": 499.376,
    "end": 501.216,
    "duration": 1.84
  },
  {
    "id": 126,
    "text": "第五句深入揭示大鹏意象的精神象征，",
    "start": 501.536,
    "end": 504.496,
    "duration": 2.96
  },
  {
    "id": 127,
    "text": "代表生命挣脱羁绊追求绝对自由的崇高冲动。",
    "start": 504.496,
    "end": 508.035,
    "duration": 3.539
  },
  {
    "id": 128,
    "text": "所以表述为：坤鹏由溟海腾跃而起飞向南海的意象，",
    "start": 508.035,
    "end": 512.022,
    "duration": 3.987
  },
  {
    "id": 129,
    "text": "象征着个体生命挣脱羁绊追求绝对自由的崇高冲动。",
    "start": 512.022,
    "end": 516.199,
    "duration": 4.177
  },
  {
    "id": 130,
    "text": "第六句引入条与学鸠的嘲笑，说明小大之辨中的深刻精神反差。",
    "start": 516.199,
    "end": 521.136,
    "duration": 4.937
  },
  {
    "id": 131,
    "text": "所以表述为：紧接着以条与学鸠的嘲笑形成鲜明对比，",
    "start": 521.296,
    "end": 526.181,
    "duration": 4.885
  },
  {
    "id": 132,
    "text": "在大小之辨中展开精神层次的深刻思辨。",
    "start": 526.181,
    "end": 530.006,
    "duration": 3.825
  },
  {
    "id": 133,
    "text": "第七句总结收束全段，指出宏大想象不仅拓展了意象疆域，",
    "start": 530.006,
    "end": 535.406,
    "duration": 5.4
  },
  {
    "id": 134,
    "text": "更展现了非凡精神张力。",
    "start": 535.406,
    "end": 537.656,
    "duration": 2.25
  },
  {
    "id": 135,
    "text": "所以表述为：这种奇崛宏大的想象，",
    "start": 537.656,
    "end": 540.806,
    "duration": 3.15
  },
  {
    "id": 136,
    "text": "不仅极大地拓展了文学的意象疆域，",
    "start": 540.806,
    "end": 544.181,
    "duration": 3.375
  },
  {
    "id": 137,
    "text": "更展现出非凡的精神张力。",
    "start": 544.181,
    "end": 546.656,
    "duration": 2.475
  },
  {
    "id": 138,
    "text": "本段答题思路总结。",
    "start": 546.736,
    "end": 548.496,
    "duration": 1.76
  },
  {
    "id": 139,
    "text": "本段是整篇论述最具文采与气象的篇章：以《逍遥游》坤鹏飞腾的经典文本为解剖切片；",
    "start": 548.496,
    "end": 556.656,
    "duration": 8.16
  },
  {
    "id": 140,
    "text": "深入分析几千里、垂天之云、水击三千里等空间极度扩张的夸张技法；",
    "start": 556.656,
    "end": 562.816,
    "duration": 6.16
  },
  {
    "id": 141,
    "text": "由形入理，透彻阐发大鹏超越羁绊、",
    "start": 562.816,
    "end": 566.416,
    "duration": 3.6
  },
  {
    "id": 142,
    "text": "翱翔九天的绝对自由哲学，展现出壮阔非凡的浪漫主义风貌。",
    "start": 566.416,
    "end": 571.376,
    "duration": 4.96
  },
  {
    "id": 143,
    "text": "所以本段具体答题完整版为：二、奇崛宏肆的浪漫想象：极度开阔的宇宙空间与博大意象营构。",
    "start": 571.696,
    "end": 581.216,
    "duration": 9.52
  },
  {
    "id": 144,
    "text": "庄子拥有先秦文学中最开阔惊艳的浪漫想象力，",
    "start": 581.216,
    "end": 585.536,
    "duration": 4.32
  },
  {
    "id": 145,
    "text": "善于跨越时空界限建构壮美大象。",
    "start": 585.536,
    "end": 588.736,
    "duration": 3.2
  },
  {
    "id": 146,
    "text": "这一艺术特质在名篇《逍遥游》开篇中得到了极致的挥洒。",
    "start": 588.736,
    "end": 593.216,
    "duration": 4.48
  },
  {
    "id": 147,
    "text": "文中写道：“北冥有鱼，其名为坤。",
    "start": 593.504,
    "end": 596.624,
    "duration": 3.12
  },
  {
    "id": 148,
    "text": "坤之大，不知其几千里也。",
    "start": 596.624,
    "end": 599.104,
    "duration": 2.48
  },
  {
    "id": 149,
    "text": "化而为鸟，其名为鹏”。",
    "start": 599.104,
    "end": 601.664,
    "duration": 2.56
  },
  {
    "id": 150,
    "text": "作者以极度夸张的笔墨，描摹大鹏背若泰山、",
    "start": 601.664,
    "end": 605.824,
    "duration": 4.16
  },
  {
    "id": 151,
    "text": "翼若垂天之云、水击三千里的恢弘气势。",
    "start": 605.824,
    "end": 609.424,
    "duration": 3.6
  },
  {
    "id": 152,
    "text": "坤鹏由溟海腾跃而起飞向南海的意象，",
    "start": 609.424,
    "end": 612.784,
    "duration": 3.36
  },
  {
    "id": 153,
    "text": "象征着个体生命挣脱羁绊追求绝对自由的崇高冲动。",
    "start": 612.784,
    "end": 616.784,
    "duration": 4.0
  },
  {
    "id": 154,
    "text": "紧接着以条与学鸠的嘲笑形成鲜明对比，",
    "start": 617.024,
    "end": 620.704,
    "duration": 3.68
  },
  {
    "id": 155,
    "text": "在大小之辨中展开精神层次的深刻思辨。",
    "start": 620.704,
    "end": 624.464,
    "duration": 3.76
  },
  {
    "id": 156,
    "text": "这种奇崛宏大的想象，不仅极大地拓展了文学的意象疆域，",
    "start": 624.464,
    "end": 629.264,
    "duration": 4.8
  },
  {
    "id": 157,
    "text": "更展现出非凡的精神张力。。",
    "start": 629.264,
    "end": 631.584,
    "duration": 2.32
  },
  {
    "id": 158,
    "text": "第四段：第三分论点，意象诗意的哲理融铸（理之“化”）。",
    "start": 631.584,
    "end": 636.384,
    "duration": 4.8
  },
  {
    "id": 159,
    "text": "逐句因果推导与答题表述。",
    "start": 636.624,
    "end": 639.104,
    "duration": 2.48
  },
  {
    "id": 160,
    "text": "宏大意象之外，庄子更精于微观意象的诗意营构，",
    "start": 639.104,
    "end": 643.664,
    "duration": 4.56
  },
  {
    "id": 161,
    "text": "本段必须解答哲理如何化为纯粹诗意。",
    "start": 643.664,
    "end": 647.104,
    "duration": 3.44
  },
  {
    "id": 162,
    "text": "首句立论，指出庄子散文的魅力在于哲理完全化为无迹可寻的诗意七居。",
    "start": 647.104,
    "end": 654.064,
    "duration": 6.96
  },
  {
    "id": 163,
    "text": "所以表述为：《庄子》散文的魅力在于哲理不再是干燥的概念，",
    "start": 654.064,
    "end": 659.184,
    "duration": 5.12
  },
  {
    "id": 164,
    "text": "而是纯粹空灵的诗意七居。",
    "start": 659.184,
    "end": 661.424,
    "duration": 2.24
  },
  {
    "id": 165,
    "text": "次句指出其艺术机制，善于借用自然物象让无形的道显影成象。",
    "start": 661.744,
    "end": 667.264,
    "duration": 5.52
  },
  {
    "id": 166,
    "text": "所以表述为：庄子善于运用富于启发性的自然物象，",
    "start": 667.264,
    "end": 671.424,
    "duration": 4.16
  },
  {
    "id": 167,
    "text": "让形而上的“道”在视觉意象中自然显现。",
    "start": 671.424,
    "end": 674.864,
    "duration": 3.44
  },
  {
    "id": 168,
    "text": "第三句调取全书最具代表性、也是流传最广的哲学诗意意象。",
    "start": 674.864,
    "end": 679.584,
    "duration": 4.72
  },
  {
    "id": 169,
    "text": "所以表述为：最为著名的当属《齐物论》中的“庄周梦蝶”寓言。",
    "start": 679.984,
    "end": 684.812,
    "duration": 4.828
  },
  {
    "id": 170,
    "text": "第四句叙述庄周梦蝶的情境，栩栩然蝶与渠渠然周之间的难分真幻。",
    "start": 684.812,
    "end": 690.753,
    "duration": 5.941
  },
  {
    "id": 171,
    "text": "所以表述为：庄子自述梦为蝴蝶栩栩然，",
    "start": 690.753,
    "end": 694.147,
    "duration": 3.394
  },
  {
    "id": 172,
    "text": "醒后不知是庄周梦蝶还是蝴蝶梦庄周。",
    "start": 694.147,
    "end": 697.542,
    "duration": 3.395
  },
  {
    "id": 173,
    "text": "第五句剖析其美学内涵，打破物我界限，",
    "start": 697.542,
    "end": 700.937,
    "duration": 3.395
  },
  {
    "id": 174,
    "text": "阐明了物化合一、消除差别相的虚静境界。",
    "start": 700.937,
    "end": 704.544,
    "duration": 3.607
  },
  {
    "id": 175,
    "text": "所以表述为：这一著名的哲理意象超越了主客体对立，",
    "start": 704.704,
    "end": 709.424,
    "duration": 4.72
  },
  {
    "id": 176,
    "text": "以诗化笔触阐明了齐物合一、物化无界的虚静境界。",
    "start": 709.424,
    "end": 714.704,
    "duration": 5.28
  },
  {
    "id": 177,
    "text": "第六句补引《养生主》之“庖丁解牛”，",
    "start": 714.704,
    "end": 717.824,
    "duration": 3.12
  },
  {
    "id": 178,
    "text": "说明依乎天理的游刃有余生命美感。",
    "start": 717.824,
    "end": 720.944,
    "duration": 3.12
  },
  {
    "id": 179,
    "text": "所以表述为：又如《养生主》中的“庖丁解牛”，",
    "start": 720.944,
    "end": 724.704,
    "duration": 3.76
  },
  {
    "id": 180,
    "text": "将血腥屠宰升华为依乎天理、游刃有余的生命艺术体验。",
    "start": 724.704,
    "end": 729.824,
    "duration": 5.12
  },
  {
    "id": 181,
    "text": "第七句得出总结，意象的多义性与象征性达到了言尽意无穷的至高美学。",
    "start": 730.064,
    "end": 737.024,
    "duration": 6.96
  },
  {
    "id": 182,
    "text": "所以表述为：意象本身兼具多义性与象征性，",
    "start": 737.024,
    "end": 741.104,
    "duration": 4.08
  },
  {
    "id": 183,
    "text": "达到了言有尽而意无穷的至高审美境界。",
    "start": 741.104,
    "end": 745.584,
    "duration": 4.48
  },
  {
    "id": 184,
    "text": "本段答题思路总结。",
    "start": 745.584,
    "end": 747.184,
    "duration": 1.6
  },
  {
    "id": 185,
    "text": "本段聚焦于哲学思想的诗性转化：以“庄周梦蝶”为核心例证，",
    "start": 747.56,
    "end": 752.52,
    "duration": 4.96
  },
  {
    "id": 186,
    "text": "剖析真幻交融、物我界限消弭的齐物美学；",
    "start": 752.52,
    "end": 756.68,
    "duration": 4.16
  },
  {
    "id": 187,
    "text": "紧接着以“庖丁解牛”证明将日常劳作升华为顺应自然天道的审美超越；",
    "start": 756.68,
    "end": 762.84,
    "duration": 6.16
  },
  {
    "id": 188,
    "text": "证明庄子不是概念推演，而是象外生境，",
    "start": 762.84,
    "end": 766.12,
    "duration": 3.28
  },
  {
    "id": 189,
    "text": "将冷冰冰的思辩彻底融化在诗意氤氲的意境之中。",
    "start": 766.12,
    "end": 770.04,
    "duration": 3.92
  },
  {
    "id": 190,
    "text": "所以本段具体答题完整版为：三、意象诗意的哲理融铸：以象寓意与物我两忘的审美意境。",
    "start": 770.36,
    "end": 778.68,
    "duration": 8.32
  },
  {
    "id": 191,
    "text": "《庄子》散文的魅力在于哲理不再是干燥的概念，",
    "start": 778.68,
    "end": 782.2,
    "duration": 3.52
  },
  {
    "id": 192,
    "text": "而是纯粹空灵的诗意七居。",
    "start": 782.2,
    "end": 784.52,
    "duration": 2.32
  },
  {
    "id": 193,
    "text": "庄子善于运用富于启发性的自然物象，",
    "start": 784.52,
    "end": 787.8,
    "duration": 3.28
  },
  {
    "id": 194,
    "text": "让形而上的“道”在视觉意象中自然显现。",
    "start": 787.8,
    "end": 791.08,
    "duration": 3.28
  },
  {
    "id": 195,
    "text": "最为著名的当属《齐物论》中的“庄周梦蝶”寓言。",
    "start": 791.32,
    "end": 795.48,
    "duration": 4.16
  },
  {
    "id": 196,
    "text": "庄子自述梦为蝴蝶栩栩然，醒后不知是庄周梦蝶还是蝴蝶梦庄周。",
    "start": 795.48,
    "end": 801.56,
    "duration": 6.08
  },
  {
    "id": 197,
    "text": "这一著名的哲理意象超越了主客体对立，",
    "start": 801.56,
    "end": 805.16,
    "duration": 3.6
  },
  {
    "id": 198,
    "text": "以诗化笔触阐明了齐物合一、物化无界的虚静境界。",
    "start": 805.16,
    "end": 810.36,
    "duration": 5.2
  },
  {
    "id": 199,
    "text": "又如《养生主》中的“庖丁解牛”，",
    "start": 810.36,
    "end": 812.68,
    "duration": 2.32
  },
  {
    "id": 200,
    "text": "将血腥屠宰升华为依乎天理、游刃有余的生命艺术体验。",
    "start": 812.68,
    "end": 817.48,
    "duration": 4.8
  },
  {
    "id": 201,
    "text": "意象本身兼具多义性与象征性，达到了言有尽而意无穷的至高审美境界。。",
    "start": 817.72,
    "end": 824.2,
    "duration": 6.48
  },
  {
    "id": 202,
    "text": "第五段：第四分论点，情感深处的激愤痛切（情之“烈”）。",
    "start": 824.2,
    "end": 828.92,
    "duration": 4.72
  },
  {
    "id": 203,
    "text": "逐句因果推导与答题表述。",
    "start": 828.92,
    "end": 831.48,
    "duration": 2.56
  },
  {
    "id": 204,
    "text": "在解决了形式、意象与哲理之后，本段必须穿透超脱的表象，",
    "start": 831.48,
    "end": 836.36,
    "duration": 4.88
  },
  {
    "id": 205,
    "text": "揭示庄子深沉的人格情感。",
    "start": 836.36,
    "end": 838.36,
    "duration": 2.0
  },
  {
    "id": 206,
    "text": "首句立论，指出庄子看似清虚超脱，",
    "start": 838.68,
    "end": 842.2,
    "duration": 3.52
  },
  {
    "id": 207,
    "text": "内里却饱含对战国乱世最深沉的激愤。",
    "start": 842.2,
    "end": 845.88,
    "duration": 3.68
  },
  {
    "id": 208,
    "text": "所以表述为：《庄子》表面看似清虚超脱、",
    "start": 845.88,
    "end": 849.4,
    "duration": 3.52
  },
  {
    "id": 209,
    "text": "任运随顺，骨子里却蕴含着对战乱现实最深沉的激愤。",
    "start": 849.4,
    "end": 854.84,
    "duration": 5.44
  },
  {
    "id": 210,
    "text": "次句推导因果，生于乱世目睹道德沦丧与生灵涂炭，",
    "start": 854.84,
    "end": 859.88,
    "duration": 5.04
  },
  {
    "id": 211,
    "text": "必然产生强烈的痛切感。",
    "start": 859.88,
    "end": 861.88,
    "duration": 2.0
  },
  {
    "id": 212,
    "text": "所以表述为：庄子生逢战国乱世，目睹道德沦丧、",
    "start": 862.12,
    "end": 866.442,
    "duration": 4.322
  },
  {
    "id": 213,
    "text": "生灵涂炭与强权暴虐，内心怀抱着深刻的人性悲哀。",
    "start": 866.442,
    "end": 871.297,
    "duration": 4.855
  },
  {
    "id": 214,
    "text": "第三句引用其痛斥世俗政治最尖锐的千古警句。",
    "start": 871.297,
    "end": 875.921,
    "duration": 4.624
  },
  {
    "id": 215,
    "text": "所以表述为：他愤激痛斥“窃钩者诛，",
    "start": 875.921,
    "end": 879.158,
    "duration": 3.237
  },
  {
    "id": 216,
    "text": "窃国者为诸侯”，以辛辣幽默的语言撕开封建仁义礼法的虚伪面具。",
    "start": 879.158,
    "end": 885.4,
    "duration": 6.242
  },
  {
    "id": 217,
    "text": "第四句指出面对生死困境时的冷峻反叛，",
    "start": 885.48,
    "end": 889.08,
    "duration": 3.6
  },
  {
    "id": 218,
    "text": "以鼓盆而歌抵抗世俗异化。",
    "start": 889.08,
    "end": 891.64,
    "duration": 2.56
  },
  {
    "id": 219,
    "text": "所以表述为：在面对生死与困顿的绝境时，",
    "start": 891.64,
    "end": 895.08,
    "duration": 3.44
  },
  {
    "id": 220,
    "text": "他以鼓盆而歌、坦然受死的冷峻态度抵抗世俗异化。",
    "start": 895.08,
    "end": 898.92,
    "duration": 3.84
  },
  {
    "id": 221,
    "text": "第五句指出这种深沉情感在语言上的体现，",
    "start": 899.216,
    "end": 903.296,
    "duration": 4.08
  },
  {
    "id": 222,
    "text": "如天赖倾泻、奔腾恣肆。",
    "start": 903.296,
    "end": 906.176,
    "duration": 2.88
  },
  {
    "id": 223,
    "text": "所以表述为：这种激愤之情化为散文中奔腾恣肆的语流，",
    "start": 906.176,
    "end": 911.536,
    "duration": 5.36
  },
  {
    "id": 224,
    "text": "行文如天赖倾泻，跌宕起伏而不可阻遏。",
    "start": 911.536,
    "end": 915.296,
    "duration": 3.76
  },
  {
    "id": 225,
    "text": "第六句总结全段，指出冷酷嘲讽的背面是极致的悲敏，",
    "start": 915.456,
    "end": 920.656,
    "duration": 5.2
  },
  {
    "id": 226,
    "text": "构成了庄子崇高的人格精神力量。",
    "start": 920.656,
    "end": 923.376,
    "duration": 2.72
  },
  {
    "id": 227,
    "text": "所以表述为：冷酷嘲讽的背面是极致的悲敏，",
    "start": 923.696,
    "end": 927.296,
    "duration": 3.6
  },
  {
    "id": 228,
    "text": "构成了庄子散文雄浑峻拔的人格精神力量。",
    "start": 927.296,
    "end": 930.976,
    "duration": 3.68
  },
  {
    "id": 229,
    "text": "本段答题思路总结。",
    "start": 930.976,
    "end": 932.656,
    "duration": 1.68
  },
  {
    "id": 230,
    "text": "本段是对庄子人格精神的深度审视：打破庸俗网课将庄子视为“躺平虚无”的误解，",
    "start": 932.656,
    "end": 938.896,
    "duration": 6.24
  },
  {
    "id": 231,
    "text": "明确指出超脱表象背后是对战国暴虐与窃国诸侯的深恶痛绝；",
    "start": 938.896,
    "end": 944.496,
    "duration": 5.6
  },
  {
    "id": 232,
    "text": "结合“鼓盆而歌”与极具批判力的语言，",
    "start": 944.736,
    "end": 947.936,
    "duration": 3.2
  },
  {
    "id": 233,
    "text": "论证了庄子愤世嫉俗、抗拒异化的高蹈人格，",
    "start": 947.936,
    "end": 952.256,
    "duration": 4.32
  },
  {
    "id": 234,
    "text": "使整篇答卷具备了撼动人心的思想重量。",
    "start": 952.256,
    "end": 956.096,
    "duration": 3.84
  },
  {
    "id": 235,
    "text": "所以本段具体答题完整版为：四、情感深处的激愤痛切：冷峻超脱表象下的社会批判与生命悲敏。",
    "start": 956.096,
    "end": 964.576,
    "duration": 8.48
  },
  {
    "id": 236,
    "text": "《庄子》表面看似清虚超脱、任运随顺，",
    "start": 964.656,
    "end": 967.994,
    "duration": 3.338
  },
  {
    "id": 237,
    "text": "骨子里却蕴含着对战乱现实最深沉的激愤。",
    "start": 967.994,
    "end": 972.286,
    "duration": 4.292
  },
  {
    "id": 238,
    "text": "庄子生逢战国乱世，目睹道德沦丧、",
    "start": 972.286,
    "end": 975.625,
    "duration": 3.339
  },
  {
    "id": 239,
    "text": "生灵涂炭与强权暴虐，内心怀抱着深刻的人性悲哀。",
    "start": 975.625,
    "end": 980.632,
    "duration": 5.007
  },
  {
    "id": 240,
    "text": "他愤激痛斥“窃钩者诛，窃国者为诸侯”，",
    "start": 980.632,
    "end": 984.209,
    "duration": 3.577
  },
  {
    "id": 241,
    "text": "以辛辣幽默的语言撕开封建仁义礼法的虚伪面具。",
    "start": 984.209,
    "end": 989.216,
    "duration": 5.007
  },
  {
    "id": 242,
    "text": "在面对生死与困顿的绝境时，他以鼓盆而歌、",
    "start": 989.376,
    "end": 993.216,
    "duration": 3.84
  },
  {
    "id": 243,
    "text": "坦然受死的冷峻态度抵抗世俗异化。",
    "start": 993.216,
    "end": 996.656,
    "duration": 3.44
  },
  {
    "id": 244,
    "text": "这种激愤之情化为散文中奔腾恣肆的语流，",
    "start": 996.656,
    "end": 1000.576,
    "duration": 3.92
  },
  {
    "id": 245,
    "text": "行文如天赖倾泻，跌宕起伏而不可阻遏。",
    "start": 1000.576,
    "end": 1004.416,
    "duration": 3.84
  },
  {
    "id": 246,
    "text": "冷酷嘲讽的背面是极致的悲敏，构成了庄子散文雄浑峻拔的人格精神力量。",
    "start": 1004.416,
    "end": 1010.816,
    "duration": 6.4
  },
  {
    "id": 247,
    "text": "第六段：尾段收官与文学史谱系闭环。",
    "start": 1011.056,
    "end": 1014.496,
    "duration": 3.44
  },
  {
    "id": 248,
    "text": "逐句因果推导与答题表述。",
    "start": 1014.496,
    "end": 1017.296,
    "duration": 2.8
  },
  {
    "id": 249,
    "text": "尾段作为三十分大题的收官，必须将庄子置入中国文学精神脉络中定型。",
    "start": 1017.296,
    "end": 1023.536,
    "duration": 6.24
  },
  {
    "id": 250,
    "text": "首句全面综合前述四个维度，盛赞其实现了深奥思辨与文学才华的天才结合。",
    "start": 1023.536,
    "end": 1030.176,
    "duration": 6.64
  },
  {
    "id": 251,
    "text": "所以表述为：综上所述，《庄子》实现了深刻哲学思辨与杰出文学才华的天才结合。",
    "start": 1030.576,
    "end": 1037.287,
    "duration": 6.711
  },
  {
    "id": 252,
    "text": "次句确立其历史范式地位，指出其开创了中国诗意哲学与浪漫主义散文的宏伟传统。",
    "start": 1037.287,
    "end": 1044.773,
    "duration": 7.486
  },
  {
    "id": 253,
    "text": "所以表述为：它开创了中国古代诗意哲学与浪漫主义散文的宏伟范式。",
    "start": 1044.773,
    "end": 1050.976,
    "duration": 6.203
  },
  {
    "id": 254,
    "text": "第三句向后纵向延展，列举魏晋嵇康、",
    "start": 1051.056,
    "end": 1054.496,
    "duration": 3.44
  },
  {
    "id": 255,
    "text": "东晋陶渊明、盛唐李白与北宋苏轼的承接。",
    "start": 1054.496,
    "end": 1058.096,
    "duration": 3.6
  },
  {
    "id": 256,
    "text": "所以表述为：这一传统直接哺育了魏晋阮籍、",
    "start": 1058.56,
    "end": 1062.4,
    "duration": 3.84
  },
  {
    "id": 257,
    "text": "嵇康的傲岸风骨，陶渊明的归真美学，",
    "start": 1062.4,
    "end": 1066.0,
    "duration": 3.6
  },
  {
    "id": 258,
    "text": "李白的狂放诗风与苏轼的旷达文采。",
    "start": 1066.0,
    "end": 1069.2,
    "duration": 3.2
  },
  {
    "id": 259,
    "text": "第四句得出最终定评，确立其作为民族精神自由与文学创造力源头活水的永恒地位。",
    "start": 1069.2,
    "end": 1076.48,
    "duration": 7.28
  },
  {
    "id": 260,
    "text": "所以表述为：《庄子》因而成为中华民族精神自由与文学创造力取之不尽的源头活水。",
    "start": 1076.48,
    "end": 1083.6,
    "duration": 7.12
  },
  {
    "id": 261,
    "text": "本段答题思路总结。",
    "start": 1083.92,
    "end": 1085.6,
    "duration": 1.68
  },
  {
    "id": 262,
    "text": "本段完成了极其开阔的文学史谱系收束：以才思结合高度总结前文；",
    "start": 1085.6,
    "end": 1091.52,
    "duration": 5.92
  },
  {
    "id": 263,
    "text": "随后清晰梳理出由庄子出发，流淌至魏晋竹林七贤、",
    "start": 1091.52,
    "end": 1096.08,
    "duration": 4.56
  },
  {
    "id": 264,
    "text": "陶渊明自然田园、盛唐李白浪漫飞扬、",
    "start": 1096.08,
    "end": 1099.52,
    "duration": 3.44
  },
  {
    "id": 265,
    "text": "以及两宋苏轼旷达豁达的传承谱系，",
    "start": 1099.52,
    "end": 1102.8,
    "duration": 3.28
  },
  {
    "id": 266,
    "text": "有力论证了庄子思想对中国文人士大夫精神人格与文学艺术的根本性塑造。",
    "start": 1102.8,
    "end": 1108.72,
    "duration": 5.92
  },
  {
    "id": 267,
    "text": "所以本段具体答题完整版为：综上所述，",
    "start": 1109.04,
    "end": 1112.56,
    "duration": 3.52
  },
  {
    "id": 268,
    "text": "《庄子》实现了深刻哲学思辨与杰出文学才华的天才结合。",
    "start": 1112.56,
    "end": 1117.6,
    "duration": 5.04
  },
  {
    "id": 269,
    "text": "它开创了中国古代诗意哲学与浪漫主义散文的宏伟范式。",
    "start": 1117.6,
    "end": 1122.48,
    "duration": 4.88
  },
  {
    "id": 270,
    "text": "这一传统直接哺育了魏晋阮籍、嵇康的傲岸风骨，",
    "start": 1122.48,
    "end": 1127.28,
    "duration": 4.8
  },
  {
    "id": 271,
    "text": "陶渊明的归真美学，李白的狂放诗风与苏轼的旷达文采。",
    "start": 1127.28,
    "end": 1132.24,
    "duration": 4.96
  },
  {
    "id": 272,
    "text": "《庄子》因而成为中华民族精神自由与文学创造力取之不尽的源头活水。。",
    "start": 1132.48,
    "end": 1138.598,
    "duration": 6.118
  },
  {
    "id": 273,
    "text": "整道大题的内在逻辑链总括。",
    "start": 1138.598,
    "end": 1141.13,
    "duration": 2.532
  },
  {
    "id": 274,
    "text": "这道、三十、分大题的本质，是一场极度严密的逻辑推演。",
    "start": 1141.13,
    "end": 1145.771,
    "duration": 4.641
  },
  {
    "id": 275,
    "text": "整篇答卷从头到尾遵循着“由典范定评、",
    "start": 1145.771,
    "end": 1149.147,
    "duration": 3.376
  },
  {
    "id": 276,
    "text": "到三言结构、到坤鹏大象、到梦蝶诗境、",
    "start": 1149.147,
    "end": 1152.312,
    "duration": 3.165
  },
  {
    "id": 277,
    "text": "到痛切情志、最终回归文学史承续”的必然法则。",
    "start": 1152.312,
    "end": 1156.32,
    "duration": 4.008
  },
  {
    "id": 278,
    "text": "阅卷老师看到的绝不是散乱的答题点，",
    "start": 1156.4,
    "end": 1159.36,
    "duration": 2.96
  },
  {
    "id": 279,
    "text": "而是一条咬合紧密的因果长链：第一步是“立论定性”，",
    "start": 1159.36,
    "end": 1163.68,
    "duration": 4.32
  },
  {
    "id": 280,
    "text": "开门见山借鲁迅“莫能先也”定评，",
    "start": 1163.68,
    "end": 1166.8,
    "duration": 3.12
  },
  {
    "id": 281,
    "text": "确立《庄子》作为浪漫主义哲学散文巅峰的坐标。",
    "start": 1166.8,
    "end": 1170.24,
    "duration": 3.44
  },
  {
    "id": 282,
    "text": "第二步是“三言叙事”，以寓言、重言与之言的交融互摄，",
    "start": 1170.24,
    "end": 1174.72,
    "duration": 4.48
  },
  {
    "id": 283,
    "text": "剖析借象明理重构说理散文体制的核心机制。",
    "start": 1174.72,
    "end": 1178.72,
    "duration": 4.0
  },
  {
    "id": 284,
    "text": "第三步是“浪漫想象”，以《逍遥游》坤鹏大象与小大之辨，",
    "start": 1178.8,
    "end": 1183.44,
    "duration": 4.64
  },
  {
    "id": 285,
    "text": "论证在极度开阔的宇宙空间中展现绝对精神自由。",
    "start": 1183.44,
    "end": 1187.92,
    "duration": 4.48
  },
  {
    "id": 286,
    "text": "第四步是“哲理融铸”，以“庄周梦蝶”与“庖丁解牛”，",
    "start": 1187.92,
    "end": 1192.08,
    "duration": 4.16
  },
  {
    "id": 287,
    "text": "阐明物我合一、依乎天理的空灵诗意美学。",
    "start": 1192.08,
    "end": 1195.68,
    "duration": 3.6
  },
  {
    "id": 288,
    "text": "第五步是“深层悲敏”，以“窃国者侯”与“鼓盆而歌”，",
    "start": 1195.68,
    "end": 1199.76,
    "duration": 4.08
  },
  {
    "id": 289,
    "text": "揭示超脱外表下对战乱现实的激愤痛切与高蹈人格。",
    "start": 1199.76,
    "end": 1204.4,
    "duration": 4.64
  },
  {
    "id": 290,
    "text": "第六步是“史学闭环”，把《庄子》的精神河流自然引向阮籍、",
    "start": 1204.688,
    "end": 1209.648,
    "duration": 4.96
  },
  {
    "id": 291,
    "text": "陶渊明、李白与苏轼的浩瀚星空。",
    "start": 1209.648,
    "end": 1212.448,
    "duration": 2.8
  },
  {
    "id": 292,
    "text": "这六步层层递进，前一步的结论必然成为后一步的前提。",
    "start": 1212.448,
    "end": 1216.848,
    "duration": 4.4
  },
  {
    "id": 293,
    "text": "你在考场上顺着因果关系顺流而下，",
    "start": 1216.848,
    "end": 1219.648,
    "duration": 2.8
  },
  {
    "id": 294,
    "text": "就能自然写出近千字的满分答卷。",
    "start": 1219.648,
    "end": 1222.128,
    "duration": 2.48
  }
]