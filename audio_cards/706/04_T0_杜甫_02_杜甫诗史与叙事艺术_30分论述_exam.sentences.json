[
  {
    "id": 1,
    "text": "“诗史”是后世对杜甫诗歌思想价值与纪实功能的高度定评。",
    "start": 0.0,
    "end": 5.515,
    "duration": 5.515
  },
  {
    "id": 2,
    "text": "这一概念最早见于中唐孟起在《本事诗》中的评述。",
    "start": 5.515,
    "end": 10.111,
    "duration": 4.596
  },
  {
    "id": 3,
    "text": "《新唐书•杜甫传》亦明确记载：“读其诗，",
    "start": 10.111,
    "end": 13.329,
    "duration": 3.218
  },
  {
    "id": 4,
    "text": "可以知其世，故当时谓之诗史”。",
    "start": 13.329,
    "end": 16.086,
    "duration": 2.757
  },
  {
    "id": 5,
    "text": "袁行配《中国文学史》指出，杜甫的“诗史”实现了历史真实与主观抒情的完美融合。",
    "start": 16.086,
    "end": 23.44,
    "duration": 7.354
  },
  {
    "id": 6,
    "text": "它不仅客观展现了唐代由盛转衰的历史全景，",
    "start": 23.52,
    "end": 27.28,
    "duration": 3.76
  },
  {
    "id": 7,
    "text": "更展现了时代动荡下的士人心灵史。",
    "start": 27.28,
    "end": 30.4,
    "duration": 3.12
  },
  {
    "id": 8,
    "text": "其核心艺术特征与叙事成就，主要展现为以下四个维度：杜甫诗歌打破了传统抒情诗局限于狭隘私情的弊端，",
    "start": 30.4,
    "end": 39.2,
    "duration": 8.8
  },
  {
    "id": 9,
    "text": "以广阔的史家笔法直面社会现实。",
    "start": 39.2,
    "end": 42.0,
    "duration": 2.8
  },
  {
    "id": 10,
    "text": "他完整记录了天宝后期政治腐败、安史之乱爆发及战后凋敝的完整历史轨迹。",
    "start": 42.24,
    "end": 49.28,
    "duration": 7.04
  },
  {
    "id": 11,
    "text": "天宝盛世表象之下，杜甫写下著名乐府名篇《兵车行》。",
    "start": 49.28,
    "end": 54.32,
    "duration": 5.04
  },
  {
    "id": 12,
    "text": "诗中写道：“车临临，马萧萧，行人弓箭各在腰”。",
    "start": 54.32,
    "end": 58.88,
    "duration": 4.56
  },
  {
    "id": 13,
    "text": "诗人以震撼人心的征兵图景，敏锐揭示了统治集团开边拓土给百姓带来的深重灾难。",
    "start": 58.88,
    "end": 65.6,
    "duration": 6.72
  },
  {
    "id": 14,
    "text": "长安沦陷之后，诗人又在《春望》中写道：“国破山河在，",
    "start": 65.92,
    "end": 70.32,
    "duration": 4.4
  },
  {
    "id": 15,
    "text": "城春草木深”。",
    "start": 70.32,
    "end": 71.84,
    "duration": 1.52
  },
  {
    "id": 16,
    "text": "杜甫将国破之悲与城春之景交织，成为展现安史之乱国破家亡的标志性历史底片。",
    "start": 71.84,
    "end": 78.96,
    "duration": 7.12
  },
  {
    "id": 17,
    "text": "这种对重大历史事件的准确把握，赋予杜诗极为扎实的史学文献价值。",
    "start": 78.96,
    "end": 84.32,
    "duration": 5.36
  },
  {
    "id": 18,
    "text": "不同于传统封建正史偏重帝王将相与政治权谋，",
    "start": 84.56,
    "end": 89.04,
    "duration": 4.48
  },
  {
    "id": 19,
    "text": "杜甫的叙事诗开创了平民视角的修史范式。",
    "start": 89.04,
    "end": 93.04,
    "duration": 4.0
  },
  {
    "id": 20,
    "text": "他将视线全面下移至处于战乱苦难之中的底层农夫、",
    "start": 93.04,
    "end": 97.76,
    "duration": 4.72
  },
  {
    "id": 21,
    "text": "老妇与弃卒。",
    "start": 97.76,
    "end": 99.52,
    "duration": 1.76
  },
  {
    "id": 22,
    "text": "其叙事巅峰之作，当属乾元二年在战乱途中所作的《三吏》与《三别》。",
    "start": 99.52,
    "end": 105.28,
    "duration": 5.76
  },
  {
    "id": 23,
    "text": "在名篇《石壕吏》中，杜甫以客观投宿者的视角冷静起笔：“暮投石壕村，",
    "start": 105.6,
    "end": 112.0,
    "duration": 6.4
  },
  {
    "id": 24,
    "text": "有吏夜捉人”。",
    "start": 112.0,
    "end": 113.52,
    "duration": 1.52
  },
  {
    "id": 25,
    "text": "随后通过老妇哭诉全家三男邺城从军的悲剧细节，",
    "start": 113.52,
    "end": 118.08,
    "duration": 4.56
  },
  {
    "id": 26,
    "text": "真实揭露了官差横征暴敛的残酷本质。",
    "start": 118.08,
    "end": 121.76,
    "duration": 3.68
  },
  {
    "id": 27,
    "text": "杜甫既痛心于黎民之惨烈牺牲，又深明保卫社稷之历史大局。",
    "start": 121.76,
    "end": 126.8,
    "duration": 5.04
  },
  {
    "id": 28,
    "text": "这种在矛盾中饱含同情的平民书写，",
    "start": 127.04,
    "end": 130.16,
    "duration": 3.12
  },
  {
    "id": 29,
    "text": "使诗歌具备了超越官方史书的深沉人性力量。",
    "start": 130.16,
    "end": 134.08,
    "duration": 3.92
  },
  {
    "id": 30,
    "text": "杜甫在叙事文体与艺术表现上完成了突破性的创新，",
    "start": 134.08,
    "end": 138.4,
    "duration": 4.32
  },
  {
    "id": 31,
    "text": "彻底摆脱了汉魏乐府旧题的束缚。",
    "start": 138.4,
    "end": 141.2,
    "duration": 2.8
  },
  {
    "id": 32,
    "text": "元稹在《唐故工部员外郎杜君墓志铭》中称赞其“即事名篇，",
    "start": 141.2,
    "end": 146.24,
    "duration": 5.04
  },
  {
    "id": 33,
    "text": "无复依傍”。",
    "start": 146.24,
    "end": 147.04,
    "duration": 0.8
  },
  {
    "id": 34,
    "text": "杜甫完全依据眼前发生的真实历史事件创设新题，",
    "start": 147.344,
    "end": 151.504,
    "duration": 4.16
  },
  {
    "id": 35,
    "text": "奠定了后世新题乐府的体裁范式。",
    "start": 151.504,
    "end": 154.464,
    "duration": 2.96
  },
  {
    "id": 36,
    "text": "在具体叙事技巧上，杜甫极善于抓取戏剧化场景与典型对话。",
    "start": 154.464,
    "end": 159.824,
    "duration": 5.36
  },
  {
    "id": 37,
    "text": "在《新婚别》中，他借新娘之口诉说新婚未满即奔赴死地的大义与绝望。",
    "start": 159.824,
    "end": 166.064,
    "duration": 6.24
  },
  {
    "id": 38,
    "text": "全诗采用第三人称白描与第一人称独白交织的手法，",
    "start": 166.064,
    "end": 170.384,
    "duration": 4.32
  },
  {
    "id": 39,
    "text": "使叙事极富空间感与动态张力。",
    "start": 170.384,
    "end": 173.104,
    "duration": 2.72
  },
  {
    "id": 40,
    "text": "这表明古典诗歌在杜甫笔下，已经由单纯的抒情符号演化为成熟的叙事载体。",
    "start": 173.344,
    "end": 179.984,
    "duration": 6.64
  },
  {
    "id": 41,
    "text": "杜诗之所以被称为“诗史”，根本原因在于它既是“史”，",
    "start": 179.984,
    "end": 184.544,
    "duration": 4.56
  },
  {
    "id": 42,
    "text": "但其底色依然是“诗”。",
    "start": 184.544,
    "end": 186.544,
    "duration": 2.0
  },
  {
    "id": 43,
    "text": "杜甫继承了司马迁《史记》的“不虚美，",
    "start": 186.544,
    "end": 189.584,
    "duration": 3.04
  },
  {
    "id": 44,
    "text": "不隐恶”的实录风骨，敢于直刺权贵之昏庸。",
    "start": 189.584,
    "end": 192.944,
    "duration": 3.36
  },
  {
    "id": 45,
    "text": "但他并未停留于冷冰冰的历史编年，",
    "start": 193.264,
    "end": 196.144,
    "duration": 2.88
  },
  {
    "id": 46,
    "text": "而是将强烈的儒家爱民诗心注入每一次叙事之中。",
    "start": 196.144,
    "end": 200.144,
    "duration": 4.0
  },
  {
    "id": 47,
    "text": "在著名长篇《自京赴奉先县咏怀五百字》中，",
    "start": 200.144,
    "end": 204.224,
    "duration": 4.08
  },
  {
    "id": 48,
    "text": "诗人直面一己荣枯与天下危局。",
    "start": 204.224,
    "end": 206.944,
    "duration": 2.72
  },
  {
    "id": 49,
    "text": "诗史的内核是杜甫博大的胸襟与崇高的价值判断。",
    "start": 206.944,
    "end": 211.104,
    "duration": 4.16
  },
  {
    "id": 50,
    "text": "它展现的不仅是外部历史事实的真实，",
    "start": 211.104,
    "end": 213.984,
    "duration": 2.88
  },
  {
    "id": 51,
    "text": "更是历史震荡中一代仁人志士心灵搏击的真实。",
    "start": 213.984,
    "end": 217.584,
    "duration": 3.6
  },
  {
    "id": 52,
    "text": "综上所述，杜甫的“诗史”是求真史识与悲敏诗心相交融的文学丰碑。",
    "start": 217.904,
    "end": 224.624,
    "duration": 6.72
  },
  {
    "id": 53,
    "text": "它彻底拓展了古典诗歌反映社会生活的深度与广度，",
    "start": 224.624,
    "end": 229.104,
    "duration": 4.48
  },
  {
    "id": 54,
    "text": "实现了叙事诗体系的历史性飞跃。",
    "start": 229.104,
    "end": 231.904,
    "duration": 2.8
  },
  {
    "id": 55,
    "text": "这一艺术传统直接启迪了中唐元结、",
    "start": 231.904,
    "end": 234.864,
    "duration": 2.96
  },
  {
    "id": 56,
    "text": "顾况的写实探索。",
    "start": 234.864,
    "end": 236.464,
    "duration": 1.6
  },
  {
    "id": 57,
    "text": "更是后世白居易、元稹倡导“新乐府运动”的核心精神源头与艺术楷模。--",
    "start": 236.464,
    "end": 242.304,
    "duration": 5.84
  }
]