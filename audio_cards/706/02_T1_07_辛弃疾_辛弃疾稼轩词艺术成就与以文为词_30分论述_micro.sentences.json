[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "辛弃疾·稼轩词艺术成就与以文为词",
    "start": 0.134,
    "end": 3.61,
    "duration": 3.476
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "由文入典、由战入谐：承接苏轼再向前一步“以文为词”引入辞赋设问，",
    "start": 4.199,
    "end": 11.346,
    "duration": 7.147
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "接着在字里行间密织经史典故刺痛南宋政局，随后用亲历沙场的铁马豪情写出极反差悲歌，",
    "start": 11.66,
    "end": 20.265,
    "duration": 8.606
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "同时兼擅村居清趣而聚合南宋辛派一宗。",
    "start": 20.379,
    "end": 24.285,
    "duration": 3.905
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "辛弃疾是南宋豪放词集大成者，“归正人”际遇令其将沙场壮怀注入词调。",
    "start": 24.858,
    "end": 31.238,
    "duration": 6.379
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "刘克庄赞“横绝六合，扫空万古”，周济《宋四家词选》评其“沉着痛快，有辙可循”。",
    "start": 31.825,
    "end": 39.115,
    "duration": 7.291
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 推行“以文为词”、入散文辞赋章法",
    "start": 39.689,
    "end": 43.269,
    "duration": 3.58
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "打破整齐拘束，引入散文辞赋章法、句式与议论。",
    "start": 43.856,
    "end": 48.829,
    "duration": 4.973
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《沁园春·将止酒》仿汉赋宾主问答，《木兰花慢》借《天问》连用七问，",
    "start": 49.403,
    "end": 56.381,
    "duration": 6.978
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《贺新郎》化《论语》及虚字，《摸鱼儿》层层设问倒折，既协律又纵横思辨。",
    "start": 56.577,
    "end": 62.813,
    "duration": 6.236
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 善用“用经用史”开展政治讽喻",
    "start": 63.4,
    "end": 66.667,
    "duration": 3.267
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "经史典故化为借古讽今利器，典故密织而不滞重。",
    "start": 67.241,
    "end": 72.266,
    "duration": 5.025
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《永遇乐·京口北固亭怀古》以孙仲谋讽偷安，",
    "start": 72.84,
    "end": 77.553,
    "duration": 4.713
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "以刘裕“气吞万里如虎”对刘义隆“赢得仓皇北顾”警韩侂胄冒进，再借廉颇抒报国无门之悲。",
    "start": 77.762,
    "end": 85.821,
    "duration": 8.059
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 贯注沙场豪壮气概与军事意象群",
    "start": 86.395,
    "end": 90.417,
    "duration": 4.022
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "凭借亲率五十骑突袭金营的真实经历，大量引入刀剑、弓马、旌旗等罕见军事意象。",
    "start": 91.004,
    "end": 99.402,
    "duration": 8.397
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《破阵子》极写“醉里挑灯看剑……沙场秋点兵”铁马壮阔，结句陡然跌落“可怜白发生”，迸发沉雄悲壮力。",
    "start": 99.975,
    "end": 109.623,
    "duration": 9.647
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 刚柔相济、确立宋词豪放宗师地位",
    "start": 110.197,
    "end": 114.076,
    "duration": 3.879
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "带湖瓢泉时期写下清新农村词与谐谑小品：《西江月》听蛙说丰年，",
    "start": 114.663,
    "end": 121.42,
    "duration": 6.757
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "《清平乐·村居》白描“最喜小儿无赖，溪头卧剥莲蓬”；",
    "start": 121.59,
    "end": 126.173,
    "duration": 4.582
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "聚拢南宋辛派词人群体，确立词与五七言诗歌分庭抗礼之地位。",
    "start": 126.746,
    "end": 132.93,
    "duration": 6.184
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "辛弃疾承苏轼而推行“以文为词”，融散文辞赋章法、经史典故与军事意象兼备清趣，",
    "start": 133.504,
    "end": 141.055,
    "duration": 7.551
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "带动南宋辛派词人，最终使词真正与五七言诗歌并驾齐驱。",
    "start": 141.278,
    "end": 146.576,
    "duration": 5.298
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：注意与苏轼区分：苏轼核心在“以诗为词”（标题小序、旷达理趣）；",
    "start": 147.163,
    "end": 153.66,
    "duration": 6.496
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "辛弃疾核心在“以文为词”（散文辞赋句式、用经用史、沙场意象）。",
    "start": 153.96,
    "end": 159.831,
    "duration": 5.871
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 辛弃疾“以文为词”具体融入了哪四种散文辞赋笔法（各举一词）？",
    "start": 160.405,
    "end": 167.123,
    "duration": 6.718
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 《永遇乐·京口北固亭怀古》中五典分别指向什么时弊与心境？",
    "start": 167.697,
    "end": 174.792,
    "duration": 7.095
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 对比《破阵子》与《清平乐·村居》说明刚柔相济风貌？",
    "start": 175.366,
    "end": 181.446,
    "duration": 6.08
  }
]