[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "由文入典、由战入谐：承接苏轼再向前一步“以文为词”引入辞赋设问，",
    "start": 0.0,
    "end": 6.72,
    "duration": 6.72
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "接着在字里行间密织经史典故刺痛南宋政局，",
    "start": 6.769,
    "end": 10.649,
    "duration": 3.88
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "随后用亲历沙场的铁马豪情写出极反差悲歌，",
    "start": 11.099,
    "end": 14.859,
    "duration": 3.76
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "同时兼擅村居清趣而聚合南宋辛派一宗。",
    "start": 15.309,
    "end": 18.989,
    "duration": 3.68
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "辛弃疾是南宋豪放词集大成者，“归正人”际遇令其将沙场壮怀注入词调。",
    "start": 19.439,
    "end": 25.399,
    "duration": 5.96
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "刘克庄赞“横绝六合，扫空万古”，周济《宋四家词选》评其“沉着痛快，有辙可循”。",
    "start": 25.929,
    "end": 32.609,
    "duration": 6.68
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 推行“以文为词”、入散文辞赋章法",
    "start": 33.059,
    "end": 36.619,
    "duration": 3.56
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "打破整齐拘束，引入散文辞赋章法、句式与议论。",
    "start": 37.069,
    "end": 41.309,
    "duration": 4.24
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《沁园春·将止酒》仿汉赋宾主问答，《木兰花慢》借《天问》连用七问，",
    "start": 41.759,
    "end": 47.159,
    "duration": 5.4
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《贺新郎》化《论语》及虚字，《摸鱼儿》层层设问倒折，",
    "start": 47.609,
    "end": 51.409,
    "duration": 3.8
  },
  {
    "id": "sec0_step1_c2",
    "dom_key": "sec0_step1_c2",
    "text": "既协律又纵横思辨。",
    "start": 51.859,
    "end": 53.779,
    "duration": 1.92
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 善用“用经用史”开展政治讽喻",
    "start": 54.229,
    "end": 57.749,
    "duration": 3.52
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "经史典故化为借古讽今利器，典故密织而不滞重。",
    "start": 58.199,
    "end": 62.519,
    "duration": 4.32
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《永遇乐·京口北固亭怀古》以孙仲谋讽偷安，",
    "start": 62.969,
    "end": 66.929,
    "duration": 3.96
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "以刘裕“气吞万里如虎”对刘义隆“赢得仓皇北顾”警韩侂胄冒进，",
    "start": 67.379,
    "end": 72.339,
    "duration": 4.96
  },
  {
    "id": "sec1_step1_c2",
    "dom_key": "sec1_step1_c2",
    "text": "再借廉颇抒报国无门之悲。",
    "start": 72.789,
    "end": 75.069,
    "duration": 2.28
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 贯注沙场豪壮气概与军事意象群",
    "start": 75.519,
    "end": 79.359,
    "duration": 3.84
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "凭借亲率五十骑突袭金营的真实经历，",
    "start": 79.809,
    "end": 82.849,
    "duration": 3.04
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "大量引入刀剑、弓马、旌旗等罕见军事意象。",
    "start": 83.299,
    "end": 86.899,
    "duration": 3.6
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《破阵子》极写“醉里挑灯看剑……沙场秋点兵”铁马壮阔，",
    "start": 87.349,
    "end": 91.789,
    "duration": 4.44
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "结句陡然跌落“可怜白发生”，迸发沉雄悲壮力。",
    "start": 92.239,
    "end": 96.119,
    "duration": 3.88
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 刚柔相济、确立宋词豪放宗师地位",
    "start": 96.649,
    "end": 100.489,
    "duration": 3.84
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "带湖瓢泉时期写下清新农村词与谐谑小品：《西江月》听蛙说丰年，",
    "start": 100.939,
    "end": 106.619,
    "duration": 5.68
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "《清平乐·村居》白描“最喜小儿无赖，溪头卧剥莲蓬”；",
    "start": 107.069,
    "end": 111.269,
    "duration": 4.2
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "聚拢南宋辛派词人群体，确立词与五七言诗歌分庭抗礼之地位。",
    "start": 111.719,
    "end": 117.159,
    "duration": 5.44
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "辛弃疾承苏轼而推行“以文为词”，",
    "start": 117.609,
    "end": 120.369,
    "duration": 2.76
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "融散文辞赋章法、经史典故与军事意象兼备清趣，带动南宋辛派词人，",
    "start": 120.819,
    "end": 126.939,
    "duration": 6.12
  },
  {
    "id": "concl_c2",
    "dom_key": "concl_c2",
    "text": "最终使词真正与五七言诗歌并驾齐驱。",
    "start": 127.389,
    "end": 130.709,
    "duration": 3.32
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：注意与苏轼区分：苏轼核心在“以诗为词”（标题小序、旷达理趣）；",
    "start": 131.159,
    "end": 136.839,
    "duration": 5.68
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "辛弃疾核心在“以文为词”（散文辞赋句式、用经用史、沙场意象）。",
    "start": 137.289,
    "end": 143.249,
    "duration": 5.96
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 辛弃疾“以文为词”具体融入了哪四种散文辞赋笔法（各举一词）？",
    "start": 143.699,
    "end": 150.299,
    "duration": 6.6
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 《永遇乐·京口北固亭怀古》中五典分别指向什么时弊与心境？",
    "start": 150.749,
    "end": 156.989,
    "duration": 6.24
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 对比《破阵子》与《清平乐·村居》说明刚柔相济风貌？",
    "start": 157.439,
    "end": 162.959,
    "duration": 5.52
  }
]