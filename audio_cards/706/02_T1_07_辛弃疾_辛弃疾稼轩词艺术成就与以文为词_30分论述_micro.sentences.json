[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "由文入典、由战入谐：承接苏轼再向前一步“以文为词”引入辞赋设问，",
    "start": 0.22,
    "end": 7.266,
    "duration": 7.046
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "接着在字里行间密织经史典故刺痛南宋政局，随后用亲历沙场的铁马豪情写出极反差悲歌，",
    "start": 8.023,
    "end": 16.445,
    "duration": 8.422
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "同时兼擅村居清趣而聚合南宋辛派一宗。",
    "start": 17.198,
    "end": 21.195,
    "duration": 3.996
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "辛弃疾是南宋豪放词集大成者，“归正人”际遇令其将沙场壮怀注入词调。",
    "start": 21.917,
    "end": 28.055,
    "duration": 6.137
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "刘克庄赞“横绝六合，扫空万古”，周济《宋四家词选》评其“沉着痛快，有辙可循”。",
    "start": 28.842,
    "end": 35.805,
    "duration": 6.963
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 推行“以文为词”、入散文辞赋章法",
    "start": 36.521,
    "end": 39.96,
    "duration": 3.44
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "打破整齐拘束，引入散文辞赋章法、句式与议论。",
    "start": 40.748,
    "end": 44.983,
    "duration": 4.236
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《沁园春·将止酒》仿汉赋宾主问答，《木兰花慢》借《天问》连用七问，",
    "start": 45.711,
    "end": 51.049,
    "duration": 5.338
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《贺新郎》化《论语》及虚字，《摸鱼儿》层层设问倒折，既协律又纵横思辨。",
    "start": 51.846,
    "end": 57.51,
    "duration": 5.664
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 善用“用经用史”开展政治讽喻",
    "start": 58.207,
    "end": 61.565,
    "duration": 3.358
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "经史典故化为借古讽今利器，典故密织而不滞重。",
    "start": 62.285,
    "end": 66.519,
    "duration": 4.234
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《永遇乐·京口北固亭怀古》以孙仲谋讽偷安，",
    "start": 67.271,
    "end": 70.844,
    "duration": 3.573
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "以刘裕“气吞万里如虎”对刘义隆“赢得仓皇北顾”警韩侂胄冒进，",
    "start": 71.596,
    "end": 76.717,
    "duration": 5.122
  },
  {
    "id": "sec1_step1_c2",
    "dom_key": "sec1_step1_c2",
    "text": "再借廉颇抒报国无门之悲。",
    "start": 77.423,
    "end": 79.656,
    "duration": 2.233
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 贯注沙场豪壮气概与军事意象群",
    "start": 80.372,
    "end": 84.227,
    "duration": 3.855
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "凭借亲率五十骑突袭金营的真实经历，大量引入刀剑、弓马、旌旗等罕见军事意象。",
    "start": 84.981,
    "end": 92.403,
    "duration": 7.422
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《破阵子》极写“醉里挑灯看剑……沙场秋点兵”铁马壮阔，",
    "start": 93.177,
    "end": 97.366,
    "duration": 4.189
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "结句陡然跌落“可怜白发生”，迸发沉雄悲壮力。",
    "start": 98.099,
    "end": 102.036,
    "duration": 3.937
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 刚柔相济、确立宋词豪放宗师地位",
    "start": 102.799,
    "end": 106.565,
    "duration": 3.766
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "带湖瓢泉时期写下清新农村词与谐谑小品：《西江月》听蛙说丰年，",
    "start": 107.346,
    "end": 112.762,
    "duration": 5.416
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "《清平乐·村居》白描“最喜小儿无赖，溪头卧剥莲蓬”；",
    "start": 113.649,
    "end": 117.889,
    "duration": 4.239
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "聚拢南宋辛派词人群体，确立词与五七言诗歌分庭抗礼之地位。",
    "start": 118.629,
    "end": 123.938,
    "duration": 5.309
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "辛弃疾承苏轼而推行“以文为词”，融散文辞赋章法、经史典故与军事意象兼备清趣，",
    "start": 124.664,
    "end": 132.054,
    "duration": 7.39
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "带动南宋辛派词人，最终使词真正与五七言诗歌并驾齐驱。",
    "start": 132.782,
    "end": 137.878,
    "duration": 5.096
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：注意与苏轼区分：苏轼核心在“以诗为词”（标题小序、旷达理趣）；",
    "start": 138.629,
    "end": 144.963,
    "duration": 6.335
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "辛弃疾核心在“以文为词”（散文辞赋句式、用经用史、沙场意象）。",
    "start": 145.674,
    "end": 151.254,
    "duration": 5.58
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 辛弃疾“以文为词”具体融入了哪四种散文辞赋笔法（各举一词）？",
    "start": 152.055,
    "end": 158.756,
    "duration": 6.701
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 《永遇乐·京口北固亭怀古》中五典分别指向什么时弊与心境？",
    "start": 159.499,
    "end": 165.842,
    "duration": 6.343
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 对比《破阵子》与《清平乐·村居》说明刚柔相济风貌？",
    "start": 166.615,
    "end": 172.287,
    "duration": 5.672
  }
]