[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣“一承一继、同而不同”比较逻辑：先梳理从“以诗为词”推进到“以文为词”的文体破格递进，",
    "start": 0.22,
    "end": 8.408,
    "duration": 8.187
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再解释北宋文臣超脱与南宋归正豪杰悲壮的情感反差，",
    "start": 9.146,
    "end": 13.872,
    "duration": 4.726
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "继而对比用典“浑化如盐 vs 用经用史讽世”，最后定格豪放兼备婉约的双璧地位。",
    "start": 14.586,
    "end": 21.069,
    "duration": 6.483
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "苏轼以“以诗为词”拓宽词境，辛弃疾以“以文为词”深化变革。",
    "start": 21.828,
    "end": 27.494,
    "duration": 5.666
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "周济《宋四家词选》评“东坡天趣独到处，殆成绝诣……稼轩则沉着痛快，有辙可循”。",
    "start": 28.242,
    "end": 35.304,
    "duration": 7.061
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 革新路径：“以诗为词”递进至“以文为词”",
    "start": 36.055,
    "end": 40.161,
    "duration": 4.106
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "确立“诗词一体”，称词“盖诗之裔”，力主“自是一家”，",
    "start": 40.895,
    "end": 45.015,
    "duration": 4.12
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "广用标题小序将诗之立意题材移入词，使词诗意化哲理化；",
    "start": 45.8,
    "end": 50.475,
    "duration": 4.675
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "在苏轼基础上打破对称句式限制，将先秦散文辞赋章法、问答设论与古文句法融入词中，",
    "start": 51.278,
    "end": 59.389,
    "duration": 8.11
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "兼具纵横气势与严密逻辑。",
    "start": 60.152,
    "end": 62.512,
    "duration": 2.36
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 情感底色：清旷超然 vs 英雄悲壮",
    "start": 63.218,
    "end": 67.109,
    "duration": 3.891
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "身处北宋承平党争贬谪，",
    "start": 67.84,
    "end": 69.971,
    "duration": 2.131
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "借佛道哲思超越困顿：定慧院“拣尽寒枝不肯栖”、赤壁“一尊还酹江月”、沙湖“也无风雨也无晴”；",
    "start": 70.706,
    "end": 78.377,
    "duration": 7.672
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "身处南宋偏安危局，作为“归正人”报国无门，“把吴钩看了，阑干拍遍”，",
    "start": 79.157,
    "end": 84.807,
    "duration": 5.65
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "《破阵子》梦回连营骤转“可怜白发生”。",
    "start": 85.553,
    "end": 88.503,
    "duration": 2.95
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 使事用典：浑化无痕 vs 用经用史讽世",
    "start": 89.242,
    "end": 93.261,
    "duration": 4.019
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "以诗法入词，点化典故浑然如水中着盐，《江城子·密州出猎》化用孙权射虎、冯唐持节而全无堆砌；",
    "start": 94.03,
    "end": 103.05,
    "duration": 9.021
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "精于“用经用史”，刘辰翁赞“牵雅颂入郑卫”，",
    "start": 103.813,
    "end": 107.45,
    "duration": 3.637
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "《永遇乐·京口北固亭怀古》百余字连用孙权、刘裕、刘义隆、佛狸祠与廉颇五典切中时弊。",
    "start": 108.201,
    "end": 116.891,
    "duration": 8.691
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 共筑豪放基石、并兼多元词风",
    "start": 117.609,
    "end": 121.094,
    "duration": 3.486
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "豪放外兼备丰富词风：苏有《江城子》“十年生死两茫茫”深沉悼亡；",
    "start": 121.864,
    "end": 126.993,
    "duration": 5.129
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "辛有《清平乐·村居》田园天真与谐谑自嘲；",
    "start": 127.821,
    "end": 131.532,
    "duration": 3.711
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "苏指明“向上一路”，辛率南宋辛派推向高峰，共奠豪放词与古诗并峙之地位。",
    "start": 132.249,
    "end": 138.689,
    "duration": 6.439
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "苏轼“以诗为词”注入清旷胸襟，",
    "start": 139.454,
    "end": 141.994,
    "duration": 2.54
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "辛弃疾“以文为词”融化经史典故与散文句法写英雄悲慨，",
    "start": 142.724,
    "end": 147.826,
    "duration": 5.103
  },
  {
    "id": "concl_c2",
    "dom_key": "concl_c2",
    "text": "一承一继把豪放词推至与五七言诗歌并峙高度。",
    "start": 148.63,
    "end": 152.771,
    "duration": 4.141
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：周济《宋四家词选》评“东坡天趣独到处，殆成绝诣……稼轩则沉着痛快，有辙可循”；",
    "start": 153.592,
    "end": 161.631,
    "duration": 8.039
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "刘辰翁赞辛弃疾“牵雅颂入郑卫”。",
    "start": 162.407,
    "end": 165.029,
    "duration": 2.622
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 周济《宋四家词选》与刘辰翁对苏辛各有哪些精准评语？",
    "start": 165.754,
    "end": 171.677,
    "duration": 5.923
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合作品对照“以诗为词 vs 以文为词”“清旷超然 vs 英雄悲壮”“浑化用典 vs 用经用史”？",
    "start": 172.5,
    "end": 182.385,
    "duration": 9.885
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 为何说苏辛均非单调豪放而兼具多元审美面貌？",
    "start": 183.135,
    "end": 188.84,
    "duration": 5.705
  }
]