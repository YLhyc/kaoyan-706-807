[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "苏辛比较·苏轼与辛弃疾词作艺术成就及以诗入词以文为词比较",
    "start": 0.134,
    "end": 6.123,
    "duration": 5.989
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣“一承一继、同而不同”比较逻辑：先梳理从“以诗为词”推进到“以文为词”的文体破格递进，",
    "start": 6.712,
    "end": 15.174,
    "duration": 8.462
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再解释北宋文臣超脱与南宋归正豪杰悲壮的情感反差，",
    "start": 15.488,
    "end": 20.291,
    "duration": 4.804
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "继而对比用典“浑化如盐 vs 用经用史讽世”，最后定格豪放兼备婉约的双璧地位。",
    "start": 20.392,
    "end": 27.266,
    "duration": 6.874
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "苏轼以“以诗为词”拓宽词境，辛弃疾以“以文为词”深化变革。",
    "start": 27.853,
    "end": 33.477,
    "duration": 5.624
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "周济《宋四家词选》评“东坡天趣独到处，殆成绝诣……稼轩则沉着痛快，有辙可循”。",
    "start": 34.064,
    "end": 41.602,
    "duration": 7.538
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 革新路径：“以诗为词”递进至“以文为词”",
    "start": 42.176,
    "end": 46.368,
    "duration": 4.192
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "确立“诗词一体”，称词“盖诗之裔”，力主“自是一家”，广用标题小序将诗之立意题材移入词，使词诗意化哲理化；",
    "start": 46.942,
    "end": 57.357,
    "duration": 10.416
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "在苏轼基础上打破对称句式限制，将先秦散文辞赋章法、问答设论与古文句法融入词中，兼具纵横气势与严密逻辑。",
    "start": 57.944,
    "end": 69.923,
    "duration": 11.978
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 情感底色：清旷超然 vs 英雄悲壮",
    "start": 70.51,
    "end": 74.545,
    "duration": 4.035
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "身处北宋承平党争贬谪，借佛道哲思超越困顿：定慧院“拣尽寒枝不肯栖”、赤壁“一尊还酹江月”、沙湖“也无风雨也无晴”；",
    "start": 75.132,
    "end": 86.811,
    "duration": 11.679
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "身处南宋偏安危局，作为“归正人”报国无门，“把吴钩看了，阑干拍遍”，",
    "start": 87.385,
    "end": 94.467,
    "duration": 7.082
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "《破阵子》梦回连营骤转“可怜白发生”。",
    "start": 94.65,
    "end": 98.048,
    "duration": 3.397
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 使事用典：浑化无痕 vs 用经用史讽世",
    "start": 98.621,
    "end": 102.774,
    "duration": 4.153
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "以诗法入词，点化典故浑然如水中着盐，《江城子·密州出猎》化用孙权射虎、冯唐持节而全无堆砌；",
    "start": 103.348,
    "end": 113.751,
    "duration": 10.403
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "精于“用经用史”，刘辰翁赞“牵雅颂入郑卫”，",
    "start": 114.338,
    "end": 118.972,
    "duration": 4.634
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "《永遇乐·京口北固亭怀古》百余字连用孙权、刘裕、刘义隆、佛狸祠与廉颇五典切中时弊。",
    "start": 119.155,
    "end": 127.813,
    "duration": 8.658
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 共筑豪放基石、并兼多元词风",
    "start": 128.4,
    "end": 132.071,
    "duration": 3.671
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "豪放外兼备丰富词风：苏有《江城子》“十年生死两茫茫”深沉悼亡；辛有《清平乐·村居》田园天真与谐谑自嘲；",
    "start": 132.632,
    "end": 143.542,
    "duration": 10.91
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "苏指明“向上一路”，辛率南宋辛派推向高峰，共奠豪放词与古诗并峙之地位。",
    "start": 144.116,
    "end": 151.824,
    "duration": 7.707
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "苏轼“以诗为词”注入清旷胸襟，辛弃疾“以文为词”融化经史典故与散文句法写英雄悲慨，",
    "start": 152.385,
    "end": 160.6,
    "duration": 8.215
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "一承一继把豪放词推至与五七言诗歌并峙高度。",
    "start": 160.874,
    "end": 165.248,
    "duration": 4.374
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：周济《宋四家词选》评“东坡天趣独到处，殆成绝诣……稼轩则沉着痛快，有辙可循”；",
    "start": 165.822,
    "end": 174.428,
    "duration": 8.606
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "刘辰翁赞辛弃疾“牵雅颂入郑卫”。",
    "start": 174.585,
    "end": 177.605,
    "duration": 3.02
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 周济《宋四家词选》与刘辰翁对苏辛各有哪些精准评语？",
    "start": 178.192,
    "end": 184.48,
    "duration": 6.288
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合作品对照“以诗为词 vs 以文为词”“清旷超然 vs 英雄悲壮”“浑化用典 vs 用经用史”？",
    "start": 185.041,
    "end": 195.17,
    "duration": 10.129
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 为何说苏辛均非单调豪放而兼具多元审美面貌？",
    "start": 195.731,
    "end": 201.602,
    "duration": 5.871
  }
]