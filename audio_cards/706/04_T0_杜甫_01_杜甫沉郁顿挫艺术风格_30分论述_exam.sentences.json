[
  {
    "id": 1,
    "text": "“沉郁顿挫”是杜甫诗歌最具代表性的主导美学风格。",
    "start": 0.0,
    "end": 4.542,
    "duration": 4.542
  },
  {
    "id": 2,
    "text": "这一断语最早见于杜甫本人的《进雕赋表》。",
    "start": 4.542,
    "end": 8.219,
    "duration": 3.677
  },
  {
    "id": 3,
    "text": "袁行配《中国文学史》将其界定为杜诗艺术成就集大成的核心范畴。",
    "start": 8.219,
    "end": 14.059,
    "duration": 5.84
  },
  {
    "id": 4,
    "text": "沉郁主要指思想内容的深广厚重与忧患深沉。",
    "start": 14.059,
    "end": 18.169,
    "duration": 4.11
  },
  {
    "id": 5,
    "text": "顿挫主要指情感表达的跌宕回折与声律结构的抑扬顿挫。",
    "start": 18.169,
    "end": 23.36,
    "duration": 5.191
  },
  {
    "id": 6,
    "text": "二者互为表里，共同熔铸出杜诗沉厚苍凉而波澜壮阔的崇高美。",
    "start": 23.44,
    "end": 29.68,
    "duration": 6.24
  },
  {
    "id": 7,
    "text": "具体而言，杜诗的“沉郁顿挫”展现为以下四个核心维度：杜甫的“沉郁”，",
    "start": 29.68,
    "end": 35.2,
    "duration": 5.52
  },
  {
    "id": 8,
    "text": "根植于儒家“仁民爱物”的博大胸襟。",
    "start": 35.2,
    "end": 38.32,
    "duration": 3.12
  },
  {
    "id": 9,
    "text": "他绝不作一己之悲的狭隘感伤，而是将个人命运深植于时代血泪之中。",
    "start": 38.32,
    "end": 43.84,
    "duration": 5.52
  },
  {
    "id": 10,
    "text": "由于其情感深厚博大且关涉天下苍生，",
    "start": 44.16,
    "end": 48.08,
    "duration": 3.92
  },
  {
    "id": 11,
    "text": "故而郁积于心、沉郁难平。",
    "start": 48.08,
    "end": 51.04,
    "duration": 2.96
  },
  {
    "id": 12,
    "text": "正如天宝十四载所作的名篇《自京赴奉先县咏怀五百字》。",
    "start": 51.04,
    "end": 56.56,
    "duration": 5.52
  },
  {
    "id": 13,
    "text": "诗中写道：“穷年忧黎元，叹息肠内热”。",
    "start": 56.56,
    "end": 60.96,
    "duration": 4.4
  },
  {
    "id": 14,
    "text": "即便诗人自家幼子饥卒，他心中所牵挂的依然是天下黎庶的生死。",
    "start": 60.96,
    "end": 66.56,
    "duration": 5.6
  },
  {
    "id": 15,
    "text": "又如全诗的核心警句：“朱门酒肉臭，",
    "start": 66.8,
    "end": 69.84,
    "duration": 3.04
  },
  {
    "id": 16,
    "text": "路有冻死骨”。",
    "start": 69.84,
    "end": 71.28,
    "duration": 1.44
  },
  {
    "id": 17,
    "text": "诗人以震撼人心的贫富对立，揭露了盛唐繁华表象下的残酷社会危机。",
    "start": 71.28,
    "end": 76.96,
    "duration": 5.68
  },
  {
    "id": 18,
    "text": "这种将一己血泪升华为国家忧患的情感厚度，",
    "start": 76.96,
    "end": 80.56,
    "duration": 3.6
  },
  {
    "id": 19,
    "text": "奠定了杜诗沉厚沉潜的思想基石。",
    "start": 80.56,
    "end": 83.6,
    "duration": 3.04
  },
  {
    "id": 20,
    "text": "杜甫的“顿挫”，体现为情感抒发时的百折千回与波澜起伏。",
    "start": 83.6,
    "end": 88.56,
    "duration": 4.96
  },
  {
    "id": 21,
    "text": "杜甫胸怀千万重郁结，但他绝不一泻无余地倾盆宣泄。",
    "start": 88.88,
    "end": 94.08,
    "duration": 5.2
  },
  {
    "id": 22,
    "text": "他善于借助反差极大的章法结构，让诗情在剧烈震荡中层层推进。",
    "start": 94.08,
    "end": 99.92,
    "duration": 5.84
  },
  {
    "id": 23,
    "text": "正如其晚年登临名作《登岳阳楼》的篇章建构。",
    "start": 99.92,
    "end": 104.0,
    "duration": 4.08
  },
  {
    "id": 24,
    "text": "前四句极力铺写吴楚东南彻、乾坤日夜浮的壮阔浩渺气象。",
    "start": 104.0,
    "end": 109.52,
    "duration": 5.52
  },
  {
    "id": 25,
    "text": "五六句笔锋骤然收缩，跌入自身真实境遇：“亲朋无一字，",
    "start": 109.92,
    "end": 114.8,
    "duration": 4.88
  },
  {
    "id": 26,
    "text": "老病有孤舟”。",
    "start": 114.8,
    "end": 116.24,
    "duration": 1.44
  },
  {
    "id": 27,
    "text": "宏阔无垠的自然胜景与凄凉飘零的残躯形成强烈反差，",
    "start": 116.24,
    "end": 121.36,
    "duration": 5.12
  },
  {
    "id": 28,
    "text": "产生强烈的悲剧张力。",
    "start": 121.36,
    "end": 123.04,
    "duration": 1.68
  },
  {
    "id": 29,
    "text": "尾联以“凭轩涕泗流”再次跌宕回折，",
    "start": 123.04,
    "end": 126.08,
    "duration": 3.04
  },
  {
    "id": 30,
    "text": "将孤舟之悲汇入北望长安的家国忧思。",
    "start": 126.08,
    "end": 129.36,
    "duration": 3.28
  },
  {
    "id": 31,
    "text": "这种大开大合、层层顿折的运笔方式，",
    "start": 129.68,
    "end": 133.36,
    "duration": 3.68
  },
  {
    "id": 32,
    "text": "使诗歌情感因郁结受阻而爆发得更为深沉。",
    "start": 133.36,
    "end": 137.84,
    "duration": 4.48
  },
  {
    "id": 33,
    "text": "沉郁顿挫的艺术风格，依托于杜甫极度严密精审的格律掌控。",
    "start": 137.84,
    "end": 143.44,
    "duration": 5.6
  },
  {
    "id": 34,
    "text": "杜甫晚年以超拔的功力拓展了七言律诗的体制空间。",
    "start": 143.44,
    "end": 147.92,
    "duration": 4.48
  },
  {
    "id": 35,
    "text": "他打破盛唐律诗流走圆转的常态，大量使用音律拗折与声调起伏。",
    "start": 147.92,
    "end": 154.0,
    "duration": 6.08
  },
  {
    "id": 36,
    "text": "明代胡应麟在《诗薮》中盛赞杜甫《登高》为“古今七言律第一”。",
    "start": 154.376,
    "end": 160.056,
    "duration": 5.68
  },
  {
    "id": 37,
    "text": "诗中名句“无边落木萧萧下，不尽长江滚滚来”，",
    "start": 160.056,
    "end": 164.696,
    "duration": 4.64
  },
  {
    "id": 38,
    "text": "意象苍茫深邃。",
    "start": 164.696,
    "end": 166.296,
    "duration": 1.6
  },
  {
    "id": 39,
    "text": "颈联随之咬合：“万里悲秋常作客，",
    "start": 166.296,
    "end": 169.736,
    "duration": 3.44
  },
  {
    "id": 40,
    "text": "百年多病独登台”，字字沉痛凝练。",
    "start": 169.736,
    "end": 173.096,
    "duration": 3.36
  },
  {
    "id": 41,
    "text": "全诗八句皆对，句法既精整严密，又在声韵的拗救与对仗中显出苍劲骨力。",
    "start": 173.096,
    "end": 179.896,
    "duration": 6.8
  },
  {
    "id": 42,
    "text": "声调的抑扬回环恰好对应着心境的沉郁难解，",
    "start": 180.216,
    "end": 184.296,
    "duration": 4.08
  },
  {
    "id": 43,
    "text": "实现了声情相生的完美契合。",
    "start": 184.296,
    "end": 186.856,
    "duration": 2.56
  },
  {
    "id": 44,
    "text": "沉郁顿挫的风格，最终落实在宏大沉郁的意象与意境创造之中。",
    "start": 186.856,
    "end": 192.696,
    "duration": 5.84
  },
  {
    "id": 45,
    "text": "杜甫极少选取纤巧柔媚的物象，而偏爱天地、",
    "start": 192.696,
    "end": 196.936,
    "duration": 4.24
  },
  {
    "id": 46,
    "text": "江河、孤舟、残月与秋风。",
    "start": 196.936,
    "end": 199.896,
    "duration": 2.96
  },
  {
    "id": 47,
    "text": "正如晚年行舟所作的《旅夜书怀》。",
    "start": 199.896,
    "end": 202.616,
    "duration": 2.72
  },
  {
    "id": 48,
    "text": "诗中汉联描摹宏丽境界：“星垂平野阔，",
    "start": 203.016,
    "end": 207.496,
    "duration": 4.48
  },
  {
    "id": 49,
    "text": "月涌大江流”。",
    "start": 207.496,
    "end": 209.016,
    "duration": 1.52
  },
  {
    "id": 50,
    "text": "尾联却骤然勾勒自身苍凉图景：“飘飘何所似，",
    "start": 209.016,
    "end": 213.416,
    "duration": 4.4
  },
  {
    "id": 51,
    "text": "天地一沙欧”。",
    "start": 213.416,
    "end": 215.176,
    "duration": 1.76
  },
  {
    "id": 52,
    "text": "浩瀚无垠的宇宙背景与孤独漂泊的渺小生命形成极大张力。",
    "start": 215.176,
    "end": 220.616,
    "duration": 5.44
  },
  {
    "id": 53,
    "text": "这些沉潜阔大的意象群落，构筑出悲壮苍凉而又雄浑博大的崇高意境。",
    "start": 220.616,
    "end": 226.936,
    "duration": 6.32
  },
  {
    "id": 54,
    "text": "综上所述，杜甫的“沉郁顿挫”实现了崇高人格与精湛技艺的完美熔铸。",
    "start": 227.256,
    "end": 233.096,
    "duration": 5.84
  },
  {
    "id": 55,
    "text": "它标志着中国古代现实主义诗歌与近体格律艺术攀上了最高峰。",
    "start": 233.096,
    "end": 239.016,
    "duration": 5.92
  },
  {
    "id": 56,
    "text": "这一风格不仅直接催生了中唐白居易的新乐府运动与韩孟诗派。",
    "start": 239.016,
    "end": 244.536,
    "duration": 5.52
  },
  {
    "id": 57,
    "text": "在宋代更被苏轼、黄庭坚尊奉为百代宗师，",
    "start": 244.536,
    "end": 248.696,
    "duration": 4.16
  },
  {
    "id": 58,
    "text": "奠定了江西诗派的法门正统。--",
    "start": 248.696,
    "end": 250.856,
    "duration": 2.16
  }
]