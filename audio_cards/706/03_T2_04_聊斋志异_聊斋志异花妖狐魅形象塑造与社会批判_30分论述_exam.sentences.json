[
  {
    "id": 1,
    "text": "试论《聊斋志异》的花妖狐魅形象塑造与社会批判意蕴。",
    "start": 0.086,
    "end": 4.69,
    "duration": 4.604
  },
  {
    "id": 2,
    "text": "《聊斋志异》 是中国古典文言短篇小说发展的至高巅峰。",
    "start": 5.162,
    "end": 9.221,
    "duration": 4.059
  },
  {
    "id": 3,
    "text": "面对清代康乾时期满汉民族矛盾隐痛、",
    "start": 9.532,
    "end": 12.7,
    "duration": 3.168
  },
  {
    "id": 4,
    "text": "皇权专制强化与八股科举制度对知识分子心灵的无情摧残，",
    "start": 12.82,
    "end": 17.821,
    "duration": 5.001
  },
  {
    "id": 5,
    "text": "蒲松龄以自身屡试不第、寄人篱下的乡村落魄文人阅历，",
    "start": 18.094,
    "end": 22.525,
    "duration": 4.431
  },
  {
    "id": 6,
    "text": "将满腔激愤倾注于笔端。",
    "start": 22.812,
    "end": 24.903,
    "duration": 2.091
  },
  {
    "id": 7,
    "text": "他继承六朝志怪与唐代传奇的优良传统，“用传奇法，",
    "start": 25.133,
    "end": 29.574,
    "duration": 4.441
  },
  {
    "id": 8,
    "text": "而以志怪”，借荒诞离奇的鬼狐幻境揭示冷酷黑暗的人间社会。",
    "start": 29.787,
    "end": 35.142,
    "duration": 5.355
  },
  {
    "id": 9,
    "text": "郭沫若精辟题词赞其 “写鬼写妖高人一等，刺贪刺虐入木三分”。",
    "start": 35.403,
    "end": 41.454,
    "duration": 6.051
  },
  {
    "id": 10,
    "text": "其花妖狐魅形象塑造与社会批判意蕴，",
    "start": 41.639,
    "end": 45.117,
    "duration": 3.478
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：",
    "start": 45.293,
    "end": 47.482,
    "duration": 2.189
  },
  {
    "id": 12,
    "text": "第一，塑造真纯善良的花妖狐魅典型群像，",
    "start": 47.696,
    "end": 51.797,
    "duration": 4.101
  },
  {
    "id": 13,
    "text": "以理想异类反衬现实社会的冷酷虚伪。",
    "start": 52.193,
    "end": 55.617,
    "duration": 3.424
  },
  {
    "id": 14,
    "text": "蒲松龄在小说美学上的突出突破，",
    "start": 56.308,
    "end": 58.913,
    "duration": 2.605
  },
  {
    "id": 15,
    "text": "在于彻底扭转了传统志怪小说中妖异害人的固有模式。",
    "start": 59.214,
    "end": 63.812,
    "duration": 4.598
  },
  {
    "id": 16,
    "text": "他笔下的花妖狐魅，",
    "start": 64.434,
    "end": 65.866,
    "duration": 1.432
  },
  {
    "id": 17,
    "text": "多被赋予了超越世俗人类的美好品德与纯一人性：",
    "start": 66.082,
    "end": 70.386,
    "duration": 4.304
  },
  {
    "id": 18,
    "text": "在 《婴宁》 中，狐女婴宁天真无邪、不谙世俗礼法，",
    "start": 70.957,
    "end": 75.137,
    "duration": 4.18
  },
  {
    "id": 19,
    "text": "以清脆自然的笑声对抗封建规训的窒息压抑；",
    "start": 75.479,
    "end": 79.491,
    "duration": 4.012
  },
  {
    "id": 20,
    "text": "在 《小翠》 中，狐女小翠智勇双全、谐谑机智，",
    "start": 79.709,
    "end": 83.78,
    "duration": 4.071
  },
  {
    "id": 21,
    "text": "甘愿报恩拯救痴儿公子；在 《辛十四娘》 中，",
    "start": 83.813,
    "end": 87.366,
    "duration": 3.553
  },
  {
    "id": 22,
    "text": "十四娘行善积德、深明大义。",
    "start": 87.427,
    "end": 89.984,
    "duration": 2.557
  },
  {
    "id": 23,
    "text": "这些非人类的异类女性，不仅貌美多情，",
    "start": 90.191,
    "end": 93.48,
    "duration": 3.289
  },
  {
    "id": 24,
    "text": "更具备敢于冲破世俗门第、追求独立自主的健全人格，",
    "start": 93.658,
    "end": 98.105,
    "duration": 4.447
  },
  {
    "id": 25,
    "text": "与现实人间官僚豪绅的虚伪贪婪形成了极其强烈的审美对照。",
    "start": 98.468,
    "end": 103.925,
    "duration": 5.457
  },
  {
    "id": 26,
    "text": "第二，深刻揭露封建八股科举制度的腐朽残酷，",
    "start": 104.099,
    "end": 108.061,
    "duration": 3.962
  },
  {
    "id": 27,
    "text": "展现寒门士人的精神苦难。",
    "start": 108.27,
    "end": 110.379,
    "duration": 2.109
  },
  {
    "id": 28,
    "text": "作为终生困顿于科场的下层知识分子，",
    "start": 110.379,
    "end": 114.044,
    "duration": 3.665
  },
  {
    "id": 29,
    "text": "蒲松龄对科举制度的弊端有着痛切的骨肉体会。",
    "start": 114.365,
    "end": 118.002,
    "duration": 3.637
  },
  {
    "id": 30,
    "text": "他以冷峻幽默的笔墨，",
    "start": 118.416,
    "end": 120.037,
    "duration": 1.621
  },
  {
    "id": 31,
    "text": "深刻讽刺了八股取士的荒谬与考官的不辨菽麦。",
    "start": 120.191,
    "end": 124.331,
    "duration": 4.14
  },
  {
    "id": 32,
    "text": "在 《司文郎》 中，通过盲和尚以鼻嗅文，",
    "start": 124.581,
    "end": 127.772,
    "duration": 3.191
  },
  {
    "id": 33,
    "text": "“鼻孔大衄” 于劣作、赞叹于佳文的辛辣寓言，",
    "start": 127.938,
    "end": 131.594,
    "duration": 3.656
  },
  {
    "id": 34,
    "text": "无情嘲讽了考官有眼无珠的瞎子本质；在 《王子安》 中，",
    "start": 131.838,
    "end": 135.938,
    "duration": 4.1
  },
  {
    "id": 35,
    "text": "极其生动地描摹考生入场应试的 “秀才七变”，由病鸟、",
    "start": 136.079,
    "end": 140.542,
    "duration": 4.463
  },
  {
    "id": 36,
    "text": "受刑犯人到疯癫发狂，",
    "start": 140.586,
    "end": 142.631,
    "duration": 2.045
  },
  {
    "id": 37,
    "text": "将士子在功名利禄驱使下丧失尊严的扭曲悲剧揭露得淋漓尽致。",
    "start": 142.804,
    "end": 148.196,
    "duration": 5.392
  },
  {
    "id": 38,
    "text": "第三，无情鞭挞贪官恶霸的暴虐罪恶，为底层受苦难百姓伸张正义。",
    "start": 148.405,
    "end": 154.688,
    "duration": 6.283
  },
  {
    "id": 39,
    "text": "《聊斋志异》 深刻展现了对封建专制统治压迫百姓的强烈批判。",
    "start": 154.947,
    "end": 159.755,
    "duration": 4.808
  },
  {
    "id": 40,
    "text": "在名篇 《促织》 中，以一只细微蟋蟀的进贡为线索，",
    "start": 160.049,
    "end": 164.044,
    "duration": 3.995
  },
  {
    "id": 41,
    "text": "深刻揭露了 “一人飞升，",
    "start": 164.071,
    "end": 166.047,
    "duration": 1.976
  },
  {
    "id": 42,
    "text": "仙及鸡犬” 的朝廷享乐对百姓家破人亡的血泪榨取；",
    "start": 166.091,
    "end": 170.671,
    "duration": 4.58
  },
  {
    "id": 43,
    "text": "在 《席方平》 中，席方平为其蒙冤被害的父亲鸣冤，",
    "start": 170.836,
    "end": 174.558,
    "duration": 3.722
  },
  {
    "id": 44,
    "text": "自县衙、府衙申诉至城隍、阎王乃至东岳大帝，",
    "start": 174.792,
    "end": 178.913,
    "duration": 4.121
  },
  {
    "id": 45,
    "text": "所遇神佛官吏无不贪赃枉法、上下勾结，",
    "start": 179.212,
    "end": 182.572,
    "duration": 3.36
  },
  {
    "id": 46,
    "text": "使阳间受苦的百姓在阴司同样遭受锯解油烹的残酷肉刑。",
    "start": 182.742,
    "end": 187.466,
    "duration": 4.724
  },
  {
    "id": 47,
    "text": "蒲松龄借鬼魅地狱直斥封建官场黑幕，",
    "start": 187.667,
    "end": 190.899,
    "duration": 3.232
  },
  {
    "id": 48,
    "text": "展现了强烈的批判骨力与人道主义同情。",
    "start": 191.101,
    "end": 194.598,
    "duration": 3.497
  },
  {
    "id": 49,
    "text": "第四，融合典雅文言与生动方言于一体，",
    "start": 195.053,
    "end": 198.625,
    "duration": 3.572
  },
  {
    "id": 50,
    "text": "达成“文备众体”的纯正叙事艺术。",
    "start": 199.009,
    "end": 201.838,
    "duration": 2.829
  },
  {
    "id": 51,
    "text": "在小说体式上，",
    "start": 202.21,
    "end": 203.232,
    "duration": 1.022
  },
  {
    "id": 52,
    "text": "《聊斋志异》 实现了古代文言小说语言与技巧的集大成。",
    "start": 203.547,
    "end": 207.627,
    "duration": 4.08
  },
  {
    "id": 53,
    "text": "蒲松龄在典重典雅的先秦两汉史传文言之中，",
    "start": 207.898,
    "end": 211.573,
    "duration": 3.675
  },
  {
    "id": 54,
    "text": "自然吸纳了山东淄川本土的生动俗语口吻与市井俚语；",
    "start": 211.684,
    "end": 216.344,
    "duration": 4.66
  },
  {
    "id": 55,
    "text": "其叙事结构精巧多变，心理刻画与神态白描兼备，",
    "start": 216.825,
    "end": 221.199,
    "duration": 4.374
  },
  {
    "id": 56,
    "text": "善于在现实生活细节中自然切入奇幻情节，",
    "start": 221.227,
    "end": 224.849,
    "duration": 3.622
  },
  {
    "id": 57,
    "text": "打破了现实与幻想的物理界限。",
    "start": 224.927,
    "end": 227.176,
    "duration": 2.249
  },
  {
    "id": 58,
    "text": "这部巨著不仅使古典文言小说重新焕发出旺盛的艺术生机，",
    "start": 227.427,
    "end": 232.19,
    "duration": 4.763
  },
  {
    "id": 59,
    "text": "更树立了中国古代短篇小说无法超越的美学高峰。",
    "start": 232.265,
    "end": 236.016,
    "duration": 3.751
  }
]
