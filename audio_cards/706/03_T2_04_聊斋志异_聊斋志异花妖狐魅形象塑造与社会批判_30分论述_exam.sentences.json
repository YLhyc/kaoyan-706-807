[
  {
    "id": 1,
    "text": "试论《聊斋志异》的花妖狐魅形象塑造与社会批判意蕴。",
    "start": 0.101,
    "end": 4.516,
    "duration": 4.415
  },
  {
    "id": 2,
    "text": "《聊斋志异》是中国古代文言短篇小说发展的巅峰之作。",
    "start": 5.048,
    "end": 9.399,
    "duration": 4.351
  },
  {
    "id": 3,
    "text": "清代初年政治高压日甚、八股科举日益僵化，",
    "start": 9.954,
    "end": 13.863,
    "duration": 3.909
  },
  {
    "id": 4,
    "text": "蒲松龄凭借自身屡试不第、长期坐馆的落魄文人阅历，将满腔孤愤寄托于狐鬼世界之中。",
    "start": 14.285,
    "end": 21.395,
    "duration": 7.11
  },
  {
    "id": 5,
    "text": "他继承六朝志怪与唐代传奇传统，鲁迅在《中国小说史略》中称之为“用传奇法，而以志怪”；",
    "start": 21.636,
    "end": 29.096,
    "duration": 7.46
  },
  {
    "id": 6,
    "text": "郭沫若亦赞其“写鬼写妖高人一等，刺贪刺虐入木三分”。",
    "start": 29.585,
    "end": 34.607,
    "duration": 5.022
  },
  {
    "id": 7,
    "text": "《聊斋志异》的花妖狐魅形象塑造与社会批判意蕴，主要体现在以下四个方面：",
    "start": 34.952,
    "end": 40.561,
    "duration": 5.609
  },
  {
    "id": 8,
    "text": "第一，塑造真纯美好的花妖狐魅群像，以理想异类反衬世俗人情冷酷。",
    "start": 41.209,
    "end": 46.918,
    "duration": 5.709
  },
  {
    "id": 9,
    "text": "蒲松龄在小说创作上的重要突破，在于扭转了传统志怪小说中妖异害人的固有模式。",
    "start": 47.155,
    "end": 53.419,
    "duration": 6.264
  },
  {
    "id": 10,
    "text": "他笔下的花妖狐魅，大都保留着原本的物性特征，却又被赋予真挚纯善的人性与人情：",
    "start": 53.697,
    "end": 60.274,
    "duration": 6.577
  },
  {
    "id": 11,
    "text": "在《婴宁》中，狐女婴宁天真憨直、爱花爱笑，",
    "start": 60.6,
    "end": 64.578,
    "duration": 3.978
  },
  {
    "id": 12,
    "text": "以不谙世故的纯真天性对抗世俗礼法的窒息压抑；",
    "start": 64.924,
    "end": 69.006,
    "duration": 4.082
  },
  {
    "id": 13,
    "text": "在《黄英》中，菊花精黄英自食其力、种菊致富，突破了士大夫迂腐虚伪的清高观念；",
    "start": 69.356,
    "end": 76.208,
    "duration": 6.852
  },
  {
    "id": 14,
    "text": "在《阿绣》中，狐女因感动于痴情而成人之美。",
    "start": 76.621,
    "end": 79.915,
    "duration": 3.294
  },
  {
    "id": 15,
    "text": "这些异类女性不仅容貌秀美，更敢于冲破门第与礼教束缚，",
    "start": 80.181,
    "end": 84.532,
    "duration": 4.351
  },
  {
    "id": 16,
    "text": "与现实人间的虚伪势利形成鲜明对照。",
    "start": 84.876,
    "end": 87.675,
    "duration": 2.799
  },
  {
    "id": 17,
    "text": "第二，辛辣讽刺八股科举制度的腐朽弊端，抒写寒门士人的精神苦闷。",
    "start": 88.306,
    "end": 94.412,
    "duration": 6.106
  },
  {
    "id": 18,
    "text": "长期困顿场屋的切身经历，使蒲松龄对科举制度的积弊有着痛切体会。",
    "start": 95.006,
    "end": 100.487,
    "duration": 5.481
  },
  {
    "id": 19,
    "text": "他以犀利幽默的笔墨，猛烈嘲讽八股取士的荒谬与试官的昏庸贪婪。",
    "start": 100.905,
    "end": 106.172,
    "duration": 5.267
  },
  {
    "id": 20,
    "text": "在《司文郎》中，盲僧凭嗅觉品评文章优劣，",
    "start": 106.511,
    "end": 110.031,
    "duration": 3.52
  },
  {
    "id": 21,
    "text": "面对试官取落颠倒愤然斥责“仆虽盲于目，而不盲于鼻，今帘中人并鼻亦盲矣”，",
    "start": 110.306,
    "end": 116.955,
    "duration": 6.649
  },
  {
    "id": 22,
    "text": "将考官的有眼无珠揭露得体无完肤；",
    "start": 117.124,
    "end": 119.669,
    "duration": 2.545
  },
  {
    "id": 23,
    "text": "在《王子安》中，生动描摹落魄秀才醉卧中连试皆捷、得意忘形的梦幻幻觉，",
    "start": 119.89,
    "end": 125.832,
    "duration": 5.942
  },
  {
    "id": 24,
    "text": "既嘲弄了士子追逐功名利禄的痴狂丑态，又蕴含着怀才不遇者的深深自伤。",
    "start": 126.053,
    "end": 131.818,
    "duration": 5.765
  },
  {
    "id": 25,
    "text": "第三，无情鞭挞贪官恶霸的暴虐罪恶，替底层受苦民众伸张正义。",
    "start": 132.452,
    "end": 138.0,
    "duration": 5.548
  },
  {
    "id": 26,
    "text": "《聊斋志异》以鲜明的爱憎立场，深刻揭露了封建官场的贪残黑暗。",
    "start": 138.309,
    "end": 143.615,
    "duration": 5.306
  },
  {
    "id": 27,
    "text": "在名篇《促织》中，朝廷征索小小蟋蟀致使百姓倾家荡产、逼死人命，",
    "start": 143.894,
    "end": 150.122,
    "duration": 6.228
  },
  {
    "id": 28,
    "text": "作者最后冷语讥刺“一人飞升，仙及鸡犬”，将批判矛头直指最高统治者与各级官僚；",
    "start": 150.338,
    "end": 157.756,
    "duration": 7.418
  },
  {
    "id": 29,
    "text": "在《席方平》中，席方平为受豪绅凌辱的父亲入阴司鸣冤，",
    "start": 157.997,
    "end": 162.722,
    "duration": 4.725
  },
  {
    "id": 30,
    "text": "却见城隍、郡司、冥王各级衙门无不贪赃受贿、酷刑施虐，“阴曹之暗昧尤胜于阳间”。",
    "start": 162.933,
    "end": 169.961,
    "duration": 7.028
  },
  {
    "id": 31,
    "text": "蒲松龄借幽冥地狱映照人间官府黑幕，展现出强烈的批判锋芒与民生关怀。",
    "start": 170.207,
    "end": 176.304,
    "duration": 6.097
  },
  {
    "id": 32,
    "text": "第四，兼融志怪与传奇艺术之长，开创诗意浓郁、语言简练的叙事风范。",
    "start": 176.905,
    "end": 183.33,
    "duration": 6.425
  },
  {
    "id": 33,
    "text": "在叙事艺术上，《聊斋志异》使文言短篇小说突破了粗陈梗概的局限。",
    "start": 183.77,
    "end": 188.934,
    "duration": 5.164
  },
  {
    "id": 34,
    "text": "蒲松龄将先秦两汉的典雅文言与山东方言俗语自然交融，",
    "start": 189.468,
    "end": 194.165,
    "duration": 4.697
  },
  {
    "id": 35,
    "text": "叙述语言平易简洁而文约事丰，人物语言则因人因事而庄谐多变；",
    "start": 194.513,
    "end": 199.99,
    "duration": 5.477
  },
  {
    "id": 36,
    "text": "作品又善于描写环境、动作与心理细节，",
    "start": 200.383,
    "end": 203.654,
    "duration": 3.271
  },
  {
    "id": 37,
    "text": "并将诗词意象与“偶见鹘突，知复非人”的含蓄笔法引入小说，",
    "start": 203.996,
    "end": 209.036,
    "duration": 5.04
  },
  {
    "id": 38,
    "text": "使人鬼幽婚与幻境奇谈富有浓郁的诗意与回味。",
    "start": 209.419,
    "end": 213.476,
    "duration": 4.057
  },
  {
    "id": 39,
    "text": "这部杰作将中国古代文言短篇小说推向了后人难以企及的艺术高峰。",
    "start": 213.751,
    "end": 218.864,
    "duration": 5.113
  },
  {
    "id": 40,
    "text": "合而观之，蒲松龄在《聊斋志异》中把满腔孤愤寄寓于花妖狐魅世界，",
    "start": 219.08,
    "end": 225.06,
    "duration": 5.98
  },
  {
    "id": 41,
    "text": "以理想化异类的真纯柔情反衬世态炎凉，尖锐刺击科举弊端与贪官暴政。",
    "start": 225.06,
    "end": 230.98,
    "duration": 5.92
  },
  {
    "id": 42,
    "text": "全书“用传奇法，而以志怪”，将简练文言叙事与浓郁诗意境界融为一体，",
    "start": 230.98,
    "end": 236.7,
    "duration": 5.72
  },
  {
    "id": 43,
    "text": "推动中国古代文言短篇小说走向集大成的成熟阶段。",
    "start": 236.7,
    "end": 240.868,
    "duration": 4.168
  }
]