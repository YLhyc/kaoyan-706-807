[
  {
    "id": "sent_1",
    "text": "《聊斋志异》 是中国古典文言短篇小说发展的至高巅峰。",
    "start": 0.0,
    "end": 4.04,
    "duration": 4.04
  },
  {
    "id": "sent_2",
    "text": "面对清代康乾时期满汉民族矛盾隐痛、",
    "start": 4.489,
    "end": 7.809,
    "duration": 3.32
  },
  {
    "id": "sent_3",
    "text": "皇权专制强化与八股科举制度对知识分子心灵的无情摧残，",
    "start": 8.259,
    "end": 13.179,
    "duration": 4.92
  },
  {
    "id": "sent_4",
    "text": "蒲松龄以自身屡试不第、寄人篱下的乡村落魄文人阅历，",
    "start": 13.629,
    "end": 18.029,
    "duration": 4.4
  },
  {
    "id": "sent_5",
    "text": "将满腔激愤倾注于笔端。",
    "start": 18.479,
    "end": 20.679,
    "duration": 2.2
  },
  {
    "id": "sent_6",
    "text": "他继承六朝志怪与唐代传奇的优良传统，“用传奇法，而以志怪”，",
    "start": 21.129,
    "end": 26.289,
    "duration": 5.16
  },
  {
    "id": "sent_7",
    "text": "借荒诞离奇的鬼狐幻境揭示冷酷黑暗的人间社会。",
    "start": 26.739,
    "end": 30.819,
    "duration": 4.08
  },
  {
    "id": "sent_8",
    "text": "郭沫若精辟题词赞其 “写鬼写妖高人一等，刺贪刺虐入木三分”。",
    "start": 31.269,
    "end": 36.669,
    "duration": 5.4
  },
  {
    "id": "sent_9",
    "text": "其花妖狐魅形象塑造与社会批判意蕴，",
    "start": 37.119,
    "end": 40.319,
    "duration": 3.2
  },
  {
    "id": "sent_10",
    "text": "主要展现为以下四个核心维度：",
    "start": 40.769,
    "end": 43.289,
    "duration": 2.52
  },
  {
    "id": "sent_11",
    "text": "第一，塑造真纯善良的花妖狐魅典型群像，",
    "start": 43.739,
    "end": 47.539,
    "duration": 3.8
  },
  {
    "id": "sent_12",
    "text": "以理想异类反衬现实社会的冷酷虚伪。",
    "start": 47.989,
    "end": 51.069,
    "duration": 3.08
  },
  {
    "id": "sent_13",
    "text": "蒲松龄在小说美学上的突出突破，",
    "start": 51.599,
    "end": 54.119,
    "duration": 2.52
  },
  {
    "id": "sent_14",
    "text": "在于彻底扭转了传统志怪小说中妖异害人的固有模式。",
    "start": 54.569,
    "end": 58.929,
    "duration": 4.36
  },
  {
    "id": "sent_15",
    "text": "他笔下的花妖狐魅，",
    "start": 59.379,
    "end": 61.059,
    "duration": 1.68
  },
  {
    "id": "sent_16",
    "text": "多被赋予了超越世俗人类的美好品德与纯一人性：",
    "start": 61.509,
    "end": 65.269,
    "duration": 3.76
  },
  {
    "id": "sent_17",
    "text": "在 《婴宁》 中，狐女婴宁天真无邪、不谙世俗礼法，",
    "start": 65.719,
    "end": 69.919,
    "duration": 4.2
  },
  {
    "id": "sent_18",
    "text": "以清脆自然的笑声对抗封建规训的窒息压抑；",
    "start": 70.369,
    "end": 73.809,
    "duration": 3.44
  },
  {
    "id": "sent_19",
    "text": "在 《小翠》 中，狐女小翠智勇双全、谐谑机智，",
    "start": 74.259,
    "end": 77.859,
    "duration": 3.6
  },
  {
    "id": "sent_20",
    "text": "甘愿报恩拯救痴儿公子；",
    "start": 78.309,
    "end": 80.349,
    "duration": 2.04
  },
  {
    "id": "sent_21",
    "text": "在 《辛十四娘》 中，十四娘行善积德、深明大义。",
    "start": 80.799,
    "end": 84.759,
    "duration": 3.96
  },
  {
    "id": "sent_22",
    "text": "这些非人类的异类女性，不仅貌美多情，更具备敢于冲破世俗门第、",
    "start": 85.209,
    "end": 90.689,
    "duration": 5.48
  },
  {
    "id": "sent_23",
    "text": "追求独立自主的健全人格，",
    "start": 91.139,
    "end": 93.299,
    "duration": 2.16
  },
  {
    "id": "sent_24",
    "text": "与现实人间官僚豪绅的虚伪贪婪形成了极其强烈的审美对照。",
    "start": 93.749,
    "end": 98.589,
    "duration": 4.84
  },
  {
    "id": "sent_25",
    "text": "第二，深刻揭露封建八股科举制度的腐朽残酷，",
    "start": 99.039,
    "end": 103.039,
    "duration": 4.0
  },
  {
    "id": "sent_26",
    "text": "展现寒门士人的精神苦难。",
    "start": 103.489,
    "end": 105.649,
    "duration": 2.16
  },
  {
    "id": "sent_27",
    "text": "作为终生困顿于科场的下层知识分子，",
    "start": 106.099,
    "end": 109.259,
    "duration": 3.16
  },
  {
    "id": "sent_28",
    "text": "蒲松龄对科举制度的弊端有着痛切的骨肉体会。",
    "start": 109.709,
    "end": 113.429,
    "duration": 3.72
  },
  {
    "id": "sent_29",
    "text": "他以冷峻幽默的笔墨，",
    "start": 113.879,
    "end": 115.639,
    "duration": 1.76
  },
  {
    "id": "sent_30",
    "text": "深刻讽刺了八股取士的荒谬与考官的不辨菽麦。",
    "start": 116.089,
    "end": 119.849,
    "duration": 3.76
  },
  {
    "id": "sent_31",
    "text": "在 《司文郎》 中，通过盲和尚以鼻嗅文，",
    "start": 120.299,
    "end": 123.219,
    "duration": 2.92
  },
  {
    "id": "sent_32",
    "text": "“鼻孔大衄” 于劣作、赞叹于佳文的辛辣寓言，",
    "start": 123.669,
    "end": 127.349,
    "duration": 3.68
  },
  {
    "id": "sent_33",
    "text": "无情嘲讽了考官有眼无珠的瞎子本质；",
    "start": 127.879,
    "end": 130.679,
    "duration": 2.8
  },
  {
    "id": "sent_34",
    "text": "在 《王子安》 中，",
    "start": 131.129,
    "end": 132.249,
    "duration": 1.12
  },
  {
    "id": "sent_35",
    "text": "极其生动地描摹考生入场应试的 “秀才七变”，由病鸟、",
    "start": 132.699,
    "end": 137.299,
    "duration": 4.6
  },
  {
    "id": "sent_36",
    "text": "受刑犯人到疯癫发狂，",
    "start": 137.829,
    "end": 139.909,
    "duration": 2.08
  },
  {
    "id": "sent_37",
    "text": "将士子在功名利禄驱使下丧失尊严的扭曲悲剧揭露得淋漓尽致。",
    "start": 140.359,
    "end": 145.599,
    "duration": 5.24
  },
  {
    "id": "sent_38",
    "text": "第三，无情鞭挞贪官恶霸的暴虐罪恶，为底层受苦难百姓伸张正义。",
    "start": 146.049,
    "end": 151.969,
    "duration": 5.92
  },
  {
    "id": "sent_39",
    "text": "《聊斋志异》 深刻展现了对封建专制统治压迫百姓的强烈批判。",
    "start": 152.419,
    "end": 157.059,
    "duration": 4.64
  },
  {
    "id": "sent_40",
    "text": "在名篇 《促织》 中，以一只细微蟋蟀的进贡为线索，",
    "start": 157.509,
    "end": 161.509,
    "duration": 4.0
  },
  {
    "id": "sent_41",
    "text": "深刻揭露了 “一人飞升，",
    "start": 161.959,
    "end": 163.839,
    "duration": 1.88
  },
  {
    "id": "sent_42",
    "text": "仙及鸡犬” 的朝廷享乐对百姓家破人亡的血泪榨取；",
    "start": 164.289,
    "end": 168.729,
    "duration": 4.44
  },
  {
    "id": "sent_43",
    "text": "在 《席方平》 中，席方平为其蒙冤被害的父亲鸣冤，自县衙、",
    "start": 169.179,
    "end": 174.179,
    "duration": 5.0
  },
  {
    "id": "sent_44",
    "text": "府衙申诉至城隍、阎王乃至东岳大帝，所遇神佛官吏无不贪赃枉法、",
    "start": 174.629,
    "end": 180.109,
    "duration": 5.48
  },
  {
    "id": "sent_45",
    "text": "上下勾结，使阳间受苦的百姓在阴司同样遭受锯解油烹的残酷肉刑。",
    "start": 180.639,
    "end": 186.519,
    "duration": 5.88
  },
  {
    "id": "sent_46",
    "text": "蒲松龄借鬼魅地狱直斥封建官场黑幕，",
    "start": 186.968,
    "end": 190.288,
    "duration": 3.32
  },
  {
    "id": "sent_47",
    "text": "展现了强烈的批判骨力与人道主义同情。",
    "start": 190.738,
    "end": 193.978,
    "duration": 3.24
  },
  {
    "id": "sent_48",
    "text": "第四，融合典雅文言与生动方言于一体，",
    "start": 194.428,
    "end": 197.788,
    "duration": 3.36
  },
  {
    "id": "sent_49",
    "text": "达成“文备众体”的纯正叙事艺术。",
    "start": 198.238,
    "end": 200.758,
    "duration": 2.52
  },
  {
    "id": "sent_50",
    "text": "在小说体式上，",
    "start": 201.208,
    "end": 202.488,
    "duration": 1.28
  },
  {
    "id": "sent_51",
    "text": "《聊斋志异》 实现了古代文言小说语言与技巧的集大成。",
    "start": 202.938,
    "end": 206.978,
    "duration": 4.04
  },
  {
    "id": "sent_52",
    "text": "蒲松龄在典重典雅的先秦两汉史传文言之中，",
    "start": 207.428,
    "end": 211.148,
    "duration": 3.72
  },
  {
    "id": "sent_53",
    "text": "自然吸纳了山东淄川本土的生动俗语口吻与市井俚语；",
    "start": 211.598,
    "end": 215.878,
    "duration": 4.28
  },
  {
    "id": "sent_54",
    "text": "其叙事结构精巧多变，心理刻画与神态白描兼备，",
    "start": 216.328,
    "end": 220.448,
    "duration": 4.12
  },
  {
    "id": "sent_55",
    "text": "善于在现实生活细节中自然切入奇幻情节，",
    "start": 220.898,
    "end": 224.498,
    "duration": 3.6
  },
  {
    "id": "sent_56",
    "text": "打破了现实与幻想的物理界限。",
    "start": 224.948,
    "end": 227.348,
    "duration": 2.4
  },
  {
    "id": "sent_57",
    "text": "这部巨著不仅使古典文言小说重新焕发出旺盛的艺术生机，",
    "start": 227.798,
    "end": 232.438,
    "duration": 4.64
  },
  {
    "id": "sent_58",
    "text": "更树立了中国古代短篇小说无法超越的美学高峰。",
    "start": 232.888,
    "end": 237.008,
    "duration": 4.12
  }
]