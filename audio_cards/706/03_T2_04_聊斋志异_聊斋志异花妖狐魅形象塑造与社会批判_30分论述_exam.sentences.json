[
  {
    "id": "sent_1",
    "text": "《聊斋志异》 是中国古典文言短篇小说发展的至高巅峰。",
    "start": 0.1,
    "end": 5.271,
    "duration": 5.171
  },
  {
    "id": "sent_2",
    "text": "面对清代康乾时期满汉民族矛盾隐痛、皇权专制强化与八股科举制度对知识分子心灵的无情摧残，",
    "start": 5.221,
    "end": 14.987,
    "duration": 9.766
  },
  {
    "id": "sent_3",
    "text": "蒲松龄以自身屡试不第、寄人篱下的乡村落魄文人阅历，",
    "start": 14.987,
    "end": 20.286,
    "duration": 5.299
  },
  {
    "id": "sent_4",
    "text": "将满腔激愤倾注于笔端。",
    "start": 20.286,
    "end": 23.151,
    "duration": 2.865
  },
  {
    "id": "sent_5",
    "text": "他继承六朝志怪与唐代传奇的优良传统，“用传奇法，而以志怪”，",
    "start": 23.151,
    "end": 29.323,
    "duration": 6.172
  },
  {
    "id": "sent_6",
    "text": "借荒诞离奇的鬼狐幻境揭示冷酷黑暗的人间社会。",
    "start": 29.323,
    "end": 34.206,
    "duration": 4.883
  },
  {
    "id": "sent_7",
    "text": "郭沫若精辟题词赞其 “写鬼写妖高人一等，刺贪刺虐入木三分”。",
    "start": 34.206,
    "end": 40.378,
    "duration": 6.172
  },
  {
    "id": "sent_8",
    "text": "其花妖狐魅形象塑造与社会批判意蕴，主要展现为以下四个核心维度：",
    "start": 40.378,
    "end": 47.071,
    "duration": 6.693
  },
  {
    "id": "sent_9",
    "text": "第一，塑造真纯善良的花妖狐魅典型群像，",
    "start": 47.07,
    "end": 51.276,
    "duration": 4.206
  },
  {
    "id": "sent_10",
    "text": "以理想异类反衬现实社会的冷酷虚伪。",
    "start": 51.276,
    "end": 55.13,
    "duration": 3.854
  },
  {
    "id": "sent_11",
    "text": "蒲松龄在小说美学上的突出突破，",
    "start": 55.13,
    "end": 58.476,
    "duration": 3.346
  },
  {
    "id": "sent_12",
    "text": "在于彻底扭转了传统志怪小说中妖异害人的固有模式。",
    "start": 58.477,
    "end": 63.724,
    "duration": 5.247
  },
  {
    "id": "sent_13",
    "text": "他笔下的花妖狐魅，多被赋予了超越世俗人类的美好品德与纯一人性：",
    "start": 63.724,
    "end": 70.182,
    "duration": 6.458
  },
  {
    "id": "sent_14",
    "text": "在 《婴宁》 中，狐女婴宁天真无邪、不谙世俗礼法，",
    "start": 70.182,
    "end": 74.674,
    "duration": 4.492
  },
  {
    "id": "sent_15",
    "text": "以清脆自然的笑声对抗封建规训的窒息压抑；",
    "start": 74.674,
    "end": 79.166,
    "duration": 4.492
  },
  {
    "id": "sent_16",
    "text": "在 《小翠》 中，狐女小翠智勇双全、谐谑机智，",
    "start": 79.167,
    "end": 83.503,
    "duration": 4.336
  },
  {
    "id": "sent_17",
    "text": "甘愿报恩拯救痴儿公子；",
    "start": 83.503,
    "end": 86.146,
    "duration": 2.643
  },
  {
    "id": "sent_18",
    "text": "在 《辛十四娘》 中，十四娘行善积德、深明大义。",
    "start": 86.146,
    "end": 90.794,
    "duration": 4.648
  },
  {
    "id": "sent_19",
    "text": "这些非人类的异类女性，不仅貌美多情，",
    "start": 90.794,
    "end": 94.583,
    "duration": 3.789
  },
  {
    "id": "sent_20",
    "text": "更具备敢于冲破世俗门第、追求独立自主的健全人格，",
    "start": 94.583,
    "end": 99.713,
    "duration": 5.13
  },
  {
    "id": "sent_21",
    "text": "与现实人间官僚豪绅的虚伪贪婪形成了极其强烈的审美对照。",
    "start": 99.713,
    "end": 105.469,
    "duration": 5.756
  },
  {
    "id": "sent_22",
    "text": "第二，深刻揭露封建八股科举制度的腐朽残酷，",
    "start": 105.469,
    "end": 110.091,
    "duration": 4.622
  },
  {
    "id": "sent_23",
    "text": "展现寒门士人的精神苦难。",
    "start": 110.091,
    "end": 112.89,
    "duration": 2.799
  },
  {
    "id": "sent_24",
    "text": "作为终生困顿于科场的下层知识分子，",
    "start": 112.891,
    "end": 116.472,
    "duration": 3.581
  },
  {
    "id": "sent_25",
    "text": "蒲松龄对科举制度的弊端有着痛切的骨肉体会。",
    "start": 116.471,
    "end": 120.924,
    "duration": 4.453
  },
  {
    "id": "sent_26",
    "text": "他以冷峻幽默的笔墨，深刻讽刺了八股取士的荒谬与考官的不辨菽麦。",
    "start": 120.924,
    "end": 127.109,
    "duration": 6.185
  },
  {
    "id": "sent_27",
    "text": "在 《司文郎》 中，通过盲和尚以鼻嗅文，",
    "start": 127.109,
    "end": 131.093,
    "duration": 3.984
  },
  {
    "id": "sent_28",
    "text": "“鼻孔大衄” 于劣作、赞叹于佳文的辛辣寓言，",
    "start": 131.094,
    "end": 135.3,
    "duration": 4.206
  },
  {
    "id": "sent_29",
    "text": "无情嘲讽了考官有眼无珠的瞎子本质；",
    "start": 135.299,
    "end": 138.971,
    "duration": 3.672
  },
  {
    "id": "sent_30",
    "text": "在 《王子安》 中，极其生动地描摹考生入场应试的 “秀才七变”，",
    "start": 138.971,
    "end": 144.531,
    "duration": 5.56
  },
  {
    "id": "sent_31",
    "text": "由病鸟、受刑犯人到疯癫发狂，",
    "start": 144.531,
    "end": 148.073,
    "duration": 3.542
  },
  {
    "id": "sent_32",
    "text": "将士子在功名利禄驱使下丧失尊严的扭曲悲剧揭露得淋漓尽致。",
    "start": 148.073,
    "end": 154.271,
    "duration": 6.198
  },
  {
    "id": "sent_33",
    "text": "第三，无情鞭挞贪官恶霸的暴虐罪恶，为底层受苦难百姓伸张正义。",
    "start": 154.271,
    "end": 160.86,
    "duration": 6.589
  },
  {
    "id": "sent_34",
    "text": "《聊斋志异》 深刻展现了对封建专制统治压迫百姓的强烈批判。",
    "start": 160.859,
    "end": 166.862,
    "duration": 6.003
  },
  {
    "id": "sent_35",
    "text": "在名篇 《促织》 中，以一只细微蟋蟀的进贡为线索，",
    "start": 166.862,
    "end": 171.419,
    "duration": 4.557
  },
  {
    "id": "sent_36",
    "text": "深刻揭露了 “一人飞升，",
    "start": 171.419,
    "end": 173.892,
    "duration": 2.473
  },
  {
    "id": "sent_37",
    "text": "仙及鸡犬” 的朝廷享乐对百姓家破人亡的血泪榨取；",
    "start": 173.893,
    "end": 178.646,
    "duration": 4.753
  },
  {
    "id": "sent_38",
    "text": "在 《席方平》 中，席方平为其蒙冤被害的父亲鸣冤，",
    "start": 178.646,
    "end": 183.19,
    "duration": 4.544
  },
  {
    "id": "sent_39",
    "text": "自县衙、府衙申诉至城隍、阎王乃至东岳大帝，",
    "start": 183.19,
    "end": 188.607,
    "duration": 5.417
  },
  {
    "id": "sent_40",
    "text": "所遇神佛官吏无不贪赃枉法、上下勾结，",
    "start": 188.607,
    "end": 192.735,
    "duration": 4.128
  },
  {
    "id": "sent_41",
    "text": "使阳间受苦的百姓在阴司同样遭受锯解油烹的残酷肉刑。",
    "start": 192.734,
    "end": 198.099,
    "duration": 5.365
  },
  {
    "id": "sent_42",
    "text": "蒲松龄借鬼魅地狱直斥封建官场黑幕，",
    "start": 198.099,
    "end": 202.214,
    "duration": 4.115
  },
  {
    "id": "sent_43",
    "text": "展现了强烈的批判骨力与人道主义同情。",
    "start": 202.214,
    "end": 206.198,
    "duration": 3.984
  },
  {
    "id": "sent_44",
    "text": "第四，融合典雅文言与生动方言于一体，",
    "start": 206.198,
    "end": 210.378,
    "duration": 4.18
  },
  {
    "id": "sent_45",
    "text": "达成“文备众体”的纯正叙事艺术。",
    "start": 210.378,
    "end": 213.542,
    "duration": 3.164
  },
  {
    "id": "sent_46",
    "text": "在小说体式上，",
    "start": 213.542,
    "end": 215.417,
    "duration": 1.875
  },
  {
    "id": "sent_47",
    "text": "《聊斋志异》 实现了古代文言小说语言与技巧的集大成。",
    "start": 215.417,
    "end": 220.469,
    "duration": 5.052
  },
  {
    "id": "sent_48",
    "text": "蒲松龄在典重典雅的先秦两汉史传文言之中，",
    "start": 220.469,
    "end": 225.274,
    "duration": 4.805
  },
  {
    "id": "sent_49",
    "text": "自然吸纳了山东淄川本土的生动俗语口吻与市井俚语；",
    "start": 225.273,
    "end": 230.416,
    "duration": 5.143
  },
  {
    "id": "sent_50",
    "text": "其叙事结构精巧多变，心理刻画与神态白描兼备，",
    "start": 230.417,
    "end": 235.248,
    "duration": 4.831
  },
  {
    "id": "sent_51",
    "text": "善于在现实生活细节中自然切入奇幻情节，",
    "start": 235.247,
    "end": 239.531,
    "duration": 4.284
  },
  {
    "id": "sent_52",
    "text": "打破了现实与幻想的物理界限。",
    "start": 239.531,
    "end": 242.669,
    "duration": 3.138
  },
  {
    "id": "sent_53",
    "text": "这部巨著不仅使古典文言小说重新焕发出旺盛的艺术生机，",
    "start": 242.669,
    "end": 248.372,
    "duration": 5.703
  },
  {
    "id": "sent_54",
    "text": "更树立了中国古代短篇小说无法超越的美学高峰。",
    "start": 248.372,
    "end": 253.086,
    "duration": 4.714
  }
]