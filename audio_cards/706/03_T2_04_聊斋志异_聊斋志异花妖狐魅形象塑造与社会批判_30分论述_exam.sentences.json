[
  {
    "id": 1,
    "text": "试论《聊斋志异》的花妖狐魅形象塑造与社会批判意蕴。",
    "start": 0.134,
    "end": 3.986,
    "duration": 3.852
  },
  {
    "id": 2,
    "text": "《聊斋志异》是中国古代文言短篇小说发展的巅峰之作。",
    "start": 4.743,
    "end": 8.395,
    "duration": 3.652
  },
  {
    "id": 3,
    "text": "清代初年政治高压日甚、八股科举日益僵化，",
    "start": 9.033,
    "end": 12.365,
    "duration": 3.332
  },
  {
    "id": 4,
    "text": "蒲松龄凭借自身屡试不第、长期坐馆的落魄文人阅历，将满腔孤愤寄托于狐鬼世界之中。",
    "start": 12.744,
    "end": 19.236,
    "duration": 6.492
  },
  {
    "id": 5,
    "text": "他继承六朝志怪与唐代传奇传统，鲁迅在《中国小说史略》中称之为“用传奇法，而以志怪”；",
    "start": 19.954,
    "end": 24.106,
    "duration": 4.152
  },
  {
    "id": 6,
    "text": "郭沫若亦赞其“写鬼写妖高人一等，刺贪刺虐入骨三分”。",
    "start": 24.635,
    "end": 26.967,
    "duration": 2.332
  },
  {
    "id": 7,
    "text": "《聊斋志异》的花妖狐魅形象塑造与社会批判意蕴，主要体现在以下四个方面：",
    "start": 27.645,
    "end": 32.457,
    "duration": 4.812
  },
  {
    "id": 8,
    "text": "第一，塑造真纯美好的花妖狐魅群像，以理想异类反衬世俗人情冷酷。",
    "start": 33.255,
    "end": 44.587,
    "duration": 11.332
  },
  {
    "id": 9,
    "text": "蒲松龄在小说创作上的重要突破，在于扭转了传统志怪小说中妖异害人的固有模式。",
    "start": 45.265,
    "end": 51.677,
    "duration": 6.412
  },
  {
    "id": 10,
    "text": "他笔下的花妖狐魅，大都保留着原本的物性特征，却又被赋予真挚纯善的人性与人情：",
    "start": 52.355,
    "end": 66.733,
    "duration": 14.378
  },
  {
    "id": 11,
    "text": "在《婴宁》中，狐女婴宁天真憨直、爱花爱笑，以不谙世故的纯真天性对抗世俗礼法的窒息压抑；",
    "start": 67.425,
    "end": 70.037,
    "duration": 2.612
  },
  {
    "id": 12,
    "text": "在《黄英》中，菊花精黄英自食其力、种菊致富，突破了士大夫迂腐虚伪的清高观念；",
    "start": 70.566,
    "end": 73.058,
    "duration": 2.492
  },
  {
    "id": 13,
    "text": "在《阿绣》中，狐女因感动于痴情而成人之美。",
    "start": 73.587,
    "end": 74.359,
    "duration": 0.772
  },
  {
    "id": 14,
    "text": "这些异类女性不仅容貌秀美，更敢于冲破门第与礼教束缚，与现实人间的虚伪势利形成鲜明对照。",
    "start": 75.037,
    "end": 78.449,
    "duration": 3.412
  },
  {
    "id": 15,
    "text": "第二，辛辣讽刺八股科举制度的腐朽弊端，抒写寒门士人的精神苦闷。",
    "start": 79.087,
    "end": 86.859,
    "duration": 7.772
  },
  {
    "id": 16,
    "text": "长期困顿场屋的切身经历，使蒲松龄对科举制度的积弊有着痛切体会。",
    "start": 87.537,
    "end": 93.109,
    "duration": 5.572
  },
  {
    "id": 17,
    "text": "他以犀利幽默的笔墨，猛烈嘲讽八股取士的荒谬与试官的昏庸贪婪。",
    "start": 93.787,
    "end": 105.559,
    "duration": 11.772
  },
  {
    "id": 18,
    "text": "在《司文郎》中，盲僧凭嗅觉品评文章优劣，面对试官取落颠倒愤然斥责“仆虽盲于目，而不盲于鼻，今帘中人并鼻盲矣”，",
    "start": 106.088,
    "end": 115.42,
    "duration": 9.332
  },
  {
    "id": 19,
    "text": "将考官的有眼无珠揭露得体无完肤；",
    "start": 115.932,
    "end": 118.504,
    "duration": 2.572
  },
  {
    "id": 20,
    "text": "在《王子安》中，生动描摹落魄秀才醉卧中连试皆捷、得意忘形的梦幻幻觉，",
    "start": 119.033,
    "end": 124.645,
    "duration": 5.612
  },
  {
    "id": 21,
    "text": "既嘲弄了士子追逐功名利禄的痴狂丑态，又蕴含着怀才不遇者的深深自伤。",
    "start": 125.193,
    "end": 130.925,
    "duration": 5.732
  },
  {
    "id": 22,
    "text": "第三，无情鞭挞贪官恶霸的暴虐罪恶，替底层受苦民众伸张正义。",
    "start": 131.549,
    "end": 137.121,
    "duration": 5.572
  },
  {
    "id": 23,
    "text": "《聊斋志异》以鲜明的爱憎立场，深刻揭露了封建官场的贪残黑暗。",
    "start": 137.839,
    "end": 142.611,
    "duration": 4.772
  },
  {
    "id": 24,
    "text": "在名篇《促织》中，朝廷征索小小蟋蟀致使百姓倾家荡产、幼子几近丧命，",
    "start": 143.289,
    "end": 148.941,
    "duration": 5.652
  },
  {
    "id": 25,
    "text": "作者最后冷语讥刺“一人飞升，仙及鸡犬”，将批判矛头直指最高统治者与各级官僚；",
    "start": 149.32,
    "end": 155.932,
    "duration": 6.612
  },
  {
    "id": 26,
    "text": "在《席方平》中，席方平为受豪绅凌辱的父亲入阴司鸣冤，",
    "start": 156.61,
    "end": 160.902,
    "duration": 4.292
  },
  {
    "id": 27,
    "text": "却见城隍、郡司、冥王各级衙门无不贪赃受贿、酷刑施虐，阴曹之暗昧尤胜于阳间。",
    "start": 161.281,
    "end": 168.053,
    "duration": 6.772
  },
  {
    "id": 28,
    "text": "蒲松龄借幽冥地狱映照人间官府黑幕，展现出强烈的批判锋芒与民生关怀。",
    "start": 168.771,
    "end": 174.623,
    "duration": 5.852
  },
  {
    "id": 29,
    "text": "第四，兼融志怪与传奇艺术之长，开创诗意浓郁、语言简练的叙事风范。",
    "start": 175.341,
    "end": 181.033,
    "duration": 5.692
  },
  {
    "id": 30,
    "text": "在叙事艺术上，《聊斋志异》使文言短篇小说突破了粗陈梗概的局限。",
    "start": 181.711,
    "end": 186.763,
    "duration": 5.052
  },
  {
    "id": 31,
    "text": "蒲松龄将先秦两汉的典雅文言与山东方言俗语自然交融，",
    "start": 187.441,
    "end": 191.253,
    "duration": 3.812
  },
  {
    "id": 32,
    "text": "叙述语言平易简洁而文约事丰，人物语言则因人因事而庄谐多变；",
    "start": 191.632,
    "end": 192.284,
    "duration": 0.652
  },
  {
    "id": 33,
    "text": "作品又善于描写环境、动作与心理细节，并将诗词意象与“偶见鹘突，知复非人”的含蓄笔法引入小说，",
    "start": 192.813,
    "end": 195.225,
    "duration": 2.412
  },
  {
    "id": 34,
    "text": "使人鬼幽婚与幻境奇谈富有浓郁的诗意与回味。",
    "start": 195.604,
    "end": 197.976,
    "duration": 2.372
  },
  {
    "id": 35,
    "text": "这部杰作将中国古代文言短篇小说推向了后人难以企及的艺术高峰。",
    "start": 198.654,
    "end": 210.426,
    "duration": 11.772
  },
  {
    "id": 36,
    "text": "合而观之，蒲松龄在《聊斋志异》中把满腔孤愤寄寓于花妖狐魅世界，",
    "start": 211.064,
    "end": 222.156,
    "duration": 11.092
  },
  {
    "id": 37,
    "text": "以理想化异类的真纯柔情反衬世态炎凉，尖锐刺击科举弊端与贪官暴政。",
    "start": 222.672,
    "end": 228.524,
    "duration": 5.852
  },
  {
    "id": 38,
    "text": "全书“用传奇法，而以志怪”，将简练文言叙事与浓郁诗意境界融为一体，",
    "start": 229.053,
    "end": 234.505,
    "duration": 5.452
  },
  {
    "id": 39,
    "text": "推动中国古代文言短篇小说走向集大成的成熟阶段。",
    "start": 234.884,
    "end": 239.176,
    "duration": 4.292
  }
]