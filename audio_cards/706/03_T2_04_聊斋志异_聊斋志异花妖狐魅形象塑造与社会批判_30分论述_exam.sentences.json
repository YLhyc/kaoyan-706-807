[
  {
    "id": 1,
    "text": "试论《聊斋志异》的花妖狐魅形象塑造与社会批判意蕴。",
    "start": 0.16,
    "end": 5.28,
    "duration": 5.12
  },
  {
    "id": 2,
    "text": "《聊斋志异》 是中国古典文言短篇小说发展的至高巅峰。",
    "start": 5.28,
    "end": 10.24,
    "duration": 4.96
  },
  {
    "id": 3,
    "text": "面对清代康乾时期满汉民族矛盾隐痛、",
    "start": 10.24,
    "end": 13.68,
    "duration": 3.44
  },
  {
    "id": 4,
    "text": "皇权专制强化与八股科举制度对知识分子心灵的无情摧残，",
    "start": 13.68,
    "end": 19.2,
    "duration": 5.52
  },
  {
    "id": 5,
    "text": "蒲松龄以自身屡试不第、寄人篱下的乡村落魄文人阅历，",
    "start": 19.2,
    "end": 24.48,
    "duration": 5.28
  },
  {
    "id": 6,
    "text": "将满腔激愤倾注于笔端。",
    "start": 24.48,
    "end": 27.04,
    "duration": 2.56
  },
  {
    "id": 7,
    "text": "他继承六朝志怪与唐代传奇的优良传统，“用传奇法，",
    "start": 27.04,
    "end": 32.4,
    "duration": 5.36
  },
  {
    "id": 8,
    "text": "而以志怪”，借荒诞离奇的鬼狐幻境揭示冷酷黑暗的人间社会。",
    "start": 32.4,
    "end": 39.12,
    "duration": 6.72
  },
  {
    "id": 9,
    "text": "郭沫若精辟题词赞其 “写鬼写妖高人一等，刺贪刺虐入木三分”。",
    "start": 39.12,
    "end": 45.68,
    "duration": 6.56
  },
  {
    "id": 10,
    "text": "其花妖狐魅形象塑造与社会批判意蕴，",
    "start": 45.68,
    "end": 49.52,
    "duration": 3.84
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：",
    "start": 49.52,
    "end": 52.88,
    "duration": 3.36
  },
  {
    "id": 12,
    "text": "第一，塑造真纯善良的花妖狐魅典型群像，",
    "start": 52.88,
    "end": 57.6,
    "duration": 4.72
  },
  {
    "id": 13,
    "text": "以理想异类反衬现实社会的冷酷虚伪。",
    "start": 57.6,
    "end": 61.12,
    "duration": 3.52
  },
  {
    "id": 14,
    "text": "蒲松龄在小说美学上的突出突破，",
    "start": 61.12,
    "end": 64.56,
    "duration": 3.44
  },
  {
    "id": 15,
    "text": "在于彻底扭转了传统志怪小说中妖异害人的固有模式。",
    "start": 64.56,
    "end": 69.44,
    "duration": 4.88
  },
  {
    "id": 16,
    "text": "他笔下的花妖狐魅，",
    "start": 69.44,
    "end": 72.16,
    "duration": 2.72
  },
  {
    "id": 17,
    "text": "多被赋予了超越世俗人类的美好品德与纯一人性：",
    "start": 72.16,
    "end": 77.36,
    "duration": 5.2
  },
  {
    "id": 18,
    "text": "在 《婴宁》 中，狐女婴宁天真无邪、不谙世俗礼法，",
    "start": 77.36,
    "end": 82.88,
    "duration": 5.52
  },
  {
    "id": 19,
    "text": "以清脆自然的笑声对抗封建规训的窒息压抑；",
    "start": 82.88,
    "end": 87.76,
    "duration": 4.88
  },
  {
    "id": 20,
    "text": "在 《小翠》 中，狐女小翠智勇双全、谐谑机智，",
    "start": 87.76,
    "end": 92.4,
    "duration": 4.64
  },
  {
    "id": 21,
    "text": "甘愿报恩拯救痴儿公子；在 《辛十四娘》 中，",
    "start": 92.4,
    "end": 96.72,
    "duration": 4.32
  },
  {
    "id": 22,
    "text": "十四娘行善积德、深明大义。",
    "start": 96.72,
    "end": 99.76,
    "duration": 3.04
  },
  {
    "id": 23,
    "text": "这些非人类的异类女性，不仅貌美多情，",
    "start": 99.76,
    "end": 103.52,
    "duration": 3.76
  },
  {
    "id": 24,
    "text": "更具备敢于冲破世俗门第、追求独立自主的健全人格，",
    "start": 103.52,
    "end": 109.12,
    "duration": 5.6
  },
  {
    "id": 25,
    "text": "与现实人间官僚豪绅的虚伪贪婪形成了极其强烈的审美对照。",
    "start": 109.12,
    "end": 114.96,
    "duration": 5.84
  },
  {
    "id": 26,
    "text": "第二，深刻揭露封建八股科举制度的腐朽残酷，",
    "start": 114.96,
    "end": 119.12,
    "duration": 4.16
  },
  {
    "id": 27,
    "text": "展现寒门士人的精神苦难。",
    "start": 119.12,
    "end": 121.52,
    "duration": 2.4
  },
  {
    "id": 28,
    "text": "作为终生困顿于科场的下层知识分子，",
    "start": 121.52,
    "end": 125.36,
    "duration": 3.84
  },
  {
    "id": 29,
    "text": "蒲松龄对科举制度的弊端有着痛切的骨肉体会。",
    "start": 125.36,
    "end": 130.48,
    "duration": 5.12
  },
  {
    "id": 30,
    "text": "他以冷峻幽默的笔墨，",
    "start": 130.48,
    "end": 132.56,
    "duration": 2.08
  },
  {
    "id": 31,
    "text": "深刻讽刺了八股取士的荒谬与考官的不辨菽麦。",
    "start": 132.56,
    "end": 136.8,
    "duration": 4.24
  },
  {
    "id": 32,
    "text": "在 《司文郎》 中，通过盲和尚以鼻嗅文，",
    "start": 136.8,
    "end": 140.8,
    "duration": 4.0
  },
  {
    "id": 33,
    "text": "“鼻孔大衄” 于劣作、赞叹于佳文的辛辣寓言，",
    "start": 140.8,
    "end": 145.44,
    "duration": 4.64
  },
  {
    "id": 34,
    "text": "无情嘲讽了考官有眼无珠的瞎子本质；在 《王子安》 中，",
    "start": 145.44,
    "end": 150.96,
    "duration": 5.52
  },
  {
    "id": 35,
    "text": "极其生动地描摹考生入场应试的 “秀才七变”，由病鸟、",
    "start": 150.96,
    "end": 156.798,
    "duration": 5.838
  },
  {
    "id": 36,
    "text": "受刑犯人到疯癫发狂，",
    "start": 156.798,
    "end": 158.965,
    "duration": 2.167
  },
  {
    "id": 37,
    "text": "将士子在功名利禄驱使下丧失尊严的扭曲悲剧揭露得淋漓尽致。",
    "start": 158.965,
    "end": 165.032,
    "duration": 6.067
  },
  {
    "id": 38,
    "text": "第三，无情鞭挞贪官恶霸的暴虐罪恶，为底层受苦难百姓伸张正义。",
    "start": 165.032,
    "end": 171.1,
    "duration": 6.068
  },
  {
    "id": 39,
    "text": "《聊斋志异》 深刻展现了对封建专制统治压迫百姓的强烈批判。",
    "start": 171.1,
    "end": 177.167,
    "duration": 6.067
  },
  {
    "id": 40,
    "text": "在名篇 《促织》 中，以一只细微蟋蟀的进贡为线索，",
    "start": 177.167,
    "end": 182.151,
    "duration": 4.984
  },
  {
    "id": 41,
    "text": "深刻揭露了 “一人飞升，",
    "start": 182.151,
    "end": 184.534,
    "duration": 2.383
  },
  {
    "id": 42,
    "text": "仙及鸡犬” 的朝廷享乐对百姓家破人亡的血泪榨取；",
    "start": 184.534,
    "end": 189.488,
    "duration": 4.954
  },
  {
    "id": 43,
    "text": "在 《席方平》 中，席方平为其蒙冤被害的父亲鸣冤，",
    "start": 189.488,
    "end": 194.288,
    "duration": 4.8
  },
  {
    "id": 44,
    "text": "自县衙、府衙申诉至城隍、阎王乃至东岳大帝，",
    "start": 194.288,
    "end": 199.968,
    "duration": 5.68
  },
  {
    "id": 45,
    "text": "所遇神佛官吏无不贪赃枉法、上下勾结，",
    "start": 199.968,
    "end": 204.048,
    "duration": 4.08
  },
  {
    "id": 46,
    "text": "使阳间受苦的百姓在阴司同样遭受锯解油烹的残酷肉刑。",
    "start": 204.048,
    "end": 209.088,
    "duration": 5.04
  },
  {
    "id": 47,
    "text": "蒲松龄借鬼魅地狱直斥封建官场黑幕，",
    "start": 209.088,
    "end": 212.528,
    "duration": 3.44
  },
  {
    "id": 48,
    "text": "展现了强烈的批判骨力与人道主义同情。",
    "start": 212.528,
    "end": 216.128,
    "duration": 3.6
  },
  {
    "id": 49,
    "text": "第四，融合典雅文言与生动方言于一体，",
    "start": 216.128,
    "end": 220.288,
    "duration": 4.16
  },
  {
    "id": 50,
    "text": "达成“文备众体”的纯正叙事艺术。",
    "start": 220.288,
    "end": 223.648,
    "duration": 3.36
  },
  {
    "id": 51,
    "text": "在小说体式上，",
    "start": 223.648,
    "end": 225.248,
    "duration": 1.6
  },
  {
    "id": 52,
    "text": "《聊斋志异》 实现了古代文言小说语言与技巧的集大成。",
    "start": 225.248,
    "end": 229.808,
    "duration": 4.56
  },
  {
    "id": 53,
    "text": "蒲松龄在典重典雅的先秦两汉史传文言之中，",
    "start": 229.808,
    "end": 233.648,
    "duration": 3.84
  },
  {
    "id": 54,
    "text": "自然吸纳了山东淄川本土的生动俗语口吻与市井俚语；",
    "start": 233.648,
    "end": 235.728,
    "duration": 2.08
  },
  {
    "id": 55,
    "text": "其叙事结构精巧多变，心理刻画与神态白描兼备，",
    "start": 235.568,
    "end": 235.728,
    "duration": 0.16
  },
  {
    "id": 56,
    "text": "善于在现实生活细节中自然切入奇幻情节，",
    "start": 235.568,
    "end": 235.728,
    "duration": 0.16
  },
  {
    "id": 57,
    "text": "打破了现实与幻想的物理界限。",
    "start": 235.568,
    "end": 235.728,
    "duration": 0.16
  },
  {
    "id": 58,
    "text": "这部巨著不仅使古典文言小说重新焕发出旺盛的艺术生机，",
    "start": 235.568,
    "end": 235.728,
    "duration": 0.16
  },
  {
    "id": 59,
    "text": "更树立了中国古代短篇小说无法超越的美学高峰。",
    "start": 235.568,
    "end": 235.728,
    "duration": 0.16
  }
]