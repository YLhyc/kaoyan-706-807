[
  {
    "id": 1,
    "text": "试论《聊斋志异》的花妖狐魅形象塑造与社会批判意蕴。",
    "start": 0.0,
    "end": 5.202,
    "duration": 5.202
  },
  {
    "id": 2,
    "text": "《聊斋志异》 是中国古典文言短篇小说发展的至高巅峰。",
    "start": 5.202,
    "end": 9.572,
    "duration": 4.37
  },
  {
    "id": 3,
    "text": "面对清代康乾时期满汉民族矛盾隐痛、",
    "start": 9.572,
    "end": 12.865,
    "duration": 3.293
  },
  {
    "id": 4,
    "text": "皇权专制强化与八股科举制度对知识分子心灵的无情摧残，",
    "start": 12.865,
    "end": 18.137,
    "duration": 5.272
  },
  {
    "id": 5,
    "text": "蒲松龄以自身屡试不第、寄人篱下的乡村落魄文人阅历，",
    "start": 18.137,
    "end": 22.853,
    "duration": 4.716
  },
  {
    "id": 6,
    "text": "将满腔激愤倾注于笔端。",
    "start": 22.853,
    "end": 25.173,
    "duration": 2.32
  },
  {
    "id": 7,
    "text": "他继承六朝志怪与唐代传奇的优良传统，“用传奇法，",
    "start": 25.173,
    "end": 30.863,
    "duration": 5.69
  },
  {
    "id": 8,
    "text": "而以志怪”，借荒诞离奇的鬼狐幻境揭示冷酷黑暗的人间社会。",
    "start": 30.863,
    "end": 37.699,
    "duration": 6.836
  },
  {
    "id": 9,
    "text": "郭沫若精辟题词赞其 “写鬼写妖高人一等，刺贪刺虐入木三分”。",
    "start": 37.699,
    "end": 45.333,
    "duration": 7.634
  },
  {
    "id": 10,
    "text": "其花妖狐魅形象塑造与社会批判意蕴，",
    "start": 45.333,
    "end": 48.422,
    "duration": 3.089
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：",
    "start": 48.422,
    "end": 52.233,
    "duration": 3.811
  },
  {
    "id": 12,
    "text": "第一，塑造真纯善良的花妖狐魅典型群像，",
    "start": 52.233,
    "end": 56.348,
    "duration": 4.115
  },
  {
    "id": 13,
    "text": "以理想异类反衬现实社会的冷酷虚伪。",
    "start": 56.348,
    "end": 59.255,
    "duration": 2.907
  },
  {
    "id": 14,
    "text": "蒲松龄在小说美学上的突出突破，",
    "start": 59.255,
    "end": 62.146,
    "duration": 2.891
  },
  {
    "id": 15,
    "text": "在于彻底扭转了传统志怪小说中妖异害人的固有模式。",
    "start": 62.146,
    "end": 69.374,
    "duration": 7.228
  },
  {
    "id": 16,
    "text": "他笔下的花妖狐魅，",
    "start": 69.374,
    "end": 72.132,
    "duration": 2.758
  },
  {
    "id": 17,
    "text": "多被赋予了超越世俗人类的美好品德与纯一人性：",
    "start": 72.132,
    "end": 75.519,
    "duration": 3.387
  },
  {
    "id": 18,
    "text": "在 《婴宁》 中，狐女婴宁天真无邪、不谙世俗礼法，",
    "start": 75.519,
    "end": 79.749,
    "duration": 4.23
  },
  {
    "id": 19,
    "text": "以清脆自然的笑声对抗封建规训的窒息压抑；",
    "start": 79.749,
    "end": 83.853,
    "duration": 4.104
  },
  {
    "id": 20,
    "text": "在 《小翠》 中，狐女小翠智勇双全、谐谑机智，",
    "start": 83.853,
    "end": 87.584,
    "duration": 3.731
  },
  {
    "id": 21,
    "text": "甘愿报恩拯救痴儿公子；在 《辛十四娘》 中，",
    "start": 87.584,
    "end": 92.336,
    "duration": 4.752
  },
  {
    "id": 22,
    "text": "十四娘行善积德、深明大义。",
    "start": 92.336,
    "end": 93.698,
    "duration": 1.362
  },
  {
    "id": 23,
    "text": "这些非人类的异类女性，不仅貌美多情，",
    "start": 93.698,
    "end": 98.509,
    "duration": 4.811
  },
  {
    "id": 24,
    "text": "更具备敢于冲破世俗门第、追求独立自主的健全人格，",
    "start": 98.509,
    "end": 104.139,
    "duration": 5.63
  },
  {
    "id": 25,
    "text": "与现实人间官僚豪绅的虚伪贪婪形成了极其强烈的审美对照。",
    "start": 104.139,
    "end": 111.243,
    "duration": 7.104
  },
  {
    "id": 26,
    "text": "第二，深刻揭露封建八股科举制度的腐朽残酷，",
    "start": 111.243,
    "end": 116.531,
    "duration": 5.288
  },
  {
    "id": 27,
    "text": "展现寒门士人的精神苦难。",
    "start": 116.531,
    "end": 118.456,
    "duration": 1.925
  },
  {
    "id": 28,
    "text": "作为终生困顿于科场的下层知识分子，",
    "start": 118.456,
    "end": 122.815,
    "duration": 4.359
  },
  {
    "id": 29,
    "text": "蒲松龄对科举制度的弊端有着痛切的骨肉体会。",
    "start": 122.815,
    "end": 129.131,
    "duration": 6.316
  },
  {
    "id": 30,
    "text": "他以冷峻幽默的笔墨，",
    "start": 129.131,
    "end": 131.878,
    "duration": 2.747
  },
  {
    "id": 31,
    "text": "深刻讽刺了八股取士的荒谬与考官的不辨菽麦。",
    "start": 131.878,
    "end": 136.119,
    "duration": 4.241
  },
  {
    "id": 32,
    "text": "在 《司文郎》 中，通过盲和尚以鼻嗅文，",
    "start": 136.119,
    "end": 139.793,
    "duration": 3.674
  },
  {
    "id": 33,
    "text": "“鼻孔大衄” 于劣作、赞叹于佳文的辛辣寓言，",
    "start": 139.793,
    "end": 142.85,
    "duration": 3.057
  },
  {
    "id": 34,
    "text": "无情嘲讽了考官有眼无珠的瞎子本质；在 《王子安》 中，",
    "start": 142.85,
    "end": 148.445,
    "duration": 5.595
  },
  {
    "id": 35,
    "text": "极其生动地描摹考生入场应试的 “秀才七变”，由病鸟、",
    "start": 148.445,
    "end": 152.266,
    "duration": 3.821
  },
  {
    "id": 36,
    "text": "受刑犯人到疯癫发狂，",
    "start": 152.266,
    "end": 154.987,
    "duration": 2.721
  },
  {
    "id": 37,
    "text": "将士子在功名利禄驱使下丧失尊严的扭曲悲剧揭露得淋漓尽致。",
    "start": 154.987,
    "end": 161.499,
    "duration": 6.512
  },
  {
    "id": 38,
    "text": "第三，无情鞭挞贪官恶霸的暴虐罪恶，为底层受苦难百姓伸张正义。",
    "start": 161.499,
    "end": 168.506,
    "duration": 7.007
  },
  {
    "id": 39,
    "text": "《聊斋志异》 深刻展现了对封建专制统治压迫百姓的强烈批判。",
    "start": 168.506,
    "end": 172.029,
    "duration": 3.523
  },
  {
    "id": 40,
    "text": "在名篇 《促织》 中，以一只细微蟋蟀的进贡为线索，",
    "start": 172.029,
    "end": 174.832,
    "duration": 2.803
  },
  {
    "id": 41,
    "text": "深刻揭露了 “一人飞升，",
    "start": 174.832,
    "end": 179.256,
    "duration": 4.424
  },
  {
    "id": 42,
    "text": "仙及鸡犬” 的朝廷享乐对百姓家破人亡的血泪榨取；",
    "start": 179.256,
    "end": 182.782,
    "duration": 3.526
  },
  {
    "id": 43,
    "text": "在 《席方平》 中，席方平为其蒙冤被害的父亲鸣冤，",
    "start": 182.782,
    "end": 187.707,
    "duration": 4.925
  },
  {
    "id": 44,
    "text": "自县衙、府衙申诉至城隍、阎王乃至东岳大帝，",
    "start": 187.707,
    "end": 189.399,
    "duration": 1.692
  },
  {
    "id": 45,
    "text": "所遇神佛官吏无不贪赃枉法、上下勾结，",
    "start": 189.399,
    "end": 191.425,
    "duration": 2.026
  },
  {
    "id": 46,
    "text": "使阳间受苦的百姓在阴司同样遭受锯解油烹的残酷肉刑。",
    "start": 191.425,
    "end": 195.093,
    "duration": 3.668
  },
  {
    "id": 47,
    "text": "蒲松龄借鬼魅地狱直斥封建官场黑幕，",
    "start": 195.093,
    "end": 195.929,
    "duration": 0.836
  },
  {
    "id": 48,
    "text": "展现了强烈的批判骨力与人道主义同情。",
    "start": 195.929,
    "end": 199.049,
    "duration": 3.12
  },
  {
    "id": 49,
    "text": "第四，融合典雅文言与生动方言于一体，",
    "start": 199.049,
    "end": 202.252,
    "duration": 3.203
  },
  {
    "id": 50,
    "text": "达成“文备众体”的纯正叙事艺术。",
    "start": 202.252,
    "end": 203.587,
    "duration": 1.335
  },
  {
    "id": 51,
    "text": "在小说体式上，",
    "start": 203.587,
    "end": 207.938,
    "duration": 4.351
  },
  {
    "id": 52,
    "text": "《聊斋志异》 实现了古代文言小说语言与技巧的集大成。",
    "start": 207.938,
    "end": 211.754,
    "duration": 3.816
  },
  {
    "id": 53,
    "text": "蒲松龄在典重典雅的先秦两汉史传文言之中，",
    "start": 211.754,
    "end": 215.422,
    "duration": 3.668
  },
  {
    "id": 54,
    "text": "自然吸纳了山东淄川本土的生动俗语口吻与市井俚语；",
    "start": 215.422,
    "end": 216.867,
    "duration": 1.445
  },
  {
    "id": 55,
    "text": "其叙事结构精巧多变，心理刻画与神态白描兼备，",
    "start": 216.867,
    "end": 218.786,
    "duration": 1.919
  },
  {
    "id": 56,
    "text": "善于在现实生活细节中自然切入奇幻情节，",
    "start": 218.786,
    "end": 221.107,
    "duration": 2.321
  },
  {
    "id": 57,
    "text": "打破了现实与幻想的物理界限。",
    "start": 221.107,
    "end": 227.467,
    "duration": 6.36
  },
  {
    "id": 58,
    "text": "这部巨著不仅使古典文言小说重新焕发出旺盛的艺术生机，",
    "start": 227.467,
    "end": 231.999,
    "duration": 4.532
  },
  {
    "id": 59,
    "text": "更树立了中国古代短篇小说无法超越的美学高峰。",
    "start": 231.999,
    "end": 235.779,
    "duration": 3.78
  }
]