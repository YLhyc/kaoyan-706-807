[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 3.04,
    "duration": 2.96
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 3.04,
    "end": 6.48,
    "duration": 3.44
  },
  {
    "id": 3,
    "text": "这道题考查中国文言短篇小说巅峰《聊斋志异》。",
    "start": 6.48,
    "end": 10.64,
    "duration": 4.16
  },
  {
    "id": 4,
    "text": "在考场上，考生不能只把《聊斋》当作谈狐说鬼的故事书，",
    "start": 10.64,
    "end": 15.44,
    "duration": 4.8
  },
  {
    "id": 5,
    "text": "而必须回答出：为什么蒲松龄笔下的花妖狐魅具有打动人心的人性美，",
    "start": 15.44,
    "end": 21.12,
    "duration": 5.68
  },
  {
    "id": 6,
    "text": "以及这些虚幻故事如何承载了“刺贪刺虐”的深沉社会批判。",
    "start": 21.12,
    "end": 25.92,
    "duration": 4.8
  },
  {
    "id": 7,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 26.32,
    "end": 29.28,
    "duration": 2.96
  },
  {
    "id": 8,
    "text": "答题必须确立“形象塑造（美）趋近于现实批判（刺）趋近于叙事语言（艺）”三位一体的立体框架。",
    "start": 29.28,
    "end": 37.12,
    "duration": 7.84
  },
  {
    "id": 9,
    "text": "紧扣鲁迅“用传奇法，而以志怪”的学术定性，",
    "start": 37.12,
    "end": 40.88,
    "duration": 3.76
  },
  {
    "id": 10,
    "text": "前半部分深析花妖狐魅的人性化与理想寄托，",
    "start": 40.88,
    "end": 44.56,
    "duration": 3.68
  },
  {
    "id": 11,
    "text": "后半部分结合《促织》《席方平》《司文郎》等名篇展开政治与科举批判，",
    "start": 44.56,
    "end": 49.84,
    "duration": 5.28
  },
  {
    "id": 12,
    "text": "最后总结文言艺术高峰。",
    "start": 49.84,
    "end": 51.52,
    "duration": 1.68
  },
  {
    "id": 13,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 51.84,
    "end": 55.12,
    "duration": 3.28
  },
  {
    "id": 14,
    "text": "全题分为四个核心论述维度：第一维度：界定《聊斋志异》作为文言短篇小说集大成巅峰的历史地位；",
    "start": 55.12,
    "end": 62.96,
    "duration": 7.84
  },
  {
    "id": 15,
    "text": "第二维度：深入剖析花妖狐魅形象全面人性化、",
    "start": 62.96,
    "end": 66.96,
    "duration": 4.0
  },
  {
    "id": 16,
    "text": "寄托自由天性与人情美的塑造艺术（以婴宁、",
    "start": 66.96,
    "end": 70.56,
    "duration": 3.6
  },
  {
    "id": 17,
    "text": "小翠为例）；",
    "start": 70.56,
    "end": 71.36,
    "duration": 0.8
  },
  {
    "id": 18,
    "text": "-第三维度：深刻论述“刺贪刺虐，",
    "start": 71.44,
    "end": 74.242,
    "duration": 2.802
  },
  {
    "id": 19,
    "text": "入骨三分”的思想批判锋芒（吏治腐败与科举扼杀人才两线并进）；",
    "start": 74.242,
    "end": 80.314,
    "duration": 6.072
  },
  {
    "id": 20,
    "text": "-第四维度：精准辨析“以虚写实、",
    "start": 80.314,
    "end": 83.117,
    "duration": 2.803
  },
  {
    "id": 21,
    "text": "幻由人生”的荒诞象征造境与精炼雅洁的文言美学；",
    "start": 83.117,
    "end": 88.021,
    "duration": 4.904
  },
  {
    "id": 22,
    "text": "-第五维度：宏观总结作品在人性开掘与社会剖析上的不可替代价值。",
    "start": 88.021,
    "end": 94.56,
    "duration": 6.539
  },
  {
    "id": 23,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 94.72,
    "end": 98.4,
    "duration": 3.68
  },
  {
    "id": 24,
    "text": "全题逻辑严密咬合：第一步宏观定性，",
    "start": 98.4,
    "end": 102.24,
    "duration": 3.84
  },
  {
    "id": 25,
    "text": "确立借鬼狐言人事的根本性质。",
    "start": 102.24,
    "end": 104.96,
    "duration": 2.72
  },
  {
    "id": 26,
    "text": "第二步从最鲜明的人物切入，剖析异类形象为何比世俗更具温情人性。",
    "start": 104.96,
    "end": 111.28,
    "duration": 6.32
  },
  {
    "id": 27,
    "text": "第三步深入批判层面，揭示正是人世的贪官暴政与科举黑暗才逼迫作者遁入狐鬼异界。",
    "start": 111.28,
    "end": 119.12,
    "duration": 7.84
  },
  {
    "id": 28,
    "text": "第四步剖析承载这种思想的荒诞叙事手法与精深语言。",
    "start": 119.36,
    "end": 124.16,
    "duration": 4.8
  },
  {
    "id": 29,
    "text": "第五步完成宏观历史论证闭环。",
    "start": 124.16,
    "end": 126.96,
    "duration": 2.8
  },
  {
    "id": 30,
    "text": "二、各板块逐句咬合演练。",
    "start": 126.96,
    "end": 129.68,
    "duration": 2.72
  },
  {
    "id": 31,
    "text": "一、开头破题段内部咬合。",
    "start": 129.68,
    "end": 132.0,
    "duration": 2.32
  },
  {
    "id": 32,
    "text": "本段旨在开门见山确立集大成巅峰的立论基石。",
    "start": 132.0,
    "end": 136.16,
    "duration": 4.16
  },
  {
    "id": 33,
    "text": "首句直切经典地位，次句引用鲁迅权威定论，",
    "start": 136.16,
    "end": 140.24,
    "duration": 4.08
  },
  {
    "id": 34,
    "text": "末句开启形象与批判两翼。",
    "start": 140.24,
    "end": 142.48,
    "duration": 2.24
  },
  {
    "id": 35,
    "text": "-首先，首句必须直接亮出该书在文言小说史上的尊崇地位，",
    "start": 142.704,
    "end": 147.828,
    "duration": 5.124
  },
  {
    "id": 36,
    "text": "具体表述到答题语句就是：清代蒲松龄所著《聊斋志异》是中国文言文短篇小说的集大成巅峰之作。",
    "start": 147.828,
    "end": 156.368,
    "duration": 8.54
  },
  {
    "id": 37,
    "text": "有了经典定性之后，次句必须迅速引入鲁迅的精辟界定，",
    "start": 156.368,
    "end": 161.279,
    "duration": 4.911
  },
  {
    "id": 38,
    "text": "具体表述到答题语句就是：鲁迅在《中国小说史略》中精辟概括其“用传奇法，",
    "start": 161.279,
    "end": 167.684,
    "duration": 6.405
  },
  {
    "id": 39,
    "text": "而以志怪”，指出其虽写幽冥异类，",
    "start": 167.684,
    "end": 170.459,
    "duration": 2.775
  },
  {
    "id": 40,
    "text": "实则深刻观照现实人世。，",
    "start": 170.459,
    "end": 172.594,
    "duration": 2.135
  },
  {
    "id": 41,
    "text": "这句话将志怪形式与现实精神紧密锚定。",
    "start": 172.594,
    "end": 176.224,
    "duration": 3.63
  },
  {
    "id": 42,
    "text": "-随后，末句干脆利落地揭示孤愤寄托与答题框架，",
    "start": 176.224,
    "end": 180.245,
    "duration": 4.021
  },
  {
    "id": 43,
    "text": "具体表述到答题语句就是：全书借幻设的狐鬼花妖世界，",
    "start": 180.245,
    "end": 184.869,
    "duration": 4.624
  },
  {
    "id": 44,
    "text": "寄托作者坎坷孤愤之怀，在浪漫瑰丽的形象塑造与尖锐深刻的社会批判中熔铸出独具特色的艺术光彩。",
    "start": 184.869,
    "end": 193.514,
    "duration": 8.645
  },
  {
    "id": 45,
    "text": "清代蒲松龄所著《聊斋志异》是中国文言文短篇小说的集大成巅峰之作。",
    "start": 193.514,
    "end": 199.344,
    "duration": 5.83
  },
  {
    "id": 46,
    "text": "鲁迅在《中国小说史略》中精辟概括其“用传奇法，",
    "start": 199.424,
    "end": 203.584,
    "duration": 4.16
  },
  {
    "id": 47,
    "text": "而以志怪”，指出其虽写幽冥异类，",
    "start": 203.584,
    "end": 206.624,
    "duration": 3.04
  },
  {
    "id": 48,
    "text": "实则深刻观照现实人世。",
    "start": 206.624,
    "end": 208.864,
    "duration": 2.24
  },
  {
    "id": 49,
    "text": "全书借幻设的狐鬼花妖世界，寄托作者坎坷孤愤之怀，",
    "start": 208.864,
    "end": 213.584,
    "duration": 4.72
  },
  {
    "id": 50,
    "text": "在浪漫瑰丽的形象塑造与尖锐深刻的社会批判中熔铸出独具特色的艺术光彩。",
    "start": 213.584,
    "end": 219.424,
    "duration": 5.84
  },
  {
    "id": 51,
    "text": "二、第一维度：花妖狐魅人性化形象塑造内部咬合。",
    "start": 219.824,
    "end": 224.544,
    "duration": 4.72
  },
  {
    "id": 52,
    "text": "本段任务是深入剖析花妖狐魅的人性美，",
    "start": 224.544,
    "end": 227.904,
    "duration": 3.36
  },
  {
    "id": 53,
    "text": "调取婴宁与小翠两个经典女性形象做扎实论据。",
    "start": 227.904,
    "end": 232.064,
    "duration": 4.16
  },
  {
    "id": 54,
    "text": "首先，段首给出结论先行的分论点，",
    "start": 232.064,
    "end": 234.944,
    "duration": 2.88
  },
  {
    "id": 55,
    "text": "具体表述到答题语句就是：第一，在形象塑造艺术上，",
    "start": 234.944,
    "end": 239.344,
    "duration": 4.4
  },
  {
    "id": 56,
    "text": "作品将传统志怪中可怖怪诞的异类精魅全面人性化，",
    "start": 239.344,
    "end": 243.744,
    "duration": 4.4
  },
  {
    "id": 57,
    "text": "塑造出一批寄托理想美德与纯真人性的花妖狐魅形象。",
    "start": 243.744,
    "end": 248.224,
    "duration": 4.48
  },
  {
    "id": 58,
    "text": "-随后，引用纪晓兰评语点出文人体温与生命活力，",
    "start": 248.384,
    "end": 252.437,
    "duration": 4.053
  },
  {
    "id": 59,
    "text": "具体表述到答题语句就是：纪晓兰曾评聊斋“才子之笔，",
    "start": 252.437,
    "end": 256.896,
    "duration": 4.459
  },
  {
    "id": 60,
    "text": "非著书者之笔”，其核心正在于蒲松龄赋予狐鬼以超越世俗凡人的人情美与生命力。",
    "start": 256.896,
    "end": 263.787,
    "duration": 6.891
  },
  {
    "id": 61,
    "text": "紧接着，指出其爱情追求的纯粹性：在爱情题材中，",
    "start": 263.787,
    "end": 267.84,
    "duration": 4.053
  },
  {
    "id": 62,
    "text": "这些女性精魅不慕虚荣，不计门第，",
    "start": 267.84,
    "end": 270.677,
    "duration": 2.837
  },
  {
    "id": 63,
    "text": "主动热烈追求真挚爱情。",
    "start": 270.677,
    "end": 272.704,
    "duration": 2.027
  },
  {
    "id": 64,
    "text": "-随后，调取《婴宁》的自然淳朴与嗜笑细节：比如《婴宁》中的狐女婴宁，",
    "start": 272.76,
    "end": 278.787,
    "duration": 6.027
  },
  {
    "id": 65,
    "text": "天真烂漫，嗜笑如痴，在草木掩映的自然天地中保留了毫无机巧污浊的赤子之心，",
    "start": 278.787,
    "end": 286.437,
    "duration": 7.65
  },
  {
    "id": 66,
    "text": "成为人性自然与淳朴的化身。",
    "start": 286.437,
    "end": 289.219,
    "duration": 2.782
  },
  {
    "id": 67,
    "text": "紧接着，调取《小翠》的游戏精神与机智除奸：又如《小翠》中的狐仙小翠，",
    "start": 289.219,
    "end": 295.477,
    "duration": 6.258
  },
  {
    "id": 68,
    "text": "面对官场倾轧机智挥谐，以游戏人间的姿态巧妙惩治权奸并报答恩德。",
    "start": 295.477,
    "end": 302.2,
    "duration": 6.723
  },
  {
    "id": 69,
    "text": "-最后，收束提炼该形象群体的思想反差美，",
    "start": 302.2,
    "end": 305.763,
    "duration": 3.563
  },
  {
    "id": 70,
    "text": "具体表述到答题语句就是：这些精灵形象情真意切，",
    "start": 305.763,
    "end": 310.164,
    "duration": 4.401
  },
  {
    "id": 71,
    "text": "其高洁无私的品质与人世间虚伪冷酷的伦理道德形成鲜明反差，",
    "start": 310.164,
    "end": 315.823,
    "duration": 5.659
  },
  {
    "id": 72,
    "text": "寄寓着作者对自由天性与美好人际关系的深情向往。",
    "start": 315.823,
    "end": 320.433,
    "duration": 4.61
  },
  {
    "id": 73,
    "text": "第一，在形象塑造艺术上，作品将传统志怪中可怖怪诞的异类精魅全面人性化，",
    "start": 320.433,
    "end": 327.14,
    "duration": 6.707
  },
  {
    "id": 74,
    "text": "塑造出一批寄托理想美德与纯真人性的花妖狐魅形象。",
    "start": 327.14,
    "end": 331.96,
    "duration": 4.82
  },
  {
    "id": 75,
    "text": "纪晓兰曾评聊斋“才子之笔，非著书者之笔”，",
    "start": 332.04,
    "end": 336.04,
    "duration": 4.0
  },
  {
    "id": 76,
    "text": "其核心正在于蒲松龄赋予狐鬼以超越世俗凡人的人情美与生命力。",
    "start": 336.04,
    "end": 341.64,
    "duration": 5.6
  },
  {
    "id": 77,
    "text": "在爱情题材中，这些女性精魅不慕虚荣，",
    "start": 341.64,
    "end": 344.92,
    "duration": 3.28
  },
  {
    "id": 78,
    "text": "不计门第，主动热烈追求真挚爱情。",
    "start": 344.92,
    "end": 347.64,
    "duration": 2.72
  },
  {
    "id": 79,
    "text": "比如《婴宁》中的狐女婴宁，天真烂漫，",
    "start": 347.64,
    "end": 350.68,
    "duration": 3.04
  },
  {
    "id": 80,
    "text": "嗜笑如痴，在草木掩映的自然天地中保留了毫无机巧污浊的赤子之心，",
    "start": 350.68,
    "end": 356.52,
    "duration": 5.84
  },
  {
    "id": 81,
    "text": "成为人性自然与淳朴的化身。",
    "start": 356.52,
    "end": 358.52,
    "duration": 2.0
  },
  {
    "id": 82,
    "text": "又如《小翠》中的狐仙小翠，面对官场倾轧机智挥谐，",
    "start": 358.84,
    "end": 363.08,
    "duration": 4.24
  },
  {
    "id": 83,
    "text": "以游戏人间的姿态巧妙惩治权奸并报答恩德。",
    "start": 363.08,
    "end": 367.24,
    "duration": 4.16
  },
  {
    "id": 84,
    "text": "这些精灵形象情真意切，其高洁无私的品质与人世间虚伪冷酷的伦理道德形成鲜明反差，",
    "start": 367.24,
    "end": 375.24,
    "duration": 8.0
  },
  {
    "id": 85,
    "text": "寄寓着作者对自由天性与美好人际关系的深情向往。",
    "start": 375.24,
    "end": 379.32,
    "duration": 4.08
  },
  {
    "id": 86,
    "text": "三、第二维度：“刺贪刺虐”社会政治批判内部咬合。",
    "start": 379.64,
    "end": 383.64,
    "duration": 4.0
  },
  {
    "id": 87,
    "text": "本段任务是展开政治黑暗与科举弊端的全面批判，",
    "start": 383.64,
    "end": 387.8,
    "duration": 4.16
  },
  {
    "id": 88,
    "text": "调取《促织》《席方平》《司文郎》三大学材经典。",
    "start": 387.8,
    "end": 391.72,
    "duration": 3.92
  },
  {
    "id": 89,
    "text": "首先，段首给出统领分论点，具体表述到答题语句就是：第二，",
    "start": 391.72,
    "end": 397.16,
    "duration": 5.44
  },
  {
    "id": 90,
    "text": "在思想精神上，作品展现出强烈的现实介入品格，",
    "start": 397.16,
    "end": 401.4,
    "duration": 4.24
  },
  {
    "id": 91,
    "text": "以“刺贪刺虐，入骨三分”的批判锋芒深刻揭露了封建社会的政治黑暗与科举腐朽。",
    "start": 401.4,
    "end": 407.96,
    "duration": 6.56
  },
  {
    "id": 92,
    "text": "-随后，交代作者的平民视角与孤愤心理机制，",
    "start": 408.12,
    "end": 411.96,
    "duration": 3.84
  },
  {
    "id": 93,
    "text": "具体表述到答题语句就是：蒲松龄一生屡制科场，",
    "start": 411.96,
    "end": 416.227,
    "duration": 4.267
  },
  {
    "id": 94,
    "text": "对底层疾苦与体制罪恶具有痛彻骨髓的体察。",
    "start": 416.227,
    "end": 420.28,
    "duration": 4.053
  },
  {
    "id": 95,
    "text": "-紧接着，剖析《促织》以小见大的政治批判，",
    "start": 420.336,
    "end": 423.772,
    "duration": 3.436
  },
  {
    "id": 96,
    "text": "具体表述到答题语句就是：在揭露暴政与吏治黑暗方面，",
    "start": 423.772,
    "end": 428.712,
    "duration": 4.94
  },
  {
    "id": 97,
    "text": "《促织》堪称经典名篇。",
    "start": 428.712,
    "end": 430.43,
    "duration": 1.718
  },
  {
    "id": 98,
    "text": "作品通过成名一家因一只蟋蟀而家破人亡的悲惨遭遇，",
    "start": 430.43,
    "end": 435.37,
    "duration": 4.94
  },
  {
    "id": 99,
    "text": "以小见大，深刻剖析了“天子一跬步，",
    "start": 435.37,
    "end": 438.377,
    "duration": 3.007
  },
  {
    "id": 100,
    "text": "皆关民命”的残酷现实，将批判矛头直指荒淫享乐的最高统治集团。",
    "start": 438.377,
    "end": 444.176,
    "duration": 5.799
  },
  {
    "id": 101,
    "text": "-随后，调取《席方平》的冥界黑暗隐喻，",
    "start": 444.176,
    "end": 447.374,
    "duration": 3.198
  },
  {
    "id": 102,
    "text": "具体表述到答题语句就是：在《席方平》中，",
    "start": 447.374,
    "end": 451.029,
    "duration": 3.655
  },
  {
    "id": 103,
    "text": "作者更是描绘了一个冥界地狱从城隍、",
    "start": 451.029,
    "end": 454.684,
    "duration": 3.655
  },
  {
    "id": 104,
    "text": "郡司直至阎罗皆上下通贿、屈打良善的黑暗罗网，",
    "start": 454.684,
    "end": 459.253,
    "duration": 4.569
  },
  {
    "id": 105,
    "text": "发出“金光盖地，因使阎罗稽首”的沉痛控诉。",
    "start": 459.253,
    "end": 463.136,
    "duration": 3.883
  },
  {
    "id": 106,
    "text": "-最后，调取《司文郎》盲僧鼻嗅文章与《贾奉雉》反讽，",
    "start": 463.136,
    "end": 467.499,
    "duration": 4.363
  },
  {
    "id": 107,
    "text": "彻底打通科举批判，具体表述到答题语句就是：在批判科举制度方面，",
    "start": 467.499,
    "end": 473.928,
    "duration": 6.429
  },
  {
    "id": 108,
    "text": "《司文郎》中借盲僧用鼻子闻出文章优劣、",
    "start": 473.928,
    "end": 477.602,
    "duration": 3.674
  },
  {
    "id": 109,
    "text": "盲僧叹息“文字盲者方可中选”的荒诞寓言，",
    "start": 477.602,
    "end": 481.505,
    "duration": 3.903
  },
  {
    "id": 110,
    "text": "以及《贾奉雉》中贾生游戏作荒谬低劣之文却高中解元的反讽，",
    "start": 481.505,
    "end": 487.246,
    "duration": 5.741
  },
  {
    "id": 111,
    "text": "对是非颠倒、扼杀真才的八股取士制度进行了淋漓尽致的解剖。",
    "start": 487.246,
    "end": 493.216,
    "duration": 5.97
  },
  {
    "id": 112,
    "text": "第二，在思想精神上，作品展现出强烈的现实介入品格，",
    "start": 493.296,
    "end": 497.776,
    "duration": 4.48
  },
  {
    "id": 113,
    "text": "以“刺贪刺虐，入骨三分”的批判锋芒深刻揭露了封建社会的政治黑暗与科举腐朽。",
    "start": 497.776,
    "end": 504.416,
    "duration": 6.64
  },
  {
    "id": 114,
    "text": "蒲松龄一生屡制科场，对底层疾苦与体制罪恶具有痛彻骨髓的体察。",
    "start": 504.416,
    "end": 510.496,
    "duration": 6.08
  },
  {
    "id": 115,
    "text": "在揭露暴政与吏治黑暗方面，《促织》堪称经典名篇。",
    "start": 510.496,
    "end": 514.896,
    "duration": 4.4
  },
  {
    "id": 116,
    "text": "作品通过成名一家因一只蟋蟀而家破人亡的悲惨遭遇，",
    "start": 515.216,
    "end": 520.096,
    "duration": 4.88
  },
  {
    "id": 117,
    "text": "以小见大，深刻剖析了“天子一跬步，",
    "start": 520.096,
    "end": 523.296,
    "duration": 3.2
  },
  {
    "id": 118,
    "text": "皆关民命”的残酷现实，将批判矛头直指荒淫享乐的最高统治集团。",
    "start": 523.296,
    "end": 529.376,
    "duration": 6.08
  },
  {
    "id": 119,
    "text": "在《席方平》中，作者更是描绘了一个冥界地狱从城隍、",
    "start": 529.376,
    "end": 534.256,
    "duration": 4.88
  },
  {
    "id": 120,
    "text": "郡司直至阎罗皆上下通贿、屈打良善的黑暗罗网，",
    "start": 534.256,
    "end": 539.136,
    "duration": 4.88
  },
  {
    "id": 121,
    "text": "发出“金光盖地，因使阎罗稽首”的沉痛控诉。",
    "start": 539.136,
    "end": 543.216,
    "duration": 4.08
  },
  {
    "id": 122,
    "text": "在批判科举制度方面，《司文郎》中借盲僧用鼻子闻出文章优劣、",
    "start": 543.456,
    "end": 549.056,
    "duration": 5.6
  },
  {
    "id": 123,
    "text": "盲僧叹息“文字盲者方可中选”的荒诞寓言，",
    "start": 549.056,
    "end": 553.056,
    "duration": 4.0
  },
  {
    "id": 124,
    "text": "以及《贾奉雉》中贾生游戏作荒谬低劣之文却高中解元的反讽，",
    "start": 553.056,
    "end": 558.496,
    "duration": 5.44
  },
  {
    "id": 125,
    "text": "对是非颠倒、扼杀真才的八股取士制度进行了淋漓尽致的解剖。",
    "start": 558.496,
    "end": 563.616,
    "duration": 5.12
  },
  {
    "id": 126,
    "text": "四、第三维度：叙事机制与文言美学形态内部咬合。",
    "start": 564.016,
    "end": 568.496,
    "duration": 4.48
  },
  {
    "id": 127,
    "text": "本段任务是落脚于小说形式本体，剖析幻由人生的象征荒诞感与文言雅洁语言。",
    "start": 568.88,
    "end": 575.84,
    "duration": 6.96
  },
  {
    "id": 128,
    "text": "首先，段首给出统领分论点，具体表述到答题语句就是：第三，",
    "start": 575.84,
    "end": 581.36,
    "duration": 5.52
  },
  {
    "id": 129,
    "text": "在叙事机制与语言美学上，作品实现了“以虚写实、",
    "start": 581.36,
    "end": 585.76,
    "duration": 4.4
  },
  {
    "id": 130,
    "text": "幻由人生”的艺术造境，达到了文言小说语言精炼雅洁的最高境界。",
    "start": 585.76,
    "end": 590.8,
    "duration": 5.04
  },
  {
    "id": 131,
    "text": "-随后，解析虚实交融的叙事特征，",
    "start": 590.96,
    "end": 593.761,
    "duration": 2.801
  },
  {
    "id": 132,
    "text": "具体表述到答题语句就是：《聊斋志异》极善于打破人界与冥界、",
    "start": 593.761,
    "end": 599.146,
    "duration": 5.385
  },
  {
    "id": 133,
    "text": "现实与虚幻的时空壁障，情节离奇曲折却始终符合世情常理。",
    "start": 599.146,
    "end": 604.532,
    "duration": 5.386
  },
  {
    "id": 134,
    "text": "紧接着，举出《梦狼》的视觉震撼意象做论据，",
    "start": 604.532,
    "end": 608.194,
    "duration": 3.662
  },
  {
    "id": 135,
    "text": "具体表述到答题语句就是：比如在《梦狼》中，",
    "start": 608.194,
    "end": 611.856,
    "duration": 3.662
  },
  {
    "id": 136,
    "text": "白翁入梦见其为官之子官署内白骨如山、",
    "start": 611.856,
    "end": 615.518,
    "duration": 3.662
  },
  {
    "id": 137,
    "text": "巨狼噬人，将贪官之凶残贪婪转化为视觉震撼力极强的荒诞意象，",
    "start": 615.518,
    "end": 621.335,
    "duration": 5.817
  },
  {
    "id": 138,
    "text": "达到了寓意深刻的象征效果。",
    "start": 621.335,
    "end": 623.92,
    "duration": 2.585
  },
  {
    "id": 139,
    "text": "-最后，全面剖析蒲松龄熔铸文言散文、",
    "start": 623.92,
    "end": 627.284,
    "duration": 3.364
  },
  {
    "id": 140,
    "text": "骈力与俗语的语言神采，具体表述到答题语句就是：在语言形式上，",
    "start": 627.284,
    "end": 633.34,
    "duration": 6.056
  },
  {
    "id": 141,
    "text": "蒲松龄融铸先秦两汉散文的苍劲骨力、",
    "start": 633.34,
    "end": 636.929,
    "duration": 3.589
  },
  {
    "id": 142,
    "text": "六朝骈力的藻饰之美与唐宋传奇的流利丰神，",
    "start": 636.929,
    "end": 641.19,
    "duration": 4.261
  },
  {
    "id": 143,
    "text": "更创造性地吸收方言俗语之生动活力，",
    "start": 641.19,
    "end": 644.779,
    "duration": 3.589
  },
  {
    "id": 144,
    "text": "使叙事绘声绘色，写人神情毕现，文笔熔裁精妙。",
    "start": 644.779,
    "end": 649.04,
    "duration": 4.261
  },
  {
    "id": 145,
    "text": "第三，在叙事机制与语言美学上，作品实现了“以虚写实、",
    "start": 649.12,
    "end": 654.4,
    "duration": 5.28
  },
  {
    "id": 146,
    "text": "幻由人生”的艺术造境，达到了文言小说语言精炼雅洁的最高境界。",
    "start": 654.4,
    "end": 660.32,
    "duration": 5.92
  },
  {
    "id": 147,
    "text": "《聊斋志异》极善于打破人界与冥界、",
    "start": 660.32,
    "end": 663.36,
    "duration": 3.04
  },
  {
    "id": 148,
    "text": "现实与虚幻的时空壁障，情节离奇曲折却始终符合世情常理。",
    "start": 663.36,
    "end": 668.8,
    "duration": 5.44
  },
  {
    "id": 149,
    "text": "比如在《梦狼》中，白翁入梦见其为官之子官署内白骨如山、",
    "start": 669.04,
    "end": 673.92,
    "duration": 4.88
  },
  {
    "id": 150,
    "text": "巨狼噬人，将贪官之凶残贪婪转化为视觉震撼力极强的荒诞意象，",
    "start": 673.92,
    "end": 679.6,
    "duration": 5.68
  },
  {
    "id": 151,
    "text": "达到了寓意深刻的象征效果。",
    "start": 679.6,
    "end": 681.52,
    "duration": 1.92
  },
  {
    "id": 152,
    "text": "在语言形式上，蒲松龄融铸先秦两汉散文的苍劲骨力、",
    "start": 681.52,
    "end": 686.24,
    "duration": 4.72
  },
  {
    "id": 153,
    "text": "六朝骈力的藻饰之美与唐宋传奇的流利丰神，",
    "start": 686.24,
    "end": 690.32,
    "duration": 4.08
  },
  {
    "id": 154,
    "text": "更创造性地吸收方言俗语之生动活力，",
    "start": 690.32,
    "end": 693.2,
    "duration": 2.88
  },
  {
    "id": 155,
    "text": "使叙事绘声绘色，写人神情毕现，文笔熔裁精妙。",
    "start": 693.2,
    "end": 697.12,
    "duration": 3.92
  },
  {
    "id": 156,
    "text": "五、结尾收束升华段内部咬合。",
    "start": 697.44,
    "end": 700.24,
    "duration": 2.8
  },
  {
    "id": 157,
    "text": "本段承担全篇论证成果的系统提炼与历史定位，",
    "start": 700.24,
    "end": 704.16,
    "duration": 3.92
  },
  {
    "id": 158,
    "text": "收束在人性深度与社会广度的双重丰碑上。",
    "start": 704.16,
    "end": 707.6,
    "duration": 3.44
  },
  {
    "id": 159,
    "text": "-首先，全面回收前述借鬼写人与批判世态的成果，",
    "start": 707.808,
    "end": 711.823,
    "duration": 4.015
  },
  {
    "id": 160,
    "text": "具体表述到答题语句就是：综上所述，",
    "start": 711.823,
    "end": 714.834,
    "duration": 3.011
  },
  {
    "id": 161,
    "text": "蒲松龄《聊斋志异》借鬼狐以照现实，",
    "start": 714.834,
    "end": 717.644,
    "duration": 2.81
  },
  {
    "id": 162,
    "text": "以幽冥异境寄托孤愤与理想，以犀利笔锋解剖世态罪恶。",
    "start": 717.644,
    "end": 722.261,
    "duration": 4.617
  },
  {
    "id": 163,
    "text": "紧接着，在文言小说演进史上完成崇高升华，",
    "start": 722.261,
    "end": 725.874,
    "duration": 3.613
  },
  {
    "id": 164,
    "text": "具体表述到答题语句就是：它在人性开掘的深度、",
    "start": 725.874,
    "end": 729.889,
    "duration": 4.015
  },
  {
    "id": 165,
    "text": "社会批判的广度与文言艺术的高度上，",
    "start": 729.889,
    "end": 733.101,
    "duration": 3.212
  },
  {
    "id": 166,
    "text": "皆达到了中国文言短篇小说前所未有的峰孪，",
    "start": 733.101,
    "end": 736.915,
    "duration": 3.814
  },
  {
    "id": 167,
    "text": "成为中国文学宝库中历久弥新的光辉经典。",
    "start": 736.915,
    "end": 740.528,
    "duration": 3.613
  },
  {
    "id": 168,
    "text": "综上所述，蒲松龄《聊斋志异》借鬼狐以照现实，",
    "start": 740.608,
    "end": 744.928,
    "duration": 4.32
  },
  {
    "id": 169,
    "text": "以幽冥异境寄托孤愤与理想，以犀利笔锋解剖世态罪恶。",
    "start": 744.928,
    "end": 749.648,
    "duration": 4.72
  },
  {
    "id": 170,
    "text": "它在人性开掘的深度、社会批判的广度与文言艺术的高度上，",
    "start": 749.648,
    "end": 754.768,
    "duration": 5.12
  },
  {
    "id": 171,
    "text": "皆达到了中国文言短篇小说前所未有的峰孪，",
    "start": 754.768,
    "end": 758.688,
    "duration": 3.92
  },
  {
    "id": 172,
    "text": "成为中国文学宝库中历久弥新的光辉经典。",
    "start": 758.688,
    "end": 762.208,
    "duration": 3.52
  }
]