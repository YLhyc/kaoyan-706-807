[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "情感→意境→语言三阶一体：",
    "start": 0.0,
    "end": 3.4,
    "duration": 3.4
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先写汉末乱世下士人生命短促焦虑与游子思妇情怨，",
    "start": 3.449,
    "end": 7.849,
    "duration": 4.4
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再借《诗经》比兴造“物我浑化”含蓄境与叠字舒缓韵律，",
    "start": 8.299,
    "end": 12.339,
    "duration": 4.04
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最终沉淀为洗净汉赋僻词的“深衷浅貌”五言典范。",
    "start": 12.949,
    "end": 17.149,
    "duration": 4.2
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《古诗十九首》最早见录南朝萧统《文选》，产于东汉末动荡之际。",
    "start": 17.599,
    "end": 22.839,
    "duration": 5.24
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "刘勰《文心雕龙》称“五言之冠冕”，钟嵘《诗品》赞“惊心动魄，",
    "start": 23.369,
    "end": 28.009,
    "duration": 4.64
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "可谓几乎一字千金”。",
    "start": 28.459,
    "end": 30.219,
    "duration": 1.76
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 生命短促焦虑与游子思妇悲怨",
    "start": 30.669,
    "end": 34.109,
    "duration": 3.44
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "仕途壅塞与乱世无常中感叹时光易逝，《生年不满百》“昼短苦夜长，",
    "start": 34.559,
    "end": 40.119,
    "duration": 5.56
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "何不秉烛游”写及时行乐背后深切苦闷；",
    "start": 40.649,
    "end": 43.929,
    "duration": 3.28
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《涉江采芙蓉》道尽关山阻隔与漂泊之痛，",
    "start": 44.379,
    "end": 47.699,
    "duration": 3.32
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "标志东汉后期文人对个体生命情感的觉醒。",
    "start": 48.149,
    "end": 51.549,
    "duration": 3.4
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 文人化比兴造境与叠字回环格调",
    "start": 51.999,
    "end": 55.519,
    "duration": 3.52
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "发展《诗经》比兴，借风物造情景交融：《迢迢牵牛星》“盈盈一水间，",
    "start": 55.969,
    "end": 61.049,
    "duration": 5.08
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "脉脉不得语”借神话白描隔望苦，无一字直说离愁而自见；",
    "start": 61.499,
    "end": 66.579,
    "duration": 5.08
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "善用“行行重行行”“青青河畔草”等叠字，回环舒缓、哀而不伤。",
    "start": 67.029,
    "end": 72.509,
    "duration": 5.48
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 语言浅近精醇、形成深衷浅貌风范",
    "start": 73.039,
    "end": 77.119,
    "duration": 4.08
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "摆脱汉赋奇字僻词铺张习气，如家常絮语般平淡却浓缩厚重人生体悟；",
    "start": 77.649,
    "end": 84.089,
    "duration": 6.44
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "构成“浅浅寄言，深深道款”的深衷浅貌风格，推熟五言诗抒情力，",
    "start": 84.539,
    "end": 89.619,
    "duration": 5.08
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "成建安魏晋效法典范。",
    "start": 90.149,
    "end": 92.189,
    "duration": 2.04
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：最早见录于南朝萧统《文选》；",
    "start": 92.639,
    "end": 95.679,
    "duration": 3.04
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "刘勰称“五言之冠冕”，钟嵘赞“惊心动魄，可谓几乎一字千金”。",
    "start": 96.209,
    "end": 101.049,
    "duration": 4.84
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 最早见录何书？",
    "start": 101.499,
    "end": 103.539,
    "duration": 2.04
  },
  {
    "id": "drill0_c1",
    "dom_key": "drill0_c1",
    "text": "刘勰、钟嵘分别用哪两句话评价《古诗十九首》？",
    "start": 104.069,
    "end": 107.589,
    "duration": 3.52
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《生年不满百》《涉江采芙蓉》《迢迢牵牛星》说明主题与比兴？",
    "start": 108.039,
    "end": 114.839,
    "duration": 6.8
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 什么是“哀而不伤”与“深衷浅貌”？",
    "start": 115.369,
    "end": 118.729,
    "duration": 3.36
  },
  {
    "id": "drill2_c1",
    "dom_key": "drill2_c1",
    "text": "它对建安五言诗有何意义？",
    "start": 119.179,
    "end": 121.299,
    "duration": 2.12
  }
]