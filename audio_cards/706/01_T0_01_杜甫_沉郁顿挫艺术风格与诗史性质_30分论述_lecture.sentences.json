[
  {
    "id": 1,
    "text": "试论杜甫诗歌“沉郁顿挫”的艺术风格与“诗史”性质。",
    "start": 0.05,
    "end": 4.434,
    "duration": 4.384
  },
  {
    "id": 2,
    "text": "杜甫是中国古典诗歌现实主义传统的集大成者。",
    "start": 5.003,
    "end": 8.687,
    "duration": 3.684
  },
  {
    "id": 3,
    "text": "面对安史之乱爆发、唐王朝由盛转衰的历史剧变，杜甫秉持仁民爱物之心，",
    "start": 9.159,
    "end": 15.514,
    "duration": 6.355
  },
  {
    "id": 4,
    "text": "将个人身世之悲与国家兴亡之痛融为一体，以沉郁顿挫的美学风范与即事名篇的写实笔法，",
    "start": 15.822,
    "end": 23.59,
    "duration": 7.768
  },
  {
    "id": 5,
    "text": "真实记录了动乱年代的民生疾苦与时代心声，确立了其万代宗仰的“诗圣”地位。",
    "start": 23.854,
    "end": 30.198,
    "duration": 6.344
  },
  {
    "id": 6,
    "text": "其艺术造诣与诗史品格，主要体现在以下四个方面：",
    "start": 30.567,
    "end": 35.148,
    "duration": 4.581
  },
  {
    "id": 7,
    "text": "第一，标举“沉郁顿挫”风格特质，展现悲慨深厚的情感与起伏低回的章法。",
    "start": 35.623,
    "end": 41.438,
    "duration": 5.815
  },
  {
    "id": 8,
    "text": "“沉郁顿挫”是杜诗最核心的风格标识。",
    "start": 41.621,
    "end": 45.249,
    "duration": 3.628
  },
  {
    "id": 9,
    "text": "“沉郁”侧重思想感情的悲慨深厚，源于关怀苍生的仁者之心；",
    "start": 45.515,
    "end": 50.466,
    "duration": 4.951
  },
  {
    "id": 10,
    "text": "“顿挫”既指声调的抑扬变化，也指情感表达的波浪起伏与反复低回，",
    "start": 50.62,
    "end": 56.14,
    "duration": 5.52
  },
  {
    "id": 11,
    "text": "源于儒家中和处世心态对悲愤喷薄的节制。",
    "start": 56.315,
    "end": 61.556,
    "duration": 5.241
  },
  {
    "id": 12,
    "text": "安史动乱与抱负落空，使杜甫胸中积蓄深沉忧思，发为百折千回的诗情。",
    "start": 61.799,
    "end": 69.274,
    "duration": 7.475
  },
  {
    "id": 13,
    "text": "在《自京赴奉先县咏怀五百字》中，全诗情感四起四落：",
    "start": 69.624,
    "end": 73.377,
    "duration": 3.753
  },
  {
    "id": 14,
    "text": "先写抱负落空的郁勃，随即转向骊山行乐；",
    "start": 73.553,
    "end": 78.11,
    "duration": 4.557
  },
  {
    "id": 15,
    "text": "揭露“朱门酒肉臭，路有冻死骨”后，愤懑化为“荣枯咫尺异”的深沉叹息；",
    "start": 78.471,
    "end": 83.736,
    "duration": 5.265
  },
  {
    "id": 16,
    "text": "归家惊闻幼子饿卒，悲痛欲绝之际又转而忧念失业流民与远戍士卒，",
    "start": 84.039,
    "end": 89.673,
    "duration": 5.634
  },
  {
    "id": 17,
    "text": "意深法曲，将忧国伤时之情写得余韵无穷。",
    "start": 89.856,
    "end": 93.558,
    "duration": 3.702
  },
  {
    "id": 18,
    "text": "第二，确立“诗史”叙事传统，展现正视历史、关怀苍生的人道情怀。",
    "start": 93.847,
    "end": 99.062,
    "duration": 5.215
  },
  {
    "id": 19,
    "text": "所谓“诗史”，不仅在于据实记录安史之乱前后的时代风貌，更在于以仁者情怀写出战争浩劫中下层百姓的辛酸境遇。",
    "start": 99.467,
    "end": 109.624,
    "duration": 10.157
  },
  {
    "id": 20,
    "text": "杜甫打破盛唐诗偏重玲珑兴象的格局，以五、七言古体即事名篇，",
    "start": 109.854,
    "end": 115.369,
    "duration": 5.515
  },
  {
    "id": 21,
    "text": "着力于生活细节的真实刻画，使叙事诗具有浓郁的生活质感。",
    "start": 115.688,
    "end": 120.578,
    "duration": 4.89
  },
  {
    "id": 22,
    "text": "“三吏三别”直面征兵惨状：在《石壕吏》中，",
    "start": 120.85,
    "end": 124.116,
    "duration": 3.266
  },
  {
    "id": 23,
    "text": "诗人以客观克制的笔法记录差吏夜捉与老妇泣诉，揭露战乱对底层家庭的摧残；",
    "start": 124.325,
    "end": 131.024,
    "duration": 6.699
  },
  {
    "id": 24,
    "text": "在《茅屋为秋风所破歌》中，身处床头屋漏的困窘境遇，",
    "start": 131.222,
    "end": 136.045,
    "duration": 4.823
  },
  {
    "id": 25,
    "text": "仍迸发出“安得广厦千万间，大庇天下寒士俱欢颜”的崇高呼号，",
    "start": 136.454,
    "end": 142.153,
    "duration": 5.699
  },
  {
    "id": 26,
    "text": "使诗史兼有历史实录之真与深厚人道关怀。",
    "start": 142.568,
    "end": 146.157,
    "duration": 3.589
  },
  {
    "id": 27,
    "text": "第三，集古典律诗之大成，拓宽近体表现容量并精研声律通变。",
    "start": 146.514,
    "end": 151.51,
    "duration": 4.996
  },
  {
    "id": 28,
    "text": "杜甫对律诗体裁贡献尤著。",
    "start": 151.694,
    "end": 155.215,
    "duration": 3.521
  },
  {
    "id": 29,
    "text": "他打破早先近体诗偏于应酬咏物的狭隘格局，",
    "start": 155.399,
    "end": 159.202,
    "duration": 3.803
  },
  {
    "id": 30,
    "text": "将重大政治时事与家国悲慨引入近体，并以组诗拓展其表现幅度。",
    "start": 159.389,
    "end": 165.081,
    "duration": 5.692
  },
  {
    "id": 31,
    "text": "七律组诗《秋兴八首》将山城秋色、身世漂泊与故国之思层层推进，情思脉络绵密连贯。",
    "start": 165.198,
    "end": 172.434,
    "duration": 7.236
  },
  {
    "id": 32,
    "text": "在格律技艺上，杜甫追求“晚节渐于诗律细”，既精于字句锤炼，",
    "start": 172.664,
    "end": 177.732,
    "duration": 5.068
  },
  {
    "id": 33,
    "text": "以致刘熙载称其“少陵炼神”，又善用“拗救”与变体以求变化中的完整。",
    "start": 178.104,
    "end": 183.641,
    "duration": 5.537
  },
  {
    "id": 34,
    "text": "名作《登高》八句皆对而流转自如，将万里悲秋与百年多病融为一气，",
    "start": 183.909,
    "end": 190.147,
    "duration": 6.238
  },
  {
    "id": 35,
    "text": "胡应麟《诗薮》赞为“古今七言律第一”，足见其将律诗写得浑融流转、无迹可寻的造诣。",
    "start": 190.692,
    "end": 197.875,
    "duration": 7.183
  },
  {
    "id": 36,
    "text": "第四，承前启后开辟无数法门，奠定后世诗歌演进的宗师典范。",
    "start": 198.269,
    "end": 203.669,
    "duration": 5.4
  },
  {
    "id": 37,
    "text": "杜甫在诗歌史上具有承先启后的枢纽地位。",
    "start": 203.91,
    "end": 207.437,
    "duration": 3.527
  },
  {
    "id": 38,
    "text": "元稹盛赞其“上薄风骚，下该沈、宋，言夺苏、李，气吞曹、刘，掩颜、谢之孤高，杂徐、庾之流丽，尽得古今之体势，而兼人人之所独专矣”，",
    "start": 207.891,
    "end": 220.321,
    "duration": 12.43
  },
  {
    "id": 39,
    "text": "公允概括了其集六朝盛唐诗歌之大成的成就。",
    "start": 220.569,
    "end": 224.026,
    "duration": 3.457
  },
  {
    "id": 40,
    "text": "他对后代诗坛影响深远：中唐元白继承其缘事而发、写生民疾苦的路线，",
    "start": 224.231,
    "end": 230.611,
    "duration": 6.38
  },
  {
    "id": 41,
    "text": "韩孟诗派得力于其奇崛造语与炼字之功，宋代黄庭坚与江西诗派则奉其为宗，",
    "start": 230.796,
    "end": 237.179,
    "duration": 6.383
  },
  {
    "id": 42,
    "text": "取法其句法锤炼与老成境界，使杜甫成为历代诗坛共同推尊的典范。",
    "start": 237.366,
    "end": 242.72,
    "duration": 5.354
  },
  {
    "id": 43,
    "text": "综上所述，杜甫以儒家仁爱之心统摄沉郁顿挫诗风与即事名篇笔法，",
    "start": 243.158,
    "end": 247.749,
    "duration": 4.591
  },
  {
    "id": 44,
    "text": "把个体遭际与唐代盛衰巨变融为一体。",
    "start": 247.904,
    "end": 251.966,
    "duration": 4.062
  },
  {
    "id": 45,
    "text": "他既集六朝盛唐古近体格律之大成，又以直面民生疾苦的写实传统为中唐新乐府运动开先声，并深远影响宋代江西诗派炼字句法，",
    "start": 252.062,
    "end": 263.126,
    "duration": 11.064
  },
  {
    "id": 46,
    "text": "在中国诗歌史上树立起兼顾时代良知与艺术法度的高峰。",
    "start": 263.292,
    "end": 269.954,
    "duration": 6.662
  }
]