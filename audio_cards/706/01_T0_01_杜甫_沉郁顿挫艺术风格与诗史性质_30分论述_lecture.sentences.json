[
  {
    "id": 1,
    "text": "试论杜甫诗歌“沉郁顿挫”的艺术风格与“诗史”性质。",
    "start": 0.16,
    "end": 5.04,
    "duration": 4.88
  },
  {
    "id": 2,
    "text": "杜甫是中国古典诗歌现实主义精神的集大成者。",
    "start": 5.04,
    "end": 9.28,
    "duration": 4.24
  },
  {
    "id": 3,
    "text": "面对安史之乱爆发、唐帝国由盛转衰的历史巨变，",
    "start": 9.28,
    "end": 14.08,
    "duration": 4.8
  },
  {
    "id": 4,
    "text": "杜甫秉持仁民爱物的博大胸襟，",
    "start": 14.08,
    "end": 17.2,
    "duration": 3.12
  },
  {
    "id": 5,
    "text": "将个人身世之悲与国家兴亡之痛融为一体。",
    "start": 17.2,
    "end": 21.28,
    "duration": 4.08
  },
  {
    "id": 6,
    "text": "在创作上，他以沉郁顿挫的美学风范，",
    "start": 21.28,
    "end": 23.68,
    "duration": 2.4
  },
  {
    "id": 7,
    "text": "全面反映时代剧变与民生疾苦；以即事名篇的写实笔法，",
    "start": 23.68,
    "end": 29.04,
    "duration": 5.36
  },
  {
    "id": 8,
    "text": "生动展现一代民众的心灵受难史。",
    "start": 29.04,
    "end": 32.32,
    "duration": 3.28
  },
  {
    "id": 9,
    "text": "杜甫集六朝盛唐诗歌之大成，开中晚唐乃至两宋无数法门，",
    "start": 32.32,
    "end": 37.68,
    "duration": 5.36
  },
  {
    "id": 10,
    "text": "确立了其万代宗仰的 “诗圣” 地位。",
    "start": 37.68,
    "end": 41.52,
    "duration": 3.84
  },
  {
    "id": 11,
    "text": "其艺术造诣与诗史品格，主要展现为以下四个核心维度：",
    "start": 41.52,
    "end": 46.0,
    "duration": 4.48
  },
  {
    "id": 12,
    "text": "第一，标举“沉郁顿挫”风格特质，",
    "start": 46.0,
    "end": 49.44,
    "duration": 3.44
  },
  {
    "id": 13,
    "text": "展现思想感情的深厚沉雄与表现手法的曲折起伏。",
    "start": 49.44,
    "end": 53.36,
    "duration": 3.92
  },
  {
    "id": 14,
    "text": "“沉郁顿挫” 是杜甫诗歌最核心的风格标识。",
    "start": 53.36,
    "end": 57.52,
    "duration": 4.16
  },
  {
    "id": 15,
    "text": "“沉郁” 侧重思想内容的深沉宽广，",
    "start": 57.68,
    "end": 61.138,
    "duration": 3.458
  },
  {
    "id": 16,
    "text": "源于关怀苍生的仁者之心；",
    "start": 61.138,
    "end": 63.869,
    "duration": 2.731
  },
  {
    "id": 17,
    "text": "“顿挫” 侧重章法波澜的回环转折，",
    "start": 63.869,
    "end": 67.51,
    "duration": 3.641
  },
  {
    "id": 18,
    "text": "源于内心情感与儒家中和心态的制约。",
    "start": 67.51,
    "end": 71.379,
    "duration": 3.869
  },
  {
    "id": 19,
    "text": "安史动乱与抱负破灭，使杜甫胸中积蓄深沉忧愤，",
    "start": 71.379,
    "end": 76.385,
    "duration": 5.006
  },
  {
    "id": 20,
    "text": "通过反复低回的语流展现出来。",
    "start": 76.385,
    "end": 79.571,
    "duration": 3.186
  },
  {
    "id": 21,
    "text": "在名作 《自京赴奉先县咏怀五百字》 中，",
    "start": 79.571,
    "end": 83.44,
    "duration": 3.869
  },
  {
    "id": 22,
    "text": "全诗情感四起四落：由抱负落空的郁勃，",
    "start": 83.52,
    "end": 87.68,
    "duration": 4.16
  },
  {
    "id": 23,
    "text": "骤转入骊山行乐的批判；揭露 “朱门酒肉臭，",
    "start": 87.68,
    "end": 92.16,
    "duration": 4.48
  },
  {
    "id": 24,
    "text": "路有冻死骨” 后，愤懑化为深沉叹息；归家惊闻幼子饿卒，",
    "start": 92.16,
    "end": 98.48,
    "duration": 6.32
  },
  {
    "id": 25,
    "text": "悲痛之余笔锋复转入对更悲惨远戍卒的深切关怀。",
    "start": 98.48,
    "end": 102.96,
    "duration": 4.48
  },
  {
    "id": 26,
    "text": "刘熙载 《艺概》 评其意深而法曲，",
    "start": 103.12,
    "end": 106.16,
    "duration": 3.04
  },
  {
    "id": 27,
    "text": "达到了古典抒情艺术的极高境界。",
    "start": 106.48,
    "end": 109.6,
    "duration": 3.12
  },
  {
    "id": 28,
    "text": "第二，确立“诗史”叙事传统，展现感时伤事的深厚人道主义情怀。",
    "start": 109.76,
    "end": 116.0,
    "duration": 6.24
  },
  {
    "id": 29,
    "text": "所谓 “诗史”，其本质不仅在于据实补正史书阙载，",
    "start": 116.0,
    "end": 120.08,
    "duration": 4.08
  },
  {
    "id": 30,
    "text": "更在于以微观平民视角，",
    "start": 120.08,
    "end": 122.48,
    "duration": 2.4
  },
  {
    "id": 31,
    "text": "真实记录战争浩劫中下层百姓的心灵受难史。",
    "start": 122.48,
    "end": 127.28,
    "duration": 4.8
  },
  {
    "id": 32,
    "text": "杜甫打破盛唐诗偏于玲珑兴象的格局，开辟了即事名篇的叙事范式。",
    "start": 127.28,
    "end": 133.6,
    "duration": 6.32
  },
  {
    "id": 33,
    "text": "“三吏三别” 直面征兵惨烈真相：在 《石壕吏》 中，",
    "start": 133.6,
    "end": 138.4,
    "duration": 4.8
  },
  {
    "id": 34,
    "text": "诗人以客观克制的冷笔夜捉叙述，在拍门呼喝与老妇泣诉间，",
    "start": 138.4,
    "end": 144.64,
    "duration": 6.24
  },
  {
    "id": 35,
    "text": "深刻揭露战争对底层家庭伦理的摧残。",
    "start": 144.64,
    "end": 147.92,
    "duration": 3.28
  },
  {
    "id": 36,
    "text": "在 《茅屋为秋风所破歌》 中，面对床头屋漏的困厄，",
    "start": 147.92,
    "end": 153.576,
    "duration": 5.656
  },
  {
    "id": 37,
    "text": "依然迸发出 “安得广厦千万间，",
    "start": 153.576,
    "end": 156.696,
    "duration": 3.12
  },
  {
    "id": 38,
    "text": "大庇天下寒士俱欢颜” 的崇高呼号，",
    "start": 156.696,
    "end": 159.976,
    "duration": 3.28
  },
  {
    "id": 39,
    "text": "展现出超越时代的人道主义光辉。",
    "start": 160.216,
    "end": 163.576,
    "duration": 3.36
  },
  {
    "id": 40,
    "text": "第三，实现古典律诗之集大成，",
    "start": 163.576,
    "end": 166.296,
    "duration": 2.72
  },
  {
    "id": 41,
    "text": "达成内容拓展与形式通变的圆融境界。",
    "start": 166.296,
    "end": 169.976,
    "duration": 3.68
  },
  {
    "id": 42,
    "text": "杜甫对律诗体裁做出了极大开拓。",
    "start": 169.976,
    "end": 173.496,
    "duration": 3.52
  },
  {
    "id": 43,
    "text": "他打破齐梁以来律诗偏于应酬浮艳的狭隘格式，",
    "start": 173.576,
    "end": 178.296,
    "duration": 4.72
  },
  {
    "id": 44,
    "text": "将重大政治时事、社会现实与生民疾苦引入近体，",
    "start": 178.296,
    "end": 182.936,
    "duration": 4.64
  },
  {
    "id": 45,
    "text": "极大地扩大了律诗表现容量。",
    "start": 182.936,
    "end": 185.496,
    "duration": 2.56
  },
  {
    "id": 46,
    "text": "其七律组诗 《秋兴八首》 将身世漂泊、",
    "start": 185.736,
    "end": 189.336,
    "duration": 3.6
  },
  {
    "id": 47,
    "text": "长安旧梦与时局之忧层层递进，把组诗格局推向极境。",
    "start": 189.336,
    "end": 194.296,
    "duration": 4.96
  },
  {
    "id": 48,
    "text": "在格律技艺上，杜甫精研声病，",
    "start": 194.456,
    "end": 196.696,
    "duration": 2.24
  },
  {
    "id": 49,
    "text": "既追求 “晚节渐于诗律细” 的工稳，",
    "start": 197.016,
    "end": 201.176,
    "duration": 4.16
  },
  {
    "id": 50,
    "text": "又敢于创制 “拗救” 与变体。",
    "start": 201.176,
    "end": 203.736,
    "duration": 2.56
  },
  {
    "id": 51,
    "text": "其名作 《登高》 八句皆对，",
    "start": 203.736,
    "end": 205.736,
    "duration": 2.0
  },
  {
    "id": 52,
    "text": "将孤舟残年身世与万里悲秋江天融为一体，",
    "start": 205.736,
    "end": 209.576,
    "duration": 3.84
  },
  {
    "id": 53,
    "text": "胡应麟 《诗薮》 赞为 “古今七言律第一”，",
    "start": 209.576,
    "end": 213.416,
    "duration": 3.84
  },
  {
    "id": 54,
    "text": "标志着近体诗艺术的巅峰成熟。",
    "start": 213.416,
    "end": 216.296,
    "duration": 2.88
  },
  {
    "id": 55,
    "text": "第四，承前启后开辟无数法门，构筑影响后代诗国走向的美学渊薮。",
    "start": 216.296,
    "end": 222.616,
    "duration": 6.32
  },
  {
    "id": 56,
    "text": "杜甫在诗歌史上的地位具有枢纽意义。",
    "start": 222.616,
    "end": 226.536,
    "duration": 3.92
  },
  {
    "id": 57,
    "text": "他以深沉的社会批判精神直接启迪了中唐新乐府运动；",
    "start": 226.536,
    "end": 232.616,
    "duration": 6.08
  },
  {
    "id": 58,
    "text": "以奇崛奥衍、炼字锻句的苦心造诣开启了韩孟诗派；",
    "start": 232.616,
    "end": 237.176,
    "duration": 4.56
  },
  {
    "id": 59,
    "text": "而其点化日常、化俗为雅的理趣追求，",
    "start": 237.176,
    "end": 237.896,
    "duration": 0.72
  },
  {
    "id": 60,
    "text": "则成为宋代江西诗派与苏轼、黄庭坚立派的核心基石。",
    "start": 237.736,
    "end": 237.896,
    "duration": 0.16
  },
  {
    "id": 61,
    "text": "元稹在 《唐故工部员外郎杜君墓系铭》 中盛赞其 “上薄风骚，",
    "start": 237.736,
    "end": 237.896,
    "duration": 0.16
  },
  {
    "id": 62,
    "text": "下该沈宋，言夺苏李，气吞曹刘，奄有魏晋，",
    "start": 237.736,
    "end": 237.896,
    "duration": 0.16
  },
  {
    "id": 63,
    "text": "兼备古今之体势”，",
    "start": 237.736,
    "end": 237.896,
    "duration": 0.16
  },
  {
    "id": 64,
    "text": "公允确立了其集古典诗歌之大成的崇高地位。",
    "start": 237.736,
    "end": 237.896,
    "duration": 0.16
  }
]