[
  {
    "id": 1,
    "text": "杜甫是中国古典诗歌现实主义精神的集大成者。",
    "start": 0.1,
    "end": 4.568,
    "duration": 4.468
  },
  {
    "id": 2,
    "text": "面对安史之乱爆发，唐帝国由盛转衰的历史巨变，杜甫秉持仁民爱物的博大胸襟，将个人身世之悲与国家兴亡之痛融为一体。",
    "start": 4.518,
    "end": 16.081,
    "duration": 11.563
  },
  {
    "id": 3,
    "text": "在创作上，他以沉郁顿挫的美学风范，全面反映时代剧变与民生疾苦；以即事名篇的写实笔法，生动展现一代民众的心灵受难史。",
    "start": 16.081,
    "end": 27.943,
    "duration": 11.862
  },
  {
    "id": 4,
    "text": "杜甫集六朝盛唐诗歌之大成，开中晚唐乃至两宋无数法门，确立了其万代宗仰的 “诗圣” 地位。",
    "start": 27.943,
    "end": 36.888,
    "duration": 8.945
  },
  {
    "id": 5,
    "text": "其艺术造诣与诗史品格，主要展现为以下四个核心维度，",
    "start": 36.888,
    "end": 42.539,
    "duration": 5.651
  },
  {
    "id": 6,
    "text": "第一，标举“沉郁顿挫”风格特质，展现思想感情的深厚沉雄与表现手法的曲折起伏。",
    "start": 42.539,
    "end": 50.534,
    "duration": 7.995
  },
  {
    "id": 7,
    "text": "沉郁顿挫” 是杜甫诗歌最核心的风格标识。",
    "start": 50.534,
    "end": 54.57,
    "duration": 4.036
  },
  {
    "id": 8,
    "text": "沉郁” 侧重思想内容的深沉宽广，源于关怀苍生的仁者之心；“顿挫” 侧重章法波澜的回环转折，源于内心情感与儒家中和心态的制约。",
    "start": 54.57,
    "end": 66.927,
    "duration": 12.357
  },
  {
    "id": 9,
    "text": "安史动乱与抱负破灭，使杜甫胸中积蓄深沉忧愤，通过反复低回的语流展现出来。",
    "start": 66.927,
    "end": 74.297,
    "duration": 7.37
  },
  {
    "id": 10,
    "text": "在名作 《自京赴奉先县咏怀五百字》 中，全诗情感四起四落，由抱负落空的郁勃，骤转入骊山行乐的批判；揭露 “朱门酒肉臭，路有冻死骨” 后，愤懑化为深沉叹息；归家惊闻幼子饿卒，悲痛之余笔锋复转入对更悲惨远戍卒的深切关怀。",
    "start": 74.297,
    "end": 95.673,
    "duration": 21.376
  },
  {
    "id": 11,
    "text": "刘熙载 《艺概》 评其意深而法曲，达到了古典抒情艺术的极高境界。",
    "start": 95.673,
    "end": 101.506,
    "duration": 5.833
  },
  {
    "id": 12,
    "text": "第二，确立“诗史”叙事传统，展现感时伤事的深厚人道主义情怀。",
    "start": 101.506,
    "end": 107.886,
    "duration": 6.38
  },
  {
    "id": 13,
    "text": "所谓 “诗史”，其本质不仅在于据实补正史书阙载，更在于以微观平民视角，真实记录战争浩劫中下层百姓的心灵受难史。",
    "start": 107.886,
    "end": 119.045,
    "duration": 11.159
  },
  {
    "id": 14,
    "text": "杜甫打破盛唐诗偏于玲珑兴象的格局，开辟了即事名篇的叙事范式。",
    "start": 119.045,
    "end": 125.217,
    "duration": 6.172
  },
  {
    "id": 15,
    "text": "三吏三别” 直面征兵惨烈真相，在 《石壕吏》 中，诗人以客观克制的冷笔夜捉叙述，在拍门呼喝与老妇泣诉间，深刻揭露战争对底层家庭伦理的摧残。",
    "start": 125.217,
    "end": 138.707,
    "duration": 13.49
  },
  {
    "id": 16,
    "text": "在 《茅屋为秋风所破歌》 中，面对床头屋漏的困厄，依然迸发出 “安得广厦千万间，大庇天下寒士俱欢颜” 的崇高呼号，展现出超越时代的人道主义光辉。",
    "start": 138.707,
    "end": 152.014,
    "duration": 13.307
  },
  {
    "id": 17,
    "text": "第三，实现古典律诗之集大成，达成内容拓展与形式通变的圆融境界。",
    "start": 152.014,
    "end": 158.863,
    "duration": 6.849
  },
  {
    "id": 18,
    "text": "杜甫对律诗体裁做出了极大开拓。",
    "start": 158.863,
    "end": 162.379,
    "duration": 3.516
  },
  {
    "id": 19,
    "text": "他打破齐梁以来律诗偏于应酬浮艳的狭隘格式，将重大政治时事，社会现实与生民疾苦引入近体，极大地扩大了律诗表现容量。",
    "start": 162.379,
    "end": 174.189,
    "duration": 11.81
  },
  {
    "id": 20,
    "text": "其七律组诗 《秋兴八首》 将身世漂泊，长安旧梦与时局之忧层层递进，把组诗格局推向极境。",
    "start": 174.189,
    "end": 182.809,
    "duration": 8.62
  },
  {
    "id": 21,
    "text": "在格律技艺上，杜甫精研声病，既追求 “晚节渐于诗律细” 的工稳，又敢于创制 “拗救” 与变体。",
    "start": 182.808,
    "end": 190.855,
    "duration": 8.047
  },
  {
    "id": 22,
    "text": "其名作 《登高》 八句皆对，将孤舟残年身世与万里悲秋江天融为一体，胡应麟 《诗薮》 赞为 “古今七言律第一”，标志着近体诗艺术的巅峰成熟。",
    "start": 190.855,
    "end": 203.303,
    "duration": 12.448
  },
  {
    "id": 23,
    "text": "第四，承前启后开辟无数法门，构筑影响后代诗国走向的美学渊薮。",
    "start": 203.303,
    "end": 210.022,
    "duration": 6.719
  },
  {
    "id": 24,
    "text": "杜甫在诗歌史上的地位具有枢纽意义。",
    "start": 210.022,
    "end": 213.59,
    "duration": 3.568
  },
  {
    "id": 25,
    "text": "他以深沉的社会批判精神直接启迪了中唐新乐府运动；以奇崛奥衍，炼字锻句的苦心造诣开启了韩孟诗派；而其点化日常，化俗为雅的理趣追求，则成为宋代江西诗派与苏轼，黄庭坚立派的核心基石。",
    "start": 213.59,
    "end": 231.828,
    "duration": 18.238
  },
  {
    "id": 26,
    "text": "元稹在 《唐故工部员外郎杜君墓系铭》 中盛赞其 “上薄风骚，下该沈宋，言夺苏李，气吞曹刘，奄有魏晋，兼备古今之体势”，公允确立了其集古典诗歌之大成的崇高地位。",
    "start": 231.828,
    "end": 247.401,
    "duration": 15.573
  },
  {
    "id": 27,
    "text": "1. 这一问到底在考什么？",
    "start": 247.401,
    "end": 250.122,
    "duration": 2.721
  },
  {
    "id": 28,
    "text": "本题考查唐代社会转折期，杜甫如何以儒家仁者情怀将现实苦难转化为古典诗歌的最高美学形式。",
    "start": 250.122,
    "end": 259.171,
    "duration": 9.049
  },
  {
    "id": 29,
    "text": "考场绝不满足于孤立默写名句，必须揭示风格，叙事，格律与后世流变的内在逻辑。",
    "start": 259.171,
    "end": 267.205,
    "duration": 8.034
  },
  {
    "id": 30,
    "text": "2. 答题的总视角是什么？",
    "start": 267.205,
    "end": 269.51,
    "duration": 2.305
  },
  {
    "id": 31,
    "text": "立足袁行霈 《中国文学史》 权威定评，坚持知人论世原则。",
    "start": 269.716,
    "end": 274.77,
    "duration": 5.054
  },
  {
    "id": 32,
    "text": "从安史之乱时代转折切入，紧扣思想内容之深沉（沉郁）与艺术表现之波澜（顿挫），由内向外展开论述。",
    "start": 274.72,
    "end": 284.251,
    "duration": 9.531
  },
  {
    "id": 33,
    "text": "3. 分几个板块推进？",
    "start": 284.251,
    "end": 286.399,
    "duration": 2.148
  },
  {
    "id": 34,
    "text": "全题按照四个核心维度不可逆地推进，",
    "start": 286.4,
    "end": 289.968,
    "duration": 3.568
  },
  {
    "id": 35,
    "text": "美学风格（沉郁顿挫） $\\rightarrow$ 思想灵魂（诗史与叙事突破） $\\rightarrow$ 形式载体（律诗集大成） $\\rightarrow$ 史学流变（中唐新乐府与宋诗源头）。",
    "start": 289.968,
    "end": 306.7,
    "duration": 16.732
  },
  {
    "id": 36,
    "text": "4. 内在因果链条是什么？",
    "start": 306.699,
    "end": 309.238,
    "duration": 2.539
  },
  {
    "id": 37,
    "text": "时代剧变与儒家情怀催生了沉郁顿挫的审美特质；这一特质驱动诗人走向感时伤事的诗史叙事；诗史的广阔内容促成了律诗形式的全面突破；最终确立了其开辟后世无数法门的文学史巅峰地位。",
    "start": 309.238,
    "end": 327.32,
    "duration": 18.082
  },
  {
    "id": 38,
    "text": "首句必须直击核心地位，确立其在现实主义传统中的集大成坐标，严禁生卒年字号开场。",
    "start": 327.32,
    "end": 335.432,
    "duration": 8.112
  },
  {
    "id": 39,
    "text": "次句交代知人论世的时代历史节点，指出盛衰转折与儒家胸怀的结合。",
    "start": 335.432,
    "end": 342.502,
    "duration": 7.07
  },
  {
    "id": 40,
    "text": "第三句与第四句分别点题“沉郁顿挫”与“诗史”两大题眼。",
    "start": 342.502,
    "end": 347.958,
    "duration": 5.456
  },
  {
    "id": 41,
    "text": "第五句落到诗圣地位与四大分论点引领。",
    "start": 347.958,
    "end": 352.06,
    "duration": 4.102
  },
  {
    "id": 42,
    "text": "首句立桩，确立沉郁顿挫在杜诗中的统摄地位。",
    "start": 352.06,
    "end": 356.774,
    "duration": 4.714
  },
  {
    "id": 43,
    "text": "次句深入学术机制，严谨界定沉郁与顿挫的内涵分工。",
    "start": 356.773,
    "end": 362.099,
    "duration": 5.326
  },
  {
    "id": 44,
    "text": "第三句推导时代心理动因，说明为何不能平直抒情。",
    "start": 362.099,
    "end": 367.255,
    "duration": 5.156
  },
  {
    "id": 45,
    "text": "第四句调取核心文本 《自京赴奉先县咏怀五百字》，展开四起四落的微观肌理。",
    "start": 367.255,
    "end": 374.534,
    "duration": 7.279
  },
  {
    "id": 46,
    "text": "第五句引入刘熙载文论定评收束本段。",
    "start": 374.534,
    "end": 378.557,
    "duration": 4.023
  },
  {
    "id": 47,
    "text": "首句立桩，指出诗史性质与人道主义核心。",
    "start": 378.557,
    "end": 382.789,
    "duration": 4.232
  },
  {
    "id": 48,
    "text": "次句剖析诗史本质，点明其记录民间心灵史的独特性。",
    "start": 382.789,
    "end": 387.88,
    "duration": 5.091
  },
  {
    "id": 49,
    "text": "第三句点出文体革新，由盛唐玲珑兴象转向即事名篇。",
    "start": 387.88,
    "end": 393.336,
    "duration": 5.456
  },
  {
    "id": 50,
    "text": "第四句调取 “三吏三别” 与 《石壕吏》 进行微观细节解剖。",
    "start": 393.336,
    "end": 398.283,
    "duration": 4.947
  },
  {
    "id": 51,
    "text": "第五句以 《茅屋为秋风所破歌》 实证其超越小我的人道光辉。",
    "start": 398.283,
    "end": 403.726,
    "duration": 5.443
  },
  {
    "id": 52,
    "text": "首句立桩，界定其律诗成就的集大成坐标。",
    "start": 403.726,
    "end": 408.062,
    "duration": 4.336
  },
  {
    "id": 53,
    "text": "次句说明题材拓展与打破浮艳藩篱。",
    "start": 408.062,
    "end": 412.111,
    "duration": 4.049
  },
  {
    "id": 54,
    "text": "第三句以 《秋兴八首》 论证七律组诗的结构突破。",
    "start": 412.112,
    "end": 416.565,
    "duration": 4.453
  },
  {
    "id": 55,
    "text": "第四句阐明格律上的“诗律细”与“拗救通变”。",
    "start": 416.565,
    "end": 420.419,
    "duration": 3.854
  },
  {
    "id": 56,
    "text": "第五句以 《登高》 实证胡应麟“古今七言律第一”。",
    "start": 420.419,
    "end": 424.573,
    "duration": 4.154
  },
  {
    "id": 57,
    "text": "首句立桩，指出承前启后开辟法门。",
    "start": 424.573,
    "end": 428.271,
    "duration": 3.698
  },
  {
    "id": 58,
    "text": "次句梳理转益多师的渊源。",
    "start": 428.271,
    "end": 431.057,
    "duration": 2.786
  },
  {
    "id": 59,
    "text": "第三句论述对中唐白居易新乐府与北宋苏黄江西诗派的承继。",
    "start": 431.057,
    "end": 436.734,
    "duration": 5.677
  },
  {
    "id": 60,
    "text": "第四句引用元稹 《杜君墓系铭》 权威定评作结。",
    "start": 436.734,
    "end": 441.252,
    "duration": 4.518
  }
]