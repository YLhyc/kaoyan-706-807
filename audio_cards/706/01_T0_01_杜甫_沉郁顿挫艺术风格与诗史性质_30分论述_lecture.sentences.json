[
  {
    "id": 1,
    "text": "试论杜甫诗歌“沉郁顿挫”的艺术风格与“诗史”性质。",
    "start": 0.05,
    "end": 4.949,
    "duration": 4.899
  },
  {
    "id": 2,
    "text": "杜甫是中国古典诗歌现实主义传统的集大成者。",
    "start": 4.949,
    "end": 9.121,
    "duration": 4.172
  },
  {
    "id": 3,
    "text": "面对安史之乱爆发、唐王朝由盛转衰的历史剧变，杜甫秉持仁民爱物之心，",
    "start": 9.121,
    "end": 15.806,
    "duration": 6.685
  },
  {
    "id": 4,
    "text": "将个人身世之悲与国家兴亡之痛融为一体，以沉郁顿挫的美学风范与即事名篇的写实笔法，",
    "start": 15.806,
    "end": 23.845,
    "duration": 8.039
  },
  {
    "id": 5,
    "text": "真实记录了动乱年代的民生疾苦与时代心声，确立了其万代宗仰的“诗圣”地位。",
    "start": 23.845,
    "end": 30.544,
    "duration": 6.699
  },
  {
    "id": 6,
    "text": "其艺术造诣与诗史品格，主要体现在以下四个方面：",
    "start": 30.544,
    "end": 35.583,
    "duration": 5.039
  },
  {
    "id": 7,
    "text": "第一，标举“沉郁顿挫”风格特质，展现悲慨深厚的情感与起伏低回的章法。",
    "start": 35.583,
    "end": 41.625,
    "duration": 6.042
  },
  {
    "id": 8,
    "text": "“沉郁顿挫”是杜诗最核心的风格标识。",
    "start": 41.625,
    "end": 45.499,
    "duration": 3.874
  },
  {
    "id": 9,
    "text": "“沉郁”侧重思想感情的悲慨深厚，源于关怀苍生的仁者之心；",
    "start": 45.499,
    "end": 50.626,
    "duration": 5.127
  },
  {
    "id": 10,
    "text": "“顿挫”既指声调的抑扬变化，也指情感表达的波浪起伏与反复低回，",
    "start": 50.626,
    "end": 56.321,
    "duration": 5.695
  },
  {
    "id": 11,
    "text": "源于儒家中和处世心态对悲愤喷薄的节制。",
    "start": 56.321,
    "end": 61.662,
    "duration": 5.341
  },
  {
    "id": 12,
    "text": "安史动乱与抱负落空，使杜甫胸中积蓄深沉忧思，发为百折千回的诗情。",
    "start": 61.662,
    "end": 69.6,
    "duration": 7.938
  },
  {
    "id": 13,
    "text": "在《自京赴奉先县咏怀五百字》中，全诗情感四起四落：",
    "start": 69.6,
    "end": 73.556,
    "duration": 3.956
  },
  {
    "id": 14,
    "text": "先写抱负落空的郁勃，随即转向骊山行乐；",
    "start": 73.556,
    "end": 78.445,
    "duration": 4.889
  },
  {
    "id": 15,
    "text": "揭露“朱门酒肉臭，路有冻死骨”后，愤懑化为“荣枯咫尺异”的深沉叹息；",
    "start": 78.445,
    "end": 84.025,
    "duration": 5.58
  },
  {
    "id": 16,
    "text": "归家惊闻幼子饿卒，悲痛欲绝之际又转而忧念失业流民与远戍士卒，",
    "start": 84.025,
    "end": 89.858,
    "duration": 5.833
  },
  {
    "id": 17,
    "text": "意深法曲，将忧国伤时之情写得余韵无穷。",
    "start": 89.858,
    "end": 93.83,
    "duration": 3.972
  },
  {
    "id": 18,
    "text": "第二，确立“诗史”叙事传统，展现正视历史、关怀苍生的人道情怀。",
    "start": 93.83,
    "end": 99.434,
    "duration": 5.604
  },
  {
    "id": 19,
    "text": "所谓“诗史”，不仅在于据实记录安史之乱前后的时代风貌，更在于以仁者情怀写出战争浩劫中下层百姓的辛酸境遇。",
    "start": 99.434,
    "end": 109.851,
    "duration": 10.417
  },
  {
    "id": 20,
    "text": "杜甫打破盛唐诗偏重玲珑兴象的格局，以五、七言古体即事名篇，",
    "start": 109.851,
    "end": 115.668,
    "duration": 5.817
  },
  {
    "id": 21,
    "text": "着力于生活细节的真实刻画，使叙事诗具有浓郁的生活质感。",
    "start": 115.668,
    "end": 120.835,
    "duration": 5.167
  },
  {
    "id": 22,
    "text": "“三吏三别”直面征兵惨状：在《石壕吏》中，",
    "start": 120.835,
    "end": 124.325,
    "duration": 3.49
  },
  {
    "id": 23,
    "text": "诗人以客观克制的笔法记录差吏夜捉与老妇泣诉，揭露战乱对底层家庭的摧残；",
    "start": 124.325,
    "end": 131.224,
    "duration": 6.899
  },
  {
    "id": 24,
    "text": "在《茅屋为秋风所破歌》中，身处床头屋漏的困窘境遇，",
    "start": 131.224,
    "end": 136.274,
    "duration": 5.05
  },
  {
    "id": 25,
    "text": "仍迸发出“安得广厦千万间，大庇天下寒士俱欢颜”的崇高呼号，",
    "start": 136.274,
    "end": 142.372,
    "duration": 6.098
  },
  {
    "id": 26,
    "text": "使诗史兼有历史实录之真与深厚人道关怀。",
    "start": 142.372,
    "end": 146.494,
    "duration": 4.122
  },
  {
    "id": 27,
    "text": "第三，集古典律诗之大成，拓宽近体表现容量并精研声律通变。",
    "start": 146.494,
    "end": 151.698,
    "duration": 5.204
  },
  {
    "id": 28,
    "text": "杜甫对律诗体裁贡献尤著。",
    "start": 151.698,
    "end": 155.407,
    "duration": 3.709
  },
  {
    "id": 29,
    "text": "他打破早先近体诗偏于应酬咏物的狭隘格局，",
    "start": 155.407,
    "end": 159.389,
    "duration": 3.982
  },
  {
    "id": 30,
    "text": "将重大政治时事与家国悲慨引入近体，并以组诗拓展其表现幅度。",
    "start": 159.389,
    "end": 165.207,
    "duration": 5.818
  },
  {
    "id": 31,
    "text": "七律组诗《秋兴八首》将山城秋色、身世漂泊与故国之思层层推进，情思脉络绵密连贯。",
    "start": 165.207,
    "end": 172.656,
    "duration": 7.449
  },
  {
    "id": 32,
    "text": "在格律技艺上，杜甫追求“晚节渐于诗律细”，既精于字句锤炼，",
    "start": 172.656,
    "end": 178.077,
    "duration": 5.421
  },
  {
    "id": 33,
    "text": "以致刘熙载称其“少陵炼神”，又善用“拗救”与变体以求变化中的完整。",
    "start": 178.077,
    "end": 183.902,
    "duration": 5.825
  },
  {
    "id": 34,
    "text": "名作《登高》八句皆对而流转自如，将万里悲秋与百年多病融为一气，",
    "start": 183.902,
    "end": 190.634,
    "duration": 6.732
  },
  {
    "id": 35,
    "text": "胡应麟《诗薮》赞为“古今七言律第一”，足见其将律诗写得浑融流转、无迹可寻的造诣。",
    "start": 190.634,
    "end": 198.248,
    "duration": 7.614
  },
  {
    "id": 36,
    "text": "第四，承前启后开辟无数法门，奠定后世诗歌演进的宗师典范。",
    "start": 198.248,
    "end": 203.907,
    "duration": 5.659
  },
  {
    "id": 37,
    "text": "杜甫在诗歌史上具有承先启后的枢纽地位。",
    "start": 203.907,
    "end": 207.856,
    "duration": 3.949
  },
  {
    "id": 38,
    "text": "元稹盛赞其“上薄风骚，下该沈、宋，言夺苏、李，气吞曹、刘，掩颜、谢之孤高，杂徐、庾之流丽，尽得古今之体势，而兼人人之所独专矣”，",
    "start": 207.856,
    "end": 220.58,
    "duration": 12.724
  },
  {
    "id": 39,
    "text": "公允概括了其集六朝盛唐诗歌之大成的成就。",
    "start": 220.58,
    "end": 224.24,
    "duration": 3.66
  },
  {
    "id": 40,
    "text": "他对后代诗坛影响深远：中唐元白继承其缘事而发、写生民疾苦的路线，",
    "start": 224.24,
    "end": 230.82,
    "duration": 6.58
  },
  {
    "id": 41,
    "text": "韩孟诗派得力于其奇崛造语与炼字之功，宋代黄庭坚与江西诗派则奉其为宗，",
    "start": 230.82,
    "end": 237.38,
    "duration": 6.56
  },
  {
    "id": 42,
    "text": "取法其句法锤炼与老成境界，使杜甫成为历代诗坛共同推尊的典范。",
    "start": 237.38,
    "end": 242.912,
    "duration": 5.532
  },
  {
    "id": 43,
    "text": "综上所述，杜甫以儒家仁爱之心统摄沉郁顿挫诗风与即事名篇笔法，",
    "start": 242.912,
    "end": 248.412,
    "duration": 5.5
  },
  {
    "id": 44,
    "text": "把个体遭际与唐代盛衰巨变融为一体。",
    "start": 248.412,
    "end": 251.932,
    "duration": 3.52
  },
  {
    "id": 45,
    "text": "他既集六朝盛唐古近体格律之大成，又以直面民生疾苦的写实传统为中唐新乐府运动开先声，并深远影响宋代江西诗派炼字句法，",
    "start": 251.932,
    "end": 263.33,
    "duration": 11.398
  },
  {
    "id": 46,
    "text": "在中国诗歌史上树立起兼顾时代良知与艺术法度的高峰。",
    "start": 263.33,
    "end": 269.954,
    "duration": 6.624
  }
]