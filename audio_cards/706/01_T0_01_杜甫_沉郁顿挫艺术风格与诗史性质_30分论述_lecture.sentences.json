[
  {
    "id": 1,
    "text": "试论杜甫诗歌“沉郁顿挫”的艺术风格与“诗史”性质。",
    "start": 0.16,
    "end": 5.114,
    "duration": 4.954
  },
  {
    "id": 2,
    "text": "杜甫是中国古典诗歌现实主义传统的集大成者。",
    "start": 5.477,
    "end": 9.29,
    "duration": 3.813
  },
  {
    "id": 3,
    "text": "面对安史之乱爆发、唐王朝由盛转衰的历史剧变，",
    "start": 9.546,
    "end": 13.653,
    "duration": 4.107
  },
  {
    "id": 4,
    "text": "杜甫秉持仁民爱物之心，",
    "start": 14.012,
    "end": 16.158,
    "duration": 2.146
  },
  {
    "id": 5,
    "text": "将个人身世之悲与国家兴亡之痛融为一体，",
    "start": 16.448,
    "end": 20.199,
    "duration": 3.751
  },
  {
    "id": 6,
    "text": "以沉郁顿挫的美学风范与即事名篇的写实笔法，",
    "start": 20.518,
    "end": 24.164,
    "duration": 3.646
  },
  {
    "id": 7,
    "text": "真实记录了动乱年代的民生疾苦与时代心声，",
    "start": 24.606,
    "end": 28.053,
    "duration": 3.447
  },
  {
    "id": 8,
    "text": "确立了其万代宗仰的“诗圣”地位。",
    "start": 28.26,
    "end": 30.836,
    "duration": 2.576
  },
  {
    "id": 9,
    "text": "其艺术造诣与诗史品格，主要体现在以下四个方面：",
    "start": 31.069,
    "end": 35.159,
    "duration": 4.09
  },
  {
    "id": 10,
    "text": "第一，标举“沉郁顿挫”风格特质，",
    "start": 35.856,
    "end": 38.78,
    "duration": 2.924
  },
  {
    "id": 11,
    "text": "展现悲慨深厚的情感与起伏低回的章法。",
    "start": 39.178,
    "end": 42.675,
    "duration": 3.497
  },
  {
    "id": 12,
    "text": "“沉郁顿挫”是杜诗最核心的风格标识。",
    "start": 42.978,
    "end": 46.689,
    "duration": 3.711
  },
  {
    "id": 13,
    "text": "“沉郁”侧重思想感情的悲慨深厚，源于关怀苍生的仁者之心；",
    "start": 46.804,
    "end": 51.932,
    "duration": 5.128
  },
  {
    "id": 14,
    "text": "“顿挫”既指声调的抑扬变化，",
    "start": 52.054,
    "end": 53.733,
    "duration": 1.679
  },
  {
    "id": 15,
    "text": "也指情感表达的波浪起伏与反复低回，",
    "start": 54.076,
    "end": 57.624,
    "duration": 3.548
  },
  {
    "id": 16,
    "text": "源于儒家中和处世心态对悲愤喷薄的节制。",
    "start": 57.866,
    "end": 61.689,
    "duration": 3.823
  },
  {
    "id": 17,
    "text": "安史动乱与抱负落空，使杜甫胸中积蓄深沉忧思，",
    "start": 62.015,
    "end": 66.229,
    "duration": 4.214
  },
  {
    "id": 18,
    "text": "发为百折千回的诗情。",
    "start": 66.616,
    "end": 68.469,
    "duration": 1.853
  },
  {
    "id": 19,
    "text": "在《自京赴奉先县咏怀五百字》中，全诗情感四起四落：",
    "start": 68.785,
    "end": 73.598,
    "duration": 4.813
  },
  {
    "id": 20,
    "text": "先写抱负落空的郁勃，随即转向骊山行乐；揭露“朱门酒肉臭，",
    "start": 73.892,
    "end": 79.275,
    "duration": 5.383
  },
  {
    "id": 21,
    "text": "路有冻死骨”后，愤懑化为“荣枯咫尺异”的深沉叹息；",
    "start": 79.542,
    "end": 84.293,
    "duration": 4.751
  },
  {
    "id": 22,
    "text": "归家惊闻幼子饿卒，",
    "start": 84.577,
    "end": 86.333,
    "duration": 1.756
  },
  {
    "id": 23,
    "text": "悲痛欲绝之际又转而忧念失业流民与远戍士卒，意深法曲，",
    "start": 86.607,
    "end": 92.012,
    "duration": 5.405
  },
  {
    "id": 24,
    "text": "将忧国伤时之情写得余韵无穷。",
    "start": 92.367,
    "end": 95.113,
    "duration": 2.746
  },
  {
    "id": 25,
    "text": "第二，确立“诗史”叙事传统，展现正视历史、",
    "start": 95.747,
    "end": 99.689,
    "duration": 3.942
  },
  {
    "id": 26,
    "text": "关怀苍生的人道情怀。",
    "start": 100.031,
    "end": 101.703,
    "duration": 1.672
  },
  {
    "id": 27,
    "text": "所谓“诗史”，不仅在于据实记录安史之乱前后的时代风貌，",
    "start": 101.949,
    "end": 106.472,
    "duration": 4.523
  },
  {
    "id": 28,
    "text": "更在于以仁者情怀写出战争浩劫中下层百姓的辛酸境遇。",
    "start": 106.899,
    "end": 112.116,
    "duration": 5.217
  },
  {
    "id": 29,
    "text": "杜甫打破盛唐诗偏重玲珑兴象的格局，以五、",
    "start": 112.227,
    "end": 116.272,
    "duration": 4.045
  },
  {
    "id": 30,
    "text": "七言古体即事名篇，着力于生活细节的真实刻画，",
    "start": 116.385,
    "end": 120.327,
    "duration": 3.942
  },
  {
    "id": 31,
    "text": "使叙事诗具有浓郁的生活质感。",
    "start": 120.694,
    "end": 122.934,
    "duration": 2.24
  },
  {
    "id": 32,
    "text": "“三吏三别”直面征兵惨状：在《石壕吏》中，",
    "start": 123.244,
    "end": 126.618,
    "duration": 3.374
  },
  {
    "id": 33,
    "text": "诗人以客观克制的笔法记录差吏夜捉与老妇泣诉，",
    "start": 126.817,
    "end": 130.869,
    "duration": 4.052
  },
  {
    "id": 34,
    "text": "揭露战乱对底层家庭的摧残；在《茅屋为秋风所破歌》中，",
    "start": 131.259,
    "end": 135.582,
    "duration": 4.323
  },
  {
    "id": 35,
    "text": "身处床头屋漏的困窘境遇，仍迸发出“安得广厦千万间，",
    "start": 135.81,
    "end": 140.795,
    "duration": 4.985
  },
  {
    "id": 36,
    "text": "大庇天下寒士俱欢颜”的崇高呼号，",
    "start": 141.09,
    "end": 143.739,
    "duration": 2.649
  },
  {
    "id": 37,
    "text": "使诗史兼有历史实录之真与深厚人道关怀。",
    "start": 144.088,
    "end": 147.863,
    "duration": 3.775
  },
  {
    "id": 38,
    "text": "第三，集古典律诗之大成，拓宽近体表现容量并精研声律通变。",
    "start": 148.53,
    "end": 154.323,
    "duration": 5.793
  },
  {
    "id": 39,
    "text": "杜甫对律诗体裁贡献尤著。",
    "start": 154.585,
    "end": 156.636,
    "duration": 2.051
  },
  {
    "id": 40,
    "text": "他打破齐梁以来律诗偏于应酬咏物的狭隘格局，",
    "start": 157.182,
    "end": 160.552,
    "duration": 3.37
  },
  {
    "id": 41,
    "text": "将重大政治时事与家国悲慨引入近体，",
    "start": 161.071,
    "end": 164.269,
    "duration": 3.198
  },
  {
    "id": 42,
    "text": "并以组诗拓展其表现幅度。",
    "start": 164.745,
    "end": 166.618,
    "duration": 1.873
  },
  {
    "id": 43,
    "text": "七律组诗《秋兴八首》将山城秋色、",
    "start": 167.287,
    "end": 170.216,
    "duration": 2.929
  },
  {
    "id": 44,
    "text": "身世漂泊与故国之思层层推进，情思脉络绵密连贯。",
    "start": 170.441,
    "end": 175.16,
    "duration": 4.719
  },
  {
    "id": 45,
    "text": "在格律技艺上，杜甫追求“晚节渐于诗律细”，",
    "start": 175.608,
    "end": 179.31,
    "duration": 3.702
  },
  {
    "id": 46,
    "text": "既精于字句锤炼，以致刘熙载称其“少陵炼神”，",
    "start": 179.611,
    "end": 183.454,
    "duration": 3.843
  },
  {
    "id": 47,
    "text": "又善用“拗救”与变体以求变化中的完整。",
    "start": 183.909,
    "end": 186.99,
    "duration": 3.081
  },
  {
    "id": 48,
    "text": "名作《登高》八句皆对而流转自如，",
    "start": 187.407,
    "end": 190.061,
    "duration": 2.654
  },
  {
    "id": 49,
    "text": "将万里悲秋与百年多病融为一气，",
    "start": 190.37,
    "end": 193.117,
    "duration": 2.747
  },
  {
    "id": 50,
    "text": "胡应麟《诗薮》赞为“古今七言律第一”，",
    "start": 193.402,
    "end": 196.633,
    "duration": 3.231
  },
  {
    "id": 51,
    "text": "足见其将律诗写得浑融流转、无迹可寻的造诣。",
    "start": 196.911,
    "end": 200.748,
    "duration": 3.837
  },
  {
    "id": 52,
    "text": "第四，承前启后开辟无数法门，奠定后世诗歌演进的宗师典范。",
    "start": 201.386,
    "end": 207.417,
    "duration": 6.031
  },
  {
    "id": 53,
    "text": "杜甫在诗歌史上具有承先启后的枢纽地位。",
    "start": 207.801,
    "end": 211.075,
    "duration": 3.274
  },
  {
    "id": 54,
    "text": "元稹在《唐故检校工部员外郎杜君墓系铭并序》中盛赞其“上薄风骚，",
    "start": 211.379,
    "end": 218.276,
    "duration": 6.897
  },
  {
    "id": 55,
    "text": "下该沈、宋，言夺苏、李，气吞曹、刘，掩颜、谢之孤高，",
    "start": 218.608,
    "end": 224.028,
    "duration": 5.42
  },
  {
    "id": 56,
    "text": "杂徐、庾之流丽，尽得古今之体势，而兼人人之所独专矣”，",
    "start": 224.268,
    "end": 229.732,
    "duration": 5.464
  },
  {
    "id": 57,
    "text": "公允概括了其集六朝盛唐诗歌之大成的成就。",
    "start": 230.066,
    "end": 233.446,
    "duration": 3.38
  },
  {
    "id": 58,
    "text": "他对后代诗坛影响深远：中唐元白继承其缘事而发、",
    "start": 233.746,
    "end": 238.036,
    "duration": 4.29
  },
  {
    "id": 59,
    "text": "写生民疾苦的路线，韩孟诗派得力于其奇崛造语与炼字之功，",
    "start": 238.27,
    "end": 243.393,
    "duration": 5.123
  },
  {
    "id": 60,
    "text": "宋代黄庭坚与江西诗派则奉其为宗，",
    "start": 243.619,
    "end": 246.882,
    "duration": 3.263
  },
  {
    "id": 61,
    "text": "取法其句法锤炼与老成境界，",
    "start": 247.201,
    "end": 249.943,
    "duration": 2.742
  },
  {
    "id": 62,
    "text": "使杜甫成为历代诗坛共同推尊的典范。",
    "start": 250.364,
    "end": 253.382,
    "duration": 3.018
  }
]