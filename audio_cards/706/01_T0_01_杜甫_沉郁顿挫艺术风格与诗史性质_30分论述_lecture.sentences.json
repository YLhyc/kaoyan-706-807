[
  {
    "id": 1,
    "text": "试论杜甫诗歌“沉郁顿挫”的艺术风格与“诗史”性质。",
    "start": 0.05,
    "end": 4.424,
    "duration": 4.374
  },
  {
    "id": 2,
    "text": "杜甫是中国古典诗歌现实主义传统的集大成者。",
    "start": 5.003,
    "end": 8.677,
    "duration": 3.674
  },
  {
    "id": 3,
    "text": "面对安史之乱爆发、唐王朝由盛转衰的历史剧变，杜甫秉持仁民爱物之心，",
    "start": 9.177,
    "end": 15.532,
    "duration": 6.355
  },
  {
    "id": 4,
    "text": "将个人身世之悲与国家兴亡之痛融为一体，以沉郁顿挫的美学风范与即事名篇的写实笔法，",
    "start": 15.882,
    "end": 23.63,
    "duration": 7.748
  },
  {
    "id": 5,
    "text": "真实记录了动乱年代的民生疾苦与时代心声，确立了其万代宗仰的“诗圣”地位。",
    "start": 23.98,
    "end": 30.294,
    "duration": 6.314
  },
  {
    "id": 6,
    "text": "其艺术造诣与诗史品格，主要体现在以下四个方面：",
    "start": 30.794,
    "end": 35.365,
    "duration": 4.571
  },
  {
    "id": 7,
    "text": "第一，标举“沉郁顿挫”风格特质，展现悲慨深厚的情感与起伏低回的章法。",
    "start": 35.85,
    "end": 41.665,
    "duration": 5.815
  },
  {
    "id": 8,
    "text": "“沉郁顿挫”是杜诗最核心的风格标识。",
    "start": 42.165,
    "end": 45.783,
    "duration": 3.618
  },
  {
    "id": 9,
    "text": "“沉郁”侧重思想感情的悲慨深厚，源于关怀苍生的仁者之心；",
    "start": 46.283,
    "end": 51.234,
    "duration": 4.951
  },
  {
    "id": 10,
    "text": "“顿挫”既指声调的抑扬变化，也指情感表达的波浪起伏与反复低回，",
    "start": 51.734,
    "end": 57.244,
    "duration": 5.51
  },
  {
    "id": 11,
    "text": "源于儒家中和处世心态对悲愤喷薄的节制。",
    "start": 57.594,
    "end": 62.815,
    "duration": 5.221
  },
  {
    "id": 12,
    "text": "安史动乱与抱负落空，使杜甫胸中积蓄深沉忧思，发为百折千回的诗情。",
    "start": 63.315,
    "end": 70.78,
    "duration": 7.465
  },
  {
    "id": 13,
    "text": "在《自京赴奉先县咏怀五百字》中，全诗情感四起四落：",
    "start": 71.28,
    "end": 75.013,
    "duration": 3.733
  },
  {
    "id": 14,
    "text": "先写抱负落空的郁勃，随即转向骊山行乐；",
    "start": 75.363,
    "end": 79.91,
    "duration": 4.547
  },
  {
    "id": 15,
    "text": "揭露“朱门酒肉臭，路有冻死骨”后，愤懑化为“荣枯咫尺异”的深沉叹息；",
    "start": 80.41,
    "end": 85.645,
    "duration": 5.235
  },
  {
    "id": 16,
    "text": "归家惊闻幼子饿卒，悲痛欲绝之际又转而忧念失业流民与远戍士卒，",
    "start": 86.145,
    "end": 91.749,
    "duration": 5.604
  },
  {
    "id": 17,
    "text": "意深法曲，将忧国伤时之情写得余韵无穷。",
    "start": 92.099,
    "end": 95.791,
    "duration": 3.692
  },
  {
    "id": 18,
    "text": "第二，确立“诗史”叙事传统，展现正视历史、关怀苍生的人道情怀。",
    "start": 96.291,
    "end": 101.496,
    "duration": 5.205
  },
  {
    "id": 19,
    "text": "所谓“诗史”，不仅在于据实记录安史之乱前后的时代风貌，更在于以仁者情怀写出战争浩劫中下层百姓的辛酸境遇。",
    "start": 101.996,
    "end": 112.123,
    "duration": 10.127
  },
  {
    "id": 20,
    "text": "杜甫打破盛唐诗偏重玲珑兴象的格局，以五、七言古体即事名篇，",
    "start": 112.623,
    "end": 118.118,
    "duration": 5.495
  },
  {
    "id": 21,
    "text": "着力于生活细节的真实刻画，使叙事诗具有浓郁的生活质感。",
    "start": 118.468,
    "end": 123.348,
    "duration": 4.88
  },
  {
    "id": 22,
    "text": "“三吏三别”直面征兵惨状：",
    "start": 123.848,
    "end": 126.108,
    "duration": 2.26
  },
  {
    "id": 23,
    "text": "在《石壕吏》中，诗人以客观克制的笔法记录差吏夜捉与老妇泣诉，揭露战乱对底层家庭的摧残；",
    "start": 126.458,
    "end": 134.176,
    "duration": 7.718
  },
  {
    "id": 24,
    "text": "在《茅屋为秋风所破歌》中，身处床头屋漏的困窘境遇，",
    "start": 134.676,
    "end": 139.489,
    "duration": 4.813
  },
  {
    "id": 25,
    "text": "仍迸发出“安得广厦千万间，大庇天下寒士俱欢颜”的崇高呼号，",
    "start": 139.928,
    "end": 145.597,
    "duration": 5.669
  },
  {
    "id": 26,
    "text": "使诗史兼有历史实录之真与深厚人道关怀。",
    "start": 146.022,
    "end": 149.611,
    "duration": 3.589
  },
  {
    "id": 27,
    "text": "第三，集古典律诗之大成，拓宽近体表现容量并精研声律通变。",
    "start": 150.111,
    "end": 155.107,
    "duration": 4.996
  },
  {
    "id": 28,
    "text": "杜甫对律诗体裁贡献尤著。",
    "start": 155.607,
    "end": 159.098,
    "duration": 3.491
  },
  {
    "id": 29,
    "text": "他打破早先近体诗偏于应酬咏物的狭隘格局，",
    "start": 159.598,
    "end": 163.371,
    "duration": 3.773
  },
  {
    "id": 30,
    "text": "将重大政治时事与家国悲慨引入近体，并以组诗拓展其表现幅度。",
    "start": 163.721,
    "end": 169.393,
    "duration": 5.672
  },
  {
    "id": 31,
    "text": "七律组诗《秋兴八首》将山城秋色、身世漂泊与故国之思层层推进，情思脉络绵密连贯。",
    "start": 169.893,
    "end": 177.119,
    "duration": 7.226
  },
  {
    "id": 32,
    "text": "在格律技艺上，杜甫追求“晚节渐于诗律细”，既精于字句锤炼，",
    "start": 177.619,
    "end": 182.677,
    "duration": 5.058
  },
  {
    "id": 33,
    "text": "以致刘熙载称其“少陵炼神”，又善用“拗救”与变体以求变化中的完整。",
    "start": 183.079,
    "end": 188.596,
    "duration": 5.517
  },
  {
    "id": 34,
    "text": "名作《登高》八句皆对而流转自如，将万里悲秋与百年多病融为一气，",
    "start": 189.096,
    "end": 195.334,
    "duration": 6.238
  },
  {
    "id": 35,
    "text": "胡应麟《诗薮》赞为“古今七言律第一”，足见其将律诗写得浑融流转、无迹可寻的造诣。",
    "start": 195.879,
    "end": 203.052,
    "duration": 7.173
  },
  {
    "id": 36,
    "text": "第四，承前启后开辟无数法门，奠定后世诗歌演进的宗师典范。",
    "start": 203.552,
    "end": 208.922,
    "duration": 5.37
  },
  {
    "id": 37,
    "text": "杜甫在诗歌史上具有承先启后的枢纽地位。",
    "start": 209.422,
    "end": 212.919,
    "duration": 3.497
  },
  {
    "id": 38,
    "text": "元稹盛赞其“上薄风骚，下该沈、宋，言夺苏、李，气吞曹、刘，掩颜、谢之孤高，杂徐、庾之流丽，尽得古今之体势，而兼人人之所独专矣”，",
    "start": 213.419,
    "end": 225.849,
    "duration": 12.43
  },
  {
    "id": 39,
    "text": "公允概括了其集六朝盛唐诗歌之大成的成就。",
    "start": 226.199,
    "end": 229.656,
    "duration": 3.457
  },
  {
    "id": 40,
    "text": "他对后代诗坛影响深远：中唐元白继承其缘事而发、写生民疾苦的路线，",
    "start": 230.156,
    "end": 236.536,
    "duration": 6.38
  },
  {
    "id": 41,
    "text": "韩孟诗派得力于其奇崛造语与炼字之功，宋代黄庭坚与江西诗派则奉其为宗，",
    "start": 236.886,
    "end": 243.239,
    "duration": 6.353
  },
  {
    "id": 42,
    "text": "取法其句法锤炼与老成境界，使杜甫成为历代诗坛共同推尊的典范。",
    "start": 243.589,
    "end": 248.943,
    "duration": 5.354
  },
  {
    "id": 43,
    "text": "综上所述，杜甫以儒家仁爱之心统摄沉郁顿挫诗风与即事名篇笔法，",
    "start": 249.443,
    "end": 254.014,
    "duration": 4.571
  },
  {
    "id": 44,
    "text": "把个体遭际与唐代盛衰巨变融为一体。",
    "start": 254.364,
    "end": 258.406,
    "duration": 4.042
  },
  {
    "id": 45,
    "text": "他既集六朝盛唐古近体格律之大成，又以直面民生疾苦的写实传统为中唐新乐府运动开先声，并深远影响宋代江西诗派炼字句法，",
    "start": 258.906,
    "end": 269.96,
    "duration": 11.054
  },
  {
    "id": 46,
    "text": "在中国诗歌史上树立起兼顾时代良知与艺术法度的高峰。",
    "start": 270.31,
    "end": 276.972,
    "duration": 6.662
  }
]
