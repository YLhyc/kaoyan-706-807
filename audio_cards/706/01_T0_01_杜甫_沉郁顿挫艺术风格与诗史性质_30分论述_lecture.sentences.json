[
  {
    "id": 1,
    "text": "试论杜甫诗歌“沉郁顿挫”的艺术风格与“诗史”性质。",
    "start": 0.079,
    "end": 4.541,
    "duration": 4.462
  },
  {
    "id": 2,
    "text": "杜甫是中国古典诗歌现实主义精神的集大成者。",
    "start": 4.934,
    "end": 8.716,
    "duration": 3.782
  },
  {
    "id": 3,
    "text": "面对安史之乱爆发、唐帝国由盛转衰的历史巨变，",
    "start": 9.156,
    "end": 13.322,
    "duration": 4.166
  },
  {
    "id": 4,
    "text": "杜甫秉持仁民爱物的博大胸襟，",
    "start": 13.514,
    "end": 16.356,
    "duration": 2.842
  },
  {
    "id": 5,
    "text": "将个人身世之悲与国家兴亡之痛融为一体。",
    "start": 16.568,
    "end": 19.992,
    "duration": 3.424
  },
  {
    "id": 6,
    "text": "在创作上，他以沉郁顿挫的美学风范，",
    "start": 20.192,
    "end": 23.006,
    "duration": 2.814
  },
  {
    "id": 7,
    "text": "全面反映时代剧变与民生疾苦；以即事名篇的写实笔法，",
    "start": 23.177,
    "end": 27.97,
    "duration": 4.793
  },
  {
    "id": 8,
    "text": "生动展现一代民众的心灵受难史。",
    "start": 28.21,
    "end": 30.718,
    "duration": 2.508
  },
  {
    "id": 9,
    "text": "杜甫集六朝盛唐诗歌之大成，开中晚唐乃至两宋无数法门，",
    "start": 31.19,
    "end": 36.091,
    "duration": 4.901
  },
  {
    "id": 10,
    "text": "确立了其万代宗仰的 “诗圣” 地位。",
    "start": 36.401,
    "end": 38.823,
    "duration": 2.422
  },
  {
    "id": 11,
    "text": "其艺术造诣与诗史品格，主要展现为以下四个核心维度：",
    "start": 39.059,
    "end": 43.726,
    "duration": 4.667
  },
  {
    "id": 12,
    "text": "第一，标举“沉郁顿挫”风格特质，",
    "start": 43.946,
    "end": 46.583,
    "duration": 2.637
  },
  {
    "id": 13,
    "text": "展现思想感情的深厚沉雄与表现手法的曲折起伏。",
    "start": 46.751,
    "end": 51.006,
    "duration": 4.255
  },
  {
    "id": 14,
    "text": "“沉郁顿挫” 是杜甫诗歌最核心的风格标识。",
    "start": 51.247,
    "end": 54.62,
    "duration": 3.373
  },
  {
    "id": 15,
    "text": "“沉郁” 侧重思想内容的深沉宽广，",
    "start": 54.846,
    "end": 57.572,
    "duration": 2.726
  },
  {
    "id": 16,
    "text": "源于关怀苍生的仁者之心；",
    "start": 57.707,
    "end": 59.87,
    "duration": 2.163
  },
  {
    "id": 17,
    "text": "“顿挫” 侧重章法波澜的回环转折，",
    "start": 60.098,
    "end": 62.796,
    "duration": 2.698
  },
  {
    "id": 18,
    "text": "源于内心情感与儒家中和心态的制约。",
    "start": 63.118,
    "end": 66.13,
    "duration": 3.012
  },
  {
    "id": 19,
    "text": "安史动乱与抱负破灭，使杜甫胸中积蓄深沉忧愤，",
    "start": 66.755,
    "end": 70.942,
    "duration": 4.187
  },
  {
    "id": 20,
    "text": "通过反复低回的语流展现出来。",
    "start": 71.217,
    "end": 73.476,
    "duration": 2.259
  },
  {
    "id": 21,
    "text": "在名作 《自京赴奉先县咏怀五百字》 中，",
    "start": 73.866,
    "end": 77.415,
    "duration": 3.549
  },
  {
    "id": 22,
    "text": "全诗情感四起四落：由抱负落空的郁勃，",
    "start": 77.696,
    "end": 81.261,
    "duration": 3.565
  },
  {
    "id": 23,
    "text": "骤转入骊山行乐的批判；揭露 “朱门酒肉臭，",
    "start": 81.514,
    "end": 85.053,
    "duration": 3.539
  },
  {
    "id": 24,
    "text": "路有冻死骨” 后，愤懑化为深沉叹息；归家惊闻幼子饿卒，",
    "start": 85.191,
    "end": 90.307,
    "duration": 5.116
  },
  {
    "id": 25,
    "text": "悲痛之余笔锋复转入对更悲惨远戍卒的深切关怀。",
    "start": 90.399,
    "end": 95.797,
    "duration": 5.398
  },
  {
    "id": 26,
    "text": "刘熙载 《艺概》 评其意深而法曲，",
    "start": 95.843,
    "end": 98.132,
    "duration": 2.289
  },
  {
    "id": 27,
    "text": "达到了古典抒情艺术的极高境界。",
    "start": 98.182,
    "end": 100.703,
    "duration": 2.521
  },
  {
    "id": 28,
    "text": "第二，确立“诗史”叙事传统，展现感时伤事的深厚人道主义情怀。",
    "start": 100.915,
    "end": 106.239,
    "duration": 5.324
  },
  {
    "id": 29,
    "text": "所谓 “诗史”，其本质不仅在于据实补正史书阙载，",
    "start": 106.415,
    "end": 110.471,
    "duration": 4.056
  },
  {
    "id": 30,
    "text": "更在于以微观平民视角，",
    "start": 110.839,
    "end": 112.926,
    "duration": 2.087
  },
  {
    "id": 31,
    "text": "真实记录战争浩劫中下层百姓的心灵受难史。",
    "start": 113.018,
    "end": 116.559,
    "duration": 3.541
  },
  {
    "id": 32,
    "text": "杜甫打破盛唐诗偏于玲珑兴象的格局，开辟了即事名篇的叙事范式。",
    "start": 117.075,
    "end": 122.872,
    "duration": 5.797
  },
  {
    "id": 33,
    "text": "“三吏三别” 直面征兵惨烈真相：在 《石壕吏》 中，",
    "start": 123.116,
    "end": 126.926,
    "duration": 3.81
  },
  {
    "id": 34,
    "text": "诗人以客观克制的冷笔夜捉叙述，在拍门呼喝与老妇泣诉间，",
    "start": 127.114,
    "end": 132.306,
    "duration": 5.192
  },
  {
    "id": 35,
    "text": "深刻揭露战争对底层家庭伦理的摧残。",
    "start": 132.57,
    "end": 135.328,
    "duration": 2.758
  },
  {
    "id": 36,
    "text": "在 《茅屋为秋风所破歌》 中，面对床头屋漏的困厄，",
    "start": 135.547,
    "end": 139.524,
    "duration": 3.977
  },
  {
    "id": 37,
    "text": "依然迸发出 “安得广厦千万间，",
    "start": 139.784,
    "end": 142.478,
    "duration": 2.694
  },
  {
    "id": 38,
    "text": "大庇天下寒士俱欢颜” 的崇高呼号，",
    "start": 142.826,
    "end": 145.569,
    "duration": 2.743
  },
  {
    "id": 39,
    "text": "展现出超越时代的人道主义光辉。",
    "start": 145.887,
    "end": 148.382,
    "duration": 2.495
  },
  {
    "id": 40,
    "text": "第三，实现古典律诗之集大成，",
    "start": 148.635,
    "end": 151.573,
    "duration": 2.938
  },
  {
    "id": 41,
    "text": "达成内容拓展与形式通变的圆融境界。",
    "start": 152.027,
    "end": 154.901,
    "duration": 2.874
  },
  {
    "id": 42,
    "text": "杜甫对律诗体裁做出了极大开拓。",
    "start": 155.514,
    "end": 157.926,
    "duration": 2.412
  },
  {
    "id": 43,
    "text": "他打破齐梁以来律诗偏于应酬浮艳的狭隘格式，",
    "start": 158.278,
    "end": 162.751,
    "duration": 4.473
  },
  {
    "id": 44,
    "text": "将重大政治时事、社会现实与生民疾苦引入近体，",
    "start": 162.828,
    "end": 166.718,
    "duration": 3.89
  },
  {
    "id": 45,
    "text": "极大地扩大了律诗表现容量。",
    "start": 166.961,
    "end": 169.159,
    "duration": 2.198
  },
  {
    "id": 46,
    "text": "其七律组诗 《秋兴八首》 将身世漂泊、",
    "start": 169.356,
    "end": 172.573,
    "duration": 3.217
  },
  {
    "id": 47,
    "text": "长安旧梦与时局之忧层层递进，把组诗格局推向极境。",
    "start": 172.713,
    "end": 177.914,
    "duration": 5.201
  },
  {
    "id": 48,
    "text": "在格律技艺上，杜甫精研声病，",
    "start": 178.165,
    "end": 180.524,
    "duration": 2.359
  },
  {
    "id": 49,
    "text": "既追求 “晚节渐于诗律细” 的工稳，",
    "start": 180.785,
    "end": 183.287,
    "duration": 2.502
  },
  {
    "id": 50,
    "text": "又敢于创制 “拗救” 与变体。",
    "start": 183.455,
    "end": 185.553,
    "duration": 2.098
  },
  {
    "id": 51,
    "text": "其名作 《登高》 八句皆对，",
    "start": 185.777,
    "end": 187.554,
    "duration": 1.777
  },
  {
    "id": 52,
    "text": "将孤舟残年身世与万里悲秋江天融为一体，",
    "start": 187.742,
    "end": 191.235,
    "duration": 3.493
  },
  {
    "id": 53,
    "text": "胡应麟 《诗薮》 赞为 “古今七言律第一”，",
    "start": 191.43,
    "end": 194.351,
    "duration": 2.921
  },
  {
    "id": 54,
    "text": "标志着近体诗艺术的巅峰成熟。",
    "start": 194.53,
    "end": 196.789,
    "duration": 2.259
  },
  {
    "id": 55,
    "text": "第四，承前启后开辟无数法门，构筑影响后代诗国走向的美学渊薮。",
    "start": 197.035,
    "end": 203.244,
    "duration": 6.209
  },
  {
    "id": 56,
    "text": "杜甫在诗歌史上的地位具有枢纽意义。",
    "start": 203.63,
    "end": 206.159,
    "duration": 2.529
  },
  {
    "id": 57,
    "text": "他以深沉的社会批判精神直接启迪了中唐新乐府运动；",
    "start": 206.665,
    "end": 210.851,
    "duration": 4.186
  },
  {
    "id": 58,
    "text": "以奇崛奥衍、炼字锻句的苦心造诣开启了韩孟诗派；",
    "start": 211.269,
    "end": 215.235,
    "duration": 3.966
  },
  {
    "id": 59,
    "text": "而其点化日常、化俗为雅的理趣追求，",
    "start": 215.701,
    "end": 218.646,
    "duration": 2.945
  },
  {
    "id": 60,
    "text": "则成为宋代江西诗派与苏轼、黄庭坚立派的核心基石。",
    "start": 218.885,
    "end": 223.258,
    "duration": 4.373
  },
  {
    "id": 61,
    "text": "元稹在 《唐故工部员外郎杜君墓系铭》 中盛赞其 “上薄风骚，",
    "start": 223.525,
    "end": 229.031,
    "duration": 5.506
  },
  {
    "id": 62,
    "text": "下该沈宋，言夺苏李，气吞曹刘，奄有魏晋，",
    "start": 229.137,
    "end": 232.869,
    "duration": 3.732
  },
  {
    "id": 63,
    "text": "兼备古今之体势”，",
    "start": 233.061,
    "end": 234.534,
    "duration": 1.473
  },
  {
    "id": 64,
    "text": "公允确立了其集古典诗歌之大成的崇高地位。",
    "start": 234.579,
    "end": 238.2,
    "duration": 3.621
  }
]
