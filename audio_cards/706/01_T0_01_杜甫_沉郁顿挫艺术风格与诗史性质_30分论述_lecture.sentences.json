[
  {
    "id": 1,
    "text": "试论杜甫诗歌“沉郁顿挫”的艺术风格与“诗史”性质。",
    "start": 0.05,
    "end": 4.944,
    "duration": 4.894
  },
  {
    "id": 2,
    "text": "杜甫是中国古典诗歌现实主义精神的集大成者。",
    "start": 4.944,
    "end": 9.167,
    "duration": 4.223
  },
  {
    "id": 3,
    "text": "面对安史之乱爆发、唐帝国由盛转衰的历史巨变，",
    "start": 9.167,
    "end": 13.524,
    "duration": 4.357
  },
  {
    "id": 4,
    "text": "杜甫秉持仁民爱物的博大胸襟，",
    "start": 13.524,
    "end": 16.579,
    "duration": 3.055
  },
  {
    "id": 5,
    "text": "将个人身世之悲与国家兴亡之痛融为一体。",
    "start": 16.579,
    "end": 20.202,
    "duration": 3.623
  },
  {
    "id": 6,
    "text": "在创作上，他以沉郁顿挫的美学风范，",
    "start": 20.202,
    "end": 23.188,
    "duration": 2.986
  },
  {
    "id": 7,
    "text": "全面反映时代剧变与民生疾苦；以即事名篇的写实笔法，",
    "start": 23.188,
    "end": 28.229,
    "duration": 5.041
  },
  {
    "id": 8,
    "text": "生动展现一代民众的心灵受难史。",
    "start": 28.229,
    "end": 31.2,
    "duration": 2.971
  },
  {
    "id": 9,
    "text": "杜甫集六朝盛唐诗歌之大成，开中晚唐乃至两宋无数法门，",
    "start": 31.2,
    "end": 36.415,
    "duration": 5.215
  },
  {
    "id": 10,
    "text": "确立了其万代宗仰的 “诗圣” 地位。",
    "start": 36.415,
    "end": 39.069,
    "duration": 2.654
  },
  {
    "id": 11,
    "text": "其艺术造诣与诗史品格，主要展现为以下四个核心维度：",
    "start": 39.069,
    "end": 44.56,
    "duration": 5.491
  },
  {
    "id": 12,
    "text": "第一，标举“沉郁顿挫”风格特质，",
    "start": 44.56,
    "end": 46.761,
    "duration": 2.201
  },
  {
    "id": 13,
    "text": "展现思想感情的深厚沉雄与表现手法的曲折起伏。",
    "start": 46.761,
    "end": 52.24,
    "duration": 5.479
  },
  {
    "id": 14,
    "text": "“沉郁顿挫” 是杜甫诗歌最核心的风格标识。",
    "start": 52.24,
    "end": 55.481,
    "duration": 3.241
  },
  {
    "id": 15,
    "text": "“沉郁” 侧重思想内容的深沉宽广，",
    "start": 55.481,
    "end": 60.109,
    "duration": 4.628
  },
  {
    "id": 16,
    "text": "源于关怀苍生的仁者之心；",
    "start": 60.109,
    "end": 62.109,
    "duration": 2.0
  },
  {
    "id": 17,
    "text": "“顿挫” 侧重章法波澜的回环转折，",
    "start": 62.109,
    "end": 64.472,
    "duration": 2.363
  },
  {
    "id": 18,
    "text": "源于内心情感与儒家中和心态的制约。",
    "start": 64.472,
    "end": 68.613,
    "duration": 4.141
  },
  {
    "id": 19,
    "text": "安史动乱与抱负破灭，使杜甫胸中积蓄深沉忧愤，",
    "start": 68.613,
    "end": 72.25,
    "duration": 3.637
  },
  {
    "id": 20,
    "text": "通过反复低回的语流展现出来。",
    "start": 72.25,
    "end": 74.75,
    "duration": 2.5
  },
  {
    "id": 21,
    "text": "在名作 《自京赴奉先县咏怀五百字》 中，",
    "start": 74.75,
    "end": 77.709,
    "duration": 2.959
  },
  {
    "id": 22,
    "text": "全诗情感四起四落：由抱负落空的郁勃，",
    "start": 77.709,
    "end": 81.532,
    "duration": 3.823
  },
  {
    "id": 23,
    "text": "骤转入骊山行乐的批判；揭露 “朱门酒肉臭，",
    "start": 81.532,
    "end": 85.201,
    "duration": 3.669
  },
  {
    "id": 24,
    "text": "路有冻死骨” 后，愤懑化为深沉叹息；归家惊闻幼子饿卒，",
    "start": 85.201,
    "end": 90.413,
    "duration": 5.212
  },
  {
    "id": 25,
    "text": "悲痛之余笔锋复转入对更悲惨远戍卒的深切关怀。",
    "start": 90.413,
    "end": 95.102,
    "duration": 4.689
  },
  {
    "id": 26,
    "text": "刘熙载 《艺概》 评其意深而法曲，",
    "start": 95.102,
    "end": 97.283,
    "duration": 2.181
  },
  {
    "id": 27,
    "text": "达到了古典抒情艺术的极高境界。",
    "start": 97.283,
    "end": 100.925,
    "duration": 3.642
  },
  {
    "id": 28,
    "text": "第二，确立“诗史”叙事传统，展现感时伤事的深厚人道主义情怀。",
    "start": 100.925,
    "end": 106.431,
    "duration": 5.506
  },
  {
    "id": 29,
    "text": "所谓 “诗史”，其本质不仅在于据实补正史书阙载，",
    "start": 106.431,
    "end": 110.849,
    "duration": 4.418
  },
  {
    "id": 30,
    "text": "更在于以微观平民视角，",
    "start": 110.849,
    "end": 113.028,
    "duration": 2.179
  },
  {
    "id": 31,
    "text": "真实记录战争浩劫中下层百姓的心灵受难史。",
    "start": 113.028,
    "end": 117.085,
    "duration": 4.057
  },
  {
    "id": 32,
    "text": "杜甫打破盛唐诗偏于玲珑兴象的格局，开辟了即事名篇的叙事范式。",
    "start": 117.085,
    "end": 123.313,
    "duration": 6.228
  },
  {
    "id": 33,
    "text": "“三吏三别” 直面征兵惨烈真相：在 《石壕吏》 中，",
    "start": 123.313,
    "end": 127.129,
    "duration": 3.816
  },
  {
    "id": 34,
    "text": "诗人以客观克制的冷笔夜捉叙述，在拍门呼喝与老妇泣诉间，",
    "start": 127.129,
    "end": 132.589,
    "duration": 5.46
  },
  {
    "id": 35,
    "text": "深刻揭露战争对底层家庭伦理的摧残。",
    "start": 132.589,
    "end": 135.557,
    "duration": 2.968
  },
  {
    "id": 36,
    "text": "在 《茅屋为秋风所破歌》 中，面对床头屋漏的困厄，",
    "start": 135.557,
    "end": 139.795,
    "duration": 4.238
  },
  {
    "id": 37,
    "text": "依然迸发出 “安得广厦千万间，",
    "start": 139.795,
    "end": 142.836,
    "duration": 3.041
  },
  {
    "id": 38,
    "text": "大庇天下寒士俱欢颜” 的崇高呼号，",
    "start": 142.836,
    "end": 145.897,
    "duration": 3.061
  },
  {
    "id": 39,
    "text": "展现出超越时代的人道主义光辉。",
    "start": 145.897,
    "end": 148.645,
    "duration": 2.748
  },
  {
    "id": 40,
    "text": "第三，实现古典律诗之集大成，",
    "start": 148.645,
    "end": 152.037,
    "duration": 3.392
  },
  {
    "id": 41,
    "text": "达成内容拓展与形式通变的圆融境界。",
    "start": 152.037,
    "end": 155.526,
    "duration": 3.489
  },
  {
    "id": 42,
    "text": "杜甫对律诗体裁做出了极大开拓。",
    "start": 155.526,
    "end": 158.29,
    "duration": 2.764
  },
  {
    "id": 43,
    "text": "他打破齐梁以来律诗偏于应酬浮艳的狭隘格式，",
    "start": 158.29,
    "end": 162.841,
    "duration": 4.551
  },
  {
    "id": 44,
    "text": "将重大政治时事、社会现实与生民疾苦引入近体，",
    "start": 162.841,
    "end": 167.174,
    "duration": 4.333
  },
  {
    "id": 45,
    "text": "极大地扩大了律诗表现容量。",
    "start": 167.174,
    "end": 169.366,
    "duration": 2.192
  },
  {
    "id": 46,
    "text": "其七律组诗 《秋兴八首》 将身世漂泊、",
    "start": 169.366,
    "end": 172.723,
    "duration": 3.357
  },
  {
    "id": 47,
    "text": "长安旧梦与时局之忧层层递进，把组诗格局推向极境。",
    "start": 172.723,
    "end": 177.146,
    "duration": 4.423
  },
  {
    "id": 48,
    "text": "在格律技艺上，杜甫精研声病，",
    "start": 177.146,
    "end": 179.472,
    "duration": 2.326
  },
  {
    "id": 49,
    "text": "既追求 “晚节渐于诗律细” 的工稳，",
    "start": 179.472,
    "end": 183.603,
    "duration": 4.131
  },
  {
    "id": 50,
    "text": "又敢于创制 “拗救” 与变体。",
    "start": 183.603,
    "end": 185.789,
    "duration": 2.186
  },
  {
    "id": 51,
    "text": "其名作 《登高》 八句皆对，",
    "start": 185.789,
    "end": 187.756,
    "duration": 1.967
  },
  {
    "id": 52,
    "text": "将孤舟残年身世与万里悲秋江天融为一体，",
    "start": 187.756,
    "end": 191.466,
    "duration": 3.71
  },
  {
    "id": 53,
    "text": "胡应麟 《诗薮》 赞为 “古今七言律第一”，",
    "start": 191.466,
    "end": 194.54,
    "duration": 3.074
  },
  {
    "id": 54,
    "text": "标志着近体诗艺术的巅峰成熟。",
    "start": 194.54,
    "end": 197.045,
    "duration": 2.505
  },
  {
    "id": 55,
    "text": "第四，承前启后开辟无数法门，构筑影响后代诗国走向的美学渊薮。",
    "start": 197.045,
    "end": 203.64,
    "duration": 6.595
  },
  {
    "id": 56,
    "text": "杜甫在诗歌史上的地位具有枢纽意义。",
    "start": 203.64,
    "end": 206.675,
    "duration": 3.035
  },
  {
    "id": 57,
    "text": "他以深沉的社会批判精神直接启迪了中唐新乐府运动；",
    "start": 206.675,
    "end": 211.28,
    "duration": 4.605
  },
  {
    "id": 58,
    "text": "以奇崛奥衍、炼字锻句的苦心造诣开启了韩孟诗派；",
    "start": 211.28,
    "end": 215.712,
    "duration": 4.432
  },
  {
    "id": 59,
    "text": "而其点化日常、化俗为雅的理趣追求，",
    "start": 215.712,
    "end": 218.895,
    "duration": 3.183
  },
  {
    "id": 60,
    "text": "则成为宋代江西诗派与苏轼、黄庭坚立派的核心基石。",
    "start": 218.895,
    "end": 223.535,
    "duration": 4.64
  },
  {
    "id": 61,
    "text": "元稹在 《唐故工部员外郎杜君墓系铭》 中盛赞其 “上薄风骚，",
    "start": 223.535,
    "end": 229.169,
    "duration": 5.634
  },
  {
    "id": 62,
    "text": "下该沈宋，言夺苏李，气吞曹刘，奄有魏晋，",
    "start": 229.169,
    "end": 232.079,
    "duration": 2.91
  },
  {
    "id": 63,
    "text": "兼备古今之体势”，",
    "start": 232.079,
    "end": 233.933,
    "duration": 1.854
  },
  {
    "id": 64,
    "text": "公允确立了其集古典诗歌之大成的崇高地位。",
    "start": 233.933,
    "end": 238.2,
    "duration": 4.267
  }
]