[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "破立并举的“以诗为词”全链：",
    "start": 0.0,
    "end": 3.16,
    "duration": 3.16
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先从观念破“词为艳科”拓出报国悼亡农村题材，",
    "start": 3.209,
    "end": 7.249,
    "duration": 4.04
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再把诗歌“标题小序”移植入词以增强纪实，",
    "start": 7.779,
    "end": 11.259,
    "duration": 3.48
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "接着注入黄州逆境淬炼的旷达理趣，最后不惜被讥“不葺之诗”松绑声律，",
    "start": 11.709,
    "end": 17.229,
    "duration": 5.52
  },
  {
    "id": "hook_c4",
    "dom_key": "hook_c4",
    "text": "直接为辛派铺路。",
    "start": 17.799,
    "end": 19.279,
    "duration": 1.48
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "苏轼以文人主体意识推行“以诗为词”，使词跃升为独立抒情诗体。",
    "start": 19.729,
    "end": 25.129,
    "duration": 5.4
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "胡寅《酒边词序》赞其“一洗绮罗香泽之态，摆脱绸缪宛转之度，",
    "start": 25.579,
    "end": 31.019,
    "duration": 5.44
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "使人登高望远，举首高歌”。",
    "start": 31.469,
    "end": 33.749,
    "duration": 2.28
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 破除“词为艳科”、诗词一体拓题材",
    "start": 34.199,
    "end": 37.959,
    "duration": 3.76
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "在《祭张子野文》称词“盖诗之裔”，力主“自是一家”，",
    "start": 38.409,
    "end": 42.329,
    "duration": 3.92
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "把词从歌伎口中解放；",
    "start": 42.779,
    "end": 44.659,
    "duration": 1.88
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "纳入怀古报国“射天狼”、悼亡“十年生死两茫茫”、农村“敲门试问野人家”，",
    "start": 45.109,
    "end": 50.909,
    "duration": 5.8
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "极大拓宽表现领域。",
    "start": 51.359,
    "end": 53.039,
    "duration": 1.68
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 广用标题与小序紧扣生活场景",
    "start": 53.489,
    "end": 57.209,
    "duration": 3.72
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "破除“有调无题”旧套，广用标题小序交代缘起、时地与场景；",
    "start": 57.659,
    "end": 62.419,
    "duration": 4.76
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《水调歌头》序“丙辰中秋……兼怀子由”点怀弟之旨；",
    "start": 62.869,
    "end": 66.829,
    "duration": 3.96
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "《定风波》详记沙湖遇雨“同行皆狼狈，余独不觉”，补足词体叙事短处。",
    "start": 67.279,
    "end": 72.839,
    "duration": 5.56
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 融通性情理趣、立清旷豪迈词风",
    "start": 73.289,
    "end": 77.289,
    "duration": 4.0
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "定慧院“拣尽寒枝不肯栖”守孤高；",
    "start": 77.739,
    "end": 80.419,
    "duration": 2.68
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "赤壁“人生如梦，一尊还酹江月”遣苦闷；",
    "start": 80.869,
    "end": 84.029,
    "duration": 3.16
  },
  {
    "id": "sec2_step0_c2",
    "dom_key": "sec2_step0_c2",
    "text": "沙湖“也无风雨也无晴”达超然；",
    "start": 84.479,
    "end": 87.119,
    "duration": 2.64
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "融儒家坚守与佛道超脱为一体，确立清雄旷达士大夫词风典范。",
    "start": 87.569,
    "end": 93.089,
    "duration": 5.52
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 弱化音乐依附、开启南宋辛派路径",
    "start": 93.619,
    "end": 97.299,
    "duration": 3.68
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "虽被李清照评为“句读不葺之诗”，",
    "start": 97.749,
    "end": 100.509,
    "duration": 2.76
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "然王灼《碧鸡漫志》赞其“非心醉于音律者……指出向上一路，",
    "start": 100.959,
    "end": 105.559,
    "duration": 4.6
  },
  {
    "id": "sec3_step0_c2",
    "dom_key": "sec3_step0_c2",
    "text": "新天下耳目”；",
    "start": 106.009,
    "end": 107.209,
    "duration": 1.2
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "奠基北宋豪放派，更直接启迪南宋张孝祥、辛弃疾“以文为词”与用经用史之风。",
    "start": 107.659,
    "end": 114.419,
    "duration": 6.76
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "苏轼以“以诗为词”借题序、理趣破“词为艳科”成见，",
    "start": 114.869,
    "end": 118.989,
    "duration": 4.12
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "减弱对音乐依附并提升文学品位，确立词与诗并列地位，开启南宋辛派新途。",
    "start": 119.439,
    "end": 125.919,
    "duration": 6.48
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：苏轼“以诗为词”称词“盖诗之裔”；",
    "start": 126.369,
    "end": 129.769,
    "duration": 3.4
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "辛弃疾则进一步“以文为词”；",
    "start": 130.219,
    "end": 132.459,
    "duration": 2.24
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "李清照曾评苏词为“句读不葺之诗”。",
    "start": 132.909,
    "end": 136.029,
    "duration": 3.12
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 胡寅《酒边词序》与王灼《碧鸡漫志》如何评价苏词？",
    "start": 136.479,
    "end": 142.039,
    "duration": 5.56
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 《水调歌头》《定风波》小序各起到什么叙事铺垫作用？",
    "start": 142.489,
    "end": 147.649,
    "duration": 5.16
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 黄州三句词（定慧院/赤壁/沙湖）怎样呈现儒道释融合？",
    "start": 148.099,
    "end": 154.179,
    "duration": 6.08
  }
]