[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "苏轼·以诗入词与宋代词坛地位",
    "start": 0.354,
    "end": 3.566,
    "duration": 3.212
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "破立并举的“以诗为词”全链：先从观念破“词为艳科”拓出报国悼亡农村题材，",
    "start": 4.534,
    "end": 13.466,
    "duration": 8.932
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再把诗歌“标题小序”移植入词以增强纪实，接着注入黄州逆境淬炼的旷达理趣，",
    "start": 13.894,
    "end": 21.146,
    "duration": 7.252
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后不惜被讥“不葺之诗”松绑声律，直接为辛派铺路。",
    "start": 21.534,
    "end": 26.466,
    "duration": 4.932
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "苏轼以文人主体意识推行“以诗为词”，使词跃升为独立抒情诗体。",
    "start": 27.474,
    "end": 33.326,
    "duration": 5.852
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "胡寅《酒边词序》赞其“一洗绮罗香泽之态，摆脱绸缪宛转之度，使人登高望远，举首高歌”。",
    "start": 34.294,
    "end": 42.506,
    "duration": 8.212
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 破除“词为艳科”、诗词一体拓题材",
    "start": 43.434,
    "end": 46.966,
    "duration": 3.532
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "在《祭张子野文》称词“盖诗之裔”，力主“自是一家”，把词从歌伎口中解放；",
    "start": 47.974,
    "end": 54.746,
    "duration": 6.772
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "纳入怀古报国“射天狼”、悼亡“十年生死两茫茫”、农村“敲门试问野人家”，极大拓宽表现领域。",
    "start": 55.714,
    "end": 65.526,
    "duration": 9.812
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 广用标题与小序紧扣生活场景",
    "start": 66.494,
    "end": 70.026,
    "duration": 3.532
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "破除“有调无题”旧套，广用标题小序交代缘起、时地与场景；",
    "start": 71.074,
    "end": 78.046,
    "duration": 6.972
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《水调歌头》序“丙辰中秋……兼怀子由”点怀弟之旨；",
    "start": 79.014,
    "end": 85.666,
    "duration": 6.652
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "《定风波》详记沙湖遇雨“同行皆狼狈，余独不觉”，补足词体叙事短处。",
    "start": 86.594,
    "end": 92.726,
    "duration": 6.132
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 融通性情理趣、立清旷豪迈词风",
    "start": 93.342,
    "end": 97.394,
    "duration": 4.052
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "定慧院“拣尽寒枝不肯栖”守孤高；赤壁“人生如梦，一尊还酹江月”遣苦闷；沙湖“也无风雨也无晴”达超然；",
    "start": 98.174,
    "end": 109.146,
    "duration": 10.972
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "融儒家坚守与佛道超脱为一体，确立清雄旷达士大夫词风典范。",
    "start": 110.154,
    "end": 116.846,
    "duration": 6.692
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 弱化音乐依附、开启南宋辛派路径",
    "start": 117.854,
    "end": 121.866,
    "duration": 4.012
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "虽被李清照评为“句读不葺之诗”，然王灼《碧鸡漫志》赞其“非心醉于音律者……指出向上一路，新天下耳目”；",
    "start": 122.874,
    "end": 133.246,
    "duration": 10.372
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "奠基北宋豪放派，更直接启迪南宋张孝祥、辛弃疾“以文为词”与用经用史之风。",
    "start": 134.214,
    "end": 142.266,
    "duration": 8.052
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "苏轼以“以诗为词”借题序、理趣破“词为艳科”成见，减弱对音乐依附并提升文学品位，",
    "start": 143.314,
    "end": 151.126,
    "duration": 7.812
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "确立词与诗并列地位，开启南宋辛派新途。",
    "start": 151.514,
    "end": 155.486,
    "duration": 3.972
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：苏轼“以诗为词”称词“盖诗之裔”；辛弃疾则进一步“以文为词”；李清照曾评苏词为“句读不葺之诗”。",
    "start": 156.574,
    "end": 168.246,
    "duration": 11.672
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 胡寅《酒边词序》与王灼《碧鸡漫志》如何评价苏词？",
    "start": 169.254,
    "end": 175.626,
    "duration": 6.372
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 《水调歌头》《定风波》小序各起到什么叙事铺垫作用？",
    "start": 176.634,
    "end": 182.886,
    "duration": 6.252
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 黄州三句词（定慧院/赤壁/沙湖）怎样呈现儒道释融合？",
    "start": 183.894,
    "end": 191.026,
    "duration": 7.132
  }
]