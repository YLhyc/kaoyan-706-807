[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "苏轼·以诗入词与宋代词坛地位",
    "start": 0.134,
    "end": 3.193,
    "duration": 3.059
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "破立并举的“以诗为词”全链：先从观念破“词为艳科”拓出报国悼亡农村题材，",
    "start": 3.769,
    "end": 11.02,
    "duration": 7.252
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再把诗歌“标题小序”移植入词以增强纪实，接着注入黄州逆境淬炼的旷达理趣，",
    "start": 11.36,
    "end": 18.169,
    "duration": 6.809
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后不惜被讥“不葺之诗”松绑声律，直接为辛派铺路。",
    "start": 18.296,
    "end": 22.488,
    "duration": 4.192
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "苏轼以文人主体意识推行“以诗为词”，使词跃升为独立抒情诗体。",
    "start": 23.075,
    "end": 28.686,
    "duration": 5.611
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "胡寅《酒边词序》赞其“一洗绮罗香泽之态，摆脱绸缪宛转之度，使人登高望远，举首高歌”。",
    "start": 29.273,
    "end": 36.941,
    "duration": 7.668
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 破除“词为艳科”、诗词一体拓题材",
    "start": 37.528,
    "end": 41.29,
    "duration": 3.762
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "在《祭张子野文》称词“盖诗之裔”，力主“自是一家”，把词从歌伎口中解放；",
    "start": 41.877,
    "end": 48.425,
    "duration": 6.548
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "纳入怀古报国“射天狼”、悼亡“十年生死两茫茫”、农村“敲门试问野人家”，极大拓宽表现领域。",
    "start": 49.012,
    "end": 57.475,
    "duration": 8.463
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 广用标题与小序紧扣生活场景",
    "start": 58.062,
    "end": 61.759,
    "duration": 3.697
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "破除“有调无题”旧套，广用标题小序交代缘起、时地与场景；",
    "start": 62.345,
    "end": 67.93,
    "duration": 5.585
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《水调歌头》序“丙辰中秋……兼怀子由”点怀弟之旨；",
    "start": 68.504,
    "end": 73.464,
    "duration": 4.96
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "《定风波》详记沙湖遇雨“同行皆狼狈，余独不觉”，补足词体叙事短处。",
    "start": 73.7,
    "end": 79.884,
    "duration": 6.184
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 融通性情理趣、立清旷豪迈词风",
    "start": 80.457,
    "end": 84.402,
    "duration": 3.944
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "定慧院“拣尽寒枝不肯栖”守孤高；赤壁“人生如梦，一尊还酹江月”遣苦闷；沙湖“也无风雨也无晴”达超然；",
    "start": 84.976,
    "end": 95.535,
    "duration": 10.559
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "融儒家坚守与佛道超脱为一体，确立清雄旷达士大夫词风典范。",
    "start": 96.108,
    "end": 102.344,
    "duration": 6.236
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 弱化音乐依附、开启南宋辛派路径",
    "start": 102.931,
    "end": 106.915,
    "duration": 3.983
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "虽被李清照评为“句读不葺之诗”，然王灼《碧鸡漫志》赞其“非心醉于音律者……指出向上一路，新天下耳目”；",
    "start": 107.489,
    "end": 117.084,
    "duration": 9.595
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "奠基北宋豪放派，更直接启迪南宋张孝祥、辛弃疾“以文为词”与用经用史之风。",
    "start": 117.671,
    "end": 125.365,
    "duration": 7.694
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "苏轼以“以诗为词”借题序、理趣破“词为艳科”成见，减弱对音乐依附并提升文学品位，",
    "start": 125.926,
    "end": 133.607,
    "duration": 7.681
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "确立词与诗并列地位，开启南宋辛派新途。",
    "start": 133.882,
    "end": 137.93,
    "duration": 4.048
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：苏轼“以诗为词”称词“盖诗之裔”；辛弃疾则进一步“以文为词”；李清照曾评苏词为“句读不葺之诗”。",
    "start": 138.517,
    "end": 147.904,
    "duration": 9.387
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 胡寅《酒边词序》与王灼《碧鸡漫志》如何评价苏词？",
    "start": 148.465,
    "end": 154.167,
    "duration": 5.702
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 《水调歌头》《定风波》小序各起到什么叙事铺垫作用？",
    "start": 154.754,
    "end": 160.522,
    "duration": 5.767
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 黄州三句词（定慧院/赤壁/沙湖）怎样呈现儒道释融合？",
    "start": 161.095,
    "end": 168.139,
    "duration": 7.043
  }
]