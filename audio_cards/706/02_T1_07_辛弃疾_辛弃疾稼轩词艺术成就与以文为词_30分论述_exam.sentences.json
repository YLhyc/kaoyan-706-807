[
  {
    "id": "sent_1",
    "text": "辛弃疾是南宋词坛豪放词派的至高集大成者。",
    "start": 0.0,
    "end": 3.84,
    "duration": 3.84
  },
  {
    "id": "sent_2",
    "text": "身处南宋小朝廷偏安江南、中原故土沦丧、",
    "start": 4.289,
    "end": 8.169,
    "duration": 3.88
  },
  {
    "id": "sent_3",
    "text": "自身作为“归正人”备受主和派猜忌排挤的历史绝境，",
    "start": 8.619,
    "end": 12.779,
    "duration": 4.16
  },
  {
    "id": "sent_4",
    "text": "辛弃疾以沙场英雄的壮烈怀抱与治国安邦之才入词，",
    "start": 13.229,
    "end": 17.749,
    "duration": 4.52
  },
  {
    "id": "sent_5",
    "text": "在继承苏轼“以诗为词”的基础上更进一步，推行 “以文为词”，",
    "start": 18.199,
    "end": 23.079,
    "duration": 4.88
  },
  {
    "id": "sent_6",
    "text": "彻底打破了词体原有的体裁边界。",
    "start": 23.529,
    "end": 26.289,
    "duration": 2.76
  },
  {
    "id": "sent_7",
    "text": "刘熙载在 《艺概》 中评其词 “颇似左氏《春秋》及《离骚》”；",
    "start": 26.739,
    "end": 30.859,
    "duration": 4.12
  },
  {
    "id": "sent_8",
    "text": "梁启超赞其为 “一代豪杰之词”。",
    "start": 31.309,
    "end": 33.749,
    "duration": 2.44
  },
  {
    "id": "sent_9",
    "text": "其稼轩词的艺术成就与以文为词机制，",
    "start": 34.279,
    "end": 37.479,
    "duration": 3.2
  },
  {
    "id": "sent_10",
    "text": "主要展现为以下四个核心维度：",
    "start": 37.929,
    "end": 40.449,
    "duration": 2.52
  },
  {
    "id": "sent_11",
    "text": "第一，推行“以文为词”的文体革命，",
    "start": 40.899,
    "end": 43.539,
    "duration": 2.64
  },
  {
    "id": "sent_12",
    "text": "全面吸纳散文句法与论辩逻辑入词。",
    "start": 44.069,
    "end": 47.029,
    "duration": 2.96
  },
  {
    "id": "sent_13",
    "text": "辛弃疾对词体最重大的文体革新，",
    "start": 47.479,
    "end": 50.399,
    "duration": 2.92
  },
  {
    "id": "sent_14",
    "text": "在于大胆打破诗歌声律对称的拘牵，将先秦两汉散文的章法结构、",
    "start": 50.849,
    "end": 56.089,
    "duration": 5.24
  },
  {
    "id": "sent_15",
    "text": "句式与逻辑说理全盘注入词体。",
    "start": 56.699,
    "end": 59.179,
    "duration": 2.48
  },
  {
    "id": "sent_16",
    "text": "他广泛借用 《论语》《孟子》《庄子》 与 《史记》 的散文句法，",
    "start": 59.629,
    "end": 63.589,
    "duration": 3.96
  },
  {
    "id": "sent_17",
    "text": "大量运用长短错落的散文化句式与虚字呼应。",
    "start": 64.039,
    "end": 67.799,
    "duration": 3.76
  },
  {
    "id": "sent_18",
    "text": "在 《摸鱼儿·更能消几番风雨》 中，",
    "start": 68.249,
    "end": 70.409,
    "duration": 2.16
  },
  {
    "id": "sent_19",
    "text": "以如散文策论般的层层设问、环环相扣铺叙身世之感与宗国之悲；",
    "start": 70.859,
    "end": 76.699,
    "duration": 5.84
  },
  {
    "id": "sent_20",
    "text": "这种以散文笔调直发议论、腾挪转折的表现方式，",
    "start": 77.149,
    "end": 80.989,
    "duration": 3.84
  },
  {
    "id": "sent_21",
    "text": "赋予了词体前所未有的开阔气势与深沉的思辨力量。",
    "start": 81.439,
    "end": 85.559,
    "duration": 4.12
  },
  {
    "id": "sent_22",
    "text": "第二，确立“融经铸史”的用典艺术，",
    "start": 86.089,
    "end": 88.809,
    "duration": 2.72
  },
  {
    "id": "sent_23",
    "text": "以密集史实典故作为政治批判武器。",
    "start": 89.259,
    "end": 92.099,
    "duration": 2.84
  },
  {
    "id": "sent_24",
    "text": "辛弃疾将古典用典艺术推向了登峰造极的境地。",
    "start": 92.549,
    "end": 96.269,
    "duration": 3.72
  },
  {
    "id": "sent_25",
    "text": "他不再停留于字句的表面借用，而是将经史典故作为借古讽今、",
    "start": 96.719,
    "end": 101.759,
    "duration": 5.04
  },
  {
    "id": "sent_26",
    "text": "表达政治忧患的隐微载体。",
    "start": 102.209,
    "end": 104.329,
    "duration": 2.12
  },
  {
    "id": "sent_27",
    "text": "其晚年登临名作 《永遇乐·京口北固亭怀古》，",
    "start": 104.779,
    "end": 108.139,
    "duration": 3.36
  },
  {
    "id": "sent_28",
    "text": "全篇不足百字连用五典：借 “千古江山，",
    "start": 108.669,
    "end": 112.189,
    "duration": 3.52
  },
  {
    "id": "sent_29",
    "text": "英雄无觅孙仲谋处” 讽刺南宋当政者的苟且偷安；",
    "start": 112.639,
    "end": 116.919,
    "duration": 4.28
  },
  {
    "id": "sent_30",
    "text": "借刘裕 “气吞万里如虎” 对照刘义隆 “赢得仓皇北顾” 的冒进惨败，",
    "start": 117.369,
    "end": 122.289,
    "duration": 4.92
  },
  {
    "id": "sent_31",
    "text": "警示韩侂胄草率北伐的致命危机；",
    "start": 122.739,
    "end": 125.619,
    "duration": 2.88
  },
  {
    "id": "sent_32",
    "text": "借 “廉颇老矣，尚能饭否” 抒发自身报国无门的英雄迟暮之悲。",
    "start": 126.069,
    "end": 131.029,
    "duration": 4.96
  },
  {
    "id": "sent_33",
    "text": "密集典故与现实政治紧密结合，化为沉痛的政治批判武器。",
    "start": 131.479,
    "end": 136.239,
    "duration": 4.76
  },
  {
    "id": "sent_34",
    "text": "第三，贯注沙场英雄的豪壮气概，",
    "start": 136.689,
    "end": 139.649,
    "duration": 2.96
  },
  {
    "id": "sent_35",
    "text": "构筑悲壮激越的爱国主义美学典范。",
    "start": 140.099,
    "end": 142.859,
    "duration": 2.76
  },
  {
    "id": "sent_36",
    "text": "辛弃疾早年亲率五十骑突袭金营生擒叛徒，",
    "start": 143.309,
    "end": 147.109,
    "duration": 3.8
  },
  {
    "id": "sent_37",
    "text": "具备深厚的将帅军事韬略，这种沙场英豪气概在词史上绝无仅有。",
    "start": 147.559,
    "end": 152.679,
    "duration": 5.12
  },
  {
    "id": "sent_38",
    "text": "在 《破阵子·为陈同甫赋壮词以寄之》 中，“醉里挑灯看剑，",
    "start": 153.129,
    "end": 157.689,
    "duration": 4.56
  },
  {
    "id": "sent_39",
    "text": "梦回吹角连营。",
    "start": 158.139,
    "end": 159.539,
    "duration": 1.4
  },
  {
    "id": "sent_40",
    "text": "八百里分麾下炙，五十弦翻塞外声，沙场秋点兵”，",
    "start": 160.069,
    "end": 164.349,
    "duration": 4.28
  },
  {
    "id": "sent_41",
    "text": "以极其雄壮的节奏重现沙场阅兵征战的壮烈图景；",
    "start": 164.799,
    "end": 168.879,
    "duration": 4.08
  },
  {
    "id": "sent_42",
    "text": "结语笔锋却陡然逆转为 “可怜白发生”，",
    "start": 169.329,
    "end": 172.289,
    "duration": 2.96
  },
  {
    "id": "sent_43",
    "text": "将满腔报国热忱与现实压抑的剧烈矛盾推向顶点，",
    "start": 172.739,
    "end": 177.139,
    "duration": 4.4
  },
  {
    "id": "sent_44",
    "text": "迸发出沉雄悲壮的精神震撼力。",
    "start": 177.589,
    "end": 180.189,
    "duration": 2.6
  },
  {
    "id": "sent_45",
    "text": "第四，展现丰富多样化的审美风貌，兼备清新田园与幽默谐谑之趣。",
    "start": 180.639,
    "end": 185.919,
    "duration": 5.28
  },
  {
    "id": "sent_46",
    "text": "稼轩词虽以豪放悲壮为主调，但其风格同样具有极广阔的多样性。",
    "start": 186.368,
    "end": 191.808,
    "duration": 5.44
  },
  {
    "id": "sent_47",
    "text": "在带湖、瓢泉闲居期间，",
    "start": 192.258,
    "end": 194.578,
    "duration": 2.32
  },
  {
    "id": "sent_48",
    "text": "他创作了大量清新活泼的农村词与幽默小品。",
    "start": 195.028,
    "end": 198.588,
    "duration": 3.56
  },
  {
    "id": "sent_49",
    "text": "在 《西江月·夜行黄沙道中》 中，写下 “明月别枝惊鹊，",
    "start": 199.038,
    "end": 203.078,
    "duration": 4.04
  },
  {
    "id": "sent_50",
    "text": "清风半夜鸣蝉。",
    "start": 203.528,
    "end": 204.968,
    "duration": 1.44
  },
  {
    "id": "sent_51",
    "text": "稻花香里说丰年，听取蛙声一片” 的静谧田园；",
    "start": 205.418,
    "end": 209.298,
    "duration": 3.88
  },
  {
    "id": "sent_52",
    "text": "在 《清平乐·村居》 中，以 “最喜小儿亡赖，",
    "start": 209.748,
    "end": 212.588,
    "duration": 2.84
  },
  {
    "id": "sent_53",
    "text": "溪头卧剥莲蓬” 白描农村人伦真趣；",
    "start": 213.038,
    "end": 216.118,
    "duration": 3.08
  },
  {
    "id": "sent_54",
    "text": "更以词写戒酒、止酒，谐谑生动。",
    "start": 216.568,
    "end": 219.328,
    "duration": 2.76
  },
  {
    "id": "sent_55",
    "text": "这种多样化的艺术造诣，证明了其在词史上全能大师的崇高地位。",
    "start": 219.778,
    "end": 224.778,
    "duration": 5.0
  }
]