[
  {
    "id": 1,
    "text": "试论辛弃疾稼轩词的艺术成就与“以文为词”。",
    "start": 0.16,
    "end": 4.551,
    "duration": 4.391
  },
  {
    "id": 2,
    "text": "辛弃疾是南宋豪放词派的集大成者。",
    "start": 5.178,
    "end": 8.12,
    "duration": 2.942
  },
  {
    "id": 3,
    "text": "身处南宋偏安江南、中原故土沦丧、",
    "start": 8.363,
    "end": 11.676,
    "duration": 3.313
  },
  {
    "id": 4,
    "text": "自身作为“归正人”备受主和派猜忌排挤的时代境遇，",
    "start": 11.947,
    "end": 16.495,
    "duration": 4.548
  },
  {
    "id": 5,
    "text": "辛弃疾将沙场英雄的壮烈怀抱与治国谋略注入词作，",
    "start": 16.89,
    "end": 21.433,
    "duration": 4.543
  },
  {
    "id": 6,
    "text": "继承苏轼“以诗为词”的传统并进一步推行“以文为词”，",
    "start": 21.712,
    "end": 26.596,
    "duration": 4.884
  },
  {
    "id": 7,
    "text": "空前解放了词体表现功能。",
    "start": 26.942,
    "end": 28.838,
    "duration": 1.896
  },
  {
    "id": 8,
    "text": "刘克庄在《辛稼轩集序》中赞其“横绝六合，扫空万古”，",
    "start": 29.415,
    "end": 34.186,
    "duration": 4.771
  },
  {
    "id": 9,
    "text": "周济《宋四家词选》亦评其“沉着痛快，有辙可循”。",
    "start": 34.771,
    "end": 38.818,
    "duration": 4.047
  },
  {
    "id": 10,
    "text": "稼轩词的艺术成就与以文为词之功，主要体现在以下四个方面：",
    "start": 39.154,
    "end": 44.027,
    "duration": 4.873
  },
  {
    "id": 11,
    "text": "第一，推行“以文为词”的文体革新，",
    "start": 44.733,
    "end": 47.518,
    "duration": 2.785
  },
  {
    "id": 12,
    "text": "吸纳散文辞赋章法与句式入词。",
    "start": 47.808,
    "end": 50.555,
    "duration": 2.747
  },
  {
    "id": 13,
    "text": "辛弃疾对词体最突出的开拓，在于打破诗歌声律的整齐拘束，",
    "start": 50.932,
    "end": 55.748,
    "duration": 4.816
  },
  {
    "id": 14,
    "text": "将散文与辞赋的章法结构、句式及议论手法引入词中。",
    "start": 56.022,
    "end": 61.029,
    "duration": 5.007
  },
  {
    "id": 15,
    "text": "他在《沁园春·将止酒》中模仿汉赋宾主问答体与酒杯对话，",
    "start": 61.438,
    "end": 66.426,
    "duration": 4.988
  },
  {
    "id": 16,
    "text": "在《木兰花慢》中借《天问》体连用七问；",
    "start": 66.74,
    "end": 69.85,
    "duration": 3.11
  },
  {
    "id": 17,
    "text": "《贺新郎》（“甚矣吾衰矣”）直接化用《论语》语汇，",
    "start": 70.449,
    "end": 74.176,
    "duration": 3.727
  },
  {
    "id": 18,
    "text": "全篇散文化句法与虚字呼应随手挥洒；《摸鱼儿》（“更能消、",
    "start": 74.411,
    "end": 79.623,
    "duration": 5.212
  },
  {
    "id": 19,
    "text": "几番风雨”）更以层层设问与倒折笔法抒写身世之感与宗国之悲，",
    "start": 79.787,
    "end": 85.386,
    "duration": 5.599
  },
  {
    "id": 20,
    "text": "既协律可歌，又赋予词体纵横开阖的气势与思辨深度。",
    "start": 85.694,
    "end": 90.489,
    "duration": 4.795
  },
  {
    "id": 21,
    "text": "第二，善用“用经用史”的用典艺术，借密集典故开展政治讽喻。",
    "start": 91.116,
    "end": 96.374,
    "duration": 5.258
  },
  {
    "id": 22,
    "text": "辛弃疾将词体用典艺术推向全新高度，",
    "start": 96.722,
    "end": 100.062,
    "duration": 3.34
  },
  {
    "id": 23,
    "text": "使经史典故成为借古讽今、抒发政治忧患的有力载体。",
    "start": 100.354,
    "end": 105.118,
    "duration": 4.764
  },
  {
    "id": 24,
    "text": "其晚年登临名作《永遇乐·京口北固亭怀古》全篇不足百字连用五典：",
    "start": 105.444,
    "end": 111.339,
    "duration": 5.895
  },
  {
    "id": 25,
    "text": "借“千古江山，",
    "start": 111.679,
    "end": 112.869,
    "duration": 1.19
  },
  {
    "id": 26,
    "text": "英雄无觅孙仲谋处”讽喻南宋当政者的苟且偷安；",
    "start": 113.164,
    "end": 117.591,
    "duration": 4.427
  },
  {
    "id": 27,
    "text": "借刘裕“气吞万里如虎”对照刘义隆“赢得仓皇北顾”的草率北伐，",
    "start": 117.909,
    "end": 123.604,
    "duration": 5.695
  },
  {
    "id": 28,
    "text": "警示韩侂胄冒进招败的危机；又借“廉颇老矣，",
    "start": 123.971,
    "end": 127.84,
    "duration": 3.869
  },
  {
    "id": 29,
    "text": "尚能饭否”抒发报国无门的迟暮悲慨。",
    "start": 127.919,
    "end": 131.571,
    "duration": 3.652
  },
  {
    "id": 30,
    "text": "典故密织而不滞重，句句指向南宋现实政局。",
    "start": 131.914,
    "end": 135.917,
    "duration": 4.003
  },
  {
    "id": 31,
    "text": "第三，贯注沙场英雄的豪壮气概，创造词史上罕见的军事意象群。",
    "start": 136.529,
    "end": 142.795,
    "duration": 6.266
  },
  {
    "id": 32,
    "text": "辛弃疾早年曾亲率五十骑突袭金营生擒叛徒，",
    "start": 143.419,
    "end": 147.479,
    "duration": 4.06
  },
  {
    "id": 33,
    "text": "有着真实的战场经验与将帅才略，这在词史上尤为罕见。",
    "start": 147.957,
    "end": 152.833,
    "duration": 4.876
  },
  {
    "id": 34,
    "text": "他将刀剑、弓马、旌旗等军事意象大量引入词中，",
    "start": 153.229,
    "end": 157.267,
    "duration": 4.038
  },
  {
    "id": 35,
    "text": "形成雄豪壮大的艺术境界。",
    "start": 157.648,
    "end": 159.676,
    "duration": 2.028
  },
  {
    "id": 36,
    "text": "在《破阵子·为陈同甫赋壮词以寄之》中，“醉里挑灯看剑，",
    "start": 159.974,
    "end": 165.478,
    "duration": 5.504
  },
  {
    "id": 37,
    "text": "梦回吹角连营。",
    "start": 165.686,
    "end": 167.037,
    "duration": 1.351
  },
  {
    "id": 38,
    "text": "八百里分麾下炙，五十弦翻塞外声，沙场秋点兵”，",
    "start": 167.446,
    "end": 172.12,
    "duration": 4.674
  },
  {
    "id": 39,
    "text": "以激越节奏重现沙场点兵、铁马飞驰的壮阔场面；",
    "start": 172.519,
    "end": 176.504,
    "duration": 3.985
  },
  {
    "id": 40,
    "text": "结句陡然跌落为“可怜白发生”，",
    "start": 177.176,
    "end": 179.65,
    "duration": 2.474
  },
  {
    "id": 41,
    "text": "将壮志难酬的悲愤与报国热忱形成强烈反差，",
    "start": 180.136,
    "end": 183.972,
    "duration": 3.836
  },
  {
    "id": 42,
    "text": "迸发出沉雄悲壮的感染力。",
    "start": 184.396,
    "end": 186.288,
    "duration": 1.892
  },
  {
    "id": 43,
    "text": "第四，兼备刚柔相济与亦庄亦谐的多样风貌，",
    "start": 186.913,
    "end": 190.559,
    "duration": 3.646
  },
  {
    "id": 44,
    "text": "确立宋词豪放宗师地位。",
    "start": 190.788,
    "end": 193.169,
    "duration": 2.381
  },
  {
    "id": 45,
    "text": "稼轩词虽以豪放悲壮为主调，审美风貌却极其丰富。",
    "start": 193.406,
    "end": 197.746,
    "duration": 4.34
  },
  {
    "id": 46,
    "text": "在带湖、瓢泉闲居期间，",
    "start": 197.951,
    "end": 200.079,
    "duration": 2.128
  },
  {
    "id": 47,
    "text": "他写下不少清新淳朴的乡村词与幽默小品：",
    "start": 200.421,
    "end": 203.924,
    "duration": 3.503
  },
  {
    "id": 48,
    "text": "在《西江月·夜行黄沙道中》中描绘“明月别枝惊鹊，",
    "start": 204.195,
    "end": 208.725,
    "duration": 4.53
  },
  {
    "id": 49,
    "text": "清风半夜鸣蝉。",
    "start": 208.994,
    "end": 210.592,
    "duration": 1.598
  },
  {
    "id": 50,
    "text": "稻花香里说丰年，听取蛙声一片”的静谧田园；",
    "start": 211.007,
    "end": 215.018,
    "duration": 4.011
  },
  {
    "id": 51,
    "text": "在《清平乐·村居》中以“最喜小儿无赖，",
    "start": 215.313,
    "end": 218.354,
    "duration": 3.041
  },
  {
    "id": 52,
    "text": "溪头卧剥莲蓬”白描农家真趣；",
    "start": 218.631,
    "end": 221.283,
    "duration": 2.652
  },
  {
    "id": 53,
    "text": "亦善以谐谑调笑写严肃的现实讽刺。",
    "start": 221.629,
    "end": 224.638,
    "duration": 3.009
  },
  {
    "id": 54,
    "text": "辛弃疾拓展了词的题材、意象与语言疆域，",
    "start": 224.886,
    "end": 228.376,
    "duration": 3.49
  },
  {
    "id": 55,
    "text": "聚拢起南宋辛派词人群体，最终确立了词与五、",
    "start": 228.674,
    "end": 232.778,
    "duration": 4.104
  },
  {
    "id": 56,
    "text": "七言诗歌分庭抗礼的文学地位。",
    "start": 233.014,
    "end": 235.413,
    "duration": 2.399
  }
]