[
  {
    "id": 1,
    "text": "试论辛弃疾稼轩词的艺术成就与“以文为词”。",
    "start": 0.134,
    "end": 3.586,
    "duration": 3.452
  },
  {
    "id": 2,
    "text": "辛弃疾是南宋豪放词派的集大成者。",
    "start": 4.303,
    "end": 7.115,
    "duration": 2.812
  },
  {
    "id": 3,
    "text": "身处南宋偏安江南、中原故土沦丧、自身作为“归正人”备受主和派猜忌排挤的时代境遇，",
    "start": 7.793,
    "end": 14.525,
    "duration": 6.732
  },
  {
    "id": 4,
    "text": "辛弃疾将沙场英雄的壮烈怀抱与治国谋略注入词作，",
    "start": 14.904,
    "end": 19.276,
    "duration": 4.372
  },
  {
    "id": 5,
    "text": "继承苏轼“以诗为词”的传统并进一步推行“以文为词”，空前解放了词体表现功能。",
    "start": 19.793,
    "end": 26.125,
    "duration": 6.332
  },
  {
    "id": 6,
    "text": "刘克庄赞其“横绝六合，扫空万古”，周济《宋四家词选》亦评其“沉着痛快，有辙可循”。",
    "start": 26.854,
    "end": 33.666,
    "duration": 6.812
  },
  {
    "id": 7,
    "text": "稼轩词的艺术成就与以文为词之功，主要体现在以下四个方面：",
    "start": 34.384,
    "end": 44.836,
    "duration": 10.452
  },
  {
    "id": 8,
    "text": "第一，推行“以文为词”的文体革新，吸纳散文辞赋章法与句式入词。",
    "start": 45.554,
    "end": 55.166,
    "duration": 9.612
  },
  {
    "id": 9,
    "text": "辛弃疾对词体最突出的开拓，在于打破诗歌声律的整齐拘束，",
    "start": 55.844,
    "end": 60.456,
    "duration": 4.612
  },
  {
    "id": 10,
    "text": "将散文与辞赋的章法结构、句式及议论手法引入词中。",
    "start": 60.835,
    "end": 63.247,
    "duration": 2.412
  },
  {
    "id": 11,
    "text": "他在《沁园春·将止酒》中模仿汉赋宾主问答体与酒杯对话，",
    "start": 63.925,
    "end": 65.457,
    "duration": 1.532
  },
  {
    "id": 12,
    "text": "在《木兰花慢》中借《天问》体连用七问；",
    "start": 65.836,
    "end": 66.168,
    "duration": 0.332
  },
  {
    "id": 13,
    "text": "《贺新郎》（“甚矣吾衰矣”）直接化用《论语》语汇，全篇散文化句法与虚字呼应随手挥洒；",
    "start": 66.697,
    "end": 67.709,
    "duration": 1.012
  },
  {
    "id": 14,
    "text": "《摸鱼儿》（“更能消、几番风雨”）更以层层设问与倒折笔法抒写身世之感与宗国之悲，",
    "start": 68.238,
    "end": 70.17,
    "duration": 1.932
  },
  {
    "id": 15,
    "text": "既协律可歌，又赋予词体纵横开阖的气势与思辨深度。",
    "start": 70.549,
    "end": 71.591,
    "duration": 1.042
  },
  {
    "id": 16,
    "text": "第二，善用“用经用史”的用典艺术，借密集典故开展政治讽喻。",
    "start": 72.349,
    "end": 83.201,
    "duration": 10.852
  },
  {
    "id": 17,
    "text": "辛弃疾将词体用典艺术推向全新高度，使经史典故成为借古讽今、抒发政治忧患的有力载体。",
    "start": 83.839,
    "end": 89.091,
    "duration": 5.252
  },
  {
    "id": 18,
    "text": "其晚年登临名作《永遇乐·京口北固亭怀古》全篇百余字连用五典：",
    "start": 89.729,
    "end": 97.381,
    "duration": 7.652
  },
  {
    "id": 19,
    "text": "借“千古江山，英雄无觅孙仲谋处”讽喻南宋当政者的苟且偷安；",
    "start": 98.059,
    "end": 104.631,
    "duration": 6.572
  },
  {
    "id": 20,
    "text": "借刘裕“气吞万里如虎”对照刘义隆“赢得仓皇北顾”的草率北伐，警示韩侂胄冒进招败的危机；",
    "start": 105.16,
    "end": 114.079,
    "duration": 8.919
  },
  {
    "id": 21,
    "text": "又借“廉颇老矣，尚能饭否”抒发报国无门的迟暮悲慨。",
    "start": 114.659,
    "end": 121.311,
    "duration": 6.652
  },
  {
    "id": 22,
    "text": "典故密织而不滞重，句句指向南宋现实政局。",
    "start": 121.84,
    "end": 125.532,
    "duration": 3.692
  },
  {
    "id": 23,
    "text": "第三，贯注沙场英雄的豪壮气概，创造词史上罕见的军事意象群。",
    "start": 126.156,
    "end": 131.448,
    "duration": 5.292
  },
  {
    "id": 24,
    "text": "辛弃疾早年曾亲率五十骑突袭金营生擒叛徒，",
    "start": 132.126,
    "end": 135.978,
    "duration": 3.852
  },
  {
    "id": 25,
    "text": "有着真实的战场经验与将帅才略，这在词史上尤为罕见。",
    "start": 136.357,
    "end": 140.769,
    "duration": 4.412
  },
  {
    "id": 26,
    "text": "他将刀剑、弓马、旌旗等军事意象大量引入词中，形成雄豪壮大的艺术境界。",
    "start": 141.447,
    "end": 147.579,
    "duration": 6.132
  },
  {
    "id": 27,
    "text": "在《破阵子·为陈同甫赋壮词以寄之》中，“醉里挑灯看剑，梦回吹角连营。”",
    "start": 148.257,
    "end": 153.949,
    "duration": 5.692
  },
  {
    "id": 28,
    "text": "“八百里分麾下炙，五十弦翻塞外声，沙场秋点兵”，以激越节奏重现沙场点兵、铁马飞驰的壮阔场面；",
    "start": 154.667,
    "end": 158.639,
    "duration": 3.972
  },
  {
    "id": 29,
    "text": "结句陡然跌落为“可怜白发生”，",
    "start": 159.168,
    "end": 161.46,
    "duration": 2.292
  },
  {
    "id": 30,
    "text": "将壮志难酬的悲愤与报国热忱形成强烈反差，迸发出沉雄悲壮的感染力。",
    "start": 161.839,
    "end": 163.411,
    "duration": 1.572
  },
  {
    "id": 31,
    "text": "第四，兼备刚柔相济与亦庄亦谐的多样风貌，确立宋词豪放宗师地位。",
    "start": 164.049,
    "end": 172.181,
    "duration": 8.132
  },
  {
    "id": 32,
    "text": "稼轩词虽以豪放悲壮为主调，审美风貌却极其丰富。",
    "start": 172.819,
    "end": 178.671,
    "duration": 5.852
  },
  {
    "id": 33,
    "text": "在带湖、瓢泉闲居期间，他写下不少清新淳朴的乡村词与幽默小品：",
    "start": 179.349,
    "end": 183.681,
    "duration": 4.332
  },
  {
    "id": 34,
    "text": "在《西江月·夜行黄沙道中》中描绘“明月别枝惊鹊，清风半夜鸣蝉。稻花香里说丰年，听取蛙声一片”的静谧田园；",
    "start": 184.319,
    "end": 189.731,
    "duration": 5.412
  },
  {
    "id": 35,
    "text": "在《清平乐·村居》中以“最喜小儿无赖，溪头卧剥莲蓬”白描农家真趣；",
    "start": 190.26,
    "end": 194.072,
    "duration": 3.812
  },
  {
    "id": 36,
    "text": "亦善以谐谑调笑写严肃的现实讽刺。",
    "start": 194.601,
    "end": 195.653,
    "duration": 1.052
  },
  {
    "id": 37,
    "text": "辛弃疾拓展了词的题材、意象与语言疆域，聚拢起南宋辛派词人群体，",
    "start": 196.371,
    "end": 198.743,
    "duration": 2.372
  },
  {
    "id": 38,
    "text": "最终确立了词与五、七言诗歌分庭抗礼的文学地位。",
    "start": 199.122,
    "end": 200.524,
    "duration": 1.402
  },
  {
    "id": 39,
    "text": "综上所述，辛弃疾继承苏轼词学革新精神并进一步推行“以文为词”，",
    "start": 201.282,
    "end": 203.974,
    "duration": 2.692
  },
  {
    "id": 40,
    "text": "以散文辞赋章法、经史典故与沙场军事意象，将南宋抗金壮怀与身世忧愤融入词调。",
    "start": 204.353,
    "end": 210.295,
    "duration": 5.942
  },
  {
    "id": 41,
    "text": "稼轩词兼具英雄豪壮与农家婉约清趣，带动南宋辛派词人群体蔚然成风，",
    "start": 210.933,
    "end": 231.193,
    "duration": 20.26
  },
  {
    "id": 42,
    "text": "最终使词在题材广度与思想深度上真正与五、七言诗歌并驾齐驱。",
    "start": 231.741,
    "end": 247.396,
    "duration": 15.655
  }
]