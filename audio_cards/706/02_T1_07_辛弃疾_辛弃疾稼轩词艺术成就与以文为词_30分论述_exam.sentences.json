[
  {
    "id": "sent_1",
    "text": "辛弃疾是南宋词坛豪放词派的至高集大成者。",
    "start": 0.1,
    "end": 4.724,
    "duration": 4.624
  },
  {
    "id": "sent_2",
    "text": "身处南宋小朝廷偏安江南、中原故土沦丧、自身作为“归正人”备受主和派猜忌排挤的历史绝境，",
    "start": 4.674,
    "end": 13.632,
    "duration": 8.958
  },
  {
    "id": "sent_3",
    "text": "辛弃疾以沙场英雄的壮烈怀抱与治国安邦之才入词，",
    "start": 13.633,
    "end": 18.607,
    "duration": 4.974
  },
  {
    "id": "sent_4",
    "text": "在继承苏轼“以诗为词”的基础上更进一步，推行 “以文为词”，",
    "start": 18.607,
    "end": 24.167,
    "duration": 5.56
  },
  {
    "id": "sent_5",
    "text": "彻底打破了词体原有的体裁边界。",
    "start": 24.167,
    "end": 27.643,
    "duration": 3.476
  },
  {
    "id": "sent_6",
    "text": "刘熙载在 《艺概》 中评其词 “颇似左氏《春秋》及《离骚》”；",
    "start": 27.643,
    "end": 32.357,
    "duration": 4.714
  },
  {
    "id": "sent_7",
    "text": "梁启超赞其为 “一代豪杰之词”。",
    "start": 32.357,
    "end": 35.534,
    "duration": 3.177
  },
  {
    "id": "sent_8",
    "text": "其稼轩词的艺术成就与以文为词机制，主要展现为以下四个核心维度：",
    "start": 35.534,
    "end": 42.162,
    "duration": 6.628
  },
  {
    "id": "sent_9",
    "text": "第一，推行“以文为词”的文体革命，",
    "start": 42.161,
    "end": 45.481,
    "duration": 3.32
  },
  {
    "id": "sent_10",
    "text": "全面吸纳散文句法与论辩逻辑入词。",
    "start": 45.482,
    "end": 49.192,
    "duration": 3.71
  },
  {
    "id": "sent_11",
    "text": "辛弃疾对词体最重大的文体革新，在于大胆打破诗歌声律对称的拘牵，",
    "start": 49.192,
    "end": 55.677,
    "duration": 6.485
  },
  {
    "id": "sent_12",
    "text": "将先秦两汉散文的章法结构、句式与逻辑说理全盘注入词体。",
    "start": 55.677,
    "end": 61.549,
    "duration": 5.872
  },
  {
    "id": "sent_13",
    "text": "他广泛借用 《论语》《孟子》《庄子》 与 《史记》 的散文句法，",
    "start": 61.549,
    "end": 66.614,
    "duration": 5.065
  },
  {
    "id": "sent_14",
    "text": "大量运用长短错落的散文化句式与虚字呼应。",
    "start": 66.615,
    "end": 70.951,
    "duration": 4.336
  },
  {
    "id": "sent_15",
    "text": "在 《摸鱼儿·更能消几番风雨》 中，",
    "start": 70.951,
    "end": 74.089,
    "duration": 3.138
  },
  {
    "id": "sent_16",
    "text": "以如散文策论般的层层设问、环环相扣铺叙身世之感与宗国之悲；",
    "start": 74.089,
    "end": 80.73,
    "duration": 6.641
  },
  {
    "id": "sent_17",
    "text": "这种以散文笔调直发议论、腾挪转折的表现方式，",
    "start": 80.729,
    "end": 85.417,
    "duration": 4.688
  },
  {
    "id": "sent_18",
    "text": "赋予了词体前所未有的开阔气势与深沉的思辨力量。",
    "start": 85.417,
    "end": 90.482,
    "duration": 5.065
  },
  {
    "id": "sent_19",
    "text": "第二，确立“融经铸史”的用典艺术，",
    "start": 90.482,
    "end": 94.024,
    "duration": 3.542
  },
  {
    "id": "sent_20",
    "text": "以密集史实典故作为政治批判武器。",
    "start": 94.023,
    "end": 97.643,
    "duration": 3.62
  },
  {
    "id": "sent_21",
    "text": "辛弃疾将古典用典艺术推向了登峰造极的境地。",
    "start": 97.643,
    "end": 102.148,
    "duration": 4.505
  },
  {
    "id": "sent_22",
    "text": "他不再停留于字句的表面借用，",
    "start": 102.148,
    "end": 105.247,
    "duration": 3.099
  },
  {
    "id": "sent_23",
    "text": "而是将经史典故作为借古讽今、表达政治忧患的隐微载体。",
    "start": 105.247,
    "end": 111.211,
    "duration": 5.964
  },
  {
    "id": "sent_24",
    "text": "其晚年登临名作 《永遇乐·京口北固亭怀古》，",
    "start": 111.211,
    "end": 115.677,
    "duration": 4.466
  },
  {
    "id": "sent_25",
    "text": "全篇不足百字连用五典：借 “千古江山，",
    "start": 115.677,
    "end": 119.57,
    "duration": 3.893
  },
  {
    "id": "sent_26",
    "text": "英雄无觅孙仲谋处” 讽刺南宋当政者的苟且偷安；",
    "start": 119.57,
    "end": 124.205,
    "duration": 4.635
  },
  {
    "id": "sent_27",
    "text": "借刘裕 “气吞万里如虎” 对照刘义隆 “赢得仓皇北顾” 的冒进惨败，",
    "start": 124.206,
    "end": 130.117,
    "duration": 5.911
  },
  {
    "id": "sent_28",
    "text": "警示韩侂胄草率北伐的致命危机；",
    "start": 130.117,
    "end": 133.685,
    "duration": 3.568
  },
  {
    "id": "sent_29",
    "text": "借 “廉颇老矣，尚能饭否” 抒发自身报国无门的英雄迟暮之悲。",
    "start": 133.685,
    "end": 139.18,
    "duration": 5.495
  },
  {
    "id": "sent_30",
    "text": "密集典故与现实政治紧密结合，化为沉痛的政治批判武器。",
    "start": 139.18,
    "end": 145.013,
    "duration": 5.833
  },
  {
    "id": "sent_31",
    "text": "第三，贯注沙场英雄的豪壮气概，构筑悲壮激越的爱国主义美学典范。",
    "start": 145.013,
    "end": 151.432,
    "duration": 6.419
  },
  {
    "id": "sent_32",
    "text": "辛弃疾早年亲率五十骑突袭金营生擒叛徒，具备深厚的将帅军事韬略，",
    "start": 151.432,
    "end": 158.203,
    "duration": 6.771
  },
  {
    "id": "sent_33",
    "text": "这种沙场英豪气概在词史上绝无仅有。",
    "start": 158.203,
    "end": 162.357,
    "duration": 4.154
  },
  {
    "id": "sent_34",
    "text": "在 《破阵子·为陈同甫赋壮词以寄之》 中，“醉里挑灯看剑，",
    "start": 162.357,
    "end": 167.709,
    "duration": 5.352
  },
  {
    "id": "sent_35",
    "text": "梦回吹角连营。",
    "start": 167.708,
    "end": 169.687,
    "duration": 1.979
  },
  {
    "id": "sent_36",
    "text": "八百里分麾下炙，五十弦翻塞外声，沙场秋点兵”，",
    "start": 169.688,
    "end": 174.402,
    "duration": 4.714
  },
  {
    "id": "sent_37",
    "text": "以极其雄壮的节奏重现沙场阅兵征战的壮烈图景；",
    "start": 174.401,
    "end": 179.258,
    "duration": 4.857
  },
  {
    "id": "sent_38",
    "text": "结语笔锋却陡然逆转为 “可怜白发生”，",
    "start": 179.258,
    "end": 183.125,
    "duration": 3.867
  },
  {
    "id": "sent_39",
    "text": "将满腔报国热忱与现实压抑的剧烈矛盾推向顶点，",
    "start": 183.124,
    "end": 188.151,
    "duration": 5.027
  },
  {
    "id": "sent_40",
    "text": "迸发出沉雄悲壮的精神震撼力。",
    "start": 188.151,
    "end": 191.367,
    "duration": 3.216
  },
  {
    "id": "sent_41",
    "text": "第四，展现丰富多样化的审美风貌，兼备清新田园与幽默谐谑之趣。",
    "start": 191.367,
    "end": 198.281,
    "duration": 6.914
  },
  {
    "id": "sent_42",
    "text": "稼轩词虽以豪放悲壮为主调，但其风格同样具有极广阔的多样性。",
    "start": 198.281,
    "end": 204.713,
    "duration": 6.432
  },
  {
    "id": "sent_43",
    "text": "在带湖、瓢泉闲居期间，他创作了大量清新活泼的农村词与幽默小品。",
    "start": 204.714,
    "end": 211.667,
    "duration": 6.953
  },
  {
    "id": "sent_44",
    "text": "在 《西江月·夜行黄沙道中》 中，写下 “明月别枝惊鹊，",
    "start": 211.667,
    "end": 216.706,
    "duration": 5.039
  },
  {
    "id": "sent_45",
    "text": "清风半夜鸣蝉。",
    "start": 216.706,
    "end": 218.594,
    "duration": 1.888
  },
  {
    "id": "sent_46",
    "text": "稻花香里说丰年，听取蛙声一片” 的静谧田园；",
    "start": 218.594,
    "end": 222.956,
    "duration": 4.362
  },
  {
    "id": "sent_47",
    "text": "在 《清平乐·村居》 中，以 “最喜小儿亡赖，",
    "start": 222.956,
    "end": 226.94,
    "duration": 3.984
  },
  {
    "id": "sent_48",
    "text": "溪头卧剥莲蓬” 白描农村人伦真趣；",
    "start": 226.94,
    "end": 230.508,
    "duration": 3.568
  },
  {
    "id": "sent_49",
    "text": "更以词写戒酒、止酒，谐谑生动。",
    "start": 230.508,
    "end": 234.297,
    "duration": 3.789
  },
  {
    "id": "sent_50",
    "text": "这种多样化的艺术造诣，证明了其在词史上全能大师的崇高地位。",
    "start": 234.297,
    "end": 240.443,
    "duration": 6.146
  }
]