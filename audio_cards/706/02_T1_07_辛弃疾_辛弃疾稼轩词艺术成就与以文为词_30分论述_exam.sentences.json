[
  {
    "id": 1,
    "text": "试论辛弃疾稼轩词的艺术成就与“以文为词”。",
    "start": 0.0,
    "end": 2.945,
    "duration": 2.945
  },
  {
    "id": 2,
    "text": "辛弃疾是南宋词坛豪放词派的至高集大成者。",
    "start": 2.945,
    "end": 7.84,
    "duration": 4.895
  },
  {
    "id": 3,
    "text": "身处南宋小朝廷偏安江南、中原故土沦丧、",
    "start": 7.84,
    "end": 10.172,
    "duration": 2.332
  },
  {
    "id": 4,
    "text": "自身作为“归正人”备受主和派猜忌排挤的历史绝境，",
    "start": 10.172,
    "end": 12.908,
    "duration": 2.736
  },
  {
    "id": 5,
    "text": "辛弃疾以沙场英雄的壮烈怀抱与治国安邦之才入词，",
    "start": 12.908,
    "end": 23.243,
    "duration": 10.335
  },
  {
    "id": 6,
    "text": "在继承苏轼“以诗为词”的基础上更进一步，",
    "start": 23.243,
    "end": 24.548,
    "duration": 1.305
  },
  {
    "id": 7,
    "text": "推行 “以文为词”，彻底打破了词体原有的体裁边界。",
    "start": 24.548,
    "end": 29.87,
    "duration": 5.322
  },
  {
    "id": 8,
    "text": "刘熙载在 《艺概》 中评其词 “颇似左氏《春秋》及《离骚》”；",
    "start": 29.87,
    "end": 32.28,
    "duration": 2.41
  },
  {
    "id": 9,
    "text": "梁启超赞其为 “一代豪杰之词”。",
    "start": 32.28,
    "end": 37.211,
    "duration": 4.931
  },
  {
    "id": 10,
    "text": "其稼轩词的艺术成就与以文为词机制，",
    "start": 37.211,
    "end": 41.918,
    "duration": 4.707
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：",
    "start": 41.918,
    "end": 45.183,
    "duration": 3.265
  },
  {
    "id": 12,
    "text": "第一，推行“以文为词”的文体革命，",
    "start": 45.183,
    "end": 48.941,
    "duration": 3.758
  },
  {
    "id": 13,
    "text": "全面吸纳散文句法与论辩逻辑入词。",
    "start": 48.941,
    "end": 52.126,
    "duration": 3.185
  },
  {
    "id": 14,
    "text": "辛弃疾对词体最重大的文体革新，",
    "start": 52.126,
    "end": 55.502,
    "duration": 3.376
  },
  {
    "id": 15,
    "text": "在于大胆打破诗歌声律对称的拘牵，",
    "start": 55.502,
    "end": 59.741,
    "duration": 4.239
  },
  {
    "id": 16,
    "text": "将先秦两汉散文的章法结构、句式与逻辑说理全盘注入词体。",
    "start": 59.741,
    "end": 66.344,
    "duration": 6.603
  },
  {
    "id": 17,
    "text": "他广泛借用 《论语》《孟子》《庄子》 与 《史记》 的散文句法，",
    "start": 66.344,
    "end": 70.147,
    "duration": 3.803
  },
  {
    "id": 18,
    "text": "大量运用长短错落的散文化句式与虚字呼应。",
    "start": 70.147,
    "end": 75.066,
    "duration": 4.919
  },
  {
    "id": 19,
    "text": "在 《摸鱼儿·更能消几番风雨》 中，",
    "start": 75.066,
    "end": 78.834,
    "duration": 3.768
  },
  {
    "id": 20,
    "text": "以如散文策论般的层层设问、",
    "start": 78.834,
    "end": 81.175,
    "duration": 2.341
  },
  {
    "id": 21,
    "text": "环环相扣铺叙身世之感与宗国之悲；这种以散文笔调直发议论、",
    "start": 81.175,
    "end": 88.984,
    "duration": 7.809
  },
  {
    "id": 22,
    "text": "腾挪转折的表现方式，",
    "start": 88.984,
    "end": 91.542,
    "duration": 2.558
  },
  {
    "id": 23,
    "text": "赋予了词体前所未有的开阔气势与深沉的思辨力量。",
    "start": 91.542,
    "end": 98.932,
    "duration": 7.39
  },
  {
    "id": 24,
    "text": "第二，确立“融经铸史”的用典艺术，",
    "start": 98.932,
    "end": 101.59,
    "duration": 2.658
  },
  {
    "id": 25,
    "text": "以密集史实典故作为政治批判武器。",
    "start": 101.59,
    "end": 104.514,
    "duration": 2.924
  },
  {
    "id": 26,
    "text": "辛弃疾将古典用典艺术推向了登峰造极的境地。",
    "start": 104.514,
    "end": 111.257,
    "duration": 6.743
  },
  {
    "id": 27,
    "text": "他不再停留于字句的表面借用，而是将经史典故作为借古讽今、",
    "start": 111.257,
    "end": 119.583,
    "duration": 8.326
  },
  {
    "id": 28,
    "text": "表达政治忧患的隐微载体。",
    "start": 119.583,
    "end": 121.798,
    "duration": 2.215
  },
  {
    "id": 29,
    "text": "其晚年登临名作 《永遇乐·京口北固亭怀古》，",
    "start": 121.798,
    "end": 126.322,
    "duration": 4.524
  },
  {
    "id": 30,
    "text": "全篇不足百字连用五典：借 “千古江山，",
    "start": 126.322,
    "end": 130.858,
    "duration": 4.536
  },
  {
    "id": 31,
    "text": "英雄无觅孙仲谋处” 讽刺南宋当政者的苟且偷安；",
    "start": 130.858,
    "end": 137.061,
    "duration": 6.203
  },
  {
    "id": 32,
    "text": "借刘裕 “气吞万里如虎” 对照刘义隆 “赢得仓皇北顾” 的冒进惨败，",
    "start": 137.061,
    "end": 140.04,
    "duration": 2.979
  },
  {
    "id": 33,
    "text": "警示韩侂胄草率北伐的致命危机；借 “廉颇老矣，",
    "start": 140.04,
    "end": 145.856,
    "duration": 5.816
  },
  {
    "id": 34,
    "text": "尚能饭否” 抒发自身报国无门的英雄迟暮之悲。",
    "start": 145.856,
    "end": 150.242,
    "duration": 4.386
  },
  {
    "id": 35,
    "text": "密集典故与现实政治紧密结合，化为沉痛的政治批判武器。",
    "start": 150.242,
    "end": 156.82,
    "duration": 6.578
  },
  {
    "id": 36,
    "text": "第三，贯注沙场英雄的豪壮气概，",
    "start": 156.82,
    "end": 160.272,
    "duration": 3.452
  },
  {
    "id": 37,
    "text": "构筑悲壮激越的爱国主义美学典范。",
    "start": 160.272,
    "end": 164.93,
    "duration": 4.658
  },
  {
    "id": 38,
    "text": "辛弃疾早年亲率五十骑突袭金营生擒叛徒，",
    "start": 164.93,
    "end": 169.658,
    "duration": 4.728
  },
  {
    "id": 39,
    "text": "具备深厚的将帅军事韬略，",
    "start": 169.658,
    "end": 172.505,
    "duration": 2.847
  },
  {
    "id": 40,
    "text": "这种沙场英豪气概在词史上绝无仅有。",
    "start": 172.505,
    "end": 176.121,
    "duration": 3.616
  },
  {
    "id": 41,
    "text": "在 《破阵子·为陈同甫赋壮词以寄之》 中，",
    "start": 176.121,
    "end": 180.814,
    "duration": 4.693
  },
  {
    "id": 42,
    "text": "“醉里挑灯看剑，梦回吹角连营。",
    "start": 180.814,
    "end": 183.579,
    "duration": 2.765
  },
  {
    "id": 43,
    "text": "八百里分麾下炙，五十弦翻塞外声，沙场秋点兵”，",
    "start": 183.579,
    "end": 188.244,
    "duration": 4.665
  },
  {
    "id": 44,
    "text": "以极其雄壮的节奏重现沙场阅兵征战的壮烈图景；",
    "start": 188.244,
    "end": 192.711,
    "duration": 4.467
  },
  {
    "id": 45,
    "text": "结语笔锋却陡然逆转为 “可怜白发生”，",
    "start": 192.711,
    "end": 197.865,
    "duration": 5.154
  },
  {
    "id": 46,
    "text": "将满腔报国热忱与现实压抑的剧烈矛盾推向顶点，",
    "start": 197.865,
    "end": 202.291,
    "duration": 4.426
  },
  {
    "id": 47,
    "text": "迸发出沉雄悲壮的精神震撼力。",
    "start": 202.291,
    "end": 203.596,
    "duration": 1.305
  },
  {
    "id": 48,
    "text": "第四，展现丰富多样化的审美风貌，兼备清新田园与幽默谐谑之趣。",
    "start": 203.596,
    "end": 205.288,
    "duration": 1.692
  },
  {
    "id": 49,
    "text": "稼轩词虽以豪放悲壮为主调，但其风格同样具有极广阔的多样性。",
    "start": 205.288,
    "end": 206.21,
    "duration": 0.922
  },
  {
    "id": 50,
    "text": "在带湖、瓢泉闲居期间，",
    "start": 206.21,
    "end": 207.803,
    "duration": 1.593
  },
  {
    "id": 51,
    "text": "他创作了大量清新活泼的农村词与幽默小品。",
    "start": 207.803,
    "end": 209.394,
    "duration": 1.591
  },
  {
    "id": 52,
    "text": "在 《西江月·夜行黄沙道中》 中，写下 “明月别枝惊鹊，",
    "start": 209.394,
    "end": 211.459,
    "duration": 2.065
  },
  {
    "id": 53,
    "text": "清风半夜鸣蝉。",
    "start": 211.459,
    "end": 214.055,
    "duration": 2.596
  },
  {
    "id": 54,
    "text": "稻花香里说丰年，听取蛙声一片” 的静谧田园；",
    "start": 214.055,
    "end": 215.937,
    "duration": 1.882
  },
  {
    "id": 55,
    "text": "在 《清平乐·村居》 中，以 “最喜小儿亡赖，",
    "start": 215.937,
    "end": 218.009,
    "duration": 2.072
  },
  {
    "id": 56,
    "text": "溪头卧剥莲蓬” 白描农村人伦真趣；更以词写戒酒、止酒，",
    "start": 218.009,
    "end": 219.656,
    "duration": 1.647
  },
  {
    "id": 57,
    "text": "谐谑生动。",
    "start": 219.656,
    "end": 221.466,
    "duration": 1.81
  },
  {
    "id": 58,
    "text": "这种多样化的艺术造诣，证明了其在词史上全能大师的崇高地位。",
    "start": 221.466,
    "end": 228.987,
    "duration": 7.521
  }
]