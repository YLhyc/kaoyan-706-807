[
  {
    "id": 1,
    "text": "试论辛弃疾稼轩词的艺术成就与“以文为词”。",
    "start": 0.12,
    "end": 4.146,
    "duration": 4.026
  },
  {
    "id": 2,
    "text": "辛弃疾是南宋豪放词派的集大成者。",
    "start": 4.612,
    "end": 7.706,
    "duration": 3.094
  },
  {
    "id": 3,
    "text": "身处南宋偏安江南、中原故土沦丧、自身作为“归正人”备受主和派猜忌排挤的时代境遇，",
    "start": 8.33,
    "end": 15.963,
    "duration": 7.633
  },
  {
    "id": 4,
    "text": "辛弃疾将沙场英雄的壮烈怀抱与治国谋略注入词作，",
    "start": 16.253,
    "end": 20.797,
    "duration": 4.544
  },
  {
    "id": 5,
    "text": "继承苏轼“以诗为词”的传统并进一步推行“以文为词”，空前解放了词体表现功能。",
    "start": 21.077,
    "end": 28.246,
    "duration": 7.169
  },
  {
    "id": 6,
    "text": "刘克庄赞其“横绝六合，扫空万古”，周济《宋四家词选》亦评其“沉着痛快，有辙可循”。",
    "start": 28.516,
    "end": 35.99,
    "duration": 7.474
  },
  {
    "id": 7,
    "text": "稼轩词的艺术成就与以文为词之功，主要体现在以下四个方面：",
    "start": 36.231,
    "end": 41.204,
    "duration": 4.973
  },
  {
    "id": 8,
    "text": "第一，推行“以文为词”的文体革新，吸纳散文辞赋章法与句式入词。",
    "start": 41.474,
    "end": 47.301,
    "duration": 5.827
  },
  {
    "id": 9,
    "text": "辛弃疾对词体最突出的开拓，在于打破诗歌声律的整齐拘束，",
    "start": 47.671,
    "end": 52.492,
    "duration": 4.821
  },
  {
    "id": 10,
    "text": "将散文与辞赋的章法结构、句式及议论手法引入词中。",
    "start": 52.921,
    "end": 57.775,
    "duration": 4.854
  },
  {
    "id": 11,
    "text": "他在《沁园春·将止酒》中模仿汉赋宾主问答体与酒杯对话，",
    "start": 58.179,
    "end": 63.169,
    "duration": 4.99
  },
  {
    "id": 12,
    "text": "在《木兰花慢》中借《天问》体连用七问；",
    "start": 63.483,
    "end": 66.912,
    "duration": 3.429
  },
  {
    "id": 13,
    "text": "《贺新郎》（“甚矣吾衰矣”）直接化用《论语》语汇，全篇散文化句法与虚字呼应随手挥洒；",
    "start": 67.27,
    "end": 74.335,
    "duration": 7.065
  },
  {
    "id": 14,
    "text": "《摸鱼儿》（“更能消、几番风雨”）更以层层设问与倒折笔法抒写身世之感与宗国之悲，",
    "start": 74.599,
    "end": 81.442,
    "duration": 6.843
  },
  {
    "id": 15,
    "text": "既协律可歌，又赋予词体纵横开阖的气势与思辨深度。",
    "start": 81.722,
    "end": 86.688,
    "duration": 4.966
  },
  {
    "id": 16,
    "text": "第二，善用“用经用史”的用典艺术，借密集典故开展政治讽喻。",
    "start": 87.046,
    "end": 92.916,
    "duration": 5.87
  },
  {
    "id": 17,
    "text": "辛弃疾将词体用典艺术推向全新高度，使经史典故成为借古讽今、抒发政治忧患的有力载体。",
    "start": 93.083,
    "end": 100.903,
    "duration": 7.82
  },
  {
    "id": 18,
    "text": "其晚年登临名作《永遇乐·京口北固亭怀古》全篇百余字连用五典：",
    "start": 101.419,
    "end": 107.452,
    "duration": 6.033
  },
  {
    "id": 19,
    "text": "借“千古江山，英雄无觅孙仲谋处”讽喻南宋当政者的苟且偷安；",
    "start": 107.752,
    "end": 113.669,
    "duration": 5.917
  },
  {
    "id": 20,
    "text": "借刘裕“气吞万里如虎”对照刘义隆“赢得仓皇北顾”的草率北伐，警示韩侂胄冒进招败的危机；",
    "start": 113.982,
    "end": 122.305,
    "duration": 8.323
  },
  {
    "id": 21,
    "text": "又借“廉颇老矣，尚能饭否”抒发报国无门的迟暮悲慨。",
    "start": 122.83,
    "end": 127.615,
    "duration": 4.785
  },
  {
    "id": 22,
    "text": "典故密织而不滞重，句句指向南宋现实政局。",
    "start": 127.822,
    "end": 131.538,
    "duration": 3.716
  },
  {
    "id": 23,
    "text": "第三，贯注沙场英雄的豪壮气概，创造词史上罕见的军事意象群。",
    "start": 131.853,
    "end": 137.076,
    "duration": 5.223
  },
  {
    "id": 24,
    "text": "辛弃疾早年曾亲率五十骑突袭金营生擒叛徒，",
    "start": 137.329,
    "end": 141.368,
    "duration": 4.039
  },
  {
    "id": 25,
    "text": "有着真实的战场经验与将帅才略，这在词史上尤为罕见。",
    "start": 141.581,
    "end": 145.624,
    "duration": 4.043
  },
  {
    "id": 26,
    "text": "他将刀剑、弓马、旌旗等军事意象大量引入词中，形成雄豪壮大的艺术境界。",
    "start": 145.856,
    "end": 151.77,
    "duration": 5.914
  },
  {
    "id": 27,
    "text": "在《破阵子·为陈同甫赋壮词以寄之》中，“醉里挑灯看剑，梦回吹角连营。八百里分麾下炙，五十弦翻塞外声，沙场秋点兵”，",
    "start": 151.987,
    "end": 162.92,
    "duration": 10.933
  },
  {
    "id": 28,
    "text": "以激越节奏重现沙场点兵、铁马飞驰的壮阔场面；",
    "start": 163.187,
    "end": 168.209,
    "duration": 5.022
  },
  {
    "id": 29,
    "text": "结句陡然跌落为“可怜白发生”，",
    "start": 168.257,
    "end": 172.47,
    "duration": 4.213
  },
  {
    "id": 30,
    "text": "将壮志难酬的悲愤与报国热忱形成强烈反差，迸发出沉雄悲壮的感染力。",
    "start": 172.803,
    "end": 179.486,
    "duration": 6.683
  },
  {
    "id": 31,
    "text": "第四，兼备刚柔相济与亦庄亦谐的多样风貌，确立宋词豪放宗师地位。",
    "start": 179.802,
    "end": 185.763,
    "duration": 5.961
  },
  {
    "id": 32,
    "text": "稼轩词虽以豪放悲壮为主调，审美风貌却极其丰富。",
    "start": 186.232,
    "end": 190.689,
    "duration": 4.457
  },
  {
    "id": 33,
    "text": "在带湖、瓢泉闲居期间，他写下不少清新淳朴的乡村词与幽默小品：",
    "start": 191.211,
    "end": 197.118,
    "duration": 5.907
  },
  {
    "id": 34,
    "text": "在《西江月·夜行黄沙道中》中描绘“明月别枝惊鹊，清风半夜鸣蝉。稻花香里说丰年，听取蛙声一片”的静谧田园；",
    "start": 197.513,
    "end": 207.951,
    "duration": 10.438
  },
  {
    "id": 35,
    "text": "在《清平乐·村居》中以“最喜小儿无赖，溪头卧剥莲蓬”白描农家真趣；",
    "start": 208.174,
    "end": 214.223,
    "duration": 6.049
  },
  {
    "id": 36,
    "text": "亦善以谐谑调笑写严肃的现实讽刺。",
    "start": 214.479,
    "end": 217.464,
    "duration": 2.985
  },
  {
    "id": 37,
    "text": "辛弃疾拓展了词的题材、意象与语言疆域，聚拢起南宋辛派词人群体，",
    "start": 217.724,
    "end": 223.512,
    "duration": 5.788
  },
  {
    "id": 38,
    "text": "最终确立了词与五、七言诗歌分庭抗礼的文学地位。",
    "start": 223.805,
    "end": 227.982,
    "duration": 4.177
  },
  {
    "id": 39,
    "text": "综上所述，辛弃疾继承苏轼词学革新精神并进一步推行“以文为词”，",
    "start": 228.228,
    "end": 234.547,
    "duration": 6.319
  },
  {
    "id": 40,
    "text": "以散文辞赋章法、经史典故与沙场军事意象，",
    "start": 234.823,
    "end": 238.874,
    "duration": 4.051
  },
  {
    "id": 41,
    "text": "将南宋抗金壮怀与身世忧愤融入词调。",
    "start": 239.079,
    "end": 242.575,
    "duration": 3.496
  },
  {
    "id": 42,
    "text": "稼轩词兼具英雄豪壮与农家婉约清趣，带动南宋辛派词人群体蔚然成风，",
    "start": 242.896,
    "end": 249.548,
    "duration": 6.652
  },
  {
    "id": 43,
    "text": "最终使词在题材广度与思想深度上真正与五、七言诗歌并驾齐驱。",
    "start": 249.694,
    "end": 255.464,
    "duration": 5.77
  }
]