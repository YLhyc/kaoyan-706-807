[
  {
    "id": 1,
    "text": "试论辛弃疾稼轩词的艺术成就与“以文为词”。",
    "start": 0.05,
    "end": 4.29,
    "duration": 4.24
  },
  {
    "id": 2,
    "text": "辛弃疾是南宋词坛豪放词派的至高集大成者。",
    "start": 4.29,
    "end": 7.815,
    "duration": 3.525
  },
  {
    "id": 3,
    "text": "身处南宋小朝廷偏安江南、中原故土沦丧、",
    "start": 7.815,
    "end": 12.878,
    "duration": 5.063
  },
  {
    "id": 4,
    "text": "自身作为“归正人”备受主和派猜忌排挤的历史绝境，",
    "start": 12.878,
    "end": 17.222,
    "duration": 4.344
  },
  {
    "id": 5,
    "text": "辛弃疾以沙场英雄的壮烈怀抱与治国安邦之才入词，",
    "start": 17.222,
    "end": 22.345,
    "duration": 5.123
  },
  {
    "id": 6,
    "text": "在继承苏轼“以诗为词”的基础上更进一步，",
    "start": 22.345,
    "end": 27.309,
    "duration": 4.964
  },
  {
    "id": 7,
    "text": "推行 “以文为词”，彻底打破了词体原有的体裁边界。",
    "start": 27.309,
    "end": 32.25,
    "duration": 4.941
  },
  {
    "id": 8,
    "text": "刘熙载在 《艺概》 中评其词 “颇似左氏《春秋》及《离骚》”；",
    "start": 32.25,
    "end": 35.705,
    "duration": 3.455
  },
  {
    "id": 9,
    "text": "梁启超赞其为 “一代豪杰之词”。",
    "start": 35.705,
    "end": 39.163,
    "duration": 3.458
  },
  {
    "id": 10,
    "text": "其稼轩词的艺术成就与以文为词机制，",
    "start": 39.163,
    "end": 42.558,
    "duration": 3.395
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：",
    "start": 42.558,
    "end": 45.157,
    "duration": 2.599
  },
  {
    "id": 12,
    "text": "第一，推行“以文为词”的文体革命，",
    "start": 45.157,
    "end": 48.914,
    "duration": 3.757
  },
  {
    "id": 13,
    "text": "全面吸纳散文句法与论辩逻辑入词。",
    "start": 48.914,
    "end": 52.099,
    "duration": 3.185
  },
  {
    "id": 14,
    "text": "辛弃疾对词体最重大的文体革新，",
    "start": 52.099,
    "end": 55.473,
    "duration": 3.374
  },
  {
    "id": 15,
    "text": "在于大胆打破诗歌声律对称的拘牵，",
    "start": 55.473,
    "end": 58.201,
    "duration": 2.728
  },
  {
    "id": 16,
    "text": "将先秦两汉散文的章法结构、句式与逻辑说理全盘注入词体。",
    "start": 58.201,
    "end": 63.113,
    "duration": 4.912
  },
  {
    "id": 17,
    "text": "他广泛借用 《论语》《孟子》《庄子》 与 《史记》 的散文句法，",
    "start": 63.113,
    "end": 67.467,
    "duration": 4.354
  },
  {
    "id": 18,
    "text": "大量运用长短错落的散文化句式与虚字呼应。",
    "start": 67.467,
    "end": 72.589,
    "duration": 5.122
  },
  {
    "id": 19,
    "text": "在 《摸鱼儿·更能消几番风雨》 中，",
    "start": 72.589,
    "end": 75.048,
    "duration": 2.459
  },
  {
    "id": 20,
    "text": "以如散文策论般的层层设问、",
    "start": 75.048,
    "end": 77.361,
    "duration": 2.313
  },
  {
    "id": 21,
    "text": "环环相扣铺叙身世之感与宗国之悲；这种以散文笔调直发议论、",
    "start": 77.361,
    "end": 83.164,
    "duration": 5.803
  },
  {
    "id": 22,
    "text": "腾挪转折的表现方式，",
    "start": 83.164,
    "end": 86.193,
    "duration": 3.029
  },
  {
    "id": 23,
    "text": "赋予了词体前所未有的开阔气势与深沉的思辨力量。",
    "start": 86.193,
    "end": 91.514,
    "duration": 5.321
  },
  {
    "id": 24,
    "text": "第二，确立“融经铸史”的用典艺术，",
    "start": 91.514,
    "end": 94.588,
    "duration": 3.074
  },
  {
    "id": 25,
    "text": "以密集史实典故作为政治批判武器。",
    "start": 94.588,
    "end": 97.315,
    "duration": 2.727
  },
  {
    "id": 26,
    "text": "辛弃疾将古典用典艺术推向了登峰造极的境地。",
    "start": 97.315,
    "end": 101.562,
    "duration": 4.247
  },
  {
    "id": 27,
    "text": "他不再停留于字句的表面借用，而是将经史典故作为借古讽今、",
    "start": 101.562,
    "end": 107.212,
    "duration": 5.65
  },
  {
    "id": 28,
    "text": "表达政治忧患的隐微载体。",
    "start": 107.212,
    "end": 109.369,
    "duration": 2.157
  },
  {
    "id": 29,
    "text": "其晚年登临名作 《永遇乐·京口北固亭怀古》，",
    "start": 109.369,
    "end": 113.664,
    "duration": 4.295
  },
  {
    "id": 30,
    "text": "全篇不足百字连用五典：借 “千古江山，",
    "start": 113.664,
    "end": 117.076,
    "duration": 3.412
  },
  {
    "id": 31,
    "text": "英雄无觅孙仲谋处” 讽刺南宋当政者的苟且偷安；",
    "start": 117.076,
    "end": 121.768,
    "duration": 4.692
  },
  {
    "id": 32,
    "text": "借刘裕 “气吞万里如虎” 对照刘义隆 “赢得仓皇北顾” 的冒进惨败，",
    "start": 121.768,
    "end": 128.525,
    "duration": 6.757
  },
  {
    "id": 33,
    "text": "警示韩侂胄草率北伐的致命危机；借 “廉颇老矣，",
    "start": 128.525,
    "end": 132.574,
    "duration": 4.049
  },
  {
    "id": 34,
    "text": "尚能饭否” 抒发自身报国无门的英雄迟暮之悲。",
    "start": 132.574,
    "end": 137.047,
    "duration": 4.473
  },
  {
    "id": 35,
    "text": "密集典故与现实政治紧密结合，化为沉痛的政治批判武器。",
    "start": 137.047,
    "end": 142.617,
    "duration": 5.57
  },
  {
    "id": 36,
    "text": "第三，贯注沙场英雄的豪壮气概，",
    "start": 142.617,
    "end": 145.835,
    "duration": 3.218
  },
  {
    "id": 37,
    "text": "构筑悲壮激越的爱国主义美学典范。",
    "start": 145.835,
    "end": 148.562,
    "duration": 2.727
  },
  {
    "id": 38,
    "text": "辛弃疾早年亲率五十骑突袭金营生擒叛徒，",
    "start": 148.562,
    "end": 152.946,
    "duration": 4.384
  },
  {
    "id": 39,
    "text": "具备深厚的将帅军事韬略，",
    "start": 152.946,
    "end": 155.683,
    "duration": 2.737
  },
  {
    "id": 40,
    "text": "这种沙场英豪气概在词史上绝无仅有。",
    "start": 155.683,
    "end": 158.592,
    "duration": 2.909
  },
  {
    "id": 41,
    "text": "在 《破阵子·为陈同甫赋壮词以寄之》 中，",
    "start": 158.592,
    "end": 161.644,
    "duration": 3.052
  },
  {
    "id": 42,
    "text": "“醉里挑灯看剑，梦回吹角连营。",
    "start": 161.644,
    "end": 164.902,
    "duration": 3.258
  },
  {
    "id": 43,
    "text": "八百里分麾下炙，五十弦翻塞外声，沙场秋点兵”，",
    "start": 164.902,
    "end": 169.632,
    "duration": 4.73
  },
  {
    "id": 44,
    "text": "以极其雄壮的节奏重现沙场阅兵征战的壮烈图景；",
    "start": 169.632,
    "end": 174.699,
    "duration": 5.067
  },
  {
    "id": 45,
    "text": "结语笔锋却陡然逆转为 “可怜白发生”，",
    "start": 174.699,
    "end": 177.814,
    "duration": 3.115
  },
  {
    "id": 46,
    "text": "将满腔报国热忱与现实压抑的剧烈矛盾推向顶点，",
    "start": 177.814,
    "end": 181.736,
    "duration": 3.922
  },
  {
    "id": 47,
    "text": "迸发出沉雄悲壮的精神震撼力。",
    "start": 181.736,
    "end": 184.316,
    "duration": 2.58
  },
  {
    "id": 48,
    "text": "第四，展现丰富多样化的审美风貌，兼备清新田园与幽默谐谑之趣。",
    "start": 184.316,
    "end": 190.058,
    "duration": 5.742
  },
  {
    "id": 49,
    "text": "稼轩词虽以豪放悲壮为主调，但其风格同样具有极广阔的多样性。",
    "start": 190.058,
    "end": 197.847,
    "duration": 7.789
  },
  {
    "id": 50,
    "text": "在带湖、瓢泉闲居期间，",
    "start": 197.847,
    "end": 200.993,
    "duration": 3.146
  },
  {
    "id": 51,
    "text": "他创作了大量清新活泼的农村词与幽默小品。",
    "start": 200.993,
    "end": 205.259,
    "duration": 4.266
  },
  {
    "id": 52,
    "text": "在 《西江月·夜行黄沙道中》 中，写下 “明月别枝惊鹊，",
    "start": 205.259,
    "end": 209.376,
    "duration": 4.117
  },
  {
    "id": 53,
    "text": "清风半夜鸣蝉。",
    "start": 209.376,
    "end": 211.429,
    "duration": 2.053
  },
  {
    "id": 54,
    "text": "稻花香里说丰年，听取蛙声一片” 的静谧田园；",
    "start": 211.429,
    "end": 214.702,
    "duration": 3.273
  },
  {
    "id": 55,
    "text": "在 《清平乐·村居》 中，以 “最喜小儿亡赖，",
    "start": 214.702,
    "end": 217.981,
    "duration": 3.279
  },
  {
    "id": 56,
    "text": "溪头卧剥莲蓬” 白描农村人伦真趣；更以词写戒酒、止酒，",
    "start": 217.981,
    "end": 222.774,
    "duration": 4.793
  },
  {
    "id": 57,
    "text": "谐谑生动。",
    "start": 222.774,
    "end": 224.326,
    "duration": 1.552
  },
  {
    "id": 58,
    "text": "这种多样化的艺术造诣，证明了其在词史上全能大师的崇高地位。",
    "start": 224.326,
    "end": 229.224,
    "duration": 4.898
  }
]