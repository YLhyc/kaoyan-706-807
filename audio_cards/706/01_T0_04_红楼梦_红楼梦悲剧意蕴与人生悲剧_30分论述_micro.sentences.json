[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《红楼梦》·悲剧意蕴与人生悲剧",
    "start": 0.134,
    "end": 2.893,
    "duration": 2.759
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "由骨到肉再到韵：先定下“爱情→女性→家族”三重悲剧的思想高度，",
    "start": 3.482,
    "end": 10.213,
    "duration": 6.731
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再靠双线网状结构把百态细节暗扣进去，进而打破脸谱写出凤姐黛玉之复杂人性，",
    "start": 10.488,
    "end": 17.791,
    "duration": 7.304
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后用神话判词予实景笼上命运苍凉感。",
    "start": 17.905,
    "end": 21.381,
    "duration": 3.476
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《红楼梦》是中国古典长篇章回小说集大成之作。",
    "start": 21.955,
    "end": 26.342,
    "duration": 4.387
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "曹雪芹“披阅十载，增删五次”，打破才子佳人大团圆旧套；",
    "start": 26.916,
    "end": 31.772,
    "duration": 4.856
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "鲁迅赞其“自有《红楼梦》出来以后，传统的思想和写法都打破了”。",
    "start": 32.111,
    "end": 36.824,
    "duration": 4.713
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 构筑三重交织的必然悲剧意蕴",
    "start": 37.398,
    "end": 40.886,
    "duration": 3.489
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "青年反叛者爱情婚姻悲剧：贾宝玉与林黛玉精神契合的“木石前盟”，被家族利益“金玉良缘”扼杀；",
    "start": 41.46,
    "end": 50.144,
    "duration": 8.684
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "大观园女性命运悲剧：“千红一哭，万艳同悲”，晴雯、鸳鸯、迎春皆难逃被摧残厄运；",
    "start": 50.731,
    "end": 59.232,
    "duration": 8.502
  },
  {
    "id": "sec0_step2_c0",
    "dom_key": "sec0_step2_c0",
    "text": "封建贵族家族衰败悲剧：百年贾府崩塌，终致“落了片白茫茫大地真干净”，揭示美好价值必然毁灭。",
    "start": 59.806,
    "end": 69.35,
    "duration": 9.543
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 确立双线网状结构与日常伏笔",
    "start": 69.937,
    "end": 73.334,
    "duration": 3.397
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "摆脱单线与串珠旧局，创造以大观园为中心的网状全景结构，紧织贾府盛衰与宝黛爱情双线；",
    "start": 73.921,
    "end": 83.178,
    "duration": 9.257
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "借元妃省亲、宝玉挨打、抄检大观园与黛死钗嫁推动转折；",
    "start": 83.765,
    "end": 90.587,
    "duration": 6.822
  },
  {
    "id": "sec1_step2_c0",
    "dom_key": "sec1_step2_c0",
    "text": "在饮酒作诗、家长里短白描中暗伏生死线索，草蛇灰线、伏脉千里。",
    "start": 91.174,
    "end": 97.813,
    "duration": 6.64
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 打破类型化套路写复杂人物群像",
    "start": 98.387,
    "end": 101.967,
    "duration": 3.58
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "突破忠奸善恶脸谱定型，以精微心理与多维视角写活真实人性；",
    "start": 102.541,
    "end": 109.154,
    "duration": 6.614
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "王熙凤既是贪婪弄权、逼死尤二姐的狠辣管家，又是精明能干、偶周济刘姥姥的能人；",
    "start": 109.741,
    "end": 117.618,
    "duration": 7.877
  },
  {
    "id": "sec2_step2_c0",
    "dom_key": "sec2_step2_c0",
    "text": "林黛玉既有敏感孤高、多愁善感一面，更有才情横溢、自尊自爱的诗人本色。",
    "start": 118.192,
    "end": 125.743,
    "duration": 7.551
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 运用虚实相生的预叙象征笔法",
    "start": 126.335,
    "end": 129.849,
    "duration": 3.515
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "开篇以女娲补天遗石、通灵宝玉缘起，前五回借十二钗判词、《好了歌》及十二支曲暗示命运；",
    "start": 130.423,
    "end": 139.667,
    "duration": 9.244
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "现实中又以元宵灯谜、中秋联诗与大观园四时景致呼应悲剧结局；",
    "start": 140.254,
    "end": 147.037,
    "duration": 6.783
  },
  {
    "id": "sec3_step2_c0",
    "dom_key": "sec3_step2_c0",
    "text": "“真事隐去，假语村言”虚实相生，于写实之上笼罩深沉人生感慨。",
    "start": 147.624,
    "end": 154.068,
    "duration": 6.444
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《红楼梦》写尽封建家族与美梦幻灭。",
    "start": 154.642,
    "end": 157.857,
    "duration": 3.215
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "王国维《红楼梦评论》赞为“悲剧中之悲剧”，",
    "start": 158.444,
    "end": 161.581,
    "duration": 3.137
  },
  {
    "id": "concl_c2",
    "dom_key": "concl_c2",
    "text": "鲁迅论其“悲凉之雾，遍被华林，然呼吸而领会之者，独宝玉一人而已”。",
    "start": 161.869,
    "end": 168.378,
    "duration": 6.509
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：注意王国维在《红楼梦评论》称其“悲剧中之悲剧”，",
    "start": 168.965,
    "end": 173.704,
    "duration": 4.739
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "鲁迅赞其“传统的思想和写法都打破了”及“悲凉之雾，遍被华林”。",
    "start": 174.056,
    "end": 179.329,
    "duration": 5.272
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 《红楼梦》三重悲剧如何层层递进？",
    "start": 179.916,
    "end": 184.29,
    "duration": 4.374
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 网状叙事靠哪四个枢纽事件与哪虚实六组伏笔勾连？",
    "start": 184.876,
    "end": 190.969,
    "duration": 6.093
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 王国维《红楼梦评论》与鲁迅对本作各有哪句权威定评？",
    "start": 191.556,
    "end": 197.571,
    "duration": 6.015
  }
]