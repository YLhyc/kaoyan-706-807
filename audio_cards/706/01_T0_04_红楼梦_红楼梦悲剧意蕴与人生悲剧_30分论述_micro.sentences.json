[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《红楼梦》·悲剧意蕴与人生悲剧",
    "start": 0.134,
    "end": 3.186,
    "duration": 3.052
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "由骨到肉再到韵：先定下“爱情→女性→家族”三重悲剧的思想高度，",
    "start": 3.622,
    "end": 10.514,
    "duration": 6.892
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再靠双线网状结构把百态细节暗扣进去，进而打破脸谱写出凤姐黛玉之复杂人性，",
    "start": 10.742,
    "end": 18.674,
    "duration": 7.932
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后用神话判词予实景笼上命运苍凉感。",
    "start": 18.902,
    "end": 22.594,
    "duration": 3.692
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《红楼梦》是中国古典长篇章回小说集大成之作。",
    "start": 23.017,
    "end": 27.109,
    "duration": 4.092
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "曹雪芹“披阅十载，增删五次”，打破才子佳人大团圆旧套；",
    "start": 27.227,
    "end": 33.239,
    "duration": 6.012
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "鲁迅赞其“自有《红楼梦》出来以后，传统的思想和写法都打破了”。",
    "start": 33.517,
    "end": 38.569,
    "duration": 5.052
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 构筑三重交织的必然悲剧意蕴",
    "start": 39.034,
    "end": 42.006,
    "duration": 2.972
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "青年反叛者爱情婚姻悲剧：贾宝玉与林黛玉精神契合的“木石前盟”，被家族利益“金玉良缘”扼杀；",
    "start": 42.444,
    "end": 51.496,
    "duration": 9.052
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "大观园女性命运悲剧：“千红一哭，万艳同悲”，晴雯、鸳鸯、迎春皆难逃被摧残厄运；",
    "start": 52.024,
    "end": 60.116,
    "duration": 8.092
  },
  {
    "id": "sec0_step2_c0",
    "dom_key": "sec0_step2_c0",
    "text": "封建贵族家族衰败悲剧：百年贾府崩塌，终致“落了片白茫茫大地真干净”，揭示美好价值必然毁灭。",
    "start": 60.586,
    "end": 69.238,
    "duration": 8.652
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 确立双线网状结构与日常伏笔",
    "start": 69.908,
    "end": 73.52,
    "duration": 3.612
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "摆脱单线与串珠旧局，创造以大观园为中心的网状全景结构，紧织贾府盛衰与宝黛爱情双线；",
    "start": 74.048,
    "end": 83.98,
    "duration": 9.932
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "借元妃省亲、宝玉挨打、抄检大观园与黛死钗嫁推动转折；",
    "start": 84.386,
    "end": 91.678,
    "duration": 7.292
  },
  {
    "id": "sec1_step2_c0",
    "dom_key": "sec1_step2_c0",
    "text": "在饮酒作诗、家长里短白描中暗伏生死线索，草蛇灰线、伏脉千里。",
    "start": 92.206,
    "end": 100.378,
    "duration": 8.172
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 打破类型化套路写复杂人物群像",
    "start": 101.03,
    "end": 104.562,
    "duration": 3.532
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "突破忠奸善恶脸谱定型，以精微心理与多维视角写活真实人性；",
    "start": 105.052,
    "end": 111.864,
    "duration": 6.812
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "王熙凤既是贪婪弄权、逼死尤二姐的狠辣管家，又是精明能干、偶周济刘姥姥的能人；",
    "start": 112.294,
    "end": 119.426,
    "duration": 7.132
  },
  {
    "id": "sec2_step2_c0",
    "dom_key": "sec2_step2_c0",
    "text": "林黛玉既有敏感孤高、多愁善感一面，更有才情横溢、自尊自爱的诗人本色。",
    "start": 119.755,
    "end": 126.807,
    "duration": 7.052
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 运用虚实相生的预叙象征笔法",
    "start": 127.488,
    "end": 131.18,
    "duration": 3.692
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "开篇以女娲补天遗石、通灵宝玉缘起，前五回借十二钗判词、《好了歌》及十二支曲暗示命运；",
    "start": 131.706,
    "end": 140.518,
    "duration": 8.812
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "现实中又以元宵灯谜、中秋联诗与大观园四时景致呼应悲剧结局；",
    "start": 141.046,
    "end": 147.298,
    "duration": 6.252
  },
  {
    "id": "sec3_step2_c0",
    "dom_key": "sec3_step2_c0",
    "text": "“真事隐去，假语村言”虚实相生，于写实之上笼罩深沉人生感慨。",
    "start": 147.826,
    "end": 154.638,
    "duration": 6.812
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《红楼梦》写尽封建家族与美梦幻灭。",
    "start": 155.255,
    "end": 158.947,
    "duration": 3.692
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "王国维《红楼梦评论》赞为“悲剧中之悲剧”，",
    "start": 159.065,
    "end": 162.117,
    "duration": 3.052
  },
  {
    "id": "concl_c2",
    "dom_key": "concl_c2",
    "text": "鲁迅论其“悲凉之雾，遍被华林，然呼吸而领会之者，独宝玉一人而已”。",
    "start": 162.425,
    "end": 168.837,
    "duration": 6.412
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：注意王国维在《红楼梦评论》称其“悲剧中之悲剧”，",
    "start": 169.457,
    "end": 174.109,
    "duration": 4.652
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "鲁迅赞其“传统的思想和写法都打破了”及“悲凉之雾，遍被华林”。",
    "start": 174.657,
    "end": 180.669,
    "duration": 6.012
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 《红楼梦》三重悲剧如何层层递进？",
    "start": 181.335,
    "end": 184.787,
    "duration": 3.452
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 网状叙事靠哪四个枢纽事件与哪虚实六组伏笔勾连？",
    "start": 185.29,
    "end": 190.822,
    "duration": 5.532
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 王国维《红楼梦评论》与鲁迅对本作各有哪句权威定评？",
    "start": 191.35,
    "end": 197.362,
    "duration": 6.012
  }
]