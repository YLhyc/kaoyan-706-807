[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "悲秋母题·中国古代文学悲秋母题流变与文人心态机制",
    "start": 0.154,
    "end": 5.446,
    "duration": 5.292
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "严格按时间轴“战国奠基 → 汉魏生命化 → 唐代家国高峰与反拨 → 宋代哲理超越”四阶段流变梳理，",
    "start": 6.121,
    "end": 15.733,
    "duration": 9.612
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "每步紧扣“自然物候怎么照进士人命运”，把 2025 真题点名四篇全数扣严。",
    "start": 16.041,
    "end": 22.773,
    "duration": 6.732
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "“悲秋”是古代核心抒情母题，自宋玉发“悲哉秋之为气也”浩叹以来，",
    "start": 23.166,
    "end": 29.274,
    "duration": 6.108
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "积淀为观照生命流逝、身世漂泊与家国兴亡的传统，",
    "start": 29.289,
    "end": 34.209,
    "duration": 4.92
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "陆机《文赋》云“遵四时以叹逝……悲落叶于劲秋”。",
    "start": 34.224,
    "end": 38.218,
    "duration": 3.994
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 战国宋玉《九辩》奠定悲秋原型",
    "start": 38.751,
    "end": 42.203,
    "duration": 3.452
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "《诗经》尚无固定悲秋母题；宋玉《九辩》开篇高吟“悲哉秋之为气也！萧瑟兮草木摇落而变衰”；",
    "start": 42.695,
    "end": 52.967,
    "duration": 10.272
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "将草木枯槁与寒士“坎廪兮贫士失职而志不平”绑定，借雁南游、霜露立因秋起兴、以自然零落叹生命沉沦之原型。",
    "start": 53.491,
    "end": 64.783,
    "duration": 11.292
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 汉魏六朝注入生命短促与流离之忧",
    "start": 65.491,
    "end": 69.343,
    "duration": 3.852
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《秋风辞》“秋风起兮白云飞……少壮几时兮奈老何”感叹青春易逝；",
    "start": 69.871,
    "end": 77.003,
    "duration": 7.132
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "曹丕《燕歌行》“草木摇落露为霜”写思妇秋夜孤寂；潘岳《秋兴赋》感伤宦途华发，使秋成普遍寄托。",
    "start": 77.329,
    "end": 88.781,
    "duration": 11.452
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 盛唐杜甫升华为忧国沉郁（兼刘禹锡反拨）",
    "start": 89.402,
    "end": 94.054,
    "duration": 4.652
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《登高》“万里悲秋常作客，百年多病独登台”融个人与时代多艰；《秋兴八首》借夔州秋望长安，达忧国忧民高峰；",
    "start": 94.574,
    "end": 106.106,
    "duration": 11.532
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "中唐刘禹锡《秋词》“自古逢秋悲寂寥，我言秋日胜春朝”更以豪迈清朗反拨悲叹。",
    "start": 106.634,
    "end": 115.206,
    "duration": 8.572
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 宋代诗词赋转向内省与哲理超脱",
    "start": 115.88,
    "end": 119.812,
    "duration": 3.932
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "柳永《八声甘州》“一番洗清秋”抒羁旅愁；辛弃疾《丑奴儿》“却道天凉好个秋”道欲说还休苦闷；",
    "start": 120.34,
    "end": 130.722,
    "duration": 10.382
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "欧阳修《秋声赋》从“物过盛而当杀”体认天道；",
    "start": 131.25,
    "end": 136.142,
    "duration": 4.892
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "苏轼《赤壁赋》以“变与不变”哲思化解凋零悲情，赋予旷达超逸智慧。",
    "start": 136.5,
    "end": 143.792,
    "duration": 7.292
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "古代悲秋母题由宋玉发端、经汉魏流离之叹、盛唐忧国悲慨至宋代转向内省哲理超脱，",
    "start": 144.422,
    "end": 153.474,
    "duration": 9.052
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "集中映照士人在时间悲叹与家国担当间寻求精神安顿的心态。",
    "start": 153.942,
    "end": 159.634,
    "duration": 5.692
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：陆机《文赋》名句“遵四时以叹逝……悲落叶于劲秋，喜柔条于芳春”；",
    "start": 160.342,
    "end": 168.114,
    "duration": 7.772
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "纵向串联战国宋玉→汉武/曹丕/潘岳→唐杜甫（兼刘禹锡）→宋柳/辛/欧阳修/苏轼。",
    "start": 168.472,
    "end": 177.204,
    "duration": 8.732
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 默背陆机《文赋》概括文人感物的四句名言？",
    "start": 177.861,
    "end": 183.29,
    "duration": 5.429
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 按真题 2025 点名篇目顺序串联《九辩》《登高》《秋词》《秋声赋》各自定位？",
    "start": 183.818,
    "end": 192.516,
    "duration": 8.698
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 汉武、曹丕、潘岳、柳永、辛弃疾、苏轼如何补全这条千年弧线？",
    "start": 193.044,
    "end": 199.913,
    "duration": 6.869
  }
]