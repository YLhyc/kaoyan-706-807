[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "悲秋母题·中国古代文学悲秋母题流变与文人心态机制",
    "start": 0.314,
    "end": 5.006,
    "duration": 4.692
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "严格按时间轴“战国奠基 → 汉魏生命化 → 唐代家国高峰与反拨 → 宋代哲理超越”四阶段流变梳理，",
    "start": 6.014,
    "end": 15.866,
    "duration": 9.852
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "每步紧扣“自然物候怎么照进士人命运”，把 2025 真题点名四篇全数扣严。",
    "start": 16.214,
    "end": 22.546,
    "duration": 6.332
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "“悲秋”是古代核心抒情母题，自宋玉发“悲哉秋之为气也”浩叹以来，",
    "start": 23.554,
    "end": 29.526,
    "duration": 5.972
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "积淀为观照生命流逝、身世漂泊与家国兴亡的传统，",
    "start": 29.834,
    "end": 34.726,
    "duration": 4.892
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "陆机《文赋》云“遵四时以叹逝……悲落叶于劲秋”。",
    "start": 35.274,
    "end": 39.846,
    "duration": 4.572
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 战国宋玉《九辩》奠定悲秋原型",
    "start": 40.774,
    "end": 43.906,
    "duration": 3.132
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "《诗经》尚无固定悲秋母题；宋玉《九辩》开篇高吟“悲哉秋之为气也！萧瑟兮草木摇落而变衰”；",
    "start": 44.994,
    "end": 56.366,
    "duration": 11.372
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "将草木枯槁与寒士“坎廪兮贫士失职而志不平”绑定，借雁南游、霜露立因秋起兴、以自然零落叹生命沉沦之原型。",
    "start": 56.994,
    "end": 69.086,
    "duration": 12.092
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 汉魏六朝注入生命短促与流离之忧",
    "start": 70.054,
    "end": 73.786,
    "duration": 3.732
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《秋风辞》“秋风起兮白云飞……少壮几时兮奈老何”感叹青春易逝；",
    "start": 74.794,
    "end": 83.086,
    "duration": 8.292
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "曹丕《燕歌行》“草木摇落露为霜”写思妇秋夜孤寂；潘岳《秋兴赋》感伤宦途华发，使秋成普遍寄托。",
    "start": 84.054,
    "end": 96.966,
    "duration": 12.912
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 盛唐杜甫升华为忧国沉郁（兼刘禹锡反拨）",
    "start": 97.611,
    "end": 103.023,
    "duration": 5.412
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《登高》“万里悲秋常作客，百年多病独登台”融个人与时代多艰；《秋兴八首》借夔州秋望长安，达忧国忧民高峰；",
    "start": 103.835,
    "end": 116.487,
    "duration": 12.652
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "中唐刘禹锡《秋词》“自古逢秋悲寂寥，我言秋日胜春朝”更以豪迈清朗反拨悲叹。",
    "start": 117.495,
    "end": 126.067,
    "duration": 8.572
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 宋代诗词赋转向内省与哲理超脱",
    "start": 127.075,
    "end": 131.367,
    "duration": 4.292
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "柳永《八声甘州》“一番洗清秋”抒羁旅愁；辛弃疾《丑奴儿》“却道天凉好个秋”道欲说还休苦闷；",
    "start": 132.415,
    "end": 144.407,
    "duration": 11.992
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "欧阳修《秋声赋》从“物过盛而当杀”体认天道；",
    "start": 145.415,
    "end": 151.747,
    "duration": 6.332
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "苏轼《赤壁赋》以“变与不变”哲思化解凋零悲情，赋予旷达超逸智慧。",
    "start": 152.795,
    "end": 159.727,
    "duration": 6.932
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "古代悲秋母题由宋玉发端、经汉魏流离之叹、盛唐忧国悲慨至宋代转向内省哲理超脱，",
    "start": 160.735,
    "end": 169.987,
    "duration": 9.252
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "集中映照士人在时间悲叹与家国担当间寻求精神安顿的心态。",
    "start": 170.375,
    "end": 176.227,
    "duration": 5.852
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：陆机《文赋》名句“遵四时以叹逝……悲落叶于劲秋，喜柔条于芳春”；",
    "start": 177.275,
    "end": 185.007,
    "duration": 7.732
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "纵向串联战国宋玉→汉武/曹丕/潘岳→唐杜甫（兼刘禹锡）→宋柳/辛/欧阳修/苏轼。",
    "start": 186.095,
    "end": 195.147,
    "duration": 9.052
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 默背陆机《文赋》概括文人感物的四句名言？",
    "start": 196.115,
    "end": 200.647,
    "duration": 4.532
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 按真题 2025 点名篇目顺序串联《九辩》《登高》《秋词》《秋声赋》各自定位？",
    "start": 201.098,
    "end": 209.79,
    "duration": 8.692
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 汉武、曹丕、潘岳、柳永、辛弃疾、苏轼如何补全这条千年弧线？",
    "start": 210.209,
    "end": 217.061,
    "duration": 6.852
  }
]