[
  {
    "id": 1,
    "text": "试论“建安风骨”的美学内涵与“三曹”诗歌艺术。",
    "start": 0.101,
    "end": 3.62,
    "duration": 3.519
  },
  {
    "id": 2,
    "text": "汉末魏初是中国文学走向自觉的关键转折时期。",
    "start": 4.12,
    "end": 7.703,
    "duration": 3.583
  },
  {
    "id": 3,
    "text": "面对群雄割据、战乱频仍与瘟疫横行的社会动荡，",
    "start": 8.203,
    "end": 12.026,
    "duration": 3.823
  },
  {
    "id": 4,
    "text": "建安文人一方面深感生命短促、朝不保夕，另一方面又怀抱平定天下、建功立业的时代抱负。",
    "start": 12.417,
    "end": 19.537,
    "duration": 7.12
  },
  {
    "id": 5,
    "text": "这种在乱世阵痛中迸发出的昂扬志气与深沉忧患，",
    "start": 20.037,
    "end": 24.356,
    "duration": 4.319
  },
  {
    "id": 6,
    "text": "造就了中国诗歌史上极具生命力的“建安风骨”。",
    "start": 24.877,
    "end": 28.401,
    "duration": 3.524
  },
  {
    "id": 7,
    "text": "鲁迅称这一时期为“文学的自觉时代”；",
    "start": 28.969,
    "end": 31.817,
    "duration": 2.848
  },
  {
    "id": 8,
    "text": "刘勰在《文心雕龙·时序》中赞其“志深而笔长，故梗概而多气也”。",
    "start": 32.378,
    "end": 37.934,
    "duration": 5.556
  },
  {
    "id": 9,
    "text": "其美学内涵与三曹诗歌艺术，主要体现在以下四个方面：",
    "start": 38.517,
    "end": 42.768,
    "duration": 4.251
  },
  {
    "id": 10,
    "text": "第一，标举“慷慨悲凉”与“爽朗刚健”的风貌，达成情志与文辞的统一。",
    "start": 43.388,
    "end": 48.831,
    "duration": 5.443
  },
  {
    "id": 11,
    "text": "从诗学内涵而言，“建安风骨”是“风”与“骨”的有机统一。",
    "start": 49.331,
    "end": 53.55,
    "duration": 4.219
  },
  {
    "id": 12,
    "text": "“风”指诗歌充沛真挚、感人至深的思想感情，",
    "start": 54.147,
    "end": 57.374,
    "duration": 3.227
  },
  {
    "id": 13,
    "text": "“骨”指表达情志的事理逻辑与刚健挺拔的文辞骨力。",
    "start": 57.724,
    "end": 61.957,
    "duration": 4.233
  },
  {
    "id": 14,
    "text": "曹丕在《典论·论文》中提出“文以气为主，气之清浊有体，不可力强而致”，",
    "start": 62.457,
    "end": 68.361,
    "duration": 5.904
  },
  {
    "id": 15,
    "text": "强调作家的气质才情与作品风貌的密切关联。",
    "start": 68.711,
    "end": 72.26,
    "duration": 3.549
  },
  {
    "id": 16,
    "text": "建安诗人摆脱了两汉经学教条的束缚，直抒胸臆、缘情而发，",
    "start": 72.76,
    "end": 77.527,
    "duration": 4.767
  },
  {
    "id": 17,
    "text": "使诗歌既具悲天悯人的现实忧患，又充满蓬勃刚健的进取精神，",
    "start": 77.877,
    "end": 83.125,
    "duration": 5.248
  },
  {
    "id": 18,
    "text": "形成了悲壮而不消沉、刚健而不浅薄的独特风貌。",
    "start": 83.475,
    "end": 87.507,
    "duration": 4.032
  },
  {
    "id": 19,
    "text": "第二，以“三曹”为核心展现多元艺术风貌，推动五言古诗全面成熟。",
    "start": 88.171,
    "end": 93.967,
    "duration": 5.796
  },
  {
    "id": 20,
    "text": "建安诗坛以曹操、曹丕、曹植父子为核心，形成了同中有异的创作格局。",
    "start": 94.5,
    "end": 99.869,
    "duration": 5.369
  },
  {
    "id": 21,
    "text": "曹操诗歌“古直悲凉”，善用乐府旧题写汉末时事，",
    "start": 100.438,
    "end": 104.705,
    "duration": 4.267
  },
  {
    "id": 22,
    "text": "在《蒿里行》中沉痛写出“白骨露于野，千里无鸡鸣”，",
    "start": 105.173,
    "end": 109.827,
    "duration": 4.654
  },
  {
    "id": 23,
    "text": "在《短歌行》中叹咏“对酒当歌，人生几何”，气象雄浑苍凉；",
    "start": 110.177,
    "end": 115.621,
    "duration": 5.444
  },
  {
    "id": 24,
    "text": "曹丕诗歌“便娟婉约”，其《燕歌行》是中国文学史上现存最早完整的文人七言诗，情致深婉流丽；",
    "start": 116.121,
    "end": 124.335,
    "duration": 8.214
  },
  {
    "id": 25,
    "text": "曹植代表建安诗歌的最高成就，其诗“骨气奇高，词采华茂”，",
    "start": 124.835,
    "end": 130.044,
    "duration": 5.209
  },
  {
    "id": 26,
    "text": "前期《白马篇》歌颂游侠少年报国之志，",
    "start": 130.394,
    "end": 133.679,
    "duration": 3.285
  },
  {
    "id": 27,
    "text": "后期《赠白马王彪》抒发身遭猜忌的抑郁悲愤，将深沉情志与华美词采融为一体。",
    "start": 134.162,
    "end": 141.191,
    "duration": 7.029
  },
  {
    "id": 28,
    "text": "第三，深沉忧生而奋发立功，统一了个体觉醒与济世担当。",
    "start": 141.807,
    "end": 147.183,
    "duration": 5.376
  },
  {
    "id": 29,
    "text": "建安诗歌最动人的思想力量，在于其在清醒体认生命短暂的同时，主动追寻不朽的人生价值。",
    "start": 147.683,
    "end": 155.451,
    "duration": 7.768
  },
  {
    "id": 30,
    "text": "乱世离乱使文人普遍产生生死无常之感，但他们并未沉溺于消极避世，而是选择以建功立业、著书立说对抗流年。",
    "start": 156.036,
    "end": 165.678,
    "duration": 9.642
  },
  {
    "id": 31,
    "text": "曹丕在《典论·论文》中明确提出“年寿有时而尽，荣乐止乎其身……未若文章之无穷”；",
    "start": 166.178,
    "end": 174.044,
    "duration": 7.866
  },
  {
    "id": 32,
    "text": "曹植发出“捐躯赴国难，视死忽如归”的慷慨誓言。",
    "start": 174.544,
    "end": 179.148,
    "duration": 4.604
  },
  {
    "id": 33,
    "text": "这种于悲凉中激荡英雄气概的精神品格，赋予了建安文学超越时代的崇高美感。",
    "start": 179.648,
    "end": 186.37,
    "duration": 6.722
  },
  {
    "id": 34,
    "text": "第四，树立古典诗歌刚健风范，成为后代革新浮靡文风的精神旗帜。",
    "start": 186.975,
    "end": 192.284,
    "duration": 5.309
  },
  {
    "id": 35,
    "text": "建安风骨以其刚健明朗的骨力与充沛真情，成为后世历代诗歌革新运动的重要旗帜。",
    "start": 192.784,
    "end": 199.428,
    "duration": 6.644
  },
  {
    "id": 36,
    "text": "南朝齐梁时期诗歌趋于声色浮艳，",
    "start": 199.928,
    "end": 202.551,
    "duration": 2.623
  },
  {
    "id": 37,
    "text": "初唐陈子昂在《修竹篇序》中疾呼“汉魏风骨，晋宋莫传”，借建安传统扫除齐梁余习；",
    "start": 202.901,
    "end": 209.949,
    "duration": 7.048
  },
  {
    "id": 38,
    "text": "李白亦在《宣州谢朓楼饯别校书叔云》中高唱“蓬莱文章建安骨”。",
    "start": 210.449,
    "end": 215.844,
    "duration": 5.395
  },
  {
    "id": 39,
    "text": "建安风骨所确立的真情实感、刚健气韵与时代担当，",
    "start": 216.344,
    "end": 220.36,
    "duration": 4.016
  },
  {
    "id": 40,
    "text": "成为中国古典诗歌史上薪火相传的宝贵精神财富。",
    "start": 220.71,
    "end": 224.682,
    "duration": 3.972
  },
  {
    "id": 41,
    "text": "综上所述，建安风骨在汉末乱世阵痛中实现了个体生命觉醒与济世抱负的统一，",
    "start": 225.182,
    "end": 231.86,
    "duration": 6.678
  },
  {
    "id": 42,
    "text": "呈现出慷慨悲凉而爽朗刚健的审美气象。",
    "start": 232.305,
    "end": 235.504,
    "duration": 3.199
  },
  {
    "id": 43,
    "text": "“三曹”立足五言古诗与乐府旧题推陈出新，",
    "start": 236.004,
    "end": 239.651,
    "duration": 3.647
  },
  {
    "id": 44,
    "text": "推动文人诗歌告别汉代经学附庸而走向自觉；其重真情、尚风力的诗学传统，",
    "start": 240.001,
    "end": 246.238,
    "duration": 6.237
  },
  {
    "id": 45,
    "text": "成为陈子昂、李白等后代诗人革除浮靡诗风的精神典范。",
    "start": 246.588,
    "end": 251.47,
    "duration": 4.882
  }
]
