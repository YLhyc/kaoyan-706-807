[
  {
    "id": 1,
    "text": "试论“建安风骨”的美学内涵与“三曹”诗歌艺术。",
    "start": 0.078,
    "end": 3.906,
    "duration": 3.828
  },
  {
    "id": 2,
    "text": "汉末魏初是中国文学走向自觉的关键转折时期。",
    "start": 4.339,
    "end": 8.07,
    "duration": 3.731
  },
  {
    "id": 3,
    "text": "面对黄巾起义爆发、",
    "start": 8.693,
    "end": 10.092,
    "duration": 1.399
  },
  {
    "id": 4,
    "text": "军阀割据混战与瘟疫流行造成的社会剧烈动荡，",
    "start": 10.308,
    "end": 14.287,
    "duration": 3.979
  },
  {
    "id": 5,
    "text": "建安文人一方面深感生命苦短与朝不保夕的严峻生存现实，",
    "start": 14.331,
    "end": 19.162,
    "duration": 4.831
  },
  {
    "id": 6,
    "text": "另一方面又怀抱平定天下、建功立业的强烈时代责任感。",
    "start": 19.637,
    "end": 23.939,
    "duration": 4.302
  },
  {
    "id": 7,
    "text": "这种在时代阵痛中迸发出的昂扬志气与深沉忧患，",
    "start": 24.172,
    "end": 28.388,
    "duration": 4.216
  },
  {
    "id": 8,
    "text": "造就了中国诗歌史上极具生命力的 “建安风骨”。",
    "start": 28.574,
    "end": 31.871,
    "duration": 3.297
  },
  {
    "id": 9,
    "text": "鲁迅称这一时期为 “文学的自觉时代”；",
    "start": 32.223,
    "end": 35.193,
    "duration": 2.97
  },
  {
    "id": 10,
    "text": "刘勰在 《文心雕龙·时序》 中赞其 “志深而笔长，",
    "start": 35.538,
    "end": 39.235,
    "duration": 3.697
  },
  {
    "id": 11,
    "text": "故慷慨而多气也”。",
    "start": 39.372,
    "end": 40.623,
    "duration": 1.251
  },
  {
    "id": 12,
    "text": "其美学内涵与三曹诗歌艺术，主要展现为以下四个核心维度：",
    "start": 40.965,
    "end": 45.804,
    "duration": 4.839
  },
  {
    "id": 13,
    "text": "第一，标举“慷慨悲凉”与“爽朗刚健”的美学内涵，",
    "start": 46.015,
    "end": 50.64,
    "duration": 4.625
  },
  {
    "id": 14,
    "text": "确立情志与文辞的高度统一。",
    "start": 50.672,
    "end": 52.903,
    "duration": 2.231
  },
  {
    "id": 15,
    "text": "从美学范畴而言，“建安风骨” 是“风”与“骨”的有机融合。",
    "start": 53.316,
    "end": 57.414,
    "duration": 4.098
  },
  {
    "id": 16,
    "text": "所谓 “风”，指诗歌充沛真挚、",
    "start": 57.775,
    "end": 59.908,
    "duration": 2.133
  },
  {
    "id": 17,
    "text": "感人至深的思想感情与精神力量；所谓 “骨”，",
    "start": 60.087,
    "end": 63.688,
    "duration": 3.601
  },
  {
    "id": 18,
    "text": "指表达这种感情的事理逻辑与刚健挺拔的文辞骨力。",
    "start": 63.872,
    "end": 68.111,
    "duration": 4.239
  },
  {
    "id": 19,
    "text": "曹丕在 《典论·论文》 中提出 “文以气为主，",
    "start": 68.342,
    "end": 71.578,
    "duration": 3.236
  },
  {
    "id": 20,
    "text": "气之清浊有体，不可力强而致”，",
    "start": 71.796,
    "end": 74.468,
    "duration": 2.672
  },
  {
    "id": 21,
    "text": "强调作家的内在生命气质与才情格调。",
    "start": 74.701,
    "end": 77.953,
    "duration": 3.252
  },
  {
    "id": 22,
    "text": "建安诗人摆脱了两汉经学教条的死板束缚，直抒胸臆、",
    "start": 78.375,
    "end": 82.779,
    "duration": 4.404
  },
  {
    "id": 23,
    "text": "缘情而发，使诗歌既具备悲天悯人的现实忧患，",
    "start": 82.899,
    "end": 86.89,
    "duration": 3.991
  },
  {
    "id": 24,
    "text": "又充满蓬勃刚健的进取精神，形成了悲壮而不消沉、",
    "start": 87.055,
    "end": 91.386,
    "duration": 4.331
  },
  {
    "id": 25,
    "text": "刚健而不浅薄的独特风貌。",
    "start": 91.414,
    "end": 93.379,
    "duration": 1.965
  },
  {
    "id": 26,
    "text": "第二，以“三曹”为核心展现多元艺术风貌，",
    "start": 93.613,
    "end": 96.966,
    "duration": 3.353
  },
  {
    "id": 27,
    "text": "推动五言古诗全面走向成熟。",
    "start": 97.337,
    "end": 99.76,
    "duration": 2.423
  },
  {
    "id": 28,
    "text": "建安诗坛以曹操、曹丕、曹植父子为核心领袖，",
    "start": 100.073,
    "end": 104.7,
    "duration": 4.627
  },
  {
    "id": 29,
    "text": "形成了同中有异的创作格局。",
    "start": 104.972,
    "end": 107.315,
    "duration": 2.343
  },
  {
    "id": 30,
    "text": "曹操诗歌风格 “古直悲凉”，善用旧题乐府反映汉末现实，",
    "start": 107.526,
    "end": 112.548,
    "duration": 5.022
  },
  {
    "id": 31,
    "text": "在 《蒿里行》 中以沉痛笔触写出 “白骨露于野，",
    "start": 112.72,
    "end": 116.84,
    "duration": 4.12
  },
  {
    "id": 32,
    "text": "千里无鸡鸣”，在 《短歌行》 中写下 “对酒当歌，",
    "start": 116.979,
    "end": 121.017,
    "duration": 4.038
  },
  {
    "id": 33,
    "text": "人生几何”，气象雄浑、气吞山河；",
    "start": 121.187,
    "end": 124.279,
    "duration": 3.092
  },
  {
    "id": 34,
    "text": "曹丕诗歌风格 “便娟婉约”，",
    "start": 124.481,
    "end": 126.757,
    "duration": 2.276
  },
  {
    "id": 35,
    "text": "其 《燕歌行》 是中国文学史上现存最早成熟的文人七言诗，",
    "start": 126.983,
    "end": 131.801,
    "duration": 4.818
  },
  {
    "id": 36,
    "text": "情致深婉流丽；曹植则代表了建安诗歌的最高成就，",
    "start": 132.033,
    "end": 136.142,
    "duration": 4.109
  },
  {
    "id": 37,
    "text": "其诗 “骨气奇高，词采华茂”，",
    "start": 136.476,
    "end": 139.016,
    "duration": 2.54
  },
  {
    "id": 38,
    "text": "前期 《白马篇》 塑造英勇报国的游侠少年，",
    "start": 139.325,
    "end": 142.504,
    "duration": 3.179
  },
  {
    "id": 39,
    "text": "后期 《赠白马王彪》 展现身遭猜忌的抑郁悲愤，",
    "start": 142.853,
    "end": 146.796,
    "duration": 3.943
  },
  {
    "id": 40,
    "text": "将深沉的情志与华美的藻饰完美结合。",
    "start": 147.175,
    "end": 150.542,
    "duration": 3.367
  },
  {
    "id": 41,
    "text": "第三，贯穿深沉的生命忧患与建功立业抱负，",
    "start": 150.723,
    "end": 154.483,
    "duration": 3.76
  },
  {
    "id": 42,
    "text": "实现个体自觉与社会担当的统一。",
    "start": 154.773,
    "end": 157.481,
    "duration": 2.708
  },
  {
    "id": 43,
    "text": "建安诗歌最震撼人心的思想力量，",
    "start": 157.768,
    "end": 160.174,
    "duration": 2.406
  },
  {
    "id": 44,
    "text": "在于其在深刻体认生命短暂的同时，",
    "start": 160.291,
    "end": 163.38,
    "duration": 3.089
  },
  {
    "id": 45,
    "text": "展现出对永恒价值的主动追寻。",
    "start": 163.466,
    "end": 166.179,
    "duration": 2.713
  },
  {
    "id": 46,
    "text": "乱世中的动荡离乱使文人普遍产生强烈的生死无常之感，",
    "start": 166.383,
    "end": 170.979,
    "duration": 4.596
  },
  {
    "id": 47,
    "text": "但他们并未陷入道家消极避世的虚无泥淖，",
    "start": 171.227,
    "end": 174.472,
    "duration": 3.245
  },
  {
    "id": 48,
    "text": "而是选择以建功立业、著书立说对抗死亡。",
    "start": 174.842,
    "end": 178.343,
    "duration": 3.501
  },
  {
    "id": 49,
    "text": "曹丕明确提出 “年寿有时而尽，",
    "start": 178.561,
    "end": 181.399,
    "duration": 2.838
  },
  {
    "id": 50,
    "text": "荣乐止乎其身……未若文章之无穷”；",
    "start": 181.746,
    "end": 184.835,
    "duration": 3.089
  },
  {
    "id": 51,
    "text": "曹植发出 “捐躯赴国难，视死忽如归” 的慷慨誓言。",
    "start": 184.912,
    "end": 189.226,
    "duration": 4.314
  },
  {
    "id": 52,
    "text": "这种在悲凉中激荡着英雄气概的精神品质，",
    "start": 189.601,
    "end": 192.75,
    "duration": 3.149
  },
  {
    "id": 53,
    "text": "赋予了建安文学超越时代的崇高审美价值。",
    "start": 193.006,
    "end": 196.104,
    "duration": 3.098
  },
  {
    "id": 54,
    "text": "第四，树立中国古典诗歌的刚健风范，",
    "start": 196.505,
    "end": 199.413,
    "duration": 2.908
  },
  {
    "id": 55,
    "text": "成为后代反抗靡丽文风的美学旗帜。",
    "start": 199.716,
    "end": 202.577,
    "duration": 2.861
  },
  {
    "id": 56,
    "text": "建安风骨以其刚健明朗的骨力与充沛的真情，",
    "start": 202.794,
    "end": 206.705,
    "duration": 3.911
  },
  {
    "id": 57,
    "text": "成为后世历代诗歌革新运动的精神渊薮。",
    "start": 206.784,
    "end": 209.882,
    "duration": 3.098
  },
  {
    "id": 58,
    "text": "南朝齐梁时期诗歌走向形式主义与声色浮艳，",
    "start": 210.11,
    "end": 213.916,
    "duration": 3.806
  },
  {
    "id": 59,
    "text": "初唐陈子昂在 《修竹篇序》 中大声疾呼 “汉魏风骨，",
    "start": 214.103,
    "end": 218.209,
    "duration": 4.106
  },
  {
    "id": 60,
    "text": "晋宋莫传”，借建安风骨扫除齐梁余习；",
    "start": 218.269,
    "end": 221.484,
    "duration": 3.215
  },
  {
    "id": 61,
    "text": "李白亦在 《古风》 中高唱 “蓬莱文章建安骨”。",
    "start": 221.681,
    "end": 225.158,
    "duration": 3.477
  },
  {
    "id": 62,
    "text": "建安风骨所确立的真情实感、刚健骨力与时代担当，",
    "start": 225.438,
    "end": 229.628,
    "duration": 4.19
  },
  {
    "id": 63,
    "text": "成为中国古典诗歌优良传统中不可磨灭的精神灯塔。",
    "start": 229.734,
    "end": 234.12,
    "duration": 4.386
  }
]
