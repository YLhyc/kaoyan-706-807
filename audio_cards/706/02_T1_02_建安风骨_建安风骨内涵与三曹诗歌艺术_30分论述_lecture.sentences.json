[
  {
    "id": 1,
    "text": "试论“建安风骨”的美学内涵与“三曹”诗歌艺术。",
    "start": 0.0,
    "end": 4.38,
    "duration": 4.38
  },
  {
    "id": 2,
    "text": "汉末魏初是中国文学走向自觉的关键转折时期。",
    "start": 4.38,
    "end": 8.733,
    "duration": 4.353
  },
  {
    "id": 3,
    "text": "面对黄巾起义爆发、",
    "start": 8.733,
    "end": 10.348,
    "duration": 1.615
  },
  {
    "id": 4,
    "text": "军阀割据混战与瘟疫流行造成的社会剧烈动荡，",
    "start": 10.348,
    "end": 14.371,
    "duration": 4.023
  },
  {
    "id": 5,
    "text": "建安文人一方面深感生命苦短与朝不保夕的严峻生存现实，",
    "start": 14.371,
    "end": 19.679,
    "duration": 5.308
  },
  {
    "id": 6,
    "text": "另一方面又怀抱平定天下、建功立业的强烈时代责任感。",
    "start": 19.679,
    "end": 24.212,
    "duration": 4.533
  },
  {
    "id": 7,
    "text": "这种在时代阵痛中迸发出的昂扬志气与深沉忧患，",
    "start": 24.212,
    "end": 28.614,
    "duration": 4.402
  },
  {
    "id": 8,
    "text": "造就了中国诗歌史上极具生命力的 “建安风骨”。",
    "start": 28.614,
    "end": 33.813,
    "duration": 5.199
  },
  {
    "id": 9,
    "text": "鲁迅称这一时期为 “文学的自觉时代”；",
    "start": 33.813,
    "end": 38.059,
    "duration": 4.246
  },
  {
    "id": 10,
    "text": "刘勰在 《文心雕龙·时序》 中赞其 “志深而笔长，",
    "start": 38.059,
    "end": 41.005,
    "duration": 2.946
  },
  {
    "id": 11,
    "text": "故慷慨而多气也”。",
    "start": 41.005,
    "end": 43.611,
    "duration": 2.606
  },
  {
    "id": 12,
    "text": "其美学内涵与三曹诗歌艺术，主要展现为以下四个核心维度：",
    "start": 43.611,
    "end": 49.609,
    "duration": 5.998
  },
  {
    "id": 13,
    "text": "第一，标举“慷慨悲凉”与“爽朗刚健”的美学内涵，",
    "start": 49.609,
    "end": 54.875,
    "duration": 5.266
  },
  {
    "id": 14,
    "text": "确立情志与文辞的高度统一。",
    "start": 54.875,
    "end": 57.818,
    "duration": 2.943
  },
  {
    "id": 15,
    "text": "从美学范畴而言，“建安风骨” 是“风”与“骨”的有机融合。",
    "start": 57.818,
    "end": 63.912,
    "duration": 6.094
  },
  {
    "id": 16,
    "text": "所谓 “风”，指诗歌充沛真挚、",
    "start": 63.912,
    "end": 68.383,
    "duration": 4.471
  },
  {
    "id": 17,
    "text": "感人至深的思想感情与精神力量；所谓 “骨”，",
    "start": 68.383,
    "end": 73.269,
    "duration": 4.886
  },
  {
    "id": 18,
    "text": "指表达这种感情的事理逻辑与刚健挺拔的文辞骨力。",
    "start": 73.269,
    "end": 78.417,
    "duration": 5.148
  },
  {
    "id": 19,
    "text": "曹丕在 《典论·论文》 中提出 “文以气为主，",
    "start": 78.417,
    "end": 82.014,
    "duration": 3.597
  },
  {
    "id": 20,
    "text": "气之清浊有体，不可力强而致”，",
    "start": 82.014,
    "end": 87.095,
    "duration": 5.081
  },
  {
    "id": 21,
    "text": "强调作家的内在生命气质与才情格调。",
    "start": 87.095,
    "end": 89.508,
    "duration": 2.413
  },
  {
    "id": 22,
    "text": "建安诗人摆脱了两汉经学教条的死板束缚，直抒胸臆、",
    "start": 89.508,
    "end": 94.26,
    "duration": 4.752
  },
  {
    "id": 23,
    "text": "缘情而发，使诗歌既具备悲天悯人的现实忧患，",
    "start": 94.26,
    "end": 100.113,
    "duration": 5.853
  },
  {
    "id": 24,
    "text": "又充满蓬勃刚健的进取精神，形成了悲壮而不消沉、",
    "start": 100.113,
    "end": 105.015,
    "duration": 4.902
  },
  {
    "id": 25,
    "text": "刚健而不浅薄的独特风貌。",
    "start": 105.015,
    "end": 107.571,
    "duration": 2.556
  },
  {
    "id": 26,
    "text": "第二，以“三曹”为核心展现多元艺术风貌，",
    "start": 107.571,
    "end": 112.964,
    "duration": 5.393
  },
  {
    "id": 27,
    "text": "推动五言古诗全面走向成熟。",
    "start": 112.964,
    "end": 115.771,
    "duration": 2.807
  },
  {
    "id": 28,
    "text": "建安诗坛以曹操、曹丕、曹植父子为核心领袖，",
    "start": 115.771,
    "end": 121.227,
    "duration": 5.456
  },
  {
    "id": 29,
    "text": "形成了同中有异的创作格局。",
    "start": 121.227,
    "end": 124.522,
    "duration": 3.295
  },
  {
    "id": 30,
    "text": "曹操诗歌风格 “古直悲凉”，善用旧题乐府反映汉末现实，",
    "start": 124.522,
    "end": 129.29,
    "duration": 4.768
  },
  {
    "id": 31,
    "text": "在 《蒿里行》 中以沉痛笔触写出 “白骨露于野，",
    "start": 129.29,
    "end": 133.595,
    "duration": 4.305
  },
  {
    "id": 32,
    "text": "千里无鸡鸣”，在 《短歌行》 中写下 “对酒当歌，",
    "start": 133.595,
    "end": 136.518,
    "duration": 2.923
  },
  {
    "id": 33,
    "text": "人生几何”，气象雄浑、气吞山河；",
    "start": 136.518,
    "end": 139.365,
    "duration": 2.847
  },
  {
    "id": 34,
    "text": "曹丕诗歌风格 “便娟婉约”，",
    "start": 139.365,
    "end": 142.901,
    "duration": 3.536
  },
  {
    "id": 35,
    "text": "其 《燕歌行》 是中国文学史上现存最早成熟的文人七言诗，",
    "start": 142.901,
    "end": 148.519,
    "duration": 5.618
  },
  {
    "id": 36,
    "text": "情致深婉流丽；曹植则代表了建安诗歌的最高成就，",
    "start": 148.519,
    "end": 153.331,
    "duration": 4.812
  },
  {
    "id": 37,
    "text": "其诗 “骨气奇高，词采华茂”，",
    "start": 153.331,
    "end": 156.176,
    "duration": 2.845
  },
  {
    "id": 38,
    "text": "前期 《白马篇》 塑造英勇报国的游侠少年，",
    "start": 156.176,
    "end": 160.331,
    "duration": 4.155
  },
  {
    "id": 39,
    "text": "后期 《赠白马王彪》 展现身遭猜忌的抑郁悲愤，",
    "start": 160.331,
    "end": 163.533,
    "duration": 3.202
  },
  {
    "id": 40,
    "text": "将深沉的情志与华美的藻饰完美结合。",
    "start": 163.533,
    "end": 167.992,
    "duration": 4.459
  },
  {
    "id": 41,
    "text": "第三，贯穿深沉的生命忧患与建功立业抱负，",
    "start": 167.992,
    "end": 171.267,
    "duration": 3.275
  },
  {
    "id": 42,
    "text": "实现个体自觉与社会担当的统一。",
    "start": 171.267,
    "end": 174.882,
    "duration": 3.615
  },
  {
    "id": 43,
    "text": "建安诗歌最震撼人心的思想力量，",
    "start": 174.882,
    "end": 178.601,
    "duration": 3.719
  },
  {
    "id": 44,
    "text": "在于其在深刻体认生命短暂的同时，",
    "start": 178.601,
    "end": 180.161,
    "duration": 1.56
  },
  {
    "id": 45,
    "text": "展现出对永恒价值的主动追寻。",
    "start": 180.161,
    "end": 181.79,
    "duration": 1.629
  },
  {
    "id": 46,
    "text": "乱世中的动荡离乱使文人普遍产生强烈的生死无常之感，",
    "start": 181.79,
    "end": 183.423,
    "duration": 1.633
  },
  {
    "id": 47,
    "text": "但他们并未陷入道家消极避世的虚无泥淖，",
    "start": 183.423,
    "end": 186.068,
    "duration": 2.645
  },
  {
    "id": 48,
    "text": "而是选择以建功立业、著书立说对抗死亡。",
    "start": 186.068,
    "end": 187.354,
    "duration": 1.286
  },
  {
    "id": 49,
    "text": "曹丕明确提出 “年寿有时而尽，",
    "start": 187.354,
    "end": 189.641,
    "duration": 2.287
  },
  {
    "id": 50,
    "text": "荣乐止乎其身……未若文章之无穷”；",
    "start": 189.641,
    "end": 193.056,
    "duration": 3.415
  },
  {
    "id": 51,
    "text": "曹植发出 “捐躯赴国难，视死忽如归” 的慷慨誓言。",
    "start": 193.056,
    "end": 196.545,
    "duration": 3.489
  },
  {
    "id": 52,
    "text": "这种在悲凉中激荡着英雄气概的精神品质，",
    "start": 196.545,
    "end": 197.242,
    "duration": 0.697
  },
  {
    "id": 53,
    "text": "赋予了建安文学超越时代的崇高审美价值。",
    "start": 197.242,
    "end": 199.758,
    "duration": 2.516
  },
  {
    "id": 54,
    "text": "第四，树立中国古典诗歌的刚健风范，",
    "start": 199.758,
    "end": 202.839,
    "duration": 3.081
  },
  {
    "id": 55,
    "text": "成为后代反抗靡丽文风的美学旗帜。",
    "start": 202.839,
    "end": 210.15,
    "duration": 7.311
  },
  {
    "id": 56,
    "text": "建安风骨以其刚健明朗的骨力与充沛的真情，",
    "start": 210.15,
    "end": 212.987,
    "duration": 2.837
  },
  {
    "id": 57,
    "text": "成为后世历代诗歌革新运动的精神渊薮。",
    "start": 212.987,
    "end": 214.143,
    "duration": 1.156
  },
  {
    "id": 58,
    "text": "南朝齐梁时期诗歌走向形式主义与声色浮艳，",
    "start": 214.143,
    "end": 221.721,
    "duration": 7.578
  },
  {
    "id": 59,
    "text": "初唐陈子昂在 《修竹篇序》 中大声疾呼 “汉魏风骨，",
    "start": 221.721,
    "end": 225.478,
    "duration": 3.757
  },
  {
    "id": 60,
    "text": "晋宋莫传”，借建安风骨扫除齐梁余习；",
    "start": 225.478,
    "end": 227.872,
    "duration": 2.394
  },
  {
    "id": 61,
    "text": "李白亦在 《古风》 中高唱 “蓬莱文章建安骨”。",
    "start": 227.872,
    "end": 229.774,
    "duration": 1.902
  },
  {
    "id": 62,
    "text": "建安风骨所确立的真情实感、刚健骨力与时代担当，",
    "start": 229.774,
    "end": 232.377,
    "duration": 2.603
  },
  {
    "id": 63,
    "text": "成为中国古典诗歌优良传统中不可磨灭的精神灯塔。",
    "start": 232.377,
    "end": 233.897,
    "duration": 1.52
  }
]