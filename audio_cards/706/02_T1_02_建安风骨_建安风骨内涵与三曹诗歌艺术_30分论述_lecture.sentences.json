[
  {
    "id": 1,
    "text": "试论“建安风骨”的美学内涵与“三曹”诗歌艺术。",
    "start": 0.05,
    "end": 4.359,
    "duration": 4.309
  },
  {
    "id": 2,
    "text": "汉末魏初是中国文学走向自觉的关键转折时期。",
    "start": 4.359,
    "end": 8.703,
    "duration": 4.344
  },
  {
    "id": 3,
    "text": "面对黄巾起义爆发、",
    "start": 8.703,
    "end": 10.318,
    "duration": 1.615
  },
  {
    "id": 4,
    "text": "军阀割据混战与瘟疫流行造成的社会剧烈动荡，",
    "start": 10.318,
    "end": 14.342,
    "duration": 4.024
  },
  {
    "id": 5,
    "text": "建安文人一方面深感生命苦短与朝不保夕的严峻生存现实，",
    "start": 14.342,
    "end": 19.649,
    "duration": 5.307
  },
  {
    "id": 6,
    "text": "另一方面又怀抱平定天下、建功立业的强烈时代责任感。",
    "start": 19.649,
    "end": 24.182,
    "duration": 4.533
  },
  {
    "id": 7,
    "text": "这种在时代阵痛中迸发出的昂扬志气与深沉忧患，",
    "start": 24.182,
    "end": 28.584,
    "duration": 4.402
  },
  {
    "id": 8,
    "text": "造就了中国诗歌史上极具生命力的 “建安风骨”。",
    "start": 28.584,
    "end": 33.783,
    "duration": 5.199
  },
  {
    "id": 9,
    "text": "鲁迅称这一时期为 “文学的自觉时代”；",
    "start": 33.783,
    "end": 38.029,
    "duration": 4.246
  },
  {
    "id": 10,
    "text": "刘勰在 《文心雕龙·时序》 中赞其 “志深而笔长，",
    "start": 38.029,
    "end": 42.111,
    "duration": 4.082
  },
  {
    "id": 11,
    "text": "故慷慨而多气也”。",
    "start": 42.111,
    "end": 43.581,
    "duration": 1.47
  },
  {
    "id": 12,
    "text": "其美学内涵与三曹诗歌艺术，主要展现为以下四个核心维度：",
    "start": 43.581,
    "end": 49.579,
    "duration": 5.998
  },
  {
    "id": 13,
    "text": "第一，标举“慷慨悲凉”与“爽朗刚健”的美学内涵，",
    "start": 49.579,
    "end": 53.327,
    "duration": 3.748
  },
  {
    "id": 14,
    "text": "确立情志与文辞的高度统一。",
    "start": 53.327,
    "end": 55.508,
    "duration": 2.181
  },
  {
    "id": 15,
    "text": "从美学范畴而言，“建安风骨” 是“风”与“骨”的有机融合。",
    "start": 55.508,
    "end": 60.097,
    "duration": 4.589
  },
  {
    "id": 16,
    "text": "所谓 “风”，指诗歌充沛真挚、",
    "start": 60.097,
    "end": 63.041,
    "duration": 2.944
  },
  {
    "id": 17,
    "text": "感人至深的思想感情与精神力量；所谓 “骨”，",
    "start": 63.041,
    "end": 66.132,
    "duration": 3.091
  },
  {
    "id": 18,
    "text": "指表达这种感情的事理逻辑与刚健挺拔的文辞骨力。",
    "start": 66.132,
    "end": 70.577,
    "duration": 4.445
  },
  {
    "id": 19,
    "text": "曹丕在 《典论·论文》 中提出 “文以气为主，",
    "start": 70.577,
    "end": 74.713,
    "duration": 4.136
  },
  {
    "id": 20,
    "text": "气之清浊有体，不可力强而致”，",
    "start": 74.713,
    "end": 77.005,
    "duration": 2.292
  },
  {
    "id": 21,
    "text": "强调作家的内在生命气质与才情格调。",
    "start": 77.005,
    "end": 79.914,
    "duration": 2.909
  },
  {
    "id": 22,
    "text": "建安诗人摆脱了两汉经学教条的死板束缚，直抒胸臆、",
    "start": 79.914,
    "end": 84.258,
    "duration": 4.344
  },
  {
    "id": 23,
    "text": "缘情而发，使诗歌既具备悲天悯人的现实忧患，",
    "start": 84.258,
    "end": 89.479,
    "duration": 5.221
  },
  {
    "id": 24,
    "text": "又充满蓬勃刚健的进取精神，形成了悲壮而不消沉、",
    "start": 89.479,
    "end": 93.623,
    "duration": 4.144
  },
  {
    "id": 25,
    "text": "刚健而不浅薄的独特风貌。",
    "start": 93.623,
    "end": 95.623,
    "duration": 2.0
  },
  {
    "id": 26,
    "text": "第二，以“三曹”为核心展现多元艺术风貌，",
    "start": 95.623,
    "end": 100.083,
    "duration": 4.46
  },
  {
    "id": 27,
    "text": "推动五言古诗全面走向成熟。",
    "start": 100.083,
    "end": 102.781,
    "duration": 2.698
  },
  {
    "id": 28,
    "text": "建安诗坛以曹操、曹丕、曹植父子为核心领袖，",
    "start": 102.781,
    "end": 106.054,
    "duration": 3.273
  },
  {
    "id": 29,
    "text": "形成了同中有异的创作格局。",
    "start": 106.054,
    "end": 109.036,
    "duration": 2.982
  },
  {
    "id": 30,
    "text": "曹操诗歌风格 “古直悲凉”，善用旧题乐府反映汉末现实，",
    "start": 109.036,
    "end": 114.096,
    "duration": 5.06
  },
  {
    "id": 31,
    "text": "在 《蒿里行》 中以沉痛笔触写出 “白骨露于野，",
    "start": 114.096,
    "end": 118.624,
    "duration": 4.528
  },
  {
    "id": 32,
    "text": "千里无鸡鸣”，在 《短歌行》 中写下 “对酒当歌，",
    "start": 118.624,
    "end": 121.533,
    "duration": 2.909
  },
  {
    "id": 33,
    "text": "人生几何”，气象雄浑、气吞山河；",
    "start": 121.533,
    "end": 124.495,
    "duration": 2.962
  },
  {
    "id": 34,
    "text": "曹丕诗歌风格 “便娟婉约”，",
    "start": 124.495,
    "end": 126.993,
    "duration": 2.498
  },
  {
    "id": 35,
    "text": "其 《燕歌行》 是中国文学史上现存最早成熟的文人七言诗，",
    "start": 126.993,
    "end": 131.175,
    "duration": 4.182
  },
  {
    "id": 36,
    "text": "情致深婉流丽；曹植则代表了建安诗歌的最高成就，",
    "start": 131.175,
    "end": 134.993,
    "duration": 3.818
  },
  {
    "id": 37,
    "text": "其诗 “骨气奇高，词采华茂”，",
    "start": 134.993,
    "end": 138.109,
    "duration": 3.116
  },
  {
    "id": 38,
    "text": "前期 《白马篇》 塑造英勇报国的游侠少年，",
    "start": 138.109,
    "end": 141.018,
    "duration": 2.909
  },
  {
    "id": 39,
    "text": "后期 《赠白马王彪》 展现身遭猜忌的抑郁悲愤，",
    "start": 141.018,
    "end": 144.455,
    "duration": 3.437
  },
  {
    "id": 40,
    "text": "将深沉的情志与华美的藻饰完美结合。",
    "start": 144.455,
    "end": 148.49,
    "duration": 4.035
  },
  {
    "id": 41,
    "text": "第三，贯穿深沉的生命忧患与建功立业抱负，",
    "start": 148.49,
    "end": 153.302,
    "duration": 4.812
  },
  {
    "id": 42,
    "text": "实现个体自觉与社会担当的统一。",
    "start": 153.302,
    "end": 156.146,
    "duration": 2.844
  },
  {
    "id": 43,
    "text": "建安诗歌最震撼人心的思想力量，",
    "start": 156.146,
    "end": 158.692,
    "duration": 2.546
  },
  {
    "id": 44,
    "text": "在于其在深刻体认生命短暂的同时，",
    "start": 158.692,
    "end": 161.419,
    "duration": 2.727
  },
  {
    "id": 45,
    "text": "展现出对永恒价值的主动追寻。",
    "start": 161.419,
    "end": 164.388,
    "duration": 2.969
  },
  {
    "id": 46,
    "text": "乱世中的动荡离乱使文人普遍产生强烈的生死无常之感，",
    "start": 164.388,
    "end": 171.237,
    "duration": 6.849
  },
  {
    "id": 47,
    "text": "但他们并未陷入道家消极避世的虚无泥淖，",
    "start": 171.237,
    "end": 174.852,
    "duration": 3.615
  },
  {
    "id": 48,
    "text": "而是选择以建功立业、著书立说对抗死亡。",
    "start": 174.852,
    "end": 178.574,
    "duration": 3.722
  },
  {
    "id": 49,
    "text": "曹丕明确提出 “年寿有时而尽，",
    "start": 178.574,
    "end": 180.756,
    "duration": 2.182
  },
  {
    "id": 50,
    "text": "荣乐止乎其身……未若文章之无穷”；",
    "start": 180.756,
    "end": 183.395,
    "duration": 2.639
  },
  {
    "id": 51,
    "text": "曹植发出 “捐躯赴国难，视死忽如归” 的慷慨誓言。",
    "start": 183.395,
    "end": 187.324,
    "duration": 3.929
  },
  {
    "id": 52,
    "text": "这种在悲凉中激荡着英雄气概的精神品质，",
    "start": 187.324,
    "end": 190.895,
    "duration": 3.571
  },
  {
    "id": 53,
    "text": "赋予了建安文学超越时代的崇高审美价值。",
    "start": 190.895,
    "end": 196.515,
    "duration": 5.62
  },
  {
    "id": 54,
    "text": "第四，树立中国古典诗歌的刚健风范，",
    "start": 196.515,
    "end": 199.728,
    "duration": 3.213
  },
  {
    "id": 55,
    "text": "成为后代反抗靡丽文风的美学旗帜。",
    "start": 199.728,
    "end": 202.809,
    "duration": 3.081
  },
  {
    "id": 56,
    "text": "建安风骨以其刚健明朗的骨力与充沛的真情，",
    "start": 202.809,
    "end": 206.984,
    "duration": 4.175
  },
  {
    "id": 57,
    "text": "成为后世历代诗歌革新运动的精神渊薮。",
    "start": 206.984,
    "end": 210.122,
    "duration": 3.138
  },
  {
    "id": 58,
    "text": "南朝齐梁时期诗歌走向形式主义与声色浮艳，",
    "start": 210.122,
    "end": 214.113,
    "duration": 3.991
  },
  {
    "id": 59,
    "text": "初唐陈子昂在 《修竹篇序》 中大声疾呼 “汉魏风骨，",
    "start": 214.113,
    "end": 218.285,
    "duration": 4.172
  },
  {
    "id": 60,
    "text": "晋宋莫传”，借建安风骨扫除齐梁余习；",
    "start": 218.285,
    "end": 221.691,
    "duration": 3.406
  },
  {
    "id": 61,
    "text": "李白亦在 《古风》 中高唱 “蓬莱文章建安骨”。",
    "start": 221.691,
    "end": 225.458,
    "duration": 3.767
  },
  {
    "id": 62,
    "text": "建安风骨所确立的真情实感、刚健骨力与时代担当，",
    "start": 225.458,
    "end": 229.744,
    "duration": 4.286
  },
  {
    "id": 63,
    "text": "成为中国古典诗歌优良传统中不可磨灭的精神灯塔。",
    "start": 229.744,
    "end": 234.12,
    "duration": 4.376
  }
]