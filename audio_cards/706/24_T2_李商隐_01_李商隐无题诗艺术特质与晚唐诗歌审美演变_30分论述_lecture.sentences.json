[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 3.44,
    "duration": 3.36
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 3.44,
    "end": 6.48,
    "duration": 3.04
  },
  {
    "id": 3,
    "text": "这道题考查晚唐诗歌集大成者李商隐的无题诗美学。",
    "start": 6.64,
    "end": 11.6,
    "duration": 4.96
  },
  {
    "id": 4,
    "text": "在考场上，考生不能简单只是翻译两首无题诗，",
    "start": 11.6,
    "end": 15.44,
    "duration": 3.84
  },
  {
    "id": 5,
    "text": "而必须抓住两个核心：一是无题诗本体的“朦胧多义、",
    "start": 15.44,
    "end": 20.0,
    "duration": 4.56
  },
  {
    "id": 6,
    "text": "意象拼贴与律诗精纯”；",
    "start": 20.0,
    "end": 21.92,
    "duration": 1.92
  },
  {
    "id": 7,
    "text": "二是其在唐代诗歌审美演变中的历史位置（从盛唐宏阔到晚唐内向感伤）。",
    "start": 22.24,
    "end": 28.64,
    "duration": 6.4
  },
  {
    "id": 8,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 28.64,
    "end": 31.6,
    "duration": 2.96
  },
  {
    "id": 9,
    "text": "答题必须确立“文本本体剖析、趋近于、",
    "start": 31.6,
    "end": 34.794,
    "duration": 3.194
  },
  {
    "id": 10,
    "text": "审美形态溯源、趋近于、诗歌史转型定位”的三维演进路线。",
    "start": 34.794,
    "end": 40.266,
    "duration": 5.472
  },
  {
    "id": 11,
    "text": "从寄托多义性切入，深入《锦瑟》《无题》的意象与律诗本体，",
    "start": 40.266,
    "end": 45.5,
    "duration": 5.234
  },
  {
    "id": 12,
    "text": "然后横向联系盛唐、中唐，纵向论述晚唐审美由外向内退缩的心态机制。",
    "start": 45.5,
    "end": 52.4,
    "duration": 6.9
  },
  {
    "id": 13,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 52.48,
    "end": 55.92,
    "duration": 3.44
  },
  {
    "id": 14,
    "text": "全题分为四个核心论述维度：第一维度：界定李商隐无题诗作为近体律诗心灵表现最高峰的文学史坐标；",
    "start": 55.92,
    "end": 65.12,
    "duration": 9.2
  },
  {
    "id": 15,
    "text": "第二维度：深入剖析朦胧多义、似情非情的身世寄托与象征阐释机制；",
    "start": 65.12,
    "end": 72.08,
    "duration": 6.96
  },
  {
    "id": 16,
    "text": "第三维度：精细剖析《锦瑟》等代表作沉博绝丽的意象拼贴与近体七律形式美；",
    "start": 72.08,
    "end": 78.72,
    "duration": 6.64
  },
  {
    "id": 17,
    "text": "第四维度：深刻对比盛唐、中唐与晚唐，",
    "start": 79.12,
    "end": 82.64,
    "duration": 3.52
  },
  {
    "id": 18,
    "text": "揭示由外向功业向心灵幽微退缩的审美转型；",
    "start": 82.64,
    "end": 87.04,
    "duration": 4.4
  },
  {
    "id": 19,
    "text": "第五维度：宏观总结李商隐对古典抒情传统深化与宋词发端的深远价值。",
    "start": 87.04,
    "end": 93.6,
    "duration": 6.56
  },
  {
    "id": 20,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 93.6,
    "end": 97.6,
    "duration": 4.0
  },
  {
    "id": 21,
    "text": "全题逻辑严密咬合：第一步先确立无题诗的心灵表现巅峰地位。",
    "start": 97.6,
    "end": 103.36,
    "duration": 5.76
  },
  {
    "id": 22,
    "text": "第二步剖析无题诗最显著的表面特征，",
    "start": 103.6,
    "end": 106.48,
    "duration": 2.88
  },
  {
    "id": 23,
    "text": "即题旨朦胧与多义寄托。",
    "start": 106.48,
    "end": 108.72,
    "duration": 2.24
  },
  {
    "id": 24,
    "text": "第三步深入其艺术载体，剖析典丽意象与七律格律。",
    "start": 108.72,
    "end": 113.2,
    "duration": 4.48
  },
  {
    "id": 25,
    "text": "第四步探究这种艺术风格为什么会在晚唐诞生，",
    "start": 113.2,
    "end": 116.8,
    "duration": 3.6
  },
  {
    "id": 26,
    "text": "对比盛唐气象讲透晚唐心态退缩。",
    "start": 116.8,
    "end": 119.84,
    "duration": 3.04
  },
  {
    "id": 27,
    "text": "第五步完成宏观历史论证闭环。",
    "start": 119.84,
    "end": 122.0,
    "duration": 2.16
  },
  {
    "id": 28,
    "text": "二、各板块逐句咬合演练。",
    "start": 122.4,
    "end": 125.44,
    "duration": 3.04
  },
  {
    "id": 29,
    "text": "一、开头破题段内部咬合。",
    "start": 125.44,
    "end": 128.16,
    "duration": 2.72
  },
  {
    "id": 30,
    "text": "本段旨在开门见山确立心灵抒情高峰的立论基石。",
    "start": 128.16,
    "end": 133.12,
    "duration": 4.96
  },
  {
    "id": 31,
    "text": "首句直切经典地位，次句交代晚唐审美转型。",
    "start": 133.12,
    "end": 137.36,
    "duration": 4.24
  },
  {
    "id": 32,
    "text": "-首先，首句必须直接亮出该诗人群体在近体诗发展中的最高峰孪，",
    "start": 137.664,
    "end": 143.61,
    "duration": 5.946
  },
  {
    "id": 33,
    "text": "具体表述到答题语句就是：晚唐诗人李商隐是中国古典抒情诗史上独树一帜的天才大家，",
    "start": 143.61,
    "end": 151.757,
    "duration": 8.147
  },
  {
    "id": 34,
    "text": "其创造的“无题诗”群体代表了唐代近体律诗在表现心灵幽微体验上的最高峰孪。",
    "start": 151.757,
    "end": 159.024,
    "duration": 7.267
  },
  {
    "id": 35,
    "text": "-有了经典定性之后，次句必须迅速说明其打破直白范式、",
    "start": 159.024,
    "end": 163.975,
    "duration": 4.951
  },
  {
    "id": 36,
    "text": "折射审美转型的学术意义，具体表述到答题语句就是：李商隐以其沉博绝丽的辞采与迷离朦胧的象征意象，",
    "start": 163.975,
    "end": 173.446,
    "duration": 9.471
  },
  {
    "id": 37,
    "text": "彻底打破了传统诗歌直白写实与单纯比兴的规约，",
    "start": 173.446,
    "end": 177.966,
    "duration": 4.52
  },
  {
    "id": 38,
    "text": "深刻折射了晚唐士人在帝国衰颓历史语境中心灵内向化的审美转型。，",
    "start": 177.966,
    "end": 184.208,
    "duration": 6.242
  },
  {
    "id": 39,
    "text": "这句话干脆利落地将艺术本体与晚唐时代紧密咬合。",
    "start": 184.208,
    "end": 188.944,
    "duration": 4.736
  },
  {
    "id": 40,
    "text": "晚唐诗人李商隐是中国古典抒情诗史上独树一帜的天才大家，",
    "start": 189.024,
    "end": 194.464,
    "duration": 5.44
  },
  {
    "id": 41,
    "text": "其创造的“无题诗”群体代表了唐代近体律诗在表现心灵幽微体验上的最高峰孪。",
    "start": 194.464,
    "end": 201.504,
    "duration": 7.04
  },
  {
    "id": 42,
    "text": "李商隐以其沉博绝丽的辞采与迷离朦胧的象征意象，",
    "start": 201.504,
    "end": 206.304,
    "duration": 4.8
  },
  {
    "id": 43,
    "text": "彻底打破了传统诗歌直白写实与单纯比兴的规约，",
    "start": 206.304,
    "end": 211.024,
    "duration": 4.72
  },
  {
    "id": 44,
    "text": "深刻折射了晚唐士人在帝国衰颓历史语境中心灵内向化的审美转型。",
    "start": 211.024,
    "end": 216.784,
    "duration": 5.76
  },
  {
    "id": 45,
    "text": "二、第一维度：朦胧多义寄托与象征机制内部咬合。",
    "start": 217.184,
    "end": 221.664,
    "duration": 4.48
  },
  {
    "id": 46,
    "text": "本段任务是深入剖析题旨多义性，以元好问评语与春蚕蜡炬名句为支撑。",
    "start": 221.664,
    "end": 228.064,
    "duration": 6.4
  },
  {
    "id": 47,
    "text": "首先，段首给出结论先行的分论点，",
    "start": 228.064,
    "end": 231.024,
    "duration": 2.96
  },
  {
    "id": 48,
    "text": "具体表述到答题语句就是：第一，在思想寄托与意蕴生成上，",
    "start": 231.024,
    "end": 236.064,
    "duration": 5.04
  },
  {
    "id": 49,
    "text": "李商隐无题诗开创了朦胧多义、隐微难测的象征表现范式。",
    "start": 236.064,
    "end": 240.704,
    "duration": 4.64
  },
  {
    "id": 50,
    "text": "-随后，剖析诗题隐去具体事件的机制，",
    "start": 240.944,
    "end": 244.173,
    "duration": 3.229
  },
  {
    "id": 51,
    "text": "具体表述到答题语句就是：诗人在诗题上或标以“无题”，",
    "start": 244.173,
    "end": 248.908,
    "duration": 4.735
  },
  {
    "id": 52,
    "text": "或截取首句二字为题，刻意隐去具体写作背景与现实寄托对象，",
    "start": 248.908,
    "end": 254.505,
    "duration": 5.597
  },
  {
    "id": 53,
    "text": "使得诗歌摆脱了单一事件的具象束缚。",
    "start": 254.505,
    "end": 257.949,
    "duration": 3.444
  },
  {
    "id": 54,
    "text": "紧接着，引用元好问名言做论据支撑，",
    "start": 257.949,
    "end": 261.178,
    "duration": 3.229
  },
  {
    "id": 55,
    "text": "具体表述到答题语句就是：金代元好问曾感叹“诗家总爱西昆好，",
    "start": 261.178,
    "end": 266.774,
    "duration": 5.596
  },
  {
    "id": 56,
    "text": "独恨无人作郑笺”，正揭示出其多义含蓄的特质。",
    "start": 266.774,
    "end": 270.864,
    "duration": 4.09
  },
  {
    "id": 57,
    "text": "-随后，深入剖析爱情与党争仕途的身世互渗，",
    "start": 270.864,
    "end": 274.968,
    "duration": 4.104
  },
  {
    "id": 58,
    "text": "具体表述到答题语句就是：在这些诗篇中，",
    "start": 274.968,
    "end": 278.844,
    "duration": 3.876
  },
  {
    "id": 59,
    "text": "执着凄艳的男女爱恋与幽微深沉的政治身世感慨深度交融。",
    "start": 278.844,
    "end": 284.544,
    "duration": 5.7
  },
  {
    "id": 60,
    "text": "-紧接着，调取名句展开深层推演：以《无题•相见时难别亦难》为例，",
    "start": 284.592,
    "end": 290.148,
    "duration": 5.556
  },
  {
    "id": 61,
    "text": "“春蚕到死丝方尽，蜡炬成灰泪始干”既是对至死不渝爱情的生命誓言，",
    "start": 290.148,
    "end": 296.37,
    "duration": 6.222
  },
  {
    "id": 62,
    "text": "亦深层折射出诗人在牛李党争夹缝中忠贞自守却终生碰壁的仕途悲歌。",
    "start": 296.37,
    "end": 303.036,
    "duration": 6.666
  },
  {
    "id": 63,
    "text": "最后，收束提炼该手法的文学价值：这种“似情非情，",
    "start": 303.036,
    "end": 307.481,
    "duration": 4.445
  },
  {
    "id": 64,
    "text": "兼含寄托”的意蕴膜糊性，极大地拓展了诗歌的阐释空间。",
    "start": 307.481,
    "end": 312.592,
    "duration": 5.111
  },
  {
    "id": 65,
    "text": "第一，在思想寄托与意蕴生成上，李商隐无题诗开创了朦胧多义、",
    "start": 312.672,
    "end": 318.512,
    "duration": 5.84
  },
  {
    "id": 66,
    "text": "隐微难测的象征表现范式。",
    "start": 318.512,
    "end": 320.992,
    "duration": 2.48
  },
  {
    "id": 67,
    "text": "诗人在诗题上或标以“无题”，或截取首句二字为题，",
    "start": 320.992,
    "end": 325.632,
    "duration": 4.64
  },
  {
    "id": 68,
    "text": "刻意隐去具体写作背景与现实寄托对象，",
    "start": 325.632,
    "end": 329.152,
    "duration": 3.52
  },
  {
    "id": 69,
    "text": "使得诗歌摆脱了单一事件的具象束缚。",
    "start": 329.152,
    "end": 332.112,
    "duration": 2.96
  },
  {
    "id": 70,
    "text": "金代元好问曾感叹“诗家总爱西昆好，",
    "start": 332.352,
    "end": 335.712,
    "duration": 3.36
  },
  {
    "id": 71,
    "text": "独恨无人作郑笺”，正揭示出其多义含蓄的特质。",
    "start": 335.712,
    "end": 339.792,
    "duration": 4.08
  },
  {
    "id": 72,
    "text": "在这些诗篇中，执着凄艳的男女爱恋与幽微深沉的政治身世感慨深度交融。",
    "start": 339.792,
    "end": 345.792,
    "duration": 6.0
  },
  {
    "id": 73,
    "text": "以《无题•相见时难别亦难》为例，",
    "start": 345.792,
    "end": 348.352,
    "duration": 2.56
  },
  {
    "id": 74,
    "text": "“春蚕到死丝方尽，蜡炬成灰泪始干”既是对至死不渝爱情的生命誓言，",
    "start": 348.352,
    "end": 354.512,
    "duration": 6.16
  },
  {
    "id": 75,
    "text": "亦深层折射出诗人在牛李党争夹缝中忠贞自守却终生碰壁的仕途悲歌。",
    "start": 354.512,
    "end": 360.352,
    "duration": 5.84
  },
  {
    "id": 76,
    "text": "这种“似情非情，兼含寄托”的意蕴膜糊性，",
    "start": 360.592,
    "end": 364.112,
    "duration": 3.52
  },
  {
    "id": 77,
    "text": "极大地拓展了诗歌的阐释空间。",
    "start": 364.112,
    "end": 366.592,
    "duration": 2.48
  },
  {
    "id": 78,
    "text": "三、第二维度：沉博绝丽意象营构与精严律体内部咬合。",
    "start": 366.592,
    "end": 371.152,
    "duration": 4.56
  },
  {
    "id": 79,
    "text": "本段任务是落脚于《锦瑟》名篇，逐联解剖典丽意象与通感手法。",
    "start": 371.152,
    "end": 376.512,
    "duration": 5.36
  },
  {
    "id": 80,
    "text": "首先，段首给出统领分论点，具体表述到答题语句就是：第二，",
    "start": 376.512,
    "end": 381.472,
    "duration": 4.96
  },
  {
    "id": 81,
    "text": "在艺术造境与意象营构上，作品展现出沉博绝丽、",
    "start": 381.472,
    "end": 385.552,
    "duration": 4.08
  },
  {
    "id": 82,
    "text": "神思飞越的意象拼贴手法与精纯老到的七律技巧。",
    "start": 385.552,
    "end": 389.632,
    "duration": 4.08
  },
  {
    "id": 83,
    "text": "-随后，说明神话典故跨度极大的并置手法，",
    "start": 389.712,
    "end": 393.426,
    "duration": 3.714
  },
  {
    "id": 84,
    "text": "具体表述到答题语句就是：李商隐极善于调动神话传说、",
    "start": 393.426,
    "end": 398.45,
    "duration": 5.024
  },
  {
    "id": 85,
    "text": "历史典故与虚幻梦境，将跨度极大的意象非逻辑地组接在一起，",
    "start": 398.45,
    "end": 404.13,
    "duration": 5.68
  },
  {
    "id": 86,
    "text": "营构出幽艳迷离的心理时空。",
    "start": 404.13,
    "end": 406.752,
    "duration": 2.622
  },
  {
    "id": 87,
    "text": "-紧接着，调取《锦瑟》进行微观文本剖析，",
    "start": 406.8,
    "end": 410.377,
    "duration": 3.577
  },
  {
    "id": 88,
    "text": "具体表述到答题语句就是：其晚年压卷之作《锦瑟》堪称此中绝唱。",
    "start": 410.377,
    "end": 416.578,
    "duration": 6.201
  },
  {
    "id": 89,
    "text": "首联“锦瑟无端五十弦，一弦一柱思华年”以乐器引发生命回望。",
    "start": 416.578,
    "end": 422.54,
    "duration": 5.962
  },
  {
    "id": 90,
    "text": "汉联“庄生晓梦迷蝴蝶，望帝春心托杜娟”，",
    "start": 422.54,
    "end": 426.356,
    "duration": 3.816
  },
  {
    "id": 91,
    "text": "将庄周化蝶之虚无迷惘与望帝啼血之执着凄绝奇妙并置。",
    "start": 426.356,
    "end": 432.08,
    "duration": 5.724
  },
  {
    "id": 92,
    "text": "颈联“沧海月明珠有泪，蓝田日暖玉生烟”，",
    "start": 432.16,
    "end": 436.64,
    "duration": 4.48
  },
  {
    "id": 93,
    "text": "更是将冷暖、明暗、涕泪与精魂融铸为如梦似幻的通感画面，",
    "start": 436.64,
    "end": 443.04,
    "duration": 6.4
  },
  {
    "id": 94,
    "text": "达到了物我两忘、沉潜深微的极致境界。",
    "start": 443.04,
    "end": 446.8,
    "duration": 3.76
  },
  {
    "id": 95,
    "text": "最后，点睛近体七律的森严法度：同时，",
    "start": 446.8,
    "end": 450.32,
    "duration": 3.52
  },
  {
    "id": 96,
    "text": "诗人严格恪守近体七言律诗的音律节奏，",
    "start": 450.32,
    "end": 453.76,
    "duration": 3.44
  },
  {
    "id": 97,
    "text": "平仄严谨，对仗工稳，展现出出神入化的形式驾驭力。",
    "start": 453.76,
    "end": 458.08,
    "duration": 4.32
  },
  {
    "id": 98,
    "text": "第二，在艺术造境与意象营构上，作品展现出沉博绝丽、",
    "start": 458.4,
    "end": 463.28,
    "duration": 4.88
  },
  {
    "id": 99,
    "text": "神思飞越的意象拼贴手法与精纯老到的七律技巧。",
    "start": 463.28,
    "end": 467.68,
    "duration": 4.4
  },
  {
    "id": 100,
    "text": "李商隐极善于调动神话传说、历史典故与虚幻梦境，",
    "start": 467.68,
    "end": 472.16,
    "duration": 4.48
  },
  {
    "id": 101,
    "text": "将跨度极大的意象非逻辑地组接在一起，",
    "start": 472.16,
    "end": 475.52,
    "duration": 3.36
  },
  {
    "id": 102,
    "text": "营构出幽艳迷离的心理时空。",
    "start": 475.52,
    "end": 477.76,
    "duration": 2.24
  },
  {
    "id": 103,
    "text": "其晚年压卷之作《锦瑟》堪称此中绝唱。",
    "start": 478.16,
    "end": 481.6,
    "duration": 3.44
  },
  {
    "id": 104,
    "text": "首联“锦瑟无端五十弦，一弦一柱思华年”以乐器引发生命回望。",
    "start": 481.6,
    "end": 487.44,
    "duration": 5.84
  },
  {
    "id": 105,
    "text": "汉联“庄生晓梦迷蝴蝶，望帝春心托杜娟”，",
    "start": 487.44,
    "end": 491.68,
    "duration": 4.24
  },
  {
    "id": 106,
    "text": "将庄周化蝶之虚无迷惘与望帝啼血之执着凄绝奇妙并置。",
    "start": 491.68,
    "end": 497.12,
    "duration": 5.44
  },
  {
    "id": 107,
    "text": "颈联“沧海月明珠有泪，蓝田日暖玉生烟”，",
    "start": 497.12,
    "end": 501.04,
    "duration": 3.92
  },
  {
    "id": 108,
    "text": "更是将冷暖、明暗、涕泪与精魂融铸为如梦似幻的通感画面，",
    "start": 501.04,
    "end": 506.4,
    "duration": 5.36
  },
  {
    "id": 109,
    "text": "达到了物我两忘、沉潜深微的极致境界。",
    "start": 506.4,
    "end": 509.76,
    "duration": 3.36
  },
  {
    "id": 110,
    "text": "同时，诗人严格恪守近体七言律诗的音律节奏，",
    "start": 510.0,
    "end": 514.16,
    "duration": 4.16
  },
  {
    "id": 111,
    "text": "平仄严谨，对仗工稳，展现出出神入化的形式驾驭力。",
    "start": 514.16,
    "end": 519.04,
    "duration": 4.88
  },
  {
    "id": 112,
    "text": "四、第三维度：晚唐诗歌审美演变机制内部咬合。",
    "start": 519.04,
    "end": 523.44,
    "duration": 4.4
  },
  {
    "id": 113,
    "text": "本段任务是对比盛唐、中唐，深刻揭示由外向功业向内向感伤的心态演进。",
    "start": 523.44,
    "end": 530.0,
    "duration": 6.56
  },
  {
    "id": 114,
    "text": "-首先，段首给出统领分论点，具体表述到答题语句就是：第三，",
    "start": 530.16,
    "end": 535.29,
    "duration": 5.13
  },
  {
    "id": 115,
    "text": "从审美形态与历史脉络审视，李商隐无题诗深刻标志着唐代诗歌从外向宏阔走向内向幽微的历史性转型。",
    "start": 535.29,
    "end": 544.694,
    "duration": 9.404
  },
  {
    "id": 116,
    "text": "随后，梳理盛唐与中唐的昂扬与求奇特质，",
    "start": 544.694,
    "end": 548.328,
    "duration": 3.634
  },
  {
    "id": 117,
    "text": "具体表述到答题语句就是：盛唐诗歌如李杜高适，",
    "start": 548.328,
    "end": 552.603,
    "duration": 4.275
  },
  {
    "id": 118,
    "text": "面向辽阔疆土与宏大功业，气象沉雄昂扬，",
    "start": 552.603,
    "end": 556.236,
    "duration": 3.633
  },
  {
    "id": 119,
    "text": "充满了健康的生命力。",
    "start": 556.236,
    "end": 558.16,
    "duration": 1.924
  },
  {
    "id": 120,
    "text": "中唐韩孟韩柳则重在向外抗争与求奇求险。",
    "start": 558.24,
    "end": 562.4,
    "duration": 4.16
  },
  {
    "id": 121,
    "text": "-紧接着，剖析晚唐暮世文人退缩内向的心态根源，",
    "start": 562.608,
    "end": 566.898,
    "duration": 4.29
  },
  {
    "id": 122,
    "text": "具体表述到答题语句就是：而身处晚唐暮世的李商隐，",
    "start": 566.898,
    "end": 571.617,
    "duration": 4.719
  },
  {
    "id": 123,
    "text": "深感国势日蹙与个体命运的不可抗争，",
    "start": 571.617,
    "end": 575.049,
    "duration": 3.432
  },
  {
    "id": 124,
    "text": "其审美视线由广袤的现实社会全面退缩至孤寂敏锐的个体心灵深处。",
    "start": 575.049,
    "end": 581.27,
    "duration": 6.221
  },
  {
    "id": 125,
    "text": "随后，调取《昨夜星辰昨夜风》名句展示心灵孤立：在《无题•昨夜星辰昨夜风》中，",
    "start": 581.27,
    "end": 587.704,
    "duration": 6.434
  },
  {
    "id": 126,
    "text": "“身无彩凤双飞翼，心有灵犀一点通”的唱惘，",
    "start": 587.704,
    "end": 591.351,
    "duration": 3.647
  },
  {
    "id": 127,
    "text": "呈现出一种前所未有的心灵孤立与执着追寻交织的情感机制。",
    "start": 591.351,
    "end": 596.928,
    "duration": 5.577
  },
  {
    "id": 128,
    "text": "-最后，提炼这一感伤美学对宋词的先声意义：这种内敛、",
    "start": 596.928,
    "end": 601.452,
    "duration": 4.524
  },
  {
    "id": 129,
    "text": "深曲、凄清而又追求极致形式纯美的感伤主义倾向，",
    "start": 601.452,
    "end": 605.769,
    "duration": 4.317
  },
  {
    "id": 130,
    "text": "直接预示了唐宋之际审美趣味由雄浑向典雅幽深的大转型。",
    "start": 605.769,
    "end": 610.91,
    "duration": 5.141
  },
  {
    "id": 131,
    "text": "第三，从审美形态与历史脉络审视，",
    "start": 610.91,
    "end": 613.788,
    "duration": 2.878
  },
  {
    "id": 132,
    "text": "李商隐无题诗深刻标志着唐代诗歌从外向宏阔走向内向幽微的历史性转型。",
    "start": 613.788,
    "end": 620.368,
    "duration": 6.58
  },
  {
    "id": 133,
    "text": "盛唐诗歌如李杜高适，面向辽阔疆土与宏大功业，",
    "start": 620.528,
    "end": 625.248,
    "duration": 4.72
  },
  {
    "id": 134,
    "text": "气象沉雄昂扬，充满了健康的生命力。",
    "start": 625.248,
    "end": 628.768,
    "duration": 3.52
  },
  {
    "id": 135,
    "text": "中唐韩孟韩柳则重在向外抗争与求奇求险。",
    "start": 628.768,
    "end": 633.248,
    "duration": 4.48
  },
  {
    "id": 136,
    "text": "而身处晚唐暮世的李商隐，深感国势日蹙与个体命运的不可抗争，",
    "start": 633.248,
    "end": 639.088,
    "duration": 5.84
  },
  {
    "id": 137,
    "text": "其审美视线由广袤的现实社会全面退缩至孤寂敏锐的个体心灵深处。",
    "start": 639.088,
    "end": 644.848,
    "duration": 5.76
  },
  {
    "id": 138,
    "text": "在《无题•昨夜星辰昨夜风》中，“身无彩凤双飞翼，",
    "start": 645.248,
    "end": 649.328,
    "duration": 4.08
  },
  {
    "id": 139,
    "text": "心有灵犀一点通”的唱惘，呈现出一种前所未有的心灵孤立与执着追寻交织的情感机制。",
    "start": 649.328,
    "end": 656.928,
    "duration": 7.6
  },
  {
    "id": 140,
    "text": "这种内敛、深曲、凄清而又追求极致形式纯美的感伤主义倾向，",
    "start": 656.928,
    "end": 663.008,
    "duration": 6.08
  },
  {
    "id": 141,
    "text": "直接预示了唐宋之际审美趣味由雄浑向典雅幽深的大转型。",
    "start": 663.008,
    "end": 668.048,
    "duration": 5.04
  },
  {
    "id": 142,
    "text": "五、结尾收束升华段内部咬合。",
    "start": 668.448,
    "end": 670.928,
    "duration": 2.48
  },
  {
    "id": 143,
    "text": "本段承担全篇论证成果的系统提炼与历史定位，",
    "start": 670.928,
    "end": 674.608,
    "duration": 3.68
  },
  {
    "id": 144,
    "text": "完成宏观历史论证闭环。",
    "start": 674.608,
    "end": 676.688,
    "duration": 2.08
  },
  {
    "id": 145,
    "text": "首先，全面回收意象迷宫与律诗典范，",
    "start": 676.688,
    "end": 679.568,
    "duration": 2.88
  },
  {
    "id": 146,
    "text": "具体表述到答题语句就是：综上所述，",
    "start": 679.568,
    "end": 682.448,
    "duration": 2.88
  },
  {
    "id": 147,
    "text": "李商隐无题诗以其朦胧幽深的意象网络、",
    "start": 682.448,
    "end": 685.648,
    "duration": 3.2
  },
  {
    "id": 148,
    "text": "精严沉郁的律诗典范与细腻敏锐的心灵开掘，",
    "start": 685.648,
    "end": 689.408,
    "duration": 3.76
  },
  {
    "id": 149,
    "text": "在中国诗歌史上构筑了一座空前绝后的纯美迷宫。",
    "start": 689.408,
    "end": 693.248,
    "duration": 3.84
  },
  {
    "id": 150,
    "text": "-紧接着，总结对古典抒情传统深化与宋词发端的深远价值，",
    "start": 693.408,
    "end": 698.671,
    "duration": 5.263
  },
  {
    "id": 151,
    "text": "具体表述到答题语句就是：它不仅完成了古典抒情诗从言志纪实向深层意识表现的伟大跨越，",
    "start": 698.671,
    "end": 707.224,
    "duration": 8.553
  },
  {
    "id": 152,
    "text": "更为后世宋词细腻幽微的心理表现开辟了源头活水。",
    "start": 707.224,
    "end": 712.048,
    "duration": 4.824
  },
  {
    "id": 153,
    "text": "综上所述，李商隐无题诗以其朦胧幽深的意象网络、",
    "start": 712.184,
    "end": 716.664,
    "duration": 4.48
  },
  {
    "id": 154,
    "text": "精严沉郁的律诗典范与细腻敏锐的心灵开掘，",
    "start": 716.664,
    "end": 720.664,
    "duration": 4.0
  },
  {
    "id": 155,
    "text": "在中国诗歌史上构筑了一座空前绝后的纯美迷宫。",
    "start": 720.664,
    "end": 724.584,
    "duration": 3.92
  },
  {
    "id": 156,
    "text": "它不仅完成了古典抒情诗从言志纪实向深层意识表现的伟大跨越，",
    "start": 724.584,
    "end": 730.504,
    "duration": 5.92
  },
  {
    "id": 157,
    "text": "更为后世宋词细腻幽微的心理表现开辟了源头活水。",
    "start": 730.504,
    "end": 734.664,
    "duration": 4.16
  }
]