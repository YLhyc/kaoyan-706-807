[
  {
    "id": 1,
    "text": "试论关汉卿《窦娥冤》的悲剧艺术成就与社会反抗精神。",
    "start": 0.134,
    "end": 4.266,
    "duration": 4.132
  },
  {
    "id": 2,
    "text": "关汉卿的《窦娥冤》（全名《感天动地窦娥冤》）是元代杂剧乃至中国古典悲剧的杰出代表。",
    "start": 4.903,
    "end": 11.475,
    "duration": 6.572
  },
  {
    "id": 3,
    "text": "在元代民族压迫深重、吏治腐败与高利贷横行的黑暗社会中，关汉卿立足市井民间，",
    "start": 12.193,
    "end": 18.765,
    "duration": 6.572
  },
  {
    "id": 4,
    "text": "以无辜寡妇窦娥的冤案为线索，写出了“惊心动魄的人间惨象”。",
    "start": 19.144,
    "end": 23.916,
    "duration": 4.772
  },
  {
    "id": 5,
    "text": "王国维在《宋元戏曲考》中高度评价此剧“即列之于世界大悲剧中，亦无愧色也”。",
    "start": 24.674,
    "end": 30.606,
    "duration": 5.932
  },
  {
    "id": 6,
    "text": "《窦娥冤》的悲剧艺术成就与社会反抗精神，主要体现在以下四个方面：",
    "start": 31.244,
    "end": 42.616,
    "duration": 11.372
  },
  {
    "id": 7,
    "text": "第一，植根元代严酷社会现实，塑造善良坚贞而宁死不屈的底层女性典型。",
    "start": 43.334,
    "end": 49.786,
    "duration": 6.452
  },
  {
    "id": 8,
    "text": "关汉卿摒弃了虚幻的才子佳人套路，将悲剧冲突深植于元代社会的罪恶土壤之中。",
    "start": 50.504,
    "end": 57.436,
    "duration": 6.932
  },
  {
    "id": 9,
    "text": "窦娥自幼沦为童养媳，早年丧夫，恪守妇道奉养蔡婆婆，本是一位逆来顺受的善良女子。",
    "start": 58.114,
    "end": 66.886,
    "duration": 8.772
  },
  {
    "id": 10,
    "text": "但赛卢医的赖账图害、地痞张驴儿父子的勒索诬陷，",
    "start": 67.564,
    "end": 68.816,
    "duration": 1.252
  },
  {
    "id": 11,
    "text": "以及楚州贪官桃杌只认钱财、滥用酷刑的草菅人命，步步将她推入绝境。",
    "start": 69.195,
    "end": 72.647,
    "duration": 3.452
  },
  {
    "id": 12,
    "text": "窦娥为保护婆婆不受杖刑而含冤屈招，彰显其仁孝至善；",
    "start": 73.365,
    "end": 75.417,
    "duration": 2.052
  },
  {
    "id": 13,
    "text": "而在公堂与法场上面对强权，她又宁死不愿顺从张驴儿的逼婚，",
    "start": 75.946,
    "end": 78.238,
    "duration": 2.292
  },
  {
    "id": 14,
    "text": "展现出底层女性不屈的人格尊严。",
    "start": 78.617,
    "end": 81.309,
    "duration": 2.692
  },
  {
    "id": 15,
    "text": "第二，将现实写实与浪漫想象交融，以感天动地的三桩誓愿凸显崇高悲剧力量。",
    "start": 81.987,
    "end": 88.599,
    "duration": 6.612
  },
  {
    "id": 16,
    "text": "在第三折法场受刑的高潮处，关汉卿突破了纯客观的写实局限，化用东海孝妇等民间传说，",
    "start": 89.277,
    "end": 96.249,
    "duration": 6.972
  },
  {
    "id": 17,
    "text": "虚构了“血溅白练”“六月飞雪”“亢旱三年”三桩誓愿并一一体现。",
    "start": 96.628,
    "end": 101.36,
    "duration": 4.732
  },
  {
    "id": 18,
    "text": "鲜血逆飞高悬素练、炎夏六月飞雪掩尸、楚州大地连旱三年，",
    "start": 102.038,
    "end": 107.61,
    "duration": 5.572
  },
  {
    "id": 19,
    "text": "这些超现实的奇异景象，以天意见证窦娥的清白无辜，",
    "start": 107.989,
    "end": 112.441,
    "duration": 4.452
  },
  {
    "id": 20,
    "text": "借助奇幻笔墨对人世间贪官恶霸的暴行发出严厉控诉与警世裁决，",
    "start": 112.955,
    "end": 118.287,
    "duration": 5.332
  },
  {
    "id": 21,
    "text": "将个人冤屈升华为撼动天地的社会抗议，产生强烈的悲剧震撼力。",
    "start": 118.666,
    "end": 123.518,
    "duration": 4.852
  },
  {
    "id": 22,
    "text": "第三，由忍辱顺从递进到愤慨斥天，细致展现窦娥由屈从到抗争的觉醒轨迹。",
    "start": 124.142,
    "end": 130.674,
    "duration": 6.532
  },
  {
    "id": 23,
    "text": "剧作的高妙之处，在于紧扣压迫步步紧逼的过程，写出窦娥反抗意识的层层升华。",
    "start": 131.203,
    "end": 137.175,
    "duration": 5.972
  },
  {
    "id": 24,
    "text": "起初窦娥敬畏天命、守分安命，幻想官府能替民作主；",
    "start": 137.893,
    "end": 142.065,
    "duration": 4.172
  },
  {
    "id": 25,
    "text": "随着酷刑加身、冤案铸成，她的幻想被残酷现实击碎。",
    "start": 142.703,
    "end": 147.075,
    "duration": 4.372
  },
  {
    "id": 26,
    "text": "在押赴刑场的【滚绣球】一曲中，她发出振聋发聩的怒斥：",
    "start": 147.753,
    "end": 152.645,
    "duration": 4.892
  },
  {
    "id": 27,
    "text": "“天地也！只合把清浊分辨，可怎生糊突了盗跖、颜渊？",
    "start": 153.323,
    "end": 154.615,
    "duration": 1.292
  },
  {
    "id": 28,
    "text": "为善的受贫穷更命短，造恶的享富贵又寿延。",
    "start": 155.144,
    "end": 157.476,
    "duration": 2.332
  },
  {
    "id": 29,
    "text": "天地也！做得个怕硬欺软，却原来也这般顺水推船！",
    "start": 158.274,
    "end": 162.166,
    "duration": 3.892
  },
  {
    "id": 30,
    "text": "地也，你不分好歹何为地！",
    "start": 162.924,
    "end": 163.536,
    "duration": 0.612
  },
  {
    "id": 31,
    "text": "天也，你错勘贤愚枉做天！”",
    "start": 164.214,
    "end": 167.386,
    "duration": 3.172
  },
  {
    "id": 32,
    "text": "这一怒骂直指传统天理秩序与最高权威，展现出决绝的社会批判锋芒。",
    "start": 168.104,
    "end": 170.156,
    "duration": 2.052
  },
  {
    "id": 33,
    "text": "第四，曲词本色当行而又激越悲壮，树立元杂剧现实主义悲剧的典范。",
    "start": 170.834,
    "end": 173.046,
    "duration": 2.212
  },
  {
    "id": 34,
    "text": "在语言艺术上，关汉卿充分发挥元杂剧本色派之所长，将市井口语、民间俗谚与精炼雅语融为一体。",
    "start": 173.764,
    "end": 178.936,
    "duration": 5.172
  },
  {
    "id": 35,
    "text": "全剧曲词质朴自然、生动流利，毫无文饰艰深之弊；",
    "start": 179.614,
    "end": 182.746,
    "duration": 3.132
  },
  {
    "id": 36,
    "text": "在抒写窦娥绝望悲愤时，唱词如泣如诉、慷慨激昂，韵律急促有力，极具舞台感染力。",
    "start": 183.275,
    "end": 185.927,
    "duration": 2.652
  },
  {
    "id": 37,
    "text": "全剧以悲剧冲突的深刻性与人物形象的鲜活感，",
    "start": 186.605,
    "end": 190.817,
    "duration": 4.212
  },
  {
    "id": 38,
    "text": "为元代及后世古典戏曲的悲剧创作确立了崇高典范。",
    "start": 191.196,
    "end": 194.728,
    "duration": 3.532
  },
  {
    "id": 39,
    "text": "由是观之，关汉卿《窦娥冤》直面元代严酷社会现实与吏治黑暗，",
    "start": 195.486,
    "end": 197.218,
    "duration": 1.732
  },
  {
    "id": 40,
    "text": "借助底层寡妇由忍辱顺从到【滚绣球】指天斥地的抗争轨迹，以及感天动地的三桩誓愿，铸就了深沉悲壮的悲剧力量。",
    "start": 197.597,
    "end": 200.089,
    "duration": 2.492
  },
  {
    "id": 41,
    "text": "全剧将本色当行的民间曲辞与尖锐戏剧冲突紧密结合，",
    "start": 200.727,
    "end": 221.666,
    "duration": 20.939
  },
  {
    "id": 42,
    "text": "无愧于王国维“即列之于世界大悲剧中，亦无愧色也”的崇高评价。",
    "start": 222.217,
    "end": 242.13,
    "duration": 19.913
  }
]