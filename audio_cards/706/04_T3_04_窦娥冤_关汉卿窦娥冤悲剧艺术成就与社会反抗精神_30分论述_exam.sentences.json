[
  {
    "id": 1,
    "text": "试论关汉卿《窦娥冤》的悲剧艺术成就与社会反抗精神。",
    "start": 0.2,
    "end": 4.52,
    "duration": 4.32
  },
  {
    "id": 2,
    "text": "关汉卿的《窦娥冤》（全名《感天动地窦娥冤》）是元代杂剧乃至中国古典悲剧的杰出代表。",
    "start": 5.04,
    "end": 12.564,
    "duration": 7.524
  },
  {
    "id": 3,
    "text": "在元代民族压迫深重、吏治腐败与高利贷横行的黑暗社会中，关汉卿立足市井民间，",
    "start": 13.064,
    "end": 19.85,
    "duration": 6.786
  },
  {
    "id": 4,
    "text": "以无辜寡妇窦娥的冤案为线索，写出了“惊心动魄的人间惨象”。",
    "start": 20.22,
    "end": 24.94,
    "duration": 4.72
  },
  {
    "id": 5,
    "text": "王国维在《宋元戏曲考》中高度评价此剧“即列之于世界大悲剧中，亦无愧色也”。",
    "start": 25.46,
    "end": 32.1,
    "duration": 6.64
  },
  {
    "id": 6,
    "text": "《窦娥冤》的悲剧艺术成就与社会反抗精神，主要体现在以下四个方面：",
    "start": 32.62,
    "end": 37.9,
    "duration": 5.28
  },
  {
    "id": 7,
    "text": "第一，植根元代严酷社会现实，塑造善良坚贞而宁死不屈的底层女性典型。",
    "start": 38.27,
    "end": 44.51,
    "duration": 6.24
  },
  {
    "id": 8,
    "text": "关汉卿摒弃了虚幻的才子佳人套路，将悲剧冲突深植于元代社会的罪恶土壤之中。",
    "start": 45.03,
    "end": 51.99,
    "duration": 6.96
  },
  {
    "id": 9,
    "text": "窦娥自幼沦为童养媳，早年丧夫，恪守妇道奉养蔡婆婆，本是一位逆来顺受的善良女子。",
    "start": 52.51,
    "end": 59.63,
    "duration": 7.12
  },
  {
    "id": 10,
    "text": "但赛卢医的赖账图害、地痞张驴儿父子的勒索诬陷，",
    "start": 60.15,
    "end": 63.99,
    "duration": 3.84
  },
  {
    "id": 11,
    "text": "以及楚州贪官桃杌只认钱财、滥用酷刑的草菅人命，步步将她推入绝境。",
    "start": 64.36,
    "end": 70.12,
    "duration": 5.76
  },
  {
    "id": 12,
    "text": "窦娥为保护婆婆不受杖刑而含冤屈招，彰显其仁孝至善；",
    "start": 70.64,
    "end": 75.6,
    "duration": 4.96
  },
  {
    "id": 13,
    "text": "而在公堂与法场上面对强权，她又宁死不愿顺从张驴儿的逼婚，",
    "start": 76.12,
    "end": 81.32,
    "duration": 5.2
  },
  {
    "id": 14,
    "text": "展现出底层女性不屈的人格尊严。",
    "start": 81.69,
    "end": 84.33,
    "duration": 2.64
  },
  {
    "id": 15,
    "text": "第二，将现实写实与浪漫想象交融，以感天动地的三桩誓愿凸显崇高悲剧力量。",
    "start": 84.85,
    "end": 92.37,
    "duration": 7.52
  },
  {
    "id": 16,
    "text": "在第三折法场受刑的高潮处，关汉卿突破了纯客观的写实局限，化用东海孝妇等民间传说，",
    "start": 92.89,
    "end": 100.62,
    "duration": 7.73
  },
  {
    "id": 17,
    "text": "虚构了“血溅白练”“六月飞雪”“亢旱三年”三桩誓愿并一一体现。",
    "start": 101.02,
    "end": 106.94,
    "duration": 5.92
  },
  {
    "id": 18,
    "text": "鲜血逆飞高悬素练、炎夏六月飞雪掩尸、楚州大地连旱三年，",
    "start": 107.46,
    "end": 113.14,
    "duration": 5.68
  },
  {
    "id": 19,
    "text": "这些超现实的奇异景象，以天意见证窦娥的清白无辜，",
    "start": 113.51,
    "end": 117.75,
    "duration": 4.24
  },
  {
    "id": 20,
    "text": "借助奇幻笔墨对人世间贪官恶霸的暴行发出严厉控诉与警世裁决，",
    "start": 118.12,
    "end": 123.56,
    "duration": 5.44
  },
  {
    "id": 21,
    "text": "将个人冤屈升华为撼动天地的社会抗议，产生强烈的悲剧震撼力。",
    "start": 124.04,
    "end": 129.32,
    "duration": 5.28
  },
  {
    "id": 22,
    "text": "第三，由忍辱顺从递进到愤慨斥天，细致展现窦娥由屈从到抗争的觉醒轨迹。",
    "start": 129.84,
    "end": 137.28,
    "duration": 7.44
  },
  {
    "id": 23,
    "text": "剧作的高妙之处，在于紧扣压迫步步紧逼的过程，写出窦娥反抗意识的层层升华。",
    "start": 137.8,
    "end": 143.88,
    "duration": 6.08
  },
  {
    "id": 24,
    "text": "起初窦娥敬畏天命、守分安命，幻想官府能替民作主；",
    "start": 144.434,
    "end": 149.189,
    "duration": 4.755
  },
  {
    "id": 25,
    "text": "随着酷刑加身、冤案铸成，她的幻想被残酷现实击碎。",
    "start": 149.689,
    "end": 153.96,
    "duration": 4.271
  },
  {
    "id": 26,
    "text": "在押赴刑场的【滚绣球】一曲中，她发出振聋发聩的怒斥：",
    "start": 154.48,
    "end": 158.64,
    "duration": 4.16
  },
  {
    "id": 27,
    "text": "“天地也！只合把清浊分辨，可怎生糊突了盗跖、颜渊？",
    "start": 159.01,
    "end": 164.37,
    "duration": 5.36
  },
  {
    "id": 28,
    "text": "为善的受贫穷更命短，造恶的享富贵又寿延。",
    "start": 164.89,
    "end": 169.53,
    "duration": 4.64
  },
  {
    "id": 29,
    "text": "天地也！做得个怕硬欺软，却原来也这般顺水推船！",
    "start": 170.05,
    "end": 175.09,
    "duration": 5.04
  },
  {
    "id": 30,
    "text": "地也，你不分好歹何为地！",
    "start": 175.61,
    "end": 177.93,
    "duration": 2.32
  },
  {
    "id": 31,
    "text": "天也，你错勘贤愚枉做天！”",
    "start": 178.45,
    "end": 181.17,
    "duration": 2.72
  },
  {
    "id": 32,
    "text": "这一怒骂直指传统天理秩序与最高权威，展现出决绝的社会批判锋芒。",
    "start": 181.69,
    "end": 187.69,
    "duration": 6.0
  },
  {
    "id": 33,
    "text": "第四，曲词本色当行而又激越悲壮，树立元杂剧现实主义悲剧的典范。",
    "start": 188.21,
    "end": 194.613,
    "duration": 6.403
  },
  {
    "id": 34,
    "text": "在语言艺术上，关汉卿充分发挥元杂剧本色派之所长，将市井口语、民间俗谚与精炼雅语融为一体。",
    "start": 195.113,
    "end": 203.686,
    "duration": 8.573
  },
  {
    "id": 35,
    "text": "全剧曲词质朴自然、生动流利，毫无文饰艰深之弊；",
    "start": 204.186,
    "end": 208.77,
    "duration": 4.584
  },
  {
    "id": 36,
    "text": "在抒写窦娥绝望悲愤时，唱词如泣如诉、慷慨激昂，韵律急促有力，极具舞台感染力。",
    "start": 209.29,
    "end": 216.97,
    "duration": 7.68
  },
  {
    "id": 37,
    "text": "全剧以悲剧冲突的深刻性与人物形象的鲜活感，",
    "start": 217.49,
    "end": 221.33,
    "duration": 3.84
  },
  {
    "id": 38,
    "text": "为元代及后世古典戏曲的悲剧创作确立了崇高典范。",
    "start": 221.7,
    "end": 226.1,
    "duration": 4.4
  },
  {
    "id": 39,
    "text": "由是观之，关汉卿《窦娥冤》直面元代严酷社会现实与吏治黑暗，",
    "start": 226.62,
    "end": 232.114,
    "duration": 5.494
  },
  {
    "id": 40,
    "text": "借助底层寡妇由忍辱顺从到【滚绣球】指天斥地的抗争轨迹，以及感天动地的三桩誓愿，铸就了深沉悲壮的悲剧力量。",
    "start": 232.554,
    "end": 243.07,
    "duration": 10.516
  },
  {
    "id": 41,
    "text": "全剧将本色当行的民间曲辞与尖锐戏剧冲突紧密结合，",
    "start": 243.59,
    "end": 248.39,
    "duration": 4.8
  },
  {
    "id": 42,
    "text": "无愧于王国维“即列之于世界大悲剧中，亦无愧色也”的崇高评价。",
    "start": 248.76,
    "end": 254.04,
    "duration": 5.28
  }
]
