[
  {
    "id": "sent_1",
    "text": "关汉卿的 《窦娥冤》（全名 《感天动地窦娥冤》） 是中国古典戏曲中最为璀璨的悲剧代表作。",
    "start": 0.0,
    "end": 6.88,
    "duration": 6.88
  },
  {
    "id": "sent_2",
    "text": "在元代民族分化森严、",
    "start": 7.329,
    "end": 9.249,
    "duration": 1.92
  },
  {
    "id": "sent_3",
    "text": "阶级压迫深重与政治吏治极其腐败的时代背景下，",
    "start": 9.699,
    "end": 13.459,
    "duration": 3.76
  },
  {
    "id": "sent_4",
    "text": "关汉卿深入市井勾栏，以底层无辜弱女子的悲惨遭遇为切入口，",
    "start": 13.909,
    "end": 19.229,
    "duration": 5.32
  },
  {
    "id": "sent_5",
    "text": "展现了一场震撼人心的生命悲剧。",
    "start": 19.679,
    "end": 22.399,
    "duration": 2.72
  },
  {
    "id": "sent_6",
    "text": "王国维在 《宋元戏曲考》 中给予极高评价，",
    "start": 22.929,
    "end": 25.929,
    "duration": 3.0
  },
  {
    "id": "sent_7",
    "text": "指出其 “明列于世界大悲剧中，亦无愧色也”。",
    "start": 26.379,
    "end": 30.019,
    "duration": 3.64
  },
  {
    "id": "sent_8",
    "text": "《窦娥冤》 的悲剧艺术成就与社会反抗精神，",
    "start": 30.469,
    "end": 33.669,
    "duration": 3.2
  },
  {
    "id": "sent_9",
    "text": "主要展现为以下四个核心维度：",
    "start": 34.119,
    "end": 36.639,
    "duration": 2.52
  },
  {
    "id": "sent_10",
    "text": "第一，直面元代严酷黑暗的社会现实，",
    "start": 37.089,
    "end": 40.369,
    "duration": 3.28
  },
  {
    "id": "sent_11",
    "text": "塑造坚贞善良而绝不妥协的底层女性悲剧典型。",
    "start": 40.819,
    "end": 44.499,
    "duration": 3.68
  },
  {
    "id": "sent_12",
    "text": "关汉卿摒弃了虚无缥缈的神仙道化与才子佳人俗套，",
    "start": 45.109,
    "end": 49.469,
    "duration": 4.36
  },
  {
    "id": "sent_13",
    "text": "将戏剧冲突深植于现实社会的残酷土壤之中。",
    "start": 49.919,
    "end": 53.719,
    "duration": 3.8
  },
  {
    "id": "sent_14",
    "text": "窦娥自幼沦为童养媳，婚后早年丧夫，恪守封建妇德赡养婆母，",
    "start": 54.169,
    "end": 59.529,
    "duration": 5.36
  },
  {
    "id": "sent_15",
    "text": "本是一个逆来顺受的平民弱女子。",
    "start": 59.979,
    "end": 62.499,
    "duration": 2.52
  },
  {
    "id": "sent_16",
    "text": "然而高利贷的残酷逼迫、地痞张驴儿的霸凌陷害，",
    "start": 62.949,
    "end": 66.629,
    "duration": 3.68
  },
  {
    "id": "sent_17",
    "text": "以及楚州知府桃杌受贿贪暴、严刑拷打的司法现实，",
    "start": 67.079,
    "end": 71.519,
    "duration": 4.44
  },
  {
    "id": "sent_18",
    "text": "一步步将她逼入绝境。",
    "start": 71.969,
    "end": 73.689,
    "duration": 1.72
  },
  {
    "id": "sent_19",
    "text": "窦娥为了保护年迈的蔡婆婆不受酷刑折磨，甘愿屈招画押，",
    "start": 74.139,
    "end": 78.819,
    "duration": 4.68
  },
  {
    "id": "sent_20",
    "text": "展现出至善的道德品格；",
    "start": 79.269,
    "end": 81.269,
    "duration": 2.0
  },
  {
    "id": "sent_21",
    "text": "而在公堂与刑场上，面对暴虐的专制权威，她至死不肯屈服认罪，",
    "start": 81.719,
    "end": 87.039,
    "duration": 5.32
  },
  {
    "id": "sent_22",
    "text": "展现出底层女性面对不公压迫时坚贞不屈的人格尊严。",
    "start": 87.489,
    "end": 91.929,
    "duration": 4.44
  },
  {
    "id": "sent_23",
    "text": "第二，打破庸俗现实主义局限，",
    "start": 92.379,
    "end": 94.779,
    "duration": 2.4
  },
  {
    "id": "sent_24",
    "text": "运用浪漫主义神思展现感天动地的三桩誓愿。",
    "start": 95.309,
    "end": 98.669,
    "duration": 3.36
  },
  {
    "id": "sent_25",
    "text": "关汉卿在剧作第三折刑场受戮的高潮部分，",
    "start": 99.119,
    "end": 102.639,
    "duration": 3.52
  },
  {
    "id": "sent_26",
    "text": "突破了自然主义的客观描摹，借用了上古东海孝妇等神话传说，",
    "start": 103.089,
    "end": 107.769,
    "duration": 4.68
  },
  {
    "id": "sent_27",
    "text": "创造了 “血溅白练”、“六月飞雪”、",
    "start": 108.219,
    "end": 110.779,
    "duration": 2.56
  },
  {
    "id": "sent_28",
    "text": "“亢旱三年” 三桩神异誓愿。",
    "start": 111.229,
    "end": 113.309,
    "duration": 2.08
  },
  {
    "id": "sent_29",
    "text": "在肉躯即将被摧毁的关头，窦娥向天地发出的复仇誓词尽数应验：",
    "start": 113.759,
    "end": 119.399,
    "duration": 5.64
  },
  {
    "id": "sent_30",
    "text": "鲜血飞溅高挂素练而不落地，盛暑六月降下三尺飞雪掩埋尸首，",
    "start": 119.849,
    "end": 125.649,
    "duration": 5.8
  },
  {
    "id": "sent_31",
    "text": "楚州大地连年大旱百姓受苦。",
    "start": 126.099,
    "end": 128.579,
    "duration": 2.48
  },
  {
    "id": "sent_32",
    "text": "这种超自然的浪漫主义奇迹，并非对封建司法的幻想妥协，",
    "start": 129.029,
    "end": 133.629,
    "duration": 4.6
  },
  {
    "id": "sent_33",
    "text": "而是借助天意对人间黑暗腐朽势力的严厉控诉与毁灭性裁决，",
    "start": 134.079,
    "end": 139.239,
    "duration": 5.16
  },
  {
    "id": "sent_34",
    "text": "将个体的冤屈升华为具有普遍意义的社会抗争，",
    "start": 139.689,
    "end": 143.369,
    "duration": 3.68
  },
  {
    "id": "sent_35",
    "text": "产生出催人泪下的崇高悲剧震撼力。",
    "start": 143.819,
    "end": 146.659,
    "duration": 2.84
  },
  {
    "id": "sent_36",
    "text": "第三，以性格发展统摄戏剧情节冲突，",
    "start": 147.109,
    "end": 150.509,
    "duration": 3.4
  },
  {
    "id": "sent_37",
    "text": "呈现从忍辱顺从到激愤抗争的心灵觉醒轨迹。",
    "start": 150.959,
    "end": 154.919,
    "duration": 3.96
  },
  {
    "id": "sent_38",
    "text": "剧作的高超之处，",
    "start": 155.369,
    "end": 156.729,
    "duration": 1.36
  },
  {
    "id": "sent_39",
    "text": "在于细腻刻画了窦娥在绝境逼迫下由浅入深的心灵觉醒与反抗升华过程。",
    "start": 157.179,
    "end": 163.299,
    "duration": 6.12
  },
  {
    "id": "sent_40",
    "text": "在开场与被诬陷初期，窦娥对天地神明与封建秩序尚抱有敬畏，",
    "start": 163.749,
    "end": 168.909,
    "duration": 5.16
  },
  {
    "id": "sent_41",
    "text": "对官府抱有清官昭雪幻想。",
    "start": 169.359,
    "end": 171.559,
    "duration": 2.2
  },
  {
    "id": "sent_42",
    "text": "然而随着公堂酷刑的加剧与冤狱的铸成，",
    "start": 172.009,
    "end": 175.249,
    "duration": 3.24
  },
  {
    "id": "sent_43",
    "text": "她的顺从与幻想被残酷现实彻底粉碎。",
    "start": 175.699,
    "end": 179.019,
    "duration": 3.32
  },
  {
    "id": "sent_44",
    "text": "在押赴刑场途中的 【滚绣球】 一曲中，",
    "start": 179.469,
    "end": 182.749,
    "duration": 3.28
  },
  {
    "id": "sent_45",
    "text": "窦娥发出了中国戏曲史上最震聋发聩的怒吼：“天地也！",
    "start": 183.199,
    "end": 187.759,
    "duration": 4.56
  },
  {
    "id": "sent_46",
    "text": "只合把清浊分，可怎生糊突了盗跖、颜渊？",
    "start": 188.208,
    "end": 192.008,
    "duration": 3.8
  },
  {
    "id": "sent_47",
    "text": "为善的受贫穷更命短，造恶的享富贵又寿延。",
    "start": 192.538,
    "end": 196.738,
    "duration": 4.2
  },
  {
    "id": "sent_48",
    "text": "天地也！",
    "start": 197.188,
    "end": 198.028,
    "duration": 0.84
  },
  {
    "id": "sent_49",
    "text": "做得个怕硬欺软，却原来也整天错勘贤愚枉做天！",
    "start": 198.478,
    "end": 202.638,
    "duration": 4.16
  },
  {
    "id": "sent_50",
    "text": "” 她不仅控诉了恶霸官吏，",
    "start": 203.088,
    "end": 204.968,
    "duration": 1.88
  },
  {
    "id": "sent_51",
    "text": "更将怀疑与批判的利刃直指封建最高主宰的天地神明，",
    "start": 205.418,
    "end": 209.858,
    "duration": 4.44
  },
  {
    "id": "sent_52",
    "text": "完成了彻底的思想决裂与精神觉醒。",
    "start": 210.388,
    "end": 212.948,
    "duration": 2.56
  },
  {
    "id": "sent_53",
    "text": "第四，曲词当行本色兼具慷慨激昂，",
    "start": 213.398,
    "end": 216.718,
    "duration": 3.32
  },
  {
    "id": "sent_54",
    "text": "确立元杂剧悲剧美学之巅峰地位。",
    "start": 217.168,
    "end": 219.928,
    "duration": 2.76
  },
  {
    "id": "sent_55",
    "text": "在语言艺术上，关汉卿充分发挥了元杂剧本色派的当行特质，",
    "start": 220.378,
    "end": 225.178,
    "duration": 4.8
  },
  {
    "id": "sent_56",
    "text": "将市井白话、民间俗语与典雅辞采天衣无缝地交融在一起。",
    "start": 225.628,
    "end": 230.468,
    "duration": 4.84
  },
  {
    "id": "sent_57",
    "text": "全剧语言质朴自然、生动活泼，毫无文中文饰艰深之弊。",
    "start": 230.998,
    "end": 235.838,
    "duration": 4.84
  },
  {
    "id": "sent_58",
    "text": "在抒发主人公悲愤痛苦时，曲词如泣如诉、激越奔放，",
    "start": 236.288,
    "end": 241.048,
    "duration": 4.76
  },
  {
    "id": "sent_59",
    "text": "如急风骤雨般直抒胸臆，兼具慷慨激昂与深沉悲凉的声律美，",
    "start": 241.538,
    "end": 246.098,
    "duration": 4.56
  },
  {
    "id": "sent_60",
    "text": "使窦娥的形象深入人心，",
    "start": 246.628,
    "end": 248.788,
    "duration": 2.16
  },
  {
    "id": "sent_61",
    "text": "奠定了中国戏曲现实主义批判精神与浪漫主义崇高美学的典范。",
    "start": 249.238,
    "end": 254.198,
    "duration": 4.96
  }
]