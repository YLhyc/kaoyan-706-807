[
  {
    "id": 1,
    "text": "试论唐代古文运动的发生机制、理论主张与韩柳散文艺术。",
    "start": 0.12,
    "end": 5.149,
    "duration": 5.029
  },
  {
    "id": 2,
    "text": "唐代古文运动是由韩愈、柳宗元在中唐时期领导的一场散文文体与文风革新运动。",
    "start": 5.61,
    "end": 12.706,
    "duration": 7.096
  },
  {
    "id": 3,
    "text": "面对安史之乱后藩镇割据加剧、朝政衰败、佛老盛行冲击儒学正统，",
    "start": 13.137,
    "end": 18.92,
    "duration": 5.783
  },
  {
    "id": 4,
    "text": "以及六朝以来骈俪文风雕琢辞藻、内容空虚的局面，",
    "start": 19.201,
    "end": 23.65,
    "duration": 4.449
  },
  {
    "id": 5,
    "text": "韩柳以复古为号召，掀起了旨在恢复先秦两汉散文传统的文学变革。",
    "start": 23.87,
    "end": 30.0,
    "duration": 6.13
  },
  {
    "id": 6,
    "text": "苏轼赞韩愈“文起八代之衰，道济天下之溺”。",
    "start": 30.0,
    "end": 33.84,
    "duration": 3.84
  },
  {
    "id": 7,
    "text": "古文运动的发生机制、理论纲领与韩柳散文艺术，主要体现在以下四个方面：",
    "start": 33.84,
    "end": 39.643,
    "duration": 5.803
  },
  {
    "id": 8,
    "text": "第一，立足中唐社会危局与儒学复兴诉求，确立以复古为革新的发生机制。",
    "start": 39.775,
    "end": 46.16,
    "duration": 6.385
  },
  {
    "id": 9,
    "text": "古文运动不仅是一场文体文字改革，更与中唐政治革新与儒学复兴思潮紧密相连。",
    "start": 46.16,
    "end": 54.16,
    "duration": 8.0
  },
  {
    "id": 10,
    "text": "安史之乱打破了大唐盛世的繁荣局面，士大夫深感国势衰落与纲常解体，",
    "start": 54.16,
    "end": 60.64,
    "duration": 6.48
  },
  {
    "id": 11,
    "text": "迫切要求重建儒家思想权威、革除时弊。",
    "start": 60.64,
    "end": 64.32,
    "duration": 3.68
  },
  {
    "id": 12,
    "text": "韩愈认为佛老学说削弱了国家伦理与财税根基，",
    "start": 64.32,
    "end": 68.64,
    "duration": 4.32
  },
  {
    "id": 13,
    "text": "而魏晋六朝以来讲求声律对偶、流于浮靡的骈体文，难以承载严肃的政治议论与经世之道。",
    "start": 68.64,
    "end": 77.52,
    "duration": 8.88
  },
  {
    "id": 14,
    "text": "于是韩柳主张效法先秦两汉散体古文，假复古之名行革新之实，",
    "start": 77.52,
    "end": 84.56,
    "duration": 7.04
  },
  {
    "id": 15,
    "text": "破除形式主义积弊，重振儒家道统与致用精神。",
    "start": 84.56,
    "end": 89.236,
    "duration": 4.676
  },
  {
    "id": 16,
    "text": "第二，系统提出“文以明道”与“气盛言宜”的散文理论纲领。",
    "start": 89.47,
    "end": 94.56,
    "duration": 5.09
  },
  {
    "id": 17,
    "text": "在理论建设上，韩愈与柳宗元构建了系统的散文美学主张。",
    "start": 94.56,
    "end": 99.6,
    "duration": 5.04
  },
  {
    "id": 18,
    "text": "在文道关系上，韩愈倡导“文以明道”，柳宗元亦主张“辅时及物”，",
    "start": 99.6,
    "end": 105.44,
    "duration": 5.84
  },
  {
    "id": 19,
    "text": "强调文章必须以阐发儒家义理、干预现实政治为核心宗旨；",
    "start": 105.44,
    "end": 110.56,
    "duration": 5.12
  },
  {
    "id": 20,
    "text": "在创作方法上，提出“唯陈言之务去”，",
    "start": 110.56,
    "end": 114.32,
    "duration": 3.76
  },
  {
    "id": 21,
    "text": "主张“师其意不师其辞”，坚决反对因袭剽窃前人陈词；",
    "start": 114.32,
    "end": 120.24,
    "duration": 5.92
  },
  {
    "id": 22,
    "text": "在文气修养上，提出“气盛则言之短长与声之高下者皆宜”，",
    "start": 120.24,
    "end": 126.24,
    "duration": 6.0
  },
  {
    "id": 23,
    "text": "认为作家内在的道德修养与精神气象决定文章的声气和谐；",
    "start": 126.24,
    "end": 131.68,
    "duration": 5.44
  },
  {
    "id": 24,
    "text": "在抒情动因上，韩愈提出“大凡物不得其平则鸣”，",
    "start": 131.68,
    "end": 136.56,
    "duration": 4.88
  },
  {
    "id": 25,
    "text": "揭示了文学创作源于现实不平与内心郁积的抒愤机制。",
    "start": 136.56,
    "end": 141.671,
    "duration": 5.111
  },
  {
    "id": 26,
    "text": "第三，革除骈体浮靡积弊，以单行散体打破排比对偶的文体束缚。",
    "start": 141.825,
    "end": 147.6,
    "duration": 5.775
  },
  {
    "id": 27,
    "text": "古文运动在文体形式上的突出贡献，",
    "start": 147.6,
    "end": 150.82,
    "duration": 3.22
  },
  {
    "id": 28,
    "text": "在于打破了六朝以来排比对偶与声病音律对文章表达的长期束缚。",
    "start": 150.9,
    "end": 156.64,
    "duration": 5.74
  },
  {
    "id": 29,
    "text": "韩柳倡导单行散体，句式长短错落、参差多变，随情意表达的需要自由舒卷。",
    "start": 156.64,
    "end": 163.104,
    "duration": 6.464
  },
  {
    "id": 30,
    "text": "他们又并不全盘排斥骈文，而是吸收先秦两汉典雅文言与六朝骈语精华，",
    "start": 163.104,
    "end": 169.504,
    "duration": 6.4
  },
  {
    "id": 31,
    "text": "同时吸纳时下鲜活词语，如“文从字顺”与自铸新词，",
    "start": 169.504,
    "end": 174.544,
    "duration": 5.04
  },
  {
    "id": 32,
    "text": "使散文重新恢复了叙写复杂史事、展开严密论辩与描摹客观景物的表现力，",
    "start": 174.544,
    "end": 180.864,
    "duration": 6.32
  },
  {
    "id": 33,
    "text": "大幅拓展了散文的体裁边界与艺术空间。",
    "start": 180.864,
    "end": 184.544,
    "duration": 3.68
  },
  {
    "id": 34,
    "text": "第四，韩柳散文各擅胜场，共同奠定唐宋古文运动的典范格局。",
    "start": 184.544,
    "end": 190.256,
    "duration": 5.712
  },
  {
    "id": 35,
    "text": "韩愈与柳宗元在散文创作上同中有异、相得益彰。",
    "start": 190.308,
    "end": 195.024,
    "duration": 4.716
  },
  {
    "id": 36,
    "text": "韩愈散文气势雄健、汪洋恣肆，在《师说》中以严密论辩批判士大夫耻于从师的陋习，",
    "start": 195.024,
    "end": 201.504,
    "duration": 6.48
  },
  {
    "id": 37,
    "text": "在《马说》中借千里马遭遇抒发人才被埋没的悲愤；",
    "start": 201.504,
    "end": 206.192,
    "duration": 4.688
  },
  {
    "id": 38,
    "text": "柳宗元散文则峭拔清峻、笔锋犀利，",
    "start": 206.427,
    "end": 209.602,
    "duration": 3.175
  },
  {
    "id": 39,
    "text": "在杂说名篇《捕蛇者说》中借蒋氏三代遭遇揭示“孰知赋敛之毒有甚是蛇者乎”的主题，",
    "start": 210.04,
    "end": 217.465,
    "duration": 7.425
  },
  {
    "id": 40,
    "text": "在山水游记《永州八记》中开辟了融身世之悲于自然清幽的独特意境。",
    "start": 217.615,
    "end": 223.19,
    "duration": 5.575
  },
  {
    "id": 41,
    "text": "韩柳散文使散体取代骈体占据文坛主位，为北宋欧阳修、苏轼等人的诗文革新奠定了坚实基础。",
    "start": 223.543,
    "end": 231.787,
    "duration": 8.244
  }
]