[
  {
    "id": 1,
    "text": "试论唐代古文运动的发生机制、理论主张与韩柳散文艺术。",
    "start": 0.134,
    "end": 4.506,
    "duration": 4.372
  },
  {
    "id": 2,
    "text": "唐代古文运动是由韩愈、柳宗元在中唐时期领导的一场散文文体与文风革新运动。",
    "start": 5.13,
    "end": 12.752,
    "duration": 7.622
  },
  {
    "id": 3,
    "text": "面对安史之乱后藩镇割据加剧、朝政衰败、佛老盛行冲击儒学正统，以及六朝以来骈俪文风雕琢辞藻、内容空虚的局面，",
    "start": 13.281,
    "end": 22.933,
    "duration": 9.652
  },
  {
    "id": 4,
    "text": "韩柳以复古为号召，掀起了旨在恢复先秦两汉散文传统的文学变革。",
    "start": 23.406,
    "end": 30.003,
    "duration": 6.597
  },
  {
    "id": 5,
    "text": "苏轼赞韩愈“文起八代之衰，道济天下之溺”。",
    "start": 30.532,
    "end": 33.744,
    "duration": 3.212
  },
  {
    "id": 6,
    "text": "古文运动的发生机制、理论纲领与韩柳散文艺术，主要体现在以下四个方面：",
    "start": 34.502,
    "end": 40.114,
    "duration": 5.612
  },
  {
    "id": 7,
    "text": "第一，立足中唐社会危局与儒学复兴诉求，确立以复古为革新的发生机制。",
    "start": 40.738,
    "end": 46.79,
    "duration": 6.052
  },
  {
    "id": 8,
    "text": "古文运动不仅是一场文体文字改革，更与中唐政治革新与儒学复兴思潮紧密相连。",
    "start": 47.548,
    "end": 55.09,
    "duration": 7.542
  },
  {
    "id": 9,
    "text": "安史之乱打破了大唐盛世的繁荣局面，士大夫深感国势衰落与纲常解体，",
    "start": 55.619,
    "end": 61.431,
    "duration": 5.812
  },
  {
    "id": 10,
    "text": "迫切要求重建儒家思想权威、革除时弊。",
    "start": 61.81,
    "end": 65.912,
    "duration": 4.102
  },
  {
    "id": 11,
    "text": "韩愈认为佛老学说削弱了国家伦理与财税根基，",
    "start": 66.441,
    "end": 69.773,
    "duration": 3.332
  },
  {
    "id": 12,
    "text": "而魏晋六朝以来讲求声律对偶、流于浮靡的骈体文，难以承载严肃的政治议论与经世之道。",
    "start": 70.152,
    "end": 78.934,
    "duration": 8.782
  },
  {
    "id": 13,
    "text": "于是韩柳主张效法先秦两汉散体古文，假复古之名行革新之实，",
    "start": 79.463,
    "end": 84.635,
    "duration": 5.172
  },
  {
    "id": 14,
    "text": "破除形式主义积弊，重振儒家道统与致用精神。",
    "start": 85.014,
    "end": 89.836,
    "duration": 4.822
  },
  {
    "id": 15,
    "text": "第二，系统提出“文以明道”与“气盛言宜”的散文理论纲领。",
    "start": 90.46,
    "end": 94.392,
    "duration": 3.932
  },
  {
    "id": 16,
    "text": "在理论建设上，韩愈与柳宗元构建了系统的散文美学主张。",
    "start": 95.07,
    "end": 99.402,
    "duration": 4.332
  },
  {
    "id": 17,
    "text": "在文道关系上，韩愈倡导“文以明道”，柳宗元亦主张“辅时及物”，",
    "start": 100.144,
    "end": 105.196,
    "duration": 5.052
  },
  {
    "id": 18,
    "text": "强调文章必须以阐发儒家义理、干预现实政治为核心宗旨；",
    "start": 105.575,
    "end": 110.267,
    "duration": 4.692
  },
  {
    "id": 19,
    "text": "在创作方法上，提出“唯陈言之务去”，",
    "start": 110.796,
    "end": 113.568,
    "duration": 2.772
  },
  {
    "id": 20,
    "text": "主张“师其意不师其辞”，坚决反对因袭剽窃前人陈词；",
    "start": 113.947,
    "end": 119.279,
    "duration": 5.332
  },
  {
    "id": 21,
    "text": "在文气修养上，提出“气盛则言之短长与声之高下者皆宜”，",
    "start": 119.808,
    "end": 123.14,
    "duration": 3.332
  },
  {
    "id": 22,
    "text": "认为作家内在的道德修养与精神气象决定文章的声气和谐；",
    "start": 123.519,
    "end": 129.251,
    "duration": 5.732
  },
  {
    "id": 23,
    "text": "在抒情动因上，韩愈提出“大凡物不得其平则鸣”，",
    "start": 129.841,
    "end": 132.093,
    "duration": 2.252
  },
  {
    "id": 24,
    "text": "揭示了文学创作源于现实不平与内心郁积的抒愤机制。",
    "start": 132.472,
    "end": 136.644,
    "duration": 4.172
  },
  {
    "id": 25,
    "text": "第三，革除骈体浮靡积弊，以单行散体打破排比对偶的文体束缚。",
    "start": 137.268,
    "end": 142.64,
    "duration": 5.372
  },
  {
    "id": 26,
    "text": "古文运动在文体形式上的突出贡献，在于打破了六朝以来排比对偶与声病音律对文章表达的长期束缚。",
    "start": 143.398,
    "end": 151.37,
    "duration": 7.972
  },
  {
    "id": 27,
    "text": "韩柳倡导单行散体，句式长短错落、参差多变，随情意表达的需要自由舒卷。",
    "start": 152.088,
    "end": 158.46,
    "duration": 6.372
  },
  {
    "id": 28,
    "text": "他们又并不全盘排斥骈文，而是吸收先秦两汉典雅文言与六朝骈语精华，",
    "start": 159.138,
    "end": 164.83,
    "duration": 5.692
  },
  {
    "id": 29,
    "text": "同时吸纳时下鲜活词语，如“文从字顺”与自铸新词，",
    "start": 165.209,
    "end": 169.421,
    "duration": 4.212
  },
  {
    "id": 30,
    "text": "使散文重新恢复了叙写复杂史事、展开严密论辩与描摹客观景物的表现力，",
    "start": 169.975,
    "end": 175.547,
    "duration": 5.572
  },
  {
    "id": 31,
    "text": "大幅拓展了散文的体裁边界与艺术空间。",
    "start": 175.926,
    "end": 178.738,
    "duration": 2.812
  },
  {
    "id": 32,
    "text": "第四，韩柳散文各擅胜场，共同奠定唐宋古文运动的典范格局。",
    "start": 179.47,
    "end": 184.482,
    "duration": 5.012
  },
  {
    "id": 33,
    "text": "韩愈与柳宗元在散文创作上同中有异、相得益彰。",
    "start": 185.16,
    "end": 188.932,
    "duration": 3.772
  },
  {
    "id": 34,
    "text": "韩愈散文气势雄健、汪洋恣肆，在《师说》中以严密论辩批判士大夫耻于从师的陋习，",
    "start": 189.65,
    "end": 200.302,
    "duration": 10.652
  },
  {
    "id": 35,
    "text": "在《马说》中借千里马遭遇抒发人才被埋没的悲愤；",
    "start": 201.06,
    "end": 203.032,
    "duration": 1.972
  },
  {
    "id": 36,
    "text": "柳宗元散文则峭拔清峻、笔锋犀利，",
    "start": 203.561,
    "end": 204.493,
    "duration": 0.932
  },
  {
    "id": 37,
    "text": "在杂说名篇《捕蛇者说》中借蒋氏三代遭遇揭示“孰知赋敛之毒有甚是蛇者乎”的主题，",
    "start": 204.872,
    "end": 211.674,
    "duration": 6.802
  },
  {
    "id": 38,
    "text": "在山水游记《永州八记》中开辟了融身世之悲于自然清幽的独特意境。",
    "start": 212.228,
    "end": 217.56,
    "duration": 5.332
  },
  {
    "id": 39,
    "text": "韩柳散文使散体取代骈体占据文坛主位，为北宋欧阳修、苏轼等人的诗文革新奠定了坚实基础。",
    "start": 218.089,
    "end": 225.821,
    "duration": 7.732
  },
  {
    "id": 40,
    "text": "总而言之，唐代古文运动以复兴儒学与革新文风为内在动力，",
    "start": 226.35,
    "end": 231.202,
    "duration": 4.852
  },
  {
    "id": 41,
    "text": "依托“文以明道”与“气盛言宜”的理论建设，",
    "start": 231.581,
    "end": 234.793,
    "duration": 3.212
  },
  {
    "id": 42,
    "text": "以单行散体打破了六朝以来骈俪文风的形式束缚。",
    "start": 235.172,
    "end": 239.224,
    "duration": 4.052
  },
  {
    "id": 43,
    "text": "韩愈的雄奇奔放与柳宗元的精深清幽相得益彰，使散体散文重回文坛正宗，",
    "start": 239.902,
    "end": 245.594,
    "duration": 5.692
  },
  {
    "id": 44,
    "text": "更为北宋欧阳修、苏轼推进诗文革新运动确立了思想与文体先声。",
    "start": 245.973,
    "end": 251.225,
    "duration": 5.252
  }
]