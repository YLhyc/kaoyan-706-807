[
  {
    "id": 1,
    "text": "试论唐代古文运动的发生机制、理论主张与韩柳散文艺术。",
    "start": 0.28,
    "end": 5.0,
    "duration": 4.72
  },
  {
    "id": 2,
    "text": "唐代古文运动是由韩愈、柳宗元在中唐时期领导的一场散文文体与文风革新运动。",
    "start": 5.52,
    "end": 12.96,
    "duration": 7.44
  },
  {
    "id": 3,
    "text": "面对安史之乱后藩镇割据加剧、朝政衰败、佛老盛行冲击儒学正统，以及六朝以来骈俪文风雕琢辞藻、内容空虚的局面，",
    "start": 13.48,
    "end": 23.77,
    "duration": 10.29
  },
  {
    "id": 4,
    "text": "韩柳以复古为号召，掀起了旨在恢复先秦两汉散文传统的文学变革。",
    "start": 24.14,
    "end": 29.58,
    "duration": 5.44
  },
  {
    "id": 5,
    "text": "苏轼赞韩愈“文起八代之衰，道济天下之溺”。",
    "start": 30.1,
    "end": 34.02,
    "duration": 3.92
  },
  {
    "id": 6,
    "text": "古文运动的发生机制、理论纲领与韩柳散文艺术，主要体现在以下四个方面：",
    "start": 34.54,
    "end": 39.98,
    "duration": 5.44
  },
  {
    "id": 7,
    "text": "第一，立足中唐社会危局与儒学复兴诉求，确立以复古为革新的发生机制。",
    "start": 40.35,
    "end": 46.91,
    "duration": 6.56
  },
  {
    "id": 8,
    "text": "古文运动不仅是一场文体文字改革，更与中唐政治革新与儒学复兴思潮紧密相连。",
    "start": 47.43,
    "end": 54.39,
    "duration": 6.96
  },
  {
    "id": 9,
    "text": "安史之乱打破了大唐盛世的繁荣局面，士大夫深感国势衰落与纲常解体，",
    "start": 54.91,
    "end": 60.96,
    "duration": 6.05
  },
  {
    "id": 10,
    "text": "迫切要求重建儒家思想权威、革除时弊。",
    "start": 61.33,
    "end": 64.93,
    "duration": 3.6
  },
  {
    "id": 11,
    "text": "韩愈认为佛老学说削弱了国家伦理与财税根基，",
    "start": 65.45,
    "end": 69.29,
    "duration": 3.84
  },
  {
    "id": 12,
    "text": "而魏晋六朝以来讲求声律对偶、流于浮靡的骈体文，难以承载严肃的政治议论与经世之道。",
    "start": 69.66,
    "end": 77.5,
    "duration": 7.84
  },
  {
    "id": 13,
    "text": "于是韩柳主张效法先秦两汉散体古文，假复古之名行革新之实，",
    "start": 78.02,
    "end": 84.26,
    "duration": 6.24
  },
  {
    "id": 14,
    "text": "破除形式主义积弊，重振儒家道统与致用精神。",
    "start": 84.63,
    "end": 88.63,
    "duration": 4.0
  },
  {
    "id": 15,
    "text": "第二，系统提出“文以明道”与“气盛言宜”的散文理论纲领。",
    "start": 89.15,
    "end": 93.874,
    "duration": 4.724
  },
  {
    "id": 16,
    "text": "在理论建设上，韩愈与柳宗元构建了系统的散文美学主张。",
    "start": 94.374,
    "end": 99.274,
    "duration": 4.9
  },
  {
    "id": 17,
    "text": "在文道关系上，韩愈倡导“文以明道”，柳宗元亦主张“辅时及物”，",
    "start": 99.774,
    "end": 105.07,
    "duration": 5.296
  },
  {
    "id": 18,
    "text": "强调文章必须以阐发儒家义理、干预现实政治为核心宗旨；",
    "start": 105.44,
    "end": 109.999,
    "duration": 4.559
  },
  {
    "id": 19,
    "text": "在创作方法上，提出“唯陈言之务去”，",
    "start": 110.499,
    "end": 113.8,
    "duration": 3.301
  },
  {
    "id": 20,
    "text": "主张“师其意不师其辞”，坚决反对因袭剽窃前人陈词；",
    "start": 114.17,
    "end": 119.21,
    "duration": 5.04
  },
  {
    "id": 21,
    "text": "在文气修养上，提出“气盛则言之短长与声之高下者皆宜”，",
    "start": 119.73,
    "end": 125.01,
    "duration": 5.28
  },
  {
    "id": 22,
    "text": "认为作家内在的道德修养与精神气象决定文章的声气和谐；",
    "start": 125.49,
    "end": 130.37,
    "duration": 4.88
  },
  {
    "id": 23,
    "text": "在抒情动因上，韩愈提出“大凡物不得其平则鸣”，",
    "start": 130.89,
    "end": 135.13,
    "duration": 4.24
  },
  {
    "id": 24,
    "text": "揭示了文学创作源于现实不平与内心郁积的抒愤机制。",
    "start": 135.5,
    "end": 140.22,
    "duration": 4.72
  },
  {
    "id": 25,
    "text": "第三，革除骈体浮靡积弊，以单行散体打破排比对偶的文体束缚。",
    "start": 140.74,
    "end": 146.42,
    "duration": 5.68
  },
  {
    "id": 26,
    "text": "古文运动在文体形式上的突出贡献，在于打破了六朝以来排比对偶与声病音律对文章表达的长期束缚。",
    "start": 146.94,
    "end": 155.26,
    "duration": 8.32
  },
  {
    "id": 27,
    "text": "韩柳倡导单行散体，句式长短错落、参差多变，随情意表达的需要自由舒卷。",
    "start": 155.78,
    "end": 162.18,
    "duration": 6.4
  },
  {
    "id": 28,
    "text": "他们又并不全盘排斥骈文，而是吸收先秦两汉典雅文言与六朝骈语精华，",
    "start": 162.7,
    "end": 168.78,
    "duration": 6.08
  },
  {
    "id": 29,
    "text": "同时吸纳时下鲜活词语，如“文从字顺”与自铸新词，",
    "start": 169.15,
    "end": 173.87,
    "duration": 4.72
  },
  {
    "id": 30,
    "text": "使散文重新恢复了叙写复杂史事、展开严密论辩与描摹客观景物的表现力，",
    "start": 174.275,
    "end": 181.04,
    "duration": 6.765
  },
  {
    "id": 31,
    "text": "大幅拓展了散文的体裁边界与艺术空间。",
    "start": 181.41,
    "end": 184.85,
    "duration": 3.44
  },
  {
    "id": 32,
    "text": "第四，韩柳散文各擅胜场，共同奠定唐宋古文运动的典范格局。",
    "start": 185.37,
    "end": 191.05,
    "duration": 5.68
  },
  {
    "id": 33,
    "text": "韩愈与柳宗元在散文创作上同中有异、相得益彰。",
    "start": 191.57,
    "end": 195.97,
    "duration": 4.4
  },
  {
    "id": 34,
    "text": "韩愈散文气势雄健、汪洋恣肆，在《师说》中以严密论辩批判士大夫耻于从师的陋习，",
    "start": 196.49,
    "end": 203.9,
    "duration": 7.41
  },
  {
    "id": 35,
    "text": "在《马说》中借千里马遭遇抒发人才被埋没的悲愤；",
    "start": 204.27,
    "end": 208.03,
    "duration": 3.76
  },
  {
    "id": 36,
    "text": "柳宗元散文则峭拔清峻、笔锋犀利，",
    "start": 208.55,
    "end": 211.67,
    "duration": 3.12
  },
  {
    "id": 37,
    "text": "在杂说名篇《捕蛇者说》中借蒋氏三代遭遇揭示“孰知赋敛之毒有甚是蛇者乎”的主题，",
    "start": 212.04,
    "end": 219.72,
    "duration": 7.68
  },
  {
    "id": 38,
    "text": "在山水游记《永州八记》中开辟了融身世之悲于自然清幽的独特意境。",
    "start": 220.09,
    "end": 225.996,
    "duration": 5.906
  },
  {
    "id": 39,
    "text": "韩柳散文使散体取代骈体占据文坛主位，为北宋欧阳修、苏轼等人的诗文革新奠定了坚实基础。",
    "start": 226.496,
    "end": 234.85,
    "duration": 8.354
  },
  {
    "id": 40,
    "text": "总而言之，唐代古文运动以复兴儒学与革新文风为内在动力，",
    "start": 235.37,
    "end": 240.89,
    "duration": 5.52
  },
  {
    "id": 41,
    "text": "依托“文以明道”与“气盛言宜”的理论建设，",
    "start": 241.26,
    "end": 244.3,
    "duration": 3.04
  },
  {
    "id": 42,
    "text": "以单行散体打破了六朝以来骈俪文风的形式束缚。",
    "start": 244.67,
    "end": 248.99,
    "duration": 4.32
  },
  {
    "id": 43,
    "text": "韩愈的雄奇奔放与柳宗元的精深清幽相得益彰，使散体散文重回文坛正宗，",
    "start": 249.51,
    "end": 256.36,
    "duration": 6.85
  },
  {
    "id": 44,
    "text": "更为北宋欧阳修、苏轼推进诗文革新运动确立了思想与文体先声。",
    "start": 256.73,
    "end": 262.41,
    "duration": 5.68
  }
]
