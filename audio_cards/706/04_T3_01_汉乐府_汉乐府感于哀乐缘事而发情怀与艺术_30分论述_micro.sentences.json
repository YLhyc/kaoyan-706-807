[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "灵魂→体式→写人→技法与传承：先从班固十二字定性切入底层疾苦内核，",
    "start": 0.235,
    "end": 7.785,
    "duration": 7.549
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "看重叙事内容如何催生出杂言、五言及1700余字《孔雀东南飞》，",
    "start": 8.506,
    "end": 14.589,
    "duration": 6.083
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再细拆它如何靠晨起严妆、对答反讽写活人物，",
    "start": 15.316,
    "end": 19.398,
    "duration": 4.082
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后点明其如何经建安直哺杜甫“即事名篇”与白居易新乐府。",
    "start": 20.189,
    "end": 25.094,
    "duration": 4.904
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "两汉乐府民歌采自民间，继承《诗经》风雅，摆脱汉大赋浮华，",
    "start": 25.873,
    "end": 30.876,
    "duration": 5.004
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "班固《汉书·艺文志》概括为“感于哀乐，缘事而发”。",
    "start": 31.71,
    "end": 35.746,
    "duration": 4.036
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 确立“感于哀乐，缘事而发”写实魂",
    "start": 36.44,
    "end": 39.933,
    "duration": 3.494
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "“缘事而发”紧扣生活具体事件，“感于哀乐”倾注百姓真挚苦乐爱恨；",
    "start": 40.775,
    "end": 46.084,
    "duration": 5.309
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《十五从军征》“八十始得归”控诉兵役残酷；",
    "start": 46.84,
    "end": 49.92,
    "duration": 3.08
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《东门行》写“盎中无斗米储”拔剑而起；",
    "start": 50.675,
    "end": 53.254,
    "duration": 2.579
  },
  {
    "id": "sec0_step1_c2",
    "dom_key": "sec0_step1_c2",
    "text": "《妇病行》刻画病妇托孤、孤儿啼食惨状。",
    "start": 54.088,
    "end": 57.242,
    "duration": 3.153
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 由四言向杂言、五言与成熟叙事诗演进",
    "start": 58.026,
    "end": 62.551,
    "duration": 4.526
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "吸收楚声与民间曲调发展出杂言体与日臻成熟五言诗，为文人五言奠基；",
    "start": 63.271,
    "end": 69.809,
    "duration": 6.538
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《孔雀东南飞》一千七百余字，绕刘兰芝遣归、阿兄逼嫁与双双殉情双线交错，标志古代叙事诗成熟。",
    "start": 70.57,
    "end": 79.09,
    "duration": 8.52
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 戏剧冲突中借对话与细节写活典型",
    "start": 79.973,
    "end": 84.06,
    "duration": 4.087
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "刘兰芝外柔内刚，离别晨起严妆“著我绣裌裙，事事四五通”以维护尊严；",
    "start": 84.809,
    "end": 90.698,
    "duration": 5.889
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "配焦仲卿软弱、焦母专横、刘兄市侩，无不肖其声情；",
    "start": 91.472,
    "end": 96.032,
    "duration": 4.56
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "秦罗敷面对太守调戏，巧以夸耀夫婿诙谐言辞戏弄权贵，显机智骨气。",
    "start": 96.829,
    "end": 102.881,
    "duration": 6.052
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 融比兴复沓想象、哺育建安与唐诗",
    "start": 103.59,
    "end": 107.332,
    "duration": 3.742
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "《孔雀东南飞》起兴定调与合葬化鸟浪漫理想；《江南》“莲叶何田田，鱼戏莲叶东”复沓明朗乐感；",
    "start": 108.068,
    "end": 115.789,
    "duration": 7.721
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "直接哺育建安曹氏父子乐府，成唐代杜甫“即事名篇”与白居易“新乐府运动”源头。",
    "start": 116.627,
    "end": 123.303,
    "duration": 6.676
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "汉乐府立足“感于哀乐，缘事而发”，完成从四言向杂言、五言叙事诗过渡，",
    "start": 124.103,
    "end": 130.259,
    "duration": 6.156
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "其缘事写人传统直接哺育建安文学及唐代杜甫、白居易现实主义诗歌。",
    "start": 131.032,
    "end": 137.104,
    "duration": 6.071
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：班固在《汉书·艺文志》概括“感于哀乐，缘事而发”；",
    "start": 137.871,
    "end": 142.737,
    "duration": 4.866
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "《孔雀东南飞》是我国古代保存下来的最长叙事诗（约1700余字）。",
    "start": 143.464,
    "end": 148.601,
    "duration": 5.137
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 出自《汉书·艺文志》的汉乐府核心八字定评是什么？",
    "start": 149.309,
    "end": 154.563,
    "duration": 5.253
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《孔雀东南飞》谈清汉乐府“体制长度、矛盾冲突、细节严妆、起兴化鸟”四处亮点？",
    "start": 155.288,
    "end": 163.995,
    "duration": 8.706
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 列出汉乐府与诗经、建安、杜甫、白居易之间的历史接力关系？",
    "start": 164.832,
    "end": 171.739,
    "duration": 6.907
  }
]