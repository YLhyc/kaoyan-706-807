[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "汉乐府·感于哀乐缘事而发情怀与艺术",
    "start": 0.134,
    "end": 3.518,
    "duration": 3.384
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "灵魂→体式→写人→技法与传承：先从班固十二字定性切入底层疾苦内核，",
    "start": 4.107,
    "end": 11.867,
    "duration": 7.759
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "看重叙事内容如何催生出杂言、五言及1700余字《孔雀东南飞》，",
    "start": 12.193,
    "end": 18.351,
    "duration": 6.158
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再细拆它如何靠晨起严妆、对答反讽写活人物，",
    "start": 18.465,
    "end": 22.644,
    "duration": 4.179
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后点明其如何经建安直哺杜甫“即事名篇”与白居易新乐府。",
    "start": 22.931,
    "end": 28.139,
    "duration": 5.207
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "两汉乐府民歌采自民间，继承《诗经》风雅，摆脱汉大赋浮华，",
    "start": 28.726,
    "end": 33.907,
    "duration": 5.181
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "班固《汉书·艺文志》概括为“感于哀乐，缘事而发”。",
    "start": 34.051,
    "end": 38.347,
    "duration": 4.296
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 确立“感于哀乐，缘事而发”写实魂",
    "start": 38.934,
    "end": 42.839,
    "duration": 3.905
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "“缘事而发”紧扣生活具体事件，“感于哀乐”倾注百姓真挚苦乐爱恨；",
    "start": 43.413,
    "end": 49.363,
    "duration": 5.949
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《十五从军征》“八十始得归”控诉兵役残酷；",
    "start": 49.95,
    "end": 54.857,
    "duration": 4.908
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《东门行》写“盎中无斗米储”拔剑而起；",
    "start": 55.132,
    "end": 58.269,
    "duration": 3.137
  },
  {
    "id": "sec0_step1_c2",
    "dom_key": "sec0_step1_c2",
    "text": "《妇病行》刻画病妇托孤、孤儿啼食惨状。",
    "start": 58.53,
    "end": 62.41,
    "duration": 3.879
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 由四言向杂言、五言与成熟叙事诗演进",
    "start": 62.983,
    "end": 67.683,
    "duration": 4.7
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "吸收楚声与民间曲调发展出杂言体与日臻成熟五言诗，为文人五言奠基；",
    "start": 68.27,
    "end": 75.873,
    "duration": 7.603
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《孔雀东南飞》一千七百余字，绕刘兰芝遣归、阿兄逼嫁与双双殉情双线交错，标志古代叙事诗成熟。",
    "start": 76.46,
    "end": 86.55,
    "duration": 10.09
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 戏剧冲突中借对话与细节写活典型",
    "start": 87.124,
    "end": 91.355,
    "duration": 4.231
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "刘兰芝外柔内刚，离别晨起严妆“著我绣裌裙，事事四五通”以维护尊严；",
    "start": 91.942,
    "end": 99.206,
    "duration": 7.265
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "配焦仲卿软弱、焦母专横、刘兄市侩，无不肖其声情；",
    "start": 99.364,
    "end": 104.441,
    "duration": 5.077
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "秦罗敷面对太守调戏，巧以夸耀夫婿诙谐言辞戏弄权贵，显机智骨气。",
    "start": 105.028,
    "end": 112.514,
    "duration": 7.486
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 融比兴复沓想象、哺育建安与唐诗",
    "start": 113.101,
    "end": 116.941,
    "duration": 3.84
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "《孔雀东南飞》起兴定调与合葬化鸟浪漫理想；《江南》“莲叶何田田，鱼戏莲叶东”复沓明朗乐感；",
    "start": 117.528,
    "end": 126.485,
    "duration": 8.957
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "直接哺育建安曹氏父子乐府，成唐代杜甫“即事名篇”与白居易“新乐府运动”源头。",
    "start": 127.059,
    "end": 135.196,
    "duration": 8.137
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "汉乐府立足“感于哀乐，缘事而发”，完成从四言向杂言、五言叙事诗过渡，",
    "start": 135.783,
    "end": 142.201,
    "duration": 6.418
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "其缘事写人传统直接哺育建安文学及唐代杜甫、白居易现实主义诗歌。",
    "start": 142.476,
    "end": 148.79,
    "duration": 6.314
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：班固在《汉书·艺文志》概括“感于哀乐，缘事而发”；",
    "start": 149.377,
    "end": 154.402,
    "duration": 5.025
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "《孔雀东南飞》是我国古代保存下来的最长叙事诗（约1700余字）。",
    "start": 154.663,
    "end": 160.066,
    "duration": 5.403
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 出自《汉书·艺文志》的汉乐府核心八字定评是什么？",
    "start": 160.627,
    "end": 166.003,
    "duration": 5.377
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《孔雀东南飞》谈清汉乐府“体制长度、矛盾冲突、细节严妆、起兴化鸟”四处亮点？",
    "start": 166.564,
    "end": 175.717,
    "duration": 9.153
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 列出汉乐府与诗经、建安、杜甫、白居易之间的历史接力关系？",
    "start": 176.304,
    "end": 183.36,
    "duration": 7.056
  }
]