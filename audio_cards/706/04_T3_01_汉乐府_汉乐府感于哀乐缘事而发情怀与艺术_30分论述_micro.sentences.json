[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "汉乐府·感于哀乐缘事而发情怀与艺术",
    "start": 0.354,
    "end": 4.166,
    "duration": 3.812
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "灵魂→体式→写人→技法与传承：先从班固十二字定性切入底层疾苦内核，",
    "start": 5.094,
    "end": 12.866,
    "duration": 7.772
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "看重叙事内容如何催生出杂言、五言及1700余字《孔雀东南飞》，",
    "start": 13.014,
    "end": 18.706,
    "duration": 5.692
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再细拆它如何靠晨起严妆、对答反讽写活人物，",
    "start": 18.934,
    "end": 23.366,
    "duration": 4.432
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后点明其如何经建安直哺杜甫“即事名篇”与白居易新乐府。",
    "start": 23.494,
    "end": 29.466,
    "duration": 5.972
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "两汉乐府民歌采自民间，继承《诗经》风雅，摆脱汉大赋浮华，",
    "start": 30.434,
    "end": 36.166,
    "duration": 5.732
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "班固《汉书·艺文志》概括为“感于哀乐，缘事而发”。",
    "start": 36.714,
    "end": 40.966,
    "duration": 4.252
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 确立“感于哀乐，缘事而发”写实魂",
    "start": 41.894,
    "end": 45.866,
    "duration": 3.972
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "“缘事而发”紧扣生活具体事件，“感于哀乐”倾注百姓真挚苦乐爱恨；",
    "start": 46.874,
    "end": 53.926,
    "duration": 7.052
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《十五从军征》“八十始得归”控诉兵役残酷；",
    "start": 54.974,
    "end": 59.266,
    "duration": 4.292
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《东门行》写“盎中无斗米储”拔剑而起；",
    "start": 60.194,
    "end": 63.566,
    "duration": 3.372
  },
  {
    "id": "sec0_step1_c2",
    "dom_key": "sec0_step1_c2",
    "text": "《妇病行》刻画病妇托孤、孤儿啼食惨状。",
    "start": 64.574,
    "end": 68.226,
    "duration": 3.652
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 由四言向杂言、五言与成熟叙事诗演进",
    "start": 69.154,
    "end": 73.166,
    "duration": 4.012
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "吸收楚声与民间曲调发展出杂言体与日臻成熟五言诗，为文人五言奠基；",
    "start": 74.094,
    "end": 81.946,
    "duration": 7.852
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《孔雀东南飞》一千七百余字，绕刘兰芝遣归、阿兄逼嫁与双双殉情双线交错，标志古代叙事诗成熟。",
    "start": 82.994,
    "end": 95.086,
    "duration": 12.092
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 戏剧冲突中借对话与细节写活典型",
    "start": 95.794,
    "end": 100.406,
    "duration": 4.612
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "刘兰芝外柔内刚，离别晨起严妆“著我绣裌裙，事事四五通”以维护尊严；",
    "start": 101.234,
    "end": 109.446,
    "duration": 8.212
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "配焦仲卿软弱、焦母专横、刘兄市侩，无不肖其声情；",
    "start": 109.634,
    "end": 115.326,
    "duration": 5.692
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "秦罗敷面对太守调戏，巧以夸耀夫婿诙谐言辞戏弄权贵，显机智骨气。",
    "start": 116.374,
    "end": 125.386,
    "duration": 9.012
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 融比兴复沓想象、哺育建安与唐诗",
    "start": 126.354,
    "end": 131.166,
    "duration": 4.812
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "《孔雀东南飞》起兴定调与合葬化鸟浪漫理想；《江南》“莲叶何田田，鱼戏莲叶东”复沓明朗乐感；",
    "start": 132.214,
    "end": 143.446,
    "duration": 11.232
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "直接哺育建安曹氏父子乐府，成唐代杜甫“即事名篇”与白居易“新乐府运动”源头。",
    "start": 144.454,
    "end": 152.666,
    "duration": 8.212
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "汉乐府立足“感于哀乐，缘事而发”，完成从四言向杂言、五言叙事诗过渡，",
    "start": 153.714,
    "end": 160.606,
    "duration": 6.892
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "其缘事写人传统直接哺育建安文学及唐代杜甫、白居易现实主义诗歌。",
    "start": 160.754,
    "end": 167.686,
    "duration": 6.932
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：班固在《汉书·艺文志》概括“感于哀乐，缘事而发”；",
    "start": 168.814,
    "end": 174.066,
    "duration": 5.252
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "《孔雀东南飞》是我国古代保存下来的最长叙事诗（约1700余字）。",
    "start": 175.074,
    "end": 180.926,
    "duration": 5.852
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 出自《汉书·艺文志》的汉乐府核心八字定评是什么？",
    "start": 181.894,
    "end": 187.306,
    "duration": 5.412
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《孔雀东南飞》谈清汉乐府“体制长度、矛盾冲突、细节严妆、起兴化鸟”四处亮点？",
    "start": 188.274,
    "end": 197.806,
    "duration": 9.532
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 列出汉乐府与诗经、建安、杜甫、白居易之间的历史接力关系？",
    "start": 198.219,
    "end": 205.391,
    "duration": 7.172
  }
]