[
  {
    "id": 1,
    "text": "试论苏轼与辛弃疾词作艺术成就及“以诗入词”与“以文为词”之异同。",
    "start": 0.28,
    "end": 5.96,
    "duration": 5.68
  },
  {
    "id": 2,
    "text": "苏轼与辛弃疾是宋代豪放词派双峰并峙的两大大家，共同将宋词推向文学史高峰。",
    "start": 6.48,
    "end": 14.0,
    "duration": 7.52
  },
  {
    "id": 3,
    "text": "面对“词为艳科”的旧习，苏轼以“以诗为词”拓宽词境，辛弃疾以“以文为词”深化变革，",
    "start": 14.52,
    "end": 22.33,
    "duration": 7.81
  },
  {
    "id": 4,
    "text": "二人一承一继，使词挣脱樽前娱人的局限，成为与诗并立的抒情言志之体。",
    "start": 22.7,
    "end": 29.42,
    "duration": 6.72
  },
  {
    "id": 5,
    "text": "周济在《宋四家词选》中评道：“苏、辛并称。东坡天趣独到处，殆成绝诣，而苦不经意，完璧甚少。稼轩则沉着痛快，有辙可循。”",
    "start": 29.94,
    "end": 41.96,
    "duration": 12.02
  },
  {
    "id": 6,
    "text": "二人在词史贡献与创作风格上的异同，主要体现在以下四个方面：",
    "start": 42.48,
    "end": 47.44,
    "duration": 4.96
  },
  {
    "id": 7,
    "text": "第一，革除词为艳科传统，由“以诗为词”递进至“以文为词”。",
    "start": 47.81,
    "end": 53.01,
    "duration": 5.2
  },
  {
    "id": 8,
    "text": "苏辛共同的历史功绩在于打破声律与题材对词体的束缚，而在革新路径上层层递进。",
    "start": 53.562,
    "end": 60.09,
    "duration": 6.528
  },
  {
    "id": 9,
    "text": "苏轼确立“诗词一体”之说，称词“盖诗之裔”，力主“自是一家”，广用标题小序，",
    "start": 60.642,
    "end": 68.05,
    "duration": 7.408
  },
  {
    "id": 10,
    "text": "将诗歌的思想立意、题材范围与抒情手法移植入词，使词走向诗意化与哲理化；",
    "start": 68.42,
    "end": 75.14,
    "duration": 6.72
  },
  {
    "id": 11,
    "text": "辛弃疾则在苏轼基础上推进“以文为词”，进一步打破对称句式的限制，",
    "start": 75.705,
    "end": 81.39,
    "duration": 5.685
  },
  {
    "id": 12,
    "text": "把先秦两汉散文及辞赋的章法结构、问答设论与古文句法融入词中，",
    "start": 81.76,
    "end": 87.76,
    "duration": 6.0
  },
  {
    "id": 13,
    "text": "使词兼具散文化的纵横气势与严密逻辑，大幅拓展了词的艺术容量。",
    "start": 88.165,
    "end": 93.97,
    "duration": 5.805
  },
  {
    "id": 14,
    "text": "第二，立足不同时代际遇，分呈清旷超然与英雄悲壮的情感底色。",
    "start": 94.49,
    "end": 100.643,
    "duration": 6.153
  },
  {
    "id": 15,
    "text": "时代境遇与人生身份的差异塑造了二人不同的词风质感。",
    "start": 101.143,
    "end": 105.73,
    "duration": 4.587
  },
  {
    "id": 16,
    "text": "苏轼生活在北宋承平时期，矛盾主要在于仕途升降与党争挫败。",
    "start": 106.25,
    "end": 111.85,
    "duration": 5.6
  },
  {
    "id": 17,
    "text": "经历乌台诗案与黄州贬谪后，他凭借佛道哲思超越现实困顿，",
    "start": 112.37,
    "end": 117.57,
    "duration": 5.2
  },
  {
    "id": 18,
    "text": "词风清雄旷达：在定慧院守持“拣尽寒枝不肯栖”的孤高，",
    "start": 117.983,
    "end": 123.22,
    "duration": 5.237
  },
  {
    "id": 19,
    "text": "在赤壁矶头以“一尊还酹江月”排遣得失，在沙湖道中升华为“也无风雨也无晴”的超然；",
    "start": 123.62,
    "end": 131.46,
    "duration": 7.84
  },
  {
    "id": 20,
    "text": "辛弃疾则身处南宋偏安、中原沦丧的民族危局，身为沙场豪杰而备受猜忌排挤，",
    "start": 132.013,
    "end": 139.23,
    "duration": 7.217
  },
  {
    "id": 21,
    "text": "报国无门而“把吴钩看了，阑干拍遍”，",
    "start": 139.6,
    "end": 143.04,
    "duration": 3.44
  },
  {
    "id": 22,
    "text": "在《破阵子》中由梦回吹角连营骤转“可怜白发生”，词风充溢着英雄失路的沉郁悲壮。",
    "start": 143.41,
    "end": 151.17,
    "duration": 7.76
  },
  {
    "id": 23,
    "text": "第三，同擅使事用典，分呈浑化无痕与用经用史讽世之艺术风貌。",
    "start": 151.69,
    "end": 157.688,
    "duration": 5.998
  },
  {
    "id": 24,
    "text": "在用典手法上，苏轼以作诗之法入词，善于点化历史典故而浑然天成、如水中着盐。",
    "start": 158.188,
    "end": 165.65,
    "duration": 7.462
  },
  {
    "id": 25,
    "text": "如《江城子·密州出猎》中随手化用孙权射虎与冯唐持节两典，抒发报国豪情而全无堆砌之感；",
    "start": 166.17,
    "end": 174.33,
    "duration": 8.16
  },
  {
    "id": 26,
    "text": "辛弃疾则精于“用经用史”之法，",
    "start": 174.891,
    "end": 177.57,
    "duration": 2.679
  },
  {
    "id": 27,
    "text": "刘辰翁赞其“牵雅颂入郑卫”，将经史典故化为政治讽喻的利器。",
    "start": 177.94,
    "end": 184.102,
    "duration": 6.162
  },
  {
    "id": 28,
    "text": "在《永遇乐·京口北固亭怀古》中，全词百余字内密集连用孙权、刘裕、刘义隆、佛狸祠与廉颇五典，",
    "start": 184.602,
    "end": 193.55,
    "duration": 8.948
  },
  {
    "id": 29,
    "text": "借古讽今，切中南宋草率北伐的时弊，表现出强烈的现实批判力度。",
    "start": 193.92,
    "end": 199.52,
    "duration": 5.6
  },
  {
    "id": 30,
    "text": "第四，共筑宋代豪放词派基石，树立与五七言古诗并峙的词史地位。",
    "start": 200.04,
    "end": 205.96,
    "duration": 5.92
  },
  {
    "id": 31,
    "text": "苏轼与辛弃疾均在豪放主调之外兼备多样的词风造诣。",
    "start": 206.503,
    "end": 210.96,
    "duration": 4.457
  },
  {
    "id": 32,
    "text": "苏词兼有《江城子》“十年生死两茫茫”的深沉悼亡与清幽婉转；",
    "start": 211.523,
    "end": 216.749,
    "duration": 5.226
  },
  {
    "id": 33,
    "text": "辛词亦兼有《清平乐·村居》的田园天真与谐谑自嘲。",
    "start": 217.249,
    "end": 222.56,
    "duration": 5.311
  },
  {
    "id": 34,
    "text": "苏轼为词坛指明了向上一路，辛弃疾则率领南宋辛派词人将爱国悲歌推向高峰。",
    "start": 223.08,
    "end": 230.12,
    "duration": 7.04
  },
  {
    "id": 35,
    "text": "苏辛并称，共同奠定了豪放一派在宋词史上的崇高地位。",
    "start": 230.64,
    "end": 235.28,
    "duration": 4.64
  },
  {
    "id": 36,
    "text": "综观苏辛之变，苏轼的“以诗为词”重在突破“词为艳科”藩篱、注入清旷自适的文人胸襟，",
    "start": 235.8,
    "end": 243.48,
    "duration": 7.68
  },
  {
    "id": 37,
    "text": "辛弃疾的“以文为词”则进一步融化经史典故与散文句法，抒写恢复中原的英雄悲慨。",
    "start": 243.896,
    "end": 251.45,
    "duration": 7.554
  },
  {
    "id": 38,
    "text": "二人一承一继、同而不同，彻底拓宽了词体的题材格局与表现力，",
    "start": 251.97,
    "end": 257.73,
    "duration": 5.76
  },
  {
    "id": 39,
    "text": "将宋代豪放词派推向与五、七言诗歌并峙的高度。",
    "start": 258.13,
    "end": 262.37,
    "duration": 4.24
  }
]
