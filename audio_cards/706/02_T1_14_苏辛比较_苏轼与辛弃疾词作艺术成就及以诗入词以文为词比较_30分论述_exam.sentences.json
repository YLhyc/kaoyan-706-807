[
  {
    "id": 1,
    "text": "试论苏轼与辛弃疾词作艺术成就及“以诗入词”与“以文为词”之异同。",
    "start": 0.134,
    "end": 5.666,
    "duration": 5.532
  },
  {
    "id": 2,
    "text": "苏轼与辛弃疾是宋代豪放词派双峰并峙的两大大家，共同将宋词推向文学史高峰。",
    "start": 6.383,
    "end": 12.995,
    "duration": 6.612
  },
  {
    "id": 3,
    "text": "面对“词为艳科”的旧习，苏轼以“以诗为词”拓宽词境，辛弃疾以“以文为词”深化变革，",
    "start": 13.793,
    "end": 20.485,
    "duration": 6.692
  },
  {
    "id": 4,
    "text": "二人一承一继，使词挣脱樽前娱人的局限，成为与诗并立的抒情言志之体。",
    "start": 20.864,
    "end": 26.876,
    "duration": 6.012
  },
  {
    "id": 5,
    "text": "周济在《宋四家词选》中评道：“苏、辛并称。东坡天趣独到处，殆成绝诣，而苦不经意，完璧甚少。稼轩则沉着痛快，有辙可循。”",
    "start": 27.554,
    "end": 31.006,
    "duration": 3.452
  },
  {
    "id": 6,
    "text": "二人在词史贡献与创作风格上的异同，主要体现在以下四个方面：",
    "start": 31.724,
    "end": 36.256,
    "duration": 4.532
  },
  {
    "id": 7,
    "text": "第一，革除词为艳科传统，由“以诗为词”递进至“以文为词”。",
    "start": 36.894,
    "end": 39.186,
    "duration": 2.292
  },
  {
    "id": 8,
    "text": "苏辛共同的历史功绩在于打破声律与题材对词体的束缚，而在革新路径上层层递进。",
    "start": 39.904,
    "end": 49.916,
    "duration": 10.012
  },
  {
    "id": 9,
    "text": "苏轼确立“诗词一体”之说，称词“盖诗之裔”，力主“自是一家”，广用标题小序，",
    "start": 50.634,
    "end": 54.926,
    "duration": 4.292
  },
  {
    "id": 10,
    "text": "将诗歌的思想立意、题材范围与抒情手法移植入词，使词走向诗意化与哲理化；",
    "start": 55.305,
    "end": 59.767,
    "duration": 4.462
  },
  {
    "id": 11,
    "text": "辛弃疾则在苏轼基础上推进“以文为词”，进一步打破对称句式的限制，",
    "start": 60.296,
    "end": 63.028,
    "duration": 2.732
  },
  {
    "id": 12,
    "text": "把先秦两汉散文及辞赋的章法结构、问答设论与古文句法融入词中，",
    "start": 63.407,
    "end": 68.979,
    "duration": 5.572
  },
  {
    "id": 13,
    "text": "使词兼具散文化的纵横气势与严密逻辑，大幅拓展了词的艺术容量。",
    "start": 69.358,
    "end": 71.53,
    "duration": 2.172
  },
  {
    "id": 14,
    "text": "第二，立足不同时代际遇，分呈清旷超然与英雄悲壮的情感底色。",
    "start": 72.208,
    "end": 89.789,
    "duration": 17.581
  },
  {
    "id": 15,
    "text": "时代境遇与人生身份的差异塑造了二人不同的词风质感。",
    "start": 90.478,
    "end": 95.77,
    "duration": 5.292
  },
  {
    "id": 16,
    "text": "苏轼生活在北宋承平时期，矛盾主要在于仕途升降与党争挫败。",
    "start": 96.408,
    "end": 106.1,
    "duration": 9.692
  },
  {
    "id": 17,
    "text": "经历乌台诗案与黄州贬谪后，他凭借佛道哲思超越现实困顿，",
    "start": 106.629,
    "end": 113.001,
    "duration": 6.372
  },
  {
    "id": 18,
    "text": "词风清雄旷达：在定慧院守持“拣尽寒枝不肯栖”的孤高，",
    "start": 113.38,
    "end": 116.472,
    "duration": 3.092
  },
  {
    "id": 19,
    "text": "在赤壁矶头以“一尊还酹江月”排遣得失，在沙湖道中升华为“也无风雨也无晴”的超然；",
    "start": 116.985,
    "end": 123.997,
    "duration": 7.012
  },
  {
    "id": 20,
    "text": "辛弃疾则身处南宋偏安、中原沦丧的民族危局，身为沙场豪杰而备受猜忌排挤，",
    "start": 124.526,
    "end": 131.498,
    "duration": 6.972
  },
  {
    "id": 21,
    "text": "报国无门而“把吴钩看了，阑干拍遍”，",
    "start": 131.877,
    "end": 133.689,
    "duration": 1.812
  },
  {
    "id": 22,
    "text": "在《破阵子》中由梦回吹角连营骤转“可怜白发生”，词风充溢着英雄失路的沉郁悲壮。",
    "start": 134.078,
    "end": 142.01,
    "duration": 7.932
  },
  {
    "id": 23,
    "text": "第三，同擅使事用典，分呈浑化无痕与用经用史讽世之艺术风貌。",
    "start": 142.634,
    "end": 148.806,
    "duration": 6.172
  },
  {
    "id": 24,
    "text": "在用典手法上，苏轼以作诗之法入词，善于点化历史典故而浑然天成、如水中着盐。",
    "start": 149.444,
    "end": 155.616,
    "duration": 6.172
  },
  {
    "id": 25,
    "text": "如《江城子·密州出猎》中随手化用孙权射虎与冯唐持节两典，抒发报国豪情而全无堆砌之感；",
    "start": 156.374,
    "end": 163.506,
    "duration": 7.132
  },
  {
    "id": 26,
    "text": "辛弃疾则精于“用经用史”之法，",
    "start": 164.184,
    "end": 166.636,
    "duration": 2.452
  },
  {
    "id": 27,
    "text": "刘辰翁赞其“牵雅颂入郑卫”，将经史典故化为政治讽喻的利器。",
    "start": 167.015,
    "end": 172.187,
    "duration": 5.172
  },
  {
    "id": 28,
    "text": "在《永遇乐·京口北固亭怀古》中，全词百余字内密集连用孙权、刘裕、刘义隆、佛狸祠与廉颇五典，",
    "start": 172.865,
    "end": 181.157,
    "duration": 8.292
  },
  {
    "id": 29,
    "text": "借古讽今，切中南宋草率北伐的时弊，表现出强烈的现实批判力度。",
    "start": 181.536,
    "end": 186.948,
    "duration": 5.412
  },
  {
    "id": 30,
    "text": "第四，共筑宋代豪放词派基石，树立与五七言古诗并峙的词史地位。",
    "start": 187.586,
    "end": 193.478,
    "duration": 5.892
  },
  {
    "id": 31,
    "text": "苏轼与辛弃疾均在豪放主调之外兼备多样的词风造诣。",
    "start": 194.116,
    "end": 198.488,
    "duration": 4.372
  },
  {
    "id": 32,
    "text": "苏词兼有《江城子》“十年生死两茫茫”的深沉悼亡与清幽婉转；",
    "start": 199.126,
    "end": 202.418,
    "duration": 3.292
  },
  {
    "id": 33,
    "text": "辛词亦兼有《清平乐·村居》的田园天真与谐谑自嘲。",
    "start": 202.947,
    "end": 204.239,
    "duration": 1.292
  },
  {
    "id": 34,
    "text": "苏轼为词坛指明了向上一路，辛弃疾则率领南宋辛派词人将爱国悲歌推向高峰。",
    "start": 204.917,
    "end": 208.929,
    "duration": 4.012
  },
  {
    "id": 35,
    "text": "苏辛并称，共同奠定了豪放一派在宋词史上的崇高地位。",
    "start": 209.647,
    "end": 220.699,
    "duration": 11.052
  },
  {
    "id": 36,
    "text": "综观苏辛之变，苏轼的“以诗为词”重在突破“词为艳科”藩篱、注入清旷自适的文人胸襟，",
    "start": 221.228,
    "end": 228.0,
    "duration": 6.772
  },
  {
    "id": 37,
    "text": "辛弃疾的“以文为词”则进一步融化经史典故与散文句法，抒写恢复中原的英雄悲慨。",
    "start": 228.379,
    "end": 235.431,
    "duration": 7.052
  },
  {
    "id": 38,
    "text": "二人一承一继、同而不同，彻底拓宽了词体的题材格局与表现力，",
    "start": 235.96,
    "end": 240.972,
    "duration": 5.012
  },
  {
    "id": 39,
    "text": "将宋代豪放词派推向与五、七言诗歌并峙的高度。",
    "start": 241.36,
    "end": 245.492,
    "duration": 4.132
  }
]