[
  {
    "id": 1,
    "text": "《诗经》是中国古代文学史上第一部诗歌总集。",
    "start": 0.0,
    "end": 3.701,
    "duration": 3.701
  },
  {
    "id": 2,
    "text": "它标志着中国诗歌从原始歌谣走向成熟自觉的抒情形态。",
    "start": 3.701,
    "end": 8.635,
    "duration": 4.934
  },
  {
    "id": 3,
    "text": "袁行配《中国文学史》指出，《诗经》开创了中国古代诗歌灿烂的现实主义传统。",
    "start": 8.635,
    "end": 14.803,
    "duration": 6.168
  },
  {
    "id": 4,
    "text": "它全面奠定了古典诗歌以抒情为主导的美学风范。",
    "start": 14.803,
    "end": 19.12,
    "duration": 4.317
  },
  {
    "id": 5,
    "text": "其杰出的艺术成就与表现手法，主要体现在以下四个核心维度：《诗经》打破了神话巫术的虚幻迷雾，",
    "start": 19.28,
    "end": 27.2,
    "duration": 7.92
  },
  {
    "id": 6,
    "text": "展现出极强的写实主义精神。",
    "start": 27.2,
    "end": 29.76,
    "duration": 2.56
  },
  {
    "id": 7,
    "text": "汉代何休在《春秋公羊传解诂》中提出著名的“饥者歌其食，",
    "start": 29.76,
    "end": 35.04,
    "duration": 5.28
  },
  {
    "id": 8,
    "text": "劳者歌其事”。",
    "start": 35.04,
    "end": 36.4,
    "duration": 1.36
  },
  {
    "id": 9,
    "text": "诗作直面周代广阔的社会生活，真实记录了劳动、",
    "start": 36.4,
    "end": 40.56,
    "duration": 4.16
  },
  {
    "id": 10,
    "text": "婚恋、徭役与阶级压迫。",
    "start": 40.56,
    "end": 42.56,
    "duration": 2.0
  },
  {
    "id": 11,
    "text": "在表现剥削与压迫时，《伐檀》愤怒追问不劳而获的统治者：“不稼不瑟，",
    "start": 42.88,
    "end": 49.68,
    "duration": 6.8
  },
  {
    "id": 12,
    "text": "胡取禾三百缠兮”。",
    "start": 49.68,
    "end": 52.0,
    "duration": 2.32
  },
  {
    "id": 13,
    "text": "在表现男女情爱时，《周南•关雎》写出“窈窕淑女，",
    "start": 52.0,
    "end": 56.4,
    "duration": 4.4
  },
  {
    "id": 14,
    "text": "君子好逑”的天然质朴。",
    "start": 56.4,
    "end": 58.8,
    "duration": 2.4
  },
  {
    "id": 15,
    "text": "全诗情感真挚坦诚，既无虚饰矫情，",
    "start": 58.8,
    "end": 62.32,
    "duration": 3.52
  },
  {
    "id": 16,
    "text": "更无空洞说教。",
    "start": 62.32,
    "end": 63.6,
    "duration": 1.28
  },
  {
    "id": 17,
    "text": "这种直面现实民生与生命真情的创作取向，",
    "start": 63.84,
    "end": 67.28,
    "duration": 3.44
  },
  {
    "id": 18,
    "text": "铸就了《诗经》深沉厚重的思想底色。",
    "start": 67.28,
    "end": 70.24,
    "duration": 2.96
  },
  {
    "id": 19,
    "text": "“赋、比、兴”是《诗经》最具标志性的艺术表现体系。",
    "start": 70.24,
    "end": 74.08,
    "duration": 3.84
  },
  {
    "id": 20,
    "text": "宋代朱熹在《诗集传》中对此作出了经典权威的界定。",
    "start": 74.08,
    "end": 78.16,
    "duration": 4.08
  },
  {
    "id": 21,
    "text": "所谓“赋者，敷陈其事而直言之者也”，",
    "start": 78.16,
    "end": 81.28,
    "duration": 3.12
  },
  {
    "id": 22,
    "text": "即直接铺陈叙述客观物象与内心动态。",
    "start": 81.28,
    "end": 84.16,
    "duration": 2.88
  },
  {
    "id": 23,
    "text": "所谓“比者，以彼物比此物也”，即运用生动比喻寄托主观意旨。",
    "start": 84.56,
    "end": 89.92,
    "duration": 5.36
  },
  {
    "id": 24,
    "text": "所谓“兴者，先言他物以引起所咏之词也”，",
    "start": 89.92,
    "end": 93.28,
    "duration": 3.36
  },
  {
    "id": 25,
    "text": "即借眼前自然事物引发内心情感。",
    "start": 93.28,
    "end": 96.0,
    "duration": 2.72
  },
  {
    "id": 26,
    "text": "在实际创作中，三者绝非孤立割裂，",
    "start": 96.0,
    "end": 98.72,
    "duration": 2.72
  },
  {
    "id": 27,
    "text": "而是高度交融互化。",
    "start": 98.72,
    "end": 100.32,
    "duration": 1.6
  },
  {
    "id": 28,
    "text": "在名篇《卫风•氓》中，诗人借桑树由“其叶沃若”到“其叶黄落”的自然变迁。",
    "start": 100.32,
    "end": 105.92,
    "duration": 5.6
  },
  {
    "id": 29,
    "text": "将生动的比喻、起兴的灵动与直接的叙事融为一体，",
    "start": 106.24,
    "end": 110.8,
    "duration": 4.56
  },
  {
    "id": 30,
    "text": "形象喻示了女主人公容颜衰老与爱情破灭。",
    "start": 110.8,
    "end": 114.88,
    "duration": 4.08
  },
  {
    "id": 31,
    "text": "赋比兴的广泛运用，极大地提升了古典诗歌情景交融的意象营构能力。",
    "start": 114.88,
    "end": 121.04,
    "duration": 6.16
  },
  {
    "id": 32,
    "text": "《诗经》在文体形式与音乐体制上，",
    "start": 121.04,
    "end": 123.92,
    "duration": 2.88
  },
  {
    "id": 33,
    "text": "确立了早期诗歌整赤灵动的规范。",
    "start": 123.92,
    "end": 126.72,
    "duration": 2.8
  },
  {
    "id": 34,
    "text": "全书在体制上以四言句式为主干，同时根据抒情需要穿插杂言。",
    "start": 127.04,
    "end": 132.96,
    "duration": 5.92
  },
  {
    "id": 35,
    "text": "其篇章结构广泛采用独具匠心的“重章叠句”形式。",
    "start": 132.96,
    "end": 137.12,
    "duration": 4.16
  },
  {
    "id": 36,
    "text": "各章之间字句略有更替，在回环往复的咏唱中使情感层层深化。",
    "start": 137.12,
    "end": 142.56,
    "duration": 5.44
  },
  {
    "id": 37,
    "text": "正如《周南•福以》通篇采用重章，",
    "start": 142.856,
    "end": 145.496,
    "duration": 2.64
  },
  {
    "id": 38,
    "text": "通过采、掇、捋等动词的递进，生动再现了妇女采桑劳动的欢快节律。",
    "start": 145.496,
    "end": 151.736,
    "duration": 6.24
  },
  {
    "id": 39,
    "text": "在语言运用上，《诗经》大量使用双声叠韵与叠字摹状词。",
    "start": 151.736,
    "end": 156.696,
    "duration": 4.96
  },
  {
    "id": 40,
    "text": "如《小雅•采薇》中的名句：“昔我往矣，",
    "start": 156.696,
    "end": 159.976,
    "duration": 3.28
  },
  {
    "id": 41,
    "text": "杨柳依依。",
    "start": 159.976,
    "end": 160.776,
    "duration": 0.8
  },
  {
    "id": 42,
    "text": "今我来思，雨雪霏霏”。",
    "start": 161.016,
    "end": 163.656,
    "duration": 2.64
  },
  {
    "id": 43,
    "text": "“依依”摹杨柳轻盈之态，“霏霏”写雪落浓密之景。",
    "start": 163.656,
    "end": 168.456,
    "duration": 4.8
  },
  {
    "id": 44,
    "text": "这些声色兼备的语言，使全书具备了极强的音乐旋律美与感官表现力。",
    "start": 168.456,
    "end": 174.776,
    "duration": 6.32
  },
  {
    "id": 45,
    "text": "《诗经》在美学品格上体现了先秦礼乐文明所推崇的“中和之美”。",
    "start": 174.776,
    "end": 179.656,
    "duration": 4.88
  },
  {
    "id": 46,
    "text": "孔子在《论语》中以“诗三百，一言以蔽之，",
    "start": 179.896,
    "end": 183.816,
    "duration": 3.92
  },
  {
    "id": 47,
    "text": "曰思无邪”概括其精神特质。",
    "start": 183.816,
    "end": 186.456,
    "duration": 2.64
  },
  {
    "id": 48,
    "text": "全诗情感表达热烈而真挚，但始终保持在理性的节制与秩序之中。",
    "start": 186.456,
    "end": 192.216,
    "duration": 5.76
  },
  {
    "id": 49,
    "text": "汉代《毛诗序》进而将其阐发为“发乎情，",
    "start": 192.216,
    "end": 195.816,
    "duration": 3.6
  },
  {
    "id": 50,
    "text": "民之性也；",
    "start": 195.816,
    "end": 196.856,
    "duration": 1.04
  },
  {
    "id": 51,
    "text": "止乎礼义，国之情也”。",
    "start": 196.856,
    "end": 198.696,
    "duration": 1.84
  },
  {
    "id": 52,
    "text": "即便是讽刺统治者暴政与控诉苦难的诗篇，",
    "start": 198.936,
    "end": 202.856,
    "duration": 3.92
  },
  {
    "id": 53,
    "text": "也多展现为怨而不怒的抒情克制。",
    "start": 202.856,
    "end": 206.616,
    "duration": 3.76
  },
  {
    "id": 54,
    "text": "这种哀而不伤、怨而不怒的中和审美范式，",
    "start": 206.616,
    "end": 210.456,
    "duration": 3.84
  },
  {
    "id": 55,
    "text": "奠定了中华民族含蓄典雅的诗学品格。",
    "start": 210.456,
    "end": 213.896,
    "duration": 3.44
  },
  {
    "id": 56,
    "text": "综上所述，《诗经》是中国古典诗歌现实主义传统的源头活水。",
    "start": 213.896,
    "end": 219.096,
    "duration": 5.2
  },
  {
    "id": 57,
    "text": "它在赋比兴技法、四言诗体与抒情传统上的开拓，",
    "start": 219.336,
    "end": 223.736,
    "duration": 4.4
  },
  {
    "id": 58,
    "text": "对后世文学产生了不可估量的深远影响。",
    "start": 223.736,
    "end": 227.016,
    "duration": 3.28
  },
  {
    "id": 59,
    "text": "它不仅直接启迪了汉乐府民歌与建安风骨，",
    "start": 227.016,
    "end": 230.776,
    "duration": 3.76
  },
  {
    "id": 60,
    "text": "更是杜甫现实主义诗史与白居易新乐府运动的精神源头。--",
    "start": 230.776,
    "end": 235.096,
    "duration": 4.32
  }
]