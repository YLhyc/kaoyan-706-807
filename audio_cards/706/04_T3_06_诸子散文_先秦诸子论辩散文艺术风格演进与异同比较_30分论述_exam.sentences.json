[
  {
    "id": "sent_1",
    "text": "春秋战国时期是中国古代社会经历剧烈大变革、大分化的剧动时代。",
    "start": 0.0,
    "end": 5.48,
    "duration": 5.48
  },
  {
    "id": "sent_2",
    "text": "随着周天子失驭、宗法礼乐制度崩坏、",
    "start": 5.529,
    "end": 8.529,
    "duration": 3.0
  },
  {
    "id": "sent_3",
    "text": "私学兴起与士阶层的迅速崛起，",
    "start": 8.979,
    "end": 11.619,
    "duration": 2.64
  },
  {
    "id": "sent_4",
    "text": "形成了思想空前活跃的 “百家争鸣” 格局。",
    "start": 12.069,
    "end": 15.309,
    "duration": 3.24
  },
  {
    "id": "sent_5",
    "text": "先秦诸子论辩散文伴随时代思想探索的深入，",
    "start": 15.759,
    "end": 19.359,
    "duration": 3.6
  },
  {
    "id": "sent_6",
    "text": "实现了中国古代论说文体的历史定型。",
    "start": 19.809,
    "end": 23.049,
    "duration": 3.24
  },
  {
    "id": "sent_7",
    "text": "其文体演进历程与各派风格之异同比较，",
    "start": 23.499,
    "end": 26.819,
    "duration": 3.32
  },
  {
    "id": "sent_8",
    "text": "主要展现为以下四个核心维度：",
    "start": 27.269,
    "end": 29.789,
    "duration": 2.52
  },
  {
    "id": "sent_9",
    "text": "第一，",
    "start": 30.239,
    "end": 35.919,
    "duration": 5.68
  },
  {
    "id": "sent_10",
    "text": "历经从语录体到对话式论辩再到成熟专题论文的文体演进序列。",
    "start": 36.369,
    "end": 40.249,
    "duration": 3.88
  },
  {
    "id": "sent_11",
    "text": "先秦诸子散文的形式发展呈现出严整的历史逻辑。",
    "start": 40.819,
    "end": 45.019,
    "duration": 4.2
  },
  {
    "id": "sent_12",
    "text": "春秋末期产生的 《论语》 以 “语录体” 为主，短小简括、",
    "start": 45.469,
    "end": 48.549,
    "duration": 3.08
  },
  {
    "id": "sent_13",
    "text": "言简意赅，多为孔子及其弟子的言行实录；",
    "start": 49.119,
    "end": 52.959,
    "duration": 3.84
  },
  {
    "id": "sent_14",
    "text": "战国中期的 《孟子》 与 《庄子》 发展为 “对话式论辩体”，",
    "start": 53.409,
    "end": 58.889,
    "duration": 5.48
  },
  {
    "id": "sent_15",
    "text": "篇幅大为拓展，善于在问难驳斥中展开丰富的情节与生动的比喻；",
    "start": 59.339,
    "end": 61.819,
    "duration": 2.48
  },
  {
    "id": "sent_16",
    "text": "至战国末期的 《荀子》 与 《韩非子》，",
    "start": 62.269,
    "end": 65.429,
    "duration": 3.16
  },
  {
    "id": "sent_17",
    "text": "则彻底摆脱了随手记录言行的零散形式，",
    "start": 65.879,
    "end": 68.919,
    "duration": 3.04
  },
  {
    "id": "sent_18",
    "text": "确立了由作者独立撰写的 “专题论文体”。",
    "start": 69.369,
    "end": 73.769,
    "duration": 4.4
  },
  {
    "id": "sent_19",
    "text": "全书标题即论题，结构严整、论证周密、逻辑谨严，",
    "start": 74.219,
    "end": 77.699,
    "duration": 3.48
  },
  {
    "id": "sent_20",
    "text": "标志着先秦论辩散文文体完全走向成熟。",
    "start": 78.149,
    "end": 81.949,
    "duration": 3.8
  },
  {
    "id": "sent_21",
    "text": "第二，儒家散文由从容温雅走向气势磅礴，",
    "start": 82.479,
    "end": 85.039,
    "duration": 2.56
  },
  {
    "id": "sent_22",
    "text": "贯穿深沉的政治理想与道义担当。",
    "start": 85.569,
    "end": 88.929,
    "duration": 3.36
  },
  {
    "id": "sent_23",
    "text": "儒家散文以救世为旨归，追求明礼行仁。",
    "start": 89.379,
    "end": 91.979,
    "duration": 2.6
  },
  {
    "id": "sent_24",
    "text": "《论语》 风格雍容雅致、循循善诱，",
    "start": 92.429,
    "end": 96.469,
    "duration": 4.04
  },
  {
    "id": "sent_25",
    "text": "在平实对话中彰显智者风范与深沉的仁德修养；",
    "start": 96.999,
    "end": 101.119,
    "duration": 4.12
  },
  {
    "id": "sent_26",
    "text": "至战国中期，面对礼崩乐坏加剧与杨墨学术竞争，",
    "start": 101.649,
    "end": 106.529,
    "duration": 4.88
  },
  {
    "id": "sent_27",
    "text": "孟子承担起卫道大任，其文风大变，展现出 “雄辩” 特征。",
    "start": 106.979,
    "end": 110.099,
    "duration": 3.12
  },
  {
    "id": "sent_28",
    "text": "孟子自称 “予岂好辩哉，予不得已也”。",
    "start": 110.549,
    "end": 114.509,
    "duration": 3.96
  },
  {
    "id": "sent_29",
    "text": "他长于修辞，大量运用排比、对偶形成凌厉攻势，",
    "start": 114.959,
    "end": 119.679,
    "duration": 4.72
  },
  {
    "id": "sent_30",
    "text": "善设机巧与类比设阱，如以 “五十步笑百步” 启发梁惠王，",
    "start": 120.209,
    "end": 124.889,
    "duration": 4.68
  },
  {
    "id": "sent_31",
    "text": "以 “揠苗助长” 阐说心性修养，文章辞气磅礴、锋芒毕露，",
    "start": 125.339,
    "end": 127.739,
    "duration": 2.4
  },
  {
    "id": "sent_32",
    "text": "洋溢着刚健从容的大丈夫气概。",
    "start": 128.189,
    "end": 131.069,
    "duration": 2.88
  },
  {
    "id": "sent_33",
    "text": "第三，道家散文打破逻辑名辩桎梏，",
    "start": 131.519,
    "end": 135.359,
    "duration": 3.84
  },
  {
    "id": "sent_34",
    "text": "以奇幻寓言与汪洋恣肆展现超旷美学境界。",
    "start": 135.809,
    "end": 140.129,
    "duration": 4.32
  },
  {
    "id": "sent_35",
    "text": "道家散文以追求个体心灵绝对自由与天地之道为归宿。",
    "start": 140.579,
    "end": 144.619,
    "duration": 4.04
  },
  {
    "id": "sent_36",
    "text": "《老子》 文约义丰、韵散结合，多用正言若反的辩证格言；",
    "start": 145.069,
    "end": 149.309,
    "duration": 4.24
  },
  {
    "id": "sent_37",
    "text": "战国中期的 《庄子》 则将道家论辩推向浪漫主义极致。",
    "start": 149.759,
    "end": 154.359,
    "duration": 4.6
  },
  {
    "id": "sent_38",
    "text": "庄子摒弃了儒墨两家逻辑辩驳的常规路径，以 “寓言”、",
    "start": 154.889,
    "end": 157.809,
    "duration": 2.92
  },
  {
    "id": "sent_39",
    "text": "“重言”、“卮言” 构筑独特的表达体系。",
    "start": 158.259,
    "end": 161.379,
    "duration": 3.12
  },
  {
    "id": "sent_40",
    "text": "在 《逍遥游》 中，他虚构了翼若垂天之云、",
    "start": 161.829,
    "end": 165.709,
    "duration": 3.88
  },
  {
    "id": "sent_41",
    "text": "抟扶摇而上九万里的北冥大鹏，以及野马尘埃、",
    "start": 166.239,
    "end": 167.959,
    "duration": 1.72
  },
  {
    "id": "sent_42",
    "text": "蜩与学鸠的鲜明对照，",
    "start": 168.409,
    "end": 172.369,
    "duration": 3.96
  },
  {
    "id": "sent_43",
    "text": "在天马行空的瑰丽想象与荒诞奇诡的物象变幻中，",
    "start": 172.819,
    "end": 174.579,
    "duration": 1.76
  },
  {
    "id": "sent_44",
    "text": "消解世俗是非名利。",
    "start": 175.029,
    "end": 180.149,
    "duration": 5.12
  },
  {
    "id": "sent_45",
    "text": "其文辞汪洋恣肆、仪态万方，达到了哲理与诗意高度浑融的化境。",
    "start": 180.599,
    "end": 184.279,
    "duration": 3.68
  },
  {
    "id": "sent_46",
    "text": "第四，法家与晚期诸子倡导冷峻严密剖析，",
    "start": 184.728,
    "end": 187.568,
    "duration": 2.84
  },
  {
    "id": "sent_47",
    "text": "确立说理文结构谨严的论证法度。",
    "start": 188.018,
    "end": 191.978,
    "duration": 3.96
  },
  {
    "id": "sent_48",
    "text": "战国末期兼并战争白热化，讲求富国强兵、",
    "start": 192.428,
    "end": 195.028,
    "duration": 2.6
  },
  {
    "id": "sent_49",
    "text": "以法统政的法家散文应运而生。",
    "start": 195.478,
    "end": 200.158,
    "duration": 4.68
  },
  {
    "id": "sent_50",
    "text": "韩非集法家思想之大成，其散文冷峻深邃、锋利如刀。",
    "start": 200.608,
    "end": 204.248,
    "duration": 3.64
  },
  {
    "id": "sent_51",
    "text": "韩非立足于人性自私的功利立场，在 《孤愤》、",
    "start": 204.698,
    "end": 209.258,
    "duration": 4.56
  },
  {
    "id": "sent_52",
    "text": "《说难》 等篇中，洞察君臣权谋世情，解剖鞭辟入里。",
    "start": 209.708,
    "end": 214.828,
    "duration": 5.12
  },
  {
    "id": "sent_53",
    "text": "韩非善于运用历史事实与民间寓言相互发明，如 “买椟还珠”、",
    "start": 215.278,
    "end": 217.278,
    "duration": 2.0
  },
  {
    "id": "sent_54",
    "text": "“自相矛盾”、“守株待兔”，",
    "start": 217.728,
    "end": 222.408,
    "duration": 4.68
  },
  {
    "id": "sent_55",
    "text": "使抽象的法治权术说理变得生动而具无可辩驳的逻辑说服力；",
    "start": 222.938,
    "end": 226.778,
    "duration": 3.84
  },
  {
    "id": "sent_56",
    "text": "结合荀子散文由博反约、反复推求的长篇论说，",
    "start": 227.308,
    "end": 231.348,
    "duration": 4.04
  }
]