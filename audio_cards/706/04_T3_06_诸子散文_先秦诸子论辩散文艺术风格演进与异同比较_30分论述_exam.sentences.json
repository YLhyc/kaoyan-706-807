[
  {
    "id": "sent_1",
    "text": "春秋战国时期是中国古代社会经历剧烈大变革、大分化的剧动时代。",
    "start": 0.1,
    "end": 6.678,
    "duration": 6.578
  },
  {
    "id": "sent_2",
    "text": "随着周天子失驭、宗法礼乐制度崩坏、私学兴起与士阶层的迅速崛起，",
    "start": 6.628,
    "end": 13.256,
    "duration": 6.628
  },
  {
    "id": "sent_3",
    "text": "形成了思想空前活跃的 “百家争鸣” 格局。",
    "start": 13.255,
    "end": 16.966,
    "duration": 3.711
  },
  {
    "id": "sent_4",
    "text": "先秦诸子论辩散文伴随时代思想探索的深入，",
    "start": 16.966,
    "end": 21.484,
    "duration": 4.518
  },
  {
    "id": "sent_5",
    "text": "实现了中国古代论说文体的历史定型。",
    "start": 21.484,
    "end": 25.299,
    "duration": 3.815
  },
  {
    "id": "sent_6",
    "text": "其文体演进历程与各派风格之异同比较，主要展现为以下四个核心维度：",
    "start": 25.299,
    "end": 32.226,
    "duration": 6.927
  },
  {
    "id": "sent_7",
    "text": "第一，历经从语录体到对话式论辩再到成熟专题论文的文体演进序列。",
    "start": 32.227,
    "end": 38.959,
    "duration": 6.732
  },
  {
    "id": "sent_8",
    "text": "先秦诸子散文的形式发展呈现出严整的历史逻辑。",
    "start": 38.958,
    "end": 43.854,
    "duration": 4.896
  },
  {
    "id": "sent_9",
    "text": "春秋末期产生的 《论语》 以 “语录体” 为主，",
    "start": 43.854,
    "end": 47.578,
    "duration": 3.724
  },
  {
    "id": "sent_10",
    "text": "短小简括、言简意赅，多为孔子及其弟子的言行实录；",
    "start": 47.578,
    "end": 52.747,
    "duration": 5.169
  },
  {
    "id": "sent_11",
    "text": "战国中期的 《孟子》 与 《庄子》 发展为 “对话式论辩体”，",
    "start": 52.747,
    "end": 57.356,
    "duration": 4.609
  },
  {
    "id": "sent_12",
    "text": "篇幅大为拓展，善于在问难驳斥中展开丰富的情节与生动的比喻；",
    "start": 57.357,
    "end": 63.685,
    "duration": 6.328
  },
  {
    "id": "sent_13",
    "text": "至战国末期的 《荀子》 与 《韩非子》，",
    "start": 63.685,
    "end": 66.81,
    "duration": 3.125
  },
  {
    "id": "sent_14",
    "text": "则彻底摆脱了随手记录言行的零散形式，",
    "start": 66.81,
    "end": 70.885,
    "duration": 4.075
  },
  {
    "id": "sent_15",
    "text": "确立了由作者独立撰写的 “专题论文体”。",
    "start": 70.885,
    "end": 74.505,
    "duration": 3.62
  },
  {
    "id": "sent_16",
    "text": "全书标题即论题，结构严整、论证周密、逻辑谨严，",
    "start": 74.505,
    "end": 79.583,
    "duration": 5.078
  },
  {
    "id": "sent_17",
    "text": "标志着先秦论辩散文文体完全走向成熟。",
    "start": 79.583,
    "end": 83.906,
    "duration": 4.323
  },
  {
    "id": "sent_18",
    "text": "第二，儒家散文由从容温雅走向气势磅礴，",
    "start": 83.906,
    "end": 88.229,
    "duration": 4.323
  },
  {
    "id": "sent_19",
    "text": "贯穿深沉的政治理想与道义担当。",
    "start": 88.229,
    "end": 91.849,
    "duration": 3.62
  },
  {
    "id": "sent_20",
    "text": "儒家散文以救世为旨归，追求明礼行仁。",
    "start": 91.849,
    "end": 96.132,
    "duration": 4.283
  },
  {
    "id": "sent_21",
    "text": "《论语》 风格雍容雅致、循循善诱，",
    "start": 96.132,
    "end": 99.362,
    "duration": 3.23
  },
  {
    "id": "sent_22",
    "text": "在平实对话中彰显智者风范与深沉的仁德修养；",
    "start": 99.362,
    "end": 104.193,
    "duration": 4.831
  },
  {
    "id": "sent_23",
    "text": "至战国中期，面对礼崩乐坏加剧与杨墨学术竞争，孟子承担起卫道大任，",
    "start": 104.193,
    "end": 111.159,
    "duration": 6.966
  },
  {
    "id": "sent_24",
    "text": "其文风大变，展现出 “雄辩” 特征。",
    "start": 111.159,
    "end": 114.44,
    "duration": 3.281
  },
  {
    "id": "sent_25",
    "text": "孟子自称 “予岂好辩哉，予不得已也”。",
    "start": 114.44,
    "end": 118.177,
    "duration": 3.737
  },
  {
    "id": "sent_26",
    "text": "他长于修辞，大量运用排比、对偶形成凌厉攻势，善设机巧与类比设阱，",
    "start": 118.177,
    "end": 125.443,
    "duration": 7.266
  },
  {
    "id": "sent_27",
    "text": "如以 “五十步笑百步” 启发梁惠王，",
    "start": 125.443,
    "end": 128.633,
    "duration": 3.19
  },
  {
    "id": "sent_28",
    "text": "以 “揠苗助长” 阐说心性修养，文章辞气磅礴、锋芒毕露，",
    "start": 128.633,
    "end": 134.401,
    "duration": 5.768
  },
  {
    "id": "sent_29",
    "text": "洋溢着刚健从容的大丈夫气概。",
    "start": 134.401,
    "end": 137.617,
    "duration": 3.216
  },
  {
    "id": "sent_30",
    "text": "第三，道家散文打破逻辑名辩桎梏，",
    "start": 137.617,
    "end": 141.419,
    "duration": 3.802
  },
  {
    "id": "sent_31",
    "text": "以奇幻寓言与汪洋恣肆展现超旷美学境界。",
    "start": 141.419,
    "end": 145.794,
    "duration": 4.375
  },
  {
    "id": "sent_32",
    "text": "道家散文以追求个体心灵绝对自由与天地之道为归宿。",
    "start": 145.794,
    "end": 151.366,
    "duration": 5.572
  },
  {
    "id": "sent_33",
    "text": "《老子》 文约义丰、韵散结合，多用正言若反的辩证格言；",
    "start": 151.367,
    "end": 157.032,
    "duration": 5.665
  },
  {
    "id": "sent_34",
    "text": "战国中期的 《庄子》 则将道家论辩推向浪漫主义极致。",
    "start": 157.031,
    "end": 161.914,
    "duration": 4.883
  },
  {
    "id": "sent_35",
    "text": "庄子摒弃了儒墨两家逻辑辩驳的常规路径，",
    "start": 161.914,
    "end": 166.185,
    "duration": 4.271
  },
  {
    "id": "sent_36",
    "text": "以 “寓言”、“重言”、“卮言” 构筑独特的表达体系。",
    "start": 166.185,
    "end": 170.729,
    "duration": 4.544
  },
  {
    "id": "sent_37",
    "text": "在 《逍遥游》 中，",
    "start": 170.729,
    "end": 172.422,
    "duration": 1.693
  },
  {
    "id": "sent_38",
    "text": "他虚构了翼若垂天之云、抟扶摇而上九万里的北冥大鹏，",
    "start": 172.422,
    "end": 177.969,
    "duration": 5.547
  },
  {
    "id": "sent_39",
    "text": "以及野马尘埃、蜩与学鸠的鲜明对照，",
    "start": 177.969,
    "end": 181.693,
    "duration": 3.724
  },
  {
    "id": "sent_40",
    "text": "在天马行空的瑰丽想象与荒诞奇诡的物象变幻中，消解世俗是非名利。",
    "start": 181.693,
    "end": 188.425,
    "duration": 6.732
  },
  {
    "id": "sent_41",
    "text": "其文辞汪洋恣肆、仪态万方，达到了哲理与诗意高度浑融的化境。",
    "start": 188.424,
    "end": 194.348,
    "duration": 5.924
  },
  {
    "id": "sent_42",
    "text": "第四，法家与晚期诸子倡导冷峻严密剖析，",
    "start": 194.349,
    "end": 199.089,
    "duration": 4.74
  },
  {
    "id": "sent_43",
    "text": "确立说理文结构谨严的论证法度。",
    "start": 199.089,
    "end": 202.318,
    "duration": 3.229
  },
  {
    "id": "sent_44",
    "text": "战国末期兼并战争白热化，",
    "start": 202.318,
    "end": 205.339,
    "duration": 3.021
  },
  {
    "id": "sent_45",
    "text": "讲求富国强兵、以法统政的法家散文应运而生。",
    "start": 205.339,
    "end": 210.118,
    "duration": 4.779
  },
  {
    "id": "sent_46",
    "text": "韩非集法家思想之大成，其散文冷峻深邃、锋利如刀。",
    "start": 210.117,
    "end": 215.547,
    "duration": 5.43
  },
  {
    "id": "sent_47",
    "text": "韩非立足于人性自私的功利立场，在 《孤愤》、《说难》 等篇中，",
    "start": 215.547,
    "end": 221.068,
    "duration": 5.521
  },
  {
    "id": "sent_48",
    "text": "洞察君臣权谋世情，解剖鞭辟入里。",
    "start": 221.068,
    "end": 224.883,
    "duration": 3.815
  },
  {
    "id": "sent_49",
    "text": "韩非善于运用历史事实与民间寓言相互发明，",
    "start": 224.882,
    "end": 229.271,
    "duration": 4.389
  },
  {
    "id": "sent_50",
    "text": "如 “买椟还珠”、“自相矛盾”、“守株待兔”，",
    "start": 229.271,
    "end": 233.164,
    "duration": 3.893
  },
  {
    "id": "sent_51",
    "text": "使抽象的法治权术说理变得生动而具无可辩驳的逻辑说服力；",
    "start": 233.164,
    "end": 238.971,
    "duration": 5.807
  },
  {
    "id": "sent_52",
    "text": "结合荀子散文由博反约、反复推求的长篇论说，",
    "start": 238.971,
    "end": 243.776,
    "duration": 4.805
  },
  {
    "id": "sent_53",
    "text": "共同奠定了后世古代说理散文严谨谨饬的法度典范。",
    "start": 243.776,
    "end": 248.932,
    "duration": 5.156
  }
]