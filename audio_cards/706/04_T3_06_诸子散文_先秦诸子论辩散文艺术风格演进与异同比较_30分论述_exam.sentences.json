[
  {
    "id": 1,
    "text": "试论先秦诸子论辩散文的艺术风格演进历程与主要流派异同比较。",
    "start": 0.05,
    "end": 6.946,
    "duration": 6.896
  },
  {
    "id": 2,
    "text": "春秋战国时期是中国古代社会经历剧烈大变革、大分化的剧动时代。",
    "start": 6.946,
    "end": 13.106,
    "duration": 6.16
  },
  {
    "id": 3,
    "text": "随着周天子失驭、宗法礼乐制度崩坏、",
    "start": 13.106,
    "end": 16.459,
    "duration": 3.353
  },
  {
    "id": 4,
    "text": "私学兴起与士阶层的迅速崛起，",
    "start": 16.459,
    "end": 19.26,
    "duration": 2.801
  },
  {
    "id": 5,
    "text": "形成了思想空前活跃的 “百家争鸣” 格局。",
    "start": 19.26,
    "end": 22.507,
    "duration": 3.247
  },
  {
    "id": 6,
    "text": "先秦诸子论辩散文伴随时代思想探索的深入，",
    "start": 22.507,
    "end": 26.396,
    "duration": 3.889
  },
  {
    "id": 7,
    "text": "实现了中国古代论说文体的历史定型。",
    "start": 26.396,
    "end": 29.521,
    "duration": 3.125
  },
  {
    "id": 8,
    "text": "其文体演进历程与各派风格之异同比较，",
    "start": 29.521,
    "end": 33.34,
    "duration": 3.819
  },
  {
    "id": 9,
    "text": "主要展现为以下四个核心维度：第一，",
    "start": 33.34,
    "end": 36.852,
    "duration": 3.512
  },
  {
    "id": 10,
    "text": "历经从语录体到对话式论辩再到成熟专题论文的文体演进序列。",
    "start": 36.852,
    "end": 42.267,
    "duration": 5.415
  },
  {
    "id": 11,
    "text": "先秦诸子散文的形式发展呈现出严整的历史逻辑。",
    "start": 42.267,
    "end": 46.271,
    "duration": 4.004
  },
  {
    "id": 12,
    "text": "春秋末期产生的 《论语》 以 “语录体” 为主，",
    "start": 46.271,
    "end": 51.262,
    "duration": 4.991
  },
  {
    "id": 13,
    "text": "短小简括、言简意赅，多为孔子及其弟子的言行实录；",
    "start": 51.262,
    "end": 55.995,
    "duration": 4.733
  },
  {
    "id": 14,
    "text": "战国中期的 《孟子》 与 《庄子》 发展为 “对话式论辩体”，",
    "start": 55.995,
    "end": 60.718,
    "duration": 4.723
  },
  {
    "id": 15,
    "text": "篇幅大为拓展，",
    "start": 60.718,
    "end": 61.809,
    "duration": 1.091
  },
  {
    "id": 16,
    "text": "善于在问难驳斥中展开丰富的情节与生动的比喻；",
    "start": 61.809,
    "end": 66.167,
    "duration": 4.358
  },
  {
    "id": 17,
    "text": "至战国末期的 《荀子》 与 《韩非子》，",
    "start": 66.167,
    "end": 69.975,
    "duration": 3.808
  },
  {
    "id": 18,
    "text": "则彻底摆脱了随手记录言行的零散形式，",
    "start": 69.975,
    "end": 73.065,
    "duration": 3.09
  },
  {
    "id": 19,
    "text": "确立了由作者独立撰写的 “专题论文体”。",
    "start": 73.065,
    "end": 76.906,
    "duration": 3.841
  },
  {
    "id": 20,
    "text": "全书标题即论题，结构严整、论证周密、逻辑谨严，",
    "start": 76.906,
    "end": 80.361,
    "duration": 3.455
  },
  {
    "id": 21,
    "text": "标志着先秦论辩散文文体完全走向成熟。",
    "start": 80.361,
    "end": 83.78,
    "duration": 3.419
  },
  {
    "id": 22,
    "text": "第二，儒家散文由从容温雅走向气势磅礴，",
    "start": 83.78,
    "end": 87.32,
    "duration": 3.54
  },
  {
    "id": 23,
    "text": "贯穿深沉的政治理想与道义担当。",
    "start": 87.32,
    "end": 90.117,
    "duration": 2.797
  },
  {
    "id": 24,
    "text": "儒家散文以救世为旨归，追求明礼行仁。",
    "start": 90.117,
    "end": 93.232,
    "duration": 3.115
  },
  {
    "id": 25,
    "text": "《论语》 风格雍容雅致、循循善诱，",
    "start": 93.232,
    "end": 95.79,
    "duration": 2.558
  },
  {
    "id": 26,
    "text": "在平实对话中彰显智者风范与深沉的仁德修养；至战国中期，",
    "start": 95.79,
    "end": 102.116,
    "duration": 6.326
  },
  {
    "id": 27,
    "text": "面对礼崩乐坏加剧与杨墨学术竞争，孟子承担起卫道大任，",
    "start": 102.116,
    "end": 107.789,
    "duration": 5.673
  },
  {
    "id": 28,
    "text": "其文风大变，展现出 “雄辩” 特征。",
    "start": 107.789,
    "end": 110.235,
    "duration": 2.446
  },
  {
    "id": 29,
    "text": "孟子自称 “予岂好辩哉，予不得已也”。",
    "start": 110.235,
    "end": 114.431,
    "duration": 4.196
  },
  {
    "id": 30,
    "text": "他长于修辞，大量运用排比、对偶形成凌厉攻势，",
    "start": 114.431,
    "end": 118.465,
    "duration": 4.034
  },
  {
    "id": 31,
    "text": "善设机巧与类比设阱，如以 “五十步笑百步” 启发梁惠王，",
    "start": 118.465,
    "end": 123.964,
    "duration": 5.499
  },
  {
    "id": 32,
    "text": "以 “揠苗助长” 阐说心性修养，文章辞气磅礴、锋芒毕露，",
    "start": 123.964,
    "end": 127.782,
    "duration": 3.818
  },
  {
    "id": 33,
    "text": "洋溢着刚健从容的大丈夫气概。",
    "start": 127.782,
    "end": 131.007,
    "duration": 3.225
  },
  {
    "id": 34,
    "text": "第三，道家散文打破逻辑名辩桎梏，",
    "start": 131.007,
    "end": 133.552,
    "duration": 2.545
  },
  {
    "id": 35,
    "text": "以奇幻寓言与汪洋恣肆展现超旷美学境界。",
    "start": 133.552,
    "end": 137.299,
    "duration": 3.747
  },
  {
    "id": 36,
    "text": "道家散文以追求个体心灵绝对自由与天地之道为归宿。",
    "start": 137.299,
    "end": 142.21,
    "duration": 4.911
  },
  {
    "id": 37,
    "text": "《老子》 文约义丰、韵散结合，多用正言若反的辩证格言；",
    "start": 142.21,
    "end": 146.941,
    "duration": 4.731
  },
  {
    "id": 38,
    "text": "战国中期的 《庄子》 则将道家论辩推向浪漫主义极致。",
    "start": 146.941,
    "end": 151.123,
    "duration": 4.182
  },
  {
    "id": 39,
    "text": "庄子摒弃了儒墨两家逻辑辩驳的常规路径，以 “寓言”、",
    "start": 151.123,
    "end": 155.935,
    "duration": 4.812
  },
  {
    "id": 40,
    "text": "“重言”、“卮言” 构筑独特的表达体系。",
    "start": 155.935,
    "end": 158.982,
    "duration": 3.047
  },
  {
    "id": 41,
    "text": "在 《逍遥游》 中，他虚构了翼若垂天之云、",
    "start": 158.982,
    "end": 162.548,
    "duration": 3.566
  },
  {
    "id": 42,
    "text": "抟扶摇而上九万里的北冥大鹏，以及野马尘埃、",
    "start": 162.548,
    "end": 167.027,
    "duration": 4.479
  },
  {
    "id": 43,
    "text": "蜩与学鸠的鲜明对照，",
    "start": 167.027,
    "end": 169.163,
    "duration": 2.136
  },
  {
    "id": 44,
    "text": "在天马行空的瑰丽想象与荒诞奇诡的物象变幻中，",
    "start": 169.163,
    "end": 173.362,
    "duration": 4.199
  },
  {
    "id": 45,
    "text": "消解世俗是非名利。",
    "start": 173.362,
    "end": 175.177,
    "duration": 1.815
  },
  {
    "id": 46,
    "text": "其文辞汪洋恣肆、仪态万方，达到了哲理与诗意高度浑融的化境。",
    "start": 175.177,
    "end": 180.803,
    "duration": 5.626
  },
  {
    "id": 47,
    "text": "第四，法家与晚期诸子倡导冷峻严密剖析，",
    "start": 180.803,
    "end": 185.569,
    "duration": 4.766
  },
  {
    "id": 48,
    "text": "确立说理文结构谨严的论证法度。",
    "start": 185.569,
    "end": 188.671,
    "duration": 3.102
  },
  {
    "id": 49,
    "text": "战国末期兼并战争白热化，讲求富国强兵、",
    "start": 188.671,
    "end": 192.695,
    "duration": 4.024
  },
  {
    "id": 50,
    "text": "以法统政的法家散文应运而生。",
    "start": 192.695,
    "end": 195.565,
    "duration": 2.87
  },
  {
    "id": 51,
    "text": "韩非集法家思想之大成，其散文冷峻深邃、锋利如刀。",
    "start": 195.565,
    "end": 199.612,
    "duration": 4.047
  },
  {
    "id": 52,
    "text": "韩非立足于人性自私的功利立场，在 《孤愤》、",
    "start": 199.612,
    "end": 203.647,
    "duration": 4.035
  },
  {
    "id": 53,
    "text": "《说难》 等篇中，洞察君臣权谋世情，解剖鞭辟入里。",
    "start": 203.647,
    "end": 207.557,
    "duration": 3.91
  },
  {
    "id": 54,
    "text": "韩非善于运用历史事实与民间寓言相互发明，",
    "start": 207.557,
    "end": 212.744,
    "duration": 5.187
  },
  {
    "id": 55,
    "text": "如 “买椟还珠”、“自相矛盾”、“守株待兔”，",
    "start": 212.744,
    "end": 215.884,
    "duration": 3.14
  },
  {
    "id": 56,
    "text": "使抽象的法治权术说理变得生动而具无可辩驳的逻辑说服力；",
    "start": 215.884,
    "end": 220.849,
    "duration": 4.965
  },
  {
    "id": 57,
    "text": "结合荀子散文由博反约、反复推求的长篇论说，",
    "start": 220.849,
    "end": 224.892,
    "duration": 4.043
  },
  {
    "id": 58,
    "text": "共同奠定了后世古代说理散文严谨谨饬的法度典范。",
    "start": 224.892,
    "end": 229.152,
    "duration": 4.26
  }
]