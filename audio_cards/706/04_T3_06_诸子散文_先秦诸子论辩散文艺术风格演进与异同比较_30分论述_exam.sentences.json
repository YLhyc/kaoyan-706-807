[
  {
    "id": 1,
    "text": "试论先秦诸子论辩散文的艺术风格演进历程与主要流派异同比较。",
    "start": 0.134,
    "end": 5.386,
    "duration": 5.252
  },
  {
    "id": 2,
    "text": "春秋战国时期礼崩乐坏、私学兴起与士阶层崛起，催生了思想空前活跃的“百家争鸣”局面。",
    "start": 6.063,
    "end": 13.355,
    "duration": 7.292
  },
  {
    "id": 3,
    "text": "先秦诸子散文伴随各派学说争鸣不断发展，",
    "start": 14.033,
    "end": 17.445,
    "duration": 3.412
  },
  {
    "id": 4,
    "text": "逐步奠定了中国古代说理散文的文体法度与风格谱系。",
    "start": 17.824,
    "end": 21.916,
    "duration": 4.092
  },
  {
    "id": 5,
    "text": "其演进历程与主要流派之异同，主要体现在以下四个方面：",
    "start": 22.594,
    "end": 32.406,
    "duration": 9.812
  },
  {
    "id": 6,
    "text": "第一，历经从语录体到对话式论辩再到专题论文的文体演进序列。",
    "start": 33.124,
    "end": 37.136,
    "duration": 4.012
  },
  {
    "id": 7,
    "text": "先秦诸子散文的体制演变呈现出清晰的发展脉络。",
    "start": 37.814,
    "end": 43.906,
    "duration": 6.092
  },
  {
    "id": 8,
    "text": "春秋末期的《论语》以“语录体”为主，短小简括，多为孔子与弟子答问的片言记录；",
    "start": 44.544,
    "end": 45.756,
    "duration": 1.212
  },
  {
    "id": 9,
    "text": "战国中期的《墨子》《孟子》向“对话式论辩体”过渡，章节围绕同一论题反复辩难，",
    "start": 46.285,
    "end": 48.617,
    "duration": 2.332
  },
  {
    "id": 10,
    "text": "篇幅扩大而善用譬喻，而《庄子》更以寓言构篇，富于抒情色彩；",
    "start": 48.996,
    "end": 51.288,
    "duration": 2.292
  },
  {
    "id": 11,
    "text": "至战国末期的《荀子》与《韩非子》，则摆脱了对话记录的零散形式，",
    "start": 51.817,
    "end": 53.269,
    "duration": 1.452
  },
  {
    "id": 12,
    "text": "确立了标有篇名、中心明确、结构完整的“专题论文体”，标志着古代说理散文体制的成熟。",
    "start": 53.648,
    "end": 57.02,
    "duration": 3.372
  },
  {
    "id": 13,
    "text": "第二，儒家散文由雍容温雅走向气势磅礴，贯穿救世理想与道义担当。",
    "start": 57.698,
    "end": 69.87,
    "duration": 12.172
  },
  {
    "id": 14,
    "text": "儒家散文以仁政教化为旨归。",
    "start": 70.548,
    "end": 76.28,
    "duration": 5.732
  },
  {
    "id": 15,
    "text": "《论语》文风雍容雅致、言近旨远，于平实对话中显现智者风范与深厚仁心；",
    "start": 77.038,
    "end": 77.93,
    "duration": 0.892
  },
  {
    "id": 16,
    "text": "至战国中期，面对杨朱、墨翟学说盛行，",
    "start": 78.459,
    "end": 79.061,
    "duration": 0.602
  },
  {
    "id": 17,
    "text": "孟子自称“予岂好辩哉，予不得已也”，文风转为犀利雄辩。",
    "start": 79.44,
    "end": 80.082,
    "duration": 0.642
  },
  {
    "id": 18,
    "text": "他善于类比推理、欲擒故纵，大量运用排比、对偶营造汹涌文势，",
    "start": 80.88,
    "end": 82.252,
    "duration": 1.372
  },
  {
    "id": 19,
    "text": "如以“五十步笑百步”启发梁惠王反思仁政，以“揠苗助长”阐说涵养“浩然之气”之道，",
    "start": 82.631,
    "end": 85.123,
    "duration": 2.492
  },
  {
    "id": 20,
    "text": "辞气充沛、锋芒毕露，洋溢着刚健不阿的大丈夫气概。",
    "start": 85.502,
    "end": 87.114,
    "duration": 1.612
  },
  {
    "id": 21,
    "text": "第三，道家散文突破常规名辩，以奇幻寓言与汪洋恣肆展现超旷境界。",
    "start": 87.832,
    "end": 95.884,
    "duration": 8.052
  },
  {
    "id": 22,
    "text": "道家散文着意探求天地自然之道与个体精神自由。",
    "start": 96.562,
    "end": 123.26,
    "duration": 26.698
  },
  {
    "id": 23,
    "text": "《老子》言约义丰、韵散结合，多用正言若反的辩证格言；",
    "start": 123.789,
    "end": 127.441,
    "duration": 3.652
  },
  {
    "id": 24,
    "text": "战国中期的《庄子》则把说理推向了哲理与诗意交融的高峰。",
    "start": 127.97,
    "end": 132.222,
    "duration": 4.252
  },
  {
    "id": 25,
    "text": "庄子摒弃儒墨正面逻辑驳难的套路，借助“寓言”“重言”“卮言”展开论述。",
    "start": 132.751,
    "end": 138.403,
    "duration": 5.652
  },
  {
    "id": 26,
    "text": "在《逍遥游》中，他虚构了搏扶摇而上九万里的北冥大鹏，以及野马尘埃、蜩与学鸠等鲜明意象对照，",
    "start": 139.041,
    "end": 146.413,
    "duration": 7.372
  },
  {
    "id": 27,
    "text": "于瑰丽奇诡的想象变幻中超脱世俗功名是非，文辞汪洋恣肆、仪态万方，自成一格。",
    "start": 146.921,
    "end": 153.973,
    "duration": 7.052
  },
  {
    "id": 28,
    "text": "第四，法家与战国末期诸子倡导冷峻剖析，确立说理文谨严的论证法度。",
    "start": 154.711,
    "end": 160.603,
    "duration": 5.892
  },
  {
    "id": 29,
    "text": "战国末期兼并日烈，讲求法治权术与富国强兵的法家散文应运而生。",
    "start": 161.241,
    "end": 166.893,
    "duration": 5.652
  },
  {
    "id": 30,
    "text": "韩非集法家思想之大成，其文冷峻犀利、剖析入微。",
    "start": 167.691,
    "end": 171.623,
    "duration": 3.932
  },
  {
    "id": 31,
    "text": "他立足功利人性论，在《孤愤》《说难》等篇中洞察君臣利害与政局世情，条分缕析、层层推进；",
    "start": 172.341,
    "end": 179.873,
    "duration": 7.532
  },
  {
    "id": 32,
    "text": "同时善用简洁精悍的历史故事与民间寓言阐发法理，",
    "start": 180.551,
    "end": 184.963,
    "duration": 4.412
  },
  {
    "id": 33,
    "text": "如“买椟还珠”“自相矛盾”“守株待兔”，使抽象说理生动透辟。",
    "start": 185.342,
    "end": 190.514,
    "duration": 5.172
  },
  {
    "id": 34,
    "text": "它与荀子博学详密的论说文一道，共同奠定了后世说理散文结构严谨、逻辑周密的论证典范。",
    "start": 191.192,
    "end": 198.244,
    "duration": 7.052
  },
  {
    "id": 35,
    "text": "综观先秦诸子散文的流变，其文体经历了从语录体、对话体向结构严密专题论文的渐进成熟，",
    "start": 198.922,
    "end": 206.134,
    "duration": 7.212
  },
  {
    "id": 36,
    "text": "并形成了儒家道义雄辩、道家寓言奇想与法家冷峻剖析并峙的风格谱系。",
    "start": 206.513,
    "end": 211.915,
    "duration": 5.402
  },
  {
    "id": 37,
    "text": "在“百家争鸣”的思想激荡中锤炼出的说理章法与寓言比喻传统，为中国古代散文的发展立下了论辩法度与文学风范。",
    "start": 212.593,
    "end": 221.605,
    "duration": 9.012
  }
]