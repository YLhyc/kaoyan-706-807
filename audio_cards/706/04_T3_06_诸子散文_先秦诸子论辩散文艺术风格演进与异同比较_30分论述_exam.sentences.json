[
  {
    "id": 1,
    "text": "试论先秦诸子论辩散文的艺术风格演进历程与主要流派异同比较。",
    "start": 0.08,
    "end": 6.228,
    "duration": 6.148
  },
  {
    "id": 2,
    "text": "春秋战国时期是中国古代社会经历剧烈大变革、大分化的剧动时代。",
    "start": 6.934,
    "end": 12.569,
    "duration": 5.635
  },
  {
    "id": 3,
    "text": "随着周天子失驭、宗法礼乐制度崩坏、",
    "start": 13.093,
    "end": 16.152,
    "duration": 3.059
  },
  {
    "id": 4,
    "text": "私学兴起与士阶层的迅速崛起，",
    "start": 16.446,
    "end": 18.93,
    "duration": 2.484
  },
  {
    "id": 5,
    "text": "形成了思想空前活跃的 “百家争鸣” 格局。",
    "start": 19.244,
    "end": 22.311,
    "duration": 3.067
  },
  {
    "id": 6,
    "text": "先秦诸子论辩散文伴随时代思想探索的深入，",
    "start": 22.489,
    "end": 26.161,
    "duration": 3.672
  },
  {
    "id": 7,
    "text": "实现了中国古代论说文体的历史定型。",
    "start": 26.384,
    "end": 29.218,
    "duration": 2.834
  },
  {
    "id": 8,
    "text": "其文体演进历程与各派风格之异同比较，",
    "start": 29.511,
    "end": 33.009,
    "duration": 3.498
  },
  {
    "id": 9,
    "text": "主要展现为以下四个核心维度：第一，",
    "start": 33.133,
    "end": 36.296,
    "duration": 3.163
  },
  {
    "id": 10,
    "text": "历经从语录体到对话式论辩再到成熟专题论文的文体演进序列。",
    "start": 36.842,
    "end": 42.019,
    "duration": 5.177
  },
  {
    "id": 11,
    "text": "先秦诸子散文的形式发展呈现出严整的历史逻辑。",
    "start": 42.248,
    "end": 46.099,
    "duration": 3.851
  },
  {
    "id": 12,
    "text": "春秋末期产生的 《论语》 以 “语录体” 为主，",
    "start": 46.261,
    "end": 49.126,
    "duration": 2.865
  },
  {
    "id": 13,
    "text": "短小简括、言简意赅，多为孔子及其弟子的言行实录；",
    "start": 49.303,
    "end": 53.857,
    "duration": 4.554
  },
  {
    "id": 14,
    "text": "战国中期的 《孟子》 与 《庄子》 发展为 “对话式论辩体”，",
    "start": 53.964,
    "end": 57.744,
    "duration": 3.78
  },
  {
    "id": 15,
    "text": "篇幅大为拓展，",
    "start": 57.876,
    "end": 58.952,
    "duration": 1.076
  },
  {
    "id": 16,
    "text": "善于在问难驳斥中展开丰富的情节与生动的比喻；",
    "start": 59.023,
    "end": 63.023,
    "duration": 4.0
  },
  {
    "id": 17,
    "text": "至战国末期的 《荀子》 与 《韩非子》，",
    "start": 63.209,
    "end": 65.927,
    "duration": 2.718
  },
  {
    "id": 18,
    "text": "则彻底摆脱了随手记录言行的零散形式，",
    "start": 66.157,
    "end": 70.118,
    "duration": 3.961
  },
  {
    "id": 19,
    "text": "确立了由作者独立撰写的 “专题论文体”。",
    "start": 70.147,
    "end": 73.499,
    "duration": 3.352
  },
  {
    "id": 20,
    "text": "全书标题即论题，结构严整、论证周密、逻辑谨严，",
    "start": 73.952,
    "end": 78.824,
    "duration": 4.872
  },
  {
    "id": 21,
    "text": "标志着先秦论辩散文文体完全走向成熟。",
    "start": 79.127,
    "end": 82.784,
    "duration": 3.657
  },
  {
    "id": 22,
    "text": "第二，儒家散文由从容温雅走向气势磅礴，",
    "start": 83.099,
    "end": 86.932,
    "duration": 3.833
  },
  {
    "id": 23,
    "text": "贯穿深沉的政治理想与道义担当。",
    "start": 87.309,
    "end": 89.92,
    "duration": 2.611
  },
  {
    "id": 24,
    "text": "儒家散文以救世为旨归，追求明礼行仁。",
    "start": 90.102,
    "end": 93.139,
    "duration": 3.037
  },
  {
    "id": 25,
    "text": "《论语》 风格雍容雅致、循循善诱，",
    "start": 93.221,
    "end": 95.711,
    "duration": 2.49
  },
  {
    "id": 26,
    "text": "在平实对话中彰显智者风范与深沉的仁德修养；至战国中期，",
    "start": 95.774,
    "end": 100.582,
    "duration": 4.808
  },
  {
    "id": 27,
    "text": "面对礼崩乐坏加剧与杨墨学术竞争，孟子承担起卫道大任，",
    "start": 100.645,
    "end": 105.025,
    "duration": 4.38
  },
  {
    "id": 28,
    "text": "其文风大变，展现出 “雄辩” 特征。",
    "start": 105.09,
    "end": 107.549,
    "duration": 2.459
  },
  {
    "id": 29,
    "text": "孟子自称 “予岂好辩哉，予不得已也”。",
    "start": 107.777,
    "end": 111.304,
    "duration": 3.527
  },
  {
    "id": 30,
    "text": "他长于修辞，大量运用排比、对偶形成凌厉攻势，",
    "start": 111.576,
    "end": 115.628,
    "duration": 4.052
  },
  {
    "id": 31,
    "text": "善设机巧与类比设阱，如以 “五十步笑百步” 启发梁惠王，",
    "start": 115.904,
    "end": 121.169,
    "duration": 5.265
  },
  {
    "id": 32,
    "text": "以 “揠苗助长” 阐说心性修养，文章辞气磅礴、锋芒毕露，",
    "start": 121.477,
    "end": 126.251,
    "duration": 4.774
  },
  {
    "id": 33,
    "text": "洋溢着刚健从容的大丈夫气概。",
    "start": 126.581,
    "end": 129.029,
    "duration": 2.448
  },
  {
    "id": 34,
    "text": "第三，道家散文打破逻辑名辩桎梏，",
    "start": 129.215,
    "end": 132.68,
    "duration": 3.465
  },
  {
    "id": 35,
    "text": "以奇幻寓言与汪洋恣肆展现超旷美学境界。",
    "start": 132.903,
    "end": 136.974,
    "duration": 4.071
  },
  {
    "id": 36,
    "text": "道家散文以追求个体心灵绝对自由与天地之道为归宿。",
    "start": 137.289,
    "end": 141.822,
    "duration": 4.533
  },
  {
    "id": 37,
    "text": "《老子》 文约义丰、韵散结合，多用正言若反的辩证格言；",
    "start": 142.199,
    "end": 146.677,
    "duration": 4.478
  },
  {
    "id": 38,
    "text": "战国中期的 《庄子》 则将道家论辩推向浪漫主义极致。",
    "start": 146.931,
    "end": 150.741,
    "duration": 3.81
  },
  {
    "id": 39,
    "text": "庄子摒弃了儒墨两家逻辑辩驳的常规路径，以 “寓言”、",
    "start": 151.113,
    "end": 155.828,
    "duration": 4.715
  },
  {
    "id": 40,
    "text": "“重言”、“卮言” 构筑独特的表达体系。",
    "start": 155.92,
    "end": 158.694,
    "duration": 2.774
  },
  {
    "id": 41,
    "text": "在 《逍遥游》 中，他虚构了翼若垂天之云、",
    "start": 158.972,
    "end": 162.437,
    "duration": 3.465
  },
  {
    "id": 42,
    "text": "抟扶摇而上九万里的北冥大鹏，以及野马尘埃、",
    "start": 162.538,
    "end": 166.983,
    "duration": 4.445
  },
  {
    "id": 43,
    "text": "蜩与学鸠的鲜明对照，",
    "start": 167.017,
    "end": 168.748,
    "duration": 1.731
  },
  {
    "id": 44,
    "text": "在天马行空的瑰丽想象与荒诞奇诡的物象变幻中，",
    "start": 169.15,
    "end": 173.129,
    "duration": 3.979
  },
  {
    "id": 45,
    "text": "消解世俗是非名利。",
    "start": 173.347,
    "end": 174.906,
    "duration": 1.559
  },
  {
    "id": 46,
    "text": "其文辞汪洋恣肆、仪态万方，达到了哲理与诗意高度浑融的化境。",
    "start": 175.167,
    "end": 180.547,
    "duration": 5.38
  },
  {
    "id": 47,
    "text": "第四，法家与晚期诸子倡导冷峻严密剖析，",
    "start": 180.793,
    "end": 185.207,
    "duration": 4.414
  },
  {
    "id": 48,
    "text": "确立说理文结构谨严的论证法度。",
    "start": 185.559,
    "end": 188.392,
    "duration": 2.833
  },
  {
    "id": 49,
    "text": "战国末期兼并战争白热化，讲求富国强兵、",
    "start": 188.661,
    "end": 192.459,
    "duration": 3.798
  },
  {
    "id": 50,
    "text": "以法统政的法家散文应运而生。",
    "start": 192.683,
    "end": 195.308,
    "duration": 2.625
  },
  {
    "id": 51,
    "text": "韩非集法家思想之大成，其散文冷峻深邃、锋利如刀。",
    "start": 195.546,
    "end": 200.366,
    "duration": 4.82
  },
  {
    "id": 52,
    "text": "韩非立足于人性自私的功利立场，在 《孤愤》、",
    "start": 200.763,
    "end": 204.38,
    "duration": 3.617
  },
  {
    "id": 53,
    "text": "《说难》 等篇中，洞察君臣权谋世情，解剖鞭辟入里。",
    "start": 204.423,
    "end": 208.795,
    "duration": 4.372
  },
  {
    "id": 54,
    "text": "韩非善于运用历史事实与民间寓言相互发明，",
    "start": 209.038,
    "end": 212.562,
    "duration": 3.524
  },
  {
    "id": 55,
    "text": "如 “买椟还珠”、“自相矛盾”、“守株待兔”，",
    "start": 212.733,
    "end": 215.717,
    "duration": 2.984
  },
  {
    "id": 56,
    "text": "使抽象的法治权术说理变得生动而具无可辩驳的逻辑说服力；",
    "start": 215.872,
    "end": 220.554,
    "duration": 4.682
  },
  {
    "id": 57,
    "text": "结合荀子散文由博反约、反复推求的长篇论说，",
    "start": 220.835,
    "end": 224.766,
    "duration": 3.931
  },
  {
    "id": 58,
    "text": "共同奠定了后世古代说理散文严谨谨饬的法度典范。",
    "start": 224.882,
    "end": 229.152,
    "duration": 4.27
  }
]
