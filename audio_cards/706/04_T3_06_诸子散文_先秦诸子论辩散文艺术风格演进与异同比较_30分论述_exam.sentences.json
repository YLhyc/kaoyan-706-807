[
  {
    "id": 1,
    "text": "试论先秦诸子论辩散文的艺术风格演进历程与主要流派异同比较。",
    "start": 0.16,
    "end": 7.12,
    "duration": 6.96
  },
  {
    "id": 2,
    "text": "春秋战国时期是中国古代社会经历剧烈大变革、大分化的剧动时代。",
    "start": 7.12,
    "end": 13.28,
    "duration": 6.16
  },
  {
    "id": 3,
    "text": "随着周天子失驭、宗法礼乐制度崩坏、",
    "start": 13.28,
    "end": 16.96,
    "duration": 3.68
  },
  {
    "id": 4,
    "text": "私学兴起与士阶层的迅速崛起，",
    "start": 16.96,
    "end": 20.0,
    "duration": 3.04
  },
  {
    "id": 5,
    "text": "形成了思想空前活跃的 “百家争鸣” 格局。",
    "start": 20.0,
    "end": 23.84,
    "duration": 3.84
  },
  {
    "id": 6,
    "text": "先秦诸子论辩散文伴随时代思想探索的深入，",
    "start": 23.84,
    "end": 27.68,
    "duration": 3.84
  },
  {
    "id": 7,
    "text": "实现了中国古代论说文体的历史定型。",
    "start": 27.68,
    "end": 31.52,
    "duration": 3.84
  },
  {
    "id": 8,
    "text": "其文体演进历程与各派风格之异同比较，",
    "start": 31.52,
    "end": 35.12,
    "duration": 3.6
  },
  {
    "id": 9,
    "text": "主要展现为以下四个核心维度：第一，",
    "start": 35.12,
    "end": 38.96,
    "duration": 3.84
  },
  {
    "id": 10,
    "text": "历经从语录体到对话式论辩再到成熟专题论文的文体演进序列。",
    "start": 39.12,
    "end": 44.64,
    "duration": 5.52
  },
  {
    "id": 11,
    "text": "先秦诸子散文的形式发展呈现出严整的历史逻辑。",
    "start": 44.64,
    "end": 48.88,
    "duration": 4.24
  },
  {
    "id": 12,
    "text": "春秋末期产生的 《论语》 以 “语录体” 为主，",
    "start": 48.88,
    "end": 53.36,
    "duration": 4.48
  },
  {
    "id": 13,
    "text": "短小简括、言简意赅，多为孔子及其弟子的言行实录；",
    "start": 53.36,
    "end": 58.4,
    "duration": 5.04
  },
  {
    "id": 14,
    "text": "战国中期的 《孟子》 与 《庄子》 发展为 “对话式论辩体”，",
    "start": 58.4,
    "end": 62.96,
    "duration": 4.56
  },
  {
    "id": 15,
    "text": "篇幅大为拓展，",
    "start": 63.2,
    "end": 64.64,
    "duration": 1.44
  },
  {
    "id": 16,
    "text": "善于在问难驳斥中展开丰富的情节与生动的比喻；",
    "start": 64.64,
    "end": 69.68,
    "duration": 5.04
  },
  {
    "id": 17,
    "text": "至战国末期的 《荀子》 与 《韩非子》，",
    "start": 70.0,
    "end": 74.08,
    "duration": 4.08
  },
  {
    "id": 18,
    "text": "则彻底摆脱了随手记录言行的零散形式，",
    "start": 74.08,
    "end": 78.72,
    "duration": 4.64
  },
  {
    "id": 19,
    "text": "确立了由作者独立撰写的 “专题论文体”。",
    "start": 79.04,
    "end": 83.2,
    "duration": 4.16
  },
  {
    "id": 20,
    "text": "全书标题即论题，结构严整、论证周密、逻辑谨严，",
    "start": 83.2,
    "end": 88.56,
    "duration": 5.36
  },
  {
    "id": 21,
    "text": "标志着先秦论辩散文文体完全走向成熟。",
    "start": 88.56,
    "end": 92.16,
    "duration": 3.6
  },
  {
    "id": 22,
    "text": "第二，儒家散文由从容温雅走向气势磅礴，",
    "start": 92.16,
    "end": 96.16,
    "duration": 4.0
  },
  {
    "id": 23,
    "text": "贯穿深沉的政治理想与道义担当。",
    "start": 96.16,
    "end": 98.88,
    "duration": 2.72
  },
  {
    "id": 24,
    "text": "儒家散文以救世为旨归，追求明礼行仁。",
    "start": 98.88,
    "end": 102.4,
    "duration": 3.52
  },
  {
    "id": 25,
    "text": "《论语》 风格雍容雅致、循循善诱，",
    "start": 102.4,
    "end": 105.44,
    "duration": 3.04
  },
  {
    "id": 26,
    "text": "在平实对话中彰显智者风范与深沉的仁德修养；至战国中期，",
    "start": 105.44,
    "end": 111.68,
    "duration": 6.24
  },
  {
    "id": 27,
    "text": "面对礼崩乐坏加剧与杨墨学术竞争，孟子承担起卫道大任，",
    "start": 111.68,
    "end": 117.84,
    "duration": 6.16
  },
  {
    "id": 28,
    "text": "其文风大变，展现出 “雄辩” 特征。",
    "start": 117.84,
    "end": 121.76,
    "duration": 3.92
  },
  {
    "id": 29,
    "text": "孟子自称 “予岂好辩哉，予不得已也”。",
    "start": 121.76,
    "end": 126.0,
    "duration": 4.24
  },
  {
    "id": 30,
    "text": "他长于修辞，大量运用排比、对偶形成凌厉攻势，",
    "start": 126.0,
    "end": 131.36,
    "duration": 5.36
  },
  {
    "id": 31,
    "text": "善设机巧与类比设阱，如以 “五十步笑百步” 启发梁惠王，",
    "start": 131.36,
    "end": 136.56,
    "duration": 5.2
  },
  {
    "id": 32,
    "text": "以 “揠苗助长” 阐说心性修养，文章辞气磅礴、锋芒毕露，",
    "start": 136.56,
    "end": 142.304,
    "duration": 5.744
  },
  {
    "id": 33,
    "text": "洋溢着刚健从容的大丈夫气概。",
    "start": 142.304,
    "end": 145.584,
    "duration": 3.28
  },
  {
    "id": 34,
    "text": "第三，道家散文打破逻辑名辩桎梏，",
    "start": 145.584,
    "end": 148.784,
    "duration": 3.2
  },
  {
    "id": 35,
    "text": "以奇幻寓言与汪洋恣肆展现超旷美学境界。",
    "start": 148.784,
    "end": 152.464,
    "duration": 3.68
  },
  {
    "id": 36,
    "text": "道家散文以追求个体心灵绝对自由与天地之道为归宿。",
    "start": 152.464,
    "end": 158.304,
    "duration": 5.84
  },
  {
    "id": 37,
    "text": "《老子》 文约义丰、韵散结合，多用正言若反的辩证格言；",
    "start": 158.304,
    "end": 164.144,
    "duration": 5.84
  },
  {
    "id": 38,
    "text": "战国中期的 《庄子》 则将道家论辩推向浪漫主义极致。",
    "start": 164.384,
    "end": 169.984,
    "duration": 5.6
  },
  {
    "id": 39,
    "text": "庄子摒弃了儒墨两家逻辑辩驳的常规路径，以 “寓言”、",
    "start": 169.984,
    "end": 174.864,
    "duration": 4.88
  },
  {
    "id": 40,
    "text": "“重言”、“卮言” 构筑独特的表达体系。",
    "start": 175.104,
    "end": 178.464,
    "duration": 3.36
  },
  {
    "id": 41,
    "text": "在 《逍遥游》 中，他虚构了翼若垂天之云、",
    "start": 178.464,
    "end": 182.784,
    "duration": 4.32
  },
  {
    "id": 42,
    "text": "抟扶摇而上九万里的北冥大鹏，以及野马尘埃、",
    "start": 182.784,
    "end": 187.984,
    "duration": 5.2
  },
  {
    "id": 43,
    "text": "蜩与学鸠的鲜明对照，",
    "start": 187.984,
    "end": 190.064,
    "duration": 2.08
  },
  {
    "id": 44,
    "text": "在天马行空的瑰丽想象与荒诞奇诡的物象变幻中，",
    "start": 190.064,
    "end": 195.024,
    "duration": 4.96
  },
  {
    "id": 45,
    "text": "消解世俗是非名利。",
    "start": 195.024,
    "end": 196.944,
    "duration": 1.92
  },
  {
    "id": 46,
    "text": "其文辞汪洋恣肆、仪态万方，达到了哲理与诗意高度浑融的化境。",
    "start": 196.944,
    "end": 203.984,
    "duration": 7.04
  },
  {
    "id": 47,
    "text": "第四，法家与晚期诸子倡导冷峻严密剖析，",
    "start": 203.984,
    "end": 208.544,
    "duration": 4.56
  },
  {
    "id": 48,
    "text": "确立说理文结构谨严的论证法度。",
    "start": 208.544,
    "end": 211.504,
    "duration": 2.96
  },
  {
    "id": 49,
    "text": "战国末期兼并战争白热化，讲求富国强兵、",
    "start": 211.504,
    "end": 216.064,
    "duration": 4.56
  },
  {
    "id": 50,
    "text": "以法统政的法家散文应运而生。",
    "start": 216.064,
    "end": 218.704,
    "duration": 2.64
  },
  {
    "id": 51,
    "text": "韩非集法家思想之大成，其散文冷峻深邃、锋利如刀。",
    "start": 218.704,
    "end": 223.664,
    "duration": 4.96
  },
  {
    "id": 52,
    "text": "韩非立足于人性自私的功利立场，在 《孤愤》、",
    "start": 223.664,
    "end": 227.584,
    "duration": 3.92
  },
  {
    "id": 53,
    "text": "《说难》 等篇中，洞察君臣权谋世情，解剖鞭辟入里。",
    "start": 227.584,
    "end": 228.944,
    "duration": 1.36
  },
  {
    "id": 54,
    "text": "韩非善于运用历史事实与民间寓言相互发明，",
    "start": 228.784,
    "end": 228.944,
    "duration": 0.16
  },
  {
    "id": 55,
    "text": "如 “买椟还珠”、“自相矛盾”、“守株待兔”，",
    "start": 228.784,
    "end": 228.944,
    "duration": 0.16
  },
  {
    "id": 56,
    "text": "使抽象的法治权术说理变得生动而具无可辩驳的逻辑说服力；",
    "start": 228.784,
    "end": 228.944,
    "duration": 0.16
  },
  {
    "id": 57,
    "text": "结合荀子散文由博反约、反复推求的长篇论说，",
    "start": 228.784,
    "end": 228.944,
    "duration": 0.16
  },
  {
    "id": 58,
    "text": "共同奠定了后世古代说理散文严谨谨饬的法度典范。",
    "start": 228.784,
    "end": 228.944,
    "duration": 0.16
  }
]