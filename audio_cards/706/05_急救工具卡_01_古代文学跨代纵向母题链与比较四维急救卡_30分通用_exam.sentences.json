[
  {
    "id": 1,
    "text": "古代文学跨时代纵向母题链与比较四维急救卡。",
    "start": 0.113,
    "end": 3.726,
    "duration": 3.613
  },
  {
    "id": 2,
    "text": "考场遇到手卷未收原题的跨代演变题或陌生双家比较题，可直接调取手卷已背的单篇要点，",
    "start": 4.226,
    "end": 11.836,
    "duration": 7.61
  },
  {
    "id": 3,
    "text": "依托以下“四条纵向母题链”与“比较横切四维法”快速拼装成篇。",
    "start": 12.216,
    "end": 17.365,
    "duration": 5.149
  },
  {
    "id": 4,
    "text": "第一链，现实主义与诗史精神链：《诗经》风雅写民苦，",
    "start": 18.018,
    "end": 22.601,
    "duration": 4.583
  },
  {
    "id": 5,
    "text": "汉乐府“感于哀乐，缘事而发”重叙事，",
    "start": 22.951,
    "end": 26.082,
    "duration": 3.131
  },
  {
    "id": 6,
    "text": "杜甫即事名篇立“诗史”，白居易新乐府倡讽谕救时弊。",
    "start": 26.432,
    "end": 30.937,
    "duration": 4.505
  },
  {
    "id": 7,
    "text": "递变脉络为：先秦民间自然咏叹，经两汉底层叙事定型，",
    "start": 31.437,
    "end": 36.091,
    "duration": 4.654
  },
  {
    "id": 8,
    "text": "至唐代转向儒者自觉记录动乱历史与针砭政治制度，一脉相承皆以真切关注生民疾苦为根基。",
    "start": 36.441,
    "end": 44.255,
    "duration": 7.814
  },
  {
    "id": 9,
    "text": "第二链，浪漫抒情与狂狷精神链：《庄子》寓言汪洋恣肆破俗见，",
    "start": 44.902,
    "end": 50.393,
    "duration": 5.491
  },
  {
    "id": 10,
    "text": "屈原《离骚》香草美人铸忠怨，李白放歌抒盛唐狂傲，苏轼“以诗为词”拓旷达超脱。",
    "start": 50.743,
    "end": 58.374,
    "duration": 7.631
  },
  {
    "id": 11,
    "text": "递变脉络为：战国出世逍遥与楚地沉痛抗争交汇后，在盛唐张扬为个体主体自信，",
    "start": 58.874,
    "end": 66.381,
    "duration": 7.507
  },
  {
    "id": 12,
    "text": "再经宋代士大夫贬谪淬炼，化为身处逆境仍能自适超拔的精神境界。",
    "start": 66.731,
    "end": 72.446,
    "duration": 5.715
  },
  {
    "id": 13,
    "text": "第三链，市井觉醒与女性悲剧链：《窦娥冤》控酷吏冤狱，《西厢记》争婚姻自主，",
    "start": 73.092,
    "end": 79.844,
    "duration": 6.752
  },
  {
    "id": 14,
    "text": "《牡丹亭》倡生死至情，《红楼梦》写宝黛情殇与宗法挽歌。",
    "start": 80.194,
    "end": 85.253,
    "duration": 5.059
  },
  {
    "id": 15,
    "text": "递变脉络为：随宋元明清市民阶层壮大，女性人物由承受外部官僚迫害的抗争，",
    "start": 85.753,
    "end": 92.255,
    "duration": 6.502
  },
  {
    "id": 16,
    "text": "逐步转向对礼教压抑与精神自由的深度追问，直至揭示整个宗法体制的腐朽与必然衰落。",
    "start": 92.605,
    "end": 99.967,
    "duration": 7.362
  },
  {
    "id": 17,
    "text": "第四链，隐逸情怀与山水田园链：",
    "start": 100.564,
    "end": 103.595,
    "duration": 3.031
  },
  {
    "id": 18,
    "text": "陶渊明躬耕显冲淡真淳，王维寄情静逸禅意、孟浩然擅清淡自然，范成大《四时田园杂兴》直面农事劳苦。",
    "start": 104.068,
    "end": 113.751,
    "duration": 9.683
  },
  {
    "id": 19,
    "text": "递变脉络为：田园山水从六朝高士的守节独善、盛唐士人的空灵审美观照，",
    "start": 114.251,
    "end": 120.405,
    "duration": 6.154
  },
  {
    "id": 20,
    "text": "发展到南宋兼纳新乐府写实精神，真正让农村劳作与租税艰辛成为诗境重心。",
    "start": 120.755,
    "end": 127.448,
    "duration": 6.693
  },
  {
    "id": 21,
    "text": "遇到双作家或双流派比较题，严禁先写完甲再写完乙，统一采用“横切四维法”逐段对敲。",
    "start": 128.115,
    "end": 136.04,
    "duration": 7.925
  },
  {
    "id": 22,
    "text": "四步标准立桩公式为：一比题材选材取向之同异，二比创作心态与时代境遇之同异，",
    "start": 136.54,
    "end": 144.104,
    "duration": 7.564
  },
  {
    "id": 23,
    "text": "三比意象结构与语言声律之同异，四比在文体演变史上的承接地位之同异；",
    "start": 144.586,
    "end": 150.947,
    "duration": 6.361
  },
  {
    "id": 24,
    "text": "每段务必紧扣各自一句代表作或关键人物做交错对读，即可稳固结构、不失要点。",
    "start": 151.447,
    "end": 157.912,
    "duration": 6.465
  }
]
