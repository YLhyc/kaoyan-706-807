[
  {
    "id": 1,
    "text": "古代文学跨时代纵向母题链与比较四维急救卡。",
    "start": 0.113,
    "end": 3.717,
    "duration": 3.604
  },
  {
    "id": 2,
    "text": "考场遇到手卷未收原题的跨代演变题或陌生双家比较题，",
    "start": 4.209,
    "end": 8.965,
    "duration": 4.756
  },
  {
    "id": 3,
    "text": "可直接调取手卷已背的单篇要点，",
    "start": 9.333,
    "end": 11.809,
    "duration": 2.476
  },
  {
    "id": 4,
    "text": "依托以下“四条纵向母题链”与“比较横切四维法”快速拼装成篇。",
    "start": 12.199,
    "end": 17.339,
    "duration": 5.14
  },
  {
    "id": 5,
    "text": "第一链，现实主义与诗史精神链：《诗经》风雅写民苦，",
    "start": 18.001,
    "end": 22.574,
    "duration": 4.573
  },
  {
    "id": 6,
    "text": "汉乐府“感于哀乐，缘事而发”重叙事，",
    "start": 22.784,
    "end": 25.905,
    "duration": 3.121
  },
  {
    "id": 7,
    "text": "杜甫即事名篇立“诗史”，白居易新乐府倡讽谕救时弊。",
    "start": 26.263,
    "end": 30.758,
    "duration": 4.495
  },
  {
    "id": 8,
    "text": "递变脉络为：先秦民间自然咏叹，经两汉底层叙事定型，",
    "start": 30.893,
    "end": 35.537,
    "duration": 4.644
  },
  {
    "id": 9,
    "text": "至唐代转向儒者自觉记录动乱历史与针砭政治制度，",
    "start": 35.68,
    "end": 39.952,
    "duration": 4.272
  },
  {
    "id": 10,
    "text": "一脉相承皆以真切关注生民疾苦为根基。",
    "start": 40.084,
    "end": 43.484,
    "duration": 3.4
  },
  {
    "id": 11,
    "text": "第二链，浪漫抒情与狂狷精神链：",
    "start": 44.141,
    "end": 47.027,
    "duration": 2.886
  },
  {
    "id": 12,
    "text": "《庄子》寓言汪洋恣肆破俗见，屈原《离骚》香草美人铸忠怨，",
    "start": 47.227,
    "end": 52.268,
    "duration": 5.041
  },
  {
    "id": 13,
    "text": "李白放歌抒盛唐狂傲，苏轼“以诗为词”拓旷达超脱。",
    "start": 52.679,
    "end": 57.531,
    "duration": 4.852
  },
  {
    "id": 14,
    "text": "递变脉络为：战国出世逍遥与楚地沉痛抗争交汇后，",
    "start": 57.745,
    "end": 62.336,
    "duration": 4.591
  },
  {
    "id": 15,
    "text": "在盛唐张扬为个体主体自信，再经宋代士大夫贬谪淬炼，",
    "start": 62.799,
    "end": 67.515,
    "duration": 4.716
  },
  {
    "id": 16,
    "text": "化为身处逆境仍能自适超拔的精神境界。",
    "start": 67.906,
    "end": 71.218,
    "duration": 3.312
  },
  {
    "id": 17,
    "text": "第三链，市井觉醒与女性悲剧链：《窦娥冤》控酷吏冤狱，",
    "start": 71.874,
    "end": 76.612,
    "duration": 4.738
  },
  {
    "id": 18,
    "text": "《西厢记》争婚姻自主，《牡丹亭》倡生死至情，",
    "start": 76.871,
    "end": 80.714,
    "duration": 3.843
  },
  {
    "id": 19,
    "text": "《红楼梦》写宝黛情殇与宗法挽歌。",
    "start": 80.806,
    "end": 83.758,
    "duration": 2.952
  },
  {
    "id": 20,
    "text": "递变脉络为：随宋元明清市民阶层壮大，",
    "start": 83.846,
    "end": 87.28,
    "duration": 3.434
  },
  {
    "id": 21,
    "text": "女性人物由承受外部官僚迫害的抗争，",
    "start": 87.36,
    "end": 90.338,
    "duration": 2.978
  },
  {
    "id": 22,
    "text": "逐步转向对礼教压抑与精神自由的深度追问，",
    "start": 90.604,
    "end": 94.271,
    "duration": 3.667
  },
  {
    "id": 23,
    "text": "直至揭示整个宗法体制的腐朽与必然衰落。",
    "start": 94.638,
    "end": 97.956,
    "duration": 3.318
  },
  {
    "id": 24,
    "text": "第四链，隐逸情怀与山水田园链：陶渊明躬耕显冲淡真淳，",
    "start": 98.563,
    "end": 104.156,
    "duration": 5.593
  },
  {
    "id": 25,
    "text": "王维、孟浩然写静逸禅意，",
    "start": 104.318,
    "end": 106.653,
    "duration": 2.335
  },
  {
    "id": 26,
    "text": "范成大《四时田园杂兴》直面农事劳苦。",
    "start": 106.877,
    "end": 109.791,
    "duration": 2.914
  },
  {
    "id": 27,
    "text": "递变脉络为：田园山水从六朝高士的守节独善、",
    "start": 109.995,
    "end": 113.855,
    "duration": 3.86
  },
  {
    "id": 28,
    "text": "盛唐士人的空灵审美观照，发展到南宋兼纳新乐府写实精神，",
    "start": 114.037,
    "end": 119.256,
    "duration": 5.219
  },
  {
    "id": 29,
    "text": "真正让农村劳作与租税艰辛成为诗境重心。",
    "start": 119.336,
    "end": 123.079,
    "duration": 3.743
  },
  {
    "id": 30,
    "text": "遇到双作家或双流派比较题，严禁先写完甲再写完乙，",
    "start": 123.756,
    "end": 128.481,
    "duration": 4.725
  },
  {
    "id": 31,
    "text": "统一采用“横切四维法”逐段对敲。",
    "start": 128.957,
    "end": 131.671,
    "duration": 2.714
  },
  {
    "id": 32,
    "text": "四步标准立桩公式为：一比题材选材取向之同异，",
    "start": 132.142,
    "end": 136.57,
    "duration": 4.428
  },
  {
    "id": 33,
    "text": "二比创作心态与时代境遇之同异，",
    "start": 137.065,
    "end": 139.696,
    "duration": 2.631
  },
  {
    "id": 34,
    "text": "三比意象结构与语言声律之同异，",
    "start": 140.188,
    "end": 142.897,
    "duration": 2.709
  },
  {
    "id": 35,
    "text": "四比在文体演变史上的承接地位之同异；",
    "start": 143.418,
    "end": 146.539,
    "duration": 3.121
  },
  {
    "id": 36,
    "text": "每段务必紧扣各自一句代表作或关键人物做交错对读，",
    "start": 146.799,
    "end": 151.048,
    "duration": 4.249
  },
  {
    "id": 37,
    "text": "即可稳固结构、不失要点。",
    "start": 151.174,
    "end": 153.264,
    "duration": 2.09
  }
]