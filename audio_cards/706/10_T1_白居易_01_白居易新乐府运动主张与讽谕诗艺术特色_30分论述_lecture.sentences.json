[
  {
    "id": 1,
    "text": "篇头：全题宏观破题与立论逻辑。",
    "start": 0.08,
    "end": 3.12,
    "duration": 3.04
  },
  {
    "id": 2,
    "text": "问题一：这道题到底在问什么？。",
    "start": 3.12,
    "end": 5.92,
    "duration": 2.8
  },
  {
    "id": 3,
    "text": "这道题将“新乐府运动理论主张”与“讽谕诗艺术特色”双轴并置。",
    "start": 5.92,
    "end": 11.36,
    "duration": 5.44
  },
  {
    "id": 4,
    "text": "在考场上，考生绝不能把理论纲领与创作文本割裂开来。",
    "start": 11.36,
    "end": 16.16,
    "duration": 4.8
  },
  {
    "id": 5,
    "text": "必须说明：理论主张是讽谕诗创作的指导蓝图，",
    "start": 16.16,
    "end": 20.16,
    "duration": 4.0
  },
  {
    "id": 6,
    "text": "而讽谕诗则是其诗学纲领的具体审美实践。",
    "start": 20.16,
    "end": 23.52,
    "duration": 3.36
  },
  {
    "id": 7,
    "text": "问题二：宏观立论核心指向哪里？。",
    "start": 23.84,
    "end": 26.88,
    "duration": 3.04
  },
  {
    "id": 8,
    "text": "立论核心必须紧扣《与元九书》中“文章合为时而著，",
    "start": 26.88,
    "end": 31.36,
    "duration": 4.48
  },
  {
    "id": 9,
    "text": "歌诗合为事而作”的纲领性命题，以及杜甫现实主义传统的接续。",
    "start": 31.36,
    "end": 36.64,
    "duration": 5.28
  },
  {
    "id": 10,
    "text": "阐明白居易以诗歌干预现实政治、为民请命的核心精神。",
    "start": 36.64,
    "end": 41.68,
    "duration": 5.04
  },
  {
    "id": 11,
    "text": "问题三：由浅入深拆解为哪几个答题维度？。",
    "start": 41.68,
    "end": 45.04,
    "duration": 3.36
  },
  {
    "id": 12,
    "text": "本题按理论向创作实践下沉的逻辑拆解为四个维度：第一维度，",
    "start": 45.28,
    "end": 50.32,
    "duration": 5.04
  },
  {
    "id": 13,
    "text": "理论主张，由时代使命切入，拆解《与元九书》中为时为事、",
    "start": 50.32,
    "end": 55.28,
    "duration": 4.96
  },
  {
    "id": 14,
    "text": "补察时政、根情苗言实义等核心理论范畴。",
    "start": 55.28,
    "end": 59.04,
    "duration": 3.76
  },
  {
    "id": 15,
    "text": "第二维度，批判锋芒与现实题材，以《新乐府》《秦中吟》（卖炭翁、",
    "start": 59.04,
    "end": 64.48,
    "duration": 5.44
  },
  {
    "id": 16,
    "text": "重赋）为代表，展现直面阶级矛盾与民生疾苦的写实力度。",
    "start": 64.48,
    "end": 69.2,
    "duration": 4.72
  },
  {
    "id": 17,
    "text": "第三维度，艺术特色，剖析首句标其目卒章显其志的结构机制，",
    "start": 69.52,
    "end": 74.4,
    "duration": 4.88
  },
  {
    "id": 18,
    "text": "以及老域能解的平易通俗语言。",
    "start": 74.4,
    "end": 76.88,
    "duration": 2.48
  },
  {
    "id": 19,
    "text": "第四维度，文学史价值，客观评析其强烈的现实教化价值与议论过露局限，",
    "start": 76.88,
    "end": 83.12,
    "duration": 6.24
  },
  {
    "id": 20,
    "text": "总结其对宋代诗文革新运动的深远滋养。",
    "start": 83.12,
    "end": 86.16,
    "duration": 3.04
  },
  {
    "id": 21,
    "text": "问题四：各维度之间具备怎样不可逆的递进因果链条？。",
    "start": 86.16,
    "end": 90.4,
    "duration": 4.24
  },
  {
    "id": 22,
    "text": "第一步必须先在宏观上确立新乐府运动的时代背景与诗学定位。",
    "start": 90.48,
    "end": 95.76,
    "duration": 5.28
  },
  {
    "id": 23,
    "text": "第二步系统阐明指导思想与理论纲领。",
    "start": 95.76,
    "end": 99.44,
    "duration": 3.68
  },
  {
    "id": 24,
    "text": "第三步顺理成章将理论落实在讽谕诗的批判题材与具体文本上。",
    "start": 99.44,
    "end": 104.96,
    "duration": 5.52
  },
  {
    "id": 25,
    "text": "第四步深入剖析支撑这种批判的艺术结构与语言风格。",
    "start": 104.96,
    "end": 109.84,
    "duration": 4.88
  },
  {
    "id": 26,
    "text": "第五步跳出个案回收到文学史长河，",
    "start": 109.84,
    "end": 113.12,
    "duration": 3.28
  },
  {
    "id": 27,
    "text": "完成对现实主义传统继承与后世启迪的宏大闭环。",
    "start": 113.12,
    "end": 117.2,
    "duration": 4.08
  },
  {
    "id": 28,
    "text": "---。第",
    "start": 117.36,
    "end": 117.577,
    "duration": 0.217
  },
  {
    "id": 29,
    "text": "一部分：破题立论与诗学革新定位。",
    "start": 117.577,
    "end": 120.617,
    "duration": 3.04
  },
  {
    "id": 30,
    "text": "逐句因果推导与答题表述。",
    "start": 120.617,
    "end": 123.006,
    "duration": 2.389
  },
  {
    "id": 31,
    "text": "为了开篇直击考点要害并确立学术基调，",
    "start": 123.006,
    "end": 126.697,
    "duration": 3.691
  },
  {
    "id": 32,
    "text": "第一句必须给出白居易在中唐诗坛的宗师领袖地位与新乐府运动性质。",
    "start": 126.697,
    "end": 133.211,
    "duration": 6.514
  },
  {
    "id": 33,
    "text": "所以表述为：白居易是中唐新乐府运动的杰出领袖，",
    "start": 133.211,
    "end": 137.771,
    "duration": 4.56
  },
  {
    "id": 34,
    "text": "他与元稹共同倡导了中国古代文学史上最具自觉批判精神的诗歌革新浪潮。。",
    "start": 137.771,
    "end": 144.72,
    "duration": 6.949
  },
  {
    "id": 35,
    "text": "紧接着必须点明新乐府运动爆发的时代土壤，",
    "start": 144.848,
    "end": 148.848,
    "duration": 4.0
  },
  {
    "id": 36,
    "text": "展现历史背景与现实诱因。",
    "start": 148.848,
    "end": 151.328,
    "duration": 2.48
  },
  {
    "id": 37,
    "text": "所以表述为：针对中唐安史之乱后藩镇割据、",
    "start": 151.328,
    "end": 155.088,
    "duration": 3.76
  },
  {
    "id": 38,
    "text": "宦官专权与民生凋敝的残酷现实，白居易上承《诗经》六义与杜甫“诗史”传统，",
    "start": 155.088,
    "end": 161.888,
    "duration": 6.8
  },
  {
    "id": 39,
    "text": "在《与元九书》中系统建构了现实主义诗学纲领。。",
    "start": 161.888,
    "end": 165.568,
    "duration": 3.68
  },
  {
    "id": 40,
    "text": "最后一句必须将理论纲领引渡至题目要求的核心创作载体上，",
    "start": 165.808,
    "end": 170.608,
    "duration": 4.8
  },
  {
    "id": 41,
    "text": "完成全篇立论收束。",
    "start": 170.608,
    "end": 172.608,
    "duration": 2.0
  },
  {
    "id": 42,
    "text": "所以表述为：他以高度的政治使命感开辟了以《新乐府》和《秦中吟》为代表的讽谕诗创作，",
    "start": 172.608,
    "end": 180.288,
    "duration": 7.68
  },
  {
    "id": 43,
    "text": "将中国古典诗歌干预现实的政教功能推向了历史巅峰。。",
    "start": 180.288,
    "end": 185.008,
    "duration": 4.72
  },
  {
    "id": 44,
    "text": "本段答题思路总结。",
    "start": 185.328,
    "end": 187.008,
    "duration": 1.68
  },
  {
    "id": 45,
    "text": "本段用三句话完成全篇破题：首句给出新乐府运动领袖地位与批判精神，",
    "start": 187.008,
    "end": 193.328,
    "duration": 6.32
  },
  {
    "id": 46,
    "text": "次句交代安史之乱后的时代危机与杜甫诗史渊源，",
    "start": 193.328,
    "end": 197.648,
    "duration": 4.32
  },
  {
    "id": 47,
    "text": "末句点明《与元九书》纲领与讽谕诗创作实践，",
    "start": 197.648,
    "end": 201.488,
    "duration": 3.84
  },
  {
    "id": 48,
    "text": "下笔宏阔，紧扣题旨。",
    "start": 201.488,
    "end": 203.488,
    "duration": 2.0
  },
  {
    "id": 49,
    "text": "所以本段具体答题完整版为：白居易是中唐新乐府运动的杰出领袖，",
    "start": 203.488,
    "end": 209.088,
    "duration": 5.6
  },
  {
    "id": 50,
    "text": "他与元稹共同倡导了中国古代文学史上最具自觉批判精神的诗歌革新浪潮。",
    "start": 209.088,
    "end": 214.928,
    "duration": 5.84
  },
  {
    "id": 51,
    "text": "针对中唐安史之乱后藩镇割据、宦官专权与民生凋敝的残酷现实，",
    "start": 214.928,
    "end": 220.288,
    "duration": 5.36
  },
  {
    "id": 52,
    "text": "白居易上承《诗经》六义与杜甫“诗史”传统，",
    "start": 220.288,
    "end": 223.488,
    "duration": 3.2
  },
  {
    "id": 53,
    "text": "在《与元九书》中系统建构了现实主义诗学纲领。",
    "start": 223.488,
    "end": 226.928,
    "duration": 3.44
  },
  {
    "id": 54,
    "text": "他以高度的政治使命感开辟了以《新乐府》和《秦中吟》为代表的讽谕诗创作，",
    "start": 227.248,
    "end": 233.328,
    "duration": 6.08
  },
  {
    "id": 55,
    "text": "将中国古典诗歌干预现实的政教功能推向了历史巅峰。",
    "start": 233.328,
    "end": 238.128,
    "duration": 4.8
  },
  {
    "id": 56,
    "text": "--。第",
    "start": 238.128,
    "end": 238.288,
    "duration": 0.16
  },
  {
    "id": 57,
    "text": "二部分：新乐府运动的诗学理论主张。",
    "start": 238.288,
    "end": 241.408,
    "duration": 3.12
  },
  {
    "id": 58,
    "text": "逐句因果推导与答题表述。",
    "start": 241.408,
    "end": 243.728,
    "duration": 2.32
  },
  {
    "id": 59,
    "text": "进入具体论述的第一层，必须直截了当抛出新乐府运动最核心的理论口号，",
    "start": 243.728,
    "end": 249.648,
    "duration": 5.92
  },
  {
    "id": 60,
    "text": "作为立论第一基石。",
    "start": 249.648,
    "end": 250.928,
    "duration": 1.28
  },
  {
    "id": 61,
    "text": "所以表述为：首先，白居易在理论上确立了“文章合为时而著，",
    "start": 251.408,
    "end": 256.534,
    "duration": 5.126
  },
  {
    "id": 62,
    "text": "歌诗合为事而作”的划时代主张。。",
    "start": 256.534,
    "end": 259.254,
    "duration": 2.72
  },
  {
    "id": 63,
    "text": "接着阐明这一主张针对的历史流弊，",
    "start": 259.254,
    "end": 262.393,
    "duration": 3.139
  },
  {
    "id": 64,
    "text": "强调其干预现实的政治针对性。",
    "start": 262.393,
    "end": 265.113,
    "duration": 2.72
  },
  {
    "id": 65,
    "text": "所以表述为：针对六朝以来雕章琢句、",
    "start": 265.113,
    "end": 268.251,
    "duration": 3.138
  },
  {
    "id": 66,
    "text": "脱离现实的唯美颓风，白居易强调诗歌必须紧扣时代脉搏、",
    "start": 268.251,
    "end": 273.273,
    "duration": 5.022
  },
  {
    "id": 67,
    "text": "关切现实社会。。",
    "start": 273.273,
    "end": 274.528,
    "duration": 1.255
  },
  {
    "id": 68,
    "text": "随后必须引用《与元九书》中界定诗歌政教功能的名言，",
    "start": 274.688,
    "end": 279.088,
    "duration": 4.4
  },
  {
    "id": 69,
    "text": "深入阐释其政治补察价值。",
    "start": 279.088,
    "end": 281.008,
    "duration": 1.92
  },
  {
    "id": 70,
    "text": "所以表述为：在《与元九书》中，他提出诗歌应当“上以补察时政，",
    "start": 281.464,
    "end": 286.904,
    "duration": 5.44
  },
  {
    "id": 71,
    "text": "下以泄导人情”，把诗歌明确定位为国家政治治理与民众情感疏导的双向利器。。",
    "start": 286.904,
    "end": 293.624,
    "duration": 6.72
  },
  {
    "id": 72,
    "text": "紧接着深入剖析诗歌本体的发生机制，",
    "start": 293.624,
    "end": 296.664,
    "duration": 3.04
  },
  {
    "id": 73,
    "text": "展现其系统的文论建构。",
    "start": 296.664,
    "end": 298.744,
    "duration": 2.08
  },
  {
    "id": 74,
    "text": "所以表述为：在诗歌生成机制上，他提炼出“根情，",
    "start": 298.744,
    "end": 303.064,
    "duration": 4.32
  },
  {
    "id": 75,
    "text": "苗言，华声，实义”的经典理论，将思想批判的“实义”确立为诗歌的终极归宿。。",
    "start": 303.064,
    "end": 309.064,
    "duration": 6.0
  },
  {
    "id": 76,
    "text": "最后一句必须指出其理论的人道主义情怀，",
    "start": 309.304,
    "end": 313.384,
    "duration": 4.08
  },
  {
    "id": 77,
    "text": "点明为民请命的核心宗旨。",
    "start": 313.384,
    "end": 315.704,
    "duration": 2.32
  },
  {
    "id": 78,
    "text": "所以表述为：他更发出“唯歌生民病，",
    "start": 315.704,
    "end": 319.224,
    "duration": 3.52
  },
  {
    "id": 79,
    "text": "愿得天子知”的博大誓言，明确了诗歌为底层黎民疾苦请命的崇高价值取向。。",
    "start": 319.224,
    "end": 326.184,
    "duration": 6.96
  },
  {
    "id": 80,
    "text": "本段答题思路总结。",
    "start": 326.184,
    "end": 327.784,
    "duration": 1.6
  },
  {
    "id": 81,
    "text": "本段以极其严密的理论逻辑展开：从为时为事的总纲起笔，",
    "start": 327.944,
    "end": 333.064,
    "duration": 5.12
  },
  {
    "id": 82,
    "text": "反拨雕琢脱离现实的颓风，引出补察时政的双向功能，",
    "start": 333.064,
    "end": 338.024,
    "duration": 4.96
  },
  {
    "id": 83,
    "text": "再深挖根情苗言华声实义的本体论，",
    "start": 338.024,
    "end": 341.304,
    "duration": 3.28
  },
  {
    "id": 84,
    "text": "最终落脚于唯歌生民病的价值归宿，",
    "start": 341.304,
    "end": 344.904,
    "duration": 3.6
  },
  {
    "id": 85,
    "text": "将白居易的诗学纲领剖析得淋漓尽致。",
    "start": 344.904,
    "end": 347.864,
    "duration": 2.96
  },
  {
    "id": 86,
    "text": "所以本段具体答题完整版为：首先，",
    "start": 348.264,
    "end": 351.624,
    "duration": 3.36
  },
  {
    "id": 87,
    "text": "白居易在理论上确立了“文章合为时而著，",
    "start": 351.624,
    "end": 354.983,
    "duration": 3.359
  },
  {
    "id": 88,
    "text": "歌诗合为事而作”的划时代主张。",
    "start": 354.983,
    "end": 357.683,
    "duration": 2.7
  },
  {
    "id": 89,
    "text": "针对六朝以来雕章琢句、脱离现实的唯美颓风，",
    "start": 357.683,
    "end": 361.629,
    "duration": 3.946
  },
  {
    "id": 90,
    "text": "白居易强调诗歌必须紧扣时代脉搏、",
    "start": 361.629,
    "end": 364.745,
    "duration": 3.116
  },
  {
    "id": 91,
    "text": "关切现实社会。",
    "start": 364.745,
    "end": 365.991,
    "duration": 1.246
  },
  {
    "id": 92,
    "text": "在《与元九书》中，他提出诗歌应当“上以补察时政，",
    "start": 365.991,
    "end": 369.937,
    "duration": 3.946
  },
  {
    "id": 93,
    "text": "下以泄导人情”，把诗歌明确定位为国家政治治理与民众情感疏导的双向利器。",
    "start": 369.937,
    "end": 376.584,
    "duration": 6.647
  },
  {
    "id": 94,
    "text": "在诗歌生成机制上，他提炼出“根情，",
    "start": 376.664,
    "end": 379.944,
    "duration": 3.28
  },
  {
    "id": 95,
    "text": "苗言，华声，实义”的经典理论，将思想批判的“实义”确立为诗歌的终极归宿。",
    "start": 379.944,
    "end": 386.664,
    "duration": 6.72
  },
  {
    "id": 96,
    "text": "他更发出“唯歌生民病，愿得天子知”的博大誓言，",
    "start": 386.664,
    "end": 391.144,
    "duration": 4.48
  },
  {
    "id": 97,
    "text": "明确了诗歌为底层黎民疾苦请命的崇高价值取向。",
    "start": 391.144,
    "end": 394.984,
    "duration": 3.84
  },
  {
    "id": 98,
    "text": "---。第",
    "start": 395.224,
    "end": 395.434,
    "duration": 0.21
  },
  {
    "id": 99,
    "text": "三部分：讽谕诗的批判锋芒与现实观照。",
    "start": 395.434,
    "end": 398.791,
    "duration": 3.357
  },
  {
    "id": 100,
    "text": "逐句因果推导与答题表述。",
    "start": 398.791,
    "end": 401.098,
    "duration": 2.307
  },
  {
    "id": 101,
    "text": "将理论推进至创作实践，首句必须概括讽谕诗在题材开拓与批判现实上的总特征。",
    "start": 401.098,
    "end": 408.231,
    "duration": 7.133
  },
  {
    "id": 102,
    "text": "所以表述为：其次，在讽谕诗的创作实践中，",
    "start": 408.231,
    "end": 411.798,
    "duration": 3.567
  },
  {
    "id": 103,
    "text": "白居易展现出直面现实矛盾的深刻批判锋芒。。",
    "start": 411.798,
    "end": 415.784,
    "duration": 3.986
  },
  {
    "id": 104,
    "text": "接着指出其诗作立足民生关怀的本质，",
    "start": 415.864,
    "end": 419.464,
    "duration": 3.6
  },
  {
    "id": 105,
    "text": "展现波澜壮阔的时代画卷。",
    "start": 419.464,
    "end": 421.544,
    "duration": 2.08
  },
  {
    "id": 106,
    "text": "所以表述为：他的讽谕诗以天下苍生为念，",
    "start": 421.912,
    "end": 425.64,
    "duration": 3.728
  },
  {
    "id": 107,
    "text": "真实记录了中唐社会阶级对立的血泪画卷。。",
    "start": 425.64,
    "end": 429.653,
    "duration": 4.013
  },
  {
    "id": 108,
    "text": "随后必须立刻调取极具考场辨识度的《秦中吟》经典诗句，",
    "start": 429.653,
    "end": 434.782,
    "duration": 5.129
  },
  {
    "id": 109,
    "text": "印证其对赋税压迫的严厉控诉。",
    "start": 434.782,
    "end": 437.681,
    "duration": 2.899
  },
  {
    "id": 110,
    "text": "所以表述为：《秦中吟》其一《重赋》直陈“私家无钱炉，",
    "start": 437.681,
    "end": 441.917,
    "duration": 4.236
  },
  {
    "id": 111,
    "text": "平地无铜山。",
    "start": 441.917,
    "end": 443.032,
    "duration": 1.115
  },
  {
    "id": 112,
    "text": "胡为秋夏税，岁岁催升合”，痛斥赋税苛繁剥削下民之苦。。",
    "start": 443.112,
    "end": 448.392,
    "duration": 5.28
  },
  {
    "id": 113,
    "text": "为了夯实论据，必须引入大众耳熟能详的千古名篇《卖炭翁》，",
    "start": 448.392,
    "end": 453.192,
    "duration": 4.8
  },
  {
    "id": 114,
    "text": "细致展开人物形象与现实批判。",
    "start": 453.192,
    "end": 455.832,
    "duration": 2.64
  },
  {
    "id": 115,
    "text": "所以表述为：《新乐府》中的经典名篇《卖炭翁》，",
    "start": 455.832,
    "end": 459.752,
    "duration": 3.92
  },
  {
    "id": 116,
    "text": "细致刻画了“满面尘灰烟黑色，两鬓苍苍十指黑”的老翁形象，",
    "start": 459.752,
    "end": 465.192,
    "duration": 5.44
  },
  {
    "id": 117,
    "text": "以“半匹红消一丈灵，系向牛头充炭直”的残酷对照，",
    "start": 465.192,
    "end": 469.752,
    "duration": 4.56
  },
  {
    "id": 118,
    "text": "将宦官“宫市”巧取豪夺的罪恶暴露无遗。。",
    "start": 469.752,
    "end": 472.952,
    "duration": 3.2
  },
  {
    "id": 119,
    "text": "尾句必须对讽谕诗的批判现实主义品质进行就地总结。",
    "start": 473.192,
    "end": 477.544,
    "duration": 4.352
  },
  {
    "id": 120,
    "text": "所以表述为：诗作真实无妄地反映了社会的深层黑暗，",
    "start": 477.544,
    "end": 481.931,
    "duration": 4.387
  },
  {
    "id": 121,
    "text": "体现出强烈的批判现实主义品格。。",
    "start": 481.931,
    "end": 484.723,
    "duration": 2.792
  },
  {
    "id": 122,
    "text": "本段答题思路总结。",
    "start": 484.723,
    "end": 486.318,
    "duration": 1.595
  },
  {
    "id": 123,
    "text": "本段聚焦现实批判的实践开掘：先立定批判锋芒总纲，",
    "start": 486.318,
    "end": 490.705,
    "duration": 4.387
  },
  {
    "id": 124,
    "text": "接着用《重赋》控诉秋夏赋税之苦，",
    "start": 490.705,
    "end": 493.297,
    "duration": 2.592
  },
  {
    "id": 125,
    "text": "再以《卖炭翁》的黑白肖像与半匹红消的残酷掠夺形成强烈戏剧张力，",
    "start": 493.297,
    "end": 498.88,
    "duration": 5.583
  },
  {
    "id": 126,
    "text": "层层剖析宫市之恶，论据极为扎实。",
    "start": 498.88,
    "end": 501.672,
    "duration": 2.792
  },
  {
    "id": 127,
    "text": "所以本段具体答题完整版为：其次，",
    "start": 501.752,
    "end": 505.112,
    "duration": 3.36
  },
  {
    "id": 128,
    "text": "在讽谕诗的创作实践中，白居易展现出直面现实矛盾的深刻批判锋芒。",
    "start": 505.112,
    "end": 511.272,
    "duration": 6.16
  },
  {
    "id": 129,
    "text": "他的讽谕诗以天下苍生为念，真实记录了中唐社会阶级对立的血泪画卷。",
    "start": 511.272,
    "end": 517.832,
    "duration": 6.56
  },
  {
    "id": 130,
    "text": "《秦中吟》其一《重赋》直陈“私家无钱炉，",
    "start": 517.832,
    "end": 521.832,
    "duration": 4.0
  },
  {
    "id": 131,
    "text": "平地无铜山。",
    "start": 521.832,
    "end": 522.792,
    "duration": 0.96
  },
  {
    "id": 132,
    "text": "胡为秋夏税，岁岁催升合”，痛斥赋税苛繁剥削下民之苦。",
    "start": 523.032,
    "end": 528.152,
    "duration": 5.12
  },
  {
    "id": 133,
    "text": "《新乐府》中的经典名篇《卖炭翁》，",
    "start": 528.152,
    "end": 530.632,
    "duration": 2.48
  },
  {
    "id": 134,
    "text": "细致刻画了“满面尘灰烟黑色，两鬓苍苍十指黑”的老翁形象，",
    "start": 530.632,
    "end": 535.592,
    "duration": 4.96
  },
  {
    "id": 135,
    "text": "以“半匹红消一丈灵，系向牛头充炭直”的残酷对照，",
    "start": 535.592,
    "end": 540.072,
    "duration": 4.48
  },
  {
    "id": 136,
    "text": "将宦官“宫市”巧取豪夺的罪恶暴露无遗。",
    "start": 540.072,
    "end": 543.192,
    "duration": 3.12
  },
  {
    "id": 137,
    "text": "诗作真实无妄地反映了社会的深层黑暗，",
    "start": 543.512,
    "end": 546.552,
    "duration": 3.04
  },
  {
    "id": 138,
    "text": "体现出强烈的批判现实主义品格。",
    "start": 546.552,
    "end": 549.032,
    "duration": 2.48
  },
  {
    "id": 139,
    "text": "--。第",
    "start": 549.192,
    "end": 549.352,
    "duration": 0.16
  },
  {
    "id": 140,
    "text": "四部分：讽谕诗的艺术结构与通俗语言。",
    "start": 549.352,
    "end": 552.872,
    "duration": 3.52
  },
  {
    "id": 141,
    "text": "逐句因果推导与答题表述。",
    "start": 552.872,
    "end": 554.952,
    "duration": 2.08
  },
  {
    "id": 142,
    "text": "题材内容确立后，论述必须深入至艺术结构与语言风格，",
    "start": 555.248,
    "end": 560.048,
    "duration": 4.8
  },
  {
    "id": 143,
    "text": "首句直接给出讽谕诗的章法与语言双重美学定性。",
    "start": 560.048,
    "end": 564.528,
    "duration": 4.48
  },
  {
    "id": 144,
    "text": "所以表述为：再次，在艺术表现上，",
    "start": 564.528,
    "end": 567.728,
    "duration": 3.2
  },
  {
    "id": 145,
    "text": "白居易讽谕诗形成了章法严整与通俗晓畅的美学风貌。。",
    "start": 567.728,
    "end": 572.848,
    "duration": 5.12
  },
  {
    "id": 146,
    "text": "紧接着必须点出新乐府讽谕诗标志性的结构法度，",
    "start": 572.848,
    "end": 577.008,
    "duration": 4.16
  },
  {
    "id": 147,
    "text": "展现其独特的文体组织方式。",
    "start": 577.008,
    "end": 579.248,
    "duration": 2.24
  },
  {
    "id": 148,
    "text": "所以表述为：在章法体制上，他践行“首句标其目，",
    "start": 579.568,
    "end": 583.962,
    "duration": 4.394
  },
  {
    "id": 149,
    "text": "卒章显其志”的结构范式。。",
    "start": 583.962,
    "end": 586.314,
    "duration": 2.352
  },
  {
    "id": 150,
    "text": "随后结合具体文本《观意麦》，精准阐释首尾呼应与结尾卒章显志的艺术机制。",
    "start": 586.314,
    "end": 593.606,
    "duration": 7.292
  },
  {
    "id": 151,
    "text": "所以表述为：诗歌题目即点明所讽主题，",
    "start": 593.606,
    "end": 597.369,
    "duration": 3.763
  },
  {
    "id": 152,
    "text": "尾句以强烈议论直接阐发讽谕主旨，",
    "start": 597.369,
    "end": 600.897,
    "duration": 3.528
  },
  {
    "id": 153,
    "text": "如《观意麦》尾联以“念此私自愧，",
    "start": 600.897,
    "end": 603.72,
    "duration": 2.823
  },
  {
    "id": 154,
    "text": "尽日不能忘”表达士大夫的反躬自省。。",
    "start": 603.72,
    "end": 607.248,
    "duration": 3.528
  },
  {
    "id": 155,
    "text": "接下来转向语言风格，引入白居易自我总结的语言三要素。",
    "start": 607.328,
    "end": 612.048,
    "duration": 4.72
  },
  {
    "id": 156,
    "text": "所以表述为：在语言风格上，他追求“其言直而切，",
    "start": 612.048,
    "end": 616.848,
    "duration": 4.8
  },
  {
    "id": 157,
    "text": "其事核而实，其体顺而肆”。。",
    "start": 616.848,
    "end": 619.968,
    "duration": 3.12
  },
  {
    "id": 158,
    "text": "最后一句必须剖析其吸收民间口语的平易特色，",
    "start": 619.968,
    "end": 623.968,
    "duration": 4.0
  },
  {
    "id": 159,
    "text": "引入著名典故点明其广泛的传播力。",
    "start": 623.968,
    "end": 626.848,
    "duration": 2.88
  },
  {
    "id": 160,
    "text": "所以表述为：白居易摆脱了古雅生僻词汇，",
    "start": 627.168,
    "end": 630.368,
    "duration": 3.2
  },
  {
    "id": 161,
    "text": "大量汲取民间生动口语，相传达到“老域能解”的极高通俗化境界，",
    "start": 630.368,
    "end": 635.968,
    "duration": 5.6
  },
  {
    "id": 162,
    "text": "极大强化了诗歌的社会传播力与道德教化力。。",
    "start": 635.968,
    "end": 639.568,
    "duration": 3.6
  },
  {
    "id": 163,
    "text": "本段答题思路总结。",
    "start": 639.568,
    "end": 641.568,
    "duration": 2.0
  },
  {
    "id": 164,
    "text": "本段深刻剖析其艺术表现特色：由首句标其目、",
    "start": 641.568,
    "end": 645.168,
    "duration": 3.6
  },
  {
    "id": 165,
    "text": "卒章显其志的结构法则切入，以《观意麦》私自愧的士大夫反思为例证，",
    "start": 645.168,
    "end": 650.288,
    "duration": 5.12
  },
  {
    "id": 166,
    "text": "随后引入言直切事核实体顺肆的语言标准，",
    "start": 650.288,
    "end": 653.648,
    "duration": 3.36
  },
  {
    "id": 167,
    "text": "最后以老域能解收束，完整展现了其艺术形式与政治传播目的的完美统一。",
    "start": 653.648,
    "end": 659.328,
    "duration": 5.68
  },
  {
    "id": 168,
    "text": "所以本段具体答题完整版为：再次，",
    "start": 659.328,
    "end": 662.256,
    "duration": 2.928
  },
  {
    "id": 169,
    "text": "在艺术表现上，白居易讽谕诗形成了章法严整与通俗晓畅的美学风貌。",
    "start": 662.256,
    "end": 668.496,
    "duration": 6.24
  },
  {
    "id": 170,
    "text": "在章法体制上，他践行“首句标其目，",
    "start": 668.496,
    "end": 672.016,
    "duration": 3.52
  },
  {
    "id": 171,
    "text": "卒章显其志”的结构范式。",
    "start": 672.016,
    "end": 674.336,
    "duration": 2.32
  },
  {
    "id": 172,
    "text": "诗歌题目即点明所讽主题，尾句以强烈议论直接阐发讽谕主旨，",
    "start": 674.336,
    "end": 680.256,
    "duration": 5.92
  },
  {
    "id": 173,
    "text": "如《观意麦》尾联以“念此私自愧，",
    "start": 680.256,
    "end": 683.296,
    "duration": 3.04
  },
  {
    "id": 174,
    "text": "尽日不能忘”表达士大夫的反躬自省。",
    "start": 683.296,
    "end": 686.336,
    "duration": 3.04
  },
  {
    "id": 175,
    "text": "在语言风格上，他追求“其言直而切，",
    "start": 686.656,
    "end": 690.336,
    "duration": 3.68
  },
  {
    "id": 176,
    "text": "其事核而实，其体顺而肆”。",
    "start": 690.336,
    "end": 693.536,
    "duration": 3.2
  },
  {
    "id": 177,
    "text": "白居易摆脱了古雅生僻词汇，大量汲取民间生动口语，",
    "start": 693.536,
    "end": 698.336,
    "duration": 4.8
  },
  {
    "id": 178,
    "text": "相传达到“老域能解”的极高通俗化境界，",
    "start": 698.336,
    "end": 702.256,
    "duration": 3.92
  },
  {
    "id": 179,
    "text": "极大强化了诗歌的社会传播力与道德教化力。",
    "start": 702.256,
    "end": 705.936,
    "duration": 3.68
  },
  {
    "id": 180,
    "text": "--。第",
    "start": 705.936,
    "end": 706.176,
    "duration": 0.24
  },
  {
    "id": 181,
    "text": "五部分：总结升华与文学史价值评析。",
    "start": 706.176,
    "end": 709.376,
    "duration": 3.2
  },
  {
    "id": 182,
    "text": "逐句因果推导与答题表述。",
    "start": 709.696,
    "end": 712.096,
    "duration": 2.4
  },
  {
    "id": 183,
    "text": "经过以上四个维度的完整展开，结尾段必须跳出个案本身，",
    "start": 712.096,
    "end": 717.056,
    "duration": 4.96
  },
  {
    "id": 184,
    "text": "以客观公正的学术眼光在文学史上确立其恒久地位。",
    "start": 717.056,
    "end": 721.936,
    "duration": 4.88
  },
  {
    "id": 185,
    "text": "所以表述为：最后，白居易的新乐府主张与讽谕诗创作树立了中国古代现实主义诗歌的不朽丰碑。。",
    "start": 721.936,
    "end": 729.696,
    "duration": 7.76
  },
  {
    "id": 186,
    "text": "第二句话需要辩证客观看待其艺术得失，",
    "start": 729.936,
    "end": 733.696,
    "duration": 3.76
  },
  {
    "id": 187,
    "text": "展现不盲从、懂辨析的高阶专业素养。",
    "start": 733.696,
    "end": 737.056,
    "duration": 3.36
  },
  {
    "id": 188,
    "text": "所以表述为：尽管其部分篇章因政治目的过强而略带议论过露之憾，",
    "start": 737.056,
    "end": 742.816,
    "duration": 5.76
  },
  {
    "id": 189,
    "text": "但他将文学创作自觉融入拯救苍生与改良时政的博大胸襟，",
    "start": 742.816,
    "end": 748.176,
    "duration": 5.36
  },
  {
    "id": 190,
    "text": "深刻启迪了宋代欧阳修、王安石、苏轼等诗文革新运动名家，",
    "start": 748.176,
    "end": 753.696,
    "duration": 5.52
  },
  {
    "id": 191,
    "text": "成为中国文人忧国恤民精神传统的最强音。。",
    "start": 753.696,
    "end": 757.376,
    "duration": 3.68
  },
  {
    "id": 192,
    "text": "本段答题思路总结。",
    "start": 757.696,
    "end": 759.536,
    "duration": 1.84
  },
  {
    "id": 193,
    "text": "本段以沉稳辩证的学术视野收官：首句确立现实主义丰碑地位，",
    "start": 759.536,
    "end": 765.056,
    "duration": 5.52
  },
  {
    "id": 194,
    "text": "次句既指出议论过露的文体特征，又高度肯定其拯救苍生的政治胸襟，",
    "start": 765.056,
    "end": 770.976,
    "duration": 5.92
  },
  {
    "id": 195,
    "text": "并纵向打通北宋诗文革新运动脉络，",
    "start": 770.976,
    "end": 774.096,
    "duration": 3.12
  },
  {
    "id": 196,
    "text": "结构宏正，余韵悠长。",
    "start": 774.096,
    "end": 776.336,
    "duration": 2.24
  },
  {
    "id": 197,
    "text": "所以本段具体答题完整版为：最后，",
    "start": 776.336,
    "end": 779.456,
    "duration": 3.12
  },
  {
    "id": 198,
    "text": "白居易的新乐府主张与讽谕诗创作树立了中国古代现实主义诗歌的不朽丰碑。",
    "start": 779.456,
    "end": 786.176,
    "duration": 6.72
  },
  {
    "id": 199,
    "text": "尽管其部分篇章因政治目的过强而略带议论过露之憾，",
    "start": 786.176,
    "end": 791.216,
    "duration": 5.04
  },
  {
    "id": 200,
    "text": "但他将文学创作自觉融入拯救苍生与改良时政的博大胸襟，",
    "start": 791.216,
    "end": 796.576,
    "duration": 5.36
  },
  {
    "id": 201,
    "text": "深刻启迪了宋代欧阳修、王安石、苏轼等诗文革新运动名家，",
    "start": 796.576,
    "end": 802.096,
    "duration": 5.52
  },
  {
    "id": 202,
    "text": "成为中国文人忧国恤民精神传统的最强音。",
    "start": 802.096,
    "end": 805.696,
    "duration": 3.6
  },
  {
    "id": 203,
    "text": "---。篇",
    "start": 805.936,
    "end": 806.131,
    "duration": 0.195
  },
  {
    "id": 204,
    "text": "尾：整道大题的内在逻辑链总括。",
    "start": 806.131,
    "end": 808.665,
    "duration": 2.534
  },
  {
    "id": 205,
    "text": "为了便于考生在脑海中建立极速调取机制，",
    "start": 808.665,
    "end": 812.173,
    "duration": 3.508
  },
  {
    "id": 206,
    "text": "整道大题的论证逻辑可提炼为如下不可逆的六步链条：一、",
    "start": 812.173,
    "end": 817.2,
    "duration": 5.027
  },
  {
    "id": 207,
    "text": "诗学定位：开篇直接以中唐新乐府运动领袖定性，",
    "start": 817.2,
    "end": 821.04,
    "duration": 3.84
  },
  {
    "id": 208,
    "text": "承接杜甫诗史传统与《与元九书》现实主义纲领。",
    "start": 821.04,
    "end": 824.88,
    "duration": 3.84
  },
  {
    "id": 209,
    "text": "二、理论纲领：标举“文章合为时而著，",
    "start": 824.88,
    "end": 828.249,
    "duration": 3.369
  },
  {
    "id": 210,
    "text": "歌诗合为事而作”，拆解补察时政、",
    "start": 828.249,
    "end": 830.977,
    "duration": 2.728
  },
  {
    "id": 211,
    "text": "根情苗言华声实义与唯歌生民病。",
    "start": 830.977,
    "end": 833.915,
    "duration": 2.938
  },
  {
    "id": 212,
    "text": "三、现实批判：以天下苍生为念，举《重赋》揭露苛捐杂税，",
    "start": 833.915,
    "end": 838.322,
    "duration": 4.407
  },
  {
    "id": 213,
    "text": "举《卖炭翁》宫市掠夺痛斥阶级压迫黑暗。",
    "start": 838.322,
    "end": 841.68,
    "duration": 3.358
  },
  {
    "id": 214,
    "text": "四、章法范式：阐述“首句标其目，",
    "start": 841.84,
    "end": 845.52,
    "duration": 3.68
  },
  {
    "id": 215,
    "text": "卒章显其志”的结构法度，以《观意麦》展现士大夫的自省议论。",
    "start": 845.52,
    "end": 850.24,
    "duration": 4.72
  },
  {
    "id": 216,
    "text": "五、通俗语言：遵循言直事核体顺标准，",
    "start": 850.24,
    "end": 853.92,
    "duration": 3.68
  },
  {
    "id": 217,
    "text": "吸收民间口语达到老域能解境界，强化政教功能与社会传播力。",
    "start": 853.92,
    "end": 859.36,
    "duration": 5.44
  },
  {
    "id": 218,
    "text": "六、历史闭环：辩证指出议论过露特点，",
    "start": 859.36,
    "end": 863.2,
    "duration": 3.84
  },
  {
    "id": 219,
    "text": "总结其对北宋欧阳修、苏轼诗文革新运动的深远启迪与忧民精神传承。",
    "start": 863.2,
    "end": 869.04,
    "duration": 5.84
  }
]