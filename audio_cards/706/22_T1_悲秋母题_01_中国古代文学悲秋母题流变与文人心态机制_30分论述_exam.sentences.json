[
  {
    "id": 1,
    "text": "题型，三十分论述题。",
    "start": 0.08,
    "end": 1.936,
    "duration": 1.856
  },
  {
    "id": 2,
    "text": "分值，三十分。",
    "start": 1.936,
    "end": 3.09,
    "duration": 1.154
  },
  {
    "id": 3,
    "text": "建议考场时间，三十五分钟。",
    "start": 3.09,
    "end": 5.629,
    "duration": 2.539
  },
  {
    "id": 4,
    "text": "目标字数，一千一百五十到一千三百字。",
    "start": 5.629,
    "end": 9.322,
    "duration": 3.693
  },
  {
    "id": 5,
    "text": "答题骨架，原型母题定性、趋近于、",
    "start": 9.322,
    "end": 12.323,
    "duration": 3.001
  },
  {
    "id": 6,
    "text": "先秦两汉“悲秋”发端与原初范式建构、",
    "start": 12.323,
    "end": 15.785,
    "duration": 3.462
  },
  {
    "id": 7,
    "text": "趋近于、汉魏六朝生命觉醒与乱世感伤深化、",
    "start": 15.785,
    "end": 19.94,
    "duration": 4.155
  },
  {
    "id": 8,
    "text": "趋近于、唐宋诗词时代关切与史诗气象集大成、",
    "start": 19.94,
    "end": 24.325,
    "duration": 4.385
  },
  {
    "id": 9,
    "text": "趋近于、文人文化心理机制深析与宏观升华。",
    "start": 24.325,
    "end": 28.48,
    "duration": 4.155
  },
  {
    "id": 10,
    "text": "“悲秋”是中国古典文学中最具代表性且生生不息的抒情原型母题。",
    "start": 28.48,
    "end": 34.171,
    "duration": 5.691
  },
  {
    "id": 11,
    "text": "从战国楚辞中草木摇落的个体愧叹，",
    "start": 34.171,
    "end": 37.333,
    "duration": 3.162
  },
  {
    "id": 12,
    "text": "演进为汉魏六朝的生死叩问，再至唐宋诗词熔铸国家兴亡的沉郁史诗，",
    "start": 37.333,
    "end": 43.446,
    "duration": 6.113
  },
  {
    "id": 13,
    "text": "“悲秋”深刻折射了中国古代士人面对自然时序更迭、",
    "start": 43.446,
    "end": 47.872,
    "duration": 4.426
  },
  {
    "id": 14,
    "text": "社会政治逆境与生命有限性时的精神震颤与心理建构。",
    "start": 47.872,
    "end": 52.72,
    "duration": 4.848
  },
  {
    "id": 15,
    "text": "第一，在先秦两汉时期，宋玉《九辩》开创了中国文学“悲秋”母题的原型范式，",
    "start": 52.8,
    "end": 59.76,
    "duration": 6.96
  },
  {
    "id": 16,
    "text": "奠定了感伤自然与身世漂泊的心理联结。",
    "start": 59.76,
    "end": 63.44,
    "duration": 3.68
  },
  {
    "id": 17,
    "text": "宋玉在《九辩》开篇高吟“悲哉秋之为气也！",
    "start": 63.44,
    "end": 67.04,
    "duration": 3.6
  },
  {
    "id": 18,
    "text": "萧瑟兮草木摇落而变衰”，将自然界秋风萧瑟、",
    "start": 67.04,
    "end": 71.2,
    "duration": 4.16
  },
  {
    "id": 19,
    "text": "草木凋零的客观物候，与士人失意落魄、",
    "start": 71.2,
    "end": 74.56,
    "duration": 3.36
  },
  {
    "id": 20,
    "text": "羁旅无依的主观生存境遇深度通感。",
    "start": 74.56,
    "end": 77.44,
    "duration": 2.88
  },
  {
    "id": 21,
    "text": "这一开创性发现，确立了“草木衰变”与“美人迟暮”、",
    "start": 77.76,
    "end": 82.4,
    "duration": 4.64
  },
  {
    "id": 22,
    "text": "“贫士失职”相互映射的原初范式。",
    "start": 82.4,
    "end": 85.68,
    "duration": 3.28
  },
  {
    "id": 23,
    "text": "汉代刘彻在《秋风辞》中以“秋风起兮白云飞，",
    "start": 85.68,
    "end": 89.84,
    "duration": 4.16
  },
  {
    "id": 24,
    "text": "草木黄落兮雁南归”起笔，继而生发“少壮几时兮奈老何”的慨叹，",
    "start": 89.84,
    "end": 96.08,
    "duration": 6.24
  },
  {
    "id": 25,
    "text": "将秋景自然流转与帝王将相亦无法逃脱的衰老焦虑紧密相连，",
    "start": 96.08,
    "end": 101.76,
    "duration": 5.68
  },
  {
    "id": 26,
    "text": "进一步强化了悲秋母题的生命哲学维度。",
    "start": 101.76,
    "end": 105.04,
    "duration": 3.28
  },
  {
    "id": 27,
    "text": "第二，在魏晋南北朝时期，随着个体生命意识的觉醒与频繁的政治动荡，",
    "start": 105.344,
    "end": 111.504,
    "duration": 6.16
  },
  {
    "id": 28,
    "text": "“悲秋”母题由纯粹的身世感愧深化为对普遍生命困境的深沉探寻。",
    "start": 111.504,
    "end": 117.744,
    "duration": 6.24
  },
  {
    "id": 29,
    "text": "曹丕在《燕歌行》中写下“秋风萧瑟天气凉，",
    "start": 117.744,
    "end": 121.344,
    "duration": 3.6
  },
  {
    "id": 30,
    "text": "草木摇落露为霜”，借秋夜寒霜衬托规中思妇对征夫的绵长思念，",
    "start": 121.344,
    "end": 127.104,
    "duration": 5.76
  },
  {
    "id": 31,
    "text": "使悲秋与游子征妇离乱相交织。",
    "start": 127.104,
    "end": 130.144,
    "duration": 3.04
  },
  {
    "id": 32,
    "text": "陆机在《文赋》中提炼出“悲落叶于劲秋，",
    "start": 130.384,
    "end": 133.904,
    "duration": 3.52
  },
  {
    "id": 33,
    "text": "喜柔条于芳春”的美学通则，从文体学与创作心理学高度确立了物我感应的艺术规律。",
    "start": 133.904,
    "end": 141.904,
    "duration": 8.0
  },
  {
    "id": 34,
    "text": "此期士人在战火连绵与政权更迭的动荡中，",
    "start": 141.904,
    "end": 145.424,
    "duration": 3.52
  },
  {
    "id": 35,
    "text": "面对秋霜落木，更深刻地体认到生命短促如朝露，",
    "start": 145.424,
    "end": 150.224,
    "duration": 4.8
  },
  {
    "id": 36,
    "text": "使悲秋母题浸染上魏晋文人特有的清峻感伤与精神焦虑。",
    "start": 150.224,
    "end": 155.424,
    "duration": 5.2
  },
  {
    "id": 37,
    "text": "第三，在唐宋诗词发展高峰期，“悲秋”母题实现了从个体身世抒情向熔铸国家命运与历史兴亡的崇高跃迁。",
    "start": 155.664,
    "end": 165.424,
    "duration": 9.76
  },
  {
    "id": 38,
    "text": "杜甫在安史之乱后的晚年漂泊中，将儒家家国情怀彻底注入悲秋意象。",
    "start": 165.424,
    "end": 171.184,
    "duration": 5.76
  },
  {
    "id": 39,
    "text": "其在夔州所作七律名作《登高》中，",
    "start": 171.184,
    "end": 173.984,
    "duration": 2.8
  },
  {
    "id": 40,
    "text": "以“无边落木萧萧下，不尽长江滚滚来”的雄阔时空对仗，",
    "start": 173.984,
    "end": 179.344,
    "duration": 5.36
  },
  {
    "id": 41,
    "text": "将自然的肃杀秋气与个人“万里悲秋常作客，",
    "start": 179.344,
    "end": 183.504,
    "duration": 4.16
  },
  {
    "id": 42,
    "text": "百年多病独登台”的穷愁衰病浑然熔铸，",
    "start": 183.504,
    "end": 187.344,
    "duration": 3.84
  },
  {
    "id": 43,
    "text": "更深沉关涉国家兵戈未息的时代苦难，",
    "start": 187.344,
    "end": 190.704,
    "duration": 3.36
  },
  {
    "id": 44,
    "text": "将悲秋的崇高感与史诗性推至巅峰。",
    "start": 190.704,
    "end": 193.664,
    "duration": 2.96
  },
  {
    "id": 45,
    "text": "其《秋兴八首》更是借夔州秋声秋色，",
    "start": 193.904,
    "end": 197.424,
    "duration": 3.52
  },
  {
    "id": 46,
    "text": "回望长安盛衰，寄托着刻骨铭心的家国兴亡感慨。",
    "start": 197.424,
    "end": 201.664,
    "duration": 4.24
  },
  {
    "id": 47,
    "text": "到了宋代，辛弃疾在《丑奴儿•书博山道中壁》中反思“少年不识愁滋味，",
    "start": 201.664,
    "end": 208.224,
    "duration": 6.56
  },
  {
    "id": 48,
    "text": "爱上层楼。",
    "start": 208.224,
    "end": 209.264,
    "duration": 1.04
  },
  {
    "id": 49,
    "text": "为赋新词强说愁”，直至历经磨难后“而今识尽愁滋味，",
    "start": 209.264,
    "end": 214.384,
    "duration": 5.12
  },
  {
    "id": 50,
    "text": "欲说还休。",
    "start": 214.384,
    "end": 215.264,
    "duration": 0.88
  },
  {
    "id": 51,
    "text": "却道天凉好个秋”，将悲秋升华为阅尽沧桑后的沉稳内敛与含蓄蕴藉。",
    "start": 215.664,
    "end": 222.304,
    "duration": 6.64
  },
  {
    "id": 52,
    "text": "第四，从文化心理机制深层审视，“悲秋”母题生生不息的内在动力根植于中国传统“天人合一”的思维模式与儒家士人的用世伦理。",
    "start": 222.608,
    "end": 233.408,
    "duration": 10.8
  },
  {
    "id": 53,
    "text": "一方面，农耕文明中四季更替与生命节律高度契合，",
    "start": 233.408,
    "end": 237.808,
    "duration": 4.4
  },
  {
    "id": 54,
    "text": "秋季万物萧索引发了文人对肉体衰亡与岁月流逝的普遍焦虑。",
    "start": 237.808,
    "end": 242.448,
    "duration": 4.64
  },
  {
    "id": 55,
    "text": "另一方面，儒家士大夫怀抱强烈的建功立业热忱与济世理想，",
    "start": 242.688,
    "end": 248.128,
    "duration": 5.44
  },
  {
    "id": 56,
    "text": "面对仕途坎坷与政治放逐，秋令肃杀往往激发起“功业未成身先老”的深沉挫折感。",
    "start": 248.128,
    "end": 255.808,
    "duration": 7.68
  },
  {
    "id": 57,
    "text": "在“物色之动，心亦摇焉”的情感震颤中，",
    "start": 255.808,
    "end": 258.928,
    "duration": 3.12
  },
  {
    "id": 58,
    "text": "文人借助悲秋完成了对自我生命的深层审视与崇高精神净化。",
    "start": 258.928,
    "end": 264.448,
    "duration": 5.52
  },
  {
    "id": 59,
    "text": "综上所述，中国古典文学中的“悲秋”母题历经千年演进，",
    "start": 264.688,
    "end": 269.488,
    "duration": 4.8
  },
  {
    "id": 60,
    "text": "从宋玉的贫士失职叹咏，发展至杜甫的历史忧患巨构，",
    "start": 269.488,
    "end": 274.528,
    "duration": 5.04
  },
  {
    "id": 61,
    "text": "形成了绵密丰厚的审美传统。",
    "start": 274.528,
    "end": 277.168,
    "duration": 2.64
  },
  {
    "id": 62,
    "text": "它绝非消极颓废的虚无叹息，而是中国士人面对生存困境时最庄严深沉的心灵回响与生命尊严的崇高确证。",
    "start": 277.168,
    "end": 286.528,
    "duration": 9.36
  }
]