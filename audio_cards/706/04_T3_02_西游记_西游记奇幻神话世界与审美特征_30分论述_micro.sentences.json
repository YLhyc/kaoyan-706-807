[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "由境到人、由趣到理：先看天宫妖洞为何“虽极幻却极真”，",
    "start": 0.0,
    "end": 5.6,
    "duration": 5.6
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再把“物性+神性+人性”熔于一身的孙悟空拆透，",
    "start": 5.649,
    "end": 9.489,
    "duration": 3.84
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "进而品味师徒斗嘴的游戏笔墨，",
    "start": 9.939,
    "end": 12.299,
    "duration": 2.36
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后点破“放心→定心→修心”的晚明三教心学隐喻。",
    "start": 12.749,
    "end": 17.109,
    "duration": 4.36
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《西游记》是神魔小说与浪漫主义结晶。",
    "start": 17.559,
    "end": 20.439,
    "duration": 2.88
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "吴承恩融合心学与取经传说，鲁迅《中国小说史略》指其“神魔皆有人情，",
    "start": 20.969,
    "end": 26.289,
    "duration": 5.32
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "精魅亦通世故”。",
    "start": 26.739,
    "end": 28.099,
    "duration": 1.36
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · “极幻”与“极真”相融折光现实",
    "start": 28.549,
    "end": 31.549,
    "duration": 3.0
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "天宫、地府、妖洞处处带封建官僚印记，是现实人间折光；",
    "start": 31.999,
    "end": 36.879,
    "duration": 4.88
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "天庭玉帝昏庸、判官受魏徵书信徇私；",
    "start": 37.329,
    "end": 40.649,
    "duration": 3.32
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "诸多妖魔原系仙尊坐骑童子，危急由后台领回免责；",
    "start": 41.179,
    "end": 45.779,
    "duration": 4.6
  },
  {
    "id": "sec0_step1_c2",
    "dom_key": "sec0_step1_c2",
    "text": "比丘车迟国国君昏暴道士惑政，讽明中叶皇权官场厂卫。",
    "start": 46.229,
    "end": 51.429,
    "duration": 5.2
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 塑造统一“三性”的孙悟空典型",
    "start": 51.879,
    "end": 55.119,
    "duration": 3.24
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "大闹天宫喊出“皇帝轮流做，明年到我家”反抗等级；",
    "start": 55.569,
    "end": 59.809,
    "duration": 4.24
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "取经途中历八十一难降妖除魔践行理想；",
    "start": 60.259,
    "end": 63.859,
    "duration": 3.6
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "统一“神性、人性与物性”：",
    "start": 64.309,
    "end": 66.749,
    "duration": 2.44
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "七十二变神通、毛脸猴态天真、嫉恶重情守诺人格光彩。",
    "start": 67.199,
    "end": 71.919,
    "duration": 4.72
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 童真幻想与游戏笔墨成喜剧风貌",
    "start": 72.449,
    "end": 75.929,
    "duration": 3.48
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "师徒构成绝妙喜剧反差：",
    "start": 76.379,
    "end": 78.539,
    "duration": 2.16
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "唐僧迂腐、悟空机警急躁、八戒贪吃吹牛憨厚、沙僧忠厚；",
    "start": 78.989,
    "end": 83.949,
    "duration": 4.96
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "“以戏言寓诸幻笔”：行者八戒一路插科打诨，仙佛妖魔皆如市井凡人，",
    "start": 84.479,
    "end": 90.399,
    "duration": 5.92
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "冲淡说教枯燥。",
    "start": 90.849,
    "end": 92.169,
    "duration": 1.32
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 三教合一心学寓意与修心精神隐喻",
    "start": 92.699,
    "end": 96.699,
    "duration": 4.0
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "融儒释道心学：悟空“心猿”、八戒“木母”、白龙马“意马”、“灵台方寸山，",
    "start": 97.149,
    "end": 103.069,
    "duration": 5.92
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "斜月三星洞”皆指人心；",
    "start": 103.519,
    "end": 105.759,
    "duration": 2.24
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "由大闹天宫“放心”→五行山下“定心”→西行扫心魔成佛“修心”，",
    "start": 106.209,
    "end": 111.369,
    "duration": 5.16
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "增添克欲磨志哲理厚度。",
    "start": 111.819,
    "end": 113.779,
    "duration": 1.96
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《西游记》于“极幻”神魔中灌注“极真”人情世态，塑孙悟空叛逆典型，",
    "start": 114.229,
    "end": 119.349,
    "duration": 5.12
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "以童真游戏笔墨冲淡说教、升华为“修心”寓言，树喜剧浪漫典范。",
    "start": 119.799,
    "end": 124.999,
    "duration": 5.2
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅《中国小说史略》评《西游记》“神魔皆有人情，",
    "start": 125.449,
    "end": 130.169,
    "duration": 4.72
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "精魅亦通世故”，又称其有“以戏言寓诸幻笔”的游戏谐趣；",
    "start": 130.619,
    "end": 135.219,
    "duration": 4.6
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "悟空学艺在西牛贺洲“灵台方寸山，斜月三星洞”（非花果山）。",
    "start": 135.749,
    "end": 141.149,
    "duration": 5.4
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 鲁迅对《西游记》人情与谐趣的两句权威评价各是什么？",
    "start": 141.599,
    "end": 147.159,
    "duration": 5.56
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 怎样分析孙悟空“物性、神性、人性”统一与师徒四人的喜剧配置？",
    "start": 147.609,
    "end": 154.089,
    "duration": 6.48
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 说出“心猿/木母/意马/斜月三星洞”的心学暗指及“放心—定心—修心”弧线？",
    "start": 154.539,
    "end": 162.539,
    "duration": 8.0
  }
]