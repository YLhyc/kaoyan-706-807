[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《西游记》·奇幻神话世界与审美特征",
    "start": 0.134,
    "end": 3.271,
    "duration": 3.137
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "由境到人、由趣到理：先看天宫妖洞为何“虽极幻却极真”，",
    "start": 3.847,
    "end": 9.81,
    "duration": 5.962
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再把“物性+神性+人性”熔于一身的孙悟空拆透，进而品味师徒斗嘴的游戏笔墨，",
    "start": 9.993,
    "end": 16.45,
    "duration": 6.457
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后点破“放心→定心→修心”的晚明三教心学隐喻。",
    "start": 16.551,
    "end": 20.613,
    "duration": 4.061
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《西游记》是神魔小说与浪漫主义结晶。",
    "start": 21.2,
    "end": 24.389,
    "duration": 3.189
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "吴承恩融合心学与取经传说，鲁迅《中国小说史略》指其“神魔皆有人情，精魅亦通世故”。",
    "start": 24.963,
    "end": 32.696,
    "duration": 7.733
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · “极幻”与“极真”相融折光现实",
    "start": 33.283,
    "end": 36.628,
    "duration": 3.345
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "天宫、地府、妖洞处处带封建官僚印记，是现实人间折光；",
    "start": 37.215,
    "end": 43.712,
    "duration": 6.496
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "天庭玉帝昏庸、判官受魏徵书信徇私；",
    "start": 44.286,
    "end": 49.18,
    "duration": 4.895
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "诸多妖魔原系仙尊坐骑童子，危急由后台领回免责；",
    "start": 49.468,
    "end": 54.258,
    "duration": 4.791
  },
  {
    "id": "sec0_step1_c2",
    "dom_key": "sec0_step1_c2",
    "text": "比丘车迟国国君昏暴道士惑政，讽明中叶皇权官场厂卫。",
    "start": 54.559,
    "end": 59.831,
    "duration": 5.272
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 塑造统一“三性”的孙悟空典型",
    "start": 60.392,
    "end": 63.529,
    "duration": 3.137
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "大闹天宫喊出“皇帝轮流做，明年到我家”反抗等级；取经途中历八十一难降妖除魔践行理想；",
    "start": 64.103,
    "end": 74.219,
    "duration": 10.116
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "统一“神性、人性与物性”：七十二变神通、毛脸猴态天真、嫉恶重情守诺人格光彩。",
    "start": 74.793,
    "end": 83.269,
    "duration": 8.476
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 童真幻想与游戏笔墨成喜剧风貌",
    "start": 83.843,
    "end": 87.631,
    "duration": 3.788
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "师徒构成绝妙喜剧反差：唐僧迂腐、悟空机警急躁、八戒贪吃吹牛憨厚、沙僧忠厚；",
    "start": 88.218,
    "end": 96.693,
    "duration": 8.476
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "“以戏言寓诸幻笔”：行者八戒一路插科打诨，仙佛妖魔皆如市井凡人，冲淡说教枯燥。",
    "start": 97.28,
    "end": 105.535,
    "duration": 8.254
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 三教合一心学寓意与修心精神隐喻",
    "start": 106.121,
    "end": 110.495,
    "duration": 4.374
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "融儒释道心学：悟空“心猿”、八戒“木母”、白龙马“意马”、“灵台方寸山，斜月三星洞”皆指人心；",
    "start": 111.082,
    "end": 119.936,
    "duration": 8.853
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "由大闹天宫“放心”→五行山下“定心”→西行扫心魔成佛“修心”，增添克欲磨志哲理厚度。",
    "start": 120.523,
    "end": 129.779,
    "duration": 9.257
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《西游记》于“极幻”神魔中灌注“极真”人情世态，塑孙悟空叛逆典型，",
    "start": 130.366,
    "end": 135.938,
    "duration": 5.572
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "以童真游戏笔墨冲淡说教、升华为“修心”寓言，树喜剧浪漫典范。",
    "start": 136.148,
    "end": 142.149,
    "duration": 6.002
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅《中国小说史略》评《西游记》“神魔皆有人情，精魅亦通世故”，",
    "start": 142.736,
    "end": 149.037,
    "duration": 6.301
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "又称其有“以戏言寓诸幻笔”的游戏谐趣；",
    "start": 149.233,
    "end": 152.553,
    "duration": 3.319
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "悟空学艺在西牛贺洲“灵台方寸山，斜月三星洞”（非花果山）。",
    "start": 152.957,
    "end": 158.399,
    "duration": 5.442
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 鲁迅对《西游记》人情与谐趣的两句权威评价各是什么？",
    "start": 158.973,
    "end": 164.897,
    "duration": 5.923
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 怎样分析孙悟空“物性、神性、人性”统一与师徒四人的喜剧配置？",
    "start": 165.47,
    "end": 172.488,
    "duration": 7.017
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 说出“心猿/木母/意马/斜月三星洞”的心学暗指及“放心—定心—修心”弧线？",
    "start": 173.062,
    "end": 181.147,
    "duration": 8.085
  }
]