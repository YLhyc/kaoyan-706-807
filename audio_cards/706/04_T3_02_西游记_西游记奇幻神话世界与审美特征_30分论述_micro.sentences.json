[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《西游记》·奇幻神话世界与审美特征",
    "start": 0.354,
    "end": 3.366,
    "duration": 3.012
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "由境到人、由趣到理：先看天宫妖洞为何“虽极幻却极真”，",
    "start": 4.374,
    "end": 11.226,
    "duration": 6.852
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再把“物性+神性+人性”熔于一身的孙悟空拆透，进而品味师徒斗嘴的游戏笔墨，",
    "start": 11.494,
    "end": 17.906,
    "duration": 6.412
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后点破“放心→定心→修心”的晚明三教心学隐喻。",
    "start": 18.254,
    "end": 22.626,
    "duration": 4.372
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《西游记》是神魔小说与浪漫主义结晶。",
    "start": 23.594,
    "end": 26.566,
    "duration": 2.972
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "吴承恩融合心学与取经传说，鲁迅《中国小说史略》指其“神魔皆有人情，精魅亦通世故”。",
    "start": 27.534,
    "end": 34.906,
    "duration": 7.372
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · “极幻”与“极真”相融折光现实",
    "start": 35.834,
    "end": 39.526,
    "duration": 3.692
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "天宫、地府、妖洞处处带封建官僚印记，是现实人间折光；",
    "start": 40.574,
    "end": 46.346,
    "duration": 5.772
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "天庭玉帝昏庸、判官受魏徵书信徇私；",
    "start": 47.354,
    "end": 51.606,
    "duration": 4.252
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "诸多妖魔原系仙尊坐骑童子，危急由后台领回免责；",
    "start": 52.534,
    "end": 57.506,
    "duration": 4.972
  },
  {
    "id": "sec0_step1_c2",
    "dom_key": "sec0_step1_c2",
    "text": "比丘车迟国国君昏暴道士惑政，讽明中叶皇权官场厂卫。",
    "start": 58.514,
    "end": 64.926,
    "duration": 6.412
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 塑造统一“三性”的孙悟空典型",
    "start": 65.934,
    "end": 69.026,
    "duration": 3.092
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "大闹天宫喊出“皇帝轮流做，明年到我家”反抗等级；取经途中历八十一难降妖除魔践行理想；",
    "start": 70.114,
    "end": 81.006,
    "duration": 10.892
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "统一“神性、人性与物性”：七十二变神通、毛脸猴态天真、嫉恶重情守诺人格光彩。",
    "start": 81.534,
    "end": 91.106,
    "duration": 9.572
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 童真幻想与游戏笔墨成喜剧风貌",
    "start": 91.814,
    "end": 96.066,
    "duration": 4.252
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "师徒构成绝妙喜剧反差：唐僧迂腐、悟空机警急躁、八戒贪吃吹牛憨厚、沙僧忠厚；",
    "start": 96.854,
    "end": 105.706,
    "duration": 8.852
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "“以戏言寓诸幻笔”：行者八戒一路插科打诨，仙佛妖魔皆如市井凡人，冲淡说教枯燥。",
    "start": 106.754,
    "end": 116.406,
    "duration": 9.652
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 三教合一心学寓意与修心精神隐喻",
    "start": 117.294,
    "end": 121.586,
    "duration": 4.292
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "融儒释道心学：悟空“心猿”、八戒“木母”、白龙马“意马”、“灵台方寸山，斜月三星洞”皆指人心；",
    "start": 122.514,
    "end": 132.406,
    "duration": 9.892
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "由大闹天宫“放心”→五行山下“定心”→西行扫心魔成佛“修心”，增添克欲磨志哲理厚度。",
    "start": 133.494,
    "end": 143.666,
    "duration": 10.172
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《西游记》于“极幻”神魔中灌注“极真”人情世态，塑孙悟空叛逆典型，",
    "start": 144.714,
    "end": 149.886,
    "duration": 5.172
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "以童真游戏笔墨冲淡说教、升华为“修心”寓言，树喜剧浪漫典范。",
    "start": 150.074,
    "end": 155.726,
    "duration": 5.652
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅《中国小说史略》评《西游记》“神魔皆有人情，精魅亦通世故”，",
    "start": 156.774,
    "end": 163.546,
    "duration": 6.772
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "又称其有“以戏言寓诸幻笔”的游戏谐趣；",
    "start": 163.734,
    "end": 167.466,
    "duration": 3.732
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "悟空学艺在西牛贺洲“灵台方寸山，斜月三星洞”（非花果山）。",
    "start": 168.434,
    "end": 173.966,
    "duration": 5.532
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 鲁迅对《西游记》人情与谐趣的两句权威评价各是什么？",
    "start": 174.934,
    "end": 180.866,
    "duration": 5.932
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 怎样分析孙悟空“物性、神性、人性”统一与师徒四人的喜剧配置？",
    "start": 181.794,
    "end": 188.246,
    "duration": 6.452
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 说出“心猿/木母/意马/斜月三星洞”的心学暗指及“放心—定心—修心”弧线？",
    "start": 189.214,
    "end": 198.186,
    "duration": 8.972
  }
]