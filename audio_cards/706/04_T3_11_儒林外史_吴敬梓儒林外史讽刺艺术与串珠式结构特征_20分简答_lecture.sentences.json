[
  {
    "id": 1,
    "text": "简述吴敬梓《儒林外史》的讽刺艺术与串珠式结构特征。",
    "start": 0.0,
    "end": 5.125,
    "duration": 5.125
  },
  {
    "id": 2,
    "text": "吴敬梓的 《儒林外史》 是中国古典长篇小说中讽刺艺术的最高峰，",
    "start": 5.125,
    "end": 10.413,
    "duration": 5.288
  },
  {
    "id": 3,
    "text": "标志着古代长篇讽刺小说文体的完全成熟。",
    "start": 10.413,
    "end": 14.071,
    "duration": 3.658
  },
  {
    "id": 4,
    "text": "面对清代八股取士制度对知识分子灵魂的摧残与士林道德的堕落，",
    "start": 14.071,
    "end": 19.866,
    "duration": 5.795
  },
  {
    "id": 5,
    "text": "吴敬梓以冷峻清醒的眼光，勾勒了一幅广阔的士林百丑图。",
    "start": 19.866,
    "end": 24.776,
    "duration": 4.91
  },
  {
    "id": 6,
    "text": "鲁迅在 《中国小说史略》 中评价其 “秉持公心，",
    "start": 24.776,
    "end": 27.416,
    "duration": 2.64
  },
  {
    "id": 7,
    "text": "指摘时病，机锋所向，尤在士林……其感受之速，分析之微，",
    "start": 27.416,
    "end": 33.234,
    "duration": 5.818
  },
  {
    "id": 8,
    "text": "卓越而不可及”。",
    "start": 33.234,
    "end": 34.644,
    "duration": 1.41
  },
  {
    "id": 9,
    "text": "《儒林外史》 的讽刺艺术与文体结构，",
    "start": 34.644,
    "end": 40.026,
    "duration": 5.382
  },
  {
    "id": 10,
    "text": "主要展现为以下三个核心维度：",
    "start": 40.026,
    "end": 43.868,
    "duration": 3.842
  },
  {
    "id": 11,
    "text": "第一，开创客观白描与反讽对比的讽刺艺术，达到“戚而能谐，",
    "start": 43.868,
    "end": 50.734,
    "duration": 6.866
  },
  {
    "id": 12,
    "text": "婉而多讽”的高超境界。",
    "start": 50.734,
    "end": 52.306,
    "duration": 1.572
  },
  {
    "id": 13,
    "text": "《儒林外史》 彻底摆脱了此前讽刺文学直接谩骂或粗暴说教的弊端，",
    "start": 52.306,
    "end": 54.943,
    "duration": 2.637
  },
  {
    "id": 14,
    "text": "采用纯粹客观的生活细节描写，",
    "start": 54.943,
    "end": 59.675,
    "duration": 4.732
  },
  {
    "id": 15,
    "text": "让讽刺对象在言行自相矛盾中暴露出可笑可悲的本质。",
    "start": 59.675,
    "end": 64.249,
    "duration": 4.574
  },
  {
    "id": 16,
    "text": "例如写严监生临终前因见灯盏里点着两茎灯草，",
    "start": 64.249,
    "end": 68.528,
    "duration": 4.279
  },
  {
    "id": 17,
    "text": "伸出两个指头迟迟不肯断气，挑掉一茎方才咽气；",
    "start": 68.528,
    "end": 73.912,
    "duration": 5.384
  },
  {
    "id": 18,
    "text": "写范进中举前受尽胡屠户掌掴唾骂，",
    "start": 73.912,
    "end": 78.25,
    "duration": 4.338
  },
  {
    "id": 19,
    "text": "中举发疯后胡屠户称其为 “文曲星下凡” 卑躬屈膝。",
    "start": 78.25,
    "end": 83.946,
    "duration": 5.696
  },
  {
    "id": 20,
    "text": "吴敬梓不加主观说教，仅以精准传神的客观白描与前后对照，",
    "start": 83.946,
    "end": 92.651,
    "duration": 8.705
  },
  {
    "id": 21,
    "text": "深刻讽刺了士人灵魂扭曲与世态炎凉。",
    "start": 92.651,
    "end": 96.275,
    "duration": 3.624
  },
  {
    "id": 22,
    "text": "第二，首创以功名富贵为核心的“串珠式”连缀结构，",
    "start": 96.275,
    "end": 100.758,
    "duration": 4.483
  },
  {
    "id": 23,
    "text": "开辟长篇叙事新格局。",
    "start": 100.758,
    "end": 102.917,
    "duration": 2.159
  },
  {
    "id": 24,
    "text": "在小说结构上，",
    "start": 102.917,
    "end": 104.261,
    "duration": 1.344
  },
  {
    "id": 25,
    "text": "《儒林外史》 突破了传统长篇小说必须由单一中心故事或主角贯穿始终的规制。",
    "start": 104.261,
    "end": 112.914,
    "duration": 8.653
  },
  {
    "id": 26,
    "text": "鲁迅概括其为 “虽云长篇，颇同短篇；各篇虽各独立，",
    "start": 112.914,
    "end": 116.931,
    "duration": 4.017
  },
  {
    "id": 27,
    "text": "而又相连结”。",
    "start": 116.931,
    "end": 118.142,
    "duration": 1.211
  },
  {
    "id": 28,
    "text": "全书以对 “功名富贵” 的态度为统摄主线，",
    "start": 118.142,
    "end": 122.128,
    "duration": 3.986
  },
  {
    "id": 29,
    "text": "前一个人物的故事刚近尾声，便引出下一个人物登场；",
    "start": 122.128,
    "end": 126.273,
    "duration": 4.145
  },
  {
    "id": 30,
    "text": "人物接力更替，如同丝线穿珠一般，将各色士人串联在一起，",
    "start": 126.273,
    "end": 129.537,
    "duration": 3.264
  },
  {
    "id": 31,
    "text": "形成了全景展现社会横断面的开放式艺术结构。",
    "start": 129.537,
    "end": 132.512,
    "duration": 2.975
  },
  {
    "id": 32,
    "text": "第三，融合悲悯情怀与理性批判，在针砭科举弊端中寄托真儒理想。",
    "start": 132.512,
    "end": 133.772,
    "duration": 1.26
  },
  {
    "id": 33,
    "text": "吴敬梓的讽刺蕴含着深沉的士人忧患意识。",
    "start": 133.772,
    "end": 136.091,
    "duration": 2.319
  },
  {
    "id": 34,
    "text": "在剖析周进、范进、马二先生等受科举扭曲戕害的士子的同时，",
    "start": 136.091,
    "end": 141.173,
    "duration": 5.082
  },
  {
    "id": 35,
    "text": "全书首尾特意安排了王冕、杜少卿、",
    "start": 141.173,
    "end": 143.399,
    "duration": 2.226
  },
  {
    "id": 36,
    "text": "庄绍光等不慕荣利的真儒贤士，",
    "start": 143.399,
    "end": 144.242,
    "duration": 0.843
  },
  {
    "id": 37,
    "text": "在辛辣讽刺现实的同时树立了人格自立的精神尺度。",
    "start": 144.242,
    "end": 150.936,
    "duration": 6.694
  }
]