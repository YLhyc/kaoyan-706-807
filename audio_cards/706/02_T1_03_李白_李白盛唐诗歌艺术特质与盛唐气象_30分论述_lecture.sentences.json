[
  {
    "id": 1,
    "text": "试论李白诗歌的艺术特质与盛唐气象。",
    "start": 0.0,
    "end": 3.845,
    "duration": 3.845
  },
  {
    "id": 2,
    "text": "李白是中国古典诗歌浪漫主义传统的最高巅峰，",
    "start": 3.845,
    "end": 7.967,
    "duration": 4.122
  },
  {
    "id": 3,
    "text": "也是 “盛唐气象” 最杰出的艺术人格代表。",
    "start": 7.967,
    "end": 11.346,
    "duration": 3.379
  },
  {
    "id": 4,
    "text": "身处开元天宝大唐国力极盛的历史节点，",
    "start": 11.346,
    "end": 14.972,
    "duration": 3.626
  },
  {
    "id": 5,
    "text": "李白承接了时代自信开放、昂扬开拓的精神底色，",
    "start": 14.972,
    "end": 18.862,
    "duration": 3.89
  },
  {
    "id": 6,
    "text": "以追求精神绝对自由的崇高傲骨，",
    "start": 18.862,
    "end": 21.693,
    "duration": 2.831
  },
  {
    "id": 7,
    "text": "将盛唐诗歌推向了飞扬奇伟的艺术极境。",
    "start": 21.693,
    "end": 25.328,
    "duration": 3.635
  },
  {
    "id": 8,
    "text": "韩愈赞其 “李杜文章在，光焰万丈长”；",
    "start": 25.328,
    "end": 29.063,
    "duration": 3.735
  },
  {
    "id": 9,
    "text": "严羽 《沧浪诗话》 称其 “如羚羊挂角，无迹可求”。",
    "start": 29.063,
    "end": 32.098,
    "duration": 3.035
  },
  {
    "id": 10,
    "text": "李白诗歌绝非孤立的书生吟咏，而是盛唐时代精神的集中审美体现。",
    "start": 32.098,
    "end": 38.911,
    "duration": 6.813
  },
  {
    "id": 11,
    "text": "其艺术特质主要展现为以下四个核心维度：",
    "start": 38.911,
    "end": 43.219,
    "duration": 4.308
  },
  {
    "id": 12,
    "text": "第一，标举追求精神自由的主体人格，",
    "start": 43.219,
    "end": 48.217,
    "duration": 4.998
  },
  {
    "id": 13,
    "text": "集中体现傲岸自信的时代气象。",
    "start": 48.217,
    "end": 50.57,
    "duration": 2.353
  },
  {
    "id": 14,
    "text": "李白诗歌最震撼人心的力量，在于塑造了一个傲立王侯、",
    "start": 50.57,
    "end": 55.785,
    "duration": 5.215
  },
  {
    "id": 15,
    "text": "追求绝对精神解放的抒情主人公形象。",
    "start": 55.785,
    "end": 58.568,
    "duration": 2.783
  },
  {
    "id": 16,
    "text": "在政治权贵面前，他傲岸宣告 “安能摧眉折腰事权贵，",
    "start": 58.568,
    "end": 64.663,
    "duration": 6.095
  },
  {
    "id": 17,
    "text": "使我不得开心颜”；面对仕途坎坷，",
    "start": 64.663,
    "end": 68.147,
    "duration": 3.484
  },
  {
    "id": 18,
    "text": "他始终坚信 “长风破浪会有时，直挂云帆济沧海”；",
    "start": 68.147,
    "end": 73.826,
    "duration": 5.679
  },
  {
    "id": 19,
    "text": "在狂饮痛饮之中，依然满怀 “天生我材必有用，",
    "start": 73.826,
    "end": 80.096,
    "duration": 6.27
  },
  {
    "id": 20,
    "text": "千金散尽还复来” 的豪迈自信。",
    "start": 80.096,
    "end": 82.903,
    "duration": 2.807
  },
  {
    "id": 21,
    "text": "李白将道家的神仙求索、",
    "start": 82.903,
    "end": 85.934,
    "duration": 3.031
  },
  {
    "id": 22,
    "text": "纵横家的建功立业与儒家的济世抱负融为一体；",
    "start": 85.934,
    "end": 91.179,
    "duration": 5.245
  },
  {
    "id": 23,
    "text": "这种强烈的自我确信与英雄气概，正是盛唐士人昂扬奋进、",
    "start": 91.179,
    "end": 95.93,
    "duration": 4.751
  },
  {
    "id": 24,
    "text": "开阔自信时代脉搏的最高艺术凝结。",
    "start": 95.93,
    "end": 100.482,
    "duration": 4.552
  },
  {
    "id": 25,
    "text": "第二，展开吞吐宇宙的奇幻想象与宏大夸张，",
    "start": 100.482,
    "end": 107.838,
    "duration": 7.356
  },
  {
    "id": 26,
    "text": "构筑雄奇壮伟的意境空间。",
    "start": 107.838,
    "end": 110.747,
    "duration": 2.909
  },
  {
    "id": 27,
    "text": "在艺术表现上，",
    "start": 110.747,
    "end": 112.515,
    "duration": 1.768
  },
  {
    "id": 28,
    "text": "李白善于运用极其大胆的夸张与变幻莫测的时空想象，",
    "start": 112.515,
    "end": 113.828,
    "duration": 1.313
  },
  {
    "id": 29,
    "text": "营造飞腾奇崛的审美境界。",
    "start": 113.828,
    "end": 116.014,
    "duration": 2.186
  },
  {
    "id": 30,
    "text": "他常常突破人间现实的物理边界，自由驱遣神话传说与日月星辰。",
    "start": 116.014,
    "end": 123.139,
    "duration": 7.125
  },
  {
    "id": 31,
    "text": "在 《梦游天姥吟留别》 中，以 “天姥连天向天横，",
    "start": 123.139,
    "end": 126.435,
    "duration": 3.296
  },
  {
    "id": 32,
    "text": "势拔五岳掩赤城” 的宏阔巨笔开篇，随即展开青冥浩荡、",
    "start": 126.435,
    "end": 133.575,
    "duration": 7.14
  },
  {
    "id": 33,
    "text": "神仙列坐的绚烂幻境；在 《蜀道难》 中，",
    "start": 133.575,
    "end": 138.099,
    "duration": 4.524
  },
  {
    "id": 34,
    "text": "以 “上有六龙回日之高标，",
    "start": 138.099,
    "end": 141.275,
    "duration": 3.176
  },
  {
    "id": 35,
    "text": "下有冲波逆折之回川” 的极致夸张，",
    "start": 141.275,
    "end": 145.697,
    "duration": 4.422
  },
  {
    "id": 36,
    "text": "将自然险阻升华为一种令人战栗的壮美奇观；",
    "start": 145.697,
    "end": 150.308,
    "duration": 4.611
  },
  {
    "id": 37,
    "text": "他写愁思为 “白发三千丈”，",
    "start": 150.308,
    "end": 154.195,
    "duration": 3.887
  },
  {
    "id": 38,
    "text": "写飞瀑为 “疑是银河落九天”。",
    "start": 154.195,
    "end": 157.084,
    "duration": 2.889
  },
  {
    "id": 39,
    "text": "这种汪洋恣肆的浪漫想象，",
    "start": 157.084,
    "end": 159.668,
    "duration": 2.584
  },
  {
    "id": 40,
    "text": "展现出不可羁绊的才情与蓬勃的盛唐艺术魄力。",
    "start": 159.668,
    "end": 163.13,
    "duration": 3.462
  },
  {
    "id": 41,
    "text": "第三，打破近体声律拘牵，以长短歌行与古题乐府开辟抒情长河。",
    "start": 163.13,
    "end": 169.556,
    "duration": 6.426
  },
  {
    "id": 42,
    "text": "李白并不热衷于齐梁沈宋以来讲究粘对对仗的近体律诗，",
    "start": 169.556,
    "end": 175.172,
    "duration": 5.616
  },
  {
    "id": 43,
    "text": "而是将主要创造力倾注于抒情空间更为自由的古题乐府与古体歌行。",
    "start": 175.172,
    "end": 180.435,
    "duration": 5.263
  },
  {
    "id": 44,
    "text": "他继承汉魏乐府精神，借古题以抒写当代豪情。",
    "start": 180.435,
    "end": 186.081,
    "duration": 5.646
  },
  {
    "id": 45,
    "text": "《将进酒》《行路难》 等篇章，句式由三言、五言、",
    "start": 186.081,
    "end": 191.542,
    "duration": 5.461
  },
  {
    "id": 46,
    "text": "七言直至杂言自由变换，如大河奔涌、一泻千里；",
    "start": 191.542,
    "end": 195.887,
    "duration": 4.345
  },
  {
    "id": 47,
    "text": "其诗歌节奏随情感起伏而骤起骤落，",
    "start": 195.887,
    "end": 199.109,
    "duration": 3.222
  },
  {
    "id": 48,
    "text": "完全打破了音律的死板节拍，呈现出天马行空、",
    "start": 199.109,
    "end": 203.087,
    "duration": 3.978
  },
  {
    "id": 49,
    "text": "行云流水的纯自然之美，实践了其倡导的 “清水出芙蓉，",
    "start": 203.087,
    "end": 209.472,
    "duration": 6.385
  },
  {
    "id": 50,
    "text": "天然去雕饰” 的至高美学追求。",
    "start": 209.472,
    "end": 213.099,
    "duration": 3.627
  },
  {
    "id": 51,
    "text": "第四，创造兼备豪放与清新的双重美学品格，",
    "start": 213.099,
    "end": 216.193,
    "duration": 3.094
  },
  {
    "id": 52,
    "text": "确立古典浪漫主义的万代宗师地位。",
    "start": 216.193,
    "end": 218.887,
    "duration": 2.694
  },
  {
    "id": 53,
    "text": "李白之诗绝非仅有豪放狂飙，其诗风同样兼备空灵澄澈的清新俊逸。",
    "start": 218.887,
    "end": 220.098,
    "duration": 1.211
  },
  {
    "id": 54,
    "text": "在七言绝句中，他以炉火纯青的天然之笔，",
    "start": 220.098,
    "end": 222.602,
    "duration": 2.504
  },
  {
    "id": 55,
    "text": "写下 《早发白帝城》 的轻舟顺流与 《望庐山瀑布》 的紫烟日照；",
    "start": 222.602,
    "end": 226.143,
    "duration": 3.541
  },
  {
    "id": 56,
    "text": "在五言古诗中，写下 《静夜思》 的纯净真挚。",
    "start": 226.143,
    "end": 227.808,
    "duration": 1.665
  },
  {
    "id": 57,
    "text": "李白将豪迈奔放与清新飘逸圆融统一，",
    "start": 227.808,
    "end": 228.941,
    "duration": 1.133
  },
  {
    "id": 58,
    "text": "与杜甫的沉郁顿挫双峰并峙，",
    "start": 228.941,
    "end": 230.8,
    "duration": 1.859
  },
  {
    "id": 59,
    "text": "共同确立了唐代诗歌无可逾越的双子星座，",
    "start": 230.8,
    "end": 232.723,
    "duration": 1.923
  },
  {
    "id": 60,
    "text": "成为后世历代浪漫主义诗人的精神航标。",
    "start": 232.723,
    "end": 235.618,
    "duration": 2.895
  }
]