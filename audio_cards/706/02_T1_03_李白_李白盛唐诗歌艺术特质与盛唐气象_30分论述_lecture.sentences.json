[
  {
    "id": 1,
    "text": "试论李白诗歌的艺术特质与盛唐气象。",
    "start": 0.16,
    "end": 3.92,
    "duration": 3.76
  },
  {
    "id": 2,
    "text": "李白是中国古典诗歌浪漫主义传统的最高巅峰，",
    "start": 3.92,
    "end": 8.24,
    "duration": 4.32
  },
  {
    "id": 3,
    "text": "也是 “盛唐气象” 最杰出的艺术人格代表。",
    "start": 8.24,
    "end": 12.32,
    "duration": 4.08
  },
  {
    "id": 4,
    "text": "身处开元天宝大唐国力极盛的历史节点，",
    "start": 12.32,
    "end": 15.92,
    "duration": 3.6
  },
  {
    "id": 5,
    "text": "李白承接了时代自信开放、昂扬开拓的精神底色，",
    "start": 15.92,
    "end": 20.24,
    "duration": 4.32
  },
  {
    "id": 6,
    "text": "以追求精神绝对自由的崇高傲骨，",
    "start": 20.24,
    "end": 23.52,
    "duration": 3.28
  },
  {
    "id": 7,
    "text": "将盛唐诗歌推向了飞扬奇伟的艺术极境。",
    "start": 23.52,
    "end": 27.76,
    "duration": 4.24
  },
  {
    "id": 8,
    "text": "韩愈赞其 “李杜文章在，光焰万丈长”；",
    "start": 27.76,
    "end": 32.24,
    "duration": 4.48
  },
  {
    "id": 9,
    "text": "严羽 《沧浪诗话》 称其 “如羚羊挂角，无迹可求”。",
    "start": 32.24,
    "end": 36.88,
    "duration": 4.64
  },
  {
    "id": 10,
    "text": "李白诗歌绝非孤立的书生吟咏，而是盛唐时代精神的集中审美体现。",
    "start": 36.88,
    "end": 43.52,
    "duration": 6.64
  },
  {
    "id": 11,
    "text": "其艺术特质主要展现为以下四个核心维度：",
    "start": 43.52,
    "end": 47.04,
    "duration": 3.52
  },
  {
    "id": 12,
    "text": "第一，标举追求精神自由的主体人格，",
    "start": 47.04,
    "end": 50.16,
    "duration": 3.12
  },
  {
    "id": 13,
    "text": "集中体现傲岸自信的时代气象。",
    "start": 50.48,
    "end": 53.28,
    "duration": 2.8
  },
  {
    "id": 14,
    "text": "李白诗歌最震撼人心的力量，在于塑造了一个傲立王侯、",
    "start": 53.28,
    "end": 58.24,
    "duration": 4.96
  },
  {
    "id": 15,
    "text": "追求绝对精神解放的抒情主人公形象。",
    "start": 58.48,
    "end": 62.24,
    "duration": 3.76
  },
  {
    "id": 16,
    "text": "在政治权贵面前，他傲岸宣告 “安能摧眉折腰事权贵，",
    "start": 62.24,
    "end": 67.84,
    "duration": 5.6
  },
  {
    "id": 17,
    "text": "使我不得开心颜”；面对仕途坎坷，",
    "start": 68.16,
    "end": 72.0,
    "duration": 3.84
  },
  {
    "id": 18,
    "text": "他始终坚信 “长风破浪会有时，直挂云帆济沧海”；",
    "start": 72.0,
    "end": 77.68,
    "duration": 5.68
  },
  {
    "id": 19,
    "text": "在狂饮痛饮之中，依然满怀 “天生我材必有用，",
    "start": 77.68,
    "end": 82.24,
    "duration": 4.56
  },
  {
    "id": 20,
    "text": "千金散尽还复来” 的豪迈自信。",
    "start": 82.72,
    "end": 85.44,
    "duration": 2.72
  },
  {
    "id": 21,
    "text": "李白将道家的神仙求索、",
    "start": 85.76,
    "end": 88.16,
    "duration": 2.4
  },
  {
    "id": 22,
    "text": "纵横家的建功立业与儒家的济世抱负融为一体；",
    "start": 88.16,
    "end": 92.88,
    "duration": 4.72
  },
  {
    "id": 23,
    "text": "这种强烈的自我确信与英雄气概，正是盛唐士人昂扬奋进、",
    "start": 92.88,
    "end": 99.76,
    "duration": 6.88
  },
  {
    "id": 24,
    "text": "开阔自信时代脉搏的最高艺术凝结。",
    "start": 99.76,
    "end": 102.96,
    "duration": 3.2
  },
  {
    "id": 25,
    "text": "第二，展开吞吐宇宙的奇幻想象与宏大夸张，",
    "start": 102.96,
    "end": 107.12,
    "duration": 4.16
  },
  {
    "id": 26,
    "text": "构筑雄奇壮伟的意境空间。",
    "start": 107.68,
    "end": 109.92,
    "duration": 2.24
  },
  {
    "id": 27,
    "text": "在艺术表现上，",
    "start": 109.92,
    "end": 111.6,
    "duration": 1.68
  },
  {
    "id": 28,
    "text": "李白善于运用极其大胆的夸张与变幻莫测的时空想象，",
    "start": 111.6,
    "end": 117.44,
    "duration": 5.84
  },
  {
    "id": 29,
    "text": "营造飞腾奇崛的审美境界。",
    "start": 117.44,
    "end": 120.16,
    "duration": 2.72
  },
  {
    "id": 30,
    "text": "他常常突破人间现实的物理边界，自由驱遣神话传说与日月星辰。",
    "start": 120.16,
    "end": 127.12,
    "duration": 6.96
  },
  {
    "id": 31,
    "text": "在 《梦游天姥吟留别》 中，以 “天姥连天向天横，",
    "start": 127.12,
    "end": 131.84,
    "duration": 4.72
  },
  {
    "id": 32,
    "text": "势拔五岳掩赤城” 的宏阔巨笔开篇，随即展开青冥浩荡、",
    "start": 131.84,
    "end": 137.36,
    "duration": 5.52
  },
  {
    "id": 33,
    "text": "神仙列坐的绚烂幻境；在 《蜀道难》 中，",
    "start": 137.36,
    "end": 141.68,
    "duration": 4.32
  },
  {
    "id": 34,
    "text": "以 “上有六龙回日之高标，",
    "start": 141.68,
    "end": 143.52,
    "duration": 1.84
  },
  {
    "id": 35,
    "text": "下有冲波逆折之回川” 的极致夸张，",
    "start": 143.52,
    "end": 146.88,
    "duration": 3.36
  },
  {
    "id": 36,
    "text": "将自然险阻升华为一种令人战栗的壮美奇观；",
    "start": 146.88,
    "end": 151.76,
    "duration": 4.88
  },
  {
    "id": 37,
    "text": "他写愁思为 “白发三千丈”，",
    "start": 151.76,
    "end": 154.696,
    "duration": 2.936
  },
  {
    "id": 38,
    "text": "写飞瀑为 “疑是银河落九天”。",
    "start": 154.696,
    "end": 157.736,
    "duration": 3.04
  },
  {
    "id": 39,
    "text": "这种汪洋恣肆的浪漫想象，",
    "start": 157.736,
    "end": 160.456,
    "duration": 2.72
  },
  {
    "id": 40,
    "text": "展现出不可羁绊的才情与蓬勃的盛唐艺术魄力。",
    "start": 160.456,
    "end": 165.096,
    "duration": 4.64
  },
  {
    "id": 41,
    "text": "第三，打破近体声律拘牵，以长短歌行与古题乐府开辟抒情长河。",
    "start": 165.096,
    "end": 172.616,
    "duration": 7.52
  },
  {
    "id": 42,
    "text": "李白并不热衷于齐梁沈宋以来讲究粘对对仗的近体律诗，",
    "start": 172.616,
    "end": 179.016,
    "duration": 6.4
  },
  {
    "id": 43,
    "text": "而是将主要创造力倾注于抒情空间更为自由的古题乐府与古体歌行。",
    "start": 179.016,
    "end": 185.336,
    "duration": 6.32
  },
  {
    "id": 44,
    "text": "他继承汉魏乐府精神，借古题以抒写当代豪情。",
    "start": 185.336,
    "end": 190.376,
    "duration": 5.04
  },
  {
    "id": 45,
    "text": "《将进酒》《行路难》 等篇章，句式由三言、五言、",
    "start": 190.376,
    "end": 195.416,
    "duration": 5.04
  },
  {
    "id": 46,
    "text": "七言直至杂言自由变换，如大河奔涌、一泻千里；",
    "start": 195.416,
    "end": 200.136,
    "duration": 4.72
  },
  {
    "id": 47,
    "text": "其诗歌节奏随情感起伏而骤起骤落，",
    "start": 200.136,
    "end": 203.416,
    "duration": 3.28
  },
  {
    "id": 48,
    "text": "完全打破了音律的死板节拍，呈现出天马行空、",
    "start": 203.416,
    "end": 208.456,
    "duration": 5.04
  },
  {
    "id": 49,
    "text": "行云流水的纯自然之美，实践了其倡导的 “清水出芙蓉，",
    "start": 208.456,
    "end": 214.616,
    "duration": 6.16
  },
  {
    "id": 50,
    "text": "天然去雕饰” 的至高美学追求。",
    "start": 214.616,
    "end": 217.736,
    "duration": 3.12
  },
  {
    "id": 51,
    "text": "第四，创造兼备豪放与清新的双重美学品格，",
    "start": 217.736,
    "end": 222.216,
    "duration": 4.48
  },
  {
    "id": 52,
    "text": "确立古典浪漫主义的万代宗师地位。",
    "start": 222.536,
    "end": 225.816,
    "duration": 3.28
  },
  {
    "id": 53,
    "text": "李白之诗绝非仅有豪放狂飙，其诗风同样兼备空灵澄澈的清新俊逸。",
    "start": 226.056,
    "end": 231.576,
    "duration": 5.52
  },
  {
    "id": 54,
    "text": "在七言绝句中，他以炉火纯青的天然之笔，",
    "start": 231.576,
    "end": 235.176,
    "duration": 3.6
  },
  {
    "id": 55,
    "text": "写下 《早发白帝城》 的轻舟顺流与 《望庐山瀑布》 的紫烟日照；",
    "start": 235.176,
    "end": 235.576,
    "duration": 0.4
  },
  {
    "id": 56,
    "text": "在五言古诗中，写下 《静夜思》 的纯净真挚。",
    "start": 235.336,
    "end": 235.576,
    "duration": 0.24
  },
  {
    "id": 57,
    "text": "李白将豪迈奔放与清新飘逸圆融统一，",
    "start": 235.336,
    "end": 235.576,
    "duration": 0.24
  },
  {
    "id": 58,
    "text": "与杜甫的沉郁顿挫双峰并峙，",
    "start": 235.336,
    "end": 235.576,
    "duration": 0.24
  },
  {
    "id": 59,
    "text": "共同确立了唐代诗歌无可逾越的双子星座，",
    "start": 235.336,
    "end": 235.576,
    "duration": 0.24
  },
  {
    "id": 60,
    "text": "成为后世历代浪漫主义诗人的精神航标。",
    "start": 235.336,
    "end": 235.576,
    "duration": 0.24
  }
]