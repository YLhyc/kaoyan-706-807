[
  {
    "id": 1,
    "text": "试论李白诗歌的艺术特质与盛唐气象。",
    "start": 0.16,
    "end": 3.316,
    "duration": 3.156
  },
  {
    "id": 2,
    "text": "李白是中国古典诗歌浪漫主义传统的杰出代表，",
    "start": 4.088,
    "end": 7.549,
    "duration": 3.461
  },
  {
    "id": 3,
    "text": "也是“盛唐气象”最鲜明的人格化身。",
    "start": 7.852,
    "end": 10.545,
    "duration": 2.693
  },
  {
    "id": 4,
    "text": "身处开元、天宝年间国力鼎盛的历史时期，",
    "start": 11.184,
    "end": 14.332,
    "duration": 3.148
  },
  {
    "id": 5,
    "text": "李白承接时代开放自信、昂扬奋进的精神风貌，",
    "start": 14.843,
    "end": 18.352,
    "duration": 3.509
  },
  {
    "id": 6,
    "text": "以独立不羁的人格风骨与奔放才情，",
    "start": 18.574,
    "end": 21.55,
    "duration": 2.976
  },
  {
    "id": 7,
    "text": "将盛唐诗歌的浪漫之美推向高峰。",
    "start": 21.875,
    "end": 24.604,
    "duration": 2.729
  },
  {
    "id": 8,
    "text": "杜甫赞其“笔落惊风雨，诗成泣鬼神”，",
    "start": 25.14,
    "end": 28.78,
    "duration": 3.64
  },
  {
    "id": 9,
    "text": "韩愈亦赞“李杜文章在，光焰万丈长”。",
    "start": 29.088,
    "end": 32.737,
    "duration": 3.649
  },
  {
    "id": 10,
    "text": "李白诗歌正是盛唐时代精神的集中审美体现，",
    "start": 33.041,
    "end": 36.262,
    "duration": 3.221
  },
  {
    "id": 11,
    "text": "其艺术特质主要体现在以下四个方面：",
    "start": 36.464,
    "end": 38.979,
    "duration": 2.515
  },
  {
    "id": 12,
    "text": "第一，塑造追求精神自由的主体人格，彰显傲岸自信的时代气象。",
    "start": 39.597,
    "end": 45.098,
    "duration": 5.501
  },
  {
    "id": 13,
    "text": "李白诗歌最震撼人心的力量，在于塑造了一个傲立王侯、",
    "start": 45.351,
    "end": 49.513,
    "duration": 4.162
  },
  {
    "id": 14,
    "text": "追求自由人生的抒情主人公形象。",
    "start": 49.722,
    "end": 52.109,
    "duration": 2.387
  },
  {
    "id": 15,
    "text": "在权贵面前，他昂然宣告“安能摧眉折腰事权贵，",
    "start": 52.375,
    "end": 56.658,
    "duration": 4.283
  },
  {
    "id": 16,
    "text": "使我不得开心颜”；面对仕途坎坷，",
    "start": 56.942,
    "end": 59.76,
    "duration": 2.818
  },
  {
    "id": 17,
    "text": "他依然坚信“长风破浪会有时，直挂云帆济沧海”；",
    "start": 59.982,
    "end": 64.354,
    "duration": 4.372
  },
  {
    "id": 18,
    "text": "在酒酣放歌之中，仍怀“天生我材必有用，",
    "start": 64.669,
    "end": 68.348,
    "duration": 3.679
  },
  {
    "id": 19,
    "text": "千金散尽还复来”的豪迈自信。",
    "start": 68.557,
    "end": 70.962,
    "duration": 2.405
  },
  {
    "id": 20,
    "text": "李白把道家的超脱求索、",
    "start": 71.366,
    "end": 73.176,
    "duration": 1.81
  },
  {
    "id": 21,
    "text": "纵横家的济世雄心与侠义精神融为一体；",
    "start": 73.483,
    "end": 76.774,
    "duration": 3.291
  },
  {
    "id": 22,
    "text": "这种强烈的自我确信与豪迈气概，正是盛唐士人蓬勃向上、",
    "start": 77.04,
    "end": 81.671,
    "duration": 4.631
  },
  {
    "id": 23,
    "text": "自信进取时代脉搏的生动凝结。",
    "start": 82.01,
    "end": 84.447,
    "duration": 2.437
  },
  {
    "id": 24,
    "text": "第二，展开奇幻莫测的想象与大胆夸张，构筑雄奇壮伟的意境空间。",
    "start": 85.09,
    "end": 91.471,
    "duration": 6.381
  },
  {
    "id": 25,
    "text": "在艺术表现上，",
    "start": 92.127,
    "end": 93.14,
    "duration": 1.013
  },
  {
    "id": 26,
    "text": "李白善于运用大胆的夸张与发想无端的奇特想象，",
    "start": 93.532,
    "end": 97.668,
    "duration": 4.136
  },
  {
    "id": 27,
    "text": "营造变幻莫测的审美境界。",
    "start": 97.914,
    "end": 100.278,
    "duration": 2.364
  },
  {
    "id": 28,
    "text": "他常常突破现实物象的物理边界，自由驱遣神话传说与日月星辰。",
    "start": 100.784,
    "end": 106.654,
    "duration": 5.87
  },
  {
    "id": 29,
    "text": "在《梦游天姥吟留别》中，开篇以“天姥连天向天横，",
    "start": 106.94,
    "end": 111.76,
    "duration": 4.82
  },
  {
    "id": 30,
    "text": "势拔五岳掩赤城”蓄势，随即展开青冥浩荡、",
    "start": 111.98,
    "end": 116.174,
    "duration": 4.194
  },
  {
    "id": 31,
    "text": "仙人列坐的绚烂幻境；在《蜀道难》中，",
    "start": 116.42,
    "end": 119.293,
    "duration": 2.873
  },
  {
    "id": 32,
    "text": "以“上有六龙回日之高标，下有冲波逆折之回川”的雄奇夸张，",
    "start": 119.655,
    "end": 124.894,
    "duration": 5.239
  },
  {
    "id": 33,
    "text": "将山川险阻化为令人惊心动魄的壮观奇景；",
    "start": 125.35,
    "end": 129.111,
    "duration": 3.761
  },
  {
    "id": 34,
    "text": "他写愁思为“白发三千丈”，写飞瀑为“疑是银河落九天”。",
    "start": 129.419,
    "end": 135.017,
    "duration": 5.598
  },
  {
    "id": 35,
    "text": "这种纵横驰骋的浪漫想象，",
    "start": 135.329,
    "end": 137.234,
    "duration": 1.905
  },
  {
    "id": 36,
    "text": "充分展露出其奔放才情与盛唐诗歌的阳刚魄力。",
    "start": 137.477,
    "end": 141.477,
    "duration": 4.0
  },
  {
    "id": 37,
    "text": "第三，突破近体声律羁绊，以古题乐府与杂言歌行纵情抒怀。",
    "start": 142.097,
    "end": 148.134,
    "duration": 6.037
  },
  {
    "id": 38,
    "text": "李白并不拘泥于声律严整、讲究粘对的近体律诗，",
    "start": 148.597,
    "end": 152.482,
    "duration": 3.885
  },
  {
    "id": 39,
    "text": "而是将主要才力倾注于抒情空间更为自由的古题乐府与长篇歌行。",
    "start": 152.877,
    "end": 158.417,
    "duration": 5.54
  },
  {
    "id": 40,
    "text": "他继承汉魏乐府精神，借古题以抒写己怀，",
    "start": 158.713,
    "end": 162.56,
    "duration": 3.847
  },
  {
    "id": 41,
    "text": "如《将进酒》《行路难》等篇，句式由三言、五言、",
    "start": 162.824,
    "end": 166.126,
    "duration": 3.302
  },
  {
    "id": 42,
    "text": "七言直至杂言参差错落，如大河奔涌、一泻千里；",
    "start": 166.218,
    "end": 171.281,
    "duration": 5.063
  },
  {
    "id": 43,
    "text": "其诗节奏随情感起伏而大开大合，打破了格律的整齐节拍，",
    "start": 171.7,
    "end": 176.722,
    "duration": 5.022
  },
  {
    "id": 44,
    "text": "呈现出天马行空、行云流水的天然风貌，",
    "start": 177.055,
    "end": 180.26,
    "duration": 3.205
  },
  {
    "id": 45,
    "text": "生动践行了“清水出芙蓉，天然去雕饰”的美学追求。",
    "start": 180.638,
    "end": 184.975,
    "duration": 4.337
  },
  {
    "id": 46,
    "text": "第四，兼备豪迈奔放与清新俊逸双重风神，树立古典浪漫主义典范。",
    "start": 185.653,
    "end": 191.656,
    "duration": 6.003
  },
  {
    "id": 47,
    "text": "李白诗歌不仅雄奇豪放，同样兼备空灵明净的清新俊逸，",
    "start": 192.065,
    "end": 196.619,
    "duration": 4.554
  },
  {
    "id": 48,
    "text": "尤集中于五、七言绝句之中。",
    "start": 196.79,
    "end": 198.896,
    "duration": 2.106
  },
  {
    "id": 49,
    "text": "他以自然天成之笔，",
    "start": 199.292,
    "end": 200.607,
    "duration": 1.315
  },
  {
    "id": 50,
    "text": "在七言绝句中写下《早发白帝城》的轻舟顺流与《望庐山瀑布》的紫烟飞瀑，",
    "start": 200.776,
    "end": 206.757,
    "duration": 5.981
  },
  {
    "id": 51,
    "text": "在五言绝句中写下《静夜思》的明快真挚，",
    "start": 207.035,
    "end": 210.208,
    "duration": 3.173
  },
  {
    "id": 52,
    "text": "正如胡应麟《诗薮》所称“太白五七言绝，字字神境，",
    "start": 210.588,
    "end": 215.221,
    "duration": 4.633
  },
  {
    "id": 53,
    "text": "篇篇神物”。",
    "start": 215.358,
    "end": 216.191,
    "duration": 0.833
  },
  {
    "id": 54,
    "text": "李白将豪迈飘逸与清新明丽圆融统一，",
    "start": 216.546,
    "end": 220.214,
    "duration": 3.668
  },
  {
    "id": 55,
    "text": "与杜甫的沉郁顿挫双峰并峙，",
    "start": 220.585,
    "end": 223.123,
    "duration": 2.538
  },
  {
    "id": 56,
    "text": "成为后代浪漫主义诗人仰慕与追随的不朽典范。",
    "start": 223.436,
    "end": 227.426,
    "duration": 3.99
  }
]