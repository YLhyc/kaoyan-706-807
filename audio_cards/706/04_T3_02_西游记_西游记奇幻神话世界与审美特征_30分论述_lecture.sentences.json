[
  {
    "id": 1,
    "text": "试论《西游记》的奇幻神话世界与审美特征。",
    "start": 0.16,
    "end": 4.16,
    "duration": 4.0
  },
  {
    "id": 2,
    "text": "《西游记》 是中国古典长篇神魔小说发展的至高巅峰，",
    "start": 4.16,
    "end": 8.72,
    "duration": 4.56
  },
  {
    "id": 3,
    "text": "也是古代浪漫主义小说的艺术瑰宝。",
    "start": 8.72,
    "end": 11.6,
    "duration": 2.88
  },
  {
    "id": 4,
    "text": "面对明代中后期王阳明心学崛起、",
    "start": 11.6,
    "end": 14.8,
    "duration": 3.2
  },
  {
    "id": 5,
    "text": "反抗程朱理学僵化与市民个性觉醒的时代思潮，",
    "start": 14.8,
    "end": 19.36,
    "duration": 4.56
  },
  {
    "id": 6,
    "text": "吴承恩借唐僧取经之历史线索，融合民间神话传说与宗教演义，",
    "start": 19.36,
    "end": 24.88,
    "duration": 5.52
  },
  {
    "id": 7,
    "text": "构建起一个光怪陆离而又饱含人间真理的神魔世界。",
    "start": 24.88,
    "end": 29.44,
    "duration": 4.56
  },
  {
    "id": 8,
    "text": "鲁迅在 《中国小说史略》 中深刻指出其艺术特质在于 “神魔皆有人情，",
    "start": 29.6,
    "end": 36.56,
    "duration": 6.96
  },
  {
    "id": 9,
    "text": "精魅亦通世故”。",
    "start": 36.56,
    "end": 38.24,
    "duration": 1.68
  },
  {
    "id": 10,
    "text": "其奇幻世界的建构与审美特征，主要展现为以下四个核心维度：",
    "start": 38.24,
    "end": 44.56,
    "duration": 6.32
  },
  {
    "id": 11,
    "text": "第一，建构“幻由人生”的奇幻神话世界，",
    "start": 44.56,
    "end": 48.417,
    "duration": 3.857
  },
  {
    "id": 12,
    "text": "寄托深刻的社会现实批判。",
    "start": 48.417,
    "end": 50.966,
    "duration": 2.549
  },
  {
    "id": 13,
    "text": "《西游记》 的奇幻构架绝非脱离尘世的虚妄臆想，",
    "start": 50.966,
    "end": 55.64,
    "duration": 4.674
  },
  {
    "id": 14,
    "text": "而是现实人间的折光反射。",
    "start": 55.64,
    "end": 58.189,
    "duration": 2.549
  },
  {
    "id": 15,
    "text": "小说中所构筑的天宫、地府、龙宫与妖魔洞府，",
    "start": 58.189,
    "end": 62.651,
    "duration": 4.462
  },
  {
    "id": 16,
    "text": "无一不是封建现实官僚体制的艺术化投射。",
    "start": 62.651,
    "end": 66.48,
    "duration": 3.829
  },
  {
    "id": 17,
    "text": "玉皇大帝昏庸无能、任人唯亲，阎王判官受贿舞弊、颠倒是非；",
    "start": 66.48,
    "end": 71.92,
    "duration": 5.44
  },
  {
    "id": 18,
    "text": "取经途中盘踞各地的妖魔鬼怪，",
    "start": 71.92,
    "end": 74.72,
    "duration": 2.8
  },
  {
    "id": 19,
    "text": "多与天界神佛存在千丝万缕的亲属或随从关系：",
    "start": 74.72,
    "end": 78.8,
    "duration": 4.08
  },
  {
    "id": 20,
    "text": "青狮白象是菩萨坐骑，金角银角是老君童子，",
    "start": 78.8,
    "end": 82.88,
    "duration": 4.08
  },
  {
    "id": 21,
    "text": "作恶多端却因有后台庇护而免遭惩处；",
    "start": 82.88,
    "end": 86.16,
    "duration": 3.28
  },
  {
    "id": 22,
    "text": "比丘国国王听信国丈残害小儿，车迟国道士蛊惑朝纲。",
    "start": 86.16,
    "end": 91.04,
    "duration": 4.88
  },
  {
    "id": 23,
    "text": "这种借助神魔之笔的荒诞呈现，对明代中叶皇权专制、",
    "start": 91.04,
    "end": 95.68,
    "duration": 4.64
  },
  {
    "id": 24,
    "text": "奸佞误国与黑恶横行的腐朽现实作出了极其辛辣的隐喻批判。",
    "start": 95.68,
    "end": 101.76,
    "duration": 6.08
  },
  {
    "id": 25,
    "text": "第二，成功塑造追求个性自由的孙悟空典型形象，",
    "start": 101.76,
    "end": 105.92,
    "duration": 4.16
  },
  {
    "id": 26,
    "text": "确立反抗权威的抗争范式。",
    "start": 106.24,
    "end": 108.8,
    "duration": 2.56
  },
  {
    "id": 27,
    "text": "孙悟空是全书最光彩夺目的艺术形象，",
    "start": 108.8,
    "end": 112.56,
    "duration": 3.76
  },
  {
    "id": 28,
    "text": "集中体现了明末追求个性解放的精神追求。",
    "start": 112.8,
    "end": 116.88,
    "duration": 4.08
  },
  {
    "id": 29,
    "text": "在前七回中，他由天地灵气所生，自封美猴王，",
    "start": 116.88,
    "end": 121.12,
    "duration": 4.24
  },
  {
    "id": 30,
    "text": "在反抗天庭权威中迸发出 “皇帝轮流做，",
    "start": 121.12,
    "end": 125.36,
    "duration": 4.24
  },
  {
    "id": 31,
    "text": "明年到我家” 的震撼呼声，",
    "start": 125.36,
    "end": 128.0,
    "duration": 2.64
  },
  {
    "id": 32,
    "text": "彻底打破了封建等级不可逾越的戒律；在取经途中，",
    "start": 128.08,
    "end": 133.04,
    "duration": 4.96
  },
  {
    "id": 33,
    "text": "他面对艰难险阻勇往直前、不畏强暴，",
    "start": 133.04,
    "end": 136.96,
    "duration": 3.92
  },
  {
    "id": 34,
    "text": "展现出扫清人间邪恶的英雄气概。",
    "start": 136.96,
    "end": 140.08,
    "duration": 3.12
  },
  {
    "id": 35,
    "text": "孙悟空兼备 “神性、人性与物性” 三重品格：",
    "start": 140.08,
    "end": 144.0,
    "duration": 3.92
  },
  {
    "id": 36,
    "text": "既有七十二变、腾云驾雾的神通，又有猴子抓耳挠腮、",
    "start": 144.0,
    "end": 149.816,
    "duration": 5.816
  },
  {
    "id": 37,
    "text": "急躁好动的物性，更有重情重义、嫉恶如仇的人格真性，",
    "start": 149.816,
    "end": 154.936,
    "duration": 5.12
  },
  {
    "id": 38,
    "text": "成为中国古典文学中反抗权威与追求自由的永恒典型。",
    "start": 154.936,
    "end": 159.656,
    "duration": 4.72
  },
  {
    "id": 39,
    "text": "第三，融“童心天真”与幽默讽刺于一体，",
    "start": 159.656,
    "end": 163.176,
    "duration": 3.52
  },
  {
    "id": 40,
    "text": "达成引人入胜的喜剧美学境界。",
    "start": 163.176,
    "end": 165.896,
    "duration": 2.72
  },
  {
    "id": 41,
    "text": "在美学风貌上，《西游记》 极具明快诙谐的喜剧色彩。",
    "start": 165.896,
    "end": 170.936,
    "duration": 5.04
  },
  {
    "id": 42,
    "text": "作者深刻践行了李贽倡导的 “童心说”，",
    "start": 170.936,
    "end": 174.696,
    "duration": 3.76
  },
  {
    "id": 43,
    "text": "以纯真无邪的天真之笔展开妙趣横生的艺术想象。",
    "start": 174.696,
    "end": 179.816,
    "duration": 5.12
  },
  {
    "id": 44,
    "text": "取经团队内部性格互补且充满戏剧张力：",
    "start": 179.816,
    "end": 183.736,
    "duration": 3.92
  },
  {
    "id": 45,
    "text": "唐僧迂腐善良而固执不察，孙悟空机警急躁而本领高强，",
    "start": 183.736,
    "end": 189.016,
    "duration": 5.28
  },
  {
    "id": 46,
    "text": "猪八戒贪吃好色、憨厚懒惰却富有人情味，沙僧忠诚老实。",
    "start": 189.016,
    "end": 194.856,
    "duration": 5.84
  },
  {
    "id": 47,
    "text": "八戒与行者之间的插科打诨、互不相让，",
    "start": 194.856,
    "end": 198.696,
    "duration": 3.84
  },
  {
    "id": 48,
    "text": "使充满生死的凶险旅途洋溢着市井生活的人间乐趣；",
    "start": 198.696,
    "end": 203.176,
    "duration": 4.48
  },
  {
    "id": 49,
    "text": "作者善于将深刻的讽刺包裹在风趣幽默的叙述之中，",
    "start": 203.416,
    "end": 208.136,
    "duration": 4.72
  },
  {
    "id": 50,
    "text": "展现出举重若轻的高超幽默艺术。",
    "start": 208.536,
    "end": 211.816,
    "duration": 3.28
  },
  {
    "id": 51,
    "text": "第四，贯通三教合一的哲学意蕴，",
    "start": 211.816,
    "end": 215.016,
    "duration": 3.2
  },
  {
    "id": 52,
    "text": "构筑心性修炼与战胜心魔的心灵隐喻。",
    "start": 215.416,
    "end": 218.936,
    "duration": 3.52
  },
  {
    "id": 53,
    "text": "从深层哲学意蕴而言，《西游记》 深受明代儒、释、",
    "start": 218.936,
    "end": 224.776,
    "duration": 5.84
  },
  {
    "id": 54,
    "text": "道三教合流思潮的影响，构筑了一部完整的人类心性修养寓言。",
    "start": 224.776,
    "end": 230.296,
    "duration": 5.52
  },
  {
    "id": 55,
    "text": "孙悟空号称 “心猿”，猪八戒被称为 “木母” 或意马；",
    "start": 230.296,
    "end": 232.616,
    "duration": 2.32
  },
  {
    "id": 56,
    "text": "孙悟空学艺之所名为 “灵台方寸山，斜月三星洞”，",
    "start": 232.456,
    "end": 232.616,
    "duration": 0.16
  },
  {
    "id": 57,
    "text": "皆暗指人心。",
    "start": 232.456,
    "end": 232.616,
    "duration": 0.16
  },
  {
    "id": 58,
    "text": "八十一难降妖伏魔的艰险征途，本质上是个体克制私欲、",
    "start": 232.456,
    "end": 232.616,
    "duration": 0.16
  },
  {
    "id": 59,
    "text": "战胜心魔、由狂傲不羁走向心性圆融成熟的精神升华历程。",
    "start": 232.456,
    "end": 232.616,
    "duration": 0.16
  },
  {
    "id": 60,
    "text": "这种多维度的哲学隐喻，赋予了神魔故事极其深邃的生命哲学厚度。",
    "start": 232.456,
    "end": 232.616,
    "duration": 0.16
  }
]