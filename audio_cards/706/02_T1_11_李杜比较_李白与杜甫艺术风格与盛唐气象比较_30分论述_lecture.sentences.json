[
  {
    "id": 1,
    "text": "试论李白与杜甫艺术风格的异同及其在唐代诗歌史上的地位。",
    "start": 0.16,
    "end": 5.92,
    "duration": 5.76
  },
  {
    "id": 2,
    "text": "李白与杜甫是中国古典诗歌发展史上双峰并峙的双子星座，",
    "start": 5.92,
    "end": 11.52,
    "duration": 5.6
  },
  {
    "id": 3,
    "text": "共同代表了唐诗繁荣的最高巅峰。",
    "start": 11.52,
    "end": 14.72,
    "duration": 3.2
  },
  {
    "id": 4,
    "text": "身处盛唐极盛向安史之乱剧变转折的不同历史节点，",
    "start": 14.72,
    "end": 19.6,
    "duration": 4.88
  },
  {
    "id": 5,
    "text": "李白承接开元天宝昂扬开放的盛世风貌，",
    "start": 19.6,
    "end": 23.52,
    "duration": 3.92
  },
  {
    "id": 6,
    "text": "将追求绝对精神自由的浪漫主义推向极致；",
    "start": 23.52,
    "end": 27.12,
    "duration": 3.6
  },
  {
    "id": 7,
    "text": "杜甫面对天宝以后盛极而衰的战乱浩劫，将悲悯苍生、",
    "start": 27.12,
    "end": 32.4,
    "duration": 5.28
  },
  {
    "id": 8,
    "text": "关怀家国的现实主义推向极境。",
    "start": 32.4,
    "end": 35.92,
    "duration": 3.52
  },
  {
    "id": 9,
    "text": "韩愈赞云 “李杜文章在，光焰万丈长”；",
    "start": 35.92,
    "end": 40.987,
    "duration": 5.067
  },
  {
    "id": 10,
    "text": "严羽 《沧浪诗话》 称 “少陵诗法如孙吴，",
    "start": 40.987,
    "end": 45.04,
    "duration": 4.053
  },
  {
    "id": 11,
    "text": "太白诗法如李广”。",
    "start": 45.04,
    "end": 46.8,
    "duration": 1.76
  },
  {
    "id": 12,
    "text": "二人在艺术风格、文体造诣与精神品格上的异同，",
    "start": 46.8,
    "end": 51.36,
    "duration": 4.56
  },
  {
    "id": 13,
    "text": "主要展现为以下四个核心维度：",
    "start": 51.36,
    "end": 54.32,
    "duration": 2.96
  },
  {
    "id": 14,
    "text": "第一，在时代坐标与精神追求上，",
    "start": 54.32,
    "end": 57.68,
    "duration": 3.36
  },
  {
    "id": 15,
    "text": "呈现追求个体精神解放与承担家国忧患的显著差异。",
    "start": 57.68,
    "end": 62.64,
    "duration": 4.96
  },
  {
    "id": 16,
    "text": "李白身处开元全盛时期，",
    "start": 62.64,
    "end": 64.8,
    "duration": 2.16
  },
  {
    "id": 17,
    "text": "其思想深受道家庄子哲学与纵横家侠义精神浸润，",
    "start": 64.8,
    "end": 68.72,
    "duration": 3.92
  },
  {
    "id": 18,
    "text": "塑造了一个傲立王侯、追求绝对个体自由的抒情主体。",
    "start": 68.72,
    "end": 73.6,
    "duration": 4.88
  },
  {
    "id": 19,
    "text": "他宣告 “安能摧眉折腰事权贵”，",
    "start": 73.6,
    "end": 76.96,
    "duration": 3.36
  },
  {
    "id": 20,
    "text": "洋溢着盛世文人强烈的自我确信与超拔神采；",
    "start": 77.04,
    "end": 81.84,
    "duration": 4.8
  },
  {
    "id": 21,
    "text": "杜甫则亲历天宝乱离与国家沦丧，",
    "start": 81.84,
    "end": 85.04,
    "duration": 3.2
  },
  {
    "id": 22,
    "text": "其思想牢牢扎根于儒家“仁民爱物”与“穷则独善其身，",
    "start": 85.28,
    "end": 90.4,
    "duration": 5.12
  },
  {
    "id": 23,
    "text": "达则兼济天下”的传统。",
    "start": 90.64,
    "end": 93.44,
    "duration": 2.8
  },
  {
    "id": 24,
    "text": "他始终将自身身世之悲系于天下安危，",
    "start": 93.44,
    "end": 96.8,
    "duration": 3.36
  },
  {
    "id": 25,
    "text": "在 《自京赴奉先》 中发出 “穷年忧黎元，",
    "start": 96.8,
    "end": 100.8,
    "duration": 4.0
  },
  {
    "id": 26,
    "text": "叹息肠内热” 的沉痛关怀。",
    "start": 100.8,
    "end": 103.52,
    "duration": 2.72
  },
  {
    "id": 27,
    "text": "李白是盛唐自信个性的飞扬体现，",
    "start": 103.52,
    "end": 106.72,
    "duration": 3.2
  },
  {
    "id": 28,
    "text": "杜甫是盛唐精神走向深沉反思的理性结晶。",
    "start": 106.72,
    "end": 109.28,
    "duration": 2.56
  },
  {
    "id": 29,
    "text": "第二，在审美风貌与情感机制上，",
    "start": 109.6,
    "end": 112.8,
    "duration": 3.2
  },
  {
    "id": 30,
    "text": "呈现飘逸奔放的清水芙蓉与波澜低回的沉郁顿挫。",
    "start": 112.8,
    "end": 117.68,
    "duration": 4.88
  },
  {
    "id": 31,
    "text": "在风格机制上，李白崇尚 “清水出芙蓉，天然去雕饰”，",
    "start": 117.76,
    "end": 123.36,
    "duration": 5.6
  },
  {
    "id": 32,
    "text": "其情感如大江奔涌，喷薄欲出而一泻千里。",
    "start": 123.36,
    "end": 126.96,
    "duration": 3.6
  },
  {
    "id": 33,
    "text": "在 《将进酒》 中，",
    "start": 126.96,
    "end": 128.8,
    "duration": 1.84
  },
  {
    "id": 34,
    "text": "以 “君不见黄河之水天上来” 的宏阔狂飙破题，",
    "start": 128.8,
    "end": 134.0,
    "duration": 5.2
  },
  {
    "id": 35,
    "text": "诗情起伏跌宕却豪放洒脱；杜甫则以 “沉郁顿挫” 称绝，",
    "start": 134.0,
    "end": 139.92,
    "duration": 5.92
  },
  {
    "id": 36,
    "text": "思想感情沉深宏厚，表现章法反复低回。",
    "start": 139.92,
    "end": 143.84,
    "duration": 3.92
  },
  {
    "id": 37,
    "text": "在 《登高》 中，",
    "start": 143.84,
    "end": 145.12,
    "duration": 1.28
  },
  {
    "id": 38,
    "text": "将万里悲秋的壮阔江天与老病孤舟的残年身世绞合在一起；",
    "start": 145.12,
    "end": 151.168,
    "duration": 6.048
  },
  {
    "id": 39,
    "text": "在 《自京赴奉先》 中，历经四起四落的情感克制转折。",
    "start": 151.168,
    "end": 156.528,
    "duration": 5.36
  },
  {
    "id": 40,
    "text": "李白之美在于飞扬壮阔的奇崛俊逸，",
    "start": 156.528,
    "end": 159.888,
    "duration": 3.36
  },
  {
    "id": 41,
    "text": "杜甫之美在于郁结盘旋的深沉悲凉。",
    "start": 159.888,
    "end": 163.008,
    "duration": 3.12
  },
  {
    "id": 42,
    "text": "第三，在表现手法与文体体裁上，",
    "start": 163.008,
    "end": 165.968,
    "duration": 2.96
  },
  {
    "id": 43,
    "text": "呈现天马行空的古体歌行与精严化境的近体律诗。",
    "start": 165.968,
    "end": 171.328,
    "duration": 5.36
  },
  {
    "id": 44,
    "text": "李白极力突破格律的束缚，",
    "start": 171.328,
    "end": 174.048,
    "duration": 2.72
  },
  {
    "id": 45,
    "text": "将主要创造力倾注于三五七言错落舒卷的古题乐府与长篇歌行。",
    "start": 174.048,
    "end": 180.128,
    "duration": 6.08
  },
  {
    "id": 46,
    "text": "在 《梦游天姥吟留别》《蜀道难》 中，",
    "start": 180.128,
    "end": 184.048,
    "duration": 3.92
  },
  {
    "id": 47,
    "text": "自由驱遣天界神仙与宇宙极境，极尽大胆奇幻的夸张之能事；",
    "start": 184.048,
    "end": 190.448,
    "duration": 6.4
  },
  {
    "id": 48,
    "text": "杜甫虽亦擅长古体叙事，",
    "start": 190.448,
    "end": 192.848,
    "duration": 2.4
  },
  {
    "id": 49,
    "text": "但其最高艺术造诣在于对律诗体制的全面集大成。",
    "start": 192.848,
    "end": 197.808,
    "duration": 4.96
  },
  {
    "id": 50,
    "text": "杜甫精研声病，晚年做到 “晚节渐于诗律细”，",
    "start": 197.808,
    "end": 201.968,
    "duration": 4.16
  },
  {
    "id": 51,
    "text": "更创立 “拗救” 与变格手法。",
    "start": 201.968,
    "end": 204.448,
    "duration": 2.48
  },
  {
    "id": 52,
    "text": "其 《秋兴八首》 将七律组诗推向登峰造极，",
    "start": 204.448,
    "end": 208.048,
    "duration": 3.6
  },
  {
    "id": 53,
    "text": "做到了形式精严而又浑融流转，",
    "start": 208.048,
    "end": 210.848,
    "duration": 2.8
  },
  {
    "id": 54,
    "text": "代表了近体诗律化的终极最高成就。",
    "start": 210.848,
    "end": 214.208,
    "duration": 3.36
  },
  {
    "id": 55,
    "text": "第四，共同构建中国古典诗歌的审美双璧，",
    "start": 214.208,
    "end": 218.448,
    "duration": 4.24
  },
  {
    "id": 56,
    "text": "确立不可动摇的万代宗师地位。",
    "start": 218.448,
    "end": 221.488,
    "duration": 3.04
  },
  {
    "id": 57,
    "text": "李白与杜甫并非相互排斥，",
    "start": 221.488,
    "end": 224.048,
    "duration": 2.56
  },
  {
    "id": 58,
    "text": "而是共同构成了中国诗歌精神的阴阳双翼。",
    "start": 224.048,
    "end": 227.408,
    "duration": 3.36
  },
  {
    "id": 59,
    "text": "李白为后代历代文人提供了超越尘世功利、",
    "start": 227.408,
    "end": 231.248,
    "duration": 3.84
  },
  {
    "id": 60,
    "text": "守护自由心灵的浪漫飞翔之翼；",
    "start": 231.248,
    "end": 234.288,
    "duration": 3.04
  },
  {
    "id": 61,
    "text": "杜甫为后代士人树立了扎根大地、",
    "start": 234.448,
    "end": 237.008,
    "duration": 2.56
  },
  {
    "id": 62,
    "text": "关怀生民疾苦的现实良心之锚。",
    "start": 237.008,
    "end": 237.888,
    "duration": 0.88
  },
  {
    "id": 63,
    "text": "中唐韩孟诗派与北宋苏轼得力于李白的浪漫狂放与豪迈气势；",
    "start": 237.728,
    "end": 237.888,
    "duration": 0.16
  },
  {
    "id": 64,
    "text": "白居易新乐府运动、",
    "start": 237.728,
    "end": 237.888,
    "duration": 0.16
  },
  {
    "id": 65,
    "text": "宋代黄庭坚与江西诗派则取法于杜甫的写实规矩与精严法度。",
    "start": 237.728,
    "end": 237.888,
    "duration": 0.16
  },
  {
    "id": 66,
    "text": "李杜双峰并峙，共同奠定了中国诗歌史上不可逾越的审美巅峰。",
    "start": 237.728,
    "end": 237.888,
    "duration": 0.16
  }
]