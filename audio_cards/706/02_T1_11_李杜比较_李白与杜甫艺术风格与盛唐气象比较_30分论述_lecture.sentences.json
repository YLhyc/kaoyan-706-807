[
  {
    "id": 1,
    "text": "试论李白与杜甫艺术风格的异同及其在唐代诗歌史上的地位。",
    "start": 0.16,
    "end": 4.67,
    "duration": 4.51
  },
  {
    "id": 2,
    "text": "李白与杜甫是中国古典诗歌史上双峰并峙的伟大诗人，",
    "start": 5.132,
    "end": 9.356,
    "duration": 4.224
  },
  {
    "id": 3,
    "text": "共同代表了唐诗繁荣的高峰。",
    "start": 9.669,
    "end": 11.716,
    "duration": 2.047
  },
  {
    "id": 4,
    "text": "李白承接开元盛世昂扬开放的时代风貌，",
    "start": 12.035,
    "end": 15.238,
    "duration": 3.203
  },
  {
    "id": 5,
    "text": "把浪漫主义诗风推向极盛；杜甫亲历天宝由盛转衰的战乱浩劫，",
    "start": 15.475,
    "end": 21.132,
    "duration": 5.657
  },
  {
    "id": 6,
    "text": "将关怀苍生的现实主义传统发扬光大。",
    "start": 21.39,
    "end": 24.5,
    "duration": 3.11
  },
  {
    "id": 7,
    "text": "杜甫赞李白“笔落惊风雨，诗成泣鬼神”，",
    "start": 24.824,
    "end": 28.355,
    "duration": 3.531
  },
  {
    "id": 8,
    "text": "韩愈亦赞“李杜文章在，光焰万丈长”。",
    "start": 28.557,
    "end": 31.783,
    "duration": 3.226
  },
  {
    "id": 9,
    "text": "二人在思想追求、审美风貌、体裁造诣与诗史影响上的异同，",
    "start": 32.044,
    "end": 36.953,
    "duration": 4.909
  },
  {
    "id": 10,
    "text": "主要体现在以下四个方面：",
    "start": 37.108,
    "end": 38.92,
    "duration": 1.812
  },
  {
    "id": 11,
    "text": "第一，分立个体精神解放与家国忧患之志，共映盛唐时代脉搏。",
    "start": 39.527,
    "end": 45.166,
    "duration": 5.639
  },
  {
    "id": 12,
    "text": "时代坐标与思想渊源塑造了二人不同的精神追求。",
    "start": 45.427,
    "end": 49.202,
    "duration": 3.775
  },
  {
    "id": 13,
    "text": "李白身处盛唐全盛之际，思想兼融道家逍遥、",
    "start": 49.411,
    "end": 53.056,
    "duration": 3.645
  },
  {
    "id": 14,
    "text": "侠义任情与建功抱负，塑造出傲立王侯、",
    "start": 53.414,
    "end": 57.061,
    "duration": 3.647
  },
  {
    "id": 15,
    "text": "向往精神自由的抒情主体，高呼“安能摧眉折腰事权贵”，",
    "start": 57.321,
    "end": 61.933,
    "duration": 4.612
  },
  {
    "id": 16,
    "text": "洋溢着盛世文人的自信神采；杜甫亲历安史乱离，",
    "start": 62.181,
    "end": 66.612,
    "duration": 4.431
  },
  {
    "id": 17,
    "text": "思想深深扎根于儒家“仁民爱物”与“兼济天下”传统，",
    "start": 66.74,
    "end": 71.11,
    "duration": 4.37
  },
  {
    "id": 18,
    "text": "始终将身世之悲系于国家安危，",
    "start": 71.585,
    "end": 74.222,
    "duration": 2.637
  },
  {
    "id": 19,
    "text": "在《自京赴奉先县咏怀五百字》中发出“穷年忧黎元，",
    "start": 74.653,
    "end": 79.825,
    "duration": 5.172
  },
  {
    "id": 20,
    "text": "叹息肠内热”的沉痛关怀。",
    "start": 80.033,
    "end": 82.398,
    "duration": 2.365
  },
  {
    "id": 21,
    "text": "李白体现了盛唐个性的飞扬，",
    "start": 82.648,
    "end": 84.774,
    "duration": 2.126
  },
  {
    "id": 22,
    "text": "杜甫则体现了盛唐精神转向深沉反思的担当。",
    "start": 85.161,
    "end": 89.0,
    "duration": 3.839
  },
  {
    "id": 23,
    "text": "第二，分呈飘逸奔放与沉郁顿挫风貌，各臻抒情艺术化境。",
    "start": 89.674,
    "end": 95.04,
    "duration": 5.366
  },
  {
    "id": 24,
    "text": "在审美风貌与情感机制上，李白崇尚“清水出芙蓉，",
    "start": 95.344,
    "end": 99.545,
    "duration": 4.201
  },
  {
    "id": 25,
    "text": "天然去雕饰”，情感如大江奔涌、一泻千里。",
    "start": 99.689,
    "end": 103.242,
    "duration": 3.553
  },
  {
    "id": 26,
    "text": "如《将进酒》以“君不见黄河之水天上来”破题，",
    "start": 103.693,
    "end": 107.351,
    "duration": 3.658
  },
  {
    "id": 27,
    "text": "纵横狂放而豪迈洒脱；杜甫则以“沉郁顿挫”称绝，",
    "start": 107.634,
    "end": 112.182,
    "duration": 4.548
  },
  {
    "id": 28,
    "text": "情感沉深宏厚，表达反复低回。",
    "start": 112.572,
    "end": 115.595,
    "duration": 3.023
  },
  {
    "id": 29,
    "text": "如《登高》将万里悲秋的江天与老病孤舟的身世交融，",
    "start": 115.975,
    "end": 120.276,
    "duration": 4.301
  },
  {
    "id": 30,
    "text": "《自京赴奉先县咏怀五百字》历经四起四落的感情克制与回旋。",
    "start": 120.629,
    "end": 125.938,
    "duration": 5.309
  },
  {
    "id": 31,
    "text": "李白之美在于飞扬奇伟的豪迈俊逸，",
    "start": 126.146,
    "end": 128.826,
    "duration": 2.68
  },
  {
    "id": 32,
    "text": "杜甫之美在于深沉悲慨的郁勃低回。",
    "start": 129.089,
    "end": 132.054,
    "duration": 2.965
  },
  {
    "id": 33,
    "text": "第三，一擅古体歌行之纵横驰骋，一集近体律诗之精严法度。",
    "start": 132.689,
    "end": 138.121,
    "duration": 5.432
  },
  {
    "id": 34,
    "text": "在文体与技法选择上，李白力求摆脱声律羁绊，",
    "start": 138.605,
    "end": 142.311,
    "duration": 3.706
  },
  {
    "id": 35,
    "text": "将主要才情倾注于三、五、七言杂陈的古题乐府与长篇歌行，",
    "start": 142.687,
    "end": 147.971,
    "duration": 5.284
  },
  {
    "id": 36,
    "text": "如《梦游天姥吟留别》《蜀道难》驱遣神话星辰，",
    "start": 148.416,
    "end": 152.365,
    "duration": 3.949
  },
  {
    "id": 37,
    "text": "极尽大胆夸张与奇幻想象之妙，且兼擅五、",
    "start": 152.687,
    "end": 156.617,
    "duration": 3.93
  },
  {
    "id": 38,
    "text": "七言绝句的自然天成；杜甫虽亦长于古体叙事，",
    "start": 156.965,
    "end": 160.933,
    "duration": 3.968
  },
  {
    "id": 39,
    "text": "最高艺术成就却在集律诗之大成。",
    "start": 161.354,
    "end": 164.114,
    "duration": 2.76
  },
  {
    "id": 40,
    "text": "他精研声律对仗，晚年追求“晚节渐于诗律细”，",
    "start": 164.563,
    "end": 168.578,
    "duration": 4.015
  },
  {
    "id": 41,
    "text": "善用“拗救”与组诗体制，",
    "start": 168.921,
    "end": 171.04,
    "duration": 2.119
  },
  {
    "id": 42,
    "text": "其《秋兴八首》将七律写得浑融流转而法度精严，",
    "start": 171.313,
    "end": 175.634,
    "duration": 4.321
  },
  {
    "id": 43,
    "text": "代表了近体诗艺术的最高成就。",
    "start": 175.83,
    "end": 178.302,
    "duration": 2.472
  },
  {
    "id": 44,
    "text": "第四，共筑中国古典诗歌审美双璧，开启后代浪漫与写实两大流派。",
    "start": 178.994,
    "end": 185.259,
    "duration": 6.265
  },
  {
    "id": 45,
    "text": "李白与杜甫相辅相成，共同撑起中国古典诗歌的精神高度。",
    "start": 185.729,
    "end": 190.453,
    "duration": 4.724
  },
  {
    "id": 46,
    "text": "李白以其飘逸豪放与个性解放，",
    "start": 190.911,
    "end": 193.28,
    "duration": 2.369
  },
  {
    "id": 47,
    "text": "启迪了中唐韩孟的奇崛诗思与宋代苏轼、陆游的豪迈诗风；",
    "start": 193.635,
    "end": 198.621,
    "duration": 4.986
  },
  {
    "id": 48,
    "text": "杜甫以其写实精神与精严法度，",
    "start": 199.077,
    "end": 201.554,
    "duration": 2.477
  },
  {
    "id": 49,
    "text": "直接催生了中唐白居易的新乐府运动，",
    "start": 201.866,
    "end": 204.674,
    "duration": 2.808
  },
  {
    "id": 50,
    "text": "并为宋代黄庭坚与江西诗派所宗尚。",
    "start": 205.214,
    "end": 208.327,
    "duration": 3.113
  },
  {
    "id": 51,
    "text": "李杜双峰并峙，在中国诗歌史上树立起浪漫与现实两大典范。",
    "start": 209.098,
    "end": 214.267,
    "duration": 5.169
  }
]