[
  {
    "id": 1,
    "text": "试论李白与杜甫艺术风格的异同及其在唐代诗歌史上的地位。",
    "start": 0.16,
    "end": 4.68,
    "duration": 4.52
  },
  {
    "id": 2,
    "text": "李白与杜甫是中国古典诗歌史上双峰并峙的伟大诗人，共同代表了唐诗繁荣的高峰。",
    "start": 5.18,
    "end": 11.774,
    "duration": 6.594
  },
  {
    "id": 3,
    "text": "李白承接开元盛世昂扬开放的时代风貌，把浪漫主义诗风推向极盛；",
    "start": 12.274,
    "end": 17.751,
    "duration": 5.477
  },
  {
    "id": 4,
    "text": "杜甫亲历天宝由盛转衰的战乱浩劫，将关怀苍生的现实主义传统发扬光大。",
    "start": 18.251,
    "end": 24.781,
    "duration": 6.53
  },
  {
    "id": 5,
    "text": "杜甫赞李白“笔落惊风雨，诗成泣鬼神”，韩愈亦赞“李杜文章在，光焰万丈长”。",
    "start": 25.281,
    "end": 32.233,
    "duration": 6.952
  },
  {
    "id": 6,
    "text": "二人在思想追求、审美风貌、体裁造诣与诗史影响上的异同，主要体现在以下四个方面：",
    "start": 32.733,
    "end": 39.619,
    "duration": 6.886
  },
  {
    "id": 7,
    "text": "第一，分立个体精神解放与家国忧患之志，共映盛唐时代脉搏。",
    "start": 40.216,
    "end": 45.865,
    "duration": 5.649
  },
  {
    "id": 8,
    "text": "时代坐标与思想渊源塑造了二人不同的精神追求。",
    "start": 46.365,
    "end": 50.15,
    "duration": 3.785
  },
  {
    "id": 9,
    "text": "李白身处盛唐全盛之际，思想兼融道家逍遥、侠义任情与建功抱负，",
    "start": 50.65,
    "end": 56.461,
    "duration": 5.811
  },
  {
    "id": 10,
    "text": "塑造出傲立王侯、向往精神自由的抒情主体，",
    "start": 56.86,
    "end": 60.555,
    "duration": 3.695
  },
  {
    "id": 11,
    "text": "高呼“安能摧眉折腰事权贵”，洋溢着盛世文人的自信神采；",
    "start": 60.905,
    "end": 65.884,
    "duration": 4.979
  },
  {
    "id": 12,
    "text": "杜甫亲历安史乱离，思想深深扎根于儒家“仁民爱物”与“兼济天下”传统，",
    "start": 66.384,
    "end": 72.514,
    "duration": 6.13
  },
  {
    "id": 13,
    "text": "始终将身世之悲系于国家安危，",
    "start": 72.979,
    "end": 75.623,
    "duration": 2.644
  },
  {
    "id": 14,
    "text": "在《自京赴奉先县咏怀五百字》中发出“穷年忧黎元，叹息肠内热”的沉痛关怀。",
    "start": 76.047,
    "end": 83.783,
    "duration": 7.736
  },
  {
    "id": 15,
    "text": "李白体现了盛唐个性的飞扬，杜甫则体现了盛唐精神转向深沉反思的担当。",
    "start": 84.283,
    "end": 90.645,
    "duration": 6.362
  },
  {
    "id": 16,
    "text": "第二，分呈飘逸奔放与沉郁顿挫风貌，各臻抒情艺术化境。",
    "start": 91.309,
    "end": 96.672,
    "duration": 5.363
  },
  {
    "id": 17,
    "text": "在审美风貌与情感机制上，李白崇尚“清水出芙蓉，天然去雕饰”，情感如大江奔涌、一泻千里。",
    "start": 97.172,
    "end": 105.081,
    "duration": 7.909
  },
  {
    "id": 18,
    "text": "如《将进酒》以“君不见黄河之水天上来”破题，纵横狂放而豪迈洒脱；",
    "start": 105.581,
    "end": 111.495,
    "duration": 5.914
  },
  {
    "id": 19,
    "text": "杜甫则以“沉郁顿挫”称绝，情感沉深宏厚，表达反复低回。",
    "start": 111.995,
    "end": 117.737,
    "duration": 5.742
  },
  {
    "id": 20,
    "text": "如《登高》将万里悲秋的江天与百年多病的身世交融，",
    "start": 118.237,
    "end": 122.271,
    "duration": 4.034
  },
  {
    "id": 21,
    "text": "《自京赴奉先县咏怀五百字》历经四起四落的感情克制与回旋。",
    "start": 122.733,
    "end": 128.036,
    "duration": 5.303
  },
  {
    "id": 22,
    "text": "李白之美在于飞扬奇伟的豪迈俊逸，杜甫之美在于深沉悲慨的郁勃低回。",
    "start": 128.536,
    "end": 134.432,
    "duration": 5.896
  },
  {
    "id": 23,
    "text": "第三，一擅古体歌行之纵横驰骋，一集近体律诗之精严法度。",
    "start": 135.079,
    "end": 140.519,
    "duration": 5.44
  },
  {
    "id": 24,
    "text": "在文体与技法选择上，李白力求摆脱声律羁绊，",
    "start": 141.019,
    "end": 144.735,
    "duration": 3.716
  },
  {
    "id": 25,
    "text": "将主要才情倾注于三、五、七言杂陈的古题乐府与长篇歌行，",
    "start": 145.101,
    "end": 150.395,
    "duration": 5.294
  },
  {
    "id": 26,
    "text": "如《梦游天姥吟留别》《蜀道难》驱遣神话星辰，",
    "start": 150.83,
    "end": 154.789,
    "duration": 3.959
  },
  {
    "id": 27,
    "text": "极尽大胆夸张与奇幻想象之妙，且兼擅五、七言绝句的自然天成；",
    "start": 155.139,
    "end": 161.155,
    "duration": 6.016
  },
  {
    "id": 28,
    "text": "杜甫虽亦长于古体叙事，最高艺术成就却在集律诗之大成。",
    "start": 161.655,
    "end": 166.882,
    "duration": 5.227
  },
  {
    "id": 29,
    "text": "他精研声律对仗，晚年追求“晚节渐于诗律细”，善用“拗救”与组诗体制，",
    "start": 167.382,
    "end": 173.869,
    "duration": 6.487
  },
  {
    "id": 30,
    "text": "其《秋兴八首》将七律写得浑融流转而法度精严，代表了近体诗艺术的最高成就。",
    "start": 174.219,
    "end": 181.218,
    "duration": 6.999
  },
  {
    "id": 31,
    "text": "第四，共筑中国古典诗歌审美双璧，开启后代浪漫与写实两大流派。",
    "start": 181.9,
    "end": 188.175,
    "duration": 6.275
  },
  {
    "id": 32,
    "text": "李白与杜甫相辅相成，共同撑起中国古典诗歌的精神高度。",
    "start": 188.675,
    "end": 193.409,
    "duration": 4.734
  },
  {
    "id": 33,
    "text": "李白以其飘逸豪放与个性解放，启迪了中唐韩孟的奇崛诗思与宋代苏轼、陆游的豪迈诗风；",
    "start": 193.909,
    "end": 201.629,
    "duration": 7.72
  },
  {
    "id": 34,
    "text": "杜甫以其写实精神与精严法度，深刻启迪了中唐白居易的新乐府运动，并为宋代黄庭坚与江西诗派所宗尚。",
    "start": 202.129,
    "end": 212.068,
    "duration": 9.939
  },
  {
    "id": 35,
    "text": "李杜双峰并峙，在中国诗歌史上树立起浪漫与现实两大典范。",
    "start": 212.829,
    "end": 217.998,
    "duration": 5.169
  },
  {
    "id": 36,
    "text": "综上所述，李白与杜甫以各自鲜明的时代感受与艺术个性，",
    "start": 218.498,
    "end": 223.435,
    "duration": 4.937
  },
  {
    "id": 37,
    "text": "共同映照出盛唐由鼎盛转入动荡的完整历史脉搏。",
    "start": 223.785,
    "end": 228.368,
    "duration": 4.583
  },
  {
    "id": 38,
    "text": "李白以飘逸狂放拓展了古体歌行与绝句的浪漫境界，",
    "start": 228.868,
    "end": 233.037,
    "duration": 4.169
  },
  {
    "id": 39,
    "text": "杜甫则以沉郁顿挫与精严律法把写实诗史推至巅峰，二人互补共存，",
    "start": 233.443,
    "end": 238.868,
    "duration": 5.425
  },
  {
    "id": 40,
    "text": "开启了后代古典诗歌浪漫与现实并行的双流传统。",
    "start": 239.218,
    "end": 244.631,
    "duration": 5.413
  }
]
