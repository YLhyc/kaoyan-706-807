[
  {
    "id": 1,
    "text": "试论李白与杜甫艺术风格的异同及其在唐代诗歌史上的地位。",
    "start": 0.089,
    "end": 5.455,
    "duration": 5.366
  },
  {
    "id": 2,
    "text": "李白与杜甫是中国古典诗歌发展史上双峰并峙的双子星座，",
    "start": 5.724,
    "end": 11.163,
    "duration": 5.439
  },
  {
    "id": 3,
    "text": "共同代表了唐诗繁荣的最高巅峰。",
    "start": 11.234,
    "end": 14.539,
    "duration": 3.305
  },
  {
    "id": 4,
    "text": "身处盛唐极盛向安史之乱剧变转折的不同历史节点，",
    "start": 14.573,
    "end": 19.022,
    "duration": 4.449
  },
  {
    "id": 5,
    "text": "李白承接开元天宝昂扬开放的盛世风貌，",
    "start": 19.289,
    "end": 22.971,
    "duration": 3.682
  },
  {
    "id": 6,
    "text": "将追求绝对精神自由的浪漫主义推向极致；",
    "start": 22.971,
    "end": 26.228,
    "duration": 3.257
  },
  {
    "id": 7,
    "text": "杜甫面对天宝以后盛极而衰的战乱浩劫，将悲悯苍生、",
    "start": 26.418,
    "end": 31.172,
    "duration": 4.754
  },
  {
    "id": 8,
    "text": "关怀家国的现实主义推向极境。",
    "start": 31.325,
    "end": 33.907,
    "duration": 2.582
  },
  {
    "id": 9,
    "text": "韩愈赞云 “李杜文章在，光焰万丈长”；",
    "start": 34.261,
    "end": 37.679,
    "duration": 3.418
  },
  {
    "id": 10,
    "text": "严羽 《沧浪诗话》 称 “少陵诗法如孙吴，",
    "start": 38.162,
    "end": 41.664,
    "duration": 3.502
  },
  {
    "id": 11,
    "text": "太白诗法如李广”。",
    "start": 41.838,
    "end": 43.18,
    "duration": 1.342
  },
  {
    "id": 12,
    "text": "二人在艺术风格、文体造诣与精神品格上的异同，",
    "start": 43.485,
    "end": 47.368,
    "duration": 3.883
  },
  {
    "id": 13,
    "text": "主要展现为以下四个核心维度：",
    "start": 47.423,
    "end": 49.727,
    "duration": 2.304
  },
  {
    "id": 14,
    "text": "第一，在时代坐标与精神追求上，",
    "start": 49.934,
    "end": 52.68,
    "duration": 2.746
  },
  {
    "id": 15,
    "text": "呈现追求个体精神解放与承担家国忧患的显著差异。",
    "start": 52.88,
    "end": 57.413,
    "duration": 4.533
  },
  {
    "id": 16,
    "text": "李白身处开元全盛时期，",
    "start": 57.691,
    "end": 59.537,
    "duration": 1.846
  },
  {
    "id": 17,
    "text": "其思想深受道家庄子哲学与纵横家侠义精神浸润，",
    "start": 59.812,
    "end": 64.101,
    "duration": 4.289
  },
  {
    "id": 18,
    "text": "塑造了一个傲立王侯、追求绝对个体自由的抒情主体。",
    "start": 64.365,
    "end": 68.335,
    "duration": 3.97
  },
  {
    "id": 19,
    "text": "他宣告 “安能摧眉折腰事权贵”，",
    "start": 68.566,
    "end": 71.142,
    "duration": 2.576
  },
  {
    "id": 20,
    "text": "洋溢着盛世文人强烈的自我确信与超拔神采；",
    "start": 71.44,
    "end": 75.169,
    "duration": 3.729
  },
  {
    "id": 21,
    "text": "杜甫则亲历天宝乱离与国家沦丧，",
    "start": 75.379,
    "end": 78.069,
    "duration": 2.69
  },
  {
    "id": 22,
    "text": "其思想牢牢扎根于儒家“仁民爱物”与“穷则独善其身，",
    "start": 78.311,
    "end": 83.204,
    "duration": 4.893
  },
  {
    "id": 23,
    "text": "达则兼济天下”的传统。",
    "start": 83.379,
    "end": 85.056,
    "duration": 1.677
  },
  {
    "id": 24,
    "text": "他始终将自身身世之悲系于天下安危，",
    "start": 85.349,
    "end": 88.545,
    "duration": 3.196
  },
  {
    "id": 25,
    "text": "在 《自京赴奉先》 中发出 “穷年忧黎元，",
    "start": 88.643,
    "end": 92.02,
    "duration": 3.377
  },
  {
    "id": 26,
    "text": "叹息肠内热” 的沉痛关怀。",
    "start": 92.169,
    "end": 94.361,
    "duration": 2.192
  },
  {
    "id": 27,
    "text": "李白是盛唐自信个性的飞扬体现，",
    "start": 94.576,
    "end": 97.049,
    "duration": 2.473
  },
  {
    "id": 28,
    "text": "杜甫是盛唐精神走向深沉反思的理性结晶。",
    "start": 97.512,
    "end": 101.032,
    "duration": 3.52
  },
  {
    "id": 29,
    "text": "第二，在审美风貌与情感机制上，",
    "start": 101.235,
    "end": 103.868,
    "duration": 2.633
  },
  {
    "id": 30,
    "text": "呈现飘逸奔放的清水芙蓉与波澜低回的沉郁顿挫。",
    "start": 104.169,
    "end": 108.251,
    "duration": 4.082
  },
  {
    "id": 31,
    "text": "在风格机制上，李白崇尚 “清水出芙蓉，天然去雕饰”，",
    "start": 108.383,
    "end": 112.651,
    "duration": 4.268
  },
  {
    "id": 32,
    "text": "其情感如大江奔涌，喷薄欲出而一泻千里。",
    "start": 112.712,
    "end": 115.918,
    "duration": 3.206
  },
  {
    "id": 33,
    "text": "在 《将进酒》 中，",
    "start": 116.184,
    "end": 117.302,
    "duration": 1.118
  },
  {
    "id": 34,
    "text": "以 “君不见黄河之水天上来” 的宏阔狂飙破题，",
    "start": 117.519,
    "end": 121.513,
    "duration": 3.994
  },
  {
    "id": 35,
    "text": "诗情起伏跌宕却豪放洒脱；杜甫则以 “沉郁顿挫” 称绝，",
    "start": 121.938,
    "end": 127.244,
    "duration": 5.306
  },
  {
    "id": 36,
    "text": "思想感情沉深宏厚，表现章法反复低回。",
    "start": 127.418,
    "end": 131.065,
    "duration": 3.647
  },
  {
    "id": 37,
    "text": "在 《登高》 中，",
    "start": 131.319,
    "end": 132.185,
    "duration": 0.866
  },
  {
    "id": 38,
    "text": "将万里悲秋的壮阔江天与老病孤舟的残年身世绞合在一起；",
    "start": 132.442,
    "end": 137.705,
    "duration": 5.263
  },
  {
    "id": 39,
    "text": "在 《自京赴奉先》 中，历经四起四落的情感克制转折。",
    "start": 137.943,
    "end": 142.365,
    "duration": 4.422
  },
  {
    "id": 40,
    "text": "李白之美在于飞扬壮阔的奇崛俊逸，",
    "start": 142.752,
    "end": 145.574,
    "duration": 2.822
  },
  {
    "id": 41,
    "text": "杜甫之美在于郁结盘旋的深沉悲凉。",
    "start": 145.875,
    "end": 148.955,
    "duration": 3.08
  },
  {
    "id": 42,
    "text": "第三，在表现手法与文体体裁上，",
    "start": 149.187,
    "end": 151.959,
    "duration": 2.772
  },
  {
    "id": 43,
    "text": "呈现天马行空的古体歌行与精严化境的近体律诗。",
    "start": 152.251,
    "end": 156.858,
    "duration": 4.607
  },
  {
    "id": 44,
    "text": "李白极力突破格律的束缚，",
    "start": 157.11,
    "end": 158.98,
    "duration": 1.87
  },
  {
    "id": 45,
    "text": "将主要创造力倾注于三五七言错落舒卷的古题乐府与长篇歌行。",
    "start": 159.186,
    "end": 164.507,
    "duration": 5.321
  },
  {
    "id": 46,
    "text": "在 《梦游天姥吟留别》《蜀道难》 中，",
    "start": 164.725,
    "end": 167.341,
    "duration": 2.616
  },
  {
    "id": 47,
    "text": "自由驱遣天界神仙与宇宙极境，极尽大胆奇幻的夸张之能事；",
    "start": 167.648,
    "end": 173.021,
    "duration": 5.373
  },
  {
    "id": 48,
    "text": "杜甫虽亦擅长古体叙事，",
    "start": 173.267,
    "end": 175.318,
    "duration": 2.051
  },
  {
    "id": 49,
    "text": "但其最高艺术造诣在于对律诗体制的全面集大成。",
    "start": 175.643,
    "end": 179.827,
    "duration": 4.184
  },
  {
    "id": 50,
    "text": "杜甫精研声病，晚年做到 “晚节渐于诗律细”，",
    "start": 179.972,
    "end": 183.715,
    "duration": 3.743
  },
  {
    "id": 51,
    "text": "更创立 “拗救” 与变格手法。",
    "start": 183.939,
    "end": 186.091,
    "duration": 2.152
  },
  {
    "id": 52,
    "text": "其 《秋兴八首》 将七律组诗推向登峰造极，",
    "start": 186.417,
    "end": 190.166,
    "duration": 3.749
  },
  {
    "id": 53,
    "text": "做到了形式精严而又浑融流转，",
    "start": 190.259,
    "end": 193.056,
    "duration": 2.797
  },
  {
    "id": 54,
    "text": "代表了近体诗律化的终极最高成就。",
    "start": 193.269,
    "end": 196.143,
    "duration": 2.874
  },
  {
    "id": 55,
    "text": "第四，共同构建中国古典诗歌的审美双璧，",
    "start": 196.387,
    "end": 199.834,
    "duration": 3.447
  },
  {
    "id": 56,
    "text": "确立不可动摇的万代宗师地位。",
    "start": 200.101,
    "end": 202.457,
    "duration": 2.356
  },
  {
    "id": 57,
    "text": "李白与杜甫并非相互排斥，",
    "start": 202.734,
    "end": 204.743,
    "duration": 2.009
  },
  {
    "id": 58,
    "text": "而是共同构成了中国诗歌精神的阴阳双翼。",
    "start": 205.082,
    "end": 208.121,
    "duration": 3.039
  },
  {
    "id": 59,
    "text": "李白为后代历代文人提供了超越尘世功利、",
    "start": 208.524,
    "end": 211.871,
    "duration": 3.347
  },
  {
    "id": 60,
    "text": "守护自由心灵的浪漫飞翔之翼；",
    "start": 212.078,
    "end": 214.57,
    "duration": 2.492
  },
  {
    "id": 61,
    "text": "杜甫为后代士人树立了扎根大地、",
    "start": 214.782,
    "end": 217.721,
    "duration": 2.939
  },
  {
    "id": 62,
    "text": "关怀生民疾苦的现实良心之锚。",
    "start": 217.803,
    "end": 220.513,
    "duration": 2.71
  },
  {
    "id": 63,
    "text": "中唐韩孟诗派与北宋苏轼得力于李白的浪漫狂放与豪迈气势；",
    "start": 220.709,
    "end": 226.105,
    "duration": 5.396
  },
  {
    "id": 64,
    "text": "白居易新乐府运动、",
    "start": 226.22,
    "end": 227.667,
    "duration": 1.447
  },
  {
    "id": 65,
    "text": "宋代黄庭坚与江西诗派则取法于杜甫的写实规矩与精严法度。",
    "start": 227.811,
    "end": 232.897,
    "duration": 5.086
  },
  {
    "id": 66,
    "text": "李杜双峰并峙，共同奠定了中国诗歌史上不可逾越的审美巅峰。",
    "start": 233.166,
    "end": 238.104,
    "duration": 4.938
  }
]
