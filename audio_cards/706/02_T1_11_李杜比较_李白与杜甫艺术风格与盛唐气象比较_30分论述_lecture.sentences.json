[
  {
    "id": 1,
    "text": "试论李白与杜甫艺术风格的异同及其在唐代诗歌史上的地位。",
    "start": 0.05,
    "end": 5.736,
    "duration": 5.686
  },
  {
    "id": 2,
    "text": "李白与杜甫是中国古典诗歌发展史上双峰并峙的双子星座，",
    "start": 5.736,
    "end": 11.244,
    "duration": 5.508
  },
  {
    "id": 3,
    "text": "共同代表了唐诗繁荣的最高巅峰。",
    "start": 11.244,
    "end": 14.584,
    "duration": 3.34
  },
  {
    "id": 4,
    "text": "身处盛唐极盛向安史之乱剧变转折的不同历史节点，",
    "start": 14.584,
    "end": 19.304,
    "duration": 4.72
  },
  {
    "id": 5,
    "text": "李白承接开元天宝昂扬开放的盛世风貌，",
    "start": 19.304,
    "end": 22.827,
    "duration": 3.523
  },
  {
    "id": 6,
    "text": "将追求绝对精神自由的浪漫主义推向极致；",
    "start": 22.827,
    "end": 26.428,
    "duration": 3.601
  },
  {
    "id": 7,
    "text": "杜甫面对天宝以后盛极而衰的战乱浩劫，将悲悯苍生、",
    "start": 26.428,
    "end": 31.335,
    "duration": 4.907
  },
  {
    "id": 8,
    "text": "关怀家国的现实主义推向极境。",
    "start": 31.335,
    "end": 34.282,
    "duration": 2.947
  },
  {
    "id": 9,
    "text": "韩愈赞云 “李杜文章在，光焰万丈长”；",
    "start": 34.282,
    "end": 38.173,
    "duration": 3.891
  },
  {
    "id": 10,
    "text": "严羽 《沧浪诗话》 称 “少陵诗法如孙吴，",
    "start": 38.173,
    "end": 41.848,
    "duration": 3.675
  },
  {
    "id": 11,
    "text": "太白诗法如李广”。",
    "start": 41.848,
    "end": 43.496,
    "duration": 1.648
  },
  {
    "id": 12,
    "text": "二人在艺术风格、文体造诣与精神品格上的异同，",
    "start": 43.496,
    "end": 47.558,
    "duration": 4.062
  },
  {
    "id": 13,
    "text": "主要展现为以下四个核心维度：",
    "start": 47.558,
    "end": 49.949,
    "duration": 2.391
  },
  {
    "id": 14,
    "text": "第一，在时代坐标与精神追求上，",
    "start": 49.949,
    "end": 52.898,
    "duration": 2.949
  },
  {
    "id": 15,
    "text": "呈现追求个体精神解放与承担家国忧患的显著差异。",
    "start": 52.898,
    "end": 57.701,
    "duration": 4.803
  },
  {
    "id": 16,
    "text": "李白身处开元全盛时期，",
    "start": 57.701,
    "end": 59.83,
    "duration": 2.129
  },
  {
    "id": 17,
    "text": "其思想深受道家庄子哲学与纵横家侠义精神浸润，",
    "start": 59.83,
    "end": 64.377,
    "duration": 4.547
  },
  {
    "id": 18,
    "text": "塑造了一个傲立王侯、追求绝对个体自由的抒情主体。",
    "start": 64.377,
    "end": 68.576,
    "duration": 4.199
  },
  {
    "id": 19,
    "text": "他宣告 “安能摧眉折腰事权贵”，",
    "start": 68.576,
    "end": 71.45,
    "duration": 2.874
  },
  {
    "id": 20,
    "text": "洋溢着盛世文人强烈的自我确信与超拔神采；",
    "start": 71.45,
    "end": 75.389,
    "duration": 3.939
  },
  {
    "id": 21,
    "text": "杜甫则亲历天宝乱离与国家沦丧，",
    "start": 75.389,
    "end": 78.324,
    "duration": 2.935
  },
  {
    "id": 22,
    "text": "其思想牢牢扎根于儒家“仁民爱物”与“穷则独善其身，",
    "start": 78.324,
    "end": 83.389,
    "duration": 5.065
  },
  {
    "id": 23,
    "text": "达则兼济天下”的传统。",
    "start": 83.389,
    "end": 85.359,
    "duration": 1.97
  },
  {
    "id": 24,
    "text": "他始终将自身身世之悲系于天下安危，",
    "start": 85.359,
    "end": 88.655,
    "duration": 3.296
  },
  {
    "id": 25,
    "text": "在 《自京赴奉先》 中发出 “穷年忧黎元，",
    "start": 88.655,
    "end": 92.179,
    "duration": 3.524
  },
  {
    "id": 26,
    "text": "叹息肠内热” 的沉痛关怀。",
    "start": 92.179,
    "end": 94.587,
    "duration": 2.408
  },
  {
    "id": 27,
    "text": "李白是盛唐自信个性的飞扬体现，",
    "start": 94.587,
    "end": 97.522,
    "duration": 2.935
  },
  {
    "id": 28,
    "text": "杜甫是盛唐精神走向深沉反思的理性结晶。",
    "start": 97.522,
    "end": 101.245,
    "duration": 3.723
  },
  {
    "id": 29,
    "text": "第二，在审美风貌与情感机制上，",
    "start": 101.245,
    "end": 104.179,
    "duration": 2.934
  },
  {
    "id": 30,
    "text": "呈现飘逸奔放的清水芙蓉与波澜低回的沉郁顿挫。",
    "start": 104.179,
    "end": 108.394,
    "duration": 4.215
  },
  {
    "id": 31,
    "text": "在风格机制上，李白崇尚 “清水出芙蓉，天然去雕饰”，",
    "start": 108.394,
    "end": 112.724,
    "duration": 4.33
  },
  {
    "id": 32,
    "text": "其情感如大江奔涌，喷薄欲出而一泻千里。",
    "start": 112.724,
    "end": 116.194,
    "duration": 3.47
  },
  {
    "id": 33,
    "text": "在 《将进酒》 中，",
    "start": 116.194,
    "end": 117.532,
    "duration": 1.338
  },
  {
    "id": 34,
    "text": "以 “君不见黄河之水天上来” 的宏阔狂飙破题，",
    "start": 117.532,
    "end": 121.952,
    "duration": 4.42
  },
  {
    "id": 35,
    "text": "诗情起伏跌宕却豪放洒脱；杜甫则以 “沉郁顿挫” 称绝，",
    "start": 121.952,
    "end": 127.431,
    "duration": 5.479
  },
  {
    "id": 36,
    "text": "思想感情沉深宏厚，表现章法反复低回。",
    "start": 127.431,
    "end": 131.336,
    "duration": 3.905
  },
  {
    "id": 37,
    "text": "在 《登高》 中，",
    "start": 131.336,
    "end": 132.236,
    "duration": 0.9
  },
  {
    "id": 38,
    "text": "将万里悲秋的壮阔江天与老病孤舟的残年身世绞合在一起；",
    "start": 132.236,
    "end": 136.782,
    "duration": 4.546
  },
  {
    "id": 39,
    "text": "在 《自京赴奉先》 中，历经四起四落的情感克制转折。",
    "start": 136.782,
    "end": 140.418,
    "duration": 3.636
  },
  {
    "id": 40,
    "text": "李白之美在于飞扬壮阔的奇崛俊逸，",
    "start": 140.418,
    "end": 143.612,
    "duration": 3.194
  },
  {
    "id": 41,
    "text": "杜甫之美在于郁结盘旋的深沉悲凉。",
    "start": 143.612,
    "end": 147.102,
    "duration": 3.49
  },
  {
    "id": 42,
    "text": "第三，在表现手法与文体体裁上，",
    "start": 147.102,
    "end": 149.961,
    "duration": 2.859
  },
  {
    "id": 43,
    "text": "呈现天马行空的古体歌行与精严化境的近体律诗。",
    "start": 149.961,
    "end": 154.832,
    "duration": 4.871
  },
  {
    "id": 44,
    "text": "李白极力突破格律的束缚，",
    "start": 154.832,
    "end": 157.12,
    "duration": 2.288
  },
  {
    "id": 45,
    "text": "将主要创造力倾注于三五七言错落舒卷的古题乐府与长篇歌行。",
    "start": 157.12,
    "end": 162.699,
    "duration": 5.579
  },
  {
    "id": 46,
    "text": "在 《梦游天姥吟留别》《蜀道难》 中，",
    "start": 162.699,
    "end": 166.468,
    "duration": 3.769
  },
  {
    "id": 47,
    "text": "自由驱遣天界神仙与宇宙极境，极尽大胆奇幻的夸张之能事；",
    "start": 166.468,
    "end": 171.013,
    "duration": 4.545
  },
  {
    "id": 48,
    "text": "杜甫虽亦擅长古体叙事，",
    "start": 171.013,
    "end": 173.277,
    "duration": 2.264
  },
  {
    "id": 49,
    "text": "但其最高艺术造诣在于对律诗体制的全面集大成。",
    "start": 173.277,
    "end": 177.228,
    "duration": 3.951
  },
  {
    "id": 50,
    "text": "杜甫精研声病，晚年做到 “晚节渐于诗律细”，",
    "start": 177.228,
    "end": 181.278,
    "duration": 4.05
  },
  {
    "id": 51,
    "text": "更创立 “拗救” 与变格手法。",
    "start": 181.278,
    "end": 183.949,
    "duration": 2.671
  },
  {
    "id": 52,
    "text": "其 《秋兴八首》 将七律组诗推向登峰造极，",
    "start": 183.949,
    "end": 187.783,
    "duration": 3.834
  },
  {
    "id": 53,
    "text": "做到了形式精严而又浑融流转，",
    "start": 187.783,
    "end": 190.269,
    "duration": 2.486
  },
  {
    "id": 54,
    "text": "代表了近体诗律化的终极最高成就。",
    "start": 190.269,
    "end": 193.279,
    "duration": 3.01
  },
  {
    "id": 55,
    "text": "第四，共同构建中国古典诗歌的审美双璧，",
    "start": 193.279,
    "end": 197.172,
    "duration": 3.893
  },
  {
    "id": 56,
    "text": "确立不可动摇的万代宗师地位。",
    "start": 197.172,
    "end": 200.116,
    "duration": 2.944
  },
  {
    "id": 57,
    "text": "李白与杜甫并非相互排斥，",
    "start": 200.116,
    "end": 202.748,
    "duration": 2.632
  },
  {
    "id": 58,
    "text": "而是共同构成了中国诗歌精神的阴阳双翼。",
    "start": 202.748,
    "end": 206.674,
    "duration": 3.926
  },
  {
    "id": 59,
    "text": "李白为后代历代文人提供了超越尘世功利、",
    "start": 206.674,
    "end": 212.097,
    "duration": 5.423
  },
  {
    "id": 60,
    "text": "守护自由心灵的浪漫飞翔之翼；",
    "start": 212.097,
    "end": 214.792,
    "duration": 2.695
  },
  {
    "id": 61,
    "text": "杜甫为后代士人树立了扎根大地、",
    "start": 214.792,
    "end": 217.814,
    "duration": 3.022
  },
  {
    "id": 62,
    "text": "关怀生民疾苦的现实良心之锚。",
    "start": 217.814,
    "end": 220.719,
    "duration": 2.905
  },
  {
    "id": 63,
    "text": "中唐韩孟诗派与北宋苏轼得力于李白的浪漫狂放与豪迈气势；",
    "start": 220.719,
    "end": 226.231,
    "duration": 5.512
  },
  {
    "id": 64,
    "text": "白居易新乐府运动、",
    "start": 226.231,
    "end": 227.822,
    "duration": 1.591
  },
  {
    "id": 65,
    "text": "宋代黄庭坚与江西诗派则取法于杜甫的写实规矩与精严法度。",
    "start": 227.822,
    "end": 233.177,
    "duration": 5.355
  },
  {
    "id": 66,
    "text": "李杜双峰并峙，共同奠定了中国诗歌史上不可逾越的审美巅峰。",
    "start": 233.177,
    "end": 238.104,
    "duration": 4.927
  }
]