[
  {
    "id": 1,
    "text": "试论白居易的新乐府运动主张与讽谕诗艺术特色。",
    "start": 0.0,
    "end": 4.318,
    "duration": 4.318
  },
  {
    "id": 2,
    "text": "白居易是中唐新乐府运动的理论倡导者与卓越领袖。",
    "start": 4.318,
    "end": 8.535,
    "duration": 4.217
  },
  {
    "id": 3,
    "text": "面对安史之乱后藩镇割据加剧、",
    "start": 8.535,
    "end": 11.192,
    "duration": 2.657
  },
  {
    "id": 4,
    "text": "土地兼并严重与宦官弄权的社会危机，",
    "start": 11.192,
    "end": 14.623,
    "duration": 3.431
  },
  {
    "id": 5,
    "text": "白居易上承 《诗经》 六义与杜甫即事名篇的现实主义传统，",
    "start": 14.623,
    "end": 20.796,
    "duration": 6.173
  },
  {
    "id": 6,
    "text": "发起了中国文学史上最具自觉批判精神的诗歌革新运动。",
    "start": 20.796,
    "end": 23.813,
    "duration": 3.017
  },
  {
    "id": 7,
    "text": "他主张恢复诗歌讽谕教化的政治功能，使文学成为干预现实、",
    "start": 23.813,
    "end": 31.489,
    "duration": 7.676
  },
  {
    "id": 8,
    "text": "救济生民的强大思想武器。",
    "start": 31.489,
    "end": 34.083,
    "duration": 2.594
  },
  {
    "id": 9,
    "text": "其新乐府理论主张与讽谕诗艺术特色，",
    "start": 34.083,
    "end": 37.301,
    "duration": 3.218
  },
  {
    "id": 10,
    "text": "主要展现为以下四个核心维度：",
    "start": 37.301,
    "end": 38.854,
    "duration": 1.553
  },
  {
    "id": 11,
    "text": "第一，系统确立“文章合为时而著，",
    "start": 38.854,
    "end": 40.489,
    "duration": 1.635
  },
  {
    "id": 12,
    "text": "歌诗合为事而作”的现实主义诗学纲领。",
    "start": 40.489,
    "end": 46.108,
    "duration": 5.619
  },
  {
    "id": 13,
    "text": "在著名的 《与元九书》 中，白居易全面阐释了其文学主张。",
    "start": 46.108,
    "end": 51.287,
    "duration": 5.179
  },
  {
    "id": 14,
    "text": "他将诗歌与时代政治紧密相连，明确提出 “文章合为时而著，",
    "start": 51.287,
    "end": 55.498,
    "duration": 4.211
  },
  {
    "id": 15,
    "text": "歌诗合为事而作”。",
    "start": 55.498,
    "end": 58.294,
    "duration": 2.796
  },
  {
    "id": 16,
    "text": "白居易追溯诗歌源头，提出诗歌 “根情，苗言，华声，",
    "start": 58.294,
    "end": 63.524,
    "duration": 5.23
  },
  {
    "id": 17,
    "text": "实义” 的有机整体观，强调诗歌的本质在于“实义”，",
    "start": 63.524,
    "end": 67.907,
    "duration": 4.383
  },
  {
    "id": 18,
    "text": "即必须具备严肃的思想内容与社会功用；",
    "start": 67.907,
    "end": 71.581,
    "duration": 3.674
  },
  {
    "id": 19,
    "text": "他极力提倡诗歌应当起到 “补察时政，",
    "start": 71.581,
    "end": 75.178,
    "duration": 3.597
  },
  {
    "id": 20,
    "text": "泄导人情” 的批判讽谕作用。",
    "start": 75.178,
    "end": 78.156,
    "duration": 2.978
  },
  {
    "id": 21,
    "text": "这一诗学纲领彻底扭转了齐梁余风与大历以来沉溺于吟咏风月、",
    "start": 78.156,
    "end": 82.67,
    "duration": 4.514
  },
  {
    "id": 22,
    "text": "逃避现实的狭窄诗风，将文学引向直面国计民生的阔大正途。",
    "start": 82.67,
    "end": 88.431,
    "duration": 5.761
  },
  {
    "id": 23,
    "text": "第二，确立“即事名篇，无复依傍”的创作原则，",
    "start": 88.431,
    "end": 92.629,
    "duration": 4.198
  },
  {
    "id": 24,
    "text": "全面直面社会黑暗现实。",
    "start": 92.629,
    "end": 94.056,
    "duration": 1.427
  },
  {
    "id": 25,
    "text": "在具体创作上，",
    "start": 94.056,
    "end": 95.493,
    "duration": 1.437
  },
  {
    "id": 26,
    "text": "白居易与元稹倡导摆脱汉魏乐府古题的陈旧束缚，",
    "start": 95.493,
    "end": 99.656,
    "duration": 4.163
  },
  {
    "id": 27,
    "text": "确立了 “新乐府” 这一全新范式。",
    "start": 99.656,
    "end": 103.158,
    "duration": 3.502
  },
  {
    "id": 28,
    "text": "白居易所创作的 《新乐府》 五十首与 《秦中吟》 十首，",
    "start": 103.158,
    "end": 104.769,
    "duration": 1.611
  },
  {
    "id": 29,
    "text": "严格恪守“因事立题，题称其事”的原则，",
    "start": 104.769,
    "end": 111.029,
    "duration": 6.26
  },
  {
    "id": 30,
    "text": "取材全取自元和年间的当代社会矛盾。",
    "start": 111.029,
    "end": 113.115,
    "duration": 2.086
  },
  {
    "id": 31,
    "text": "在代表作 《卖炭翁》 中，",
    "start": 113.115,
    "end": 113.878,
    "duration": 0.763
  },
  {
    "id": 32,
    "text": "作者以 “心忧炭贱愿天寒” 极写底层劳动人民生存处境的艰难矛盾，",
    "start": 113.878,
    "end": 121.37,
    "duration": 7.492
  },
  {
    "id": 33,
    "text": "以 “一车炭，千余斤，",
    "start": 121.37,
    "end": 123.026,
    "duration": 1.656
  },
  {
    "id": 34,
    "text": "宫使驱将惜不得” 深刻揭露宫市掠夺的蛮横霸道；",
    "start": 123.026,
    "end": 127.215,
    "duration": 4.189
  },
  {
    "id": 35,
    "text": "在 《观刈麦》 中，借妇儿提筐拾穗的凄凉细节，",
    "start": 127.215,
    "end": 132.564,
    "duration": 5.349
  },
  {
    "id": 36,
    "text": "反思自身 “念此私自愧，尽日不能忘” 的士大夫愧怍之情。",
    "start": 132.564,
    "end": 138.714,
    "duration": 6.15
  },
  {
    "id": 37,
    "text": "第三，实践“其辞质而径，其事核而实”的白描手法与平易诗风。",
    "start": 138.714,
    "end": 142.437,
    "duration": 3.723
  },
  {
    "id": 38,
    "text": "为了达到让“天下之人受其赐”的社会传播目的，",
    "start": 142.437,
    "end": 149.203,
    "duration": 6.766
  },
  {
    "id": 39,
    "text": "白居易在艺术形式上力求平易通俗。",
    "start": 149.203,
    "end": 150.973,
    "duration": 1.77
  },
  {
    "id": 40,
    "text": "他明确要求讽谕诗必须做到 “其辞质而径，其事核而实，",
    "start": 150.973,
    "end": 155.712,
    "duration": 4.739
  },
  {
    "id": 41,
    "text": "其体顺而肆，其音顺而哀”。",
    "start": 155.712,
    "end": 159.626,
    "duration": 3.914
  },
  {
    "id": 42,
    "text": "在语言上，他坚持通俗明畅、少用生僻典故，",
    "start": 159.626,
    "end": 164.046,
    "duration": 4.42
  },
  {
    "id": 43,
    "text": "甚至追求“老妪能解”的大众化审美；在表现技巧上，",
    "start": 164.046,
    "end": 167.076,
    "duration": 3.03
  },
  {
    "id": 44,
    "text": "他善用白描手法与对比映衬，",
    "start": 167.076,
    "end": 171.025,
    "duration": 3.949
  },
  {
    "id": 45,
    "text": "如 《轻肥》 中一边是贪官权贵 “樽罍溢九酝，",
    "start": 171.025,
    "end": 172.314,
    "duration": 1.289
  },
  {
    "id": 46,
    "text": "水陆罗八珍” 的极度奢靡，",
    "start": 172.314,
    "end": 174.677,
    "duration": 2.363
  },
  {
    "id": 47,
    "text": "一边是江南 “人吃人” 的赤地千里，两相对照，",
    "start": 174.677,
    "end": 177.677,
    "duration": 3.0
  },
  {
    "id": 48,
    "text": "展现出震人心魄的批判力量。",
    "start": 177.677,
    "end": 181.433,
    "duration": 3.756
  },
  {
    "id": 49,
    "text": "第四，以讽谕诗重构诗歌品类格局，",
    "start": 181.433,
    "end": 185.154,
    "duration": 3.721
  },
  {
    "id": 50,
    "text": "确立中唐现实主义诗歌的高峰地位。",
    "start": 185.154,
    "end": 187.952,
    "duration": 2.798
  },
  {
    "id": 51,
    "text": "白居易自编诗集，将自身诗歌划分为 “讽谕”、“闲适”、",
    "start": 187.952,
    "end": 192.332,
    "duration": 4.38
  },
  {
    "id": 52,
    "text": "“感伤”、“杂律” 四大品类，并明确以讽谕诗居于首位。",
    "start": 192.332,
    "end": 198.261,
    "duration": 5.929
  },
  {
    "id": 53,
    "text": "这种文体观念的重构，",
    "start": 198.261,
    "end": 199.928,
    "duration": 1.667
  },
  {
    "id": 54,
    "text": "不仅彰显出其以济世为怀的崇高政治抱负，更直接启迪了元稹、",
    "start": 199.928,
    "end": 205.134,
    "duration": 5.206
  },
  {
    "id": 55,
    "text": "张籍、王建等新乐府诗人的群体创作。",
    "start": 205.134,
    "end": 209.233,
    "duration": 4.099
  },
  {
    "id": 56,
    "text": "白居易的讽谕诗以卓越的社会责任感与独特的平民化语言，",
    "start": 209.233,
    "end": 213.898,
    "duration": 4.665
  },
  {
    "id": 57,
    "text": "构建起唐代现实主义诗歌传统中又一座承前启后的崇高丰碑。",
    "start": 213.898,
    "end": 218.664,
    "duration": 4.766
  }
]