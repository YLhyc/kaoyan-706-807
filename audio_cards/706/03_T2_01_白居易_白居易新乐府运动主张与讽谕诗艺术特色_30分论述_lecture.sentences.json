[
  {
    "id": 1,
    "text": "试论白居易的新乐府运动主张与讽谕诗艺术特色。",
    "start": 0.101,
    "end": 4.016,
    "duration": 3.915
  },
  {
    "id": 2,
    "text": "白居易是中唐新乐府运动的理论倡导者与卓越领袖。",
    "start": 4.506,
    "end": 8.531,
    "duration": 4.025
  },
  {
    "id": 3,
    "text": "面对安史之乱后藩镇割据、赋敛苛重与宦官专权的社会危机，",
    "start": 8.879,
    "end": 13.981,
    "duration": 5.102
  },
  {
    "id": 4,
    "text": "白居易上承《诗经》风雅比兴与杜甫即事名篇的现实主义传统，发起了自觉的诗歌革新运动。",
    "start": 14.345,
    "end": 21.399,
    "duration": 7.054
  },
  {
    "id": 5,
    "text": "他力主恢复诗歌美刺讽谕的政教功能，使诗歌成为针砭时弊、反映民生疾苦的有力武器。",
    "start": 21.674,
    "end": 29.057,
    "duration": 7.383
  },
  {
    "id": 6,
    "text": "其新乐府理论主张与讽谕诗艺术特色，主要体现在以下四个方面：",
    "start": 29.365,
    "end": 34.072,
    "duration": 4.707
  },
  {
    "id": 7,
    "text": "第一，确立“文章合为时而著，歌诗合为事而作”的现实主义诗学纲领。",
    "start": 34.729,
    "end": 40.853,
    "duration": 6.124
  },
  {
    "id": 8,
    "text": "在著名的《与元九书》中，白居易系统阐述了其诗学主张。",
    "start": 41.211,
    "end": 45.425,
    "duration": 4.214
  },
  {
    "id": 9,
    "text": "他把诗歌创作与时代政治紧密联系，",
    "start": 45.842,
    "end": 48.884,
    "duration": 3.042
  },
  {
    "id": 10,
    "text": "明确提出“文章合为时而著，歌诗合为事而作”的创作纲领，并提出诗歌“根情，苗言，华声，实义”的有机观，",
    "start": 49.002,
    "end": 58.288,
    "duration": 9.286
  },
  {
    "id": 11,
    "text": "强调诗的根本功用在于“补察时政，泄导人情”。",
    "start": 58.593,
    "end": 62.45,
    "duration": 3.857
  },
  {
    "id": 12,
    "text": "这一主张直接承接儒家诗教与杜甫写实道路，",
    "start": 62.782,
    "end": 66.371,
    "duration": 3.589
  },
  {
    "id": 13,
    "text": "有力扭转了齐梁余风及大历诗坛偏重吟咏风月、流连清雅的倾向，",
    "start": 66.684,
    "end": 72.429,
    "duration": 5.745
  },
  {
    "id": 14,
    "text": "将诗歌重新引向直面国计民生的正途。",
    "start": 72.849,
    "end": 75.978,
    "duration": 3.129
  },
  {
    "id": 15,
    "text": "第二，践行“即事名篇，无复依傍”的创作原则，尖锐揭露社会矛盾。",
    "start": 76.619,
    "end": 82.22,
    "duration": 5.601
  },
  {
    "id": 16,
    "text": "在创作实践上，白居易与元稹倡导摆脱汉魏乐府古题的旧壳，创立“新乐府”体式。",
    "start": 82.552,
    "end": 89.586,
    "duration": 7.034
  },
  {
    "id": 17,
    "text": "白居易所作《新乐府》五十首与《秦中吟》十首，大多一篇专咏一事，",
    "start": 89.973,
    "end": 95.216,
    "duration": 5.243
  },
  {
    "id": 18,
    "text": "“首句标其目，卒章显其志”，直接取材于元和年间的现实矛盾。",
    "start": 95.56,
    "end": 100.684,
    "duration": 5.124
  },
  {
    "id": 19,
    "text": "在《卖炭翁》中，以“心忧炭贱愿天寒”细摹老人艰难矛盾的心理，",
    "start": 101.139,
    "end": 106.548,
    "duration": 5.409
  },
  {
    "id": 20,
    "text": "以“一车炭，千余斤，宫使驱将惜不得”揭露宫市掠夺的横暴；",
    "start": 107.131,
    "end": 112.31,
    "duration": 5.179
  },
  {
    "id": 21,
    "text": "在《观刈麦》中，借贫妇拾穗的凄凉细节，",
    "start": 112.895,
    "end": 116.857,
    "duration": 3.962
  },
  {
    "id": 22,
    "text": "发为“念此私自愧，尽日不能忘”的深刻自省，流露出深切的同情。",
    "start": 117.118,
    "end": 122.312,
    "duration": 5.194
  },
  {
    "id": 23,
    "text": "第三，遵循“其辞质而径，其言直而切”的标准，形成平易通俗的诗风。",
    "start": 122.993,
    "end": 129.637,
    "duration": 6.644
  },
  {
    "id": 24,
    "text": "为了使民情上达天听、教化广泛流传，",
    "start": 129.912,
    "end": 133.071,
    "duration": 3.159
  },
  {
    "id": 25,
    "text": "白居易在《新乐府序》中提出了明确的标准：",
    "start": 133.664,
    "end": 136.486,
    "duration": 2.822
  },
  {
    "id": 26,
    "text": "“其辞质而径，欲见之者易谕也；",
    "start": 137.219,
    "end": 140.23,
    "duration": 3.011
  },
  {
    "id": 27,
    "text": "其言直而切，欲闻之者深诫也；",
    "start": 140.612,
    "end": 143.483,
    "duration": 2.871
  },
  {
    "id": 28,
    "text": "其事核而实，使采之者传信也；",
    "start": 143.795,
    "end": 146.718,
    "duration": 2.923
  },
  {
    "id": 29,
    "text": "其体顺而肆，可以播于乐章歌曲也。”",
    "start": 146.953,
    "end": 150.6,
    "duration": 3.647
  },
  {
    "id": 30,
    "text": "他坚持语言浅显明畅、多用日常口语，",
    "start": 150.6,
    "end": 153.223,
    "duration": 2.623
  },
  {
    "id": 31,
    "text": "避免艰深用典，并善用白描与对比映衬手法。",
    "start": 153.406,
    "end": 156.809,
    "duration": 3.403
  },
  {
    "id": 32,
    "text": "如《轻肥》中，一边写内臣大夫“樽罍溢九酝，水陆罗八珍”的骄奢宴乐，",
    "start": 157.153,
    "end": 163.237,
    "duration": 6.084
  },
  {
    "id": 33,
    "text": "一边冷峻点出“是岁江南旱，衢州人食人”，形成震撼人心的强烈对照。",
    "start": 163.461,
    "end": 169.453,
    "duration": 5.992
  },
  {
    "id": 34,
    "text": "第四，以讽谕诗重塑诗歌品类格局，巩固中唐现实主义诗潮。",
    "start": 170.09,
    "end": 175.261,
    "duration": 5.171
  },
  {
    "id": 35,
    "text": "白居易自编诗集，将平生诗作划分为“讽谕”“闲适”“感伤”“杂律”四类，并把体现兼济之志的讽谕诗置诸首位。",
    "start": 175.604,
    "end": 185.751,
    "duration": 10.147
  },
  {
    "id": 36,
    "text": "这一分类凸显了其“惟歌生民病，愿得天子知”的社会抱负，",
    "start": 186.367,
    "end": 191.13,
    "duration": 4.763
  },
  {
    "id": 37,
    "text": "虽有时因过于偏重讽谏说教而稍损含蓄，却直接推动了元稹、张籍、王建等新乐府诗人的群体创作，",
    "start": 191.363,
    "end": 199.557,
    "duration": 8.194
  },
  {
    "id": 38,
    "text": "在中唐诗坛掀起了波澜壮阔的写实诗潮。",
    "start": 199.8,
    "end": 202.942,
    "duration": 3.142
  },
  {
    "id": 39,
    "text": "综上所述，白居易在中唐社会危机之中积极推行新乐府诗歌革新，",
    "start": 203.144,
    "end": 208.164,
    "duration": 5.02
  },
  {
    "id": 40,
    "text": "以“文章合为时而著，歌诗合为事而作”为纲领，",
    "start": 208.164,
    "end": 212.484,
    "duration": 4.32
  },
  {
    "id": 41,
    "text": "借通俗明畅的叙事笔法直击民生疾苦。",
    "start": 212.484,
    "end": 215.924,
    "duration": 3.44
  },
  {
    "id": 42,
    "text": "虽然部分讽谕诗因刻意说教而略显直露，但其自觉发扬杜甫即事名篇的精神并带动元稹、张籍等诗人呼应，",
    "start": 215.924,
    "end": 224.884,
    "duration": 8.96
  },
  {
    "id": 43,
    "text": "在中唐诗坛重新高扬起关心世事的现实主义传统。",
    "start": 224.884,
    "end": 229.972,
    "duration": 5.088
  }
]