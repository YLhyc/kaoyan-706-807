[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《诗经》·艺术成就与赋比兴传统",
    "start": 0.134,
    "end": 3.106,
    "duration": 2.972
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "先以“赋比兴”解决情物交融的表达之法，再落于“重章叠句”营造民歌复奏结构，",
    "start": 3.58,
    "end": 11.432,
    "duration": 7.852
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "进而升华出“风雅美刺”写实精神，最后在语言层以“四言二二节拍”奠定汉语诗律基石。",
    "start": 11.66,
    "end": 19.432,
    "duration": 7.772
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《诗经》是中国古代第一部诗歌总集与现实主义源头，反映西周至春秋中叶五百余年生活。",
    "start": 19.96,
    "end": 27.812,
    "duration": 7.852
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "《毛诗序》将“风雅颂”诗体与“赋比兴”技法合称《诗》之“六义”，并论风诗功用曰“风以动之，教以化之”。",
    "start": 27.85,
    "end": 37.622,
    "duration": 9.772
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 系统确立“赋、比、兴”表现手法",
    "start": 38.065,
    "end": 41.357,
    "duration": 3.292
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "“赋者，敷陈其事而直言之也”，如《豳风·七月》按岁时顺序铺叙农夫四季耕织艰辛；",
    "start": 41.855,
    "end": 49.867,
    "duration": 8.012
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "“比者，以彼物比此物也”，如《魏风·硕鼠》把贪婪剥削者比作大老鼠，讽刺辛辣；",
    "start": 50.289,
    "end": 58.541,
    "duration": 8.252
  },
  {
    "id": "sec0_step2_c0",
    "dom_key": "sec0_step2_c0",
    "text": "“兴者，先言他物以引起所咏之词也”，",
    "start": 58.79,
    "end": 62.89,
    "duration": 4.1
  },
  {
    "id": "sec0_step2_c1",
    "dom_key": "sec0_step2_c1",
    "text": "如《周南·关雎》以“关关雎鸠，在河之洲”起兴引出“窈窕淑女，君子好逑”；",
    "start": 62.905,
    "end": 70.082,
    "duration": 7.177
  },
  {
    "id": "sec0_step3_c0",
    "dom_key": "sec0_step3_c0",
    "text": "使客观物象与主观情感水乳交融，开创后世托物言志传统。",
    "start": 70.387,
    "end": 76.079,
    "duration": 5.692
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 采用重章叠句与回环复沓结构",
    "start": 76.748,
    "end": 80.36,
    "duration": 3.612
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "民歌广泛采用重章叠句，句式大致相同而仅更换少数同义或反义词，于反复吟唱中层层推进情感。",
    "start": 80.823,
    "end": 90.115,
    "duration": 9.292
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《秦风·蒹葭》三章叠唱：时间从“白露为霜”至“未晞”“未已”，",
    "start": 90.564,
    "end": 96.096,
    "duration": 5.532
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "空间由“宛在水中央”换至“水中坻”“水中沚”，抒发可望而不可即的惆怅。",
    "start": 96.404,
    "end": 102.256,
    "duration": 5.852
  },
  {
    "id": "sec1_step2_c0",
    "dom_key": "sec1_step2_c0",
    "text": "既强化音乐节律，更营造反复低回、情韵绵长的抒情氛围。",
    "start": 102.784,
    "end": 108.156,
    "duration": 5.372
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 开创关怀民生的“风雅”美刺精神",
    "start": 108.786,
    "end": 112.638,
    "duration": 3.852
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "“国风”与“小雅”中的怨刺诗与讽谕诗扎根世俗土壤，直面社会矛盾。",
    "start": 113.127,
    "end": 119.299,
    "duration": 6.172
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《魏风·伐檀》发出“不稼不穑，胡取禾三百廛兮”抗议；",
    "start": 119.781,
    "end": 125.793,
    "duration": 6.012
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "《豳风·东山》“零雨其濛”写征夫还乡酸楚；",
    "start": 125.991,
    "end": 130.243,
    "duration": 4.252
  },
  {
    "id": "sec2_step1_c2",
    "dom_key": "sec2_step1_c2",
    "text": "《小雅·采薇》“昔我往矣，杨柳依依；今我来思，雨雪霏霏”以乐景写哀。",
    "start": 130.281,
    "end": 137.623,
    "duration": 7.342
  },
  {
    "id": "sec2_step2_c0",
    "dom_key": "sec2_step2_c0",
    "text": "关注民生疾苦、干预现实，构成儒家“美刺”诗教优良传统。",
    "start": 138.151,
    "end": 143.843,
    "duration": 5.692
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 形成以四言为主的语言音律体式",
    "start": 144.465,
    "end": 148.157,
    "duration": 3.692
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "确立四言为主、二二节拍整齐节奏，同时吸纳二至八字长短句打破板滞。",
    "start": 148.653,
    "end": 156.105,
    "duration": 7.452
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "善用叠字拟声词，如《小雅·伐木》“伐木丁丁，鸟鸣嘤嘤”，",
    "start": 156.633,
    "end": 162.336,
    "duration": 5.703
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "《郑风·子衿》“青青子衿，悠悠我心”，摹声状物、声律和谐；",
    "start": 162.351,
    "end": 166.879,
    "duration": 4.528
  },
  {
    "id": "sec3_step2_c0",
    "dom_key": "sec3_step2_c0",
    "text": "广用双声叠韵与自然押韵，为汉魏以后五、七言诗歌提供语言音律滋养。",
    "start": 167.051,
    "end": 174.989,
    "duration": 7.938
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《诗经》以赋、比、兴技法、重章复沓音乐结构与二二节拍四言体式，",
    "start": 175.375,
    "end": 182.093,
    "duration": 6.718
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "将先秦民间歌咏与周代礼乐文化凝为一体，开创直面现实的风雅美刺精神与含蓄言志传统，滋养汉魏乐府至唐宋诗坛。",
    "start": 182.108,
    "end": 194.427,
    "duration": 12.319
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：《诗经》是北方黄河流域现实主义源头（四言为主）；《楚辞》是南方浪漫主义源头（杂言骚体，多用“兮”字）。",
    "start": 194.893,
    "end": 204.555,
    "duration": 9.662
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 何谓《诗》之“六义”？赋比兴各自代表篇目与名句？",
    "start": 205.034,
    "end": 211.336,
    "duration": 6.302
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 《蒹葭》如何通过换字推进时空与怅惘？",
    "start": 211.651,
    "end": 215.903,
    "duration": 4.252
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 《伐檀》《采薇》与《伐木》《子衿》分别印证哪两段论点？",
    "start": 216.371,
    "end": 221.823,
    "duration": 5.452
  }
]