[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《诗经》·艺术成就与赋比兴传统",
    "start": 0.134,
    "end": 2.802,
    "duration": 2.668
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "先以“赋比兴”解决情物交融的表达之法，再落于“重章叠句”营造民歌复奏结构，",
    "start": 3.391,
    "end": 10.63,
    "duration": 7.239
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "进而升华出“风雅美刺”写实精神，最后在语言层以“四言二二节拍”奠定汉语诗律基石。",
    "start": 10.826,
    "end": 18.195,
    "duration": 7.369
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《诗经》是中国古代第一部诗歌总集与现实主义源头，反映西周至春秋中叶五百余年生活。",
    "start": 18.782,
    "end": 26.424,
    "duration": 7.642
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "《毛诗序》将“风雅颂”诗体与“赋比兴”技法合称《诗》之“六义”，并论风诗功用曰“风以动之，教以化之”。",
    "start": 27.011,
    "end": 35.317,
    "duration": 8.306
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 系统确立“赋、比、兴”表现手法",
    "start": 35.878,
    "end": 39.757,
    "duration": 3.879
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "“赋者，敷陈其事而直言之也”，如《豳风·七月》按岁时顺序铺叙农夫四季耕织艰辛；",
    "start": 40.344,
    "end": 48.885,
    "duration": 8.541
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "“比者，以彼物比此物也”，如《魏风·硕鼠》把贪婪剥削者比作大老鼠，讽刺辛辣；",
    "start": 49.472,
    "end": 57.088,
    "duration": 7.616
  },
  {
    "id": "sec0_step2_c0",
    "dom_key": "sec0_step2_c0",
    "text": "“兴者，先言他物以引起所咏之词也”，",
    "start": 57.675,
    "end": 61.632,
    "duration": 3.957
  },
  {
    "id": "sec0_step2_c1",
    "dom_key": "sec0_step2_c1",
    "text": "如《周南·关雎》以“关关雎鸠，在河之洲”起兴引出“窈窕淑女，君子好逑”；",
    "start": 61.829,
    "end": 68.208,
    "duration": 6.379
  },
  {
    "id": "sec0_step3_c0",
    "dom_key": "sec0_step3_c0",
    "text": "使客观物象与主观情感水乳交融，开创后世托物言志传统。",
    "start": 68.795,
    "end": 74.797,
    "duration": 6.002
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 采用重章叠句与回环复沓结构",
    "start": 75.37,
    "end": 78.963,
    "duration": 3.593
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "民歌广泛采用重章叠句，句式大致相同而仅更换少数同义或反义词，于反复吟唱中层层推进情感。",
    "start": 79.55,
    "end": 89.497,
    "duration": 9.947
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《秦风·蒹葭》三章叠唱：时间从“白露为霜”至“未晞”“未已”，",
    "start": 90.084,
    "end": 96.307,
    "duration": 6.223
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "空间由“宛在水中央”换至“水中坻”“水中沚”，抒发可望而不可即的惆怅。",
    "start": 96.529,
    "end": 102.804,
    "duration": 6.275
  },
  {
    "id": "sec1_step2_c0",
    "dom_key": "sec1_step2_c0",
    "text": "既强化音乐节律，更营造反复低回、情韵绵长的抒情氛围。",
    "start": 103.378,
    "end": 109.145,
    "duration": 5.767
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 开创关怀民生的“风雅”美刺精神",
    "start": 109.732,
    "end": 113.221,
    "duration": 3.489
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "“国风”与“小雅”中的怨刺诗与讽谕诗扎根世俗土壤，直面社会矛盾。",
    "start": 113.808,
    "end": 119.927,
    "duration": 6.119
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《魏风·伐檀》发出“不稼不穑，胡取禾三百廛兮”抗议；",
    "start": 120.501,
    "end": 125.955,
    "duration": 5.455
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "《豳风·东山》“零雨其濛”写征夫还乡酸楚；",
    "start": 126.282,
    "end": 129.797,
    "duration": 3.515
  },
  {
    "id": "sec2_step1_c2",
    "dom_key": "sec2_step1_c2",
    "text": "《小雅·采薇》“昔我往矣，杨柳依依；今我来思，雨雪霏霏”以乐景写哀。",
    "start": 130.032,
    "end": 136.437,
    "duration": 6.405
  },
  {
    "id": "sec2_step2_c0",
    "dom_key": "sec2_step2_c0",
    "text": "关注民生疾苦、干预现实，构成儒家“美刺”诗教优良传统。",
    "start": 137.011,
    "end": 142.895,
    "duration": 5.884
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 形成以四言为主的语言音律体式",
    "start": 143.482,
    "end": 147.062,
    "duration": 3.58
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "确立四言为主、二二节拍整齐节奏，同时吸纳二至八字长短句打破板滞。",
    "start": 147.649,
    "end": 154.562,
    "duration": 6.913
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "善用叠字拟声词，如《小雅·伐木》“伐木丁丁，鸟鸣嘤嘤”，",
    "start": 155.149,
    "end": 161.177,
    "duration": 6.028
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "《郑风·子衿》“青青子衿，悠悠我心”，摹声状物、声律和谐；",
    "start": 161.36,
    "end": 166.515,
    "duration": 5.155
  },
  {
    "id": "sec3_step2_c0",
    "dom_key": "sec3_step2_c0",
    "text": "广用双声叠韵与自然押韵，为汉魏以后五、七言诗歌提供语言音律滋养。",
    "start": 167.102,
    "end": 174.172,
    "duration": 7.069
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《诗经》以赋、比、兴技法、重章复沓音乐结构与二二节拍四言体式，",
    "start": 174.745,
    "end": 180.903,
    "duration": 6.158
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "将先秦民间歌咏与周代礼乐文化凝为一体，开创直面现实的风雅美刺精神与含蓄言志传统，滋养汉魏乐府至唐宋诗坛。",
    "start": 181.23,
    "end": 192.227,
    "duration": 10.997
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：《诗经》是北方黄河流域现实主义源头（四言为主）；《楚辞》是南方浪漫主义源头（杂言骚体，多用“兮”字）。",
    "start": 192.801,
    "end": 202.839,
    "duration": 10.038
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 何谓《诗》之“六义”？赋比兴各自代表篇目与名句？",
    "start": 203.4,
    "end": 209.193,
    "duration": 5.793
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 《蒹葭》如何通过换字推进时空与怅惘？",
    "start": 209.767,
    "end": 214.584,
    "duration": 4.817
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 《伐檀》《采薇》与《伐木》《子衿》分别印证哪两段论点？",
    "start": 215.158,
    "end": 221.498,
    "duration": 6.34
  }
]