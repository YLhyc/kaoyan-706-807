[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《诗经》·艺术成就与赋比兴传统",
    "start": 0.314,
    "end": 3.206,
    "duration": 2.892
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "先以“赋比兴”解决情物交融的表达之法，再落于“重章叠句”营造民歌复奏结构，",
    "start": 4.174,
    "end": 11.786,
    "duration": 7.612
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "进而升华出“风雅美刺”写实精神，最后在语言层以“四言二二节拍”奠定汉语诗律基石。",
    "start": 12.054,
    "end": 19.786,
    "duration": 7.732
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《诗经》是中国古代第一部诗歌总集与现实主义源头，反映西周至春秋中叶五百余年生活。",
    "start": 20.874,
    "end": 29.246,
    "duration": 8.372
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "《毛诗序》将“风雅颂”诗体与“赋比兴”技法合称《诗》之“六义”，并论风诗功用曰“风以动之，教以化之”。",
    "start": 30.294,
    "end": 39.786,
    "duration": 9.492
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 系统确立“赋、比、兴”表现手法",
    "start": 40.794,
    "end": 44.326,
    "duration": 3.532
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "“赋者，敷陈其事而直言之也”，如《豳风·七月》按岁时顺序铺叙农夫四季耕织艰辛；",
    "start": 45.334,
    "end": 54.266,
    "duration": 8.932
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "“比者，以彼物比此物也”，如《魏风·硕鼠》把贪婪剥削者比作大老鼠，讽刺辛辣；",
    "start": 55.274,
    "end": 63.606,
    "duration": 8.332
  },
  {
    "id": "sec0_step2_c0",
    "dom_key": "sec0_step2_c0",
    "text": "“兴者，先言他物以引起所咏之词也”，",
    "start": 64.614,
    "end": 68.746,
    "duration": 4.132
  },
  {
    "id": "sec0_step2_c1",
    "dom_key": "sec0_step2_c1",
    "text": "如《周南·关雎》以“关关雎鸠，在河之洲”起兴引出“窈窕淑女，君子好逑”；",
    "start": 69.174,
    "end": 75.546,
    "duration": 6.372
  },
  {
    "id": "sec0_step3_c0",
    "dom_key": "sec0_step3_c0",
    "text": "使客观物象与主观情感水乳交融，开创后世托物言志传统。",
    "start": 76.514,
    "end": 82.446,
    "duration": 5.932
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 采用重章叠句与回环复沓结构",
    "start": 83.374,
    "end": 86.426,
    "duration": 3.052
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "民歌广泛采用重章叠句，句式大致相同而仅更换少数同义或反义词，于反复吟唱中层层推进情感。",
    "start": 87.474,
    "end": 97.166,
    "duration": 9.692
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《秦风·蒹葭》三章叠唱：时间从“白露为霜”至“未晞”“未已”，",
    "start": 97.914,
    "end": 103.446,
    "duration": 5.532
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "空间由“宛在水中央”换至“水中坻”“水中沚”，抒发可望而不可即的惆怅。",
    "start": 104.434,
    "end": 111.046,
    "duration": 6.612
  },
  {
    "id": "sec1_step2_c0",
    "dom_key": "sec1_step2_c0",
    "text": "既强化音乐节律，更营造反复低回、情韵绵长的抒情氛围。",
    "start": 112.054,
    "end": 118.546,
    "duration": 6.492
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 开创关怀民生的“风雅”美刺精神",
    "start": 119.474,
    "end": 123.086,
    "duration": 3.612
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "“国风”与“小雅”中的怨刺诗与讽谕诗扎根世俗土壤，直面社会矛盾。",
    "start": 124.094,
    "end": 131.226,
    "duration": 7.132
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《魏风·伐檀》发出“不稼不穑，胡取禾三百廛兮”抗议；",
    "start": 132.274,
    "end": 137.686,
    "duration": 5.412
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "《豳风·东山》“零雨其濛”写征夫还乡酸楚；",
    "start": 138.694,
    "end": 142.626,
    "duration": 3.932
  },
  {
    "id": "sec2_step1_c2",
    "dom_key": "sec2_step1_c2",
    "text": "《小雅·采薇》“昔我往矣，杨柳依依；今我来思，雨雪霏霏”以乐景写哀。",
    "start": 143.674,
    "end": 151.746,
    "duration": 8.072
  },
  {
    "id": "sec2_step2_c0",
    "dom_key": "sec2_step2_c0",
    "text": "关注民生疾苦、干预现实，构成儒家“美刺”诗教优良传统。",
    "start": 152.794,
    "end": 158.366,
    "duration": 5.572
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 形成以四言为主的语言音律体式",
    "start": 159.374,
    "end": 162.986,
    "duration": 3.612
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "确立四言为主、二二节拍整齐节奏，同时吸纳二至八字长短句打破板滞。",
    "start": 164.034,
    "end": 171.486,
    "duration": 7.452
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "善用叠字拟声词，如《小雅·伐木》“伐木丁丁，鸟鸣嘤嘤”，",
    "start": 171.974,
    "end": 178.266,
    "duration": 6.292
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "《郑风·子衿》“青青子衿，悠悠我心”，摹声状物、声律和谐；",
    "start": 178.614,
    "end": 183.746,
    "duration": 5.132
  },
  {
    "id": "sec3_step2_c0",
    "dom_key": "sec3_step2_c0",
    "text": "广用双声叠韵与自然押韵，为汉魏以后五、七言诗歌提供语言音律滋养。",
    "start": 184.274,
    "end": 191.526,
    "duration": 7.252
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《诗经》以赋、比、兴技法、重章复沓音乐结构与二二节拍四言体式，",
    "start": 192.306,
    "end": 198.798,
    "duration": 6.492
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "将先秦民间歌咏与周代礼乐文化凝为一体，开创直面现实的风雅美刺精神与含蓄言志传统，滋养汉魏乐府至唐宋诗坛。",
    "start": 199.226,
    "end": 210.278,
    "duration": 11.052
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：《诗经》是北方黄河流域现实主义源头（四言为主）；《楚辞》是南方浪漫主义源头（杂言骚体，多用“兮”字）。",
    "start": 211.326,
    "end": 222.558,
    "duration": 11.232
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 何谓《诗》之“六义”？赋比兴各自代表篇目与名句？",
    "start": 223.486,
    "end": 230.518,
    "duration": 7.032
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 《蒹葭》如何通过换字推进时空与怅惘？",
    "start": 231.446,
    "end": 236.338,
    "duration": 4.892
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 《伐檀》《采薇》与《伐木》《子衿》分别印证哪两段论点？",
    "start": 236.866,
    "end": 243.078,
    "duration": 6.212
  }
]