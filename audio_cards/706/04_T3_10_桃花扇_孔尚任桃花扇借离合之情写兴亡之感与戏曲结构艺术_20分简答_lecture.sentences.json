[
  {
    "id": 1,
    "text": "简述孔尚任《桃花扇》“借离合之情，",
    "start": 0.0,
    "end": 3.351,
    "duration": 3.351
  },
  {
    "id": 2,
    "text": "写兴亡之感”的思想主题与戏曲结构艺术。",
    "start": 3.351,
    "end": 7.026,
    "duration": 3.675
  },
  {
    "id": 3,
    "text": "孔尚任的 《桃花扇》 是清初历史传奇剧的巅峰之作，",
    "start": 7.026,
    "end": 12.28,
    "duration": 5.254
  },
  {
    "id": 4,
    "text": "与洪昇的 《长生殿》 并称为清代戏剧的 “双璧”。",
    "start": 12.28,
    "end": 14.433,
    "duration": 2.153
  },
  {
    "id": 5,
    "text": "孔尚任以明清鼎革的巨变历史为题材，",
    "start": 14.433,
    "end": 17.538,
    "duration": 3.105
  },
  {
    "id": 6,
    "text": "创作了一部具有深沉兴亡反思意识的政治历史剧。",
    "start": 17.538,
    "end": 21.748,
    "duration": 4.21
  },
  {
    "id": 7,
    "text": "作者在 《桃花扇小引》 中明确标举其宗旨：“借离合之情，",
    "start": 21.748,
    "end": 27.677,
    "duration": 5.929
  },
  {
    "id": 8,
    "text": "写兴亡之感。",
    "start": 27.677,
    "end": 29.304,
    "duration": 1.627
  },
  {
    "id": 9,
    "text": "”《桃花扇》 的思想主题与戏曲结构艺术，",
    "start": 29.304,
    "end": 34.609,
    "duration": 5.305
  },
  {
    "id": 10,
    "text": "主要展现为以下三个核心维度：",
    "start": 34.609,
    "end": 37.6,
    "duration": 2.991
  },
  {
    "id": 11,
    "text": "第一，确立“借离合之情，写兴亡之感”的主旨，",
    "start": 37.6,
    "end": 40.699,
    "duration": 3.099
  },
  {
    "id": 12,
    "text": "将儿女情长与南明覆亡紧密交融。",
    "start": 40.699,
    "end": 43.433,
    "duration": 2.734
  },
  {
    "id": 13,
    "text": "《桃花扇》 摒弃了传统才子佳人剧单纯沉溺于风月相悦的俗套，",
    "start": 43.433,
    "end": 50.781,
    "duration": 7.348
  },
  {
    "id": 14,
    "text": "将复社文人侯方域与秦淮名妓李香君的爱情悲欢，",
    "start": 50.781,
    "end": 55.512,
    "duration": 4.731
  },
  {
    "id": 15,
    "text": "与南明弘光小朝廷的建立、内讧及灭亡的历史血肉相连。",
    "start": 55.512,
    "end": 60.321,
    "duration": 4.809
  },
  {
    "id": 16,
    "text": "剧中展示的不仅是一对青年男女的爱恨离合，",
    "start": 60.321,
    "end": 63.991,
    "duration": 3.67
  },
  {
    "id": 17,
    "text": "更是通过这一线索，全景式暴露了阮大铖、",
    "start": 63.991,
    "end": 68.137,
    "duration": 4.146
  },
  {
    "id": 18,
    "text": "马士英等阉党余孽的专权营私，",
    "start": 68.137,
    "end": 71.445,
    "duration": 3.308
  },
  {
    "id": 19,
    "text": "以及史可法独木难支的悲壮殉国。",
    "start": 71.445,
    "end": 75.416,
    "duration": 3.971
  },
  {
    "id": 20,
    "text": "南明的覆亡摧毁了侯李二人的爱情归宿，",
    "start": 75.416,
    "end": 79.268,
    "duration": 3.852
  },
  {
    "id": 21,
    "text": "而二人的离合聚散亦成为南明政局动荡的晴雨表，",
    "start": 79.268,
    "end": 84.641,
    "duration": 5.373
  },
  {
    "id": 22,
    "text": "深刻揭示了国家兴亡对个体命运的绝对主宰。",
    "start": 84.641,
    "end": 88.616,
    "duration": 3.975
  },
  {
    "id": 23,
    "text": "第二，以“桃花扇”为全剧聚散离合的核心戏剧道具与象征纽带。",
    "start": 88.616,
    "end": 93.528,
    "duration": 4.912
  },
  {
    "id": 24,
    "text": "全剧在结构营构上展现出高度谨严的艺术匠心。",
    "start": 93.528,
    "end": 98.158,
    "duration": 4.63
  },
  {
    "id": 25,
    "text": "孔尚任匠心独运地以一柄 “桃花扇” 贯穿全剧四十出：",
    "start": 98.158,
    "end": 103.867,
    "duration": 5.709
  },
  {
    "id": 26,
    "text": "从定情时的题诗赠扇、权奸逼嫁时的血溅诗扇、",
    "start": 103.867,
    "end": 109.255,
    "duration": 5.388
  },
  {
    "id": 27,
    "text": "友人杨龙友点血染画成桃花扇，到入道时的撕碎道袍拂尘剖扇。",
    "start": 109.255,
    "end": 113.325,
    "duration": 4.07
  },
  {
    "id": 28,
    "text": "这柄扇子既是侯李爱情的信物，又是香君坚贞不屈气节的象征，",
    "start": 113.325,
    "end": 118.183,
    "duration": 4.858
  },
  {
    "id": 29,
    "text": "更是南明王朝由盛转衰、直至覆亡的历史见证。",
    "start": 118.183,
    "end": 122.493,
    "duration": 4.31
  },
  {
    "id": 30,
    "text": "全剧以扇生情，以扇见史，线索集中、针线细密，",
    "start": 122.493,
    "end": 127.245,
    "duration": 4.752
  },
  {
    "id": 31,
    "text": "达到了戏曲结构谨严化境。",
    "start": 127.245,
    "end": 131.672,
    "duration": 4.427
  },
  {
    "id": 32,
    "text": "第三，打破大团圆俗套，",
    "start": 131.672,
    "end": 134.555,
    "duration": 2.883
  },
  {
    "id": 33,
    "text": "以出家入道与家国幻灭铸就崇高的历史悲剧意蕴。",
    "start": 134.555,
    "end": 140.888,
    "duration": 6.333
  },
  {
    "id": 34,
    "text": "剧作的高超之处，",
    "start": 140.888,
    "end": 142.476,
    "duration": 1.588
  },
  {
    "id": 35,
    "text": "在于彻底突破了中国传统古典戏曲 “金榜题名、",
    "start": 142.476,
    "end": 143.486,
    "duration": 1.01
  },
  {
    "id": 36,
    "text": "破镜重圆” 的虚饰套路。",
    "start": 143.486,
    "end": 145.522,
    "duration": 2.036
  },
  {
    "id": 37,
    "text": "在终局白兆山栖霞道院中，",
    "start": 145.522,
    "end": 147.478,
    "duration": 1.956
  },
  {
    "id": 38,
    "text": "正当侯方域与李香君历经磨难即将重聚之际，张道士一声断喝：",
    "start": 147.478,
    "end": 148.975,
    "duration": 1.497
  },
  {
    "id": 39,
    "text": "“两个痴虫，你看国在哪里？",
    "start": 148.975,
    "end": 151.252,
    "duration": 2.277
  },
  {
    "id": 40,
    "text": "家在哪里？",
    "start": 151.252,
    "end": 153.186,
    "duration": 1.934
  },
  {
    "id": 41,
    "text": "君在哪里？",
    "start": 153.186,
    "end": 154.624,
    "duration": 1.438
  },
  {
    "id": 42,
    "text": "父在哪里？",
    "start": 154.624,
    "end": 155.923,
    "duration": 1.299
  },
  {
    "id": 43,
    "text": "” 犹如当头棒喝，惊醒了二人的世俗私情。",
    "start": 155.923,
    "end": 158.254,
    "duration": 2.331
  },
  {
    "id": 44,
    "text": "二人当下撕裂桃花扇、出家入道。",
    "start": 158.254,
    "end": 160.078,
    "duration": 1.824
  },
  {
    "id": 45,
    "text": "这一决绝结局彻底粉碎了私情执念，",
    "start": 160.078,
    "end": 161.917,
    "duration": 1.839
  },
  {
    "id": 46,
    "text": "将全剧由世俗情爱升华到对沧桑历史与家国沦丧的终极反思，",
    "start": 161.917,
    "end": 164.28,
    "duration": 2.363
  },
  {
    "id": 47,
    "text": "形成了深沉悲凉的史诗品格。",
    "start": 164.28,
    "end": 166.643,
    "duration": 2.363
  }
]