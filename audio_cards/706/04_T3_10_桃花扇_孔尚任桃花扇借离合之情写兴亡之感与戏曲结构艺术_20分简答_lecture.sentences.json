[
  {
    "id": 1,
    "text": "简述孔尚任《桃花扇》“借离合之情，",
    "start": 0.08,
    "end": 4.08,
    "duration": 4.0
  },
  {
    "id": 2,
    "text": "写兴亡之感”的思想主题与戏曲结构艺术。",
    "start": 4.08,
    "end": 7.92,
    "duration": 3.84
  },
  {
    "id": 3,
    "text": "孔尚任的 《桃花扇》 是清初历史传奇剧的巅峰之作，",
    "start": 7.92,
    "end": 12.56,
    "duration": 4.64
  },
  {
    "id": 4,
    "text": "与洪昇的 《长生殿》 并称为清代戏剧的 “双璧”。",
    "start": 12.56,
    "end": 16.72,
    "duration": 4.16
  },
  {
    "id": 5,
    "text": "孔尚任以明清鼎革的巨变历史为题材，",
    "start": 16.72,
    "end": 20.24,
    "duration": 3.52
  },
  {
    "id": 6,
    "text": "创作了一部具有深沉兴亡反思意识的政治历史剧。",
    "start": 20.24,
    "end": 24.88,
    "duration": 4.64
  },
  {
    "id": 7,
    "text": "作者在 《桃花扇小引》 中明确标举其宗旨：“借离合之情，",
    "start": 25.2,
    "end": 30.96,
    "duration": 5.76
  },
  {
    "id": 8,
    "text": "写兴亡之感。",
    "start": 30.96,
    "end": 31.92,
    "duration": 0.96
  },
  {
    "id": 9,
    "text": "”《桃花扇》 的思想主题与戏曲结构艺术，",
    "start": 31.92,
    "end": 36.48,
    "duration": 4.56
  },
  {
    "id": 10,
    "text": "主要展现为以下三个核心维度：",
    "start": 36.48,
    "end": 39.68,
    "duration": 3.2
  },
  {
    "id": 11,
    "text": "第一，确立“借离合之情，写兴亡之感”的主旨，",
    "start": 39.68,
    "end": 44.302,
    "duration": 4.622
  },
  {
    "id": 12,
    "text": "将儿女情长与南明覆亡紧密交融。",
    "start": 44.302,
    "end": 47.42,
    "duration": 3.118
  },
  {
    "id": 13,
    "text": "《桃花扇》 摒弃了传统才子佳人剧单纯沉溺于风月相悦的俗套，",
    "start": 47.42,
    "end": 53.241,
    "duration": 5.821
  },
  {
    "id": 14,
    "text": "将复社文人侯方域与秦淮名妓李香君的爱情悲欢，",
    "start": 53.241,
    "end": 57.814,
    "duration": 4.573
  },
  {
    "id": 15,
    "text": "与南明弘光小朝廷的建立、内讧及灭亡的历史血肉相连。",
    "start": 57.814,
    "end": 63.011,
    "duration": 5.197
  },
  {
    "id": 16,
    "text": "剧中展示的不仅是一对青年男女的爱恨离合，",
    "start": 63.011,
    "end": 67.168,
    "duration": 4.157
  },
  {
    "id": 17,
    "text": "更是通过这一线索，全景式暴露了阮大铖、",
    "start": 67.168,
    "end": 70.48,
    "duration": 3.312
  },
  {
    "id": 18,
    "text": "马士英等阉党余孽的专权营私，",
    "start": 70.48,
    "end": 73.52,
    "duration": 3.04
  },
  {
    "id": 19,
    "text": "以及史可法独木难支的悲壮殉国。",
    "start": 73.52,
    "end": 76.4,
    "duration": 2.88
  },
  {
    "id": 20,
    "text": "南明的覆亡摧毁了侯李二人的爱情归宿，",
    "start": 76.4,
    "end": 80.4,
    "duration": 4.0
  },
  {
    "id": 21,
    "text": "而二人的离合聚散亦成为南明政局动荡的晴雨表，",
    "start": 80.4,
    "end": 84.8,
    "duration": 4.4
  },
  {
    "id": 22,
    "text": "深刻揭示了国家兴亡对个体命运的绝对主宰。",
    "start": 84.8,
    "end": 88.24,
    "duration": 3.44
  },
  {
    "id": 23,
    "text": "第二，以“桃花扇”为全剧聚散离合的核心戏剧道具与象征纽带。",
    "start": 88.56,
    "end": 95.12,
    "duration": 6.56
  },
  {
    "id": 24,
    "text": "全剧在结构营构上展现出高度谨严的艺术匠心。",
    "start": 95.12,
    "end": 100.08,
    "duration": 4.96
  },
  {
    "id": 25,
    "text": "孔尚任匠心独运地以一柄 “桃花扇” 贯穿全剧四十出：",
    "start": 100.08,
    "end": 105.28,
    "duration": 5.2
  },
  {
    "id": 26,
    "text": "从定情时的题诗赠扇、权奸逼嫁时的血溅诗扇、",
    "start": 105.28,
    "end": 109.68,
    "duration": 4.4
  },
  {
    "id": 27,
    "text": "友人杨龙友点血染画成桃花扇，到入道时的撕碎道袍拂尘剖扇。",
    "start": 109.68,
    "end": 116.48,
    "duration": 6.8
  },
  {
    "id": 28,
    "text": "这柄扇子既是侯李爱情的信物，又是香君坚贞不屈气节的象征，",
    "start": 116.48,
    "end": 122.8,
    "duration": 6.32
  },
  {
    "id": 29,
    "text": "更是南明王朝由盛转衰、直至覆亡的历史见证。",
    "start": 122.8,
    "end": 126.88,
    "duration": 4.08
  },
  {
    "id": 30,
    "text": "全剧以扇生情，以扇见史，线索集中、针线细密，",
    "start": 127.184,
    "end": 131.264,
    "duration": 4.08
  },
  {
    "id": 31,
    "text": "达到了戏曲结构谨严化境。",
    "start": 131.584,
    "end": 134.144,
    "duration": 2.56
  },
  {
    "id": 32,
    "text": "第三，打破大团圆俗套，",
    "start": 134.144,
    "end": 136.624,
    "duration": 2.48
  },
  {
    "id": 33,
    "text": "以出家入道与家国幻灭铸就崇高的历史悲剧意蕴。",
    "start": 136.624,
    "end": 141.184,
    "duration": 4.56
  },
  {
    "id": 34,
    "text": "剧作的高超之处，",
    "start": 141.184,
    "end": 142.704,
    "duration": 1.52
  },
  {
    "id": 35,
    "text": "在于彻底突破了中国传统古典戏曲 “金榜题名、",
    "start": 142.704,
    "end": 147.584,
    "duration": 4.88
  },
  {
    "id": 36,
    "text": "破镜重圆” 的虚饰套路。",
    "start": 147.584,
    "end": 149.984,
    "duration": 2.4
  },
  {
    "id": 37,
    "text": "在终局白兆山栖霞道院中，",
    "start": 149.984,
    "end": 152.704,
    "duration": 2.72
  },
  {
    "id": 38,
    "text": "正当侯方域与李香君历经磨难即将重聚之际，张道士一声断喝：",
    "start": 152.704,
    "end": 159.824,
    "duration": 7.12
  },
  {
    "id": 39,
    "text": "“两个痴虫，你看国在哪里？",
    "start": 159.984,
    "end": 162.784,
    "duration": 2.8
  },
  {
    "id": 40,
    "text": "家在哪里？",
    "start": 162.784,
    "end": 163.744,
    "duration": 0.96
  },
  {
    "id": 41,
    "text": "君在哪里？",
    "start": 164.144,
    "end": 165.184,
    "duration": 1.04
  },
  {
    "id": 42,
    "text": "父在哪里？",
    "start": 165.184,
    "end": 166.224,
    "duration": 1.04
  },
  {
    "id": 43,
    "text": "” 犹如当头棒喝，惊醒了二人的世俗私情。",
    "start": 166.224,
    "end": 166.624,
    "duration": 0.4
  },
  {
    "id": 44,
    "text": "二人当下撕裂桃花扇、出家入道。",
    "start": 166.464,
    "end": 166.624,
    "duration": 0.16
  },
  {
    "id": 45,
    "text": "这一决绝结局彻底粉碎了私情执念，",
    "start": 166.464,
    "end": 166.624,
    "duration": 0.16
  },
  {
    "id": 46,
    "text": "将全剧由世俗情爱升华到对沧桑历史与家国沦丧的终极反思，",
    "start": 166.464,
    "end": 166.624,
    "duration": 0.16
  },
  {
    "id": 47,
    "text": "形成了深沉悲凉的史诗品格。",
    "start": 166.464,
    "end": 166.624,
    "duration": 0.16
  }
]