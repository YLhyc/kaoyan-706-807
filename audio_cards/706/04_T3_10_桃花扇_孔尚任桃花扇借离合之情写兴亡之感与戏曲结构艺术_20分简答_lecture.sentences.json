[
  {
    "id": 1,
    "text": "简述孔尚任《桃花扇》“借离合之情，写兴亡之感”的思想主题与戏曲结构艺术。",
    "start": 0.11,
    "end": 6.984,
    "duration": 6.874
  },
  {
    "id": 2,
    "text": "孔尚任的《桃花扇》与洪昇《长生殿》并称清初戏剧“双璧”，",
    "start": 7.484,
    "end": 12.064,
    "duration": 4.58
  },
  {
    "id": 3,
    "text": "是一部严守“征实求信”原则的政治历史传奇。",
    "start": 12.464,
    "end": 15.982,
    "duration": 3.518
  },
  {
    "id": 4,
    "text": "作者在试一出《先声》中点明主旨：“借离合之情，写兴亡之感。”其思想意蕴与结构艺术，主要体现在以下三个方面：",
    "start": 16.482,
    "end": 26.298,
    "duration": 9.816
  },
  {
    "id": 5,
    "text": "第一，紧扣“借离合之情，写兴亡之感”，将儿女情缘与南明覆亡血肉相连。",
    "start": 26.892,
    "end": 33.735,
    "duration": 6.843
  },
  {
    "id": 6,
    "text": "《桃花扇》摆脱了才子佳人剧单纯流连风月的旧套，",
    "start": 34.235,
    "end": 37.72,
    "duration": 3.485
  },
  {
    "id": 7,
    "text": "将复社文人侯方域与秦淮名妓李香君的聚散悲欢，",
    "start": 38.098,
    "end": 42.168,
    "duration": 4.07
  },
  {
    "id": 8,
    "text": "严密嵌入南明弘光朝廷建立、党争内讧直至覆亡的历史进程之中。",
    "start": 42.518,
    "end": 47.967,
    "duration": 5.449
  },
  {
    "id": 9,
    "text": "全剧借二人的命运浮沉，揭露马士英、阮大铖等权奸营私误国的丑行，",
    "start": 48.467,
    "end": 54.72,
    "duration": 6.253
  },
  {
    "id": 10,
    "text": "歌颂史可法、李香君、柳敬亭等人坚守气节的崇高品格。",
    "start": 55.07,
    "end": 60.188,
    "duration": 5.118
  },
  {
    "id": 11,
    "text": "南明灭亡摧毁了二人的爱情归宿，国运兴衰支配个体离合，",
    "start": 60.818,
    "end": 65.708,
    "duration": 4.89
  },
  {
    "id": 12,
    "text": "深刻寄寓了作者痛定思痛的历史反思。",
    "start": 66.058,
    "end": 68.975,
    "duration": 2.917
  },
  {
    "id": 13,
    "text": "第二，以“桃花扇”为贯穿全剧的线索道具与象征纽带，结构精巧谨严。",
    "start": 69.57,
    "end": 75.531,
    "duration": 5.961
  },
  {
    "id": 14,
    "text": "孔尚任极重戏剧构造，以一柄“桃花扇”串联起全剧四十出的纷繁头绪：",
    "start": 76.031,
    "end": 81.239,
    "duration": 5.208
  },
  {
    "id": 15,
    "text": "从侯李定情题诗赠扇、权奸逼嫁时香君溅血诗扇、杨龙友以画笔点染成桃花扇，到终局张瑶星道士怒而撕扇。",
    "start": 81.589,
    "end": 91.986,
    "duration": 10.397
  },
  {
    "id": 16,
    "text": "这柄扇子既是侯李定情信物与香君气节象征，又是南明政局盛衰的见证。",
    "start": 92.486,
    "end": 99.039,
    "duration": 6.553
  },
  {
    "id": 17,
    "text": "全剧以扇联结儿女情与兴亡史，双线交错而又脉络贯通，",
    "start": 99.646,
    "end": 104.987,
    "duration": 5.341
  },
  {
    "id": 18,
    "text": "起伏转折而不枝不蔓，体现了高度谨严的结构匠心。",
    "start": 105.533,
    "end": 110.126,
    "duration": 4.593
  },
  {
    "id": 19,
    "text": "第三，打破大团圆俗套，以入道幻灭铸就崇高悲凉的历史悲剧意蕴。",
    "start": 110.763,
    "end": 116.386,
    "duration": 5.623
  },
  {
    "id": 20,
    "text": "剧作突破了传统戏曲“破镜重圆”的虚饰结局。",
    "start": 116.886,
    "end": 120.529,
    "duration": 3.643
  },
  {
    "id": 21,
    "text": "终局南京栖霞山白云庵中，侯方域与李香君劫后重聚之际，",
    "start": 121.029,
    "end": 125.811,
    "duration": 4.782
  },
  {
    "id": 22,
    "text": "张瑶星道士一声呵斥：“两个痴虫，你看国在哪里？家在哪里？君在哪里？父在哪里？”随后撕碎桃花扇，",
    "start": 126.161,
    "end": 134.892,
    "duration": 8.731
  },
  {
    "id": 23,
    "text": "二人冷汗淋漓、如梦忽醒，双双入道。",
    "start": 135.242,
    "end": 138.286,
    "duration": 3.044
  },
  {
    "id": 24,
    "text": "这一结局割断花月情根，将全剧由世俗儿女私情升华至对国家兴亡与沧桑历史的深沉反思，",
    "start": 138.786,
    "end": 146.716,
    "duration": 7.93
  },
  {
    "id": 25,
    "text": "赋予剧作悲凉雄浑的史诗格调。",
    "start": 147.066,
    "end": 149.59,
    "duration": 2.524
  }
]
