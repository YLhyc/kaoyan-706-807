[
  {
    "id": 1,
    "text": "简述孔尚任《桃花扇》“借离合之情，写兴亡之感”的思想主题与戏曲结构艺术。",
    "start": 0.11,
    "end": 6.984,
    "duration": 6.874
  },
  {
    "id": 2,
    "text": "孔尚任的《桃花扇》与洪昇《长生殿》并称清初戏剧“双璧”，",
    "start": 7.429,
    "end": 12.009,
    "duration": 4.58
  },
  {
    "id": 3,
    "text": "是一部严守“征实求信”原则的政治历史传奇。",
    "start": 12.409,
    "end": 15.927,
    "duration": 3.518
  },
  {
    "id": 4,
    "text": "作者在《桃花扇小引》中点明主旨：“借离合之情，写兴亡之感。”其思想意蕴与结构艺术，",
    "start": 16.185,
    "end": 23.76,
    "duration": 7.575
  },
  {
    "id": 5,
    "text": "主要体现在以下三个方面：",
    "start": 23.987,
    "end": 25.801,
    "duration": 1.814
  },
  {
    "id": 6,
    "text": "第一，紧扣“借离合之情，写兴亡之感”，将儿女情缘与南明覆亡血肉相连。",
    "start": 26.395,
    "end": 33.238,
    "duration": 6.843
  },
  {
    "id": 7,
    "text": "《桃花扇》摆脱了才子佳人剧单纯流连风月的旧套，",
    "start": 33.467,
    "end": 36.952,
    "duration": 3.485
  },
  {
    "id": 8,
    "text": "将复社文人侯方域与秦淮名妓李香君的聚散悲欢，",
    "start": 37.33,
    "end": 41.4,
    "duration": 4.07
  },
  {
    "id": 9,
    "text": "严密嵌入南明弘光朝廷建立、党争内讧直至覆亡的历史进程之中。",
    "start": 41.673,
    "end": 47.122,
    "duration": 5.449
  },
  {
    "id": 10,
    "text": "全剧借二人的命运浮沉，揭露马士英、阮大铖等权奸营私误国的丑行，",
    "start": 47.348,
    "end": 53.601,
    "duration": 6.253
  },
  {
    "id": 11,
    "text": "歌颂史可法、李香君、柳敬亭等人坚守气节的崇高品格。",
    "start": 53.935,
    "end": 59.053,
    "duration": 5.118
  },
  {
    "id": 12,
    "text": "南明灭亡摧毁了二人的爱情归宿，国运兴衰支配个体离合，",
    "start": 59.683,
    "end": 64.573,
    "duration": 4.89
  },
  {
    "id": 13,
    "text": "深刻寄寓了作者痛定思痛的历史反思。",
    "start": 64.864,
    "end": 67.781,
    "duration": 2.917
  },
  {
    "id": 14,
    "text": "第二，以“桃花扇”为贯穿全剧的线索道具与象征纽带，结构精巧谨严。",
    "start": 68.376,
    "end": 74.337,
    "duration": 5.961
  },
  {
    "id": 15,
    "text": "孔尚任极重戏剧构造，以一柄“桃花扇”串联起全剧四十出的纷繁头绪：",
    "start": 74.82,
    "end": 80.028,
    "duration": 5.208
  },
  {
    "id": 16,
    "text": "从侯李定情题诗赠扇、权奸逼嫁时香君溅血诗扇、杨龙友以画笔点染成桃花扇，",
    "start": 80.187,
    "end": 87.941,
    "duration": 7.754
  },
  {
    "id": 17,
    "text": "到终局张瑶星道士怒而撕扇。",
    "start": 88.067,
    "end": 90.584,
    "duration": 2.517
  },
  {
    "id": 18,
    "text": "这柄扇子既是侯李定情信物与香君气节象征，又是南明政局盛衰的见证。",
    "start": 90.948,
    "end": 97.501,
    "duration": 6.553
  },
  {
    "id": 19,
    "text": "全剧以扇联结儿女情与兴亡史，双线交错而又脉络贯通，",
    "start": 98.108,
    "end": 103.449,
    "duration": 5.341
  },
  {
    "id": 20,
    "text": "起伏转折而不枝不蔓，体现了高度谨严的结构匠心。",
    "start": 103.995,
    "end": 108.588,
    "duration": 4.593
  },
  {
    "id": 21,
    "text": "第三，打破大团圆俗套，以入道幻灭铸就崇高悲凉的历史悲剧意蕴。",
    "start": 109.225,
    "end": 114.848,
    "duration": 5.623
  },
  {
    "id": 22,
    "text": "剧作突破了传统戏曲“破镜重圆”的虚饰结局。",
    "start": 115.116,
    "end": 118.759,
    "duration": 3.643
  },
  {
    "id": 23,
    "text": "终局南京栖霞山白云庵中，侯方域与李香君劫后重聚之际，",
    "start": 118.99,
    "end": 123.772,
    "duration": 4.782
  },
  {
    "id": 24,
    "text": "张瑶星道士一声呵斥：“两个痴虫，你看国在哪里？家在哪里？君在哪里？父在哪里？”随后撕碎桃花扇，",
    "start": 123.966,
    "end": 132.898,
    "duration": 8.932
  },
  {
    "id": 25,
    "text": "二人冷汗淋漓、如梦忽醒，双双入道。",
    "start": 133.009,
    "end": 136.028,
    "duration": 3.019
  },
  {
    "id": 26,
    "text": "这一结局割断花月情根，将全剧由世俗儿女私情升华至对国家兴亡与沧桑历史的深沉反思，",
    "start": 136.327,
    "end": 144.257,
    "duration": 7.93
  },
  {
    "id": 27,
    "text": "赋予剧作悲凉雄浑的史诗格调。",
    "start": 144.56,
    "end": 147.084,
    "duration": 2.524
  }
]