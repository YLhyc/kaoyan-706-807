[
  {
    "id": 1,
    "text": "题型，三十分论述题。",
    "start": 0.08,
    "end": 1.853,
    "duration": 1.773
  },
  {
    "id": 2,
    "text": "分值，三十分。",
    "start": 1.853,
    "end": 2.947,
    "duration": 1.094
  },
  {
    "id": 3,
    "text": "建议考场时间，三十五分钟。",
    "start": 2.947,
    "end": 5.356,
    "duration": 2.409
  },
  {
    "id": 4,
    "text": "目标字数，一千一百五十到一千三百字。",
    "start": 5.356,
    "end": 8.859,
    "duration": 3.503
  },
  {
    "id": 5,
    "text": "答题骨架，晚唐巅峰定性、趋近于、",
    "start": 8.859,
    "end": 11.705,
    "duration": 2.846
  },
  {
    "id": 6,
    "text": "朦胧多义的寄托与象征意蕴、趋近于、",
    "start": 11.705,
    "end": 14.989,
    "duration": 3.284
  },
  {
    "id": 7,
    "text": "沉博绝丽的意象营造与精严律体、趋近于、",
    "start": 14.989,
    "end": 18.712,
    "duration": 3.723
  },
  {
    "id": 8,
    "text": "心灵内向化与感伤主义审美形态、趋近于、",
    "start": 18.712,
    "end": 22.434,
    "duration": 3.722
  },
  {
    "id": 9,
    "text": "晚唐诗歌转型总结与宏观升华。",
    "start": 22.434,
    "end": 25.28,
    "duration": 2.846
  },
  {
    "id": 10,
    "text": "晚唐诗人李商隐是中国古典抒情诗史上独树一帜的天才大家，",
    "start": 25.36,
    "end": 30.8,
    "duration": 5.44
  },
  {
    "id": 11,
    "text": "其创造的“无题诗”群体代表了唐代近体律诗在表现心灵幽微体验上的最高峰孪。",
    "start": 30.8,
    "end": 37.6,
    "duration": 6.8
  },
  {
    "id": 12,
    "text": "李商隐以其沉博绝丽的辞采与迷离朦胧的象征意象，",
    "start": 37.6,
    "end": 41.84,
    "duration": 4.24
  },
  {
    "id": 13,
    "text": "彻底打破了传统诗歌直白写实与单纯比兴的规约，",
    "start": 41.84,
    "end": 46.16,
    "duration": 4.32
  },
  {
    "id": 14,
    "text": "深刻折射了晚唐士人在帝国衰颓历史语境中心灵内向化的审美转型。",
    "start": 46.16,
    "end": 51.76,
    "duration": 5.6
  },
  {
    "id": 15,
    "text": "第一，在思想寄托与意蕴生成上，李商隐无题诗开创了朦胧多义、",
    "start": 52.0,
    "end": 58.16,
    "duration": 6.16
  },
  {
    "id": 16,
    "text": "隐微难测的象征表现范式。",
    "start": 58.16,
    "end": 60.72,
    "duration": 2.56
  },
  {
    "id": 17,
    "text": "诗人在诗题上或标以“无题”，或截取首句二字为题，",
    "start": 60.72,
    "end": 65.44,
    "duration": 4.72
  },
  {
    "id": 18,
    "text": "刻意隐去具体写作背景与现实寄托对象，",
    "start": 65.44,
    "end": 69.2,
    "duration": 3.76
  },
  {
    "id": 19,
    "text": "使得诗歌摆脱了单一事件的具象束缚。",
    "start": 69.2,
    "end": 72.08,
    "duration": 2.88
  },
  {
    "id": 20,
    "text": "金代元好问曾感叹“诗家总爱西昆好，",
    "start": 72.4,
    "end": 76.08,
    "duration": 3.68
  },
  {
    "id": 21,
    "text": "独恨无人作郑笺”，正揭示出其多义含蓄的特质。",
    "start": 76.08,
    "end": 80.56,
    "duration": 4.48
  },
  {
    "id": 22,
    "text": "在这些诗篇中，执着凄艳的男女爱恋与幽微深沉的政治身世感慨深度交融。",
    "start": 80.56,
    "end": 87.12,
    "duration": 6.56
  },
  {
    "id": 23,
    "text": "以《无题•相见时难别亦难》为例，",
    "start": 87.12,
    "end": 89.84,
    "duration": 2.72
  },
  {
    "id": 24,
    "text": "“春蚕到死丝方尽，蜡炬成灰泪始干”既是对至死不渝爱情的生命誓言，",
    "start": 89.84,
    "end": 96.16,
    "duration": 6.32
  },
  {
    "id": 25,
    "text": "亦深层折射出诗人在牛李党争夹缝中忠贞自守却终生碰壁的仕途悲歌。",
    "start": 96.16,
    "end": 102.16,
    "duration": 6.0
  },
  {
    "id": 26,
    "text": "这种“似情非情，兼含寄托”的意蕴膜糊性，",
    "start": 102.48,
    "end": 106.0,
    "duration": 3.52
  },
  {
    "id": 27,
    "text": "极大地拓展了诗歌的阐释空间。",
    "start": 106.0,
    "end": 108.32,
    "duration": 2.32
  },
  {
    "id": 28,
    "text": "第二，在艺术造境与意象营构上，作品展现出沉博绝丽、",
    "start": 108.704,
    "end": 113.584,
    "duration": 4.88
  },
  {
    "id": 29,
    "text": "神思飞越的意象拼贴手法与精纯老到的七律技巧。",
    "start": 113.584,
    "end": 117.824,
    "duration": 4.24
  },
  {
    "id": 30,
    "text": "李商隐极善于调动神话传说、历史典故与虚幻梦境，",
    "start": 117.824,
    "end": 122.384,
    "duration": 4.56
  },
  {
    "id": 31,
    "text": "将跨度极大的意象非逻辑地组接在一起，",
    "start": 122.384,
    "end": 126.064,
    "duration": 3.68
  },
  {
    "id": 32,
    "text": "营构出幽艳迷离的心理时空。",
    "start": 126.064,
    "end": 128.624,
    "duration": 2.56
  },
  {
    "id": 33,
    "text": "其晚年压卷之作《锦瑟》堪称此中绝唱。",
    "start": 128.944,
    "end": 132.144,
    "duration": 3.2
  },
  {
    "id": 34,
    "text": "首联“锦瑟无端五十弦，一弦一柱思华年”以乐器引发生命回望。",
    "start": 132.144,
    "end": 138.224,
    "duration": 6.08
  },
  {
    "id": 35,
    "text": "汉联“庄生晓梦迷蝴蝶，望帝春心托杜娟”，",
    "start": 138.224,
    "end": 142.224,
    "duration": 4.0
  },
  {
    "id": 36,
    "text": "将庄周化蝶之虚无迷惘与望帝啼血之执着凄绝奇妙并置。",
    "start": 142.224,
    "end": 147.504,
    "duration": 5.28
  },
  {
    "id": 37,
    "text": "颈联“沧海月明珠有泪，蓝田日暖玉生烟”，",
    "start": 147.504,
    "end": 151.584,
    "duration": 4.08
  },
  {
    "id": 38,
    "text": "更是将冷暖、明暗、涕泪与精魂融铸为如梦似幻的通感画面，",
    "start": 151.584,
    "end": 156.544,
    "duration": 4.96
  },
  {
    "id": 39,
    "text": "达到了物我两忘、沉潜深微的极致境界。",
    "start": 156.544,
    "end": 159.744,
    "duration": 3.2
  },
  {
    "id": 40,
    "text": "同时，诗人严格恪守近体七言律诗的音律节奏，",
    "start": 159.984,
    "end": 164.304,
    "duration": 4.32
  },
  {
    "id": 41,
    "text": "平仄严谨，对仗工稳，展现出出神入化的形式驾驭力。",
    "start": 164.304,
    "end": 169.184,
    "duration": 4.88
  },
  {
    "id": 42,
    "text": "第三，从审美形态与历史脉络审视，",
    "start": 169.184,
    "end": 172.464,
    "duration": 3.28
  },
  {
    "id": 43,
    "text": "李商隐无题诗深刻标志着唐代诗歌从外向宏阔走向内向幽微的历史性转型。",
    "start": 172.464,
    "end": 179.744,
    "duration": 7.28
  },
  {
    "id": 44,
    "text": "盛唐诗歌如李杜高适，面向辽阔疆土与宏大功业，",
    "start": 179.744,
    "end": 184.304,
    "duration": 4.56
  },
  {
    "id": 45,
    "text": "气象沉雄昂扬，充满了健康的生命力。",
    "start": 184.304,
    "end": 187.744,
    "duration": 3.44
  },
  {
    "id": 46,
    "text": "中唐韩孟韩柳则重在向外抗争与求奇求险。",
    "start": 187.904,
    "end": 192.624,
    "duration": 4.72
  },
  {
    "id": 47,
    "text": "而身处晚唐暮世的李商隐，深感国势日蹙与个体命运的不可抗争，",
    "start": 192.624,
    "end": 198.464,
    "duration": 5.84
  },
  {
    "id": 48,
    "text": "其审美视线由广袤的现实社会全面退缩至孤寂敏锐的个体心灵深处。",
    "start": 198.464,
    "end": 204.384,
    "duration": 5.92
  },
  {
    "id": 49,
    "text": "在《无题•昨夜星辰昨夜风》中，“身无彩凤双飞翼，",
    "start": 204.384,
    "end": 208.464,
    "duration": 4.08
  },
  {
    "id": 50,
    "text": "心有灵犀一点通”的唱惘，呈现出一种前所未有的心灵孤立与执着追寻交织的情感机制。",
    "start": 208.464,
    "end": 215.504,
    "duration": 7.04
  },
  {
    "id": 51,
    "text": "这种内敛、深曲、凄清而又追求极致形式纯美的感伤主义倾向，",
    "start": 215.824,
    "end": 221.344,
    "duration": 5.52
  },
  {
    "id": 52,
    "text": "直接预示了唐宋之际审美趣味由雄浑向典雅幽深的大转型。",
    "start": 221.344,
    "end": 226.944,
    "duration": 5.6
  },
  {
    "id": 53,
    "text": "综上所述，李商隐无题诗以其朦胧幽深的意象网络、",
    "start": 226.944,
    "end": 231.424,
    "duration": 4.48
  },
  {
    "id": 54,
    "text": "精严沉郁的律诗典范与细腻敏锐的心灵开掘，",
    "start": 231.424,
    "end": 235.744,
    "duration": 4.32
  },
  {
    "id": 55,
    "text": "在中国诗歌史上构筑了一座空前绝后的纯美迷宫。",
    "start": 235.744,
    "end": 239.664,
    "duration": 3.92
  },
  {
    "id": 56,
    "text": "它不仅完成了古典抒情诗从言志纪实向深层意识表现的伟大跨越，",
    "start": 239.904,
    "end": 245.744,
    "duration": 5.84
  },
  {
    "id": 57,
    "text": "更为后世宋词细腻幽微的心理表现开辟了源头活水。",
    "start": 245.744,
    "end": 250.304,
    "duration": 4.56
  }
]