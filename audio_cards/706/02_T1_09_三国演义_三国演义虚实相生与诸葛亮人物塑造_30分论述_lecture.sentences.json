[
  {
    "id": 1,
    "text": "试论《三国演义》的“虚实相生”艺术与诸葛亮形象塑造。",
    "start": 0.101,
    "end": 4.358,
    "duration": 4.257
  },
  {
    "id": 2,
    "text": "《三国演义》是中国古代第一部长篇章回体历史演义小说，开辟了“据史演义”的小说传统。",
    "start": 4.858,
    "end": 11.609,
    "duration": 6.751
  },
  {
    "id": 3,
    "text": "罗贯中以陈寿《三国志》与裴松之注为历史框架，",
    "start": 12.109,
    "end": 15.982,
    "duration": 3.873
  },
  {
    "id": 4,
    "text": "熔裁宋元讲史话本与元代三国戏的民间积累，巧妙平衡了历史真实与艺术虚构的关系。",
    "start": 16.412,
    "end": 23.92,
    "duration": 7.508
  },
  {
    "id": 5,
    "text": "清代章学诚在《丙辰札记》中概括其特点为“七分事实，三分虚构”。",
    "start": 24.42,
    "end": 29.984,
    "duration": 5.564
  },
  {
    "id": 6,
    "text": "其虚实相生的叙事艺术与诸葛亮形象塑造，主要体现在以下四个方面：",
    "start": 30.484,
    "end": 36.454,
    "duration": 5.97
  },
  {
    "id": 7,
    "text": "第一，贯彻“七分事实，三分虚构”原则，以实托虚达成传奇与信史的统一。",
    "start": 37.076,
    "end": 43.644,
    "duration": 6.568
  },
  {
    "id": 8,
    "text": "《三国演义》遵循三国鼎立的历史大势，",
    "start": 44.144,
    "end": 46.719,
    "duration": 2.575
  },
  {
    "id": 9,
    "text": "重大战役胜负与主要历史人物的命运归宿均依傍史实基干，保持了演义正史的严肃脉络。",
    "start": 47.069,
    "end": 53.98,
    "duration": 6.911
  },
  {
    "id": 10,
    "text": "与此同时，作者并不拘泥于史料细节的机械照搬，",
    "start": 54.48,
    "end": 58.06,
    "duration": 3.58
  },
  {
    "id": 11,
    "text": "而是围绕美学理想对历史缝隙加以虚构生发，使实服从于虚。",
    "start": 58.41,
    "end": 63.545,
    "duration": 5.135
  },
  {
    "id": 12,
    "text": "例如“关羽过五关斩六将”“温酒斩华雄”“草船借箭”与“借东风”等经典情节，多属艺术虚构或移花接木。",
    "start": 64.045,
    "end": 72.067,
    "duration": 8.022
  },
  {
    "id": 13,
    "text": "这种虚实相生的笔法，既展现出历史兴亡的大局，又赋予小说跌宕起伏的传奇魅力。",
    "start": 72.567,
    "end": 79.044,
    "duration": 6.477
  },
  {
    "id": 14,
    "text": "第二，塑造“智绝”化身诸葛亮，树立儒家贤相与忠贞智慧典范。",
    "start": 79.719,
    "end": 85.298,
    "duration": 5.579
  },
  {
    "id": 15,
    "text": "诸葛亮是全书倾注理想最多的核心人物，集智慧与忠贞于一身。",
    "start": 85.798,
    "end": 90.663,
    "duration": 4.865
  },
  {
    "id": 16,
    "text": "在战略眼光上，他未出茅庐已能预见天下三分之势；",
    "start": 91.163,
    "end": 95.298,
    "duration": 4.135
  },
  {
    "id": 17,
    "text": "在外交与军事谋略上，他舌战群儒、巧激周瑜、草船借箭、空城退敌，展现出运筹帷幄的才华；",
    "start": 95.798,
    "end": 104.02,
    "duration": 8.222
  },
  {
    "id": 18,
    "text": "在道德品格上，作者紧扣儒家忠义伦理，凸显其“鞠躬尽瘁，死而后已”的担当精神。",
    "start": 104.52,
    "end": 111.429,
    "duration": 6.909
  },
  {
    "id": 19,
    "text": "尽管鲁迅曾批评其“状诸葛之多智而近妖”，指出了部分神化描写的夸饰之处，",
    "start": 111.929,
    "end": 118.293,
    "duration": 6.364
  },
  {
    "id": 20,
    "text": "诸葛亮形象依然成为古代文化中忠诚与智慧的经典化身。",
    "start": 118.911,
    "end": 123.713,
    "duration": 4.802
  },
  {
    "id": 21,
    "text": "第三，长于全景式战争叙事，在多方博弈中展开智谋与心理较量。",
    "start": 124.372,
    "end": 129.828,
    "duration": 5.456
  },
  {
    "id": 22,
    "text": "作为战争题材的章回巨制，《三国演义》在战争描写上技艺高超。",
    "start": 130.476,
    "end": 135.395,
    "duration": 4.919
  },
  {
    "id": 23,
    "text": "全书描写大小数十场战役，各具面貌而不雷同，既写战场厮杀的声势，更着重刻画战前各方势力的政治外交博弈与心理较量。",
    "start": 135.895,
    "end": 146.2,
    "duration": 10.305
  },
  {
    "id": 24,
    "text": "在代表性的“赤壁之战”中，作者以大量篇幅铺陈蒋干中计、周瑜打黄盖、诸葛亮借箭、庞统献连环计等连环谋略，",
    "start": 146.7,
    "end": 155.805,
    "duration": 9.105
  },
  {
    "id": 25,
    "text": "最终由火烧赤壁推向高潮，生动呈现出知己知彼、以弱胜强的战争智慧与辩证思维。",
    "start": 156.155,
    "end": 163.005,
    "duration": 6.85
  },
  {
    "id": 26,
    "text": "第四，贯注“拥刘反曹”道德倾向，渗透天下分合的沧桑之思。",
    "start": 163.668,
    "end": 168.584,
    "duration": 4.916
  },
  {
    "id": 27,
    "text": "在思想倾向上，《三国演义》鲜明体现出“拥刘反曹”的情感取向，借刘备集团的仁德宽厚寄托民众对清明政治的渴望。",
    "start": 169.247,
    "end": 178.055,
    "duration": 8.808
  },
  {
    "id": 28,
    "text": "同时，全书以“天下大势，分久必合，合久必分”统领兴衰，",
    "start": 178.587,
    "end": 182.725,
    "duration": 4.138
  },
  {
    "id": 29,
    "text": "清初毛纶、毛宗岗父子评改本更在卷首添置杨慎《临江仙》词“滚滚长江东逝水，浪花淘尽英雄”，",
    "start": 183.075,
    "end": 192.445,
    "duration": 9.37
  },
  {
    "id": 30,
    "text": "强化了深沉的历史沧桑感。",
    "start": 192.805,
    "end": 194.741,
    "duration": 1.936
  },
  {
    "id": 31,
    "text": "小说通过魏、蜀、吴三国终归于晋的结局，表达了对乱世纷争与英雄功业归于流逝的深长叹惋。",
    "start": 195.241,
    "end": 203.6,
    "duration": 8.359
  },
  {
    "id": 32,
    "text": "由是观之，《三国演义》依托“七分事实，三分虚构”的创作法则，",
    "start": 204.124,
    "end": 209.006,
    "duration": 4.882
  },
  {
    "id": 33,
    "text": "融通正史脉络与民间讲史传说，在波澜壮阔的战争博弈中塑造出诸葛亮等忠义智勇的艺术典型。",
    "start": 209.451,
    "end": 217.798,
    "duration": 8.347
  },
  {
    "id": 34,
    "text": "全书贯注“拥刘反曹”的民间道德理想与天下分合的历史沧桑感，",
    "start": 218.347,
    "end": 223.848,
    "duration": 5.501
  },
  {
    "id": 35,
    "text": "不仅确立了中国古代历史演义小说的体制规范，也深刻塑造了民族文化记忆中的忠义精神。",
    "start": 224.34,
    "end": 231.262,
    "duration": 6.922
  }
]
