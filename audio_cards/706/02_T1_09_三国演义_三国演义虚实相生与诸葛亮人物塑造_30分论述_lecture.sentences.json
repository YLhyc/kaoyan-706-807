[
  {
    "id": 1,
    "text": "试论《三国演义》的“虚实相生”艺术与诸葛亮形象塑造。",
    "start": 0.05,
    "end": 4.74,
    "duration": 4.69
  },
  {
    "id": 2,
    "text": "《三国演义》 是中国古代第一部长篇章回体历史演义小说，",
    "start": 4.74,
    "end": 9.669,
    "duration": 4.929
  },
  {
    "id": 3,
    "text": "开辟了中国古典小说“据史演义”的宏大传统。",
    "start": 9.669,
    "end": 13.281,
    "duration": 3.612
  },
  {
    "id": 4,
    "text": "面对元末明初动荡不安的社会现实与人民对国家统一的渴求，",
    "start": 13.281,
    "end": 18.126,
    "duration": 4.845
  },
  {
    "id": 5,
    "text": "罗贯中以陈寿 《三国志》 与裴松之注为基本史料框架，",
    "start": 18.126,
    "end": 22.803,
    "duration": 4.677
  },
  {
    "id": 6,
    "text": "熔裁宋元民间讲史话本与戏曲积累，",
    "start": 22.803,
    "end": 25.936,
    "duration": 3.133
  },
  {
    "id": 7,
    "text": "创造性地平衡了历史真实与艺术虚构的关系。",
    "start": 25.936,
    "end": 29.634,
    "duration": 3.698
  },
  {
    "id": 8,
    "text": "章学诚在 《丙辰札记》 中精辟概括其特点为 “七分事态，",
    "start": 29.634,
    "end": 35.745,
    "duration": 6.111
  },
  {
    "id": 9,
    "text": "三分虚构”。",
    "start": 35.745,
    "end": 37.774,
    "duration": 2.029
  },
  {
    "id": 10,
    "text": "其虚实相生的叙事艺术与诸葛亮形象塑造，",
    "start": 37.774,
    "end": 41.047,
    "duration": 3.273
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：",
    "start": 41.047,
    "end": 43.411,
    "duration": 2.364
  },
  {
    "id": 12,
    "text": "第一，确立“七分事实，三分虚构”的创作原则，",
    "start": 43.411,
    "end": 46.95,
    "duration": 3.539
  },
  {
    "id": 13,
    "text": "达成历史规律与艺术传奇的有机统一。",
    "start": 46.95,
    "end": 50.74,
    "duration": 3.79
  },
  {
    "id": 14,
    "text": "《三国演义》 严格遵循历史发展的基本脉络，",
    "start": 50.74,
    "end": 55.429,
    "duration": 4.689
  },
  {
    "id": 15,
    "text": "三国鼎立的大局变迁、",
    "start": 55.429,
    "end": 57.066,
    "duration": 1.637
  },
  {
    "id": 16,
    "text": "重大战役胜负与主要历史人物的生卒结局均据史直书，",
    "start": 57.066,
    "end": 62.652,
    "duration": 5.586
  },
  {
    "id": 17,
    "text": "保持了历史演进的严肃逻辑。",
    "start": 62.652,
    "end": 64.833,
    "duration": 2.181
  },
  {
    "id": 18,
    "text": "然而，作者绝不拘泥于史实细节的机械照搬，",
    "start": 64.833,
    "end": 68.536,
    "duration": 3.703
  },
  {
    "id": 19,
    "text": "而是通过合情合理的虚构对历史缝隙进行艺术填充。",
    "start": 68.536,
    "end": 73.33,
    "duration": 4.794
  },
  {
    "id": 20,
    "text": "例如 “关羽过五关斩六将”、“温酒斩华雄”、",
    "start": 73.33,
    "end": 76.269,
    "duration": 2.939
  },
  {
    "id": 21,
    "text": "“草船借箭” 与 “借东风” 等脍炙人口的经典情节，",
    "start": 76.269,
    "end": 80.598,
    "duration": 4.329
  },
  {
    "id": 22,
    "text": "多属艺术虚构或移花接木。",
    "start": 80.598,
    "end": 82.598,
    "duration": 2.0
  },
  {
    "id": 23,
    "text": "这种虚实相生的笔法，既让读者深切把握历史兴亡的规律，",
    "start": 82.598,
    "end": 88.04,
    "duration": 5.442
  },
  {
    "id": 24,
    "text": "又赋予了小说跌宕起伏的传奇色彩与文学感染力。",
    "start": 88.04,
    "end": 92.826,
    "duration": 4.786
  },
  {
    "id": 25,
    "text": "第二，塑造“智绝”化身的诸葛亮形象，",
    "start": 92.826,
    "end": 96.691,
    "duration": 3.865
  },
  {
    "id": 26,
    "text": "确立儒家贤相与智慧忠臣的至高典范。",
    "start": 96.691,
    "end": 99.6,
    "duration": 2.909
  },
  {
    "id": 27,
    "text": "诸葛亮是全书倾注笔墨最多、形象最生动的核心人物。",
    "start": 99.6,
    "end": 105.341,
    "duration": 5.741
  },
  {
    "id": 28,
    "text": "作者将其塑造为智慧与忠贞的高度综合体：在政治智慧上，",
    "start": 105.341,
    "end": 110.038,
    "duration": 4.697
  },
  {
    "id": 29,
    "text": "他草庐对策即能预见天下三分大势；在外交军事谋略上，",
    "start": 110.038,
    "end": 114.22,
    "duration": 4.182
  },
  {
    "id": 30,
    "text": "他舌战群儒、巧激周瑜、智算华容道、草船借箭，",
    "start": 114.22,
    "end": 119.039,
    "duration": 4.819
  },
  {
    "id": 31,
    "text": "展现出运筹帷幄的卓越才华；在品格精神上，",
    "start": 119.039,
    "end": 122.465,
    "duration": 3.426
  },
  {
    "id": 32,
    "text": "作者更是紧扣儒家伦理，突出其 “鞠躬尽瘁，",
    "start": 122.465,
    "end": 126.182,
    "duration": 3.717
  },
  {
    "id": 33,
    "text": "死而后已” 的担当精神。",
    "start": 126.182,
    "end": 127.824,
    "duration": 1.642
  },
  {
    "id": 34,
    "text": "尽管鲁迅曾评其 “状诸葛之多智而近妖”，",
    "start": 127.824,
    "end": 130.733,
    "duration": 2.909
  },
  {
    "id": 35,
    "text": "指出了部分神魔化描写的夸饰失真，但不可否认，",
    "start": 130.733,
    "end": 135.064,
    "duration": 4.331
  },
  {
    "id": 36,
    "text": "诸葛亮形象已成为中华民族忠诚智慧的集体文化原型。",
    "start": 135.064,
    "end": 139.524,
    "duration": 4.46
  },
  {
    "id": 37,
    "text": "第三，长于全景式战争场面排布，",
    "start": 139.524,
    "end": 142.206,
    "duration": 2.682
  },
  {
    "id": 38,
    "text": "在尖锐复杂的博弈中展开智谋较量。",
    "start": 142.206,
    "end": 145.29,
    "duration": 3.084
  },
  {
    "id": 39,
    "text": "作为战争史诗巨制，",
    "start": 145.29,
    "end": 147.206,
    "duration": 1.916
  },
  {
    "id": 40,
    "text": "《三国演义》 展现了极其高超的战争叙事功力。",
    "start": 147.206,
    "end": 150.979,
    "duration": 3.773
  },
  {
    "id": 41,
    "text": "全书写了大小数十场战役，无一雷同。",
    "start": 150.979,
    "end": 154.291,
    "duration": 3.312
  },
  {
    "id": 42,
    "text": "作者不仅写两军对垒的刀光剑影，",
    "start": 154.291,
    "end": 156.916,
    "duration": 2.625
  },
  {
    "id": 43,
    "text": "更重在写战前各方势力的政治博弈、战略谋划与心理较量。",
    "start": 156.916,
    "end": 164.271,
    "duration": 7.355
  },
  {
    "id": 44,
    "text": "在最具代表性的 “赤壁之战” 中，",
    "start": 164.271,
    "end": 167.214,
    "duration": 2.943
  },
  {
    "id": 45,
    "text": "作者用大量篇幅铺垫蒋干中计、周瑜打黄盖、诸葛亮借箭、",
    "start": 167.214,
    "end": 171.915,
    "duration": 4.701
  },
  {
    "id": 46,
    "text": "庞统献连环计等连环智谋，最终通过火烧赤壁达到矛盾总爆发；",
    "start": 171.915,
    "end": 178.212,
    "duration": 6.297
  },
  {
    "id": 47,
    "text": "作者以多视角、多线索的宏阔笔触，深刻揭示了知己知彼、",
    "start": 178.212,
    "end": 182.98,
    "duration": 4.768
  },
  {
    "id": 48,
    "text": "因势利导等深刻的辩证军事思想。",
    "start": 182.98,
    "end": 185.526,
    "duration": 2.546
  },
  {
    "id": 49,
    "text": "第四，寄寓深切的“拥刘反曹”宗法观念，",
    "start": 185.526,
    "end": 188.253,
    "duration": 2.727
  },
  {
    "id": 50,
    "text": "渗透天下分合的深刻历史哲学反思。",
    "start": 188.253,
    "end": 191.371,
    "duration": 3.118
  },
  {
    "id": 51,
    "text": "在思想倾向层面，",
    "start": 191.371,
    "end": 192.908,
    "duration": 1.537
  },
  {
    "id": 52,
    "text": "《三国演义》 鲜明贯彻了 “拥刘反曹” 的情感取向，",
    "start": 192.908,
    "end": 197.365,
    "duration": 4.457
  },
  {
    "id": 53,
    "text": "借刘备集团的仁政仁德寄托人民反对残暴统治、",
    "start": 197.365,
    "end": 201.766,
    "duration": 4.401
  },
  {
    "id": 54,
    "text": "渴求清明政治的美好愿望。",
    "start": 201.766,
    "end": 204.472,
    "duration": 2.706
  },
  {
    "id": 55,
    "text": "同时，全书以 “天下大势，分久必合，",
    "start": 204.472,
    "end": 207.818,
    "duration": 3.346
  },
  {
    "id": 56,
    "text": "合久必分” 统领全篇，卷首杨慎词 “滚滚长江东逝水，",
    "start": 207.818,
    "end": 211.454,
    "duration": 3.636
  },
  {
    "id": 57,
    "text": "浪花淘尽英雄” 更是贯注着强烈的历史沧桑感。",
    "start": 211.454,
    "end": 215.363,
    "duration": 3.909
  },
  {
    "id": 58,
    "text": "小说通过魏、蜀、吴三国的最终归晋，",
    "start": 215.363,
    "end": 218.415,
    "duration": 3.052
  },
  {
    "id": 59,
    "text": "客观揭示了任何逆历史潮流的军阀纷争终将归于幻灭的深刻哲思。",
    "start": 218.415,
    "end": 224.04,
    "duration": 5.625
  }
]