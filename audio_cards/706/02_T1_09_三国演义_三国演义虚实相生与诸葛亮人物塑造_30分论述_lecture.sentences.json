[
  {
    "id": 1,
    "text": "试论《三国演义》的“虚实相生”艺术与诸葛亮形象塑造。",
    "start": 0.08,
    "end": 4.513,
    "duration": 4.433
  },
  {
    "id": 2,
    "text": "《三国演义》 是中国古代第一部长篇章回体历史演义小说，",
    "start": 4.716,
    "end": 9.279,
    "duration": 4.563
  },
  {
    "id": 3,
    "text": "开辟了中国古典小说“据史演义”的宏大传统。",
    "start": 9.659,
    "end": 13.15,
    "duration": 3.491
  },
  {
    "id": 4,
    "text": "面对元末明初动荡不安的社会现实与人民对国家统一的渴求，",
    "start": 13.271,
    "end": 17.972,
    "duration": 4.701
  },
  {
    "id": 5,
    "text": "罗贯中以陈寿 《三国志》 与裴松之注为基本史料框架，",
    "start": 18.116,
    "end": 22.568,
    "duration": 4.452
  },
  {
    "id": 6,
    "text": "熔裁宋元民间讲史话本与戏曲积累，",
    "start": 22.793,
    "end": 25.804,
    "duration": 3.011
  },
  {
    "id": 7,
    "text": "创造性地平衡了历史真实与艺术虚构的关系。",
    "start": 25.926,
    "end": 29.393,
    "duration": 3.467
  },
  {
    "id": 8,
    "text": "章学诚在 《丙辰札记》 中精辟概括其特点为 “七分事态，",
    "start": 29.623,
    "end": 34.225,
    "duration": 4.602
  },
  {
    "id": 9,
    "text": "三分虚构”。",
    "start": 34.395,
    "end": 35.283,
    "duration": 0.888
  },
  {
    "id": 10,
    "text": "其虚实相生的叙事艺术与诸葛亮形象塑造，",
    "start": 35.734,
    "end": 39.197,
    "duration": 3.463
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：",
    "start": 39.304,
    "end": 41.73,
    "duration": 2.426
  },
  {
    "id": 12,
    "text": "第一，确立“七分事实，三分虚构”的创作原则，",
    "start": 42.292,
    "end": 46.006,
    "duration": 3.714
  },
  {
    "id": 13,
    "text": "达成历史规律与艺术传奇的有机统一。",
    "start": 46.362,
    "end": 49.253,
    "duration": 2.891
  },
  {
    "id": 14,
    "text": "《三国演义》 严格遵循历史发展的基本脉络，",
    "start": 49.451,
    "end": 53.076,
    "duration": 3.625
  },
  {
    "id": 15,
    "text": "三国鼎立的大局变迁、",
    "start": 53.238,
    "end": 55.037,
    "duration": 1.799
  },
  {
    "id": 16,
    "text": "重大战役胜负与主要历史人物的生卒结局均据史直书，",
    "start": 55.419,
    "end": 60.108,
    "duration": 4.689
  },
  {
    "id": 17,
    "text": "保持了历史演进的严肃逻辑。",
    "start": 60.259,
    "end": 62.413,
    "duration": 2.154
  },
  {
    "id": 18,
    "text": "然而，作者绝不拘泥于史实细节的机械照搬，",
    "start": 62.642,
    "end": 66.238,
    "duration": 3.596
  },
  {
    "id": 19,
    "text": "而是通过合情合理的虚构对历史缝隙进行艺术填充。",
    "start": 66.444,
    "end": 70.89,
    "duration": 4.446
  },
  {
    "id": 20,
    "text": "例如 “关羽过五关斩六将”、“温酒斩华雄”、",
    "start": 71.066,
    "end": 74.336,
    "duration": 3.27
  },
  {
    "id": 21,
    "text": "“草船借箭” 与 “借东风” 等脍炙人口的经典情节，",
    "start": 74.359,
    "end": 77.956,
    "duration": 3.597
  },
  {
    "id": 22,
    "text": "多属艺术虚构或移花接木。",
    "start": 78.213,
    "end": 80.244,
    "duration": 2.031
  },
  {
    "id": 23,
    "text": "这种虚实相生的笔法，既让读者深切把握历史兴亡的规律，",
    "start": 80.584,
    "end": 84.781,
    "duration": 4.197
  },
  {
    "id": 24,
    "text": "又赋予了小说跌宕起伏的传奇色彩与文学感染力。",
    "start": 84.933,
    "end": 88.986,
    "duration": 4.053
  },
  {
    "id": 25,
    "text": "第二，塑造“智绝”化身的诸葛亮形象，",
    "start": 89.219,
    "end": 92.354,
    "duration": 3.135
  },
  {
    "id": 26,
    "text": "确立儒家贤相与智慧忠臣的至高典范。",
    "start": 92.813,
    "end": 96.143,
    "duration": 3.33
  },
  {
    "id": 27,
    "text": "诸葛亮是全书倾注笔墨最多、形象最生动的核心人物。",
    "start": 96.68,
    "end": 100.822,
    "duration": 4.142
  },
  {
    "id": 28,
    "text": "作者将其塑造为智慧与忠贞的高度综合体：在政治智慧上，",
    "start": 101.357,
    "end": 106.382,
    "duration": 5.025
  },
  {
    "id": 29,
    "text": "他草庐对策即能预见天下三分大势；在外交军事谋略上，",
    "start": 106.623,
    "end": 111.453,
    "duration": 4.83
  },
  {
    "id": 30,
    "text": "他舌战群儒、巧激周瑜、智算华容道、草船借箭，",
    "start": 111.647,
    "end": 116.227,
    "duration": 4.58
  },
  {
    "id": 31,
    "text": "展现出运筹帷幄的卓越才华；在品格精神上，",
    "start": 116.453,
    "end": 120.19,
    "duration": 3.737
  },
  {
    "id": 32,
    "text": "作者更是紧扣儒家伦理，突出其 “鞠躬尽瘁，",
    "start": 120.383,
    "end": 124.251,
    "duration": 3.868
  },
  {
    "id": 33,
    "text": "死而后已” 的担当精神。",
    "start": 124.35,
    "end": 125.94,
    "duration": 1.59
  },
  {
    "id": 34,
    "text": "尽管鲁迅曾评其 “状诸葛之多智而近妖”，",
    "start": 126.171,
    "end": 129.841,
    "duration": 3.67
  },
  {
    "id": 35,
    "text": "指出了部分神魔化描写的夸饰失真，但不可否认，",
    "start": 129.958,
    "end": 133.8,
    "duration": 3.842
  },
  {
    "id": 36,
    "text": "诸葛亮形象已成为中华民族忠诚智慧的集体文化原型。",
    "start": 134.031,
    "end": 138.531,
    "duration": 4.5
  },
  {
    "id": 37,
    "text": "第三，长于全景式战争场面排布，",
    "start": 138.729,
    "end": 142.169,
    "duration": 3.44
  },
  {
    "id": 38,
    "text": "在尖锐复杂的博弈中展开智谋较量。",
    "start": 142.191,
    "end": 144.993,
    "duration": 2.802
  },
  {
    "id": 39,
    "text": "作为战争史诗巨制，",
    "start": 145.28,
    "end": 146.912,
    "duration": 1.632
  },
  {
    "id": 40,
    "text": "《三国演义》 展现了极其高超的战争叙事功力。",
    "start": 147.192,
    "end": 150.631,
    "duration": 3.439
  },
  {
    "id": 41,
    "text": "全书写了大小数十场战役，无一雷同。",
    "start": 150.967,
    "end": 153.972,
    "duration": 3.005
  },
  {
    "id": 42,
    "text": "作者不仅写两军对垒的刀光剑影，",
    "start": 154.281,
    "end": 156.691,
    "duration": 2.41
  },
  {
    "id": 43,
    "text": "更重在写战前各方势力的政治博弈、战略谋划与心理较量。",
    "start": 156.906,
    "end": 161.611,
    "duration": 4.705
  },
  {
    "id": 44,
    "text": "在最具代表性的 “赤壁之战” 中，",
    "start": 161.875,
    "end": 164.079,
    "duration": 2.204
  },
  {
    "id": 45,
    "text": "作者用大量篇幅铺垫蒋干中计、周瑜打黄盖、诸葛亮借箭、",
    "start": 164.261,
    "end": 169.232,
    "duration": 4.971
  },
  {
    "id": 46,
    "text": "庞统献连环计等连环智谋，最终通过火烧赤壁达到矛盾总爆发；",
    "start": 169.47,
    "end": 175.034,
    "duration": 5.564
  },
  {
    "id": 47,
    "text": "作者以多视角、多线索的宏阔笔触，深刻揭示了知己知彼、",
    "start": 175.277,
    "end": 179.817,
    "duration": 4.54
  },
  {
    "id": 48,
    "text": "因势利导等深刻的辩证军事思想。",
    "start": 180.001,
    "end": 182.541,
    "duration": 2.54
  },
  {
    "id": 49,
    "text": "第四，寄寓深切的“拥刘反曹”宗法观念，",
    "start": 182.97,
    "end": 186.708,
    "duration": 3.738
  },
  {
    "id": 50,
    "text": "渗透天下分合的深刻历史哲学反思。",
    "start": 186.736,
    "end": 189.541,
    "duration": 2.805
  },
  {
    "id": 51,
    "text": "在思想倾向层面，",
    "start": 189.953,
    "end": 191.287,
    "duration": 1.334
  },
  {
    "id": 52,
    "text": "《三国演义》 鲜明贯彻了 “拥刘反曹” 的情感取向，",
    "start": 191.361,
    "end": 195.258,
    "duration": 3.897
  },
  {
    "id": 53,
    "text": "借刘备集团的仁政仁德寄托人民反对残暴统治、",
    "start": 195.33,
    "end": 199.509,
    "duration": 4.179
  },
  {
    "id": 54,
    "text": "渴求清明政治的美好愿望。",
    "start": 199.509,
    "end": 201.545,
    "duration": 2.036
  },
  {
    "id": 55,
    "text": "同时，全书以 “天下大势，分久必合，",
    "start": 201.756,
    "end": 205.429,
    "duration": 3.673
  },
  {
    "id": 56,
    "text": "合久必分” 统领全篇，卷首杨慎词 “滚滚长江东逝水，",
    "start": 205.53,
    "end": 211.172,
    "duration": 5.642
  },
  {
    "id": 57,
    "text": "浪花淘尽英雄” 更是贯注着强烈的历史沧桑感。",
    "start": 211.172,
    "end": 215.285,
    "duration": 4.113
  },
  {
    "id": 58,
    "text": "小说通过魏、蜀、吴三国的最终归晋，",
    "start": 215.345,
    "end": 218.336,
    "duration": 2.991
  },
  {
    "id": 59,
    "text": "客观揭示了任何逆历史潮流的军阀纷争终将归于幻灭的深刻哲思。",
    "start": 218.405,
    "end": 224.04,
    "duration": 5.635
  }
]
