[
  {
    "id": 1,
    "text": "试论《三国演义》的“虚实相生”艺术与诸葛亮形象塑造。",
    "start": 0.0,
    "end": 4.759,
    "duration": 4.759
  },
  {
    "id": 2,
    "text": "《三国演义》 是中国古代第一部长篇章回体历史演义小说，",
    "start": 4.759,
    "end": 9.699,
    "duration": 4.94
  },
  {
    "id": 3,
    "text": "开辟了中国古典小说“据史演义”的宏大传统。",
    "start": 9.699,
    "end": 13.311,
    "duration": 3.612
  },
  {
    "id": 4,
    "text": "面对元末明初动荡不安的社会现实与人民对国家统一的渴求，",
    "start": 13.311,
    "end": 20.257,
    "duration": 6.946
  },
  {
    "id": 5,
    "text": "罗贯中以陈寿 《三国志》 与裴松之注为基本史料框架，",
    "start": 20.257,
    "end": 25.966,
    "duration": 5.709
  },
  {
    "id": 6,
    "text": "熔裁宋元民间讲史话本与戏曲积累，",
    "start": 25.966,
    "end": 29.664,
    "duration": 3.698
  },
  {
    "id": 7,
    "text": "创造性地平衡了历史真实与艺术虚构的关系。",
    "start": 29.664,
    "end": 34.438,
    "duration": 4.774
  },
  {
    "id": 8,
    "text": "章学诚在 《丙辰札记》 中精辟概括其特点为 “七分事态，",
    "start": 34.438,
    "end": 37.804,
    "duration": 3.366
  },
  {
    "id": 9,
    "text": "三分虚构”。",
    "start": 37.804,
    "end": 39.344,
    "duration": 1.54
  },
  {
    "id": 10,
    "text": "其虚实相生的叙事艺术与诸葛亮形象塑造，",
    "start": 39.344,
    "end": 42.865,
    "duration": 3.521
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：",
    "start": 42.865,
    "end": 46.402,
    "duration": 3.537
  },
  {
    "id": 12,
    "text": "第一，确立“七分事实，三分虚构”的创作原则，",
    "start": 46.402,
    "end": 50.77,
    "duration": 4.368
  },
  {
    "id": 13,
    "text": "达成历史规律与艺术传奇的有机统一。",
    "start": 50.77,
    "end": 55.459,
    "duration": 4.689
  },
  {
    "id": 14,
    "text": "《三国演义》 严格遵循历史发展的基本脉络，",
    "start": 55.459,
    "end": 60.299,
    "duration": 4.84
  },
  {
    "id": 15,
    "text": "三国鼎立的大局变迁、",
    "start": 60.299,
    "end": 62.681,
    "duration": 2.382
  },
  {
    "id": 16,
    "text": "重大战役胜负与主要历史人物的生卒结局均据史直书，",
    "start": 62.681,
    "end": 66.485,
    "duration": 3.804
  },
  {
    "id": 17,
    "text": "保持了历史演进的严肃逻辑。",
    "start": 66.485,
    "end": 69.683,
    "duration": 3.198
  },
  {
    "id": 18,
    "text": "然而，作者绝不拘泥于史实细节的机械照搬，",
    "start": 69.683,
    "end": 73.36,
    "duration": 3.677
  },
  {
    "id": 19,
    "text": "而是通过合情合理的虚构对历史缝隙进行艺术填充。",
    "start": 73.36,
    "end": 76.294,
    "duration": 2.934
  },
  {
    "id": 20,
    "text": "例如 “关羽过五关斩六将”、“温酒斩华雄”、",
    "start": 76.294,
    "end": 80.624,
    "duration": 4.33
  },
  {
    "id": 21,
    "text": "“草船借箭” 与 “借东风” 等脍炙人口的经典情节，",
    "start": 80.624,
    "end": 82.361,
    "duration": 1.737
  },
  {
    "id": 22,
    "text": "多属艺术虚构或移花接木。",
    "start": 82.361,
    "end": 84.984,
    "duration": 2.623
  },
  {
    "id": 23,
    "text": "这种虚实相生的笔法，既让读者深切把握历史兴亡的规律，",
    "start": 84.984,
    "end": 92.854,
    "duration": 7.87
  },
  {
    "id": 24,
    "text": "又赋予了小说跌宕起伏的传奇色彩与文学感染力。",
    "start": 92.854,
    "end": 96.721,
    "duration": 3.867
  },
  {
    "id": 25,
    "text": "第二，塑造“智绝”化身的诸葛亮形象，",
    "start": 96.721,
    "end": 101.402,
    "duration": 4.681
  },
  {
    "id": 26,
    "text": "确立儒家贤相与智慧忠臣的至高典范。",
    "start": 101.402,
    "end": 105.371,
    "duration": 3.969
  },
  {
    "id": 27,
    "text": "诸葛亮是全书倾注笔墨最多、形象最生动的核心人物。",
    "start": 105.371,
    "end": 111.688,
    "duration": 6.317
  },
  {
    "id": 28,
    "text": "作者将其塑造为智慧与忠贞的高度综合体：在政治智慧上，",
    "start": 111.688,
    "end": 119.068,
    "duration": 7.38
  },
  {
    "id": 29,
    "text": "他草庐对策即能预见天下三分大势；在外交军事谋略上，",
    "start": 119.068,
    "end": 124.391,
    "duration": 5.323
  },
  {
    "id": 30,
    "text": "他舌战群儒、巧激周瑜、智算华容道、草船借箭，",
    "start": 124.391,
    "end": 129.998,
    "duration": 5.607
  },
  {
    "id": 31,
    "text": "展现出运筹帷幄的卓越才华；在品格精神上，",
    "start": 129.998,
    "end": 135.094,
    "duration": 5.096
  },
  {
    "id": 32,
    "text": "作者更是紧扣儒家伦理，突出其 “鞠躬尽瘁，",
    "start": 135.094,
    "end": 139.554,
    "duration": 4.46
  },
  {
    "id": 33,
    "text": "死而后已” 的担当精神。",
    "start": 139.554,
    "end": 142.025,
    "duration": 2.471
  },
  {
    "id": 34,
    "text": "尽管鲁迅曾评其 “状诸葛之多智而近妖”，",
    "start": 142.025,
    "end": 147.234,
    "duration": 5.209
  },
  {
    "id": 35,
    "text": "指出了部分神魔化描写的夸饰失真，但不可否认，",
    "start": 147.234,
    "end": 151.007,
    "duration": 3.773
  },
  {
    "id": 36,
    "text": "诸葛亮形象已成为中华民族忠诚智慧的集体文化原型。",
    "start": 151.007,
    "end": 154.321,
    "duration": 3.314
  },
  {
    "id": 37,
    "text": "第三，长于全景式战争场面排布，",
    "start": 154.321,
    "end": 156.946,
    "duration": 2.625
  },
  {
    "id": 38,
    "text": "在尖锐复杂的博弈中展开智谋较量。",
    "start": 156.946,
    "end": 159.895,
    "duration": 2.949
  },
  {
    "id": 39,
    "text": "作为战争史诗巨制，",
    "start": 159.895,
    "end": 161.915,
    "duration": 2.02
  },
  {
    "id": 40,
    "text": "《三国演义》 展现了极其高超的战争叙事功力。",
    "start": 161.915,
    "end": 164.301,
    "duration": 2.386
  },
  {
    "id": 41,
    "text": "全书写了大小数十场战役，无一雷同。",
    "start": 164.301,
    "end": 168.429,
    "duration": 4.128
  },
  {
    "id": 42,
    "text": "作者不仅写两军对垒的刀光剑影，",
    "start": 168.429,
    "end": 171.944,
    "duration": 3.515
  },
  {
    "id": 43,
    "text": "更重在写战前各方势力的政治博弈、战略谋划与心理较量。",
    "start": 171.944,
    "end": 178.242,
    "duration": 6.298
  },
  {
    "id": 44,
    "text": "在最具代表性的 “赤壁之战” 中，",
    "start": 178.242,
    "end": 180.043,
    "duration": 1.801
  },
  {
    "id": 45,
    "text": "作者用大量篇幅铺垫蒋干中计、周瑜打黄盖、诸葛亮借箭、",
    "start": 180.043,
    "end": 183.782,
    "duration": 3.739
  },
  {
    "id": 46,
    "text": "庞统献连环计等连环智谋，最终通过火烧赤壁达到矛盾总爆发；",
    "start": 183.782,
    "end": 186.644,
    "duration": 2.862
  },
  {
    "id": 47,
    "text": "作者以多视角、多线索的宏阔笔触，深刻揭示了知己知彼、",
    "start": 186.644,
    "end": 189.993,
    "duration": 3.349
  },
  {
    "id": 48,
    "text": "因势利导等深刻的辩证军事思想。",
    "start": 189.993,
    "end": 192.28,
    "duration": 2.287
  },
  {
    "id": 49,
    "text": "第四，寄寓深切的“拥刘反曹”宗法观念，",
    "start": 192.28,
    "end": 195.379,
    "duration": 3.099
  },
  {
    "id": 50,
    "text": "渗透天下分合的深刻历史哲学反思。",
    "start": 195.379,
    "end": 197.395,
    "duration": 2.016
  },
  {
    "id": 51,
    "text": "在思想倾向层面，",
    "start": 197.395,
    "end": 201.796,
    "duration": 4.401
  },
  {
    "id": 52,
    "text": "《三国演义》 鲜明贯彻了 “拥刘反曹” 的情感取向，",
    "start": 201.796,
    "end": 202.467,
    "duration": 0.671
  },
  {
    "id": 53,
    "text": "借刘备集团的仁政仁德寄托人民反对残暴统治、",
    "start": 202.467,
    "end": 204.493,
    "duration": 2.026
  },
  {
    "id": 54,
    "text": "渴求清明政治的美好愿望。",
    "start": 204.493,
    "end": 205.57,
    "duration": 1.077
  },
  {
    "id": 55,
    "text": "同时，全书以 “天下大势，分久必合，",
    "start": 205.57,
    "end": 207.847,
    "duration": 2.277
  },
  {
    "id": 56,
    "text": "合久必分” 统领全篇，卷首杨慎词 “滚滚长江东逝水，",
    "start": 207.847,
    "end": 210.893,
    "duration": 3.046
  },
  {
    "id": 57,
    "text": "浪花淘尽英雄” 更是贯注着强烈的历史沧桑感。",
    "start": 210.893,
    "end": 215.39,
    "duration": 4.497
  },
  {
    "id": 58,
    "text": "小说通过魏、蜀、吴三国的最终归晋，",
    "start": 215.39,
    "end": 221.64,
    "duration": 6.25
  },
  {
    "id": 59,
    "text": "客观揭示了任何逆历史潮流的军阀纷争终将归于幻灭的深刻哲思。",
    "start": 221.64,
    "end": 223.76,
    "duration": 2.12
  }
]