[
  {
    "id": 1,
    "text": "试论《三国演义》的“虚实相生”艺术与诸葛亮形象塑造。",
    "start": 0.16,
    "end": 5.76,
    "duration": 5.6
  },
  {
    "id": 2,
    "text": "《三国演义》 是中国古代第一部长篇章回体历史演义小说，",
    "start": 5.76,
    "end": 10.96,
    "duration": 5.2
  },
  {
    "id": 3,
    "text": "开辟了中国古典小说“据史演义”的宏大传统。",
    "start": 10.96,
    "end": 15.04,
    "duration": 4.08
  },
  {
    "id": 4,
    "text": "面对元末明初动荡不安的社会现实与人民对国家统一的渴求，",
    "start": 15.04,
    "end": 20.8,
    "duration": 5.76
  },
  {
    "id": 5,
    "text": "罗贯中以陈寿 《三国志》 与裴松之注为基本史料框架，",
    "start": 20.8,
    "end": 25.76,
    "duration": 4.96
  },
  {
    "id": 6,
    "text": "熔裁宋元民间讲史话本与戏曲积累，",
    "start": 25.92,
    "end": 28.88,
    "duration": 2.96
  },
  {
    "id": 7,
    "text": "创造性地平衡了历史真实与艺术虚构的关系。",
    "start": 28.88,
    "end": 32.88,
    "duration": 4.0
  },
  {
    "id": 8,
    "text": "章学诚在 《丙辰札记》 中精辟概括其特点为 “七分事态，",
    "start": 33.2,
    "end": 38.96,
    "duration": 5.76
  },
  {
    "id": 9,
    "text": "三分虚构”。",
    "start": 38.96,
    "end": 40.16,
    "duration": 1.2
  },
  {
    "id": 10,
    "text": "其虚实相生的叙事艺术与诸葛亮形象塑造，",
    "start": 40.16,
    "end": 44.8,
    "duration": 4.64
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：",
    "start": 44.8,
    "end": 47.68,
    "duration": 2.88
  },
  {
    "id": 12,
    "text": "第一，确立“七分事实，三分虚构”的创作原则，",
    "start": 47.68,
    "end": 52.354,
    "duration": 4.674
  },
  {
    "id": 13,
    "text": "达成历史规律与艺术传奇的有机统一。",
    "start": 52.354,
    "end": 55.99,
    "duration": 3.636
  },
  {
    "id": 14,
    "text": "《三国演义》 严格遵循历史发展的基本脉络，",
    "start": 55.99,
    "end": 60.267,
    "duration": 4.277
  },
  {
    "id": 15,
    "text": "三国鼎立的大局变迁、",
    "start": 60.267,
    "end": 62.406,
    "duration": 2.139
  },
  {
    "id": 16,
    "text": "重大战役胜负与主要历史人物的生卒结局均据史直书，",
    "start": 62.406,
    "end": 67.538,
    "duration": 5.132
  },
  {
    "id": 17,
    "text": "保持了历史演进的严肃逻辑。",
    "start": 67.538,
    "end": 70.318,
    "duration": 2.78
  },
  {
    "id": 18,
    "text": "然而，作者绝不拘泥于史实细节的机械照搬，",
    "start": 70.318,
    "end": 74.8,
    "duration": 4.482
  },
  {
    "id": 19,
    "text": "而是通过合情合理的虚构对历史缝隙进行艺术填充。",
    "start": 74.8,
    "end": 79.6,
    "duration": 4.8
  },
  {
    "id": 20,
    "text": "例如 “关羽过五关斩六将”、“温酒斩华雄”、",
    "start": 79.6,
    "end": 83.6,
    "duration": 4.0
  },
  {
    "id": 21,
    "text": "“草船借箭” 与 “借东风” 等脍炙人口的经典情节，",
    "start": 83.6,
    "end": 87.36,
    "duration": 3.76
  },
  {
    "id": 22,
    "text": "多属艺术虚构或移花接木。",
    "start": 87.36,
    "end": 90.32,
    "duration": 2.96
  },
  {
    "id": 23,
    "text": "这种虚实相生的笔法，既让读者深切把握历史兴亡的规律，",
    "start": 90.4,
    "end": 96.08,
    "duration": 5.68
  },
  {
    "id": 24,
    "text": "又赋予了小说跌宕起伏的传奇色彩与文学感染力。",
    "start": 96.56,
    "end": 100.8,
    "duration": 4.24
  },
  {
    "id": 25,
    "text": "第二，塑造“智绝”化身的诸葛亮形象，",
    "start": 101.2,
    "end": 104.88,
    "duration": 3.68
  },
  {
    "id": 26,
    "text": "确立儒家贤相与智慧忠臣的至高典范。",
    "start": 105.2,
    "end": 108.96,
    "duration": 3.76
  },
  {
    "id": 27,
    "text": "诸葛亮是全书倾注笔墨最多、形象最生动的核心人物。",
    "start": 108.96,
    "end": 114.72,
    "duration": 5.76
  },
  {
    "id": 28,
    "text": "作者将其塑造为智慧与忠贞的高度综合体：在政治智慧上，",
    "start": 114.72,
    "end": 120.64,
    "duration": 5.92
  },
  {
    "id": 29,
    "text": "他草庐对策即能预见天下三分大势；在外交军事谋略上，",
    "start": 120.64,
    "end": 126.32,
    "duration": 5.68
  },
  {
    "id": 30,
    "text": "他舌战群儒、巧激周瑜、智算华容道、草船借箭，",
    "start": 126.32,
    "end": 131.04,
    "duration": 4.72
  },
  {
    "id": 31,
    "text": "展现出运筹帷幄的卓越才华；在品格精神上，",
    "start": 131.04,
    "end": 135.28,
    "duration": 4.24
  },
  {
    "id": 32,
    "text": "作者更是紧扣儒家伦理，突出其 “鞠躬尽瘁，",
    "start": 135.28,
    "end": 139.84,
    "duration": 4.56
  },
  {
    "id": 33,
    "text": "死而后已” 的担当精神。",
    "start": 139.92,
    "end": 142.64,
    "duration": 2.72
  },
  {
    "id": 34,
    "text": "尽管鲁迅曾评其 “状诸葛之多智而近妖”，",
    "start": 142.64,
    "end": 146.456,
    "duration": 3.816
  },
  {
    "id": 35,
    "text": "指出了部分神魔化描写的夸饰失真，但不可否认，",
    "start": 146.456,
    "end": 151.176,
    "duration": 4.72
  },
  {
    "id": 36,
    "text": "诸葛亮形象已成为中华民族忠诚智慧的集体文化原型。",
    "start": 151.176,
    "end": 155.896,
    "duration": 4.72
  },
  {
    "id": 37,
    "text": "第三，长于全景式战争场面排布，",
    "start": 155.896,
    "end": 158.856,
    "duration": 2.96
  },
  {
    "id": 38,
    "text": "在尖锐复杂的博弈中展开智谋较量。",
    "start": 158.856,
    "end": 162.056,
    "duration": 3.2
  },
  {
    "id": 39,
    "text": "作为战争史诗巨制，",
    "start": 162.056,
    "end": 163.576,
    "duration": 1.52
  },
  {
    "id": 40,
    "text": "《三国演义》 展现了极其高超的战争叙事功力。",
    "start": 163.576,
    "end": 168.536,
    "duration": 4.96
  },
  {
    "id": 41,
    "text": "全书写了大小数十场战役，无一雷同。",
    "start": 168.536,
    "end": 172.216,
    "duration": 3.68
  },
  {
    "id": 42,
    "text": "作者不仅写两军对垒的刀光剑影，",
    "start": 172.216,
    "end": 174.936,
    "duration": 2.72
  },
  {
    "id": 43,
    "text": "更重在写战前各方势力的政治博弈、战略谋划与心理较量。",
    "start": 175.256,
    "end": 180.456,
    "duration": 5.2
  },
  {
    "id": 44,
    "text": "在最具代表性的 “赤壁之战” 中，",
    "start": 180.456,
    "end": 184.056,
    "duration": 3.6
  },
  {
    "id": 45,
    "text": "作者用大量篇幅铺垫蒋干中计、周瑜打黄盖、诸葛亮借箭、",
    "start": 184.056,
    "end": 189.416,
    "duration": 5.36
  },
  {
    "id": 46,
    "text": "庞统献连环计等连环智谋，最终通过火烧赤壁达到矛盾总爆发；",
    "start": 189.896,
    "end": 195.736,
    "duration": 5.84
  },
  {
    "id": 47,
    "text": "作者以多视角、多线索的宏阔笔触，深刻揭示了知己知彼、",
    "start": 195.736,
    "end": 200.936,
    "duration": 5.2
  },
  {
    "id": 48,
    "text": "因势利导等深刻的辩证军事思想。",
    "start": 200.936,
    "end": 205.096,
    "duration": 4.16
  },
  {
    "id": 49,
    "text": "第四，寄寓深切的“拥刘反曹”宗法观念，",
    "start": 205.096,
    "end": 210.296,
    "duration": 5.2
  },
  {
    "id": 50,
    "text": "渗透天下分合的深刻历史哲学反思。",
    "start": 210.296,
    "end": 213.976,
    "duration": 3.68
  },
  {
    "id": 51,
    "text": "在思想倾向层面，",
    "start": 213.976,
    "end": 215.496,
    "duration": 1.52
  },
  {
    "id": 52,
    "text": "《三国演义》 鲜明贯彻了 “拥刘反曹” 的情感取向，",
    "start": 215.496,
    "end": 220.056,
    "duration": 4.56
  },
  {
    "id": 53,
    "text": "借刘备集团的仁政仁德寄托人民反对残暴统治、",
    "start": 220.056,
    "end": 223.736,
    "duration": 3.68
  },
  {
    "id": 54,
    "text": "渴求清明政治的美好愿望。",
    "start": 223.576,
    "end": 223.736,
    "duration": 0.16
  },
  {
    "id": 55,
    "text": "同时，全书以 “天下大势，分久必合，",
    "start": 223.576,
    "end": 223.736,
    "duration": 0.16
  },
  {
    "id": 56,
    "text": "合久必分” 统领全篇，卷首杨慎词 “滚滚长江东逝水，",
    "start": 223.576,
    "end": 223.736,
    "duration": 0.16
  },
  {
    "id": 57,
    "text": "浪花淘尽英雄” 更是贯注着强烈的历史沧桑感。",
    "start": 223.576,
    "end": 223.736,
    "duration": 0.16
  },
  {
    "id": 58,
    "text": "小说通过魏、蜀、吴三国的最终归晋，",
    "start": 223.576,
    "end": 223.736,
    "duration": 0.16
  },
  {
    "id": 59,
    "text": "客观揭示了任何逆历史潮流的军阀纷争终将归于幻灭的深刻哲思。",
    "start": 223.576,
    "end": 223.736,
    "duration": 0.16
  }
]