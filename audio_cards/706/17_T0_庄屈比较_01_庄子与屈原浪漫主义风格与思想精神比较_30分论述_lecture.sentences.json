[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 3.52,
    "duration": 3.44
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 3.52,
    "end": 6.72,
    "duration": 3.2
  },
  {
    "id": 3,
    "text": "这道题考查先秦浪漫主义双璧庄屈的比较。",
    "start": 6.72,
    "end": 10.64,
    "duration": 3.92
  },
  {
    "id": 4,
    "text": "在考场上，考生必须回答出两者为何同样诞生于南方楚文化土壤、",
    "start": 10.64,
    "end": 16.56,
    "duration": 5.92
  },
  {
    "id": 5,
    "text": "拥有极高超的浪漫主义想象，却最终走向了两种截然不同的人格归宿与文学形态。",
    "start": 16.56,
    "end": 23.28,
    "duration": 6.72
  },
  {
    "id": 6,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 23.6,
    "end": 26.32,
    "duration": 2.72
  },
  {
    "id": 7,
    "text": "答题必须贯彻“同中求异、异中寻根”的辩证框架。",
    "start": 26.32,
    "end": 30.4,
    "duration": 4.08
  },
  {
    "id": 8,
    "text": "首先确认两者共有楚文化浪漫想象的基因，",
    "start": 30.4,
    "end": 33.92,
    "duration": 3.52
  },
  {
    "id": 9,
    "text": "随后重点从精神出世与入世、象征解构与寄托、",
    "start": 33.92,
    "end": 38.4,
    "duration": 4.48
  },
  {
    "id": 10,
    "text": "文体散文与楚辞三个递进维度展开深入剖析。",
    "start": 38.4,
    "end": 41.92,
    "duration": 3.52
  },
  {
    "id": 11,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 42.32,
    "end": 45.68,
    "duration": 3.36
  },
  {
    "id": 12,
    "text": "全题分为四个核心论述维度：第一维度：界定庄屈作为先秦浪漫主义源头与楚地文化双璧的历史地位；",
    "start": 45.68,
    "end": 54.4,
    "duration": 8.72
  },
  {
    "id": 13,
    "text": "第二维度：深入剖析两者在思想精神与人格追求上的出入世分野（逍遥超世versus九死不悔）；",
    "start": 54.4,
    "end": 62.56,
    "duration": 8.16
  },
  {
    "id": 14,
    "text": "第三维度：深刻对比两者的浪漫主义造境与意象系统（万物齐一的哲学寓言versus香草美人的政治道德寄托）；",
    "start": 62.88,
    "end": 72.16,
    "duration": 9.28
  },
  {
    "id": 15,
    "text": "第四维度：精准辨析两者在文体形式与语言节律上的不同建构（汪洋恣肆的论说散文versus幽深悲壮的楚辞骚体）；",
    "start": 72.16,
    "end": 81.2,
    "duration": 9.04
  },
  {
    "id": 16,
    "text": "第五维度：宏观总结两者对后世文学精神与品格的双向深远影响。",
    "start": 81.44,
    "end": 87.44,
    "duration": 6.0
  },
  {
    "id": 17,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 87.44,
    "end": 91.44,
    "duration": 4.0
  },
  {
    "id": 18,
    "text": "全题逻辑严密咬合：第一步先确立两者共享楚文化浪漫想象的前提。",
    "start": 91.44,
    "end": 97.84,
    "duration": 6.4
  },
  {
    "id": 19,
    "text": "第二步深入思想核心，剖析面对战国乱世时出世逍遥与入世殉国的抉择分流。",
    "start": 97.84,
    "end": 104.32,
    "duration": 6.48
  },
  {
    "id": 20,
    "text": "第三步剖析这种精神抉择如何决定了意象系统的差异，",
    "start": 104.56,
    "end": 108.88,
    "duration": 4.32
  },
  {
    "id": 21,
    "text": "即哲学物化与道德香草。",
    "start": 108.88,
    "end": 111.12,
    "duration": 2.24
  },
  {
    "id": 22,
    "text": "第四步再将艺术意象落地为语言文体，",
    "start": 111.12,
    "end": 114.32,
    "duration": 3.2
  },
  {
    "id": 23,
    "text": "辨析寓言散文与骚体形式。",
    "start": 114.32,
    "end": 116.8,
    "duration": 2.48
  },
  {
    "id": 24,
    "text": "第五步完成宏观历史论证闭环。",
    "start": 116.8,
    "end": 119.76,
    "duration": 2.96
  },
  {
    "id": 25,
    "text": "二、各板块逐句咬合演练。",
    "start": 119.76,
    "end": 122.16,
    "duration": 2.4
  },
  {
    "id": 26,
    "text": "一、开头破题段内部咬合。",
    "start": 122.16,
    "end": 124.08,
    "duration": 1.92
  },
  {
    "id": 27,
    "text": "本段旨在开门见山确立立论基石。",
    "start": 124.4,
    "end": 127.12,
    "duration": 2.72
  },
  {
    "id": 28,
    "text": "首句直切先秦源头定论，次句点出同源异流的论题向度。",
    "start": 127.12,
    "end": 131.68,
    "duration": 4.56
  },
  {
    "id": 29,
    "text": "首先，首句必须直接亮出庄屈在中国文学史上的先锋坐标，",
    "start": 131.68,
    "end": 136.08,
    "duration": 4.4
  },
  {
    "id": 30,
    "text": "具体表述到答题语句就是：庄子与屈原是中国先秦浪漫主义文学的两大巍峨源头，",
    "start": 136.08,
    "end": 142.4,
    "duration": 6.32
  },
  {
    "id": 31,
    "text": "共同构成了楚地文化孕育出的精神双璧。，",
    "start": 142.4,
    "end": 145.6,
    "duration": 3.2
  },
  {
    "id": 32,
    "text": "这句话将两人同置于楚文化母胎之中。",
    "start": 145.6,
    "end": 148.48,
    "duration": 2.88
  },
  {
    "id": 33,
    "text": "-有了共同背景之后，次句必须迅速说明两者在突破中原规约之后的艺术分流，",
    "start": 148.776,
    "end": 155.279,
    "duration": 6.503
  },
  {
    "id": 34,
    "text": "具体表述到答题语句就是：两者不仅以极其宏肆奇幻的想象力打破了先秦北方中原文学的现实规约，",
    "start": 155.279,
    "end": 163.815,
    "duration": 8.536
  },
  {
    "id": 35,
    "text": "更在精神品格、象征造境与文体创新上呈现出同源异流的壮阔景观。，",
    "start": 163.815,
    "end": 169.505,
    "duration": 5.69
  },
  {
    "id": 36,
    "text": "这句话干脆利落地交代了下文展开的三大对比维度。",
    "start": 169.505,
    "end": 173.976,
    "duration": 4.471
  },
  {
    "id": 37,
    "text": "庄子与屈原是中国先秦浪漫主义文学的两大巍峨源头，",
    "start": 174.056,
    "end": 178.936,
    "duration": 4.88
  },
  {
    "id": 38,
    "text": "共同构成了楚地文化孕育出的精神双璧。",
    "start": 178.936,
    "end": 182.456,
    "duration": 3.52
  },
  {
    "id": 39,
    "text": "两者不仅以极其宏肆奇幻的想象力打破了先秦北方中原文学的现实规约，",
    "start": 182.456,
    "end": 188.216,
    "duration": 5.76
  },
  {
    "id": 40,
    "text": "更在精神品格、象征造境与文体创新上呈现出同源异流的壮阔景观。",
    "start": 188.216,
    "end": 193.976,
    "duration": 5.76
  },
  {
    "id": 41,
    "text": "二、第一维度：思想精神与人格追求对比内部咬合。",
    "start": 194.376,
    "end": 199.096,
    "duration": 4.72
  },
  {
    "id": 42,
    "text": "本段任务是深入剖析战国社会动荡下，",
    "start": 199.096,
    "end": 202.216,
    "duration": 3.12
  },
  {
    "id": 43,
    "text": "两人完全相反的人生道路选择。",
    "start": 202.216,
    "end": 204.856,
    "duration": 2.64
  },
  {
    "id": 44,
    "text": "首先，段首给出结论先行的分论点，",
    "start": 204.856,
    "end": 207.736,
    "duration": 2.88
  },
  {
    "id": 45,
    "text": "具体表述到答题语句就是：第一，在思想精神与主体人格品格上，",
    "start": 207.736,
    "end": 213.496,
    "duration": 5.76
  },
  {
    "id": 46,
    "text": "庄子追求超脱世俗的绝对精神自由，",
    "start": 213.496,
    "end": 216.456,
    "duration": 2.96
  },
  {
    "id": 47,
    "text": "屈原则坚守九死不悔的家国情怀与悲壮抗争。",
    "start": 216.456,
    "end": 220.136,
    "duration": 3.68
  },
  {
    "id": 48,
    "text": "-随后，剖析庄子追求逍遥的内在机制，",
    "start": 220.296,
    "end": 223.574,
    "duration": 3.278
  },
  {
    "id": 49,
    "text": "具体表述到答题语句就是：庄子身处战国中后期纷争乱世，",
    "start": 223.574,
    "end": 228.819,
    "duration": 5.245
  },
  {
    "id": 50,
    "text": "深感现实体制对个体生命的异化与摧残，",
    "start": 228.819,
    "end": 232.534,
    "duration": 3.715
  },
  {
    "id": 51,
    "text": "因而主张“安时而处顺”，追求“乘天地之正，",
    "start": 232.534,
    "end": 236.031,
    "duration": 3.497
  },
  {
    "id": 52,
    "text": "而御六气之辩”的逍遥游境界。",
    "start": 236.031,
    "end": 238.653,
    "duration": 2.622
  },
  {
    "id": 53,
    "text": "紧接着，举出大鹏展翅的典型文本细节，",
    "start": 238.653,
    "end": 242.15,
    "duration": 3.497
  },
  {
    "id": 54,
    "text": "具体表述到答题语句就是：他在《逍遥游》中借大鹏抟扶摇而上九万里的阔大境界，",
    "start": 242.15,
    "end": 249.361,
    "duration": 7.211
  },
  {
    "id": 55,
    "text": "展现对世俗名利羁绊的彻底扬弃，将精神安顿于超然物外的天地自然之中。",
    "start": 249.361,
    "end": 256.136,
    "duration": 6.775
  },
  {
    "id": 56,
    "text": "-随后，转向屈原的宗法血缘与政治执着，",
    "start": 256.136,
    "end": 259.351,
    "duration": 3.215
  },
  {
    "id": 57,
    "text": "具体表述到答题语句就是：屈原则深植于楚国宗法贵族政治的血缘伦理，",
    "start": 259.351,
    "end": 265.379,
    "duration": 6.028
  },
  {
    "id": 58,
    "text": "将个人命运与楚国兴衰紧密维系。",
    "start": 265.379,
    "end": 268.192,
    "duration": 2.813
  },
  {
    "id": 59,
    "text": "最后，调取《离骚》名句与投江壮举，",
    "start": 268.192,
    "end": 270.804,
    "duration": 2.612
  },
  {
    "id": 60,
    "text": "提炼其悲剧人格，具体表述到答题语句就是：面对楚怀王之昏庸与令尹子兰之缠毁，",
    "start": 270.804,
    "end": 277.636,
    "duration": 6.832
  },
  {
    "id": 61,
    "text": "屈原在《离骚》中毅然发出“亦余心之所善兮，",
    "start": 277.636,
    "end": 281.051,
    "duration": 3.415
  },
  {
    "id": 62,
    "text": "虽九死其犹未悔”的决绝誓言，宁可怀石自沉汨罗江也绝不同流合污，",
    "start": 281.051,
    "end": 286.677,
    "duration": 5.626
  },
  {
    "id": 63,
    "text": "展现出沉痛刚烈的人格力量与深沉的家国忧患。",
    "start": 286.677,
    "end": 290.696,
    "duration": 4.019
  },
  {
    "id": 64,
    "text": "第一，在思想精神与主体人格品格上，",
    "start": 290.84,
    "end": 294.28,
    "duration": 3.44
  },
  {
    "id": 65,
    "text": "庄子追求超脱世俗的绝对精神自由，",
    "start": 294.28,
    "end": 297.08,
    "duration": 2.8
  },
  {
    "id": 66,
    "text": "屈原则坚守九死不悔的家国情怀与悲壮抗争。",
    "start": 297.08,
    "end": 301.0,
    "duration": 3.92
  },
  {
    "id": 67,
    "text": "庄子身处战国中后期纷争乱世，深感现实体制对个体生命的异化与摧残，",
    "start": 301.0,
    "end": 306.92,
    "duration": 5.92
  },
  {
    "id": 68,
    "text": "因而主张“安时而处顺”，追求“乘天地之正，",
    "start": 306.92,
    "end": 310.68,
    "duration": 3.76
  },
  {
    "id": 69,
    "text": "而御六气之辩”的逍遥游境界。",
    "start": 310.68,
    "end": 312.68,
    "duration": 2.0
  },
  {
    "id": 70,
    "text": "他在《逍遥游》中借大鹏抟扶摇而上九万里的阔大境界，",
    "start": 312.92,
    "end": 317.56,
    "duration": 4.64
  },
  {
    "id": 71,
    "text": "展现对世俗名利羁绊的彻底扬弃，将精神安顿于超然物外的天地自然之中。",
    "start": 317.56,
    "end": 324.36,
    "duration": 6.8
  },
  {
    "id": 72,
    "text": "屈原则深植于楚国宗法贵族政治的血缘伦理，",
    "start": 324.36,
    "end": 328.04,
    "duration": 3.68
  },
  {
    "id": 73,
    "text": "将个人命运与楚国兴衰紧密维系。",
    "start": 328.04,
    "end": 331.16,
    "duration": 3.12
  },
  {
    "id": 74,
    "text": "面对楚怀王之昏庸与令尹子兰之缠毁，",
    "start": 331.16,
    "end": 334.76,
    "duration": 3.6
  },
  {
    "id": 75,
    "text": "屈原在《离骚》中毅然发出“亦余心之所善兮，",
    "start": 334.76,
    "end": 338.6,
    "duration": 3.84
  },
  {
    "id": 76,
    "text": "虽九死其犹未悔”的决绝誓言，宁可怀石自沉汨罗江也绝不同流合污，",
    "start": 338.6,
    "end": 345.08,
    "duration": 6.48
  },
  {
    "id": 77,
    "text": "展现出沉痛刚烈的人格力量与深沉的家国忧患。",
    "start": 345.08,
    "end": 349.24,
    "duration": 4.16
  },
  {
    "id": 78,
    "text": "三、第二维度：艺术造境与象征意象对比内部咬合。",
    "start": 349.56,
    "end": 354.36,
    "duration": 4.8
  },
  {
    "id": 79,
    "text": "本段任务是深入剖析哲学寓言的“无待”造境与香草美人的“比兴寄托”机制。",
    "start": 354.36,
    "end": 360.84,
    "duration": 6.48
  },
  {
    "id": 80,
    "text": "首先，段首给出结论先行的分论点，",
    "start": 360.84,
    "end": 363.72,
    "duration": 2.88
  },
  {
    "id": 81,
    "text": "具体表述到答题语句就是：第二，在艺术造境与浪漫主义象征意象上，",
    "start": 363.72,
    "end": 369.08,
    "duration": 5.36
  },
  {
    "id": 82,
    "text": "庄子长于打破万物物我界限的寓言造境，",
    "start": 369.08,
    "end": 372.6,
    "duration": 3.52
  },
  {
    "id": 83,
    "text": "屈原则构建了寄托政治品格与道德洁癖的香草美人意象系统。",
    "start": 372.6,
    "end": 377.96,
    "duration": 5.36
  },
  {
    "id": 84,
    "text": "-随后，阐述庄子打破物我边界的泛神造境，",
    "start": 378.12,
    "end": 381.963,
    "duration": 3.843
  },
  {
    "id": 85,
    "text": "具体表述到答题语句就是：庄子的想象具有强烈的解构色彩与泛神论倾向。，",
    "start": 381.963,
    "end": 388.97,
    "duration": 7.007
  },
  {
    "id": 86,
    "text": "指出其具体手段：他突破现实世界的时空与形体限制，",
    "start": 388.97,
    "end": 393.943,
    "duration": 4.973
  },
  {
    "id": 87,
    "text": "让大椿、冥灵、姑射神人与混沌交织并存。",
    "start": 393.943,
    "end": 397.56,
    "duration": 3.617
  },
  {
    "id": 88,
    "text": "-紧接着，举出庄周梦蝶名场面，具体表述到答题语句就是：在《齐物论》的“庄周梦蝶”中，",
    "start": 397.56,
    "end": 404.415,
    "duration": 6.855
  },
  {
    "id": 89,
    "text": "庄子膜糊了人与蝶、虚与实的绝对界限，",
    "start": 404.415,
    "end": 407.739,
    "duration": 3.324
  },
  {
    "id": 90,
    "text": "以“物化”的精妙造境诠释了齐万物、",
    "start": 407.739,
    "end": 410.648,
    "duration": 2.909
  },
  {
    "id": 91,
    "text": "等生死的深刻哲理。",
    "start": 410.648,
    "end": 412.31,
    "duration": 1.662
  },
  {
    "id": 92,
    "text": "随后，转向屈原香草美人寄托体系的深层分析，",
    "start": 412.31,
    "end": 416.257,
    "duration": 3.947
  },
  {
    "id": 93,
    "text": "具体表述到答题语句就是：屈原的浪漫主义想象则始终与现实政治道德紧密咬合。",
    "start": 416.257,
    "end": 423.32,
    "duration": 7.063
  },
  {
    "id": 94,
    "text": "-最后，完整复原其比兴寄托网络，",
    "start": 423.384,
    "end": 426.329,
    "duration": 2.945
  },
  {
    "id": 95,
    "text": "具体表述到答题语句就是：屈原在《离骚》中不仅上天下地、",
    "start": 426.329,
    "end": 431.54,
    "duration": 5.211
  },
  {
    "id": 96,
    "text": "周流六合以叩击天婚，更开创性地运用“香草美人”的寄托手法。",
    "start": 431.54,
    "end": 437.204,
    "duration": 5.664
  },
  {
    "id": 97,
    "text": "诗人以江离、辟芷象征纯洁品德，以恶草椒兰象征缠邪奸佞，",
    "start": 437.204,
    "end": 442.642,
    "duration": 5.438
  },
  {
    "id": 98,
    "text": "以求女象征对贤君与明政的追求，将飞腾的神话想象完全熔铸于现实政治悲剧的深沉开掘之中。",
    "start": 442.642,
    "end": 451.704,
    "duration": 9.062
  },
  {
    "id": 99,
    "text": "第二，在艺术造境与浪漫主义象征意象上，",
    "start": 451.784,
    "end": 455.464,
    "duration": 3.68
  },
  {
    "id": 100,
    "text": "庄子长于打破万物物我界限的寓言造境，",
    "start": 455.464,
    "end": 459.464,
    "duration": 4.0
  },
  {
    "id": 101,
    "text": "屈原则构建了寄托政治品格与道德洁癖的香草美人意象系统。",
    "start": 459.464,
    "end": 465.064,
    "duration": 5.6
  },
  {
    "id": 102,
    "text": "庄子的想象具有强烈的解构色彩与泛神论倾向。",
    "start": 465.064,
    "end": 469.224,
    "duration": 4.16
  },
  {
    "id": 103,
    "text": "他突破现实世界的时空与形体限制，",
    "start": 469.224,
    "end": 472.504,
    "duration": 3.28
  },
  {
    "id": 104,
    "text": "让大椿、冥灵、姑射神人与混沌交织并存。",
    "start": 472.504,
    "end": 476.264,
    "duration": 3.76
  },
  {
    "id": 105,
    "text": "在《齐物论》的“庄周梦蝶”中，庄子膜糊了人与蝶、",
    "start": 476.584,
    "end": 480.584,
    "duration": 4.0
  },
  {
    "id": 106,
    "text": "虚与实的绝对界限，以“物化”的精妙造境诠释了齐万物、",
    "start": 480.584,
    "end": 485.384,
    "duration": 4.8
  },
  {
    "id": 107,
    "text": "等生死的深刻哲理。",
    "start": 485.384,
    "end": 487.064,
    "duration": 1.68
  },
  {
    "id": 108,
    "text": "屈原的浪漫主义想象则始终与现实政治道德紧密咬合。",
    "start": 487.064,
    "end": 491.624,
    "duration": 4.56
  },
  {
    "id": 109,
    "text": "屈原在《离骚》中不仅上天下地、周流六合以叩击天婚，",
    "start": 491.624,
    "end": 496.424,
    "duration": 4.8
  },
  {
    "id": 110,
    "text": "更开创性地运用“香草美人”的寄托手法。",
    "start": 496.424,
    "end": 499.784,
    "duration": 3.36
  },
  {
    "id": 111,
    "text": "诗人以江离、辟芷象征纯洁品德，以恶草椒兰象征缠邪奸佞，",
    "start": 500.104,
    "end": 506.024,
    "duration": 5.92
  },
  {
    "id": 112,
    "text": "以求女象征对贤君与明政的追求，将飞腾的神话想象完全熔铸于现实政治悲剧的深沉开掘之中。",
    "start": 506.024,
    "end": 514.344,
    "duration": 8.32
  },
  {
    "id": 113,
    "text": "四、第三维度：文体建构与语言美学形态对比内部咬合。",
    "start": 514.344,
    "end": 519.384,
    "duration": 5.04
  },
  {
    "id": 114,
    "text": "本段任务是落实到文学形式本体，对比思辨散文与楚辞骚体的形式创新。",
    "start": 519.384,
    "end": 525.384,
    "duration": 6.0
  },
  {
    "id": 115,
    "text": "-首先，段首给出统领分论点，具体表述到答题语句就是：第三，",
    "start": 525.544,
    "end": 531.168,
    "duration": 5.624
  },
  {
    "id": 116,
    "text": "在文体建构与语言美学形态上，庄子散文展现了汪洋恣肆、",
    "start": 531.168,
    "end": 536.791,
    "duration": 5.623
  },
  {
    "id": 117,
    "text": "行云流水的智性风范，屈原楚辞则奠定了句式铺排、",
    "start": 536.791,
    "end": 541.712,
    "duration": 4.921
  },
  {
    "id": 118,
    "text": "沉郁幽艳的抒情诗体范式。",
    "start": 541.712,
    "end": 544.29,
    "duration": 2.578
  },
  {
    "id": 119,
    "text": "随后，解析庄子散文的三言体裁结构，",
    "start": 544.29,
    "end": 547.804,
    "duration": 3.514
  },
  {
    "id": 120,
    "text": "具体表述到答题语句就是：庄子散文“以谬悠之说，",
    "start": 547.804,
    "end": 552.491,
    "duration": 4.687
  },
  {
    "id": 121,
    "text": "荒唐之言，无端崖之辞”自居，通篇采用“寓言”、",
    "start": 552.491,
    "end": 556.474,
    "duration": 3.983
  },
  {
    "id": 122,
    "text": "“重言”与“之言”相互生发的开放式叙事结构，",
    "start": 556.474,
    "end": 560.458,
    "duration": 3.984
  },
  {
    "id": 123,
    "text": "语言奇变跌宕，文气如长风卷浪，极具思辨爆发力。",
    "start": 560.458,
    "end": 565.144,
    "duration": 4.686
  },
  {
    "id": 124,
    "text": "-紧接着，深入论述屈原楚辞对诗歌形式的开创性贡献，",
    "start": 565.2,
    "end": 569.615,
    "duration": 4.415
  },
  {
    "id": 125,
    "text": "具体表述到答题语句就是：屈原楚辞则打破了《诗经》四言为主的短促节律，",
    "start": 569.615,
    "end": 575.636,
    "duration": 6.021
  },
  {
    "id": 126,
    "text": "大量吸收楚地民间巫风歌谣的语言养分，",
    "start": 575.636,
    "end": 579.048,
    "duration": 3.412
  },
  {
    "id": 127,
    "text": "创造出长短错落、参差多变的骚体诗形制。",
    "start": 579.048,
    "end": 582.46,
    "duration": 3.412
  },
  {
    "id": 128,
    "text": "最后，点出楚辞的句法与音乐性机制，",
    "start": 582.46,
    "end": 585.47,
    "duration": 3.01
  },
  {
    "id": 129,
    "text": "具体表述到答题语句就是：屈原灵活运用“兮”字调控气息节奏，",
    "start": 585.47,
    "end": 590.487,
    "duration": 5.017
  },
  {
    "id": 130,
    "text": "句法铺排繁密，字句幽美峻洁，融神话传说、",
    "start": 590.487,
    "end": 593.899,
    "duration": 3.412
  },
  {
    "id": 131,
    "text": "历史典故与楚地方言于一炉，形成了音韵铿枪、",
    "start": 593.899,
    "end": 597.712,
    "duration": 3.813
  },
  {
    "id": 132,
    "text": "情辞并茂的悲剧抒情长调。",
    "start": 597.712,
    "end": 599.92,
    "duration": 2.208
  },
  {
    "id": 133,
    "text": "第三，在文体建构与语言美学形态上，",
    "start": 600.0,
    "end": 603.52,
    "duration": 3.52
  },
  {
    "id": 134,
    "text": "庄子散文展现了汪洋恣肆、行云流水的智性风范，",
    "start": 603.52,
    "end": 608.0,
    "duration": 4.48
  },
  {
    "id": 135,
    "text": "屈原楚辞则奠定了句式铺排、沉郁幽艳的抒情诗体范式。",
    "start": 608.0,
    "end": 613.28,
    "duration": 5.28
  },
  {
    "id": 136,
    "text": "庄子散文“以谬悠之说，荒唐之言，",
    "start": 613.28,
    "end": 616.64,
    "duration": 3.36
  },
  {
    "id": 137,
    "text": "无端崖之辞”自居，通篇采用“寓言”、",
    "start": 616.64,
    "end": 619.92,
    "duration": 3.28
  },
  {
    "id": 138,
    "text": "“重言”与“之言”相互生发的开放式叙事结构，",
    "start": 619.92,
    "end": 623.76,
    "duration": 3.84
  },
  {
    "id": 139,
    "text": "语言奇变跌宕，文气如长风卷浪，极具思辨爆发力。",
    "start": 623.76,
    "end": 628.56,
    "duration": 4.8
  },
  {
    "id": 140,
    "text": "屈原楚辞则打破了《诗经》四言为主的短促节律，",
    "start": 628.88,
    "end": 632.88,
    "duration": 4.0
  },
  {
    "id": 141,
    "text": "大量吸收楚地民间巫风歌谣的语言养分，",
    "start": 632.88,
    "end": 636.32,
    "duration": 3.44
  },
  {
    "id": 142,
    "text": "创造出长短错落、参差多变的骚体诗形制。",
    "start": 636.32,
    "end": 640.24,
    "duration": 3.92
  },
  {
    "id": 143,
    "text": "屈原灵活运用“兮”字调控气息节奏，",
    "start": 640.24,
    "end": 643.28,
    "duration": 3.04
  },
  {
    "id": 144,
    "text": "句法铺排繁密，字句幽美峻洁，融神话传说、",
    "start": 643.28,
    "end": 647.44,
    "duration": 4.16
  },
  {
    "id": 145,
    "text": "历史典故与楚地方言于一炉，形成了音韵铿枪、",
    "start": 647.44,
    "end": 651.76,
    "duration": 4.32
  },
  {
    "id": 146,
    "text": "情辞并茂的悲剧抒情长调。",
    "start": 651.76,
    "end": 654.08,
    "duration": 2.32
  },
  {
    "id": 147,
    "text": "五、结尾收束升华段内部咬合。",
    "start": 654.4,
    "end": 657.52,
    "duration": 3.12
  },
  {
    "id": 148,
    "text": "本段承担全篇论证成果的系统提炼与历史定位，",
    "start": 657.52,
    "end": 661.68,
    "duration": 4.16
  },
  {
    "id": 149,
    "text": "收束在后世两大传统的双向奠基上。",
    "start": 661.68,
    "end": 665.04,
    "duration": 3.36
  },
  {
    "id": 150,
    "text": "首先，概括庄子超逸传统的文学史意义，",
    "start": 665.04,
    "end": 668.72,
    "duration": 3.68
  },
  {
    "id": 151,
    "text": "具体表述到答题语句就是：综上所述，",
    "start": 668.72,
    "end": 671.92,
    "duration": 3.2
  },
  {
    "id": 152,
    "text": "庄子以其超然物外的出世哲学与奇诡超拔的寓言散文，",
    "start": 671.92,
    "end": 677.04,
    "duration": 5.12
  },
  {
    "id": 153,
    "text": "确立了中国文学追求心灵解放与自然自足的超逸传统。",
    "start": 677.04,
    "end": 681.44,
    "duration": 4.4
  },
  {
    "id": 154,
    "text": "-紧接着，概括屈原忠君爱国与悲剧精神的崇高意义，",
    "start": 681.6,
    "end": 686.041,
    "duration": 4.441
  },
  {
    "id": 155,
    "text": "具体表述到答题语句就是：屈原则以其殉身家国的政治执着与瑰丽悲壮的骚体辞赋，",
    "start": 686.041,
    "end": 693.442,
    "duration": 7.401
  },
  {
    "id": 156,
    "text": "铸就了中国士人忧国恤民与峻洁自持的崇高悲剧力量。",
    "start": 693.442,
    "end": 698.306,
    "duration": 4.864
  },
  {
    "id": 157,
    "text": "最后，点出两者并流的典范价值，具体表述到答题语句就是：两者交相辉映，",
    "start": 698.306,
    "end": 704.651,
    "duration": 6.345
  },
  {
    "id": 158,
    "text": "共同奠定了中国古典浪漫主义文学的坚固基石。",
    "start": 704.651,
    "end": 708.88,
    "duration": 4.229
  },
  {
    "id": 159,
    "text": "综上所述，庄子以其超然物外的出世哲学与奇诡超拔的寓言散文，",
    "start": 709.016,
    "end": 715.176,
    "duration": 6.16
  },
  {
    "id": 160,
    "text": "确立了中国文学追求心灵解放与自然自足的超逸传统。",
    "start": 715.176,
    "end": 720.136,
    "duration": 4.96
  },
  {
    "id": 161,
    "text": "屈原则以其殉身家国的政治执着与瑰丽悲壮的骚体辞赋，",
    "start": 720.136,
    "end": 725.736,
    "duration": 5.6
  },
  {
    "id": 162,
    "text": "铸就了中国士人忧国恤民与峻洁自持的崇高悲剧力量。",
    "start": 725.736,
    "end": 730.696,
    "duration": 4.96
  },
  {
    "id": 163,
    "text": "两者交相辉映，共同奠定了中国古典浪漫主义文学的坚固基石。",
    "start": 731.016,
    "end": 736.056,
    "duration": 5.04
  }
]