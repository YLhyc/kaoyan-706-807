[
  {
    "id": 1,
    "text": "简述孔尚任《桃花扇》“借离合之情，写兴亡之感”的思想主题与戏曲结构艺术。",
    "start": 0.134,
    "end": 5.906,
    "duration": 5.772
  },
  {
    "id": 2,
    "text": "孔尚任的《桃花扇》与洪昇《长生殿》并称清初戏剧“双璧”，",
    "start": 6.53,
    "end": 10.462,
    "duration": 3.932
  },
  {
    "id": 3,
    "text": "是一部严守“征实求信”原则的政治历史传奇。",
    "start": 10.841,
    "end": 13.453,
    "duration": 2.612
  },
  {
    "id": 4,
    "text": "作者在试一出《先声》中点明主旨：“借离合之情，写兴亡之感。”其思想意蕴与结构艺术，主要体现在以下三个方面：",
    "start": 13.982,
    "end": 23.774,
    "duration": 9.792
  },
  {
    "id": 5,
    "text": "第一，紧扣“借离合之情，写兴亡之感”，将儿女情缘与南明覆亡血肉相连。",
    "start": 24.398,
    "end": 30.61,
    "duration": 6.212
  },
  {
    "id": 6,
    "text": "《桃花扇》摆脱了才子佳人剧单纯流连风月的旧套，",
    "start": 31.139,
    "end": 36.721,
    "duration": 5.582
  },
  {
    "id": 7,
    "text": "将复社文人侯方域与秦淮名妓李香君的聚散悲欢，",
    "start": 37.1,
    "end": 41.232,
    "duration": 4.132
  },
  {
    "id": 8,
    "text": "严密嵌入南明弘光朝廷建立、党争内讧直至覆亡的历史进程之中。",
    "start": 41.611,
    "end": 46.183,
    "duration": 4.572
  },
  {
    "id": 9,
    "text": "全剧借二人的命运浮沉，揭露马士英、阮大铖等权奸营私误国的丑行，",
    "start": 46.712,
    "end": 53.654,
    "duration": 6.942
  },
  {
    "id": 10,
    "text": "歌颂史可法、李香君、柳敬亭等人坚守气节的崇高品格。",
    "start": 54.033,
    "end": 57.925,
    "duration": 3.892
  },
  {
    "id": 11,
    "text": "南明灭亡摧毁了二人的爱情归宿，国运兴衰支配个体离合，",
    "start": 58.454,
    "end": 64.196,
    "duration": 5.742
  },
  {
    "id": 12,
    "text": "深刻寄寓了作者痛定思痛的历史反思。",
    "start": 64.575,
    "end": 67.027,
    "duration": 2.452
  },
  {
    "id": 13,
    "text": "第二，以“桃花扇”为贯穿全剧的线索道具与象征纽带，结构精巧谨严。",
    "start": 67.651,
    "end": 73.713,
    "duration": 6.062
  },
  {
    "id": 14,
    "text": "孔尚任极重戏剧构造，以一柄“桃花扇”串联起全剧四十出的纷繁头绪：",
    "start": 74.242,
    "end": 80.504,
    "duration": 6.262
  },
  {
    "id": 15,
    "text": "从侯李定情题诗赠扇、权奸逼嫁时香君溅血诗扇、杨龙友以画笔点染成桃花扇，到终局张瑶星道士怒而撕扇。",
    "start": 80.883,
    "end": 90.875,
    "duration": 9.992
  },
  {
    "id": 16,
    "text": "这柄扇子既是侯李定情信物与香君气节象征，又是南明政局盛衰的见证。",
    "start": 91.404,
    "end": 97.806,
    "duration": 6.402
  },
  {
    "id": 17,
    "text": "全剧以扇联结儿女情与兴亡史，双线交错而又脉络贯通，",
    "start": 98.335,
    "end": 103.717,
    "duration": 5.382
  },
  {
    "id": 18,
    "text": "起伏转折而不枝不蔓，体现了高度谨严的结构匠心。",
    "start": 104.096,
    "end": 108.148,
    "duration": 4.052
  },
  {
    "id": 19,
    "text": "第三，打破大团圆俗套，以入道幻灭铸就崇高悲凉的历史悲剧意蕴。",
    "start": 108.866,
    "end": 114.198,
    "duration": 5.332
  },
  {
    "id": 20,
    "text": "剧作突破了传统戏曲“破镜重圆”的虚饰结局。",
    "start": 114.916,
    "end": 118.168,
    "duration": 3.252
  },
  {
    "id": 21,
    "text": "终局南京栖霞山白云庵中，侯方域与李香君劫后重聚之际，",
    "start": 118.799,
    "end": 124.211,
    "duration": 5.412
  },
  {
    "id": 22,
    "text": "张瑶星道士一声呵斥：“两个痴虫，你看国在哪里？家在哪里？君在哪里？父在哪里？”随后撕碎桃花扇，",
    "start": 124.59,
    "end": 132.911,
    "duration": 8.321
  },
  {
    "id": 23,
    "text": "二人冷汗淋漓、如梦忽醒，双双入道。",
    "start": 133.29,
    "end": 136.182,
    "duration": 2.892
  },
  {
    "id": 24,
    "text": "这一结局割断花月情根，将全剧由世俗儿女私情升华至对国家兴亡与沧桑历史的深沉反思，",
    "start": 136.711,
    "end": 144.403,
    "duration": 7.692
  },
  {
    "id": 25,
    "text": "赋予剧作悲凉雄浑的史诗格调。",
    "start": 144.782,
    "end": 147.234,
    "duration": 2.452
  }
]