[
  {
    "id": "sent_1",
    "text": "孔尚任的 《桃花扇》 是清初历史传奇剧的巅峰之作，",
    "start": 0.08,
    "end": 3.72,
    "duration": 3.64
  },
  {
    "id": "sent_2",
    "text": "与洪昇的 《长生殿》 并称为清代戏剧的 “双璧”。",
    "start": 4.169,
    "end": 7.729,
    "duration": 3.56
  },
  {
    "id": "sent_3",
    "text": "孔尚任以明清鼎革的巨变历史为题材，",
    "start": 8.179,
    "end": 11.299,
    "duration": 3.12
  },
  {
    "id": "sent_4",
    "text": "创作了一部具有深沉兴亡反思意识的政治历史剧。",
    "start": 11.749,
    "end": 15.669,
    "duration": 3.92
  },
  {
    "id": "sent_5",
    "text": "作者在 《桃花扇小引》 中明确标举其宗旨：“借离合之情，",
    "start": 16.119,
    "end": 20.799,
    "duration": 4.68
  },
  {
    "id": "sent_6",
    "text": "写兴亡之感。",
    "start": 21.249,
    "end": 22.569,
    "duration": 1.32
  },
  {
    "id": "sent_7",
    "text": "”《桃花扇》 的思想主题与戏曲结构艺术，",
    "start": 23.019,
    "end": 25.699,
    "duration": 2.68
  },
  {
    "id": "sent_8",
    "text": "主要展现为以下三个核心维度：",
    "start": 26.149,
    "end": 28.549,
    "duration": 2.4
  },
  {
    "id": "sent_9",
    "text": "第一，确立“借离合之情，写兴亡之感”的主旨，",
    "start": 28.999,
    "end": 32.839,
    "duration": 3.84
  },
  {
    "id": "sent_10",
    "text": "将儿女情长与南明覆亡紧密交融。",
    "start": 33.369,
    "end": 36.129,
    "duration": 2.76
  },
  {
    "id": "sent_11",
    "text": "《桃花扇》 摒弃了传统才子佳人剧单纯沉溺于风月相悦的俗套，",
    "start": 36.579,
    "end": 41.219,
    "duration": 4.64
  },
  {
    "id": "sent_12",
    "text": "将复社文人侯方域与秦淮名妓李香君的爱情悲欢，",
    "start": 41.749,
    "end": 45.949,
    "duration": 4.2
  },
  {
    "id": "sent_13",
    "text": "与南明弘光小朝廷的建立、内讧及灭亡的历史血肉相连。",
    "start": 46.399,
    "end": 50.919,
    "duration": 4.52
  },
  {
    "id": "sent_14",
    "text": "剧中展示的不仅是一对青年男女的爱恨离合，更是通过这一线索，",
    "start": 51.369,
    "end": 56.529,
    "duration": 5.16
  },
  {
    "id": "sent_15",
    "text": "全景式暴露了阮大铖、马士英等阉党余孽的专权营私，",
    "start": 56.979,
    "end": 61.299,
    "duration": 4.32
  },
  {
    "id": "sent_16",
    "text": "以及史可法独木难支的悲壮殉国。",
    "start": 61.829,
    "end": 64.549,
    "duration": 2.72
  },
  {
    "id": "sent_17",
    "text": "南明的覆亡摧毁了侯李二人的爱情归宿，",
    "start": 64.999,
    "end": 68.119,
    "duration": 3.12
  },
  {
    "id": "sent_18",
    "text": "而二人的离合聚散亦成为南明政局动荡的晴雨表，",
    "start": 68.569,
    "end": 72.409,
    "duration": 3.84
  },
  {
    "id": "sent_19",
    "text": "深刻揭示了国家兴亡对个体命运的绝对主宰。",
    "start": 72.859,
    "end": 76.459,
    "duration": 3.6
  },
  {
    "id": "sent_20",
    "text": "第二，以“桃花扇”为全剧聚散离合的核心戏剧道具与象征纽带。",
    "start": 76.989,
    "end": 81.709,
    "duration": 4.72
  },
  {
    "id": "sent_21",
    "text": "全剧在结构营构上展现出高度谨严的艺术匠心。",
    "start": 82.159,
    "end": 86.159,
    "duration": 4.0
  },
  {
    "id": "sent_22",
    "text": "孔尚任匠心独运地以一柄 “桃花扇” 贯穿全剧四十出：",
    "start": 86.609,
    "end": 90.889,
    "duration": 4.28
  },
  {
    "id": "sent_23",
    "text": "从定情时的题诗赠扇、权奸逼嫁时的血溅诗扇、",
    "start": 91.339,
    "end": 95.419,
    "duration": 4.08
  },
  {
    "id": "sent_24",
    "text": "友人杨龙友点血染画成桃花扇，到入道时的撕碎道袍拂尘剖扇。",
    "start": 95.869,
    "end": 100.829,
    "duration": 4.96
  },
  {
    "id": "sent_25",
    "text": "这柄扇子既是侯李爱情的信物，又是香君坚贞不屈气节的象征，",
    "start": 101.399,
    "end": 106.519,
    "duration": 5.12
  },
  {
    "id": "sent_26",
    "text": "更是南明王朝由盛转衰、直至覆亡的历史见证。",
    "start": 106.969,
    "end": 110.809,
    "duration": 3.84
  },
  {
    "id": "sent_27",
    "text": "全剧以扇生情，以扇见史，线索集中、针线细密，",
    "start": 111.339,
    "end": 116.019,
    "duration": 4.68
  },
  {
    "id": "sent_28",
    "text": "达到了戏曲结构谨严化境。",
    "start": 116.469,
    "end": 118.629,
    "duration": 2.16
  },
  {
    "id": "sent_29",
    "text": "第三，打破大团圆俗套，",
    "start": 119.079,
    "end": 121.079,
    "duration": 2.0
  },
  {
    "id": "sent_30",
    "text": "以出家入道与家国幻灭铸就崇高的历史悲剧意蕴。",
    "start": 121.529,
    "end": 125.849,
    "duration": 4.32
  },
  {
    "id": "sent_31",
    "text": "剧作的高超之处，在于彻底突破了中国传统古典戏曲 “金榜题名、",
    "start": 126.299,
    "end": 131.419,
    "duration": 5.12
  },
  {
    "id": "sent_32",
    "text": "破镜重圆” 的虚饰套路。",
    "start": 131.869,
    "end": 133.589,
    "duration": 1.72
  },
  {
    "id": "sent_33",
    "text": "在终局白兆山栖霞道院中，",
    "start": 134.039,
    "end": 136.479,
    "duration": 2.44
  },
  {
    "id": "sent_34",
    "text": "正当侯方域与李香君历经磨难即将重聚之际，张道士一声断喝：",
    "start": 136.929,
    "end": 142.009,
    "duration": 5.08
  },
  {
    "id": "sent_35",
    "text": "“两个痴虫，你看国在哪里？",
    "start": 142.459,
    "end": 144.499,
    "duration": 2.04
  },
  {
    "id": "sent_36",
    "text": "家在哪里？",
    "start": 145.029,
    "end": 145.989,
    "duration": 0.96
  },
  {
    "id": "sent_37",
    "text": "君在哪里？",
    "start": 146.439,
    "end": 147.479,
    "duration": 1.04
  },
  {
    "id": "sent_38",
    "text": "父在哪里？",
    "start": 147.929,
    "end": 148.809,
    "duration": 0.88
  },
  {
    "id": "sent_39",
    "text": "” 犹如当头棒喝，惊醒了二人的世俗私情。",
    "start": 149.259,
    "end": 152.699,
    "duration": 3.44
  },
  {
    "id": "sent_40",
    "text": "二人当下撕裂桃花扇、出家入道。",
    "start": 153.149,
    "end": 155.909,
    "duration": 2.76
  },
  {
    "id": "sent_41",
    "text": "这一决绝结局彻底粉碎了私情执念，",
    "start": 156.359,
    "end": 159.279,
    "duration": 2.92
  },
  {
    "id": "sent_42",
    "text": "将全剧由世俗情爱升华到对沧桑历史与家国沦丧的终极反思，",
    "start": 159.729,
    "end": 165.089,
    "duration": 5.36
  },
  {
    "id": "sent_43",
    "text": "形成了深沉悲凉的史诗品格。",
    "start": 165.539,
    "end": 167.979,
    "duration": 2.44
  }
]