[
  {
    "id": 1,
    "text": "简述孔尚任《桃花扇》“借离合之情，写兴亡之感”的思想主题与戏曲结构艺术。",
    "start": 0.2,
    "end": 7.24,
    "duration": 7.04
  },
  {
    "id": 2,
    "text": "孔尚任的《桃花扇》与洪昇《长生殿》并称清初戏剧“双璧”，",
    "start": 7.76,
    "end": 12.48,
    "duration": 4.72
  },
  {
    "id": 3,
    "text": "是一部严守“征实求信”原则的政治历史传奇。",
    "start": 12.85,
    "end": 16.29,
    "duration": 3.44
  },
  {
    "id": 4,
    "text": "作者在试一出《先声》中点明主旨：“借离合之情，写兴亡之感。”其思想意蕴与结构艺术，主要体现在以下三个方面：",
    "start": 16.81,
    "end": 26.3,
    "duration": 9.49
  },
  {
    "id": 5,
    "text": "第一，紧扣“借离合之情，写兴亡之感”，将儿女情缘与南明覆亡血肉相连。",
    "start": 26.67,
    "end": 33.79,
    "duration": 7.12
  },
  {
    "id": 6,
    "text": "《桃花扇》摆脱了才子佳人剧单纯流连风月的旧套，",
    "start": 34.31,
    "end": 38.15,
    "duration": 3.84
  },
  {
    "id": 7,
    "text": "将复社文人侯方域与秦淮名妓李香君的聚散悲欢，",
    "start": 38.52,
    "end": 43.16,
    "duration": 4.64
  },
  {
    "id": 8,
    "text": "严密嵌入南明弘光朝廷建立、党争内讧直至覆亡的历史进程之中。",
    "start": 43.53,
    "end": 49.21,
    "duration": 5.68
  },
  {
    "id": 9,
    "text": "全剧借二人的命运浮沉，揭露马士英、阮大铖等权奸营私误国的丑行，",
    "start": 49.762,
    "end": 55.332,
    "duration": 5.57
  },
  {
    "id": 10,
    "text": "歌颂史可法、李香君、柳敬亭等人坚守气节的崇高品格。",
    "start": 55.702,
    "end": 60.342,
    "duration": 4.64
  },
  {
    "id": 11,
    "text": "南明灭亡摧毁了二人的爱情归宿，国运兴衰支配个体离合，",
    "start": 60.862,
    "end": 65.662,
    "duration": 4.8
  },
  {
    "id": 12,
    "text": "深刻寄寓了作者痛定思痛的历史反思。",
    "start": 66.062,
    "end": 68.942,
    "duration": 2.88
  },
  {
    "id": 13,
    "text": "第二，以“桃花扇”为贯穿全剧的线索道具与象征纽带，结构精巧谨严。",
    "start": 69.462,
    "end": 75.302,
    "duration": 5.84
  },
  {
    "id": 14,
    "text": "孔尚任极重戏剧构造，以一柄“桃花扇”串联起全剧四十出的纷繁头绪：",
    "start": 75.822,
    "end": 81.342,
    "duration": 5.52
  },
  {
    "id": 15,
    "text": "从侯李定情题诗赠扇、权奸逼嫁时香君溅血诗扇、杨龙友以画笔点染成桃花扇，到终局张瑶星道士怒而撕扇。",
    "start": 81.712,
    "end": 92.512,
    "duration": 10.8
  },
  {
    "id": 16,
    "text": "这柄扇子既是侯李定情信物与香君气节象征，又是南明政局盛衰的见证。",
    "start": 93.032,
    "end": 99.261,
    "duration": 6.229
  },
  {
    "id": 17,
    "text": "全剧以扇联结儿女情与兴亡史，双线交错而又脉络贯通，",
    "start": 99.761,
    "end": 104.912,
    "duration": 5.151
  },
  {
    "id": 18,
    "text": "起伏转折而不枝不蔓，体现了高度谨严的结构匠心。",
    "start": 105.282,
    "end": 109.602,
    "duration": 4.32
  },
  {
    "id": 19,
    "text": "第三，打破大团圆俗套，以入道幻灭铸就崇高悲凉的历史悲剧意蕴。",
    "start": 110.122,
    "end": 116.442,
    "duration": 6.32
  },
  {
    "id": 20,
    "text": "剧作突破了传统戏曲“破镜重圆”的虚饰结局。",
    "start": 116.962,
    "end": 120.482,
    "duration": 3.52
  },
  {
    "id": 21,
    "text": "终局南京栖霞山白云庵中，侯方域与李香君劫后重聚之际，",
    "start": 121.002,
    "end": 126.202,
    "duration": 5.2
  },
  {
    "id": 22,
    "text": "张瑶星道士一声呵斥：“两个痴虫，你看国在哪里？家在哪里？君在哪里？父在哪里？”随后撕碎桃花扇，",
    "start": 126.572,
    "end": 135.579,
    "duration": 9.007
  },
  {
    "id": 23,
    "text": "二人冷汗淋漓、如梦忽醒，双双入道。",
    "start": 135.949,
    "end": 139.202,
    "duration": 3.253
  },
  {
    "id": 24,
    "text": "这一结局割断花月情根，将全剧由世俗儿女私情升华至对国家兴亡与沧桑历史的深沉反思，",
    "start": 139.722,
    "end": 148.202,
    "duration": 8.48
  },
  {
    "id": 25,
    "text": "赋予剧作悲凉雄浑的史诗格调。",
    "start": 148.682,
    "end": 151.242,
    "duration": 2.56
  }
]
