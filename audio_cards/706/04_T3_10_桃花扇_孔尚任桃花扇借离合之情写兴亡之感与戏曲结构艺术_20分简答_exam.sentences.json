[
  {
    "id": 1,
    "text": "简述孔尚任《桃花扇》“借离合之情，",
    "start": 0.11,
    "end": 3.308,
    "duration": 3.198
  },
  {
    "id": 2,
    "text": "写兴亡之感”的思想主题与戏曲结构艺术。",
    "start": 3.516,
    "end": 6.974,
    "duration": 3.458
  },
  {
    "id": 3,
    "text": "孔尚任的《桃花扇》与洪昇《长生殿》并称清初戏剧“双璧”，",
    "start": 7.429,
    "end": 11.999,
    "duration": 4.57
  },
  {
    "id": 4,
    "text": "是一部严守“征实求信”原则的政治历史传奇。",
    "start": 12.409,
    "end": 15.918,
    "duration": 3.509
  },
  {
    "id": 5,
    "text": "作者在《桃花扇小引》中点明主旨：“借离合之情，写兴亡之感。",
    "start": 16.185,
    "end": 21.314,
    "duration": 5.129
  },
  {
    "id": 6,
    "text": "”其思想意蕴与结构艺术，主要体现在以下三个方面：",
    "start": 21.556,
    "end": 25.791,
    "duration": 4.235
  },
  {
    "id": 7,
    "text": "第一，紧扣“借离合之情，写兴亡之感”，",
    "start": 26.395,
    "end": 29.793,
    "duration": 3.398
  },
  {
    "id": 8,
    "text": "将儿女情缘与南明覆亡血肉相连。",
    "start": 30.305,
    "end": 33.228,
    "duration": 2.923
  },
  {
    "id": 9,
    "text": "《桃花扇》摆脱了才子佳人剧单纯流连风月的旧套，",
    "start": 33.467,
    "end": 36.942,
    "duration": 3.475
  },
  {
    "id": 10,
    "text": "将复社文人侯方域与秦淮名妓李香君的聚散悲欢，",
    "start": 37.33,
    "end": 41.39,
    "duration": 4.06
  },
  {
    "id": 11,
    "text": "严密嵌入南明弘光朝廷建立、",
    "start": 41.673,
    "end": 43.975,
    "duration": 2.302
  },
  {
    "id": 12,
    "text": "党争内讧直至覆亡的历史进程之中。",
    "start": 44.413,
    "end": 47.112,
    "duration": 2.699
  },
  {
    "id": 13,
    "text": "全剧借二人的命运浮沉，揭露马士英、",
    "start": 47.348,
    "end": 50.233,
    "duration": 2.885
  },
  {
    "id": 14,
    "text": "阮大铖等权奸营私误国的丑行，歌颂史可法、李香君、",
    "start": 50.932,
    "end": 55.725,
    "duration": 4.793
  },
  {
    "id": 15,
    "text": "柳敬亭等人坚守气节的崇高品格。",
    "start": 56.401,
    "end": 59.043,
    "duration": 2.642
  },
  {
    "id": 16,
    "text": "南明灭亡摧毁了二人的爱情归宿，国运兴衰支配个体离合，",
    "start": 59.683,
    "end": 64.566,
    "duration": 4.883
  },
  {
    "id": 17,
    "text": "深刻寄寓了作者痛定思痛的历史反思。",
    "start": 64.864,
    "end": 67.771,
    "duration": 2.907
  },
  {
    "id": 18,
    "text": "第二，以“桃花扇”为贯穿全剧的线索道具与象征纽带，",
    "start": 68.376,
    "end": 72.612,
    "duration": 4.236
  },
  {
    "id": 19,
    "text": "结构精巧谨严。",
    "start": 73.032,
    "end": 74.327,
    "duration": 1.295
  },
  {
    "id": 20,
    "text": "孔尚任极重戏剧构造，",
    "start": 74.82,
    "end": 76.316,
    "duration": 1.496
  },
  {
    "id": 21,
    "text": "以一柄“桃花扇”串联起全剧四十出的纷繁头绪：",
    "start": 76.614,
    "end": 80.018,
    "duration": 3.404
  },
  {
    "id": 22,
    "text": "从侯李定情题诗赠扇、权奸逼嫁时香君溅血诗扇、",
    "start": 80.187,
    "end": 85.015,
    "duration": 4.828
  },
  {
    "id": 23,
    "text": "杨龙友以画笔点染成桃花扇，到终局张瑶星道士怒而撕扇。",
    "start": 85.484,
    "end": 90.574,
    "duration": 5.09
  },
  {
    "id": 24,
    "text": "这柄扇子既是侯李定情信物与香君气节象征，",
    "start": 90.948,
    "end": 95.2,
    "duration": 4.252
  },
  {
    "id": 25,
    "text": "又是南明政局盛衰的见证。",
    "start": 95.439,
    "end": 97.491,
    "duration": 2.052
  },
  {
    "id": 26,
    "text": "全剧以扇联结儿女情与兴亡史，双线交错而又脉络贯通，",
    "start": 98.108,
    "end": 103.44,
    "duration": 5.332
  },
  {
    "id": 27,
    "text": "起伏转折而不枝不蔓，体现了高度谨严的结构匠心。",
    "start": 103.995,
    "end": 108.578,
    "duration": 4.583
  },
  {
    "id": 28,
    "text": "第三，打破大团圆俗套，以入道幻灭铸就崇高悲凉的历史悲剧意蕴。",
    "start": 109.225,
    "end": 114.838,
    "duration": 5.613
  },
  {
    "id": 29,
    "text": "剧作突破了传统戏曲“破镜重圆”的虚饰结局。",
    "start": 115.116,
    "end": 118.749,
    "duration": 3.633
  },
  {
    "id": 30,
    "text": "终局南京栖霞山白云庵中，侯方域与李香君劫后重聚之际，",
    "start": 118.99,
    "end": 123.762,
    "duration": 4.772
  },
  {
    "id": 31,
    "text": "张瑶星道士一声呵斥：“两个痴虫，你看国在哪里？",
    "start": 123.966,
    "end": 127.942,
    "duration": 3.976
  },
  {
    "id": 32,
    "text": "家在哪里？",
    "start": 128.2,
    "end": 128.953,
    "duration": 0.753
  },
  {
    "id": 33,
    "text": "君在哪里？",
    "start": 129.226,
    "end": 130.011,
    "duration": 0.785
  },
  {
    "id": 34,
    "text": "父在哪里？",
    "start": 130.23,
    "end": 130.935,
    "duration": 0.705
  },
  {
    "id": 35,
    "text": "”随后撕碎桃花扇，二人冷汗淋漓、如梦忽醒，双双入道。",
    "start": 131.371,
    "end": 136.018,
    "duration": 4.647
  },
  {
    "id": 36,
    "text": "这一结局割断花月情根，",
    "start": 136.327,
    "end": 138.179,
    "duration": 1.852
  },
  {
    "id": 37,
    "text": "将全剧由世俗儿女私情升华至对国家兴亡与沧桑历史的深沉反思，",
    "start": 138.49,
    "end": 144.247,
    "duration": 5.757
  },
  {
    "id": 38,
    "text": "赋予剧作悲凉雄浑的史诗格调。",
    "start": 144.56,
    "end": 147.084,
    "duration": 2.524
  }
]