[
  {
    "id": 1,
    "text": "简述孔尚任《桃花扇》“借离合之情，",
    "start": 0.1,
    "end": 3.158,
    "duration": 3.058
  },
  {
    "id": 2,
    "text": "写兴亡之感”的思想主题与戏曲结构艺术。",
    "start": 3.311,
    "end": 6.625,
    "duration": 3.314
  },
  {
    "id": 3,
    "text": "孔尚任的 《桃花扇》 是清初历史传奇剧的巅峰之作，",
    "start": 6.986,
    "end": 10.468,
    "duration": 3.482
  },
  {
    "id": 4,
    "text": "与洪昇的 《长生殿》 并称为清代戏剧的 “双璧”。",
    "start": 10.795,
    "end": 14.022,
    "duration": 3.227
  },
  {
    "id": 5,
    "text": "孔尚任以明清鼎革的巨变历史为题材，",
    "start": 14.393,
    "end": 17.164,
    "duration": 2.771
  },
  {
    "id": 6,
    "text": "创作了一部具有深沉兴亡反思意识的政治历史剧。",
    "start": 17.339,
    "end": 21.464,
    "duration": 4.125
  },
  {
    "id": 7,
    "text": "作者在 《桃花扇小引》 中明确标举其宗旨：“借离合之情，",
    "start": 21.708,
    "end": 26.365,
    "duration": 4.657
  },
  {
    "id": 8,
    "text": "写兴亡之感。",
    "start": 26.427,
    "end": 27.495,
    "duration": 1.068
  },
  {
    "id": 9,
    "text": "”《桃花扇》 的思想主题与戏曲结构艺术，",
    "start": 27.637,
    "end": 30.607,
    "duration": 2.97
  },
  {
    "id": 10,
    "text": "主要展现为以下三个核心维度：",
    "start": 30.845,
    "end": 33.038,
    "duration": 2.193
  },
  {
    "id": 11,
    "text": "第一，确立“借离合之情，写兴亡之感”的主旨，",
    "start": 33.188,
    "end": 37.212,
    "duration": 4.024
  },
  {
    "id": 12,
    "text": "将儿女情长与南明覆亡紧密交融。",
    "start": 37.56,
    "end": 40.45,
    "duration": 2.89
  },
  {
    "id": 13,
    "text": "《桃花扇》 摒弃了传统才子佳人剧单纯沉溺于风月相悦的俗套，",
    "start": 40.659,
    "end": 45.87,
    "duration": 5.211
  },
  {
    "id": 14,
    "text": "将复社文人侯方域与秦淮名妓李香君的爱情悲欢，",
    "start": 46.039,
    "end": 50.474,
    "duration": 4.435
  },
  {
    "id": 15,
    "text": "与南明弘光小朝廷的建立、内讧及灭亡的历史血肉相连。",
    "start": 50.741,
    "end": 55.325,
    "duration": 4.584
  },
  {
    "id": 16,
    "text": "剧中展示的不仅是一对青年男女的爱恨离合，",
    "start": 55.472,
    "end": 58.753,
    "duration": 3.281
  },
  {
    "id": 17,
    "text": "更是通过这一线索，全景式暴露了阮大铖、",
    "start": 58.822,
    "end": 62.091,
    "duration": 3.269
  },
  {
    "id": 18,
    "text": "马士英等阉党余孽的专权营私，",
    "start": 62.128,
    "end": 64.819,
    "duration": 2.691
  },
  {
    "id": 19,
    "text": "以及史可法独木难支的悲壮殉国。",
    "start": 65.117,
    "end": 67.925,
    "duration": 2.808
  },
  {
    "id": 20,
    "text": "南明的覆亡摧毁了侯李二人的爱情归宿，",
    "start": 68.097,
    "end": 70.954,
    "duration": 2.857
  },
  {
    "id": 21,
    "text": "而二人的离合聚散亦成为南明政局动荡的晴雨表，",
    "start": 71.405,
    "end": 75.036,
    "duration": 3.631
  },
  {
    "id": 22,
    "text": "深刻揭示了国家兴亡对个体命运的绝对主宰。",
    "start": 75.372,
    "end": 79.007,
    "duration": 3.635
  },
  {
    "id": 23,
    "text": "第二，以“桃花扇”为全剧聚散离合的核心戏剧道具与象征纽带。",
    "start": 79.228,
    "end": 84.268,
    "duration": 5.04
  },
  {
    "id": 24,
    "text": "全剧在结构营构上展现出高度谨严的艺术匠心。",
    "start": 84.599,
    "end": 88.364,
    "duration": 3.765
  },
  {
    "id": 25,
    "text": "孔尚任匠心独运地以一柄 “桃花扇” 贯穿全剧四十出：",
    "start": 88.576,
    "end": 93.12,
    "duration": 4.544
  },
  {
    "id": 26,
    "text": "从定情时的题诗赠扇、权奸逼嫁时的血溅诗扇、",
    "start": 93.488,
    "end": 97.895,
    "duration": 4.407
  },
  {
    "id": 27,
    "text": "友人杨龙友点血染画成桃花扇，到入道时的撕碎道袍拂尘剖扇。",
    "start": 98.118,
    "end": 103.514,
    "duration": 5.396
  },
  {
    "id": 28,
    "text": "这柄扇子既是侯李爱情的信物，又是香君坚贞不屈气节的象征，",
    "start": 103.827,
    "end": 108.936,
    "duration": 5.109
  },
  {
    "id": 29,
    "text": "更是南明王朝由盛转衰、直至覆亡的历史见证。",
    "start": 109.215,
    "end": 113.068,
    "duration": 3.853
  },
  {
    "id": 30,
    "text": "全剧以扇生情，以扇见史，线索集中、针线细密，",
    "start": 113.283,
    "end": 117.933,
    "duration": 4.65
  },
  {
    "id": 31,
    "text": "达到了戏曲结构谨严化境。",
    "start": 118.143,
    "end": 120.276,
    "duration": 2.133
  },
  {
    "id": 32,
    "text": "第三，打破大团圆俗套，",
    "start": 120.359,
    "end": 122.094,
    "duration": 1.735
  },
  {
    "id": 33,
    "text": "以出家入道与家国幻灭铸就崇高的历史悲剧意蕴。",
    "start": 122.453,
    "end": 126.898,
    "duration": 4.445
  },
  {
    "id": 34,
    "text": "剧作的高超之处，",
    "start": 127.205,
    "end": 128.483,
    "duration": 1.278
  },
  {
    "id": 35,
    "text": "在于彻底突破了中国传统古典戏曲 “金榜题名、",
    "start": 128.548,
    "end": 132.526,
    "duration": 3.978
  },
  {
    "id": 36,
    "text": "破镜重圆” 的虚饰套路。",
    "start": 132.548,
    "end": 134.326,
    "duration": 1.778
  },
  {
    "id": 37,
    "text": "在终局白兆山栖霞道院中，",
    "start": 134.513,
    "end": 136.931,
    "duration": 2.418
  },
  {
    "id": 38,
    "text": "正当侯方域与李香君历经磨难即将重聚之际，张道士一声断喝：",
    "start": 137.0,
    "end": 142.085,
    "duration": 5.085
  },
  {
    "id": 39,
    "text": "“两个痴虫，你看国在哪里？",
    "start": 142.436,
    "end": 144.365,
    "duration": 1.929
  },
  {
    "id": 40,
    "text": "家在哪里？",
    "start": 144.6,
    "end": 145.323,
    "duration": 0.723
  },
  {
    "id": 41,
    "text": "君在哪里？",
    "start": 145.482,
    "end": 146.19,
    "duration": 0.708
  },
  {
    "id": 42,
    "text": "父在哪里？",
    "start": 146.402,
    "end": 147.247,
    "duration": 0.845
  },
  {
    "id": 43,
    "text": "” 犹如当头棒喝，惊醒了二人的世俗私情。",
    "start": 147.438,
    "end": 150.826,
    "duration": 3.388
  },
  {
    "id": 44,
    "text": "二人当下撕裂桃花扇、出家入道。",
    "start": 151.212,
    "end": 153.954,
    "duration": 2.742
  },
  {
    "id": 45,
    "text": "这一决绝结局彻底粉碎了私情执念，",
    "start": 154.581,
    "end": 157.834,
    "duration": 3.253
  },
  {
    "id": 46,
    "text": "将全剧由世俗情爱升华到对沧桑历史与家国沦丧的终极反思，",
    "start": 158.213,
    "end": 163.856,
    "duration": 5.643
  },
  {
    "id": 47,
    "text": "形成了深沉悲凉的史诗品格。",
    "start": 164.236,
    "end": 166.848,
    "duration": 2.612
  }
]
