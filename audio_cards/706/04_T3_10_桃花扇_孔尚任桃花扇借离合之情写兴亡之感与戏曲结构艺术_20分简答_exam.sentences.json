[
  {
    "id": "sent_1",
    "text": "孔尚任的 《桃花扇》 是清初历史传奇剧的巅峰之作，",
    "start": 0.1,
    "end": 4.646,
    "duration": 4.546
  },
  {
    "id": "sent_2",
    "text": "与洪昇的 《长生殿》 并称为清代戏剧的 “双璧”。",
    "start": 4.596,
    "end": 8.476,
    "duration": 3.88
  },
  {
    "id": "sent_3",
    "text": "孔尚任以明清鼎革的巨变历史为题材，",
    "start": 8.477,
    "end": 12.292,
    "duration": 3.815
  },
  {
    "id": "sent_4",
    "text": "创作了一部具有深沉兴亡反思意识的政治历史剧。",
    "start": 12.292,
    "end": 16.68,
    "duration": 4.388
  },
  {
    "id": "sent_5",
    "text": "作者在 《桃花扇小引》 中明确标举其宗旨：“借离合之情，",
    "start": 16.68,
    "end": 21.862,
    "duration": 5.182
  },
  {
    "id": "sent_6",
    "text": "写兴亡之感。",
    "start": 21.862,
    "end": 23.568,
    "duration": 1.706
  },
  {
    "id": "sent_7",
    "text": "”《桃花扇》 的思想主题与戏曲结构艺术，",
    "start": 23.568,
    "end": 27.175,
    "duration": 3.607
  },
  {
    "id": "sent_8",
    "text": "主要展现为以下三个核心维度：",
    "start": 27.174,
    "end": 30.455,
    "duration": 3.281
  },
  {
    "id": "sent_9",
    "text": "第一，确立“借离合之情，写兴亡之感”的主旨，",
    "start": 30.456,
    "end": 34.922,
    "duration": 4.466
  },
  {
    "id": "sent_10",
    "text": "将儿女情长与南明覆亡紧密交融。",
    "start": 34.922,
    "end": 38.568,
    "duration": 3.646
  },
  {
    "id": "sent_11",
    "text": "《桃花扇》 摒弃了传统才子佳人剧单纯沉溺于风月相悦的俗套，",
    "start": 38.568,
    "end": 44.167,
    "duration": 5.599
  },
  {
    "id": "sent_12",
    "text": "将复社文人侯方域与秦淮名妓李香君的爱情悲欢，",
    "start": 44.167,
    "end": 48.959,
    "duration": 4.792
  },
  {
    "id": "sent_13",
    "text": "与南明弘光小朝廷的建立、内讧及灭亡的历史血肉相连。",
    "start": 48.958,
    "end": 54.362,
    "duration": 5.404
  },
  {
    "id": "sent_14",
    "text": "剧中展示的不仅是一对青年男女的爱恨离合，更是通过这一线索，",
    "start": 54.362,
    "end": 60.156,
    "duration": 5.794
  },
  {
    "id": "sent_15",
    "text": "全景式暴露了阮大铖、马士英等阉党余孽的专权营私，",
    "start": 60.156,
    "end": 65.286,
    "duration": 5.13
  },
  {
    "id": "sent_16",
    "text": "以及史可法独木难支的悲壮殉国。",
    "start": 65.286,
    "end": 68.58,
    "duration": 3.294
  },
  {
    "id": "sent_17",
    "text": "南明的覆亡摧毁了侯李二人的爱情归宿，",
    "start": 68.581,
    "end": 72.344,
    "duration": 3.763
  },
  {
    "id": "sent_18",
    "text": "而二人的离合聚散亦成为南明政局动荡的晴雨表，",
    "start": 72.344,
    "end": 77.37,
    "duration": 5.026
  },
  {
    "id": "sent_19",
    "text": "深刻揭示了国家兴亡对个体命运的绝对主宰。",
    "start": 77.37,
    "end": 82.005,
    "duration": 4.635
  },
  {
    "id": "sent_20",
    "text": "第二，以“桃花扇”为全剧聚散离合的核心戏剧道具与象征纽带。",
    "start": 82.005,
    "end": 88.177,
    "duration": 6.172
  },
  {
    "id": "sent_21",
    "text": "全剧在结构营构上展现出高度谨严的艺术匠心。",
    "start": 88.177,
    "end": 92.93,
    "duration": 4.753
  },
  {
    "id": "sent_22",
    "text": "孔尚任匠心独运地以一柄 “桃花扇” 贯穿全剧四十出：",
    "start": 92.93,
    "end": 98.099,
    "duration": 5.169
  },
  {
    "id": "sent_23",
    "text": "从定情时的题诗赠扇、权奸逼嫁时的血溅诗扇、友人杨龙友点血染画成桃花扇，",
    "start": 98.099,
    "end": 106.068,
    "duration": 7.969
  },
  {
    "id": "sent_24",
    "text": "到入道时的撕碎道袍拂尘剖扇。",
    "start": 106.068,
    "end": 109.506,
    "duration": 3.438
  },
  {
    "id": "sent_25",
    "text": "这柄扇子既是侯李爱情的信物，又是香君坚贞不屈气节的象征，",
    "start": 109.505,
    "end": 115.364,
    "duration": 5.859
  },
  {
    "id": "sent_26",
    "text": "更是南明王朝由盛转衰、直至覆亡的历史见证。",
    "start": 115.365,
    "end": 120.3,
    "duration": 4.935
  },
  {
    "id": "sent_27",
    "text": "全剧以扇生情，以扇见史，线索集中、针线细密，",
    "start": 120.299,
    "end": 125.533,
    "duration": 5.234
  },
  {
    "id": "sent_28",
    "text": "达到了戏曲结构谨严化境。",
    "start": 125.534,
    "end": 128.281,
    "duration": 2.747
  },
  {
    "id": "sent_29",
    "text": "第三，打破大团圆俗套，",
    "start": 128.281,
    "end": 130.976,
    "duration": 2.695
  },
  {
    "id": "sent_30",
    "text": "以出家入道与家国幻灭铸就崇高的历史悲剧意蕴。",
    "start": 130.977,
    "end": 136.094,
    "duration": 5.117
  },
  {
    "id": "sent_31",
    "text": "剧作的高超之处，",
    "start": 136.094,
    "end": 138.151,
    "duration": 2.057
  },
  {
    "id": "sent_32",
    "text": "在于彻底突破了中国传统古典戏曲 “金榜题名、破镜重圆” 的虚饰套路。",
    "start": 138.151,
    "end": 144.583,
    "duration": 6.432
  },
  {
    "id": "sent_33",
    "text": "在终局白兆山栖霞道院中，正当侯方域与李香君历经磨难即将重聚之际，",
    "start": 144.583,
    "end": 151.784,
    "duration": 7.201
  },
  {
    "id": "sent_34",
    "text": "张道士一声断喝：“两个痴虫，你看国在哪里？",
    "start": 151.784,
    "end": 156.094,
    "duration": 4.31
  },
  {
    "id": "sent_35",
    "text": "家在哪里？",
    "start": 156.094,
    "end": 157.526,
    "duration": 1.432
  },
  {
    "id": "sent_36",
    "text": "君在哪里？",
    "start": 157.526,
    "end": 158.997,
    "duration": 1.471
  },
  {
    "id": "sent_37",
    "text": "父在哪里？",
    "start": 158.997,
    "end": 160.377,
    "duration": 1.38
  },
  {
    "id": "sent_38",
    "text": "” 犹如当头棒喝，惊醒了二人的世俗私情。",
    "start": 160.378,
    "end": 164.375,
    "duration": 3.997
  },
  {
    "id": "sent_39",
    "text": "二人当下撕裂桃花扇、出家入道。",
    "start": 164.375,
    "end": 167.786,
    "duration": 3.411
  },
  {
    "id": "sent_40",
    "text": "这一决绝结局彻底粉碎了私情执念，",
    "start": 167.786,
    "end": 171.575,
    "duration": 3.789
  },
  {
    "id": "sent_41",
    "text": "将全剧由世俗情爱升华到对沧桑历史与家国沦丧的终极反思，",
    "start": 171.576,
    "end": 177.878,
    "duration": 6.302
  },
  {
    "id": "sent_42",
    "text": "形成了深沉悲凉的史诗品格。",
    "start": 177.877,
    "end": 180.859,
    "duration": 2.982
  }
]