[
  {
    "id": 1,
    "text": "简述孔尚任《桃花扇》“借离合之情，",
    "start": 0.05,
    "end": 3.328,
    "duration": 3.278
  },
  {
    "id": 2,
    "text": "写兴亡之感”的思想主题与戏曲结构艺术。",
    "start": 3.328,
    "end": 6.996,
    "duration": 3.668
  },
  {
    "id": 3,
    "text": "孔尚任的 《桃花扇》 是清初历史传奇剧的巅峰之作，",
    "start": 6.996,
    "end": 10.806,
    "duration": 3.81
  },
  {
    "id": 4,
    "text": "与洪昇的 《长生殿》 并称为清代戏剧的 “双璧”。",
    "start": 10.806,
    "end": 14.403,
    "duration": 3.597
  },
  {
    "id": 5,
    "text": "孔尚任以明清鼎革的巨变历史为题材，",
    "start": 14.403,
    "end": 17.511,
    "duration": 3.108
  },
  {
    "id": 6,
    "text": "创作了一部具有深沉兴亡反思意识的政治历史剧。",
    "start": 17.511,
    "end": 21.718,
    "duration": 4.207
  },
  {
    "id": 7,
    "text": "作者在 《桃花扇小引》 中明确标举其宗旨：“借离合之情，",
    "start": 21.718,
    "end": 26.444,
    "duration": 4.726
  },
  {
    "id": 8,
    "text": "写兴亡之感。",
    "start": 26.444,
    "end": 27.647,
    "duration": 1.203
  },
  {
    "id": 9,
    "text": "”《桃花扇》 的思想主题与戏曲结构艺术，",
    "start": 27.647,
    "end": 30.855,
    "duration": 3.208
  },
  {
    "id": 10,
    "text": "主要展现为以下三个核心维度：",
    "start": 30.855,
    "end": 34.58,
    "duration": 3.725
  },
  {
    "id": 11,
    "text": "第一，确立“借离合之情，写兴亡之感”的主旨，",
    "start": 34.58,
    "end": 38.781,
    "duration": 4.201
  },
  {
    "id": 12,
    "text": "将儿女情长与南明覆亡紧密交融。",
    "start": 38.781,
    "end": 41.326,
    "duration": 2.545
  },
  {
    "id": 13,
    "text": "《桃花扇》 摒弃了传统才子佳人剧单纯沉溺于风月相悦的俗套，",
    "start": 41.326,
    "end": 46.051,
    "duration": 4.725
  },
  {
    "id": 14,
    "text": "将复社文人侯方域与秦淮名妓李香君的爱情悲欢，",
    "start": 46.051,
    "end": 50.756,
    "duration": 4.705
  },
  {
    "id": 15,
    "text": "与南明弘光小朝廷的建立、内讧及灭亡的历史血肉相连。",
    "start": 50.756,
    "end": 55.482,
    "duration": 4.726
  },
  {
    "id": 16,
    "text": "剧中展示的不仅是一对青年男女的爱恨离合，",
    "start": 55.482,
    "end": 60.291,
    "duration": 4.809
  },
  {
    "id": 17,
    "text": "更是通过这一线索，全景式暴露了阮大铖、",
    "start": 60.291,
    "end": 63.962,
    "duration": 3.671
  },
  {
    "id": 18,
    "text": "马士英等阉党余孽的专权营私，",
    "start": 63.962,
    "end": 66.325,
    "duration": 2.363
  },
  {
    "id": 19,
    "text": "以及史可法独木难支的悲壮殉国。",
    "start": 66.325,
    "end": 69.118,
    "duration": 2.793
  },
  {
    "id": 20,
    "text": "南明的覆亡摧毁了侯李二人的爱情归宿，",
    "start": 69.118,
    "end": 72.934,
    "duration": 3.816
  },
  {
    "id": 21,
    "text": "而二人的离合聚散亦成为南明政局动荡的晴雨表，",
    "start": 72.934,
    "end": 77.08,
    "duration": 4.146
  },
  {
    "id": 22,
    "text": "深刻揭示了国家兴亡对个体命运的绝对主宰。",
    "start": 77.08,
    "end": 81.26,
    "duration": 4.18
  },
  {
    "id": 23,
    "text": "第二，以“桃花扇”为全剧聚散离合的核心戏剧道具与象征纽带。",
    "start": 81.26,
    "end": 86.214,
    "duration": 4.954
  },
  {
    "id": 24,
    "text": "全剧在结构营构上展现出高度谨严的艺术匠心。",
    "start": 86.214,
    "end": 91.643,
    "duration": 5.429
  },
  {
    "id": 25,
    "text": "孔尚任匠心独运地以一柄 “桃花扇” 贯穿全剧四十出：",
    "start": 91.643,
    "end": 95.632,
    "duration": 3.989
  },
  {
    "id": 26,
    "text": "从定情时的题诗赠扇、权奸逼嫁时的血溅诗扇、",
    "start": 95.632,
    "end": 101.076,
    "duration": 5.444
  },
  {
    "id": 27,
    "text": "友人杨龙友点血染画成桃花扇，到入道时的撕碎道袍拂尘剖扇。",
    "start": 101.076,
    "end": 106.511,
    "duration": 5.435
  },
  {
    "id": 28,
    "text": "这柄扇子既是侯李爱情的信物，又是香君坚贞不屈气节的象征，",
    "start": 106.511,
    "end": 111.549,
    "duration": 5.038
  },
  {
    "id": 29,
    "text": "更是南明王朝由盛转衰、直至覆亡的历史见证。",
    "start": 111.549,
    "end": 116.133,
    "duration": 4.584
  },
  {
    "id": 30,
    "text": "全剧以扇生情，以扇见史，线索集中、针线细密，",
    "start": 116.133,
    "end": 119.424,
    "duration": 3.291
  },
  {
    "id": 31,
    "text": "达到了戏曲结构谨严化境。",
    "start": 119.424,
    "end": 122.463,
    "duration": 3.039
  },
  {
    "id": 32,
    "text": "第三，打破大团圆俗套，",
    "start": 122.463,
    "end": 124.1,
    "duration": 1.637
  },
  {
    "id": 33,
    "text": "以出家入道与家国幻灭铸就崇高的历史悲剧意蕴。",
    "start": 124.1,
    "end": 128.562,
    "duration": 4.462
  },
  {
    "id": 34,
    "text": "剧作的高超之处，",
    "start": 128.562,
    "end": 129.834,
    "duration": 1.272
  },
  {
    "id": 35,
    "text": "在于彻底突破了中国传统古典戏曲 “金榜题名、",
    "start": 129.834,
    "end": 134.526,
    "duration": 4.692
  },
  {
    "id": 36,
    "text": "破镜重圆” 的虚饰套路。",
    "start": 134.526,
    "end": 136.162,
    "duration": 1.636
  },
  {
    "id": 37,
    "text": "在终局白兆山栖霞道院中，",
    "start": 136.162,
    "end": 138.162,
    "duration": 2.0
  },
  {
    "id": 38,
    "text": "正当侯方域与李香君历经磨难即将重聚之际，张道士一声断喝：",
    "start": 138.162,
    "end": 143.456,
    "duration": 5.294
  },
  {
    "id": 39,
    "text": "“两个痴虫，你看国在哪里？",
    "start": 143.456,
    "end": 145.492,
    "duration": 2.036
  },
  {
    "id": 40,
    "text": "家在哪里？",
    "start": 145.492,
    "end": 146.415,
    "duration": 0.923
  },
  {
    "id": 41,
    "text": "君在哪里？",
    "start": 146.415,
    "end": 147.448,
    "duration": 1.033
  },
  {
    "id": 42,
    "text": "父在哪里？",
    "start": 147.448,
    "end": 148.945,
    "duration": 1.497
  },
  {
    "id": 43,
    "text": "” 犹如当头棒喝，惊醒了二人的世俗私情。",
    "start": 148.945,
    "end": 153.158,
    "duration": 4.213
  },
  {
    "id": 44,
    "text": "二人当下撕裂桃花扇、出家入道。",
    "start": 153.158,
    "end": 155.893,
    "duration": 2.735
  },
  {
    "id": 45,
    "text": "这一决绝结局彻底粉碎了私情执念，",
    "start": 155.893,
    "end": 160.048,
    "duration": 4.155
  },
  {
    "id": 46,
    "text": "将全剧由世俗情爱升华到对沧桑历史与家国沦丧的终极反思，",
    "start": 160.048,
    "end": 164.775,
    "duration": 4.727
  },
  {
    "id": 47,
    "text": "形成了深沉悲凉的史诗品格。",
    "start": 164.775,
    "end": 166.848,
    "duration": 2.073
  }
]