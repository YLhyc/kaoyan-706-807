[
  {
    "id": 1,
    "text": "简述李清照词作艺术风格的演进历程及其“词别是一家”的理论主张与贡献。",
    "start": 0.098,
    "end": 5.977,
    "duration": 5.879
  },
  {
    "id": 2,
    "text": "李清照是两宋之交成就卓绝的婉约词派代表词人，",
    "start": 6.141,
    "end": 10.081,
    "duration": 3.94
  },
  {
    "id": 3,
    "text": "被誉为 “词家一大宗”。",
    "start": 10.286,
    "end": 11.783,
    "duration": 1.497
  },
  {
    "id": 4,
    "text": "她不仅在创作上开创了独树一帜的 “易安体”，",
    "start": 11.955,
    "end": 15.016,
    "duration": 3.061
  },
  {
    "id": 5,
    "text": "更在词论上建立了具有独立文体自觉的理论体系。",
    "start": 15.153,
    "end": 18.743,
    "duration": 3.59
  },
  {
    "id": 6,
    "text": "李清照词作风格的演进历程及其理论贡献，",
    "start": 18.978,
    "end": 22.272,
    "duration": 3.294
  },
  {
    "id": 7,
    "text": "主要展现为以下三个核心维度：",
    "start": 22.616,
    "end": 24.733,
    "duration": 2.117
  },
  {
    "id": 8,
    "text": "第一，在《词论》中提出“词别是一家”的主张，",
    "start": 25.154,
    "end": 28.749,
    "duration": 3.595
  },
  {
    "id": 9,
    "text": "确立词体独立的文体边界与声律典范。",
    "start": 29.222,
    "end": 32.283,
    "duration": 3.061
  },
  {
    "id": 10,
    "text": "李清照在著名理论专论 《词论》 中，",
    "start": 32.811,
    "end": 35.196,
    "duration": 2.385
  },
  {
    "id": 11,
    "text": "系统梳理了词的发展史，",
    "start": 35.368,
    "end": 37.501,
    "duration": 2.133
  },
  {
    "id": 12,
    "text": "明确提出 “词别是一家” 的纲领性论断。",
    "start": 37.562,
    "end": 40.569,
    "duration": 3.007
  },
  {
    "id": 13,
    "text": "她强调词作为一种独立的新文体，",
    "start": 40.733,
    "end": 43.376,
    "duration": 2.643
  },
  {
    "id": 14,
    "text": "必须严格恪守其自身独特的艺术规范：",
    "start": 43.679,
    "end": 46.816,
    "duration": 3.137
  },
  {
    "id": 15,
    "text": "一是高度重视协律与音乐美，讲求五音六律与清浊轻重，",
    "start": 47.179,
    "end": 52.551,
    "duration": 5.372
  },
  {
    "id": 16,
    "text": "批评苏轼、欧阳修等人虽博学高妙，却 “往往不协音律”，",
    "start": 53.017,
    "end": 57.791,
    "duration": 4.774
  },
  {
    "id": 17,
    "text": "直指其为 “句读不葺之诗”；二是主张 “尚雅”，",
    "start": 58.119,
    "end": 62.002,
    "duration": 3.883
  },
  {
    "id": 18,
    "text": "批评柳永词调虽合音律却 “词语尘下”，缺乏典雅品格；",
    "start": 62.326,
    "end": 67.078,
    "duration": 4.752
  },
  {
    "id": 19,
    "text": "三是提倡用典精审与感情真挚。",
    "start": 67.251,
    "end": 70.056,
    "duration": 2.805
  },
  {
    "id": 20,
    "text": "这一主张有力维护了词体的本体独立性，",
    "start": 70.489,
    "end": 73.513,
    "duration": 3.024
  },
  {
    "id": 21,
    "text": "确立了词体纯正的音乐与文体格范。",
    "start": 73.798,
    "end": 76.649,
    "duration": 2.851
  },
  {
    "id": 22,
    "text": "第二，以南渡为界展现由前期清新明丽向后期凄凉沉痛的历史演进。",
    "start": 76.834,
    "end": 82.811,
    "duration": 5.977
  },
  {
    "id": 23,
    "text": "靖康之变的国破家亡与流离失所，",
    "start": 83.192,
    "end": 85.946,
    "duration": 2.754
  },
  {
    "id": 24,
    "text": "使李清照的词作风格发生了深刻裂变。",
    "start": 86.188,
    "end": 88.992,
    "duration": 2.804
  },
  {
    "id": 25,
    "text": "前期生活优渥圆满，词作多描写少女闺中情趣与相思离愁，",
    "start": 89.215,
    "end": 94.266,
    "duration": 5.051
  },
  {
    "id": 26,
    "text": "如 《如梦令》 中的 “常记溪亭日暮，沉醉不知归路”，",
    "start": 94.41,
    "end": 98.248,
    "duration": 3.838
  },
  {
    "id": 27,
    "text": "洋溢着青春欢愉与对自然人生的热爱；南渡以后，",
    "start": 98.386,
    "end": 102.208,
    "duration": 3.822
  },
  {
    "id": 28,
    "text": "面对金兵侵凌、国土沦丧、",
    "start": 102.386,
    "end": 104.494,
    "duration": 2.108
  },
  {
    "id": 29,
    "text": "丈夫赵明诚病故与半生金石文物丧失的沉重打击，",
    "start": 104.581,
    "end": 108.456,
    "duration": 3.875
  },
  {
    "id": 30,
    "text": "词作转入对漂泊身世与家国沦亡的悲叹，",
    "start": 108.623,
    "end": 111.825,
    "duration": 3.202
  },
  {
    "id": 31,
    "text": "如 《声声慢》 中开篇连用十四个叠字 “寻寻觅觅，",
    "start": 112.008,
    "end": 115.372,
    "duration": 3.364
  },
  {
    "id": 32,
    "text": "冷冷清清，凄凄惨惨戚戚”，极写晚年孤苦无依的凄凉绝境，",
    "start": 115.592,
    "end": 120.47,
    "duration": 4.878
  },
  {
    "id": 33,
    "text": "将个人流离与国家动荡紧密交融，词风深沉凄苦、格调苍凉。",
    "start": 120.683,
    "end": 125.74,
    "duration": 5.057
  },
  {
    "id": 34,
    "text": "第三，擅用家常口语入词与精工炼字，",
    "start": 125.921,
    "end": 129.169,
    "duration": 3.248
  },
  {
    "id": 35,
    "text": "形成自然纯朴的“易安体”语言风范。",
    "start": 129.498,
    "end": 132.202,
    "duration": 2.704
  },
  {
    "id": 36,
    "text": "在语言表现上，李清照开创了自然天成的语言风格。",
    "start": 132.492,
    "end": 136.279,
    "duration": 3.787
  },
  {
    "id": 37,
    "text": "她善于化寻常口语为精妙词句，如 “生怕闲愁暗恨，多少事、",
    "start": 136.405,
    "end": 141.208,
    "duration": 4.803
  },
  {
    "id": 38,
    "text": "欲说还休”，大白若浅却深挚感人；同时精于炼字造境，",
    "start": 141.208,
    "end": 145.588,
    "duration": 4.38
  },
  {
    "id": 39,
    "text": "如 《如梦令》 中以 “绿肥红瘦” 描写暮春雨后景象，",
    "start": 145.801,
    "end": 149.47,
    "duration": 3.669
  },
  {
    "id": 40,
    "text": "清新脱俗，展现出极高超的语言表现力。",
    "start": 149.592,
    "end": 152.832,
    "duration": 3.24
  }
]
