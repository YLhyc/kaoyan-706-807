[
  {
    "id": 1,
    "text": "简述李清照词作艺术风格的演进历程及其“词别是一家”的理论主张与贡献。",
    "start": 0.05,
    "end": 6.151,
    "duration": 6.101
  },
  {
    "id": 2,
    "text": "李清照是两宋之交成就卓绝的婉约词派代表词人，",
    "start": 6.151,
    "end": 10.296,
    "duration": 4.145
  },
  {
    "id": 3,
    "text": "被誉为 “词家一大宗”。",
    "start": 10.296,
    "end": 11.965,
    "duration": 1.669
  },
  {
    "id": 4,
    "text": "她不仅在创作上开创了独树一帜的 “易安体”，",
    "start": 11.965,
    "end": 16.717,
    "duration": 4.752
  },
  {
    "id": 5,
    "text": "更在词论上建立了具有独立文体自觉的理论体系。",
    "start": 16.717,
    "end": 22.628,
    "duration": 5.911
  },
  {
    "id": 6,
    "text": "李清照词作风格的演进历程及其理论贡献，",
    "start": 22.628,
    "end": 25.9,
    "duration": 3.272
  },
  {
    "id": 7,
    "text": "主要展现为以下三个核心维度：",
    "start": 25.9,
    "end": 29.232,
    "duration": 3.332
  },
  {
    "id": 8,
    "text": "第一，在《词论》中提出“词别是一家”的主张，",
    "start": 29.232,
    "end": 32.822,
    "duration": 3.59
  },
  {
    "id": 9,
    "text": "确立词体独立的文体边界与声律典范。",
    "start": 32.822,
    "end": 35.731,
    "duration": 2.909
  },
  {
    "id": 10,
    "text": "李清照在著名理论专论 《词论》 中，",
    "start": 35.731,
    "end": 38.417,
    "duration": 2.686
  },
  {
    "id": 11,
    "text": "系统梳理了词的发展史，",
    "start": 38.417,
    "end": 40.743,
    "duration": 2.326
  },
  {
    "id": 12,
    "text": "明确提出 “词别是一家” 的纲领性论断。",
    "start": 40.743,
    "end": 43.689,
    "duration": 2.946
  },
  {
    "id": 13,
    "text": "她强调词作为一种独立的新文体，",
    "start": 43.689,
    "end": 47.189,
    "duration": 3.5
  },
  {
    "id": 14,
    "text": "必须严格恪守其自身独特的艺术规范：",
    "start": 47.189,
    "end": 50.098,
    "duration": 2.909
  },
  {
    "id": 15,
    "text": "一是高度重视协律与音乐美，讲求五音六律与清浊轻重，",
    "start": 50.098,
    "end": 54.28,
    "duration": 4.182
  },
  {
    "id": 16,
    "text": "批评苏轼、欧阳修等人虽博学高妙，却 “往往不协音律”，",
    "start": 54.28,
    "end": 58.129,
    "duration": 3.849
  },
  {
    "id": 17,
    "text": "直指其为 “句读不葺之诗”；二是主张 “尚雅”，",
    "start": 58.129,
    "end": 62.336,
    "duration": 4.207
  },
  {
    "id": 18,
    "text": "批评柳永词调虽合音律却 “词语尘下”，缺乏典雅品格；",
    "start": 62.336,
    "end": 67.276,
    "duration": 4.94
  },
  {
    "id": 19,
    "text": "三是提倡用典精审与感情真挚。",
    "start": 67.276,
    "end": 70.499,
    "duration": 3.223
  },
  {
    "id": 20,
    "text": "这一主张有力维护了词体的本体独立性，",
    "start": 70.499,
    "end": 73.811,
    "duration": 3.312
  },
  {
    "id": 21,
    "text": "确立了词体纯正的音乐与文体格范。",
    "start": 73.811,
    "end": 76.844,
    "duration": 3.033
  },
  {
    "id": 22,
    "text": "第二，以南渡为界展现由前期清新明丽向后期凄凉沉痛的历史演进。",
    "start": 76.844,
    "end": 83.208,
    "duration": 6.364
  },
  {
    "id": 23,
    "text": "靖康之变的国破家亡与流离失所，",
    "start": 83.208,
    "end": 86.2,
    "duration": 2.992
  },
  {
    "id": 24,
    "text": "使李清照的词作风格发生了深刻裂变。",
    "start": 86.2,
    "end": 89.228,
    "duration": 3.028
  },
  {
    "id": 25,
    "text": "前期生活优渥圆满，词作多描写少女闺中情趣与相思离愁，",
    "start": 89.228,
    "end": 94.424,
    "duration": 5.196
  },
  {
    "id": 26,
    "text": "如 《如梦令》 中的 “常记溪亭日暮，沉醉不知归路”，",
    "start": 94.424,
    "end": 98.396,
    "duration": 3.972
  },
  {
    "id": 27,
    "text": "洋溢着青春欢愉与对自然人生的热爱；南渡以后，",
    "start": 98.396,
    "end": 102.397,
    "duration": 4.001
  },
  {
    "id": 28,
    "text": "面对金兵侵凌、国土沦丧、",
    "start": 102.397,
    "end": 104.591,
    "duration": 2.194
  },
  {
    "id": 29,
    "text": "丈夫赵明诚病故与半生金石文物丧失的沉重打击，",
    "start": 104.591,
    "end": 108.633,
    "duration": 4.042
  },
  {
    "id": 30,
    "text": "词作转入对漂泊身世与家国沦亡的悲叹，",
    "start": 108.633,
    "end": 112.018,
    "duration": 3.385
  },
  {
    "id": 31,
    "text": "如 《声声慢》 中开篇连用十四个叠字 “寻寻觅觅，",
    "start": 112.018,
    "end": 115.607,
    "duration": 3.589
  },
  {
    "id": 32,
    "text": "冷冷清清，凄凄惨惨戚戚”，极写晚年孤苦无依的凄凉绝境，",
    "start": 115.607,
    "end": 120.698,
    "duration": 5.091
  },
  {
    "id": 33,
    "text": "将个人流离与国家动荡紧密交融，词风深沉凄苦、格调苍凉。",
    "start": 120.698,
    "end": 125.931,
    "duration": 5.233
  },
  {
    "id": 34,
    "text": "第三，擅用家常口语入词与精工炼字，",
    "start": 125.931,
    "end": 129.513,
    "duration": 3.582
  },
  {
    "id": 35,
    "text": "形成自然纯朴的“易安体”语言风范。",
    "start": 129.513,
    "end": 132.502,
    "duration": 2.989
  },
  {
    "id": 36,
    "text": "在语言表现上，李清照开创了自然天成的语言风格。",
    "start": 132.502,
    "end": 136.415,
    "duration": 3.913
  },
  {
    "id": 37,
    "text": "她善于化寻常口语为精妙词句，如 “生怕闲愁暗恨，多少事、",
    "start": 136.415,
    "end": 142.232,
    "duration": 5.817
  },
  {
    "id": 38,
    "text": "欲说还休”，大白若浅却深挚感人；同时精于炼字造境，",
    "start": 142.232,
    "end": 146.05,
    "duration": 3.818
  },
  {
    "id": 39,
    "text": "如 《如梦令》 中以 “绿肥红瘦” 描写暮春雨后景象，",
    "start": 146.05,
    "end": 149.605,
    "duration": 3.555
  },
  {
    "id": 40,
    "text": "清新脱俗，展现出极高超的语言表现力。",
    "start": 149.605,
    "end": 152.832,
    "duration": 3.227
  }
]