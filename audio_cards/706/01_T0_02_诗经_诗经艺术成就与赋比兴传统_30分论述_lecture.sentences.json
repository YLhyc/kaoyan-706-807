[
  {
    "id": 1,
    "text": "试论《诗经》的艺术成就与赋比兴表现手法。",
    "start": 0.08,
    "end": 3.575,
    "duration": 3.495
  },
  {
    "id": 2,
    "text": "《诗经》 是中国古代第一部诗歌总集，",
    "start": 3.99,
    "end": 6.697,
    "duration": 2.707
  },
  {
    "id": 3,
    "text": "也是中国现实主义诗歌传统的至高源头。",
    "start": 6.975,
    "end": 9.851,
    "duration": 2.876
  },
  {
    "id": 4,
    "text": "它全面反映了西周初年至春秋中叶五百余年间广阔的社会历史生活，",
    "start": 10.196,
    "end": 15.715,
    "duration": 5.519
  },
  {
    "id": 5,
    "text": "打破了上古巫术颂歌的神秘垄断，",
    "start": 16.065,
    "end": 18.626,
    "duration": 2.561
  },
  {
    "id": 6,
    "text": "将诗歌的目光聚焦于现实人间。",
    "start": 18.961,
    "end": 21.458,
    "duration": 2.497
  },
  {
    "id": 7,
    "text": "《汉书·艺文志》 赞其 “哀乐和，节文相生”。",
    "start": 21.694,
    "end": 25.676,
    "duration": 3.982
  },
  {
    "id": 8,
    "text": "《诗经》 在长期的民间歌咏与史官编纂中，",
    "start": 25.824,
    "end": 28.951,
    "duration": 3.127
  },
  {
    "id": 9,
    "text": "提炼出成熟的诗歌艺术范式，",
    "start": 29.213,
    "end": 31.271,
    "duration": 2.058
  },
  {
    "id": 10,
    "text": "奠定了中华民族诗歌的审美心理结构。",
    "start": 31.486,
    "end": 34.098,
    "duration": 2.612
  },
  {
    "id": 11,
    "text": "其艺术成就主要展现为以下四个核心维度：",
    "start": 34.286,
    "end": 37.407,
    "duration": 3.121
  },
  {
    "id": 12,
    "text": "第一，系统确立“赋、比、兴”表现手法体系，",
    "start": 37.737,
    "end": 41.072,
    "duration": 3.335
  },
  {
    "id": 13,
    "text": "奠定古典诗歌的情物交融传统。",
    "start": 41.312,
    "end": 43.805,
    "duration": 2.493
  },
  {
    "id": 14,
    "text": "《诗经》 最具创造性的艺术贡献，在于建立了以 “赋”、",
    "start": 44.01,
    "end": 48.144,
    "duration": 4.134
  },
  {
    "id": 15,
    "text": "“比”、“兴” 为核心的表现技法体系。",
    "start": 48.396,
    "end": 50.944,
    "duration": 2.548
  },
  {
    "id": 16,
    "text": "“赋者，敷陈其事而直言之也”，",
    "start": 51.149,
    "end": 54.116,
    "duration": 2.967
  },
  {
    "id": 17,
    "text": "如 《豳风·七月》 按照岁时农事顺序，",
    "start": 54.358,
    "end": 57.232,
    "duration": 2.874
  },
  {
    "id": 18,
    "text": "详尽铺叙农夫一年四季耕织劳作的艰辛，笔触客观细腻；",
    "start": 57.401,
    "end": 62.907,
    "duration": 5.506
  },
  {
    "id": 19,
    "text": "“比者，以彼物比此物也”，",
    "start": 63.138,
    "end": 65.447,
    "duration": 2.309
  },
  {
    "id": 20,
    "text": "如 《魏风·硕鼠》 将残酷不仁的奴隶领主直接比作贪婪害人的大老鼠，",
    "start": 65.726,
    "end": 72.372,
    "duration": 6.646
  },
  {
    "id": 21,
    "text": "形象鲜明、讽刺辛辣；“兴者，先言他物以引起所咏之词也”，",
    "start": 72.499,
    "end": 77.389,
    "duration": 4.89
  },
  {
    "id": 22,
    "text": "如 《周南·关雎》 开篇以 “关关雎鸠，",
    "start": 77.82,
    "end": 80.385,
    "duration": 2.565
  },
  {
    "id": 23,
    "text": "在河之洲” 起兴，借水鸟和鸣起兴引出 “窈窕淑女，",
    "start": 80.385,
    "end": 85.662,
    "duration": 5.277
  },
  {
    "id": 24,
    "text": "君子好逑” 的相思恋情。",
    "start": 85.865,
    "end": 87.786,
    "duration": 1.921
  },
  {
    "id": 25,
    "text": "赋比兴手法的综合运用，使客观物象与主观情感深度交融，",
    "start": 88.009,
    "end": 93.276,
    "duration": 5.267
  },
  {
    "id": 26,
    "text": "开创了后世托物言志的博大传统。",
    "start": 93.692,
    "end": 96.431,
    "duration": 2.739
  },
  {
    "id": 27,
    "text": "第二，确立重章叠句与回环复沓的篇章结构，",
    "start": 96.819,
    "end": 100.829,
    "duration": 4.01
  },
  {
    "id": 28,
    "text": "展现优美的音乐复奏美感。",
    "start": 101.271,
    "end": 103.09,
    "duration": 1.819
  },
  {
    "id": 29,
    "text": "《诗经》 的民歌部分广泛采用重章叠句的结构方式。",
    "start": 103.338,
    "end": 107.081,
    "duration": 3.743
  },
  {
    "id": 30,
    "text": "作品在几个章节之间，字句结构基本相同，",
    "start": 107.561,
    "end": 110.875,
    "duration": 3.314
  },
  {
    "id": 31,
    "text": "仅在关键位置更换少数几个同义或反义词语，",
    "start": 111.16,
    "end": 114.871,
    "duration": 3.711
  },
  {
    "id": 32,
    "text": "在反复吟唱中推进情感。",
    "start": 115.196,
    "end": 117.385,
    "duration": 2.189
  },
  {
    "id": 33,
    "text": "以国风名篇 《秦风·蒹葭》 为例，全诗三章叠唱，",
    "start": 117.625,
    "end": 121.623,
    "duration": 3.998
  },
  {
    "id": 34,
    "text": "由 “白露为霜” 演进到 “未晞”、“未已”，",
    "start": 121.762,
    "end": 124.971,
    "duration": 3.209
  },
  {
    "id": 35,
    "text": "由 “宛在水中央” 转换为 “水中坻”、“水中沚”；",
    "start": 125.179,
    "end": 129.513,
    "duration": 4.334
  },
  {
    "id": 36,
    "text": "随着秋意逐渐深浓与追寻空间的层层变换，",
    "start": 129.58,
    "end": 133.083,
    "duration": 3.503
  },
  {
    "id": 37,
    "text": "反复抒发了对伊人可望而不可即的渺远惆怅。",
    "start": 133.176,
    "end": 137.244,
    "duration": 4.068
  },
  {
    "id": 38,
    "text": "这种回环复沓的结构，不仅极大地强化了诗歌的音乐节律，",
    "start": 137.451,
    "end": 141.613,
    "duration": 4.162
  },
  {
    "id": 39,
    "text": "更营造出反复低回、情韵绵长的抒情氛围。",
    "start": 141.79,
    "end": 145.453,
    "duration": 3.663
  },
  {
    "id": 40,
    "text": "第三，开创直面现实与关怀民生苦难的写实品格，",
    "start": 145.755,
    "end": 150.427,
    "duration": 4.672
  },
  {
    "id": 41,
    "text": "铸就“风雅”诗教精神。",
    "start": 150.507,
    "end": 152.201,
    "duration": 1.694
  },
  {
    "id": 42,
    "text": "《诗经》 牢牢扎根于世俗人间的真实土壤，",
    "start": 152.59,
    "end": 155.561,
    "duration": 2.971
  },
  {
    "id": 43,
    "text": "全面展现了宗周社会的生动图景。",
    "start": 155.588,
    "end": 158.075,
    "duration": 2.487
  },
  {
    "id": 44,
    "text": "尤其是 “国风” 与 “小雅” 中的怨刺诗与社会讽谕诗，",
    "start": 158.209,
    "end": 162.489,
    "duration": 4.28
  },
  {
    "id": 45,
    "text": "以卓越的批判勇气直面社会矛盾。",
    "start": 162.513,
    "end": 165.415,
    "duration": 2.902
  },
  {
    "id": 46,
    "text": "《魏风·伐檀》 面对统治者的不劳而获，发出 “不稼不穑，",
    "start": 165.674,
    "end": 170.537,
    "duration": 4.863
  },
  {
    "id": 47,
    "text": "胡取禾三百廛兮” 的严正抗议；",
    "start": 170.84,
    "end": 173.128,
    "duration": 2.288
  },
  {
    "id": 48,
    "text": "《豳风·东山》 以细腻平实的细节描写征夫还乡，",
    "start": 173.64,
    "end": 177.253,
    "duration": 3.613
  },
  {
    "id": 49,
    "text": "“零雨其濛” 中满怀对故园荒芜的酸楚；",
    "start": 177.757,
    "end": 180.93,
    "duration": 3.173
  },
  {
    "id": 50,
    "text": "《小雅·采薇》 中 “昔我往矣，杨柳依依；今我来思，",
    "start": 181.417,
    "end": 186.162,
    "duration": 4.745
  },
  {
    "id": 51,
    "text": "雨雪霏霏”，以乐景写哀，",
    "start": 186.238,
    "end": 188.373,
    "duration": 2.135
  },
  {
    "id": 52,
    "text": "将战火中士兵的悲凉心灵刻画得入木三分。",
    "start": 188.533,
    "end": 192.13,
    "duration": 3.597
  },
  {
    "id": 53,
    "text": "这种关注生民疾苦、干预现实的批判精神，",
    "start": 192.322,
    "end": 195.603,
    "duration": 3.281
  },
  {
    "id": 54,
    "text": "直接构成了儒家“美刺”诗教的优良传统。",
    "start": 195.854,
    "end": 199.085,
    "duration": 3.231
  },
  {
    "id": 55,
    "text": "第四，形成以四言为主兼备参差变化的语言体式，",
    "start": 199.319,
    "end": 203.563,
    "duration": 4.244
  },
  {
    "id": 56,
    "text": "奠定汉语诗歌的音律节奏。",
    "start": 203.795,
    "end": 205.76,
    "duration": 1.965
  },
  {
    "id": 57,
    "text": "在语言体制上，《诗经》 确立了以四言为主的基本诗体，",
    "start": 205.998,
    "end": 210.036,
    "duration": 4.038
  },
  {
    "id": 58,
    "text": "形成了二二节拍的整齐节奏。",
    "start": 210.271,
    "end": 212.169,
    "duration": 1.898
  },
  {
    "id": 59,
    "text": "同时，诗中大量吸纳两字、三字直至八字的长短句，",
    "start": 212.584,
    "end": 216.928,
    "duration": 4.344
  },
  {
    "id": 60,
    "text": "打破单调僵化；《诗经》 极善运用叠字与拟声词，",
    "start": 217.24,
    "end": 221.145,
    "duration": 3.905
  },
  {
    "id": 61,
    "text": "如 《小雅·伐木》 之 “伐木丁丁，鸟鸣嘤嘤”，",
    "start": 221.516,
    "end": 224.828,
    "duration": 3.312
  },
  {
    "id": 62,
    "text": "《郑风·子衿》 之 “青青子衿，悠悠我心”，形象逼真、",
    "start": 225.144,
    "end": 229.302,
    "duration": 4.158
  },
  {
    "id": 63,
    "text": "声律和谐；全诗广泛运用双声叠韵与自然押韵，句式灵活舒展，",
    "start": 229.302,
    "end": 234.849,
    "duration": 5.547
  },
  {
    "id": 64,
    "text": "为汉魏以后五七言诗歌体裁的发展提供了丰厚的音律给养。",
    "start": 235.203,
    "end": 240.432,
    "duration": 5.229
  }
]
