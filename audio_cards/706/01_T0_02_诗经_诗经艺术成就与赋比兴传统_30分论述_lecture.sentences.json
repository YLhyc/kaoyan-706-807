[
  {
    "id": 1,
    "text": "试论《诗经》的艺术成就与赋比兴表现手法。",
    "start": 0.0,
    "end": 4.03,
    "duration": 4.03
  },
  {
    "id": 2,
    "text": "《诗经》 是中国古代第一部诗歌总集，",
    "start": 4.03,
    "end": 7.016,
    "duration": 2.986
  },
  {
    "id": 3,
    "text": "也是中国现实主义诗歌传统的至高源头。",
    "start": 7.016,
    "end": 10.236,
    "duration": 3.22
  },
  {
    "id": 4,
    "text": "它全面反映了西周初年至春秋中叶五百余年间广阔的社会历史生活，",
    "start": 10.236,
    "end": 16.105,
    "duration": 5.869
  },
  {
    "id": 5,
    "text": "打破了上古巫术颂歌的神秘垄断，",
    "start": 16.105,
    "end": 19.002,
    "duration": 2.897
  },
  {
    "id": 6,
    "text": "将诗歌的目光聚焦于现实人间。",
    "start": 19.002,
    "end": 21.736,
    "duration": 2.734
  },
  {
    "id": 7,
    "text": "《汉书·艺文志》 赞其 “哀乐和，节文相生”。",
    "start": 21.736,
    "end": 25.866,
    "duration": 4.13
  },
  {
    "id": 8,
    "text": "《诗经》 在长期的民间歌咏与史官编纂中，",
    "start": 25.866,
    "end": 29.253,
    "duration": 3.387
  },
  {
    "id": 9,
    "text": "提炼出成熟的诗歌艺术范式，",
    "start": 29.253,
    "end": 31.526,
    "duration": 2.273
  },
  {
    "id": 10,
    "text": "奠定了中华民族诗歌的审美心理结构。",
    "start": 31.526,
    "end": 34.327,
    "duration": 2.801
  },
  {
    "id": 11,
    "text": "其艺术成就主要展现为以下四个核心维度：",
    "start": 34.327,
    "end": 38.344,
    "duration": 4.017
  },
  {
    "id": 12,
    "text": "第一，系统确立“赋、比、兴”表现手法体系，",
    "start": 38.344,
    "end": 44.054,
    "duration": 5.71
  },
  {
    "id": 13,
    "text": "奠定古典诗歌的情物交融传统。",
    "start": 44.054,
    "end": 46.825,
    "duration": 2.771
  },
  {
    "id": 14,
    "text": "《诗经》 最具创造性的艺术贡献，在于建立了以 “赋”、",
    "start": 46.825,
    "end": 53.271,
    "duration": 6.446
  },
  {
    "id": 15,
    "text": "“比”、“兴” 为核心的表现技法体系。",
    "start": 53.271,
    "end": 57.6,
    "duration": 4.329
  },
  {
    "id": 16,
    "text": "“赋者，敷陈其事而直言之也”，",
    "start": 57.6,
    "end": 61.689,
    "duration": 4.089
  },
  {
    "id": 17,
    "text": "如 《豳风·七月》 按照岁时农事顺序，",
    "start": 61.689,
    "end": 65.771,
    "duration": 4.082
  },
  {
    "id": 18,
    "text": "详尽铺叙农夫一年四季耕织劳作的艰辛，笔触客观细腻；",
    "start": 65.771,
    "end": 71.511,
    "duration": 5.74
  },
  {
    "id": 19,
    "text": "“比者，以彼物比此物也”，",
    "start": 71.511,
    "end": 74.896,
    "duration": 3.385
  },
  {
    "id": 20,
    "text": "如 《魏风·硕鼠》 将残酷不仁的奴隶领主直接比作贪婪害人的大老鼠，",
    "start": 74.896,
    "end": 83.468,
    "duration": 8.572
  },
  {
    "id": 21,
    "text": "形象鲜明、讽刺辛辣；“兴者，先言他物以引起所咏之词也”，",
    "start": 83.468,
    "end": 91.425,
    "duration": 7.957
  },
  {
    "id": 22,
    "text": "如 《周南·关雎》 开篇以 “关关雎鸠，",
    "start": 91.425,
    "end": 94.776,
    "duration": 3.351
  },
  {
    "id": 23,
    "text": "在河之洲” 起兴，借水鸟和鸣起兴引出 “窈窕淑女，",
    "start": 94.776,
    "end": 101.311,
    "duration": 6.535
  },
  {
    "id": 24,
    "text": "君子好逑” 的相思恋情。",
    "start": 101.311,
    "end": 103.378,
    "duration": 2.067
  },
  {
    "id": 25,
    "text": "赋比兴手法的综合运用，使客观物象与主观情感深度交融，",
    "start": 103.378,
    "end": 109.369,
    "duration": 5.991
  },
  {
    "id": 26,
    "text": "开创了后世托物言志的博大传统。",
    "start": 109.369,
    "end": 112.44,
    "duration": 3.071
  },
  {
    "id": 27,
    "text": "第二，确立重章叠句与回环复沓的篇章结构，",
    "start": 112.44,
    "end": 117.666,
    "duration": 5.226
  },
  {
    "id": 28,
    "text": "展现优美的音乐复奏美感。",
    "start": 117.666,
    "end": 120.423,
    "duration": 2.757
  },
  {
    "id": 29,
    "text": "《诗经》 的民歌部分广泛采用重章叠句的结构方式。",
    "start": 120.423,
    "end": 125.422,
    "duration": 4.999
  },
  {
    "id": 30,
    "text": "作品在几个章节之间，字句结构基本相同，",
    "start": 125.422,
    "end": 129.623,
    "duration": 4.201
  },
  {
    "id": 31,
    "text": "仅在关键位置更换少数几个同义或反义词语，",
    "start": 129.623,
    "end": 133.233,
    "duration": 3.61
  },
  {
    "id": 32,
    "text": "在反复吟唱中推进情感。",
    "start": 133.233,
    "end": 137.491,
    "duration": 4.258
  },
  {
    "id": 33,
    "text": "以国风名篇 《秦风·蒹葭》 为例，全诗三章叠唱，",
    "start": 137.491,
    "end": 141.866,
    "duration": 4.375
  },
  {
    "id": 34,
    "text": "由 “白露为霜” 演进到 “未晞”、“未已”，",
    "start": 141.866,
    "end": 143.932,
    "duration": 2.066
  },
  {
    "id": 35,
    "text": "由 “宛在水中央” 转换为 “水中坻”、“水中沚”；",
    "start": 143.932,
    "end": 146.606,
    "duration": 2.674
  },
  {
    "id": 36,
    "text": "随着秋意逐渐深浓与追寻空间的层层变换，",
    "start": 146.606,
    "end": 152.632,
    "duration": 6.026
  },
  {
    "id": 37,
    "text": "反复抒发了对伊人可望而不可即的渺远惆怅。",
    "start": 152.632,
    "end": 158.431,
    "duration": 5.799
  },
  {
    "id": 38,
    "text": "这种回环复沓的结构，不仅极大地强化了诗歌的音乐节律，",
    "start": 158.431,
    "end": 165.714,
    "duration": 7.283
  },
  {
    "id": 39,
    "text": "更营造出反复低回、情韵绵长的抒情氛围。",
    "start": 165.714,
    "end": 169.698,
    "duration": 3.984
  },
  {
    "id": 40,
    "text": "第三，开创直面现实与关怀民生苦难的写实品格，",
    "start": 169.698,
    "end": 174.794,
    "duration": 5.096
  },
  {
    "id": 41,
    "text": "铸就“风雅”诗教精神。",
    "start": 174.794,
    "end": 177.797,
    "duration": 3.003
  },
  {
    "id": 42,
    "text": "《诗经》 牢牢扎根于世俗人间的真实土壤，",
    "start": 177.797,
    "end": 181.46,
    "duration": 3.663
  },
  {
    "id": 43,
    "text": "全面展现了宗周社会的生动图景。",
    "start": 181.46,
    "end": 185.154,
    "duration": 3.694
  },
  {
    "id": 44,
    "text": "尤其是 “国风” 与 “小雅” 中的怨刺诗与社会讽谕诗，",
    "start": 185.154,
    "end": 188.574,
    "duration": 3.42
  },
  {
    "id": 45,
    "text": "以卓越的批判勇气直面社会矛盾。",
    "start": 188.574,
    "end": 190.847,
    "duration": 2.273
  },
  {
    "id": 46,
    "text": "《魏风·伐檀》 面对统治者的不劳而获，发出 “不稼不穑，",
    "start": 190.847,
    "end": 196.984,
    "duration": 6.137
  },
  {
    "id": 47,
    "text": "胡取禾三百廛兮” 的严正抗议；",
    "start": 196.984,
    "end": 199.979,
    "duration": 2.995
  },
  {
    "id": 48,
    "text": "《豳风·东山》 以细腻平实的细节描写征夫还乡，",
    "start": 199.979,
    "end": 203.835,
    "duration": 3.856
  },
  {
    "id": 49,
    "text": "“零雨其濛” 中满怀对故园荒芜的酸楚；",
    "start": 203.835,
    "end": 207.382,
    "duration": 3.547
  },
  {
    "id": 50,
    "text": "《小雅·采薇》 中 “昔我往矣，杨柳依依；今我来思，",
    "start": 207.382,
    "end": 210.315,
    "duration": 2.933
  },
  {
    "id": 51,
    "text": "雨雪霏霏”，以乐景写哀，",
    "start": 210.315,
    "end": 212.624,
    "duration": 2.309
  },
  {
    "id": 52,
    "text": "将战火中士兵的悲凉心灵刻画得入木三分。",
    "start": 212.624,
    "end": 215.473,
    "duration": 2.849
  },
  {
    "id": 53,
    "text": "这种关注生民疾苦、干预现实的批判精神，",
    "start": 215.473,
    "end": 217.28,
    "duration": 1.807
  },
  {
    "id": 54,
    "text": "直接构成了儒家“美刺”诗教的优良传统。",
    "start": 217.28,
    "end": 218.695,
    "duration": 1.415
  },
  {
    "id": 55,
    "text": "第四，形成以四言为主兼备参差变化的语言体式，",
    "start": 218.695,
    "end": 221.556,
    "duration": 2.861
  },
  {
    "id": 56,
    "text": "奠定汉语诗歌的音律节奏。",
    "start": 221.556,
    "end": 223.086,
    "duration": 1.53
  },
  {
    "id": 57,
    "text": "在语言体制上，《诗经》 确立了以四言为主的基本诗体，",
    "start": 223.086,
    "end": 225.184,
    "duration": 2.098
  },
  {
    "id": 58,
    "text": "形成了二二节拍的整齐节奏。",
    "start": 225.184,
    "end": 226.347,
    "duration": 1.163
  },
  {
    "id": 59,
    "text": "同时，诗中大量吸纳两字、三字直至八字的长短句，",
    "start": 226.347,
    "end": 228.502,
    "duration": 2.155
  },
  {
    "id": 60,
    "text": "打破单调僵化；《诗经》 极善运用叠字与拟声词，",
    "start": 228.502,
    "end": 230.425,
    "duration": 1.923
  },
  {
    "id": 61,
    "text": "如 《小雅·伐木》 之 “伐木丁丁，鸟鸣嘤嘤”，",
    "start": 230.425,
    "end": 233.682,
    "duration": 3.257
  },
  {
    "id": 62,
    "text": "《郑风·子衿》 之 “青青子衿，悠悠我心”，形象逼真、",
    "start": 233.682,
    "end": 235.243,
    "duration": 1.561
  },
  {
    "id": 63,
    "text": "声律和谐；全诗广泛运用双声叠韵与自然押韵，句式灵活舒展，",
    "start": 235.243,
    "end": 238.354,
    "duration": 3.111
  },
  {
    "id": 64,
    "text": "为汉魏以后五七言诗歌体裁的发展提供了丰厚的音律给养。",
    "start": 238.354,
    "end": 240.177,
    "duration": 1.823
  }
]