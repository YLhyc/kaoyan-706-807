[
  {
    "id": 1,
    "text": "试论《诗经》的艺术成就与赋比兴表现手法。",
    "start": 0.0,
    "end": 4.03,
    "duration": 4.03
  },
  {
    "id": 2,
    "text": "《诗经》 是中国古代第一部诗歌总集，",
    "start": 4.03,
    "end": 7.016,
    "duration": 2.986
  },
  {
    "id": 3,
    "text": "也是中国现实主义诗歌传统的至高源头。",
    "start": 7.016,
    "end": 10.236,
    "duration": 3.22
  },
  {
    "id": 4,
    "text": "它全面反映了西周初年至春秋中叶五百余年间广阔的社会历史生活，",
    "start": 10.236,
    "end": 16.105,
    "duration": 5.869
  },
  {
    "id": 5,
    "text": "打破了上古巫术颂歌的神秘垄断，",
    "start": 16.105,
    "end": 19.002,
    "duration": 2.897
  },
  {
    "id": 6,
    "text": "将诗歌的目光聚焦于现实人间。",
    "start": 19.002,
    "end": 23.729,
    "duration": 4.727
  },
  {
    "id": 7,
    "text": "《汉书·艺文志》 赞其 “哀乐和，节文相生”。",
    "start": 23.729,
    "end": 29.253,
    "duration": 5.524
  },
  {
    "id": 8,
    "text": "《诗经》 在长期的民间歌咏与史官编纂中，",
    "start": 29.253,
    "end": 31.526,
    "duration": 2.273
  },
  {
    "id": 9,
    "text": "提炼出成熟的诗歌艺术范式，",
    "start": 31.526,
    "end": 34.327,
    "duration": 2.801
  },
  {
    "id": 10,
    "text": "奠定了中华民族诗歌的审美心理结构。",
    "start": 34.327,
    "end": 37.777,
    "duration": 3.45
  },
  {
    "id": 11,
    "text": "其艺术成就主要展现为以下四个核心维度：",
    "start": 37.777,
    "end": 41.352,
    "duration": 3.575
  },
  {
    "id": 12,
    "text": "第一，系统确立“赋、比、兴”表现手法体系，",
    "start": 41.352,
    "end": 46.825,
    "duration": 5.473
  },
  {
    "id": 13,
    "text": "奠定古典诗歌的情物交融传统。",
    "start": 46.825,
    "end": 48.436,
    "duration": 1.611
  },
  {
    "id": 14,
    "text": "《诗经》 最具创造性的艺术贡献，在于建立了以 “赋”、",
    "start": 48.436,
    "end": 53.271,
    "duration": 4.835
  },
  {
    "id": 15,
    "text": "“比”、“兴” 为核心的表现技法体系。",
    "start": 53.271,
    "end": 57.6,
    "duration": 4.329
  },
  {
    "id": 16,
    "text": "“赋者，敷陈其事而直言之也”，",
    "start": 57.6,
    "end": 61.689,
    "duration": 4.089
  },
  {
    "id": 17,
    "text": "如 《豳风·七月》 按照岁时农事顺序，",
    "start": 61.689,
    "end": 63.879,
    "duration": 2.19
  },
  {
    "id": 18,
    "text": "详尽铺叙农夫一年四季耕织劳作的艰辛，笔触客观细腻；",
    "start": 63.879,
    "end": 71.511,
    "duration": 7.632
  },
  {
    "id": 19,
    "text": "“比者，以彼物比此物也”，",
    "start": 71.511,
    "end": 72.541,
    "duration": 1.03
  },
  {
    "id": 20,
    "text": "如 《魏风·硕鼠》 将残酷不仁的奴隶领主直接比作贪婪害人的大老鼠，",
    "start": 72.541,
    "end": 77.861,
    "duration": 5.32
  },
  {
    "id": 21,
    "text": "形象鲜明、讽刺辛辣；“兴者，先言他物以引起所咏之词也”，",
    "start": 77.861,
    "end": 83.468,
    "duration": 5.607
  },
  {
    "id": 22,
    "text": "如 《周南·关雎》 开篇以 “关关雎鸠，",
    "start": 83.468,
    "end": 84.758,
    "duration": 1.29
  },
  {
    "id": 23,
    "text": "在河之洲” 起兴，借水鸟和鸣起兴引出 “窈窕淑女，",
    "start": 84.758,
    "end": 90.129,
    "duration": 5.371
  },
  {
    "id": 24,
    "text": "君子好逑” 的相思恋情。",
    "start": 90.129,
    "end": 91.425,
    "duration": 1.296
  },
  {
    "id": 25,
    "text": "赋比兴手法的综合运用，使客观物象与主观情感深度交融，",
    "start": 91.425,
    "end": 96.859,
    "duration": 5.434
  },
  {
    "id": 26,
    "text": "开创了后世托物言志的博大传统。",
    "start": 96.859,
    "end": 101.311,
    "duration": 4.452
  },
  {
    "id": 27,
    "text": "第二，确立重章叠句与回环复沓的篇章结构，",
    "start": 101.311,
    "end": 104.777,
    "duration": 3.466
  },
  {
    "id": 28,
    "text": "展现优美的音乐复奏美感。",
    "start": 104.777,
    "end": 107.601,
    "duration": 2.824
  },
  {
    "id": 29,
    "text": "《诗经》 的民歌部分广泛采用重章叠句的结构方式。",
    "start": 107.601,
    "end": 111.201,
    "duration": 3.6
  },
  {
    "id": 30,
    "text": "作品在几个章节之间，字句结构基本相同，",
    "start": 111.201,
    "end": 115.448,
    "duration": 4.247
  },
  {
    "id": 31,
    "text": "仅在关键位置更换少数几个同义或反义词语，",
    "start": 115.448,
    "end": 120.195,
    "duration": 4.747
  },
  {
    "id": 32,
    "text": "在反复吟唱中推进情感。",
    "start": 120.195,
    "end": 121.812,
    "duration": 1.617
  },
  {
    "id": 33,
    "text": "以国风名篇 《秦风·蒹葭》 为例，全诗三章叠唱，",
    "start": 121.812,
    "end": 125.422,
    "duration": 3.61
  },
  {
    "id": 34,
    "text": "由 “白露为霜” 演进到 “未晞”、“未已”，",
    "start": 125.422,
    "end": 129.623,
    "duration": 4.201
  },
  {
    "id": 35,
    "text": "由 “宛在水中央” 转换为 “水中坻”、“水中沚”；",
    "start": 129.623,
    "end": 130.965,
    "duration": 1.342
  },
  {
    "id": 36,
    "text": "随着秋意逐渐深浓与追寻空间的层层变换，",
    "start": 130.965,
    "end": 133.233,
    "duration": 2.268
  },
  {
    "id": 37,
    "text": "反复抒发了对伊人可望而不可即的渺远惆怅。",
    "start": 133.233,
    "end": 137.491,
    "duration": 4.258
  },
  {
    "id": 38,
    "text": "这种回环复沓的结构，不仅极大地强化了诗歌的音乐节律，",
    "start": 137.491,
    "end": 141.866,
    "duration": 4.375
  },
  {
    "id": 39,
    "text": "更营造出反复低回、情韵绵长的抒情氛围。",
    "start": 141.866,
    "end": 145.795,
    "duration": 3.929
  },
  {
    "id": 40,
    "text": "第三，开创直面现实与关怀民生苦难的写实品格，",
    "start": 145.795,
    "end": 150.367,
    "duration": 4.572
  },
  {
    "id": 41,
    "text": "铸就“风雅”诗教精神。",
    "start": 150.367,
    "end": 152.632,
    "duration": 2.265
  },
  {
    "id": 42,
    "text": "《诗经》 牢牢扎根于世俗人间的真实土壤，",
    "start": 152.632,
    "end": 158.431,
    "duration": 5.799
  },
  {
    "id": 43,
    "text": "全面展现了宗周社会的生动图景。",
    "start": 158.431,
    "end": 161.617,
    "duration": 3.186
  },
  {
    "id": 44,
    "text": "尤其是 “国风” 与 “小雅” 中的怨刺诗与社会讽谕诗，",
    "start": 161.617,
    "end": 163.252,
    "duration": 1.635
  },
  {
    "id": 45,
    "text": "以卓越的批判勇气直面社会矛盾。",
    "start": 163.252,
    "end": 165.714,
    "duration": 2.462
  },
  {
    "id": 46,
    "text": "《魏风·伐檀》 面对统治者的不劳而获，发出 “不稼不穑，",
    "start": 165.714,
    "end": 169.698,
    "duration": 3.984
  },
  {
    "id": 47,
    "text": "胡取禾三百廛兮” 的严正抗议；",
    "start": 169.698,
    "end": 173.68,
    "duration": 3.982
  },
  {
    "id": 48,
    "text": "《豳风·东山》 以细腻平实的细节描写征夫还乡，",
    "start": 173.68,
    "end": 177.797,
    "duration": 4.117
  },
  {
    "id": 49,
    "text": "“零雨其濛” 中满怀对故园荒芜的酸楚；",
    "start": 177.797,
    "end": 181.46,
    "duration": 3.663
  },
  {
    "id": 50,
    "text": "《小雅·采薇》 中 “昔我往矣，杨柳依依；今我来思，",
    "start": 181.46,
    "end": 185.154,
    "duration": 3.694
  },
  {
    "id": 51,
    "text": "雨雪霏霏”，以乐景写哀，",
    "start": 185.154,
    "end": 188.574,
    "duration": 3.42
  },
  {
    "id": 52,
    "text": "将战火中士兵的悲凉心灵刻画得入木三分。",
    "start": 188.574,
    "end": 192.362,
    "duration": 3.788
  },
  {
    "id": 53,
    "text": "这种关注生民疾苦、干预现实的批判精神，",
    "start": 192.362,
    "end": 195.898,
    "duration": 3.536
  },
  {
    "id": 54,
    "text": "直接构成了儒家“美刺”诗教的优良传统。",
    "start": 195.898,
    "end": 199.979,
    "duration": 4.081
  },
  {
    "id": 55,
    "text": "第四，形成以四言为主兼备参差变化的语言体式，",
    "start": 199.979,
    "end": 203.835,
    "duration": 3.856
  },
  {
    "id": 56,
    "text": "奠定汉语诗歌的音律节奏。",
    "start": 203.835,
    "end": 206.039,
    "duration": 2.204
  },
  {
    "id": 57,
    "text": "在语言体制上，《诗经》 确立了以四言为主的基本诗体，",
    "start": 206.039,
    "end": 212.624,
    "duration": 6.585
  },
  {
    "id": 58,
    "text": "形成了二二节拍的整齐节奏。",
    "start": 212.624,
    "end": 215.473,
    "duration": 2.849
  },
  {
    "id": 59,
    "text": "同时，诗中大量吸纳两字、三字直至八字的长短句，",
    "start": 215.473,
    "end": 218.695,
    "duration": 3.222
  },
  {
    "id": 60,
    "text": "打破单调僵化；《诗经》 极善运用叠字与拟声词，",
    "start": 218.695,
    "end": 223.086,
    "duration": 4.391
  },
  {
    "id": 61,
    "text": "如 《小雅·伐木》 之 “伐木丁丁，鸟鸣嘤嘤”，",
    "start": 223.086,
    "end": 225.184,
    "duration": 2.098
  },
  {
    "id": 62,
    "text": "《郑风·子衿》 之 “青青子衿，悠悠我心”，形象逼真、",
    "start": 225.184,
    "end": 230.425,
    "duration": 5.241
  },
  {
    "id": 63,
    "text": "声律和谐；全诗广泛运用双声叠韵与自然押韵，句式灵活舒展，",
    "start": 230.425,
    "end": 235.243,
    "duration": 4.818
  },
  {
    "id": 64,
    "text": "为汉魏以后五七言诗歌体裁的发展提供了丰厚的音律给养。",
    "start": 235.243,
    "end": 240.432,
    "duration": 5.189
  }
]