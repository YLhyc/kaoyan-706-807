[
  {
    "id": 1,
    "text": "《西游记》是中国文学史上最成熟、",
    "start": 0.0,
    "end": 2.751,
    "duration": 2.751
  },
  {
    "id": 2,
    "text": "影响最为深远的浪漫主义长篇章回体神魔小说，",
    "start": 2.751,
    "end": 6.983,
    "duration": 4.232
  },
  {
    "id": 3,
    "text": "鲁迅在《中国小说史略》中将其精辟界定为“神魔小说”的开山与巅峰之作。",
    "start": 6.983,
    "end": 13.12,
    "duration": 6.137
  },
  {
    "id": 4,
    "text": "在明代中后期商品经济繁荣、心学思潮勃兴与市民社会狂欢的美学土壤中，",
    "start": 13.12,
    "end": 19.68,
    "duration": 6.56
  },
  {
    "id": 5,
    "text": "吴承恩以唐僧取经的历史真实为内核，",
    "start": 19.68,
    "end": 23.066,
    "duration": 3.386
  },
  {
    "id": 6,
    "text": "融入极为瑰丽奇绝的民间神话传说。",
    "start": 23.066,
    "end": 26.24,
    "duration": 3.174
  },
  {
    "id": 7,
    "text": "作者以超拔的天才想象营构出三界秩序与九九八十一难的宏大奇幻世界，",
    "start": 26.32,
    "end": 32.56,
    "duration": 6.24
  },
  {
    "id": 8,
    "text": "构建出极具中国古典浪漫主义特色的审美范式。",
    "start": 32.56,
    "end": 36.56,
    "duration": 4.0
  },
  {
    "id": 9,
    "text": "首先，在审美意蕴上，《西游记》实现了幻想世界与人间世态的深度交融，",
    "start": 36.56,
    "end": 42.72,
    "duration": 6.16
  },
  {
    "id": 10,
    "text": "鲁迅精辟概括其为“神魔皆有人情，",
    "start": 42.72,
    "end": 45.68,
    "duration": 2.96
  },
  {
    "id": 11,
    "text": "精魅亦通世故”。",
    "start": 45.68,
    "end": 46.96,
    "duration": 1.28
  },
  {
    "id": 12,
    "text": "作品虽极写仙界佛国与妖魔洞府，其内核却深植于明代中后期的现实社会。",
    "start": 47.28,
    "end": 54.48,
    "duration": 7.2
  },
  {
    "id": 13,
    "text": "天庭与冥府的森严等级、拖沓推伟，",
    "start": 54.48,
    "end": 57.92,
    "duration": 3.44
  },
  {
    "id": 14,
    "text": "正是人间封建专制官僚体制的曲折折射。",
    "start": 57.92,
    "end": 61.28,
    "duration": 3.36
  },
  {
    "id": 15,
    "text": "佛国净土的阿难、迦叶公开向取经团队索要人事金银，",
    "start": 61.28,
    "end": 66.24,
    "duration": 4.96
  },
  {
    "id": 16,
    "text": "极辛辣地揭露了世俗官场的贪腐风气。",
    "start": 66.24,
    "end": 69.12,
    "duration": 2.88
  },
  {
    "id": 17,
    "text": "许多为非作歹的妖魔背后，皆有天庭神佛作为靠山与主子。",
    "start": 69.44,
    "end": 74.48,
    "duration": 5.04
  },
  {
    "id": 18,
    "text": "这种虚实交错的镜像反射，使天马行空的浪漫奇幻具备了穿透现实的社会批判力度。",
    "start": 74.48,
    "end": 81.6,
    "duration": 7.12
  },
  {
    "id": 19,
    "text": "其次，在人物塑造上，《西游记》创造性地达成了“物性、",
    "start": 81.6,
    "end": 86.16,
    "duration": 4.56
  },
  {
    "id": 20,
    "text": "神性、人性”的三位一体完美熔铸。",
    "start": 86.16,
    "end": 88.88,
    "duration": 2.72
  },
  {
    "id": 21,
    "text": "以核心典型孙悟空为例，其物性表现为猴性未泯、",
    "start": 89.12,
    "end": 93.84,
    "duration": 4.72
  },
  {
    "id": 22,
    "text": "机敏灵动与抓耳挠腮。",
    "start": 93.84,
    "end": 96.32,
    "duration": 2.48
  },
  {
    "id": 23,
    "text": "其神性表现为七十二般变化、一个筋斗十万八千里与火眼金睛的神通广大。",
    "start": 96.32,
    "end": 103.04,
    "duration": 6.72
  },
  {
    "id": 24,
    "text": "其人性则表现为追求自由、敢于反抗神权天规的桀骜风骨，",
    "start": 103.04,
    "end": 108.4,
    "duration": 5.36
  },
  {
    "id": 25,
    "text": "以及对师弟同伴的重情重义。",
    "start": 108.4,
    "end": 110.64,
    "duration": 2.24
  },
  {
    "id": 26,
    "text": "大闹天宫时发出“皇帝轮流做，明年到我家”的惊世骇俗之语，",
    "start": 110.88,
    "end": 116.32,
    "duration": 5.44
  },
  {
    "id": 27,
    "text": "生动凝聚了明代市民阶层破除权威盲从的抗争意志。",
    "start": 116.32,
    "end": 121.12,
    "duration": 4.8
  },
  {
    "id": 28,
    "text": "猪八戒亦是将野猪习性、天蓬法力与凡俗人性的食色本能冶于一炉，",
    "start": 121.12,
    "end": 126.96,
    "duration": 5.84
  },
  {
    "id": 29,
    "text": "人物形象极具饱满真实的美学张力。",
    "start": 126.96,
    "end": 129.68,
    "duration": 2.72
  },
  {
    "id": 30,
    "text": "再次，在表现风格上，《西游记》洋溢着挥谐幽默的“游戏笔墨”与狂欢化民间美学意趣。",
    "start": 129.968,
    "end": 137.488,
    "duration": 7.52
  },
  {
    "id": 31,
    "text": "明代理学家常将全书视为炼心证道的寓言，",
    "start": 137.488,
    "end": 141.648,
    "duration": 4.16
  },
  {
    "id": 32,
    "text": "但作品的根本生命力在于其蓬勃的讽刺与挥谐精神。",
    "start": 141.648,
    "end": 146.528,
    "duration": 4.88
  },
  {
    "id": 33,
    "text": "全书贯穿着调侃崇高、解构权威的民间谐谑语言，",
    "start": 146.528,
    "end": 151.168,
    "duration": 4.64
  },
  {
    "id": 34,
    "text": "孙悟空称玉帝为“玉皇老儿”，称老君为“牛关”。",
    "start": 151.168,
    "end": 154.848,
    "duration": 3.68
  },
  {
    "id": 35,
    "text": "在九死一生的妖魔险境中，取经师徒插科打诨、",
    "start": 155.168,
    "end": 159.328,
    "duration": 4.16
  },
  {
    "id": 36,
    "text": "机智化解，将庄严肃穆的宗教朝圣演化为充满乐观进取精神的生命探索历程。",
    "start": 159.328,
    "end": 165.488,
    "duration": 6.16
  },
  {
    "id": 37,
    "text": "最后，《西游记》的审美创造树立了中国古代神话浪漫主义叙事的最高丰碑。",
    "start": 165.488,
    "end": 171.088,
    "duration": 5.6
  },
  {
    "id": 38,
    "text": "它不仅彻底奠定了后世神魔小说的创作范式，",
    "start": 171.088,
    "end": 174.528,
    "duration": 3.44
  },
  {
    "id": 39,
    "text": "其物神人融通的美学逻辑与自由无羁的抗争精神，",
    "start": 174.528,
    "end": 178.768,
    "duration": 4.24
  },
  {
    "id": 40,
    "text": "更深深融入了中华民族的集体文化性格，",
    "start": 178.768,
    "end": 181.888,
    "duration": 3.12
  },
  {
    "id": 41,
    "text": "成为世界文学瑰宝中独树一帜的奇幻史诗。",
    "start": 181.888,
    "end": 185.168,
    "duration": 3.28
  }
]