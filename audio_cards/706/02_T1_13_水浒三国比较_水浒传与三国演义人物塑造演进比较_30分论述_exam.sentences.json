[
  {
    "id": "sent_1",
    "text": "《三国演义》 与 《水浒传》 是中国古典长篇章回小说发展初期的两座巍峨丰碑。",
    "start": 0.1,
    "end": 7.211,
    "duration": 7.111
  },
  {
    "id": "sent_2",
    "text": "二者同诞生于元末明初讲史话本与市井文化的繁荣土壤，",
    "start": 7.161,
    "end": 12.395,
    "duration": 5.234
  },
  {
    "id": "sent_3",
    "text": "分别开创了中国历史演义小说与英雄传奇小说的宏大格局。",
    "start": 12.396,
    "end": 17.956,
    "duration": 5.56
  },
  {
    "id": "sent_4",
    "text": "然而，从 《三国演义》 走向 《水浒传》，",
    "start": 17.956,
    "end": 21.472,
    "duration": 3.516
  },
  {
    "id": "sent_5",
    "text": "标志着中国古代小说在人物塑造艺术上，",
    "start": 21.471,
    "end": 25.416,
    "duration": 3.945
  },
  {
    "id": "sent_6",
    "text": "实现了一次由“政治道德类型化”向“现实生活性格化与发展性”的历史性跨越。",
    "start": 25.417,
    "end": 32.123,
    "duration": 6.706
  },
  {
    "id": "sent_7",
    "text": "金圣叹在评述两书时指出，水浒人物刻画之工绝不减于史记。",
    "start": 32.122,
    "end": 38.151,
    "duration": 6.029
  },
  {
    "id": "sent_8",
    "text": "二人在人物塑造艺术上的同异与演进规律，",
    "start": 38.151,
    "end": 42.109,
    "duration": 3.958
  },
  {
    "id": "sent_9",
    "text": "主要展现为以下四个核心维度：",
    "start": 42.109,
    "end": 45.416,
    "duration": 3.307
  },
  {
    "id": "sent_10",
    "text": "第一，在人物塑造观念上，",
    "start": 45.417,
    "end": 48.151,
    "duration": 2.734
  },
  {
    "id": "sent_11",
    "text": "呈现由政治伦理类型化向个性鲜明性格化的历史演进。",
    "start": 48.151,
    "end": 53.346,
    "duration": 5.195
  },
  {
    "id": "sent_12",
    "text": "《三国演义》 的人物塑造深刻受制于“尊刘贬曹”的正统政治倾向与史传编年体例，",
    "start": 53.346,
    "end": 60.299,
    "duration": 6.953
  },
  {
    "id": "sent_13",
    "text": "人物往往偏于政治道德的象征化定型。",
    "start": 60.299,
    "end": 63.919,
    "duration": 3.62
  },
  {
    "id": "sent_14",
    "text": "鲁迅精辟概括其主要人物具有 “智绝”（诸葛亮）、“义绝”（关羽）、“奸绝”（曹操）的典型特征，",
    "start": 63.919,
    "end": 72.565,
    "duration": 8.646
  },
  {
    "id": "sent_15",
    "text": "人物一出场其性格便基本定型，鲜有内因导致的剧烈改变；",
    "start": 72.565,
    "end": 78.099,
    "duration": 5.534
  },
  {
    "id": "sent_16",
    "text": "而 《水浒传》 则突破了政治伦理概念的预设，",
    "start": 78.099,
    "end": 82.187,
    "duration": 4.088
  },
  {
    "id": "sent_17",
    "text": "将人物扎根于社会生活的土壤中。",
    "start": 82.187,
    "end": 85.365,
    "duration": 3.178
  },
  {
    "id": "sent_18",
    "text": "作者不再将人物定性为非黑即白的扁平脸谱，",
    "start": 85.365,
    "end": 89.844,
    "duration": 4.479
  },
  {
    "id": "sent_19",
    "text": "而是刻画出活生生的人性真实，如宋江的仁义仗义与权谋妥协，",
    "start": 89.844,
    "end": 96.302,
    "duration": 6.458
  },
  {
    "id": "sent_20",
    "text": "李逵的赤诚天真与野蛮滥杀，人物性格丰富而具备真实的生活毛边。",
    "start": 96.302,
    "end": 102.735,
    "duration": 6.433
  },
  {
    "id": "sent_21",
    "text": "第二，在性格表现机制上，",
    "start": 102.734,
    "end": 105.507,
    "duration": 2.773
  },
  {
    "id": "sent_22",
    "text": "展现由静态特征强化向动态性格发展的深层飞跃。",
    "start": 105.508,
    "end": 110.573,
    "duration": 5.065
  },
  {
    "id": "sent_23",
    "text": "在人物命运演变轨迹上，《三国演义》 的人物性格具有高度的稳定性，",
    "start": 110.573,
    "end": 116.524,
    "duration": 5.951
  },
  {
    "id": "sent_24",
    "text": "叙事重点在于历史事件与政治智谋的较量，",
    "start": 116.523,
    "end": 120.677,
    "duration": 4.154
  },
  {
    "id": "sent_25",
    "text": "人物多是在各种情境中反复印证其既定品质；",
    "start": 120.677,
    "end": 125.169,
    "duration": 4.492
  },
  {
    "id": "sent_26",
    "text": "而 《水浒传》 则首次成功塑造了具有严密心理演变与鲜明阶段发展的性格典型。",
    "start": 125.169,
    "end": 132.552,
    "duration": 7.383
  },
  {
    "id": "sent_27",
    "text": "最突出的代表当属林冲：作为八十万禁军教头，",
    "start": 132.552,
    "end": 136.966,
    "duration": 4.414
  },
  {
    "id": "sent_28",
    "text": "他起初对封建官场怀抱幻想，",
    "start": 136.966,
    "end": 140.117,
    "duration": 3.151
  },
  {
    "id": "sent_29",
    "text": "面对高太尉迫害表现出屈从隐忍、息事宁人；",
    "start": 140.117,
    "end": 144.818,
    "duration": 4.701
  },
  {
    "id": "sent_30",
    "text": "然而在野猪林遇险、草料场被焚、山神庙手刃仇敌等一系列残酷打击下，",
    "start": 144.818,
    "end": 151.797,
    "duration": 6.979
  },
  {
    "id": "sent_31",
    "text": "其内心的正统幻想被彻底粉碎，最终性格发生深刻突变，",
    "start": 151.797,
    "end": 157.448,
    "duration": 5.651
  },
  {
    "id": "sent_32",
    "text": "毅然雪夜上梁山。",
    "start": 157.448,
    "end": 159.57,
    "duration": 2.122
  },
  {
    "id": "sent_33",
    "text": "这种动态的性格成长，展现了卓越的现实主义深度。",
    "start": 159.57,
    "end": 164.583,
    "duration": 5.013
  },
  {
    "id": "sent_34",
    "text": "第三，在生存空间与生活视野上，",
    "start": 164.583,
    "end": 168.047,
    "duration": 3.464
  },
  {
    "id": "sent_35",
    "text": "呈现由庙堂军事全景向市井江湖微观日常的下沉。",
    "start": 168.047,
    "end": 173.229,
    "duration": 5.182
  },
  {
    "id": "sent_36",
    "text": "二者人物活动环境的差异深刻影响了人物性格的质感。",
    "start": 173.229,
    "end": 177.93,
    "duration": 4.701
  },
  {
    "id": "sent_37",
    "text": "《三国演义》 的人物活跃于朝堂营帐、割据诸侯与沙场战阵之间，",
    "start": 177.93,
    "end": 183.789,
    "duration": 5.859
  },
  {
    "id": "sent_38",
    "text": "人物语言与行事风范多具帝王将相的宏阔威仪与政治谋略，",
    "start": 183.789,
    "end": 189.505,
    "duration": 5.716
  },
  {
    "id": "sent_39",
    "text": "缺乏细碎的日常生活气息；",
    "start": 189.505,
    "end": 192.252,
    "duration": 2.747
  },
  {
    "id": "sent_40",
    "text": "《水浒传》 则把聚光灯对准了城镇集市、村舍客栈、荒郊野店与押解大道。",
    "start": 192.253,
    "end": 199.362,
    "duration": 7.109
  },
  {
    "id": "sent_41",
    "text": "作者极善于通过平凡而具体的市井生活细节展现好汉性格，",
    "start": 199.362,
    "end": 205.091,
    "duration": 5.729
  },
  {
    "id": "sent_42",
    "text": "如杨志卖刀时的穷困失意、武松在快活林醉打蒋门神时的江湖机敏。",
    "start": 205.091,
    "end": 211.771,
    "duration": 6.68
  },
  {
    "id": "sent_43",
    "text": "这种向市井民间的深度下沉，使水浒人物具备了更加浓郁的血肉感。",
    "start": 211.771,
    "end": 217.904,
    "duration": 6.133
  },
  {
    "id": "sent_44",
    "text": "第四，在语言体式运用上，",
    "start": 217.904,
    "end": 220.73,
    "duration": 2.826
  },
  {
    "id": "sent_45",
    "text": "呈现由文白相间的史传文言向纯熟生动的白话口语的飞跃。",
    "start": 220.729,
    "end": 226.458,
    "duration": 5.729
  },
  {
    "id": "sent_46",
    "text": "在人物语言塑造上，",
    "start": 226.458,
    "end": 228.58,
    "duration": 2.122
  },
  {
    "id": "sent_47",
    "text": "《三国演义》 采用的是经过提炼的浅近文言与文白夹杂体式，",
    "start": 228.581,
    "end": 234.05,
    "duration": 5.469
  },
  {
    "id": "sent_48",
    "text": "庄重典雅、概括力强，切合历史正剧的严肃氛围，",
    "start": 234.049,
    "end": 239.023,
    "duration": 4.974
  },
  {
    "id": "sent_49",
    "text": "但人物个性化口吻稍显受限；",
    "start": 239.023,
    "end": 242.135,
    "duration": 3.112
  },
  {
    "id": "sent_50",
    "text": "《水浒传》 则全面吸纳宋元以来的北方白话口语，",
    "start": 242.135,
    "end": 246.471,
    "duration": 4.336
  },
  {
    "id": "sent_51",
    "text": "创造出高度成熟、生动洗练的白话叙事语言。",
    "start": 246.471,
    "end": 250.911,
    "duration": 4.44
  },
  {
    "id": "sent_52",
    "text": "好汉们的对话 “各极其声，见其人即可辨其言”：",
    "start": 250.911,
    "end": 255.377,
    "duration": 4.466
  },
  {
    "id": "sent_53",
    "text": "鲁智深的豪迈粗中有细，李逵的粗鲁直率，林冲的谦抑自抑，",
    "start": 255.378,
    "end": 261.003,
    "duration": 5.625
  },
  {
    "id": "sent_54",
    "text": "无不通过活泼纯正的白话口语精准流露，",
    "start": 261.003,
    "end": 265.039,
    "duration": 4.036
  },
  {
    "id": "sent_55",
    "text": "标志着中国古代小说语言艺术走向成熟独立。",
    "start": 265.039,
    "end": 269.571,
    "duration": 4.532
  }
]