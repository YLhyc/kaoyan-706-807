[
  {
    "id": "sent_1",
    "text": "《三国演义》 与 《水浒传》 是中国古典长篇章回小说发展初期的两座巍峨丰碑。",
    "start": 0.0,
    "end": 5.8,
    "duration": 5.8
  },
  {
    "id": "sent_2",
    "text": "二者同诞生于元末明初讲史话本与市井文化的繁荣土壤，",
    "start": 6.329,
    "end": 10.889,
    "duration": 4.56
  },
  {
    "id": "sent_3",
    "text": "分别开创了中国历史演义小说与英雄传奇小说的宏大格局。",
    "start": 11.339,
    "end": 16.019,
    "duration": 4.68
  },
  {
    "id": "sent_4",
    "text": "然而，从 《三国演义》 走向 《水浒传》，",
    "start": 16.469,
    "end": 19.149,
    "duration": 2.68
  },
  {
    "id": "sent_5",
    "text": "标志着中国古代小说在人物塑造艺术上，",
    "start": 19.599,
    "end": 23.039,
    "duration": 3.44
  },
  {
    "id": "sent_6",
    "text": "实现了一次由“政治道德类型化”向“现实生活性格化与发展性”的历史性跨越。",
    "start": 23.489,
    "end": 29.569,
    "duration": 6.08
  },
  {
    "id": "sent_7",
    "text": "金圣叹在评述两书时指出，水浒人物刻画之工绝不减于史记。",
    "start": 30.019,
    "end": 35.259,
    "duration": 5.24
  },
  {
    "id": "sent_8",
    "text": "二人在人物塑造艺术上的同异与演进规律，",
    "start": 35.829,
    "end": 39.069,
    "duration": 3.24
  },
  {
    "id": "sent_9",
    "text": "主要展现为以下四个核心维度：",
    "start": 39.519,
    "end": 42.039,
    "duration": 2.52
  },
  {
    "id": "sent_10",
    "text": "第一，在人物塑造观念上，",
    "start": 42.489,
    "end": 44.729,
    "duration": 2.24
  },
  {
    "id": "sent_11",
    "text": "呈现由政治伦理类型化向个性鲜明性格化的历史演进。",
    "start": 45.179,
    "end": 49.339,
    "duration": 4.16
  },
  {
    "id": "sent_12",
    "text": "《三国演义》 的人物塑造深刻受制于“尊刘贬曹”的正统政治倾向与史传编年体例，",
    "start": 49.789,
    "end": 55.949,
    "duration": 6.16
  },
  {
    "id": "sent_13",
    "text": "人物往往偏于政治道德的象征化定型。",
    "start": 56.399,
    "end": 59.519,
    "duration": 3.12
  },
  {
    "id": "sent_14",
    "text": "鲁迅精辟概括其主要人物具有 “智绝”（诸葛亮）、",
    "start": 59.969,
    "end": 63.649,
    "duration": 3.68
  },
  {
    "id": "sent_15",
    "text": "“义绝”（关羽）、“奸绝”（曹操）的典型特征，",
    "start": 64.179,
    "end": 67.499,
    "duration": 3.32
  },
  {
    "id": "sent_16",
    "text": "人物一出场其性格便基本定型，鲜有内因导致的剧烈改变；",
    "start": 67.949,
    "end": 72.709,
    "duration": 4.76
  },
  {
    "id": "sent_17",
    "text": "而 《水浒传》 则突破了政治伦理概念的预设，",
    "start": 73.159,
    "end": 76.439,
    "duration": 3.28
  },
  {
    "id": "sent_18",
    "text": "将人物扎根于社会生活的土壤中。",
    "start": 76.889,
    "end": 79.489,
    "duration": 2.6
  },
  {
    "id": "sent_19",
    "text": "作者不再将人物定性为非黑即白的扁平脸谱，",
    "start": 79.939,
    "end": 83.499,
    "duration": 3.56
  },
  {
    "id": "sent_20",
    "text": "而是刻画出活生生的人性真实，如宋江的仁义仗义与权谋妥协，",
    "start": 83.949,
    "end": 89.509,
    "duration": 5.56
  },
  {
    "id": "sent_21",
    "text": "李逵的赤诚天真与野蛮滥杀，人物性格丰富而具备真实的生活毛边。",
    "start": 89.959,
    "end": 94.999,
    "duration": 5.04
  },
  {
    "id": "sent_22",
    "text": "第二，在性格表现机制上，",
    "start": 95.449,
    "end": 97.449,
    "duration": 2.0
  },
  {
    "id": "sent_23",
    "text": "展现由静态特征强化向动态性格发展的深层飞跃。",
    "start": 97.979,
    "end": 102.179,
    "duration": 4.2
  },
  {
    "id": "sent_24",
    "text": "在人物命运演变轨迹上，",
    "start": 102.629,
    "end": 104.629,
    "duration": 2.0
  },
  {
    "id": "sent_25",
    "text": "《三国演义》 的人物性格具有高度的稳定性，",
    "start": 105.079,
    "end": 108.119,
    "duration": 3.04
  },
  {
    "id": "sent_26",
    "text": "叙事重点在于历史事件与政治智谋的较量，",
    "start": 108.569,
    "end": 111.969,
    "duration": 3.4
  },
  {
    "id": "sent_27",
    "text": "人物多是在各种情境中反复印证其既定品质；",
    "start": 112.419,
    "end": 116.059,
    "duration": 3.64
  },
  {
    "id": "sent_28",
    "text": "而 《水浒传》 则首次成功塑造了具有严密心理演变与鲜明阶段发展的性格典型。",
    "start": 116.509,
    "end": 122.469,
    "duration": 5.96
  },
  {
    "id": "sent_29",
    "text": "最突出的代表当属林冲：作为八十万禁军教头，",
    "start": 122.919,
    "end": 126.719,
    "duration": 3.8
  },
  {
    "id": "sent_30",
    "text": "他起初对封建官场怀抱幻想，面对高太尉迫害表现出屈从隐忍、",
    "start": 127.169,
    "end": 132.409,
    "duration": 5.24
  },
  {
    "id": "sent_31",
    "text": "息事宁人；",
    "start": 132.859,
    "end": 133.939,
    "duration": 1.08
  },
  {
    "id": "sent_32",
    "text": "然而在野猪林遇险、草料场被焚、",
    "start": 134.389,
    "end": 137.269,
    "duration": 2.88
  },
  {
    "id": "sent_33",
    "text": "山神庙手刃仇敌等一系列残酷打击下，",
    "start": 137.719,
    "end": 140.919,
    "duration": 3.2
  },
  {
    "id": "sent_34",
    "text": "其内心的正统幻想被彻底粉碎，最终性格发生深刻突变，",
    "start": 141.369,
    "end": 146.129,
    "duration": 4.76
  },
  {
    "id": "sent_35",
    "text": "毅然雪夜上梁山。",
    "start": 146.579,
    "end": 148.059,
    "duration": 1.48
  },
  {
    "id": "sent_36",
    "text": "这种动态的性格成长，展现了卓越的现实主义深度。",
    "start": 148.509,
    "end": 152.429,
    "duration": 3.92
  },
  {
    "id": "sent_37",
    "text": "第三，在生存空间与生活视野上，",
    "start": 152.879,
    "end": 155.799,
    "duration": 2.92
  },
  {
    "id": "sent_38",
    "text": "呈现由庙堂军事全景向市井江湖微观日常的下沉。",
    "start": 156.249,
    "end": 160.489,
    "duration": 4.24
  },
  {
    "id": "sent_39",
    "text": "二者人物活动环境的差异深刻影响了人物性格的质感。",
    "start": 160.939,
    "end": 165.139,
    "duration": 4.2
  },
  {
    "id": "sent_40",
    "text": "《三国演义》 的人物活跃于朝堂营帐、割据诸侯与沙场战阵之间，",
    "start": 165.589,
    "end": 170.629,
    "duration": 5.04
  },
  {
    "id": "sent_41",
    "text": "人物语言与行事风范多具帝王将相的宏阔威仪与政治谋略，",
    "start": 171.079,
    "end": 175.719,
    "duration": 4.64
  },
  {
    "id": "sent_42",
    "text": "缺乏细碎的日常生活气息；",
    "start": 176.169,
    "end": 178.489,
    "duration": 2.32
  },
  {
    "id": "sent_43",
    "text": "《水浒传》 则把聚光灯对准了城镇集市、村舍客栈、",
    "start": 178.939,
    "end": 182.779,
    "duration": 3.84
  },
  {
    "id": "sent_44",
    "text": "荒郊野店与押解大道。",
    "start": 183.229,
    "end": 185.109,
    "duration": 1.88
  },
  {
    "id": "sent_45",
    "text": "作者极善于通过平凡而具体的市井生活细节展现好汉性格，",
    "start": 185.559,
    "end": 189.919,
    "duration": 4.36
  },
  {
    "id": "sent_46",
    "text": "如杨志卖刀时的穷困失意、武松在快活林醉打蒋门神时的江湖机敏。",
    "start": 190.448,
    "end": 196.048,
    "duration": 5.6
  },
  {
    "id": "sent_47",
    "text": "这种向市井民间的深度下沉，使水浒人物具备了更加浓郁的血肉感。",
    "start": 196.498,
    "end": 201.978,
    "duration": 5.48
  },
  {
    "id": "sent_48",
    "text": "第四，在语言体式运用上，",
    "start": 202.428,
    "end": 204.788,
    "duration": 2.36
  },
  {
    "id": "sent_49",
    "text": "呈现由文白相间的史传文言向纯熟生动的白话口语的飞跃。",
    "start": 205.238,
    "end": 209.958,
    "duration": 4.72
  },
  {
    "id": "sent_50",
    "text": "在人物语言塑造上，",
    "start": 210.408,
    "end": 212.048,
    "duration": 1.64
  },
  {
    "id": "sent_51",
    "text": "《三国演义》 采用的是经过提炼的浅近文言与文白夹杂体式，",
    "start": 212.498,
    "end": 217.138,
    "duration": 4.64
  },
  {
    "id": "sent_52",
    "text": "庄重典雅、概括力强，切合历史正剧的严肃氛围，",
    "start": 217.588,
    "end": 221.428,
    "duration": 3.84
  },
  {
    "id": "sent_53",
    "text": "但人物个性化口吻稍显受限；",
    "start": 221.878,
    "end": 224.318,
    "duration": 2.44
  },
  {
    "id": "sent_54",
    "text": "《水浒传》 则全面吸纳宋元以来的北方白话口语，",
    "start": 224.768,
    "end": 228.688,
    "duration": 3.92
  },
  {
    "id": "sent_55",
    "text": "创造出高度成熟、生动洗练的白话叙事语言。",
    "start": 229.138,
    "end": 232.778,
    "duration": 3.64
  },
  {
    "id": "sent_56",
    "text": "好汉们的对话 “各极其声，见其人即可辨其言”：",
    "start": 233.308,
    "end": 236.988,
    "duration": 3.68
  },
  {
    "id": "sent_57",
    "text": "鲁智深的豪迈粗中有细，李逵的粗鲁直率，林冲的谦抑自抑，",
    "start": 237.438,
    "end": 242.598,
    "duration": 5.16
  },
  {
    "id": "sent_58",
    "text": "无不通过活泼纯正的白话口语精准流露，",
    "start": 243.128,
    "end": 246.448,
    "duration": 3.32
  },
  {
    "id": "sent_59",
    "text": "标志着中国古代小说语言艺术走向成熟独立。",
    "start": 246.898,
    "end": 250.538,
    "duration": 3.64
  }
]