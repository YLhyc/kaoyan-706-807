[
  {
    "id": 1,
    "text": "试论《水浒传》与《三国演义》人物塑造艺术的异同与演进。",
    "start": 0.05,
    "end": 4.873,
    "duration": 4.823
  },
  {
    "id": 2,
    "text": "《三国演义》 与 《水浒传》 是中国古典长篇章回小说发展初期的两座巍峨丰碑。",
    "start": 4.873,
    "end": 10.866,
    "duration": 5.993
  },
  {
    "id": 3,
    "text": "二者同诞生于元末明初讲史话本与市井文化的繁荣土壤，",
    "start": 10.866,
    "end": 16.014,
    "duration": 5.148
  },
  {
    "id": 4,
    "text": "分别开创了中国历史演义小说与英雄传奇小说的宏大格局。",
    "start": 16.014,
    "end": 21.522,
    "duration": 5.508
  },
  {
    "id": 5,
    "text": "然而，从 《三国演义》 走向 《水浒传》，",
    "start": 21.522,
    "end": 23.888,
    "duration": 2.366
  },
  {
    "id": 6,
    "text": "标志着中国古代小说在人物塑造艺术上，",
    "start": 23.888,
    "end": 27.32,
    "duration": 3.432
  },
  {
    "id": 7,
    "text": "实现了一次由“政治道德类型化”向“现实生活性格化与发展性”的历史性跨越。",
    "start": 27.32,
    "end": 34.247,
    "duration": 6.927
  },
  {
    "id": 8,
    "text": "金圣叹在评述两书时指出，水浒人物刻画之工绝不减于史记。",
    "start": 34.247,
    "end": 39.699,
    "duration": 5.452
  },
  {
    "id": 9,
    "text": "二人在人物塑造艺术上的同异与演进规律，",
    "start": 39.699,
    "end": 43.445,
    "duration": 3.746
  },
  {
    "id": 10,
    "text": "主要展现为以下四个核心维度：",
    "start": 43.445,
    "end": 46.264,
    "duration": 2.819
  },
  {
    "id": 11,
    "text": "第一，在人物塑造观念上，",
    "start": 46.264,
    "end": 48.553,
    "duration": 2.289
  },
  {
    "id": 12,
    "text": "呈现由政治伦理类型化向个性鲜明性格化的历史演进。",
    "start": 48.553,
    "end": 53.153,
    "duration": 4.6
  },
  {
    "id": 13,
    "text": "《三国演义》 的人物塑造深刻受制于“尊刘贬曹”的正统政治倾向与史传编年体例，",
    "start": 53.153,
    "end": 59.778,
    "duration": 6.625
  },
  {
    "id": 14,
    "text": "人物往往偏于政治道德的象征化定型。",
    "start": 59.778,
    "end": 62.834,
    "duration": 3.056
  },
  {
    "id": 15,
    "text": "鲁迅精辟概括其主要人物具有 “智绝”（诸葛亮）、",
    "start": 62.834,
    "end": 67.814,
    "duration": 4.98
  },
  {
    "id": 16,
    "text": "“义绝”（关羽）、“奸绝”（曹操）的典型特征，",
    "start": 67.814,
    "end": 70.233,
    "duration": 2.419
  },
  {
    "id": 17,
    "text": "人物一出场其性格便基本定型，鲜有内因导致的剧烈改变；",
    "start": 70.233,
    "end": 75.105,
    "duration": 4.872
  },
  {
    "id": 18,
    "text": "而 《水浒传》 则突破了政治伦理概念的预设，",
    "start": 75.105,
    "end": 80.671,
    "duration": 5.566
  },
  {
    "id": 19,
    "text": "将人物扎根于社会生活的土壤中。",
    "start": 80.671,
    "end": 83.217,
    "duration": 2.546
  },
  {
    "id": 20,
    "text": "作者不再将人物定性为非黑即白的扁平脸谱，",
    "start": 83.217,
    "end": 87.305,
    "duration": 4.088
  },
  {
    "id": 21,
    "text": "而是刻画出活生生的人性真实，如宋江的仁义仗义与权谋妥协，",
    "start": 87.305,
    "end": 92.893,
    "duration": 5.588
  },
  {
    "id": 22,
    "text": "李逵的赤诚天真与野蛮滥杀，",
    "start": 92.893,
    "end": 95.998,
    "duration": 3.105
  },
  {
    "id": 23,
    "text": "人物性格丰富而具备真实的生活毛边。",
    "start": 95.998,
    "end": 98.907,
    "duration": 2.909
  },
  {
    "id": 24,
    "text": "第二，在性格表现机制上，",
    "start": 98.907,
    "end": 100.725,
    "duration": 1.818
  },
  {
    "id": 25,
    "text": "展现由静态特征强化向动态性格发展的深层飞跃。",
    "start": 100.725,
    "end": 104.68,
    "duration": 3.955
  },
  {
    "id": 26,
    "text": "在人物命运演变轨迹上，",
    "start": 104.68,
    "end": 107.792,
    "duration": 3.112
  },
  {
    "id": 27,
    "text": "《三国演义》 的人物性格具有高度的稳定性，",
    "start": 107.792,
    "end": 111.605,
    "duration": 3.813
  },
  {
    "id": 28,
    "text": "叙事重点在于历史事件与政治智谋的较量，",
    "start": 111.605,
    "end": 115.845,
    "duration": 4.24
  },
  {
    "id": 29,
    "text": "人物多是在各种情境中反复印证其既定品质；",
    "start": 115.845,
    "end": 119.923,
    "duration": 4.078
  },
  {
    "id": 30,
    "text": "而 《水浒传》 则首次成功塑造了具有严密心理演变与鲜明阶段发展的性格典型。",
    "start": 119.923,
    "end": 126.573,
    "duration": 6.65
  },
  {
    "id": 31,
    "text": "最突出的代表当属林冲：作为八十万禁军教头，",
    "start": 126.573,
    "end": 130.027,
    "duration": 3.454
  },
  {
    "id": 32,
    "text": "他起初对封建官场怀抱幻想，面对高太尉迫害表现出屈从隐忍、",
    "start": 130.027,
    "end": 135.172,
    "duration": 5.145
  },
  {
    "id": 33,
    "text": "息事宁人；然而在野猪林遇险、草料场被焚、",
    "start": 135.172,
    "end": 139.832,
    "duration": 4.66
  },
  {
    "id": 34,
    "text": "山神庙手刃仇敌等一系列残酷打击下，",
    "start": 139.832,
    "end": 142.889,
    "duration": 3.057
  },
  {
    "id": 35,
    "text": "其内心的正统幻想被彻底粉碎，最终性格发生深刻突变，",
    "start": 142.889,
    "end": 147.071,
    "duration": 4.182
  },
  {
    "id": 36,
    "text": "毅然雪夜上梁山。",
    "start": 147.071,
    "end": 148.495,
    "duration": 1.424
  },
  {
    "id": 37,
    "text": "这种动态的性格成长，展现了卓越的现实主义深度。",
    "start": 148.495,
    "end": 153.793,
    "duration": 5.298
  },
  {
    "id": 38,
    "text": "第三，在生存空间与生活视野上，",
    "start": 153.793,
    "end": 156.157,
    "duration": 2.364
  },
  {
    "id": 39,
    "text": "呈现由庙堂军事全景向市井江湖微观日常的下沉。",
    "start": 156.157,
    "end": 160.095,
    "duration": 3.938
  },
  {
    "id": 40,
    "text": "二者人物活动环境的差异深刻影响了人物性格的质感。",
    "start": 160.095,
    "end": 165.555,
    "duration": 5.46
  },
  {
    "id": 41,
    "text": "《三国演义》 的人物活跃于朝堂营帐、",
    "start": 165.555,
    "end": 168.101,
    "duration": 2.546
  },
  {
    "id": 42,
    "text": "割据诸侯与沙场战阵之间，",
    "start": 168.101,
    "end": 170.498,
    "duration": 2.397
  },
  {
    "id": 43,
    "text": "人物语言与行事风范多具帝王将相的宏阔威仪与政治谋略，",
    "start": 170.498,
    "end": 175.356,
    "duration": 4.858
  },
  {
    "id": 44,
    "text": "缺乏细碎的日常生活气息；",
    "start": 175.356,
    "end": 178.996,
    "duration": 3.64
  },
  {
    "id": 45,
    "text": "《水浒传》 则把聚光灯对准了城镇集市、村舍客栈、",
    "start": 178.996,
    "end": 182.45,
    "duration": 3.454
  },
  {
    "id": 46,
    "text": "荒郊野店与押解大道。",
    "start": 182.45,
    "end": 184.302,
    "duration": 1.852
  },
  {
    "id": 47,
    "text": "作者极善于通过平凡而具体的市井生活细节展现好汉性格，",
    "start": 184.302,
    "end": 190.481,
    "duration": 6.179
  },
  {
    "id": 48,
    "text": "如杨志卖刀时的穷困失意、",
    "start": 190.481,
    "end": 193.17,
    "duration": 2.689
  },
  {
    "id": 49,
    "text": "武松在快活林醉打蒋门神时的江湖机敏。",
    "start": 193.17,
    "end": 196.562,
    "duration": 3.392
  },
  {
    "id": 50,
    "text": "这种向市井民间的深度下沉，使水浒人物具备了更加浓郁的血肉感。",
    "start": 196.562,
    "end": 202.289,
    "duration": 5.727
  },
  {
    "id": 51,
    "text": "第四，在语言体式运用上，",
    "start": 202.289,
    "end": 204.194,
    "duration": 1.905
  },
  {
    "id": 52,
    "text": "呈现由文白相间的史传文言向纯熟生动的白话口语的飞跃。",
    "start": 204.194,
    "end": 209.904,
    "duration": 5.71
  },
  {
    "id": 53,
    "text": "在人物语言塑造上，",
    "start": 209.904,
    "end": 211.358,
    "duration": 1.454
  },
  {
    "id": 54,
    "text": "《三国演义》 采用的是经过提炼的浅近文言与文白夹杂体式，",
    "start": 211.358,
    "end": 217.473,
    "duration": 6.115
  },
  {
    "id": 55,
    "text": "庄重典雅、概括力强，切合历史正剧的严肃氛围，",
    "start": 217.473,
    "end": 220.928,
    "duration": 3.455
  },
  {
    "id": 56,
    "text": "但人物个性化口吻稍显受限；",
    "start": 220.928,
    "end": 223.189,
    "duration": 2.261
  },
  {
    "id": 57,
    "text": "《水浒传》 则全面吸纳宋元以来的北方白话口语，",
    "start": 223.189,
    "end": 228.04,
    "duration": 4.851
  },
  {
    "id": 58,
    "text": "创造出高度成熟、生动洗练的白话叙事语言。",
    "start": 228.04,
    "end": 231.697,
    "duration": 3.657
  },
  {
    "id": 59,
    "text": "好汉们的对话 “各极其声，见其人即可辨其言”：",
    "start": 231.697,
    "end": 234.969,
    "duration": 3.272
  },
  {
    "id": 60,
    "text": "鲁智深的豪迈粗中有细，李逵的粗鲁直率，林冲的谦抑自抑，",
    "start": 234.969,
    "end": 240.141,
    "duration": 5.172
  },
  {
    "id": 61,
    "text": "无不通过活泼纯正的白话口语精准流露，",
    "start": 240.141,
    "end": 243.524,
    "duration": 3.383
  },
  {
    "id": 62,
    "text": "标志着中国古代小说语言艺术走向成熟独立。",
    "start": 243.524,
    "end": 247.32,
    "duration": 3.796
  }
]