[
  {
    "id": 1,
    "text": "试论《水浒传》与《三国演义》人物塑造艺术的异同与演进。",
    "start": 0.16,
    "end": 4.829,
    "duration": 4.669
  },
  {
    "id": 2,
    "text": "《三国演义》与《水浒传》是中国古代长篇章回小说兴起时期的两座高峰。",
    "start": 5.435,
    "end": 11.337,
    "duration": 5.902
  },
  {
    "id": 3,
    "text": "二者同胎息于宋元说话伎艺与民间传说，分别开创了历史演义与英雄传奇两大流派。",
    "start": 11.837,
    "end": 19.783,
    "duration": 7.946
  },
  {
    "id": 4,
    "text": "从《三国演义》走向《水浒传》，",
    "start": 20.283,
    "end": 22.406,
    "duration": 2.123
  },
  {
    "id": 5,
    "text": "标志着中国古代长篇小说在人物塑造上由“特征化”走向“性格化”的重大演进，",
    "start": 22.756,
    "end": 29.104,
    "duration": 6.348
  },
  {
    "id": 6,
    "text": "明人唐顺之、王慎中盛赞《水浒传》“《史记》而下，便是此书”。",
    "start": 29.454,
    "end": 34.746,
    "duration": 5.292
  },
  {
    "id": 7,
    "text": "二者人物塑造的异同与演进规律，主要体现在以下四个方面：",
    "start": 35.246,
    "end": 39.689,
    "duration": 4.443
  },
  {
    "id": 8,
    "text": "第一，塑造观念由政治道德类型化演进为复杂鲜明的性格化。",
    "start": 40.317,
    "end": 45.274,
    "duration": 4.957
  },
  {
    "id": 9,
    "text": "《三国演义》受“拥刘反曹”的正统观念与历史框架制约，",
    "start": 45.774,
    "end": 49.837,
    "duration": 4.063
  },
  {
    "id": 10,
    "text": "人物往往偏于政治道德的特征化定型，",
    "start": 50.287,
    "end": 53.051,
    "duration": 2.764
  },
  {
    "id": 11,
    "text": "毛宗岗概括其主要人物具有“智绝”（诸葛亮）、“义绝”（关羽）、“奸绝”（曹操）之典型特征，虽高大鲜明却略显单一；",
    "start": 53.531,
    "end": 63.135,
    "duration": 9.604
  },
  {
    "id": 12,
    "text": "《水浒传》则跳出正史制约，将目光投向普通人与复杂人性，",
    "start": 63.635,
    "end": 68.254,
    "duration": 4.619
  },
  {
    "id": 13,
    "text": "刻画出好汉性格的多层次与真实感，如宋江既有仗义疏财的豪气，又有忠君妥协的权谋；",
    "start": 68.604,
    "end": 75.917,
    "duration": 7.313
  },
  {
    "id": 14,
    "text": "李逵既有赤诚天真的一面，又兼粗鲁暴躁之弊，打破了非黑即白的简单定型。",
    "start": 76.417,
    "end": 82.5,
    "duration": 6.083
  },
  {
    "id": 15,
    "text": "第二，性格机制由静态定型强化演进为随环境流变的动态发展。",
    "start": 83.119,
    "end": 88.602,
    "duration": 5.483
  },
  {
    "id": 16,
    "text": "在人物命运轨迹上，《三国演义》的人物性格往往出场即已定型，叙事重点在于通过重大事件反复渲染其既定特征；",
    "start": 89.171,
    "end": 98.249,
    "duration": 9.078
  },
  {
    "id": 17,
    "text": "《水浒传》则开始着力展现人物性格在社会环境逼迫下的流动与转变。",
    "start": 98.749,
    "end": 103.956,
    "duration": 5.207
  },
  {
    "id": 18,
    "text": "林冲便是典型例证：身为八十万禁军教头，他初遭高太尉陷害时屈从隐忍、息事宁人；",
    "start": 104.456,
    "end": 111.717,
    "duration": 7.261
  },
  {
    "id": 19,
    "text": "发配沧州、野猪林遇险后仍对官场存有幻想；",
    "start": 112.217,
    "end": 115.755,
    "duration": 3.538
  },
  {
    "id": 20,
    "text": "直到草料场被焚、山神庙听明陆谦等人的毒计，",
    "start": 116.255,
    "end": 120.046,
    "duration": 3.791
  },
  {
    "id": 21,
    "text": "其正统幻想方才破灭，愤而手刃仇敌、雪夜上梁山。",
    "start": 120.396,
    "end": 124.963,
    "duration": 4.567
  },
  {
    "id": 22,
    "text": "这种层层推进的性格演变，展现出深厚的现实主义力量。",
    "start": 125.463,
    "end": 129.94,
    "duration": 4.477
  },
  {
    "id": 23,
    "text": "第三，活动空间由庙堂战阵下沉至市井江湖的日常细节之中。",
    "start": 130.547,
    "end": 136.243,
    "duration": 5.696
  },
  {
    "id": 24,
    "text": "人物生活环境的差异深刻影响了人物形象的质感。",
    "start": 136.951,
    "end": 140.662,
    "duration": 3.711
  },
  {
    "id": 25,
    "text": "《三国演义》的人物多活跃于朝堂谋议、诸侯会盟与沙场交锋之中，",
    "start": 141.162,
    "end": 146.48,
    "duration": 5.318
  },
  {
    "id": 26,
    "text": "言行举止富有帝王将相的威仪气度，而较少日常生活的细碎描写；",
    "start": 146.919,
    "end": 152.062,
    "duration": 5.143
  },
  {
    "id": 27,
    "text": "《水浒传》虽也有超常的传奇色彩，却把英雄置入城镇集市、酒肆客栈与市井细民之间，",
    "start": 152.562,
    "end": 160.686,
    "duration": 8.124
  },
  {
    "id": 28,
    "text": "善于在烟火日常与细微动作中写人，",
    "start": 161.036,
    "end": 163.918,
    "duration": 2.882
  },
  {
    "id": 29,
    "text": "如杨志卖刀的穷困窘迫、武松景阳冈醉打猛虎与在嫂嫂挑逗下从礼貌推辞到怒斥发作的细致过渡，使英雄形象血肉丰满。",
    "start": 164.442,
    "end": 175.364,
    "duration": 10.922
  },
  {
    "id": 30,
    "text": "第四，叙事语言由浅近文白相间演进为纯熟生动的白话口语。",
    "start": 175.979,
    "end": 181.787,
    "duration": 5.808
  },
  {
    "id": 31,
    "text": "在语言艺术上，《三国演义》采用浅近文言与文白相杂的语体，凝练典雅、适合历史正剧的庄重氛围，但限制了人物个性化口吻的发挥；",
    "start": 182.297,
    "end": 193.035,
    "duration": 10.738
  },
  {
    "id": 32,
    "text": "《水浒传》则以提炼纯熟的北方白话口语入书，",
    "start": 193.584,
    "end": 196.813,
    "duration": 3.229
  },
  {
    "id": 33,
    "text": "做到了金圣叹《读第五才子书法》所赞的“一样人，便还他一样说话”：",
    "start": 197.163,
    "end": 202.538,
    "duration": 5.375
  },
  {
    "id": 34,
    "text": "鲁智深的豪爽直率、林冲的忍让斯文、李逵的粗野天真，",
    "start": 203.149,
    "end": 208.063,
    "duration": 4.914
  },
  {
    "id": 35,
    "text": "皆从口语对话中自然流露，标志着古代白话小说人物语言艺术走向成熟。",
    "start": 208.413,
    "end": 214.314,
    "duration": 5.901
  },
  {
    "id": 36,
    "text": "总而言之，从《三国演义》到《水浒传》，",
    "start": 214.85,
    "end": 217.381,
    "duration": 2.531
  },
  {
    "id": 37,
    "text": "中国古代长篇章回小说完成了人物塑造由政治道德类型化向市井世俗性格化的重要跨越。",
    "start": 217.766,
    "end": 224.917,
    "duration": 7.151
  },
  {
    "id": 38,
    "text": "这一从静态特征强化转向动态性格流变、从浅近文白转向纯熟白话口语的演进历程，",
    "start": 225.608,
    "end": 232.853,
    "duration": 7.245
  },
  {
    "id": 39,
    "text": "直接为明代后期《金瓶梅》世情小说及清代《红楼梦》的写人艺术开辟了道路。",
    "start": 233.26,
    "end": 239.187,
    "duration": 5.927
  }
]
