[
  {
    "id": 1,
    "text": "试论《水浒传》与《三国演义》人物塑造艺术的异同与演进。",
    "start": 0.0,
    "end": 4.898,
    "duration": 4.898
  },
  {
    "id": 2,
    "text": "《三国演义》 与 《水浒传》 是中国古典长篇章回小说发展初期的两座巍峨丰碑。",
    "start": 4.898,
    "end": 6.527,
    "duration": 1.629
  },
  {
    "id": 3,
    "text": "二者同诞生于元末明初讲史话本与市井文化的繁荣土壤，",
    "start": 6.527,
    "end": 10.895,
    "duration": 4.368
  },
  {
    "id": 4,
    "text": "分别开创了中国历史演义小说与英雄传奇小说的宏大格局。",
    "start": 10.895,
    "end": 16.041,
    "duration": 5.146
  },
  {
    "id": 5,
    "text": "然而，从 《三国演义》 走向 《水浒传》，",
    "start": 16.041,
    "end": 18.594,
    "duration": 2.553
  },
  {
    "id": 6,
    "text": "标志着中国古代小说在人物塑造艺术上，",
    "start": 18.594,
    "end": 21.006,
    "duration": 2.412
  },
  {
    "id": 7,
    "text": "实现了一次由“政治道德类型化”向“现实生活性格化与发展性”的历史性跨越。",
    "start": 21.006,
    "end": 28.507,
    "duration": 7.501
  },
  {
    "id": 8,
    "text": "金圣叹在评述两书时指出，水浒人物刻画之工绝不减于史记。",
    "start": 28.507,
    "end": 34.277,
    "duration": 5.77
  },
  {
    "id": 9,
    "text": "二人在人物塑造艺术上的同异与演进规律，",
    "start": 34.277,
    "end": 36.886,
    "duration": 2.609
  },
  {
    "id": 10,
    "text": "主要展现为以下四个核心维度：",
    "start": 36.886,
    "end": 39.728,
    "duration": 2.842
  },
  {
    "id": 11,
    "text": "第一，在人物塑造观念上，",
    "start": 39.728,
    "end": 43.475,
    "duration": 3.747
  },
  {
    "id": 12,
    "text": "呈现由政治伦理类型化向个性鲜明性格化的历史演进。",
    "start": 43.475,
    "end": 46.973,
    "duration": 3.498
  },
  {
    "id": 13,
    "text": "《三国演义》 的人物塑造深刻受制于“尊刘贬曹”的正统政治倾向与史传编年体例，",
    "start": 46.973,
    "end": 54.765,
    "duration": 7.792
  },
  {
    "id": 14,
    "text": "人物往往偏于政治道德的象征化定型。",
    "start": 54.765,
    "end": 58.202,
    "duration": 3.437
  },
  {
    "id": 15,
    "text": "鲁迅精辟概括其主要人物具有 “智绝”（诸葛亮）、",
    "start": 58.202,
    "end": 62.864,
    "duration": 4.662
  },
  {
    "id": 16,
    "text": "“义绝”（关羽）、“奸绝”（曹操）的典型特征，",
    "start": 62.864,
    "end": 67.098,
    "duration": 4.234
  },
  {
    "id": 17,
    "text": "人物一出场其性格便基本定型，鲜有内因导致的剧烈改变；",
    "start": 67.098,
    "end": 72.88,
    "duration": 5.782
  },
  {
    "id": 18,
    "text": "而 《水浒传》 则突破了政治伦理概念的预设，",
    "start": 72.88,
    "end": 75.135,
    "duration": 2.255
  },
  {
    "id": 19,
    "text": "将人物扎根于社会生活的土壤中。",
    "start": 75.135,
    "end": 80.701,
    "duration": 5.566
  },
  {
    "id": 20,
    "text": "作者不再将人物定性为非黑即白的扁平脸谱，",
    "start": 80.701,
    "end": 84.455,
    "duration": 3.754
  },
  {
    "id": 21,
    "text": "而是刻画出活生生的人性真实，如宋江的仁义仗义与权谋妥协，",
    "start": 84.455,
    "end": 90.191,
    "duration": 5.736
  },
  {
    "id": 22,
    "text": "李逵的赤诚天真与野蛮滥杀，",
    "start": 90.191,
    "end": 92.923,
    "duration": 2.732
  },
  {
    "id": 23,
    "text": "人物性格丰富而具备真实的生活毛边。",
    "start": 92.923,
    "end": 96.028,
    "duration": 3.105
  },
  {
    "id": 24,
    "text": "第二，在性格表现机制上，",
    "start": 96.028,
    "end": 96.687,
    "duration": 0.659
  },
  {
    "id": 25,
    "text": "展现由静态特征强化向动态性格发展的深层飞跃。",
    "start": 96.687,
    "end": 102.605,
    "duration": 5.918
  },
  {
    "id": 26,
    "text": "在人物命运演变轨迹上，",
    "start": 102.605,
    "end": 104.788,
    "duration": 2.183
  },
  {
    "id": 27,
    "text": "《三国演义》 的人物性格具有高度的稳定性，",
    "start": 104.788,
    "end": 107.82,
    "duration": 3.032
  },
  {
    "id": 28,
    "text": "叙事重点在于历史事件与政治智谋的较量，",
    "start": 107.82,
    "end": 111.635,
    "duration": 3.815
  },
  {
    "id": 29,
    "text": "人物多是在各种情境中反复印证其既定品质；",
    "start": 111.635,
    "end": 115.875,
    "duration": 4.24
  },
  {
    "id": 30,
    "text": "而 《水浒传》 则首次成功塑造了具有严密心理演变与鲜明阶段发展的性格典型。",
    "start": 115.875,
    "end": 122.436,
    "duration": 6.561
  },
  {
    "id": 31,
    "text": "最突出的代表当属林冲：作为八十万禁军教头，",
    "start": 122.436,
    "end": 126.603,
    "duration": 4.167
  },
  {
    "id": 32,
    "text": "他起初对封建官场怀抱幻想，面对高太尉迫害表现出屈从隐忍、",
    "start": 126.603,
    "end": 133.45,
    "duration": 6.847
  },
  {
    "id": 33,
    "text": "息事宁人；然而在野猪林遇险、草料场被焚、",
    "start": 133.45,
    "end": 136.622,
    "duration": 3.172
  },
  {
    "id": 34,
    "text": "山神庙手刃仇敌等一系列残酷打击下，",
    "start": 136.622,
    "end": 139.786,
    "duration": 3.164
  },
  {
    "id": 35,
    "text": "其内心的正统幻想被彻底粉碎，最终性格发生深刻突变，",
    "start": 139.786,
    "end": 142.918,
    "duration": 3.132
  },
  {
    "id": 36,
    "text": "毅然雪夜上梁山。",
    "start": 142.918,
    "end": 146.664,
    "duration": 3.746
  },
  {
    "id": 37,
    "text": "这种动态的性格成长，展现了卓越的现实主义深度。",
    "start": 146.664,
    "end": 150.75,
    "duration": 4.086
  },
  {
    "id": 38,
    "text": "第三，在生存空间与生活视野上，",
    "start": 150.75,
    "end": 153.823,
    "duration": 3.073
  },
  {
    "id": 39,
    "text": "呈现由庙堂军事全景向市井江湖微观日常的下沉。",
    "start": 153.823,
    "end": 158.57,
    "duration": 4.747
  },
  {
    "id": 40,
    "text": "二者人物活动环境的差异深刻影响了人物性格的质感。",
    "start": 158.57,
    "end": 162.645,
    "duration": 4.075
  },
  {
    "id": 41,
    "text": "《三国演义》 的人物活跃于朝堂营帐、",
    "start": 162.645,
    "end": 165.585,
    "duration": 2.94
  },
  {
    "id": 42,
    "text": "割据诸侯与沙场战阵之间，",
    "start": 165.585,
    "end": 168.064,
    "duration": 2.479
  },
  {
    "id": 43,
    "text": "人物语言与行事风范多具帝王将相的宏阔威仪与政治谋略，",
    "start": 168.064,
    "end": 173.207,
    "duration": 5.143
  },
  {
    "id": 44,
    "text": "缺乏细碎的日常生活气息；",
    "start": 173.207,
    "end": 176.342,
    "duration": 3.135
  },
  {
    "id": 45,
    "text": "《水浒传》 则把聚光灯对准了城镇集市、村舍客栈、",
    "start": 176.342,
    "end": 181.187,
    "duration": 4.845
  },
  {
    "id": 46,
    "text": "荒郊野店与押解大道。",
    "start": 181.187,
    "end": 182.455,
    "duration": 1.268
  },
  {
    "id": 47,
    "text": "作者极善于通过平凡而具体的市井生活细节展现好汉性格，",
    "start": 182.455,
    "end": 187.934,
    "duration": 5.479
  },
  {
    "id": 48,
    "text": "如杨志卖刀时的穷困失意、",
    "start": 187.934,
    "end": 190.511,
    "duration": 2.577
  },
  {
    "id": 49,
    "text": "武松在快活林醉打蒋门神时的江湖机敏。",
    "start": 190.511,
    "end": 194.217,
    "duration": 3.706
  },
  {
    "id": 50,
    "text": "这种向市井民间的深度下沉，使水浒人物具备了更加浓郁的血肉感。",
    "start": 194.217,
    "end": 199.874,
    "duration": 5.657
  },
  {
    "id": 51,
    "text": "第四，在语言体式运用上，",
    "start": 199.874,
    "end": 202.318,
    "duration": 2.444
  },
  {
    "id": 52,
    "text": "呈现由文白相间的史传文言向纯熟生动的白话口语的飞跃。",
    "start": 202.318,
    "end": 208.319,
    "duration": 6.001
  },
  {
    "id": 53,
    "text": "在人物语言塑造上，",
    "start": 208.319,
    "end": 209.932,
    "duration": 1.613
  },
  {
    "id": 54,
    "text": "《三国演义》 采用的是经过提炼的浅近文言与文白夹杂体式，",
    "start": 209.932,
    "end": 215.265,
    "duration": 5.333
  },
  {
    "id": 55,
    "text": "庄重典雅、概括力强，切合历史正剧的严肃氛围，",
    "start": 215.265,
    "end": 219.734,
    "duration": 4.469
  },
  {
    "id": 56,
    "text": "但人物个性化口吻稍显受限；",
    "start": 219.734,
    "end": 222.265,
    "duration": 2.531
  },
  {
    "id": 57,
    "text": "《水浒传》 则全面吸纳宋元以来的北方白话口语，",
    "start": 222.265,
    "end": 226.474,
    "duration": 4.209
  },
  {
    "id": 58,
    "text": "创造出高度成熟、生动洗练的白话叙事语言。",
    "start": 226.474,
    "end": 230.487,
    "duration": 4.013
  },
  {
    "id": 59,
    "text": "好汉们的对话 “各极其声，见其人即可辨其言”：",
    "start": 230.487,
    "end": 234.487,
    "duration": 4.0
  },
  {
    "id": 60,
    "text": "鲁智深的豪迈粗中有细，李逵的粗鲁直率，林冲的谦抑自抑，",
    "start": 234.487,
    "end": 240.171,
    "duration": 5.684
  },
  {
    "id": 61,
    "text": "无不通过活泼纯正的白话口语精准流露，",
    "start": 240.171,
    "end": 243.554,
    "duration": 3.383
  },
  {
    "id": 62,
    "text": "标志着中国古代小说语言艺术走向成熟独立。",
    "start": 243.554,
    "end": 247.32,
    "duration": 3.766
  }
]