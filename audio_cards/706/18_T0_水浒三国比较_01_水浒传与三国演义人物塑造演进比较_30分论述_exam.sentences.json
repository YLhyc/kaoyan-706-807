[
  {
    "id": 1,
    "text": "题型，三十分论述题。",
    "start": 0.08,
    "end": 1.864,
    "duration": 1.784
  },
  {
    "id": 2,
    "text": "分值，三十分。",
    "start": 1.864,
    "end": 2.968,
    "duration": 1.104
  },
  {
    "id": 3,
    "text": "建议考场时间，三十五分钟。",
    "start": 2.968,
    "end": 5.394,
    "duration": 2.426
  },
  {
    "id": 4,
    "text": "目标字数，一千一百五十到一千三百字。",
    "start": 5.394,
    "end": 8.924,
    "duration": 3.53
  },
  {
    "id": 5,
    "text": "答题骨架，演进定位定性、趋近于、",
    "start": 8.924,
    "end": 11.792,
    "duration": 2.868
  },
  {
    "id": 6,
    "text": "人物性格从类型化向多维性格化飞跃、",
    "start": 11.792,
    "end": 15.322,
    "duration": 3.53
  },
  {
    "id": 7,
    "text": "趋近于、人物塑造机制从道德命定走向环境与心理流变、",
    "start": 15.322,
    "end": 20.397,
    "duration": 5.075
  },
  {
    "id": 8,
    "text": "趋近于、细节描写与语言从史传笔意走向市井白描与个性化口语、",
    "start": 20.397,
    "end": 26.354,
    "duration": 5.957
  },
  {
    "id": 9,
    "text": "趋近于、宏观文学史总结。",
    "start": 26.354,
    "end": 28.56,
    "duration": 2.206
  },
  {
    "id": 10,
    "text": "《三国演义》与《水浒传》代表了中国古代长篇章回小说演进的两大关键里程碑。",
    "start": 28.56,
    "end": 34.618,
    "duration": 6.058
  },
  {
    "id": 11,
    "text": "《三国演义》初创了英雄传奇与历史演义的宏大叙事范式，",
    "start": 34.618,
    "end": 39.112,
    "duration": 4.494
  },
  {
    "id": 12,
    "text": "而《水浒传》则在此基础上实现了重大艺术跨越，",
    "start": 39.112,
    "end": 42.825,
    "duration": 3.713
  },
  {
    "id": 13,
    "text": "标志着中国小说人物塑造艺术从依傍史传的类型化叙事，",
    "start": 42.825,
    "end": 47.515,
    "duration": 4.69
  },
  {
    "id": 14,
    "text": "全面迈向关注个体生存境遇与复杂性格演变的写实成熟期。",
    "start": 47.515,
    "end": 52.4,
    "duration": 4.885
  },
  {
    "id": 15,
    "text": "第一，在人物性格形态上，《水浒传》实现了从“类型化特征化”向“多维性格化”的深刻飞跃。",
    "start": 52.48,
    "end": 59.68,
    "duration": 7.2
  },
  {
    "id": 16,
    "text": "《三国演义》受传统史传春秋笔法与民间说唱定型影响，",
    "start": 59.68,
    "end": 64.32,
    "duration": 4.64
  },
  {
    "id": 17,
    "text": "人物性格多呈现鲜明的特征化倾向，",
    "start": 64.32,
    "end": 67.36,
    "duration": 3.04
  },
  {
    "id": 18,
    "text": "鲁迅在《中国小说史略》中精辟概括其“欲显刘备之长厚而似伪，",
    "start": 67.36,
    "end": 73.04,
    "duration": 5.68
  },
  {
    "id": 19,
    "text": "状诸葛之多智而近妖”，关羽之绝伦义气、",
    "start": 73.04,
    "end": 76.48,
    "duration": 3.44
  },
  {
    "id": 20,
    "text": "曹操之奸诈雄制亦高度凝固于某种道德文化类型。",
    "start": 76.48,
    "end": 80.56,
    "duration": 4.08
  },
  {
    "id": 21,
    "text": "相比之下，《水浒传》则突破了单一维度的脸谱化建构，",
    "start": 80.96,
    "end": 84.88,
    "duration": 3.92
  },
  {
    "id": 22,
    "text": "赋予人物极其丰富复杂的性格层次。",
    "start": 84.88,
    "end": 87.44,
    "duration": 2.56
  },
  {
    "id": 23,
    "text": "金圣叹评水浒“人有其性情，人有其气质，",
    "start": 87.44,
    "end": 91.12,
    "duration": 3.68
  },
  {
    "id": 24,
    "text": "人有其形状，人有其声口”。",
    "start": 91.12,
    "end": 93.52,
    "duration": 2.4
  },
  {
    "id": 25,
    "text": "以宋江为例，他既有仗义疏财、扶危济困的“及时雨”美德，",
    "start": 93.52,
    "end": 97.92,
    "duration": 4.4
  },
  {
    "id": 26,
    "text": "又有身受儒家伦理浸染、渴望招安封妻荫子的软弱妥协，",
    "start": 97.92,
    "end": 102.4,
    "duration": 4.48
  },
  {
    "id": 27,
    "text": "更有循阳楼题反诗时压抑已久的狂放野心，",
    "start": 102.4,
    "end": 106.16,
    "duration": 3.76
  },
  {
    "id": 28,
    "text": "其性格充满了忠义与反叛、仁厚与权术的深刻撕裂，",
    "start": 106.16,
    "end": 110.24,
    "duration": 4.08
  },
  {
    "id": 29,
    "text": "呈现出真实的人性深度。",
    "start": 110.24,
    "end": 111.92,
    "duration": 1.68
  },
  {
    "id": 30,
    "text": "第二，在性格生成机制上，《水浒传》实现了从“先天道德预设”向“社会环境逼迫与心理流变”的根本转变。",
    "start": 112.304,
    "end": 121.424,
    "duration": 9.12
  },
  {
    "id": 31,
    "text": "《三国演义》中的主要人物性格在登场伊始便基本定型，",
    "start": 121.424,
    "end": 125.904,
    "duration": 4.48
  },
  {
    "id": 32,
    "text": "其命运演进主要受天命大势与政治军事对抗推动，",
    "start": 125.904,
    "end": 130.464,
    "duration": 4.56
  },
  {
    "id": 33,
    "text": "较少展现人物心理与性格的发展轨迹。",
    "start": 130.464,
    "end": 133.344,
    "duration": 2.88
  },
  {
    "id": 34,
    "text": "《水浒传》则首次将人物性格的生成与严酷的社会生存现实紧密咬合，",
    "start": 133.584,
    "end": 139.277,
    "duration": 5.693
  },
  {
    "id": 35,
    "text": "开创了“官逼民反”的写实机制。",
    "start": 139.277,
    "end": 141.716,
    "duration": 2.439
  },
  {
    "id": 36,
    "text": "最典型的例证便是林冲形象的动态发展。",
    "start": 141.716,
    "end": 145.173,
    "duration": 3.457
  },
  {
    "id": 37,
    "text": "作为八十万禁军教头，林冲起初具有极深厚的体制依附心理，",
    "start": 145.173,
    "end": 150.256,
    "duration": 5.083
  },
  {
    "id": 38,
    "text": "面对高衙内调戏爱妻一再忍气吞声，",
    "start": 150.256,
    "end": 153.305,
    "duration": 3.049
  },
  {
    "id": 39,
    "text": "发配沧州途中面对董超、薛霸的折磨甚至野猪林的残害依然逆来顺受，",
    "start": 153.305,
    "end": 159.201,
    "duration": 5.896
  },
  {
    "id": 40,
    "text": "直至风雪山神庙偶听陆谦密谋方彻底梦醒，",
    "start": 159.201,
    "end": 162.861,
    "duration": 3.66
  },
  {
    "id": 41,
    "text": "最终提刀手刃仇敌雪夜上梁山。",
    "start": 162.861,
    "end": 165.504,
    "duration": 2.643
  },
  {
    "id": 42,
    "text": "这种在恶劣社会环境与步步紧逼的生存危机中展开的心理流变，",
    "start": 165.584,
    "end": 170.784,
    "duration": 5.2
  },
  {
    "id": 43,
    "text": "赋予人物性格极强的现实逻辑力量。",
    "start": 170.784,
    "end": 173.664,
    "duration": 2.88
  },
  {
    "id": 44,
    "text": "第三，在描写手法与语言艺术上，《水浒传》摆脱了史传粗陈梗概的叙事惯性，",
    "start": 173.904,
    "end": 181.024,
    "duration": 7.12
  },
  {
    "id": 45,
    "text": "开创了精微生动的市井生活白描与高度个性化的人物口语。",
    "start": 181.024,
    "end": 185.824,
    "duration": 4.8
  },
  {
    "id": 46,
    "text": "《三国演义》的语言是文白相建的“浅近文言”，",
    "start": 185.984,
    "end": 189.958,
    "duration": 3.974
  },
  {
    "id": 47,
    "text": "叙事长于宏观排兵布阵与外交辞令，",
    "start": 189.958,
    "end": 193.464,
    "duration": 3.506
  },
  {
    "id": 48,
    "text": "微观日常生活细节较为简省。",
    "start": 193.464,
    "end": 196.269,
    "duration": 2.805
  },
  {
    "id": 49,
    "text": "《水浒传》则大量运用地道成熟的北方白话口语，",
    "start": 196.269,
    "end": 200.71,
    "duration": 4.441
  },
  {
    "id": 50,
    "text": "且人物语言完全切合其独特身份与性格气质。",
    "start": 200.71,
    "end": 205.151,
    "duration": 4.441
  },
  {
    "id": 51,
    "text": "比如李逵之粗豪质朴、鲁智深之嫉恶如仇、",
    "start": 205.151,
    "end": 209.124,
    "duration": 3.973
  },
  {
    "id": 52,
    "text": "武松之沉稳刚烈，其谈吐声口无一雷同。",
    "start": 209.124,
    "end": 212.864,
    "duration": 3.74
  },
  {
    "id": 53,
    "text": "同时，《水浒传》极其长于捕捉微观动作细节与环境氛围的渲染，",
    "start": 212.944,
    "end": 217.984,
    "duration": 5.04
  },
  {
    "id": 54,
    "text": "比如武松景阳冈打虎时对梢棒折断的动作捕捉、",
    "start": 217.984,
    "end": 222.144,
    "duration": 4.16
  },
  {
    "id": 55,
    "text": "林冲在风雪山神庙用大石“靠”住庙门等细节，",
    "start": 222.144,
    "end": 225.984,
    "duration": 3.84
  },
  {
    "id": 56,
    "text": "皆达到了形神兼备、如在目前的艺术境界。",
    "start": 225.984,
    "end": 229.664,
    "duration": 3.68
  },
  {
    "id": 57,
    "text": "综上所述，《水浒传》较之于《三国演义》，",
    "start": 229.664,
    "end": 232.544,
    "duration": 2.88
  },
  {
    "id": 58,
    "text": "完成了中国古典小说人物塑造从类型化向性格化、",
    "start": 232.544,
    "end": 237.264,
    "duration": 4.72
  },
  {
    "id": 59,
    "text": "从静态定型向动态流变、从史传演义向生活写实的全面跃迁。",
    "start": 237.264,
    "end": 243.024,
    "duration": 5.76
  },
  {
    "id": 60,
    "text": "这一突破深刻拓展了中国叙事文学的审美表现力，",
    "start": 243.264,
    "end": 246.864,
    "duration": 3.6
  },
  {
    "id": 61,
    "text": "为后世《金瓶梅》与《红楼梦》等世情写实小说的巅峰繁荣开辟了坚实的艺术道路。",
    "start": 246.864,
    "end": 252.464,
    "duration": 5.6
  }
]