[
  {
    "id": 1,
    "start": 0.08,
    "end": 6.138,
    "text": "《三国演义》与《水浒传》代表了中国古代长篇章回小说演进的两大关键里程碑。"
  },
  {
    "id": 2,
    "start": 6.138,
    "end": 10.632,
    "text": "《三国演义》初创了英雄传奇与历史演义的宏大叙事范式，"
  },
  {
    "id": 3,
    "start": 10.632,
    "end": 14.345,
    "text": "而《水浒传》则在此基础上实现了重大艺术跨越，"
  },
  {
    "id": 4,
    "start": 14.345,
    "end": 19.035,
    "text": "标志着中国小说人物塑造艺术从依傍史传的类型化叙事，"
  },
  {
    "id": 5,
    "start": 19.035,
    "end": 23.92,
    "text": "全面迈向关注个体生存境遇与复杂性格演变的写实成熟期。"
  },
  {
    "id": 6,
    "start": 24.0,
    "end": 31.2,
    "text": "第一，在人物性格形态上，《水浒传》实现了从“类型化特征化”向“多维性格化”的深刻飞跃。"
  },
  {
    "id": 7,
    "start": 31.2,
    "end": 35.84,
    "text": "《三国演义》受传统史传春秋笔法与民间说唱定型影响，"
  },
  {
    "id": 8,
    "start": 35.84,
    "end": 38.88,
    "text": "人物性格多呈现鲜明的特征化倾向，"
  },
  {
    "id": 9,
    "start": 38.88,
    "end": 44.56,
    "text": "鲁迅在《中国小说史略》中精辟概括其“欲显刘备之长厚而似伪，"
  },
  {
    "id": 10,
    "start": 44.56,
    "end": 48.0,
    "text": "状诸葛之多智而近妖”，关羽之绝伦义气、"
  },
  {
    "id": 11,
    "start": 48.0,
    "end": 52.08,
    "text": "曹操之奸诈雄制亦高度凝固于某种道德文化类型。"
  },
  {
    "id": 12,
    "start": 52.48,
    "end": 56.4,
    "text": "相比之下，《水浒传》则突破了单一维度的脸谱化建构，"
  },
  {
    "id": 13,
    "start": 56.4,
    "end": 58.96,
    "text": "赋予人物极其丰富复杂的性格层次。"
  },
  {
    "id": 14,
    "start": 58.96,
    "end": 62.64,
    "text": "金圣叹评水浒“人有其性情，人有其气质，"
  },
  {
    "id": 15,
    "start": 62.64,
    "end": 65.04,
    "text": "人有其形状，人有其声口”。"
  },
  {
    "id": 16,
    "start": 65.04,
    "end": 69.44,
    "text": "以宋江为例，他既有仗义疏财、扶危济困的“及时雨”美德，"
  },
  {
    "id": 17,
    "start": 69.44,
    "end": 73.92,
    "text": "又有身受儒家伦理浸染、渴望招安封妻荫子的软弱妥协，"
  },
  {
    "id": 18,
    "start": 73.92,
    "end": 77.68,
    "text": "更有循阳楼题反诗时压抑已久的狂放野心，"
  },
  {
    "id": 19,
    "start": 77.68,
    "end": 81.76,
    "text": "其性格充满了忠义与反叛、仁厚与权术的深刻撕裂，"
  },
  {
    "id": 20,
    "start": 81.76,
    "end": 83.44,
    "text": "呈现出真实的人性深度。"
  },
  {
    "id": 21,
    "start": 83.824,
    "end": 92.944,
    "text": "第二，在性格生成机制上，《水浒传》实现了从“先天道德预设”向“社会环境逼迫与心理流变”的根本转变。"
  },
  {
    "id": 22,
    "start": 92.944,
    "end": 97.424,
    "text": "《三国演义》中的主要人物性格在登场伊始便基本定型，"
  },
  {
    "id": 23,
    "start": 97.424,
    "end": 101.984,
    "text": "其命运演进主要受天命大势与政治军事对抗推动，"
  },
  {
    "id": 24,
    "start": 101.984,
    "end": 104.864,
    "text": "较少展现人物心理与性格的发展轨迹。"
  },
  {
    "id": 25,
    "start": 105.104,
    "end": 110.797,
    "text": "《水浒传》则首次将人物性格的生成与严酷的社会生存现实紧密咬合，"
  },
  {
    "id": 26,
    "start": 110.797,
    "end": 113.236,
    "text": "开创了“官逼民反”的写实机制。"
  },
  {
    "id": 27,
    "start": 113.236,
    "end": 116.693,
    "text": "最典型的例证便是林冲形象的动态发展。"
  },
  {
    "id": 28,
    "start": 116.693,
    "end": 121.776,
    "text": "作为八十万禁军教头，林冲起初具有极深厚的体制依附心理，"
  },
  {
    "id": 29,
    "start": 121.776,
    "end": 124.825,
    "text": "面对高衙内调戏爱妻一再忍气吞声，"
  },
  {
    "id": 30,
    "start": 124.825,
    "end": 130.721,
    "text": "发配沧州途中面对董超、薛霸的折磨甚至野猪林的残害依然逆来顺受，"
  },
  {
    "id": 31,
    "start": 130.721,
    "end": 134.381,
    "text": "直至风雪山神庙偶听陆谦密谋方彻底梦醒，"
  },
  {
    "id": 32,
    "start": 134.381,
    "end": 137.024,
    "text": "最终提刀手刃仇敌雪夜上梁山。"
  },
  {
    "id": 33,
    "start": 137.104,
    "end": 142.304,
    "text": "这种在恶劣社会环境与步步紧逼的生存危机中展开的心理流变，"
  },
  {
    "id": 34,
    "start": 142.304,
    "end": 145.184,
    "text": "赋予人物性格极强的现实逻辑力量。"
  },
  {
    "id": 35,
    "start": 145.424,
    "end": 152.544,
    "text": "第三，在描写手法与语言艺术上，《水浒传》摆脱了史传粗陈梗概的叙事惯性，"
  },
  {
    "id": 36,
    "start": 152.544,
    "end": 157.344,
    "text": "开创了精微生动的市井生活白描与高度个性化的人物口语。"
  },
  {
    "id": 37,
    "start": 157.504,
    "end": 161.478,
    "text": "《三国演义》的语言是文白相建的“浅近文言”，"
  },
  {
    "id": 38,
    "start": 161.478,
    "end": 164.984,
    "text": "叙事长于宏观排兵布阵与外交辞令，"
  },
  {
    "id": 39,
    "start": 164.984,
    "end": 167.789,
    "text": "微观日常生活细节较为简省。"
  },
  {
    "id": 40,
    "start": 167.789,
    "end": 172.23,
    "text": "《水浒传》则大量运用地道成熟的北方白话口语，"
  },
  {
    "id": 41,
    "start": 172.23,
    "end": 176.671,
    "text": "且人物语言完全切合其独特身份与性格气质。"
  },
  {
    "id": 42,
    "start": 176.671,
    "end": 180.644,
    "text": "比如李逵之粗豪质朴、鲁智深之嫉恶如仇、"
  },
  {
    "id": 43,
    "start": 180.644,
    "end": 184.384,
    "text": "武松之沉稳刚烈，其谈吐声口无一雷同。"
  },
  {
    "id": 44,
    "start": 184.464,
    "end": 189.504,
    "text": "同时，《水浒传》极其长于捕捉微观动作细节与环境氛围的渲染，"
  },
  {
    "id": 45,
    "start": 189.504,
    "end": 193.664,
    "text": "比如武松景阳冈打虎时对梢棒折断的动作捕捉、"
  },
  {
    "id": 46,
    "start": 193.664,
    "end": 197.504,
    "text": "林冲在风雪山神庙用大石“靠”住庙门等细节，"
  },
  {
    "id": 47,
    "start": 197.504,
    "end": 201.184,
    "text": "皆达到了形神兼备、如在目前的艺术境界。"
  },
  {
    "id": 48,
    "start": 201.184,
    "end": 204.064,
    "text": "综上所述，《水浒传》较之于《三国演义》，"
  },
  {
    "id": 49,
    "start": 204.064,
    "end": 208.784,
    "text": "完成了中国古典小说人物塑造从类型化向性格化、"
  },
  {
    "id": 50,
    "start": 208.784,
    "end": 214.544,
    "text": "从静态定型向动态流变、从史传演义向生活写实的全面跃迁。"
  },
  {
    "id": 51,
    "start": 214.784,
    "end": 218.384,
    "text": "这一突破深刻拓展了中国叙事文学的审美表现力，"
  },
  {
    "id": 52,
    "start": 218.384,
    "end": 223.984,
    "text": "为后世《金瓶梅》与《红楼梦》等世情写实小说的巅峰繁荣开辟了坚实的艺术道路。"
  }
]