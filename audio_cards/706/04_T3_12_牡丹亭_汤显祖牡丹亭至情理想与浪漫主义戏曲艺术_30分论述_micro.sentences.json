[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《牡丹亭》·汤显祖至情理想与浪漫主义戏曲艺术",
    "start": 0.134,
    "end": 4.946,
    "duration": 4.812
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "哲学宣言→梦幻冲突→曲辞风格→流脉影响：先从《题词》至情宣言定下“以情反理”魂魄，",
    "start": 5.386,
    "end": 14.438,
    "duration": 9.052
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再看杜丽娘死后为鬼自由、复生仍受礼教约束的“虚实双面”，",
    "start": 14.586,
    "end": 19.638,
    "duration": 5.052
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "接着赏《惊梦》与《闺塾》悲喜交映诗才，最后落到令《西厢》减价、滋养《长生》《红楼》。",
    "start": 19.866,
    "end": 26.838,
    "duration": 6.972
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "汤显祖《牡丹亭》为“临川四梦”代表作。",
    "start": 27.321,
    "end": 30.533,
    "duration": 3.212
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "晚明理学禁锢下，作者秉持“以情反理”，将民间还魂故事改写为礼赞青春自由的浪漫主义传奇。",
    "start": 30.811,
    "end": 39.703,
    "duration": 8.892
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 张扬“至情”理想、反拨“灭人欲”礼教",
    "start": 40.373,
    "end": 44.305,
    "duration": 3.932
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "《牡丹亭题词》：“情不知所起，一往而深。生者可以死，死可以生。生而不可与死，死而不可复生者，皆非情之至也。”",
    "start": 44.781,
    "end": 58.283,
    "duration": 13.502
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "杜丽娘由《闺塾》读《关雎》萌春，入园因情入梦而死，鬼身依柳梦梅复生，",
    "start": 58.669,
    "end": 65.694,
    "duration": 7.025
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "连跨贞节关、鬼门关与金阶，肯定自然欲求。",
    "start": 65.709,
    "end": 69.561,
    "duration": 3.852
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 梦境幽明交错世态、构建虚实冲突",
    "start": 70.024,
    "end": 74.116,
    "duration": 4.092
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "秉“梦中之情，何必非真”，借《惊梦》《冥判》《魂游》写幽冥自由；",
    "start": 74.644,
    "end": 81.296,
    "duration": 6.652
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "然复生即直言“鬼可虚情，人须实礼”，复归人间约束；",
    "start": 81.574,
    "end": 86.386,
    "duration": 4.812
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "以南安太守杜宝、迂腐陈最良对立春香、花神、胡判官，令浪漫深植真实矛盾。",
    "start": 86.914,
    "end": 95.726,
    "duration": 8.812
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 诗化典雅曲辞与悲喜交融风格",
    "start": 96.355,
    "end": 99.807,
    "duration": 3.452
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《惊梦》【皂罗袍】“原来姹紫嫣红开遍……良辰美景奈何天，赏心乐事谁家院”惜春叹命、动人心魄；",
    "start": 100.335,
    "end": 110.747,
    "duration": 10.412
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "融《闹殇》《写真》惨悲与《闺塾》春香、石道姑插科打诨，",
    "start": 111.249,
    "end": 117.181,
    "duration": 5.932
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "恰如王思任“笑者真笑，笑即有声；啼者真啼，啼即有泪”。",
    "start": 117.409,
    "end": 122.911,
    "duration": 5.502
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 开“临川派”主情先声、润泽清代剧与小说",
    "start": 123.526,
    "end": 128.498,
    "duration": 4.972
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "沈德符《万历野获编》记“家传户诵，几令《西厢》减价”，引领吴炳、孟称舜玉茗堂主情潮流；",
    "start": 129.025,
    "end": 137.597,
    "duration": 8.572
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "开启《长生殿》《桃花扇》，更令《红楼梦》第二十三回林黛玉闻“良辰美景”而心动神摇。",
    "start": 138.059,
    "end": 145.191,
    "duration": 7.132
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "汤显祖秉持“以情反理”，借杜丽娘死生奇幻与诗化曲辞冲破理学禁锢，",
    "start": 145.831,
    "end": 152.643,
    "duration": 6.812
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "融浪漫主义激情与世态讽刺为一炉，开“临川派”潮流并滋养《长生殿》《桃花扇》《红楼梦》。",
    "start": 152.871,
    "end": 160.243,
    "duration": 7.372
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：核心理论见《牡丹亭题词》“生者可以死，死可以生”；",
    "start": 160.905,
    "end": 166.677,
    "duration": 5.772
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "明代沈德符《万历野获编》载“几令《西厢》减价”，王思任评“笑者真笑……啼即有泪”。",
    "start": 167.035,
    "end": 174.087,
    "duration": 7.052
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背诵《牡丹亭题词》中对“至情”的经典论述？",
    "start": 174.757,
    "end": 179.409,
    "duration": 4.652
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释杜丽娘“鬼可虚情，人须实礼”与杜宝/陈最良代表的虚实冲突？",
    "start": 179.875,
    "end": 186.607,
    "duration": 6.732
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 列出王思任评语、沈德符记载与《红楼梦》第二十三回呼应细节？",
    "start": 187.135,
    "end": 193.387,
    "duration": 6.252
  }
]