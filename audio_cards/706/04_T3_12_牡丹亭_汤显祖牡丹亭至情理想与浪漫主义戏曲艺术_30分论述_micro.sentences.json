[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《牡丹亭》·汤显祖至情理想与浪漫主义戏曲艺术",
    "start": 0.354,
    "end": 4.446,
    "duration": 4.092
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "哲学宣言→梦幻冲突→曲辞风格→流脉影响：先从《题词》至情宣言定下“以情反理”魂魄，",
    "start": 5.494,
    "end": 14.226,
    "duration": 8.732
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再看杜丽娘死后为鬼自由、复生仍受礼教约束的“虚实双面”，",
    "start": 14.414,
    "end": 19.386,
    "duration": 4.972
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "接着赏《惊梦》与《闺塾》悲喜交映诗才，最后落到令《西厢》减价、滋养《长生》《红楼》。",
    "start": 19.614,
    "end": 26.786,
    "duration": 7.172
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "汤显祖《牡丹亭》为“临川四梦”代表作。",
    "start": 27.714,
    "end": 30.606,
    "duration": 2.892
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "晚明理学禁锢下，作者秉持“以情反理”，将民间还魂故事改写为礼赞青春自由的浪漫主义传奇。",
    "start": 31.574,
    "end": 39.826,
    "duration": 8.252
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 张扬“至情”理想、反拨“灭人欲”礼教",
    "start": 40.794,
    "end": 45.006,
    "duration": 4.212
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "《牡丹亭题词》：“情不知所起，一往而深。生者可以死，死可以生。生而不可与死，死而不可复生者，皆非情之至也。”",
    "start": 45.974,
    "end": 58.446,
    "duration": 12.472
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "杜丽娘由《闺塾》读《关雎》萌春，入园因情入梦而死，鬼身依柳梦梅复生，",
    "start": 59.414,
    "end": 67.106,
    "duration": 7.692
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "连跨贞节关、鬼门关与金阶，肯定自然欲求。",
    "start": 67.254,
    "end": 71.146,
    "duration": 3.892
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 梦境幽明交错世态、构建虚实冲突",
    "start": 72.154,
    "end": 76.046,
    "duration": 3.892
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "秉“梦中之情，何必非真”，借《惊梦》《冥判》《魂游》写幽冥自由；",
    "start": 77.094,
    "end": 84.066,
    "duration": 6.972
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "然复生即直言“鬼可虚情，人须实礼”，复归人间约束；",
    "start": 85.074,
    "end": 90.286,
    "duration": 5.212
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "以南安太守杜宝、迂腐陈最良对立春香、花神、胡判官，令浪漫深植真实矛盾。",
    "start": 90.814,
    "end": 99.066,
    "duration": 8.252
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 诗化典雅曲辞与悲喜交融风格",
    "start": 99.573,
    "end": 103.265,
    "duration": 3.692
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《惊梦》【皂罗袍】“原来姹紫嫣红开遍……良辰美景奈何天，赏心乐事谁家院”惜春叹命、动人心魄；",
    "start": 103.965,
    "end": 115.097,
    "duration": 11.132
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "融《闹殇》《写真》惨悲与《闺塾》春香、石道姑插科打诨，",
    "start": 116.065,
    "end": 122.317,
    "duration": 6.252
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "恰如王思任“笑者真笑，笑即有声；啼者真啼，啼即有泪”。",
    "start": 122.705,
    "end": 129.017,
    "duration": 6.312
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 开“临川派”主情先声、润泽清代剧与小说",
    "start": 129.649,
    "end": 134.181,
    "duration": 4.532
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "沈德符《万历野获编》记“家传户诵，几令《西厢》减价”，引领吴炳、孟称舜玉茗堂主情潮流；",
    "start": 135.189,
    "end": 143.281,
    "duration": 8.092
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "开启《长生殿》《桃花扇》，更令《红楼梦》第二十三回林黛玉闻“良辰美景”而心动神摇。",
    "start": 144.289,
    "end": 151.621,
    "duration": 7.332
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "汤显祖秉持“以情反理”，借杜丽娘死生奇幻与诗化曲辞冲破理学禁锢，",
    "start": 152.629,
    "end": 159.721,
    "duration": 7.092
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "融浪漫主义激情与世态讽刺为一炉，开“临川派”潮流并滋养《长生殿》《桃花扇》《红楼梦》。",
    "start": 160.069,
    "end": 167.521,
    "duration": 7.452
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：核心理论见《牡丹亭题词》“生者可以死，死可以生”；",
    "start": 168.529,
    "end": 174.061,
    "duration": 5.532
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "明代沈德符《万历野获编》载“几令《西厢》减价”，王思任评“笑者真笑……啼即有泪”。",
    "start": 175.029,
    "end": 182.241,
    "duration": 7.212
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背诵《牡丹亭题词》中对“至情”的经典论述？",
    "start": 183.209,
    "end": 188.021,
    "duration": 4.812
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释杜丽娘“鬼可虚情，人须实礼”与杜宝/陈最良代表的虚实冲突？",
    "start": 188.949,
    "end": 196.841,
    "duration": 7.892
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 列出王思任评语、沈德符记载与《红楼梦》第二十三回呼应细节？",
    "start": 197.809,
    "end": 205.221,
    "duration": 7.412
  }
]