[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "哲学宣言→梦幻冲突→曲辞风格→流脉影响：",
    "start": 0.0,
    "end": 4.44,
    "duration": 4.44
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先从《题词》至情宣言定下“以情反理”魂魄，",
    "start": 4.489,
    "end": 7.969,
    "duration": 3.48
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再看杜丽娘死后为鬼自由、复生仍受礼教约束的“虚实双面”，",
    "start": 8.419,
    "end": 13.379,
    "duration": 4.96
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "接着赏《惊梦》与《闺塾》悲喜交映诗才，",
    "start": 13.829,
    "end": 17.029,
    "duration": 3.2
  },
  {
    "id": "hook_c4",
    "dom_key": "hook_c4",
    "text": "最后落到令《西厢》减价、滋养《长生》《红楼》。",
    "start": 17.479,
    "end": 20.999,
    "duration": 3.52
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "汤显祖《牡丹亭》为“临川四梦”代表作。",
    "start": 21.449,
    "end": 24.409,
    "duration": 2.96
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "晚明理学禁锢下，作者秉持“以情反理”，",
    "start": 24.859,
    "end": 28.419,
    "duration": 3.56
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "将民间还魂故事改写为礼赞青春自由的浪漫主义传奇。",
    "start": 28.869,
    "end": 33.189,
    "duration": 4.32
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 张扬“至情”理想、反拨“灭人欲”礼教",
    "start": 33.719,
    "end": 37.159,
    "duration": 3.44
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "《牡丹亭题词》：“情不知所起，一往而深。",
    "start": 37.689,
    "end": 40.849,
    "duration": 3.16
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "生者可以死，死可以生。",
    "start": 41.299,
    "end": 43.819,
    "duration": 2.52
  },
  {
    "id": "sec0_step0_c2",
    "dom_key": "sec0_step0_c2",
    "text": "生而不可与死，死而不可复生者，皆非情之至也。”",
    "start": 44.269,
    "end": 48.669,
    "duration": 4.4
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "杜丽娘由《闺塾》读《关雎》萌春，入园因情入梦而死，鬼身依柳梦梅复生，",
    "start": 49.119,
    "end": 55.199,
    "duration": 6.08
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "连跨贞节关、鬼门关与金阶，肯定自然欲求。",
    "start": 55.649,
    "end": 59.769,
    "duration": 4.12
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 梦境幽明交错世态、构建虚实冲突",
    "start": 60.219,
    "end": 64.339,
    "duration": 4.12
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "秉“梦中之情，何必非真”，借《惊梦》《冥判》《魂游》写幽冥自由；",
    "start": 64.789,
    "end": 70.589,
    "duration": 5.8
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "然复生即直言“鬼可虚情，人须实礼”，复归人间约束；",
    "start": 71.039,
    "end": 75.479,
    "duration": 4.44
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "以南安太守杜宝、迂腐陈最良对立春香、花神、胡判官，",
    "start": 75.929,
    "end": 81.129,
    "duration": 5.2
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "令浪漫深植真实矛盾。",
    "start": 81.579,
    "end": 83.619,
    "duration": 2.04
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 诗化典雅曲辞与悲喜交融风格",
    "start": 84.149,
    "end": 87.709,
    "duration": 3.56
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《惊梦》【皂罗袍】“原来姹紫嫣红开遍……良辰美景奈何天，",
    "start": 88.159,
    "end": 92.439,
    "duration": 4.28
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "赏心乐事谁家院”惜春叹命、动人心魄；",
    "start": 92.889,
    "end": 96.209,
    "duration": 3.32
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "融《闹殇》《写真》惨悲与《闺塾》春香、石道姑插科打诨，",
    "start": 96.659,
    "end": 101.539,
    "duration": 4.88
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "恰如王思任“笑者真笑，笑即有声；",
    "start": 101.989,
    "end": 104.549,
    "duration": 2.56
  },
  {
    "id": "sec2_step1_c2",
    "dom_key": "sec2_step1_c2",
    "text": "啼者真啼，啼即有泪”。",
    "start": 105.079,
    "end": 107.159,
    "duration": 2.08
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 开“临川派”主情先声、润泽清代剧与小说",
    "start": 107.689,
    "end": 112.009,
    "duration": 4.32
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "沈德符《万历野获编》记“家传户诵，几令《西厢》减价”，",
    "start": 112.459,
    "end": 116.659,
    "duration": 4.2
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "引领吴炳、孟称舜玉茗堂主情潮流；",
    "start": 117.109,
    "end": 120.269,
    "duration": 3.16
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "开启《长生殿》《桃花扇》，",
    "start": 120.799,
    "end": 122.519,
    "duration": 1.72
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "更令《红楼梦》第二十三回林黛玉闻“良辰美景”而心动神摇。",
    "start": 122.969,
    "end": 127.569,
    "duration": 4.6
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "汤显祖秉持“以情反理”，借杜丽娘死生奇幻与诗化曲辞冲破理学禁锢，",
    "start": 128.019,
    "end": 133.859,
    "duration": 5.84
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "融浪漫主义激情与世态讽刺为一炉，",
    "start": 134.309,
    "end": 137.189,
    "duration": 2.88
  },
  {
    "id": "concl_c2",
    "dom_key": "concl_c2",
    "text": "开“临川派”潮流并滋养《长生殿》《桃花扇》《红楼梦》。",
    "start": 137.639,
    "end": 141.479,
    "duration": 3.84
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：核心理论见《牡丹亭题词》“生者可以死，死可以生”；",
    "start": 141.929,
    "end": 146.529,
    "duration": 4.6
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "明代沈德符《万历野获编》载“几令《西厢》减价”，",
    "start": 146.979,
    "end": 150.699,
    "duration": 3.72
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "王思任评“笑者真笑……啼即有泪”。",
    "start": 151.229,
    "end": 153.869,
    "duration": 2.64
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背诵《牡丹亭题词》中对“至情”的经典论述？",
    "start": 154.399,
    "end": 158.879,
    "duration": 4.48
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释杜丽娘“鬼可虚情，人须实礼”与杜宝/陈最良代表的虚实冲突？",
    "start": 159.329,
    "end": 165.889,
    "duration": 6.56
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 列出王思任评语、沈德符记载与《红楼梦》第二十三回呼应细节？",
    "start": 166.339,
    "end": 173.139,
    "duration": 6.8
  }
]