[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "《水浒传》·叙事结构与林冲人物塑造",
    "start": 0.134,
    "end": 3.219,
    "duration": 3.085
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "架构→纵深人物→横向对比→语言成熟：先用“单人传奇串联”解释百零八将如何聚义，",
    "start": 3.808,
    "end": 11.593,
    "duration": 7.785
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再深入写林冲由忍让到杀仇“逼上梁山”的性格发展弧线，继而横向比较鲁、武、李“同中有异”，",
    "start": 11.946,
    "end": 20.092,
    "duration": 8.146
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后点明北方白话口语成就的写人高度。",
    "start": 20.262,
    "end": 23.972,
    "duration": 3.71
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《水浒传》是中国第一部全面描写农民起义的长篇白话章回小说，揭示“官逼民反，乱自上作”。",
    "start": 24.559,
    "end": 32.397,
    "duration": 7.838
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "金圣叹赞其“文章不避重复，而自不重复”。",
    "start": 32.97,
    "end": 36.602,
    "duration": 3.632
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 单人传奇串联的链条式结构",
    "start": 37.176,
    "end": 40.235,
    "duration": 3.059
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "前七十回采用连环钩锁、百川入海的单线纵向链条式结构：集中数回专写一人传奇，",
    "start": 40.809,
    "end": 48.946,
    "duration": 8.137
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "被逼投山时顺势引出下一位，前人退居次席；",
    "start": 49.129,
    "end": 53.451,
    "duration": 4.322
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "鲁智深大闹野猪林、林冲风雪山神庙、杨志卖刀、武松景阳冈打虎，兼顾单篇紧凑与聚义宏阔。",
    "start": 54.038,
    "end": 64.141,
    "duration": 10.103
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 动态流动性：林冲的性格发展史",
    "start": 64.728,
    "end": 68.295,
    "duration": 3.567
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "摆脱说书人物静态定型，写出“豹子头林冲”在逼迫下的动态性格发展；",
    "start": 68.869,
    "end": 75.157,
    "duration": 6.288
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "①高衙内调戏时强忍退让→②误入白虎堂、野猪林仍幻想“重见天日”→③草料场起火，",
    "start": 75.744,
    "end": 86.42,
    "duration": 10.676
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "山神庙偷听陆谦密谋→④幻想彻底破灭，挺枪杀仇雪夜上梁山，揭示“逼上梁山”逻辑。",
    "start": 86.551,
    "end": 95.244,
    "duration": 8.693
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 相似冲突中“同而不同”的犯中求避",
    "start": 95.831,
    "end": 99.45,
    "duration": 3.619
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "善于相似冲突写活个性，金圣叹《读第五才子书法》赞“把一百八个人性格都写出来”；",
    "start": 100.024,
    "end": 107.444,
    "duration": 7.421
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "打虎：武松醉后神勇兼机敏沉着，李逵沂岭杀四虎则蛮力狂暴复仇；",
    "start": 108.018,
    "end": 115.661,
    "duration": 7.642
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "粗豪：鲁智深粗中有细、仗义疏财，李逵率真莽撞不顾法度。",
    "start": 115.961,
    "end": 121.65,
    "duration": 5.689
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 纯熟北方白话与传神动作写景",
    "start": 122.224,
    "end": 125.765,
    "duration": 3.541
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "从北方民间口语提炼洗练白话，做到“一样人，便还他一样说话”；",
    "start": 126.339,
    "end": 132.288,
    "duration": 5.949
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "写景如“那雪正下得紧”；",
    "start": 132.875,
    "end": 135.765,
    "duration": 2.89
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "写林冲山神庙搬大石靠门→听明阴谋→推石拽门→挺花枪拔刀杀敌，动作精准有力，标志古代白话小说语言成熟。",
    "start": 136.078,
    "end": 147.327,
    "duration": 11.249
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《水浒传》借单人传奇链条式结构、林冲由忍到反的动态演变、“同而不同”对比以及传神白话动作白描，",
    "start": 147.914,
    "end": 156.533,
    "duration": 8.619
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "标志古代白话英雄传奇全面成熟。",
    "start": 156.768,
    "end": 159.944,
    "duration": 3.176
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：金圣叹赞《水浒传》“文章不避重复，而自不重复”“一样人，便还他一样说话”，",
    "start": 160.531,
    "end": 168.109,
    "duration": 7.577
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "并赞“把一百八个人性格都写出来”。",
    "start": 168.305,
    "end": 171.038,
    "duration": 2.733
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 什么是《水浒》前七十回“链条式”百川入海结构？",
    "start": 171.599,
    "end": 176.65,
    "duration": 5.051
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 完整复述林冲“安于现状→野猪林→山神庙”四步心理流变？",
    "start": 177.237,
    "end": 183.486,
    "duration": 6.249
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 怎样用武松/李逵/鲁智深说明金圣叹“文章不避重复，而自不重复”？",
    "start": 184.073,
    "end": 191.872,
    "duration": 7.798
  }
]