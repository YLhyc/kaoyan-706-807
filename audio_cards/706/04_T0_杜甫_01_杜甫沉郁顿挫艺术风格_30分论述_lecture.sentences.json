[
  {
    "id": 1,
    "text": "全局宏观破题与立论逻辑。",
    "start": 0.16,
    "end": 2.64,
    "duration": 2.48
  },
  {
    "id": 2,
    "text": "在考场下笔之前，必须先在宏观上审清这道三十分大题的核心考核意图。",
    "start": 2.64,
    "end": 8.56,
    "duration": 5.92
  },
  {
    "id": 3,
    "text": "本题表面上考查一个四字美学风格，",
    "start": 8.56,
    "end": 11.44,
    "duration": 2.88
  },
  {
    "id": 4,
    "text": "本质上考查杜诗整体的艺术成就。",
    "start": 11.44,
    "end": 14.16,
    "duration": 2.72
  },
  {
    "id": 5,
    "text": "考场评分标准绝不满足于孤立解释词义，",
    "start": 14.16,
    "end": 17.44,
    "duration": 3.28
  },
  {
    "id": 6,
    "text": "而是要求答出该风格的生成机制与文本表现。",
    "start": 17.44,
    "end": 20.8,
    "duration": 3.36
  },
  {
    "id": 7,
    "text": "因此整道题的回答方向，必须确立为“由内向外、",
    "start": 21.04,
    "end": 25.04,
    "duration": 4.0
  },
  {
    "id": 8,
    "text": "由情到形、由微观技术到宏观意境”的因果推进。",
    "start": 25.04,
    "end": 29.04,
    "duration": 4.0
  },
  {
    "id": 9,
    "text": "整道大题在宏观上划分为五个有机递进的逻辑层次：第一层，",
    "start": 29.04,
    "end": 33.44,
    "duration": 4.4
  },
  {
    "id": 10,
    "text": "开篇破题，完成概念的学术定性、文献溯源与二元拆解。",
    "start": 33.44,
    "end": 37.84,
    "duration": 4.4
  },
  {
    "id": 11,
    "text": "第二层，下沉至思想内容，解释为何杜甫的内心情感会呈现出深沉郁积的状态。",
    "start": 37.84,
    "end": 44.0,
    "duration": 6.16
  },
  {
    "id": 12,
    "text": "第三层，推进至表达章法，解释沉重的情感如何通过跌宕反差的结构完成释放。",
    "start": 44.32,
    "end": 51.28,
    "duration": 6.96
  },
  {
    "id": 13,
    "text": "第四层，落地至文体体制，解释这种风格依靠怎样的律体声病作为物理支撑。",
    "start": 51.28,
    "end": 58.08,
    "duration": 6.8
  },
  {
    "id": 14,
    "text": "第五层，升华为审美意境，阐释意象的选择如何最终构筑出崇高悲壮的美学形态。",
    "start": 58.08,
    "end": 65.52,
    "duration": 7.44
  },
  {
    "id": 15,
    "text": "尾部收官，将结论放回文学史谱系，",
    "start": 65.76,
    "end": 69.04,
    "duration": 3.28
  },
  {
    "id": 16,
    "text": "交代中唐与两宋的流变传承。",
    "start": 69.04,
    "end": 71.68,
    "duration": 2.64
  },
  {
    "id": 17,
    "text": "这五个层次之间的内在逻辑是不可逆的因果链条：思想是源泉，",
    "start": 71.68,
    "end": 76.8,
    "duration": 5.12
  },
  {
    "id": 18,
    "text": "章法是通道，声律是载体，意境是风貌，",
    "start": 76.8,
    "end": 80.4,
    "duration": 3.6
  },
  {
    "id": 19,
    "text": "史学流变是最终定型。",
    "start": 80.4,
    "end": 82.56,
    "duration": 2.16
  },
  {
    "id": 20,
    "text": "理顺了宏观全局思路，接下来进入每一段的具体推导与逐句表述。",
    "start": 82.56,
    "end": 87.76,
    "duration": 5.2
  },
  {
    "id": 21,
    "text": "---。第",
    "start": 88.0,
    "end": 88.21,
    "duration": 0.21
  },
  {
    "id": 22,
    "text": "一段：首段破题与概念定性。",
    "start": 88.21,
    "end": 90.523,
    "duration": 2.313
  },
  {
    "id": 23,
    "text": "逐句因果推导与答题表述。",
    "start": 90.523,
    "end": 92.835,
    "duration": 2.312
  },
  {
    "id": 24,
    "text": "首句必须直击核心概念，绝不绕弯。",
    "start": 92.835,
    "end": 95.779,
    "duration": 2.944
  },
  {
    "id": 25,
    "text": "所以表述为：“沉郁顿挫”是杜甫诗歌最具代表性的主导美学风格。",
    "start": 95.779,
    "end": 101.245,
    "duration": 5.466
  },
  {
    "id": 26,
    "text": "次句紧承首句给出历史文献来源，证明概念的真实出处。",
    "start": 101.245,
    "end": 106.08,
    "duration": 4.835
  },
  {
    "id": 27,
    "text": "所以表述为：这一断语最早见于杜甫本人的《进雕赋表》。",
    "start": 106.24,
    "end": 110.96,
    "duration": 4.72
  },
  {
    "id": 28,
    "text": "说清楚概念出处后就要引入考研教材依据，",
    "start": 110.96,
    "end": 114.48,
    "duration": 3.52
  },
  {
    "id": 29,
    "text": "确立当代学术权威性。",
    "start": 114.48,
    "end": 116.32,
    "duration": 1.84
  },
  {
    "id": 30,
    "text": "因此表述为：袁行配《中国文学史》将其界定为杜诗艺术成就集大成的核心范畴。",
    "start": 116.32,
    "end": 122.56,
    "duration": 6.24
  },
  {
    "id": 31,
    "text": "第四句与第五句顺势将复合概念进行二元拆解，",
    "start": 122.56,
    "end": 126.32,
    "duration": 3.76
  },
  {
    "id": 32,
    "text": "分别定义内容层面的沉郁与形式层面的顿挫。",
    "start": 126.32,
    "end": 129.68,
    "duration": 3.36
  },
  {
    "id": 33,
    "text": "表述为：沉郁主要指思想内容的深广厚重与忧患深沉。",
    "start": 129.92,
    "end": 135.6,
    "duration": 5.68
  },
  {
    "id": 34,
    "text": "顿挫主要指情感表达的跌宕回折与声律结构的抑扬顿挫。",
    "start": 135.6,
    "end": 141.12,
    "duration": 5.52
  },
  {
    "id": 35,
    "text": "最后第六句迅速将二者辩证统一，指出内容与形式互为表里。",
    "start": 141.12,
    "end": 146.56,
    "duration": 5.44
  },
  {
    "id": 36,
    "text": "尾句自然收束为全文下行的过渡句。",
    "start": 146.56,
    "end": 149.68,
    "duration": 3.12
  },
  {
    "id": 37,
    "text": "表述为：二者互为表里，共同熔铸出杜诗沉厚苍凉而波澜壮阔的崇高美。",
    "start": 149.984,
    "end": 157.184,
    "duration": 7.2
  },
  {
    "id": 38,
    "text": "具体而言，杜诗的“沉郁顿挫”展现为以下四个核心维度：本段答题思路总结。",
    "start": 157.184,
    "end": 163.904,
    "duration": 6.72
  },
  {
    "id": 39,
    "text": "本段用六句话完成立论闭环：先直接给出主导美学风格的定性，",
    "start": 163.904,
    "end": 169.264,
    "duration": 5.36
  },
  {
    "id": 40,
    "text": "再以《进雕赋表》确立历史源头，随即锚定袁行配教材标准。",
    "start": 169.264,
    "end": 174.224,
    "duration": 4.96
  },
  {
    "id": 41,
    "text": "紧接着将概念精准拆解为思想内容与表现形式两个抓手，",
    "start": 174.464,
    "end": 179.024,
    "duration": 4.56
  },
  {
    "id": 42,
    "text": "最后以辩证统一与维度过渡收束，为下文四个维度的层层展开奠定了严谨规范的学术底色。",
    "start": 179.024,
    "end": 186.704,
    "duration": 7.68
  },
  {
    "id": 43,
    "text": "所以本段具体答题完整版为：“沉郁顿挫”是杜甫诗歌最具代表性的主导美学风格。",
    "start": 186.704,
    "end": 192.944,
    "duration": 6.24
  },
  {
    "id": 44,
    "text": "这一断语最早见于杜甫本人的《进雕赋表》。",
    "start": 193.264,
    "end": 197.104,
    "duration": 3.84
  },
  {
    "id": 45,
    "text": "袁行配《中国文学史》将其界定为杜诗艺术成就集大成的核心范畴。",
    "start": 197.104,
    "end": 202.464,
    "duration": 5.36
  },
  {
    "id": 46,
    "text": "沉郁主要指思想内容的深广厚重与忧患深沉。",
    "start": 202.464,
    "end": 206.384,
    "duration": 3.92
  },
  {
    "id": 47,
    "text": "顿挫主要指情感表达的跌宕回折与声律结构的抑扬顿挫。",
    "start": 206.384,
    "end": 211.584,
    "duration": 5.2
  },
  {
    "id": 48,
    "text": "二者互为表里，共同熔铸出杜诗沉厚苍凉而波澜壮阔的崇高美。",
    "start": 211.584,
    "end": 217.344,
    "duration": 5.76
  },
  {
    "id": 49,
    "text": "具体而言，杜诗的“沉郁顿挫”展现为以下四个核心维度：。",
    "start": 217.584,
    "end": 222.784,
    "duration": 5.2
  },
  {
    "id": 50,
    "text": "第二段：第一分论点，思想内容维度（情何以“沉”）。",
    "start": 222.784,
    "end": 227.184,
    "duration": 4.4
  },
  {
    "id": 51,
    "text": "逐句因果推导与答题表述。",
    "start": 227.184,
    "end": 229.744,
    "duration": 2.56
  },
  {
    "id": 52,
    "text": "承接首段内容决定形式的前提，第一分论点必须首先论证思想内容的“沉郁”。",
    "start": 229.744,
    "end": 235.744,
    "duration": 6.0
  },
  {
    "id": 53,
    "text": "首句必须直接揭示沉郁的哲学根源，",
    "start": 236.144,
    "end": 239.344,
    "duration": 3.2
  },
  {
    "id": 54,
    "text": "锁定其精神内核。",
    "start": 239.344,
    "end": 241.264,
    "duration": 1.92
  },
  {
    "id": 55,
    "text": "所以表述为：杜甫的“沉郁”，根植于儒家“仁民爱物”的博大胸襟。",
    "start": 241.264,
    "end": 246.954,
    "duration": 5.69
  },
  {
    "id": 56,
    "text": "次句紧承首句推导因果，既然是儒家爱民精神，",
    "start": 246.954,
    "end": 251.391,
    "duration": 4.437
  },
  {
    "id": 57,
    "text": "其情感就绝非个人私怨。",
    "start": 251.391,
    "end": 253.725,
    "duration": 2.334
  },
  {
    "id": 58,
    "text": "所以表述为：他绝不作一己之悲的狭隘感伤，",
    "start": 253.725,
    "end": 257.928,
    "duration": 4.203
  },
  {
    "id": 59,
    "text": "而是将个人命运深植于时代血泪之中。",
    "start": 257.928,
    "end": 261.664,
    "duration": 3.736
  },
  {
    "id": 60,
    "text": "第三句由此解释沉郁二字的字面心理成因，",
    "start": 261.744,
    "end": 265.744,
    "duration": 4.0
  },
  {
    "id": 61,
    "text": "说明装载全天下苦难的情感必然郁结难平。",
    "start": 265.744,
    "end": 269.984,
    "duration": 4.24
  },
  {
    "id": 62,
    "text": "所以表述为：由于其情感深厚博大且关涉天下苍生，",
    "start": 269.984,
    "end": 274.944,
    "duration": 4.96
  },
  {
    "id": 63,
    "text": "故而郁积于心、沉郁难平。",
    "start": 274.944,
    "end": 277.664,
    "duration": 2.72
  },
  {
    "id": 64,
    "text": "讲清机制后第四句必须引入时代文本铁证，",
    "start": 277.664,
    "end": 281.584,
    "duration": 3.92
  },
  {
    "id": 65,
    "text": "调取安史之乱前夕最具代表性的政治抒情诗。",
    "start": 281.584,
    "end": 285.504,
    "duration": 3.92
  },
  {
    "id": 66,
    "text": "所以表述为：正如天宝十四载所作的名篇《自京赴奉先县咏怀五百字》。",
    "start": 285.824,
    "end": 291.976,
    "duration": 6.152
  },
  {
    "id": 67,
    "text": "第五句直接引用原诗的核心爱民诗句。",
    "start": 291.976,
    "end": 295.527,
    "duration": 3.551
  },
  {
    "id": 68,
    "text": "所以表述为：诗中写道：“穷年忧黎元，",
    "start": 295.527,
    "end": 298.634,
    "duration": 3.107
  },
  {
    "id": 69,
    "text": "叹息肠内热”。",
    "start": 298.634,
    "end": 299.744,
    "duration": 1.11
  },
  {
    "id": 70,
    "text": "第六句紧跟微观文本分析，指出个人遭遇与天下关怀的强烈反差。",
    "start": 299.888,
    "end": 305.728,
    "duration": 5.84
  },
  {
    "id": 71,
    "text": "所以表述为：即便诗人自家幼子饥卒，",
    "start": 305.728,
    "end": 309.066,
    "duration": 3.338
  },
  {
    "id": 72,
    "text": "他心中所牵挂的依然是天下黎庶的生死。",
    "start": 309.066,
    "end": 312.828,
    "duration": 3.762
  },
  {
    "id": 73,
    "text": "第七句进一步引出该诗最具社会批判性的千古警句。",
    "start": 312.828,
    "end": 317.697,
    "duration": 4.869
  },
  {
    "id": 74,
    "text": "所以表述为：又如全诗的核心警句：“朱门酒肉臭，",
    "start": 317.697,
    "end": 321.902,
    "duration": 4.205
  },
  {
    "id": 75,
    "text": "路有冻死骨”。",
    "start": 321.902,
    "end": 323.008,
    "duration": 1.106
  },
  {
    "id": 76,
    "text": "第八句对该句进行思想定型，阐明其深刻的社会危机揭示。",
    "start": 323.088,
    "end": 328.528,
    "duration": 5.44
  },
  {
    "id": 77,
    "text": "所以表述为：诗人以震撼人心的贫富对立，",
    "start": 328.528,
    "end": 332.452,
    "duration": 3.924
  },
  {
    "id": 78,
    "text": "揭露了盛唐繁华表象下的残酷社会危机。",
    "start": 332.452,
    "end": 336.281,
    "duration": 3.829
  },
  {
    "id": 79,
    "text": "第九句收束全段，总结一己血泪升华为国家忧患正是沉郁的基石。",
    "start": 336.281,
    "end": 342.362,
    "duration": 6.081
  },
  {
    "id": 80,
    "text": "所以表述为：这种将一己血泪升华为国家忧患的情感厚度，",
    "start": 342.362,
    "end": 347.248,
    "duration": 4.886
  },
  {
    "id": 81,
    "text": "奠定了杜诗沉厚沉潜的思想基石。",
    "start": 347.248,
    "end": 350.288,
    "duration": 3.04
  },
  {
    "id": 82,
    "text": "本段答题思路总结。",
    "start": 350.288,
    "end": 351.968,
    "duration": 1.68
  },
  {
    "id": 83,
    "text": "本段严格遵循由理到诗的推进逻辑：从儒家仁民爱物的思想母体出发，",
    "start": 351.968,
    "end": 357.488,
    "duration": 5.52
  },
  {
    "id": 84,
    "text": "推导出时代血泪的情感属性；",
    "start": 357.488,
    "end": 359.728,
    "duration": 2.24
  },
  {
    "id": 85,
    "text": "接着解释郁积难平的心理状态，顺理成章调出《自京赴奉先县咏怀五百字》；",
    "start": 359.728,
    "end": 366.208,
    "duration": 6.48
  },
  {
    "id": 86,
    "text": "通过“自家幼子饥卒”与“叹息肠内热”的对照，",
    "start": 366.448,
    "end": 370.368,
    "duration": 3.92
  },
  {
    "id": 87,
    "text": "以及“朱门”与“冻死骨”的社会批判，",
    "start": 370.368,
    "end": 373.088,
    "duration": 2.72
  },
  {
    "id": 88,
    "text": "彻底坐实了杜诗在思想内容上的深广厚度。",
    "start": 373.088,
    "end": 377.008,
    "duration": 3.92
  },
  {
    "id": 89,
    "text": "所以本段具体答题完整版为：一、思想内容的“沉郁”：一己身世与时代苍生的悲敏交融。",
    "start": 377.008,
    "end": 384.928,
    "duration": 7.92
  },
  {
    "id": 90,
    "text": "杜甫的“沉郁”，根植于儒家“仁民爱物”的博大胸襟。",
    "start": 385.168,
    "end": 389.328,
    "duration": 4.16
  },
  {
    "id": 91,
    "text": "他绝不作一己之悲的狭隘感伤，而是将个人命运深植于时代血泪之中。",
    "start": 389.328,
    "end": 395.168,
    "duration": 5.84
  },
  {
    "id": 92,
    "text": "由于其情感深厚博大且关涉天下苍生，",
    "start": 395.168,
    "end": 398.928,
    "duration": 3.76
  },
  {
    "id": 93,
    "text": "故而郁积于心、沉郁难平。",
    "start": 398.928,
    "end": 401.488,
    "duration": 2.56
  },
  {
    "id": 94,
    "text": "正如天宝十四载所作的名篇《自京赴奉先县咏怀五百字》。",
    "start": 401.488,
    "end": 406.208,
    "duration": 4.72
  },
  {
    "id": 95,
    "text": "诗中写道：“穷年忧黎元，叹息肠内热”。",
    "start": 406.528,
    "end": 410.608,
    "duration": 4.08
  },
  {
    "id": 96,
    "text": "即便诗人自家幼子饥卒，他心中所牵挂的依然是天下黎庶的生死。",
    "start": 410.608,
    "end": 416.448,
    "duration": 5.84
  },
  {
    "id": 97,
    "text": "又如全诗的核心警句：“朱门酒肉臭，",
    "start": 416.448,
    "end": 420.048,
    "duration": 3.6
  },
  {
    "id": 98,
    "text": "路有冻死骨”。",
    "start": 420.048,
    "end": 421.568,
    "duration": 1.52
  },
  {
    "id": 99,
    "text": "诗人以震撼人心的贫富对立，揭露了盛唐繁华表象下的残酷社会危机。",
    "start": 421.568,
    "end": 427.808,
    "duration": 6.24
  },
  {
    "id": 100,
    "text": "这种将一己血泪升华为国家忧患的情感厚度，",
    "start": 428.128,
    "end": 432.128,
    "duration": 4.0
  },
  {
    "id": 101,
    "text": "奠定了杜诗沉厚沉潜的思想基石。。",
    "start": 432.128,
    "end": 435.328,
    "duration": 3.2
  },
  {
    "id": 102,
    "text": "第三段：第二分论点，情感表达维度（气何以“顿”）。",
    "start": 435.328,
    "end": 439.648,
    "duration": 4.32
  },
  {
    "id": 103,
    "text": "逐句因果推导与答题表述。",
    "start": 439.648,
    "end": 441.968,
    "duration": 2.32
  },
  {
    "id": 104,
    "text": "第二段讲透了情感的万钧之重，第三段必须解答这种情感如何被表达，",
    "start": 441.968,
    "end": 447.488,
    "duration": 5.52
  },
  {
    "id": 105,
    "text": "自然切入篇章的“顿挫”。",
    "start": 447.488,
    "end": 448.928,
    "duration": 1.44
  },
  {
    "id": 106,
    "text": "首句必须直截了当给出顿挫在章法上的形态定义。",
    "start": 449.296,
    "end": 453.216,
    "duration": 3.92
  },
  {
    "id": 107,
    "text": "所以表述为：杜甫的“顿挫”，体现为情感抒发时的百折千回与波澜起伏。",
    "start": 453.216,
    "end": 458.938,
    "duration": 5.722
  },
  {
    "id": 108,
    "text": "次句紧接着阐明顿挫的内在机制，情感越沉重越不能直白发泄。",
    "start": 458.938,
    "end": 464.294,
    "duration": 5.356
  },
  {
    "id": 109,
    "text": "所以表述为：杜甫胸怀千万重郁结，",
    "start": 464.294,
    "end": 467.178,
    "duration": 2.884
  },
  {
    "id": 110,
    "text": "但他绝不一泻无余地倾盆宣泄。",
    "start": 467.178,
    "end": 469.856,
    "duration": 2.678
  },
  {
    "id": 111,
    "text": "第三句指出实现顿挫的技术手段，依靠大开大合的结构反差来推进情感。",
    "start": 469.936,
    "end": 475.856,
    "duration": 5.92
  },
  {
    "id": 112,
    "text": "所以表述为：他善于借助反差极大的章法结构，",
    "start": 475.856,
    "end": 479.701,
    "duration": 3.845
  },
  {
    "id": 113,
    "text": "让诗情在剧烈震荡中层层推进。",
    "start": 479.701,
    "end": 482.363,
    "duration": 2.662
  },
  {
    "id": 114,
    "text": "第四句引入结构反差最典型的晚年登临名作作为论据。",
    "start": 482.363,
    "end": 487.072,
    "duration": 4.709
  },
  {
    "id": 115,
    "text": "所以表述为：正如其晚年登临名作《登岳阳楼》的篇章建构。",
    "start": 487.072,
    "end": 492.416,
    "duration": 5.344
  },
  {
    "id": 116,
    "text": "第五句先分析前半篇的极度蓄势，极力描摹浩瀚壮阔的自然图景。",
    "start": 492.416,
    "end": 498.416,
    "duration": 6.0
  },
  {
    "id": 117,
    "text": "所以表述为：前四句极力铺写吴楚东南彻、",
    "start": 498.416,
    "end": 502.656,
    "duration": 4.24
  },
  {
    "id": 118,
    "text": "乾坤日夜浮的壮阔浩渺气象。",
    "start": 502.656,
    "end": 505.776,
    "duration": 3.12
  },
  {
    "id": 119,
    "text": "第六句笔锋骤然逆转，指出后半篇笔力骤跌进入现实处境。",
    "start": 505.776,
    "end": 510.816,
    "duration": 5.04
  },
  {
    "id": 120,
    "text": "所以表述为：五六句笔锋骤然收缩，",
    "start": 511.216,
    "end": 514.53,
    "duration": 3.314
  },
  {
    "id": 121,
    "text": "跌入自身真实境遇：“亲朋无一字，",
    "start": 514.53,
    "end": 517.684,
    "duration": 3.154
  },
  {
    "id": 122,
    "text": "老病有孤舟”。",
    "start": 517.684,
    "end": 518.897,
    "duration": 1.213
  },
  {
    "id": 123,
    "text": "第七句剖析自然博大与身世凄凉撞击所产生的审美张力。",
    "start": 518.897,
    "end": 524.719,
    "duration": 5.822
  },
  {
    "id": 124,
    "text": "所以表述为：宏阔无垠的自然胜景与凄凉飘零的残躯形成强烈反差，",
    "start": 524.719,
    "end": 531.513,
    "duration": 6.794
  },
  {
    "id": 125,
    "text": "产生强烈的悲剧张力。",
    "start": 531.513,
    "end": 533.696,
    "duration": 2.183
  },
  {
    "id": 126,
    "text": "第八句追踪尾联，分析诗人并未沉溺私悲，",
    "start": 533.776,
    "end": 537.776,
    "duration": 4.0
  },
  {
    "id": 127,
    "text": "而是再次折向天下。",
    "start": 537.776,
    "end": 539.616,
    "duration": 1.84
  },
  {
    "id": 128,
    "text": "所以表述为：尾联以“凭轩涕泗流”再次跌宕回折，",
    "start": 539.616,
    "end": 544.576,
    "duration": 4.96
  },
  {
    "id": 129,
    "text": "将孤舟之悲汇入北望长安的家国忧思。",
    "start": 544.576,
    "end": 548.336,
    "duration": 3.76
  },
  {
    "id": 130,
    "text": "第九句收束全段，总结层层顿折运笔让情感爆发得更为深沉的艺术效果。",
    "start": 548.336,
    "end": 554.896,
    "duration": 6.56
  },
  {
    "id": 131,
    "text": "所以表述为：这种大开大合、层层顿折的运笔方式，",
    "start": 555.136,
    "end": 559.536,
    "duration": 4.4
  },
  {
    "id": 132,
    "text": "使诗歌情感因郁结受阻而爆发得更为深沉。",
    "start": 559.536,
    "end": 562.976,
    "duration": 3.44
  },
  {
    "id": 133,
    "text": "本段答题思路总结。",
    "start": 562.976,
    "end": 564.656,
    "duration": 1.68
  },
  {
    "id": 134,
    "text": "本段紧扣章法结构展开剖析：先明确否定了一泻无余的直抒胸臆，",
    "start": 564.656,
    "end": 569.536,
    "duration": 4.88
  },
  {
    "id": 135,
    "text": "确立了欲扬先抑的抑扬原则；",
    "start": 569.536,
    "end": 571.856,
    "duration": 2.32
  },
  {
    "id": 136,
    "text": "接着以《登岳阳楼》前半段乾坤日月的大境界，",
    "start": 571.856,
    "end": 575.136,
    "duration": 3.28
  },
  {
    "id": 137,
    "text": "与后半段老病孤舟的残败身世形成剧烈落差；",
    "start": 575.136,
    "end": 578.656,
    "duration": 3.52
  },
  {
    "id": 138,
    "text": "最后分析尾联北望长安的再度回折，",
    "start": 578.976,
    "end": 582.016,
    "duration": 3.04
  },
  {
    "id": 139,
    "text": "完美展现出篇章层层受阻、百折千回的顿挫机制。",
    "start": 582.016,
    "end": 586.736,
    "duration": 4.72
  },
  {
    "id": 140,
    "text": "所以本段具体答题完整版为：二、情感表达的“顿挫”：波澜跌宕的起伏脉络与欲抑先扬。",
    "start": 586.736,
    "end": 594.016,
    "duration": 7.28
  },
  {
    "id": 141,
    "text": "杜甫的“顿挫”，体现为情感抒发时的百折千回与波澜起伏。",
    "start": 594.016,
    "end": 598.816,
    "duration": 4.8
  },
  {
    "id": 142,
    "text": "杜甫胸怀千万重郁结，但他绝不一泻无余地倾盆宣泄。",
    "start": 599.136,
    "end": 604.256,
    "duration": 5.12
  },
  {
    "id": 143,
    "text": "他善于借助反差极大的章法结构，让诗情在剧烈震荡中层层推进。",
    "start": 604.544,
    "end": 610.864,
    "duration": 6.32
  },
  {
    "id": 144,
    "text": "正如其晚年登临名作《登岳阳楼》的篇章建构。",
    "start": 610.864,
    "end": 614.784,
    "duration": 3.92
  },
  {
    "id": 145,
    "text": "前四句极力铺写吴楚东南彻、乾坤日夜浮的壮阔浩渺气象。",
    "start": 614.784,
    "end": 620.544,
    "duration": 5.76
  },
  {
    "id": 146,
    "text": "五六句笔锋骤然收缩，跌入自身真实境遇：“亲朋无一字，",
    "start": 620.544,
    "end": 625.904,
    "duration": 5.36
  },
  {
    "id": 147,
    "text": "老病有孤舟”。",
    "start": 625.904,
    "end": 627.024,
    "duration": 1.12
  },
  {
    "id": 148,
    "text": "宏阔无垠的自然胜景与凄凉飘零的残躯形成强烈反差，",
    "start": 627.344,
    "end": 632.704,
    "duration": 5.36
  },
  {
    "id": 149,
    "text": "产生强烈的悲剧张力。",
    "start": 632.704,
    "end": 634.624,
    "duration": 1.92
  },
  {
    "id": 150,
    "text": "尾联以“凭轩涕泗流”再次跌宕回折，",
    "start": 634.624,
    "end": 638.304,
    "duration": 3.68
  },
  {
    "id": 151,
    "text": "将孤舟之悲汇入北望长安的家国忧思。",
    "start": 638.304,
    "end": 642.064,
    "duration": 3.76
  },
  {
    "id": 152,
    "text": "这种大开大合、层层顿折的运笔方式，",
    "start": 642.064,
    "end": 645.424,
    "duration": 3.36
  },
  {
    "id": 153,
    "text": "使诗歌情感因郁结受阻而爆发得更为深沉。",
    "start": 645.424,
    "end": 649.104,
    "duration": 3.68
  },
  {
    "id": 154,
    "text": "第四段：第三分论点，艺术载体维度（调何以“挫”）。",
    "start": 649.344,
    "end": 653.664,
    "duration": 4.32
  },
  {
    "id": 155,
    "text": "逐句因果推导与答题表述。",
    "start": 653.664,
    "end": 656.064,
    "duration": 2.4
  },
  {
    "id": 156,
    "text": "前两段解决了宏观的思想与章法，本段必须进一步下沉到诗歌体制与字句声律的物理形态。",
    "start": 656.064,
    "end": 663.904,
    "duration": 7.84
  },
  {
    "id": 157,
    "text": "首句确立分论点，指明沉郁顿挫必须依附于精审严密的格律技巧。",
    "start": 663.904,
    "end": 669.744,
    "duration": 5.84
  },
  {
    "id": 158,
    "text": "所以表述为：沉郁顿挫的艺术风格，",
    "start": 670.064,
    "end": 673.029,
    "duration": 2.965
  },
  {
    "id": 159,
    "text": "依托于杜甫极度严密精审的格律掌控。",
    "start": 673.029,
    "end": 676.482,
    "duration": 3.453
  },
  {
    "id": 160,
    "text": "次句明确指出承载这一风格的主体体裁是晚年七言律诗。",
    "start": 676.482,
    "end": 681.66,
    "duration": 5.178
  },
  {
    "id": 161,
    "text": "所以表述为：杜甫晚年以超拔的功力拓展了七言律诗的体制空间。",
    "start": 681.66,
    "end": 687.486,
    "duration": 5.826
  },
  {
    "id": 162,
    "text": "第三句点出杜律的核心突破，在于打破盛唐圆流而大量使用音律拗折。",
    "start": 687.486,
    "end": 693.744,
    "duration": 6.258
  },
  {
    "id": 163,
    "text": "所以表述为：他打破盛唐律诗流走圆转的常态，",
    "start": 693.904,
    "end": 698.261,
    "duration": 4.357
  },
  {
    "id": 164,
    "text": "大量使用音律拗折与声调起伏。",
    "start": 698.261,
    "end": 701.292,
    "duration": 3.031
  },
  {
    "id": 165,
    "text": "第四句调出古代诗论的最高定评，确立论据的范式地位。",
    "start": 701.292,
    "end": 706.655,
    "duration": 5.363
  },
  {
    "id": 166,
    "text": "所以表述为：明代胡应麟在《诗薮》中盛赞杜甫《登高》为“古今七言律第一”。",
    "start": 706.655,
    "end": 713.184,
    "duration": 6.529
  },
  {
    "id": 167,
    "text": "第五句引用名句汉联，展现开阔深邃的空间意象。",
    "start": 713.264,
    "end": 717.904,
    "duration": 4.64
  },
  {
    "id": 168,
    "text": "所以表述为：诗中名句“无边落木萧萧下，",
    "start": 717.904,
    "end": 721.946,
    "duration": 4.042
  },
  {
    "id": 169,
    "text": "不尽长江滚滚来”，意象苍茫深邃。",
    "start": 721.946,
    "end": 725.242,
    "duration": 3.296
  },
  {
    "id": 170,
    "text": "第六句咬合沉痛凝练的颈联，展现时间跨度下的衰老病躯。",
    "start": 725.242,
    "end": 731.326,
    "duration": 6.084
  },
  {
    "id": 171,
    "text": "所以表述为：颈联随之咬合：“万里悲秋常作客，",
    "start": 731.326,
    "end": 735.889,
    "duration": 4.563
  },
  {
    "id": 172,
    "text": "百年多病独登台”，字字沉痛凝练。",
    "start": 735.889,
    "end": 739.184,
    "duration": 3.295
  },
  {
    "id": 173,
    "text": "第七句从体制形式定型，指出八句皆对与声律拗救展现出的骨力。",
    "start": 739.264,
    "end": 745.824,
    "duration": 6.56
  },
  {
    "id": 174,
    "text": "所以表述为：全诗八句皆对，句法既精整严密，",
    "start": 745.824,
    "end": 750.064,
    "duration": 4.24
  },
  {
    "id": 175,
    "text": "又在声韵的拗救与对仗中显出苍劲骨力。",
    "start": 750.064,
    "end": 753.904,
    "duration": 3.84
  },
  {
    "id": 176,
    "text": "第八句完成声情同构的总结，指出声律的抑扬恰好对应了心境的沉郁难解，",
    "start": 753.904,
    "end": 760.464,
    "duration": 6.56
  },
  {
    "id": 177,
    "text": "实现了声情相生的完美契合。",
    "start": 760.464,
    "end": 762.864,
    "duration": 2.4
  },
  {
    "id": 178,
    "text": "所以表述为：声调的抑扬回环恰好对应着心境的沉郁难解，",
    "start": 762.864,
    "end": 768.032,
    "duration": 5.168
  },
  {
    "id": 179,
    "text": "实现了声情相生的完美契合。",
    "start": 768.032,
    "end": 770.672,
    "duration": 2.64
  },
  {
    "id": 180,
    "text": "本段答题思路总结。",
    "start": 770.672,
    "end": 772.512,
    "duration": 1.84
  },
  {
    "id": 181,
    "text": "本段完成了从宏观美学到微观声病的扎实落地：先点明晚年七律的核心载体地位，",
    "start": 772.512,
    "end": 779.232,
    "duration": 6.72
  },
  {
    "id": 182,
    "text": "指出杜诗以音律拗折取代盛唐圆转流走的关键变革；",
    "start": 779.232,
    "end": 783.392,
    "duration": 4.16
  },
  {
    "id": 183,
    "text": "随后引入胡应麟对《登高》的定评，",
    "start": 783.792,
    "end": 786.592,
    "duration": 2.8
  },
  {
    "id": 184,
    "text": "结合“八句皆对”的极度严密对仗与音调起伏，",
    "start": 786.592,
    "end": 790.592,
    "duration": 4.0
  },
  {
    "id": 185,
    "text": "透辟论证了声音节奏与内心情感的物理同构，",
    "start": 790.592,
    "end": 794.752,
    "duration": 4.16
  },
  {
    "id": 186,
    "text": "给整道大题提供了无可辩驳的技术证据。",
    "start": 794.752,
    "end": 798.272,
    "duration": 3.52
  },
  {
    "id": 187,
    "text": "所以本段具体答题完整版为：三、艺术载体的精严：拗折苍劲的律诗声律与炼字造句。",
    "start": 798.352,
    "end": 806.112,
    "duration": 7.76
  },
  {
    "id": 188,
    "text": "沉郁顿挫的艺术风格，依托于杜甫极度严密精审的格律掌控。",
    "start": 806.432,
    "end": 811.712,
    "duration": 5.28
  },
  {
    "id": 189,
    "text": "杜甫晚年以超拔的功力拓展了七言律诗的体制空间。",
    "start": 811.952,
    "end": 816.832,
    "duration": 4.88
  },
  {
    "id": 190,
    "text": "他打破盛唐律诗流走圆转的常态，大量使用音律拗折与声调起伏。",
    "start": 816.832,
    "end": 823.312,
    "duration": 6.48
  },
  {
    "id": 191,
    "text": "明代胡应麟在《诗薮》中盛赞杜甫《登高》为“古今七言律第一”。",
    "start": 823.312,
    "end": 828.752,
    "duration": 5.44
  },
  {
    "id": 192,
    "text": "诗中名句“无边落木萧萧下，不尽长江滚滚来”，",
    "start": 829.072,
    "end": 834.192,
    "duration": 5.12
  },
  {
    "id": 193,
    "text": "意象苍茫深邃。",
    "start": 834.192,
    "end": 836.192,
    "duration": 2.0
  },
  {
    "id": 194,
    "text": "颈联随之咬合：“万里悲秋常作客，",
    "start": 836.192,
    "end": 839.792,
    "duration": 3.6
  },
  {
    "id": 195,
    "text": "百年多病独登台”，字字沉痛凝练。",
    "start": 839.792,
    "end": 843.472,
    "duration": 3.68
  },
  {
    "id": 196,
    "text": "全诗八句皆对，句法既精整严密，又在声韵的拗救与对仗中显出苍劲骨力。",
    "start": 843.472,
    "end": 850.992,
    "duration": 7.52
  },
  {
    "id": 197,
    "text": "声调的抑扬回环恰好对应着心境的沉郁难解，",
    "start": 850.992,
    "end": 855.152,
    "duration": 4.16
  },
  {
    "id": 198,
    "text": "实现了声情相生的完美契合。",
    "start": 855.152,
    "end": 857.712,
    "duration": 2.56
  },
  {
    "id": 199,
    "text": "第五段：第四分论点，意象意境维度（境何以“阔”）。",
    "start": 858.032,
    "end": 862.192,
    "duration": 4.16
  },
  {
    "id": 200,
    "text": "逐句因果推导与答题表述。",
    "start": 862.192,
    "end": 864.672,
    "duration": 2.48
  },
  {
    "id": 201,
    "text": "在解决了意、法、律之后，本段需要将文本各要素升华为统一的视觉画面与审美意境。",
    "start": 864.672,
    "end": 872.112,
    "duration": 7.44
  },
  {
    "id": 202,
    "text": "首句立论，指出沉郁顿挫最终落实在意象与意境的营构之中。",
    "start": 872.112,
    "end": 877.392,
    "duration": 5.28
  },
  {
    "id": 203,
    "text": "所以表述为：沉郁顿挫的风格，最终落实在宏大沉郁的意象与意境创造之中。",
    "start": 877.792,
    "end": 885.152,
    "duration": 7.36
  },
  {
    "id": 204,
    "text": "次句分析杜甫独特的审美取向，说明他偏爱雄浑博大的苍茫意象。",
    "start": 885.152,
    "end": 891.152,
    "duration": 6.0
  },
  {
    "id": 205,
    "text": "所以表述为：杜甫极少选取纤巧柔媚的物象，",
    "start": 891.152,
    "end": 895.232,
    "duration": 4.08
  },
  {
    "id": 206,
    "text": "而偏爱天地、江河、孤舟、残月与秋风。",
    "start": 895.232,
    "end": 899.152,
    "duration": 3.92
  },
  {
    "id": 207,
    "text": "第三句调取江行漂泊时最具代表性的五言律诗名篇。",
    "start": 899.392,
    "end": 904.032,
    "duration": 4.64
  },
  {
    "id": 208,
    "text": "所以表述为：正如晚年行舟所作的《旅夜书怀》。",
    "start": 904.032,
    "end": 908.293,
    "duration": 4.261
  },
  {
    "id": 209,
    "text": "第四句剖析汉联的宏丽境界，呈现阔大无垠的宇宙空间。",
    "start": 908.293,
    "end": 913.841,
    "duration": 5.548
  },
  {
    "id": 210,
    "text": "所以表述为：诗中汉联描摹宏丽境界：“星垂平野阔，",
    "start": 913.841,
    "end": 918.666,
    "duration": 4.825
  },
  {
    "id": 211,
    "text": "月涌大江流”。",
    "start": 918.666,
    "end": 919.872,
    "duration": 1.206
  },
  {
    "id": 212,
    "text": "第五句翻出尾联的凄清图景，呈现微渺漂泊的个体生命。",
    "start": 919.952,
    "end": 924.512,
    "duration": 4.56
  },
  {
    "id": 213,
    "text": "所以表述为：尾联却骤然勾勒自身苍凉图景：“飘飘何所似，",
    "start": 924.976,
    "end": 930.007,
    "duration": 5.031
  },
  {
    "id": 214,
    "text": "天地一沙欧”。",
    "start": 930.007,
    "end": 931.115,
    "duration": 1.108
  },
  {
    "id": 215,
    "text": "第六句剖析宇宙辽阔与生命渺小碰撞产生的巨大审美张力。",
    "start": 931.115,
    "end": 936.65,
    "duration": 5.535
  },
  {
    "id": 216,
    "text": "所以表述为：浩瀚无垠的宇宙背景与孤独漂泊的渺小生命形成极大张力。",
    "start": 936.65,
    "end": 943.293,
    "duration": 6.643
  },
  {
    "id": 217,
    "text": "第七句得出美学总结，指出这些沉潜阔大的意象群共同构筑出崇高意境。",
    "start": 943.293,
    "end": 949.936,
    "duration": 6.643
  },
  {
    "id": 218,
    "text": "所以表述为：这些沉潜阔大的意象群落，",
    "start": 950.096,
    "end": 953.456,
    "duration": 3.36
  },
  {
    "id": 219,
    "text": "构筑出悲壮苍凉而又雄浑博大的崇高意境。",
    "start": 953.456,
    "end": 957.376,
    "duration": 3.92
  },
  {
    "id": 220,
    "text": "本段答题思路总结。",
    "start": 957.376,
    "end": 959.136,
    "duration": 1.76
  },
  {
    "id": 221,
    "text": "本段从微观文字跳升到宏观美学形态：先归纳杜甫排除纤巧、",
    "start": 959.136,
    "end": 964.176,
    "duration": 5.04
  },
  {
    "id": 222,
    "text": "专取大象的意象取向；",
    "start": 964.176,
    "end": 965.856,
    "duration": 1.68
  },
  {
    "id": 223,
    "text": "随后以《旅夜书怀》为例，将平野大江的无垠空间与一叶沙欧的孤独生命并置对撞；",
    "start": 965.856,
    "end": 971.776,
    "duration": 5.92
  },
  {
    "id": 224,
    "text": "借由这种强烈的空间张力，将沉郁顿挫的美学形态最终定型为具有崇高美感的苍凉雄浑之境。",
    "start": 972.016,
    "end": 980.256,
    "duration": 8.24
  },
  {
    "id": 225,
    "text": "所以本段具体答题完整版为：四、意象意境的营构：沉潜阔大的苍凉图景与雄深雅健。",
    "start": 980.256,
    "end": 987.936,
    "duration": 7.68
  },
  {
    "id": 226,
    "text": "沉郁顿挫的风格，最终落实在宏大沉郁的意象与意境创造之中。",
    "start": 987.936,
    "end": 993.056,
    "duration": 5.12
  },
  {
    "id": 227,
    "text": "杜甫极少选取纤巧柔媚的物象，而偏爱天地、",
    "start": 993.296,
    "end": 997.296,
    "duration": 4.0
  },
  {
    "id": 228,
    "text": "江河、孤舟、残月与秋风。",
    "start": 997.296,
    "end": 1000.016,
    "duration": 2.72
  },
  {
    "id": 229,
    "text": "正如晚年行舟所作的《旅夜书怀》。",
    "start": 1000.016,
    "end": 1003.056,
    "duration": 3.04
  },
  {
    "id": 230,
    "text": "诗中汉联描摹宏丽境界：“星垂平野阔，",
    "start": 1003.056,
    "end": 1006.976,
    "duration": 3.92
  },
  {
    "id": 231,
    "text": "月涌大江流”。",
    "start": 1006.976,
    "end": 1008.496,
    "duration": 1.52
  },
  {
    "id": 232,
    "text": "尾联却骤然勾勒自身苍凉图景：“飘飘何所似，",
    "start": 1008.496,
    "end": 1012.736,
    "duration": 4.24
  },
  {
    "id": 233,
    "text": "天地一沙欧”。",
    "start": 1012.736,
    "end": 1013.856,
    "duration": 1.12
  },
  {
    "id": 234,
    "text": "浩瀚无垠的宇宙背景与孤独漂泊的渺小生命形成极大张力。",
    "start": 1014.096,
    "end": 1019.296,
    "duration": 5.2
  },
  {
    "id": 235,
    "text": "这些沉潜阔大的意象群落，构筑出悲壮苍凉而又雄浑博大的崇高意境。。",
    "start": 1019.296,
    "end": 1025.776,
    "duration": 6.48
  },
  {
    "id": 236,
    "text": "第六段：尾段收官与文学史谱系闭环。",
    "start": 1025.776,
    "end": 1029.456,
    "duration": 3.68
  },
  {
    "id": 237,
    "text": "逐句因果推导与答题表述。",
    "start": 1029.456,
    "end": 1031.936,
    "duration": 2.48
  },
  {
    "id": 238,
    "text": "尾段作为、三十分大题的收官，必须将本题的艺术结论放回文学史纵向长河中检验。",
    "start": 1031.936,
    "end": 1038.256,
    "duration": 6.32
  },
  {
    "id": 239,
    "text": "首句高度综合前文四个分论点，将崇高人格与精湛技艺完整收拢。",
    "start": 1038.656,
    "end": 1044.816,
    "duration": 6.16
  },
  {
    "id": 240,
    "text": "所以表述为：综上所述，杜甫的“沉郁顿挫”实现了崇高人格与精湛技艺的完美熔铸。",
    "start": 1044.816,
    "end": 1052.576,
    "duration": 7.76
  },
  {
    "id": 241,
    "text": "次句确立其历史坐标，标志着古代现实主义与律体格律达到了最高峰。",
    "start": 1052.576,
    "end": 1058.336,
    "duration": 5.76
  },
  {
    "id": 242,
    "text": "所以表述为：它标志着中国古代现实主义诗歌与近体格律艺术攀上了最高峰。",
    "start": 1058.736,
    "end": 1065.554,
    "duration": 6.818
  },
  {
    "id": 243,
    "text": "第三句向中唐顺流推进，点出其对新乐府运动与韩孟诗派的直接启迪。",
    "start": 1065.554,
    "end": 1071.783,
    "duration": 6.229
  },
  {
    "id": 244,
    "text": "所以表述为：这一风格不仅直接催生了中唐白居易的新乐府运动与韩孟诗派。",
    "start": 1071.783,
    "end": 1078.656,
    "duration": 6.873
  },
  {
    "id": 245,
    "text": "第四句向两宋继续顺流推进，交代其在宋诗发展中的宗师地位。",
    "start": 1078.784,
    "end": 1084.784,
    "duration": 6.0
  },
  {
    "id": 246,
    "text": "所以表述为：在宋代更被苏轼、黄庭坚尊奉为百代宗师，",
    "start": 1084.784,
    "end": 1089.744,
    "duration": 4.96
  },
  {
    "id": 247,
    "text": "奠定了江西诗派的法门正统。",
    "start": 1089.744,
    "end": 1092.464,
    "duration": 2.72
  },
  {
    "id": 248,
    "text": "本段答题思路总结。",
    "start": 1092.464,
    "end": 1094.144,
    "duration": 1.68
  },
  {
    "id": 249,
    "text": "本段杜绝任何空洞的口号抒情，坚决走文学史谱系路线：先以两句话干脆利落地打包前面四个论述层次，",
    "start": 1094.144,
    "end": 1103.104,
    "duration": 8.96
  },
  {
    "id": 250,
    "text": "确立其现实主义与近体律诗的双重巅峰地位；",
    "start": 1103.104,
    "end": 1106.624,
    "duration": 3.52
  },
  {
    "id": 251,
    "text": "随后依次交代中唐韩孟新乐府，以及两宋苏黄江西诗派的承继流变，",
    "start": 1106.944,
    "end": 1112.464,
    "duration": 5.52
  },
  {
    "id": 252,
    "text": "让整道三十分大题在纵贯古今的文学史视野中完成毫无破绽的逻辑闭环。",
    "start": 1112.464,
    "end": 1118.704,
    "duration": 6.24
  },
  {
    "id": 253,
    "text": "所以本段具体答题完整版为：综上所述，",
    "start": 1118.704,
    "end": 1121.984,
    "duration": 3.28
  },
  {
    "id": 254,
    "text": "杜甫的“沉郁顿挫”实现了崇高人格与精湛技艺的完美熔铸。",
    "start": 1121.984,
    "end": 1126.544,
    "duration": 4.56
  },
  {
    "id": 255,
    "text": "它标志着中国古代现实主义诗歌与近体格律艺术攀上了最高峰。",
    "start": 1126.784,
    "end": 1132.304,
    "duration": 5.52
  },
  {
    "id": 256,
    "text": "这一风格不仅直接催生了中唐白居易的新乐府运动与韩孟诗派。",
    "start": 1132.304,
    "end": 1137.104,
    "duration": 4.8
  },
  {
    "id": 257,
    "text": "在宋代更被苏轼、黄庭坚尊奉为百代宗师，",
    "start": 1137.104,
    "end": 1140.784,
    "duration": 3.68
  },
  {
    "id": 258,
    "text": "奠定了江西诗派的法门正统。",
    "start": 1140.784,
    "end": 1143.664,
    "duration": 2.88
  },
  {
    "id": 259,
    "text": "--。整",
    "start": 1143.664,
    "end": 1143.824,
    "duration": 0.16
  },
  {
    "id": 260,
    "text": "道大题的内在逻辑链总括。",
    "start": 1143.824,
    "end": 1145.824,
    "duration": 2.0
  },
  {
    "id": 261,
    "text": "这道三十分大题的本质，是一场极度严密的逻辑推演。",
    "start": 1146.224,
    "end": 1150.704,
    "duration": 4.48
  },
  {
    "id": 262,
    "text": "整篇答卷从头到尾遵循着“由内向外、",
    "start": 1150.704,
    "end": 1154.064,
    "duration": 3.36
  },
  {
    "id": 263,
    "text": "由情到形、由微观到宏观、由文本到史学”的必然法则。",
    "start": 1154.064,
    "end": 1159.104,
    "duration": 5.04
  },
  {
    "id": 264,
    "text": "阅卷老师看到的绝不是散乱的答题点，",
    "start": 1159.104,
    "end": 1162.224,
    "duration": 3.12
  },
  {
    "id": 265,
    "text": "而是一条咬合紧密的因果长链：第一步是“立论定性”，",
    "start": 1162.224,
    "end": 1166.624,
    "duration": 4.4
  },
  {
    "id": 266,
    "text": "开门见山解决概念从哪里来、教材怎么定义。",
    "start": 1166.624,
    "end": 1170.544,
    "duration": 3.92
  },
  {
    "id": 267,
    "text": "第二步是“内心情感”，说明沉郁是杜甫装载了苍生之痛后的心理状态。",
    "start": 1170.544,
    "end": 1176.144,
    "duration": 5.6
  },
  {
    "id": 268,
    "text": "第三步是“篇章章法”，回答庞大的情感如何通过欲扬先抑的结构波澜释放。",
    "start": 1176.144,
    "end": 1182.064,
    "duration": 5.92
  },
  {
    "id": 269,
    "text": "第四步是“体制声律”，回答这种波澜靠什么字句音律作为物理载体。",
    "start": 1182.384,
    "end": 1188.384,
    "duration": 6.0
  },
  {
    "id": 270,
    "text": "第五步是“意象意境”，回答文本各要素最终升华为怎样的崇高视觉风貌。",
    "start": 1188.384,
    "end": 1194.944,
    "duration": 6.56
  },
  {
    "id": 271,
    "text": "第六步是“史学闭环”，把整篇结论收拢回中唐与两宋的文学传承长河。",
    "start": 1194.944,
    "end": 1201.344,
    "duration": 6.4
  },
  {
    "id": 272,
    "text": "这六步层层递进，前一步的结论必然成为后一步的前提。",
    "start": 1201.344,
    "end": 1205.744,
    "duration": 4.4
  },
  {
    "id": 273,
    "text": "你在考场上顺着因果关系顺流而下，",
    "start": 1206.064,
    "end": 1208.784,
    "duration": 2.72
  },
  {
    "id": 274,
    "text": "就能自然写出近千字的满分答卷。",
    "start": 1208.784,
    "end": 1211.024,
    "duration": 2.24
  }
]