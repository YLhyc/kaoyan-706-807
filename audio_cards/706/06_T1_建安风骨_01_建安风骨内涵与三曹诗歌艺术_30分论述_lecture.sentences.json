[
  {
    "id": 1,
    "text": "全局宏观破题与立论逻辑。",
    "start": 0.16,
    "end": 2.8,
    "duration": 2.64
  },
  {
    "id": 2,
    "text": "在考场下笔之前，必须先在宏观上审清这道三十分大题的核心考核意图。",
    "start": 2.8,
    "end": 9.36,
    "duration": 6.56
  },
  {
    "id": 3,
    "text": "本题表面上考查建安时期的诗风，本质上考查中国文学走向自觉时期的精神内核与文体突破。",
    "start": 9.36,
    "end": 17.52,
    "duration": 8.16
  },
  {
    "id": 4,
    "text": "考场评分标准绝不满足于仅孤立背诵慷慨悲凉四个字。",
    "start": 17.52,
    "end": 22.0,
    "duration": 4.48
  },
  {
    "id": 5,
    "text": "答题方向必须确立为“从汉末大乱与士人自觉的时代动因，",
    "start": 22.24,
    "end": 27.28,
    "duration": 5.04
  },
  {
    "id": 6,
    "text": "推进到曹操古直悲凉的开河气魄，再深入到曹植文质兼备的前后期流变，",
    "start": 27.28,
    "end": 33.44,
    "duration": 6.16
  },
  {
    "id": 7,
    "text": "最终落地至曹丕七言创新与文学史风骨传承”的因果演进。",
    "start": 33.44,
    "end": 38.32,
    "duration": 4.88
  },
  {
    "id": 8,
    "text": "整道大题在宏观上划分为五个有机递进的逻辑层次：第一层，",
    "start": 38.32,
    "end": 43.2,
    "duration": 4.88
  },
  {
    "id": 9,
    "text": "开篇破题，借鲁迅“文学自觉时代”定论与刘协《文心雕龙》，",
    "start": 43.2,
    "end": 48.08,
    "duration": 4.88
  },
  {
    "id": 10,
    "text": "确立建安风骨的崇高美学坐标。",
    "start": 48.08,
    "end": 50.64,
    "duration": 2.56
  },
  {
    "id": 11,
    "text": "第二层，论述时代机制，剖析乱世大难催生的生命短促之悲，",
    "start": 50.64,
    "end": 55.44,
    "duration": 4.8
  },
  {
    "id": 12,
    "text": "与建功立业刚健抱负的内在熔铸。",
    "start": 55.44,
    "end": 58.16,
    "duration": 2.72
  },
  {
    "id": 13,
    "text": "第三层，论述领袖曹操，以《短歌行》 《观沧海》为例，",
    "start": 58.16,
    "end": 62.16,
    "duration": 4.0
  },
  {
    "id": 14,
    "text": "阐释政治家博大眼界熔铸出的“古直悲凉”。",
    "start": 62.16,
    "end": 65.52,
    "duration": 3.36
  },
  {
    "id": 15,
    "text": "第四层，论述集大成者曹植，剖析前后期身世激变，",
    "start": 65.84,
    "end": 70.48,
    "duration": 4.64
  },
  {
    "id": 16,
    "text": "阐释“骨气奇高、辞采华茂”的五言典范。",
    "start": 70.48,
    "end": 74.08,
    "duration": 3.6
  },
  {
    "id": 17,
    "text": "第五层，兼顾曹丕与七子蔡琰，阐释燕歌行七言开创、",
    "start": 74.08,
    "end": 78.96,
    "duration": 4.88
  },
  {
    "id": 18,
    "text": "七哀诗纪实与悲愤诗长篇叙事的多元共振。",
    "start": 78.96,
    "end": 82.56,
    "duration": 3.6
  },
  {
    "id": 19,
    "text": "尾部收官，将结论放回文学史谱系，",
    "start": 82.56,
    "end": 85.44,
    "duration": 2.88
  },
  {
    "id": 20,
    "text": "交代其作为反抗六朝靡丽旗帜、直接孕育盛唐气象的深远意义。",
    "start": 85.44,
    "end": 90.56,
    "duration": 5.12
  },
  {
    "id": 21,
    "text": "这五个层次构成一条不可逆的因果链条：乱世自觉是土壤，",
    "start": 90.8,
    "end": 96.16,
    "duration": 5.36
  },
  {
    "id": 22,
    "text": "时代忧患是风，俊爽质力是骨，三曹演进是血肉，",
    "start": 96.16,
    "end": 100.8,
    "duration": 4.64
  },
  {
    "id": 23,
    "text": "盛唐承续是历史定型。",
    "start": 100.8,
    "end": 103.2,
    "duration": 2.4
  },
  {
    "id": 24,
    "text": "理顺了宏观全局思路，接下来进入每一段的具体推导与逐句表述。",
    "start": 103.2,
    "end": 109.36,
    "duration": 6.16
  },
  {
    "id": 25,
    "text": "--。第",
    "start": 109.36,
    "end": 109.6,
    "duration": 0.24
  },
  {
    "id": 26,
    "text": "一段：首段破题与概念定性。",
    "start": 109.6,
    "end": 112.16,
    "duration": 2.56
  },
  {
    "id": 27,
    "text": "逐句因果推导与答题表述。",
    "start": 112.4,
    "end": 115.04,
    "duration": 2.64
  },
  {
    "id": 28,
    "text": "首句必须直击核心地位，确立建安时期在古代文学发展史上的转折性意义。",
    "start": 115.04,
    "end": 121.36,
    "duration": 6.32
  },
  {
    "id": 29,
    "text": "所以表述为：汉末建安时期是中国文学史上极具划时代意义的觉醒期。",
    "start": 121.36,
    "end": 127.6,
    "duration": 6.24
  },
  {
    "id": 30,
    "text": "次句必须引入鲁迅对于建安文学最具定论性的权威概括。",
    "start": 127.6,
    "end": 132.24,
    "duration": 4.64
  },
  {
    "id": 31,
    "text": "所以表述为：鲁迅在《魏晋风度及文章与药及酒之关系》中，",
    "start": 132.56,
    "end": 137.4,
    "duration": 4.84
  },
  {
    "id": 32,
    "text": "将该时期确立为“文学的自觉时代”。",
    "start": 137.4,
    "end": 140.378,
    "duration": 2.978
  },
  {
    "id": 33,
    "text": "第三句指出这一时期最核心的美学旗帜正是建安风骨。",
    "start": 140.378,
    "end": 145.271,
    "duration": 4.893
  },
  {
    "id": 34,
    "text": "所以表述为：“建安风骨”则是这一时期文学成就集大成的核心美学风貌。",
    "start": 145.271,
    "end": 151.44,
    "duration": 6.169
  },
  {
    "id": 35,
    "text": "第四句引入古代文论宗师刘协在《文心雕龙》中的经典两分法定义。",
    "start": 151.568,
    "end": 157.328,
    "duration": 5.76
  },
  {
    "id": 36,
    "text": "所以表述为：刘协在《文心雕龙•风骨》中精辟界定：“情之待风，",
    "start": 157.328,
    "end": 162.128,
    "duration": 4.8
  },
  {
    "id": 37,
    "text": "如形之包气；",
    "start": 162.128,
    "end": 163.648,
    "duration": 1.52
  },
  {
    "id": 38,
    "text": "辞之待骨，如体之树骸”。",
    "start": 163.648,
    "end": 165.808,
    "duration": 2.16
  },
  {
    "id": 39,
    "text": "第五句引入考研权威教材的学术界定，",
    "start": 165.808,
    "end": 168.688,
    "duration": 2.88
  },
  {
    "id": 40,
    "text": "明确风与骨的有机结合内涵。",
    "start": 168.688,
    "end": 171.088,
    "duration": 2.4
  },
  {
    "id": 41,
    "text": "所以表述为：袁行配《中国文学史》指出，",
    "start": 171.488,
    "end": 174.547,
    "duration": 3.059
  },
  {
    "id": 42,
    "text": "建安风骨是充沛激昂的政治情志与劲健刚拔的语言质力的完美融合。",
    "start": 174.547,
    "end": 180.553,
    "duration": 6.006
  },
  {
    "id": 43,
    "text": "第六句作为首段过渡句，宣告下文将从四个核心维度展开系统剖析。",
    "start": 180.553,
    "end": 186.352,
    "duration": 5.799
  },
  {
    "id": 44,
    "text": "所以表述为：其深厚的历史内涵与三曹诗歌的艺术探索，",
    "start": 186.352,
    "end": 191.116,
    "duration": 4.764
  },
  {
    "id": 45,
    "text": "主要展现在以下四个核心维度：本段答题思路总结。",
    "start": 191.116,
    "end": 195.568,
    "duration": 4.452
  },
  {
    "id": 46,
    "text": "本段用六句话完成立论闭环：先直接亮出文学自觉时代的高耸坐标；",
    "start": 195.568,
    "end": 200.688,
    "duration": 5.12
  },
  {
    "id": 47,
    "text": "随后调引鲁迅与刘协《文心雕龙》关于风与骨的经典论断；",
    "start": 200.688,
    "end": 205.088,
    "duration": 4.4
  },
  {
    "id": 48,
    "text": "紧接着借助袁行配教材将抽象概念坐实为政治情操与语言质力的熔铸；",
    "start": 205.088,
    "end": 211.168,
    "duration": 6.08
  },
  {
    "id": 49,
    "text": "最后自然引出四个分论点，开篇严谨规范。",
    "start": 211.168,
    "end": 214.368,
    "duration": 3.2
  },
  {
    "id": 50,
    "text": "所以本段具体答题完整版为：汉末建安时期是中国文学史上极具划时代意义的觉醒期。",
    "start": 214.688,
    "end": 222.528,
    "duration": 7.84
  },
  {
    "id": 51,
    "text": "鲁迅在《魏晋风度及文章与药及酒之关系》中，",
    "start": 222.528,
    "end": 226.448,
    "duration": 3.92
  },
  {
    "id": 52,
    "text": "将该时期确立为“文学的自觉时代”。",
    "start": 226.448,
    "end": 229.488,
    "duration": 3.04
  },
  {
    "id": 53,
    "text": "“建安风骨”则是这一时期文学成就集大成的核心美学风貌。",
    "start": 229.488,
    "end": 234.368,
    "duration": 4.88
  },
  {
    "id": 54,
    "text": "刘协在《文心雕龙•风骨》中精辟界定：“情之待风，",
    "start": 234.608,
    "end": 238.528,
    "duration": 3.92
  },
  {
    "id": 55,
    "text": "如形之包气；",
    "start": 238.528,
    "end": 240.128,
    "duration": 1.6
  },
  {
    "id": 56,
    "text": "辞之待骨，如体之树骸”。",
    "start": 240.128,
    "end": 242.528,
    "duration": 2.4
  },
  {
    "id": 57,
    "text": "袁行配《中国文学史》指出，建安风骨是充沛激昂的政治情志与劲健刚拔的语言质力的完美融合。",
    "start": 242.528,
    "end": 250.928,
    "duration": 8.4
  },
  {
    "id": 58,
    "text": "其深厚的历史内涵与三曹诗歌的艺术探索，",
    "start": 250.928,
    "end": 254.608,
    "duration": 3.68
  },
  {
    "id": 59,
    "text": "主要展现在以下四个核心维度：第二段：第一分论点，",
    "start": 254.608,
    "end": 259.568,
    "duration": 4.96
  },
  {
    "id": 60,
    "text": "时代悲剧与昂扬志向的交织（气之“烈”）。",
    "start": 259.568,
    "end": 263.568,
    "duration": 4.0
  },
  {
    "id": 61,
    "text": "逐句因果推导与答题表述。",
    "start": 263.568,
    "end": 266.448,
    "duration": 2.88
  },
  {
    "id": 62,
    "text": "论述建安风骨，必须首先回答其之所以形成的时代土壤与心理机制。",
    "start": 266.448,
    "end": 272.688,
    "duration": 6.24
  },
  {
    "id": 63,
    "text": "首句确立分论点，指出建安风骨植根于汉末军阀混战、",
    "start": 272.688,
    "end": 277.728,
    "duration": 5.04
  },
  {
    "id": 64,
    "text": "民不聊生的空前浩劫。",
    "start": 277.728,
    "end": 279.408,
    "duration": 1.68
  },
  {
    "id": 65,
    "text": "所以表述为：建安风骨的形成根植于东汉末年军阀割据、",
    "start": 279.728,
    "end": 284.63,
    "duration": 4.902
  },
  {
    "id": 66,
    "text": "白骨露野的空前历史浩劫。",
    "start": 284.63,
    "end": 287.001,
    "duration": 2.371
  },
  {
    "id": 67,
    "text": "次句推导因果，说明大动乱摧毁了虚伪经学教条，",
    "start": 287.001,
    "end": 291.312,
    "duration": 4.311
  },
  {
    "id": 68,
    "text": "唤醒了士人生命苦短的悲剧意识。",
    "start": 291.312,
    "end": 294.33,
    "duration": 3.018
  },
  {
    "id": 69,
    "text": "所以表述为：大动乱不仅粉碎了腐朽的汉代经学教条，",
    "start": 294.33,
    "end": 299.224,
    "duration": 4.894
  },
  {
    "id": 70,
    "text": "更唤醒了士人深沉的生命短促之悲。",
    "start": 299.224,
    "end": 302.984,
    "duration": 3.76
  },
  {
    "id": 71,
    "text": "第三句指出时代精神的积极面，士人并未陷入消极虚无，",
    "start": 302.984,
    "end": 308.104,
    "duration": 5.12
  },
  {
    "id": 72,
    "text": "而是渴望建功立业。",
    "start": 308.104,
    "end": 310.024,
    "duration": 1.92
  },
  {
    "id": 73,
    "text": "所以表述为：然而建安文人并未陷入消极颓废的虚无之中，",
    "start": 310.024,
    "end": 315.464,
    "duration": 5.44
  },
  {
    "id": 74,
    "text": "而是将其转化为建功立业的强烈渴望。",
    "start": 315.464,
    "end": 318.904,
    "duration": 3.44
  },
  {
    "id": 75,
    "text": "第四句结合曹操唯才是举的政策，说明士人阶层个性高扬、",
    "start": 319.144,
    "end": 324.009,
    "duration": 4.865
  },
  {
    "id": 76,
    "text": "争名于乱世。",
    "start": 324.009,
    "end": 325.028,
    "duration": 1.019
  },
  {
    "id": 77,
    "text": "所以表述为：曹操唯才是举打破世家垄断，",
    "start": 325.028,
    "end": 328.489,
    "duration": 3.461
  },
  {
    "id": 78,
    "text": "使广大士人阶层个性高扬，渴望在乱世留名青史。",
    "start": 328.489,
    "end": 332.562,
    "duration": 4.073
  },
  {
    "id": 79,
    "text": "第五句总结其双重情感结构，兼具民生忧患与平定天下的英雄豪情。",
    "start": 332.562,
    "end": 338.264,
    "duration": 5.702
  },
  {
    "id": 80,
    "text": "所以表述为：诗人们一方面深沉抚慰民生凋敝之痛，",
    "start": 338.424,
    "end": 343.224,
    "duration": 4.8
  },
  {
    "id": 81,
    "text": "一方面洋溢着削平天下、重整乾坤的慷慨豪情。",
    "start": 343.224,
    "end": 347.704,
    "duration": 4.48
  },
  {
    "id": 82,
    "text": "第六句收束全段，指出忧患深沉与刚健昂扬的统一正是建安风骨的独特底色。",
    "start": 347.704,
    "end": 354.744,
    "duration": 7.04
  },
  {
    "id": 83,
    "text": "所以表述为：这种忧患深沉与昂扬刚健的奇妙统一，",
    "start": 354.744,
    "end": 359.624,
    "duration": 4.88
  },
  {
    "id": 84,
    "text": "构成了建安风骨最独特的时代精神底色。",
    "start": 359.624,
    "end": 362.664,
    "duration": 3.04
  },
  {
    "id": 85,
    "text": "本段答题思路总结。",
    "start": 362.904,
    "end": 364.664,
    "duration": 1.76
  },
  {
    "id": 86,
    "text": "本段深入剖析文学风格背后的时代动力学：阐明汉末浩劫既带来了生命短促的悲怆，",
    "start": 364.664,
    "end": 371.864,
    "duration": 7.2
  },
  {
    "id": 87,
    "text": "更因曹操唯才是举激发了士人建功立业的热望；",
    "start": 371.864,
    "end": 375.544,
    "duration": 3.68
  },
  {
    "id": 88,
    "text": "透辟论证了建安文人如何将深沉的生命忧患转化为昂扬的时代豪情，",
    "start": 375.544,
    "end": 381.144,
    "duration": 5.6
  },
  {
    "id": 89,
    "text": "打破了悲凉即颓废的传统误解，为全篇确立了坚实的精神坐标。",
    "start": 381.144,
    "end": 385.864,
    "duration": 4.72
  },
  {
    "id": 90,
    "text": "所以本段具体答题完整版为：一、时代悲剧与昂扬志向的交织：建安风骨的历史成因与精神内核。",
    "start": 386.264,
    "end": 395.224,
    "duration": 8.96
  },
  {
    "id": 91,
    "text": "建安风骨的形成根植于东汉末年军阀割据、",
    "start": 395.224,
    "end": 398.984,
    "duration": 3.76
  },
  {
    "id": 92,
    "text": "白骨露野的空前历史浩劫。",
    "start": 398.984,
    "end": 401.704,
    "duration": 2.72
  },
  {
    "id": 93,
    "text": "大动乱不仅粉碎了腐朽的汉代经学教条，",
    "start": 401.704,
    "end": 404.984,
    "duration": 3.28
  },
  {
    "id": 94,
    "text": "更唤醒了士人深沉的生命短促之悲。",
    "start": 404.984,
    "end": 407.864,
    "duration": 2.88
  },
  {
    "id": 95,
    "text": "然而建安文人并未陷入消极颓废的虚无之中，",
    "start": 408.184,
    "end": 411.784,
    "duration": 3.6
  },
  {
    "id": 96,
    "text": "而是将其转化为建功立业的强烈渴望。",
    "start": 411.784,
    "end": 415.304,
    "duration": 3.52
  },
  {
    "id": 97,
    "text": "曹操唯才是举打破世家垄断，使广大士人阶层个性高扬，",
    "start": 415.304,
    "end": 420.344,
    "duration": 5.04
  },
  {
    "id": 98,
    "text": "渴望在乱世留名青史。",
    "start": 420.344,
    "end": 422.504,
    "duration": 2.16
  },
  {
    "id": 99,
    "text": "诗人们一方面深沉抚慰民生凋敝之痛，",
    "start": 422.504,
    "end": 425.944,
    "duration": 3.44
  },
  {
    "id": 100,
    "text": "一方面洋溢着削平天下、重整乾坤的慷慨豪情。",
    "start": 425.944,
    "end": 430.024,
    "duration": 4.08
  },
  {
    "id": 101,
    "text": "这种忧患深沉与昂扬刚健的奇妙统一，",
    "start": 430.344,
    "end": 433.944,
    "duration": 3.6
  },
  {
    "id": 102,
    "text": "构成了建安风骨最独特的时代精神底色。。",
    "start": 433.944,
    "end": 437.544,
    "duration": 3.6
  },
  {
    "id": 103,
    "text": "第三段：第二分论点，曹操诗歌的开河博大（势之“沉”）。",
    "start": 437.544,
    "end": 442.824,
    "duration": 5.28
  },
  {
    "id": 104,
    "text": "逐句因果推导与答题表述。",
    "start": 442.824,
    "end": 445.544,
    "duration": 2.72
  },
  {
    "id": 105,
    "text": "第二段讲清了时代土壤，第三段必须正面论述建安文学领袖曹操的诗风。",
    "start": 445.544,
    "end": 451.544,
    "duration": 6.0
  },
  {
    "id": 106,
    "text": "首句确立分论点，指出曹操是集团领袖，",
    "start": 452.008,
    "end": 455.528,
    "duration": 3.52
  },
  {
    "id": 107,
    "text": "引用钟融在《诗品》中的千古定论。",
    "start": 455.528,
    "end": 458.408,
    "duration": 2.88
  },
  {
    "id": 108,
    "text": "所以表述为：曹操是建安文学集团的领袖与灵魂，",
    "start": 458.408,
    "end": 462.568,
    "duration": 4.16
  },
  {
    "id": 109,
    "text": "钟融在《诗品》中评其诗“曹公古直，",
    "start": 462.568,
    "end": 465.928,
    "duration": 3.36
  },
  {
    "id": 110,
    "text": "甚有悲凉之句”。",
    "start": 465.928,
    "end": 467.528,
    "duration": 1.6
  },
  {
    "id": 111,
    "text": "次句指出其文体突破，说明他借汉乐府旧题直面书写当代重大时事。",
    "start": 467.528,
    "end": 473.368,
    "duration": 5.84
  },
  {
    "id": 112,
    "text": "所以表述为：曹操打破了汉代民间乐府的限制，",
    "start": 473.688,
    "end": 477.608,
    "duration": 3.92
  },
  {
    "id": 113,
    "text": "开创了借乐府旧题直面书写当代时事的宏大范式。",
    "start": 477.608,
    "end": 482.648,
    "duration": 5.04
  },
  {
    "id": 114,
    "text": "第三句调取表现民生凋敝的著名诗史名篇《蒿里行》四句原句。",
    "start": 482.648,
    "end": 487.928,
    "duration": 5.28
  },
  {
    "id": 115,
    "text": "所以表述为：在《蒿里行》中，他直笔揭露战乱惨景：“白骨露于野，",
    "start": 487.928,
    "end": 493.768,
    "duration": 5.84
  },
  {
    "id": 116,
    "text": "千里无鸡鸣。",
    "start": 493.768,
    "end": 495.048,
    "duration": 1.28
  },
  {
    "id": 117,
    "text": "生民百遗一，念之断人肠”。",
    "start": 495.448,
    "end": 498.488,
    "duration": 3.04
  },
  {
    "id": 118,
    "text": "第四句调取代表作《短歌行》，说明其面对人生苦短最终落脚于天下归心。",
    "start": 498.488,
    "end": 505.128,
    "duration": 6.64
  },
  {
    "id": 119,
    "text": "所以表述为：在名作《短歌行》中，",
    "start": 505.128,
    "end": 507.768,
    "duration": 2.64
  },
  {
    "id": 120,
    "text": "他感慨人生如朝露，但最终落脚于“周公吐哺，",
    "start": 507.768,
    "end": 511.768,
    "duration": 4.0
  },
  {
    "id": 121,
    "text": "天下归心”的宏伟抱负。",
    "start": 511.768,
    "end": 513.608,
    "duration": 1.84
  },
  {
    "id": 122,
    "text": "第五句调取宇宙胸襟名篇《观沧海》，",
    "start": 513.608,
    "end": 516.648,
    "duration": 3.04
  },
  {
    "id": 123,
    "text": "展现包罗日月的宏伟格局。",
    "start": 516.648,
    "end": 518.728,
    "duration": 2.08
  },
  {
    "id": 124,
    "text": "所以表述为：更为壮阔的是在《观沧海》中，",
    "start": 519.048,
    "end": 522.528,
    "duration": 3.48
  },
  {
    "id": 125,
    "text": "描摹“日月之行，若出其中；",
    "start": 522.528,
    "end": 524.741,
    "duration": 2.213
  },
  {
    "id": 126,
    "text": "星汉灿烂，若出其里”。",
    "start": 524.741,
    "end": 526.511,
    "duration": 1.77
  },
  {
    "id": 127,
    "text": "第六句总结本段，指出曹操以统帅胸襟入诗，",
    "start": 526.511,
    "end": 530.495,
    "duration": 3.984
  },
  {
    "id": 128,
    "text": "奠定了建安风骨的雄浑根基。",
    "start": 530.495,
    "end": 533.15,
    "duration": 2.655
  },
  {
    "id": 129,
    "text": "所以表述为：曹操以统帅与政治家的博大胸襟入诗，",
    "start": 533.15,
    "end": 537.798,
    "duration": 4.648
  },
  {
    "id": 130,
    "text": "使诗歌气吞山河、苍茫深邃，奠定了建安风骨的骨力根基。",
    "start": 537.798,
    "end": 542.888,
    "duration": 5.09
  },
  {
    "id": 131,
    "text": "本段答题思路总结。",
    "start": 542.968,
    "end": 544.568,
    "duration": 1.6
  },
  {
    "id": 132,
    "text": "本段聚焦于建安风骨的开创奠基：以钟融“古直悲凉”为核心抓手；",
    "start": 544.568,
    "end": 549.848,
    "duration": 5.28
  },
  {
    "id": 133,
    "text": "先后剖析《蒿里行》抚慰生民的悲歌、",
    "start": 549.848,
    "end": 552.808,
    "duration": 2.96
  },
  {
    "id": 134,
    "text": "《短歌行》求贤若渴的霸气、以及《观沧海》气吞日月的大格局；",
    "start": 552.808,
    "end": 557.928,
    "duration": 5.12
  },
  {
    "id": 135,
    "text": "全面论证了曹操如何将政治家与军事家的恢弘气魄注入文学，",
    "start": 557.928,
    "end": 562.728,
    "duration": 4.8
  },
  {
    "id": 136,
    "text": "形成了大开大合、古朴质直的崇高范式。",
    "start": 562.728,
    "end": 565.848,
    "duration": 3.12
  },
  {
    "id": 137,
    "text": "所以本段具体答题完整版为：二、曹操诗歌的开河博大：以政治家眼界熔铸古直悲凉之境。",
    "start": 566.168,
    "end": 574.568,
    "duration": 8.4
  },
  {
    "id": 138,
    "text": "曹操是建安文学集团的领袖与灵魂，",
    "start": 574.568,
    "end": 577.688,
    "duration": 3.12
  },
  {
    "id": 139,
    "text": "钟融在《诗品》中评其诗“曹公古直，",
    "start": 577.688,
    "end": 580.968,
    "duration": 3.28
  },
  {
    "id": 140,
    "text": "甚有悲凉之句”。",
    "start": 580.968,
    "end": 582.408,
    "duration": 1.44
  },
  {
    "id": 141,
    "text": "曹操打破了汉代民间乐府的限制，开创了借乐府旧题直面书写当代时事的宏大范式。",
    "start": 582.408,
    "end": 589.288,
    "duration": 6.88
  },
  {
    "id": 142,
    "text": "在《蒿里行》中，他直笔揭露战乱惨景：“白骨露于野，",
    "start": 589.608,
    "end": 594.408,
    "duration": 4.8
  },
  {
    "id": 143,
    "text": "千里无鸡鸣。",
    "start": 594.408,
    "end": 595.928,
    "duration": 1.52
  },
  {
    "id": 144,
    "text": "生民百遗一，念之断人肠”。",
    "start": 595.928,
    "end": 598.568,
    "duration": 2.64
  },
  {
    "id": 145,
    "text": "在名作《短歌行》中，他感慨人生如朝露，",
    "start": 598.952,
    "end": 602.712,
    "duration": 3.76
  },
  {
    "id": 146,
    "text": "但最终落脚于“周公吐哺，天下归心”的宏伟抱负。",
    "start": 602.712,
    "end": 607.752,
    "duration": 5.04
  },
  {
    "id": 147,
    "text": "更为壮阔的是在《观沧海》中，描摹“日月之行，",
    "start": 607.752,
    "end": 612.072,
    "duration": 4.32
  },
  {
    "id": 148,
    "text": "若出其中；",
    "start": 612.072,
    "end": 613.272,
    "duration": 1.2
  },
  {
    "id": 149,
    "text": "星汉灿烂，若出其里”。",
    "start": 613.272,
    "end": 615.752,
    "duration": 2.48
  },
  {
    "id": 150,
    "text": "曹操以统帅与政治家的博大胸襟入诗，",
    "start": 615.752,
    "end": 619.272,
    "duration": 3.52
  },
  {
    "id": 151,
    "text": "使诗歌气吞山河、苍茫深邃，奠定了建安风骨的骨力根基。",
    "start": 619.272,
    "end": 624.792,
    "duration": 5.52
  },
  {
    "id": 152,
    "text": "第四段：第三分论点，曹植诗歌的文质兼备（格之“峻”）。",
    "start": 625.112,
    "end": 629.752,
    "duration": 4.64
  },
  {
    "id": 153,
    "text": "逐句因果推导与答题表述。",
    "start": 629.752,
    "end": 632.232,
    "duration": 2.48
  },
  {
    "id": 154,
    "text": "讲完曹操的大开大合，第四段必须攻克建安文学成就最高的集大成者曹植。",
    "start": 632.232,
    "end": 638.632,
    "duration": 6.4
  },
  {
    "id": 155,
    "text": "首句立论，指出曹植是集大成者，调取钟融在《诗品》中的至高评价。",
    "start": 638.632,
    "end": 644.232,
    "duration": 5.6
  },
  {
    "id": 156,
    "text": "所以表述为：曹植是建安文学成就最高的集大成者，",
    "start": 644.632,
    "end": 649.411,
    "duration": 4.779
  },
  {
    "id": 157,
    "text": "钟融在《诗品》中推为上品，盛赞其“骨气奇高，",
    "start": 649.411,
    "end": 653.336,
    "duration": 3.925
  },
  {
    "id": 158,
    "text": "辞采华茂”。",
    "start": 653.336,
    "end": 654.26,
    "duration": 0.924
  },
  {
    "id": 159,
    "text": "次句指出曹植创作以曹丕称帝为界，",
    "start": 654.26,
    "end": 657.724,
    "duration": 3.464
  },
  {
    "id": 160,
    "text": "呈现出鲜明的前后期飞跃。",
    "start": 657.724,
    "end": 660.264,
    "duration": 2.54
  },
  {
    "id": 161,
    "text": "所以表述为：曹植的创作以曹丕称帝为界，",
    "start": 660.264,
    "end": 664.19,
    "duration": 3.926
  },
  {
    "id": 162,
    "text": "呈现出极为鲜明的前后期飞跃。",
    "start": 664.19,
    "end": 667.192,
    "duration": 3.002
  },
  {
    "id": 163,
    "text": "第三句分析前期在邺下时诗风豪迈，",
    "start": 667.272,
    "end": 670.792,
    "duration": 3.52
  },
  {
    "id": 164,
    "text": "调取《白马篇》塑造的爱国游侠形象。",
    "start": 670.792,
    "end": 673.672,
    "duration": 2.88
  },
  {
    "id": 165,
    "text": "所以表述为：前期生活在邺下幕府，",
    "start": 673.672,
    "end": 676.872,
    "duration": 3.2
  },
  {
    "id": 166,
    "text": "诗风昂扬激越，在《白马篇》中塑造出“捐躯赴国难，",
    "start": 676.872,
    "end": 681.432,
    "duration": 4.56
  },
  {
    "id": 167,
    "text": "视死忽如归”的英勇游侠形象。",
    "start": 681.432,
    "end": 683.752,
    "duration": 2.32
  },
  {
    "id": 168,
    "text": "第四句分析后期惨遭猜忌软禁，诗风转入深沉悲愤与幽怨自怜。",
    "start": 683.752,
    "end": 689.192,
    "duration": 5.44
  },
  {
    "id": 169,
    "text": "所以表述为：后期曹植惨遭曹丕、曹瑞父子严酷的政治猜忌与软禁，",
    "start": 689.592,
    "end": 696.174,
    "duration": 6.582
  },
  {
    "id": 170,
    "text": "诗风转入悲愤幽怨与深沉自怜。",
    "start": 696.174,
    "end": 699.385,
    "duration": 3.211
  },
  {
    "id": 171,
    "text": "第五句列出代表名篇《野田黄雀行》与《赠白马王彪》的痛陈心曲。",
    "start": 699.385,
    "end": 705.559,
    "duration": 6.174
  },
  {
    "id": 172,
    "text": "所以表述为：在《野田黄雀行》中借黄雀被缚倾诉绝望，",
    "start": 705.559,
    "end": 710.746,
    "duration": 5.187
  },
  {
    "id": 173,
    "text": "在《赠白马王彪》中借远行诀别痛陈骨肉相残。",
    "start": 710.746,
    "end": 715.192,
    "duration": 4.446
  },
  {
    "id": 174,
    "text": "第六句总结本段，指出曹植将刚劲骨力与华美藻饰融为一体，",
    "start": 715.272,
    "end": 721.192,
    "duration": 5.92
  },
  {
    "id": 175,
    "text": "开辟了五言诗新典范。",
    "start": 721.192,
    "end": 723.192,
    "duration": 2.0
  },
  {
    "id": 176,
    "text": "所以表述为：曹植将建安风骨的刚劲骨力与华美藻饰完美融为一体，",
    "start": 723.192,
    "end": 729.512,
    "duration": 6.32
  },
  {
    "id": 177,
    "text": "开创了五言诗抒情的典范。",
    "start": 729.512,
    "end": 731.912,
    "duration": 2.4
  },
  {
    "id": 178,
    "text": "本段答题思路总结。",
    "start": 731.912,
    "end": 733.432,
    "duration": 1.52
  },
  {
    "id": 179,
    "text": "本段聚焦于建安诗歌的艺术巅峰：以钟融“骨气奇高、",
    "start": 733.808,
    "end": 738.688,
    "duration": 4.88
  },
  {
    "id": 180,
    "text": "辞采华茂”为纲；",
    "start": 738.688,
    "end": 740.208,
    "duration": 1.52
  },
  {
    "id": 181,
    "text": "清晰划分前期邺下任侠与后期幽禁忧缠的两大阶段；",
    "start": 740.208,
    "end": 745.248,
    "duration": 5.04
  },
  {
    "id": 182,
    "text": "对比《白马篇》的视死如归与《赠白马王彪》的骨肉相残；",
    "start": 745.248,
    "end": 749.808,
    "duration": 4.56
  },
  {
    "id": 183,
    "text": "深入论证了曹植如何将汉乐府质朴刚劲的生命体验，",
    "start": 749.808,
    "end": 753.968,
    "duration": 4.16
  },
  {
    "id": 184,
    "text": "与文人自觉讲究的藻饰对仗完美融铸，",
    "start": 753.968,
    "end": 757.168,
    "duration": 3.2
  },
  {
    "id": 185,
    "text": "确立了五言古诗的千古法门。",
    "start": 757.168,
    "end": 759.328,
    "duration": 2.16
  },
  {
    "id": 186,
    "text": "所以本段具体答题完整版为：三、曹植诗歌的文质兼备：骨气奇高辞采华茂与前后期艺术流变。",
    "start": 759.728,
    "end": 768.208,
    "duration": 8.48
  },
  {
    "id": 187,
    "text": "曹植是建安文学成就最高的集大成者，",
    "start": 768.208,
    "end": 771.248,
    "duration": 3.04
  },
  {
    "id": 188,
    "text": "钟融在《诗品》中推为上品，盛赞其“骨气奇高，",
    "start": 771.248,
    "end": 775.088,
    "duration": 3.84
  },
  {
    "id": 189,
    "text": "辞采华茂”。",
    "start": 775.088,
    "end": 776.368,
    "duration": 1.28
  },
  {
    "id": 190,
    "text": "曹植的创作以曹丕称帝为界，呈现出极为鲜明的前后期飞跃。",
    "start": 776.368,
    "end": 781.088,
    "duration": 4.72
  },
  {
    "id": 191,
    "text": "前期生活在邺下幕府，诗风昂扬激越，",
    "start": 781.328,
    "end": 785.088,
    "duration": 3.76
  },
  {
    "id": 192,
    "text": "在《白马篇》中塑造出“捐躯赴国难，",
    "start": 785.088,
    "end": 788.288,
    "duration": 3.2
  },
  {
    "id": 193,
    "text": "视死忽如归”的英勇游侠形象。",
    "start": 788.288,
    "end": 791.088,
    "duration": 2.8
  },
  {
    "id": 194,
    "text": "后期曹植惨遭曹丕、曹瑞父子严酷的政治猜忌与软禁，",
    "start": 791.088,
    "end": 796.288,
    "duration": 5.2
  },
  {
    "id": 195,
    "text": "诗风转入悲愤幽怨与深沉自怜。",
    "start": 796.288,
    "end": 799.648,
    "duration": 3.36
  },
  {
    "id": 196,
    "text": "在《野田黄雀行》中借黄雀被缚倾诉绝望，",
    "start": 799.648,
    "end": 803.648,
    "duration": 4.0
  },
  {
    "id": 197,
    "text": "在《赠白马王彪》中借远行诀别痛陈骨肉相残。",
    "start": 803.648,
    "end": 807.728,
    "duration": 4.08
  },
  {
    "id": 198,
    "text": "曹植将建安风骨的刚劲骨力与华美藻饰完美融为一体，",
    "start": 808.208,
    "end": 812.528,
    "duration": 4.32
  },
  {
    "id": 199,
    "text": "开创了五言诗抒情的典范。。",
    "start": 812.528,
    "end": 814.688,
    "duration": 2.16
  },
  {
    "id": 200,
    "text": "第五段：第四分论点，曹丕婉约与七子蔡琰的多元回响（象之“广”）。",
    "start": 814.688,
    "end": 820.448,
    "duration": 5.76
  },
  {
    "id": 201,
    "text": "逐句因果推导与答题表述。",
    "start": 820.448,
    "end": 822.608,
    "duration": 2.16
  },
  {
    "id": 202,
    "text": "在剖析了曹操、曹植之后，本段必须补全曹丕的独特诗风以及建安七子、",
    "start": 822.608,
    "end": 828.288,
    "duration": 5.68
  },
  {
    "id": 203,
    "text": "蔡琰的集体合唱。",
    "start": 828.288,
    "end": 829.568,
    "duration": 1.28
  },
  {
    "id": 204,
    "text": "首句确立分论点，指出曹丕诗风别具一格，",
    "start": 829.888,
    "end": 833.648,
    "duration": 3.76
  },
  {
    "id": 205,
    "text": "引用钟融“便娟婉约”的定评。",
    "start": 833.648,
    "end": 836.048,
    "duration": 2.4
  },
  {
    "id": 206,
    "text": "所以表述为：三曹之中曹丕诗风别具一格，",
    "start": 836.048,
    "end": 839.808,
    "duration": 3.76
  },
  {
    "id": 207,
    "text": "钟融在《诗品》中评其“良称便娟，",
    "start": 839.808,
    "end": 842.768,
    "duration": 2.96
  },
  {
    "id": 208,
    "text": "婉约之词”。",
    "start": 842.768,
    "end": 844.048,
    "duration": 1.28
  },
  {
    "id": 209,
    "text": "次句指出其艺术创举，说明《燕歌行》成为中国现存最早成熟的文人七言诗。",
    "start": 844.048,
    "end": 850.128,
    "duration": 6.08
  },
  {
    "id": 210,
    "text": "所以表述为：曹丕善于描摹细腻纤巧的情感，",
    "start": 850.528,
    "end": 854.06,
    "duration": 3.532
  },
  {
    "id": 211,
    "text": "《燕歌行》成为中国现存最早成熟的文人七言诗。",
    "start": 854.06,
    "end": 857.828,
    "duration": 3.768
  },
  {
    "id": 212,
    "text": "第三句指出建安七子与女诗人蔡琰共同丰富了建安风骨的整体内涵。",
    "start": 857.828,
    "end": 863.58,
    "duration": 5.752
  },
  {
    "id": 213,
    "text": "所以表述为：与此同时，建安七子与女诗人蔡琰共同丰富了建安风骨的广度。",
    "start": 863.58,
    "end": 869.728,
    "duration": 6.148
  },
  {
    "id": 214,
    "text": "第四句调取王灿《七哀诗》记录白骨蔽平原的深沉纪实笔调。",
    "start": 869.808,
    "end": 874.688,
    "duration": 4.88
  },
  {
    "id": 215,
    "text": "所以表述为：王灿在《七哀诗》中写道“出门无所见，",
    "start": 874.688,
    "end": 878.736,
    "duration": 4.048
  },
  {
    "id": 216,
    "text": "白骨蔽平原”，纪实深沉入木三分。",
    "start": 878.736,
    "end": 882.016,
    "duration": 3.28
  },
  {
    "id": 217,
    "text": "第五句调取蔡琰《悲愤诗》，说明其开创了长篇五言自传体叙事的绝唱。",
    "start": 882.016,
    "end": 887.776,
    "duration": 5.76
  },
  {
    "id": 218,
    "text": "所以表述为：蔡琰的名篇《悲愤诗》则是五言自传体长篇叙事诗的开山绝唱，",
    "start": 887.776,
    "end": 893.536,
    "duration": 5.76
  },
  {
    "id": 219,
    "text": "血泪控诉胡骑掠夺。",
    "start": 893.536,
    "end": 895.216,
    "duration": 1.68
  },
  {
    "id": 220,
    "text": "第六句总结本段，指出建安风骨绝非单一雄健，",
    "start": 895.536,
    "end": 899.456,
    "duration": 3.92
  },
  {
    "id": 221,
    "text": "而是刚柔互济的丰富艺术世界。",
    "start": 899.456,
    "end": 902.056,
    "duration": 2.6
  },
  {
    "id": 222,
    "text": "所以表述为：这表明建安风骨绝非单一的雄迈，",
    "start": 902.056,
    "end": 906.049,
    "duration": 3.993
  },
  {
    "id": 223,
    "text": "而是刚柔互济、悲慨与凄美相生相成的丰富艺术世界。",
    "start": 906.049,
    "end": 910.671,
    "duration": 4.622
  },
  {
    "id": 224,
    "text": "本段答题思路总结。",
    "start": 910.671,
    "end": 912.352,
    "duration": 1.681
  },
  {
    "id": 225,
    "text": "本段展示了答题视角的广博全面：指出曹丕以七言奠基作《燕歌行》开创了婉约深情的新脉络；",
    "start": 912.352,
    "end": 920.336,
    "duration": 7.984
  },
  {
    "id": 226,
    "text": "紧接着点出王灿《七哀诗》与蔡琰长篇自传叙事诗《悲愤诗》对时代苦难的刻骨铭心记录；",
    "start": 920.416,
    "end": 927.856,
    "duration": 7.44
  },
  {
    "id": 227,
    "text": "全面论证了建安风骨既有铁血豪迈，",
    "start": 927.856,
    "end": 930.896,
    "duration": 3.04
  },
  {
    "id": 228,
    "text": "也有深规长叹与血泪自白，构成了多声部的宏大合唱。",
    "start": 930.896,
    "end": 935.456,
    "duration": 4.56
  },
  {
    "id": 229,
    "text": "所以本段具体答题完整版为：四、曹丕诗歌的便娟婉约与七子蔡琰的诗史悲音。",
    "start": 935.456,
    "end": 942.736,
    "duration": 7.28
  },
  {
    "id": 230,
    "text": "三曹之中曹丕诗风别具一格，钟融在《诗品》中评其“良称便娟，",
    "start": 943.056,
    "end": 948.736,
    "duration": 5.68
  },
  {
    "id": 231,
    "text": "婉约之词”。",
    "start": 948.736,
    "end": 949.856,
    "duration": 1.12
  },
  {
    "id": 232,
    "text": "曹丕善于描摹细腻纤巧的情感，《燕歌行》成为中国现存最早成熟的文人七言诗。",
    "start": 949.856,
    "end": 956.176,
    "duration": 6.32
  },
  {
    "id": 233,
    "text": "与此同时，建安七子与女诗人蔡琰共同丰富了建安风骨的广度。",
    "start": 956.176,
    "end": 960.896,
    "duration": 4.72
  },
  {
    "id": 234,
    "text": "王灿在《七哀诗》中写道“出门无所见，",
    "start": 961.136,
    "end": 964.336,
    "duration": 3.2
  },
  {
    "id": 235,
    "text": "白骨蔽平原”，纪实深沉入木三分。",
    "start": 964.336,
    "end": 967.856,
    "duration": 3.52
  },
  {
    "id": 236,
    "text": "蔡琰的名篇《悲愤诗》则是五言自传体长篇叙事诗的开山绝唱，",
    "start": 967.856,
    "end": 973.136,
    "duration": 5.28
  },
  {
    "id": 237,
    "text": "血泪控诉胡骑掠夺。",
    "start": 973.136,
    "end": 975.136,
    "duration": 2.0
  },
  {
    "id": 238,
    "text": "这表明建安风骨绝非单一的雄迈，而是刚柔互济、",
    "start": 975.136,
    "end": 979.616,
    "duration": 4.48
  },
  {
    "id": 239,
    "text": "悲慨与凄美相生相成的丰富艺术世界。",
    "start": 979.616,
    "end": 983.056,
    "duration": 3.44
  },
  {
    "id": 240,
    "text": "第六段：尾段收官与文学史谱系闭环。",
    "start": 983.296,
    "end": 987.216,
    "duration": 3.92
  },
  {
    "id": 241,
    "text": "逐句因果推导与答题表述。",
    "start": 987.216,
    "end": 989.936,
    "duration": 2.72
  },
  {
    "id": 242,
    "text": "尾段作为三十分大题的收官，必须将建安风骨置入中国古典诗歌发展长河中定型。",
    "start": 989.936,
    "end": 996.416,
    "duration": 6.48
  },
  {
    "id": 243,
    "text": "首句全面综合前述四个维度，定评其为现实精神与崇高阳刚品格的第一座高峰。",
    "start": 996.416,
    "end": 1002.576,
    "duration": 6.16
  },
  {
    "id": 244,
    "text": "所以表述为：综上所述，建安风骨是中国古典诗歌史上现实精神与崇高阳刚品格的第一座高峰。",
    "start": 1002.976,
    "end": 1011.536,
    "duration": 8.56
  },
  {
    "id": 245,
    "text": "次句确立体制史贡献，指出其确立了五言诗成熟的文学正统地位，",
    "start": 1011.536,
    "end": 1017.376,
    "duration": 5.84
  },
  {
    "id": 246,
    "text": "成为反靡丽的旗帜。",
    "start": 1017.376,
    "end": 1019.056,
    "duration": 1.68
  },
  {
    "id": 247,
    "text": "所以表述为：它确立了五言诗成熟的文学正统地位，",
    "start": 1019.056,
    "end": 1023.664,
    "duration": 4.608
  },
  {
    "id": 248,
    "text": "树立了后代文人力抗靡丽浮华的思想武器。",
    "start": 1023.664,
    "end": 1027.504,
    "duration": 3.84
  },
  {
    "id": 249,
    "text": "第三句向后纵向延展，列举西晋左思、",
    "start": 1027.504,
    "end": 1031.584,
    "duration": 4.08
  },
  {
    "id": 250,
    "text": "初唐陈子昂与盛唐李杜的高唱。",
    "start": 1031.584,
    "end": 1034.544,
    "duration": 2.96
  },
  {
    "id": 251,
    "text": "所以表述为：从西晋左思追求风力，",
    "start": 1034.544,
    "end": 1037.904,
    "duration": 3.36
  },
  {
    "id": 252,
    "text": "到初唐陈子昂倡导风骨，再到盛唐李杜的高唱。",
    "start": 1037.904,
    "end": 1042.144,
    "duration": 4.24
  },
  {
    "id": 253,
    "text": "第四句得出最终定论，建安风骨成为流淌在中国诗学血脉中的永恒精神力量。",
    "start": 1042.384,
    "end": 1048.39,
    "duration": 6.006
  },
  {
    "id": 254,
    "text": "所以表述为：建安风骨成为流淌在中国诗学血脉中的永恒力量。",
    "start": 1048.39,
    "end": 1053.43,
    "duration": 5.04
  },
  {
    "id": 255,
    "text": "本段答题思路总结。",
    "start": 1053.43,
    "end": 1054.981,
    "duration": 1.551
  },
  {
    "id": 256,
    "text": "本段完成了极具学术纵深感的闭环：先总结其五言正统确立与阳刚美学奠基；",
    "start": 1054.981,
    "end": 1061.184,
    "duration": 6.203
  },
  {
    "id": 257,
    "text": "随后清晰梳理出由建安风骨出发，经过西晋左思风力、",
    "start": 1061.344,
    "end": 1066.704,
    "duration": 5.36
  },
  {
    "id": 258,
    "text": "初唐陈子昂“汉魏风骨”、最终在盛唐李白“蓬莱文章建安骨”与杜甫沉郁诗篇中大放异彩的发展脉络，",
    "start": 1066.704,
    "end": 1077.184,
    "duration": 10.48
  },
  {
    "id": 259,
    "text": "全面展现了建安风骨作为中国诗学精神原乡的崇高地位。",
    "start": 1077.184,
    "end": 1082.304,
    "duration": 5.12
  },
  {
    "id": 260,
    "text": "所以本段具体答题完整版为：综上所述，",
    "start": 1082.304,
    "end": 1085.904,
    "duration": 3.6
  },
  {
    "id": 261,
    "text": "建安风骨是中国古典诗歌史上现实精神与崇高阳刚品格的第一座高峰。",
    "start": 1085.904,
    "end": 1091.344,
    "duration": 5.44
  },
  {
    "id": 262,
    "text": "它确立了五言诗成熟的文学正统地位，",
    "start": 1091.344,
    "end": 1094.224,
    "duration": 2.88
  },
  {
    "id": 263,
    "text": "树立了后代文人力抗靡丽浮华的思想武器。",
    "start": 1094.224,
    "end": 1097.664,
    "duration": 3.44
  },
  {
    "id": 264,
    "text": "从西晋左思追求风力，到初唐陈子昂倡导风骨，",
    "start": 1097.664,
    "end": 1101.664,
    "duration": 4.0
  },
  {
    "id": 265,
    "text": "再到盛唐李杜的高唱。",
    "start": 1101.664,
    "end": 1103.344,
    "duration": 1.68
  },
  {
    "id": 266,
    "text": "建安风骨成为流淌在中国诗学血脉中的永恒力量。",
    "start": 1103.584,
    "end": 1107.744,
    "duration": 4.16
  },
  {
    "id": 267,
    "text": "整道大题的内在逻辑链总括。",
    "start": 1107.744,
    "end": 1110.064,
    "duration": 2.32
  },
  {
    "id": 268,
    "text": "这道三十分大题的本质，是一场极度严密的逻辑推演。",
    "start": 1110.064,
    "end": 1114.624,
    "duration": 4.56
  },
  {
    "id": 269,
    "text": "整篇答卷从头到尾遵循着“由自觉定评、",
    "start": 1114.624,
    "end": 1117.904,
    "duration": 3.28
  },
  {
    "id": 270,
    "text": "到时代机制、到曹操博大、到曹植文质、",
    "start": 1117.904,
    "end": 1121.664,
    "duration": 3.76
  },
  {
    "id": 271,
    "text": "到曹丕七子、最终回归风骨流变”的必然法则。",
    "start": 1121.664,
    "end": 1125.424,
    "duration": 3.76
  },
  {
    "id": 272,
    "text": "阅卷老师看到的绝不是散乱的答题点，",
    "start": 1125.664,
    "end": 1128.624,
    "duration": 2.96
  },
  {
    "id": 273,
    "text": "而是一条咬合紧密的因果长链：第一步是“立论定性”，",
    "start": 1128.624,
    "end": 1132.864,
    "duration": 4.24
  },
  {
    "id": 274,
    "text": "开门见山借鲁迅“文学自觉时代”与刘协“风骨”论，",
    "start": 1132.864,
    "end": 1137.664,
    "duration": 4.8
  },
  {
    "id": 275,
    "text": "确立其作为阳刚美学巅峰的坐标。",
    "start": 1137.664,
    "end": 1140.544,
    "duration": 2.88
  },
  {
    "id": 276,
    "text": "第二步是“历史成因”，以生命短促之悲与建功立业热望的交织，",
    "start": 1140.544,
    "end": 1145.904,
    "duration": 5.36
  },
  {
    "id": 277,
    "text": "剖析大乱世催生士人自觉的心理动力机制。",
    "start": 1145.904,
    "end": 1149.024,
    "duration": 3.12
  },
  {
    "id": 278,
    "text": "第三步是“曹操古直”，以《短歌行》 《观沧海》展现政治家统帅天下、",
    "start": 1149.264,
    "end": 1154.784,
    "duration": 5.52
  },
  {
    "id": 279,
    "text": "气吞山河的苍凉壮伟。",
    "start": 1154.784,
    "end": 1156.704,
    "duration": 1.92
  },
  {
    "id": 280,
    "text": "第四步是“曹植兼备”，以前期《白马篇》与后期《赠白马王彪》，",
    "start": 1156.704,
    "end": 1161.504,
    "duration": 4.8
  },
  {
    "id": 281,
    "text": "论证骨气奇高与辞采华茂的五言抒情典范。",
    "start": 1161.504,
    "end": 1165.344,
    "duration": 3.84
  },
  {
    "id": 282,
    "text": "第五步是“多元格局”，以曹丕《燕歌行》的七言婉约与蔡琰《悲愤诗》的自传长篇，",
    "start": 1165.712,
    "end": 1172.112,
    "duration": 6.4
  },
  {
    "id": 283,
    "text": "展现刚柔相济的多声部合唱。",
    "start": 1172.112,
    "end": 1174.512,
    "duration": 2.4
  },
  {
    "id": 284,
    "text": "第六步是“风骨流变”，把建安风骨自然引向左思风力、",
    "start": 1174.512,
    "end": 1178.832,
    "duration": 4.32
  },
  {
    "id": 285,
    "text": "陈子昂革新与盛唐李杜的辉煌承续。",
    "start": 1178.832,
    "end": 1182.112,
    "duration": 3.28
  },
  {
    "id": 286,
    "text": "这六步层层递进，前一步的结论必然成为后一步的前提。",
    "start": 1182.112,
    "end": 1186.112,
    "duration": 4.0
  },
  {
    "id": 287,
    "text": "你在考场上顺着因果关系顺流而下，",
    "start": 1186.352,
    "end": 1189.072,
    "duration": 2.72
  },
  {
    "id": 288,
    "text": "就能自然写出近千字的满分答卷。",
    "start": 1189.072,
    "end": 1191.312,
    "duration": 2.24
  }
]