[
  {
    "id": 1,
    "text": "简述《战国策》的纵横辞令艺术及其对先秦历史散文的新变。",
    "start": 0.115,
    "end": 4.69,
    "duration": 4.575
  },
  {
    "id": 2,
    "text": "《战国策》经西汉刘向编校定名，集中记录战国策士游说诸侯的谋议论辩。",
    "start": 4.94,
    "end": 10.701,
    "duration": 5.761
  },
  {
    "id": 3,
    "text": "它跳出《左传》《国语》秉持儒家礼法写史的框范，",
    "start": 10.922,
    "end": 14.467,
    "duration": 3.545
  },
  {
    "id": 4,
    "text": "展现出士阶层崛起与纵横捭阖的时代风貌，其新变主要体现在三个方面：",
    "start": 14.621,
    "end": 20.036,
    "duration": 5.415
  },
  {
    "id": 5,
    "text": "第一，以“士”阶层为中心写活人物，自觉运用虚构与想象。",
    "start": 20.737,
    "end": 25.756,
    "duration": 5.019
  },
  {
    "id": 6,
    "text": "较之《左传》重在依史实写国君卿相，《战国策》着重张扬“士贵耳，王者不贵”的士人精神，",
    "start": 26.239,
    "end": 33.409,
    "duration": 7.17
  },
  {
    "id": 7,
    "text": "围绕苏秦、张仪、荆轲、鲁仲连等不同类型之士，",
    "start": 33.889,
    "end": 37.275,
    "duration": 3.386
  },
  {
    "id": 8,
    "text": "不惜突破实录限制，通过夸张动作与戏剧冲突丰富人物神采。",
    "start": 37.573,
    "end": 42.732,
    "duration": 5.159
  },
  {
    "id": 9,
    "text": "如《荆轲刺秦王》精细描摹易水白衣饯行、“图穷而匕首见”等细节场面，",
    "start": 42.976,
    "end": 49.176,
    "duration": 6.2
  },
  {
    "id": 10,
    "text": "极富感染力与小说叙事色彩。",
    "start": 49.542,
    "end": 51.87,
    "duration": 2.328
  },
  {
    "id": 11,
    "text": "第二，善借寓言譬喻婉转讽谏，增强说理的形象机锋。",
    "start": 52.464,
    "end": 57.296,
    "duration": 4.832
  },
  {
    "id": 12,
    "text": "战国策士游说人主时，常以日常小事或寓言故事切入，举重若轻、以小见大。",
    "start": 57.557,
    "end": 63.88,
    "duration": 6.323
  },
  {
    "id": 13,
    "text": "如《齐策》邹忌借与城北徐公比美一事剖析齐王受蔽之由，",
    "start": 64.29,
    "end": 69.199,
    "duration": 4.909
  },
  {
    "id": 14,
    "text": "《赵策》触龙从家长里短入手、以“父母爱子，则为之计深远”打动赵太后，",
    "start": 69.456,
    "end": 75.684,
    "duration": 6.228
  },
  {
    "id": 15,
    "text": "外加狐假虎威、画蛇添足等警策寓言，皆以生动譬喻化解紧张政争，说理透辟而余味盎然。",
    "start": 76.215,
    "end": 84.933,
    "duration": 8.718
  },
  {
    "id": 16,
    "text": "第三，由雅驯行人辞令转向“辩丽横肆”的纵横雄文，启迪汉代文风。",
    "start": 85.578,
    "end": 92.089,
    "duration": 6.511
  },
  {
    "id": 17,
    "text": "春秋行人辞令重在从容婉转，",
    "start": 92.402,
    "end": 94.922,
    "duration": 2.52
  },
  {
    "id": 18,
    "text": "而《战国策》说辞则善用排比、铺张、层层设难与气势压倒对方，前人概括为“辩丽横肆”。",
    "start": 95.229,
    "end": 103.185,
    "duration": 7.956
  },
  {
    "id": 19,
    "text": "如苏秦游说六国合纵之雄辩滔滔不绝、华采纷呈。",
    "start": 103.818,
    "end": 108.241,
    "duration": 4.423
  },
  {
    "id": 20,
    "text": "这种铺张扬厉之风标志着先秦叙事散文语言艺术的新高度，",
    "start": 108.543,
    "end": 113.182,
    "duration": 4.639
  },
  {
    "id": 21,
    "text": "并直接影响了汉代贾谊《过秦论》的宏阔气势及《史记》对策士群像的传神刻画。",
    "start": 113.574,
    "end": 120.022,
    "duration": 6.448
  }
]