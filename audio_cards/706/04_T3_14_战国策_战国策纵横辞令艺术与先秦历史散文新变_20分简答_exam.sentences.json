[
  {
    "id": 1,
    "text": "简述《战国策》的纵横辞令艺术及其对先秦历史散文的新变。",
    "start": 0.2,
    "end": 4.92,
    "duration": 4.72
  },
  {
    "id": 2,
    "text": "《战国策》经西汉刘向编校定名，集中记录战国策士游说诸侯的谋议论辩。",
    "start": 5.44,
    "end": 12.08,
    "duration": 6.64
  },
  {
    "id": 3,
    "text": "它跳出《左传》《国语》秉持儒家礼法写史的框范，",
    "start": 12.6,
    "end": 16.36,
    "duration": 3.76
  },
  {
    "id": 4,
    "text": "展现出士阶层崛起与纵横捭阖的时代风貌，其新变主要体现在三个方面：",
    "start": 16.73,
    "end": 22.89,
    "duration": 6.16
  },
  {
    "id": 5,
    "text": "第一，以“士”阶层为中心写活人物，自觉运用虚构与想象。",
    "start": 23.26,
    "end": 28.06,
    "duration": 4.8
  },
  {
    "id": 6,
    "text": "较之《左传》重在依史实写国君卿相，《战国策》着重张扬“士贵耳，王者不贵”的士人精神，",
    "start": 28.58,
    "end": 36.274,
    "duration": 7.694
  },
  {
    "id": 7,
    "text": "围绕苏秦、张仪、荆轲、鲁仲连等不同类型之士，不惜突破实录限制，通过夸张动作与戏剧冲突丰富人物神采。",
    "start": 36.629,
    "end": 46.52,
    "duration": 9.891
  },
  {
    "id": 8,
    "text": "如《荆轲刺秦王》精细描摹易水白衣饯行、“图穷而匕首见”等细节场面，极富感染力与小说叙事色彩。",
    "start": 47.04,
    "end": 55.12,
    "duration": 8.08
  },
  {
    "id": 9,
    "text": "第二，善借寓言譬喻婉转讽谏，增强说理的形象机锋。",
    "start": 55.64,
    "end": 60.2,
    "duration": 4.56
  },
  {
    "id": 10,
    "text": "战国策士游说人主时，常以日常小事或寓言故事切入，举重若轻、以小见大。",
    "start": 60.72,
    "end": 67.6,
    "duration": 6.88
  },
  {
    "id": 11,
    "text": "如《齐策》邹忌借与城北徐公比美一事剖析齐王受蔽之由，",
    "start": 68.12,
    "end": 72.84,
    "duration": 4.72
  },
  {
    "id": 12,
    "text": "《赵策》触龙从家长里短入手、以“父母之爱子，则为之计深远”打动赵太后，",
    "start": 73.21,
    "end": 79.5,
    "duration": 6.29
  },
  {
    "id": 13,
    "text": "外加狐假虎威、画蛇添足等警策寓言，皆以生动譬喻化解紧张政争，说理透辟而余味盎然。",
    "start": 79.87,
    "end": 88.11,
    "duration": 8.24
  },
  {
    "id": 14,
    "text": "第三，由雅驯行人辞令转向“辩丽横肆”的纵横雄文，启迪汉代文风。",
    "start": 88.63,
    "end": 94.39,
    "duration": 5.76
  },
  {
    "id": 15,
    "text": "春秋行人辞令重在从容婉转，而《战国策》说辞则善用排比、铺张、层层设难与气势压倒对方，前人概括为“辩丽横肆”。",
    "start": 94.91,
    "end": 105.79,
    "duration": 10.88
  },
  {
    "id": 16,
    "text": "如苏秦游说六国合纵之雄辩滔滔不绝、华采纷呈。",
    "start": 106.31,
    "end": 110.47,
    "duration": 4.16
  },
  {
    "id": 17,
    "text": "这种铺张扬厉之风标志着先秦叙事散文语言艺术的新高度，",
    "start": 110.99,
    "end": 115.71,
    "duration": 4.72
  },
  {
    "id": 18,
    "text": "并直接影响了汉代贾谊《过秦论》的宏阔气势及《史记》对策士群像的传神刻画。",
    "start": 116.08,
    "end": 122.8,
    "duration": 6.72
  }
]
