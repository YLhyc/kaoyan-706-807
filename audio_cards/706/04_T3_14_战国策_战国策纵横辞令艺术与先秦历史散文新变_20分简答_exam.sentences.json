[
  {
    "id": 1,
    "text": "简述《战国策》的纵横辞令艺术及其对先秦历史散文的新变。",
    "start": 0.115,
    "end": 4.68,
    "duration": 4.565
  },
  {
    "id": 2,
    "text": "《战国策》经西汉刘向编校定名，",
    "start": 4.94,
    "end": 7.25,
    "duration": 2.31
  },
  {
    "id": 3,
    "text": "集中记录战国策士游说诸侯的谋议论辩。",
    "start": 7.443,
    "end": 10.691,
    "duration": 3.248
  },
  {
    "id": 4,
    "text": "它跳出《左传》《国语》秉持儒家礼法写史的框范，",
    "start": 10.922,
    "end": 14.469,
    "duration": 3.547
  },
  {
    "id": 5,
    "text": "展现出士阶层崛起与纵横捭阖的时代风貌，",
    "start": 14.621,
    "end": 17.936,
    "duration": 3.315
  },
  {
    "id": 6,
    "text": "其新变主要体现在三个方面：",
    "start": 18.103,
    "end": 20.026,
    "duration": 1.923
  },
  {
    "id": 7,
    "text": "第一，以“士”阶层为中心写活人物，自觉运用虚构与想象。",
    "start": 20.737,
    "end": 25.746,
    "duration": 5.009
  },
  {
    "id": 8,
    "text": "较之《左传》重在依史实写国君卿相，",
    "start": 26.239,
    "end": 29.214,
    "duration": 2.975
  },
  {
    "id": 9,
    "text": "《战国策》着重张扬“士贵耳，王者不贵”的士人精神，",
    "start": 29.603,
    "end": 33.412,
    "duration": 3.809
  },
  {
    "id": 10,
    "text": "围绕苏秦、张仪、荆轲、鲁仲连等不同类型之士，",
    "start": 33.889,
    "end": 37.266,
    "duration": 3.377
  },
  {
    "id": 11,
    "text": "不惜突破实录限制，通过夸张动作与戏剧冲突丰富人物神采。",
    "start": 37.573,
    "end": 42.722,
    "duration": 5.149
  },
  {
    "id": 12,
    "text": "如《荆轲刺秦王》精细描摹易水白衣饯行、",
    "start": 42.976,
    "end": 46.857,
    "duration": 3.881
  },
  {
    "id": 13,
    "text": "“图穷而匕首见”等细节场面，极富感染力与小说叙事色彩。",
    "start": 47.028,
    "end": 51.865,
    "duration": 4.837
  },
  {
    "id": 14,
    "text": "第二，善借寓言譬喻婉转讽谏，增强说理的形象机锋。",
    "start": 52.464,
    "end": 57.289,
    "duration": 4.825
  },
  {
    "id": 15,
    "text": "战国策士游说人主时，常以日常小事或寓言故事切入，",
    "start": 57.557,
    "end": 62.091,
    "duration": 4.534
  },
  {
    "id": 16,
    "text": "举重若轻、以小见大。",
    "start": 62.328,
    "end": 63.87,
    "duration": 1.542
  },
  {
    "id": 17,
    "text": "如《齐策》邹忌借与城北徐公比美一事剖析齐王受蔽之由，",
    "start": 64.29,
    "end": 69.189,
    "duration": 4.899
  },
  {
    "id": 18,
    "text": "《赵策》触龙从家长里短入手、以“父母爱子，",
    "start": 69.456,
    "end": 73.189,
    "duration": 3.733
  },
  {
    "id": 19,
    "text": "则为之计深远”打动赵太后，外加狐假虎威、",
    "start": 73.436,
    "end": 77.334,
    "duration": 3.898
  },
  {
    "id": 20,
    "text": "画蛇添足等警策寓言，皆以生动譬喻化解紧张政争，",
    "start": 77.893,
    "end": 82.542,
    "duration": 4.649
  },
  {
    "id": 21,
    "text": "说理透辟而余味盎然。",
    "start": 82.998,
    "end": 84.923,
    "duration": 1.925
  },
  {
    "id": 22,
    "text": "第三，由雅驯行人辞令转向“辩丽横肆”的纵横雄文，",
    "start": 85.578,
    "end": 90.528,
    "duration": 4.95
  },
  {
    "id": 23,
    "text": "启迪汉代文风。",
    "start": 90.871,
    "end": 92.079,
    "duration": 1.208
  },
  {
    "id": 24,
    "text": "春秋行人辞令重在从容婉转，而《战国策》说辞则善用排比、",
    "start": 92.402,
    "end": 97.492,
    "duration": 5.09
  },
  {
    "id": 25,
    "text": "铺张、层层设难与气势压倒对方，前人概括为“辩丽横肆”。",
    "start": 97.96,
    "end": 103.175,
    "duration": 5.215
  },
  {
    "id": 26,
    "text": "如苏秦游说六国合纵之雄辩滔滔不绝、华采纷呈。",
    "start": 103.818,
    "end": 108.231,
    "duration": 4.413
  },
  {
    "id": 27,
    "text": "这种铺张扬厉之风标志着先秦叙事散文语言艺术的新高度，",
    "start": 108.543,
    "end": 113.172,
    "duration": 4.629
  },
  {
    "id": 28,
    "text": "并直接影响了汉代贾谊《过秦论》的宏阔气势及《史记》对策士群像的传神刻画。",
    "start": 113.574,
    "end": 120.022,
    "duration": 6.448
  }
]