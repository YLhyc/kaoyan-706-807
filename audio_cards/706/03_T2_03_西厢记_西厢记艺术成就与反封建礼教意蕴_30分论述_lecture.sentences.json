[
  {
    "id": 1,
    "text": "试论《西厢记》的艺术成就与反封建礼教意蕴。",
    "start": 0.099,
    "end": 3.761,
    "duration": 3.662
  },
  {
    "id": 2,
    "text": "《西厢记》是元代杂剧文人创作的艺术高峰，",
    "start": 4.08,
    "end": 7.124,
    "duration": 3.044
  },
  {
    "id": 3,
    "text": "也是中国古典戏曲中反抗封建礼教的代表作。",
    "start": 7.543,
    "end": 10.966,
    "duration": 3.423
  },
  {
    "id": 4,
    "text": "王实甫在唐代元稹《莺莺传》与金代董解元《西厢记诸宫调》的基础上推陈出新，",
    "start": 11.334,
    "end": 17.359,
    "duration": 6.025
  },
  {
    "id": 5,
    "text": "将才子佳人故事改造为追求婚姻自主的戏剧冲突，",
    "start": 17.633,
    "end": 21.656,
    "duration": 4.023
  },
  {
    "id": 6,
    "text": "在剧终响亮喊出“愿普天下有情的都成了眷属”。",
    "start": 22.104,
    "end": 26.247,
    "duration": 4.143
  },
  {
    "id": 7,
    "text": "朱权在《太和正音谱》中赞其曲词如“花间美人”。",
    "start": 26.794,
    "end": 31.259,
    "duration": 4.465
  },
  {
    "id": 8,
    "text": "全剧的思想意蕴与艺术成就，主要体现在以下四个方面：",
    "start": 31.771,
    "end": 36.003,
    "duration": 4.232
  },
  {
    "id": 9,
    "text": "第一，高扬反抗封建礼教旗帜，",
    "start": 36.645,
    "end": 39.245,
    "duration": 2.6
  },
  {
    "id": 10,
    "text": "确立以情抗礼与婚姻自主的进步主题。",
    "start": 39.722,
    "end": 42.878,
    "duration": 3.156
  },
  {
    "id": 11,
    "text": "《西厢记》的突出意义，",
    "start": 43.18,
    "end": 44.566,
    "duration": 1.386
  },
  {
    "id": 12,
    "text": "在于正面否定了封建家长包办婚姻的“父母之命，媒妁之言”。",
    "start": 44.851,
    "end": 49.289,
    "duration": 4.438
  },
  {
    "id": 13,
    "text": "剧中崔莺莺与张生冲破名分、门第与礼法的重重束缚，",
    "start": 49.512,
    "end": 54.074,
    "duration": 4.562
  },
  {
    "id": 14,
    "text": "将男女双方的真诚爱恋置于功名利禄与宗法礼教之上；",
    "start": 54.576,
    "end": 59.083,
    "duration": 4.507
  },
  {
    "id": 15,
    "text": "剧作无情揭露并批判了封建礼教卫道士崔老夫人的虚伪与冷酷，",
    "start": 59.36,
    "end": 64.759,
    "duration": 5.399
  },
  {
    "id": 16,
    "text": "撕破其借“不招白衣女婿”为名赖婚逼考的假面。",
    "start": 65.179,
    "end": 69.386,
    "duration": 4.207
  },
  {
    "id": 17,
    "text": "王实甫摆脱了传统才子佳人故事依附科举功名或“报恩合礼”的旧套，",
    "start": 69.782,
    "end": 75.524,
    "duration": 5.742
  },
  {
    "id": 18,
    "text": "肯定个体正当情感的合理性，",
    "start": 75.942,
    "end": 77.911,
    "duration": 1.969
  },
  {
    "id": 19,
    "text": "使爱情题材上升为冲决封建道德枷锁的思想力量。",
    "start": 78.311,
    "end": 82.262,
    "duration": 3.951
  },
  {
    "id": 20,
    "text": "第二，着力刻画人物内心矛盾，塑造性格鲜明的反抗者群像。",
    "start": 82.955,
    "end": 88.086,
    "duration": 5.131
  },
  {
    "id": 21,
    "text": "在人物塑造上，王实甫精于揭示人物细微复杂的恋爱心理。",
    "start": 88.668,
    "end": 93.434,
    "duration": 4.766
  },
  {
    "id": 22,
    "text": "崔莺莺身为相国千金，长期受深闺礼教熏陶，",
    "start": 93.986,
    "end": 97.813,
    "duration": 3.827
  },
  {
    "id": 23,
    "text": "性格兼具热情与矜持：她初遇张生即暗生情愫，",
    "start": 98.011,
    "end": 102.963,
    "duration": 4.952
  },
  {
    "id": 24,
    "text": "却因礼教拘束而在“闹简”“赖简”中屡屡做出内热外冷的试探与掩饰；",
    "start": 103.334,
    "end": 109.175,
    "duration": 5.841
  },
  {
    "id": 25,
    "text": "张生志诚笃厚、执着痴情，为爱情不惜抛却功名，",
    "start": 109.439,
    "end": 113.781,
    "duration": 4.342
  },
  {
    "id": 26,
    "text": "甚至相思成疾、误解诗谜而跳墙；侍女红娘则机智泼辣、",
    "start": 114.132,
    "end": 118.841,
    "duration": 4.709
  },
  {
    "id": 27,
    "text": "富于侠义，在关键戏眼“拷红”中面对老夫人严刑威逼，",
    "start": 119.11,
    "end": 123.409,
    "duration": 4.299
  },
  {
    "id": 28,
    "text": "巧用礼教信义反客为主，逼使老夫人屈服，",
    "start": 123.695,
    "end": 127.228,
    "duration": 3.533
  },
  {
    "id": 29,
    "text": "成为维护青年恋情的坚定助力。",
    "start": 127.511,
    "end": 129.839,
    "duration": 2.328
  },
  {
    "id": 30,
    "text": "第三，突破元杂剧四折常规体制，",
    "start": 130.443,
    "end": 133.259,
    "duration": 2.816
  },
  {
    "id": 31,
    "text": "创造宏大而又紧凑严密的五本联套结构。",
    "start": 133.617,
    "end": 137.01,
    "duration": 3.393
  },
  {
    "id": 32,
    "text": "在戏剧体制上，",
    "start": 137.629,
    "end": 138.666,
    "duration": 1.037
  },
  {
    "id": 33,
    "text": "王实甫打破了元杂剧一本四折及由单一主角主唱的成规，",
    "start": 138.963,
    "end": 143.444,
    "duration": 4.481
  },
  {
    "id": 34,
    "text": "首创“五本二十折”的宏大联套体制，",
    "start": 143.902,
    "end": 146.644,
    "duration": 2.742
  },
  {
    "id": 35,
    "text": "并用〔络丝娘煞尾〕沟通前后两本，",
    "start": 146.884,
    "end": 149.445,
    "duration": 2.561
  },
  {
    "id": 36,
    "text": "在部分折子中采用末旦轮唱，增强了舞台表现力。",
    "start": 149.744,
    "end": 153.52,
    "duration": 3.776
  },
  {
    "id": 37,
    "text": "全剧围绕老夫人与青年一代、",
    "start": 153.66,
    "end": 155.715,
    "duration": 2.055
  },
  {
    "id": 38,
    "text": "以及崔张红三人之间的主辅两条矛盾线索展开，从佛殿奇遇、",
    "start": 155.939,
    "end": 160.56,
    "duration": 4.621
  },
  {
    "id": 39,
    "text": "月下联吟、孙飞虎兵围普救寺与白马解围，到老夫人赖婚、",
    "start": 160.885,
    "end": 165.338,
    "duration": 4.453
  },
  {
    "id": 40,
    "text": "琴心传情、拷红许婚与长亭送别，矛盾起伏跌宕、环环相扣，",
    "start": 165.489,
    "end": 170.818,
    "duration": 5.329
  },
  {
    "id": 41,
    "text": "既具长篇巨制的规模，又保持了场次衔接的紧凑严密。",
    "start": 171.097,
    "end": 175.326,
    "duration": 4.229
  },
  {
    "id": 42,
    "text": "第四，兼备诗词雅趣与戏曲本色，达到元代剧作语言的典范境界。",
    "start": 175.93,
    "end": 181.855,
    "duration": 5.925
  },
  {
    "id": 43,
    "text": "《西厢记》的语言艺术被徐复祚赞为“字字当行，言言本色”。",
    "start": 182.493,
    "end": 187.43,
    "duration": 4.937
  },
  {
    "id": 44,
    "text": "王实甫在曲词中巧妙融汇唐诗宋词的清雅意象与元代民间口语，",
    "start": 188.022,
    "end": 193.898,
    "duration": 5.876
  },
  {
    "id": 45,
    "text": "且能因人设辞、贴合舞台表演动作。",
    "start": 194.363,
    "end": 197.425,
    "duration": 3.062
  },
  {
    "id": 46,
    "text": "第四本第三折“长亭送别”开篇“碧云天，黄花地，西风紧，",
    "start": 197.692,
    "end": 203.339,
    "duration": 5.647
  },
  {
    "id": 47,
    "text": "北雁南飞。",
    "start": 203.68,
    "end": 204.51,
    "duration": 0.83
  },
  {
    "id": 48,
    "text": "晓来谁染霜林醉？",
    "start": 204.811,
    "end": 206.353,
    "duration": 1.542
  },
  {
    "id": 49,
    "text": "总是离人泪”，化用范仲淹词境而情景交融、声泪俱下；",
    "start": 206.696,
    "end": 211.554,
    "duration": 4.858
  },
  {
    "id": 50,
    "text": "红娘的宾白与唱词则明快犀利、俏皮生动。",
    "start": 212.045,
    "end": 215.806,
    "duration": 3.761
  },
  {
    "id": 51,
    "text": "这种文采与本色相生的艺术风貌，",
    "start": 216.383,
    "end": 218.819,
    "duration": 2.436
  },
  {
    "id": 52,
    "text": "直接启迪了后世《牡丹亭》《红楼梦》等反礼教名著。",
    "start": 219.061,
    "end": 223.112,
    "duration": 4.051
  }
]