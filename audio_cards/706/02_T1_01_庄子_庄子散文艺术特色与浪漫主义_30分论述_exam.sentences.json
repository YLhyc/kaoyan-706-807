[
  {
    "id": 1,
    "text": "试论庄子散文的艺术特色与浪漫主义精神。",
    "start": 0.16,
    "end": 3.389,
    "duration": 3.229
  },
  {
    "id": 2,
    "text": "《庄子》是先秦诸子散文发展史上的高峰，",
    "start": 4.087,
    "end": 6.827,
    "duration": 2.74
  },
  {
    "id": 3,
    "text": "也是中国古代浪漫主义文学的重要源头。",
    "start": 7.21,
    "end": 9.976,
    "duration": 2.766
  },
  {
    "id": 4,
    "text": "面对战国中期兼并战争激化、",
    "start": 10.551,
    "end": 12.717,
    "duration": 2.166
  },
  {
    "id": 5,
    "text": "礼崩乐坏与个体生命朝不保夕的残酷现实，",
    "start": 13.224,
    "end": 16.489,
    "duration": 3.265
  },
  {
    "id": 6,
    "text": "庄子继承并发展了老子的道家思想，构筑起超脱世俗功利、",
    "start": 17.008,
    "end": 21.654,
    "duration": 4.646
  },
  {
    "id": 7,
    "text": "追求精神自由的哲学境界。",
    "start": 21.944,
    "end": 23.948,
    "duration": 2.004
  },
  {
    "id": 8,
    "text": "其散文打破了前期语录体与专题论文的板滞格局，",
    "start": 24.294,
    "end": 28.427,
    "duration": 4.133
  },
  {
    "id": 9,
    "text": "以奇幻诡谲的想象与汪洋恣肆的文风，",
    "start": 28.851,
    "end": 31.964,
    "duration": 3.113
  },
  {
    "id": 10,
    "text": "将哲学思辨与文学诗意融为一体，",
    "start": 32.313,
    "end": 35.057,
    "duration": 2.744
  },
  {
    "id": 11,
    "text": "故鲁迅在《汉文学史纲要》中赞其“晚周诸子之作，",
    "start": 35.445,
    "end": 39.528,
    "duration": 4.083
  },
  {
    "id": 12,
    "text": "莫能先也”。",
    "start": 39.84,
    "end": 40.536,
    "duration": 0.696
  },
  {
    "id": 13,
    "text": "其散文艺术特色与浪漫主义精神，主要体现在以下四个方面：",
    "start": 41.021,
    "end": 45.578,
    "duration": 4.557
  },
  {
    "id": 14,
    "text": "第一，善用“三言”与寓言系统说理，把哲学思辨化为生动形象。",
    "start": 46.245,
    "end": 51.633,
    "duration": 5.388
  },
  {
    "id": 15,
    "text": "庄子散文最突出的表现形式，",
    "start": 52.04,
    "end": 54.037,
    "duration": 1.997
  },
  {
    "id": 16,
    "text": "在于建立了以“寓言”“重言”“卮言”为主体的表述方式。",
    "start": 54.159,
    "end": 58.755,
    "duration": 4.596
  },
  {
    "id": 17,
    "text": "庄子认为玄妙之道难以仅靠抽象概念直接阐发，",
    "start": 59.039,
    "end": 62.95,
    "duration": 3.911
  },
  {
    "id": 18,
    "text": "因而“寓言十九，藉外论之”，借助形象故事寄寓哲理。",
    "start": 63.344,
    "end": 67.751,
    "duration": 4.407
  },
  {
    "id": 19,
    "text": "其寓言取材广博、寄意深微：",
    "start": 68.01,
    "end": 70.742,
    "duration": 2.732
  },
  {
    "id": 20,
    "text": "无论是《庖丁解牛》中以刀刃游于骨节比喻依乎天理的养生之道，",
    "start": 71.006,
    "end": 76.17,
    "duration": 5.164
  },
  {
    "id": 21,
    "text": "还是《秋水》中以河伯与北海的对话喻指认识的有限与无穷，",
    "start": 76.318,
    "end": 81.116,
    "duration": 4.798
  },
  {
    "id": 22,
    "text": "亦或是《人间世》中“螳臂当车”的警示与《养生主》中薪火相传的譬喻，",
    "start": 81.321,
    "end": 87.219,
    "duration": 5.898
  },
  {
    "id": 23,
    "text": "庄子都将抽象道家哲理转化为鲜活可感的艺术形象，",
    "start": 87.442,
    "end": 91.72,
    "duration": 4.278
  },
  {
    "id": 24,
    "text": "赋予散文强大的感染力。",
    "start": 91.893,
    "end": 93.607,
    "duration": 1.714
  },
  {
    "id": 25,
    "text": "第二，展开雄奇飞腾的浪漫想象，",
    "start": 94.306,
    "end": 97.036,
    "duration": 2.73
  },
  {
    "id": 26,
    "text": "突破现实时空束缚以彰显精神自由。",
    "start": 97.321,
    "end": 100.503,
    "duration": 3.182
  },
  {
    "id": 27,
    "text": "浪漫主义精神的核心在于对现实羁绊的主动超越，",
    "start": 101.098,
    "end": 104.758,
    "duration": 3.66
  },
  {
    "id": 28,
    "text": "庄子散文向以超常的想象力著称。",
    "start": 105.027,
    "end": 108.037,
    "duration": 3.01
  },
  {
    "id": 29,
    "text": "他善于在浩渺宇宙与细微万物之间自由跨越：",
    "start": 108.259,
    "end": 112.283,
    "duration": 4.024
  },
  {
    "id": 30,
    "text": "在《逍遥游》开篇，作者以宏阔巨笔描绘鲲鹏展翅，",
    "start": 112.496,
    "end": 117.473,
    "duration": 4.977
  },
  {
    "id": 31,
    "text": "“水击三千里，抟扶摇而上者九万里”，",
    "start": 117.741,
    "end": 121.212,
    "duration": 3.471
  },
  {
    "id": 32,
    "text": "借大鹏由北冥徙南冥的壮阔图景寄寓对广阔境界的向往；",
    "start": 121.578,
    "end": 126.619,
    "duration": 5.041
  },
  {
    "id": 33,
    "text": "在《齐物论》末尾，又以轻灵梦幻的笔触描摹庄周梦蝶，",
    "start": 126.992,
    "end": 131.695,
    "duration": 4.703
  },
  {
    "id": 34,
    "text": "“不知周之梦为胡蝶与，胡蝶之梦为周与”，",
    "start": 132.075,
    "end": 135.333,
    "duration": 3.258
  },
  {
    "id": 35,
    "text": "借物我界限的泯灭展现物化互通的诗意境界。",
    "start": 135.815,
    "end": 139.992,
    "duration": 4.177
  },
  {
    "id": 36,
    "text": "这种超脱世俗功利的飞扬想象，",
    "start": 140.226,
    "end": 142.525,
    "duration": 2.299
  },
  {
    "id": 37,
    "text": "为中国古典文学注入了自由奔放的浪漫气息。",
    "start": 142.743,
    "end": 146.508,
    "duration": 3.765
  },
  {
    "id": 38,
    "text": "第三，形成汪洋恣肆的文体气势，构建跌宕起伏的自由章法。",
    "start": 147.167,
    "end": 152.652,
    "duration": 5.485
  },
  {
    "id": 39,
    "text": "在篇章结构上，庄子散文摆脱了严谨论辩的刻板绳墨，",
    "start": 152.962,
    "end": 157.549,
    "duration": 4.587
  },
  {
    "id": 40,
    "text": "呈现出刘熙载《艺概》所评“意出尘外，",
    "start": 158.037,
    "end": 161.231,
    "duration": 3.194
  },
  {
    "id": 41,
    "text": "怪生笔端”的灵动风貌。",
    "start": 161.519,
    "end": 163.241,
    "duration": 1.722
  },
  {
    "id": 42,
    "text": "文章往往不设呆板提纲，而是由核心意象出发，随物赋形、",
    "start": 163.537,
    "end": 168.226,
    "duration": 4.689
  },
  {
    "id": 43,
    "text": "层层生发，如行云流水般舒卷自如。",
    "start": 168.523,
    "end": 171.911,
    "duration": 3.388
  },
  {
    "id": 44,
    "text": "说理之际，庄子常运用连类比喻与正反翻案之笔，亦真亦幻；",
    "start": 172.562,
    "end": 178.074,
    "duration": 5.512
  },
  {
    "id": 45,
    "text": "其语言跌宕跳跃，句式长短错落，时而如巨澜奔涌、气势磅礴，",
    "start": 178.454,
    "end": 184.077,
    "duration": 5.623
  },
  {
    "id": 46,
    "text": "时而机锋毕露、耐人寻味。",
    "start": 184.512,
    "end": 186.521,
    "duration": 2.009
  },
  {
    "id": 47,
    "text": "这种汪洋恣肆的章法，恰与其追求精神自由的哲学主旨互为表里。",
    "start": 187.264,
    "end": 192.69,
    "duration": 5.426
  },
  {
    "id": 48,
    "text": "第四，运用诙谐辛辣的讽刺笔法，",
    "start": 193.298,
    "end": 195.958,
    "duration": 2.66
  },
  {
    "id": 49,
    "text": "嘲弄世俗机心并树立后世精神归宿。",
    "start": 196.25,
    "end": 199.616,
    "duration": 3.366
  },
  {
    "id": 50,
    "text": "庄子不仅具有超然物外的诗性哲思，更怀有冷眼观世的批判锐气。",
    "start": 199.933,
    "end": 204.992,
    "duration": 5.059
  },
  {
    "id": 51,
    "text": "他善用夸张、对比与反讽手法，",
    "start": 205.397,
    "end": 207.928,
    "duration": 2.531
  },
  {
    "id": 52,
    "text": "嘲弄汲汲于功名利禄的世俗之人：在《秋水》中，",
    "start": 208.378,
    "end": 212.02,
    "duration": 3.642
  },
  {
    "id": 53,
    "text": "他将惠子所求的梁国相印比作腐鼠，",
    "start": 212.338,
    "end": 215.403,
    "duration": 3.065
  },
  {
    "id": 54,
    "text": "将高洁志趣比作非梧桐不栖的鹓雏；在《列御寇》中，",
    "start": 215.67,
    "end": 220.004,
    "duration": 4.334
  },
  {
    "id": 55,
    "text": "以曹商舔痔得车讽刺阿附权贵之徒。",
    "start": 220.333,
    "end": 223.852,
    "duration": 3.519
  },
  {
    "id": 56,
    "text": "这种辛辣诙谐的讽刺艺术，展现出独立士人蔑视权贵的风骨。",
    "start": 224.005,
    "end": 229.102,
    "duration": 5.097
  },
  {
    "id": 57,
    "text": "《庄子》以其汪洋恣肆的文风、瑰丽想象与寓言传统，",
    "start": 229.298,
    "end": 233.987,
    "duration": 4.689
  },
  {
    "id": 58,
    "text": "深刻滋养了司马迁、阮籍、李白、苏轼等后代文学巨匠，",
    "start": 234.249,
    "end": 238.96,
    "duration": 4.711
  },
  {
    "id": 59,
    "text": "成为中国古代文人超越尘网、安顿心灵的重要精神源泉。",
    "start": 239.584,
    "end": 244.096,
    "duration": 4.512
  }
]