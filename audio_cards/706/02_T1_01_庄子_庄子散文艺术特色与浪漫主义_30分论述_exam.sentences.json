[
  {
    "id": 1,
    "text": "试论庄子散文的艺术特色与浪漫主义精神。",
    "start": 0.134,
    "end": 3.306,
    "duration": 3.172
  },
  {
    "id": 2,
    "text": "《庄子》是先秦诸子散文发展史上的高峰，也是中国古代浪漫主义文学的重要源头。",
    "start": 4.063,
    "end": 10.925,
    "duration": 6.862
  },
  {
    "id": 3,
    "text": "面对战国中期兼并战争激化、礼崩乐坏与个体生命朝不保夕的残酷现实，",
    "start": 11.454,
    "end": 16.786,
    "duration": 5.332
  },
  {
    "id": 4,
    "text": "庄子继承并发展了老子的道家思想，构筑起超脱世俗功利、追求精神自由的哲学境界。",
    "start": 17.165,
    "end": 25.107,
    "duration": 7.942
  },
  {
    "id": 5,
    "text": "其散文打破了前期语录体与专题论文的板滞格局，",
    "start": 25.636,
    "end": 29.048,
    "duration": 3.412
  },
  {
    "id": 6,
    "text": "以奇幻诡谲的想象与汪洋恣肆的文风，将哲学思辨与文学诗意融为一体，",
    "start": 29.427,
    "end": 35.439,
    "duration": 6.012
  },
  {
    "id": 7,
    "text": "故鲁迅在《汉文学史纲要》中赞其“晚周诸子之作，莫能先也”。",
    "start": 36.033,
    "end": 42.069,
    "duration": 6.036
  },
  {
    "id": 8,
    "text": "其散文艺术特色与浪漫主义精神，主要体现在以下四个方面：",
    "start": 42.598,
    "end": 47.41,
    "duration": 4.812
  },
  {
    "id": 9,
    "text": "第一，善用“三言”与寓言系统说理，把哲学思辨化为生动形象。",
    "start": 48.034,
    "end": 52.976,
    "duration": 4.942
  },
  {
    "id": 10,
    "text": "庄子散文最突出的表现形式，在于建立了以“寓言”“重言”“卮言”为主体的表述方式。",
    "start": 53.505,
    "end": 58.917,
    "duration": 5.412
  },
  {
    "id": 11,
    "text": "庄子认为玄妙之道难以仅靠抽象概念直接阐发，",
    "start": 59.595,
    "end": 63.087,
    "duration": 3.492
  },
  {
    "id": 12,
    "text": "因而“寓言十九，藉外论之”，借助形象故事寄寓哲理。",
    "start": 63.475,
    "end": 67.647,
    "duration": 4.172
  },
  {
    "id": 13,
    "text": "其寓言取材广博、寄意深微：",
    "start": 68.325,
    "end": 70.457,
    "duration": 2.132
  },
  {
    "id": 14,
    "text": "无论是《庖丁解牛》中以刀刃游于骨节比喻依乎天理的养生之道，",
    "start": 70.836,
    "end": 76.048,
    "duration": 5.212
  },
  {
    "id": 15,
    "text": "还是《秋水》中以河伯与北海的对话喻指认识的有限与无穷，",
    "start": 76.427,
    "end": 80.839,
    "duration": 4.412
  },
  {
    "id": 16,
    "text": "亦或是《人间世》中“螳臂当车”的警示与《养生主》中薪火相传的譬喻，",
    "start": 81.437,
    "end": 86.729,
    "duration": 5.292
  },
  {
    "id": 17,
    "text": "庄子都将抽象道家哲理转化为鲜活可感的艺术形象，赋予散文强大的感染力。",
    "start": 87.27,
    "end": 92.602,
    "duration": 5.332
  },
  {
    "id": 18,
    "text": "第二，展开雄奇飞腾的浪漫想象，突破现实时空束缚以彰显精神自由。",
    "start": 93.226,
    "end": 99.405,
    "duration": 6.179
  },
  {
    "id": 19,
    "text": "浪漫主义精神的核心在于对现实羁绊的主动超越，庄子散文向以超常的想象力著称。",
    "start": 99.934,
    "end": 107.236,
    "duration": 7.302
  },
  {
    "id": 20,
    "text": "他善于在浩渺宇宙与细微万物之间自由跨越：",
    "start": 107.914,
    "end": 111.446,
    "duration": 3.532
  },
  {
    "id": 21,
    "text": "在《逍遥游》开篇，作者以宏阔巨笔描绘鲲鹏展翅，“水击三千里，抟扶摇而上者九万里”，",
    "start": 111.825,
    "end": 118.797,
    "duration": 6.972
  },
  {
    "id": 22,
    "text": "借大鹏由北冥徙南冥的壮阔图景寄寓对广阔境界的向往；",
    "start": 119.264,
    "end": 123.516,
    "duration": 4.252
  },
  {
    "id": 23,
    "text": "在《齐物论》末尾，又以轻灵梦幻的笔触描摹庄周梦蝶，",
    "start": 124.045,
    "end": 128.017,
    "duration": 3.972
  },
  {
    "id": 24,
    "text": "“不知周之梦为胡蝶与，胡蝶之梦为周与”，借物我界限的泯灭展现物化互通的诗意境界。",
    "start": 128.685,
    "end": 135.617,
    "duration": 6.932
  },
  {
    "id": 25,
    "text": "这种超脱世俗功利的飞扬想象，为中国古典文学注入了自由奔放的浪漫气息。",
    "start": 136.146,
    "end": 142.118,
    "duration": 5.972
  },
  {
    "id": 26,
    "text": "第三，形成汪洋恣肆的文体气势，构建跌宕起伏的自由章法。",
    "start": 142.796,
    "end": 147.648,
    "duration": 4.852
  },
  {
    "id": 27,
    "text": "在篇章结构上，庄子散文摆脱了严谨论辩的刻板绳墨，",
    "start": 148.326,
    "end": 152.658,
    "duration": 4.332
  },
  {
    "id": 28,
    "text": "呈现出刘熙载《艺概》所评“意出尘外，怪生笔端”的灵动风貌。",
    "start": 153.037,
    "end": 158.049,
    "duration": 5.012
  },
  {
    "id": 29,
    "text": "文章往往不设呆板提纲，而是由核心意象出发，随物赋形、层层生发，如行云流水般舒卷自如。",
    "start": 158.727,
    "end": 166.579,
    "duration": 7.852
  },
  {
    "id": 30,
    "text": "说理之际，庄子常运用连类比喻与正反翻案之笔，亦真亦幻；",
    "start": 167.257,
    "end": 172.189,
    "duration": 4.932
  },
  {
    "id": 31,
    "text": "其语言跌宕跳跃，句式长短错落，时而如巨澜奔涌、气势磅礴，时而机锋毕露、耐人寻味。",
    "start": 172.867,
    "end": 180.319,
    "duration": 7.452
  },
  {
    "id": 32,
    "text": "这种汪洋恣肆的章法，恰与其追求精神自由的哲学主旨互为表里。",
    "start": 180.957,
    "end": 185.929,
    "duration": 4.972
  },
  {
    "id": 33,
    "text": "第四，运用诙谐辛辣的讽刺笔法，嘲弄世俗机心并树立后世精神归宿。",
    "start": 186.607,
    "end": 192.259,
    "duration": 5.652
  },
  {
    "id": 34,
    "text": "庄子不仅具有超然物外的诗性哲思，更怀有冷眼观世的批判锐气。",
    "start": 192.897,
    "end": 197.989,
    "duration": 5.092
  },
  {
    "id": 35,
    "text": "他善用夸张、对比与反讽手法，嘲弄汲汲于功名利禄的世俗之人：",
    "start": 198.667,
    "end": 210.199,
    "duration": 11.532
  },
  {
    "id": 36,
    "text": "在《秋水》中，他将惠子所求的梁国相印比作腐鼠，将高洁志趣比作非梧桐不栖的鹓雏；",
    "start": 210.917,
    "end": 213.689,
    "duration": 2.772
  },
  {
    "id": 37,
    "text": "在《列御寇》中，以曹商舔痔得车讽刺阿附权贵之徒。",
    "start": 214.218,
    "end": 215.42,
    "duration": 1.202
  },
  {
    "id": 38,
    "text": "这种辛辣诙谐的讽刺艺术，展现出独立士人蔑视权贵的风骨。",
    "start": 216.138,
    "end": 220.83,
    "duration": 4.692
  },
  {
    "id": 39,
    "text": "《庄子》以其汪洋恣肆的文风、瑰丽想象与寓言传统，",
    "start": 221.508,
    "end": 225.04,
    "duration": 3.532
  },
  {
    "id": 40,
    "text": "深刻滋养了司马迁、阮籍、李白、苏轼等后代文学巨匠，",
    "start": 225.419,
    "end": 229.991,
    "duration": 4.572
  },
  {
    "id": 41,
    "text": "成为中国古代文人超越尘网、安顿心灵的重要精神源泉。",
    "start": 230.37,
    "end": 234.662,
    "duration": 4.292
  },
  {
    "id": 42,
    "text": "综观全书，《庄子》借“三言”与寓言、奇幻想象以及汪洋恣肆的章法，",
    "start": 235.191,
    "end": 240.323,
    "duration": 5.132
  },
  {
    "id": 43,
    "text": "把道家超然物外的哲理思辨化为极具感染力的诗意散文。",
    "start": 240.702,
    "end": 244.794,
    "duration": 4.092
  },
  {
    "id": 44,
    "text": "它在先秦诸子由语录走向专题论辩的进程中独辟审美新境，",
    "start": 245.323,
    "end": 249.855,
    "duration": 4.532
  },
  {
    "id": 45,
    "text": "其崇尚精神自由、讽刺世俗机心的浪漫品格，",
    "start": 250.234,
    "end": 253.766,
    "duration": 3.532
  },
  {
    "id": 46,
    "text": "深刻影响了汉赋、魏晋玄言诗文及李白、苏轼等后代作家的艺术风神。",
    "start": 254.145,
    "end": 259.677,
    "duration": 5.532
  }
]