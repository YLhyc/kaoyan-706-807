[
  {
    "id": 1,
    "text": "试论庄子散文的艺术特色与浪漫主义精神。",
    "start": 0.16,
    "end": 3.399,
    "duration": 3.239
  },
  {
    "id": 2,
    "text": "《庄子》是先秦诸子散文发展史上的高峰，也是中国古代浪漫主义文学的重要源头。",
    "start": 4.087,
    "end": 9.986,
    "duration": 5.899
  },
  {
    "id": 3,
    "text": "面对战国中期兼并战争激化、礼崩乐坏与个体生命朝不保夕的残酷现实，",
    "start": 10.551,
    "end": 16.494,
    "duration": 5.943
  },
  {
    "id": 4,
    "text": "庄子继承并发展了老子的道家思想，构筑起超脱世俗功利、追求精神自由的哲学境界。",
    "start": 17.008,
    "end": 23.958,
    "duration": 6.95
  },
  {
    "id": 5,
    "text": "其散文打破了前期语录体与专题论文的板滞格局，",
    "start": 24.294,
    "end": 28.436,
    "duration": 4.142
  },
  {
    "id": 6,
    "text": "以奇幻诡谲的想象与汪洋恣肆的文风，将哲学思辨与文学诗意融为一体，",
    "start": 28.851,
    "end": 35.067,
    "duration": 6.216
  },
  {
    "id": 7,
    "text": "故鲁迅在《汉文学史纲要》中赞其“晚周诸子之作，莫能先也”。",
    "start": 35.445,
    "end": 40.546,
    "duration": 5.101
  },
  {
    "id": 8,
    "text": "其散文艺术特色与浪漫主义精神，主要体现在以下四个方面：",
    "start": 41.021,
    "end": 45.588,
    "duration": 4.567
  },
  {
    "id": 9,
    "text": "第一，善用“三言”与寓言系统说理，把哲学思辨化为生动形象。",
    "start": 46.245,
    "end": 51.643,
    "duration": 5.398
  },
  {
    "id": 10,
    "text": "庄子散文最突出的表现形式，在于建立了以“寓言”“重言”“卮言”为主体的表述方式。",
    "start": 52.04,
    "end": 58.765,
    "duration": 6.725
  },
  {
    "id": 11,
    "text": "庄子认为玄妙之道难以仅靠抽象概念直接阐发，",
    "start": 59.039,
    "end": 62.96,
    "duration": 3.921
  },
  {
    "id": 12,
    "text": "因而“寓言十九，藉外论之”，借助形象故事寄寓哲理。",
    "start": 63.344,
    "end": 67.761,
    "duration": 4.417
  },
  {
    "id": 13,
    "text": "其寓言取材广博、寄意深微：无论是《庖丁解牛》中以刀刃游于骨节比喻依乎天理的养生之道，",
    "start": 68.01,
    "end": 76.18,
    "duration": 8.17
  },
  {
    "id": 14,
    "text": "还是《秋水》中以河伯与北海的对话喻指认识的有限与无穷，",
    "start": 76.318,
    "end": 81.126,
    "duration": 4.808
  },
  {
    "id": 15,
    "text": "亦或是《人间世》中“螳臂当车”的警示与《养生主》中薪火相传的譬喻，",
    "start": 81.321,
    "end": 87.229,
    "duration": 5.908
  },
  {
    "id": 16,
    "text": "庄子都将抽象道家哲理转化为鲜活可感的艺术形象，赋予散文强大的感染力。",
    "start": 87.442,
    "end": 93.617,
    "duration": 6.175
  },
  {
    "id": 17,
    "text": "第二，展开雄奇飞腾的浪漫想象，突破现实时空束缚以彰显精神自由。",
    "start": 94.306,
    "end": 100.513,
    "duration": 6.207
  },
  {
    "id": 18,
    "text": "浪漫主义精神的核心在于对现实羁绊的主动超越，庄子散文向以超常的想象力著称。",
    "start": 101.098,
    "end": 108.047,
    "duration": 6.949
  },
  {
    "id": 19,
    "text": "他善于在浩渺宇宙与细微万物之间自由跨越：在《逍遥游》开篇，",
    "start": 108.259,
    "end": 113.947,
    "duration": 5.688
  },
  {
    "id": 20,
    "text": "作者以宏阔巨笔描绘鲲鹏展翅，“水击三千里，抟扶摇而上者九万里”，",
    "start": 114.404,
    "end": 121.222,
    "duration": 6.818
  },
  {
    "id": 21,
    "text": "借大鹏由北冥徙南冥的壮阔图景寄寓对广阔境界的向往；",
    "start": 121.578,
    "end": 126.629,
    "duration": 5.051
  },
  {
    "id": 22,
    "text": "在《齐物论》末尾，又以轻灵梦幻的笔触描摹庄周梦蝶，",
    "start": 126.992,
    "end": 131.705,
    "duration": 4.713
  },
  {
    "id": 23,
    "text": "“不知周之梦为胡蝶与，胡蝶之梦为周与”，借物我界限的泯灭展现物化互通的诗意境界。",
    "start": 132.075,
    "end": 140.002,
    "duration": 7.927
  },
  {
    "id": 24,
    "text": "这种超脱世俗功利的飞扬想象，为中国古典文学注入了自由奔放的浪漫气息。",
    "start": 140.226,
    "end": 146.518,
    "duration": 6.292
  },
  {
    "id": 25,
    "text": "第三，形成汪洋恣肆的文体气势，构建跌宕起伏的自由章法。",
    "start": 147.167,
    "end": 152.662,
    "duration": 5.495
  },
  {
    "id": 26,
    "text": "在篇章结构上，庄子散文摆脱了严谨论辩的刻板绳墨，",
    "start": 152.962,
    "end": 157.559,
    "duration": 4.597
  },
  {
    "id": 27,
    "text": "呈现出刘熙载《艺概》所评“意出尘外，怪生笔端”的灵动风貌。",
    "start": 158.037,
    "end": 163.25,
    "duration": 5.213
  },
  {
    "id": 28,
    "text": "文章往往不设呆板提纲，而是由核心意象出发，随物赋形、层层生发，如行云流水般舒卷自如。",
    "start": 163.537,
    "end": 171.921,
    "duration": 8.384
  },
  {
    "id": 29,
    "text": "说理之际，庄子常运用连类比喻与正反翻案之笔，亦真亦幻；",
    "start": 172.562,
    "end": 178.084,
    "duration": 5.522
  },
  {
    "id": 30,
    "text": "其语言跌宕跳跃，句式长短错落，时而如巨澜奔涌、气势磅礴，时而机锋毕露、耐人寻味。",
    "start": 178.454,
    "end": 186.531,
    "duration": 8.077
  },
  {
    "id": 31,
    "text": "这种汪洋恣肆的章法，恰与其追求精神自由的哲学主旨互为表里。",
    "start": 187.264,
    "end": 192.7,
    "duration": 5.436
  },
  {
    "id": 32,
    "text": "第四，运用诙谐辛辣的讽刺笔法，嘲弄世俗机心并树立后世精神归宿。",
    "start": 193.298,
    "end": 199.612,
    "duration": 6.314
  },
  {
    "id": 33,
    "text": "庄子不仅具有超然物外的诗性哲思，更怀有冷眼观世的批判锐气。",
    "start": 199.933,
    "end": 205.002,
    "duration": 5.069
  },
  {
    "id": 34,
    "text": "他善用夸张、对比与反讽手法，嘲弄汲汲于功名利禄的世俗之人：在《秋水》中，",
    "start": 205.397,
    "end": 212.03,
    "duration": 6.633
  },
  {
    "id": 35,
    "text": "他将惠子所求的梁国相印比作腐鼠，将高洁志趣比作非梧桐不栖的鹓雏；",
    "start": 212.338,
    "end": 218.895,
    "duration": 6.557
  },
  {
    "id": 36,
    "text": "在《列御寇》中，以曹商舔痔得车讽刺阿附权贵之徒。",
    "start": 219.044,
    "end": 223.85,
    "duration": 4.806
  },
  {
    "id": 37,
    "text": "这种辛辣诙谐的讽刺艺术，展现出独立士人蔑视权贵的风骨。",
    "start": 224.005,
    "end": 229.112,
    "duration": 5.107
  },
  {
    "id": 38,
    "text": "《庄子》以其汪洋恣肆的文风、瑰丽想象与寓言传统，",
    "start": 229.298,
    "end": 233.997,
    "duration": 4.699
  },
  {
    "id": 39,
    "text": "深刻滋养了司马迁、阮籍、李白、苏轼等后代文学巨匠，",
    "start": 234.249,
    "end": 238.97,
    "duration": 4.721
  },
  {
    "id": 40,
    "text": "成为中国古代文人超越尘网、安顿心灵的重要精神源泉。",
    "start": 239.584,
    "end": 244.096,
    "duration": 4.512
  }
]