[
  {
    "id": "sent_1",
    "text": "《庄子》 是先秦诸子散文发展史上的最高峰，",
    "start": 0.0,
    "end": 3.36,
    "duration": 3.36
  },
  {
    "id": "sent_2",
    "text": "也是中国古代浪漫主义文学的重要源头。",
    "start": 3.809,
    "end": 6.929,
    "duration": 3.12
  },
  {
    "id": "sent_3",
    "text": "面对战国中期兼并战争激化、",
    "start": 7.379,
    "end": 9.819,
    "duration": 2.44
  },
  {
    "id": "sent_4",
    "text": "礼崩乐坏与个体生命朝不保夕的残酷现实，",
    "start": 10.269,
    "end": 13.749,
    "duration": 3.48
  },
  {
    "id": "sent_5",
    "text": "庄子继承并发展了老子的道家思想，",
    "start": 14.199,
    "end": 16.879,
    "duration": 2.68
  },
  {
    "id": "sent_6",
    "text": "以超脱功利的哲学省思构筑起追求绝对精神自由的理想境界。",
    "start": 17.409,
    "end": 22.249,
    "duration": 4.84
  },
  {
    "id": "sent_7",
    "text": "其散文彻底打破了前期诸子语录体与专题论文的板滞体式，",
    "start": 22.699,
    "end": 27.459,
    "duration": 4.76
  },
  {
    "id": "sent_8",
    "text": "以瑰丽诡谲的想象与汪洋恣肆的文风，",
    "start": 27.909,
    "end": 30.789,
    "duration": 2.88
  },
  {
    "id": "sent_9",
    "text": "实现了哲学理性与文学诗意的高度融合。",
    "start": 31.239,
    "end": 34.559,
    "duration": 3.32
  },
  {
    "id": "sent_10",
    "text": "郭沫若称其文章 “实可代表战国时代之艺术诸峰”。",
    "start": 35.009,
    "end": 38.849,
    "duration": 3.84
  },
  {
    "id": "sent_11",
    "text": "其散文艺术特色与浪漫主义精神，主要展现为以下四个核心维度：",
    "start": 39.299,
    "end": 44.419,
    "duration": 5.12
  },
  {
    "id": "sent_12",
    "text": "第一，善用“三言”寓言系统论道，",
    "start": 44.869,
    "end": 47.429,
    "duration": 2.56
  },
  {
    "id": "sent_13",
    "text": "实现哲学思辨与文学形象的完美统一。",
    "start": 47.879,
    "end": 50.999,
    "duration": 3.12
  },
  {
    "id": "sent_14",
    "text": "庄子散文最突出的表现形式，在于建立了以 “寓言”、“重言”、",
    "start": 51.449,
    "end": 56.129,
    "duration": 4.68
  },
  {
    "id": "sent_15",
    "text": "“卮言” 为主体的表述机制。",
    "start": 56.579,
    "end": 58.579,
    "duration": 2.0
  },
  {
    "id": "sent_16",
    "text": "庄子认为深邃之道难以用抽象概念直接阐发，因而 “寓言十九，",
    "start": 59.029,
    "end": 64.029,
    "duration": 5.0
  },
  {
    "id": "sent_17",
    "text": "藉外论之”，借助生动形象的故事寄寓哲学玄理。",
    "start": 64.479,
    "end": 68.279,
    "duration": 3.8
  },
  {
    "id": "sent_18",
    "text": "其寓言取材广泛、寄寓深刻：",
    "start": 68.729,
    "end": 71.329,
    "duration": 2.6
  },
  {
    "id": "sent_19",
    "text": "无论是 《庖丁解牛》 中以刀刃游于骨节之间比喻依乎天理的养生之道，",
    "start": 71.779,
    "end": 77.499,
    "duration": 5.72
  },
  {
    "id": "sent_20",
    "text": "还是 《秋水》 中以河伯与北海的对话比喻宇宙认知之有限与无穷，",
    "start": 78.029,
    "end": 83.349,
    "duration": 5.32
  },
  {
    "id": "sent_21",
    "text": "亦或是 《养生主》 中螳臂当车、薪火相传的譬喻，",
    "start": 83.799,
    "end": 87.679,
    "duration": 3.88
  },
  {
    "id": "sent_22",
    "text": "庄子将艰涩的道家哲理具象化为活泼灵动的人间场景与自然物象，",
    "start": 88.129,
    "end": 93.449,
    "duration": 5.32
  },
  {
    "id": "sent_23",
    "text": "极大地增强了散文的生动性与穿透力。",
    "start": 93.899,
    "end": 96.739,
    "duration": 2.84
  },
  {
    "id": "sent_24",
    "text": "第二，展开雄奇飞腾的浪漫想象，",
    "start": 97.189,
    "end": 99.749,
    "duration": 2.56
  },
  {
    "id": "sent_25",
    "text": "突破现实时空拘牵以彰显精神自由。",
    "start": 100.199,
    "end": 103.319,
    "duration": 3.12
  },
  {
    "id": "sent_26",
    "text": "浪漫主义精神的核心在于对现实束缚的主动超越，",
    "start": 103.769,
    "end": 107.329,
    "duration": 3.56
  },
  {
    "id": "sent_27",
    "text": "庄子散文以奇幻莫测的想象力著称。",
    "start": 107.779,
    "end": 110.459,
    "duration": 2.68
  },
  {
    "id": "sent_28",
    "text": "他善于在宏阔辽远的宇宙时空与细微精妙的尘世万物之间自由跨越：",
    "start": 111.029,
    "end": 116.589,
    "duration": 5.56
  },
  {
    "id": "sent_29",
    "text": "在 《逍遥游》 开篇，作者以极具震撼力的巨笔描绘大鹏展翅，",
    "start": 117.039,
    "end": 121.599,
    "duration": 4.56
  },
  {
    "id": "sent_30",
    "text": "“水击三千里，抟扶摇而上者九万里”，",
    "start": 122.049,
    "end": 125.329,
    "duration": 3.28
  },
  {
    "id": "sent_31",
    "text": "以鹏鸟由北冥迁往南冥的辽阔图景寄寓对广阔精神境界的向往；",
    "start": 125.779,
    "end": 131.139,
    "duration": 5.36
  },
  {
    "id": "sent_32",
    "text": "在 《齐物论》 末尾，他又以轻灵梦幻的笔触描摹庄周梦蝶，",
    "start": 131.589,
    "end": 136.029,
    "duration": 4.44
  },
  {
    "id": "sent_33",
    "text": "“不知周之梦为胡蝶与，胡蝶之梦为周与”，",
    "start": 136.559,
    "end": 140.159,
    "duration": 3.6
  },
  {
    "id": "sent_34",
    "text": "借物我界限的消解展现物化互通的诗意境界。",
    "start": 140.609,
    "end": 144.449,
    "duration": 3.84
  },
  {
    "id": "sent_35",
    "text": "这种摆脱世俗功利的飞扬想象，",
    "start": 144.899,
    "end": 147.179,
    "duration": 2.28
  },
  {
    "id": "sent_36",
    "text": "为中国古典文学注入了自由奔放的浪漫血液。",
    "start": 147.709,
    "end": 151.229,
    "duration": 3.52
  },
  {
    "id": "sent_37",
    "text": "第三，形成汪洋恣肆的文体气势，构建跌宕起伏的自由章法。",
    "start": 151.679,
    "end": 156.759,
    "duration": 5.08
  },
  {
    "id": "sent_38",
    "text": "在篇章结构上，庄子散文彻底摆脱了逻辑论辩的刻板绳墨，",
    "start": 157.209,
    "end": 162.049,
    "duration": 4.84
  },
  {
    "id": "sent_39",
    "text": "呈现出“意出尘外，怪生笔端”的灵动多变。",
    "start": 162.499,
    "end": 165.739,
    "duration": 3.24
  },
  {
    "id": "sent_40",
    "text": "文章往往不立死板提纲，而是由一个核心哲学意象出发，随物赋形、",
    "start": 166.189,
    "end": 171.669,
    "duration": 5.48
  },
  {
    "id": "sent_41",
    "text": "层层生发，如行云流水般舒卷自如。",
    "start": 172.119,
    "end": 175.199,
    "duration": 3.08
  },
  {
    "id": "sent_42",
    "text": "在阐述观点时，庄子常运用连类比喻与反弹翻案之笔，正说反说、",
    "start": 175.649,
    "end": 181.169,
    "duration": 5.52
  },
  {
    "id": "sent_43",
    "text": "亦真亦幻；",
    "start": 181.619,
    "end": 182.619,
    "duration": 1.0
  },
  {
    "id": "sent_44",
    "text": "其语言跌宕跳跃，句式长短错落，时而如巨澜奔涌、气势磅礴，",
    "start": 183.069,
    "end": 188.509,
    "duration": 5.44
  },
  {
    "id": "sent_45",
    "text": "时而如清溪浅唱、机锋毕露。",
    "start": 188.959,
    "end": 191.559,
    "duration": 2.6
  },
  {
    "id": "sent_46",
    "text": "这种汪洋恣肆的散文结构，",
    "start": 192.008,
    "end": 194.248,
    "duration": 2.24
  },
  {
    "id": "sent_47",
    "text": "恰与其追求精神绝对自由的哲学主旨互为表里。",
    "start": 194.698,
    "end": 198.498,
    "duration": 3.8
  },
  {
    "id": "sent_48",
    "text": "第四，运用诙谐辛辣的论辩讽刺，",
    "start": 198.948,
    "end": 201.908,
    "duration": 2.96
  },
  {
    "id": "sent_49",
    "text": "对世俗礼教与功名机心进行深刻消解。",
    "start": 202.438,
    "end": 205.678,
    "duration": 3.24
  },
  {
    "id": "sent_50",
    "text": "庄子不仅具有超然物外的诗性哲思，更怀抱冷眼观世的深刻批判力。",
    "start": 206.128,
    "end": 211.688,
    "duration": 5.56
  },
  {
    "id": "sent_51",
    "text": "他善于运用夸张、对比与反讽手法，",
    "start": 212.138,
    "end": 215.098,
    "duration": 2.96
  },
  {
    "id": "sent_52",
    "text": "对当时热衷于功名利禄的儒墨名法各家进行无情嘲弄。",
    "start": 215.548,
    "end": 219.828,
    "duration": 4.28
  },
  {
    "id": "sent_53",
    "text": "在 《秋水》 中，他将惠子汲汲以求的梁国相印比作腐烂的老鼠，",
    "start": 220.278,
    "end": 225.198,
    "duration": 4.92
  },
  {
    "id": "sent_54",
    "text": "将自身的高洁追求比作非梧桐不栖、非练实不食的鹓雏；",
    "start": 225.648,
    "end": 230.408,
    "duration": 4.76
  },
  {
    "id": "sent_55",
    "text": "在 《列御寇》 中，以探骊得珠的凶险讽刺依附权贵、",
    "start": 230.938,
    "end": 235.098,
    "duration": 4.16
  },
  {
    "id": "sent_56",
    "text": "贪图富贵的弄臣。",
    "start": 235.548,
    "end": 237.108,
    "duration": 1.56
  },
  {
    "id": "sent_57",
    "text": "这种辛辣诙谐的讽刺艺术，",
    "start": 237.558,
    "end": 239.678,
    "duration": 2.12
  },
  {
    "id": "sent_58",
    "text": "不仅极大地增强了散文的战斗力与戏剧感，",
    "start": 240.128,
    "end": 243.248,
    "duration": 3.12
  },
  {
    "id": "sent_59",
    "text": "更展现出一位独立知识分子蔑视权贵、傲立世俗的高贵风骨。",
    "start": 243.698,
    "end": 248.538,
    "duration": 4.84
  }
]