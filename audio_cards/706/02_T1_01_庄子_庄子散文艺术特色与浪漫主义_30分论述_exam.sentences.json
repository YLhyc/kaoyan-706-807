[
  {
    "id": "sent_1",
    "text": "《庄子》 是先秦诸子散文发展史上的最高峰，",
    "start": 0.1,
    "end": 4.659,
    "duration": 4.559
  },
  {
    "id": "sent_2",
    "text": "也是中国古代浪漫主义文学的重要源头。",
    "start": 4.609,
    "end": 8.255,
    "duration": 3.646
  },
  {
    "id": "sent_3",
    "text": "面对战国中期兼并战争激化、礼崩乐坏与个体生命朝不保夕的残酷现实，",
    "start": 8.255,
    "end": 15.156,
    "duration": 6.901
  },
  {
    "id": "sent_4",
    "text": "庄子继承并发展了老子的道家思想，",
    "start": 15.156,
    "end": 18.659,
    "duration": 3.503
  },
  {
    "id": "sent_5",
    "text": "以超脱功利的哲学省思构筑起追求绝对精神自由的理想境界。",
    "start": 18.659,
    "end": 24.466,
    "duration": 5.807
  },
  {
    "id": "sent_6",
    "text": "其散文彻底打破了前期诸子语录体与专题论文的板滞体式，",
    "start": 24.466,
    "end": 30.077,
    "duration": 5.611
  },
  {
    "id": "sent_7",
    "text": "以瑰丽诡谲的想象与汪洋恣肆的文风，",
    "start": 30.078,
    "end": 33.75,
    "duration": 3.672
  },
  {
    "id": "sent_8",
    "text": "实现了哲学理性与文学诗意的高度融合。",
    "start": 33.75,
    "end": 37.747,
    "duration": 3.997
  },
  {
    "id": "sent_9",
    "text": "郭沫若称其文章 “实可代表战国时代之艺术诸峰”。",
    "start": 37.747,
    "end": 42.343,
    "duration": 4.596
  },
  {
    "id": "sent_10",
    "text": "其散文艺术特色与浪漫主义精神，主要展现为以下四个核心维度：",
    "start": 42.344,
    "end": 48.568,
    "duration": 6.224
  },
  {
    "id": "sent_11",
    "text": "第一，善用“三言”寓言系统论道，",
    "start": 48.568,
    "end": 51.81,
    "duration": 3.242
  },
  {
    "id": "sent_12",
    "text": "实现哲学思辨与文学形象的完美统一。",
    "start": 51.81,
    "end": 55.716,
    "duration": 3.906
  },
  {
    "id": "sent_13",
    "text": "庄子散文最突出的表现形式，",
    "start": 55.716,
    "end": 58.62,
    "duration": 2.904
  },
  {
    "id": "sent_14",
    "text": "在于建立了以 “寓言”、“重言”、“卮言” 为主体的表述机制。",
    "start": 58.62,
    "end": 63.75,
    "duration": 5.13
  },
  {
    "id": "sent_15",
    "text": "庄子认为深邃之道难以用抽象概念直接阐发，因而 “寓言十九，",
    "start": 63.75,
    "end": 70.143,
    "duration": 6.393
  },
  {
    "id": "sent_16",
    "text": "藉外论之”，借助生动形象的故事寄寓哲学玄理。",
    "start": 70.143,
    "end": 74.648,
    "duration": 4.505
  },
  {
    "id": "sent_17",
    "text": "其寓言取材广泛、寄寓深刻：",
    "start": 74.648,
    "end": 77.643,
    "duration": 2.995
  },
  {
    "id": "sent_18",
    "text": "无论是 《庖丁解牛》 中以刀刃游于骨节之间比喻依乎天理的养生之道，",
    "start": 77.643,
    "end": 83.763,
    "duration": 6.12
  },
  {
    "id": "sent_19",
    "text": "还是 《秋水》 中以河伯与北海的对话比喻宇宙认知之有限与无穷，",
    "start": 83.763,
    "end": 89.766,
    "duration": 6.003
  },
  {
    "id": "sent_20",
    "text": "亦或是 《养生主》 中螳臂当车、薪火相传的譬喻，",
    "start": 89.766,
    "end": 94.219,
    "duration": 4.453
  },
  {
    "id": "sent_21",
    "text": "庄子将艰涩的道家哲理具象化为活泼灵动的人间场景与自然物象，",
    "start": 94.219,
    "end": 100.651,
    "duration": 6.432
  },
  {
    "id": "sent_22",
    "text": "极大地增强了散文的生动性与穿透力。",
    "start": 100.651,
    "end": 104.362,
    "duration": 3.711
  },
  {
    "id": "sent_23",
    "text": "第二，展开雄奇飞腾的浪漫想象，突破现实时空拘牵以彰显精神自由。",
    "start": 104.362,
    "end": 111.341,
    "duration": 6.979
  },
  {
    "id": "sent_24",
    "text": "浪漫主义精神的核心在于对现实束缚的主动超越，",
    "start": 111.341,
    "end": 115.937,
    "duration": 4.596
  },
  {
    "id": "sent_25",
    "text": "庄子散文以奇幻莫测的想象力著称。",
    "start": 115.938,
    "end": 119.558,
    "duration": 3.62
  },
  {
    "id": "sent_26",
    "text": "他善于在宏阔辽远的宇宙时空与细微精妙的尘世万物之间自由跨越：",
    "start": 119.557,
    "end": 125.82,
    "duration": 6.263
  },
  {
    "id": "sent_27",
    "text": "在 《逍遥游》 开篇，作者以极具震撼力的巨笔描绘大鹏展翅，",
    "start": 125.82,
    "end": 131.536,
    "duration": 5.716
  },
  {
    "id": "sent_28",
    "text": "“水击三千里，抟扶摇而上者九万里”，",
    "start": 131.536,
    "end": 135.273,
    "duration": 3.737
  },
  {
    "id": "sent_29",
    "text": "以鹏鸟由北冥迁往南冥的辽阔图景寄寓对广阔精神境界的向往；",
    "start": 135.273,
    "end": 141.64,
    "duration": 6.367
  },
  {
    "id": "sent_30",
    "text": "在 《齐物论》 末尾，他又以轻灵梦幻的笔触描摹庄周梦蝶，",
    "start": 141.641,
    "end": 146.758,
    "duration": 5.117
  },
  {
    "id": "sent_31",
    "text": "“不知周之梦为胡蝶与，胡蝶之梦为周与”，",
    "start": 146.758,
    "end": 151.029,
    "duration": 4.271
  },
  {
    "id": "sent_32",
    "text": "借物我界限的消解展现物化互通的诗意境界。",
    "start": 151.029,
    "end": 155.456,
    "duration": 4.427
  },
  {
    "id": "sent_33",
    "text": "这种摆脱世俗功利的飞扬想象，",
    "start": 155.456,
    "end": 158.659,
    "duration": 3.203
  },
  {
    "id": "sent_34",
    "text": "为中国古典文学注入了自由奔放的浪漫血液。",
    "start": 158.659,
    "end": 163.008,
    "duration": 4.349
  },
  {
    "id": "sent_35",
    "text": "第三，形成汪洋恣肆的文体气势，构建跌宕起伏的自由章法。",
    "start": 163.008,
    "end": 168.724,
    "duration": 5.716
  },
  {
    "id": "sent_36",
    "text": "在篇章结构上，庄子散文彻底摆脱了逻辑论辩的刻板绳墨，",
    "start": 168.724,
    "end": 174.362,
    "duration": 5.638
  },
  {
    "id": "sent_37",
    "text": "呈现出“意出尘外，怪生笔端”的灵动多变。",
    "start": 174.362,
    "end": 178.177,
    "duration": 3.815
  },
  {
    "id": "sent_38",
    "text": "文章往往不立死板提纲，而是由一个核心哲学意象出发，",
    "start": 178.177,
    "end": 183.164,
    "duration": 4.987
  },
  {
    "id": "sent_39",
    "text": "随物赋形、层层生发，如行云流水般舒卷自如。",
    "start": 183.164,
    "end": 188.164,
    "duration": 5.0
  },
  {
    "id": "sent_40",
    "text": "在阐述观点时，庄子常运用连类比喻与反弹翻案之笔，",
    "start": 188.164,
    "end": 193.633,
    "duration": 5.469
  },
  {
    "id": "sent_41",
    "text": "正说反说、亦真亦幻；",
    "start": 193.633,
    "end": 196.198,
    "duration": 2.565
  },
  {
    "id": "sent_42",
    "text": "其语言跌宕跳跃，句式长短错落，时而如巨澜奔涌、气势磅礴，",
    "start": 196.198,
    "end": 202.149,
    "duration": 5.951
  },
  {
    "id": "sent_43",
    "text": "时而如清溪浅唱、机锋毕露。",
    "start": 202.148,
    "end": 205.39,
    "duration": 3.242
  },
  {
    "id": "sent_44",
    "text": "这种汪洋恣肆的散文结构，",
    "start": 205.391,
    "end": 208.164,
    "duration": 2.773
  },
  {
    "id": "sent_45",
    "text": "恰与其追求精神绝对自由的哲学主旨互为表里。",
    "start": 208.164,
    "end": 212.695,
    "duration": 4.531
  },
  {
    "id": "sent_46",
    "text": "第四，运用诙谐辛辣的论辩讽刺，对世俗礼教与功名机心进行深刻消解。",
    "start": 212.695,
    "end": 219.609,
    "duration": 6.914
  },
  {
    "id": "sent_47",
    "text": "庄子不仅具有超然物外的诗性哲思，更怀抱冷眼观世的深刻批判力。",
    "start": 219.609,
    "end": 225.781,
    "duration": 6.172
  },
  {
    "id": "sent_48",
    "text": "他善于运用夸张、对比与反讽手法，",
    "start": 225.781,
    "end": 229.531,
    "duration": 3.75
  },
  {
    "id": "sent_49",
    "text": "对当时热衷于功名利禄的儒墨名法各家进行无情嘲弄。",
    "start": 229.531,
    "end": 234.817,
    "duration": 5.286
  },
  {
    "id": "sent_50",
    "text": "在 《秋水》 中，他将惠子汲汲以求的梁国相印比作腐烂的老鼠，",
    "start": 234.818,
    "end": 240.378,
    "duration": 5.56
  },
  {
    "id": "sent_51",
    "text": "将自身的高洁追求比作非梧桐不栖、非练实不食的鹓雏；",
    "start": 240.378,
    "end": 246.068,
    "duration": 5.69
  },
  {
    "id": "sent_52",
    "text": "在 《列御寇》 中，",
    "start": 246.068,
    "end": 247.774,
    "duration": 1.706
  },
  {
    "id": "sent_53",
    "text": "以探骊得珠的凶险讽刺依附权贵、贪图富贵的弄臣。",
    "start": 247.773,
    "end": 253.02,
    "duration": 5.247
  },
  {
    "id": "sent_54",
    "text": "这种辛辣诙谐的讽刺艺术，不仅极大地增强了散文的战斗力与戏剧感，",
    "start": 253.021,
    "end": 259.44,
    "duration": 6.419
  },
  {
    "id": "sent_55",
    "text": "更展现出一位独立知识分子蔑视权贵、傲立世俗的高贵风骨。",
    "start": 259.44,
    "end": 265.338,
    "duration": 5.898
  }
]