[
  {
    "id": 1,
    "text": "试论庄子散文的艺术特色与浪漫主义精神。",
    "start": 0.16,
    "end": 3.379,
    "duration": 3.219
  },
  {
    "id": 2,
    "text": "《庄子》是先秦诸子散文发展史上的高峰，也是中国古代浪漫主义文学的重要源头。",
    "start": 4.087,
    "end": 9.972,
    "duration": 5.885
  },
  {
    "id": 3,
    "text": "面对战国中期兼并战争激化、礼崩乐坏与个体生命朝不保夕的残酷现实，",
    "start": 10.551,
    "end": 16.475,
    "duration": 5.924
  },
  {
    "id": 4,
    "text": "庄子继承并发展了老子的道家思想，构筑起超脱世俗功利、追求精神自由的哲学境界。",
    "start": 17.008,
    "end": 23.958,
    "duration": 6.95
  },
  {
    "id": 5,
    "text": "其散文打破了前期语录体与专题论文的板滞格局，",
    "start": 24.478,
    "end": 28.62,
    "duration": 4.142
  },
  {
    "id": 6,
    "text": "以奇幻诡谲的想象与汪洋恣肆的文风，将哲学思辨与文学诗意融为一体，",
    "start": 29.035,
    "end": 35.251,
    "duration": 6.216
  },
  {
    "id": 7,
    "text": "故鲁迅在《汉文学史纲要》中赞其“晚周诸子之作，莫能先也”。",
    "start": 35.629,
    "end": 40.73,
    "duration": 5.101
  },
  {
    "id": 8,
    "text": "其散文艺术特色与浪漫主义精神，主要体现在以下四个方面：",
    "start": 41.25,
    "end": 45.817,
    "duration": 4.567
  },
  {
    "id": 9,
    "text": "第一，善用“三言”与寓言系统说理，把哲学思辨化为生动形象。",
    "start": 46.474,
    "end": 51.853,
    "duration": 5.379
  },
  {
    "id": 10,
    "text": "庄子散文最突出的表现形式，在于建立了以“寓言”“重言”“卮言”为主体的表述方式。",
    "start": 52.373,
    "end": 59.098,
    "duration": 6.725
  },
  {
    "id": 11,
    "text": "庄子认为玄妙之道难以仅靠抽象概念直接阐发，",
    "start": 59.618,
    "end": 63.539,
    "duration": 3.921
  },
  {
    "id": 12,
    "text": "因而“寓言十九，藉外论之”，借助形象故事寄寓哲理。",
    "start": 63.923,
    "end": 68.328,
    "duration": 4.405
  },
  {
    "id": 13,
    "text": "其寓言取材广博、寄意深微：",
    "start": 68.848,
    "end": 71.578,
    "duration": 2.73
  },
  {
    "id": 14,
    "text": "无论是《庖丁解牛》中以刀刃游于骨节比喻依乎天理的养生之道，",
    "start": 71.948,
    "end": 77.122,
    "duration": 5.174
  },
  {
    "id": 15,
    "text": "还是《秋水》中以河伯与北海的对话喻指认识的有限与无穷，",
    "start": 77.492,
    "end": 82.3,
    "duration": 4.808
  },
  {
    "id": 16,
    "text": "亦或是《人间世》中“螳臂当车”的警示与《养生主》中薪火相传的譬喻，",
    "start": 82.67,
    "end": 88.578,
    "duration": 5.908
  },
  {
    "id": 17,
    "text": "庄子都将抽象道家哲理转化为鲜活可感的艺术形象，赋予散文强大的感染力。",
    "start": 88.948,
    "end": 95.123,
    "duration": 6.175
  },
  {
    "id": 18,
    "text": "第二，展开雄奇飞腾的浪漫想象，突破现实时空束缚以彰显精神自由。",
    "start": 95.812,
    "end": 102.019,
    "duration": 6.207
  },
  {
    "id": 19,
    "text": "浪漫主义精神的核心在于对现实羁绊的主动超越，庄子散文向以超常的想象力著称。",
    "start": 102.604,
    "end": 109.553,
    "duration": 6.949
  },
  {
    "id": 20,
    "text": "他善于在浩渺宇宙与细微万物之间自由跨越：",
    "start": 110.073,
    "end": 114.055,
    "duration": 3.982
  },
  {
    "id": 21,
    "text": "在《逍遥游》开篇，作者以宏阔巨笔描绘鲲鹏展翅，“水击三千里，抟扶摇而上者九万里”，",
    "start": 114.425,
    "end": 123.101,
    "duration": 8.676
  },
  {
    "id": 22,
    "text": "借大鹏由北冥徙南冥的壮阔图景寄寓对广阔境界的向往；",
    "start": 123.471,
    "end": 128.522,
    "duration": 5.051
  },
  {
    "id": 23,
    "text": "在《齐物论》末尾，又以轻灵梦幻的笔触描摹庄周梦蝶，",
    "start": 129.042,
    "end": 133.755,
    "duration": 4.713
  },
  {
    "id": 24,
    "text": "“不知周之梦为胡蝶与，胡蝶之梦为周与”，借物我界限的泯灭展现物化互通的诗意境界。",
    "start": 134.125,
    "end": 142.052,
    "duration": 7.927
  },
  {
    "id": 25,
    "text": "这种超脱世俗功利的飞扬想象，为中国古典文学注入了自由奔放的浪漫气息。",
    "start": 142.572,
    "end": 148.864,
    "duration": 6.292
  },
  {
    "id": 26,
    "text": "第三，形成汪洋恣肆的文体气势，构建跌宕起伏的自由章法。",
    "start": 149.513,
    "end": 155.008,
    "duration": 5.495
  },
  {
    "id": 27,
    "text": "在篇章结构上，庄子散文摆脱了严谨论辩的刻板绳墨，",
    "start": 155.528,
    "end": 160.125,
    "duration": 4.597
  },
  {
    "id": 28,
    "text": "呈现出刘熙载《艺概》所评“意出尘外，怪生笔端”的灵动风貌。",
    "start": 160.603,
    "end": 165.816,
    "duration": 5.213
  },
  {
    "id": 29,
    "text": "文章往往不设呆板提纲，而是由核心意象出发，随物赋形、层层生发，如行云流水般舒卷自如。",
    "start": 166.336,
    "end": 174.72,
    "duration": 8.384
  },
  {
    "id": 30,
    "text": "说理之际，庄子常运用连类比喻与正反翻案之笔，亦真亦幻；",
    "start": 175.361,
    "end": 180.883,
    "duration": 5.522
  },
  {
    "id": 31,
    "text": "其语言跌宕跳跃，句式长短错落，时而如巨澜奔涌、气势磅礴，时而机锋毕露、耐人寻味。",
    "start": 181.403,
    "end": 189.48,
    "duration": 8.077
  },
  {
    "id": 32,
    "text": "这种汪洋恣肆的章法，恰与其追求精神自由的哲学主旨互为表里。",
    "start": 190.213,
    "end": 195.649,
    "duration": 5.436
  },
  {
    "id": 33,
    "text": "第四，运用诙谐辛辣的讽刺笔法，嘲弄世俗机心并树立后世精神归宿。",
    "start": 196.247,
    "end": 202.561,
    "duration": 6.314
  },
  {
    "id": 34,
    "text": "庄子不仅具有超然物外的诗性哲思，更怀有冷眼观世的批判锐气。",
    "start": 203.081,
    "end": 208.15,
    "duration": 5.069
  },
  {
    "id": 35,
    "text": "他善用夸张、对比与反讽手法，嘲弄汲汲于功名利禄的世俗之人：",
    "start": 208.67,
    "end": 214.01,
    "duration": 5.34
  },
  {
    "id": 36,
    "text": "在《秋水》中，他将惠子所求的梁国相印比作腐鼠，将高洁志趣比作非梧桐不栖的鹓雏；",
    "start": 214.488,
    "end": 222.168,
    "duration": 7.68
  },
  {
    "id": 37,
    "text": "在《列御寇》中，以曹商舔痔得车讽刺阿附权贵之徒。",
    "start": 222.688,
    "end": 227.494,
    "duration": 4.806
  },
  {
    "id": 38,
    "text": "这种辛辣诙谐的讽刺艺术，展现出独立士人蔑视权贵的风骨。",
    "start": 228.014,
    "end": 233.121,
    "duration": 5.107
  },
  {
    "id": 39,
    "text": "《庄子》以其汪洋恣肆的文风、瑰丽想象与寓言传统，",
    "start": 233.641,
    "end": 238.34,
    "duration": 4.699
  },
  {
    "id": 40,
    "text": "深刻滋养了司马迁、阮籍、李白、苏轼等后代文学巨匠，",
    "start": 238.71,
    "end": 243.431,
    "duration": 4.721
  },
  {
    "id": 41,
    "text": "成为中国古代文人超越尘网、安顿心灵的重要精神源泉。",
    "start": 243.819,
    "end": 248.331,
    "duration": 4.512
  },
  {
    "id": 42,
    "text": "综观全书，《庄子》借“三言”与寓言、奇幻想象以及汪洋恣肆的章法，",
    "start": 248.851,
    "end": 254.726,
    "duration": 5.875
  },
  {
    "id": 43,
    "text": "把道家超然物外的哲理思辨化为极具感染力的诗意散文。",
    "start": 255.096,
    "end": 259.474,
    "duration": 4.378
  },
  {
    "id": 44,
    "text": "它在先秦诸子由语录走向专题论辩的进程中独辟审美新境，",
    "start": 259.994,
    "end": 264.951,
    "duration": 4.957
  },
  {
    "id": 45,
    "text": "其崇尚精神自由、讽刺世俗机心的浪漫品格，",
    "start": 265.321,
    "end": 268.713,
    "duration": 3.392
  },
  {
    "id": 46,
    "text": "深刻影响了汉赋、魏晋玄言诗文及李白、苏轼等后代作家的艺术风神。",
    "start": 269.083,
    "end": 275.171,
    "duration": 6.088
  }
]