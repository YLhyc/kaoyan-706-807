[
  {
    "id": 1,
    "text": "试论关汉卿《窦娥冤》的悲剧艺术成就与社会反抗精神。",
    "start": 0.101,
    "end": 4.083,
    "duration": 3.982
  },
  {
    "id": 2,
    "text": "关汉卿的《窦娥冤》（全名《感天动地窦娥冤》）是元代杂剧乃至中国古典悲剧的杰出代表。",
    "start": 4.583,
    "end": 11.411,
    "duration": 6.828
  },
  {
    "id": 3,
    "text": "在元代民族压迫深重、吏治腐败与高利贷横行的黑暗社会中，关汉卿立足市井民间，",
    "start": 11.911,
    "end": 18.379,
    "duration": 6.468
  },
  {
    "id": 4,
    "text": "以无辜寡妇窦娥的冤案为线索，写出了“惊心动魄的人间惨象”。",
    "start": 18.729,
    "end": 23.651,
    "duration": 4.922
  },
  {
    "id": 5,
    "text": "王国维在《宋元戏曲考》中高度评价此剧“即列之于世界大悲剧中，亦无愧色也”。",
    "start": 24.151,
    "end": 30.342,
    "duration": 6.191
  },
  {
    "id": 6,
    "text": "《窦娥冤》的悲剧艺术成就与社会反抗精神，主要体现在以下四个方面：",
    "start": 30.842,
    "end": 35.748,
    "duration": 4.906
  },
  {
    "id": 7,
    "text": "第一，植根元代严酷社会现实，塑造善良坚贞而宁死不屈的底层女性典型。",
    "start": 36.369,
    "end": 43.156,
    "duration": 6.787
  },
  {
    "id": 8,
    "text": "关汉卿摒弃了虚幻的才子佳人套路，将悲剧冲突深植于元代社会的罪恶土壤之中。",
    "start": 43.656,
    "end": 50.863,
    "duration": 7.207
  },
  {
    "id": 9,
    "text": "窦娥自幼沦为童养媳，早年丧夫，恪守妇道奉养蔡婆婆，本是一位逆来顺受的善良女子。",
    "start": 51.363,
    "end": 58.603,
    "duration": 7.24
  },
  {
    "id": 10,
    "text": "但赛卢医的赖账图害、地痞张驴儿父子的勒索诬陷，",
    "start": 59.103,
    "end": 63.136,
    "duration": 4.033
  },
  {
    "id": 11,
    "text": "以及楚州贪官桃杌只认钱财、滥用酷刑的草菅人命，步步将她推入绝境。",
    "start": 63.638,
    "end": 69.925,
    "duration": 6.287
  },
  {
    "id": 12,
    "text": "窦娥为保护婆婆不受杖刑而含冤屈招，彰显其仁孝至善；",
    "start": 70.425,
    "end": 75.439,
    "duration": 5.014
  },
  {
    "id": 13,
    "text": "而在公堂与法场上面对强权，她又宁死不愿顺从张驴儿的逼婚，",
    "start": 75.939,
    "end": 80.664,
    "duration": 4.725
  },
  {
    "id": 14,
    "text": "展现出底层女性不屈的人格尊严。",
    "start": 81.278,
    "end": 83.964,
    "duration": 2.686
  },
  {
    "id": 15,
    "text": "第二，将现实写实与浪漫想象交融，以感天动地的三桩誓愿凸显崇高悲剧力量。",
    "start": 84.563,
    "end": 91.397,
    "duration": 6.834
  },
  {
    "id": 16,
    "text": "在第三折法场受刑的高潮处，关汉卿突破了纯客观的写实局限，化用东海孝妇等民间传说，",
    "start": 91.994,
    "end": 99.226,
    "duration": 7.232
  },
  {
    "id": 17,
    "text": "虚构了“血溅白练”“六月飞雪”“亢旱三年”三桩誓愿并一一体现。",
    "start": 99.576,
    "end": 104.403,
    "duration": 4.827
  },
  {
    "id": 18,
    "text": "鲜血逆飞高悬素练、炎夏六月飞雪掩尸、楚州大地连旱三年，",
    "start": 104.903,
    "end": 110.431,
    "duration": 5.528
  },
  {
    "id": 19,
    "text": "这些超现实的奇异景象，以天意见证窦娥的清白无辜，",
    "start": 110.851,
    "end": 115.356,
    "duration": 4.505
  },
  {
    "id": 20,
    "text": "借助奇幻笔墨对人世间贪官恶霸的暴行发出严厉控诉与警世裁决，",
    "start": 115.706,
    "end": 121.085,
    "duration": 5.379
  },
  {
    "id": 21,
    "text": "将个人冤屈升华为撼动天地的社会抗议，产生强烈的悲剧震撼力。",
    "start": 121.509,
    "end": 127.326,
    "duration": 5.817
  },
  {
    "id": 22,
    "text": "第三，由忍辱顺从递进到愤慨斥天，细致展现窦娥由屈从到抗争的觉醒轨迹。",
    "start": 127.92,
    "end": 135.092,
    "duration": 7.172
  },
  {
    "id": 23,
    "text": "剧作的高妙之处，在于紧扣压迫步步紧逼的过程，写出窦娥反抗意识的层层升华。",
    "start": 135.592,
    "end": 141.995,
    "duration": 6.403
  },
  {
    "id": 24,
    "text": "起初窦娥敬畏天命、守分安命，幻想官府能替民作主；",
    "start": 142.495,
    "end": 146.737,
    "duration": 4.242
  },
  {
    "id": 25,
    "text": "随着酷刑加身、冤案铸成，她的幻想被残酷现实击碎。",
    "start": 147.237,
    "end": 151.299,
    "duration": 4.062
  },
  {
    "id": 26,
    "text": "在押赴刑场的【滚绣球】一曲中，她发出振聋发聩的怒斥：",
    "start": 151.799,
    "end": 156.734,
    "duration": 4.935
  },
  {
    "id": 27,
    "text": "“天地也！只合把清浊分辨，可怎生糊突了盗跖、颜渊？",
    "start": 157.207,
    "end": 162.648,
    "duration": 5.441
  },
  {
    "id": 28,
    "text": "为善的受贫穷更命短，造恶的享富贵又寿延。",
    "start": 163.148,
    "end": 167.094,
    "duration": 3.946
  },
  {
    "id": 29,
    "text": "天地也！做得个怕硬欺软，却原来也这般顺水推船！",
    "start": 167.594,
    "end": 172.358,
    "duration": 4.764
  },
  {
    "id": 30,
    "text": "地也，你不分好歹何为地！",
    "start": 172.858,
    "end": 175.098,
    "duration": 2.24
  },
  {
    "id": 31,
    "text": "天也，你错勘贤愚枉做天！”",
    "start": 175.598,
    "end": 178.346,
    "duration": 2.748
  },
  {
    "id": 32,
    "text": "这一怒骂直指传统天理秩序与最高权威，展现出决绝的社会批判锋芒。",
    "start": 178.931,
    "end": 184.785,
    "duration": 5.854
  },
  {
    "id": 33,
    "text": "第四，曲词本色当行而又激越悲壮，树立元杂剧现实主义悲剧的典范。",
    "start": 185.415,
    "end": 191.359,
    "duration": 5.944
  },
  {
    "id": 34,
    "text": "在语言艺术上，关汉卿充分发挥元杂剧本色派之所长，将市井口语、民间俗谚与精炼雅语融为一体。",
    "start": 191.859,
    "end": 199.814,
    "duration": 7.955
  },
  {
    "id": 35,
    "text": "全剧曲词质朴自然、生动流利，毫无文饰艰深之弊；",
    "start": 200.314,
    "end": 204.654,
    "duration": 4.34
  },
  {
    "id": 36,
    "text": "在抒写窦娥绝望悲愤时，唱词如泣如诉、慷慨激昂，韵律急促有力，极具舞台感染力。",
    "start": 205.154,
    "end": 213.034,
    "duration": 7.88
  },
  {
    "id": 37,
    "text": "全剧以悲剧冲突的深刻性与人物形象的鲜活感，",
    "start": 213.534,
    "end": 217.436,
    "duration": 3.902
  },
  {
    "id": 38,
    "text": "为元代及后世古典戏曲的悲剧创作确立了崇高典范。",
    "start": 217.786,
    "end": 222.414,
    "duration": 4.628
  },
  {
    "id": 39,
    "text": "由是观之，关汉卿《窦娥冤》直面元代严酷社会现实与吏治黑暗，",
    "start": 222.937,
    "end": 228.393,
    "duration": 5.456
  },
  {
    "id": 40,
    "text": "借助底层寡妇由忍辱顺从到【滚绣球】指天斥地的抗争轨迹，以及感天动地的三桩誓愿，铸就了深沉悲壮的悲剧力量。",
    "start": 228.743,
    "end": 238.524,
    "duration": 9.781
  },
  {
    "id": 41,
    "text": "全剧将本色当行的民间曲辞与尖锐戏剧冲突紧密结合，",
    "start": 239.024,
    "end": 243.894,
    "duration": 4.87
  },
  {
    "id": 42,
    "text": "无愧于王国维“即列之于世界大悲剧中，亦无愧色也”的崇高评价。",
    "start": 244.244,
    "end": 249.497,
    "duration": 5.253
  }
]
