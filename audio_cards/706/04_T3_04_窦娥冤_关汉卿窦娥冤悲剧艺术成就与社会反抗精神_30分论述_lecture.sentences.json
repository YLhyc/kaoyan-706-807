[
  {
    "id": 1,
    "text": "试论关汉卿《窦娥冤》的悲剧艺术成就与社会反抗精神。",
    "start": 0.101,
    "end": 4.073,
    "duration": 3.972
  },
  {
    "id": 2,
    "text": "关汉卿的《窦娥冤》（全名《感天动地窦娥冤》）是元代杂剧乃至中国古典悲剧的杰出代表。",
    "start": 4.478,
    "end": 11.296,
    "duration": 6.818
  },
  {
    "id": 3,
    "text": "在元代民族压迫深重、吏治腐败与高利贷横行的黑暗社会中，",
    "start": 11.552,
    "end": 16.163,
    "duration": 4.611
  },
  {
    "id": 4,
    "text": "关汉卿立足市井民间，以无辜寡妇窦娥的冤案为线索，",
    "start": 16.318,
    "end": 20.561,
    "duration": 4.243
  },
  {
    "id": 5,
    "text": "写出了“惊心动魄的人间惨象”。",
    "start": 20.831,
    "end": 23.234,
    "duration": 2.403
  },
  {
    "id": 6,
    "text": "王国维在《宋元戏曲考》中高度评价此剧“即列之于世界大悲剧中，",
    "start": 23.645,
    "end": 28.654,
    "duration": 5.009
  },
  {
    "id": 7,
    "text": "亦无愧色也”。",
    "start": 28.941,
    "end": 29.826,
    "duration": 0.885
  },
  {
    "id": 8,
    "text": "《窦娥冤》的悲剧艺术成就与社会反抗精神，",
    "start": 30.158,
    "end": 33.147,
    "duration": 2.989
  },
  {
    "id": 9,
    "text": "主要体现在以下四个方面：",
    "start": 33.357,
    "end": 35.054,
    "duration": 1.697
  },
  {
    "id": 10,
    "text": "第一，植根元代严酷社会现实，",
    "start": 35.685,
    "end": 38.416,
    "duration": 2.731
  },
  {
    "id": 11,
    "text": "塑造善良坚贞而宁死不屈的底层女性典型。",
    "start": 38.835,
    "end": 42.462,
    "duration": 3.627
  },
  {
    "id": 12,
    "text": "关汉卿摒弃了虚幻的才子佳人套路，",
    "start": 42.846,
    "end": 45.795,
    "duration": 2.949
  },
  {
    "id": 13,
    "text": "将悲剧冲突深植于元代社会的罪恶土壤之中。",
    "start": 46.311,
    "end": 50.043,
    "duration": 3.732
  },
  {
    "id": 14,
    "text": "窦娥自幼沦为童养媳，早年丧夫，恪守妇道奉养蔡婆婆，",
    "start": 50.366,
    "end": 55.086,
    "duration": 4.72
  },
  {
    "id": 15,
    "text": "本是一位逆来顺受的善良女子。",
    "start": 55.503,
    "end": 57.596,
    "duration": 2.093
  },
  {
    "id": 16,
    "text": "但赛卢医的高利贷盘剥、地痞张驴儿父子的勒索诬陷，",
    "start": 57.852,
    "end": 61.892,
    "duration": 4.04
  },
  {
    "id": 17,
    "text": "以及楚州贪官桃杌只认钱财、滥用酷刑的草菅人命，",
    "start": 62.292,
    "end": 66.598,
    "duration": 4.306
  },
  {
    "id": 18,
    "text": "步步将她推入绝境。",
    "start": 66.905,
    "end": 68.577,
    "duration": 1.672
  },
  {
    "id": 19,
    "text": "窦娥为保护婆婆不受杖刑而含冤屈招，彰显其仁孝至善；",
    "start": 68.882,
    "end": 73.887,
    "duration": 5.005
  },
  {
    "id": 20,
    "text": "而在公堂与法场上面对强权，她又宁死不愿顺从张驴儿的逼婚，",
    "start": 74.234,
    "end": 78.949,
    "duration": 4.715
  },
  {
    "id": 21,
    "text": "展现出底层女性不屈的人格尊严。",
    "start": 79.573,
    "end": 82.249,
    "duration": 2.676
  },
  {
    "id": 22,
    "text": "第二，将现实写实与浪漫想象交融，",
    "start": 82.858,
    "end": 85.886,
    "duration": 3.028
  },
  {
    "id": 23,
    "text": "以感天动地的三桩誓愿凸显崇高悲剧力量。",
    "start": 86.346,
    "end": 89.682,
    "duration": 3.336
  },
  {
    "id": 24,
    "text": "在第三折法场受刑的高潮处，关汉卿突破了纯客观的写实局限，",
    "start": 90.289,
    "end": 95.189,
    "duration": 4.9
  },
  {
    "id": 25,
    "text": "化用东海孝妇等民间传说，",
    "start": 95.495,
    "end": 97.511,
    "duration": 2.016
  },
  {
    "id": 26,
    "text": "虚构了“血溅白练”“六月飞雪”“亢旱三年”三桩誓愿并一一体现。",
    "start": 97.776,
    "end": 102.593,
    "duration": 4.817
  },
  {
    "id": 27,
    "text": "鲜血逆飞高悬素练、炎夏六月飞雪掩尸、楚州大地连旱三年，",
    "start": 102.847,
    "end": 108.365,
    "duration": 5.518
  },
  {
    "id": 28,
    "text": "这些超现实的奇异景象，以天意见证窦娥的清白无辜，",
    "start": 108.645,
    "end": 113.29,
    "duration": 4.645
  },
  {
    "id": 29,
    "text": "借助奇幻笔墨对人世间贪官恶霸的暴行发出严厉控诉与警世裁决，",
    "start": 113.491,
    "end": 118.86,
    "duration": 5.369
  },
  {
    "id": 30,
    "text": "将个人冤屈升华为撼动天地的社会抗议，",
    "start": 119.294,
    "end": 122.714,
    "duration": 3.42
  },
  {
    "id": 31,
    "text": "产生强烈的悲剧震撼力。",
    "start": 122.907,
    "end": 125.101,
    "duration": 2.194
  },
  {
    "id": 32,
    "text": "第三，由忍辱顺从递进到愤慨斥天，",
    "start": 125.705,
    "end": 129.321,
    "duration": 3.616
  },
  {
    "id": 33,
    "text": "细致展现窦娥由屈从到抗争的觉醒轨迹。",
    "start": 129.643,
    "end": 132.867,
    "duration": 3.224
  },
  {
    "id": 34,
    "text": "剧作的高妙之处，在于紧扣压迫步步紧逼的过程，",
    "start": 133.26,
    "end": 137.01,
    "duration": 3.75
  },
  {
    "id": 35,
    "text": "写出窦娥反抗意识的层层升华。",
    "start": 137.318,
    "end": 139.669,
    "duration": 2.351
  },
  {
    "id": 36,
    "text": "起初窦娥敬畏天命、守分安命，幻想官府能替民作主；",
    "start": 140.053,
    "end": 144.285,
    "duration": 4.232
  },
  {
    "id": 37,
    "text": "随着酷刑加身、冤案铸成，她的幻想被残酷现实击碎。",
    "start": 144.708,
    "end": 148.761,
    "duration": 4.053
  },
  {
    "id": 38,
    "text": "在押赴刑场的【滚绣球】一曲中，她发出振聋发聩的怒斥：",
    "start": 149.076,
    "end": 154.001,
    "duration": 4.925
  },
  {
    "id": 39,
    "text": "“天地也！",
    "start": 154.484,
    "end": 155.782,
    "duration": 1.298
  },
  {
    "id": 40,
    "text": "只合把清浊分辨，可怎生糊突了盗跖、颜渊？",
    "start": 155.891,
    "end": 159.915,
    "duration": 4.024
  },
  {
    "id": 41,
    "text": "为善的受贫穷更命短，造恶的享富贵又寿延。天地也！",
    "start": 160.367,
    "end": 165.44,
    "duration": 5.073
  },
  {
    "id": 42,
    "text": "做得个怕硬欺软，却原来也这般顺水推船！",
    "start": 165.542,
    "end": 169.482,
    "duration": 3.94
  },
  {
    "id": 43,
    "text": "地也，你不分好歹何为地！",
    "start": 169.882,
    "end": 172.121,
    "duration": 2.239
  },
  {
    "id": 44,
    "text": "天也，你错勘贤愚枉做天！",
    "start": 172.416,
    "end": 175.142,
    "duration": 2.726
  },
  {
    "id": 45,
    "text": "”这一怒骂直指传统天理秩序与最高权威，",
    "start": 175.768,
    "end": 179.079,
    "duration": 3.311
  },
  {
    "id": 46,
    "text": "展现出决绝的社会批判锋芒。",
    "start": 179.436,
    "end": 181.593,
    "duration": 2.157
  },
  {
    "id": 47,
    "text": "第四，曲词本色当行而又激越悲壮，",
    "start": 182.233,
    "end": 185.44,
    "duration": 3.207
  },
  {
    "id": 48,
    "text": "树立元杂剧现实主义悲剧的典范。",
    "start": 185.658,
    "end": 188.167,
    "duration": 2.509
  },
  {
    "id": 49,
    "text": "在语言艺术上，关汉卿充分发挥元杂剧本色派之所长，",
    "start": 188.407,
    "end": 192.433,
    "duration": 4.026
  },
  {
    "id": 50,
    "text": "将市井口语、民间俗谚与精炼雅语融为一体。",
    "start": 192.574,
    "end": 196.352,
    "duration": 3.778
  },
  {
    "id": 51,
    "text": "全剧曲词质朴自然、生动流利，毫无文饰艰深之弊；",
    "start": 196.624,
    "end": 200.954,
    "duration": 4.33
  },
  {
    "id": 52,
    "text": "在抒写窦娥绝望悲愤时，唱词如泣如诉、慷慨激昂，",
    "start": 201.284,
    "end": 206.128,
    "duration": 4.844
  },
  {
    "id": 53,
    "text": "韵律急促有力，极具舞台感染力。",
    "start": 206.479,
    "end": 209.154,
    "duration": 2.675
  },
  {
    "id": 54,
    "text": "全剧以悲剧冲突的深刻性与人物形象的鲜活感，",
    "start": 209.447,
    "end": 213.336,
    "duration": 3.889
  },
  {
    "id": 55,
    "text": "为元代及后世古典戏曲的悲剧创作确立了崇高典范。",
    "start": 213.709,
    "end": 218.318,
    "duration": 4.609
  }
]