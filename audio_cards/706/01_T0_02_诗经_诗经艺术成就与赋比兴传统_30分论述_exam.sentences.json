[
  {
    "id": 1,
    "text": "试论《诗经》的艺术成就与赋比兴表现手法。",
    "start": 0.134,
    "end": 3.226,
    "duration": 3.092
  },
  {
    "id": 2,
    "text": "《诗经》是中国古代第一部诗歌总集，也是中国现实主义诗歌传统的重要源头。",
    "start": 3.863,
    "end": 9.555,
    "duration": 5.692
  },
  {
    "id": 3,
    "text": "它全面反映了西周初年至春秋中叶五百余年间的社会生活，",
    "start": 10.273,
    "end": 14.525,
    "duration": 4.252
  },
  {
    "id": 4,
    "text": "打破了上古巫祝颂歌的神秘色彩，将诗歌目光投向世俗人间。",
    "start": 14.904,
    "end": 20.076,
    "duration": 5.172
  },
  {
    "id": 5,
    "text": "《毛诗序》更将“风雅颂”诗体与“赋比兴”技法合称《诗》之“六义”，并论风诗功用曰“风以动之，教以化之”。",
    "start": 20.754,
    "end": 29.566,
    "duration": 8.812
  },
  {
    "id": 6,
    "text": "在长期的民间歌咏与采诗编纂中，《诗经》提炼出成熟的诗歌艺术范式，奠定了后世古典诗歌的审美传统。",
    "start": 30.124,
    "end": 38.416,
    "duration": 8.292
  },
  {
    "id": 7,
    "text": "其艺术成就主要体现在以下四个方面：",
    "start": 39.094,
    "end": 47.666,
    "duration": 8.572
  },
  {
    "id": 8,
    "text": "第一，系统确立“赋、比、兴”表现手法，奠定古典诗歌的情物交融传统。",
    "start": 48.344,
    "end": 53.916,
    "duration": 5.572
  },
  {
    "id": 9,
    "text": "《诗经》最具创造性的艺术贡献，在于确立了以“赋”“比”“兴”为核心的表现技法。",
    "start": 54.594,
    "end": 64.446,
    "duration": 9.852
  },
  {
    "id": 10,
    "text": "“赋者，敷陈其事而直言之也”，如《豳风·七月》按岁时农事顺序，",
    "start": 65.084,
    "end": 67.136,
    "duration": 2.052
  },
  {
    "id": 11,
    "text": "详尽铺叙农夫四季耕织劳作的艰辛，笔触平实细腻；",
    "start": 67.515,
    "end": 68.127,
    "duration": 0.612
  },
  {
    "id": 12,
    "text": "“比者，以彼物比此物也”，如《魏风·硕鼠》将贪婪不仁的剥削者比作大老鼠，形象鲜明、讽刺辛辣；",
    "start": 68.656,
    "end": 71.548,
    "duration": 2.892
  },
  {
    "id": 13,
    "text": "“兴者，先言他物以引起所咏之词也”，",
    "start": 72.077,
    "end": 73.049,
    "duration": 0.972
  },
  {
    "id": 14,
    "text": "如《周南·关雎》开篇以“关关雎鸠，在河之洲”起兴，",
    "start": 73.428,
    "end": 73.52,
    "duration": 0.092
  },
  {
    "id": 15,
    "text": "借水鸟和鸣引出“窈窕淑女，君子好逑”的相思恋情。",
    "start": 73.899,
    "end": 74.501,
    "duration": 0.602
  },
  {
    "id": 16,
    "text": "赋比兴的综合运用，使客观物象与主观情感水乳交融，开创了后世托物言志的抒情传统。",
    "start": 75.139,
    "end": 86.151,
    "duration": 11.012
  },
  {
    "id": 17,
    "text": "第二，采用重章叠句与回环复沓结构，展现优美的音乐复奏美感。",
    "start": 86.829,
    "end": 94.001,
    "duration": 7.172
  },
  {
    "id": 18,
    "text": "《诗经》的民歌部分广泛采用重章叠句的篇章结构。",
    "start": 94.679,
    "end": 99.971,
    "duration": 5.292
  },
  {
    "id": 19,
    "text": "作品在各章节之间句式大致相同，",
    "start": 100.609,
    "end": 104.221,
    "duration": 3.612
  },
  {
    "id": 20,
    "text": "仅在关键位置更换少数同义或反义词语，于反复吟唱中层层推进情感。",
    "start": 104.6,
    "end": 113.572,
    "duration": 8.972
  },
  {
    "id": 21,
    "text": "以国风名篇《秦风·蒹葭》为例，全诗三章叠唱，",
    "start": 114.101,
    "end": 117.673,
    "duration": 3.572
  },
  {
    "id": 22,
    "text": "由“白露为霜”演进至“未晞”“未已”，由“宛在水中央”转换为“水中坻”“水中沚”；",
    "start": 118.052,
    "end": 124.202,
    "duration": 6.15
  },
  {
    "id": 23,
    "text": "随秋意渐浓与追寻空间变化，反复抒发对伊人可望而不可即的渺远惆怅。",
    "start": 124.731,
    "end": 130.663,
    "duration": 5.932
  },
  {
    "id": 24,
    "text": "这种回环复沓的结构，既强化了诗歌的音乐节律，更营造出反复低回、情韵绵长的抒情氛围。",
    "start": 131.192,
    "end": 138.444,
    "duration": 7.252
  },
  {
    "id": 25,
    "text": "第三，开创直面现实与关怀民生的写实品格，涵养“风雅”美刺精神。",
    "start": 139.082,
    "end": 144.694,
    "duration": 5.612
  },
  {
    "id": 26,
    "text": "《诗经》扎根于世俗人间的真实土壤，全面展现了周代社会的生动图景，",
    "start": 145.372,
    "end": 150.864,
    "duration": 5.492
  },
  {
    "id": 27,
    "text": "尤其是“国风”与“小雅”中的怨刺诗与社会讽谕诗，以真切笔触直面社会矛盾。",
    "start": 151.243,
    "end": 157.695,
    "duration": 6.452
  },
  {
    "id": 28,
    "text": "《魏风·伐檀》质问统治者的不劳而获，发出“不稼不穑，胡取禾三百廛兮”的严正抗议；",
    "start": 158.373,
    "end": 162.505,
    "duration": 4.132
  },
  {
    "id": 29,
    "text": "《豳风·东山》以细腻平实的细节写征夫还乡，“零雨其濛”中满怀故园荒芜的酸楚；",
    "start": 163.034,
    "end": 165.126,
    "duration": 2.092
  },
  {
    "id": 30,
    "text": "《小雅·采薇》中“昔我往矣，杨柳依依；今我来思，雨雪霏霏”，",
    "start": 165.804,
    "end": 169.096,
    "duration": 3.292
  },
  {
    "id": 31,
    "text": "以乐景写哀，将征夫的悲凉心境刻画得深沉动人。",
    "start": 169.475,
    "end": 171.887,
    "duration": 2.412
  },
  {
    "id": 32,
    "text": "这种关注民生疾苦、干预现实的写实精神，构成了儒家“美刺”诗教的优良传统。",
    "start": 172.565,
    "end": 175.457,
    "duration": 2.892
  },
  {
    "id": 33,
    "text": "第四，形成以四言为主兼备参差变化的语言体式，奠定汉语诗歌音律基础。",
    "start": 176.175,
    "end": 182.627,
    "duration": 6.452
  },
  {
    "id": 34,
    "text": "在语言体制上，《诗经》确立了以四言为主的基本诗体，形成了二二节拍的整齐节奏，",
    "start": 183.345,
    "end": 186.557,
    "duration": 3.212
  },
  {
    "id": 35,
    "text": "同时适当吸纳两字、三字乃至八字的长短句，打破单调板滞。",
    "start": 186.936,
    "end": 189.548,
    "duration": 2.612
  },
  {
    "id": 36,
    "text": "诗中善用叠字与拟声词，如《小雅·伐木》之“伐木丁丁，鸟鸣嘤嘤”，",
    "start": 190.186,
    "end": 200.598,
    "duration": 10.412
  },
  {
    "id": 37,
    "text": "《郑风·子衿》之“青青子衿，悠悠我心”，摹声状物、声律和谐；",
    "start": 201.113,
    "end": 211.325,
    "duration": 10.212
  },
  {
    "id": 38,
    "text": "全诗广泛运用双声叠韵与自然押韵，句式灵活舒展，",
    "start": 211.917,
    "end": 219.369,
    "duration": 7.452
  },
  {
    "id": 39,
    "text": "为汉魏以后五、七言诗歌体裁的发展提供了丰厚的语言与音律滋养。",
    "start": 219.748,
    "end": 228.8,
    "duration": 9.052
  },
  {
    "id": 40,
    "text": "总而言之，《诗经》以赋、比、兴技法、重章复沓音乐结构与二二节拍四言体式，",
    "start": 229.329,
    "end": 235.501,
    "duration": 6.172
  },
  {
    "id": 41,
    "text": "将先秦民间歌咏与周代礼乐文化凝为一体。",
    "start": 235.88,
    "end": 239.252,
    "duration": 3.372
  },
  {
    "id": 42,
    "text": "它所开创的直面现实、关怀民生的风雅美刺精神与含蓄蕴藉的言志传统，",
    "start": 239.781,
    "end": 245.633,
    "duration": 5.852
  },
  {
    "id": 43,
    "text": "历经汉魏乐府、建安风骨直至唐宋诗坛而一脉相承，",
    "start": 246.012,
    "end": 250.384,
    "duration": 4.372
  },
  {
    "id": 44,
    "text": "长久滋养着中国古典诗歌的创作方向。",
    "start": 250.763,
    "end": 253.535,
    "duration": 2.772
  }
]