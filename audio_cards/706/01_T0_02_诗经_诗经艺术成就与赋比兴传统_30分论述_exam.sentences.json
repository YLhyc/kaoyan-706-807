[
  {
    "id": 1,
    "text": "试论《诗经》的艺术成就与赋比兴表现手法。",
    "start": 0.0,
    "end": 3.872,
    "duration": 3.872
  },
  {
    "id": 2,
    "text": "《诗经》 是中国古代第一部诗歌总集，",
    "start": 3.872,
    "end": 7.336,
    "duration": 3.464
  },
  {
    "id": 3,
    "text": "也是中国现实主义诗歌传统的至高源头。",
    "start": 7.336,
    "end": 11.004,
    "duration": 3.668
  },
  {
    "id": 4,
    "text": "它全面反映了西周初年至春秋中叶五百余年间广阔的社会历史生活，",
    "start": 11.004,
    "end": 17.117,
    "duration": 6.113
  },
  {
    "id": 5,
    "text": "打破了上古巫术颂歌的神秘垄断，",
    "start": 17.117,
    "end": 20.174,
    "duration": 3.057
  },
  {
    "id": 6,
    "text": "将诗歌的目光聚焦于现实人间。",
    "start": 20.174,
    "end": 23.102,
    "duration": 2.928
  },
  {
    "id": 7,
    "text": "《汉书·艺文志》 赞其 “哀乐和，节文相生”。",
    "start": 23.102,
    "end": 27.609,
    "duration": 4.507
  },
  {
    "id": 8,
    "text": "《诗经》 在长期的民间歌咏与史官编纂中，",
    "start": 27.609,
    "end": 31.687,
    "duration": 4.078
  },
  {
    "id": 9,
    "text": "提炼出成熟的诗歌艺术范式，",
    "start": 31.687,
    "end": 34.262,
    "duration": 2.575
  },
  {
    "id": 10,
    "text": "奠定了中华民族诗歌的审美心理结构。",
    "start": 34.262,
    "end": 37.911,
    "duration": 3.649
  },
  {
    "id": 11,
    "text": "其艺术成就主要展现为以下四个核心维度：",
    "start": 37.911,
    "end": 41.988,
    "duration": 4.077
  },
  {
    "id": 12,
    "text": "第一，系统确立“赋、比、兴”表现手法体系，",
    "start": 41.988,
    "end": 46.862,
    "duration": 4.874
  },
  {
    "id": 13,
    "text": "奠定古典诗歌的情物交融传统。",
    "start": 46.862,
    "end": 50.293,
    "duration": 3.431
  },
  {
    "id": 14,
    "text": "《诗经》 最具创造性的艺术贡献，在于建立了以 “赋”、",
    "start": 50.293,
    "end": 56.422,
    "duration": 6.129
  },
  {
    "id": 15,
    "text": "“比”、“兴” 为核心的表现技法体系。",
    "start": 56.422,
    "end": 60.834,
    "duration": 4.412
  },
  {
    "id": 16,
    "text": "“赋者，敷陈其事而直言之也”，",
    "start": 60.834,
    "end": 64.579,
    "duration": 3.745
  },
  {
    "id": 17,
    "text": "如 《豳风·七月》 按照岁时农事顺序，",
    "start": 64.579,
    "end": 68.939,
    "duration": 4.36
  },
  {
    "id": 18,
    "text": "详尽铺叙农夫一年四季耕织劳作的艰辛，笔触客观细腻；",
    "start": 68.939,
    "end": 75.352,
    "duration": 6.413
  },
  {
    "id": 19,
    "text": "“比者，以彼物比此物也”，",
    "start": 75.352,
    "end": 78.686,
    "duration": 3.334
  },
  {
    "id": 20,
    "text": "如 《魏风·硕鼠》 将残酷不仁的奴隶领主直接比作贪婪害人的大老鼠，",
    "start": 78.686,
    "end": 86.381,
    "duration": 7.695
  },
  {
    "id": 21,
    "text": "形象鲜明、讽刺辛辣；“兴者，先言他物以引起所咏之词也”，",
    "start": 86.381,
    "end": 92.524,
    "duration": 6.143
  },
  {
    "id": 22,
    "text": "如 《周南·关雎》 开篇以 “关关雎鸠，",
    "start": 92.524,
    "end": 96.252,
    "duration": 3.728
  },
  {
    "id": 23,
    "text": "在河之洲” 起兴，借水鸟和鸣起兴引出 “窈窕淑女，",
    "start": 96.252,
    "end": 101.295,
    "duration": 5.043
  },
  {
    "id": 24,
    "text": "君子好逑” 的相思恋情。",
    "start": 101.295,
    "end": 103.268,
    "duration": 1.973
  },
  {
    "id": 25,
    "text": "赋比兴手法的综合运用，使客观物象与主观情感深度交融，",
    "start": 103.268,
    "end": 108.969,
    "duration": 5.701
  },
  {
    "id": 26,
    "text": "开创了后世托物言志的博大传统。",
    "start": 108.969,
    "end": 112.258,
    "duration": 3.289
  },
  {
    "id": 27,
    "text": "第二，确立重章叠句与回环复沓的篇章结构，",
    "start": 112.258,
    "end": 116.643,
    "duration": 4.385
  },
  {
    "id": 28,
    "text": "展现优美的音乐复奏美感。",
    "start": 116.643,
    "end": 119.36,
    "duration": 2.717
  },
  {
    "id": 29,
    "text": "《诗经》 的民歌部分广泛采用重章叠句的结构方式。",
    "start": 119.6,
    "end": 126.0,
    "duration": 6.4
  },
  {
    "id": 30,
    "text": "作品在几个章节之间，字句结构基本相同，",
    "start": 126.0,
    "end": 130.88,
    "duration": 4.88
  },
  {
    "id": 31,
    "text": "仅在关键位置更换少数几个同义或反义词语，",
    "start": 130.88,
    "end": 135.28,
    "duration": 4.4
  },
  {
    "id": 32,
    "text": "在反复吟唱中推进情感。",
    "start": 135.28,
    "end": 137.2,
    "duration": 1.92
  },
  {
    "id": 33,
    "text": "以国风名篇 《秦风·蒹葭》 为例，全诗三章叠唱，",
    "start": 137.44,
    "end": 141.2,
    "duration": 3.76
  },
  {
    "id": 34,
    "text": "由 “白露为霜” 演进到 “未晞”、“未已”，",
    "start": 141.2,
    "end": 145.36,
    "duration": 4.16
  },
  {
    "id": 35,
    "text": "由 “宛在水中央” 转换为 “水中坻”、“水中沚”；",
    "start": 145.736,
    "end": 151.096,
    "duration": 5.36
  },
  {
    "id": 36,
    "text": "随着秋意逐渐深浓与追寻空间的层层变换，",
    "start": 151.096,
    "end": 154.936,
    "duration": 3.84
  },
  {
    "id": 37,
    "text": "反复抒发了对伊人可望而不可即的渺远惆怅。",
    "start": 154.936,
    "end": 159.176,
    "duration": 4.24
  },
  {
    "id": 38,
    "text": "这种回环复沓的结构，不仅极大地强化了诗歌的音乐节律，",
    "start": 159.176,
    "end": 164.936,
    "duration": 5.76
  },
  {
    "id": 39,
    "text": "更营造出反复低回、情韵绵长的抒情氛围。",
    "start": 164.936,
    "end": 169.564,
    "duration": 4.628
  },
  {
    "id": 40,
    "text": "第三，开创直面现实与关怀民生苦难的写实品格，",
    "start": 169.564,
    "end": 175.047,
    "duration": 5.483
  },
  {
    "id": 41,
    "text": "铸就“风雅”诗教精神。",
    "start": 175.047,
    "end": 177.788,
    "duration": 2.741
  },
  {
    "id": 42,
    "text": "《诗经》 牢牢扎根于世俗人间的真实土壤，",
    "start": 177.788,
    "end": 182.025,
    "duration": 4.237
  },
  {
    "id": 43,
    "text": "全面展现了宗周社会的生动图景。",
    "start": 182.025,
    "end": 185.736,
    "duration": 3.711
  },
  {
    "id": 44,
    "text": "尤其是 “国风” 与 “小雅” 中的怨刺诗与社会讽谕诗，",
    "start": 185.816,
    "end": 191.256,
    "duration": 5.44
  },
  {
    "id": 45,
    "text": "以卓越的批判勇气直面社会矛盾。",
    "start": 191.256,
    "end": 194.456,
    "duration": 3.2
  },
  {
    "id": 46,
    "text": "《魏风·伐檀》 面对统治者的不劳而获，发出 “不稼不穑，",
    "start": 194.456,
    "end": 200.296,
    "duration": 5.84
  },
  {
    "id": 47,
    "text": "胡取禾三百廛兮” 的严正抗议；",
    "start": 200.296,
    "end": 203.096,
    "duration": 2.8
  },
  {
    "id": 48,
    "text": "《豳风·东山》 以细腻平实的细节描写征夫还乡，",
    "start": 203.096,
    "end": 207.976,
    "duration": 4.88
  },
  {
    "id": 49,
    "text": "“零雨其濛” 中满怀对故园荒芜的酸楚；",
    "start": 207.976,
    "end": 211.176,
    "duration": 3.2
  },
  {
    "id": 50,
    "text": "《小雅·采薇》 中 “昔我往矣，杨柳依依；今我来思，",
    "start": 211.176,
    "end": 216.456,
    "duration": 5.28
  },
  {
    "id": 51,
    "text": "雨雪霏霏”，以乐景写哀，",
    "start": 216.456,
    "end": 219.496,
    "duration": 3.04
  },
  {
    "id": 52,
    "text": "将战火中士兵的悲凉心灵刻画得入木三分。",
    "start": 219.496,
    "end": 224.136,
    "duration": 4.64
  },
  {
    "id": 53,
    "text": "这种关注生民疾苦、干预现实的批判精神，",
    "start": 224.136,
    "end": 229.016,
    "duration": 4.88
  },
  {
    "id": 54,
    "text": "直接构成了儒家“美刺”诗教的优良传统。",
    "start": 229.016,
    "end": 233.176,
    "duration": 4.16
  },
  {
    "id": 55,
    "text": "第四，形成以四言为主兼备参差变化的语言体式，",
    "start": 233.176,
    "end": 237.896,
    "duration": 4.72
  },
  {
    "id": 56,
    "text": "奠定汉语诗歌的音律节奏。",
    "start": 237.896,
    "end": 240.216,
    "duration": 2.32
  },
  {
    "id": 57,
    "text": "在语言体制上，《诗经》 确立了以四言为主的基本诗体，",
    "start": 239.976,
    "end": 240.216,
    "duration": 0.24
  },
  {
    "id": 58,
    "text": "形成了二二节拍的整齐节奏。",
    "start": 239.976,
    "end": 240.216,
    "duration": 0.24
  },
  {
    "id": 59,
    "text": "同时，诗中大量吸纳两字、三字直至八字的长短句，",
    "start": 239.976,
    "end": 240.216,
    "duration": 0.24
  },
  {
    "id": 60,
    "text": "打破单调僵化；《诗经》 极善运用叠字与拟声词，",
    "start": 239.976,
    "end": 240.216,
    "duration": 0.24
  },
  {
    "id": 61,
    "text": "如 《小雅·伐木》 之 “伐木丁丁，鸟鸣嘤嘤”，",
    "start": 239.976,
    "end": 240.216,
    "duration": 0.24
  },
  {
    "id": 62,
    "text": "《郑风·子衿》 之 “青青子衿，悠悠我心”，形象逼真、",
    "start": 239.976,
    "end": 240.216,
    "duration": 0.24
  },
  {
    "id": 63,
    "text": "声律和谐；全诗广泛运用双声叠韵与自然押韵，句式灵活舒展，",
    "start": 239.976,
    "end": 240.216,
    "duration": 0.24
  },
  {
    "id": 64,
    "text": "为汉魏以后五七言诗歌体裁的发展提供了丰厚的音律给养。",
    "start": 239.976,
    "end": 240.216,
    "duration": 0.24
  }
]