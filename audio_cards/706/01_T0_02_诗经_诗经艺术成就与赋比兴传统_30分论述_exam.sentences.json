[
  {
    "id": 1,
    "text": "试论《诗经》的艺术成就与赋比兴表现手法。",
    "start": 0.02,
    "end": 3.59,
    "duration": 3.57
  },
  {
    "id": 2,
    "text": "《诗经》是中国古代第一部诗歌总集，",
    "start": 4.074,
    "end": 6.465,
    "duration": 2.391
  },
  {
    "id": 3,
    "text": "也是中国现实主义诗歌传统的重要源头。",
    "start": 6.88,
    "end": 9.824,
    "duration": 2.944
  },
  {
    "id": 4,
    "text": "它全面反映了西周初年至春秋中叶五百余年间的社会生活，",
    "start": 10.304,
    "end": 15.191,
    "duration": 4.887
  },
  {
    "id": 5,
    "text": "打破了上古巫祝颂歌的神秘色彩，将诗歌目光投向世俗人间。",
    "start": 15.647,
    "end": 20.828,
    "duration": 5.181
  },
  {
    "id": 6,
    "text": "《毛诗序》论风诗功用曰“风以动之，教以化之”。",
    "start": 21.071,
    "end": 25.172,
    "duration": 4.101
  },
  {
    "id": 7,
    "text": "在长期的民间歌咏与采诗编纂中，",
    "start": 25.515,
    "end": 28.35,
    "duration": 2.835
  },
  {
    "id": 8,
    "text": "《诗经》提炼出成熟的诗歌艺术范式，",
    "start": 28.644,
    "end": 31.35,
    "duration": 2.706
  },
  {
    "id": 9,
    "text": "奠定了后世古典诗歌的审美传统。",
    "start": 31.738,
    "end": 34.114,
    "duration": 2.376
  },
  {
    "id": 10,
    "text": "其艺术成就主要体现在以下四个方面：",
    "start": 34.586,
    "end": 37.318,
    "duration": 2.732
  },
  {
    "id": 11,
    "text": "第一，系统确立“赋、比、兴”表现手法，",
    "start": 37.916,
    "end": 41.13,
    "duration": 3.214
  },
  {
    "id": 12,
    "text": "奠定古典诗歌的情物交融传统。",
    "start": 41.572,
    "end": 44.112,
    "duration": 2.54
  },
  {
    "id": 13,
    "text": "《诗经》最具创造性的艺术贡献，",
    "start": 44.513,
    "end": 46.686,
    "duration": 2.173
  },
  {
    "id": 14,
    "text": "在于确立了以“赋”“比”“兴”为核心的表现技法。",
    "start": 46.984,
    "end": 51.633,
    "duration": 4.649
  },
  {
    "id": 15,
    "text": "“赋者，敷陈其事而直言之也”，",
    "start": 51.77,
    "end": 53.593,
    "duration": 1.823
  },
  {
    "id": 16,
    "text": "如《豳风·七月》按岁时农事顺序，",
    "start": 54.06,
    "end": 56.584,
    "duration": 2.524
  },
  {
    "id": 17,
    "text": "详尽铺叙农夫四季耕织劳作的艰辛，笔触平实细腻；“比者，",
    "start": 56.878,
    "end": 62.584,
    "duration": 5.706
  },
  {
    "id": 18,
    "text": "以彼物比此物也”，",
    "start": 62.805,
    "end": 64.221,
    "duration": 1.416
  },
  {
    "id": 19,
    "text": "如《魏风·硕鼠》将贪婪不仁的剥削者比作大老鼠，形象鲜明、",
    "start": 64.768,
    "end": 69.676,
    "duration": 4.908
  },
  {
    "id": 20,
    "text": "讽刺辛辣；“兴者，先言他物以引起所咏之词也”，",
    "start": 70.067,
    "end": 74.548,
    "duration": 4.481
  },
  {
    "id": 21,
    "text": "如《周南·关雎》开篇以“关关雎鸠，在河之洲”起兴，",
    "start": 75.08,
    "end": 79.001,
    "duration": 3.921
  },
  {
    "id": 22,
    "text": "借水鸟和鸣引出“窈窕淑女，君子好逑”的相思恋情。",
    "start": 79.285,
    "end": 83.822,
    "duration": 4.537
  },
  {
    "id": 23,
    "text": "赋比兴的综合运用，使客观物象与主观情感水乳交融，",
    "start": 84.048,
    "end": 88.589,
    "duration": 4.541
  },
  {
    "id": 24,
    "text": "开创了后世托物言志的抒情传统。",
    "start": 88.872,
    "end": 91.476,
    "duration": 2.604
  },
  {
    "id": 25,
    "text": "第二，采用重章叠句与回环复沓结构，展现优美的音乐复奏美感。",
    "start": 92.146,
    "end": 97.876,
    "duration": 5.73
  },
  {
    "id": 26,
    "text": "《诗经》的民歌部分广泛采用重章叠句的篇章结构。",
    "start": 98.253,
    "end": 101.647,
    "duration": 3.394
  },
  {
    "id": 27,
    "text": "作品在各章节之间句式大致相同，",
    "start": 101.924,
    "end": 104.486,
    "duration": 2.562
  },
  {
    "id": 28,
    "text": "仅在关键位置更换少数同义或反义词语，",
    "start": 104.659,
    "end": 107.952,
    "duration": 3.293
  },
  {
    "id": 29,
    "text": "于反复吟唱中层层推进情感。",
    "start": 108.28,
    "end": 110.79,
    "duration": 2.51
  },
  {
    "id": 30,
    "text": "以国风名篇《秦风·蒹葭》为例，全诗三章叠唱，",
    "start": 111.028,
    "end": 114.955,
    "duration": 3.927
  },
  {
    "id": 31,
    "text": "由“白露为霜”演进至“未晞”“未已”，",
    "start": 115.173,
    "end": 118.364,
    "duration": 3.191
  },
  {
    "id": 32,
    "text": "由“宛在水中央”转换为“水中坻”“水中沚”；",
    "start": 118.708,
    "end": 122.165,
    "duration": 3.457
  },
  {
    "id": 33,
    "text": "随秋意渐浓与追寻空间变化，",
    "start": 122.485,
    "end": 124.887,
    "duration": 2.402
  },
  {
    "id": 34,
    "text": "反复抒发对伊人可望而不可即的渺远惆怅。",
    "start": 125.102,
    "end": 128.543,
    "duration": 3.441
  },
  {
    "id": 35,
    "text": "这种回环复沓的结构，既强化了诗歌的音乐节律，",
    "start": 128.755,
    "end": 132.452,
    "duration": 3.697
  },
  {
    "id": 36,
    "text": "更营造出反复低回、情韵绵长的抒情氛围。",
    "start": 132.822,
    "end": 136.614,
    "duration": 3.792
  },
  {
    "id": 37,
    "text": "第三，开创直面现实与关怀民生的写实品格，",
    "start": 137.25,
    "end": 141.616,
    "duration": 4.366
  },
  {
    "id": 38,
    "text": "涵养“风雅”美刺精神。",
    "start": 142.115,
    "end": 143.877,
    "duration": 1.762
  },
  {
    "id": 39,
    "text": "《诗经》扎根于世俗人间的真实土壤，",
    "start": 144.577,
    "end": 147.188,
    "duration": 2.611
  },
  {
    "id": 40,
    "text": "全面展现了周代社会的生动图景，",
    "start": 147.685,
    "end": 150.189,
    "duration": 2.504
  },
  {
    "id": 41,
    "text": "尤其是“国风”与“小雅”中的怨刺诗与社会讽谕诗，",
    "start": 150.64,
    "end": 154.58,
    "duration": 3.94
  },
  {
    "id": 42,
    "text": "以真切笔触直面社会矛盾。",
    "start": 155.074,
    "end": 157.126,
    "duration": 2.052
  },
  {
    "id": 43,
    "text": "《魏风·伐檀》质问统治者的不劳而获，发出“不稼不穑，",
    "start": 157.41,
    "end": 162.516,
    "duration": 5.106
  },
  {
    "id": 44,
    "text": "胡取禾三百廛兮”的严正抗议；",
    "start": 162.84,
    "end": 165.558,
    "duration": 2.718
  },
  {
    "id": 45,
    "text": "《豳风·东山》以细腻平实的细节写征夫还乡，",
    "start": 165.933,
    "end": 170.109,
    "duration": 4.176
  },
  {
    "id": 46,
    "text": "“零雨其濛”中满怀故园荒芜的酸楚；",
    "start": 170.329,
    "end": 173.435,
    "duration": 3.106
  },
  {
    "id": 47,
    "text": "《小雅·采薇》中“昔我往矣，杨柳依依；今我来思，",
    "start": 173.79,
    "end": 178.699,
    "duration": 4.909
  },
  {
    "id": 48,
    "text": "雨雪霏霏”，以乐景写哀，将征夫的悲凉心境刻画得深沉动人。",
    "start": 178.893,
    "end": 183.834,
    "duration": 4.941
  },
  {
    "id": 49,
    "text": "这种关注民生疾苦、干预现实的写实精神，",
    "start": 184.205,
    "end": 187.577,
    "duration": 3.372
  },
  {
    "id": 50,
    "text": "构成了儒家“美刺”诗教的优良传统。",
    "start": 187.732,
    "end": 190.445,
    "duration": 2.713
  },
  {
    "id": 51,
    "text": "第四，形成以四言为主兼备参差变化的语言体式，",
    "start": 191.047,
    "end": 195.096,
    "duration": 4.049
  },
  {
    "id": 52,
    "text": "奠定汉语诗歌音律基础。",
    "start": 195.394,
    "end": 197.134,
    "duration": 1.74
  },
  {
    "id": 53,
    "text": "在语言体制上，《诗经》确立了以四言为主的基本诗体，",
    "start": 197.467,
    "end": 201.466,
    "duration": 3.999
  },
  {
    "id": 54,
    "text": "形成了二二节拍的整齐节奏，同时适当吸纳两字、",
    "start": 201.865,
    "end": 205.766,
    "duration": 3.901
  },
  {
    "id": 55,
    "text": "三字乃至八字的长短句，打破单调板滞。",
    "start": 205.97,
    "end": 209.301,
    "duration": 3.331
  },
  {
    "id": 56,
    "text": "诗中善用叠字与拟声词，如《小雅·伐木》之“伐木丁丁，",
    "start": 209.533,
    "end": 214.133,
    "duration": 4.6
  },
  {
    "id": 57,
    "text": "鸟鸣嘤嘤”，《郑风·子衿》之“青青子衿，悠悠我心”，",
    "start": 214.291,
    "end": 218.703,
    "duration": 4.412
  },
  {
    "id": 58,
    "text": "摹声状物、声律和谐；全诗广泛运用双声叠韵与自然押韵，",
    "start": 219.067,
    "end": 224.13,
    "duration": 5.063
  },
  {
    "id": 59,
    "text": "句式灵活舒展，为汉魏以后五、",
    "start": 224.495,
    "end": 226.949,
    "duration": 2.454
  },
  {
    "id": 60,
    "text": "七言诗歌体裁的发展提供了丰厚的语言与音律滋养。",
    "start": 227.25,
    "end": 231.017,
    "duration": 3.767
  }
]