[
  {
    "id": "sent_1",
    "text": "《诗经》 是中国古代第一部诗歌总集，",
    "start": 0.1,
    "end": 3.553,
    "duration": 3.453
  },
  {
    "id": "sent_2",
    "text": "也是中国现实主义诗歌传统的至高源头。",
    "start": 3.503,
    "end": 7.422,
    "duration": 3.919
  },
  {
    "id": "sent_3",
    "text": "它全面反映了西周初年至春秋中叶五百余年间广阔的社会历史生活，",
    "start": 7.422,
    "end": 13.971,
    "duration": 6.549
  },
  {
    "id": "sent_4",
    "text": "打破了上古巫术颂歌的神秘垄断，将诗歌的目光聚焦于现实人间。",
    "start": 13.971,
    "end": 20.13,
    "duration": 6.159
  },
  {
    "id": "sent_5",
    "text": "《汉书·艺文志》 赞其 “哀乐和，节文相生”。",
    "start": 20.13,
    "end": 24.232,
    "duration": 4.102
  },
  {
    "id": "sent_6",
    "text": "《诗经》 在长期的民间歌咏与史官编纂中，",
    "start": 24.232,
    "end": 28.347,
    "duration": 4.115
  },
  {
    "id": "sent_7",
    "text": "提炼出成熟的诗歌艺术范式，奠定了中华民族诗歌的审美心理结构。",
    "start": 28.346,
    "end": 34.388,
    "duration": 6.042
  },
  {
    "id": "sent_8",
    "text": "其艺术成就主要展现为以下四个核心维度：",
    "start": 34.388,
    "end": 38.906,
    "duration": 4.518
  },
  {
    "id": "sent_9",
    "text": "第一，系统确立“赋、比、兴”表现手法体系，",
    "start": 38.906,
    "end": 43.333,
    "duration": 4.427
  },
  {
    "id": "sent_10",
    "text": "奠定古典诗歌的情物交融传统。",
    "start": 43.333,
    "end": 46.484,
    "duration": 3.151
  },
  {
    "id": "sent_11",
    "text": "《诗经》 最具创造性的艺术贡献，",
    "start": 46.484,
    "end": 49.609,
    "duration": 3.125
  },
  {
    "id": "sent_12",
    "text": "在于建立了以 “赋”、“比”、“兴” 为核心的表现技法体系。",
    "start": 49.609,
    "end": 54.57,
    "duration": 4.961
  },
  {
    "id": "sent_13",
    "text": "“赋者，敷陈其事而直言之也”，",
    "start": 54.57,
    "end": 57.981,
    "duration": 3.411
  },
  {
    "id": "sent_14",
    "text": "如 《豳风·七月》 按照岁时农事顺序，",
    "start": 57.981,
    "end": 61.575,
    "duration": 3.594
  },
  {
    "id": "sent_15",
    "text": "详尽铺叙农夫一年四季耕织劳作的艰辛，笔触客观细腻；",
    "start": 61.576,
    "end": 66.823,
    "duration": 5.247
  },
  {
    "id": "sent_16",
    "text": "“比者，以彼物比此物也”，",
    "start": 66.823,
    "end": 69.57,
    "duration": 2.747
  },
  {
    "id": "sent_17",
    "text": "如 《魏风·硕鼠》 将残酷不仁的奴隶领主直接比作贪婪害人的大老鼠，",
    "start": 69.57,
    "end": 76.002,
    "duration": 6.432
  },
  {
    "id": "sent_18",
    "text": "形象鲜明、讽刺辛辣；",
    "start": 76.003,
    "end": 78.646,
    "duration": 2.643
  },
  {
    "id": "sent_19",
    "text": "“兴者，先言他物以引起所咏之词也”，",
    "start": 78.646,
    "end": 82.565,
    "duration": 3.919
  },
  {
    "id": "sent_20",
    "text": "如 《周南·关雎》 开篇以 “关关雎鸠，在河之洲” 起兴，",
    "start": 82.565,
    "end": 87.148,
    "duration": 4.583
  },
  {
    "id": "sent_21",
    "text": "借水鸟和鸣起兴引出 “窈窕淑女，君子好逑” 的相思恋情。",
    "start": 87.148,
    "end": 92.513,
    "duration": 5.365
  },
  {
    "id": "sent_22",
    "text": "赋比兴手法的综合运用，使客观物象与主观情感深度交融，",
    "start": 92.513,
    "end": 98.19,
    "duration": 5.677
  },
  {
    "id": "sent_23",
    "text": "开创了后世托物言志的博大传统。",
    "start": 98.19,
    "end": 101.471,
    "duration": 3.281
  },
  {
    "id": "sent_24",
    "text": "第二，确立重章叠句与回环复沓的篇章结构，展现优美的音乐复奏美感。",
    "start": 101.471,
    "end": 108.19,
    "duration": 6.719
  },
  {
    "id": "sent_25",
    "text": "《诗经》 的民歌部分广泛采用重章叠句的结构方式。",
    "start": 108.19,
    "end": 112.5,
    "duration": 4.31
  },
  {
    "id": "sent_26",
    "text": "作品在几个章节之间，字句结构基本相同，",
    "start": 112.5,
    "end": 116.719,
    "duration": 4.219
  },
  {
    "id": "sent_27",
    "text": "仅在关键位置更换少数几个同义或反义词语，在反复吟唱中推进情感。",
    "start": 116.719,
    "end": 123.698,
    "duration": 6.979
  },
  {
    "id": "sent_28",
    "text": "以国风名篇 《秦风·蒹葭》 为例，全诗三章叠唱，",
    "start": 123.698,
    "end": 128.62,
    "duration": 4.922
  },
  {
    "id": "sent_29",
    "text": "由 “白露为霜” 演进到 “未晞”、“未已”，",
    "start": 128.62,
    "end": 132.11,
    "duration": 3.49
  },
  {
    "id": "sent_30",
    "text": "由 “宛在水中央” 转换为 “水中坻”、“水中沚”；",
    "start": 132.109,
    "end": 136.211,
    "duration": 4.102
  },
  {
    "id": "sent_31",
    "text": "随着秋意逐渐深浓与追寻空间的层层变换，",
    "start": 136.211,
    "end": 140.651,
    "duration": 4.44
  },
  {
    "id": "sent_32",
    "text": "反复抒发了对伊人可望而不可即的渺远惆怅。",
    "start": 140.651,
    "end": 145.312,
    "duration": 4.661
  },
  {
    "id": "sent_33",
    "text": "这种回环复沓的结构，不仅极大地强化了诗歌的音乐节律，",
    "start": 145.312,
    "end": 150.625,
    "duration": 5.313
  },
  {
    "id": "sent_34",
    "text": "更营造出反复低回、情韵绵长的抒情氛围。",
    "start": 150.625,
    "end": 154.908,
    "duration": 4.283
  },
  {
    "id": "sent_35",
    "text": "第三，开创直面现实与关怀民生苦难的写实品格，",
    "start": 154.908,
    "end": 160.403,
    "duration": 5.495
  },
  {
    "id": "sent_36",
    "text": "铸就“风雅”诗教精神。",
    "start": 160.404,
    "end": 162.657,
    "duration": 2.253
  },
  {
    "id": "sent_37",
    "text": "《诗经》 牢牢扎根于世俗人间的真实土壤，",
    "start": 162.656,
    "end": 166.562,
    "duration": 3.906
  },
  {
    "id": "sent_38",
    "text": "全面展现了宗周社会的生动图景。",
    "start": 166.563,
    "end": 169.87,
    "duration": 3.307
  },
  {
    "id": "sent_39",
    "text": "尤其是 “国风” 与 “小雅” 中的怨刺诗与社会讽谕诗，",
    "start": 169.87,
    "end": 174.076,
    "duration": 4.206
  },
  {
    "id": "sent_40",
    "text": "以卓越的批判勇气直面社会矛盾。",
    "start": 174.076,
    "end": 177.527,
    "duration": 3.451
  },
  {
    "id": "sent_41",
    "text": "《魏风·伐檀》 面对统治者的不劳而获，发出 “不稼不穑，",
    "start": 177.526,
    "end": 182.5,
    "duration": 4.974
  },
  {
    "id": "sent_42",
    "text": "胡取禾三百廛兮” 的严正抗议；",
    "start": 182.5,
    "end": 185.573,
    "duration": 3.073
  },
  {
    "id": "sent_43",
    "text": "《豳风·东山》 以细腻平实的细节描写征夫还乡，",
    "start": 185.573,
    "end": 190.391,
    "duration": 4.818
  },
  {
    "id": "sent_44",
    "text": "“零雨其濛” 中满怀对故园荒芜的酸楚；",
    "start": 190.391,
    "end": 193.92,
    "duration": 3.529
  },
  {
    "id": "sent_45",
    "text": "《小雅·采薇》 中 “昔我往矣，杨柳依依；",
    "start": 193.919,
    "end": 197.903,
    "duration": 3.984
  },
  {
    "id": "sent_46",
    "text": "今我来思，雨雪霏霏”，以乐景写哀，",
    "start": 197.904,
    "end": 201.498,
    "duration": 3.594
  },
  {
    "id": "sent_47",
    "text": "将战火中士兵的悲凉心灵刻画得入木三分。",
    "start": 201.497,
    "end": 205.95,
    "duration": 4.453
  },
  {
    "id": "sent_48",
    "text": "这种关注生民疾苦、干预现实的批判精神，",
    "start": 205.951,
    "end": 210.196,
    "duration": 4.245
  },
  {
    "id": "sent_49",
    "text": "直接构成了儒家“美刺”诗教的优良传统。",
    "start": 210.195,
    "end": 214.153,
    "duration": 3.958
  },
  {
    "id": "sent_50",
    "text": "第四，形成以四言为主兼备参差变化的语言体式，",
    "start": 214.153,
    "end": 219.206,
    "duration": 5.053
  },
  {
    "id": "sent_51",
    "text": "奠定汉语诗歌的音律节奏。",
    "start": 219.206,
    "end": 221.992,
    "duration": 2.786
  },
  {
    "id": "sent_52",
    "text": "在语言体制上，《诗经》 确立了以四言为主的基本诗体，",
    "start": 221.992,
    "end": 226.849,
    "duration": 4.857
  },
  {
    "id": "sent_53",
    "text": "形成了二二节拍的整齐节奏。",
    "start": 226.849,
    "end": 229.661,
    "duration": 2.812
  },
  {
    "id": "sent_54",
    "text": "同时，诗中大量吸纳两字、三字直至八字的长短句，打破单调僵化；",
    "start": 229.661,
    "end": 236.627,
    "duration": 6.966
  },
  {
    "id": "sent_55",
    "text": "《诗经》 极善运用叠字与拟声词，",
    "start": 236.628,
    "end": 239.727,
    "duration": 3.099
  },
  {
    "id": "sent_56",
    "text": "如 《小雅·伐木》 之 “伐木丁丁，鸟鸣嘤嘤”，",
    "start": 239.727,
    "end": 243.698,
    "duration": 3.971
  },
  {
    "id": "sent_57",
    "text": "《郑风·子衿》 之 “青青子衿，悠悠我心”，形象逼真、声律和谐；",
    "start": 243.698,
    "end": 249.596,
    "duration": 5.898
  },
  {
    "id": "sent_58",
    "text": "全诗广泛运用双声叠韵与自然押韵，句式灵活舒展，",
    "start": 249.596,
    "end": 254.752,
    "duration": 5.156
  },
  {
    "id": "sent_59",
    "text": "为汉魏以后五七言诗歌体裁的发展提供了丰厚的音律给养。",
    "start": 254.753,
    "end": 260.365,
    "duration": 5.612
  }
]