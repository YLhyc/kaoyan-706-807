[
  {
    "id": 1,
    "text": "试论《诗经》的艺术成就与赋比兴表现手法。",
    "start": 0.02,
    "end": 3.6,
    "duration": 3.58
  },
  {
    "id": 2,
    "text": "《诗经》是中国古代第一部诗歌总集，也是中国现实主义诗歌传统的重要源头。",
    "start": 4.074,
    "end": 9.834,
    "duration": 5.76
  },
  {
    "id": 3,
    "text": "它全面反映了西周初年至春秋中叶五百余年间的社会生活，",
    "start": 10.304,
    "end": 15.2,
    "duration": 4.896
  },
  {
    "id": 4,
    "text": "打破了上古巫祝颂歌的神秘色彩，将诗歌目光投向世俗人间。",
    "start": 15.647,
    "end": 20.838,
    "duration": 5.191
  },
  {
    "id": 5,
    "text": "《毛诗序》更将“风雅颂”诗体与“赋比兴”技法合称《诗》之“六义”，并论风诗功用曰“风以动之，教以化之”。",
    "start": 21.071,
    "end": 30.174,
    "duration": 9.103
  },
  {
    "id": 6,
    "text": "在长期的民间歌咏与采诗编纂中，《诗经》提炼出成熟的诗歌艺术范式，奠定了后世古典诗歌的审美传统。",
    "start": 30.507,
    "end": 39.116,
    "duration": 8.609
  },
  {
    "id": 7,
    "text": "其艺术成就主要体现在以下四个方面：",
    "start": 39.578,
    "end": 42.321,
    "duration": 2.743
  },
  {
    "id": 8,
    "text": "第一，系统确立“赋、比、兴”表现手法，奠定古典诗歌的情物交融传统。",
    "start": 42.908,
    "end": 49.114,
    "duration": 6.206
  },
  {
    "id": 9,
    "text": "《诗经》最具创造性的艺术贡献，在于确立了以“赋”“比”“兴”为核心的表现技法。",
    "start": 49.505,
    "end": 56.635,
    "duration": 7.13
  },
  {
    "id": 10,
    "text": "“赋者，敷陈其事而直言之也”，如《豳风·七月》按岁时农事顺序，",
    "start": 56.762,
    "end": 61.586,
    "duration": 4.824
  },
  {
    "id": 11,
    "text": "详尽铺叙农夫四季耕织劳作的艰辛，笔触平实细腻；",
    "start": 61.87,
    "end": 66.699,
    "duration": 4.829
  },
  {
    "id": 12,
    "text": "“比者，以彼物比此物也”，如《魏风·硕鼠》将贪婪不仁的剥削者比作大老鼠，形象鲜明、讽刺辛辣；",
    "start": 67.14,
    "end": 75.885,
    "duration": 8.745
  },
  {
    "id": 13,
    "text": "“兴者，先言他物以引起所咏之词也”，",
    "start": 76.301,
    "end": 79.55,
    "duration": 3.249
  },
  {
    "id": 14,
    "text": "如《周南·关雎》开篇以“关关雎鸠，在河之洲”起兴，",
    "start": 80.072,
    "end": 84.003,
    "duration": 3.931
  },
  {
    "id": 15,
    "text": "借水鸟和鸣引出“窈窕淑女，君子好逑”的相思恋情。",
    "start": 84.277,
    "end": 88.824,
    "duration": 4.547
  },
  {
    "id": 16,
    "text": "赋比兴的综合运用，使客观物象与主观情感水乳交融，开创了后世托物言志的抒情传统。",
    "start": 89.04,
    "end": 96.478,
    "duration": 7.438
  },
  {
    "id": 17,
    "text": "第二，采用重章叠句与回环复沓结构，展现优美的音乐复奏美感。",
    "start": 97.138,
    "end": 102.878,
    "duration": 5.74
  },
  {
    "id": 18,
    "text": "《诗经》的民歌部分广泛采用重章叠句的篇章结构。",
    "start": 103.245,
    "end": 106.649,
    "duration": 3.404
  },
  {
    "id": 19,
    "text": "作品在各章节之间句式大致相同，",
    "start": 106.916,
    "end": 109.484,
    "duration": 2.568
  },
  {
    "id": 20,
    "text": "仅在关键位置更换少数同义或反义词语，于反复吟唱中层层推进情感。",
    "start": 109.651,
    "end": 115.792,
    "duration": 6.141
  },
  {
    "id": 21,
    "text": "以国风名篇《秦风·蒹葭》为例，全诗三章叠唱，",
    "start": 116.02,
    "end": 119.955,
    "duration": 3.935
  },
  {
    "id": 22,
    "text": "由“白露为霜”演进至“未晞”“未已”，由“宛在水中央”转换为“水中坻”“水中沚”；",
    "start": 120.165,
    "end": 127.167,
    "duration": 7.002
  },
  {
    "id": 23,
    "text": "随秋意渐浓与追寻空间变化，反复抒发对伊人可望而不可即的渺远惆怅。",
    "start": 127.477,
    "end": 133.545,
    "duration": 6.068
  },
  {
    "id": 24,
    "text": "这种回环复沓的结构，既强化了诗歌的音乐节律，更营造出反复低回、情韵绵长的抒情氛围。",
    "start": 133.747,
    "end": 141.616,
    "duration": 7.869
  },
  {
    "id": 25,
    "text": "第三，开创直面现实与关怀民生的写实品格，涵养“风雅”美刺精神。",
    "start": 142.242,
    "end": 148.879,
    "duration": 6.637
  },
  {
    "id": 26,
    "text": "《诗经》扎根于世俗人间的真实土壤，全面展现了周代社会的生动图景，",
    "start": 149.569,
    "end": 155.191,
    "duration": 5.622
  },
  {
    "id": 27,
    "text": "尤其是“国风”与“小雅”中的怨刺诗与社会讽谕诗，以真切笔触直面社会矛盾。",
    "start": 155.632,
    "end": 162.127,
    "duration": 6.495
  },
  {
    "id": 28,
    "text": "《魏风·伐檀》质问统治者的不劳而获，发出“不稼不穑，胡取禾三百廛兮”的严正抗议；",
    "start": 162.402,
    "end": 170.56,
    "duration": 8.158
  },
  {
    "id": 29,
    "text": "《豳风·东山》以细腻平实的细节写征夫还乡，“零雨其濛”中满怀故园荒芜的酸楚；",
    "start": 170.925,
    "end": 178.437,
    "duration": 7.512
  },
  {
    "id": 30,
    "text": "《小雅·采薇》中“昔我往矣，杨柳依依；今我来思，雨雪霏霏”，",
    "start": 178.782,
    "end": 184.702,
    "duration": 5.92
  },
  {
    "id": 31,
    "text": "以乐景写哀，将征夫的悲凉心境刻画得深沉动人。",
    "start": 184.961,
    "end": 188.836,
    "duration": 3.875
  },
  {
    "id": 32,
    "text": "这种关注民生疾苦、干预现实的写实精神，构成了儒家“美刺”诗教的优良传统。",
    "start": 189.197,
    "end": 195.447,
    "duration": 6.25
  },
  {
    "id": 33,
    "text": "第四，形成以四言为主兼备参差变化的语言体式，奠定汉语诗歌音律基础。",
    "start": 196.039,
    "end": 202.136,
    "duration": 6.097
  },
  {
    "id": 34,
    "text": "在语言体制上，《诗经》确立了以四言为主的基本诗体，形成了二二节拍的整齐节奏，",
    "start": 202.459,
    "end": 208.933,
    "duration": 6.474
  },
  {
    "id": 35,
    "text": "同时适当吸纳两字、三字乃至八字的长短句，打破单调板滞。",
    "start": 209.343,
    "end": 214.303,
    "duration": 4.96
  },
  {
    "id": 36,
    "text": "诗中善用叠字与拟声词，如《小雅·伐木》之“伐木丁丁，鸟鸣嘤嘤”，",
    "start": 214.525,
    "end": 220.132,
    "duration": 5.607
  },
  {
    "id": 37,
    "text": "《郑风·子衿》之“青青子衿，悠悠我心”，摹声状物、声律和谐；",
    "start": 220.465,
    "end": 225.738,
    "duration": 5.273
  },
  {
    "id": 38,
    "text": "全诗广泛运用双声叠韵与自然押韵，句式灵活舒展，",
    "start": 226.283,
    "end": 230.586,
    "duration": 4.303
  },
  {
    "id": 39,
    "text": "为汉魏以后五、七言诗歌体裁的发展提供了丰厚的语言与音律滋养。",
    "start": 230.884,
    "end": 236.009,
    "duration": 5.125
  },
  {
    "id": 40,
    "text": "总而言之，《诗经》以赋、比、兴技法、重章复沓音乐结构与二二节拍四言体式，",
    "start": 236.24,
    "end": 243.71,
    "duration": 7.47
  },
  {
    "id": 41,
    "text": "将先秦民间歌咏与周代礼乐文化凝为一体。",
    "start": 244.016,
    "end": 247.702,
    "duration": 3.686
  },
  {
    "id": 42,
    "text": "它所开创的直面现实、关怀民生的风雅美刺精神与含蓄蕴藉的言志传统，",
    "start": 248.056,
    "end": 254.322,
    "duration": 6.266
  },
  {
    "id": 43,
    "text": "历经汉魏乐府、建安风骨直至唐宋诗坛而一脉相承，",
    "start": 254.652,
    "end": 259.517,
    "duration": 4.865
  },
  {
    "id": 44,
    "text": "长久滋养着中国古典诗歌的创作方向。",
    "start": 259.777,
    "end": 262.828,
    "duration": 3.051
  }
]