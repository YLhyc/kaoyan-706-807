[
  {
    "id": 1,
    "text": "试论《诗经》的艺术成就与赋比兴表现手法。",
    "start": 0.28,
    "end": 3.56,
    "duration": 3.28
  },
  {
    "id": 2,
    "text": "《诗经》是中国古代第一部诗歌总集，也是中国现实主义诗歌传统的重要源头。",
    "start": 4.08,
    "end": 10.08,
    "duration": 6.0
  },
  {
    "id": 3,
    "text": "它全面反映了西周初年至春秋中叶五百余年间的社会生活，",
    "start": 10.6,
    "end": 15.4,
    "duration": 4.8
  },
  {
    "id": 4,
    "text": "打破了上古巫祝颂歌的神秘色彩，将诗歌目光投向世俗人间。",
    "start": 15.88,
    "end": 21.0,
    "duration": 5.12
  },
  {
    "id": 5,
    "text": "《毛诗序》更将“风雅颂”诗体与“赋比兴”技法合称《诗》之“六义”，并论风诗功用曰“风以动之，教以化之”。",
    "start": 21.52,
    "end": 30.4,
    "duration": 8.88
  },
  {
    "id": 6,
    "text": "在长期的民间歌咏与采诗编纂中，《诗经》提炼出成熟的诗歌艺术范式，奠定了后世古典诗歌的审美传统。",
    "start": 30.92,
    "end": 38.84,
    "duration": 7.92
  },
  {
    "id": 7,
    "text": "其艺术成就主要体现在以下四个方面：",
    "start": 39.394,
    "end": 42.08,
    "duration": 2.686
  },
  {
    "id": 8,
    "text": "第一，系统确立“赋、比、兴”表现手法，奠定古典诗歌的情物交融传统。",
    "start": 42.45,
    "end": 48.61,
    "duration": 6.16
  },
  {
    "id": 9,
    "text": "《诗经》最具创造性的艺术贡献，在于确立了以“赋”“比”“兴”为核心的表现技法。",
    "start": 49.13,
    "end": 55.13,
    "duration": 6.0
  },
  {
    "id": 10,
    "text": "“赋者，敷陈其事而直言之也”，如《豳风·七月》按岁时农事顺序，",
    "start": 55.65,
    "end": 61.63,
    "duration": 5.98
  },
  {
    "id": 11,
    "text": "详尽铺叙农夫四季耕织劳作的艰辛，笔触平实细腻；",
    "start": 61.985,
    "end": 67.46,
    "duration": 5.475
  },
  {
    "id": 12,
    "text": "“比者，以彼物比此物也”，如《魏风·硕鼠》将贪婪不仁的剥削者比作大老鼠，形象鲜明、讽刺辛辣；",
    "start": 67.98,
    "end": 76.78,
    "duration": 8.8
  },
  {
    "id": 13,
    "text": "“兴者，先言他物以引起所咏之词也”，",
    "start": 77.3,
    "end": 80.906,
    "duration": 3.606
  },
  {
    "id": 14,
    "text": "如《周南·关雎》开篇以“关关雎鸠，在河之洲”起兴，",
    "start": 81.256,
    "end": 84.87,
    "duration": 3.614
  },
  {
    "id": 15,
    "text": "借水鸟和鸣引出“窈窕淑女，君子好逑”的相思恋情。",
    "start": 85.24,
    "end": 89.64,
    "duration": 4.4
  },
  {
    "id": 16,
    "text": "赋比兴的综合运用，使客观物象与主观情感水乳交融，开创了后世托物言志的抒情传统。",
    "start": 90.16,
    "end": 97.76,
    "duration": 7.6
  },
  {
    "id": 17,
    "text": "第二，采用重章叠句与回环复沓结构，展现优美的音乐复奏美感。",
    "start": 98.28,
    "end": 103.4,
    "duration": 5.12
  },
  {
    "id": 18,
    "text": "《诗经》的民歌部分广泛采用重章叠句的篇章结构。",
    "start": 103.92,
    "end": 107.92,
    "duration": 4.0
  },
  {
    "id": 19,
    "text": "作品在各章节之间句式大致相同，",
    "start": 108.44,
    "end": 111.16,
    "duration": 2.72
  },
  {
    "id": 20,
    "text": "仅在关键位置更换少数同义或反义词语，于反复吟唱中层层推进情感。",
    "start": 111.53,
    "end": 117.85,
    "duration": 6.32
  },
  {
    "id": 21,
    "text": "以国风名篇《秦风·蒹葭》为例，全诗三章叠唱，",
    "start": 118.37,
    "end": 122.13,
    "duration": 3.76
  },
  {
    "id": 22,
    "text": "由“白露为霜”演进至“未晞”“未已”，由“宛在水中央”转换为“水中坻”“水中沚”；",
    "start": 122.5,
    "end": 129.691,
    "duration": 7.191
  },
  {
    "id": 23,
    "text": "随秋意渐浓与追寻空间变化，反复抒发对伊人可望而不可即的渺远惆怅。",
    "start": 130.191,
    "end": 137.18,
    "duration": 6.989
  },
  {
    "id": 24,
    "text": "这种回环复沓的结构，既强化了诗歌的音乐节律，更营造出反复低回、情韵绵长的抒情氛围。",
    "start": 137.7,
    "end": 145.78,
    "duration": 8.08
  },
  {
    "id": 25,
    "text": "第三，开创直面现实与关怀民生的写实品格，涵养“风雅”美刺精神。",
    "start": 146.3,
    "end": 151.82,
    "duration": 5.52
  },
  {
    "id": 26,
    "text": "《诗经》扎根于世俗人间的真实土壤，全面展现了周代社会的生动图景，",
    "start": 152.34,
    "end": 158.597,
    "duration": 6.257
  },
  {
    "id": 27,
    "text": "尤其是“国风”与“小雅”中的怨刺诗与社会讽谕诗，以真切笔触直面社会矛盾。",
    "start": 158.952,
    "end": 165.67,
    "duration": 6.718
  },
  {
    "id": 28,
    "text": "《魏风·伐檀》质问统治者的不劳而获，发出“不稼不穑，胡取禾三百廛兮”的严正抗议；",
    "start": 166.19,
    "end": 173.71,
    "duration": 7.52
  },
  {
    "id": 29,
    "text": "《豳风·东山》以细腻平实的细节写征夫还乡，“零雨其濛”中满怀故园荒芜的酸楚；",
    "start": 174.23,
    "end": 181.51,
    "duration": 7.28
  },
  {
    "id": 30,
    "text": "《小雅·采薇》中“昔我往矣，杨柳依依；今我来思，雨雪霏霏”，",
    "start": 182.03,
    "end": 187.52,
    "duration": 5.49
  },
  {
    "id": 31,
    "text": "以乐景写哀，将征夫的悲凉心境刻画得深沉动人。",
    "start": 188.16,
    "end": 192.48,
    "duration": 4.32
  },
  {
    "id": 32,
    "text": "这种关注民生疾苦、干预现实的写实精神，构成了儒家“美刺”诗教的优良传统。",
    "start": 193.0,
    "end": 199.32,
    "duration": 6.32
  },
  {
    "id": 33,
    "text": "第四，形成以四言为主兼备参差变化的语言体式，奠定汉语诗歌音律基础。",
    "start": 199.84,
    "end": 206.56,
    "duration": 6.72
  },
  {
    "id": 34,
    "text": "在语言体制上，《诗经》确立了以四言为主的基本诗体，形成了二二节拍的整齐节奏，",
    "start": 207.08,
    "end": 213.53,
    "duration": 6.45
  },
  {
    "id": 35,
    "text": "同时适当吸纳两字、三字乃至八字的长短句，打破单调板滞。",
    "start": 213.9,
    "end": 219.654,
    "duration": 5.754
  },
  {
    "id": 36,
    "text": "诗中善用叠字与拟声词，如《小雅·伐木》之“伐木丁丁，鸟鸣嘤嘤”，",
    "start": 220.154,
    "end": 225.75,
    "duration": 5.596
  },
  {
    "id": 37,
    "text": "《郑风·子衿》之“青青子衿，悠悠我心”，摹声状物、声律和谐；",
    "start": 226.12,
    "end": 232.12,
    "duration": 6.0
  },
  {
    "id": 38,
    "text": "全诗广泛运用双声叠韵与自然押韵，句式灵活舒展，",
    "start": 232.64,
    "end": 237.12,
    "duration": 4.48
  },
  {
    "id": 39,
    "text": "为汉魏以后五、七言诗歌体裁的发展提供了丰厚的语言与音律滋养。",
    "start": 237.49,
    "end": 242.93,
    "duration": 5.44
  },
  {
    "id": 40,
    "text": "总而言之，《诗经》以赋、比、兴技法、重章复沓音乐结构与二二节拍四言体式，",
    "start": 243.45,
    "end": 250.41,
    "duration": 6.96
  },
  {
    "id": 41,
    "text": "将先秦民间歌咏与周代礼乐文化凝为一体。",
    "start": 250.78,
    "end": 254.38,
    "duration": 3.6
  },
  {
    "id": 42,
    "text": "它所开创的直面现实、关怀民生的风雅美刺精神与含蓄蕴藉的言志传统，",
    "start": 254.9,
    "end": 261.3,
    "duration": 6.4
  },
  {
    "id": 43,
    "text": "历经汉魏乐府、建安风骨直至唐宋诗坛而一脉相承，",
    "start": 261.75,
    "end": 266.71,
    "duration": 4.96
  },
  {
    "id": 44,
    "text": "长久滋养着中国古典诗歌的创作方向。",
    "start": 267.11,
    "end": 270.15,
    "duration": 3.04
  }
]
