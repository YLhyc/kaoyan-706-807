[
  {
    "id": "sent_1",
    "text": "《诗经》 是中国古代第一部诗歌总集，",
    "start": 0.0,
    "end": 2.84,
    "duration": 2.84
  },
  {
    "id": "sent_2",
    "text": "也是中国现实主义诗歌传统的至高源头。",
    "start": 3.289,
    "end": 6.569,
    "duration": 3.28
  },
  {
    "id": "sent_3",
    "text": "它全面反映了西周初年至春秋中叶五百余年间广阔的社会历史生活，",
    "start": 7.019,
    "end": 12.619,
    "duration": 5.6
  },
  {
    "id": "sent_4",
    "text": "打破了上古巫术颂歌的神秘垄断，将诗歌的目光聚焦于现实人间。",
    "start": 13.069,
    "end": 18.589,
    "duration": 5.52
  },
  {
    "id": "sent_5",
    "text": "《汉书·艺文志》 赞其 “哀乐和，节文相生”。",
    "start": 19.039,
    "end": 22.159,
    "duration": 3.12
  },
  {
    "id": "sent_6",
    "text": "《诗经》 在长期的民间歌咏与史官编纂中，",
    "start": 22.609,
    "end": 25.889,
    "duration": 3.28
  },
  {
    "id": "sent_7",
    "text": "提炼出成熟的诗歌艺术范式，奠定了中华民族诗歌的审美心理结构。",
    "start": 26.339,
    "end": 31.779,
    "duration": 5.44
  },
  {
    "id": "sent_8",
    "text": "其艺术成就主要展现为以下四个核心维度：",
    "start": 32.229,
    "end": 35.509,
    "duration": 3.28
  },
  {
    "id": "sent_9",
    "text": "第一，系统确立“赋、比、兴”表现手法体系，",
    "start": 35.959,
    "end": 39.479,
    "duration": 3.52
  },
  {
    "id": "sent_10",
    "text": "奠定古典诗歌的情物交融传统。",
    "start": 39.929,
    "end": 42.489,
    "duration": 2.56
  },
  {
    "id": "sent_11",
    "text": "《诗经》 最具创造性的艺术贡献，在于建立了以 “赋”、",
    "start": 42.939,
    "end": 46.779,
    "duration": 3.84
  },
  {
    "id": "sent_12",
    "text": "“比”、“兴” 为核心的表现技法体系。",
    "start": 47.229,
    "end": 49.789,
    "duration": 2.56
  },
  {
    "id": "sent_13",
    "text": "“赋者，敷陈其事而直言之也”，",
    "start": 50.319,
    "end": 52.639,
    "duration": 2.32
  },
  {
    "id": "sent_14",
    "text": "如 《豳风·七月》 按照岁时农事顺序，",
    "start": 53.169,
    "end": 56.209,
    "duration": 3.04
  },
  {
    "id": "sent_15",
    "text": "详尽铺叙农夫一年四季耕织劳作的艰辛，笔触客观细腻；",
    "start": 56.659,
    "end": 61.819,
    "duration": 5.16
  },
  {
    "id": "sent_16",
    "text": "“比者，以彼物比此物也”，",
    "start": 62.269,
    "end": 64.469,
    "duration": 2.2
  },
  {
    "id": "sent_17",
    "text": "如 《魏风·硕鼠》 将残酷不仁的奴隶领主直接比作贪婪害人的大老鼠，",
    "start": 64.959,
    "end": 70.039,
    "duration": 5.08
  },
  {
    "id": "sent_18",
    "text": "形象鲜明、讽刺辛辣；",
    "start": 70.489,
    "end": 72.489,
    "duration": 2.0
  },
  {
    "id": "sent_19",
    "text": "“兴者，先言他物以引起所咏之词也”，",
    "start": 72.939,
    "end": 76.419,
    "duration": 3.48
  },
  {
    "id": "sent_20",
    "text": "如 《周南·关雎》 开篇以 “关关雎鸠，在河之洲” 起兴，",
    "start": 76.869,
    "end": 80.749,
    "duration": 3.88
  },
  {
    "id": "sent_21",
    "text": "借水鸟和鸣起兴引出 “窈窕淑女，君子好逑” 的相思恋情。",
    "start": 81.199,
    "end": 85.639,
    "duration": 4.44
  },
  {
    "id": "sent_22",
    "text": "赋比兴手法的综合运用，使客观物象与主观情感深度交融，",
    "start": 86.089,
    "end": 90.889,
    "duration": 4.8
  },
  {
    "id": "sent_23",
    "text": "开创了后世托物言志的博大传统。",
    "start": 91.339,
    "end": 94.019,
    "duration": 2.68
  },
  {
    "id": "sent_24",
    "text": "第二，确立重章叠句与回环复沓的篇章结构，",
    "start": 94.469,
    "end": 98.149,
    "duration": 3.68
  },
  {
    "id": "sent_25",
    "text": "展现优美的音乐复奏美感。",
    "start": 98.599,
    "end": 100.679,
    "duration": 2.08
  },
  {
    "id": "sent_26",
    "text": "《诗经》 的民歌部分广泛采用重章叠句的结构方式。",
    "start": 101.129,
    "end": 104.889,
    "duration": 3.76
  },
  {
    "id": "sent_27",
    "text": "作品在几个章节之间，字句结构基本相同，",
    "start": 105.339,
    "end": 109.059,
    "duration": 3.72
  },
  {
    "id": "sent_28",
    "text": "仅在关键位置更换少数几个同义或反义词语，",
    "start": 109.509,
    "end": 113.109,
    "duration": 3.6
  },
  {
    "id": "sent_29",
    "text": "在反复吟唱中推进情感。",
    "start": 113.559,
    "end": 115.759,
    "duration": 2.2
  },
  {
    "id": "sent_30",
    "text": "以国风名篇 《秦风·蒹葭》 为例，全诗三章叠唱，",
    "start": 116.209,
    "end": 120.249,
    "duration": 4.04
  },
  {
    "id": "sent_31",
    "text": "由 “白露为霜” 演进到 “未晞”、“未已”，",
    "start": 120.699,
    "end": 123.619,
    "duration": 2.92
  },
  {
    "id": "sent_32",
    "text": "由 “宛在水中央” 转换为 “水中坻”、“水中沚”；",
    "start": 124.069,
    "end": 127.349,
    "duration": 3.28
  },
  {
    "id": "sent_33",
    "text": "随着秋意逐渐深浓与追寻空间的层层变换，",
    "start": 127.799,
    "end": 131.239,
    "duration": 3.44
  },
  {
    "id": "sent_34",
    "text": "反复抒发了对伊人可望而不可即的渺远惆怅。",
    "start": 131.689,
    "end": 135.289,
    "duration": 3.6
  },
  {
    "id": "sent_35",
    "text": "这种回环复沓的结构，不仅极大地强化了诗歌的音乐节律，",
    "start": 135.739,
    "end": 140.219,
    "duration": 4.48
  },
  {
    "id": "sent_36",
    "text": "更营造出反复低回、情韵绵长的抒情氛围。",
    "start": 140.669,
    "end": 144.309,
    "duration": 3.64
  },
  {
    "id": "sent_37",
    "text": "第三，开创直面现实与关怀民生苦难的写实品格，",
    "start": 144.759,
    "end": 149.039,
    "duration": 4.28
  },
  {
    "id": "sent_38",
    "text": "铸就“风雅”诗教精神。",
    "start": 149.489,
    "end": 151.209,
    "duration": 1.72
  },
  {
    "id": "sent_39",
    "text": "《诗经》 牢牢扎根于世俗人间的真实土壤，",
    "start": 151.659,
    "end": 154.579,
    "duration": 2.92
  },
  {
    "id": "sent_40",
    "text": "全面展现了宗周社会的生动图景。",
    "start": 155.029,
    "end": 157.709,
    "duration": 2.68
  },
  {
    "id": "sent_41",
    "text": "尤其是 “国风” 与 “小雅” 中的怨刺诗与社会讽谕诗，",
    "start": 158.239,
    "end": 161.519,
    "duration": 3.28
  },
  {
    "id": "sent_42",
    "text": "以卓越的批判勇气直面社会矛盾。",
    "start": 161.969,
    "end": 164.729,
    "duration": 2.76
  },
  {
    "id": "sent_43",
    "text": "《魏风·伐檀》 面对统治者的不劳而获，发出 “不稼不穑，",
    "start": 165.179,
    "end": 168.979,
    "duration": 3.8
  },
  {
    "id": "sent_44",
    "text": "胡取禾三百廛兮” 的严正抗议；",
    "start": 169.429,
    "end": 171.829,
    "duration": 2.4
  },
  {
    "id": "sent_45",
    "text": "《豳风·东山》 以细腻平实的细节描写征夫还乡，",
    "start": 172.279,
    "end": 176.079,
    "duration": 3.8
  },
  {
    "id": "sent_46",
    "text": "“零雨其濛” 中满怀对故园荒芜的酸楚；",
    "start": 176.528,
    "end": 179.328,
    "duration": 2.8
  },
  {
    "id": "sent_47",
    "text": "《小雅·采薇》 中 “昔我往矣，杨柳依依；",
    "start": 179.858,
    "end": 182.778,
    "duration": 2.92
  },
  {
    "id": "sent_48",
    "text": "今我来思，雨雪霏霏”，以乐景写哀，",
    "start": 183.228,
    "end": 186.228,
    "duration": 3.0
  },
  {
    "id": "sent_49",
    "text": "将战火中士兵的悲凉心灵刻画得入木三分。",
    "start": 186.678,
    "end": 190.078,
    "duration": 3.4
  },
  {
    "id": "sent_50",
    "text": "这种关注生民疾苦、干预现实的批判精神，",
    "start": 190.528,
    "end": 194.128,
    "duration": 3.6
  },
  {
    "id": "sent_51",
    "text": "直接构成了儒家“美刺”诗教的优良传统。",
    "start": 194.578,
    "end": 197.858,
    "duration": 3.28
  },
  {
    "id": "sent_52",
    "text": "第四，形成以四言为主兼备参差变化的语言体式，",
    "start": 198.308,
    "end": 202.588,
    "duration": 4.28
  },
  {
    "id": "sent_53",
    "text": "奠定汉语诗歌的音律节奏。",
    "start": 203.038,
    "end": 205.198,
    "duration": 2.16
  },
  {
    "id": "sent_54",
    "text": "在语言体制上，《诗经》 确立了以四言为主的基本诗体，",
    "start": 205.648,
    "end": 209.408,
    "duration": 3.76
  },
  {
    "id": "sent_55",
    "text": "形成了二二节拍的整齐节奏。",
    "start": 209.858,
    "end": 212.138,
    "duration": 2.28
  },
  {
    "id": "sent_56",
    "text": "同时，诗中大量吸纳两字、三字直至八字的长短句，打破单调僵化；",
    "start": 212.588,
    "end": 218.228,
    "duration": 5.64
  },
  {
    "id": "sent_57",
    "text": "《诗经》 极善运用叠字与拟声词，",
    "start": 218.758,
    "end": 221.398,
    "duration": 2.64
  },
  {
    "id": "sent_58",
    "text": "如 《小雅·伐木》 之 “伐木丁丁，鸟鸣嘤嘤”，",
    "start": 221.928,
    "end": 224.968,
    "duration": 3.04
  },
  {
    "id": "sent_59",
    "text": "《郑风·子衿》 之 “青青子衿，悠悠我心”，形象逼真、",
    "start": 225.418,
    "end": 229.498,
    "duration": 4.08
  },
  {
    "id": "sent_60",
    "text": "声律和谐；",
    "start": 229.948,
    "end": 231.148,
    "duration": 1.2
  },
  {
    "id": "sent_61",
    "text": "全诗广泛运用双声叠韵与自然押韵，句式灵活舒展，",
    "start": 231.678,
    "end": 235.878,
    "duration": 4.2
  },
  {
    "id": "sent_62",
    "text": "为汉魏以后五七言诗歌体裁的发展提供了丰厚的音律给养。",
    "start": 236.328,
    "end": 241.168,
    "duration": 4.84
  }
]