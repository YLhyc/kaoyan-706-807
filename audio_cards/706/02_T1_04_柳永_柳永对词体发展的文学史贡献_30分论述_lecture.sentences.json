[
  {
    "id": 1,
    "text": "试论柳永对词体发展的文学史贡献。",
    "start": 0.16,
    "end": 4.08,
    "duration": 3.92
  },
  {
    "id": 2,
    "text": "柳永是北宋词坛第一位全身心投入创作的专业词人。",
    "start": 4.08,
    "end": 8.56,
    "duration": 4.48
  },
  {
    "id": 3,
    "text": "面对五代至宋初词坛小令题材局限于士大夫尊前欢宴、",
    "start": 8.56,
    "end": 14.16,
    "duration": 5.6
  },
  {
    "id": 4,
    "text": "体式短狭的格局，",
    "start": 14.16,
    "end": 16.08,
    "duration": 1.92
  },
  {
    "id": 5,
    "text": "柳永以毕生精力顺应市民音乐与坊市文化繁荣的历史潮流，",
    "start": 16.08,
    "end": 21.44,
    "duration": 5.36
  },
  {
    "id": 6,
    "text": "对词体进行了全方位的开创性革新。",
    "start": 21.44,
    "end": 24.48,
    "duration": 3.04
  },
  {
    "id": 7,
    "text": "叶梦得在 《避暑录话》 中记录其盛况：“凡有井水饮处，",
    "start": 24.56,
    "end": 30.32,
    "duration": 5.76
  },
  {
    "id": 8,
    "text": "皆能歌柳词。",
    "start": 30.32,
    "end": 31.36,
    "duration": 1.04
  },
  {
    "id": 9,
    "text": "” 其对宋代词体发展的划时代贡献，",
    "start": 31.36,
    "end": 34.24,
    "duration": 2.88
  },
  {
    "id": 10,
    "text": "主要展现为以下四个核心维度：",
    "start": 34.64,
    "end": 38.08,
    "duration": 3.44
  },
  {
    "id": 11,
    "text": "第一，大力创制慢词长调，全面打破小令狭隘格局以拓展篇幅容量。",
    "start": 38.08,
    "end": 44.8,
    "duration": 6.72
  },
  {
    "id": 12,
    "text": "在柳永之前，词坛以五代花间以来数十至六七十字的小令为主。",
    "start": 44.8,
    "end": 50.4,
    "duration": 5.6
  },
  {
    "id": 13,
    "text": "柳永充分吸纳坊市新声，大量创制百字以上的慢词长调。",
    "start": 50.4,
    "end": 56.08,
    "duration": 5.68
  },
  {
    "id": 14,
    "text": "在两宋存世的数百个词调中，",
    "start": 56.08,
    "end": 59.12,
    "duration": 3.04
  },
  {
    "id": 15,
    "text": "柳永创制和首先使用的慢词就达一百余个。",
    "start": 59.12,
    "end": 63.36,
    "duration": 4.24
  },
  {
    "id": 16,
    "text": "慢词长调的普及，",
    "start": 63.36,
    "end": 65.36,
    "duration": 2.0
  },
  {
    "id": 17,
    "text": "从根本上改变了词体短小轻灵的截取片断特征，",
    "start": 65.36,
    "end": 69.84,
    "duration": 4.48
  },
  {
    "id": 18,
    "text": "使词具备了容纳复杂曲折叙事、",
    "start": 69.84,
    "end": 72.72,
    "duration": 2.88
  },
  {
    "id": 19,
    "text": "多层次抒情与细致景物铺排的宏大体制，",
    "start": 72.72,
    "end": 76.64,
    "duration": 3.92
  },
  {
    "id": 20,
    "text": "实现了由文人樽前余技向长篇独立抒情文学的体制跃升。",
    "start": 76.64,
    "end": 82.0,
    "duration": 5.36
  },
  {
    "id": 21,
    "text": "第二，革新词体表现手法，",
    "start": 82.0,
    "end": 84.88,
    "duration": 2.88
  },
  {
    "id": 22,
    "text": "确立“铺叙展衍”与白描写景的章法传统。",
    "start": 84.88,
    "end": 89.12,
    "duration": 4.24
  },
  {
    "id": 23,
    "text": "与小令注重意象瞬间跳跃、含蓄凝练不同，",
    "start": 89.12,
    "end": 93.12,
    "duration": 4.0
  },
  {
    "id": 24,
    "text": "柳永开创了 “铺叙展衍” 的赋体手法。",
    "start": 93.12,
    "end": 97.6,
    "duration": 4.48
  },
  {
    "id": 25,
    "text": "他善于在时间和空间轴线上层层推进情节与情感。",
    "start": 97.84,
    "end": 102.96,
    "duration": 5.12
  },
  {
    "id": 26,
    "text": "在 《八声甘州》 中，先以 “对潇潇暮雨洒江天，",
    "start": 102.96,
    "end": 107.92,
    "duration": 4.96
  },
  {
    "id": 27,
    "text": "一番洗清秋” 极力铺写秋江寥落景象；",
    "start": 107.92,
    "end": 112.32,
    "duration": 4.4
  },
  {
    "id": 28,
    "text": "接着以 “不忍登高临远，望故乡渺邈，",
    "start": 112.32,
    "end": 116.4,
    "duration": 4.08
  },
  {
    "id": 29,
    "text": "归思难收” 直抒身世之慨；后半阕笔锋陡转，虚设对方之景，",
    "start": 116.4,
    "end": 122.16,
    "duration": 5.76
  },
  {
    "id": 30,
    "text": "“想佳人，妆楼颙望，误几回、天际识归舟”，",
    "start": 122.16,
    "end": 127.44,
    "duration": 5.28
  },
  {
    "id": 31,
    "text": "通过主客双向铺叙将相思羁旅推向极境；在 《雨霖铃》 中，",
    "start": 127.44,
    "end": 132.376,
    "duration": 4.936
  },
  {
    "id": 32,
    "text": "由留恋执手到千种风情，全篇章法井然、顿挫有致。",
    "start": 132.456,
    "end": 137.096,
    "duration": 4.64
  },
  {
    "id": 33,
    "text": "第三，开拓羁旅行役与市民世俗题材，实现审美趣味的平民化转向。",
    "start": 137.336,
    "end": 144.056,
    "duration": 6.72
  },
  {
    "id": 34,
    "text": "柳永彻底打破了传统文人词局限于深闺怨妇与欢场作乐的陈旧主题，",
    "start": 144.056,
    "end": 151.416,
    "duration": 7.36
  },
  {
    "id": 35,
    "text": "第一次将落魄士人的 “羁旅行役之苦” 写入词中。",
    "start": 151.416,
    "end": 156.776,
    "duration": 5.36
  },
  {
    "id": 36,
    "text": "他将自身仕途受挫、浪迹江湖的真实漂泊体验倾注于词，",
    "start": 156.776,
    "end": 163.016,
    "duration": 6.24
  },
  {
    "id": 37,
    "text": "开创了词史上的羁旅新传统。",
    "start": 163.016,
    "end": 165.896,
    "duration": 2.88
  },
  {
    "id": 38,
    "text": "同时，柳永长期沉溺市井瓦舍，大量描写市井烟火、",
    "start": 165.896,
    "end": 171.256,
    "duration": 5.36
  },
  {
    "id": 39,
    "text": "市民男女婚恋与都市繁华，如 《望海潮》 中 “市列珠玑，",
    "start": 171.256,
    "end": 176.776,
    "duration": 5.52
  },
  {
    "id": 40,
    "text": "户盈罗绮，竞豪奢”，生动勾勒出北宋杭州的富庶气象，",
    "start": 176.776,
    "end": 181.816,
    "duration": 5.04
  },
  {
    "id": 41,
    "text": "实现了宋词由士大夫书斋向大众世俗生活的深层沉降。",
    "start": 182.056,
    "end": 187.736,
    "duration": 5.68
  },
  {
    "id": 42,
    "text": "第四，吸纳市井俚语与俗曲口语，",
    "start": 187.736,
    "end": 191.096,
    "duration": 3.36
  },
  {
    "id": 43,
    "text": "形成通俗明畅的全新词体语言风格。",
    "start": 191.096,
    "end": 194.856,
    "duration": 3.76
  },
  {
    "id": 44,
    "text": "在词的语言风格上，",
    "start": 194.856,
    "end": 196.856,
    "duration": 2.0
  },
  {
    "id": 45,
    "text": "柳永敢于突破传统文人雕琢藻饰的清雅格调，",
    "start": 196.936,
    "end": 201.736,
    "duration": 4.8
  },
  {
    "id": 46,
    "text": "大胆吸纳民间口语、俚俗方言与勾栏市井俗语。",
    "start": 201.736,
    "end": 205.656,
    "duration": 3.92
  },
  {
    "id": 47,
    "text": "他的语言自然浅近、明白如话，如 “系我一生心，",
    "start": 205.656,
    "end": 209.976,
    "duration": 4.32
  },
  {
    "id": 48,
    "text": "负你千行泪”、“衣带渐宽终不悔，为伊消得人憔悴”，",
    "start": 209.976,
    "end": 211.576,
    "duration": 1.6
  },
  {
    "id": 49,
    "text": "直白晓畅而回肠荡气。",
    "start": 211.336,
    "end": 211.576,
    "duration": 0.24
  },
  {
    "id": 50,
    "text": "苏轼对其诗化名句极度推崇，赞其 “霜风凄紧，关河冷落，",
    "start": 211.336,
    "end": 211.576,
    "duration": 0.24
  },
  {
    "id": 51,
    "text": "残照当楼” 具有不减唐人高境之风骨。",
    "start": 211.336,
    "end": 211.576,
    "duration": 0.24
  },
  {
    "id": 52,
    "text": "柳永的词体创造不仅直接启迪了苏轼、周邦彦等后代词学大家，",
    "start": 211.336,
    "end": 211.576,
    "duration": 0.24
  },
  {
    "id": 53,
    "text": "更为两宋慢词的极盛繁荣奠定了基石。",
    "start": 211.336,
    "end": 211.576,
    "duration": 0.24
  }
]