[
  {
    "id": 1,
    "text": "试论柳永对词体发展的文学史贡献。",
    "start": 0.08,
    "end": 3.235,
    "duration": 3.155
  },
  {
    "id": 2,
    "text": "柳永是北宋词坛第一位全身心投入创作的专业词人。",
    "start": 3.929,
    "end": 7.964,
    "duration": 4.035
  },
  {
    "id": 3,
    "text": "面对五代至宋初词坛小令题材局限于士大夫尊前欢宴、",
    "start": 8.459,
    "end": 13.439,
    "duration": 4.98
  },
  {
    "id": 4,
    "text": "体式短狭的格局，",
    "start": 13.774,
    "end": 15.228,
    "duration": 1.454
  },
  {
    "id": 5,
    "text": "柳永以毕生精力顺应市民音乐与坊市文化繁荣的历史潮流，",
    "start": 15.594,
    "end": 20.224,
    "duration": 4.63
  },
  {
    "id": 6,
    "text": "对词体进行了全方位的开创性革新。",
    "start": 20.606,
    "end": 23.382,
    "duration": 2.776
  },
  {
    "id": 7,
    "text": "叶梦得在 《避暑录话》 中记录其盛况：“凡有井水饮处，",
    "start": 23.623,
    "end": 27.821,
    "duration": 4.198
  },
  {
    "id": 8,
    "text": "皆能歌柳词。",
    "start": 28.064,
    "end": 29.068,
    "duration": 1.004
  },
  {
    "id": 9,
    "text": "” 其对宋代词体发展的划时代贡献，",
    "start": 29.44,
    "end": 31.996,
    "duration": 2.556
  },
  {
    "id": 10,
    "text": "主要展现为以下四个核心维度：",
    "start": 32.1,
    "end": 34.302,
    "duration": 2.202
  },
  {
    "id": 11,
    "text": "第一，大力创制慢词长调，全面打破小令狭隘格局以拓展篇幅容量。",
    "start": 34.695,
    "end": 41.15,
    "duration": 6.455
  },
  {
    "id": 12,
    "text": "在柳永之前，词坛以五代花间以来数十至六七十字的小令为主。",
    "start": 41.235,
    "end": 46.365,
    "duration": 5.13
  },
  {
    "id": 13,
    "text": "柳永充分吸纳坊市新声，大量创制百字以上的慢词长调。",
    "start": 46.584,
    "end": 51.766,
    "duration": 5.182
  },
  {
    "id": 14,
    "text": "在两宋存世的数百个词调中，",
    "start": 51.873,
    "end": 54.416,
    "duration": 2.543
  },
  {
    "id": 15,
    "text": "柳永创制和首先使用的慢词就达一百余个。",
    "start": 54.484,
    "end": 57.891,
    "duration": 3.407
  },
  {
    "id": 16,
    "text": "慢词长调的普及，",
    "start": 58.373,
    "end": 59.745,
    "duration": 1.372
  },
  {
    "id": 17,
    "text": "从根本上改变了词体短小轻灵的截取片断特征，",
    "start": 59.745,
    "end": 64.618,
    "duration": 4.873
  },
  {
    "id": 18,
    "text": "使词具备了容纳复杂曲折叙事、",
    "start": 64.618,
    "end": 67.369,
    "duration": 2.751
  },
  {
    "id": 19,
    "text": "多层次抒情与细致景物铺排的宏大体制，",
    "start": 67.414,
    "end": 70.846,
    "duration": 3.432
  },
  {
    "id": 20,
    "text": "实现了由文人樽前余技向长篇独立抒情文学的体制跃升。",
    "start": 71.199,
    "end": 75.713,
    "duration": 4.514
  },
  {
    "id": 21,
    "text": "第二，革新词体表现手法，",
    "start": 75.938,
    "end": 78.066,
    "duration": 2.128
  },
  {
    "id": 22,
    "text": "确立“铺叙展衍”与白描写景的章法传统。",
    "start": 78.211,
    "end": 81.544,
    "duration": 3.333
  },
  {
    "id": 23,
    "text": "与小令注重意象瞬间跳跃、含蓄凝练不同，",
    "start": 81.906,
    "end": 85.651,
    "duration": 3.745
  },
  {
    "id": 24,
    "text": "柳永开创了 “铺叙展衍” 的赋体手法。",
    "start": 85.924,
    "end": 88.693,
    "duration": 2.769
  },
  {
    "id": 25,
    "text": "他善于在时间和空间轴线上层层推进情节与情感。",
    "start": 89.041,
    "end": 93.685,
    "duration": 4.644
  },
  {
    "id": 26,
    "text": "在 《八声甘州》 中，先以 “对潇潇暮雨洒江天，",
    "start": 93.729,
    "end": 97.681,
    "duration": 3.952
  },
  {
    "id": 27,
    "text": "一番洗清秋” 极力铺写秋江寥落景象；",
    "start": 97.906,
    "end": 101.402,
    "duration": 3.496
  },
  {
    "id": 28,
    "text": "接着以 “不忍登高临远，望故乡渺邈，",
    "start": 101.622,
    "end": 104.794,
    "duration": 3.172
  },
  {
    "id": 29,
    "text": "归思难收” 直抒身世之慨；后半阕笔锋陡转，虚设对方之景，",
    "start": 104.939,
    "end": 109.947,
    "duration": 5.008
  },
  {
    "id": 30,
    "text": "“想佳人，妆楼颙望，误几回、天际识归舟”，",
    "start": 110.108,
    "end": 114.189,
    "duration": 4.081
  },
  {
    "id": 31,
    "text": "通过主客双向铺叙将相思羁旅推向极境；在 《雨霖铃》 中，",
    "start": 114.254,
    "end": 118.948,
    "duration": 4.694
  },
  {
    "id": 32,
    "text": "由留恋执手到千种风情，全篇章法井然、顿挫有致。",
    "start": 119.166,
    "end": 123.364,
    "duration": 4.198
  },
  {
    "id": 33,
    "text": "第三，开拓羁旅行役与市民世俗题材，实现审美趣味的平民化转向。",
    "start": 123.604,
    "end": 129.406,
    "duration": 5.802
  },
  {
    "id": 34,
    "text": "柳永彻底打破了传统文人词局限于深闺怨妇与欢场作乐的陈旧主题，",
    "start": 129.679,
    "end": 135.332,
    "duration": 5.653
  },
  {
    "id": 35,
    "text": "第一次将落魄士人的 “羁旅行役之苦” 写入词中。",
    "start": 135.512,
    "end": 139.553,
    "duration": 4.041
  },
  {
    "id": 36,
    "text": "他将自身仕途受挫、浪迹江湖的真实漂泊体验倾注于词，",
    "start": 139.864,
    "end": 144.824,
    "duration": 4.96
  },
  {
    "id": 37,
    "text": "开创了词史上的羁旅新传统。",
    "start": 144.976,
    "end": 147.636,
    "duration": 2.66
  },
  {
    "id": 38,
    "text": "同时，柳永长期沉溺市井瓦舍，大量描写市井烟火、",
    "start": 147.967,
    "end": 152.26,
    "duration": 4.293
  },
  {
    "id": 39,
    "text": "市民男女婚恋与都市繁华，如 《望海潮》 中 “市列珠玑，",
    "start": 152.26,
    "end": 157.536,
    "duration": 5.276
  },
  {
    "id": 40,
    "text": "户盈罗绮，竞豪奢”，生动勾勒出北宋杭州的富庶气象，",
    "start": 157.748,
    "end": 162.504,
    "duration": 4.756
  },
  {
    "id": 41,
    "text": "实现了宋词由士大夫书斋向大众世俗生活的深层沉降。",
    "start": 162.786,
    "end": 167.487,
    "duration": 4.701
  },
  {
    "id": 42,
    "text": "第四，吸纳市井俚语与俗曲口语，",
    "start": 167.674,
    "end": 170.817,
    "duration": 3.143
  },
  {
    "id": 43,
    "text": "形成通俗明畅的全新词体语言风格。",
    "start": 171.043,
    "end": 174.154,
    "duration": 3.111
  },
  {
    "id": 44,
    "text": "在词的语言风格上，",
    "start": 174.72,
    "end": 176.049,
    "duration": 1.329
  },
  {
    "id": 45,
    "text": "柳永敢于突破传统文人雕琢藻饰的清雅格调，",
    "start": 176.274,
    "end": 179.889,
    "duration": 3.615
  },
  {
    "id": 46,
    "text": "大胆吸纳民间口语、俚俗方言与勾栏市井俗语。",
    "start": 180.089,
    "end": 184.015,
    "duration": 3.926
  },
  {
    "id": 47,
    "text": "他的语言自然浅近、明白如话，如 “系我一生心，",
    "start": 184.415,
    "end": 188.593,
    "duration": 4.178
  },
  {
    "id": 48,
    "text": "负你千行泪”、“衣带渐宽终不悔，为伊消得人憔悴”，",
    "start": 188.707,
    "end": 192.935,
    "duration": 4.228
  },
  {
    "id": 49,
    "text": "直白晓畅而回肠荡气。",
    "start": 193.195,
    "end": 195.111,
    "duration": 1.916
  },
  {
    "id": 50,
    "text": "苏轼对其诗化名句极度推崇，赞其 “霜风凄紧，关河冷落，",
    "start": 195.341,
    "end": 200.329,
    "duration": 4.988
  },
  {
    "id": 51,
    "text": "残照当楼” 具有不减唐人高境之风骨。",
    "start": 200.468,
    "end": 203.403,
    "duration": 2.935
  },
  {
    "id": 52,
    "text": "柳永的词体创造不仅直接启迪了苏轼、周邦彦等后代词学大家，",
    "start": 203.598,
    "end": 208.485,
    "duration": 4.887
  },
  {
    "id": 53,
    "text": "更为两宋慢词的极盛繁荣奠定了基石。",
    "start": 208.632,
    "end": 211.8,
    "duration": 3.168
  }
]
