[
  {
    "id": 1,
    "text": "柳永是北宋词坛第一位全身心投入创作的专业词人。",
    "start": 0.1,
    "end": 4.972,
    "duration": 4.872
  },
  {
    "id": 2,
    "text": "面对五代至宋初词坛小令题材局限于士大夫尊前欢宴，体式短狭的格局，柳永以毕生精力顺应市民音乐与坊市文化繁荣的历史潮流，对词体进行了全方位的开创性革新。",
    "start": 4.922,
    "end": 20.873,
    "duration": 15.951
  },
  {
    "id": 3,
    "text": "叶梦得在 《避暑录话》 中记录其盛况，“凡有井水饮处，皆能歌柳词。",
    "start": 20.872,
    "end": 26.836,
    "duration": 5.964
  },
  {
    "id": 4,
    "text": "其对宋代词体发展的划时代贡献，主要展现为以下四个核心维度，",
    "start": 26.836,
    "end": 32.878,
    "duration": 6.042
  },
  {
    "id": 5,
    "text": "第一，大力创制慢词长调，全面打破小令狭隘格局以拓展篇幅容量。",
    "start": 32.878,
    "end": 39.74,
    "duration": 6.862
  },
  {
    "id": 6,
    "text": "在柳永之前，词坛以五代花间以来数十至六七十字的小令为主。",
    "start": 39.74,
    "end": 45.873,
    "duration": 6.133
  },
  {
    "id": 7,
    "text": "柳永充分吸纳坊市新声，大量创制百字以上的慢词长调。",
    "start": 45.872,
    "end": 51.263,
    "duration": 5.391
  },
  {
    "id": 8,
    "text": "在两宋存世的数百个词调中，柳永创制和首先使用的慢词就达一百余个。",
    "start": 51.263,
    "end": 57.93,
    "duration": 6.667
  },
  {
    "id": 9,
    "text": "慢词长调的普及，从根本上改变了词体短小轻灵的截取片断特征，使词具备了容纳复杂曲折叙事，多层次抒情与细致景物铺排的宏大体制，实现了由文人樽前余技向长篇独立抒情文学的体制跃升。",
    "start": 57.93,
    "end": 75.803,
    "duration": 17.873
  },
  {
    "id": 10,
    "text": "第二，革新词体表现手法，确立“铺叙展衍”与白描写景的章法传统。",
    "start": 75.803,
    "end": 82.157,
    "duration": 6.354
  },
  {
    "id": 11,
    "text": "与小令注重意象瞬间跳跃，含蓄凝练不同，柳永开创了 “铺叙展衍” 的赋体手法。",
    "start": 82.157,
    "end": 89.201,
    "duration": 7.044
  },
  {
    "id": 12,
    "text": "他善于在时间和空间轴线上层层推进情节与情感。",
    "start": 89.202,
    "end": 94.28,
    "duration": 5.078
  },
  {
    "id": 13,
    "text": "在 《八声甘州》 中，先以 “对潇潇暮雨洒江天，一番洗清秋” 极力铺写秋江寥落景象；接着以 “不忍登高临远，望故乡渺邈，归思难收” 直抒身世之慨；后半阕笔锋陡转，虚设对方之景，“想佳人，妆楼颙望，误几回，天际识归舟”，通过主客双向铺叙将相思羁旅推向极境；在 《雨霖铃》 中，由留恋执手到千种风情，全篇章法井然，顿挫有致。",
    "start": 94.28,
    "end": 124.653,
    "duration": 30.373
  },
  {
    "id": 14,
    "text": "第三，开拓羁旅行役与市民世俗题材，实现审美趣味的平民化转向。",
    "start": 124.653,
    "end": 131.15,
    "duration": 6.497
  },
  {
    "id": 15,
    "text": "柳永彻底打破了传统文人词局限于深闺怨妇与欢场作乐的陈旧主题，第一次将落魄士人的 “羁旅行役之苦” 写入词中。",
    "start": 131.151,
    "end": 141.424,
    "duration": 10.273
  },
  {
    "id": 16,
    "text": "他将自身仕途受挫，浪迹江湖的真实漂泊体验倾注于词，开创了词史上的羁旅新传统。",
    "start": 141.424,
    "end": 149.38,
    "duration": 7.956
  },
  {
    "id": 17,
    "text": "同时，柳永长期沉溺市井瓦舍，大量描写市井烟火，市民男女婚恋与都市繁华，如 《望海潮》 中 “市列珠玑，户盈罗绮，竞豪奢”，生动勾勒出北宋杭州的富庶气象，实现了宋词由士大夫书斋向大众世俗生活的深层沉降。",
    "start": 149.38,
    "end": 169.272,
    "duration": 19.892
  },
  {
    "id": 18,
    "text": "第四，吸纳市井俚语与俗曲口语，形成通俗明畅的全新词体语言风格。",
    "start": 169.271,
    "end": 176.12,
    "duration": 6.849
  },
  {
    "id": 19,
    "text": "在词的语言风格上，柳永敢于突破传统文人雕琢藻饰的清雅格调，大胆吸纳民间口语，俚俗方言与勾栏市井俗语。",
    "start": 176.12,
    "end": 186.68,
    "duration": 10.56
  },
  {
    "id": 20,
    "text": "他的语言自然浅近，明白如话，如 “系我一生心，负你千行泪”，“衣带渐宽终不悔，为伊消得人憔悴”，直白晓畅而回肠荡气。",
    "start": 186.68,
    "end": 197.735,
    "duration": 11.055
  },
  {
    "id": 21,
    "text": "苏轼对其诗化名句极度推崇，赞其 “霜风凄紧，关河冷落，残照当楼” 具有不减唐人高境之风骨。",
    "start": 197.735,
    "end": 206.719,
    "duration": 8.984
  },
  {
    "id": 22,
    "text": "柳永的词体创造不仅直接启迪了苏轼，周邦彦等后代词学大家，更为两宋慢词的极盛繁荣奠定了基石。",
    "start": 206.719,
    "end": 216.302,
    "duration": 9.583
  },
  {
    "id": 23,
    "text": "1. 这一问到底在考什么？",
    "start": 216.303,
    "end": 219.024,
    "duration": 2.721
  },
  {
    "id": 24,
    "text": "本题考查柳永在宋代词史上的专业化革新。",
    "start": 219.024,
    "end": 223.021,
    "duration": 3.997
  },
  {
    "id": 25,
    "text": "必须答透，慢词体制拓展，铺叙表现手法，羁旅市民题材突破以及俚俗口语的语言风格。",
    "start": 223.021,
    "end": 231.367,
    "duration": 8.346
  },
  {
    "id": 26,
    "text": "2. 答题的总视角是什么？",
    "start": 231.368,
    "end": 233.673,
    "duration": 2.305
  },
  {
    "id": 27,
    "text": "立足北宋市井商业经济繁荣与新兴市民阶层文化需求。",
    "start": 233.672,
    "end": 238.932,
    "duration": 5.26
  },
  {
    "id": 28,
    "text": "由体制体制（慢词创制） $\\rightarrow$ 表现技法（铺叙展衍） $\\rightarrow$ 题材开拓（羁旅行役与市井） $\\rightarrow$ 语言风格（俗语入词），层层递进。",
    "start": 238.933,
    "end": 255.847,
    "duration": 16.914
  },
  {
    "id": 29,
    "text": "3. 分几个板块推进？",
    "start": 255.847,
    "end": 257.995,
    "duration": 2.148
  },
  {
    "id": 30,
    "text": "慢词长调体制革命 $\\rightarrow$ 铺叙展衍章法确立 $\\rightarrow$ 羁旅市民题材开拓 $\\rightarrow$ 俚俗通俗语言风格。",
    "start": 257.995,
    "end": 272.044,
    "duration": 14.049
  },
  {
    "id": 31,
    "text": "4. 内在因果链条是什么？",
    "start": 272.045,
    "end": 274.584,
    "duration": 2.539
  },
  {
    "id": 32,
    "text": "市井音乐新声促成慢词体制诞生；慢词篇幅扩大要求铺叙手法的相生；江湖浪迹生活注入了羁旅行役真实情感；大众传播需求推动了平俗口语的成熟。",
    "start": 274.584,
    "end": 289.441,
    "duration": 14.857
  }
]