[
  {
    "id": 1,
    "text": "试论柳永对词体发展的文学史贡献。",
    "start": 0.05,
    "end": 3.939,
    "duration": 3.889
  },
  {
    "id": 2,
    "text": "柳永是北宋词坛第一位全身心投入创作的专业词人。",
    "start": 3.939,
    "end": 8.469,
    "duration": 4.53
  },
  {
    "id": 3,
    "text": "面对五代至宋初词坛小令题材局限于士大夫尊前欢宴、",
    "start": 8.469,
    "end": 13.79,
    "duration": 5.321
  },
  {
    "id": 4,
    "text": "体式短狭的格局，",
    "start": 13.79,
    "end": 15.605,
    "duration": 1.815
  },
  {
    "id": 5,
    "text": "柳永以毕生精力顺应市民音乐与坊市文化繁荣的历史潮流，",
    "start": 15.605,
    "end": 20.616,
    "duration": 5.011
  },
  {
    "id": 6,
    "text": "对词体进行了全方位的开创性革新。",
    "start": 20.616,
    "end": 23.634,
    "duration": 3.018
  },
  {
    "id": 7,
    "text": "叶梦得在 《避暑录话》 中记录其盛况：“凡有井水饮处，",
    "start": 23.634,
    "end": 28.076,
    "duration": 4.442
  },
  {
    "id": 8,
    "text": "皆能歌柳词。",
    "start": 28.076,
    "end": 29.452,
    "duration": 1.376
  },
  {
    "id": 9,
    "text": "” 其对宋代词体发展的划时代贡献，",
    "start": 29.452,
    "end": 32.254,
    "duration": 2.802
  },
  {
    "id": 10,
    "text": "主要展现为以下四个核心维度：",
    "start": 32.254,
    "end": 35.448,
    "duration": 3.194
  },
  {
    "id": 11,
    "text": "第一，大力创制慢词长调，全面打破小令狭隘格局以拓展篇幅容量。",
    "start": 35.448,
    "end": 42.51,
    "duration": 7.062
  },
  {
    "id": 12,
    "text": "在柳永之前，词坛以五代花间以来数十至六七十字的小令为主。",
    "start": 42.51,
    "end": 48.86,
    "duration": 6.35
  },
  {
    "id": 13,
    "text": "柳永充分吸纳坊市新声，大量创制百字以上的慢词长调。",
    "start": 48.86,
    "end": 54.319,
    "duration": 5.459
  },
  {
    "id": 14,
    "text": "在两宋存世的数百个词调中，",
    "start": 54.319,
    "end": 56.873,
    "duration": 2.554
  },
  {
    "id": 15,
    "text": "柳永创制和首先使用的慢词就达一百余个。",
    "start": 56.873,
    "end": 60.146,
    "duration": 3.273
  },
  {
    "id": 16,
    "text": "慢词长调的普及，",
    "start": 60.146,
    "end": 61.68,
    "duration": 1.534
  },
  {
    "id": 17,
    "text": "从根本上改变了词体短小轻灵的截取片断特征，",
    "start": 61.68,
    "end": 67.229,
    "duration": 5.549
  },
  {
    "id": 18,
    "text": "使词具备了容纳复杂曲折叙事、",
    "start": 67.229,
    "end": 69.592,
    "duration": 2.363
  },
  {
    "id": 19,
    "text": "多层次抒情与细致景物铺排的宏大体制，",
    "start": 69.592,
    "end": 73.201,
    "duration": 3.609
  },
  {
    "id": 20,
    "text": "实现了由文人樽前余技向长篇独立抒情文学的体制跃升。",
    "start": 73.201,
    "end": 78.226,
    "duration": 5.025
  },
  {
    "id": 21,
    "text": "第二，革新词体表现手法，",
    "start": 78.226,
    "end": 81.916,
    "duration": 3.69
  },
  {
    "id": 22,
    "text": "确立“铺叙展衍”与白描写景的章法传统。",
    "start": 81.916,
    "end": 85.936,
    "duration": 4.02
  },
  {
    "id": 23,
    "text": "与小令注重意象瞬间跳跃、含蓄凝练不同，",
    "start": 85.936,
    "end": 89.051,
    "duration": 3.115
  },
  {
    "id": 24,
    "text": "柳永开创了 “铺叙展衍” 的赋体手法。",
    "start": 89.051,
    "end": 91.596,
    "duration": 2.545
  },
  {
    "id": 25,
    "text": "他善于在时间和空间轴线上层层推进情节与情感。",
    "start": 91.596,
    "end": 95.9,
    "duration": 4.304
  },
  {
    "id": 26,
    "text": "在 《八声甘州》 中，先以 “对潇潇暮雨洒江天，",
    "start": 95.9,
    "end": 99.275,
    "duration": 3.375
  },
  {
    "id": 27,
    "text": "一番洗清秋” 极力铺写秋江寥落景象；",
    "start": 99.275,
    "end": 102.361,
    "duration": 3.086
  },
  {
    "id": 28,
    "text": "接着以 “不忍登高临远，望故乡渺邈，",
    "start": 102.361,
    "end": 105.956,
    "duration": 3.595
  },
  {
    "id": 29,
    "text": "归思难收” 直抒身世之慨；后半阕笔锋陡转，虚设对方之景，",
    "start": 105.956,
    "end": 111.099,
    "duration": 5.143
  },
  {
    "id": 30,
    "text": "“想佳人，妆楼颙望，误几回、天际识归舟”，",
    "start": 111.099,
    "end": 114.264,
    "duration": 3.165
  },
  {
    "id": 31,
    "text": "通过主客双向铺叙将相思羁旅推向极境；在 《雨霖铃》 中，",
    "start": 114.264,
    "end": 119.183,
    "duration": 4.919
  },
  {
    "id": 32,
    "text": "由留恋执手到千种风情，全篇章法井然、顿挫有致。",
    "start": 119.183,
    "end": 123.614,
    "duration": 4.431
  },
  {
    "id": 33,
    "text": "第三，开拓羁旅行役与市民世俗题材，实现审美趣味的平民化转向。",
    "start": 123.614,
    "end": 129.689,
    "duration": 6.075
  },
  {
    "id": 34,
    "text": "柳永彻底打破了传统文人词局限于深闺怨妇与欢场作乐的陈旧主题，",
    "start": 129.689,
    "end": 135.739,
    "duration": 6.05
  },
  {
    "id": 35,
    "text": "第一次将落魄士人的 “羁旅行役之苦” 写入词中。",
    "start": 135.739,
    "end": 140.095,
    "duration": 4.356
  },
  {
    "id": 36,
    "text": "他将自身仕途受挫、浪迹江湖的真实漂泊体验倾注于词，",
    "start": 140.095,
    "end": 145.167,
    "duration": 5.072
  },
  {
    "id": 37,
    "text": "开创了词史上的羁旅新传统。",
    "start": 145.167,
    "end": 147.977,
    "duration": 2.81
  },
  {
    "id": 38,
    "text": "同时，柳永长期沉溺市井瓦舍，大量描写市井烟火、",
    "start": 147.977,
    "end": 152.714,
    "duration": 4.737
  },
  {
    "id": 39,
    "text": "市民男女婚恋与都市繁华，如 《望海潮》 中 “市列珠玑，",
    "start": 152.714,
    "end": 156.552,
    "duration": 3.838
  },
  {
    "id": 40,
    "text": "户盈罗绮，竞豪奢”，生动勾勒出北宋杭州的富庶气象，",
    "start": 156.552,
    "end": 162.804,
    "duration": 6.252
  },
  {
    "id": 41,
    "text": "实现了宋词由士大夫书斋向大众世俗生活的深层沉降。",
    "start": 162.804,
    "end": 167.684,
    "duration": 4.88
  },
  {
    "id": 42,
    "text": "第四，吸纳市井俚语与俗曲口语，",
    "start": 167.684,
    "end": 171.08,
    "duration": 3.396
  },
  {
    "id": 43,
    "text": "形成通俗明畅的全新词体语言风格。",
    "start": 171.08,
    "end": 174.734,
    "duration": 3.654
  },
  {
    "id": 44,
    "text": "在词的语言风格上，",
    "start": 174.734,
    "end": 176.286,
    "duration": 1.552
  },
  {
    "id": 45,
    "text": "柳永敢于突破传统文人雕琢藻饰的清雅格调，",
    "start": 176.286,
    "end": 180.099,
    "duration": 3.813
  },
  {
    "id": 46,
    "text": "大胆吸纳民间口语、俚俗方言与勾栏市井俗语。",
    "start": 180.099,
    "end": 184.425,
    "duration": 4.326
  },
  {
    "id": 47,
    "text": "他的语言自然浅近、明白如话，如 “系我一生心，",
    "start": 184.425,
    "end": 188.736,
    "duration": 4.311
  },
  {
    "id": 48,
    "text": "负你千行泪”、“衣带渐宽终不悔，为伊消得人憔悴”，",
    "start": 188.736,
    "end": 193.209,
    "duration": 4.473
  },
  {
    "id": 49,
    "text": "直白晓畅而回肠荡气。",
    "start": 193.209,
    "end": 195.357,
    "duration": 2.148
  },
  {
    "id": 50,
    "text": "苏轼对其诗化名句极度推崇，赞其 “霜风凄紧，关河冷落，",
    "start": 195.357,
    "end": 199.538,
    "duration": 4.181
  },
  {
    "id": 51,
    "text": "残照当楼” 具有不减唐人高境之风骨。",
    "start": 199.538,
    "end": 203.608,
    "duration": 4.07
  },
  {
    "id": 52,
    "text": "柳永的词体创造不仅直接启迪了苏轼、周邦彦等后代词学大家，",
    "start": 203.608,
    "end": 208.642,
    "duration": 5.034
  },
  {
    "id": 53,
    "text": "更为两宋慢词的极盛繁荣奠定了基石。",
    "start": 208.642,
    "end": 211.8,
    "duration": 3.158
  }
]