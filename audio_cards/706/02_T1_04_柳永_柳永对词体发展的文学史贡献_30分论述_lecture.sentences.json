[
  {
    "id": 1,
    "text": "试论柳永对词体发展的文学史贡献。",
    "start": 0.101,
    "end": 3.021,
    "duration": 2.92
  },
  {
    "id": 2,
    "text": "柳永是北宋第一位专力作词的专业词人。",
    "start": 3.46,
    "end": 6.712,
    "duration": 3.252
  },
  {
    "id": 3,
    "text": "面对五代至宋初词坛偏重小令、",
    "start": 7.159,
    "end": 9.879,
    "duration": 2.72
  },
  {
    "id": 4,
    "text": "题材局限于士大夫尊前欢宴的狭隘格局，",
    "start": 10.434,
    "end": 13.502,
    "duration": 3.068
  },
  {
    "id": 5,
    "text": "柳永顺应宋代都市繁华与市民音乐兴盛的潮流，",
    "start": 13.909,
    "end": 17.789,
    "duration": 3.88
  },
  {
    "id": 6,
    "text": "全方位革新词体，使宋词面貌为之一变。",
    "start": 17.955,
    "end": 21.568,
    "duration": 3.613
  },
  {
    "id": 7,
    "text": "叶梦得在《避暑录话》中记录其盛况曰：“凡有井水饮处，",
    "start": 21.877,
    "end": 26.603,
    "duration": 4.726
  },
  {
    "id": 8,
    "text": "即能歌柳词。",
    "start": 26.755,
    "end": 27.779,
    "duration": 1.024
  },
  {
    "id": 9,
    "text": "”其对词体发展的开拓性贡献，主要体现在以下四个方面：",
    "start": 27.924,
    "end": 31.918,
    "duration": 3.994
  },
  {
    "id": 10,
    "text": "第一，大力创作慢词长调，打破小令一统天下的狭小格局。",
    "start": 32.56,
    "end": 37.545,
    "duration": 4.985
  },
  {
    "id": 11,
    "text": "柳永以前，唐五代与宋初词坛均以数十余字的小令为主。",
    "start": 38.15,
    "end": 42.875,
    "duration": 4.725
  },
  {
    "id": 12,
    "text": "柳永充分吸纳坊曲新声，大力创作篇幅宏阔的慢词长调。",
    "start": 43.366,
    "end": 48.412,
    "duration": 5.046
  },
  {
    "id": 13,
    "text": "在现存宋词中，柳永一人就创作了慢词八十七调一百二十五首，",
    "start": 49.067,
    "end": 54.241,
    "duration": 5.174
  },
  {
    "id": 14,
    "text": "两宋所用词调中有一百多调为柳永首创或首次使用，令、引、",
    "start": 54.49,
    "end": 60.342,
    "duration": 5.852
  },
  {
    "id": 15,
    "text": "近、慢体制自此完备。",
    "start": 60.574,
    "end": 62.339,
    "duration": 1.765
  },
  {
    "id": 16,
    "text": "慢词长调的勃兴，从根本上改变了小令短小精约、",
    "start": 62.542,
    "end": 66.477,
    "duration": 3.935
  },
  {
    "id": 17,
    "text": "只宜截取片断的体制限制，使词得以容纳曲折叙事、",
    "start": 66.753,
    "end": 71.12,
    "duration": 4.367
  },
  {
    "id": 18,
    "text": "多层次抒情与细致铺排，为苏轼、辛弃疾、",
    "start": 71.355,
    "end": 74.79,
    "duration": 3.435
  },
  {
    "id": 19,
    "text": "周邦彦等后代词大家开辟了广阔的创作天地。",
    "start": 75.057,
    "end": 78.813,
    "duration": 3.756
  },
  {
    "id": 20,
    "text": "第二，革新词体表现手法，确立“铺叙展衍”与白描写景章法。",
    "start": 79.498,
    "end": 84.45,
    "duration": 4.952
  },
  {
    "id": 21,
    "text": "与小令注重意象跳跃、含蓄烘托不同，柳永将赋法移植入词，",
    "start": 84.988,
    "end": 89.986,
    "duration": 4.998
  },
  {
    "id": 22,
    "text": "开创了“铺叙展衍”与白描相配合的表现手法。",
    "start": 90.245,
    "end": 93.375,
    "duration": 3.13
  },
  {
    "id": 23,
    "text": "他善于利用时空转换，从现在回想过去、由己方设想对方，",
    "start": 93.94,
    "end": 98.659,
    "duration": 4.719
  },
  {
    "id": 24,
    "text": "铺陈心理波澜。",
    "start": 98.925,
    "end": 100.022,
    "duration": 1.097
  },
  {
    "id": 25,
    "text": "在《八声甘州》中，先以“对潇潇暮雨洒江天，",
    "start": 100.299,
    "end": 103.971,
    "duration": 3.672
  },
  {
    "id": 26,
    "text": "一番洗清秋”铺写秋江高远之景；继以“不忍登高临远，",
    "start": 104.313,
    "end": 109.138,
    "duration": 4.825
  },
  {
    "id": 27,
    "text": "望故乡渺邈，归思难收”直抒身世之慨；下片笔锋陡转，",
    "start": 109.323,
    "end": 114.369,
    "duration": 5.046
  },
  {
    "id": 28,
    "text": "虚设“想佳人、妆楼颙望，误几回、天际识归舟”，",
    "start": 114.565,
    "end": 119.102,
    "duration": 4.537
  },
  {
    "id": 29,
    "text": "主客双向铺叙，情深意长；《雨霖铃》则由都门帐饮、",
    "start": 119.338,
    "end": 124.288,
    "duration": 4.95
  },
  {
    "id": 30,
    "text": "执手泪眼写到酒醒杨柳岸，层层敷衍，章法绵密。",
    "start": 124.695,
    "end": 128.97,
    "duration": 4.275
  },
  {
    "id": 31,
    "text": "第三，开拓羁旅行役与市井世俗题材，拓展词体审美视野。",
    "start": 129.642,
    "end": 135.057,
    "duration": 5.415
  },
  {
    "id": 32,
    "text": "柳永打破了传统文人词局限于闺怨相思与尊前恋情的旧套，",
    "start": 135.579,
    "end": 140.609,
    "duration": 5.03
  },
  {
    "id": 33,
    "text": "将自身仕途落魄、浪迹江湖的切身感受写入词中，",
    "start": 141.095,
    "end": 145.234,
    "duration": 4.139
  },
  {
    "id": 34,
    "text": "开创了“羁旅行役”的自我化抒情新路。",
    "start": 145.634,
    "end": 148.346,
    "duration": 2.712
  },
  {
    "id": 35,
    "text": "同时，柳永贴近茶坊酒肆与市井大众，",
    "start": 148.835,
    "end": 152.008,
    "duration": 3.173
  },
  {
    "id": 36,
    "text": "既同情下层歌妓与平民女性的悲欢，",
    "start": 152.288,
    "end": 155.328,
    "duration": 3.04
  },
  {
    "id": 37,
    "text": "也着力描绘北宋都市的繁华气象，如《望海潮》中“市列珠玑，",
    "start": 155.802,
    "end": 161.538,
    "duration": 5.736
  },
  {
    "id": 38,
    "text": "户盈罗绮，竞豪奢”，生动勾勒出钱塘都会的富庶风情，",
    "start": 161.749,
    "end": 166.742,
    "duration": 4.993
  },
  {
    "id": 39,
    "text": "推动宋词从士大夫清雅书斋走向广阔的世俗生活。",
    "start": 167.058,
    "end": 171.71,
    "duration": 4.652
  },
  {
    "id": 40,
    "text": "第四，吸纳市井俚俗口语入词，形成通俗明畅的全新语言风貌。",
    "start": 172.345,
    "end": 178.089,
    "duration": 5.744
  },
  {
    "id": 41,
    "text": "在词的语言风格上，",
    "start": 178.4,
    "end": 179.668,
    "duration": 1.268
  },
  {
    "id": 42,
    "text": "柳永突破了晚唐五代文人词一味求雅的雕琢积习，",
    "start": 179.838,
    "end": 184.09,
    "duration": 4.252
  },
  {
    "id": 43,
    "text": "大胆吸纳日常口语、方言俚语与市民俗语入词。",
    "start": 184.376,
    "end": 188.484,
    "duration": 4.108
  },
  {
    "id": 44,
    "text": "他的词句自然浅近、宛如面对面诉说，",
    "start": 188.874,
    "end": 191.863,
    "duration": 2.989
  },
  {
    "id": 45,
    "text": "如《忆帝京》“系我一生心，负你千行泪”，",
    "start": 192.113,
    "end": 195.585,
    "duration": 3.472
  },
  {
    "id": 46,
    "text": "《蝶恋花》“衣带渐宽终不悔，为伊消得人憔悴”，",
    "start": 195.839,
    "end": 199.79,
    "duration": 3.951
  },
  {
    "id": 47,
    "text": "直白晓畅而动人心弦。",
    "start": 200.038,
    "end": 201.902,
    "duration": 1.864
  },
  {
    "id": 48,
    "text": "同时，他也能写出“渐霜风凄紧，关河冷落，",
    "start": 202.123,
    "end": 205.874,
    "duration": 3.751
  },
  {
    "id": 49,
    "text": "残照当楼”这样清健苍凉的写景佳句。",
    "start": 206.053,
    "end": 209.168,
    "duration": 3.115
  },
  {
    "id": 50,
    "text": "柳永的全面革新，直接启迪了苏轼与周邦彦的创作，",
    "start": 209.447,
    "end": 213.205,
    "duration": 3.758
  },
  {
    "id": 51,
    "text": "为两宋词坛的繁荣兴盛奠定了坚实基础。",
    "start": 213.441,
    "end": 216.767,
    "duration": 3.326
  }
]