[
  {
    "id": 1,
    "text": "全局宏观破题与立论逻辑。",
    "start": 0.16,
    "end": 3.12,
    "duration": 2.96
  },
  {
    "id": 2,
    "text": "在考场下笔之前，必须先在宏观上审清这道三十分大题的核心考核意图。",
    "start": 3.12,
    "end": 9.12,
    "duration": 6.0
  },
  {
    "id": 3,
    "text": "本题表面上考查屈原《离骚》的思想与艺术，",
    "start": 9.12,
    "end": 12.64,
    "duration": 3.52
  },
  {
    "id": 4,
    "text": "本质上考查中国文学个人化抒情巨著的开创机制。",
    "start": 12.64,
    "end": 16.72,
    "duration": 4.08
  },
  {
    "id": 5,
    "text": "考场评分标准绝不满足于仅孤立背诵几句爱国名句。",
    "start": 16.72,
    "end": 20.56,
    "duration": 3.84
  },
  {
    "id": 6,
    "text": "答题方向必须确立为“从美政政治理想与崇高人格，",
    "start": 20.8,
    "end": 25.28,
    "duration": 4.48
  },
  {
    "id": 7,
    "text": "推进到香草美人的比兴象征体系，再展开到虚实神游的宏伟构架，",
    "start": 25.28,
    "end": 30.72,
    "duration": 5.44
  },
  {
    "id": 8,
    "text": "最终落地至骚体句式与文学史定位”的因果推进。",
    "start": 30.72,
    "end": 34.72,
    "duration": 4.0
  },
  {
    "id": 9,
    "text": "整道大题在宏观上划分为五个有机递进的逻辑层次：第一层，",
    "start": 34.72,
    "end": 39.36,
    "duration": 4.64
  },
  {
    "id": 10,
    "text": "开篇破题，借司马迁“与日月争光”定评与袁行配教材，",
    "start": 39.36,
    "end": 44.08,
    "duration": 4.72
  },
  {
    "id": 11,
    "text": "确立其作为浪漫主义抒情诗开山的坐标。",
    "start": 44.08,
    "end": 46.96,
    "duration": 2.88
  },
  {
    "id": 12,
    "text": "第二层，论述思想内核，剖析美政理想、",
    "start": 47.28,
    "end": 50.72,
    "duration": 3.44
  },
  {
    "id": 13,
    "text": "哀民多艰与九死不悔的献身精神。",
    "start": 50.72,
    "end": 53.84,
    "duration": 3.12
  },
  {
    "id": 14,
    "text": "第三层，论述艺术手法，深度剖析香草美人如何将自然草木升华为立体人格寄托。",
    "start": 53.84,
    "end": 61.36,
    "duration": 7.52
  },
  {
    "id": 15,
    "text": "第四层，论述篇章结构，阐释现实受挫与天界神游的虚实交织，",
    "start": 61.36,
    "end": 67.12,
    "duration": 5.76
  },
  {
    "id": 16,
    "text": "以及临睨旧乡的情感跌回。",
    "start": 67.12,
    "end": 69.12,
    "duration": 2.0
  },
  {
    "id": 17,
    "text": "第五层，落地至文体语言，阐释骚体句式与“兮”字声律如何支撑长篇宏制。",
    "start": 69.44,
    "end": 76.32,
    "duration": 6.88
  },
  {
    "id": 18,
    "text": "尾部收官，以“风骚”并称定性，交代其对汉赋、",
    "start": 76.32,
    "end": 80.56,
    "duration": 4.24
  },
  {
    "id": 19,
    "text": "李白及后世爱国文学传统的血脉滋养。",
    "start": 80.56,
    "end": 84.24,
    "duration": 3.68
  },
  {
    "id": 20,
    "text": "这五个层次构成一条不可逆的因果链条：美政是理想，",
    "start": 84.24,
    "end": 88.96,
    "duration": 4.72
  },
  {
    "id": 21,
    "text": "香草是象征，神游是翅膀，骚体是载体，",
    "start": 88.96,
    "end": 92.72,
    "duration": 3.76
  },
  {
    "id": 22,
    "text": "风骚并称是历史定型。",
    "start": 92.72,
    "end": 94.8,
    "duration": 2.08
  },
  {
    "id": 23,
    "text": "理顺了宏观全局思路，接下来进入每一段的具体推导与逐句表述。",
    "start": 95.2,
    "end": 100.56,
    "duration": 5.36
  },
  {
    "id": 24,
    "text": "--。第",
    "start": 100.56,
    "end": 100.64,
    "duration": 0.08
  },
  {
    "id": 25,
    "text": "一段：首段破题与概念定性。",
    "start": 100.64,
    "end": 103.52,
    "duration": 2.88
  },
  {
    "id": 26,
    "text": "逐句因果推导与答题表述。",
    "start": 103.52,
    "end": 106.08,
    "duration": 2.56
  },
  {
    "id": 27,
    "text": "首句必须直击核心地位，确立其在诗歌史上的长篇抒情诗开山坐标。",
    "start": 106.08,
    "end": 112.32,
    "duration": 6.24
  },
  {
    "id": 28,
    "text": "所以表述为：《离骚》是中国古代文学史上篇幅最宏大、",
    "start": 112.32,
    "end": 117.04,
    "duration": 4.72
  },
  {
    "id": 29,
    "text": "抒情最深沉的浪漫主义政治抒情长诗。",
    "start": 117.04,
    "end": 120.0,
    "duration": 2.96
  },
  {
    "id": 30,
    "text": "次句必须引入司马迁在《史记》中的至高定评，",
    "start": 120.32,
    "end": 124.0,
    "duration": 3.68
  },
  {
    "id": 31,
    "text": "为整篇答卷奠定崇高基调。",
    "start": 124.0,
    "end": 126.8,
    "duration": 2.8
  },
  {
    "id": 32,
    "text": "所以表述为：司马迁在《史记•屈原贾生列传》中推崇备至：“推此志也，",
    "start": 126.8,
    "end": 133.12,
    "duration": 6.32
  },
  {
    "id": 33,
    "text": "虽与日月争光可也”。",
    "start": 133.12,
    "end": 134.8,
    "duration": 1.68
  },
  {
    "id": 34,
    "text": "第三句引入考研权威教材的学术界定，",
    "start": 134.8,
    "end": 137.84,
    "duration": 3.04
  },
  {
    "id": 35,
    "text": "指出其打破先秦短篇集体抒情的体制突破。",
    "start": 137.84,
    "end": 141.04,
    "duration": 3.2
  },
  {
    "id": 36,
    "text": "所以表述为：袁行配《中国文学史》指出，",
    "start": 141.36,
    "end": 144.4,
    "duration": 3.04
  },
  {
    "id": 37,
    "text": "《离骚》打破了先秦诗歌集体歌唱与篇幅简短的格局。",
    "start": 144.4,
    "end": 148.4,
    "duration": 4.0
  },
  {
    "id": 38,
    "text": "第四句进一步指出其美学突破，首次确立了个性鲜明的抒情主人公形象。",
    "start": 148.784,
    "end": 155.264,
    "duration": 6.48
  },
  {
    "id": 39,
    "text": "所以表述为：它首次树立起一个崇高峻洁、",
    "start": 155.264,
    "end": 158.957,
    "duration": 3.693
  },
  {
    "id": 40,
    "text": "坚守真理的伟大抒情主人公形象。",
    "start": 158.957,
    "end": 161.908,
    "duration": 2.951
  },
  {
    "id": 41,
    "text": "第五句作为首段过渡句，宣告下文将从四个核心维度展开系统论证。",
    "start": 161.908,
    "end": 167.81,
    "duration": 5.902
  },
  {
    "id": 42,
    "text": "所以表述为：其博大深邃的思想意蕴与杰出的艺术成就，",
    "start": 167.81,
    "end": 172.224,
    "duration": 4.414
  },
  {
    "id": 43,
    "text": "主要展现为以下四个核心维度：本段答题思路总结。",
    "start": 172.224,
    "end": 176.304,
    "duration": 4.08
  },
  {
    "id": 44,
    "text": "本段用五句话完成立论闭环：先直接给出中国第一长篇政治抒情诗的定性；",
    "start": 176.304,
    "end": 181.824,
    "duration": 5.52
  },
  {
    "id": 45,
    "text": "随即引用司马迁“虽与日月争光可也”的千古赞誉；",
    "start": 181.824,
    "end": 185.504,
    "duration": 3.68
  },
  {
    "id": 46,
    "text": "接着结合袁行配教材点明其打破短篇集体歌唱、",
    "start": 185.824,
    "end": 190.224,
    "duration": 4.4
  },
  {
    "id": 47,
    "text": "创立个体抒情形象的划时代意义；",
    "start": 190.224,
    "end": 193.184,
    "duration": 2.96
  },
  {
    "id": 48,
    "text": "最后引出四个分论点，气象雄浑严谨。",
    "start": 193.184,
    "end": 196.944,
    "duration": 3.76
  },
  {
    "id": 49,
    "text": "所以本段具体答题完整版为：《离骚》是中国古代文学史上篇幅最宏大、",
    "start": 196.944,
    "end": 203.024,
    "duration": 6.08
  },
  {
    "id": 50,
    "text": "抒情最深沉的浪漫主义政治抒情长诗。",
    "start": 203.024,
    "end": 206.224,
    "duration": 3.2
  },
  {
    "id": 51,
    "text": "司马迁在《史记•屈原贾生列传》中推崇备至：“推此志也，",
    "start": 206.624,
    "end": 211.664,
    "duration": 5.04
  },
  {
    "id": 52,
    "text": "虽与日月争光可也”。",
    "start": 211.664,
    "end": 213.504,
    "duration": 1.84
  },
  {
    "id": 53,
    "text": "袁行配《中国文学史》指出，《离骚》打破了先秦诗歌集体歌唱与篇幅简短的格局。",
    "start": 213.504,
    "end": 220.224,
    "duration": 6.72
  },
  {
    "id": 54,
    "text": "它首次树立起一个崇高峻洁、坚守真理的伟大抒情主人公形象。",
    "start": 220.224,
    "end": 225.584,
    "duration": 5.36
  },
  {
    "id": 55,
    "text": "其博大深邃的思想意蕴与杰出的艺术成就，",
    "start": 225.984,
    "end": 229.744,
    "duration": 3.76
  },
  {
    "id": 56,
    "text": "主要展现为以下四个核心维度：。",
    "start": 229.744,
    "end": 232.624,
    "duration": 2.88
  },
  {
    "id": 57,
    "text": "第二段：第一分论点，思想内核的美政理想（志之“坚”）。",
    "start": 232.624,
    "end": 237.184,
    "duration": 4.56
  },
  {
    "id": 58,
    "text": "逐句因果推导与答题表述。",
    "start": 237.184,
    "end": 239.584,
    "duration": 2.4
  },
  {
    "id": 59,
    "text": "论述离骚，首先必须从屈原终身坚守的政治理想切入，",
    "start": 239.584,
    "end": 243.984,
    "duration": 4.4
  },
  {
    "id": 60,
    "text": "这是整首长诗的灵魂。",
    "start": 243.984,
    "end": 245.584,
    "duration": 1.6
  },
  {
    "id": 61,
    "text": "首句确立分论点，指出思想内核是屈原贯穿一生的“美政”理想。",
    "start": 245.824,
    "end": 251.213,
    "duration": 5.389
  },
  {
    "id": 62,
    "text": "所以表述为：《离骚》的思想灵魂是屈原贯穿一生的“美政”政治理想。",
    "start": 251.213,
    "end": 257.123,
    "duration": 5.91
  },
  {
    "id": 63,
    "text": "次句严格界定美政的具体内涵，说明修明法度、",
    "start": 257.123,
    "end": 261.442,
    "duration": 4.319
  },
  {
    "id": 64,
    "text": "选贤任能与心系百姓。",
    "start": 261.442,
    "end": 263.487,
    "duration": 2.045
  },
  {
    "id": 65,
    "text": "所以表述为：所谓美政，即主张圣君贤相、",
    "start": 263.487,
    "end": 267.584,
    "duration": 4.097
  },
  {
    "id": 66,
    "text": "修明法度、任人唯贤并以黎民苍生为念。",
    "start": 267.584,
    "end": 271.424,
    "duration": 3.84
  },
  {
    "id": 67,
    "text": "第三句面对楚国现实危局，调取最能展现其忧民情怀的千古名句。",
    "start": 271.424,
    "end": 277.424,
    "duration": 6.0
  },
  {
    "id": 68,
    "text": "所以表述为：面对楚国贵族集团结党营私与宗国危殆，",
    "start": 277.424,
    "end": 282.464,
    "duration": 5.04
  },
  {
    "id": 69,
    "text": "诗人满怀深情写道：“长太息以掩涕兮，",
    "start": 282.464,
    "end": 286.464,
    "duration": 4.0
  },
  {
    "id": 70,
    "text": "哀民生之多艰”。",
    "start": 286.464,
    "end": 287.824,
    "duration": 1.36
  },
  {
    "id": 71,
    "text": "第四句推导因果，即便身遭流放缠害，",
    "start": 288.144,
    "end": 291.824,
    "duration": 3.68
  },
  {
    "id": 72,
    "text": "其对祖国宗庙的依恋依然深沉不改。",
    "start": 291.824,
    "end": 295.104,
    "duration": 3.28
  },
  {
    "id": 73,
    "text": "所以表述为：即便自身惨遭缠产放逐，",
    "start": 295.104,
    "end": 298.68,
    "duration": 3.576
  },
  {
    "id": 74,
    "text": "他依然对楚国命运怀抱刻骨铭心的忧患与深情。",
    "start": 298.68,
    "end": 302.92,
    "duration": 4.24
  },
  {
    "id": 75,
    "text": "第五句调取全诗最具震撼力的誓死明志之句，",
    "start": 302.92,
    "end": 307.24,
    "duration": 4.32
  },
  {
    "id": 76,
    "text": "展现九死不悔的骨气。",
    "start": 307.24,
    "end": 309.24,
    "duration": 2.0
  },
  {
    "id": 77,
    "text": "所以表述为：面对权贵的围攻与威逼，",
    "start": 309.24,
    "end": 312.68,
    "duration": 3.44
  },
  {
    "id": 78,
    "text": "诗人以九死不悔的决绝誓死捍卫人格：“亦余心之所善兮，",
    "start": 312.68,
    "end": 317.72,
    "duration": 5.04
  },
  {
    "id": 79,
    "text": "虽九死其犹未悔”。",
    "start": 317.72,
    "end": 319.64,
    "duration": 1.92
  },
  {
    "id": 80,
    "text": "第六句收束全段，指出这种生死相依的爱国忠贞铸就了士大夫的精神脊梁。",
    "start": 319.96,
    "end": 326.2,
    "duration": 6.24
  },
  {
    "id": 81,
    "text": "所以表述为：这种将个体生命与祖国存亡生死相连的爱国忠贞，",
    "start": 326.2,
    "end": 331.24,
    "duration": 5.04
  },
  {
    "id": 82,
    "text": "铸就了中华民族士人的精神脊梁。",
    "start": 331.24,
    "end": 333.88,
    "duration": 2.64
  },
  {
    "id": 83,
    "text": "本段答题思路总结。",
    "start": 333.88,
    "end": 335.48,
    "duration": 1.6
  },
  {
    "id": 84,
    "text": "本段是思想意蕴的核心基石：先明确阐释“美政”所涵盖的贤能政治与民本思想；",
    "start": 335.48,
    "end": 341.88,
    "duration": 6.4
  },
  {
    "id": 85,
    "text": "随后紧扣“哀民生之多艰”的悲敏情怀与“虽九死其犹未悔”的坚贞誓言；",
    "start": 342.28,
    "end": 348.84,
    "duration": 6.56
  },
  {
    "id": 86,
    "text": "透彻论证了屈原绝非普通怨妇怨臣，",
    "start": 348.84,
    "end": 352.28,
    "duration": 3.44
  },
  {
    "id": 87,
    "text": "而是将自身命运与国家存亡紧密熔铸的伟大爱国思想家。",
    "start": 352.28,
    "end": 357.32,
    "duration": 5.04
  },
  {
    "id": 88,
    "text": "所以本段具体答题完整版为：一、思想内核的美政理想：矢志不渝的忠贞爱国与献身情操。",
    "start": 357.32,
    "end": 365.16,
    "duration": 7.84
  },
  {
    "id": 89,
    "text": "《离骚》的思想灵魂是屈原贯穿一生的“美政”政治理想。",
    "start": 365.4,
    "end": 370.928,
    "duration": 5.528
  },
  {
    "id": 90,
    "text": "所谓美政，即主张圣君贤相、修明法度、",
    "start": 370.928,
    "end": 374.877,
    "duration": 3.949
  },
  {
    "id": 91,
    "text": "任人唯贤并以黎民苍生为念。",
    "start": 374.877,
    "end": 378.036,
    "duration": 3.159
  },
  {
    "id": 92,
    "text": "面对楚国贵族集团结党营私与宗国危殆，",
    "start": 378.036,
    "end": 382.512,
    "duration": 4.476
  },
  {
    "id": 93,
    "text": "诗人满怀深情写道：“长太息以掩涕兮，",
    "start": 382.512,
    "end": 386.46,
    "duration": 3.948
  },
  {
    "id": 94,
    "text": "哀民生之多艰”。",
    "start": 386.46,
    "end": 388.04,
    "duration": 1.58
  },
  {
    "id": 95,
    "text": "即便自身惨遭缠产放逐，他依然对楚国命运怀抱刻骨铭心的忧患与深情。",
    "start": 388.12,
    "end": 395.08,
    "duration": 6.96
  },
  {
    "id": 96,
    "text": "面对权贵的围攻与威逼，诗人以九死不悔的决绝誓死捍卫人格：“亦余心之所善兮，",
    "start": 395.08,
    "end": 402.36,
    "duration": 7.28
  },
  {
    "id": 97,
    "text": "虽九死其犹未悔”。",
    "start": 402.36,
    "end": 404.36,
    "duration": 2.0
  },
  {
    "id": 98,
    "text": "这种将个体生命与祖国存亡生死相连的爱国忠贞，",
    "start": 404.36,
    "end": 408.68,
    "duration": 4.32
  },
  {
    "id": 99,
    "text": "铸就了中华民族士人的精神脊梁。",
    "start": 408.68,
    "end": 411.24,
    "duration": 2.56
  },
  {
    "id": 100,
    "text": "第三段：第二分论点，比兴寄托的意象体系（象之“美”）。",
    "start": 411.48,
    "end": 415.96,
    "duration": 4.48
  },
  {
    "id": 101,
    "text": "逐句因果推导与答题表述。",
    "start": 415.96,
    "end": 418.36,
    "duration": 2.4
  },
  {
    "id": 102,
    "text": "第二段讲清了政治抱负，第三段必须正面攻克屈原最具创造性的表现手法，",
    "start": 418.36,
    "end": 424.28,
    "duration": 5.92
  },
  {
    "id": 103,
    "text": "香草美人。",
    "start": 424.28,
    "end": 425.4,
    "duration": 1.12
  },
  {
    "id": 104,
    "text": "首句立论，指出屈原拓展了诗经比兴，",
    "start": 425.4,
    "end": 428.76,
    "duration": 3.36
  },
  {
    "id": 105,
    "text": "开创了系统的香草美人象征体系。",
    "start": 428.76,
    "end": 431.32,
    "duration": 2.56
  },
  {
    "id": 106,
    "text": "所以表述为：屈原极大拓展了《诗经》的比兴手法，",
    "start": 431.64,
    "end": 435.832,
    "duration": 4.192
  },
  {
    "id": 107,
    "text": "开创了完备的“香草美人”象征体系。",
    "start": 435.832,
    "end": 438.968,
    "duration": 3.136
  },
  {
    "id": 108,
    "text": "次句阐明其艺术提升，说明他将无生命的自然草木赋予了崇高的政治道德意涵。",
    "start": 438.968,
    "end": 446.36,
    "duration": 7.392
  },
  {
    "id": 109,
    "text": "所以表述为：他将原本无生命的自然草木与世俗男女，",
    "start": 446.36,
    "end": 451.448,
    "duration": 5.088
  },
  {
    "id": 110,
    "text": "赋予了极其崇高的政治道德内涵。",
    "start": 451.448,
    "end": 454.088,
    "duration": 2.64
  },
  {
    "id": 111,
    "text": "第三句分析香草正面的象征功能，代表洁白德行与政治才华。",
    "start": 454.088,
    "end": 458.888,
    "duration": 4.8
  },
  {
    "id": 112,
    "text": "所以表述为：全诗以辟芷、秋兰、木兰、",
    "start": 458.888,
    "end": 463.128,
    "duration": 4.24
  },
  {
    "id": 113,
    "text": "秋菊等嘉草繁花，象征自身纯洁高尚的情操与治国才具。",
    "start": 463.128,
    "end": 468.728,
    "duration": 5.6
  },
  {
    "id": 114,
    "text": "第四句引用名句，展现晨饮坠露、夕餐落英的拔俗形象。",
    "start": 468.968,
    "end": 474.168,
    "duration": 5.2
  },
  {
    "id": 115,
    "text": "所以表述为：诗中名句写道：“朝饮木兰之坠露兮，",
    "start": 474.168,
    "end": 478.328,
    "duration": 4.16
  },
  {
    "id": 116,
    "text": "夕餐秋菊之落英”，生动呈现其峻洁拔俗的生命追求。",
    "start": 478.328,
    "end": 482.968,
    "duration": 4.64
  },
  {
    "id": 117,
    "text": "第五句对比反面意象，以恶草秽木象征奸邪小人与黑暗现实。",
    "start": 482.968,
    "end": 488.168,
    "duration": 5.2
  },
  {
    "id": 118,
    "text": "所以表述为：与此同时，诗人以艾草、",
    "start": 488.488,
    "end": 491.928,
    "duration": 3.44
  },
  {
    "id": 119,
    "text": "萧艾等恶草恶木，象征朝堂上贪婪短视的缠产宵小。",
    "start": 491.928,
    "end": 497.368,
    "duration": 5.44
  },
  {
    "id": 120,
    "text": "第六句揭示“美人”的核心寄托，代表贤明君主与志同道合的美政知音。",
    "start": 497.368,
    "end": 504.248,
    "duration": 6.88
  },
  {
    "id": 121,
    "text": "所以表述为：以“美人”寄托心驰神往的明君与求索未得的美政知己，",
    "start": 504.248,
    "end": 510.808,
    "duration": 6.56
  },
  {
    "id": 122,
    "text": "使政治抒情变得委婉缠绵。",
    "start": 510.808,
    "end": 513.288,
    "duration": 2.48
  },
  {
    "id": 123,
    "text": "第七句总结收束，指出这一体系使诗歌意象完成了向崇高人格象征的伟大飞跃。",
    "start": 513.608,
    "end": 520.464,
    "duration": 6.856
  },
  {
    "id": 124,
    "text": "所以表述为：这一体系使古典诗歌意象完成了由感官物象向崇高人格象征的伟大飞跃。",
    "start": 520.464,
    "end": 527.747,
    "duration": 7.283
  },
  {
    "id": 125,
    "text": "本段答题思路总结。",
    "start": 527.747,
    "end": 529.365,
    "duration": 1.618
  },
  {
    "id": 126,
    "text": "本段聚焦于最具标志性的艺术表现技巧：由诗经比兴自然推进至屈原的香草美人体系；",
    "start": 529.365,
    "end": 536.648,
    "duration": 7.283
  },
  {
    "id": 127,
    "text": "条分缕析嘉花芳草象征美好德操、萧艾恶木象征缠产群小、",
    "start": 536.728,
    "end": 543.288,
    "duration": 6.56
  },
  {
    "id": 128,
    "text": "求索美人象征追寻明君知音的三重机制；",
    "start": 543.288,
    "end": 547.048,
    "duration": 3.76
  },
  {
    "id": 129,
    "text": "结合“朝饮木兰、夕餐秋菊”的千古名句，",
    "start": 547.048,
    "end": 550.568,
    "duration": 3.52
  },
  {
    "id": 130,
    "text": "论证了物象与人道精神的完全同构。",
    "start": 550.568,
    "end": 553.848,
    "duration": 3.28
  },
  {
    "id": 131,
    "text": "所以本段具体答题完整版为：二、比兴寄托的意象体系：芳草美人的道德象征与人格化演进。",
    "start": 553.848,
    "end": 561.608,
    "duration": 7.76
  },
  {
    "id": 132,
    "text": "屈原极大拓展了《诗经》的比兴手法，",
    "start": 561.928,
    "end": 564.568,
    "duration": 2.64
  },
  {
    "id": 133,
    "text": "开创了完备的“香草美人”象征体系。",
    "start": 564.568,
    "end": 567.448,
    "duration": 2.88
  },
  {
    "id": 134,
    "text": "他将原本无生命的自然草木与世俗男女，",
    "start": 567.448,
    "end": 571.048,
    "duration": 3.6
  },
  {
    "id": 135,
    "text": "赋予了极其崇高的政治道德内涵。",
    "start": 571.048,
    "end": 573.688,
    "duration": 2.64
  },
  {
    "id": 136,
    "text": "全诗以辟芷、秋兰、木兰、秋菊等嘉草繁花，",
    "start": 573.688,
    "end": 578.248,
    "duration": 4.56
  },
  {
    "id": 137,
    "text": "象征自身纯洁高尚的情操与治国才具。",
    "start": 578.248,
    "end": 581.528,
    "duration": 3.28
  },
  {
    "id": 138,
    "text": "诗中名句写道：“朝饮木兰之坠露兮，",
    "start": 581.848,
    "end": 585.208,
    "duration": 3.36
  },
  {
    "id": 139,
    "text": "夕餐秋菊之落英”，生动呈现其峻洁拔俗的生命追求。",
    "start": 585.208,
    "end": 590.088,
    "duration": 4.88
  },
  {
    "id": 140,
    "text": "与此同时，诗人以艾草、萧艾等恶草恶木，",
    "start": 590.088,
    "end": 594.088,
    "duration": 4.0
  },
  {
    "id": 141,
    "text": "象征朝堂上贪婪短视的缠产宵小。",
    "start": 594.088,
    "end": 597.448,
    "duration": 3.36
  },
  {
    "id": 142,
    "text": "以“美人”寄托心驰神往的明君与求索未得的美政知己，",
    "start": 597.448,
    "end": 602.168,
    "duration": 4.72
  },
  {
    "id": 143,
    "text": "使政治抒情变得委婉缠绵。",
    "start": 602.168,
    "end": 604.328,
    "duration": 2.16
  },
  {
    "id": 144,
    "text": "这一体系使古典诗歌意象完成了由感官物象向崇高人格象征的伟大飞跃。",
    "start": 604.696,
    "end": 611.096,
    "duration": 6.4
  },
  {
    "id": 145,
    "text": "第四段：第三分论点，虚实相生的宏伟构架（构之“奇”）。",
    "start": 611.096,
    "end": 615.496,
    "duration": 4.4
  },
  {
    "id": 146,
    "text": "逐句因果推导与答题表述。",
    "start": 615.496,
    "end": 617.896,
    "duration": 2.4
  },
  {
    "id": 147,
    "text": "前两段解决了意与象，第四段必须剖析《离骚》波澜壮阔的宏大篇章结构。",
    "start": 617.896,
    "end": 623.496,
    "duration": 5.6
  },
  {
    "id": 148,
    "text": "首句确立分论点，指出长诗在构架上展现出飞腾壮丽的想象力，",
    "start": 623.816,
    "end": 629.321,
    "duration": 5.505
  },
  {
    "id": 149,
    "text": "构筑了虚实相生的宏大波澜。",
    "start": 629.321,
    "end": 631.938,
    "duration": 2.617
  },
  {
    "id": 150,
    "text": "所以表述为：《离骚》在篇章构架上展现出飞腾壮丽的想象力，",
    "start": 631.938,
    "end": 637.172,
    "duration": 5.234
  },
  {
    "id": 151,
    "text": "构筑了虚实交织的宏大波澜。",
    "start": 637.172,
    "end": 639.789,
    "duration": 2.617
  },
  {
    "id": 152,
    "text": "次句概括长诗前半部分的写实基础，",
    "start": 639.789,
    "end": 643.061,
    "duration": 3.272
  },
  {
    "id": 153,
    "text": "沉痛叙写自身出身与政治受难。",
    "start": 643.061,
    "end": 645.896,
    "duration": 2.835
  },
  {
    "id": 154,
    "text": "所以表述为：前半部分立足于现实世界，",
    "start": 646.056,
    "end": 649.3,
    "duration": 3.244
  },
  {
    "id": 155,
    "text": "沉痛自述高贵出身、修身自励与遭缠见弃的政治悲剧。",
    "start": 649.3,
    "end": 653.823,
    "duration": 4.523
  },
  {
    "id": 156,
    "text": "第三句指出后半部分的飞腾转折，借助神话展开宇宙天界的自由神游。",
    "start": 653.823,
    "end": 659.786,
    "duration": 5.963
  },
  {
    "id": 157,
    "text": "所以表述为：后半部分笔锋骤然飞升，",
    "start": 659.786,
    "end": 662.87,
    "duration": 3.084
  },
  {
    "id": 158,
    "text": "借助于神话传说展开天界与宇宙的自由驰骋。",
    "start": 662.87,
    "end": 666.776,
    "duration": 3.906
  },
  {
    "id": 159,
    "text": "第四句铺叙神游过程中的神灵役使，",
    "start": 666.856,
    "end": 669.896,
    "duration": 3.04
  },
  {
    "id": 160,
    "text": "羲和弭节、驾龙鸾周流上下。",
    "start": 669.896,
    "end": 672.936,
    "duration": 3.04
  },
  {
    "id": 161,
    "text": "所以表述为：诗人命羲和弭节、叫望舒先驱、",
    "start": 672.936,
    "end": 676.936,
    "duration": 4.0
  },
  {
    "id": 162,
    "text": "驾飞龙鸾凤周流上下，叩九重天门以求通达。",
    "start": 676.936,
    "end": 681.256,
    "duration": 4.32
  },
  {
    "id": 163,
    "text": "第五句叙述求女受挫后从灵氛、巫咸之言，",
    "start": 681.256,
    "end": 685.256,
    "duration": 4.0
  },
  {
    "id": 164,
    "text": "在广袤太虚寻求精神出路。",
    "start": 685.256,
    "end": 687.496,
    "duration": 2.24
  },
  {
    "id": 165,
    "text": "所以表述为：求女不遂后，诗人从灵氛之卜与巫咸之言，",
    "start": 687.816,
    "end": 692.579,
    "duration": 4.763
  },
  {
    "id": 166,
    "text": "在广袤宇宙间寻找精神出路。",
    "start": 692.579,
    "end": 695.21,
    "duration": 2.631
  },
  {
    "id": 167,
    "text": "第六句迎来全诗最具悲剧震撼力的骤然折回，",
    "start": 695.21,
    "end": 699.374,
    "duration": 4.164
  },
  {
    "id": 168,
    "text": "猛然回首遥望故土。",
    "start": 699.374,
    "end": 701.128,
    "duration": 1.754
  },
  {
    "id": 169,
    "text": "所以表述为：然而正当飞升至云霓之上时，",
    "start": 701.128,
    "end": 704.854,
    "duration": 3.726
  },
  {
    "id": 170,
    "text": "诗人猛然俯瞰故土宗国：“制升皇之赫戏兮，",
    "start": 704.854,
    "end": 708.581,
    "duration": 3.727
  },
  {
    "id": 171,
    "text": "忽临睨夫旧乡”。",
    "start": 708.581,
    "end": 709.896,
    "duration": 1.315
  },
  {
    "id": 172,
    "text": "第七句剖析仆夫悲叹、马匹怀恋不肯前行的传神细节。",
    "start": 709.976,
    "end": 715.496,
    "duration": 5.52
  },
  {
    "id": 173,
    "text": "所以表述为：驾车仆夫与所乘飞马皆悲鸣蜷局而不能前行，",
    "start": 715.496,
    "end": 721.256,
    "duration": 5.76
  },
  {
    "id": 174,
    "text": "最终从神幻九天剧烈跌回现实悲剧。",
    "start": 721.256,
    "end": 724.776,
    "duration": 3.52
  },
  {
    "id": 175,
    "text": "第八句总结全段，指出这种现实与幻想的剧烈碰撞爆发出了撼人的悲壮力量。",
    "start": 724.776,
    "end": 731.016,
    "duration": 6.24
  },
  {
    "id": 176,
    "text": "所以表述为：这种现实与神游的剧烈对撞，",
    "start": 731.336,
    "end": 734.616,
    "duration": 3.28
  },
  {
    "id": 177,
    "text": "使全诗爆发出了震撼人心的悲壮力量。",
    "start": 734.616,
    "end": 737.976,
    "duration": 3.36
  },
  {
    "id": 178,
    "text": "本段答题思路总结。",
    "start": 737.976,
    "end": 739.496,
    "duration": 1.52
  },
  {
    "id": 179,
    "text": "本段是对宏伟浪漫主义篇章构架的精妙剖析：清晰厘清前半篇“现实政治受创”与后半篇“九天神游求索”的虚实双层波澜；",
    "start": 739.784,
    "end": 750.264,
    "duration": 10.48
  },
  {
    "id": 180,
    "text": "重点剖析“临睨旧乡、马怀蜷局”的神转折，",
    "start": 750.264,
    "end": 754.344,
    "duration": 4.08
  },
  {
    "id": 181,
    "text": "说明神游不是逃避现实，而是在宇宙遨游的极度自由中再次升华为对故土生死不渝的终极眷恋，",
    "start": 754.344,
    "end": 762.104,
    "duration": 7.76
  },
  {
    "id": 182,
    "text": "极富悲剧审美张力。",
    "start": 762.104,
    "end": 763.464,
    "duration": 1.36
  },
  {
    "id": 183,
    "text": "所以本段具体答题完整版为：三、虚实相生的宏伟构架：现实受挫与上下求索的天界神游。",
    "start": 763.864,
    "end": 772.424,
    "duration": 8.56
  },
  {
    "id": 184,
    "text": "《离骚》在篇章构架上展现出飞腾壮丽的想象力，",
    "start": 772.424,
    "end": 776.584,
    "duration": 4.16
  },
  {
    "id": 185,
    "text": "构筑了虚实交织的宏大波澜。",
    "start": 776.584,
    "end": 779.064,
    "duration": 2.48
  },
  {
    "id": 186,
    "text": "前半部分立足于现实世界，沉痛自述高贵出身、",
    "start": 779.064,
    "end": 783.544,
    "duration": 4.48
  },
  {
    "id": 187,
    "text": "修身自励与遭缠见弃的政治悲剧。",
    "start": 783.544,
    "end": 786.264,
    "duration": 2.72
  },
  {
    "id": 188,
    "text": "后半部分笔锋骤然飞升，借助于神话传说展开天界与宇宙的自由驰骋。",
    "start": 786.504,
    "end": 792.424,
    "duration": 5.92
  },
  {
    "id": 189,
    "text": "诗人命羲和弭节、叫望舒先驱、驾飞龙鸾凤周流上下，",
    "start": 792.424,
    "end": 797.384,
    "duration": 4.96
  },
  {
    "id": 190,
    "text": "叩九重天门以求通达。",
    "start": 797.384,
    "end": 799.384,
    "duration": 2.0
  },
  {
    "id": 191,
    "text": "求女不遂后，诗人从灵氛之卜与巫咸之言，",
    "start": 799.384,
    "end": 803.304,
    "duration": 3.92
  },
  {
    "id": 192,
    "text": "在广袤宇宙间寻找精神出路。",
    "start": 803.304,
    "end": 806.024,
    "duration": 2.72
  },
  {
    "id": 193,
    "text": "然而正当飞升至云霓之上时，诗人猛然俯瞰故土宗国：“制升皇之赫戏兮，",
    "start": 806.024,
    "end": 812.584,
    "duration": 6.56
  },
  {
    "id": 194,
    "text": "忽临睨夫旧乡”。",
    "start": 812.584,
    "end": 813.704,
    "duration": 1.12
  },
  {
    "id": 195,
    "text": "驾车仆夫与所乘飞马皆悲鸣蜷局而不能前行，",
    "start": 814.024,
    "end": 818.744,
    "duration": 4.72
  },
  {
    "id": 196,
    "text": "最终从神幻九天剧烈跌回现实悲剧。",
    "start": 818.744,
    "end": 822.424,
    "duration": 3.68
  },
  {
    "id": 197,
    "text": "这种现实与神游的剧烈对撞，使全诗爆发出了震撼人心的悲壮力量。。",
    "start": 822.424,
    "end": 828.504,
    "duration": 6.08
  },
  {
    "id": 198,
    "text": "第五段：第四分论点，骚体文式的体裁飞跃（言之“宏”）。",
    "start": 828.504,
    "end": 833.544,
    "duration": 5.04
  },
  {
    "id": 199,
    "text": "逐句因果推导与答题表述。",
    "start": 833.544,
    "end": 835.624,
    "duration": 2.08
  },
  {
    "id": 200,
    "text": "在剖析了思想、意象与结构之后，本段必须进一步下沉到文体体制与语言声律的物理形式。",
    "start": 835.944,
    "end": 844.184,
    "duration": 8.24
  },
  {
    "id": 201,
    "text": "首句立论，指出《离骚》彻底打破了《诗经》四言短促封闭的体制格局。",
    "start": 844.184,
    "end": 850.184,
    "duration": 6.0
  },
  {
    "id": 202,
    "text": "所以表述为：《离骚》在体式形式上彻底打破了《诗经》四言为主的短促封闭格局。",
    "start": 850.184,
    "end": 856.584,
    "duration": 6.4
  },
  {
    "id": 203,
    "text": "次句指出其文体渊源，说明屈原吸纳楚地民歌营养开创了“骚体”。",
    "start": 856.904,
    "end": 862.504,
    "duration": 5.6
  },
  {
    "id": 204,
    "text": "所以表述为：屈原吸纳楚地民间歌谣的营养，",
    "start": 862.504,
    "end": 866.655,
    "duration": 4.151
  },
  {
    "id": 205,
    "text": "创立了句式错落参差的全新诗体，“骚体”。",
    "start": 866.655,
    "end": 870.26,
    "duration": 3.605
  },
  {
    "id": 206,
    "text": "第三句点出核心虚词“兮”字的广泛运用，",
    "start": 870.26,
    "end": 873.865,
    "duration": 3.605
  },
  {
    "id": 207,
    "text": "调节音乐节拍。",
    "start": 873.865,
    "end": 875.217,
    "duration": 1.352
  },
  {
    "id": 208,
    "text": "所以表述为：诗中大量运用具有鲜明荆楚地域色彩的助词“兮”字，",
    "start": 875.217,
    "end": 880.824,
    "duration": 5.607
  },
  {
    "id": 209,
    "text": "调节声律节奏。",
    "start": 880.824,
    "end": 882.424,
    "duration": 1.6
  },
  {
    "id": 210,
    "text": "第四句剖析“兮”字的美学功能，长声延展的长歌当哭增强了悲凉音乐美。",
    "start": 882.424,
    "end": 888.664,
    "duration": 6.24
  },
  {
    "id": 211,
    "text": "所以表述为：“兮”字的延展呼告强化了长歌当哭的顿挫语流，",
    "start": 888.664,
    "end": 894.218,
    "duration": 5.554
  },
  {
    "id": 212,
    "text": "极具声泪俱下的悲凉音乐美。",
    "start": 894.218,
    "end": 896.978,
    "duration": 2.76
  },
  {
    "id": 213,
    "text": "第五句指出词汇与句法的丰富性，广泛吸纳方言、",
    "start": 896.978,
    "end": 901.578,
    "duration": 4.6
  },
  {
    "id": 214,
    "text": "叠韵与华丽对偶。",
    "start": 901.578,
    "end": 903.188,
    "duration": 1.61
  },
  {
    "id": 215,
    "text": "所以表述为：在词汇运用上，《离骚》广泛吸纳方言土语、",
    "start": 903.188,
    "end": 908.018,
    "duration": 4.83
  },
  {
    "id": 216,
    "text": "双声叠韵与华美对仗。",
    "start": 908.018,
    "end": 910.088,
    "duration": 2.07
  },
  {
    "id": 217,
    "text": "第六句总结本段，指出这一体裁创造奠定了汉赋基础，",
    "start": 910.168,
    "end": 915.128,
    "duration": 4.96
  },
  {
    "id": 218,
    "text": "极大拓展了诗歌的容量。",
    "start": 915.128,
    "end": 917.048,
    "duration": 1.92
  },
  {
    "id": 219,
    "text": "所以表述为：这一文体创造不仅直接奠定了汉代辞赋的体制基础，",
    "start": 917.048,
    "end": 922.728,
    "duration": 5.68
  },
  {
    "id": 220,
    "text": "更极大地增强了诗歌的容量。",
    "start": 922.728,
    "end": 925.208,
    "duration": 2.48
  },
  {
    "id": 221,
    "text": "本段答题思路总结。",
    "start": 925.208,
    "end": 927.048,
    "duration": 1.84
  },
  {
    "id": 222,
    "text": "本段完成了从思想结构向语言体制的扎实落地：阐明骚体诗打破四言枷锁、",
    "start": 927.048,
    "end": 933.528,
    "duration": 6.48
  },
  {
    "id": 223,
    "text": "创造长句舒卷新体例的划时代贡献；",
    "start": 933.528,
    "end": 936.568,
    "duration": 3.04
  },
  {
    "id": 224,
    "text": "深入剖析核心语助词“兮”在情感呼吸延展与悲剧呼告中的声学功能；",
    "start": 936.888,
    "end": 942.888,
    "duration": 6.0
  },
  {
    "id": 225,
    "text": "指出其宏富词藻对后代辞赋与骈文的奠基作用，",
    "start": 942.888,
    "end": 947.128,
    "duration": 4.24
  },
  {
    "id": 226,
    "text": "全面论证了体裁革命对思想表达的有力支撑。",
    "start": 947.128,
    "end": 950.888,
    "duration": 3.76
  },
  {
    "id": 227,
    "text": "所以本段具体答题完整版为：四、骚体文式的体裁飞跃：错落舒卷的语言张力与地域音乐色彩。",
    "start": 950.888,
    "end": 958.568,
    "duration": 7.68
  },
  {
    "id": 228,
    "text": "《离骚》在体式形式上彻底打破了《诗经》四言为主的短促封闭格局。",
    "start": 958.808,
    "end": 964.414,
    "duration": 5.606
  },
  {
    "id": 229,
    "text": "屈原吸纳楚地民间歌谣的营养，创立了句式错落参差的全新诗体，",
    "start": 964.414,
    "end": 970.235,
    "duration": 5.821
  },
  {
    "id": 230,
    "text": "“骚体”。",
    "start": 970.235,
    "end": 970.667,
    "duration": 0.432
  },
  {
    "id": 231,
    "text": "诗中大量运用具有鲜明荆楚地域色彩的助词“兮”字，",
    "start": 970.667,
    "end": 975.194,
    "duration": 4.527
  },
  {
    "id": 232,
    "text": "调节声律节奏。",
    "start": 975.194,
    "end": 976.488,
    "duration": 1.294
  },
  {
    "id": 233,
    "text": "“兮”字的延展呼告强化了长歌当哭的顿挫语流，",
    "start": 976.488,
    "end": 980.71,
    "duration": 4.222
  },
  {
    "id": 234,
    "text": "极具声泪俱下的悲凉音乐美。",
    "start": 980.71,
    "end": 983.377,
    "duration": 2.667
  },
  {
    "id": 235,
    "text": "在词汇运用上，《离骚》广泛吸纳方言土语、",
    "start": 983.377,
    "end": 986.932,
    "duration": 3.555
  },
  {
    "id": 236,
    "text": "双声叠韵与华美对仗。",
    "start": 986.932,
    "end": 988.932,
    "duration": 2.0
  },
  {
    "id": 237,
    "text": "这一文体创造不仅直接奠定了汉代辞赋的体制基础，",
    "start": 988.932,
    "end": 993.821,
    "duration": 4.889
  },
  {
    "id": 238,
    "text": "更极大地增强了诗歌的容量。",
    "start": 993.821,
    "end": 996.488,
    "duration": 2.667
  },
  {
    "id": 239,
    "text": "第六段：尾段收官与文学史谱系闭环。",
    "start": 996.568,
    "end": 1000.328,
    "duration": 3.76
  },
  {
    "id": 240,
    "text": "逐句因果推导与答题表述。",
    "start": 1000.328,
    "end": 1002.728,
    "duration": 2.4
  },
  {
    "id": 241,
    "text": "尾段作为三十分大题的收官，必须将《离骚》置于“风骚并称”的宏大长河中定型。",
    "start": 1002.728,
    "end": 1008.888,
    "duration": 6.16
  },
  {
    "id": 242,
    "text": "首句综合前述四个维度，定评其为中国古典浪漫主义艺术最崇高的源头活水。",
    "start": 1008.888,
    "end": 1015.288,
    "duration": 6.4
  },
  {
    "id": 243,
    "text": "所以表述为：综上所述，《离骚》是中国古典文学浪漫主义艺术最崇高的源头活水。",
    "start": 1015.528,
    "end": 1022.311,
    "duration": 6.783
  },
  {
    "id": 244,
    "text": "次句指出“风骚”并称的千古地位，",
    "start": 1022.311,
    "end": 1025.055,
    "duration": 2.744
  },
  {
    "id": 245,
    "text": "共同构筑了中国文学的双重基石。",
    "start": 1025.055,
    "end": 1028.01,
    "duration": 2.955
  },
  {
    "id": 246,
    "text": "所以表述为：它与《诗经》并称“风骚”，",
    "start": 1028.01,
    "end": 1030.754,
    "duration": 2.744
  },
  {
    "id": 247,
    "text": "共同奠定了中国诗歌现实主义与浪漫主义的双重基石。",
    "start": 1030.754,
    "end": 1035.608,
    "duration": 4.854
  },
  {
    "id": 248,
    "text": "第三句向后纵向延展，指出美政理想、",
    "start": 1035.752,
    "end": 1039.592,
    "duration": 3.84
  },
  {
    "id": 249,
    "text": "香草美人与求索精神对后代的精神滋养。",
    "start": 1039.592,
    "end": 1043.592,
    "duration": 4.0
  },
  {
    "id": 250,
    "text": "所以表述为：屈原所开创的美政理想、",
    "start": 1043.592,
    "end": 1046.952,
    "duration": 3.36
  },
  {
    "id": 251,
    "text": "香草美人体系与上下求索的献身精神。",
    "start": 1046.952,
    "end": 1050.792,
    "duration": 3.84
  },
  {
    "id": 252,
    "text": "第四句指出其对李白狂放诗风的哺育，",
    "start": 1050.792,
    "end": 1054.152,
    "duration": 3.36
  },
  {
    "id": 253,
    "text": "以及成为历代仁人志士的精神明灯。",
    "start": 1054.152,
    "end": 1057.032,
    "duration": 2.88
  },
  {
    "id": 254,
    "text": "所以表述为：千百年来深远哺育了李白的豪放狂飙，",
    "start": 1057.432,
    "end": 1061.992,
    "duration": 4.56
  },
  {
    "id": 255,
    "text": "更成为历代爱国仁人志士的精神明灯。",
    "start": 1061.992,
    "end": 1065.352,
    "duration": 3.36
  },
  {
    "id": 256,
    "text": "本段答题思路总结。",
    "start": 1065.352,
    "end": 1066.952,
    "duration": 1.6
  },
  {
    "id": 257,
    "text": "本段完成了气势雄阔的收官：将《离骚》与《诗经》双峰并峙并提，",
    "start": 1066.952,
    "end": 1071.992,
    "duration": 5.04
  },
  {
    "id": 258,
    "text": "确立风骚相映的古典文学最高源头法则；",
    "start": 1071.992,
    "end": 1075.112,
    "duration": 3.12
  },
  {
    "id": 259,
    "text": "随即点出其对李白盛唐浪漫主义的直接催化，",
    "start": 1075.592,
    "end": 1079.192,
    "duration": 3.6
  },
  {
    "id": 260,
    "text": "以及对中国历代士人“独立不迁、以身殉国”崇高道德人格的永恒铸造，",
    "start": 1079.192,
    "end": 1086.072,
    "duration": 6.88
  },
  {
    "id": 261,
    "text": "使全篇答卷在光芒万丈的文明高度上圆满闭环。",
    "start": 1086.072,
    "end": 1090.632,
    "duration": 4.56
  },
  {
    "id": 262,
    "text": "所以本段具体答题完整版为：综上所述，",
    "start": 1090.632,
    "end": 1094.232,
    "duration": 3.6
  },
  {
    "id": 263,
    "text": "《离骚》是中国古典文学浪漫主义艺术最崇高的源头活水。",
    "start": 1094.232,
    "end": 1098.952,
    "duration": 4.72
  },
  {
    "id": 264,
    "text": "它与《诗经》并称“风骚”，共同奠定了中国诗歌现实主义与浪漫主义的双重基石。",
    "start": 1099.192,
    "end": 1105.352,
    "duration": 6.16
  },
  {
    "id": 265,
    "text": "屈原所开创的美政理想、香草美人体系与上下求索的献身精神。",
    "start": 1105.352,
    "end": 1110.552,
    "duration": 5.2
  },
  {
    "id": 266,
    "text": "千百年来深远哺育了李白的豪放狂飙，",
    "start": 1110.552,
    "end": 1113.512,
    "duration": 2.96
  },
  {
    "id": 267,
    "text": "更成为历代爱国仁人志士的精神明灯。",
    "start": 1113.512,
    "end": 1116.232,
    "duration": 2.72
  },
  {
    "id": 268,
    "text": "整道大题的内在逻辑链总括。",
    "start": 1116.632,
    "end": 1119.192,
    "duration": 2.56
  },
  {
    "id": 269,
    "text": "这道三十分大题的本质，是一场极度严密的逻辑推演。",
    "start": 1119.192,
    "end": 1123.352,
    "duration": 4.16
  },
  {
    "id": 270,
    "text": "整篇答卷从头到尾遵循着“由典范定评、",
    "start": 1123.352,
    "end": 1126.632,
    "duration": 3.28
  },
  {
    "id": 271,
    "text": "到美政理想、到香草象征、到虚实神游、",
    "start": 1126.632,
    "end": 1130.392,
    "duration": 3.76
  },
  {
    "id": 272,
    "text": "到骚体语言、最终回归风骚闭环”的必然法则。",
    "start": 1130.392,
    "end": 1133.992,
    "duration": 3.6
  },
  {
    "id": 273,
    "text": "阅卷老师看到的绝不是散乱的答题点，",
    "start": 1134.232,
    "end": 1137.272,
    "duration": 3.04
  },
  {
    "id": 274,
    "text": "而是一条咬合紧密的因果长链：第一步是“立论定性”，",
    "start": 1137.272,
    "end": 1141.912,
    "duration": 4.64
  },
  {
    "id": 275,
    "text": "开门见山借司马迁“与日月争光”定论，",
    "start": 1141.912,
    "end": 1145.592,
    "duration": 3.68
  },
  {
    "id": 276,
    "text": "确立其作为中国第一浪漫主义长篇抒情诗的标杆。",
    "start": 1145.592,
    "end": 1149.672,
    "duration": 4.08
  },
  {
    "id": 277,
    "text": "第二步是“美政理想”，以“哀民多艰”与“九死不悔”，",
    "start": 1149.672,
    "end": 1154.232,
    "duration": 4.56
  },
  {
    "id": 278,
    "text": "剖析美政追求与献身爱国的崇高思想内核。",
    "start": 1154.232,
    "end": 1157.912,
    "duration": 3.68
  },
  {
    "id": 279,
    "text": "第三步是“香草美人”，以嘉卉表修洁、",
    "start": 1158.152,
    "end": 1161.272,
    "duration": 3.12
  },
  {
    "id": 280,
    "text": "恶草表群小、美人表君主，透析比兴手法向人格象征的伟大飞跃。",
    "start": 1161.272,
    "end": 1167.352,
    "duration": 6.08
  },
  {
    "id": 281,
    "text": "第四步是“虚实神游”，以天界巡游与“忽临睨夫旧乡”的骤然跌落，",
    "start": 1167.352,
    "end": 1172.872,
    "duration": 5.52
  },
  {
    "id": 282,
    "text": "论证现实受挫与浪漫幻想的剧烈悲剧碰撞。",
    "start": 1172.872,
    "end": 1176.632,
    "duration": 3.76
  },
  {
    "id": 283,
    "text": "第五步是“骚体文式”，以错落长句与“兮”字呼告长歌当哭，",
    "start": 1176.632,
    "end": 1181.592,
    "duration": 4.96
  },
  {
    "id": 284,
    "text": "阐明文体创新对宏大情感容量的物理支撑。",
    "start": 1181.592,
    "end": 1184.872,
    "duration": 3.28
  },
  {
    "id": 285,
    "text": "第六步是“风骚闭环”，把《离骚》与《诗经》并置，",
    "start": 1185.176,
    "end": 1188.776,
    "duration": 3.6
  },
  {
    "id": 286,
    "text": "自然引向对汉赋、盛唐李白与历代志士的永恒精神哺育。",
    "start": 1188.776,
    "end": 1193.496,
    "duration": 4.72
  },
  {
    "id": 287,
    "text": "这六步层层递进，前一步的结论必然成为后一步的前提。",
    "start": 1193.496,
    "end": 1197.656,
    "duration": 4.16
  },
  {
    "id": 288,
    "text": "你在考场上顺着因果关系顺流而下，",
    "start": 1197.656,
    "end": 1200.456,
    "duration": 2.8
  },
  {
    "id": 289,
    "text": "就能自然写出近千字的满分答卷。",
    "start": 1200.456,
    "end": 1202.856,
    "duration": 2.4
  }
]