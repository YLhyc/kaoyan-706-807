[
  {
    "id": 1,
    "text": "全局宏观破题与立论逻辑。",
    "start": 0.16,
    "end": 3.12,
    "duration": 2.96
  },
  {
    "id": 2,
    "text": "在考场下笔之前，必须先在宏观上审清这道三十分大题的核心考核意图。",
    "start": 3.12,
    "end": 9.12,
    "duration": 6.0
  },
  {
    "id": 3,
    "text": "本题表面上考查屈原《离骚》的思想与艺术，",
    "start": 9.12,
    "end": 12.64,
    "duration": 3.52
  },
  {
    "id": 4,
    "text": "本质上考查中国文学个人化抒情巨著的开创机制。",
    "start": 12.64,
    "end": 16.64,
    "duration": 4.0
  },
  {
    "id": 5,
    "text": "考场评分标准绝不满足于仅孤立背诵几句爱国名句。",
    "start": 16.64,
    "end": 20.64,
    "duration": 4.0
  },
  {
    "id": 6,
    "text": "答题方向必须确立为“从美政政治理想与崇高人格，",
    "start": 20.96,
    "end": 25.44,
    "duration": 4.48
  },
  {
    "id": 7,
    "text": "推进到香草美人的比兴象征体系，再展开到虚实神游的宏伟构架，",
    "start": 25.44,
    "end": 30.88,
    "duration": 5.44
  },
  {
    "id": 8,
    "text": "最终落地至骚体句式与文学史定位”的因果推进。",
    "start": 30.88,
    "end": 34.88,
    "duration": 4.0
  },
  {
    "id": 9,
    "text": "整道大题在宏观上划分为五个有机递进的逻辑层次：第一层，",
    "start": 34.88,
    "end": 39.52,
    "duration": 4.64
  },
  {
    "id": 10,
    "text": "开篇破题，借司马迁“与日月争光”定评与袁行配教材，",
    "start": 39.52,
    "end": 44.24,
    "duration": 4.72
  },
  {
    "id": 11,
    "text": "确立其作为浪漫主义抒情诗开山的坐标。",
    "start": 44.24,
    "end": 47.12,
    "duration": 2.88
  },
  {
    "id": 12,
    "text": "第二层，论述思想内核，剖析美政理想、",
    "start": 47.44,
    "end": 50.88,
    "duration": 3.44
  },
  {
    "id": 13,
    "text": "哀民多艰与九死不悔的献身精神。",
    "start": 50.88,
    "end": 54.0,
    "duration": 3.12
  },
  {
    "id": 14,
    "text": "第三层，论述艺术手法，深度剖析香草美人如何将自然草木升华为立体人格寄托。",
    "start": 54.0,
    "end": 61.52,
    "duration": 7.52
  },
  {
    "id": 15,
    "text": "第四层，论述篇章结构，阐释现实受挫与天界神游的虚实交织，",
    "start": 61.52,
    "end": 67.28,
    "duration": 5.76
  },
  {
    "id": 16,
    "text": "以及临睨旧乡的情感跌回。",
    "start": 67.28,
    "end": 69.28,
    "duration": 2.0
  },
  {
    "id": 17,
    "text": "第五层，落地至文体语言，阐释骚体句式与“兮”字声律如何支撑长篇宏制。",
    "start": 69.6,
    "end": 76.4,
    "duration": 6.8
  },
  {
    "id": 18,
    "text": "尾部收官，以“风骚”并称定性，交代其对汉赋、",
    "start": 76.4,
    "end": 80.56,
    "duration": 4.16
  },
  {
    "id": 19,
    "text": "李白及后世爱国文学传统的血脉滋养。",
    "start": 80.56,
    "end": 84.32,
    "duration": 3.76
  },
  {
    "id": 20,
    "text": "这五个层次构成一条不可逆的因果链条：美政是理想，",
    "start": 84.32,
    "end": 89.12,
    "duration": 4.8
  },
  {
    "id": 21,
    "text": "香草是象征，神游是翅膀，骚体是载体，",
    "start": 89.12,
    "end": 93.2,
    "duration": 4.08
  },
  {
    "id": 22,
    "text": "风骚并称是历史定型。",
    "start": 93.2,
    "end": 95.2,
    "duration": 2.0
  },
  {
    "id": 23,
    "text": "理顺了宏观全局思路，接下来进入每一段的具体推导与逐句表述。",
    "start": 95.44,
    "end": 100.72,
    "duration": 5.28
  },
  {
    "id": 24,
    "text": "第一段：首段破题与概念定性。",
    "start": 100.72,
    "end": 103.76,
    "duration": 3.04
  },
  {
    "id": 25,
    "text": "逐句因果推导与答题表述。",
    "start": 103.76,
    "end": 106.4,
    "duration": 2.64
  },
  {
    "id": 26,
    "text": "首句必须直击核心地位，确立其在诗歌史上的长篇抒情诗开山坐标。",
    "start": 106.4,
    "end": 112.24,
    "duration": 5.84
  },
  {
    "id": 27,
    "text": "所以表述为：次句必须引入司马迁在《史记》中的至高定评，",
    "start": 112.24,
    "end": 117.04,
    "duration": 4.8
  },
  {
    "id": 28,
    "text": "为整篇答卷奠定崇高基调。",
    "start": 117.04,
    "end": 119.44,
    "duration": 2.4
  },
  {
    "id": 29,
    "text": "所以表述为：第三句引入考研权威教材的学术界定，",
    "start": 119.76,
    "end": 123.994,
    "duration": 4.234
  },
  {
    "id": 30,
    "text": "指出其打破先秦短篇集体抒情的体制突破。",
    "start": 123.994,
    "end": 127.661,
    "duration": 3.667
  },
  {
    "id": 31,
    "text": "所以表述为：第四句进一步指出其美学突破，",
    "start": 127.661,
    "end": 131.327,
    "duration": 3.666
  },
  {
    "id": 32,
    "text": "首次确立了个性鲜明的抒情主人公形象。",
    "start": 131.327,
    "end": 134.79,
    "duration": 3.463
  },
  {
    "id": 33,
    "text": "所以表述为：第五句作为首段过渡句，",
    "start": 134.79,
    "end": 137.845,
    "duration": 3.055
  },
  {
    "id": 34,
    "text": "宣告下文将从四个核心维度展开系统论证。",
    "start": 137.845,
    "end": 141.512,
    "duration": 3.667
  },
  {
    "id": 35,
    "text": "所以表述为：本段答题思路总结。",
    "start": 141.512,
    "end": 144.16,
    "duration": 2.648
  },
  {
    "id": 36,
    "text": "本段用五句话完成立论闭环：先直接给出中国第一长篇政治抒情诗的定性；",
    "start": 144.296,
    "end": 150.456,
    "duration": 6.16
  },
  {
    "id": 37,
    "text": "随即引用司马迁“虽与日月争光可也”的千古赞誉；",
    "start": 150.456,
    "end": 154.536,
    "duration": 4.08
  },
  {
    "id": 38,
    "text": "接着结合袁行配教材点明其打破短篇集体歌唱、",
    "start": 154.536,
    "end": 158.696,
    "duration": 4.16
  },
  {
    "id": 39,
    "text": "创立个体抒情形象的划时代意义；",
    "start": 158.696,
    "end": 161.576,
    "duration": 2.88
  },
  {
    "id": 40,
    "text": "最后引出四个分论点，气象雄浑严谨。",
    "start": 161.576,
    "end": 164.616,
    "duration": 3.04
  },
  {
    "id": 41,
    "text": "所以本段具体答题完整版为：第二段：第一分论点，",
    "start": 164.936,
    "end": 169.016,
    "duration": 4.08
  },
  {
    "id": 42,
    "text": "思想内核的美政理想（志之“坚”）。",
    "start": 169.016,
    "end": 172.216,
    "duration": 3.2
  },
  {
    "id": 43,
    "text": "逐句因果推导与答题表述。",
    "start": 172.216,
    "end": 174.856,
    "duration": 2.64
  },
  {
    "id": 44,
    "text": "论述离骚，首先必须从屈原终身坚守的政治理想切入，",
    "start": 174.856,
    "end": 179.416,
    "duration": 4.56
  },
  {
    "id": 45,
    "text": "这是整首长诗的灵魂。",
    "start": 179.416,
    "end": 181.496,
    "duration": 2.08
  },
  {
    "id": 46,
    "text": "首句确立分论点，指出思想内核是屈原贯穿一生的“美政”理想。",
    "start": 181.496,
    "end": 187.096,
    "duration": 5.6
  },
  {
    "id": 47,
    "text": "所以表述为：次句严格界定美政的具体内涵，",
    "start": 187.416,
    "end": 191.01,
    "duration": 3.594
  },
  {
    "id": 48,
    "text": "说明修明法度、选贤任能与心系百姓。",
    "start": 191.01,
    "end": 194.041,
    "duration": 3.031
  },
  {
    "id": 49,
    "text": "所以表述为：第三句面对楚国现实危局，",
    "start": 194.041,
    "end": 197.273,
    "duration": 3.232
  },
  {
    "id": 50,
    "text": "调取最能展现其忧民情怀的千古名句。",
    "start": 197.273,
    "end": 200.505,
    "duration": 3.232
  },
  {
    "id": 51,
    "text": "所以表述为：第四句推导因果，即便身遭流放缠害，",
    "start": 200.505,
    "end": 204.546,
    "duration": 4.041
  },
  {
    "id": 52,
    "text": "其对祖国宗庙的依恋依然深沉不改。",
    "start": 204.546,
    "end": 207.576,
    "duration": 3.03
  },
  {
    "id": 53,
    "text": "所以表述为：第五句调取全诗最具震撼力的誓死明志之句，",
    "start": 207.736,
    "end": 212.748,
    "duration": 5.012
  },
  {
    "id": 54,
    "text": "展现九死不悔的骨气。",
    "start": 212.748,
    "end": 214.647,
    "duration": 1.899
  },
  {
    "id": 55,
    "text": "所以表述为：第六句收束全段，指出这种生死相依的爱国忠贞铸就了士大夫的精神脊梁。",
    "start": 214.647,
    "end": 222.242,
    "duration": 7.595
  },
  {
    "id": 56,
    "text": "所以表述为：本段答题思路总结。",
    "start": 222.242,
    "end": 224.985,
    "duration": 2.743
  },
  {
    "id": 57,
    "text": "本段是思想意蕴的核心基石：先明确阐释“美政”所涵盖的贤能政治与民本思想；",
    "start": 224.985,
    "end": 231.736,
    "duration": 6.751
  },
  {
    "id": 58,
    "text": "随后紧扣“哀民生之多艰”的悲敏情怀与“虽九死其犹未悔”的坚贞誓言；",
    "start": 231.896,
    "end": 238.296,
    "duration": 6.4
  },
  {
    "id": 59,
    "text": "透彻论证了屈原绝非普通怨妇怨臣，",
    "start": 238.296,
    "end": 241.416,
    "duration": 3.12
  },
  {
    "id": 60,
    "text": "而是将自身命运与国家存亡紧密熔铸的伟大爱国思想家。",
    "start": 241.416,
    "end": 246.536,
    "duration": 5.12
  },
  {
    "id": 61,
    "text": "所以本段具体答题完整版为：第三段：第二分论点，",
    "start": 246.536,
    "end": 250.616,
    "duration": 4.08
  },
  {
    "id": 62,
    "text": "比兴寄托的意象体系（象之“美”）。",
    "start": 250.616,
    "end": 253.176,
    "duration": 2.56
  },
  {
    "id": 63,
    "text": "逐句因果推导与答题表述。",
    "start": 253.416,
    "end": 255.816,
    "duration": 2.4
  },
  {
    "id": 64,
    "text": "第二段讲清了政治抱负，第三段必须正面攻克屈原最具创造性的表现手法，",
    "start": 255.816,
    "end": 261.576,
    "duration": 5.76
  },
  {
    "id": 65,
    "text": "即香草美人的寄托手法。",
    "start": 261.576,
    "end": 263.736,
    "duration": 2.16
  },
  {
    "id": 66,
    "text": "首句立论，指出屈原拓展了诗经比兴，",
    "start": 263.736,
    "end": 266.776,
    "duration": 3.04
  },
  {
    "id": 67,
    "text": "开创了系统的香草美人象征体系。",
    "start": 266.776,
    "end": 269.656,
    "duration": 2.88
  },
  {
    "id": 68,
    "text": "所以表述为：次句阐明其艺术提升，",
    "start": 269.656,
    "end": 272.936,
    "duration": 3.28
  },
  {
    "id": 69,
    "text": "说明他将无生命的自然草木赋予了崇高的政治道德意涵。",
    "start": 272.936,
    "end": 277.096,
    "duration": 4.16
  },
  {
    "id": 70,
    "text": "所以表述为：第三句分析香草正面的象征功能，",
    "start": 277.416,
    "end": 281.589,
    "duration": 4.173
  },
  {
    "id": 71,
    "text": "代表洁白德行与政治才华。",
    "start": 281.589,
    "end": 284.042,
    "duration": 2.453
  },
  {
    "id": 72,
    "text": "所以表述为：第四句引用名句，展现晨饮坠露、",
    "start": 284.042,
    "end": 288.055,
    "duration": 4.013
  },
  {
    "id": 73,
    "text": "夕餐落英的拔俗形象。",
    "start": 288.055,
    "end": 290.061,
    "duration": 2.006
  },
  {
    "id": 74,
    "text": "所以表述为：第五句对比反面意象，",
    "start": 290.061,
    "end": 293.16,
    "duration": 3.099
  },
  {
    "id": 75,
    "text": "以恶草秽木象征奸邪小人与黑暗现实。",
    "start": 293.16,
    "end": 296.92,
    "duration": 3.76
  },
  {
    "id": 76,
    "text": "所以表述为：第六句揭示“美人”的核心寄托，",
    "start": 296.92,
    "end": 300.543,
    "duration": 3.623
  },
  {
    "id": 77,
    "text": "代表贤明君主与志同道合的美政知音。",
    "start": 300.543,
    "end": 303.926,
    "duration": 3.383
  },
  {
    "id": 78,
    "text": "所以表述为：第七句总结收束，指出这一体系使诗歌意象完成了向崇高人格象征的伟大飞跃。",
    "start": 303.926,
    "end": 311.96,
    "duration": 8.034
  },
  {
    "id": 79,
    "text": "所以表述为：本段答题思路总结。",
    "start": 312.12,
    "end": 315.16,
    "duration": 3.04
  },
  {
    "id": 80,
    "text": "本段聚焦于最具标志性的艺术表现技巧：由诗经比兴自然推进至屈原的香草美人体系；",
    "start": 315.16,
    "end": 323.0,
    "duration": 7.84
  },
  {
    "id": 81,
    "text": "条分缕析嘉花芳草象征美好德操、萧艾恶木象征缠产群小、",
    "start": 323.0,
    "end": 329.4,
    "duration": 6.4
  },
  {
    "id": 82,
    "text": "求索美人象征追寻明君知音的三重机制；",
    "start": 329.4,
    "end": 332.92,
    "duration": 3.52
  },
  {
    "id": 83,
    "text": "结合“朝饮木兰、夕餐秋菊”的千古名句，",
    "start": 332.92,
    "end": 336.12,
    "duration": 3.2
  },
  {
    "id": 84,
    "text": "论证了物象与人道精神的完全同构。",
    "start": 336.12,
    "end": 338.92,
    "duration": 2.8
  },
  {
    "id": 85,
    "text": "所以本段具体答题完整版为：第四段：第三分论点，",
    "start": 339.32,
    "end": 343.72,
    "duration": 4.4
  },
  {
    "id": 86,
    "text": "虚实相生的宏伟构架（构之“奇”）。",
    "start": 343.72,
    "end": 347.08,
    "duration": 3.36
  },
  {
    "id": 87,
    "text": "逐句因果推导与答题表述。",
    "start": 347.08,
    "end": 349.88,
    "duration": 2.8
  },
  {
    "id": 88,
    "text": "前两段解决了意与象，第四段必须剖析《离骚》波澜壮阔的宏大篇章结构。",
    "start": 349.88,
    "end": 356.12,
    "duration": 6.24
  },
  {
    "id": 89,
    "text": "首句确立分论点，指出长诗在构架上展现出飞腾壮丽的想象力，",
    "start": 356.12,
    "end": 361.64,
    "duration": 5.52
  },
  {
    "id": 90,
    "text": "构筑了虚实相生的宏大波澜。",
    "start": 361.64,
    "end": 363.96,
    "duration": 2.32
  },
  {
    "id": 91,
    "text": "所以表述为：次句概括长诗前半部分的写实基础，",
    "start": 364.44,
    "end": 368.878,
    "duration": 4.438
  },
  {
    "id": 92,
    "text": "沉痛叙写自身出身与政治受难。",
    "start": 368.878,
    "end": 371.805,
    "duration": 2.927
  },
  {
    "id": 93,
    "text": "所以表述为：第三句指出后半部分的飞腾转折，",
    "start": 371.805,
    "end": 376.083,
    "duration": 4.278
  },
  {
    "id": 94,
    "text": "借助神话展开宇宙天界的自由神游。",
    "start": 376.083,
    "end": 379.46,
    "duration": 3.377
  },
  {
    "id": 95,
    "text": "所以表述为：第四句铺叙神游过程中的神灵役使，",
    "start": 379.46,
    "end": 383.963,
    "duration": 4.503
  },
  {
    "id": 96,
    "text": "羲和弭节、驾龙鸾周流上下。",
    "start": 383.963,
    "end": 386.44,
    "duration": 2.477
  },
  {
    "id": 97,
    "text": "所以表述为：第五句叙述求女受挫后从灵氛、",
    "start": 386.6,
    "end": 390.9,
    "duration": 4.3
  },
  {
    "id": 98,
    "text": "巫咸之言，在广袤太虚寻求精神出路。",
    "start": 390.9,
    "end": 394.553,
    "duration": 3.653
  },
  {
    "id": 99,
    "text": "所以表述为：第六句迎来全诗最具悲剧震撼力的骤然折回，",
    "start": 394.553,
    "end": 400.397,
    "duration": 5.844
  },
  {
    "id": 100,
    "text": "猛然回首遥望故土。",
    "start": 400.397,
    "end": 402.345,
    "duration": 1.948
  },
  {
    "id": 101,
    "text": "所以表述为：第七句剖析仆夫悲叹、",
    "start": 402.345,
    "end": 405.754,
    "duration": 3.409
  },
  {
    "id": 102,
    "text": "马匹怀恋不肯前行的传神细节。",
    "start": 405.754,
    "end": 408.92,
    "duration": 3.166
  },
  {
    "id": 103,
    "text": "所以表述为：第八句总结全段，指出这种现实与幻想的剧烈碰撞爆发出了撼人的悲壮力量。",
    "start": 409.08,
    "end": 417.263,
    "duration": 8.183
  },
  {
    "id": 104,
    "text": "所以表述为：本段答题思路总结。",
    "start": 417.263,
    "end": 420.16,
    "duration": 2.897
  },
  {
    "id": 105,
    "text": "本段是对宏伟浪漫主义篇章构架的精妙剖析：清晰厘清前半篇“现实政治受创”与后半篇“九天神游求索”的虚实双层波澜；",
    "start": 420.16,
    "end": 431.08,
    "duration": 10.92
  },
  {
    "id": 106,
    "text": "重点剖析“临睨旧乡、马怀蜷局”的神转折，",
    "start": 431.24,
    "end": 434.84,
    "duration": 3.6
  },
  {
    "id": 107,
    "text": "说明神游不是逃避现实，而是在宇宙遨游的极度自由中再次升华为对楚国故土生死不渝的深沉眷恋，",
    "start": 434.84,
    "end": 443.08,
    "duration": 8.24
  },
  {
    "id": 108,
    "text": "极富悲剧审美张力。",
    "start": 443.08,
    "end": 444.92,
    "duration": 1.84
  },
  {
    "id": 109,
    "text": "所以本段具体答题完整版为：第五段：第四分论点，",
    "start": 444.92,
    "end": 449.216,
    "duration": 4.296
  },
  {
    "id": 110,
    "text": "骚体文式的体裁飞跃（言之“宏”）。",
    "start": 449.216,
    "end": 452.096,
    "duration": 2.88
  },
  {
    "id": 111,
    "text": "逐句因果推导与答题表述。",
    "start": 452.096,
    "end": 454.496,
    "duration": 2.4
  },
  {
    "id": 112,
    "text": "在剖析了思想、意象与结构之后，本段必须进一步下沉到文体体制与语言声律的物理形式。",
    "start": 454.496,
    "end": 462.816,
    "duration": 8.32
  },
  {
    "id": 113,
    "text": "首句立论，指出《离骚》彻底打破了《诗经》四言短促封闭的体制格局。",
    "start": 462.816,
    "end": 467.936,
    "duration": 5.12
  },
  {
    "id": 114,
    "text": "所以表述为：次句指出其文体渊源，",
    "start": 468.256,
    "end": 471.445,
    "duration": 3.189
  },
  {
    "id": 115,
    "text": "说明屈原吸纳楚地民歌营养开创了“骚体”。",
    "start": 471.445,
    "end": 475.405,
    "duration": 3.96
  },
  {
    "id": 116,
    "text": "所以表述为：第三句点出核心虚词“兮”字的广泛运用，",
    "start": 475.405,
    "end": 480.297,
    "duration": 4.892
  },
  {
    "id": 117,
    "text": "调节音乐节拍。",
    "start": 480.297,
    "end": 481.695,
    "duration": 1.398
  },
  {
    "id": 118,
    "text": "所以表述为：第四句剖析“兮”字的美学功能，",
    "start": 481.695,
    "end": 485.656,
    "duration": 3.961
  },
  {
    "id": 119,
    "text": "长声延展的长歌当哭增强了悲凉音乐美。",
    "start": 485.656,
    "end": 489.616,
    "duration": 3.96
  },
  {
    "id": 120,
    "text": "所以表述为：第五句指出词汇与句法的丰富性，",
    "start": 489.776,
    "end": 493.746,
    "duration": 3.97
  },
  {
    "id": 121,
    "text": "广泛吸纳方言、叠韵与华丽对偶。",
    "start": 493.746,
    "end": 496.497,
    "duration": 2.751
  },
  {
    "id": 122,
    "text": "所以表述为：第六句总结本段，指出这一体裁创造奠定了汉赋基础，",
    "start": 496.497,
    "end": 502.212,
    "duration": 5.715
  },
  {
    "id": 123,
    "text": "极大拓展了诗歌的容量。",
    "start": 502.212,
    "end": 504.328,
    "duration": 2.116
  },
  {
    "id": 124,
    "text": "所以表述为：本段答题思路总结。",
    "start": 504.328,
    "end": 507.08,
    "duration": 2.752
  },
  {
    "id": 125,
    "text": "本段完成了从思想结构向语言体制的扎实落地：阐明骚体诗打破四言枷锁、",
    "start": 507.08,
    "end": 513.641,
    "duration": 6.561
  },
  {
    "id": 126,
    "text": "创造长句舒卷新体例的划时代贡献；",
    "start": 513.641,
    "end": 516.816,
    "duration": 3.175
  },
  {
    "id": 127,
    "text": "深入剖析核心语助词“兮”在情感呼吸延展与悲剧呼告中的声学功能；",
    "start": 516.976,
    "end": 522.816,
    "duration": 5.84
  },
  {
    "id": 128,
    "text": "指出其宏富词藻对后代辞赋与骈文的奠基作用，",
    "start": 522.816,
    "end": 527.056,
    "duration": 4.24
  },
  {
    "id": 129,
    "text": "全面论证了体裁革命对思想表达的有力支撑。",
    "start": 527.056,
    "end": 530.496,
    "duration": 3.44
  },
  {
    "id": 130,
    "text": "所以本段具体答题完整版为：第六段：尾段收官与文学史谱系闭环。",
    "start": 530.496,
    "end": 536.096,
    "duration": 5.6
  },
  {
    "id": 131,
    "text": "逐句因果推导与答题表述。",
    "start": 536.336,
    "end": 538.976,
    "duration": 2.64
  },
  {
    "id": 132,
    "text": "尾段作为三十分大题的收官，必须将《离骚》置于“风骚并称”的宏大长河中定型。",
    "start": 538.976,
    "end": 545.296,
    "duration": 6.32
  },
  {
    "id": 133,
    "text": "首句综合前述四个维度，定评其为中国古典浪漫主义艺术最崇高的源头活水。",
    "start": 545.296,
    "end": 552.096,
    "duration": 6.8
  },
  {
    "id": 134,
    "text": "所以表述为：次句指出“风骚”并称的千古地位，",
    "start": 552.096,
    "end": 555.936,
    "duration": 3.84
  },
  {
    "id": 135,
    "text": "共同构筑了中国文学的双重基石。",
    "start": 555.936,
    "end": 558.496,
    "duration": 2.56
  },
  {
    "id": 136,
    "text": "所以表述为：第三句向后纵向延展，",
    "start": 558.896,
    "end": 561.742,
    "duration": 2.846
  },
  {
    "id": 137,
    "text": "指出美政理想、香草美人与求索精神对后代的精神滋养。",
    "start": 561.742,
    "end": 566.736,
    "duration": 4.994
  },
  {
    "id": 138,
    "text": "所以表述为：第四句指出其对李白狂放诗风的哺育，",
    "start": 566.736,
    "end": 571.296,
    "duration": 4.56
  },
  {
    "id": 139,
    "text": "以及成为历代仁人志士的精神明灯。",
    "start": 571.296,
    "end": 574.553,
    "duration": 3.257
  },
  {
    "id": 140,
    "text": "所以表述为：本段答题思路总结。",
    "start": 574.553,
    "end": 577.376,
    "duration": 2.823
  },
  {
    "id": 141,
    "text": "本段完成了气势雄阔的收官：将《离骚》与《诗经》双峰并峙并提，",
    "start": 577.52,
    "end": 583.6,
    "duration": 6.08
  },
  {
    "id": 142,
    "text": "确立风骚相映的古典文学最高源头法则；",
    "start": 583.6,
    "end": 587.04,
    "duration": 3.44
  },
  {
    "id": 143,
    "text": "随即点出其对李白盛唐浪漫主义的直接催化，",
    "start": 587.04,
    "end": 590.56,
    "duration": 3.52
  },
  {
    "id": 144,
    "text": "以及对中国历代士人“独立不迁、以身殉国”崇高道德人格的永恒铸造，",
    "start": 590.56,
    "end": 596.56,
    "duration": 6.0
  },
  {
    "id": 145,
    "text": "使全篇答卷在光芒万丈的文明高度上圆满闭环。",
    "start": 596.56,
    "end": 600.32,
    "duration": 3.76
  },
  {
    "id": 146,
    "text": "所以本段具体答题完整版为：整道大题的内在逻辑链总括。",
    "start": 600.64,
    "end": 605.12,
    "duration": 4.48
  },
  {
    "id": 147,
    "text": "这道三十分大题的本质，是一场极度严密的逻辑推演。",
    "start": 605.12,
    "end": 609.28,
    "duration": 4.16
  },
  {
    "id": 148,
    "text": "整篇答卷从头到尾遵循着“由典范定评、",
    "start": 609.28,
    "end": 612.56,
    "duration": 3.28
  },
  {
    "id": 149,
    "text": "到美政理想、到香草象征、到虚实神游、",
    "start": 612.56,
    "end": 616.4,
    "duration": 3.84
  },
  {
    "id": 150,
    "text": "到骚体语言、最终回归风骚闭环”的必然法则。",
    "start": 616.4,
    "end": 620.16,
    "duration": 3.76
  },
  {
    "id": 151,
    "text": "阅卷老师看到的绝不是散乱的答题点，",
    "start": 620.48,
    "end": 623.52,
    "duration": 3.04
  },
  {
    "id": 152,
    "text": "而是一条咬合紧密的因果长链：第一步是“立论定性”，",
    "start": 623.52,
    "end": 628.16,
    "duration": 4.64
  },
  {
    "id": 153,
    "text": "开门见山借司马迁“与日月争光”定论，",
    "start": 628.16,
    "end": 631.84,
    "duration": 3.68
  },
  {
    "id": 154,
    "text": "确立其作为中国第一浪漫主义长篇抒情诗的标杆。",
    "start": 631.84,
    "end": 635.92,
    "duration": 4.08
  },
  {
    "id": 155,
    "text": "第二步是“美政理想”，以“哀民多艰”与“九死不悔”，",
    "start": 635.92,
    "end": 640.48,
    "duration": 4.56
  },
  {
    "id": 156,
    "text": "剖析美政追求与献身爱国的崇高思想内核。",
    "start": 640.48,
    "end": 644.16,
    "duration": 3.68
  },
  {
    "id": 157,
    "text": "第三步是“香草美人”，以嘉卉表修洁、",
    "start": 644.4,
    "end": 647.52,
    "duration": 3.12
  },
  {
    "id": 158,
    "text": "恶草表群小、美人表君主，透析比兴手法向人格象征的伟大飞跃。",
    "start": 647.52,
    "end": 653.6,
    "duration": 6.08
  },
  {
    "id": 159,
    "text": "第四步是“虚实神游”，以天界巡游与“忽临睨夫旧乡”的骤然跌落，",
    "start": 653.6,
    "end": 659.12,
    "duration": 5.52
  },
  {
    "id": 160,
    "text": "论证现实受挫与浪漫幻想的剧烈悲剧碰撞。",
    "start": 659.12,
    "end": 662.88,
    "duration": 3.76
  },
  {
    "id": 161,
    "text": "第五步是“骚体文式”，以错落长句与“兮”字呼告长歌当哭，",
    "start": 662.88,
    "end": 667.84,
    "duration": 4.96
  },
  {
    "id": 162,
    "text": "阐明文体创新对宏大情感容量的物理支撑。",
    "start": 667.84,
    "end": 671.12,
    "duration": 3.28
  },
  {
    "id": 163,
    "text": "第六步是“风骚闭环”，把《离骚》与《诗经》并置，",
    "start": 671.36,
    "end": 674.96,
    "duration": 3.6
  },
  {
    "id": 164,
    "text": "自然引向对汉赋、盛唐李白与历代志士的永恒精神哺育。",
    "start": 674.96,
    "end": 679.68,
    "duration": 4.72
  },
  {
    "id": 165,
    "text": "这六步层层递进，前一步的结论必然成为后一步的前提。",
    "start": 679.68,
    "end": 683.84,
    "duration": 4.16
  },
  {
    "id": 166,
    "text": "你在考场上顺着因果关系顺流而下，",
    "start": 683.84,
    "end": 686.64,
    "duration": 2.8
  },
  {
    "id": 167,
    "text": "就能自然写出近千字的满分答卷。",
    "start": 686.64,
    "end": 689.04,
    "duration": 2.4
  }
]