[
  {
    "id": 1,
    "text": "试论苏轼对宋代词体发展的文学史贡献。",
    "start": 0.134,
    "end": 4.555,
    "duration": 4.421
  },
  {
    "id": 2,
    "text": "宋代词体由晚唐五代的“艳科小道”跃升为与诗并列的一代文学之胜，苏轼的革新之功最为卓著。",
    "start": 5.179,
    "end": 13.361,
    "duration": 8.182
  },
  {
    "id": 3,
    "text": "面对词体长期依附酒筵歌席、迁就乐工歌伎的狭隘格局，苏轼以文人主体意识推行“以诗为词”，",
    "start": 13.89,
    "end": 23.262,
    "duration": 9.372
  },
  {
    "id": 4,
    "text": "打破诗词分界的传统藩篱，使词从应歌娱人之具转变为独立的抒情诗体。",
    "start": 23.65,
    "end": 29.392,
    "duration": 5.742
  },
  {
    "id": 5,
    "text": "胡寅在《酒边词序》中赞其“一洗绮罗香泽之态，摆脱绸缪宛转之度，使人登高望远，举首高歌”。",
    "start": 29.921,
    "end": 37.583,
    "duration": 7.662
  },
  {
    "id": 6,
    "text": "其对词体发展的贡献，主要体现在以下四个方面：",
    "start": 38.112,
    "end": 42.084,
    "duration": 3.972
  },
  {
    "id": 7,
    "text": "第一，破除“词为艳科”成见，使词体由应歌娱人转向抒怀言志。",
    "start": 42.708,
    "end": 48.45,
    "duration": 5.742
  },
  {
    "id": 8,
    "text": "自花间、南唐至北宋初年，词作题材多局限于男女恋情与离愁别恨。",
    "start": 48.979,
    "end": 55.601,
    "duration": 6.622
  },
  {
    "id": 9,
    "text": "苏轼从理论上确立“诗词一体”之说，在《祭张子野文》中称词“盖诗之裔”，",
    "start": 56.13,
    "end": 61.462,
    "duration": 5.332
  },
  {
    "id": 10,
    "text": "力主“自是一家”，把词从歌伎口中解放出来，用来抒发士大夫的性情怀抱。",
    "start": 61.841,
    "end": 67.423,
    "duration": 5.582
  },
  {
    "id": 11,
    "text": "他将怀古、报国、悼亡、田园农村等丰富题材引入词中：",
    "start": 67.952,
    "end": 72.004,
    "duration": 4.052
  },
  {
    "id": 12,
    "text": "在密州写下“会挽雕弓如满月，西北望，射天狼”的戍边壮志；",
    "start": 72.383,
    "end": 76.595,
    "duration": 4.212
  },
  {
    "id": 13,
    "text": "悼念亡妻写出“十年生死两茫茫，不思量，自难忘”的深沉情谊；",
    "start": 77.273,
    "end": 82.285,
    "duration": 5.012
  },
  {
    "id": 14,
    "text": "在徐州农村写出“敲门试问野人家”的淳朴民风，极大拓宽了宋词的表现领域。",
    "start": 82.963,
    "end": 90.225,
    "duration": 7.262
  },
  {
    "id": 15,
    "text": "第二，广用标题与小序机制，使词境与现实生活紧密结合。",
    "start": 90.849,
    "end": 96.711,
    "duration": 5.862
  },
  {
    "id": 16,
    "text": "传统曲子词大多“有调无题”，情意指向较为宽泛。",
    "start": 97.24,
    "end": 101.822,
    "duration": 4.582
  },
  {
    "id": 17,
    "text": "苏轼借鉴诗歌作法并受张先启发，在词中广泛创用标题和小序，交代写作缘起、时地与生活场景。",
    "start": 102.351,
    "end": 111.043,
    "duration": 8.692
  },
  {
    "id": 18,
    "text": "《水调歌头》前冠以“丙辰中秋，欢饮达旦，大醉，作此篇，兼怀子由”，点明月夜怀弟之旨；",
    "start": 111.572,
    "end": 118.472,
    "duration": 6.9
  },
  {
    "id": 19,
    "text": "《定风波》前详记“三月七日，沙湖道中遇雨，雨具先去，同行皆狼狈，余独不觉”，铺垫遇雨坦然的境遇。",
    "start": 119.001,
    "end": 126.533,
    "duration": 7.532
  },
  {
    "id": 20,
    "text": "题序与词本文浑然一体，既弥补了词体不便叙事的短处，也增强了作品的纪实性与生活气息。",
    "start": 127.062,
    "end": 134.474,
    "duration": 7.412
  },
  {
    "id": 21,
    "text": "第三，融通性情怀抱与理趣哲思，开拓清旷豪迈的多样词风。",
    "start": 135.098,
    "end": 139.79,
    "duration": 4.692
  },
  {
    "id": 22,
    "text": "苏轼词风兼备清旷、豪放与婉转，全面映现其波澜起伏的人生境遇。",
    "start": 140.508,
    "end": 145.72,
    "duration": 5.212
  },
  {
    "id": 23,
    "text": "乌台诗案与贬谪黄州的挫折磨难，非但未将其压垮，反而催生出超然自适的生命哲思：",
    "start": 146.398,
    "end": 158.65,
    "duration": 12.252
  },
  {
    "id": 24,
    "text": "在定慧院中，他借“拣尽寒枝不肯栖，寂寞沙洲冷”坚守孤高节操；",
    "start": 159.368,
    "end": 160.38,
    "duration": 1.012
  },
  {
    "id": 25,
    "text": "在赤壁矶头，以“人生如梦，一尊还酹江月”排遣现实苦闷；",
    "start": 160.909,
    "end": 161.841,
    "duration": 0.932
  },
  {
    "id": 26,
    "text": "至沙湖道中，升华为“回首向来萧瑟处，归去，也无风雨也无晴”的旷达胜境。",
    "start": 162.37,
    "end": 164.702,
    "duration": 2.332
  },
  {
    "id": 27,
    "text": "苏词将儒家坚守与佛道超脱融为一体，确立了清雄旷达的士大夫词风典范。",
    "start": 165.231,
    "end": 171.243,
    "duration": 6.012
  },
  {
    "id": 28,
    "text": "第四，弱化词对音乐的依附，开启南宋辛派词人的革新路径。",
    "start": 171.921,
    "end": 178.053,
    "duration": 6.132
  },
  {
    "id": 29,
    "text": "为保障抒情自由，苏轼作词往往不喜裁剪以就声律，",
    "start": 178.731,
    "end": 180.823,
    "duration": 2.092
  },
  {
    "id": 30,
    "text": "虽曾被李清照评为“句读不葺之诗”，却拓展了词的文学表现力。",
    "start": 181.202,
    "end": 183.694,
    "duration": 2.492
  },
  {
    "id": 31,
    "text": "王灼在《碧鸡漫志》中公允指出：“东坡先生非心醉于音律者，偶尔作歌，指出向上一路，新天下耳目。”",
    "start": 184.332,
    "end": 193.744,
    "duration": 9.412
  },
  {
    "id": 32,
    "text": "苏轼通过“以诗为词”提升词的文学品位，",
    "start": 194.462,
    "end": 196.594,
    "duration": 2.132
  },
  {
    "id": 33,
    "text": "不仅确立了北宋豪放词派的基石，更直接启迪了南宋张孝祥、辛弃疾等人的“以文为词”与用经用史之风，",
    "start": 196.973,
    "end": 201.505,
    "duration": 4.532
  },
  {
    "id": 34,
    "text": "从根本上改变了宋词的发展方向。",
    "start": 201.884,
    "end": 202.896,
    "duration": 1.012
  },
  {
    "id": 35,
    "text": "综观全篇，苏轼以文人主体意识推行“以诗为词”，",
    "start": 203.534,
    "end": 209.346,
    "duration": 5.812
  },
  {
    "id": 36,
    "text": "借标题小序、旷达情怀与议论理趣破除了“词为艳科”的传统成见，",
    "start": 209.89,
    "end": 215.662,
    "duration": 5.772
  },
  {
    "id": 37,
    "text": "减弱词体对音乐歌席的狭隘依附。",
    "start": 216.041,
    "end": 218.573,
    "duration": 2.532
  },
  {
    "id": 38,
    "text": "他在不失词体音律韵致的同时提升其文学品位，",
    "start": 219.235,
    "end": 228.567,
    "duration": 9.332
  },
  {
    "id": 39,
    "text": "使词真正具备与诗并列的独立抒情地位，直接开启了南宋辛派词人的创作新途。",
    "start": 229.079,
    "end": 242.246,
    "duration": 13.167
  }
]