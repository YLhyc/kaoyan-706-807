[
  {
    "id": 1,
    "text": "试论苏轼对宋代词体发展的文学史贡献。",
    "start": 0.101,
    "end": 3.425,
    "duration": 3.324
  },
  {
    "id": 2,
    "text": "宋代词体由晚唐五代的“艳科小道”跃升为与诗并列的一代文学之胜，",
    "start": 3.781,
    "end": 9.849,
    "duration": 6.068
  },
  {
    "id": 3,
    "text": "苏轼的革新之功最为卓著。",
    "start": 10.153,
    "end": 12.178,
    "duration": 2.025
  },
  {
    "id": 4,
    "text": "面对词体长期依附酒筵歌席、迁就乐工歌伎的狭隘格局，",
    "start": 12.55,
    "end": 17.336,
    "duration": 4.786
  },
  {
    "id": 5,
    "text": "苏轼以文人主体意识推行“以诗为词”，",
    "start": 17.509,
    "end": 20.938,
    "duration": 3.429
  },
  {
    "id": 6,
    "text": "打破诗词分界的传统藩篱，",
    "start": 21.246,
    "end": 23.25,
    "duration": 2.004
  },
  {
    "id": 7,
    "text": "使词从应歌娱人之具转变为独立的抒情诗体。",
    "start": 23.529,
    "end": 27.352,
    "duration": 3.823
  },
  {
    "id": 8,
    "text": "胡寅在《酒边词序》中赞其“一洗绮罗香泽之态，",
    "start": 28.043,
    "end": 32.025,
    "duration": 3.982
  },
  {
    "id": 9,
    "text": "摆脱绸缪宛转之度，使人登高望远，举首高歌”。",
    "start": 32.339,
    "end": 36.487,
    "duration": 4.148
  },
  {
    "id": 10,
    "text": "其对词体发展的贡献，主要体现在以下四个方面：",
    "start": 37.05,
    "end": 40.505,
    "duration": 3.455
  },
  {
    "id": 11,
    "text": "第一，破除“词为艳科”成见，使词体由应歌娱人转向抒怀言志。",
    "start": 41.135,
    "end": 46.936,
    "duration": 5.801
  },
  {
    "id": 12,
    "text": "自花间、南唐至北宋初年，词作题材多局限于男女恋情与离愁别恨。",
    "start": 47.622,
    "end": 53.645,
    "duration": 6.023
  },
  {
    "id": 13,
    "text": "苏轼从理论上确立“诗词一体”之说，",
    "start": 54.102,
    "end": 56.754,
    "duration": 2.652
  },
  {
    "id": 14,
    "text": "在《祭张子野文》中称词“盖诗之裔”，力主“自是一家”，",
    "start": 57.168,
    "end": 61.778,
    "duration": 4.61
  },
  {
    "id": 15,
    "text": "把词从歌伎口中解放出来，用来抒发士大夫的性情怀抱。",
    "start": 62.019,
    "end": 66.519,
    "duration": 4.5
  },
  {
    "id": 16,
    "text": "他将怀古、报国、悼亡、田园农村等丰富题材引入词中：",
    "start": 66.858,
    "end": 72.025,
    "duration": 5.167
  },
  {
    "id": 17,
    "text": "在密州写下“会挽雕弓如满月，西北望，射天狼”的戍边壮志；",
    "start": 72.284,
    "end": 77.574,
    "duration": 5.29
  },
  {
    "id": 18,
    "text": "悼念亡妻写出“十年生死两茫茫，不思量，",
    "start": 77.866,
    "end": 81.754,
    "duration": 3.888
  },
  {
    "id": 19,
    "text": "自难忘”的深沉情谊；",
    "start": 82.02,
    "end": 83.512,
    "duration": 1.492
  },
  {
    "id": 20,
    "text": "在徐州农村写出“敲门试问野人家”的淳朴民风，",
    "start": 83.961,
    "end": 88.043,
    "duration": 4.082
  },
  {
    "id": 21,
    "text": "极大拓宽了宋词的表现领域。",
    "start": 88.457,
    "end": 90.493,
    "duration": 2.036
  },
  {
    "id": 22,
    "text": "第二，广用标题与小序机制，使词境与现实生活紧密结合。",
    "start": 91.114,
    "end": 96.02,
    "duration": 4.906
  },
  {
    "id": 23,
    "text": "传统曲子词大多“有调无题”，情意指向较为宽泛。",
    "start": 96.386,
    "end": 100.355,
    "duration": 3.969
  },
  {
    "id": 24,
    "text": "苏轼借鉴诗歌作法并受张先启发，在词中广泛创用标题和小序，",
    "start": 100.673,
    "end": 105.822,
    "duration": 5.149
  },
  {
    "id": 25,
    "text": "交代写作缘起、时地与生活场景。",
    "start": 106.074,
    "end": 108.86,
    "duration": 2.786
  },
  {
    "id": 26,
    "text": "《水调歌头》前冠以“丙辰中秋，欢饮达旦，大醉，作此篇，",
    "start": 109.256,
    "end": 114.224,
    "duration": 4.968
  },
  {
    "id": 27,
    "text": "兼怀子由”，点明月夜怀弟之旨；",
    "start": 114.464,
    "end": 117.203,
    "duration": 2.739
  },
  {
    "id": 28,
    "text": "《定风波》前详记“三月七日，沙湖道中遇雨，雨具先去，",
    "start": 117.721,
    "end": 122.538,
    "duration": 4.817
  },
  {
    "id": 29,
    "text": "同行皆狼狈，余独不觉”，铺垫遇雨坦然的境遇。",
    "start": 122.685,
    "end": 126.672,
    "duration": 3.987
  },
  {
    "id": 30,
    "text": "题序与词本文浑然一体，既弥补了词体不便叙事的短处，",
    "start": 126.896,
    "end": 131.862,
    "duration": 4.966
  },
  {
    "id": 31,
    "text": "也增强了作品的纪实性与生活气息。",
    "start": 132.162,
    "end": 134.75,
    "duration": 2.588
  },
  {
    "id": 32,
    "text": "第三，融通性情怀抱与理趣哲思，开拓清旷豪迈的多样词风。",
    "start": 135.406,
    "end": 141.184,
    "duration": 5.778
  },
  {
    "id": 33,
    "text": "苏轼词风兼备清旷、豪放与婉转，全面映现其波澜起伏的人生境遇。",
    "start": 141.698,
    "end": 147.477,
    "duration": 5.779
  },
  {
    "id": 34,
    "text": "乌台诗案与贬谪黄州的挫折磨难，非但未将其压垮，",
    "start": 147.987,
    "end": 152.279,
    "duration": 4.292
  },
  {
    "id": 35,
    "text": "反而催生出超然自适的生命哲思：在定慧院中，",
    "start": 152.604,
    "end": 156.846,
    "duration": 4.242
  },
  {
    "id": 36,
    "text": "他借“拣尽寒枝不肯栖，寂寞沙洲冷”坚守孤高节操；",
    "start": 157.168,
    "end": 162.787,
    "duration": 5.619
  },
  {
    "id": 37,
    "text": "在赤壁矶头，以“人生如梦，一尊还酹江月”排遣现实苦闷；",
    "start": 163.484,
    "end": 168.962,
    "duration": 5.478
  },
  {
    "id": 38,
    "text": "至沙湖道中，升华为“回首向来萧瑟处，归去，",
    "start": 169.566,
    "end": 174.412,
    "duration": 4.846
  },
  {
    "id": 39,
    "text": "也无风雨也无晴”的旷达胜境。",
    "start": 174.821,
    "end": 177.56,
    "duration": 2.739
  },
  {
    "id": 40,
    "text": "苏词将儒家坚守与佛道超脱融为一体，",
    "start": 177.879,
    "end": 181.406,
    "duration": 3.527
  },
  {
    "id": 41,
    "text": "确立了清雄旷达的士大夫词风典范。",
    "start": 181.841,
    "end": 184.89,
    "duration": 3.049
  },
  {
    "id": 42,
    "text": "第四，弱化词对音乐的依附，开启南宋辛派词人的革新路径。",
    "start": 185.545,
    "end": 190.867,
    "duration": 5.322
  },
  {
    "id": 43,
    "text": "为保障抒情自由，苏轼作词往往不喜裁剪以就声律，",
    "start": 191.536,
    "end": 195.907,
    "duration": 4.371
  },
  {
    "id": 44,
    "text": "虽曾被李清照评为“句读不葺之诗”，",
    "start": 196.089,
    "end": 198.965,
    "duration": 2.876
  },
  {
    "id": 45,
    "text": "却拓展了词的文学表现力。",
    "start": 199.411,
    "end": 201.176,
    "duration": 1.765
  },
  {
    "id": 46,
    "text": "王灼在《碧鸡漫志》中公允指出：“东坡先生非心醉于音律者，",
    "start": 201.701,
    "end": 206.468,
    "duration": 4.767
  },
  {
    "id": 47,
    "text": "偶尔作歌，指出向上一路，新天下耳目。",
    "start": 206.747,
    "end": 210.162,
    "duration": 3.415
  },
  {
    "id": 48,
    "text": "”苏轼通过“以诗为词”提升词的文学品位，",
    "start": 210.386,
    "end": 213.722,
    "duration": 3.336
  },
  {
    "id": 49,
    "text": "不仅确立了北宋豪放词派的基石，更直接启迪了南宋张孝祥、",
    "start": 214.215,
    "end": 219.007,
    "duration": 4.792
  },
  {
    "id": 50,
    "text": "辛弃疾等人的“以文为词”与用经用史之风，",
    "start": 219.35,
    "end": 223.128,
    "duration": 3.778
  },
  {
    "id": 51,
    "text": "从根本上改变了宋词的发展方向。",
    "start": 223.417,
    "end": 225.949,
    "duration": 2.532
  }
]