[
  {
    "id": 1,
    "text": "试论苏轼对宋代词体发展的文学史贡献。",
    "start": 0.16,
    "end": 4.56,
    "duration": 4.4
  },
  {
    "id": 2,
    "text": "宋代词体由中晚唐五代的“艳科小道”跃升为一代文学之代表，",
    "start": 4.56,
    "end": 11.12,
    "duration": 6.56
  },
  {
    "id": 3,
    "text": "苏轼的文体解放之功最为卓著。",
    "start": 11.12,
    "end": 14.56,
    "duration": 3.44
  },
  {
    "id": 4,
    "text": "面对词体长期依附于酒筵歌席、迁就乐工歌伎的狭隘格局，",
    "start": 14.56,
    "end": 20.48,
    "duration": 5.92
  },
  {
    "id": 5,
    "text": "苏轼以崇高的文人主体意识推行 “以诗为词”，",
    "start": 20.48,
    "end": 25.28,
    "duration": 4.8
  },
  {
    "id": 6,
    "text": "全面打破了诗词分界的传统藩篱，",
    "start": 25.28,
    "end": 29.12,
    "duration": 3.84
  },
  {
    "id": 7,
    "text": "推动词体由娱人小道转变为与古诗平起平坐的独立抒情文体。",
    "start": 29.12,
    "end": 35.2,
    "duration": 6.08
  },
  {
    "id": 8,
    "text": "胡寅在 《酒边词序》 中赞其 “一洗绮罗香泽之态，",
    "start": 35.2,
    "end": 40.56,
    "duration": 5.36
  },
  {
    "id": 9,
    "text": "摆脱绸缪宛转之度，使人登高望远，举首高歌”。",
    "start": 40.56,
    "end": 44.96,
    "duration": 4.4
  },
  {
    "id": 10,
    "text": "其对词体文学发展的历史贡献，主要展现为以下四个核心维度：",
    "start": 44.96,
    "end": 51.2,
    "duration": 6.24
  },
  {
    "id": 11,
    "text": "第一，破除“词为艳科”传统，实现词体表现功能的案头言志转向。",
    "start": 51.2,
    "end": 58.16,
    "duration": 6.96
  },
  {
    "id": 12,
    "text": "自花间、南唐至北宋初年，",
    "start": 58.16,
    "end": 60.72,
    "duration": 2.56
  },
  {
    "id": 13,
    "text": "词作题材长期局限于闺怨相思与尊前欢谑，",
    "start": 60.72,
    "end": 64.64,
    "duration": 3.92
  },
  {
    "id": 14,
    "text": "文人内心严肃的政治抱负与人生哲思无法登堂入室。",
    "start": 64.72,
    "end": 69.84,
    "duration": 5.12
  },
  {
    "id": 15,
    "text": "苏轼从观念上确立“诗词一体”之说，指出词是“诗之苗裔”，",
    "start": 69.84,
    "end": 76.4,
    "duration": 6.56
  },
  {
    "id": 16,
    "text": "把词从歌女口中解放出来给士大夫案头阅读。",
    "start": 76.4,
    "end": 81.2,
    "duration": 4.8
  },
  {
    "id": 17,
    "text": "他将怀古、报国、悼亡、农村田园等宏大母题全面注入词中：",
    "start": 81.36,
    "end": 88.48,
    "duration": 7.12
  },
  {
    "id": 18,
    "text": "在密州写下 “会挽雕弓如满月，西北望，",
    "start": 88.48,
    "end": 92.64,
    "duration": 4.16
  },
  {
    "id": 19,
    "text": "射天狼” 的戍边雄心；",
    "start": 92.64,
    "end": 94.32,
    "duration": 1.68
  },
  {
    "id": 20,
    "text": "在悼念亡妻时写出 “十年生死两茫茫，不思量，",
    "start": 94.56,
    "end": 98.96,
    "duration": 4.4
  },
  {
    "id": 21,
    "text": "自难忘” 的深沉人伦；",
    "start": 98.96,
    "end": 101.52,
    "duration": 2.56
  },
  {
    "id": 22,
    "text": "在徐州农村写出 “敲门试问野人家” 的淳朴风貌。",
    "start": 101.52,
    "end": 106.08,
    "duration": 4.56
  },
  {
    "id": 23,
    "text": "这种题材的大幅度拓宽，彻底撕碎了词为艳科的狭隘格局。",
    "start": 106.08,
    "end": 112.72,
    "duration": 6.64
  },
  {
    "id": 24,
    "text": "第二，首创题序小传机制，确立叙事与抒情深度融合的篇章结构。",
    "start": 112.72,
    "end": 119.68,
    "duration": 6.96
  },
  {
    "id": 25,
    "text": "传统曲子词往往“有调无题”，情意模糊泛化。",
    "start": 119.68,
    "end": 124.96,
    "duration": 5.28
  },
  {
    "id": 26,
    "text": "苏轼借鉴近体诗作法，大量在词前创设长短题序，",
    "start": 124.96,
    "end": 130.16,
    "duration": 5.2
  },
  {
    "id": 27,
    "text": "以纪实笔法交代创作缘起、时间、地点与生活细节。",
    "start": 130.16,
    "end": 135.36,
    "duration": 5.2
  },
  {
    "id": 28,
    "text": "在 《水调歌头》 前以“丙辰中秋，欢饮达旦，大醉，",
    "start": 135.36,
    "end": 140.24,
    "duration": 4.88
  },
  {
    "id": 29,
    "text": "作此篇兼怀子由”交代本事；",
    "start": 140.24,
    "end": 142.88,
    "duration": 2.64
  },
  {
    "id": 30,
    "text": "在 《定风波》 前以“三月七日沙湖道中遇雨，雨具先去，",
    "start": 142.88,
    "end": 148.64,
    "duration": 5.76
  },
  {
    "id": 31,
    "text": "同行皆狼狈，余独不觉”铺叙生活波澜。",
    "start": 148.88,
    "end": 152.48,
    "duration": 3.6
  },
  {
    "id": 32,
    "text": "题序小传与正文词句互为表里，",
    "start": 152.848,
    "end": 155.648,
    "duration": 2.8
  },
  {
    "id": 33,
    "text": "使词体不仅具备了交代复杂事件的记实能力，",
    "start": 155.648,
    "end": 159.568,
    "duration": 3.92
  },
  {
    "id": 34,
    "text": "更营造出浓郁的生活现场感与历史真实感。",
    "start": 159.568,
    "end": 163.248,
    "duration": 3.68
  },
  {
    "id": 35,
    "text": "第三，以知人论世为心灵轴线，",
    "start": 163.248,
    "end": 165.888,
    "duration": 2.64
  },
  {
    "id": 36,
    "text": "构筑以旷达自适为主的多样化美学风貌。",
    "start": 165.888,
    "end": 170.128,
    "duration": 4.24
  },
  {
    "id": 37,
    "text": "苏轼之词绝非单一维度的豪迈，",
    "start": 170.368,
    "end": 173.488,
    "duration": 3.12
  },
  {
    "id": 38,
    "text": "而是其波澜起伏的人生心灵全息图景。",
    "start": 173.488,
    "end": 177.808,
    "duration": 4.32
  },
  {
    "id": 39,
    "text": "乌台诗案牢狱之灾与贬谪黄州的人生绝境，",
    "start": 177.808,
    "end": 182.208,
    "duration": 4.4
  },
  {
    "id": 40,
    "text": "不仅未曾将其精神压垮，反而逼发出超越苦难的生命哲思。",
    "start": 182.208,
    "end": 188.608,
    "duration": 6.4
  },
  {
    "id": 41,
    "text": "在定慧院中，他借 “拣尽寒枝不肯栖，",
    "start": 188.608,
    "end": 192.368,
    "duration": 3.76
  },
  {
    "id": 42,
    "text": "寂寞沙洲冷” 坚守孤高人格；在赤壁矶头，",
    "start": 192.368,
    "end": 196.688,
    "duration": 4.32
  },
  {
    "id": 43,
    "text": "他以 “人生如梦，一尊还酹江月” 消解现实得失；",
    "start": 196.688,
    "end": 201.888,
    "duration": 5.2
  },
  {
    "id": 44,
    "text": "至沙湖道中，最终升华为 “回首向来萧瑟处，归去，",
    "start": 201.888,
    "end": 206.848,
    "duration": 4.96
  },
  {
    "id": 45,
    "text": "也无风雨也无晴” 的超然胜境。",
    "start": 207.168,
    "end": 210.048,
    "duration": 2.88
  },
  {
    "id": 46,
    "text": "其词将道家随顺自适与佛禅理趣化解于儒家坚守之中，",
    "start": 210.048,
    "end": 215.408,
    "duration": 5.36
  },
  {
    "id": 47,
    "text": "确立了清旷雄健的士大夫审美典范。",
    "start": 215.408,
    "end": 219.888,
    "duration": 4.48
  },
  {
    "id": 48,
    "text": "第四，解放文体声律拘牵，直接启迪南宋辛派词人的英雄悲歌。",
    "start": 219.888,
    "end": 225.648,
    "duration": 5.76
  },
  {
    "id": 49,
    "text": "为了保障抒情自由，苏轼敢于为了表达意气而适度破律，",
    "start": 225.648,
    "end": 230.848,
    "duration": 5.2
  },
  {
    "id": 50,
    "text": "引发了李清照“句读不葺之诗”的文体辨析，",
    "start": 230.848,
    "end": 233.488,
    "duration": 2.64
  },
  {
    "id": 51,
    "text": "但王灼在 《碧鸡漫志》 中客观定评：",
    "start": 233.328,
    "end": 233.488,
    "duration": 0.16
  },
  {
    "id": 52,
    "text": "“东坡先生非心醉于音律者，偶尔作歌，指出向上一路，",
    "start": 233.328,
    "end": 233.488,
    "duration": 0.16
  },
  {
    "id": 53,
    "text": "新天下耳目。",
    "start": 233.328,
    "end": 233.488,
    "duration": 0.16
  },
  {
    "id": 54,
    "text": "” 苏轼使词走向诗意化与哲理化，",
    "start": 233.328,
    "end": 233.488,
    "duration": 0.16
  },
  {
    "id": 55,
    "text": "不仅确立了北宋豪放词派的宏大基石，",
    "start": 233.328,
    "end": 233.488,
    "duration": 0.16
  },
  {
    "id": 56,
    "text": "更直接启迪了南宋辛弃疾以文为词、融经铸史的艺术突围，",
    "start": 233.328,
    "end": 233.488,
    "duration": 0.16
  },
  {
    "id": 57,
    "text": "共同将宋词推向了古典抒情文学的至高殿堂。",
    "start": 233.328,
    "end": 233.488,
    "duration": 0.16
  }
]