[
  {
    "id": 1,
    "text": "试论苏轼对宋代词体发展的文学史贡献。",
    "start": 0.08,
    "end": 3.769,
    "duration": 3.689
  },
  {
    "id": 2,
    "text": "宋代词体由中晚唐五代的“艳科小道”跃升为一代文学之代表，",
    "start": 4.378,
    "end": 9.948,
    "duration": 5.57
  },
  {
    "id": 3,
    "text": "苏轼的文体解放之功最为卓著。",
    "start": 10.402,
    "end": 12.958,
    "duration": 2.556
  },
  {
    "id": 4,
    "text": "面对词体长期依附于酒筵歌席、迁就乐工歌伎的狭隘格局，",
    "start": 13.54,
    "end": 18.641,
    "duration": 5.101
  },
  {
    "id": 5,
    "text": "苏轼以崇高的文人主体意识推行 “以诗为词”，",
    "start": 19.129,
    "end": 23.111,
    "duration": 3.982
  },
  {
    "id": 6,
    "text": "全面打破了诗词分界的传统藩篱，",
    "start": 23.364,
    "end": 26.105,
    "duration": 2.741
  },
  {
    "id": 7,
    "text": "推动词体由娱人小道转变为与古诗平起平坐的独立抒情文体。",
    "start": 26.338,
    "end": 32.235,
    "duration": 5.897
  },
  {
    "id": 8,
    "text": "胡寅在 《酒边词序》 中赞其 “一洗绮罗香泽之态，",
    "start": 32.416,
    "end": 36.739,
    "duration": 4.323
  },
  {
    "id": 9,
    "text": "摆脱绸缪宛转之度，使人登高望远，举首高歌”。",
    "start": 36.791,
    "end": 41.058,
    "duration": 4.267
  },
  {
    "id": 10,
    "text": "其对词体文学发展的历史贡献，主要展现为以下四个核心维度：",
    "start": 41.247,
    "end": 46.138,
    "duration": 4.891
  },
  {
    "id": 11,
    "text": "第一，破除“词为艳科”传统，实现词体表现功能的案头言志转向。",
    "start": 46.389,
    "end": 51.826,
    "duration": 5.437
  },
  {
    "id": 12,
    "text": "自花间、南唐至北宋初年，",
    "start": 52.023,
    "end": 54.483,
    "duration": 2.46
  },
  {
    "id": 13,
    "text": "词作题材长期局限于闺怨相思与尊前欢谑，",
    "start": 54.825,
    "end": 58.432,
    "duration": 3.607
  },
  {
    "id": 14,
    "text": "文人内心严肃的政治抱负与人生哲思无法登堂入室。",
    "start": 58.954,
    "end": 62.886,
    "duration": 3.932
  },
  {
    "id": 15,
    "text": "苏轼从观念上确立“诗词一体”之说，指出词是“诗之苗裔”，",
    "start": 63.16,
    "end": 68.081,
    "duration": 4.921
  },
  {
    "id": 16,
    "text": "把词从歌女口中解放出来给士大夫案头阅读。",
    "start": 68.204,
    "end": 71.689,
    "duration": 3.485
  },
  {
    "id": 17,
    "text": "他将怀古、报国、悼亡、农村田园等宏大母题全面注入词中：",
    "start": 71.938,
    "end": 77.388,
    "duration": 5.45
  },
  {
    "id": 18,
    "text": "在密州写下 “会挽雕弓如满月，西北望，",
    "start": 77.573,
    "end": 81.272,
    "duration": 3.699
  },
  {
    "id": 19,
    "text": "射天狼” 的戍边雄心；",
    "start": 81.305,
    "end": 83.191,
    "duration": 1.886
  },
  {
    "id": 20,
    "text": "在悼念亡妻时写出 “十年生死两茫茫，不思量，",
    "start": 83.465,
    "end": 88.274,
    "duration": 4.809
  },
  {
    "id": 21,
    "text": "自难忘” 的深沉人伦；",
    "start": 88.295,
    "end": 90.137,
    "duration": 1.842
  },
  {
    "id": 22,
    "text": "在徐州农村写出 “敲门试问野人家” 的淳朴风貌。",
    "start": 90.399,
    "end": 94.377,
    "duration": 3.978
  },
  {
    "id": 23,
    "text": "这种题材的大幅度拓宽，彻底撕碎了词为艳科的狭隘格局。",
    "start": 94.571,
    "end": 99.552,
    "duration": 4.981
  },
  {
    "id": 24,
    "text": "第二，首创题序小传机制，确立叙事与抒情深度融合的篇章结构。",
    "start": 99.84,
    "end": 105.589,
    "duration": 5.749
  },
  {
    "id": 25,
    "text": "传统曲子词往往“有调无题”，情意模糊泛化。",
    "start": 105.871,
    "end": 110.036,
    "duration": 4.165
  },
  {
    "id": 26,
    "text": "苏轼借鉴近体诗作法，大量在词前创设长短题序，",
    "start": 110.503,
    "end": 114.845,
    "duration": 4.342
  },
  {
    "id": 27,
    "text": "以纪实笔法交代创作缘起、时间、地点与生活细节。",
    "start": 115.174,
    "end": 119.898,
    "duration": 4.724
  },
  {
    "id": 28,
    "text": "在 《水调歌头》 前以“丙辰中秋，欢饮达旦，大醉，",
    "start": 120.105,
    "end": 124.35,
    "duration": 4.245
  },
  {
    "id": 29,
    "text": "作此篇兼怀子由”交代本事；",
    "start": 124.35,
    "end": 126.812,
    "duration": 2.462
  },
  {
    "id": 30,
    "text": "在 《定风波》 前以“三月七日沙湖道中遇雨，雨具先去，",
    "start": 127.101,
    "end": 131.661,
    "duration": 4.56
  },
  {
    "id": 31,
    "text": "同行皆狼狈，余独不觉”铺叙生活波澜。",
    "start": 131.723,
    "end": 134.68,
    "duration": 2.957
  },
  {
    "id": 32,
    "text": "题序小传与正文词句互为表里，",
    "start": 135.194,
    "end": 137.861,
    "duration": 2.667
  },
  {
    "id": 33,
    "text": "使词体不仅具备了交代复杂事件的记实能力，",
    "start": 138.257,
    "end": 141.85,
    "duration": 3.593
  },
  {
    "id": 34,
    "text": "更营造出浓郁的生活现场感与历史真实感。",
    "start": 141.942,
    "end": 145.36,
    "duration": 3.418
  },
  {
    "id": 35,
    "text": "第三，以知人论世为心灵轴线，",
    "start": 145.622,
    "end": 148.71,
    "duration": 3.088
  },
  {
    "id": 36,
    "text": "构筑以旷达自适为主的多样化美学风貌。",
    "start": 148.952,
    "end": 152.54,
    "duration": 3.588
  },
  {
    "id": 37,
    "text": "苏轼之词绝非单一维度的豪迈，",
    "start": 152.774,
    "end": 155.165,
    "duration": 2.391
  },
  {
    "id": 38,
    "text": "而是其波澜起伏的人生心灵全息图景。",
    "start": 155.512,
    "end": 158.385,
    "duration": 2.873
  },
  {
    "id": 39,
    "text": "乌台诗案牢狱之灾与贬谪黄州的人生绝境，",
    "start": 158.757,
    "end": 162.004,
    "duration": 3.247
  },
  {
    "id": 40,
    "text": "不仅未曾将其精神压垮，反而逼发出超越苦难的生命哲思。",
    "start": 162.171,
    "end": 167.014,
    "duration": 4.843
  },
  {
    "id": 41,
    "text": "在定慧院中，他借 “拣尽寒枝不肯栖，",
    "start": 167.07,
    "end": 170.398,
    "duration": 3.328
  },
  {
    "id": 42,
    "text": "寂寞沙洲冷” 坚守孤高人格；在赤壁矶头，",
    "start": 170.455,
    "end": 173.971,
    "duration": 3.516
  },
  {
    "id": 43,
    "text": "他以 “人生如梦，一尊还酹江月” 消解现实得失；",
    "start": 174.037,
    "end": 178.419,
    "duration": 4.382
  },
  {
    "id": 44,
    "text": "至沙湖道中，最终升华为 “回首向来萧瑟处，归去，",
    "start": 178.655,
    "end": 183.183,
    "duration": 4.528
  },
  {
    "id": 45,
    "text": "也无风雨也无晴” 的超然胜境。",
    "start": 183.468,
    "end": 185.841,
    "duration": 2.373
  },
  {
    "id": 46,
    "text": "其词将道家随顺自适与佛禅理趣化解于儒家坚守之中，",
    "start": 186.219,
    "end": 191.411,
    "duration": 5.192
  },
  {
    "id": 47,
    "text": "确立了清旷雄健的士大夫审美典范。",
    "start": 191.432,
    "end": 194.305,
    "duration": 2.873
  },
  {
    "id": 48,
    "text": "第四，解放文体声律拘牵，直接启迪南宋辛派词人的英雄悲歌。",
    "start": 194.466,
    "end": 200.365,
    "duration": 5.899
  },
  {
    "id": 49,
    "text": "为了保障抒情自由，苏轼敢于为了表达意气而适度破律，",
    "start": 201.026,
    "end": 205.591,
    "duration": 4.565
  },
  {
    "id": 50,
    "text": "引发了李清照“句读不葺之诗”的文体辨析，",
    "start": 205.981,
    "end": 209.24,
    "duration": 3.259
  },
  {
    "id": 51,
    "text": "但王灼在 《碧鸡漫志》 中客观定评：",
    "start": 209.55,
    "end": 212.189,
    "duration": 2.639
  },
  {
    "id": 52,
    "text": "“东坡先生非心醉于音律者，偶尔作歌，指出向上一路，",
    "start": 212.531,
    "end": 217.357,
    "duration": 4.826
  },
  {
    "id": 53,
    "text": "新天下耳目。",
    "start": 217.536,
    "end": 218.706,
    "duration": 1.17
  },
  {
    "id": 54,
    "text": "” 苏轼使词走向诗意化与哲理化，",
    "start": 218.933,
    "end": 221.58,
    "duration": 2.647
  },
  {
    "id": 55,
    "text": "不仅确立了北宋豪放词派的宏大基石，",
    "start": 221.789,
    "end": 224.985,
    "duration": 3.196
  },
  {
    "id": 56,
    "text": "更直接启迪了南宋辛弃疾以文为词、融经铸史的艺术突围，",
    "start": 225.144,
    "end": 229.945,
    "duration": 4.801
  },
  {
    "id": 57,
    "text": "共同将宋词推向了古典抒情文学的至高殿堂。",
    "start": 230.197,
    "end": 233.784,
    "duration": 3.587
  }
]
