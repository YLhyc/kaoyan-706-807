[
  {
    "id": 1,
    "text": "试论苏轼对宋代词体发展的文学史贡献。",
    "start": 0.0,
    "end": 4.421,
    "duration": 4.421
  },
  {
    "id": 2,
    "text": "宋代词体由中晚唐五代的“艳科小道”跃升为一代文学之代表，",
    "start": 4.421,
    "end": 10.444,
    "duration": 6.023
  },
  {
    "id": 3,
    "text": "苏轼的文体解放之功最为卓著。",
    "start": 10.444,
    "end": 13.581,
    "duration": 3.137
  },
  {
    "id": 4,
    "text": "面对词体长期依附于酒筵歌席、迁就乐工歌伎的狭隘格局，",
    "start": 13.581,
    "end": 19.176,
    "duration": 5.595
  },
  {
    "id": 5,
    "text": "苏轼以崇高的文人主体意识推行 “以诗为词”，",
    "start": 19.176,
    "end": 23.406,
    "duration": 4.23
  },
  {
    "id": 6,
    "text": "全面打破了诗词分界的传统藩篱，",
    "start": 23.406,
    "end": 26.379,
    "duration": 2.973
  },
  {
    "id": 7,
    "text": "推动词体由娱人小道转变为与古诗平起平坐的独立抒情文体。",
    "start": 26.379,
    "end": 32.465,
    "duration": 6.086
  },
  {
    "id": 8,
    "text": "胡寅在 《酒边词序》 中赞其 “一洗绮罗香泽之态，",
    "start": 32.465,
    "end": 36.831,
    "duration": 4.366
  },
  {
    "id": 9,
    "text": "摆脱绸缪宛转之度，使人登高望远，举首高歌”。",
    "start": 36.831,
    "end": 41.295,
    "duration": 4.464
  },
  {
    "id": 10,
    "text": "其对词体文学发展的历史贡献，主要展现为以下四个核心维度：",
    "start": 41.295,
    "end": 46.978,
    "duration": 5.683
  },
  {
    "id": 11,
    "text": "第一，破除“词为艳科”传统，实现词体表现功能的案头言志转向。",
    "start": 46.978,
    "end": 54.869,
    "duration": 7.891
  },
  {
    "id": 12,
    "text": "自花间、南唐至北宋初年，",
    "start": 54.869,
    "end": 58.994,
    "duration": 4.125
  },
  {
    "id": 13,
    "text": "词作题材长期局限于闺怨相思与尊前欢谑，",
    "start": 58.994,
    "end": 61.88,
    "duration": 2.886
  },
  {
    "id": 14,
    "text": "文人内心严肃的政治抱负与人生哲思无法登堂入室。",
    "start": 61.88,
    "end": 66.124,
    "duration": 4.244
  },
  {
    "id": 15,
    "text": "苏轼从观念上确立“诗词一体”之说，指出词是“诗之苗裔”，",
    "start": 66.124,
    "end": 71.979,
    "duration": 5.855
  },
  {
    "id": 16,
    "text": "把词从歌女口中解放出来给士大夫案头阅读。",
    "start": 71.979,
    "end": 76.129,
    "duration": 4.15
  },
  {
    "id": 17,
    "text": "他将怀古、报国、悼亡、农村田园等宏大母题全面注入词中：",
    "start": 76.129,
    "end": 83.759,
    "duration": 7.63
  },
  {
    "id": 18,
    "text": "在密州写下 “会挽雕弓如满月，西北望，",
    "start": 83.759,
    "end": 87.667,
    "duration": 3.908
  },
  {
    "id": 19,
    "text": "射天狼” 的戍边雄心；",
    "start": 87.667,
    "end": 90.439,
    "duration": 2.772
  },
  {
    "id": 20,
    "text": "在悼念亡妻时写出 “十年生死两茫茫，不思量，",
    "start": 90.439,
    "end": 94.611,
    "duration": 4.172
  },
  {
    "id": 21,
    "text": "自难忘” 的深沉人伦；",
    "start": 94.611,
    "end": 96.694,
    "duration": 2.083
  },
  {
    "id": 22,
    "text": "在徐州农村写出 “敲门试问野人家” 的淳朴风貌。",
    "start": 96.694,
    "end": 102.604,
    "duration": 5.91
  },
  {
    "id": 23,
    "text": "这种题材的大幅度拓宽，彻底撕碎了词为艳科的狭隘格局。",
    "start": 102.604,
    "end": 108.711,
    "duration": 6.107
  },
  {
    "id": 24,
    "text": "第二，首创题序小传机制，确立叙事与抒情深度融合的篇章结构。",
    "start": 108.711,
    "end": 115.214,
    "duration": 6.503
  },
  {
    "id": 25,
    "text": "传统曲子词往往“有调无题”，情意模糊泛化。",
    "start": 115.214,
    "end": 121.659,
    "duration": 6.445
  },
  {
    "id": 26,
    "text": "苏轼借鉴近体诗作法，大量在词前创设长短题序，",
    "start": 121.659,
    "end": 127.141,
    "duration": 5.482
  },
  {
    "id": 27,
    "text": "以纪实笔法交代创作缘起、时间、地点与生活细节。",
    "start": 127.141,
    "end": 130.905,
    "duration": 3.764
  },
  {
    "id": 28,
    "text": "在 《水调歌头》 前以“丙辰中秋，欢饮达旦，大醉，",
    "start": 130.905,
    "end": 135.234,
    "duration": 4.329
  },
  {
    "id": 29,
    "text": "作此篇兼怀子由”交代本事；",
    "start": 135.234,
    "end": 138.303,
    "duration": 3.069
  },
  {
    "id": 30,
    "text": "在 《定风波》 前以“三月七日沙湖道中遇雨，雨具先去，",
    "start": 138.303,
    "end": 144.349,
    "duration": 6.046
  },
  {
    "id": 31,
    "text": "同行皆狼狈，余独不觉”铺叙生活波澜。",
    "start": 144.349,
    "end": 148.992,
    "duration": 4.643
  },
  {
    "id": 32,
    "text": "题序小传与正文词句互为表里，",
    "start": 148.992,
    "end": 151.346,
    "duration": 2.354
  },
  {
    "id": 33,
    "text": "使词体不仅具备了交代复杂事件的记实能力，",
    "start": 151.346,
    "end": 155.552,
    "duration": 4.206
  },
  {
    "id": 34,
    "text": "更营造出浓郁的生活现场感与历史真实感。",
    "start": 155.552,
    "end": 158.797,
    "duration": 3.245
  },
  {
    "id": 35,
    "text": "第三，以知人论世为心灵轴线，",
    "start": 158.797,
    "end": 162.379,
    "duration": 3.582
  },
  {
    "id": 36,
    "text": "构筑以旷达自适为主的多样化美学风貌。",
    "start": 162.379,
    "end": 167.111,
    "duration": 4.732
  },
  {
    "id": 37,
    "text": "苏轼之词绝非单一维度的豪迈，",
    "start": 167.111,
    "end": 170.495,
    "duration": 3.384
  },
  {
    "id": 38,
    "text": "而是其波澜起伏的人生心灵全息图景。",
    "start": 170.495,
    "end": 172.917,
    "duration": 2.422
  },
  {
    "id": 39,
    "text": "乌台诗案牢狱之灾与贬谪黄州的人生绝境，",
    "start": 172.917,
    "end": 177.106,
    "duration": 4.189
  },
  {
    "id": 40,
    "text": "不仅未曾将其精神压垮，反而逼发出超越苦难的生命哲思。",
    "start": 177.106,
    "end": 183.508,
    "duration": 6.402
  },
  {
    "id": 41,
    "text": "在定慧院中，他借 “拣尽寒枝不肯栖，",
    "start": 183.508,
    "end": 188.355,
    "duration": 4.847
  },
  {
    "id": 42,
    "text": "寂寞沙洲冷” 坚守孤高人格；在赤壁矶头，",
    "start": 188.355,
    "end": 191.278,
    "duration": 2.923
  },
  {
    "id": 43,
    "text": "他以 “人生如梦，一尊还酹江月” 消解现实得失；",
    "start": 191.278,
    "end": 197.247,
    "duration": 5.969
  },
  {
    "id": 44,
    "text": "至沙湖道中，最终升华为 “回首向来萧瑟处，归去，",
    "start": 197.247,
    "end": 202.617,
    "duration": 5.37
  },
  {
    "id": 45,
    "text": "也无风雨也无晴” 的超然胜境。",
    "start": 202.617,
    "end": 206.021,
    "duration": 3.404
  },
  {
    "id": 46,
    "text": "其词将道家随顺自适与佛禅理趣化解于儒家坚守之中，",
    "start": 206.021,
    "end": 207.246,
    "duration": 1.225
  },
  {
    "id": 47,
    "text": "确立了清旷雄健的士大夫审美典范。",
    "start": 207.246,
    "end": 209.59,
    "duration": 2.344
  },
  {
    "id": 48,
    "text": "第四，解放文体声律拘牵，直接启迪南宋辛派词人的英雄悲歌。",
    "start": 209.59,
    "end": 212.571,
    "duration": 2.981
  },
  {
    "id": 49,
    "text": "为了保障抒情自由，苏轼敢于为了表达意气而适度破律，",
    "start": 212.571,
    "end": 214.943,
    "duration": 2.372
  },
  {
    "id": 50,
    "text": "引发了李清照“句读不葺之诗”的文体辨析，",
    "start": 214.943,
    "end": 216.071,
    "duration": 1.128
  },
  {
    "id": 51,
    "text": "但王灼在 《碧鸡漫志》 中客观定评：",
    "start": 216.071,
    "end": 217.576,
    "duration": 1.505
  },
  {
    "id": 52,
    "text": "“东坡先生非心醉于音律者，偶尔作歌，指出向上一路，",
    "start": 217.576,
    "end": 218.976,
    "duration": 1.4
  },
  {
    "id": 53,
    "text": "新天下耳目。",
    "start": 218.976,
    "end": 221.829,
    "duration": 2.853
  },
  {
    "id": 54,
    "text": "” 苏轼使词走向诗意化与哲理化，",
    "start": 221.829,
    "end": 222.86,
    "duration": 1.031
  },
  {
    "id": 55,
    "text": "不仅确立了北宋豪放词派的宏大基石，",
    "start": 222.86,
    "end": 225.184,
    "duration": 2.324
  },
  {
    "id": 56,
    "text": "更直接启迪了南宋辛弃疾以文为词、融经铸史的艺术突围，",
    "start": 225.184,
    "end": 230.237,
    "duration": 5.053
  },
  {
    "id": 57,
    "text": "共同将宋词推向了古典抒情文学的至高殿堂。",
    "start": 230.237,
    "end": 233.546,
    "duration": 3.309
  }
]