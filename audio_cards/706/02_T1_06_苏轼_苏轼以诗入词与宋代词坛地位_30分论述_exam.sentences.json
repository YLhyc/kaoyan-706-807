[
  {
    "id": "sent_1",
    "text": "宋代词体由中晚唐五代的“艳科小道”跃升为一代文学之代表，",
    "start": 0.1,
    "end": 5.87,
    "duration": 5.77
  },
  {
    "id": "sent_2",
    "text": "苏轼的文体解放之功最为卓著。",
    "start": 5.82,
    "end": 9.062,
    "duration": 3.242
  },
  {
    "id": "sent_3",
    "text": "面对词体长期依附于酒筵歌席、迁就乐工歌伎的狭隘格局，",
    "start": 9.063,
    "end": 14.727,
    "duration": 5.664
  },
  {
    "id": "sent_4",
    "text": "苏轼以崇高的文人主体意识推行 “以诗为词”，",
    "start": 14.727,
    "end": 19.102,
    "duration": 4.375
  },
  {
    "id": "sent_5",
    "text": "全面打破了诗词分界的传统藩篱，",
    "start": 19.102,
    "end": 22.383,
    "duration": 3.281
  },
  {
    "id": "sent_6",
    "text": "推动词体由娱人小道转变为与古诗平起平坐的独立抒情文体。",
    "start": 22.383,
    "end": 28.112,
    "duration": 5.729
  },
  {
    "id": "sent_7",
    "text": "胡寅在 《酒边词序》 中赞其 “一洗绮罗香泽之态，",
    "start": 28.112,
    "end": 32.513,
    "duration": 4.401
  },
  {
    "id": "sent_8",
    "text": "摆脱绸缪宛转之度，使人登高望远，举首高歌”。",
    "start": 32.513,
    "end": 37.201,
    "duration": 4.688
  },
  {
    "id": "sent_9",
    "text": "其对词体文学发展的历史贡献，主要展现为以下四个核心维度：",
    "start": 37.201,
    "end": 43.021,
    "duration": 5.82
  },
  {
    "id": "sent_10",
    "text": "第一，破除“词为艳科”传统，实现词体表现功能的案头言志转向。",
    "start": 43.021,
    "end": 49.271,
    "duration": 6.25
  },
  {
    "id": "sent_11",
    "text": "自花间、南唐至北宋初年，词作题材长期局限于闺怨相思与尊前欢谑，",
    "start": 49.271,
    "end": 56.511,
    "duration": 7.24
  },
  {
    "id": "sent_12",
    "text": "文人内心严肃的政治抱负与人生哲思无法登堂入室。",
    "start": 56.51,
    "end": 61.38,
    "duration": 4.87
  },
  {
    "id": "sent_13",
    "text": "苏轼从观念上确立“诗词一体”之说，指出词是“诗之苗裔”，",
    "start": 61.38,
    "end": 66.784,
    "duration": 5.404
  },
  {
    "id": "sent_14",
    "text": "把词从歌女口中解放出来给士大夫案头阅读。",
    "start": 66.784,
    "end": 71.38,
    "duration": 4.596
  },
  {
    "id": "sent_15",
    "text": "他将怀古、报国、悼亡、农村田园等宏大母题全面注入词中：",
    "start": 71.38,
    "end": 77.787,
    "duration": 6.407
  },
  {
    "id": "sent_16",
    "text": "在密州写下 “会挽雕弓如满月，西北望，射天狼” 的戍边雄心；",
    "start": 77.786,
    "end": 83.515,
    "duration": 5.729
  },
  {
    "id": "sent_17",
    "text": "在悼念亡妻时写出 “十年生死两茫茫，不思量，",
    "start": 83.516,
    "end": 88.164,
    "duration": 4.648
  },
  {
    "id": "sent_18",
    "text": "自难忘” 的深沉人伦；",
    "start": 88.164,
    "end": 90.534,
    "duration": 2.37
  },
  {
    "id": "sent_19",
    "text": "在徐州农村写出 “敲门试问野人家” 的淳朴风貌。",
    "start": 90.534,
    "end": 94.961,
    "duration": 4.427
  },
  {
    "id": "sent_20",
    "text": "这种题材的大幅度拓宽，彻底撕碎了词为艳科的狭隘格局。",
    "start": 94.961,
    "end": 100.56,
    "duration": 5.599
  },
  {
    "id": "sent_21",
    "text": "第二，首创题序小传机制，确立叙事与抒情深度融合的篇章结构。",
    "start": 100.56,
    "end": 106.966,
    "duration": 6.406
  },
  {
    "id": "sent_22",
    "text": "传统曲子词往往“有调无题”，情意模糊泛化。",
    "start": 106.966,
    "end": 111.328,
    "duration": 4.362
  },
  {
    "id": "sent_23",
    "text": "苏轼借鉴近体诗作法，大量在词前创设长短题序，",
    "start": 111.328,
    "end": 116.107,
    "duration": 4.779
  },
  {
    "id": "sent_24",
    "text": "以纪实笔法交代创作缘起、时间、地点与生活细节。",
    "start": 116.107,
    "end": 121.498,
    "duration": 5.391
  },
  {
    "id": "sent_25",
    "text": "在 《水调歌头》 前以“丙辰中秋，欢饮达旦，大醉，",
    "start": 121.497,
    "end": 126.367,
    "duration": 4.87
  },
  {
    "id": "sent_26",
    "text": "作此篇兼怀子由”交代本事；",
    "start": 126.367,
    "end": 129.466,
    "duration": 3.099
  },
  {
    "id": "sent_27",
    "text": "在 《定风波》 前以“三月七日沙湖道中遇雨，雨具先去，",
    "start": 129.466,
    "end": 134.349,
    "duration": 4.883
  },
  {
    "id": "sent_28",
    "text": "同行皆狼狈，余独不觉”铺叙生活波澜。",
    "start": 134.349,
    "end": 138.359,
    "duration": 4.01
  },
  {
    "id": "sent_29",
    "text": "题序小传与正文词句互为表里，",
    "start": 138.359,
    "end": 141.744,
    "duration": 3.385
  },
  {
    "id": "sent_30",
    "text": "使词体不仅具备了交代复杂事件的记实能力，",
    "start": 141.745,
    "end": 146.068,
    "duration": 4.323
  },
  {
    "id": "sent_31",
    "text": "更营造出浓郁的生活现场感与历史真实感。",
    "start": 146.068,
    "end": 150.378,
    "duration": 4.31
  },
  {
    "id": "sent_32",
    "text": "第三，以知人论世为心灵轴线，构筑以旷达自适为主的多样化美学风貌。",
    "start": 150.378,
    "end": 157.227,
    "duration": 6.849
  },
  {
    "id": "sent_33",
    "text": "苏轼之词绝非单一维度的豪迈，而是其波澜起伏的人生心灵全息图景。",
    "start": 157.227,
    "end": 163.959,
    "duration": 6.732
  },
  {
    "id": "sent_34",
    "text": "乌台诗案牢狱之灾与贬谪黄州的人生绝境，不仅未曾将其精神压垮，",
    "start": 163.958,
    "end": 170.442,
    "duration": 6.484
  },
  {
    "id": "sent_35",
    "text": "反而逼发出超越苦难的生命哲思。",
    "start": 170.443,
    "end": 173.932,
    "duration": 3.489
  },
  {
    "id": "sent_36",
    "text": "在定慧院中，他借 “拣尽寒枝不肯栖，寂寞沙洲冷” 坚守孤高人格；",
    "start": 173.932,
    "end": 180.104,
    "duration": 6.172
  },
  {
    "id": "sent_37",
    "text": "在赤壁矶头，他以 “人生如梦，一尊还酹江月” 消解现实得失；",
    "start": 180.104,
    "end": 185.833,
    "duration": 5.729
  },
  {
    "id": "sent_38",
    "text": "至沙湖道中，最终升华为 “回首向来萧瑟处，归去，",
    "start": 185.833,
    "end": 190.976,
    "duration": 5.143
  },
  {
    "id": "sent_39",
    "text": "也无风雨也无晴” 的超然胜境。",
    "start": 190.977,
    "end": 193.984,
    "duration": 3.007
  },
  {
    "id": "sent_40",
    "text": "其词将道家随顺自适与佛禅理趣化解于儒家坚守之中，",
    "start": 193.984,
    "end": 199.557,
    "duration": 5.573
  },
  {
    "id": "sent_41",
    "text": "确立了清旷雄健的士大夫审美典范。",
    "start": 199.557,
    "end": 203.203,
    "duration": 3.646
  },
  {
    "id": "sent_42",
    "text": "第四，解放文体声律拘牵，直接启迪南宋辛派词人的英雄悲歌。",
    "start": 203.203,
    "end": 209.557,
    "duration": 6.354
  },
  {
    "id": "sent_43",
    "text": "为了保障抒情自由，苏轼敢于为了表达意气而适度破律，",
    "start": 209.557,
    "end": 214.843,
    "duration": 5.286
  },
  {
    "id": "sent_44",
    "text": "引发了李清照“句读不葺之诗”的文体辨析，",
    "start": 214.844,
    "end": 218.607,
    "duration": 3.763
  },
  {
    "id": "sent_45",
    "text": "但王灼在 《碧鸡漫志》 中客观定评：“东坡先生非心醉于音律者，",
    "start": 218.606,
    "end": 224.348,
    "duration": 5.742
  },
  {
    "id": "sent_46",
    "text": "偶尔作歌，指出向上一路，新天下耳目。",
    "start": 224.348,
    "end": 228.138,
    "duration": 3.79
  },
  {
    "id": "sent_47",
    "text": "” 苏轼使词走向诗意化与哲理化，",
    "start": 228.138,
    "end": 231.549,
    "duration": 3.411
  },
  {
    "id": "sent_48",
    "text": "不仅确立了北宋豪放词派的宏大基石，",
    "start": 231.549,
    "end": 235.312,
    "duration": 3.763
  },
  {
    "id": "sent_49",
    "text": "更直接启迪了南宋辛弃疾以文为词、融经铸史的艺术突围，",
    "start": 235.313,
    "end": 241.549,
    "duration": 6.236
  },
  {
    "id": "sent_50",
    "text": "共同将宋词推向了古典抒情文学的至高殿堂。",
    "start": 241.549,
    "end": 246.25,
    "duration": 4.701
  }
]