[
  {
    "id": "sent_1",
    "text": "宋代词体由中晚唐五代的“艳科小道”跃升为一代文学之代表，",
    "start": 0.0,
    "end": 4.8,
    "duration": 4.8
  },
  {
    "id": "sent_2",
    "text": "苏轼的文体解放之功最为卓著。",
    "start": 5.249,
    "end": 7.689,
    "duration": 2.44
  },
  {
    "id": "sent_3",
    "text": "面对词体长期依附于酒筵歌席、迁就乐工歌伎的狭隘格局，",
    "start": 8.139,
    "end": 13.179,
    "duration": 5.04
  },
  {
    "id": "sent_4",
    "text": "苏轼以崇高的文人主体意识推行 “以诗为词”，",
    "start": 13.629,
    "end": 17.309,
    "duration": 3.68
  },
  {
    "id": "sent_5",
    "text": "全面打破了诗词分界的传统藩篱，",
    "start": 17.759,
    "end": 20.359,
    "duration": 2.6
  },
  {
    "id": "sent_6",
    "text": "推动词体由娱人小道转变为与古诗平起平坐的独立抒情文体。",
    "start": 20.809,
    "end": 25.889,
    "duration": 5.08
  },
  {
    "id": "sent_7",
    "text": "胡寅在 《酒边词序》 中赞其 “一洗绮罗香泽之态，",
    "start": 26.339,
    "end": 30.219,
    "duration": 3.88
  },
  {
    "id": "sent_8",
    "text": "摆脱绸缪宛转之度，使人登高望远，举首高歌”。",
    "start": 30.749,
    "end": 34.429,
    "duration": 3.68
  },
  {
    "id": "sent_9",
    "text": "其对词体文学发展的历史贡献，主要展现为以下四个核心维度：",
    "start": 34.879,
    "end": 39.839,
    "duration": 4.96
  },
  {
    "id": "sent_10",
    "text": "第一，破除“词为艳科”传统，实现词体表现功能的案头言志转向。",
    "start": 40.289,
    "end": 45.929,
    "duration": 5.64
  },
  {
    "id": "sent_11",
    "text": "自花间、南唐至北宋初年，",
    "start": 46.379,
    "end": 48.819,
    "duration": 2.44
  },
  {
    "id": "sent_12",
    "text": "词作题材长期局限于闺怨相思与尊前欢谑，",
    "start": 49.269,
    "end": 52.989,
    "duration": 3.72
  },
  {
    "id": "sent_13",
    "text": "文人内心严肃的政治抱负与人生哲思无法登堂入室。",
    "start": 53.519,
    "end": 57.559,
    "duration": 4.04
  },
  {
    "id": "sent_14",
    "text": "苏轼从观念上确立“诗词一体”之说，指出词是“诗之苗裔”，",
    "start": 58.009,
    "end": 62.449,
    "duration": 4.44
  },
  {
    "id": "sent_15",
    "text": "把词从歌女口中解放出来给士大夫案头阅读。",
    "start": 62.899,
    "end": 66.539,
    "duration": 3.64
  },
  {
    "id": "sent_16",
    "text": "他将怀古、报国、悼亡、农村田园等宏大母题全面注入词中：",
    "start": 66.989,
    "end": 72.069,
    "duration": 5.08
  },
  {
    "id": "sent_17",
    "text": "在密州写下 “会挽雕弓如满月，西北望，射天狼” 的戍边雄心；",
    "start": 72.519,
    "end": 77.439,
    "duration": 4.92
  },
  {
    "id": "sent_18",
    "text": "在悼念亡妻时写出 “十年生死两茫茫，不思量，",
    "start": 77.889,
    "end": 81.689,
    "duration": 3.8
  },
  {
    "id": "sent_19",
    "text": "自难忘” 的深沉人伦；",
    "start": 82.139,
    "end": 83.899,
    "duration": 1.76
  },
  {
    "id": "sent_20",
    "text": "在徐州农村写出 “敲门试问野人家” 的淳朴风貌。",
    "start": 84.349,
    "end": 88.309,
    "duration": 3.96
  },
  {
    "id": "sent_21",
    "text": "这种题材的大幅度拓宽，彻底撕碎了词为艳科的狭隘格局。",
    "start": 88.759,
    "end": 93.559,
    "duration": 4.8
  },
  {
    "id": "sent_22",
    "text": "第二，首创题序小传机制，确立叙事与抒情深度融合的篇章结构。",
    "start": 94.009,
    "end": 99.529,
    "duration": 5.52
  },
  {
    "id": "sent_23",
    "text": "传统曲子词往往“有调无题”，情意模糊泛化。",
    "start": 99.979,
    "end": 103.539,
    "duration": 3.56
  },
  {
    "id": "sent_24",
    "text": "苏轼借鉴近体诗作法，大量在词前创设长短题序，",
    "start": 103.989,
    "end": 108.269,
    "duration": 4.28
  },
  {
    "id": "sent_25",
    "text": "以纪实笔法交代创作缘起、时间、地点与生活细节。",
    "start": 108.719,
    "end": 112.999,
    "duration": 4.28
  },
  {
    "id": "sent_26",
    "text": "在 《水调歌头》 前以“丙辰中秋，欢饮达旦，大醉，",
    "start": 113.449,
    "end": 117.129,
    "duration": 3.68
  },
  {
    "id": "sent_27",
    "text": "作此篇兼怀子由”交代本事；",
    "start": 117.579,
    "end": 119.979,
    "duration": 2.4
  },
  {
    "id": "sent_28",
    "text": "在 《定风波》 前以“三月七日沙湖道中遇雨，雨具先去，",
    "start": 120.429,
    "end": 124.509,
    "duration": 4.08
  },
  {
    "id": "sent_29",
    "text": "同行皆狼狈，余独不觉”铺叙生活波澜。",
    "start": 125.039,
    "end": 128.319,
    "duration": 3.28
  },
  {
    "id": "sent_30",
    "text": "题序小传与正文词句互为表里，",
    "start": 128.769,
    "end": 131.289,
    "duration": 2.52
  },
  {
    "id": "sent_31",
    "text": "使词体不仅具备了交代复杂事件的记实能力，",
    "start": 131.819,
    "end": 135.179,
    "duration": 3.36
  },
  {
    "id": "sent_32",
    "text": "更营造出浓郁的生活现场感与历史真实感。",
    "start": 135.629,
    "end": 139.109,
    "duration": 3.48
  },
  {
    "id": "sent_33",
    "text": "第三，以知人论世为心灵轴线，",
    "start": 139.559,
    "end": 142.519,
    "duration": 2.96
  },
  {
    "id": "sent_34",
    "text": "构筑以旷达自适为主的多样化美学风貌。",
    "start": 142.969,
    "end": 146.009,
    "duration": 3.04
  },
  {
    "id": "sent_35",
    "text": "苏轼之词绝非单一维度的豪迈，",
    "start": 146.459,
    "end": 149.099,
    "duration": 2.64
  },
  {
    "id": "sent_36",
    "text": "而是其波澜起伏的人生心灵全息图景。",
    "start": 149.549,
    "end": 152.589,
    "duration": 3.04
  },
  {
    "id": "sent_37",
    "text": "乌台诗案牢狱之灾与贬谪黄州的人生绝境，不仅未曾将其精神压垮，",
    "start": 153.039,
    "end": 158.519,
    "duration": 5.48
  },
  {
    "id": "sent_38",
    "text": "反而逼发出超越苦难的生命哲思。",
    "start": 158.969,
    "end": 161.489,
    "duration": 2.52
  },
  {
    "id": "sent_39",
    "text": "在定慧院中，他借 “拣尽寒枝不肯栖，",
    "start": 161.939,
    "end": 165.099,
    "duration": 3.16
  },
  {
    "id": "sent_40",
    "text": "寂寞沙洲冷” 坚守孤高人格；",
    "start": 165.549,
    "end": 167.949,
    "duration": 2.4
  },
  {
    "id": "sent_41",
    "text": "在赤壁矶头，他以 “人生如梦，一尊还酹江月” 消解现实得失；",
    "start": 168.399,
    "end": 173.599,
    "duration": 5.2
  },
  {
    "id": "sent_42",
    "text": "至沙湖道中，最终升华为 “回首向来萧瑟处，归去，",
    "start": 174.049,
    "end": 178.369,
    "duration": 4.32
  },
  {
    "id": "sent_43",
    "text": "也无风雨也无晴” 的超然胜境。",
    "start": 178.819,
    "end": 181.339,
    "duration": 2.52
  },
  {
    "id": "sent_44",
    "text": "其词将道家随顺自适与佛禅理趣化解于儒家坚守之中，",
    "start": 181.789,
    "end": 186.469,
    "duration": 4.68
  },
  {
    "id": "sent_45",
    "text": "确立了清旷雄健的士大夫审美典范。",
    "start": 186.919,
    "end": 189.879,
    "duration": 2.96
  },
  {
    "id": "sent_46",
    "text": "第四，解放文体声律拘牵，直接启迪南宋辛派词人的英雄悲歌。",
    "start": 190.328,
    "end": 195.448,
    "duration": 5.12
  },
  {
    "id": "sent_47",
    "text": "为了保障抒情自由，苏轼敢于为了表达意气而适度破律，",
    "start": 195.978,
    "end": 200.298,
    "duration": 4.32
  },
  {
    "id": "sent_48",
    "text": "引发了李清照“句读不葺之诗”的文体辨析，",
    "start": 200.748,
    "end": 204.068,
    "duration": 3.32
  },
  {
    "id": "sent_49",
    "text": "但王灼在 《碧鸡漫志》 中客观定评：",
    "start": 204.518,
    "end": 207.358,
    "duration": 2.84
  },
  {
    "id": "sent_50",
    "text": "“东坡先生非心醉于音律者，偶尔作歌，指出向上一路，",
    "start": 207.808,
    "end": 211.808,
    "duration": 4.0
  },
  {
    "id": "sent_51",
    "text": "新天下耳目。",
    "start": 212.258,
    "end": 213.458,
    "duration": 1.2
  },
  {
    "id": "sent_52",
    "text": "” 苏轼使词走向诗意化与哲理化，",
    "start": 213.908,
    "end": 216.668,
    "duration": 2.76
  },
  {
    "id": "sent_53",
    "text": "不仅确立了北宋豪放词派的宏大基石，",
    "start": 217.118,
    "end": 220.118,
    "duration": 3.0
  },
  {
    "id": "sent_54",
    "text": "更直接启迪了南宋辛弃疾以文为词、融经铸史的艺术突围，",
    "start": 220.568,
    "end": 226.048,
    "duration": 5.48
  },
  {
    "id": "sent_55",
    "text": "共同将宋词推向了古典抒情文学的至高殿堂。",
    "start": 226.578,
    "end": 230.258,
    "duration": 3.68
  }
]