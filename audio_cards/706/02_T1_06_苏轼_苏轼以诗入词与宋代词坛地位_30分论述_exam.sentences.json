[
  {
    "id": 1,
    "text": "试论苏轼对宋代词体发展的文学史贡献。",
    "start": 0.101,
    "end": 3.435,
    "duration": 3.334
  },
  {
    "id": 2,
    "text": "宋代词体由晚唐五代的“艳科小道”跃升为与诗并列的一代文学之胜，苏轼的革新之功最为卓著。",
    "start": 3.935,
    "end": 12.342,
    "duration": 8.407
  },
  {
    "id": 3,
    "text": "面对词体长期依附酒筵歌席、迁就乐工歌伎的狭隘格局，苏轼以文人主体意识推行“以诗为词”，",
    "start": 12.842,
    "end": 21.24,
    "duration": 8.398
  },
  {
    "id": 4,
    "text": "打破诗词分界的传统藩篱，使词从应歌娱人之具转变为独立的抒情诗体。",
    "start": 21.59,
    "end": 27.711,
    "duration": 6.121
  },
  {
    "id": 5,
    "text": "胡寅在《酒边词序》中赞其“一洗绮罗香泽之态，摆脱绸缪宛转之度，使人登高望远，举首高歌”。",
    "start": 28.408,
    "end": 36.841,
    "duration": 8.433
  },
  {
    "id": 6,
    "text": "其对词体发展的贡献，主要体现在以下四个方面：",
    "start": 37.394,
    "end": 40.859,
    "duration": 3.465
  },
  {
    "id": 7,
    "text": "第一，破除“词为艳科”成见，使词体由应歌娱人转向抒怀言志。",
    "start": 41.479,
    "end": 47.29,
    "duration": 5.811
  },
  {
    "id": 8,
    "text": "自花间、南唐至北宋初年，词作题材多局限于男女恋情与离愁别恨。",
    "start": 47.966,
    "end": 53.999,
    "duration": 6.033
  },
  {
    "id": 9,
    "text": "苏轼从理论上确立“诗词一体”之说，在《祭张子野文》中称词“盖诗之裔”，",
    "start": 54.499,
    "end": 60.635,
    "duration": 6.136
  },
  {
    "id": 10,
    "text": "力主“自是一家”，把词从歌伎口中解放出来，用来抒发士大夫的性情怀抱。",
    "start": 61.064,
    "end": 66.926,
    "duration": 5.862
  },
  {
    "id": 11,
    "text": "他将怀古、报国、悼亡、田园农村等丰富题材引入词中：",
    "start": 67.426,
    "end": 72.603,
    "duration": 5.177
  },
  {
    "id": 12,
    "text": "在密州写下“会挽雕弓如满月，西北望，射天狼”的戍边壮志；",
    "start": 72.953,
    "end": 78.253,
    "duration": 5.3
  },
  {
    "id": 13,
    "text": "悼念亡妻写出“十年生死两茫茫，不思量，自难忘”的深沉情谊；",
    "start": 78.753,
    "end": 84.409,
    "duration": 5.656
  },
  {
    "id": 14,
    "text": "在徐州农村写出“敲门试问野人家”的淳朴民风，极大拓宽了宋词的表现领域。",
    "start": 84.909,
    "end": 91.451,
    "duration": 6.542
  },
  {
    "id": 15,
    "text": "第二，广用标题与小序机制，使词境与现实生活紧密结合。",
    "start": 92.062,
    "end": 96.972,
    "duration": 4.91
  },
  {
    "id": 16,
    "text": "传统曲子词大多“有调无题”，情意指向较为宽泛。",
    "start": 97.472,
    "end": 101.451,
    "duration": 3.979
  },
  {
    "id": 17,
    "text": "苏轼借鉴诗歌作法并受张先启发，",
    "start": 101.951,
    "end": 104.614,
    "duration": 2.663
  },
  {
    "id": 18,
    "text": "在词中广泛创用标题和小序，交代写作缘起、时地与生活场景。",
    "start": 104.964,
    "end": 110.213,
    "duration": 5.249
  },
  {
    "id": 19,
    "text": "《水调歌头》前冠以“丙辰中秋，欢饮达旦，大醉，作此篇，兼怀子由”，点明月夜怀弟之旨；",
    "start": 110.713,
    "end": 118.67,
    "duration": 7.957
  },
  {
    "id": 20,
    "text": "《定风波》前详记“三月七日，沙湖道中遇雨，雨具先去，同行皆狼狈，余独不觉”，铺垫遇雨坦然的境遇。",
    "start": 119.178,
    "end": 128.139,
    "duration": 8.961
  },
  {
    "id": 21,
    "text": "题序与词本文浑然一体，既弥补了词体不便叙事的短处，也增强了作品的纪实性与生活气息。",
    "start": 128.639,
    "end": 136.503,
    "duration": 7.864
  },
  {
    "id": 22,
    "text": "第三，融通性情怀抱与理趣哲思，开拓清旷豪迈的多样词风。",
    "start": 137.149,
    "end": 142.937,
    "duration": 5.788
  },
  {
    "id": 23,
    "text": "苏轼词风兼备清旷、豪放与婉转，全面映现其波澜起伏的人生境遇。",
    "start": 143.441,
    "end": 149.23,
    "duration": 5.789
  },
  {
    "id": 24,
    "text": "乌台诗案与贬谪黄州的挫折磨难，非但未将其压垮，反而催生出超然自适的生命哲思：",
    "start": 149.73,
    "end": 157.041,
    "duration": 7.311
  },
  {
    "id": 25,
    "text": "在定慧院中，他借“拣尽寒枝不肯栖，寂寞沙洲冷”坚守孤高节操；",
    "start": 157.562,
    "end": 164.535,
    "duration": 6.973
  },
  {
    "id": 26,
    "text": "在赤壁矶头，以“人生如梦，一尊还酹江月”排遣现实苦闷；",
    "start": 165.227,
    "end": 170.715,
    "duration": 5.488
  },
  {
    "id": 27,
    "text": "至沙湖道中，升华为“回首向来萧瑟处，归去，也无风雨也无晴”的旷达胜境。",
    "start": 171.309,
    "end": 179.313,
    "duration": 8.004
  },
  {
    "id": 28,
    "text": "苏词将儒家坚守与佛道超脱融为一体，确立了清雄旷达的士大夫词风典范。",
    "start": 179.813,
    "end": 186.834,
    "duration": 7.021
  },
  {
    "id": 29,
    "text": "第四，弱化词对音乐的依附，开启南宋辛派词人的革新路径。",
    "start": 187.479,
    "end": 192.811,
    "duration": 5.332
  },
  {
    "id": 30,
    "text": "为保障抒情自由，苏轼作词往往不喜裁剪以就声律，",
    "start": 193.47,
    "end": 197.851,
    "duration": 4.381
  },
  {
    "id": 31,
    "text": "虽曾被李清照评为“句读不葺之诗”，却拓展了词的文学表现力。",
    "start": 198.201,
    "end": 203.298,
    "duration": 5.097
  },
  {
    "id": 32,
    "text": "王灼在《碧鸡漫志》中公允指出：“东坡先生非心醉于音律者，偶尔作歌，指出向上一路，新天下耳目。”",
    "start": 203.813,
    "end": 213.291,
    "duration": 9.478
  },
  {
    "id": 33,
    "text": "苏轼通过“以诗为词”提升词的文学品位，",
    "start": 213.791,
    "end": 216.156,
    "duration": 2.365
  },
  {
    "id": 34,
    "text": "不仅确立了北宋豪放词派的基石，更直接启迪了南宋张孝祥、辛弃疾等人的“以文为词”与用经用史之风，",
    "start": 216.639,
    "end": 225.562,
    "duration": 8.923
  },
  {
    "id": 35,
    "text": "从根本上改变了宋词的发展方向。",
    "start": 225.912,
    "end": 228.444,
    "duration": 2.532
  },
  {
    "id": 36,
    "text": "综观全篇，苏轼以文人主体意识推行“以诗为词”，",
    "start": 228.944,
    "end": 233.281,
    "duration": 4.337
  },
  {
    "id": 37,
    "text": "借标题小序、旷达情怀与议论理趣破除了“词为艳科”的传统成见，",
    "start": 233.631,
    "end": 239.42,
    "duration": 5.789
  },
  {
    "id": 38,
    "text": "减弱词体对音乐歌席的狭隘依附。",
    "start": 239.77,
    "end": 242.378,
    "duration": 2.608
  },
  {
    "id": 39,
    "text": "他在不失词体音律韵致的同时提升其文学品位，",
    "start": 242.888,
    "end": 246.641,
    "duration": 3.753
  },
  {
    "id": 40,
    "text": "使词真正具备与诗并列的独立抒情地位，直接开启了南宋辛派词人的创作新途。",
    "start": 247.032,
    "end": 253.535,
    "duration": 6.503
  }
]
