[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "人→境→体→格四步递进：先把“傲立王侯”的主体人格立住，",
    "start": 0.0,
    "end": 6.04,
    "duration": 6.04
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再写出人格驱动下夸张奇幻的意境，",
    "start": 6.089,
    "end": 8.889,
    "duration": 2.8
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "自然解释为何必须打破近体律诗改投奔涌歌行，",
    "start": 9.339,
    "end": 13.339,
    "duration": 4.0
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后收束为“豪放歌行+清新绝句”双美并擅的浪漫高峰。",
    "start": 13.789,
    "end": 18.429,
    "duration": 4.64
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "李白是古典浪漫主义与“盛唐气象”的鲜明化身。",
    "start": 18.879,
    "end": 22.599,
    "duration": 3.72
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "杜甫赞“笔落惊风雨，诗成泣鬼神”，韩愈赞“李杜文章在，光焰万丈长”。",
    "start": 23.049,
    "end": 29.289,
    "duration": 6.24
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 塑造追求精神自由的主体人格",
    "start": 29.739,
    "end": 33.059,
    "duration": 3.32
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "权贵前高呼“安能摧眉折腰事权贵”；",
    "start": 33.509,
    "end": 36.869,
    "duration": 3.36
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "坎坷中坚信“长风破浪会有时，直挂云帆济沧海”；",
    "start": 37.319,
    "end": 41.599,
    "duration": 4.28
  },
  {
    "id": "sec0_step0_c2",
    "dom_key": "sec0_step0_c2",
    "text": "酒酣仍怀“天生我材必有用，千金散尽还复来”；",
    "start": 42.049,
    "end": 46.049,
    "duration": 4.0
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "兼融道家超脱、纵横家雄心与侠义精神，凝结盛唐蓬勃进取时代脉搏。",
    "start": 46.579,
    "end": 52.619,
    "duration": 6.04
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 展开奇幻想象与大胆夸张",
    "start": 53.069,
    "end": 56.189,
    "duration": 3.12
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "自由驱遣神话与星辰：",
    "start": 56.639,
    "end": 58.679,
    "duration": 2.04
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "《梦游天姥吟留别》以“势拔五岳掩赤城”引出仙人绚烂幻境；",
    "start": 59.129,
    "end": 64.129,
    "duration": 5.0
  },
  {
    "id": "sec1_step0_c2",
    "dom_key": "sec1_step0_c2",
    "text": "《蜀道难》“上有六龙回日之高标”化险阻为壮景；",
    "start": 64.579,
    "end": 68.339,
    "duration": 3.76
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "写愁思“白发三千丈”，写飞瀑“疑是银河落九天”，尽显阳刚魄力。",
    "start": 68.789,
    "end": 74.229,
    "duration": 5.44
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 突破声律羁绊、擅古题乐府歌行",
    "start": 74.679,
    "end": 78.439,
    "duration": 3.76
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "不拘近体粘对，倾力古题乐府与长篇歌行，",
    "start": 78.889,
    "end": 82.689,
    "duration": 3.8
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "如《将进酒》《行路难》三五七杂言错落、一泻千里；",
    "start": 83.139,
    "end": 87.299,
    "duration": 4.16
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "节奏大开大合，呈现出天马行空之姿，践行“清水出芙蓉，",
    "start": 87.749,
    "end": 92.629,
    "duration": 4.88
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "天然去雕饰”美学追求。",
    "start": 93.079,
    "end": 94.959,
    "duration": 1.88
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 兼备豪放与清新俊逸双重风神",
    "start": 95.489,
    "end": 99.129,
    "duration": 3.64
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "兼擅五七言绝句自然天成：",
    "start": 99.579,
    "end": 101.939,
    "duration": 2.36
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "七绝《早发白帝城》轻舟顺流、《望庐山瀑布》紫烟飞瀑，",
    "start": 102.389,
    "end": 106.669,
    "duration": 4.28
  },
  {
    "id": "sec3_step0_c2",
    "dom_key": "sec3_step0_c2",
    "text": "五绝《静夜思》明快真挚；",
    "start": 107.199,
    "end": 109.199,
    "duration": 2.0
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "胡应麟《诗薮》赞“太白五七言绝，字字神境，篇篇神物”，",
    "start": 109.649,
    "end": 114.489,
    "duration": 4.84
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "与杜甫双峰并峙。",
    "start": 114.939,
    "end": 116.419,
    "duration": 1.48
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "李白以布衣傲骨、雄奇想象与纵横歌行把盛唐气象化为个人神采，",
    "start": 116.869,
    "end": 122.389,
    "duration": 5.52
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "兼擅清新明丽五七言绝句，与杜甫双峰并峙，",
    "start": 122.839,
    "end": 126.759,
    "duration": 3.92
  },
  {
    "id": "concl_c2",
    "dom_key": "concl_c2",
    "text": "开拓了抒情自由与个性张扬的广阔天地。",
    "start": 127.209,
    "end": 130.449,
    "duration": 3.24
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：杜甫赞李白“笔落惊风雨，诗成泣鬼神”；",
    "start": 130.899,
    "end": 135.099,
    "duration": 4.2
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "胡应麟《诗薮》赞其绝句“太白五七言绝，字字神境，篇篇神物”。",
    "start": 135.549,
    "end": 140.749,
    "duration": 5.2
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 李白自由主体人格融合了哪三家思想？",
    "start": 141.199,
    "end": 144.759,
    "duration": 3.56
  },
  {
    "id": "drill0_c1",
    "dom_key": "drill0_c1",
    "text": "代表宣言句？",
    "start": 145.209,
    "end": 146.409,
    "duration": 1.2
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 为什么李白不喜近体律诗而倾情古题乐府与歌行？",
    "start": 146.859,
    "end": 152.939,
    "duration": 6.08
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 怎样用三首绝句与《诗薮》评语论证“清新俊逸”？",
    "start": 153.389,
    "end": 158.789,
    "duration": 5.4
  }
]