[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "人→境→体→格四步递进：先把“傲立王侯”的主体人格立住，",
    "start": 0.214,
    "end": 6.247,
    "duration": 6.033
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再写出人格驱动下夸张奇幻的意境，自然解释为何必须打破近体律诗改投奔涌歌行，",
    "start": 6.996,
    "end": 14.357,
    "duration": 7.361
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后收束为“豪放歌行+清新绝句”双美并擅的浪漫高峰。",
    "start": 15.177,
    "end": 20.174,
    "duration": 4.998
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "李白是古典浪漫主义与“盛唐气象”的鲜明化身。",
    "start": 20.897,
    "end": 24.63,
    "duration": 3.732
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "杜甫赞“笔落惊风雨，诗成泣鬼神”，韩愈赞“李杜文章在，光焰万丈长”。",
    "start": 25.399,
    "end": 31.317,
    "duration": 5.918
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 塑造追求精神自由的主体人格",
    "start": 32.04,
    "end": 35.334,
    "duration": 3.295
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "权贵前高呼“安能摧眉折腰事权贵”；",
    "start": 36.057,
    "end": 39.058,
    "duration": 3.001
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "坎坷中坚信“长风破浪会有时，直挂云帆济沧海”；",
    "start": 39.823,
    "end": 43.955,
    "duration": 4.133
  },
  {
    "id": "sec0_step0_c2",
    "dom_key": "sec0_step0_c2",
    "text": "酒酣仍怀“天生我材必有用，千金散尽还复来”；",
    "start": 44.725,
    "end": 48.551,
    "duration": 3.826
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "兼融道家超脱、纵横家雄心与侠义精神，凝结盛唐蓬勃进取时代脉搏。",
    "start": 49.282,
    "end": 55.657,
    "duration": 6.376
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 展开奇幻想象与大胆夸张",
    "start": 56.374,
    "end": 59.565,
    "duration": 3.191
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "自由驱遣神话与星辰：《梦游天姥吟留别》以“势拔五岳掩赤城”引出仙人绚烂幻境；",
    "start": 60.306,
    "end": 67.082,
    "duration": 6.775
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "《蜀道难》“上有六龙回日之高标”化险阻为壮景；",
    "start": 67.859,
    "end": 71.485,
    "duration": 3.626
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "写愁思“白发三千丈”，写飞瀑“疑是银河落九天”，尽显阳刚魄力。",
    "start": 72.269,
    "end": 77.615,
    "duration": 5.346
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 突破声律羁绊、擅古题乐府歌行",
    "start": 78.376,
    "end": 81.974,
    "duration": 3.598
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "不拘近体粘对，倾力古题乐府与长篇歌行，如《将进酒》《行路难》三五七杂言错落、一泻千里；",
    "start": 82.746,
    "end": 90.978,
    "duration": 8.232
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "节奏大开大合，呈现出天马行空之姿，践行“清水出芙蓉，天然去雕饰”美学追求。",
    "start": 91.76,
    "end": 98.568,
    "duration": 6.809
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 兼备豪放与清新俊逸双重风神",
    "start": 99.349,
    "end": 102.773,
    "duration": 3.424
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "兼擅五七言绝句自然天成：七绝《早发白帝城》轻舟顺流、《望庐山瀑布》紫烟飞瀑，",
    "start": 103.594,
    "end": 110.265,
    "duration": 6.67
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "五绝《静夜思》明快真挚；",
    "start": 111.124,
    "end": 112.784,
    "duration": 1.66
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "胡应麟《诗薮》赞“太白五七言绝，字字神境，篇篇神物”，与杜甫双峰并峙。",
    "start": 113.565,
    "end": 119.6,
    "duration": 6.035
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "李白以布衣傲骨、雄奇想象与纵横歌行把盛唐气象化为个人神采，",
    "start": 120.326,
    "end": 126.169,
    "duration": 5.843
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "兼擅清新明丽五七言绝句，与杜甫双峰并峙，开拓了抒情自由与个性张扬的广阔天地。",
    "start": 126.944,
    "end": 134.722,
    "duration": 7.778
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：杜甫赞李白“笔落惊风雨，诗成泣鬼神”；",
    "start": 135.52,
    "end": 139.72,
    "duration": 4.2
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "胡应麟《诗薮》赞其绝句“太白五七言绝，字字神境，篇篇神物”。",
    "start": 140.537,
    "end": 145.616,
    "duration": 5.078
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 李白自由主体人格融合了哪三家思想？代表宣言句？",
    "start": 146.385,
    "end": 152.22,
    "duration": 5.835
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 为什么李白不喜近体律诗而倾情古题乐府与歌行？",
    "start": 152.956,
    "end": 158.452,
    "duration": 5.496
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 怎样用三首绝句与《诗薮》评语论证“清新俊逸”？",
    "start": 159.174,
    "end": 164.277,
    "duration": 5.103
  }
]