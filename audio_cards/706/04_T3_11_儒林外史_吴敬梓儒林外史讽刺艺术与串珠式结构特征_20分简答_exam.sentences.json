[
  {
    "id": 1,
    "text": "简述吴敬梓《儒林外史》的讽刺艺术与串珠式结构特征。",
    "start": 0.112,
    "end": 4.807,
    "duration": 4.695
  },
  {
    "id": 2,
    "text": "吴敬梓的《儒林外史》标志着中国古代长篇讽刺小说的成熟。",
    "start": 4.952,
    "end": 9.424,
    "duration": 4.472
  },
  {
    "id": 3,
    "text": "鲁迅在《中国小说史略》中赞其“秉持公心，指摘时弊，",
    "start": 9.77,
    "end": 13.993,
    "duration": 4.223
  },
  {
    "id": 4,
    "text": "机锋所向，尤在士林；其文戚而能谐，婉而多讽”。",
    "start": 14.144,
    "end": 18.461,
    "duration": 4.317
  },
  {
    "id": 5,
    "text": "其讽刺艺术与结构特征，主要体现在以下三个方面：",
    "start": 18.753,
    "end": 22.531,
    "duration": 3.778
  },
  {
    "id": 6,
    "text": "第一，运用客观白描与矛盾对照，达到“戚而能谐，",
    "start": 23.207,
    "end": 27.765,
    "duration": 4.558
  },
  {
    "id": 7,
    "text": "婉而多讽”的讽刺境界。",
    "start": 27.931,
    "end": 29.503,
    "duration": 1.572
  },
  {
    "id": 8,
    "text": "《儒林外史》摆脱了以往讽刺作品浅露谩骂的弊病，",
    "start": 29.828,
    "end": 33.245,
    "duration": 3.417
  },
  {
    "id": 9,
    "text": "采取冷峻客观的生活白描，",
    "start": 33.618,
    "end": 35.653,
    "duration": 2.035
  },
  {
    "id": 10,
    "text": "让人物在日常言行的自相矛盾中自露真相，",
    "start": 36.109,
    "end": 39.455,
    "duration": 3.346
  },
  {
    "id": 11,
    "text": "“无一贬词而情伪毕露”。",
    "start": 39.766,
    "end": 41.748,
    "duration": 1.982
  },
  {
    "id": 12,
    "text": "如写严监生临终因灯盏点着两茎灯草不肯断气，",
    "start": 42.022,
    "end": 46.238,
    "duration": 4.216
  },
  {
    "id": 13,
    "text": "挑掉一茎方才咽气；写范进中举前受尽岳父胡屠户唾骂，",
    "start": 46.65,
    "end": 51.989,
    "duration": 5.339
  },
  {
    "id": 14,
    "text": "中举发疯后胡屠户则奉为“文曲星”卑躬屈膝。",
    "start": 52.38,
    "end": 56.478,
    "duration": 4.098
  },
  {
    "id": 15,
    "text": "吴敬梓不加空洞说教，",
    "start": 56.886,
    "end": 58.391,
    "duration": 1.505
  },
  {
    "id": 16,
    "text": "而在滑稽可笑的表象中挖掘士子受科举戕害的悲哀，",
    "start": 58.701,
    "end": 62.954,
    "duration": 4.253
  },
  {
    "id": 17,
    "text": "使讽刺兼具谐趣与悲悯。",
    "start": 63.323,
    "end": 65.63,
    "duration": 2.307
  },
  {
    "id": 18,
    "text": "第二，首创以功名富贵为统摄的“串珠式”连缀结构，",
    "start": 66.3,
    "end": 70.307,
    "duration": 4.007
  },
  {
    "id": 19,
    "text": "开拓长篇叙事新体制。",
    "start": 70.653,
    "end": 72.452,
    "duration": 1.799
  },
  {
    "id": 20,
    "text": "在结构上，",
    "start": 72.793,
    "end": 73.507,
    "duration": 0.714
  },
  {
    "id": 21,
    "text": "《儒林外史》打破了传统长篇依靠单一中心故事或核心人物贯穿始终的成规。",
    "start": 73.758,
    "end": 79.782,
    "duration": 6.024
  },
  {
    "id": 22,
    "text": "鲁迅概括其为“全书无主干，仅驱使各种人物，行列而来，",
    "start": 80.103,
    "end": 85.032,
    "duration": 4.929
  },
  {
    "id": 23,
    "text": "事与其来俱起，亦与其去俱讫，虽云长篇，颇同短制”。",
    "start": 85.329,
    "end": 90.318,
    "duration": 4.989
  },
  {
    "id": 24,
    "text": "全书以士人对功名富贵的态度为内在主线，",
    "start": 90.687,
    "end": 94.084,
    "duration": 3.397
  },
  {
    "id": 25,
    "text": "第一回“楔子”敷陈大义，末回“幽榜”遥相呼应，",
    "start": 94.433,
    "end": 98.146,
    "duration": 3.713
  },
  {
    "id": 26,
    "text": "中间人物接力登场、此落彼起，",
    "start": 98.417,
    "end": 100.848,
    "duration": 2.431
  },
  {
    "id": 27,
    "text": "如同丝线穿珠般串联起两百余名各色人物，",
    "start": 101.162,
    "end": 104.577,
    "duration": 3.415
  },
  {
    "id": 28,
    "text": "全景式展现了世态群像。",
    "start": 104.887,
    "end": 106.888,
    "duration": 2.001
  },
  {
    "id": 29,
    "text": "第三，融批判锋芒与真儒理想于一体，寄托士人人格自立的追求。",
    "start": 107.561,
    "end": 113.144,
    "duration": 5.583
  },
  {
    "id": 30,
    "text": "吴敬梓的讽刺源自深沉的士林忧患意识。",
    "start": 113.392,
    "end": 116.483,
    "duration": 3.091
  },
  {
    "id": 31,
    "text": "小说在剖析周进、范进、",
    "start": 116.98,
    "end": 119.069,
    "duration": 2.089
  },
  {
    "id": 32,
    "text": "马二先生等热衷科举者的精神堕落之余，又特意安排王冕、",
    "start": 119.153,
    "end": 123.463,
    "duration": 4.31
  },
  {
    "id": 33,
    "text": "杜少卿、庄绍光及市井四大奇人等不慕荣利、自食其力的人物，",
    "start": 123.625,
    "end": 128.671,
    "duration": 5.046
  },
  {
    "id": 34,
    "text": "在犀利批判科举流弊的同时，",
    "start": 128.927,
    "end": 131.183,
    "duration": 2.256
  },
  {
    "id": 35,
    "text": "树立了崇尚德行与独立人格的精神标尺，",
    "start": 131.362,
    "end": 134.61,
    "duration": 3.248
  },
  {
    "id": 36,
    "text": "深刻影响了晚清谴责小说的发展。",
    "start": 134.792,
    "end": 137.352,
    "duration": 2.56
  }
]