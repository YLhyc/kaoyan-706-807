[
  {
    "id": "sent_1",
    "text": "吴敬梓的 《儒林外史》 是中国古典长篇小说中讽刺艺术的最高峰，",
    "start": 0.08,
    "end": 4.96,
    "duration": 4.88
  },
  {
    "id": "sent_2",
    "text": "标志着古代长篇讽刺小说文体的完全成熟。",
    "start": 5.409,
    "end": 8.889,
    "duration": 3.48
  },
  {
    "id": "sent_3",
    "text": "面对清代八股取士制度对知识分子灵魂的摧残与士林道德的堕落，",
    "start": 9.339,
    "end": 15.059,
    "duration": 5.72
  },
  {
    "id": "sent_4",
    "text": "吴敬梓以冷峻清醒的眼光，勾勒了一幅广阔的士林百丑图。",
    "start": 15.589,
    "end": 20.269,
    "duration": 4.68
  },
  {
    "id": "sent_5",
    "text": "鲁迅在 《中国小说史略》 中评价其 “秉持公心，指摘时病，",
    "start": 20.719,
    "end": 25.159,
    "duration": 4.44
  },
  {
    "id": "sent_6",
    "text": "机锋所向，尤在士林……其感受之速，分析之微，卓越而不可及”。",
    "start": 25.609,
    "end": 27.809,
    "duration": 2.2
  },
  {
    "id": "sent_7",
    "text": "《儒林外史》 的讽刺艺术与文体结构，",
    "start": 28.259,
    "end": 31.939,
    "duration": 3.68
  },
  {
    "id": "sent_8",
    "text": "主要展现为以下三个核心维度：",
    "start": 32.389,
    "end": 35.029,
    "duration": 2.64
  },
  {
    "id": "sent_9",
    "text": "第一，开创客观白描与反讽对比的讽刺艺术，达到“戚而能谐，",
    "start": 35.479,
    "end": 37.879,
    "duration": 2.4
  },
  {
    "id": "sent_10",
    "text": "婉而多讽”的高超境界。",
    "start": 38.329,
    "end": 43.089,
    "duration": 4.76
  },
  {
    "id": "sent_11",
    "text": "《儒林外史》 彻底摆脱了此前讽刺文学直接谩骂或粗暴说教的弊端，",
    "start": 43.539,
    "end": 45.339,
    "duration": 1.8
  },
  {
    "id": "sent_12",
    "text": "采用纯粹客观的生活细节描写，",
    "start": 45.789,
    "end": 50.629,
    "duration": 4.84
  },
  {
    "id": "sent_13",
    "text": "让讽刺对象在言行自相矛盾中暴露出可笑可悲的本质。",
    "start": 51.079,
    "end": 53.599,
    "duration": 2.52
  },
  {
    "id": "sent_14",
    "text": "例如写严监生临终前因见灯盏里点着两茎灯草，",
    "start": 54.049,
    "end": 58.649,
    "duration": 4.6
  },
  {
    "id": "sent_15",
    "text": "伸出两个指头迟迟不肯断气，挑掉一茎方才咽气；",
    "start": 59.099,
    "end": 63.339,
    "duration": 4.24
  },
  {
    "id": "sent_16",
    "text": "写范进中举前受尽胡屠户掌掴唾骂，",
    "start": 63.789,
    "end": 67.989,
    "duration": 4.2
  },
  {
    "id": "sent_17",
    "text": "中举发疯后胡屠户称其为 “文曲星下凡” 卑躬屈膝。",
    "start": 68.439,
    "end": 71.839,
    "duration": 3.4
  },
  {
    "id": "sent_18",
    "text": "吴敬梓不加主观说教，仅以精准传神的客观白描与前后对照，",
    "start": 72.289,
    "end": 76.409,
    "duration": 4.12
  },
  {
    "id": "sent_19",
    "text": "深刻讽刺了士人灵魂扭曲与世态炎凉。",
    "start": 76.939,
    "end": 81.499,
    "duration": 4.56
  },
  {
    "id": "sent_20",
    "text": "第二，首创以功名富贵为核心的“串珠式”连缀结构，",
    "start": 81.949,
    "end": 85.189,
    "duration": 3.24
  },
  {
    "id": "sent_21",
    "text": "开辟长篇叙事新格局。",
    "start": 85.639,
    "end": 89.999,
    "duration": 4.36
  },
  {
    "id": "sent_22",
    "text": "在小说结构上，",
    "start": 90.449,
    "end": 92.449,
    "duration": 2.0
  },
  {
    "id": "sent_23",
    "text": "《儒林外史》 突破了传统长篇小说必须由单一中心故事或主角贯穿始终的规制。",
    "start": 92.979,
    "end": 94.259,
    "duration": 1.28
  },
  {
    "id": "sent_24",
    "text": "鲁迅概括其为 “虽云长篇，颇同短篇；",
    "start": 94.709,
    "end": 100.949,
    "duration": 6.24
  },
  {
    "id": "sent_25",
    "text": "各篇虽各独立，而又相连结”。",
    "start": 101.399,
    "end": 104.759,
    "duration": 3.36
  },
  {
    "id": "sent_26",
    "text": "全书以对 “功名富贵” 的态度为统摄主线，",
    "start": 105.209,
    "end": 107.649,
    "duration": 2.44
  },
  {
    "id": "sent_27",
    "text": "前一个人物的故事刚近尾声，便引出下一个人物登场；",
    "start": 108.179,
    "end": 111.259,
    "duration": 3.08
  },
  {
    "id": "sent_28",
    "text": "人物接力更替，如同丝线穿珠一般，将各色士人串联在一起，",
    "start": 111.709,
    "end": 115.709,
    "duration": 4.0
  },
  {
    "id": "sent_29",
    "text": "形成了全景展现社会横断面的开放式艺术结构。",
    "start": 116.159,
    "end": 120.999,
    "duration": 4.84
  },
  {
    "id": "sent_30",
    "text": "第三，融合悲悯情怀与理性批判，在针砭科举弊端中寄托真儒理想。",
    "start": 121.449,
    "end": 125.409,
    "duration": 3.96
  },
  {
    "id": "sent_31",
    "text": "吴敬梓的讽刺蕴含着深沉的士人忧患意识。",
    "start": 125.859,
    "end": 131.939,
    "duration": 6.08
  },
  {
    "id": "sent_32",
    "text": "在剖析周进、范进、马二先生等受科举扭曲戕害的士子的同时，",
    "start": 132.469,
    "end": 135.509,
    "duration": 3.04
  },
  {
    "id": "sent_33",
    "text": "全书首尾特意安排了王冕、杜少卿、庄绍光等不慕荣利的真儒贤士，",
    "start": 135.959,
    "end": 140.879,
    "duration": 4.92
  },
  {
    "id": "sent_34",
    "text": "在辛辣讽刺现实的同时树立了人格自立的精神尺度。",
    "start": 141.329,
    "end": 146.769,
    "duration": 5.44
  }
]