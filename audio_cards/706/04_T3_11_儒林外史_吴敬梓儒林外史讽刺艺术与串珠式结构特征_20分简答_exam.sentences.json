[
  {
    "id": 1,
    "text": "简述吴敬梓《儒林外史》的讽刺艺术与串珠式结构特征。",
    "start": 0.05,
    "end": 5.095,
    "duration": 5.045
  },
  {
    "id": 2,
    "text": "吴敬梓的 《儒林外史》 是中国古典长篇小说中讽刺艺术的最高峰，",
    "start": 5.095,
    "end": 10.383,
    "duration": 5.288
  },
  {
    "id": 3,
    "text": "标志着古代长篇讽刺小说文体的完全成熟。",
    "start": 10.383,
    "end": 14.041,
    "duration": 3.658
  },
  {
    "id": 4,
    "text": "面对清代八股取士制度对知识分子灵魂的摧残与士林道德的堕落，",
    "start": 14.041,
    "end": 19.837,
    "duration": 5.796
  },
  {
    "id": 5,
    "text": "吴敬梓以冷峻清醒的眼光，勾勒了一幅广阔的士林百丑图。",
    "start": 19.837,
    "end": 24.746,
    "duration": 4.909
  },
  {
    "id": 6,
    "text": "鲁迅在 《中国小说史略》 中评价其 “秉持公心，",
    "start": 24.746,
    "end": 29.315,
    "duration": 4.569
  },
  {
    "id": 7,
    "text": "指摘时病，机锋所向，尤在士林……其感受之速，分析之微，",
    "start": 29.315,
    "end": 33.21,
    "duration": 3.895
  },
  {
    "id": 8,
    "text": "卓越而不可及”。",
    "start": 33.21,
    "end": 34.615,
    "duration": 1.405
  },
  {
    "id": 9,
    "text": "《儒林外史》 的讽刺艺术与文体结构，",
    "start": 34.615,
    "end": 37.249,
    "duration": 2.634
  },
  {
    "id": 10,
    "text": "主要展现为以下三个核心维度：",
    "start": 37.249,
    "end": 40.534,
    "duration": 3.285
  },
  {
    "id": 11,
    "text": "第一，开创客观白描与反讽对比的讽刺艺术，达到“戚而能谐，",
    "start": 40.534,
    "end": 46.995,
    "duration": 6.461
  },
  {
    "id": 12,
    "text": "婉而多讽”的高超境界。",
    "start": 46.995,
    "end": 48.632,
    "duration": 1.637
  },
  {
    "id": 13,
    "text": "《儒林外史》 彻底摆脱了此前讽刺文学直接谩骂或粗暴说教的弊端，",
    "start": 48.632,
    "end": 54.932,
    "duration": 6.3
  },
  {
    "id": 14,
    "text": "采用纯粹客观的生活细节描写，",
    "start": 54.932,
    "end": 57.687,
    "duration": 2.755
  },
  {
    "id": 15,
    "text": "让讽刺对象在言行自相矛盾中暴露出可笑可悲的本质。",
    "start": 57.687,
    "end": 61.942,
    "duration": 4.255
  },
  {
    "id": 16,
    "text": "例如写严监生临终前因见灯盏里点着两茎灯草，",
    "start": 61.942,
    "end": 66.489,
    "duration": 4.547
  },
  {
    "id": 17,
    "text": "伸出两个指头迟迟不肯断气，挑掉一茎方才咽气；",
    "start": 66.489,
    "end": 70.627,
    "duration": 4.138
  },
  {
    "id": 18,
    "text": "写范进中举前受尽胡屠户掌掴唾骂，",
    "start": 70.627,
    "end": 73.883,
    "duration": 3.256
  },
  {
    "id": 19,
    "text": "中举发疯后胡屠户称其为 “文曲星下凡” 卑躬屈膝。",
    "start": 73.883,
    "end": 78.22,
    "duration": 4.337
  },
  {
    "id": 20,
    "text": "吴敬梓不加主观说教，仅以精准传神的客观白描与前后对照，",
    "start": 78.22,
    "end": 83.917,
    "duration": 5.697
  },
  {
    "id": 21,
    "text": "深刻讽刺了士人灵魂扭曲与世态炎凉。",
    "start": 83.917,
    "end": 88.12,
    "duration": 4.203
  },
  {
    "id": 22,
    "text": "第二，首创以功名富贵为核心的“串珠式”连缀结构，",
    "start": 88.12,
    "end": 92.622,
    "duration": 4.502
  },
  {
    "id": 23,
    "text": "开辟长篇叙事新格局。",
    "start": 92.622,
    "end": 94.758,
    "duration": 2.136
  },
  {
    "id": 24,
    "text": "在小说结构上，",
    "start": 94.758,
    "end": 96.247,
    "duration": 1.489
  },
  {
    "id": 25,
    "text": "《儒林外史》 突破了传统长篇小说必须由单一中心故事或主角贯穿始终的规制。",
    "start": 96.247,
    "end": 102.888,
    "duration": 6.641
  },
  {
    "id": 26,
    "text": "鲁迅概括其为 “虽云长篇，颇同短篇；各篇虽各独立，",
    "start": 102.888,
    "end": 106.564,
    "duration": 3.676
  },
  {
    "id": 27,
    "text": "而又相连结”。",
    "start": 106.564,
    "end": 108.023,
    "duration": 1.459
  },
  {
    "id": 28,
    "text": "全书以对 “功名富贵” 的态度为统摄主线，",
    "start": 108.023,
    "end": 111.609,
    "duration": 3.586
  },
  {
    "id": 29,
    "text": "前一个人物的故事刚近尾声，便引出下一个人物登场；",
    "start": 111.609,
    "end": 116.906,
    "duration": 5.297
  },
  {
    "id": 30,
    "text": "人物接力更替，如同丝线穿珠一般，将各色士人串联在一起，",
    "start": 116.906,
    "end": 122.101,
    "duration": 5.195
  },
  {
    "id": 31,
    "text": "形成了全景展现社会横断面的开放式艺术结构。",
    "start": 122.101,
    "end": 126.243,
    "duration": 4.142
  },
  {
    "id": 32,
    "text": "第三，融合悲悯情怀与理性批判，在针砭科举弊端中寄托真儒理想。",
    "start": 126.243,
    "end": 132.482,
    "duration": 6.239
  },
  {
    "id": 33,
    "text": "吴敬梓的讽刺蕴含着深沉的士人忧患意识。",
    "start": 132.482,
    "end": 136.064,
    "duration": 3.582
  },
  {
    "id": 34,
    "text": "在剖析周进、范进、马二先生等受科举扭曲戕害的士子的同时，",
    "start": 136.064,
    "end": 141.144,
    "duration": 5.08
  },
  {
    "id": 35,
    "text": "全书首尾特意安排了王冕、杜少卿、",
    "start": 141.144,
    "end": 144.212,
    "duration": 3.068
  },
  {
    "id": 36,
    "text": "庄绍光等不慕荣利的真儒贤士，",
    "start": 144.212,
    "end": 146.788,
    "duration": 2.576
  },
  {
    "id": 37,
    "text": "在辛辣讽刺现实的同时树立了人格自立的精神尺度。",
    "start": 146.788,
    "end": 150.936,
    "duration": 4.148
  }
]