[
  {
    "id": 1,
    "text": "简述吴敬梓《儒林外史》的讽刺艺术与串珠式结构特征。",
    "start": 0.112,
    "end": 4.816,
    "duration": 4.704
  },
  {
    "id": 2,
    "text": "吴敬梓的《儒林外史》标志着中国古代长篇讽刺小说的成熟。",
    "start": 4.952,
    "end": 9.434,
    "duration": 4.482
  },
  {
    "id": 3,
    "text": "鲁迅在《中国小说史略》中赞其“秉持公心，指摘时弊，机锋所向，尤在士林；其文又戚而能谐，婉而多讽”。",
    "start": 9.77,
    "end": 18.631,
    "duration": 8.861
  },
  {
    "id": 4,
    "text": "其讽刺艺术与结构特征，主要体现在以下三个方面：",
    "start": 18.913,
    "end": 22.7,
    "duration": 3.787
  },
  {
    "id": 5,
    "text": "第一，运用客观白描与矛盾对照，达到“戚而能谐，婉而多讽”的讽刺境界。",
    "start": 23.367,
    "end": 29.673,
    "duration": 6.306
  },
  {
    "id": 6,
    "text": "《儒林外史》摆脱了以往讽刺作品浅露谩骂的弊病，采取冷峻客观的生活白描，",
    "start": 29.988,
    "end": 35.819,
    "duration": 5.831
  },
  {
    "id": 7,
    "text": "让人物在日常言行的自相矛盾中自露真相，“无一贬词而情伪毕露”。",
    "start": 36.269,
    "end": 41.918,
    "duration": 5.649
  },
  {
    "id": 8,
    "text": "如写严监生临终因灯盏点着两茎灯草不肯断气，挑掉一茎方才咽气；",
    "start": 42.182,
    "end": 48.516,
    "duration": 6.334
  },
  {
    "id": 9,
    "text": "写范进中举前受尽岳父胡屠户唾骂，中举发疯后胡屠户则奉为“文曲星”卑躬屈膝。",
    "start": 48.825,
    "end": 56.648,
    "duration": 7.823
  },
  {
    "id": 10,
    "text": "吴敬梓不加空洞说教，而在滑稽可笑的表象中挖掘士子受科举戕害的悲哀，使讽刺兼具谐趣与悲悯。",
    "start": 57.046,
    "end": 65.799,
    "duration": 8.753
  },
  {
    "id": 11,
    "text": "第二，首创以功名富贵为统摄的“串珠式”连缀结构，开拓长篇叙事新体制。",
    "start": 66.46,
    "end": 72.622,
    "duration": 6.162
  },
  {
    "id": 12,
    "text": "在结构上，《儒林外史》打破了传统长篇依靠单一中心故事或核心人物贯穿始终的成规。",
    "start": 72.953,
    "end": 79.952,
    "duration": 6.999
  },
  {
    "id": 13,
    "text": "鲁迅概括其为“全书无主干，仅驱使各种人物，行列而来，事与其来俱起，亦与其去俱讫，虽云长篇，颇同短制”。",
    "start": 80.263,
    "end": 90.488,
    "duration": 10.225
  },
  {
    "id": 14,
    "text": "全书以士人对功名富贵的态度为内在主线，第一回“楔子”敷陈大义，",
    "start": 90.847,
    "end": 96.454,
    "duration": 5.607
  },
  {
    "id": 15,
    "text": "末回“幽榜”遥相呼应，中间人物接力登场、此落彼起，",
    "start": 96.767,
    "end": 101.018,
    "duration": 4.251
  },
  {
    "id": 16,
    "text": "如同丝线穿珠般串联起两百余名各色人物，全景式展现了世态群像。",
    "start": 101.322,
    "end": 107.058,
    "duration": 5.736
  },
  {
    "id": 17,
    "text": "第三，融批判锋芒与真儒理想于一体，寄托士人人格自立的追求。",
    "start": 107.721,
    "end": 113.288,
    "duration": 5.567
  },
  {
    "id": 18,
    "text": "吴敬梓的讽刺源自深沉的士林忧患意识。",
    "start": 113.552,
    "end": 116.65,
    "duration": 3.098
  },
  {
    "id": 19,
    "text": "小说在剖析周进、范进、匡超人等热衷科举者的精神堕落之余，",
    "start": 117.14,
    "end": 122.6,
    "duration": 5.46
  },
  {
    "id": 20,
    "text": "又特意安排王冕、杜少卿、庄绍光及市井四大奇人等不慕荣利、自食其力的人物，",
    "start": 122.961,
    "end": 129.376,
    "duration": 6.415
  },
  {
    "id": 21,
    "text": "在犀利批判科举流弊的同时，树立了崇尚德行与独立人格的精神标尺，",
    "start": 129.622,
    "end": 135.314,
    "duration": 5.692
  },
  {
    "id": 22,
    "text": "深刻影响了晚清谴责小说的发展。",
    "start": 135.487,
    "end": 138.047,
    "duration": 2.56
  }
]