[
  {
    "id": 1,
    "text": "简述吴敬梓《儒林外史》的讽刺艺术与串珠式结构特征。",
    "start": 0.2,
    "end": 5.0,
    "duration": 4.8
  },
  {
    "id": 2,
    "text": "吴敬梓的《儒林外史》标志着中国古代长篇讽刺小说的成熟。",
    "start": 5.52,
    "end": 10.24,
    "duration": 4.72
  },
  {
    "id": 3,
    "text": "鲁迅在《中国小说史略》中赞其“秉持公心，指摘时弊，机锋所向，尤在士林；其文又戚而能谐，婉而多讽”。",
    "start": 10.76,
    "end": 20.233,
    "duration": 9.473
  },
  {
    "id": 4,
    "text": "其讽刺艺术与结构特征，主要体现在以下三个方面：",
    "start": 20.733,
    "end": 24.37,
    "duration": 3.637
  },
  {
    "id": 5,
    "text": "第一，运用客观白描与矛盾对照，达到“戚而能谐，婉而多讽”的讽刺境界。",
    "start": 24.74,
    "end": 30.74,
    "duration": 6.0
  },
  {
    "id": 6,
    "text": "《儒林外史》摆脱了以往讽刺作品浅露谩骂的弊病，采取冷峻客观的生活白描，",
    "start": 31.26,
    "end": 38.016,
    "duration": 6.756
  },
  {
    "id": 7,
    "text": "让人物在日常言行的自相矛盾中自露真相，“无一贬词而情伪毕露”。",
    "start": 38.386,
    "end": 44.27,
    "duration": 5.884
  },
  {
    "id": 8,
    "text": "如写严监生临终因灯盏点着两茎灯草不肯断气，挑掉一茎方才咽气；",
    "start": 44.79,
    "end": 50.95,
    "duration": 6.16
  },
  {
    "id": 9,
    "text": "写范进中举前受尽岳父胡屠户唾骂，中举发疯后胡屠户则奉为“文曲星”卑躬屈膝。",
    "start": 51.47,
    "end": 58.11,
    "duration": 6.64
  },
  {
    "id": 10,
    "text": "吴敬梓不加空洞说教，而在滑稽可笑的表象中挖掘士子受科举戕害的悲哀，使讽刺兼具谐趣与悲悯。",
    "start": 58.63,
    "end": 67.03,
    "duration": 8.4
  },
  {
    "id": 11,
    "text": "第二，首创以功名富贵为统摄的“串珠式”连缀结构，开拓长篇叙事新体制。",
    "start": 67.55,
    "end": 73.939,
    "duration": 6.389
  },
  {
    "id": 12,
    "text": "在结构上，《儒林外史》打破了传统长篇依靠单一中心故事或核心人物贯穿始终的成规。",
    "start": 74.439,
    "end": 81.11,
    "duration": 6.671
  },
  {
    "id": 13,
    "text": "鲁迅概括其为“全书无主干，仅驱使各种人物，行列而来，事与其来俱起，亦与其去俱讫，虽云长篇，颇同短制”。",
    "start": 81.63,
    "end": 91.23,
    "duration": 9.6
  },
  {
    "id": 14,
    "text": "全书以士人对功名富贵的态度为内在主线，第一回“楔子”敷陈大义，",
    "start": 91.793,
    "end": 97.24,
    "duration": 5.447
  },
  {
    "id": 15,
    "text": "末回“幽榜”遥相呼应，中间人物接力登场、此落彼起，",
    "start": 97.61,
    "end": 101.69,
    "duration": 4.08
  },
  {
    "id": 16,
    "text": "如同丝线穿珠般串联起两百余名各色人物，全景式展现了世态群像。",
    "start": 102.06,
    "end": 107.34,
    "duration": 5.28
  },
  {
    "id": 17,
    "text": "第三，融批判锋芒与真儒理想于一体，寄托士人人格自立的追求。",
    "start": 107.86,
    "end": 113.38,
    "duration": 5.52
  },
  {
    "id": 18,
    "text": "吴敬梓的讽刺源自深沉的士林忧患意识。",
    "start": 113.9,
    "end": 117.58,
    "duration": 3.68
  },
  {
    "id": 19,
    "text": "小说在剖析周进、范进、匡超人等热衷科举者的精神堕落之余，",
    "start": 118.1,
    "end": 123.3,
    "duration": 5.2
  },
  {
    "id": 20,
    "text": "又特意安排王冕、杜少卿、庄绍光及市井四大奇人等不慕荣利、自食其力的人物，",
    "start": 123.67,
    "end": 130.23,
    "duration": 6.56
  },
  {
    "id": 21,
    "text": "在犀利批判科举流弊的同时，树立了崇尚德行与独立人格的精神标尺，",
    "start": 130.6,
    "end": 136.28,
    "duration": 5.68
  },
  {
    "id": 22,
    "text": "深刻影响了晚清谴责小说的发展。",
    "start": 136.65,
    "end": 139.13,
    "duration": 2.48
  }
]
