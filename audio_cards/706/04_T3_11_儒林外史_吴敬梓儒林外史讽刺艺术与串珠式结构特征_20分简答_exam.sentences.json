[
  {
    "id": 1,
    "text": "简述吴敬梓《儒林外史》的讽刺艺术与串珠式结构特征。",
    "start": 0.16,
    "end": 5.2,
    "duration": 5.04
  },
  {
    "id": 2,
    "text": "吴敬梓的 《儒林外史》 是中国古典长篇小说中讽刺艺术的最高峰，",
    "start": 5.2,
    "end": 11.04,
    "duration": 5.84
  },
  {
    "id": 3,
    "text": "标志着古代长篇讽刺小说文体的完全成熟。",
    "start": 11.04,
    "end": 14.96,
    "duration": 3.92
  },
  {
    "id": 4,
    "text": "面对清代八股取士制度对知识分子灵魂的摧残与士林道德的堕落，",
    "start": 14.96,
    "end": 20.88,
    "duration": 5.92
  },
  {
    "id": 5,
    "text": "吴敬梓以冷峻清醒的眼光，勾勒了一幅广阔的士林百丑图。",
    "start": 20.88,
    "end": 26.16,
    "duration": 5.28
  },
  {
    "id": 6,
    "text": "鲁迅在 《中国小说史略》 中评价其 “秉持公心，",
    "start": 26.16,
    "end": 31.12,
    "duration": 4.96
  },
  {
    "id": 7,
    "text": "指摘时病，机锋所向，尤在士林……其感受之速，分析之微，",
    "start": 31.2,
    "end": 36.64,
    "duration": 5.44
  },
  {
    "id": 8,
    "text": "卓越而不可及”。",
    "start": 36.64,
    "end": 38.16,
    "duration": 1.52
  },
  {
    "id": 9,
    "text": "《儒林外史》 的讽刺艺术与文体结构，",
    "start": 38.16,
    "end": 42.08,
    "duration": 3.92
  },
  {
    "id": 10,
    "text": "主要展现为以下三个核心维度：",
    "start": 42.08,
    "end": 44.96,
    "duration": 2.88
  },
  {
    "id": 11,
    "text": "第一，开创客观白描与反讽对比的讽刺艺术，达到“戚而能谐，",
    "start": 45.12,
    "end": 50.85,
    "duration": 5.73
  },
  {
    "id": 12,
    "text": "婉而多讽”的高超境界。",
    "start": 50.85,
    "end": 53.148,
    "duration": 2.298
  },
  {
    "id": 13,
    "text": "《儒林外史》 彻底摆脱了此前讽刺文学直接谩骂或粗暴说教的弊端，",
    "start": 53.148,
    "end": 59.416,
    "duration": 6.268
  },
  {
    "id": 14,
    "text": "采用纯粹客观的生活细节描写，",
    "start": 59.416,
    "end": 62.341,
    "duration": 2.925
  },
  {
    "id": 15,
    "text": "让讽刺对象在言行自相矛盾中暴露出可笑可悲的本质。",
    "start": 62.341,
    "end": 67.355,
    "duration": 5.014
  },
  {
    "id": 16,
    "text": "例如写严监生临终前因见灯盏里点着两茎灯草，",
    "start": 67.355,
    "end": 72.72,
    "duration": 5.365
  },
  {
    "id": 17,
    "text": "伸出两个指头迟迟不肯断气，挑掉一茎方才咽气；",
    "start": 72.72,
    "end": 78.32,
    "duration": 5.6
  },
  {
    "id": 18,
    "text": "写范进中举前受尽胡屠户掌掴唾骂，",
    "start": 78.32,
    "end": 81.6,
    "duration": 3.28
  },
  {
    "id": 19,
    "text": "中举发疯后胡屠户称其为 “文曲星下凡” 卑躬屈膝。",
    "start": 81.6,
    "end": 87.04,
    "duration": 5.44
  },
  {
    "id": 20,
    "text": "吴敬梓不加主观说教，仅以精准传神的客观白描与前后对照，",
    "start": 87.04,
    "end": 93.68,
    "duration": 6.64
  },
  {
    "id": 21,
    "text": "深刻讽刺了士人灵魂扭曲与世态炎凉。",
    "start": 93.68,
    "end": 97.52,
    "duration": 3.84
  },
  {
    "id": 22,
    "text": "第二，首创以功名富贵为核心的“串珠式”连缀结构，",
    "start": 97.52,
    "end": 102.24,
    "duration": 4.72
  },
  {
    "id": 23,
    "text": "开辟长篇叙事新格局。",
    "start": 102.24,
    "end": 104.88,
    "duration": 2.64
  },
  {
    "id": 24,
    "text": "在小说结构上，",
    "start": 104.88,
    "end": 106.72,
    "duration": 1.84
  },
  {
    "id": 25,
    "text": "《儒林外史》 突破了传统长篇小说必须由单一中心故事或主角贯穿始终的规制。",
    "start": 106.72,
    "end": 114.472,
    "duration": 7.752
  },
  {
    "id": 26,
    "text": "鲁迅概括其为 “虽云长篇，颇同短篇；各篇虽各独立，",
    "start": 114.472,
    "end": 119.12,
    "duration": 4.648
  },
  {
    "id": 27,
    "text": "而又相连结”。",
    "start": 119.12,
    "end": 120.72,
    "duration": 1.6
  },
  {
    "id": 28,
    "text": "全书以对 “功名富贵” 的态度为统摄主线，",
    "start": 120.72,
    "end": 124.48,
    "duration": 3.76
  },
  {
    "id": 29,
    "text": "前一个人物的故事刚近尾声，便引出下一个人物登场；",
    "start": 124.48,
    "end": 130.32,
    "duration": 5.84
  },
  {
    "id": 30,
    "text": "人物接力更替，如同丝线穿珠一般，将各色士人串联在一起，",
    "start": 130.32,
    "end": 135.6,
    "duration": 5.28
  },
  {
    "id": 31,
    "text": "形成了全景展现社会横断面的开放式艺术结构。",
    "start": 135.6,
    "end": 140.0,
    "duration": 4.4
  },
  {
    "id": 32,
    "text": "第三，融合悲悯情怀与理性批判，在针砭科举弊端中寄托真儒理想。",
    "start": 140.0,
    "end": 146.16,
    "duration": 6.16
  },
  {
    "id": 33,
    "text": "吴敬梓的讽刺蕴含着深沉的士人忧患意识。",
    "start": 146.16,
    "end": 149.92,
    "duration": 3.76
  },
  {
    "id": 34,
    "text": "在剖析周进、范进、马二先生等受科举扭曲戕害的士子的同时，",
    "start": 149.92,
    "end": 150.72,
    "duration": 0.8
  },
  {
    "id": 35,
    "text": "全书首尾特意安排了王冕、杜少卿、",
    "start": 150.56,
    "end": 150.72,
    "duration": 0.16
  },
  {
    "id": 36,
    "text": "庄绍光等不慕荣利的真儒贤士，",
    "start": 150.56,
    "end": 150.72,
    "duration": 0.16
  },
  {
    "id": 37,
    "text": "在辛辣讽刺现实的同时树立了人格自立的精神尺度。",
    "start": 150.56,
    "end": 150.72,
    "duration": 0.16
  }
]