[
  {
    "id": "sent_1",
    "text": "吴敬梓的 《儒林外史》 是中国古典长篇小说中讽刺艺术的最高峰，",
    "start": 0.1,
    "end": 5.909,
    "duration": 5.809
  },
  {
    "id": "sent_2",
    "text": "标志着古代长篇讽刺小说文体的完全成熟。",
    "start": 5.859,
    "end": 10.052,
    "duration": 4.193
  },
  {
    "id": "sent_3",
    "text": "面对清代八股取士制度对知识分子灵魂的摧残与士林道德的堕落，",
    "start": 10.052,
    "end": 16.133,
    "duration": 6.081
  },
  {
    "id": "sent_4",
    "text": "吴敬梓以冷峻清醒的眼光，勾勒了一幅广阔的士林百丑图。",
    "start": 16.133,
    "end": 21.927,
    "duration": 5.794
  },
  {
    "id": "sent_5",
    "text": "鲁迅在 《中国小说史略》 中评价其 “秉持公心，指摘时病，",
    "start": 21.927,
    "end": 27.122,
    "duration": 5.195
  },
  {
    "id": "sent_6",
    "text": "机锋所向，尤在士林……其感受之速，分析之微，卓越而不可及”。",
    "start": 27.122,
    "end": 33.515,
    "duration": 6.393
  },
  {
    "id": "sent_7",
    "text": "《儒林外史》 的讽刺艺术与文体结构，主要展现为以下三个核心维度：",
    "start": 33.516,
    "end": 39.597,
    "duration": 6.081
  },
  {
    "id": "sent_8",
    "text": "第一，开创客观白描与反讽对比的讽刺艺术，达到“戚而能谐，",
    "start": 39.596,
    "end": 45.442,
    "duration": 5.846
  },
  {
    "id": "sent_9",
    "text": "婉而多讽”的高超境界。",
    "start": 45.443,
    "end": 47.839,
    "duration": 2.396
  },
  {
    "id": "sent_10",
    "text": "《儒林外史》 彻底摆脱了此前讽刺文学直接谩骂或粗暴说教的弊端，",
    "start": 47.839,
    "end": 54.258,
    "duration": 6.419
  },
  {
    "id": "sent_11",
    "text": "采用纯粹客观的生活细节描写，",
    "start": 54.258,
    "end": 57.461,
    "duration": 3.203
  },
  {
    "id": "sent_12",
    "text": "让讽刺对象在言行自相矛盾中暴露出可笑可悲的本质。",
    "start": 57.461,
    "end": 62.904,
    "duration": 5.443
  },
  {
    "id": "sent_13",
    "text": "例如写严监生临终前因见灯盏里点着两茎灯草，",
    "start": 62.904,
    "end": 67.904,
    "duration": 5.0
  },
  {
    "id": "sent_14",
    "text": "伸出两个指头迟迟不肯断气，挑掉一茎方才咽气；",
    "start": 67.904,
    "end": 72.995,
    "duration": 5.091
  },
  {
    "id": "sent_15",
    "text": "写范进中举前受尽胡屠户掌掴唾骂，",
    "start": 72.994,
    "end": 76.745,
    "duration": 3.751
  },
  {
    "id": "sent_16",
    "text": "中举发疯后胡屠户称其为 “文曲星下凡” 卑躬屈膝。",
    "start": 76.745,
    "end": 81.667,
    "duration": 4.922
  },
  {
    "id": "sent_17",
    "text": "吴敬梓不加主观说教，仅以精准传神的客观白描与前后对照，",
    "start": 81.667,
    "end": 87.539,
    "duration": 5.872
  },
  {
    "id": "sent_18",
    "text": "深刻讽刺了士人灵魂扭曲与世态炎凉。",
    "start": 87.539,
    "end": 91.81,
    "duration": 4.271
  },
  {
    "id": "sent_19",
    "text": "第二，首创以功名富贵为核心的“串珠式”连缀结构，",
    "start": 91.81,
    "end": 96.797,
    "duration": 4.987
  },
  {
    "id": "sent_20",
    "text": "开辟长篇叙事新格局。",
    "start": 96.797,
    "end": 99.401,
    "duration": 2.604
  },
  {
    "id": "sent_21",
    "text": "在小说结构上，",
    "start": 99.401,
    "end": 101.302,
    "duration": 1.901
  },
  {
    "id": "sent_22",
    "text": "《儒林外史》 突破了传统长篇小说必须由单一中心故事或主角贯穿始终的规制。",
    "start": 101.302,
    "end": 108.646,
    "duration": 7.344
  },
  {
    "id": "sent_23",
    "text": "鲁迅概括其为 “虽云长篇，颇同短篇；",
    "start": 108.646,
    "end": 112.63,
    "duration": 3.984
  },
  {
    "id": "sent_24",
    "text": "各篇虽各独立，而又相连结”。",
    "start": 112.63,
    "end": 115.924,
    "duration": 3.294
  },
  {
    "id": "sent_25",
    "text": "全书以对 “功名富贵” 的态度为统摄主线，",
    "start": 115.924,
    "end": 119.635,
    "duration": 3.711
  },
  {
    "id": "sent_26",
    "text": "前一个人物的故事刚近尾声，便引出下一个人物登场；",
    "start": 119.635,
    "end": 124.179,
    "duration": 4.544
  },
  {
    "id": "sent_27",
    "text": "人物接力更替，如同丝线穿珠一般，将各色士人串联在一起，",
    "start": 124.18,
    "end": 129.987,
    "duration": 5.807
  },
  {
    "id": "sent_28",
    "text": "形成了全景展现社会横断面的开放式艺术结构。",
    "start": 129.987,
    "end": 134.336,
    "duration": 4.349
  },
  {
    "id": "sent_29",
    "text": "第三，融合悲悯情怀与理性批判，在针砭科举弊端中寄托真儒理想。",
    "start": 134.336,
    "end": 141.406,
    "duration": 7.07
  },
  {
    "id": "sent_30",
    "text": "吴敬梓的讽刺蕴含着深沉的士人忧患意识。",
    "start": 141.406,
    "end": 145.638,
    "duration": 4.232
  },
  {
    "id": "sent_31",
    "text": "在剖析周进、范进、马二先生等受科举扭曲戕害的士子的同时，",
    "start": 145.638,
    "end": 151.966,
    "duration": 6.328
  },
  {
    "id": "sent_32",
    "text": "全书首尾特意安排了王冕、杜少卿、庄绍光等不慕荣利的真儒贤士，",
    "start": 151.966,
    "end": 158.581,
    "duration": 6.615
  },
  {
    "id": "sent_33",
    "text": "在辛辣讽刺现实的同时树立了人格自立的精神尺度。",
    "start": 158.581,
    "end": 163.477,
    "duration": 4.896
  }
]