[
  {
    "id": 1,
    "text": "试论屈原《离骚》的思想意蕴与艺术成就。",
    "start": 0.16,
    "end": 3.351,
    "duration": 3.191
  },
  {
    "id": 2,
    "text": "《离骚》是中国古典文学史上篇幅宏大、",
    "start": 3.774,
    "end": 6.863,
    "duration": 3.089
  },
  {
    "id": 3,
    "text": "抒情深沉的浪漫主义政治抒情长诗。",
    "start": 7.084,
    "end": 10.05,
    "duration": 2.966
  },
  {
    "id": 4,
    "text": "面对战国中后期楚国贵族腐朽、强秦逼迫的危局，",
    "start": 10.302,
    "end": 14.311,
    "duration": 4.009
  },
  {
    "id": 5,
    "text": "屈原打破了先秦诗歌集体歌唱与四言短小的格局，",
    "start": 14.782,
    "end": 18.938,
    "duration": 4.156
  },
  {
    "id": 6,
    "text": "首次树立了个体抒情主人公峻洁崇高的艺术形象。",
    "start": 19.229,
    "end": 23.273,
    "duration": 4.044
  },
  {
    "id": 7,
    "text": "司马迁在《史记·屈原贾生列传》中推崇备至，",
    "start": 23.873,
    "end": 27.782,
    "duration": 3.909
  },
  {
    "id": 8,
    "text": "称其“虽与日月争光可也”。",
    "start": 27.968,
    "end": 30.291,
    "duration": 2.323
  },
  {
    "id": 9,
    "text": "其思想意蕴与艺术成就，主要体现在以下四个方面：",
    "start": 30.564,
    "end": 34.403,
    "duration": 3.839
  },
  {
    "id": 10,
    "text": "第一，确立“美政”政治理想，展现至死不渝的爱国忠贞与气节。",
    "start": 35.041,
    "end": 40.474,
    "duration": 5.433
  },
  {
    "id": 11,
    "text": "《离骚》的思想灵魂是屈原贯彻终生的“美政”理想，",
    "start": 40.947,
    "end": 44.703,
    "duration": 3.756
  },
  {
    "id": 12,
    "text": "即主张修明法度、举贤授能，明君贤臣共兴楚国。",
    "start": 45.301,
    "end": 50.016,
    "duration": 4.715
  },
  {
    "id": 13,
    "text": "面对楚国政局黑暗与宗国危殆，诗人怀抱深沉忧患，",
    "start": 50.514,
    "end": 54.866,
    "duration": 4.352
  },
  {
    "id": 14,
    "text": "发出“长太息以掩涕兮，哀民生之多艰”的悲切叹息。",
    "start": 55.118,
    "end": 60.153,
    "duration": 5.035
  },
  {
    "id": 15,
    "text": "即便惨遭党人谗害、君王疏远，他依然洁身自好、不随波逐流；",
    "start": 60.449,
    "end": 65.505,
    "duration": 5.056
  },
  {
    "id": 16,
    "text": "面对权贵围攻，诗人以决绝意志誓守人格操守，",
    "start": 65.769,
    "end": 69.835,
    "duration": 4.066
  },
  {
    "id": 17,
    "text": "宣告“亦余心之所善兮，虽九死其犹未悔”。",
    "start": 70.201,
    "end": 74.249,
    "duration": 4.048
  },
  {
    "id": 18,
    "text": "这种将个体生命与祖国存亡紧系于一体的精神，",
    "start": 74.596,
    "end": 78.156,
    "duration": 3.56
  },
  {
    "id": 19,
    "text": "铸就了古代士人崇高的忠贞气节。",
    "start": 78.575,
    "end": 81.161,
    "duration": 2.586
  },
  {
    "id": 20,
    "text": "第二，拓展比兴寄托传统，开创系统的“香草美人”象征体系。",
    "start": 81.811,
    "end": 87.408,
    "duration": 5.597
  },
  {
    "id": 21,
    "text": "屈原发展了《诗经》早期的比兴手法，",
    "start": 87.849,
    "end": 90.332,
    "duration": 2.483
  },
  {
    "id": 22,
    "text": "建立起高度成熟的政治道德象征体系。",
    "start": 90.685,
    "end": 93.404,
    "duration": 2.719
  },
  {
    "id": 23,
    "text": "他以芳草嘉木、世俗男女寄寓高尚情操与君臣遇合：",
    "start": 93.826,
    "end": 98.208,
    "duration": 4.382
  },
  {
    "id": 24,
    "text": "全诗以辟芷、秋兰、木兰、宿莽等香草，",
    "start": 98.864,
    "end": 102.468,
    "duration": 3.604
  },
  {
    "id": 25,
    "text": "象征自身纯洁志行与治国才能，名句“朝饮木兰之坠露兮，",
    "start": 102.702,
    "end": 107.855,
    "duration": 5.153
  },
  {
    "id": 26,
    "text": "夕餐秋菊之落英”生动呈现出其峻洁拔俗的修养；与之相对，",
    "start": 108.167,
    "end": 113.73,
    "duration": 5.563
  },
  {
    "id": 27,
    "text": "以萧艾等恶草比喻贪婪短视的谗谄宵小，",
    "start": 114.052,
    "end": 117.87,
    "duration": 3.818
  },
  {
    "id": 28,
    "text": "以“美人”或求女寄托贤君知己之思。",
    "start": 118.214,
    "end": 121.588,
    "duration": 3.374
  },
  {
    "id": 29,
    "text": "这一象征体系使古典诗歌意象由单一物象比附，",
    "start": 121.846,
    "end": 125.924,
    "duration": 4.078
  },
  {
    "id": 30,
    "text": "升华为蕴含人格理想与政治寓托的艺术符号。",
    "start": 126.221,
    "end": 129.96,
    "duration": 3.739
  },
  {
    "id": 31,
    "text": "第三，构筑虚实相生的宏伟构架，交织现实受挫与天界神游。",
    "start": 130.602,
    "end": 136.632,
    "duration": 6.03
  },
  {
    "id": 32,
    "text": "《离骚》在篇章结构上展现出奇伟的想象力，",
    "start": 137.103,
    "end": 140.321,
    "duration": 3.218
  },
  {
    "id": 33,
    "text": "形成现实沉沦与幻想飞升交织的壮阔波澜。",
    "start": 140.705,
    "end": 144.642,
    "duration": 3.937
  },
  {
    "id": 34,
    "text": "全诗前半部分立足现实，自叙高贵出身、",
    "start": 144.994,
    "end": 148.668,
    "duration": 3.674
  },
  {
    "id": 35,
    "text": "修身自励与遭谗被弃的悲愤；后半部分笔锋飞升，",
    "start": 148.86,
    "end": 153.194,
    "duration": 4.334
  },
  {
    "id": 36,
    "text": "借助神话传说展开天界上下求索。",
    "start": 153.546,
    "end": 156.429,
    "duration": 2.883
  },
  {
    "id": 37,
    "text": "诗人命羲和弭节、使望舒先驱、驾飞龙鸾凤叩击九重天门，",
    "start": 157.116,
    "end": 162.508,
    "duration": 5.392
  },
  {
    "id": 38,
    "text": "求女不遂后又从灵氛、巫咸之占寻找出路；但当飞升云霓之上、",
    "start": 163.031,
    "end": 168.441,
    "duration": 5.41
  },
  {
    "id": 39,
    "text": "俯瞰故土宗国之时，诗篇写道“陟升皇之赫戏兮，",
    "start": 168.905,
    "end": 173.382,
    "duration": 4.477
  },
  {
    "id": 40,
    "text": "忽临睨夫旧乡”，仆夫悲、马怀顾而不行，",
    "start": 173.624,
    "end": 177.081,
    "duration": 3.457
  },
  {
    "id": 41,
    "text": "最终从神幻天界剧烈跌回现实悲剧，产生震撼人心的悲壮力量。",
    "start": 177.213,
    "end": 182.695,
    "duration": 5.482
  },
  {
    "id": 42,
    "text": "第四，创立骚体全新诗体，展现参差流转的语言张力与楚地声韵。",
    "start": 183.386,
    "end": 189.14,
    "duration": 5.754
  },
  {
    "id": 43,
    "text": "《离骚》在体式上打破了《诗经》四言为主的整齐格局。",
    "start": 189.452,
    "end": 193.241,
    "duration": 3.789
  },
  {
    "id": 44,
    "text": "屈原吸收楚地民歌与巫祭乐歌养分，创立了句式长短错落、",
    "start": 193.651,
    "end": 198.721,
    "duration": 5.07
  },
  {
    "id": 45,
    "text": "舒卷自由的“骚体”，",
    "start": 199.171,
    "end": 200.403,
    "duration": 1.232
  },
  {
    "id": 46,
    "text": "全诗广泛运用荆楚方言语气词“兮”字调节声律。",
    "start": 200.799,
    "end": 204.817,
    "duration": 4.018
  },
  {
    "id": 47,
    "text": "“兮”字置于句中或句末，拖长了叹息与呼告的语流，",
    "start": 205.065,
    "end": 208.927,
    "duration": 3.862
  },
  {
    "id": 48,
    "text": "营造出长歌当哭、凄婉回环的音乐节奏；加之方言名物、",
    "start": 209.282,
    "end": 213.897,
    "duration": 4.615
  },
  {
    "id": 49,
    "text": "双声叠韵与华美词采的融汇，不仅直接孕育了汉代辞赋的产生，",
    "start": 214.151,
    "end": 219.023,
    "duration": 4.872
  },
  {
    "id": 50,
    "text": "更极大地拓宽了中国古典诗歌的表现疆域。",
    "start": 219.193,
    "end": 222.242,
    "duration": 3.049
  }
]