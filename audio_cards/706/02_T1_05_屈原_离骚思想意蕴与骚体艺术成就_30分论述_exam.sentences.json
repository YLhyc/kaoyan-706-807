[
  {
    "id": 1,
    "text": "试论屈原《离骚》的思想意蕴与艺术成就。",
    "start": 0.28,
    "end": 3.16,
    "duration": 2.88
  },
  {
    "id": 2,
    "text": "《离骚》是中国古典文学史上篇幅宏大、抒情深沉的浪漫主义政治抒情长诗。",
    "start": 3.68,
    "end": 10.08,
    "duration": 6.4
  },
  {
    "id": 3,
    "text": "面对战国中后期楚国贵族腐朽、强秦逼迫的危局，屈原打破了先秦诗歌集体歌唱与四言短小的格局，",
    "start": 10.6,
    "end": 19.37,
    "duration": 8.77
  },
  {
    "id": 4,
    "text": "树立了个体抒情主人公峻洁崇高的艺术形象。",
    "start": 19.77,
    "end": 23.37,
    "duration": 3.6
  },
  {
    "id": 5,
    "text": "司马迁在《史记·屈原贾生列传》中推崇备至，称其“虽与日月争光可也”。",
    "start": 23.89,
    "end": 30.676,
    "duration": 6.786
  },
  {
    "id": 6,
    "text": "其思想意蕴与艺术成就，主要体现在以下四个方面：",
    "start": 31.176,
    "end": 35.37,
    "duration": 4.194
  },
  {
    "id": 7,
    "text": "第一，确立“美政”政治理想，展现至死不渝的爱国忠贞与气节。",
    "start": 35.74,
    "end": 40.62,
    "duration": 4.88
  },
  {
    "id": 8,
    "text": "《离骚》的思想灵魂是屈原贯彻终生的“美政”理想，",
    "start": 41.14,
    "end": 45.653,
    "duration": 4.513
  },
  {
    "id": 9,
    "text": "即主张修明法度、举贤授能，明君贤臣共兴楚国。",
    "start": 46.008,
    "end": 50.31,
    "duration": 4.302
  },
  {
    "id": 10,
    "text": "面对楚国政局黑暗与宗国危殆，诗人怀抱深沉忧患，发出“长太息以掩涕兮，哀民生之多艰”的悲切叹息。",
    "start": 50.83,
    "end": 60.83,
    "duration": 10.0
  },
  {
    "id": 11,
    "text": "即便惨遭党人谗害、君王疏远，他依然洁身自好、不随波逐流；",
    "start": 61.35,
    "end": 66.71,
    "duration": 5.36
  },
  {
    "id": 12,
    "text": "面对权贵围攻，诗人以决绝意志誓守人格操守，宣告“亦余心之所善兮，虽九死其犹未悔”。",
    "start": 67.23,
    "end": 76.67,
    "duration": 9.44
  },
  {
    "id": 13,
    "text": "这种将个体生命与祖国存亡紧系于一体的精神，铸就了古代士人崇高的忠贞气节。",
    "start": 77.19,
    "end": 84.07,
    "duration": 6.88
  },
  {
    "id": 14,
    "text": "第二，拓展比兴寄托传统，开创系统的“香草美人”象征体系。",
    "start": 84.59,
    "end": 90.173,
    "duration": 5.583
  },
  {
    "id": 15,
    "text": "屈原发展了《诗经》早期的比兴手法，建立起高度成熟的政治道德象征体系。",
    "start": 90.673,
    "end": 95.99,
    "duration": 5.317
  },
  {
    "id": 16,
    "text": "他以芳草嘉木、世俗男女寄寓高尚情操与君臣遇合：",
    "start": 96.51,
    "end": 101.23,
    "duration": 4.72
  },
  {
    "id": 17,
    "text": "全诗以辟芷、秋兰、木兰、宿莽等香草，象征自身纯洁志行与治国才能，",
    "start": 101.6,
    "end": 109.41,
    "duration": 7.81
  },
  {
    "id": 18,
    "text": "名句“朝饮木兰之坠露兮，夕餐秋菊之落英”生动呈现出其峻洁拔俗的修养；",
    "start": 109.78,
    "end": 117.06,
    "duration": 7.28
  },
  {
    "id": 19,
    "text": "与之相对，以萧艾等恶草比喻贪婪短视的谗谄宵小，以“美人”或求女寄托贤君知己之思。",
    "start": 117.58,
    "end": 125.58,
    "duration": 8.0
  },
  {
    "id": 20,
    "text": "这一象征体系使古典诗歌意象由单一物象比附，升华为蕴含人格理想与政治寓托的艺术符号。",
    "start": 126.1,
    "end": 134.58,
    "duration": 8.48
  },
  {
    "id": 21,
    "text": "第三，构筑虚实相生的宏伟构架，交织现实受挫与天界神游。",
    "start": 135.1,
    "end": 140.46,
    "duration": 5.36
  },
  {
    "id": 22,
    "text": "《离骚》在篇章结构上展现出奇伟的想象力，形成现实沉沦与幻想飞升交织的壮阔波澜。",
    "start": 140.98,
    "end": 148.565,
    "duration": 7.585
  },
  {
    "id": 23,
    "text": "全诗前半部分立足现实，自叙高贵出身、修身自励与遭谗被弃的悲愤；",
    "start": 149.065,
    "end": 155.5,
    "duration": 6.435
  },
  {
    "id": 24,
    "text": "后半部分笔锋飞升，借助神话传说展开天界上下求索。",
    "start": 156.02,
    "end": 161.3,
    "duration": 5.28
  },
  {
    "id": 25,
    "text": "诗人命羲和弭节、使望舒先驱、驾飞龙鸾凤叩击九重天门，",
    "start": 161.845,
    "end": 167.26,
    "duration": 5.415
  },
  {
    "id": 26,
    "text": "求女不遂后又从灵氛、巫咸之占寻找出路；",
    "start": 167.672,
    "end": 171.23,
    "duration": 3.558
  },
  {
    "id": 27,
    "text": "但当飞升云霓之上、俯瞰故土宗国之时，诗篇写道“陟升皇之赫戏兮，忽临睨夫旧乡”，",
    "start": 171.75,
    "end": 179.08,
    "duration": 7.33
  },
  {
    "id": 28,
    "text": "仆夫悲、马怀顾而不行，最终从神幻天界剧烈跌回现实悲剧，产生震撼人心的悲壮力量。",
    "start": 179.45,
    "end": 186.57,
    "duration": 7.12
  },
  {
    "id": 29,
    "text": "第四，创立骚体全新诗体，展现参差流转的语言张力与楚地声韵。",
    "start": 187.09,
    "end": 192.53,
    "duration": 5.44
  },
  {
    "id": 30,
    "text": "《离骚》在体式上打破了《诗经》四言为主的整齐格局。",
    "start": 193.05,
    "end": 197.21,
    "duration": 4.16
  },
  {
    "id": 31,
    "text": "屈原吸收楚地民歌与巫祭乐歌养分，创立了句式长短错落、舒卷自由的“骚体”，",
    "start": 197.73,
    "end": 204.5,
    "duration": 6.77
  },
  {
    "id": 32,
    "text": "全诗广泛运用荆楚方言语气词“兮”字调节声律。",
    "start": 204.87,
    "end": 209.03,
    "duration": 4.16
  },
  {
    "id": 33,
    "text": "“兮”字置于句中或句末，拖长了叹息与呼告的语流，营造出长歌当哭、凄婉回环的音乐节奏；",
    "start": 209.55,
    "end": 217.71,
    "duration": 8.16
  },
  {
    "id": 34,
    "text": "加之方言名物、双声叠韵与华美词采的融汇，",
    "start": 218.23,
    "end": 222.31,
    "duration": 4.08
  },
  {
    "id": 35,
    "text": "不仅直接孕育了汉代辞赋的产生，更极大地拓宽了中国古典诗歌的表现疆域。",
    "start": 222.68,
    "end": 228.52,
    "duration": 5.84
  },
  {
    "id": 36,
    "text": "由是观之，屈原在《离骚》中以楚国危局下的美政坚守为核心，",
    "start": 229.04,
    "end": 234.64,
    "duration": 5.6
  },
  {
    "id": 37,
    "text": "凭借“香草美人”象征体系、天界神游构架与回环流动的骚体句式，",
    "start": 235.01,
    "end": 240.45,
    "duration": 5.44
  },
  {
    "id": 38,
    "text": "完成了由先秦集体歌谣向文人个体抒情长诗的历史跨越。",
    "start": 240.82,
    "end": 245.54,
    "duration": 4.72
  },
  {
    "id": 39,
    "text": "作品所蕴含的九死未悔忠贞气节与奇伟瑰丽辞采，不仅直接孕育了汉代辞赋，",
    "start": 246.06,
    "end": 252.99,
    "duration": 6.93
  },
  {
    "id": 40,
    "text": "更在后世文人心灵中积淀为深厚的忧国爱国传统。",
    "start": 253.36,
    "end": 257.52,
    "duration": 4.16
  }
]
