[
  {
    "id": "sent_1",
    "text": "《离骚》 是中国古典文学史上篇幅最宏大、抒情最深沉的浪漫主义政治抒情长诗。",
    "start": 0.1,
    "end": 7.902,
    "duration": 7.802
  },
  {
    "id": "sent_2",
    "text": "面对战国中后期楚国宗国内部贵族腐朽、外部强秦逼迫的历史危局，",
    "start": 7.852,
    "end": 14.675,
    "duration": 6.823
  },
  {
    "id": "sent_3",
    "text": "屈原打破了先秦诗歌集体歌唱与短小体式的格局，",
    "start": 14.674,
    "end": 19.388,
    "duration": 4.714
  },
  {
    "id": "sent_4",
    "text": "首次确立了个体抒情主人公崇高峻洁的艺术形象。",
    "start": 19.388,
    "end": 24.44,
    "duration": 5.052
  },
  {
    "id": "sent_5",
    "text": "司马迁在 《史记·屈原贾生列传》 中推崇备至，",
    "start": 24.44,
    "end": 28.88,
    "duration": 4.44
  },
  {
    "id": "sent_6",
    "text": "称其 “虽与日月争光可也”。",
    "start": 28.88,
    "end": 31.836,
    "duration": 2.956
  },
  {
    "id": "sent_7",
    "text": "其博大深沉的思想意蕴与杰出的艺术成就，",
    "start": 31.836,
    "end": 36.042,
    "duration": 4.206
  },
  {
    "id": "sent_8",
    "text": "主要展现为以下四个核心维度：",
    "start": 36.042,
    "end": 39.349,
    "duration": 3.307
  },
  {
    "id": "sent_9",
    "text": "第一，确立“美政”政治理想，展现至死不渝的忠贞爱国与牺牲精神。",
    "start": 39.349,
    "end": 45.781,
    "duration": 6.432
  },
  {
    "id": "sent_10",
    "text": "《离骚》 的思想灵魂是屈原贯彻终生的 “美政” 理想。",
    "start": 45.781,
    "end": 50.312,
    "duration": 4.531
  },
  {
    "id": "sent_11",
    "text": "所谓美政，即主张选贤任能、修明法度，对内实行德治仁政，",
    "start": 50.313,
    "end": 56.029,
    "duration": 5.716
  },
  {
    "id": "sent_12",
    "text": "对外抗秦固楚。",
    "start": 56.029,
    "end": 57.995,
    "duration": 1.966
  },
  {
    "id": "sent_13",
    "text": "面对楚国贵族结党营私与宗国危殆，诗人怀抱深切的忧患意识，",
    "start": 57.995,
    "end": 64.115,
    "duration": 6.12
  },
  {
    "id": "sent_14",
    "text": "发出 “长太息以掩涕兮，哀民生之多艰” 的悲切叹息。",
    "start": 64.115,
    "end": 69.011,
    "duration": 4.896
  },
  {
    "id": "sent_15",
    "text": "即便自身惨遭谗谄放逐、身陷险境，他依然不随波逐流；",
    "start": 69.01,
    "end": 74.83,
    "duration": 5.82
  },
  {
    "id": "sent_16",
    "text": "面对权贵的威逼围攻，诗人以决绝的意志誓死捍卫人格操守，",
    "start": 74.83,
    "end": 80.794,
    "duration": 5.964
  },
  {
    "id": "sent_17",
    "text": "宣告 “亦余心之所善兮，虽九死其犹未悔”。",
    "start": 80.794,
    "end": 84.896,
    "duration": 4.102
  },
  {
    "id": "sent_18",
    "text": "这种将个体生命与祖国存亡紧密相连的爱国忠贞，",
    "start": 84.896,
    "end": 89.948,
    "duration": 5.052
  },
  {
    "id": "sent_19",
    "text": "铸就了古典士人崇高的精神气节。",
    "start": 89.948,
    "end": 93.307,
    "duration": 3.359
  },
  {
    "id": "sent_20",
    "text": "第二，拓展比兴寄托传统，开创系统的“香草美人”象征表现体系。",
    "start": 93.307,
    "end": 99.284,
    "duration": 5.977
  },
  {
    "id": "sent_21",
    "text": "屈原极大拓展了 《诗经》 原初的物象比兴手法，",
    "start": 99.284,
    "end": 103.451,
    "duration": 4.167
  },
  {
    "id": "sent_22",
    "text": "建立了高度成熟的象征艺术体系。",
    "start": 103.451,
    "end": 106.693,
    "duration": 3.242
  },
  {
    "id": "sent_23",
    "text": "他将自然草木与世俗男女赋予崇高的政治道德内涵：",
    "start": 106.693,
    "end": 111.836,
    "duration": 5.143
  },
  {
    "id": "sent_24",
    "text": "全诗以辟芷、秋兰、木兰、宿莽等香草嘉卉，",
    "start": 111.836,
    "end": 116.771,
    "duration": 4.935
  },
  {
    "id": "sent_25",
    "text": "象征自身纯洁高尚的情操与治国才华；",
    "start": 116.771,
    "end": 120.794,
    "duration": 4.023
  },
  {
    "id": "sent_26",
    "text": "诗中名句写道 “朝饮木兰之坠露兮，夕餐秋菊之落英”，",
    "start": 120.794,
    "end": 126.015,
    "duration": 5.221
  },
  {
    "id": "sent_27",
    "text": "生动呈现出其峻洁拔俗的精神追求。",
    "start": 126.016,
    "end": 129.74,
    "duration": 3.724
  },
  {
    "id": "sent_28",
    "text": "与此相对，诗人以艾草、萧艾等恶草恶木，",
    "start": 129.74,
    "end": 134.193,
    "duration": 4.453
  },
  {
    "id": "sent_29",
    "text": "象征朝堂上短视贪婪的谗谄宵小；",
    "start": 134.193,
    "end": 138.047,
    "duration": 3.854
  },
  {
    "id": "sent_30",
    "text": "以“美人”寄托心驰神往的贤君知己。",
    "start": 138.047,
    "end": 141.68,
    "duration": 3.633
  },
  {
    "id": "sent_31",
    "text": "这一象征体系使古典诗歌意象完成了由感官物象向崇高人格象征的历史性跨越。",
    "start": 141.68,
    "end": 149.258,
    "duration": 7.578
  },
  {
    "id": "sent_32",
    "text": "第三，构筑虚实相生的宏伟构架，展现现实受挫与上下求索的天界神游。",
    "start": 149.258,
    "end": 156.589,
    "duration": 7.331
  },
  {
    "id": "sent_33",
    "text": "《离骚》 在篇章构架上展现出飞腾壮丽的想象力，",
    "start": 156.589,
    "end": 161.381,
    "duration": 4.792
  },
  {
    "id": "sent_34",
    "text": "构筑了现实沉沦与幻想飞升交织的宏大波澜。",
    "start": 161.38,
    "end": 166.041,
    "duration": 4.661
  },
  {
    "id": "sent_35",
    "text": "全诗前半部分立足现实世界，",
    "start": 166.042,
    "end": 169.206,
    "duration": 3.164
  },
  {
    "id": "sent_36",
    "text": "沉痛自述高贵出身、修身自励与遭谗被弃的政治悲剧；",
    "start": 169.206,
    "end": 174.935,
    "duration": 5.729
  },
  {
    "id": "sent_37",
    "text": "后半部分笔锋骤然飞升，借助于神话传说展开天界与宇宙的自由驰骋。",
    "start": 174.935,
    "end": 181.81,
    "duration": 6.875
  },
  {
    "id": "sent_38",
    "text": "诗人命羲和弭节、叫望舒先驱、驾飞龙鸾凤周流上下，",
    "start": 181.81,
    "end": 187.266,
    "duration": 5.456
  },
  {
    "id": "sent_39",
    "text": "叩九重天门以求通达。",
    "start": 187.266,
    "end": 189.831,
    "duration": 2.565
  },
  {
    "id": "sent_40",
    "text": "求女不遂后，诗人从灵氛之卜与巫咸之言，在广阔宇宙间寻找精神出路；",
    "start": 189.831,
    "end": 196.875,
    "duration": 7.044
  },
  {
    "id": "sent_41",
    "text": "然而当飞升云霓之上、俯瞰故土宗国之时，",
    "start": 196.875,
    "end": 201.276,
    "duration": 4.401
  },
  {
    "id": "sent_42",
    "text": "诗篇写道 “陟升皇之赫戏兮，忽临睨夫旧乡”，",
    "start": 201.276,
    "end": 205.664,
    "duration": 4.388
  },
  {
    "id": "sent_43",
    "text": "驾车仆夫与飞马皆悲鸣蜷局而不能前行。",
    "start": 205.664,
    "end": 210.156,
    "duration": 4.492
  },
  {
    "id": "sent_44",
    "text": "这种从神幻九天剧烈跌回现实悲剧的构架，",
    "start": 210.156,
    "end": 214.362,
    "duration": 4.206
  },
  {
    "id": "sent_45",
    "text": "产生了震撼人心的崇高悲壮力量。",
    "start": 214.362,
    "end": 217.76,
    "duration": 3.398
  },
  {
    "id": "sent_46",
    "text": "第四，创造骚体文式全新体制，",
    "start": 217.76,
    "end": 221.106,
    "duration": 3.346
  },
  {
    "id": "sent_47",
    "text": "展现错落参差的语言张力与地域音乐色彩。",
    "start": 221.107,
    "end": 225.287,
    "duration": 4.18
  },
  {
    "id": "sent_48",
    "text": "《离骚》 在文体形式上彻底打破了 《诗经》 四言为主的短促封闭格局。",
    "start": 225.286,
    "end": 231.562,
    "duration": 6.276
  },
  {
    "id": "sent_49",
    "text": "屈原吸纳楚地民间歌谣与巫乐的营养，",
    "start": 231.563,
    "end": 235.391,
    "duration": 3.828
  },
  {
    "id": "sent_50",
    "text": "创立了句式长短错落、参差舒卷的全新体式，即 “骚体”。",
    "start": 235.391,
    "end": 240.717,
    "duration": 5.326
  },
  {
    "id": "sent_51",
    "text": "诗中广泛运用具有浓郁荆楚地域色彩的虚词 “兮” 字，",
    "start": 240.716,
    "end": 245.612,
    "duration": 4.896
  },
  {
    "id": "sent_52",
    "text": "调节声律节奏。",
    "start": 245.612,
    "end": 247.422,
    "duration": 1.81
  },
  {
    "id": "sent_53",
    "text": "“兮”字的呼告延展强化了长歌当哭的抑扬语流，",
    "start": 247.422,
    "end": 251.979,
    "duration": 4.557
  },
  {
    "id": "sent_54",
    "text": "极具声泪俱下的悲凉音乐美；",
    "start": 251.979,
    "end": 255.0,
    "duration": 3.021
  },
  {
    "id": "sent_55",
    "text": "在词汇运用上，《离骚》 吸纳方言土语、双声叠韵与华美对偶，",
    "start": 255.0,
    "end": 260.794,
    "duration": 5.794
  },
  {
    "id": "sent_56",
    "text": "不仅直接奠定了汉代辞赋的体制基础，",
    "start": 260.794,
    "end": 264.687,
    "duration": 3.893
  },
  {
    "id": "sent_57",
    "text": "更极大拓宽了古典诗歌的语言容量。",
    "start": 264.688,
    "end": 268.112,
    "duration": 3.424
  }
]