[
  {
    "id": 1,
    "text": "试论《聊斋志异》的花妖狐魅形象塑造与社会批判意蕴。",
    "start": 0.05,
    "end": 5.173,
    "duration": 5.123
  },
  {
    "id": 2,
    "text": "《聊斋志异》 是中国古典文言短篇小说发展的至高巅峰。",
    "start": 5.173,
    "end": 9.544,
    "duration": 4.371
  },
  {
    "id": 3,
    "text": "面对清代康乾时期满汉民族矛盾隐痛、",
    "start": 9.544,
    "end": 12.846,
    "duration": 3.302
  },
  {
    "id": 4,
    "text": "皇权专制强化与八股科举制度对知识分子心灵的无情摧残，",
    "start": 12.846,
    "end": 18.107,
    "duration": 5.261
  },
  {
    "id": 5,
    "text": "蒲松龄以自身屡试不第、寄人篱下的乡村落魄文人阅历，",
    "start": 18.107,
    "end": 22.823,
    "duration": 4.716
  },
  {
    "id": 6,
    "text": "将满腔激愤倾注于笔端。",
    "start": 22.823,
    "end": 26.668,
    "duration": 3.845
  },
  {
    "id": 7,
    "text": "他继承六朝志怪与唐代传奇的优良传统，“用传奇法，",
    "start": 26.668,
    "end": 30.833,
    "duration": 4.165
  },
  {
    "id": 8,
    "text": "而以志怪”，借荒诞离奇的鬼狐幻境揭示冷酷黑暗的人间社会。",
    "start": 30.833,
    "end": 35.413,
    "duration": 4.58
  },
  {
    "id": 9,
    "text": "郭沫若精辟题词赞其 “写鬼写妖高人一等，刺贪刺虐入木三分”。",
    "start": 35.413,
    "end": 41.649,
    "duration": 6.236
  },
  {
    "id": 10,
    "text": "其花妖狐魅形象塑造与社会批判意蕴，",
    "start": 41.649,
    "end": 45.303,
    "duration": 3.654
  },
  {
    "id": 11,
    "text": "主要展现为以下四个核心维度：",
    "start": 45.303,
    "end": 47.71,
    "duration": 2.407
  },
  {
    "id": 12,
    "text": "第一，塑造真纯善良的花妖狐魅典型群像，",
    "start": 47.71,
    "end": 52.203,
    "duration": 4.493
  },
  {
    "id": 13,
    "text": "以理想异类反衬现实社会的冷酷虚伪。",
    "start": 52.203,
    "end": 56.318,
    "duration": 4.115
  },
  {
    "id": 14,
    "text": "蒲松龄在小说美学上的突出突破，",
    "start": 56.318,
    "end": 59.226,
    "duration": 2.908
  },
  {
    "id": 15,
    "text": "在于彻底扭转了传统志怪小说中妖异害人的固有模式。",
    "start": 59.226,
    "end": 64.444,
    "duration": 5.218
  },
  {
    "id": 16,
    "text": "他笔下的花妖狐魅，",
    "start": 64.444,
    "end": 66.092,
    "duration": 1.648
  },
  {
    "id": 17,
    "text": "多被赋予了超越世俗人类的美好品德与纯一人性：",
    "start": 66.092,
    "end": 70.968,
    "duration": 4.876
  },
  {
    "id": 18,
    "text": "在 《婴宁》 中，狐女婴宁天真无邪、不谙世俗礼法，",
    "start": 70.968,
    "end": 75.49,
    "duration": 4.522
  },
  {
    "id": 19,
    "text": "以清脆自然的笑声对抗封建规训的窒息压抑；",
    "start": 75.49,
    "end": 78.944,
    "duration": 3.454
  },
  {
    "id": 20,
    "text": "在 《小翠》 中，狐女小翠智勇双全、谐谑机智，",
    "start": 78.944,
    "end": 81.853,
    "duration": 2.909
  },
  {
    "id": 21,
    "text": "甘愿报恩拯救痴儿公子；在 《辛十四娘》 中，",
    "start": 81.853,
    "end": 86.123,
    "duration": 4.27
  },
  {
    "id": 22,
    "text": "十四娘行善积德、深明大义。",
    "start": 86.123,
    "end": 88.123,
    "duration": 2.0
  },
  {
    "id": 23,
    "text": "这些非人类的异类女性，不仅貌美多情，",
    "start": 88.123,
    "end": 92.306,
    "duration": 4.183
  },
  {
    "id": 24,
    "text": "更具备敢于冲破世俗门第、追求独立自主的健全人格，",
    "start": 92.306,
    "end": 96.306,
    "duration": 4.0
  },
  {
    "id": 25,
    "text": "与现实人间官僚豪绅的虚伪贪婪形成了极其强烈的审美对照。",
    "start": 96.306,
    "end": 101.442,
    "duration": 5.136
  },
  {
    "id": 26,
    "text": "第二，深刻揭露封建八股科举制度的腐朽残酷，",
    "start": 101.442,
    "end": 105.538,
    "duration": 4.096
  },
  {
    "id": 27,
    "text": "展现寒门士人的精神苦难。",
    "start": 105.538,
    "end": 108.475,
    "duration": 2.937
  },
  {
    "id": 28,
    "text": "作为终生困顿于科场的下层知识分子，",
    "start": 108.475,
    "end": 111.683,
    "duration": 3.208
  },
  {
    "id": 29,
    "text": "蒲松龄对科举制度的弊端有着痛切的骨肉体会。",
    "start": 111.683,
    "end": 116.502,
    "duration": 4.819
  },
  {
    "id": 30,
    "text": "他以冷峻幽默的笔墨，",
    "start": 116.502,
    "end": 118.426,
    "duration": 1.924
  },
  {
    "id": 31,
    "text": "深刻讽刺了八股取士的荒谬与考官的不辨菽麦。",
    "start": 118.426,
    "end": 122.785,
    "duration": 4.359
  },
  {
    "id": 32,
    "text": "在 《司文郎》 中，通过盲和尚以鼻嗅文，",
    "start": 122.785,
    "end": 125.707,
    "duration": 2.922
  },
  {
    "id": 33,
    "text": "“鼻孔大衄” 于劣作、赞叹于佳文的辛辣寓言，",
    "start": 125.707,
    "end": 129.835,
    "duration": 4.128
  },
  {
    "id": 34,
    "text": "无情嘲讽了考官有眼无珠的瞎子本质；在 《王子安》 中，",
    "start": 129.835,
    "end": 134.981,
    "duration": 5.146
  },
  {
    "id": 35,
    "text": "极其生动地描摹考生入场应试的 “秀才七变”，由病鸟、",
    "start": 134.981,
    "end": 139.764,
    "duration": 4.783
  },
  {
    "id": 36,
    "text": "受刑犯人到疯癫发狂，",
    "start": 139.764,
    "end": 141.543,
    "duration": 1.779
  },
  {
    "id": 37,
    "text": "将士子在功名利禄驱使下丧失尊严的扭曲悲剧揭露得淋漓尽致。",
    "start": 141.543,
    "end": 147.005,
    "duration": 5.462
  },
  {
    "id": 38,
    "text": "第三，无情鞭挞贪官恶霸的暴虐罪恶，为底层受苦难百姓伸张正义。",
    "start": 147.005,
    "end": 152.236,
    "duration": 5.231
  },
  {
    "id": 39,
    "text": "《聊斋志异》 深刻展现了对封建专制统治压迫百姓的强烈批判。",
    "start": 152.236,
    "end": 158.217,
    "duration": 5.981
  },
  {
    "id": 40,
    "text": "在名篇 《促织》 中，以一只细微蟋蟀的进贡为线索，",
    "start": 158.217,
    "end": 162.072,
    "duration": 3.855
  },
  {
    "id": 41,
    "text": "深刻揭露了 “一人飞升，",
    "start": 162.072,
    "end": 164.088,
    "duration": 2.016
  },
  {
    "id": 42,
    "text": "仙及鸡犬” 的朝廷享乐对百姓家破人亡的血泪榨取；",
    "start": 164.088,
    "end": 168.476,
    "duration": 4.388
  },
  {
    "id": 43,
    "text": "在 《席方平》 中，席方平为其蒙冤被害的父亲鸣冤，",
    "start": 168.476,
    "end": 172.001,
    "duration": 3.525
  },
  {
    "id": 44,
    "text": "自县衙、府衙申诉至城隍、阎王乃至东岳大帝，",
    "start": 172.001,
    "end": 175.724,
    "duration": 3.723
  },
  {
    "id": 45,
    "text": "所遇神佛官吏无不贪赃枉法、上下勾结，",
    "start": 175.724,
    "end": 180.542,
    "duration": 4.818
  },
  {
    "id": 46,
    "text": "使阳间受苦的百姓在阴司同样遭受锯解油烹的残酷肉刑。",
    "start": 180.542,
    "end": 185.423,
    "duration": 4.881
  },
  {
    "id": 47,
    "text": "蒲松龄借鬼魅地狱直斥封建官场黑幕，",
    "start": 185.423,
    "end": 189.371,
    "duration": 3.948
  },
  {
    "id": 48,
    "text": "展现了强烈的批判骨力与人道主义同情。",
    "start": 189.371,
    "end": 193.37,
    "duration": 3.999
  },
  {
    "id": 49,
    "text": "第四，融合典雅文言与生动方言于一体，",
    "start": 193.37,
    "end": 196.279,
    "duration": 2.909
  },
  {
    "id": 50,
    "text": "达成“文备众体”的纯正叙事艺术。",
    "start": 196.279,
    "end": 199.608,
    "duration": 3.329
  },
  {
    "id": 51,
    "text": "在小说体式上，",
    "start": 199.608,
    "end": 200.785,
    "duration": 1.177
  },
  {
    "id": 52,
    "text": "《聊斋志异》 实现了古代文言小说语言与技巧的集大成。",
    "start": 200.785,
    "end": 205.701,
    "duration": 4.916
  },
  {
    "id": 53,
    "text": "蒲松龄在典重典雅的先秦两汉史传文言之中，",
    "start": 205.701,
    "end": 209.798,
    "duration": 4.097
  },
  {
    "id": 54,
    "text": "自然吸纳了山东淄川本土的生动俗语口吻与市井俚语；",
    "start": 209.798,
    "end": 215.392,
    "duration": 5.594
  },
  {
    "id": 55,
    "text": "其叙事结构精巧多变，心理刻画与神态白描兼备，",
    "start": 215.392,
    "end": 219.028,
    "duration": 3.636
  },
  {
    "id": 56,
    "text": "善于在现实生活细节中自然切入奇幻情节，",
    "start": 219.028,
    "end": 223.095,
    "duration": 4.067
  },
  {
    "id": 57,
    "text": "打破了现实与幻想的物理界限。",
    "start": 223.095,
    "end": 227.448,
    "duration": 4.353
  },
  {
    "id": 58,
    "text": "这部巨著不仅使古典文言小说重新焕发出旺盛的艺术生机，",
    "start": 227.448,
    "end": 232.275,
    "duration": 4.827
  },
  {
    "id": 59,
    "text": "更树立了中国古代短篇小说无法超越的美学高峰。",
    "start": 232.275,
    "end": 236.016,
    "duration": 3.741
  }
]