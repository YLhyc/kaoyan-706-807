[
  {
    "id": 1,
    "text": "试论《聊斋志异》的花妖狐魅形象塑造与社会批判意蕴。",
    "start": 0.101,
    "end": 4.506,
    "duration": 4.405
  },
  {
    "id": 2,
    "text": "《聊斋志异》是中国古代文言短篇小说发展的巅峰之作。",
    "start": 5.048,
    "end": 9.389,
    "duration": 4.341
  },
  {
    "id": 3,
    "text": "清代初年政治高压日甚、八股科举日益僵化，",
    "start": 9.954,
    "end": 13.853,
    "duration": 3.899
  },
  {
    "id": 4,
    "text": "蒲松龄凭借自身屡试不第、长期坐馆的落魄文人阅历，",
    "start": 14.285,
    "end": 18.416,
    "duration": 4.131
  },
  {
    "id": 5,
    "text": "将满腔孤愤寄托于狐鬼世界之中。",
    "start": 18.764,
    "end": 21.385,
    "duration": 2.621
  },
  {
    "id": 6,
    "text": "他继承六朝志怪与唐代传奇传统，",
    "start": 21.636,
    "end": 24.364,
    "duration": 2.728
  },
  {
    "id": 7,
    "text": "鲁迅在《中国小说史略》中称之为“用传奇法，而以志怪”；",
    "start": 24.679,
    "end": 29.086,
    "duration": 4.407
  },
  {
    "id": 8,
    "text": "郭沫若亦赞其“写鬼写妖高人一等，刺贪刺虐入木三分”。",
    "start": 29.585,
    "end": 34.597,
    "duration": 5.012
  },
  {
    "id": 9,
    "text": "《聊斋志异》的花妖狐魅形象塑造与社会批判意蕴，",
    "start": 34.952,
    "end": 38.627,
    "duration": 3.675
  },
  {
    "id": 10,
    "text": "主要体现在以下四个方面：",
    "start": 38.855,
    "end": 40.552,
    "duration": 1.697
  },
  {
    "id": 11,
    "text": "第一，塑造真纯美好的花妖狐魅群像，",
    "start": 41.209,
    "end": 44.229,
    "duration": 3.02
  },
  {
    "id": 12,
    "text": "以理想异类反衬世俗人情冷酷。",
    "start": 44.536,
    "end": 46.908,
    "duration": 2.372
  },
  {
    "id": 13,
    "text": "蒲松龄在小说创作上的重要突破，",
    "start": 47.155,
    "end": 49.353,
    "duration": 2.198
  },
  {
    "id": 14,
    "text": "在于扭转了传统志怪小说中妖异害人的固有模式。",
    "start": 49.654,
    "end": 53.409,
    "duration": 3.755
  },
  {
    "id": 15,
    "text": "他笔下的花妖狐魅，大都保留着原本的物性特征，",
    "start": 53.697,
    "end": 57.244,
    "duration": 3.547
  },
  {
    "id": 16,
    "text": "却又被赋予真挚纯善的人性与人情：在《婴宁》中，",
    "start": 57.523,
    "end": 61.326,
    "duration": 3.803
  },
  {
    "id": 17,
    "text": "狐女婴宁天真憨直、爱花爱笑，",
    "start": 61.616,
    "end": 64.568,
    "duration": 2.952
  },
  {
    "id": 18,
    "text": "以不谙世故的纯真天性对抗世俗礼法的窒息压抑；",
    "start": 64.924,
    "end": 68.996,
    "duration": 4.072
  },
  {
    "id": 19,
    "text": "在《黄英》中，菊花精黄英自食其力、种菊致富，",
    "start": 69.356,
    "end": 73.255,
    "duration": 3.899
  },
  {
    "id": 20,
    "text": "突破了士大夫迂腐虚伪的清高观念；在《阿绣》中，",
    "start": 73.565,
    "end": 77.4,
    "duration": 3.835
  },
  {
    "id": 21,
    "text": "狐女因感动于痴情而成人之美。",
    "start": 77.72,
    "end": 79.905,
    "duration": 2.185
  },
  {
    "id": 22,
    "text": "这些异类女性不仅容貌秀美，更敢于冲破门第与礼教束缚，",
    "start": 80.181,
    "end": 84.522,
    "duration": 4.341
  },
  {
    "id": 23,
    "text": "与现实人间的虚伪势利形成鲜明对照。",
    "start": 84.876,
    "end": 87.672,
    "duration": 2.796
  },
  {
    "id": 24,
    "text": "第二，辛辣讽刺八股科举制度的腐朽弊端，",
    "start": 88.306,
    "end": 91.936,
    "duration": 3.63
  },
  {
    "id": 25,
    "text": "抒写寒门士人的精神苦闷。",
    "start": 92.508,
    "end": 94.402,
    "duration": 1.894
  },
  {
    "id": 26,
    "text": "长期困顿场屋的切身经历，",
    "start": 95.006,
    "end": 97.062,
    "duration": 2.056
  },
  {
    "id": 27,
    "text": "使蒲松龄对科举制度的积弊有着痛切体会。",
    "start": 97.34,
    "end": 100.481,
    "duration": 3.141
  },
  {
    "id": 28,
    "text": "他以犀利幽默的笔墨，猛烈嘲讽八股取士的荒谬与试官的昏庸贪婪。",
    "start": 100.905,
    "end": 106.162,
    "duration": 5.257
  },
  {
    "id": 29,
    "text": "在《司文郎》中，盲僧凭嗅觉品评文章优劣，",
    "start": 106.511,
    "end": 110.021,
    "duration": 3.51
  },
  {
    "id": 30,
    "text": "面对试官取落颠倒愤然斥责“仆虽盲于目，而不盲于鼻，",
    "start": 110.306,
    "end": 114.939,
    "duration": 4.633
  },
  {
    "id": 31,
    "text": "今帘中人并鼻亦盲矣”，将考官的有眼无珠揭露得体无完肤；",
    "start": 115.146,
    "end": 119.659,
    "duration": 4.513
  },
  {
    "id": 32,
    "text": "在《王子安》中，生动描摹落魄秀才醉卧中连试皆捷、",
    "start": 119.89,
    "end": 123.918,
    "duration": 4.028
  },
  {
    "id": 33,
    "text": "得意忘形的梦幻幻觉，既嘲弄了士子追逐功名利禄的痴狂丑态，",
    "start": 124.256,
    "end": 129.006,
    "duration": 4.75
  },
  {
    "id": 34,
    "text": "又蕴含着怀才不遇者的深深自伤。",
    "start": 129.129,
    "end": 131.808,
    "duration": 2.679
  },
  {
    "id": 35,
    "text": "第三，无情鞭挞贪官恶霸的暴虐罪恶，替底层受苦民众伸张正义。",
    "start": 132.452,
    "end": 137.99,
    "duration": 5.538
  },
  {
    "id": 36,
    "text": "《聊斋志异》以鲜明的爱憎立场，深刻揭露了封建官场的贪残黑暗。",
    "start": 138.309,
    "end": 143.605,
    "duration": 5.296
  },
  {
    "id": 37,
    "text": "在名篇《促织》中，朝廷征索小小蟋蟀致使百姓倾家荡产、",
    "start": 143.894,
    "end": 149.031,
    "duration": 5.137
  },
  {
    "id": 38,
    "text": "逼死人命，作者最后冷语讥刺“一人飞升，仙及鸡犬”，",
    "start": 149.409,
    "end": 154.129,
    "duration": 4.72
  },
  {
    "id": 39,
    "text": "将批判矛头直指最高统治者与各级官僚；在《席方平》中，",
    "start": 154.37,
    "end": 158.879,
    "duration": 4.509
  },
  {
    "id": 40,
    "text": "席方平为受豪绅凌辱的父亲入阴司鸣冤，却见城隍、郡司、",
    "start": 159.194,
    "end": 164.428,
    "duration": 5.234
  },
  {
    "id": 41,
    "text": "冥王各级衙门无不贪赃受贿、酷刑施虐，",
    "start": 164.664,
    "end": 167.631,
    "duration": 2.967
  },
  {
    "id": 42,
    "text": "“阴曹之暗昧尤胜于阳间”。",
    "start": 167.867,
    "end": 169.951,
    "duration": 2.084
  },
  {
    "id": 43,
    "text": "蒲松龄借幽冥地狱映照人间官府黑幕，",
    "start": 170.207,
    "end": 173.179,
    "duration": 2.972
  },
  {
    "id": 44,
    "text": "展现出强烈的批判锋芒与民生关怀。",
    "start": 173.393,
    "end": 176.298,
    "duration": 2.905
  },
  {
    "id": 45,
    "text": "第四，兼融志怪与传奇艺术之长，开创诗意浓郁、",
    "start": 176.905,
    "end": 181.373,
    "duration": 4.468
  },
  {
    "id": 46,
    "text": "语言简练的叙事风范。",
    "start": 181.766,
    "end": 183.331,
    "duration": 1.565
  },
  {
    "id": 47,
    "text": "在叙事艺术上，",
    "start": 183.77,
    "end": 184.77,
    "duration": 1.0
  },
  {
    "id": 48,
    "text": "《聊斋志异》使文言短篇小说突破了粗陈梗概的局限。",
    "start": 185.035,
    "end": 188.924,
    "duration": 3.889
  },
  {
    "id": 49,
    "text": "蒲松龄将先秦两汉的典雅文言与山东方言俗语自然交融，",
    "start": 189.468,
    "end": 194.155,
    "duration": 4.687
  },
  {
    "id": 50,
    "text": "叙述语言平易简洁而文约事丰，",
    "start": 194.513,
    "end": 197.091,
    "duration": 2.578
  },
  {
    "id": 51,
    "text": "人物语言则因人因事而庄谐多变；作品又善于描写环境、",
    "start": 197.396,
    "end": 201.975,
    "duration": 4.579
  },
  {
    "id": 52,
    "text": "动作与心理细节，并将诗词意象与“偶见鹘突，",
    "start": 202.385,
    "end": 206.566,
    "duration": 4.181
  },
  {
    "id": 53,
    "text": "知复非人”的含蓄笔法引入小说，",
    "start": 206.663,
    "end": 209.026,
    "duration": 2.363
  },
  {
    "id": 54,
    "text": "使人鬼幽婚与幻境奇谈富有浓郁的诗意与回味。",
    "start": 209.419,
    "end": 213.466,
    "duration": 4.047
  },
  {
    "id": 55,
    "text": "这部杰作将中国古代文言短篇小说推向了后人难以企及的艺术高峰。",
    "start": 213.751,
    "end": 218.864,
    "duration": 5.113
  }
]