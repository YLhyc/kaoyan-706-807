[
  {
    "id": 1,
    "text": "简述《古诗十九首》的思想意蕴与文人五言诗艺术特色。",
    "start": 0.05,
    "end": 4.638,
    "duration": 4.588
  },
  {
    "id": 2,
    "text": "《古诗十九首》 是东汉末年文人五言诗成熟的标志性代表作。",
    "start": 4.638,
    "end": 9.75,
    "duration": 5.112
  },
  {
    "id": 3,
    "text": "这组诗作最早见于南朝梁萧统编选的 《文选》，",
    "start": 9.75,
    "end": 13.943,
    "duration": 4.193
  },
  {
    "id": 4,
    "text": "产生于东汉中后期宦官专权、外戚争衡、",
    "start": 13.943,
    "end": 17.709,
    "duration": 3.766
  },
  {
    "id": 5,
    "text": "士人社会地位动荡的乱世前夕。",
    "start": 17.709,
    "end": 21.889,
    "duration": 4.18
  },
  {
    "id": 6,
    "text": "刘勰在 《文心雕龙》 中盛赞其为 “五言之冠冕”，",
    "start": 21.889,
    "end": 26.017,
    "duration": 4.128
  },
  {
    "id": 7,
    "text": "钟嵘 《诗品》 誉其为 “惊心动魄，可谓几乎一字千金”。",
    "start": 26.017,
    "end": 29.471,
    "duration": 3.454
  },
  {
    "id": 8,
    "text": "《古诗十九首》 的思想意蕴与艺术特色，",
    "start": 29.471,
    "end": 32.8,
    "duration": 3.329
  },
  {
    "id": 9,
    "text": "主要展现为以下三个核心维度：",
    "start": 32.8,
    "end": 35.362,
    "duration": 2.562
  },
  {
    "id": 10,
    "text": "第一，抒发生命短促之焦灼与身世失意之悲叹，",
    "start": 35.362,
    "end": 39.049,
    "duration": 3.687
  },
  {
    "id": 11,
    "text": "展现深沉的文人觉醒意识。",
    "start": 39.049,
    "end": 42.456,
    "duration": 3.407
  },
  {
    "id": 12,
    "text": "《古诗十九首》 深刻折射了汉末下层文人在门阀垄断与社会动乱下的生存困境。",
    "start": 42.456,
    "end": 49.824,
    "duration": 7.368
  },
  {
    "id": 13,
    "text": "诗歌的核心母题集中于对时光流逝、",
    "start": 49.824,
    "end": 52.741,
    "duration": 2.917
  },
  {
    "id": 14,
    "text": "生命短促与功名无望的生存焦虑。",
    "start": 52.741,
    "end": 56.565,
    "duration": 3.824
  },
  {
    "id": 15,
    "text": "在 《生年不满百》 中，以 “生年不满百，常怀千岁忧。",
    "start": 56.565,
    "end": 60.951,
    "duration": 4.386
  },
  {
    "id": 16,
    "text": "昼短苦夜长，",
    "start": 60.951,
    "end": 62.349,
    "duration": 1.398
  },
  {
    "id": 17,
    "text": "何不秉烛游” 抒发生命短暂的紧迫感与及时行乐的愤懑；",
    "start": 62.349,
    "end": 67.456,
    "duration": 5.107
  },
  {
    "id": 18,
    "text": "在 《涉江采芙蓉》 与 《青青河畔草》 中，",
    "start": 67.456,
    "end": 71.524,
    "duration": 4.068
  },
  {
    "id": 19,
    "text": "则借游子逐客的羁旅之愁与思妇闺怨，写尽了关山阻隔、",
    "start": 71.524,
    "end": 76.572,
    "duration": 5.048
  },
  {
    "id": 20,
    "text": "相见无期的刻骨相思。",
    "start": 76.572,
    "end": 78.208,
    "duration": 1.636
  },
  {
    "id": 21,
    "text": "这种对个体生命价值的深切执着，标志着文人自我意识的真正觉醒。",
    "start": 78.208,
    "end": 84.779,
    "duration": 6.571
  },
  {
    "id": 22,
    "text": "第二，融汇赋比兴表现机制，确立文人五言诗意蕴绵长的审美范式。",
    "start": 84.779,
    "end": 90.327,
    "duration": 5.548
  },
  {
    "id": 23,
    "text": "在艺术表现上，",
    "start": 90.327,
    "end": 92.102,
    "duration": 1.775
  },
  {
    "id": 24,
    "text": "《古诗十九首》 承续 《诗经》 比兴传统并加以文人雅化。",
    "start": 92.102,
    "end": 96.53,
    "duration": 4.428
  },
  {
    "id": 25,
    "text": "作者善于以眼前寻常物象起兴，将外在物候与内在心理浑然交融。",
    "start": 96.53,
    "end": 101.87,
    "duration": 5.34
  },
  {
    "id": 26,
    "text": "如 《迢迢牵牛星》 借神话星汉起兴，以 “盈盈一水间，",
    "start": 101.87,
    "end": 106.221,
    "duration": 4.351
  },
  {
    "id": 27,
    "text": "脉脉不得语” 白描夫妇情思，意境深沉宛转。",
    "start": 106.221,
    "end": 110.485,
    "duration": 4.264
  },
  {
    "id": 28,
    "text": "全诗善用叠字摹态传情，如 “行行重行行”、",
    "start": 110.485,
    "end": 114.824,
    "duration": 4.339
  },
  {
    "id": 29,
    "text": "“青青河畔草”，音律和谐回环，营造出一种温厚低回、",
    "start": 114.824,
    "end": 118.694,
    "duration": 3.87
  },
  {
    "id": 30,
    "text": "哀而不伤的中和美感。",
    "start": 118.694,
    "end": 120.449,
    "duration": 1.755
  },
  {
    "id": 31,
    "text": "第三，语言浅近自然而洗练精醇，开创大白若浅的古典抒情风格。",
    "start": 120.449,
    "end": 126.91,
    "duration": 6.461
  },
  {
    "id": 32,
    "text": "《古诗十九首》 摆脱了汉赋追求奇僻辞藻与铺排堆砌的习气，",
    "start": 126.91,
    "end": 132.264,
    "duration": 5.354
  },
  {
    "id": 33,
    "text": "展现出大朴不雕的语言纯度。",
    "start": 132.264,
    "end": 134.656,
    "duration": 2.392
  },
  {
    "id": 34,
    "text": "全诗语言如家常说话般质朴清浅，无丝毫雕凿痕迹，",
    "start": 134.656,
    "end": 139.338,
    "duration": 4.682
  },
  {
    "id": 35,
    "text": "却能在极平淡中蕴含极深醇的情味，",
    "start": 139.338,
    "end": 142.753,
    "duration": 3.415
  },
  {
    "id": 36,
    "text": "确立了中国古典抒情诗平淡见奇、语短情长的高超艺术范式。",
    "start": 142.753,
    "end": 148.056,
    "duration": 5.303
  }
]