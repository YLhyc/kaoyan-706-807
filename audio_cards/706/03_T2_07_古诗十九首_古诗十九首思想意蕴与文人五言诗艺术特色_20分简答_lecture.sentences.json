[
  {
    "id": 1,
    "text": "古诗十九首》 是东汉末年文人五言诗成熟的标志性代表作。",
    "start": 0.1,
    "end": 5.363,
    "duration": 5.263
  },
  {
    "id": 2,
    "text": "这组诗作最早见于南朝梁萧统编选的 《文选》，产生于东汉中后期宦官专权，外戚争衡，士人社会地位动荡的乱世前夕。",
    "start": 5.313,
    "end": 16.133,
    "duration": 10.82
  },
  {
    "id": 3,
    "text": "刘勰在 《文心雕龙》 中盛赞其为 “五言之冠冕”，钟嵘 《诗品》 誉其为 “惊心动魄，可谓几乎一字千金”。",
    "start": 16.133,
    "end": 24.818,
    "duration": 8.685
  },
  {
    "id": 4,
    "text": "古诗十九首》 的思想意蕴与艺术特色，主要展现为以下三个核心维度，",
    "start": 24.818,
    "end": 31.224,
    "duration": 6.406
  },
  {
    "id": 5,
    "text": "第一，抒发生命短促之焦灼与身世失意之悲叹，展现深沉的文人觉醒意识。",
    "start": 31.224,
    "end": 38.62,
    "duration": 7.396
  },
  {
    "id": 6,
    "text": "古诗十九首》 深刻折射了汉末下层文人在门阀垄断与社会动乱下的生存困境。",
    "start": 38.62,
    "end": 45.781,
    "duration": 7.161
  },
  {
    "id": 7,
    "text": "诗歌的核心母题集中于对时光流逝，生命短促与功名无望的生存焦虑。",
    "start": 45.781,
    "end": 52.291,
    "duration": 6.51
  },
  {
    "id": 8,
    "text": "在 《生年不满百》 中，以 “生年不满百，常怀千岁忧。",
    "start": 52.292,
    "end": 57.526,
    "duration": 5.234
  },
  {
    "id": 9,
    "text": "昼短苦夜长，何不秉烛游” 抒发生命短暂的紧迫感与及时行乐的愤懑；在 《涉江采芙蓉》 与 《青青河畔草》 中，则借游子逐客的羁旅之愁与思妇闺怨，写尽了关山阻隔，相见无期的刻骨相思。",
    "start": 57.526,
    "end": 74.722,
    "duration": 17.196
  },
  {
    "id": 10,
    "text": "这种对个体生命价值的深切执着，标志着文人自我意识的真正觉醒。",
    "start": 74.722,
    "end": 81.05,
    "duration": 6.328
  },
  {
    "id": 11,
    "text": "第二，融汇赋比兴表现机制，确立文人五言诗意蕴绵长的审美范式。",
    "start": 81.051,
    "end": 87.119,
    "duration": 6.068
  },
  {
    "id": 12,
    "text": "在艺术表现上，《古诗十九首》 承续 《诗经》 比兴传统并加以文人雅化。",
    "start": 87.118,
    "end": 93.368,
    "duration": 6.25
  },
  {
    "id": 13,
    "text": "作者善于以眼前寻常物象起兴，将外在物候与内在心理浑然交融。",
    "start": 93.368,
    "end": 99.709,
    "duration": 6.341
  },
  {
    "id": 14,
    "text": "如 《迢迢牵牛星》 借神话星汉起兴，以 “盈盈一水间，脉脉不得语” 白描夫妇情思，意境深沉宛转。",
    "start": 99.709,
    "end": 108.745,
    "duration": 9.036
  },
  {
    "id": 15,
    "text": "全诗善用叠字摹态传情，如 “行行重行行”，“青青河畔草”，音律和谐回环，营造出一种温厚低回，哀而不伤的中和美感。",
    "start": 108.746,
    "end": 119.814,
    "duration": 11.068
  },
  {
    "id": 16,
    "text": "第三，语言浅近自然而洗练精醇，开创大白若浅的古典抒情风格。",
    "start": 119.814,
    "end": 126.194,
    "duration": 6.38
  },
  {
    "id": 17,
    "text": "古诗十九首》 摆脱了汉赋追求奇僻辞藻与铺排堆砌的习气，展现出大朴不雕的语言纯度。",
    "start": 126.194,
    "end": 134.553,
    "duration": 8.359
  },
  {
    "id": 18,
    "text": "全诗语言如家常说话般质朴清浅，无丝毫雕凿痕迹，却能在极平淡中蕴含极深醇的情味，确立了中国古典抒情诗平淡见奇，语短情长的高超艺术范式。",
    "start": 134.553,
    "end": 148.954,
    "duration": 14.401
  },
  {
    "id": 19,
    "text": "1. 这一问到底在考什么？",
    "start": 148.954,
    "end": 151.675,
    "duration": 2.721
  },
  {
    "id": 20,
    "text": "本题考查文人五言诗成熟标志的内涵与形式。",
    "start": 151.676,
    "end": 155.699,
    "duration": 4.023
  },
  {
    "id": 21,
    "text": "必须答透，游子羁旅失意，生命苦短忧患，平淡自然的抒情化境以及五言体式的划时代意义。",
    "start": 155.699,
    "end": 164.163,
    "duration": 8.464
  },
  {
    "id": 22,
    "text": "2. 答题的总视角是什么？",
    "start": 164.163,
    "end": 166.468,
    "duration": 2.305
  },
  {
    "id": 23,
    "text": "立足汉末大动荡前夜寒士仕途无望的生存危机。",
    "start": 166.467,
    "end": 171.285,
    "duration": 4.818
  },
  {
    "id": 24,
    "text": "由游子身世 $\\rightarrow$ 生命忧患 $\\rightarrow$ 平淡情深艺术 $\\rightarrow$ 诗史地位，层层展开。",
    "start": 171.285,
    "end": 183.199,
    "duration": 11.914
  },
  {
    "id": 25,
    "text": "3. 内在因果链条是什么？",
    "start": 183.199,
    "end": 185.712,
    "duration": 2.513
  },
  {
    "id": 26,
    "text": "游宦求官受挫催生了羁旅思乡之悲；战乱前夕生死无常强化了生命短暂忧患；真实情感的流露逼出了平淡自然的白描技法；个体自觉创作最终奠定了文人五言诗的王冠地位。",
    "start": 185.712,
    "end": 201.845,
    "duration": 16.133
  }
]