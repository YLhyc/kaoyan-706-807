[
  {
    "id": 1,
    "text": "简述《古诗十九首》的思想意蕴与文人五言诗艺术特色。",
    "start": 0.115,
    "end": 4.133,
    "duration": 4.018
  },
  {
    "id": 2,
    "text": "《古诗十九首》最早见录于南朝梁萧统编选的《文选》，",
    "start": 4.302,
    "end": 7.893,
    "duration": 3.591
  },
  {
    "id": 3,
    "text": "产生于东汉中后期宦官外戚专权、社会动荡之际，",
    "start": 8.062,
    "end": 11.927,
    "duration": 3.865
  },
  {
    "id": 4,
    "text": "代表了汉代文人五言诗的最高成就。",
    "start": 12.111,
    "end": 14.411,
    "duration": 2.3
  },
  {
    "id": 5,
    "text": "刘勰《文心雕龙》称其“五言之冠冕”，",
    "start": 14.618,
    "end": 17.147,
    "duration": 2.529
  },
  {
    "id": 6,
    "text": "钟嵘《诗品》赞其“惊心动魄，可谓几乎一字千金”。",
    "start": 17.482,
    "end": 21.693,
    "duration": 4.211
  },
  {
    "id": 7,
    "text": "其思想意蕴与艺术特色，主要体现在以下三个方面：",
    "start": 21.986,
    "end": 26.0,
    "duration": 4.014
  },
  {
    "id": 8,
    "text": "第一，抒发人生短促之焦虑与游子思妇之悲怨，",
    "start": 26.64,
    "end": 31.68,
    "duration": 5.04
  },
  {
    "id": 9,
    "text": "体现文人自我意识觉醒。",
    "start": 32.081,
    "end": 33.903,
    "duration": 1.822
  },
  {
    "id": 10,
    "text": "《古诗十九首》深刻反映了汉末中下层士人在仕途壅塞与乱世动荡中的生存困境。",
    "start": 34.311,
    "end": 41.08,
    "duration": 6.769
  },
  {
    "id": 11,
    "text": "诗中一方面写下层文人怀才不遇的愤懑以及对生命无常、",
    "start": 41.483,
    "end": 46.466,
    "duration": 4.983
  },
  {
    "id": 12,
    "text": "时光流逝的焦虑，如《生年不满百》以“生年不满百，",
    "start": 46.772,
    "end": 51.233,
    "duration": 4.461
  },
  {
    "id": 13,
    "text": "常怀千岁忧。",
    "start": 51.511,
    "end": 52.959,
    "duration": 1.448
  },
  {
    "id": 14,
    "text": "昼短苦夜长，何不秉烛游”抒发及时行乐背后的深切苦闷；",
    "start": 53.269,
    "end": 59.063,
    "duration": 5.794
  },
  {
    "id": 15,
    "text": "另一方面以真挚笔触书写游子羁旅与思妇闺怨，",
    "start": 59.563,
    "end": 64.156,
    "duration": 4.593
  },
  {
    "id": 16,
    "text": "如《涉江采芙蓉》道尽关山阻隔与人生漂泊之痛，",
    "start": 64.732,
    "end": 69.169,
    "duration": 4.437
  },
  {
    "id": 17,
    "text": "标志着东汉后期文人对个体生命与情感价值的深切觉醒。",
    "start": 69.411,
    "end": 74.752,
    "duration": 5.341
  },
  {
    "id": 18,
    "text": "第二，融汇比兴手法与景情交融之境，奠定文人五言诗含蓄韵味。",
    "start": 75.418,
    "end": 81.594,
    "duration": 6.176
  },
  {
    "id": 19,
    "text": "在艺术表现上，",
    "start": 82.149,
    "end": 83.182,
    "duration": 1.033
  },
  {
    "id": 20,
    "text": "《古诗十九首》继承《诗经》比兴传统并加以文人化创造，",
    "start": 83.494,
    "end": 87.622,
    "duration": 4.128
  },
  {
    "id": 21,
    "text": "善于借眼前风物起兴造境，达到情景交融、物我浑化的境界。",
    "start": 88.133,
    "end": 93.564,
    "duration": 5.431
  },
  {
    "id": 22,
    "text": "如《迢迢牵牛星》通篇借神话星宿起兴，以“盈盈一水间，",
    "start": 94.045,
    "end": 99.391,
    "duration": 5.346
  },
  {
    "id": 23,
    "text": "脉脉不得语”白描隔河相望之苦，",
    "start": 99.658,
    "end": 102.522,
    "duration": 2.864
  },
  {
    "id": 24,
    "text": "无一语直说自身苦衷而离愁自见。",
    "start": 102.802,
    "end": 106.34,
    "duration": 3.538
  },
  {
    "id": 25,
    "text": "同时，全诗善用叠字摹态传声，",
    "start": 106.554,
    "end": 109.385,
    "duration": 2.831
  },
  {
    "id": 26,
    "text": "如“行行重行行”“青青河畔草”，音调回环舒缓，",
    "start": 109.566,
    "end": 113.775,
    "duration": 4.209
  },
  {
    "id": 27,
    "text": "营造出温厚绵邈、哀而不伤的抒情格调。",
    "start": 114.093,
    "end": 117.492,
    "duration": 3.399
  },
  {
    "id": 28,
    "text": "第三，语言浅近精醇而不事雕饰，形成深衷浅貌的古典抒情风范。",
    "start": 118.123,
    "end": 124.194,
    "duration": 6.071
  },
  {
    "id": 29,
    "text": "《古诗十九首》摆脱了汉赋奇字僻词与铺张堆砌的习气，",
    "start": 124.532,
    "end": 129.262,
    "duration": 4.73
  },
  {
    "id": 30,
    "text": "语言如同家常絮语，不作艰深晦涩之辞，",
    "start": 129.677,
    "end": 132.762,
    "duration": 3.085
  },
  {
    "id": 31,
    "text": "却于极平淡的日常用语中浓缩了厚重的人生体悟。",
    "start": 133.21,
    "end": 137.08,
    "duration": 3.87
  },
  {
    "id": 32,
    "text": "这种“浅浅寄言，深深道款”的深衷浅貌风格，",
    "start": 137.434,
    "end": 141.055,
    "duration": 3.621
  },
  {
    "id": 33,
    "text": "把五言诗的抒情表现力推向纯熟，",
    "start": 141.329,
    "end": 143.955,
    "duration": 2.626
  },
  {
    "id": 34,
    "text": "成为建安乃至魏晋南北朝文人五言诗竞相效法的艺术典范。",
    "start": 144.242,
    "end": 149.094,
    "duration": 4.852
  }
]