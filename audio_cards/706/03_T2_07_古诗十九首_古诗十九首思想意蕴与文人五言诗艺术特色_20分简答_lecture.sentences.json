[
  {
    "id": 1,
    "text": "简述《古诗十九首》的思想意蕴与文人五言诗艺术特色。",
    "start": 0.0,
    "end": 4.668,
    "duration": 4.668
  },
  {
    "id": 2,
    "text": "《古诗十九首》 是东汉末年文人五言诗成熟的标志性代表作。",
    "start": 4.668,
    "end": 9.772,
    "duration": 5.104
  },
  {
    "id": 3,
    "text": "这组诗作最早见于南朝梁萧统编选的 《文选》，",
    "start": 9.772,
    "end": 13.973,
    "duration": 4.201
  },
  {
    "id": 4,
    "text": "产生于东汉中后期宦官专权、外戚争衡、",
    "start": 13.973,
    "end": 17.739,
    "duration": 3.766
  },
  {
    "id": 5,
    "text": "士人社会地位动荡的乱世前夕。",
    "start": 17.739,
    "end": 20.218,
    "duration": 2.479
  },
  {
    "id": 6,
    "text": "刘勰在 《文心雕龙》 中盛赞其为 “五言之冠冕”，",
    "start": 20.218,
    "end": 24.255,
    "duration": 4.037
  },
  {
    "id": 7,
    "text": "钟嵘 《诗品》 誉其为 “惊心动魄，可谓几乎一字千金”。",
    "start": 24.255,
    "end": 29.177,
    "duration": 4.922
  },
  {
    "id": 8,
    "text": "《古诗十九首》 的思想意蕴与艺术特色，",
    "start": 29.177,
    "end": 34.728,
    "duration": 5.551
  },
  {
    "id": 9,
    "text": "主要展现为以下三个核心维度：",
    "start": 34.728,
    "end": 39.079,
    "duration": 4.351
  },
  {
    "id": 10,
    "text": "第一，抒发生命短促之焦灼与身世失意之悲叹，",
    "start": 39.079,
    "end": 42.483,
    "duration": 3.404
  },
  {
    "id": 11,
    "text": "展现深沉的文人觉醒意识。",
    "start": 42.483,
    "end": 45.934,
    "duration": 3.451
  },
  {
    "id": 12,
    "text": "《古诗十九首》 深刻折射了汉末下层文人在门阀垄断与社会动乱下的生存困境。",
    "start": 45.934,
    "end": 55.008,
    "duration": 9.074
  },
  {
    "id": 13,
    "text": "诗歌的核心母题集中于对时光流逝、",
    "start": 55.008,
    "end": 58.034,
    "duration": 3.026
  },
  {
    "id": 14,
    "text": "生命短促与功名无望的生存焦虑。",
    "start": 58.034,
    "end": 62.374,
    "duration": 4.34
  },
  {
    "id": 15,
    "text": "在 《生年不满百》 中，以 “生年不满百，常怀千岁忧。",
    "start": 62.374,
    "end": 66.063,
    "duration": 3.689
  },
  {
    "id": 16,
    "text": "昼短苦夜长，",
    "start": 66.063,
    "end": 69.162,
    "duration": 3.099
  },
  {
    "id": 17,
    "text": "何不秉烛游” 抒发生命短暂的紧迫感与及时行乐的愤懑；",
    "start": 69.162,
    "end": 74.529,
    "duration": 5.367
  },
  {
    "id": 18,
    "text": "在 《涉江采芙蓉》 与 《青青河畔草》 中，",
    "start": 74.529,
    "end": 76.602,
    "duration": 2.073
  },
  {
    "id": 19,
    "text": "则借游子逐客的羁旅之愁与思妇闺怨，写尽了关山阻隔、",
    "start": 76.602,
    "end": 82.215,
    "duration": 5.613
  },
  {
    "id": 20,
    "text": "相见无期的刻骨相思。",
    "start": 82.215,
    "end": 84.809,
    "duration": 2.594
  },
  {
    "id": 21,
    "text": "这种对个体生命价值的深切执着，标志着文人自我意识的真正觉醒。",
    "start": 84.809,
    "end": 89.37,
    "duration": 4.561
  },
  {
    "id": 22,
    "text": "第二，融汇赋比兴表现机制，确立文人五言诗意蕴绵长的审美范式。",
    "start": 89.37,
    "end": 93.753,
    "duration": 4.383
  },
  {
    "id": 23,
    "text": "在艺术表现上，",
    "start": 93.753,
    "end": 99.475,
    "duration": 5.722
  },
  {
    "id": 24,
    "text": "《古诗十九首》 承续 《诗经》 比兴传统并加以文人雅化。",
    "start": 99.475,
    "end": 106.251,
    "duration": 6.776
  },
  {
    "id": 25,
    "text": "作者善于以眼前寻常物象起兴，将外在物候与内在心理浑然交融。",
    "start": 106.251,
    "end": 112.8,
    "duration": 6.549
  },
  {
    "id": 26,
    "text": "如 《迢迢牵牛星》 借神话星汉起兴，以 “盈盈一水间，",
    "start": 112.8,
    "end": 116.463,
    "duration": 3.663
  },
  {
    "id": 27,
    "text": "脉脉不得语” 白描夫妇情思，意境深沉宛转。",
    "start": 116.463,
    "end": 121.246,
    "duration": 4.783
  },
  {
    "id": 28,
    "text": "全诗善用叠字摹态传情，如 “行行重行行”、",
    "start": 121.246,
    "end": 125.564,
    "duration": 4.318
  },
  {
    "id": 29,
    "text": "“青青河畔草”，音律和谐回环，营造出一种温厚低回、",
    "start": 125.564,
    "end": 132.294,
    "duration": 6.73
  },
  {
    "id": 30,
    "text": "哀而不伤的中和美感。",
    "start": 132.294,
    "end": 134.686,
    "duration": 2.392
  },
  {
    "id": 31,
    "text": "第三，语言浅近自然而洗练精醇，开创大白若浅的古典抒情风格。",
    "start": 134.686,
    "end": 139.363,
    "duration": 4.677
  },
  {
    "id": 32,
    "text": "《古诗十九首》 摆脱了汉赋追求奇僻辞藻与铺排堆砌的习气，",
    "start": 139.363,
    "end": 140.873,
    "duration": 1.51
  },
  {
    "id": 33,
    "text": "展现出大朴不雕的语言纯度。",
    "start": 140.873,
    "end": 142.783,
    "duration": 1.91
  },
  {
    "id": 34,
    "text": "全诗语言如家常说话般质朴清浅，无丝毫雕凿痕迹，",
    "start": 142.783,
    "end": 144.757,
    "duration": 1.974
  },
  {
    "id": 35,
    "text": "却能在极平淡中蕴含极深醇的情味，",
    "start": 144.757,
    "end": 145.937,
    "duration": 1.18
  },
  {
    "id": 36,
    "text": "确立了中国古典抒情诗平淡见奇、语短情长的高超艺术范式。",
    "start": 145.937,
    "end": 148.056,
    "duration": 2.119
  }
]