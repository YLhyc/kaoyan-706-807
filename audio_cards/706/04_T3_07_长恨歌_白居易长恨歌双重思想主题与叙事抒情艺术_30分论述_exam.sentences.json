[
  {
    "id": "sent_1",
    "text": "白居易的 《长恨歌》 是中国古典诗歌史上影响最为深远的长篇抒情叙事长诗之一。",
    "start": 0.1,
    "end": 7.485,
    "duration": 7.385
  },
  {
    "id": "sent_2",
    "text": "创作于唐宪宗元和元年，白居易与友人陈鸿、王质夫同游仙游寺，",
    "start": 7.435,
    "end": 14.089,
    "duration": 6.654
  },
  {
    "id": "sent_3",
    "text": "感怀唐玄宗与杨贵妃的爱情故事而作此诗。",
    "start": 14.089,
    "end": 18.36,
    "duration": 4.271
  },
  {
    "id": "sent_4",
    "text": "全诗以安史之乱前后唐帝国的盛衰剧变为历史骨架，",
    "start": 18.359,
    "end": 23.515,
    "duration": 5.156
  },
  {
    "id": "sent_5",
    "text": "将帝王家国兴亡与世俗男女的生死挚爱交织在一起。",
    "start": 23.516,
    "end": 28.698,
    "duration": 5.182
  },
  {
    "id": "sent_6",
    "text": "陈鸿在 《长恨歌传》 中总结其主旨为 “意者不但感其事，",
    "start": 28.698,
    "end": 33.841,
    "duration": 5.143
  },
  {
    "id": "sent_7",
    "text": "亦欲惩尤物，窒乱阶，垂于将来者也”。",
    "start": 33.841,
    "end": 37.799,
    "duration": 3.958
  },
  {
    "id": "sent_8",
    "text": "《长恨歌》 的思想主题与叙事抒情艺术，",
    "start": 37.799,
    "end": 41.536,
    "duration": 3.737
  },
  {
    "id": "sent_9",
    "text": "主要展现为以下四个核心维度：",
    "start": 41.536,
    "end": 44.843,
    "duration": 3.307
  },
  {
    "id": "sent_10",
    "text": "第一，交织讽谕荒淫误国与同情赞美真挚爱情，",
    "start": 44.844,
    "end": 49.74,
    "duration": 4.896
  },
  {
    "id": "sent_11",
    "text": "构建复杂深刻的双重思想意蕴。",
    "start": 49.74,
    "end": 53.034,
    "duration": 3.294
  },
  {
    "id": "sent_12",
    "text": "《长恨歌》 最具争议亦最耐人寻味之处，在于其思想主旨的双重性。",
    "start": 53.034,
    "end": 59.076,
    "duration": 6.042
  },
  {
    "id": "sent_13",
    "text": "诗作前半部分立足于政治讽谕，真实揭示了天宝年间统治者的沉湎声色：",
    "start": 59.076,
    "end": 65.912,
    "duration": 6.836
  },
  {
    "id": "sent_14",
    "text": "“汉皇重色思倾国，御宇多年求不得”，“春宵苦短日高起，",
    "start": 65.911,
    "end": 71.445,
    "duration": 5.534
  },
  {
    "id": "sent_15",
    "text": "从此君王不早朝”。",
    "start": 71.445,
    "end": 73.567,
    "duration": 2.122
  },
  {
    "id": "sent_16",
    "text": "诗人深刻点明了玄宗荒废朝政、宠幸外戚杨家正是引爆安史之乱的乱阶所在；",
    "start": 73.568,
    "end": 81.185,
    "duration": 7.617
  },
  {
    "id": "sent_17",
    "text": "而在马嵬兵变杨贵妃缢死之后，诗歌笔锋发生显著转折，",
    "start": 81.185,
    "end": 86.576,
    "duration": 5.391
  },
  {
    "id": "sent_18",
    "text": "大量篇幅转入对玄宗晚年孤寂思念与二人至死不渝深情的深切同情与赞叹。",
    "start": 86.576,
    "end": 93.803,
    "duration": 7.227
  },
  {
    "id": "sent_19",
    "text": "这种批判荒淫与歌颂挚爱的矛盾统一，",
    "start": 93.802,
    "end": 97.656,
    "duration": 3.854
  },
  {
    "id": "sent_20",
    "text": "真实折射了中唐士人既痛定思痛反思安史之乱盛衰教训，",
    "start": 97.656,
    "end": 103.607,
    "duration": 5.951
  },
  {
    "id": "sent_21",
    "text": "又沉溺于人生无常、追寻人性真情的复杂文化心态。",
    "start": 103.607,
    "end": 108.464,
    "duration": 4.857
  },
  {
    "id": "sent_22",
    "text": "第二，将宏阔历史兴衰与微观生死恋情紧密交融，",
    "start": 108.464,
    "end": 113.698,
    "duration": 5.234
  },
  {
    "id": "sent_23",
    "text": "展现跌宕起伏的叙事戏剧性。",
    "start": 113.698,
    "end": 116.576,
    "duration": 2.878
  },
  {
    "id": "sent_24",
    "text": "《长恨歌》 在叙事布局上兼备史诗的宏阔格局与戏剧的跌宕悬念。",
    "start": 116.576,
    "end": 122.878,
    "duration": 6.302
  },
  {
    "id": "sent_25",
    "text": "诗歌以时间为轴，",
    "start": 122.878,
    "end": 124.909,
    "duration": 2.031
  },
  {
    "id": "sent_26",
    "text": "精心构筑了盛极而衰、惊变惨裂、余恨绵绵的情节链条。",
    "start": 124.909,
    "end": 130.481,
    "duration": 5.572
  },
  {
    "id": "sent_27",
    "text": "前段渲染骊山华清池的奢靡温存，旋即以 “渔阳鼙鼓动地来，",
    "start": 130.481,
    "end": 136.289,
    "duration": 5.808
  },
  {
    "id": "sent_28",
    "text": "惊破霓裳羽衣曲” 造成剧烈的时空逆转；",
    "start": 136.289,
    "end": 140.117,
    "duration": 3.828
  },
  {
    "id": "sent_29",
    "text": "紧接着写马嵬坡 “六军不发无奈何，宛转蛾眉马前死”，",
    "start": 140.117,
    "end": 145.26,
    "duration": 5.143
  },
  {
    "id": "sent_30",
    "text": "将全篇叙事推向最高潮。",
    "start": 145.26,
    "end": 148.242,
    "duration": 2.982
  },
  {
    "id": "sent_31",
    "text": "盛衰两极的强烈对比，赋予了历史事件以惊心动魄的戏剧张力，",
    "start": 148.242,
    "end": 154.166,
    "duration": 5.924
  },
  {
    "id": "sent_32",
    "text": "实现了宏大政治风云对个体悲剧命运的深层推动。",
    "start": 154.167,
    "end": 159.18,
    "duration": 5.013
  },
  {
    "id": "sent_33",
    "text": "第三，运用虚实相生与仙境超脱手法，",
    "start": 159.18,
    "end": 163.308,
    "duration": 4.128
  },
  {
    "id": "sent_34",
    "text": "实现世俗悲剧向永恒深情的精神升华。",
    "start": 163.307,
    "end": 167.409,
    "duration": 4.102
  },
  {
    "id": "sent_35",
    "text": "诗作后半部分打破了单纯写实的尘世限制，由实入虚，",
    "start": 167.409,
    "end": 172.578,
    "duration": 5.169
  },
  {
    "id": "sent_36",
    "text": "创造了缥缈神异的仙境世界。",
    "start": 172.578,
    "end": 175.469,
    "duration": 2.891
  },
  {
    "id": "sent_37",
    "text": "诗人先实写玄宗自蜀归京后的刻骨相思，“行宫见月伤心色，",
    "start": 175.469,
    "end": 181.276,
    "duration": 5.807
  },
  {
    "id": "sent_38",
    "text": "夜雨闻铃肠断声”，“孤灯挑尽未成眠”；",
    "start": 181.276,
    "end": 184.973,
    "duration": 3.697
  },
  {
    "id": "sent_39",
    "text": "随后借助临邛道士 “上穷碧落下黄泉” 寻觅太真魂魄，",
    "start": 184.973,
    "end": 190.195,
    "duration": 5.222
  },
  {
    "id": "sent_40",
    "text": "引出 “忽闻海上有仙山，山在虚无缥缈间” 的梦幻图景。",
    "start": 190.195,
    "end": 195.273,
    "duration": 5.078
  },
  {
    "id": "sent_41",
    "text": "杨玉环在仙界依旧泪痕凝脂、情深似海，托物寄词，",
    "start": 195.273,
    "end": 200.638,
    "duration": 5.365
  },
  {
    "id": "sent_42",
    "text": "重温 “在天愿作比翼鸟，在地愿为连理枝” 的长生殿旧盟。",
    "start": 200.638,
    "end": 205.977,
    "duration": 5.339
  },
  {
    "id": "sent_43",
    "text": "仙境的虚写冲淡了世俗政治的罪责感，",
    "start": 205.977,
    "end": 209.74,
    "duration": 3.763
  },
  {
    "id": "sent_44",
    "text": "将一桩政治丑剧升华为人类对真挚爱情永恒追求的精神寄托。",
    "start": 209.74,
    "end": 215.964,
    "duration": 6.224
  },
  {
    "id": "sent_45",
    "text": "第四，融汇叙事长诗与抒情歌行之体势，",
    "start": 215.964,
    "end": 220.339,
    "duration": 4.375
  },
  {
    "id": "sent_46",
    "text": "形成抑扬顿挫且流丽宛转的声律风范。",
    "start": 220.339,
    "end": 224.323,
    "duration": 3.984
  },
  {
    "id": "sent_47",
    "text": "在艺术形式上，",
    "start": 224.323,
    "end": 226.172,
    "duration": 1.849
  },
  {
    "id": "sent_48",
    "text": "白居易将七言歌行的韵律美与叙事诗的交代功能融合到极致。",
    "start": 226.172,
    "end": 231.979,
    "duration": 5.807
  },
  {
    "id": "sent_49",
    "text": "全诗语言浅近明畅、洗练工稳，",
    "start": 231.979,
    "end": 235.286,
    "duration": 3.307
  },
  {
    "id": "sent_50",
    "text": "兼具民间说唱的流利自然与文人诗赋的精雕细刻。",
    "start": 235.286,
    "end": 240.038,
    "duration": 4.752
  },
  {
    "id": "sent_51",
    "text": "诗人善于在客观叙事中自然渗入强烈的主观抒情，情动于中而溢于言表；",
    "start": 240.039,
    "end": 246.967,
    "duration": 6.928
  },
  {
    "id": "sent_52",
    "text": "通篇押韵转韵严整，节奏随情感与情节的起伏跌宕而抑扬顿挫，",
    "start": 246.966,
    "end": 253.008,
    "duration": 6.042
  },
  {
    "id": "sent_53",
    "text": "尾句 “天长地久有时尽，此恨绵绵无绝期” 警策沉郁、回肠荡气，",
    "start": 253.008,
    "end": 259.011,
    "duration": 6.003
  },
  {
    "id": "sent_54",
    "text": "成就了古典叙事诗中不可逾越的声律高峰。",
    "start": 259.01,
    "end": 262.968,
    "duration": 3.958
  }
]