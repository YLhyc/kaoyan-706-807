[
  {
    "id": 1,
    "text": "试论白居易《长恨歌》的双重思想主题与叙事抒情艺术。",
    "start": 0.101,
    "end": 4.908,
    "duration": 4.807
  },
  {
    "id": 2,
    "text": "白居易的《长恨歌》是唐代极具影响力的长篇叙事抒情诗。",
    "start": 5.456,
    "end": 10.275,
    "duration": 4.819
  },
  {
    "id": 3,
    "text": "该诗作于唐宪宗元和元年，白居易与友人陈鸿、",
    "start": 10.703,
    "end": 14.694,
    "duration": 3.991
  },
  {
    "id": 4,
    "text": "王质夫同游仙游寺，感怀唐玄宗与杨贵妃遗事而作此诗，",
    "start": 14.993,
    "end": 19.811,
    "duration": 4.818
  },
  {
    "id": 5,
    "text": "陈鸿随之作《长恨歌传》。",
    "start": 20.104,
    "end": 22.184,
    "duration": 2.08
  },
  {
    "id": 6,
    "text": "全诗以安史之乱前后唐王朝由盛转衰为历史背景，",
    "start": 22.321,
    "end": 26.682,
    "duration": 4.361
  },
  {
    "id": 7,
    "text": "将帝王家国兴亡与男女生死恋情交织其中。",
    "start": 27.049,
    "end": 30.72,
    "duration": 3.671
  },
  {
    "id": 8,
    "text": "陈鸿在《长恨歌传》中点明其主旨为“意者不但感其事，",
    "start": 30.974,
    "end": 35.369,
    "duration": 4.395
  },
  {
    "id": 9,
    "text": "亦欲惩尤物，窒乱阶，垂于将来者也”。",
    "start": 35.716,
    "end": 39.059,
    "duration": 3.343
  },
  {
    "id": 10,
    "text": "《长恨歌》的双重思想主题与叙事抒情艺术，",
    "start": 39.306,
    "end": 42.807,
    "duration": 3.501
  },
  {
    "id": 11,
    "text": "主要体现在以下四个方面：",
    "start": 43.068,
    "end": 44.849,
    "duration": 1.781
  },
  {
    "id": 12,
    "text": "第一，兼寓讽谕荒淫误国与同情生死深情，",
    "start": 45.527,
    "end": 49.853,
    "duration": 4.326
  },
  {
    "id": 13,
    "text": "构成复杂的双重思想意蕴。",
    "start": 50.34,
    "end": 52.439,
    "duration": 2.099
  },
  {
    "id": 14,
    "text": "《长恨歌》耐人寻味之处在于其主题的双重性。",
    "start": 53.018,
    "end": 56.2,
    "duration": 3.182
  },
  {
    "id": 15,
    "text": "诗作前半部分带有明显的政治讽谕意味，借“汉皇重色思倾国，",
    "start": 56.597,
    "end": 62.122,
    "duration": 5.525
  },
  {
    "id": 16,
    "text": "御宇多年求不得”“春宵苦短日高起，",
    "start": 62.417,
    "end": 65.38,
    "duration": 2.963
  },
  {
    "id": 17,
    "text": "从此君王不早朝”及杨氏一门荣宠等描写，",
    "start": 65.611,
    "end": 69.349,
    "duration": 3.738
  },
  {
    "id": 18,
    "text": "婉讽唐玄宗荒废朝政、酿成安史之乱的历史教训；",
    "start": 69.694,
    "end": 73.826,
    "duration": 4.132
  },
  {
    "id": 19,
    "text": "而在马嵬事变杨贵妃缢死之后，诗意笔锋一转，",
    "start": 74.149,
    "end": 78.079,
    "duration": 3.93
  },
  {
    "id": 20,
    "text": "用大量篇幅倾情写玄宗西行还京后的刻骨思念与仙界重温盟誓，",
    "start": 78.403,
    "end": 84.516,
    "duration": 6.113
  },
  {
    "id": 21,
    "text": "对其生死相恋寄予深切同情。",
    "start": 84.751,
    "end": 87.44,
    "duration": 2.689
  },
  {
    "id": 22,
    "text": "这种讽谕与感伤的矛盾交织，",
    "start": 87.695,
    "end": 90.151,
    "duration": 2.456
  },
  {
    "id": 23,
    "text": "真实折射出中唐士人既反思盛世倾覆教训、",
    "start": 90.438,
    "end": 94.285,
    "duration": 3.847
  },
  {
    "id": 24,
    "text": "又感叹世事无常的复杂心态。",
    "start": 94.655,
    "end": 96.56,
    "duration": 1.905
  },
  {
    "id": 25,
    "text": "第二，将宏阔历史兴衰融入生死恋情叙事，",
    "start": 97.186,
    "end": 101.304,
    "duration": 4.118
  },
  {
    "id": 26,
    "text": "展现跌宕起伏的戏剧张力。",
    "start": 101.751,
    "end": 103.728,
    "duration": 1.977
  },
  {
    "id": 27,
    "text": "在叙事布局上，《长恨歌》紧扣盛极而衰、惊变惨裂、",
    "start": 104.147,
    "end": 108.642,
    "duration": 4.495
  },
  {
    "id": 28,
    "text": "余恨绵绵的情节链条，张弛有度。",
    "start": 109.025,
    "end": 111.369,
    "duration": 2.344
  },
  {
    "id": 29,
    "text": "前段极力渲染华清池、骊宫的繁华温存与梨园歌舞，",
    "start": 111.858,
    "end": 116.408,
    "duration": 4.55
  },
  {
    "id": 30,
    "text": "旋即以“渔阳鼙鼓动地来，",
    "start": 116.775,
    "end": 119.043,
    "duration": 2.268
  },
  {
    "id": 31,
    "text": "惊破霓裳羽衣曲”造成急转直下的剧变，将战火陡然推至眼前；",
    "start": 119.336,
    "end": 124.906,
    "duration": 5.57
  },
  {
    "id": 32,
    "text": "紧接着马嵬坡前“六军不发无奈何，宛转蛾眉马前死”，",
    "start": 125.441,
    "end": 130.566,
    "duration": 5.125
  },
  {
    "id": 33,
    "text": "把全诗冲突推向惨烈顶点。",
    "start": 130.888,
    "end": 133.258,
    "duration": 2.37
  },
  {
    "id": 34,
    "text": "盛衰两极的剧烈反差，使家国巨变与个人命运紧咬在一起，",
    "start": 133.964,
    "end": 138.531,
    "duration": 4.567
  },
  {
    "id": 35,
    "text": "赋予长诗惊心动魄的叙事张力。",
    "start": 138.72,
    "end": 141.404,
    "duration": 2.684
  },
  {
    "id": 36,
    "text": "第三，运用虚实相生与仙境幻想手法，将世俗悲剧升华为永恒深情。",
    "start": 142.05,
    "end": 148.437,
    "duration": 6.387
  },
  {
    "id": 37,
    "text": "诗作后半部分打破纯写实的时空界限，由实入虚，",
    "start": 148.648,
    "end": 153.165,
    "duration": 4.517
  },
  {
    "id": 38,
    "text": "展开缥缈迷离的仙境想象。",
    "start": 153.43,
    "end": 155.655,
    "duration": 2.225
  },
  {
    "id": 39,
    "text": "诗人先实写玄宗还京后“行宫见月伤心色，",
    "start": 155.841,
    "end": 159.714,
    "duration": 3.873
  },
  {
    "id": 40,
    "text": "夜雨闻铃肠断声”“孤灯挑尽未成眠”的凄苦孤寂，",
    "start": 160.137,
    "end": 164.415,
    "duration": 4.278
  },
  {
    "id": 41,
    "text": "再借临邛道士“上穷碧落下黄泉”的求索，",
    "start": 164.7,
    "end": 168.294,
    "duration": 3.594
  },
  {
    "id": 42,
    "text": "引出“忽闻海上有仙山，山在虚无缥缈间”的梦幻图景。",
    "start": 168.567,
    "end": 173.767,
    "duration": 5.2
  },
  {
    "id": 43,
    "text": "仙界中的杨玉环“梨花一枝春带雨”，",
    "start": 174.008,
    "end": 176.569,
    "duration": 2.561
  },
  {
    "id": 44,
    "text": "以定情金钗钿盒寄托“在天愿作比翼鸟，",
    "start": 176.721,
    "end": 180.714,
    "duration": 3.993
  },
  {
    "id": 45,
    "text": "在地愿为连理枝”的长生殿旧盟。",
    "start": 181.058,
    "end": 183.609,
    "duration": 2.551
  },
  {
    "id": 46,
    "text": "这种幻化处理冲淡了现实政治的冷峻，使全诗超越宫廷旧事，",
    "start": 183.86,
    "end": 188.459,
    "duration": 4.599
  },
  {
    "id": 47,
    "text": "升华为对坚贞爱情的永恒咏叹。",
    "start": 188.719,
    "end": 191.183,
    "duration": 2.464
  },
  {
    "id": 48,
    "text": "第四，融汇叙事、抒情与七言歌行声律，成就流丽宛转的歌行典范。",
    "start": 191.858,
    "end": 198.399,
    "duration": 6.541
  },
  {
    "id": 49,
    "text": "在艺术形式上，",
    "start": 198.793,
    "end": 199.717,
    "duration": 0.924
  },
  {
    "id": 50,
    "text": "白居易将七言歌行的音律流美与长篇叙事功能融会贯通。",
    "start": 199.969,
    "end": 204.619,
    "duration": 4.65
  },
  {
    "id": 51,
    "text": "全诗语言清丽晓畅、不事僻典，",
    "start": 205.117,
    "end": 207.667,
    "duration": 2.55
  },
  {
    "id": 52,
    "text": "兼取民间说唱的流畅自然与文人诗赋的精工锤炼；",
    "start": 207.868,
    "end": 211.919,
    "duration": 4.051
  },
  {
    "id": 53,
    "text": "叙事之中处处渗入浓烈抒情，情随事转、回环往复；",
    "start": 212.177,
    "end": 216.686,
    "duration": 4.509
  },
  {
    "id": 54,
    "text": "通篇转韵自然严整，节奏随悲喜起伏而抑扬顿挫，",
    "start": 217.02,
    "end": 221.029,
    "duration": 4.009
  },
  {
    "id": 55,
    "text": "结尾“天长地久有时尽，此恨绵绵无绝期”余韵悠长、",
    "start": 221.284,
    "end": 226.117,
    "duration": 4.833
  },
  {
    "id": 56,
    "text": "荡气回肠，成就了中国古典长篇叙事抒情诗的典范之作。",
    "start": 226.311,
    "end": 230.954,
    "duration": 4.643
  }
]