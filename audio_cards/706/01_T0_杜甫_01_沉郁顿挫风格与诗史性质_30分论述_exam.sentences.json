[
  {
    "id": 1,
    "text": "杜甫是中国古代诗歌现实主义精神的集大成者与至高巅峰。",
    "start": 0.08,
    "end": 5.12,
    "duration": 5.04
  },
  {
    "id": 2,
    "text": "他身处唐帝国由盛转衰的安史之乱剧变节点。",
    "start": 5.12,
    "end": 9.52,
    "duration": 4.4
  },
  {
    "id": 3,
    "text": "杜甫以强烈的儒家仁民爱物精神，将个人的漂泊坎坷同国家民族的存亡紧密焊接。",
    "start": 9.52,
    "end": 17.04,
    "duration": 7.52
  },
  {
    "id": 4,
    "text": "他以广阔的历史视野与炉火纯青的格律造诣，",
    "start": 17.04,
    "end": 20.8,
    "duration": 3.76
  },
  {
    "id": 5,
    "text": "为盛衰之交的时代铸造了一部鲜活壮阔的心灵全史。",
    "start": 20.8,
    "end": 25.12,
    "duration": 4.32
  },
  {
    "id": 6,
    "text": "杜甫以沉郁顿挫的艺术风格、感时伤事的诗史品格、",
    "start": 25.36,
    "end": 29.84,
    "duration": 4.48
  },
  {
    "id": 7,
    "text": "精严化境的律诗造诣与博大深沉的人道主义情怀，",
    "start": 29.84,
    "end": 34.4,
    "duration": 4.56
  },
  {
    "id": 8,
    "text": "确立了其无可争议的“诗圣”崇高地位。",
    "start": 34.4,
    "end": 37.68,
    "duration": 3.28
  },
  {
    "id": 9,
    "text": "首先，在美学风格上，“沉郁顿挫”是杜甫诗歌最核心、",
    "start": 37.68,
    "end": 42.4,
    "duration": 4.72
  },
  {
    "id": 10,
    "text": "最具统摄力的美学特质。",
    "start": 42.4,
    "end": 44.0,
    "duration": 1.6
  },
  {
    "id": 11,
    "text": "沉郁指思想感情的深沉、宽厚与博大，",
    "start": 44.4,
    "end": 48.0,
    "duration": 3.6
  },
  {
    "id": 12,
    "text": "展现出诗人关怀现实苍生的深重悲敏。",
    "start": 48.0,
    "end": 51.36,
    "duration": 3.36
  },
  {
    "id": 13,
    "text": "顿挫指表现手法的波澜起伏、跌宕转折与感情表达的郁结盘旋。",
    "start": 51.36,
    "end": 56.64,
    "duration": 5.28
  },
  {
    "id": 14,
    "text": "这一风格根植于知人论世的历史真实。",
    "start": 56.64,
    "end": 59.52,
    "duration": 2.88
  },
  {
    "id": 15,
    "text": "盛唐气象的破灭与致君尧舜理想的受挫，",
    "start": 59.52,
    "end": 62.96,
    "duration": 3.44
  },
  {
    "id": 16,
    "text": "使杜甫的情感郁结在胸而无法平直倾泻。",
    "start": 62.96,
    "end": 66.56,
    "duration": 3.6
  },
  {
    "id": 17,
    "text": "在《自京赴奉先县咏怀五百字》中，",
    "start": 66.88,
    "end": 70.24,
    "duration": 3.36
  },
  {
    "id": 18,
    "text": "“朱门酒肉臭，路有冻死骨”将阶级对立的严酷现实化为深沉浩叹。",
    "start": 70.24,
    "end": 77.12,
    "duration": 6.88
  },
  {
    "id": 19,
    "text": "在《登高》中，面对万里悲秋的壮阔江天，",
    "start": 77.12,
    "end": 80.8,
    "duration": 3.68
  },
  {
    "id": 20,
    "text": "诗人将老病孤舟的个人迟暮与百年世事之多艰融为一体。",
    "start": 80.8,
    "end": 86.56,
    "duration": 5.76
  },
  {
    "id": 21,
    "text": "盘旋吞吐的章法与苍凉厚重的心绪交融，",
    "start": 86.56,
    "end": 90.48,
    "duration": 3.92
  },
  {
    "id": 22,
    "text": "形成了撼人心魄的沉郁之美。",
    "start": 90.48,
    "end": 92.88,
    "duration": 2.4
  },
  {
    "id": 23,
    "text": "其次，在思想主旨上，杜甫诗歌展现了记录时代沧桑的“诗史”品格与博大的人道主义悲敏。",
    "start": 93.2,
    "end": 101.52,
    "duration": 8.32
  },
  {
    "id": 24,
    "text": "杜甫的诗史价值不仅在于据实补史书之阙，",
    "start": 101.52,
    "end": 105.68,
    "duration": 4.16
  },
  {
    "id": 25,
    "text": "更在于深刻记录了时代民众的心灵苦难史。",
    "start": 105.68,
    "end": 109.2,
    "duration": 3.52
  },
  {
    "id": 26,
    "text": "他开辟了感时伤事的现实叙事新传统。",
    "start": 109.2,
    "end": 113.2,
    "duration": 4.0
  },
  {
    "id": 27,
    "text": "“三吏三别”以平民视角直面征兵战乱的惨烈真相。",
    "start": 113.2,
    "end": 117.52,
    "duration": 4.32
  },
  {
    "id": 28,
    "text": "《石壕吏》在客观克制的夜捉叙述中，",
    "start": 117.68,
    "end": 120.893,
    "duration": 3.213
  },
  {
    "id": 29,
    "text": "通过老妇凄苦的泣诉，揭露了战争强加给下层小民的无情摧残。",
    "start": 120.893,
    "end": 126.86,
    "duration": 5.967
  },
  {
    "id": 30,
    "text": "杜甫以民胞物与的仁者胸怀体恤苍生。",
    "start": 126.86,
    "end": 130.532,
    "duration": 3.672
  },
  {
    "id": 31,
    "text": "《茅屋为秋风所破歌》在自身床头屋漏的绝境中，",
    "start": 130.532,
    "end": 134.892,
    "duration": 4.36
  },
  {
    "id": 32,
    "text": "迸发出“安得广厦千万间，大庇天下寒士俱欢颜”的宏伟祈愿。",
    "start": 134.892,
    "end": 140.4,
    "duration": 5.508
  },
  {
    "id": 33,
    "text": "这种超越小我、怀抱天下生灵的大仁大爱，",
    "start": 140.48,
    "end": 144.08,
    "duration": 3.6
  },
  {
    "id": 34,
    "text": "使他的现实记录闪耀着超越时代的崇高人道主义光芒。",
    "start": 144.08,
    "end": 148.48,
    "duration": 4.4
  },
  {
    "id": 35,
    "text": "第三，在体制艺术上，杜甫实现了中国古代律诗艺术的全面集大成与形式登峰造极。",
    "start": 148.784,
    "end": 156.544,
    "duration": 7.76
  },
  {
    "id": 36,
    "text": "杜甫彻底打破了齐梁以来律诗偏于声色浮艳的狭隘格式。",
    "start": 156.544,
    "end": 162.304,
    "duration": 5.76
  },
  {
    "id": 37,
    "text": "他极大拓宽了律诗的题材边界与抒情容量，",
    "start": 162.304,
    "end": 166.304,
    "duration": 4.0
  },
  {
    "id": 38,
    "text": "做到了“语不惊人死不休”。",
    "start": 166.304,
    "end": 168.384,
    "duration": 2.08
  },
  {
    "id": 39,
    "text": "他不仅将五七言律诗锻造得音韵协调、",
    "start": 168.384,
    "end": 171.824,
    "duration": 3.44
  },
  {
    "id": 40,
    "text": "对仗极其工稳，更创立了“拗救”与变格手法，",
    "start": 171.824,
    "end": 175.904,
    "duration": 4.08
  },
  {
    "id": 41,
    "text": "实现了形式规范与情感起伏的自由融合。",
    "start": 175.904,
    "end": 179.344,
    "duration": 3.44
  },
  {
    "id": 42,
    "text": "其代表作《登高》八句皆对，首联句中自对，",
    "start": 179.744,
    "end": 183.344,
    "duration": 3.6
  },
  {
    "id": 43,
    "text": "沉着开阔。",
    "start": 183.344,
    "end": 184.304,
    "duration": 0.96
  },
  {
    "id": 44,
    "text": "汉联与颈联对仗天造地设，气象雄浑而骨力老健。",
    "start": 184.304,
    "end": 188.224,
    "duration": 3.92
  },
  {
    "id": 45,
    "text": "杜甫以千锤百炼的语言功夫，将汉语律诗的声律对仗与章法结构推向了前无古人的艺术极致。",
    "start": 188.224,
    "end": 195.104,
    "duration": 6.88
  },
  {
    "id": 46,
    "text": "最后，在文学史上，杜甫确立了中国古代诗歌艺术的崇高典范，",
    "start": 195.104,
    "end": 199.824,
    "duration": 4.72
  },
  {
    "id": 47,
    "text": "对后世产生了不可估量的深远影响。",
    "start": 199.824,
    "end": 202.384,
    "duration": 2.56
  },
  {
    "id": 48,
    "text": "杜甫对现实生活的直面观察与叙事长诗的成熟创造，",
    "start": 202.704,
    "end": 207.184,
    "duration": 4.48
  },
  {
    "id": 49,
    "text": "直接启迪了中唐白居易、元稹倡导的新乐府运动。",
    "start": 207.184,
    "end": 211.104,
    "duration": 3.92
  },
  {
    "id": 50,
    "text": "杜甫深沉含蓄的遣词炼字与以文为诗、",
    "start": 211.104,
    "end": 214.384,
    "duration": 3.28
  },
  {
    "id": 51,
    "text": "以议论入诗的艺术探索，成为北宋苏轼、",
    "start": 214.384,
    "end": 217.744,
    "duration": 3.36
  },
  {
    "id": 52,
    "text": "黄庭坚及江西诗派奉为圭聂的美学法宝。",
    "start": 217.744,
    "end": 221.104,
    "duration": 3.36
  },
  {
    "id": 53,
    "text": "杜甫将儒家诗教传统与卓越的艺术创造完美统一，",
    "start": 221.104,
    "end": 225.424,
    "duration": 4.32
  },
  {
    "id": 54,
    "text": "为后代诗人树立了艺术水准与人格力量高度契合的崇高丰碑。",
    "start": 225.424,
    "end": 230.624,
    "duration": 5.2
  },
  {
    "id": 55,
    "text": "综上所述，杜甫以沉郁顿挫的美学风范包孕了沉重悲壮的盛衰时代。",
    "start": 230.864,
    "end": 236.944,
    "duration": 6.08
  },
  {
    "id": 56,
    "text": "他以诗史的胸襟记录了民族创伤，以集大成的形式推高了律诗极限，",
    "start": 236.944,
    "end": 242.624,
    "duration": 5.68
  },
  {
    "id": 57,
    "text": "是中国古典诗歌史上承前启后、万代敬仰的艺术宗师。--",
    "start": 242.624,
    "end": 247.024,
    "duration": 4.4
  }
]