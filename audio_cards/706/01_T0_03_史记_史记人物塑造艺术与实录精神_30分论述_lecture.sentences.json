[
  {
    "id": 1,
    "text": "试论《史记》的人物塑造艺术与“互见法”。",
    "start": 0.16,
    "end": 2.718,
    "duration": 2.558
  },
  {
    "id": 2,
    "text": "《史记》是中国古代第一部纪传体通史，也是古典传记文学的典范之作。",
    "start": 3.218,
    "end": 8.742,
    "duration": 5.524
  },
  {
    "id": 3,
    "text": "面对汉武帝时期的政治现实与自身惨遭腐刑的人生巨变，",
    "start": 9.281,
    "end": 13.934,
    "duration": 4.653
  },
  {
    "id": 4,
    "text": "司马迁秉持发愤著书与实录精神，“究天人之际，通古今之变，成一家之言”，",
    "start": 14.284,
    "end": 20.952,
    "duration": 6.668
  },
  {
    "id": 5,
    "text": "突破以往编年体与国别体史书以事系人的局限，首次以“人”为历史叙事的中心。",
    "start": 21.302,
    "end": 28.026,
    "duration": 6.724
  },
  {
    "id": 6,
    "text": "鲁迅赞誉其为“史家之绝唱，无韵之离骚”。",
    "start": 28.526,
    "end": 32.087,
    "duration": 3.561
  },
  {
    "id": 7,
    "text": "其卓越的人物塑造艺术，主要体现在以下四个方面：",
    "start": 32.587,
    "end": 36.276,
    "duration": 3.689
  },
  {
    "id": 8,
    "text": "第一，独创“互见法”叙事体制，塑造多维立体、真实复杂的人物性格。",
    "start": 36.934,
    "end": 42.776,
    "duration": 5.842
  },
  {
    "id": 9,
    "text": "为解决史书体例整肃与人物性格复杂多面之间的矛盾，",
    "start": 43.276,
    "end": 47.455,
    "duration": 4.179
  },
  {
    "id": 10,
    "text": "司马迁独创了“互见法”（又称旁见侧出法），",
    "start": 47.805,
    "end": 51.697,
    "duration": 3.892
  },
  {
    "id": 11,
    "text": "即把一个人物的主要事迹和主导性格写入本传，",
    "start": 52.09,
    "end": 55.671,
    "duration": 3.581
  },
  {
    "id": 12,
    "text": "而将其次要的、矛盾的乃至有损主要形象的事迹分散记入他人本纪、世家或列传之中。",
    "start": 56.021,
    "end": 63.86,
    "duration": 7.839
  },
  {
    "id": 13,
    "text": "以《高祖本纪》为例，本传重点突出刘邦豁达大度、知人善任的开国帝王气度；",
    "start": 64.36,
    "end": 70.962,
    "duration": 6.602
  },
  {
    "id": 14,
    "text": "《项羽本纪》则借范增之口道出其贪财好色，",
    "start": 71.462,
    "end": 75.346,
    "duration": 3.884
  },
  {
    "id": 15,
    "text": "《樊郦滕灌列传》补记他战败逃跑时屡将亲生儿女推下马车的冷酷自私，",
    "start": 75.696,
    "end": 81.855,
    "duration": 6.159
  },
  {
    "id": 16,
    "text": "《淮阴侯列传》则揭示他猜忌功臣、云梦伪游擒捕韩信的权谋。",
    "start": 82.205,
    "end": 87.37,
    "duration": 5.165
  },
  {
    "id": 17,
    "text": "互见法既维护了本传体例的整严，又打破了非黑即白的脸谱化写法，写出人性的复杂真实。",
    "start": 88.193,
    "end": 95.567,
    "duration": 7.374
  },
  {
    "id": 18,
    "text": "第二，精选典型戏剧化历史场景，在尖锐矛盾冲突中彰显人物神采。",
    "start": 96.199,
    "end": 101.609,
    "duration": 5.41
  },
  {
    "id": 19,
    "text": "司马迁善于把复杂漫长的历史进程提炼为高度戏剧化的冲突场面，",
    "start": 102.109,
    "end": 107.267,
    "duration": 5.158
  },
  {
    "id": 20,
    "text": "使人物性格在生死考验中自然显露。",
    "start": 107.617,
    "end": 110.304,
    "duration": 2.687
  },
  {
    "id": 21,
    "text": "最典型的当属《项羽本纪》中的“鸿门宴”：",
    "start": 110.859,
    "end": 113.715,
    "duration": 2.856
  },
  {
    "id": 22,
    "text": "作者以刘邦谢罪、范增举玦、项庄舞剑、樊哙闯帐到刘邦间道脱逃为主线，",
    "start": 114.154,
    "end": 121.137,
    "duration": 6.983
  },
  {
    "id": 23,
    "text": "在营帐方寸之地排布惊险波澜；",
    "start": 121.596,
    "end": 124.213,
    "duration": 2.617
  },
  {
    "id": 24,
    "text": "在这场交锋中，项羽的自矜寡谋与妇人之仁、刘邦的隐忍机警、张良的沉着谋略与范增的急躁远见，",
    "start": 124.713,
    "end": 133.278,
    "duration": 8.565
  },
  {
    "id": 25,
    "text": "全在剑拔弩张的对峙中展露无遗。",
    "start": 133.628,
    "end": 136.127,
    "duration": 2.499
  },
  {
    "id": 26,
    "text": "诸如渑池之会、完璧归赵、易水送别等名场面，皆以紧凑的叙事张力写活了历史人物的风神。",
    "start": 136.627,
    "end": 145.029,
    "duration": 8.402
  },
  {
    "id": 27,
    "text": "第三，善用个性化对话与传神细节白描，如闻其声、如见其人。",
    "start": 145.652,
    "end": 151.746,
    "duration": 6.094
  },
  {
    "id": 28,
    "text": "在人物微观刻画上，司马迁长于借助个性化的语言与精准的动作细节传神写照。",
    "start": 152.318,
    "end": 158.845,
    "duration": 6.527
  },
  {
    "id": 29,
    "text": "同为反秦起义，陈胜仰天发出“王侯将相宁有种乎”，尽显平民领袖反抗命运的豪气；",
    "start": 159.345,
    "end": 166.837,
    "duration": 7.492
  },
  {
    "id": 30,
    "text": "同见秦始皇出巡盛况，项羽脱口而出“彼可取而代也”，流露出楚霸王的张扬强悍；",
    "start": 167.337,
    "end": 175.228,
    "duration": 7.891
  },
  {
    "id": 31,
    "text": "刘邦则感叹“嗟乎，大丈夫当如此也”，折射出市井豪徒的欲望与深沉。",
    "start": 175.767,
    "end": 182.273,
    "duration": 6.506
  },
  {
    "id": 32,
    "text": "在细节描写上，李广一生不得封侯的“数奇”寡言，",
    "start": 182.773,
    "end": 186.542,
    "duration": 3.769
  },
  {
    "id": 33,
    "text": "廉颇肉袒负荆请罪的诚挚勇毅，皆通过片言只语与动作白描跃然纸上，生动传神。",
    "start": 186.892,
    "end": 193.968,
    "duration": 7.076
  },
  {
    "id": 34,
    "text": "第四，贯注发愤著书的批判激情与抒情品格，树立“实录”精神典范。",
    "start": 194.614,
    "end": 200.448,
    "duration": 5.834
  },
  {
    "id": 35,
    "text": "司马迁的人物塑造饱含自身遭逢奇耻大辱后的深沉悲愤与审美理想。",
    "start": 200.948,
    "end": 206.059,
    "duration": 5.111
  },
  {
    "id": 36,
    "text": "他坚持班固所赞“不虚美，不隐恶”的实录原则，既肯定开国君臣的历史功业，也毫不避讳汉武帝晚年的穷兵黩武与猜忌残酷；",
    "start": 206.559,
    "end": 217.298,
    "duration": 10.739
  },
  {
    "id": 37,
    "text": "他在《太史公自序》与各篇卷尾的“太史公曰”中直抒胸臆，",
    "start": 217.798,
    "end": 222.731,
    "duration": 4.933
  },
  {
    "id": 38,
    "text": "为屈原、李广以及刺客、游侠等悲剧人物寄寓深切同情。",
    "start": 223.135,
    "end": 228.001,
    "duration": 4.866
  },
  {
    "id": 39,
    "text": "这种发愤著书的批判精神与实录态度，",
    "start": 228.525,
    "end": 231.408,
    "duration": 2.883
  },
  {
    "id": 40,
    "text": "使《史记》的人物传记兼具史学信实之风与强烈的抒情感染力。",
    "start": 231.798,
    "end": 236.915,
    "duration": 5.117
  },
  {
    "id": 41,
    "text": "由是观之，司马迁在《史记》中以纪传体通史格局与互见法笔法，",
    "start": 237.444,
    "end": 241.912,
    "duration": 4.468
  },
  {
    "id": 42,
    "text": "打破了上古史书以事系人的旧制，在尖锐冲突与白描细节中写活了各阶层历史人物。",
    "start": 242.262,
    "end": 249.316,
    "duration": 7.054
  },
  {
    "id": 43,
    "text": "全书将“不虚美，不隐恶”的史家实录与发愤著书的悲悯情怀相结合，",
    "start": 249.816,
    "end": 255.479,
    "duration": 5.663
  },
  {
    "id": 44,
    "text": "既开创了正史传记文学的正宗体制，也直接启迪了唐宋古文与后世叙事文学的写人艺术。",
    "start": 255.829,
    "end": 264.576,
    "duration": 8.747
  }
]
