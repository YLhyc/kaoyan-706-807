[
  {
    "id": 1,
    "text": "试论《史记》的人物塑造艺术与“互见法”。",
    "start": 0.16,
    "end": 4.76,
    "duration": 4.6
  },
  {
    "id": 2,
    "text": "《史记》 是中国古代第一部纪传体通史，",
    "start": 4.76,
    "end": 7.36,
    "duration": 2.6
  },
  {
    "id": 3,
    "text": "也是中国古典传记文学不可逾越的至高巅峰。",
    "start": 7.36,
    "end": 10.88,
    "duration": 3.52
  },
  {
    "id": 4,
    "text": "面对汉武帝大一统时期的政治专制与自身惨遭李陵之祸腐刑的人生巨变，",
    "start": 10.88,
    "end": 17.04,
    "duration": 6.16
  },
  {
    "id": 5,
    "text": "司马迁秉持发愤著书与实录精神，“究天人之际，通古今之变，",
    "start": 17.04,
    "end": 23.28,
    "duration": 6.24
  },
  {
    "id": 6,
    "text": "成一家之言”。",
    "start": 23.52,
    "end": 25.04,
    "duration": 1.52
  },
  {
    "id": 7,
    "text": "他彻底突破了以往编年体与国别体史书以事系统人的局限，",
    "start": 25.04,
    "end": 31.04,
    "duration": 6.0
  },
  {
    "id": 8,
    "text": "首次以“人”为历史叙事的核心主体。",
    "start": 31.04,
    "end": 34.8,
    "duration": 3.76
  },
  {
    "id": 9,
    "text": "鲁迅赞誉其为 “史家之绝唱，无韵之离骚”。",
    "start": 35.04,
    "end": 39.04,
    "duration": 4.0
  },
  {
    "id": 10,
    "text": "其卓越的人物塑造艺术，主要展现为以下四个核心维度：",
    "start": 39.04,
    "end": 45.04,
    "duration": 6.0
  },
  {
    "id": 11,
    "text": "第一，独创“互见法”叙事体制，塑造多维立体、",
    "start": 45.04,
    "end": 49.04,
    "duration": 4.0
  },
  {
    "id": 12,
    "text": "真实复杂的人物性格。",
    "start": 49.04,
    "end": 50.96,
    "duration": 1.92
  },
  {
    "id": 13,
    "text": "为解决纪传体史书体例严整与人物性格复杂多面之间的矛盾，",
    "start": 50.96,
    "end": 57.04,
    "duration": 6.08
  },
  {
    "id": 14,
    "text": "司马迁独创了 “互见法”。",
    "start": 57.04,
    "end": 59.36,
    "duration": 2.32
  },
  {
    "id": 15,
    "text": "所谓互见法，即把一个人物的主要事迹和主导性格写入其本传，",
    "start": 59.36,
    "end": 65.36,
    "duration": 6.0
  },
  {
    "id": 16,
    "text": "以确立其历史基本定位；而将该人物次要的、矛盾的、",
    "start": 65.36,
    "end": 69.84,
    "duration": 4.48
  },
  {
    "id": 17,
    "text": "乃至有损其主要形象的事迹分散记入其他人物的本纪、",
    "start": 69.84,
    "end": 74.16,
    "duration": 4.32
  },
  {
    "id": 18,
    "text": "世家或列传之中。",
    "start": 74.16,
    "end": 76.32,
    "duration": 2.16
  },
  {
    "id": 19,
    "text": "以 《高祖本纪》 为例，本传重点突出刘邦豁达大度、",
    "start": 76.32,
    "end": 80.64,
    "duration": 4.32
  },
  {
    "id": 20,
    "text": "知人善任、从谏如流的开国帝王雄姿；",
    "start": 80.64,
    "end": 84.32,
    "duration": 3.68
  },
  {
    "id": 21,
    "text": "然而在 《项羽本纪》 中，",
    "start": 84.32,
    "end": 86.0,
    "duration": 1.68
  },
  {
    "id": 22,
    "text": "却补记了他危急逃跑时三次将亲生儿女推下马车的冷酷自私；",
    "start": 86.08,
    "end": 92.08,
    "duration": 6.0
  },
  {
    "id": 23,
    "text": "在 《淮阴侯列传》 中，补录了他出尔反尔、",
    "start": 92.08,
    "end": 96.0,
    "duration": 3.92
  },
  {
    "id": 24,
    "text": "捕杀功臣韩信的猜忌残忍。",
    "start": 96.0,
    "end": 98.48,
    "duration": 2.48
  },
  {
    "id": 25,
    "text": "互见法的运用，既维护了全书体例的整肃，",
    "start": 98.48,
    "end": 102.64,
    "duration": 4.16
  },
  {
    "id": 26,
    "text": "又撕碎了封建史家非黑即白的脸谱化模式，",
    "start": 102.64,
    "end": 106.48,
    "duration": 3.84
  },
  {
    "id": 27,
    "text": "生动还原出活生生的人性真实。",
    "start": 106.864,
    "end": 109.264,
    "duration": 2.4
  },
  {
    "id": 28,
    "text": "第二，精选典型戏剧化历史场景，在尖锐矛盾冲突中彰显人物神采。",
    "start": 109.264,
    "end": 115.824,
    "duration": 6.56
  },
  {
    "id": 29,
    "text": "司马迁善于把复杂漫长的历史进程提炼为高度戏剧化的冲突场面，",
    "start": 115.824,
    "end": 122.864,
    "duration": 7.04
  },
  {
    "id": 30,
    "text": "使人物性格在生死存亡的严峻考验中迸发光芒。",
    "start": 122.864,
    "end": 128.304,
    "duration": 5.44
  },
  {
    "id": 31,
    "text": "最典型的当属 《项羽本纪》 中的 “鸿门宴”：",
    "start": 128.304,
    "end": 132.864,
    "duration": 4.56
  },
  {
    "id": 32,
    "text": "作者以刘邦谢罪、范增举玦、项庄拔剑起舞、",
    "start": 133.264,
    "end": 137.504,
    "duration": 4.24
  },
  {
    "id": 33,
    "text": "樊哙闯帐撞盾到刘邦间道脱逃为主线，",
    "start": 137.904,
    "end": 142.144,
    "duration": 4.24
  },
  {
    "id": 34,
    "text": "在营帐方寸之地排布极其惊险的生死波澜；在这一极端冲突中，",
    "start": 142.144,
    "end": 149.024,
    "duration": 6.88
  },
  {
    "id": 35,
    "text": "项羽的自矜寡谋与妇人之仁、刘邦的隐忍机警与狡黠多诈、",
    "start": 149.184,
    "end": 154.784,
    "duration": 5.6
  },
  {
    "id": 36,
    "text": "张良的沉着机谋与范增的急躁远见，全在刀光剑影中展露无遗。",
    "start": 154.784,
    "end": 160.784,
    "duration": 6.0
  },
  {
    "id": 37,
    "text": "此外如渑池之会、完璧归赵、易水送别等名场面，",
    "start": 160.944,
    "end": 165.344,
    "duration": 4.4
  },
  {
    "id": 38,
    "text": "皆以极强的故事张力将人物性格推向极境。",
    "start": 165.344,
    "end": 168.624,
    "duration": 3.28
  },
  {
    "id": 39,
    "text": "第三，长于个性化对话与传神细节白描，做到“其言如出其口，",
    "start": 168.624,
    "end": 175.264,
    "duration": 6.64
  },
  {
    "id": 40,
    "text": "其容如在其目”。",
    "start": 175.264,
    "end": 176.544,
    "duration": 1.28
  },
  {
    "id": 41,
    "text": "在人物微观刻画上，",
    "start": 176.544,
    "end": 178.624,
    "duration": 2.08
  },
  {
    "id": 42,
    "text": "司马迁善于借助极具个性色彩的语言与细致入微的动作捕捉灵魂。",
    "start": 178.624,
    "end": 184.784,
    "duration": 6.16
  },
  {
    "id": 43,
    "text": "同为起义反秦，陈胜仰天长叹发出 “王侯将相宁有种乎”，",
    "start": 185.104,
    "end": 190.784,
    "duration": 5.68
  },
  {
    "id": 44,
    "text": "展现平民领袖敢于挑战命运的豪气；同见秦始皇出巡盛况，",
    "start": 191.104,
    "end": 196.224,
    "duration": 5.12
  },
  {
    "id": 45,
    "text": "项羽脱口而出 “彼可取而代也”，",
    "start": 196.224,
    "end": 199.584,
    "duration": 3.36
  },
  {
    "id": 46,
    "text": "暴露出楚霸王不可一世的张扬强悍；刘邦则低语 “嗟乎，",
    "start": 199.584,
    "end": 204.704,
    "duration": 5.12
  },
  {
    "id": 47,
    "text": "大丈夫当如此也”，尽显市井豪徒的贪婪与隐忍。",
    "start": 204.704,
    "end": 209.504,
    "duration": 4.8
  },
  {
    "id": 48,
    "text": "在细节描写上，李广一生不得封侯的 “数奇” 寡言，",
    "start": 209.504,
    "end": 213.664,
    "duration": 4.16
  },
  {
    "id": 49,
    "text": "廉颇负荆请罪的真诚勇毅，",
    "start": 213.664,
    "end": 215.984,
    "duration": 2.32
  },
  {
    "id": 50,
    "text": "皆通过片言只语与精准动作白描跃然纸上，",
    "start": 215.984,
    "end": 220.064,
    "duration": 4.08
  },
  {
    "id": 51,
    "text": "达到了呼之欲出的传神境界。",
    "start": 220.064,
    "end": 222.544,
    "duration": 2.48
  },
  {
    "id": 52,
    "text": "第四，贯注发愤著书的批判激情与抒情品格，",
    "start": 222.704,
    "end": 226.464,
    "duration": 3.76
  },
  {
    "id": 53,
    "text": "开创“实录”精神典范。",
    "start": 226.464,
    "end": 228.388,
    "duration": 1.924
  },
  {
    "id": 54,
    "text": "司马迁的人物塑造绝非冷冰冰的材料堆砌，",
    "start": 228.388,
    "end": 231.77,
    "duration": 3.382
  },
  {
    "id": 55,
    "text": "而是倾注了自身遭受奇耻大辱后的强烈悲愤与审美理想。",
    "start": 231.77,
    "end": 236.468,
    "duration": 4.698
  },
  {
    "id": 56,
    "text": "他坚持“不虚美，不隐恶”的实录原则，",
    "start": 236.468,
    "end": 239.85,
    "duration": 3.382
  },
  {
    "id": 57,
    "text": "既肯定开国君臣的历史功业，",
    "start": 239.85,
    "end": 241.917,
    "duration": 2.067
  },
  {
    "id": 58,
    "text": "亦毫不留情地揭露汉武帝晚年的穷兵黩武与残酷猜忌；",
    "start": 241.917,
    "end": 243.984,
    "duration": 2.067
  },
  {
    "id": 59,
    "text": "他在 《太史公自序》 与各篇卷尾的 “太史公曰” 中直抒胸臆，",
    "start": 243.796,
    "end": 243.984,
    "duration": 0.188
  },
  {
    "id": 60,
    "text": "为屈原、管仲、刺客、",
    "start": 243.796,
    "end": 243.984,
    "duration": 0.188
  },
  {
    "id": 61,
    "text": "游侠等受压抑的悲剧英雄寄寓深切的同情。",
    "start": 243.796,
    "end": 243.984,
    "duration": 0.188
  },
  {
    "id": 62,
    "text": "这种发愤著书的崇高批判精神，",
    "start": 243.796,
    "end": 243.984,
    "duration": 0.188
  },
  {
    "id": 63,
    "text": "使 《史记》 的人物传记闪耀着强烈的抒情色彩与崇高的人格魅力。",
    "start": 243.796,
    "end": 243.984,
    "duration": 0.188
  }
]