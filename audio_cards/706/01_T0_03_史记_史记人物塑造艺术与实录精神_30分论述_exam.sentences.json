[
  {
    "id": 1,
    "text": "试论《史记》的人物塑造艺术与“互见法”。",
    "start": 0.16,
    "end": 2.718,
    "duration": 2.558
  },
  {
    "id": 2,
    "text": "《史记》是中国古代第一部纪传体通史，也是古典传记文学的典范之作。",
    "start": 3.164,
    "end": 8.688,
    "duration": 5.524
  },
  {
    "id": 3,
    "text": "面对汉武帝时期的政治现实与自身惨遭腐刑的人生巨变，",
    "start": 9.227,
    "end": 13.88,
    "duration": 4.653
  },
  {
    "id": 4,
    "text": "司马迁秉持发愤著书与实录精神，“究天人之际，通古今之变，成一家之言”，",
    "start": 14.21,
    "end": 20.878,
    "duration": 6.668
  },
  {
    "id": 5,
    "text": "突破以往编年体与国别体史书以事系人的局限，首次以“人”为历史叙事的中心。",
    "start": 21.015,
    "end": 27.739,
    "duration": 6.724
  },
  {
    "id": 6,
    "text": "鲁迅赞誉其为“史家之绝唱，无韵之离骚”。",
    "start": 28.146,
    "end": 31.707,
    "duration": 3.561
  },
  {
    "id": 7,
    "text": "其卓越的人物塑造艺术，主要体现在以下四个方面：",
    "start": 32.062,
    "end": 35.751,
    "duration": 3.689
  },
  {
    "id": 8,
    "text": "第一，独创“互见法”叙事体制，塑造多维立体、真实复杂的人物性格。",
    "start": 36.409,
    "end": 42.251,
    "duration": 5.842
  },
  {
    "id": 9,
    "text": "为解决史书体例整肃与人物性格复杂多面之间的矛盾，",
    "start": 42.59,
    "end": 46.769,
    "duration": 4.179
  },
  {
    "id": 10,
    "text": "司马迁独创了“互见法”（又称旁见侧出法），",
    "start": 47.095,
    "end": 50.987,
    "duration": 3.892
  },
  {
    "id": 11,
    "text": "即把一个人物的主要事迹和主导性格写入本传，",
    "start": 51.38,
    "end": 54.961,
    "duration": 3.581
  },
  {
    "id": 12,
    "text": "而将其次要的、矛盾的乃至有损主要形象的事迹分散记入他人本纪、世家或列传之中。",
    "start": 55.27,
    "end": 63.109,
    "duration": 7.839
  },
  {
    "id": 13,
    "text": "以《高祖本纪》为例，本传重点突出刘邦豁达大度、知人善任的开国帝王气度；",
    "start": 63.386,
    "end": 69.988,
    "duration": 6.602
  },
  {
    "id": 14,
    "text": "《项羽本纪》则借范增之口道出其贪财好色，",
    "start": 70.216,
    "end": 74.1,
    "duration": 3.884
  },
  {
    "id": 15,
    "text": "《樊郦滕灌列传》补记他战败逃跑时屡将亲生儿女推下马车的冷酷自私，",
    "start": 74.346,
    "end": 80.569,
    "duration": 6.223
  },
  {
    "id": 16,
    "text": "《淮阴侯列传》则揭示他猜忌功臣、捕杀韩信的残忍。",
    "start": 80.816,
    "end": 85.362,
    "duration": 4.546
  },
  {
    "id": 17,
    "text": "互见法既维护了本传体例的整严，又打破了非黑即白的脸谱化写法，写出人性的复杂真实。",
    "start": 86.017,
    "end": 93.427,
    "duration": 7.41
  },
  {
    "id": 18,
    "text": "第二，精选典型戏剧化历史场景，在尖锐矛盾冲突中彰显人物神采。",
    "start": 94.059,
    "end": 99.469,
    "duration": 5.41
  },
  {
    "id": 19,
    "text": "司马迁善于把复杂漫长的历史进程提炼为高度戏剧化的冲突场面，",
    "start": 99.962,
    "end": 105.296,
    "duration": 5.334
  },
  {
    "id": 20,
    "text": "使人物性格在生死考验中自然显露。",
    "start": 105.296,
    "end": 108.103,
    "duration": 2.807
  },
  {
    "id": 21,
    "text": "最典型的当属《项羽本纪》中的“鸿门宴”：",
    "start": 108.658,
    "end": 111.514,
    "duration": 2.856
  },
  {
    "id": 22,
    "text": "作者以刘邦谢罪、范增举玦、项庄舞剑、樊哙闯帐到刘邦间道脱逃为主线，",
    "start": 111.953,
    "end": 118.936,
    "duration": 6.983
  },
  {
    "id": 23,
    "text": "在营帐方寸之地排布惊险波澜；",
    "start": 119.395,
    "end": 122.012,
    "duration": 2.617
  },
  {
    "id": 24,
    "text": "在这场交锋中，项羽的自矜寡谋与妇人之仁、刘邦的隐忍机警、张良的沉着谋略与范增的急躁远见，",
    "start": 122.24,
    "end": 130.919,
    "duration": 8.679
  },
  {
    "id": 25,
    "text": "全在剑拔弩张的对峙中展露无遗。",
    "start": 130.919,
    "end": 133.557,
    "duration": 2.638
  },
  {
    "id": 26,
    "text": "诸如渑池之会、完璧归赵、易水送别等名场面，皆以紧凑的叙事张力写活了历史人物的风神。",
    "start": 133.817,
    "end": 142.219,
    "duration": 8.402
  },
  {
    "id": 27,
    "text": "第三，善用个性化对话与传神细节白描，如闻其声、如见其人。",
    "start": 142.842,
    "end": 148.936,
    "duration": 6.094
  },
  {
    "id": 28,
    "text": "在人物微观刻画上，司马迁长于借助个性化的语言与精准的动作细节传神写照。",
    "start": 149.508,
    "end": 156.035,
    "duration": 6.527
  },
  {
    "id": 29,
    "text": "同为反秦起义，陈胜仰天发出“王侯将相宁有种乎”，尽显平民领袖反抗命运的豪气；",
    "start": 156.517,
    "end": 164.009,
    "duration": 7.492
  },
  {
    "id": 30,
    "text": "同见秦始皇出巡盛况，项羽脱口而出“彼可取而代也”，流露出楚霸王的张扬强悍；",
    "start": 164.296,
    "end": 172.187,
    "duration": 7.891
  },
  {
    "id": 31,
    "text": "刘邦则感叹“嗟乎，大丈夫当如此也”，折射出市井豪徒的欲望与深沉。",
    "start": 172.726,
    "end": 179.243,
    "duration": 6.517
  },
  {
    "id": 32,
    "text": "在细节描写上，李广一生不得封侯的“数奇”寡言，",
    "start": 179.705,
    "end": 183.474,
    "duration": 3.769
  },
  {
    "id": 33,
    "text": "廉颇肉袒负荆请罪的诚挚勇毅，皆通过片言只语与动作白描跃然纸上，生动传神。",
    "start": 183.823,
    "end": 190.899,
    "duration": 7.076
  },
  {
    "id": 34,
    "text": "第四，贯注发愤著书的批判激情与抒情品格，树立“实录”精神典范。",
    "start": 191.545,
    "end": 197.379,
    "duration": 5.834
  },
  {
    "id": 35,
    "text": "司马迁的人物塑造饱含自身遭逢奇耻大辱后的深沉悲愤与审美理想。",
    "start": 197.65,
    "end": 202.761,
    "duration": 5.111
  },
  {
    "id": 36,
    "text": "他坚持“不虚美，不隐恶”的实录原则，既肯定开国君臣的历史功业，",
    "start": 203.036,
    "end": 208.084,
    "duration": 5.048
  },
  {
    "id": 37,
    "text": "也毫不避讳汉武帝晚年的穷兵黩武与猜忌残酷；",
    "start": 208.399,
    "end": 212.051,
    "duration": 3.652
  },
  {
    "id": 38,
    "text": "他在《太史公自序》与各篇卷尾的“太史公曰”中直抒胸臆，",
    "start": 212.346,
    "end": 217.279,
    "duration": 4.933
  },
  {
    "id": 39,
    "text": "为屈原、李广以及刺客、游侠等悲剧人物寄寓深切同情。",
    "start": 217.683,
    "end": 222.549,
    "duration": 4.866
  },
  {
    "id": 40,
    "text": "这种发愤著书的批判精神与实录态度，",
    "start": 223.073,
    "end": 225.956,
    "duration": 2.883
  },
  {
    "id": 41,
    "text": "使《史记》的人物传记兼具史学信实之风与强烈的抒情感染力。",
    "start": 226.346,
    "end": 231.463,
    "duration": 5.117
  }
]