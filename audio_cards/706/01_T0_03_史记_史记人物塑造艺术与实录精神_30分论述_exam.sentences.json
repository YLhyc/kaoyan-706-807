[
  {
    "id": 1,
    "text": "试论《史记》的人物塑造艺术与“互见法”。",
    "start": 0.16,
    "end": 2.721,
    "duration": 2.561
  },
  {
    "id": 2,
    "text": "《史记》是中国古代第一部纪传体通史，",
    "start": 3.164,
    "end": 6.18,
    "duration": 3.016
  },
  {
    "id": 3,
    "text": "也是古典传记文学的典范之作。",
    "start": 6.529,
    "end": 8.678,
    "duration": 2.149
  },
  {
    "id": 4,
    "text": "面对汉武帝时期的政治现实与自身惨遭腐刑的人生巨变，",
    "start": 9.227,
    "end": 13.87,
    "duration": 4.643
  },
  {
    "id": 5,
    "text": "司马迁秉持发愤著书与实录精神，“究天人之际，通古今之变，",
    "start": 14.21,
    "end": 19.585,
    "duration": 5.375
  },
  {
    "id": 6,
    "text": "成一家之言”，突破以往编年体与国别体史书以事系人的局限，",
    "start": 19.874,
    "end": 25.12,
    "duration": 5.246
  },
  {
    "id": 7,
    "text": "首次以“人”为历史叙事的中心。",
    "start": 25.456,
    "end": 27.729,
    "duration": 2.273
  },
  {
    "id": 8,
    "text": "鲁迅赞誉其为“史家之绝唱，无韵之离骚”。",
    "start": 28.146,
    "end": 31.697,
    "duration": 3.551
  },
  {
    "id": 9,
    "text": "其卓越的人物塑造艺术，主要体现在以下四个方面：",
    "start": 32.062,
    "end": 35.741,
    "duration": 3.679
  },
  {
    "id": 10,
    "text": "第一，独创“互见法”叙事体制，塑造多维立体、",
    "start": 36.409,
    "end": 40.447,
    "duration": 4.038
  },
  {
    "id": 11,
    "text": "真实复杂的人物性格。",
    "start": 40.747,
    "end": 42.241,
    "duration": 1.494
  },
  {
    "id": 12,
    "text": "为解决史书体例整肃与人物性格复杂多面之间的矛盾，",
    "start": 42.59,
    "end": 46.759,
    "duration": 4.169
  },
  {
    "id": 13,
    "text": "司马迁独创了“互见法”（又称旁见侧出法），",
    "start": 47.095,
    "end": 50.977,
    "duration": 3.882
  },
  {
    "id": 14,
    "text": "即把一个人物的主要事迹和主导性格写入本传，而将其次要的、",
    "start": 51.38,
    "end": 56.447,
    "duration": 5.067
  },
  {
    "id": 15,
    "text": "矛盾的乃至有损主要形象的事迹分散记入他人本纪、",
    "start": 56.735,
    "end": 61.145,
    "duration": 4.41
  },
  {
    "id": 16,
    "text": "世家或列传之中。",
    "start": 61.514,
    "end": 63.099,
    "duration": 1.585
  },
  {
    "id": 17,
    "text": "以《高祖本纪》为例，本传重点突出刘邦豁达大度、",
    "start": 63.386,
    "end": 67.699,
    "duration": 4.313
  },
  {
    "id": 18,
    "text": "知人善任的开国帝王气度；",
    "start": 67.979,
    "end": 69.978,
    "duration": 1.999
  },
  {
    "id": 19,
    "text": "《项羽本纪》则借范增之口道出其贪财好色，",
    "start": 70.216,
    "end": 74.09,
    "duration": 3.874
  },
  {
    "id": 20,
    "text": "《樊郦滕灌列传》补记他战败逃跑时屡将亲生儿女推下马车的冷酷自私，",
    "start": 74.346,
    "end": 80.559,
    "duration": 6.213
  },
  {
    "id": 21,
    "text": "《淮阴侯列传》则揭示他猜忌功臣、捕杀韩信的残忍。",
    "start": 80.816,
    "end": 85.36,
    "duration": 4.544
  },
  {
    "id": 22,
    "text": "互见法既维护了本传体例的整严，",
    "start": 86.017,
    "end": 88.809,
    "duration": 2.792
  },
  {
    "id": 23,
    "text": "又打破了非黑即白的脸谱化写法，写出人性的复杂真实。",
    "start": 88.902,
    "end": 93.417,
    "duration": 4.515
  },
  {
    "id": 24,
    "text": "第二，精选典型戏剧化历史场景，在尖锐矛盾冲突中彰显人物神采。",
    "start": 94.059,
    "end": 99.459,
    "duration": 5.4
  },
  {
    "id": 25,
    "text": "司马迁善于把复杂漫长的历史进程提炼为高度戏剧化的冲突场面，",
    "start": 99.962,
    "end": 105.099,
    "duration": 5.137
  },
  {
    "id": 26,
    "text": "使人物性格在生死考验中自然显露。",
    "start": 105.296,
    "end": 108.093,
    "duration": 2.797
  },
  {
    "id": 27,
    "text": "最典型的当属《项羽本纪》中的“鸿门宴”：作者以刘邦谢罪、",
    "start": 108.658,
    "end": 113.172,
    "duration": 4.514
  },
  {
    "id": 28,
    "text": "范增举玦、项庄舞剑、樊哙闯帐到刘邦间道脱逃为主线，",
    "start": 113.423,
    "end": 118.926,
    "duration": 5.503
  },
  {
    "id": 29,
    "text": "在营帐方寸之地排布惊险波澜；在这场交锋中，",
    "start": 119.395,
    "end": 123.258,
    "duration": 3.863
  },
  {
    "id": 30,
    "text": "项羽的自矜寡谋与妇人之仁、刘邦的隐忍机警、",
    "start": 123.525,
    "end": 127.539,
    "duration": 4.014
  },
  {
    "id": 31,
    "text": "张良的沉着谋略与范增的急躁远见，",
    "start": 127.936,
    "end": 130.791,
    "duration": 2.855
  },
  {
    "id": 32,
    "text": "全在剑拔弩张的对峙中展露无遗。",
    "start": 130.919,
    "end": 133.547,
    "duration": 2.628
  },
  {
    "id": 33,
    "text": "诸如渑池之会、完璧归赵、易水送别等名场面，",
    "start": 133.817,
    "end": 138.531,
    "duration": 4.714
  },
  {
    "id": 34,
    "text": "皆以紧凑的叙事张力写活了历史人物的风神。",
    "start": 138.793,
    "end": 142.209,
    "duration": 3.416
  },
  {
    "id": 35,
    "text": "第三，善用个性化对话与传神细节白描，如闻其声、如见其人。",
    "start": 142.842,
    "end": 148.926,
    "duration": 6.084
  },
  {
    "id": 36,
    "text": "在人物微观刻画上，",
    "start": 149.508,
    "end": 150.851,
    "duration": 1.343
  },
  {
    "id": 37,
    "text": "司马迁长于借助个性化的语言与精准的动作细节传神写照。",
    "start": 151.031,
    "end": 156.029,
    "duration": 4.998
  },
  {
    "id": 38,
    "text": "同为反秦起义，陈胜仰天发出“王侯将相宁有种乎”，",
    "start": 156.517,
    "end": 161.155,
    "duration": 4.638
  },
  {
    "id": 39,
    "text": "尽显平民领袖反抗命运的豪气；同见秦始皇出巡盛况，",
    "start": 161.534,
    "end": 166.314,
    "duration": 4.78
  },
  {
    "id": 40,
    "text": "项羽脱口而出“彼可取而代也”，流露出楚霸王的张扬强悍；",
    "start": 166.867,
    "end": 172.177,
    "duration": 5.31
  },
  {
    "id": 41,
    "text": "刘邦则感叹“嗟乎，大丈夫当如此也”，",
    "start": 172.726,
    "end": 176.218,
    "duration": 3.492
  },
  {
    "id": 42,
    "text": "折射出市井豪徒的欲望与深沉。",
    "start": 176.649,
    "end": 179.233,
    "duration": 2.584
  },
  {
    "id": 43,
    "text": "在细节描写上，李广一生不得封侯的“数奇”寡言，",
    "start": 179.705,
    "end": 183.464,
    "duration": 3.759
  },
  {
    "id": 44,
    "text": "廉颇肉袒负荆请罪的诚挚勇毅，",
    "start": 183.823,
    "end": 186.401,
    "duration": 2.578
  },
  {
    "id": 45,
    "text": "皆通过片言只语与动作白描跃然纸上，生动传神。",
    "start": 186.681,
    "end": 190.889,
    "duration": 4.208
  },
  {
    "id": 46,
    "text": "第四，贯注发愤著书的批判激情与抒情品格，",
    "start": 191.545,
    "end": 195.569,
    "duration": 4.024
  },
  {
    "id": 47,
    "text": "树立“实录”精神典范。",
    "start": 195.862,
    "end": 197.369,
    "duration": 1.507
  },
  {
    "id": 48,
    "text": "司马迁的人物塑造饱含自身遭逢奇耻大辱后的深沉悲愤与审美理想。",
    "start": 197.65,
    "end": 202.751,
    "duration": 5.101
  },
  {
    "id": 49,
    "text": "他坚持“不虚美，不隐恶”的实录原则，",
    "start": 203.036,
    "end": 205.847,
    "duration": 2.811
  },
  {
    "id": 50,
    "text": "既肯定开国君臣的历史功业，",
    "start": 206.122,
    "end": 208.074,
    "duration": 1.952
  },
  {
    "id": 51,
    "text": "也毫不避讳汉武帝晚年的穷兵黩武与猜忌残酷；",
    "start": 208.399,
    "end": 212.041,
    "duration": 3.642
  },
  {
    "id": 52,
    "text": "他在《太史公自序》与各篇卷尾的“太史公曰”中直抒胸臆，",
    "start": 212.346,
    "end": 217.269,
    "duration": 4.923
  },
  {
    "id": 53,
    "text": "为屈原、李广以及刺客、游侠等悲剧人物寄寓深切同情。",
    "start": 217.683,
    "end": 222.539,
    "duration": 4.856
  },
  {
    "id": 54,
    "text": "这种发愤著书的批判精神与实录态度，",
    "start": 223.073,
    "end": 225.949,
    "duration": 2.876
  },
  {
    "id": 55,
    "text": "使《史记》的人物传记兼具史学信实之风与强烈的抒情感染力。",
    "start": 226.346,
    "end": 231.463,
    "duration": 5.117
  }
]