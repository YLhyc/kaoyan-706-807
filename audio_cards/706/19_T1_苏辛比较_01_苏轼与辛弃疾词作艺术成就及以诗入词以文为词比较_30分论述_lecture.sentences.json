[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 3.12,
    "duration": 3.04
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 3.12,
    "end": 6.56,
    "duration": 3.44
  },
  {
    "id": 3,
    "text": "这道题考查宋代豪放词史的核心演进脉络。",
    "start": 6.56,
    "end": 10.32,
    "duration": 3.76
  },
  {
    "id": 4,
    "text": "在考场上，考生不能简单只列举几首苏词和辛词的名句，",
    "start": 10.32,
    "end": 15.12,
    "duration": 4.8
  },
  {
    "id": 5,
    "text": "而必须准确辨析出苏轼之“旷”与辛弃疾之“悲”的内在区别，",
    "start": 15.12,
    "end": 20.32,
    "duration": 5.2
  },
  {
    "id": 6,
    "text": "并准确回答出“以诗入词”与“以文为词”在文体技法革新上的逻辑递进关系。",
    "start": 20.32,
    "end": 26.56,
    "duration": 6.24
  },
  {
    "id": 7,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 26.96,
    "end": 30.0,
    "duration": 3.04
  },
  {
    "id": 8,
    "text": "答题必须确立“知人论世与文体演进相统一”的三维支撑。",
    "start": 30.0,
    "end": 35.28,
    "duration": 5.28
  },
  {
    "id": 9,
    "text": "从北宋士大夫精神与南宋民族危机历史语境切入，",
    "start": 35.28,
    "end": 39.68,
    "duration": 4.4
  },
  {
    "id": 10,
    "text": "对比两者的情感气质与题材领域，核心突破点放在对“以诗入词”和“以文为词”的概念内涵与形式机制的精辟解剖上。",
    "start": 39.68,
    "end": 50.4,
    "duration": 10.72
  },
  {
    "id": 11,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 50.64,
    "end": 54.08,
    "duration": 3.44
  },
  {
    "id": 12,
    "text": "全题分为四个核心论述维度：第一维度：界定“苏辛”并称在宋代词体革新史上的坐标；",
    "start": 54.08,
    "end": 61.28,
    "duration": 7.2
  },
  {
    "id": 13,
    "text": "第二维度：深入剖析两者在人格追求与精神气象上的异同（超脱旷达的哲理智慧versus英雄失路的沉雄悲愤）；",
    "start": 61.28,
    "end": 70.8,
    "duration": 9.52
  },
  {
    "id": 14,
    "text": "第三维度：深刻对比两者的词境开拓与题材指向（文人仕隐与哲思宇宙versus民族战火与政治关怀）；",
    "start": 71.04,
    "end": 80.56,
    "duration": 9.52
  },
  {
    "id": 15,
    "text": "第四维度：精准辨析“以诗入词”与“以文为词”的技术机制与文体史价值；",
    "start": 80.56,
    "end": 87.84,
    "duration": 7.28
  },
  {
    "id": 16,
    "text": "第五维度：宏观总结两者对宋词摆脱歌妓艳科地位、",
    "start": 87.84,
    "end": 92.48,
    "duration": 4.64
  },
  {
    "id": 17,
    "text": "走向言志文学的划时代贡献。",
    "start": 92.48,
    "end": 94.8,
    "duration": 2.32
  },
  {
    "id": 18,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 95.2,
    "end": 98.8,
    "duration": 3.6
  },
  {
    "id": 19,
    "text": "全题逻辑严密咬合：第一步先确立两者同为豪放派宗师的并峙地位。",
    "start": 98.8,
    "end": 104.16,
    "duration": 5.36
  },
  {
    "id": 20,
    "text": "第二步剖析两者思想灵魂的差异，即北宋理趣旷达与南宋民族血性。",
    "start": 104.16,
    "end": 110.0,
    "duration": 5.84
  },
  {
    "id": 21,
    "text": "第三步展现这种精神如何外化为题材的不同广度。",
    "start": 110.0,
    "end": 113.68,
    "duration": 3.68
  },
  {
    "id": 22,
    "text": "第四步落脚到最核心的文体手法，对比诗法与散文法入词。",
    "start": 113.92,
    "end": 118.88,
    "duration": 4.96
  },
  {
    "id": 23,
    "text": "第五步完成宏观历史论证闭环。",
    "start": 118.88,
    "end": 122.0,
    "duration": 3.12
  },
  {
    "id": 24,
    "text": "二、各板块逐句咬合演练。",
    "start": 122.0,
    "end": 124.56,
    "duration": 2.56
  },
  {
    "id": 25,
    "text": "一、开头破题段内部咬合。",
    "start": 124.56,
    "end": 127.12,
    "duration": 2.56
  },
  {
    "id": 26,
    "text": "本段旨在开门见山确立并称双峰的立论基石。",
    "start": 127.12,
    "end": 130.96,
    "duration": 3.84
  },
  {
    "id": 27,
    "text": "首句直切经典定位，次句与第三句分别定性苏轼与辛弃疾的时代底色。",
    "start": 130.96,
    "end": 136.8,
    "duration": 5.84
  },
  {
    "id": 28,
    "text": "-首先，首句必须直接亮出苏辛并称的词史坐标，",
    "start": 137.04,
    "end": 140.9,
    "duration": 3.86
  },
  {
    "id": 29,
    "text": "具体表述到答题语句就是：苏轼与辛弃疾被后世并称为“苏辛”，",
    "start": 140.9,
    "end": 145.98,
    "duration": 5.08
  },
  {
    "id": 30,
    "text": "是中国宋代词史上开创豪放词风的并峙双峰。",
    "start": 145.98,
    "end": 149.84,
    "duration": 3.86
  },
  {
    "id": 31,
    "text": "-有了双峰定位之后，次句必须迅速说明苏轼的开创之功，",
    "start": 149.904,
    "end": 154.431,
    "duration": 4.527
  },
  {
    "id": 32,
    "text": "具体表述到答题语句就是：苏轼以其超迈旷达之天才首开豪迈雄健之风，",
    "start": 154.431,
    "end": 160.336,
    "duration": 5.905
  },
  {
    "id": 33,
    "text": "使词从“歌妓之曲”迈向“士大夫之言”。",
    "start": 160.336,
    "end": 163.092,
    "duration": 2.756
  },
  {
    "id": 34,
    "text": "紧接着，指出辛弃疾在南宋危局中的继承深化，",
    "start": 163.092,
    "end": 166.832,
    "duration": 3.74
  },
  {
    "id": 35,
    "text": "具体表述到答题语句就是：辛弃疾则在南宋民族危亡的历史语境中接续并深化这一传统，",
    "start": 166.832,
    "end": 174.115,
    "duration": 7.283
  },
  {
    "id": 36,
    "text": "形成了慷慨悲壮、沉郁抗坠的独特美学。",
    "start": 174.115,
    "end": 177.264,
    "duration": 3.149
  },
  {
    "id": 37,
    "text": "-随后，末句干脆利落开启下文展开维度，",
    "start": 177.264,
    "end": 180.938,
    "duration": 3.674
  },
  {
    "id": 38,
    "text": "具体表述到答题语句就是：两者在精神底色、",
    "start": 180.938,
    "end": 185.072,
    "duration": 4.134
  },
  {
    "id": 39,
    "text": "词境营造与文体技法上各具独创贡献。",
    "start": 185.072,
    "end": 188.747,
    "duration": 3.675
  },
  {
    "id": 40,
    "text": "苏轼与辛弃疾被后世并称为“苏辛”，",
    "start": 188.747,
    "end": 191.962,
    "duration": 3.215
  },
  {
    "id": 41,
    "text": "是中国宋代词史上开创豪放词风的并峙双峰。",
    "start": 191.962,
    "end": 196.325,
    "duration": 4.363
  },
  {
    "id": 42,
    "text": "苏轼以其超迈旷达之天才首开豪迈雄健之风，",
    "start": 196.325,
    "end": 200.689,
    "duration": 4.364
  },
  {
    "id": 43,
    "text": "使词从“歌妓之曲”迈向“士大夫之言”。",
    "start": 200.689,
    "end": 203.904,
    "duration": 3.215
  },
  {
    "id": 44,
    "text": "辛弃疾则在南宋民族危亡的历史语境中接续并深化这一传统，",
    "start": 204.064,
    "end": 209.264,
    "duration": 5.2
  },
  {
    "id": 45,
    "text": "形成了慷慨悲壮、沉郁抗坠的独特美学。",
    "start": 209.264,
    "end": 213.024,
    "duration": 3.76
  },
  {
    "id": 46,
    "text": "两者在精神底色、词境营造与文体技法上各具独创贡献。",
    "start": 213.024,
    "end": 218.144,
    "duration": 5.12
  },
  {
    "id": 47,
    "text": "二、第一维度：主体精神品格与情感气象对比内部咬合。",
    "start": 218.144,
    "end": 223.104,
    "duration": 4.96
  },
  {
    "id": 48,
    "text": "本段任务是深入剖析超迈旷达与沉郁悲壮的心理成因与名篇呈现。",
    "start": 223.104,
    "end": 228.544,
    "duration": 5.44
  },
  {
    "id": 49,
    "text": "-首先，段首给出结论先行的分论点，",
    "start": 228.704,
    "end": 231.713,
    "duration": 3.009
  },
  {
    "id": 50,
    "text": "具体表述到答题语句就是：第一，在主体精神品格与情感气象上，",
    "start": 231.713,
    "end": 237.301,
    "duration": 5.588
  },
  {
    "id": 51,
    "text": "苏轼词充溢着解脱旷达的哲理智慧，",
    "start": 237.301,
    "end": 240.525,
    "duration": 3.224
  },
  {
    "id": 52,
    "text": "辛弃疾词则激荡着英雄失路的悲愤沉雄。",
    "start": 240.525,
    "end": 244.179,
    "duration": 3.654
  },
  {
    "id": 53,
    "text": "随后，展开苏轼超越苦难的文化心理机制，",
    "start": 244.179,
    "end": 247.832,
    "duration": 3.653
  },
  {
    "id": 54,
    "text": "具体表述到答题语句就是：苏轼虽一生屡遭贬哲，",
    "start": 247.832,
    "end": 252.131,
    "duration": 4.299
  },
  {
    "id": 55,
    "text": "但深得儒释道三家滋养，具有超越现实政治苦难的博大胸襟。",
    "start": 252.131,
    "end": 257.504,
    "duration": 5.373
  },
  {
    "id": 56,
    "text": "-紧接着，调取《定风波》名场面展开论证，",
    "start": 257.504,
    "end": 260.676,
    "duration": 3.172
  },
  {
    "id": 57,
    "text": "具体表述到答题语句就是：其在《定风波》中面对山头急雨，",
    "start": 260.676,
    "end": 265.54,
    "duration": 4.864
  },
  {
    "id": 58,
    "text": "从容吟啸“莫听穿林打叶声，何妨吟啸且徐行”，",
    "start": 265.54,
    "end": 269.346,
    "duration": 3.806
  },
  {
    "id": 59,
    "text": "以“也无风雨也无晴”的通脱悟境化解人世沉浮。",
    "start": 269.346,
    "end": 273.364,
    "duration": 4.018
  },
  {
    "id": 60,
    "text": "随后，转向辛弃疾的抗金抱负与悲剧命运，",
    "start": 273.364,
    "end": 276.959,
    "duration": 3.595
  },
  {
    "id": 61,
    "text": "具体表述到答题语句就是：辛弃疾则终生怀抱收复中原的雄图大略，",
    "start": 276.959,
    "end": 282.88,
    "duration": 5.921
  },
  {
    "id": 62,
    "text": "面对偏安朝廷的苟安妥协与自身的闲置弃用，",
    "start": 282.88,
    "end": 286.898,
    "duration": 4.018
  },
  {
    "id": 63,
    "text": "其词作内聚了强烈的用世热忱与英雄悲慨。",
    "start": 286.898,
    "end": 290.704,
    "duration": 3.806
  },
  {
    "id": 64,
    "text": "-最后，调取《破阵子》之梦境与现实残酷对照做闭环支撑，",
    "start": 290.76,
    "end": 295.54,
    "duration": 4.78
  },
  {
    "id": 65,
    "text": "具体表述到答题语句就是：辛弃疾在《破阵子•为陈同甫赋壮词以寄之》中，",
    "start": 295.54,
    "end": 301.84,
    "duration": 6.3
  },
  {
    "id": 66,
    "text": "“梦回吹角连营”的沙场杀敌豪情，",
    "start": 301.84,
    "end": 304.664,
    "duration": 2.824
  },
  {
    "id": 67,
    "text": "与结笔“可怜白发生”的残酷现实构成剧烈落差，",
    "start": 304.664,
    "end": 308.792,
    "duration": 4.128
  },
  {
    "id": 68,
    "text": "全篇回荡着忠愤填膺而报国无门的壮烈悲歌。",
    "start": 308.792,
    "end": 312.92,
    "duration": 4.128
  },
  {
    "id": 69,
    "text": "第一，在主体精神品格与情感气象上，",
    "start": 313.0,
    "end": 316.44,
    "duration": 3.44
  },
  {
    "id": 70,
    "text": "苏轼词充溢着解脱旷达的哲理智慧，",
    "start": 316.44,
    "end": 319.64,
    "duration": 3.2
  },
  {
    "id": 71,
    "text": "辛弃疾词则激荡着英雄失路的悲愤沉雄。",
    "start": 319.64,
    "end": 323.48,
    "duration": 3.84
  },
  {
    "id": 72,
    "text": "苏轼虽一生屡遭贬哲，但深得儒释道三家滋养，",
    "start": 323.48,
    "end": 327.88,
    "duration": 4.4
  },
  {
    "id": 73,
    "text": "具有超越现实政治苦难的博大胸襟。",
    "start": 327.88,
    "end": 331.0,
    "duration": 3.12
  },
  {
    "id": 74,
    "text": "其在《定风波》中面对山头急雨，从容吟啸“莫听穿林打叶声，",
    "start": 331.0,
    "end": 336.12,
    "duration": 5.12
  },
  {
    "id": 75,
    "text": "何妨吟啸且徐行”，以“也无风雨也无晴”的通脱悟境化解人世沉浮。",
    "start": 336.12,
    "end": 341.88,
    "duration": 5.76
  },
  {
    "id": 76,
    "text": "辛弃疾则终生怀抱收复中原的雄图大略，",
    "start": 342.2,
    "end": 345.56,
    "duration": 3.36
  },
  {
    "id": 77,
    "text": "面对偏安朝廷的苟安妥协与自身的闲置弃用，",
    "start": 345.56,
    "end": 349.4,
    "duration": 3.84
  },
  {
    "id": 78,
    "text": "其词作内聚了强烈的用世热忱与英雄悲慨。",
    "start": 349.4,
    "end": 352.92,
    "duration": 3.52
  },
  {
    "id": 79,
    "text": "辛弃疾在《破阵子•为陈同甫赋壮词以寄之》中，",
    "start": 352.92,
    "end": 357.16,
    "duration": 4.24
  },
  {
    "id": 80,
    "text": "“梦回吹角连营”的沙场杀敌豪情，",
    "start": 357.16,
    "end": 359.96,
    "duration": 2.8
  },
  {
    "id": 81,
    "text": "与结笔“可怜白发生”的残酷现实构成剧烈落差，",
    "start": 359.96,
    "end": 364.12,
    "duration": 4.16
  },
  {
    "id": 82,
    "text": "全篇回荡着忠愤填膺而报国无门的壮烈悲歌。",
    "start": 364.12,
    "end": 367.96,
    "duration": 3.84
  },
  {
    "id": 83,
    "text": "三、第二维度：词境开拓与题材指向对比内部咬合。",
    "start": 368.28,
    "end": 372.92,
    "duration": 4.64
  },
  {
    "id": 84,
    "text": "本段任务是从题材广度对比文人生存泛舟与疆场烽岁家国。",
    "start": 372.92,
    "end": 378.28,
    "duration": 5.36
  },
  {
    "id": 85,
    "text": "首先，段首给出结论先行的分论点，",
    "start": 378.28,
    "end": 381.4,
    "duration": 3.12
  },
  {
    "id": 86,
    "text": "具体表述到答题语句就是：第二，在词境开拓与题材指向形态上，",
    "start": 381.4,
    "end": 387.16,
    "duration": 5.76
  },
  {
    "id": 87,
    "text": "苏轼以泛舟江海的文人情怀拓展了词的生活面向，",
    "start": 387.16,
    "end": 391.4,
    "duration": 4.24
  },
  {
    "id": 88,
    "text": "辛弃疾则以抗金前线的金戈铁马赋予了词以沉重厚重的历史战火气息。",
    "start": 391.4,
    "end": 396.92,
    "duration": 5.52
  },
  {
    "id": 89,
    "text": "-随后，剖析苏轼“无意不可入”的题材包容性，",
    "start": 397.16,
    "end": 400.678,
    "duration": 3.518
  },
  {
    "id": 90,
    "text": "具体表述到答题语句就是：苏轼主张“无意不可入，",
    "start": 400.678,
    "end": 404.817,
    "duration": 4.139
  },
  {
    "id": 91,
    "text": "无事不可言”，将仕途感慨、田园风光、",
    "start": 404.817,
    "end": 407.714,
    "duration": 2.897
  },
  {
    "id": 92,
    "text": "兄弟离合乃至农家起居尽数纳于词中。",
    "start": 407.714,
    "end": 411.025,
    "duration": 3.311
  },
  {
    "id": 93,
    "text": "紧接着，举出《水调歌头》与《江城子•密州出猎》双重题材例证，",
