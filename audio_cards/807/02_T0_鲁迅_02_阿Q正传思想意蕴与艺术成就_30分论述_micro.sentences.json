[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "由国民性病灶→辛亥历史局限→普遍存在哲思→喜剧变惊悚美学：",
    "start": 0.0,
    "end": 6.8,
    "duration": 6.8
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先剖阿Q“精神胜利法”心理防御，",
    "start": 6.849,
    "end": 9.369,
    "duration": 2.52
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再放进未庄辛亥投机潮看清革命为何流产，",
    "start": 9.819,
    "end": 13.339,
    "duration": 3.52
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "继而从枪毙画押一刹那升华人类弱者自欺悖论，",
    "start": 13.789,
    "end": 17.949,
    "duration": 4.16
  },
  {
    "id": "hook_c4",
    "dom_key": "hook_c4",
    "text": "最后收束为“正传戏仿+狼眼睛惊悚”讽刺典范。",
    "start": 18.399,
    "end": 22.199,
    "duration": 3.8
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《阿Q正传》是现代现实主义奠基经典，",
    "start": 22.649,
    "end": 25.569,
    "duration": 2.92
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "鲁迅秉持“画出这样沉默的国民的魂灵来”之志，",
    "start": 26.019,
    "end": 29.259,
    "duration": 3.24
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "将国民性批判、革命反思与生存哲思融于现代讽刺典范。",
    "start": 29.829,
    "end": 34.389,
    "duration": 4.56
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 深度解剖“精神胜利法”病灶",
    "start": 34.839,
    "end": 37.679,
    "duration": 2.84
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "阿Q处未庄赤贫雇农底层，面对压迫演化出病态心理防御：",
    "start": 38.129,
    "end": 43.249,
    "duration": 5.12
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "挨打靠“儿子打老子”幻觉取胜，受辱“自轻自贱”自封第一，",
    "start": 43.699,
    "end": 48.299,
    "duration": 4.6
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "更向弱小小尼姑转嫁暴虐；",
    "start": 48.749,
    "end": 50.949,
    "duration": 2.2
  },
  {
    "id": "sec0_step2_c0",
    "dom_key": "sec0_step2_c0",
    "text": "将屈辱化为虚妄自满，在麻痹中丧失反抗意识、甘当驯服工具，",
    "start": 51.399,
    "end": 56.479,
    "duration": 5.08
  },
  {
    "id": "sec0_step2_c1",
    "dom_key": "sec0_step2_c1",
    "text": "揭开民族自欺病灶。",
    "start": 56.929,
    "end": 58.609,
    "duration": 1.68
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 反思辛亥革命“不准革命”历史教训",
    "start": 59.059,
    "end": 62.819,
    "duration": 3.76
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "赵秀才、假洋鬼子借“盘辫子”与“自由党”趁势投机；",
    "start": 63.269,
    "end": 67.349,
    "duration": 4.08
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "阿Q将革命视为原始复仇占财，",
    "start": 67.799,
    "end": 70.519,
    "duration": 2.72
  },
  {
    "id": "sec1_step0_c2",
    "dom_key": "sec1_step0_c2",
    "text": "反遭假洋鬼子哭丧棒斥“不准革命”并沦为死囚替罪羊；",
    "start": 70.969,
    "end": 75.689,
    "duration": 4.72
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "指出缺乏深入启蒙与群众觉醒的外在政权更迭，注定无法撼动千年封建根基。",
    "start": 76.139,
    "end": 82.419,
    "duration": 6.28
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 升华弱者在绝境自欺求生的存在悖论",
    "start": 82.869,
    "end": 87.029,
    "duration": 4.16
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "肉体反抗通道堵死、尊严剥夺殆尽时，弱者靠幻想代偿虽缓剧痛，",
    "start": 87.479,
    "end": 93.039,
    "duration": 5.56
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "却推向更深荒诞；",
    "start": 93.489,
    "end": 95.009,
    "duration": 1.52
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "行刑画押生死关头，阿Q唯恐“圆圈画得不圆”的畸形焦虑，",
    "start": 95.459,
    "end": 100.099,
    "duration": 4.64
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "展现人在死亡与荒谬面前盲目困境，具跨越时代存在哲思。",
    "start": 100.549,
    "end": 105.709,
    "duration": 5.16
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 史传文体戏仿与“以喜写悲”美学",
    "start": 106.239,
    "end": 109.999,
    "duration": 3.76
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "《序》以一本正经学术考据写姓氏终归“无可考”，",
    "start": 110.449,
    "end": 114.249,
    "duration": 3.8
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "颠覆封建正史“只为帝王将相立传”伦理秩序；",
    "start": 114.779,
    "end": 118.459,
    "duration": 3.68
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "前半滑稽反讽引人发笑，",
    "start": 118.909,
    "end": 121.029,
    "duration": 2.12
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "末章囚车游街直面街道如饥兽般的“狼眼睛”注视骤抵灵魂惊悚，",
    "start": 121.559,
    "end": 126.719,
    "duration": 5.16
  },
  {
    "id": "sec3_step1_c2",
    "dom_key": "sec3_step1_c2",
    "text": "成就精湛讽刺艺术。",
    "start": 127.169,
    "end": 128.929,
    "duration": 1.76
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《阿Q正传》融反封建锋芒、历史自省与存在哲思于一体，",
    "start": 129.379,
    "end": 133.939,
    "duration": 4.56
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "以入木三分剖析使阿Q超越未庄时空，成世界文学经典典型。",
    "start": 134.389,
    "end": 139.949,
    "duration": 5.56
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：与《狂人日记》区分：",
    "start": 140.399,
    "end": 142.479,
    "duration": 2.08
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "《狂人日记》写礼教“吃人”与日记体心理象征；",
    "start": 142.929,
    "end": 145.969,
    "duration": 3.04
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "《阿Q正传》写“精神胜利法”、辛亥革命脱离民众与“大团圆”史传戏仿。",
    "start": 146.419,
    "end": 151.659,
    "duration": 5.24
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 概括阿Q“精神胜利法”的三种典型心理操作？",
    "start": 152.109,
    "end": 157.029,
    "duration": 4.92
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合未庄辛亥闹剧说明为什么作者得出“缺乏群众觉醒的政权更迭注定流产”？",
    "start": 157.479,
    "end": 165.159,
    "duration": 7.68
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 分析2026真题视角：",
    "start": 165.609,
    "end": 168.289,
    "duration": 2.68
  },
  {
    "id": "drill2_c1",
    "dom_key": "drill2_c1",
    "text": "如何借“以意逆志”（救世初衷）与“意图谬误”（文本自身存在悲剧）阐释本篇？",
    "start": 168.779,
    "end": 175.019,
    "duration": 6.24
  }
]