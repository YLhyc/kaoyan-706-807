[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "鲁迅·阿Q正传思想意蕴与艺术成就",
    "start": 0.314,
    "end": 4.126,
    "duration": 3.812
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "由国民性病灶→辛亥历史局限→普遍存在哲思→喜剧变惊悚美学：",
    "start": 5.134,
    "end": 12.906,
    "duration": 7.772
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先剖阿Q“精神胜利法”心理防御，再放进未庄辛亥投机潮看清革命为何流产，",
    "start": 13.174,
    "end": 19.626,
    "duration": 6.452
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "继而从枪毙画押一刹那升华人类弱者自欺悖论，最后收束为“正传戏仿+狼眼睛惊悚”讽刺典范。",
    "start": 20.014,
    "end": 28.506,
    "duration": 8.492
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "《阿Q正传》是现代现实主义奠基经典，鲁迅秉持“画出这样沉默的国民的魂灵来”之志，",
    "start": 29.554,
    "end": 36.686,
    "duration": 7.132
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "将国民性批判、革命反思与生存哲思融于现代讽刺典范。",
    "start": 37.114,
    "end": 42.326,
    "duration": 5.212
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 深度解剖“精神胜利法”病灶",
    "start": 43.334,
    "end": 46.026,
    "duration": 2.692
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "阿Q处未庄赤贫雇农底层，面对压迫演化出病态心理防御：",
    "start": 47.034,
    "end": 53.086,
    "duration": 6.052
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "挨打靠“儿子打老子”幻觉取胜，受辱“自轻自贱”自封第一，更向弱小小尼姑转嫁暴虐；",
    "start": 54.134,
    "end": 62.826,
    "duration": 8.692
  },
  {
    "id": "sec0_step2_c0",
    "dom_key": "sec0_step2_c0",
    "text": "将屈辱化为虚妄自满，在麻痹中丧失反抗意识、甘当驯服工具，揭开民族自欺病灶。",
    "start": 63.834,
    "end": 71.926,
    "duration": 8.092
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 反思辛亥革命“不准革命”历史教训",
    "start": 72.934,
    "end": 76.346,
    "duration": 3.412
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "赵秀才、假洋鬼子借“盘辫子”与“自由党”趁势投机；",
    "start": 77.274,
    "end": 82.806,
    "duration": 5.532
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "阿Q将革命视为原始复仇占财，反遭假洋鬼子哭丧棒斥“不准革命”并沦为死囚替罪羊；",
    "start": 83.854,
    "end": 91.706,
    "duration": 7.852
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "指出缺乏深入启蒙与群众觉醒的外在政权更迭，注定无法撼动千年封建根基。",
    "start": 92.714,
    "end": 100.406,
    "duration": 7.692
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 升华弱者在绝境自欺求生的存在悖论",
    "start": 101.098,
    "end": 105.11,
    "duration": 4.012
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "肉体反抗通道堵死、尊严剥夺殆尽时，弱者靠幻想代偿虽缓剧痛，却推向更深荒诞；",
    "start": 106.078,
    "end": 114.41,
    "duration": 8.332
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "行刑画押生死关头，阿Q唯恐“圆圈画得不圆”的畸形焦虑，展现人在死亡与荒谬面前盲目困境，具跨越时代存在哲思。",
    "start": 115.538,
    "end": 126.55,
    "duration": 11.012
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 史传文体戏仿与“以喜写悲”美学",
    "start": 127.438,
    "end": 131.73,
    "duration": 4.292
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "《序》以一本正经学术考据写姓氏终归“无可考”，颠覆封建正史“只为帝王将相立传”伦理秩序；",
    "start": 132.778,
    "end": 142.63,
    "duration": 9.852
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "前半滑稽反讽引人发笑，末章囚车游街直面街道如饥兽般的“狼眼睛”注视骤抵灵魂惊悚，成就精湛讽刺艺术。",
    "start": 143.598,
    "end": 155.13,
    "duration": 11.532
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《阿Q正传》融反封建锋芒、历史自省与存在哲思于一体，以入木三分剖析使阿Q超越未庄时空，成世界文学经典典型。",
    "start": 156.138,
    "end": 167.31,
    "duration": 11.172
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：与《狂人日记》区分：《狂人日记》写礼教“吃人”与日记体心理象征；",
    "start": 168.318,
    "end": 175.09,
    "duration": 6.772
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "《阿Q正传》写“精神胜利法”、辛亥革命脱离民众与“大团圆”史传戏仿。",
    "start": 176.098,
    "end": 181.75,
    "duration": 5.652
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 概括阿Q“精神胜利法”的三种典型心理操作？",
    "start": 182.718,
    "end": 187.21,
    "duration": 4.492
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合未庄辛亥闹剧说明为什么作者得出“缺乏群众觉醒的政权更迭注定流产”？",
    "start": 188.138,
    "end": 196.91,
    "duration": 8.772
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 分析2026真题视角：如何借“以意逆志”（救世初衷）与“意图谬误”（文本自身存在悲剧）阐释本篇？",
    "start": 197.618,
    "end": 207.67,
    "duration": 10.052
  }
]