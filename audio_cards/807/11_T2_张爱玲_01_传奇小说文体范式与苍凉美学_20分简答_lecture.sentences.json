[
  {
    "id": 1,
    "text": "四十年代沦陷区时期的上海文坛，",
    "start": 0.05,
    "end": 2.867,
    "duration": 2.817
  },
  {
    "id": 2,
    "text": "张爱玲以《传奇》小说集的横空出世，",
    "start": 2.867,
    "end": 5.61,
    "duration": 2.743
  },
  {
    "id": 3,
    "text": "在宏大革命叙事与抗战救亡主流之外，",
    "start": 5.61,
    "end": 8.916,
    "duration": 3.306
  },
  {
    "id": 4,
    "text": "敏锐开辟了独特的都市现代“传奇”视界。",
    "start": 8.916,
    "end": 12.07,
    "duration": 3.154
  },
  {
    "id": 5,
    "text": "其小说艺术特质与苍凉美学主要体现于以下三个方面：",
    "start": 12.07,
    "end": 16.647,
    "duration": 4.577
  },
  {
    "id": 6,
    "text": "第一，聚焦乱世日常世俗凡庸，揭示人性深层的荒凉与苍凉底色。",
    "start": 16.647,
    "end": 22.194,
    "duration": 5.547
  },
  {
    "id": 7,
    "text": "张爱玲彻底摒弃了非黑即白的激进意识形态，",
    "start": 22.194,
    "end": 25.679,
    "duration": 3.485
  },
  {
    "id": 8,
    "text": "转而凝视现代都市男女在物质欲望与生存逼仄中的心理博弈。",
    "start": 25.679,
    "end": 30.853,
    "duration": 5.174
  },
  {
    "id": 9,
    "text": "在《倾城之恋》中，白流苏与范柳原在浅水湾饭店里虚与委蛇、",
    "start": 30.853,
    "end": 37.155,
    "duration": 6.302
  },
  {
    "id": 10,
    "text": "斤斤计较，各怀自私盘算；直至一场轰炸摧毁了整座香港城，",
    "start": 37.155,
    "end": 41.519,
    "duration": 4.364
  },
  {
    "id": 11,
    "text": "在断壁残垣与生死悬于一线的荒诞边缘，两人才卸下防备，",
    "start": 41.519,
    "end": 46.439,
    "duration": 4.92
  },
  {
    "id": 12,
    "text": "相互依偎着获得了一抹苍凉而现实的平凡婚姻，",
    "start": 46.439,
    "end": 50.494,
    "duration": 4.055
  },
  {
    "id": 13,
    "text": "深刻凸显了乱世小人物在时代倾覆中的脆弱宿命。",
    "start": 50.494,
    "end": 54.589,
    "duration": 4.095
  },
  {
    "id": 14,
    "text": "第二，深潜潜意识精神黑洞，",
    "start": 54.589,
    "end": 57.049,
    "duration": 2.46
  },
  {
    "id": 15,
    "text": "解剖欲望压抑下的病态心理与畸变异化。",
    "start": 57.049,
    "end": 60.265,
    "duration": 3.216
  },
  {
    "id": 16,
    "text": "作家擅长将传统世情白描与西方现代心理分析熔铸一体。",
    "start": 60.265,
    "end": 64.644,
    "duration": 4.379
  },
  {
    "id": 17,
    "text": "在《金锁记》中，",
    "start": 64.644,
    "end": 65.813,
    "duration": 1.169
  },
  {
    "id": 18,
    "text": "曹七巧在封建大家族的门第歧视与病残丈夫的折磨下，",
    "start": 65.813,
    "end": 70.073,
    "duration": 4.26
  },
  {
    "id": 19,
    "text": "将全部情感寄托于金钱；随着黄金枷锁的日益沉重，",
    "start": 70.073,
    "end": 73.963,
    "duration": 3.89
  },
  {
    "id": 20,
    "text": "其心理走向彻底癫狂畸变，不仅逼杀儿媳芝寿，",
    "start": 73.963,
    "end": 77.55,
    "duration": 3.587
  },
  {
    "id": 21,
    "text": "更冷酷拆散女儿长安的婚事，",
    "start": 77.55,
    "end": 80.015,
    "duration": 2.465
  },
  {
    "id": 22,
    "text": "在幽暗的卧房里以酸梅汤滴在桌上如血泪般的细节，",
    "start": 80.015,
    "end": 84.332,
    "duration": 4.317
  },
  {
    "id": 23,
    "text": "淋漓尽致地展现了被封建礼教与黄金欲望联手吞噬的人性悲剧。",
    "start": 84.332,
    "end": 89.776,
    "duration": 5.444
  },
  {
    "id": 24,
    "text": "第三，融汇古典白描与现代意象主义，",
    "start": 89.776,
    "end": 92.779,
    "duration": 3.003
  },
  {
    "id": 25,
    "text": "营构色彩斑斓而鬼气森森的意象世界。",
    "start": 92.779,
    "end": 97.781,
    "duration": 5.002
  },
  {
    "id": 26,
    "text": "张爱玲的小说语言华美冷艳，善于运用陌生化的通感、",
    "start": 97.781,
    "end": 101.781,
    "duration": 4.0
  },
  {
    "id": 27,
    "text": "奇诡的比喻与对比强烈的色彩。",
    "start": 101.781,
    "end": 104.459,
    "duration": 2.678
  },
  {
    "id": 28,
    "text": "她将旧时代的月亮比作“朵云轩信笺上落了一滴泪”或“三十年前沉在井底的一面铜镜”，",
    "start": 104.459,
    "end": 110.822,
    "duration": 6.363
  },
  {
    "id": 29,
    "text": "在葱绿配桃红的斑斓感官刺激背后，弥漫着大厦将倾、",
    "start": 110.822,
    "end": 114.822,
    "duration": 4.0
  },
  {
    "id": 30,
    "text": "繁华散尽的末世虚无感，",
    "start": 114.822,
    "end": 116.785,
    "duration": 1.963
  },
  {
    "id": 31,
    "text": "构成了中国现代文学史上独树一帜的苍凉美学范式。",
    "start": 116.785,
    "end": 120.936,
    "duration": 4.151
  }
]