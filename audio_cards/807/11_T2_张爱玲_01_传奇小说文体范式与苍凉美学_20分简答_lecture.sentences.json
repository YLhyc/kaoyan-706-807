[
  {
    "id": 1,
    "text": "四十年代沦陷区时期的上海文坛，",
    "start": 0.16,
    "end": 2.96,
    "duration": 2.8
  },
  {
    "id": 2,
    "text": "张爱玲以《传奇》小说集的横空出世，",
    "start": 2.96,
    "end": 6.32,
    "duration": 3.36
  },
  {
    "id": 3,
    "text": "在宏大革命叙事与抗战救亡主流之外，",
    "start": 6.32,
    "end": 9.68,
    "duration": 3.36
  },
  {
    "id": 4,
    "text": "敏锐开辟了独特的都市现代“传奇”视界。",
    "start": 9.68,
    "end": 13.6,
    "duration": 3.92
  },
  {
    "id": 5,
    "text": "其小说艺术特质与苍凉美学主要体现于以下三个方面：",
    "start": 13.6,
    "end": 18.56,
    "duration": 4.96
  },
  {
    "id": 6,
    "text": "第一，聚焦乱世日常世俗凡庸，揭示人性深层的荒凉与苍凉底色。",
    "start": 18.56,
    "end": 24.24,
    "duration": 5.68
  },
  {
    "id": 7,
    "text": "张爱玲彻底摒弃了非黑即白的激进意识形态，",
    "start": 24.24,
    "end": 28.16,
    "duration": 3.92
  },
  {
    "id": 8,
    "text": "转而凝视现代都市男女在物质欲望与生存逼仄中的心理博弈。",
    "start": 28.16,
    "end": 33.84,
    "duration": 5.68
  },
  {
    "id": 9,
    "text": "在《倾城之恋》中，白流苏与范柳原在浅水湾饭店里虚与委蛇、",
    "start": 33.84,
    "end": 39.92,
    "duration": 6.08
  },
  {
    "id": 10,
    "text": "斤斤计较，各怀自私盘算；直至一场轰炸摧毁了整座香港城，",
    "start": 39.92,
    "end": 45.6,
    "duration": 5.68
  },
  {
    "id": 11,
    "text": "在断壁残垣与生死悬于一线的荒诞边缘，两人才卸下防备，",
    "start": 45.6,
    "end": 51.04,
    "duration": 5.44
  },
  {
    "id": 12,
    "text": "相互依偎着获得了一抹苍凉而现实的平凡婚姻，",
    "start": 51.04,
    "end": 55.44,
    "duration": 4.4
  },
  {
    "id": 13,
    "text": "深刻凸显了乱世小人物在时代倾覆中的脆弱宿命。",
    "start": 55.44,
    "end": 59.44,
    "duration": 4.0
  },
  {
    "id": 14,
    "text": "第二，深潜潜意识精神黑洞，",
    "start": 59.44,
    "end": 61.84,
    "duration": 2.4
  },
  {
    "id": 15,
    "text": "解剖欲望压抑下的病态心理与畸变异化。",
    "start": 61.84,
    "end": 65.36,
    "duration": 3.52
  },
  {
    "id": 16,
    "text": "作家擅长将传统世情白描与西方现代心理分析熔铸一体。",
    "start": 65.36,
    "end": 70.24,
    "duration": 4.88
  },
  {
    "id": 17,
    "text": "在《金锁记》中，",
    "start": 70.24,
    "end": 71.6,
    "duration": 1.36
  },
  {
    "id": 18,
    "text": "曹七巧在封建大家族的门第歧视与病残丈夫的折磨下，",
    "start": 71.6,
    "end": 76.16,
    "duration": 4.56
  },
  {
    "id": 19,
    "text": "将全部情感寄托于金钱；随着黄金枷锁的日益沉重，",
    "start": 76.16,
    "end": 80.24,
    "duration": 4.08
  },
  {
    "id": 20,
    "text": "其心理走向彻底癫狂畸变，不仅逼杀儿媳芝寿，",
    "start": 80.24,
    "end": 83.84,
    "duration": 3.6
  },
  {
    "id": 21,
    "text": "更冷酷拆散女儿长安的婚事，",
    "start": 83.84,
    "end": 86.16,
    "duration": 2.32
  },
  {
    "id": 22,
    "text": "在幽暗的卧房里以酸梅汤滴在桌上如血泪般的细节，",
    "start": 86.16,
    "end": 91.12,
    "duration": 4.96
  },
  {
    "id": 23,
    "text": "淋漓尽致地展现了被封建礼教与黄金欲望联手吞噬的人性悲剧。",
    "start": 91.12,
    "end": 96.88,
    "duration": 5.76
  },
  {
    "id": 24,
    "text": "第三，融汇古典白描与现代意象主义，",
    "start": 96.88,
    "end": 100.16,
    "duration": 3.28
  },
  {
    "id": 25,
    "text": "营构色彩斑斓而鬼气森森的意象世界。",
    "start": 100.16,
    "end": 103.28,
    "duration": 3.12
  },
  {
    "id": 26,
    "text": "张爱玲的小说语言华美冷艳，善于运用陌生化的通感、",
    "start": 103.28,
    "end": 108.48,
    "duration": 5.2
  },
  {
    "id": 27,
    "text": "奇诡的比喻与对比强烈的色彩。",
    "start": 108.48,
    "end": 111.52,
    "duration": 3.04
  },
  {
    "id": 28,
    "text": "她将旧时代的月亮比作“朵云轩信笺上落了一滴泪”或“三十年前沉在井底的一面铜镜”，",
    "start": 111.52,
    "end": 119.76,
    "duration": 8.24
  },
  {
    "id": 29,
    "text": "在葱绿配桃红的斑斓感官刺激背后，弥漫着大厦将倾、",
    "start": 119.76,
    "end": 120.72,
    "duration": 0.96
  },
  {
    "id": 30,
    "text": "繁华散尽的末世虚无感，",
    "start": 120.48,
    "end": 120.72,
    "duration": 0.24
  },
  {
    "id": 31,
    "text": "构成了中国现代文学史上独树一帜的苍凉美学范式。",
    "start": 120.48,
    "end": 120.72,
    "duration": 0.24
  }
]