[
  {
    "id": 1,
    "text": "四十年代沦陷区时期的上海文坛，张爱玲以《传奇》小说集的横空出世，",
    "start": 0.104,
    "end": 5.367,
    "duration": 5.263
  },
  {
    "id": 2,
    "text": "在宏大革命叙事与抗战救亡主流之外，敏锐开辟了独特的都市现代“传奇”视界。",
    "start": 5.913,
    "end": 12.225,
    "duration": 6.312
  },
  {
    "id": 3,
    "text": "其小说艺术特质与苍凉美学主要体现于以下三个方面：",
    "start": 12.751,
    "end": 17.043,
    "duration": 4.292
  },
  {
    "id": 4,
    "text": "第一，聚焦乱世日常世俗凡庸，揭示人性深层的荒凉与苍凉底色。",
    "start": 17.687,
    "end": 23.432,
    "duration": 5.745
  },
  {
    "id": 5,
    "text": "张爱玲刻意避开非黑即白的激进意识形态，",
    "start": 23.981,
    "end": 27.083,
    "duration": 3.102
  },
  {
    "id": 6,
    "text": "转而凝视现代都市男女在物质欲望与生存逼仄中的心理博弈。",
    "start": 27.223,
    "end": 32.479,
    "duration": 5.256
  },
  {
    "id": 7,
    "text": "在《倾城之恋》中，白流苏与范柳原在浅水湾饭店里虚与委蛇、斤斤计较，各怀自私盘算；",
    "start": 32.974,
    "end": 40.683,
    "duration": 7.709
  },
  {
    "id": 8,
    "text": "直至一场战火漫卷香港全岛，在断壁残垣与生死悬于一线的荒诞边缘，",
    "start": 41.02,
    "end": 47.253,
    "duration": 6.233
  },
  {
    "id": 9,
    "text": "两人才卸下防备，相互依偎着获得了一抹苍凉而现实的平凡婚姻，",
    "start": 47.622,
    "end": 53.317,
    "duration": 5.695
  },
  {
    "id": 10,
    "text": "深刻凸显了乱世小人物在时代倾覆中的脆弱宿命。",
    "start": 53.631,
    "end": 57.876,
    "duration": 4.245
  },
  {
    "id": 11,
    "text": "第二，深潜潜意识精神暗角，解剖欲望压抑下的病态心理与畸变扭曲。",
    "start": 58.505,
    "end": 63.657,
    "duration": 5.152
  },
  {
    "id": 12,
    "text": "作家擅长将传统世情白描与西方现代心理分析融为一体。",
    "start": 63.786,
    "end": 68.25,
    "duration": 4.464
  },
  {
    "id": 13,
    "text": "在《金锁记》中，曹七巧在封建大家族的门第歧视与病残丈夫的折磨下，将全部情感寄托于金钱；",
    "start": 68.337,
    "end": 75.231,
    "duration": 6.894
  },
  {
    "id": 14,
    "text": "随着黄金枷锁日益沉重，其心理走向癫狂畸变，不仅折磨儿媳芝寿致其病亡，更冷酷拆散女儿长安的婚事，",
    "start": 75.546,
    "end": 83.774,
    "duration": 8.228
  },
  {
    "id": 15,
    "text": "小说更以她识破季泽骗局时打翻的酸梅汤沿着桌子一滴一滴淌落如迟迟夜漏的细节，",
    "start": 84.036,
    "end": 90.826,
    "duration": 6.79
  },
  {
    "id": 16,
    "text": "深刻展现出被封建礼教与黄金欲望联手吞噬的人性悲剧。",
    "start": 91.099,
    "end": 95.638,
    "duration": 4.539
  },
  {
    "id": 17,
    "text": "第三，融汇古典白描与现代意象主义，营构色彩斑斓而鬼气森森的意象世界。",
    "start": 96.317,
    "end": 103.267,
    "duration": 6.95
  },
  {
    "id": 18,
    "text": "张爱玲的小说语言华美冷艳，善于运用陌生化的通感、奇诡的比喻与对比强烈的色彩。",
    "start": 103.932,
    "end": 111.201,
    "duration": 7.269
  },
  {
    "id": 19,
    "text": "她将三十年前的月亮比作“铜钱大的一个红黄的湿晕，像朵云轩信笺上落了一滴泪珠”，",
    "start": 111.669,
    "end": 118.963,
    "duration": 7.294
  },
  {
    "id": 20,
    "text": "在葱绿配桃红的斑斓感官刺激背后，弥漫着大厦将倾、繁华散尽的末世虚无感，",
    "start": 119.196,
    "end": 126.01,
    "duration": 6.814
  },
  {
    "id": 21,
    "text": "构成了中国现代文学史上独树一帜的苍凉美学范式。",
    "start": 126.258,
    "end": 130.296,
    "duration": 4.038
  }
]