[
  {
    "id": 1,
    "text": "四十年代沦陷区时期的上海文坛，",
    "start": 0.089,
    "end": 2.55,
    "duration": 2.461
  },
  {
    "id": 2,
    "text": "张爱玲以《传奇》小说集的横空出世，",
    "start": 2.853,
    "end": 5.289,
    "duration": 2.436
  },
  {
    "id": 3,
    "text": "在宏大革命叙事与抗战救亡主流之外，",
    "start": 5.599,
    "end": 8.63,
    "duration": 3.031
  },
  {
    "id": 4,
    "text": "敏锐开辟了独特的都市现代“传奇”视界。",
    "start": 8.906,
    "end": 11.76,
    "duration": 2.854
  },
  {
    "id": 5,
    "text": "其小说艺术特质与苍凉美学主要体现于以下三个方面：",
    "start": 12.055,
    "end": 16.323,
    "duration": 4.268
  },
  {
    "id": 6,
    "text": "第一，聚焦乱世日常世俗凡庸，揭示人性深层的荒凉与苍凉底色。",
    "start": 16.637,
    "end": 21.966,
    "duration": 5.329
  },
  {
    "id": 7,
    "text": "张爱玲彻底摒弃了非黑即白的激进意识形态，",
    "start": 22.184,
    "end": 25.417,
    "duration": 3.233
  },
  {
    "id": 8,
    "text": "转而凝视现代都市男女在物质欲望与生存逼仄中的心理博弈。",
    "start": 25.495,
    "end": 30.698,
    "duration": 5.203
  },
  {
    "id": 9,
    "text": "在《倾城之恋》中，白流苏与范柳原在浅水湾饭店里虚与委蛇、",
    "start": 30.838,
    "end": 36.062,
    "duration": 5.224
  },
  {
    "id": 10,
    "text": "斤斤计较，各怀自私盘算；直至一场轰炸摧毁了整座香港城，",
    "start": 36.105,
    "end": 40.971,
    "duration": 4.866
  },
  {
    "id": 11,
    "text": "在断壁残垣与生死悬于一线的荒诞边缘，两人才卸下防备，",
    "start": 41.289,
    "end": 46.162,
    "duration": 4.873
  },
  {
    "id": 12,
    "text": "相互依偎着获得了一抹苍凉而现实的平凡婚姻，",
    "start": 46.421,
    "end": 50.172,
    "duration": 3.751
  },
  {
    "id": 13,
    "text": "深刻凸显了乱世小人物在时代倾覆中的脆弱宿命。",
    "start": 50.476,
    "end": 54.349,
    "duration": 3.873
  },
  {
    "id": 14,
    "text": "第二，深潜潜意识精神黑洞，",
    "start": 54.579,
    "end": 56.965,
    "duration": 2.386
  },
  {
    "id": 15,
    "text": "解剖欲望压抑下的病态心理与畸变异化。",
    "start": 57.037,
    "end": 60.059,
    "duration": 3.022
  },
  {
    "id": 16,
    "text": "作家擅长将传统世情白描与西方现代心理分析熔铸一体。",
    "start": 60.255,
    "end": 64.474,
    "duration": 4.219
  },
  {
    "id": 17,
    "text": "在《金锁记》中，",
    "start": 64.628,
    "end": 65.575,
    "duration": 0.947
  },
  {
    "id": 18,
    "text": "曹七巧在封建大家族的门第歧视与病残丈夫的折磨下，",
    "start": 65.803,
    "end": 69.853,
    "duration": 4.05
  },
  {
    "id": 19,
    "text": "将全部情感寄托于金钱；随着黄金枷锁的日益沉重，",
    "start": 70.063,
    "end": 73.814,
    "duration": 3.751
  },
  {
    "id": 20,
    "text": "其心理走向彻底癫狂畸变，不仅逼杀儿媳芝寿，",
    "start": 73.945,
    "end": 77.451,
    "duration": 3.506
  },
  {
    "id": 21,
    "text": "更冷酷拆散女儿长安的婚事，",
    "start": 77.535,
    "end": 79.495,
    "duration": 1.96
  },
  {
    "id": 22,
    "text": "在幽暗的卧房里以酸梅汤滴在桌上如血泪般的细节，",
    "start": 79.65,
    "end": 83.266,
    "duration": 3.616
  },
  {
    "id": 23,
    "text": "淋漓尽致地展现了被封建礼教与黄金欲望联手吞噬的人性悲剧。",
    "start": 83.386,
    "end": 88.216,
    "duration": 4.83
  },
  {
    "id": 24,
    "text": "第三，融汇古典白描与现代意象主义，",
    "start": 88.421,
    "end": 91.668,
    "duration": 3.247
  },
  {
    "id": 25,
    "text": "营构色彩斑斓而鬼气森森的意象世界。",
    "start": 91.91,
    "end": 94.769,
    "duration": 2.859
  },
  {
    "id": 26,
    "text": "张爱玲的小说语言华美冷艳，善于运用陌生化的通感、",
    "start": 95.304,
    "end": 99.723,
    "duration": 4.419
  },
  {
    "id": 27,
    "text": "奇诡的比喻与对比强烈的色彩。",
    "start": 99.755,
    "end": 102.183,
    "duration": 2.428
  },
  {
    "id": 28,
    "text": "她将旧时代的月亮比作“朵云轩信笺上落了一滴泪”或“三十年前沉在井底的一面铜镜”，",
    "start": 102.315,
    "end": 109.497,
    "duration": 7.182
  },
  {
    "id": 29,
    "text": "在葱绿配桃红的斑斓感官刺激背后，弥漫着大厦将倾、",
    "start": 109.733,
    "end": 114.31,
    "duration": 4.577
  },
  {
    "id": 30,
    "text": "繁华散尽的末世虚无感，",
    "start": 114.448,
    "end": 116.406,
    "duration": 1.958
  },
  {
    "id": 31,
    "text": "构成了中国现代文学史上独树一帜的苍凉美学范式。",
    "start": 116.553,
    "end": 120.936,
    "duration": 4.383
  }
]
