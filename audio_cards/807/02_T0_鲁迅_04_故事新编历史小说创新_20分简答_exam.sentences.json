[
  {
    "id": 1,
    "text": "题目：",
    "start": 0.113,
    "end": 0.513,
    "duration": 0.4
  },
  {
    "id": 2,
    "text": "简述鲁迅《故事新编》在历史小说创作上的文体创新与思想特色。",
    "start": 0.886,
    "end": 5.921,
    "duration": 5.035
  },
  {
    "id": 3,
    "text": "鲁迅晚期小说集《故事新编》是中国现代历史小说文体试验的划时代杰作。",
    "start": 6.596,
    "end": 12.25,
    "duration": 5.654
  },
  {
    "id": 4,
    "text": "鲁迅摒弃了传统历史小说“据事直书”的考据泥潭，",
    "start": 12.891,
    "end": 16.749,
    "duration": 3.858
  },
  {
    "id": 5,
    "text": "也超越了单纯借古讽今的政论模式，融合神话传奇、",
    "start": 17.21,
    "end": 21.172,
    "duration": 3.962
  },
  {
    "id": 6,
    "text": "现代心理与杂文笔法，开创了现代“新历史小说”的先河。",
    "start": 21.391,
    "end": 26.154,
    "duration": 4.763
  },
  {
    "id": 7,
    "text": "其创新主要体现在以下三个方面：",
    "start": 26.695,
    "end": 29.026,
    "duration": 2.331
  },
  {
    "id": 8,
    "text": "第一，独创“古今杂糅”与戏谑“油滑”笔法，",
    "start": 29.689,
    "end": 33.041,
    "duration": 3.352
  },
  {
    "id": 9,
    "text": "打破历史的神圣光环。",
    "start": 33.386,
    "end": 34.959,
    "duration": 1.573
  },
  {
    "id": 10,
    "text": "鲁迅依托古代神话与史料骨架，大胆打破时空界限，",
    "start": 35.404,
    "end": 39.582,
    "duration": 4.178
  },
  {
    "id": 11,
    "text": "将现代口语、摩登生活细节与文人论战现实自然植入远古场景。",
    "start": 39.946,
    "end": 45.1,
    "duration": 5.154
  },
  {
    "id": 12,
    "text": "在《理水》中，文化山学者坐洋车、穿西装、大谈英国经验，",
    "start": 45.654,
    "end": 50.124,
    "duration": 4.47
  },
  {
    "id": 13,
    "text": "与皮肤粗黑、吃粗粮的治水大禹形成滑稽对照；",
    "start": 50.406,
    "end": 54.633,
    "duration": 4.227
  },
  {
    "id": 14,
    "text": "这种借鉴戏剧丑角式的“油滑”调侃，",
    "start": 54.899,
    "end": 57.572,
    "duration": 2.673
  },
  {
    "id": 15,
    "text": "打破了传统英雄的虚妄光环，",
    "start": 57.784,
    "end": 59.776,
    "duration": 1.992
  },
  {
    "id": 16,
    "text": "使远古历史成为映照现代知识分子病态人格的反讽镜。",
    "start": 59.98,
    "end": 64.384,
    "duration": 4.404
  },
  {
    "id": 17,
    "text": "第二，构筑庄严与荒诞的二元并置，",
    "start": 65.027,
    "end": 67.901,
    "duration": 2.874
  },
  {
    "id": 18,
    "text": "追问崇高理想被世俗消磨的生存悲剧。",
    "start": 68.433,
    "end": 71.612,
    "duration": 3.179
  },
  {
    "id": 19,
    "text": "鲁迅刻意将叙事视点由英雄创业的高光转向功成之后的凡俗日常。",
    "start": 72.235,
    "end": 77.601,
    "duration": 5.366
  },
  {
    "id": 20,
    "text": "《奔月》打破神射手神话，",
    "start": 78.212,
    "end": 79.73,
    "duration": 1.518
  },
  {
    "id": 21,
    "text": "展现后羿射尽野兽后每日吃乌鸦炸酱面、",
    "start": 80.231,
    "end": 83.215,
    "duration": 2.984
  },
  {
    "id": 22,
    "text": "被琐碎生活消磨的英雄末路；",
    "start": 83.754,
    "end": 85.935,
    "duration": 2.181
  },
  {
    "id": 23,
    "text": "《铸剑》中黑衣人与眉间尺玉石俱焚的惨烈复仇，",
    "start": 86.236,
    "end": 90.181,
    "duration": 3.945
  },
  {
    "id": 24,
    "text": "在王公大臣与看客围观金鼎沸水的哄笑中沦为娱乐景观，",
    "start": 90.416,
    "end": 95.404,
    "duration": 4.988
  },
  {
    "id": 25,
    "text": "深刻揭示了先驱者的崇高牺牲在麻木历史中被消费、",
    "start": 95.852,
    "end": 100.135,
    "duration": 4.283
  },
  {
    "id": 26,
    "text": "扭曲的荒诞悲凉。",
    "start": 100.797,
    "end": 102.18,
    "duration": 1.383
  },
  {
    "id": 27,
    "text": "第三，打通小说、神话与杂文的文体界限，",
    "start": 102.83,
    "end": 106.158,
    "duration": 3.328
  },
  {
    "id": 28,
    "text": "开创从容幽默而内含深悲的晚期境界。",
    "start": 106.585,
    "end": 109.891,
    "duration": 3.306
  },
  {
    "id": 29,
    "text": "《故事新编》将古代神话的宏伟想象与现代杂文的逻辑解剖融为一体，",
    "start": 110.323,
    "end": 115.78,
    "duration": 5.457
  },
  {
    "id": 30,
    "text": "既有《补天》般绚烂的原始生命力展现，",
    "start": 116.166,
    "end": 118.792,
    "duration": 2.626
  },
  {
    "id": 31,
    "text": "又有《非攻》墨子止战的清醒务实，",
    "start": 119.251,
    "end": 121.808,
    "duration": 2.557
  },
  {
    "id": 32,
    "text": "在嬉笑怒骂中深藏对文明困境的沉痛哲思，",
    "start": 122.119,
    "end": 125.621,
    "duration": 3.502
  },
  {
    "id": 33,
    "text": "体现出鲁迅晚年游刃有余、返璞归真的艺术功力。",
    "start": 126.168,
    "end": 130.07,
    "duration": 3.902
  },
  {
    "id": 34,
    "text": "整体观之，",
    "start": 130.72,
    "end": 131.44,
    "duration": 0.72
  },
  {
    "id": 35,
    "text": "《故事新编》以古今杂糅的文体破格与消解神话的哲学深度，",
    "start": 131.802,
    "end": 136.312,
    "duration": 4.51
  },
  {
    "id": 36,
    "text": "拓展了中国小说的艺术边界，",
    "start": 136.664,
    "end": 138.567,
    "duration": 1.903
  },
  {
    "id": 37,
    "text": "确立了现代历史小说探索的独特美学高峰。",
    "start": 138.934,
    "end": 142.0,
    "duration": 3.066
  }
]