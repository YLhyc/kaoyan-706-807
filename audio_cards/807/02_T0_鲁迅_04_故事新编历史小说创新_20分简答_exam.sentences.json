[
  {
    "id": 1,
    "text": "题目：简述鲁迅《故事新编》在历史小说创作上的文体创新与思想特色。",
    "start": 0.28,
    "end": 6.36,
    "duration": 6.08
  },
  {
    "id": 2,
    "text": "鲁迅晚期小说集《故事新编》是中国现代历史小说文体试验的划时代杰作。",
    "start": 6.88,
    "end": 12.88,
    "duration": 6.0
  },
  {
    "id": 3,
    "text": "鲁迅摒弃了传统历史小说“据事直书”的考据泥潭，也超越了单纯借古讽今的政论模式，",
    "start": 13.4,
    "end": 20.41,
    "duration": 7.01
  },
  {
    "id": 4,
    "text": "融合神话传奇、现代心理与杂文笔法，开创了现代“新历史小说”的先河。",
    "start": 20.81,
    "end": 26.73,
    "duration": 5.92
  },
  {
    "id": 5,
    "text": "其创新主要体现在以下三个方面：",
    "start": 27.25,
    "end": 29.41,
    "duration": 2.16
  },
  {
    "id": 6,
    "text": "第一，独创“古今杂糅”与戏谑“油滑”笔法，打破历史的神圣光环。",
    "start": 29.78,
    "end": 34.74,
    "duration": 4.96
  },
  {
    "id": 7,
    "text": "鲁迅依托古代神话与史料骨架，大胆打破时空界限，",
    "start": 35.26,
    "end": 39.42,
    "duration": 4.16
  },
  {
    "id": 8,
    "text": "将现代口语、摩登生活细节与文人论战现实自然植入远古场景。",
    "start": 39.79,
    "end": 45.31,
    "duration": 5.52
  },
  {
    "id": 9,
    "text": "在《理水》中，文化山学者乘奇肱国飞车考察并大谈“古貌林”“O.K.”，",
    "start": 45.83,
    "end": 51.59,
    "duration": 5.76
  },
  {
    "id": 10,
    "text": "与皮肤粗黑、吃粗粮的治水大禹形成滑稽对照；",
    "start": 52.36,
    "end": 56.28,
    "duration": 3.92
  },
  {
    "id": 11,
    "text": "这种借鉴戏剧丑角式的“油滑”调侃，打破了传统英雄的虚妄光环，",
    "start": 56.8,
    "end": 61.73,
    "duration": 4.93
  },
  {
    "id": 12,
    "text": "使远古历史成为映照现代知识分子病态人格的反讽镜。",
    "start": 62.1,
    "end": 66.58,
    "duration": 4.48
  },
  {
    "id": 13,
    "text": "第二，构筑庄严与荒诞的二元并置，追问崇高理想被世俗消磨的生存悲剧。",
    "start": 67.1,
    "end": 73.1,
    "duration": 6.0
  },
  {
    "id": 14,
    "text": "鲁迅刻意将叙事视点由英雄创业的高光转向功成之后的凡俗日常。",
    "start": 73.62,
    "end": 78.98,
    "duration": 5.36
  },
  {
    "id": 15,
    "text": "《奔月》打破神射手神话，展现后羿射尽野兽后每日吃乌鸦肉炸酱面、被琐碎生活消磨的英雄末路；",
    "start": 79.5,
    "end": 88.06,
    "duration": 8.56
  },
  {
    "id": 16,
    "text": "《铸剑》中黑衣人与眉间尺玉石俱焚的惨烈复仇，",
    "start": 88.58,
    "end": 92.58,
    "duration": 4.0
  },
  {
    "id": 17,
    "text": "在王公群臣与宫女围观金鼎沸水的猎奇中沦为娱乐景观，",
    "start": 92.95,
    "end": 97.99,
    "duration": 5.04
  },
  {
    "id": 18,
    "text": "深刻揭示了先驱者的崇高牺牲在麻木历史中被消费、扭曲的荒诞悲凉。",
    "start": 98.36,
    "end": 104.12,
    "duration": 5.76
  },
  {
    "id": 19,
    "text": "第三，打通小说、神话与杂文的文体界限，开创从容幽默而内含深悲的晚期境界。",
    "start": 104.64,
    "end": 111.36,
    "duration": 6.72
  },
  {
    "id": 20,
    "text": "《故事新编》将古代神话的宏伟想象与现代杂文的逻辑解剖融为一体，",
    "start": 111.88,
    "end": 117.56,
    "duration": 5.68
  },
  {
    "id": 21,
    "text": "既有《补天》般绚烂的原始生命力展现，又有《非攻》墨子止战的清醒务实，",
    "start": 117.93,
    "end": 123.58,
    "duration": 5.65
  },
  {
    "id": 22,
    "text": "在嬉笑怒骂中深藏对文明困境的沉痛哲思，体现出鲁迅晚年游刃有余、返璞归真的艺术功力。",
    "start": 123.98,
    "end": 131.74,
    "duration": 7.76
  },
  {
    "id": 23,
    "text": "整体观之，《故事新编》以古今杂糅的文体破格与消解神话的哲学深度，",
    "start": 132.26,
    "end": 137.86,
    "duration": 5.6
  },
  {
    "id": 24,
    "text": "拓展了中国小说的艺术边界，确立了现代历史小说探索的独特美学高峰。",
    "start": 138.23,
    "end": 143.59,
    "duration": 5.36
  }
]