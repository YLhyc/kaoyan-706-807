[
  {
    "id": 1,
    "text": "鲁迅的《故事新编》是中国现代历史小说文体试验的划时代杰作。",
    "start": 0.16,
    "end": 4.96,
    "duration": 4.8
  },
  {
    "id": 2,
    "text": "鲁迅彻底摒弃了传统历史小说“据事直书”的考据路径，",
    "start": 4.96,
    "end": 9.44,
    "duration": 4.48
  },
  {
    "id": 3,
    "text": "也超越了单纯借古讽今的政论模式。",
    "start": 9.44,
    "end": 12.4,
    "duration": 2.96
  },
  {
    "id": 4,
    "text": "他以现代思想眼光激活古人古事，在历史与现实之间建立了充满荒诞感的反讽张力，",
    "start": 12.4,
    "end": 19.36,
    "duration": 6.96
  },
  {
    "id": 5,
    "text": "开创了现代“新历史小说”的先声。",
    "start": 19.36,
    "end": 21.68,
    "duration": 2.32
  },
  {
    "id": 6,
    "text": "首先，在叙事机制上，鲁迅创造性地运用了“古今杂糅”与戏谑“油滑”的笔法。",
    "start": 22.08,
    "end": 28.72,
    "duration": 6.64
  },
  {
    "id": 7,
    "text": "鲁迅以古代神话史料为依托，大胆打破时空界限，",
    "start": 28.72,
    "end": 32.48,
    "duration": 3.76
  },
  {
    "id": 8,
    "text": "将现代口语与摩登生活细节植入远古历史情境。",
    "start": 32.48,
    "end": 36.56,
    "duration": 4.08
  },
  {
    "id": 9,
    "text": "他借鉴戏剧丑角手法打破神话人物的神圣光环。",
    "start": 36.56,
    "end": 40.16,
    "duration": 3.6
  },
  {
    "id": 10,
    "text": "《理水》中文化山学者满口英文，与艰苦治水的夏禹形成滑稽对照。",
    "start": 40.32,
    "end": 45.989,
    "duration": 5.669
  },
  {
    "id": 11,
    "text": "这种古今错位的叙事方式，使历史成为照亮现代中国精神病灶的镜子。",
    "start": 45.989,
    "end": 52.311,
    "duration": 6.322
  },
  {
    "id": 12,
    "text": "其次，在思想深意上，作品构筑了庄严与荒诞的互渗并置，",
    "start": 52.311,
    "end": 57.326,
    "duration": 5.015
  },
  {
    "id": 13,
    "text": "深刻透视了先驱者的生存困境。",
    "start": 57.326,
    "end": 60.16,
    "duration": 2.834
  },
  {
    "id": 14,
    "text": "鲁迅不满足于展现英雄创业的历史荣光，",
    "start": 60.24,
    "end": 63.44,
    "duration": 3.2
  },
  {
    "id": 15,
    "text": "而是冷峻追问事业成功之后的凡俗日常与现实冷遇。",
    "start": 63.44,
    "end": 68.32,
    "duration": 4.88
  },
  {
    "id": 16,
    "text": "《奔月》打破英雄神话，细腻呈现后羿功成后被琐碎日常消磨的精神荒原。",
    "start": 68.32,
    "end": 74.96,
    "duration": 6.64
  },
  {
    "id": 17,
    "text": "《铸剑》中悲壮的复仇最终在臣民看热闹的狂欢中沦为围观景观。",
    "start": 74.96,
    "end": 80.24,
    "duration": 5.28
  },
  {
    "id": 18,
    "text": "鲁迅深刻揭示了崇高理想在庸常历史中遭遇扭曲与消费的悲凉循环。",
    "start": 80.56,
    "end": 86.56,
    "duration": 6.0
  },
  {
    "id": 19,
    "text": "最后，在文体范式上，作品将神话传奇、",
    "start": 86.56,
    "end": 90.4,
    "duration": 3.84
  },
  {
    "id": 20,
    "text": "现代心理与杂文锋芒熔铸为独特的晚期境界。",
    "start": 90.4,
    "end": 94.8,
    "duration": 4.4
  },
  {
    "id": 21,
    "text": "鲁迅打破了传统文学体裁的严格规制。",
    "start": 94.8,
    "end": 98.0,
    "duration": 3.2
  },
  {
    "id": 22,
    "text": "《故事新编》既保留了古代神话的宏阔想象，",
    "start": 98.0,
    "end": 101.36,
    "duration": 3.36
  },
  {
    "id": 23,
    "text": "又融入了杂文的逻辑透视与心理解剖。",
    "start": 101.36,
    "end": 104.24,
    "duration": 2.88
  },
  {
    "id": 24,
    "text": "《补天》的宏大创世与《非攻》的墨子止战，",
    "start": 104.48,
    "end": 107.688,
    "duration": 3.208
  },
  {
    "id": 25,
    "text": "兼具抒情性与论辩性。",
    "start": 107.688,
    "end": 109.613,
    "duration": 1.925
  },
  {
    "id": 26,
    "text": "鲁迅在晚年创造了从容幽默而内含深沉悲凉的美学格调。",
    "start": 109.613,
    "end": 114.746,
    "duration": 5.133
  },
  {
    "id": 27,
    "text": "综上所述，《故事新编》以古今杂糅的文体破格与解构神话的哲学深度，",
    "start": 114.746,
    "end": 120.735,
    "duration": 5.989
  },
  {
    "id": 28,
    "text": "刷新了中国小说的艺术边界，树立了先锋探索的标杆。--",
    "start": 120.735,
    "end": 125.44,
    "duration": 4.705
  }
]