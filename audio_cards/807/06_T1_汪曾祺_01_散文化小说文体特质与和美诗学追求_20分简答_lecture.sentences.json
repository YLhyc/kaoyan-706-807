[
  {
    "id": 1,
    "text": "八十年代初，汪曾祺以《受戒》《大淖记事》重返当代文坛，",
    "start": 0.05,
    "end": 4.762,
    "duration": 4.712
  },
  {
    "id": 2,
    "text": "在当代文学走出机械教条、回归审美本体的历史转折点上，",
    "start": 4.762,
    "end": 9.511,
    "duration": 4.749
  },
  {
    "id": 3,
    "text": "确立了独特的文体坐标。",
    "start": 9.511,
    "end": 11.406,
    "duration": 1.895
  },
  {
    "id": 4,
    "text": "作为京派文学在当代的薪火传人，",
    "start": 11.406,
    "end": 15.653,
    "duration": 4.247
  },
  {
    "id": 5,
    "text": "其小说的艺术特色与文体革新主要体现于以下三个方面：",
    "start": 15.653,
    "end": 20.981,
    "duration": 5.328
  },
  {
    "id": 6,
    "text": "第一，解构传统情节中心律，",
    "start": 20.981,
    "end": 22.981,
    "duration": 2.0
  },
  {
    "id": 7,
    "text": "开辟写意从容的“散文化小说”崭新范式。",
    "start": 22.981,
    "end": 26.449,
    "duration": 3.468
  },
  {
    "id": 8,
    "text": "汪曾祺断然摒弃了剑拔弩张的戏剧性冲突与因果锁链式的跌宕情节，",
    "start": 26.449,
    "end": 31.944,
    "duration": 5.495
  },
  {
    "id": 9,
    "text": "主张“短篇小说要写得像散文一样随便”。",
    "start": 31.944,
    "end": 35.827,
    "duration": 3.883
  },
  {
    "id": 10,
    "text": "在《受戒》中，小说花费大量笔墨铺叙庵赵庄的民俗风物、",
    "start": 35.827,
    "end": 40.979,
    "duration": 5.152
  },
  {
    "id": 11,
    "text": "荸荠荠菜的季节变迁与和尚收租打牌的日常闲趣；",
    "start": 40.979,
    "end": 47.128,
    "duration": 6.149
  },
  {
    "id": 12,
    "text": "在荸荠田与芦花荡荡漾的清风里，",
    "start": 47.128,
    "end": 49.673,
    "duration": 2.545
  },
  {
    "id": 13,
    "text": "明海与小英子于受戒归来的渡船上互吐心迹，",
    "start": 49.673,
    "end": 53.355,
    "duration": 3.682
  },
  {
    "id": 14,
    "text": "情爱如清泉般自然流淌，通篇展现出气韵生动、",
    "start": 53.355,
    "end": 57.76,
    "duration": 4.405
  },
  {
    "id": 15,
    "text": "情景交融的东方写意画境。",
    "start": 57.76,
    "end": 60.464,
    "duration": 2.704
  },
  {
    "id": 16,
    "text": "第二，承续沈从文人性美学，",
    "start": 60.464,
    "end": 62.464,
    "duration": 2.0
  },
  {
    "id": 17,
    "text": "建构健康自然的人性乌托邦与和美哲学。",
    "start": 62.464,
    "end": 66.17,
    "duration": 3.706
  },
  {
    "id": 18,
    "text": "汪曾祺在小说中极力发掘未被现代文明污染的民间伦理与纯朴德行。",
    "start": 66.17,
    "end": 73.173,
    "duration": 7.003
  },
  {
    "id": 19,
    "text": "在《大淖记事》中，",
    "start": 73.173,
    "end": 74.264,
    "duration": 1.091
  },
  {
    "id": 20,
    "text": "挑夫与锡匠群体身上流淌着粗粝而自尊的生命活力；",
    "start": 74.264,
    "end": 79.984,
    "duration": 5.72
  },
  {
    "id": 21,
    "text": "当十一子惨遭地方恶霸毒打摧残后，",
    "start": 79.984,
    "end": 83.142,
    "duration": 3.158
  },
  {
    "id": 22,
    "text": "巧云冲破世俗门第与道德偏见，",
    "start": 83.142,
    "end": 85.505,
    "duration": 2.363
  },
  {
    "id": 23,
    "text": "在众人注视下毅然端来参汤悉心喂服，",
    "start": 85.505,
    "end": 89.297,
    "duration": 3.792
  },
  {
    "id": 24,
    "text": "以无私纯粹的女性柔情救赎苦难肉身，彰显出一种超越苦难、",
    "start": 89.297,
    "end": 94.649,
    "duration": 5.352
  },
  {
    "id": 25,
    "text": "温润包容的人性神性光辉。",
    "start": 94.649,
    "end": 97.02,
    "duration": 2.371
  },
  {
    "id": 26,
    "text": "第三，融通古典文言与现代白话，锤炼出洗练熨帖、",
    "start": 97.02,
    "end": 101.23,
    "duration": 4.21
  },
  {
    "id": 27,
    "text": "具音乐声律的语言风格。",
    "start": 101.23,
    "end": 103.275,
    "duration": 2.045
  },
  {
    "id": 28,
    "text": "作家秉持语言即文化本体的诗学观念，将六朝笔记的凝练、",
    "start": 103.275,
    "end": 108.021,
    "duration": 4.746
  },
  {
    "id": 29,
    "text": "明清小品的风致与纯正的民间口语水乳交融。",
    "start": 108.021,
    "end": 112.146,
    "duration": 4.125
  },
  {
    "id": 30,
    "text": "其叙述句式短促空灵，用词极度脱水而意蕴丰沛，",
    "start": 112.146,
    "end": 116.62,
    "duration": 4.474
  },
  {
    "id": 31,
    "text": "以不着一字尽得风流的从容节制，",
    "start": 116.62,
    "end": 119.498,
    "duration": 2.878
  },
  {
    "id": 32,
    "text": "实现了中国现代小说语言雅俗共赏、如水银泻地般的诗意回响。",
    "start": 119.498,
    "end": 125.088,
    "duration": 5.59
  }
]