[
  {
    "id": 1,
    "text": "八十年代初，汪曾祺以《受戒》《大淖记事》重返当代文坛，",
    "start": 0.08,
    "end": 5.12,
    "duration": 5.04
  },
  {
    "id": 2,
    "text": "在当代文学走出机械教条、回归审美本体的历史转折点上，",
    "start": 5.12,
    "end": 10.16,
    "duration": 5.04
  },
  {
    "id": 3,
    "text": "确立了独特的文体坐标。",
    "start": 10.16,
    "end": 12.16,
    "duration": 2.0
  },
  {
    "id": 4,
    "text": "作为京派文学在当代的薪火传人，",
    "start": 12.16,
    "end": 15.04,
    "duration": 2.88
  },
  {
    "id": 5,
    "text": "其小说的艺术特色与文体革新主要体现于以下三个方面：",
    "start": 15.04,
    "end": 20.0,
    "duration": 4.96
  },
  {
    "id": 6,
    "text": "第一，解构传统情节中心律，",
    "start": 20.0,
    "end": 23.04,
    "duration": 3.04
  },
  {
    "id": 7,
    "text": "开辟写意从容的“散文化小说”崭新范式。",
    "start": 23.04,
    "end": 26.56,
    "duration": 3.52
  },
  {
    "id": 8,
    "text": "汪曾祺断然摒弃了剑拔弩张的戏剧性冲突与因果锁链式的跌宕情节，",
    "start": 26.64,
    "end": 32.64,
    "duration": 6.0
  },
  {
    "id": 9,
    "text": "主张“短篇小说要写得像散文一样随便”。",
    "start": 32.64,
    "end": 36.64,
    "duration": 4.0
  },
  {
    "id": 10,
    "text": "在《受戒》中，小说花费大量笔墨铺叙庵赵庄的民俗风物、",
    "start": 36.64,
    "end": 42.16,
    "duration": 5.52
  },
  {
    "id": 11,
    "text": "荸荠荠菜的季节变迁与和尚收租打牌的日常闲趣；",
    "start": 42.16,
    "end": 46.56,
    "duration": 4.4
  },
  {
    "id": 12,
    "text": "在荸荠田与芦花荡荡漾的清风里，",
    "start": 46.96,
    "end": 49.92,
    "duration": 2.96
  },
  {
    "id": 13,
    "text": "明海与小英子于受戒归来的渡船上互吐心迹，",
    "start": 49.92,
    "end": 54.48,
    "duration": 4.56
  },
  {
    "id": 14,
    "text": "情爱如清泉般自然流淌，通篇展现出气韵生动、",
    "start": 54.48,
    "end": 59.28,
    "duration": 4.8
  },
  {
    "id": 15,
    "text": "情景交融的东方写意画境。",
    "start": 59.28,
    "end": 61.92,
    "duration": 2.64
  },
  {
    "id": 16,
    "text": "第二，承续沈从文人性美学，",
    "start": 61.92,
    "end": 64.24,
    "duration": 2.32
  },
  {
    "id": 17,
    "text": "建构健康自然的人性乌托邦与和美哲学。",
    "start": 64.24,
    "end": 67.52,
    "duration": 3.28
  },
  {
    "id": 18,
    "text": "汪曾祺在小说中极力发掘未被现代文明污染的民间伦理与纯朴德行。",
    "start": 67.52,
    "end": 74.48,
    "duration": 6.96
  },
  {
    "id": 19,
    "text": "在《大淖记事》中，",
    "start": 74.48,
    "end": 76.56,
    "duration": 2.08
  },
  {
    "id": 20,
    "text": "挑夫与锡匠群体身上流淌着粗粝而自尊的生命活力；",
    "start": 76.56,
    "end": 82.0,
    "duration": 5.44
  },
  {
    "id": 21,
    "text": "当十一子惨遭地方恶霸毒打摧残后，",
    "start": 82.0,
    "end": 85.68,
    "duration": 3.68
  },
  {
    "id": 22,
    "text": "巧云冲破世俗门第与道德偏见，",
    "start": 85.68,
    "end": 88.96,
    "duration": 3.28
  },
  {
    "id": 23,
    "text": "在众人注视下毅然端来参汤悉心喂服，",
    "start": 89.12,
    "end": 93.76,
    "duration": 4.64
  },
  {
    "id": 24,
    "text": "以无私纯粹的女性柔情救赎苦难肉身，彰显出一种超越苦难、",
    "start": 93.76,
    "end": 100.48,
    "duration": 6.72
  },
  {
    "id": 25,
    "text": "温润包容的人性神性光辉。",
    "start": 100.48,
    "end": 102.96,
    "duration": 2.48
  },
  {
    "id": 26,
    "text": "第三，融通古典文言与现代白话，锤炼出洗练熨帖、",
    "start": 103.2,
    "end": 107.68,
    "duration": 4.48
  },
  {
    "id": 27,
    "text": "具音乐声律的语言风格。",
    "start": 107.68,
    "end": 110.08,
    "duration": 2.4
  },
  {
    "id": 28,
    "text": "作家秉持语言即文化本体的诗学观念，将六朝笔记的凝练、",
    "start": 110.08,
    "end": 115.76,
    "duration": 5.68
  },
  {
    "id": 29,
    "text": "明清小品的风致与纯正的民间口语水乳交融。",
    "start": 115.76,
    "end": 119.92,
    "duration": 4.16
  },
  {
    "id": 30,
    "text": "其叙述句式短促空灵，用词极度脱水而意蕴丰沛，",
    "start": 119.92,
    "end": 124.64,
    "duration": 4.72
  },
  {
    "id": 31,
    "text": "以不着一字尽得风流的从容节制，",
    "start": 124.64,
    "end": 124.8,
    "duration": 0.16
  },
  {
    "id": 32,
    "text": "实现了中国现代小说语言雅俗共赏、如水银泻地般的诗意回响。",
    "start": 124.64,
    "end": 124.8,
    "duration": 0.16
  }
]