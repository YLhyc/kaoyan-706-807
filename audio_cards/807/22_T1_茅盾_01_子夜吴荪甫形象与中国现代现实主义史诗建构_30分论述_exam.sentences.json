[
  {
    "id": 1,
    "start": 0.08,
    "end": 3.84,
    "text": "茅盾于一九三三年出版的长篇小说《子夜》，"
  },
  {
    "id": 2,
    "start": 3.84,
    "end": 10.64,
    "text": "是中国现代文学史上第一部真正具备宏大全景史诗品格的现实主义巨著。"
  },
  {
    "id": 3,
    "start": 10.64,
    "end": 13.68,
    "text": "茅盾以革命现实主义的深刻洞察力，"
  },
  {
    "id": 4,
    "start": 13.68,
    "end": 19.76,
    "text": "通过民族资本家吴孙甫在一九三零年夏上海滩经济搏杀中的最终溃败，"
  },
  {
    "id": 5,
    "start": 19.76,
    "end": 23.2,
    "text": "深刻回答了关于中国社会性质的大论战，"
  },
  {
    "id": 6,
    "start": 23.2,
    "end": 29.76,
    "text": "以高度自觉的“社会解剖学”笔法树立了中国现代长篇小说史上的巍峨丰碑。"
  },
  {
    "id": 7,
    "start": 30.0,
    "end": 40.0,
    "text": "第一，在形象塑造艺术上，作品成功塑造了吴孙甫这一兼具雄图霸气与致命软弱的中国民族资产阶级典型。"
  },
  {
    "id": 8,
    "start": 40.0,
    "end": 44.88,
    "text": "吴孙甫绝非平庸猥琐的商人，而是一位具有现代工业眼光、"
  },
  {
    "id": 9,
    "start": 44.88,
    "end": 49.84,
    "text": "精明果断且具有“机械化实业救国”野心的民族资本巨头。"
  },
  {
    "id": 10,
    "start": 49.84,
    "end": 52.72,
    "text": "他傲视上海滩的封建官僚与洋行买办，"
  },
  {
    "id": 11,
    "start": 52.72,
    "end": 59.52,
    "text": "自比为“中国的亨利•福特”，试图通过兼并八家中小日用工厂组建益中信托公司，"
  },
  {
    "id": 12,
    "start": 59.52,
    "end": 61.92,
    "text": "建立起独立的现代民族工业帝国。"
  },
  {
    "id": 13,
    "start": 62.16,
    "end": 69.28,
    "text": "在性格呈现上，老辣坚毅的铁腕意志与内心的焦虑恐慌构成其复杂心理机制。"
  },
  {
    "id": 14,
    "start": 69.28,
    "end": 73.12,
    "text": "面对外资买办的金融围剿与工人罢工风潮，"
  },
  {
    "id": 15,
    "start": 73.12,
    "end": 77.28,
    "text": "吴孙甫的性格从最初的意气风发、杀伐决断，"
  },
  {
    "id": 16,
    "start": 77.28,
    "end": 80.16,
    "text": "逐步蜕变为刚愎自用、多疑焦躁。"
  },
  {
    "id": 17,
    "start": 80.16,
    "end": 87.28,
    "text": "在公债市场决战的最后关头，他甚至沦落到在家里殴打妻子与侮辱婢女以发泄虚弱，"
  },
  {
    "id": 18,
    "start": 87.28,
    "end": 90.88,
    "text": "最终在盟友杜竹斋的致命背叛下全面崩盘，"
  },
  {
    "id": 19,
    "start": 90.88,
    "end": 94.96,
    "text": "生动再现了一个悲剧英雄走向末路的心理蜕变过程。"
  },
  {
    "id": 20,
    "start": 95.264,
    "end": 102.224,
    "text": "第二，在悲剧意蕴生成机制上，吴孙甫的覆灭深刻揭示了在半殖民地半封建旧中国，"
  },
  {
    "id": 21,
    "start": 102.224,
    "end": 106.064,
    "text": "民族资本主义“实业救国”道路必遭破产的历史宿命。"
  },
  {
    "id": 22,
    "start": 106.064,
    "end": 111.664,
    "text": "茅盾以深厚的政治经济学素养，剖析了扼杀吴孙甫的双重社会绞杀网。"
  },
  {
    "id": 23,
    "start": 111.664,
    "end": 119.264,
    "text": "一方面，在宏观外部经济上，帝国主义直接扶植的金融买办资本掌握着绝对的资金与政治特权。"
  },
  {
    "id": 24,
    "start": 119.504,
    "end": 124.944,
    "text": "赵伯韬背后有美帝国主义势力与国民党反动政权的强力庇护，"
  },
  {
    "id": 25,
    "start": 124.944,
    "end": 130.384,
    "text": "操控着公债内幕行情，使民族实业在投机狂潮面前不堪一击。"
  },
  {
    "id": 26,
    "start": 130.384,
    "end": 136.624,
    "text": "另一方面，在微观企业内部，身处双重压迫下的民族实业家为了转嫁危机，"
  },
  {
    "id": 27,
    "start": 136.624,
    "end": 140.624,
    "text": "不得不对工人阶级施加更加残酷的减薪压榨，"
  },
  {
    "id": 28,
    "start": 140.624,
    "end": 143.424,
    "text": "从而激起益中丝厂工人的猛烈同盟罢工。"
  },
  {
    "id": 29,
    "start": 143.744,
    "end": 150.384,
    "text": "内外交困的双重围剿，注定了民族资产阶级既无法抗衡强大的帝国主义买办势力，"
  },
  {
    "id": 30,
    "start": 150.384,
    "end": 153.584,
    "text": "又无法获得无产阶级底层民众的同情，"
  },
  {
    "id": 31,
    "start": 153.584,
    "end": 157.264,
    "text": "其自立自强的实业神话必然化为历史泡影。"
  },
  {
    "id": 32,
    "start": 157.264,
    "end": 161.504,
    "text": "第三，在艺术表现机制上，作品构建了宏大繁复、"
  },
  {
    "id": 33,
    "start": 161.504,
    "end": 164.544,
    "text": "纵横交织的全景式“社会剖析”史诗结构。"
  },
  {
    "id": 34,
    "start": 164.784,
    "end": 169.031,
    "text": "《子夜》彻底突破了中国传统小说的单一线性视角，"
  },
  {
    "id": 35,
    "start": 169.031,
    "end": 172.005,
    "text": "开创了多线并进的网状叙事空间。"
  },
  {
    "id": 36,
    "start": 172.005,
    "end": 176.04,
    "text": "全书以吴孙甫的实业与金融斗争为核心轴心，"
  },
  {
    "id": 37,
    "start": 176.04,
    "end": 183.261,
    "text": "同时平行铺展了三条壮阔的社会线索：一是以赵伯韬为代表的买办金融投机狂潮，"
  },
  {
    "id": 38,
    "start": 183.261,
    "end": 188.358,
    "text": "二是以玛琪、林佩瑶为代表的都市资产阶级腐朽享乐生活，"
  },
  {
    "id": 39,
    "start": 188.358,
    "end": 194.304,
    "text": "三是以双桥镇农民暴动与益中丝厂工人大罢工为代表的革命浪潮。"
  },
  {
    "id": 40,
    "start": 194.384,
    "end": 199.264,
    "text": "开篇第一章吴老太爷自乡下迁入上海暴毙的名场面，"
  },
  {
    "id": 41,
    "start": 199.264,
    "end": 203.024,
    "text": "以其紧握《太上感应篇》面对霓虹灯的死相，"
  },
  {
    "id": 42,
    "start": 203.024,
    "end": 209.184,
    "text": "高度象征了封建宗法僵尸在现代资本主义畸形大都市面前的彻底崩溃，"
  },
  {
    "id": 43,
    "start": 209.184,
    "end": 212.224,
    "text": "展现出宏阔深邃的史诗营构手笔。"
  },
  {
    "id": 44,
    "start": 212.224,
    "end": 217.024,
    "text": "综上所述，茅盾《子夜》通过吴孙甫实业帝国的兴衰崩塌，"
  },
  {
    "id": 45,
    "start": 217.024,
    "end": 222.224,
    "text": "为近代中国民族资产阶级的历史宿命绘制了雄浑沉痛的时代挽歌。"
  },
  {
    "id": 46,
    "start": 222.464,
    "end": 227.584,
    "text": "它以严谨的理性解剖、宏阔的时代容量与立体的人物塑造，"
  },
  {
    "id": 47,
    "start": 227.584,
    "end": 231.424,
    "text": "奠定了中国现代长篇小说走向成熟的坚实标杆。"
  }
]