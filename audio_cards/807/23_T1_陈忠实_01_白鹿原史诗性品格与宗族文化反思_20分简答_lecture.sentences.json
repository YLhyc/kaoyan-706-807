[
  {
    "id": 1,
    "text": "九十年代初，陈忠实以长篇巨著《白鹿原》的问世，",
    "start": 0.101,
    "end": 3.663,
    "duration": 3.562
  },
  {
    "id": 2,
    "text": "在中国当代文学长篇小说创作中矗立起一座深沉雄浑的现实主义史诗丰碑。",
    "start": 3.96,
    "end": 9.897,
    "duration": 5.937
  },
  {
    "id": 3,
    "text": "作品以关中平原白鹿村半个多世纪的风云激荡为微观全息投影，",
    "start": 10.256,
    "end": 15.549,
    "duration": 5.293
  },
  {
    "id": 4,
    "text": "其史诗性品格与文化反思主要表现在以下三个方面：",
    "start": 15.834,
    "end": 20.036,
    "duration": 4.202
  },
  {
    "id": 5,
    "text": "第一，建构家族秘史与民族命运互渗的宏阔史诗全景。",
    "start": 20.258,
    "end": 25.116,
    "duration": 4.858
  },
  {
    "id": 6,
    "text": "小说跳出了单一意识形态政治图解的狭隘框架，将辛亥革命、",
    "start": 25.684,
    "end": 30.532,
    "duration": 4.848
  },
  {
    "id": 7,
    "text": "军阀混战、抗日战争直至政权更迭的宏大历史变局，",
    "start": 30.679,
    "end": 34.962,
    "duration": 4.283
  },
  {
    "id": 8,
    "text": "天衣无缝地交织进白、鹿两大家族数代人错综复杂、",
    "start": 34.962,
    "end": 39.781,
    "duration": 4.819
  },
  {
    "id": 9,
    "text": "荣辱浮沉的兴衰血泪史中。",
    "start": 39.989,
    "end": 42.043,
    "duration": 2.054
  },
  {
    "id": 10,
    "text": "从白嘉轩以巧计换地奠定家族基业，",
    "start": 42.255,
    "end": 45.78,
    "duration": 3.525
  },
  {
    "id": 11,
    "text": "到国共两党青年在原上的殊死较量，",
    "start": 45.89,
    "end": 48.827,
    "duration": 2.937
  },
  {
    "id": 12,
    "text": "作品以如椽巨笔描摹出中国传统宗法农耕社会走向现代解体的波澜壮阔的全景图卷。",
    "start": 49.17,
    "end": 57.317,
    "duration": 8.147
  },
  {
    "id": 13,
    "text": "第二，解剖宗法儒家伦理与人性本能冲撞的深层文化困境。",
    "start": 57.444,
    "end": 62.556,
    "duration": 5.112
  },
  {
    "id": 14,
    "text": "族长白嘉轩以腰杆挺得笔直的威严姿态，",
    "start": 62.851,
    "end": 66.087,
    "duration": 3.236
  },
  {
    "id": 15,
    "text": "在祠堂前高举枣木戒尺严惩通奸与败德，",
    "start": 66.351,
    "end": 70.056,
    "duration": 3.705
  },
  {
    "id": 16,
    "text": "成为恪守传统儒家人伦道德的坚挺象征；",
    "start": 70.252,
    "end": 73.802,
    "duration": 3.55
  },
  {
    "id": 17,
    "text": "而田小娥与黑娃则作为原始生命野性与情欲本能的叛逆者，",
    "start": 74.022,
    "end": 79.075,
    "duration": 5.053
  },
  {
    "id": 18,
    "text": "在破窑洞里向严苛族规发起绝望反抗。",
    "start": 79.432,
    "end": 82.939,
    "duration": 3.507
  },
  {
    "id": 19,
    "text": "当田小娥最终惨遭公公鹿三钢钎刺杀、",
    "start": 83.138,
    "end": 86.495,
    "duration": 3.357
  },
  {
    "id": 20,
    "text": "尸身火化并被砖塔镇压化为瘟疫白蛾的惨烈意象，",
    "start": 86.799,
    "end": 91.327,
    "duration": 4.528
  },
  {
    "id": 21,
    "text": "深刻揭示了封建伦理对生命自由摧残与自我反噬的深重文化悲剧。",
    "start": 91.741,
    "end": 98.093,
    "duration": 6.352
  },
  {
    "id": 22,
    "text": "第三，融汇魔幻现实主义与关中民间秘响，",
    "start": 98.582,
    "end": 101.359,
    "duration": 2.777
  },
  {
    "id": 23,
    "text": "确立深沉的文化哲学沉思。",
    "start": 101.687,
    "end": 103.49,
    "duration": 1.803
  },
  {
    "id": 24,
    "text": "作家将关中民间传说中的“白鹿神话”、",
    "start": 103.986,
    "end": 106.906,
    "duration": 2.92
  },
  {
    "id": 25,
    "text": "深谙天道易理的圣人朱先生的预言，",
    "start": 107.219,
    "end": 110.082,
    "duration": 2.863
  },
  {
    "id": 26,
    "text": "与严谨冷峻的历史写实巧妙化合。",
    "start": 110.105,
    "end": 112.62,
    "duration": 2.515
  },
  {
    "id": 27,
    "text": "通过鹿子霖在狂热争名逐利后落得家破人亡、",
    "start": 113.096,
    "end": 116.756,
    "duration": 3.66
  },
  {
    "id": 28,
    "text": "于冰天雪地中冻毙发狂的惨淡结局，",
    "start": 116.856,
    "end": 119.448,
    "duration": 2.592
  },
  {
    "id": 29,
    "text": "小说在宏大的历史兴替之上，对善恶报应、",
    "start": 119.799,
    "end": 123.035,
    "duration": 3.236
  },
  {
    "id": 30,
    "text": "宗族消长与历史循环进行了形而上的形神拷问，",
    "start": 123.309,
    "end": 127.118,
    "duration": 3.809
  },
  {
    "id": 31,
    "text": "赋予全篇深邃幽远的史诗哲学品格。",
    "start": 127.402,
    "end": 130.296,
    "duration": 2.894
  }
]
