[
  {
    "id": 1,
    "text": "九十年代初，陈忠实以长篇小说《白鹿原》的问世，",
    "start": 0.116,
    "end": 3.719,
    "duration": 3.603
  },
  {
    "id": 2,
    "text": "为当代文学贡献了一部厚重雄浑的现实主义力作。",
    "start": 4.105,
    "end": 7.834,
    "duration": 3.729
  },
  {
    "id": 3,
    "text": "作品以关中平原白鹿村半个多世纪的风云变迁为缩影，",
    "start": 8.248,
    "end": 12.075,
    "duration": 3.827
  },
  {
    "id": 4,
    "text": "其史诗品格与宗族文化反思主要体现于以下三个方面：",
    "start": 12.287,
    "end": 16.982,
    "duration": 4.695
  },
  {
    "id": 5,
    "text": "第一，建构家族秘史与民族命运交织的宏阔历史图景。",
    "start": 17.617,
    "end": 22.075,
    "duration": 4.458
  },
  {
    "id": 6,
    "text": "小说跳出单一政治图解的模式，将辛亥革命、军阀混战、",
    "start": 22.703,
    "end": 27.139,
    "duration": 4.436
  },
  {
    "id": 7,
    "text": "抗战烽火直至政权更迭的宏大历史变局，自然融入白、",
    "start": 27.612,
    "end": 31.495,
    "duration": 3.883
  },
  {
    "id": 8,
    "text": "鹿两大家族数代人荣辱沉浮的兴衰史中。",
    "start": 31.737,
    "end": 35.152,
    "duration": 3.415
  },
  {
    "id": 9,
    "text": "从白嘉轩巧计换地奠定家业，",
    "start": 35.7,
    "end": 37.933,
    "duration": 2.233
  },
  {
    "id": 10,
    "text": "到国共两党青年在原上的激烈博弈，",
    "start": 38.184,
    "end": 41.202,
    "duration": 3.018
  },
  {
    "id": 11,
    "text": "作品以厚重笔力描绘出传统宗法农耕社会走向现代解体的全景图卷。",
    "start": 41.667,
    "end": 48.029,
    "duration": 6.362
  },
  {
    "id": 12,
    "text": "第二，剖析儒家宗法伦理与人性本能冲突的文化困境。",
    "start": 48.623,
    "end": 52.857,
    "duration": 4.234
  },
  {
    "id": 13,
    "text": "族长白嘉轩以腰杆挺直的威严姿态，",
    "start": 53.336,
    "end": 56.305,
    "duration": 2.969
  },
  {
    "id": 14,
    "text": "在祠堂前动用严酷族规惩戒败德者，",
    "start": 56.692,
    "end": 59.813,
    "duration": 3.121
  },
  {
    "id": 15,
    "text": "承载着传统儒家伦理的仁义坚守与冷酷专断；",
    "start": 60.056,
    "end": 64.151,
    "duration": 4.095
  },
  {
    "id": 16,
    "text": "田小娥与黑娃则代表受压抑的生命野性与情欲本能，",
    "start": 64.408,
    "end": 68.828,
    "duration": 4.42
  },
  {
    "id": 17,
    "text": "在破窑洞里反抗严苛礼法。",
    "start": 69.119,
    "end": 71.305,
    "duration": 2.186
  },
  {
    "id": 18,
    "text": "田小娥最终惨遭公公鹿三刺杀、尸身被砖塔镇压化为瘟疫白蛾，",
    "start": 71.653,
    "end": 77.245,
    "duration": 5.592
  },
  {
    "id": 19,
    "text": "揭示了封建礼教对人性自由的压抑与自我反噬。",
    "start": 77.55,
    "end": 81.343,
    "duration": 3.793
  },
  {
    "id": 20,
    "text": "第三，融汇关中民间神话与历史写实，生发深沉的哲理追问。",
    "start": 82.05,
    "end": 87.862,
    "duration": 5.812
  },
  {
    "id": 21,
    "text": "作家将关中民间流传的“白鹿神话”、",
    "start": 88.451,
    "end": 91.312,
    "duration": 2.861
  },
  {
    "id": 22,
    "text": "深谙天道的圣人朱先生的预言，",
    "start": 91.742,
    "end": 94.108,
    "duration": 2.366
  },
  {
    "id": 23,
    "text": "与冷静严谨的历史写实结合起来。",
    "start": 94.263,
    "end": 97.08,
    "duration": 2.817
  },
  {
    "id": 24,
    "text": "通过鹿子霖一生机关算尽却落得家破人亡、",
    "start": 97.683,
    "end": 101.089,
    "duration": 3.406
  },
  {
    "id": 25,
    "text": "于风雪中疯癫冻毙的结局，小说在历史兴替之上对善恶报应、",
    "start": 101.629,
    "end": 106.907,
    "duration": 5.278
  },
  {
    "id": 26,
    "text": "宗族消长与人性幽微作出了深沉的哲理追问，",
    "start": 107.178,
    "end": 110.859,
    "duration": 3.681
  },
  {
    "id": 27,
    "text": "赋予全篇苍茫厚重的历史感。",
    "start": 111.126,
    "end": 113.431,
    "duration": 2.305
  }
]