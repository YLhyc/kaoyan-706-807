[
  {
    "id": 1,
    "text": "九十年代初，陈忠实以长篇小说《白鹿原》的问世，为当代文学贡献了一部厚重雄浑的现实主义力作。",
    "start": 0.116,
    "end": 7.844,
    "duration": 7.728
  },
  {
    "id": 2,
    "text": "作品以关中平原白鹿村半个多世纪的风云变迁为缩影，",
    "start": 8.248,
    "end": 12.085,
    "duration": 3.837
  },
  {
    "id": 3,
    "text": "其史诗品格与宗族文化反思主要体现于以下三个方面：",
    "start": 12.287,
    "end": 16.992,
    "duration": 4.705
  },
  {
    "id": 4,
    "text": "第一，建构家族秘史与民族命运交织的宏阔历史图景。",
    "start": 17.617,
    "end": 22.085,
    "duration": 4.468
  },
  {
    "id": 5,
    "text": "小说跳出单一政治图解的模式，",
    "start": 22.703,
    "end": 25.162,
    "duration": 2.459
  },
  {
    "id": 6,
    "text": "将辛亥革命、军阀混战、抗战烽火直至政权更迭的宏大历史变局，",
    "start": 25.295,
    "end": 30.525,
    "duration": 5.23
  },
  {
    "id": 7,
    "text": "自然融入白、鹿两大家族数代人荣辱沉浮的兴衰史中。",
    "start": 30.838,
    "end": 35.162,
    "duration": 4.324
  },
  {
    "id": 8,
    "text": "从白嘉轩巧计换地奠定家业，到国共两党青年在原上的激烈博弈，",
    "start": 35.7,
    "end": 41.211,
    "duration": 5.511
  },
  {
    "id": 9,
    "text": "作品以厚重笔力描绘出传统宗法农耕社会走向现代解体的全景图卷。",
    "start": 41.667,
    "end": 48.039,
    "duration": 6.372
  },
  {
    "id": 10,
    "text": "第二，剖析儒家宗法伦理与人性本能冲突的文化困境。",
    "start": 48.623,
    "end": 52.867,
    "duration": 4.244
  },
  {
    "id": 11,
    "text": "族长白嘉轩以腰杆挺直的威严姿态，在祠堂前动用严酷族规惩戒败德者，",
    "start": 53.336,
    "end": 59.823,
    "duration": 6.487
  },
  {
    "id": 12,
    "text": "承载着传统儒家伦理的仁义坚守与冷酷专断；",
    "start": 60.056,
    "end": 64.161,
    "duration": 4.105
  },
  {
    "id": 13,
    "text": "田小娥与黑娃则代表受压抑的生命野性与情欲本能，在破窑洞里反抗严苛礼法。",
    "start": 64.408,
    "end": 71.315,
    "duration": 6.907
  },
  {
    "id": 14,
    "text": "田小娥最终惨遭公公鹿三刺杀、白鹿原爆发瘟疫后更被砖塔镇压，",
    "start": 71.653,
    "end": 77.169,
    "duration": 5.516
  },
  {
    "id": 15,
    "text": "揭示了封建礼教对人性自由的压抑与自我反噬。",
    "start": 77.464,
    "end": 81.267,
    "duration": 3.803
  },
  {
    "id": 16,
    "text": "第三，融汇关中民间神话与历史写实，生发深沉的哲理追问。",
    "start": 81.964,
    "end": 87.786,
    "duration": 5.822
  },
  {
    "id": 17,
    "text": "作家将关中民间流传的“白鹿神话”、深谙天道的圣人朱先生的预言，与冷静严谨的历史写实结合起来。",
    "start": 88.365,
    "end": 97.004,
    "duration": 8.639
  },
  {
    "id": 18,
    "text": "通过鹿子霖一生机关算尽却落得家破人亡、于风雪中疯癫冻毙的结局，",
    "start": 97.597,
    "end": 103.521,
    "duration": 5.924
  },
  {
    "id": 19,
    "text": "小说在历史兴替之上对善恶报应、宗族消长与人性幽微作出了深沉的哲理追问，赋予全篇苍茫厚重的历史感。",
    "start": 103.954,
    "end": 113.345,
    "duration": 9.391
  }
]