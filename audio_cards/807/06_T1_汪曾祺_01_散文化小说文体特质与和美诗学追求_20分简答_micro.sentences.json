[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "汪曾祺·散文化小说文体特质与和美诗学追求",
    "start": 0.314,
    "end": 4.366,
    "duration": 4.052
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "文体→人性→语言三步承继京派：先破“剑拔弩张戏剧冲突”确立《受戒》的散文化写意画境，",
    "start": 5.374,
    "end": 15.146,
    "duration": 9.772
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再接续沈从文在《大淖记事》挖掘纯朴民间人性乌托邦与柔情救赎，",
    "start": 15.494,
    "end": 21.586,
    "duration": 6.092
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后归于“六朝笔记+明清小品+民间口语”的雅俗语言美学。",
    "start": 21.774,
    "end": 26.546,
    "duration": 4.772
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "八十年代初汪曾祺以《受戒》《大淖记事》重返文坛，",
    "start": 27.554,
    "end": 31.886,
    "duration": 4.332
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "在当代文学回归审美本体转折点上立独特坐标，成京派文学当代薪火传人。",
    "start": 32.274,
    "end": 39.206,
    "duration": 6.932
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 破情节中心律、辟“散文化小说”范式",
    "start": 40.214,
    "end": 43.546,
    "duration": 3.332
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "摒弃剑拔弩张冲突与因果锁链，倡“短篇小说要写得像散文一样随便”；",
    "start": 44.514,
    "end": 51.206,
    "duration": 6.692
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "大量铺叙庵赵庄民俗农事与和尚日常闲趣，荸荠田、芦花渡船上明海与小英子情爱自然流淌，成东方写意画境。",
    "start": 52.174,
    "end": 63.066,
    "duration": 10.892
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 承沈从文美学、建健康自然和美哲学",
    "start": 64.034,
    "end": 69.246,
    "duration": 5.212
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "极力发掘未被现代文明侵蚀的民间伦理与纯朴德行；",
    "start": 70.254,
    "end": 75.306,
    "duration": 5.052
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "挑夫锡匠自带自尊活力；",
    "start": 76.394,
    "end": 79.286,
    "duration": 2.892
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "十一子遭毒打后，巧云冲破流言淫威在众人注视下端参汤喂服，以纯粹柔情救赎苦难肉身，显和美哲学。",
    "start": 80.294,
    "end": 90.306,
    "duration": 10.012
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 融通文言与白话、炼洗练音乐语言",
    "start": 91.314,
    "end": 94.686,
    "duration": 3.372
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "秉持语言即文化本体观，融六朝笔记凝练、明清小品风致与纯正民间口语为一炉；",
    "start": 95.418,
    "end": 103.39,
    "duration": 7.972
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "句式短促空灵、用词精练，以“不着一字尽得风流”节制赋予小说雅俗共赏诗意神韵。",
    "start": 104.438,
    "end": 112.85,
    "duration": 8.412
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：代表作记住《受戒》（明海与小英子）和《大淖记事》（巧云与十一子）；",
    "start": 113.938,
    "end": 121.15,
    "duration": 7.212
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "汪曾祺是京派（沈从文）在当代新时期的传人。",
    "start": 122.118,
    "end": 125.73,
    "duration": 3.612
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 梳理汪曾祺与沈从文京派美学的承接关系及新时期初历史位置？",
    "start": 126.738,
    "end": 133.99,
    "duration": 7.252
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《受戒》庵赵庄渡船与《大淖记事》巧云喂汤说明“散文化+和美哲学”？",
    "start": 134.958,
    "end": 143.17,
    "duration": 8.212
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 概括汪曾祺语言融合“六朝笔记/明清小品/民间口语”的特质？",
    "start": 144.178,
    "end": 151.15,
    "duration": 6.972
  }
]