[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "文体→人性→语言三步承继京派：",
    "start": 0.0,
    "end": 3.72,
    "duration": 3.72
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先破“剑拔弩张戏剧冲突”确立《受戒》的散文化写意画境，",
    "start": 3.769,
    "end": 8.089,
    "duration": 4.32
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再接续沈从文在《大淖记事》挖掘纯朴民间人性乌托邦与柔情救赎，",
    "start": 8.539,
    "end": 13.979,
    "duration": 5.44
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后归于“六朝笔记+明清小品+民间口语”的雅俗语言美学。",
    "start": 14.429,
    "end": 19.469,
    "duration": 5.04
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "八十年代初汪曾祺以《受戒》《大淖记事》重返文坛，",
    "start": 19.919,
    "end": 23.719,
    "duration": 3.8
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "在当代文学回归审美本体转折点上立独特坐标，成京派文学当代薪火传人。",
    "start": 24.169,
    "end": 30.209,
    "duration": 6.04
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 破情节中心律、辟“散文化小说”范式",
    "start": 30.659,
    "end": 34.379,
    "duration": 3.72
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "摒弃剑拔弩张冲突与因果锁链，倡“短篇小说要写得像散文一样随便”；",
    "start": 34.829,
    "end": 40.309,
    "duration": 5.48
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "大量铺叙庵赵庄民俗农事与和尚日常闲趣，",
    "start": 40.759,
    "end": 44.479,
    "duration": 3.72
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "荸荠田、芦花渡船上明海与小英子情爱自然流淌，成东方写意画境。",
    "start": 44.929,
    "end": 50.769,
    "duration": 5.84
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 承沈从文美学、建健康自然和美哲学",
    "start": 51.219,
    "end": 55.699,
    "duration": 4.48
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "极力发掘未被现代文明侵蚀的民间伦理与纯朴德行；",
    "start": 56.149,
    "end": 60.509,
    "duration": 4.36
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "挑夫锡匠自带自尊活力；",
    "start": 60.959,
    "end": 62.959,
    "duration": 2.0
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "十一子遭毒打后，巧云冲破流言淫威在众人注视下端参汤喂服，",
    "start": 63.409,
    "end": 69.209,
    "duration": 5.8
  },
  {
    "id": "sec1_step1_c2",
    "dom_key": "sec1_step1_c2",
    "text": "以纯粹柔情救赎苦难肉身，显和美哲学。",
    "start": 69.659,
    "end": 73.459,
    "duration": 3.8
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 融通文言与白话、炼洗练音乐语言",
    "start": 73.909,
    "end": 77.909,
    "duration": 4.0
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "秉持语言即文化本体观，",
    "start": 78.359,
    "end": 80.439,
    "duration": 2.08
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "融六朝笔记凝练、明清小品风致与纯正民间口语为一炉；",
    "start": 80.889,
    "end": 85.409,
    "duration": 4.52
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "句式短促空灵、用词精练，",
    "start": 85.939,
    "end": 88.019,
    "duration": 2.08
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "以“不着一字尽得风流”节制赋予小说雅俗共赏诗意神韵。",
    "start": 88.469,
    "end": 93.309,
    "duration": 4.84
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：代表作记住《受戒》（明海与小英子）和《大淖记事》（巧云与十一子）；",
    "start": 93.759,
    "end": 99.839,
    "duration": 6.08
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "汪曾祺是京派（沈从文）在当代新时期的传人。",
    "start": 100.369,
    "end": 104.529,
    "duration": 4.16
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 梳理汪曾祺与沈从文京派美学的承接关系及新时期初历史位置？",
    "start": 104.979,
    "end": 111.659,
    "duration": 6.68
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《受戒》庵赵庄渡船与《大淖记事》巧云喂汤说明“散文化+和美哲学”？",
    "start": 112.109,
    "end": 119.229,
    "duration": 7.12
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 概括汪曾祺语言融合“六朝笔记/明清小品/民间口语”的特质？",
    "start": 119.679,
    "end": 126.079,
    "duration": 6.4
  }
]