[
  {
    "id": 1,
    "start": 0.08,
    "end": 6.96,
    "text": "钱终书所著长篇小说《围城》是中国现代文学史上讽刺艺术与学者化智慧结合得最完美的杰作。"
  },
  {
    "id": 2,
    "start": 7.2,
    "end": 11.12,
    "text": "作品通过留学生方鸿渐在大后方的坎坷流转，"
  },
  {
    "id": 3,
    "start": 11.12,
    "end": 15.84,
    "text": "深刻解剖了抗战时期中国现代知识分子的精神萎靡，"
  },
  {
    "id": 4,
    "start": 15.84,
    "end": 21.68,
    "text": "以超拔的哲理深度展示了人类普遍面临的生存荒谬与沟通隔阂。"
  },
  {
    "id": 5,
    "start": 21.68,
    "end": 25.12,
    "text": "首先，小说通过“围城”的核心象征隐喻，"
  },
  {
    "id": 6,
    "start": 25.12,
    "end": 28.96,
    "text": "精辟揭示了现代知识分子进退失据的精神困境。"
  },
  {
    "id": 7,
    "start": 29.12,
    "end": 32.325,
    "text": "“城外的人想冲进去，城里的人想冲出来”，"
  },
  {
    "id": 8,
    "start": 32.325,
    "end": 35.129,
    "text": "成为现代人生存状态的经典写照。"
  },
  {
    "id": 9,
    "start": 35.129,
    "end": 38.133,
    "text": "方鸿渐是一个心地善良却缺乏定力、"
  },
  {
    "id": 10,
    "start": 38.133,
    "end": 41.138,
    "text": "高不成低不就的懦弱知识分子典型。"
  },
  {
    "id": 11,
    "start": 41.138,
    "end": 45.945,
    "text": "他既不甘随波逐流买假文凭却最终买了“克莱登大学”博士，"
  },
  {
    "id": 12,
    "start": 45.945,
    "end": 52.354,
    "text": "在爱情上既倾心于唐晓芙的纯真却最终陷入与孙柔嘉琐碎窒息的市快婚姻，"
  },
  {
    "id": 13,
    "start": 52.354,
    "end": 56.56,
    "text": "在事业上面对三闾大学的派系倾轧毫无招架之力。"
  },
  {
    "id": 14,
    "start": 56.72,
    "end": 62.8,
    "text": "钱终书通过方鸿渐在情感、婚姻、职业中不断奔突却处处受困的悲喜剧，"
  },
  {
    "id": 15,
    "start": 62.8,
    "end": 67.6,
    "text": "生动展现了现代人在欲望与幻灭之间无从摆脱的心理宿命。"
  },
  {
    "id": 16,
    "start": 67.6,
    "end": 70.8,
    "text": "其次，小说以犀利幽默的学者化笔触，"
  },
  {
    "id": 17,
    "start": 70.8,
    "end": 76.16,
    "text": "对中西文化畸形交融下伪知识分子的精神病态进行了辛辣的文化批判。"
  },
  {
    "id": 18,
    "start": 76.4,
    "end": 79.28,
    "text": "在三闾大学这一微缩的社会生态中，"
  },
  {
    "id": 19,
    "start": 79.28,
    "end": 82.24,
    "text": "作者撕碎了知识阶层崇高的道德假面。"
  },
  {
    "id": 20,
    "start": 82.24,
    "end": 86.24,
    "text": "高校长专权阴险，韩学愈以假文凭招摇撞骗，"
  },
  {
    "id": 21,
    "start": 86.24,
    "end": 90.16,
    "text": "李梅亭满口仁义道德却怀揣春药与私贩西药，"
  },
  {
    "id": 22,
    "start": 90.16,
    "end": 92.96,
    "text": "陆子潇则借抄写名信片附庸风雅。"
  },
  {
    "id": 23,
    "start": 92.96,
    "end": 96.8,
    "text": "钱终书以极其精妙奇警的比喻和反讽机智，"
  },
  {
    "id": 24,
    "start": 96.8,
    "end": 102.72,
    "text": "解剖了这些假现代、假崇高文人灵魂深处的卑琐自私与文化空虚，"
  },
  {
    "id": 25,
    "start": 102.72,
    "end": 108.32,
    "text": "将讽刺锋芒直指盲目崇洋与传统劣根性合流的时代精神故疾。"
  },
  {
    "id": 26,
    "start": 108.56,
    "end": 113.36,
    "text": "综上所述，钱终书《围城》借婚姻与职场的“围城”困局，"
  },
  {
    "id": 27,
    "start": 113.36,
    "end": 117.84,
    "text": "完成了对现代知识分子劣根性与文化虚伪的深刻解剖。"
  },
  {
    "id": 28,
    "start": 117.84,
    "end": 122.8,
    "text": "它以超拔的智性讽刺和对人类普遍生存困境的哲理观照，"
  },
  {
    "id": 29,
    "start": 122.8,
    "end": 125.92,
    "text": "确立了中国现代讽刺小说罕见的艺术高度。"
  }
]