[
  {
    "id": 1,
    "text": "中国现当代文学纵向母题链与跨期对比急救卡。",
    "start": 0.134,
    "end": 3.746,
    "duration": 3.612
  },
  {
    "id": 2,
    "text": "碰见跨越现代与当代的演变综合大题或未背过的双作家比较题，",
    "start": 4.463,
    "end": 9.515,
    "duration": 5.052
  },
  {
    "id": 3,
    "text": "可即刻调用“两条核心演进主脉”与“横切四维通用公式”，将已背单篇素材现场串联成文。",
    "start": 9.894,
    "end": 16.586,
    "duration": 6.692
  },
  {
    "id": 4,
    "text": "第一脉，乡土叙事与农民观百年演进线：鲁迅启蒙解剖，沈从文边城抒情，",
    "start": 17.304,
    "end": 23.156,
    "duration": 5.852
  },
  {
    "id": 5,
    "text": "赵树理改造翻身，汪曾祺返归日常诗学，寻根文学深掘民族文化根性。",
    "start": 23.535,
    "end": 28.947,
    "duration": 5.412
  },
  {
    "id": 6,
    "text": "历史递变逻辑为：五四鲁迅以《阿Q正传》《祝福》冷峻剖析国民劣根性与礼教麻木；",
    "start": 29.705,
    "end": 30.797,
    "duration": 1.092
  },
  {
    "id": 7,
    "text": "三十年代沈从文《边城》以湘西牧歌礼赞原始人性美；",
    "start": 31.326,
    "end": 33.018,
    "duration": 1.692
  },
  {
    "id": 8,
    "text": "四十年代赵树理《小二黑结婚》呈现解放区农民政治翻身与习俗惯性；",
    "start": 33.547,
    "end": 33.919,
    "duration": 0.372
  },
  {
    "id": 9,
    "text": "新时期初汪曾祺《受戒》复归民间和谐和美意境，",
    "start": 34.448,
    "end": 35.78,
    "duration": 1.332
  },
  {
    "id": 10,
    "text": "随即韩少功、阿城等寻根作家从风俗表象潜入民族文化积淀反思。",
    "start": 36.159,
    "end": 37.401,
    "duration": 1.242
  },
  {
    "id": 11,
    "text": "第二脉，都市体验与知识分子精神史线：郁达夫苦闷零余，曹禺、茅盾宗法金融夹击，",
    "start": 38.039,
    "end": 40.291,
    "duration": 2.252
  },
  {
    "id": 12,
    "text": "钱锺书《围城》讽刺虚妄，张爱玲苍凉废墟，新时期朦胧诗与新写实双轨重审。",
    "start": 40.67,
    "end": 42.362,
    "duration": 1.692
  },
  {
    "id": 13,
    "text": "历史递变逻辑为：郁达夫《沉沦》首先敞开觉醒个体的零余者痛感；",
    "start": 43.0,
    "end": 48.212,
    "duration": 5.212
  },
  {
    "id": 14,
    "text": "三十年代曹禺《雷雨》与茅盾《子夜》将困境接入宗法家庭压抑与半殖民地民族资本危机；",
    "start": 48.89,
    "end": 52.702,
    "duration": 3.812
  },
  {
    "id": 15,
    "text": "抗战时钱锺书讽刺文明夹缝中的文人浮躁，张爱玲《金锁记》揭开世俗物欲下的苍凉人欲；",
    "start": 53.231,
    "end": 54.363,
    "duration": 1.132
  },
  {
    "id": 16,
    "text": "新时期则先由朦胧诗高擎良知觉醒，再转入新写实对庸常琐碎生存的零度审视。",
    "start": 54.892,
    "end": 59.064,
    "duration": 4.172
  },
  {
    "id": 17,
    "text": "双作家或思潮比较大题严禁分写前后两截，按“四维同框横切”逐层对撞推进。",
    "start": 59.742,
    "end": 106.083,
    "duration": 46.341
  },
  {
    "id": 18,
    "text": "固定推演骨架为：一比历史语境与题材重心差异，二比人物心理或抒情主体姿态差异，",
    "start": 106.612,
    "end": 112.624,
    "duration": 6.012
  },
  {
    "id": 19,
    "text": "三比叙述视角、意象结构与语言修辞差异，四比在百年文学现代化进程中的价值承接；",
    "start": 113.003,
    "end": 119.899,
    "duration": 6.896
  },
  {
    "id": 20,
    "text": "每点紧扣各自一个核心细节（如祥子与祥林嫂、延安与京派）交错印证，文脉自然紧凑。",
    "start": 120.428,
    "end": 127.36,
    "duration": 6.932
  }
]