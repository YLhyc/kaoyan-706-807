[
  {
    "id": 1,
    "text": "一、宏观结构推演与采分点映射。",
    "start": 0.16,
    "end": 3.28,
    "duration": 3.12
  },
  {
    "id": 2,
    "text": "本题标准分为二十分，简答题结构采用高分“总领定性，",
    "start": 3.28,
    "end": 8.16,
    "duration": 4.88
  },
  {
    "id": 3,
    "text": "三点机制递进展开，收束总结”逻辑模型：一、",
    "start": 8.16,
    "end": 12.16,
    "duration": 4.0
  },
  {
    "id": 4,
    "text": "总领定性（约五十字）：作品定位（大革命失败后代表作）、",
    "start": 12.16,
    "end": 16.72,
    "duration": 4.56
  },
  {
    "id": 5,
    "text": "反公式化勇气、现实主义高度。",
    "start": 16.72,
    "end": 19.12,
    "duration": 2.4
  },
  {
    "id": 6,
    "text": "二、第一点：心理写实超越（反神化）：采分点为直面动摇与软弱、",
    "start": 19.44,
    "end": 24.588,
    "duration": 5.148
  },
  {
    "id": 7,
    "text": "静女士方罗兰心理轨迹、打破高大全。",
    "start": 24.588,
    "end": 27.892,
    "duration": 3.304
  },
  {
    "id": 8,
    "text": "三、第二点：悲剧冲突深化（反廉价团圆）：采分点为解构二元吞并、",
    "start": 27.892,
    "end": 33.401,
    "duration": 5.509
  },
  {
    "id": 9,
    "text": "展现无法调和的撕裂、章秋柳等人的幻灭结局。",
    "start": 33.401,
    "end": 37.587,
    "duration": 4.186
  },
  {
    "id": 10,
    "text": "四、第三点：史诗品格建构（宏微结合）：采分点为宏大时代与微观人情结合、",
    "start": 37.587,
    "end": 43.976,
    "duration": 6.389
  },
  {
    "id": 11,
    "text": "克服口号化、社会剖析深度。",
    "start": 43.976,
    "end": 46.4,
    "duration": 2.424
  },
  {
    "id": 12,
    "text": "五、收束总结（约五十字）：升华题材格调、",
    "start": 46.56,
    "end": 50.48,
    "duration": 3.92
  },
  {
    "id": 13,
    "text": "现代知识分子精神史诗定位。",
    "start": 50.48,
    "end": 52.8,
    "duration": 2.32
  },
  {
    "id": 14,
    "text": "二、逐段内部咬合与考场得分句推导。",
    "start": 52.8,
    "end": 56.08,
    "duration": 3.28
  },
  {
    "id": 15,
    "text": "总领段：明确作家作品与突破价值。",
    "start": 56.08,
    "end": 59.12,
    "duration": 3.04
  },
  {
    "id": 16,
    "text": "论证推演逻辑：直接点明茅盾《蚀》三部曲的时代坐标与突破意义。",
    "start": 59.12,
    "end": 64.32,
    "duration": 5.2
  },
  {
    "id": 17,
    "text": "指出其以现实主义超越流行公式，引出具体三点展开。",
    "start": 64.4,
    "end": 68.64,
    "duration": 4.24
  },
  {
    "id": 18,
    "text": "具体表述到答题语句就是：茅盾创作于大革命失败后的《蚀》三部曲（《幻灭》《动摇》《追求》），",
    "start": 68.64,
    "end": 75.36,
    "duration": 6.72
  },
  {
    "id": 19,
    "text": "是中国现代文学史上直面历史转折的现实主义力作。",
    "start": 75.36,
    "end": 79.28,
    "duration": 3.92
  },
  {
    "id": 20,
    "text": "面对当时文坛泛滥的“革命加恋爱”公式化倾向，",
    "start": 79.28,
    "end": 83.28,
    "duration": 4.0
  },
  {
    "id": 21,
    "text": "茅盾以高度的艺术勇气与写实洞察实现了重大超越。",
    "start": 83.28,
    "end": 87.28,
    "duration": 4.0
  },
  {
    "id": 22,
    "text": "其超越与深化主要体现在三个层面。",
    "start": 87.6,
    "end": 90.56,
    "duration": 2.96
  },
  {
    "id": 23,
    "text": "茅盾创作于大革命失败后的《蚀》三部曲（《幻灭》《动摇》《追求》），",
    "start": 90.56,
    "end": 95.68,
    "duration": 5.12
  },
  {
    "id": 24,
    "text": "是中国现代文学史上直面历史转折的现实主义力作。",
    "start": 95.68,
    "end": 100.08,
    "duration": 4.4
  },
  {
    "id": 25,
    "text": "面对当时文坛泛滥的“革命加恋爱”公式化倾向，",
    "start": 100.08,
    "end": 103.92,
    "duration": 3.84
  },
  {
    "id": 26,
    "text": "茅盾以高度的艺术勇气与写实洞察实现了重大超越。",
    "start": 103.92,
    "end": 108.0,
    "duration": 4.08
  },
  {
    "id": 27,
    "text": "其超越与深化主要体现在三个层面。",
    "start": 108.4,
    "end": 111.76,
    "duration": 3.36
  },
  {
    "id": 28,
    "text": "要点一：心理写实与打破神化。",
    "start": 111.76,
    "end": 115.04,
    "duration": 3.28
  },
  {
    "id": 29,
    "text": "论证推演逻辑：对比公式化的狂热口号，",
    "start": 115.04,
    "end": 118.72,
    "duration": 3.68
  },
  {
    "id": 30,
    "text": "指出茅盾的真实力量。",
    "start": 118.72,
    "end": 120.72,
    "duration": 2.0
  },
  {
    "id": 31,
    "text": "结合《幻灭》静女士的退缩与《动摇》方罗兰的彷徨，",
    "start": 120.72,
    "end": 124.64,
    "duration": 3.92
  },
  {
    "id": 32,
    "text": "分析其如何如实展现小资产阶级软弱性，",
    "start": 124.64,
    "end": 128.56,
    "duration": 3.92
  },
  {
    "id": 33,
    "text": "打破英雄神话。",
    "start": 128.56,
    "end": 130.32,
    "duration": 1.76
  },
  {
    "id": 34,
    "text": "具体表述到答题语句就是：第一，从概念化的革命狂热转向真实复杂的心理写实。",
    "start": 130.32,
    "end": 137.168,
    "duration": 6.848
  },
  {
    "id": 35,
    "text": "一般左翼作品常将革命写成战无不胜的浪漫进军。",
    "start": 137.168,
    "end": 141.008,
    "duration": 3.84
  },
  {
    "id": 36,
    "text": "茅盾则以亲历者的清醒，揭示了大革命狂潮中知识分子的动摇本相。",
    "start": 141.008,
    "end": 146.368,
    "duration": 5.36
  },
  {
    "id": 37,
    "text": "《幻灭》中静女士从革命热望走向抑郁退缩，",
    "start": 146.368,
    "end": 149.728,
    "duration": 3.36
  },
  {
    "id": 38,
    "text": "《动摇》中方罗兰在革命阵营与反动势力之间的犹疑彷徨。",
    "start": 149.728,
    "end": 153.968,
    "duration": 4.24
  },
  {
    "id": 39,
    "text": "茅盾毫不掩饰小资产阶级在时代巨变中的软弱性。",
    "start": 154.208,
    "end": 158.528,
    "duration": 4.32
  },
  {
    "id": 40,
    "text": "他通过细腻精微的心理剖析，打破了英雄人物的高大全神话。",
    "start": 158.528,
    "end": 163.728,
    "duration": 5.2
  },
  {
    "id": 41,
    "text": "第一，从概念化的革命狂热转向真实复杂的心理写实。",
    "start": 163.728,
    "end": 168.528,
    "duration": 4.8
  },
  {
    "id": 42,
    "text": "一般左翼作品常将革命写成战无不胜的浪漫进军。",
    "start": 168.528,
    "end": 172.608,
    "duration": 4.08
  },
  {
    "id": 43,
    "text": "茅盾则以亲历者的清醒，揭示了大革命狂潮中知识分子的动摇本相。",
    "start": 172.608,
    "end": 177.728,
    "duration": 5.12
  },
  {
    "id": 44,
    "text": "《幻灭》中静女士从革命热望走向抑郁退缩，",
    "start": 177.968,
    "end": 181.402,
    "duration": 3.434
  },
  {
    "id": 45,
    "text": "《动摇》中方罗兰在革命阵营与反动势力之间的犹疑彷徨。",
    "start": 181.402,
    "end": 186.049,
    "duration": 4.647
  },
  {
    "id": 46,
    "text": "茅盾毫不掩饰小资产阶级在时代巨变中的软弱性。",
    "start": 186.049,
    "end": 190.291,
    "duration": 4.242
  },
  {
    "id": 47,
    "text": "他通过细腻精微的心理剖析，打破了英雄人物的高大全神话。",
    "start": 190.291,
    "end": 195.342,
    "duration": 5.051
  },
  {
    "id": 48,
    "text": "要点二：悲剧冲突与反廉价胜利。",
    "start": 195.342,
    "end": 197.968,
    "duration": 2.626
  },
  {
    "id": 49,
    "text": "-论证推演逻辑：公式化作品总是革命轻松征服恋爱，",
    "start": 197.968,
    "end": 202.784,
    "duration": 4.816
  },
  {
    "id": 50,
    "text": "给廉价大团圆。",
    "start": 202.784,
    "end": 204.16,
    "duration": 1.376
  },
  {
    "id": 51,
    "text": "茅盾在《追求》中写出章秋柳等人在低潮期的放纵与绝望，",
    "start": 204.16,
    "end": 209.435,
    "duration": 5.275
  },
  {
    "id": 52,
    "text": "展现了政治动荡对个体情感的摧残，",
    "start": 209.435,
    "end": 212.875,
    "duration": 3.44
  },
  {
    "id": 53,
    "text": "体现深刻悲剧性。",
    "start": 212.875,
    "end": 214.48,
    "duration": 1.605
  },
  {
    "id": 54,
    "text": "具体表述到答题语句就是：第二，解构政治神话并深化情爱与革命的悲剧性冲突。",
    "start": 214.48,
    "end": 222.048,
    "duration": 7.568
  },
  {
    "id": 55,
    "text": "公式化的“革命加恋爱”往往让革命轻而易举征服恋爱。",
    "start": 222.128,
    "end": 226.448,
    "duration": 4.32
  },
  {
    "id": 56,
    "text": "茅盾则展现了两者深层无法弥合的撕裂。",
    "start": 226.448,
    "end": 229.728,
    "duration": 3.28
  },
  {
    "id": 57,
    "text": "《追求》中章秋柳与张曼青等青年，",
    "start": 229.728,
    "end": 232.528,
    "duration": 2.8
  },
  {
    "id": 58,
    "text": "在革命低潮期试图从感官放纵或世俗婚姻中寻找寄托，",
    "start": 232.528,
    "end": 237.408,
    "duration": 4.88
  },
  {
    "id": 59,
    "text": "最终均陷入精神幻灭。",
    "start": 237.408,
    "end": 239.328,
    "duration": 1.92
  },
  {
    "id": 60,
    "text": "茅盾并没有强行安排大团圆结局或机械的觉悟升华。",
    "start": 239.328,
    "end": 243.328,
    "duration": 4.0
  },
  {
    "id": 61,
    "text": "他如实记录了残酷政治风暴对个体生存与纯洁情爱的摧残，",
    "start": 243.568,
    "end": 248.768,
    "duration": 5.2
  },
  {
    "id": 62,
    "text": "赋予作品沉郁的悲剧力度。",
    "start": 248.768,
    "end": 250.768,
    "duration": 2.0
  },
  {
    "id": 63,
    "text": "第二，解构政治神话并深化情爱与革命的悲剧性冲突。",
    "start": 251.072,
    "end": 256.032,
    "duration": 4.96
  },
  {
    "id": 64,
    "text": "公式化的“革命加恋爱”往往让革命轻而易举征服恋爱。",
    "start": 256.032,
    "end": 260.352,
    "duration": 4.32
  },
  {
    "id": 65,
    "text": "茅盾则展现了两者深层无法弥合的撕裂。",
    "start": 260.352,
    "end": 263.472,
    "duration": 3.12
  },
  {
    "id": 66,
    "text": "《追求》中章秋柳与张曼青等青年，",
    "start": 263.472,
    "end": 266.112,
    "duration": 2.64
  },
  {
    "id": 67,
    "text": "在革命低潮期试图从感官放纵或世俗婚姻中寻找寄托，",
    "start": 266.112,
    "end": 270.832,
    "duration": 4.72
  },
  {
    "id": 68,
    "text": "最终均陷入精神幻灭。",
    "start": 270.832,
    "end": 272.512,
    "duration": 1.68
  },
  {
    "id": 69,
    "text": "茅盾并没有强行安排大团圆结局或机械的觉悟升华。",
    "start": 272.832,
    "end": 277.232,
    "duration": 4.4
  },
  {
    "id": 70,
    "text": "他如实记录了残酷政治风暴对个体生存与纯洁情爱的摧残，",
    "start": 277.232,
    "end": 282.912,
    "duration": 5.68
  },
  {
    "id": 71,
    "text": "赋予作品沉郁的悲剧力度。",
    "start": 282.912,
    "end": 285.152,
    "duration": 2.24
  },
  {
    "id": 72,
    "text": "要点三：宏微结合与史诗品格。",
    "start": 285.152,
    "end": 288.032,
    "duration": 2.88
  },
  {
    "id": 73,
    "text": "论证推演逻辑：文体结构上的突破。",
    "start": 288.032,
    "end": 291.232,
    "duration": 3.2
  },
  {
    "id": 74,
    "text": "将恋爱小悲欢置于大革命宏大历史风云中，",
    "start": 291.232,
    "end": 294.832,
    "duration": 3.6
  },
  {
    "id": 75,
    "text": "把阶级分析与人情摹写结合，告别粗糙传奇化。",
    "start": 294.832,
    "end": 298.992,
    "duration": 4.16
  },
  {
    "id": 76,
    "text": "-具体表述到答题语句就是：第三，",
    "start": 299.152,
    "end": 301.959,
    "duration": 2.807
  },
  {
    "id": 77,
    "text": "开辟了宏大社会剖析与细致人情摹写相结合的史诗品格。",
    "start": 301.959,
    "end": 307.141,
    "duration": 5.182
  },
  {
    "id": 78,
    "text": "茅盾将都市青年微观的情感纠葛，精准锚定在大革命由高涨走向溃败的宏阔历史画卷中。",
    "start": 307.141,
    "end": 315.13,
    "duration": 7.989
  },
  {
    "id": 79,
    "text": "他把阶级分析方法化入严密的日常生活纹理。",
    "start": 315.13,
    "end": 319.232,
    "duration": 4.102
  },
  {
    "id": 80,
    "text": "这彻底告别了早期左翼小说口号化与传奇化的粗糙弊端。",
    "start": 319.312,
    "end": 324.912,
    "duration": 5.6
  },
  {
    "id": 81,
    "text": "第三，开辟了宏大社会剖析与细致人情摹写相结合的史诗品格。",
    "start": 324.912,
    "end": 330.832,
    "duration": 5.92
  },
  {
    "id": 82,
    "text": "茅盾将都市青年微观的情感纠葛，精准锚定在大革命由高涨走向溃败的宏阔历史画卷中。",
    "start": 330.832,
    "end": 338.752,
    "duration": 7.92
  },
  {
    "id": 83,
    "text": "他把阶级分析方法化入严密的日常生活纹理。",
    "start": 338.752,
    "end": 342.192,
    "duration": 3.44
  },
  {
    "id": 84,
    "text": "这彻底告别了早期左翼小说口号化与传奇化的粗糙弊端。",
    "start": 342.432,
    "end": 347.312,
    "duration": 4.88
  },
  {
    "id": 85,
    "text": "总结升华段：文学史高度总结。",
    "start": 347.312,
    "end": 349.872,
    "duration": 2.56
  },
  {
    "id": 86,
    "text": "论证推演逻辑：最后用一句话总结茅盾把廉价题材提升为时代灵魂大震荡的精神史诗。",
    "start": 349.872,
    "end": 357.566,
    "duration": 7.694
  },
  {
    "id": 87,
    "text": "具体表述到答题语句就是：茅盾以严肃的现实主义精神，",
    "start": 357.566,
    "end": 362.08,
    "duration": 4.514
  },
  {
    "id": 88,
    "text": "使“革命加恋爱”题材彻底脱离了低俗奇遇的泥闹，",
    "start": 362.08,
    "end": 366.005,
    "duration": 3.925
  },
  {
    "id": 89,
    "text": "真正升华为表现一代现代知识分子灵魂大震荡的精神史诗。",
    "start": 366.005,
    "end": 370.912,
    "duration": 4.907
  },
  {
    "id": 90,
    "text": "茅盾以严肃的现实主义精神，使“革命加恋爱”题材彻底脱离了低俗奇遇的泥闹，",
    "start": 370.992,
    "end": 378.272,
    "duration": 7.28
  },
  {
    "id": 91,
    "text": "真正升华为表现一代现代知识分子灵魂大震荡的精神史诗。",
    "start": 378.272,
    "end": 383.472,
    "duration": 5.2
  }
]