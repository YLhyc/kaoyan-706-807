[
  {
    "id": 1,
    "text": "余华从二十世纪八十年代后期的先锋实验，",
    "start": 0.16,
    "end": 3.6,
    "duration": 3.44
  },
  {
    "id": 2,
    "text": "转向九十年代的长篇现实主义书写，",
    "start": 3.6,
    "end": 6.48,
    "duration": 2.88
  },
  {
    "id": 3,
    "text": "代表了中国先锋作家从形式激进走向生命温情的深刻蜕变。",
    "start": 6.48,
    "end": 11.68,
    "duration": 5.2
  },
  {
    "id": 4,
    "text": "这一转型集中体现在三个方面。",
    "start": 11.68,
    "end": 14.0,
    "duration": 2.32
  },
  {
    "id": 5,
    "text": "第一，从形式本体解构转向传统线性叙事回归。",
    "start": 14.16,
    "end": 18.56,
    "duration": 4.4
  },
  {
    "id": 6,
    "text": "八十年代余华以《十八岁出门远行》《现实一种》等先锋短篇闻名。",
    "start": 18.56,
    "end": 23.92,
    "duration": 5.36
  },
  {
    "id": 7,
    "text": "他注重反因果逻辑、叙述视点断裂与反讽修辞。",
    "start": 24.16,
    "end": 28.8,
    "duration": 4.64
  },
  {
    "id": 8,
    "text": "进入九十年代，余华在《活着》与《许三观卖血记》中放弃了繁复的形式迷宫。",
    "start": 28.8,
    "end": 35.2,
    "duration": 6.4
  },
  {
    "id": 9,
    "text": "他转而采用平实质朴的线性民间叙事。",
    "start": 35.2,
    "end": 38.64,
    "duration": 3.44
  },
  {
    "id": 10,
    "text": "作家借助福贵的第一人称口述与许三观重复回环的口语对话，",
    "start": 38.64,
    "end": 43.76,
    "duration": 5.12
  },
  {
    "id": 11,
    "text": "重建了通俗流畅的讲故事传统。",
    "start": 43.76,
    "end": 46.16,
    "duration": 2.4
  },
  {
    "id": 12,
    "text": "第二，从零度情感暴力转向人道主义悲敏与温情。",
    "start": 46.48,
    "end": 50.96,
    "duration": 4.48
  },
  {
    "id": 13,
    "text": "先锋时期的余华被称作冷酷的解剖师。",
    "start": 50.96,
    "end": 54.4,
    "duration": 3.44
  },
  {
    "id": 14,
    "text": "他以剔除道德温度的笔触，平静描摹流血、",
    "start": 54.4,
    "end": 58.32,
    "duration": 3.92
  },
  {
    "id": 15,
    "text": "残杀与存在的荒谬本相。",
    "start": 58.32,
    "end": 60.96,
    "duration": 2.64
  },
  {
    "id": 16,
    "text": "九十年代后余华的创作立场发生根本扭转。",
    "start": 60.96,
    "end": 64.48,
    "duration": 3.52
  },
  {
    "id": 17,
    "text": "他开始深情凝视普通底层百姓的生存韧性。",
    "start": 64.48,
    "end": 67.76,
    "duration": 3.28
  },
  {
    "id": 18,
    "text": "《活着》在无休止的死亡剥夺中，展现福贵与老牛相依为命的生命尊严。",
    "start": 67.92,
    "end": 73.972,
    "duration": 6.052
  },
  {
    "id": 19,
    "text": "《许三观卖血记》中许三观在一次次卖血换命的屈辱中，",
    "start": 73.972,
    "end": 78.728,
    "duration": 4.756
  },
  {
    "id": 20,
    "text": "释出对非亲生儿子一乐深沉博大的父爱。",
    "start": 78.728,
    "end": 82.402,
    "duration": 3.674
  },
  {
    "id": 21,
    "text": "冷酷的解剖最终被博大的人性关怀所融化。",
    "start": 82.402,
    "end": 86.293,
    "duration": 3.891
  },
  {
    "id": 22,
    "text": "第三，从哲学荒诞寓言转向深沉历史命运体验。",
    "start": 86.293,
    "end": 90.4,
    "duration": 4.107
  },
  {
    "id": 23,
    "text": "先锋短篇更多是抽离具体历史语境的形而上生存寓言。",
    "start": 90.56,
    "end": 95.12,
    "duration": 4.56
  },
  {
    "id": 24,
    "text": "九十年代长篇则深深扎根于中国现代历史的苦难土壤。",
    "start": 95.12,
    "end": 100.0,
    "duration": 4.88
  },
  {
    "id": 25,
    "text": "余华将内战、大跃进、文革等重大时代风暴，",
    "start": 100.0,
    "end": 103.68,
    "duration": 3.68
  },
  {
    "id": 26,
    "text": "化为普通个体无处逃避的生存背景。",
    "start": 103.68,
    "end": 106.72,
    "duration": 3.04
  },
  {
    "id": 27,
    "text": "文学的重心由此从解构现实，升华为了解与同情现实。",
    "start": 106.72,
    "end": 111.76,
    "duration": 5.04
  },
  {
    "id": 28,
    "text": "余华的转型并非向传统现实主义的简单妥协，",
    "start": 112.0,
    "end": 115.76,
    "duration": 3.76
  },
  {
    "id": 29,
    "text": "而是在历经先锋形式革命洗礼后，对生命本质与汉语文学传统的成熟重构。",
    "start": 115.76,
    "end": 121.6,
    "duration": 5.84
  },
  {
    "id": 30,
    "text": "--",
    "start": 121.6,
    "end": 121.68,
    "duration": 0.08
  }
]