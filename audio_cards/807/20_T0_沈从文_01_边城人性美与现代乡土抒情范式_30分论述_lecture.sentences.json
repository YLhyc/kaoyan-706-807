[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 3.04,
    "duration": 2.96
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 3.04,
    "end": 6.16,
    "duration": 3.12
  },
  {
    "id": 3,
    "text": "这道题考查现代乡土抒情小说巅峰《边城》。",
    "start": 6.4,
    "end": 10.4,
    "duration": 4.0
  },
  {
    "id": 4,
    "text": "在考场上，考生不能简单只说“风景美、",
    "start": 10.4,
    "end": 13.68,
    "duration": 3.28
  },
  {
    "id": 5,
    "text": "民风淳朴”，而必须紧扣“人性美的哲学机制”与“抒情小说文体创新”两大题眼。",
    "start": 13.68,
    "end": 20.08,
    "duration": 6.4
  },
  {
    "id": 6,
    "text": "核心在于回答：沈从文究竟如何通过茶峒人情重塑健康人生形式，",
    "start": 20.32,
    "end": 26.0,
    "duration": 5.68
  },
  {
    "id": 7,
    "text": "以及他在散文化、风俗画和哀愁意蕴上对小说文体做出了怎样的划时代贡献。",
    "start": 26.0,
    "end": 32.72,
    "duration": 6.72
  },
  {
    "id": 8,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 32.72,
    "end": 35.76,
    "duration": 3.04
  },
  {
    "id": 9,
    "text": "答题必须确立“思想美学（人性美）趋近于形式机制（散文化文体）趋近于深层文化批判”的三维流线。",
    "start": 35.76,
    "end": 44.08,
    "duration": 8.32
  },
  {
    "id": 10,
    "text": "首先剖析老船夫、翠翠、天保挪送的人性光彩，",
    "start": 44.4,
    "end": 48.0,
    "duration": 3.6
  },
  {
    "id": 11,
    "text": "其次解剖端午赛龙舟等民俗画与诗化散文语言，",
    "start": 48.0,
    "end": 51.92,
    "duration": 3.92
  },
  {
    "id": 12,
    "text": "最后挖掘无常命运感与对抗都市病态文明的批判动力。",
    "start": 51.92,
    "end": 56.32,
    "duration": 4.4
  },
  {
    "id": 13,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 56.32,
    "end": 59.68,
    "duration": 3.36
  },
  {
    "id": 14,
    "text": "全题分为四个核心论述维度：第一维度：界定《边城》作为京派文学最高峰与诗意乡土巅峰的文学史坐标；",
    "start": 59.68,
    "end": 67.52,
    "duration": 7.84
  },
  {
    "id": 15,
    "text": "-第二维度：深入剖析“优美、健康、",
    "start": 67.68,
    "end": 70.279,
    "duration": 2.599
  },
  {
    "id": 16,
    "text": "自然”之人性美建构（祖孙情、纯洁爱情、",
    "start": 70.279,
    "end": 73.527,
    "duration": 3.248
  },
  {
    "id": 17,
    "text": "手足情）；",
    "start": 73.527,
    "end": 74.177,
    "duration": 0.65
  },
  {
    "id": 18,
    "text": "-第三维度：精细剖析淡化情节、营构如画风俗风物与融铸诗意散文的文体创新；",
    "start": 74.177,
    "end": 81.107,
    "duration": 6.93
  },
  {
    "id": 19,
    "text": "-第四维度：深刻论述牧歌情调下的命运无常悲慨与对抗现代都市文明病的文化批判机制；",
    "start": 81.107,
    "end": 89.12,
    "duration": 8.013
  },
  {
    "id": 20,
    "text": "第五维度：宏观总结作品在人文关怀与东方审美建构上的世界级定论。",
    "start": 89.2,
    "end": 95.68,
    "duration": 6.48
  },
  {
    "id": 21,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 95.68,
    "end": 100.16,
    "duration": 4.48
  },
  {
    "id": 22,
    "text": "全题逻辑严密咬合：第一步宏观立论，",
    "start": 100.16,
    "end": 104.0,
    "duration": 3.84
  },
  {
    "id": 23,
    "text": "确立湘西人性神庙的定位。",
    "start": 104.0,
    "end": 106.48,
    "duration": 2.48
  },
  {
    "id": 24,
    "text": "第二步深入神庙内部，剖析老船夫与翠翠等人性美的具体内涵。",
    "start": 106.48,
    "end": 111.92,
    "duration": 5.44
  },
  {
    "id": 25,
    "text": "第三步说明这种美必须依靠怎样淡泊诗意的散文化形式来传达。",
    "start": 112.24,
    "end": 117.44,
    "duration": 5.2
  },
  {
    "id": 26,
    "text": "第四步探究牧歌背后更深沉的哲学命题，",
    "start": 117.44,
    "end": 120.72,
    "duration": 3.28
  },
  {
    "id": 27,
    "text": "即宿命悲凉与现代性批判。",
    "start": 120.72,
    "end": 123.36,
    "duration": 2.64
  },
  {
    "id": 28,
    "text": "第五步完成宏观历史论证闭环。",
    "start": 123.36,
    "end": 125.92,
    "duration": 2.56
  },
  {
    "id": 29,
    "text": "二、各板块逐句咬合演练。",
    "start": 125.92,
    "end": 128.16,
    "duration": 2.24
  },
  {
    "id": 30,
    "text": "一、开头破题段内部咬合。",
    "start": 128.16,
    "end": 130.32,
    "duration": 2.16
  },
  {
    "id": 31,
    "text": "本段旨在开门见山确立诗意乡土巅峰的立论基石。",
    "start": 130.64,
    "end": 134.96,
    "duration": 4.32
  },
  {
    "id": 32,
    "text": "首句直切经典地位，次句交代供奉人性的神庙，",
    "start": 134.96,
    "end": 139.2,
    "duration": 4.24
  },
  {
    "id": 33,
    "text": "末句开启文体范式。",
    "start": 139.2,
    "end": 140.96,
    "duration": 1.76
  },
  {
    "id": 34,
    "text": "-首先，首句必须直接亮出该作在现代小说史上的崇高地位，",
    "start": 141.168,
    "end": 146.177,
    "duration": 5.009
  },
  {
    "id": 35,
    "text": "具体表述到答题语句就是：沈从文所著中篇小说《边城》是中国现代文学史上诗意乡土小说的巅峰之作，",
    "start": 146.177,
    "end": 154.942,
    "duration": 8.765
  },
  {
    "id": 36,
    "text": "也是京派文学追求纯正审美品格的最高代表。",
    "start": 154.942,
    "end": 158.907,
    "duration": 3.965
  },
  {
    "id": 37,
    "text": "有了经典定性之后，次句必须迅速说明其建构人性神庙的核心动机，",
    "start": 158.907,
    "end": 164.751,
    "duration": 5.844
  },
  {
    "id": 38,
    "text": "具体表述到答题语句就是：沈从文在远离现代工业都市喧嚣的湘西茶峒，",
    "start": 164.751,
    "end": 171.011,
    "duration": 6.26
  },
  {
    "id": 39,
    "text": "以虔诚的心灵建构起一座供奉“人性”的神庙。",
    "start": 171.011,
    "end": 174.768,
    "duration": 3.757
  },
  {
    "id": 40,
    "text": "-随后，末句干脆利落地揭示抒情化与风俗化的文体贡献，",
    "start": 174.768,
    "end": 179.402,
    "duration": 4.634
  },
  {
    "id": 41,
    "text": "具体表述到答题语句就是：小说以澄澈温润的散文笔调，",
    "start": 179.402,
    "end": 184.035,
    "duration": 4.633
  },
  {
    "id": 42,
    "text": "将自然山水、古朴民风与至纯人性融铸一炉，",
    "start": 184.035,
    "end": 187.661,
    "duration": 3.626
  },
  {
    "id": 43,
    "text": "开创了现代小说抒情化与风俗化并茂的崭新文体范式。",
    "start": 187.661,
    "end": 192.295,
    "duration": 4.634
  },
  {
    "id": 44,
    "text": "沈从文所著中篇小说《边城》是中国现代文学史上诗意乡土小说的巅峰之作，",
    "start": 192.295,
    "end": 198.54,
    "duration": 6.245
  },
  {
    "id": 45,
    "text": "也是京派文学追求纯正审美品格的最高代表。",
    "start": 198.54,
    "end": 202.368,
    "duration": 3.828
  },
  {
    "id": 46,
    "text": "沈从文在远离现代工业都市喧嚣的湘西茶峒，",
    "start": 202.528,
    "end": 206.448,
    "duration": 3.92
  },
  {
    "id": 47,
    "text": "以虔诚的心灵建构起一座供奉“人性”的神庙。",
    "start": 206.448,
    "end": 209.968,
    "duration": 3.52
  },
  {
    "id": 48,
    "text": "小说以澄澈温润的散文笔调，将自然山水、",
    "start": 209.968,
    "end": 213.808,
    "duration": 3.84
  },
  {
    "id": 49,
    "text": "古朴民风与至纯人性融铸一炉，开创了现代小说抒情化与风俗化并茂的崭新文体范式。",
    "start": 213.808,
    "end": 221.408,
    "duration": 7.6
  },
  {
    "id": 50,
    "text": "二、第一维度：“优美、健康、自然”之人性美建构内部咬合。",
    "start": 221.408,
    "end": 226.208,
    "duration": 4.8
  },
  {
    "id": 51,
    "text": "本段任务是深入剖析茶峒社会的至善至美，",
    "start": 226.528,
    "end": 230.368,
    "duration": 3.84
  },
  {
    "id": 52,
    "text": "落实老船夫、翠翠、天保挪送三人的人性细节。",
    "start": 230.368,
    "end": 234.768,
    "duration": 4.4
  },
  {
    "id": 53,
    "text": "首先，段首给出结论先行的分论点，",
    "start": 234.768,
    "end": 237.488,
    "duration": 2.72
  },
  {
    "id": 54,
    "text": "具体表述到答题语句就是：第一，在思想精神与美学品格上，",
    "start": 237.488,
    "end": 242.448,
    "duration": 4.96
  },
  {
    "id": 55,
    "text": "作品旨在重塑一种“优美、健康、自然，",
    "start": 242.448,
    "end": 245.808,
    "duration": 3.36
  },
  {
    "id": 56,
    "text": "而又不悖于人性的人生形式”，构筑了充满至善至美的人性理想殿堂。",
    "start": 245.808,
    "end": 251.008,
    "duration": 5.2
  },
  {
    "id": 57,
    "text": "-随后，剖析湘西未受商业侵蚀的纯净空间机制，",
    "start": 251.248,
    "end": 255.378,
    "duration": 4.13
  },
  {
    "id": 58,
    "text": "具体表述到答题语句就是：沈从文笔下的湘西茶峒，",
    "start": 255.378,
    "end": 259.943,
    "duration": 4.565
  },
  {
    "id": 59,
    "text": "是一个未被现代商业金钱关系与机械文明污染的桃花源式社会。",
    "start": 259.943,
    "end": 265.812,
    "duration": 5.869
  },
  {
    "id": 60,
    "text": "在这一纯净空间中，每个人身上都闪烁着中国传统伦理中最纯真的德性光辉。",
    "start": 265.812,
    "end": 272.768,
    "duration": 6.956
  },
  {
    "id": 61,
    "text": "-紧接着，调取老船夫恪尽职守与深爱孙女的细节：老船夫五十年如一日摆渡于碧溪居，",
    "start": 272.768,
    "end": 280.479,
    "duration": 7.711
  },
  {
    "id": 62,
    "text": "恪尽职守，义不取利，将全部生命的温情倾注于外孙女翠翠身上。",
    "start": 280.479,
    "end": 286.208,
    "duration": 5.729
  },
  {
    "id": 63,
    "text": "-随后，调取翠翠空灵纯洁的生命律动：翠翠依山傍水生长，",
    "start": 286.272,
    "end": 291.208,
    "duration": 4.936
  },
  {
    "id": 64,
    "text": "天真无邪，空灵澄澈，其在渡船上对挪送朦胧爱恋的萌发，",
    "start": 291.208,
    "end": 296.144,
    "duration": 4.936
  },
  {
    "id": 65,
    "text": "完全是生命天性自然的律动。",
    "start": 296.144,
    "end": 298.719,
    "duration": 2.575
  },
  {
    "id": 66,
    "text": "紧接着，调取天保挪送兄弟以歌求爱的古朴道德：天保与挪送两兄弟爱上同一个女子，",
    "start": 298.719,
    "end": 306.23,
    "duration": 7.511
  },
  {
    "id": 67,
    "text": "却摒弃世俗勾心斗角，遵循当地古朴的“走马路”唱歌求爱法则，",
    "start": 306.23,
    "end": 311.595,
    "duration": 5.365
  },
  {
    "id": 68,
    "text": "兄让弟先，重情轻利。",
    "start": 311.595,
    "end": 313.312,
    "duration": 1.717
  },
  {
    "id": 69,
    "text": "-最后，收束提炼该原生态文明的人性底色：这种人与人之间真挚互助、",
    "start": 313.312,
    "end": 319.354,
    "duration": 6.042
  },
  {
    "id": 70,
    "text": "自尊自爱、毫无机巧算计的伦理风貌，",
    "start": 319.354,
    "end": 322.591,
    "duration": 3.237
  },
  {
    "id": 71,
    "text": "展现了中国传统原生态文明中最动人的人性底色。",
    "start": 322.591,
    "end": 327.123,
    "duration": 4.532
  },
  {
    "id": 72,
    "text": "第一，在思想精神与美学品格上，作品旨在重塑一种“优美、",
    "start": 327.123,
    "end": 332.086,
    "duration": 4.963
  },
  {
    "id": 73,
    "text": "健康、自然，而又不悖于人性的人生形式”，",
    "start": 332.086,
    "end": 335.539,
    "duration": 3.453
  },
  {
    "id": 74,
    "text": "构筑了充满至善至美的人性理想殿堂。",
    "start": 335.539,
    "end": 338.992,
    "duration": 3.453
  },
  {
    "id": 75,
    "text": "沈从文笔下的湘西茶峒，是一个未被现代商业金钱关系与机械文明污染的桃花源式社会。",
    "start": 339.152,
    "end": 346.032,
    "duration": 6.88
  },
  {
    "id": 76,
    "text": "在这一纯净空间中，每个人身上都闪烁着中国传统伦理中最纯真的德性光辉。",
    "start": 346.032,
    "end": 352.272,
    "duration": 6.24
  },
  {
    "id": 77,
    "text": "老船夫五十年如一日摆渡于碧溪居，",
    "start": 352.272,
    "end": 355.072,
    "duration": 2.8
  },
  {
    "id": 78,
    "text": "恪尽职守，义不取利，将全部生命的温情倾注于外孙女翠翠身上。",
    "start": 355.072,
    "end": 360.112,
    "duration": 5.04
  },
  {
    "id": 79,
    "text": "翠翠依山傍水生长，天真无邪，空灵澄澈，",
    "start": 360.512,
    "end": 364.592,
    "duration": 4.08
  },
  {
    "id": 80,
    "text": "其在渡船上对挪送朦胧爱恋的萌发，",
    "start": 364.592,
    "end": 367.872,
    "duration": 3.28
  },
  {
    "id": 81,
    "text": "完全是生命天性自然的律动。",
    "start": 367.872,
    "end": 371.072,
    "duration": 3.2
  },
  {
    "id": 82,
    "text": "天保与挪送两兄弟爱上同一个女子，",
    "start": 371.072,
    "end": 374.112,
    "duration": 3.04
  },
  {
    "id": 83,
    "text": "却摒弃世俗勾心斗角，遵循当地古朴的“走马路”唱歌求爱法则，",
    "start": 374.112,
    "end": 379.952,
    "duration": 5.84
  },
  {
    "id": 84,
    "text": "兄让弟先，重情轻利。",
    "start": 379.952,
    "end": 382.032,
    "duration": 2.08
  },
  {
    "id": 85,
    "text": "这种人与人之间真挚互助、自尊自爱、",
    "start": 382.272,
    "end": 385.552,
    "duration": 3.28
  },
  {
    "id": 86,
    "text": "毫无机巧算计的伦理风貌，展现了中国传统原生态文明中最动人的人性底色。",
    "start": 385.552,
    "end": 392.672,
    "duration": 7.12
  },
  {
    "id": 87,
    "text": "三、第二维度：散文化风俗画与抒情小说文体创新内部咬合。",
    "start": 392.672,
    "end": 397.952,
    "duration": 5.28
  },
  {
    "id": 88,
    "text": "本段任务是直击本题第二问，解析弱化冲突、",
    "start": 397.952,
    "end": 401.552,
    "duration": 3.6
  },
  {
    "id": 89,
    "text": "端午风俗画与诗化语言文体。",
    "start": 401.552,
    "end": 403.712,
    "duration": 2.16
  },
  {
    "id": 90,
    "text": "-首先，段首给出统领分论点，具体表述到答题语句就是：第二，",
    "start": 403.872,
    "end": 409.164,
    "duration": 5.292
  },
  {
    "id": 91,
    "text": "在文体建构与小说叙事艺术上，作品打破了传统小说强情节与戏剧化冲突的模式，",
    "start": 409.164,
    "end": 416.662,
    "duration": 7.498
  },
  {
    "id": 92,
    "text": "奠定了散文化、诗意化的现代乡土抒情小说范式。",
    "start": 416.662,
    "end": 421.072,
    "duration": 4.41
  },
  {
    "id": 93,
    "text": "-随后，剖析叙事重心由情节转向风貌风俗的机制，",
    "start": 421.128,
    "end": 425.276,
    "duration": 4.148
  },
  {
    "id": 94,
    "text": "具体表述到答题语句就是：沈从文将小说的叙事重心从紧张的情节推演，",
    "start": 425.276,
    "end": 431.498,
    "duration": 6.222
  },
  {
    "id": 95,
    "text": "转移到如诗如画的环境风物与地方民俗的舒展铺陈上。",
    "start": 431.498,
    "end": 436.269,
    "duration": 4.771
  },
  {
    "id": 96,
    "text": "茶峒的吊脚楼、清澈见底的白河、碧溪居的白塔与渡船，",
    "start": 436.269,
    "end": 440.832,
    "duration": 4.563
  },
  {
    "id": 97,
    "text": "在作者笔下皆具油画般的质感。",
    "start": 440.832,
    "end": 443.528,
    "duration": 2.696
  },
  {
    "id": 98,
    "text": "-紧接着，密集还原端午龙舟盛况与山崖唱歌名场面：小说浓墨重彩地描绘了端午节全城出动赛龙舟、",
    "start": 443.528,
    "end": 452.29,
    "duration": 8.762
  },
  {
    "id": 99,
    "text": "捉鸭子的民俗盛况，以及青年男女月夜在对溪山崖上以歌代言的浪漫风情。",
    "start": 452.29,
    "end": 458.915,
    "duration": 6.625
  },
  {
    "id": 100,
    "text": "最后，总结其诗文融铸的语言风格：全篇行文清丽明澈，",
    "start": 458.915,
    "end": 463.616,
    "duration": 4.701
  },
  {
    "id": 101,
    "text": "平缓从容，语言如山泉般自然流淌，",
    "start": 463.616,
    "end": 466.608,
    "duration": 2.992
  },
  {
    "id": 102,
    "text": "大量运用洗练的白描与富于音乐感的节奏，",
    "start": 466.608,
    "end": 470.455,
    "duration": 3.847
  },
  {
    "id": 103,
    "text": "实现了小说、散文与诗歌美学的深度交融。",
    "start": 470.455,
    "end": 474.088,
    "duration": 3.633
  },
  {
    "id": 104,
    "text": "第二，在文体建构与小说叙事艺术上，",
    "start": 474.168,
    "end": 477.288,
    "duration": 3.12
  },
  {
    "id": 105,
    "text": "作品打破了传统小说强情节与戏剧化冲突的模式，",
    "start": 477.288,
    "end": 481.688,
    "duration": 4.4
  },
  {
    "id": 106,
    "text": "奠定了散文化、诗意化的现代乡土抒情小说范式。",
    "start": 481.688,
    "end": 485.848,
    "duration": 4.16
  },
  {
    "id": 107,
    "text": "沈从文将小说的叙事重心从紧张的情节推演，",
    "start": 485.848,
    "end": 489.528,
    "duration": 3.68
  },
  {
    "id": 108,
    "text": "转移到如诗如画的环境风物与地方民俗的舒展铺陈上。",
    "start": 489.528,
    "end": 493.928,
    "duration": 4.4
  },
  {
    "id": 109,
    "text": "茶峒的吊脚楼、清澈见底的白河、碧溪居的白塔与渡船，",
    "start": 494.248,
    "end": 498.888,
    "duration": 4.64
  },
  {
    "id": 110,
    "text": "在作者笔下皆具油画般的质感。",
    "start": 498.888,
    "end": 501.608,
    "duration": 2.72
  },
  {
    "id": 111,
    "text": "小说浓墨重彩地描绘了端午节全城出动赛龙舟、",
    "start": 501.608,
    "end": 506.008,
    "duration": 4.4
  },
  {
    "id": 112,
    "text": "捉鸭子的民俗盛况，以及青年男女月夜在对溪山崖上以歌代言的浪漫风情。",
    "start": 506.008,
    "end": 512.568,
    "duration": 6.56
  },
  {
    "id": 113,
    "text": "全篇行文清丽明澈，平缓从容，语言如山泉般自然流淌，",
    "start": 512.568,
    "end": 517.528,
    "duration": 4.96
  },
  {
    "id": 114,
    "text": "大量运用洗练的白描与富于音乐感的节奏，",
