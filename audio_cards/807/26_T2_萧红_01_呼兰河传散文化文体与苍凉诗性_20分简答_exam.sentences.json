[
  {
    "id": 1,
    "text": "四十年代初期，",
    "start": 0.0,
    "end": 1.458,
    "duration": 1.458
  },
  {
    "id": 2,
    "text": "身处沦陷孤岛香港的萧红发表长篇自传体小说《呼兰河传》，",
    "start": 1.458,
    "end": 6.469,
    "duration": 5.011
  },
  {
    "id": 3,
    "text": "在现代文学史上开辟了独具地域特色与女性生命体验的“诗化小说”崭新范式。",
    "start": 6.469,
    "end": 13.257,
    "duration": 6.788
  },
  {
    "id": 4,
    "text": "茅盾赞誉其为“一篇叙事诗，一幅多彩的风土画，",
    "start": 13.257,
    "end": 17.586,
    "duration": 4.329
  },
  {
    "id": 5,
    "text": "一串凄婉的歌谣”，其艺术特色主要展现于以下三个方面：",
    "start": 17.586,
    "end": 22.37,
    "duration": 4.784
  },
  {
    "id": 6,
    "text": "第一，解构传统线性叙事，",
    "start": 22.37,
    "end": 24.193,
    "duration": 1.823
  },
  {
    "id": 7,
    "text": "开辟写意从容的童年追忆散文化文体范式。",
    "start": 24.193,
    "end": 29.39,
    "duration": 5.197
  },
  {
    "id": 8,
    "text": "小说彻底打破了以戏剧性冲突与连贯情节为主线的传统章法，",
    "start": 29.39,
    "end": 33.124,
    "duration": 3.734
  },
  {
    "id": 9,
    "text": "借天真儿童的有限视角，将北方边陲呼兰河小镇的风土人情、",
    "start": 33.124,
    "end": 39.166,
    "duration": 6.042
  },
  {
    "id": 10,
    "text": "街道庙会与生老病死娓娓道来。",
    "start": 39.166,
    "end": 43.227,
    "duration": 4.061
  },
  {
    "id": 11,
    "text": "作者以散文般的自由笔触，",
    "start": 43.227,
    "end": 44.688,
    "duration": 1.461
  },
  {
    "id": 12,
    "text": "将全书结构为互不贯通又在精神上深层咬合的风俗图景，",
    "start": 44.688,
    "end": 50.766,
    "duration": 6.078
  },
  {
    "id": 13,
    "text": "创造了一种兼具史传实感与散文风致的现代文体结构。",
    "start": 50.766,
    "end": 53.968,
    "duration": 3.202
  },
  {
    "id": 14,
    "text": "第二，并置童年暖意与生存严酷，呈现冰火交织的复杂心理张力。",
    "start": 53.968,
    "end": 59.891,
    "duration": 5.923
  },
  {
    "id": 15,
    "text": "小说一边以极其澄澈深情的笔墨，",
    "start": 59.891,
    "end": 65.153,
    "duration": 5.262
  },
  {
    "id": 16,
    "text": "描绘祖父的后花园里黄瓜长了随便吃、",
    "start": 65.153,
    "end": 66.717,
    "duration": 1.564
  },
  {
    "id": 17,
    "text": "蜻蜓飞来任凭飞的纯真与自由，赋予生命以唯一的温暖抚慰；",
    "start": 66.717,
    "end": 72.784,
    "duration": 6.067
  },
  {
    "id": 18,
    "text": "另一边却以冷峻的笔调展现严冬里冰封大地的大泥坑、",
    "start": 72.784,
    "end": 76.231,
    "duration": 3.447
  },
  {
    "id": 19,
    "text": "冻裂的房瓦与乡民麻木迟钝的生存荒原，",
    "start": 76.231,
    "end": 81.16,
    "duration": 4.929
  },
  {
    "id": 20,
    "text": "在极温情与极荒凉的强烈对照中，传达出沉重的人生叹息。",
    "start": 81.16,
    "end": 84.185,
    "duration": 3.025
  },
  {
    "id": 21,
    "text": "第三，直面国民愚昧与封建吃人，展现看客狂欢下的深刻生存悲凉。",
    "start": 84.185,
    "end": 89.899,
    "duration": 5.714
  },
  {
    "id": 22,
    "text": "萧红以超越常人的敏锐洞察力，刻画了小团圆媳妇的惨绝悲剧。",
    "start": 89.899,
    "end": 95.788,
    "duration": 5.889
  },
  {
    "id": 23,
    "text": "一个活泼健壮的十二岁小姑娘，",
    "start": 95.788,
    "end": 98.575,
    "duration": 2.787
  },
  {
    "id": 24,
    "text": "仅仅因为不合封建妇德便遭婆婆长期毒打折磨；",
    "start": 98.575,
    "end": 104.986,
    "duration": 6.411
  },
  {
    "id": 25,
    "text": "在乡邻围观起哄的集体狂欢中，",
    "start": 104.986,
    "end": 106.905,
    "duration": 1.919
  },
  {
    "id": 26,
    "text": "被三次脱光衣服强行按入沸水热汤中“洗澡治病”，",
    "start": 106.905,
    "end": 111.349,
    "duration": 4.444
  },
  {
    "id": 27,
    "text": "最终昏死夭折。",
    "start": 111.349,
    "end": 112.513,
    "duration": 1.164
  },
  {
    "id": 28,
    "text": "人们在施暴与看热闹中展现出的麻木不仁，",
    "start": 112.513,
    "end": 117.091,
    "duration": 4.578
  },
  {
    "id": 29,
    "text": "将中国乡土社会集体无意识的冷酷与荒诞撕裂得令人窒息。",
    "start": 117.091,
    "end": 121.584,
    "duration": 4.493
  }
]