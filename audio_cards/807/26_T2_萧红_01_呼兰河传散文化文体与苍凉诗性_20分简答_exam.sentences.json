[
  {
    "id": 1,
    "text": "四十年代初，旅居香港的萧红写出长篇自传体小说《呼兰河传》，",
    "start": 0.134,
    "end": 5.066,
    "duration": 4.932
  },
  {
    "id": 2,
    "text": "在现代文学史上开辟了独具地域气息与女性生命体验的“诗化小说”路径。",
    "start": 5.69,
    "end": 11.222,
    "duration": 5.532
  },
  {
    "id": 3,
    "text": "茅盾赞誉其为“一篇叙事诗，一幅多彩的风土画，一串凄婉的歌谣”，",
    "start": 11.9,
    "end": 13.992,
    "duration": 2.092
  },
  {
    "id": 4,
    "text": "其艺术特色主要展现于以下三个方面：",
    "start": 14.371,
    "end": 15.823,
    "duration": 1.452
  },
  {
    "id": 5,
    "text": "第一，突破传统线性叙事，开辟写意从容的散文化文体范式。",
    "start": 16.501,
    "end": 25.553,
    "duration": 9.052
  },
  {
    "id": 6,
    "text": "小说打破了以戏剧性冲突和连贯情节为主线的传统章法，借天真儿童的有限视角，",
    "start": 26.271,
    "end": 32.443,
    "duration": 6.172
  },
  {
    "id": 7,
    "text": "将北方边陲呼兰河小镇的风土人情、街道庙会与生老病死娓娓道来。",
    "start": 32.822,
    "end": 38.314,
    "duration": 5.492
  },
  {
    "id": 8,
    "text": "作者以散文般的自由笔调，将全书结构为相对独立又在精神上互相呼应的风俗图景，",
    "start": 38.992,
    "end": 45.684,
    "duration": 6.692
  },
  {
    "id": 9,
    "text": "创造出兼具风土实感与诗意韵致的散文化结构。",
    "start": 46.063,
    "end": 49.995,
    "duration": 3.932
  },
  {
    "id": 10,
    "text": "第二，并置童年暖意与生存严酷，呈现温情与荒凉交织的情感张力。",
    "start": 50.673,
    "end": 55.645,
    "duration": 4.972
  },
  {
    "id": 11,
    "text": "小说一边以澄澈深情的笔墨，描绘祖父后花园里黄瓜长了随便吃、蜻蜓飞来任凭飞的纯真自由，赋予童年以温暖抚慰；",
    "start": 56.283,
    "end": 65.655,
    "duration": 9.372
  },
  {
    "id": 12,
    "text": "另一边却以冷峻笔调展现盛夏大泥坑吞没牲畜、严冬冻裂房瓦与乡民麻木生存的沉重画面，",
    "start": 66.413,
    "end": 73.985,
    "duration": 7.572
  },
  {
    "id": 13,
    "text": "在温情与荒凉的强烈对照中，传达出绵长的人生叹息。",
    "start": 74.364,
    "end": 78.446,
    "duration": 4.082
  },
  {
    "id": 14,
    "text": "第三，直面国民愚昧与封建麻木，揭示看客围观下的生存悲凉。",
    "start": 79.124,
    "end": 84.256,
    "duration": 5.132
  },
  {
    "id": 15,
    "text": "萧红以敏锐细腻的感受力刻画了小团圆媳妇的悲剧：",
    "start": 84.934,
    "end": 95.186,
    "duration": 10.252
  },
  {
    "id": 16,
    "text": "一个健壮活泼的十二岁女孩，仅因不合乡俗妇德便遭婆婆长期毒打折磨；",
    "start": 95.864,
    "end": 99.336,
    "duration": 3.472
  },
  {
    "id": 17,
    "text": "在乡邻围观起哄下，三次被按入滚烫热水中“洗澡治病”，屡次昏厥数日后悲惨夭折。",
    "start": 99.865,
    "end": 103.277,
    "duration": 3.412
  },
  {
    "id": 18,
    "text": "人们在施暴与围观中显露出的麻木冷漠，",
    "start": 103.955,
    "end": 106.847,
    "duration": 2.892
  },
  {
    "id": 19,
    "text": "将乡土社会陈腐习惯与集体无意识的残酷揭示得触目惊心。",
    "start": 107.226,
    "end": 112.118,
    "duration": 4.892
  }
]