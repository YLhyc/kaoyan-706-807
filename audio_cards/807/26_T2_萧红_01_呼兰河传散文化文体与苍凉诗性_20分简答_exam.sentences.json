[
  {
    "id": 1,
    "text": "四十年代初期，",
    "start": 0.16,
    "end": 1.52,
    "duration": 1.36
  },
  {
    "id": 2,
    "text": "身处沦陷孤岛香港的萧红发表长篇自传体小说《呼兰河传》，",
    "start": 1.52,
    "end": 6.16,
    "duration": 4.64
  },
  {
    "id": 3,
    "text": "在现代文学史上开辟了独具地域特色与女性生命体验的“诗化小说”崭新范式。",
    "start": 6.4,
    "end": 13.2,
    "duration": 6.8
  },
  {
    "id": 4,
    "text": "茅盾赞誉其为“一篇叙事诗，一幅多彩的风土画，",
    "start": 13.2,
    "end": 17.84,
    "duration": 4.64
  },
  {
    "id": 5,
    "text": "一串凄婉的歌谣”，其艺术特色主要展现于以下三个方面：",
    "start": 17.84,
    "end": 22.88,
    "duration": 5.04
  },
  {
    "id": 6,
    "text": "第一，解构传统线性叙事，",
    "start": 22.88,
    "end": 25.44,
    "duration": 2.56
  },
  {
    "id": 7,
    "text": "开辟写意从容的童年追忆散文化文体范式。",
    "start": 25.52,
    "end": 29.44,
    "duration": 3.92
  },
  {
    "id": 8,
    "text": "小说彻底打破了以戏剧性冲突与连贯情节为主线的传统章法，",
    "start": 29.44,
    "end": 34.64,
    "duration": 5.2
  },
  {
    "id": 9,
    "text": "借天真儿童的有限视角，将北方边陲呼兰河小镇的风土人情、",
    "start": 34.64,
    "end": 40.48,
    "duration": 5.84
  },
  {
    "id": 10,
    "text": "街道庙会与生老病死娓娓道来。",
    "start": 40.48,
    "end": 43.36,
    "duration": 2.88
  },
  {
    "id": 11,
    "text": "作者以散文般的自由笔触，",
    "start": 43.36,
    "end": 45.92,
    "duration": 2.56
  },
  {
    "id": 12,
    "text": "将全书结构为互不贯通又在精神上深层咬合的风俗图景，",
    "start": 45.92,
    "end": 51.2,
    "duration": 5.28
  },
  {
    "id": 13,
    "text": "创造了一种兼具史传实感与散文风致的现代文体结构。",
    "start": 51.2,
    "end": 57.28,
    "duration": 6.08
  },
  {
    "id": 14,
    "text": "第二，并置童年暖意与生存严酷，呈现冰火交织的复杂心理张力。",
    "start": 57.28,
    "end": 63.92,
    "duration": 6.64
  },
  {
    "id": 15,
    "text": "小说一边以极其澄澈深情的笔墨，",
    "start": 63.92,
    "end": 67.2,
    "duration": 3.28
  },
  {
    "id": 16,
    "text": "描绘祖父的后花园里黄瓜长了随便吃、",
    "start": 67.2,
    "end": 71.28,
    "duration": 4.08
  },
  {
    "id": 17,
    "text": "蜻蜓飞来任凭飞的纯真与自由，赋予生命以唯一的温暖抚慰；",
    "start": 71.28,
    "end": 77.28,
    "duration": 6.0
  },
  {
    "id": 18,
    "text": "另一边却以冷峻的笔调展现严冬里冰封大地的大泥坑、",
    "start": 77.28,
    "end": 82.56,
    "duration": 5.28
  },
  {
    "id": 19,
    "text": "冻裂的房瓦与乡民麻木迟钝的生存荒原，",
    "start": 82.56,
    "end": 86.24,
    "duration": 3.68
  },
  {
    "id": 20,
    "text": "在极温情与极荒凉的强烈对照中，传达出沉重的人生叹息。",
    "start": 86.48,
    "end": 92.56,
    "duration": 6.08
  },
  {
    "id": 21,
    "text": "第三，直面国民愚昧与封建吃人，展现看客狂欢下的深刻生存悲凉。",
    "start": 92.56,
    "end": 98.64,
    "duration": 6.08
  },
  {
    "id": 22,
    "text": "萧红以超越常人的敏锐洞察力，刻画了小团圆媳妇的惨绝悲剧。",
    "start": 98.64,
    "end": 103.92,
    "duration": 5.28
  },
  {
    "id": 23,
    "text": "一个活泼健壮的十二岁小姑娘，",
    "start": 103.92,
    "end": 107.2,
    "duration": 3.28
  },
  {
    "id": 24,
    "text": "仅仅因为不合封建妇德便遭婆婆长期毒打折磨；",
    "start": 107.2,
    "end": 111.68,
    "duration": 4.48
  },
  {
    "id": 25,
    "text": "在乡邻围观起哄的集体狂欢中，",
    "start": 111.68,
    "end": 114.8,
    "duration": 3.12
  },
  {
    "id": 26,
    "text": "被三次脱光衣服强行按入沸水热汤中“洗澡治病”，",
    "start": 114.8,
    "end": 118.88,
    "duration": 4.08
  },
  {
    "id": 27,
    "text": "最终昏死夭折。",
    "start": 118.88,
    "end": 120.08,
    "duration": 1.2
  },
  {
    "id": 28,
    "text": "人们在施暴与看热闹中展现出的麻木不仁，",
    "start": 120.24,
    "end": 121.28,
    "duration": 1.04
  },
  {
    "id": 29,
    "text": "将中国乡土社会集体无意识的冷酷与荒诞撕裂得令人窒息。",
    "start": 121.12,
    "end": 121.28,
    "duration": 0.16
  }
]