[
  {
    "id": 1,
    "text": "四十年代初期，",
    "start": 0.05,
    "end": 1.454,
    "duration": 1.404
  },
  {
    "id": 2,
    "text": "身处沦陷孤岛香港的萧红发表长篇自传体小说《呼兰河传》，",
    "start": 1.454,
    "end": 6.439,
    "duration": 4.985
  },
  {
    "id": 3,
    "text": "在现代文学史上开辟了独具地域特色与女性生命体验的“诗化小说”崭新范式。",
    "start": 6.439,
    "end": 13.227,
    "duration": 6.788
  },
  {
    "id": 4,
    "text": "茅盾赞誉其为“一篇叙事诗，一幅多彩的风土画，",
    "start": 13.227,
    "end": 17.556,
    "duration": 4.329
  },
  {
    "id": 5,
    "text": "一串凄婉的歌谣”，其艺术特色主要展现于以下三个方面：",
    "start": 17.556,
    "end": 22.34,
    "duration": 4.784
  },
  {
    "id": 6,
    "text": "第一，解构传统线性叙事，",
    "start": 22.34,
    "end": 24.163,
    "duration": 1.823
  },
  {
    "id": 7,
    "text": "开辟写意从容的童年追忆散文化文体范式。",
    "start": 24.163,
    "end": 27.906,
    "duration": 3.743
  },
  {
    "id": 8,
    "text": "小说彻底打破了以戏剧性冲突与连贯情节为主线的传统章法，",
    "start": 27.906,
    "end": 33.094,
    "duration": 5.188
  },
  {
    "id": 9,
    "text": "借天真儿童的有限视角，将北方边陲呼兰河小镇的风土人情、",
    "start": 33.094,
    "end": 39.137,
    "duration": 6.043
  },
  {
    "id": 10,
    "text": "街道庙会与生老病死娓娓道来。",
    "start": 39.137,
    "end": 43.199,
    "duration": 4.062
  },
  {
    "id": 11,
    "text": "作者以散文般的自由笔触，",
    "start": 43.199,
    "end": 45.429,
    "duration": 2.23
  },
  {
    "id": 12,
    "text": "将全书结构为互不贯通又在精神上深层咬合的风俗图景，",
    "start": 45.429,
    "end": 50.737,
    "duration": 5.308
  },
  {
    "id": 13,
    "text": "创造了一种兼具史传实感与散文风致的现代文体结构。",
    "start": 50.737,
    "end": 55.274,
    "duration": 4.537
  },
  {
    "id": 14,
    "text": "第二，并置童年暖意与生存严酷，呈现冰火交织的复杂心理张力。",
    "start": 55.274,
    "end": 60.015,
    "duration": 4.741
  },
  {
    "id": 15,
    "text": "小说一边以极其澄澈深情的笔墨，",
    "start": 60.015,
    "end": 63.01,
    "duration": 2.995
  },
  {
    "id": 16,
    "text": "描绘祖父的后花园里黄瓜长了随便吃、",
    "start": 63.01,
    "end": 66.688,
    "duration": 3.678
  },
  {
    "id": 17,
    "text": "蜻蜓飞来任凭飞的纯真与自由，赋予生命以唯一的温暖抚慰；",
    "start": 66.688,
    "end": 72.754,
    "duration": 6.066
  },
  {
    "id": 18,
    "text": "另一边却以冷峻的笔调展现严冬里冰封大地的大泥坑、",
    "start": 72.754,
    "end": 76.936,
    "duration": 4.182
  },
  {
    "id": 19,
    "text": "冻裂的房瓦与乡民麻木迟钝的生存荒原，",
    "start": 76.936,
    "end": 81.13,
    "duration": 4.194
  },
  {
    "id": 20,
    "text": "在极温情与极荒凉的强烈对照中，传达出沉重的人生叹息。",
    "start": 81.13,
    "end": 86.509,
    "duration": 5.379
  },
  {
    "id": 21,
    "text": "第三，直面国民愚昧与封建吃人，展现看客狂欢下的深刻生存悲凉。",
    "start": 86.509,
    "end": 91.419,
    "duration": 4.91
  },
  {
    "id": 22,
    "text": "萧红以超越常人的敏锐洞察力，刻画了小团圆媳妇的惨绝悲剧。",
    "start": 91.419,
    "end": 96.716,
    "duration": 5.297
  },
  {
    "id": 23,
    "text": "一个活泼健壮的十二岁小姑娘，",
    "start": 96.716,
    "end": 100.835,
    "duration": 4.119
  },
  {
    "id": 24,
    "text": "仅仅因为不合封建妇德便遭婆婆长期毒打折磨；",
    "start": 100.835,
    "end": 105.126,
    "duration": 4.291
  },
  {
    "id": 25,
    "text": "在乡邻围观起哄的集体狂欢中，",
    "start": 105.126,
    "end": 108.08,
    "duration": 2.954
  },
  {
    "id": 26,
    "text": "被三次脱光衣服强行按入沸水热汤中“洗澡治病”，",
    "start": 108.08,
    "end": 112.483,
    "duration": 4.403
  },
  {
    "id": 27,
    "text": "最终昏死夭折。",
    "start": 112.483,
    "end": 113.951,
    "duration": 1.468
  },
  {
    "id": 28,
    "text": "人们在施暴与看热闹中展现出的麻木不仁，",
    "start": 113.951,
    "end": 117.224,
    "duration": 3.273
  },
  {
    "id": 29,
    "text": "将中国乡土社会集体无意识的冷酷与荒诞撕裂得令人窒息。",
    "start": 117.224,
    "end": 121.584,
    "duration": 4.36
  }
]