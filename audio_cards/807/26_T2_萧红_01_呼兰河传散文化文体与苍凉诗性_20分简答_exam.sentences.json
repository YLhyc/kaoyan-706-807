[
  {
    "id": 1,
    "text": "四十年代初，旅居香港的萧红写出长篇自传体小说《呼兰河传》，在现代文学史上开辟了独具地域气息与女性生命体验的“诗化小说”路径。",
    "start": 0.106,
    "end": 10.937,
    "duration": 10.831
  },
  {
    "id": 2,
    "text": "茅盾赞誉其为“一篇叙事诗，一幅多彩的风土画，一串凄婉的歌谣”，",
    "start": 11.424,
    "end": 16.666,
    "duration": 5.242
  },
  {
    "id": 3,
    "text": "其艺术特色主要展现于以下三个方面：",
    "start": 17.015,
    "end": 19.48,
    "duration": 2.465
  },
  {
    "id": 4,
    "text": "第一，突破传统线性叙事，开辟写意从容的散文化文体范式。",
    "start": 20.081,
    "end": 25.417,
    "duration": 5.336
  },
  {
    "id": 5,
    "text": "小说打破了以戏剧性冲突和连贯情节为主线的传统章法，借天真儿童的有限视角，",
    "start": 25.659,
    "end": 32.202,
    "duration": 6.543
  },
  {
    "id": 6,
    "text": "将北方边陲呼兰河小镇的风土人情、街道庙会与生老病死娓娓道来。",
    "start": 32.447,
    "end": 37.541,
    "duration": 5.094
  },
  {
    "id": 7,
    "text": "作者以散文般的自由笔调，将全书结构为相对独立又在精神上互相呼应的风俗图景，",
    "start": 37.697,
    "end": 44.258,
    "duration": 6.561
  },
  {
    "id": 8,
    "text": "创造出兼具风土实感与诗意韵致的散文化结构。",
    "start": 44.691,
    "end": 48.892,
    "duration": 4.201
  },
  {
    "id": 9,
    "text": "第二，并置童年暖意与生存严酷，呈现温情与荒凉交织的情感张力。",
    "start": 49.498,
    "end": 55.499,
    "duration": 6.001
  },
  {
    "id": 10,
    "text": "小说一边以澄澈深情的笔墨，",
    "start": 56.035,
    "end": 58.275,
    "duration": 2.24
  },
  {
    "id": 11,
    "text": "描绘祖父后花园里黄瓜长了随便吃、蜻蜓飞来任凭飞的纯真自由，赋予童年以温暖抚慰；",
    "start": 58.575,
    "end": 66.23,
    "duration": 7.655
  },
  {
    "id": 12,
    "text": "另一边却以冷峻笔调展现严冬大泥坑吞没牲畜、冻裂房瓦与乡民麻木生存的沉重画面，",
    "start": 66.597,
    "end": 73.959,
    "duration": 7.362
  },
  {
    "id": 13,
    "text": "在温情与荒凉的强烈对照中，传达出绵长的人生叹息。",
    "start": 74.373,
    "end": 79.073,
    "duration": 4.7
  },
  {
    "id": 14,
    "text": "第三，直面国民愚昧与封建麻木，揭示看客围观下的生存悲凉。",
    "start": 79.728,
    "end": 85.036,
    "duration": 5.308
  },
  {
    "id": 15,
    "text": "萧红以敏锐细腻的感受力刻画了小团圆媳妇的悲剧：",
    "start": 85.719,
    "end": 89.643,
    "duration": 3.924
  },
  {
    "id": 16,
    "text": "一个健壮活泼的十二岁女孩，仅因不合乡俗妇德便遭婆婆长期毒打折磨；",
    "start": 90.145,
    "end": 95.975,
    "duration": 5.83
  },
  {
    "id": 17,
    "text": "在乡邻围观起哄下，三次被按入滚烫热水中“洗澡治病”，最终昏死夭折。",
    "start": 96.49,
    "end": 102.787,
    "duration": 6.297
  },
  {
    "id": 18,
    "text": "人们在施暴与围观中显露出的麻木冷漠，",
    "start": 103.085,
    "end": 105.962,
    "duration": 2.877
  },
  {
    "id": 19,
    "text": "将乡土社会陈腐习惯与集体无意识的残酷揭示得触目惊心。",
    "start": 106.421,
    "end": 111.412,
    "duration": 4.991
  }
]