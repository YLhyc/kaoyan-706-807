[
  {
    "id": 1,
    "text": "一、宏观结构推演与采分点映射。",
    "start": 0.08,
    "end": 3.2,
    "duration": 3.12
  },
  {
    "id": 2,
    "text": "本题标准分为、三十、分（或、四十、",
    "start": 3.2,
    "end": 5.44,
    "duration": 2.24
  },
  {
    "id": 3,
    "text": "分综合大题），论述结构采用高分“总论破题定位，",
    "start": 5.44,
    "end": 9.68,
    "duration": 4.24
  },
  {
    "id": 4,
    "text": "四大历史阶段梯次演进，历史哲学收束”逻辑模型：一、",
    "start": 9.68,
    "end": 14.08,
    "duration": 4.4
  },
  {
    "id": 5,
    "text": "破题总论层（约一百五十字）：界定知识分子作为心灵晴雨表的定位。",
    "start": 14.08,
    "end": 19.04,
    "duration": 4.96
  },
  {
    "id": 6,
    "text": "概括三段论式演变脉络（启蒙英雄、",
    "start": 19.28,
    "end": 22.32,
    "duration": 3.04
  },
  {
    "id": 7,
    "text": "趋近于、动摇被改造者、趋近于、内省反思者）。",
    "start": 22.32,
    "end": 26.56,
    "duration": 4.24
  },
  {
    "id": 8,
    "text": "二、第一阶段：五四觉醒与幻灭（鲁迅、",
    "start": 26.56,
    "end": 29.84,
    "duration": 3.28
  },
  {
    "id": 9,
    "text": "郁达夫）：采分点为民主自由觉醒、",
    "start": 29.84,
    "end": 32.64,
    "duration": 2.8
  },
  {
    "id": 10,
    "text": "经济现实碾碎、个人情欲与国家屈辱纠缠（《伤逝》《沉沦》）。",
    "start": 32.64,
    "end": 37.6,
    "duration": 4.96
  },
  {
    "id": 11,
    "text": "三、第二阶段：三四十年代动摇与依附（茅盾、",
    "start": 37.6,
    "end": 41.44,
    "duration": 3.84
  },
  {
    "id": 12,
    "text": "巴金）：采分点为阶级搏杀、告别象牙塔、",
    "start": 41.44,
    "end": 44.8,
    "duration": 3.36
  },
  {
    "id": 13,
    "text": "动摇与软弱、平民知识分子的生存碾碎（《蚀》《寒夜》）。",
    "start": 44.8,
    "end": 48.56,
    "duration": 3.76
  },
  {
    "id": 14,
    "text": "四、第三阶段：十七年思想改造与规训（杨匠、",
    "start": 48.72,
    "end": 52.96,
    "duration": 4.24
  },
  {
    "id": 15,
    "text": "宗璞）：采分点为原罪忏悔、思想洗澡、",
    "start": 52.96,
    "end": 57.04,
    "duration": 4.08
  },
  {
    "id": 16,
    "text": "个人情欲割舍、融入工农集体（《洗澡》《红豆》）。",
    "start": 57.04,
    "end": 61.04,
    "duration": 4.0
  },
  {
    "id": 17,
    "text": "五、第四阶段：新时期反思与围城困境（张贤亮、",
    "start": 61.04,
    "end": 66.0,
    "duration": 4.96
  },
  {
    "id": 18,
    "text": "钱终书）：采分点为苦难反思与精神阉割（《男人的一半是女人》）、",
    "start": 66.0,
    "end": 72.0,
    "duration": 6.0
  },
  {
    "id": 19,
    "text": "现代生存荒谬与软弱围城（《围城》）。",
    "start": 72.0,
    "end": 74.72,
    "duration": 2.72
  },
  {
    "id": 20,
    "text": "六、总结提升层（约一百五十字）：文学史哲学评价、",
    "start": 74.8,
    "end": 79.6,
    "duration": 4.8
  },
  {
    "id": 21,
    "text": "世纪精神跋涉、启蒙与尊严追求的历史光辉。",
    "start": 79.6,
    "end": 83.6,
    "duration": 4.0
  },
  {
    "id": 22,
    "text": "二、逐段内部咬合与考场得分句推导。",
    "start": 83.6,
    "end": 87.2,
    "duration": 3.6
  },
  {
    "id": 23,
    "text": "破题段：历史定位与流变总纲。",
    "start": 87.2,
    "end": 90.24,
    "duration": 3.04
  },
  {
    "id": 24,
    "text": "论证推演逻辑：从知识分子与中国现代化的共生关系切入。",
    "start": 90.24,
    "end": 94.96,
    "duration": 4.72
  },
  {
    "id": 25,
    "text": "提出其形象演变是一部现代心灵史。",
    "start": 95.28,
    "end": 98.8,
    "duration": 3.52
  },
  {
    "id": 26,
    "text": "提炼四个时期的精神形态跳跃，直接带出四段论述。",
    "start": 98.8,
    "end": 103.2,
    "duration": 4.4
  },
  {
    "id": 27,
    "text": "具体表述到答题语句就是：知识分子作为现代思想的启蒙者与社会变革的探路先锋，",
    "start": 103.2,
    "end": 110.72,
    "duration": 7.52
  },
  {
    "id": 28,
    "text": "其精神演变构成了中国现代文学最敏锐的心灵晴雨表。",
    "start": 110.72,
    "end": 115.6,
    "duration": 4.88
  },
  {
    "id": 29,
    "text": "从五四时期的个性觉醒与孤独彷徨，",
    "start": 115.92,
    "end": 118.96,
    "duration": 3.04
  },
  {
    "id": 30,
    "text": "到三四十年代的革命依附与阶级改造，",
    "start": 118.96,
    "end": 122.32,
    "duration": 3.36
  },
  {
    "id": 31,
    "text": "再到沦陷区及新时期的存在困境与反思救赎，",
    "start": 122.32,
    "end": 126.8,
    "duration": 4.48
  },
  {
    "id": 32,
    "text": "知识分子形象经历了由“觉醒的启蒙英雄”向“软弱的动摇者与被改造者”，",
    "start": 126.8,
    "end": 133.28,
    "duration": 6.48
  },
  {
    "id": 33,
    "text": "再向“内省的荒谬承受者”的深刻演进。",
    "start": 133.28,
    "end": 136.24,
    "duration": 2.96
  },
  {
    "id": 34,
    "text": "这一百年流变主要体现在四个核心历史阶段。",
    "start": 136.48,
    "end": 140.08,
    "duration": 3.6
  },
  {
    "id": 35,
    "text": "知识分子作为现代思想的启蒙者与社会变革的探路先锋，",
    "start": 140.384,
    "end": 144.624,
    "duration": 4.24
  },
  {
    "id": 36,
    "text": "其精神演变构成了中国现代文学最敏锐的心灵晴雨表。",
    "start": 144.624,
    "end": 149.184,
    "duration": 4.56
  },
  {
    "id": 37,
    "text": "从五四时期的个性觉醒与孤独彷徨，",
    "start": 149.184,
    "end": 152.224,
    "duration": 3.04
  },
  {
    "id": 38,
    "text": "到三四十年代的革命依附与阶级改造，",
    "start": 152.224,
    "end": 155.424,
    "duration": 3.2
  },
  {
    "id": 39,
    "text": "再到沦陷区及新时期的存在困境与反思救赎，",
    "start": 155.424,
    "end": 159.344,
    "duration": 3.92
  },
  {
    "id": 40,
    "text": "知识分子形象经历了由“觉醒的启蒙英雄”向“软弱的动摇者与被改造者”，",
    "start": 159.344,
    "end": 165.184,
    "duration": 5.84
  },
  {
    "id": 41,
    "text": "再向“内省的荒谬承受者”的深刻演进。",
    "start": 165.184,
    "end": 167.904,
    "duration": 2.72
  },
  {
    "id": 42,
    "text": "这一百年流变主要体现在四个核心历史阶段。",
    "start": 168.224,
    "end": 171.664,
    "duration": 3.44
  },
  {
    "id": 43,
    "text": "第一阶段：五四觉醒、孤独与绝望（鲁迅《伤逝》、",
    "start": 171.664,
    "end": 176.064,
    "duration": 4.4
  },
  {
    "id": 44,
    "text": "郁达夫《沉沦》）。",
    "start": 176.064,
    "end": 177.424,
    "duration": 1.36
  },
  {
    "id": 45,
    "text": "论证推演逻辑：五四开篇。",
    "start": 177.424,
    "end": 179.824,
    "duration": 2.4
  },
  {
    "id": 46,
    "text": "启蒙带来个性解放，但缺少物质基础与社会支撑。",
    "start": 179.824,
    "end": 184.064,
    "duration": 4.24
  },
  {
    "id": 47,
    "text": "结合鲁迅《伤逝》中涓生子君的爱情悲剧，",
    "start": 184.064,
    "end": 187.424,
    "duration": 3.36
  },
  {
    "id": 48,
    "text": "以及郁达夫《沉沦》零余者的身心苦闷，",
    "start": 187.424,
    "end": 190.624,
    "duration": 3.2
  },
  {
    "id": 49,
    "text": "阐述早产儿般的痛苦阵痛。",
    "start": 190.624,
    "end": 192.624,
    "duration": 2.0
  },
  {
    "id": 50,
    "text": "-具体表述到答题语句就是：第一，",
    "start": 192.784,
    "end": 195.429,
    "duration": 2.645
  },
  {
    "id": 51,
    "text": "五四时期的个性觉醒与绝望抗争的精神探索。",
    "start": 195.429,
    "end": 199.295,
    "duration": 3.866
  },
  {
    "id": 52,
    "text": "五四运动打破了封建宗法的千古沉寂。",
    "start": 199.295,
    "end": 202.551,
    "duration": 3.256
  },
  {
    "id": 53,
    "text": "知识分子率先觉醒为追求民主自由的启蒙主体。",
    "start": 202.551,
    "end": 206.621,
    "duration": 4.07
  },
  {
    "id": 54,
    "text": "但面对深重坚固的旧势力，他们陷入了深刻的孤独与幻灭。",
    "start": 206.621,
    "end": 211.504,
    "duration": 4.883
  },
  {
    "id": 55,
    "text": "鲁迅在《伤逝》中塑造了子君与涓生。",
    "start": 211.584,
    "end": 214.784,
    "duration": 3.2
  },
  {
    "id": 56,
    "text": "他们虽勇敢冲出封建包办家庭建立同居新生活，",
    "start": 214.784,
    "end": 219.264,
    "duration": 4.48
  },
  {
    "id": 57,
    "text": "却在琐屑残酷的经济压迫下被彻底碾碎。",
    "start": 219.264,
    "end": 222.544,
    "duration": 3.28
  },
  {
    "id": 58,
    "text": "涓生的忏悔展现了现代个体在失去精神依傍后的绝望。",
    "start": 222.544,
    "end": 227.584,
    "duration": 5.04
  },
  {
    "id": 59,
    "text": "郁达夫在《沉沦》中描摹了留日青年病态的感伤忧郁。",
    "start": 227.584,
    "end": 231.904,
    "duration": 4.32
  },
  {
    "id": 60,
    "text": "个人的性苦闷与弱国子民的屈辱深层纠缠。",
    "start": 232.144,
    "end": 235.984,
    "duration": 3.84
  },
  {
    "id": 61,
    "text": "五四时期的知识分子在炽烈觉醒中承受着早产儿般的精神阵痛。",
    "start": 235.984,
    "end": 240.864,
    "duration": 4.88
  },
  {
    "id": 62,
    "text": "第一，五四时期的个性觉醒与绝望抗争的精神探索。",
    "start": 240.864,
    "end": 245.344,
    "duration": 4.48
  },
  {
    "id": 63,
    "text": "五四运动打破了封建宗法的千古沉寂。",
    "start": 245.344,
    "end": 248.224,
    "duration": 2.88
  },
  {
    "id": 64,
    "text": "知识分子率先觉醒为追求民主自由的启蒙主体。",
    "start": 248.224,
    "end": 251.824,
    "duration": 3.6
  },
  {
    "id": 65,
    "text": "但面对深重坚固的旧势力，他们陷入了深刻的孤独与幻灭。",
    "start": 252.064,
    "end": 256.624,
    "duration": 4.56
  },
  {
    "id": 66,
    "text": "鲁迅在《伤逝》中塑造了子君与涓生。",
    "start": 256.624,
    "end": 260.144,
    "duration": 3.52
  },
  {
    "id": 67,
    "text": "他们虽勇敢冲出封建包办家庭建立同居新生活，",
    "start": 260.144,
    "end": 264.144,
    "duration": 4.0
  },
  {
    "id": 68,
    "text": "却在琐屑残酷的经济压迫下被彻底碾碎。",
    "start": 264.144,
    "end": 267.424,
    "duration": 3.28
  },
  {
    "id": 69,
    "text": "涓生的忏悔展现了现代个体在失去精神依傍后的绝望。",
    "start": 267.424,
    "end": 271.744,
    "duration": 4.32
  },
  {
    "id": 70,
    "text": "郁达夫在《沉沦》中描摹了留日青年病态的感伤忧郁。",
    "start": 271.984,
    "end": 276.624,
    "duration": 4.64
  },
  {
    "id": 71,
    "text": "个人的性苦闷与弱国子民的屈辱深层纠缠。",
    "start": 276.624,
    "end": 280.704,
    "duration": 4.08
  },
  {
    "id": 72,
    "text": "五四时期的知识分子在炽烈觉醒中承受着早产儿般的精神阵痛。",
    "start": 280.704,
    "end": 286.064,
    "duration": 5.36
  },
  {
    "id": 73,
    "text": "第二阶段：三四十年代动摇与依附（茅盾《蚀》、",
    "start": 286.352,
    "end": 290.374,
    "duration": 4.022
  },
  {
    "id": 74,
    "text": "巴金《寒夜》）。",
    "start": 290.374,
    "end": 291.218,
    "duration": 0.844
  },
  {
    "id": 75,
    "text": "论证推演逻辑：进入战争与革命年代。",
    "start": 291.218,
    "end": 294.384,
    "duration": 3.166
  },
  {
    "id": 76,
    "text": "单纯的个性解放失效，知识分子必须依附于阶级与救亡。",
    "start": 294.384,
    "end": 299.239,
    "duration": 4.855
  },
  {
    "id": 77,
    "text": "以茅盾《蚀》中动摇分子方罗兰，以及巴金《寒夜》中病弱无力的汪文宣为例，",
    "start": 299.239,
    "end": 305.36,
    "duration": 6.121
  },
  {
    "id": 78,
    "text": "揭示他们在政治风暴与残酷现实下的动摇与毁灭。",
    "start": 305.36,
    "end": 309.792,
    "duration": 4.432
  },
  {
    "id": 79,
    "text": "-具体表述到答题语句就是：第二，",
    "start": 309.792,
    "end": 312.496,
    "duration": 2.704
  },
  {
    "id": 80,
    "text": "三四十年代在大裂变中的动摇彷徨与革命依附。",
    "start": 312.496,
    "end": 316.656,
    "duration": 4.16
  },
  {
    "id": 81,
    "text": "随着大革命失败与抗日战争爆发，知识分子被迫直面残酷的阶级搏杀与救亡风暴。",
    "start": 316.656,
    "end": 323.728,
    "duration": 7.072
  },
  {
    "id": 82,
    "text": "他们不得不告别纯粹个人的象牙塔，",
    "start": 323.728,
    "end": 326.848,
    "duration": 3.12
  },
  {
    "id": 83,
    "text": "寻求阶级意识形态的政治依附。",
    "start": 326.848,
    "end": 329.552,
    "duration": 2.704
  },
  {
    "id": 84,
    "text": "茅盾在《蚀》三部曲中塑造了方罗兰等动摇者。",
    "start": 329.632,
    "end": 333.392,
    "duration": 3.76
  },
  {
    "id": 85,
    "text": "他们在革命狂热与小资产阶级软弱性之间剧烈摇摆。",
    "start": 333.392,
    "end": 337.632,
    "duration": 4.24
  },
  {
    "id": 86,
    "text": "巴金在《寒夜》中塑造了汪文宣。",
    "start": 337.632,
    "end": 340.352,
    "duration": 2.72
  },
  {
    "id": 87,
    "text": "这位曾经怀抱教育救国理想的小知识分子，",
    "start": 340.352,
    "end": 343.712,
    "duration": 3.36
  },
  {
    "id": 88,
    "text": "在战时通胀与家庭婆媳矛盾中吐血死去。",
    "start": 343.712,
    "end": 347.232,
    "duration": 3.52
  },
  {
    "id": 89,
    "text": "其悲剧揭示了平民知识分子在动荡社会重压下被彻底碾碎的凄惨宿命。",
    "start": 347.232,
    "end": 352.992,
    "duration": 5.76
  },
  {
    "id": 90,
    "text": "第二，三四十年代在大裂变中的动摇彷徨与革命依附。",
    "start": 353.232,
    "end": 358.432,
    "duration": 5.2
  },
  {
    "id": 91,
    "text": "随着大革命失败与抗日战争爆发，知识分子被迫直面残酷的阶级搏杀与救亡风暴。",
    "start": 358.432,
    "end": 365.632,
    "duration": 7.2
  },
  {
    "id": 92,
    "text": "他们不得不告别纯粹个人的象牙塔，",
    "start": 365.632,
    "end": 368.352,
    "duration": 2.72
  },
  {
    "id": 93,
    "text": "寻求阶级意识形态的政治依附。",
    "start": 368.352,
    "end": 370.992,
    "duration": 2.64
  },
  {
    "id": 94,
    "text": "茅盾在《蚀》三部曲中塑造了方罗兰等动摇者。",
    "start": 370.992,
    "end": 374.272,
    "duration": 3.28
  },
  {
    "id": 95,
    "text": "他们在革命狂热与小资产阶级软弱性之间剧烈摇摆。",
    "start": 374.512,
    "end": 379.152,
    "duration": 4.64
  },
  {
    "id": 96,
    "text": "巴金在《寒夜》中塑造了汪文宣。",
    "start": 379.152,
    "end": 381.632,
    "duration": 2.48
  },
  {
    "id": 97,
    "text": "这位曾经怀抱教育救国理想的小知识分子，",
    "start": 381.632,
    "end": 385.152,
    "duration": 3.52
  },
  {
    "id": 98,
    "text": "在战时通胀与家庭婆媳矛盾中吐血死去。",
    "start": 385.152,
    "end": 388.912,
    "duration": 3.76
  },
  {
    "id": 99,
    "text": "其悲剧揭示了平民知识分子在动荡社会重压下被彻底碾碎的凄惨宿命。",
    "start": 388.912,
    "end": 394.512,
    "duration": 5.6
  },
  {
    "id": 100,
    "text": "第三阶段：十七年思想规训与自我否定（杨匠、",
    "start": 394.752,
    "end": 398.352,
    "duration": 3.6
  },
  {
    "id": 101,
    "text": "宗璞）。",
    "start": 398.352,
    "end": 398.832,
    "duration": 0.48
  },
  {
    "id": 102,
    "text": "论证推演逻辑：社会主义改造时期。",
    "start": 398.832,
    "end": 401.392,
    "duration": 2.56
  },
  {
    "id": 103,
    "text": "知识分子不再是教师，而是小学生。",
    "start": 401.392,
    "end": 403.952,
    "duration": 2.56
  },
  {
    "id": 104,
    "text": "引用杨匠《洗澡》的思想脱胎换骨，",
    "start": 403.952,
    "end": 406.272,
    "duration": 2.32
  },
  {
    "id": 105,
    "text": "以及宗璞《红豆》江玫割舍个人情爱投奔革命，",
    "start": 406.272,
    "end": 409.712,
    "duration": 3.44
  },
  {
    "id": 106,
    "text": "阐释其通过否定小资产阶级自我以融入集体。",
    "start": 409.712,
    "end": 412.992,
    "duration": 3.28
  },
  {
    "id": 107,
    "text": "具体表述到答题语句就是：第三，十七年时期的政治规训与知识分子的阶级脱胎换骨。",
    "start": 412.992,
    "end": 420.416,
    "duration": 7.424
  },
  {
    "id": 108,
    "text": "新中国成立后，知识分子被纳入无产阶级思想改造的宏大工程中。",
    "start": 420.416,
    "end": 425.376,
    "duration": 4.96
  },
  {
    "id": 109,
    "text": "他们从旧社会的审视者，转变为必须深刻忏悔小资产阶级原罪的被改造对象。",
    "start": 425.376,
    "end": 431.776,
    "duration": 6.4
  },
  {
    "id": 110,
    "text": "杨匠在《洗澡》中描摹了解放初期知识分子在思想改造运动中的复杂心态。",
    "start": 431.776,
    "end": 437.296,
    "duration": 5.52
  },
  {
    "id": 111,
    "text": "而在主流红色经典中，宗璞的《红豆》展现了女大学生江玫在资产阶级个人情爱与无产阶级革命召唤之间的决绝抉择。",
    "start": 437.616,
    "end": 447.216,
    "duration": 9.6
  },
  {
    "id": 112,
    "text": "知识分子只有否定自我、融入工农集体，",
    "start": 447.216,
    "end": 450.496,
    "duration": 3.28
  },
  {
    "id": 113,
    "text": "才能获得新时代的合法身份。",
    "start": 450.496,
    "end": 452.736,
    "duration": 2.24
  },
  {
    "id": 114,
    "text": "第三，十七年时期的政治规训与知识分子的阶级脱胎换骨。",
    "start": 452.736,
    "end": 457.456,
    "duration": 4.72
  },
  {
    "id": 115,
    "text": "新中国成立后，知识分子被纳入无产阶级思想改造的宏大工程中。",
    "start": 457.856,
    "end": 462.896,
    "duration": 5.04
  },
  {
    "id": 116,
    "text": "他们从旧社会的审视者，转变为必须深刻忏悔小资产阶级原罪的被改造对象。",
    "start": 462.896,
    "end": 468.896,
    "duration": 6.0
  },
  {
    "id": 117,
    "text": "杨匠在《洗澡》中描摹了解放初期知识分子在思想改造运动中的复杂心态。",
    "start": 468.896,
    "end": 474.816,
    "duration": 5.92
  },
  {
    "id": 118,
    "text": "而在主流红色经典中，宗璞的《红豆》展现了女大学生江玫在资产阶级个人情爱与无产阶级革命召唤之间的决绝抉择。",
    "start": 474.816,
    "end": 484.176,
    "duration": 9.36
  },
  {
    "id": 119,
    "text": "知识分子只有否定自我、融入工农集体，",
    "start": 484.416,
    "end": 487.536,
    "duration": 3.12
  },
  {
    "id": 120,
    "text": "才能获得新时代的合法身份。",
    "start": 487.536,
    "end": 489.856,
    "duration": 2.32
  },
  {
    "id": 121,
    "text": "第四阶段：新时期苦难反思与围城困局（张贤亮、",
    "start": 489.856,
    "end": 494.176,
    "duration": 4.32
  },
  {
    "id": 122,
    "text": "钱终书）。",
    "start": 494.176,
    "end": 495.136,
    "duration": 0.96
  },
  {
    "id": 123,
    "text": "论证推演逻辑：新时期超越了简单的控诉。",
    "start": 495.136,
    "end": 498.896,
    "duration": 3.76
  },
  {
    "id": 124,
    "text": "一方面以张贤亮《男人的一半是女人》反思历史对人性的阉割，",
    "start": 498.896,
    "end": 503.616,
    "duration": 4.72
  },
  {
    "id": 125,
    "text": "另一方面以钱终书《围城》方鸿渐反思现代人普遍的虚无与软弱，",
    "start": 503.616,
    "end": 509.216,
    "duration": 5.6
  },
  {
    "id": 126,
    "text": "将题目升华至深层哲学反思高度。",
    "start": 509.216,
    "end": 511.776,
    "duration": 2.56
  },
  {
    "id": 127,
    "text": "-具体表述到答题语句就是：第四，",
    "start": 511.936,
    "end": 514.777,
    "duration": 2.841
  },
  {
    "id": 128,
    "text": "新时期以来的苦难反思与现代生存困局审视。",
    "start": 514.777,
    "end": 518.93,
    "duration": 4.153
  },
  {
    "id": 129,
    "text": "新时期文学以批判理性重新审视知识分子的历史遭遇。",
    "start": 518.93,
    "end": 523.957,
    "duration": 5.027
  },
  {
    "id": 130,
    "text": "张贤亮在《男人的一半是女人》中塑造了章永临。",
    "start": 523.957,
    "end": 528.109,
    "duration": 4.152
  },
  {
    "id": 131,
    "text": "作家逼视劳改苦难对知识分子肉体与灵魂的深度阉割。",
    "start": 528.109,
    "end": 533.136,
    "duration": 5.027
  },
  {
    "id": 132,
    "text": "同时，钱终书《围城》的经典价值在新时期被重新发现。",
    "start": 533.216,
    "end": 538.336,
    "duration": 5.12
  },
  {
    "id": 133,
    "text": "方鸿渐在学界与婚姻双重围城中的进退维谷，",
    "start": 538.336,
    "end": 542.336,
    "duration": 4.0
  },
  {
    "id": 134,
    "text": "揭示了知识分子普遍的虚无与平庸。",
    "start": 542.336,
    "end": 545.536,
    "duration": 3.2
  },
  {
    "id": 135,
    "text": "文学从单纯的政治受难控诉，深化为对知识分子人格软弱与现代荒谬生存境遇的深层哲理反思。",
    "start": 545.536,
    "end": 553.856,
    "duration": 8.32
  },
  {
    "id": 136,
    "text": "第四，新时期以来的苦难反思与现代生存困局审视。",
    "start": 554.24,
    "end": 559.52,
    "duration": 5.28
  },
  {
    "id": 137,
    "text": "新时期文学以批判理性重新审视知识分子的历史遭遇。",
    "start": 559.52,
    "end": 564.4,
    "duration": 4.88
  },
  {
    "id": 138,
    "text": "张贤亮在《男人的一半是女人》中塑造了章永临。",
    "start": 564.4,
    "end": 568.48,
    "duration": 4.08
  },
  {
    "id": 139,
    "text": "作家逼视劳改苦难对知识分子肉体与灵魂的深度阉割。",
    "start": 568.48,
    "end": 572.96,
    "duration": 4.48
  },
  {
    "id": 140,
    "text": "同时，钱终书《围城》的经典价值在新时期被重新发现。",
    "start": 572.96,
    "end": 577.12,
    "duration": 4.16
  },
  {
    "id": 141,
    "text": "方鸿渐在学界与婚姻双重围城中的进退维谷，",
    "start": 577.36,
    "end": 581.6,
    "duration": 4.24
  },
  {
    "id": 142,
    "text": "揭示了知识分子普遍的虚无与平庸。",
    "start": 581.6,
    "end": 584.88,
    "duration": 3.28
  },
  {
    "id": 143,
    "text": "文学从单纯的政治受难控诉，深化为对知识分子人格软弱与现代荒谬生存境遇的深层哲理反思。",
    "start": 584.88,
    "end": 593.04,
    "duration": 8.16
  },
  {
    "id": 144,
    "text": "总结升华段：文学史与精神尊严定位。",
    "start": 593.04,
    "end": 596.4,
    "duration": 3.36
  },
  {
    "id": 145,
    "text": "论证推演逻辑：总结提升。",
    "start": 596.4,
    "end": 598.72,
    "duration": 2.32
  },
  {
    "id": 146,
    "text": "指出形象演变的本质是一代代知识分子在狂澜中寻求精神安顿的历程，",
    "start": 598.72,
    "end": 604.72,
    "duration": 6.0
  },
  {
    "id": 147,
    "text": "高度概括其追寻真理的永恒价值。",
    "start": 604.72,
    "end": 607.76,
    "duration": 3.04
  },
  {
    "id": 148,
    "text": "具体表述到答题语句就是：现当代文学中知识分子形象的演变，",
    "start": 607.76,
    "end": 612.96,
    "duration": 5.2
  },
  {
    "id": 149,
    "text": "生动记录了中国现代精英在理想启蒙、",
    "start": 612.96,
    "end": 616.56,
    "duration": 3.6
  },
  {
    "id": 150,
    "text": "政治规训与存在虚无之间的世纪跋涉。",
    "start": 616.56,
    "end": 619.52,
    "duration": 2.96
  },
  {
    "id": 151,
    "text": "这一艺术长廊不仅展示了知识分子的人性弱点与历史局限，",
    "start": 619.76,
    "end": 624.48,
    "duration": 4.72
  },
  {
    "id": 152,
    "text": "更彰显了他们执着追寻真理与精神尊严的永恒光芒。",
    "start": 624.48,
    "end": 629.067,
    "duration": 4.587
  },
  {
    "id": 153,
    "text": "现当代文学中知识分子形象的演变，",
    "start": 629.067,
    "end": 632.267,
    "duration": 3.2
  },
  {
    "id": 154,
    "text": "生动记录了中国现代精英在理想启蒙、",
    "start": 632.267,
    "end": 635.68,
    "duration": 3.413
  },
  {
    "id": 155,
    "text": "政治规训与存在虚无之间的世纪跋涉。",
    "start": 635.68,
    "end": 639.093,
    "duration": 3.413
  },
  {
    "id": 156,
    "text": "这一艺术长廊不仅展示了知识分子的人性弱点与历史局限，",
    "start": 639.093,
    "end": 644.427,
    "duration": 5.334
  },
  {
    "id": 157,
    "text": "更彰显了他们执着追寻真理与精神尊严的永恒光芒。",
    "start": 644.427,
    "end": 649.12,
    "duration": 4.693
  }
]