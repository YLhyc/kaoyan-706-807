[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "九叶诗派·现实与现代性追求的综合诗学",
    "start": 0.134,
    "end": 3.727,
    "duration": 3.593
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "现实历史感（穆旦《赞美》《森林之魅》）+ 现代派智性沉思（杜运燮/郑敏/穆旦《诗八首》）= 破除“口号宣传 vs 脱离生活纯形式”二元对立，",
    "start": 4.303,
    "end": 17.427,
    "duration": 13.124
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "完成“新诗现代化”综合诗学。",
    "start": 17.74,
    "end": 20.122,
    "duration": 2.382
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "四十年代后期，西南联大（穆旦、郑敏、杜运燮、袁可嘉）与上海诗人（辛笛、杭约赫、陈敬容、唐祈、唐湜）合流成“九叶诗派”（时称“中国新诗派”），创“综合诗学”。",
    "start": 20.709,
    "end": 35.708,
    "duration": 14.999
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 融民族苦难体验、坚守历史介入品格",
    "start": 36.295,
    "end": 40.083,
    "duration": 3.788
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "八十年代初出版《九叶集》得名；战时拒绝逃避现实唯美倾向；",
    "start": 40.67,
    "end": 47.127,
    "duration": 6.457
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "穆旦《赞美》写北方原野背负重担农夫，《森林之魅》写滇缅丛林悲歌，歌颂忍辱抗争生机，具历史悲剧感。",
    "start": 47.714,
    "end": 58.403,
    "duration": 10.689
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 借鉴西方现代诗艺、立“智性诗学”",
    "start": 58.977,
    "end": 62.791,
    "duration": 3.814
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "受艾略特、奥登、里尔克启发，主张感性体验与理性思辨结合；",
    "start": 63.378,
    "end": 69.51,
    "duration": 6.132
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "杜运燮《秋》以机智反讽消解滥觞感伤；郑敏哲学冥想生命；穆旦《诗八首》剖现代灵魂撕裂困境，潜入潜意识。",
    "start": 70.097,
    "end": 81.45,
    "duration": 11.353
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 克服二元对立、探索“新诗现代化”综合路",
    "start": 82.024,
    "end": 86.216,
    "duration": 4.192
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "既警惕沦为政治口号附庸，又排斥脱离生活的形式游戏；",
    "start": 86.803,
    "end": 91.971,
    "duration": 5.168
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "借多维意象叠加、象征跳跃与戏剧化独白锤炼出兼顾内在骨力与张力的诗语，奠基现代新诗成熟标杆。",
    "start": 92.558,
    "end": 103.104,
    "duration": 10.546
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：四十年代后期（当时称“中国新诗派”，80年代合集《九叶集》出版得名）；",
    "start": 103.691,
    "end": 110.33,
    "duration": 6.64
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "9位核心诗人：穆旦、郑敏、杜运燮、袁可嘉、辛笛、杭约赫、陈敬容、唐祈、唐湜；穆旦名篇《赞美》《诗八首》。",
    "start": 110.67,
    "end": 121.867,
    "duration": 11.197
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背出九叶诗派西南联大 4 人与上海 5 人共九位核心诗人名单？",
    "start": 122.488,
    "end": 129.414,
    "duration": 6.926
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合穆旦《赞美》《森林之魅》《诗八首》与杜运燮《秋》论证“现实历史感 + 智性现代性”？",
    "start": 129.988,
    "end": 138.75,
    "duration": 8.762
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 说明“综合诗学”对解决三十年代以来左翼标语化与唯美孤立化对立的里程碑意义？",
    "start": 139.337,
    "end": 147.605,
    "duration": 8.267
  }
]