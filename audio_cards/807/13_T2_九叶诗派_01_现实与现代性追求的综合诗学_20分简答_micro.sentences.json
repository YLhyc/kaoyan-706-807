[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "九叶诗派·现实与现代性追求的综合诗学",
    "start": 0.354,
    "end": 3.806,
    "duration": 3.452
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "现实历史感（穆旦《赞美》《森林之魅》）+ 现代派智性沉思（杜运燮/郑敏/穆旦《诗八首》）= 破除“口号宣传 vs 脱离生活纯形式”二元对立，",
    "start": 4.854,
    "end": 17.666,
    "duration": 12.812
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "完成“新诗现代化”综合诗学。",
    "start": 18.054,
    "end": 19.986,
    "duration": 1.932
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "四十年代后期，西南联大（穆旦、郑敏、杜运燮、袁可嘉）与上海诗人（辛笛、杭约赫、陈敬容、唐祈、唐湜）合流成“九叶诗派”（时称“中国新诗派”），创“综合诗学”。",
    "start": 20.994,
    "end": 35.246,
    "duration": 14.252
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 融民族苦难体验、坚守历史介入品格",
    "start": 36.214,
    "end": 40.066,
    "duration": 3.852
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "八十年代初出版《九叶集》得名；战时拒绝逃避现实唯美倾向；",
    "start": 41.074,
    "end": 48.626,
    "duration": 7.552
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "穆旦《赞美》写北方原野背负重担农夫，《森林之魅》写滇缅丛林悲歌，歌颂忍辱抗争生机，具历史悲剧感。",
    "start": 49.089,
    "end": 59.701,
    "duration": 10.612
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 借鉴西方现代诗艺、立“智性诗学”",
    "start": 60.629,
    "end": 64.081,
    "duration": 3.452
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "受艾略特、奥登、里尔克启发，主张感性体验与理性思辨结合；",
    "start": 65.129,
    "end": 71.581,
    "duration": 6.452
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "杜运燮《秋》以机智反讽消解滥觞感伤；郑敏哲学冥想生命；穆旦《诗八首》剖现代灵魂撕裂困境，潜入潜意识。",
    "start": 72.669,
    "end": 85.061,
    "duration": 12.392
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 克服二元对立、探索“新诗现代化”综合路",
    "start": 86.029,
    "end": 90.521,
    "duration": 4.492
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "既警惕沦为政治口号附庸，又排斥脱离生活的形式游戏；",
    "start": 91.269,
    "end": 96.721,
    "duration": 5.452
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "借多维意象叠加、象征跳跃与戏剧化独白锤炼出兼顾内在骨力与张力的诗语，奠基现代新诗成熟标杆。",
    "start": 97.729,
    "end": 107.541,
    "duration": 9.812
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：四十年代后期（当时称“中国新诗派”，80年代合集《九叶集》出版得名）；",
    "start": 108.629,
    "end": 114.721,
    "duration": 6.092
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "9位核心诗人：穆旦、郑敏、杜运燮、袁可嘉、辛笛、杭约赫、陈敬容、唐祈、唐湜；穆旦名篇《赞美》《诗八首》。",
    "start": 115.689,
    "end": 126.081,
    "duration": 10.392
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背出九叶诗派西南联大 4 人与上海 5 人共九位核心诗人名单？",
    "start": 126.684,
    "end": 133.976,
    "duration": 7.292
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合穆旦《赞美》《森林之魅》《诗八首》与杜运燮《秋》论证“现实历史感 + 智性现代性”？",
    "start": 134.984,
    "end": 144.436,
    "duration": 9.452
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 说明“综合诗学”对解决三十年代以来左翼标语化与唯美孤立化对立的里程碑意义？",
    "start": 145.444,
    "end": 153.936,
    "duration": 8.492
  }
]