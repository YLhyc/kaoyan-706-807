[
  {
    "id": 1,
    "text": "题型，三十分论述题。",
    "start": 0.08,
    "end": 1.897,
    "duration": 1.817
  },
  {
    "id": 2,
    "text": "分值，三十分。",
    "start": 1.897,
    "end": 3.023,
    "duration": 1.126
  },
  {
    "id": 3,
    "text": "建议考场时间，三十五分钟。",
    "start": 3.023,
    "end": 5.501,
    "duration": 2.478
  },
  {
    "id": 4,
    "text": "目标字数，一千一百五十到一千三百字。",
    "start": 5.501,
    "end": 9.105,
    "duration": 3.604
  },
  {
    "id": 5,
    "text": "答题骨架，史诗定位定性、趋近于、",
    "start": 9.105,
    "end": 12.034,
    "duration": 2.929
  },
  {
    "id": 6,
    "text": "封建宗法制度罪恶解剖与礼教杀人意蕴、",
    "start": 12.034,
    "end": 15.863,
    "duration": 3.829
  },
  {
    "id": 7,
    "text": "趋近于、觉新与觉慧青年群像对比塑造机制、",
    "start": 15.863,
    "end": 19.918,
    "duration": 4.055
  },
  {
    "id": 8,
    "text": "趋近于、激情充溢的抒情笔调与悲剧美学、",
    "start": 19.918,
    "end": 23.747,
    "duration": 3.829
  },
  {
    "id": 9,
    "text": "趋近于、宏观文学史总结。",
    "start": 23.747,
    "end": 26.0,
    "duration": 2.253
  },
  {
    "id": 10,
    "text": "巴金所著的长篇小说《家》是其长篇巨制《激流三部曲》的开篇与代表作，",
    "start": 26.08,
    "end": 31.68,
    "duration": 5.6
  },
  {
    "id": 11,
    "text": "也是中国现代文学史上控诉封建宗法家族制度最强烈的抒情史诗。",
    "start": 31.68,
    "end": 37.36,
    "duration": 5.68
  },
  {
    "id": 12,
    "text": "巴金以自身生活经历为原型，通过成都高公馆这一封建堡垒的瓦解过程，",
    "start": 37.36,
    "end": 43.36,
    "duration": 6.0
  },
  {
    "id": 13,
    "text": "深刻揭露了封建家长专制与陈腐礼教对年轻生命的残酷摧残，",
    "start": 43.36,
    "end": 48.72,
    "duration": 5.36
  },
  {
    "id": 14,
    "text": "热情欧歌了五四新青年的叛逆觉醒，",
    "start": 48.72,
    "end": 51.68,
    "duration": 2.96
  },
  {
    "id": 15,
    "text": "吹响了埋葬封建宗法制度的时代进军号角。",
    "start": 51.68,
    "end": 55.04,
    "duration": 3.36
  },
  {
    "id": 16,
    "text": "第一，在思想意蕴上，作品以冷峻写实的批判力量，",
    "start": 55.28,
    "end": 59.6,
    "duration": 4.32
  },
  {
    "id": 17,
    "text": "深刻解剖了封建宗法制度“礼教杀人”的野蛮血腥与腐朽大家族走向崩溃的历史必然性。",
    "start": 59.6,
    "end": 67.2,
    "duration": 7.6
  },
  {
    "id": 18,
    "text": "高老太爷作为高家最高专制家长，其一人独断的封建权威构成了压制一切人性与生机的庞大黑网。",
    "start": 67.2,
    "end": 75.36,
    "duration": 8.16
  },
  {
    "id": 19,
    "text": "在这个外表“四世同堂”的诗礼簪婴之族内部，",
    "start": 75.68,
    "end": 79.52,
    "duration": 3.84
  },
  {
    "id": 20,
    "text": "不仅充斥着五老爷、四老爷争夺家产的荒淫无耻，",
    "start": 79.52,
    "end": 83.92,
    "duration": 4.4
  },
  {
    "id": 21,
    "text": "更发生了一连串因恪守旧礼教而吞噬纯洁青春的惨剧。",
    "start": 83.92,
    "end": 89.28,
    "duration": 5.36
  },
  {
    "id": 22,
    "text": "纯洁刚烈的丫鬟鸣凤，因不甘被高老太爷强行纳为冯乐山之妾，",
    "start": 89.28,
    "end": 95.12,
    "duration": 5.84
  },
  {
    "id": 23,
    "text": "在绝望中投湖自尽。",
    "start": 95.12,
    "end": 96.8,
    "duration": 1.68
  },
  {
    "id": 24,
    "text": "柔弱温顺的梅表姐，因封建迷信与母亲专制被迫改嫁，",
    "start": 97.2,
    "end": 101.92,
    "duration": 4.72
  },
  {
    "id": 25,
    "text": "在抑郁成疾中吐血而亡。",
    "start": 101.92,
    "end": 104.0,
    "duration": 2.08
  },
  {
    "id": 26,
    "text": "贤良忍让的瑞珏，因高老太爷出殡时的所谓“血光之灾”鬼神迷信，",
    "start": 104.0,
    "end": 109.84,
    "duration": 5.84
  },
  {
    "id": 27,
    "text": "被长辈强行驱逐至城外荒僻阴湿之所分娩，",
    "start": 109.84,
    "end": 113.68,
    "duration": 3.84
  },
  {
    "id": 28,
    "text": "最终惨死于产褥之上。",
    "start": 113.68,
    "end": 115.68,
    "duration": 2.0
  },
  {
    "id": 29,
    "text": "巴金通过这三位青年女性的凄惨毁灭，",
    "start": 115.68,
    "end": 118.72,
    "duration": 3.04
  },
  {
    "id": 30,
    "text": "将封建礼教伪善吃人的争凝面目揭露无遗，",
    "start": 118.72,
    "end": 122.48,
    "duration": 3.76
  },
  {
    "id": 31,
    "text": "有力宣示了旧体制无可挽回的死亡宿命。",
    "start": 122.48,
    "end": 125.76,
    "duration": 3.28
  },
  {
    "id": 32,
    "text": "第二，在人物群像塑造上，作品塑造了鲜明对立的青年知识分子典型，",
    "start": 126.056,
    "end": 131.896,
    "duration": 5.84
  },
  {
    "id": 33,
    "text": "生动呈现出新旧交替时期中国青年在叛逆与妥协之间的灵魂阵痛。",
    "start": 131.896,
    "end": 137.896,
    "duration": 6.0
  },
  {
    "id": 34,
    "text": "巴金最为成功的是创造了觉新与觉慧这对性格截然相反的兄弟典型。",
    "start": 137.896,
    "end": 143.976,
    "duration": 6.08
  },
  {
    "id": 35,
    "text": "长房长孙高觉新是封建制度下“多余人”与自枪者的代表。",
    "start": 143.976,
    "end": 148.376,
    "duration": 4.4
  },
  {
    "id": 36,
    "text": "他深受五四新潮启蒙，深爱着梅表姐，",
    "start": 148.696,
    "end": 152.056,
    "duration": 3.36
  },
  {
    "id": 37,
    "text": "却因家庭责任与长辈意志，奉行“作揖主义”与“无抵抗主义”。",
    "start": 152.056,
    "end": 157.416,
    "duration": 5.36
  },
  {
    "id": 38,
    "text": "他每一次无原则的委曲求全，不仅埋葬了自己的真爱与青春，",
    "start": 157.416,
    "end": 161.976,
    "duration": 4.56
  },
  {
    "id": 39,
    "text": "更为家族腐朽势力递上了杀害鸣凤与瑞珏的刀刃，",
    "start": 161.976,
    "end": 166.216,
    "duration": 4.24
  },
  {
    "id": 40,
    "text": "成为封建礼教的可悲陪葬品与无意识帮凶。",
    "start": 166.216,
    "end": 169.736,
    "duration": 3.52
  },
  {
    "id": 41,
    "text": "而三弟高觉慧则是典型的“五四狂飙青年”与坚定叛逆者。",
    "start": 169.976,
    "end": 175.176,
    "duration": 5.2
  },
  {
    "id": 42,
    "text": "他身上洋溢着火热的革命激情与决绝的抗争意志。",
    "start": 175.176,
    "end": 179.496,
    "duration": 4.32
  },
  {
    "id": 43,
    "text": "他敢于直面指斥长辈的虚伪残酷，敢于砸破捉鬼迷信的迷津，",
    "start": 179.496,
    "end": 184.936,
    "duration": 5.44
  },
  {
    "id": 44,
    "text": "甚至在祖父威严面前寸步不让。",
    "start": 184.936,
    "end": 187.576,
    "duration": 2.64
  },
  {
    "id": 45,
    "text": "在经历了一系列血泪悲剧后，觉慧毅然斩断与封建腐朽家庭的一切血缘羁绊，",
    "start": 187.576,
    "end": 193.816,
    "duration": 6.24
  },
  {
    "id": 46,
    "text": "登舟东下奔向广阔的时代天地，成为中国文学长廊中个性解放与决绝反叛的光辉典型。",
    "start": 193.816,
    "end": 200.856,
    "duration": 7.04
  },
  {
    "id": 47,
    "text": "二弟高觉民则代表了温和理智、坚持自主婚姻的抗争路径，",
    "start": 201.256,
    "end": 206.056,
    "duration": 4.8
  },
  {
    "id": 48,
    "text": "三者共同构成了丰富立体的青年觉醒谱系。",
    "start": 206.056,
    "end": 209.416,
    "duration": 3.36
  },
  {
    "id": 49,
    "text": "第三，在艺术表现机制上，作品将浓烈充沛的抒情笔触融入现实主义家族编年史中，",
    "start": 209.416,
    "end": 215.896,
    "duration": 6.48
  },
  {
    "id": 50,
    "text": "形成了撼动人心的青春抒情史诗风范。",
    "start": 215.896,
    "end": 219.096,
    "duration": 3.2
  },
  {
    "id": 51,
    "text": "巴金曾自白其创作动力是“控诉与控诉”，",
    "start": 219.096,
    "end": 222.696,
    "duration": 3.6
  },
  {
    "id": 52,
    "text": "全书洋溢着炽热而纯真的爱憎情感。",
    "start": 222.696,
    "end": 225.336,
    "duration": 2.64
  },
  {
    "id": 53,
    "text": "小说没有刻意经营繁复的小说技巧，",
    "start": 225.736,
    "end": 228.376,
    "duration": 2.64
  },
  {
    "id": 54,
    "text": "而是以纯粹平实的语言、火山爆发般喷涌的情感波澜，",
    "start": 228.376,
    "end": 233.016,
    "duration": 4.64
  },
  {
    "id": 55,
    "text": "推动情节由压抑走向爆发。",
    "start": 233.016,
    "end": 235.736,
    "duration": 2.72
  },
  {
    "id": 56,
    "text": "高老太爷死后高公馆诸房为分家而撕破脸皮的丑剧，",
    "start": 235.736,
    "end": 240.376,
    "duration": 4.64
  },
  {
    "id": 57,
    "text": "与觉慧出走时黎明江水奔流的明朗意象形成强烈对照，",
    "start": 240.376,
    "end": 245.656,
    "duration": 5.28
  },
  {
    "id": 58,
    "text": "形成了催人奋起的崇高美学品格。",
    "start": 245.656,
    "end": 248.296,
    "duration": 2.64
  },
  {
    "id": 59,
    "text": "综上所述，巴金《家》以血泪控诉撕碎了封建宗法神话，",
    "start": 248.616,
    "end": 253.496,
    "duration": 4.88
  },
  {
    "id": 60,
    "text": "以觉新与觉慧的鲜明对照刻画了青年知识分子觉醒的艰难与必然。",
    "start": 253.496,
    "end": 259.496,
    "duration": 6.0
  },
  {
    "id": 61,
    "text": "它不仅是中国现代文学现实主义与浪漫主义精神熔铸的伟大史诗，",
    "start": 259.496,
    "end": 265.096,
    "duration": 5.6
  },
  {
    "id": 62,
    "text": "更在数代青年走出封建牢笼、追求自由真理的心灵征程中，",
    "start": 265.096,
    "end": 270.056,
    "duration": 4.96
  },
  {
    "id": 63,
    "text": "树立起永不磨灭的灯塔。",
    "start": 270.056,
    "end": 271.976,
    "duration": 1.92
  }
]