[
  {
    "id": 1,
    "start": 0.08,
    "end": 5.68,
    "text": "巴金所著的长篇小说《家》是其长篇巨制《激流三部曲》的开篇与代表作，"
  },
  {
    "id": 2,
    "start": 5.68,
    "end": 11.36,
    "text": "也是中国现代文学史上控诉封建宗法家族制度最强烈的抒情史诗。"
  },
  {
    "id": 3,
    "start": 11.36,
    "end": 17.36,
    "text": "巴金以自身生活经历为原型，通过成都高公馆这一封建堡垒的瓦解过程，"
  },
  {
    "id": 4,
    "start": 17.36,
    "end": 22.72,
    "text": "深刻揭露了封建家长专制与陈腐礼教对年轻生命的残酷摧残，"
  },
  {
    "id": 5,
    "start": 22.72,
    "end": 25.68,
    "text": "热情欧歌了五四新青年的叛逆觉醒，"
  },
  {
    "id": 6,
    "start": 25.68,
    "end": 29.04,
    "text": "吹响了埋葬封建宗法制度的时代进军号角。"
  },
  {
    "id": 7,
    "start": 29.28,
    "end": 33.6,
    "text": "第一，在思想意蕴上，作品以冷峻写实的批判力量，"
  },
  {
    "id": 8,
    "start": 33.6,
    "end": 41.2,
    "text": "深刻解剖了封建宗法制度“礼教杀人”的野蛮血腥与腐朽大家族走向崩溃的历史必然性。"
  },
  {
    "id": 9,
    "start": 41.2,
    "end": 49.36,
    "text": "高老太爷作为高家最高专制家长，其一人独断的封建权威构成了压制一切人性与生机的庞大黑网。"
  },
  {
    "id": 10,
    "start": 49.68,
    "end": 53.52,
    "text": "在这个外表“四世同堂”的诗礼簪婴之族内部，"
  },
  {
    "id": 11,
    "start": 53.52,
    "end": 57.92,
    "text": "不仅充斥着五老爷、四老爷争夺家产的荒淫无耻，"
  },
  {
    "id": 12,
    "start": 57.92,
    "end": 63.28,
    "text": "更发生了一连串因恪守旧礼教而吞噬纯洁青春的惨剧。"
  },
  {
    "id": 13,
    "start": 63.28,
    "end": 69.12,
    "text": "纯洁刚烈的丫鬟鸣凤，因不甘被高老太爷强行纳为冯乐山之妾，"
  },
  {
    "id": 14,
    "start": 69.12,
    "end": 70.8,
    "text": "在绝望中投湖自尽。"
  },
  {
    "id": 15,
    "start": 71.2,
    "end": 75.92,
    "text": "柔弱温顺的梅表姐，因封建迷信与母亲专制被迫改嫁，"
  },
  {
    "id": 16,
    "start": 75.92,
    "end": 78.0,
    "text": "在抑郁成疾中吐血而亡。"
  },
  {
    "id": 17,
    "start": 78.0,
    "end": 83.84,
    "text": "贤良忍让的瑞珏，因高老太爷出殡时的所谓“血光之灾”鬼神迷信，"
  },
  {
    "id": 18,
    "start": 83.84,
    "end": 87.68,
    "text": "被长辈强行驱逐至城外荒僻阴湿之所分娩，"
  },
  {
    "id": 19,
    "start": 87.68,
    "end": 89.68,
    "text": "最终惨死于产褥之上。"
  },
  {
    "id": 20,
    "start": 89.68,
    "end": 92.72,
    "text": "巴金通过这三位青年女性的凄惨毁灭，"
  },
  {
    "id": 21,
    "start": 92.72,
    "end": 96.48,
    "text": "将封建礼教伪善吃人的争凝面目揭露无遗，"
  },
  {
    "id": 22,
    "start": 96.48,
    "end": 99.76,
    "text": "有力宣示了旧体制无可挽回的死亡宿命。"
  },
  {
    "id": 23,
    "start": 100.056,
    "end": 105.896,
    "text": "第二，在人物群像塑造上，作品塑造了鲜明对立的青年知识分子典型，"
  },
  {
    "id": 24,
    "start": 105.896,
    "end": 111.896,
    "text": "生动呈现出新旧交替时期中国青年在叛逆与妥协之间的灵魂阵痛。"
  },
  {
    "id": 25,
    "start": 111.896,
    "end": 117.976,
    "text": "巴金最为成功的是创造了觉新与觉慧这对性格截然相反的兄弟典型。"
  },
  {
    "id": 26,
    "start": 117.976,
    "end": 122.376,
    "text": "长房长孙高觉新是封建制度下“多余人”与自枪者的代表。"
  },
  {
    "id": 27,
    "start": 122.696,
    "end": 126.056,
    "text": "他深受五四新潮启蒙，深爱着梅表姐，"
  },
  {
    "id": 28,
    "start": 126.056,
    "end": 131.416,
    "text": "却因家庭责任与长辈意志，奉行“作揖主义”与“无抵抗主义”。"
  },
  {
    "id": 29,
    "start": 131.416,
    "end": 135.976,
    "text": "他每一次无原则的委曲求全，不仅埋葬了自己的真爱与青春，"
  },
  {
    "id": 30,
    "start": 135.976,
    "end": 140.216,
    "text": "更为家族腐朽势力递上了杀害鸣凤与瑞珏的刀刃，"
  },
  {
    "id": 31,
    "start": 140.216,
    "end": 143.736,
    "text": "成为封建礼教的可悲陪葬品与无意识帮凶。"
  },
  {
    "id": 32,
    "start": 143.976,
    "end": 149.176,
    "text": "而三弟高觉慧则是典型的“五四狂飙青年”与坚定叛逆者。"
  },
  {
    "id": 33,
    "start": 149.176,
    "end": 153.496,
    "text": "他身上洋溢着火热的革命激情与决绝的抗争意志。"
  },
  {
    "id": 34,
    "start": 153.496,
    "end": 158.936,
    "text": "他敢于直面指斥长辈的虚伪残酷，敢于砸破捉鬼迷信的迷津，"
  },
  {
    "id": 35,
    "start": 158.936,
    "end": 161.576,
    "text": "甚至在祖父威严面前寸步不让。"
  },
  {
    "id": 36,
    "start": 161.576,
    "end": 167.816,
    "text": "在经历了一系列血泪悲剧后，觉慧毅然斩断与封建腐朽家庭的一切血缘羁绊，"
  },
  {
    "id": 37,
    "start": 167.816,
    "end": 174.856,
    "text": "登舟东下奔向广阔的时代天地，成为中国文学长廊中个性解放与决绝反叛的光辉典型。"
  },
  {
    "id": 38,
    "start": 175.256,
    "end": 180.056,
    "text": "二弟高觉民则代表了温和理智、坚持自主婚姻的抗争路径，"
  },
  {
    "id": 39,
    "start": 180.056,
    "end": 183.416,
    "text": "三者共同构成了丰富立体的青年觉醒谱系。"
  },
  {
    "id": 40,
    "start": 183.416,
    "end": 189.896,
    "text": "第三，在艺术表现机制上，作品将浓烈充沛的抒情笔触融入现实主义家族编年史中，"
  },
  {
    "id": 41,
    "start": 189.896,
    "end": 193.096,
    "text": "形成了撼动人心的青春抒情史诗风范。"
  },
  {
    "id": 42,
    "start": 193.096,
    "end": 196.696,
    "text": "巴金曾自白其创作动力是“控诉与控诉”，"
  },
  {
    "id": 43,
    "start": 196.696,
    "end": 199.336,
    "text": "全书洋溢着炽热而纯真的爱憎情感。"
  },
  {
    "id": 44,
    "start": 199.736,
    "end": 202.376,
    "text": "小说没有刻意经营繁复的小说技巧，"
  },
  {
    "id": 45,
    "start": 202.376,
    "end": 207.016,
    "text": "而是以纯粹平实的语言、火山爆发般喷涌的情感波澜，"
  },
  {
    "id": 46,
    "start": 207.016,
    "end": 209.736,
    "text": "推动情节由压抑走向爆发。"
  },
  {
    "id": 47,
    "start": 209.736,
    "end": 214.376,
    "text": "高老太爷死后高公馆诸房为分家而撕破脸皮的丑剧，"
  },
  {
    "id": 48,
    "start": 214.376,
    "end": 219.656,
    "text": "与觉慧出走时黎明江水奔流的明朗意象形成强烈对照，"
  },
  {
    "id": 49,
    "start": 219.656,
    "end": 222.296,
    "text": "形成了催人奋起的崇高美学品格。"
  },
  {
    "id": 50,
    "start": 222.616,
    "end": 227.496,
    "text": "综上所述，巴金《家》以血泪控诉撕碎了封建宗法神话，"
  },
  {
    "id": 51,
    "start": 227.496,
    "end": 233.496,
    "text": "以觉新与觉慧的鲜明对照刻画了青年知识分子觉醒的艰难与必然。"
  },
  {
    "id": 52,
    "start": 233.496,
    "end": 239.096,
    "text": "它不仅是中国现代文学现实主义与浪漫主义精神熔铸的伟大史诗，"
  },
  {
    "id": 53,
    "start": 239.096,
    "end": 244.056,
    "text": "更在数代青年走出封建牢笼、追求自由真理的心灵征程中，"
  },
  {
    "id": 54,
    "start": 244.056,
    "end": 245.976,
    "text": "树立起永不磨灭的灯塔。"
  }
]