[
  {
    "id": 1,
    "text": "一、宏观结构推演与采分点映射。",
    "start": 0.16,
    "end": 3.12,
    "duration": 2.96
  },
  {
    "id": 2,
    "text": "本题标准分为三十分，论述结构采用高分“宏观破题定位，",
    "start": 3.12,
    "end": 8.0,
    "duration": 4.88
  },
  {
    "id": 3,
    "text": "四大美学机制支柱，总结提升”逻辑模型：一、",
    "start": 8.0,
    "end": 11.68,
    "duration": 3.68
  },
  {
    "id": 4,
    "text": "破题总论层（约一百五十字）：历史时空定位（四十年代沦陷区上海）、",
    "start": 11.68,
    "end": 17.68,
    "duration": 6.0
  },
  {
    "id": 5,
    "text": "代表作《传奇》、核心美学命题（“苍凉”哲学、",
    "start": 17.68,
    "end": 21.68,
    "duration": 4.0
  },
  {
    "id": 6,
    "text": "古典与现代的交融）。",
    "start": 21.68,
    "end": 23.04,
    "duration": 1.36
  },
  {
    "id": 7,
    "text": "二、第一支柱：叙事视点•市井凡俗与宏大消解：采分点为消解政治救亡叙事、",
    "start": 23.44,
    "end": 30.057,
    "duration": 6.617
  },
  {
    "id": 8,
    "text": "洋场弄堂世俗空间、生存算计与去崇高化（《倾城之恋》）。",
    "start": 30.057,
    "end": 34.544,
    "duration": 4.487
  },
  {
    "id": 9,
    "text": "三、第二支柱：人物塑造•隐秘心理与病态异化：采分点为情欲与金钱异化、",
    "start": 34.544,
    "end": 40.74,
    "duration": 6.196
  },
  {
    "id": 10,
    "text": "病态心理深度、黄金枷锁的自毁与毁人（《金锁记》曹七巧）。",
    "start": 40.74,
    "end": 45.44,
    "duration": 4.7
  },
  {
    "id": 11,
    "text": "四、第三支柱：美学原则•“参差的对照”与末世苍凉：采分点为反对单一悲壮、",
    "start": 45.6,
    "end": 53.2,
    "duration": 7.6
  },
  {
    "id": 12,
    "text": "提倡参差对照、繁华背后的废墟感、",
    "start": 53.2,
    "end": 56.4,
    "duration": 3.2
  },
  {
    "id": 13,
    "text": "生命空无本质。",
    "start": 56.4,
    "end": 57.84,
    "duration": 1.44
  },
  {
    "id": 14,
    "text": "五、第四支柱：语言文体•古典韵味与现代意象化修辞：采分点为白话小说传统与现代心理融合、",
    "start": 57.84,
    "end": 66.8,
    "duration": 8.96
  },
  {
    "id": 15,
    "text": "经典月亮与镜子意象、通感修辞。",
    "start": 66.8,
    "end": 69.76,
    "duration": 2.96
  },
  {
    "id": 16,
    "text": "六、总结提升层（约一百五十字）：文学史独特价值、",
    "start": 70.0,
    "end": 74.24,
    "duration": 4.24
  },
  {
    "id": 17,
    "text": "突破主流模式、心理现实主义的现代高峰。",
    "start": 74.24,
    "end": 77.52,
    "duration": 3.28
  },
  {
    "id": 18,
    "text": "二、逐段内部咬合与考场得分句推导。",
    "start": 77.52,
    "end": 80.72,
    "duration": 3.2
  },
  {
    "id": 19,
    "text": "破题段：时代坐标与苍凉美学定调。",
    "start": 80.72,
    "end": 83.44,
    "duration": 2.72
  },
  {
    "id": 20,
    "text": "论证推演逻辑：先确立张爱玲四十年代沦陷区逆流而上的独创地位。",
    "start": 83.44,
    "end": 88.64,
    "duration": 5.2
  },
  {
    "id": 21,
    "text": "她远离政治颂歌与启蒙教化，扎根都市凡俗。",
    "start": 88.96,
    "end": 92.8,
    "duration": 3.84
  },
  {
    "id": 22,
    "text": "提出代表作《传奇》与核心美学关键词“苍凉”，",
    "start": 92.8,
    "end": 96.4,
    "duration": 3.6
  },
  {
    "id": 23,
    "text": "作为通篇骨干。",
    "start": 96.4,
    "end": 97.68,
    "duration": 1.28
  },
  {
    "id": 24,
    "text": "具体表述到答题语句就是：二十世纪四十年代在沦陷区上海文坛异军突起的张爱玲，",
    "start": 97.68,
    "end": 104.24,
    "duration": 6.56
  },
  {
    "id": 25,
    "text": "是中国现代小说史上极具独创性的文学大家。",
    "start": 104.24,
    "end": 107.76,
    "duration": 3.52
  },
  {
    "id": 26,
    "text": "当主流新文学普遍沉浸于宏大历史救亡与政治阶级叙事时，",
    "start": 108.08,
    "end": 113.04,
    "duration": 4.96
  },
  {
    "id": 27,
    "text": "张爱玲独辟蹊径。",
    "start": 113.04,
    "end": 114.64,
    "duration": 1.6
  },
  {
    "id": 28,
    "text": "她以敏锐绝顶的世俗眼光，深情审视洋场都市中饮食男女的生存挣扎与复杂隐秘心理。",
    "start": 114.64,
    "end": 121.92,
    "duration": 7.28
  },
  {
    "id": 29,
    "text": "她的短篇小说集《传奇》构筑了独特的文学世界。",
    "start": 121.92,
    "end": 125.76,
    "duration": 3.84
  },
  {
    "id": 30,
    "text": "其作品交融了古典文学的雅俗传统与西方现代主义的心理洞察。",
    "start": 125.76,
    "end": 130.48,
    "duration": 4.72
  },
  {
    "id": 31,
    "text": "“苍凉”作为其生命体验与艺术哲学的核心，",
    "start": 130.72,
    "end": 134.277,
    "duration": 3.557
  },
  {
    "id": 32,
    "text": "体现于四个深层维度。",
    "start": 134.277,
    "end": 136.16,
    "duration": 1.883
  },
  {
    "id": 33,
    "text": "二十世纪四十年代在沦陷区上海文坛异军突起的张爱玲，",
    "start": 136.304,
    "end": 140.944,
    "duration": 4.64
  },
  {
    "id": 34,
    "text": "是中国现代小说史上极具独创性的文学大家。",
    "start": 140.944,
    "end": 144.864,
    "duration": 3.92
  },
  {
    "id": 35,
    "text": "当主流新文学普遍沉浸于宏大历史救亡与政治阶级叙事时，",
    "start": 144.864,
    "end": 150.144,
    "duration": 5.28
  },
  {
    "id": 36,
    "text": "张爱玲独辟蹊径。",
    "start": 150.144,
    "end": 151.664,
    "duration": 1.52
  },
  {
    "id": 37,
    "text": "她以敏锐绝顶的世俗眼光，深情审视洋场都市中饮食男女的生存挣扎与复杂隐秘心理。",
    "start": 151.664,
    "end": 158.704,
    "duration": 7.04
  },
  {
    "id": 38,
    "text": "她的短篇小说集《传奇》构筑了独特的文学世界。",
    "start": 158.944,
    "end": 163.024,
    "duration": 4.08
  },
  {
    "id": 39,
    "text": "其作品交融了古典文学的雅俗传统与西方现代主义的心理洞察。",
    "start": 163.024,
    "end": 168.224,
    "duration": 5.2
  },
  {
    "id": 40,
    "text": "“苍凉”作为其生命体验与艺术哲学的核心，",
    "start": 168.224,
    "end": 171.504,
    "duration": 3.28
  },
  {
    "id": 41,
    "text": "体现于四个深层维度。",
    "start": 171.504,
    "end": 173.424,
    "duration": 1.92
  },
  {
    "id": 42,
    "text": "第一支柱：市井凡俗叙事与宏大消解（《倾城之恋》）。",
    "start": 173.424,
    "end": 177.744,
    "duration": 4.32
  },
  {
    "id": 43,
    "text": "-论证推演逻辑：张爱玲小说最显著的题材特征是反宏大叙事。",
    "start": 177.904,
    "end": 183.083,
    "duration": 5.179
  },
  {
    "id": 44,
    "text": "紧扣上海与香港都市空间，分析白流苏与范柳原的婚姻算计。",
    "start": 183.083,
    "end": 188.262,
    "duration": 5.179
  },
  {
    "id": 45,
    "text": "点破其爱情不是英雄主义，而是危机中的各取所需，",
    "start": 188.262,
    "end": 192.612,
    "duration": 4.35
  },
  {
    "id": 46,
    "text": "以此揭示世俗凡人的生命本真。",
    "start": 192.612,
    "end": 195.305,
    "duration": 2.693
  },
  {
    "id": 47,
    "text": "具体表述到答题语句就是：第一，消解宏大叙事与回归凡俗生存博弈。",
    "start": 195.305,
    "end": 201.824,
    "duration": 6.519
  },
  {
    "id": 48,
    "text": "张爱玲摒弃了时代高昂的政治教化与启蒙口号。",
    "start": 201.824,
    "end": 206.224,
    "duration": 4.4
  },
  {
    "id": 49,
    "text": "她将叙事空间牢牢锚定在上海与香港的公寓弄堂。",
    "start": 206.224,
    "end": 210.624,
    "duration": 4.4
  },
  {
    "id": 50,
    "text": "作家专门书写乱世沉浮中卑微凡人的柴米油盐、",
    "start": 210.624,
    "end": 214.944,
    "duration": 4.32
  },
  {
    "id": 51,
    "text": "婚姻交易与利害算计。",
    "start": 214.944,
    "end": 217.104,
    "duration": 2.16
  },
  {
    "id": 52,
    "text": "《倾城之恋》中的白流苏与范柳原，",
    "start": 217.104,
    "end": 219.744,
    "duration": 2.64
  },
  {
    "id": 53,
    "text": "在战火逼近的香港展开了精明的情感博弈。",
    "start": 219.744,
    "end": 223.184,
    "duration": 3.44
  },
  {
    "id": 54,
    "text": "他们的结合不是崇高爱情的凯旋，而是自私男女在城市沦陷瞬间各取所需的安全妥协。",
    "start": 223.424,
    "end": 231.744,
    "duration": 8.32
  },
  {
    "id": 55,
    "text": "张爱玲以近乎冷酷的清醒，撕碎了现代都市爱情的罗曼蒂克面纱。",
    "start": 231.744,
    "end": 237.344,
    "duration": 5.6
  },
  {
    "id": 56,
    "text": "她揭示出普通人在动荡岁月里脆弱自保的生命真相。",
    "start": 237.344,
    "end": 241.904,
    "duration": 4.56
  },
  {
    "id": 57,
    "text": "第一，消解宏大叙事与回归凡俗生存博弈。",
    "start": 241.904,
    "end": 245.984,
    "duration": 4.08
  },
  {
    "id": 58,
    "text": "张爱玲摒弃了时代高昂的政治教化与启蒙口号。",
    "start": 246.064,
    "end": 250.224,
    "duration": 4.16
  },
  {
    "id": 59,
    "text": "她将叙事空间牢牢锚定在上海与香港的公寓弄堂。",
    "start": 250.224,
    "end": 255.104,
    "duration": 4.88
  },
  {
    "id": 60,
    "text": "作家专门书写乱世沉浮中卑微凡人的柴米油盐、",
    "start": 255.104,
    "end": 259.344,
    "duration": 4.24
  },
  {
    "id": 61,
    "text": "婚姻交易与利害算计。",
    "start": 259.344,
    "end": 261.584,
    "duration": 2.24
  },
  {
    "id": 62,
    "text": "《倾城之恋》中的白流苏与范柳原，",
    "start": 261.584,
    "end": 264.144,
    "duration": 2.56
  },
  {
    "id": 63,
    "text": "在战火逼近的香港展开了精明的情感博弈。",
    "start": 264.144,
    "end": 267.584,
    "duration": 3.44
  },
  {
    "id": 64,
    "text": "他们的结合不是崇高爱情的凯旋，而是自私男女在城市沦陷瞬间各取所需的安全妥协。",
    "start": 267.824,
    "end": 275.744,
    "duration": 7.92
  },
  {
    "id": 65,
    "text": "张爱玲以近乎冷酷的清醒，撕碎了现代都市爱情的罗曼蒂克面纱。",
    "start": 275.744,
    "end": 281.264,
    "duration": 5.52
  },
  {
    "id": 66,
    "text": "她揭示出普通人在动荡岁月里脆弱自保的生命真相。",
    "start": 281.264,
    "end": 285.504,
    "duration": 4.24
  },
  {
    "id": 67,
    "text": "第二支柱：深层心理透视与人性异化（《金锁记》）。",
    "start": 285.504,
    "end": 288.757,
    "duration": 3.253
  },
  {
    "id": 68,
    "text": "论证推演逻辑：进入人物内在心理层面。",
    "start": 288.757,
    "end": 291.472,
    "duration": 2.715
  },
  {
    "id": 69,
    "text": "张爱玲受弗洛伊德与传统小说的双重影响。",
    "start": 291.472,
    "end": 294.992,
    "duration": 3.52
  },
  {
    "id": 70,
    "text": "以《金锁记》曹七巧为例，剖析被金钱与情欲扭曲的心灵轨迹。",
    "start": 294.992,
    "end": 300.752,
    "duration": 5.76
  },
  {
    "id": 71,
    "text": "论证曹七巧如何从受害者沦为施害者，",
    "start": 300.752,
    "end": 304.432,
    "duration": 3.68
  },
  {
    "id": 72,
    "text": "展现人性受金钱异化的扭曲轨迹。",
    "start": 304.432,
    "end": 307.392,
    "duration": 2.96
  },
  {
    "id": 73,
    "text": "具体表述到答题语句就是：第二，深层心理透视与病态人性异化机制的揭示。",
    "start": 307.392,
    "end": 314.112,
    "duration": 6.72
  },
  {
    "id": 74,
    "text": "张爱玲深受《红楼梦》家族传统与弗洛伊德心理分析的双重滋养。",
    "start": 314.112,
    "end": 318.832,
    "duration": 4.72
  },
  {
    "id": 75,
    "text": "她对人性阴暗与病态扭曲的洞察深入骨髓。",
    "start": 318.832,
    "end": 322.832,
    "duration": 4.0
  },
  {
    "id": 76,
    "text": "《金锁记》堪称中国现代文学心理描写的巅峰之作。",
    "start": 322.832,
    "end": 326.992,
    "duration": 4.16
  },
  {
    "id": 77,
    "text": "曹七巧作为一个小麻油店人家的健康姑娘，",
    "start": 326.992,
    "end": 330.032,
    "duration": 3.04
  },
  {
    "id": 78,
    "text": "被金钱买卖推入姜家残疾少爷的病榻。",
    "start": 330.032,
    "end": 333.072,
    "duration": 3.04
  },
  {
    "id": 79,
    "text": "长期被压抑的情欲与贪婪，最终将她扭曲为变态的吃人恶魔。",
    "start": 333.392,
    "end": 338.672,
    "duration": 5.28
  },
  {
    "id": 80,
    "text": "她戴着沉重的黄金枷锁劈杀身边的一切，",
    "start": 338.672,
    "end": 342.032,
    "duration": 3.36
  },
  {
    "id": 81,
    "text": "不仅毁掉了儿女的终身幸福，更毁灭了自己的人性本真。",
    "start": 342.032,
    "end": 346.272,
    "duration": 4.24
  },
  {
    "id": 82,
    "text": "张爱玲展示了礼教与金钱双重压榨下，",
    "start": 346.432,
    "end": 349.552,
    "duration": 3.12
  },
  {
    "id": 83,
    "text": "人类精神全面崩塌的恐怖图景。",
    "start": 349.552,
    "end": 351.872,
    "duration": 2.32
  },
  {
    "id": 84,
    "text": "第二，深层心理透视与病态人性异化机制的揭示。",
    "start": 352.112,
    "end": 356.752,
    "duration": 4.64
  },
  {
    "id": 85,
    "text": "张爱玲深受《红楼梦》家族传统与弗洛伊德心理分析的双重滋养。",
    "start": 356.752,
    "end": 361.472,
    "duration": 4.72
  },
  {
    "id": 86,
