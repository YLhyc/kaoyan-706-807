[
  {
    "id": 1,
    "text": "三十年代初，",
    "start": 0.092,
    "end": 1.11,
    "duration": 1.018
  },
  {
    "id": 2,
    "text": "茅盾的长篇巨著《子夜》在中国现代文学史上确立了社会剖析小说的典范。",
    "start": 1.356,
    "end": 7.608,
    "duration": 6.252
  },
  {
    "id": 3,
    "text": "小说主人公吴荪甫作为中国现代文学中塑造得最为丰满的民族资产阶级典型，",
    "start": 8.079,
    "end": 14.913,
    "duration": 6.834
  },
  {
    "id": 4,
    "text": "其性格特征与悲剧成因主要展现于以下三个层面：",
    "start": 15.389,
    "end": 19.384,
    "duration": 3.995
  },
  {
    "id": 5,
    "text": "第一，怀抱“实业救国”宏图，",
    "start": 20.063,
    "end": 22.521,
    "duration": 2.458
  },
  {
    "id": 6,
    "text": "具备现代企业家的铁腕魄力与开拓雄心。",
    "start": 22.767,
    "end": 26.212,
    "duration": 3.445
  },
  {
    "id": 7,
    "text": "吴荪甫不同于传统买办与封建遗老，他留学欧美、精明强干，",
    "start": 26.419,
    "end": 30.859,
    "duration": 4.44
  },
  {
    "id": 8,
    "text": "怀揣发展民族工业、抵制洋货倾销的宏大抱负。",
    "start": 31.0,
    "end": 34.395,
    "duration": 3.395
  },
  {
    "id": 9,
    "text": "他苦心经营裕华丝厂，",
    "start": 34.51,
    "end": 36.179,
    "duration": 1.669
  },
  {
    "id": 10,
    "text": "试图吞并八个小型日化厂组建益中信托公司，",
    "start": 36.294,
    "end": 39.935,
    "duration": 3.641
  },
  {
    "id": 11,
    "text": "建立独立自主的现代资本工业王国，",
    "start": 40.031,
    "end": 42.611,
    "duration": 2.58
  },
  {
    "id": 12,
    "text": "在商场搏杀中展现出雷厉风行、",
    "start": 42.778,
    "end": 45.443,
    "duration": 2.665
  },
  {
    "id": 13,
    "text": "不甘屈服的骑士般决断力与意志力。",
    "start": 45.566,
    "end": 48.288,
    "duration": 2.722
  },
  {
    "id": 14,
    "text": "第二，身陷半殖民地半封建泥潭，",
    "start": 48.49,
    "end": 51.23,
    "duration": 2.74
  },
  {
    "id": 15,
    "text": "兼具反帝图存与剥削压迫的双重软弱性格。",
    "start": 51.54,
    "end": 55.185,
    "duration": 3.645
  },
  {
    "id": 16,
    "text": "吴荪甫的悲剧深深植根于阶级局限。",
    "start": 55.429,
    "end": 58.188,
    "duration": 2.759
  },
  {
    "id": 17,
    "text": "对内面对裕华丝厂工人的合理罢工诉求，",
    "start": 58.456,
    "end": 61.534,
    "duration": 3.078
  },
  {
    "id": 18,
    "text": "他毫不留情地勾结特务工贼实施残酷铁血镇压，甚至开除女工、",
    "start": 61.776,
    "end": 67.024,
    "duration": 5.248
  },
  {
    "id": 19,
    "text": "克扣工钱，暴露出剥削阶级冷酷凶狠的本质；",
    "start": 67.05,
    "end": 70.603,
    "duration": 3.553
  },
  {
    "id": 20,
    "text": "而对外面对帝国主义经济入侵与国民党反动政权的严酷盘剥，",
    "start": 70.824,
    "end": 75.862,
    "duration": 5.038
  },
  {
    "id": 21,
    "text": "他又缺乏彻底抗争的政治力量，",
    "start": 76.193,
    "end": 78.685,
    "duration": 2.492
  },
  {
    "id": 22,
    "text": "只能深陷投机公债市场的铤而走险。",
    "start": 78.73,
    "end": 81.438,
    "duration": 2.708
  },
  {
    "id": 23,
    "text": "第三，惨遭买办金融资本与封建势力双重围剿，",
    "start": 81.631,
    "end": 85.603,
    "duration": 3.972
  },
  {
    "id": 24,
    "text": "走向无可挽回的破产宿命。",
    "start": 85.714,
    "end": 87.748,
    "duration": 2.034
  },
  {
    "id": 25,
    "text": "在半殖民地畸形的经济秩序下，",
    "start": 87.809,
    "end": 90.045,
    "duration": 2.236
  },
  {
    "id": 26,
    "text": "民族工业无法脱离外部金融控制而独立生存。",
    "start": 90.111,
    "end": 93.633,
    "duration": 3.522
  },
  {
    "id": 27,
    "text": "在公债市场的生死搏杀中，",
    "start": 93.863,
    "end": 95.996,
    "duration": 2.133
  },
  {
    "id": 28,
    "text": "吴荪甫不仅遭遇帝国主义代理人赵伯韬雄厚外资的残酷绞杀，",
    "start": 96.258,
    "end": 101.577,
    "duration": 5.319
  },
  {
    "id": 29,
    "text": "更遭到至亲妹夫杜竹斋的倒戈背叛；当资金链彻底断裂、",
    "start": 101.663,
    "end": 106.207,
    "duration": 4.544
  },
  {
    "id": 30,
    "text": "宣告破产的子夜暴雨之夜，吴荪甫神经错乱、瘫倒在沙发上，",
    "start": 106.36,
    "end": 111.365,
    "duration": 5.005
  },
  {
    "id": 31,
    "text": "最终只能带着无限愤懑败走庐山避难，",
    "start": 111.801,
    "end": 114.833,
    "duration": 3.032
  },
  {
    "id": 32,
    "text": "深刻印证了半殖民地中国民族资产阶级实业救国幻梦的必然破灭。",
    "start": 115.134,
    "end": 120.696,
    "duration": 5.562
  }
]
