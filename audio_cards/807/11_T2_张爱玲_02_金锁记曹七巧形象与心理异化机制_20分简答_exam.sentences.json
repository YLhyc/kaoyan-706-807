[
  {
    "id": 1,
    "text": "张爱玲在《金锁记》中塑造的曹七巧，",
    "start": 0.08,
    "end": 3.36,
    "duration": 3.28
  },
  {
    "id": 2,
    "text": "是中国现代文学史上最触目惊心的病态女性典型。",
    "start": 3.36,
    "end": 7.68,
    "duration": 4.32
  },
  {
    "id": 3,
    "text": "她既是封建买卖婚姻与金钱罪恶的牺牲品，",
    "start": 7.68,
    "end": 11.36,
    "duration": 3.68
  },
  {
    "id": 4,
    "text": "又是用变态心理摧残下一代的残酷施害者。",
    "start": 11.36,
    "end": 15.28,
    "duration": 3.92
  },
  {
    "id": 5,
    "text": "其形象塑造与心理异化机制主要体现在三个层面。",
    "start": 15.28,
    "end": 19.68,
    "duration": 4.4
  },
  {
    "id": 6,
    "text": "第一，被压抑的情欲与金钱异化互为因果。",
    "start": 19.68,
    "end": 23.44,
    "duration": 3.76
  },
  {
    "id": 7,
    "text": "曹七巧出身低微的麻油店家庭，因贪图钱财的哥嫂而被卖给姜家瘫痪残疾的二少爷。",
    "start": 23.76,
    "end": 31.44,
    "duration": 7.68
  },
  {
    "id": 8,
    "text": "她在青春盛年被迫承受肉体与心灵的双重荒芜。",
    "start": 31.44,
    "end": 35.68,
    "duration": 4.24
  },
  {
    "id": 9,
    "text": "健康的生命本能被彻底扼杀。",
    "start": 35.68,
    "end": 38.16,
    "duration": 2.48
  },
  {
    "id": 10,
    "text": "为了补偿被剥夺的情感，七巧将对生活的全部渴望转移到了对金钱的疯狂占有上。",
    "start": 38.16,
    "end": 44.48,
    "duration": 6.32
  },
  {
    "id": 11,
    "text": "金钱从生存的手段，变成了填补情感虚无的唯一精神支柱。",
    "start": 44.72,
    "end": 49.92,
    "duration": 5.2
  },
  {
    "id": 12,
    "text": "这种物化心理使她的人格发生致命扭曲。",
    "start": 49.92,
    "end": 53.12,
    "duration": 3.2
  },
  {
    "id": 13,
    "text": "第二，情爱彻底绝望后的恶毒反扑与心理防线崩溃。",
    "start": 53.12,
    "end": 57.6,
    "duration": 4.48
  },
  {
    "id": 14,
    "text": "当姜家分家后，小叔子姜季泽试图以虚假的温情骗取她的私房钱。",
    "start": 57.6,
    "end": 63.36,
    "duration": 5.76
  },
  {
    "id": 15,
    "text": "七巧在短暂的沉醉后瞬间清醒，毅然用酸辣的言语赶走了唯一的恋情寄托。",
    "start": 63.36,
    "end": 68.8,
    "duration": 5.44
  },
  {
    "id": 16,
    "text": "这一事件彻底粉碎了她对真爱的幻想。",
    "start": 69.12,
    "end": 72.08,
    "duration": 2.96
  },
  {
    "id": 17,
    "text": "她意识到金钱之外再无依靠。",
    "start": 72.08,
    "end": 74.88,
    "duration": 2.8
  },
  {
    "id": 18,
    "text": "精神的幻灭促使她由自卫防范走向恶毒反扑。",
    "start": 74.88,
    "end": 79.12,
    "duration": 4.24
  },
  {
    "id": 19,
    "text": "她开始仇视身边所有健康正常的情感关系，",
    "start": 79.12,
    "end": 82.56,
    "duration": 3.44
  },
  {
    "id": 20,
    "text": "以毁灭他人幸福来确认自身的存在感。",
    "start": 82.56,
    "end": 85.92,
    "duration": 3.36
  },
  {
    "id": 21,
    "text": "第三，黄金枷锁下的自残自虐与代际转嫁毁灭。",
    "start": 85.92,
    "end": 90.32,
    "duration": 4.4
  },
  {
    "id": 22,
    "text": "分家获得财产后的曹七巧，戴着这副沉重的黄金枷锁劈杀亲人。",
    "start": 90.64,
    "end": 96.08,
    "duration": 5.44
  },
  {
    "id": 23,
    "text": "由于自身情欲无法满足，她对儿女的婚姻产生了病态的嫉妒与控制狂。",
    "start": 96.08,
    "end": 101.68,
    "duration": 5.6
  },
  {
    "id": 24,
    "text": "她用鸦片和流言折磨长媳芝寿致死，",
    "start": 101.68,
    "end": 105.28,
    "duration": 3.6
  },
  {
    "id": 25,
    "text": "又以恶毒手段拆散女儿长安的美满姻缘。",
    "start": 105.28,
    "end": 108.88,
    "duration": 3.6
  },
  {
    "id": 26,
    "text": "她最终完成了从无辜受害者向恶毒施害者的彻底蜕变。",
    "start": 108.88,
    "end": 113.36,
    "duration": 4.48
  },
  {
    "id": 27,
    "text": "曹七巧的悲剧深刻揭示了封建纲常与金钱拜物教对女性肉体与灵魂的双重摧残，",
    "start": 113.68,
    "end": 120.96,
    "duration": 7.28
  },
  {
    "id": 28,
    "text": "展现了人性在畸形环境中逐步走向毁灭的心理深渊。--",
    "start": 120.96,
    "end": 125.28,
    "duration": 4.32
  }
]