[
  {
    "id": 1,
    "text": "试论毛泽东《在延安文艺座谈会上的讲话》的核心命题体系与深远历史影响。",
    "start": 0.104,
    "end": 6.154,
    "duration": 6.05
  },
  {
    "id": 2,
    "text": "毛泽东发表的《在延安文艺座谈会上的讲话》，",
    "start": 6.702,
    "end": 10.046,
    "duration": 3.344
  },
  {
    "id": 3,
    "text": "是中国现代文学迈向当代一体化文学体制的历史枢纽。",
    "start": 10.405,
    "end": 14.779,
    "duration": 4.374
  },
  {
    "id": 4,
    "text": "作品在延安整风与抗日战争战时动员的双重语境下应运而生，",
    "start": 15.34,
    "end": 20.311,
    "duration": 4.971
  },
  {
    "id": 5,
    "text": "以马克思主义文论中国化的理论自觉，破解了五四新文学长期困扰的“走向大众”难题。",
    "start": 20.661,
    "end": 27.501,
    "duration": 6.84
  },
  {
    "id": 6,
    "text": "它以“文艺为工农兵”的政治决断推动了文学主体的历史易位，",
    "start": 28.001,
    "end": 32.586,
    "duration": 4.585
  },
  {
    "id": 7,
    "text": "重构了文学与政治、民间形式的血肉关联，",
    "start": 32.95,
    "end": 36.075,
    "duration": 3.125
  },
  {
    "id": 8,
    "text": "催生出具有“中国作风与中国气派”的解放区文艺格局，奠定了当代一体化文学体制的基石。",
    "start": 36.425,
    "end": 43.406,
    "duration": 6.981
  },
  {
    "id": 9,
    "text": "其思想内涵与历史影响主要体现在以下四个维度：",
    "start": 43.972,
    "end": 47.869,
    "duration": 3.897
  },
  {
    "id": 10,
    "text": "第一，直面战时历史痛点，化解知识分子脱离群众与革命斗争的精神水土不服。",
    "start": 48.472,
    "end": 55.088,
    "duration": 6.616
  },
  {
    "id": 11,
    "text": "抗战爆发后，大批受五四启蒙精神与左联思潮哺育的知识青年奔赴延安；",
    "start": 55.588,
    "end": 61.568,
    "duration": 5.98
  },
  {
    "id": 12,
    "text": "他们习惯于都市亭子间的情调与启蒙者的居高临下姿态，",
    "start": 62.068,
    "end": 66.227,
    "duration": 4.159
  },
  {
    "id": 13,
    "text": "面对陕北艰苦的农村环境与工农兵受众，在观念与审美上发生了剧烈脱节。",
    "start": 66.705,
    "end": 72.906,
    "duration": 6.201
  },
  {
    "id": 14,
    "text": "王实味在《野百合花》中暴露延安阴暗面，引发了革命文艺应当“暴露还是歌颂”的论争；",
    "start": 73.406,
    "end": 79.903,
    "duration": 6.497
  },
  {
    "id": 15,
    "text": "《讲话》敏锐切中这一小资产阶级思想偏向，要求作家放下文化精英架子，",
    "start": 80.403,
    "end": 85.913,
    "duration": 5.51
  },
  {
    "id": 16,
    "text": "深入群众与火热斗争，在生活实践与思想情感上真正转向无产阶级立场。",
    "start": 86.263,
    "end": 92.415,
    "duration": 6.152
  },
  {
    "id": 17,
    "text": "第二，建构系统完备的命题体系，确立马克思主义文艺理论中国化的经典法则。",
    "start": 93.063,
    "end": 98.904,
    "duration": 5.841
  },
  {
    "id": 18,
    "text": "毛泽东明确指出，文艺“为什么人的问题，是一个根本的问题，原则的问题”，",
    "start": 99.404,
    "end": 105.052,
    "duration": 5.648
  },
  {
    "id": 19,
    "text": "旗帜鲜明地确立“文艺为人民大众，首先是为工农兵服务”的方向。",
    "start": 105.402,
    "end": 110.385,
    "duration": 4.983
  },
  {
    "id": 20,
    "text": "在文艺与政治的关系上，界定文艺从属于政治，并沿用列宁之喻视其为革命机器中不可或缺的“齿轮和螺丝钉”；",
    "start": 110.885,
    "end": 120.15,
    "duration": 9.265
  },
  {
    "id": 21,
    "text": "在普及与提高的关系上，确立战时条件下“普及工作更为迫切”，",
    "start": 120.771,
    "end": 125.704,
    "duration": 4.933
  },
  {
    "id": 22,
    "text": "提高必须在普及的基础上沿着工农兵前进方向提高；",
    "start": 126.054,
    "end": 130.059,
    "duration": 4.005
  },
  {
    "id": 23,
    "text": "在批评标尺上，创立“政治标准第一，艺术标准第二”的双重评价体系；",
    "start": 130.559,
    "end": 136.077,
    "duration": 5.518
  },
  {
    "id": 24,
    "text": "在创作源泉上，阐明人民生活是文学的唯一源泉，要求作品源于生活而又高于生活，塑造具有时代普遍性的典型形象。",
    "start": 136.577,
    "end": 146.702,
    "duration": 10.125
  },
  {
    "id": 25,
    "text": "第三，荡涤早期欧化藩篱，引领以民间形式为载体的解放区文艺风格重构。",
    "start": 147.378,
    "end": 153.465,
    "duration": 6.087
  },
  {
    "id": 26,
    "text": "《讲话》使延安文艺告别了欧化知识分子的书斋习气，深植于民间文化土壤之中。",
    "start": 153.965,
    "end": 160.048,
    "duration": 6.083
  },
  {
    "id": 27,
    "text": "新秧歌运动推陈出新，以《兄妹开荒》创造了以旧民间形式装入新革命内容的典范；",
    "start": 160.557,
    "end": 167.132,
    "duration": 6.575
  },
  {
    "id": 28,
    "text": "赵树理扎根农村生活与民间说唱艺术，创作出《小二黑结婚》与《李有才板话》，",
    "start": 167.632,
    "end": 173.659,
    "duration": 6.027
  },
  {
    "id": 29,
    "text": "以地道的群众语言塑造了翻身农民典型，形成极具民族气派的“赵树理方向”；",
    "start": 174.009,
    "end": 180.424,
    "duration": 6.415
  },
  {
    "id": 30,
    "text": "新歌剧《白毛女》将“白毛仙姑”民间传说去魅，融合民歌板腔体与西洋管弦乐，",
    "start": 180.924,
    "end": 187.249,
    "duration": 6.325
  },
  {
    "id": 31,
    "text": "提炼出“旧社会把人逼成鬼，新社会把鬼变成人”的时代寓言，",
    "start": 187.673,
    "end": 193.361,
    "duration": 5.688
  },
  {
    "id": 32,
    "text": "达成了阶级意识形态与民间审美心理的有机统一。",
    "start": 193.811,
    "end": 197.923,
    "duration": 4.112
  },
  {
    "id": 33,
    "text": "第四，重构文学组织与权力形态，成为当代十七年一体化机制的体制母本。",
    "start": 198.544,
    "end": 204.428,
    "duration": 5.884
  },
  {
    "id": 34,
    "text": "《讲话》扭转了少数文化精英对文学话语的垄断，",
    "start": 205.158,
    "end": 208.626,
    "duration": 3.468
  },
  {
    "id": 35,
    "text": "确立了工农兵在文学表现与消费中的主体地位，赋予文学强大的社会政治动员效能。",
    "start": 209.03,
    "end": 215.239,
    "duration": 6.209
  },
  {
    "id": 36,
    "text": "同时，它塑造了新中国建立后的文联作协体制、集体写作与评判尺度，",
    "start": 215.739,
    "end": 221.202,
    "duration": 5.463
  },
  {
    "id": 37,
    "text": "成为当代文学制度的核心规范；",
    "start": 221.561,
    "end": 223.687,
    "duration": 2.126
  },
  {
    "id": 38,
    "text": "它在推动新文学走向大众化与民族化的同时，",
    "start": 224.187,
    "end": 227.373,
    "duration": 3.186
  },
  {
    "id": 39,
    "text": "也在后世的机械化执行中带来了政治挂帅压抑艺术个性与题材窄化的历史局限。",
    "start": 227.723,
    "end": 234.251,
    "duration": 6.528
  },
  {
    "id": 40,
    "text": "从文学史转折来看，毛泽东《在延安文艺座谈会上的讲话》是连接现代与当代文学的纲领性文献。",
    "start": 234.916,
    "end": 242.671,
    "duration": 7.755
  },
  {
    "id": 41,
    "text": "它在历史转折关头重塑了中国文学的主体、功能、美学与体制，",
    "start": 243.171,
    "end": 248.72,
    "duration": 5.549
  },
  {
    "id": 42,
    "text": "标志着中国文学从五四启蒙传统向当代人民文艺道路的深层转折。",
    "start": 249.07,
    "end": 255.127,
    "duration": 6.057
  }
]
