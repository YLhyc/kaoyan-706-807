[
  {
    "id": 1,
    "text": "四十年代沦陷区时期的上海文坛，",
    "start": 0.0,
    "end": 2.893,
    "duration": 2.893
  },
  {
    "id": 2,
    "text": "张爱玲以《传奇》小说集的横空出世，",
    "start": 2.893,
    "end": 5.64,
    "duration": 2.747
  },
  {
    "id": 3,
    "text": "在宏大革命叙事与抗战救亡主流之外，",
    "start": 5.64,
    "end": 8.946,
    "duration": 3.306
  },
  {
    "id": 4,
    "text": "敏锐开辟了独特的都市现代“传奇”视界。",
    "start": 8.946,
    "end": 12.095,
    "duration": 3.149
  },
  {
    "id": 5,
    "text": "其小说艺术特质与苍凉美学主要体现于以下三个方面：",
    "start": 12.095,
    "end": 14.653,
    "duration": 2.558
  },
  {
    "id": 6,
    "text": "第一，聚焦乱世日常世俗凡庸，揭示人性深层的荒凉与苍凉底色。",
    "start": 14.653,
    "end": 19.415,
    "duration": 4.762
  },
  {
    "id": 7,
    "text": "张爱玲彻底摒弃了非黑即白的激进意识形态，",
    "start": 19.415,
    "end": 22.224,
    "duration": 2.809
  },
  {
    "id": 8,
    "text": "转而凝视现代都市男女在物质欲望与生存逼仄中的心理博弈。",
    "start": 22.224,
    "end": 30.878,
    "duration": 8.654
  },
  {
    "id": 9,
    "text": "在《倾城之恋》中，白流苏与范柳原在浅水湾饭店里虚与委蛇、",
    "start": 30.878,
    "end": 37.185,
    "duration": 6.307
  },
  {
    "id": 10,
    "text": "斤斤计较，各怀自私盘算；直至一场轰炸摧毁了整座香港城，",
    "start": 37.185,
    "end": 41.329,
    "duration": 4.144
  },
  {
    "id": 11,
    "text": "在断壁残垣与生死悬于一线的荒诞边缘，两人才卸下防备，",
    "start": 41.329,
    "end": 46.464,
    "duration": 5.135
  },
  {
    "id": 12,
    "text": "相互依偎着获得了一抹苍凉而现实的平凡婚姻，",
    "start": 46.464,
    "end": 50.523,
    "duration": 4.059
  },
  {
    "id": 13,
    "text": "深刻凸显了乱世小人物在时代倾覆中的脆弱宿命。",
    "start": 50.523,
    "end": 55.243,
    "duration": 4.72
  },
  {
    "id": 14,
    "text": "第二，深潜潜意识精神黑洞，",
    "start": 55.243,
    "end": 60.295,
    "duration": 5.052
  },
  {
    "id": 15,
    "text": "解剖欲望压抑下的病态心理与畸变异化。",
    "start": 60.295,
    "end": 64.67,
    "duration": 4.375
  },
  {
    "id": 16,
    "text": "作家擅长将传统世情白描与西方现代心理分析熔铸一体。",
    "start": 64.67,
    "end": 68.488,
    "duration": 3.818
  },
  {
    "id": 17,
    "text": "在《金锁记》中，",
    "start": 68.488,
    "end": 70.103,
    "duration": 1.615
  },
  {
    "id": 18,
    "text": "曹七巧在封建大家族的门第歧视与病残丈夫的折磨下，",
    "start": 70.103,
    "end": 73.992,
    "duration": 3.889
  },
  {
    "id": 19,
    "text": "将全部情感寄托于金钱；随着黄金枷锁的日益沉重，",
    "start": 73.992,
    "end": 76.114,
    "duration": 2.122
  },
  {
    "id": 20,
    "text": "其心理走向彻底癫狂畸变，不仅逼杀儿媳芝寿，",
    "start": 76.114,
    "end": 79.69,
    "duration": 3.576
  },
  {
    "id": 21,
    "text": "更冷酷拆散女儿长安的婚事，",
    "start": 79.69,
    "end": 83.426,
    "duration": 3.736
  },
  {
    "id": 22,
    "text": "在幽暗的卧房里以酸梅汤滴在桌上如血泪般的细节，",
    "start": 83.426,
    "end": 88.461,
    "duration": 5.035
  },
  {
    "id": 23,
    "text": "淋漓尽致地展现了被封建礼教与黄金欲望联手吞噬的人性悲剧。",
    "start": 88.461,
    "end": 95.344,
    "duration": 6.883
  },
  {
    "id": 24,
    "text": "第三，融汇古典白描与现代意象主义，",
    "start": 95.344,
    "end": 97.811,
    "duration": 2.467
  },
  {
    "id": 25,
    "text": "营构色彩斑斓而鬼气森森的意象世界。",
    "start": 97.811,
    "end": 99.796,
    "duration": 1.985
  },
  {
    "id": 26,
    "text": "张爱玲的小说语言华美冷艳，善于运用陌生化的通感、",
    "start": 99.796,
    "end": 104.489,
    "duration": 4.693
  },
  {
    "id": 27,
    "text": "奇诡的比喻与对比强烈的色彩。",
    "start": 104.489,
    "end": 106.791,
    "duration": 2.302
  },
  {
    "id": 28,
    "text": "她将旧时代的月亮比作“朵云轩信笺上落了一滴泪”或“三十年前沉在井底的一面铜镜”，",
    "start": 106.791,
    "end": 112.956,
    "duration": 6.165
  },
  {
    "id": 29,
    "text": "在葱绿配桃红的斑斓感官刺激背后，弥漫着大厦将倾、",
    "start": 112.956,
    "end": 114.491,
    "duration": 1.535
  },
  {
    "id": 30,
    "text": "繁华散尽的末世虚无感，",
    "start": 114.491,
    "end": 116.64,
    "duration": 2.149
  },
  {
    "id": 31,
    "text": "构成了中国现代文学史上独树一帜的苍凉美学范式。",
    "start": 116.64,
    "end": 120.71,
    "duration": 4.07
  }
]