[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "朦胧诗·思想特征与冷峻艺术革新",
    "start": 0.134,
    "end": 3.245,
    "duration": 3.111
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "反抗历史盲从（北岛/顾城）→呼唤人道平等（舒婷《致橡树》）→创造隐喻跳跃诗语（《回答》镀金天空/冰川），",
    "start": 3.834,
    "end": 15.083,
    "duration": 11.249
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "两维思想一维艺术正好切中朦胧诗全部考法。",
    "start": 15.292,
    "end": 19.263,
    "duration": 3.97
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "新时期之初北岛、舒婷、顾城等朦胧诗群告别机械政治抒情图解模式，",
    "start": 19.85,
    "end": 26.606,
    "duration": 6.757
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "转向个体尊严确认与历史反思，掀起主体复归与审美革命。",
    "start": 26.959,
    "end": 32.336,
    "duration": 5.377
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 确立怀疑主义理性、重构独立崇高尊严",
    "start": 32.91,
    "end": 37.14,
    "duration": 4.231
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "打破权威盲从思维，北岛《回答》以“告诉你吧，世界 / 我——不——相——信！”将主体塑造成挺立冰川废墟之上的思想硬汉；",
    "start": 37.714,
    "end": 49.588,
    "duration": 11.874
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "顾城《一代人》以两行张力诗句凝练浩劫一代对光明的探求，唤醒青年主体价值意识。",
    "start": 50.175,
    "end": 58.755,
    "duration": 8.58
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 呼唤温润人道情怀、立平等独立人格",
    "start": 59.342,
    "end": 63.468,
    "duration": 4.127
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "突破阶级论对情感的压抑，在真实人性领地重新发现爱与温情；",
    "start": 64.055,
    "end": 70.63,
    "duration": 6.574
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "舒婷《致橡树》拒作借高枝的凌霄花、拒作单调痴情鸟，以木棉与橡树并肩挺立风雨，",
    "start": 71.204,
    "end": 80.252,
    "duration": 9.048
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "立男女平等独立、灵魂呼应理想。",
    "start": 80.41,
    "end": 83.494,
    "duration": 3.085
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 破线性抒情、立隐喻象征现代诗性语法",
    "start": 84.068,
    "end": 88.703,
    "duration": 4.634
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "借鉴意象派与象征主义，广用意象跳跃、情绪通感与多义复调结构，化主观情为冷峻客观对应物；",
    "start": 89.29,
    "end": 98.716,
    "duration": 9.426
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "北岛《回答》并置“镀金的天空”与“冰川”寄寓荒诞，打破单一透明语义，极大拓宽审美空间。",
    "start": 99.303,
    "end": 107.427,
    "duration": 8.124
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：核心诗人北岛《回答》、顾城《一代人》、舒婷《致橡树》；",
    "start": 108.014,
    "end": 113.078,
    "duration": 5.064
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "艺术关键术语为“怀疑主义理性”“意象跳跃”“现代主义诗性语法”。",
    "start": 113.352,
    "end": 118.729,
    "duration": 5.377
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背诵北岛《回答》、顾城《一代人》、舒婷《致橡树》在朦胧诗中的三位定位？",
    "start": 119.316,
    "end": 126.541,
    "duration": 7.226
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释 2022 真题“朦胧诗的思想特征”哪两点（怀疑理性主体尊严 + 人道平等爱情观）？",
    "start": 127.128,
    "end": 135.656,
    "duration": 8.528
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 如何理解“客观对应物、意象跳跃、多义复调”构成的现代主义诗性语法？",
    "start": 136.243,
    "end": 143.468,
    "duration": 7.226
  }
]