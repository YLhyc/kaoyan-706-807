[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "朦胧诗·思想特征与冷峻艺术革新",
    "start": 0.314,
    "end": 3.526,
    "duration": 3.212
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "反抗历史盲从（北岛/顾城）→呼唤人道平等（舒婷《致橡树》）→创造隐喻跳跃诗语（《回答》镀金天空/冰川），",
    "start": 4.454,
    "end": 14.186,
    "duration": 9.732
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "两维思想一维艺术正好切中朦胧诗全部考法。",
    "start": 14.334,
    "end": 17.866,
    "duration": 3.532
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "新时期之初北岛、舒婷、顾城等朦胧诗群告别机械政治抒情图解模式，",
    "start": 18.914,
    "end": 25.486,
    "duration": 6.572
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "转向个体尊严确认与历史反思，掀起主体复归与审美革命。",
    "start": 25.634,
    "end": 30.886,
    "duration": 5.252
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 确立怀疑主义理性、重构独立崇高尊严",
    "start": 31.814,
    "end": 35.306,
    "duration": 3.492
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "打破权威盲从思维，北岛《回答》以“告诉你吧，世界 / 我——不——相——信！”将主体塑造成挺立冰川废墟之上的思想硬汉；",
    "start": 36.354,
    "end": 46.986,
    "duration": 10.632
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "顾城《一代人》以两行张力诗句凝练浩劫一代对光明的探求，唤醒青年主体价值意识。",
    "start": 47.954,
    "end": 55.886,
    "duration": 7.932
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 呼唤温润人道情怀、立平等独立人格",
    "start": 56.854,
    "end": 61.266,
    "duration": 4.412
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "突破阶级论对情感的压抑，在真实人性领地重新发现爱与温情；",
    "start": 62.274,
    "end": 68.606,
    "duration": 6.332
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "舒婷《致橡树》拒作借高枝的凌霄花、拒作单调痴情鸟，以木棉与橡树并肩挺立风雨，",
    "start": 69.654,
    "end": 79.146,
    "duration": 9.492
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "立男女平等独立、灵魂呼应理想。",
    "start": 79.454,
    "end": 82.626,
    "duration": 3.172
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 破线性抒情、立隐喻象征现代诗性语法",
    "start": 83.594,
    "end": 88.286,
    "duration": 4.692
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "借鉴意象派与象征主义，广用意象跳跃、情绪通感与多义复调结构，化主观情为冷峻客观对应物；",
    "start": 89.018,
    "end": 98.59,
    "duration": 9.572
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "北岛《回答》并置“镀金的天空”与“冰川”寄寓荒诞，打破单一透明语义，极大拓宽审美空间。",
    "start": 99.558,
    "end": 107.33,
    "duration": 7.772
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：核心诗人北岛《回答》、顾城《一代人》、舒婷《致橡树》；",
    "start": 108.378,
    "end": 113.43,
    "duration": 5.052
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "艺术关键术语为“怀疑主义理性”“意象跳跃”“现代主义诗性语法”。",
    "start": 114.438,
    "end": 119.65,
    "duration": 5.212
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背诵北岛《回答》、顾城《一代人》、舒婷《致橡树》在朦胧诗中的三位定位？",
    "start": 120.658,
    "end": 128.07,
    "duration": 7.412
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释 2022 真题“朦胧诗的思想特征”哪两点（怀疑理性主体尊严 + 人道平等爱情观）？",
    "start": 128.958,
    "end": 138.45,
    "duration": 9.492
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 如何理解“客观对应物、意象跳跃、多义复调”构成的现代主义诗性语法？",
    "start": 139.418,
    "end": 146.95,
    "duration": 7.532
  }
]