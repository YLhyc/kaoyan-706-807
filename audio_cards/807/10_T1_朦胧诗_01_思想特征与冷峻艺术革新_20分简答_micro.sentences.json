[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "朦胧诗·思想特征与冷峻艺术革新",
    "start": 0.154,
    "end": 3.126,
    "duration": 2.972
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "反抗历史盲从（北岛/顾城）→呼唤人道平等（舒婷《致橡树》）→创造隐喻跳跃诗语（《回答》镀金天空/冰川），",
    "start": 3.834,
    "end": 14.566,
    "duration": 10.732
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "两维思想一维艺术正好切中朦胧诗全部考法。",
    "start": 14.714,
    "end": 18.486,
    "duration": 3.772
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "新时期之初北岛、舒婷、顾城等朦胧诗群告别机械政治抒情图解模式，",
    "start": 19.014,
    "end": 25.186,
    "duration": 6.172
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "转向个体尊严确认与历史反思，掀起主体复归与审美革命。",
    "start": 25.494,
    "end": 30.546,
    "duration": 5.052
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 确立怀疑主义理性、重构独立崇高尊严",
    "start": 31.204,
    "end": 35.376,
    "duration": 4.172
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "打破权威盲从思维，北岛《回答》以“告诉你吧，世界 / 我——不——相——信！”将主体塑造成挺立冰川废墟之上的思想硬汉；",
    "start": 35.864,
    "end": 46.486,
    "duration": 10.622
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "顾城《一代人》以两行张力诗句凝练浩劫一代对光明的探求，唤醒青年主体价值意识。",
    "start": 46.807,
    "end": 54.819,
    "duration": 8.012
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 呼唤温润人道情怀、立平等独立人格",
    "start": 55.458,
    "end": 59.87,
    "duration": 4.412
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "突破阶级论对情感的压抑，在真实人性领地重新发现爱与温情；",
    "start": 60.336,
    "end": 66.508,
    "duration": 6.172
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "舒婷《致橡树》拒作借高枝的凌霄花、拒作单调痴情鸟，以木棉与橡树并肩挺立风雨，",
    "start": 67.015,
    "end": 75.051,
    "duration": 8.036
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "立男女平等独立、灵魂呼应理想。",
    "start": 75.066,
    "end": 78.227,
    "duration": 3.161
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 破线性抒情、立隐喻象征现代诗性语法",
    "start": 78.721,
    "end": 82.973,
    "duration": 4.252
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "借鉴意象派与象征主义，广用意象跳跃、情绪通感与多义复调结构，化主观情为冷峻客观对应物；",
    "start": 83.453,
    "end": 93.145,
    "duration": 9.692
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "北岛《回答》并置“镀金的天空”与“冰川”寄寓荒诞，打破单一透明语义，极大拓宽审美空间。",
    "start": 93.566,
    "end": 101.658,
    "duration": 8.092
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：核心诗人北岛《回答》、顾城《一代人》、舒婷《致橡树》；",
    "start": 102.362,
    "end": 107.014,
    "duration": 4.652
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "艺术关键术语为“怀疑主义理性”“意象跳跃”“现代主义诗性语法”。",
    "start": 107.372,
    "end": 112.584,
    "duration": 5.212
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背诵北岛《回答》、顾城《一代人》、舒婷《致橡树》在朦胧诗中的三位定位？",
    "start": 113.205,
    "end": 119.537,
    "duration": 6.332
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释 2022 真题“朦胧诗的思想特征”哪两点（怀疑理性主体尊严 + 人道平等爱情观）？",
    "start": 120.038,
    "end": 128.85,
    "duration": 8.812
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 如何理解“客观对应物、意象跳跃、多义复调”构成的现代主义诗性语法？",
    "start": 129.377,
    "end": 136.189,
    "duration": 6.812
  }
]