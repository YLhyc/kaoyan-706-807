[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 2.96,
    "duration": 2.88
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 2.96,
    "end": 5.92,
    "duration": 2.96
  },
  {
    "id": 3,
    "text": "这道题考查老舍现实主义代表作《骆驼祥子》。",
    "start": 5.92,
    "end": 9.36,
    "duration": 3.44
  },
  {
    "id": 4,
    "text": "在考场上，考生不能简单只是复述故事情节，",
    "start": 9.36,
    "end": 13.04,
    "duration": 3.68
  },
  {
    "id": 5,
    "text": "而必须紧扣“三起三落性格演变”与“悲剧成因机制”两大抓手。",
    "start": 13.04,
    "end": 18.0,
    "duration": 4.96
  },
  {
    "id": 6,
    "text": "核心在于回答：祥子为何必然从要强的好青年蜕变为麻木的行尸走肉，",
    "start": 18.24,
    "end": 24.48,
    "duration": 6.24
  },
  {
    "id": 7,
    "text": "以及个人奋斗神话为何必然破灭。",
    "start": 24.48,
    "end": 27.12,
    "duration": 2.64
  },
  {
    "id": 8,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 27.12,
    "end": 29.68,
    "duration": 2.56
  },
  {
    "id": 9,
    "text": "答题必须确立“性格流变、趋近于、",
    "start": 29.68,
    "end": 32.8,
    "duration": 3.12
  },
  {
    "id": 10,
    "text": "机制深析、趋近于、艺术本体”的推进流线。",
    "start": 32.8,
    "end": 36.32,
    "duration": 3.52
  },
  {
    "id": 11,
    "text": "先系统梳理祥子三次买车与三次失车的心灵轨迹，",
    "start": 36.32,
    "end": 40.16,
    "duration": 3.84
  },
  {
    "id": 12,
    "text": "再深入剖析社会压迫、畸形家庭与小农个人主义三大致悲根源，",
    "start": 40.16,
    "end": 44.96,
    "duration": 4.8
  },
  {
    "id": 13,
    "text": "最后落脚于京味儿语言与暴雨拉车等艺术细节。",
    "start": 44.96,
    "end": 48.16,
    "duration": 3.2
  },
  {
    "id": 14,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 48.4,
    "end": 51.76,
    "duration": 3.36
  },
  {
    "id": 15,
    "text": "全题分为四个核心论述维度：第一维度：界定《骆驼祥子》作为现代城市平民小说最高峰的文学史坐标；",
    "start": 51.76,
    "end": 60.24,
    "duration": 8.48
  },
  {
    "id": 16,
    "text": "第二维度：深入剖析“三起三落”过程中祥子从自食其力走向堕落麻木的性格异化轨迹；",
    "start": 60.24,
    "end": 67.52,
    "duration": 7.28
  },
  {
    "id": 17,
    "text": "-第三维度：深刻论述社会黑暗压迫、",
    "start": 67.76,
    "end": 70.655,
    "duration": 2.895
  },
  {
    "id": 18,
    "text": "市民伦理扭曲与小生产者狭隘观念交织的悲剧生成机制；",
    "start": 70.655,
    "end": 75.619,
    "duration": 4.964
  },
  {
    "id": 19,
    "text": "-第四维度：精细剖析地道京味儿白话、",
    "start": 75.619,
    "end": 78.721,
    "duration": 3.102
  },
  {
    "id": 20,
    "text": "心理白描与烈日暴雨环境融铸的写实艺术；",
    "start": 78.721,
    "end": 82.443,
    "duration": 3.722
  },
  {
    "id": 21,
    "text": "-第五维度：宏观总结个人奋斗神话破灭的崇高悲剧定论。",
    "start": 82.443,
    "end": 87.2,
    "duration": 4.757
  },
  {
    "id": 22,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 87.36,
    "end": 90.8,
    "duration": 3.44
  },
  {
    "id": 23,
    "text": "全题逻辑严密咬合：第一步先确立批判个人奋斗的命题核心。",
    "start": 90.8,
    "end": 95.84,
    "duration": 5.04
  },
  {
    "id": 24,
    "text": "第二步梳理现象层面的沉沦事实，详细展开三起三落。",
    "start": 95.84,
    "end": 100.32,
    "duration": 4.48
  },
  {
    "id": 25,
    "text": "第三步探究为什么会沉沦，从外在阶级压迫与内在观念局限双重归因。",
    "start": 100.32,
    "end": 106.08,
    "duration": 5.76
  },
  {
    "id": 26,
    "text": "第四步说明承载这一悲剧的艺术形式即京味儿语言与环境象征。",
    "start": 106.4,
    "end": 112.0,
    "duration": 5.6
  },
  {
    "id": 27,
    "text": "第五步完成宏观历史论证闭环。",
    "start": 112.0,
    "end": 114.88,
    "duration": 2.88
  },
  {
    "id": 28,
    "text": "二、各板块逐句咬合演练。",
    "start": 114.88,
    "end": 117.44,
    "duration": 2.56
  },
  {
    "id": 29,
    "text": "一、开头破题段内部咬合。",
    "start": 117.44,
    "end": 119.92,
    "duration": 2.48
  },
  {
    "id": 30,
    "text": "本段旨在开门见山确立城市平民小说巅峰的立论基石。",
    "start": 119.92,
    "end": 124.64,
    "duration": 4.72
  },
  {
    "id": 31,
    "text": "首句直切经典地位，次句宣告个人奋斗神话破灭的认识价值。",
    "start": 124.64,
    "end": 129.68,
    "duration": 5.04
  },
  {
    "id": 32,
    "text": "-首先，首句必须直接亮出该书在现代现实主义长河中的尊崇地位，",
    "start": 129.984,
    "end": 135.17,
    "duration": 5.186
  },
  {
    "id": 33,
    "text": "具体表述到答题语句就是：老舍所著长篇小说《骆驼祥子》是中国现代文学史上剖析城市平民命运最深刻的现实主义杰作。",
    "start": 135.17,
    "end": 144.774,
    "duration": 9.604
  },
  {
    "id": 34,
    "text": "有了经典定性之后，次句必须迅速说明主人公由人变鬼的轨迹与时代批判深度，",
    "start": 144.774,
    "end": 151.112,
    "duration": 6.338
  },
  {
    "id": 35,
    "text": "具体表述到答题语句就是：老舍以满腔同情与冷峻解剖并存的现实主义笔触，",
    "start": 151.112,
    "end": 157.258,
    "duration": 6.146
  },
  {
    "id": 36,
    "text": "通过人力车夫祥子由“人”蜕变为“鬼”的人生轨迹，",
    "start": 157.258,
    "end": 160.908,
    "duration": 3.65
  },
  {
    "id": 37,
    "text": "宣告了近代以来底层劳动者个人奋斗神话的彻底破灭，",
    "start": 160.908,
    "end": 165.325,
    "duration": 4.417
  },
  {
    "id": 38,
    "text": "具有震撼人心的时代认识价值与悲剧力量。，",
    "start": 165.325,
    "end": 168.783,
    "duration": 3.458
  },
  {
    "id": 39,
    "text": "这句话干脆利落地揭示了下文展开的核心逻辑。",
    "start": 168.783,
    "end": 172.624,
    "duration": 3.841
  },
  {
    "id": 40,
    "text": "老舍所著长篇小说《骆驼祥子》是中国现代文学史上剖析城市平民命运最深刻的现实主义杰作。",
    "start": 172.704,
    "end": 180.544,
    "duration": 7.84
  },
  {
    "id": 41,
    "text": "老舍以满腔同情与冷峻解剖并存的现实主义笔触，",
    "start": 180.544,
    "end": 184.864,
    "duration": 4.32
  },
  {
    "id": 42,
    "text": "通过人力车夫祥子由“人”蜕变为“鬼”的人生轨迹，",
    "start": 184.864,
    "end": 188.944,
    "duration": 4.08
  },
  {
    "id": 43,
    "text": "宣告了近代以来底层劳动者个人奋斗神话的彻底破灭，",
    "start": 188.944,
    "end": 193.664,
    "duration": 4.72
  },
  {
    "id": 44,
    "text": "具有震撼人心的时代认识价值与悲剧力量。",
    "start": 193.664,
    "end": 197.024,
    "duration": 3.36
  },
  {
    "id": 45,
    "text": "二、第一维度：祥子三起三落性格流变轨迹内部咬合。",
    "start": 197.344,
    "end": 202.544,
    "duration": 5.2
  },
  {
    "id": 46,
    "text": "本段任务是详尽复原三次买车失车与精神防线彻底崩溃的流变链条。",
    "start": 202.544,
    "end": 208.224,
    "duration": 5.68
  },
  {
    "id": 47,
    "text": "首先，段首给出结论先行的分论点，",
    "start": 208.224,
    "end": 211.344,
    "duration": 3.12
  },
  {
    "id": 48,
    "text": "具体表述到答题语句就是：第一，在形象塑造与性格流变轨迹上，",
    "start": 211.344,
    "end": 217.024,
    "duration": 5.68
  },
  {
    "id": 49,
    "text": "祥子的沉沦历经了“三起三落”的残酷打击，",
    "start": 217.024,
    "end": 220.464,
    "duration": 3.44
  },
  {
    "id": 50,
    "text": "呈现出从积极要强走向彻底麻木自私的心灵异化过程。",
    "start": 220.464,
    "end": 224.784,
    "duration": 4.32
  },
  {
    "id": 51,
    "text": "-随后，还原初入北平时祥子的淳朴要强，",
    "start": 224.944,
    "end": 228.451,
    "duration": 3.507
  },
  {
    "id": 52,
    "text": "具体表述到答题语句就是：初入北平的祥子年轻健壮，",
    "start": 228.451,
    "end": 233.272,
    "duration": 4.821
  },
  {
    "id": 53,
    "text": "纯朴诚实，怀抱着买一辆属于自己的洋车以自食其力的质朴理想。",
    "start": 233.272,
    "end": 239.189,
    "duration": 5.917
  },
  {
    "id": 54,
    "text": "紧接着，清晰梳理三起三落的具体史实细节，",
    "start": 239.189,
    "end": 243.134,
    "duration": 3.945
  },
  {
    "id": 55,
    "text": "具体表述到答题语句就是：他三年苦熬买来第一辆车，",
    "start": 243.134,
    "end": 247.956,
    "duration": 4.822
  },
  {
    "id": 56,
    "text": "却被反动军阀乱军连人带车抢走。",
    "start": 247.956,
    "end": 251.024,
    "duration": 3.068
  },
  {
    "id": 57,
    "text": "此为一落。",
    "start": 251.104,
    "end": 252.464,
    "duration": 1.36
  },
  {
    "id": 58,
    "text": "随后他凭借卖骆驼所得拼命攒钱，却被伪装成特务的孙侦探洗劫一空。",
    "start": 252.464,
    "end": 258.784,
    "duration": 6.32
  },
  {
    "id": 59,
    "text": "此为二落。",
    "start": 258.784,
    "end": 259.904,
    "duration": 1.12
  },
  {
    "id": 60,
    "text": "被迫与虎妞成婚后，祥子用虎妞的私房钱买下第三辆车，",
    "start": 259.904,
    "end": 264.704,
    "duration": 4.8
  },
  {
    "id": 61,
    "text": "但因虎妞难产双亡，只得卖车安葬。",
    "start": 264.704,
    "end": 267.744,
    "duration": 3.04
  },
  {
    "id": 62,
    "text": "此为三落。",
    "start": 267.744,
    "end": 268.544,
    "duration": 0.8
  },
  {
    "id": 63,
    "text": "-随后，点出小福子之死这一压垮其精神防线的致命打击，",
    "start": 268.752,
    "end": 274.063,
    "duration": 5.311
  },
  {
    "id": 64,
    "text": "具体表述到答题语句就是：最后，寄托着其最后精神温存的小福子自义身亡，",
    "start": 274.063,
    "end": 281.22,
    "duration": 7.157
  },
  {
    "id": 65,
    "text": "祥子的心灵防线彻底崩溃。",
    "start": 281.22,
    "end": 283.76,
    "duration": 2.54
  },
  {
    "id": 66,
    "text": "紧接着，对比沉沦后的丑态：他从早先要强、",
    "start": 283.76,
    "end": 287.685,
    "duration": 3.925
  },
  {
    "id": 67,
    "text": "体面、厌恶烟酒的模范车夫，蜕变为吃喝嫖赌、",
    "start": 287.685,
    "end": 291.841,
    "duration": 4.156
  },
  {
    "id": 68,
    "text": "出卖朋友阮明、甚至靠混红白喜事执符度日的社会游民。",
    "start": 291.841,
    "end": 297.152,
    "duration": 5.311
  },
  {
    "id": 69,
    "text": "-最后，收束提炼人性剥蚀的悲剧深度：老舍极其真实地展现了一个健全个体在生活重压下人性被剥蚀殆尽的悲惨图景。",
    "start": 297.152,
    "end": 307.404,
    "duration": 10.252
  },
  {
    "id": 70,
    "text": "第一，在形象塑造与性格流变轨迹上，",
    "start": 307.404,
    "end": 310.543,
    "duration": 3.139
  },
  {
    "id": 71,
    "text": "祥子的沉沦历经了“三起三落”的残酷打击，",
    "start": 310.543,
    "end": 314.1,
    "duration": 3.557
  },
  {
    "id": 72,
    "text": "呈现出从积极要强走向彻底麻木自私的心灵异化过程。",
    "start": 314.1,
    "end": 318.912,
    "duration": 4.812
  },
  {
    "id": 73,
    "text": "初入北平的祥子年轻健壮，纯朴诚实，",
    "start": 318.992,
    "end": 322.832,
    "duration": 3.84
  },
  {
    "id": 74,
    "text": "怀抱着买一辆属于自己的洋车以自食其力的质朴理想。",
    "start": 322.832,
    "end": 327.632,
    "duration": 4.8
  },
  {
    "id": 75,
    "text": "他三年苦熬买来第一辆车，却被反动军阀乱军连人带车抢走。",
    "start": 327.632,
    "end": 333.232,
    "duration": 5.6
  },
  {
    "id": 76,
    "text": "此为一落。",
    "start": 333.232,
    "end": 334.592,
    "duration": 1.36
  },
  {
    "id": 77,
    "text": "随后他凭借卖骆驼所得拼命攒钱，却被伪装成特务的孙侦探洗劫一空。",
    "start": 334.592,
    "end": 340.672,
    "duration": 6.08
  },
  {
    "id": 78,
    "text": "此为二落。",
    "start": 340.992,
    "end": 342.032,
    "duration": 1.04
  },
  {
    "id": 79,
    "text": "被迫与虎妞成婚后，祥子用虎妞的私房钱买下第三辆车，",
    "start": 342.032,
    "end": 346.832,
    "duration": 4.8
  },
  {
    "id": 80,
    "text": "但因虎妞难产双亡，只得卖车安葬。",
    "start": 346.832,
    "end": 349.872,
    "duration": 3.04
  },
  {
    "id": 81,
    "text": "此为三落。",
    "start": 349.872,
    "end": 350.912,
    "duration": 1.04
  },
  {
    "id": 82,
    "text": "最后，寄托着其最后精神温存的小福子自义身亡，",
    "start": 350.912,
    "end": 355.312,
    "duration": 4.4
  },
  {
    "id": 83,
    "text": "祥子的心灵防线彻底崩溃。",
    "start": 355.312,
    "end": 357.552,
    "duration": 2.24
  },
  {
    "id": 84,
    "text": "他从早先要强、体面、厌恶烟酒的模范车夫，",
    "start": 357.552,
    "end": 361.232,
    "duration": 3.68
  },
  {
    "id": 85,
    "text": "蜕变为吃喝嫖赌、出卖朋友阮明、甚至靠混红白喜事执符度日的社会游民。",
    "start": 361.232,
    "end": 367.632,
    "duration": 6.4
  },
  {
    "id": 86,
    "text": "老舍极其真实地展现了一个健全个体在生活重压下人性被剥蚀殆尽的悲惨图景。",
    "start": 367.872,
    "end": 374.512,
    "duration": 6.64
  },
  {
    "id": 87,
    "text": "三、第二维度：悲剧生成的多重机制剖析内部咬合。",
    "start": 374.512,
    "end": 378.672,
    "duration": 4.16
  },
  {
    "id": 88,
    "text": "本段任务是从阶级压迫、畸形市民社会与小农个人主义三层深入解剖悲剧因果。",
    "start": 378.672,
    "end": 385.392,
    "duration": 6.72
  },
  {
    "id": 89,
    "text": "首先，段首给出统领分论点，具体表述到答题语句就是：第二，",
    "start": 385.392,
    "end": 390.112,
    "duration": 4.72
  },
  {
    "id": 90,
    "text": "在悲剧意蕴生成机制上，祥子的悲剧是严酷黑暗的社会压迫、",
    "start": 390.112,
    "end": 394.912,
    "duration": 4.8
  },
  {
    "id": 91,
    "text": "病态畸形的市民病态伦理与小农狭隘意识共同绞杀的结果。",
    "start": 394.912,
    "end": 399.552,
    "duration": 4.64
  },
  {
    "id": 92,
    "text": "-随后，剖析第一重外部社会压迫，",
    "start": 399.712,
    "end": 402.305,
    "duration": 2.593
  },
  {
    "id": 93,
    "text": "具体表述到答题语句就是：首先是军阀混战、",
    "start": 402.305,
    "end": 405.895,
    "duration": 3.59
  },
  {
    "id": 94,
    "text": "特务敲诈与高利贷剥削构成的反动统治网络，",
    "start": 405.895,
    "end": 409.685,
    "duration": 3.79
  },
  {
    "id": 95,
    "text": "从经济和人身上彻底断绝了底层车夫通过勤劳致富的可能。",
    "start": 409.685,
    "end": 414.672,
    "duration": 4.987
  },
  {
    "id": 96,
    "text": "-紧接着，剖析第二重畸形市民伦理与家庭束缚，",
    "start": 414.72,
    "end": 418.404,
    "duration": 3.684
  },
  {
    "id": 97,
    "text": "具体表述到答题语句就是：其次是病态市民社会的冷酷吞噬。",
    "start": 418.404,
    "end": 423.252,
    "duration": 4.848
  },
  {
    "id": 98,
    "text": "刘四爷对车夫血汗的残酷盘剥，虎妞以畸形爱欲对祥子肉体与精神的双重压榨，",
    "start": 423.252,
    "end": 429.651,
    "duration": 6.399
  },
  {
    "id": 99,
    "text": "使祥子陷入家庭与社会的双重牢笼。",
    "start": 429.651,
    "end": 432.56,
    "duration": 2.909
  },
  {
    "id": 100,
    "text": "-随后，深入剖析最关键的第三重思想局限，",
    "start": 432.56,
    "end": 435.96,
    "duration": 3.4
  },
  {
    "id": 101,
    "text": "具体表述到答题语句就是：更为深刻的是，",
    "start": 435.96,
    "end": 439.36,
    "duration": 3.4
  },
  {
    "id": 102,
    "text": "老舍以批判现实主义眼光指出了祥子自身思想的阶级局限。",
    "start": 439.36,
    "end": 444.36,
    "duration": 5.0
  },
  {
    "id": 103,
    "text": "祥子恪守着中国传统农民狭隘的孤立奋斗观念，",
    "start": 444.36,
    "end": 448.36,
    "duration": 4.0
  },
  {
    "id": 104,
    "text": "试图单打独斗抵抗庞大黑暗的现实体制，",
    "start": 448.36,
    "end": 451.76,
    "duration": 3.4
  },
  {
    "id": 105,
    "text": "对工友的苦难漠不关心，排斥集体互助。",
    "start": 451.76,
    "end": 454.96,
    "duration": 3.2
  },
  {
    "id": 106,
    "text": "-最后，引用老舍“个人主义末路鬼”权威定评，",
    "start": 454.96,
    "end": 458.365,
    "duration": 3.405
  },
  {
    "id": 107,
    "text": "具体表述到答题语句就是：老舍在结尾精辟概括其为“个人主义的末路鬼”，",
    "start": 458.365,
    "end": 464.375,
    "duration": 6.01
  },
  {
    "id": 108,
    "text": "深刻阐明了在黑暗旧社会中，个体盲目挣扎绝不可能换来真正解放。",
    "start": 464.375,
    "end": 469.984,
    "duration": 5.609
  },
  {
    "id": 109,
    "text": "第二，在悲剧意蕴生成机制上，祥子的悲剧是严酷黑暗的社会压迫、",
    "start": 469.984,
    "end": 475.392,
    "duration": 5.408
  },
  {
    "id": 110,
    "text": "病态畸形的市民病态伦理与小农狭隘意识共同绞杀的结果。",
    "start": 475.392,
    "end": 480.4,
    "duration": 5.008
  },
  {
    "id": 111,
    "text": "首先是军阀混战、特务敲诈与高利贷剥削构成的反动统治网络，",
    "start": 480.56,
    "end": 486.0,
    "duration": 5.44
  },
  {
    "id": 112,
    "text": "从经济和人身上彻底断绝了底层车夫通过勤劳致富的可能。",
    "start": 486.0,
    "end": 491.12,
    "duration": 5.12
  },
  {
    "id": 113,
    "text": "其次是病态市民社会的冷酷吞噬。",
    "start": 491.12,
    "end": 493.84,
    "duration": 2.72
  },
  {
    "id": 114,
    "text": "刘四爷对车夫血汗的残酷盘剥，虎妞以畸形爱欲对祥子肉体与精神的双重压榨，",
    "start": 493.84,
    "end": 500.32,
    "duration": 6.48
  },
  {
    "id": 115,
    "text": "使祥子陷入家庭与社会的双重牢笼。",
    "start": 500.32,
    "end": 503.04,
    "duration": 2.72
  },
  {
    "id": 116,
    "text": "更为深刻的是，老舍以批判现实主义眼光指出了祥子自身思想的阶级局限。",
    "start": 503.28,
    "end": 509.44,
    "duration": 6.16
  },
  {
    "id": 117,
    "text": "祥子恪守着中国传统农民狭隘的孤立奋斗观念，",
    "start": 509.44,
    "end": 513.12,
    "duration": 3.68
  },
  {
    "id": 118,
