[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 2.96,
    "duration": 2.88
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 2.96,
    "end": 5.92,
    "duration": 2.96
  },
  {
    "id": 3,
    "text": "这道题考查萧红晚期巅峰名作《呼兰河传》。",
    "start": 5.92,
    "end": 9.76,
    "duration": 3.84
  },
  {
    "id": 4,
    "text": "在考场上，考生不能简单只讲小团圆媳妇洗澡有多惨，",
    "start": 9.76,
    "end": 14.0,
    "duration": 4.24
  },
  {
    "id": 5,
    "text": "而必须紧扣茅盾评述的“诗化小说文体”与“民间叙事立场”两大核心。",
    "start": 14.0,
    "end": 19.28,
    "duration": 5.28
  },
  {
    "id": 6,
    "text": "核心在于回答：萧红如何用儿童与成人的双重视角解剖小城愚昧，",
    "start": 19.52,
    "end": 25.04,
    "duration": 5.52
  },
  {
    "id": 7,
    "text": "以及她如何打破传统小说套路建构散文化结构。",
    "start": 25.04,
    "end": 29.36,
    "duration": 4.32
  },
  {
    "id": 8,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 29.36,
    "end": 32.48,
    "duration": 3.12
  },
  {
    "id": 9,
    "text": "答题必须确立“叙事视点（民间立场与批判）趋近于、",
    "start": 32.48,
    "end": 36.742,
    "duration": 4.262
  },
  {
    "id": 10,
    "text": "文体形式（散文诗化小说与后花园象征）趋近于、",
    "start": 36.742,
    "end": 40.935,
    "duration": 4.193
  },
  {
    "id": 11,
    "text": "美学定论”的流线。",
    "start": 40.935,
    "end": 42.48,
    "duration": 1.545
  },
  {
    "id": 12,
    "text": "先引茅盾名言定性，次解剖童稚视角、",
    "start": 42.64,
    "end": 45.76,
    "duration": 3.12
  },
  {
    "id": 13,
    "text": "风俗画与小团圆媳妇惨剧，再次分析无主线结构与后花园诗意自由，",
    "start": 45.76,
    "end": 51.04,
    "duration": 5.28
  },
  {
    "id": 14,
    "text": "最后升华萧红独特的文学光彩。",
    "start": 51.04,
    "end": 53.6,
    "duration": 2.56
  },
  {
    "id": 15,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 53.6,
    "end": 56.4,
    "duration": 2.8
  },
  {
    "id": 16,
    "text": "全题分为四个核心论述维度：第一维度：界定《呼兰河传》作为诗化小说杰作与回忆性散文化文体的文学史坐标；",
    "start": 56.4,
    "end": 65.44,
    "duration": 9.04
  },
  {
    "id": 17,
    "text": "-第二维度：深入剖析童稚视角与成熟反思交织的民间叙事立场（以小团圆媳妇之死为例揭露愚昧）；",
    "start": 65.68,
    "end": 74.488,
    "duration": 8.808
  },
  {
    "id": 18,
    "text": "-第三维度：精细剖析打破传统情节链条、",
    "start": 74.488,
    "end": 78.011,
    "duration": 3.523
  },
  {
    "id": 19,
    "text": "营构片断组合与后花园自由象征的诗化小说文体；",
    "start": 78.011,
    "end": 82.635,
    "duration": 4.624
  },
  {
    "id": 20,
    "text": "-第四维度：宏观总结作品在民间审视与文体解放上的不可复制价值。",
    "start": 82.635,
    "end": 88.8,
    "duration": 6.165
  },
  {
    "id": 21,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 88.96,
    "end": 92.48,
    "duration": 3.52
  },
  {
    "id": 22,
    "text": "全题逻辑严密咬合：第一步先确立诗化小说的定性。",
    "start": 92.48,
    "end": 96.72,
    "duration": 4.24
  },
  {
    "id": 23,
    "text": "第二步剖析观察民间小城生活的视点立场，",
    "start": 96.72,
    "end": 100.16,
    "duration": 3.44
  },
  {
    "id": 24,
    "text": "即纯真目光下的残酷真相。",
    "start": 100.16,
    "end": 102.48,
    "duration": 2.32
  },
  {
    "id": 25,
    "text": "第三步说明这种散漫灰暗的真实生活如何塑造了散文化、",
    "start": 102.48,
    "end": 107.36,
    "duration": 4.88
  },
  {
    "id": 26,
    "text": "诗意化的文体。",
    "start": 107.36,
    "end": 108.32,
    "duration": 0.96
  },
  {
    "id": 27,
    "text": "第四步完成宏观历史论证闭环。",
    "start": 108.56,
    "end": 111.36,
    "duration": 2.8
  },
  {
    "id": 28,
    "text": "二、各板块逐句咬合演练。",
    "start": 111.36,
    "end": 114.08,
    "duration": 2.72
  },
  {
    "id": 29,
    "text": "一、开头破题段内部咬合。",
    "start": 114.08,
    "end": 116.48,
    "duration": 2.4
  },
  {
    "id": 30,
    "text": "本段旨在开门见山确立诗化小说杰作的立论基石。",
    "start": 116.48,
    "end": 120.72,
    "duration": 4.24
  },
  {
    "id": 31,
    "text": "首句直切经典地位，次句引入茅盾著名评语，",
    "start": 120.72,
    "end": 124.4,
    "duration": 3.68
  },
  {
    "id": 32,
    "text": "末句交代民间立场与生存图景。",
    "start": 124.4,
    "end": 126.88,
    "duration": 2.48
  },
  {
    "id": 33,
    "text": "-首先，首句必须直接亮出该作在现代文学史上的崇高地位，",
    "start": 127.176,
    "end": 132.137,
    "duration": 4.961
  },
  {
    "id": 34,
    "text": "具体表述到答题语句就是：萧红创作于香港流亡时期的长篇小说《呼兰河传》，",
    "start": 132.137,
    "end": 138.545,
    "duration": 6.408
  },
  {
    "id": 35,
    "text": "是中国现代文学史上一部兼具深沉乡土记忆与卓越文体创新的诗化小说杰作。",
    "start": 138.545,
    "end": 145.367,
    "duration": 6.822
  },
  {
    "id": 36,
    "text": "有了经典定性之后，次句必须迅速引入茅盾的权威论断，",
    "start": 145.367,
    "end": 150.121,
    "duration": 4.754
  },
  {
    "id": 37,
    "text": "具体表述到答题语句就是：茅盾曾盛赞其为“一篇叙事诗，",
    "start": 150.121,
    "end": 154.875,
    "duration": 4.754
  },
  {
    "id": 38,
    "text": "一幅多彩的风土画，一串凄婉的歌谣”。",
    "start": 154.875,
    "end": 157.976,
    "duration": 3.101
  },
  {
    "id": 39,
    "text": "-随后，末句干脆利落地揭示民间立场与散文化形式，",
    "start": 157.976,
    "end": 162.384,
    "duration": 4.408
  },
  {
    "id": 40,
    "text": "具体表述到答题语句就是：作品以独特的民间叙事立场与非传统的散文化小说形制，",
    "start": 162.384,
    "end": 169.732,
    "duration": 7.348
  },
  {
    "id": 41,
    "text": "展现了东北小城荒凉灰暗的生存图景。",
    "start": 169.732,
    "end": 173.09,
    "duration": 3.358
  },
  {
    "id": 42,
    "text": "萧红创作于香港流亡时期的长篇小说《呼兰河传》，",
    "start": 173.09,
    "end": 177.289,
    "duration": 4.199
  },
  {
    "id": 43,
    "text": "是中国现代文学史上一部兼具深沉乡土记忆与卓越文体创新的诗化小说杰作。",
    "start": 177.289,
    "end": 184.216,
    "duration": 6.927
  },
  {
    "id": 44,
    "text": "茅盾曾盛赞其为“一篇叙事诗，一幅多彩的风土画，",
    "start": 184.296,
    "end": 188.776,
    "duration": 4.48
  },
  {
    "id": 45,
    "text": "一串凄婉的歌谣”。",
    "start": 188.776,
    "end": 190.456,
    "duration": 1.68
  },
  {
    "id": 46,
    "text": "作品以独特的民间叙事立场与非传统的散文化小说形制，",
    "start": 190.456,
    "end": 195.336,
    "duration": 4.88
  },
  {
    "id": 47,
    "text": "展现了东北小城荒凉灰暗的生存图景。",
    "start": 195.336,
    "end": 198.696,
    "duration": 3.36
  },
  {
    "id": 48,
    "text": "二、第二板块：民间叙事立场与国民麻木悲敏剖析内部咬合。",
    "start": 198.696,
    "end": 203.816,
    "duration": 5.12
  },
  {
    "id": 49,
    "text": "本段任务是深入解剖童稚视角与成人反思的交织，",
    "start": 204.136,
    "end": 208.136,
    "duration": 4.0
  },
  {
    "id": 50,
    "text": "调取小团圆媳妇被滚水烫死的核心惨剧。",
    "start": 208.136,
    "end": 211.576,
    "duration": 3.44
  },
  {
    "id": 51,
    "text": "首先，段首给出统领分论点，具体表述到答题语句就是：首先，",
    "start": 211.576,
    "end": 216.456,
    "duration": 4.88
  },
  {
    "id": 52,
    "text": "在民间叙事立场上，小说创造性地采用“童稚视角”与“成熟叙述者冷峻反思”相交织的复调视点，",
    "start": 216.456,
    "end": 224.216,
    "duration": 7.76
  },
  {
    "id": 53,
    "text": "对民间苦难与国民劣根性进行了深沉的悲敏审视。",
    "start": 224.216,
    "end": 228.216,
    "duration": 4.0
  },
  {
    "id": 54,
    "text": "-随后，剖析孩子纯真眼光打量民间风俗画的机制，",
    "start": 228.456,
    "end": 232.767,
    "duration": 4.311
  },
  {
    "id": 55,
    "text": "具体表述到答题语句就是：作者以孩子纯真无邪的目光，",
    "start": 232.767,
    "end": 237.725,
    "duration": 4.958
  },
  {
    "id": 56,
    "text": "打量呼兰河小镇的大泥坑、跳大神、",
    "start": 237.725,
    "end": 240.743,
    "duration": 3.018
  },
  {
    "id": 57,
    "text": "放河灯与唱野戏等民间风俗。，",
    "start": 240.743,
    "end": 243.329,
    "duration": 2.586
  },
  {
    "id": 58,
    "text": "并指出风俗画背后的窒息残忍：在这幅看似平静的风俗画卷下，",
    "start": 243.329,
    "end": 248.934,
    "duration": 5.605
  },
  {
    "id": 59,
    "text": "掩藏着令人窒息的愚昧与残忍。",
    "start": 248.934,
    "end": 251.736,
    "duration": 2.802
  },
  {
    "id": 60,
    "text": "-紧接着，密集还原小团圆媳妇被滚水当众洗三次折磨致死的典型细节：小团圆媳妇本是一个健康爱笑的十二岁少女，",
    "start": 251.736,
    "end": 262.029,
    "duration": 10.293
  },
  {
    "id": 61,
    "text": "却被婆婆与全村看客以“治病”之名，",
    "start": 262.029,
    "end": 265.031,
    "duration": 3.002
  },
  {
    "id": 62,
    "text": "在大庭广众之下用滚烫的热水当众连洗三次，",
    "start": 265.031,
    "end": 269.105,
    "duration": 4.074
  },
  {
    "id": 63,
    "text": "在众人的愚昧喧嚣中被活活折磨致死。",
    "start": 269.105,
    "end": 272.536,
    "duration": 3.431
  },
  {
    "id": 64,
    "text": "-最后，收束提炼礼教迷信在民间自发运转的鲁迅式批判：萧红以冷静克制的笔调，",
    "start": 272.592,
    "end": 279.728,
    "duration": 7.136
  },
  {
    "id": 65,
    "text": "深刻揭露了封建礼教与迷信毒瘤在底层民间社会的自发运转，",
    "start": 279.728,
    "end": 285.351,
    "duration": 5.623
  },
  {
    "id": 66,
    "text": "哀其不幸，怒其不争。",
    "start": 285.351,
    "end": 287.081,
    "duration": 1.73
  },
  {
    "id": 67,
    "text": "首先，在民间叙事立场上，小说创造性地采用“童稚视角”与“成熟叙述者冷峻反思”相交织的复调视点，",
    "start": 287.081,
    "end": 295.731,
    "duration": 8.65
  },
  {
    "id": 68,
    "text": "对民间苦难与国民劣根性进行了深沉的悲敏审视。",
    "start": 295.731,
    "end": 300.272,
    "duration": 4.541
  },
  {
    "id": 69,
    "text": "作者以孩子纯真无邪的目光，打量呼兰河小镇的大泥坑、",
    "start": 300.432,
    "end": 304.832,
    "duration": 4.4
  },
  {
    "id": 70,
    "text": "跳大神、放河灯与唱野戏等民间风俗。",
    "start": 304.832,
    "end": 308.272,
    "duration": 3.44
  },
  {
    "id": 71,
    "text": "在这幅看似平静的风俗画卷下，掩藏着令人窒息的愚昧与残忍。",
    "start": 308.272,
    "end": 313.312,
    "duration": 5.04
  },
  {
    "id": 72,
    "text": "小团圆媳妇本是一个健康爱笑的十二岁少女，",
    "start": 313.312,
    "end": 316.672,
    "duration": 3.36
  },
  {
    "id": 73,
    "text": "却被婆婆与全村看客以“治病”之名，",
    "start": 316.672,
    "end": 319.392,
    "duration": 2.72
  },
  {
    "id": 74,
    "text": "在大庭广众之下用滚烫的热水当众连洗三次，",
    "start": 319.392,
    "end": 323.472,
    "duration": 4.08
  },
  {
    "id": 75,
    "text": "在众人的愚昧喧嚣中被活活折磨致死。",
    "start": 323.472,
    "end": 326.192,
    "duration": 2.72
  },
  {
    "id": 76,
    "text": "萧红以冷静克制的笔调，深刻揭露了封建礼教与迷信毒瘤在底层民间社会的自发运转，",
    "start": 326.592,
    "end": 333.712,
    "duration": 7.12
  },
  {
    "id": 77,
    "text": "哀其不幸，怒其不争。",
    "start": 333.712,
    "end": 335.632,
    "duration": 1.92
  },
  {
    "id": 78,
    "text": "三、第三板块：散文化结构与后花园象征美学内部咬合。",
    "start": 335.632,
    "end": 340.752,
    "duration": 5.12
  },
  {
    "id": 79,
    "text": "本段任务是直击本题第二问，解析弱化起承转合、",
    "start": 340.752,
    "end": 345.072,
    "duration": 4.32
  },
  {
    "id": 80,
    "text": "片断组接以及后花园自由象征。",
    "start": 345.072,
    "end": 347.632,
    "duration": 2.56
  },
  {
    "id": 81,
    "text": "-首先，段首给出统领分论点，具体表述到答题语句就是：其次，",
    "start": 347.872,
    "end": 352.877,
    "duration": 5.005
  },
  {
    "id": 82,
    "text": "在文体特质上，作品彻底打破了近代小说讲求起承转合与强冲突的戏剧化规约，",
    "start": 352.877,
    "end": 359.759,
    "duration": 6.882
  },
  {
    "id": 83,
    "text": "开辟了形散神聚的散文诗小说新范式。",
    "start": 359.759,
    "end": 363.096,
    "duration": 3.337
  },
  {
    "id": 84,
    "text": "随后，说明其无核心主线、片断拼接的叙事机制，",
    "start": 363.096,
    "end": 367.059,
    "duration": 3.963
  },
  {
    "id": 85,
    "text": "具体表述到答题语句就是：全书没有贯穿始终的主人公与核心情节线索，",
    "start": 367.059,
    "end": 373.315,
    "duration": 6.256
  },
  {
    "id": 86,
    "text": "而是由若干相对独立的风俗片断与人物掠影拼接而成。",
    "start": 373.315,
    "end": 378.112,
    "duration": 4.797
  },
  {
    "id": 87,
    "text": "作者以舒缓绵密、纯净本色的语言，",
    "start": 378.272,
    "end": 381.552,
    "duration": 3.28
  },
  {
    "id": 88,
    "text": "营造出一种荒凉幽远、回环往复的音乐韵律。",
    "start": 381.552,
    "end": 385.712,
    "duration": 4.16
  },
  {
    "id": 89,
    "text": "最后，调取祖父后花园的生命自由细节与小镇严冬对照收束：小说中祖父温暖的后花园，",
    "start": 385.712,
    "end": 393.632,
    "duration": 7.92
  },
  {
    "id": 90,
    "text": "充满了倭瓜、黄瓜与蝴蝶自由生长的生机，",
    "start": 393.632,
    "end": 397.712,
    "duration": 4.08
  },
  {
    "id": 91,
    "text": "构成了全书最温暖的生命避难所，与呼兰河城冰冷僵死的严冬风俗形成强烈的美学对照，",
    "start": 397.712,
    "end": 405.392,
    "duration": 7.68
  },
  {
    "id": 92,
    "text": "在诗意抒情中熔铸出沉重的历史苍凉感。",
    "start": 405.392,
    "end": 409.232,
    "duration": 3.84
  },
  {
    "id": 93,
    "text": "其次，在文体特质上，作品彻底打破了近代小说讲求起承转合与强冲突的戏剧化规约，",
    "start": 409.6,
    "end": 417.12,
    "duration": 7.52
  },
  {
    "id": 94,
    "text": "开辟了形散神聚的散文诗小说新范式。",
    "start": 417.12,
    "end": 420.48,
    "duration": 3.36
  },
  {
    "id": 95,
    "text": "全书没有贯穿始终的主人公与核心情节线索，",
    "start": 420.48,
    "end": 424.08,
    "duration": 3.6
  },
  {
    "id": 96,
    "text": "而是由若干相对独立的风俗片断与人物掠影拼接而成。",
    "start": 424.08,
    "end": 428.64,
    "duration": 4.56
  },
  {
    "id": 97,
    "text": "作者以舒缓绵密、纯净本色的语言，",
    "start": 428.64,
    "end": 431.76,
    "duration": 3.12
  },
  {
    "id": 98,
    "text": "营造出一种荒凉幽远、回环往复的音乐韵律。",
    "start": 431.76,
    "end": 435.52,
    "duration": 3.76
  },
  {
    "id": 99,
    "text": "小说中祖父温暖的后花园，充满了倭瓜、",
    "start": 435.84,
    "end": 439.12,
    "duration": 3.28
  },
  {
    "id": 100,
    "text": "黄瓜与蝴蝶自由生长的生机，构成了全书最温暖的生命避难所，",
    "start": 439.12,
    "end": 444.64,
    "duration": 5.52
  },
  {
    "id": 101,
    "text": "与呼兰河城冰冷僵死的严冬风俗形成强烈的美学对照，",
    "start": 444.64,
    "end": 449.52,
    "duration": 4.88
  },
  {
    "id": 102,
    "text": "在诗意抒情中熔铸出沉重的历史苍凉感。",
    "start": 449.52,
    "end": 453.52,
    "duration": 4.0
  },
  {
    "id": 103,
    "text": "四、结尾收束升华段内部咬合。",
    "start": 453.52,
    "end": 455.92,
    "duration": 2.4
  },
  {
    "id": 104,
    "text": "本段承担全篇论证成果的系统提炼与历史定位，",
    "start": 456.24,
    "end": 460.56,
    "duration": 4.32
  },
  {
    "id": 105,
    "text": "收束在不可复制的独特光彩上。",
    "start": 460.56,
    "end": 463.52,
    "duration": 2.96
  },
  {
    "id": 106,
    "text": "首先，全面回收民间立场与诗意笔触的成果，",
    "start": 463.52,
    "end": 467.76,
    "duration": 4.24
  },
  {
    "id": 107,
    "text": "具体表述到答题语句就是：综上所述，",
    "start": 467.76,
    "end": 471.04,
    "duration": 3.28
  },
  {
    "id": 108,
    "text": "萧红《呼兰河传》以清澈悲敏的民间立场穿透了小镇的愚昧坚冰，",
    "start": 471.04,
    "end": 477.36,
    "duration": 6.32
  },
  {
    "id": 109,
    "text": "以自由洒脱的诗意笔触重构了现代小说的文体边界。",
    "start": 477.36,
    "end": 482.08,
    "duration": 4.72
  },
  {
    "id": 110,
    "text": "-紧接着，总结人性哀歌对现代乡土文学的永恒定论，",
    "start": 482.32,
    "end": 486.979,
    "duration": 4.659
  },
  {
    "id": 111,
    "text": "具体表述到答题语句就是：它以凄婉绝美的人性哀歌，",
    "start": 486.979,
    "end": 491.859,
    "duration": 4.88
  },
  {
    "id": 112,
    "text": "在中国现代乡土文学长廊中留下了不可复制的独特光彩。",
    "start": 491.859,
    "end": 497.184,
    "duration": 5.325
  },
  {
    "id": 113,
    "text": "综上所述，萧红《呼兰河传》以清澈悲敏的民间立场穿透了小镇的愚昧坚冰，",
    "start": 497.184,
    "end": 503.839,
    "duration": 6.655
  },
  {
    "id": 114,
    "text": "以自由洒脱的诗意笔触重构了现代小说的文体边界。",
    "start": 503.839,
    "end": 508.72,
    "duration": 4.881
  },
  {
    "id": 115,
    "text": "它以凄婉绝美的人性哀歌，在中国现代乡土文学长廊中留下了不可复制的独特光彩。",
    "start": 508.8,
    "end": 515.36,
    "duration": 6.56
  }
]