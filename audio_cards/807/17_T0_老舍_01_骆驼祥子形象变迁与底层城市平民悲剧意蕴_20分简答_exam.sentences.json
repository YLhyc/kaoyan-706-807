[
  {
    "id": 1,
    "text": "题目：结合小说具体情节，从身份、",
    "start": 0.113,
    "end": 3.722,
    "duration": 3.609
  },
  {
    "id": 2,
    "text": "人生轨迹与性格流变三个维度分析祥子的人物形象及其悲剧成因。",
    "start": 4.118,
    "end": 9.63,
    "duration": 5.512
  },
  {
    "id": 3,
    "text": "老舍的长篇小说《骆驼祥子》通过人力车夫祥子由“人”堕落为“鬼”的轨迹，",
    "start": 10.069,
    "end": 16.428,
    "duration": 6.359
  },
  {
    "id": 4,
    "text": "宣告了底层劳动者依靠孤立个人奋斗改变命运的幻灭。",
    "start": 16.754,
    "end": 21.409,
    "duration": 4.655
  },
  {
    "id": 5,
    "text": "其形象特征与悲剧成因主要体现于以下四个方面：",
    "start": 21.637,
    "end": 25.643,
    "duration": 4.006
  },
  {
    "id": 6,
    "text": "第一，身份属性：兼具乡土美德与小农意识的城市新移民。",
    "start": 26.258,
    "end": 31.299,
    "duration": 5.041
  },
  {
    "id": 7,
    "text": "初入北平的祥子出身破产农村，年轻健壮、勤劳要强，",
    "start": 31.857,
    "end": 36.28,
    "duration": 4.423
  },
  {
    "id": 8,
    "text": "将全部希望寄托于买一辆属于自己的洋车。",
    "start": 36.517,
    "end": 39.487,
    "duration": 2.97
  },
  {
    "id": 9,
    "text": "然而他身上保留着传统小农狭隘自私的个体哲学，",
    "start": 40.098,
    "end": 43.649,
    "duration": 3.551
  },
  {
    "id": 10,
    "text": "信奉只靠自己力气吃饭，既不信任同伴，",
    "start": 44.057,
    "end": 47.001,
    "duration": 2.944
  },
  {
    "id": 11,
    "text": "也与有组织的群体相隔绝。",
    "start": 47.476,
    "end": 49.453,
    "duration": 1.977
  },
  {
    "id": 12,
    "text": "第二，人生轨迹：历经“三起三落”的物质掠夺与命运绞杀。",
    "start": 50.074,
    "end": 54.818,
    "duration": 4.744
  },
  {
    "id": 13,
    "text": "祥子的沉沦围绕三次买车与失车展开：",
    "start": 55.419,
    "end": 58.509,
    "duration": 3.09
  },
  {
    "id": 14,
    "text": "苦熬三年攒钱买来的新车被乱兵抢走，是一落；",
    "start": 58.885,
    "end": 63.099,
    "duration": 4.214
  },
  {
    "id": 15,
    "text": "靠卖骆驼再攒的血汗钱被孙侦探敲诈一空，是二落；",
    "start": 63.714,
    "end": 68.214,
    "duration": 4.5
  },
  {
    "id": 16,
    "text": "被迫与虎妞结合后买下的车，因虎妞难产去世只得卖车办丧，是三落。",
    "start": 68.715,
    "end": 74.501,
    "duration": 5.786
  },
  {
    "id": 17,
    "text": "接连的掠夺与打击堵死了他诚实劳动的出路。",
    "start": 74.787,
    "end": 77.887,
    "duration": 3.1
  },
  {
    "id": 18,
    "text": "第三，性格流变：从自尊要强的车夫蜕变为麻木堕落的游民。",
    "start": 78.52,
    "end": 84.084,
    "duration": 5.564
  },
  {
    "id": 19,
    "text": "三落之后，小福子在暗娼馆自缢切断了祥子最后的精神寄托。",
    "start": 84.472,
    "end": 89.243,
    "duration": 4.771
  },
  {
    "id": 20,
    "text": "他从早先讲体面、不吸烟酒的纯朴青年，堕落为吃喝嫖赌、",
    "start": 89.596,
    "end": 94.557,
    "duration": 4.961
  },
  {
    "id": 21,
    "text": "偷奸耍滑、甚至出卖同伴阮明换取赏钱的市井流氓，",
    "start": 94.957,
    "end": 99.557,
    "duration": 4.6
  },
  {
    "id": 22,
    "text": "展现出健全人性被黑暗社会逐步剥蚀的过程。",
    "start": 99.81,
    "end": 103.506,
    "duration": 3.696
  },
  {
    "id": 23,
    "text": "第四，悲剧成因：社会压迫、都市腐蚀与个人奋斗局限的合力结果。",
    "start": 104.186,
    "end": 109.867,
    "duration": 5.681
  },
  {
    "id": 24,
    "text": "祥子的毁灭既是军阀乱兵、",
    "start": 110.328,
    "end": 112.425,
    "duration": 2.097
  },
  {
    "id": 25,
    "text": "特务孙侦探与车厂主刘四爷等外部势力盘剥的产物，",
    "start": 112.763,
    "end": 116.832,
    "duration": 4.069
  },
  {
    "id": 26,
    "text": "也源于畸形都市生活对其道德防线的侵蚀。",
    "start": 117.127,
    "end": 120.183,
    "duration": 3.056
  },
  {
    "id": 27,
    "text": "老舍在结尾将其定性为“个人主义的末路鬼”，",
    "start": 120.527,
    "end": 124.09,
    "duration": 3.563
  },
  {
    "id": 28,
    "text": "揭示了在黑暗旧制度下脱离集体抗争的孤立奋斗终归失败。",
    "start": 124.344,
    "end": 129.487,
    "duration": 5.143
  },
  {
    "id": 29,
    "text": "掩卷而思，",
    "start": 130.166,
    "end": 131.157,
    "duration": 0.991
  },
  {
    "id": 30,
    "text": "祥子的悲剧是一个淳朴劳动者在旧社会压迫下走向精神毁灭的写照，",
    "start": 131.756,
    "end": 137.697,
    "duration": 5.941
  },
  {
    "id": 31,
    "text": "蕴含着老舍对底层平民命运的深切悲悯与对旧制度的沉痛控诉。",
    "start": 138.081,
    "end": 143.155,
    "duration": 5.074
  }
]