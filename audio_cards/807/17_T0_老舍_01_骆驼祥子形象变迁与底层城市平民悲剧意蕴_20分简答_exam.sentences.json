[
  {
    "id": 1,
    "text": "题目：结合小说具体情节，从身份、人生轨迹与性格流变三个维度分析祥子的人物形象及其悲剧成因。",
    "start": 0.113,
    "end": 9.637,
    "duration": 9.524
  },
  {
    "id": 2,
    "text": "老舍的长篇小说《骆驼祥子》通过人力车夫祥子由“人”堕落为“鬼”的轨迹，",
    "start": 10.137,
    "end": 16.506,
    "duration": 6.369
  },
  {
    "id": 3,
    "text": "宣告了底层劳动者依靠孤立个人奋斗改变命运的幻灭。",
    "start": 16.856,
    "end": 21.521,
    "duration": 4.665
  },
  {
    "id": 4,
    "text": "其形象特征与悲剧成因主要体现于以下四个方面：",
    "start": 22.021,
    "end": 26.037,
    "duration": 4.016
  },
  {
    "id": 5,
    "text": "第一，身份属性：兼具乡土美德与小农意识的城市新移民。",
    "start": 26.642,
    "end": 31.693,
    "duration": 5.051
  },
  {
    "id": 6,
    "text": "初入北平的祥子出身破产农村，年轻健壮、勤劳要强，",
    "start": 32.241,
    "end": 36.674,
    "duration": 4.433
  },
  {
    "id": 7,
    "text": "将全部希望寄托于买一辆属于自己的洋车。",
    "start": 37.024,
    "end": 40.004,
    "duration": 2.98
  },
  {
    "id": 8,
    "text": "然而他身上保留着传统小农狭隘自私的个体哲学，",
    "start": 40.605,
    "end": 44.163,
    "duration": 3.558
  },
  {
    "id": 9,
    "text": "信奉只靠自己力气吃饭，既不信任同伴，也与有组织的群体相隔绝。",
    "start": 44.564,
    "end": 49.97,
    "duration": 5.406
  },
  {
    "id": 10,
    "text": "第二，人生轨迹：历经“三起三落”的物质掠夺与命运绞杀。",
    "start": 50.581,
    "end": 55.333,
    "duration": 4.752
  },
  {
    "id": 11,
    "text": "祥子的沉沦围绕三次置车希望的起落展开：苦熬三年攒钱买来的新车被乱兵抢走，是一落；",
    "start": 55.949,
    "end": 63.676,
    "duration": 7.727
  },
  {
    "id": 12,
    "text": "靠卖骆驼再攒的血汗钱被孙侦探敲诈一空，是二落；",
    "start": 64.396,
    "end": 68.906,
    "duration": 4.51
  },
  {
    "id": 13,
    "text": "被迫与虎妞结合后买下的车，因虎妞难产去世只得卖车办丧，是三落。",
    "start": 69.406,
    "end": 75.189,
    "duration": 5.783
  },
  {
    "id": 14,
    "text": "接连的掠夺与打击堵死了他诚实劳动的出路。",
    "start": 75.689,
    "end": 78.799,
    "duration": 3.11
  },
  {
    "id": 15,
    "text": "第三，性格流变：从自尊要强的车夫蜕变为麻木堕落的游民。",
    "start": 79.422,
    "end": 84.996,
    "duration": 5.574
  },
  {
    "id": 16,
    "text": "三落之后，小福子在暗娼馆自缢切断了祥子最后的精神寄托。",
    "start": 85.496,
    "end": 90.277,
    "duration": 4.781
  },
  {
    "id": 17,
    "text": "他从早先讲体面、不吸烟酒的纯朴青年，",
    "start": 90.777,
    "end": 94.049,
    "duration": 3.272
  },
  {
    "id": 18,
    "text": "堕落为吃喝嫖赌、偷奸耍滑、甚至出卖同伴阮明换取赏钱的市井流氓，",
    "start": 94.399,
    "end": 100.844,
    "duration": 6.445
  },
  {
    "id": 19,
    "text": "展现出健全人性被黑暗社会逐步剥蚀的过程。",
    "start": 101.194,
    "end": 104.9,
    "duration": 3.706
  },
  {
    "id": 20,
    "text": "第四，悲剧成因：社会压迫、都市腐蚀与个人奋斗局限的合力结果。",
    "start": 105.57,
    "end": 111.261,
    "duration": 5.691
  },
  {
    "id": 21,
    "text": "祥子的毁灭既是军阀乱兵、特务孙侦探与车厂主刘四爷等外部势力盘剥的产物，也源于畸形都市生活对其道德防线的侵蚀。",
    "start": 111.761,
    "end": 121.639,
    "duration": 9.878
  },
  {
    "id": 22,
    "text": "老舍在结尾将其定性为“个人主义的末路鬼”，",
    "start": 122.182,
    "end": 125.533,
    "duration": 3.351
  },
  {
    "id": 23,
    "text": "揭示了在黑暗旧制度下脱离集体抗争的孤立奋斗终归失败。",
    "start": 125.883,
    "end": 131.036,
    "duration": 5.153
  },
  {
    "id": 24,
    "text": "掩卷而思，祥子的悲剧是一个淳朴劳动者在旧社会压迫下走向精神毁灭的写照，",
    "start": 131.705,
    "end": 139.236,
    "duration": 7.531
  },
  {
    "id": 25,
    "text": "蕴含着老舍对底层平民命运的深切悲悯与对旧制度的沉痛控诉。",
    "start": 139.62,
    "end": 144.694,
    "duration": 5.074
  }
]
