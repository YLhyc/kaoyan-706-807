[
  {
    "id": 1,
    "text": "题目：结合小说具体情节，从身份、人生轨迹与性格流变三个维度分析祥子的人物形象及其悲剧成因。",
    "start": 0.2,
    "end": 9.24,
    "duration": 9.04
  },
  {
    "id": 2,
    "text": "老舍的长篇小说《骆驼祥子》通过人力车夫祥子由“人”堕落为“鬼”的轨迹，",
    "start": 9.76,
    "end": 16.24,
    "duration": 6.48
  },
  {
    "id": 3,
    "text": "宣告了底层劳动者依靠孤立个人奋斗改变命运的幻灭。",
    "start": 16.61,
    "end": 20.21,
    "duration": 3.6
  },
  {
    "id": 4,
    "text": "其形象特征与悲剧成因主要体现于以下四个方面：",
    "start": 20.774,
    "end": 24.49,
    "duration": 3.716
  },
  {
    "id": 5,
    "text": "第一，身份属性：兼具乡土美德与小农意识的城市新移民。",
    "start": 24.86,
    "end": 29.82,
    "duration": 4.96
  },
  {
    "id": 6,
    "text": "初入北平的祥子出身破产农村，年轻健壮、勤劳要强，",
    "start": 30.34,
    "end": 35.14,
    "duration": 4.8
  },
  {
    "id": 7,
    "text": "将全部希望寄托于买一辆属于自己的洋车。",
    "start": 35.54,
    "end": 38.98,
    "duration": 3.44
  },
  {
    "id": 8,
    "text": "然而他身上保留着传统小农狭隘自私的个体哲学，",
    "start": 39.5,
    "end": 43.66,
    "duration": 4.16
  },
  {
    "id": 9,
    "text": "信奉只靠自己力气吃饭，既不信任同伴，也与有组织的群体相隔绝。",
    "start": 44.14,
    "end": 49.58,
    "duration": 5.44
  },
  {
    "id": 10,
    "text": "第二，人生轨迹：历经“三起三落”的物质掠夺与命运绞杀。",
    "start": 50.1,
    "end": 55.38,
    "duration": 5.28
  },
  {
    "id": 11,
    "text": "祥子的沉沦围绕三次置车希望的起落展开：苦熬三年攒钱买来的新车被乱兵抢走，是一落；",
    "start": 55.932,
    "end": 64.14,
    "duration": 8.208
  },
  {
    "id": 12,
    "text": "靠卖骆驼再攒的血汗钱被孙侦探敲诈一空，是二落；",
    "start": 64.66,
    "end": 69.06,
    "duration": 4.4
  },
  {
    "id": 13,
    "text": "被迫与虎妞结合后买下的车，因虎妞难产去世只得卖车办丧，是三落。",
    "start": 69.58,
    "end": 75.42,
    "duration": 5.84
  },
  {
    "id": 14,
    "text": "接连的掠夺与打击堵死了他诚实劳动的出路。",
    "start": 75.94,
    "end": 79.46,
    "duration": 3.52
  },
  {
    "id": 15,
    "text": "第三，性格流变：从自尊要强的车夫蜕变为麻木堕落的游民。",
    "start": 79.98,
    "end": 85.58,
    "duration": 5.6
  },
  {
    "id": 16,
    "text": "三落之后，小福子在暗娼馆自缢切断了祥子最后的精神寄托。",
    "start": 86.174,
    "end": 91.021,
    "duration": 4.847
  },
  {
    "id": 17,
    "text": "他从早先讲体面、不吸烟酒的纯朴青年，",
    "start": 91.541,
    "end": 94.821,
    "duration": 3.28
  },
  {
    "id": 18,
    "text": "堕落为吃喝嫖赌、偷奸耍滑、甚至出卖同伴阮明换取赏钱的市井流氓，",
    "start": 95.191,
    "end": 101.031,
    "duration": 5.84
  },
  {
    "id": 19,
    "text": "展现出健全人性被黑暗社会逐步剥蚀的过程。",
    "start": 101.401,
    "end": 104.841,
    "duration": 3.44
  },
  {
    "id": 20,
    "text": "第四，悲剧成因：社会压迫、都市腐蚀与个人奋斗局限的合力结果。",
    "start": 105.361,
    "end": 111.107,
    "duration": 5.746
  },
  {
    "id": 21,
    "text": "祥子的毁灭既是军阀乱兵、特务孙侦探与车厂主刘四爷等外部势力盘剥的产物，也源于畸形都市生活对其道德防线的侵蚀。",
    "start": 111.607,
    "end": 121.961,
    "duration": 10.354
  },
  {
    "id": 22,
    "text": "老舍在结尾将其定性为“个人主义的末路鬼”，",
    "start": 122.481,
    "end": 126.177,
    "duration": 3.696
  },
  {
    "id": 23,
    "text": "揭示了在黑暗旧制度下脱离集体抗争的孤立奋斗终归失败。",
    "start": 126.536,
    "end": 131.411,
    "duration": 4.875
  },
  {
    "id": 24,
    "text": "掩卷而思，祥子的悲剧是一个淳朴劳动者在旧社会压迫下走向精神毁灭的写照，",
    "start": 131.931,
    "end": 139.211,
    "duration": 7.28
  },
  {
    "id": 25,
    "text": "蕴含着老舍对底层平民命运的深切悲悯与对旧制度的沉痛控诉。",
    "start": 139.581,
    "end": 144.621,
    "duration": 5.04
  }
]
