[
  {
    "id": 1,
    "text": "题目：结合小说具体情节，从身份、人生轨迹与性格流变三个维度分析祥子的人物形象及其悲剧成因。",
    "start": 0.134,
    "end": 8.626,
    "duration": 8.492
  },
  {
    "id": 2,
    "text": "老舍的长篇小说《骆驼祥子》通过人力车夫祥子由“人”堕落为“鬼”的轨迹，",
    "start": 9.25,
    "end": 14.502,
    "duration": 5.252
  },
  {
    "id": 3,
    "text": "宣告了底层劳动者依靠孤立个人奋斗改变命运的幻灭。",
    "start": 14.881,
    "end": 19.133,
    "duration": 4.252
  },
  {
    "id": 4,
    "text": "其形象特征与悲剧成因主要体现于以下四个方面：",
    "start": 19.771,
    "end": 28.423,
    "duration": 8.652
  },
  {
    "id": 5,
    "text": "第一，身份属性：兼具乡土美德与小农意识的城市新移民。",
    "start": 29.181,
    "end": 36.433,
    "duration": 7.252
  },
  {
    "id": 6,
    "text": "初入北平的祥子出身破产农村，年轻健壮、勤劳要强，",
    "start": 37.111,
    "end": 42.763,
    "duration": 5.652
  },
  {
    "id": 7,
    "text": "将全部希望寄托于买一辆属于自己的洋车。",
    "start": 43.142,
    "end": 46.314,
    "duration": 3.172
  },
  {
    "id": 8,
    "text": "然而他身上保留着传统小农狭隘自私的个体哲学，",
    "start": 46.992,
    "end": 48.324,
    "duration": 1.332
  },
  {
    "id": 9,
    "text": "信奉只靠自己力气吃饭，既不信任同伴，也与有组织的群体相隔绝。",
    "start": 48.703,
    "end": 51.675,
    "duration": 2.972
  },
  {
    "id": 10,
    "text": "第二，人生轨迹：历经“三起三落”的物质掠夺与命运绞杀。",
    "start": 52.353,
    "end": 59.765,
    "duration": 7.412
  },
  {
    "id": 11,
    "text": "祥子的沉沦围绕三次置车希望的起落展开：苦熬三年攒钱买来的新车被乱兵抢走，是一落；",
    "start": 60.403,
    "end": 61.935,
    "duration": 1.532
  },
  {
    "id": 12,
    "text": "靠卖骆驼再攒的血汗钱被孙侦探敲诈一空，是二落；",
    "start": 62.464,
    "end": 63.586,
    "duration": 1.122
  },
  {
    "id": 13,
    "text": "被迫与虎妞结合后买下的车，因虎妞难产去世只得卖车办丧，是三落。",
    "start": 64.115,
    "end": 65.477,
    "duration": 1.362
  },
  {
    "id": 14,
    "text": "接连的掠夺与打击堵死了他诚实劳动的出路。",
    "start": 66.155,
    "end": 71.687,
    "duration": 5.532
  },
  {
    "id": 15,
    "text": "第三，性格流变：从自尊要强的车夫蜕变为麻木堕落的游民。",
    "start": 72.325,
    "end": 75.577,
    "duration": 3.252
  },
  {
    "id": 16,
    "text": "三落之后，小福子在暗娼馆自缢切断了祥子最后的精神寄托。",
    "start": 76.255,
    "end": 81.147,
    "duration": 4.892
  },
  {
    "id": 17,
    "text": "他从早先讲体面、不吸烟酒的纯朴青年，",
    "start": 81.905,
    "end": 82.597,
    "duration": 0.692
  },
  {
    "id": 18,
    "text": "堕落为吃喝嫖赌、偷奸耍滑、甚至出卖同伴阮明换取赏钱的市井流氓，",
    "start": 82.976,
    "end": 85.468,
    "duration": 2.492
  },
  {
    "id": 19,
    "text": "展现出健全人性被黑暗社会逐步剥蚀的过程。",
    "start": 85.847,
    "end": 87.259,
    "duration": 1.412
  },
  {
    "id": 20,
    "text": "第四，悲剧成因：社会压迫、都市腐蚀与个人奋斗局限的合力结果。",
    "start": 87.977,
    "end": 100.629,
    "duration": 12.652
  },
  {
    "id": 21,
    "text": "祥子的毁灭既是军阀乱兵、特务孙侦探与车厂主刘四爷等外部势力盘剥的产物，也源于畸形都市生活对其道德防线的侵蚀。",
    "start": 101.307,
    "end": 107.319,
    "duration": 6.012
  },
  {
    "id": 22,
    "text": "老舍在结尾将其定性为“个人主义的末路鬼”，",
    "start": 107.997,
    "end": 113.889,
    "duration": 5.892
  },
  {
    "id": 23,
    "text": "揭示了在黑暗旧制度下脱离集体抗争的孤立奋斗终归失败。",
    "start": 114.268,
    "end": 125.343,
    "duration": 11.075
  },
  {
    "id": 24,
    "text": "掩卷而思，祥子的悲剧是一个淳朴劳动者在旧社会压迫下走向精神毁灭的写照，",
    "start": 125.872,
    "end": 132.444,
    "duration": 6.572
  },
  {
    "id": 25,
    "text": "蕴含着老舍对底层平民命运的深切悲悯与对旧制度的沉痛控诉。",
    "start": 132.823,
    "end": 138.035,
    "duration": 5.212
  }
]