[
  {
    "id": 1,
    "text": "题目：结合小说具体情节，从身份、",
    "start": 0.098,
    "end": 3.49,
    "duration": 3.392
  },
  {
    "id": 2,
    "text": "人生轨迹与性格流变三个维度分析祥子的人物形象及其悲剧成因。。",
    "start": 3.603,
    "end": 9.174,
    "duration": 5.571
  },
  {
    "id": 3,
    "text": "老舍的长篇小说代表作《骆驼祥子》，",
    "start": 9.454,
    "end": 12.045,
    "duration": 2.591
  },
  {
    "id": 4,
    "text": "是中国现代文学史上剖析城市底层平民命运最深刻的现实主义经典。",
    "start": 12.299,
    "end": 17.722,
    "duration": 5.423
  },
  {
    "id": 5,
    "text": "作品通过人力车夫祥子由“人”蜕变为“鬼”的沉沦轨迹，",
    "start": 18.016,
    "end": 21.953,
    "duration": 3.937
  },
  {
    "id": 6,
    "text": "宣告了近代底层劳动者依靠个人奋斗改变命运神话的彻底破灭。",
    "start": 22.264,
    "end": 27.439,
    "duration": 5.175
  },
  {
    "id": 7,
    "text": "其形象特征与悲剧成因主要体现在以下四个核心维度：",
    "start": 27.609,
    "end": 31.677,
    "duration": 4.068
  },
  {
    "id": 8,
    "text": "第一，身份属性：带有乡土美德与小农意识的城市新移民。",
    "start": 32.034,
    "end": 36.472,
    "duration": 4.438
  },
  {
    "id": 9,
    "text": "初入北平的祥子是一个来自破产农村的“乡村自然之子”。",
    "start": 36.668,
    "end": 40.717,
    "duration": 4.049
  },
  {
    "id": 10,
    "text": "他年轻健壮、勤劳本分、自尊要强，",
    "start": 40.894,
    "end": 43.858,
    "duration": 2.964
  },
  {
    "id": 11,
    "text": "将全部生命寄托于拥有一辆属于自己的洋车以自食其力；",
    "start": 44.095,
    "end": 48.38,
    "duration": 4.285
  },
  {
    "id": 12,
    "text": "但其骨子里深植着传统小农狭隘自私的个体奋斗哲学，",
    "start": 48.581,
    "end": 52.986,
    "duration": 4.405
  },
  {
    "id": 13,
    "text": "信奉凭力气吃饭、不问他人死活，",
    "start": 53.253,
    "end": 55.936,
    "duration": 2.683
  },
  {
    "id": 14,
    "text": "在生存方式上与工人阶级群体隔绝。",
    "start": 56.226,
    "end": 59.125,
    "duration": 2.899
  },
  {
    "id": 15,
    "text": "第二，人生轨迹：历经“三起三落”的物质掠夺与命运绞杀。",
    "start": 59.482,
    "end": 63.979,
    "duration": 4.497
  },
  {
    "id": 16,
    "text": "祥子的人生沉沦被严格结构在三次买车与失车的循环中：",
    "start": 64.32,
    "end": 68.856,
    "duration": 4.536
  },
  {
    "id": 17,
    "text": "苦熬三年买来的新车被军阀乱兵劫掠，是一落；",
    "start": 69.086,
    "end": 72.659,
    "duration": 3.573
  },
  {
    "id": 18,
    "text": "凭借卖骆驼拼命再攒的买车钱被反动特务孙侦探敲诈洗劫一空，",
    "start": 72.888,
    "end": 78.398,
    "duration": 5.51
  },
  {
    "id": 19,
    "text": "是二落；被迫与虎妞畸形结合后买下的二手车，",
    "start": 78.479,
    "end": 81.996,
    "duration": 3.517
  },
  {
    "id": 20,
    "text": "因虎妞难产母子双亡只得卖车办丧，是三落。",
    "start": 82.13,
    "end": 85.767,
    "duration": 3.637
  },
  {
    "id": 21,
    "text": "外部社会的三度掠夺，彻底封死了其诚实劳动的出路。",
    "start": 85.986,
    "end": 89.974,
    "duration": 3.988
  },
  {
    "id": 22,
    "text": "第三，性格变迁：",
    "start": 90.215,
    "end": 91.753,
    "duration": 1.538
  },
  {
    "id": 23,
    "text": "从积极自尊的模范车夫蜕变为麻木堕落的社会行尸。",
    "start": 91.872,
    "end": 96.546,
    "duration": 4.674
  },
  {
    "id": 24,
    "text": "在三度重创之后，",
    "start": 96.743,
    "end": 98.066,
    "duration": 1.323
  },
  {
    "id": 25,
    "text": "小福子在暗娼馆的自缢身亡切断了祥子与人性温情的最后纽带，",
    "start": 98.459,
    "end": 103.464,
    "duration": 5.005
  },
  {
    "id": 26,
    "text": "标志着其精神生命的彻底暴毙。",
    "start": 103.852,
    "end": 106.071,
    "duration": 2.219
  },
  {
    "id": 27,
    "text": "他从早先讲体面、厌恶烟酒的积极青年，彻底蜕化为吃喝嫖赌、",
    "start": 106.472,
    "end": 111.544,
    "duration": 5.072
  },
  {
    "id": 28,
    "text": "偷奸耍滑、靠出卖同伴阮明换取赏钱的城市流氓与行尸走肉，",
    "start": 111.733,
    "end": 116.794,
    "duration": 5.061
  },
  {
    "id": 29,
    "text": "展现了健全人性被黑暗旧社会剥蚀殆尽的残酷过程。",
    "start": 117.325,
    "end": 121.308,
    "duration": 3.983
  },
  {
    "id": 30,
    "text": "第四，悲剧成因：外部阶级压迫、",
    "start": 121.538,
    "end": 124.501,
    "duration": 2.963
  },
  {
    "id": 31,
    "text": "城市文明病腐蚀与孤立奋斗局限的必然结果。",
    "start": 124.679,
    "end": 128.068,
    "duration": 3.389
  },
  {
    "id": 32,
    "text": "祥子的毁灭是军阀特务横行、",
    "start": 128.186,
    "end": 130.628,
    "duration": 2.442
  },
  {
    "id": 33,
    "text": "刘四爷残酷剥削以及畸形商业城市欲望吞噬的合力产物；",
    "start": 130.713,
    "end": 135.114,
    "duration": 4.401
  },
  {
    "id": 34,
    "text": "老舍在篇尾将其定性为“个人主义的末路鬼”，",
    "start": 135.317,
    "end": 138.435,
    "duration": 3.118
  },
  {
    "id": 35,
    "text": "深刻揭示了在反动统治制度不倒的前提下，",
    "start": 138.608,
    "end": 141.811,
    "duration": 3.203
  },
  {
    "id": 36,
    "text": "脱离集体抗争的孤立个人奋斗注定粉身碎骨的历史真理。",
    "start": 142.053,
    "end": 146.157,
    "duration": 4.104
  },
  {
    "id": 37,
    "text": "综上所述，",
    "start": 146.479,
    "end": 147.199,
    "duration": 0.72
  },
  {
    "id": 38,
    "text": "祥子的悲剧是一个淳朴劳动者在旧体制绞杀下被毁灭的人性史诗，",
    "start": 147.534,
    "end": 153.293,
    "duration": 5.759
  },
  {
    "id": 39,
    "text": "老舍以此为黑暗旧时代敲响了沉痛的丧钟。",
    "start": 153.484,
    "end": 157.392,
    "duration": 3.908
  }
]
