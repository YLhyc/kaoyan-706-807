[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "郭沫若·女神自我抒情主人公与诗歌美学",
    "start": 0.134,
    "end": 3.675,
    "duration": 3.541
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "由“谁在抒情”到“心灵张力”再到“哲学与诗体”：先逐一清点《女神》里“大我/新人/神我/世界人”四维抒情自我，",
    "start": 4.264,
    "end": 14.302,
    "duration": 10.038
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "紧接翻看火山背面不为人注意的孤独与矛盾张力，",
    "start": 14.615,
    "end": 18.651,
    "duration": 4.035
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再揭示斯宾诺莎泛神论如何化出地球海洋太阳壮美意象，最后落于“情绪决定形式”的自由体解放。",
    "start": 18.752,
    "end": 26.824,
    "duration": 8.072
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "五四高潮时《女神》问世为现代新诗奠基之作，",
    "start": 27.411,
    "end": 31.342,
    "duration": 3.931
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "“个人的郁结，民族的郁结，在浪漫主义这里找到了喷火口”，",
    "start": 31.499,
    "end": 36.355,
    "duration": 4.856
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "塑造多维自我抒情主人公与现代浪漫崇高范式。",
    "start": 36.603,
    "end": 40.873,
    "duration": 4.27
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 塑造多维抒情主人公、融合“小我”与“大我”",
    "start": 41.46,
    "end": 45.756,
    "duration": 4.296
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "①《凤凰涅槃》集香木自焚更生，象征民族重生之“大我”；",
    "start": 46.33,
    "end": 52.592,
    "duration": 6.262
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "②《女神之再生》拒绝修补旧天高唱“创造新鲜的太阳”，塑另造天地“新人”；",
    "start": 52.866,
    "end": 59.636,
    "duration": 6.77
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "③《天狗》吞食日月高呼“我便是我”之“神我”；④《晨安》向世界文明致敬之“世界人”，具象化五四时代狂飙。",
    "start": 60.223,
    "end": 70.456,
    "duration": 10.233
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 揭示狂飙背后的矛盾与沉郁、见心灵脉动",
    "start": 71.043,
    "end": 75.6,
    "duration": 4.556
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "不止于狂热宣泄，深藏旧体制废墟上的孤独、眷恋与忏悔：",
    "start": 76.187,
    "end": 82.462,
    "duration": 6.275
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《天狗》自我膨胀伴随剥皮食肉凌迟；《湘累》创造后陷寥寂；",
    "start": 83.036,
    "end": 89.402,
    "duration": 6.366
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "《凤凰涅槃》终归“一切的一，和谐”泛神消融，真实度量启蒙裂变心脉。",
    "start": 89.611,
    "end": 95.899,
    "duration": 6.288
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 引入泛神论哲学、立狂飙壮美意象体系",
    "start": 96.473,
    "end": 100.613,
    "duration": 4.14
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "借斯宾诺莎泛神论提“我即是神”，化“泛我论”机制，山川雷电海洋皆成情感外化；",
    "start": 101.2,
    "end": 108.985,
    "duration": 7.785
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "扫除纤细阴柔感伤，《立在地球边上放号》将地球海洋太阳推向极境，颂“力的绘画”与“力的舞蹈”。",
    "start": 109.572,
    "end": 118.829,
    "duration": 9.257
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 打破声律镣铐、立“情绪决定形式”自由体",
    "start": 119.416,
    "end": 123.647,
    "duration": 4.231
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "反对旧格律与尝试派规约，主“诗的本职专在抒情”，外在节律服从内在情感自然流淌；",
    "start": 124.233,
    "end": 132.969,
    "duration": 8.736
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "《天狗》长短错落爆发自由体；《炉中煤》用重叠排比复沓造深沉回环声律，拓宽新诗表现力。",
    "start": 133.543,
    "end": 142.891,
    "duration": 9.348
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "郭沫若《女神》以喷火口之势统一民族精神、泛神哲学与诗体革命，开创中国现代浪漫主义新诗崭新篇章。",
    "start": 143.452,
    "end": 153.282,
    "duration": 9.83
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：《女神》主张“诗的本职专在抒情”与泛神论“我即是神”；",
    "start": 153.856,
    "end": 158.777,
    "duration": 4.921
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "注意区分郭沫若“太阳/海洋/地球”狂飙壮美意象与艾青“土地/太阳”深沉忧郁意象。",
    "start": 159.129,
    "end": 166.68,
    "duration": 7.551
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背清《女神》中“大我、新人、神我、世界人”四重抒情主人公及对应代表诗？",
    "start": 167.254,
    "end": 175.17,
    "duration": 7.916
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《天狗》《湘累》《立在地球边上放号》说明“狂飙背后的孤独”与“泛我论壮美”？",
    "start": 175.744,
    "end": 183.686,
    "duration": 7.942
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 如何用《天狗》《炉中煤》论证“情绪决定形式”的现代自由诗革命？",
    "start": 184.26,
    "end": 191.173,
    "duration": 6.913
  }
]