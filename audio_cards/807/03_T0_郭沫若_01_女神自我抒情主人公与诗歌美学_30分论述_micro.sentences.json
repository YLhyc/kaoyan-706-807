[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "郭沫若·女神自我抒情主人公与诗歌美学",
    "start": 0.154,
    "end": 3.846,
    "duration": 3.692
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "由“谁在抒情”到“心灵张力”再到“哲学与诗体”：先逐一清点《女神》里“大我/新人/神我/世界人”四维抒情自我，",
    "start": 4.554,
    "end": 15.286,
    "duration": 10.732
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "紧接翻看火山背面不为人注意的孤独与矛盾张力，",
    "start": 15.434,
    "end": 19.446,
    "duration": 4.012
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再揭示斯宾诺莎泛神论如何化出地球海洋太阳壮美意象，最后落于“情绪决定形式”的自由体解放。",
    "start": 19.514,
    "end": 28.406,
    "duration": 8.892
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "五四高潮时《女神》问世为现代新诗奠基之作，",
    "start": 28.905,
    "end": 32.597,
    "duration": 3.692
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "“个人的郁结，民族的郁结，在浪漫主义这里找到了喷火口”，",
    "start": 32.745,
    "end": 36.917,
    "duration": 4.172
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "塑造多维自我抒情主人公与现代浪漫崇高范式。",
    "start": 37.065,
    "end": 40.837,
    "duration": 3.772
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 塑造多维抒情主人公、融合“小我”与“大我”",
    "start": 41.518,
    "end": 45.77,
    "duration": 4.252
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "①《凤凰涅槃》集香木自焚更生，象征民族重生之“大我”；",
    "start": 46.298,
    "end": 52.07,
    "duration": 5.772
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "②《女神之再生》拒绝修补旧天高唱“创造新鲜的太阳”，塑另造天地“新人”；",
    "start": 52.348,
    "end": 59.32,
    "duration": 6.972
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "③《天狗》吞食日月高呼“我便是我”之“神我”；④《晨安》向世界文明致敬之“世界人”，具象化五四时代狂飙。",
    "start": 59.848,
    "end": 70.95,
    "duration": 11.102
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 揭示狂飙背后的矛盾与沉郁、见心灵脉动",
    "start": 71.658,
    "end": 76.15,
    "duration": 4.492
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "不止于狂热宣泄，深藏旧体制废墟上的孤独、眷恋与忏悔：",
    "start": 76.631,
    "end": 82.243,
    "duration": 5.612
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《天狗》自我膨胀伴随剥皮食肉凌迟；《湘累》创造后陷寥寂；",
    "start": 82.771,
    "end": 89.183,
    "duration": 6.412
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "《凤凰涅槃》终归“一切的一，和谐”泛神消融，真实度量启蒙裂变心脉。",
    "start": 89.571,
    "end": 96.063,
    "duration": 6.492
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 引入泛神论哲学、立狂飙壮美意象体系",
    "start": 96.623,
    "end": 100.955,
    "duration": 4.332
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "借斯宾诺莎泛神论提“我即是神”，化“泛我论”机制，山川雷电海洋皆成情感外化；",
    "start": 101.483,
    "end": 109.735,
    "duration": 8.252
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "扫除纤细阴柔感伤，《立在地球边上放号》将地球海洋太阳推向极境，颂“力的绘画”与“力的舞蹈”。",
    "start": 110.248,
    "end": 119.86,
    "duration": 9.612
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 打破声律镣铐、立“情绪决定形式”自由体",
    "start": 120.539,
    "end": 124.871,
    "duration": 4.332
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "反对旧格律与尝试派规约，主“诗的本职专在抒情”，外在节律服从内在情感自然流淌；",
    "start": 125.327,
    "end": 134.219,
    "duration": 8.892
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "《天狗》长短错落爆发自由体；《炉中煤》用重叠排比复沓造深沉回环声律，拓宽新诗表现力。",
    "start": 134.747,
    "end": 145.449,
    "duration": 10.702
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "郭沫若《女神》以喷火口之势统一民族精神、泛神哲学与诗体革命，开创中国现代浪漫主义新诗崭新篇章。",
    "start": 145.935,
    "end": 155.227,
    "duration": 9.292
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：《女神》主张“诗的本职专在抒情”与泛神论“我即是神”；",
    "start": 155.935,
    "end": 161.147,
    "duration": 5.212
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "注意区分郭沫若“太阳/海洋/地球”狂飙壮美意象与艾青“土地/太阳”深沉忧郁意象。",
    "start": 161.505,
    "end": 169.037,
    "duration": 7.532
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背清《女神》中“大我、新人、神我、世界人”四重抒情主人公及对应代表诗？",
    "start": 169.665,
    "end": 176.797,
    "duration": 7.132
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《天狗》《湘累》《立在地球边上放号》说明“狂飙背后的孤独”与“泛我论壮美”？",
    "start": 177.308,
    "end": 185.437,
    "duration": 8.129
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 如何用《天狗》《炉中煤》论证“情绪决定形式”的现代自由诗革命？",
    "start": 185.965,
    "end": 192.66,
    "duration": 6.695
  }
]