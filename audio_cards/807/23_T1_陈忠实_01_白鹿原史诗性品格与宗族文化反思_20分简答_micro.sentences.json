[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "宏观家族史诗（白鹿两家映近代变局）→微观宗法与人性撕裂（白嘉轩族规 vs 田小娥破窑本能）→神秘文化追问（白鹿神话+朱先生+鹿子霖疯癫冻毙），",
    "start": 0.0,
    "end": 13.2,
    "duration": 13.2
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "三层把关中平原厚重感立起来。",
    "start": 13.249,
    "end": 15.809,
    "duration": 2.56
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "九十年代初陈忠实《白鹿原》为当代贡献厚重现实主义力作，",
    "start": 16.259,
    "end": 20.939,
    "duration": 4.68
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "以关中白鹿村半世纪变迁为缩影，兼备史诗品格与宗族文化反思。",
    "start": 21.429,
    "end": 27.229,
    "duration": 5.8
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 家族秘史与民族命运交织的宏阔图景",
    "start": 27.679,
    "end": 31.439,
    "duration": 3.76
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "跳出单一政治图解，将辛亥革命、军阀混战、抗战烽火至政权更迭融入白、鹿两大家族数代沉浮；",
    "start": 31.889,
    "end": 40.089,
    "duration": 8.2
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "从白嘉轩巧计换地到国共两党原上博弈，",
    "start": 40.539,
    "end": 43.979,
    "duration": 3.44
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "描绘宗法农耕社会走向现代解体的全景图卷。",
    "start": 44.429,
    "end": 48.069,
    "duration": 3.64
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 剖析儒家宗法伦理与人性本能冲突",
    "start": 48.519,
    "end": 52.439,
    "duration": 3.92
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "族长白嘉轩挺直腰杆祠堂动用族规，承载传统儒家仁义坚守与冷酷专断；",
    "start": 52.889,
    "end": 59.089,
    "duration": 6.2
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "田小娥与黑娃代表受抑生命野性与情欲，",
    "start": 59.539,
    "end": 62.779,
    "duration": 3.24
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "田小娥遭公公鹿三刺杀、瘟疫爆发后被砖塔镇压，",
    "start": 63.309,
    "end": 67.309,
    "duration": 4.0
  },
  {
    "id": "sec1_step1_c2",
    "dom_key": "sec1_step1_c2",
    "text": "揭示礼教对人性的自我反噬。",
    "start": 67.759,
    "end": 70.199,
    "duration": 2.44
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 融关中民间神话与写实、生深沉哲理追问",
    "start": 70.649,
    "end": 75.489,
    "duration": 4.84
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "将关中“白鹿神话”、圣人朱先生预言与冷静历史写实相结合；",
    "start": 75.939,
    "end": 80.939,
    "duration": 5.0
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "借鹿子霖机关算尽却家破人亡、风雪疯癫冻毙结局，",
    "start": 81.389,
    "end": 85.989,
    "duration": 4.6
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "于兴替之上追问善恶报应、宗族消长与人性幽微，具苍茫历史感。",
    "start": 86.439,
    "end": 92.119,
    "duration": 5.68
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：核心人物记住族长白嘉轩（腰杆挺直/族规）、田小娥与黑娃（黑娃终遭枪决；",
    "start": 92.569,
    "end": 99.569,
    "duration": 7.0
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "田小娥遇刺后白鹿原闹瘟疫，",
    "start": 100.019,
    "end": 102.219,
    "duration": 2.2
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "被建砖塔镇压）、鹿三、鹿子霖（疯癫冻毙）、朱先生（圣人预言）。",
    "start": 102.749,
    "end": 108.109,
    "duration": 5.36
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 说出白嘉轩、田小娥、黑娃、鹿三、鹿子霖、朱先生在小说中的人物定位与最终归宿？",
    "start": 108.559,
    "end": 116.559,
    "duration": 8.0
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 阐明《白鹿原》如何以“白鹿两大家族+宗法本能冲突”体现文学与美学价值？",
    "start": 117.009,
    "end": 124.129,
    "duration": 7.12
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 解释“白鹿神话”与鹿子霖结局共同赋予作品怎样的历史苍茫感？",
    "start": 124.619,
    "end": 130.819,
    "duration": 6.2
  }
]