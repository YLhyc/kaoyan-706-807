[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "陈忠实·白鹿原史诗性品格与宗族文化反思",
    "start": 0.154,
    "end": 4.406,
    "duration": 4.252
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "宏观家族史诗（白鹿两家映近代变局）→微观宗法与人性撕裂（白嘉轩族规 vs 田小娥破窑本能）→神秘文化追问（白鹿神话+朱先生+鹿子霖疯癫冻毙），",
    "start": 5.374,
    "end": 20.826,
    "duration": 15.452
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "三层把关中平原厚重感立起来。",
    "start": 21.214,
    "end": 23.626,
    "duration": 2.412
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "九十年代初陈忠实《白鹿原》为当代贡献厚重现实主义力作，以关中白鹿村半世纪变迁为缩影，",
    "start": 24.594,
    "end": 32.446,
    "duration": 7.852
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "兼备史诗品格与宗族文化反思。",
    "start": 32.874,
    "end": 35.966,
    "duration": 3.092
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 家族秘史与民族命运交织的宏阔图景",
    "start": 36.894,
    "end": 41.066,
    "duration": 4.172
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "跳出单一政治图解，将辛亥革命、军阀混战、抗战烽火至政权更迭融入白、鹿两大家族数代沉浮；",
    "start": 42.034,
    "end": 52.166,
    "duration": 10.132
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "从白嘉轩巧计换地到国共两党原上博弈，描绘宗法农耕社会走向现代解体的全景图卷。",
    "start": 53.174,
    "end": 62.186,
    "duration": 9.012
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 剖析儒家宗法伦理与人性本能冲突",
    "start": 63.114,
    "end": 67.046,
    "duration": 3.932
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "族长白嘉轩挺直腰杆祠堂动用族规，承载传统儒家仁义坚守与冷酷专断；",
    "start": 68.054,
    "end": 76.506,
    "duration": 8.452
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "田小娥与黑娃代表受抑生命野性与情欲，田小娥遭公公鹿三刺杀、瘟疫爆发后被砖塔镇压，",
    "start": 77.554,
    "end": 86.646,
    "duration": 9.092
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "揭示礼教对人性的自我反噬。",
    "start": 86.874,
    "end": 89.086,
    "duration": 2.212
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 融关中民间神话与写实、生深沉哲理追问",
    "start": 90.094,
    "end": 95.386,
    "duration": 5.292
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "将关中“白鹿神话”、圣人朱先生预言与冷静历史写实相结合；",
    "start": 96.458,
    "end": 102.59,
    "duration": 6.132
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "借鹿子霖机关算尽却家破人亡、风雪疯癫冻毙结局，于兴替之上追问善恶报应、宗族消长与人性幽微，具苍茫历史感。",
    "start": 103.638,
    "end": 117.29,
    "duration": 13.652
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：核心人物记住族长白嘉轩（腰杆挺直/族规）、田小娥与黑娃（黑娃终遭枪决；田小娥遇刺后白鹿原闹瘟疫，被建砖塔镇压）、鹿三、鹿子霖（疯癫冻毙）、朱先生（圣人预言）。",
    "start": 118.338,
    "end": 136.41,
    "duration": 18.072
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 说出白嘉轩、田小娥、黑娃、鹿三、鹿子霖、朱先生在小说中的人物定位与最终归宿？",
    "start": 137.458,
    "end": 146.79,
    "duration": 9.332
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 阐明《白鹿原》如何以“白鹿两大家族+宗法本能冲突”体现文学与美学价值？",
    "start": 147.718,
    "end": 155.49,
    "duration": 7.772
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 解释“白鹿神话”与鹿子霖结局共同赋予作品怎样的历史苍茫感？",
    "start": 156.418,
    "end": 163.27,
    "duration": 6.852
  }
]