[
  {
    "id": 1,
    "text": "中国现当代文学纵向母题链与跨期对比急救卡。",
    "start": 0.122,
    "end": 4.106,
    "duration": 3.984
  },
  {
    "id": 2,
    "text": "碰见跨越现代与当代的演变综合大题或未背过的双作家比较题，",
    "start": 4.476,
    "end": 9.727,
    "duration": 5.251
  },
  {
    "id": 3,
    "text": "可即刻调用“两条核心演进主脉”与“横切四维通用公式”，",
    "start": 9.889,
    "end": 14.228,
    "duration": 4.339
  },
  {
    "id": 4,
    "text": "将已背单篇素材现场串联成文。",
    "start": 14.429,
    "end": 17.131,
    "duration": 2.702
  },
  {
    "id": 5,
    "text": "第一脉，乡土叙事与农民观百年演进线：鲁迅启蒙解剖，",
    "start": 17.762,
    "end": 22.654,
    "duration": 4.892
  },
  {
    "id": 6,
    "text": "沈从文边城抒情，赵树理改造翻身，汪曾祺返归日常诗学，",
    "start": 22.782,
    "end": 28.072,
    "duration": 5.29
  },
  {
    "id": 7,
    "text": "寻根文学深掘民族文化根性。",
    "start": 28.522,
    "end": 30.813,
    "duration": 2.291
  },
  {
    "id": 8,
    "text": "历史递变逻辑为：",
    "start": 31.322,
    "end": 32.468,
    "duration": 1.146
  },
  {
    "id": 9,
    "text": "五四鲁迅以《阿Q正传》《祝福》冷峻剖析国民劣根性与礼教麻木；",
    "start": 32.755,
    "end": 37.869,
    "duration": 5.114
  },
  {
    "id": 10,
    "text": "三十年代沈从文《边城》以湘西牧歌礼赞原始人性美；",
    "start": 38.155,
    "end": 42.523,
    "duration": 4.368
  },
  {
    "id": 11,
    "text": "四十年代赵树理《小二黑结婚》呈现解放区农民政治翻身与习俗惯性；",
    "start": 42.972,
    "end": 48.629,
    "duration": 5.657
  },
  {
    "id": 12,
    "text": "新时期初汪曾祺《受戒》复归民间和谐和美意境，随即韩少功、",
    "start": 48.983,
    "end": 55.351,
    "duration": 6.368
  },
  {
    "id": 13,
    "text": "阿城等寻根作家从风俗表象潜入民族文化积淀反思。",
    "start": 55.532,
    "end": 60.153,
    "duration": 4.621
  },
  {
    "id": 14,
    "text": "第二脉，都市体验与知识分子精神史线：郁达夫苦闷零余，",
    "start": 60.78,
    "end": 65.917,
    "duration": 5.137
  },
  {
    "id": 15,
    "text": "曹禺、茅盾宗法金融夹击，钱锺书《围城》讽刺虚妄，",
    "start": 66.342,
    "end": 70.839,
    "duration": 4.497
  },
  {
    "id": 16,
    "text": "张爱玲苍凉废墟，新时期朦胧诗与新写实双轨重审。",
    "start": 71.237,
    "end": 76.006,
    "duration": 4.769
  },
  {
    "id": 17,
    "text": "历史递变逻辑为：",
    "start": 76.538,
    "end": 77.792,
    "duration": 1.254
  },
  {
    "id": 18,
    "text": "郁达夫《沉沦》首先敞开觉醒个体的零余者痛感；",
    "start": 78.128,
    "end": 81.968,
    "duration": 3.84
  },
  {
    "id": 19,
    "text": "三十年代曹禺《雷雨》与茅盾《子夜》将困境接入宗法家庭压抑与半殖民地民族资本危机；",
    "start": 82.21,
    "end": 89.902,
    "duration": 7.692
  },
  {
    "id": 20,
    "text": "抗战时钱锺书讽刺文明夹缝中的文人浮躁，",
    "start": 90.32,
    "end": 93.836,
    "duration": 3.516
  },
  {
    "id": 21,
    "text": "张爱玲《金锁记》揭开世俗物欲下的苍凉人欲；",
    "start": 94.22,
    "end": 97.727,
    "duration": 3.507
  },
  {
    "id": 22,
    "text": "新时期则先由朦胧诗高擎良知觉醒，",
    "start": 98.074,
    "end": 101.079,
    "duration": 3.005
  },
  {
    "id": 23,
    "text": "再转入新写实对庸常琐碎生存的零度审视。",
    "start": 101.241,
    "end": 104.959,
    "duration": 3.718
  },
  {
    "id": 24,
    "text": "双作家或思潮比较大题严禁分写前后两截，",
    "start": 105.632,
    "end": 109.706,
    "duration": 4.074
  },
  {
    "id": 25,
    "text": "按“四维同框横切”逐层对撞推进。",
    "start": 110.045,
    "end": 113.184,
    "duration": 3.139
  },
  {
    "id": 26,
    "text": "固定推演骨架为：一比历史语境与题材重心差异，",
    "start": 113.958,
    "end": 118.124,
    "duration": 4.166
  },
  {
    "id": 27,
    "text": "二比人物心理或抒情主体姿态差异，三比叙述视角、",
    "start": 118.546,
    "end": 123.287,
    "duration": 4.741
  },
  {
    "id": 28,
    "text": "意象结构与语言修辞差异，",
    "start": 123.82,
    "end": 126.049,
    "duration": 2.229
  },
  {
    "id": 29,
    "text": "四比在百年文学现代化进程中的价值承接；",
    "start": 126.594,
    "end": 129.911,
    "duration": 3.317
  },
  {
    "id": 30,
    "text": "每点紧扣各自一个核心细节（如详子与祥林嫂、",
    "start": 130.2,
    "end": 133.984,
    "duration": 3.784
  },
  {
    "id": 31,
    "text": "延安与京派）交错印证，文脉自然紧凑。",
    "start": 134.196,
    "end": 137.454,
    "duration": 3.258
  }
]