[
  {
    "id": 1,
    "text": "中国现当代文学纵向母题链与跨期对比急救卡。",
    "start": 0.122,
    "end": 4.116,
    "duration": 3.994
  },
  {
    "id": 2,
    "text": "碰见跨越现代与当代的演变综合大题或未背过的双作家比较题，",
    "start": 4.616,
    "end": 9.86,
    "duration": 5.244
  },
  {
    "id": 3,
    "text": "可即刻调用“两条核心演进主脉”与“横切四维通用公式”，将已背单篇素材现场串联成文。",
    "start": 10.21,
    "end": 17.462,
    "duration": 7.252
  },
  {
    "id": 4,
    "text": "第一脉，乡土叙事与农民观百年演进线：鲁迅启蒙解剖，沈从文边城抒情，",
    "start": 18.083,
    "end": 24.629,
    "duration": 6.546
  },
  {
    "id": 5,
    "text": "赵树理改造翻身，汪曾祺返归日常诗学，寻根文学深掘民族文化根性。",
    "start": 25.107,
    "end": 31.142,
    "duration": 6.035
  },
  {
    "id": 6,
    "text": "历史递变逻辑为：五四鲁迅以《阿Q正传》《祝福》冷峻剖析国民劣根性与礼教麻木；",
    "start": 31.643,
    "end": 38.2,
    "duration": 6.557
  },
  {
    "id": 7,
    "text": "三十年代沈从文《边城》以湘西牧歌礼赞原始人性美；",
    "start": 38.7,
    "end": 43.078,
    "duration": 4.378
  },
  {
    "id": 8,
    "text": "四十年代赵树理《小二黑结婚》呈现解放区农民政治翻身与习俗惯性；",
    "start": 43.578,
    "end": 49.233,
    "duration": 5.655
  },
  {
    "id": 9,
    "text": "新时期初汪曾祺《受戒》复归民间和谐和美意境，",
    "start": 49.733,
    "end": 54.36,
    "duration": 4.627
  },
  {
    "id": 10,
    "text": "随即韩少功、阿城等寻根作家从风俗表象潜入民族文化积淀反思。",
    "start": 54.758,
    "end": 60.913,
    "duration": 6.155
  },
  {
    "id": 11,
    "text": "第二脉，都市体验与知识分子精神史线：郁达夫苦闷零余，曹禺、茅盾宗法金融夹击，",
    "start": 61.53,
    "end": 69.464,
    "duration": 7.934
  },
  {
    "id": 12,
    "text": "钱锺书《围城》讽刺虚妄，张爱玲苍凉废墟，新时期朦胧诗与新写实双轨重审。",
    "start": 69.814,
    "end": 76.786,
    "duration": 6.972
  },
  {
    "id": 13,
    "text": "历史递变逻辑为：郁达夫《沉沦》首先敞开觉醒个体的零余者痛感；",
    "start": 77.308,
    "end": 82.748,
    "duration": 5.44
  },
  {
    "id": 14,
    "text": "三十年代曹禺《雷雨》与茅盾《子夜》将困境接入宗法家庭压抑与半殖民地民族资本危机；",
    "start": 83.248,
    "end": 90.95,
    "duration": 7.702
  },
  {
    "id": 15,
    "text": "抗战时钱锺书讽刺文明夹缝中的文人浮躁，张爱玲《金锁记》揭开世俗物欲下的苍凉人欲；",
    "start": 91.45,
    "end": 98.867,
    "duration": 7.417
  },
  {
    "id": 16,
    "text": "新时期则先由朦胧诗高擎良知觉醒，再转入新写实对庸常琐碎生存的零度审视。",
    "start": 99.367,
    "end": 106.262,
    "duration": 6.895
  },
  {
    "id": 17,
    "text": "双作家或思潮比较大题严禁分写前后两截，按“四维同框横切”逐层对撞推进。",
    "start": 106.925,
    "end": 114.487,
    "duration": 7.562
  },
  {
    "id": 18,
    "text": "固定推演骨架为：一比历史语境与题材重心差异，二比人物心理或抒情主体姿态差异，",
    "start": 115.251,
    "end": 122.758,
    "duration": 7.507
  },
  {
    "id": 19,
    "text": "三比叙述视角、意象结构与语言修辞差异，四比在百年文学现代化进程中的价值承接；",
    "start": 123.352,
    "end": 131.212,
    "duration": 7.86
  },
  {
    "id": 20,
    "text": "每点紧扣各自一个核心细节（如祥子与祥林嫂、延安与京派）交错印证，文脉自然紧凑。",
    "start": 131.712,
    "end": 138.966,
    "duration": 7.254
  }
]
