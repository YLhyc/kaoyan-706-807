[
  {
    "id": 1,
    "text": "一、宏观结构推演与采分点映射。",
    "start": 0.08,
    "end": 3.2,
    "duration": 3.12
  },
  {
    "id": 2,
    "text": "本题标准分为三十分，论述结构采用高分“破题定性，",
    "start": 3.2,
    "end": 7.6,
    "duration": 4.4
  },
  {
    "id": 3,
    "text": "四大核心机制支柱，历史提升”逻辑模型：一、",
    "start": 7.6,
    "end": 11.44,
    "duration": 3.84
  },
  {
    "id": 4,
    "text": "破题总论层（约一百五十字）：界定时代坐标（七十年代末八十年代初）、",
    "start": 11.44,
    "end": 17.12,
    "duration": 5.68
  },
  {
    "id": 5,
    "text": "刊物与阵营（《今天》杂志、北岛舒婷顾城江河杨炼）、",
    "start": 17.12,
    "end": 21.2,
    "duration": 4.08
  },
  {
    "id": 6,
    "text": "历史功绩（打破政治工具论垄断、开创新诗现代转向）。",
    "start": 21.2,
    "end": 25.44,
    "duration": 4.24
  },
  {
    "id": 7,
    "text": "二、第一支柱：思想维度•主体反思与批判怀疑（北岛）：采分点为主体确立、",
    "start": 25.76,
    "end": 32.24,
    "duration": 6.48
  },
  {
    "id": 8,
    "text": "否定盲从、怀疑精神、《回答》经典名句。",
    "start": 32.24,
    "end": 35.84,
    "duration": 3.6
  },
  {
    "id": 9,
    "text": "三、第二支柱：思想维度•人性复苏与女性独立（舒婷）：采分点为人道主义、",
    "start": 35.84,
    "end": 42.56,
    "duration": 6.72
  },
  {
    "id": 10,
    "text": "尊严复归、平等独立、以苦难为底色的爱国主义（《致橡树》《祖国啊，",
    "start": 42.56,
    "end": 47.76,
    "duration": 5.2
  },
  {
    "id": 11,
    "text": "我亲爱的祖国》）。",
    "start": 47.76,
    "end": 48.72,
    "duration": 0.96
  },
  {
    "id": 12,
    "text": "四、第三支柱：艺术维度•象征隐喻与多义空间（顾城）：采分点为隐喻象征、",
    "start": 49.04,
    "end": 56.8,
    "duration": 7.76
  },
  {
    "id": 13,
    "text": "跳跃与通感、消解单义、开拓朦胧审美空间（《一代人》）。",
    "start": 56.8,
    "end": 61.84,
    "duration": 5.04
  },
  {
    "id": 14,
    "text": "五、第四支柱：艺术维度•自由节奏与史诗哲思（江河、",
    "start": 61.84,
    "end": 66.96,
    "duration": 5.12
  },
  {
    "id": 15,
    "text": "杨炼）：采分点为打破机械颂歌律动、",
    "start": 66.96,
    "end": 70.08,
    "duration": 3.12
  },
  {
    "id": 16,
    "text": "哲理思辨、民族史诗与崇高感。",
    "start": 70.08,
    "end": 72.56,
    "duration": 2.48
  },
  {
    "id": 17,
    "text": "六、总结提升层（约一百五十字）：文学史与思想启蒙的双重价值，",
    "start": 72.88,
    "end": 79.04,
    "duration": 6.16
  },
  {
    "id": 18,
    "text": "新美学原则确立的划时代意义。",
    "start": 79.04,
    "end": 82.08,
    "duration": 3.04
  },
  {
    "id": 19,
    "text": "二、逐段内部咬合与考场得分句推导。",
    "start": 82.08,
    "end": 85.84,
    "duration": 3.76
  },
  {
    "id": 20,
    "text": "破题段：时代背景与美学转折。",
    "start": 85.84,
    "end": 88.64,
    "duration": 2.8
  },
  {
    "id": 21,
    "text": "论证推演逻辑：先确立朦胧诗作为当代诗歌现代转向起点的崇高地位。",
    "start": 88.64,
    "end": 94.4,
    "duration": 5.76
  },
  {
    "id": 22,
    "text": "交代代表人物与《今天》阵营。",
    "start": 94.72,
    "end": 97.28,
    "duration": 2.56
  },
  {
    "id": 23,
    "text": "点出它与极左说教诗歌的决裂，点出“三个崛起”论争确立的合法性，",
    "start": 97.28,
    "end": 103.12,
    "duration": 5.84
  },
  {
    "id": 24,
    "text": "直接拉开论述大幕。",
    "start": 103.12,
    "end": 105.04,
    "duration": 1.92
  },
  {
    "id": 25,
    "text": "具体表述到答题语句就是：二十世纪七十年代末至八十年代初崛起的“朦胧诗”，",
    "start": 105.04,
    "end": 111.92,
    "duration": 6.88
  },
  {
    "id": 26,
    "text": "是中国新诗史上具有划时代意义的美学转折。",
    "start": 111.92,
    "end": 115.36,
    "duration": 3.44
  },
  {
    "id": 27,
    "text": "以北岛、舒婷、顾城、江河、杨炼等为代表的青年诗人，",
    "start": 115.76,
    "end": 120.32,
    "duration": 4.56
  },
  {
    "id": 28,
    "text": "依托民间刊物《今天》集结。",
    "start": 120.32,
    "end": 122.4,
    "duration": 2.08
  },
  {
    "id": 29,
    "text": "他们以强烈的反叛姿态，打破了十七年及文革时期政治工具论诗歌的单一模式。",
    "start": 122.4,
    "end": 128.48,
    "duration": 6.08
  },
  {
    "id": 30,
    "text": "朦胧诗在文坛引发了著名的美学大讨论。",
    "start": 128.48,
    "end": 131.92,
    "duration": 3.44
  },
  {
    "id": 31,
    "text": "谢冕的《在新的崛起面前》、孙绍振的《新的美学原则在崛起》与徐敬亚的《崛起的诗群》，",
    "start": 131.92,
    "end": 139.12,
    "duration": 7.2
  },
  {
    "id": 32,
    "text": "共同确立了新诗现代化的合法性。",
    "start": 139.12,
    "end": 141.36,
    "duration": 2.24
  },
  {
    "id": 33,
    "text": "朦胧诗的思想特征与艺术探索主要体现在四个核心维度。",
    "start": 141.68,
    "end": 146.32,
    "duration": 4.64
  },
  {
    "id": 34,
    "text": "二十世纪七十年代末至八十年代初崛起的“朦胧诗”，",
    "start": 146.624,
    "end": 150.944,
    "duration": 4.32
  },
  {
    "id": 35,
    "text": "是中国新诗史上具有划时代意义的美学转折。",
    "start": 150.944,
    "end": 154.624,
    "duration": 3.68
  },
  {
    "id": 36,
    "text": "以北岛、舒婷、顾城、江河、杨炼等为代表的青年诗人，",
    "start": 154.624,
    "end": 159.904,
    "duration": 5.28
  },
  {
    "id": 37,
    "text": "依托民间刊物《今天》集结。",
    "start": 159.904,
    "end": 161.904,
    "duration": 2.0
  },
  {
    "id": 38,
    "text": "他们以强烈的反叛姿态，打破了十七年及文革时期政治工具论诗歌的单一模式。",
    "start": 161.904,
    "end": 167.744,
    "duration": 5.84
  },
  {
    "id": 39,
    "text": "朦胧诗在文坛引发了著名的美学大讨论。",
    "start": 168.064,
    "end": 171.424,
    "duration": 3.36
  },
  {
    "id": 40,
    "text": "谢冕的《在新的崛起面前》、孙绍振的《新的美学原则在崛起》与徐敬亚的《崛起的诗群》，",
    "start": 171.424,
    "end": 179.024,
    "duration": 7.6
  },
  {
    "id": 41,
    "text": "共同确立了新诗现代化的合法性。",
    "start": 179.024,
    "end": 181.824,
    "duration": 2.8
  },
  {
    "id": 42,
    "text": "朦胧诗的思想特征与艺术探索主要体现在四个核心维度。",
    "start": 181.824,
    "end": 186.784,
    "duration": 4.96
  },
  {
    "id": 43,
    "text": "第一支柱：主体反思与批判怀疑精神（北岛）。",
    "start": 186.784,
    "end": 190.864,
    "duration": 4.08
  },
  {
    "id": 44,
    "text": "-论证推演逻辑：思想特征的第一核心是“人的觉醒”。",
    "start": 191.024,
    "end": 195.054,
    "duration": 4.03
  },
  {
    "id": 45,
    "text": "文革诗歌个体被宏大政治消解。",
    "start": 195.054,
    "end": 197.674,
    "duration": 2.62
  },
  {
    "id": 46,
    "text": "北岛树立了反思、批判与不盲从的抒情主人公。",
    "start": 197.674,
    "end": 201.502,
    "duration": 3.828
  },
  {
    "id": 47,
    "text": "结合《回答》名句“卑鄙是卑鄙者的通行证，",
    "start": 201.502,
    "end": 204.727,
    "duration": 3.225
  },
  {
    "id": 48,
    "text": "高尚是高尚者的墓志铭”与“我不相信”，",
    "start": 204.727,
    "end": 207.749,
    "duration": 3.022
  },
  {
    "id": 49,
    "text": "再结合《宣告》中“我只想做一个人”，",
    "start": 207.749,
    "end": 210.369,
    "duration": 2.62
  },
  {
    "id": 50,
    "text": "论证主体性的历史确立。",
    "start": 210.369,
    "end": 212.384,
    "duration": 2.015
  },
  {
    "id": 51,
    "text": "-具体表述到答题语句就是：第一，",
    "start": 212.384,
    "end": 215.073,
    "duration": 2.689
  },
  {
    "id": 52,
    "text": "主体意识觉醒与批判怀疑精神的建构。",
    "start": 215.073,
    "end": 218.383,
    "duration": 3.31
  },
  {
    "id": 53,
    "text": "文革时期的诗歌消解了个体，充斥着盲目的政治狂热。",
    "start": 218.383,
    "end": 222.933,
    "duration": 4.55
  },
  {
    "id": 54,
    "text": "朦胧诗首先确立了具有独立反思精神的人格主体。",
    "start": 222.933,
    "end": 227.277,
    "duration": 4.344
  },
  {
    "id": 55,
    "text": "北岛在《回答》中发出震天动地的绝响。",
    "start": 227.277,
    "end": 230.38,
    "duration": 3.103
  },
  {
    "id": 56,
    "text": "诗人宣称“卑鄙是卑鄙者的通行证，",
    "start": 230.38,
    "end": 233.276,
    "duration": 2.896
  },
  {
    "id": 57,
    "text": "高尚是高尚者的墓志铭”。",
    "start": 233.276,
    "end": 235.344,
    "duration": 2.068
  },
  {
    "id": 58,
    "text": "那句“我，不，相，信”不仅是对虚妄说教的否定，",
    "start": 235.424,
    "end": 239.184,
    "duration": 3.76
  },
  {
    "id": 59,
    "text": "更是时代理性与批判精神的庄严宣言。",
    "start": 239.184,
    "end": 242.544,
    "duration": 3.36
  },
  {
    "id": 60,
    "text": "在《宣告》中，北岛进一步写下“在没有英雄的年代里，",
    "start": 242.544,
    "end": 246.784,
    "duration": 4.24
  },
  {
    "id": 61,
    "text": "我只想做一个人”。",
    "start": 246.784,
    "end": 248.224,
    "duration": 1.44
  },
  {
    "id": 62,
    "text": "诗作从神化崇拜转向了冷峻的社会反思，",
    "start": 248.224,
    "end": 252.064,
    "duration": 3.84
  },
  {
    "id": 63,
    "text": "重新确立了诗人在历史面前的独立脊梁。",
    "start": 252.064,
    "end": 255.024,
    "duration": 2.96
  },
  {
    "id": 64,
    "text": "第一，主体意识觉醒与批判怀疑精神的建构。",
    "start": 255.392,
    "end": 259.392,
    "duration": 4.0
  },
  {
    "id": 65,
    "text": "文革时期的诗歌消解了个体，充斥着盲目的政治狂热。",
    "start": 259.392,
    "end": 264.352,
    "duration": 4.96
  },
  {
    "id": 66,
    "text": "朦胧诗首先确立了具有独立反思精神的人格主体。",
    "start": 264.352,
    "end": 268.832,
    "duration": 4.48
  },
  {
    "id": 67,
    "text": "北岛在《回答》中发出震天动地的绝响。",
    "start": 268.832,
    "end": 272.272,
    "duration": 3.44
  },
  {
    "id": 68,
    "text": "诗人宣称“卑鄙是卑鄙者的通行证，",
    "start": 272.272,
    "end": 275.392,
    "duration": 3.12
  },
  {
    "id": 69,
    "text": "高尚是高尚者的墓志铭”。",
    "start": 275.392,
    "end": 277.232,
    "duration": 1.84
  },
  {
    "id": 70,
    "text": "那句“我，不，相，信”不仅是对虚妄说教的否定，",
    "start": 277.552,
    "end": 281.312,
    "duration": 3.76
  },
  {
    "id": 71,
    "text": "更是时代理性与批判精神的庄严宣言。",
    "start": 281.312,
    "end": 284.672,
    "duration": 3.36
  },
  {
    "id": 72,
    "text": "在《宣告》中，北岛进一步写下“在没有英雄的年代里，",
    "start": 284.672,
    "end": 288.912,
    "duration": 4.24
  },
  {
    "id": 73,
    "text": "我只想做一个人”。",
    "start": 288.912,
    "end": 290.432,
    "duration": 1.52
  },
  {
    "id": 74,
    "text": "诗作从神化崇拜转向了冷峻的社会反思，",
    "start": 290.432,
    "end": 293.952,
    "duration": 3.52
  },
  {
    "id": 75,
    "text": "重新确立了诗人在历史面前的独立脊梁。",
    "start": 293.952,
    "end": 296.912,
    "duration": 2.96
  },
  {
    "id": 76,
    "text": "第二支柱：人性尊严复归与个体温情（舒婷）。",
    "start": 297.152,
    "end": 300.832,
    "duration": 3.68
  },
  {
    "id": 77,
    "text": "论证推演逻辑：思想特征的第二核心是温情的人道关怀。",
    "start": 300.832,
    "end": 305.232,
    "duration": 4.4
  },
  {
    "id": 78,
    "text": "舒婷弥补了北岛的刚硬冷峻，带来了女性的细腻与博爱。",
    "start": 305.232,
    "end": 309.072,
    "duration": 3.84
  },
  {
    "id": 79,
    "text": "结合《致橡树》论述平等人格，结合《神女峰》破除封建贞操神话，",
    "start": 309.072,
    "end": 313.472,
    "duration": 4.4
  },
  {
    "id": 80,
    "text": "结合《祖国啊，我亲爱的祖国》阐释苦难底色上的真挚情怀，",
    "start": 313.472,
    "end": 318.112,
    "duration": 4.64
  },
  {
    "id": 81,
    "text": "说明诗歌从政治说教回归个体心灵。",
    "start": 318.112,
    "end": 320.672,
    "duration": 2.56
  },
  {
    "id": 82,
    "text": "-具体表述到答题语句就是：第二，",
    "start": 320.832,
    "end": 323.306,
    "duration": 2.474
  },
  {
    "id": 83,
    "text": "人性尊严的复归与个体生命温度的呼唤。",
    "start": 323.306,
    "end": 326.541,
    "duration": 3.235
  },
  {
    "id": 84,
    "text": "朦胧诗打破了将人性等同于阶级斗争工具的教条，",
    "start": 326.541,
    "end": 330.537,
    "duration": 3.996
  },
  {
    "id": 85,
    "text": "将目光投向了人性的深层律动。",
    "start": 330.537,
    "end": 333.011,
    "duration": 2.474
  },
  {
    "id": 86,
    "text": "舒婷的诗作充满温润的人道关怀与女性自主意识。",
    "start": 333.011,
    "end": 337.007,
    "duration": 3.996
  },
  {
    "id": 87,
    "text": "《致橡树》彻底告别了传统依附式的情感模式。",
    "start": 337.007,
    "end": 340.432,
    "duration": 3.425
  },
  {
    "id": 88,
    "text": "诗作倡导男女双方如木棉与橡树般平等并立、",
    "start": 340.592,
    "end": 344.672,
    "duration": 4.08
  },
  {
    "id": 89,
    "text": "灵魂交融。",
    "start": 344.672,
    "end": 345.712,
    "duration": 1.04
  },
  {
    "id": 90,
    "text": "在《神女峰》中，舒婷更直接批判了千百年来束缚女性的贞操神话与虚妄牺牲。",
    "start": 345.712,
    "end": 351.952,
    "duration": 6.24
  },
  {
    "id": 91,
    "text": "在《祖国啊，我亲爱的祖国》中，诗人将对祖国的深情建立在对历史苦难的深沉承担之上。",
    "start": 351.952,
    "end": 359.152,
    "duration": 7.2
  },
  {
    "id": 92,
    "text": "诗歌重新恢复了人类真挚深沉的情感尊严。",
    "start": 359.152,
    "end": 362.752,
    "duration": 3.6
  },
  {
    "id": 93,
    "text": "第二，人性尊严的复归与个体生命温度的呼唤。",
    "start": 363.128,
    "end": 367.288,
    "duration": 4.16
  },
  {
    "id": 94,
    "text": "朦胧诗打破了将人性等同于阶级斗争工具的教条，",
    "start": 367.288,
    "end": 371.288,
    "duration": 4.0
  },
  {
    "id": 95,
    "text": "将目光投向了人性的深层律动。",
    "start": 371.288,
    "end": 374.008,
    "duration": 2.72
  },
  {
    "id": 96,
    "text": "舒婷的诗作充满温润的人道关怀与女性自主意识。",
    "start": 374.008,
    "end": 378.168,
    "duration": 4.16
  },
  {
    "id": 97,
    "text": "《致橡树》彻底告别了传统依附式的情感模式。",
    "start": 378.168,
    "end": 381.368,
    "duration": 3.2
  },
  {
    "id": 98,
    "text": "诗作倡导男女双方如木棉与橡树般平等并立、",
    "start": 381.768,
    "end": 386.008,
    "duration": 4.24
  },
  {
    "id": 99,
    "text": "灵魂交融。",
    "start": 386.008,
    "end": 387.128,
    "duration": 1.12
  },
  {
    "id": 100,
    "text": "在《神女峰》中，舒婷更直接批判了千百年来束缚女性的贞操神话与虚妄牺牲。",
    "start": 387.128,
    "end": 393.608,
    "duration": 6.48
  },
  {
    "id": 101,
    "text": "在《祖国啊，我亲爱的祖国》中，诗人将对祖国的深情建立在对历史苦难的深沉承担之上。",
    "start": 393.608,
    "end": 400.168,
    "duration": 6.56
  },
  {
    "id": 102,
    "text": "诗歌重新恢复了人类真挚深沉的情感尊严。",
    "start": 400.568,
    "end": 404.248,
    "duration": 3.68
  },
  {
    "id": 103,
    "text": "第三支柱：象征隐喻与多义空间（顾城）。",
    "start": 404.248,
    "end": 408.088,
    "duration": 3.84
  },
  {
    "id": 104,
    "text": "论证推演逻辑：转向艺术表现层。",
    "start": 408.088,
    "end": 411.128,
    "duration": 3.04
  },
  {
    "id": 105,
    "text": "朦胧诗之所以被指责“朦胧”，关键在隐喻、",
    "start": 411.128,
    "end": 414.488,
    "duration": 3.36
  },
  {
    "id": 106,
    "text": "象征与意象密集。",
    "start": 414.488,
    "end": 416.248,
    "duration": 1.76
  },
  {
    "id": 107,
    "text": "结合顾城《一代人》的名句，剖析黑夜、",
    "start": 416.248,
    "end": 419.288,
    "duration": 3.04
  },
  {
    "id": 108,
    "text": "黑眼睛、光明这套对位象征体系，再结合《弧线》的几何动态意象，",
    "start": 419.288,
    "end": 424.888,
    "duration": 5.6
  },
  {
    "id": 109,
    "text": "解释其如何打破了传统直白写实的单一语义，",
    "start": 424.888,
    "end": 428.728,
    "duration": 3.84
  },
  {
    "id": 110,
    "text": "赋予诗歌耐人寻味的审美张力。",
    "start": 428.728,
    "end": 430.968,
    "duration": 2.24
  },
  {
    "id": 111,
    "text": "-具体表述到答题语句就是：第三，",
    "start": 431.128,
    "end": 433.747,
    "duration": 2.619
  },
  {
    "id": 112,
    "text": "象征隐喻系统的开拓与多义性审美空间的建构。",
    "start": 433.747,
    "end": 437.777,
    "duration": 4.03
  },
  {
    "id": 113,
    "text": "朦胧诗彻底摒弃了简单直白的宣传性口号。",
    "start": 437.777,
    "end": 441.404,
    "duration": 3.627
  },
  {
    "id": 114,
    "text": "诗人们普遍借鉴西方现代主义象征手法，",
    "start": 441.404,
    "end": 444.829,
    "duration": 3.425
  },
  {
    "id": 115,
    "text": "大量运用通感、隐喻与意象跳跃。",
    "start": 444.829,
    "end": 447.448,
    "duration": 2.619
  },
  {
    "id": 116,
    "text": "顾城在《一代人》中写道，“黑夜给了我黑色的眼睛，",
    "start": 447.448,
    "end": 451.276,
    "duration": 3.828
  },
  {
    "id": 117,
    "text": "我却用它寻找光明”。",
    "start": 451.276,
    "end": 452.888,
    "duration": 1.612
  },
  {
    "id": 118,
    "text": "诗人用“黑夜”隐喻荒谬动荡的岁月，",
    "start": 453.048,
    "end": 456.328,
    "duration": 3.28
  },
  {
    "id": 119,
    "text": "用“黑眼睛”与“光明”象征不屈的精神探索。",
    "start": 456.328,
    "end": 460.008,
    "duration": 3.68
  },
  {
    "id": 120,
    "text": "而在《弧线》中，顾城更借助鸟儿、",
    "start": 460.008,
    "end": 462.888,
    "duration": 2.88
  },
  {
    "id": 121,
    "text": "圆木、飞浪等流动几何意象，捕捉生命瞬间的动态平衡。",
    "start": 462.888,
    "end": 467.768,
    "duration": 4.88
  },
  {
    "id": 122,
    "text": "繁复的意象叠加打破了语义的单一指向，",
    "start": 467.768,
    "end": 470.968,
    "duration": 3.2
  },
  {
    "id": 123,
    "text": "为读者创造了充满不确定性的多义阐释空间。",
    "start": 470.968,
    "end": 474.248,
    "duration": 3.28
  },
  {
    "id": 124,
    "text": "第三，象征隐喻系统的开拓与多义性审美空间的建构。",
    "start": 474.632,
    "end": 479.512,
    "duration": 4.88
  },
  {
    "id": 125,
    "text": "朦胧诗彻底摒弃了简单直白的宣传性口号。",
    "start": 479.512,
    "end": 483.192,
    "duration": 3.68
  },
  {
    "id": 126,
    "text": "诗人们普遍借鉴西方现代主义象征手法，",
    "start": 483.192,
    "end": 486.392,
    "duration": 3.2
  },
  {
    "id": 127,
    "text": "大量运用通感、隐喻与意象跳跃。",
    "start": 486.392,
    "end": 489.432,
    "duration": 3.04
  },
  {
    "id": 128,
    "text": "顾城在《一代人》中写道，“黑夜给了我黑色的眼睛，",
    "start": 489.432,
    "end": 493.432,
    "duration": 4.0
  },
  {
    "id": 129,
    "text": "我却用它寻找光明”。",
    "start": 493.432,
    "end": 495.032,
    "duration": 1.6
  },
  {
    "id": 130,
    "text": "诗人用“黑夜”隐喻荒谬动荡的岁月，",
    "start": 495.352,
    "end": 498.952,
    "duration": 3.6
  },
  {
    "id": 131,
    "text": "用“黑眼睛”与“光明”象征不屈的精神探索。",
    "start": 498.952,
    "end": 502.632,
    "duration": 3.68
  },
  {
    "id": 132,
    "text": "而在《弧线》中，顾城更借助鸟儿、",
    "start": 502.632,
    "end": 505.432,
    "duration": 2.8
  },
  {
    "id": 133,
    "text": "圆木、飞浪等流动几何意象，捕捉生命瞬间的动态平衡。",
    "start": 505.432,
    "end": 510.392,
    "duration": 4.96
  },
  {
    "id": 134,
    "text": "繁复的意象叠加打破了语义的单一指向，",
    "start": 510.392,
    "end": 513.752,
    "duration": 3.36
  },
  {
    "id": 135,
    "text": "为读者创造了充满不确定性的多义阐释空间。",
    "start": 513.752,
    "end": 517.592,
    "duration": 3.84
  },
  {
    "id": 136,
    "text": "第四支柱：自由节律与史诗哲思（江河、",
    "start": 517.912,
    "end": 521.672,
    "duration": 3.76
  },
  {
    "id": 137,
    "text": "杨炼）。",
    "start": 521.672,
    "end": 522.552,
    "duration": 0.88
  },
  {
    "id": 138,
    "text": "论证推演逻辑：艺术特征第四点关注形式节奏与哲思深度。",
    "start": 522.552,
    "end": 528.152,
    "duration": 5.6
  },
  {
    "id": 139,
    "text": "引入江河《纪念碑》与杨炼《诺日朗》，",
    "start": 528.152,
    "end": 531.112,
    "duration": 2.96
  },
  {
    "id": 140,
    "text": "指出诗歌形式不再是齐整的打油诗或颂歌分节，",
    "start": 531.112,
    "end": 535.512,
    "duration": 4.4
  },
  {
    "id": 141,
    "text": "而是依照心理起伏自由流淌，将现代诗提升到民族寻根与人类生存反思的崇高高度。",
    "start": 535.512,
    "end": 542.872,
    "duration": 7.36
  },
  {
    "id": 142,
    "text": "-具体表述到答题语句就是：第四，",
    "start": 543.032,
    "end": 545.657,
    "duration": 2.625
  },
  {
    "id": 143,
    "text": "自由沉郁的情感律动与哲理思辨色彩的融合。",
    "start": 545.657,
    "end": 549.494,
    "duration": 3.837
  },
  {
    "id": 144,
    "text": "朦胧诗人放弃了机械刻板的颂歌节律。",
    "start": 549.494,
    "end": 552.725,
    "duration": 3.231
  },
  {
    "id": 145,
    "text": "诗歌节奏完全服从于诗人内在情绪的跌宕起伏。",
    "start": 552.725,
    "end": 556.764,
    "duration": 4.039
  },
  {
    "id": 146,
    "text": "江河的《纪念碑》与杨炼的《诺日朗》，",
    "start": 556.764,
    "end": 559.389,
    "duration": 2.625
  },
  {
    "id": 147,
    "text": "将古老民族的历史创伤与崇高的悲剧崇高感相结合。",
    "start": 559.389,
    "end": 563.832,
    "duration": 4.443
  },
  {
    "id": 148,
    "text": "诗作熔铸着深沉博大的史诗情怀与哲理反思。",
    "start": 563.992,
    "end": 568.232,
    "duration": 4.24
  },
  {
    "id": 149,
    "text": "诗歌不再只是单纯的情绪宣泄，而成为对民族命运、",
    "start": 568.232,
    "end": 572.552,
    "duration": 4.32
  },
  {
    "id": 150,
    "text": "文化寻根与人类生存困境的深层哲理探索。",
    "start": 572.552,
    "end": 576.632,
    "duration": 4.08
  },
  {
    "id": 151,
    "text": "第四，自由沉郁的情感律动与哲理思辨色彩的融合。",
    "start": 576.632,
    "end": 581.432,
    "duration": 4.8
  },
  {
    "id": 152,
    "text": "朦胧诗人放弃了机械刻板的颂歌节律。",
    "start": 581.432,
    "end": 584.312,
    "duration": 2.88
  },
  {
    "id": 153,
    "text": "诗歌节奏完全服从于诗人内在情绪的跌宕起伏。",
    "start": 584.632,
    "end": 588.712,
    "duration": 4.08
  },
  {
    "id": 154,
    "text": "江河的《纪念碑》与杨炼的《诺日朗》，",
    "start": 588.712,
    "end": 591.752,
    "duration": 3.04
  },
  {
    "id": 155,
    "text": "将古老民族的历史创伤与崇高的悲剧崇高感相结合。",
    "start": 591.752,
    "end": 596.232,
    "duration": 4.48
  },
  {
    "id": 156,
    "text": "诗作熔铸着深沉博大的史诗情怀与哲理反思。",
    "start": 596.232,
    "end": 600.712,
    "duration": 4.48
  },
  {
    "id": 157,
    "text": "诗歌不再只是单纯的情绪宣泄，而成为对民族命运、",
    "start": 600.712,
    "end": 605.032,
    "duration": 4.32
  },
  {
    "id": 158,
    "text": "文化寻根与人类生存困境的深层哲理探索。",
    "start": 605.032,
    "end": 608.952,
    "duration": 3.92
  },
  {
    "id": 159,
    "text": "总结升华段：双重价值定位。",
    "start": 609.192,
    "end": 611.912,
    "duration": 2.72
  },
  {
    "id": 160,
    "text": "论证推演逻辑：结尾统合文学与思想双重价值。",
    "start": 611.912,
    "end": 616.552,
    "duration": 4.64
  },
  {
    "id": 161,
    "text": "强调朦胧诗作为新时期文学现代化号角的不可磨灭地位，",
    "start": 616.552,
    "end": 621.272,
    "duration": 4.72
  },
  {
    "id": 162,
    "text": "收束全篇。",
    "start": 621.272,
    "end": 622.392,
    "duration": 1.12
  },
  {
    "id": 163,
    "text": "具体表述到答题语句就是：朦胧诗的出现不仅更新了中国诗歌的现代美学观念，",
    "start": 622.392,
    "end": 628.6,
    "duration": 6.208
  },
  {
    "id": 164,
    "text": "更深远地参与了新时期思想启蒙的历史进程。",
    "start": 628.6,
    "end": 632.52,
    "duration": 3.92
  },
  {
    "id": 165,
    "text": "尽管它曾因意象晦涩而遭受保守势力的责难，",
    "start": 632.52,
    "end": 636.92,
    "duration": 4.4
  },
  {
    "id": 166,
    "text": "但它确立的独立思考姿态与现代诗歌表现范式，",
    "start": 636.92,
    "end": 641.08,
    "duration": 4.16
  },
  {
    "id": 167,
    "text": "为中国当代文学走向世界与现代性奠定了坚实的基石。",
    "start": 641.08,
    "end": 645.72,
    "duration": 4.64
  },
  {
    "id": 168,
    "text": "朦胧诗的出现不仅更新了中国诗歌的现代美学观念，",
    "start": 645.96,
    "end": 650.12,
    "duration": 4.16
  },
  {
    "id": 169,
    "text": "更深远地参与了新时期思想启蒙的历史进程。",
    "start": 650.12,
    "end": 654.04,
    "duration": 3.92
  },
  {
    "id": 170,
    "text": "尽管它曾因意象晦涩而遭受保守势力的责难，",
    "start": 654.04,
    "end": 658.44,
    "duration": 4.4
  },
  {
    "id": 171,
    "text": "但它确立的独立思考姿态与现代诗歌表现范式，",
    "start": 658.44,
    "end": 662.6,
    "duration": 4.16
  },
  {
    "id": 172,
    "text": "为中国当代文学走向世界与现代性奠定了坚实的基石。",
    "start": 662.6,
    "end": 667.24,
    "duration": 4.64
  }
]