[
  {
    "id": 1,
    "text": "一、宏观结构推演与采分点映射。",
    "start": 0.08,
    "end": 3.2,
    "duration": 3.12
  },
  {
    "id": 2,
    "text": "本题标准分为三十分，论述结构采用高分“破题定性，",
    "start": 3.2,
    "end": 7.6,
    "duration": 4.4
  },
  {
    "id": 3,
    "text": "四大核心机制支柱，历史提升”逻辑模型：一、",
    "start": 7.6,
    "end": 11.44,
    "duration": 3.84
  },
  {
    "id": 4,
    "text": "破题总论层（约一百五十字）：界定时代坐标（七十年代末八十年代初）、",
    "start": 11.44,
    "end": 17.12,
    "duration": 5.68
  },
  {
    "id": 5,
    "text": "刊物与阵营（《今天》杂志、北岛舒婷顾城江河杨炼）、",
    "start": 17.12,
    "end": 21.2,
    "duration": 4.08
  },
  {
    "id": 6,
    "text": "历史功绩（打破政治工具论垄断、开创新诗现代转向）。",
    "start": 21.2,
    "end": 25.44,
    "duration": 4.24
  },
  {
    "id": 7,
    "text": "二、第一支柱：思想维度•主体反思与批判怀疑（北岛）：采分点为主体确立、",
    "start": 25.76,
    "end": 32.72,
    "duration": 6.96
  },
  {
    "id": 8,
    "text": "否定盲从、怀疑精神、《回答》经典名句。",
    "start": 32.72,
    "end": 36.16,
    "duration": 3.44
  },
  {
    "id": 9,
    "text": "三、第二支柱：思想维度•人性复苏与女性独立（舒婷）：采分点为人道主义、",
    "start": 36.16,
    "end": 42.96,
    "duration": 6.8
  },
  {
    "id": 10,
    "text": "尊严复归、平等独立、以苦难为底色的爱国主义（《致橡树》《祖国啊，",
    "start": 42.96,
    "end": 48.96,
    "duration": 6.0
  },
  {
    "id": 11,
    "text": "我亲爱的祖国》）。",
    "start": 48.96,
    "end": 49.92,
    "duration": 0.96
  },
  {
    "id": 12,
    "text": "四、第三支柱：艺术维度•象征隐喻与多义空间（顾城）：采分点为隐喻象征、",
    "start": 50.32,
    "end": 58.08,
    "duration": 7.76
  },
  {
    "id": 13,
    "text": "跳跃与通感、消解单义、开拓朦胧审美空间（《一代人》）。",
    "start": 58.08,
    "end": 63.12,
    "duration": 5.04
  },
  {
    "id": 14,
    "text": "五、第四支柱：艺术维度•自由节奏与史诗哲思（江河、",
    "start": 63.12,
    "end": 68.24,
    "duration": 5.12
  },
  {
    "id": 15,
    "text": "杨炼）：采分点为打破机械颂歌律动、",
    "start": 68.24,
    "end": 71.36,
    "duration": 3.12
  },
  {
    "id": 16,
    "text": "哲理思辨、民族史诗与崇高感。",
    "start": 71.36,
    "end": 73.84,
    "duration": 2.48
  },
  {
    "id": 17,
    "text": "六、总结提升层（约一百五十字）：文学史与思想启蒙的双重价值，",
    "start": 74.16,
    "end": 79.68,
    "duration": 5.52
  },
  {
    "id": 18,
    "text": "新美学原则确立的划时代意义。。",
    "start": 79.68,
    "end": 81.92,
    "duration": 2.24
  },
  {
    "id": 19,
    "text": "二、逐段内部咬合与考场得分句推导。",
    "start": 81.92,
    "end": 85.44,
    "duration": 3.52
  },
  {
    "id": 20,
    "text": "破题段：时代背景与美学转折。",
    "start": 85.44,
    "end": 87.92,
    "duration": 2.48
  },
  {
    "id": 21,
    "text": "论证推演逻辑：先确立朦胧诗作为当代诗歌现代转向起点的崇高地位。",
    "start": 87.92,
    "end": 92.96,
    "duration": 5.04
  },
  {
    "id": 22,
    "text": "交代代表人物与《今天》阵营。",
    "start": 93.36,
    "end": 95.92,
    "duration": 2.56
  },
  {
    "id": 23,
    "text": "点出它与极左说教诗歌的决裂，点出“三个崛起”论争确立的合法性，",
    "start": 95.92,
    "end": 101.84,
    "duration": 5.92
  },
  {
    "id": 24,
    "text": "直接拉开论述大幕。",
    "start": 101.84,
    "end": 103.6,
    "duration": 1.76
  },
  {
    "id": 25,
    "text": "具体表述到答题语句就是：二十世纪七十年代末至八十年代初崛起的“朦胧诗”，",
    "start": 103.6,
    "end": 109.68,
    "duration": 6.08
  },
  {
    "id": 26,
    "text": "是中国新诗史上具有划时代意义的美学转折。",
    "start": 109.68,
    "end": 113.28,
    "duration": 3.6
  },
  {
    "id": 27,
    "text": "以北岛、舒婷、顾城、江河、杨炼等为代表的青年诗人，",
    "start": 113.68,
    "end": 118.24,
    "duration": 4.56
  },
  {
    "id": 28,
    "text": "依托民间刊物《今天》集结。",
    "start": 118.24,
    "end": 120.32,
    "duration": 2.08
  },
  {
    "id": 29,
    "text": "他们以强烈的反叛姿态，打破了十七年及文革时期政治工具论诗歌的单一模式。",
    "start": 120.32,
    "end": 126.4,
    "duration": 6.08
  },
  {
    "id": 30,
    "text": "朦胧诗在文坛引发了著名的美学大讨论。",
    "start": 126.4,
    "end": 129.84,
    "duration": 3.44
  },
  {
    "id": 31,
    "text": "谢冕的《在新的崛起面前》、孙绍振的《新的美学原则在崛起》与徐敬亚的《崛起的诗群》，",
    "start": 129.84,
    "end": 137.12,
    "duration": 7.28
  },
  {
    "id": 32,
    "text": "共同确立了新诗现代化的合法性。",
    "start": 137.12,
    "end": 139.68,
    "duration": 2.56
  },
  {
    "id": 33,
    "text": "朦胧诗的思想特征与艺术探索主要体现在四个核心维度。",
    "start": 139.92,
    "end": 144.56,
    "duration": 4.64
  },
  {
    "id": 34,
    "text": "二十世纪七十年代末至八十年代初崛起的“朦胧诗”，",
    "start": 144.928,
    "end": 148.688,
    "duration": 3.76
  },
  {
    "id": 35,
    "text": "是中国新诗史上具有划时代意义的美学转折。",
    "start": 148.688,
    "end": 152.128,
    "duration": 3.44
  },
  {
    "id": 36,
    "text": "以北岛、舒婷、顾城、江河、杨炼等为代表的青年诗人，",
    "start": 152.128,
    "end": 157.008,
    "duration": 4.88
  },
  {
    "id": 37,
    "text": "依托民间刊物《今天》集结。",
    "start": 157.008,
    "end": 158.928,
    "duration": 1.92
  },
  {
    "id": 38,
    "text": "他们以强烈的反叛姿态，打破了十七年及文革时期政治工具论诗歌的单一模式。",
    "start": 158.928,
    "end": 164.608,
    "duration": 5.68
  },
  {
    "id": 39,
    "text": "朦胧诗在文坛引发了著名的美学大讨论。",
    "start": 164.928,
    "end": 168.208,
    "duration": 3.28
  },
  {
    "id": 40,
    "text": "谢冕的《在新的崛起面前》、孙绍振的《新的美学原则在崛起》与徐敬亚的《崛起的诗群》，",
    "start": 168.208,
    "end": 176.608,
    "duration": 8.4
  },
  {
    "id": 41,
    "text": "共同确立了新诗现代化的合法性。",
    "start": 176.608,
    "end": 179.408,
    "duration": 2.8
  },
  {
    "id": 42,
    "text": "朦胧诗的思想特征与艺术探索主要体现在四个核心维度。--。",
    "start": 179.408,
    "end": 183.808,
    "duration": 4.4
  },
  {
    "id": 43,
    "text": "第一支柱：主体反思与批判怀疑精神（北岛）。",
    "start": 184.048,
    "end": 187.888,
    "duration": 3.84
  },
  {
    "id": 44,
    "text": "论证推演逻辑：思想特征的第一核心是“人的觉醒”。",
    "start": 187.888,
    "end": 192.208,
    "duration": 4.32
  },
  {
    "id": 45,
    "text": "文革诗歌个体被宏大政治消解。",
    "start": 192.208,
    "end": 194.528,
    "duration": 2.32
  },
  {
    "id": 46,
    "text": "北岛树立了反思、批判与不盲从的抒情主人公。",
    "start": 194.528,
    "end": 198.368,
    "duration": 3.84
  },
  {
    "id": 47,
    "text": "结合《回答》名句“卑鄙是卑鄙者的通行证，",
    "start": 198.368,
    "end": 201.568,
    "duration": 3.2
  },
  {
    "id": 48,
    "text": "高尚是高尚者的墓志铭”与“我不相信”，",
    "start": 201.568,
    "end": 204.608,
    "duration": 3.04
  },
  {
    "id": 49,
    "text": "再结合《宣告》中“我只想做一个人”，",
    "start": 204.608,
    "end": 207.008,
    "duration": 2.4
  },
  {
    "id": 50,
    "text": "论证主体性的历史确立。",
    "start": 207.008,
    "end": 208.448,
    "duration": 1.44
  },
  {
    "id": 51,
    "text": "-具体表述到答题语句就是：第一，",
    "start": 208.608,
    "end": 211.297,
    "duration": 2.689
  },
  {
    "id": 52,
    "text": "主体意识觉醒与批判怀疑精神的建构。",
    "start": 211.297,
    "end": 214.607,
    "duration": 3.31
  },
  {
    "id": 53,
    "text": "文革时期的诗歌消解了个体，充斥着盲目的政治狂热。",
    "start": 214.607,
    "end": 219.157,
    "duration": 4.55
  },
  {
    "id": 54,
    "text": "朦胧诗首先确立了具有独立反思精神的人格主体。",
    "start": 219.157,
    "end": 223.501,
    "duration": 4.344
  },
  {
    "id": 55,
    "text": "北岛在《回答》中发出震天动地的绝响。",
    "start": 223.501,
    "end": 226.604,
    "duration": 3.103
  },
  {
    "id": 56,
    "text": "诗人宣称“卑鄙是卑鄙者的通行证，",
    "start": 226.604,
    "end": 229.5,
    "duration": 2.896
  },
  {
    "id": 57,
    "text": "高尚是高尚者的墓志铭”。",
    "start": 229.5,
    "end": 231.568,
    "duration": 2.068
  },
  {
    "id": 58,
    "text": "那句“我，不，相，信”不仅是对虚妄说教的否定，",
    "start": 231.648,
    "end": 235.408,
    "duration": 3.76
  },
  {
    "id": 59,
    "text": "更是时代理性与批判精神的庄严宣言。",
    "start": 235.408,
    "end": 238.768,
    "duration": 3.36
  },
  {
    "id": 60,
    "text": "在《宣告》中，北岛进一步写下“在没有英雄的年代里，",
    "start": 238.768,
    "end": 243.008,
    "duration": 4.24
  },
  {
    "id": 61,
    "text": "我只想做一个人”。",
    "start": 243.008,
    "end": 244.528,
    "duration": 1.52
  },
  {
    "id": 62,
    "text": "诗作从神化崇拜转向了冷峻的社会反思，",
    "start": 244.528,
    "end": 248.048,
    "duration": 3.52
  },
  {
    "id": 63,
    "text": "重新确立了诗人在历史面前的独立脊梁。",
    "start": 248.048,
    "end": 251.008,
    "duration": 2.96
  },
  {
    "id": 64,
    "text": "第一，主体意识觉醒与批判怀疑精神的建构。",
    "start": 251.312,
    "end": 255.312,
    "duration": 4.0
  },
  {
    "id": 65,
    "text": "文革时期的诗歌消解了个体，充斥着盲目的政治狂热。",
    "start": 255.312,
    "end": 260.272,
    "duration": 4.96
  },
  {
    "id": 66,
    "text": "朦胧诗首先确立了具有独立反思精神的人格主体。",
    "start": 260.272,
    "end": 264.752,
    "duration": 4.48
  },
  {
    "id": 67,
    "text": "北岛在《回答》中发出震天动地的绝响。",
    "start": 264.752,
    "end": 268.192,
    "duration": 3.44
  },
  {
    "id": 68,
    "text": "诗人宣称“卑鄙是卑鄙者的通行证，",
    "start": 268.192,
    "end": 271.312,
    "duration": 3.12
  },
  {
    "id": 69,
    "text": "高尚是高尚者的墓志铭”。",
    "start": 271.312,
    "end": 273.152,
    "duration": 1.84
  },
  {
    "id": 70,
    "text": "那句“我，不，相，信”不仅是对虚妄说教的否定，",
    "start": 273.472,
    "end": 277.232,
    "duration": 3.76
  },
  {
    "id": 71,
    "text": "更是时代理性与批判精神的庄严宣言。",
    "start": 277.232,
    "end": 280.592,
    "duration": 3.36
  },
  {
    "id": 72,
    "text": "在《宣告》中，北岛进一步写下“在没有英雄的年代里，",
    "start": 280.592,
    "end": 284.832,
    "duration": 4.24
  },
  {
    "id": 73,
    "text": "我只想做一个人”。",
    "start": 284.832,
    "end": 286.352,
    "duration": 1.52
  },
  {
    "id": 74,
    "text": "诗作从神化崇拜转向了冷峻的社会反思，",
    "start": 286.352,
    "end": 289.872,
    "duration": 3.52
  },
  {
    "id": 75,
    "text": "重新确立了诗人在历史面前的独立脊梁。",
    "start": 289.872,
    "end": 292.832,
    "duration": 2.96
  },
  {
    "id": 76,
    "text": "---。第",
    "start": 292.992,
    "end": 293.199,
    "duration": 0.207
  },
  {
    "id": 77,
    "text": "二支柱：人性尊严复归与个体温情（舒婷）。",
    "start": 293.199,
    "end": 296.517,
    "duration": 3.318
  },
  {
    "id": 78,
    "text": "论证推演逻辑：思想特征的第二核心是温情的人道关怀。",
    "start": 296.517,
    "end": 301.286,
    "duration": 4.769
  },
  {
    "id": 79,
    "text": "舒婷弥补了北岛的刚硬冷峻，带来了女性的细腻与博爱。",
    "start": 301.286,
    "end": 306.056,
    "duration": 4.77
  },
  {
    "id": 80,
    "text": "结合《致橡树》论述平等人格，结合《神女峰》破除封建贞操神话，",
    "start": 306.056,
    "end": 311.032,
    "duration": 4.976
  },
  {
    "id": 81,
    "text": "结合《祖国啊，我亲爱的祖国》阐释苦难底色上的真挚情怀，",
    "start": 311.032,
    "end": 315.802,
    "duration": 4.77
  },
  {
    "id": 82,
    "text": "说明诗歌从政治说教回归个体心灵。",
    "start": 315.802,
    "end": 318.912,
    "duration": 3.11
  },
  {
    "id": 83,
    "text": "-具体表述到答题语句就是：第二，",
    "start": 318.912,
    "end": 321.386,
    "duration": 2.474
  },
  {
    "id": 84,
    "text": "人性尊严的复归与个体生命温度的呼唤。",
    "start": 321.386,
    "end": 324.621,
    "duration": 3.235
  },
  {
    "id": 85,
    "text": "朦胧诗打破了将人性等同于阶级斗争工具的教条，",
    "start": 324.621,
    "end": 328.617,
    "duration": 3.996
  },
  {
    "id": 86,
    "text": "将目光投向了人性的深层律动。",
    "start": 328.617,
    "end": 331.091,
    "duration": 2.474
  },
  {
    "id": 87,
    "text": "舒婷的诗作充满温润的人道关怀与女性自主意识。",
    "start": 331.091,
    "end": 335.087,
    "duration": 3.996
  },
  {
    "id": 88,
    "text": "《致橡树》彻底告别了传统依附式的情感模式。",
    "start": 335.087,
    "end": 338.512,
    "duration": 3.425
  },
  {
    "id": 89,
    "text": "诗作倡导男女双方如木棉与橡树般平等并立、",
    "start": 338.672,
    "end": 342.752,
    "duration": 4.08
  },
  {
    "id": 90,
    "text": "灵魂交融。",
    "start": 342.752,
    "end": 343.792,
    "duration": 1.04
  },
  {
    "id": 91,
    "text": "在《神女峰》中，舒婷更直接批判了千百年来束缚女性的贞操神话与虚妄牺牲。",
    "start": 343.792,
    "end": 350.032,
    "duration": 6.24
  },
  {
    "id": 92,
    "text": "在《祖国啊，我亲爱的祖国》中，诗人将对祖国的深情建立在对历史苦难的深沉承担之上。",
    "start": 350.032,
    "end": 357.232,
    "duration": 7.2
  },
  {
    "id": 93,
    "text": "诗歌重新恢复了人类真挚深沉的情感尊严。",
    "start": 357.232,
    "end": 360.832,
    "duration": 3.6
  },
  {
    "id": 94,
    "text": "第二，人性尊严的复归与个体生命温度的呼唤。",
    "start": 361.208,
    "end": 365.368,
    "duration": 4.16
  },
  {
    "id": 95,
    "text": "朦胧诗打破了将人性等同于阶级斗争工具的教条，",
    "start": 365.368,
    "end": 369.368,
    "duration": 4.0
  },
  {
    "id": 96,
    "text": "将目光投向了人性的深层律动。",
    "start": 369.368,
    "end": 372.088,
    "duration": 2.72
  },
  {
    "id": 97,
    "text": "舒婷的诗作充满温润的人道关怀与女性自主意识。",
    "start": 372.088,
    "end": 376.248,
    "duration": 4.16
  },
  {
    "id": 98,
    "text": "《致橡树》彻底告别了传统依附式的情感模式。",
    "start": 376.248,
    "end": 379.448,
    "duration": 3.2
  },
  {
    "id": 99,
    "text": "诗作倡导男女双方如木棉与橡树般平等并立、",
    "start": 379.848,
    "end": 384.088,
    "duration": 4.24
  },
  {
    "id": 100,
    "text": "灵魂交融。",
    "start": 384.088,
    "end": 385.288,
    "duration": 1.2
  },
  {
    "id": 101,
    "text": "在《神女峰》中，舒婷更直接批判了千百年来束缚女性的贞操神话与虚妄牺牲。",
    "start": 385.288,
    "end": 392.008,
    "duration": 6.72
  },
  {
    "id": 102,
    "text": "在《祖国啊，我亲爱的祖国》中，诗人将对祖国的深情建立在对历史苦难的深沉承担之上。",
    "start": 392.008,
    "end": 398.728,
    "duration": 6.72
  },
  {
    "id": 103,
    "text": "诗歌重新恢复了人类真挚深沉的情感尊严。",
    "start": 399.048,
    "end": 402.968,
    "duration": 3.92
  },
  {
    "id": 104,
    "text": "--。第",
    "start": 402.968,
    "end": 403.128,
    "duration": 0.16
  },
  {
    "id": 105,
    "text": "三支柱：象征隐喻与多义空间（顾城）。",
    "start": 403.128,
    "end": 406.408,
    "duration": 3.28
  },
  {
    "id": 106,
    "text": "论证推演逻辑：转向艺术表现层。",
    "start": 406.408,
    "end": 409.208,
    "duration": 2.8
  },
  {
    "id": 107,
    "text": "朦胧诗之所以被指责“朦胧”，关键在隐喻、",
    "start": 409.208,
    "end": 412.248,
    "duration": 3.04
  },
  {
    "id": 108,
    "text": "象征与意象密集。",
    "start": 412.248,
    "end": 414.088,
    "duration": 1.84
  },
  {
    "id": 109,
    "text": "结合顾城《一代人》的名句，剖析黑夜、",
    "start": 414.088,
    "end": 417.128,
    "duration": 3.04
  },
  {
    "id": 110,
    "text": "黑眼睛、光明这套对位象征体系，再结合《弧线》的几何动态意象，",
    "start": 417.128,
    "end": 422.248,
    "duration": 5.12
  },
  {
    "id": 111,
    "text": "解释其如何打破了传统直白写实的单一语义，",
    "start": 422.248,
    "end": 425.688,
    "duration": 3.44
  },
  {
    "id": 112,
    "text": "赋予诗歌耐人寻味的审美张力。",
    "start": 425.688,
    "end": 428.088,
    "duration": 2.4
  },
  {
    "id": 113,
    "text": "-具体表述到答题语句就是：第三，",
    "start": 428.248,
    "end": 430.867,
    "duration": 2.619
  },
  {
    "id": 114,
    "text": "象征隐喻系统的开拓与多义性审美空间的建构。",
    "start": 430.867,
    "end": 434.897,
    "duration": 4.03
  },
  {
    "id": 115,
    "text": "朦胧诗彻底摒弃了简单直白的宣传性口号。",
    "start": 434.897,
    "end": 438.524,
    "duration": 3.627
  },
  {
    "id": 116,
    "text": "诗人们普遍借鉴西方现代主义象征手法，",
    "start": 438.524,
    "end": 441.949,
    "duration": 3.425
  },
  {
    "id": 117,
    "text": "大量运用通感、隐喻与意象跳跃。",
    "start": 441.949,
    "end": 444.568,
    "duration": 2.619
  },
  {
    "id": 118,
    "text": "顾城在《一代人》中写道，“黑夜给了我黑色的眼睛，",
    "start": 444.568,
    "end": 448.396,
    "duration": 3.828
  },
  {
    "id": 119,
    "text": "我却用它寻找光明”。",
    "start": 448.396,
    "end": 450.008,
    "duration": 1.612
  },
  {
    "id": 120,
    "text": "诗人用“黑夜”隐喻荒谬动荡的岁月，",
    "start": 450.168,
    "end": 453.528,
    "duration": 3.36
  },
  {
    "id": 121,
    "text": "用“黑眼睛”与“光明”象征不屈的精神探索。",
    "start": 453.528,
    "end": 457.208,
    "duration": 3.68
  },
  {
    "id": 122,
    "text": "而在《弧线》中，顾城更借助鸟儿、",
    "start": 457.208,
    "end": 460.008,
    "duration": 2.8
  },
  {
    "id": 123,
    "text": "圆木、飞浪等流动几何意象，捕捉生命瞬间的动态平衡。",
    "start": 460.008,
    "end": 464.808,
    "duration": 4.8
  },
  {
    "id": 124,
    "text": "繁复的意象叠加打破了语义的单一指向，",
    "start": 464.808,
    "end": 468.168,
    "duration": 3.36
  },
  {
    "id": 125,
    "text": "为读者创造了充满不确定性的多义阐释空间。",
    "start": 468.168,
    "end": 471.848,
    "duration": 3.68
  },
  {
    "id": 126,
    "text": "第三，象征隐喻系统的开拓与多义性审美空间的建构。",
    "start": 472.136,
    "end": 476.776,
    "duration": 4.64
  },
  {
    "id": 127,
    "text": "朦胧诗彻底摒弃了简单直白的宣传性口号。",
    "start": 476.776,
    "end": 480.296,
    "duration": 3.52
  },
  {
    "id": 128,
    "text": "诗人们普遍借鉴西方现代主义象征手法，",
    "start": 480.296,
    "end": 483.496,
    "duration": 3.2
  },
  {
    "id": 129,
    "text": "大量运用通感、隐喻与意象跳跃。",
    "start": 483.496,
    "end": 486.536,
    "duration": 3.04
  },
  {
    "id": 130,
    "text": "顾城在《一代人》中写道，“黑夜给了我黑色的眼睛，",
    "start": 486.536,
    "end": 490.296,
    "duration": 3.76
  },
  {
    "id": 131,
    "text": "我却用它寻找光明”。",
    "start": 490.296,
    "end": 491.736,
    "duration": 1.44
  },
  {
    "id": 132,
    "text": "诗人用“黑夜”隐喻荒谬动荡的岁月，",
    "start": 492.136,
    "end": 495.416,
    "duration": 3.28
  },
  {
    "id": 133,
    "text": "用“黑眼睛”与“光明”象征不屈的精神探索。",
    "start": 495.416,
    "end": 499.096,
    "duration": 3.68
  },
  {
    "id": 134,
    "text": "而在《弧线》中，顾城更借助鸟儿、",
    "start": 499.096,
    "end": 501.976,
    "duration": 2.88
  },
  {
    "id": 135,
    "text": "圆木、飞浪等流动几何意象，捕捉生命瞬间的动态平衡。",
    "start": 501.976,
    "end": 506.856,
    "duration": 4.88
  },
  {
    "id": 136,
    "text": "繁复的意象叠加打破了语义的单一指向，",
    "start": 506.856,
    "end": 510.056,
    "duration": 3.2
  },
  {
    "id": 137,
    "text": "为读者创造了充满不确定性的多义阐释空间。",
    "start": 510.056,
    "end": 513.336,
    "duration": 3.28
  },
  {
    "id": 138,
    "text": "第四支柱：自由节律与史诗哲思（江河、",
    "start": 513.656,
    "end": 517.016,
    "duration": 3.36
  },
  {
    "id": 139,
    "text": "杨炼）。。",
    "start": 517.016,
    "end": 517.576,
    "duration": 0.56
  },
  {
    "id": 140,
    "text": "论证推演逻辑：艺术特征第四点关注形式节奏与哲思深度。",
    "start": 517.576,
    "end": 522.376,
    "duration": 4.8
  },
  {
    "id": 141,
    "text": "引入江河《纪念碑》与杨炼《诺日朗》，",
    "start": 522.376,
    "end": 525.336,
    "duration": 2.96
  },
  {
    "id": 142,
    "text": "指出诗歌形式不再是齐整的打油诗或颂歌分节，",
    "start": 525.336,
    "end": 529.976,
    "duration": 4.64
  },
  {
    "id": 143,
    "text": "而是依照心理起伏自由流淌，将现代诗提升到民族寻根与人类生存反思的崇高高度。",
    "start": 529.976,
    "end": 537.256,
    "duration": 7.28
  },
  {
    "id": 144,
    "text": "-具体表述到答题语句就是：第四，",
    "start": 537.496,
    "end": 540.071,
    "duration": 2.575
  },
  {
    "id": 145,
    "text": "自由沉郁的情感律动与哲理思辨色彩的融合。",
    "start": 540.071,
    "end": 543.834,
    "duration": 3.763
  },
  {
    "id": 146,
    "text": "朦胧诗人放弃了机械刻板的颂歌节律。",
    "start": 543.834,
    "end": 547.003,
    "duration": 3.169
  },
  {
    "id": 147,
    "text": "诗歌节奏完全服从于诗人内在情绪的跌宕起伏。",
    "start": 547.003,
    "end": 550.964,
    "duration": 3.961
  },
  {
    "id": 148,
    "text": "江河的《纪念碑》与杨炼的《诺日朗》，",
    "start": 550.964,
    "end": 553.539,
    "duration": 2.575
  },
  {
    "id": 149,
    "text": "将古老民族的历史创伤与崇高的悲剧崇高感相结合。",
    "start": 553.539,
    "end": 557.896,
    "duration": 4.357
  },
  {
    "id": 150,
    "text": "诗作熔铸着深沉博大的史诗情怀与哲理反思。",
    "start": 558.056,
    "end": 562.456,
    "duration": 4.4
  },
  {
    "id": 151,
    "text": "诗歌不再只是单纯的情绪宣泄，而成为对民族命运、",
    "start": 562.456,
    "end": 566.776,
    "duration": 4.32
  },
  {
    "id": 152,
    "text": "文化寻根与人类生存困境的形而上哲思探索。",
    "start": 566.776,
    "end": 571.256,
    "duration": 4.48
  },
  {
    "id": 153,
    "text": "第四，自由沉郁的情感律动与哲理思辨色彩的融合。",
    "start": 571.256,
    "end": 576.216,
    "duration": 4.96
  },
  {
    "id": 154,
    "text": "朦胧诗人放弃了机械刻板的颂歌节律。",
    "start": 576.216,
    "end": 579.176,
    "duration": 2.96
  },
  {
    "id": 155,
    "text": "诗歌节奏完全服从于诗人内在情绪的跌宕起伏。",
    "start": 579.496,
    "end": 583.496,
    "duration": 4.0
  },
  {
    "id": 156,
    "text": "江河的《纪念碑》与杨炼的《诺日朗》，",
    "start": 583.496,
    "end": 586.296,
    "duration": 2.8
  },
  {
    "id": 157,
    "text": "将古老民族的历史创伤与崇高的悲剧崇高感相结合。",
    "start": 586.296,
    "end": 591.016,
    "duration": 4.72
  },
  {
    "id": 158,
    "text": "诗作熔铸着深沉博大的史诗情怀与哲理反思。",
    "start": 591.016,
    "end": 595.576,
    "duration": 4.56
  },
  {
    "id": 159,
    "text": "诗歌不再只是单纯的情绪宣泄，而成为对民族命运、",
    "start": 595.576,
    "end": 599.816,
    "duration": 4.24
  },
  {
    "id": 160,
    "text": "文化寻根与人类生存困境的形而上哲思探索。",
    "start": 599.816,
    "end": 603.656,
    "duration": 3.84
  },
  {
    "id": 161,
    "text": "---。总",
    "start": 603.816,
    "end": 604.027,
    "duration": 0.211
  },
  {
    "id": 162,
    "text": "结升华段：双重价值定位。",
    "start": 604.027,
    "end": 606.137,
    "duration": 2.11
  },
  {
    "id": 163,
    "text": "论证推演逻辑：结尾统合文学与思想双重价值。",
    "start": 606.137,
    "end": 610.146,
    "duration": 4.009
  },
  {
    "id": 164,
    "text": "强调朦胧诗作为新时期文学现代化号角的不可磨灭地位，",
    "start": 610.146,
    "end": 615.211,
    "duration": 5.065
  },
  {
    "id": 165,
    "text": "收束全篇。",
    "start": 615.211,
    "end": 616.055,
    "duration": 0.844
  },
  {
    "id": 166,
    "text": "具体表述到答题语句就是：朦胧诗的出现不仅更新了中国诗歌的现代美学观念，",
    "start": 616.055,
    "end": 622.672,
    "duration": 6.617
  },
  {
    "id": 167,
    "text": "更深远地参与了新时期思想启蒙的历史进程。",
    "start": 622.672,
    "end": 626.592,
    "duration": 3.92
  },
  {
    "id": 168,
    "text": "尽管它曾因意象晦涩而遭受保守势力的责难，",
    "start": 626.592,
    "end": 630.992,
    "duration": 4.4
  },
  {
    "id": 169,
    "text": "但它确立的独立思考姿态与现代诗歌表现范式，",
    "start": 630.992,
    "end": 635.152,
    "duration": 4.16
  },
  {
    "id": 170,
    "text": "为中国当代文学走向世界与现代性奠定了坚实的基石。",
    "start": 635.152,
    "end": 639.792,
    "duration": 4.64
  },
  {
    "id": 171,
    "text": "朦胧诗的出现不仅更新了中国诗歌的现代美学观念，",
    "start": 640.032,
    "end": 644.192,
    "duration": 4.16
  },
  {
    "id": 172,
    "text": "更深远地参与了新时期思想启蒙的历史进程。",
    "start": 644.192,
    "end": 648.112,
    "duration": 3.92
  },
  {
    "id": 173,
    "text": "尽管它曾因意象晦涩而遭受保守势力的责难，",
    "start": 648.112,
    "end": 652.512,
    "duration": 4.4
  },
  {
    "id": 174,
    "text": "但它确立的独立思考姿态与现代诗歌表现范式，",
    "start": 652.512,
    "end": 656.672,
    "duration": 4.16
  },
  {
    "id": 175,
    "text": "为中国当代文学走向世界与现代性奠定了坚实的基石。",
    "start": 656.672,
    "end": 661.312,
    "duration": 4.64
  }
]