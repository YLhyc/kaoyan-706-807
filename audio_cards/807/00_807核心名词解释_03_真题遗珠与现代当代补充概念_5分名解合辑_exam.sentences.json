[
  {
    "id": 1,
    "text": "807 核心名词解释（三）：",
    "start": 0.124,
    "end": 2.029,
    "duration": 1.905
  },
  {
    "id": 2,
    "text": "真题遗珠与现当代高频补充概念（5分名解合辑）。",
    "start": 2.329,
    "end": 6.864,
    "duration": 4.535
  },
  {
    "id": 3,
    "text": "1. 延安文艺座谈会讲话。",
    "start": 7.177,
    "end": 9.079,
    "duration": 1.902
  },
  {
    "id": 4,
    "text": "抗战相持阶段毛泽东在延安发表的马克思主义文艺纲领性文献。",
    "start": 9.371,
    "end": 14.289,
    "duration": 4.918
  },
  {
    "id": 5,
    "text": "讲话直面解放区文艺脱离群众与抗战实际的矛盾，",
    "start": 14.663,
    "end": 18.652,
    "duration": 3.989
  },
  {
    "id": 6,
    "text": "明确提出文艺“为什么人”和“如何服务”的根本问题，",
    "start": 18.912,
    "end": 22.934,
    "duration": 4.022
  },
  {
    "id": 7,
    "text": "确立文艺为工农兵服务的方向，",
    "start": 23.231,
    "end": 25.655,
    "duration": 2.424
  },
  {
    "id": 8,
    "text": "强调作家深入工农兵生活并实现“化”的转变。",
    "start": 26.117,
    "end": 30.094,
    "duration": 3.977
  },
  {
    "id": 9,
    "text": "它直接指导了赵树理《小二黑结婚》、",
    "start": 30.501,
    "end": 33.157,
    "duration": 2.656
  },
  {
    "id": 10,
    "text": "丁玲《太阳照在桑干河上》及歌剧《白毛女》等解放区创作，",
    "start": 33.651,
    "end": 38.466,
    "duration": 4.815
  },
  {
    "id": 11,
    "text": "成为中国当代文艺格局的直接思想源头。",
    "start": 38.614,
    "end": 41.868,
    "duration": 3.254
  },
  {
    "id": 12,
    "text": "2. 第一次文代会。",
    "start": 42.114,
    "end": 43.705,
    "duration": 1.591
  },
  {
    "id": 13,
    "text": "建国前夕在北平召开的中华全国文学艺术工作者代表大会的简称。",
    "start": 43.955,
    "end": 49.541,
    "duration": 5.586
  },
  {
    "id": 14,
    "text": "大会正式选举郭沫若为主席，",
    "start": 49.726,
    "end": 51.964,
    "duration": 2.238
  },
  {
    "id": 15,
    "text": "成立全国文联并创办《人民文学》《文艺报》等核心机关刊物，",
    "start": 52.192,
    "end": 57.033,
    "duration": 4.841
  },
  {
    "id": 16,
    "text": "总结国统区与解放区两支文艺队伍的经验，",
    "start": 57.199,
    "end": 60.651,
    "duration": 3.452
  },
  {
    "id": 17,
    "text": "正式将毛泽东文艺思想确立为新中国文艺的基本指导方针。",
    "start": 60.919,
    "end": 65.446,
    "duration": 4.527
  },
  {
    "id": 18,
    "text": "这次会议在文学史分期中标志着中国现代文学阶段的结束与中国当代文学的正式开端。",
    "start": 66.141,
    "end": 72.836,
    "duration": 6.695
  },
  {
    "id": 19,
    "text": "3. 底层写作。",
    "start": 73.423,
    "end": 74.938,
    "duration": 1.515
  },
  {
    "id": 20,
    "text": "九十年代后期兴起并延续至新世纪初的重要当代现实主义写作潮流。",
    "start": 75.206,
    "end": 80.702,
    "duration": 5.496
  },
  {
    "id": 21,
    "text": "写作主体自觉贴近社会转型期的下岗工人、",
    "start": 80.831,
    "end": 84.059,
    "duration": 3.228
  },
  {
    "id": 22,
    "text": "农民工及城乡边缘弱势群体，",
    "start": 84.208,
    "end": 86.307,
    "duration": 2.099
  },
  {
    "id": 23,
    "text": "延续五四“为人生”与关注“被损害者与被侮辱者”的写实传统。",
    "start": 86.443,
    "end": 91.165,
    "duration": 4.722
  },
  {
    "id": 24,
    "text": "代表倾向包括方方早期写实转向、",
    "start": 91.445,
    "end": 94.226,
    "duration": 2.781
  },
  {
    "id": 25,
    "text": "新世纪农民工叙事及打工诗歌群落。",
    "start": 94.631,
    "end": 97.606,
    "duration": 2.975
  },
  {
    "id": 26,
    "text": "虽个别作品因商业迎合引来“消费苦难”之议，",
    "start": 97.886,
    "end": 101.698,
    "duration": 3.812
  },
  {
    "id": 27,
    "text": "整体上仍彰显了当代文学深切的平民关怀。",
    "start": 101.974,
    "end": 105.356,
    "duration": 3.382
  },
  {
    "id": 28,
    "text": "4. 戴望舒。",
    "start": 105.778,
    "end": 107.112,
    "duration": 1.334
  },
  {
    "id": 29,
    "text": "三十年代以《现代》杂志为核心阵地的现代派诗歌主将。",
    "start": 107.686,
    "end": 111.669,
    "duration": 3.983
  },
  {
    "id": 30,
    "text": "针对新月派过分追求外形格律齐整的倾向，",
    "start": 111.922,
    "end": 115.281,
    "duration": 3.359
  },
  {
    "id": 31,
    "text": "他吸收法国象征主义暗示美学，提出诗歌“重在情绪的节奏”、",
    "start": 115.795,
    "end": 120.729,
    "duration": 4.934
  },
  {
    "id": 32,
    "text": "追求散文自由与诗意朦胧。",
    "start": 121.303,
    "end": 123.551,
    "duration": 2.248
  },
  {
    "id": 33,
    "text": "早期代表作《雨巷》以丁香姑娘象征可遇而不可求的怅惘，",
    "start": 124.123,
    "end": 128.407,
    "duration": 4.284
  },
  {
    "id": 34,
    "text": "集作《我的记忆》《望舒草》颇具代表；",
    "start": 128.813,
    "end": 131.633,
    "duration": 2.82
  },
  {
    "id": 35,
    "text": "抗战爆发后转向写实爱国抒情，著有《灾难的岁月》，",
    "start": 131.92,
    "end": 136.288,
    "duration": 4.368
  },
  {
    "id": 36,
    "text": "完成了从个人迷惘到民族受难者的诗风转折。",
    "start": 136.641,
    "end": 139.964,
    "duration": 3.323
  },
  {
    "id": 37,
    "text": "5. 京派文学。",
    "start": 140.321,
    "end": 141.803,
    "duration": 1.482
  },
  {
    "id": 38,
    "text": "三十年代活跃于北方京津一带、",
    "start": 142.366,
    "end": 144.647,
    "duration": 2.281
  },
  {
    "id": 39,
    "text": "以《大公报·文艺副刊》《水星》等刊物为阵地的自由主义文学群体。",
    "start": 145.184,
    "end": 149.838,
    "duration": 4.654
  },
  {
    "id": 40,
    "text": "理论领袖有朱光潜、沈从文，主要作家包括废名、萧乾、芦焚、",
    "start": 150.338,
    "end": 156.275,
    "duration": 5.937
  },
  {
    "id": 41,
    "text": "汪曾祺等。",
    "start": 156.563,
    "end": 157.274,
    "duration": 0.711
  },
  {
    "id": 42,
    "text": "作家坚持文学自律与“稳健清正”品格，",
    "start": 157.656,
    "end": 160.759,
    "duration": 3.103
  },
  {
    "id": 43,
    "text": "远离商业媚俗与党派喧嚣，",
    "start": 161.1,
    "end": 163.1,
    "duration": 2.0
  },
  {
    "id": 44,
    "text": "擅以冲淡抒情之笔描摹乡村宗法风俗与未遭污染的常态人性美。",
    "start": 163.369,
    "end": 168.812,
    "duration": 5.443
  },
  {
    "id": 45,
    "text": "代表作有沈从文《边城》、废名《竹林的故事》，",
    "start": 169.242,
    "end": 172.72,
    "duration": 3.478
  },
  {
    "id": 46,
    "text": "拓展了现代抒情散文化小说路径。",
    "start": 173.116,
    "end": 175.694,
    "duration": 2.578
  },
  {
    "id": 47,
    "text": "6. 海派文学。",
    "start": 176.394,
    "end": 177.7,
    "duration": 1.306
  },
  {
    "id": 48,
    "text": "二三十至四十年代依托上海都会印刷市场与市民报刊兴起的现代城市文学流派。",
    "start": 178.016,
    "end": 184.321,
    "duration": 6.305
  },
  {
    "id": 49,
    "text": "创作阵营涵盖早期市民言情作家，三十年代以施蛰存、刘呐鸥、",
    "start": 184.512,
    "end": 189.578,
    "duration": 5.066
  },
  {
    "id": 50,
    "text": "穆时英为代表的“新感觉派”，以及四十年代张爱玲、",
    "start": 189.715,
    "end": 193.152,
    "duration": 3.437
  },
  {
    "id": 51,
    "text": "苏青等都市生活写作。",
    "start": 193.312,
    "end": 194.833,
    "duration": 1.521
  },
  {
    "id": 52,
    "text": "作品紧扣现代都市霓虹消费、快节奏声色刺激、",
    "start": 195.111,
    "end": 199.221,
    "duration": 4.11
  },
  {
    "id": 53,
    "text": "潜意识与心理焦虑，借鉴蒙太奇与精神分析技法，",
    "start": 199.55,
    "end": 203.6,
    "duration": 4.05
  },
  {
    "id": 54,
    "text": "生动折射了半殖民地大都市奇异的现代性体验。",
    "start": 204.026,
    "end": 207.866,
    "duration": 3.84
  },
  {
    "id": 55,
    "text": "7. 太阳社与“左联”。",
    "start": 208.291,
    "end": 210.105,
    "duration": 1.814
  },
  {
    "id": 56,
    "text": "大革命失败后在上海倡导并领导无产阶级革命文学的两个核心阵营。",
    "start": 210.473,
    "end": 215.457,
    "duration": 4.984
  },
  {
    "id": 57,
    "text": "太阳社由蒋光慈、钱杏邨等主持，",
    "start": 215.751,
    "end": 218.466,
    "duration": 2.715
  },
  {
    "id": 58,
    "text": "与后期创造社一道率先号召“革命文学”；随后在鲁迅、冯雪峰、",
    "start": 218.666,
    "end": 224.094,
    "duration": 5.428
  },
  {
    "id": 59,
    "text": "沈端先等推动下联合成立中国左翼作家联盟（简称“左联”），",
    "start": 224.307,
    "end": 228.784,
    "duration": 4.477
  },
  {
    "id": 60,
    "text": "鲁迅在成立大会上发表《对于左翼作家联盟的意见》。",
    "start": 229.177,
    "end": 232.924,
    "duration": 3.747
  },
  {
    "id": 61,
    "text": "它们坚持马克思主义文艺导向、",
    "start": 233.291,
    "end": 235.355,
    "duration": 2.064
  },
  {
    "id": 62,
    "text": "反击文化“围剿”并倡导文艺大众化，",
    "start": 235.673,
    "end": 238.383,
    "duration": 2.71
  },
  {
    "id": 63,
    "text": "凝聚了三十年代左翼文学主力。",
    "start": 238.557,
    "end": 240.789,
    "duration": 2.232
  },
  {
    "id": 64,
    "text": "8. 《围城》。",
    "start": 241.312,
    "end": 242.305,
    "duration": 0.993
  },
  {
    "id": 65,
    "text": "四十年代钱锺书创作的一部风格独异的现代长篇讽刺小说。",
    "start": 242.455,
    "end": 246.968,
    "duration": 4.513
  },
  {
    "id": 66,
    "text": "小说围绕留学归来的方鸿渐从上海辗转内地三闾大学任教及恋爱婚变经历展开，",
    "start": 247.307,
    "end": 253.531,
    "duration": 6.224
  },
  {
    "id": 67,
    "text": "借“城外的人想冲进去，城里的人想逃出来”人生喻象，",
    "start": 253.749,
    "end": 258.093,
    "duration": 4.344
  },
  {
    "id": 68,
    "text": "辛辣剖示抗战年代受中西文化夹击的知识分子的怯懦、",
    "start": 258.502,
    "end": 263.026,
    "duration": 4.524
  },
  {
    "id": 69,
    "text": "虚伪与精神失落。",
    "start": 263.459,
    "end": 264.899,
    "duration": 1.44
  },
  {
    "id": 70,
    "text": "作品机智奇喻纷呈、反讽冷隽犀利，",
    "start": 265.298,
    "end": 268.655,
    "duration": 3.357
  },
  {
    "id": 71,
    "text": "把中国现代世态讽刺小说推向新高峰。",
    "start": 269.097,
    "end": 272.041,
    "duration": 2.944
  },
  {
    "id": 72,
    "text": "9. 七月诗派。",
    "start": 272.682,
    "end": 273.953,
    "duration": 1.271
  },
  {
    "id": 73,
    "text": "抗战爆发后围绕胡风主编的《七月》《希望》杂志聚集起来的现实主义自由诗群体。",
    "start": 274.049,
    "end": 280.062,
    "duration": 6.013
  },
  {
    "id": 74,
    "text": "主要诗人有艾青、田间、阿垅、绿原、鲁藜、牛汉、曾卓等，",
    "start": 280.171,
    "end": 285.353,
    "duration": 5.182
  },
  {
    "id": 75,
    "text": "当代复出后曾编选诗合集《白色花》。",
    "start": 285.487,
    "end": 288.27,
    "duration": 2.783
  },
  {
    "id": 76,
    "text": "诗派继承“主观战斗精神”诗论，摒弃唯美雕琢与标语空喊，",
    "start": 288.563,
    "end": 292.988,
    "duration": 4.425
  },
  {
    "id": 77,
    "text": "追随自由诗体与“散文美”，以粗犷雄浑的力度、",
    "start": 293.254,
    "end": 297.231,
    "duration": 3.977
  },
  {
    "id": 78,
    "text": "土地泥土意象歌吟抗战血火中的民族生机与生命体验，",
    "start": 297.698,
    "end": 302.544,
    "duration": 4.846
  },
  {
    "id": 79,
    "text": "成为四十年代诗坛重要生力军。",
    "start": 302.957,
    "end": 305.216,
    "duration": 2.259
  },
  {
    "id": 80,
    "text": "10. “三红一创”。",
    "start": 306.028,
    "end": 307.585,
    "duration": 1.557
  },
  {
    "id": 81,
    "text": "当代“十七年”时期反映革命历史与农村合作化运动四部长篇小说的合称。",
    "start": 308.096,
    "end": 313.889,
    "duration": 5.793
  },
  {
    "id": 82,
    "text": "具体指吴强《红日》、梁斌《红旗谱》、",
    "start": 314.122,
    "end": 317.458,
    "duration": 3.336
  },
  {
    "id": 83,
    "text": "罗广斌与杨益言《红岩》以及柳青《创业史》（第一部）。",
    "start": 317.941,
    "end": 322.042,
    "duration": 4.101
  },
  {
    "id": 84,
    "text": "作品大多采取宏阔史诗结构与鲜明阶级人物谱系，",
    "start": 322.521,
    "end": 326.765,
    "duration": 4.244
  },
  {
    "id": 85,
    "text": "讲述革命创业、地下斗争与乡土变革传奇，",
    "start": 327.263,
    "end": 330.826,
    "duration": 3.563
  },
  {
    "id": 86,
    "text": "集中体现十七年长篇小说“红色经典”建构革命记忆与集体认同的美学范式。",
    "start": 331.289,
    "end": 337.475,
    "duration": 6.186
  }
]