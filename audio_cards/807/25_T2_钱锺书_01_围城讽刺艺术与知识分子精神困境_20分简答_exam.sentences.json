[
  {
    "id": 1,
    "text": "四十年代中后期，钱锺书发表长篇小说《围城》，",
    "start": 0.0,
    "end": 4.265,
    "duration": 4.265
  },
  {
    "id": 2,
    "text": "以精微绝伦的学者化笔墨，",
    "start": 4.265,
    "end": 6.549,
    "duration": 2.284
  },
  {
    "id": 3,
    "text": "在中国现代文学史上构筑起一部解剖现代病态知识分子灵魂的现代“儒林外史”。",
    "start": 6.549,
    "end": 13.34,
    "duration": 6.791
  },
  {
    "id": 4,
    "text": "作品的思想意蕴与讽刺艺术主要展现于以下三个层面：",
    "start": 13.34,
    "end": 17.822,
    "duration": 4.482
  },
  {
    "id": 5,
    "text": "第一，建构“围城”哲学隐喻，",
    "start": 17.822,
    "end": 20.326,
    "duration": 2.504
  },
  {
    "id": 6,
    "text": "揭示人类普遍存在的生存悖论与精神围困。",
    "start": 20.326,
    "end": 24.059,
    "duration": 3.733
  },
  {
    "id": 7,
    "text": "小说借法国谚语引申出全书核心命题：",
    "start": 24.059,
    "end": 27.737,
    "duration": 3.678
  },
  {
    "id": 8,
    "text": "“围在城里的人想冲出来，城外的人想冲进去”。",
    "start": 27.737,
    "end": 33.983,
    "duration": 6.246
  },
  {
    "id": 9,
    "text": "方鸿渐从欧洲留学归国，在求职、恋爱与家庭生活中屡屡挣扎；",
    "start": 33.983,
    "end": 40.078,
    "duration": 6.095
  },
  {
    "id": 10,
    "text": "他既渴望摆脱传统包办婚姻，又陷入与苏文纨、",
    "start": 40.078,
    "end": 43.544,
    "duration": 3.466
  },
  {
    "id": 11,
    "text": "唐晓芙的错位情感；与孙柔嘉结婚后，",
    "start": 43.544,
    "end": 45.005,
    "duration": 1.461
  },
  {
    "id": 12,
    "text": "日常生活迅速被鸡毛蒜皮与姑嫂龃龉彻底吞噬。",
    "start": 45.005,
    "end": 49.099,
    "duration": 4.094
  },
  {
    "id": 13,
    "text": "小说通过这一荒诞困局，",
    "start": 49.099,
    "end": 51.205,
    "duration": 2.106
  },
  {
    "id": 14,
    "text": "深刻揭示了现代人在物质欲望与精神追求中进退维谷的形而上困境。",
    "start": 51.205,
    "end": 59.971,
    "duration": 8.766
  },
  {
    "id": 15,
    "text": "第二，运用博雅精妙的学者修辞，开创机锋闪烁的幽默讽刺美学。",
    "start": 59.971,
    "end": 67.773,
    "duration": 7.802
  },
  {
    "id": 16,
    "text": "钱锺书将西方修辞智慧与中国传统诗话妙喻融为一体，",
    "start": 67.773,
    "end": 74.143,
    "duration": 6.37
  },
  {
    "id": 17,
    "text": "大量运用奇特新颖的通感与连环比喻。",
    "start": 74.143,
    "end": 77.407,
    "duration": 3.264
  },
  {
    "id": 18,
    "text": "小说中将鲍小姐的裸露装束戏谑为“熟食铺子”与“局部的真理”，",
    "start": 77.407,
    "end": 83.897,
    "duration": 6.49
  },
  {
    "id": 19,
    "text": "将汪处厚太太的打扮比作“精装插图本”，",
    "start": 83.897,
    "end": 88.256,
    "duration": 4.359
  },
  {
    "id": 20,
    "text": "在不动声色的调侃与睿智反讽中，",
    "start": 88.256,
    "end": 91.766,
    "duration": 3.51
  },
  {
    "id": 21,
    "text": "把虚荣庸俗的现代洋场名流剥落得体无完肤。",
    "start": 91.766,
    "end": 94.457,
    "duration": 2.691
  },
  {
    "id": 22,
    "text": "第三，冷峻解剖三闾大学灰色众生相，",
    "start": 94.457,
    "end": 98.278,
    "duration": 3.821
  },
  {
    "id": 23,
    "text": "揭露现代知识阶层的虚伪与平庸。",
    "start": 98.278,
    "end": 101.18,
    "duration": 2.902
  },
  {
    "id": 24,
    "text": "小说后半部通过赴三闾大学执教的漫长旅途，",
    "start": 101.18,
    "end": 104.58,
    "duration": 3.4
  },
  {
    "id": 25,
    "text": "展现了一个浓缩的病态中国知识界。",
    "start": 104.58,
    "end": 106.071,
    "duration": 1.491
  },
  {
    "id": 26,
    "text": "校长高松年表面忠厚实则老谋深算，",
    "start": 106.071,
    "end": 109.921,
    "duration": 3.85
  },
  {
    "id": 27,
    "text": "买办教授韩学愈靠购买爱尔兰骗子的克莱登大学假文凭招摇过市，",
    "start": 109.921,
    "end": 115.165,
    "duration": 5.244
  },
  {
    "id": 28,
    "text": "学者之间为争夺课时与派系利益明枪暗箭、勾心斗角，",
    "start": 115.165,
    "end": 117.738,
    "duration": 2.573
  },
  {
    "id": 29,
    "text": "生动暴露出传统官场恶习与西方半吊子文明杂交而成的知识界劣根性。",
    "start": 117.738,
    "end": 121.231,
    "duration": 3.493
  }
]