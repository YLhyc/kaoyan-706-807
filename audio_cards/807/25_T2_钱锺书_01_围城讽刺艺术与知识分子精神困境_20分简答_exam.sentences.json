[
  {
    "id": 1,
    "text": "四十年代中后期，钱锺书发表长篇小说《围城》，以精妙犀利的学者化笔墨，",
    "start": 0.12,
    "end": 6.078,
    "duration": 5.958
  },
  {
    "id": 2,
    "text": "在现代文学史上写就了一部剖析知识分子病态灵魂的“新儒林外史”。",
    "start": 6.448,
    "end": 11.923,
    "duration": 5.475
  },
  {
    "id": 3,
    "text": "作品的思想意蕴与讽刺艺术主要展现于以下三个层面：",
    "start": 12.443,
    "end": 16.623,
    "duration": 4.18
  },
  {
    "id": 4,
    "text": "第一，建构“围城”哲学隐喻，揭示人类普遍的生存悖论与精神困局。",
    "start": 17.219,
    "end": 22.893,
    "duration": 5.674
  },
  {
    "id": 5,
    "text": "小说借法国谚语引出核心命题：结婚仿佛“被围困的城堡，城外的人想冲进去，城里的人想逃出来”。",
    "start": 23.425,
    "end": 31.649,
    "duration": 8.224
  },
  {
    "id": 6,
    "text": "方鸿渐留学归国后在求职、婚恋与家庭中屡屡受挫：",
    "start": 32.169,
    "end": 36.56,
    "duration": 4.391
  },
  {
    "id": 7,
    "text": "他既躲避传统包办婚姻，又在苏文纨与唐晓芙之间陷入情感错位；",
    "start": 36.93,
    "end": 42.322,
    "duration": 5.392
  },
  {
    "id": 8,
    "text": "与孙柔嘉成婚后，生活很快被琐碎争吵与姑嫂龃龉消磨殆尽。",
    "start": 42.842,
    "end": 47.775,
    "duration": 4.933
  },
  {
    "id": 9,
    "text": "小说由此超越单纯的婚姻写照，揭示出人在欲望追寻与现实幻灭间进退维谷的生存困境。",
    "start": 48.295,
    "end": 55.41,
    "duration": 7.115
  },
  {
    "id": 10,
    "text": "第二，运用博雅机智的学者修辞，开创幽默辛辣的智性讽刺美学。",
    "start": 56.038,
    "end": 61.707,
    "duration": 5.669
  },
  {
    "id": 11,
    "text": "钱锺书将西方修辞智慧与中国传统诗话妙喻融为一体，善用通感、反讽与旁逸斜出的警句连环。",
    "start": 62.227,
    "end": 71.255,
    "duration": 9.028
  },
  {
    "id": 12,
    "text": "小说中将鲍小姐的裸露装束戏谑为“熟食铺子”与“局部的真理”，",
    "start": 71.775,
    "end": 76.819,
    "duration": 5.044
  },
  {
    "id": 13,
    "text": "把李梅亭大铁箱里藏着的卡片与西药等一路丑态写得维妙维肖，",
    "start": 77.189,
    "end": 82.674,
    "duration": 5.485
  },
  {
    "id": 14,
    "text": "在不动声色的调侃与机智议论中，把洋场名流与文人学者的虚荣庸俗刻画得入木三分。",
    "start": 83.121,
    "end": 91.028,
    "duration": 7.907
  },
  {
    "id": 15,
    "text": "第三，冷峻解剖三闾大学灰色众生相，暴露知识界的虚伪与平庸。",
    "start": 91.622,
    "end": 97.123,
    "duration": 5.501
  },
  {
    "id": 16,
    "text": "小说后半部借赴三闾大学执教的历程，勾勒出一个浓缩的病态学术场域：",
    "start": 97.643,
    "end": 103.649,
    "duration": 6.006
  },
  {
    "id": 17,
    "text": "校长高松年表面忠厚实则老谋深算，",
    "start": 104.019,
    "end": 107.246,
    "duration": 3.227
  },
  {
    "id": 18,
    "text": "西洋史教授韩学愈靠购买爱尔兰骗子的克莱登大学假文凭招摇过市，",
    "start": 107.616,
    "end": 113.407,
    "duration": 5.791
  },
  {
    "id": 19,
    "text": "同事间为争夺课时与派系利益勾心斗角，",
    "start": 113.777,
    "end": 116.77,
    "duration": 2.993
  },
  {
    "id": 20,
    "text": "深刻揭露了旧官场恶习与半殖民地洋化文明杂交而成的知识界劣根性。",
    "start": 117.14,
    "end": 122.903,
    "duration": 5.763
  }
]