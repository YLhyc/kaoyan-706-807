[
  {
    "id": 1,
    "text": "简述赵树理小说的评书体形式创新与历史变革中的农民形象塑造。",
    "start": 0.112,
    "end": 5.938,
    "duration": 5.826
  },
  {
    "id": 2,
    "text": "赵树理是四十年代抗日根据地与解放区土生土长的农民作家，",
    "start": 6.496,
    "end": 11.486,
    "duration": 4.99
  },
  {
    "id": 3,
    "text": "代表文艺大众化的“赵树理方向”，亦为当代“山药蛋派”鼻祖。",
    "start": 11.719,
    "end": 15.873,
    "duration": 4.154
  },
  {
    "id": 4,
    "text": "他在反思五四以来新文学“欧化”隔膜的基础上，立足晋东南农村一线变革，",
    "start": 16.129,
    "end": 21.96,
    "duration": 5.831
  },
  {
    "id": 5,
    "text": "创造出既贴近农民接受习惯又富有历史反思深度的现代小说新格局。",
    "start": 22.269,
    "end": 27.74,
    "duration": 5.471
  },
  {
    "id": 6,
    "text": "第一，改造传统章回说唱结构，创立农民喜闻乐见的现代评书体形式。",
    "start": 28.409,
    "end": 34.266,
    "duration": 5.857
  },
  {
    "id": 7,
    "text": "着眼于写给农村识字人看并念给不识字人听，",
    "start": 34.683,
    "end": 38.152,
    "duration": 3.469
  },
  {
    "id": 8,
    "text": "赵树理扬弃传统章回俗套，汲取连贯完整、有头有尾的说书技法。",
    "start": 38.512,
    "end": 43.984,
    "duration": 5.472
  },
  {
    "id": 9,
    "text": "《小二黑结婚》开篇便直言“刘家峪有两个神仙：一个是前庄上的二诸葛，一个是后庄上的三仙姑”，",
    "start": 44.407,
    "end": 51.897,
    "duration": 7.49
  },
  {
    "id": 10,
    "text": "人物家底交代得清清楚楚；",
    "start": 52.036,
    "end": 53.887,
    "duration": 1.851
  },
  {
    "id": 11,
    "text": "叙事中以具体动作、口语对话替代冗长心理剖析，",
    "start": 54.314,
    "end": 58.515,
    "duration": 4.201
  },
  {
    "id": 12,
    "text": "善设悬念“扣子”并穿插快板顺口溜，使现代农村故事自然流畅、极易传播。",
    "start": 58.838,
    "end": 65.074,
    "duration": 6.236
  },
  {
    "id": 13,
    "text": "第二，秉持清醒“问题小说”眼光，写出农村翻身进程中复杂的两代农民群像。",
    "start": 65.746,
    "end": 72.709,
    "duration": 6.963
  },
  {
    "id": 14,
    "text": "作为与农民心息相通的基层工作者，",
    "start": 73.068,
    "end": 75.552,
    "duration": 2.484
  },
  {
    "id": 15,
    "text": "赵树理既写活小二黑与小芹以民主平等观念和区政府法律据理反抗恶霸与包办婚姻的新人觉醒，",
    "start": 75.961,
    "end": 83.993,
    "duration": 8.032
  },
  {
    "id": 16,
    "text": "又敏锐捕捉旧观念的沉重惯性：如二诸葛遇事必占阴阳卦象、三仙姑老来装神弄鬼。",
    "start": 84.402,
    "end": 91.662,
    "duration": 7.26
  },
  {
    "id": 17,
    "text": "更难得的是，他在《李有才板话》里借村干部“小元”当权后架起胳膊耍威风的蜕变，",
    "start": 92.071,
    "end": 98.431,
    "duration": 6.36
  },
  {
    "id": 18,
    "text": "揭示农村改革中权力腐蚀与思想改造的长期艰难。",
    "start": 98.686,
    "end": 103.058,
    "duration": 4.372
  },
  {
    "id": 19,
    "text": "第三，将晋东南乡土民俗化为社会背景，直接奠基当代“山药蛋派”文学传统。",
    "start": 103.722,
    "end": 110.368,
    "duration": 6.646
  },
  {
    "id": 20,
    "text": "赵树理少写闲逸自然山水，专工农村婚丧嫁娶、卜卦习俗与方言俗语，",
    "start": 110.672,
    "end": 117.244,
    "duration": 6.572
  },
  {
    "id": 21,
    "text": "以接地气的晋阳乡风承载农村政策纠偏的严肃命题，在政治倾向性与写实真实性间取得统一，",
    "start": 117.561,
    "end": 125.57,
    "duration": 8.009
  },
  {
    "id": 22,
    "text": "深刻影响了马烽、西戎等“山药蛋派”作家及十七年农村题材小说写作。",
    "start": 125.974,
    "end": 131.621,
    "duration": 5.647
  }
]