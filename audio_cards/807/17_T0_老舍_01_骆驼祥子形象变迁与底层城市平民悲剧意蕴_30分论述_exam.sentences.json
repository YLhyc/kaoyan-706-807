[
  {
    "id": 1,
    "text": "题型，三十分论述题。",
    "start": 0.08,
    "end": 1.876,
    "duration": 1.796
  },
  {
    "id": 2,
    "text": "分值，三十分。",
    "start": 1.876,
    "end": 2.988,
    "duration": 1.112
  },
  {
    "id": 3,
    "text": "建议考场时间，三十五分钟。",
    "start": 2.988,
    "end": 5.433,
    "duration": 2.445
  },
  {
    "id": 4,
    "text": "目标字数，一千一百五十到一千三百字。",
    "start": 5.433,
    "end": 8.99,
    "duration": 3.557
  },
  {
    "id": 5,
    "text": "答题骨架，小说史定位定性、趋近于、",
    "start": 8.99,
    "end": 12.102,
    "duration": 3.112
  },
  {
    "id": 6,
    "text": "祥子三起三落性格堕落轨迹深析、趋近于、",
    "start": 12.102,
    "end": 15.881,
    "duration": 3.779
  },
  {
    "id": 7,
    "text": "悲剧生成的多重机制与个人奋斗破灭、",
    "start": 15.881,
    "end": 19.438,
    "duration": 3.557
  },
  {
    "id": 8,
    "text": "趋近于、京味儿市民写实与环境交融艺术、",
    "start": 19.438,
    "end": 23.217,
    "duration": 3.779
  },
  {
    "id": 9,
    "text": "趋近于、宏观文学史总结。",
    "start": 23.217,
    "end": 25.44,
    "duration": 2.223
  },
  {
    "id": 10,
    "text": "老舍所著长篇小说《骆驼祥子》是中国现代文学史上剖析城市平民命运最深刻的现实主义杰作。",
    "start": 25.52,
    "end": 33.36,
    "duration": 7.84
  },
  {
    "id": 11,
    "text": "老舍以满腔同情与冷峻解剖并存的现实主义笔触，",
    "start": 33.36,
    "end": 37.52,
    "duration": 4.16
  },
  {
    "id": 12,
    "text": "通过人力车夫祥子由“人”蜕变为“鬼”的人生轨迹，",
    "start": 37.52,
    "end": 41.44,
    "duration": 3.92
  },
  {
    "id": 13,
    "text": "宣告了近代以来底层劳动者个人奋斗神话的彻底破灭，",
    "start": 41.44,
    "end": 45.92,
    "duration": 4.48
  },
  {
    "id": 14,
    "text": "具有震撼人心的时代认识价值与悲剧力量。",
    "start": 45.92,
    "end": 49.28,
    "duration": 3.36
  },
  {
    "id": 15,
    "text": "第一，在形象塑造与性格流变轨迹上，",
    "start": 49.52,
    "end": 52.64,
    "duration": 3.12
  },
  {
    "id": 16,
    "text": "祥子的沉沦历经了“三起三落”的残酷打击，",
    "start": 52.64,
    "end": 55.92,
    "duration": 3.28
  },
  {
    "id": 17,
    "text": "呈现出从积极要强走向彻底麻木自私的心灵异化过程。",
    "start": 55.92,
    "end": 60.8,
    "duration": 4.88
  },
  {
    "id": 18,
    "text": "初入北平的祥子年轻健壮，纯朴诚实，",
    "start": 60.8,
    "end": 64.24,
    "duration": 3.44
  },
  {
    "id": 19,
    "text": "怀抱着买一辆属于自己的洋车以自食其力的质朴理想。",
    "start": 64.24,
    "end": 68.16,
    "duration": 3.92
  },
  {
    "id": 20,
    "text": "他三年苦熬买来第一辆车，却被反动军阀乱军连人带车抢走。",
    "start": 68.4,
    "end": 73.76,
    "duration": 5.36
  },
  {
    "id": 21,
    "text": "此为一落。",
    "start": 73.76,
    "end": 75.04,
    "duration": 1.28
  },
  {
    "id": 22,
    "text": "随后他凭借卖骆驼所得拼命攒钱，却被伪装成特务的孙侦探洗劫一空。",
    "start": 75.04,
    "end": 80.72,
    "duration": 5.68
  },
  {
    "id": 23,
    "text": "此为二落。",
    "start": 80.72,
    "end": 81.76,
    "duration": 1.04
  },
  {
    "id": 24,
    "text": "被迫与虎妞成婚后，祥子用虎妞的私房钱买下第三辆车，",
    "start": 81.76,
    "end": 86.4,
    "duration": 4.64
  },
  {
    "id": 25,
    "text": "但因虎妞难产双亡，只得卖车安葬。",
    "start": 86.4,
    "end": 88.96,
    "duration": 2.56
  },
  {
    "id": 26,
    "text": "此为三落。",
    "start": 89.2,
    "end": 90.24,
    "duration": 1.04
  },
  {
    "id": 27,
    "text": "最后，寄托着其最后精神温存的小福子自义身亡，",
    "start": 90.24,
    "end": 94.32,
    "duration": 4.08
  },
  {
    "id": 28,
    "text": "祥子的心灵防线彻底崩溃。",
    "start": 94.32,
    "end": 96.48,
    "duration": 2.16
  },
  {
    "id": 29,
    "text": "他从早先要强、体面、厌恶烟酒的模范车夫，",
    "start": 96.48,
    "end": 100.16,
    "duration": 3.68
  },
  {
    "id": 30,
    "text": "蜕变为吃喝嫖赌、出卖朋友阮明、甚至靠混红白喜事执符度日的社会游民。",
    "start": 100.16,
    "end": 106.88,
    "duration": 6.72
  },
  {
    "id": 31,
    "text": "老舍极其真实地展现了一个健全个体在生活重压下人性被剥蚀殆尽的悲惨图景。",
    "start": 106.88,
    "end": 113.6,
    "duration": 6.72
  },
  {
    "id": 32,
    "text": "第二，在悲剧意蕴生成机制上，祥子的悲剧是严酷黑暗的社会压迫、",
    "start": 113.888,
    "end": 120.128,
    "duration": 6.24
  },
  {
    "id": 33,
    "text": "病态畸形的市民病态伦理与小农狭隘意识共同绞杀的结果。",
    "start": 120.128,
    "end": 125.328,
    "duration": 5.2
  },
  {
    "id": 34,
    "text": "首先是军阀混战、特务敲诈与高利贷剥削构成的反动统治网络，",
    "start": 125.328,
    "end": 130.928,
    "duration": 5.6
  },
  {
    "id": 35,
    "text": "从经济和人身上彻底断绝了底层车夫通过勤劳致富的可能。",
    "start": 130.928,
    "end": 135.888,
    "duration": 4.96
  },
  {
    "id": 36,
    "text": "其次是病态市民社会的冷酷吞噬。",
    "start": 136.208,
    "end": 139.168,
    "duration": 2.96
  },
  {
    "id": 37,
    "text": "刘四爷对车夫血汗的残酷盘剥，虎妞以畸形爱欲对祥子肉体与精神的双重压榨，",
    "start": 139.168,
    "end": 146.528,
    "duration": 7.36
  },
  {
    "id": 38,
    "text": "使祥子陷入家庭与社会的双重牢笼。",
    "start": 146.528,
    "end": 149.088,
    "duration": 2.56
  },
  {
    "id": 39,
    "text": "更为深刻的是，老舍以批判现实主义眼光指出了祥子自身思想的阶级局限。",
    "start": 149.088,
    "end": 155.168,
    "duration": 6.08
  },
  {
    "id": 40,
    "text": "祥子恪守着中国传统农民狭隘的孤立奋斗观念，",
    "start": 155.168,
    "end": 159.008,
    "duration": 3.84
  },
  {
    "id": 41,
    "text": "试图单打独斗抵抗庞大黑暗的现实体制，",
    "start": 159.008,
    "end": 162.288,
    "duration": 3.28
  },
  {
    "id": 42,
    "text": "对工友的苦难漠不关心，排斥集体互助。",
    "start": 162.288,
    "end": 165.408,
    "duration": 3.12
  },
  {
    "id": 43,
    "text": "老舍在结尾精辟概括其为“个人主义的末路鬼”，",
    "start": 165.648,
    "end": 169.488,
    "duration": 3.84
  },
  {
    "id": 44,
    "text": "深刻阐明了在黑暗旧社会中，个体盲目挣扎绝不可能换来真正解放。",
    "start": 169.488,
    "end": 175.648,
    "duration": 6.16
  },
  {
    "id": 45,
    "text": "第三，在艺术表现机制上，作品将精纯地道的“京味儿”文学语言、",
    "start": 175.648,
    "end": 181.168,
    "duration": 5.52
  },
  {
    "id": 46,
    "text": "精微的心理白描与严酷的自然环境渲染推向了极致。",
    "start": 181.168,
    "end": 185.248,
    "duration": 4.08
  },
  {
    "id": 47,
    "text": "老舍生长于北京底层旗人社会，对北平的地理风貌与车夫行话了如指掌。",
    "start": 185.488,
    "end": 191.888,
    "duration": 6.4
  },
  {
    "id": 48,
    "text": "小说语言洗练纯净，将北京口语提炼为典雅生动的文学语言，",
    "start": 191.888,
    "end": 197.008,
    "duration": 5.12
  },
  {
    "id": 49,
    "text": "无一雕琢痕迹。",
    "start": 197.008,
    "end": 198.368,
    "duration": 1.36
  },
  {
    "id": 50,
    "text": "同时，老舍极擅长将主人公心理与严酷自然环境融为一体。",
    "start": 198.368,
    "end": 203.328,
    "duration": 4.96
  },
  {
    "id": 51,
    "text": "比如祥子在烈日暴雨下拉车的经典名场面中，",
    "start": 203.328,
    "end": 206.848,
    "duration": 3.52
  },
  {
    "id": 52,
    "text": "炽烈如火的骄阳与倾盆而下的冰冷暴雨，",
    "start": 206.848,
    "end": 210.288,
    "duration": 3.44
  },
  {
    "id": 53,
    "text": "不仅逼真再现了底层苦力的肉体折磨，",
    "start": 210.288,
    "end": 213.328,
    "duration": 3.04
  },
  {
    "id": 54,
    "text": "更隐喻着整个吃人社会对祥子生机的残酷摧残，",
    "start": 213.328,
    "end": 217.328,
    "duration": 4.0
  },
  {
    "id": 55,
    "text": "展现了极高的写实艺术技巧。",
    "start": 217.328,
    "end": 219.408,
    "duration": 2.08
  },
  {
    "id": 56,
    "text": "综上所述，老舍《骆驼祥子》通过祥子由要强奋斗到毁灭沉沦的生命历程，",
    "start": 219.728,
    "end": 225.888,
    "duration": 6.16
  },
  {
    "id": 57,
    "text": "深刻解剖了旧中国城市底层劳动者的生存困境与精神异化机制。",
    "start": 225.888,
    "end": 231.728,
    "duration": 5.84
  },
  {
    "id": 58,
    "text": "它彻底击碎了小生产者依傍旧体制安身立命的幻想，",
    "start": 231.728,
    "end": 236.288,
    "duration": 4.56
  },
  {
    "id": 59,
    "text": "以深沉崇高的悲剧力量，在中国现代现实主义文学长廊中树立了一座不可逾越的经典丰碑。",
    "start": 236.288,
    "end": 243.568,
    "duration": 7.28
  }
]