[
  {
    "id": 1,
    "text": "八十年代末至九十年代初，伴随理想主义激情退潮与市场转型开启，",
    "start": 0.134,
    "end": 5.626,
    "duration": 5.492
  },
  {
    "id": 2,
    "text": "当代文坛涌现出以池莉、刘震云、方方等为代表的“新写实小说”流派。",
    "start": 6.25,
    "end": 11.502,
    "duration": 5.252
  },
  {
    "id": 3,
    "text": "该流派告别了传统现实主义的典型化原则与先锋小说的形式实验，",
    "start": 12.18,
    "end": 15.672,
    "duration": 3.492
  },
  {
    "id": 4,
    "text": "其艺术特色主要体现于以下三个方面：",
    "start": 16.051,
    "end": 17.663,
    "duration": 1.612
  },
  {
    "id": 5,
    "text": "第一，聚焦凡俗日常生存，展现“毛茸茸的原生态”生活本真。",
    "start": 18.341,
    "end": 26.313,
    "duration": 7.972
  },
  {
    "id": 6,
    "text": "新写实作家摒弃非黑即白的宏大叙事与概念化说教，主张还生活以本来面目。",
    "start": 27.031,
    "end": 33.203,
    "duration": 6.172
  },
  {
    "id": 7,
    "text": "池莉在《烦恼人生》中以平实细腻的笔调记录了钢铁厂操作工印家厚从清晨睁眼到夜晚就寝的一天：",
    "start": 33.841,
    "end": 41.373,
    "duration": 7.532
  },
  {
    "id": 8,
    "text": "带儿子乘渡轮、抢接自来水、照料啼哭幼儿、应付妻子唠叨与单位纠纷；",
    "start": 42.091,
    "end": 47.463,
    "duration": 5.372
  },
  {
    "id": 9,
    "text": "作品通过充满烟火气的逼真细节，将普通小人物在柴米油盐中的生存负荷呈现得纤毫毕现。",
    "start": 48.181,
    "end": 55.753,
    "duration": 7.572
  },
  {
    "id": 10,
    "text": "第二，消解崇高与英雄神话，直面普通民众微韧的生存困境。",
    "start": 56.431,
    "end": 61.523,
    "duration": 5.092
  },
  {
    "id": 11,
    "text": "小说淡化了救世主式的英雄主角，把目光投向在琐碎生活中无力挣扎的凡夫俗子。",
    "start": 62.201,
    "end": 68.693,
    "duration": 6.492
  },
  {
    "id": 12,
    "text": "刘震云在《一地鸡毛》中刻画机关小职员小林，",
    "start": 69.371,
    "end": 72.663,
    "duration": 3.292
  },
  {
    "id": 13,
    "text": "由昔日意气风发的大学生逐步退化为因一斤变质豆腐与妻子大吵、为分房和调级四处钻营的庸碌市民，",
    "start": 73.042,
    "end": 81.574,
    "duration": 8.532
  },
  {
    "id": 14,
    "text": "以冷峻笔触写出了日常生活无处不在的平庸磨损与消耗。",
    "start": 82.133,
    "end": 86.665,
    "duration": 4.532
  },
  {
    "id": 15,
    "text": "第三，确立“零度情感”叙事原则，建构客观冷静的旁观视界。",
    "start": 87.312,
    "end": 92.284,
    "duration": 4.972
  },
  {
    "id": 16,
    "text": "作家自觉克制主观的道德审判与感伤喟叹，",
    "start": 92.962,
    "end": 96.334,
    "duration": 3.372
  },
  {
    "id": 17,
    "text": "叙述者宛如冷眼旁观的摄影机，以节制、冷静的语调记录生活流程。",
    "start": 96.713,
    "end": 101.405,
    "duration": 4.692
  },
  {
    "id": 18,
    "text": "在方方的《风景》中，作者借一个死于襁褓的婴儿亡灵视角，",
    "start": 102.123,
    "end": 106.335,
    "duration": 4.212
  },
  {
    "id": 19,
    "text": "不动声色地叙述汉口棚户区一家人粗鄙、残酷却又顽强繁衍的生命图景，",
    "start": 106.714,
    "end": 112.726,
    "duration": 6.012
  },
  {
    "id": 20,
    "text": "拓展了当代小说的叙事视界与艺术张力。",
    "start": 113.105,
    "end": 116.037,
    "duration": 2.932
  }
]