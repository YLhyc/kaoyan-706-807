[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "先拆解蒋光慈/洪灵菲模式如何走套路（失恋苦闷→战友感召→舍情投革），",
    "start": 0.225,
    "end": 7.578,
    "duration": 7.353
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再批评其人物扁平、回避阵痛之概念化弊端，",
    "start": 8.295,
    "end": 11.863,
    "duration": 3.568
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后点破茅盾《蚀》三部曲“反而更早却更真实”地写出退潮期静女士、方罗兰、章秋柳的精神挣扎。",
    "start": 12.601,
    "end": 20.974,
    "duration": 8.373
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "大革命失败前后，以蒋光慈等后期创造社、太阳社作家为代表兴起“革命加恋爱”小说风潮，",
    "start": 21.771,
    "end": 29.525,
    "duration": 7.754
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "成三十年代初左翼通俗样式，而茅盾《蚀》三部曲实现了深刻超越。",
    "start": 30.262,
    "end": 35.9,
    "duration": 5.638
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 二元对抗公式叙事：以情爱包裹革命动员",
    "start": 36.619,
    "end": 40.638,
    "duration": 4.019
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "小资产青年恋情受挫陷入苦闷幻灭后，受革命者感召舍私情、投工农斗争并坚定信仰；",
    "start": 41.403,
    "end": 48.868,
    "duration": 7.466
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "见于蒋光慈《野祭》《冲出云围的月亮》、洪灵菲《流亡》，契合青年心理却因概念化削弱艺术力。",
    "start": 49.759,
    "end": 57.386,
    "duration": 7.627
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 陷入主观抒情狂热与人物概念化弊端",
    "start": 58.101,
    "end": 61.947,
    "duration": 3.846
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "缺对复杂阶级关系体察：人物正邪扁平，恋爱沦为宣讲政治载体；",
    "start": 62.642,
    "end": 68.046,
    "duration": 5.404
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "革命浪漫化为热血传奇，既难剖析知识分子思想转变阵痛，亦回避大革命退潮严峻考验。",
    "start": 68.804,
    "end": 76.725,
    "duration": 7.921
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 茅盾《蚀》三部曲：写退潮期精神创伤",
    "start": 77.451,
    "end": 81.371,
    "duration": 3.92
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "迥异于流行公式，茅盾在《幻灭》《动摇》《追求》摒弃廉价乐观，写尽动荡岁月青年精神困惑；",
    "start": 82.116,
    "end": 89.674,
    "duration": 7.558
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "静女士遭投机者玩弄后幻灭，方罗兰左右夹击优柔动摇，",
    "start": 90.447,
    "end": 95.037,
    "duration": 4.591
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "章秋柳借放浪情欲麻痹之畸形追求，升至现代社会心理剖析高度。",
    "start": 95.835,
    "end": 101.603,
    "duration": 5.768
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：早期代表蒋光慈《野祭》《冲出云围的月亮》、洪灵菲《流亡》；",
    "start": 102.442,
    "end": 107.831,
    "duration": 5.389
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "茅盾《蚀》三部曲指《幻灭》（静女士）、《动摇》（方罗兰）、《追求》（章秋柳）。",
    "start": 108.592,
    "end": 114.23,
    "duration": 5.638
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出“革命加恋爱”模式的三部代表作及三步情节机制？",
    "start": 115.05,
    "end": 120.779,
    "duration": 5.729
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 剖析其为何会滑向“主观抒情狂热与人物心理概念化”？",
    "start": 121.517,
    "end": 127.316,
    "duration": 5.799
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 对比蒋光慈与茅盾《蚀》三部曲（静女士/方罗兰/章秋柳）的艺术高下？",
    "start": 128.109,
    "end": 135.95,
    "duration": 7.841
  }
]