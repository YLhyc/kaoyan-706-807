[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "革命加恋爱·小说模式机制与茅盾蚀三部曲的超越",
    "start": 0.134,
    "end": 4.508,
    "duration": 4.374
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "先拆解蒋光慈/洪灵菲模式如何走套路（失恋苦闷→战友感召→舍情投革），",
    "start": 5.097,
    "end": 12.609,
    "duration": 7.512
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再批评其人物扁平、回避阵痛之概念化弊端，",
    "start": 12.857,
    "end": 16.685,
    "duration": 3.827
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后点破茅盾《蚀》三部曲“反而更早却更真实”地写出退潮期静女士、方罗兰、章秋柳的精神挣扎。",
    "start": 16.786,
    "end": 25.105,
    "duration": 8.319
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "大革命失败前后，以蒋光慈等后期创造社、太阳社作家为代表兴起“革命加恋爱”小说风潮，",
    "start": 25.692,
    "end": 33.881,
    "duration": 8.189
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "成三十年代初左翼通俗样式，而茅盾《蚀》三部曲实现了深刻超越。",
    "start": 34.116,
    "end": 40.196,
    "duration": 6.08
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 二元对抗公式叙事：以情爱包裹革命动员",
    "start": 40.783,
    "end": 44.975,
    "duration": 4.192
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "小资产青年恋情受挫陷入苦闷幻灭后，受革命者感召舍私情、投工农斗争并坚定信仰；",
    "start": 45.562,
    "end": 54.259,
    "duration": 8.697
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "见于蒋光慈《野祭》《冲出云围的月亮》、洪灵菲《流亡》，契合青年心理却因概念化削弱艺术力。",
    "start": 54.845,
    "end": 63.959,
    "duration": 9.114
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 陷入主观抒情狂热与人物概念化弊端",
    "start": 64.546,
    "end": 68.49,
    "duration": 3.944
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "缺对复杂阶级关系体察：人物正邪扁平，恋爱沦为宣讲政治载体；",
    "start": 69.077,
    "end": 75.652,
    "duration": 6.575
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "革命浪漫化为热血传奇，既难剖析知识分子思想转变阵痛，亦回避大革命退潮严峻考验。",
    "start": 76.239,
    "end": 84.884,
    "duration": 8.645
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 茅盾《蚀》三部曲：写退潮期精神创伤",
    "start": 85.47,
    "end": 89.545,
    "duration": 4.075
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "迥异于流行公式，茅盾在《幻灭》《动摇》《追求》摒弃廉价乐观，写尽动荡岁月青年精神困惑；",
    "start": 90.132,
    "end": 99.467,
    "duration": 9.335
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "静女士遭投机者玩弄后幻灭，方罗兰左右夹击优柔动摇，章秋柳借放浪情欲麻痹之畸形追求，",
    "start": 100.054,
    "end": 109.597,
    "duration": 9.543
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "升至现代社会心理剖析高度。",
    "start": 109.806,
    "end": 112.397,
    "duration": 2.59
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：早期代表蒋光慈《野祭》《冲出云围的月亮》、洪灵菲《流亡》；",
    "start": 112.983,
    "end": 118.764,
    "duration": 5.78
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "茅盾《蚀》三部曲指《幻灭》（静女士）、《动摇》（方罗兰）、《追求》（章秋柳）。",
    "start": 119.051,
    "end": 125.131,
    "duration": 6.08
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出“革命加恋爱”模式的三部代表作及三步情节机制？",
    "start": 125.692,
    "end": 131.576,
    "duration": 5.884
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 剖析其为何会滑向“主观抒情狂热与人物心理概念化”？",
    "start": 132.15,
    "end": 137.865,
    "duration": 5.715
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 对比蒋光慈与茅盾《蚀》三部曲（静女士/方罗兰/章秋柳）的艺术高下？",
    "start": 138.452,
    "end": 146.199,
    "duration": 7.746
  }
]