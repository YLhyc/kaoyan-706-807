[
  {
    "id": 1,
    "text": "三十年代民族危亡与全民族抗战时期，艾青以《大堰河——我的保姆》《北方》与《我爱这土地》等代表作，",
    "start": 0.2,
    "end": 8.57,
    "duration": 8.37
  },
  {
    "id": 2,
    "text": "在中国现代新诗史上开辟了现实主义与时代精神交融的新境。",
    "start": 8.94,
    "end": 14.288,
    "duration": 5.348
  },
  {
    "id": 3,
    "text": "作为继郭沫若之后极具时代感召力的现代诗人，",
    "start": 14.788,
    "end": 18.34,
    "duration": 3.552
  },
  {
    "id": 4,
    "text": "艾青打破了前期新诗脱离泥土与民众的文人雅趣，将深沉忧郁的情思与民族抗争激情融为一体。",
    "start": 18.71,
    "end": 27.254,
    "duration": 8.544
  },
  {
    "id": 5,
    "text": "其诗歌的思想意蕴、意象体系与艺术革新，主要体现于以下三个维度：",
    "start": 27.754,
    "end": 33.55,
    "duration": 5.796
  },
  {
    "id": 6,
    "text": "第一，以“土地”与“大堰河”为精神底色，倾注对劳苦大众的挚爱。",
    "start": 33.92,
    "end": 38.96,
    "duration": 5.04
  },
  {
    "id": 7,
    "text": "艾青诗歌的生命根基深植于苦难的中国大地。",
    "start": 39.48,
    "end": 43.0,
    "duration": 3.52
  },
  {
    "id": 8,
    "text": "在成名作《大堰河——我的保姆》中，诗人以地主家庭叛逆之子的赤诚，",
    "start": 43.52,
    "end": 49.28,
    "duration": 5.76
  },
  {
    "id": 9,
    "text": "追忆这位“她的名字就是生她的村庄的名字”、用乳汁养育自己的贫苦农妇；",
    "start": 49.84,
    "end": 56.48,
    "duration": 6.64
  },
  {
    "id": 10,
    "text": "诗篇通过她流尽乳汁后终日洗衣切菜、年节里忙着为孩子制作冬米的糖、",
    "start": 57.035,
    "end": 63.56,
    "duration": 6.525
  },
  {
    "id": 11,
    "text": "直至死后仅以四块钱的棺材和几束稻草草草安葬的凄苦生平，",
    "start": 63.93,
    "end": 69.21,
    "duration": 5.28
  },
  {
    "id": 12,
    "text": "真切刻画出中国劳动妇女忍辱负重、深沉慈爱的母亲形象。",
    "start": 69.58,
    "end": 74.78,
    "duration": 5.2
  },
  {
    "id": 13,
    "text": "这种依恋在抗战烽火中升华为集体忧患母题：",
    "start": 75.3,
    "end": 79.06,
    "duration": 3.76
  },
  {
    "id": 14,
    "text": "在《雪落在中国的土地上》中，他叹息“雪落在中国的土地上，寒冷在封锁着中国呀”，写尽饥馑大地与农夫的艰辛；",
    "start": 79.43,
    "end": 89.59,
    "duration": 10.16
  },
  {
    "id": 15,
    "text": "在《我爱这土地》中，诗人化作喉咙嘶哑的飞鸟，以“为什么我的眼里常含泪水？因为我对这土地爱得深沉”的名句，",
    "start": 90.11,
    "end": 98.8,
    "duration": 8.69
  },
  {
    "id": 16,
    "text": "将对苦难祖国的生死挚爱化作振奋民族的精神力量。",
    "start": 99.17,
    "end": 103.25,
    "duration": 4.08
  },
  {
    "id": 17,
    "text": "第二，以“太阳”与“火把”为光明象征，高扬民族救亡与民主理想。",
    "start": 103.77,
    "end": 108.73,
    "duration": 4.96
  },
  {
    "id": 18,
    "text": "与沉郁凝重的土地意象相对照，艾青诗作中奔涌着炽烈灼热的光明向往。",
    "start": 109.25,
    "end": 115.09,
    "duration": 5.84
  },
  {
    "id": 19,
    "text": "在《向太阳》与《火把》等代表性长诗中，“太阳”不再是古典诗歌里孤立的自然景物，",
    "start": 115.61,
    "end": 122.286,
    "duration": 6.676
  },
  {
    "id": 20,
    "text": "而被赋予驱散幽暗历史、冲破封建枷锁与迎接民族新生的时代意蕴。",
    "start": 122.641,
    "end": 128.405,
    "duration": 5.764
  },
  {
    "id": 21,
    "text": "诗人以饱满激越的浪漫情怀，呼唤风雪硝烟中受压迫的四万万同胞挺起脊梁；",
    "start": 128.905,
    "end": 135.99,
    "duration": 7.085
  },
  {
    "id": 22,
    "text": "在《向太阳》中以迎着烈日奔跑的狂欢礼赞光明，并在《火把》中借唐尼参与夜间火炬游行展现抗战群体献身意志，",
    "start": 136.51,
    "end": 146.4,
    "duration": 9.89
  },
  {
    "id": 23,
    "text": "展现出抗战时期知识分子探求民族出路、走向人民的时代觉醒；",
    "start": 146.77,
    "end": 151.65,
    "duration": 4.88
  },
  {
    "id": 24,
    "text": "及至延安时期的《黎明的通知》，光明意象更化为迎接新世界到来的明朗呼告。",
    "start": 152.17,
    "end": 158.97,
    "duration": 6.8
  },
  {
    "id": 25,
    "text": "第三，打破格律与欧化束缚，创立兼具散文美与内在韵律的自由诗体。",
    "start": 159.49,
    "end": 165.17,
    "duration": 5.68
  },
  {
    "id": 26,
    "text": "艾青自觉反思了新月派偏重整齐外形与辞藻雕琢的局限，力主诗歌追求“散文美”与天然律动。",
    "start": 165.69,
    "end": 173.37,
    "duration": 7.68
  },
  {
    "id": 27,
    "text": "他不拘泥于外在押韵和字数齐整，而是大量运用排比、递进、长短句交错与复沓回环，",
    "start": 173.89,
    "end": 181.46,
    "duration": 7.57
  },
  {
    "id": 28,
    "text": "营造如波涛涌动、沉郁顿挫的内在节奏。",
    "start": 182.02,
    "end": 185.38,
    "duration": 3.36
  },
  {
    "id": 29,
    "text": "无论在《雪落在中国的土地上》中反复咏叹农夫与孤寡流离失所的悲怆句式，",
    "start": 185.9,
    "end": 191.74,
    "duration": 5.84
  },
  {
    "id": 30,
    "text": "还是在《北方》中以绘画般的色彩冷暖对比与立体造型勾勒荒原苦难，",
    "start": 192.159,
    "end": 197.87,
    "duration": 5.711
  },
  {
    "id": 31,
    "text": "艾青都以质朴凝练的诗语、不饰雕琢的自然声调与阔大格局拓宽了新诗容量，",
    "start": 198.24,
    "end": 204.48,
    "duration": 6.24
  },
  {
    "id": 32,
    "text": "推动自由体新诗从沙龙案头走向时代大众。",
    "start": 204.85,
    "end": 209.01,
    "duration": 4.16
  },
  {
    "id": 33,
    "text": "由此观之，艾青诗歌以“土地与太阳”的双重意象为现代中国塑造了坚韧的精神图腾，",
    "start": 209.53,
    "end": 216.52,
    "duration": 6.99
  },
  {
    "id": 34,
    "text": "在语言机制上引导新诗回归民族泥土与人民大众。",
    "start": 216.89,
    "end": 220.94,
    "duration": 4.05
  },
  {
    "id": 35,
    "text": "其深沉的忧患意识与执着的光明追求，奠定了中国现代诗歌扎根人民、直面现实的重要传统。",
    "start": 221.46,
    "end": 229.22,
    "duration": 7.76
  }
]
