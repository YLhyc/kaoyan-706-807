[
  {
    "id": 1,
    "text": "三十年代民族危亡与全民族抗战相持阶段，",
    "start": 0.08,
    "end": 3.571,
    "duration": 3.491
  },
  {
    "id": 2,
    "text": "艾青以《大堰河——我的保姆》《北方》与《我爱这土地》等不朽诗篇的诞生，",
    "start": 3.874,
    "end": 9.043,
    "duration": 5.169
  },
  {
    "id": 3,
    "text": "在中国现代新诗发展史上矗立起一座现实主义与时代精神深度交融的崇高丰碑。",
    "start": 9.142,
    "end": 15.858,
    "duration": 6.716
  },
  {
    "id": 4,
    "text": "作为继郭沫若之后最具时代号召力的现代诗歌巨匠，",
    "start": 16.009,
    "end": 19.886,
    "duration": 3.877
  },
  {
    "id": 5,
    "text": "艾青彻底终结了前期新诗脱离泥土与劳苦大众的文人雅致趣味，",
    "start": 20.213,
    "end": 25.768,
    "duration": 5.555
  },
  {
    "id": 6,
    "text": "将个体深沉的忧郁情思与民族血泪搏击熔铸一体。",
    "start": 25.931,
    "end": 30.317,
    "duration": 4.386
  },
  {
    "id": 7,
    "text": "其诗歌的思想意蕴、意象体系与形式革新，",
    "start": 30.579,
    "end": 34.151,
    "duration": 3.572
  },
  {
    "id": 8,
    "text": "主要展现于以下三个层层推进的核心维度：",
    "start": 34.422,
    "end": 37.85,
    "duration": 3.428
  },
  {
    "id": 9,
    "text": "第一，以“土地”与“大堰河”为精神底护，",
    "start": 38.241,
    "end": 41.425,
    "duration": 3.184
  },
  {
    "id": 10,
    "text": "倾注对下层劳苦大众的赤子挚爱与深沉忧郁。",
    "start": 41.807,
    "end": 45.459,
    "duration": 3.652
  },
  {
    "id": 11,
    "text": "艾青诗歌的生命根基深植于中国广袤而苦难的泥土。",
    "start": 45.823,
    "end": 49.951,
    "duration": 4.128
  },
  {
    "id": 12,
    "text": "在代表作《大堰河——我的保姆》中，",
    "start": 50.185,
    "end": 52.388,
    "duration": 2.203
  },
  {
    "id": 13,
    "text": "诗人以近乎忏悔与皈依的赤子之痛，",
    "start": 52.535,
    "end": 55.714,
    "duration": 3.179
  },
  {
    "id": 14,
    "text": "深情追忆这位哺乳了地主家庭反叛逆子的贫苦农妇；",
    "start": 55.714,
    "end": 59.61,
    "duration": 3.896
  },
  {
    "id": 15,
    "text": "诗篇通过大堰河那双“搭在冰冷灶台上的红黑的厚手”、",
    "start": 59.903,
    "end": 64.132,
    "duration": 4.229
  },
  {
    "id": 16,
    "text": "除夕夜在破旧漆黑大瓦房里包下的带着体温的糖豆，",
    "start": 64.345,
    "end": 68.643,
    "duration": 4.298
  },
  {
    "id": 17,
    "text": "以及死后仅用四块生满虫蚁的薄板草草装殓的惨绝细节，",
    "start": 68.869,
    "end": 73.764,
    "duration": 4.895
  },
  {
    "id": 18,
    "text": "极度真切地刻画出中国传统劳动妇女忍辱负重、",
    "start": 74.054,
    "end": 77.895,
    "duration": 3.841
  },
  {
    "id": 19,
    "text": "慈爱至深的圣母般形象。",
    "start": 78.08,
    "end": 79.936,
    "duration": 1.856
  },
  {
    "id": 20,
    "text": "这种对苦难大地的深切依恋，",
    "start": 80.173,
    "end": 82.291,
    "duration": 2.118
  },
  {
    "id": 21,
    "text": "在抗战烽火中升华为诗人的集体忧患母题。",
    "start": 82.685,
    "end": 86.258,
    "duration": 3.573
  },
  {
    "id": 22,
    "text": "在《我爱这土地》中，诗人化身为一只喉咙嘶哑的飞鸟，",
    "start": 87.016,
    "end": 91.481,
    "duration": 4.465
  },
  {
    "id": 23,
    "text": "以“为什么我的眼里常含泪水？",
    "start": 92.122,
    "end": 94.296,
    "duration": 2.174
  },
  {
    "id": 24,
    "text": "因为我对这土地爱得深沉”的千古名句，",
    "start": 94.85,
    "end": 98.131,
    "duration": 3.281
  },
  {
    "id": 25,
    "text": "将对饱受侵凌的祖国大地的生死誓言，",
    "start": 98.252,
    "end": 101.314,
    "duration": 3.062
  },
  {
    "id": 26,
    "text": "化作支撑全民族浴血奋战的精神压舱石。",
    "start": 101.314,
    "end": 104.682,
    "duration": 3.368
  },
  {
    "id": 27,
    "text": "第二，以“太阳”与“火把”为光明图腾，",
    "start": 104.956,
    "end": 107.834,
    "duration": 2.878
  },
  {
    "id": 28,
    "text": "建构抗击法西斯侵略与呼唤民族复兴的崇高理想。",
    "start": 108.229,
    "end": 112.393,
    "duration": 4.164
  },
  {
    "id": 29,
    "text": "与沉郁凝重的土地意象相对称，",
    "start": 112.621,
    "end": 115.176,
    "duration": 2.555
  },
  {
    "id": 30,
    "text": "艾青诗作中奔涌着极其炽烈灼热的火光崇拜。",
    "start": 115.41,
    "end": 119.034,
    "duration": 3.624
  },
  {
    "id": 31,
    "text": "在《向太阳》《火把》与《黎明的通知》等一系列名篇中，",
    "start": 119.154,
    "end": 123.482,
    "duration": 4.328
  },
  {
    "id": 32,
    "text": "“太阳”不再是古典诗歌中超然物外的自然物象，",
    "start": 123.562,
    "end": 127.259,
    "duration": 3.697
  },
  {
    "id": 33,
    "text": "而是被赋予了驱散幽暗历史、",
    "start": 127.514,
    "end": 129.918,
    "duration": 2.404
  },
  {
    "id": 34,
    "text": "焚毁封建羁绊与宣告黎明新生的政治审美象征。",
    "start": 130.0,
    "end": 134.035,
    "duration": 4.035
  },
  {
    "id": 35,
    "text": "诗人以狂飙突进的浪漫主义激情，",
    "start": 134.216,
    "end": 136.761,
    "duration": 2.545
  },
  {
    "id": 36,
    "text": "呼唤在风雪与硝烟中被压抑的四万万同胞昂起头颅；",
    "start": 136.904,
    "end": 141.263,
    "duration": 4.359
  },
  {
    "id": 37,
    "text": "抒情主人公以向着烈日狂奔、",
    "start": 141.505,
    "end": 143.95,
    "duration": 2.445
  },
  {
    "id": 38,
    "text": "纵使被光焰焚化肉身亦无怨无悔的悲壮献身意志，",
    "start": 144.01,
    "end": 147.967,
    "duration": 3.957
  },
  {
    "id": 39,
    "text": "将现代中国知识分子寻找历史出路、",
    "start": 148.212,
    "end": 151.17,
    "duration": 2.958
  },
  {
    "id": 40,
    "text": "投身民族救亡与走向人民的觉醒轨迹，",
    "start": 151.331,
    "end": 154.463,
    "duration": 3.132
  },
  {
    "id": 41,
    "text": "推向了撼人心魄的思想崇高之境。",
    "start": 154.514,
    "end": 157.477,
    "duration": 2.963
  },
  {
    "id": 42,
    "text": "第三，打破古典格律与欧化形式羁绊，创立自由流淌、",
    "start": 157.676,
    "end": 162.375,
    "duration": 4.699
  },
  {
    "id": 43,
    "text": "散文美与音乐美交融的现代自由诗范式。",
    "start": 162.481,
    "end": 165.888,
    "duration": 3.407
  },
  {
    "id": 44,
    "text": "艾青自觉反思了闻一多、",
    "start": 166.419,
    "end": 168.238,
    "duration": 1.819
  },
  {
    "id": 45,
    "text": "徐志摩为代表的新月派过度追求“整齐外形与辞藻雕琢”的文人局限，",
    "start": 168.323,
    "end": 173.765,
    "duration": 5.442
  },
  {
    "id": 46,
    "text": "坚决捍卫新诗的散文美与内生韵律。",
    "start": 174.03,
    "end": 176.857,
    "duration": 2.827
  },
  {
    "id": 47,
    "text": "他主张诗歌应当“追求天然之美”，大量运用排比、递进、",
    "start": 177.109,
    "end": 181.862,
    "duration": 4.753
  },
  {
    "id": 48,
    "text": "长短句相间与复沓回环的句式架构，赋予诗歌以如波涛汹涌、",
    "start": 181.968,
    "end": 187.733,
    "duration": 5.765
  },
  {
    "id": 49,
    "text": "沉郁顿挫的内在声律。",
    "start": 188.015,
    "end": 189.829,
    "duration": 1.814
  },
  {
    "id": 50,
    "text": "无论是在《雪落在中国的土地上》中那反复叩问农夫与孤寡的悲怆重叠，",
    "start": 190.26,
    "end": 196.046,
    "duration": 5.786
  },
  {
    "id": 51,
    "text": "还是在《北方》中展现如风吹荒原般的宏阔视野，",
    "start": 196.306,
    "end": 200.101,
    "duration": 3.795
  },
  {
    "id": 52,
    "text": "艾青都以洗净铅华的质朴语言与大开大合的体势，",
    "start": 200.406,
    "end": 204.556,
    "duration": 4.15
  },
  {
    "id": 53,
    "text": "极大拓宽了现代自由体新诗的容量，",
    "start": 204.918,
    "end": 207.58,
    "duration": 2.662
  },
  {
    "id": 54,
    "text": "成功完成了中国新诗从沙龙雅趣向广场时代大众的文体跨越。",
    "start": 207.764,
    "end": 213.539,
    "duration": 5.775
  },
  {
    "id": 55,
    "text": "综上所述，",
    "start": 213.762,
    "end": 214.576,
    "duration": 0.814
  },
  {
    "id": 56,
    "text": "艾青诗歌不仅以“土地与太阳”的双重视野为现代中国铸造了坚韧的精神图腾，",
    "start": 214.887,
    "end": 221.339,
    "duration": 6.452
  },
  {
    "id": 57,
    "text": "更在语言机制上真正实现了新诗向民族泥土与人民群众的文体归航。",
    "start": 221.577,
    "end": 228.166,
    "duration": 6.589
  },
  {
    "id": 58,
    "text": "其博大深沉的忧郁情怀与向死而生的光明追求，",
    "start": 228.214,
    "end": 232.343,
    "duration": 4.129
  },
  {
    "id": 59,
    "text": "永远确立了中国现代诗歌扎根人民、介入历史的崇高思想坐标。",
    "start": 232.436,
    "end": 238.512,
    "duration": 6.076
  }
]
