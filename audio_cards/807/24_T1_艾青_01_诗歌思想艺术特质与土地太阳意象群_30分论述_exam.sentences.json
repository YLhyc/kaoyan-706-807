[
  {
    "id": 1,
    "text": "三十年代民族危亡与全民族抗战时期，",
    "start": 0.11,
    "end": 3.351,
    "duration": 3.241
  },
  {
    "id": 2,
    "text": "艾青以《大堰河——我的保姆》《北方》与《我爱这土地》等代表作，",
    "start": 3.661,
    "end": 8.157,
    "duration": 4.496
  },
  {
    "id": 3,
    "text": "在中国现代新诗史上开辟了现实主义与时代精神交融的新境。",
    "start": 8.595,
    "end": 13.565,
    "duration": 4.97
  },
  {
    "id": 4,
    "text": "作为继郭沫若之后极具时代感召力的现代诗人，",
    "start": 13.806,
    "end": 17.287,
    "duration": 3.481
  },
  {
    "id": 5,
    "text": "艾青打破了前期新诗脱离泥土与民众的文人雅趣，将深沉忧郁的情思与民族抗争激情融为一体。",
    "start": 17.656,
    "end": 26.107,
    "duration": 8.451
  },
  {
    "id": 6,
    "text": "其诗歌的思想意蕴、意象体系与艺术革新，主要体现于以下三个维度：",
    "start": 26.705,
    "end": 32.31,
    "duration": 5.605
  },
  {
    "id": 7,
    "text": "第一，以“土地”与“大堰河”为精神底色，倾注对劳苦大众的挚爱。",
    "start": 32.975,
    "end": 38.059,
    "duration": 5.084
  },
  {
    "id": 8,
    "text": "艾青诗歌的生命根基深植于苦难的中国大地。",
    "start": 38.679,
    "end": 42.238,
    "duration": 3.559
  },
  {
    "id": 9,
    "text": "在成名作《大堰河——我的保姆》中，诗人以地主家庭叛逆之子的赤诚，",
    "start": 42.894,
    "end": 47.836,
    "duration": 4.942
  },
  {
    "id": 10,
    "text": "追忆这位“她的名字就是生她的村庄的名字”、用乳汁养育自己的贫苦农妇；",
    "start": 48.081,
    "end": 54.002,
    "duration": 5.921
  },
  {
    "id": 11,
    "text": "诗篇通过她流尽乳汁后终日洗衣切菜、年节里忙着为孩子制作冬米的糖、直至死后仅以四块钱的棺材和几束稻草草草安葬的凄苦生平，",
    "start": 54.299,
    "end": 66.603,
    "duration": 12.304
  },
  {
    "id": 12,
    "text": "真切刻画出中国劳动妇女忍辱负重、深沉慈爱的母亲形象。",
    "start": 66.782,
    "end": 72.066,
    "duration": 5.284
  },
  {
    "id": 13,
    "text": "这种依恋在抗战烽火中升华为集体忧患母题：在《雪落在中国的土地上》中，",
    "start": 72.317,
    "end": 78.267,
    "duration": 5.95
  },
  {
    "id": 14,
    "text": "他叹息“雪落在中国的土地上，寒冷在封锁着中国呀”，写尽饥馑大地与农夫的艰辛；",
    "start": 78.533,
    "end": 86.003,
    "duration": 7.47
  },
  {
    "id": 15,
    "text": "在《我爱这土地》中，诗人化作喉咙嘶哑的飞鸟，",
    "start": 86.161,
    "end": 89.848,
    "duration": 3.687
  },
  {
    "id": 16,
    "text": "以“为什么我的眼里常含泪水？因为我对这土地爱得深沉”的名句，",
    "start": 90.191,
    "end": 95.223,
    "duration": 5.032
  },
  {
    "id": 17,
    "text": "将对苦难祖国的生死挚爱化作振奋民族的精神力量。",
    "start": 95.667,
    "end": 100.062,
    "duration": 4.395
  },
  {
    "id": 18,
    "text": "第二，以“太阳”与“火把”为光明象征，高扬民族救亡与民主理想。",
    "start": 100.676,
    "end": 106.319,
    "duration": 5.643
  },
  {
    "id": 19,
    "text": "与沉郁凝重的土地意象相对照，艾青诗作中奔涌着炽烈灼热的光明向往。",
    "start": 106.898,
    "end": 112.747,
    "duration": 5.849
  },
  {
    "id": 20,
    "text": "在《向太阳》与《火把》等代表性长诗中，“太阳”不再是古典诗歌里孤立的自然景物，",
    "start": 113.181,
    "end": 119.025,
    "duration": 5.844
  },
  {
    "id": 21,
    "text": "而被赋予驱散幽暗历史、冲破封建枷锁与迎接民族新生的时代意蕴。",
    "start": 119.33,
    "end": 125.583,
    "duration": 6.253
  },
  {
    "id": 22,
    "text": "诗人以饱满激越的浪漫情怀，呼唤风雪硝烟中受压迫的四万万同胞挺起脊梁；",
    "start": 126.084,
    "end": 132.992,
    "duration": 6.908
  },
  {
    "id": 23,
    "text": "在《向太阳》中以迎着烈日奔跑的狂欢礼赞光明，并在《火把》中借唐尼参与夜间火炬游行展现抗战群体献身意志，",
    "start": 133.419,
    "end": 142.643,
    "duration": 9.224
  },
  {
    "id": 24,
    "text": "展现出抗战时期知识分子探求民族出路、走向人民的时代觉醒；",
    "start": 142.982,
    "end": 148.267,
    "duration": 5.285
  },
  {
    "id": 25,
    "text": "及至延安时期的《黎明的通知》，光明意象更化为迎接新世界到来的明朗呼告。",
    "start": 148.535,
    "end": 155.348,
    "duration": 6.813
  },
  {
    "id": 26,
    "text": "第三，打破格律与欧化束缚，创立兼具散文美与内在韵律的自由诗体。",
    "start": 155.947,
    "end": 162.04,
    "duration": 6.093
  },
  {
    "id": 27,
    "text": "艾青自觉反思了新月派偏重整齐外形与辞藻雕琢的局限，力主诗歌追求“散文美”与天然律动。",
    "start": 162.392,
    "end": 169.965,
    "duration": 7.573
  },
  {
    "id": 28,
    "text": "他不拘泥于外在押韵和字数齐整，而是大量运用排比、递进、长短句交错与复沓回环，",
    "start": 170.209,
    "end": 177.649,
    "duration": 7.44
  },
  {
    "id": 29,
    "text": "营造如波涛涌动、沉郁顿挫的内在节奏。",
    "start": 178.109,
    "end": 181.314,
    "duration": 3.205
  },
  {
    "id": 30,
    "text": "无论在《雪落在中国的土地上》中反复咏叹农夫与孤寡流离失所的悲怆句式，",
    "start": 181.612,
    "end": 187.718,
    "duration": 6.106
  },
  {
    "id": 31,
    "text": "还是在《北方》中以绘画般的色彩冷暖对比与立体造型勾勒荒原苦难，",
    "start": 188.297,
    "end": 194.31,
    "duration": 6.013
  },
  {
    "id": 32,
    "text": "艾青都以质朴凝练的诗语、不饰雕琢的自然声调与阔大格局拓宽了新诗容量，",
    "start": 194.576,
    "end": 201.441,
    "duration": 6.865
  },
  {
    "id": 33,
    "text": "推动自由体新诗从沙龙案头走向时代大众。",
    "start": 201.656,
    "end": 205.421,
    "duration": 3.765
  },
  {
    "id": 34,
    "text": "由此观之，艾青诗歌以“土地与太阳”的双重意象为现代中国塑造了坚韧的精神图腾，在语言机制上引导新诗回归民族泥土与人民大众。",
    "start": 206.114,
    "end": 217.726,
    "duration": 11.612
  },
  {
    "id": 35,
    "text": "其深沉的忧患意识与执着的光明追求，奠定了中国现代诗歌扎根人民、直面现实的重要传统。",
    "start": 218.095,
    "end": 225.702,
    "duration": 7.607
  }
]