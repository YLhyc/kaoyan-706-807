[
  {
    "id": 1,
    "text": "题目：",
    "start": 0.08,
    "end": 1.12,
    "duration": 1.04
  },
  {
    "id": 2,
    "text": "简述鲁迅《故事新编》在历史小说创作上的文体创新与思想特色。。",
    "start": 1.12,
    "end": 7.52,
    "duration": 6.4
  },
  {
    "id": 3,
    "text": "鲁迅晚期小说集《故事新编》是中国现代历史小说文体试验的划时代杰作。",
    "start": 7.52,
    "end": 14.16,
    "duration": 6.64
  },
  {
    "id": 4,
    "text": "鲁迅彻底摒弃了传统历史小说“据事直书”的考据泥潭，",
    "start": 14.16,
    "end": 19.36,
    "duration": 5.2
  },
  {
    "id": 5,
    "text": "亦超越了单纯借古讽今的政论模式，创造性地融合神话传奇、",
    "start": 19.36,
    "end": 25.52,
    "duration": 6.16
  },
  {
    "id": 6,
    "text": "现代心理与杂文笔法，开创了现代“新历史小说”的先河。",
    "start": 25.52,
    "end": 30.64,
    "duration": 5.12
  },
  {
    "id": 7,
    "text": "其创新主要体现在以下三个核心维度：",
    "start": 30.64,
    "end": 34.88,
    "duration": 4.24
  },
  {
    "id": 8,
    "text": "第一，独创“古今杂糅”与戏谑“油滑”笔法，",
    "start": 34.88,
    "end": 39.52,
    "duration": 4.64
  },
  {
    "id": 9,
    "text": "消解历史的神圣神话。",
    "start": 39.52,
    "end": 41.76,
    "duration": 2.24
  },
  {
    "id": 10,
    "text": "鲁迅依托古代神话与史料骨架，大胆打破时空界限，",
    "start": 41.76,
    "end": 46.64,
    "duration": 4.88
  },
  {
    "id": 11,
    "text": "将现代口语、",
    "start": 46.64,
    "end": 47.36,
    "duration": 0.72
  },
  {
    "id": 12,
    "text": "摩登生活细节与文人论战现实不露声色地植入远古历史场景。",
    "start": 47.6,
    "end": 53.92,
    "duration": 6.32
  },
  {
    "id": 13,
    "text": "在《理水》中，文化山学者坐汽车、穿西装、大谈英国经验，",
    "start": 53.92,
    "end": 59.52,
    "duration": 5.6
  },
  {
    "id": 14,
    "text": "与皮肤粗黑、吃粗粮的治水大禹形成滑稽对照；",
    "start": 59.76,
    "end": 64.08,
    "duration": 4.32
  },
  {
    "id": 15,
    "text": "这种借鉴戏剧丑角式的“油滑”调侃，",
    "start": 64.08,
    "end": 67.28,
    "duration": 3.2
  },
  {
    "id": 16,
    "text": "不仅打破了传统英雄的虚妄光环，",
    "start": 67.28,
    "end": 70.88,
    "duration": 3.6
  },
  {
    "id": 17,
    "text": "更使远古历史成为映照现代中国知识分子病态人格的锐利反讽镜。",
    "start": 70.88,
    "end": 77.52,
    "duration": 6.64
  },
  {
    "id": 18,
    "text": "第二，构筑庄严与荒诞的二元并置，",
    "start": 77.52,
    "end": 80.4,
    "duration": 2.88
  },
  {
    "id": 19,
    "text": "深刻追问崇高理想被世俗消磨的生存悲剧。",
    "start": 80.4,
    "end": 84.64,
    "duration": 4.24
  },
  {
    "id": 20,
    "text": "鲁迅反常理而行，",
    "start": 84.64,
    "end": 86.56,
    "duration": 1.92
  },
  {
    "id": 21,
    "text": "刻意将叙事视点由英雄创业的历史高光转向功成名就之后的凡俗日常。",
    "start": 86.56,
    "end": 92.16,
    "duration": 5.6
  },
  {
    "id": 22,
    "text": "《奔月》打破神射手神话，",
    "start": 92.32,
    "end": 94.978,
    "duration": 2.658
  },
  {
    "id": 23,
    "text": "冷峻展现后羿射尽野兽后只能每日吃乌鸦炸酱面、",
    "start": 94.978,
    "end": 99.852,
    "duration": 4.874
  },
  {
    "id": 24,
    "text": "被日常琐碎彻底消磨的英雄末路；",
    "start": 99.852,
    "end": 103.175,
    "duration": 3.323
  },
  {
    "id": 25,
    "text": "《铸剑》中黑衣人与眉间尺玉石俱焚的惨烈复仇，",
    "start": 103.175,
    "end": 108.049,
    "duration": 4.874
  },
  {
    "id": 26,
    "text": "最终在王公大臣与市民看客围观金鼎大锅沸水的哄笑中沦为娱乐景观。",
    "start": 108.049,
    "end": 114.917,
    "duration": 6.868
  },
  {
    "id": 27,
    "text": "鲁迅深刻揭示了先驱者的崇高牺牲在麻木平庸历史中被消费、",
    "start": 114.917,
    "end": 120.607,
    "duration": 5.69
  },
  {
    "id": 28,
    "text": "被扭曲的荒诞悲凉。",
    "start": 120.607,
    "end": 122.382,
    "duration": 1.775
  },
  {
    "id": 29,
    "text": "第三，打通小说、神话与杂文的文体界限，",
    "start": 122.382,
    "end": 126.129,
    "duration": 3.747
  },
  {
    "id": 30,
    "text": "开创从容幽默而内含深悲的晚期美学境界。",
    "start": 126.129,
    "end": 129.876,
    "duration": 3.747
  },
  {
    "id": 31,
    "text": "《故事新编》将古代神话的宏伟创世想象与现代杂文的逻辑解剖熔铸为一体，",
    "start": 129.876,
    "end": 136.582,
    "duration": 6.706
  },
  {
    "id": 32,
    "text": "既有《补天》般绚烂的原始生命力展现，",
    "start": 136.582,
    "end": 140.48,
    "duration": 3.898
  },
  {
    "id": 33,
    "text": "又有《非攻》墨子止战的清醒务实。",
    "start": 140.48,
    "end": 143.68,
    "duration": 3.2
  },
  {
    "id": 34,
    "text": "鲁迅在晚年以游刃有余的笔触实现了艺术上的返璞归真，",
    "start": 143.68,
    "end": 148.4,
    "duration": 4.72
  },
  {
    "id": 35,
    "text": "在嬉笑怒骂中深藏对文明困境的沉痛哲思。",
    "start": 148.4,
    "end": 151.12,
    "duration": 2.72
  },
  {
    "id": 36,
    "text": "综上所述，",
    "start": 150.96,
    "end": 151.12,
    "duration": 0.16
  },
  {
    "id": 37,
    "text": "《故事新编》以古今杂糅的先锋文体破格与解构神话的哲学深度，",
    "start": 150.96,
    "end": 151.12,
    "duration": 0.16
  },
  {
    "id": 38,
    "text": "刷新了中国小说的艺术边界，",
    "start": 150.96,
    "end": 151.12,
    "duration": 0.16
  },
  {
    "id": 39,
    "text": "确立了中国现代历史小说先锋探索的不可逾越的高峰。",
    "start": 150.96,
    "end": 151.12,
    "duration": 0.16
  }
]