[
  {
    "id": 1,
    "text": "一、全题宏观破题与总揽。",
    "start": 0.0,
    "end": 2.174,
    "duration": 2.174
  },
  {
    "id": 2,
    "text": "一、这一问到底在考什么？",
    "start": 2.174,
    "end": 4.347,
    "duration": 2.173
  },
  {
    "id": 3,
    "text": "本题考查的是鲁迅《故事新编》在现代历史小说文体与思想开掘上的创新品格。",
    "start": 4.347,
    "end": 11.303,
    "duration": 6.956
  },
  {
    "id": 4,
    "text": "考生必须答出鲁迅如何打破传统历史小说的实录或借古讽今范式，",
    "start": 11.303,
    "end": 17.389,
    "duration": 6.086
  },
  {
    "id": 5,
    "text": "从叙事结构、哲学意蕴与晚期美学境界三个层面展现其先锋性。",
    "start": 17.389,
    "end": 23.04,
    "duration": 5.651
  },
  {
    "id": 6,
    "text": "二、答题的总方向是什么？",
    "start": 23.2,
    "end": 25.92,
    "duration": 2.72
  },
  {
    "id": 7,
    "text": "答题必须立足钱理群《中国现代文学三十年》第十七章第二节的核心论述。",
    "start": 25.92,
    "end": 32.32,
    "duration": 6.4
  },
  {
    "id": 8,
    "text": "抓住“古今杂糅”、“油滑”、庄严与荒诞并置、",
    "start": 32.32,
    "end": 36.24,
    "duration": 3.92
  },
  {
    "id": 9,
    "text": "先驱者困境以及晚期从容幽默风格等核心学术支柱。",
    "start": 36.24,
    "end": 41.28,
    "duration": 5.04
  },
  {
    "id": 10,
    "text": "三、分几个板块展开？",
    "start": 41.28,
    "end": 42.88,
    "duration": 1.6
  },
  {
    "id": 11,
    "text": "简答题要求结构精练、得分点突出，",
    "start": 43.28,
    "end": 46.24,
    "duration": 2.96
  },
  {
    "id": 12,
    "text": "分三大板块展开：-第一板块：叙事手法的破格（古今杂糅打破时空、",
    "start": 46.24,
    "end": 52.72,
    "duration": 6.48
  },
  {
    "id": 13,
    "text": "戏谑油滑消解神圣、理水文化山学者例证）。",
    "start": 52.72,
    "end": 56.64,
    "duration": 3.92
  },
  {
    "id": 14,
    "text": "第二板块：思想主旨的深化（庄严与荒诞并置、",
    "start": 56.64,
    "end": 61.04,
    "duration": 4.4
  },
  {
    "id": 15,
    "text": "先驱者成功后的庸常困境、奔月与铸剑例证）。",
    "start": 61.04,
    "end": 64.88,
    "duration": 3.84
  },
  {
    "id": 16,
    "text": "第三板块：文体形式与晚期风格（杂文融于神话小说、",
    "start": 65.2,
    "end": 69.44,
    "duration": 4.24
  },
  {
    "id": 17,
    "text": "从容幽默内含悲凉的晚期境界）。",
    "start": 69.44,
    "end": 72.08,
    "duration": 2.64
  },
  {
    "id": 18,
    "text": "四、全篇内在逻辑链条是什么？",
    "start": 72.08,
    "end": 74.32,
    "duration": 2.24
  },
  {
    "id": 19,
    "text": "由外在叙事手法与时空打破入手（外在形式创新）趋近于深入到对历史先驱命运与人性荒谬的哲学追问（内在思想深化）趋近于升华到鲁迅晚年跨越文体边界的从容洒脱美学境界（终极风格建构）。",
    "start": 74.32,
    "end": 89.6,
    "duration": 15.28
  },
  {
    "id": 20,
    "text": "三层逻辑由表及里，层层咬合。",
    "start": 89.84,
    "end": 93.04,
    "duration": 3.2
  },
  {
    "id": 21,
    "text": "--。二",
    "start": 93.04,
    "end": 93.28,
    "duration": 0.24
  },
  {
    "id": 22,
    "text": "、各板块逐句咬合推演。",
    "start": 93.68,
    "end": 95.92,
    "duration": 2.24
  },
  {
    "id": 23,
    "text": "（一）宏观定性与破题总起板块。",
    "start": 95.92,
    "end": 98.88,
    "duration": 2.96
  },
  {
    "id": 24,
    "text": "破题推演逻辑：开头必须直接点明《故事新编》在中国现代历史小说史上的文体试验地位。",
    "start": 98.88,
    "end": 106.0,
    "duration": 7.12
  },
  {
    "id": 25,
    "text": "明确指出它与传统历史小说在观念上的根本区别，",
    "start": 106.0,
    "end": 110.4,
    "duration": 4.4
  },
  {
    "id": 26,
    "text": "以“新历史小说先声”高度定性，顺畅引出下文论述。",
    "start": 110.4,
    "end": 114.56,
    "duration": 4.16
  },
  {
    "id": 27,
    "text": "-逐句咬合推导：具体表述到答题语句就是：鲁迅的《故事新编》是中国现代历史小说文体试验的划时代杰作。，",
    "start": 114.8,
    "end": 123.016,
    "duration": 8.216
  },
  {
    "id": 28,
    "text": "这是对考察对象的历史定位。",
    "start": 123.016,
    "end": 125.309,
    "duration": 2.293
  },
  {
    "id": 29,
    "text": "紧接着说明其与传统历史小说的根本断裂，",
    "start": 125.309,
    "end": 128.748,
    "duration": 3.439
  },
  {
    "id": 30,
    "text": "具体表述到答题语句就是：鲁迅彻底摒弃了传统历史小说“据事直书”的考据路径，",
    "start": 128.748,
    "end": 135.054,
    "duration": 6.306
  },
  {
    "id": 31,
    "text": "也超越了单纯借古讽今的政论模式。。",
    "start": 135.054,
    "end": 137.92,
    "duration": 2.866
  },
  {
    "id": 32,
    "text": "随后指出其现代性审视目光与美学张力，",
    "start": 138.136,
    "end": 141.496,
    "duration": 3.36
  },
  {
    "id": 33,
    "text": "具体表述到答题语句就是：他以现代思想眼光激活古人古事，",
    "start": 141.496,
    "end": 146.296,
    "duration": 4.8
  },
  {
    "id": 34,
    "text": "在历史与现实之间建立了充满荒诞感的反讽张力，",
    "start": 146.296,
    "end": 150.136,
    "duration": 3.84
  },
  {
    "id": 35,
    "text": "开创了现代“新历史小说”的先声。。",
    "start": 150.136,
    "end": 152.616,
    "duration": 2.48
  },
  {
    "id": 36,
    "text": "鲁迅的《故事新编》是中国现代历史小说文体试验的划时代杰作。",
    "start": 152.616,
    "end": 157.336,
    "duration": 4.72
  },
  {
    "id": 37,
    "text": "鲁迅彻底摒弃了传统历史小说“据事直书”的考据路径，",
    "start": 157.576,
    "end": 162.056,
    "duration": 4.48
  },
  {
    "id": 38,
    "text": "也超越了单纯借古讽今的政论模式。",
    "start": 162.056,
    "end": 165.016,
    "duration": 2.96
  },
  {
    "id": 39,
    "text": "他以现代思想眼光激活古人古事，在历史与现实之间建立了充满荒诞感的反讽张力，",
    "start": 165.016,
    "end": 172.216,
    "duration": 7.2
  },
  {
    "id": 40,
    "text": "开创了现代“新历史小说”的先声。。",
    "start": 172.216,
    "end": 175.016,
    "duration": 2.8
  },
  {
    "id": 41,
    "text": "（二）第一板块：叙事机制的革命，",
    "start": 175.016,
    "end": 177.896,
    "duration": 2.88
  },
  {
    "id": 42,
    "text": "古今杂糅与油滑笔法。",
    "start": 177.896,
    "end": 179.816,
    "duration": 1.92
  },
  {
    "id": 43,
    "text": "-论证推演逻辑：讲透《故事新编》的形式创新，",
    "start": 179.976,
    "end": 183.383,
    "duration": 3.407
  },
  {
    "id": 44,
    "text": "核心在于钱理群界定的“古今杂糅”与“油滑”。",
    "start": 183.383,
    "end": 186.79,
    "duration": 3.407
  },
  {
    "id": 45,
    "text": "必须先阐明以现代事物侵入远古时空的机制，",
    "start": 186.79,
    "end": 190.597,
    "duration": 3.807
  },
  {
    "id": 46,
    "text": "接着说明借鉴丑角插科打诨的去神圣化功能，",
    "start": 190.597,
    "end": 194.405,
    "duration": 3.808
  },
  {
    "id": 47,
    "text": "最后以《理水》文化山学者开口说洋文为实证，",
    "start": 194.405,
    "end": 198.012,
    "duration": 3.607
  },
  {
    "id": 48,
    "text": "说明其现实讽刺功能。",
    "start": 198.012,
    "end": 199.816,
    "duration": 1.804
  },
  {
    "id": 49,
    "text": "-逐句咬合推导：具体表述到答题语句就是：首先，",
    "start": 199.816,
    "end": 204.06,
    "duration": 4.244
  },
  {
    "id": 50,
    "text": "在叙事机制上，鲁迅创造性地运用了“古今杂糅”与戏谑“油滑”的笔法。，",
    "start": 204.06,
    "end": 210.091,
    "duration": 6.031
  },
  {
    "id": 51,
    "text": "这是第一分论点的核心提炼。",
    "start": 210.091,
    "end": 212.771,
    "duration": 2.68
  },
  {
    "id": 52,
    "text": "紧接着交代打通古今的时空并置策略，",
    "start": 212.771,
    "end": 216.345,
    "duration": 3.574
  },
  {
    "id": 53,
    "text": "具体表述到答题语句就是：鲁迅以古代神话史料为依托，",
    "start": 216.345,
    "end": 221.482,
    "duration": 5.137
  },
  {
    "id": 54,
    "text": "大胆打破时空界限，将现代口语与摩登生活细节植入远古历史情境。。",
    "start": 221.482,
    "end": 227.736,
    "duration": 6.254
  },
  {
    "id": 55,
    "text": "随后解释“油滑”手法的作用机制，",
    "start": 227.896,
    "end": 230.376,
    "duration": 2.48
  },
  {
    "id": 56,
    "text": "具体表述到答题语句就是：他借鉴戏剧丑角手法打破神话人物的神圣光环。。",
    "start": 230.376,
    "end": 236.571,
    "duration": 6.195
  },
  {
    "id": 57,
    "text": "紧接着切入经典文本实证，具体表述到答题语句就是：《理水》中文化山学者满口英文，",
    "start": 236.571,
    "end": 243.46,
    "duration": 6.889
  },
  {
    "id": 58,
    "text": "与艰苦治水的夏禹形成滑稽对照。。",
    "start": 243.46,
    "end": 246.296,
    "duration": 2.836
  },
  {
    "id": 59,
    "text": "最后总结这种叙事机制的认知价值，",
    "start": 246.456,
    "end": 249.576,
    "duration": 3.12
  },
  {
    "id": 60,
    "text": "具体表述到答题语句就是：这种古今错位的叙事方式，",
    "start": 249.576,
    "end": 253.896,
    "duration": 4.32
  },
  {
    "id": 61,
    "text": "使历史成为照亮现代中国精神病灶的镜子。。",
    "start": 253.896,
    "end": 257.176,
    "duration": 3.28
  },
  {
    "id": 62,
    "text": "首先，在叙事机制上，鲁迅创造性地运用了“古今杂糅”与戏谑“油滑”的笔法。",
    "start": 257.56,
    "end": 264.2,
    "duration": 6.64
  },
  {
    "id": 63,
    "text": "鲁迅以古代神话史料为依托，大胆打破时空界限，",
    "start": 264.2,
    "end": 267.96,
    "duration": 3.76
  },
  {
    "id": 64,
    "text": "将现代口语与摩登生活细节植入远古历史情境。",
    "start": 267.96,
    "end": 272.04,
    "duration": 4.08
  },
  {
    "id": 65,
    "text": "他借鉴戏剧丑角手法打破神话人物的神圣光环。",
    "start": 272.04,
    "end": 275.64,
    "duration": 3.6
  },
  {
    "id": 66,
    "text": "《理水》中文化山学者满口英文，与艰苦治水的夏禹形成滑稽对照。",
    "start": 275.8,
    "end": 281.484,
    "duration": 5.684
  },
  {
    "id": 67,
    "text": "这种古今错位的叙事方式，使历史成为照亮现代中国精神病灶的镜子。。",
    "start": 281.484,
    "end": 287.823,
    "duration": 6.339
  },
  {
    "id": 68,
    "text": "（三）第二板块：思想主旨的深化，",
    "start": 287.823,
    "end": 290.447,
    "duration": 2.624
  },
  {
    "id": 69,
    "text": "庄严与荒诞并置及先驱者困境。",
    "start": 290.447,
    "end": 293.288,
    "duration": 2.841
  },
  {
    "id": 70,
    "text": "论证推演逻辑：小说不仅是形式新奇，",
    "start": 293.288,
    "end": 296.44,
    "duration": 3.152
  },
  {
    "id": 71,
    "text": "更有深邃的思想灵魂。",
    "start": 296.44,
    "end": 298.12,
    "duration": 1.68
  },
  {
    "id": 72,
    "text": "鲁迅跳出英雄高光的传统套路，专门写“英雄成功之后怎么办”，",
    "start": 298.12,
    "end": 303.0,
    "duration": 4.88
  },
  {
    "id": 73,
    "text": "以此展现崇高在庸常生活中的磨损。",
    "start": 303.0,
    "end": 305.8,
    "duration": 2.8
  },
  {
    "id": 74,
    "text": "以《奔月》中后羿被琐屑消耗、《铸剑》中复仇惨烈终成看客狂欢为证据，",
    "start": 305.8,
    "end": 311.56,
    "duration": 5.76
  },
  {
    "id": 75,
    "text": "指出崇高被庸俗消费的历史悲凉。",
    "start": 311.56,
    "end": 314.2,
    "duration": 2.64
  },
  {
    "id": 76,
    "text": "-逐句咬合推导：具体表述到答题语句就是：其次，",
    "start": 314.36,
    "end": 318.324,
    "duration": 3.964
  },
  {
    "id": 77,
    "text": "在思想深意上，作品构筑了庄严与荒诞的互渗并置，",
    "start": 318.324,
    "end": 322.705,
    "duration": 4.381
  },
  {
    "id": 78,
    "text": "深刻透视了先驱者的生存困境。，",
    "start": 322.705,
    "end": 325.417,
    "duration": 2.712
  },
  {
    "id": 79,
    "text": "这是第二分论点的观点立桩。",
    "start": 325.417,
    "end": 327.92,
    "duration": 2.503
  },
  {
    "id": 80,
    "text": "紧接着说明其独特的叙事视点选择，",
    "start": 327.92,
    "end": 331.049,
    "duration": 3.129
  },
  {
    "id": 81,
    "text": "具体表述到答题语句就是：鲁迅不满足于展现英雄创业的历史荣光，",
    "start": 331.049,
    "end": 336.89,
    "duration": 5.841
  },
  {
    "id": 82,
    "text": "而是冷峻追问事业成功之后的凡俗日常与现实冷遇。。",
    "start": 336.89,
    "end": 341.48,
    "duration": 4.59
  },
  {
    "id": 83,
    "text": "随后切入第一个经典例证，具体表述到答题语句就是：《奔月》打破英雄神话，",
    "start": 341.64,
    "end": 347.665,
    "duration": 6.025
  },
  {
    "id": 84,
    "text": "细腻呈现后羿功成后被琐碎日常消磨的精神荒原。。",
    "start": 347.665,
    "end": 351.977,
    "duration": 4.312
  },
  {
    "id": 85,
    "text": "紧接着切入第二个经典例证，具体表述到答题语句就是：《铸剑》中悲壮的复仇最终在臣民看热闹的狂欢中沦为围观景观。。",
    "start": 351.977,
    "end": 362.04,
    "duration": 10.063
  },
  {
    "id": 86,
    "text": "最后总结这一并置揭示的历史宿命，",
    "start": 362.2,
    "end": 364.92,
    "duration": 2.72
  },
  {
    "id": 87,
    "text": "具体表述到答题语句就是：鲁迅深刻揭示了崇高理想在庸常历史中遭遇扭曲与消费的悲凉循环。。",
    "start": 364.92,
    "end": 372.84,
    "duration": 7.92
  },
  {
    "id": 88,
    "text": "其次，在思想深意上，作品构筑了庄严与荒诞的互渗并置，",
    "start": 373.208,
    "end": 378.568,
    "duration": 5.36
  },
  {
    "id": 89,
    "text": "深刻透视了先驱者的生存困境。",
    "start": 378.568,
    "end": 381.128,
    "duration": 2.56
  },
  {
    "id": 90,
    "text": "鲁迅不满足于展现英雄创业的历史荣光，",
    "start": 381.128,
    "end": 384.408,
    "duration": 3.28
  },
  {
    "id": 91,
    "text": "而是冷峻追问事业成功之后的凡俗日常与现实冷遇。",
    "start": 384.408,
    "end": 389.208,
    "duration": 4.8
  },
  {
    "id": 92,
    "text": "《奔月》打破英雄神话，细腻呈现后羿功成后被琐碎日常消磨的精神荒原。",
    "start": 389.208,
    "end": 395.128,
    "duration": 5.92
  },
  {
    "id": 93,
    "text": "《铸剑》中悲壮的复仇最终在臣民看热闹的狂欢中沦为围观景观。",
    "start": 395.368,
    "end": 400.803,
    "duration": 5.435
  },
  {
    "id": 94,
    "text": "鲁迅深刻揭示了崇高理想在庸常历史中遭遇扭曲与消费的悲凉循环。",
    "start": 400.803,
    "end": 406.865,
    "duration": 6.062
  },
  {
    "id": 95,
    "text": "--。（四",
    "start": 406.865,
    "end": 407.074,
    "duration": 0.209
  },
  {
    "id": 96,
    "text": "）第三板块：文体形式与晚期美学境界。",
    "start": 407.074,
    "end": 410.209,
    "duration": 3.135
  },
  {
    "id": 97,
    "text": "论证推演逻辑：《故事新编》是鲁迅晚年的绝笔文体试验。",
    "start": 410.209,
    "end": 414.808,
    "duration": 4.599
  },
  {
    "id": 98,
    "text": "必须说明小说如何跨界吸收杂文笔墨与心理描写，",
    "start": 414.888,
    "end": 419.448,
    "duration": 4.56
  },
  {
    "id": 99,
    "text": "打破体裁藩篱。",
    "start": 419.448,
    "end": 420.968,
    "duration": 1.52
  },
  {
    "id": 100,
    "text": "接着概括钱理群所阐发的晚期境界，",
    "start": 420.968,
    "end": 424.328,
    "duration": 3.36
  },
  {
    "id": 101,
    "text": "经历无数风波与死生考验后，呈现出从容、",
    "start": 424.328,
    "end": 428.488,
    "duration": 4.16
  },
  {
    "id": 102,
    "text": "幽默、洒脱而内含沉痛悲凉的最高美学风格。",
    "start": 428.488,
    "end": 432.888,
    "duration": 4.4
  },
  {
    "id": 103,
    "text": "逐句咬合推导：具体表述到答题语句就是：最后，",
    "start": 432.888,
    "end": 437.608,
    "duration": 4.72
  },
  {
    "id": 104,
    "text": "在文体范式上，作品将神话传奇、现代心理与杂文锋芒熔铸为独特的晚期境界。，",
    "start": 437.608,
    "end": 445.048,
    "duration": 7.44
  },
  {
    "id": 105,
    "text": "这是第三分论点的提纲窃领。",
    "start": 445.048,
    "end": 447.048,
    "duration": 2.0
  },
  {
    "id": 106,
    "text": "紧接着说明文体规范的破除与要素熔铸，",
    "start": 447.288,
    "end": 450.968,
    "duration": 3.68
  },
  {
    "id": 107,
    "text": "具体表述到答题语句就是：鲁迅打破了传统文学体裁的严格规制。。",
    "start": 450.968,
    "end": 456.047,
    "duration": 5.079
  },
  {
    "id": 108,
    "text": "随后阐明多种文学要素的熔铸，具体表述到答题语句就是：《故事新编》既保留了古代神话的宏阔想象，",
    "start": 456.047,
    "end": 463.902,
    "duration": 7.855
  },
  {
    "id": 109,
    "text": "又融入了杂文的逻辑透视与心理解剖。。",
    "start": 463.902,
    "end": 466.968,
    "duration": 3.066
  },
  {
    "id": 110,
    "text": "紧接着补充作品文本表现，具体表述到答题语句就是：《补天》的宏大创世与《非攻》的墨子止战，",
    "start": 467.048,
    "end": 474.508,
    "duration": 7.46
  },
  {
    "id": 111,
    "text": "兼具抒情性与论辩性。。",
    "start": 474.508,
    "end": 476.387,
    "duration": 1.879
  },
  {
    "id": 112,
    "text": "最后落到晚期美学品格的升华，具体表述到答题语句就是：鲁迅在晚年创造了从容幽默而内含深沉悲凉的美学格调。。",
    "start": 476.387,
    "end": 486.408,
    "duration": 10.021
  },
  {
    "id": 113,
    "text": "最后，在文体范式上，作品将神话传奇、",
    "start": 486.488,
    "end": 490.248,
    "duration": 3.76
  },
  {
    "id": 114,
    "text": "现代心理与杂文锋芒熔铸为独特的晚期境界。",
    "start": 490.248,
    "end": 494.568,
    "duration": 4.32
  },
  {
    "id": 115,
    "text": "鲁迅打破了传统文学体裁的严格规制。",
    "start": 494.568,
    "end": 497.608,
    "duration": 3.04
  },
  {
    "id": 116,
    "text": "《故事新编》既保留了古代神话的宏阔想象，",
    "start": 497.608,
    "end": 500.968,
    "duration": 3.36
  },
  {
    "id": 117,
    "text": "又融入了杂文的逻辑透视与心理解剖。",
    "start": 500.968,
    "end": 503.848,
    "duration": 2.88
  },
  {
    "id": 118,
    "text": "《补天》的宏大创世与《非攻》的墨子止战，",
    "start": 503.848,
    "end": 507.128,
    "duration": 3.28
  },
  {
    "id": 119,
    "text": "兼具抒情性与论辩性。",
    "start": 507.128,
    "end": 508.968,
    "duration": 1.84
  },
  {
    "id": 120,
    "text": "鲁迅在晚年创造了从容幽默而内含深沉悲凉的美学格调。",
    "start": 509.208,
    "end": 514.008,
    "duration": 4.8
  },
  {
    "id": 121,
    "text": "--。（五",
    "start": 514.008,
    "end": 514.168,
    "duration": 0.16
  },
  {
    "id": 122,
    "text": "）总结升华板块。",
    "start": 514.408,
    "end": 515.688,
    "duration": 1.28
  },
  {
    "id": 123,
    "text": "收口推演逻辑：简短有力的总结收束。",
    "start": 515.688,
    "end": 519.584,
    "duration": 3.896
  },
  {
    "id": 124,
    "text": "重申文体突破与思想高度，点明其在中国小说史上的先锋标杆坐标。",
    "start": 519.584,
    "end": 525.664,
    "duration": 6.08
  },
  {
    "id": 125,
    "text": "逐句咬合推导：具体表述到答题语句就是：综上所述，",
    "start": 525.664,
    "end": 530.464,
    "duration": 4.8
  },
  {
    "id": 126,
    "text": "《故事新编》以古今杂糅的文体破格与解构神话的哲学深度，",
    "start": 530.464,
    "end": 535.744,
    "duration": 5.28
  },
  {
    "id": 127,
    "text": "刷新了中国小说的艺术边界，树立了先锋探索的标杆。。",
    "start": 535.744,
    "end": 539.824,
    "duration": 4.08
  },
  {
    "id": 128,
    "text": "综上所述，《故事新编》以古今杂糅的文体破格与解构神话的哲学深度，",
    "start": 540.144,
    "end": 546.304,
    "duration": 6.16
  },
  {
    "id": 129,
    "text": "刷新了中国小说的艺术边界，树立了先锋探索的标杆。",
    "start": 546.304,
    "end": 550.224,
    "duration": 3.92
  }
]