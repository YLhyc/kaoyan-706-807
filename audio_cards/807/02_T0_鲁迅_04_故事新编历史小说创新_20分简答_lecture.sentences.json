[
  {
    "id": 1,
    "text": "一、全题宏观破题与总揽。",
    "start": 0.0,
    "end": 2.174,
    "duration": 2.174
  },
  {
    "id": 2,
    "text": "一、这一问到底在考什么？",
    "start": 2.174,
    "end": 4.347,
    "duration": 2.173
  },
  {
    "id": 3,
    "text": "本题考查的是鲁迅《故事新编》在现代历史小说文体与思想开掘上的创新品格。",
    "start": 4.347,
    "end": 11.303,
    "duration": 6.956
  },
  {
    "id": 4,
    "text": "考生必须答出鲁迅如何打破传统历史小说的实录或借古讽今范式，",
    "start": 11.303,
    "end": 17.389,
    "duration": 6.086
  },
  {
    "id": 5,
    "text": "从叙事结构、哲学意蕴与晚期美学境界三个层面展现其先锋性。",
    "start": 17.389,
    "end": 23.04,
    "duration": 5.651
  },
  {
    "id": 6,
    "text": "二、答题的总方向是什么？",
    "start": 23.2,
    "end": 25.92,
    "duration": 2.72
  },
  {
    "id": 7,
    "text": "答题必须立足钱理群《中国现代文学三十年》第十七章第二节的核心论述。",
    "start": 25.92,
    "end": 32.32,
    "duration": 6.4
  },
  {
    "id": 8,
    "text": "抓住“古今杂糅”、“油滑”、庄严与荒诞并置、",
    "start": 32.32,
    "end": 36.24,
    "duration": 3.92
  },
  {
    "id": 9,
    "text": "先驱者困境以及晚期从容幽默风格等核心学术支柱。",
    "start": 36.24,
    "end": 41.28,
    "duration": 5.04
  },
  {
    "id": 10,
    "text": "三、分几个板块展开？",
    "start": 41.28,
    "end": 42.88,
    "duration": 1.6
  },
  {
    "id": 11,
    "text": "简答题要求结构精练、得分点突出，",
    "start": 43.28,
    "end": 46.24,
    "duration": 2.96
  },
  {
    "id": 12,
    "text": "分三大板块展开：-第一板块：叙事手法的破格（古今杂糅打破时空、",
    "start": 46.24,
    "end": 52.72,
    "duration": 6.48
  },
  {
    "id": 13,
    "text": "戏谑油滑消解神圣、理水文化山学者例证）。",
    "start": 52.72,
    "end": 56.64,
    "duration": 3.92
  },
  {
    "id": 14,
    "text": "第二板块：思想主旨的深化（庄严与荒诞并置、",
    "start": 56.64,
    "end": 60.72,
    "duration": 4.08
  },
  {
    "id": 15,
    "text": "先驱者成功后的庸常困境、奔月与铸剑例证）。",
    "start": 60.72,
    "end": 64.48,
    "duration": 3.76
  },
  {
    "id": 16,
    "text": "第三板块：文体形式与晚期风格（杂文融于神话小说、",
    "start": 64.72,
    "end": 69.2,
    "duration": 4.48
  },
  {
    "id": 17,
    "text": "从容幽默内含悲凉的晚期境界）。",
    "start": 69.2,
    "end": 72.0,
    "duration": 2.8
  },
  {
    "id": 18,
    "text": "四、全篇内在逻辑链条是什么？",
    "start": 72.0,
    "end": 74.4,
    "duration": 2.4
  },
  {
    "id": 19,
    "text": "由外在叙事手法与时空打破入手（外在形式创新）趋近于深入到对历史先驱命运与人性荒谬的哲学追问（内在思想深化）趋近于升华到鲁迅晚年跨越文体边界的从容洒脱美学境界（晚期成熟美学风格）。",
    "start": 74.4,
    "end": 89.52,
    "duration": 15.12
  },
  {
    "id": 20,
    "text": "三层逻辑由表及里，层层咬合。",
    "start": 89.84,
    "end": 92.8,
    "duration": 2.96
  },
  {
    "id": 21,
    "text": "二、各板块逐句咬合推演。",
    "start": 92.8,
    "end": 94.96,
    "duration": 2.16
  },
  {
    "id": 22,
    "text": "（一）宏观定性与破题总起板块。",
    "start": 94.96,
    "end": 97.68,
    "duration": 2.72
  },
  {
    "id": 23,
    "text": "破题推演逻辑：开头必须直接点明《故事新编》在中国现代历史小说史上的文体试验地位。",
    "start": 97.68,
    "end": 104.56,
    "duration": 6.88
  },
  {
    "id": 24,
    "text": "明确指出它与传统历史小说在观念上的根本区别，",
    "start": 104.56,
    "end": 108.48,
    "duration": 3.92
  },
  {
    "id": 25,
    "text": "以“新历史小说先声”高度定性，顺畅引出下文论述。",
    "start": 108.48,
    "end": 112.56,
    "duration": 4.08
  },
  {
    "id": 26,
    "text": "-逐句咬合推导：具体表述到答题语句就是：鲁迅的《故事新编》是中国现代历史小说文体试验的划时代杰作。，",
    "start": 112.72,
    "end": 120.965,
    "duration": 8.245
  },
  {
    "id": 27,
    "text": "这是对考察对象的历史定位。",
    "start": 120.965,
    "end": 123.265,
    "duration": 2.3
  },
  {
    "id": 28,
    "text": "紧接着说明其与传统历史小说的根本断裂，",
    "start": 123.265,
    "end": 126.717,
    "duration": 3.452
  },
  {
    "id": 29,
    "text": "具体表述到答题语句就是：鲁迅彻底摒弃了传统历史小说“据事直书”的考据路径，",
    "start": 126.717,
    "end": 133.044,
    "duration": 6.327
  },
  {
    "id": 30,
    "text": "也超越了单纯借古讽今的政论模式。",
    "start": 133.044,
    "end": 135.92,
    "duration": 2.876
  },
  {
    "id": 31,
    "text": "随后指出其现代性审视目光与美学张力，",
    "start": 136.144,
    "end": 139.504,
    "duration": 3.36
  },
  {
    "id": 32,
    "text": "具体表述到答题语句就是：他以现代思想眼光激活古人古事，",
    "start": 139.504,
    "end": 144.304,
    "duration": 4.8
  },
  {
    "id": 33,
    "text": "在历史与现实之间建立了充满荒诞感的反讽张力，",
    "start": 144.304,
    "end": 148.144,
    "duration": 3.84
  },
  {
    "id": 34,
    "text": "开创了现代“新历史小说”的先声。",
    "start": 148.144,
    "end": 150.624,
    "duration": 2.48
  },
  {
    "id": 35,
    "text": "鲁迅的《故事新编》是中国现代历史小说文体试验的划时代杰作。",
    "start": 150.624,
    "end": 155.344,
    "duration": 4.72
  },
  {
    "id": 36,
    "text": "鲁迅彻底摒弃了传统历史小说“据事直书”的考据路径，",
    "start": 155.584,
    "end": 160.304,
    "duration": 4.72
  },
  {
    "id": 37,
    "text": "也超越了单纯借古讽今的政论模式。",
    "start": 160.304,
    "end": 163.584,
    "duration": 3.28
  },
  {
    "id": 38,
    "text": "他以现代思想眼光激活古人古事，在历史与现实之间建立了充满荒诞感的反讽张力，",
    "start": 163.584,
    "end": 170.704,
    "duration": 7.12
  },
  {
    "id": 39,
    "text": "开创了现代“新历史小说”的先声。",
    "start": 170.704,
    "end": 173.344,
    "duration": 2.64
  },
  {
    "id": 40,
    "text": "（二）第一板块：叙事机制的革命，",
    "start": 173.344,
    "end": 176.384,
    "duration": 3.04
  },
  {
    "id": 41,
    "text": "古今杂糅与油滑笔法。",
    "start": 176.384,
    "end": 178.624,
    "duration": 2.24
  },
  {
    "id": 42,
    "text": "-论证推演逻辑：讲透《故事新编》的形式创新，",
    "start": 178.784,
    "end": 182.191,
    "duration": 3.407
  },
  {
    "id": 43,
    "text": "核心在于钱理群界定的“古今杂糅”与“油滑”。",
    "start": 182.191,
    "end": 185.598,
    "duration": 3.407
  },
  {
    "id": 44,
    "text": "必须先阐明以现代事物侵入远古时空的机制，",
    "start": 185.598,
    "end": 189.405,
    "duration": 3.807
  },
  {
    "id": 45,
    "text": "接着说明借鉴丑角插科打诨的去神圣化功能，",
    "start": 189.405,
    "end": 193.213,
    "duration": 3.808
  },
  {
    "id": 46,
    "text": "最后以《理水》文化山学者开口说洋文为实证，",
    "start": 193.213,
    "end": 196.82,
    "duration": 3.607
  },
  {
    "id": 47,
    "text": "说明其现实讽刺功能。",
    "start": 196.82,
    "end": 198.624,
    "duration": 1.804
  },
  {
    "id": 48,
    "text": "-逐句咬合推导：具体表述到答题语句就是：首先，",
    "start": 198.624,
    "end": 202.868,
    "duration": 4.244
  },
  {
    "id": 49,
    "text": "在叙事机制上，鲁迅创造性地运用了“古今杂糅”与戏谑“油滑”的笔法。，",
    "start": 202.868,
    "end": 208.899,
    "duration": 6.031
  },
  {
    "id": 50,
    "text": "这是第一分论点的核心提炼。",
    "start": 208.899,
    "end": 211.579,
    "duration": 2.68
  },
  {
    "id": 51,
    "text": "紧接着交代打通古今的时空并置策略，",
    "start": 211.579,
    "end": 215.153,
    "duration": 3.574
  },
  {
    "id": 52,
    "text": "具体表述到答题语句就是：鲁迅以古代神话史料为依托，",
    "start": 215.153,
    "end": 220.29,
    "duration": 5.137
  },
  {
    "id": 53,
    "text": "大胆打破时空界限，将现代口语与摩登生活细节植入远古历史情境。",
    "start": 220.29,
    "end": 226.544,
    "duration": 6.254
  },
  {
    "id": 54,
    "text": "随后解释“油滑”手法的作用机制，",
    "start": 226.704,
    "end": 229.184,
    "duration": 2.48
  },
  {
    "id": 55,
    "text": "具体表述到答题语句就是：他借鉴戏剧丑角手法打破神话人物的神圣光环。",
    "start": 229.184,
    "end": 235.379,
    "duration": 6.195
  },
  {
    "id": 56,
    "text": "紧接着切入经典文本实证，具体表述到答题语句就是：《理水》中文化山学者满口英文，",
    "start": 235.379,
    "end": 242.268,
    "duration": 6.889
  },
  {
    "id": 57,
    "text": "与艰苦治水的夏禹形成滑稽对照。",
    "start": 242.268,
    "end": 245.104,
    "duration": 2.836
  },
  {
    "id": 58,
    "text": "最后总结这种叙事机制的认知价值，",
    "start": 245.264,
    "end": 248.384,
    "duration": 3.12
  },
  {
    "id": 59,
    "text": "具体表述到答题语句就是：这种古今错位的叙事方式，",
    "start": 248.384,
    "end": 252.704,
    "duration": 4.32
  },
  {
    "id": 60,
    "text": "使历史成为照亮现代中国精神病灶的镜子。",
    "start": 252.704,
    "end": 255.984,
    "duration": 3.28
  },
  {
    "id": 61,
    "text": "首先，在叙事机制上，鲁迅创造性地运用了“古今杂糅”与戏谑“油滑”的笔法。",
    "start": 256.36,
    "end": 263.0,
    "duration": 6.64
  },
  {
    "id": 62,
    "text": "鲁迅以古代神话史料为依托，大胆打破时空界限，",
    "start": 263.0,
    "end": 266.76,
    "duration": 3.76
  },
  {
    "id": 63,
    "text": "将现代口语与摩登生活细节植入远古历史情境。",
    "start": 266.76,
    "end": 270.84,
    "duration": 4.08
  },
  {
    "id": 64,
    "text": "他借鉴戏剧丑角手法打破神话人物的神圣光环。",
    "start": 270.84,
    "end": 274.44,
    "duration": 3.6
  },
  {
    "id": 65,
    "text": "《理水》中文化山学者满口英文，与艰苦治水的夏禹形成滑稽对照。",
    "start": 274.6,
    "end": 280.284,
    "duration": 5.684
  },
  {
    "id": 66,
    "text": "这种古今错位的叙事方式，使历史成为照亮现代中国精神病灶的镜子。",
    "start": 280.284,
    "end": 286.623,
    "duration": 6.339
  },
  {
    "id": 67,
    "text": "（三）第二板块：思想主旨的深化，",
    "start": 286.623,
    "end": 289.247,
    "duration": 2.624
  },
  {
    "id": 68,
    "text": "庄严与荒诞并置及先驱者困境。",
    "start": 289.247,
    "end": 292.088,
    "duration": 2.841
  },
  {
    "id": 69,
    "text": "论证推演逻辑：小说不仅是形式新奇，",
    "start": 292.088,
    "end": 295.24,
    "duration": 3.152
  },
  {
    "id": 70,
    "text": "更有深邃的思想灵魂。",
    "start": 295.24,
    "end": 296.92,
    "duration": 1.68
  },
  {
    "id": 71,
    "text": "鲁迅跳出英雄高光的传统套路，专门写“英雄成功之后怎么办”，",
    "start": 296.92,
    "end": 301.8,
    "duration": 4.88
  },
  {
    "id": 72,
    "text": "以此展现崇高在庸常生活中的磨损。",
    "start": 301.8,
    "end": 304.68,
    "duration": 2.88
  },
  {
    "id": 73,
    "text": "以《奔月》中后羿被琐屑消耗、《铸剑》中复仇惨烈终成看客狂欢为证据，",
    "start": 304.68,
    "end": 310.2,
    "duration": 5.52
  },
  {
    "id": 74,
    "text": "指出崇高被庸俗消费的历史悲凉。",
    "start": 310.2,
    "end": 312.92,
    "duration": 2.72
  },
  {
    "id": 75,
    "text": "-逐句咬合推导：具体表述到答题语句就是：其次，",
    "start": 313.08,
    "end": 317.044,
    "duration": 3.964
  },
  {
    "id": 76,
    "text": "在思想深意上，作品构筑了庄严与荒诞的互渗并置，",
    "start": 317.044,
    "end": 321.425,
    "duration": 4.381
  },
  {
    "id": 77,
    "text": "深刻透视了先驱者的生存困境。，",
    "start": 321.425,
    "end": 324.137,
    "duration": 2.712
  },
  {
    "id": 78,
    "text": "这是第二分论点的观点立桩。",
    "start": 324.137,
    "end": 326.64,
    "duration": 2.503
  },
  {
    "id": 79,
    "text": "紧接着说明其独特的叙事视点选择，",
    "start": 326.64,
    "end": 329.769,
    "duration": 3.129
  },
  {
    "id": 80,
    "text": "具体表述到答题语句就是：鲁迅不满足于展现英雄创业的历史荣光，",
    "start": 329.769,
    "end": 335.61,
    "duration": 5.841
  },
  {
    "id": 81,
    "text": "而是冷峻追问事业成功之后的凡俗日常与现实冷遇。",
    "start": 335.61,
    "end": 340.2,
    "duration": 4.59
  },
  {
    "id": 82,
    "text": "随后切入第一个经典例证，具体表述到答题语句就是：《奔月》打破英雄神话，",
    "start": 340.36,
    "end": 346.385,
    "duration": 6.025
  },
  {
    "id": 83,
    "text": "细腻呈现后羿功成后被琐碎日常消磨的精神荒原。",
    "start": 346.385,
    "end": 350.697,
    "duration": 4.312
  },
  {
    "id": 84,
    "text": "紧接着切入第二个经典例证，具体表述到答题语句就是：《铸剑》中悲壮的复仇最终在臣民看热闹的狂欢中沦为围观景观。",
    "start": 350.697,
    "end": 360.76,
    "duration": 10.063
  },
  {
    "id": 85,
    "text": "最后总结这一并置揭示的历史宿命，",
    "start": 360.92,
    "end": 363.64,
    "duration": 2.72
  },
  {
    "id": 86,
    "text": "具体表述到答题语句就是：鲁迅深刻揭示了崇高理想在庸常历史中遭遇扭曲与消费的悲凉循环。",
    "start": 363.64,
    "end": 371.56,
    "duration": 7.92
  },
  {
    "id": 87,
    "text": "其次，在思想深意上，作品构筑了庄严与荒诞的互渗并置，",
    "start": 371.936,
    "end": 377.296,
    "duration": 5.36
  },
  {
    "id": 88,
    "text": "深刻透视了先驱者的生存困境。",
    "start": 377.296,
    "end": 379.856,
    "duration": 2.56
  },
  {
    "id": 89,
    "text": "鲁迅不满足于展现英雄创业的历史荣光，",
    "start": 379.856,
    "end": 383.136,
    "duration": 3.28
  },
  {
    "id": 90,
    "text": "而是冷峻追问事业成功之后的凡俗日常与现实冷遇。",
    "start": 383.136,
    "end": 387.936,
    "duration": 4.8
  },
  {
    "id": 91,
    "text": "《奔月》打破英雄神话，细腻呈现后羿功成后被琐碎日常消磨的精神荒原。",
    "start": 387.936,
    "end": 393.856,
    "duration": 5.92
  },
  {
    "id": 92,
    "text": "《铸剑》中悲壮的复仇最终在臣民看热闹的狂欢中沦为围观景观。",
    "start": 394.096,
    "end": 399.643,
    "duration": 5.547
  },
  {
    "id": 93,
    "text": "鲁迅深刻揭示了崇高理想在庸常历史中遭遇扭曲与消费的悲凉循环。",
    "start": 399.643,
    "end": 405.829,
    "duration": 6.186
  },
  {
    "id": 94,
    "text": "（四）第三板块：文体形式与晚期美学境界。",
    "start": 405.829,
    "end": 409.243,
    "duration": 3.414
  },
  {
    "id": 95,
    "text": "论证推演逻辑：《故事新编》是鲁迅晚年的绝笔文体试验。",
    "start": 409.243,
    "end": 413.936,
    "duration": 4.693
  },
  {
    "id": 96,
    "text": "必须说明小说如何跨界吸收杂文笔墨与心理描写，",
    "start": 414.016,
    "end": 418.256,
    "duration": 4.24
  },
  {
    "id": 97,
    "text": "打破体裁藩篱。",
    "start": 418.256,
    "end": 419.536,
    "duration": 1.28
  },
  {
    "id": 98,
    "text": "接着概括钱理群所阐发的晚期境界，",
    "start": 419.536,
    "end": 422.576,
    "duration": 3.04
  },
  {
    "id": 99,
    "text": "也就是在经历无数风波与死生考验后，",
    "start": 422.576,
    "end": 425.616,
    "duration": 3.04
  },
  {
    "id": 100,
    "text": "呈现出从容、幽默、洒脱而内含沉痛悲凉的成熟美学风格。",
    "start": 425.616,
    "end": 430.496,
    "duration": 4.88
  },
  {
    "id": 101,
    "text": "逐句咬合推导：具体表述到答题语句就是：最后，",
    "start": 430.496,
    "end": 434.416,
    "duration": 3.92
  },
  {
    "id": 102,
    "text": "在文体范式上，作品将神话传奇、现代心理与杂文锋芒熔铸为独特的晚期境界。，",
    "start": 434.416,
    "end": 441.216,
    "duration": 6.8
  },
  {
    "id": 103,
    "text": "这是第三分论点的提纲窃领。",
    "start": 441.216,
    "end": 443.136,
    "duration": 1.92
  },
  {
    "id": 104,
    "text": "紧接着说明文体规范的破除与要素熔铸，",
    "start": 443.376,
    "end": 447.056,
    "duration": 3.68
  },
  {
    "id": 105,
    "text": "具体表述到答题语句就是：鲁迅打破了传统文学体裁的严格规制。",
    "start": 447.056,
    "end": 452.135,
    "duration": 5.079
  },
  {
    "id": 106,
    "text": "随后阐明多种文学要素的熔铸，具体表述到答题语句就是：《故事新编》既保留了古代神话的宏阔想象，",
    "start": 452.135,
    "end": 459.99,
    "duration": 7.855
  },
  {
    "id": 107,
    "text": "又融入了杂文的逻辑透视与心理解剖。",
    "start": 459.99,
    "end": 463.056,
    "duration": 3.066
  },
  {
    "id": 108,
    "text": "紧接着补充作品文本表现，具体表述到答题语句就是：《补天》的宏大创世与《非攻》的墨子止战，",
    "start": 463.136,
    "end": 470.762,
    "duration": 7.626
  },
  {
    "id": 109,
    "text": "兼具抒情性与论辩性。",
    "start": 470.762,
    "end": 472.615,
    "duration": 1.853
  },
  {
    "id": 110,
    "text": "最后落到晚期美学品格的升华，具体表述到答题语句就是：鲁迅在晚年创造了从容幽默而内含深沉悲凉的美学格调。",
    "start": 472.615,
    "end": 482.496,
    "duration": 9.881
  },
  {
    "id": 111,
    "text": "最后，在文体范式上，作品将神话传奇、",
    "start": 482.576,
    "end": 486.336,
    "duration": 3.76
  },
  {
    "id": 112,
    "text": "现代心理与杂文锋芒熔铸为独特的晚期境界。",
    "start": 486.336,
    "end": 490.656,
    "duration": 4.32
  },
  {
    "id": 113,
    "text": "鲁迅打破了传统文学体裁的严格规制。",
    "start": 490.656,
    "end": 493.696,
    "duration": 3.04
  },
  {
    "id": 114,
    "text": "《故事新编》既保留了古代神话的宏阔想象，",
    "start": 493.696,
    "end": 497.056,
    "duration": 3.36
  },
  {
    "id": 115,
    "text": "又融入了杂文的逻辑透视与心理解剖。",
    "start": 497.056,
    "end": 499.936,
    "duration": 2.88
  },
  {
    "id": 116,
    "text": "《补天》的宏大创世与《非攻》的墨子止战，",
    "start": 499.936,
    "end": 503.216,
    "duration": 3.28
  },
  {
    "id": 117,
    "text": "兼具抒情性与论辩性。",
    "start": 503.216,
    "end": 505.056,
    "duration": 1.84
  },
  {
    "id": 118,
    "text": "鲁迅在晚年创造了从容幽默而内含深沉悲凉的美学格调。",
    "start": 505.296,
    "end": 510.336,
    "duration": 5.04
  },
  {
    "id": 119,
    "text": "（五）总结升华板块。",
    "start": 510.336,
    "end": 512.336,
    "duration": 2.0
  },
  {
    "id": 120,
    "text": "收口推演逻辑：简短有力的总结收束。",
    "start": 512.336,
    "end": 516.08,
    "duration": 3.744
  },
  {
    "id": 121,
    "text": "重申文体突破与思想高度，点明其在中国小说史上的先锋标杆坐标。",
    "start": 516.08,
    "end": 522.16,
    "duration": 6.08
  },
  {
    "id": 122,
    "text": "逐句咬合推导：具体表述到答题语句就是：综上所述，",
    "start": 522.16,
    "end": 526.96,
    "duration": 4.8
  },
  {
    "id": 123,
    "text": "《故事新编》以古今杂糅的文体破格与解构神话的哲学深度，",
    "start": 526.96,
    "end": 532.24,
    "duration": 5.28
  },
  {
    "id": 124,
    "text": "刷新了中国小说的艺术边界，树立了先锋探索的标杆。",
    "start": 532.24,
    "end": 536.32,
    "duration": 4.08
  },
  {
    "id": 125,
    "text": "综上所述，《故事新编》以古今杂糅的文体破格与解构神话的哲学深度，",
    "start": 536.64,
    "end": 542.8,
    "duration": 6.16
  },
  {
    "id": 126,
    "text": "刷新了中国小说的艺术边界，树立了先锋探索的标杆。",
    "start": 542.8,
    "end": 546.72,
    "duration": 3.92
  }
]