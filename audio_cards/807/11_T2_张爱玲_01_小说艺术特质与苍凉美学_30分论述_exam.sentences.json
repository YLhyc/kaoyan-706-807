[
  {
    "id": 1,
    "text": "二十世纪四十年代在沦陷区上海文坛异军突起的张爱玲，",
    "start": 0.08,
    "end": 4.72,
    "duration": 4.64
  },
  {
    "id": 2,
    "text": "是中国现代小说史上极具独创性的文学大家。",
    "start": 4.72,
    "end": 8.4,
    "duration": 3.68
  },
  {
    "id": 3,
    "text": "当主流新文学普遍沉浸于宏大历史救亡与政治阶级叙事时，",
    "start": 8.4,
    "end": 13.12,
    "duration": 4.72
  },
  {
    "id": 4,
    "text": "张爱玲独辟蹊径。",
    "start": 13.12,
    "end": 14.56,
    "duration": 1.44
  },
  {
    "id": 5,
    "text": "她以敏锐绝顶的世俗眼光，深情审视洋场都市中饮食男女的生存挣扎与复杂隐秘心理。",
    "start": 14.56,
    "end": 21.36,
    "duration": 6.8
  },
  {
    "id": 6,
    "text": "她的短篇小说集《传奇》构筑了独特的文学世界。",
    "start": 21.6,
    "end": 25.36,
    "duration": 3.76
  },
  {
    "id": 7,
    "text": "其作品交融了古典文学的雅俗传统与西方现代主义的心理洞察。",
    "start": 25.36,
    "end": 30.72,
    "duration": 5.36
  },
  {
    "id": 8,
    "text": "“苍凉”作为其生命体验与艺术哲学的核心，",
    "start": 30.72,
    "end": 34.0,
    "duration": 3.28
  },
  {
    "id": 9,
    "text": "体现于四个深层维度。",
    "start": 34.0,
    "end": 35.76,
    "duration": 1.76
  },
  {
    "id": 10,
    "text": "第一，消解宏大叙事与回归凡俗生存博弈。",
    "start": 35.76,
    "end": 39.52,
    "duration": 3.76
  },
  {
    "id": 11,
    "text": "张爱玲摒弃了时代高昂的政治教化与启蒙口号。",
    "start": 39.52,
    "end": 43.2,
    "duration": 3.68
  },
  {
    "id": 12,
    "text": "她将叙事空间牢牢锚定在上海与香港的公寓弄堂。",
    "start": 43.52,
    "end": 47.68,
    "duration": 4.16
  },
  {
    "id": 13,
    "text": "作家专门书写乱世沉浮中卑微凡人的柴米油盐、",
    "start": 47.68,
    "end": 51.44,
    "duration": 3.76
  },
  {
    "id": 14,
    "text": "婚姻交易与利害算计。",
    "start": 51.44,
    "end": 53.52,
    "duration": 2.08
  },
  {
    "id": 15,
    "text": "《倾城之恋》中的白流苏与范柳原，",
    "start": 53.52,
    "end": 56.24,
    "duration": 2.72
  },
  {
    "id": 16,
    "text": "在战火逼近的香港展开了精明的情感博弈。",
    "start": 56.24,
    "end": 59.44,
    "duration": 3.2
  },
  {
    "id": 17,
    "text": "他们的结合不是崇高爱情的凯旋，而是自私男女在城市沦陷瞬间各取所需的安全妥协。",
    "start": 59.44,
    "end": 66.08,
    "duration": 6.64
  },
  {
    "id": 18,
    "text": "张爱玲以近乎冷酷的清醒，撕碎了现代都市爱情的罗曼蒂克面纱。",
    "start": 66.32,
    "end": 71.92,
    "duration": 5.6
  },
  {
    "id": 19,
    "text": "她揭示出普通人在动荡岁月里脆弱自保的生命真相。",
    "start": 71.92,
    "end": 76.24,
    "duration": 4.32
  },
  {
    "id": 20,
    "text": "第二，深层心理透视与病态人性异化机制的揭示。",
    "start": 76.24,
    "end": 81.28,
    "duration": 5.04
  },
  {
    "id": 21,
    "text": "张爱玲深受《红楼梦》家族传统与弗洛伊德心理分析的双重滋养。",
    "start": 81.28,
    "end": 86.08,
    "duration": 4.8
  },
  {
    "id": 22,
    "text": "她对人性阴暗与病态扭曲的洞察深入骨髓。",
    "start": 86.32,
    "end": 89.92,
    "duration": 3.6
  },
  {
    "id": 23,
    "text": "《金锁记》堪称中国现代文学心理描写的巅峰之作。",
    "start": 89.92,
    "end": 93.76,
    "duration": 3.84
  },
  {
    "id": 24,
    "text": "曹七巧作为一个小麻油店人家的健康姑娘，",
    "start": 93.76,
    "end": 97.04,
    "duration": 3.28
  },
  {
    "id": 25,
    "text": "被金钱买卖推入姜家残疾少爷的病榻。",
    "start": 97.04,
    "end": 100.24,
    "duration": 3.2
  },
  {
    "id": 26,
    "text": "长期被压抑的情欲与贪婪，最终将她扭曲为变态的吃人恶魔。",
    "start": 100.24,
    "end": 104.8,
    "duration": 4.56
  },
  {
    "id": 27,
    "text": "她戴着沉重的黄金枷锁劈杀身边的一切，",
    "start": 105.12,
    "end": 108.32,
    "duration": 3.2
  },
  {
    "id": 28,
    "text": "不仅毁掉了儿女的终身幸福，更毁灭了自己的人性本真。",
    "start": 108.32,
    "end": 112.8,
    "duration": 4.48
  },
  {
    "id": 29,
    "text": "张爱玲展示了礼教与金钱双重压榨下，",
    "start": 112.8,
    "end": 116.24,
    "duration": 3.44
  },
  {
    "id": 30,
    "text": "人类精神全面崩塌的恐怖图景。",
    "start": 116.24,
    "end": 118.72,
    "duration": 2.48
  },
  {
    "id": 31,
    "text": "第三，“参差的对照”与大厦将倾的苍凉美学基调。",
    "start": 119.024,
    "end": 123.504,
    "duration": 4.48
  },
  {
    "id": 32,
    "text": "张爱玲在文学文论中明确倡导“参差的对照”。",
    "start": 123.504,
    "end": 127.504,
    "duration": 4.0
  },
  {
    "id": 33,
    "text": "她不追求激烈狂暴的悲壮高潮，而是着力营构一种沉重而回味悠长的苍凉之感。",
    "start": 127.504,
    "end": 134.864,
    "duration": 7.36
  },
  {
    "id": 34,
    "text": "在现代摩登的高楼大厦背后，游荡着古老封建家族腐朽颓败的幽灵。",
    "start": 134.864,
    "end": 140.544,
    "duration": 5.68
  },
  {
    "id": 35,
    "text": "在奢华喧嚣的社交舞会深处，弥漫着人情冷漠与生存绝望。",
    "start": 140.864,
    "end": 145.904,
    "duration": 5.04
  },
  {
    "id": 36,
    "text": "《红玫瑰与白玫瑰》中佟振保在道德体面与肉体欲望之间反复挣扎。",
    "start": 145.904,
    "end": 151.504,
    "duration": 5.6
  },
  {
    "id": 37,
    "text": "这种世俗喧闹与冷酷荒凉的强烈对照，",
    "start": 151.504,
    "end": 154.704,
    "duration": 3.2
  },
  {
    "id": 38,
    "text": "形成了无所不在的苍凉底色。",
    "start": 154.704,
    "end": 157.104,
    "duration": 2.4
  },
  {
    "id": 39,
    "text": "那是看穿繁华终将化为废墟的末世叹息。",
    "start": 157.104,
    "end": 160.384,
    "duration": 3.28
  },
  {
    "id": 40,
    "text": "第四，古典白话笔触与现代意象化修辞的完美化合。",
    "start": 160.704,
    "end": 165.824,
    "duration": 5.12
  },
  {
    "id": 41,
    "text": "张爱玲的小说语言在现代文坛独树一帜。",
    "start": 165.824,
    "end": 169.504,
    "duration": 3.68
  },
  {
    "id": 42,
    "text": "她继承了《金瓶梅》《红楼梦》传神洗练的世俗白话韵味，",
    "start": 169.504,
    "end": 174.304,
    "duration": 4.8
  },
  {
    "id": 43,
    "text": "同时融合了西方现代派的象征与通感修辞。",
    "start": 174.304,
    "end": 178.224,
    "duration": 3.92
  },
  {
    "id": 44,
    "text": "她笔下的意象具有极高辨识度。",
    "start": 178.224,
    "end": 180.624,
    "duration": 2.4
  },
  {
    "id": 45,
    "text": "《金锁记》中那轮“三十年前的月亮”如朵云轩信笺上的泪滴，",
    "start": 180.784,
    "end": 185.679,
    "duration": 4.895
  },
  {
    "id": 46,
    "text": "映照着历史与人生的永恒凄凉。",
    "start": 185.679,
    "end": 188.446,
    "duration": 2.767
  },
  {
    "id": 47,
    "text": "深宅中的穿衣镜、挂在墙上的旧屏风、",
    "start": 188.446,
    "end": 191.638,
    "duration": 3.192
  },
  {
    "id": 48,
    "text": "刺绣精致的旗袍，都化作了囚禁生命的无形牢笼。",
    "start": 191.638,
    "end": 195.895,
    "duration": 4.257
  },
  {
    "id": 49,
    "text": "繁复瑰丽的意象网络，使市井琐屑的传奇叙事升华为具有普遍生命哲思的现代悲剧。",
    "start": 195.895,
    "end": 203.344,
    "duration": 7.449
  },
  {
    "id": 50,
    "text": "张爱玲以世俗叙事超越了单一政治文学的狭隘框限，",
    "start": 203.424,
    "end": 208.144,
    "duration": 4.72
  },
  {
    "id": 51,
    "text": "拓展了中国现代小说的题材版图与心理深度。",
    "start": 208.144,
    "end": 212.144,
    "duration": 4.0
  },
  {
    "id": 52,
    "text": "她的苍凉美学不仅完成了对人性幽微处的惊悚剖析，",
    "start": 212.144,
    "end": 216.704,
    "duration": 4.56
  },
  {
    "id": 53,
    "text": "更以惊世骇俗的现代文体，在中国文学现代转型中留下了不可替代的绝世风华。",
    "start": 216.704,
    "end": 223.104,
    "duration": 6.4
  }
]