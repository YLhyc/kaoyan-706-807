[
  {
    "id": 1,
    "text": "二十世纪四十年代在沦陷区上海文坛异军突起的张爱玲，",
    "start": 0.16,
    "end": 4.8,
    "duration": 4.64
  },
  {
    "id": 2,
    "text": "是中国现代小说史上极具独创性的文学大家。",
    "start": 4.8,
    "end": 8.72,
    "duration": 3.92
  },
  {
    "id": 3,
    "text": "当主流新文学普遍沉浸于宏大历史救亡与政治阶级叙事时，",
    "start": 8.72,
    "end": 13.92,
    "duration": 5.2
  },
  {
    "id": 4,
    "text": "张爱玲独辟蹊径。",
    "start": 13.92,
    "end": 15.68,
    "duration": 1.76
  },
  {
    "id": 5,
    "text": "她以敏锐绝顶的世俗眼光，深情审视洋场都市中饮食男女的生存挣扎与心理深渊。",
    "start": 15.68,
    "end": 22.64,
    "duration": 6.96
  },
  {
    "id": 6,
    "text": "她的短篇小说集《传奇》构筑了独特的文学世界。",
    "start": 22.96,
    "end": 26.72,
    "duration": 3.76
  },
  {
    "id": 7,
    "text": "其作品交融了古典文学的雅俗传统与西方现代主义的心理洞察。",
    "start": 26.72,
    "end": 32.08,
    "duration": 5.36
  },
  {
    "id": 8,
    "text": "“苍凉”作为其生命体验与艺术哲学的核心，",
    "start": 32.08,
    "end": 35.36,
    "duration": 3.28
  },
  {
    "id": 9,
    "text": "体现于四个深层维度。",
    "start": 35.36,
    "end": 37.12,
    "duration": 1.76
  },
  {
    "id": 10,
    "text": "第一，消解宏大叙事与回归凡俗生存博弈。",
    "start": 37.12,
    "end": 40.88,
    "duration": 3.76
  },
  {
    "id": 11,
    "text": "张爱玲摒弃了时代高昂的政治教化与启蒙口号。",
    "start": 40.88,
    "end": 44.56,
    "duration": 3.68
  },
  {
    "id": 12,
    "text": "她将叙事空间牢牢锚定在上海与香港的公寓弄堂。",
    "start": 44.88,
    "end": 49.04,
    "duration": 4.16
  },
  {
    "id": 13,
    "text": "作家专门书写乱世沉浮中卑微凡人的柴米油盐、",
    "start": 49.04,
    "end": 52.8,
    "duration": 3.76
  },
  {
    "id": 14,
    "text": "婚姻交易与利害算计。",
    "start": 52.8,
    "end": 54.88,
    "duration": 2.08
  },
  {
    "id": 15,
    "text": "《倾城之恋》中的白流苏与范柳原，",
    "start": 54.88,
    "end": 57.6,
    "duration": 2.72
  },
  {
    "id": 16,
    "text": "在战火逼近的香港展开了精明的情感博弈。",
    "start": 57.6,
    "end": 60.8,
    "duration": 3.2
  },
  {
    "id": 17,
    "text": "他们的结合不是崇高爱情的凯旋，而是自私男女在城市沦陷瞬间各取所需的安全妥协。",
    "start": 60.8,
    "end": 67.44,
    "duration": 6.64
  },
  {
    "id": 18,
    "text": "张爱玲以近乎冷酷的清醒，撕碎了现代都市爱情的罗曼蒂克面纱。",
    "start": 67.68,
    "end": 73.44,
    "duration": 5.76
  },
  {
    "id": 19,
    "text": "她揭示出普通人在动荡岁月里脆弱自保的生命真相。",
    "start": 73.44,
    "end": 78.24,
    "duration": 4.8
  },
  {
    "id": 20,
    "text": "第二，深层心理透视与人性异化深渊的揭示。",
    "start": 78.24,
    "end": 82.56,
    "duration": 4.32
  },
  {
    "id": 21,
    "text": "张爱玲深受《红楼梦》家族传统与弗洛伊德心理分析的双重滋养。",
    "start": 82.56,
    "end": 87.2,
    "duration": 4.64
  },
  {
    "id": 22,
    "text": "她对人性阴暗与病态扭曲的洞察深入骨髓。",
    "start": 87.44,
    "end": 91.04,
    "duration": 3.6
  },
  {
    "id": 23,
    "text": "《金锁记》堪称中国现代文学心理描写的巅峰之作。",
    "start": 91.04,
    "end": 94.88,
    "duration": 3.84
  },
  {
    "id": 24,
    "text": "曹七巧作为一个小麻油店人家的健康姑娘，",
    "start": 94.88,
    "end": 98.08,
    "duration": 3.2
  },
  {
    "id": 25,
    "text": "被金钱买卖推入姜家残疾少爷的病榻。",
    "start": 98.08,
    "end": 101.12,
    "duration": 3.04
  },
  {
    "id": 26,
    "text": "长期被压抑的情欲与贪婪，最终将她扭曲为变态的吃人恶魔。",
    "start": 101.12,
    "end": 105.76,
    "duration": 4.64
  },
  {
    "id": 27,
    "text": "她戴着沉重的黄金枷锁劈杀身边的一切，",
    "start": 106.08,
    "end": 109.28,
    "duration": 3.2
  },
  {
    "id": 28,
    "text": "不仅毁掉了儿女的终身幸福，更毁灭了自己的人性本真。",
    "start": 109.28,
    "end": 113.76,
    "duration": 4.48
  },
  {
    "id": 29,
    "text": "张爱玲展示了礼教与金钱双重压榨下，",
    "start": 113.76,
    "end": 117.2,
    "duration": 3.44
  },
  {
    "id": 30,
    "text": "人类精神全面崩塌的恐怖图景。",
    "start": 117.2,
    "end": 119.68,
    "duration": 2.48
  },
  {
    "id": 31,
    "text": "第三，“参差的对照”与大厦将倾的苍凉美学基调。",
    "start": 119.984,
    "end": 124.464,
    "duration": 4.48
  },
  {
    "id": 32,
    "text": "张爱玲在文学文论中明确倡导“参差的对照”。",
    "start": 124.464,
    "end": 128.464,
    "duration": 4.0
  },
  {
    "id": 33,
    "text": "她不追求激烈狂暴的悲壮高潮，而是着力营构一种沉重而回味悠长的苍凉之感。",
    "start": 128.464,
    "end": 135.824,
    "duration": 7.36
  },
  {
    "id": 34,
    "text": "在现代摩登的高楼大厦背后，游荡着古老封建家族腐朽颓败的幽灵。",
    "start": 135.824,
    "end": 141.504,
    "duration": 5.68
  },
  {
    "id": 35,
    "text": "在奢华喧嚣的社交舞会深处，弥漫着人情冷漠与生存绝望。",
    "start": 141.824,
    "end": 147.184,
    "duration": 5.36
  },
  {
    "id": 36,
    "text": "《红玫瑰与白玫瑰》中佟振保在道德体面与肉体欲望之间反复挣扎。",
    "start": 147.184,
    "end": 152.944,
    "duration": 5.76
  },
  {
    "id": 37,
    "text": "这种世俗喧闹与深渊寂灭的奇妙并置，",
    "start": 152.944,
    "end": 156.304,
    "duration": 3.36
  },
  {
    "id": 38,
    "text": "形成了无所不在的苍凉底色。",
    "start": 156.304,
    "end": 159.104,
    "duration": 2.8
  },
  {
    "id": 39,
    "text": "那是看穿繁华终将化为废墟的末世叹息。",
    "start": 159.104,
    "end": 162.704,
    "duration": 3.6
  },
  {
    "id": 40,
    "text": "第四，古典白话笔触与现代意象化修辞的完美化合。",
    "start": 163.024,
    "end": 168.144,
    "duration": 5.12
  },
  {
    "id": 41,
    "text": "张爱玲的小说语言在现代文坛独树一帜。",
    "start": 168.144,
    "end": 171.824,
    "duration": 3.68
  },
  {
    "id": 42,
    "text": "她继承了《金瓶梅》《红楼梦》传神洗练的世俗白话韵味，",
    "start": 171.824,
    "end": 176.624,
    "duration": 4.8
  },
  {
    "id": 43,
    "text": "同时融合了西方现代派的象征与通感修辞。",
    "start": 176.624,
    "end": 180.544,
    "duration": 3.92
  },
  {
    "id": 44,
    "text": "她笔下的意象具有极高辨识度。",
    "start": 180.544,
    "end": 182.944,
    "duration": 2.4
  },
  {
    "id": 45,
    "text": "《金锁记》中那轮“三十年前的月亮”如朵云轩信笺上的泪滴，",
    "start": 183.104,
    "end": 187.976,
    "duration": 4.872
  },
  {
    "id": 46,
    "text": "映照着历史与人生的永恒凄凉。",
    "start": 187.976,
    "end": 190.729,
    "duration": 2.753
  },
  {
    "id": 47,
    "text": "深宅中的穿衣镜、挂在墙上的旧屏风、",
    "start": 190.729,
    "end": 193.906,
    "duration": 3.177
  },
  {
    "id": 48,
    "text": "刺绣精致的旗袍，都化作了囚禁生命的无形牢笼。",
    "start": 193.906,
    "end": 198.142,
    "duration": 4.236
  },
  {
    "id": 49,
    "text": "繁复瑰丽的意象网络，使市井琐屑的传奇叙事升华为具有形而上意味的现代悲剧。",
    "start": 198.142,
    "end": 205.344,
    "duration": 7.202
  },
  {
    "id": 50,
    "text": "张爱玲以世俗叙事超越了单一政治文学的狭隘框限，",
    "start": 205.424,
    "end": 210.064,
    "duration": 4.64
  },
  {
    "id": 51,
    "text": "拓展了中国现代小说的题材版图与心理深度。",
    "start": 210.064,
    "end": 214.064,
    "duration": 4.0
  },
  {
    "id": 52,
    "text": "她的苍凉美学不仅完成了对人性幽微处的惊悚剖析，",
    "start": 214.064,
    "end": 218.704,
    "duration": 4.64
  },
  {
    "id": 53,
    "text": "更以惊世骇俗的现代文体，在中国文学现代转型中留下了不可替代的绝世风华。--",
    "start": 218.704,
    "end": 225.024,
    "duration": 6.32
  }
]