[
  {
    "id": 1,
    "text": "北岛作为朦胧诗群的核心代表，其诗歌以强烈的理性反思、",
    "start": 0.08,
    "end": 4.8,
    "duration": 4.72
  },
  {
    "id": 2,
    "text": "怀疑批判精神与冷峻坚毅的现代美学风格，",
    "start": 4.8,
    "end": 8.4,
    "duration": 3.6
  },
  {
    "id": 3,
    "text": "成为新时期思想解放的先声。",
    "start": 8.4,
    "end": 10.88,
    "duration": 2.48
  },
  {
    "id": 4,
    "text": "其思想特质与冷峻美学主要体现在三个方面。",
    "start": 10.88,
    "end": 14.72,
    "duration": 3.84
  },
  {
    "id": 5,
    "text": "第一，批判怀疑精神与独立人格的挺立。",
    "start": 14.72,
    "end": 18.16,
    "duration": 3.44
  },
  {
    "id": 6,
    "text": "北岛诗歌彻底终结了盲从说教的历史神话。",
    "start": 18.16,
    "end": 21.44,
    "duration": 3.28
  },
  {
    "id": 7,
    "text": "他将个体提升为能够独立审视历史与现实的批判主体。",
    "start": 21.68,
    "end": 26.4,
    "duration": 4.72
  },
  {
    "id": 8,
    "text": "在《回答》中，面对动荡荒谬的现实，",
    "start": 26.4,
    "end": 29.44,
    "duration": 3.04
  },
  {
    "id": 9,
    "text": "诗人发出“我，不，相，信”的断然呐喊。",
    "start": 29.44,
    "end": 33.44,
    "duration": 4.0
  },
  {
    "id": 10,
    "text": "他以冷峻的目光撕破伪崇高。",
    "start": 33.44,
    "end": 35.92,
    "duration": 2.48
  },
  {
    "id": 11,
    "text": "而在《宣告》中，“在没有英雄的年代里，",
    "start": 35.92,
    "end": 39.12,
    "duration": 3.2
  },
  {
    "id": 12,
    "text": "我只想做一个人”的诗句，将人的价值与世俗尊严置于首位。",
    "start": 39.12,
    "end": 43.68,
    "duration": 4.56
  },
  {
    "id": 13,
    "text": "诗作表现出决不屈服的硬汉风骨与殉道者情怀。",
    "start": 44.0,
    "end": 48.24,
    "duration": 4.24
  },
  {
    "id": 14,
    "text": "第二，冷色调凝练意象与严密哲理思辨。",
    "start": 48.24,
    "end": 51.68,
    "duration": 3.44
  },
  {
    "id": 15,
    "text": "北岛善于从冰冷的物质世界中提炼高度浓缩的象征意象。",
    "start": 51.68,
    "end": 56.16,
    "duration": 4.48
  },
  {
    "id": 16,
    "text": "冰川、海岸、风暴、锁链与墓志铭等硬质冷色词汇频繁出现。",
    "start": 56.16,
    "end": 61.76,
    "duration": 5.6
  },
  {
    "id": 17,
    "text": "在《回答》中，“卑鄙是卑鄙者的通行证，",
    "start": 61.76,
    "end": 64.72,
    "duration": 2.96
  },
  {
    "id": 18,
    "text": "高尚是高尚者的墓志铭”将两组对立概念并置。",
    "start": 64.72,
    "end": 68.24,
    "duration": 3.52
  },
  {
    "id": 19,
    "text": "诗句如格言般凝练犀利。",
    "start": 68.64,
    "end": 71.2,
    "duration": 2.56
  },
  {
    "id": 20,
    "text": "在《一切》中，他以冷峻的排比勾勒出万象萧索的幻灭感。",
    "start": 71.2,
    "end": 75.76,
    "duration": 4.56
  },
  {
    "id": 21,
    "text": "情绪克制而内敛，充溢着深沉的哲学沉思。",
    "start": 75.76,
    "end": 79.28,
    "duration": 3.52
  },
  {
    "id": 22,
    "text": "第三，悖论反讽结构与抗争性悲剧崇高感。",
    "start": 79.28,
    "end": 82.96,
    "duration": 3.68
  },
  {
    "id": 23,
    "text": "北岛经常采用悖论与反衬手法打破读者的思维惯性。",
    "start": 82.96,
    "end": 87.12,
    "duration": 4.16
  },
  {
    "id": 24,
    "text": "高尚者面临毁灭，卑鄙者却畅行无阻。",
    "start": 87.12,
    "end": 90.16,
    "duration": 3.04
  },
  {
    "id": 25,
    "text": "这种巨大的荒诞反差构成了严峻的现实反讽。",
    "start": 90.48,
    "end": 94.08,
    "duration": 3.6
  },
  {
    "id": 26,
    "text": "但他并没有走向虚无与绝望。",
    "start": 94.08,
    "end": 96.32,
    "duration": 2.24
  },
  {
    "id": 27,
    "text": "诗人愿以肉身化为审判的基石。",
    "start": 96.32,
    "end": 98.96,
    "duration": 2.64
  },
  {
    "id": 28,
    "text": "这种在绝望中执着前行的坚韧姿态，",
    "start": 98.96,
    "end": 102.0,
    "duration": 3.04
  },
  {
    "id": 29,
    "text": "赋予诗作崇高的悲剧美学力量。",
    "start": 102.0,
    "end": 104.64,
    "duration": 2.64
  },
  {
    "id": 30,
    "text": "北岛的诗歌不仅塑造了一代青年独立觉醒的精神肖像，",
    "start": 104.64,
    "end": 108.88,
    "duration": 4.24
  },
  {
    "id": 31,
    "text": "更以其钢铁般的沉稳节律，确立了中国现代汉语诗歌冷峻庄严的理性风范。--",
    "start": 108.88,
    "end": 115.28,
    "duration": 6.4
  }
]