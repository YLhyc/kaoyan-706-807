[
  {
    "id": 1,
    "text": "三十年代至四十年代初，巴金陆续写成《家》《春》《秋》，合称《激流三部曲》，",
    "start": 0.134,
    "end": 6.166,
    "duration": 6.032
  },
  {
    "id": 2,
    "text": "是中国现代文学史上系统控诉封建宗法制度罪恶的长篇系列力作。",
    "start": 6.79,
    "end": 11.882,
    "duration": 5.092
  },
  {
    "id": 3,
    "text": "作品以成都高公馆这一封建大家庭的衰亡为轴心，其思想内容主要体现于以下三个维度：",
    "start": 12.56,
    "end": 24.892,
    "duration": 12.332
  },
  {
    "id": 4,
    "text": "第一，解剖封建宗法制度的专制腐朽，控诉礼教吃人的罪恶本质。",
    "start": 25.57,
    "end": 33.462,
    "duration": 7.892
  },
  {
    "id": 5,
    "text": "小说以高老太爷及第二代家长克明为专制权威的化身，",
    "start": 34.14,
    "end": 37.952,
    "duration": 3.812
  },
  {
    "id": 6,
    "text": "揭露大家庭以虚伪伦理对青年生命与幸福的摧残。",
    "start": 38.331,
    "end": 43.543,
    "duration": 5.212
  },
  {
    "id": 7,
    "text": "《家》中婢女鸣凤被指婚给冯乐山作妾而含恨投湖，",
    "start": 44.221,
    "end": 45.233,
    "duration": 1.012
  },
  {
    "id": 8,
    "text": "瑞珏难产之际遭迷信长辈以“避血光之灾”驱逐出城外草棚惨死；",
    "start": 45.612,
    "end": 47.904,
    "duration": 2.292
  },
  {
    "id": 9,
    "text": "及至《春》《秋》，顺从包办婚姻的蕙表妹忧郁病故，幼女淑贞在恐惧压抑中投井自尽，连续血案撕开了旧礼教的残酷面目。",
    "start": 48.433,
    "end": 53.725,
    "duration": 5.292
  },
  {
    "id": 10,
    "text": "第二，批判封建家庭中的“作揖主义”，揭示妥协顺从的性格悲剧。",
    "start": 54.349,
    "end": 59.481,
    "duration": 5.132
  },
  {
    "id": 11,
    "text": "长房长孙觉新受过五四新思潮影响，却在长辈压迫与宗法责任束缚下奉行“作揖主义”与不抵抗政策。",
    "start": 60.119,
    "end": 68.571,
    "duration": 8.452
  },
  {
    "id": 12,
    "text": "面对包办婚姻、梅表姐病逝与瑞珏惨死，他处处委曲求全，结果既未保住亲人，反在客观上成了旧礼教的牺牲品与帮凶；",
    "start": 69.249,
    "end": 75.901,
    "duration": 6.652
  },
  {
    "id": 13,
    "text": "直到《秋》中克明死去、高家腐化分崩，痛失亲人的觉新才逐步醒悟，走出顺从妥协的泥淖。",
    "start": 76.43,
    "end": 79.362,
    "duration": 2.932
  },
  {
    "id": 14,
    "text": "第三，歌颂叛逆青年的觉醒与反抗，宣告旧家族制度的解体。",
    "start": 80.08,
    "end": 87.012,
    "duration": 6.932
  },
  {
    "id": 15,
    "text": "《家》中五四新青年觉慧敢于打破门第观念爱恋鸣凤、痛斥捉鬼闹剧，",
    "start": 87.65,
    "end": 89.702,
    "duration": 2.052
  },
  {
    "id": 16,
    "text": "并在高老太爷病逝后断然拒绝守孝枷锁，登船离家东下；",
    "start": 90.081,
    "end": 90.573,
    "duration": 0.492
  },
  {
    "id": 17,
    "text": "到《春》中，原本怯懦的淑英亦在觉民、琴等协助下逃出囚笼抗婚出走、赴沪会合觉慧。",
    "start": 91.102,
    "end": 92.994,
    "duration": 1.892
  },
  {
    "id": 18,
    "text": "叛逆队伍的不断壮大与高家最终“树倒猢狲散”的分家结局，",
    "start": 93.752,
    "end": 109.188,
    "duration": 15.436
  },
  {
    "id": 19,
    "text": "彰显了青年一代冲决宗法网罗的时代力量。",
    "start": 109.567,
    "end": 118.819,
    "duration": 9.252
  }
]