[
  {
    "id": 1,
    "text": "三十年代至四十年代初，巴金陆续写成《家》《春》《秋》，合称《激流三部曲》，",
    "start": 0.28,
    "end": 6.49,
    "duration": 6.21
  },
  {
    "id": 2,
    "text": "是中国现代文学史上系统控诉封建宗法制度罪恶的长篇系列力作。",
    "start": 6.97,
    "end": 12.33,
    "duration": 5.36
  },
  {
    "id": 3,
    "text": "作品以成都高公馆这一封建大家庭的衰亡为轴心，其思想内容主要体现于以下三个维度：",
    "start": 12.85,
    "end": 19.81,
    "duration": 6.96
  },
  {
    "id": 4,
    "text": "第一，解剖封建宗法制度的专制腐朽，控诉礼教吃人的罪恶本质。",
    "start": 20.18,
    "end": 25.22,
    "duration": 5.04
  },
  {
    "id": 5,
    "text": "小说以高老太爷及第二代家长克明为专制权威的化身，",
    "start": 25.74,
    "end": 30.06,
    "duration": 4.32
  },
  {
    "id": 6,
    "text": "揭露大家庭以虚伪伦理对青年生命与幸福的摧残。",
    "start": 30.62,
    "end": 35.02,
    "duration": 4.4
  },
  {
    "id": 7,
    "text": "《家》中婢女鸣凤被指婚给冯乐山作妾而含恨投湖，",
    "start": 35.54,
    "end": 40.305,
    "duration": 4.765
  },
  {
    "id": 8,
    "text": "瑞珏难产之际遭迷信长辈以“避血光之灾”驱逐出城外草棚惨死；",
    "start": 40.675,
    "end": 46.87,
    "duration": 6.195
  },
  {
    "id": 9,
    "text": "及至《春》《秋》，顺从包办婚姻的蕙表妹忧郁病故，幼女淑贞在恐惧压抑中投井自尽，连续血案撕开了旧礼教的残酷面目。",
    "start": 47.39,
    "end": 57.15,
    "duration": 9.76
  },
  {
    "id": 10,
    "text": "第二，批判封建家庭中的“作揖主义”，揭示妥协顺从的性格悲剧。",
    "start": 57.67,
    "end": 63.03,
    "duration": 5.36
  },
  {
    "id": 11,
    "text": "长房长孙觉新受过五四新思潮影响，却在长辈压迫与宗法责任束缚下奉行“作揖主义”与不抵抗政策。",
    "start": 63.55,
    "end": 72.75,
    "duration": 9.2
  },
  {
    "id": 12,
    "text": "面对包办婚姻、梅表姐病逝与瑞珏惨死，他处处委曲求全，结果既未保住亲人，反在客观上成了旧礼教的牺牲品与帮凶；",
    "start": 73.27,
    "end": 82.63,
    "duration": 9.36
  },
  {
    "id": 13,
    "text": "直到《秋》中克明死去、高家腐化分崩，痛失亲人的觉新才逐步醒悟，走出顺从妥协的泥淖。",
    "start": 83.15,
    "end": 91.07,
    "duration": 7.92
  },
  {
    "id": 14,
    "text": "第三，歌颂叛逆青年的觉醒与反抗，宣告旧家族制度的解体。",
    "start": 91.59,
    "end": 97.11,
    "duration": 5.52
  },
  {
    "id": 15,
    "text": "《家》中五四新青年觉慧敢于打破门第观念爱恋鸣凤、痛斥捉鬼闹剧，",
    "start": 97.63,
    "end": 103.39,
    "duration": 5.76
  },
  {
    "id": 16,
    "text": "并在高老太爷病逝后断然拒绝守孝枷锁，登船离家东下；",
    "start": 103.76,
    "end": 108.4,
    "duration": 4.64
  },
  {
    "id": 17,
    "text": "到《春》中，原本怯懦的淑英亦在觉民、琴等协助下逃出囚笼抗婚出走、赴沪会合觉慧。",
    "start": 108.92,
    "end": 117.32,
    "duration": 8.4
  },
  {
    "id": 18,
    "text": "叛逆队伍的不断壮大与高家最终“树倒猢狲散”的分家结局，",
    "start": 117.84,
    "end": 122.72,
    "duration": 4.88
  },
  {
    "id": 19,
    "text": "彰显了青年一代冲决宗法网罗的时代力量。",
    "start": 123.09,
    "end": 126.93,
    "duration": 3.84
  }
]