[
  {
    "id": 1,
    "text": "三十年代初，",
    "start": 0.09,
    "end": 1.101,
    "duration": 1.011
  },
  {
    "id": 2,
    "text": "巴金以《家》《春》《秋》构筑的《激流三部曲》，",
    "start": 1.381,
    "end": 4.476,
    "duration": 3.095
  },
  {
    "id": 3,
    "text": "是中国现代文学史上控诉封建宗法制度罪恶、",
    "start": 4.51,
    "end": 8.42,
    "duration": 3.91
  },
  {
    "id": 4,
    "text": "歌颂青年生命觉醒的最具震撼力的史诗画卷。",
    "start": 8.491,
    "end": 11.991,
    "duration": 3.5
  },
  {
    "id": 5,
    "text": "作品以成都高公馆这一典型封建大家族的衰亡为轴心，",
    "start": 12.373,
    "end": 16.893,
    "duration": 4.52
  },
  {
    "id": 6,
    "text": "其深刻的思想内容主要体现于以下三个维度：",
    "start": 16.893,
    "end": 20.071,
    "duration": 3.178
  },
  {
    "id": 7,
    "text": "第一，无情解剖封建宗法制度的专制腐朽，",
    "start": 20.258,
    "end": 23.979,
    "duration": 3.721
  },
  {
    "id": 8,
    "text": "控诉礼教吃人的反动本质。",
    "start": 24.279,
    "end": 26.244,
    "duration": 1.965
  },
  {
    "id": 9,
    "text": "小说以高老太爷为封建大家长权威符号，",
    "start": 26.611,
    "end": 29.889,
    "duration": 3.278
  },
  {
    "id": 10,
    "text": "揭露其以“父为子纲”的虚伪道德对青年一代自由生机的残酷扼杀。",
    "start": 30.255,
    "end": 35.574,
    "duration": 5.319
  },
  {
    "id": 11,
    "text": "婢女鸣凤被高老太爷强行指婚给同辈污浊官僚冯乐山作妾，",
    "start": 35.893,
    "end": 40.481,
    "duration": 4.588
  },
  {
    "id": 12,
    "text": "在反抗无门、绝望至极的黑夜毅然纵身跳入冰冷湖水殉节；",
    "start": 40.831,
    "end": 45.75,
    "duration": 4.919
  },
  {
    "id": 13,
    "text": "长孙媳瑞珏在难产之际，",
    "start": 45.945,
    "end": 47.876,
    "duration": 1.931
  },
  {
    "id": 14,
    "text": "惨遭封建迷信长辈以“避血光之灾”为由强逐至城外阴暗草棚，",
    "start": 48.051,
    "end": 53.595,
    "duration": 5.544
  },
  {
    "id": 15,
    "text": "最终在惨嚎与孤独中断气，",
    "start": 53.68,
    "end": 55.776,
    "duration": 2.096
  },
  {
    "id": 16,
    "text": "淋漓尽致地揭露了封建礼教对年轻生命的血腥吞噬。",
    "start": 56.238,
    "end": 60.231,
    "duration": 3.993
  },
  {
    "id": 17,
    "text": "第二，深刻批判封建家庭内部的“作揖主义”，",
    "start": 60.361,
    "end": 63.594,
    "duration": 3.233
  },
  {
    "id": 18,
    "text": "揭示妥协求全的性格悲剧。",
    "start": 63.689,
    "end": 65.787,
    "duration": 2.098
  },
  {
    "id": 19,
    "text": "长房长孙觉新深受“新潮”洗礼却在传统宗法重压下彻底丧失反抗意志，",
    "start": 66.025,
    "end": 71.844,
    "duration": 5.819
  },
  {
    "id": 20,
    "text": "信奉毫无原则的作揖主义与不抵抗政策。",
    "start": 72.139,
    "end": 75.227,
    "duration": 3.088
  },
  {
    "id": 21,
    "text": "面对婚姻被包办、爱人梅表姐郁郁而终、",
    "start": 75.494,
    "end": 78.389,
    "duration": 2.895
  },
  {
    "id": 22,
    "text": "妻子瑞珏横遭驱逐惨死，他处处委曲求全、委曲求全，",
    "start": 78.577,
    "end": 83.274,
    "duration": 4.697
  },
  {
    "id": 23,
    "text": "最终不仅未能保全家庭安宁，",
    "start": 83.524,
    "end": 85.746,
    "duration": 2.222
  },
  {
    "id": 24,
    "text": "反而沦为杀人礼教的无辜殉葬品与客观帮凶，",
    "start": 85.863,
    "end": 89.324,
    "duration": 3.461
  },
  {
    "id": 25,
    "text": "形成了令人深思的现代性格悲剧。",
    "start": 89.391,
    "end": 91.78,
    "duration": 2.389
  },
  {
    "id": 26,
    "text": "第三，热情歌颂叛逆青年的觉醒决裂，确立奔赴光明的新生活信念。",
    "start": 92.019,
    "end": 97.339,
    "duration": 5.32
  },
  {
    "id": 27,
    "text": "觉慧作为五四新青年的先锋典型，",
    "start": 97.695,
    "end": 100.135,
    "duration": 2.44
  },
  {
    "id": 28,
    "text": "勇敢冲破阶级门第界限与鸣凤相爱，",
    "start": 100.311,
    "end": 103.31,
    "duration": 2.999
  },
  {
    "id": 29,
    "text": "公然在捉鬼闹剧中痛斥巫医迷信，",
    "start": 103.654,
    "end": 106.236,
    "duration": 2.582
  },
  {
    "id": 30,
    "text": "面对家庭长辈的伪善压迫敢于抗争；在高老太爷暴毙、",
    "start": 106.575,
    "end": 110.865,
    "duration": 4.29
  },
  {
    "id": 31,
    "text": "旧制度轰然崩塌的时刻，",
    "start": 111.174,
    "end": 112.789,
    "duration": 1.615
  },
  {
    "id": 32,
    "text": "觉慧断然拒绝沦为封建灵堂里的守孝傀儡，",
    "start": 113.005,
    "end": 116.209,
    "duration": 3.204
  },
  {
    "id": 33,
    "text": "毅然决然登船离家东下，",
    "start": 116.701,
    "end": 118.513,
    "duration": 1.812
  },
  {
    "id": 34,
    "text": "在滔滔江水声中奔向广阔的革命与新生天地，",
    "start": 118.932,
    "end": 122.59,
    "duration": 3.658
  },
  {
    "id": 35,
    "text": "展现了冲决一切宗法网罗的时代叛逆力量。",
    "start": 122.972,
    "end": 126.048,
    "duration": 3.076
  }
]
