[
  {
    "id": 1,
    "text": "三十年代初，",
    "start": 0.16,
    "end": 1.52,
    "duration": 1.36
  },
  {
    "id": 2,
    "text": "巴金以《家》《春》《秋》构筑的《激流三部曲》，",
    "start": 1.52,
    "end": 6.56,
    "duration": 5.04
  },
  {
    "id": 3,
    "text": "是中国现代文学史上控诉封建宗法制度罪恶、",
    "start": 6.56,
    "end": 10.56,
    "duration": 4.0
  },
  {
    "id": 4,
    "text": "歌颂青年生命觉醒的最具震撼力的史诗画卷。",
    "start": 10.56,
    "end": 14.56,
    "duration": 4.0
  },
  {
    "id": 5,
    "text": "作品以成都高公馆这一典型封建大家族的衰亡为轴心，",
    "start": 14.56,
    "end": 19.12,
    "duration": 4.56
  },
  {
    "id": 6,
    "text": "其深刻的思想内容主要体现于以下三个维度：",
    "start": 19.12,
    "end": 23.36,
    "duration": 4.24
  },
  {
    "id": 7,
    "text": "第一，无情解剖封建宗法制度的专制腐朽，",
    "start": 23.36,
    "end": 27.52,
    "duration": 4.16
  },
  {
    "id": 8,
    "text": "控诉礼教吃人的反动本质。",
    "start": 27.52,
    "end": 29.84,
    "duration": 2.32
  },
  {
    "id": 9,
    "text": "小说以高老太爷为封建大家长权威符号，",
    "start": 30.16,
    "end": 33.76,
    "duration": 3.6
  },
  {
    "id": 10,
    "text": "揭露其以“父为子纲”的虚伪道德对青年一代自由生机的残酷扼杀。",
    "start": 33.76,
    "end": 39.76,
    "duration": 6.0
  },
  {
    "id": 11,
    "text": "婢女鸣凤被高老太爷强行指婚给同辈污浊官僚冯乐山作妾，",
    "start": 39.76,
    "end": 45.28,
    "duration": 5.52
  },
  {
    "id": 12,
    "text": "在反抗无门、绝望至极的黑夜毅然纵身跳入冰冷湖水殉节；",
    "start": 45.28,
    "end": 51.04,
    "duration": 5.76
  },
  {
    "id": 13,
    "text": "长孙媳瑞珏在难产之际，",
    "start": 51.12,
    "end": 53.52,
    "duration": 2.4
  },
  {
    "id": 14,
    "text": "惨遭封建迷信长辈以“避血光之灾”为由强逐至城外阴暗草棚，",
    "start": 53.68,
    "end": 59.28,
    "duration": 5.6
  },
  {
    "id": 15,
    "text": "最终在惨嚎与孤独中断气，",
    "start": 59.28,
    "end": 61.92,
    "duration": 2.64
  },
  {
    "id": 16,
    "text": "淋漓尽致地揭露了封建礼教对年轻生命的血腥吞噬。",
    "start": 61.92,
    "end": 65.68,
    "duration": 3.76
  },
  {
    "id": 17,
    "text": "第二，深刻批判封建家庭内部的“作揖主义”，",
    "start": 66.0,
    "end": 70.16,
    "duration": 4.16
  },
  {
    "id": 18,
    "text": "揭示妥协求全的性格悲剧。",
    "start": 70.32,
    "end": 72.88,
    "duration": 2.56
  },
  {
    "id": 19,
    "text": "长房长孙觉新深受“新潮”洗礼却在传统宗法重压下彻底丧失反抗意志，",
    "start": 72.88,
    "end": 79.12,
    "duration": 6.24
  },
  {
    "id": 20,
    "text": "信奉毫无原则的作揖主义与不抵抗政策。",
    "start": 79.12,
    "end": 83.2,
    "duration": 4.08
  },
  {
    "id": 21,
    "text": "面对婚姻被包办、爱人梅表姐郁郁而终、",
    "start": 83.44,
    "end": 86.88,
    "duration": 3.44
  },
  {
    "id": 22,
    "text": "妻子瑞珏横遭驱逐惨死，他处处委曲求全、委曲求全，",
    "start": 86.88,
    "end": 91.2,
    "duration": 4.32
  },
  {
    "id": 23,
    "text": "最终不仅未能保全家庭安宁，",
    "start": 91.2,
    "end": 94.16,
    "duration": 2.96
  },
  {
    "id": 24,
    "text": "反而沦为杀人礼教的无辜殉葬品与客观帮凶，",
    "start": 94.16,
    "end": 97.84,
    "duration": 3.68
  },
  {
    "id": 25,
    "text": "形成了令人深思的现代性格悲剧。",
    "start": 97.84,
    "end": 100.72,
    "duration": 2.88
  },
  {
    "id": 26,
    "text": "第三，热情歌颂叛逆青年的觉醒决裂，确立奔赴光明的新生活信念。",
    "start": 100.72,
    "end": 107.04,
    "duration": 6.32
  },
  {
    "id": 27,
    "text": "觉慧作为五四新青年的先锋典型，",
    "start": 107.04,
    "end": 109.76,
    "duration": 2.72
  },
  {
    "id": 28,
    "text": "勇敢冲破阶级门第界限与鸣凤相爱，",
    "start": 109.76,
    "end": 112.72,
    "duration": 2.96
  },
  {
    "id": 29,
    "text": "公然在捉鬼闹剧中痛斥巫医迷信，",
    "start": 112.96,
    "end": 115.68,
    "duration": 2.72
  },
  {
    "id": 30,
    "text": "面对家庭长辈的伪善压迫敢于抗争；在高老太爷暴毙、",
    "start": 115.68,
    "end": 121.04,
    "duration": 5.36
  },
  {
    "id": 31,
    "text": "旧制度轰然崩塌的时刻，",
    "start": 121.04,
    "end": 123.36,
    "duration": 2.32
  },
  {
    "id": 32,
    "text": "觉慧断然拒绝沦为封建灵堂里的守孝傀儡，",
    "start": 123.36,
    "end": 125.84,
    "duration": 2.48
  },
  {
    "id": 33,
    "text": "毅然决然登船离家东下，",
    "start": 125.68,
    "end": 125.84,
    "duration": 0.16
  },
  {
    "id": 34,
    "text": "在滔滔江水声中奔向广阔的革命与新生天地，",
    "start": 125.68,
    "end": 125.84,
    "duration": 0.16
  },
  {
    "id": 35,
    "text": "展现了冲决一切宗法网罗的时代叛逆力量。",
    "start": 125.68,
    "end": 125.84,
    "duration": 0.16
  }
]