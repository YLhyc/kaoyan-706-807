[
  {
    "id": 1,
    "text": "农民问题是中国现代历史与社会变革的核心枢纽。",
    "start": 0.08,
    "end": 3.84,
    "duration": 3.76
  },
  {
    "id": 2,
    "text": "现当代文学中农民形象的百年变迁，",
    "start": 3.84,
    "end": 6.8,
    "duration": 2.96
  },
  {
    "id": 3,
    "text": "深刻折射出中国现代思想文化演进与政权结构更迭的历史律动。",
    "start": 6.8,
    "end": 11.84,
    "duration": 5.04
  },
  {
    "id": 4,
    "text": "从五四时期的启蒙批判，到延安与十七年时期的革命翻身，",
    "start": 11.92,
    "end": 16.64,
    "duration": 4.72
  },
  {
    "id": 5,
    "text": "再到新时期的文化反思与人性复归，",
    "start": 16.64,
    "end": 19.68,
    "duration": 3.04
  },
  {
    "id": 6,
    "text": "农民形象经历了由“愚昧待启蒙者”到“历史创造主体”，",
    "start": 19.68,
    "end": 24.24,
    "duration": 4.56
  },
  {
    "id": 7,
    "text": "再到“复杂文化载体与欲望沉浮者”的深刻蜕变。",
    "start": 24.24,
    "end": 28.0,
    "duration": 3.76
  },
  {
    "id": 8,
    "text": "这一演变历程主要展现为四个历史阶段。",
    "start": 28.24,
    "end": 31.76,
    "duration": 3.52
  },
  {
    "id": 9,
    "text": "第一，五四时期的病态灵魂解剖与人道主义启蒙关怀。",
    "start": 31.76,
    "end": 36.48,
    "duration": 4.72
  },
  {
    "id": 10,
    "text": "五四新文学先驱以反封建为己任。",
    "start": 36.48,
    "end": 39.52,
    "duration": 3.04
  },
  {
    "id": 11,
    "text": "农民在作家笔下首先作为宗法礼教毒害下的受害者与病态灵魂呈现。",
    "start": 39.52,
    "end": 45.44,
    "duration": 5.92
  },
  {
    "id": 12,
    "text": "鲁迅在《故乡》中塑造了闰土形象。",
    "start": 45.44,
    "end": 47.92,
    "duration": 2.48
  },
  {
    "id": 13,
    "text": "少年闰土灵动鲜活，中年闰土却被饥荒、",
    "start": 48.24,
    "end": 52.0,
    "duration": 3.76
  },
  {
    "id": 14,
    "text": "苛税与多子折磨成了麻木的“木偶人”。",
    "start": 52.0,
    "end": 55.44,
    "duration": 3.44
  },
  {
    "id": 15,
    "text": "在《祝福》中，祥林嫂在三从四德与神权阴影下沦为乞丐，",
    "start": 55.44,
    "end": 60.48,
    "duration": 5.04
  },
  {
    "id": 16,
    "text": "其关于魂灵的泣血之问被冷漠的看客所吞噬。",
    "start": 60.48,
    "end": 64.64,
    "duration": 4.16
  },
  {
    "id": 17,
    "text": "鲁迅秉持“哀其不幸，怒其不争”的启蒙立场，",
    "start": 64.64,
    "end": 68.88,
    "duration": 4.24
  },
  {
    "id": 18,
    "text": "深刻揭示了宗法制度对农民肉体与精神的残酷扼杀。",
    "start": 68.88,
    "end": 73.2,
    "duration": 4.32
  },
  {
    "id": 19,
    "text": "第二，延安与解放区时期的阶级觉醒与翻身做主叙事。",
    "start": 73.52,
    "end": 78.4,
    "duration": 4.88
  },
  {
    "id": 20,
    "text": "毛泽东《在延安文艺座谈会上的讲话》确立了文艺为工农兵服务的根本方针。",
    "start": 78.4,
    "end": 84.64,
    "duration": 6.24
  },
  {
    "id": 21,
    "text": "农民在文学中的地位发生了翻天覆地的逆转。",
    "start": 84.64,
    "end": 88.32,
    "duration": 3.68
  },
  {
    "id": 22,
    "text": "他们从愚昧落后的启蒙对象，一跃成为革命斗争与根据地建设的历史主体。",
    "start": 88.32,
    "end": 94.08,
    "duration": 5.76
  },
  {
    "id": 23,
    "text": "赵树理的《小二黑结婚》塑造了二黑与小芹等新型青年农民形象。",
    "start": 94.4,
    "end": 100.0,
    "duration": 5.6
  },
  {
    "id": 24,
    "text": "他们勇敢冲破二诸葛、三仙姑等落后迷信家长的阻挠，",
    "start": 100.0,
    "end": 104.96,
    "duration": 4.96
  },
  {
    "id": 25,
    "text": "追求婚姻自主与革命工作。",
    "start": 104.96,
    "end": 107.6,
    "duration": 2.64
  },
  {
    "id": 26,
    "text": "作家运用评书体民间白话，展现了根据地民主政权与土地改革对农民精神面貌的彻底重塑。",
    "start": 107.6,
    "end": 115.2,
    "duration": 7.6
  },
  {
    "id": 27,
    "text": "第三，十七年文学中的社会主义集体化新人塑造与路径探索。",
    "start": 115.496,
    "end": 120.696,
    "duration": 5.2
  },
  {
    "id": 28,
    "text": "新中国成立后，农业合作化与社会主义集体经济成为农村生活的核心轴线。",
    "start": 120.696,
    "end": 126.936,
    "duration": 6.24
  },
  {
    "id": 29,
    "text": "这一时期的文学致力于塑造带领群众走集体化道路的社会主义新人典型。",
    "start": 126.936,
    "end": 133.096,
    "duration": 6.16
  },
  {
    "id": 30,
    "text": "柳青的《创业史》是这一阶段的巅峰之作。",
    "start": 133.096,
    "end": 136.136,
    "duration": 3.04
  },
  {
    "id": 31,
    "text": "主人公梁生宝深怀对党和集体的崇高忠诚。",
    "start": 136.456,
    "end": 140.296,
    "duration": 3.84
  },
  {
    "id": 32,
    "text": "他冒着风雪为互助组买稻种，以无私奉献的公心抵御自私发家致富的郭世富等富农诱惑。",
    "start": 140.296,
    "end": 147.896,
    "duration": 7.6
  },
  {
    "id": 33,
    "text": "作品将农民的命运与新中国社会主义制度的巩固深度绑定，",
    "start": 147.896,
    "end": 152.776,
    "duration": 4.88
  },
  {
    "id": 34,
    "text": "确立了庄严崇高的英雄主义美学。",
    "start": 152.776,
    "end": 155.656,
    "duration": 2.88
  },
  {
    "id": 35,
    "text": "第四，新时期以来的文化寻根反思与复杂人性深度开掘。",
    "start": 155.656,
    "end": 160.376,
    "duration": 4.72
  },
  {
    "id": 36,
    "text": "新时期打破了单一阶级斗争模式，农民形象获得了多维立体的哲学与文化深度。",
    "start": 160.776,
    "end": 167.336,
    "duration": 6.56
  },
  {
    "id": 37,
    "text": "高晓声的，陈换生上城，以敏锐的讽刺笔触，",
    "start": 167.336,
    "end": 171.336,
    "duration": 4.0
  },
  {
    "id": 38,
    "text": "描摹了新时期农民刚吃饱肚子后的精神依附与阿Q式阿Q精神遗存。",
    "start": 171.336,
    "end": 177.256,
    "duration": 5.92
  },
  {
    "id": 39,
    "text": "陈忠实的，白鹿原，则将农民置于数百年宗法文化的宏大历史兴衰中。",
    "start": 177.256,
    "end": 182.776,
    "duration": 5.52
  },
  {
    "id": 40,
    "text": "白嘉轩作为传统儒家宗法文化的守望者，",
    "start": 183.096,
    "end": 186.216,
    "duration": 3.12
  },
  {
    "id": 41,
    "text": "其一生的硬挺与悲凉极具悲剧意蕴。",
    "start": 186.216,
    "end": 189.576,
    "duration": 3.36
  },
  {
    "id": 42,
    "text": "鹿三从忠义长工沦为亲手刺杀儿媳田小娥的封建贵子手。",
    "start": 189.576,
    "end": 194.616,
    "duration": 5.04
  },
  {
    "id": 43,
    "text": "文学重新恢复了农民作为活生生人的复杂欲望、",
    "start": 194.616,
    "end": 198.296,
    "duration": 3.68
  },
  {
    "id": 44,
    "text": "伦理困境与灵魂沉浮。",
    "start": 198.296,
    "end": 200.616,
    "duration": 2.32
  },
  {
    "id": 45,
    "text": "现当代文学农民形象的百年演进，不仅是一部乡土中国的社会变革史，",
    "start": 200.616,
    "end": 205.976,
    "duration": 5.36
  },
  {
    "id": 46,
    "text": "更是一部现代知识分子不断调整与民间关系的情感认同史。",
    "start": 205.976,
    "end": 210.456,
    "duration": 4.48
  },
  {
    "id": 47,
    "text": "文学对农民命运的深情注视与哲学审视，",
    "start": 210.776,
    "end": 214.376,
    "duration": 3.6
  },
  {
    "id": 48,
    "text": "构成了中国文学现代性进程中最沉重也最辉煌的思想基石。",
    "start": 214.376,
    "end": 219.736,
    "duration": 5.36
  }
]