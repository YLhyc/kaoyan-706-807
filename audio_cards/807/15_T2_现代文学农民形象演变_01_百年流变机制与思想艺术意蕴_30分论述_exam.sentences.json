[
  {
    "id": 1,
    "text": "自五四新文学运动发轫至当代社会主义革命建立，",
    "start": 0.08,
    "end": 4.64,
    "duration": 4.56
  },
  {
    "id": 2,
    "text": "中国现代文学的发展史在深层意义上就是一部中国农民的灵魂史与解放史。",
    "start": 4.64,
    "end": 11.36,
    "duration": 6.72
  },
  {
    "id": 3,
    "text": "作为传统农业大国现代转型的核心主体，",
    "start": 11.36,
    "end": 14.96,
    "duration": 3.6
  },
  {
    "id": 4,
    "text": "农民形象在不同历史阶段的思想内涵与审美呈现，",
    "start": 14.96,
    "end": 19.6,
    "duration": 4.64
  },
  {
    "id": 5,
    "text": "深刻折射出时代思潮、政治力量与文人知识分子的视界嬗变。",
    "start": 19.6,
    "end": 25.36,
    "duration": 5.76
  },
  {
    "id": 6,
    "text": "纵观三十年现代文学历程，",
    "start": 25.44,
    "end": 27.76,
    "duration": 2.32
  },
  {
    "id": 7,
    "text": "农民形象的演进主要经历了以下三个层层深化的历史阶段：",
    "start": 27.76,
    "end": 33.2,
    "duration": 5.44
  },
  {
    "id": 8,
    "text": "第一，五四启蒙时期：作为“病态国民”与宗法受害者的悲悯凝视。",
    "start": 33.2,
    "end": 39.92,
    "duration": 6.72
  },
  {
    "id": 9,
    "text": "面对数千年封建专制对民众精神的严酷摧残，",
    "start": 39.92,
    "end": 43.92,
    "duration": 4.0
  },
  {
    "id": 10,
    "text": "五四时期的启蒙知识分子以“哀其不幸，",
    "start": 43.92,
    "end": 47.92,
    "duration": 4.0
  },
  {
    "id": 11,
    "text": "怒其不争”的忧患情怀，",
    "start": 47.92,
    "end": 50.08,
    "duration": 2.16
  },
  {
    "id": 12,
    "text": "将农民作为解剖国民劣根性的典型客体。",
    "start": 50.32,
    "end": 53.68,
    "duration": 3.36
  },
  {
    "id": 13,
    "text": "鲁迅在《故乡》中通过“迅哥儿”二十年后重逢少年玩伴的场景，",
    "start": 53.68,
    "end": 59.68,
    "duration": 6.0
  },
  {
    "id": 14,
    "text": "以闰土那张由昔日神采飞扬的紫圆脸蜕变为深沟爬满、",
    "start": 59.92,
    "end": 65.28,
    "duration": 5.36
  },
  {
    "id": 15,
    "text": "手如松树皮般的苍老面孔，以及一声恭敬而凄楚的“老爷”，",
    "start": 65.28,
    "end": 70.4,
    "duration": 5.12
  },
  {
    "id": 16,
    "text": "以厚壁障般的人格隔膜揭示出封建宗法等级对底层灵魂的深度麻木；",
    "start": 70.4,
    "end": 76.8,
    "duration": 6.4
  },
  {
    "id": 17,
    "text": "在《阿Q正传》中，阿Q在未庄打谷舂米之余，",
    "start": 76.88,
    "end": 81.6,
    "duration": 4.72
  },
  {
    "id": 18,
    "text": "以“儿子打老子”的精神胜利法自欺欺人，",
    "start": 81.6,
    "end": 85.44,
    "duration": 3.84
  },
  {
    "id": 19,
    "text": "临刑前唯恐画圆圈画不圆的荒谬焦虑，",
    "start": 85.44,
    "end": 89.04,
    "duration": 3.6
  },
  {
    "id": 20,
    "text": "将中国传统小农在专制压迫下丧失自我反思能力的奴隶根性揭露无遗；",
    "start": 89.2,
    "end": 95.6,
    "duration": 6.4
  },
  {
    "id": 21,
    "text": "而《祝福》中祥林嫂在风雪呼啸的除夕夜关于“魂灵有无”的凄绝叩问，",
    "start": 95.76,
    "end": 102.864,
    "duration": 7.104
  },
  {
    "id": 22,
    "text": "更将农村妇女在政权、族权、",
    "start": 102.864,
    "end": 105.424,
    "duration": 2.56
  },
  {
    "id": 23,
    "text": "神权与夫权绞杀下的生灵涂炭推向了悲剧巅峰。",
    "start": 105.424,
    "end": 109.424,
    "duration": 4.0
  },
  {
    "id": 24,
    "text": "第二，三十年代左翼时期：",
    "start": 109.424,
    "end": 112.064,
    "duration": 2.64
  },
  {
    "id": 25,
    "text": "在阶级压迫与破产深渊中呈现生存挣扎与自发反抗。",
    "start": 112.064,
    "end": 115.744,
    "duration": 3.68
  },
  {
    "id": 26,
    "text": "伴随马克思主义传播与阶级意识觉醒，",
    "start": 115.824,
    "end": 119.024,
    "duration": 3.2
  },
  {
    "id": 27,
    "text": "文学视线由个体精神启蒙转向社会经济结构的残酷解剖。",
    "start": 119.024,
    "end": 124.064,
    "duration": 5.04
  },
  {
    "id": 28,
    "text": "叶圣陶在《多收了三五斗》中生动描绘了江南农村旧毡帽朋友们丰收成灾、",
    "start": 124.064,
    "end": 131.0,
    "duration": 6.936
  },
  {
    "id": 29,
    "text": "惨遭米行地霸贱价勒索与洋米倾销的破产困境；",
    "start": 131.0,
    "end": 135.328,
    "duration": 4.328
  },
  {
    "id": 30,
    "text": "茅盾在《春蚕》中以细腻的写实笔触展现老通宝倾家荡产、",
    "start": 135.328,
    "end": 140.686,
    "duration": 5.358
  },
  {
    "id": 31,
    "text": "求神拜佛养出绝好蚕茧，",
    "start": 140.686,
    "end": 142.953,
    "duration": 2.267
  },
  {
    "id": 32,
    "text": "却因帝国主义经济入侵与民族工业受挫而落得负债累累的荒诞悲剧，",
    "start": 142.953,
    "end": 148.93,
    "duration": 5.977
  },
  {
    "id": 33,
    "text": "深刻揭示了传统自然经济与封建观念在资本主义巨浪冲击下的全面崩溃；",
    "start": 148.93,
    "end": 155.524,
    "duration": 6.594
  },
  {
    "id": 34,
    "text": "与此同时，",
    "start": 155.524,
    "end": 156.555,
    "duration": 1.031
  },
  {
    "id": 35,
    "text": "老舍在《骆驼祥子》中刻画了从农村破产进城的新移民祥子，",
    "start": 156.555,
    "end": 162.119,
    "duration": 5.564
  },
  {
    "id": 36,
    "text": "展现其怀揣拥有一辆属于自己的黄包车的勤劳梦想，",
    "start": 162.119,
    "end": 166.859,
    "duration": 4.74
  },
  {
    "id": 37,
    "text": "在军阀混战、反动暗探敲诈与流氓剥削的连续摧残下，",
    "start": 166.859,
    "end": 171.744,
    "duration": 4.885
  },
  {
    "id": 38,
    "text": "最终被剥夺全部生存指望、",
    "start": 171.984,
    "end": 174.544,
    "duration": 2.56
  },
  {
    "id": 39,
    "text": "沦为“个人主义末路鬼”的惨痛轨迹，",
    "start": 174.544,
    "end": 177.664,
    "duration": 3.12
  },
  {
    "id": 40,
    "text": "将农民阶级脱离土地后的城市生存悲剧解剖得入木三分。",
    "start": 177.664,
    "end": 182.224,
    "duration": 4.56
  },
  {
    "id": 41,
    "text": "第三，延安与解放区时期：",
    "start": 182.544,
    "end": 184.944,
    "duration": 2.4
  },
  {
    "id": 42,
    "text": "在革命动员与政权更迭中确立“翻身主人翁”的主体地位。",
    "start": 184.944,
    "end": 190.144,
    "duration": 5.2
  },
  {
    "id": 43,
    "text": "随着延安文艺座谈会确立工农兵方向，",
    "start": 190.144,
    "end": 193.744,
    "duration": 3.6
  },
  {
    "id": 44,
    "text": "农民形象发生了根本性的历史翻转，",
    "start": 193.744,
    "end": 197.344,
    "duration": 3.6
  },
  {
    "id": 45,
    "text": "由受苦受难的被启蒙对象转变为创造历史、",
    "start": 197.344,
    "end": 201.104,
    "duration": 3.76
  },
  {
    "id": 46,
    "text": "掌握政权的革命主体与新社会主人。",
    "start": 201.104,
    "end": 204.624,
    "duration": 3.52
  },
  {
    "id": 47,
    "text": "赵树理开创的山药蛋派代表作《小二黑结婚》，以轻松幽默、",
    "start": 204.864,
    "end": 210.304,
    "duration": 5.44
  },
  {
    "id": 48,
    "text": "通俗洗练的民间说唱白话，",
    "start": 210.464,
    "end": 213.024,
    "duration": 2.56
  },
  {
    "id": 49,
    "text": "生动塑造了抗日民主政权保护下成长起来的农村青年小二黑与小芹；",
    "start": 213.024,
    "end": 218.784,
    "duration": 5.76
  },
  {
    "id": 50,
    "text": "他们依靠边区民主新法勇敢击碎二诸葛的封建迷信与三仙姑的荒诞算命，",
    "start": 218.784,
    "end": 225.184,
    "duration": 6.4
  },
  {
    "id": 51,
    "text": "实现自由恋爱与民主选举，",
    "start": 225.184,
    "end": 227.424,
    "duration": 2.24
  },
  {
    "id": 52,
    "text": "成为新中国农村基层民主实践的新型农民；",
    "start": 227.424,
    "end": 231.264,
    "duration": 3.84
  },
  {
    "id": 53,
    "text": "丁玲在《太阳照在桑干河上》中通过暖水屯土地改革的宏大历史风暴，",
    "start": 231.264,
    "end": 237.184,
    "duration": 5.92
  },
  {
    "id": 54,
    "text": "刻画出张裕民、",
    "start": 237.184,
    "end": 238.544,
    "duration": 1.36
  },
  {
    "id": 55,
    "text": "程仁等贫苦农人在工作组进驻与群众运动激发下，",
    "start": 238.544,
    "end": 243.472,
    "duration": 4.928
  },
  {
    "id": 56,
    "text": "从最初对恶霸地主的恐惧观望到勇敢站上斗争台清算罪恶，",
    "start": 243.472,
    "end": 248.672,
    "duration": 5.2
  },
  {
    "id": 57,
    "text": "展现了千百年来卑微低贱的农民在革命熔炉中重塑人格尊严、",
    "start": 248.912,
    "end": 254.112,
    "duration": 5.2
  },
  {
    "id": 58,
    "text": "真正成为大地主人的壮丽精神洗礼。",
    "start": 254.112,
    "end": 257.392,
    "duration": 3.28
  },
  {
    "id": 59,
    "text": "综上所述，",
    "start": 257.392,
    "end": 258.352,
    "duration": 0.96
  },
  {
    "id": 60,
    "text": "中国现代文学中农民形象由五四时期的“苦难木讷的启蒙客体”，",
    "start": 258.352,
    "end": 264.032,
    "duration": 5.68
  },
  {
    "id": 61,
    "text": "演进为三十年代“经济破产中的挣扎个体”，",
    "start": 264.032,
    "end": 265.712,
    "duration": 1.68
  },
  {
    "id": 62,
    "text": "最终定型为延安时期的“革命翻身的历史主体”。",
    "start": 265.552,
    "end": 265.712,
    "duration": 0.16
  },
  {
    "id": 63,
    "text": "这一波澜壮阔的形象嬗变轨迹，",
    "start": 265.552,
    "end": 265.712,
    "duration": 0.16
  },
  {
    "id": 64,
    "text": "不仅是现代作家思想与时代历史同频共振的美学明证，",
    "start": 265.552,
    "end": 265.712,
    "duration": 0.16
  },
  {
    "id": 65,
    "text": "更为理解二十世纪中国社会革命与现代文化重构提供了最坚实的精神实证。",
    "start": 265.552,
    "end": 265.712,
    "duration": 0.16
  }
]