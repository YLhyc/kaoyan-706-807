[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 3.36,
    "duration": 3.28
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 3.36,
    "end": 6.64,
    "duration": 3.28
  },
  {
    "id": 3,
    "text": "这道题考查钱终书学者化小说《围城》。",
    "start": 6.64,
    "end": 10.0,
    "duration": 3.36
  },
  {
    "id": 4,
    "text": "在考场上，考生不能简单只讲方鸿渐和孙柔嘉吵架，",
    "start": 10.0,
    "end": 14.32,
    "duration": 4.32
  },
  {
    "id": 5,
    "text": "而必须紧扣“围城隐喻下的精神困境”与“伪知识分子的文化批判”两大题眼。",
    "start": 14.32,
    "end": 20.48,
    "duration": 6.16
  },
  {
    "id": 6,
    "text": "核心在于回答：围城究竟隐喻了什么困境，",
    "start": 20.72,
    "end": 24.32,
    "duration": 3.6
  },
  {
    "id": 7,
    "text": "以及钱终书如何解剖文人劣根性。",
    "start": 24.32,
    "end": 27.36,
    "duration": 3.04
  },
  {
    "id": 8,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 27.36,
    "end": 30.32,
    "duration": 2.96
  },
  {
    "id": 9,
    "text": "答题必须确立“哲学隐喻（困境）趋近于、",
    "start": 30.32,
    "end": 33.76,
    "duration": 3.44
  },
  {
    "id": 10,
    "text": "社会群像（文化批判）趋近于、艺术风格总结”的流线。",
    "start": 33.76,
    "end": 38.0,
    "duration": 4.24
  },
  {
    "id": 11,
    "text": "前半部分剖析方鸿渐进退失据的心理，",
    "start": 38.0,
    "end": 41.265,
    "duration": 3.265
  },
  {
    "id": 12,
    "text": "后半部分剖析三闾大学伪君子群像（克莱登假文凭、",
    "start": 41.265,
    "end": 45.562,
    "duration": 4.297
  },
  {
    "id": 13,
    "text": "李梅亭贩药），最后归结为学者化讽刺艺术。",
    "start": 45.562,
    "end": 49.04,
    "duration": 3.478
  },
  {
    "id": 14,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 49.2,
    "end": 52.4,
    "duration": 3.2
  },
  {
    "id": 15,
    "text": "全题分为四个核心论述维度：第一维度：界定《围城》作为学者化讽刺艺术最高峰的文学史坐标；",
    "start": 52.4,
    "end": 59.92,
    "duration": 7.52
  },
  {
    "id": 16,
    "text": "第二维度：深入剖析“围城”核心隐喻与方鸿渐进退失据的精神困境；",
    "start": 59.92,
    "end": 65.6,
    "duration": 5.68
  },
  {
    "id": 17,
    "text": "第三维度：深刻论述三闾大学伪知识分子群像的卑琐虚伪与时代文化批判；",
    "start": 65.6,
    "end": 71.76,
    "duration": 6.16
  },
  {
    "id": 18,
    "text": "第四维度：宏观总结作品对人类普遍生存困境与智性反讽的经典定论。",
    "start": 72.0,
    "end": 78.24,
    "duration": 6.24
  },
  {
    "id": 19,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 78.24,
    "end": 82.32,
    "duration": 4.08
  },
  {
    "id": 20,
    "text": "全题逻辑严密咬合：第一步先确立学者讽刺的定性。",
    "start": 82.32,
    "end": 86.96,
    "duration": 4.64
  },
  {
    "id": 21,
    "text": "第二步剖析方鸿渐个体的围城困境与性格软弱。",
    "start": 86.96,
    "end": 91.2,
    "duration": 4.24
  },
  {
    "id": 22,
    "text": "第三步从个体扩展到三闾大学文人群体的文化虚伪。",
    "start": 91.2,
    "end": 95.44,
    "duration": 4.24
  },
  {
    "id": 23,
    "text": "第四步完成宏观历史论证闭环。",
    "start": 95.68,
    "end": 98.48,
    "duration": 2.8
  },
  {
    "id": 24,
    "text": "二、各板块逐句咬合演练。",
    "start": 98.48,
    "end": 100.88,
    "duration": 2.4
  },
  {
    "id": 25,
    "text": "一、开头破题段内部咬合。",
    "start": 100.88,
    "end": 103.28,
    "duration": 2.4
  },
  {
    "id": 26,
    "text": "本段旨在开门见山确立学者讽刺巅峰的立论基石。",
    "start": 103.28,
    "end": 107.68,
    "duration": 4.4
  },
  {
    "id": 27,
    "text": "首句直切经典地位，次句交代精神解剖与生存荒谬。",
    "start": 107.68,
    "end": 112.56,
    "duration": 4.88
  },
  {
    "id": 28,
    "text": "首先，首句必须直接亮出该作在现代文学史上的崇高地位，",
    "start": 112.56,
    "end": 117.52,
    "duration": 4.96
  },
  {
    "id": 29,
    "text": "具体表述到答题语句就是：钱终书所著长篇小说《围城》是中国现代文学史上讽刺艺术与学者化智慧结合得最完美的杰作。",
    "start": 117.52,
    "end": 127.68,
    "duration": 10.16
  },
  {
    "id": 30,
    "text": "-有了经典定性之后，次句必须迅速说明其精神解剖深度与哲理意蕴，",
    "start": 127.896,
    "end": 133.46,
    "duration": 5.564
  },
  {
    "id": 31,
    "text": "具体表述到答题语句就是：作品通过留学生方鸿渐在大后方的坎坷流转，",
    "start": 133.46,
    "end": 139.422,
    "duration": 5.962
  },
  {
    "id": 32,
    "text": "深刻解剖了抗战时期中国现代知识分子的精神萎靡，",
    "start": 139.422,
    "end": 143.794,
    "duration": 4.372
  },
  {
    "id": 33,
    "text": "以超拔的哲理深度展示了人类普遍面临的生存荒谬与沟通隔阂。，",
    "start": 143.794,
    "end": 149.16,
    "duration": 5.366
  },
  {
    "id": 34,
    "text": "这句话直接铺陈出精神困境与文化批判两翼。",
    "start": 149.16,
    "end": 152.936,
    "duration": 3.776
  },
  {
    "id": 35,
    "text": "钱终书所著长篇小说《围城》是中国现代文学史上讽刺艺术与学者化智慧结合得最完美的杰作。",
    "start": 153.096,
    "end": 161.336,
    "duration": 8.24
  },
  {
    "id": 36,
    "text": "作品通过留学生方鸿渐在大后方的坎坷流转，",
    "start": 161.336,
    "end": 165.016,
    "duration": 3.68
  },
  {
    "id": 37,
    "text": "深刻解剖了抗战时期中国现代知识分子的精神萎靡，",
    "start": 165.016,
    "end": 169.656,
    "duration": 4.64
  },
  {
    "id": 38,
    "text": "以超拔的哲理深度展示了人类普遍面临的生存荒谬与沟通隔阂。",
    "start": 169.656,
    "end": 175.096,
    "duration": 5.44
  },
  {
    "id": 39,
    "text": "二、第二板块：“围城”隐喻与知识分子精神困境内部咬合。",
    "start": 175.416,
    "end": 180.776,
    "duration": 5.36
  },
  {
    "id": 40,
    "text": "本段任务是深入剖析城里城外的哲学隐喻，",
    "start": 180.776,
    "end": 184.776,
    "duration": 4.0
  },
  {
    "id": 41,
    "text": "还原方鸿渐在文凭、爱情、婚姻和事业上的进退失据。",
    "start": 184.776,
    "end": 189.816,
    "duration": 5.04
  },
  {
    "id": 42,
    "text": "首先，段首给出统领分论点，具体表述到答题语句就是：首先，",
    "start": 189.816,
    "end": 195.176,
    "duration": 5.36
  },
  {
    "id": 43,
    "text": "小说通过“围城”的核心象征隐喻，",
    "start": 195.176,
    "end": 197.736,
    "duration": 2.56
  },
  {
    "id": 44,
    "text": "精辟揭示了现代知识分子进退失据的精神困境。",
    "start": 197.736,
    "end": 201.496,
    "duration": 3.76
  },
  {
    "id": 45,
    "text": "-随后，调取经典名句点出普遍生存机制：“城外的人想冲进去，",
    "start": 201.736,
    "end": 206.8,
    "duration": 5.064
  },
  {
    "id": 46,
    "text": "城里的人想冲出来”，成为现代人生存状态的经典写照。",
    "start": 206.8,
    "end": 211.441,
    "duration": 4.641
  },
  {
    "id": 47,
    "text": "紧接着，剖析方鸿渐的典型性格软弱：方鸿渐是一个心地善良却缺乏定力、",
    "start": 211.441,
    "end": 217.771,
    "duration": 6.33
  },
  {
    "id": 48,
    "text": "高不成低不就的懦弱知识分子典型。",
    "start": 217.771,
    "end": 220.936,
    "duration": 3.165
  },
  {
    "id": 49,
    "text": "-随后，密集还原克莱登假博士、唐晓芙真爱破灭与孙柔嘉琐碎婚姻的具体细节：他既不甘随波逐流买假文凭却最终买了“克莱登大学”博士，",
    "start": 220.936,
    "end": 232.65,
    "duration": 11.714
  },
  {
    "id": 50,
    "text": "在爱情上既倾心于唐晓芙的纯真却最终陷入与孙柔嘉琐碎窒息的市快婚姻，",
    "start": 232.65,
    "end": 239.343,
    "duration": 6.693
  },
  {
    "id": 51,
    "text": "在事业上面对三闾大学的派系倾轧毫无招架之力。",
    "start": 239.343,
    "end": 243.736,
    "duration": 4.393
  },
  {
    "id": 52,
    "text": "-最后，收束提炼现代人在欲望与幻灭间挣扎的心理宿命：钱终书通过方鸿渐在情感、",
    "start": 243.736,
    "end": 250.942,
    "duration": 7.206
  },
  {
    "id": 53,
    "text": "婚姻、职业中不断奔突却处处受困的悲喜剧，",
    "start": 250.942,
    "end": 254.757,
    "duration": 3.815
  },
  {
    "id": 54,
    "text": "生动展现了现代人在欲望与幻灭之间无从摆脱的心理宿命。",
    "start": 254.757,
    "end": 260.056,
    "duration": 5.299
  },
  {
    "id": 55,
    "text": "首先，小说通过“围城”的核心象征隐喻，",
    "start": 260.272,
    "end": 263.712,
    "duration": 3.44
  },
  {
    "id": 56,
    "text": "精辟揭示了现代知识分子进退失据的精神困境。",
    "start": 263.712,
    "end": 267.792,
    "duration": 4.08
  },
  {
    "id": 57,
    "text": "“城外的人想冲进去，城里的人想冲出来”，",
    "start": 267.792,
    "end": 271.392,
    "duration": 3.6
  },
  {
    "id": 58,
    "text": "成为现代人生存状态的经典写照。",
    "start": 271.392,
    "end": 274.032,
    "duration": 2.64
  },
  {
    "id": 59,
    "text": "方鸿渐是一个心地善良却缺乏定力、",
    "start": 274.032,
    "end": 277.152,
    "duration": 3.12
  },
  {
    "id": 60,
    "text": "高不成低不就的懦弱知识分子典型。",
    "start": 277.152,
    "end": 280.112,
    "duration": 2.96
  },
  {
    "id": 61,
    "text": "他既不甘随波逐流买假文凭却最终买了“克莱登大学”博士，",
    "start": 280.352,
    "end": 285.552,
    "duration": 5.2
  },
  {
    "id": 62,
    "text": "在爱情上既倾心于唐晓芙的纯真却最终陷入与孙柔嘉琐碎窒息的市快婚姻，",
    "start": 285.552,
    "end": 292.512,
    "duration": 6.96
  },
  {
    "id": 63,
    "text": "在事业上面对三闾大学的派系倾轧毫无招架之力。",
    "start": 292.512,
    "end": 297.392,
    "duration": 4.88
  },
  {
    "id": 64,
    "text": "钱终书通过方鸿渐在情感、婚姻、职业中不断奔突却处处受困的悲喜剧，",
    "start": 297.392,
    "end": 303.952,
    "duration": 6.56
  },
  {
    "id": 65,
    "text": "生动展现了现代人在欲望与幻灭之间无从摆脱的心理宿命。",
    "start": 303.952,
    "end": 308.752,
    "duration": 4.8
  },
  {
    "id": 66,
    "text": "三、第三板块：文化批判意蕴与伪知识分子解剖内部咬合。",
    "start": 309.072,
    "end": 314.272,
    "duration": 5.2
  },
  {
    "id": 67,
    "text": "本段任务是直击本题第二问，解剖三闾大学文人群像（高松年、",
    "start": 314.272,
    "end": 319.632,
    "duration": 5.36
  },
  {
    "id": 68,
    "text": "韩学愈、李梅亭），提炼时代故疾。",
    "start": 319.632,
    "end": 322.832,
    "duration": 3.2
  },
  {
    "id": 69,
    "text": "首先，段首给出统领分论点，具体表述到答题语句就是：其次，",
    "start": 322.832,
    "end": 327.952,
    "duration": 5.12
  },
  {
    "id": 70,
    "text": "小说以犀利幽默的学者化笔触，对中西文化畸形交融下伪知识分子的精神病态进行了辛辣的文化批判。",
    "start": 327.952,
    "end": 336.592,
    "duration": 8.64
  },
  {
    "id": 71,
    "text": "-随后，点出三闾大学撕碎道德假面的微缩生态：在三闾大学这一微缩的社会生态中，",
    "start": 336.832,
    "end": 343.757,
    "duration": 6.925
  },
  {
    "id": 72,
    "text": "作者撕碎了知识阶层崇高的道德假面。",
    "start": 343.757,
    "end": 347.016,
    "duration": 3.259
  },
  {
    "id": 73,
    "text": "紧接着，密集还原高校长阴险、韩学愈假文凭、",
    "start": 347.016,
    "end": 350.683,
    "duration": 3.667
  },
  {
    "id": 74,
    "text": "李梅亭带春药贩西药与陆子潇抄名信片的讽刺丑态：高校长专权阴险，",
    "start": 350.683,
    "end": 356.59,
    "duration": 5.907
  },
  {
    "id": 75,
    "text": "韩学愈以假文凭招摇撞骗，李梅亭满口仁义道德却怀揣春药与私贩西药，",
    "start": 356.59,
    "end": 362.7,
    "duration": 6.11
  },
  {
    "id": 76,
    "text": "陆子潇则借抄写名信片附庸风雅。",
    "start": 362.7,
    "end": 365.552,
    "duration": 2.852
  },
  {
    "id": 77,
    "text": "-最后，收束提炼钱氏反讽机智直指盲目崇洋与传统劣根性的文化批判：钱终书以极其精妙奇警的比喻和反讽机智，",
    "start": 365.552,
    "end": 375.779,
    "duration": 10.227
  },
  {
    "id": 78,
    "text": "解剖了这些假现代、假崇高文人灵魂深处的卑琐自私与文化空虚，",
    "start": 375.779,
    "end": 381.654,
    "duration": 5.875
  },
  {
    "id": 79,
    "text": "将讽刺锋芒直指盲目崇洋与传统劣根性合流的时代精神故疾。",
    "start": 381.654,
    "end": 387.312,
    "duration": 5.658
  },
  {
    "id": 80,
    "text": "其次，小说以犀利幽默的学者化笔触，",
    "start": 387.44,
    "end": 390.64,
    "duration": 3.2
  },
  {
    "id": 81,
    "text": "对中西文化畸形交融下伪知识分子的精神病态进行了辛辣的文化批判。",
    "start": 390.64,
    "end": 397.04,
    "duration": 6.4
  },
  {
    "id": 82,
    "text": "在三闾大学这一微缩的社会生态中，",
    "start": 397.04,
    "end": 399.68,
    "duration": 2.64
  },
  {
    "id": 83,
    "text": "作者撕碎了知识阶层崇高的道德假面。",
    "start": 399.68,
    "end": 402.88,
    "duration": 3.2
  },
  {
    "id": 84,
    "text": "高校长专权阴险，韩学愈以假文凭招摇撞骗，",
    "start": 402.88,
    "end": 407.28,
    "duration": 4.4
  },
  {
    "id": 85,
    "text": "李梅亭满口仁义道德却怀揣春药与私贩西药，",
    "start": 407.28,
    "end": 411.52,
    "duration": 4.24
  },
  {
    "id": 86,
    "text": "陆子潇则借抄写名信片附庸风雅。",
    "start": 411.52,
    "end": 414.56,
    "duration": 3.04
  },
  {
    "id": 87,
    "text": "钱终书以极其精妙奇警的比喻和反讽机智，",
    "start": 414.88,
    "end": 418.24,
    "duration": 3.36
  },
  {
    "id": 88,
    "text": "解剖了这些假现代、假崇高文人灵魂深处的卑琐自私与文化空虚，",
    "start": 418.24,
    "end": 423.36,
    "duration": 5.12
  },
  {
    "id": 89,
    "text": "将讽刺锋芒直指盲目崇洋与传统劣根性合流的时代精神故疾。",
    "start": 423.36,
    "end": 428.4,
    "duration": 5.04
  },
  {
    "id": 90,
    "text": "四、结尾收束升华段内部咬合。",
    "start": 428.4,
    "end": 431.36,
    "duration": 2.96
  },
  {
    "id": 91,
    "text": "本段承担全篇论证成果的系统提炼与历史定位，",
