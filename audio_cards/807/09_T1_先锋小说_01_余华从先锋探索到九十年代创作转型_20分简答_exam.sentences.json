[
  {
    "id": 1,
    "text": "八十年代中后期至九十年代，",
    "start": 0.05,
    "end": 2.648,
    "duration": 2.598
  },
  {
    "id": 2,
    "text": "余华的文学创作完成了由激进纯粹的“先锋形式实验”向沉潜温厚的“民间生存叙事”的深刻转型。",
    "start": 2.648,
    "end": 10.704,
    "duration": 8.056
  },
  {
    "id": 3,
    "text": "这一轨迹不仅体现了作家个体美学探索的成熟，",
    "start": 10.704,
    "end": 14.384,
    "duration": 3.68
  },
  {
    "id": 4,
    "text": "更构成了新时期当代小说文体演进的核心切片，",
    "start": 14.384,
    "end": 19.725,
    "duration": 5.341
  },
  {
    "id": 5,
    "text": "其转型机制主要体现于以下三个维度：",
    "start": 19.725,
    "end": 23.483,
    "duration": 3.758
  },
  {
    "id": 6,
    "text": "第一，叙事重心由形式暴力的哲学解构，",
    "start": 23.483,
    "end": 26.392,
    "duration": 2.909
  },
  {
    "id": 7,
    "text": "转向对凡俗底层苦难的深切体认。",
    "start": 26.392,
    "end": 29.146,
    "duration": 2.754
  },
  {
    "id": 8,
    "text": "先锋时期的余华以《现实一种》《一九八六年》闻名，",
    "start": 29.146,
    "end": 33.47,
    "duration": 4.324
  },
  {
    "id": 9,
    "text": "小说热衷于解剖血腥杀戮与非理性本能，通过兄杀弟、",
    "start": 33.47,
    "end": 38.383,
    "duration": 4.913
  },
  {
    "id": 10,
    "text": "弟虐兄直至分尸的极端仪式，",
    "start": 38.383,
    "end": 40.983,
    "duration": 2.6
  },
  {
    "id": 11,
    "text": "冷酷摧毁传统宗法人伦的温情面纱，",
    "start": 40.983,
    "end": 44.289,
    "duration": 3.306
  },
  {
    "id": 12,
    "text": "视世界为不可知与荒诞的迷宫；进入九十年代，",
    "start": 44.289,
    "end": 48.333,
    "duration": 4.044
  },
  {
    "id": 13,
    "text": "余华在《活着》《许三观卖血记》中毅然走出病理学式的暴力迷狂，",
    "start": 48.333,
    "end": 53.713,
    "duration": 5.38
  },
  {
    "id": 14,
    "text": "转而凝视中国普通平民在荒诞岁月中的坚韧承受，",
    "start": 53.713,
    "end": 57.772,
    "duration": 4.059
  },
  {
    "id": 15,
    "text": "赋予苦难中的微小生命以崇高的人性重量。",
    "start": 57.772,
    "end": 61.534,
    "duration": 3.762
  },
  {
    "id": 16,
    "text": "第二，叙事视角由冷漠解剖的“零度叙事”，",
    "start": 61.534,
    "end": 65.123,
    "duration": 3.589
  },
  {
    "id": 17,
    "text": "转向温润深情的“民间说话人视点”。",
    "start": 65.123,
    "end": 68.107,
    "duration": 2.984
  },
  {
    "id": 18,
    "text": "先锋探索阶段，",
    "start": 68.107,
    "end": 69.529,
    "duration": 1.422
  },
  {
    "id": 19,
    "text": "余华以手术刀般的冷静机械剔除主观道德与人道关怀，",
    "start": 69.529,
    "end": 74.359,
    "duration": 4.83
  },
  {
    "id": 20,
    "text": "将人物彻底物化为被命运玩弄的零件；九十年代转型后，",
    "start": 74.359,
    "end": 78.997,
    "duration": 4.638
  },
  {
    "id": 21,
    "text": "作家在《许三观卖血记》中深度吸纳了中国传统民间叙事的说唱基因与世俗智慧，",
    "start": 78.997,
    "end": 85.786,
    "duration": 6.789
  },
  {
    "id": 22,
    "text": "通过许三观在饥荒之年用嘴为孩子们“炒猪肝”的荒诞而辛酸的温馨场景，",
    "start": 85.786,
    "end": 92.157,
    "duration": 6.371
  },
  {
    "id": 23,
    "text": "以朴拙的循环复沓对话，",
    "start": 92.157,
    "end": 94.229,
    "duration": 2.072
  },
  {
    "id": 24,
    "text": "生动建构起一种充满烟火暖意与草根温情的民间叙事立场。",
    "start": 94.229,
    "end": 99.229,
    "duration": 5.0
  },
  {
    "id": 25,
    "text": "第三，生存哲学由虚无荒诞的绝望深渊，",
    "start": 99.229,
    "end": 103.129,
    "duration": 3.9
  },
  {
    "id": 26,
    "text": "升华为向死而生的坚韧生命意志。",
    "start": 103.129,
    "end": 106.431,
    "duration": 3.302
  },
  {
    "id": 27,
    "text": "如果说先锋时期揭示的是命运的深渊与不可逃脱的死局，",
    "start": 106.431,
    "end": 111.205,
    "duration": 4.774
  },
  {
    "id": 28,
    "text": "那么九十年代的余华则重新发现了中国农民的生存韧性与和解力量。",
    "start": 111.205,
    "end": 116.931,
    "duration": 5.726
  },
  {
    "id": 29,
    "text": "在《许三观卖血记》中，许三观为挽救非亲生的重病儿子一乐，",
    "start": 116.931,
    "end": 121.976,
    "duration": 5.045
  },
  {
    "id": 30,
    "text": "沿着铁路线一路卖血直至休克抽搐，",
    "start": 121.976,
    "end": 125.326,
    "duration": 3.35
  },
  {
    "id": 31,
    "text": "以肉身的极限损耗践行了父性大爱，",
    "start": 125.326,
    "end": 128.27,
    "duration": 2.944
  },
  {
    "id": 32,
    "text": "最终在黄泥螺与油条的世俗快慰中与残酷世界实现深层和解，",
    "start": 128.27,
    "end": 134.128,
    "duration": 5.858
  },
  {
    "id": 33,
    "text": "确立了中国当代文学中撼人心魄的坚韧生命哲学。",
    "start": 134.128,
    "end": 138.384,
    "duration": 4.256
  }
]