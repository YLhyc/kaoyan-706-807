[
  {
    "id": 1,
    "text": "八十年代中后期至九十年代，",
    "start": 0.08,
    "end": 2.72,
    "duration": 2.64
  },
  {
    "id": 2,
    "text": "余华的文学创作完成了由激进纯粹的“先锋形式实验”向沉潜温厚的“民间生存叙事”的深刻转型。",
    "start": 2.72,
    "end": 11.52,
    "duration": 8.8
  },
  {
    "id": 3,
    "text": "这一轨迹不仅体现了作家个体美学探索的成熟，",
    "start": 11.52,
    "end": 15.6,
    "duration": 4.08
  },
  {
    "id": 4,
    "text": "更构成了新时期当代小说文体演进的核心切片，",
    "start": 15.6,
    "end": 20.08,
    "duration": 4.48
  },
  {
    "id": 5,
    "text": "其转型机制主要体现于以下三个维度：",
    "start": 20.08,
    "end": 24.08,
    "duration": 4.0
  },
  {
    "id": 6,
    "text": "第一，叙事重心由形式暴力的哲学解构，",
    "start": 24.08,
    "end": 28.0,
    "duration": 3.92
  },
  {
    "id": 7,
    "text": "转向对凡俗底层苦难的深切体认。",
    "start": 28.0,
    "end": 31.84,
    "duration": 3.84
  },
  {
    "id": 8,
    "text": "先锋时期的余华以《现实一种》《一九八六年》闻名，",
    "start": 31.84,
    "end": 36.88,
    "duration": 5.04
  },
  {
    "id": 9,
    "text": "小说热衷于解剖血腥杀戮与非理性本能，通过兄杀弟、",
    "start": 37.12,
    "end": 42.4,
    "duration": 5.28
  },
  {
    "id": 10,
    "text": "弟虐兄直至分尸的极端仪式，",
    "start": 42.4,
    "end": 45.12,
    "duration": 2.72
  },
  {
    "id": 11,
    "text": "冷酷摧毁传统宗法人伦的温情面纱，",
    "start": 45.12,
    "end": 48.64,
    "duration": 3.52
  },
  {
    "id": 12,
    "text": "视世界为不可知与荒诞的迷宫；进入九十年代，",
    "start": 48.64,
    "end": 53.12,
    "duration": 4.48
  },
  {
    "id": 13,
    "text": "余华在《活着》《许三观卖血记》中毅然走出病理学式的暴力迷狂，",
    "start": 53.12,
    "end": 58.96,
    "duration": 5.84
  },
  {
    "id": 14,
    "text": "转而凝视中国普通平民在荒诞岁月中的坚韧承受，",
    "start": 58.96,
    "end": 63.76,
    "duration": 4.8
  },
  {
    "id": 15,
    "text": "赋予苦难中的微小生命以崇高的人性重量。",
    "start": 63.76,
    "end": 67.84,
    "duration": 4.08
  },
  {
    "id": 16,
    "text": "第二，叙事视角由冷漠解剖的“零度叙事”，",
    "start": 68.16,
    "end": 72.4,
    "duration": 4.24
  },
  {
    "id": 17,
    "text": "转向温润深情的“民间说话人视点”。",
    "start": 72.4,
    "end": 75.68,
    "duration": 3.28
  },
  {
    "id": 18,
    "text": "先锋探索阶段，",
    "start": 75.68,
    "end": 77.04,
    "duration": 1.36
  },
  {
    "id": 19,
    "text": "余华以手术刀般的冷静机械剔除主观道德与人道关怀，",
    "start": 77.04,
    "end": 82.08,
    "duration": 5.04
  },
  {
    "id": 20,
    "text": "将人物彻底物化为被命运玩弄的零件；九十年代转型后，",
    "start": 82.08,
    "end": 87.2,
    "duration": 5.12
  },
  {
    "id": 21,
    "text": "作家在《许三观卖血记》中深度吸纳了中国传统民间叙事的说唱基因与世俗智慧，",
    "start": 87.2,
    "end": 94.96,
    "duration": 7.76
  },
  {
    "id": 22,
    "text": "通过许三观在饥荒之年用嘴为孩子们“炒猪肝”的荒诞而辛酸的温馨场景，",
    "start": 94.96,
    "end": 102.0,
    "duration": 7.04
  },
  {
    "id": 23,
    "text": "以朴拙的循环复沓对话，",
    "start": 102.0,
    "end": 104.56,
    "duration": 2.56
  },
  {
    "id": 24,
    "text": "生动建构起一种充满烟火暖意与草根温情的民间叙事立场。",
    "start": 104.56,
    "end": 109.84,
    "duration": 5.28
  },
  {
    "id": 25,
    "text": "第三，生存哲学由虚无荒诞的绝望深渊，",
    "start": 109.84,
    "end": 113.44,
    "duration": 3.6
  },
  {
    "id": 26,
    "text": "升华为向死而生的坚韧生命意志。",
    "start": 113.44,
    "end": 116.16,
    "duration": 2.72
  },
  {
    "id": 27,
    "text": "如果说先锋时期揭示的是命运的深渊与不可逃脱的死局，",
    "start": 116.16,
    "end": 121.68,
    "duration": 5.52
  },
  {
    "id": 28,
    "text": "那么九十年代的余华则重新发现了中国农民的生存韧性与和解力量。",
    "start": 121.84,
    "end": 128.08,
    "duration": 6.24
  },
  {
    "id": 29,
    "text": "在《许三观卖血记》中，许三观为挽救非亲生的重病儿子一乐，",
    "start": 128.24,
    "end": 134.48,
    "duration": 6.24
  },
  {
    "id": 30,
    "text": "沿着铁路线一路卖血直至休克抽搐，",
    "start": 134.48,
    "end": 137.52,
    "duration": 3.04
  },
  {
    "id": 31,
    "text": "以肉身的极限损耗践行了父性大爱，",
    "start": 137.52,
    "end": 138.08,
    "duration": 0.56
  },
  {
    "id": 32,
    "text": "最终在黄泥螺与油条的世俗快慰中与残酷世界实现深层和解，",
    "start": 137.92,
    "end": 138.08,
    "duration": 0.16
  },
  {
    "id": 33,
    "text": "确立了中国当代文学中撼人心魄的坚韧生命哲学。",
    "start": 137.92,
    "end": 138.08,
    "duration": 0.16
  }
]