[
  {
    "id": 1,
    "text": "汪曾祺是中国新时期文学从政治附庸走向审美自足的文体大师。",
    "start": 0.08,
    "end": 5.04,
    "duration": 4.96
  },
  {
    "id": 2,
    "text": "他在二十世纪八十年代初异军突起。",
    "start": 5.04,
    "end": 7.76,
    "duration": 2.72
  },
  {
    "id": 3,
    "text": "他接续了废名与沈从文的京派抒情小说文脉。",
    "start": 7.76,
    "end": 11.04,
    "duration": 3.28
  },
  {
    "id": 4,
    "text": "他有力反拨了极左政治意识形态的教条束缚，",
    "start": 11.04,
    "end": 14.16,
    "duration": 3.12
  },
  {
    "id": 5,
    "text": "也超越了伤痕文学单一的政治悲情控诉。",
    "start": 14.16,
    "end": 16.8,
    "duration": 2.64
  },
  {
    "id": 6,
    "text": "汪曾祺以融通古今的文化自觉，开创了独树一帜的散文化小说范式。",
    "start": 17.12,
    "end": 23.12,
    "duration": 6.0
  },
  {
    "id": 7,
    "text": "他以淡化情节的文体革命、重构人伦温情的和美哲学、",
    "start": 23.12,
    "end": 27.76,
    "duration": 4.64
  },
  {
    "id": 8,
    "text": "以乐写悲的审美意蕴与纯净洗练的汉语语言，",
    "start": 27.76,
    "end": 32.08,
    "duration": 4.32
  },
  {
    "id": 9,
    "text": "为当代中国小说重塑了至纯至真的美学品格。",
    "start": 32.08,
    "end": 36.32,
    "duration": 4.24
  },
  {
    "id": 10,
    "text": "首先，在小说体制上，汪曾祺颠覆了传统小说的因果链条，",
    "start": 36.32,
    "end": 41.2,
    "duration": 4.88
  },
  {
    "id": 11,
    "text": "掀起了“散文化小说”的文体革命。",
    "start": 41.2,
    "end": 43.52,
    "duration": 2.32
  },
  {
    "id": 12,
    "text": "他坚决打破了西方传统小说以强戏剧性冲突、",
    "start": 43.76,
    "end": 47.84,
    "duration": 4.08
  },
  {
    "id": 13,
    "text": "严密因果悬念为核心的叙事范式。",
    "start": 47.84,
    "end": 50.64,
    "duration": 2.8
  },
  {
    "id": 14,
    "text": "汪曾祺主张淡化故事情节，追求“为文无法”的自由流动状态。",
    "start": 50.64,
    "end": 56.0,
    "duration": 5.36
  },
  {
    "id": 15,
    "text": "他以悠闲从容的生活流程与水乡民俗风情作为小说的宏阔容器。",
    "start": 56.0,
    "end": 61.68,
    "duration": 5.68
  },
  {
    "id": 16,
    "text": "在《受戒》中，他用了大半篇幅细致铺陈庵赵庄的鼻荠地、",
    "start": 61.68,
    "end": 66.48,
    "duration": 4.8
  },
  {
    "id": 17,
    "text": "芦花荡与和尚们的世俗生活。",
    "start": 66.48,
    "end": 68.8,
    "duration": 2.32
  },
  {
    "id": 18,
    "text": "在《大闹记事》中，他生动描绘挑夫与锡匠的婚丧嫁娶和行会风习。",
    "start": 69.12,
    "end": 75.28,
    "duration": 6.16
  },
  {
    "id": 19,
    "text": "民俗风情不再是人物表演的被动背景，",
    "start": 75.28,
    "end": 78.56,
    "duration": 3.28
  },
  {
    "id": 20,
    "text": "而是升华为散发着浓郁诗意与生命温度的审美本体。",
    "start": 78.56,
    "end": 83.6,
    "duration": 5.04
  },
  {
    "id": 21,
    "text": "其次，在思想主旨上，汪曾祺构筑了充满人伦温情的“和美”哲学，",
    "start": 83.6,
    "end": 89.44,
    "duration": 5.84
  },
  {
    "id": 22,
    "text": "重塑了民间的人性乌托邦。",
    "start": 89.44,
    "end": 91.52,
    "duration": 2.08
  },
  {
    "id": 23,
    "text": "汪曾祺拒绝在文本中设置非黑即白的激进阶级斗争与残酷暴力冲突。",
    "start": 91.76,
    "end": 97.68,
    "duration": 5.92
  },
  {
    "id": 24,
    "text": "他将审视目光深情投向江南水乡的凡夫俗子。",
    "start": 97.68,
    "end": 101.52,
    "duration": 3.84
  },
  {
    "id": 25,
    "text": "他致力于在凡常生活缝隙中挖掘人性的健康、",
    "start": 101.52,
    "end": 105.76,
    "duration": 4.24
  },
  {
    "id": 26,
    "text": "纯洁与善良。",
    "start": 105.76,
    "end": 107.2,
    "duration": 1.44
  },
  {
    "id": 27,
    "text": "《受戒》中明海与小英子在划船拨芦伟间的纯真爱恋，",
    "start": 107.2,
    "end": 111.52,
    "duration": 4.32
  },
  {
    "id": 28,
    "text": "展现了不受繁文入节束缚的生命觉醒。",
    "start": 111.52,
    "end": 114.32,
    "duration": 2.8
  },
  {
    "id": 29,
    "text": "《大闹记事》中巧云以温热的尿液救治被恶霸毒打的十一子，",
    "start": 114.48,
    "end": 119.143,
    "duration": 4.663
  },
  {
    "id": 30,
    "text": "洋溢着患难相恤的人性圣洁之光。",
    "start": 119.143,
    "end": 121.863,
    "duration": 2.72
  },
  {
    "id": 31,
    "text": "这种对人间温情的肯定，不仅抚慰了历史创伤，",
    "start": 121.863,
    "end": 125.554,
    "duration": 3.691
  },
  {
    "id": 32,
    "text": "更为当代文学确立了自然健康的人道主义理想。",
    "start": 125.554,
    "end": 129.44,
    "duration": 3.886
  },
  {
    "id": 33,
    "text": "第三，在美学意蕴上，汪曾祺的小说展现出“以乐写悲”的复杂张力，",
    "start": 129.584,
    "end": 135.744,
    "duration": 6.16
  },
  {
    "id": 34,
    "text": "蕴含着深沉的生命沧桑感。",
    "start": 135.744,
    "end": 138.304,
    "duration": 2.56
  },
  {
    "id": 35,
    "text": "表面上看，汪曾祺的叙述温和舒缓，",
    "start": 138.304,
    "end": 141.424,
    "duration": 3.12
  },
  {
    "id": 36,
    "text": "笔下世界和乐融融。",
    "start": 141.424,
    "end": 143.504,
    "duration": 2.08
  },
  {
    "id": 37,
    "text": "但这绝非浅薄轻浮的盲目欢歌。",
    "start": 143.504,
    "end": 146.464,
    "duration": 2.96
  },
  {
    "id": 38,
    "text": "他的和美世界背后深藏着严酷的时代创伤与对生命苦难的沉痛反思。",
    "start": 146.464,
    "end": 152.144,
    "duration": 5.68
  },
  {
    "id": 39,
    "text": "正如批评家李陀指出其小说深处的苦涩之美。",
    "start": 152.384,
    "end": 156.304,
    "duration": 3.92
  },
  {
    "id": 40,
    "text": "《异秉》在详尽描摹王二靠卖熏烧卤肉发家的喜剧表象下，",
    "start": 156.304,
    "end": 161.104,
    "duration": 4.8
  },
  {
    "id": 41,
    "text": "不动声色地展现了底层小人物忍辱负重、",
    "start": 161.104,
    "end": 164.464,
    "duration": 3.36
  },
  {
    "id": 42,
    "text": "卑微苟活的生存艰辛与心理畸变。",
    "start": 164.464,
    "end": 167.664,
    "duration": 3.2
  },
  {
    "id": 43,
    "text": "这种将深重苦难包裹在平静幽默叙事中的笔法，",
    "start": 167.664,
    "end": 171.424,
    "duration": 3.76
  },
  {
    "id": 44,
    "text": "使小说的抒情获得了耐人咀嚼的历史厚重感。",
    "start": 171.424,
    "end": 175.104,
    "duration": 3.68
  },
  {
    "id": 45,
    "text": "最后，在语言艺术上，汪曾祺以纯正典雅的白话文笔，",
    "start": 175.344,
    "end": 180.464,
    "duration": 5.12
  },
  {
    "id": 46,
    "text": "捍卫了现代汉语的纯净性。",
    "start": 180.464,
    "end": 182.624,
    "duration": 2.16
  },
  {
    "id": 47,
    "text": "汪曾祺坚决剔除公式化政治口号与欧化长句的臃肿黏滞。",
    "start": 182.784,
    "end": 188.384,
    "duration": 5.6
  },
  {
    "id": 48,
    "text": "他创造性地将地道的方言口语与典雅的文言短句熔铸于一炉。",
    "start": 188.384,
    "end": 193.984,
    "duration": 5.6
  },
  {
    "id": 49,
    "text": "他的句子短促洗练，节奏明快，长于白描而少用浓墨重彩的修饰。",
    "start": 193.984,
    "end": 199.504,
    "duration": 5.52
  },
  {
    "id": 50,
    "text": "他的文字看似平淡无奇，实则每一个字都经过了千锤百炼，",
    "start": 199.744,
    "end": 205.104,
    "duration": 5.36
  },
  {
    "id": 51,
    "text": "展现出中国古典诗歌般流动的韵律感。",
    "start": 205.104,
    "end": 208.464,
    "duration": 3.36
  },
  {
    "id": 52,
    "text": "这种平淡天真的纯净语言，不仅恢复了白话中文的本体魅力，",
    "start": 208.464,
    "end": 213.664,
    "duration": 5.2
  },
  {
    "id": 53,
    "text": "更确立了中国当代小说语言的最高美学标杆。",
    "start": 213.664,
    "end": 217.344,
    "duration": 3.68
  },
  {
    "id": 54,
    "text": "综上所述，汪曾祺以从容不迫的散文化探索，",
    "start": 217.344,
    "end": 221.424,
    "duration": 4.08
  },
  {
    "id": 55,
    "text": "打破了传统小说的体裁藩篱。",
    "start": 221.424,
    "end": 223.664,
    "duration": 2.24
  },
  {
    "id": 56,
    "text": "他以和美的人性理想重塑了文学的精神温度，",
    "start": 223.904,
    "end": 227.824,
    "duration": 3.92
  },
  {
    "id": 57,
    "text": "以纯净的母语写作铸就了独特的艺术极境，",
    "start": 227.824,
    "end": 231.584,
    "duration": 3.76
  },
  {
    "id": 58,
    "text": "是中国当代文学史上兼具文体自觉与人文深度的里程碑式经典作家。",
    "start": 231.584,
    "end": 237.744,
    "duration": 6.16
  },
  {
    "id": 59,
    "text": "--",
    "start": 237.744,
    "end": 237.824,
    "duration": 0.08
  }
]