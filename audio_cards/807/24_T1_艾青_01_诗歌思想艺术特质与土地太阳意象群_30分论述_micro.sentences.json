[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "“双意象 + 一诗体”三足稳立：1.以“土地+大堰河”立下深沉忧郁的苦难母爱根基；",
    "start": 0.223,
    "end": 8.117,
    "duration": 7.894
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "2.以“太阳+火把+黎明通知”高扬炽烈抗战救亡希望；",
    "start": 8.907,
    "end": 13.794,
    "duration": 4.887
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "3.以打破整齐格律的自由诗“散文美”引领新诗走向大众时代。",
    "start": 14.571,
    "end": 19.841,
    "duration": 5.27
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "三十年代危亡抗战时期，",
    "start": 20.556,
    "end": 22.796,
    "duration": 2.24
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "艾青《大堰河——我的保姆》《北方》《我爱这土地》开辟现实与时代交融新境，",
    "start": 23.505,
    "end": 29.455,
    "duration": 5.95
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "将深沉忧郁与民族抗争融于一体。",
    "start": 30.199,
    "end": 33.167,
    "duration": 2.968
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · “土地”与“大堰河”底色：挚爱劳苦大众",
    "start": 33.907,
    "end": 37.32,
    "duration": 3.413
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "成名作追忆用乳汁养己却死于四元棺材束草的农村保姆，刻画忍辱慈爱劳动妇女形象；",
    "start": 38.062,
    "end": 45.61,
    "duration": 7.548
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《雪落在中国的土地上》叹“寒冷在封锁着中国呀”；",
    "start": 46.363,
    "end": 49.932,
    "duration": 3.569
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《我爱这土地》化嘶哑飞鸟呼号“为什么我的眼里常含泪水？因为我对这土地爱得深沉”。",
    "start": 50.741,
    "end": 57.373,
    "duration": 6.632
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · “太阳”与“火把”象征：高扬救亡与理想",
    "start": 58.08,
    "end": 61.685,
    "duration": 3.604
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "赋予“太阳”驱散幽暗、冲破枷锁与迎民族新生的时代意蕴；",
    "start": 62.528,
    "end": 67.111,
    "duration": 4.582
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《向太阳》迎烈日奔跑礼赞光明；",
    "start": 67.839,
    "end": 70.481,
    "duration": 2.642
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "《火把》借唐尼夜间火炬游行显献身意志；",
    "start": 71.284,
    "end": 74.502,
    "duration": 3.218
  },
  {
    "id": "sec1_step1_c2",
    "dom_key": "sec1_step1_c2",
    "text": "延安《黎明的通知》化为迎接新世界的明朗呼告。",
    "start": 75.189,
    "end": 78.596,
    "duration": 3.407
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 破格律与欧化、创立自由诗“散文美”",
    "start": 79.383,
    "end": 83.26,
    "duration": 3.877
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "反思新月派齐整雕琢，倡自由诗追求“散文美”与天然律动，",
    "start": 84.072,
    "end": 89.011,
    "duration": 4.938
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "不拘押韵字数而用排比递进、长短交错与复沓造沉郁内在节奏；",
    "start": 89.795,
    "end": 95.336,
    "duration": 5.541
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《雪落》反复咏叹流离、《北方》冷暖色彩立体造型，质朴阔大推向大众。",
    "start": 96.055,
    "end": 101.796,
    "duration": 5.742
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "艾青以“土地与太阳”双重意象塑造现代中国坚韧精神图腾，",
    "start": 102.58,
    "end": 107.602,
    "duration": 5.022
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "以散文美引导新诗回归泥土与人民，立扎根现实重要传统。",
    "start": 108.381,
    "end": 113.592,
    "duration": 5.212
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：艾青三大核心概念：①土地/大堰河（深沉忧郁母爱） ②太阳/火把/黎明的通知（光明救亡） ③诗歌的“散文美”（对抗新月派整齐格律与早期欧化）。",
    "start": 114.414,
    "end": 129.456,
    "duration": 15.042
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 梳理艾青三大关键词：“土地与大堰河 / 太阳与火把 / 诗歌的散文美”？",
    "start": 130.272,
    "end": 137.482,
    "duration": 7.21
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 举全五首核心代表诗篇及每篇对应的主题或修辞特色？",
    "start": 138.263,
    "end": 144.43,
    "duration": 6.166
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2023 年论述《艾青诗歌的特点》时，怎样组织三段做到既有例证又条理分明？",
    "start": 145.162,
    "end": 153.579,
    "duration": 8.417
  }
]