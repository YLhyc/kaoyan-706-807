[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "鲁迅·杂文艺术特质与思想内涵",
    "start": 0.134,
    "end": 3.154,
    "duration": 3.02
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "媒介体裁→逆向思维→典型共名→语言诗性四层递进：依托报刊做到随物赋形“无体即有体”，",
    "start": 3.73,
    "end": 12.869,
    "duration": 9.14
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "思维核心是“正面文章反面看”解剖伪善，写法是“由个入类”概括出叭儿狗/二丑社会共名，",
    "start": 13.196,
    "end": 20.678,
    "duration": 7.482
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后落脚到主观诗性与庄谐反规范语言。",
    "start": 20.874,
    "end": 24.571,
    "duration": 3.697
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "鲁迅杂文依托现代报刊将闲话杂感重构为搏斗思想利刃，打破义理考据辞章分界，",
    "start": 25.158,
    "end": 32.956,
    "duration": 7.798
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "坚守“立人”理想，铸就兼具战斗性与诗性的自由文体典范。",
    "start": 33.153,
    "end": 38.516,
    "duration": 5.364
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · “无体即有体”、报刊即时介入现实",
    "start": 39.103,
    "end": 42.761,
    "duration": 3.658
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "依托《新青年》《语丝》《申报·自由谈》，倡导无体即有体，随物赋形穿梭逻辑论证、叙事、抒情与历史考据；",
    "start": 43.335,
    "end": 54.441,
    "duration": 11.106
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "从早期《热风》至后期《准风月谈》，演变为现代中国活的“人史”。",
    "start": 55.028,
    "end": 61.147,
    "duration": 6.119
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · “立人”轴心与“正面文章反面看”多疑思维",
    "start": 61.72,
    "end": 65.769,
    "duration": 4.049
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "以现代启蒙“立人”为轴心，毫不含糊解剖礼教、等级专制与奴性人格；",
    "start": 66.356,
    "end": 73.217,
    "duration": 6.861
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "“正面文章反面看”：《论“他妈的”》由日常国骂揭门第血统荒谬，",
    "start": 73.804,
    "end": 79.259,
    "duration": 5.455
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "《小杂感》《魏晋风度》刺破正人君子与名士伪善外壳。",
    "start": 79.416,
    "end": 84.193,
    "duration": 4.778
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · “由个入类”典型化、创造社会类型共名",
    "start": 84.78,
    "end": 88.803,
    "duration": 4.022
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "抓日常个案甚至“一鼻、一嘴、一毛”置于数千年历史长河勘探，提炼普遍社会人格符号；",
    "start": 89.377,
    "end": 97.917,
    "duration": 8.541
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《论“费厄泼赖”应该缓行》提炼依附豪强“叭儿狗”，论战中塑造帮凶“二丑”与“带头羊”，获穿越历史生命力。",
    "start": 98.504,
    "end": 108.139,
    "duration": 9.634
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 深沉主观诗性与反规范拗体庄谐语言",
    "start": 108.713,
    "end": 112.995,
    "duration": 4.283
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "非冷漠政论：《记念刘和珍君》在“沉默与爆发”“写与不写”张力中回荡如交响乐；",
    "start": 113.582,
    "end": 121.199,
    "duration": 7.616
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "故意打破搭配造“有理的压迫”“跪着的造反”反规范拗体，复融典故俗语大词小用，成锋芒荒诞反讽风。",
    "start": 121.786,
    "end": 131.238,
    "duration": 9.452
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "鲁迅杂文将战斗社会功能与崇高文学品格融为一体，以自由形式开拓批判现实主义与主观抒情相统一的全新疆界。",
    "start": 131.825,
    "end": 142.449,
    "duration": 10.624
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅杂文依托《新青年》《语丝》《申报·自由谈》生长；",
    "start": 143.036,
    "end": 148.607,
    "duration": 5.572
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "代表类型共名记“叭儿狗”“二丑”“带头羊”；",
    "start": 148.882,
    "end": 152.956,
    "duration": 4.074
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "语言特征记“反规范拗体”与“庄谐杂糅”。",
    "start": 153.283,
    "end": 156.329,
    "duration": 3.046
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出鲁迅杂文生根的三大报刊阵地与体现其超越时效的三个“类型共名”？",
    "start": 156.916,
    "end": 164.219,
    "duration": 7.304
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 阐明“无体即有体”“正面文章反面看”“由个入类”三大核心概念？",
    "start": 164.806,
    "end": 171.576,
    "duration": 6.77
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 结合《记念刘和珍君》和“跪着的造反”谈清其“诗性+拗体反讽”语言风格？",
    "start": 172.163,
    "end": 179.493,
    "duration": 7.33
  }
]