[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "媒介体裁→逆向思维→典型共名→语言诗性四层递进：依托报刊做到随物赋形“无体即有体”，",
    "start": 0.226,
    "end": 8.913,
    "duration": 8.686
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "思维核心是“正面文章反面看”解剖伪善，",
    "start": 9.666,
    "end": 13.247,
    "duration": 3.581
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "写法是“由个入类”概括出叭儿狗/二丑社会共名，",
    "start": 14.031,
    "end": 18.26,
    "duration": 4.229
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后落脚到主观诗性与庄谐反规范语言。",
    "start": 19.009,
    "end": 22.486,
    "duration": 3.477
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "鲁迅杂文依托现代报刊将闲话杂感重构为搏斗思想利刃，打破义理考据辞章分界，",
    "start": 23.245,
    "end": 30.802,
    "duration": 7.557
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "坚守“立人”理想，铸就兼具战斗性与诗性的自由文体典范。",
    "start": 31.541,
    "end": 36.328,
    "duration": 4.787
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · “无体即有体”、报刊即时介入现实",
    "start": 37.069,
    "end": 40.549,
    "duration": 3.48
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "依托《新青年》《语丝》《申报·自由谈》，倡导无体即有体，",
    "start": 41.271,
    "end": 45.879,
    "duration": 4.608
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "随物赋形穿梭逻辑论证、叙事、抒情与历史考据；",
    "start": 46.634,
    "end": 50.985,
    "duration": 4.351
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "从早期《热风》至后期《准风月谈》，演变为现代中国活的“人史”。",
    "start": 51.685,
    "end": 56.538,
    "duration": 4.853
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · “立人”轴心与“正面文章反面看”多疑思维",
    "start": 57.243,
    "end": 61.033,
    "duration": 3.791
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "以现代启蒙“立人”为轴心，毫不含糊解剖礼教、等级专制与奴性人格；",
    "start": 61.78,
    "end": 67.734,
    "duration": 5.954
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "“正面文章反面看”：《论“他妈的”》由日常国骂揭门第血统荒谬，",
    "start": 68.494,
    "end": 73.102,
    "duration": 4.608
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "《小杂感》《魏晋风度》刺破正人君子与名士伪善外壳。",
    "start": 73.841,
    "end": 78.316,
    "duration": 4.474
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · “由个入类”典型化、创造社会类型共名",
    "start": 79.056,
    "end": 82.973,
    "duration": 3.917
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "抓日常个案甚至“一鼻、一嘴、一毛”置于数千年历史长河勘探，提炼普遍社会人格符号；",
    "start": 83.726,
    "end": 91.671,
    "duration": 7.945
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《论“费厄泼赖”应该缓行》提炼依附豪强“叭儿狗”，",
    "start": 92.441,
    "end": 95.869,
    "duration": 3.427
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "论战中塑造帮凶“二丑”与“带头羊”，获穿越历史生命力。",
    "start": 96.664,
    "end": 101.095,
    "duration": 4.431
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 深沉主观诗性与反规范拗体庄谐语言",
    "start": 101.834,
    "end": 105.942,
    "duration": 4.108
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "非冷漠政论：《记念刘和珍君》在“沉默与爆发”“写与不写”张力中回荡如交响乐；",
    "start": 106.74,
    "end": 113.25,
    "duration": 6.511
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "故意打破搭配造“有理的压迫”“跪着的造反”反规范拗体，复融典故俗语大词小用，",
    "start": 114.048,
    "end": 120.351,
    "duration": 6.303
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "成锋芒荒诞反讽风。",
    "start": 121.082,
    "end": 122.831,
    "duration": 1.749
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "鲁迅杂文将战斗社会功能与崇高文学品格融为一体，",
    "start": 123.572,
    "end": 127.839,
    "duration": 4.267
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "以自由形式开拓批判现实主义与主观抒情相统一的全新疆界。",
    "start": 128.562,
    "end": 134.143,
    "duration": 5.581
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅杂文依托《新青年》《语丝》《申报·自由谈》生长；",
    "start": 134.934,
    "end": 140.093,
    "duration": 5.159
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "代表类型共名记“叭儿狗”“二丑”“带头羊”；",
    "start": 140.917,
    "end": 144.578,
    "duration": 3.661
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "语言特征记“反规范拗体”与“庄谐杂糅”。",
    "start": 145.308,
    "end": 148.232,
    "duration": 2.924
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出鲁迅杂文生根的三大报刊阵地与体现其超越时效的三个“类型共名”？",
    "start": 149.011,
    "end": 156.042,
    "duration": 7.031
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 阐明“无体即有体”“正面文章反面看”“由个入类”三大核心概念？",
    "start": 156.782,
    "end": 163.411,
    "duration": 6.629
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 结合《记念刘和珍君》和“跪着的造反”谈清其“诗性+拗体反讽”语言风格？",
    "start": 164.149,
    "end": 171.427,
    "duration": 7.277
  }
]