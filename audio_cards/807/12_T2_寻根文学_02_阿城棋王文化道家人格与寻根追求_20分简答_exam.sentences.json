[
  {
    "id": 1,
    "text": "阿城发表于一九八四年的《棋王》，",
    "start": 0.08,
    "end": 2.48,
    "duration": 2.4
  },
  {
    "id": 2,
    "text": "是寻根文学的开山名作。",
    "start": 2.48,
    "end": 4.72,
    "duration": 2.24
  },
  {
    "id": 3,
    "text": "小说塑造的“棋呆子”王一生，是中国当代文学中极具中国传统文化底蕴的平民智者形象。",
    "start": 4.72,
    "end": 12.64,
    "duration": 7.92
  },
  {
    "id": 4,
    "text": "其形象特质与寻根追求主要体现在三个层面。",
    "start": 12.64,
    "end": 16.48,
    "duration": 3.84
  },
  {
    "id": 5,
    "text": "第一，极度专注世俗生存与物质自足。",
    "start": 16.48,
    "end": 19.92,
    "duration": 3.44
  },
  {
    "id": 6,
    "text": "王一生对“吃”抱有一种虔诚而专注的态度。",
    "start": 20.24,
    "end": 23.76,
    "duration": 3.52
  },
  {
    "id": 7,
    "text": "无论生活多么贫寒困顿，他对待每一粒米、",
    "start": 23.76,
    "end": 27.28,
    "duration": 3.52
  },
  {
    "id": 8,
    "text": "每一滴油都充满了近乎宗教般的敬畏。",
    "start": 27.28,
    "end": 30.56,
    "duration": 3.28
  },
  {
    "id": 9,
    "text": "这种对基本生存物质的执着，并非市快贪婪。",
    "start": 30.56,
    "end": 34.56,
    "duration": 4.0
  },
  {
    "id": 10,
    "text": "它体现了中国传统底层百姓对生命存在最本真的热爱与珍惜。",
    "start": 34.56,
    "end": 39.68,
    "duration": 5.12
  },
  {
    "id": 11,
    "text": "物质上的极低物欲与容易知足，为他的精神自足提供了坚实基础。",
    "start": 40.0,
    "end": 45.36,
    "duration": 5.36
  },
  {
    "id": 12,
    "text": "第二，棋道通禅的虚静境界与精神超脱。",
    "start": 45.36,
    "end": 49.04,
    "duration": 3.68
  },
  {
    "id": 13,
    "text": "王一生将象棋升华为安身立命的超越空间。",
    "start": 49.04,
    "end": 52.8,
    "duration": 3.76
  },
  {
    "id": 14,
    "text": "他从检破烂的老人处习得道家棋理。",
    "start": 52.8,
    "end": 55.92,
    "duration": 3.12
  },
  {
    "id": 15,
    "text": "他遵循“为棋不为生”与“阴阳相济”的哲学智慧。",
    "start": 55.92,
    "end": 59.68,
    "duration": 3.76
  },
  {
    "id": 16,
    "text": "面对知青动荡乱世的政治喧嚣与物质匮乏，",
    "start": 59.92,
    "end": 63.76,
    "duration": 3.84
  },
  {
    "id": 17,
    "text": "他完全退回内在的棋艺世界。",
    "start": 63.76,
    "end": 66.4,
    "duration": 2.64
  },
  {
    "id": 18,
    "text": "在车轮大战盲棋对决九人的高潮中，",
    "start": 66.4,
    "end": 69.36,
    "duration": 2.96
  },
  {
    "id": 19,
    "text": "他静穆如铁，神游物外。",
    "start": 69.36,
    "end": 71.76,
    "duration": 2.4
  },
  {
    "id": 20,
    "text": "他展现出物我两忘、以静制动的崇高精神境界。",
    "start": 71.76,
    "end": 76.16,
    "duration": 4.4
  },
  {
    "id": 21,
    "text": "第三，在传统儒道互补中安顿个体生命。",
    "start": 76.16,
    "end": 79.68,
    "duration": 3.52
  },
  {
    "id": 22,
    "text": "王一生身上体现了阿城对中华传统文明生命智慧的深情寻根。",
    "start": 79.68,
    "end": 84.56,
    "duration": 4.88
  },
  {
    "id": 23,
    "text": "面对狂暴的时代动乱，王一生既没有激进反抗，",
    "start": 84.88,
    "end": 88.88,
    "duration": 4.0
  },
  {
    "id": 24,
    "text": "也没有绝望沉沦。",
    "start": 88.88,
    "end": 90.48,
    "duration": 1.6
  },
  {
    "id": 25,
    "text": "他借助道家的虚静无为抵御精神异化，",
    "start": 90.48,
    "end": 93.92,
    "duration": 3.44
  },
  {
    "id": 26,
    "text": "又依托民间的朴素人伦保持生命温情。",
    "start": 93.92,
    "end": 97.6,
    "duration": 3.68
  },
  {
    "id": 27,
    "text": "作家借助王一生证明，中国古老的文化传统依然蕴藏着能够让现代人安身立命的巨大精神定力。",
    "start": 97.6,
    "end": 105.6,
    "duration": 8.0
  },
  {
    "id": 28,
    "text": "阿城通过王一生将凡俗烟火与古典道家精神熔于一炉，",
    "start": 105.76,
    "end": 111.04,
    "duration": 5.28
  },
  {
    "id": 29,
    "text": "完成了从政治苦难反思向东方生命哲学寻根的成功超越。--",
    "start": 111.04,
    "end": 116.0,
    "duration": 4.96
  }
]