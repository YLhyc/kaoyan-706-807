[
  {
    "id": 1,
    "text": "题目：简析文学研究会与创造社在文学主张与创作倾向上的异同。。",
    "start": 0.098,
    "end": 5.974,
    "duration": 5.876
  },
  {
    "id": 2,
    "text": "文学研究会与创造社是中国现代新文学初期成立最早、",
    "start": 6.154,
    "end": 10.751,
    "duration": 4.597
  },
  {
    "id": 3,
    "text": "影响最大的两大标志性文学社团。",
    "start": 10.904,
    "end": 13.686,
    "duration": 2.782
  },
  {
    "id": 4,
    "text": "二者同源于五四新文化运动的思想启蒙浪潮，",
    "start": 13.807,
    "end": 17.309,
    "duration": 3.502
  },
  {
    "id": 5,
    "text": "共同向封建旧文学发起猛攻，但在文学主张、",
    "start": 17.376,
    "end": 20.793,
    "duration": 3.417
  },
  {
    "id": 6,
    "text": "创作方法与主体心境上呈现出鲜明的同源分流与双峰对峙格局。",
    "start": 20.993,
    "end": 26.43,
    "duration": 5.437
  },
  {
    "id": 7,
    "text": "其比较主要体现在以下三个核心维度：",
    "start": 26.659,
    "end": 29.312,
    "duration": 2.653
  },
  {
    "id": 8,
    "text": "第一，在文学观念与社会功能上，",
    "start": 29.693,
    "end": 32.314,
    "duration": 2.621
  },
  {
    "id": 9,
    "text": "呈现“为人生”的启蒙功利与“为艺术”的审美自足的对峙。",
    "start": 32.512,
    "end": 37.047,
    "duration": 4.535
  },
  {
    "id": 10,
    "text": "文学研究会以《小说月报》为阵地，",
    "start": 37.298,
    "end": 39.614,
    "duration": 2.316
  },
  {
    "id": 11,
    "text": "高扬“为人生而艺术”的大旗，",
    "start": 39.89,
    "end": 42.059,
    "duration": 2.169
  },
  {
    "id": 12,
    "text": "坚决反对鸳鸯蝴蝶派将文学视为游戏消遣的市侩观念，",
    "start": 42.087,
    "end": 46.67,
    "duration": 4.583
  },
  {
    "id": 13,
    "text": "主张文学应当直面社会现实，",
    "start": 46.716,
    "end": 48.958,
    "duration": 2.242
  },
  {
    "id": 14,
    "text": "成为研究人生与暴露社会病态的工具；",
    "start": 49.002,
    "end": 51.872,
    "duration": 2.87
  },
  {
    "id": 15,
    "text": "创造社则高举“为艺术而艺术”的旗帜，",
    "start": 52.101,
    "end": 55.232,
    "duration": 3.131
  },
  {
    "id": 16,
    "text": "推崇文学是内在情感的要求，强调直觉、灵感与主观自我表现，",
    "start": 55.652,
    "end": 61.152,
    "duration": 5.5
  },
  {
    "id": 17,
    "text": "追求审美个性的纯粹与精神绝对自由。",
    "start": 61.753,
    "end": 64.922,
    "duration": 3.169
  },
  {
    "id": 18,
    "text": "第二，在创作方法与审美风格上，",
    "start": 65.44,
    "end": 67.994,
    "duration": 2.554
  },
  {
    "id": 19,
    "text": "开辟了现实主义写实与浪漫主义主观喷涌的两大航道。",
    "start": 68.103,
    "end": 72.408,
    "duration": 4.305
  },
  {
    "id": 20,
    "text": "文学研究会恪守写实原则，",
    "start": 72.582,
    "end": 74.802,
    "duration": 2.22
  },
  {
    "id": 21,
    "text": "主张冷静客观地摹写底层疾苦与市民社会的灰色生活，",
    "start": 75.051,
    "end": 79.591,
    "duration": 4.54
  },
  {
    "id": 22,
    "text": "如叶圣陶《潘先生在难中》精准解剖小市民苟且偷生的妥协心理；",
    "start": 79.902,
    "end": 85.306,
    "duration": 5.404
  },
  {
    "id": 23,
    "text": "创造社则信奉浪漫主义与表现主义，拒绝客观拘束而直抒胸臆，",
    "start": 85.41,
    "end": 90.627,
    "duration": 5.217
  },
  {
    "id": 24,
    "text": "长于描写惊世骇俗的病态心理与反叛激情，",
    "start": 90.922,
    "end": 94.427,
    "duration": 3.505
  },
  {
    "id": 25,
    "text": "如郭沫若《女神》的火山爆发与郁达夫《沉沦》中灵肉撕裂的自叙传倾诉。",
    "start": 94.66,
    "end": 99.879,
    "duration": 5.219
  },
  {
    "id": 26,
    "text": "第三，在历史渊源与后期演进上，",
    "start": 100.103,
    "end": 102.943,
    "duration": 2.84
  },
  {
    "id": 27,
    "text": "分别承接了五四启蒙精神的社会理性与感性反叛。",
    "start": 103.236,
    "end": 107.222,
    "duration": 3.986
  },
  {
    "id": 28,
    "text": "文学研究会立足国内现实，",
    "start": 107.643,
    "end": 109.697,
    "duration": 2.054
  },
  {
    "id": 29,
    "text": "承接了启蒙运动中沉稳的社会批判理性，",
    "start": 109.902,
    "end": 113.252,
    "duration": 3.35
  },
  {
    "id": 30,
    "text": "后期创作持续深化现实主义道路；",
    "start": 113.44,
    "end": 116.199,
    "duration": 2.759
  },
  {
    "id": 31,
    "text": "创造社崛起于留日青年身处异邦的屈辱与青春苦闷，",
    "start": 116.504,
    "end": 121.265,
    "duration": 4.761
  },
  {
    "id": 32,
    "text": "承接了个性解放的极致热力，",
    "start": 121.654,
    "end": 123.852,
    "duration": 2.198
  },
  {
    "id": 33,
    "text": "在大革命浪潮中率先提出“革命文学”口号，",
    "start": 124.148,
    "end": 127.563,
    "duration": 3.415
  },
  {
    "id": 34,
    "text": "迅速完成了向无产阶级阶级论的激进跃迁。",
    "start": 127.89,
    "end": 131.329,
    "duration": 3.439
  },
  {
    "id": 35,
    "text": "综上所述，两大社团各执一端而又相辅相成。",
    "start": 131.542,
    "end": 135.34,
    "duration": 3.798
  },
  {
    "id": 36,
    "text": "他们以双峰对峙的多元探索，",
    "start": 135.948,
    "end": 137.961,
    "duration": 2.013
  },
  {
    "id": 37,
    "text": "共同奠定了中国现代新文学现实主义与浪漫主义交相辉映的壮阔基石。",
    "start": 138.252,
    "end": 144.216,
    "duration": 5.964
  }
]
