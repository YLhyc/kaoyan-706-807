[
  {
    "id": 1,
    "text": "一、全题宏观破题与总揽。",
    "start": 0.0,
    "end": 2.248,
    "duration": 2.248
  },
  {
    "id": 2,
    "text": "一、这一问到底在考什么？",
    "start": 2.248,
    "end": 4.496,
    "duration": 2.248
  },
  {
    "id": 3,
    "text": "本题考查文学研究会与创造社在文学观念、",
    "start": 4.496,
    "end": 8.542,
    "duration": 4.046
  },
  {
    "id": 4,
    "text": "创作方法、处境渊源与演进方向上的全方位比较。",
    "start": 8.542,
    "end": 13.038,
    "duration": 4.496
  },
  {
    "id": 5,
    "text": "考生必须准确答出二者“同源分流”的历史本质，",
    "start": 13.038,
    "end": 17.31,
    "duration": 4.272
  },
  {
    "id": 6,
    "text": "讲透“为人生”与“为艺术”、“现实主义”与“浪漫主义”的内在差异。",
    "start": 17.31,
    "end": 22.48,
    "duration": 5.17
  },
  {
    "id": 7,
    "text": "二、答题的总方向是什么？",
    "start": 22.64,
    "end": 24.96,
    "duration": 2.32
  },
  {
    "id": 8,
    "text": "紧扣钱理群教材第一章关于社团蜂起与朱栋霖教材的论述。",
    "start": 24.96,
    "end": 29.92,
    "duration": 4.96
  },
  {
    "id": 9,
    "text": "切忌将二者对立为敌对派别，必须明确二者共同敌人是封建渊蝶旧文学，",
    "start": 29.92,
    "end": 35.92,
    "duration": 6.0
  },
  {
    "id": 10,
    "text": "是在五四启蒙大旗下的双峰对峙。",
    "start": 35.92,
    "end": 38.72,
    "duration": 2.8
  },
  {
    "id": 11,
    "text": "三、分几个板块展开？",
    "start": 38.72,
    "end": 40.48,
    "duration": 1.76
  },
  {
    "id": 12,
    "text": "简答题分三大板块依次推进：第一板块：文学观念比较（为人生改良社会versus为艺术自我表现）。",
    "start": 40.48,
    "end": 48.64,
    "duration": 8.16
  },
  {
    "id": 13,
    "text": "第二板块：创作方法比较（现实主义客观写实versus浪漫主义主观抒情）。",
    "start": 48.64,
    "end": 54.4,
    "duration": 5.76
  },
  {
    "id": 14,
    "text": "第三板块：处境渊源与演进（国内文人社会批判versus海外留日青春反叛与后期革命转向）。",
    "start": 54.4,
    "end": 62.0,
    "duration": 7.6
  },
  {
    "id": 15,
    "text": "四、全篇内在逻辑链条是什么？",
    "start": 62.32,
    "end": 65.04,
    "duration": 2.72
  },
  {
    "id": 16,
    "text": "由两大社团同源分流破题，趋近于，",
    "start": 65.04,
    "end": 68.72,
    "duration": 3.68
  },
  {
    "id": 17,
    "text": "剖析核心文学观念分野，理念之别，",
    "start": 68.72,
    "end": 71.84,
    "duration": 3.12
  },
  {
    "id": 18,
    "text": "趋近于，深入具体创作手法与代表作品印证，",
    "start": 71.84,
    "end": 76.0,
    "duration": 4.16
  },
  {
    "id": 19,
    "text": "技法之别，趋近于，溯源其历史处境与启蒙承接倾向，",
    "start": 76.0,
    "end": 81.12,
    "duration": 5.12
  },
  {
    "id": 20,
    "text": "精神之别，趋近于，升华至合力推动新文学繁荣的辩证定论。",
    "start": 81.12,
    "end": 86.16,
    "duration": 5.04
  },
  {
    "id": 21,
    "text": "层次井然。",
    "start": 86.56,
    "end": 88.08,
    "duration": 1.52
  },
  {
    "id": 22,
    "text": "--。二",
    "start": 88.08,
    "end": 88.32,
    "duration": 0.24
  },
  {
    "id": 23,
    "text": "、各板块逐句咬合推演。",
    "start": 88.64,
    "end": 90.72,
    "duration": 2.08
  },
  {
    "id": 24,
    "text": "（一）宏观定性与破题总起板块。",
    "start": 90.72,
    "end": 93.68,
    "duration": 2.96
  },
  {
    "id": 25,
    "text": "破题推演逻辑：开头直接界定两大社团在文学史上的首创地位。",
    "start": 93.68,
    "end": 98.88,
    "duration": 5.2
  },
  {
    "id": 26,
    "text": "说明其同源于五四启蒙的大背景，指出其共同反封建旧文学的根本一致性，",
    "start": 98.88,
    "end": 105.28,
    "duration": 6.4
  },
  {
    "id": 27,
    "text": "引出二者同源分流的双峰对峙格局。",
    "start": 105.28,
    "end": 108.4,
    "duration": 3.12
  },
  {
    "id": 28,
    "text": "-逐句咬合推导：具体表述到答题语句就是：文学研究会与创造社是中国现代新文学初期成立最早、",
    "start": 108.56,
    "end": 116.696,
    "duration": 8.136
  },
  {
    "id": 29,
    "text": "影响最大的两大标志性文学社团。，",
    "start": 116.696,
    "end": 119.543,
    "duration": 2.847
  },
  {
    "id": 30,
    "text": "这是对考察对象的历史地位定性。",
    "start": 119.543,
    "end": 122.391,
    "duration": 2.848
  },
  {
    "id": 31,
    "text": "紧接着指出其思想动力的同源性，具体表述到答题语句就是：二者同源于五四思想启蒙浪潮，",
    "start": 122.391,
    "end": 130.119,
    "duration": 7.728
  },
  {
    "id": 32,
    "text": "共同向封建旧文学发起猛攻。",
    "start": 130.119,
    "end": 132.56,
    "duration": 2.441
  },
  {
    "id": 33,
    "text": "随后亮出全题比较的核心辩证结论，",
    "start": 132.784,
    "end": 135.824,
    "duration": 3.04
  },
  {
    "id": 34,
    "text": "具体表述到答题语句就是：但在文学主张、",
    "start": 135.824,
    "end": 139.424,
    "duration": 3.6
  },
  {
    "id": 35,
    "text": "创作方法与精神底色上，呈现出鲜明的同源分流与双峰对峙格局。",
    "start": 139.424,
    "end": 145.344,
    "duration": 5.92
  },
  {
    "id": 36,
    "text": "文学研究会与创造社是中国现代新文学初期成立最早、",
    "start": 145.584,
    "end": 150.544,
    "duration": 4.96
  },
  {
    "id": 37,
    "text": "影响最大的两大标志性文学社团。",
    "start": 150.544,
    "end": 153.424,
    "duration": 2.88
  },
  {
    "id": 38,
    "text": "二者同源于五四思想启蒙浪潮，共同向封建旧文学发起猛攻。",
    "start": 153.744,
    "end": 158.704,
    "duration": 4.96
  },
  {
    "id": 39,
    "text": "但在文学主张、创作方法与精神底色上，",
    "start": 158.704,
    "end": 161.904,
    "duration": 3.2
  },
  {
    "id": 40,
    "text": "呈现出鲜明的同源分流与双峰对峙格局。",
    "start": 161.904,
    "end": 165.504,
    "duration": 3.6
  },
  {
    "id": 41,
    "text": "--。（二",
    "start": 165.504,
    "end": 165.664,
    "duration": 0.16
  },
  {
    "id": 42,
    "text": "）第一板块：文学观念与社会功能比较。",
    "start": 165.984,
    "end": 169.024,
    "duration": 3.04
  },
  {
    "id": 43,
    "text": "论证推演逻辑：观念是流派之旗。",
    "start": 169.024,
    "end": 171.664,
    "duration": 2.64
  },
  {
    "id": 44,
    "text": "首先展开文研会：高扬“为人生”，",
    "start": 172.064,
    "end": 174.944,
    "duration": 2.88
  },
  {
    "id": 45,
    "text": "反对游戏消遣，将文学作为干预现实人生的工具，",
    "start": 174.944,
    "end": 178.944,
    "duration": 4.0
  },
  {
    "id": 46,
    "text": "接着对举创造社：高扬“为艺术”，",
    "start": 178.944,
    "end": 181.824,
    "duration": 2.88
  },
  {
    "id": 47,
    "text": "强调自我表现、灵感与直觉，追求主观内心的纯粹。",
    "start": 181.824,
    "end": 186.064,
    "duration": 4.24
  },
  {
    "id": 48,
    "text": "对比鲜明。",
    "start": 186.064,
    "end": 187.024,
    "duration": 0.96
  },
  {
    "id": 49,
    "text": "逐句咬合推导：具体表述到答题语句就是：首先，",
    "start": 187.024,
    "end": 190.704,
    "duration": 3.68
  },
  {
    "id": 50,
    "text": "在文学观念与社会功能上，二者确立了截然不同的价值取向。，",
    "start": 190.704,
    "end": 194.784,
    "duration": 4.08
  },
  {
    "id": 51,
    "text": "这是第一分论点的核心观点立桩。",
    "start": 194.784,
    "end": 196.864,
    "duration": 2.08
  },
  {
    "id": 52,
    "text": "紧接着剖析文学研究会的“为人生”旗帜，",
    "start": 197.184,
    "end": 200.464,
    "duration": 3.28
  },
  {
    "id": 53,
    "text": "具体表述到答题语句就是：文学研究会高扬“为人生”的启蒙功利主张。",
    "start": 200.464,
    "end": 205.984,
    "duration": 5.52
  },
  {
    "id": 54,
    "text": "随后指出其批判锋芒所指，具体表述到答题语句就是：他们坚决反对渊秧蝴蝶派将文学视为游戏消遣的市快观念，",
    "start": 205.984,
    "end": 215.384,
    "duration": 9.4
  },
  {
    "id": 55,
    "text": "主张文学应当干预现实生活，成为研究社会人生的工具。",
    "start": 215.384,
    "end": 219.984,
    "duration": 4.6
  },
  {
    "id": 56,
    "text": "紧接着剖析创造社的“为艺术”旗帜，",
    "start": 220.064,
    "end": 222.944,
    "duration": 2.88
  },
  {
    "id": 57,
    "text": "具体表述到答题语句就是：创造社则高扬“为艺术”的审美独立旗帜。",
    "start": 222.944,
    "end": 228.368,
    "duration": 5.424
  },
  {
    "id": 58,
    "text": "随后展开创造社追求的核心内涵，具体表述到答题语句就是：他们强调文学是内在情感的要求，",
    "start": 228.368,
    "end": 236.331,
    "duration": 7.963
  },
  {
    "id": 59,
    "text": "推崇直觉、灵感与自我表现，主张文学应当追求内心的纯粹与主观审美的极致。",
    "start": 236.331,
    "end": 242.864,
    "duration": 6.533
  },
  {
    "id": 60,
    "text": "首先，在文学观念与社会功能上，二者确立了截然不同的价值取向。",
    "start": 243.024,
    "end": 248.784,
    "duration": 5.76
  },
  {
    "id": 61,
    "text": "文学研究会高扬“为人生”的启蒙功利主张。",
    "start": 248.784,
    "end": 252.704,
    "duration": 3.92
  },
  {
    "id": 62,
    "text": "他们坚决反对渊秧蝴蝶派将文学视为游戏消遣的市快观念，",
    "start": 252.704,
    "end": 258.384,
    "duration": 5.68
  },
  {
    "id": 63,
    "text": "主张文学应当干预现实生活，成为研究社会人生的工具。",
    "start": 258.384,
    "end": 262.784,
    "duration": 4.4
  },
  {
    "id": 64,
    "text": "创造社则高扬“为艺术”的审美独立旗帜。",
    "start": 263.104,
    "end": 266.784,
    "duration": 3.68
  },
  {
    "id": 65,
    "text": "他们强调文学是内在情感的要求，推崇直觉、",
    "start": 266.784,
    "end": 270.864,
    "duration": 4.08
  },
  {
    "id": 66,
    "text": "灵感与自我表现，主张文学应当追求内心的纯粹与主观审美的极致。--",
    "start": 270.864,
    "end": 276.544,
    "duration": 5.68
  },
  {
    "id": 67,
    "text": "（三）第二板块：创作方法与审美风范比较。",
    "start": 276.768,
    "end": 280.365,
    "duration": 3.597
  },
  {
    "id": 68,
    "text": "论证推演逻辑：观念落实为方法。",
    "start": 280.365,
    "end": 283.287,
    "duration": 2.922
  },
  {
    "id": 69,
    "text": "文研会开辟现实主义大路，讲求客观观察与社会暴露，",
    "start": 283.287,
    "end": 288.233,
    "duration": 4.946
  },
  {
    "id": 70,
    "text": "举叶圣陶《潘先生在难中》，创造社开辟浪漫主义与表现主义道路，",
    "start": 288.233,
    "end": 294.078,
    "duration": 5.845
  },
  {
    "id": 71,
    "text": "讲求主观爆发与心理倾泻，举郭沫若《女神》与郁达夫《沉沦》。",
    "start": 294.078,
    "end": 299.248,
    "duration": 5.17
  },
  {
    "id": 72,
    "text": "-逐句咬合推导：具体表述到答题语句就是：其次，",
    "start": 299.248,
    "end": 303.197,
    "duration": 3.949
  },
  {
    "id": 73,
    "text": "在创作方法与审美风范上，二者分别开辟了现实主义与浪漫主义的宏阔航道。，",
    "start": 303.197,
    "end": 309.848,
    "duration": 6.651
  },
  {
    "id": 74,
    "text": "这是第二分论点的观点立桩。",
    "start": 309.848,
    "end": 312.343,
    "duration": 2.495
  },
  {
    "id": 75,
    "text": "紧接着阐释文研会的写实原则与代表作，",
    "start": 312.343,
    "end": 315.876,
    "duration": 3.533
  },
  {
    "id": 76,
    "text": "具体表述到答题语句就是：文学研究会遵循现实主义的写实原则。",
    "start": 315.876,
    "end": 321.488,
    "duration": 5.612
  },
  {
    "id": 77,
    "text": "随后展开其客观冷静的解剖方式与例证，",
    "start": 321.648,
    "end": 325.168,
    "duration": 3.52
  },
  {
    "id": 78,
    "text": "具体表述到答题语句就是：他们主张深入现实进行实地观察与冷静摹写，",
    "start": 325.168,
    "end": 331.319,
    "duration": 6.151
  },
  {
    "id": 79,
    "text": "以客观笔法揭露底层疾苦与市民灰色生活，",
    "start": 331.319,
    "end": 335.046,
    "duration": 3.727
  },
  {
    "id": 80,
    "text": "代表作如叶圣陶的《潘先生在难中》。",
    "start": 335.046,
    "end": 337.944,
    "duration": 2.898
  },
  {
    "id": 81,
    "text": "紧接着阐释创造社的浪漫主义原则，",
    "start": 337.944,
    "end": 341.05,
    "duration": 3.106
  },
  {
    "id": 82,
    "text": "具体表述到答题语句就是：创造社则信奉浪漫主义与表现主义法则。",
    "start": 341.05,
    "end": 346.848,
    "duration": 5.798
  },
  {
    "id": 83,
    "text": "随后展开其主观抒情与标志性作品，",
    "start": 347.008,
    "end": 350.208,
    "duration": 3.2
  },
  {
    "id": 84,
    "text": "具体表述到答题语句就是：他们拒绝冷静客观的拘束，",
    "start": 350.208,
    "end": 354.928,
    "duration": 4.72
  },
  {
    "id": 85,
    "text": "主张直抒胸臆与个性张扬，长于描写惊世骇俗的病态心理与叛逆激情，",
    "start": 354.928,
    "end": 361.648,
    "duration": 6.72
  },
  {
    "id": 86,
    "text": "代表作如郭沫若的《女神》与郁达夫的《沉沦》。",
    "start": 361.648,
    "end": 365.328,
    "duration": 3.68
  },
  {
    "id": 87,
    "text": "其次，在创作方法与审美风范上，二者分别开辟了现实主义与浪漫主义的宏阔航道。",
    "start": 365.328,
    "end": 372.288,
    "duration": 6.96
  },
  {
    "id": 88,
    "text": "文学研究会遵循现实主义的写实原则。",
    "start": 372.528,
    "end": 375.648,
    "duration": 3.12
  },
  {
    "id": 89,
    "text": "他们主张深入现实进行实地观察与冷静摹写，",
    "start": 375.648,
    "end": 379.648,
    "duration": 4.0
  },
  {
    "id": 90,
    "text": "以客观笔法揭露底层疾苦与市民灰色生活，",
    "start": 379.648,
    "end": 383.568,
    "duration": 3.92
  },
  {
    "id": 91,
    "text": "代表作如叶圣陶的《潘先生在难中》。",
    "start": 383.568,
    "end": 386.688,
    "duration": 3.12
  },
  {
    "id": 92,
    "text": "创造社则信奉浪漫主义与表现主义法则。",
    "start": 386.688,
    "end": 389.888,
    "duration": 3.2
  },
  {
    "id": 93,
    "text": "他们拒绝冷静客观的拘束，主张直抒胸臆与个性张扬，",
    "start": 389.888,
    "end": 394.368,
    "duration": 4.48
  },
  {
    "id": 94,
    "text": "长于描写惊世骇俗的病态心理与叛逆激情，",
    "start": 394.368,
    "end": 398.048,
    "duration": 3.68
  },
  {
    "id": 95,
    "text": "代表作如郭沫若的《女神》与郁达夫的《沉沦》。",
    "start": 398.048,
    "end": 401.088,
    "duration": 3.04
  },
  {
    "id": 96,
    "text": "（四）第三板块：处境渊源与历史演进比较。",
    "start": 401.328,
    "end": 404.696,
    "duration": 3.368
  },
  {
    "id": 97,
    "text": "论证推演逻辑：深化理解两社团的生成机制。",
    "start": 404.696,
    "end": 408.486,
    "duration": 3.79
  },
  {
    "id": 98,
    "text": "文研会立足国内，承接五四思想启蒙中的社会批判理性，",
    "start": 408.486,
    "end": 413.328,
    "duration": 4.842
  },
  {
    "id": 99,
    "text": "走深化写实之路，创造社生于海外异邦弱国屈辱，",
    "start": 413.328,
    "end": 417.539,
    "duration": 4.211
  },
  {
    "id": 100,
    "text": "承接个性解放与反叛激情，大革命后率先倡导革命文学。",
    "start": 417.539,
    "end": 422.381,
    "duration": 4.842
  },
  {
    "id": 101,
    "text": "两者承接了五四启蒙的不同侧翼。",
    "start": 422.381,
    "end": 425.328,
    "duration": 2.947
  },
  {
    "id": 102,
    "text": "-逐句咬合推导：具体表述到答题语句就是：最后，",
    "start": 425.376,
    "end": 429.292,
    "duration": 3.916
  },
  {
    "id": 103,
    "text": "在处境渊源与历史演进上，二者承接了五四启蒙精神的不同侧翼。，",
    "start": 429.292,
    "end": 434.856,
    "duration": 5.564
  },
  {
    "id": 104,
    "text": "这是第三分论点的提纲窃领。",
    "start": 434.856,
    "end": 437.329,
    "duration": 2.473
  },
  {
    "id": 105,
    "text": "紧接着剖析文研会的国内语境与演进，",
    "start": 437.329,
    "end": 440.626,
    "duration": 3.297
  },
  {
    "id": 106,
    "text": "具体表述到答题语句就是：文学研究会立足国内文化语境，",
    "start": 440.626,
    "end": 445.572,
    "duration": 4.946
  },
  {
    "id": 107,
    "text": "承接了启蒙思潮中的社会批判理性，",
    "start": 445.572,
    "end": 448.663,
    "duration": 3.091
  },
  {
    "id": 108,
    "text": "后期创作持续深化写实道路。",
    "start": 448.663,
    "end": 451.136,
    "duration": 2.473
  },
  {
    "id": 109,
    "text": "随后剖析创造社的海外心理与革命转向，",
    "start": 451.296,
    "end": 454.576,
    "duration": 3.28
  },
  {
    "id": 110,
    "text": "具体表述到答题语句就是：创造社崛起于留日青年的异邦屈辱与青春苦闷，",
    "start": 454.576,
    "end": 460.736,
    "duration": 6.16
  },
  {
    "id": 111,
    "text": "承接了个性解放与反抗激情的感性热力，",
    "start": 460.736,
    "end": 463.856,
    "duration": 3.12
  },
  {
    "id": 112,
    "text": "在大革命浪潮中率先转向无产阶级革命文学。",
    "start": 463.856,
    "end": 467.536,
    "duration": 3.68
  },
  {
    "id": 113,
    "text": "最后，在处境渊源与历史演进上，二者承接了五四启蒙精神的不同侧翼。",
    "start": 467.536,
    "end": 473.536,
    "duration": 6.0
  },
  {
    "id": 114,
    "text": "文学研究会立足国内文化语境，承接了启蒙思潮中的社会批判理性，",
    "start": 473.776,
    "end": 479.056,
    "duration": 5.28
  },
  {
    "id": 115,
    "text": "后期创作持续深化写实道路。",
    "start": 479.056,
    "end": 481.296,
    "duration": 2.24
  },
  {
    "id": 116,
    "text": "创造社崛起于留日青年的异邦屈辱与青春苦闷，",
    "start": 481.296,
    "end": 485.136,
    "duration": 3.84
  },
  {
    "id": 117,
    "text": "承接了个性解放与反抗激情的感性热力，",
    "start": 485.136,
    "end": 488.096,
    "duration": 2.96
  },
  {
    "id": 118,
    "text": "在大革命浪潮中率先转向无产阶级革命文学。",
    "start": 488.096,
    "end": 491.616,
    "duration": 3.52
  },
  {
    "id": 119,
    "text": "（五）总结升华板块。",
    "start": 491.856,
    "end": 493.392,
    "duration": 1.536
  },
  {
    "id": 120,
    "text": "收口推演逻辑：简短有力的总结收束。",
    "start": 493.392,
    "end": 496.685,
    "duration": 3.293
  },
  {
    "id": 121,
    "text": "重申两大社团互为补充、双峰对峙的巨大历史贡献。",
    "start": 496.685,
    "end": 501.294,
    "duration": 4.609
  },
  {
    "id": 122,
    "text": "逐句咬合推导：具体表述到答题语句就是：综上所述，",
    "start": 501.294,
    "end": 505.903,
    "duration": 4.609
  },
  {
    "id": 123,
    "text": "两大社团各执一端而又互为补充。",
    "start": 505.903,
    "end": 508.976,
    "duration": 3.073
  },
  {
    "id": 124,
    "text": "最后以一句话完成全篇总结，具体表述到答题语句就是：他们以双峰对峙的多元探索，",
    "start": 509.056,
    "end": 515.589,
    "duration": 6.533
  },
  {
    "id": 125,
    "text": "共同奠定了中国现代新文学的壮阔基石。",
    "start": 515.589,
    "end": 518.933,
    "duration": 3.344
  },
  {
    "id": 126,
    "text": "综上所述，两大社团各执一端而又互为补充。",
    "start": 518.933,
    "end": 522.473,
    "duration": 3.54
  },
  {
    "id": 127,
    "text": "他们以双峰对峙的多元探索，共同奠定了中国现代新文学的壮阔基石。",
    "start": 522.473,
    "end": 528.176,
    "duration": 5.703
  }
]