[
  {
    "id": 1,
    "text": "八十年代中期，面对反思文学的局限与西方现代主义思潮的冲击，中国当代文坛兴起了以“寻根”为旗帜的文学思潮。",
    "start": 0.113,
    "end": 9.715,
    "duration": 9.602
  },
  {
    "id": 2,
    "text": "作家们主张跳出单一的政治社会学批评框架，向民族历史文化心理探求精神资源，",
    "start": 10.325,
    "end": 17.149,
    "duration": 6.824
  },
  {
    "id": 3,
    "text": "其思潮特征与审美追求主要体现于以下三个方面：",
    "start": 17.499,
    "end": 21.549,
    "duration": 4.05
  },
  {
    "id": 4,
    "text": "第一，发表理论宣言，确立向民族传统文化“寻根”的创作自觉。",
    "start": 22.177,
    "end": 27.047,
    "duration": 4.87
  },
  {
    "id": 5,
    "text": "韩少功发表《文学的“根”》，明确提出“文学有根，文学之根应深植于民族传统文化的土壤里”，",
    "start": 27.547,
    "end": 34.475,
    "duration": 6.928
  },
  {
    "id": 6,
    "text": "呼唤作家从楚辞的浪漫奇诡、道家的清虚自守与地域原生民俗中汲取养分，",
    "start": 34.825,
    "end": 41.106,
    "duration": 6.281
  },
  {
    "id": 7,
    "text": "推动当代文学由外部社会批判转向内在民族文化心理的开掘。",
    "start": 41.456,
    "end": 46.698,
    "duration": 5.242
  },
  {
    "id": 8,
    "text": "第二，发掘传统儒道人格精神，重建文化自尊与理想品格。",
    "start": 47.349,
    "end": 52.373,
    "duration": 5.024
  },
  {
    "id": 9,
    "text": "寻根作家力图在现代转型带来的精神迷失中，重拾传统文化的美好品格。",
    "start": 52.873,
    "end": 58.522,
    "duration": 5.649
  },
  {
    "id": 10,
    "text": "阿城在《棋王》中以古朴洗练的笔调塑造了“棋呆子”王一生；",
    "start": 59.022,
    "end": 63.596,
    "duration": 4.574
  },
  {
    "id": 11,
    "text": "他在动荡的知青岁月中将“吃饱”视作踏实的生存底线，",
    "start": 64.096,
    "end": 68.325,
    "duration": 4.229
  },
  {
    "id": 12,
    "text": "在车轮大战中以一敌九下盲棋，连胜八人后与老棋手言和，",
    "start": 68.675,
    "end": 73.722,
    "duration": 5.047
  },
  {
    "id": 13,
    "text": "其淡泊自守、超然自尊的人格境界，体现出传统道家文化在当代生活中的精神延续。",
    "start": 74.085,
    "end": 80.997,
    "duration": 6.912
  },
  {
    "id": 14,
    "text": "第三，融合现代主义象征与地域民俗风情，拓展当代小说的文体边界。",
    "start": 81.607,
    "end": 87.609,
    "duration": 6.002
  },
  {
    "id": 15,
    "text": "寻根文学告别了传统现实主义的单线叙事，",
    "start": 88.109,
    "end": 91.169,
    "duration": 3.06
  },
  {
    "id": 16,
    "text": "吸收拉美魔幻现实主义与现代象征手法，呈现鲜明的地域文化风貌。",
    "start": 91.519,
    "end": 96.926,
    "duration": 5.407
  },
  {
    "id": 17,
    "text": "李杭育的“葛川江系列”展现吴越水乡的野性生命力，",
    "start": 97.426,
    "end": 101.619,
    "duration": 4.193
  },
  {
    "id": 18,
    "text": "贾平凹的“商州系列”勾勒秦岭山地的古老风俗人情，",
    "start": 101.969,
    "end": 106.039,
    "duration": 4.07
  },
  {
    "id": 19,
    "text": "莫言早期作品亦借齐鲁乡土传奇彰显生命活力，",
    "start": 106.389,
    "end": 110.709,
    "duration": 4.32
  },
  {
    "id": 20,
    "text": "在传统与现代、神话与写实的交融中拓宽了当代小说的艺术表现力。",
    "start": 111.059,
    "end": 116.519,
    "duration": 5.46
  }
]
