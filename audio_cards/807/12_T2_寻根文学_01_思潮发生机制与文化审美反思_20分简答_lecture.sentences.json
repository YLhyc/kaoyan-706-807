[
  {
    "id": 1,
    "text": "八十年代中期，",
    "start": 0.08,
    "end": 1.44,
    "duration": 1.36
  },
  {
    "id": 2,
    "text": "面对反思文学的政治局限与西方现代主义思潮的强烈冲击，",
    "start": 1.44,
    "end": 6.64,
    "duration": 5.2
  },
  {
    "id": 3,
    "text": "中国当代文坛爆发了以“寻根”为旗帜的文学思潮。",
    "start": 6.64,
    "end": 11.28,
    "duration": 4.64
  },
  {
    "id": 4,
    "text": "作家们主张跳出狭隘的政治社会学批评，",
    "start": 11.28,
    "end": 14.8,
    "duration": 3.52
  },
  {
    "id": 5,
    "text": "向民族深层历史文化结构掘进，",
    "start": 14.8,
    "end": 17.6,
    "duration": 2.8
  },
  {
    "id": 6,
    "text": "其思潮特征与文化审美反思主要体现于以下三个方面：",
    "start": 17.6,
    "end": 22.48,
    "duration": 4.88
  },
  {
    "id": 7,
    "text": "第一，发表理论自觉宣言，",
    "start": 22.48,
    "end": 25.28,
    "duration": 2.8
  },
  {
    "id": 8,
    "text": "确立向民族传统文化深层“寻根”的文体自觉。",
    "start": 25.28,
    "end": 29.92,
    "duration": 4.64
  },
  {
    "id": 9,
    "text": "韩少功发表《文学的“根”》，明确提出“文学有根，",
    "start": 30.16,
    "end": 34.96,
    "duration": 4.8
  },
  {
    "id": 10,
    "text": "文学之根应深植于民族传统文化的土壤里”，",
    "start": 34.96,
    "end": 38.72,
    "duration": 3.76
  },
  {
    "id": 11,
    "text": "呼唤作家从楚辞的巫傩浪漫、",
    "start": 38.72,
    "end": 41.28,
    "duration": 2.56
  },
  {
    "id": 12,
    "text": "道家的清虚宁静与地域原生民俗中汲取生命养分，",
    "start": 41.44,
    "end": 45.84,
    "duration": 4.4
  },
  {
    "id": 13,
    "text": "标志着当代文学由外部社会批判向内在民族文化心理结构探寻的历史深化。",
    "start": 45.84,
    "end": 52.88,
    "duration": 7.04
  },
  {
    "id": 14,
    "text": "第二，发掘传统儒道人格精髓，重塑超然宁静的理想精神境界。",
    "start": 52.88,
    "end": 58.8,
    "duration": 5.92
  },
  {
    "id": 15,
    "text": "寻根作家力图在礼崩乐坏的现代文明废墟上，",
    "start": 58.8,
    "end": 62.88,
    "duration": 4.08
  },
  {
    "id": 16,
    "text": "重建中国传统文化的美好品格。",
    "start": 62.88,
    "end": 65.76,
    "duration": 2.88
  },
  {
    "id": 17,
    "text": "阿城在《棋王》中以古朴洗练的世说新语体笔调，",
    "start": 65.76,
    "end": 70.24,
    "duration": 4.48
  },
  {
    "id": 18,
    "text": "塑造了“棋呆子”王一生这一典型形象；",
    "start": 70.4,
    "end": 73.68,
    "duration": 3.28
  },
  {
    "id": 19,
    "text": "王一生在动荡年月的大迁徙中，",
    "start": 73.68,
    "end": 77.12,
    "duration": 3.44
  },
  {
    "id": 20,
    "text": "将“吃饱”视作最踏实的生存底线，",
    "start": 77.12,
    "end": 80.4,
    "duration": 3.28
  },
  {
    "id": 21,
    "text": "在九张棋局的围攻中以盲棋力挫天下豪杰，其超然物外、",
    "start": 80.4,
    "end": 86.08,
    "duration": 5.68
  },
  {
    "id": 22,
    "text": "大智若愚的人格境界，",
    "start": 86.16,
    "end": 88.32,
    "duration": 2.16
  },
  {
    "id": 23,
    "text": "生动体现了传统道家文化重返现世的宁静与自尊。",
    "start": 88.32,
    "end": 92.32,
    "duration": 4.0
  },
  {
    "id": 24,
    "text": "第三，熔铸现代主义象征与地域民俗风情，",
    "start": 92.32,
    "end": 95.92,
    "duration": 3.6
  },
  {
    "id": 25,
    "text": "拓展中国当代小说的文体边界。",
    "start": 95.92,
    "end": 98.96,
    "duration": 3.04
  },
  {
    "id": 26,
    "text": "寻根文学告别了传统现实主义线性叙事，",
    "start": 98.96,
    "end": 102.4,
    "duration": 3.44
  },
  {
    "id": 27,
    "text": "大量融入拉美魔幻现实主义与东方玄思。",
    "start": 102.4,
    "end": 105.84,
    "duration": 3.44
  },
  {
    "id": 28,
    "text": "李杭育的“葛川江系列”深挖吴越蛮荒的野性蛮力，",
    "start": 105.84,
    "end": 110.64,
    "duration": 4.8
  },
  {
    "id": 29,
    "text": "贾平凹的“商州系列”展现秦岭古老闭塞中的风俗人情，",
    "start": 110.64,
    "end": 113.68,
    "duration": 3.04
  },
  {
    "id": 30,
    "text": "莫言早期作品亦融入齐鲁红高粱传奇，在古老与现代、",
    "start": 113.52,
    "end": 113.68,
    "duration": 0.16
  },
  {
    "id": 31,
    "text": "神话与纪实的碰撞中，极大丰富了当代文学的艺术表现力。",
    "start": 113.52,
    "end": 113.68,
    "duration": 0.16
  }
]