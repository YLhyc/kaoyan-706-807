[
  {
    "id": 1,
    "text": "现当代核心文论与叙事学概念速配卡。",
    "start": 0.16,
    "end": 3.47,
    "duration": 3.31
  },
  {
    "id": 2,
    "text": "本卡专攻“用中外文论阐释经典作品”新型论述题与六十分文学评论写作，",
    "start": 3.704,
    "end": 10.057,
    "duration": 6.353
  },
  {
    "id": 3,
    "text": "精选八组高频理论工具，每条按“精准定义加现当代名篇套用示范”编排。",
    "start": 10.207,
    "end": 16.113,
    "duration": 5.906
  },
  {
    "id": 4,
    "text": "一、以意逆志： 孟子《万章上》提出“不以文害辞，不以辞害志。以意逆志，是为得之”，",
    "start": 16.731,
    "end": 23.628,
    "duration": 6.897
  },
  {
    "id": 5,
    "text": "主张读者以己之心意迎候体会作者诗心之志，反对拘泥个别字句。",
    "start": 23.83,
    "end": 30.617,
    "duration": 6.787
  },
  {
    "id": 6,
    "text": "套用示范：以此阐释《阿Q正传》，不能局限于阿Q偷萝卜或画圆圈等表层滑稽举止，",
    "start": 30.661,
    "end": 38.662,
    "duration": 8.001
  },
  {
    "id": 7,
    "text": "而须以同情与忧患之心逆推鲁迅“哀其不幸，怒其不争”及剖析国民精神胜利法的深切救世之志。",
    "start": 38.901,
    "end": 47.132,
    "duration": 8.231
  },
  {
    "id": 8,
    "text": "二、知人论世：孟子提出的阅读批评方法，强调理解作品实质不能孤立就文论文，",
    "start": 47.745,
    "end": 54.657,
    "duration": 6.912
  },
  {
    "id": 9,
    "text": "必须结合创作者的身世生平、思想立场与具体时代社会背景。",
    "start": 54.989,
    "end": 59.835,
    "duration": 4.846
  },
  {
    "id": 10,
    "text": "套用示范：解读《狂人日记》与鲁迅杂文时，",
    "start": 60.059,
    "end": 63.578,
    "duration": 3.519
  },
  {
    "id": 11,
    "text": "须联系辛亥革命流产后新文化运动反礼教的时代潮汐及鲁迅“呐喊”启蒙心境，",
    "start": 63.831,
    "end": 70.303,
    "duration": 6.472
  },
  {
    "id": 12,
    "text": "方能辨明狂人呼号“吃人”背后的历史沉重。",
    "start": 70.545,
    "end": 74.019,
    "duration": 3.474
  },
  {
    "id": 13,
    "text": "三、意图谬误（意图谬见）：英美新批评维姆萨特与比尔兹利提出，",
    "start": 74.594,
    "end": 79.782,
    "duration": 5.188
  },
  {
    "id": 14,
    "text": "批评把诗误作产生过程、以作者主观创作意图取代文本自身意义的做法，",
    "start": 79.895,
    "end": 85.445,
    "duration": 5.55
  },
  {
    "id": 15,
    "text": "主张文本一旦诞生即独立自足。",
    "start": 85.602,
    "end": 88.004,
    "duration": 2.402
  },
  {
    "id": 16,
    "text": "套用示范：以此重审《阿Q正传》，",
    "start": 88.126,
    "end": 90.307,
    "duration": 2.181
  },
  {
    "id": 17,
    "text": "“精神胜利法”与末章“大团圆”讽刺结构所蕴含的普世人性弱点与荒诞悲剧意味，",
    "start": 90.487,
    "end": 96.336,
    "duration": 5.849
  },
  {
    "id": 18,
    "text": "远超鲁迅最初设想的局部讽刺，意义由文本自身持续生发。",
    "start": 96.621,
    "end": 101.103,
    "duration": 4.482
  },
  {
    "id": 19,
    "text": "四、感受谬误（感受谬见）：维姆萨特与比尔兹利针对印象式批评提出，",
    "start": 101.695,
    "end": 107.677,
    "duration": 5.982
  },
  {
    "id": 20,
    "text": "反对把作品本身混同于读者变动不居的临时情绪反应，主张批评须回到文本具体肌质结构。",
    "start": 107.824,
    "end": 115.431,
    "duration": 7.607
  },
  {
    "id": 21,
    "text": "套用示范：写作文学评论分析《雷雨》或陌生短篇时，",
    "start": 115.67,
    "end": 119.908,
    "duration": 4.238
  },
  {
    "id": 22,
    "text": "忌停留在“令人感动或悲凉”等空泛印象，",
    "start": 120.098,
    "end": 123.299,
    "duration": 3.201
  },
  {
    "id": 23,
    "text": "而须扣住雷雨夜封闭门窗意象、因果巧合与人物语言碰撞析出悲剧张力。",
    "start": 123.564,
    "end": 129.976,
    "duration": 6.412
  },
  {
    "id": 24,
    "text": "五、陌生化：俄国形式主义什克洛夫斯基提出，指通过语言扭曲、视角移位打破日常“自动化”感知，延长感受难度以唤醒鲜活审美体验。",
    "start": 130.64,
    "end": 142.122,
    "duration": 11.482
  },
  {
    "id": 25,
    "text": "套用示范：《狂人日记》借受迫害狂的荒诞错觉把常见长幼礼教“陌生化”为满本“吃人”，带来震撼警醒；",
    "start": 142.466,
    "end": 150.893,
    "duration": 8.427
  },
  {
    "id": 26,
    "text": "《孔乙己》以十二岁咸亨小伙计的冷漠童眼叙事，亦是以旁观冷峻制造强烈的陌生化悲感。",
    "start": 151.057,
    "end": 158.404,
    "duration": 7.347
  },
  {
    "id": 27,
    "text": "六、反讽：新批评布鲁克斯定义为“语境对于一个陈述语的明显的歪曲”，即字面所言与深层所指背离，借语境张力令文本产生含蓄锋芒。",
    "start": 159.017,
    "end": 172.064,
    "duration": 13.047
  },
  {
    "id": 28,
    "text": "套用示范：《阿Q正传》以“大团圆”为末章标题，字面沿用传统团圆套路，",
    "start": 172.684,
    "end": 179.005,
    "duration": 6.321
  },
  {
    "id": 29,
    "text": "实写阿Q糊涂入狱游街被枪毙，形成悲喜倒错的辛辣反讽；",
    "start": 179.548,
    "end": 184.306,
    "duration": 4.758
  },
  {
    "id": 30,
    "text": "张爱玲《金锁记》亦常以世俗算计语调反衬人性畸变。",
    "start": 185.008,
    "end": 189.423,
    "duration": 4.415
  },
  {
    "id": 31,
    "text": "七、叙述视角（聚焦）：叙事学核心范畴，",
    "start": 190.099,
    "end": 193.413,
    "duration": 3.314
  },
  {
    "id": 32,
    "text": "区分超越时空的“全知（零聚焦）视角”与依托特定人物眼光感知的“有限（内或外聚焦）视角”。",
    "start": 193.636,
    "end": 200.619,
    "duration": 6.983
  },
  {
    "id": 33,
    "text": "套用示范：《祝福》采取返乡知识分子“我”的第一人称有限视角观察祥林嫂惨死，",
    "start": 200.82,
    "end": 206.65,
    "duration": 5.83
  },
  {
    "id": 34,
    "text": "既留出审视礼教吃人的客观间距，又暴露知识者在“灵魂有无”拷问面前的精神软弱与无力。",
    "start": 206.905,
    "end": 214.128,
    "duration": 7.223
  },
  {
    "id": 35,
    "text": "八、张力与悖论：退特提出“张力”指词语字面外延与联想内涵的协调统一；",
    "start": 214.809,
    "end": 221.354,
    "duration": 6.545
  },
  {
    "id": 36,
    "text": "布鲁克斯指“悖论”是表面矛盾组合中蕴蓄深层真理的诗性语言机制。",
    "start": 221.583,
    "end": 227.288,
    "duration": 5.705
  },
  {
    "id": 37,
    "text": "套用示范：分析艾青名句“为什么我的眼里常含泪水，因为我对这土地爱得深沉”，",
    "start": 227.493,
    "end": 233.797,
    "duration": 6.304
  },
  {
    "id": 38,
    "text": "或穆旦《赞美》中民族血火创痛与坚韧生的希望并存，",
    "start": 234.096,
    "end": 238.296,
    "duration": 4.2
  },
  {
    "id": 39,
    "text": "正是伤痛与至爱对撞生成的崇高诗学张力。",
    "start": 238.792,
    "end": 242.454,
    "duration": 3.662
  }
]