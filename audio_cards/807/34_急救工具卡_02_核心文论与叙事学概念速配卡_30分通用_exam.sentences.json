[
  {
    "id": 1,
    "text": "现当代核心文论与叙事学概念速配卡。",
    "start": 0.16,
    "end": 3.47,
    "duration": 3.31
  },
  {
    "id": 2,
    "text": "本卡专攻“用中外文论阐释经典作品”新型论述题与六十分文学评论写作，",
    "start": 3.97,
    "end": 10.323,
    "duration": 6.353
  },
  {
    "id": 3,
    "text": "精选八组高频理论工具，每条按“精准定义加现当代名篇套用示范”编排。",
    "start": 10.673,
    "end": 16.579,
    "duration": 5.906
  },
  {
    "id": 4,
    "text": "一、以意逆志： 孟子《万章上》提出“不以文害辞，不以辞害志。以意逆志，是为得之”，",
    "start": 17.197,
    "end": 24.094,
    "duration": 6.897
  },
  {
    "id": 5,
    "text": "主张读者以己之心意迎候体会作者诗心之志，反对拘泥个别字句。",
    "start": 24.444,
    "end": 31.22,
    "duration": 6.776
  },
  {
    "id": 6,
    "text": "套用示范：以此阐释《阿Q正传》，不能局限于阿Q偷萝卜或画圆圈等表层滑稽举止，",
    "start": 31.72,
    "end": 39.717,
    "duration": 7.997
  },
  {
    "id": 7,
    "text": "而须以同情与忧患之心逆推鲁迅“画出这样沉默的国民的魂灵来”及揭示国民精神胜利法的深切救世之志。",
    "start": 40.067,
    "end": 49.273,
    "duration": 9.206
  },
  {
    "id": 8,
    "text": "二、知人论世：孟子提出的阅读批评方法，强调理解作品实质不能孤立就文论文，",
    "start": 49.995,
    "end": 56.907,
    "duration": 6.912
  },
  {
    "id": 9,
    "text": "必须结合创作者的身世生平、思想立场与具体时代社会背景。",
    "start": 57.257,
    "end": 62.103,
    "duration": 4.846
  },
  {
    "id": 10,
    "text": "套用示范：解读《狂人日记》与鲁迅杂文时，须联系辛亥革命流产后新文化运动反礼教的时代潮汐及鲁迅“呐喊”启蒙心境，",
    "start": 62.603,
    "end": 72.847,
    "duration": 10.244
  },
  {
    "id": 11,
    "text": "方能辨明狂人呼号“吃人”背后的历史沉重。",
    "start": 73.197,
    "end": 76.654,
    "duration": 3.457
  },
  {
    "id": 12,
    "text": "三、意图谬误（意图谬见）：英美新批评维姆萨特与比尔兹利提出，",
    "start": 77.246,
    "end": 82.439,
    "duration": 5.193
  },
  {
    "id": 13,
    "text": "批评把诗误作产生过程、以作者主观创作意图取代文本自身意义的做法，",
    "start": 82.789,
    "end": 88.359,
    "duration": 5.57
  },
  {
    "id": 14,
    "text": "主张文本一旦诞生即独立自足。",
    "start": 88.709,
    "end": 91.111,
    "duration": 2.402
  },
  {
    "id": 15,
    "text": "套用示范：以此重审《阿Q正传》，“精神胜利法”与末章“大团圆”讽刺结构所蕴含的普世人性弱点与荒诞悲剧意味，",
    "start": 91.611,
    "end": 99.821,
    "duration": 8.21
  },
  {
    "id": 16,
    "text": "远超鲁迅最初设想的局部讽刺，意义由文本自身持续生发。",
    "start": 100.171,
    "end": 104.653,
    "duration": 4.482
  },
  {
    "id": 17,
    "text": "四、感受谬误（感受谬见）：维姆萨特与比尔兹利针对印象式批评提出，",
    "start": 105.245,
    "end": 111.227,
    "duration": 5.982
  },
  {
    "id": 18,
    "text": "反对把作品本身混同于读者变动不居的临时情绪反应，主张批评须回到文本具体肌质结构。",
    "start": 111.577,
    "end": 119.184,
    "duration": 7.607
  },
  {
    "id": 19,
    "text": "套用示范：写作文学评论分析《雷雨》或陌生短篇时，忌停留在“令人感动或悲凉”等空泛印象，",
    "start": 119.684,
    "end": 127.3,
    "duration": 7.616
  },
  {
    "id": 20,
    "text": "而须扣住雷雨夜封闭门窗意象、因果巧合与人物语言碰撞析出悲剧张力。",
    "start": 127.65,
    "end": 134.062,
    "duration": 6.412
  },
  {
    "id": 21,
    "text": "五、陌生化：俄国形式主义什克洛夫斯基提出，指通过语言扭曲、视角移位打破日常“自动化”感知，延长感受难度以唤醒鲜活审美体验。",
    "start": 134.726,
    "end": 146.208,
    "duration": 11.482
  },
  {
    "id": 22,
    "text": "套用示范：《狂人日记》借受迫害狂的荒诞错觉把常见长幼礼教“陌生化”为满本“吃人”，带来震撼警醒；",
    "start": 146.708,
    "end": 155.135,
    "duration": 8.427
  },
  {
    "id": 23,
    "text": "《孔乙己》以十二岁咸亨小伙计的冷漠童眼叙事，亦是以旁观冷峻制造强烈的陌生化悲感。",
    "start": 155.635,
    "end": 162.982,
    "duration": 7.347
  },
  {
    "id": 24,
    "text": "六、反讽：新批评布鲁克斯定义为“语境对于一个陈述语的明显的歪曲”，即字面所言与深层所指背离，借语境张力令文本产生含蓄锋芒。",
    "start": 163.595,
    "end": 176.642,
    "duration": 13.047
  },
  {
    "id": 25,
    "text": "套用示范：《阿Q正传》以“大团圆”为末章标题，字面沿用传统团圆套路，",
    "start": 177.262,
    "end": 183.583,
    "duration": 6.321
  },
  {
    "id": 26,
    "text": "实写阿Q糊涂入狱游街被枪毙，形成悲喜倒错的辛辣反讽；",
    "start": 184.126,
    "end": 188.884,
    "duration": 4.758
  },
  {
    "id": 27,
    "text": "张爱玲《金锁记》亦常以世俗算计语调反衬人性畸变。",
    "start": 189.586,
    "end": 194.001,
    "duration": 4.415
  },
  {
    "id": 28,
    "text": "七、叙述视角（聚焦）：叙事学核心范畴，",
    "start": 194.677,
    "end": 197.991,
    "duration": 3.314
  },
  {
    "id": 29,
    "text": "区分超越时空的“全知（零聚焦）视角”与依托特定人物眼光感知的“有限（内或外聚焦）视角”。",
    "start": 198.341,
    "end": 205.324,
    "duration": 6.983
  },
  {
    "id": 30,
    "text": "套用示范：《祝福》采取返乡知识分子“我”的第一人称有限视角观察祥林嫂惨死，",
    "start": 205.824,
    "end": 211.654,
    "duration": 5.83
  },
  {
    "id": 31,
    "text": "既留出审视礼教吃人的客观间距，又暴露知识者在“灵魂有无”拷问面前的精神软弱与无力。",
    "start": 212.004,
    "end": 219.227,
    "duration": 7.223
  },
  {
    "id": 32,
    "text": "八、张力与悖论：退特提出“张力”指词语字面外延与联想内涵的协调统一；",
    "start": 219.908,
    "end": 226.453,
    "duration": 6.545
  },
  {
    "id": 33,
    "text": "布鲁克斯指“悖论”是表面矛盾组合中蕴蓄深层真理的诗性语言机制。",
    "start": 226.953,
    "end": 232.658,
    "duration": 5.705
  },
  {
    "id": 34,
    "text": "套用示范：分析艾青名句“为什么我的眼里常含泪水，因为我对这土地爱得深沉”，",
    "start": 233.158,
    "end": 239.462,
    "duration": 6.304
  },
  {
    "id": 35,
    "text": "或穆旦《赞美》中民族血火创痛与坚韧生的希望并存，",
    "start": 239.812,
    "end": 244.012,
    "duration": 4.2
  },
  {
    "id": 36,
    "text": "正是伤痛与至爱对撞生成的崇高诗学张力。",
    "start": 244.508,
    "end": 248.17,
    "duration": 3.662
  }
]
