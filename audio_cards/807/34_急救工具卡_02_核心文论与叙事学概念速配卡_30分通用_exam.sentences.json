[
  {
    "id": 1,
    "text": "现当代核心文论与叙事学概念速配卡。",
    "start": 0.16,
    "end": 3.46,
    "duration": 3.3
  },
  {
    "id": 2,
    "text": "本卡专攻“用中外文论阐释经典作品”新型论述题与六十分文学评论写作，",
    "start": 3.704,
    "end": 10.047,
    "duration": 6.343
  },
  {
    "id": 3,
    "text": "精选八组高频理论工具，",
    "start": 10.207,
    "end": 12.033,
    "duration": 1.826
  },
  {
    "id": 4,
    "text": "每条按“精准定义加现当代名篇套用示范”编排。",
    "start": 12.247,
    "end": 16.103,
    "duration": 3.856
  },
  {
    "id": 5,
    "text": "一、以意逆志： 孟子《万章上》提出“不以文害辞，不以辞害志。",
    "start": 16.731,
    "end": 21.278,
    "duration": 4.547
  },
  {
    "id": 6,
    "text": "以意逆志，是为得之”，",
    "start": 21.549,
    "end": 23.618,
    "duration": 2.069
  },
  {
    "id": 7,
    "text": "主张读者以己之心意迎候体会作者诗心之志，",
    "start": 23.83,
    "end": 28.681,
    "duration": 4.851
  },
  {
    "id": 8,
    "text": "反对拘泥个别字句。",
    "start": 28.691,
    "end": 30.651,
    "duration": 1.96
  },
  {
    "id": 9,
    "text": "套用示范：以此阐释《阿Q正传》，",
    "start": 30.661,
    "end": 33.547,
    "duration": 2.886
  },
  {
    "id": 10,
    "text": "不能局限于阿Q偷萝卜或画圆圈等表层滑稽举止，",
    "start": 33.647,
    "end": 38.652,
    "duration": 5.005
  },
  {
    "id": 11,
    "text": "而须以同情与忧患之心逆推鲁迅“哀其不幸，",
    "start": 38.901,
    "end": 43.027,
    "duration": 4.126
  },
  {
    "id": 12,
    "text": "怒其不争”及剖析国民精神胜利法的深切救世之志。",
    "start": 43.286,
    "end": 47.122,
    "duration": 3.836
  },
  {
    "id": 13,
    "text": "二、知人论世：孟子提出的阅读批评方法，",
    "start": 47.745,
    "end": 51.367,
    "duration": 3.622
  },
  {
    "id": 14,
    "text": "强调理解作品实质不能孤立就文论文，",
    "start": 51.643,
    "end": 54.647,
    "duration": 3.004
  },
  {
    "id": 15,
    "text": "必须结合创作者的身世生平、思想立场与具体时代社会背景。",
    "start": 54.989,
    "end": 59.825,
    "duration": 4.836
  },
  {
    "id": 16,
    "text": "套用示范：解读《狂人日记》与鲁迅杂文时，",
    "start": 60.059,
    "end": 63.568,
    "duration": 3.509
  },
  {
    "id": 17,
    "text": "须联系辛亥革命流产后新文化运动反礼教的时代潮汐及鲁迅“呐喊”启蒙心境，",
    "start": 63.831,
    "end": 70.293,
    "duration": 6.462
  },
  {
    "id": 18,
    "text": "方能辨明狂人呼号“吃人”背后的历史沉重。",
    "start": 70.545,
    "end": 74.009,
    "duration": 3.464
  },
  {
    "id": 19,
    "text": "三、意图谬误（意图谬见）：",
    "start": 74.594,
    "end": 76.74,
    "duration": 2.146
  },
  {
    "id": 20,
    "text": "英美新批评维姆萨特与比尔兹利提出，批评把诗误作产生过程、",
    "start": 76.892,
    "end": 81.803,
    "duration": 4.911
  },
  {
    "id": 21,
    "text": "以作者主观创作意图取代文本自身意义的做法，",
    "start": 81.93,
    "end": 85.445,
    "duration": 3.515
  },
  {
    "id": 22,
    "text": "主张文本一旦诞生即独立自足。",
    "start": 85.602,
    "end": 87.994,
    "duration": 2.392
  },
  {
    "id": 23,
    "text": "套用示范：以此重审《阿Q正传》，",
    "start": 88.126,
    "end": 90.297,
    "duration": 2.171
  },
  {
    "id": 24,
    "text": "“精神胜利法”与末章“大团圆”讽刺结构所蕴含的普世人性弱点与荒诞悲剧意味，",
    "start": 90.487,
    "end": 96.326,
    "duration": 5.839
  },
  {
    "id": 25,
    "text": "远超鲁迅最初设想的局部讽刺，意义由文本自身持续生发。",
    "start": 96.621,
    "end": 101.093,
    "duration": 4.472
  },
  {
    "id": 26,
    "text": "四、感受谬误（感受谬见）：",
    "start": 101.695,
    "end": 103.967,
    "duration": 2.272
  },
  {
    "id": 27,
    "text": "维姆萨特与比尔兹利针对印象式批评提出，",
    "start": 104.184,
    "end": 107.668,
    "duration": 3.484
  },
  {
    "id": 28,
    "text": "反对把作品本身混同于读者变动不居的临时情绪反应，",
    "start": 107.824,
    "end": 112.374,
    "duration": 4.55
  },
  {
    "id": 29,
    "text": "主张批评须回到文本具体肌质结构。",
    "start": 112.589,
    "end": 115.422,
    "duration": 2.833
  },
  {
    "id": 30,
    "text": "套用示范：写作文学评论分析《雷雨》或陌生短篇时，",
    "start": 115.67,
    "end": 119.898,
    "duration": 4.228
  },
  {
    "id": 31,
    "text": "忌停留在“令人感动或悲凉”等空泛印象，",
    "start": 120.098,
    "end": 123.29,
    "duration": 3.192
  },
  {
    "id": 32,
    "text": "而须扣住雷雨夜封闭门窗意象、",
    "start": 123.564,
    "end": 126.289,
    "duration": 2.725
  },
  {
    "id": 33,
    "text": "因果巧合与人物语言碰撞析出悲剧张力。",
    "start": 126.809,
    "end": 129.966,
    "duration": 3.157
  },
  {
    "id": 34,
    "text": "五、陌生化：俄国形式主义什克洛夫斯基提出，",
    "start": 130.64,
    "end": 134.44,
    "duration": 3.8
  },
  {
    "id": 35,
    "text": "指通过语言扭曲、视角移位打破日常“自动化”感知，",
    "start": 134.834,
    "end": 138.856,
    "duration": 4.022
  },
  {
    "id": 36,
    "text": "延长感受难度以唤醒鲜活审美体验。",
    "start": 139.278,
    "end": 142.112,
    "duration": 2.834
  },
  {
    "id": 37,
    "text": "套用示范：",
    "start": 142.466,
    "end": 143.081,
    "duration": 0.615
  },
  {
    "id": 38,
    "text": "《狂人日记》借受迫害狂的荒诞错觉把常见长幼礼教“陌生化”为满本“吃人”，",
    "start": 143.334,
    "end": 149.399,
    "duration": 6.065
  },
  {
    "id": 39,
    "text": "带来震撼警醒；",
    "start": 149.685,
    "end": 150.883,
    "duration": 1.198
  },
  {
    "id": 40,
    "text": "《孔乙己》以十二岁咸亨小伙计的冷漠童眼叙事，",
    "start": 151.057,
    "end": 154.897,
    "duration": 3.84
  },
  {
    "id": 41,
    "text": "亦是以旁观冷峻制造强烈的陌生化悲感。",
    "start": 155.117,
    "end": 158.394,
    "duration": 3.277
  },
  {
    "id": 42,
    "text": "六、反讽：",
    "start": 159.017,
    "end": 160.128,
    "duration": 1.111
  },
  {
    "id": 43,
    "text": "新批评布鲁克斯定义为“语境对于一个陈述语的明显的歪曲”，",
    "start": 160.725,
    "end": 165.737,
    "duration": 5.012
  },
  {
    "id": 44,
    "text": "即字面所言与深层所指背离，借语境张力令文本产生含蓄锋芒。",
    "start": 166.232,
    "end": 172.075,
    "duration": 5.843
  },
  {
    "id": 45,
    "text": "套用示范：《阿Q正传》以“大团圆”为末章标题，",
    "start": 172.684,
    "end": 176.697,
    "duration": 4.013
  },
  {
    "id": 46,
    "text": "字面沿用传统团圆套路，实写阿Q糊涂入狱游街被枪毙，",
    "start": 177.002,
    "end": 181.982,
    "duration": 4.98
  },
  {
    "id": 47,
    "text": "形成悲喜倒错的辛辣反讽；",
    "start": 182.216,
    "end": 184.296,
    "duration": 2.08
  },
  {
    "id": 48,
    "text": "张爱玲《金锁记》亦常以世俗算计语调反衬人性畸变。",
    "start": 185.008,
    "end": 189.413,
    "duration": 4.405
  },
  {
    "id": 49,
    "text": "七、叙述视角（聚焦）：叙事学核心范畴，",
    "start": 190.099,
    "end": 193.403,
    "duration": 3.304
  },
  {
    "id": 50,
    "text": "区分超越时空的“全知（零聚焦）视角”与依托特定人物眼光感知的“有限（内或外聚焦）视角”。",
    "start": 193.636,
    "end": 200.609,
    "duration": 6.973
  },
  {
    "id": 51,
    "text": "套用示范：",
    "start": 200.82,
    "end": 201.499,
    "duration": 0.679
  },
  {
    "id": 52,
    "text": "《祝福》采取返乡知识分子“我”的第一人称有限视角观察祥林嫂惨死，",
    "start": 201.724,
    "end": 206.64,
    "duration": 4.916
  },
  {
    "id": 53,
    "text": "既留出审视礼教吃人的客观间距，",
    "start": 206.905,
    "end": 209.455,
    "duration": 2.55
  },
  {
    "id": 54,
    "text": "又暴露知识者在“灵魂有无”拷问面前的精神软弱与无力。",
    "start": 209.899,
    "end": 214.12,
    "duration": 4.221
  },
  {
    "id": 55,
    "text": "八、张力与悖论：",
    "start": 214.809,
    "end": 216.254,
    "duration": 1.445
  },
  {
    "id": 56,
    "text": "退特提出“张力”指词语字面外延与联想内涵的协调统一；",
    "start": 216.516,
    "end": 221.344,
    "duration": 4.828
  },
  {
    "id": 57,
    "text": "布鲁克斯指“悖论”是表面矛盾组合中蕴蓄深层真理的诗性语言机制。",
    "start": 221.583,
    "end": 227.278,
    "duration": 5.695
  },
  {
    "id": 58,
    "text": "套用示范：分析艾青名句“为什么我的眼里常含泪水，",
    "start": 227.493,
    "end": 231.685,
    "duration": 4.192
  },
  {
    "id": 59,
    "text": "因为我对这土地爱得深沉”，",
    "start": 231.908,
    "end": 233.787,
    "duration": 1.879
  },
  {
    "id": 60,
    "text": "或穆旦《赞美》中民族血火创痛与坚韧生的希望并存，",
    "start": 234.096,
    "end": 238.286,
    "duration": 4.19
  },
  {
    "id": 61,
    "text": "正是伤痛与至爱对撞生成的崇高诗学张力。",
    "start": 238.792,
    "end": 242.454,
    "duration": 3.662
  }
]