[
  {
    "id": 1,
    "text": "现当代核心文论与叙事学概念速配卡。",
    "start": 0.134,
    "end": 3.106,
    "duration": 2.972
  },
  {
    "id": 2,
    "text": "本卡专攻“用中外文论阐释经典作品”新型论述题与六十分文学评论写作，",
    "start": 3.823,
    "end": 9.475,
    "duration": 5.652
  },
  {
    "id": 3,
    "text": "精选八组高频理论工具，每条按“精准定义加现当代名篇套用示范”编排。",
    "start": 9.854,
    "end": 15.586,
    "duration": 5.732
  },
  {
    "id": 4,
    "text": "一、以意逆志： 孟子《万章上》提出“不以文害辞，不以辞害志。以意逆志，是为得之”，",
    "start": 16.304,
    "end": 19.156,
    "duration": 2.852
  },
  {
    "id": 5,
    "text": "主张读者以己之心意迎候体会作者诗心之志，反对拘泥个别字句。",
    "start": 19.535,
    "end": 21.627,
    "duration": 2.092
  },
  {
    "id": 6,
    "text": "套用示范：以此阐释《阿Q正传》，不能局限于阿Q偷萝卜或画圆圈等表层滑稽举止，",
    "start": 22.305,
    "end": 23.037,
    "duration": 0.732
  },
  {
    "id": 7,
    "text": "而须以同情与忧患之心逆推鲁迅“画出这样沉默的国民的魂灵来”及揭示国民精神胜利法的深切救世之志。",
    "start": 23.416,
    "end": 24.068,
    "duration": 0.652
  },
  {
    "id": 8,
    "text": "二、知人论世：孟子提出的阅读批评方法，强调理解作品实质不能孤立就文论文，",
    "start": 24.746,
    "end": 28.158,
    "duration": 3.412
  },
  {
    "id": 9,
    "text": "必须结合创作者的身世生平、思想立场与具体时代社会背景。",
    "start": 28.537,
    "end": 29.949,
    "duration": 1.412
  },
  {
    "id": 10,
    "text": "套用示范：解读《狂人日记》与鲁迅杂文时，须联系辛亥革命流产后新文化运动反礼教的时代潮汐及鲁迅“呐喊”启蒙心境，",
    "start": 30.627,
    "end": 43.198,
    "duration": 12.571
  },
  {
    "id": 11,
    "text": "方能辨明狂人呼号“吃人”背后的历史沉重。",
    "start": 43.586,
    "end": 46.318,
    "duration": 2.732
  },
  {
    "id": 12,
    "text": "三、意图谬误（意图谬见）：英美新批评维姆萨特与比尔兹利提出，",
    "start": 47.057,
    "end": 50.389,
    "duration": 3.332
  },
  {
    "id": 13,
    "text": "批评把诗误作产生过程、以作者主观创作意图取代文本自身意义的做法，",
    "start": 50.768,
    "end": 56.15,
    "duration": 5.382
  },
  {
    "id": 14,
    "text": "主张文本一旦诞生即独立自足。",
    "start": 56.529,
    "end": 59.021,
    "duration": 2.492
  },
  {
    "id": 15,
    "text": "套用示范：以此重审《阿Q正传》，“精神胜利法”与末章“大团圆”讽刺结构所蕴含的普世人性弱点与荒诞悲剧意味，",
    "start": 59.699,
    "end": 69.031,
    "duration": 9.332
  },
  {
    "id": 16,
    "text": "远超鲁迅最初设想的局部讽刺，意义由文本自身持续生发。",
    "start": 69.41,
    "end": 72.502,
    "duration": 3.092
  },
  {
    "id": 17,
    "text": "四、感受谬误（感受谬见）：维姆萨特与比尔兹利针对印象式批评提出，",
    "start": 73.18,
    "end": 89.72,
    "duration": 16.54
  },
  {
    "id": 18,
    "text": "反对把作品本身混同于读者变动不居的临时情绪反应，主张批评须回到文本具体肌质结构。",
    "start": 90.26,
    "end": 113.769,
    "duration": 23.509
  },
  {
    "id": 19,
    "text": "套用示范：写作文学评论分析《雷雨》或陌生短篇时，忌停留在“令人感动或悲凉”等空泛印象，",
    "start": 114.298,
    "end": 121.31,
    "duration": 7.012
  },
  {
    "id": 20,
    "text": "而须扣住雷雨夜封闭门窗意象、因果巧合与人物语言碰撞析出悲剧张力。",
    "start": 121.689,
    "end": 127.101,
    "duration": 5.412
  },
  {
    "id": 21,
    "text": "五、陌生化：俄国形式主义什克洛夫斯基提出，指通过语言扭曲、视角移位打破日常“自动化”感知，延长感受难度以唤醒鲜活审美体验。",
    "start": 127.725,
    "end": 138.097,
    "duration": 10.372
  },
  {
    "id": 22,
    "text": "套用示范：《狂人日记》借受迫害狂的荒诞错觉把常见长幼礼教“陌生化”为满本“吃人”，带来震撼警醒；",
    "start": 138.775,
    "end": 146.547,
    "duration": 7.772
  },
  {
    "id": 23,
    "text": "《孔乙己》以十二岁咸亨小伙计的冷漠童眼叙事，亦是以旁观冷峻制造强烈的陌生化悲感。",
    "start": 147.305,
    "end": 153.877,
    "duration": 6.572
  },
  {
    "id": 24,
    "text": "六、反讽：新批评布鲁克斯定义为“语境对于一个陈述语的明显的歪曲”，即字面所言与深层所指背离，借语境张力令文本产生含蓄锋芒。",
    "start": 154.595,
    "end": 165.847,
    "duration": 11.252
  },
  {
    "id": 25,
    "text": "套用示范：《阿Q正传》以“大团圆”为末章标题，字面沿用传统团圆套路，",
    "start": 166.565,
    "end": 169.937,
    "duration": 3.372
  },
  {
    "id": 26,
    "text": "实写阿Q糊涂入狱游街被枪毙，形成悲喜倒错的辛辣反讽；",
    "start": 170.316,
    "end": 175.088,
    "duration": 4.772
  },
  {
    "id": 27,
    "text": "张爱玲《金锁记》亦常以世俗算计语调反衬人性畸变。",
    "start": 175.617,
    "end": 177.789,
    "duration": 2.172
  },
  {
    "id": 28,
    "text": "七、叙述视角（聚焦）：叙事学核心范畴，区分超越时空的“全知（零聚焦）视角”与依托特定人物眼光感知的“有限（内或外聚焦）视角”。",
    "start": 178.467,
    "end": 182.839,
    "duration": 4.372
  },
  {
    "id": 29,
    "text": "套用示范：《祝福》采取返乡知识分子“我”的第一人称有限视角观察祥林嫂惨死，",
    "start": 183.557,
    "end": 186.649,
    "duration": 3.092
  },
  {
    "id": 30,
    "text": "既留出审视礼教吃人的客观间距，又暴露知识者在“灵魂有无”拷问面前的精神软弱与无力。",
    "start": 187.028,
    "end": 193.84,
    "duration": 6.812
  },
  {
    "id": 31,
    "text": "八、张力与悖论：退特提出“张力”指词语字面外延与联想内涵的协调统一；",
    "start": 194.558,
    "end": 208.41,
    "duration": 13.852
  },
  {
    "id": 32,
    "text": "布鲁克斯指“悖论”是表面矛盾组合中蕴蓄深层真理的诗性语言机制。",
    "start": 208.939,
    "end": 219.603,
    "duration": 10.664
  },
  {
    "id": 33,
    "text": "套用示范：分析艾青名句“为什么我的眼里常含泪水，因为我对这土地爱得深沉”，",
    "start": 220.132,
    "end": 226.544,
    "duration": 6.412
  },
  {
    "id": 34,
    "text": "或穆旦《赞美》中民族血火创痛与坚韧生的希望并存，",
    "start": 226.923,
    "end": 231.255,
    "duration": 4.332
  },
  {
    "id": 35,
    "text": "正是伤痛与至爱对撞生成的崇高诗学张力。",
    "start": 231.634,
    "end": 235.086,
    "duration": 3.452
  }
]