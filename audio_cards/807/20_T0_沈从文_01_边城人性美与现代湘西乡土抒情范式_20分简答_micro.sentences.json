[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "沈从文·边城人性美与现代湘西乡土抒情范式",
    "start": 0.314,
    "end": 5.246,
    "duration": 4.932
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "品格高度→人物纯美→文体诗调三步写活湘西神庙：1.老船夫、顺顺与“夜半山崖对歌”写尽淳朴“善与美”；",
    "start": 6.294,
    "end": 18.386,
    "duration": 12.092
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "2.山头黄麂般的翠翠与月下摘“虎耳草”传神捕捉自然之子；",
    "start": 19.314,
    "end": 24.766,
    "duration": 5.452
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "3.天保溺亡、傩送远走、老船夫雷雨夜逝留下一句叹息，定格“哀而不伤”牧歌范式。",
    "start": 25.734,
    "end": 33.506,
    "duration": 7.772
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "三十年代中期沈从文《边城》在现代文学史上筑起洋溢古朴德性与生命诗意的湘西“人性神庙”，为京派乡土抒情小说经典。",
    "start": 34.554,
    "end": 45.526,
    "duration": 10.972
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 建构“善”与“美”、寄托重造品德理想",
    "start": 46.494,
    "end": 50.266,
    "duration": 3.772
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "避开尖锐阶级冲突，写边陲茶峒淳朴道德：老船夫摆渡五十年追还钱款、自备烟茶；船总顺顺豪爽乐善；",
    "start": 51.274,
    "end": 62.306,
    "duration": 11.032
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "天保与傩送同爱翠翠却摒弃倾轧，相约按风俗夜半山崖对歌展开“君子之争”，显未被金钱沾染之高尚人性。",
    "start": 62.834,
    "end": 74.046,
    "duration": 11.212
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 刻画自然之子、塑优美含蓄少女典型",
    "start": 74.934,
    "end": 79.466,
    "duration": 4.532
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "翠翠如山头黄麂般天真灵动，端午赛龙舟喧嚣鼓声中与傩送偶遇，少女情窦朦胧萌动；",
    "start": 80.514,
    "end": 89.606,
    "duration": 9.092
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "借翠翠月夜歌声后梦中摘取虎耳草细节，细腻捕捉情愫与自然节律契合。",
    "start": 90.574,
    "end": 98.026,
    "duration": 7.452
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 诗意融散文笔调、立哀而不伤牧歌范式",
    "start": 98.66,
    "end": 102.912,
    "duration": 4.252
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "语言质朴明净融散文化叙事；",
    "start": 103.604,
    "end": 107.456,
    "duration": 3.852
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "恬淡中因人事错位与命运无常转悲：天保茨滩溺亡、傩送负气远走、老船夫雷雨夜悄逝，翠翠独守碧溪岨渡船；",
    "start": 107.724,
    "end": 118.136,
    "duration": 10.412
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "篇末“这个人也许永远不回来了，也许明天回来”化苍凉为绵长叹息，立哀而不伤田园牧歌范式。",
    "start": 119.224,
    "end": 128.916,
    "duration": 9.692
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：地名茶峒、碧溪岨；人物老船夫、翠翠、船总顺顺、天保（大老，唱不惯山歌让爱乘船出走，在茨滩溺亡）、傩送（二老）；",
    "start": 129.924,
    "end": 142.016,
    "duration": 12.092
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "结尾名句“这个人也许永远不回来了，也许明天回来”。",
    "start": 143.064,
    "end": 148.188,
    "duration": 5.124
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 准确区分茶峒、碧溪岨、茨滩地名及天保（大老）与傩送（二老）的命运走向？",
    "start": 148.896,
    "end": 156.964,
    "duration": 8.068
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合“君子之争”与“梦摘虎耳草”阐明沈从文构建“人性神庙”的道德与审美追求？",
    "start": 157.892,
    "end": 166.864,
    "duration": 8.972
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2021 年简答《结合沈从文作品谈文学史贡献》怎么调用本篇？",
    "start": 167.832,
    "end": 174.564,
    "duration": 6.732
  }
]