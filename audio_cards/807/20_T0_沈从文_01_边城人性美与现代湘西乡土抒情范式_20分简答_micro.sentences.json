[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "品格高度→人物纯美→文体诗调三步写活湘西神庙：",
    "start": 0.0,
    "end": 5.0,
    "duration": 5.0
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "1.老船夫、顺顺与“夜半山崖对歌”写尽淳朴“善与美”；",
    "start": 5.049,
    "end": 9.769,
    "duration": 4.72
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "2.山头黄麂般的翠翠与月下摘“虎耳草”传神捕捉自然之子；",
    "start": 10.219,
    "end": 15.619,
    "duration": 5.4
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "3.天保溺亡、傩送远走、老船夫雷雨夜逝留下一句叹息，",
    "start": 16.069,
    "end": 21.109,
    "duration": 5.04
  },
  {
    "id": "hook_c4",
    "dom_key": "hook_c4",
    "text": "定格“哀而不伤”牧歌范式。",
    "start": 21.559,
    "end": 23.679,
    "duration": 2.12
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "三十年代中期沈从文《边城》在现代文学史上筑起洋溢古朴德性与生命诗意的湘西“人性神庙”，",
    "start": 24.129,
    "end": 31.529,
    "duration": 7.4
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "为京派乡土抒情小说经典。",
    "start": 31.979,
    "end": 34.219,
    "duration": 2.24
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 建构“善”与“美”、寄托重造品德理想",
    "start": 34.749,
    "end": 38.429,
    "duration": 3.68
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "避开尖锐阶级冲突，写边陲茶峒淳朴道德：",
    "start": 38.879,
    "end": 42.559,
    "duration": 3.68
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "老船夫摆渡五十年追还钱款、自备烟茶；",
    "start": 43.009,
    "end": 46.369,
    "duration": 3.36
  },
  {
    "id": "sec0_step0_c2",
    "dom_key": "sec0_step0_c2",
    "text": "船总顺顺豪爽乐善；",
    "start": 46.819,
    "end": 48.619,
    "duration": 1.8
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "天保与傩送同爱翠翠却摒弃倾轧，",
    "start": 49.069,
    "end": 52.029,
    "duration": 2.96
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "相约按风俗夜半山崖对歌展开“君子之争”，显未被金钱沾染之高尚人性。",
    "start": 52.479,
    "end": 58.359,
    "duration": 5.88
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 刻画自然之子、塑优美含蓄少女典型",
    "start": 58.809,
    "end": 62.689,
    "duration": 3.88
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "翠翠如山头黄麂般天真灵动，端午赛龙舟喧嚣鼓声中与傩送偶遇，",
    "start": 63.139,
    "end": 68.699,
    "duration": 5.56
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "少女情窦朦胧萌动；",
    "start": 69.149,
    "end": 70.829,
    "duration": 1.68
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "借翠翠月夜歌声后梦中摘取虎耳草细节，细腻捕捉情愫与自然节律契合。",
    "start": 71.279,
    "end": 77.479,
    "duration": 6.2
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 诗意融散文笔调、立哀而不伤牧歌范式",
    "start": 77.929,
    "end": 82.089,
    "duration": 4.16
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "语言质朴明净融散文化叙事；",
    "start": 82.619,
    "end": 84.979,
    "duration": 2.36
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "恬淡中因人事错位与命运无常转悲：",
    "start": 85.429,
    "end": 88.509,
    "duration": 3.08
  },
  {
    "id": "sec2_step0_c2",
    "dom_key": "sec2_step0_c2",
    "text": "天保茨滩溺亡、傩送负气远走、老船夫雷雨夜悄逝，翠翠独守碧溪岨渡船；",
    "start": 88.959,
    "end": 95.719,
    "duration": 6.76
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "篇末“这个人也许永远不回来了，也许明天回来”化苍凉为绵长叹息，",
    "start": 96.169,
    "end": 101.329,
    "duration": 5.16
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "立哀而不伤田园牧歌范式。",
    "start": 101.779,
    "end": 104.059,
    "duration": 2.28
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：地名茶峒、碧溪岨；",
    "start": 104.509,
    "end": 107.229,
    "duration": 2.72
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "人物老船夫、翠翠、船总顺顺、天保（大老，唱不惯山歌让爱乘船出走，",
    "start": 107.679,
    "end": 113.439,
    "duration": 5.76
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "在茨滩溺亡）、傩送（二老）；",
    "start": 113.889,
    "end": 116.089,
    "duration": 2.2
  },
  {
    "id": "guard_c3",
    "dom_key": "guard_c3",
    "text": "结尾名句“这个人也许永远不回来了，也许明天回来”。",
    "start": 116.539,
    "end": 120.579,
    "duration": 4.04
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 准确区分茶峒、碧溪岨、茨滩地名及天保（大老）与傩送（二老）的命运走向？",
    "start": 121.029,
    "end": 129.229,
    "duration": 8.2
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合“君子之争”与“梦摘虎耳草”阐明沈从文构建“人性神庙”的道德与审美追求？",
    "start": 129.679,
    "end": 137.599,
    "duration": 7.92
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2021 年简答《结合沈从文作品谈文学史贡献》怎么调用本篇？",
    "start": 138.049,
    "end": 145.009,
    "duration": 6.96
  }
]