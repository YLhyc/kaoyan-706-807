[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "创作观→英雄人格→诗化高潮→剧场功勋四步层进：1942“皖南事变”后重庆，",
    "start": 0.236,
    "end": 7.999,
    "duration": 7.763
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "郭沫若秉持“失事求似”影射国民党反共消极抗战，",
    "start": 8.725,
    "end": 12.89,
    "duration": 4.165
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "重塑不哀怨而刚烈的屈原（对照婵娟殉道、宋玉堕落），",
    "start": 13.616,
    "end": 17.969,
    "duration": 4.353
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "以《雷电颂》抒情独白达诗剧顶点，燃起国泰大戏院动员狂潮。",
    "start": 18.703,
    "end": 23.572,
    "duration": 4.869
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "抗战相持阶段“皖南事变”阴云下，郭沫若五幕历史剧《屈原》践行“失事求似”，",
    "start": 24.28,
    "end": 30.661,
    "duration": 6.381
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "塑殉道悲剧英雄并在大后方鼓舞民主抗争。",
    "start": 31.386,
    "end": 34.99,
    "duration": 3.604
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 践行“失事求似”、构筑借古讽今批判锋芒",
    "start": 35.693,
    "end": 39.852,
    "duration": 4.159
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "重把握历史精神不泥琐碎考据，允许次要史事大胆虚构开掘本质，即“失事求似”；",
    "start": 40.633,
    "end": 47.713,
    "duration": 7.08
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "写屈原联齐抗秦遭诬陷，以南后、张仪、楚怀王影射重庆国民党消极抗日、积极反共倒行逆施。",
    "start": 48.435,
    "end": 56.889,
    "duration": 8.454
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 承续浪漫激情、塑崇高刚烈悲剧英雄",
    "start": 57.571,
    "end": 61.905,
    "duration": 4.334
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "把《女神》激情注入剧作，一改传统哀怨悱恻失意文人为大义凛然、坚守理想的崇高英雄；",
    "start": 62.639,
    "end": 70.064,
    "duration": 7.425
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "婵娟误饮鸩酒代屈原殉难映忠贞；宋玉由崇拜堕为权贵弄臣，反衬屈原人格伟力。",
    "start": 70.763,
    "end": 78.24,
    "duration": 7.476
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 第五幕《雷电颂》独白、立诗剧合一典范",
    "start": 78.935,
    "end": 82.805,
    "duration": 3.87
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "屈原囚庙中借《雷电颂》将悲愤融于雷电暴风，呼喊“风！你咆哮吧！”，祈撕碎黑暗泥胎；",
    "start": 83.519,
    "end": 90.734,
    "duration": 7.215
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "自由体排比突破写实外部动作局限，升华为内心激情诗意宣泄，立现代抒情诗剧典范。",
    "start": 91.483,
    "end": 99.36,
    "duration": 7.877
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 激活战时剧场动员机制、定型史剧范式",
    "start": 100.136,
    "end": 104.212,
    "duration": 4.076
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "重庆国泰大戏院首演强烈呼应反独裁争民主呼声，将案头诗意与剧场共鸣结合，",
    "start": 104.928,
    "end": 112.21,
    "duration": 7.283
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "舞台成凝聚反抗的公共空间；",
    "start": 112.982,
    "end": 115.312,
    "duration": 2.329
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "融诗激情、史沉思与剧冲突于一体，建成民族特色现代浪漫主义历史剧范式。",
    "start": 116.077,
    "end": 122.829,
    "duration": 6.752
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《屈原》以借古讽今眼光、刚烈英雄品格与诗剧交融建构开辟现代话剧抒情诗化道路，",
    "start": 123.546,
    "end": 130.638,
    "duration": 7.091
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "成浪漫主义历史剧经典。",
    "start": 131.493,
    "end": 133.376,
    "duration": 1.883
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：创作于“皖南事变”后抗战大后方重庆；",
    "start": 134.21,
    "end": 137.885,
    "duration": 3.675
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "核心原则是“失事求似”（区别于严格考据历史剧）；",
    "start": 138.674,
    "end": 142.805,
    "duration": 4.131
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "高潮第五幕东皇太一庙《雷电颂》；",
    "start": 143.501,
    "end": 146.354,
    "duration": 2.853
  },
  {
    "id": "guard_c3",
    "dom_key": "guard_c3",
    "text": "关键对比人物：婵娟（殉道） vs 宋玉（堕落）。",
    "start": 147.069,
    "end": 150.738,
    "duration": 3.669
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 结合历史背景说明《屈原》如何借“失事求似”回应“皖南事变”后大后方局势？",
    "start": 151.489,
    "end": 158.947,
    "duration": 7.458
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 阐述婵娟、宋玉对照及第五幕东皇太一庙《雷电颂》独白对抒情诗剧的贡献？",
    "start": 159.668,
    "end": 167.88,
    "duration": 8.212
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2025 名解《屈原》与 30 分郭沫若历史剧专论的组织方法？",
    "start": 168.599,
    "end": 175.281,
    "duration": 6.682
  }
]