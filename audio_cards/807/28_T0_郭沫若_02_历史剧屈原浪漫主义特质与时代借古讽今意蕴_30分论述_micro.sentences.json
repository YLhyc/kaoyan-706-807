[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "郭沫若·历史剧屈原浪漫主义特质与时代借古讽今意蕴",
    "start": 0.134,
    "end": 4.781,
    "duration": 4.647
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "创作观→英雄人格→诗化高潮→剧场功勋四步层进：1942“皖南事变”后重庆，",
    "start": 5.37,
    "end": 13.468,
    "duration": 8.098
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "郭沫若秉持“失事求似”影射国民党反共消极抗战，",
    "start": 13.756,
    "end": 18.104,
    "duration": 4.348
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "重塑不哀怨而刚烈的屈原（对照婵娟殉道、宋玉堕落），以《雷电颂》抒情独白达诗剧顶点，燃起国泰大戏院动员狂潮。",
    "start": 18.205,
    "end": 28.308,
    "duration": 10.103
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "抗战相持阶段“皖南事变”阴云下，郭沫若五幕历史剧《屈原》践行“失事求似”，",
    "start": 28.895,
    "end": 35.209,
    "duration": 6.314
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "塑殉道悲剧英雄并在大后方鼓舞民主抗争。",
    "start": 35.523,
    "end": 39.519,
    "duration": 3.996
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 践行“失事求似”、构筑借古讽今批判锋芒",
    "start": 40.093,
    "end": 44.454,
    "duration": 4.361
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "重把握历史精神不泥琐碎考据，允许次要史事大胆虚构开掘本质，即“失事求似”；",
    "start": 45.028,
    "end": 52.891,
    "duration": 7.864
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "写屈原联齐抗秦遭诬陷，以南后、张仪、楚怀王影射重庆国民党消极抗日、积极反共倒行逆施。",
    "start": 53.478,
    "end": 63.008,
    "duration": 9.53
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 承续浪漫激情、塑崇高刚烈悲剧英雄",
    "start": 63.595,
    "end": 67.995,
    "duration": 4.4
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "把《女神》激情注入剧作，一改传统哀怨悱恻失意文人为大义凛然、坚守理想的崇高英雄；",
    "start": 68.569,
    "end": 76.811,
    "duration": 8.241
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "婵娟误饮鸩酒代屈原殉难映忠贞；宋玉由崇拜堕为权贵弄臣，反衬屈原人格伟力。",
    "start": 77.398,
    "end": 86.068,
    "duration": 8.671
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 第五幕《雷电颂》独白、立诗剧合一典范",
    "start": 86.642,
    "end": 90.938,
    "duration": 4.296
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "屈原囚庙中借《雷电颂》将悲愤融于雷电暴风，呼喊“风！你咆哮吧！”，祈撕碎黑暗泥胎；",
    "start": 91.512,
    "end": 100.899,
    "duration": 9.387
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "自由体排比突破写实外部动作局限，升华为内心激情诗意宣泄，立现代抒情诗剧典范。",
    "start": 101.473,
    "end": 110.456,
    "duration": 8.983
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 激活战时剧场动员机制、定型史剧范式",
    "start": 111.043,
    "end": 115.274,
    "duration": 4.231
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "重庆国泰大戏院首演强烈呼应反独裁争民主呼声，将案头诗意与剧场共鸣结合，舞台成凝聚反抗的公共空间；",
    "start": 115.835,
    "end": 126.798,
    "duration": 10.963
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "融诗激情、史沉思与剧冲突于一体，建成民族特色现代浪漫主义历史剧范式。",
    "start": 127.384,
    "end": 135.287,
    "duration": 7.903
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《屈原》以借古讽今眼光、刚烈英雄品格与诗剧交融建构开辟现代话剧抒情诗化道路，成浪漫主义历史剧经典。",
    "start": 135.861,
    "end": 145.665,
    "duration": 9.804
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：创作于“皖南事变”后抗战大后方重庆；",
    "start": 146.252,
    "end": 150.209,
    "duration": 3.957
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "核心原则是“失事求似”（区别于严格考据历史剧）；",
    "start": 150.575,
    "end": 154.792,
    "duration": 4.218
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "高潮第五幕东皇太一庙《雷电颂》；",
    "start": 155.171,
    "end": 158.061,
    "duration": 2.89
  },
  {
    "id": "guard_c3",
    "dom_key": "guard_c3",
    "text": "关键对比人物：婵娟（殉道） vs 宋玉（堕落）。",
    "start": 158.387,
    "end": 162.37,
    "duration": 3.983
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 结合历史背景说明《屈原》如何借“失事求似”回应“皖南事变”后大后方局势？",
    "start": 162.957,
    "end": 170.3,
    "duration": 7.343
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 阐述婵娟、宋玉对照及第五幕东皇太一庙《雷电颂》独白对抒情诗剧的贡献？",
    "start": 170.887,
    "end": 179.024,
    "duration": 8.137
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2025 名解《屈原》与 30 分郭沫若历史剧专论的组织方法？",
    "start": 179.611,
    "end": 186.563,
    "duration": 6.952
  }
]