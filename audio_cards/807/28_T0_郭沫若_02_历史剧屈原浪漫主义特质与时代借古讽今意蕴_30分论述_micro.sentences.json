[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "郭沫若·历史剧屈原浪漫主义特质与时代借古讽今意蕴",
    "start": 0.274,
    "end": 5.406,
    "duration": 5.132
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "创作观→英雄人格→诗化高潮→剧场功勋四步层进：1942“皖南事变”后重庆，",
    "start": 6.414,
    "end": 14.946,
    "duration": 8.532
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "郭沫若秉持“失事求似”影射国民党反共消极抗战，",
    "start": 15.094,
    "end": 19.706,
    "duration": 4.612
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "重塑不哀怨而刚烈的屈原（对照婵娟殉道、宋玉堕落），以《雷电颂》抒情独白达诗剧顶点，燃起国泰大戏院动员狂潮。",
    "start": 19.854,
    "end": 29.666,
    "duration": 9.812
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "抗战相持阶段“皖南事变”阴云下，郭沫若五幕历史剧《屈原》践行“失事求似”，",
    "start": 30.714,
    "end": 37.606,
    "duration": 6.892
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "塑殉道悲剧英雄并在大后方鼓舞民主抗争。",
    "start": 38.074,
    "end": 41.846,
    "duration": 3.772
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 践行“失事求似”、构筑借古讽今批判锋芒",
    "start": 42.774,
    "end": 47.466,
    "duration": 4.692
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "重把握历史精神不泥琐碎考据，允许次要史事大胆虚构开掘本质，即“失事求似”；",
    "start": 48.554,
    "end": 57.406,
    "duration": 8.852
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "写屈原联齐抗秦遭诬陷，以南后、张仪、楚怀王影射重庆国民党消极抗日、积极反共倒行逆施。",
    "start": 58.374,
    "end": 68.146,
    "duration": 9.772
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 承续浪漫激情、塑崇高刚烈悲剧英雄",
    "start": 69.074,
    "end": 73.046,
    "duration": 3.972
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "把《女神》激情注入剧作，一改传统哀怨悱恻失意文人为大义凛然、坚守理想的崇高英雄；",
    "start": 74.054,
    "end": 82.506,
    "duration": 8.452
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "婵娟误饮鸩酒代屈原殉难映忠贞；宋玉由崇拜堕为权贵弄臣，反衬屈原人格伟力。",
    "start": 83.514,
    "end": 94.466,
    "duration": 10.952
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 第五幕《雷电颂》独白、立诗剧合一典范",
    "start": 95.394,
    "end": 99.326,
    "duration": 3.932
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "屈原囚庙中借《雷电颂》将悲愤融于雷电暴风，呼喊“风！你咆哮吧！”，祈撕碎黑暗泥胎；",
    "start": 100.058,
    "end": 109.83,
    "duration": 9.772
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "自由体排比突破写实外部动作局限，升华为内心激情诗意宣泄，立现代抒情诗剧典范。",
    "start": 110.918,
    "end": 120.17,
    "duration": 9.252
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 激活战时剧场动员机制、定型史剧范式",
    "start": 121.138,
    "end": 125.59,
    "duration": 4.452
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "重庆国泰大戏院首演强烈呼应反独裁争民主呼声，将案头诗意与剧场共鸣结合，舞台成凝聚反抗的公共空间；",
    "start": 126.598,
    "end": 137.61,
    "duration": 11.012
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "融诗激情、史沉思与剧冲突于一体，建成民族特色现代浪漫主义历史剧范式。",
    "start": 138.658,
    "end": 147.11,
    "duration": 8.452
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《屈原》以借古讽今眼光、刚烈英雄品格与诗剧交融建构开辟现代话剧抒情诗化道路，成浪漫主义历史剧经典。",
    "start": 148.078,
    "end": 157.85,
    "duration": 9.772
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：创作于“皖南事变”后抗战大后方重庆；",
    "start": 158.818,
    "end": 162.71,
    "duration": 3.892
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "核心原则是“失事求似”（区别于严格考据历史剧）；",
    "start": 163.718,
    "end": 167.81,
    "duration": 4.092
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "高潮第五幕东皇太一庙《雷电颂》；",
    "start": 168.818,
    "end": 171.75,
    "duration": 2.932
  },
  {
    "id": "guard_c3",
    "dom_key": "guard_c3",
    "text": "关键对比人物：婵娟（殉道） vs 宋玉（堕落）。",
    "start": 172.718,
    "end": 177.01,
    "duration": 4.292
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 结合历史背景说明《屈原》如何借“失事求似”回应“皖南事变”后大后方局势？",
    "start": 177.938,
    "end": 184.83,
    "duration": 6.892
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 阐述婵娟、宋玉对照及第五幕东皇太一庙《雷电颂》独白对抒情诗剧的贡献？",
    "start": 185.254,
    "end": 193.066,
    "duration": 7.812
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2025 名解《屈原》与 30 分郭沫若历史剧专论的组织方法？",
    "start": 193.498,
    "end": 200.03,
    "duration": 6.532
  }
]