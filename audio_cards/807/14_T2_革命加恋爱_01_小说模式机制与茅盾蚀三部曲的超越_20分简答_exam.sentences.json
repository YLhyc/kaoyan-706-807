[
  {
    "id": 1,
    "text": "大革命失败前后，以蒋光慈等后期创造社、太阳社作家为代表，现代文坛兴起了“革命加恋爱”的小说创作风潮。",
    "start": 0.2,
    "end": 9.16,
    "duration": 8.96
  },
  {
    "id": 2,
    "text": "这一模式一度成为三十年代初期左翼文学吸引青年读者的重要样式，",
    "start": 9.68,
    "end": 14.72,
    "duration": 5.04
  },
  {
    "id": 3,
    "text": "其叙事机制、艺术局限以及茅盾的突破主要体现在以下三个方面：",
    "start": 15.12,
    "end": 20.24,
    "duration": 5.12
  },
  {
    "id": 4,
    "text": "第一，建构二元对抗的公式化叙事，以浪漫情爱包裹革命动员。",
    "start": 20.61,
    "end": 25.57,
    "duration": 4.96
  },
  {
    "id": 5,
    "text": "该模式通常遵循固定套路：小资产阶级青年在家庭或都市恋爱中遭遇挫折，",
    "start": 26.09,
    "end": 32.326,
    "duration": 6.236
  },
  {
    "id": 6,
    "text": "陷入苦闷幻灭后，在革命者感召下放弃个人私情，投身工农斗争并坚定革命信仰。",
    "start": 32.676,
    "end": 39.26,
    "duration": 6.584
  },
  {
    "id": 7,
    "text": "蒋光慈在《野祭》《冲出云围的月亮》与洪灵菲在《流亡》中均沿用此类写法，",
    "start": 39.78,
    "end": 46.003,
    "duration": 6.223
  },
  {
    "id": 8,
    "text": "契合了激进青年的阅读心理，但将革命概念化、脸谱化的做法，",
    "start": 46.353,
    "end": 51.11,
    "duration": 4.757
  },
  {
    "id": 9,
    "text": "使思想说教往往削弱了作品的艺术感染力。",
    "start": 51.48,
    "end": 54.84,
    "duration": 3.36
  },
  {
    "id": 10,
    "text": "第二，陷入主观抒情狂热与人物心理简单化的概念化弊端。",
    "start": 55.36,
    "end": 60.0,
    "duration": 4.64
  },
  {
    "id": 11,
    "text": "早期模式作品往往缺乏对中国社会复杂阶级关系的深入体察，",
    "start": 60.52,
    "end": 65.72,
    "duration": 5.2
  },
  {
    "id": 12,
    "text": "人物正邪分明、性格扁平，恋爱多沦为宣讲政治观念的载体，",
    "start": 66.09,
    "end": 70.97,
    "duration": 4.88
  },
  {
    "id": 13,
    "text": "革命斗争则被浪漫化为热血传奇，既难以深入剖析知识分子思想转变的阵痛，也回避了大革命退潮期的严峻考验。",
    "start": 71.37,
    "end": 80.25,
    "duration": 8.88
  },
  {
    "id": 14,
    "text": "第三，与稍后流行的“革命加恋爱”公式迥异，茅盾在《蚀》三部曲中摒弃廉价幻象，揭示退潮期知识分子的精神创伤。",
    "start": 80.77,
    "end": 90.05,
    "duration": 9.28
  },
  {
    "id": 15,
    "text": "茅盾拒绝空洞的乐观宣传，以《幻灭》《动摇》《追求》敏锐记录了动荡岁月中青年的精神困惑。",
    "start": 90.57,
    "end": 98.33,
    "duration": 7.76
  },
  {
    "id": 16,
    "text": "无论是静女士投身革命却遭投机分子玩弄后的幻灭、方罗兰在左右夹击中的优柔动摇，",
    "start": 98.85,
    "end": 105.41,
    "duration": 6.56
  },
  {
    "id": 17,
    "text": "还是章秋柳在政治苦闷中借放浪情欲麻痹自我的畸形追求，",
    "start": 105.78,
    "end": 110.5,
    "duration": 4.72
  },
  {
    "id": 18,
    "text": "茅盾均以冷静写实的笔触还原了历史低潮期生命的真实挣扎，",
    "start": 110.87,
    "end": 116.377,
    "duration": 5.507
  },
  {
    "id": 19,
    "text": "将这一题材提升至现代社会心理剖析的新高度。",
    "start": 116.747,
    "end": 120.68,
    "duration": 3.933
  }
]
