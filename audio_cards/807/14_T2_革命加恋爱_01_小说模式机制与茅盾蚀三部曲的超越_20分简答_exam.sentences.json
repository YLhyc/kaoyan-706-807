[
  {
    "id": 1,
    "text": "大革命失败前后，以蒋光慈等创造社、太阳社作家为代表，",
    "start": 0.0,
    "end": 5.41,
    "duration": 5.41
  },
  {
    "id": 2,
    "text": "在现代文学史上掀起了“革命加恋爱”的小说风潮。",
    "start": 5.41,
    "end": 9.618,
    "duration": 4.208
  },
  {
    "id": 3,
    "text": "这一模式迅速成为三十年代左翼文学吸引青年读者的文体母本，",
    "start": 9.618,
    "end": 14.682,
    "duration": 5.064
  },
  {
    "id": 4,
    "text": "其发生机制、",
    "start": 14.682,
    "end": 15.879,
    "duration": 1.197
  },
  {
    "id": 5,
    "text": "艺术局限以及茅盾的深刻超越主要体现在以下三个方面：",
    "start": 15.879,
    "end": 20.539,
    "duration": 4.66
  },
  {
    "id": 6,
    "text": "第一，建构二元对抗的公式化叙事，",
    "start": 20.539,
    "end": 23.58,
    "duration": 3.041
  },
  {
    "id": 7,
    "text": "借资产阶级浪漫情爱包裹革命政治动员。",
    "start": 23.58,
    "end": 26.84,
    "duration": 3.26
  },
  {
    "id": 8,
    "text": "该模式通常遵循固定的情节套路：",
    "start": 26.84,
    "end": 29.628,
    "duration": 2.788
  },
  {
    "id": 9,
    "text": "小资产阶级知识分子青年在封建或都市恋爱中遭遇挫折，",
    "start": 29.628,
    "end": 34.21,
    "duration": 4.582
  },
  {
    "id": 10,
    "text": "经受苦闷与幻灭后，在革命战友的感召下毅然放弃个人私情，",
    "start": 34.21,
    "end": 39.218,
    "duration": 5.008
  },
  {
    "id": 11,
    "text": "投身工农武装运动，在火热斗争中实现政治觉悟的升华。",
    "start": 39.218,
    "end": 43.815,
    "duration": 4.597
  },
  {
    "id": 12,
    "text": "蒋光慈在《短裤党》《冲出云围的月亮》中以此模式迎合了激进青年的阅读心理，",
    "start": 43.815,
    "end": 49.382,
    "duration": 5.567
  },
  {
    "id": 13,
    "text": "但过度将革命概念化、脸谱化，",
    "start": 49.382,
    "end": 51.898,
    "duration": 2.516
  },
  {
    "id": 14,
    "text": "导致思想说教严重削弱了艺术审美。",
    "start": 51.898,
    "end": 53.206,
    "duration": 1.308
  },
  {
    "id": 15,
    "text": "第二，陷入主观抒情狂热与人物心理简单化的概念化创作弊端。",
    "start": 53.206,
    "end": 55.456,
    "duration": 2.25
  },
  {
    "id": 16,
    "text": "早期模式作品往往缺乏对中国社会复杂阶级关系的实证把握，",
    "start": 55.456,
    "end": 59.714,
    "duration": 4.258
  },
  {
    "id": 17,
    "text": "人物非黑即白，恋爱往往沦为宣讲政论口号的传声筒，",
    "start": 59.714,
    "end": 65.614,
    "duration": 5.9
  },
  {
    "id": 18,
    "text": "革命斗争则被浪漫化为热血冒险，",
    "start": 65.614,
    "end": 68.451,
    "duration": 2.837
  },
  {
    "id": 19,
    "text": "既无法深入解剖知识分子的阶级脱胎之痛，",
    "start": 68.451,
    "end": 77.823,
    "duration": 9.372
  },
  {
    "id": 20,
    "text": "亦回避了革命历史退潮期的残酷与严峻考验。",
    "start": 77.823,
    "end": 81.71,
    "duration": 3.887
  },
  {
    "id": 21,
    "text": "第三，茅盾在《蚀》三部曲中解构虚饰神话，",
    "start": 81.71,
    "end": 85.795,
    "duration": 4.085
  },
  {
    "id": 22,
    "text": "深刻揭示大革命退潮期小资产阶级的精神创伤。",
    "start": 85.795,
    "end": 90.796,
    "duration": 5.001
  },
  {
    "id": 23,
    "text": "茅盾断然拒绝廉价的革命乐观主义，",
    "start": 90.796,
    "end": 94.385,
    "duration": 3.589
  },
  {
    "id": 24,
    "text": "以《幻灭》《动摇》《追求》敏锐记录了动荡岁月中知识分子的灵魂阵痛。",
    "start": 94.385,
    "end": 98.577,
    "duration": 4.192
  },
  {
    "id": 25,
    "text": "无论是静女士投身革命却遭投机分子玩弄的幻灭、",
    "start": 98.577,
    "end": 102.468,
    "duration": 3.891
  },
  {
    "id": 26,
    "text": "方罗兰在右派背叛与工农运动间的优柔动摇，",
    "start": 102.468,
    "end": 104.662,
    "duration": 2.194
  },
  {
    "id": 27,
    "text": "还是章秋柳在政治无望后借放浪情欲麻痹灵魂的疯狂追求，",
    "start": 104.662,
    "end": 110.32,
    "duration": 5.658
  },
  {
    "id": 28,
    "text": "茅盾以冷峻深邃的现实主义笔触还原了历史低潮期生命的真实悲剧，",
    "start": 110.32,
    "end": 114.365,
    "duration": 4.045
  },
  {
    "id": 29,
    "text": "成功将这一模式提升至现代社会心理剖析的高度。",
    "start": 114.365,
    "end": 116.576,
    "duration": 2.211
  }
]