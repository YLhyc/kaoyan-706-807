[
  {
    "id": 1,
    "text": "大革命失败前后，以蒋光慈等创造社、太阳社作家为代表，",
    "start": 0.05,
    "end": 5.381,
    "duration": 5.331
  },
  {
    "id": 2,
    "text": "在现代文学史上掀起了“革命加恋爱”的小说风潮。",
    "start": 5.381,
    "end": 9.588,
    "duration": 4.207
  },
  {
    "id": 3,
    "text": "这一模式迅速成为三十年代左翼文学吸引青年读者的文体母本，",
    "start": 9.588,
    "end": 14.652,
    "duration": 5.064
  },
  {
    "id": 4,
    "text": "其发生机制、",
    "start": 14.652,
    "end": 15.849,
    "duration": 1.197
  },
  {
    "id": 5,
    "text": "艺术局限以及茅盾的深刻超越主要体现在以下三个方面：",
    "start": 15.849,
    "end": 20.509,
    "duration": 4.66
  },
  {
    "id": 6,
    "text": "第一，建构二元对抗的公式化叙事，",
    "start": 20.509,
    "end": 23.55,
    "duration": 3.041
  },
  {
    "id": 7,
    "text": "借资产阶级浪漫情爱包裹革命政治动员。",
    "start": 23.55,
    "end": 26.81,
    "duration": 3.26
  },
  {
    "id": 8,
    "text": "该模式通常遵循固定的情节套路：",
    "start": 26.81,
    "end": 29.601,
    "duration": 2.791
  },
  {
    "id": 9,
    "text": "小资产阶级知识分子青年在封建或都市恋爱中遭遇挫折，",
    "start": 29.601,
    "end": 34.181,
    "duration": 4.58
  },
  {
    "id": 10,
    "text": "经受苦闷与幻灭后，在革命战友的感召下毅然放弃个人私情，",
    "start": 34.181,
    "end": 39.188,
    "duration": 5.007
  },
  {
    "id": 11,
    "text": "投身工农武装运动，在火热斗争中实现政治觉悟的升华。",
    "start": 39.188,
    "end": 43.788,
    "duration": 4.6
  },
  {
    "id": 12,
    "text": "蒋光慈在《短裤党》《冲出云围的月亮》中以此模式迎合了激进青年的阅读心理，",
    "start": 43.788,
    "end": 49.424,
    "duration": 5.636
  },
  {
    "id": 13,
    "text": "但过度将革命概念化、脸谱化，",
    "start": 49.424,
    "end": 51.869,
    "duration": 2.445
  },
  {
    "id": 14,
    "text": "导致思想说教严重削弱了艺术审美。",
    "start": 51.869,
    "end": 54.863,
    "duration": 2.994
  },
  {
    "id": 15,
    "text": "第二，陷入主观抒情狂热与人物心理简单化的概念化创作弊端。",
    "start": 54.863,
    "end": 59.692,
    "duration": 4.829
  },
  {
    "id": 16,
    "text": "早期模式作品往往缺乏对中国社会复杂阶级关系的实证把握，",
    "start": 59.692,
    "end": 64.438,
    "duration": 4.746
  },
  {
    "id": 17,
    "text": "人物非黑即白，恋爱往往沦为宣讲政论口号的传声筒，",
    "start": 64.438,
    "end": 68.759,
    "duration": 4.321
  },
  {
    "id": 18,
    "text": "革命斗争则被浪漫化为热血冒险，",
    "start": 68.759,
    "end": 71.545,
    "duration": 2.786
  },
  {
    "id": 19,
    "text": "既无法深入解剖知识分子的阶级脱胎之痛，",
    "start": 71.545,
    "end": 75.073,
    "duration": 3.528
  },
  {
    "id": 20,
    "text": "亦回避了革命历史退潮期的残酷与严峻考验。",
    "start": 75.073,
    "end": 80.213,
    "duration": 5.14
  },
  {
    "id": 21,
    "text": "第三，茅盾在《蚀》三部曲中解构虚饰神话，",
    "start": 80.213,
    "end": 83.792,
    "duration": 3.579
  },
  {
    "id": 22,
    "text": "深刻揭示大革命退潮期小资产阶级的精神创伤。",
    "start": 83.792,
    "end": 87.428,
    "duration": 3.636
  },
  {
    "id": 23,
    "text": "茅盾断然拒绝廉价的革命乐观主义，",
    "start": 87.428,
    "end": 90.767,
    "duration": 3.339
  },
  {
    "id": 24,
    "text": "以《幻灭》《动摇》《追求》敏锐记录了动荡岁月中知识分子的灵魂阵痛。",
    "start": 90.767,
    "end": 95.495,
    "duration": 4.728
  },
  {
    "id": 25,
    "text": "无论是静女士投身革命却遭投机分子玩弄的幻灭、",
    "start": 95.495,
    "end": 99.313,
    "duration": 3.818
  },
  {
    "id": 26,
    "text": "方罗兰在右派背叛与工农运动间的优柔动摇，",
    "start": 99.313,
    "end": 102.767,
    "duration": 3.454
  },
  {
    "id": 27,
    "text": "还是章秋柳在政治无望后借放浪情欲麻痹灵魂的疯狂追求，",
    "start": 102.767,
    "end": 107.583,
    "duration": 4.816
  },
  {
    "id": 28,
    "text": "茅盾以冷峻深邃的现实主义笔触还原了历史低潮期生命的真实悲剧，",
    "start": 107.583,
    "end": 113.024,
    "duration": 5.441
  },
  {
    "id": 29,
    "text": "成功将这一模式提升至现代社会心理剖析的高度。",
    "start": 113.024,
    "end": 116.856,
    "duration": 3.832
  }
]