[
  {
    "id": 1,
    "text": "大革命失败前后，以蒋光慈等后期创造社、太阳社作家为代表，现代文坛兴起了“革命加恋爱”的小说创作风潮。",
    "start": 0.116,
    "end": 8.766,
    "duration": 8.65
  },
  {
    "id": 2,
    "text": "这一模式一度成为三十年代初期左翼文学吸引青年读者的重要样式，",
    "start": 9.266,
    "end": 14.36,
    "duration": 5.094
  },
  {
    "id": 3,
    "text": "其叙事机制、艺术局限以及茅盾的突破主要体现在以下三个方面：",
    "start": 14.71,
    "end": 19.44,
    "duration": 4.73
  },
  {
    "id": 4,
    "text": "第一，建构二元对抗的公式化叙事，以浪漫情爱包裹革命动员。",
    "start": 20.098,
    "end": 24.933,
    "duration": 4.835
  },
  {
    "id": 5,
    "text": "该模式通常遵循固定套路：小资产阶级青年在家庭或都市恋爱中遭遇挫折，",
    "start": 25.433,
    "end": 31.586,
    "duration": 6.153
  },
  {
    "id": 6,
    "text": "陷入苦闷幻灭后，在革命者感召下放弃个人私情，投身工农斗争并坚定革命信仰。",
    "start": 31.936,
    "end": 38.953,
    "duration": 7.017
  },
  {
    "id": 7,
    "text": "蒋光慈在《野祭》《冲出云围的月亮》与洪灵菲在《流亡》中均沿用此类写法，",
    "start": 39.453,
    "end": 45.018,
    "duration": 5.565
  },
  {
    "id": 8,
    "text": "契合了激进青年的阅读心理，但将革命概念化、脸谱化的做法，",
    "start": 45.482,
    "end": 50.26,
    "duration": 4.778
  },
  {
    "id": 9,
    "text": "使思想说教往往削弱了作品的艺术感染力。",
    "start": 50.61,
    "end": 53.656,
    "duration": 3.046
  },
  {
    "id": 10,
    "text": "第二，陷入主观抒情狂热与人物心理简单化的概念化弊端。",
    "start": 54.316,
    "end": 59.639,
    "duration": 5.323
  },
  {
    "id": 11,
    "text": "早期模式作品往往缺乏对中国社会复杂阶级关系的深入体察，",
    "start": 60.493,
    "end": 65.192,
    "duration": 4.699
  },
  {
    "id": 12,
    "text": "人物正邪分明、性格扁平，恋爱多沦为宣讲政治观念的载体，",
    "start": 65.765,
    "end": 70.706,
    "duration": 4.941
  },
  {
    "id": 13,
    "text": "革命斗争则被浪漫化为热血传奇，既难以深入剖析知识分子思想转变的阵痛，也回避了大革命退潮期的严峻考验。",
    "start": 71.243,
    "end": 80.246,
    "duration": 9.003
  },
  {
    "id": 14,
    "text": "第三，与稍后流行的“革命加恋爱”公式迥异，茅盾在《蚀》三部曲中摒弃廉价幻象，揭示退潮期知识分子的精神创伤。",
    "start": 80.854,
    "end": 90.297,
    "duration": 9.443
  },
  {
    "id": 15,
    "text": "茅盾拒绝空洞的乐观宣传，以《幻灭》《动摇》《追求》敏锐记录了动荡岁月中青年的精神困惑。",
    "start": 90.991,
    "end": 98.685,
    "duration": 7.694
  },
  {
    "id": 16,
    "text": "无论是静女士投身革命却遭投机分子玩弄后的幻灭、方罗兰在左右夹击中的优柔动摇，",
    "start": 99.185,
    "end": 105.929,
    "duration": 6.744
  },
  {
    "id": 17,
    "text": "还是章秋柳在政治苦闷中借放浪情欲麻痹自我的畸形追求，",
    "start": 106.279,
    "end": 111.39,
    "duration": 5.111
  },
  {
    "id": 18,
    "text": "茅盾均以冷静写实的笔触还原了历史低潮期生命的真实挣扎，",
    "start": 112.022,
    "end": 116.839,
    "duration": 4.817
  },
  {
    "id": 19,
    "text": "将这一题材提升至现代社会心理剖析的新高度。",
    "start": 117.315,
    "end": 121.134,
    "duration": 3.819
  }
]
