[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "赵树理·“山药蛋派”评书体创新与农民形象塑造",
    "start": 0.134,
    "end": 4.3,
    "duration": 4.166
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣“文艺大众化（赵树理方向）”三环节：1.结构用农民听得懂的“评书体 + 动作对话 + 顺口溜扣子”；",
    "start": 4.889,
    "end": 14.172,
    "duration": 9.283
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "2.写人不概念化——既塑小二黑小芹觉醒，又敢写二诸葛旧惯与村干部“小元”掌权蜕变；",
    "start": 14.381,
    "end": 22.722,
    "duration": 8.341
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "3.以晋东南乡俗直接开创当代“山药蛋派”。",
    "start": 23.049,
    "end": 27.227,
    "duration": 4.179
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "赵树理为解放区土生土长农民作家，代表文艺大众化“赵树理方向”与当代“山药蛋派”鼻祖，",
    "start": 27.801,
    "end": 34.962,
    "duration": 7.16
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "立足晋东南变革创现代小说新格局。",
    "start": 35.171,
    "end": 38.647,
    "duration": 3.476
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 改造章回说唱、立现代“评书体”形式",
    "start": 39.22,
    "end": 42.982,
    "duration": 3.762
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "着眼写给识字人看并念给不识字人听，扬弃章回俗套取说书连贯有头有尾技法；",
    "start": 43.556,
    "end": 51.745,
    "duration": 8.189
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《小二黑结婚》开篇直交代“刘家峧有两个神仙……”，动作口语替代冗长心理剖析，善设“扣子”穿插快板顺口溜。",
    "start": 52.332,
    "end": 62.579,
    "duration": 10.246
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 秉“问题小说”眼光、写复杂两代农民",
    "start": 63.166,
    "end": 67.162,
    "duration": 3.996
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "小二黑、小芹以法律反抗恶霸包办；亦敏锐捕捉二诸葛占卦、三仙姑装神之沉重旧观念惯性；",
    "start": 67.749,
    "end": 77.527,
    "duration": 9.778
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《李有才板话》借村干部“小元”当权架起胳膊耍威风蜕变，直揭权力腐蚀与改造艰难。",
    "start": 78.101,
    "end": 86.563,
    "duration": 8.463
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 融晋东南乡土民俗、奠基“山药蛋派”",
    "start": 87.15,
    "end": 91.173,
    "duration": 4.022
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "少写闲逸自然山水，专工婚丧、卜卦习俗与方言，以晋东南乡风承载严肃政策纠偏，统一政治倾向与写实真实；",
    "start": 91.746,
    "end": 103.295,
    "duration": 11.548
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "直接影响马烽、西戎等“山药蛋派”及十七年农村小说写作。",
    "start": 103.869,
    "end": 109.532,
    "duration": 5.663
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：四十年代代表作《小二黑结婚》（二诸葛/三仙姑/小二黑/小芹）与《李有才板话》（李有才/小元蜕变）；",
    "start": 110.119,
    "end": 120.118,
    "duration": 9.999
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "被称为“赵树理方向”，当代鼻祖级流派是“山药蛋派”（马烽、西戎）。",
    "start": 120.314,
    "end": 125.6,
    "duration": 5.285
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背全《小二黑结婚》《李有才板话》中六位关键农民/旧俗/干部人物名字与代表倾向？",
    "start": 126.174,
    "end": 134.923,
    "duration": 8.749
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 说明赵树理怎样通过“动作对话替心理剖析 + 扣子顺口溜”克服五四新文学“欧化”隔膜？",
    "start": 135.51,
    "end": 144.05,
    "duration": 8.541
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 阐明“赵树理方向”与当代“山药蛋派”在文艺大众化、民族化史上的地位？",
    "start": 144.637,
    "end": 151.824,
    "duration": 7.186
  }
]