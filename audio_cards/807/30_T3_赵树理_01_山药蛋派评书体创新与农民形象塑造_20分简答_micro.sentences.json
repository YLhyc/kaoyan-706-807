[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "赵树理·“山药蛋派”评书体创新与农民形象塑造",
    "start": 0.314,
    "end": 4.366,
    "duration": 4.052
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣“文艺大众化（赵树理方向）”三环节：1.结构用农民听得懂的“评书体 + 动作对话 + 顺口溜扣子”；",
    "start": 5.414,
    "end": 15.106,
    "duration": 9.692
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "2.写人不概念化——既塑小二黑小芹觉醒，又敢写二诸葛旧惯与村干部“小元”掌权蜕变；",
    "start": 16.034,
    "end": 24.446,
    "duration": 8.412
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "3.以晋东南乡俗直接开创当代“山药蛋派”。",
    "start": 25.414,
    "end": 29.506,
    "duration": 4.092
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "赵树理为解放区土生土长农民作家，代表文艺大众化“赵树理方向”与当代“山药蛋派”鼻祖，",
    "start": 30.474,
    "end": 37.606,
    "duration": 7.132
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "立足晋东南变革创现代小说新格局。",
    "start": 37.834,
    "end": 41.366,
    "duration": 3.532
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 改造章回说唱、立现代“评书体”形式",
    "start": 42.294,
    "end": 46.106,
    "duration": 3.812
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "着眼写给识字人看并念给不识字人听，扬弃章回俗套取说书连贯有头有尾技法；",
    "start": 47.114,
    "end": 55.566,
    "duration": 8.452
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《小二黑结婚》开篇直交代“刘家峧有两个神仙……”，动作口语替代冗长心理剖析，善设“扣子”穿插快板顺口溜。",
    "start": 56.614,
    "end": 68.026,
    "duration": 11.412
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 秉“问题小说”眼光、写复杂两代农民",
    "start": 69.034,
    "end": 72.686,
    "duration": 3.652
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "小二黑、小芹以法律反抗恶霸包办；亦敏锐捕捉二诸葛占卦、三仙姑装神之沉重旧观念惯性；",
    "start": 73.734,
    "end": 84.686,
    "duration": 10.952
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《李有才板话》借村干部“小元”当权架起胳膊耍威风蜕变，直揭权力腐蚀与改造艰难。",
    "start": 85.214,
    "end": 93.986,
    "duration": 8.772
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 融晋东南乡土民俗、奠基“山药蛋派”",
    "start": 94.636,
    "end": 98.768,
    "duration": 4.132
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "少写闲逸自然山水，专工婚丧、卜卦习俗与方言，以晋东南乡风承载严肃政策纠偏，统一政治倾向与写实真实；",
    "start": 99.516,
    "end": 110.808,
    "duration": 11.292
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "直接影响马烽、西戎等“山药蛋派”及十七年农村小说写作。",
    "start": 111.856,
    "end": 118.228,
    "duration": 6.372
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：四十年代代表作《小二黑结婚》（二诸葛/三仙姑/小二黑/小芹）与《李有才板话》（李有才/小元蜕变）；",
    "start": 119.236,
    "end": 129.248,
    "duration": 10.012
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "被称为“赵树理方向”，当代鼻祖级流派是“山药蛋派”（马烽、西戎）。",
    "start": 130.216,
    "end": 135.668,
    "duration": 5.452
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背全《小二黑结婚》《李有才板话》中六位关键农民/旧俗/干部人物名字与代表倾向？",
    "start": 136.716,
    "end": 145.248,
    "duration": 8.532
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 说明赵树理怎样通过“动作对话替心理剖析 + 扣子顺口溜”克服五四新文学“欧化”隔膜？",
    "start": 146.176,
    "end": 156.028,
    "duration": 9.852
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 阐明“赵树理方向”与当代“山药蛋派”在文艺大众化、民族化史上的地位？",
    "start": 157.036,
    "end": 164.488,
    "duration": 7.452
  }
]