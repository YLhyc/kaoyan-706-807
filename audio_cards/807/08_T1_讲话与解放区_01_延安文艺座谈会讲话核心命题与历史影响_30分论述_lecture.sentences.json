[
  {
    "id": 1,
    "text": "试论毛泽东《在延安文艺座谈会上的讲话》的核心命题体系与深远历史影响。",
    "start": 0.16,
    "end": 6.999,
    "duration": 6.839
  },
  {
    "id": 2,
    "text": "毛泽东发表的《在延安文艺座谈会上的讲话》，",
    "start": 6.999,
    "end": 11.295,
    "duration": 4.296
  },
  {
    "id": 3,
    "text": "是中国现代文学迈向当代一体化文学体制的划时代总枢纽。",
    "start": 11.295,
    "end": 16.614,
    "duration": 5.319
  },
  {
    "id": 4,
    "text": "作品在延安整风与抗日民族解放战争战时动员的双重历史语境下应运而生，",
    "start": 16.614,
    "end": 23.365,
    "duration": 6.751
  },
  {
    "id": 5,
    "text": "以马克思主义文论中国化的理论自觉，",
    "start": 23.365,
    "end": 26.842,
    "duration": 3.477
  },
  {
    "id": 6,
    "text": "系统破解了五四新文学长期困扰的“走向大众”的历史难题。",
    "start": 26.842,
    "end": 32.0,
    "duration": 5.158
  },
  {
    "id": 7,
    "text": "它以“文艺为工农兵”的政治决断实现了文学主体的根本历史易位，",
    "start": 32.0,
    "end": 37.92,
    "duration": 5.92
  },
  {
    "id": 8,
    "text": "重构了文学与政治、民间形式的血肉关联，",
    "start": 37.92,
    "end": 41.92,
    "duration": 4.0
  },
  {
    "id": 9,
    "text": "催生出具有鲜明“中国作风与中国气派”的解放区文艺范式，",
    "start": 41.92,
    "end": 47.28,
    "duration": 5.36
  },
  {
    "id": 10,
    "text": "奠定了当代中国一体化文学体制的基石。",
    "start": 47.28,
    "end": 50.8,
    "duration": 3.52
  },
  {
    "id": 11,
    "text": "其思想内涵与艺术成就主要体现在以下四个核心维度：",
    "start": 50.8,
    "end": 55.6,
    "duration": 4.8
  },
  {
    "id": 12,
    "text": "第一，直面战时历史痛点，",
    "start": 55.84,
    "end": 57.92,
    "duration": 2.08
  },
  {
    "id": 13,
    "text": "化解知识分子脱离群众与革命斗争的精神水土不服。",
    "start": 58.48,
    "end": 62.96,
    "duration": 4.48
  },
  {
    "id": 14,
    "text": "抗战爆发后，",
    "start": 62.96,
    "end": 63.84,
    "duration": 0.88
  },
  {
    "id": 15,
    "text": "大批受五四启蒙精神与三十年代左联思潮哺育的知识青年奔赴延安；",
    "start": 63.84,
    "end": 69.6,
    "duration": 5.76
  },
  {
    "id": 16,
    "text": "然而他们长期习惯于都市亭子间的生活情调与启蒙者的居高临下姿态，",
    "start": 69.6,
    "end": 75.76,
    "duration": 6.16
  },
  {
    "id": 17,
    "text": "面对陕北艰苦的农村战时环境与工农兵受众，",
    "start": 75.76,
    "end": 79.52,
    "duration": 3.76
  },
  {
    "id": 18,
    "text": "在思想观念与情感审美上发生了剧烈脱节。",
    "start": 79.6,
    "end": 83.12,
    "duration": 3.52
  },
  {
    "id": 19,
    "text": "王实味在《野百合花》中暴露延安阴暗面，",
    "start": 83.12,
    "end": 86.64,
    "duration": 3.52
  },
  {
    "id": 20,
    "text": "引发了关于革命文艺应当“暴露还是歌颂”的严峻论争；",
    "start": 86.64,
    "end": 91.2,
    "duration": 4.56
  },
  {
    "id": 21,
    "text": "《讲话》敏锐切中这一小资产阶级思想偏向，",
    "start": 91.2,
    "end": 94.88,
    "duration": 3.68
  },
  {
    "id": 22,
    "text": "严肃要求作家放下文化精英的架子，深入群众与火热斗争，",
    "start": 94.88,
    "end": 100.288,
    "duration": 5.408
  },
  {
    "id": 23,
    "text": "在生活实践与思想情感上完成向无产阶级立场的根本转变。",
    "start": 100.288,
    "end": 105.568,
    "duration": 5.28
  },
  {
    "id": 24,
    "text": "第二，建构系统完备的命题体系，",
    "start": 105.568,
    "end": 108.848,
    "duration": 3.28
  },
  {
    "id": 25,
    "text": "确立马克思主义文艺理论中国化的经典法则。",
    "start": 108.848,
    "end": 113.328,
    "duration": 4.48
  },
  {
    "id": 26,
    "text": "毛泽东提纲挈领地指出，文艺“为什么人的问题，",
    "start": 113.328,
    "end": 117.888,
    "duration": 4.56
  },
  {
    "id": 27,
    "text": "是一个根本的问题，原则的问题”，",
    "start": 117.888,
    "end": 121.088,
    "duration": 3.2
  },
  {
    "id": 28,
    "text": "旗帜鲜明地确立了“文艺为人民大众，",
    "start": 121.088,
    "end": 124.448,
    "duration": 3.36
  },
  {
    "id": 29,
    "text": "首先是为工农兵服务”的根本方向。",
    "start": 124.448,
    "end": 127.968,
    "duration": 3.52
  },
  {
    "id": 30,
    "text": "在文艺与政治的关系上，明确界定文艺从属于政治，",
    "start": 127.968,
    "end": 132.448,
    "duration": 4.48
  },
  {
    "id": 31,
    "text": "是整个革命机器中不可或缺的“齿轮和螺丝钉”；",
    "start": 132.448,
    "end": 137.008,
    "duration": 4.56
  },
  {
    "id": 32,
    "text": "在普及与提高的辩证关系上，",
    "start": 137.008,
    "end": 139.728,
    "duration": 2.72
  },
  {
    "id": 33,
    "text": "确立了在战时工农兵亟需启蒙的条件下“普及工作更为迫切”，",
    "start": 139.728,
    "end": 145.87,
    "duration": 6.142
  },
  {
    "id": 34,
    "text": "强调提高必须在普及的基础上沿着工农兵前进方向提高；",
    "start": 145.87,
    "end": 151.237,
    "duration": 5.367
  },
  {
    "id": 35,
    "text": "在批评标尺上，创立了“政治标准第一，",
    "start": 151.237,
    "end": 155.102,
    "duration": 3.865
  },
  {
    "id": 36,
    "text": "艺术标准第二”的双重评价体系；在创作源泉上，",
    "start": 155.102,
    "end": 159.825,
    "duration": 4.723
  },
  {
    "id": 37,
    "text": "科学阐明人民生活是文学的唯一源泉，",
    "start": 159.825,
    "end": 163.224,
    "duration": 3.399
  },
  {
    "id": 38,
    "text": "要求作品源于生活而又高于生活，",
    "start": 163.224,
    "end": 166.068,
    "duration": 2.844
  },
  {
    "id": 39,
    "text": "塑造具有时代普遍性的典型形象。",
    "start": 166.068,
    "end": 168.912,
    "duration": 2.844
  },
  {
    "id": 40,
    "text": "第三，荡涤早期欧化藩篱，",
    "start": 168.912,
    "end": 171.187,
    "duration": 2.275
  },
  {
    "id": 41,
    "text": "引领以民间形式为载体的解放区文艺范式重构。",
    "start": 171.187,
    "end": 175.168,
    "duration": 3.981
  },
  {
    "id": 42,
    "text": "《讲话》的指引使延安文艺彻底告别了欧化知识分子的书斋习气，",
    "start": 175.168,
    "end": 180.666,
    "duration": 5.498
  },
  {
    "id": 43,
    "text": "深植于丰厚的民间文化土壤之中。",
    "start": 180.666,
    "end": 183.51,
    "duration": 2.844
  },
  {
    "id": 44,
    "text": "新秧歌运动推陈出新，",
    "start": 183.51,
    "end": 185.406,
    "duration": 1.896
  },
  {
    "id": 45,
    "text": "以《兄妹开荒》创造了以旧民间形式装入新革命内容的典范；",
    "start": 185.406,
    "end": 190.848,
    "duration": 5.442
  },
  {
    "id": 46,
    "text": "赵树理彻底扎根农村生活与民间说唱艺术，",
    "start": 190.848,
    "end": 194.688,
    "duration": 3.84
  },
  {
    "id": 47,
    "text": "创作出《小二黑结婚》与《李有才板话》，",
    "start": 194.688,
    "end": 199.488,
    "duration": 4.8
  },
  {
    "id": 48,
    "text": "以地道的群众语言塑造了具有自尊人格的翻身农民典型，",
    "start": 199.488,
    "end": 204.528,
    "duration": 5.04
  },
  {
    "id": 49,
    "text": "被周扬誉为具有民族气派的“赵树理方向”；",
    "start": 204.768,
    "end": 208.984,
    "duration": 4.216
  },
  {
    "id": 50,
    "text": "新歌剧《白毛女》更将民间迷信的“白毛仙姑”传说去魅，",
    "start": 208.984,
    "end": 214.424,
    "duration": 5.44
  },
  {
    "id": 51,
    "text": "融合民歌板腔体与西洋管弦乐，提炼出“旧社会把人逼成鬼，",
    "start": 214.424,
    "end": 219.624,
    "duration": 5.2
  },
  {
    "id": 52,
    "text": "新社会把鬼变成人”的时代历史寓言，",
    "start": 219.624,
    "end": 222.824,
    "duration": 3.2
  },
  {
    "id": 53,
    "text": "实现了政治阶级意识形态与民间审美心理的完美统一。",
    "start": 222.824,
    "end": 227.624,
    "duration": 4.8
  },
  {
    "id": 54,
    "text": "第四，重构文学组织与权力形态，",
    "start": 227.624,
    "end": 230.824,
    "duration": 3.2
  },
  {
    "id": 55,
    "text": "成为当代十七年一体化机制的体制母本。",
    "start": 230.824,
    "end": 234.344,
    "duration": 3.52
  },
  {
    "id": 56,
    "text": "《讲话》从根本上终结了少数文化精英对文学话语的垄断，",
    "start": 234.344,
    "end": 239.624,
    "duration": 5.28
  },
  {
    "id": 57,
    "text": "确立了工农兵在文学表现与消费中的绝对主体地位，",
    "start": 239.624,
    "end": 244.264,
    "duration": 4.64
  },
  {
    "id": 58,
    "text": "赋予了文学前所未有的强大社会政治动员效能。",
    "start": 244.264,
    "end": 249.144,
    "duration": 4.88
  },
  {
    "id": 59,
    "text": "同时，它全面塑造了新中国建立后的文联作协体制、",
    "start": 249.144,
    "end": 253.544,
    "duration": 4.4
  },
  {
    "id": 60,
    "text": "集体写作与评判尺度，成为当代文学制度的核心规范；",
    "start": 253.544,
    "end": 258.264,
    "duration": 4.72
  },
  {
    "id": 61,
    "text": "它在极大地推动新文学走向大众化与民族化的同时，",
    "start": 258.264,
    "end": 264.264,
    "duration": 6.0
  },
  {
    "id": 62,
    "text": "也在后世的机械化执行中不同程度地带来了政治挂帅压抑艺术个性与题材窄化的历史局限。",
    "start": 264.264,
    "end": 266.744,
    "duration": 2.48
  },
  {
    "id": 63,
    "text": "综上所述，",
    "start": 266.504,
    "end": 266.744,
    "duration": 0.24
  },
  {
    "id": 64,
    "text": "毛泽东《在延安文艺座谈会上的讲话》是一座横跨现代与当代的理论丰碑。",
    "start": 266.504,
    "end": 266.744,
    "duration": 0.24
  },
  {
    "id": 65,
    "text": "它在历史转折关头系统重塑了中国文学的主体、功能、",
    "start": 266.504,
    "end": 266.744,
    "duration": 0.24
  },
  {
    "id": 66,
    "text": "美学与体制，",
    "start": 266.504,
    "end": 266.744,
    "duration": 0.24
  },
  {
    "id": 67,
    "text": "标志着中国文学从五四启蒙范式向当代人民文艺范式的深刻跃变。",
    "start": 266.504,
    "end": 266.744,
    "duration": 0.24
  }
]