[
  {
    "id": 1,
    "text": "一、全题宏观破题与总揽。",
    "start": 0.0,
    "end": 2.185,
    "duration": 2.185
  },
  {
    "id": 2,
    "text": "一、这一问到底在考什么？",
    "start": 2.185,
    "end": 4.37,
    "duration": 2.185
  },
  {
    "id": 3,
    "text": "本题考查毛泽东《在延安文艺座谈会上的讲话》的历史动因、",
    "start": 4.37,
    "end": 9.615,
    "duration": 5.245
  },
  {
    "id": 4,
    "text": "核心命题体系、解放区美学实践以及对现当代文学转型的深远影响。",
    "start": 9.615,
    "end": 15.733,
    "duration": 6.118
  },
  {
    "id": 5,
    "text": "考生必须讲清《讲话》如何解决“为什么人”和“如何为”的根本转向，",
    "start": 15.733,
    "end": 21.196,
    "duration": 5.463
  },
  {
    "id": 6,
    "text": "透视其当代体制源头地位。",
    "start": 21.196,
    "end": 23.6,
    "duration": 2.404
  },
  {
    "id": 7,
    "text": "二、答题的总方向是什么？",
    "start": 23.76,
    "end": 26.16,
    "duration": 2.4
  },
  {
    "id": 8,
    "text": "立足钱理群《中国现代文学三十年》第二十一章与朱栋霖教材下册第一章。",
    "start": 26.16,
    "end": 33.12,
    "duration": 6.96
  },
  {
    "id": 9,
    "text": "牢牢把握《讲话》作为“现代文学走向当代文学总枢纽”的核心定位。",
    "start": 33.12,
    "end": 38.64,
    "duration": 5.52
  },
  {
    "id": 10,
    "text": "讲透从五四精英启蒙走向工农兵大众化的历史必然，",
    "start": 38.64,
    "end": 43.2,
    "duration": 4.56
  },
  {
    "id": 11,
    "text": "兼顾其历史功绩与后世一体化体制关联。",
    "start": 43.2,
    "end": 46.32,
    "duration": 3.12
  },
  {
    "id": 12,
    "text": "三、分几个板块展开？",
    "start": 46.72,
    "end": 48.64,
    "duration": 1.92
  },
  {
    "id": 13,
    "text": "全篇严格按照四大经典板块层层推进：第一板块：历史语境与知识分子精神水土不服（延安整风、",
    "start": 48.64,
    "end": 56.96,
    "duration": 8.32
  },
  {
    "id": 14,
    "text": "战时动员、王实味野百合花与思想改造）。",
    "start": 56.96,
    "end": 60.48,
    "duration": 3.52
  },
  {
    "id": 15,
    "text": "第二板块：核心命题理论体系（为什么人工农兵方向、",
    "start": 60.48,
    "end": 65.12,
    "duration": 4.64
  },
  {
    "id": 16,
    "text": "齿轮螺丝钉、普及与提高、政治标准第一、",
    "start": 65.12,
    "end": 68.64,
    "duration": 3.52
  },
  {
    "id": 17,
    "text": "源于生活高于生活）。",
    "start": 68.64,
    "end": 70.32,
    "duration": 1.68
  },
  {
    "id": 18,
    "text": "第三板块：美学范式与解放区实践（克服欧化、",
    "start": 70.56,
    "end": 74.8,
    "duration": 4.24
  },
  {
    "id": 19,
    "text": "新秧歌运动兄妹开荒、赵树理方向、",
    "start": 74.8,
    "end": 77.68,
    "duration": 2.88
  },
  {
    "id": 20,
    "text": "新歌剧白毛女）。",
    "start": 77.68,
    "end": 78.96,
    "duration": 1.28
  },
  {
    "id": 21,
    "text": "第四板块：文学史流变与当代体制源头（工农兵主体地位确立、",
    "start": 78.96,
    "end": 84.32,
    "duration": 5.36
  },
  {
    "id": 22,
    "text": "当代一体化体制原型、历史双重评价）。",
    "start": 84.32,
    "end": 87.6,
    "duration": 3.28
  },
  {
    "id": 23,
    "text": "四、全篇内在逻辑链条是什么？",
    "start": 87.6,
    "end": 90.08,
    "duration": 2.48
  },
  {
    "id": 24,
    "text": "由转折总枢纽高度破题、趋近于、还原战时与整风的真实历史痛点（发生之由）趋近于、",
    "start": 90.24,
    "end": 97.489,
    "duration": 7.249
  },
  {
    "id": 25,
    "text": "构建严谨辩证的文论命题体系（理论之梁）趋近于、",
    "start": 97.489,
    "end": 101.654,
    "duration": 4.165
  },
  {
    "id": 26,
    "text": "展现由理论转化为现实的工农兵文艺实绩（实践之果）趋近于、",
    "start": 101.654,
    "end": 106.859,
    "duration": 5.205
  },
  {
    "id": 27,
    "text": "升华至对当代文学体制与格局的深远塑造（历史之流）。",
    "start": 106.859,
    "end": 111.44,
    "duration": 4.581
  },
  {
    "id": 28,
    "text": "逻辑链条环环紧扣。",
    "start": 111.52,
    "end": 113.68,
    "duration": 2.16
  },
  {
    "id": 29,
    "text": "--。二",
    "start": 113.68,
    "end": 113.84,
    "duration": 0.16
  },
  {
    "id": 30,
    "text": "、各板块逐句咬合推演。",
    "start": 114.24,
    "end": 116.72,
    "duration": 2.48
  },
  {
    "id": 31,
    "text": "（一）宏观定性与破题总起板块。",
    "start": 116.72,
    "end": 120.0,
    "duration": 3.28
  },
  {
    "id": 32,
    "text": "破题推演逻辑：开头必须高屋建瓴。",
    "start": 120.0,
    "end": 123.52,
    "duration": 3.52
  },
  {
    "id": 33,
    "text": "界定《讲话》作为现代文学走向当代文学总枢纽的崇高地位，",
    "start": 123.52,
    "end": 128.72,
    "duration": 5.2
  },
  {
    "id": 34,
    "text": "交代延安整风与战时动员的特殊时代语境。",
    "start": 128.72,
    "end": 132.16,
    "duration": 3.44
  },
  {
    "id": 35,
    "text": "指出其以“文艺为工农兵”实现的主体根本易位，",
    "start": 132.4,
    "end": 136.56,
    "duration": 4.16
  },
  {
    "id": 36,
    "text": "最后概括命题体系、美学实践与体制源头，",
    "start": 136.56,
    "end": 140.32,
    "duration": 3.76
  },
  {
    "id": 37,
    "text": "引出分述。",
    "start": 140.32,
    "end": 141.04,
    "duration": 0.72
  },
  {
    "id": 38,
    "text": "-逐句咬合推导：具体表述到答题语句就是：毛泽东的《在延安文艺座谈会上的讲话》是中国现代文学迈向当代十七年文学的总枢纽与定音锤。，",
    "start": 141.264,
    "end": 152.664,
    "duration": 11.4
  },
  {
    "id": 39,
    "text": "这是对考察对象的历史最高定性。",
    "start": 152.664,
    "end": 155.464,
    "duration": 2.8
  },
  {
    "id": 40,
    "text": "紧接着指出其历史生成的特殊土壤，",
    "start": 155.464,
    "end": 158.464,
    "duration": 3.0
  },
  {
    "id": 41,
    "text": "具体表述到答题语句就是：它在延安整风与战时动员的双重历史语境下应运而生。。",
    "start": 158.464,
    "end": 165.264,
    "duration": 6.8
  },
  {
    "id": 42,
    "text": "随后说明其解决中国新文学长期历史困境的理论自觉，",
    "start": 165.424,
    "end": 170.224,
    "duration": 4.8
  },
  {
    "id": 43,
    "text": "具体表述到答题语句就是：它以马克思主义文论中国化的理论自觉，",
    "start": 170.224,
    "end": 175.967,
    "duration": 5.743
  },
  {
    "id": 44,
    "text": "系统解决了新文学长期困扰的走向大众难题。。",
    "start": 175.967,
    "end": 179.783,
    "duration": 3.816
  },
  {
    "id": 45,
    "text": "紧接着指出其核心方向与主体转变，",
    "start": 179.783,
    "end": 182.796,
    "duration": 3.013
  },
  {
    "id": 46,
    "text": "具体表述到答题语句就是：它以“文艺为工农兵”实现了文学主体的根本历史易位。。",
    "start": 182.796,
    "end": 189.424,
    "duration": 6.628
  },
  {
    "id": 47,
    "text": "最后落到打破精英模式与奠定当代体制的综合高度，",
    "start": 189.504,
    "end": 194.384,
    "duration": 4.88
  },
  {
    "id": 48,
    "text": "具体表述到答题语句就是：它打破了五四以来知识分子的精英启蒙模式，",
    "start": 194.384,
    "end": 200.544,
    "duration": 6.16
  },
  {
    "id": 49,
    "text": "重构了文学与政治、民间形式的深层关联，",
    "start": 200.544,
    "end": 204.464,
    "duration": 3.92
  },
  {
    "id": 50,
    "text": "催生了全新的工农兵文艺范式，奠定了当代中国一体化文学体制的核心原型。。",
    "start": 204.464,
    "end": 210.624,
    "duration": 6.16
  },
  {
    "id": 51,
    "text": "毛泽东的《在延安文艺座谈会上的讲话》是中国现代文学迈向当代十七年文学的总枢纽与定音锤。",
    "start": 210.944,
    "end": 218.944,
    "duration": 8.0
  },
  {
    "id": 52,
    "text": "它在延安整风与战时动员的双重历史语境下应运而生。",
    "start": 218.944,
    "end": 223.424,
    "duration": 4.48
  },
  {
    "id": 53,
    "text": "它以马克思主义文论中国化的理论自觉，",
    "start": 223.424,
    "end": 226.464,
    "duration": 3.04
  },
  {
    "id": 54,
    "text": "系统解决了新文学长期困扰的走向大众难题。",
    "start": 226.464,
    "end": 229.984,
    "duration": 3.52
  },
  {
    "id": 55,
    "text": "它以“文艺为工农兵”实现了文学主体的根本历史易位。",
    "start": 230.224,
    "end": 234.624,
    "duration": 4.4
  },
  {
    "id": 56,
    "text": "它打破了五四以来知识分子的精英启蒙模式，",
    "start": 234.624,
    "end": 238.064,
    "duration": 3.44
  },
  {
    "id": 57,
    "text": "重构了文学与政治、民间形式的深层关联，",
    "start": 238.064,
    "end": 241.744,
    "duration": 3.68
  },
  {
    "id": 58,
    "text": "催生了全新的工农兵文艺范式，奠定了当代中国一体化文学体制的核心原型。--。",
    "start": 241.744,
    "end": 247.744,
    "duration": 6.0
  },
  {
    "id": 59,
    "text": "（二）第一板块：历史语境与知识分子精神水土不服的化解。",
    "start": 247.984,
    "end": 252.605,
    "duration": 4.621
  },
  {
    "id": 60,
    "text": "论证推演逻辑：讲透《讲话》的发生，",
    "start": 252.605,
    "end": 255.217,
    "duration": 2.612
  },
  {
    "id": 61,
    "text": "绝不能脱离具体的历史困境。",
    "start": 255.217,
    "end": 257.628,
    "duration": 2.411
  },
  {
    "id": 62,
    "text": "首先还原知识青年奔赴延安的真实心态：受五四启蒙与左联影响，",
    "start": 257.628,
    "end": 263.053,
    "duration": 5.425
  },
  {
    "id": 63,
    "text": "习惯都市咖啡馆与冷嘲杂文，面对陕北农村残酷战时环境与工农兵受众，",
    "start": 263.053,
    "end": 269.081,
    "duration": 6.028
  },
  {
    "id": 64,
    "text": "产生审美与政治脱节，引入王实味《野百合花》暴露与歌颂之争这一标志性事件，",
    "start": 269.081,
    "end": 275.51,
    "duration": 6.429
  },
  {
    "id": 65,
    "text": "说明《讲话》要求知识分子放下精英架子、",
    "start": 275.51,
    "end": 278.725,
    "duration": 3.215
  },
  {
    "id": 66,
    "text": "完成思想改造与立场转移的迫切性。",
    "start": 278.725,
    "end": 281.738,
    "duration": 3.013
  },
  {
    "id": 67,
    "text": "逐句咬合推导：具体表述到答题语句就是：首先，",
    "start": 281.738,
    "end": 286.128,
    "duration": 4.39
  },
  {
    "id": 68,
    "text": "在历史因缘上，《讲话》深刻化解了知识分子奔赴革命圣地后的精神水土不服。，",
    "start": 286.128,
    "end": 292.928,
    "duration": 6.8
  },
  {
    "id": 69,
    "text": "这是第一分论点的核心立桩。",
    "start": 292.928,
    "end": 295.408,
    "duration": 2.48
  },
  {
    "id": 70,
    "text": "紧接着交代奔赴延安文人的思想背景，",
    "start": 295.408,
    "end": 298.608,
    "duration": 3.2
  },
  {
    "id": 71,
    "text": "具体表述到答题语句就是：抗战爆发后，",
    "start": 298.608,
    "end": 302.208,
    "duration": 3.6
  },
  {
    "id": 72,
    "text": "大批受五四精神与三十年代左联思潮哺育的知识青年涌入延安。。",
    "start": 302.208,
    "end": 307.728,
    "duration": 5.52
  },
  {
    "id": 73,
    "text": "随后描述其原有的生活情调与写作习惯，",
    "start": 308.048,
    "end": 311.648,
    "duration": 3.6
  },
  {
    "id": 74,
    "text": "具体表述到答题语句就是：他们习惯于都市亭子间的生活情调与启蒙者的居高临下姿态，",
    "start": 311.648,
    "end": 319.552,
    "duration": 7.904
  },
  {
    "id": 75,
    "text": "习惯用浪漫感伤或冷嘲杂文解剖社会。。",
    "start": 319.552,
    "end": 322.958,
    "duration": 3.406
  },
  {
    "id": 76,
    "text": "紧接着指出文人习惯与战时环境的剧烈脱节，",
    "start": 322.958,
    "end": 327.003,
    "duration": 4.045
  },
  {
    "id": 77,
    "text": "具体表述到答题语句就是：面对战时极端匮乏的物质条件与工农兵全新受众，",
    "start": 327.003,
    "end": 333.816,
    "duration": 6.813
  },
  {
    "id": 78,
    "text": "文人观念与革命战争需求发生了剧烈脱节。。",
    "start": 333.816,
    "end": 337.648,
    "duration": 3.832
  },
  {
    "id": 79,
    "text": "随后切入王实味事件与暴露歌颂论争，",
    "start": 337.808,
    "end": 340.928,
    "duration": 3.12
  },
  {
    "id": 80,
    "text": "具体表述到答题语句就是：王实味在《野百合花》中暴露延安阴暗面，",
    "start": 340.928,
    "end": 346.013,
    "duration": 5.085
  },
  {
    "id": 81,
    "text": "引发了关于暴露与歌颂的严峻论争。。",
    "start": 346.013,
    "end": 348.854,
    "duration": 2.841
  },
  {
    "id": 82,
    "text": "最后落到《讲话》对思想改造与立场转移的要求，",
    "start": 348.854,
    "end": 352.453,
    "duration": 3.599
  },
  {
    "id": 83,
    "text": "具体表述到答题语句就是：《讲话》正是针对这一小资产阶级思想偏向，",
    "start": 352.453,
    "end": 357.756,
    "duration": 5.303
  },
  {
    "id": 84,
    "text": "要求作家放下文化精英的架子，深入群众与火热斗争，",
    "start": 357.756,
    "end": 361.923,
    "duration": 4.167
  },
  {
    "id": 85,
    "text": "完成从资产阶级小资产阶级立场向无产阶级立场的根本转变。。",
    "start": 361.923,
    "end": 366.848,
    "duration": 4.925
  },
  {
    "id": 86,
    "text": "首先，在历史因缘上，《讲话》深刻化解了知识分子奔赴革命圣地后的精神水土不服。",
    "start": 367.008,
    "end": 374.128,
    "duration": 7.12
  },
  {
    "id": 87,
    "text": "抗战爆发后，大批受五四精神与三十年代左联思潮哺育的知识青年涌入延安。",
    "start": 374.128,
    "end": 381.008,
    "duration": 6.88
  },
  {
    "id": 88,
    "text": "他们习惯于都市亭子间的生活情调与启蒙者的居高临下姿态，",
    "start": 381.008,
    "end": 386.048,
    "duration": 5.04
  },
  {
    "id": 89,
    "text": "习惯用浪漫感伤或冷嘲杂文解剖社会。",
    "start": 386.048,
    "end": 389.248,
    "duration": 3.2
  },
  {
    "id": 90,
    "text": "面对战时极端匮乏的物质条件与工农兵全新受众，",
    "start": 389.488,
    "end": 393.728,
    "duration": 4.24
  },
  {
    "id": 91,
    "text": "文人观念与革命战争需求发生了剧烈脱节。",
    "start": 393.728,
    "end": 397.408,
    "duration": 3.68
  },
  {
    "id": 92,
    "text": "王实味在《野百合花》中暴露延安阴暗面，",
    "start": 397.408,
    "end": 400.768,
    "duration": 3.36
  },
  {
    "id": 93,
    "text": "引发了关于暴露与歌颂的严峻论争。",
    "start": 400.768,
    "end": 403.808,
    "duration": 3.04
  },
  {
    "id": 94,
    "text": "《讲话》正是针对这一小资产阶级思想偏向，",
    "start": 403.808,
    "end": 407.088,
    "duration": 3.28
  },
  {
    "id": 95,
    "text": "要求作家放下文化精英的架子，深入群众与火热斗争，",
    "start": 407.088,
    "end": 411.888,
    "duration": 4.8
  },
  {
    "id": 96,
    "text": "完成从资产阶级小资产阶级立场向无产阶级立场的根本转变。",
    "start": 411.888,
    "end": 416.848,
    "duration": 4.96
  },
  {
    "id": 97,
    "text": "---。（三",
    "start": 417.008,
    "end": 417.271,
    "duration": 0.263
  },
  {
    "id": 98,
    "text": "）第二板块：核心理论命题系统建构。",
    "start": 417.271,
    "end": 420.951,
    "duration": 3.68
  },
  {
    "id": 99,
    "text": "论证推演逻辑：必须条理清晰地展开五大核心命题：第一，",
    "start": 420.951,
    "end": 426.352,
    "duration": 5.401
  },
  {
    "id": 100,
    "text": "方向命题（文艺为人民大众首先为工农兵），",
    "start": 426.352,
    "end": 429.472,
    "duration": 3.12
  },
  {
    "id": 101,
    "text": "第二，关系命题（文艺从属于政治的齿轮螺丝钉），",
    "start": 429.472,
    "end": 433.072,
    "duration": 3.6
  },
  {
    "id": 102,
    "text": "第三，普及与提高辩证法（普及第一、",
    "start": 433.072,
    "end": 436.032,
    "duration": 2.96
  },
  {
    "id": 103,
    "text": "在工农兵前进方向上提高），第四，",
    "start": 436.032,
    "end": 438.512,
    "duration": 2.48
  },
  {
    "id": 104,
    "text": "批评标尺（政治标准第一、艺术标准第二），",
    "start": 438.512,
    "end": 441.392,
    "duration": 2.88
  },
  {
    "id": 105,
    "text": "第五，源泉与典型化（生活是唯一源泉、",
    "start": 441.392,
    "end": 444.432,
    "duration": 3.04
  },
  {
    "id": 106,
    "text": "源于生活高于生活）。",
    "start": 444.432,
    "end": 445.792,
    "duration": 1.36
  },
  {
    "id": 107,
    "text": "层层严谨，绝不漏点。",
    "start": 446.192,
    "end": 448.112,
    "duration": 1.92
  },
  {
    "id": 108,
    "text": "逐句咬合推导：具体表述到答题语句就是：其次，",
    "start": 448.112,
    "end": 452.048,
    "duration": 3.936
  },
  {
    "id": 109,
    "text": "在理论建构上，《讲话》提出了一整套严密辩证的马克思主义文艺命题体系。，",
    "start": 452.048,
    "end": 458.2,
    "duration": 6.152
  },
  {
    "id": 110,
    "text": "这是第二分论点的提纲窃领。",
    "start": 458.2,
    "end": 460.661,
    "duration": 2.461
  },
  {
    "id": 111,
    "text": "紧接着阐述最核心的“为什么人”方向命题，",
    "start": 460.661,
    "end": 464.147,
    "duration": 3.486
  },
  {
    "id": 112,
    "text": "具体表述到答题语句就是：毛泽东深刻指出文艺为什么人的问题是一个根本的问题与原则的问题，",
    "start": 464.147,
    "end": 472.555,
    "duration": 8.408
  },
  {
    "id": 113,
    "text": "旗帜鲜明地确立了“文艺为人民大众，",
    "start": 472.555,
    "end": 475.631,
    "duration": 3.076
  },
  {
    "id": 114,
    "text": "首先是为工农兵服务”的根本政治方向。。",
    "start": 475.631,
    "end": 478.912,
    "duration": 3.281
  },
  {
    "id": 115,
    "text": "随后阐述文学与政治的从属关系，具体表述到答题语句就是：在文艺与政治的关系上，",
    "start": 479.072,
    "end": 486.008,
    "duration": 6.936
  },
  {
    "id": 116,
    "text": "明确界定文艺从属于政治，是整个革命机器中不可或缺的齿轮和螺丝钉。。",
    "start": 486.008,
    "end": 492.092,
    "duration": 6.084
  },
  {
    "id": 117,
    "text": "紧接着阐述普及与提高的辩证路线，",
    "start": 492.092,
    "end": 495.133,
    "duration": 3.041
  },
  {
    "id": 118,
    "text": "具体表述到答题语句就是：在普及与提高的辩证法上，",
    "start": 495.133,
    "end": 499.595,
    "duration": 4.462
  },
  {
    "id": 119,
    "text": "确立了在战时条件下普及工作更为迫切，",
    "start": 499.595,
    "end": 503.042,
    "duration": 3.447
  },
  {
    "id": 120,
    "text": "提高必须在普及的基础上沿着工农兵前进方向提高的路线。。",
    "start": 503.042,
    "end": 508.112,
    "duration": 5.07
  },
  {
    "id": 121,
    "text": "随后阐述批评标尺的政治与艺术统一，",
    "start": 508.272,
    "end": 511.232,
    "duration": 2.96
  },
  {
    "id": 122,
    "text": "具体表述到答题语句就是：在批评标尺上，",
    "start": 511.232,
    "end": 514.478,
    "duration": 3.246
  },
  {
    "id": 123,
    "text": "创立了“政治标准第一，艺术标准第二”的评价体系，",
    "start": 514.478,
    "end": 518.428,
    "duration": 3.95
  },
  {
    "id": 124,
    "text": "追求革命的政治内容与尽可能完美的艺术形式的统一。。",
    "start": 518.428,
    "end": 522.972,
    "duration": 4.544
  },
  {
    "id": 125,
    "text": "最后阐述源于生活高于生活的典型化理论，",
    "start": 522.972,
    "end": 526.527,
    "duration": 3.555
  },
  {
    "id": 126,
    "text": "具体表述到答题语句就是：在创作源泉上，",
    "start": 526.527,
    "end": 529.886,
    "duration": 3.359
  },
  {
    "id": 127,
    "text": "阐明生活是文学的唯一源泉，文学必须源于生活而又高于生活，",
    "start": 529.886,
    "end": 535.022,
    "duration": 5.136
  },
  {
    "id": 128,
    "text": "塑造具有普遍性的典型形象。。",
    "start": 535.022,
    "end": 537.392,
    "duration": 2.37
  },
  {
    "id": 129,
    "text": "其次，在理论建构上，《讲话》提出了一整套严密辩证的马克思主义文艺命题体系。",
    "start": 537.536,
    "end": 543.776,
    "duration": 6.24
  },
  {
    "id": 130,
    "text": "毛泽东深刻指出文艺为什么人的问题是一个根本的问题与原则的问题，",
    "start": 543.776,
    "end": 549.216,
    "duration": 5.44
  },
  {
    "id": 131,
    "text": "旗帜鲜明地确立了“文艺为人民大众，",
    "start": 549.216,
    "end": 552.176,
    "duration": 2.96
  },
  {
    "id": 132,
    "text": "首先是为工农兵服务”的根本政治方向。",
    "start": 552.176,
    "end": 554.976,
    "duration": 2.8
  },
  {
    "id": 133,
    "text": "在文艺与政治的关系上，明确界定文艺从属于政治，",
    "start": 555.296,
    "end": 559.216,
    "duration": 3.92
  },
  {
    "id": 134,
    "text": "是整个革命机器中不可或缺的齿轮和螺丝钉。",
    "start": 559.216,
    "end": 562.656,
    "duration": 3.44
  },
  {
    "id": 135,
    "text": "在普及与提高的辩证法上，确立了在战时条件下普及工作更为迫切，",
    "start": 562.656,
    "end": 568.016,
    "duration": 5.36
  },
  {
    "id": 136,
    "text": "提高必须在普及的基础上沿着工农兵前进方向提高的路线。",
    "start": 568.016,
    "end": 572.576,
    "duration": 4.56
  },
  {
    "id": 137,
    "text": "在批评标尺上，创立了“政治标准第一，",
    "start": 572.576,
    "end": 575.536,
    "duration": 2.96
  },
  {
    "id": 138,
    "text": "艺术标准第二”的评价体系，追求革命的政治内容与尽可能完美的艺术形式的统一。",
    "start": 575.536,
    "end": 581.376,
    "duration": 5.84
  },
  {
    "id": 139,
    "text": "在创作源泉上，阐明生活是文学的唯一源泉，",
    "start": 581.696,
    "end": 585.536,
    "duration": 3.84
  },
  {
    "id": 140,
    "text": "文学必须源于生活而又高于生活，塑造具有普遍性的典型形象。",
    "start": 585.536,
    "end": 590.816,
    "duration": 5.28
  },
  {
    "id": 141,
    "text": "--。（",
    "start": 590.816,
    "end": 591.136,
    "duration": 0.32
  },
  {
    "id": 142,
    "text": "四）第三板块：美学范式重构与解放区文艺实践。",
    "start": 591.136,
    "end": 595.616,
    "duration": 4.48
  },
  {
    "id": 143,
    "text": "论证推演逻辑：理论必须以创作实绩作为验证。",
    "start": 595.616,
    "end": 599.456,
    "duration": 3.84
  },
  {
    "id": 144,
    "text": "阐明《讲话》克服五四新文学长期存在的欧化与精英偏向，",
    "start": 599.456,
    "end": 604.256,
    "duration": 4.8
  },
  {
    "id": 145,
    "text": "激活民间传统。",
    "start": 604.256,
    "end": 605.456,
    "duration": 1.2
  },
  {
    "id": 146,
    "text": "列举三大实证支柱：一是新秧歌运动《兄妹开荒》的破冰，",
    "start": 605.696,
    "end": 610.896,
    "duration": 5.2
  },
  {
    "id": 147,
    "text": "二是“赵树理方向”的小说《小二黑结婚》与《李有才板话》，",
    "start": 610.896,
    "end": 615.536,
    "duration": 4.64
  },
  {
    "id": 148,
    "text": "创造质朴晓畅的中国作风，三是新歌剧《白毛女》将迷信传说去魅，",
    "start": 615.536,
    "end": 621.376,
    "duration": 5.84
  },
  {
    "id": 149,
    "text": "熔板腔体与交响合唱于一炉，提炼出“旧社会把人逼成鬼，",
    "start": 621.376,
    "end": 627.216,
    "duration": 5.84
  },
  {
    "id": 150,
    "text": "新社会把鬼变成人”的历史寓言。",
    "start": 627.216,
    "end": 630.496,
    "duration": 3.28
  },
  {
    "id": 151,
    "text": "-逐句咬合推导：具体表述到答题语句就是：第三，",
    "start": 630.816,
    "end": 634.778,
    "duration": 3.962
  },
  {
    "id": 152,
    "text": "在美学实践上，《讲话》引领了解放区文艺范式的重构，",
    "start": 634.778,
    "end": 639.156,
    "duration": 4.378
  },
  {
    "id": 153,
    "text": "催生了鲜明的中国作风与中国气派。，",
    "start": 639.156,
    "end": 642.284,
    "duration": 3.128
  },
  {
    "id": 154,
    "text": "这是第三分论点的观点立桩。",
    "start": 642.284,
    "end": 644.786,
    "duration": 2.502
  },
  {
    "id": 155,
    "text": "紧接着指出其克服欧化、面向民间的转变，",
    "start": 644.786,
    "end": 648.33,
    "duration": 3.544
  },
  {
    "id": 156,
    "text": "具体表述到答题语句就是：延安文艺彻底荡涤了新文学长期的欧化倾向，",
    "start": 648.33,
    "end": 654.585,
    "duration": 6.255
  },
  {
    "id": 157,
    "text": "转向民间汲取丰沛的民族养分。。",
    "start": 654.585,
    "end": 657.296,
    "duration": 2.711
  },
  {
    "id": 158,
    "text": "随后引入新秧歌运动的破冰实证，具体表述到答题语句就是：新秧歌运动推陈出新，",
    "start": 657.456,
    "end": 664.496,
    "duration": 7.04
  },
  {
    "id": 159,
    "text": "以《兄妹开荒》开创了以旧民间形式装入新革命内容的先声。。",
    "start": 664.496,
    "end": 669.376,
    "duration": 4.88
  },
  {
    "id": 160,
    "text": "紧接着引入“赵树理方向”的小说实证，",
    "start": 669.68,
    "end": 672.64,
    "duration": 2.96
  },
  {
    "id": 161,
    "text": "具体表述到答题语句就是：赵树理彻底扎根农村生活与民间说唱艺术，",
    "start": 672.64,
    "end": 678.88,
    "duration": 6.24
  },
  {
    "id": 162,
    "text": "创作了《小二黑结婚》与《李有才板话》，",
    "start": 678.88,
    "end": 682.24,
    "duration": 3.36
  },
  {
    "id": 163,
    "text": "塑造了翻身农民的自尊人格，确立了质朴晓畅的“赵树理方向”。。",
    "start": 682.24,
    "end": 687.2,
    "duration": 4.96
  },
  {
    "id": 164,
    "text": "最后深入剖析新歌剧《白毛女》的经典机制，",
    "start": 687.44,
    "end": 690.96,
    "duration": 3.52
  },
  {
    "id": 165,
    "text": "具体表述到答题语句就是：新歌剧《白毛女》更将迷信灵异传说去魅，",
    "start": 690.96,
    "end": 696.8,
    "duration": 5.84
  },
  {
    "id": 166,
    "text": "以板腔体与西洋交响合唱相融合，提炼出“旧社会把人逼成鬼，",
    "start": 696.8,
    "end": 702.72,
    "duration": 5.92
  },
  {
    "id": 167,
    "text": "新社会把鬼变成人”的阶级压迫历史寓言，",
    "start": 702.72,
    "end": 706.32,
    "duration": 3.6
  },
  {
    "id": 168,
    "text": "实现了政治意识形态与民间大团圆审美的完美统一。。",
    "start": 706.32,
    "end": 710.4,
    "duration": 4.08
  },
  {
    "id": 169,
    "text": "第三，在美学实践上，《讲话》引领了解放区文艺范式的重构，",
    "start": 710.64,
    "end": 716.24,
    "duration": 5.6
  },
  {
    "id": 170,
    "text": "催生了鲜明的中国作风与中国气派。",
    "start": 716.24,
    "end": 719.2,
    "duration": 2.96
  },
  {
    "id": 171,
    "text": "延安文艺彻底荡涤了新文学长期的欧化倾向，",
    "start": 719.2,
    "end": 723.12,
    "duration": 3.92
  },
  {
    "id": 172,
    "text": "转向民间汲取丰沛的民族养分。",
    "start": 723.12,
    "end": 725.92,
    "duration": 2.8
  },
  {
    "id": 173,
    "text": "新秧歌运动推陈出新，以《兄妹开荒》开创了以旧民间形式装入新革命内容的先声。",
    "start": 725.92,
    "end": 732.48,
    "duration": 6.56
  },
  {
    "id": 174,
    "text": "赵树理彻底扎根农村生活与民间说唱艺术，",
    "start": 732.8,
    "end": 736.24,
    "duration": 3.44
  },
  {
    "id": 175,
    "text": "创作了《小二黑结婚》与《李有才板话》，",
    "start": 736.24,
    "end": 739.12,
    "duration": 2.88
  },
  {
    "id": 176,
    "text": "塑造了翻身农民的自尊人格，确立了质朴晓畅的“赵树理方向”。",
    "start": 739.12,
    "end": 744.0,
    "duration": 4.88
  },
  {
    "id": 177,
    "text": "新歌剧《白毛女》更将迷信灵异传说去魅，",
    "start": 744.0,
    "end": 746.96,
    "duration": 2.96
  },
  {
    "id": 178,
    "text": "以板腔体与西洋交响合唱相融合，提炼出“旧社会把人逼成鬼，",
    "start": 746.96,
    "end": 752.16,
    "duration": 5.2
  },
  {
    "id": 179,
    "text": "新社会把鬼变成人”的阶级压迫历史寓言，",
    "start": 752.16,
    "end": 755.28,
    "duration": 3.12
  },
  {
    "id": 180,
    "text": "实现了政治意识形态与民间大团圆审美的完美统一。",
    "start": 755.28,
    "end": 759.04,
    "duration": 3.76
  },
  {
    "id": 181,
    "text": "（五）第四板块：文学史深远影响与当代体制源头。",
    "start": 759.28,
    "end": 763.127,
    "duration": 3.847
  },
  {
    "id": 182,
    "text": "论证推演逻辑：必须给出客观公正的文学史评价。",
    "start": 763.127,
    "end": 767.176,
    "duration": 4.049
  },
  {
    "id": 183,
    "text": "一方面肯定其历史功绩：打破精英垄断，",
    "start": 767.176,
    "end": 770.415,
    "duration": 3.239
  },
  {
    "id": 184,
    "text": "确立工农兵主体地位，赋予文学强大社会动员力，",
    "start": 770.415,
    "end": 774.465,
    "duration": 4.05
  },
  {
    "id": 185,
    "text": "另一方面指出其作为一九四九年后当代文联作协体制、",
    "start": 774.465,
    "end": 779.121,
    "duration": 4.656
  },
  {
    "id": 186,
    "text": "全国思想批判运动的原型，以及后世教条化理解带来的题材风格单一化局限。",
    "start": 779.121,
    "end": 785.6,
    "duration": 6.479
  },
  {
    "id": 187,
    "text": "-逐句咬合推导：具体表述到答题语句就是：最后，",
    "start": 785.6,
    "end": 789.273,
    "duration": 3.673
  },
  {
    "id": 188,
    "text": "在文学史流变上，《讲话》深刻重构了中国文学的组织形态，",
    "start": 789.273,
    "end": 793.72,
    "duration": 4.447
  },
  {
    "id": 189,
    "text": "构成了当代十七年一体化机制的真正源头。，",
    "start": 793.72,
    "end": 797.2,
    "duration": 3.48
  },
  {
    "id": 190,
    "text": "这是第四分论点的核心观点。",
    "start": 797.2,
    "end": 799.52,
    "duration": 2.32
  },
  {
    "id": 191,
    "text": "紧接着总结其确立人民主体地位与动员效能的伟大功绩，",
    "start": 799.664,
    "end": 804.544,
    "duration": 4.88
  },
  {
    "id": 192,
    "text": "具体表述到答题语句就是：它终结了少数文化精英对文学的垄断，",
    "start": 804.544,
    "end": 810.102,
    "duration": 5.558
  },
  {
    "id": 193,
    "text": "确立了工农兵在文学中的主人翁地位，",
    "start": 810.102,
    "end": 813.434,
    "duration": 3.332
  },
  {
    "id": 194,
    "text": "赋予了文学前所未有的强大社会动员效能。。",
    "start": 813.434,
    "end": 817.183,
    "duration": 3.749
  },
  {
    "id": 195,
    "text": "随后指出其全面建构当代文学制度原型的历史事实，",
    "start": 817.183,
    "end": 821.764,
    "duration": 4.581
  },
  {
    "id": 196,
    "text": "具体表述到答题语句就是：同时，《讲话》全面塑造了新中国建立后的文联作协体制、",
    "start": 821.764,
    "end": 828.637,
    "duration": 6.873
  },
  {
    "id": 197,
    "text": "稿件审查机制与文艺评价尺度。。",
    "start": 828.637,
    "end": 831.344,
    "duration": 2.707
  },
  {
    "id": 198,
    "text": "最后客观指出后世教条化带来的历史局限，",
    "start": 831.424,
    "end": 834.944,
    "duration": 3.52
  },
  {
    "id": 199,
    "text": "具体表述到答题语句就是：它在推动文艺大众化与民族化的同时，",
    "start": 834.944,
    "end": 839.904,
    "duration": 4.96
  },
  {
    "id": 200,
    "text": "也因后世对政治标准的绝对化理解，",
    "start": 839.904,
    "end": 842.704,
    "duration": 2.8
  },
  {
    "id": 201,
    "text": "在一定程度上带来了题材单一与个性受限的局限。。",
    "start": 842.704,
    "end": 846.864,
    "duration": 4.16
  },
  {
    "id": 202,
    "text": "最后，在文学史流变上，《讲话》深刻重构了中国文学的组织形态，",
    "start": 846.864,
    "end": 851.824,
    "duration": 4.96
  },
  {
    "id": 203,
    "text": "构成了当代十七年一体化机制的真正源头。",
    "start": 851.824,
    "end": 854.944,
    "duration": 3.12
  },
  {
    "id": 204,
    "text": "它终结了少数文化精英对文学的垄断，",
    "start": 855.184,
    "end": 858.224,
    "duration": 3.04
  },
  {
    "id": 205,
    "text": "确立了工农兵在文学中的主人翁地位，",
    "start": 858.224,
    "end": 861.424,
    "duration": 3.2
  },
  {
    "id": 206,
    "text": "赋予了文学前所未有的强大社会动员效能。",
    "start": 861.424,
    "end": 865.104,
    "duration": 3.68
  },
  {
    "id": 207,
    "text": "同时，《讲话》全面塑造了新中国建立后的文联作协体制、",
    "start": 865.104,
    "end": 869.744,
    "duration": 4.64
  },
  {
    "id": 208,
    "text": "稿件审查机制与文艺评价尺度。",
    "start": 869.744,
    "end": 872.784,
    "duration": 3.04
  },
  {
    "id": 209,
    "text": "它在推动文艺大众化与民族化的同时，",
    "start": 872.784,
    "end": 875.904,
    "duration": 3.12
  },
  {
    "id": 210,
    "text": "也因后世对政治标准的绝对化理解，",
    "start": 875.904,
    "end": 878.864,
    "duration": 2.96
  },
  {
    "id": 211,
    "text": "在一定程度上带来了题材单一与个性受限的局限。",
    "start": 878.864,
    "end": 882.704,
    "duration": 3.84
  },
  {
    "id": 212,
    "text": "---。（六",
    "start": 882.944,
    "end": 883.167,
    "duration": 0.223
  },
  {
    "id": 213,
    "text": "）总结升华板块。",
    "start": 883.167,
    "end": 884.503,
    "duration": 1.336
  },
  {
    "id": 214,
    "text": "收口推演逻辑：总结全篇论述要点。",
    "start": 884.503,
    "end": 887.621,
    "duration": 3.118
  },
  {
    "id": 215,
    "text": "重申其作为马克思主义文论中国化划时代飞跃的地位，",
    "start": 887.621,
    "end": 892.744,
    "duration": 5.123
  },
  {
    "id": 216,
    "text": "点明其重塑文学主体、功能、美学与体制，",
    "start": 892.744,
    "end": 896.307,
    "duration": 3.563
  },
  {
    "id": 217,
    "text": "完成中国现代向当代转折的定论。",
    "start": 896.307,
    "end": 899.425,
    "duration": 3.118
  },
  {
    "id": 218,
    "text": "逐句咬合推导：具体表述到答题语句就是：综上所述，",
    "start": 899.425,
    "end": 904.102,
    "duration": 4.677
  },
  {
    "id": 219,
    "text": "毛泽东《在延安文艺座谈会上的讲话》是一座具有里程碑意义的理论丰碑。。",
    "start": 904.102,
    "end": 910.784,
    "duration": 6.682
  },
  {
    "id": 220,
    "text": "最后以一句话完成全卷收束，具体表述到答题语句就是：它在历史转折关头重塑了中国文学的主体、",
    "start": 910.864,
    "end": 919.584,
    "duration": 8.72
  },
  {
    "id": 221,
    "text": "功能、美学与体制，标志着中国现代文学向当代文学的深远跨越。。",
    "start": 919.584,
    "end": 925.264,
    "duration": 5.68
  },
  {
    "id": 222,
    "text": "综上所述，毛泽东《在延安文艺座谈会上的讲话》是一座具有里程碑意义的理论丰碑。",
    "start": 925.264,
    "end": 931.424,
    "duration": 6.16
  },
  {
    "id": 223,
    "text": "它在历史转折关头重塑了中国文学的主体、",
    "start": 931.664,
    "end": 935.024,
    "duration": 3.36
  },
  {
    "id": 224,
    "text": "功能、美学与体制，标志着中国现代文学向当代文学的深远跨越。",
    "start": 935.024,
    "end": 940.544,
    "duration": 5.52
  }
]