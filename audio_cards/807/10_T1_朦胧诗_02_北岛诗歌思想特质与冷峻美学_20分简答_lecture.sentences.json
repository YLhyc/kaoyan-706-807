[
  {
    "id": 1,
    "text": "一、宏观结构推演与采分点映射。",
    "start": 0.08,
    "end": 3.12,
    "duration": 3.04
  },
  {
    "id": 2,
    "text": "本题标准分为二十分，简答题结构采用高分“总领定性，",
    "start": 3.12,
    "end": 8.08,
    "duration": 4.96
  },
  {
    "id": 3,
    "text": "三点机制并列推进，收束升华”逻辑模型：一、",
    "start": 8.08,
    "end": 12.24,
    "duration": 4.16
  },
  {
    "id": 4,
    "text": "总领定性（约五十字）：界定北岛的诗坛地位与核心美学关键词（理性反思、",
    "start": 12.24,
    "end": 18.56,
    "duration": 6.32
  },
  {
    "id": 5,
    "text": "怀疑批判、冷峻坚毅）。",
    "start": 18.56,
    "end": 20.32,
    "duration": 1.76
  },
  {
    "id": 6,
    "text": "二、第一点：思想精神层面（主体批判）：采分点为打破盲从、",
    "start": 20.64,
    "end": 25.76,
    "duration": 5.12
  },
  {
    "id": 7,
    "text": "批判主体确立、“我不相信”与“我只想做一个人”的人格挺立。",
    "start": 25.76,
    "end": 30.24,
    "duration": 4.48
  },
  {
    "id": 8,
    "text": "三、第二点：艺术形式层面（意象与语言）：采分点为硬质冷色意象（冰川、",
    "start": 30.24,
    "end": 36.32,
    "duration": 6.08
  },
  {
    "id": 9,
    "text": "海岸、墓志铭）、格言式哲理提炼、",
    "start": 36.32,
    "end": 38.72,
    "duration": 2.4
  },
  {
    "id": 10,
    "text": "克制冷静腔调。",
    "start": 38.72,
    "end": 39.84,
    "duration": 1.12
  },
  {
    "id": 11,
    "text": "四、第三点：修辞结构与美学风格层面（悖论与悲壮）：采分点为悖论反讽、",
    "start": 40.16,
    "end": 47.84,
    "duration": 7.68
  },
  {
    "id": 12,
    "text": "反差对抗、绝望中的抗争、殉道者式悲剧崇高感。",
    "start": 47.84,
    "end": 52.96,
    "duration": 5.12
  },
  {
    "id": 13,
    "text": "五、收束升华（约五十字）：精神肖像塑造与现代汉语诗歌理性风范确立。",
    "start": 52.96,
    "end": 60.24,
    "duration": 7.28
  },
  {
    "id": 14,
    "text": "二、逐段内部咬合与考场得分句推导。",
    "start": 60.24,
    "end": 63.84,
    "duration": 3.6
  },
  {
    "id": 15,
    "text": "总领段：明确作家地位与美学内核。",
    "start": 64.16,
    "end": 67.84,
    "duration": 3.68
  },
  {
    "id": 16,
    "text": "论证推演逻辑：一句话概括北岛的历史坐标，",
    "start": 67.84,
    "end": 71.68,
    "duration": 3.84
  },
  {
    "id": 17,
    "text": "指出其冷峻美学对思想解放的推动作用，",
    "start": 71.68,
    "end": 75.2,
    "duration": 3.52
  },
  {
    "id": 18,
    "text": "直接带出三点论述。",
    "start": 75.2,
    "end": 77.28,
    "duration": 2.08
  },
  {
    "id": 19,
    "text": "具体表述到答题语句就是：北岛作为朦胧诗群的核心代表，",
    "start": 77.28,
    "end": 82.16,
    "duration": 4.88
  },
  {
    "id": 20,
    "text": "其诗歌以强烈的理性反思、怀疑批判精神与冷峻坚毅的现代美学风格，",
    "start": 82.16,
    "end": 88.56,
    "duration": 6.4
  },
  {
    "id": 21,
    "text": "成为新时期思想解放的先声。",
    "start": 88.56,
    "end": 90.72,
    "duration": 2.16
  },
  {
    "id": 22,
    "text": "其思想特质与冷峻美学主要体现在三个方面。",
    "start": 91.12,
    "end": 95.092,
    "duration": 3.972
  },
  {
    "id": 23,
    "text": "北岛作为朦胧诗群的核心代表，其诗歌以强烈的理性反思、",
    "start": 95.092,
    "end": 100.335,
    "duration": 5.243
  },
  {
    "id": 24,
    "text": "怀疑批判精神与冷峻坚毅的现代美学风格，",
    "start": 100.335,
    "end": 104.268,
    "duration": 3.933
  },
  {
    "id": 25,
    "text": "成为新时期思想解放的先声。",
    "start": 104.268,
    "end": 106.889,
    "duration": 2.621
  },
  {
    "id": 26,
    "text": "其思想特质与冷峻美学主要体现在三个方面。--。",
    "start": 106.889,
    "end": 111.04,
    "duration": 4.151
  },
  {
    "id": 27,
    "text": "要点一：怀疑批判精神与独立人格。",
    "start": 111.2,
    "end": 114.8,
    "duration": 3.6
  },
  {
    "id": 28,
    "text": "论证推演逻辑：思想上最鲜明的特征是怀疑理性。",
    "start": 114.8,
    "end": 119.44,
    "duration": 4.64
  },
  {
    "id": 29,
    "text": "结合《回答》的“我不相信”和《宣告》的“我只想做一个人”，",
    "start": 119.44,
    "end": 123.84,
    "duration": 4.4
  },
  {
    "id": 30,
    "text": "论证其对极左神化的剥离与独立人格主体的坚守。",
    "start": 123.84,
    "end": 128.32,
    "duration": 4.48
  },
  {
    "id": 31,
    "text": "具体表述到答题语句就是：第一，批判怀疑精神与独立人格的挺立。",
    "start": 128.32,
    "end": 134.384,
    "duration": 6.064
  },
  {
    "id": 32,
    "text": "北岛诗歌彻底终结了盲从说教的历史神话。",
    "start": 134.384,
    "end": 137.744,
    "duration": 3.36
  },
  {
    "id": 33,
    "text": "他将个体提升为能够独立审视历史与现实的批判主体。",
    "start": 137.744,
    "end": 142.224,
    "duration": 4.48
  },
  {
    "id": 34,
    "text": "在《回答》中，面对动荡荒谬的现实，",
    "start": 142.224,
    "end": 145.184,
    "duration": 2.96
  },
  {
    "id": 35,
    "text": "诗人发出“我，不，相，信”的断然呐喊。",
    "start": 145.184,
    "end": 149.104,
    "duration": 3.92
  },
  {
    "id": 36,
    "text": "他以冷峻的目光撕破伪崇高。",
    "start": 149.104,
    "end": 151.424,
    "duration": 2.32
  },
  {
    "id": 37,
    "text": "而在《宣告》中，“在没有英雄的年代里，",
    "start": 151.664,
    "end": 154.784,
    "duration": 3.12
  },
  {
    "id": 38,
    "text": "我只想做一个人”的诗句，将人的价值与世俗尊严置于首位。",
    "start": 154.784,
    "end": 160.144,
    "duration": 5.36
  },
  {
    "id": 39,
    "text": "诗作表现出决不屈服的硬汉风骨与殉道者情怀。",
    "start": 160.144,
    "end": 164.864,
    "duration": 4.72
  },
  {
    "id": 40,
    "text": "第一，批判怀疑精神与独立人格的挺立。",
    "start": 164.864,
    "end": 168.624,
    "duration": 3.76
  },
  {
    "id": 41,
    "text": "北岛诗歌彻底终结了盲从说教的历史神话。",
    "start": 168.624,
    "end": 171.744,
    "duration": 3.12
  },
  {
    "id": 42,
    "text": "他将个体提升为能够独立审视历史与现实的批判主体。",
    "start": 172.064,
    "end": 176.784,
    "duration": 4.72
  },
  {
    "id": 43,
    "text": "在《回答》中，面对动荡荒谬的现实，",
    "start": 176.784,
    "end": 179.824,
    "duration": 3.04
  },
  {
    "id": 44,
    "text": "诗人发出“我，不，相，信”的断然呐喊。",
    "start": 179.824,
    "end": 183.824,
    "duration": 4.0
  },
  {
    "id": 45,
    "text": "他以冷峻的目光撕破伪崇高。",
    "start": 183.824,
    "end": 186.304,
    "duration": 2.48
  },
  {
    "id": 46,
    "text": "而在《宣告》中，“在没有英雄的年代里，",
    "start": 186.304,
    "end": 189.504,
    "duration": 3.2
  },
  {
    "id": 47,
    "text": "我只想做一个人”的诗句，将人的价值与世俗尊严置于首位。",
    "start": 189.504,
    "end": 194.064,
    "duration": 4.56
  },
  {
    "id": 48,
    "text": "诗作表现出决不屈服的硬汉风骨与殉道者情怀。",
    "start": 194.384,
    "end": 198.864,
    "duration": 4.48
  },
  {
    "id": 49,
    "text": "--。要",
    "start": 198.864,
    "end": 199.024,
    "duration": 0.16
  },
  {
    "id": 50,
    "text": "点二：冷色调硬质意象与哲理思辨。",
    "start": 199.024,
    "end": 202.784,
    "duration": 3.76
  },
  {
    "id": 51,
    "text": "论证推演逻辑：艺术特征紧扣“冷峻”二字。",
    "start": 202.784,
    "end": 206.784,
    "duration": 4.0
  },
  {
    "id": 52,
    "text": "分析其冷色硬质意象网络，结合《回答》对仗警句与《一切》的萧索排比，",
    "start": 206.784,
    "end": 213.264,
    "duration": 6.48
  },
  {
    "id": 53,
    "text": "指出其克制内敛的哲思特征。",
    "start": 213.264,
    "end": 215.744,
    "duration": 2.48
  },
  {
    "id": 54,
    "text": "-具体表述到答题语句就是：第二，",
    "start": 215.984,
    "end": 218.667,
    "duration": 2.683
  },
  {
    "id": 55,
    "text": "冷色调凝练意象与严密哲理思辨。",
    "start": 218.667,
    "end": 221.556,
    "duration": 2.889
  },
  {
    "id": 56,
    "text": "北岛善于从冰冷的物质世界中提炼高度浓缩的象征意象。",
    "start": 221.556,
    "end": 226.508,
    "duration": 4.952
  },
  {
    "id": 57,
    "text": "冰川、海岸、风暴、锁链与墓志铭等硬质冷色词汇频繁出现。",
    "start": 226.508,
    "end": 231.254,
    "duration": 4.746
  },
  {
    "id": 58,
    "text": "在《回答》中，“卑鄙是卑鄙者的通行证，",
    "start": 231.254,
    "end": 234.143,
    "duration": 2.889
  },
  {
    "id": 59,
    "text": "高尚是高尚者的墓志铭”将两组对立概念并置。",
    "start": 234.143,
    "end": 238.064,
    "duration": 3.921
  },
  {
    "id": 60,
    "text": "诗句如格言般凝练犀利。",
    "start": 238.224,
    "end": 241.104,
    "duration": 2.88
  },
  {
    "id": 61,
    "text": "在《一切》中，他以冷峻的排比勾勒出万象萧索的幻灭感。",
    "start": 241.104,
    "end": 246.144,
    "duration": 5.04
  },
  {
    "id": 62,
    "text": "情绪克制而内敛，充溢着深沉的哲学沉思。",
    "start": 246.144,
    "end": 250.064,
    "duration": 3.92
  },
  {
    "id": 63,
    "text": "第二，冷色调凝练意象与严密哲理思辨。",
    "start": 250.064,
    "end": 253.664,
    "duration": 3.6
  },
  {
    "id": 64,
    "text": "北岛善于从冰冷的物质世界中提炼高度浓缩的象征意象。",
    "start": 253.664,
    "end": 258.544,
    "duration": 4.88
  },
  {
    "id": 65,
    "text": "冰川、海岸、风暴、锁链与墓志铭等硬质冷色词汇频繁出现。",
    "start": 258.544,
    "end": 264.144,
    "duration": 5.6
  },
  {
    "id": 66,
    "text": "在《回答》中，“卑鄙是卑鄙者的通行证，",
    "start": 264.464,
    "end": 267.584,
    "duration": 3.12
  },
  {
    "id": 67,
    "text": "高尚是高尚者的墓志铭”将两组对立概念并置。",
    "start": 267.584,
    "end": 271.744,
    "duration": 4.16
  },
  {
    "id": 68,
    "text": "诗句如格言般凝练犀利。",
    "start": 271.744,
    "end": 273.904,
    "duration": 2.16
  },
  {
    "id": 69,
    "text": "在《一切》中，他以冷峻的排比勾勒出万象萧索的幻灭感。",
    "start": 273.904,
    "end": 278.464,
    "duration": 4.56
  },
  {
    "id": 70,
    "text": "情绪克制而内敛，充溢着深沉的哲学沉思。--",
    "start": 278.464,
    "end": 281.904,
    "duration": 3.44
  },
  {
    "id": 71,
    "text": "要点三：悖论反讽与悲剧崇高。",
    "start": 282.352,
    "end": 285.312,
    "duration": 2.96
  },
  {
    "id": 72,
    "text": "论证推演逻辑：深入到修辞结构与情感底色。",
    "start": 285.312,
    "end": 289.472,
    "duration": 4.16
  },
  {
    "id": 73,
    "text": "剖析悖论与反讽机制，指出反差背后不是虚无，",
    "start": 289.472,
    "end": 293.632,
    "duration": 4.16
  },
  {
    "id": 74,
    "text": "而是宁愿承受毁灭也要抗争的殉道者崇高感。",
    "start": 293.632,
    "end": 297.712,
    "duration": 4.08
  },
  {
    "id": 75,
    "text": "具体表述到答题语句就是：第三，悖论反讽结构与抗争性悲剧崇高感。",
    "start": 297.712,
    "end": 303.552,
    "duration": 5.84
  },
  {
    "id": 76,
    "text": "北岛经常采用悖论与反衬手法打破读者的思维惯性。",
    "start": 303.792,
    "end": 308.192,
    "duration": 4.4
  },
  {
    "id": 77,
    "text": "高尚者面临毁灭，卑鄙者却畅行无阻。",
    "start": 308.192,
    "end": 311.312,
    "duration": 3.12
  },
  {
    "id": 78,
    "text": "这种巨大的荒诞反差构成了严峻的现实反讽。",
    "start": 311.312,
    "end": 315.072,
    "duration": 3.76
  },
  {
    "id": 79,
    "text": "但他并没有走向虚无与绝望。",
    "start": 315.072,
    "end": 317.312,
    "duration": 2.24
  },
  {
    "id": 80,
    "text": "诗人愿以肉身化为审判的基石。",
    "start": 317.312,
    "end": 319.872,
    "duration": 2.56
  },
  {
    "id": 81,
    "text": "这种在绝望中执着前行的坚韧姿态，",
    "start": 319.872,
    "end": 322.752,
    "duration": 2.88
  },
  {
    "id": 82,
    "text": "赋予诗作崇高的悲剧美学力量。",
    "start": 322.752,
    "end": 324.992,
    "duration": 2.24
  },
  {
    "id": 83,
    "text": "第三，悖论反讽结构与抗争性悲剧崇高感。",
    "start": 325.312,
    "end": 329.072,
    "duration": 3.76
  },
  {
    "id": 84,
    "text": "北岛经常采用悖论与反衬手法打破读者的思维惯性。",
    "start": 329.072,
    "end": 333.312,
    "duration": 4.24
  },
  {
    "id": 85,
    "text": "高尚者面临毁灭，卑鄙者却畅行无阻。",
    "start": 333.312,
    "end": 336.752,
    "duration": 3.44
  },
  {
    "id": 86,
    "text": "这种巨大的荒诞反差构成了严峻的现实反讽。",
    "start": 336.752,
    "end": 340.432,
    "duration": 3.68
  },
  {
    "id": 87,
    "text": "但他并没有走向虚无与绝望。",
    "start": 340.432,
    "end": 342.672,
    "duration": 2.24
  },
  {
    "id": 88,
    "text": "诗人愿以肉身化为审判的基石。",
    "start": 342.672,
    "end": 345.072,
    "duration": 2.4
  },
  {
    "id": 89,
    "text": "这种在绝望中执着前行的坚韧姿态，",
    "start": 345.472,
    "end": 348.672,
    "duration": 3.2
  },
  {
    "id": 90,
    "text": "赋予诗作崇高的悲剧美学力量。",
    "start": 348.672,
    "end": 351.552,
    "duration": 2.88
  },
  {
    "id": 91,
    "text": "--。总",
    "start": 351.552,
    "end": 351.712,
    "duration": 0.16
  },
  {
    "id": 92,
    "text": "结升华段：艺术风范定位。",
    "start": 351.712,
    "end": 353.872,
    "duration": 2.16
  },
  {
    "id": 93,
    "text": "论证推演逻辑：最后收束，概括北岛作为一代人精神肖像的写照者与新诗理性美学的确立者。",
    "start": 353.872,
    "end": 361.872,
    "duration": 8.0
  },
  {
    "id": 94,
    "text": "具体表述到答题语句就是：北岛的诗歌不仅塑造了一代青年独立觉醒的精神肖像，",
    "start": 361.872,
    "end": 368.099,
    "duration": 6.227
  },
  {
    "id": 95,
    "text": "更以其钢铁般的沉稳节律，确立了中国现代汉语诗歌冷峻庄严的理性风范。",
    "start": 368.099,
    "end": 373.764,
    "duration": 5.665
  },
  {
    "id": 96,
    "text": "北岛的诗歌不仅塑造了一代青年独立觉醒的精神肖像，",
    "start": 373.764,
    "end": 377.967,
    "duration": 4.203
  },
  {
    "id": 97,
    "text": "更以其钢铁般的沉稳节律，确立了中国现代汉语诗歌冷峻庄严的理性风范。",
    "start": 377.967,
    "end": 383.632,
    "duration": 5.665
  }
]