[
  {
    "id": 1,
    "text": "四十年代后期，以穆旦、郑敏、杜运燮、",
    "start": 0.087,
    "end": 3.327,
    "duration": 3.24
  },
  {
    "id": 2,
    "text": "辛笛等西南联大诗人群为骨干的“九叶诗派”（中国新诗派），",
    "start": 3.537,
    "end": 8.726,
    "duration": 5.189
  },
  {
    "id": 3,
    "text": "在中国现代诗歌史演进的关键节点上，",
    "start": 8.76,
    "end": 11.468,
    "duration": 2.708
  },
  {
    "id": 4,
    "text": "完成了现实主义历史感悟与现代主义艺术形式的深刻交融。",
    "start": 11.803,
    "end": 16.077,
    "duration": 4.274
  },
  {
    "id": 5,
    "text": "其追求现实感与现代性双向契合的“综合诗学”，",
    "start": 16.511,
    "end": 20.088,
    "duration": 3.577
  },
  {
    "id": 6,
    "text": "主要体现在以下三个层面：",
    "start": 20.272,
    "end": 21.991,
    "duration": 1.719
  },
  {
    "id": 7,
    "text": "第一，融汇民族血肉苦难与深邃历史意识，",
    "start": 22.179,
    "end": 25.779,
    "duration": 3.6
  },
  {
    "id": 8,
    "text": "坚守严肃的现实介入品格。",
    "start": 26.113,
    "end": 28.25,
    "duration": 2.137
  },
  {
    "id": 9,
    "text": "九十年代该群体诗选结集命名为“九叶”，而早在战争年代，",
    "start": 28.634,
    "end": 33.707,
    "duration": 5.073
  },
  {
    "id": 10,
    "text": "他们便断然拒绝逃避现实的唯美主义隐遁。",
    "start": 33.879,
    "end": 36.982,
    "duration": 3.103
  },
  {
    "id": 11,
    "text": "穆旦在《赞美》中走出书斋，直面中国北方原野上满脸皱纹、",
    "start": 37.357,
    "end": 42.246,
    "duration": 4.889
  },
  {
    "id": 12,
    "text": "背负着沉重历史重轭的贫苦农夫，以撕心裂肺的赤子之痛，",
    "start": 42.349,
    "end": 46.903,
    "duration": 4.554
  },
  {
    "id": 13,
    "text": "深情歌颂古老民族在废墟硝烟中忍辱负重、",
    "start": 47.09,
    "end": 50.859,
    "duration": 3.769
  },
  {
    "id": 14,
    "text": "顽强搏击的崇高生命力，赋予新诗以宏大庄严的历史悲剧感。",
    "start": 50.93,
    "end": 55.866,
    "duration": 4.936
  },
  {
    "id": 15,
    "text": "第二，借鉴西方现代主义玄学派与象征派，",
    "start": 56.092,
    "end": 60.202,
    "duration": 4.11
  },
  {
    "id": 16,
    "text": "确立具深度张力的“智性诗学”。",
    "start": 60.273,
    "end": 62.62,
    "duration": 2.347
  },
  {
    "id": 17,
    "text": "诗派深受艾略特、奥登与里尔克现代诗歌理论启发，",
    "start": 63.139,
    "end": 67.121,
    "duration": 3.982
  },
  {
    "id": 18,
    "text": "主张感性体验与理性反思的高度化合。",
    "start": 67.441,
    "end": 70.507,
    "duration": 3.066
  },
  {
    "id": 19,
    "text": "杜运燮在《秋》中打破传统悲秋成式，",
    "start": 70.907,
    "end": 73.719,
    "duration": 2.812
  },
  {
    "id": 20,
    "text": "以充满现代反讽的机智语言解构感伤；",
    "start": 74.152,
    "end": 77.095,
    "duration": 2.943
  },
  {
    "id": 21,
    "text": "郑敏以女性特有的哲学冥想审视生命本真；",
    "start": 77.293,
    "end": 80.997,
    "duration": 3.704
  },
  {
    "id": 22,
    "text": "穆旦更在《森林之魅》与《诗八首》中解剖现代个体灵魂深处的撕裂、",
    "start": 81.266,
    "end": 86.314,
    "duration": 5.048
  },
  {
    "id": 23,
    "text": "情欲压抑与精神荒诞，",
    "start": 86.412,
    "end": 88.272,
    "duration": 1.86
  },
  {
    "id": 24,
    "text": "开创了现代汉语诗歌深潜潜意识与形而上沉思的现代范式。",
    "start": 88.467,
    "end": 93.682,
    "duration": 5.215
  },
  {
    "id": 25,
    "text": "第三，打破二元对立的庸俗思维，",
    "start": 93.898,
    "end": 96.282,
    "duration": 2.384
  },
  {
    "id": 26,
    "text": "开创“新诗现代化”的综合文体新路。",
    "start": 96.411,
    "end": 99.12,
    "duration": 2.709
  },
  {
    "id": 27,
    "text": "他们在理论上自觉反对将现实主义与现代主义割裂开来的偏颇倾向，",
    "start": 99.391,
    "end": 104.964,
    "duration": 5.573
  },
  {
    "id": 28,
    "text": "既警惕将诗歌沦为狂热政治口号的传声筒，",
    "start": 105.225,
    "end": 109.028,
    "duration": 3.803
  },
  {
    "id": 29,
    "text": "又排斥纯形式主义的辞藻游戏；通过多维意象叠加、",
    "start": 109.06,
    "end": 113.392,
    "duration": 4.332
  },
  {
    "id": 30,
    "text": "象征跳跃与戏剧性独白，",
    "start": 113.615,
    "end": 115.833,
    "duration": 2.218
  },
  {
    "id": 31,
    "text": "他们锤炼出一种充满内在骨力与张力的现代诗歌语言，",
    "start": 116.009,
    "end": 120.222,
    "duration": 4.213
  },
  {
    "id": 32,
    "text": "确立了中国现代诗歌成熟期的美学标杆。",
    "start": 120.461,
    "end": 123.576,
    "duration": 3.115
  }
]
