[
  {
    "id": 1,
    "text": "四十年代后期，西南联大出身的穆旦、郑敏、杜运燮、袁可嘉与上海的辛笛、杭约赫、陈敬容、唐祈、唐湜等诗人合流，",
    "start": 0.103,
    "end": 11.092,
    "duration": 10.989
  },
  {
    "id": 2,
    "text": "组成“九叶诗派”（当时称“中国新诗派”）。",
    "start": 11.442,
    "end": 14.522,
    "duration": 3.08
  },
  {
    "id": 3,
    "text": "该诗派在现代诗歌史演进的关键节点上，将现实主义历史感与现代主义艺术形式融为一体，",
    "start": 15.022,
    "end": 22.34,
    "duration": 7.318
  },
  {
    "id": 4,
    "text": "其追求现实感与现代性契合的“综合诗学”主要体现在以下三个层面：",
    "start": 22.69,
    "end": 28.099,
    "duration": 5.409
  },
  {
    "id": 5,
    "text": "第一，融汇民族苦难体验与历史意识，坚守严肃的现实介入品格。",
    "start": 28.74,
    "end": 34.071,
    "duration": 5.331
  },
  {
    "id": 6,
    "text": "八十年代初该群体九位诗人的合集《九叶集》出版，“九叶诗派”由此得名。",
    "start": 34.571,
    "end": 39.781,
    "duration": 5.21
  },
  {
    "id": 7,
    "text": "早在战争年代，他们便拒绝逃避现实的唯美倾向。",
    "start": 40.281,
    "end": 43.806,
    "duration": 3.525
  },
  {
    "id": 8,
    "text": "穆旦在《赞美》中直面北方原野上背负历史重担的农夫，又于《森林之魅》写滇缅丛林征战悲歌，",
    "start": 44.306,
    "end": 52.14,
    "duration": 7.834
  },
  {
    "id": 9,
    "text": "以沉痛深切的赤子情怀，歌颂古老民族在废墟硝烟中忍辱负重、顽强抗争的生命力量，赋予新诗庄严的历史悲剧感。",
    "start": 52.517,
    "end": 62.54,
    "duration": 10.023
  },
  {
    "id": 10,
    "text": "第二，借鉴西方现代主义诗艺，确立具张力的“智性诗学”。",
    "start": 63.164,
    "end": 68.215,
    "duration": 5.051
  },
  {
    "id": 11,
    "text": "诗派深受艾略特、奥登与里尔克等西方现代诗人启发，主张感性体验与理性思辨的结合。",
    "start": 68.901,
    "end": 76.523,
    "duration": 7.622
  },
  {
    "id": 12,
    "text": "杜运燮在《秋》中打破传统悲秋成式，以机智反讽消解滥觞感伤；",
    "start": 77.349,
    "end": 83.236,
    "duration": 5.887
  },
  {
    "id": 13,
    "text": "郑敏以沉静细腻的哲学冥想审视生命本真；",
    "start": 83.796,
    "end": 87.597,
    "duration": 3.801
  },
  {
    "id": 14,
    "text": "穆旦在《诗八首》中剖析现代个体灵魂深处的撕裂与精神困境，",
    "start": 88.097,
    "end": 92.956,
    "duration": 4.859
  },
  {
    "id": 15,
    "text": "开创了现代汉语诗歌潜入潜意识与哲理沉思的新路。",
    "start": 93.572,
    "end": 98.13,
    "duration": 4.558
  },
  {
    "id": 16,
    "text": "第三，克服二元对立倾向，探索“新诗现代化”的综合文体之路。",
    "start": 98.757,
    "end": 103.901,
    "duration": 5.144
  },
  {
    "id": 17,
    "text": "他们在理论上自觉反对将现实主义与现代主义割裂的偏向，",
    "start": 104.401,
    "end": 109.055,
    "duration": 4.654
  },
  {
    "id": 18,
    "text": "既警惕诗歌沦为政治口号的附庸，又排斥脱离生活的形式游戏；",
    "start": 109.512,
    "end": 114.813,
    "duration": 5.301
  },
  {
    "id": 19,
    "text": "通过多维意象叠加、象征跳跃与戏剧化独白，",
    "start": 115.474,
    "end": 119.07,
    "duration": 3.596
  },
  {
    "id": 20,
    "text": "锤炼出兼顾内在骨力与表现张力的现代诗语，奠定了现代新诗成熟期的美学标杆。",
    "start": 119.42,
    "end": 126.559,
    "duration": 7.139
  }
]
