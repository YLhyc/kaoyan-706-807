[
  {
    "id": 1,
    "text": "四十年代后期，西南联大出身的穆旦、郑敏、杜运燮、袁可嘉与上海的辛笛、杭约赫、陈敬容、唐祈、唐湜等诗人合流，",
    "start": 0.103,
    "end": 11.092,
    "duration": 10.989
  },
  {
    "id": 2,
    "text": "组成“九叶诗派”（当时称“中国新诗派”）。",
    "start": 11.335,
    "end": 14.415,
    "duration": 3.08
  },
  {
    "id": 3,
    "text": "该诗派在现代诗歌史演进的关键节点上，将现实主义历史感与现代主义艺术形式融为一体，",
    "start": 14.636,
    "end": 21.954,
    "duration": 7.318
  },
  {
    "id": 4,
    "text": "其追求现实感与现代性契合的“综合诗学”主要体现在以下三个层面：",
    "start": 22.195,
    "end": 27.604,
    "duration": 5.409
  },
  {
    "id": 5,
    "text": "第一，融汇民族苦难体验与历史意识，坚守严肃的现实介入品格。",
    "start": 28.245,
    "end": 33.576,
    "duration": 5.331
  },
  {
    "id": 6,
    "text": "八十年代初该群体九位诗人的合集《九叶集》出版，“九叶诗派”由此得名。",
    "start": 33.795,
    "end": 39.005,
    "duration": 5.21
  },
  {
    "id": 7,
    "text": "早在战争年代，他们便拒绝逃避现实的唯美倾向。",
    "start": 39.211,
    "end": 42.736,
    "duration": 3.525
  },
  {
    "id": 8,
    "text": "穆旦在《赞美》中直面北方原野上满脸皱纹、背负历史重担的农夫，",
    "start": 42.941,
    "end": 47.934,
    "duration": 4.993
  },
  {
    "id": 9,
    "text": "以沉痛深切的赤子情怀，歌颂古老民族在废墟硝烟中忍辱负重、顽强抗争的生命力量，",
    "start": 48.211,
    "end": 55.789,
    "duration": 7.578
  },
  {
    "id": 10,
    "text": "赋予新诗庄严的历史悲剧感。",
    "start": 56.163,
    "end": 58.234,
    "duration": 2.071
  },
  {
    "id": 11,
    "text": "第二，借鉴西方现代主义诗艺，确立具张力的“智性诗学”。",
    "start": 58.858,
    "end": 63.909,
    "duration": 5.051
  },
  {
    "id": 12,
    "text": "诗派深受艾略特、奥登与里尔克等西方现代诗人启发，主张感性体验与理性思辨的结合。",
    "start": 64.595,
    "end": 72.229,
    "duration": 7.634
  },
  {
    "id": 13,
    "text": "杜运燮在《秋》中打破传统悲秋成式，以机智反讽消解滥觞感伤；",
    "start": 73.043,
    "end": 78.93,
    "duration": 5.887
  },
  {
    "id": 14,
    "text": "郑敏以沉静细腻的哲学冥想审视生命本真；",
    "start": 79.49,
    "end": 83.291,
    "duration": 3.801
  },
  {
    "id": 15,
    "text": "穆旦在《森林之魅》与《诗八首》中剖析现代个体灵魂深处的撕裂与精神困境，",
    "start": 83.575,
    "end": 89.648,
    "duration": 6.073
  },
  {
    "id": 16,
    "text": "开创了现代汉语诗歌潜入潜意识与哲理沉思的新路。",
    "start": 90.142,
    "end": 94.7,
    "duration": 4.558
  },
  {
    "id": 17,
    "text": "第三，克服二元对立倾向，探索“新诗现代化”的综合文体之路。",
    "start": 95.327,
    "end": 100.471,
    "duration": 5.144
  },
  {
    "id": 18,
    "text": "他们在理论上自觉反对将现实主义与现代主义割裂的偏向，",
    "start": 100.954,
    "end": 105.608,
    "duration": 4.654
  },
  {
    "id": 19,
    "text": "既警惕诗歌沦为政治口号的附庸，又排斥脱离生活的形式游戏；",
    "start": 106.065,
    "end": 111.366,
    "duration": 5.301
  },
  {
    "id": 20,
    "text": "通过多维意象叠加、象征跳跃与戏剧化独白，",
    "start": 112.027,
    "end": 115.623,
    "duration": 3.596
  },
  {
    "id": 21,
    "text": "锤炼出兼顾内在骨力与表现张力的现代诗语，奠定了现代新诗成熟期的美学标杆。",
    "start": 115.874,
    "end": 123.013,
    "duration": 7.139
  }
]