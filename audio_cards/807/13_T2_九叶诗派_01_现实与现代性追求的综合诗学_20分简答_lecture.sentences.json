[
  {
    "id": 1,
    "text": "四十年代后期，以穆旦、郑敏、杜运燮、",
    "start": 0.0,
    "end": 3.58,
    "duration": 3.58
  },
  {
    "id": 2,
    "text": "辛笛等西南联大诗人群为骨干的“九叶诗派”（中国新诗派），",
    "start": 3.58,
    "end": 8.631,
    "duration": 5.051
  },
  {
    "id": 3,
    "text": "在中国现代诗歌史演进的关键节点上，",
    "start": 8.631,
    "end": 11.844,
    "duration": 3.213
  },
  {
    "id": 4,
    "text": "完成了现实主义历史感悟与现代主义艺术形式的深刻交融。",
    "start": 11.844,
    "end": 16.551,
    "duration": 4.707
  },
  {
    "id": 5,
    "text": "其追求现实感与现代性双向契合的“综合诗学”，",
    "start": 16.551,
    "end": 20.312,
    "duration": 3.761
  },
  {
    "id": 6,
    "text": "主要体现在以下三个层面：",
    "start": 20.312,
    "end": 22.919,
    "duration": 2.607
  },
  {
    "id": 7,
    "text": "第一，融汇民族血肉苦难与深邃历史意识，",
    "start": 22.919,
    "end": 26.156,
    "duration": 3.237
  },
  {
    "id": 8,
    "text": "坚守严肃的现实介入品格。",
    "start": 26.156,
    "end": 29.555,
    "duration": 3.399
  },
  {
    "id": 9,
    "text": "九十年代该群体诗选结集命名为“九叶”，而早在战争年代，",
    "start": 29.555,
    "end": 33.919,
    "duration": 4.364
  },
  {
    "id": 10,
    "text": "他们便断然拒绝逃避现实的唯美主义隐遁。",
    "start": 33.919,
    "end": 37.397,
    "duration": 3.478
  },
  {
    "id": 11,
    "text": "穆旦在《赞美》中走出书斋，直面中国北方原野上满脸皱纹、",
    "start": 37.397,
    "end": 42.389,
    "duration": 4.992
  },
  {
    "id": 12,
    "text": "背负着沉重历史重轭的贫苦农夫，以撕心裂肺的赤子之痛，",
    "start": 42.389,
    "end": 47.135,
    "duration": 4.746
  },
  {
    "id": 13,
    "text": "深情歌颂古老民族在废墟硝烟中忍辱负重、",
    "start": 47.135,
    "end": 53.22,
    "duration": 6.085
  },
  {
    "id": 14,
    "text": "顽强搏击的崇高生命力，赋予新诗以宏大庄严的历史悲剧感。",
    "start": 53.22,
    "end": 56.841,
    "duration": 3.621
  },
  {
    "id": 15,
    "text": "第二，借鉴西方现代主义玄学派与象征派，",
    "start": 56.841,
    "end": 60.111,
    "duration": 3.27
  },
  {
    "id": 16,
    "text": "确立具深度张力的“智性诗学”。",
    "start": 60.111,
    "end": 63.181,
    "duration": 3.07
  },
  {
    "id": 17,
    "text": "诗派深受艾略特、奥登与里尔克现代诗歌理论启发，",
    "start": 63.181,
    "end": 67.481,
    "duration": 4.3
  },
  {
    "id": 18,
    "text": "主张感性体验与理性反思的高度化合。",
    "start": 67.481,
    "end": 70.947,
    "duration": 3.466
  },
  {
    "id": 19,
    "text": "杜运燮在《秋》中打破传统悲秋成式，",
    "start": 70.947,
    "end": 74.192,
    "duration": 3.245
  },
  {
    "id": 20,
    "text": "以充满现代反讽的机智语言解构感伤；",
    "start": 74.192,
    "end": 77.333,
    "duration": 3.141
  },
  {
    "id": 21,
    "text": "郑敏以女性特有的哲学冥想审视生命本真；",
    "start": 77.333,
    "end": 81.306,
    "duration": 3.973
  },
  {
    "id": 22,
    "text": "穆旦更在《森林之魅》与《诗八首》中解剖现代个体灵魂深处的撕裂、",
    "start": 81.306,
    "end": 86.454,
    "duration": 5.148
  },
  {
    "id": 23,
    "text": "情欲压抑与精神荒诞，",
    "start": 86.454,
    "end": 88.507,
    "duration": 2.053
  },
  {
    "id": 24,
    "text": "开创了现代汉语诗歌深潜潜意识与形而上沉思的现代范式。",
    "start": 88.507,
    "end": 93.938,
    "duration": 5.431
  },
  {
    "id": 25,
    "text": "第三，打破二元对立的庸俗思维，",
    "start": 93.938,
    "end": 96.451,
    "duration": 2.513
  },
  {
    "id": 26,
    "text": "开创“新诗现代化”的综合文体新路。",
    "start": 96.451,
    "end": 99.431,
    "duration": 2.98
  },
  {
    "id": 27,
    "text": "他们在理论上自觉反对将现实主义与现代主义割裂开来的偏颇倾向，",
    "start": 99.431,
    "end": 105.265,
    "duration": 5.834
  },
  {
    "id": 28,
    "text": "既警惕将诗歌沦为狂热政治口号的传声筒，",
    "start": 105.265,
    "end": 108.882,
    "duration": 3.617
  },
  {
    "id": 29,
    "text": "又排斥纯形式主义的辞藻游戏；通过多维意象叠加、",
    "start": 108.882,
    "end": 113.656,
    "duration": 4.774
  },
  {
    "id": 30,
    "text": "象征跳跃与戏剧性独白，",
    "start": 113.656,
    "end": 116.049,
    "duration": 2.393
  },
  {
    "id": 31,
    "text": "他们锤炼出一种充满内在骨力与张力的现代诗歌语言，",
    "start": 116.049,
    "end": 120.507,
    "duration": 4.458
  },
  {
    "id": 32,
    "text": "确立了中国现代诗歌成熟期的美学标杆。",
    "start": 120.507,
    "end": 123.576,
    "duration": 3.069
  }
]