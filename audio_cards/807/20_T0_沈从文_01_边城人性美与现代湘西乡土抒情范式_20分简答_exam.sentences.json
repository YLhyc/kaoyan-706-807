[
  {
    "id": 1,
    "text": "三十年代中期，沈从文发表中篇小说代表作《边城》，",
    "start": 0.134,
    "end": 4.026,
    "duration": 3.892
  },
  {
    "id": 2,
    "text": "在现代文学史上构筑起一座洋溢着古朴德性与生命诗意的湘西“人性神庙”。",
    "start": 4.65,
    "end": 10.622,
    "duration": 5.972
  },
  {
    "id": 3,
    "text": "作为京派乡土抒情小说的经典之作，其人性美与抒情范式主要展现于以下三个层面：",
    "start": 11.3,
    "end": 23.032,
    "duration": 11.732
  },
  {
    "id": 4,
    "text": "第一，建构不悖乎人性的“善”与“美”，寄托重造民族品德的理想。",
    "start": 23.71,
    "end": 29.202,
    "duration": 5.492
  },
  {
    "id": 5,
    "text": "沈从文避开尖锐的阶级冲突描写，将视线投向古朴闭塞的边陲茶峒。",
    "start": 29.92,
    "end": 38.892,
    "duration": 8.972
  },
  {
    "id": 6,
    "text": "小说人物散发着淳厚质朴的道德光辉：老船夫摆渡五十年仗义轻财，",
    "start": 39.69,
    "end": 40.822,
    "duration": 1.132
  },
  {
    "id": 7,
    "text": "过客塞钱必追还，还自备烟茶款待行人；",
    "start": 41.201,
    "end": 41.293,
    "duration": 0.092
  },
  {
    "id": 8,
    "text": "船总顺顺豪爽重义、乐善好施；",
    "start": 41.822,
    "end": 41.944,
    "duration": 0.122
  },
  {
    "id": 9,
    "text": "天保与傩送兄弟同爱翠翠，却摒弃私心倾轧，相约依循当地风俗夜半山崖对歌，",
    "start": 42.473,
    "end": 42.795,
    "duration": 0.322
  },
  {
    "id": 10,
    "text": "展开堂堂正正的“君子之争”，呈现出未被金钱物欲沾染的高尚人性境界。",
    "start": 43.174,
    "end": 43.786,
    "duration": 0.612
  },
  {
    "id": 11,
    "text": "第二，刻画澄澈纯净的自然之子，塑造优美含蓄的少女典型。",
    "start": 44.464,
    "end": 57.076,
    "duration": 12.612
  },
  {
    "id": 12,
    "text": "翠翠是湘西青山绿水与古朴民风孕育的纯洁生命。",
    "start": 57.754,
    "end": 62.606,
    "duration": 4.852
  },
  {
    "id": 13,
    "text": "她如山头黄麂般天真灵动，端午赛龙舟时在喧嚣鼓声中与傩送偶遇，",
    "start": 63.324,
    "end": 66.216,
    "duration": 2.892
  },
  {
    "id": 14,
    "text": "少女情窦在朦胧含蓄中悄然萌动。",
    "start": 66.595,
    "end": 67.837,
    "duration": 1.242
  },
  {
    "id": 15,
    "text": "沈从文借翠翠在月夜歌声后梦中摘取虎耳草的细节，",
    "start": 68.475,
    "end": 72.087,
    "duration": 3.612
  },
  {
    "id": 16,
    "text": "细腻捕捉了少女情愫与自然节律的契合，赋予人物诗意光彩。",
    "start": 72.466,
    "end": 77.638,
    "duration": 5.172
  },
  {
    "id": 17,
    "text": "第三，融汇诗意意境与散文笔调，奠定哀而不伤的田园牧歌范式。",
    "start": 78.316,
    "end": 87.368,
    "duration": 9.052
  },
  {
    "id": 18,
    "text": "小说语言质朴明净，将湘西风土人情描摹与散文化叙事融为一体。",
    "start": 88.046,
    "end": 93.458,
    "duration": 5.412
  },
  {
    "id": 19,
    "text": "但在恬淡安宁的牧歌氛围下，故事因人事错位与命运无常走向深沉悲凉：",
    "start": 94.136,
    "end": 99.828,
    "duration": 5.692
  },
  {
    "id": 20,
    "text": "天保乘船出走途中在茨滩失事溺亡，傩送负气远走，",
    "start": 100.506,
    "end": 106.198,
    "duration": 5.692
  },
  {
    "id": 21,
    "text": "老船夫于雷雨之夜悄然离世，只留翠翠独守碧溪岨渡船。",
    "start": 106.577,
    "end": 115.634,
    "duration": 9.057
  },
  {
    "id": 22,
    "text": "篇末“这个人也许永远不回来了，也许明天回来”的余韵，将人生的苍凉化作绵长叹息。",
    "start": 116.407,
    "end": 122.819,
    "duration": 6.412
  }
]