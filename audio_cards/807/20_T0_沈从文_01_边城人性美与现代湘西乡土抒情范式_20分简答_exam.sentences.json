[
  {
    "id": 1,
    "text": "三十年代中期，沈从文发表中篇小说代表作《边城》，在现代文学史上构筑起一座洋溢着古朴德性与生命诗意的湘西“人性神庙”。",
    "start": 0.107,
    "end": 10.873,
    "duration": 10.766
  },
  {
    "id": 2,
    "text": "作为京派乡土抒情小说的经典之作，其人性美与抒情范式主要展现于以下三个层面：",
    "start": 11.518,
    "end": 18.697,
    "duration": 7.179
  },
  {
    "id": 3,
    "text": "第一，建构不悖乎人性的“善”与“美”，寄托重造民族品德的理想。",
    "start": 19.367,
    "end": 24.979,
    "duration": 5.612
  },
  {
    "id": 4,
    "text": "沈从文避开尖锐的阶级冲突描写，将视线投向古朴闭塞的边陲茶峒。",
    "start": 25.479,
    "end": 31.288,
    "duration": 5.809
  },
  {
    "id": 5,
    "text": "小说人物散发着淳厚质朴的道德光辉：老船夫摆渡五十年仗义轻财，",
    "start": 31.788,
    "end": 37.659,
    "duration": 5.871
  },
  {
    "id": 6,
    "text": "过客塞钱必追还，还自备烟茶款待行人；",
    "start": 38.115,
    "end": 41.726,
    "duration": 3.611
  },
  {
    "id": 7,
    "text": "船总顺顺豪爽重义、乐善好施；",
    "start": 42.226,
    "end": 44.941,
    "duration": 2.715
  },
  {
    "id": 8,
    "text": "天保与傩送兄弟同爱翠翠，却摒弃私心倾轧，相约依循当地风俗夜半山崖对歌，",
    "start": 45.441,
    "end": 52.262,
    "duration": 6.821
  },
  {
    "id": 9,
    "text": "展开堂堂正正的“君子之争”，呈现出未被金钱物欲沾染的高尚人性境界。",
    "start": 52.612,
    "end": 58.346,
    "duration": 5.734
  },
  {
    "id": 10,
    "text": "第二，刻画澄澈纯净的自然之子，塑造优美含蓄的少女典型。",
    "start": 58.959,
    "end": 64.217,
    "duration": 5.258
  },
  {
    "id": 11,
    "text": "翠翠是湘西青山绿水与古朴民风孕育的纯洁生命。",
    "start": 64.717,
    "end": 68.669,
    "duration": 3.952
  },
  {
    "id": 12,
    "text": "她如山头黄麂般天真灵动，端午赛龙舟时在喧嚣鼓声中与傩送偶遇，",
    "start": 69.169,
    "end": 75.517,
    "duration": 6.348
  },
  {
    "id": 13,
    "text": "少女情窦在朦胧含蓄中悄然萌动。",
    "start": 76.025,
    "end": 78.737,
    "duration": 2.712
  },
  {
    "id": 14,
    "text": "沈从文借翠翠在月夜歌声后梦中摘取虎耳草的细节，",
    "start": 79.332,
    "end": 83.508,
    "duration": 4.176
  },
  {
    "id": 15,
    "text": "细腻捕捉了少女情愫与自然节律的契合，赋予人物诗意光彩。",
    "start": 83.858,
    "end": 89.312,
    "duration": 5.454
  },
  {
    "id": 16,
    "text": "第三，融汇诗意意境与散文笔调，奠定哀而不伤的田园牧歌范式。",
    "start": 89.911,
    "end": 95.742,
    "duration": 5.831
  },
  {
    "id": 17,
    "text": "小说语言质朴明净，将湘西风土人情描摹与散文化叙事融为一体。",
    "start": 96.242,
    "end": 101.932,
    "duration": 5.69
  },
  {
    "id": 18,
    "text": "但在恬淡安宁的牧歌氛围下，故事因人事错位与命运无常走向深沉悲凉：",
    "start": 102.432,
    "end": 108.459,
    "duration": 6.027
  },
  {
    "id": 19,
    "text": "天保乘船出走途中在茨滩失事溺亡，傩送负气远走，",
    "start": 108.809,
    "end": 113.341,
    "duration": 4.532
  },
  {
    "id": 20,
    "text": "老船夫于雷雨之夜悄然离世，只留翠翠独守碧溪岨渡船。",
    "start": 113.726,
    "end": 118.744,
    "duration": 5.018
  },
  {
    "id": 21,
    "text": "篇末“这个人也许永远不回来了，也许明天回来”的余韵，将人生的苍凉化作绵长叹息。",
    "start": 119.244,
    "end": 126.104,
    "duration": 6.86
  }
]
