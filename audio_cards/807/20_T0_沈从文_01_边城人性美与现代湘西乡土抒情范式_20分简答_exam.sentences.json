[
  {
    "id": 1,
    "text": "三十年代中期，沈从文发表中篇小说代表作《边城》，",
    "start": 0.088,
    "end": 4.541,
    "duration": 4.453
  },
  {
    "id": 2,
    "text": "在中国现代文学史上成功构筑起一座远离现代都市文明污染、",
    "start": 4.586,
    "end": 9.519,
    "duration": 4.933
  },
  {
    "id": 3,
    "text": "闪烁着原始神性光辉的湘西“人性神庙”。",
    "start": 9.728,
    "end": 13.569,
    "duration": 3.841
  },
  {
    "id": 4,
    "text": "作为京派乡土抒情小说的巅峰之作，",
    "start": 13.687,
    "end": 16.333,
    "duration": 2.646
  },
  {
    "id": 5,
    "text": "其人性美与诗意范式主要展现于以下三个层面：",
    "start": 16.87,
    "end": 20.941,
    "duration": 4.071
  },
  {
    "id": 6,
    "text": "第一，建构不悖乎人性的“善”与“美”，",
    "start": 21.136,
    "end": 24.163,
    "duration": 3.027
  },
  {
    "id": 7,
    "text": "寄托作家重造民族品德的文化理想。",
    "start": 24.53,
    "end": 27.505,
    "duration": 2.975
  },
  {
    "id": 8,
    "text": "沈从文有意避开现代阶级斗争的剧烈冲突，",
    "start": 28.238,
    "end": 31.337,
    "duration": 3.099
  },
  {
    "id": 9,
    "text": "将视线投向古老质朴的边陲茶峒。",
    "start": 31.688,
    "end": 34.442,
    "duration": 2.754
  },
  {
    "id": 10,
    "text": "小说中的人物浑然天成地散发着原始道德的清辉：",
    "start": 35.046,
    "end": 38.979,
    "duration": 3.933
  },
  {
    "id": 11,
    "text": "老船夫摆渡五十年仗义轻财，过客塞钱必追赶奉还，",
    "start": 39.451,
    "end": 43.783,
    "duration": 4.332
  },
  {
    "id": 12,
    "text": "甚至自备烟草好茶款待行客；顺顺豪爽仗义、乐善好施；",
    "start": 44.184,
    "end": 49.035,
    "duration": 4.851
  },
  {
    "id": 13,
    "text": "天保与傩送两兄弟爱上同一个女子翠翠，却毅然摒弃尔虞我诈，",
    "start": 49.242,
    "end": 54.019,
    "duration": 4.777
  },
  {
    "id": 14,
    "text": "遵循古老苗民风俗，",
    "start": 54.201,
    "end": 55.824,
    "duration": 1.623
  },
  {
    "id": 15,
    "text": "相约以山崖夜半对唱情歌的方式进行堂堂正正的“君子之争”，",
    "start": 55.929,
    "end": 60.639,
    "duration": 4.71
  },
  {
    "id": 16,
    "text": "展现出一种未被现代金钱名利异化的高尚人性境界。",
    "start": 60.833,
    "end": 64.822,
    "duration": 3.989
  },
  {
    "id": 17,
    "text": "第二，刻画澄澈纯净的自然之子，",
    "start": 65.059,
    "end": 68.655,
    "duration": 3.596
  },
  {
    "id": 18,
    "text": "塑造现代文学中独一无二的优美女性典型。",
    "start": 68.684,
    "end": 72.364,
    "duration": 3.68
  },
  {
    "id": 19,
    "text": "翠翠是湘西青山绿水与古朴民风共同孕育的精灵。",
    "start": 72.743,
    "end": 76.874,
    "duration": 4.131
  },
  {
    "id": 20,
    "text": "她如同山头上的黄麂，天真活泼、纯洁无暇；",
    "start": 77.368,
    "end": 81.264,
    "duration": 3.896
  },
  {
    "id": 21,
    "text": "在端午节龙舟赛的喧嚣鼓声中与傩送偶然相逢，",
    "start": 81.419,
    "end": 85.596,
    "duration": 4.177
  },
  {
    "id": 22,
    "text": "少女情窦在幽微萌动中既纯真又含蓄。",
    "start": 85.814,
    "end": 89.52,
    "duration": 3.706
  },
  {
    "id": 23,
    "text": "作家通过翠翠在梦中摘取虎耳草的诗意意象，",
    "start": 89.785,
    "end": 93.455,
    "duration": 3.67
  },
  {
    "id": 24,
    "text": "细腻捕捉了少女情愫与自然节律的神秘共振，",
    "start": 93.455,
    "end": 96.956,
    "duration": 3.501
  },
  {
    "id": 25,
    "text": "确立了中国现代抒情小说中永恒的自然之美。",
    "start": 97.21,
    "end": 100.725,
    "duration": 3.515
  },
  {
    "id": 26,
    "text": "第三，融汇诗歌意境与散文笔触，",
    "start": 101.009,
    "end": 103.982,
    "duration": 2.973
  },
  {
    "id": 27,
    "text": "奠定哀而不伤的现代田园牧歌范式。",
    "start": 104.208,
    "end": 106.951,
    "duration": 2.743
  },
  {
    "id": 28,
    "text": "小说语言洗练质朴、如山泉般清澈明净，",
    "start": 107.408,
    "end": 110.82,
    "duration": 3.412
  },
  {
    "id": 29,
    "text": "将风土人情描摹与散文化叙事完美融为一体。",
    "start": 111.22,
    "end": 114.937,
    "duration": 3.717
  },
  {
    "id": 30,
    "text": "然而在恬淡安宁的牧歌外壳下，小说最终走向了因人事错位、",
    "start": 115.149,
    "end": 120.144,
    "duration": 4.995
  },
  {
    "id": 31,
    "text": "偶然宿命而引发的深沉悲凉：天保下油坊溺亡，",
    "start": 120.39,
    "end": 124.402,
    "duration": 4.012
  },
  {
    "id": 32,
    "text": "傩送负气远走他乡，老船夫在雷雨之夜溘然长逝，",
    "start": 124.605,
    "end": 128.984,
    "duration": 4.379
  },
  {
    "id": 33,
    "text": "只留下翠翠在碧溪岨孤独守着渡船。",
    "start": 129.167,
    "end": 131.934,
    "duration": 2.767
  },
  {
    "id": 34,
    "text": "结尾那句“这个人也许永远不回来了，也许明天回来”，",
    "start": 132.309,
    "end": 136.52,
    "duration": 4.211
  },
  {
    "id": 35,
    "text": "将生命的苍凉无奈化作余音绕梁的历史叹息。",
    "start": 136.855,
    "end": 140.688,
    "duration": 3.833
  }
]
