[
  {
    "id": 1,
    "text": "三十年代中期，沈从文发表中篇小说代表作《边城》，",
    "start": 0.05,
    "end": 4.599,
    "duration": 4.549
  },
  {
    "id": 2,
    "text": "在中国现代文学史上成功构筑起一座远离现代都市文明污染、",
    "start": 4.599,
    "end": 9.74,
    "duration": 5.141
  },
  {
    "id": 3,
    "text": "闪烁着原始神性光辉的湘西“人性神庙”。",
    "start": 9.74,
    "end": 13.7,
    "duration": 3.96
  },
  {
    "id": 4,
    "text": "作为京派乡土抒情小说的巅峰之作，",
    "start": 13.7,
    "end": 16.881,
    "duration": 3.181
  },
  {
    "id": 5,
    "text": "其人性美与诗意范式主要展现于以下三个层面：",
    "start": 16.881,
    "end": 21.146,
    "duration": 4.265
  },
  {
    "id": 6,
    "text": "第一，建构不悖乎人性的“善”与“美”，",
    "start": 21.146,
    "end": 24.545,
    "duration": 3.399
  },
  {
    "id": 7,
    "text": "寄托作家重造民族品德的文化理想。",
    "start": 24.545,
    "end": 28.253,
    "duration": 3.708
  },
  {
    "id": 8,
    "text": "沈从文有意避开现代阶级斗争的剧烈冲突，",
    "start": 28.253,
    "end": 31.698,
    "duration": 3.445
  },
  {
    "id": 9,
    "text": "将视线投向古老质朴的边陲茶峒。",
    "start": 31.698,
    "end": 35.071,
    "duration": 3.373
  },
  {
    "id": 10,
    "text": "小说中的人物浑然天成地散发着原始道德的清辉：",
    "start": 35.071,
    "end": 39.462,
    "duration": 4.391
  },
  {
    "id": 11,
    "text": "老船夫摆渡五十年仗义轻财，过客塞钱必追赶奉还，",
    "start": 39.462,
    "end": 44.197,
    "duration": 4.735
  },
  {
    "id": 12,
    "text": "甚至自备烟草好茶款待行客；顺顺豪爽仗义、乐善好施；",
    "start": 44.197,
    "end": 49.252,
    "duration": 5.055
  },
  {
    "id": 13,
    "text": "天保与傩送两兄弟爱上同一个女子翠翠，却毅然摒弃尔虞我诈，",
    "start": 49.252,
    "end": 54.211,
    "duration": 4.959
  },
  {
    "id": 14,
    "text": "遵循古老苗民风俗，",
    "start": 54.211,
    "end": 55.946,
    "duration": 1.735
  },
  {
    "id": 15,
    "text": "相约以山崖夜半对唱情歌的方式进行堂堂正正的“君子之争”，",
    "start": 55.946,
    "end": 60.843,
    "duration": 4.897
  },
  {
    "id": 16,
    "text": "展现出一种未被现代金钱名利异化的高尚人性境界。",
    "start": 60.843,
    "end": 65.069,
    "duration": 4.226
  },
  {
    "id": 17,
    "text": "第二，刻画澄澈纯净的自然之子，",
    "start": 65.069,
    "end": 68.698,
    "duration": 3.629
  },
  {
    "id": 18,
    "text": "塑造现代文学中独一无二的优美女性典型。",
    "start": 68.698,
    "end": 72.756,
    "duration": 4.058
  },
  {
    "id": 19,
    "text": "翠翠是湘西青山绿水与古朴民风共同孕育的精灵。",
    "start": 72.756,
    "end": 77.378,
    "duration": 4.622
  },
  {
    "id": 20,
    "text": "她如同山头上的黄麂，天真活泼、纯洁无暇；",
    "start": 77.378,
    "end": 81.63,
    "duration": 4.252
  },
  {
    "id": 21,
    "text": "在端午节龙舟赛的喧嚣鼓声中与傩送偶然相逢，",
    "start": 81.63,
    "end": 85.829,
    "duration": 4.199
  },
  {
    "id": 22,
    "text": "少女情窦在幽微萌动中既纯真又含蓄。",
    "start": 85.829,
    "end": 88.874,
    "duration": 3.045
  },
  {
    "id": 23,
    "text": "作家通过翠翠在梦中摘取虎耳草的诗意意象，",
    "start": 88.874,
    "end": 93.471,
    "duration": 4.597
  },
  {
    "id": 24,
    "text": "细腻捕捉了少女情愫与自然节律的神秘共振，",
    "start": 93.471,
    "end": 97.391,
    "duration": 3.92
  },
  {
    "id": 25,
    "text": "确立了中国现代抒情小说中永恒的自然之美。",
    "start": 97.391,
    "end": 101.019,
    "duration": 3.628
  },
  {
    "id": 26,
    "text": "第三，融汇诗歌意境与散文笔触，",
    "start": 101.019,
    "end": 104.218,
    "duration": 3.199
  },
  {
    "id": 27,
    "text": "奠定哀而不伤的现代田园牧歌范式。",
    "start": 104.218,
    "end": 107.421,
    "duration": 3.203
  },
  {
    "id": 28,
    "text": "小说语言洗练质朴、如山泉般清澈明净，",
    "start": 107.421,
    "end": 111.23,
    "duration": 3.809
  },
  {
    "id": 29,
    "text": "将风土人情描摹与散文化叙事完美融为一体。",
    "start": 111.23,
    "end": 115.161,
    "duration": 3.931
  },
  {
    "id": 30,
    "text": "然而在恬淡安宁的牧歌外壳下，小说最终走向了因人事错位、",
    "start": 115.161,
    "end": 120.4,
    "duration": 5.239
  },
  {
    "id": 31,
    "text": "偶然宿命而引发的深沉悲凉：天保下油坊溺亡，",
    "start": 120.4,
    "end": 124.618,
    "duration": 4.218
  },
  {
    "id": 32,
    "text": "傩送负气远走他乡，老船夫在雷雨之夜溘然长逝，",
    "start": 124.618,
    "end": 129.177,
    "duration": 4.559
  },
  {
    "id": 33,
    "text": "只留下翠翠在碧溪岨孤独守着渡船。",
    "start": 129.177,
    "end": 132.319,
    "duration": 3.142
  },
  {
    "id": 34,
    "text": "结尾那句“这个人也许永远不回来了，也许明天回来”，",
    "start": 132.319,
    "end": 136.87,
    "duration": 4.551
  },
  {
    "id": 35,
    "text": "将生命的苍凉无奈化作余音绕梁的历史叹息。",
    "start": 136.87,
    "end": 140.688,
    "duration": 3.818
  }
]