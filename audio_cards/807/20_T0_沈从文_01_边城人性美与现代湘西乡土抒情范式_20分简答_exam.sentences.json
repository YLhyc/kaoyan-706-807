[
  {
    "id": 1,
    "text": "三十年代中期，沈从文发表中篇小说代表作《边城》，",
    "start": 0.2,
    "end": 4.19,
    "duration": 3.99
  },
  {
    "id": 2,
    "text": "在现代文学史上构筑起一座洋溢着古朴德性与生命诗意的湘西“人性神庙”。",
    "start": 4.56,
    "end": 11.199,
    "duration": 6.639
  },
  {
    "id": 3,
    "text": "作为京派乡土抒情小说的经典之作，其人性美与抒情范式主要展现于以下三个层面：",
    "start": 11.699,
    "end": 17.97,
    "duration": 6.271
  },
  {
    "id": 4,
    "text": "第一，建构不悖乎人性的“善”与“美”，寄托重造民族品德的理想。",
    "start": 18.34,
    "end": 24.167,
    "duration": 5.827
  },
  {
    "id": 5,
    "text": "沈从文避开尖锐的阶级冲突描写，将视线投向古朴闭塞的边陲茶峒。",
    "start": 24.667,
    "end": 29.98,
    "duration": 5.313
  },
  {
    "id": 6,
    "text": "小说人物散发着淳厚质朴的道德光辉：老船夫摆渡五十年仗义轻财，",
    "start": 30.5,
    "end": 36.26,
    "duration": 5.76
  },
  {
    "id": 7,
    "text": "过客塞钱必追还，还自备烟茶款待行人；",
    "start": 36.63,
    "end": 40.39,
    "duration": 3.76
  },
  {
    "id": 8,
    "text": "船总顺顺豪爽重义、乐善好施；",
    "start": 40.91,
    "end": 43.79,
    "duration": 2.88
  },
  {
    "id": 9,
    "text": "天保与傩送兄弟同爱翠翠，却摒弃私心倾轧，相约依循当地风俗夜半山崖对歌，",
    "start": 44.31,
    "end": 51.56,
    "duration": 7.25
  },
  {
    "id": 10,
    "text": "展开堂堂正正的“君子之争”，呈现出未被金钱物欲沾染的高尚人性境界。",
    "start": 51.93,
    "end": 58.09,
    "duration": 6.16
  },
  {
    "id": 11,
    "text": "第二，刻画澄澈纯净的自然之子，塑造优美含蓄的少女典型。",
    "start": 58.61,
    "end": 63.73,
    "duration": 5.12
  },
  {
    "id": 12,
    "text": "翠翠是湘西青山绿水与古朴民风孕育的纯洁生命。",
    "start": 64.25,
    "end": 68.57,
    "duration": 4.32
  },
  {
    "id": 13,
    "text": "她如山头黄麂般天真灵动，端午赛龙舟时在喧嚣鼓声中与傩送偶遇，",
    "start": 69.09,
    "end": 75.33,
    "duration": 6.24
  },
  {
    "id": 14,
    "text": "少女情窦在朦胧含蓄中悄然萌动。",
    "start": 75.7,
    "end": 78.5,
    "duration": 2.8
  },
  {
    "id": 15,
    "text": "沈从文借翠翠在月夜歌声后梦中摘取虎耳草的细节，",
    "start": 79.02,
    "end": 83.26,
    "duration": 4.24
  },
  {
    "id": 16,
    "text": "细腻捕捉了少女情愫与自然节律的契合，赋予人物诗意光彩。",
    "start": 83.74,
    "end": 88.86,
    "duration": 5.12
  },
  {
    "id": 17,
    "text": "第三，融汇诗意意境与散文笔调，奠定哀而不伤的田园牧歌范式。",
    "start": 89.38,
    "end": 94.58,
    "duration": 5.2
  },
  {
    "id": 18,
    "text": "小说语言质朴明净，将湘西风土人情描摹与散文化叙事融为一体。",
    "start": 95.1,
    "end": 100.54,
    "duration": 5.44
  },
  {
    "id": 19,
    "text": "但在恬淡安宁的牧歌氛围下，故事因人事错位与命运无常走向深沉悲凉：",
    "start": 101.06,
    "end": 107.14,
    "duration": 6.08
  },
  {
    "id": 20,
    "text": "天保乘船出走途中在茨滩失事溺亡，傩送负气远走，",
    "start": 107.51,
    "end": 112.802,
    "duration": 5.292
  },
  {
    "id": 21,
    "text": "老船夫于雷雨之夜悄然离世，只留翠翠独守碧溪岨渡船。",
    "start": 113.172,
    "end": 118.04,
    "duration": 4.868
  },
  {
    "id": 22,
    "text": "篇末“这个人也许永远不回来了，也许明天回来”的余韵，将人生的苍凉化作绵长叹息。",
    "start": 118.56,
    "end": 124.96,
    "duration": 6.4
  }
]
