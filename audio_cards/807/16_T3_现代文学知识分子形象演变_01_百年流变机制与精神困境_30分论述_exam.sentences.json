[
  {
    "id": 1,
    "text": "知识分子作为现代思想的启蒙者与社会变革的探路先锋，",
    "start": 0.08,
    "end": 4.32,
    "duration": 4.24
  },
  {
    "id": 2,
    "text": "其精神演变构成了中国现代文学最敏锐的心灵晴雨表。",
    "start": 4.32,
    "end": 8.88,
    "duration": 4.56
  },
  {
    "id": 3,
    "text": "从五四时期的个性觉醒与孤独彷徨，",
    "start": 8.88,
    "end": 11.92,
    "duration": 3.04
  },
  {
    "id": 4,
    "text": "到三四十年代的革命依附与阶级改造，",
    "start": 11.92,
    "end": 15.12,
    "duration": 3.2
  },
  {
    "id": 5,
    "text": "再到沦陷区及新时期的存在困境与反思救赎，",
    "start": 15.12,
    "end": 19.04,
    "duration": 3.92
  },
  {
    "id": 6,
    "text": "知识分子形象经历了由“觉醒的启蒙英雄”向“软弱的动摇者与被改造者”，",
    "start": 19.04,
    "end": 24.88,
    "duration": 5.84
  },
  {
    "id": 7,
    "text": "再向“内省的荒谬承受者”的深刻演进。",
    "start": 24.88,
    "end": 27.6,
    "duration": 2.72
  },
  {
    "id": 8,
    "text": "这一百年流变主要体现在四个核心历史阶段。",
    "start": 27.92,
    "end": 31.68,
    "duration": 3.76
  },
  {
    "id": 9,
    "text": "第一，五四时期的个性觉醒与绝望抗争的精神探索。",
    "start": 31.68,
    "end": 36.24,
    "duration": 4.56
  },
  {
    "id": 10,
    "text": "五四运动打破了封建宗法的千古沉寂。",
    "start": 36.24,
    "end": 39.68,
    "duration": 3.44
  },
  {
    "id": 11,
    "text": "知识分子率先觉醒为追求民主自由的启蒙主体。",
    "start": 39.68,
    "end": 43.68,
    "duration": 4.0
  },
  {
    "id": 12,
    "text": "但面对深重坚固的旧势力，他们陷入了深刻的孤独与幻灭。",
    "start": 43.68,
    "end": 48.16,
    "duration": 4.48
  },
  {
    "id": 13,
    "text": "鲁迅在《伤逝》中塑造了子君与涓生。",
    "start": 48.4,
    "end": 51.6,
    "duration": 3.2
  },
  {
    "id": 14,
    "text": "他们虽勇敢冲出封建包办家庭建立同居新生活，",
    "start": 51.6,
    "end": 56.08,
    "duration": 4.48
  },
  {
    "id": 15,
    "text": "却在琐屑残酷的经济压迫下被彻底碾碎。",
    "start": 56.08,
    "end": 59.36,
    "duration": 3.28
  },
  {
    "id": 16,
    "text": "涓生的忏悔展现了现代个体在失去精神依傍后的绝望。",
    "start": 59.36,
    "end": 64.4,
    "duration": 5.04
  },
  {
    "id": 17,
    "text": "郁达夫在《沉沦》中描摹了留日青年病态的感伤忧郁。",
    "start": 64.4,
    "end": 68.56,
    "duration": 4.16
  },
  {
    "id": 18,
    "text": "个人的性苦闷与弱国子民的屈辱深层纠缠。",
    "start": 68.72,
    "end": 72.88,
    "duration": 4.16
  },
  {
    "id": 19,
    "text": "五四时期的知识分子在炽烈觉醒中承受着早产儿般的精神阵痛。",
    "start": 72.88,
    "end": 78.32,
    "duration": 5.44
  },
  {
    "id": 20,
    "text": "第二，三四十年代在大裂变中的动摇彷徨与革命依附。",
    "start": 78.32,
    "end": 83.76,
    "duration": 5.44
  },
  {
    "id": 21,
    "text": "随着大革命失败与抗日战争爆发，知识分子被迫直面残酷的阶级搏杀与救亡风暴。",
    "start": 83.76,
    "end": 90.8,
    "duration": 7.04
  },
  {
    "id": 22,
    "text": "他们不得不告别纯粹个人的象牙塔，",
    "start": 91.04,
    "end": 93.76,
    "duration": 2.72
  },
  {
    "id": 23,
    "text": "寻求阶级意识形态的政治依附。",
    "start": 93.76,
    "end": 96.32,
    "duration": 2.56
  },
  {
    "id": 24,
    "text": "茅盾在《蚀》三部曲中塑造了方罗兰等动摇者。",
    "start": 96.32,
    "end": 100.0,
    "duration": 3.68
  },
  {
    "id": 25,
    "text": "他们在革命狂热与小资产阶级软弱性之间剧烈摇摆。",
    "start": 100.0,
    "end": 104.4,
    "duration": 4.4
  },
  {
    "id": 26,
    "text": "巴金在《寒夜》中塑造了汪文宣。",
    "start": 104.4,
    "end": 106.96,
    "duration": 2.56
  },
  {
    "id": 27,
    "text": "这位曾经怀抱教育救国理想的小知识分子，",
    "start": 106.96,
    "end": 110.16,
    "duration": 3.2
  },
  {
    "id": 28,
    "text": "在战时通胀与家庭婆媳矛盾中吐血死去。",
    "start": 110.16,
    "end": 113.52,
    "duration": 3.36
  },
  {
    "id": 29,
    "text": "其悲剧揭示了平民知识分子在动荡社会重压下被彻底碾碎的凄惨宿命。",
    "start": 113.76,
    "end": 119.76,
    "duration": 6.0
  },
  {
    "id": 30,
    "text": "第三，十七年时期的政治规训与知识分子的阶级脱胎换骨。",
    "start": 120.056,
    "end": 125.336,
    "duration": 5.28
  },
  {
    "id": 31,
    "text": "新中国成立后，知识分子被纳入无产阶级思想改造的宏大工程中。",
    "start": 125.336,
    "end": 130.296,
    "duration": 4.96
  },
  {
    "id": 32,
    "text": "他们从旧社会的审视者，转变为必须深刻忏悔小资产阶级原罪的被改造对象。",
    "start": 130.296,
    "end": 136.696,
    "duration": 6.4
  },
  {
    "id": 33,
    "text": "杨匠在《洗澡》中描摹了解放初期知识分子在思想改造运动中的复杂心态。",
    "start": 136.696,
    "end": 142.216,
    "duration": 5.52
  },
  {
    "id": 34,
    "text": "而在主流红色经典中，宗璞的《红豆》展现了女大学生江玫在资产阶级个人情爱与无产阶级革命召唤之间的决绝抉择。",
    "start": 142.456,
    "end": 152.696,
    "duration": 10.24
  },
  {
    "id": 35,
    "text": "知识分子只有否定自我、融入工农集体，",
    "start": 152.696,
    "end": 156.136,
    "duration": 3.44
  },
  {
    "id": 36,
    "text": "才能获得新时代的合法身份。",
    "start": 156.136,
    "end": 158.376,
    "duration": 2.24
  },
  {
    "id": 37,
    "text": "第四，新时期以来的苦难反思与现代生存困局审视。",
    "start": 158.376,
    "end": 162.776,
    "duration": 4.4
  },
  {
    "id": 38,
    "text": "新时期文学以批判理性重新审视知识分子的历史遭遇。",
    "start": 163.176,
    "end": 167.896,
    "duration": 4.72
  },
  {
    "id": 39,
    "text": "张贤亮在《男人的一半是女人》中塑造了章永临。",
    "start": 167.896,
    "end": 171.976,
    "duration": 4.08
  },
  {
    "id": 40,
    "text": "作家逼视劳改苦难对知识分子肉体与灵魂的深度阉割。",
    "start": 171.976,
    "end": 176.856,
    "duration": 4.88
  },
  {
    "id": 41,
    "text": "同时，钱终书《围城》的经典价值在新时期被重新发现。",
    "start": 176.856,
    "end": 181.336,
    "duration": 4.48
  },
  {
    "id": 42,
    "text": "方鸿渐在学界与婚姻双重围城中的进退维谷，",
    "start": 181.336,
    "end": 185.096,
    "duration": 3.76
  },
  {
    "id": 43,
    "text": "揭示了知识分子普遍的虚无与平庸。",
    "start": 185.096,
    "end": 187.816,
    "duration": 2.72
  },
  {
    "id": 44,
    "text": "文学从单纯的政治受难控诉，深化为对知识分子人格软弱与现代荒谬生存境遇的深层哲理反思。",
    "start": 188.056,
    "end": 196.216,
    "duration": 8.16
  },
  {
    "id": 45,
    "text": "现当代文学中知识分子形象的演变，",
    "start": 196.216,
    "end": 199.176,
    "duration": 2.96
  },
  {
    "id": 46,
    "text": "生动记录了中国现代精英在理想启蒙、",
    "start": 199.176,
    "end": 202.536,
    "duration": 3.36
  },
  {
    "id": 47,
    "text": "政治规训与存在虚无之间的世纪跋涉。",
    "start": 202.536,
    "end": 205.896,
    "duration": 3.36
  },
  {
    "id": 48,
    "text": "这一艺术长廊不仅展示了知识分子的人性弱点与历史局限，",
    "start": 205.896,
    "end": 210.136,
    "duration": 4.24
  },
  {
    "id": 49,
    "text": "更彰显了他们执着追寻真理与精神尊严的永恒光芒。",
    "start": 210.136,
    "end": 214.456,
    "duration": 4.32
  }
]