[
  {
    "id": 1,
    "text": "三十年代中期，沈从文发表中篇小说代表作《边城》，",
    "start": 0.0,
    "end": 4.465,
    "duration": 4.465
  },
  {
    "id": 2,
    "text": "在中国现代文学史上成功构筑起一座远离现代都市文明污染、",
    "start": 4.465,
    "end": 9.769,
    "duration": 5.304
  },
  {
    "id": 3,
    "text": "闪烁着原始神性光辉的湘西“人性神庙”。",
    "start": 9.769,
    "end": 13.73,
    "duration": 3.961
  },
  {
    "id": 4,
    "text": "作为京派乡土抒情小说的巅峰之作，",
    "start": 13.73,
    "end": 16.911,
    "duration": 3.181
  },
  {
    "id": 5,
    "text": "其人性美与诗意范式主要展现于以下三个层面：",
    "start": 16.911,
    "end": 21.176,
    "duration": 4.265
  },
  {
    "id": 6,
    "text": "第一，建构不悖乎人性的“善”与“美”，",
    "start": 21.176,
    "end": 24.57,
    "duration": 3.394
  },
  {
    "id": 7,
    "text": "寄托作家重造民族品德的文化理想。",
    "start": 24.57,
    "end": 28.279,
    "duration": 3.709
  },
  {
    "id": 8,
    "text": "沈从文有意避开现代阶级斗争的剧烈冲突，",
    "start": 28.279,
    "end": 31.728,
    "duration": 3.449
  },
  {
    "id": 9,
    "text": "将视线投向古老质朴的边陲茶峒。",
    "start": 31.728,
    "end": 35.089,
    "duration": 3.361
  },
  {
    "id": 10,
    "text": "小说中的人物浑然天成地散发着原始道德的清辉：",
    "start": 35.089,
    "end": 39.491,
    "duration": 4.402
  },
  {
    "id": 11,
    "text": "老船夫摆渡五十年仗义轻财，过客塞钱必追赶奉还，",
    "start": 39.491,
    "end": 44.227,
    "duration": 4.736
  },
  {
    "id": 12,
    "text": "甚至自备烟草好茶款待行客；顺顺豪爽仗义、乐善好施；",
    "start": 44.227,
    "end": 49.282,
    "duration": 5.055
  },
  {
    "id": 13,
    "text": "天保与傩送两兄弟爱上同一个女子翠翠，却毅然摒弃尔虞我诈，",
    "start": 49.282,
    "end": 54.241,
    "duration": 4.959
  },
  {
    "id": 14,
    "text": "遵循古老苗民风俗，",
    "start": 54.241,
    "end": 55.976,
    "duration": 1.735
  },
  {
    "id": 15,
    "text": "相约以山崖夜半对唱情歌的方式进行堂堂正正的“君子之争”，",
    "start": 55.976,
    "end": 60.873,
    "duration": 4.897
  },
  {
    "id": 16,
    "text": "展现出一种未被现代金钱名利异化的高尚人性境界。",
    "start": 60.873,
    "end": 65.9,
    "duration": 5.027
  },
  {
    "id": 17,
    "text": "第二，刻画澄澈纯净的自然之子，",
    "start": 65.9,
    "end": 68.58,
    "duration": 2.68
  },
  {
    "id": 18,
    "text": "塑造现代文学中独一无二的优美女性典型。",
    "start": 68.58,
    "end": 72.784,
    "duration": 4.204
  },
  {
    "id": 19,
    "text": "翠翠是湘西青山绿水与古朴民风共同孕育的精灵。",
    "start": 72.784,
    "end": 79.215,
    "duration": 6.431
  },
  {
    "id": 20,
    "text": "她如同山头上的黄麂，天真活泼、纯洁无暇；",
    "start": 79.215,
    "end": 84.151,
    "duration": 4.936
  },
  {
    "id": 21,
    "text": "在端午节龙舟赛的喧嚣鼓声中与傩送偶然相逢，",
    "start": 84.151,
    "end": 89.825,
    "duration": 5.674
  },
  {
    "id": 22,
    "text": "少女情窦在幽微萌动中既纯真又含蓄。",
    "start": 89.825,
    "end": 93.499,
    "duration": 3.674
  },
  {
    "id": 23,
    "text": "作家通过翠翠在梦中摘取虎耳草的诗意意象，",
    "start": 93.499,
    "end": 97.421,
    "duration": 3.922
  },
  {
    "id": 24,
    "text": "细腻捕捉了少女情愫与自然节律的神秘共振，",
    "start": 97.421,
    "end": 101.049,
    "duration": 3.628
  },
  {
    "id": 25,
    "text": "确立了中国现代抒情小说中永恒的自然之美。",
    "start": 101.049,
    "end": 104.248,
    "duration": 3.199
  },
  {
    "id": 26,
    "text": "第三，融汇诗歌意境与散文笔触，",
    "start": 104.248,
    "end": 107.449,
    "duration": 3.201
  },
  {
    "id": 27,
    "text": "奠定哀而不伤的现代田园牧歌范式。",
    "start": 107.449,
    "end": 111.26,
    "duration": 3.811
  },
  {
    "id": 28,
    "text": "小说语言洗练质朴、如山泉般清澈明净，",
    "start": 111.26,
    "end": 115.189,
    "duration": 3.929
  },
  {
    "id": 29,
    "text": "将风土人情描摹与散文化叙事完美融为一体。",
    "start": 115.189,
    "end": 119.147,
    "duration": 3.958
  },
  {
    "id": 30,
    "text": "然而在恬淡安宁的牧歌外壳下，小说最终走向了因人事错位、",
    "start": 119.147,
    "end": 124.648,
    "duration": 5.501
  },
  {
    "id": 31,
    "text": "偶然宿命而引发的深沉悲凉：天保下油坊溺亡，",
    "start": 124.648,
    "end": 129.207,
    "duration": 4.559
  },
  {
    "id": 32,
    "text": "傩送负气远走他乡，老船夫在雷雨之夜溘然长逝，",
    "start": 129.207,
    "end": 132.349,
    "duration": 3.142
  },
  {
    "id": 33,
    "text": "只留下翠翠在碧溪岨孤独守着渡船。",
    "start": 132.349,
    "end": 135.496,
    "duration": 3.147
  },
  {
    "id": 34,
    "text": "结尾那句“这个人也许永远不回来了，也许明天回来”，",
    "start": 135.496,
    "end": 138.518,
    "duration": 3.022
  },
  {
    "id": 35,
    "text": "将生命的苍凉无奈化作余音绕梁的历史叹息。",
    "start": 138.518,
    "end": 140.45,
    "duration": 1.932
  }
]