[
  {
    "id": 1,
    "text": "三十年代中期，沈从文发表中篇小说代表作《边城》，在现代文学史上构筑起一座洋溢着古朴德性与生命诗意的湘西“人性神庙”。",
    "start": 0.107,
    "end": 10.873,
    "duration": 10.766
  },
  {
    "id": 2,
    "text": "作为京派乡土抒情小说的经典之作，其人性美与抒情范式主要展现于以下三个层面：",
    "start": 11.518,
    "end": 18.697,
    "duration": 7.179
  },
  {
    "id": 3,
    "text": "第一，建构不悖乎人性的“善”与“美”，寄托重造民族品德的理想。",
    "start": 19.367,
    "end": 24.979,
    "duration": 5.612
  },
  {
    "id": 4,
    "text": "沈从文避开尖锐的阶级冲突描写，将视线投向古朴闭塞的边陲茶峒。",
    "start": 25.392,
    "end": 31.201,
    "duration": 5.809
  },
  {
    "id": 5,
    "text": "小说人物散发着淳厚质朴的道德光辉：老船夫摆渡五十年仗义轻财，",
    "start": 31.674,
    "end": 37.545,
    "duration": 5.871
  },
  {
    "id": 6,
    "text": "过客塞钱必追还，还自备烟茶款待行人；",
    "start": 38.001,
    "end": 41.612,
    "duration": 3.611
  },
  {
    "id": 7,
    "text": "船总顺顺豪爽重义、乐善好施；",
    "start": 41.958,
    "end": 44.996,
    "duration": 3.038
  },
  {
    "id": 8,
    "text": "天保与傩送兄弟同爱翠翠，却摒弃私心倾轧，相约依循当地风俗夜半山崖对歌，",
    "start": 44.996,
    "end": 51.983,
    "duration": 6.987
  },
  {
    "id": 9,
    "text": "展开堂堂正正的“君子之争”，呈现出未被金钱物欲沾染的高尚人性境界。",
    "start": 52.127,
    "end": 57.861,
    "duration": 5.734
  },
  {
    "id": 10,
    "text": "第二，刻画澄澈纯净的自然之子，塑造优美含蓄的少女典型。",
    "start": 58.474,
    "end": 63.732,
    "duration": 5.258
  },
  {
    "id": 11,
    "text": "翠翠是湘西青山绿水与古朴民风孕育的纯洁生命。",
    "start": 64.222,
    "end": 68.174,
    "duration": 3.952
  },
  {
    "id": 12,
    "text": "她如山头黄麂般天真灵动，端午赛龙舟时在喧嚣鼓声中与傩送偶遇，",
    "start": 68.673,
    "end": 75.021,
    "duration": 6.348
  },
  {
    "id": 13,
    "text": "少女情窦在朦胧含蓄中悄然萌动。",
    "start": 75.529,
    "end": 78.241,
    "duration": 2.712
  },
  {
    "id": 14,
    "text": "沈从文借翠翠在月夜歌声后梦中摘取虎耳草的细节，",
    "start": 78.836,
    "end": 83.012,
    "duration": 4.176
  },
  {
    "id": 15,
    "text": "细腻捕捉了少女情愫与自然节律的契合，赋予人物诗意光彩。",
    "start": 83.273,
    "end": 88.727,
    "duration": 5.454
  },
  {
    "id": 16,
    "text": "第三，融汇诗意意境与散文笔调，奠定哀而不伤的田园牧歌范式。",
    "start": 89.326,
    "end": 95.157,
    "duration": 5.831
  },
  {
    "id": 17,
    "text": "小说语言质朴明净，将湘西风土人情描摹与散文化叙事融为一体。",
    "start": 95.48,
    "end": 101.17,
    "duration": 5.69
  },
  {
    "id": 18,
    "text": "但在恬淡安宁的牧歌氛围下，故事因人事错位与命运无常走向深沉悲凉：",
    "start": 101.517,
    "end": 107.544,
    "duration": 6.027
  },
  {
    "id": 19,
    "text": "天保乘船出走途中在茨滩失事溺亡，傩送负气远走，",
    "start": 107.826,
    "end": 112.46,
    "duration": 4.634
  },
  {
    "id": 20,
    "text": "老船夫于雷雨之夜悄然离世，只留翠翠独守碧溪岨渡船。",
    "start": 112.743,
    "end": 117.761,
    "duration": 5.018
  },
  {
    "id": 21,
    "text": "篇末“这个人也许永远不回来了，也许明天回来”的余韵，将人生的苍凉化作绵长叹息。",
    "start": 118.053,
    "end": 124.913,
    "duration": 6.86
  }
]