[
  {
    "id": 1,
    "text": "三十年代中期，沈从文发表中篇小说代表作《边城》，",
    "start": 0.107,
    "end": 4.296,
    "duration": 4.189
  },
  {
    "id": 2,
    "text": "在现代文学史上构筑起一座洋溢着古朴德性与生命诗意的湘西“人性神庙”。",
    "start": 4.523,
    "end": 10.863,
    "duration": 6.34
  },
  {
    "id": 3,
    "text": "作为京派乡土抒情小说的经典之作，",
    "start": 11.518,
    "end": 14.22,
    "duration": 2.702
  },
  {
    "id": 4,
    "text": "其人性美与抒情范式主要展现于以下三个层面：",
    "start": 14.45,
    "end": 18.688,
    "duration": 4.238
  },
  {
    "id": 5,
    "text": "第一，建构不悖乎人性的“善”与“美”，",
    "start": 19.367,
    "end": 22.458,
    "duration": 3.091
  },
  {
    "id": 6,
    "text": "寄托重造民族品德的理想。",
    "start": 22.913,
    "end": 24.969,
    "duration": 2.056
  },
  {
    "id": 7,
    "text": "沈从文避开尖锐的阶级冲突描写，将视线投向古朴闭塞的边陲茶峒。",
    "start": 25.392,
    "end": 31.191,
    "duration": 5.799
  },
  {
    "id": 8,
    "text": "小说人物散发着淳厚质朴的道德光辉：",
    "start": 31.674,
    "end": 34.668,
    "duration": 2.994
  },
  {
    "id": 9,
    "text": "老船夫摆渡五十年仗义轻财，过客塞钱必追还，",
    "start": 35.105,
    "end": 39.64,
    "duration": 4.535
  },
  {
    "id": 10,
    "text": "还自备烟茶款待行人；船总顺顺豪爽重义、乐善好施；",
    "start": 39.927,
    "end": 44.666,
    "duration": 4.739
  },
  {
    "id": 11,
    "text": "天保与傩送兄弟同爱翠翠，却摒弃私心倾轧，",
    "start": 44.996,
    "end": 49.065,
    "duration": 4.069
  },
  {
    "id": 12,
    "text": "相约依循当地风俗夜半山崖对歌，",
    "start": 49.406,
    "end": 51.974,
    "duration": 2.568
  },
  {
    "id": 13,
    "text": "展开堂堂正正的“君子之争”，",
    "start": 52.127,
    "end": 54.217,
    "duration": 2.09
  },
  {
    "id": 14,
    "text": "呈现出未被金钱物欲沾染的高尚人性境界。",
    "start": 54.66,
    "end": 57.851,
    "duration": 3.191
  },
  {
    "id": 15,
    "text": "第二，刻画澄澈纯净的自然之子，塑造优美含蓄的少女典型。",
    "start": 58.474,
    "end": 63.722,
    "duration": 5.248
  },
  {
    "id": 16,
    "text": "翠翠是湘西青山绿水与古朴民风孕育的纯洁生命。",
    "start": 64.222,
    "end": 68.166,
    "duration": 3.944
  },
  {
    "id": 17,
    "text": "她如山头黄麂般天真灵动，",
    "start": 68.673,
    "end": 70.848,
    "duration": 2.175
  },
  {
    "id": 18,
    "text": "端午赛龙舟时在喧嚣鼓声中与傩送偶遇，",
    "start": 71.361,
    "end": 75.011,
    "duration": 3.65
  },
  {
    "id": 19,
    "text": "少女情窦在朦胧含蓄中悄然萌动。",
    "start": 75.529,
    "end": 78.231,
    "duration": 2.702
  },
  {
    "id": 20,
    "text": "沈从文借翠翠在月夜歌声后梦中摘取虎耳草的细节，",
    "start": 78.836,
    "end": 83.008,
    "duration": 4.172
  },
  {
    "id": 21,
    "text": "细腻捕捉了少女情愫与自然节律的契合，赋予人物诗意光彩。",
    "start": 83.273,
    "end": 88.717,
    "duration": 5.444
  },
  {
    "id": 22,
    "text": "第三，融汇诗意意境与散文笔调，奠定哀而不伤的田园牧歌范式。",
    "start": 89.326,
    "end": 95.147,
    "duration": 5.821
  },
  {
    "id": 23,
    "text": "小说语言质朴明净，将湘西风土人情描摹与散文化叙事融为一体。",
    "start": 95.48,
    "end": 101.16,
    "duration": 5.68
  },
  {
    "id": 24,
    "text": "但在恬淡安宁的牧歌氛围下，",
    "start": 101.517,
    "end": 103.62,
    "duration": 2.103
  },
  {
    "id": 25,
    "text": "故事因人事错位与命运无常走向深沉悲凉：",
    "start": 103.879,
    "end": 107.55,
    "duration": 3.671
  },
  {
    "id": 26,
    "text": "天保乘船出走途中在青浪滩翻船溺亡，傩送负气远走，",
    "start": 107.826,
    "end": 112.627,
    "duration": 4.801
  },
  {
    "id": 27,
    "text": "老船夫于雷雨之夜悄然离世，只留翠翠独守碧溪岨渡船。",
    "start": 112.92,
    "end": 117.937,
    "duration": 5.017
  },
  {
    "id": 28,
    "text": "篇末“这个人也许永远不回来了，也许明天回来”的余韵，",
    "start": 118.23,
    "end": 122.248,
    "duration": 4.018
  },
  {
    "id": 29,
    "text": "将人生的苍凉化作绵长叹息。",
    "start": 122.625,
    "end": 125.09,
    "duration": 2.465
  }
]