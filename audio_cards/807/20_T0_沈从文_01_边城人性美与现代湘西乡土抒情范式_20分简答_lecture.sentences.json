[
  {
    "id": 1,
    "text": "三十年代中期，沈从文发表中篇小说代表作《边城》，",
    "start": 0.16,
    "end": 5.28,
    "duration": 5.12
  },
  {
    "id": 2,
    "text": "在中国现代文学史上成功构筑起一座远离现代都市文明污染、",
    "start": 5.28,
    "end": 10.72,
    "duration": 5.44
  },
  {
    "id": 3,
    "text": "闪烁着原始神性光辉的湘西“人性神庙”。",
    "start": 10.72,
    "end": 15.12,
    "duration": 4.4
  },
  {
    "id": 4,
    "text": "作为京派乡土抒情小说的巅峰之作，",
    "start": 15.12,
    "end": 18.72,
    "duration": 3.6
  },
  {
    "id": 5,
    "text": "其人性美与诗意范式主要展现于以下三个层面：",
    "start": 18.96,
    "end": 23.44,
    "duration": 4.48
  },
  {
    "id": 6,
    "text": "第一，建构不悖乎人性的“善”与“美”，",
    "start": 23.52,
    "end": 28.4,
    "duration": 4.88
  },
  {
    "id": 7,
    "text": "寄托作家重造民族品德的文化理想。",
    "start": 28.4,
    "end": 31.04,
    "duration": 2.64
  },
  {
    "id": 8,
    "text": "沈从文有意避开现代阶级斗争的剧烈冲突，",
    "start": 31.04,
    "end": 34.4,
    "duration": 3.36
  },
  {
    "id": 9,
    "text": "将视线投向古老质朴的边陲茶峒。",
    "start": 34.96,
    "end": 37.92,
    "duration": 2.96
  },
  {
    "id": 10,
    "text": "小说中的人物浑然天成地散发着原始道德的清辉：",
    "start": 37.92,
    "end": 42.72,
    "duration": 4.8
  },
  {
    "id": 11,
    "text": "老船夫摆渡五十年仗义轻财，过客塞钱必追赶奉还，",
    "start": 42.72,
    "end": 47.797,
    "duration": 5.077
  },
  {
    "id": 12,
    "text": "甚至自备烟草好茶款待行客；顺顺豪爽仗义、乐善好施；",
    "start": 47.797,
    "end": 52.232,
    "duration": 4.435
  },
  {
    "id": 13,
    "text": "天保与傩送两兄弟爱上同一个女子翠翠，却毅然摒弃尔虞我诈，",
    "start": 52.232,
    "end": 57.632,
    "duration": 5.4
  },
  {
    "id": 14,
    "text": "遵循古老苗民风俗，",
    "start": 57.632,
    "end": 59.368,
    "duration": 1.736
  },
  {
    "id": 15,
    "text": "相约以山崖夜半对唱情歌的方式进行堂堂正正的“君子之争”，",
    "start": 59.368,
    "end": 64.767,
    "duration": 5.399
  },
  {
    "id": 16,
    "text": "展现出一种未被现代金钱名利异化的高尚人性境界。",
    "start": 64.767,
    "end": 70.48,
    "duration": 5.713
  },
  {
    "id": 17,
    "text": "第二，刻画澄澈纯净的自然之子，",
    "start": 70.48,
    "end": 74.0,
    "duration": 3.52
  },
  {
    "id": 18,
    "text": "塑造现代文学中独一无二的优美女性典型。",
    "start": 74.0,
    "end": 78.08,
    "duration": 4.08
  },
  {
    "id": 19,
    "text": "翠翠是湘西青山绿水与古朴民风共同孕育的精灵。",
    "start": 78.08,
    "end": 83.12,
    "duration": 5.04
  },
  {
    "id": 20,
    "text": "她如同山头上的黄麂，天真活泼、纯洁无暇；",
    "start": 83.12,
    "end": 87.04,
    "duration": 3.92
  },
  {
    "id": 21,
    "text": "在端午节龙舟赛的喧嚣鼓声中与傩送偶然相逢，",
    "start": 87.04,
    "end": 91.76,
    "duration": 4.72
  },
  {
    "id": 22,
    "text": "少女情窦在幽微萌动中既纯真又含蓄。",
    "start": 91.76,
    "end": 94.8,
    "duration": 3.04
  },
  {
    "id": 23,
    "text": "作家通过翠翠在梦中摘取虎耳草的诗意意象，",
    "start": 95.2,
    "end": 98.88,
    "duration": 3.68
  },
  {
    "id": 24,
    "text": "细腻捕捉了少女情愫与自然节律的神秘共振，",
    "start": 98.88,
    "end": 103.52,
    "duration": 4.64
  },
  {
    "id": 25,
    "text": "确立了中国现代抒情小说中永恒的自然之美。",
    "start": 103.52,
    "end": 107.6,
    "duration": 4.08
  },
  {
    "id": 26,
    "text": "第三，融汇诗歌意境与散文笔触，",
    "start": 107.6,
    "end": 110.72,
    "duration": 3.12
  },
  {
    "id": 27,
    "text": "奠定哀而不伤的现代田园牧歌范式。",
    "start": 111.12,
    "end": 114.4,
    "duration": 3.28
  },
  {
    "id": 28,
    "text": "小说语言洗练质朴、如山泉般清澈明净，",
    "start": 114.4,
    "end": 118.08,
    "duration": 3.68
  },
  {
    "id": 29,
    "text": "将风土人情描摹与散文化叙事完美融为一体。",
    "start": 118.08,
    "end": 122.08,
    "duration": 4.0
  },
  {
    "id": 30,
    "text": "然而在恬淡安宁的牧歌外壳下，小说最终走向了因人事错位、",
    "start": 122.08,
    "end": 127.44,
    "duration": 5.36
  },
  {
    "id": 31,
    "text": "偶然宿命而引发的深沉悲凉：天保下油坊溺亡，",
    "start": 127.44,
    "end": 131.52,
    "duration": 4.08
  },
  {
    "id": 32,
    "text": "傩送负气远走他乡，老船夫在雷雨之夜溘然长逝，",
    "start": 131.52,
    "end": 136.32,
    "duration": 4.8
  },
  {
    "id": 33,
    "text": "只留下翠翠在碧溪岨孤独守着渡船。",
    "start": 136.32,
    "end": 139.6,
    "duration": 3.28
  },
  {
    "id": 34,
    "text": "结尾那句“这个人也许永远不回来了，也许明天回来”，",
    "start": 139.6,
    "end": 140.4,
    "duration": 0.8
  },
  {
    "id": 35,
    "text": "将生命的苍凉无奈化作余音绕梁的历史叹息。",
    "start": 140.16,
    "end": 140.4,
    "duration": 0.24
  }
]