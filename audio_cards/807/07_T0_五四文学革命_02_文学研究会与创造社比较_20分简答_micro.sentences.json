[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "五四文学革命·文学研究会与创造社比较",
    "start": 0.154,
    "end": 3.526,
    "duration": 3.372
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "比较紧扣“同源分流、双峰对峙”三层对照：1.观念（《小说月报》“为人生”反消遣 vs “为艺术”尚直觉灵感）；",
    "start": 4.234,
    "end": 14.566,
    "duration": 10.332
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "2.方法（叶圣陶冷静写实 vs 郭郁浪漫直抒）；",
    "start": 14.844,
    "end": 19.656,
    "duration": 4.812
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "3.精神与后期演进（本土启蒙理性深耕写实 vs 留日苦闷反叛转向无产阶级革命文学）。",
    "start": 19.934,
    "end": 28.186,
    "duration": 8.252
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "文学研究会与创造社为现代新文学初期成立最早、影响最大两大社团，",
    "start": 28.658,
    "end": 34.51,
    "duration": 5.852
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "同源五四启蒙却呈现鲜明同源分流与双峰对峙格局。",
    "start": 34.818,
    "end": 39.87,
    "duration": 5.052
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 文学观念：“为人生”启蒙 vs “为艺术”自足",
    "start": 40.523,
    "end": 44.935,
    "duration": 4.412
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "以《小说月报》为阵地高扬“为人生而艺术”，反鸳鸯蝴蝶派游戏消遣，主研究人生、暴露病态；",
    "start": 45.38,
    "end": 55.152,
    "duration": 9.772
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "高举“为艺术而艺术”，视文学为内在情感要求，重直觉、灵感、主观自我与个性纯粹自由。",
    "start": 55.647,
    "end": 65.339,
    "duration": 9.692
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 创作方法：冷静写实主义 vs 主观浪漫抒情",
    "start": 65.998,
    "end": 70.73,
    "duration": 4.732
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "研究会恪守写实，冷静客观摹写底层与市民灰色生活，如叶圣陶《潘先生在难中》剖小市民妥协心理；",
    "start": 71.258,
    "end": 80.07,
    "duration": 8.812
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "创造社信奉浪漫主义与表现主义，直抒胸臆擅写反叛与病态心理，",
    "start": 80.58,
    "end": 86.832,
    "duration": 6.252
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "如郭沫若《女神》火山爆发与郁达夫《沉沦》自叙传。",
    "start": 87.06,
    "end": 90.992,
    "duration": 3.932
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 精神渊源与后期演进：社会理性 vs 感性反叛",
    "start": 91.661,
    "end": 95.993,
    "duration": 4.332
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "立足国内现实，承接启蒙沉稳社会批判理性，后期持续深化现实主义；",
    "start": 96.512,
    "end": 104.124,
    "duration": 7.612
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "崛起于留日青年异邦屈辱与苦闷，承接炽烈个性反叛激情，",
    "start": 104.652,
    "end": 111.144,
    "duration": 6.492
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "大革命退潮前后与太阳社一道倡“革命文学”，迅速转向无产阶级革命文学。",
    "start": 111.612,
    "end": 117.704,
    "duration": 6.092
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "两大社团各执一端又相辅相成，以双峰对峙多元探索共奠现代新文学现实主义与浪漫主义交相辉映格局。",
    "start": 118.405,
    "end": 127.777,
    "duration": 9.372
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：文学研究会（1921北京，周作人/茅盾/叶圣陶，《小说月报》）；",
    "start": 128.485,
    "end": 135.697,
    "duration": 7.212
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "创造社（1921东京，郭沫若/郁达夫/成仿吾，《创造》季刊），",
    "start": 136.055,
    "end": 141.107,
    "duration": 5.052
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "大革命退潮前后创造社与太阳社一道倡导“革命文学”。",
    "start": 141.255,
    "end": 145.107,
    "duration": 3.852
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背清两大社团的成立年份、地点、代表发起人及核心刊物阵地？",
    "start": 145.799,
    "end": 151.971,
    "duration": 6.172
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 从“观念、方法与代表作、精神与后期转向”三层对照两社异同？",
    "start": 152.479,
    "end": 159.611,
    "duration": 7.132
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 解释创造社为什么会从五四“为艺术而艺术”180度大转向“革命文学”？",
    "start": 160.139,
    "end": 167.751,
    "duration": 7.612
  }
]