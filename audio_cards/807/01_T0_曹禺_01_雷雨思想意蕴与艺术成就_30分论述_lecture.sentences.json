[
  {
    "id": 1,
    "text": "一、全题宏观破题与总揽。",
    "start": 0.0,
    "end": 2.139,
    "duration": 2.139
  },
  {
    "id": 2,
    "text": "一、这道题到底要回答什么？",
    "start": 2.139,
    "end": 4.492,
    "duration": 2.353
  },
  {
    "id": 3,
    "text": "本题是、八零七、专业课中最核心的戏剧综合大题，",
    "start": 4.492,
    "end": 8.77,
    "duration": 4.278
  },
  {
    "id": 4,
    "text": "分值为、三十、分。",
    "start": 8.77,
    "end": 10.053,
    "duration": 1.283
  },
  {
    "id": 5,
    "text": "它考查的核心目的，是要求考生从文学史的高度，",
    "start": 10.053,
    "end": 14.331,
    "duration": 4.278
  },
  {
    "id": 6,
    "text": "全面论证曹禺《雷雨》作为中国现代话剧走向完全成熟的全部合法性。",
    "start": 14.331,
    "end": 20.32,
    "duration": 5.989
  },
  {
    "id": 7,
    "text": "二、应该从什么方向回答？",
    "start": 20.48,
    "end": 22.56,
    "duration": 2.08
  },
  {
    "id": 8,
    "text": "回答这道题不能仅停留在思想主题的社会学提炼上，",
    "start": 22.56,
    "end": 26.8,
    "duration": 4.24
  },
  {
    "id": 9,
    "text": "也不能孤立地赏析舞台技巧。",
    "start": 26.8,
    "end": 29.04,
    "duration": 2.24
  },
  {
    "id": 10,
    "text": "必须将思想的深刻性、人性的复杂性与戏剧本体的形式规律有机熔铸在一起，",
    "start": 29.04,
    "end": 35.28,
    "duration": 6.24
  },
  {
    "id": 11,
    "text": "展现出高水平的研究生学术视野。",
    "start": 35.28,
    "end": 37.84,
    "duration": 2.56
  },
  {
    "id": 12,
    "text": "三、从哪些方面展开论述？",
    "start": 38.16,
    "end": 40.4,
    "duration": 2.24
  },
  {
    "id": 13,
    "text": "全篇确立三个核心展开维度：第一是思想意蕴的双重维度。",
    "start": 40.4,
    "end": 45.44,
    "duration": 5.04
  },
  {
    "id": 14,
    "text": "第二是人物性格的深层开掘。",
    "start": 45.44,
    "end": 47.68,
    "duration": 2.24
  },
  {
    "id": 15,
    "text": "第三是戏剧形式的高压营造。",
    "start": 47.68,
    "end": 50.0,
    "duration": 2.32
  },
  {
    "id": 16,
    "text": "四、这三个维度之间的内在逻辑是什么？",
    "start": 50.0,
    "end": 52.88,
    "duration": 2.88
  },
  {
    "id": 17,
    "text": "这三个维度构成了一个由内而外、层层具象化的严密递进链条。",
    "start": 52.88,
    "end": 57.6,
    "duration": 4.72
  },
  {
    "id": 18,
    "text": "思想意蕴是剧作的精神内核与灵魂，",
    "start": 58.0,
    "end": 61.68,
    "duration": 3.68
  },
  {
    "id": 19,
    "text": "决定了作品能够达到的哲学高度。",
    "start": 61.68,
    "end": 64.32,
    "duration": 2.64
  },
  {
    "id": 20,
    "text": "人物塑造是戏剧思想的具象载体与行动主体，",
    "start": 64.32,
    "end": 68.64,
    "duration": 4.32
  },
  {
    "id": 21,
    "text": "深邃的思想必须依托于活生生的人物冲突才能显影。",
    "start": 68.64,
    "end": 73.52,
    "duration": 4.88
  },
  {
    "id": 22,
    "text": "艺术形式则是戏剧作为综合舞台艺术的媒介本体，",
    "start": 73.52,
    "end": 77.68,
    "duration": 4.16
  },
  {
    "id": 23,
    "text": "人物的撕裂与思想的博弈最终必须落实为精湛的时空结构与舞台语言。",
    "start": 77.68,
    "end": 83.92,
    "duration": 6.24
  },
  {
    "id": 24,
    "text": "从精神内核，到行动载体，再到媒介形式，",
    "start": 84.32,
    "end": 88.4,
    "duration": 4.08
  },
  {
    "id": 25,
    "text": "三者环环相扣，构成了论证不可动摇的内在必然性。",
    "start": 88.4,
    "end": 93.36,
    "duration": 4.96
  },
  {
    "id": 26,
    "text": "二、第一板块：引论段逐句咬合精解。",
    "start": 93.36,
    "end": 97.36,
    "duration": 4.0
  },
  {
    "id": 27,
    "text": "本段承担全篇论述的前提确立任务。",
    "start": 97.36,
    "end": 100.64,
    "duration": 3.28
  },
  {
    "id": 28,
    "text": "整段要解决的是四个连贯的问题：确立最高定性、",
    "start": 100.64,
    "end": 104.96,
    "duration": 4.32
  },
  {
    "id": 29,
    "text": "展开历史反衬、界定成熟内涵，以及确立下文的三大论述支柱。",
    "start": 104.96,
    "end": 110.48,
    "duration": 5.52
  },
  {
    "id": 30,
    "text": "具体表述到答题语句就是：一九三四年曹禺《雷雨》的发表，",
    "start": 110.8,
    "end": 114.96,
    "duration": 4.16
  },
  {
    "id": 31,
    "text": "标志着中国现代话剧文学走向完全成熟。",
    "start": 114.96,
    "end": 118.24,
    "duration": 3.28
  },
  {
    "id": 32,
    "text": "这是确立《雷雨》在中国现代话剧史上完全成熟的最高定性。",
    "start": 118.24,
    "end": 122.4,
    "duration": 4.16
  },
  {
    "id": 33,
    "text": "成熟这一概念必须建立在历史参照系之上，",
    "start": 122.4,
    "end": 125.6,
    "duration": 3.2
  },
  {
    "id": 34,
    "text": "紧接着展开历史反衬，具体表述到答题语句就是：它彻底终结了早期文明戏与五四“问题剧”的生硬直白。",
    "start": 125.6,
    "end": 133.44,
    "duration": 7.84
  },
  {
    "id": 35,
    "text": "这是指出它对话剧早期幼稚形态的根本超越，",
    "start": 133.68,
    "end": 137.44,
    "duration": 3.76
  },
  {
    "id": 36,
    "text": "让成熟的判断有了真实的历史依据。",
    "start": 137.44,
    "end": 140.32,
    "duration": 2.88
  },
  {
    "id": 37,
    "text": "既然指出了它终结了生硬直白，紧接着必须界定成熟的具体内涵，",
    "start": 140.624,
    "end": 145.904,
    "duration": 5.28
  },
  {
    "id": 38,
    "text": "具体表述到答题语句就是：剧作将西方严密戏剧技巧、",
    "start": 145.904,
    "end": 150.304,
    "duration": 4.4
  },
  {
    "id": 39,
    "text": "深邃现代人性审视与尖锐宗法批判融为一体。",
    "start": 150.304,
    "end": 154.224,
    "duration": 3.92
  },
  {
    "id": 40,
    "text": "这是从形式技巧、人性挖掘与思想批判三个维度，",
    "start": 154.224,
    "end": 158.464,
    "duration": 4.24
  },
  {
    "id": 41,
    "text": "将抽象的成熟落实为扎实的学术指标。",
    "start": 158.464,
    "end": 161.504,
    "duration": 3.04
  },
  {
    "id": 42,
    "text": "有了具体内涵之后，紧接着总领下文展开的三大支柱，",
    "start": 161.824,
    "end": 165.744,
    "duration": 3.92
  },
  {
    "id": 43,
    "text": "具体表述到答题语句就是：其思想意蕴的双重维度、",
    "start": 165.744,
    "end": 170.384,
    "duration": 4.64
  },
  {
    "id": 44,
    "text": "人物性格的深层开掘以及戏剧形式的高压营造，",
    "start": 170.384,
    "end": 174.464,
    "duration": 4.08
  },
  {
    "id": 45,
    "text": "共同奠定了这一成熟范式的经典地位。",
    "start": 174.464,
    "end": 177.584,
    "duration": 3.12
  },
  {
    "id": 46,
    "text": "这是给全篇论述搭好骨架，形成引论段由定性到立论的严密闭环。",
    "start": 177.584,
    "end": 183.184,
    "duration": 5.6
  },
  {
    "id": 47,
    "text": "三、第二板块：主体一•思想意蕴逐句咬合精解。",
    "start": 183.504,
    "end": 188.784,
    "duration": 5.28
  },
  {
    "id": 48,
    "text": "本段旨在论证《雷雨》思想的深度与广度。",
    "start": 188.784,
    "end": 192.064,
    "duration": 3.28
  },
  {
    "id": 49,
    "text": "核心是要打破单向度的政治图解，揭示其双层悲剧结构。",
    "start": 192.064,
    "end": 196.784,
    "duration": 4.72
  },
  {
    "id": 50,
    "text": "整段逻辑是从看得见的社会现实阶级批判，",
    "start": 196.784,
    "end": 200.224,
    "duration": 3.44
  },
  {
    "id": 51,
    "text": "自然深入到超越阶级批判的深层命运悲剧。",
    "start": 200.224,
    "end": 203.504,
    "duration": 3.28
  },
  {
    "id": 52,
    "text": "进入思想意蕴，段首结论先行，具体表述到答题语句就是：第一，",
    "start": 203.744,
    "end": 209.184,
    "duration": 5.44
  },
  {
    "id": 53,
    "text": "在思想意蕴上，《雷雨》实现了现实社会批判与深层命运悲剧的有机融合。",
    "start": 209.184,
    "end": 214.864,
    "duration": 5.68
  },
  {
    "id": 54,
    "text": "这是确立本段的总论点，定下了由现实向哲学双层推进的基调。",
    "start": 214.864,
    "end": 219.904,
    "duration": 5.04
  },
  {
    "id": 55,
    "text": "论证首先立足于具体的经验历史层面，",
    "start": 219.904,
    "end": 222.704,
    "duration": 2.8
  },
  {
    "id": 56,
    "text": "具体表述到答题语句就是：在社会历史维度上，",
    "start": 222.704,
    "end": 226.304,
    "duration": 3.6
  },
  {
    "id": 57,
    "text": "剧作具有极为深刻的反封建批判锋芒。",
    "start": 226.304,
    "end": 229.264,
    "duration": 2.96
  },
  {
    "id": 58,
    "text": "这是提出社会现实维度的核心价值判断。",
    "start": 229.664,
    "end": 232.544,
    "duration": 2.88
  },
  {
    "id": 59,
    "text": "有了批判锋芒的判断，紧接着调取剧作的核心冲突线索作为实证，",
    "start": 232.544,
    "end": 237.584,
    "duration": 5.04
  },
  {
    "id": 60,
    "text": "具体表述到答题语句就是：全剧通过周、",
    "start": 237.584,
    "end": 240.784,
    "duration": 3.2
  },
  {
    "id": 61,
    "text": "鲁两家三十年的恩怨纠葛，无情撕开了封建宗法大家庭的伪善帷幕。",
    "start": 240.784,
    "end": 245.984,
    "duration": 5.2
  },
  {
    "id": 62,
    "text": "这是用两家三十年的恩怨，将反封建批判具象化。",
    "start": 245.984,
    "end": 249.504,
    "duration": 3.52
  },
  {
    "id": 63,
    "text": "有了冲突框架，紧接着锁定阶级压迫的具体承担者，",
    "start": 249.824,
    "end": 253.664,
    "duration": 3.84
  },
  {
    "id": 64,
    "text": "具体表述到答题语句就是：以周朴园为代表的封建资本家，",
    "start": 253.664,
    "end": 258.176,
    "duration": 4.512
  },
  {
    "id": 65,
    "text": "残酷压迫工人阶级并枪害下层女性。",
    "start": 258.176,
    "end": 261.056,
    "duration": 2.88
  },
  {
    "id": 66,
    "text": "这是用淹死工人与抛弃侍萍的血泪事实，",
    "start": 261.056,
    "end": 264.32,
    "duration": 3.264
  },
  {
    "id": 67,
    "text": "做实阶级压迫。",
    "start": 264.32,
    "end": 265.472,
    "duration": 1.152
  },
  {
    "id": 68,
    "text": "落实现实罪恶之后，紧接着做出机制层面的批判收束，",
    "start": 265.472,
    "end": 269.696,
    "duration": 4.224
  },
  {
    "id": 69,
    "text": "具体表述到答题语句就是：这直接控诉了封建阶级压迫与专制制度对人性的扼杀。",
    "start": 269.696,
    "end": 276.224,
    "duration": 6.528
  },
  {
    "id": 70,
    "text": "这是完成社会历史维度的严密收口。",
    "start": 276.224,
    "end": 279.104,
    "duration": 2.88
  },
  {
    "id": 71,
    "text": "社会批判论透之后，紧接着实现思维向哲学维度的跃迁，",
    "start": 279.328,
    "end": 284.128,
    "duration": 4.8
  },
  {
    "id": 72,
    "text": "具体表述到答题语句就是：在形而上哲学维度上，",
    "start": 284.128,
    "end": 288.128,
    "duration": 4.0
  },
  {
    "id": 73,
    "text": "剧作超越了同时代普通的社会问题剧。",
    "start": 288.128,
    "end": 291.488,
    "duration": 3.36
  },
  {
    "id": 74,
    "text": "这是开启第二层次、拉开思想深度差距的关键枢纽句。",
    "start": 291.488,
    "end": 295.888,
    "duration": 4.4
  },
  {
    "id": 75,
    "text": "为了证明这种哲学超越并非空穴来风，",
    "start": 295.888,
    "end": 299.168,
    "duration": 3.28
  },
  {
    "id": 76,
    "text": "紧接着调取作者的创作宣言作为直接论据，",
    "start": 299.168,
    "end": 302.768,
    "duration": 3.6
  },
  {
    "id": 77,
    "text": "具体表述到答题语句就是：曹禺在《雷雨序》中明确表达，",
    "start": 302.768,
    "end": 307.648,
    "duration": 4.88
  },
  {
    "id": 78,
    "text": "其创作源于对天地间不可知神秘事物的敬畏。",
    "start": 307.648,
    "end": 311.248,
    "duration": 3.6
  },
  {
    "id": 79,
    "text": "这是用剧作家的原始自白，确立探寻宇宙命运之谜的合法性。",
    "start": 311.408,
    "end": 316.288,
    "duration": 4.88
  },
  {
    "id": 80,
    "text": "确立了敬畏神秘力量之后，紧接着解释这种哲学观念如何转化为具体的舞台形式，",
    "start": 316.288,
    "end": 323.248,
    "duration": 6.96
  },
  {
    "id": 81,
    "text": "具体表述到答题语句就是：作品通过弥漫全剧的“郁热”气候与雷雨意象，",
    "start": 323.248,
    "end": 329.328,
    "duration": 6.08
  },
  {
    "id": 82,
    "text": "营构出超自然的宿命压抑感。",
    "start": 329.328,
    "end": 331.648,
    "duration": 2.32
  },
  {
    "id": 83,
    "text": "这是用环境意象解析命运压抑的艺术机制。",
    "start": 331.808,
    "end": 335.168,
    "duration": 3.36
  },
  {
    "id": 84,
    "text": "有了宿命压抑感，紧接着揭示人物与命运对抗的悲剧律令，",
    "start": 335.168,
    "end": 339.728,
    "duration": 4.56
  },
  {
    "id": 85,
    "text": "具体表述到答题语句就是：剧中人物越是奋力挣扎，",
    "start": 339.728,
    "end": 343.968,
    "duration": 4.24
  },
  {
    "id": 86,
    "text": "越加速走向家族伦理的瓦解与个体的毁灭。",
    "start": 343.968,
    "end": 347.648,
    "duration": 3.68
  },
  {
    "id": 87,
    "text": "这是揭示挣扎反而加深毁灭的古希腊悲剧铁律。",
    "start": 347.648,
    "end": 351.168,
    "duration": 3.52
  },
  {
    "id": 88,
    "text": "最后将现实与哲学合流收束本段，具体表述到答题语句就是：这种社会批判与希腊式命运悲剧的结合，",
    "start": 351.488,
    "end": 360.848,
    "duration": 9.36
  },
  {
    "id": 89,
    "text": "赋予了剧作恒久的哲学深度。",
    "start": 360.848,
    "end": 363.328,
    "duration": 2.48
  },
  {
    "id": 90,
    "text": "这是呼应段首总论点，完成思想意蕴的闭环。",
    "start": 363.328,
    "end": 367.248,
    "duration": 3.92
  },
  {
    "id": 91,
    "text": "四、第三板块：主体二•人物塑造逐句咬合精解。",
    "start": 367.248,
    "end": 371.568,
    "duration": 4.32
  },
  {
    "id": 92,
    "text": "本段承接上一段的思想意蕴，论述抽象的思想如何在具体的舞台人物身上落实。",
    "start": 371.808,
    "end": 378.208,
    "duration": 6.4
  },
  {
    "id": 93,
    "text": "核心要攻克中国现代早期戏剧人物非黑即白、",
    "start": 378.208,
    "end": 382.208,
    "duration": 4.0
  },
  {
    "id": 94,
    "text": "脸谱化的通病。",
    "start": 382.208,
    "end": 383.648,
    "duration": 1.44
  },
  {
    "id": 95,
    "text": "整段组织采用对立统一的双极对照策略，",
    "start": 383.648,
    "end": 387.008,
    "duration": 3.36
  },
  {
    "id": 96,
    "text": "通过压迫者周朴园与反抗者凡漪两大人格样本，",
    "start": 387.008,
    "end": 391.008,
    "duration": 4.0
  },
  {
    "id": 97,
    "text": "剖析人性的复杂悖论与生命绝叫。",
    "start": 391.008,
    "end": 393.728,
    "duration": 2.72
  },
  {
    "id": 98,
    "text": "承接思想意蕴，论证必须落实在具体的舞台行动者身上，",
    "start": 394.048,
    "end": 398.848,
    "duration": 4.8
  },
  {
    "id": 99,
    "text": "段首具体表述到答题语句就是：第二，",
    "start": 398.848,
    "end": 402.208,
    "duration": 3.36
  },
  {
    "id": 100,
    "text": "在人物塑造上，《雷雨》打破了非黑即白的脸谱化模式，",
    "start": 402.208,
    "end": 406.368,
    "duration": 4.16
  },
  {
    "id": 101,
    "text": "深刻揭示了人性的复杂性与多面性。",
    "start": 406.368,
    "end": 409.328,
    "duration": 2.96
  },
  {
    "id": 102,
    "text": "这是确立人物塑造的总论点，直接击中现代戏剧摆脱幼稚脸谱的核心突破。",
    "start": 409.328,
    "end": 414.688,
    "duration": 5.36
  },
  {
    "id": 103,
    "text": "论证首先攻坚压迫者周朴园这一典型，",
    "start": 414.928,
    "end": 418.288,
    "duration": 3.36
  },
  {
    "id": 104,
    "text": "具体表述到答题语句就是：首先是周朴园这一经典形象的复杂性格开掘。",
    "start": 418.288,
    "end": 424.448,
    "duration": 6.16
  },
  {
    "id": 105,
    "text": "这是引出专制家长的论述对象。",
    "start": 424.448,
    "end": 426.688,
    "duration": 2.24
  },
  {
    "id": 106,
    "text": "紧接着剖析周朴园内部的人格分裂，",
    "start": 427.144,
    "end": 429.864,
    "duration": 2.72
  },
  {
    "id": 107,
    "text": "具体表述到答题语句就是：他既是冷酷镇压工人并专制统治家庭的封建暴君，",
    "start": 429.864,
    "end": 436.104,
    "duration": 6.24
  },
  {
    "id": 108,
    "text": "也是保留着旧日温情幻觉的情感落魄者。",
    "start": 436.104,
    "end": 439.464,
    "duration": 3.36
  },
  {
    "id": 109,
    "text": "这是把专制残暴与情感落魄并置，确立其矛盾张力。",
    "start": 439.464,
    "end": 443.704,
    "duration": 4.24
  },
  {
    "id": 110,
    "text": "有了性格矛盾，紧接着调取核心情节证据深入其心理机制，",
    "start": 443.704,
    "end": 448.344,
    "duration": 4.64
  },
  {
    "id": 111,
    "text": "具体表述到答题语句就是：他对三十年前侍萍的怀念，",
    "start": 448.344,
    "end": 452.584,
    "duration": 4.24
  },
  {
    "id": 112,
    "text": "既包含自我道德美化的伪善，也潜藏对未受金钱污染纯洁人性的真实追恋。",
    "start": 452.584,
    "end": 458.424,
    "duration": 5.84
  },
  {
    "id": 113,
    "text": "这是剖析关窗与保留旧家具背后，伪善与真情交织的深层心理机制。",
    "start": 458.664,
    "end": 464.424,
    "duration": 5.76
  },
  {
    "id": 114,
    "text": "剖析完机制，紧接着总结其艺术贡献，",
    "start": 464.424,
    "end": 467.704,
    "duration": 3.28
  },
  {
    "id": 115,
    "text": "具体表述到答题语句就是：这种善恶交织的人格悖论，",
    "start": 467.704,
    "end": 472.024,
    "duration": 4.32
  },
  {
    "id": 116,
    "text": "打破了传统反面角色的平面化。",
    "start": 472.024,
    "end": 474.824,
    "duration": 2.8
  },
  {
    "id": 117,
    "text": "这是坐实周朴园这一人物性格的立体厚度。",
    "start": 474.824,
    "end": 477.944,
    "duration": 3.12
  },
  {
    "id": 118,
    "text": "攻下压迫者之后，笔锋必然转向承受压迫并拼死反叛的女性，",
    "start": 478.264,
    "end": 483.304,
    "duration": 5.04
  },
  {
    "id": 119,
    "text": "具体表述到答题语句就是：其次是凡漪作为全剧核心的“雷雨式性格”。",
    "start": 483.304,
    "end": 488.644,
    "duration": 5.34
  },
  {
    "id": 120,
    "text": "这是引出全剧性格烈度最高的核心反抗者。",
    "start": 488.644,
    "end": 492.097,
    "duration": 3.453
  },
  {
    "id": 121,
    "text": "紧接着交代其生存困境与性格成因，",
    "start": 492.097,
    "end": 494.974,
    "duration": 2.877
  },
  {
    "id": 122,
    "text": "具体表述到答题语句就是：她受过现代文明浸润，",
    "start": 494.974,
    "end": 498.811,
    "duration": 3.837
  },
  {
    "id": 123,
    "text": "却被长期禁锢在窒息腐朽的封建死屋之中。",
    "start": 498.811,
    "end": 502.264,
    "duration": 3.453
  },
  {
    "id": 124,
    "text": "这是揭示现代意识与窒息死屋的剧烈挤压。",
    "start": 502.344,
    "end": 506.024,
    "duration": 3.68
  },
  {
    "id": 125,
    "text": "在这种挤压之下，紧接着推导其反常行为背后的心理动力，",
    "start": 506.024,
    "end": 510.744,
    "duration": 4.72
  },
  {
    "id": 126,
    "text": "具体表述到答题语句就是：她对周萍绝望而畸形的依恋，",
    "start": 510.744,
    "end": 515.384,
    "duration": 4.64
  },
  {
    "id": 127,
    "text": "是生命原动力被扼杀后的残酷反弹。",
    "start": 515.384,
    "end": 518.424,
    "duration": 3.04
  },
  {
    "id": 128,
    "text": "这是将畸形恋情还原为被压抑生命本能的绝望爆发。",
    "start": 518.424,
    "end": 522.424,
    "duration": 4.0
  },
  {
    "id": 129,
    "text": "最后提炼其悲剧意蕴的形而上高度，",
    "start": 522.744,
    "end": 525.464,
    "duration": 2.72
  },
  {
    "id": 130,
    "text": "具体表述到答题语句就是：曹禺通过她困兽式的挣扎与玉石俱焚的反抗，",
    "start": 525.464,
    "end": 531.144,
    "duration": 5.68
  },
  {
    "id": 131,
    "text": "展现了女性生命本体最悲壮的精神撕裂。",
    "start": 531.144,
    "end": 534.344,
    "duration": 3.2
  },
  {
    "id": 132,
    "text": "这是完成对凡漪悲剧价值的理论定性，",
    "start": 534.344,
    "end": 537.144,
    "duration": 2.8
  },
  {
    "id": 133,
    "text": "与周朴园共同构筑起复杂的人性光谱。",
    "start": 537.144,
    "end": 539.944,
    "duration": 2.8
  },
  {
    "id": 134,
    "text": "五、第四板块：主体三•艺术形式逐句咬合精解。",
    "start": 540.344,
    "end": 544.584,
    "duration": 4.24
  },
  {
    "id": 135,
    "text": "本段将论述深入到戏剧作为综合舞台艺术的媒介本体。",
    "start": 544.584,
    "end": 549.064,
    "duration": 4.48
  },
  {
    "id": 136,
    "text": "戏剧必须依靠时空形式与对白语言产生动作与张力。",
    "start": 549.064,
    "end": 553.464,
    "duration": 4.4
  },
  {
    "id": 137,
    "text": "整段组织由外在宏观的时空压缩结构，",
    "start": 553.464,
    "end": 556.664,
    "duration": 3.2
  },
  {
    "id": 138,
    "text": "深入到内在微观的心灵动作语言，完整闭合形式维度的论证。",
    "start": 556.664,
    "end": 561.224,
    "duration": 4.56
  },
  {
    "id": 139,
    "text": "论述从内容走向形式媒介，段首提纲窃领，",
    "start": 561.608,
    "end": 565.608,
    "duration": 4.0
  },
  {
    "id": 140,
    "text": "具体表述到答题语句就是：第三，在艺术形式上，",
    "start": 565.608,
    "end": 570.088,
    "duration": 4.48
  },
  {
    "id": 141,
    "text": "《雷雨》确立了回溯式高压戏剧结构与心灵动作性的语言典范。",
    "start": 570.088,
    "end": 575.288,
    "duration": 5.2
  },
  {
    "id": 142,
    "text": "这是确立形式维度的总论点，直接划定时空结构与戏剧语言两大支柱。",
    "start": 575.288,
    "end": 581.128,
    "duration": 5.84
  },
  {
    "id": 143,
    "text": "首先处理宏观的时空结构，具体表述到答题语句就是：在结构布局上，",
    "start": 581.448,
    "end": 586.513,
    "duration": 5.065
  },
  {
    "id": 144,
    "text": "剧作创造性地化用了西方古典主义“三一律”法则。",
    "start": 586.513,
    "end": 590.205,
    "duration": 3.692
  },
  {
    "id": 145,
    "text": "这是点明戏剧形式借鉴西方古典规范的原型。",
    "start": 590.205,
    "end": 593.713,
    "duration": 3.508
  },
  {
    "id": 146,
    "text": "紧接着交代时空高度浓缩的具体机制，",
    "start": 593.713,
    "end": 596.666,
    "duration": 2.953
  },
  {
    "id": 147,
    "text": "具体表述到答题语句就是：全剧将两代人三十年的纷繁罪恶与乱伦恩怨，",
    "start": 596.666,
    "end": 602.205,
    "duration": 5.539
  },
  {
    "id": 148,
    "text": "高度浓缩在一天之内与周、鲁两家客厅之中。",
    "start": 602.205,
    "end": 605.528,
    "duration": 3.323
  },
  {
    "id": 149,
    "text": "这是说明巨大历史跨度向一天两地的极限压缩。",
    "start": 605.608,
    "end": 609.768,
    "duration": 4.16
  },
  {
    "id": 150,
    "text": "为了实现这种极端压缩，紧接着指出推进戏剧叙事的核心手法，",
    "start": 609.768,
    "end": 615.288,
    "duration": 5.52
  },
  {
    "id": 151,
    "text": "具体表述到答题语句就是：剧作采用精密的回溯式手法，",
    "start": 615.288,
    "end": 620.328,
    "duration": 5.04
  },
  {
    "id": 152,
    "text": "让过去的隐秘在现时的危机中层层引爆。",
    "start": 620.328,
    "end": 624.008,
    "duration": 3.68
  },
  {
    "id": 153,
    "text": "这是揭示前史信息如何层层揭开并引爆当下危机。",
    "start": 624.008,
    "end": 628.488,
    "duration": 4.48
  },
  {
    "id": 154,
    "text": "紧接着总结回溯式结构带来的美学效应，",
    "start": 628.728,
    "end": 632.008,
    "duration": 3.28
  },
  {
    "id": 155,
    "text": "具体表述到答题语句就是：全剧从一开始便处于危机一触即发的高压状态。",
    "start": 632.008,
    "end": 638.548,
    "duration": 6.54
  },
  {
    "id": 156,
    "text": "这是点明戏剧张力自始至终紧绷如高压锅的艺术效果。",
    "start": 638.548,
    "end": 643.46,
    "duration": 4.912
  },
  {
    "id": 157,
    "text": "结构确立之后，紧接着深入微观的舞台语言，",
    "start": 643.46,
    "end": 647.304,
    "duration": 3.844
  },
  {
    "id": 158,
    "text": "具体表述到答题语句就是：在戏剧语言上，",
    "start": 647.304,
    "end": 650.935,
    "duration": 3.631
  },
  {
    "id": 159,
    "text": "对话摆脱了机械生硬的概念化说教，",
    "start": 650.935,
    "end": 654.138,
    "duration": 3.203
  },
  {
    "id": 160,
    "text": "具有深邃的潜台词与心灵动作性。",
    "start": 654.138,
    "end": 657.128,
    "duration": 2.99
  },
  {
    "id": 161,
    "text": "这是界定台词摆脱宣教、充满心理动作的本质特征。",
    "start": 657.208,
    "end": 660.968,
    "duration": 3.76
  },
  {
    "id": 162,
    "text": "为了证明心灵动作性，紧接着调取全剧最著名的名场面作为实证，",
    "start": 660.968,
    "end": 666.168,
    "duration": 5.2
  },
  {
    "id": 163,
    "text": "具体表述到答题语句就是：以经典的“逼喝苦药”一场为例，",
    "start": 666.168,
    "end": 670.488,
    "duration": 4.32
  },
  {
    "id": 164,
    "text": "平静台词的深处涌动着极权家长的意志压制与各方力量的惊险角力。",
    "start": 670.488,
    "end": 675.848,
    "duration": 5.36
  },
  {
    "id": 165,
    "text": "这是以台词深处的权力博弈坐实心理动作。",
    "start": 676.168,
    "end": 680.008,
    "duration": 3.84
  },
  {
    "id": 166,
    "text": "最后总结舞台语言的美学升华，具体表述到答题语句就是：台词成功外化了隐秘的心理波澜，",
    "start": 680.008,
    "end": 688.168,
    "duration": 8.16
  },
  {
    "id": 167,
    "text": "使剧作洋溢着交响乐般的诗意张力。",
    "start": 688.168,
    "end": 691.368,
    "duration": 3.2
  },
  {
    "id": 168,
    "text": "这是完成对戏剧语言诗性高度的闭环论证。",
    "start": 691.368,
    "end": 694.648,
    "duration": 3.28
  },
  {
    "id": 169,
    "text": "六、第五板块：结语段逐句咬合精解。",
    "start": 694.648,
    "end": 698.168,
    "duration": 3.52
  },
  {
    "id": 170,
    "text": "本段承担全篇论证的收束、提炼与力学闭环任务。",
    "start": 698.408,
    "end": 702.648,
    "duration": 4.24
  },
  {
    "id": 171,
    "text": "结尾绝不使用泛泛空洞的抒情废话，",
    "start": 702.648,
    "end": 705.528,
    "duration": 2.88
  },
  {
    "id": 172,
    "text": "而是把主体三段的学术结论重新聚合，",
    "start": 705.528,
    "end": 708.568,
    "duration": 3.04
  },
  {
    "id": 173,
    "text": "并强力回扣引论段的最高定性。",
    "start": 708.568,
    "end": 711.048,
    "duration": 2.48
  },
  {
    "id": 174,
    "text": "论证行进至尾声，首先将主体三段的成果高度凝练回收，",
    "start": 711.344,
    "end": 716.384,
    "duration": 5.04
  },
  {
    "id": 175,
    "text": "具体表述到答题语句就是：综上所述，",
    "start": 716.384,
    "end": 719.331,
    "duration": 2.947
  },
  {
    "id": 176,
    "text": "《雷雨》熔铸了现实主义批判深度、",
    "start": 719.331,
    "end": 721.971,
    "duration": 2.64
  },
  {
    "id": 177,
    "text": "现代主义生命体验与精湛戏剧结构。",
    "start": 721.971,
    "end": 725.016,
    "duration": 3.045
  },
  {
    "id": 178,
    "text": "这是以三大支柱对位回收全篇的核心论据。",
    "start": 725.016,
    "end": 728.67,
    "duration": 3.654
  },
  {
    "id": 179,
    "text": "紧接着以不可逾越的艺术丰碑强力回扣开篇的完全成熟，",
    "start": 728.67,
    "end": 733.543,
    "duration": 4.873
  },
  {
    "id": 180,
    "text": "具体表述到答题语句就是：曹禺以卓越的文学天才，",
    "start": 733.543,
    "end": 737.807,
    "duration": 4.264
  },
  {
    "id": 181,
    "text": "为中国现代话剧树立了不可逾越的艺术丰碑。",
    "start": 737.807,
    "end": 741.664,
    "duration": 3.857
  },
  {
    "id": 182,
    "text": "这是实现全篇论述在最高文学史定性上的完满闭环。",
    "start": 741.744,
    "end": 746.144,
    "duration": 4.4
  }
]