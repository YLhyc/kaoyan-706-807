[
  {
    "id": 1,
    "text": "试论曹禺《雷雨》的思想意蕴与艺术成就。",
    "start": 0.0,
    "end": 4.109,
    "duration": 4.109
  },
  {
    "id": 2,
    "text": "三十年代曹禺话剧《雷雨》的问世，",
    "start": 4.109,
    "end": 6.882,
    "duration": 2.773
  },
  {
    "id": 3,
    "text": "标志着中国现代话剧文学走向完全成熟。",
    "start": 6.882,
    "end": 10.275,
    "duration": 3.393
  },
  {
    "id": 4,
    "text": "剧作彻底终结了早期文明戏的简陋直白与五四“问题剧”的生硬说教，",
    "start": 10.275,
    "end": 16.103,
    "duration": 5.828
  },
  {
    "id": 5,
    "text": "创造性地将西方古典戏剧的严密技巧、",
    "start": 16.103,
    "end": 19.516,
    "duration": 3.413
  },
  {
    "id": 6,
    "text": "古希腊式的命运哲学与中国深沉的宗法批判熔铸于一炉。",
    "start": 19.516,
    "end": 24.615,
    "duration": 5.099
  },
  {
    "id": 7,
    "text": "其对思想意蕴的多维开拓、对复杂人性的深层开掘，",
    "start": 24.615,
    "end": 29.102,
    "duration": 4.487
  },
  {
    "id": 8,
    "text": "以及对戏剧时空张力的高压营构，",
    "start": 29.102,
    "end": 32.015,
    "duration": 2.913
  },
  {
    "id": 9,
    "text": "确立了中国现代话剧现实主义与诗化美学交融的经典范式。",
    "start": 32.015,
    "end": 37.184,
    "duration": 5.169
  },
  {
    "id": 10,
    "text": "第一，在思想意蕴上，",
    "start": 37.184,
    "end": 39.259,
    "duration": 2.075
  },
  {
    "id": 11,
    "text": "《雷雨》实现了社会历史批判与形而上命运哲思的有机互证。",
    "start": 39.259,
    "end": 43.983,
    "duration": 4.724
  },
  {
    "id": 12,
    "text": "在经验现实维度上，剧作借由周、",
    "start": 43.983,
    "end": 46.932,
    "duration": 2.949
  },
  {
    "id": 13,
    "text": "鲁两家三十年的恩怨纠葛与一日内的全面崩塌，",
    "start": 46.932,
    "end": 51.178,
    "duration": 4.246
  },
  {
    "id": 14,
    "text": "彻底撕破了封建宗法大家庭温情脉脉的伪善面具。",
    "start": 51.178,
    "end": 55.547,
    "duration": 4.369
  },
  {
    "id": 15,
    "text": "以周朴园为代表的宗法资本家，",
    "start": 55.547,
    "end": 57.932,
    "duration": 2.385
  },
  {
    "id": 16,
    "text": "早年在哈尔滨江桥故意淹死两千包工工人，",
    "start": 57.932,
    "end": 61.798,
    "duration": 3.866
  },
  {
    "id": 17,
    "text": "并在生下周冲的胞兄后逼迫年轻侍萍在大年三十冒雪投河；",
    "start": 61.798,
    "end": 66.939,
    "duration": 5.141
  },
  {
    "id": 18,
    "text": "剧作通过血淋淋的阶级罪恶，",
    "start": 66.939,
    "end": 69.498,
    "duration": 2.559
  },
  {
    "id": 19,
    "text": "深刻指控了封建特权与早期资本积累对底层劳苦大众的残酷压迫。",
    "start": 69.498,
    "end": 75.847,
    "duration": 6.349
  },
  {
    "id": 20,
    "text": "但在超越性哲学维度上，剧作并未止步于阶级罪恶的揭露。",
    "start": 75.847,
    "end": 80.991,
    "duration": 5.144
  },
  {
    "id": 21,
    "text": "曹禺在《〈雷雨〉序》中明确坦言，",
    "start": 80.991,
    "end": 87.738,
    "duration": 6.747
  },
  {
    "id": 22,
    "text": "其创作源于对天地间不可知神秘力量的敬畏。",
    "start": 87.738,
    "end": 92.323,
    "duration": 4.585
  },
  {
    "id": 23,
    "text": "全剧以持续郁热窒息的气候与隐隐雷鸣为背景，",
    "start": 92.323,
    "end": 96.767,
    "duration": 4.444
  },
  {
    "id": 24,
    "text": "营构出超自然的宿命压迫感；蘩漪越是孤注一掷地反抗，",
    "start": 96.767,
    "end": 101.011,
    "duration": 4.244
  },
  {
    "id": 25,
    "text": "周萍越是疯狂地逃离，周冲越是怀抱纯洁憧憬，",
    "start": 101.011,
    "end": 104.793,
    "duration": 3.782
  },
  {
    "id": 26,
    "text": "人物就越迅速地滑向乱伦与自戕的深渊。",
    "start": 104.793,
    "end": 108.281,
    "duration": 3.488
  },
  {
    "id": 27,
    "text": "这种社会现实批判与希腊式命运之谜的互证，",
    "start": 108.281,
    "end": 112.453,
    "duration": 4.172
  },
  {
    "id": 28,
    "text": "赋予了剧作恒久震撼的形而上哲学深度。",
    "start": 112.453,
    "end": 116.686,
    "duration": 4.233
  },
  {
    "id": 29,
    "text": "第二，在人物塑造上，《雷雨》打破了非黑即白的脸谱化模式，",
    "start": 116.686,
    "end": 119.018,
    "duration": 2.332
  },
  {
    "id": 30,
    "text": "深刻揭示了人性的复杂悖论。",
    "start": 119.018,
    "end": 121.459,
    "duration": 2.441
  },
  {
    "id": 31,
    "text": "周朴园绝非单一的封建恶霸，",
    "start": 121.459,
    "end": 123.649,
    "duration": 2.19
  },
  {
    "id": 32,
    "text": "而是一个兼具专制暴虐与温情自恋的复合人格。",
    "start": 123.649,
    "end": 130.157,
    "duration": 6.508
  },
  {
    "id": 33,
    "text": "他对三十年前侍萍的留恋、保留旧家具与关窗的执念，",
    "start": 130.157,
    "end": 134.395,
    "duration": 4.238
  },
  {
    "id": 34,
    "text": "表面上寄托着对未受金钱污染纯真岁月的追怀，",
    "start": 134.395,
    "end": 140.125,
    "duration": 5.73
  },
  {
    "id": 35,
    "text": "实质上是一套旨在掩饰早期罪孽、",
    "start": 140.125,
    "end": 142.734,
    "duration": 2.609
  },
  {
    "id": 36,
    "text": "自我道德美化的心理代偿机制；",
    "start": 142.734,
    "end": 146.615,
    "duration": 3.881
  },
  {
    "id": 37,
    "text": "而当活生生的侍萍出现在面前时，",
    "start": 146.615,
    "end": 148.979,
    "duration": 2.364
  },
  {
    "id": 38,
    "text": "他随即出示五千元支票企图进行经济赎买，",
    "start": 148.979,
    "end": 154.435,
    "duration": 5.456
  },
  {
    "id": 39,
    "text": "彻底撕破了温情脉脉的假象，将阶级自私本质展露无遗。",
    "start": 154.435,
    "end": 158.39,
    "duration": 3.955
  },
  {
    "id": 40,
    "text": "全剧性格烈度最高的核心当属蘩漪。",
    "start": 158.39,
    "end": 160.731,
    "duration": 2.341
  },
  {
    "id": 41,
    "text": "这位深受新思潮濡染却深锁于封建死屋的女性，",
    "start": 160.731,
    "end": 163.314,
    "duration": 2.583
  },
  {
    "id": 42,
    "text": "将对周萍绝望畸形的依恋，化作被压抑生命本能的困兽之斗；",
    "start": 163.314,
    "end": 168.757,
    "duration": 5.443
  },
  {
    "id": 43,
    "text": "其玉石俱焚的决绝反叛，",
    "start": 168.757,
    "end": 170.848,
    "duration": 2.091
  },
  {
    "id": 44,
    "text": "最终撕碎了周公馆温情脉脉的伪善帷幕，",
    "start": 170.848,
    "end": 175.575,
    "duration": 4.727
  },
  {
    "id": 45,
    "text": "铸就了中国现代话剧史上最富悲剧张力的“雷雨式性格”。",
    "start": 175.575,
    "end": 180.575,
    "duration": 5.0
  },
  {
    "id": 46,
    "text": "第三，在艺术形式上，",
    "start": 180.575,
    "end": 181.978,
    "duration": 1.403
  },
  {
    "id": 47,
    "text": "《雷雨》确立了回溯式高压戏剧结构与心灵动作性语言的典范。",
    "start": 181.978,
    "end": 187.935,
    "duration": 5.957
  },
  {
    "id": 48,
    "text": "在戏剧结构上，曹禺借鉴西方古典主义“三一律”，",
    "start": 187.935,
    "end": 193.886,
    "duration": 5.951
  },
  {
    "id": 49,
    "text": "将两代人三十年潜藏的乱伦孽债、阶级仇恨与血缘秘密，",
    "start": 193.886,
    "end": 198.567,
    "duration": 4.681
  },
  {
    "id": 50,
    "text": "高度压缩在盛夏的一天之内（从上午到午夜）与两个封闭场景（周家客厅与鲁家住房）之中。",
    "start": 198.567,
    "end": 206.897,
    "duration": 8.33
  },
  {
    "id": 51,
    "text": "剧作采用高超的回溯式手法，让过去的罪恶化为现时的暗流，",
    "start": 206.897,
    "end": 213.391,
    "duration": 6.494
  },
  {
    "id": 52,
    "text": "在平淡的客套与对话中层层引爆，",
    "start": 213.391,
    "end": 217.237,
    "duration": 3.846
  },
  {
    "id": 53,
    "text": "使全剧从开场便处于危机一触即发的高压状态。",
    "start": 217.237,
    "end": 222.326,
    "duration": 5.089
  },
  {
    "id": 54,
    "text": "在戏剧语言上，剧作彻底摆脱了早期话剧概念化的说教，",
    "start": 222.326,
    "end": 226.096,
    "duration": 3.77
  },
  {
    "id": 55,
    "text": "赋予台词极强的心灵动作性与丰厚的潜台词。",
    "start": 226.096,
    "end": 228.809,
    "duration": 2.713
  },
  {
    "id": 56,
    "text": "在经典的“逼喝苦药”一场中，平缓甚至文雅的言辞背后，",
    "start": 228.809,
    "end": 234.147,
    "duration": 5.338
  },
  {
    "id": 57,
    "text": "奔涌着专制家长意志对个性的窒息绞杀；",
    "start": 234.147,
    "end": 237.189,
    "duration": 3.042
  },
  {
    "id": 58,
    "text": "在雨夜“辨认旧衬衣”的对峙中，",
    "start": 237.189,
    "end": 240.566,
    "duration": 3.377
  },
  {
    "id": 59,
    "text": "周朴园心理防线的节节崩溃被外化为极具张力的交响诗篇。",
    "start": 240.566,
    "end": 243.485,
    "duration": 2.919
  },
  {
    "id": 60,
    "text": "综上所述，《雷雨》将深刻的阶级解剖、古希腊式的命运玄思、",
    "start": 243.485,
    "end": 247.254,
    "duration": 3.769
  },
  {
    "id": 61,
    "text": "复杂的人性悖论与精湛的戏剧技巧熔铸于一炉。",
    "start": 247.254,
    "end": 249.46,
    "duration": 2.206
  },
  {
    "id": 62,
    "text": "它不仅彻底终结了中国现代话剧的草创阶段，",
    "start": 249.46,
    "end": 250.52,
    "duration": 1.06
  },
  {
    "id": 63,
    "text": "更为中国现代文学树立了一座现实主义与诗化美学交融的经典丰碑。",
    "start": 250.52,
    "end": 253.152,
    "duration": 2.632
  }
]