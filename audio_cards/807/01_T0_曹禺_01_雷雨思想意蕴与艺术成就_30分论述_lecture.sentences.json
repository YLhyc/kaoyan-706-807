[
  {
    "id": 1,
    "text": "试论曹禺《雷雨》的思想意蕴与艺术成就。",
    "start": 0.08,
    "end": 3.584,
    "duration": 3.504
  },
  {
    "id": 2,
    "text": "三十年代曹禺话剧《雷雨》的问世，",
    "start": 4.065,
    "end": 6.8,
    "duration": 2.735
  },
  {
    "id": 3,
    "text": "标志着中国现代话剧文学走向完全成熟。",
    "start": 6.842,
    "end": 9.867,
    "duration": 3.025
  },
  {
    "id": 4,
    "text": "剧作彻底终结了早期文明戏的简陋直白与五四“问题剧”的生硬说教，",
    "start": 10.068,
    "end": 16.211,
    "duration": 6.143
  },
  {
    "id": 5,
    "text": "创造性地将西方古典戏剧的严密技巧、",
    "start": 16.243,
    "end": 19.126,
    "duration": 2.883
  },
  {
    "id": 6,
    "text": "古希腊式的命运哲学与中国深沉的宗法批判熔铸于一炉。",
    "start": 19.472,
    "end": 24.386,
    "duration": 4.914
  },
  {
    "id": 7,
    "text": "其对思想意蕴的多维开拓、对复杂人性的深层开掘，",
    "start": 24.574,
    "end": 28.22,
    "duration": 3.646
  },
  {
    "id": 8,
    "text": "以及对戏剧时空张力的高压营构，",
    "start": 28.22,
    "end": 31.307,
    "duration": 3.087
  },
  {
    "id": 9,
    "text": "确立了中国现代话剧现实主义与诗化美学交融的经典范式。",
    "start": 31.307,
    "end": 36.917,
    "duration": 5.61
  },
  {
    "id": 10,
    "text": "第一，在思想意蕴上，",
    "start": 37.144,
    "end": 38.585,
    "duration": 1.441
  },
  {
    "id": 11,
    "text": "《雷雨》实现了社会历史批判与形而上命运哲思的有机互证。",
    "start": 38.585,
    "end": 43.741,
    "duration": 5.156
  },
  {
    "id": 12,
    "text": "在经验现实维度上，剧作借由周、",
    "start": 43.943,
    "end": 46.782,
    "duration": 2.839
  },
  {
    "id": 13,
    "text": "鲁两家三十年的恩怨纠葛与一日内的全面崩塌，",
    "start": 46.885,
    "end": 50.775,
    "duration": 3.89
  },
  {
    "id": 14,
    "text": "彻底撕破了封建宗法大家庭温情脉脉的伪善面具。",
    "start": 51.134,
    "end": 55.157,
    "duration": 4.023
  },
  {
    "id": 15,
    "text": "以周朴园为代表的宗法资本家，",
    "start": 55.506,
    "end": 57.599,
    "duration": 2.093
  },
  {
    "id": 16,
    "text": "早年在哈尔滨江桥故意淹死两千包工工人，",
    "start": 57.886,
    "end": 61.306,
    "duration": 3.42
  },
  {
    "id": 17,
    "text": "并在生下周冲的胞兄后逼迫年轻侍萍在大年三十冒雪投河；",
    "start": 61.758,
    "end": 66.7,
    "duration": 4.942
  },
  {
    "id": 18,
    "text": "剧作通过血淋淋的阶级罪恶，",
    "start": 66.899,
    "end": 69.158,
    "duration": 2.259
  },
  {
    "id": 19,
    "text": "深刻指控了封建特权与早期资本积累对底层劳苦大众的残酷压迫。",
    "start": 69.45,
    "end": 75.304,
    "duration": 5.854
  },
  {
    "id": 20,
    "text": "但在超越性哲学维度上，剧作并未止步于阶级罪恶的揭露。",
    "start": 75.807,
    "end": 80.52,
    "duration": 4.713
  },
  {
    "id": 21,
    "text": "曹禺在《〈雷雨〉序》中明确坦言，",
    "start": 80.95,
    "end": 83.326,
    "duration": 2.376
  },
  {
    "id": 22,
    "text": "其创作源于对天地间不可知神秘力量的敬畏。",
    "start": 83.421,
    "end": 87.484,
    "duration": 4.063
  },
  {
    "id": 23,
    "text": "全剧以持续郁热窒息的气候与隐隐雷鸣为背景，",
    "start": 87.698,
    "end": 91.931,
    "duration": 4.233
  },
  {
    "id": 24,
    "text": "营构出超自然的宿命压迫感；蘩漪越是孤注一掷地反抗，",
    "start": 92.282,
    "end": 96.457,
    "duration": 4.175
  },
  {
    "id": 25,
    "text": "周萍越是疯狂地逃离，周冲越是怀抱纯洁憧憬，",
    "start": 96.554,
    "end": 100.476,
    "duration": 3.922
  },
  {
    "id": 26,
    "text": "人物就越迅速地滑向乱伦与自戕的深渊。",
    "start": 100.971,
    "end": 104.226,
    "duration": 3.255
  },
  {
    "id": 27,
    "text": "这种社会现实批判与希腊式命运之谜的互证，",
    "start": 104.753,
    "end": 108.041,
    "duration": 3.288
  },
  {
    "id": 28,
    "text": "赋予了剧作恒久震撼的形而上哲学深度。",
    "start": 108.241,
    "end": 111.421,
    "duration": 3.18
  },
  {
    "id": 29,
    "text": "第二，在人物塑造上，《雷雨》打破了非黑即白的脸谱化模式，",
    "start": 111.668,
    "end": 116.424,
    "duration": 4.756
  },
  {
    "id": 30,
    "text": "深刻揭示了人性的复杂悖论。",
    "start": 116.645,
    "end": 118.803,
    "duration": 2.158
  },
  {
    "id": 31,
    "text": "周朴园绝非单一的封建恶霸，",
    "start": 118.978,
    "end": 121.151,
    "duration": 2.173
  },
  {
    "id": 32,
    "text": "而是一个兼具专制暴虐与温情自恋的复合人格。",
    "start": 121.281,
    "end": 125.449,
    "duration": 4.168
  },
  {
    "id": 33,
    "text": "他对三十年前侍萍的留恋、保留旧家具与关窗的执念，",
    "start": 125.537,
    "end": 130.22,
    "duration": 4.683
  },
  {
    "id": 34,
    "text": "表面上寄托着对未受金钱污染纯真岁月的追怀，",
    "start": 130.256,
    "end": 134.064,
    "duration": 3.808
  },
  {
    "id": 35,
    "text": "实质上是一套旨在掩饰早期罪孽、",
    "start": 134.354,
    "end": 137.153,
    "duration": 2.799
  },
  {
    "id": 36,
    "text": "自我道德美化的心理代偿机制；",
    "start": 137.191,
    "end": 139.831,
    "duration": 2.64
  },
  {
    "id": 37,
    "text": "而当活生生的侍萍出现在面前时，",
    "start": 140.085,
    "end": 142.523,
    "duration": 2.438
  },
  {
    "id": 38,
    "text": "他随即出示五千元支票企图进行经济赎买，",
    "start": 142.523,
    "end": 146.121,
    "duration": 3.598
  },
  {
    "id": 39,
    "text": "彻底撕破了温情脉脉的假象，将阶级自私本质展露无遗。",
    "start": 146.575,
    "end": 151.006,
    "duration": 4.431
  },
  {
    "id": 40,
    "text": "全剧性格烈度最高的核心当属蘩漪。",
    "start": 151.369,
    "end": 154.003,
    "duration": 2.634
  },
  {
    "id": 41,
    "text": "这位深受新思潮濡染却深锁于封建死屋的女性，",
    "start": 154.205,
    "end": 158.265,
    "duration": 4.06
  },
  {
    "id": 42,
    "text": "将对周萍绝望畸形的依恋，化作被压抑生命本能的困兽之斗；",
    "start": 158.35,
    "end": 163.082,
    "duration": 4.732
  },
  {
    "id": 43,
    "text": "其玉石俱焚的决绝反叛，",
    "start": 163.273,
    "end": 165.145,
    "duration": 1.872
  },
  {
    "id": 44,
    "text": "最终撕碎了周公馆温情脉脉的伪善帷幕，",
    "start": 165.385,
    "end": 168.39,
    "duration": 3.005
  },
  {
    "id": 45,
    "text": "铸就了中国现代话剧史上最富悲剧张力的“雷雨式性格”。",
    "start": 168.717,
    "end": 173.336,
    "duration": 4.619
  },
  {
    "id": 46,
    "text": "第三，在艺术形式上，",
    "start": 173.692,
    "end": 175.23,
    "duration": 1.538
  },
  {
    "id": 47,
    "text": "《雷雨》确立了回溯式高压戏剧结构与心灵动作性语言的典范。",
    "start": 175.535,
    "end": 180.091,
    "duration": 4.556
  },
  {
    "id": 48,
    "text": "在戏剧结构上，曹禺借鉴西方古典主义“三一律”，",
    "start": 180.532,
    "end": 184.241,
    "duration": 3.709
  },
  {
    "id": 49,
    "text": "将两代人三十年潜藏的乱伦孽债、阶级仇恨与血缘秘密，",
    "start": 184.28,
    "end": 188.785,
    "duration": 4.505
  },
  {
    "id": 50,
    "text": "高度压缩在盛夏的一天之内（从上午到午夜）与两个封闭场景（周家客厅与鲁家住房）之中。",
    "start": 188.923,
    "end": 195.972,
    "duration": 7.049
  },
  {
    "id": 51,
    "text": "剧作采用高超的回溯式手法，让过去的罪恶化为现时的暗流，",
    "start": 196.157,
    "end": 201.045,
    "duration": 4.888
  },
  {
    "id": 52,
    "text": "在平淡的客套与对话中层层引爆，",
    "start": 201.317,
    "end": 204.083,
    "duration": 2.766
  },
  {
    "id": 53,
    "text": "使全剧从开场便处于危机一触即发的高压状态。",
    "start": 204.506,
    "end": 208.364,
    "duration": 3.858
  },
  {
    "id": 54,
    "text": "在戏剧语言上，剧作彻底摆脱了早期话剧概念化的说教，",
    "start": 208.759,
    "end": 213.045,
    "duration": 4.286
  },
  {
    "id": 55,
    "text": "赋予台词极强的心灵动作性与丰厚的潜台词。",
    "start": 213.343,
    "end": 217.008,
    "duration": 3.665
  },
  {
    "id": 56,
    "text": "在经典的“逼喝苦药”一场中，平缓甚至文雅的言辞背后，",
    "start": 217.197,
    "end": 222.025,
    "duration": 4.828
  },
  {
    "id": 57,
    "text": "奔涌着专制家长意志对个性的窒息绞杀；",
    "start": 222.286,
    "end": 225.712,
    "duration": 3.426
  },
  {
    "id": 58,
    "text": "在雨夜“辨认旧衬衣”的对峙中，",
    "start": 226.056,
    "end": 228.463,
    "duration": 2.407
  },
  {
    "id": 59,
    "text": "周朴园心理防线的节节崩溃被外化为极具张力的交响诗篇。",
    "start": 228.769,
    "end": 233.836,
    "duration": 5.067
  },
  {
    "id": 60,
    "text": "综上所述，《雷雨》将深刻的阶级解剖、古希腊式的命运玄思、",
    "start": 234.107,
    "end": 238.834,
    "duration": 4.727
  },
  {
    "id": 61,
    "text": "复杂的人性悖论与精湛的戏剧技巧熔铸于一炉。",
    "start": 239.043,
    "end": 243.194,
    "duration": 4.151
  },
  {
    "id": 62,
    "text": "它不仅彻底终结了中国现代话剧的草创阶段，",
    "start": 243.445,
    "end": 246.832,
    "duration": 3.387
  },
  {
    "id": 63,
    "text": "更为中国现代文学树立了一座现实主义与诗化美学交融的经典丰碑。",
    "start": 246.998,
    "end": 253.152,
    "duration": 6.154
  }
]
