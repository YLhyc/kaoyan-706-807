[
  {
    "id": 1,
    "text": "试论曹禺《雷雨》的思想意蕴与艺术成就。",
    "start": 0.101,
    "end": 3.535,
    "duration": 3.434
  },
  {
    "id": 2,
    "text": "三十年代曹禺话剧《雷雨》的问世，",
    "start": 3.996,
    "end": 6.43,
    "duration": 2.434
  },
  {
    "id": 3,
    "text": "标志着中国现代话剧文学走向成熟。",
    "start": 6.863,
    "end": 9.698,
    "duration": 2.835
  },
  {
    "id": 4,
    "text": "剧作告别了早期文明戏的简陋直白与五四“问题剧”的生硬说教，",
    "start": 10.099,
    "end": 15.079,
    "duration": 4.98
  },
  {
    "id": 5,
    "text": "将西方古典戏剧的严密技巧、",
    "start": 15.635,
    "end": 17.749,
    "duration": 2.114
  },
  {
    "id": 6,
    "text": "古希腊式的命运悲剧与中国宗法家庭批判融为一体。",
    "start": 17.846,
    "end": 22.062,
    "duration": 4.216
  },
  {
    "id": 7,
    "text": "其多维的思想开掘、复杂的人物群像与高压的戏剧时空，",
    "start": 22.347,
    "end": 26.795,
    "duration": 4.448
  },
  {
    "id": 8,
    "text": "确立了中国现代话剧现实主义与诗化美学交融的典范。",
    "start": 27.124,
    "end": 31.594,
    "duration": 4.47
  },
  {
    "id": 9,
    "text": "第一，贯通社会历史批判与超越性命运哲思，",
    "start": 32.257,
    "end": 36.097,
    "duration": 3.84
  },
  {
    "id": 10,
    "text": "开拓剧作的双重思想深度。",
    "start": 36.427,
    "end": 38.368,
    "duration": 1.941
  },
  {
    "id": 11,
    "text": "在社会现实层面，剧作借周、",
    "start": 38.726,
    "end": 41.085,
    "duration": 2.359
  },
  {
    "id": 12,
    "text": "鲁两家三十年的恩怨纠葛与一日内的全面溃败，",
    "start": 41.206,
    "end": 44.799,
    "duration": 3.593
  },
  {
    "id": 13,
    "text": "撕破了封建宗法大家庭温情脉脉的伪善面具。",
    "start": 45.137,
    "end": 48.763,
    "duration": 3.626
  },
  {
    "id": 14,
    "text": "资本家周朴园早年在哈尔滨江桥故意淹死两千二百个小工，",
    "start": 48.92,
    "end": 53.324,
    "duration": 4.404
  },
  {
    "id": 15,
    "text": "又在侍萍刚生下鲁大海三天后，",
    "start": 53.629,
    "end": 55.909,
    "duration": 2.28
  },
  {
    "id": 16,
    "text": "逼迫她于大年三十冒雪抱子投河；剧作通过血淋淋的阶级罪恶，",
    "start": 56.261,
    "end": 61.758,
    "duration": 5.497
  },
  {
    "id": 17,
    "text": "控诉了封建特权与早期资本积累对底层劳动者的残酷压迫。",
    "start": 62.119,
    "end": 66.998,
    "duration": 4.879
  },
  {
    "id": 18,
    "text": "在超越性哲学层面，剧作并未止步于社会问题的揭露。",
    "start": 67.268,
    "end": 71.038,
    "duration": 3.77
  },
  {
    "id": 19,
    "text": "曹禺在《〈雷雨〉序》中坦言，",
    "start": 71.187,
    "end": 72.89,
    "duration": 1.703
  },
  {
    "id": 20,
    "text": "其创作源于对天地间不可知神秘力量的敬畏。",
    "start": 73.138,
    "end": 76.638,
    "duration": 3.5
  },
  {
    "id": 21,
    "text": "全剧以郁热窒息的盛夏气候与隐隐雷鸣为背景，",
    "start": 76.895,
    "end": 80.8,
    "duration": 3.905
  },
  {
    "id": 22,
    "text": "营造出难以逃脱的宿命压迫感；繁漪越是孤注一掷地反抗，",
    "start": 80.992,
    "end": 85.19,
    "duration": 4.198
  },
  {
    "id": 23,
    "text": "周萍越是仓皇逃离，周冲越是怀抱纯洁憧憬，",
    "start": 85.417,
    "end": 88.893,
    "duration": 3.476
  },
  {
    "id": 24,
    "text": "人物越加速坠入乱伦与毁灭的绝境。",
    "start": 89.222,
    "end": 91.822,
    "duration": 2.6
  },
  {
    "id": 25,
    "text": "社会历史批判与命运之谜相互映照，赋予剧作深沉的哲理力量。",
    "start": 92.042,
    "end": 97.521,
    "duration": 5.479
  },
  {
    "id": 26,
    "text": "第二，打破非黑即白的脸谱化模式，开掘复杂人性的深层悖论。",
    "start": 98.138,
    "end": 104.014,
    "duration": 5.876
  },
  {
    "id": 27,
    "text": "周朴园具有专制暴虐与温情自恋的复合人格。",
    "start": 104.266,
    "end": 107.96,
    "duration": 3.694
  },
  {
    "id": 28,
    "text": "他对三十年前侍萍的留恋、保留旧家具与关窗的执念，",
    "start": 108.327,
    "end": 112.484,
    "duration": 4.157
  },
  {
    "id": 29,
    "text": "表面上寄托着对未受金钱污染纯真岁月的追怀，",
    "start": 112.673,
    "end": 116.687,
    "duration": 4.014
  },
  {
    "id": 30,
    "text": "实质上是一套掩饰早年罪孽、自我道德美化的心理代偿机制；",
    "start": 117.066,
    "end": 122.029,
    "duration": 4.963
  },
  {
    "id": 31,
    "text": "一旦活生生的侍萍立在面前，",
    "start": 122.317,
    "end": 124.442,
    "duration": 2.125
  },
  {
    "id": 32,
    "text": "他随即出示五千元支票企图以金钱赎买旧情，",
    "start": 124.736,
    "end": 128.682,
    "duration": 3.946
  },
  {
    "id": 33,
    "text": "将阶级自私的冷酷本色暴露无遗。",
    "start": 129.032,
    "end": 131.983,
    "duration": 2.951
  },
  {
    "id": 34,
    "text": "全剧性格烈度最高的人物当属繁漪。",
    "start": 132.783,
    "end": 135.671,
    "duration": 2.888
  },
  {
    "id": 35,
    "text": "这位深受新思潮濡染却被深锁于封建死屋的女性，",
    "start": 136.378,
    "end": 140.396,
    "duration": 4.018
  },
  {
    "id": 36,
    "text": "将对周萍绝望畸形的依恋化作困兽之斗；",
    "start": 140.56,
    "end": 144.317,
    "duration": 3.757
  },
  {
    "id": 37,
    "text": "其玉石俱焚的决绝反叛，撕碎了周公馆的伪善帷幕，",
    "start": 144.544,
    "end": 148.65,
    "duration": 4.106
  },
  {
    "id": 38,
    "text": "铸就了中国现代话剧史上极具悲剧张力的“雷雨式性格”。",
    "start": 148.878,
    "end": 153.726,
    "duration": 4.848
  },
  {
    "id": 39,
    "text": "第三，营构回溯式高压戏剧结构，锤炼富有心灵动作性的潜台词。",
    "start": 154.362,
    "end": 159.396,
    "duration": 5.034
  },
  {
    "id": 40,
    "text": "在戏剧结构上，曹禺借鉴西方古典主义“三一律”，",
    "start": 159.929,
    "end": 163.493,
    "duration": 3.564
  },
  {
    "id": 41,
    "text": "将两代人三十年潜藏的乱伦孽债、阶级仇恨与血缘秘密，",
    "start": 163.888,
    "end": 168.326,
    "duration": 4.438
  },
  {
    "id": 42,
    "text": "浓缩在盛夏一天之内（从上午到午夜）与两个封闭场景（周家客厅与鲁家住房）之中。",
    "start": 168.503,
    "end": 175.092,
    "duration": 6.589
  },
  {
    "id": 43,
    "text": "剧作采用回溯式手法，让往昔罪恶化作现时暗流，",
    "start": 175.402,
    "end": 179.713,
    "duration": 4.311
  },
  {
    "id": 44,
    "text": "在平淡的客套与对话中层层引爆，",
    "start": 179.976,
    "end": 182.823,
    "duration": 2.847
  },
  {
    "id": 45,
    "text": "使全剧自开场便处于一触即发的高压态势。",
    "start": 183.062,
    "end": 186.865,
    "duration": 3.803
  },
  {
    "id": 46,
    "text": "在戏剧语言上，剧作摆脱早期话剧的概念化说教，",
    "start": 187.099,
    "end": 191.129,
    "duration": 4.03
  },
  {
    "id": 47,
    "text": "赋予台词敏锐的心灵动作性与丰厚潜台词。",
    "start": 191.401,
    "end": 195.253,
    "duration": 3.852
  },
  {
    "id": 48,
    "text": "在“逼喝苦药”一场中，",
    "start": 195.57,
    "end": 197.053,
    "duration": 1.483
  },
  {
    "id": 49,
    "text": "平缓文雅的言辞背后奔涌着专制家长意志对个性的窒息绞杀；",
    "start": 197.369,
    "end": 202.315,
    "duration": 4.946
  },
  {
    "id": 50,
    "text": "在第二幕白天周家客厅“辨认旧衬衣”的对峙中，",
    "start": 202.634,
    "end": 206.063,
    "duration": 3.429
  },
  {
    "id": 51,
    "text": "周朴园心理防线的节节败退被外化为张力十足的心灵交锋。",
    "start": 206.367,
    "end": 211.07,
    "duration": 4.703
  },
  {
    "id": 52,
    "text": "纵观全剧，《雷雨》将深刻的阶级解剖、命运玄思、",
    "start": 211.709,
    "end": 215.819,
    "duration": 4.11
  },
  {
    "id": 53,
    "text": "人性悖论与精湛的戏剧技巧融为一体。",
    "start": 216.089,
    "end": 218.806,
    "duration": 2.717
  },
  {
    "id": 54,
    "text": "它结束了中国现代话剧的草创摸索，",
    "start": 219.089,
    "end": 221.607,
    "duration": 2.518
  },
  {
    "id": 55,
    "text": "确立了现实主义与诗化美学交融的经典范式。",
    "start": 221.772,
    "end": 225.24,
    "duration": 3.468
  }
]