[
  {
    "id": 1,
    "text": "本题是 807 专业课中最核心的戏剧综合大题，分值为 30 分。",
    "start": 0.1,
    "end": 6.248,
    "duration": 6.148
  },
  {
    "id": 2,
    "text": "它考查的核心目的，是要求考生从文学史的高度，全面论证曹禺《雷雨》作为中国现代话剧走向完全成熟的全部合法性。",
    "start": 6.198,
    "end": 16.706,
    "duration": 10.508
  },
  {
    "id": 3,
    "text": "回答这道题不能仅停留在思想主题的社会学提炼上，也不能孤立地赏析舞台技巧。",
    "start": 16.706,
    "end": 24.245,
    "duration": 7.539
  },
  {
    "id": 4,
    "text": "必须将思想的深刻性（社会批判与命运哲学），人性的复杂性（周朴园伪善与蘩漪雷雨性格）与戏剧本体的形式规律（回溯结构与心灵动作性）有机熔铸在一起，展现出高水平的研究生学术视野。",
    "start": 24.244,
    "end": 40.516,
    "duration": 16.272
  },
  {
    "id": 5,
    "text": "全篇确立三个核心展开维度，",
    "start": 40.517,
    "end": 43.551,
    "duration": 3.034
  },
  {
    "id": 6,
    "text": "第一是思想意蕴的双重维度（社会历史批判与形而上命运哲思）。",
    "start": 43.551,
    "end": 49.228,
    "duration": 5.677
  },
  {
    "id": 7,
    "text": "第二是人物性格的深层开掘（打破脸谱化，剖析复杂人性悖论）。",
    "start": 49.228,
    "end": 55.022,
    "duration": 5.794
  },
  {
    "id": 8,
    "text": "第三是戏剧形式的高压营造（回溯式三一律结构与心灵动作性语言）。",
    "start": 55.022,
    "end": 61.012,
    "duration": 5.99
  },
  {
    "id": 9,
    "text": "这三个维度构成了一个由内而外，层层具象化的严密递进链条。",
    "start": 61.011,
    "end": 67.053,
    "duration": 6.042
  },
  {
    "id": 10,
    "text": "思想意蕴是剧作的精神内核与灵魂，决定了作品能够达到的哲学高度；",
    "start": 67.053,
    "end": 73.694,
    "duration": 6.641
  },
  {
    "id": 11,
    "text": "人物塑造是戏剧思想的具象载体与行动主体，深邃的思想必须依托于活生生的人物冲突才能显影；",
    "start": 73.694,
    "end": 82.965,
    "duration": 9.271
  },
  {
    "id": 12,
    "text": "艺术形式则是戏剧作为综合舞台艺术的媒介本体，人物的撕裂与思想的博弈最终必须落实为精湛的时空结构与舞台语言。",
    "start": 82.965,
    "end": 93.72,
    "duration": 10.755
  },
  {
    "id": 13,
    "text": "从精神内核，到行动载体，再到媒介形式，三者环环相扣，构成了论证不可动摇的内在必然性。",
    "start": 93.72,
    "end": 102.887,
    "duration": 9.167
  },
  {
    "id": 14,
    "text": "本段承担全篇论述的前提确立任务。",
    "start": 102.886,
    "end": 106.363,
    "duration": 3.477
  },
  {
    "id": 15,
    "text": "整段要解决的是四个连贯的问题，确立最高定性，展开历史反衬，界定成熟内涵，以及确立下文的三大论述支柱。",
    "start": 106.363,
    "end": 116.819,
    "duration": 10.456
  },
  {
    "id": 16,
    "text": "1934 年曹禺《雷雨》的问世，标志着中国现代话剧文学走向完全成熟。",
    "start": 116.819,
    "end": 124.02,
    "duration": 7.201
  },
  {
    "id": 17,
    "text": "确立《雷雨》在中国现代话剧史上完全成熟的最高定性。",
    "start": 124.019,
    "end": 129.292,
    "duration": 5.273
  },
  {
    "id": 18,
    "text": "剧作彻底终结了早期文明戏的简陋直白与五四“问题剧”的生硬说教，创造性地将西方古典戏剧的严密技巧，古希腊式的命运哲学与中国深沉的宗法批判熔铸于一炉。",
    "start": 129.293,
    "end": 143.85,
    "duration": 14.557
  },
  {
    "id": 19,
    "text": "展开历史反衬，指出它对话剧早期幼稚形态的根本超越，并界定其成熟内涵。",
    "start": 143.85,
    "end": 151.337,
    "duration": 7.487
  },
  {
    "id": 20,
    "text": "其对思想意蕴的多维开拓，对复杂人性的深层开掘，以及对戏剧时空张力的高压营构，确立了中国现代话剧现实主义与诗化美学交融的经典范式。",
    "start": 151.337,
    "end": 164.202,
    "duration": 12.865
  },
  {
    "id": 21,
    "text": "总领下文展开的三大支柱，搭好全篇骨架。",
    "start": 164.202,
    "end": 168.369,
    "duration": 4.167
  },
  {
    "id": 22,
    "text": "本段旨在论证《雷雨》思想的深度与广度。",
    "start": 168.368,
    "end": 172.339,
    "duration": 3.971
  },
  {
    "id": 23,
    "text": "核心是要打破单向度的政治图解，揭示其双层悲剧结构。",
    "start": 172.34,
    "end": 177.861,
    "duration": 5.521
  },
  {
    "id": 24,
    "text": "整段逻辑是从看得见的社会现实阶级批判，自然深入到超越阶级批判的深层命运悲剧。",
    "start": 177.86,
    "end": 185.92,
    "duration": 8.06
  },
  {
    "id": 25,
    "text": "第一，在思想意蕴上，《雷雨》实现了社会历史批判与形而上命运哲思的有机互证。",
    "start": 185.92,
    "end": 193.16,
    "duration": 7.24
  },
  {
    "id": 26,
    "text": "确立本段的总论点，定下由经验向超验双层推进的基调。",
    "start": 193.16,
    "end": 198.733,
    "duration": 5.573
  },
  {
    "id": 27,
    "text": "在经验现实维度上，剧作借由周，鲁两家三十年的恩怨纠葛与一日内的全面崩塌，彻底撕破了封建宗法大家庭温情脉脉的伪善面具。",
    "start": 198.733,
    "end": 211.038,
    "duration": 12.305
  },
  {
    "id": 28,
    "text": "以周朴园为代表的宗法资本家，早年在哈尔滨江桥故意淹死两千包工工人，并在生下周冲的胞兄后逼迫年轻侍萍在大年三十冒雪投河；剧作通过血淋淋的阶级罪恶，深刻指控了封建特权与早期资本积累对底层劳苦大众的残酷压迫。",
    "start": 211.038,
    "end": 231.893,
    "duration": 20.855
  },
  {
    "id": 29,
    "text": "调取江桥惨案，大年三十逼迫投河等核心名场面，做实反封建与阶级压迫批判。",
    "start": 231.893,
    "end": 239.94,
    "duration": 8.047
  },
  {
    "id": 30,
    "text": "但在超越性哲学维度上，剧作并未止步于阶级罪恶的揭露。",
    "start": 239.94,
    "end": 245.396,
    "duration": 5.456
  },
  {
    "id": 31,
    "text": "曹禺在《〈雷雨〉序》中明确坦言，其创作源于对天地间不可知神秘力量的敬畏。",
    "start": 245.395,
    "end": 252.335,
    "duration": 6.94
  },
  {
    "id": 32,
    "text": "调取作者创作宣言，实现思维向形而上哲学维度的自然跃迁。",
    "start": 252.335,
    "end": 258.468,
    "duration": 6.133
  },
  {
    "id": 33,
    "text": "全剧以持续郁热窒息的气候与隐隐雷鸣为背景，营构出超自然的宿命压迫感；蘩漪越是孤注一掷地反抗，周萍越是疯狂地逃离，周冲越是怀抱纯洁憧憬，人物就越迅速地滑向乱伦与自戕的深渊。",
    "start": 258.676,
    "end": 276.541,
    "duration": 17.865
  },
  {
    "id": 34,
    "text": "这种社会现实批判与希腊式命运之谜的互证，赋予了剧作恒久震撼的形而上哲学深度。",
    "start": 276.541,
    "end": 284.354,
    "duration": 7.813
  },
  {
    "id": 35,
    "text": "用郁热雷雨意象解析宿命机制，揭示挣扎反而加深毁灭的希腊悲剧律令，完成闭环。",
    "start": 284.353,
    "end": 292.517,
    "duration": 8.164
  },
  {
    "id": 36,
    "text": "本段承接上一段的思想意蕴，论述抽象的思想如何在具体的舞台人物身上落实。",
    "start": 292.517,
    "end": 299.561,
    "duration": 7.044
  },
  {
    "id": 37,
    "text": "通过压迫者周朴园与反抗者蘩漪两大人格样本，剖析人性的复杂悖论与生命绝叫。",
    "start": 299.561,
    "end": 306.97,
    "duration": 7.409
  },
  {
    "id": 38,
    "text": "第二，在人物塑造上，《雷雨》打破了非黑即白的脸谱化模式，深刻揭示了人性的复杂悖论。",
    "start": 306.97,
    "end": 314.6,
    "duration": 7.63
  },
  {
    "id": 39,
    "text": "确立人物塑造的总论点，直接击中现代戏剧摆脱脸谱化的突破。",
    "start": 314.6,
    "end": 320.459,
    "duration": 5.859
  },
  {
    "id": 40,
    "text": "周朴园绝非单一的封建恶霸，而是一个兼具专制暴虐与温情自恋的复合人格。",
    "start": 320.46,
    "end": 327.387,
    "duration": 6.927
  },
  {
    "id": 41,
    "text": "他对三十年前侍萍的留恋，保留旧家具与关窗的执念，表面上寄托着对未受金钱污染纯真岁月的追怀，实质上是一套旨在掩饰早期罪孽，自我道德美化的心理代偿机制；而当活生生的侍萍出现在面前时，他随即出示五千元支票企图进行经济赎买，彻底撕破了温情脉脉的假象，将阶级自私本质展露无遗。",
    "start": 327.387,
    "end": 354.505,
    "duration": 27.118
  },
  {
    "id": 42,
    "text": "调取保留旧家具，关窗，五千元支票等核心情节证据，剖析心理代偿与经济赎买机制。",
    "start": 354.505,
    "end": 362.695,
    "duration": 8.19
  },
  {
    "id": 43,
    "text": "全剧性格烈度最高的核心当属蘩漪。",
    "start": 362.695,
    "end": 366.302,
    "duration": 3.607
  },
  {
    "id": 44,
    "text": "这位深受新思潮濡染却深锁于封建死屋的女性，将对周萍绝望畸形的依恋，化作被压抑生命本能的困兽之斗；其玉石俱焚的决绝反叛，最终撕碎了周公馆温情脉脉的伪善帷幕，铸就了中国现代话剧史上最富悲剧张力的“雷雨式性格”。",
    "start": 366.302,
    "end": 387.027,
    "duration": 20.725
  },
  {
    "id": 45,
    "text": "气脉贯通的大复句，透析生存悖论，困兽之斗心理与反叛价值，完成蘩漪学术定评。",
    "start": 387.027,
    "end": 395.048,
    "duration": 8.021
  },
  {
    "id": 46,
    "text": "本段将论述深入到戏剧作为综合舞台艺术的媒介本体。",
    "start": 395.048,
    "end": 400.269,
    "duration": 5.221
  },
  {
    "id": 47,
    "text": "由宏观的时空压缩结构，深入到微观的心灵动作语言。",
    "start": 400.269,
    "end": 405.334,
    "duration": 5.065
  },
  {
    "id": 48,
    "text": "第三，在艺术形式上，《雷雨》确立了回溯式高压戏剧结构与心灵动作性语言的典范。",
    "start": 405.334,
    "end": 413.029,
    "duration": 7.695
  },
  {
    "id": 49,
    "text": "确立艺术形式总论点。",
    "start": 413.03,
    "end": 415.413,
    "duration": 2.383
  },
  {
    "id": 50,
    "text": "在戏剧结构上，曹禺借鉴西方古典主义“三一律”，将两代人三十年潜藏的乱伦孽债，阶级仇恨与血缘秘密，高度压缩在盛夏的一天之内（从上午到午夜）与两个封闭场景（周家客厅与鲁家住房）之中。",
    "start": 415.412,
    "end": 433.194,
    "duration": 17.782
  },
  {
    "id": 51,
    "text": "剧作采用高超的回溯式手法，让过去的罪恶化为现时的暗流，在平淡的客套与对话中层层引爆，使全剧从开场便处于危机一触即发的高压状态。",
    "start": 433.195,
    "end": 446.541,
    "duration": 13.346
  },
  {
    "id": 52,
    "text": "拆解回溯式三一律结构机制（一天，两地，三十年）。",
    "start": 446.541,
    "end": 451.658,
    "duration": 5.117
  },
  {
    "id": 53,
    "text": "在戏剧语言上，剧作彻底摆脱了早期话剧概念化的说教，赋予台词极强的心灵动作性与丰厚的潜台词。",
    "start": 451.658,
    "end": 461.02,
    "duration": 9.362
  },
  {
    "id": 54,
    "text": "在经典的“逼喝苦药”一场中，平缓甚至文雅的言辞背后，奔涌着专制家长意志对个性的窒息绞杀；在雨夜“辨认旧衬衣”的对峙中，周朴园心理防线的节节崩溃被外化为极具张力的交响诗篇。",
    "start": 461.02,
    "end": 477.461,
    "duration": 16.441
  },
  {
    "id": 55,
    "text": "调取“逼喝苦药”与“辨认旧衬衣”两大名场面，做实心灵动作性与潜台词。",
    "start": 477.461,
    "end": 483.958,
    "duration": 6.497
  },
  {
    "id": 56,
    "text": "综上所述，《雷雨》将深刻的阶级解剖，古希腊式的命运玄思，复杂的人性悖论与精湛的戏剧技巧熔铸于一炉。",
    "start": 483.959,
    "end": 493.829,
    "duration": 9.87
  },
  {
    "id": 57,
    "text": "它不仅彻底终结了中国现代话剧的草创阶段，更为中国现代文学树立了一座现实主义与诗化美学交融的经典丰碑。",
    "start": 493.829,
    "end": 504.155,
    "duration": 10.326
  },
  {
    "id": 58,
    "text": "总结全篇，升华为文学史经典丰碑。",
    "start": 504.154,
    "end": 507.839,
    "duration": 3.685
  }
]