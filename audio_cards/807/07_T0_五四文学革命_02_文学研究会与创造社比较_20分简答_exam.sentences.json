[
  {
    "id": 1,
    "text": "题目：简析文学研究会与创造社在文学主张与创作倾向上的异同。",
    "start": 0.2,
    "end": 5.8,
    "duration": 5.6
  },
  {
    "id": 2,
    "text": "文学研究会与创造社是中国现代新文学初期成立最早、影响最大的两大社团。",
    "start": 6.32,
    "end": 12.64,
    "duration": 6.32
  },
  {
    "id": 3,
    "text": "二者同源于五四思想启蒙浪潮，共同向封建旧文学发起猛攻，",
    "start": 13.16,
    "end": 18.2,
    "duration": 5.04
  },
  {
    "id": 4,
    "text": "但在文学主张、创作方法与主体心境上呈现出鲜明的同源分流与双峰对峙格局，主要体现在以下三个方面：",
    "start": 18.57,
    "end": 27.37,
    "duration": 8.8
  },
  {
    "id": 5,
    "text": "第一，文学观念分歧鲜明，呈现“为人生”的启蒙功利与“为艺术”的审美自足之对峙。",
    "start": 27.74,
    "end": 34.3,
    "duration": 6.56
  },
  {
    "id": 6,
    "text": "文学研究会以《小说月报》为阵地，高扬“为人生而艺术”的大旗，",
    "start": 34.82,
    "end": 39.91,
    "duration": 5.09
  },
  {
    "id": 7,
    "text": "反对鸳鸯蝴蝶派将文学视为游戏消遣的市侩观念，",
    "start": 40.28,
    "end": 44.84,
    "duration": 4.56
  },
  {
    "id": 8,
    "text": "主张文学应当直面社会现实，成为研究人生与暴露社会病态的工具；",
    "start": 45.21,
    "end": 50.81,
    "duration": 5.6
  },
  {
    "id": 9,
    "text": "创造社则高举“为艺术而艺术”的旗帜，推崇文学是内在情感的要求，",
    "start": 51.33,
    "end": 57.06,
    "duration": 5.73
  },
  {
    "id": 10,
    "text": "强调直觉、灵感与主观自我表现，追求审美个性的纯粹与精神自由。",
    "start": 57.43,
    "end": 63.59,
    "duration": 6.16
  },
  {
    "id": 11,
    "text": "第二，创作方法各辟航道，分别确立现实主义写实与浪漫主义主观抒情两大传统。",
    "start": 64.11,
    "end": 70.67,
    "duration": 6.56
  },
  {
    "id": 12,
    "text": "文学研究会恪守写实原则，主张冷静客观地摹写底层疾苦与市民社会的灰色生活，",
    "start": 71.19,
    "end": 78.31,
    "duration": 7.12
  },
  {
    "id": 13,
    "text": "如叶圣陶《潘先生在难中》精准解剖小市民苟且偷生的妥协心理；",
    "start": 78.68,
    "end": 84.28,
    "duration": 5.6
  },
  {
    "id": 14,
    "text": "创造社则信奉浪漫主义与表现主义，拒绝客观拘束而直抒胸臆，长于描写病态心理与反叛激情，",
    "start": 84.8,
    "end": 93.09,
    "duration": 8.29
  },
  {
    "id": 15,
    "text": "如郭沫若《女神》的火山爆发与郁达夫《沉沦》中灵肉撕裂的自叙传倾诉。",
    "start": 93.46,
    "end": 99.06,
    "duration": 5.6
  },
  {
    "id": 16,
    "text": "第三，精神渊源与后期演进迥异，分别承接启蒙的社会理性与感性反叛激情。",
    "start": 99.58,
    "end": 106.78,
    "duration": 7.2
  },
  {
    "id": 17,
    "text": "文学研究会立足国内现实，承接了启蒙运动中沉稳的社会批判理性，",
    "start": 107.3,
    "end": 112.9,
    "duration": 5.6
  },
  {
    "id": 18,
    "text": "后期创作持续深化现实主义道路；",
    "start": 113.27,
    "end": 115.83,
    "duration": 2.56
  },
  {
    "id": 19,
    "text": "创造社崛起于留日青年身处异邦的屈辱与青春苦闷，承接了个性解放的炽烈激情，",
    "start": 116.35,
    "end": 123.6,
    "duration": 7.25
  },
  {
    "id": 20,
    "text": "在大革命退潮前后与太阳社一道倡议“革命文学”口号，迅速转向无产阶级革命文学。",
    "start": 123.97,
    "end": 131.25,
    "duration": 7.28
  },
  {
    "id": 21,
    "text": "合两社而观之，两大社团各执一端而又相辅相成。",
    "start": 131.77,
    "end": 135.93,
    "duration": 4.16
  },
  {
    "id": 22,
    "text": "他们以双峰对峙的多元探索，共同奠定了中国现代新文学现实主义与浪漫主义交相辉映的格局。",
    "start": 136.45,
    "end": 144.21,
    "duration": 7.76
  }
]