[
  {
    "id": 1,
    "text": "文学研究会与创造社是中国现代新文学初期成立最早、",
    "start": 0.08,
    "end": 5.04,
    "duration": 4.96
  },
  {
    "id": 2,
    "text": "影响最大的两大标志性文学社团。",
    "start": 5.04,
    "end": 7.92,
    "duration": 2.88
  },
  {
    "id": 3,
    "text": "二者同源于五四思想启蒙浪潮，共同向封建旧文学发起猛攻。",
    "start": 7.92,
    "end": 13.2,
    "duration": 5.28
  },
  {
    "id": 4,
    "text": "但在文学主张、创作方法与精神底色上，",
    "start": 13.2,
    "end": 16.56,
    "duration": 3.36
  },
  {
    "id": 5,
    "text": "呈现出鲜明的同源分流与双峰对峙格局。",
    "start": 16.56,
    "end": 20.0,
    "duration": 3.44
  },
  {
    "id": 6,
    "text": "首先，在文学观念与社会功能上，二者确立了截然不同的价值取向。",
    "start": 20.32,
    "end": 26.08,
    "duration": 5.76
  },
  {
    "id": 7,
    "text": "文学研究会高扬“为人生”的启蒙功利主张。",
    "start": 26.08,
    "end": 30.0,
    "duration": 3.92
  },
  {
    "id": 8,
    "text": "他们坚决反对渊秧蝴蝶派将文学视为游戏消遣的市快观念，",
    "start": 30.0,
    "end": 35.68,
    "duration": 5.68
  },
  {
    "id": 9,
    "text": "主张文学应当干预现实生活，成为研究社会人生的工具。",
    "start": 35.68,
    "end": 40.08,
    "duration": 4.4
  },
  {
    "id": 10,
    "text": "创造社则高扬“为艺术”的审美独立旗帜。",
    "start": 40.4,
    "end": 44.08,
    "duration": 3.68
  },
  {
    "id": 11,
    "text": "他们强调文学是内在情感的要求，推崇直觉、",
    "start": 44.08,
    "end": 48.08,
    "duration": 4.0
  },
  {
    "id": 12,
    "text": "灵感与自我表现，主张文学应当追求内心的纯粹与主观审美的极致。",
    "start": 48.08,
    "end": 54.32,
    "duration": 6.24
  },
  {
    "id": 13,
    "text": "其次，在创作方法与审美风范上，二者分别开辟了现实主义与浪漫主义的宏阔航道。",
    "start": 54.32,
    "end": 61.04,
    "duration": 6.72
  },
  {
    "id": 14,
    "text": "文学研究会遵循现实主义的写实原则。",
    "start": 61.28,
    "end": 64.4,
    "duration": 3.12
  },
  {
    "id": 15,
    "text": "他们主张深入现实进行实地观察与冷静摹写，",
    "start": 64.4,
    "end": 68.4,
    "duration": 4.0
  },
  {
    "id": 16,
    "text": "以客观笔法揭露底层疾苦与市民灰色生活，",
    "start": 68.4,
    "end": 72.32,
    "duration": 3.92
  },
  {
    "id": 17,
    "text": "代表作如叶圣陶的《潘先生在难中》。",
    "start": 72.32,
    "end": 75.44,
    "duration": 3.12
  },
  {
    "id": 18,
    "text": "创造社则信奉浪漫主义与表现主义法则。",
    "start": 75.44,
    "end": 78.64,
    "duration": 3.2
  },
  {
    "id": 19,
    "text": "他们拒绝冷静客观的拘束，主张直抒胸臆与个性张扬，",
    "start": 78.64,
    "end": 83.12,
    "duration": 4.48
  },
  {
    "id": 20,
    "text": "长于描写惊世骇俗的病态心理与叛逆激情，",
    "start": 83.12,
    "end": 86.8,
    "duration": 3.68
  },
  {
    "id": 21,
    "text": "代表作如郭沫若的《女神》与郁达夫的《沉沦》。",
    "start": 86.8,
    "end": 89.84,
    "duration": 3.04
  },
  {
    "id": 22,
    "text": "最后，在处境渊源与历史演进上，二者承接了五四启蒙精神的不同侧翼。",
    "start": 90.24,
    "end": 96.64,
    "duration": 6.4
  },
  {
    "id": 23,
    "text": "文学研究会立足国内文化语境，承接了启蒙思潮中的社会批判理性，",
    "start": 96.64,
    "end": 102.24,
    "duration": 5.6
  },
  {
    "id": 24,
    "text": "后期创作持续深化写实道路。",
    "start": 102.24,
    "end": 104.64,
    "duration": 2.4
  },
  {
    "id": 25,
    "text": "创造社崛起于留日青年的异邦屈辱与青春苦闷，",
    "start": 104.64,
    "end": 108.72,
    "duration": 4.08
  },
  {
    "id": 26,
    "text": "承接了个性解放与反抗激情的感性热力，",
    "start": 108.72,
    "end": 112.16,
    "duration": 3.44
  },
  {
    "id": 27,
    "text": "在大革命浪潮中率先转向无产阶级革命文学。",
    "start": 112.16,
    "end": 115.76,
    "duration": 3.6
  },
  {
    "id": 28,
    "text": "综上所述，两大社团各执一端而又互为补充。",
    "start": 116.08,
    "end": 120.08,
    "duration": 4.0
  },
  {
    "id": 29,
    "text": "他们以双峰对峙的多元探索，共同奠定了中国现代新文学的壮阔基石。--",
    "start": 120.08,
    "end": 125.44,
    "duration": 5.36
  }
]