[
  {
    "id": 1,
    "text": "题目：简析文学研究会与创造社在文学主张与创作倾向上的异同。",
    "start": 0.107,
    "end": 6.072,
    "duration": 5.965
  },
  {
    "id": 2,
    "text": "文学研究会与创造社是中国现代新文学初期成立最早、",
    "start": 6.678,
    "end": 11.754,
    "duration": 5.076
  },
  {
    "id": 3,
    "text": "影响最大的两大社团。",
    "start": 12.037,
    "end": 13.627,
    "duration": 1.59
  },
  {
    "id": 4,
    "text": "二者同源于五四思想启蒙浪潮，共同向封建旧文学发起猛攻，",
    "start": 14.247,
    "end": 19.533,
    "duration": 5.286
  },
  {
    "id": 5,
    "text": "但在文学主张、",
    "start": 20.018,
    "end": 21.06,
    "duration": 1.042
  },
  {
    "id": 6,
    "text": "创作方法与主体心境上呈现出鲜明的同源分流与双峰对峙格局，",
    "start": 21.308,
    "end": 26.82,
    "duration": 5.512
  },
  {
    "id": 7,
    "text": "主要体现在以下三个方面：",
    "start": 27.451,
    "end": 29.179,
    "duration": 1.728
  },
  {
    "id": 8,
    "text": "第一，文学观念分歧鲜明，",
    "start": 29.851,
    "end": 31.956,
    "duration": 2.105
  },
  {
    "id": 9,
    "text": "呈现“为人生”的启蒙功利与“为艺术”的审美自足之对峙。",
    "start": 32.118,
    "end": 36.462,
    "duration": 4.344
  },
  {
    "id": 10,
    "text": "文学研究会以《小说月报》为阵地，",
    "start": 36.702,
    "end": 38.932,
    "duration": 2.23
  },
  {
    "id": 11,
    "text": "高扬“为人生而艺术”的大旗，",
    "start": 39.058,
    "end": 41.118,
    "duration": 2.06
  },
  {
    "id": 12,
    "text": "反对鸳鸯蝴蝶派将文学视为游戏消遣的市侩观念，",
    "start": 41.273,
    "end": 45.05,
    "duration": 3.777
  },
  {
    "id": 13,
    "text": "主张文学应当直面社会现实，",
    "start": 45.213,
    "end": 47.341,
    "duration": 2.128
  },
  {
    "id": 14,
    "text": "成为研究人生与暴露社会病态的工具；",
    "start": 47.613,
    "end": 50.439,
    "duration": 2.826
  },
  {
    "id": 15,
    "text": "创造社则高举“为艺术而艺术”的旗帜，",
    "start": 50.617,
    "end": 53.367,
    "duration": 2.75
  },
  {
    "id": 16,
    "text": "推崇文学是内在情感的要求，强调直觉、灵感与主观自我表现，",
    "start": 53.547,
    "end": 59.104,
    "duration": 5.557
  },
  {
    "id": 17,
    "text": "追求审美个性的纯粹与精神自由。",
    "start": 59.298,
    "end": 62.092,
    "duration": 2.794
  },
  {
    "id": 18,
    "text": "第二，创作方法各辟航道，",
    "start": 62.715,
    "end": 64.964,
    "duration": 2.249
  },
  {
    "id": 19,
    "text": "分别确立现实主义写实与浪漫主义主观抒情两大传统。",
    "start": 65.278,
    "end": 69.412,
    "duration": 4.134
  },
  {
    "id": 20,
    "text": "文学研究会恪守写实原则，",
    "start": 69.716,
    "end": 71.746,
    "duration": 2.03
  },
  {
    "id": 21,
    "text": "主张冷静客观地摹写底层疾苦与市民社会的灰色生活，",
    "start": 71.998,
    "end": 76.426,
    "duration": 4.428
  },
  {
    "id": 22,
    "text": "如叶圣陶《潘先生在难中》精准解剖小市民苟且偷生的妥协心理；",
    "start": 76.685,
    "end": 81.55,
    "duration": 4.865
  },
  {
    "id": 23,
    "text": "创造社则信奉浪漫主义与表现主义，拒绝客观拘束而直抒胸臆，",
    "start": 81.833,
    "end": 87.021,
    "duration": 5.188
  },
  {
    "id": 24,
    "text": "长于描写病态心理与反叛激情，",
    "start": 87.391,
    "end": 89.958,
    "duration": 2.567
  },
  {
    "id": 25,
    "text": "如郭沫若《女神》的火山爆发与郁达夫《沉沦》中灵肉撕裂的自叙传倾诉。",
    "start": 90.26,
    "end": 95.563,
    "duration": 5.303
  },
  {
    "id": 26,
    "text": "第三，精神渊源与后期演进迥异，",
    "start": 96.211,
    "end": 99.202,
    "duration": 2.991
  },
  {
    "id": 27,
    "text": "分别承接启蒙的社会理性与感性反叛激情。",
    "start": 99.524,
    "end": 102.928,
    "duration": 3.404
  },
  {
    "id": 28,
    "text": "文学研究会立足国内现实，",
    "start": 103.49,
    "end": 105.555,
    "duration": 2.065
  },
  {
    "id": 29,
    "text": "承接了启蒙运动中沉稳的社会批判理性，",
    "start": 105.839,
    "end": 108.979,
    "duration": 3.14
  },
  {
    "id": 30,
    "text": "后期创作持续深化现实主义道路；",
    "start": 109.535,
    "end": 112.041,
    "duration": 2.506
  },
  {
    "id": 31,
    "text": "创造社崛起于留日青年身处异邦的屈辱与青春苦闷，",
    "start": 112.41,
    "end": 116.892,
    "duration": 4.482
  },
  {
    "id": 32,
    "text": "承接了个性解放的炽烈激情，",
    "start": 117.162,
    "end": 119.298,
    "duration": 2.136
  },
  {
    "id": 33,
    "text": "在大革命浪潮中率先提出“革命文学”口号，",
    "start": 119.429,
    "end": 122.633,
    "duration": 3.204
  },
  {
    "id": 34,
    "text": "迅速转向无产阶级革命文学。",
    "start": 122.77,
    "end": 125.136,
    "duration": 2.366
  },
  {
    "id": 35,
    "text": "合两社而观之，两大社团各执一端而又相辅相成。",
    "start": 125.783,
    "end": 130.059,
    "duration": 4.276
  },
  {
    "id": 36,
    "text": "他们以双峰对峙的多元探索，",
    "start": 130.604,
    "end": 132.707,
    "duration": 2.103
  },
  {
    "id": 37,
    "text": "共同奠定了中国现代新文学现实主义与浪漫主义交相辉映的格局。",
    "start": 133.145,
    "end": 138.111,
    "duration": 4.966
  }
]