[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 2.96,
    "duration": 2.88
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 2.96,
    "end": 5.92,
    "duration": 2.96
  },
  {
    "id": 3,
    "text": "这道题考查当代长篇小说巅峰之作《白鹿原》。",
    "start": 5.92,
    "end": 9.84,
    "duration": 3.92
  },
  {
    "id": 4,
    "text": "在考场上，考生不能简单只是讲白嘉轩和鹿子霖争地或者田小娥的故事，",
    "start": 9.84,
    "end": 15.84,
    "duration": 6.0
  },
  {
    "id": 5,
    "text": "而必须紧扣“史诗性品格（宏阔时空加民间秘史）”与“宗族历史文化反思（白嘉轩与朱先生的双重文化面向）”两大抓手。",
    "start": 15.84,
    "end": 26.0,
    "duration": 10.16
  },
  {
    "id": 6,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 26.32,
    "end": 29.2,
    "duration": 2.88
  },
  {
    "id": 7,
    "text": "答题必须确立“史诗格局（半世纪编年史）趋近于文化剖析（白嘉轩硬气与残酷、",
    "start": 29.2,
    "end": 36.64,
    "duration": 7.44
  },
  {
    "id": 8,
    "text": "朱先生圣贤理想）趋近于艺术美学（关中乡土加白鹿魔幻神秘主义）”的三维递进框架，",
    "start": 36.64,
    "end": 44.8,
    "duration": 8.16
  },
  {
    "id": 9,
    "text": "深入剖析儒家宗法文明在现代转型期的阵痛与坚韧。",
    "start": 44.8,
    "end": 49.52,
    "duration": 4.72
  },
  {
    "id": 10,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 49.84,
    "end": 53.2,
    "duration": 3.36
  },
  {
    "id": 11,
    "text": "全题分为四个核心论述维度：第一维度：界定《白鹿原》作为当代展现民族灵魂变迁最雄厚史诗巨著的文学史坐标；",
    "start": 53.2,
    "end": 62.72,
    "duration": 9.52
  },
  {
    "id": 12,
    "text": "第二维度：深入剖析半个世纪编年史时空与“民间秘史”视角的宏阔史诗性品格；",
    "start": 62.72,
    "end": 69.2,
    "duration": 6.48
  },
  {
    "id": 13,
    "text": "第三维度：深刻论述儒家宗法文化韧性与礼教噬人残酷性（白嘉轩建镇魂塔versus朱先生文化图腾）；",
    "start": 69.52,
    "end": 78.56,
    "duration": 9.04
  },
  {
    "id": 14,
    "text": "第四维度：精细剖析关中原生态乡土写实与“白鹿”魔幻神秘主义象征的艺术融铸；",
    "start": 78.56,
    "end": 85.28,
    "duration": 6.72
  },
  {
    "id": 15,
    "text": "第五维度：宏观总结作品对中华民族近代精神新生阵痛的崇高史诗定论。",
    "start": 85.28,
    "end": 91.44,
    "duration": 6.16
  },
  {
    "id": 16,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 91.76,
    "end": 95.84,
    "duration": 4.08
  },
  {
    "id": 17,
    "text": "全题逻辑严密咬合：第一步先确立民族史诗的崇高地位。",
    "start": 95.84,
    "end": 100.88,
    "duration": 5.04
  },
  {
    "id": 18,
    "text": "第二步展开宏观史诗外壳，即半世纪编年史风云与民间秘史。",
    "start": 100.88,
    "end": 106.32,
    "duration": 5.44
  },
  {
    "id": 19,
    "text": "第三步深入史诗灵魂核心，解剖宗族文化支柱白嘉轩与朱先生的文化哲理。",
    "start": 106.32,
    "end": 112.72,
    "duration": 6.4
  },
  {
    "id": 20,
    "text": "第四步剖析承载这种史诗的关中地域风情与魔幻白鹿艺术。",
    "start": 112.96,
    "end": 118.24,
    "duration": 5.28
  },
  {
    "id": 21,
    "text": "第五步完成宏观历史论证闭环。",
    "start": 118.24,
    "end": 120.72,
    "duration": 2.48
  },
  {
    "id": 22,
    "text": "二、各板块逐句咬合演练。",
    "start": 120.72,
    "end": 123.36,
    "duration": 2.64
  },
  {
    "id": 23,
    "text": "一、开头破题段内部咬合。",
    "start": 123.36,
    "end": 125.92,
    "duration": 2.56
  },
  {
    "id": 24,
    "text": "本段旨在开门见山确立当代现实主义史诗第一峰的立论基石。",
    "start": 125.92,
    "end": 131.12,
    "duration": 5.2
  },
  {
    "id": 25,
    "text": "首句直切经典地位，次句交代白鹿两大家族半世纪沉浮与宗族文化反思。",
    "start": 131.12,
    "end": 137.52,
    "duration": 6.4
  },
  {
    "id": 26,
    "text": "-首先，首句必须直接亮出该作在当代文学史上的崇高地位，",
    "start": 137.736,
    "end": 142.484,
    "duration": 4.748
  },
  {
    "id": 27,
    "text": "具体表述到答题语句就是：陈忠实创作的长篇小说《白鹿原》，",
    "start": 142.484,
    "end": 147.232,
    "duration": 4.748
  },
  {
    "id": 28,
    "text": "是中国当代文学史上展现民族灵魂变迁最雄浑沉厚的现实主义史诗巨著。",
    "start": 147.232,
    "end": 153.366,
    "duration": 6.134
  },
  {
    "id": 29,
    "text": "有了经典定性之后，次句必须迅速说明其时空跨度与思想解剖深度，",
    "start": 153.366,
    "end": 158.905,
    "duration": 5.539
  },
  {
    "id": 30,
    "text": "具体表述到答题语句就是：作品以陕西关中平原白鹿村为历史缩影，",
    "start": 158.905,
    "end": 164.445,
    "duration": 5.54
  },
  {
    "id": 31,
    "text": "通过白鹿两大家族祖孙三代长达半个世纪的血泪恩怨与兴衰沉浮，",
    "start": 164.445,
    "end": 169.984,
    "duration": 5.539
  },
  {
    "id": 32,
    "text": "深刻解剖了二十世纪中国社会剧烈变革中传统宗族文化的内在韧性与裂变阵痛，",
    "start": 169.984,
    "end": 176.711,
    "duration": 6.727
  },
  {
    "id": 33,
    "text": "树立了当代文学审视民族历史的精神丰碑。，",
    "start": 176.711,
    "end": 180.272,
    "duration": 3.561
  },
  {
    "id": 34,
    "text": "这句话直接铺陈出史诗品格与文化反思两翼齐飞的论述骨架。",
    "start": 180.272,
    "end": 185.416,
    "duration": 5.144
  },
  {
    "id": 35,
    "text": "陈忠实创作的长篇小说《白鹿原》，",
    "start": 185.576,
    "end": 188.136,
    "duration": 2.56
  },
  {
    "id": 36,
    "text": "是中国当代文学史上展现民族灵魂变迁最雄浑沉厚的现实主义史诗巨著。",
    "start": 188.136,
    "end": 194.776,
    "duration": 6.64
  },
  {
    "id": 37,
    "text": "作品以陕西关中平原白鹿村为历史缩影，",
    "start": 194.776,
    "end": 198.216,
    "duration": 3.44
  },
  {
    "id": 38,
    "text": "通过白鹿两大家族祖孙三代长达半个世纪的血泪恩怨与兴衰沉浮，",
    "start": 198.216,
    "end": 204.056,
    "duration": 5.84
  },
  {
    "id": 39,
    "text": "深刻解剖了二十世纪中国社会剧烈变革中传统宗族文化的内在韧性与裂变阵痛，",
    "start": 204.056,
    "end": 211.096,
    "duration": 7.04
  },
  {
    "id": 40,
    "text": "树立了当代文学审视民族历史的精神丰碑。",
    "start": 211.096,
    "end": 214.536,
    "duration": 3.44
  },
  {
    "id": 41,
    "text": "二、第一维度：半世纪风云变幻的宏阔史诗性品格内部咬合。",
    "start": 214.936,
    "end": 219.976,
    "duration": 5.04
  },
  {
    "id": 42,
    "text": "本段任务是深入剖析编年史架构，巴尔扎克式民间秘史与两家争斗。",
    "start": 219.976,
    "end": 225.256,
    "duration": 5.28
  },
  {
    "id": 43,
    "text": "首先，段首给出结论先行的分论点，",
    "start": 225.256,
    "end": 227.896,
    "duration": 2.64
  },
  {
    "id": 44,
    "text": "具体表述到答题语句就是：第一，在叙事格局上，",
    "start": 227.896,
    "end": 231.656,
    "duration": 3.76
  },
  {
    "id": 45,
    "text": "作品构建了编年史式的宏阔时空架构，",
    "start": 231.656,
    "end": 234.616,
    "duration": 2.96
  },
  {
    "id": 46,
    "text": "展现出吞吐历史风云的宏大史诗性品格。",
    "start": 234.616,
    "end": 237.496,
    "duration": 2.88
  },
  {
    "id": 47,
    "text": "-随后，梳理从清末到新中国成立的壮阔历史跨度，",
    "start": 237.736,
    "end": 241.891,
    "duration": 4.155
  },
  {
    "id": 48,
    "text": "具体表述到答题语句就是：小说时间跨越从清末同治皮匠起义、",
    "start": 241.891,
    "end": 247.293,
    "duration": 5.402
  },
  {
    "id": 49,
    "text": "辛亥革命、军阀混战、国共合作与对峙，",
    "start": 247.293,
    "end": 250.41,
    "duration": 3.117
  },
  {
    "id": 50,
    "text": "直至新中国建立前夕的数十年动荡历史。",
    "start": 250.41,
    "end": 253.942,
    "duration": 3.532
  },
  {
    "id": 51,
    "text": "紧接着，指出其突破公式化政治叙事的民间秘史视角：陈忠实打破了传统政治意识形态挂帅的公式化叙事，",
    "start": 253.942,
    "end": 263.084,
    "duration": 9.142
  },
  {
    "id": 52,
    "text": "开辟了巴尔扎克式“民间秘史”的深邃视角。",
    "start": 263.084,
    "end": 266.616,
    "duration": 3.532
  },
  {
    "id": 53,
    "text": "-随后，结合两家争夺权力与后代党派分流的血泪细节：白鹿两家为争夺族长权力、",
    "start": 266.616,
    "end": 273.415,
    "duration": 6.799
  },
  {
    "id": 54,
    "text": "换地建坟、以及后代子嗣在国共阵营之间的生死撕杀，",
    "start": 273.415,
    "end": 277.948,
    "duration": 4.533
  },
  {
    "id": 55,
    "text": "与外部世界翻天覆地的历史巨浪严密咬合。",
    "start": 277.948,
    "end": 281.656,
    "duration": 3.708
  },
  {
    "id": 56,
    "text": "-最后，收束提炼宏大史诗全景图：风车水转的时代狂澜落脚于关中农民的生死稼瑟之中，",
    "start": 281.712,
    "end": 289.401,
    "duration": 7.689
  },
  {
    "id": 57,
    "text": "全方位绘制了一幅中国北方乡村社会在现代转型期血泪交织的历史全景图。",
    "start": 289.401,
    "end": 296.235,
    "duration": 6.834
  },
  {
    "id": 58,
    "text": "第一，在叙事格局上，作品构建了编年史式的宏阔时空架构，",
    "start": 296.235,
    "end": 301.361,
    "duration": 5.126
  },
  {
    "id": 59,
    "text": "展现出吞吐历史风云的宏大史诗性品格。",
    "start": 301.361,
    "end": 304.992,
    "duration": 3.631
  },
  {
    "id": 60,
    "text": "小说时间跨越从清末同治皮匠起义、",
    "start": 305.152,
    "end": 308.512,
    "duration": 3.36
  },
  {
    "id": 61,
    "text": "辛亥革命、军阀混战、国共合作与对峙，",
    "start": 308.512,
    "end": 311.792,
    "duration": 3.28
  },
  {
    "id": 62,
    "text": "直至新中国建立前夕的数十年动荡历史。",
    "start": 311.792,
    "end": 315.152,
    "duration": 3.36
  },
  {
    "id": 63,
    "text": "陈忠实打破了传统政治意识形态挂帅的公式化叙事，",
    "start": 315.152,
    "end": 319.552,
    "duration": 4.4
  },
  {
    "id": 64,
    "text": "开辟了巴尔扎克式“民间秘史”的深邃视角。",
    "start": 319.552,
    "end": 322.912,
    "duration": 3.36
  },
  {
    "id": 65,
    "text": "白鹿两家为争夺族长权力、换地建坟、",
    "start": 322.912,
    "end": 326.192,
    "duration": 3.28
  },
  {
    "id": 66,
    "text": "以及后代子嗣在国共阵营之间的生死撕杀，",
    "start": 326.192,
    "end": 329.952,
    "duration": 3.76
  },
  {
    "id": 67,
    "text": "与外部世界翻天覆地的历史巨浪严密咬合。",
    "start": 329.952,
    "end": 333.072,
    "duration": 3.12
  },
  {
    "id": 68,
    "text": "风车水转的时代狂澜落脚于关中农民的生死稼瑟之中，",
    "start": 333.472,
    "end": 337.872,
    "duration": 4.4
  },
  {
    "id": 69,
    "text": "全方位绘制了一幅中国北方乡村社会在现代转型期血泪交织的历史全景图。",
    "start": 337.872,
    "end": 344.432,
    "duration": 6.56
  },
  {
    "id": 70,
    "text": "三、第二维度：宗法文化双重反思与人物塑造内部咬合。",
    "start": 344.432,
    "end": 349.392,
    "duration": 4.96
  },
  {
    "id": 71,
    "text": "本段任务是直击本题核心，深入解剖白嘉轩挺直腰杆与建塔镇魂的双重性，",
    "start": 349.392,
    "end": 355.312,
    "duration": 5.92
  },
  {
    "id": 72,
    "text": "并对比鹿子霖与朱先生。",
    "start": 355.312,
    "end": 356.992,
    "duration": 1.68
  },
  {
    "id": 73,
    "text": "-首先，段首给出统领分论点，具体表述到答题语句就是：第二，",
    "start": 357.152,
    "end": 362.06,
    "duration": 4.908
  },
  {
    "id": 74,
    "text": "在思想精神与人物塑造上，作品以冷峻深邃的文化反思眼光，",
    "start": 362.06,
    "end": 367.173,
    "duration": 5.113
  },
  {
    "id": 75,
    "text": "深刻剖析了儒家宗法伦理的坚韧生命力与其扼杀个体人性的双重面向。",
    "start": 367.173,
    "end": 373.308,
    "duration": 6.135
  },
  {
    "id": 76,
    "text": "随后，剖析白嘉轩身上中国传统士农阶层的人格硬气，",
    "start": 373.308,
    "end": 377.808,
    "duration": 4.5
  },
  {
    "id": 77,
    "text": "具体表述到答题语句就是：白嘉轩是作品耗费心血塑造的宗法家族精神支柱。",
    "start": 377.808,
    "end": 384.352,
    "duration": 6.544
  },
  {
    "id": 78,
    "text": "他腰杆挺得笔直，严格恪守“耕读传家”的儒家纲常，",
    "start": 384.432,
    "end": 389.072,
    "duration": 4.64
  },
  {
    "id": 79,
    "text": "在面对兵荒马乱与瘟疫饥荒时沉着坚毅，",
    "start": 389.072,
    "end": 392.672,
    "duration": 3.6
  },
  {
    "id": 80,
    "text": "展现出中国传统士农阶层深沉的人格硬气。",
    "start": 392.672,
    "end": 396.592,
    "duration": 3.92
  },
  {
    "id": 81,
    "text": "紧接着，深入其残酷噬人的一面，调取打枣刺与建塔镇魂的关键细节：然而，",
    "start": 396.592,
    "end": 403.152,
    "duration": 6.56
  },
  {
    "id": 82,
    "text": "这种儒家道德一旦走向极端，便暴露出残酷冷酷的噬人本质。",
    "start": 403.152,
    "end": 408.112,
    "duration": 4.96
  },
  {
    "id": 83,
    "text": "白嘉轩严惩赌徒、用枣刺鞭吃败坏门风的亲侄子，",
    "start": 408.352,
    "end": 413.472,
    "duration": 5.12
  },
  {
    "id": 84,
    "text": "乃至在田小娥死后联合村民建造“镇魂塔”压制其阴魂，",
    "start": 413.472,
    "end": 418.672,
    "duration": 5.2
  },
  {
    "id": 85,
    "text": "无情体现了封建宗族制度对底层叛逆女性自由情欲的残忍剿灭。",
    "start": 418.672,
    "end": 424.592,
    "duration": 5.92
  },
  {
    "id": 86,
    "text": "-随后，对比投机钻营的鹿子霖，补全乡村生态：相比之下，",
    "start": 424.8,
    "end": 429.288,
    "duration": 4.488
  },
  {
    "id": 87,
    "text": "鹿子霖则是见风使舵、私欲膨胀的投机者典型，",
    "start": 429.288,
    "end": 433.164,
    "duration": 3.876
  },
  {
    "id": 88,
    "text": "两人互为表里，共同构成了中国乡村宗法社会的复杂生态。",
    "start": 433.164,
    "end": 438.06,
    "duration": 4.896
  },
  {
    "id": 89,
    "text": "最后，点出朱先生作为儒家圣贤文化图腾的崇高价值：而关中圣人朱先生则是传统儒家文化精神升华的象征，",
    "start": 438.06,
    "end": 447.24,
    "duration": 9.18
  },
  {
    "id": 90,
    "text": "他在白鹿书院清修静观，超越党派恩怨，",
    "start": 447.24,
    "end": 450.504,
    "duration": 3.264
  },
  {
    "id": 91,
    "text": "具有洞察历史兴亡的先知智慧，寄托着作者对民族优秀传统文化哲理的深情敬意。",
    "start": 450.504,
    "end": 457.44,
    "duration": 6.936
  },
  {
    "id": 92,
    "text": "第二，在思想精神与人物塑造上，作品以冷峻深邃的文化反思眼光，",
    "start": 457.52,
    "end": 463.28,
    "duration": 5.76
  },
  {
    "id": 93,
    "text": "深刻剖析了儒家宗法伦理的坚韧生命力与其扼杀个体人性的双重面向。",
    "start": 463.28,
    "end": 469.44,
    "duration": 6.16
  },
  {
    "id": 94,
    "text": "白嘉轩是作品耗费心血塑造的宗法家族精神支柱。",
    "start": 469.44,
    "end": 473.68,
    "duration": 4.24
  },
  {
    "id": 95,
    "text": "他腰杆挺得笔直，严格恪守“耕读传家”的儒家纲常，",
    "start": 473.68,
    "end": 478.0,
    "duration": 4.32
  },
  {
    "id": 96,
    "text": "在面对兵荒马乱与瘟疫饥荒时沉着坚毅，",
    "start": 478.0,
    "end": 481.6,
    "duration": 3.6
  },
  {
    "id": 97,
    "text": "展现出中国传统士农阶层深沉的人格硬气。",
    "start": 481.6,
    "end": 485.12,
    "duration": 3.52
  },
  {
    "id": 98,
    "text": "然而，这种儒家道德一旦走向极端，",
    "start": 485.44,
    "end": 488.16,
    "duration": 2.72
  },
  {
    "id": 99,
    "text": "便暴露出残酷冷酷的噬人本质。",
    "start": 488.16,
    "end": 490.88,
    "duration": 2.72
  },
  {
    "id": 100,
    "text": "白嘉轩严惩赌徒、用枣刺鞭吃败坏门风的亲侄子，",
    "start": 490.88,
    "end": 495.6,
    "duration": 4.72
  },
  {
    "id": 101,
    "text": "乃至在田小娥死后联合村民建造“镇魂塔”压制其阴魂，",
    "start": 495.6,
    "end": 500.24,
    "duration": 4.64
  },
  {
    "id": 102,
    "text": "无情体现了封建宗族制度对底层叛逆女性自由情欲的残忍剿灭。",
    "start": 500.24,
    "end": 505.52,
    "duration": 5.28
  },
  {
    "id": 103,
    "text": "相比之下，鹿子霖则是见风使舵、私欲膨胀的投机者典型，",
    "start": 505.84,
    "end": 511.44,
    "duration": 5.6
  },
  {
    "id": 104,
    "text": "两人互为表里，共同构成了中国乡村宗法社会的复杂生态。",
    "start": 511.44,
    "end": 516.96,
    "duration": 5.52
  },
  {
    "id": 105,
    "text": "而关中圣人朱先生则是传统儒家文化精神升华的象征，",
    "start": 516.96,
    "end": 522.16,
    "duration": 5.2
  },
  {
    "id": 106,
    "text": "他在白鹿书院清修静观，超越党派恩怨，",
    "start": 522.16,
    "end": 526.24,
    "duration": 4.08
  },
  {
    "id": 107,
    "text": "具有洞察历史兴亡的先知智慧，寄托着作者对民族优秀传统文化哲理的深情敬意。",
    "start": 526.24,
    "end": 533.28,
    "duration": 7.04
  },
  {
    "id": 108,
    "text": "四、第三维度：关中乡土写实与魔幻现实主义融铸内部咬合。",
    "start": 533.68,
    "end": 538.8,
    "duration": 5.12
  },
  {
    "id": 109,
    "text": "本段任务是落实到艺术形式，剖析关中原生态风俗与白鹿神话象征。",
    "start": 538.8,
    "end": 544.32,
    "duration": 5.52
  },
  {
    "id": 110,
    "text": "首先，段首给出统领分论点，具体表述到答题语句就是：第三，",
    "start": 544.32,
    "end": 549.2,
    "duration": 4.88
  },
  {
    "id": 111,
    "text": "在美学形态与艺术手法上，作品成功实现了原生态关中乡土写实与魔幻神秘主义象征手法的深度融合。",
    "start": 549.2,
    "end": 557.2,
    "duration": 8.0
  },
  {
    "id": 112,
    "text": "-随后，剖析浓烈的关中乡土风俗写实：陈忠实以浓烈浑厚的关中方言为底色，",
    "start": 557.36,
    "end": 564.066,
    "duration": 6.706
  },
  {
    "id": 113,
    "text": "生动还原了关中平原的祭祖、修谱、",
    "start": 564.066,
    "end": 567.095,
    "duration": 3.029
  },
  {
    "id": 114,
    "text": "祈雨、秦腔与饮食风尚，全书洋溢着苍茫雄浑的原生态地域气息。",
    "start": 567.095,
    "end": 572.72,
    "duration": 5.625
  },
  {
    "id": 115,
    "text": "-紧接着，深入剖析白鹿精灵的神话象征意义：同时，",
    "start": 572.784,
    "end": 577.035,
    "duration": 4.251
  },
  {
    "id": 116,
    "text": "小说创造性地吸收了拉美魔幻现实主义的艺术养分，",
    "start": 577.035,
    "end": 581.712,
    "duration": 4.677
  },
  {
    "id": 117,
    "text": "引入了贯穿全篇的“白鹿”精灵传说。",
    "start": 581.712,
    "end": 584.688,
    "duration": 2.976
  },
  {
    "id": 118,
    "text": "那只在原野上跃动的雪白神鹿，不仅是这片土地吉祥宁静的文化图腾，",
    "start": 584.688,
    "end": 590.853,
    "duration": 6.165
  },
  {
    "id": 119,
    "text": "更象征着超越现实苦难的纯洁人性与历史理想。",
    "start": 590.853,
    "end": 595.104,
    "duration": 4.251
  },
  {
    "id": 120,
    "text": "-最后，调取田小娥化蝶瘟疫的魔幻写实交融收束：田小娥死后化为飞蛾引发瘟疫的超自然情节，",
    "start": 595.104,
    "end": 603.142,
    "duration": 8.038
  },
  {
    "id": 121,
    "text": "与冷峻扎实的现实主义白描互为交融，",
    "start": 603.142,
    "end": 606.44,
    "duration": 3.298
  },
  {
    "id": 122,
    "text": "赋予了整部史诗以奇诡神秘的哲学神秘感。",
    "start": 606.44,
    "end": 610.149,
    "duration": 3.709
  },
  {
    "id": 123,
    "text": "第三，在美学形态与艺术手法上，作品成功实现了原生态关中乡土写实与魔幻神秘主义象征手法的深度融合。",
    "start": 610.149,
    "end": 619.424,
    "duration": 9.275
  },
  {
    "id": 124,
    "text": "陈忠实以浓烈浑厚的关中方言为底色，",
    "start": 619.504,
    "end": 622.704,
    "duration": 3.2
  },
  {
    "id": 125,
    "text": "生动还原了关中平原的祭祖、修谱、",
    "start": 622.704,
    "end": 625.824,
    "duration": 3.12
  },
  {
    "id": 126,
    "text": "祈雨、秦腔与饮食风尚，全书洋溢着苍茫雄浑的原生态地域气息。",
    "start": 625.824,
    "end": 631.984,
    "duration": 6.16
  },
  {
    "id": 127,
    "text": "同时，小说创造性地吸收了拉美魔幻现实主义的艺术养分，",
    "start": 631.984,
    "end": 636.624,
    "duration": 4.64
  },
  {
    "id": 128,
    "text": "引入了贯穿全篇的“白鹿”精灵传说。",
    "start": 636.624,
    "end": 639.344,
    "duration": 2.72
  },
  {
    "id": 129,
    "text": "那只在原野上跃动的雪白神鹿，不仅是这片土地吉祥宁静的文化图腾，",
    "start": 639.664,
    "end": 645.424,
    "duration": 5.76
  },
  {
    "id": 130,
    "text": "更象征着超越现实苦难的纯洁人性与历史理想。",
    "start": 645.424,
    "end": 649.664,
    "duration": 4.24
  },
  {
    "id": 131,
    "text": "田小娥死后化为飞蛾引发瘟疫的超自然情节，",
    "start": 649.664,
    "end": 653.504,
    "duration": 3.84
  },
  {
    "id": 132,
    "text": "与冷峻扎实的现实主义白描互为交融，",
    "start": 653.504,
    "end": 656.784,
    "duration": 3.28
  },
  {
    "id": 133,
    "text": "赋予了整部史诗以奇诡神秘的哲学神秘感。",
    "start": 656.784,
    "end": 660.624,
    "duration": 3.84
  },
  {
    "id": 134,
    "text": "五、结尾收束升华段内部咬合。",
    "start": 660.864,
    "end": 664.224,
    "duration": 3.36
  },
  {
    "id": 135,
    "text": "本段承担全篇论证成果的系统提炼与历史定位，",
    "start": 664.224,
    "end": 668.384,
    "duration": 4.16
  },
  {
    "id": 136,
    "text": "完成宏观历史论证闭环。",
    "start": 668.384,
    "end": 670.784,
    "duration": 2.4
  },
  {
    "id": 137,
    "text": "首先，全面回收历史容量、宗族反思与地域品格，",
    "start": 670.784,
    "end": 675.264,
    "duration": 4.48
  },
  {
    "id": 138,
    "text": "具体表述到答题语句就是：综上所述，",
    "start": 675.264,
    "end": 678.704,
    "duration": 3.44
  },
  {
    "id": 139,
    "text": "陈忠实《白鹿原》以宏大壮阔的历史容量、",
    "start": 678.704,
    "end": 682.304,
    "duration": 3.6
  },
  {
    "id": 140,
    "text": "深沉严峻的宗族文化剖析与雄浑苍劲的地域艺术品格，",
    "start": 682.304,
    "end": 687.344,
    "duration": 5.04
  },
  {
    "id": 141,
    "text": "在中国当代长篇小说史上构筑了一座气象万千的艺术高峰。",
    "start": 687.344,
    "end": 692.144,
    "duration": 4.8
  },
  {
    "id": 142,
    "text": "-紧接着，总结对民族近代精神新生阵痛庄严立碑的宏伟定论，",
    "start": 692.384,
    "end": 697.527,
    "duration": 5.143
  },
  {
    "id": 143,
    "text": "具体表述到答题语句就是：它不仅是对渭北高原上数代人生命悲欢的深沉挽歌，",
    "start": 697.527,
    "end": 704.315,
    "duration": 6.788
  },
  {
    "id": 144,
    "text": "更是对中华民族近代精神新生所经历的艰难阵痛的庄严立碑。",
    "start": 704.315,
    "end": 709.664,
    "duration": 5.349
  },
  {
    "id": 145,
    "text": "综上所述，陈忠实《白鹿原》以宏大壮阔的历史容量、",
    "start": 709.808,
    "end": 714.208,
    "duration": 4.4
  },
  {
    "id": 146,
    "text": "深沉严峻的宗族文化剖析与雄浑苍劲的地域艺术品格，",
    "start": 714.208,
    "end": 719.328,
    "duration": 5.12
  },
  {
    "id": 147,
    "text": "在中国当代长篇小说史上构筑了一座气象万千的艺术高峰。",
    "start": 719.328,
    "end": 724.368,
    "duration": 5.04
  },
  {
    "id": 148,
    "text": "它不仅是对渭北高原上数代人生命悲欢的深沉挽歌，",
    "start": 724.368,
    "end": 728.848,
    "duration": 4.48
  },
  {
    "id": 149,
    "text": "更是对中华民族近代精神新生所经历的艰难阵痛的庄严立碑。",
    "start": 728.848,
    "end": 733.888,
    "duration": 5.04
  }
]