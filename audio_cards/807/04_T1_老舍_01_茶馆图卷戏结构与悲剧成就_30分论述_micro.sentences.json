[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "老舍·茶馆图卷戏结构与悲剧成就",
    "start": 0.154,
    "end": 3.58,
    "duration": 3.426
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "“五维并举”精准还原茶馆全局（也是本篇5卡真实骨架）：1.结构破锁闭立“图卷戏”→2.人物立“三位一体主角是时代”→3.象征推至“三老汉撒纸钱”含泪微笑→4.台词归“一句顶十句”京味口语→5.思想判“三个好人全幻想破灭、旧时代必亡”。",
    "start": 4.508,
    "end": 33.08,
    "duration": 28.572
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "老舍三幕话剧《茶馆》借裕泰茶馆半世纪沉浮，截取戊戌失败、军阀混战与国民党崩溃前夕三断面，",
    "start": 33.914,
    "end": 43.02,
    "duration": 9.106
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "以独创“图卷戏”宣告旧时代灭亡必然。",
    "start": 43.408,
    "end": 46.7,
    "duration": 3.292
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 独创“图卷戏”三幕、破西方锁闭成规",
    "start": 47.628,
    "end": 51.52,
    "duration": 3.892
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "打破单一贯穿主角与严密因果锁闭，借鉴《清明上河图》散点透视，以裕泰茶馆为枢纽连缀数十生活截面；",
    "start": 52.528,
    "end": 63.5,
    "duration": 10.972
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "看似形散，实被社会步步溃烂的沉痛暗线牢牢统摄，达“形散而神聚”。",
    "start": 64.468,
    "end": 71.64,
    "duration": 7.172
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 群像谱系：“没有主角的主角是时代”",
    "start": 72.568,
    "end": 76.26,
    "duration": 3.692
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "王利发精明本分委曲求全，终因茶馆被霸占自缢后房；硬汉常四爷冻饿难买棺材；",
    "start": 76.744,
    "end": 85.596,
    "duration": 8.852
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "“实业救国”秦仲义办厂被没收拆毁；",
    "start": 85.944,
    "end": 88.916,
    "duration": 2.972
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "三阶层好人共遭灭顶之灾，证真正被押上审判台的是吃人旧制度。",
    "start": 89.444,
    "end": 96.016,
    "duration": 6.572
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 悲喜交融幽默格调与“三老汉撒纸钱”",
    "start": 96.724,
    "end": 100.776,
    "duration": 4.052
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "推高英式幽默与民族悲剧心理融汇之“含泪微笑”，以喜剧形式反衬生存荒谬；",
    "start": 101.628,
    "end": 109.4,
    "duration": 7.772
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "三白发老人狂笑作揖、漫天抛撒捡来冥纸，既是活着为自己凄凉出殡，更是为三个黑暗旧时代举行盛大辛辣葬礼。",
    "start": 110.448,
    "end": 122.46,
    "duration": 12.012
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 纯正洗练京味语言、树白话话剧典范",
    "start": 123.388,
    "end": 128.28,
    "duration": 4.892
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "扫除欧化翻译腔与概念说教，提炼地道北京市民口语为富有潜台词之舞台语，“一句顶十句”；",
    "start": 129.248,
    "end": 138.26,
    "duration": 9.012
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "唐铁嘴无耻俏皮、宋恩子吴祥子阴阳怪气、常四爷刚正硬朗，调侃成底层精神护甲。",
    "start": 139.268,
    "end": 147.28,
    "duration": 8.012
  },
  {
    "id": "sec4_title_c0",
    "dom_key": "sec4_title_c0",
    "text": "05 · 深沉历史哲学反思、昭示旧制度必亡",
    "start": 148.288,
    "end": 152.54,
    "duration": 4.252
  },
  {
    "id": "sec4_step0_c0",
    "dom_key": "sec4_step0_c0",
    "text": "未正面写枪林弹雨，借小茶馆盛衰证明：王利发改良自保、常四爷道德自救、秦仲义实业救国在旧体制下全属幻想；",
    "start": 153.588,
    "end": 164.52,
    "duration": 10.932
  },
  {
    "id": "sec4_step1_c0",
    "dom_key": "sec4_step1_c0",
    "text": "为旧时代判处死刑，昭示唯有根本社会变革方为人民生路。",
    "start": 165.488,
    "end": 171.7,
    "duration": 6.212
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《茶馆》在结构创新、群像度量、象征意象、语言造诣与历史反思五维均达极高水准，为现当代戏剧史传世经典。",
    "start": 172.708,
    "end": 183.84,
    "duration": 11.132
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：《茶馆》是5个分论点（共7块卡片）：①图卷结构 ②三位一体主角是时代 ③撒纸钱幽默华彩 ④京味语言 ⑤历史必亡反思；",
    "start": 184.928,
    "end": 199.64,
    "duration": 14.712
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "三个断面：戊戌失败/军阀混战/抗战后。",
    "start": 199.988,
    "end": 203.04,
    "duration": 3.052
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背出老舍《茶馆》跨越哪三个精确历史断面与五个核心分论点顺序？",
    "start": 203.74,
    "end": 211.112,
    "duration": 7.372
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释“图卷戏”“没有主角的主角是时代”“三位一体悲剧”三组核心术语？",
    "start": 212.04,
    "end": 218.572,
    "duration": 6.532
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 复述第三幕“三老汉撒纸钱”的双重象征意义与京味语言代表口吻？",
    "start": 219.46,
    "end": 226.592,
    "duration": 7.132
  }
]