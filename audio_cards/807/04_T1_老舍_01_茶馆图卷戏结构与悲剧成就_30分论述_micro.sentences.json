[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "“五维并举”精准还原茶馆全局（也是本篇5卡真实骨架）：1.结构破锁闭立“图卷戏”",
    "start": 0.222,
    "end": 8.109,
    "duration": 7.887
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "→2.人物立“三位一体主角是时代”→3.象征推至“三老汉撒纸钱”含泪微笑",
    "start": 8.835,
    "end": 15.411,
    "duration": 6.575
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "→4.台词归“一句顶十句”京味口语",
    "start": 16.189,
    "end": 19.257,
    "duration": 3.067
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "→5.思想判“三个好人全幻想破灭、旧时代必亡”。",
    "start": 20.024,
    "end": 24.255,
    "duration": 4.23
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "老舍三幕话剧《茶馆》借裕泰茶馆半世纪沉浮，",
    "start": 25.068,
    "end": 28.564,
    "duration": 3.496
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "截取戊戌失败、军阀混战与国民党崩溃前夕三断面，",
    "start": 29.395,
    "end": 33.789,
    "duration": 4.394
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "以独创“图卷戏”宣告旧时代灭亡必然。",
    "start": 34.543,
    "end": 37.602,
    "duration": 3.059
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 独创“图卷戏”三幕、破西方锁闭成规",
    "start": 38.387,
    "end": 42.027,
    "duration": 3.64
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "打破单一贯穿主角与严密因果锁闭，借鉴《清明上河图》散点透视，",
    "start": 42.754,
    "end": 48.394,
    "duration": 5.64
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "以裕泰茶馆为枢纽连缀数十生活截面；",
    "start": 49.143,
    "end": 52.297,
    "duration": 3.153
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "看似形散，实被社会步步溃烂的沉痛暗线牢牢统摄，达“形散而神聚”。",
    "start": 53.025,
    "end": 59.136,
    "duration": 6.111
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 群像谱系：“没有主角的主角是时代”",
    "start": 59.835,
    "end": 63.297,
    "duration": 3.462
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "王利发精明本分委曲求全，终因茶馆被霸占自缢后房；",
    "start": 64.09,
    "end": 68.587,
    "duration": 4.497
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "硬汉常四爷冻饿难买棺材；",
    "start": 69.33,
    "end": 71.622,
    "duration": 2.292
  },
  {
    "id": "sec1_step0_c2",
    "dom_key": "sec1_step0_c2",
    "text": "“实业救国”秦仲义办厂被没收拆毁；",
    "start": 72.329,
    "end": 75.144,
    "duration": 2.815
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "三阶层好人共遭灭顶之灾，证真正被押上审判台的是吃人旧制度。",
    "start": 75.91,
    "end": 81.434,
    "duration": 5.524
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 悲喜交融幽默格调与“三老汉撒纸钱”",
    "start": 82.314,
    "end": 86.254,
    "duration": 3.94
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "推高英式幽默与民族悲剧心理融汇之“含泪微笑”，以喜剧形式反衬生存荒谬；",
    "start": 87.013,
    "end": 93.931,
    "duration": 6.918
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "三白发老人狂笑作揖、漫天抛撒捡来冥纸，既是活着为自己凄凉出殡，",
    "start": 94.727,
    "end": 100.705,
    "duration": 5.978
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "更是为三个黑暗旧时代举行盛大辛辣葬礼。",
    "start": 101.454,
    "end": 104.853,
    "duration": 3.399
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 纯正洗练京味语言、树白话话剧典范",
    "start": 105.62,
    "end": 109.525,
    "duration": 3.904
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "扫除欧化翻译腔与概念说教，提炼地道北京市民口语为富有潜台词之舞台语，“一句顶十句”；",
    "start": 110.254,
    "end": 118.202,
    "duration": 7.948
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "唐铁嘴无耻俏皮、宋恩子吴祥子阴阳怪气、常四爷刚正硬朗，调侃成底层精神护甲。",
    "start": 118.95,
    "end": 126.641,
    "duration": 7.69
  },
  {
    "id": "sec4_title_c0",
    "dom_key": "sec4_title_c0",
    "text": "05 · 深沉历史哲学反思、昭示旧制度必亡",
    "start": 127.472,
    "end": 131.459,
    "duration": 3.987
  },
  {
    "id": "sec4_step0_c0",
    "dom_key": "sec4_step0_c0",
    "text": "未正面写枪林弹雨，借小茶馆盛衰证明：王利发改良自保、常四爷道德自救、秦仲义实业救国在旧体制下全属幻想；",
    "start": 132.288,
    "end": 142.387,
    "duration": 10.099
  },
  {
    "id": "sec4_step1_c0",
    "dom_key": "sec4_step1_c0",
    "text": "为旧时代判处死刑，昭示唯有根本社会变革方为人民生路。",
    "start": 143.253,
    "end": 148.495,
    "duration": 5.242
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《茶馆》在结构创新、群像度量、象征意象、语言造诣与历史反思五维均达极高水准，",
    "start": 149.26,
    "end": 156.743,
    "duration": 7.484
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "为现当代戏剧史传世经典。",
    "start": 157.573,
    "end": 159.805,
    "duration": 2.231
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：《茶馆》是5个分论点（共7块卡片）：①图卷结构 ②三位一体主角是时代 ③撒纸钱幽默华彩 ④京味语言 ⑤历史必亡反思；",
    "start": 160.633,
    "end": 174.791,
    "duration": 14.158
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "三个断面：戊戌失败/军阀混战/抗战后。",
    "start": 175.493,
    "end": 179.028,
    "duration": 3.535
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背出老舍《茶馆》跨越哪三个精确历史断面与五个核心分论点顺序？",
    "start": 179.806,
    "end": 186.685,
    "duration": 6.879
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释“图卷戏”“没有主角的主角是时代”“三位一体悲剧”三组核心术语？",
    "start": 187.399,
    "end": 194.068,
    "duration": 6.669
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 复述第三幕“三老汉撒纸钱”的双重象征意义与京味语言代表口吻？",
    "start": 194.92,
    "end": 202.034,
    "duration": 7.114
  }
]