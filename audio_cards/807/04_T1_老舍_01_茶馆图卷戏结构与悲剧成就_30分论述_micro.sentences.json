[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "老舍·茶馆图卷戏结构与悲剧成就",
    "start": 0.194,
    "end": 3.206,
    "duration": 3.012
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "“五维并举”精准还原茶馆全局（也是本篇5卡真实骨架）：1.结构破锁闭立“图卷戏”→2.人物立“三位一体主角是时代”→3.象征推至“三老汉撒纸钱”含泪微笑→4.台词归“一句顶十句”京味口语→5.思想判“三个好人全幻想破灭、旧时代必亡”。",
    "start": 3.779,
    "end": 29.591,
    "duration": 25.812
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "老舍三幕话剧《茶馆》借裕泰茶馆半世纪沉浮，截取戊戌失败、军阀混战与国民党崩溃前夕三断面，",
    "start": 30.119,
    "end": 38.538,
    "duration": 8.419
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "以独创“图卷戏”宣告旧时代灭亡必然。",
    "start": 38.553,
    "end": 41.92,
    "duration": 3.367
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 独创“图卷戏”三幕、破西方锁闭成规",
    "start": 42.437,
    "end": 46.929,
    "duration": 4.492
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "打破单一贯穿主角与严密因果锁闭，借鉴《清明上河图》散点透视，以裕泰茶馆为枢纽连缀数十生活截面；",
    "start": 47.457,
    "end": 57.469,
    "duration": 10.012
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "看似形散，实被社会步步溃烂的沉痛暗线牢牢统摄，达“形散而神聚”。",
    "start": 57.905,
    "end": 65.997,
    "duration": 8.092
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 群像谱系：“没有主角的主角是时代”",
    "start": 66.683,
    "end": 70.135,
    "duration": 3.452
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "王利发精明本分委曲求全，终因茶馆被霸占自缢后房；硬汉常四爷冻饿难买棺材；",
    "start": 70.663,
    "end": 79.075,
    "duration": 8.412
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "“实业救国”秦仲义办厂被没收拆毁；",
    "start": 79.383,
    "end": 82.195,
    "duration": 2.812
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "三阶层好人共遭灭顶之灾，证真正被押上审判台的是吃人旧制度。",
    "start": 82.598,
    "end": 88.93,
    "duration": 6.332
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 悲喜交融幽默格调与“三老汉撒纸钱”",
    "start": 89.552,
    "end": 93.564,
    "duration": 4.012
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "推高英式幽默与民族悲剧心理融汇之“含泪微笑”，以喜剧形式反衬生存荒谬；",
    "start": 94.09,
    "end": 102.262,
    "duration": 8.172
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "三白发老人狂笑作揖、漫天抛撒捡来冥纸，既是活着为自己凄凉出殡，更是为三个黑暗旧时代举行盛大辛辣葬礼。",
    "start": 102.79,
    "end": 113.442,
    "duration": 10.652
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 纯正洗练京味语言、树白话话剧典范",
    "start": 114.067,
    "end": 118.479,
    "duration": 4.412
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "扫除欧化翻译腔与概念说教，提炼地道北京市民口语为富有潜台词之舞台语，“一句顶十句”；",
    "start": 118.946,
    "end": 127.038,
    "duration": 8.092
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "唐铁嘴无耻俏皮、宋恩子吴祥子阴阳怪气、常四爷刚正硬朗，调侃成底层精神护甲。",
    "start": 127.566,
    "end": 135.338,
    "duration": 7.772
  },
  {
    "id": "sec4_title_c0",
    "dom_key": "sec4_title_c0",
    "text": "05 · 深沉历史哲学反思、昭示旧制度必亡",
    "start": 136.029,
    "end": 140.361,
    "duration": 4.332
  },
  {
    "id": "sec4_step0_c0",
    "dom_key": "sec4_step0_c0",
    "text": "未正面写枪林弹雨，借小茶馆盛衰证明：王利发改良自保、常四爷道德自救、秦仲义实业救国在旧体制下全属幻想；",
    "start": 140.889,
    "end": 153.461,
    "duration": 12.572
  },
  {
    "id": "sec4_step1_c0",
    "dom_key": "sec4_step1_c0",
    "text": "为旧时代判处死刑，昭示唯有根本社会变革方为人民生路。",
    "start": 153.917,
    "end": 159.369,
    "duration": 5.452
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《茶馆》在结构创新、群像度量、象征意象、语言造诣与历史反思五维均达极高水准，为现当代戏剧史传世经典。",
    "start": 159.954,
    "end": 170.286,
    "duration": 10.332
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：《茶馆》是5个分论点（共7块卡片）：①图卷结构 ②三位一体主角是时代 ③撒纸钱幽默华彩 ④京味语言 ⑤历史必亡反思；",
    "start": 170.85,
    "end": 185.552,
    "duration": 14.702
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "三个断面：戊戌失败/军阀混战/抗战后。",
    "start": 185.86,
    "end": 189.472,
    "duration": 3.612
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背出老舍《茶馆》跨越哪三个精确历史断面与五个核心分论点顺序？",
    "start": 190.132,
    "end": 196.384,
    "duration": 6.252
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释“图卷戏”“没有主角的主角是时代”“三位一体悲剧”三组核心术语？",
    "start": 196.912,
    "end": 203.884,
    "duration": 6.972
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 复述第三幕“三老汉撒纸钱”的双重象征意义与京味语言代表口吻？",
    "start": 204.329,
    "end": 210.901,
    "duration": 6.572
  }
]