[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "“五维并举”精准还原茶馆全局（也是本篇5卡真实骨架）：",
    "start": 0.0,
    "end": 5.24,
    "duration": 5.24
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "1.结构破锁闭立“图卷戏”→2.人物立“三位一体主角是时代”→3.象征推至“三老汉撒纸钱”含泪微笑→4.台词归“一句顶十句”京味口语→5.思想判“三个好人全幻想破灭、旧时代必亡”。",
    "start": 5.289,
    "end": 21.498,
    "duration": 16.209
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "老舍三幕话剧《茶馆》借裕泰茶馆半世纪沉浮，",
    "start": 21.959,
    "end": 25.759,
    "duration": 3.8
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "截取戊戌失败、军阀混战与国民党崩溃前夕三断面，",
    "start": 26.209,
    "end": 30.609,
    "duration": 4.4
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "以独创“图卷戏”宣告旧时代灭亡必然。",
    "start": 31.059,
    "end": 34.219,
    "duration": 3.16
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 独创“图卷戏”三幕、破西方锁闭成规",
    "start": 34.669,
    "end": 38.629,
    "duration": 3.96
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "打破单一贯穿主角与严密因果锁闭，借鉴《清明上河图》散点透视，",
    "start": 39.079,
    "end": 44.039,
    "duration": 4.96
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "以裕泰茶馆为枢纽连缀数十生活截面；",
    "start": 44.489,
    "end": 47.649,
    "duration": 3.16
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "看似形散，实被社会步步溃烂的沉痛暗线牢牢统摄，达“形散而神聚”。",
    "start": 48.099,
    "end": 53.819,
    "duration": 5.72
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 群像谱系：“没有主角的主角是时代”",
    "start": 54.389,
    "end": 58.309,
    "duration": 3.92
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "王利发精明本分委曲求全，终因茶馆被霸占自缢后房；",
    "start": 58.839,
    "end": 63.279,
    "duration": 4.44
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "硬汉常四爷冻饿难买棺材；",
    "start": 63.729,
    "end": 66.009,
    "duration": 2.28
  },
  {
    "id": "sec1_step0_c2",
    "dom_key": "sec1_step0_c2",
    "text": "“实业救国”秦仲义办厂被没收拆毁；",
    "start": 66.459,
    "end": 69.539,
    "duration": 3.08
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "三阶层好人共遭灭顶之灾，证真正被押上审判台的是吃人旧制度。",
    "start": 69.989,
    "end": 75.509,
    "duration": 5.52
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 悲喜交融幽默格调与“三老汉撒纸钱”",
    "start": 75.959,
    "end": 79.919,
    "duration": 3.96
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "推高英式幽默与民族悲剧心理融汇之“含泪微笑”，",
    "start": 80.369,
    "end": 84.369,
    "duration": 4.0
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "以喜剧形式反衬生存荒谬；",
    "start": 84.819,
    "end": 87.099,
    "duration": 2.28
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "三白发老人狂笑作揖、漫天抛撒捡来冥纸，既是活着为自己凄凉出殡，",
    "start": 87.549,
    "end": 93.309,
    "duration": 5.76
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "更是为三个黑暗旧时代举行盛大辛辣葬礼。",
    "start": 93.759,
    "end": 96.959,
    "duration": 3.2
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 纯正洗练京味语言、树白话话剧典范",
    "start": 97.489,
    "end": 101.729,
    "duration": 4.24
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "扫除欧化翻译腔与概念说教，提炼地道北京市民口语为富有潜台词之舞台语，",
    "start": 102.179,
    "end": 108.699,
    "duration": 6.52
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "“一句顶十句”；",
    "start": 109.149,
    "end": 110.389,
    "duration": 1.24
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "唐铁嘴无耻俏皮、宋恩子吴祥子阴阳怪气、常四爷刚正硬朗，",
    "start": 110.839,
    "end": 116.119,
    "duration": 5.28
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "调侃成底层精神护甲。",
    "start": 116.569,
    "end": 118.529,
    "duration": 1.96
  },
  {
    "id": "sec4_title_c0",
    "dom_key": "sec4_title_c0",
    "text": "05 · 深沉历史哲学反思、昭示旧制度必亡",
    "start": 118.979,
    "end": 123.099,
    "duration": 4.12
  },
  {
    "id": "sec4_step0_c0",
    "dom_key": "sec4_step0_c0",
    "text": "未正面写枪林弹雨，借小茶馆盛衰证明：",
    "start": 123.629,
    "end": 127.109,
    "duration": 3.48
  },
  {
    "id": "sec4_step0_c1",
    "dom_key": "sec4_step0_c1",
    "text": "王利发改良自保、常四爷道德自救、秦仲义实业救国在旧体制下全属幻想；",
    "start": 127.639,
    "end": 133.519,
    "duration": 5.88
  },
  {
    "id": "sec4_step1_c0",
    "dom_key": "sec4_step1_c0",
    "text": "为旧时代判处死刑，昭示唯有根本社会变革方为人民生路。",
    "start": 134.049,
    "end": 138.929,
    "duration": 4.88
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《茶馆》在结构创新、群像度量、象征意象、语言造诣与历史反思五维均达极高水准，",
    "start": 139.379,
    "end": 145.859,
    "duration": 6.48
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "为现当代戏剧史传世经典。",
    "start": 146.309,
    "end": 148.709,
    "duration": 2.4
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：《茶馆》是5个分论点（共7块卡片）：",
    "start": 149.159,
    "end": 152.839,
    "duration": 3.68
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "①图卷结构 ②三位一体主角是时代 ③撒纸钱幽默华彩 ④京味语言 ⑤历史必亡反思；",
    "start": 153.289,
    "end": 163.089,
    "duration": 9.8
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "三个断面：戊戌失败/军阀混战/抗战后。",
    "start": 163.619,
    "end": 166.979,
    "duration": 3.36
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背出老舍《茶馆》跨越哪三个精确历史断面与五个核心分论点顺序？",
    "start": 167.429,
    "end": 173.869,
    "duration": 6.44
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释“图卷戏”“没有主角的主角是时代”“三位一体悲剧”三组核心术语？",
    "start": 174.399,
    "end": 181.039,
    "duration": 6.64
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 复述第三幕“三老汉撒纸钱”的双重象征意义与京味语言代表口吻？",
    "start": 181.489,
    "end": 187.689,
    "duration": 6.2
  }
]