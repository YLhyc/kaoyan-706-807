[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "老舍·茶馆图卷戏结构与悲剧成就",
    "start": 0.134,
    "end": 3.271,
    "duration": 3.137
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "“五维并举”精准还原茶馆全局（也是本篇5卡真实骨架）：1.结构破锁闭立“图卷戏”→2.人物立“三位一体主角是时代”→3.象征推至“三老汉撒纸钱”含泪微笑→4.台词归“一句顶十句”京味口语→5.思想判“三个好人全幻想破灭、旧时代必亡”。",
    "start": 3.86,
    "end": 27.162,
    "duration": 23.302
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "老舍三幕话剧《茶馆》借裕泰茶馆半世纪沉浮，截取戊戌失败、军阀混战与国民党崩溃前夕三断面，",
    "start": 27.736,
    "end": 36.394,
    "duration": 8.658
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "以独创“图卷戏”宣告旧时代灭亡必然。",
    "start": 36.655,
    "end": 39.962,
    "duration": 3.306
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 独创“图卷戏”三幕、破西方锁闭成规",
    "start": 40.549,
    "end": 44.402,
    "duration": 3.853
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "打破单一贯穿主角与严密因果锁闭，借鉴《清明上河图》散点透视，以裕泰茶馆为枢纽连缀数十生活截面；",
    "start": 44.989,
    "end": 55.248,
    "duration": 10.259
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "看似形散，实被社会步步溃烂的沉痛暗线牢牢统摄，达“形散而神聚”。",
    "start": 55.835,
    "end": 63.009,
    "duration": 7.173
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 群像谱系：“没有主角的主角是时代”",
    "start": 63.569,
    "end": 67.188,
    "duration": 3.619
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "王利发精明本分委曲求全，终因茶馆被霸占自缢后房；硬汉常四爷冻饿难买棺材；",
    "start": 67.775,
    "end": 76.029,
    "duration": 8.254
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "“实业救国”秦仲义办厂被没收拆毁；",
    "start": 76.33,
    "end": 79.363,
    "duration": 3.033
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "三阶层好人共遭灭顶之灾，证真正被押上审判台的是吃人旧制度。",
    "start": 79.937,
    "end": 86.511,
    "duration": 6.575
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 悲喜交融幽默格调与“三老汉撒纸钱”",
    "start": 87.072,
    "end": 91.107,
    "duration": 4.035
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "推高英式幽默与民族悲剧心理融汇之“含泪微笑”，以喜剧形式反衬生存荒谬；",
    "start": 91.681,
    "end": 99.792,
    "duration": 8.111
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "三白发老人狂笑作揖、漫天抛撒捡来冥纸，既是活着为自己凄凉出殡，更是为三个黑暗旧时代举行盛大辛辣葬礼。",
    "start": 100.379,
    "end": 111.068,
    "duration": 10.689
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 纯正洗练京味语言、树白话话剧典范",
    "start": 111.655,
    "end": 116.029,
    "duration": 4.374
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "扫除欧化翻译腔与概念说教，提炼地道北京市民口语为富有潜台词之舞台语，“一句顶十句”；",
    "start": 116.616,
    "end": 125.574,
    "duration": 8.957
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "唐铁嘴无耻俏皮、宋恩子吴祥子阴阳怪气、常四爷刚正硬朗，调侃成底层精神护甲。",
    "start": 126.135,
    "end": 134.949,
    "duration": 8.814
  },
  {
    "id": "sec4_title_c0",
    "dom_key": "sec4_title_c0",
    "text": "05 · 深沉历史哲学反思、昭示旧制度必亡",
    "start": 135.536,
    "end": 139.701,
    "duration": 4.166
  },
  {
    "id": "sec4_step0_c0",
    "dom_key": "sec4_step0_c0",
    "text": "未正面写枪林弹雨，借小茶馆盛衰证明：王利发改良自保、常四爷道德自救、秦仲义实业救国在旧体制下全属幻想；",
    "start": 140.262,
    "end": 151.693,
    "duration": 11.431
  },
  {
    "id": "sec4_step1_c0",
    "dom_key": "sec4_step1_c0",
    "text": "为旧时代判处死刑，昭示唯有根本社会变革方为人民生路。",
    "start": 152.267,
    "end": 158.581,
    "duration": 6.314
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《茶馆》在结构创新、群像度量、象征意象、语言造诣与历史反思五维均达极高水准，为现当代戏剧史传世经典。",
    "start": 159.168,
    "end": 169.857,
    "duration": 10.689
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：《茶馆》是5个分论点（共7块卡片）：①图卷结构 ②三位一体主角是时代 ③撒纸钱幽默华彩 ④京味语言 ⑤历史必亡反思；",
    "start": 170.444,
    "end": 184.597,
    "duration": 14.153
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "三个断面：戊戌失败/军阀混战/抗战后。",
    "start": 184.858,
    "end": 188.33,
    "duration": 3.471
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背出老舍《茶馆》跨越哪三个精确历史断面与五个核心分论点顺序？",
    "start": 188.904,
    "end": 195.895,
    "duration": 6.991
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释“图卷戏”“没有主角的主角是时代”“三位一体悲剧”三组核心术语？",
    "start": 196.469,
    "end": 203.812,
    "duration": 7.343
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 复述第三幕“三老汉撒纸钱”的双重象征意义与京味语言代表口吻？",
    "start": 204.386,
    "end": 211.481,
    "duration": 7.095
  }
]