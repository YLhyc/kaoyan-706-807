[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 3.2,
    "duration": 3.12
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 3.2,
    "end": 6.0,
    "duration": 2.8
  },
  {
    "id": 3,
    "text": "这道题考查当代文学史上的世俗化转型流派，",
    "start": 6.0,
    "end": 9.6,
    "duration": 3.6
  },
  {
    "id": 4,
    "text": "新写实小说。",
    "start": 9.6,
    "end": 10.8,
    "duration": 1.2
  },
  {
    "id": 5,
    "text": "在考场上，考生不能简单只说“写老百姓过日子”，",
    "start": 10.8,
    "end": 14.56,
    "duration": 3.76
  },
  {
    "id": 6,
    "text": "而必须紧扣“原生态呈现日常困境”与“消解宏大叙事的零度介入”两大理论核心。",
    "start": 14.56,
    "end": 20.96,
    "duration": 6.4
  },
  {
    "id": 7,
    "text": "核心在于回答：新写实如何终结了八十年代的宏大理想主义，",
    "start": 21.2,
    "end": 26.16,
    "duration": 4.96
  },
  {
    "id": 8,
    "text": "以及池莉刘震云如何展现生活的粗力。",
    "start": 26.16,
    "end": 29.6,
    "duration": 3.44
  },
  {
    "id": 9,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 29.6,
    "end": 32.56,
    "duration": 2.96
  },
  {
    "id": 10,
    "text": "答题必须确立“思潮定性、趋近于、",
    "start": 32.56,
    "end": 35.68,
    "duration": 3.12
  },
  {
    "id": 11,
    "text": "题材与生存体验（原生态）趋近于、",
    "start": 35.68,
    "end": 38.96,
    "duration": 3.28
  },
  {
    "id": 12,
    "text": "叙事姿态与手法（零度介入）趋近于、",
    "start": 38.96,
    "end": 42.4,
    "duration": 3.44
  },
  {
    "id": 13,
    "text": "历史转折总结”的流线。",
    "start": 42.4,
    "end": 43.92,
    "duration": 1.52
  },
  {
    "id": 14,
    "text": "前半部分结合《烦恼人生》与《一地鸡毛》展开日常琐屑对理想的消磨，",
    "start": 44.24,
    "end": 49.84,
    "duration": 5.6
  },
  {
    "id": 15,
    "text": "后半部分剖析叙述者放弃道德审判的客观纪实笔法。",
    "start": 49.84,
    "end": 54.32,
    "duration": 4.48
  },
  {
    "id": 16,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 54.32,
    "end": 57.6,
    "duration": 3.28
  },
  {
    "id": 17,
    "text": "全题分为四个核心论述维度：第一维度：界定新写实小说作为当代文学从理想主义转向日常本体的文学史坐标；",
    "start": 57.6,
    "end": 66.56,
    "duration": 8.96
  },
  {
    "id": 18,
    "text": "-第二维度：深入剖析“原生态”呈现凡俗人生、",
    "start": 66.8,
    "end": 70.653,
    "duration": 3.853
  },
  {
    "id": 19,
    "text": "揭露日常琐屑对理想消磨的生存困境（以印家厚、",
    "start": 70.653,
    "end": 75.187,
    "duration": 4.534
  },
  {
    "id": 20,
    "text": "小林为例）；",
    "start": 75.187,
    "end": 76.093,
    "duration": 0.906
  },
  {
    "id": 21,
    "text": "-第三维度：精细剖析消解宏大叙事、",
    "start": 76.093,
    "end": 79.267,
    "duration": 3.174
  },
  {
    "id": 22,
    "text": "放弃启蒙导师姿态与“零度情感介入”的叙事机制；",
    "start": 79.267,
    "end": 83.8,
    "duration": 4.533
  },
  {
    "id": 23,
    "text": "-第四维度：宏观总结作品促使当代文学落地凡俗人间的转折定论。",
    "start": 83.8,
    "end": 89.92,
    "duration": 6.12
  },
  {
    "id": 24,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 90.08,
    "end": 94.32,
    "duration": 4.24
  },
  {
    "id": 25,
    "text": "全题逻辑严密咬合：第一步先确立思潮的转折地位。",
    "start": 94.32,
    "end": 99.2,
    "duration": 4.88
  },
  {
    "id": 26,
    "text": "第二步剖析新写实小说的内容核心，",
    "start": 99.2,
    "end": 102.0,
    "duration": 2.8
  },
  {
    "id": 27,
    "text": "即柴米油盐与凡俗重负。",
    "start": 102.0,
    "end": 104.72,
    "duration": 2.72
  },
  {
    "id": 28,
    "text": "第三步剖析传达这一内容的叙述姿态，",
    "start": 104.72,
    "end": 107.84,
    "duration": 3.12
  },
  {
    "id": 29,
    "text": "即冷漠客观的零度介入。",
    "start": 107.84,
    "end": 110.32,
    "duration": 2.48
  },
  {
    "id": 30,
    "text": "第四步完成宏观历史论证闭环。",
    "start": 110.32,
    "end": 113.04,
    "duration": 2.72
  },
  {
    "id": 31,
    "text": "二、各板块逐句咬合演练。",
    "start": 113.44,
    "end": 116.0,
    "duration": 2.56
  },
  {
    "id": 32,
    "text": "一、开头破题段内部咬合。",
    "start": 116.0,
    "end": 118.48,
    "duration": 2.48
  },
  {
    "id": 33,
    "text": "本段旨在开门见山确立日常生活本体转型的立论基石。",
    "start": 118.48,
    "end": 123.04,
    "duration": 4.56
  },
  {
    "id": 34,
    "text": "首句直切经典地位，次句交代代表作家群与平民化世俗新品格。",
    "start": 123.04,
    "end": 128.64,
    "duration": 5.6
  },
  {
    "id": 35,
    "text": "首先，首句必须直接亮出该思潮在当代文学史上的转折地位，",
    "start": 129.016,
    "end": 133.976,
    "duration": 4.96
  },
  {
    "id": 36,
    "text": "具体表述到答题语句就是：二十世纪八十年代末至九十年代初兴起的“新写实小说”，",
    "start": 133.976,
    "end": 140.056,
    "duration": 6.08
  },
  {
    "id": 37,
    "text": "是中国当代文学从理想主义启蒙狂热走向日常生活本体的重大审美转型思潮。",
    "start": 140.056,
    "end": 146.296,
    "duration": 6.24
  },
  {
    "id": 38,
    "text": "有了经典定性之后，次句必须迅速说明其打破旧模式、",
    "start": 146.296,
    "end": 150.616,
    "duration": 4.32
  },
  {
    "id": 39,
    "text": "树立世俗品格的贡献，具体表述到答题语句就是：以池莉、",
    "start": 150.616,
    "end": 154.776,
    "duration": 4.16
  },
  {
    "id": 40,
    "text": "刘震云、方方等为代表的作家群，打破了传统现实主义的典型化模式与先锋文学的形式迷宫，",
    "start": 154.776,
    "end": 161.656,
    "duration": 6.88
  },
  {
    "id": 41,
    "text": "以冷峻客观的姿态直面普通人的生存困境，",
    "start": 161.656,
    "end": 164.776,
    "duration": 3.12
  },
  {
    "id": 42,
    "text": "确立了平民化世俗叙事的新品格。，",
    "start": 164.776,
    "end": 167.416,
    "duration": 2.64
  },
  {
    "id": 43,
    "text": "这句话直接铺陈出题材与叙事两翼齐飞的论述骨架。",
    "start": 167.416,
    "end": 171.176,
    "duration": 3.76
  },
  {
    "id": 44,
    "text": "二十世纪八十年代末至九十年代初兴起的“新写实小说”，",
    "start": 171.576,
    "end": 176.376,
    "duration": 4.8
  },
  {
    "id": 45,
    "text": "是中国当代文学从理想主义启蒙狂热走向日常生活本体的重大审美转型思潮。",
    "start": 176.376,
    "end": 183.336,
    "duration": 6.96
  },
  {
    "id": 46,
    "text": "以池莉、刘震云、方方等为代表的作家群，",
    "start": 183.336,
    "end": 187.016,
    "duration": 3.68
  },
  {
    "id": 47,
    "text": "打破了传统现实主义的典型化模式与先锋文学的形式迷宫，",
    "start": 187.016,
    "end": 192.056,
    "duration": 5.04
  },
  {
    "id": 48,
    "text": "以冷峻客观的姿态直面普通人的生存困境，",
    "start": 192.056,
    "end": 195.736,
    "duration": 3.68
  },
  {
    "id": 49,
    "text": "确立了平民化世俗叙事的新品格。",
    "start": 195.736,
    "end": 198.296,
    "duration": 2.56
  },
  {
    "id": 50,
    "text": "二、第二板块：原生态呈现凡俗生存困境内部咬合。",
    "start": 198.616,
    "end": 203.576,
    "duration": 4.96
  },
  {
    "id": 51,
    "text": "本段任务是深入解剖原生态日常困境，",
    "start": 203.576,
    "end": 206.936,
    "duration": 3.36
  },
  {
    "id": 52,
    "text": "密集调取《烦恼人生》印家厚与《一地鸡毛》小林的经典细节。",
    "start": 206.936,
    "end": 211.976,
    "duration": 5.04
  },
  {
    "id": 53,
    "text": "首先，段首给出统领分论点，具体表述到答题语句就是：首先，",
    "start": 211.976,
    "end": 216.776,
    "duration": 4.8
  },
  {
    "id": 54,
    "text": "在题材与审美追求上，新写实小说执着于“原生态”呈现凡俗人生的生存困境，",
    "start": 216.776,
    "end": 223.336,
    "duration": 6.56
  },
  {
    "id": 55,
    "text": "将目光彻底投向琐碎粗力的日常生活。",
    "start": 223.336,
    "end": 226.376,
    "duration": 3.04
  },
  {
    "id": 56,
    "text": "-随后，剖析摒弃英雄拔高、聚焦普通平民真实挣扎的机制，",
    "start": 226.536,
    "end": 231.097,
    "duration": 4.561
  },
  {
    "id": 57,
    "text": "具体表述到答题语句就是：作家们坚决摒弃了传统文学对英雄崇高与宏大历史进程的虚妄拔高，",
    "start": 231.097,
    "end": 239.029,
    "duration": 7.932
  },
  {
    "id": 58,
    "text": "转而聚焦于普通平民在柴米油盐、人情世故与单位体制重压下的真实挣扎。",
    "start": 239.029,
    "end": 245.176,
    "duration": 6.147
  },
  {
    "id": 59,
    "text": "-紧接着，调取池莉《烦恼人生》印家厚挤轮渡换煤气的经典细节：池莉的《烦恼人生》细致入微地记录了武汉工人印家厚从清晨赶渡轮、",
    "start": 245.176,
    "end": 256.974,
    "duration": 11.798
  },
  {
    "id": 60,
    "text": "挤公共汽车、换煤气罐直至夜晚归家的整整一天，",
    "start": 256.974,
    "end": 261.426,
    "duration": 4.452
  },
  {
    "id": 61,
    "text": "逼真展现出日常生存如流水般的琐屑与沉重。",
    "start": 261.426,
    "end": 265.656,
    "duration": 4.23
  },
  {
    "id": 62,
    "text": "-最后，调取刘震云《一地鸡毛》小林买艘豆腐与调动工作的细节，",
    "start": 265.704,
    "end": 271.075,
    "duration": 5.371
  },
  {
    "id": 63,
    "text": "提炼对理想的消磨：刘震云的《一地鸡毛》则通过机关小职员小林为一块变艘的豆腐、",
    "start": 271.075,
    "end": 278.381,
    "duration": 7.306
  },
  {
    "id": 64,
    "text": "为老婆调动工作与争夺蜂窝煤等琐事展开叙事，",
    "start": 278.381,
    "end": 282.678,
    "duration": 4.297
  },
  {
    "id": 65,
    "text": "深刻揭示了琐碎庸常的世俗生活对个体青春理想的无情消磨。",
    "start": 282.678,
    "end": 288.264,
    "duration": 5.586
  },
  {
    "id": 66,
    "text": "首先，在题材与审美追求上，新写实小说执着于“原生态”呈现凡俗人生的生存困境，",
    "start": 288.424,
    "end": 295.144,
    "duration": 6.72
  },
  {
    "id": 67,
    "text": "将目光彻底投向琐碎粗力的日常生活。",
    "start": 295.144,
    "end": 298.264,
    "duration": 3.12
  },
  {
    "id": 68,
    "text": "作家们坚决摒弃了传统文学对英雄崇高与宏大历史进程的虚妄拔高，",
    "start": 298.264,
    "end": 303.624,
    "duration": 5.36
  },
  {
    "id": 69,
    "text": "转而聚焦于普通平民在柴米油盐、人情世故与单位体制重压下的真实挣扎。",
    "start": 303.624,
    "end": 309.704,
    "duration": 6.08
  },
  {
    "id": 70,
    "text": "池莉的《烦恼人生》细致入微地记录了武汉工人印家厚从清晨赶渡轮、",
    "start": 310.024,
    "end": 315.864,
    "duration": 5.84
  },
  {
    "id": 71,
    "text": "挤公共汽车、换煤气罐直至夜晚归家的整整一天，",
    "start": 315.864,
    "end": 320.184,
    "duration": 4.32
  },
  {
    "id": 72,
    "text": "逼真展现出日常生存如流水般的琐屑与沉重。",
    "start": 320.184,
    "end": 324.504,
    "duration": 4.32
  },
  {
    "id": 73,
    "text": "刘震云的《一地鸡毛》则通过机关小职员小林为一块变艘的豆腐、",
    "start": 324.504,
    "end": 329.624,
    "duration": 5.12
  },
  {
    "id": 74,
    "text": "为老婆调动工作与争夺蜂窝煤等琐事展开叙事，",
    "start": 329.624,
    "end": 333.864,
    "duration": 4.24
  },
  {
    "id": 75,
    "text": "深刻揭示了琐碎庸常的世俗生活对个体青春理想的无情消磨。",
    "start": 333.864,
    "end": 339.064,
    "duration": 5.2
  },
  {
    "id": 76,
    "text": "三、第三板块：消解宏大叙事与“零度介入”内部咬合。",
    "start": 339.464,
    "end": 344.104,
    "duration": 4.64
  },
  {
    "id": 77,
    "text": "本段任务是直击本题核心，深入剖析叙述者放弃道德法官姿态、",
    "start": 344.104,
    "end": 349.224,
    "duration": 5.12
  },
  {
    "id": 78,
    "text": "采用零度情感介入与生活流技法。",
    "start": 349.224,
    "end": 352.104,
    "duration": 2.88
  },
  {
    "id": 79,
    "text": "首先，段首给出统领分论点，具体表述到答题语句就是：其次，",
    "start": 352.104,
    "end": 357.624,
    "duration": 5.52
  },
  {
    "id": 80,
    "text": "在叙事姿态与文体形态上，新写实小说坚决消解宏大意识形态话语，",
    "start": 357.624,
    "end": 363.224,
    "duration": 5.6
  },
  {
    "id": 81,
    "text": "倡导“还原生活本来面目”与“零度情感介入”的纪实笔法。",
    "start": 363.224,
    "end": 367.624,
    "duration": 4.4
  },
  {
    "id": 82,
    "text": "-随后，剖析叙述者放弃启蒙导师与道德法官姿态的特征，",
    "start": 367.784,
    "end": 372.384,
    "duration": 4.6
  },
  {
    "id": 83,
    "text": "具体表述到答题语句就是：叙述者彻底放弃了启蒙导师与道德法官的居高临下姿态，",
    "start": 372.384,
    "end": 379.384,
    "duration": 7.0
  },
  {
    "id": 84,
    "text": "既不作义愤填膺的道德审判，也不作廉价虚妄的温情抚慰，",
    "start": 379.384,
    "end": 384.184,
    "duration": 4.8
  },
  {
    "id": 85,
    "text": "而是以近乎冷漠平静、不偏不倚的“零度叙事”客观陈述生活本相。",
    "start": 384.184,
    "end": 389.384,
    "duration": 5.2
  },
  {
    "id": 86,
    "text": "-最后，总结生活流与自然主义白描复原沉重质感的形式美学：小说普遍采用生活流与自然主义白描技法，",
    "start": 389.384,
    "end": 398.039,
    "duration": 8.655
  },
  {
    "id": 87,
    "text": "不刻意追求大起大落的戏剧化情节悬念，",
    "start": 398.039,
    "end": 401.461,
    "duration": 3.422
  },
  {
    "id": 88,
    "text": "而是以平实寡淡的叙事节律，真实复原生命在平庸岁月中缓缓流淌的沉重质感。",
    "start": 401.461,
    "end": 408.104,
    "duration": 6.643
  },
  {
    "id": 89,
    "text": "其次，在叙事姿态与文体形态上，新写实小说坚决消解宏大意识形态话语，",
    "start": 408.248,
    "end": 415.208,
    "duration": 6.96
  },
  {
    "id": 90,
    "text": "倡导“还原生活本来面目”与“零度情感介入”的纪实笔法。",
    "start": 415.208,
    "end": 420.088,
    "duration": 4.88
  },
  {
    "id": 91,
    "text": "叙述者彻底放弃了启蒙导师与道德法官的居高临下姿态，",
    "start": 420.088,
    "end": 424.888,
    "duration": 4.8
  },
  {
    "id": 92,
    "text": "既不作义愤填膺的道德审判，也不作廉价虚妄的温情抚慰，",
    "start": 424.888,
    "end": 429.608,
    "duration": 4.72
  },
  {
    "id": 93,
    "text": "而是以近乎冷漠平静、不偏不倚的“零度叙事”客观陈述生活本相。",
    "start": 429.608,
    "end": 434.808,
    "duration": 5.2
  },
  {
    "id": 94,
    "text": "小说普遍采用生活流与自然主义白描技法，",
    "start": 435.128,
    "end": 438.968,
    "duration": 3.84
  },
  {
    "id": 95,
    "text": "不刻意追求大起大落的戏剧化情节悬念，",
    "start": 438.968,
    "end": 442.328,
    "duration": 3.36
  },
  {
    "id": 96,
    "text": "而是以平实寡淡的叙事节律，真实复原生命在平庸岁月中缓缓流淌的沉重质感。",
    "start": 442.328,
    "end": 449.848,
    "duration": 7.52
  },
  {
    "id": 97,
    "text": "四、结尾收束升华段内部咬合。",
    "start": 449.848,
    "end": 453.048,
    "duration": 3.2
  },
  {
    "id": 98,
    "text": "本段承担全篇论证成果的系统提炼与历史定位，",
    "start": 453.048,
    "end": 457.368,
    "duration": 4.32
  },
  {
    "id": 99,
    "text": "收束在文学史转折意义上。",
    "start": 457.368,
    "end": 459.288,
    "duration": 1.92
  },
  {
    "id": 100,
    "text": "-首先，全面回收击碎浪漫神话与客观原生态的革新成果，",
    "start": 459.528,
    "end": 464.469,
    "duration": 4.941
  },
  {
    "id": 101,
    "text": "具体表述到答题语句就是：综上所述，",
    "start": 464.469,
    "end": 467.692,
    "duration": 3.223
  },
  {
    "id": 102,
    "text": "“新写实小说”思潮以对凡俗人生的冷峻凝视击碎了盲目的浪漫神话，",
    "start": 467.692,
    "end": 473.707,
    "duration": 6.015
  },
  {
    "id": 103,
    "text": "以客观原生态的叙事革新拓展了中国写实文学的疆界。",
    "start": 473.707,
    "end": 478.648,
    "duration": 4.941
  },
  {
    "id": 104,
    "text": "-紧接着，总结对当代文学从宏大启蒙真正落地凡俗人间的转折定论，",
    "start": 478.648,
    "end": 484.462,
    "duration": 5.814
  },
  {
    "id": 105,
    "text": "具体表述到答题语句就是：它促使当代文学从形而上的宏大启蒙真正落地于凡俗人间，",
    "start": 484.462,
    "end": 491.937,
    "duration": 7.475
  },
  {
    "id": 106,
    "text": "具有深远的文学史转折意义。",
    "start": 491.937,
    "end": 494.428,
    "duration": 2.491
  },
  {
    "id": 107,
    "text": "综上所述，“新写实小说”思潮以对凡俗人生的冷峻凝视击碎了盲目的浪漫神话，",
    "start": 494.428,
    "end": 501.072,
    "duration": 6.644
  },
  {
    "id": 108,
    "text": "以客观原生态的叙事革新拓展了中国写实文学的疆界。",
    "start": 501.072,
    "end": 505.848,
    "duration": 4.776
  },
  {
    "id": 109,
    "text": "它促使当代文学从形而上的宏大启蒙真正落地于凡俗人间，",
    "start": 505.928,
    "end": 511.368,
    "duration": 5.44
  },
  {
    "id": 110,
    "text": "具有深远的文学史转折意义。",
    "start": 511.368,
    "end": 513.608,
    "duration": 2.24
  }
]