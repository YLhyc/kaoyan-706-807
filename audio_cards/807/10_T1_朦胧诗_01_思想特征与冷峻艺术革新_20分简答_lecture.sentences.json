[
  {
    "id": 1,
    "text": "新时期之初，以北岛、舒婷、顾城为代表的朦胧诗群，在现代文学史上掀起了一场震撼人心的主体复归与审美革命。",
    "start": 0.111,
    "end": 9.964,
    "duration": 9.853
  },
  {
    "id": 2,
    "text": "诗群告别了长期以来机械政治抒情的图解模式，转向对个体尊严的重新确认与历史反思，",
    "start": 10.464,
    "end": 18.073,
    "duration": 7.609
  },
  {
    "id": 3,
    "text": "其思想特征与艺术革新主要表现在以下三个维度：",
    "start": 18.423,
    "end": 22.463,
    "duration": 4.04
  },
  {
    "id": 4,
    "text": "第一，确立怀疑主义理性精神，重构独立崇高的主体尊严。",
    "start": 23.153,
    "end": 27.9,
    "duration": 4.747
  },
  {
    "id": 5,
    "text": "朦胧诗坚决打破了对权威盲从的迷信思维，将批判目光投向历史沉疴与群体盲从。",
    "start": 28.4,
    "end": 35.493,
    "duration": 7.093
  },
  {
    "id": 6,
    "text": "北岛在《回答》中以冷峻决绝的声调铸就了历史判词，",
    "start": 35.993,
    "end": 40.33,
    "duration": 4.337
  },
  {
    "id": 7,
    "text": "其“告诉你吧，世界 / 我——不——相——信！”的震颤呼喊，",
    "start": 40.68,
    "end": 46.386,
    "duration": 5.706
  },
  {
    "id": 8,
    "text": "以绝不妥协的傲然风骨，将抒情主人公塑造成挺立于冰川与废墟之上的现代思想硬汉；",
    "start": 46.798,
    "end": 54.305,
    "duration": 7.507
  },
  {
    "id": 9,
    "text": "顾城在《一代人》中以两行极具哲学张力的诗句，",
    "start": 54.805,
    "end": 58.672,
    "duration": 3.867
  },
  {
    "id": 10,
    "text": "将经历过浩劫的一代青年对光明的执着探求凝练为集体精神图腾，",
    "start": 59.022,
    "end": 64.344,
    "duration": 5.322
  },
  {
    "id": 11,
    "text": "唤醒了青年一代的主体价值意识。",
    "start": 64.743,
    "end": 66.881,
    "duration": 2.138
  },
  {
    "id": 12,
    "text": "第二，呼唤温润博爱的人道主义情怀，确立平等独立的人格尊严。",
    "start": 67.572,
    "end": 72.437,
    "duration": 4.865
  },
  {
    "id": 13,
    "text": "诗群突破了阶级论对情感世界的长期压抑，在人性的真实领地中重新发现爱与温情。",
    "start": 72.937,
    "end": 79.248,
    "duration": 6.311
  },
  {
    "id": 14,
    "text": "舒婷在《致橡树》中以木棉的形象自喻，断然拒绝作为凌霄花借高枝炫耀，",
    "start": 79.748,
    "end": 85.355,
    "duration": 5.607
  },
  {
    "id": 15,
    "text": "也拒绝作为痴情鸟重复单调歌曲，而是以红硕花朵与挺拔橡树并肩挺立于风雨之中，",
    "start": 85.705,
    "end": 92.696,
    "duration": 6.991
  },
  {
    "id": 16,
    "text": "在现代抒情诗中深刻确立了男女平等独立、灵魂深层呼应的人性理想。",
    "start": 93.046,
    "end": 98.637,
    "duration": 5.591
  },
  {
    "id": 17,
    "text": "第三，打破写实线性抒情陈规，开创以隐喻象征为核心的现代主义诗性语法。",
    "start": 99.31,
    "end": 106.022,
    "duration": 6.712
  },
  {
    "id": 18,
    "text": "朦胧诗借鉴西方现代意象派与象征主义手法，大量运用意象跳跃、情绪通感与多义复调结构，",
    "start": 106.583,
    "end": 114.07,
    "duration": 7.487
  },
  {
    "id": 19,
    "text": "将主观内心情感转化为冷峻奇诡的客观对应物。",
    "start": 114.42,
    "end": 118.313,
    "duration": 3.893
  },
  {
    "id": 20,
    "text": "北岛在《回答》中以“镀金的天空”与“冰川”等并置意象寄寓荒诞现实，",
    "start": 118.813,
    "end": 124.171,
    "duration": 5.358
  },
  {
    "id": 21,
    "text": "打破了传统诗歌单一透明的语义格局，",
    "start": 124.521,
    "end": 127.233,
    "duration": 2.712
  },
  {
    "id": 22,
    "text": "在意象的多重歧义与张力碰撞中极大拓展了新诗的审美空间。",
    "start": 127.583,
    "end": 132.331,
    "duration": 4.748
  }
]
