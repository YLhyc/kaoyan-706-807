[
  {
    "id": 1,
    "text": "新时期之初，以北岛、舒婷、顾城为代表的朦胧诗群，在现代文学史上掀起了一场震撼人心的主体复归与审美革命。",
    "start": 0.111,
    "end": 9.964,
    "duration": 9.853
  },
  {
    "id": 2,
    "text": "诗群告别了长期以来机械政治抒情的图解模式，转向对个体尊严的重新确认与历史反思，",
    "start": 10.334,
    "end": 17.943,
    "duration": 7.609
  },
  {
    "id": 3,
    "text": "其思想特征与艺术革新主要表现在以下三个维度：",
    "start": 18.163,
    "end": 22.203,
    "duration": 4.04
  },
  {
    "id": 4,
    "text": "第一，确立怀疑主义理性精神，重构独立崇高的主体尊严。",
    "start": 22.893,
    "end": 27.663,
    "duration": 4.77
  },
  {
    "id": 5,
    "text": "朦胧诗坚决打破了对权威盲从的迷信思维，将批判目光投向历史沉疴与群体盲从。",
    "start": 27.78,
    "end": 34.888,
    "duration": 7.108
  },
  {
    "id": 6,
    "text": "北岛在《回答》中以冷峻决绝的声调铸就了历史判词，",
    "start": 35.065,
    "end": 39.406,
    "duration": 4.341
  },
  {
    "id": 7,
    "text": "其“告诉你吧，世界 / 我——不——相——信！”的震颤呼喊，",
    "start": 39.491,
    "end": 45.183,
    "duration": 5.692
  },
  {
    "id": 8,
    "text": "以绝不妥协的傲然风骨，将抒情主人公塑造成挺立于冰川与废墟之上的现代思想硬汉；",
    "start": 45.449,
    "end": 53.102,
    "duration": 7.653
  },
  {
    "id": 9,
    "text": "顾城在《一代人》中以两行极具哲学张力的诗句，",
    "start": 53.237,
    "end": 57.232,
    "duration": 3.995
  },
  {
    "id": 10,
    "text": "将经历过浩劫的一代青年对光明的执着探求凝练为集体精神图腾，",
    "start": 57.232,
    "end": 62.688,
    "duration": 5.456
  },
  {
    "id": 11,
    "text": "唤醒了青年一代的主体价值意识。",
    "start": 62.865,
    "end": 65.225,
    "duration": 2.36
  },
  {
    "id": 12,
    "text": "第二，呼唤温润博爱的人道主义情怀，确立平等独立的人格尊严。",
    "start": 65.916,
    "end": 70.781,
    "duration": 4.865
  },
  {
    "id": 13,
    "text": "诗群突破了阶级论对情感世界的长期压抑，在人性的真实领地中重新发现爱与温情。",
    "start": 71.249,
    "end": 77.56,
    "duration": 6.311
  },
  {
    "id": 14,
    "text": "舒婷在《致橡树》中以木棉的形象自喻，断然拒绝作为凌霄花借高枝炫耀，",
    "start": 77.787,
    "end": 83.394,
    "duration": 5.607
  },
  {
    "id": 15,
    "text": "也拒绝作为痴情鸟重复单调歌曲，而是以红硕花朵与挺拔橡树并肩挺立于风雨之中，",
    "start": 83.682,
    "end": 90.673,
    "duration": 6.991
  },
  {
    "id": 16,
    "text": "在现代抒情诗中深刻确立了男女平等独立、灵魂深层呼应的人性理想。",
    "start": 90.835,
    "end": 96.426,
    "duration": 5.591
  },
  {
    "id": 17,
    "text": "第三，打破写实线性抒情陈规，开创以隐喻象征为核心的现代主义诗性语法。",
    "start": 97.099,
    "end": 103.811,
    "duration": 6.712
  },
  {
    "id": 18,
    "text": "朦胧诗借鉴西方现代意象派与象征主义手法，大量运用意象跳跃、情绪通感与多义复调结构，",
    "start": 104.372,
    "end": 111.859,
    "duration": 7.487
  },
  {
    "id": 19,
    "text": "将主观内心情感转化为冷峻奇诡的客观对应物。",
    "start": 112.064,
    "end": 116.037,
    "duration": 3.973
  },
  {
    "id": 20,
    "text": "北岛在《回答》中以“镀金的天空”与“冰川”等并置意象寄寓荒诞现实，",
    "start": 116.231,
    "end": 121.589,
    "duration": 5.358
  },
  {
    "id": 21,
    "text": "打破了传统诗歌单一透明的语义格局，",
    "start": 121.899,
    "end": 124.611,
    "duration": 2.712
  },
  {
    "id": 22,
    "text": "在意象的多重歧义与张力碰撞中极大拓展了新诗的审美空间。",
    "start": 124.893,
    "end": 129.641,
    "duration": 4.748
  }
]