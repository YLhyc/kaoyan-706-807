[
  {
    "id": 1,
    "text": "新时期之初，以北岛、舒婷、顾城为代表的朦胧诗群，",
    "start": 0.05,
    "end": 4.666,
    "duration": 4.616
  },
  {
    "id": 2,
    "text": "在现代文学史上掀起了一场震撼人心的主体复归与审美革命。",
    "start": 4.666,
    "end": 10.329,
    "duration": 5.663
  },
  {
    "id": 3,
    "text": "诗群告别了长期以来机械政治抒情的图解模式，",
    "start": 10.329,
    "end": 14.471,
    "duration": 4.142
  },
  {
    "id": 4,
    "text": "转向对个体尊严的重新确认与历史反思，",
    "start": 14.471,
    "end": 18.158,
    "duration": 3.687
  },
  {
    "id": 5,
    "text": "其思想特征与艺术革新主要表现在以下三个维度：",
    "start": 18.158,
    "end": 22.504,
    "duration": 4.346
  },
  {
    "id": 6,
    "text": "第一，确立怀疑主义理性精神，重构独立崇高的主体尊严。",
    "start": 22.504,
    "end": 27.391,
    "duration": 4.887
  },
  {
    "id": 7,
    "text": "朦胧诗坚决打破了对权威盲从的迷信思维，",
    "start": 27.391,
    "end": 31.026,
    "duration": 3.635
  },
  {
    "id": 8,
    "text": "将批判目光投向历史沉疴与群体盲从。",
    "start": 31.026,
    "end": 34.676,
    "duration": 3.65
  },
  {
    "id": 9,
    "text": "北岛在《回答》中以冷峻决绝的声调铸就了历史判词，",
    "start": 34.676,
    "end": 39.662,
    "duration": 4.986
  },
  {
    "id": 10,
    "text": "其“告诉你吧，世界 / 我——不——相——信！",
    "start": 39.662,
    "end": 42.067,
    "duration": 2.405
  },
  {
    "id": 11,
    "text": "”的震颤呼喊，",
    "start": 42.067,
    "end": 43.256,
    "duration": 1.189
  },
  {
    "id": 12,
    "text": "以纵使面对千百个侵凌者也绝不妥协的傲然风骨，",
    "start": 43.256,
    "end": 47.335,
    "duration": 4.079
  },
  {
    "id": 13,
    "text": "将抒情主人公塑造成挺立于冰川与废墟之上的现代思想硬汉；",
    "start": 47.335,
    "end": 53.648,
    "duration": 6.313
  },
  {
    "id": 14,
    "text": "顾城在《一代人》中以两行极具哲学张力的诗句，",
    "start": 53.648,
    "end": 58.801,
    "duration": 5.153
  },
  {
    "id": 15,
    "text": "将经历过浩劫的一代青年对光明的执着探求凝练为集体精神图腾，",
    "start": 58.801,
    "end": 64.849,
    "duration": 6.048
  },
  {
    "id": 16,
    "text": "实现了生命本体价值的觉醒。",
    "start": 64.849,
    "end": 67.151,
    "duration": 2.302
  },
  {
    "id": 17,
    "text": "第二，呼唤温润博爱的人道主义情怀，确立平等独立的人格尊严。",
    "start": 67.151,
    "end": 72.653,
    "duration": 5.502
  },
  {
    "id": 18,
    "text": "诗群突破了阶级论对情感世界的长期压抑，",
    "start": 72.653,
    "end": 76.291,
    "duration": 3.638
  },
  {
    "id": 19,
    "text": "在人性的真实领地中重新发现爱与温情。",
    "start": 76.291,
    "end": 79.961,
    "duration": 3.67
  },
  {
    "id": 20,
    "text": "舒婷在《致橡树》中以木棉的形象自喻，",
    "start": 79.961,
    "end": 83.166,
    "duration": 3.205
  },
  {
    "id": 21,
    "text": "断然拒绝作为凌霄花借高枝炫耀，",
    "start": 83.166,
    "end": 86.36,
    "duration": 3.194
  },
  {
    "id": 22,
    "text": "也拒绝作为痴情鸟重复单调歌曲，",
    "start": 86.36,
    "end": 89.287,
    "duration": 2.927
  },
  {
    "id": 23,
    "text": "而是以红硕花朵与挺拔橡树并肩挺立于风雨之中，",
    "start": 89.287,
    "end": 93.865,
    "duration": 4.578
  },
  {
    "id": 24,
    "text": "在现代抒情诗中深刻确立了男女平等独立、",
    "start": 93.865,
    "end": 97.5,
    "duration": 3.635
  },
  {
    "id": 25,
    "text": "灵魂深层呼应的人性理想。",
    "start": 97.5,
    "end": 99.709,
    "duration": 2.209
  },
  {
    "id": 26,
    "text": "第三，打破写实线性抒情陈规，",
    "start": 99.709,
    "end": 102.743,
    "duration": 3.034
  },
  {
    "id": 27,
    "text": "开创以隐喻象征为核心的现代主义诗性语法。",
    "start": 102.743,
    "end": 107.02,
    "duration": 4.277
  },
  {
    "id": 28,
    "text": "朦胧诗借鉴西方现代意象派与象征主义手法，",
    "start": 107.02,
    "end": 111.116,
    "duration": 4.096
  },
  {
    "id": 29,
    "text": "大量运用意象跳跃、情绪通感与多义复调结构，",
    "start": 111.116,
    "end": 115.5,
    "duration": 4.384
  },
  {
    "id": 30,
    "text": "将主观内心情感转化为冷峻奇诡的客观对应物。",
    "start": 115.5,
    "end": 119.856,
    "duration": 4.356
  },
  {
    "id": 31,
    "text": "北岛以“镀金的避雷针”与“无花的蔷薇”寄寓荒诞现实，",
    "start": 119.856,
    "end": 124.453,
    "duration": 4.597
  },
  {
    "id": 32,
    "text": "打破了传统诗歌明晰单一的语义闭环，",
    "start": 124.453,
    "end": 127.615,
    "duration": 3.162
  },
  {
    "id": 33,
    "text": "在意象的多重歧义与张力碰撞中极大拓展了新诗的审美空间。",
    "start": 127.615,
    "end": 132.768,
    "duration": 5.153
  }
]