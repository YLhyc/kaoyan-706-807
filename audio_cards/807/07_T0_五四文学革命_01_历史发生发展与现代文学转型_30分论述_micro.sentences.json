[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "五四文学革命·历史发生发展与现代文学转型",
    "start": 0.134,
    "end": 4.261,
    "duration": 4.127
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "发动破旧→理论双柱→社团阵列→创作实绩的历史四步转折：",
    "start": 4.85,
    "end": 11.033,
    "duration": 6.184
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先看《新青年》怎么从胡适温和八事到陈独秀强攻冲垮守旧派，",
    "start": 11.1,
    "end": 16.698,
    "duration": 5.598
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再抓住“胡适立语言形式、周作人立人的内容”双轮定型，进而看文学研究会与创造社双峰建阵，",
    "start": 16.972,
    "end": 24.245,
    "duration": 7.273
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后落到鲁迅郭沫若郁达夫第一个十年丰硕实绩。",
    "start": 24.559,
    "end": 28.79,
    "duration": 4.231
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "五四文学革命是中国文学由古入今的分水岭，",
    "start": 29.377,
    "end": 33.165,
    "duration": 3.788
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "以思想启蒙为引擎、白话取代文言为突破、“人的文学”为内核，",
    "start": 33.374,
    "end": 38.79,
    "duration": 5.416
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "重塑观念、工具、范式与主体精神。",
    "start": 38.973,
    "end": 42.462,
    "duration": 3.489
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 顺应变革潮流、由温和发难到激进强攻",
    "start": 43.049,
    "end": 47.436,
    "duration": 4.387
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "晚清三革命质变于《新青年》：胡适《文学改良刍议》提“不用典”等八事温和发难；",
    "start": 48.023,
    "end": 55.808,
    "duration": 7.785
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "陈独秀《文学革命论》举“三大主义”强攻旧文学温床；",
    "start": 56.108,
    "end": 60.378,
    "duration": 4.27
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "迎战林纾、学衡派、甲寅派反扑，击碎“文以载道”与游戏消遣旧序，确立白话新文学合法性。",
    "start": 60.965,
    "end": 70.053,
    "duration": 9.088
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · “胡适立形式、周作人立内容”双重架构",
    "start": 70.64,
    "end": 74.519,
    "duration": 3.879
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《建设的文学革命论》倡“国语的文学，文学的国语”，将白话升格为民族国家文化基石；",
    "start": 75.106,
    "end": 83.321,
    "duration": 8.215
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《人的文学》倡“个人主义的人间本位”发现人、写灵肉一致人性，形式内容合璧立独立审美本体。",
    "start": 83.908,
    "end": 92.8,
    "duration": 8.892
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 吸纳外国思潮、催生两大社团双峰对峙",
    "start": 93.374,
    "end": 97.709,
    "duration": 4.335
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "中国化吸收现实主义、浪漫主义与象征主义；催生两大社团成熟阵营：",
    "start": 98.296,
    "end": 106.081,
    "duration": 7.785
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "文学研究会高扬“为人生而艺术”写实剖析疾苦；创造社高举“为艺术而艺术”直抒胸臆反叛狂飙，相互砥砺。",
    "start": 106.655,
    "end": 116.745,
    "duration": 10.09
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 转化丰硕实绩、辟启蒙感伤多元潮流",
    "start": 117.319,
    "end": 121.511,
    "duration": 4.192
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "呈启蒙、感伤、个性化与多元特征：鲁迅《狂人日记》《阿Q正传》站在哲学国民性解剖高地；",
    "start": 122.098,
    "end": 131.511,
    "duration": 9.413
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "郁达夫《沉沦》自叙传、郭沫若《女神》自由奔涌度量个性张力，小说、散文、新诗与话剧全面验证理论蓝图。",
    "start": 132.098,
    "end": 143.008,
    "duration": 10.91
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "五四文学革命是触及民族精神灵魂的伟大文艺革新，",
    "start": 143.595,
    "end": 147.969,
    "duration": 4.374
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "以语言革命破思维桎梏、以“人的发现”重构文学与人生纽带，立百年新文学精神源头。",
    "start": 148.244,
    "end": 155.613,
    "duration": 7.369
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：胡适《文学改良刍议》（八事）温和发难，《建设的文学革命论》提“国语的文学，文学的国语”；",
    "start": 156.2,
    "end": 164.402,
    "duration": 8.202
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "陈独秀《文学革命论》提“三大主义”强攻；",
    "start": 164.715,
    "end": 167.956,
    "duration": 3.241
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "周作人《人的文学》立内容灵魂。",
    "start": 168.244,
    "end": 170.743,
    "duration": 2.499
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背全胡适两篇、陈独秀一篇、周作人一篇共四部文学革命奠基文献及口号？",
    "start": 171.33,
    "end": 179.324,
    "duration": 7.994
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合两大社团说明五四从“破坏论争”向“社团组织建设”的转折？",
    "start": 179.898,
    "end": 186.576,
    "duration": 6.679
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2021 真题“五四反传统与文学转型”及 2016/2017“启蒙思想与文学观念变化”？",
    "start": 187.163,
    "end": 196.303,
    "duration": 9.14
  }
]