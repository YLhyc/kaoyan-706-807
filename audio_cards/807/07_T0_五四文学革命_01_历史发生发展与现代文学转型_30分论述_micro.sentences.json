[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "五四文学革命·历史发生发展与现代文学转型",
    "start": 0.314,
    "end": 4.126,
    "duration": 3.812
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "发动破旧→理论双柱→社团阵列→创作实绩的历史四步转折：",
    "start": 5.214,
    "end": 12.146,
    "duration": 6.932
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先看《新青年》怎么从胡适温和八事到陈独秀强攻冲垮守旧派，",
    "start": 12.414,
    "end": 17.746,
    "duration": 5.332
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再抓住“胡适立语言形式、周作人立人的内容”双轮定型，进而看文学研究会与创造社双峰建阵，",
    "start": 17.854,
    "end": 25.226,
    "duration": 7.372
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后落到鲁迅郭沫若郁达夫第一个十年丰硕实绩。",
    "start": 25.414,
    "end": 29.506,
    "duration": 4.092
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "五四文学革命是中国文学由古入今的分水岭，",
    "start": 30.394,
    "end": 33.886,
    "duration": 3.492
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "以思想启蒙为引擎、白话取代文言为突破、“人的文学”为内核，",
    "start": 34.234,
    "end": 39.246,
    "duration": 5.012
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "重塑观念、工具、范式与主体精神。",
    "start": 39.354,
    "end": 42.166,
    "duration": 2.812
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 顺应变革潮流、由温和发难到激进强攻",
    "start": 43.174,
    "end": 47.626,
    "duration": 4.452
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "晚清三革命质变于《新青年》：胡适《文学改良刍议》提“不用典”等八事温和发难；",
    "start": 48.714,
    "end": 56.966,
    "duration": 8.252
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "陈独秀《文学革命论》举“三大主义”强攻旧文学温床；",
    "start": 57.974,
    "end": 62.266,
    "duration": 4.292
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "迎战林纾、学衡派、甲寅派反扑，击碎“文以载道”与游戏消遣旧序，确立白话新文学合法性。",
    "start": 63.314,
    "end": 72.126,
    "duration": 8.812
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · “胡适立形式、周作人立内容”双重架构",
    "start": 73.014,
    "end": 77.386,
    "duration": 4.372
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《建设的文学革命论》倡“国语的文学，文学的国语”，将白话升格为民族国家文化基石；",
    "start": 78.354,
    "end": 87.126,
    "duration": 8.772
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《人的文学》倡“个人主义的人间本位”发现人、写灵肉一致人性，形式内容合璧立独立审美本体。",
    "start": 87.894,
    "end": 98.186,
    "duration": 10.292
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 吸纳外国思潮、催生两大社团双峰对峙",
    "start": 99.154,
    "end": 103.326,
    "duration": 4.172
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "中国化吸收现实主义、浪漫主义与象征主义；催生两大社团成熟阵营：",
    "start": 104.146,
    "end": 110.958,
    "duration": 6.812
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "文学研究会高扬“为人生而艺术”写实剖析疾苦；创造社高举“为艺术而艺术”直抒胸臆反叛狂飙，相互砥砺。",
    "start": 112.006,
    "end": 124.798,
    "duration": 12.792
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 转化丰硕实绩、辟启蒙感伤多元潮流",
    "start": 125.806,
    "end": 130.138,
    "duration": 4.332
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "呈启蒙、感伤、个性化与多元特征：鲁迅《狂人日记》《阿Q正传》站在哲学国民性解剖高地；",
    "start": 131.186,
    "end": 140.798,
    "duration": 9.612
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "郁达夫《沉沦》自叙传、郭沫若《女神》自由奔涌度量个性张力，小说、散文、新诗与话剧全面验证理论蓝图。",
    "start": 141.766,
    "end": 152.738,
    "duration": 10.972
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "五四文学革命是触及民族精神灵魂的伟大文艺革新，",
    "start": 153.746,
    "end": 158.358,
    "duration": 4.612
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "以语言革命破思维桎梏、以“人的发现”重构文学与人生纽带，立百年新文学精神源头。",
    "start": 158.866,
    "end": 166.678,
    "duration": 7.812
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：胡适《文学改良刍议》（八事）温和发难，《建设的文学革命论》提“国语的文学，文学的国语”；",
    "start": 167.726,
    "end": 176.082,
    "duration": 8.356
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "陈独秀《文学革命论》提“三大主义”强攻；",
    "start": 176.097,
    "end": 179.238,
    "duration": 3.141
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "周作人《人的文学》立内容灵魂。",
    "start": 179.966,
    "end": 182.738,
    "duration": 2.772
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背全胡适两篇、陈独秀一篇、周作人一篇共四部文学革命奠基文献及口号？",
    "start": 183.446,
    "end": 191.178,
    "duration": 7.732
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合两大社团说明五四从“破坏论争”向“社团组织建设”的转折？",
    "start": 192.266,
    "end": 198.798,
    "duration": 6.532
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2021 真题“五四反传统与文学转型”及 2016/2017“启蒙思想与文学观念变化”？",
    "start": 199.274,
    "end": 209.366,
    "duration": 10.092
  }
]