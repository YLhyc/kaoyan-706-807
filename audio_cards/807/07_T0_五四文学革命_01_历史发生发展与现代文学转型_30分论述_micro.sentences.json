[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "五四文学革命·历史发生发展与现代文学转型",
    "start": 0.154,
    "end": 4.166,
    "duration": 4.012
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "发动破旧→理论双柱→社团阵列→创作实绩的历史四步转折：",
    "start": 4.85,
    "end": 12.862,
    "duration": 8.012
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先看《新青年》怎么从胡适温和八事到陈独秀强攻冲垮守旧派，",
    "start": 13.17,
    "end": 18.942,
    "duration": 5.772
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再抓住“胡适立语言形式、周作人立人的内容”双轮定型，进而看文学研究会与创造社双峰建阵，",
    "start": 19.33,
    "end": 27.982,
    "duration": 8.652
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后落到鲁迅郭沫若郁达夫第一个十年丰硕实绩。",
    "start": 28.37,
    "end": 32.782,
    "duration": 4.412
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "五四文学革命是中国文学由古入今的分水岭，",
    "start": 33.31,
    "end": 36.442,
    "duration": 3.132
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "以思想启蒙为引擎、白话取代文言为突破、“人的文学”为内核，",
    "start": 36.75,
    "end": 41.482,
    "duration": 4.732
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "重塑观念、工具、范式与主体精神。",
    "start": 41.63,
    "end": 44.522,
    "duration": 2.892
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 顺应变革潮流、由温和发难到激进强攻",
    "start": 45.218,
    "end": 49.15,
    "duration": 3.932
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "晚清三革命质变于《新青年》：胡适《文学改良刍议》提“不用典”等八事温和发难；",
    "start": 49.631,
    "end": 58.043,
    "duration": 8.412
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "陈独秀《文学革命论》举“三大主义”强攻旧文学温床；",
    "start": 58.321,
    "end": 62.973,
    "duration": 4.652
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "迎战林纾、学衡派、甲寅派反扑，击碎“文以载道”与游戏消遣旧序，确立白话新文学合法性。",
    "start": 63.455,
    "end": 72.187,
    "duration": 8.732
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · “胡适立形式、周作人立内容”双重架构",
    "start": 72.828,
    "end": 76.92,
    "duration": 4.092
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《建设的文学革命论》倡“国语的文学，文学的国语”，将白话升格为民族国家文化基石；",
    "start": 77.388,
    "end": 85.96,
    "duration": 8.572
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《人的文学》倡“个人主义的人间本位”发现人、写灵肉一致人性，形式内容合璧立独立审美本体。",
    "start": 86.466,
    "end": 95.518,
    "duration": 9.052
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 吸纳外国思潮、催生两大社团双峰对峙",
    "start": 96.012,
    "end": 99.944,
    "duration": 3.932
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "中国化吸收现实主义、浪漫主义与象征主义；催生两大社团成熟阵营：",
    "start": 100.472,
    "end": 107.284,
    "duration": 6.812
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "文学研究会高扬“为人生而艺术”写实剖析疾苦；创造社高举“为艺术而艺术”直抒胸臆反叛狂飙，相互砥砺。",
    "start": 107.812,
    "end": 118.834,
    "duration": 11.022
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 转化丰硕实绩、辟启蒙感伤多元潮流",
    "start": 119.515,
    "end": 124.007,
    "duration": 4.492
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "呈启蒙、感伤、个性化与多元特征：鲁迅《狂人日记》《阿Q正传》站在哲学国民性解剖高地；",
    "start": 124.535,
    "end": 133.347,
    "duration": 8.812
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "郁达夫《沉沦》自叙传、郭沫若《女神》自由奔涌度量个性张力，小说、散文、新诗与话剧全面验证理论蓝图。",
    "start": 133.875,
    "end": 143.567,
    "duration": 9.692
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "五四文学革命是触及民族精神灵魂的伟大文艺革新，",
    "start": 144.275,
    "end": 148.447,
    "duration": 4.172
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "以语言革命破思维桎梏、以“人的发现”重构文学与人生纽带，立百年新文学精神源头。",
    "start": 148.755,
    "end": 156.367,
    "duration": 7.612
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：胡适《文学改良刍议》（八事）温和发难，《建设的文学革命论》提“国语的文学，文学的国语”；",
    "start": 157.075,
    "end": 165.647,
    "duration": 8.572
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "陈独秀《文学革命论》提“三大主义”强攻；",
    "start": 166.005,
    "end": 169.057,
    "duration": 3.052
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "周作人《人的文学》立内容灵魂。",
    "start": 169.255,
    "end": 172.467,
    "duration": 3.212
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背全胡适两篇、陈独秀一篇、周作人一篇共四部文学革命奠基文献及口号？",
    "start": 172.976,
    "end": 180.895,
    "duration": 7.919
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合两大社团说明五四从“破坏论争”向“社团组织建设”的转折？",
    "start": 181.423,
    "end": 187.792,
    "duration": 6.369
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2021 真题“五四反传统与文学转型”及 2016/2017“启蒙思想与文学观念变化”？",
    "start": 188.32,
    "end": 197.668,
    "duration": 9.348
  }
]