[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "发动破旧→理论双柱→社团阵列→创作实绩的历史四步转折：",
    "start": 0.0,
    "end": 5.84,
    "duration": 5.84
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先看《新青年》怎么从胡适温和八事到陈独秀强攻冲垮守旧派，",
    "start": 5.889,
    "end": 11.289,
    "duration": 5.4
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再抓住“胡适立语言形式、周作人立人的内容”双轮定型，",
    "start": 11.739,
    "end": 16.179,
    "duration": 4.44
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "进而看文学研究会与创造社双峰建阵，",
    "start": 16.629,
    "end": 19.829,
    "duration": 3.2
  },
  {
    "id": "hook_c4",
    "dom_key": "hook_c4",
    "text": "最后落到鲁迅郭沫若郁达夫第一个十年丰硕实绩。",
    "start": 20.279,
    "end": 24.319,
    "duration": 4.04
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "五四文学革命是中国文学由古入今的分水岭，",
    "start": 24.769,
    "end": 28.609,
    "duration": 3.84
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "以思想启蒙为引擎、白话取代文言为突破、“人的文学”为内核，",
    "start": 29.059,
    "end": 33.859,
    "duration": 4.8
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "重塑观念、工具、范式与主体精神。",
    "start": 34.309,
    "end": 37.509,
    "duration": 3.2
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 顺应变革潮流、由温和发难到激进强攻",
    "start": 37.959,
    "end": 42.079,
    "duration": 4.12
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "晚清三革命质变于《新青年》：",
    "start": 42.529,
    "end": 44.969,
    "duration": 2.44
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "胡适《文学改良刍议》提“不用典”等八事温和发难；",
    "start": 45.419,
    "end": 48.979,
    "duration": 3.56
  },
  {
    "id": "sec0_step0_c2",
    "dom_key": "sec0_step0_c2",
    "text": "陈独秀《文学革命论》举“三大主义”强攻旧文学温床；",
    "start": 49.429,
    "end": 53.509,
    "duration": 4.08
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "迎战林纾、学衡派、甲寅派反扑，击碎“文以载道”与游戏消遣旧序，",
    "start": 54.039,
    "end": 59.479,
    "duration": 5.44
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "确立白话新文学合法性。",
    "start": 59.929,
    "end": 61.969,
    "duration": 2.04
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · “胡适立形式、周作人立内容”双重架构",
    "start": 62.419,
    "end": 66.259,
    "duration": 3.84
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《建设的文学革命论》倡“国语的文学，文学的国语”，",
    "start": 66.709,
    "end": 70.509,
    "duration": 3.8
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "将白话升格为民族国家文化基石；",
    "start": 70.959,
    "end": 73.959,
    "duration": 3.0
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《人的文学》倡“个人主义的人间本位”发现人、写灵肉一致人性，",
    "start": 74.409,
    "end": 79.129,
    "duration": 4.72
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "形式内容合璧立独立审美本体。",
    "start": 79.579,
    "end": 82.219,
    "duration": 2.64
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 吸纳外国思潮、催生两大社团双峰对峙",
    "start": 82.669,
    "end": 87.069,
    "duration": 4.4
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "中国化吸收现实主义、浪漫主义与象征主义；",
    "start": 87.519,
    "end": 91.079,
    "duration": 3.56
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "催生两大社团成熟阵营：",
    "start": 91.529,
    "end": 93.649,
    "duration": 2.12
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "文学研究会高扬“为人生而艺术”写实剖析疾苦；",
    "start": 94.099,
    "end": 98.099,
    "duration": 4.0
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "创造社高举“为艺术而艺术”直抒胸臆反叛狂飙，相互砥砺。",
    "start": 98.549,
    "end": 103.309,
    "duration": 4.76
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 转化丰硕实绩、辟启蒙感伤多元潮流",
    "start": 103.879,
    "end": 107.839,
    "duration": 3.96
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "呈启蒙、感伤、个性化与多元特征：",
    "start": 108.289,
    "end": 111.329,
    "duration": 3.04
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "鲁迅《狂人日记》《阿Q正传》站在哲学国民性解剖高地；",
    "start": 111.779,
    "end": 115.859,
    "duration": 4.08
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "郁达夫《沉沦》自叙传、郭沫若《女神》自由奔涌度量个性张力，",
    "start": 116.389,
    "end": 121.269,
    "duration": 4.88
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "小说、散文、新诗与话剧全面验证理论蓝图。",
    "start": 121.719,
    "end": 125.479,
    "duration": 3.76
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "五四文学革命是触及民族精神灵魂的伟大文艺革新，",
    "start": 125.929,
    "end": 130.169,
    "duration": 4.24
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "以语言革命破思维桎梏、以“人的发现”重构文学与人生纽带，",
    "start": 130.619,
    "end": 135.259,
    "duration": 4.64
  },
  {
    "id": "concl_c2",
    "dom_key": "concl_c2",
    "text": "立百年新文学精神源头。",
    "start": 135.709,
    "end": 137.909,
    "duration": 2.2
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：胡适《文学改良刍议》（八事）温和发难，",
    "start": 138.359,
    "end": 142.719,
    "duration": 4.36
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "《建设的文学革命论》提“国语的文学，文学的国语”；",
    "start": 143.169,
    "end": 147.009,
    "duration": 3.84
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "陈独秀《文学革命论》提“三大主义”强攻；",
    "start": 147.459,
    "end": 150.539,
    "duration": 3.08
  },
  {
    "id": "guard_c3",
    "dom_key": "guard_c3",
    "text": "周作人《人的文学》立内容灵魂。",
    "start": 150.989,
    "end": 153.469,
    "duration": 2.48
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背全胡适两篇、陈独秀一篇、周作人一篇共四部文学革命奠基文献及口号？",
    "start": 153.919,
    "end": 161.359,
    "duration": 7.44
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合两大社团说明五四从“破坏论争”向“社团组织建设”的转折？",
    "start": 161.809,
    "end": 168.049,
    "duration": 6.24
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2021 真题“五四反传统与文学转型”及 2016/2017“启蒙思想与文学观念变化”？",
    "start": 168.499,
    "end": 177.659,
    "duration": 9.16
  }
]