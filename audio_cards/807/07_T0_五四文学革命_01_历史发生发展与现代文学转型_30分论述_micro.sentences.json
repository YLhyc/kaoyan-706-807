[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "发动破旧→理论双柱→社团阵列→创作实绩的历史四步转折：先看《新青年》怎么从胡适温和八事到陈独秀强攻冲垮守旧派，",
    "start": 0.229,
    "end": 11.701,
    "duration": 11.473
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再抓住“胡适立语言形式、周作人立人的内容”双轮定型，",
    "start": 12.445,
    "end": 16.789,
    "duration": 4.344
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "进而看文学研究会与创造社双峰建阵，最后落到鲁迅郭沫若郁达夫第一个十年丰硕实绩。",
    "start": 17.492,
    "end": 24.8,
    "duration": 7.308
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "五四文学革命是中国文学由古入今的分水岭，",
    "start": 25.595,
    "end": 29.097,
    "duration": 3.501
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "以思想启蒙为引擎、白话取代文言为突破、“人的文学”为内核，",
    "start": 29.916,
    "end": 35.116,
    "duration": 5.199
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "重塑观念、工具、范式与主体精神。",
    "start": 35.865,
    "end": 39.026,
    "duration": 3.161
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 顺应变革潮流、由温和发难到激进强攻",
    "start": 39.766,
    "end": 44.03,
    "duration": 4.264
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "晚清三革命质变于《新青年》：胡适《文学改良刍议》提“不用典”等八事温和发难；",
    "start": 44.81,
    "end": 51.181,
    "duration": 6.371
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "陈独秀《文学革命论》举“三大主义”强攻旧文学温床；",
    "start": 51.985,
    "end": 56.078,
    "duration": 4.094
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "迎战林纾、学衡派、甲寅派反扑，击碎“文以载道”与游戏消遣旧序，确立白话新文学合法性。",
    "start": 56.87,
    "end": 64.866,
    "duration": 7.996
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · “胡适立形式、周作人立内容”双重架构",
    "start": 65.582,
    "end": 69.321,
    "duration": 3.739
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "《建设的文学革命论》倡“国语的文学，文学的国语”，将白话升格为民族国家文化基石；",
    "start": 70.064,
    "end": 76.909,
    "duration": 6.845
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《人的文学》倡“个人主义的人间本位”发现人、写灵肉一致人性，形式内容合璧立独立审美本体。",
    "start": 77.644,
    "end": 85.184,
    "duration": 7.54
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 吸纳外国思潮、催生两大社团双峰对峙",
    "start": 85.89,
    "end": 90.104,
    "duration": 4.214
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "中国化吸收现实主义、浪漫主义与象征主义；催生两大社团成熟阵营：",
    "start": 90.852,
    "end": 97.146,
    "duration": 6.294
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "文学研究会高扬“为人生而艺术”写实剖析疾苦；",
    "start": 97.899,
    "end": 101.693,
    "duration": 3.793
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "创造社高举“为艺术而艺术”直抒胸臆反叛狂飙，相互砥砺。",
    "start": 102.497,
    "end": 107.382,
    "duration": 4.885
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 转化丰硕实绩、辟启蒙感伤多元潮流",
    "start": 108.096,
    "end": 112.178,
    "duration": 4.082
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "呈启蒙、感伤、个性化与多元特征：鲁迅《狂人日记》《阿Q正传》站在哲学国民性解剖高地；",
    "start": 112.888,
    "end": 121.279,
    "duration": 8.391
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "郁达夫《沉沦》自叙传、郭沫若《女神》自由奔涌度量个性张力，",
    "start": 122.038,
    "end": 126.759,
    "duration": 4.721
  },
  {
    "id": "sec3_step1_c1",
    "dom_key": "sec3_step1_c1",
    "text": "小说、散文、新诗与话剧全面验证理论蓝图。",
    "start": 127.497,
    "end": 131.692,
    "duration": 4.195
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "五四文学革命是触及民族精神灵魂的伟大文艺革新，",
    "start": 132.505,
    "end": 136.773,
    "duration": 4.267
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "以语言革命破思维桎梏、以“人的发现”重构文学与人生纽带，立百年新文学精神源头。",
    "start": 137.513,
    "end": 144.581,
    "duration": 7.068
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：胡适《文学改良刍议》（八事）温和发难，《建设的文学革命论》提“国语的文学，文学的国语”；",
    "start": 145.39,
    "end": 153.591,
    "duration": 8.201
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "陈独秀《文学革命论》提“三大主义”强攻；",
    "start": 154.443,
    "end": 157.231,
    "duration": 2.788
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "周作人《人的文学》立内容灵魂。",
    "start": 157.967,
    "end": 160.251,
    "duration": 2.284
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背全胡适两篇、陈独秀一篇、周作人一篇共四部文学革命奠基文献及口号？",
    "start": 161.068,
    "end": 168.888,
    "duration": 7.82
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合两大社团说明五四从“破坏论争”向“社团组织建设”的转折？",
    "start": 169.63,
    "end": 176.134,
    "duration": 6.504
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2021 真题“五四反传统与文学转型”及 2016/2017“启蒙思想与文学观念变化”？",
    "start": 176.885,
    "end": 186.282,
    "duration": 9.397
  }
]