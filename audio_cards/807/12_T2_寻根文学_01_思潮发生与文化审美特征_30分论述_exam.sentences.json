[
  {
    "id": 1,
    "text": "二十世纪八十年代中期兴起的“寻根文学”，",
    "start": 0.08,
    "end": 3.36,
    "duration": 3.28
  },
  {
    "id": 2,
    "text": "是中国当代文学摆脱浅层政治社会学模式、",
    "start": 3.36,
    "end": 7.44,
    "duration": 4.08
  },
  {
    "id": 3,
    "text": "走向文化本体哲学的重大转向。",
    "start": 7.44,
    "end": 10.32,
    "duration": 2.88
  },
  {
    "id": 4,
    "text": "在西方现代主义思潮与拉美魔幻现实主义的激发下，",
    "start": 10.32,
    "end": 14.88,
    "duration": 4.56
  },
  {
    "id": 5,
    "text": "青年作家们深刻反思伤痕与反思小说的局限。",
    "start": 14.88,
    "end": 19.12,
    "duration": 4.24
  },
  {
    "id": 6,
    "text": "他们主张向民族精神源头逆流而上。",
    "start": 19.12,
    "end": 21.76,
    "duration": 2.64
  },
  {
    "id": 7,
    "text": "一九八五年韩少功发表《文学的“根”》，",
    "start": 22.08,
    "end": 25.193,
    "duration": 3.113
  },
  {
    "id": 8,
    "text": "明确提出“文学之根应深植于民族传统文化的土壤”。",
    "start": 25.193,
    "end": 30.158,
    "duration": 4.965
  },
  {
    "id": 9,
    "text": "阿城、韩少功、莫言、贾平凹、王安忆等作家应运而生。",
    "start": 30.158,
    "end": 34.887,
    "duration": 4.729
  },
  {
    "id": 10,
    "text": "寻根文学的思潮发生与审美探索主要体现在四个深层维度。",
    "start": 34.887,
    "end": 40.798,
    "duration": 5.911
  },
  {
    "id": 11,
    "text": "第一，从政治社会学反思转向民族文化心理结构探寻。",
    "start": 40.798,
    "end": 46.0,
    "duration": 5.202
  },
  {
    "id": 12,
    "text": "新时期初期的文学多局限于政治拨乱反正与制度反思。",
    "start": 46.16,
    "end": 51.52,
    "duration": 5.36
  },
  {
    "id": 13,
    "text": "寻根作家则把目光投向了更深厚的历史底层。",
    "start": 51.52,
    "end": 55.36,
    "duration": 3.84
  },
  {
    "id": 14,
    "text": "他们不再满足于探讨文革动荡的政治表象，",
    "start": 55.36,
    "end": 58.8,
    "duration": 3.44
  },
  {
    "id": 15,
    "text": "而是追问产生这些历史悲剧的传统文化心理机制。",
    "start": 58.8,
    "end": 63.2,
    "duration": 4.4
  },
  {
    "id": 16,
    "text": "韩少功在《爸爸爸》中虚构了封闭绝望的湘西鸡头寨。",
    "start": 63.2,
    "end": 67.68,
    "duration": 4.48
  },
  {
    "id": 17,
    "text": "那个只会喊叫“爸爸”与“叉妈妈”的畸形儿丙崽，",
    "start": 68.0,
    "end": 71.84,
    "duration": 3.84
  },
  {
    "id": 18,
    "text": "成为数千年蒙昧停滞文化的活化石。",
    "start": 71.84,
    "end": 75.36,
    "duration": 3.52
  },
  {
    "id": 19,
    "text": "作家借助神话与荒诞象征，完成了对封建集体无意识与国民劣根性的冷峻解剖。",
    "start": 75.36,
    "end": 82.48,
    "duration": 7.12
  },
  {
    "id": 20,
    "text": "第二，地域文化版图的多元崛起与民间原生风貌重现。",
    "start": 82.48,
    "end": 87.12,
    "duration": 4.64
  },
  {
    "id": 21,
    "text": "寻根文学打破了单一中心的大一统叙事，",
    "start": 87.12,
    "end": 90.48,
    "duration": 3.36
  },
  {
    "id": 22,
    "text": "激活了辽阔版图上各具特色的边缘地域文化。",
    "start": 90.48,
    "end": 93.52,
    "duration": 3.04
  },
  {
    "id": 23,
    "text": "阿城沉醉于世俗市井与庄禅虚静，莫言深耕齐鲁胶东高密东北乡，",
    "start": 93.92,
    "end": 99.84,
    "duration": 5.92
  },
  {
    "id": 24,
    "text": "贾平凹构建苍凉神秘的商州古道，李杭育描绘蛮荒野性的葛川江。",
    "start": 99.84,
    "end": 105.52,
    "duration": 5.68
  },
  {
    "id": 25,
    "text": "这些作家从边缘乡土的巫挪、神话、",
    "start": 105.52,
    "end": 108.64,
    "duration": 3.12
  },
  {
    "id": 26,
    "text": "民俗与方言中汲取养分。",
    "start": 108.64,
    "end": 110.48,
    "duration": 1.84
  },
  {
    "id": 27,
    "text": "他们摆脱了教条化现实主义的干瘪概念，",
    "start": 110.48,
    "end": 113.36,
    "duration": 2.88
  },
  {
    "id": 28,
    "text": "为当代文学注入了饱满鲜活的地域水土与民间元气。",
    "start": 113.36,
    "end": 117.52,
    "duration": 4.16
  },
  {
    "id": 29,
    "text": "第三，原初生命活力的炽烈礼赞与文化沉疴的批判张力。",
    "start": 117.824,
    "end": 123.184,
    "duration": 5.36
  },
  {
    "id": 30,
    "text": "寻根文学内部包含着复杂的双重文化态度。",
    "start": 123.184,
    "end": 126.704,
    "duration": 3.52
  },
  {
    "id": 31,
    "text": "一方面，作家们以狂欢化的笔触，歌颂民间未被现代文明污染的野性与生命力。",
    "start": 126.704,
    "end": 133.424,
    "duration": 6.72
  },
  {
    "id": 32,
    "text": "莫言在《红高粱家族》中塑造了敢生敢死、",
    "start": 133.424,
    "end": 136.864,
    "duration": 3.44
  },
  {
    "id": 33,
    "text": "野蛮豪放的爷爷余占鳌和奶奶戴凤莲。",
    "start": 136.864,
    "end": 139.984,
    "duration": 3.12
  },
  {
    "id": 34,
    "text": "他们体内奔腾着原始强悍的血性力量。",
    "start": 140.304,
    "end": 143.744,
    "duration": 3.44
  },
  {
    "id": 35,
    "text": "另一方面，作家们又清醒警惕儒家宗法伦理的僵化窒息。",
    "start": 143.744,
    "end": 148.784,
    "duration": 5.04
  },
  {
    "id": 36,
    "text": "王安忆在《小鲍庄》中反思传统“仁义”观念对个体生命力的压抑。",
    "start": 148.784,
    "end": 153.904,
    "duration": 5.12
  },
  {
    "id": 37,
    "text": "这种赞美与批判的张力，构成了寻根思潮深刻的哲学深度。",
    "start": 153.904,
    "end": 158.704,
    "duration": 4.8
  },
  {
    "id": 38,
    "text": "第四，中国传统美学语感与现代主义技巧的交融化合。",
    "start": 158.704,
    "end": 163.184,
    "duration": 4.48
  },
  {
    "id": 39,
    "text": "寻根作家在文体上努力摆脱欧化语言的拘又，",
    "start": 163.664,
    "end": 167.504,
    "duration": 3.84
  },
  {
    "id": 40,
    "text": "积极向古典文体传统还乡。",
    "start": 167.504,
    "end": 170.064,
    "duration": 2.56
  },
  {
    "id": 41,
    "text": "阿城的《棋王》借鉴了明清世俗白话短篇与笔记小说的风致。",
    "start": 170.064,
    "end": 175.264,
    "duration": 5.2
  },
  {
    "id": 42,
    "text": "作家将世俗吃喝的烟火气，与王一生棋道通禅的虚静之美融为一体。",
    "start": 175.264,
    "end": 180.864,
    "duration": 5.6
  },
  {
    "id": 43,
    "text": "语言简练冲淡而蕴藉深远。",
    "start": 180.864,
    "end": 183.184,
    "duration": 2.32
  },
  {
    "id": 44,
    "text": "同时作家们普遍化用了拉美魔幻现实主义的神话原型手法。",
    "start": 183.504,
    "end": 188.224,
    "duration": 4.72
  },
  {
    "id": 45,
    "text": "他们将超自然幻象与日常生活严丝合缝地嵌合在一起，",
    "start": 188.224,
    "end": 192.704,
    "duration": 4.48
  },
  {
    "id": 46,
    "text": "创造出极具中国本土气派的现代东方叙事。",
    "start": 192.704,
    "end": 196.304,
    "duration": 3.6
  },
  {
    "id": 47,
    "text": "寻根文学使中国当代文学在文化哲学上达到了新的思想成熟。",
    "start": 196.304,
    "end": 201.424,
    "duration": 5.12
  },
  {
    "id": 48,
    "text": "它既是对古老华夏文明基因的现代盘点，",
    "start": 201.424,
    "end": 204.464,
    "duration": 3.04
  },
  {
    "id": 49,
    "text": "也是汉语小说与世界现代文学平等对话的艺术宣言。",
    "start": 204.464,
    "end": 208.304,
    "duration": 3.84
  },
  {
    "id": 50,
    "text": "这场思潮不仅为后来的先锋小说奠定了文体准备，",
    "start": 208.544,
    "end": 212.864,
    "duration": 4.32
  },
  {
    "id": 51,
    "text": "更为当代文坛留下了丰厚的民族美学遗产。--",
    "start": 212.864,
    "end": 216.464,
    "duration": 3.6
  }
]