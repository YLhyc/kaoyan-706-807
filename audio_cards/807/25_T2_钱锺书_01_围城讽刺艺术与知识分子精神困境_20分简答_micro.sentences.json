[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "钱锺书·围城讽刺艺术与知识分子精神困境",
    "start": 0.354,
    "end": 4.886,
    "duration": 4.532
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "哲学隐喻（围城内外皆困局）→修辞笔法（中西诗话通感机智讽刺）→社会剖面（三闾大学文凭官场灰暗），",
    "start": 5.934,
    "end": 17.226,
    "duration": 11.292
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "三点写绝这部“新儒林外史”。",
    "start": 17.414,
    "end": 19.866,
    "duration": 2.452
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "四十年代中后期钱锺书《围城》以学者化笔墨写就剖析知识分子病态灵魂的“新儒林外史”。",
    "start": 20.874,
    "end": 29.286,
    "duration": 8.412
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · “围城”哲学隐喻：普遍生存悖论与困局",
    "start": 30.174,
    "end": 33.866,
    "duration": 3.692
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "借法国谚语指结婚如“被围困的城堡，城外想冲进去，城里想逃出来”；",
    "start": 34.874,
    "end": 41.726,
    "duration": 6.852
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "留归求职婚恋屡挫：在苏文纨与唐晓芙间错位，婚后与孙柔嘉消磨于琐碎争吵姑嫂龃龉，",
    "start": 42.734,
    "end": 52.426,
    "duration": 9.692
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "超越婚姻写尽欲望追寻与现实幻灭的生存悖论。",
    "start": 52.694,
    "end": 56.706,
    "duration": 4.012
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 博雅机智学者修辞：幽默辛辣智性讽刺",
    "start": 57.634,
    "end": 62.326,
    "duration": 4.692
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "融西方修辞与传统诗话妙喻，擅通感、反讽与旁逸斜出警句连环；",
    "start": 63.294,
    "end": 71.546,
    "duration": 8.252
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "戏谑鲍小姐装束为“熟食铺子”“局部的真理”，写李梅亭铁箱藏卡片西药一路丑态，",
    "start": 72.634,
    "end": 81.286,
    "duration": 8.652
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "在不露声色调侃中剖尽虚荣庸俗。",
    "start": 81.674,
    "end": 84.926,
    "duration": 3.252
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 解剖三闾大学众生相、揭知识界虚伪平庸",
    "start": 85.934,
    "end": 90.266,
    "duration": 4.332
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "赴三闾大学执教勾勒学术场域：校长高松年老谋深算、西洋史韩学愈靠买克莱登大学假文凭招摇，同事争课时倾轧；",
    "start": 91.234,
    "end": 104.086,
    "duration": 12.852
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "深刻揭露旧官场恶习与半殖民地洋化文明杂交的知识界劣根性。",
    "start": 105.014,
    "end": 110.906,
    "duration": 5.892
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：四十年代中后期“新儒林外史”；",
    "start": 111.994,
    "end": 115.326,
    "duration": 3.332
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "主角方鸿渐（克莱登大学假博士）；",
    "start": 116.334,
    "end": 119.066,
    "duration": 2.732
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "记住女性与学界对比人物：鲍小姐、苏文纨、唐晓芙、孙柔嘉；高松年、李梅亭、韩学愈。",
    "start": 120.074,
    "end": 129.146,
    "duration": 9.072
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出法国“围城”谚语出处及围绕方鸿渐的四位女性名字？",
    "start": 129.751,
    "end": 135.283,
    "duration": 5.532
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合鲍小姐“熟食铺子”、李梅亭铁箱、韩学愈“克莱登大学”三处例证说明其智性讽刺艺术？",
    "start": 136.251,
    "end": 145.503,
    "duration": 9.252
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2018 简答《钱锺书〈围城〉的文化意蕴》怎么从婚姻推向生存与文明反思？",
    "start": 145.899,
    "end": 154.151,
    "duration": 8.252
  }
]