[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "钱锺书·围城讽刺艺术与知识分子精神困境",
    "start": 0.154,
    "end": 3.766,
    "duration": 3.612
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "哲学隐喻（围城内外皆困局）→修辞笔法（中西诗话通感机智讽刺）→社会剖面（三闾大学文凭官场灰暗），",
    "start": 4.437,
    "end": 14.929,
    "duration": 10.492
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "三点写绝这部“新儒林外史”。",
    "start": 15.077,
    "end": 17.409,
    "duration": 2.332
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "四十年代中后期钱锺书《围城》以学者化笔墨写就剖析知识分子病态灵魂的“新儒林外史”。",
    "start": 17.937,
    "end": 26.029,
    "duration": 8.092
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · “围城”哲学隐喻：普遍生存悖论与困局",
    "start": 26.676,
    "end": 30.368,
    "duration": 3.692
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "借法国谚语指结婚如“被围困的城堡，城外想冲进去，城里想逃出来”；",
    "start": 30.887,
    "end": 37.699,
    "duration": 6.812
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "留归求职婚恋屡挫：在苏文纨与唐晓芙间错位，婚后与孙柔嘉消磨于琐碎争吵姑嫂龃龉，",
    "start": 38.227,
    "end": 48.639,
    "duration": 10.412
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "超越婚姻写尽欲望追寻与现实幻灭的生存悖论。",
    "start": 48.947,
    "end": 53.279,
    "duration": 4.332
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 博雅机智学者修辞：幽默辛辣智性讽刺",
    "start": 53.924,
    "end": 58.336,
    "duration": 4.412
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "融西方修辞与传统诗话妙喻，擅通感、反讽与旁逸斜出警句连环；",
    "start": 58.849,
    "end": 66.381,
    "duration": 7.532
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "戏谑鲍小姐装束为“熟食铺子”“局部的真理”，写李梅亭铁箱藏卡片西药一路丑态，",
    "start": 66.89,
    "end": 75.062,
    "duration": 8.172
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "在不露声色调侃中剖尽虚荣庸俗。",
    "start": 75.37,
    "end": 78.422,
    "duration": 3.052
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 解剖三闾大学众生相、揭知识界虚伪平庸",
    "start": 79.13,
    "end": 83.702,
    "duration": 4.572
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "赴三闾大学执教勾勒学术场域：校长高松年老谋深算、西洋史韩学愈靠买克莱登大学假文凭招摇，同事争课时倾轧；",
    "start": 84.23,
    "end": 96.722,
    "duration": 12.492
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "深刻揭露旧官场恶习与半殖民地洋化文明杂交的知识界劣根性。",
    "start": 97.23,
    "end": 102.762,
    "duration": 5.532
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：四十年代中后期“新儒林外史”；",
    "start": 103.455,
    "end": 106.987,
    "duration": 3.532
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "主角方鸿渐（克莱登大学假博士）；",
    "start": 107.345,
    "end": 109.997,
    "duration": 2.652
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "记住女性与学界对比人物：鲍小姐、苏文纨、唐晓芙、孙柔嘉；高松年、李梅亭、韩学愈。",
    "start": 110.355,
    "end": 118.737,
    "duration": 8.382
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出法国“围城”谚语出处及围绕方鸿渐的四位女性名字？",
    "start": 119.368,
    "end": 124.98,
    "duration": 5.612
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合鲍小姐“熟食铺子”、李梅亭铁箱、韩学愈“克莱登大学”三处例证说明其智性讽刺艺术？",
    "start": 125.368,
    "end": 133.78,
    "duration": 8.412
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2018 简答《钱锺书〈围城〉的文化意蕴》怎么从婚姻推向生存与文明反思？",
    "start": 134.308,
    "end": 141.92,
    "duration": 7.612
  }
]