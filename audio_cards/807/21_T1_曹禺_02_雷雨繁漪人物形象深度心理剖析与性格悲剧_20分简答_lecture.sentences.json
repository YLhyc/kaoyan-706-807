[
  {
    "id": 1,
    "text": "本题是 807 专业课中考查作家经典人物形象的 20 分简答题。",
    "start": 0.1,
    "end": 5.87,
    "duration": 5.77
  },
  {
    "id": 2,
    "text": "必须在 20 分钟内，准确完成两大核心任务，一是剖析蘩漪性格内部由“追求生命自主”到“绝望报复”的复杂心理机制；二是揭示其从“外部制度绞杀”到“内部孤立局限”的悲剧成因。",
    "start": 5.82,
    "end": 21.211,
    "duration": 15.391
  },
  {
    "id": 3,
    "text": "简答题严禁长篇大论的历史背景反衬，必须“直入核心，分点立桩，嵌入证据”。",
    "start": 21.211,
    "end": 28.542,
    "duration": 7.331
  },
  {
    "id": 4,
    "text": "采用“性格两点（性灵抗争 + 异化报复）＋ 成因两点（封建制度扼杀 + 懦弱男权背叛）”的四点对称矩阵，既全面踩中采分点，又能在 550 字左右利落收工。",
    "start": 28.542,
    "end": 42.982,
    "duration": 14.44
  },
  {
    "id": 5,
    "text": "蘩漪是曹禺话剧《雷雨》中性格烈度最高，现代性最强的悲剧典型，被作者誉为拥有“最‘雷雨’的性格”。",
    "start": 42.982,
    "end": 52.018,
    "duration": 9.036
  },
  {
    "id": 6,
    "text": "她是一个深受五四新思潮濡染却深锁于封建死屋，兼具热烈生命渴望与残酷复仇意志的复杂复合体。",
    "start": 52.018,
    "end": 61.211,
    "duration": 9.193
  },
  {
    "id": 7,
    "text": "其性格特征与悲剧成因主要体现在以下四个维度，",
    "start": 61.211,
    "end": 65.938,
    "duration": 4.727
  },
  {
    "id": 8,
    "text": "彻底干掉生卒年籍贯废话，第一行直接以曹禺权威定评立论，定性生存悖论，引出四项采分点。",
    "start": 65.938,
    "end": 74.857,
    "duration": 8.919
  },
  {
    "id": 9,
    "text": "第一，追求个性自主的原生性灵与决绝抗争。",
    "start": 74.857,
    "end": 79.453,
    "duration": 4.596
  },
  {
    "id": 10,
    "text": "蘩漪受过现代文明浸润，在周公馆沉闷窒息的宗法铁笼中，保留了对爱情与独立生命的炽烈渴望。",
    "start": 79.453,
    "end": 88.255,
    "duration": 8.802
  },
  {
    "id": 11,
    "text": "面对周朴园封建家长制的极权专制，她是全剧唯一敢于当面抗衡的叛逆者。",
    "start": 88.255,
    "end": 94.974,
    "duration": 6.719
  },
  {
    "id": 12,
    "text": "在“逼喝苦药”的标志性冲突中，她从骨子里蔑视家长的伪善规训，即便被强行按着喝下苦汤，其冷峻沉默依然展现出不愿屈从的傲骨。",
    "start": 94.974,
    "end": 107.305,
    "duration": 12.331
  },
  {
    "id": 13,
    "text": "加粗动宾立桩，嵌入“逼喝苦药”名场面，讲清反叛骨力。",
    "start": 107.305,
    "end": 112.67,
    "duration": 5.365
  },
  {
    "id": 14,
    "text": "第二，遭遇背弃后爱欲转化为报复的“雷雨式破坏力”。",
    "start": 112.669,
    "end": 117.5,
    "duration": 4.831
  },
  {
    "id": 15,
    "text": "蘩漪反抗伦理网罗将情感寄托于周萍，本质是生命本能被极度压抑后的绝望寄托。",
    "start": 117.5,
    "end": 125.052,
    "duration": 7.552
  },
  {
    "id": 16,
    "text": "当周萍为了名声自私悔罪，企图抽身而走并转恋四凤时，蘩漪最后的生存支柱彻底崩塌。",
    "start": 125.052,
    "end": 133.646,
    "duration": 8.594
  },
  {
    "id": 17,
    "text": "其炽烈的爱欲随即异化为同归于尽的复仇意志，最终在雷雨交加之夜当众引爆两代人的血缘罪恶，将周公馆的伪善撕得粉碎。",
    "start": 133.646,
    "end": 145.078,
    "duration": 11.432
  },
  {
    "id": 18,
    "text": "加粗动宾立桩，揭示畸形依恋转为复仇狂飙的心理流变，嵌入雷雨之夜引爆罪恶的情节。",
    "start": 145.078,
    "end": 153.62,
    "duration": 8.542
  },
  {
    "id": 19,
    "text": "第三，封建宗法体制的专制扼杀（悲剧的制度根源）。",
    "start": 153.62,
    "end": 158.503,
    "duration": 4.883
  },
  {
    "id": 20,
    "text": "周朴园代表的封建资本家以家长特权构筑了窒息的生存死屋。",
    "start": 158.503,
    "end": 164.388,
    "duration": 5.885
  },
  {
    "id": 21,
    "text": "他为了维护家族体面，将个性鲜明的蘩漪污名化为“疯子”，剥夺其作为正常人的话语权利，并以服药就医进行人身监禁与精神虐杀，彻底封死了女性合理的生存与出路。",
    "start": 164.388,
    "end": 179.414,
    "duration": 15.026
  },
  {
    "id": 22,
    "text": "指出周朴园用“疯子”污名化，人身监禁规训人性的体制罪恶。",
    "start": 179.414,
    "end": 185.443,
    "duration": 6.029
  },
  {
    "id": 23,
    "text": "第四，懦弱男权的自私背叛与个体抗争的孤立绝境（悲剧的直接成因）。",
    "start": 185.443,
    "end": 191.927,
    "duration": 6.484
  },
  {
    "id": 24,
    "text": "周萍虚伪怯懦，始乱终弃，将乱伦责任完全推诿给蘩漪，使其在伦理与情感上陷入双重绝境。",
    "start": 191.927,
    "end": 200.937,
    "duration": 9.01
  },
  {
    "id": 25,
    "text": "在缺乏社会变革依托的前提下，蘩漪脱离社会力量的孤立个人抗争，注定蜕变为反噬自身的毁灭性狂飙。",
    "start": 200.938,
    "end": 210.261,
    "duration": 9.323
  },
  {
    "id": 26,
    "text": "揭示周萍懦弱背叛与孤立抗争的局限，闭环悲剧机制。",
    "start": 210.26,
    "end": 215.546,
    "duration": 5.286
  },
  {
    "id": 27,
    "text": "综上所述，蘩漪的悲剧是五四觉醒女性在封建宗法重压与懦弱男权夹击下的生命挽歌。",
    "start": 215.547,
    "end": 224.011,
    "duration": 8.464
  },
  {
    "id": 28,
    "text": "曹禺通过这一性格悲剧，深刻批判了封建大家庭对人性的残酷摧残，展现出动人心魄的现代悲剧力量。",
    "start": 224.01,
    "end": 233.984,
    "duration": 9.974
  },
  {
    "id": 29,
    "text": "精炼提升，回扣反封建与崇高现代悲剧主题。",
    "start": 233.984,
    "end": 238.632,
    "duration": 4.648
  }
]