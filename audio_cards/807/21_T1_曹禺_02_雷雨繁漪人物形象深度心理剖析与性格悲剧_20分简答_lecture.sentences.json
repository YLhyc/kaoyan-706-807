[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 3.36,
    "duration": 3.28
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 3.36,
    "end": 6.32,
    "duration": 2.96
  },
  {
    "id": 3,
    "text": "这道题考查曹禺笔下最具震撼力的女性形象繁漪。",
    "start": 6.48,
    "end": 10.8,
    "duration": 4.32
  },
  {
    "id": 4,
    "text": "在考场上，考生不能简单只写“繁漪可怜”或“繁漪疯了”，",
    "start": 10.8,
    "end": 15.52,
    "duration": 4.72
  },
  {
    "id": 5,
    "text": "而必须紧扣“复杂性格特征（爱、抗争、",
    "start": 15.52,
    "end": 18.88,
    "duration": 3.36
  },
  {
    "id": 6,
    "text": "报复）”与“悲剧成因（封建家长专制加男权背叛）”两大逻辑任务。",
    "start": 18.88,
    "end": 24.0,
    "duration": 5.12
  },
  {
    "id": 7,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 24.24,
    "end": 27.36,
    "duration": 3.12
  },
  {
    "id": 8,
    "text": "答题必须确立“由表及里、形神结合”的精炼解剖框架。",
    "start": 27.36,
    "end": 32.0,
    "duration": 4.64
  },
  {
    "id": 9,
    "text": "先点出曹禺“最雷雨性格”的经典定性，",
    "start": 32.0,
    "end": 35.12,
    "duration": 3.12
  },
  {
    "id": 10,
    "text": "随后分层剖析其热烈生命、傲骨反抗与畸形报复三重性格，",
    "start": 35.12,
    "end": 40.16,
    "duration": 5.04
  },
  {
    "id": 11,
    "text": "接着深入到周朴园逼药和周萍弃绝两个现实冲突，",
    "start": 40.16,
    "end": 44.24,
    "duration": 4.08
  },
  {
    "id": 12,
    "text": "最后提炼其反叛女性的时代悲剧定论。",
    "start": 44.24,
    "end": 46.96,
    "duration": 2.72
  },
  {
    "id": 13,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 47.28,
    "end": 50.56,
    "duration": 3.28
  },
  {
    "id": 14,
    "text": "全题分为四个核心论述维度：第一维度：界定繁漪作为《雷雨》最饱满典型与“最雷雨性格”的艺术坐标；",
    "start": 50.56,
    "end": 59.12,
    "duration": 8.56
  },
  {
    "id": 15,
    "text": "第二维度：深入剖析其炽烈爱欲、决绝反抗与绝望报复三位一体的复杂性格；",
    "start": 59.12,
    "end": 65.52,
    "duration": 6.4
  },
  {
    "id": 16,
    "text": "第三维度：深刻论述周朴园封建规训压迫与周萍自私背叛共同促成的悲剧成因；",
    "start": 65.76,
    "end": 72.32,
    "duration": 6.56
  },
  {
    "id": 17,
    "text": "第四维度：宏观总结封建家庭扼杀叛逆女性的崇高悲剧力量。",
    "start": 72.32,
    "end": 77.28,
    "duration": 4.96
  },
  {
    "id": 18,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 77.28,
    "end": 80.88,
    "duration": 3.6
  },
  {
    "id": 19,
    "text": "全题逻辑严密咬合：第一步先确立性格总纲。",
    "start": 80.88,
    "end": 84.48,
    "duration": 3.6
  },
  {
    "id": 20,
    "text": "第二步剖析性格的内部层次，讲透从爱到恨再到疯狂报复的心理流变。",
    "start": 84.8,
    "end": 91.44,
    "duration": 6.64
  },
  {
    "id": 21,
    "text": "第三步探究为什么性格会发生如此扭曲的剧变，",
    "start": 91.44,
    "end": 95.68,
    "duration": 4.24
  },
  {
    "id": 22,
    "text": "归咎于周朴园的暴力压制与周萍的背弃。",
    "start": 95.68,
    "end": 99.36,
    "duration": 3.68
  },
  {
    "id": 23,
    "text": "第四步完成宏观历史论证闭环。",
    "start": 99.36,
    "end": 102.88,
    "duration": 3.52
  },
  {
    "id": 24,
    "text": "二、各板块逐句咬合演练。",
    "start": 102.88,
    "end": 105.6,
    "duration": 2.72
  },
  {
    "id": 25,
    "text": "一、开头破题段内部咬合。",
    "start": 105.6,
    "end": 108.0,
    "duration": 2.4
  },
  {
    "id": 26,
    "text": "本段旨在开门见山确立立论基石。",
    "start": 108.4,
    "end": 111.68,
    "duration": 3.28
  },
  {
    "id": 27,
    "text": "首句直切经典地位，次句引入曹禺原著定论，",
    "start": 111.68,
    "end": 115.68,
    "duration": 4.0
  },
  {
    "id": 28,
    "text": "末句概括性格核心。",
    "start": 115.68,
    "end": 117.6,
    "duration": 1.92
  },
  {
    "id": 29,
    "text": "首先，首句必须直接亮出该人物在《雷雨》中的崇高地位，",
    "start": 117.6,
    "end": 122.0,
    "duration": 4.4
  },
  {
    "id": 30,
    "text": "具体表述到答题语句就是：繁漪是曹禺话剧《雷雨》中塑造得最深刻饱满的悲剧人物。",
    "start": 122.0,
    "end": 128.4,
    "duration": 6.4
  },
  {
    "id": 31,
    "text": "-有了经典定性之后，次句必须迅速引入曹禺本人的权威评价，",
    "start": 128.56,
    "end": 133.942,
    "duration": 5.382
  },
  {
    "id": 32,
    "text": "具体表述到答题语句就是：曹禺在剧本序幕中盛赞其拥有“最‘雷雨’的性格”。",
    "start": 133.942,
    "end": 140.4,
    "duration": 6.458
  },
  {
    "id": 33,
    "text": "-随后，末句干脆利落地揭示其爱恨交织的反叛悲剧特质，",
    "start": 140.448,
    "end": 145.375,
    "duration": 4.927
  },
  {
    "id": 34,
    "text": "具体表述到答题语句就是：她是一个既受封建压迫又敢于绝望反叛、",
    "start": 145.375,
    "end": 151.373,
    "duration": 5.998
  },
  {
    "id": 35,
    "text": "爱到极致又恨到畸形的复杂悲剧典型。",
    "start": 151.373,
    "end": 154.801,
    "duration": 3.428
  },
  {
    "id": 36,
    "text": "繁漪是曹禺话剧《雷雨》中塑造得最深刻饱满的悲剧人物。",
    "start": 154.801,
    "end": 159.728,
    "duration": 4.927
  },
  {
    "id": 37,
    "text": "曹禺在剧本序幕中盛赞其拥有“最‘雷雨’的性格”。",
    "start": 159.888,
    "end": 163.968,
    "duration": 4.08
  },
  {
    "id": 38,
    "text": "她是一个既受封建压迫又敢于绝望反叛、",
    "start": 163.968,
    "end": 167.408,
    "duration": 3.44
  },
  {
    "id": 39,
    "text": "爱到极致又恨到畸形的复杂悲剧典型。",
    "start": 167.408,
    "end": 170.768,
    "duration": 3.36
  },
  {
    "id": 40,
    "text": "二、第二板块：繁漪复杂性格的三大特征内部咬合。",
    "start": 170.768,
    "end": 175.408,
    "duration": 4.64
  },
  {
    "id": 41,
    "text": "本段任务是深入剖析炽烈情欲、傲骨反抗与绝望报复三层性格，",
    "start": 175.408,
    "end": 180.928,
    "duration": 5.52
  },
  {
    "id": 42,
    "text": "调取逼喝药等关键细节。",
    "start": 180.928,
    "end": 182.688,
    "duration": 1.76
  },
  {
    "id": 43,
    "text": "-首先，段首给出统领分论点，具体表述到答题语句就是：首先，",
    "start": 182.928,
    "end": 187.882,
    "duration": 4.954
  },
  {
    "id": 44,
    "text": "在性格特征上，繁漪呈现出炽烈狂暴与矛盾撕裂的三大心理维度。",
    "start": 187.882,
    "end": 193.454,
    "duration": 5.572
  },
  {
    "id": 45,
    "text": "随后，剖析第一层追求自主生命的原生热情，",
    "start": 193.454,
    "end": 197.17,
    "duration": 3.716
  },
  {
    "id": 46,
    "text": "具体表述到答题语句就是：第一是拥有如火如荼、",
    "start": 197.17,
    "end": 201.298,
    "duration": 4.128
  },
  {
    "id": 47,
    "text": "追求自主生命的原生热情。",
    "start": 201.298,
    "end": 203.568,
    "duration": 2.27
  },
  {
    "id": 48,
    "text": "她在窒息阴森的周公馆中保留了罕见的性灵与生命渴望，",
    "start": 203.648,
    "end": 208.448,
    "duration": 4.8
  },
  {
    "id": 49,
    "text": "敢于冲破世俗伦理与继子周萍相爱，",
    "start": 208.448,
    "end": 211.808,
    "duration": 3.36
  },
  {
    "id": 50,
    "text": "展现出追求个体解放的决绝勇气。",
    "start": 211.808,
    "end": 214.688,
    "duration": 2.88
  },
  {
    "id": 51,
    "text": "紧接着，剖析第二层面对周朴园专制的不屈傲骨，",
    "start": 214.688,
    "end": 218.528,
    "duration": 3.84
  },
  {
    "id": 52,
    "text": "具体表述到答题语句就是：第二是具有深沉坚韧的反抗骨力。",
    "start": 218.528,
    "end": 223.408,
    "duration": 4.88
  },
  {
    "id": 53,
    "text": "面对周朴园封建家长制的威严专制，",
    "start": 223.648,
    "end": 226.608,
    "duration": 2.96
  },
  {
    "id": 54,
    "text": "她是周公馆中唯一敢于当面顶撞、公然蔑视周朴园统治的叛逆女性，",
    "start": 226.608,
    "end": 231.968,
    "duration": 5.36
  },
  {
    "id": 55,
    "text": "在周朴园逼其“喝药”的残酷冲突中，",
    "start": 231.968,
    "end": 234.688,
    "duration": 2.72
  },
  {
    "id": 56,
    "text": "她从骨子里透露出不屈的傲骨。",
    "start": 234.688,
    "end": 237.168,
    "duration": 2.48
  },
  {
    "id": 57,
    "text": "最后，剖析第三层由爱转恨的绝望报复，",
    "start": 237.168,
    "end": 240.608,
    "duration": 3.44
  },
  {
    "id": 58,
    "text": "具体表述到答题语句就是：第三是在绝望受挫中异化出的狠毒报复心理。",
    "start": 240.608,
    "end": 245.888,
    "duration": 5.28
  },
  {
    "id": 59,
    "text": "当遭遇周萍的懦弱背弃并发现其转恋四凤后，",
    "start": 246.128,
    "end": 249.808,
    "duration": 3.68
  },
  {
    "id": 60,
    "text": "繁漪的爱转化为焚毁一切的绝望狂怒，",
    "start": 249.808,
    "end": 252.848,
    "duration": 3.04
  },
  {
    "id": 61,
    "text": "她在雷雨之夜撕开全部罪恶真相，在玉石俱焚中走向毁灭。",
    "start": 252.848,
    "end": 257.408,
    "duration": 4.56
  },
  {
    "id": 62,
    "text": "首先，在性格特征上，繁漪呈现出炽烈狂暴与矛盾撕裂的三大心理维度。",
    "start": 257.776,
    "end": 264.016,
    "duration": 6.24
  },
  {
    "id": 63,
    "text": "第一是拥有如火如荼、追求自主生命的原生热情。",
    "start": 264.016,
    "end": 268.336,
    "duration": 4.32
  },
  {
    "id": 64,
    "text": "她在窒息阴森的周公馆中保留了罕见的性灵与生命渴望，",
    "start": 268.336,
    "end": 273.136,
    "duration": 4.8
  },
  {
    "id": 65,
    "text": "敢于冲破世俗伦理与继子周萍相爱，",
    "start": 273.136,
    "end": 276.416,
    "duration": 3.28
  },
  {
    "id": 66,
    "text": "展现出追求个体解放的决绝勇气。",
    "start": 276.416,
    "end": 279.056,
    "duration": 2.64
  },
  {
    "id": 67,
    "text": "第二是具有深沉坚韧的反抗骨力。",
    "start": 279.376,
    "end": 282.416,
    "duration": 3.04
  },
  {
    "id": 68,
    "text": "面对周朴园封建家长制的威严专制，",
    "start": 282.416,
    "end": 285.376,
    "duration": 2.96
  },
  {
    "id": 69,
    "text": "她是周公馆中唯一敢于当面顶撞、公然蔑视周朴园统治的叛逆女性，",
    "start": 285.376,
    "end": 290.896,
    "duration": 5.52
  },
  {
    "id": 70,
    "text": "在周朴园逼其“喝药”的残酷冲突中，",
    "start": 290.896,
    "end": 293.696,
    "duration": 2.8
  },
  {
    "id": 71,
    "text": "她从骨子里透露出不屈的傲骨。",
    "start": 293.696,
    "end": 296.336,
    "duration": 2.64
  },
  {
    "id": 72,
    "text": "第三是在绝望受挫中异化出的狠毒报复心理。",
    "start": 296.336,
    "end": 300.016,
    "duration": 3.68
  },
  {
    "id": 73,
    "text": "当遭遇周萍的懦弱背弃并发现其转恋四凤后，",
    "start": 300.256,
    "end": 304.096,
    "duration": 3.84
  },
  {
    "id": 74,
    "text": "繁漪的爱转化为焚毁一切的绝望狂怒，",
    "start": 304.096,
    "end": 307.616,
    "duration": 3.52
  },
  {
    "id": 75,
    "text": "她在雷雨之夜撕开全部罪恶真相，在玉石俱焚中走向毁灭。",
    "start": 307.616,
    "end": 312.896,
    "duration": 5.28
  },
  {
    "id": 76,
    "text": "三、第三板块：悲剧成因的双重机制剖析内部咬合。",
    "start": 312.896,
    "end": 317.936,
    "duration": 5.04
  },
  {
    "id": 77,
    "text": "本段任务是直击本题第二问，深入剖析封建专制压迫与男权懦弱背弃两大根源。",
    "start": 317.936,
    "end": 324.736,
    "duration": 6.8
  },
  {
    "id": 78,
    "text": "-首先，段首给出统领分论点，具体表述到答题语句就是：其次，",
    "start": 324.976,
    "end": 330.298,
    "duration": 5.322
  },
  {
    "id": 79,
    "text": "在悲剧成因上，繁漪的毁灭是封建专制窒息压迫与男权自私背叛共同绞杀的产物。",
    "start": 330.298,
    "end": 337.838,
    "duration": 7.54
  },
  {
    "id": 80,
    "text": "随后，剖析周朴园封建压制的制度杀人机制，",
    "start": 337.838,
    "end": 341.829,
    "duration": 3.991
  },
  {
    "id": 81,
    "text": "具体表述到答题语句就是：一方面，",
    "start": 341.829,
    "end": 344.934,
    "duration": 3.105
  },
  {
    "id": 82,
    "text": "周朴园所构筑的封建礼教铁笼是扼杀其生命的制度根源。",
    "start": 344.934,
    "end": 350.256,
    "duration": 5.322
  },
  {
    "id": 83,
    "text": "周朴园以虚伪的道德名分将生性热烈的繁漪判定为“疯子”，",
    "start": 350.416,
    "end": 355.456,
    "duration": 5.04
  },
  {
    "id": 84,
    "text": "用逼喝药的暴力规训试图磨灭其独立人格，",
    "start": 355.456,
    "end": 359.056,
    "duration": 3.6
  },
  {
    "id": 85,
    "text": "令其陷入生不如死的精神绝境。",
    "start": 359.056,
    "end": 361.696,
    "duration": 2.64
  },
  {
    "id": 86,
    "text": "紧接着，剖析周萍自私怯懦将其逼上绝路的直接诱因，",
    "start": 361.696,
    "end": 366.096,
    "duration": 4.4
  },
  {
    "id": 87,
    "text": "具体表述到答题语句就是：另一方面，",
    "start": 366.096,
    "end": 368.896,
    "duration": 2.8
  },
  {
    "id": 88,
    "text": "周萍的自私懦弱是将其推入深渊的直接导火索。",
    "start": 368.896,
    "end": 372.496,
    "duration": 3.6
  },
  {
    "id": 89,
    "text": "周萍始乱终弃，以所谓“悔过”为借口将一切罪责推伟给繁漪并仓皇逃避，",
    "start": 372.736,
    "end": 379.456,
    "duration": 6.72
  },
  {
    "id": 90,
    "text": "彻底击碎了繁漪赖以存活的情感支柱。",
    "start": 379.456,
    "end": 382.576,
    "duration": 3.12
  },
  {
    "id": 91,
    "text": "最后，总结抗争只能演化为疯狂的时代局限：在无路可走的封建死局中，",
    "start": 382.576,
    "end": 388.656,
    "duration": 6.08
  },
  {
    "id": 92,
    "text": "她的抗争只能演化为病态疯狂的自杀式爆发。",
    "start": 388.656,
    "end": 392.336,
    "duration": 3.68
  },
  {
    "id": 93,
    "text": "其次，在悲剧成因上，繁漪的毁灭是封建专制窒息压迫与男权自私背叛共同绞杀的产物。",
    "start": 392.8,
    "end": 400.4,
    "duration": 7.6
  },
  {
    "id": 94,
    "text": "一方面，周朴园所构筑的封建礼教铁笼是扼杀其生命的制度根源。",
    "start": 400.4,
    "end": 405.68,
    "duration": 5.28
  },
  {
    "id": 95,
    "text": "周朴园以虚伪的道德名分将生性热烈的繁漪判定为“疯子”，",
    "start": 405.68,
    "end": 410.08,
    "duration": 4.4
  },
  {
    "id": 96,
    "text": "用逼喝药的暴力规训试图磨灭其独立人格，",
    "start": 410.08,
    "end": 413.68,
    "duration": 3.6
  },
  {
    "id": 97,
    "text": "令其陷入生不如死的精神绝境。",
    "start": 413.68,
    "end": 415.92,
    "duration": 2.24
  },
  {
    "id": 98,
    "text": "另一方面，周萍的自私懦弱是将其推入深渊的直接导火索。",
    "start": 416.16,
    "end": 421.44,
    "duration": 5.28
  },
  {
    "id": 99,
    "text": "周萍始乱终弃，以所谓“悔过”为借口将一切罪责推伟给繁漪并仓皇逃避，",
    "start": 421.44,
    "end": 428.16,
    "duration": 6.72
  },
  {
    "id": 100,
    "text": "彻底击碎了繁漪赖以存活的情感支柱。",
    "start": 428.16,
    "end": 431.28,
    "duration": 3.12
  },
  {
    "id": 101,
    "text": "在无路可走的封建死局中，她的抗争只能演化为病态疯狂的自杀式爆发。",
    "start": 431.28,
    "end": 436.96,
    "duration": 5.68
  },
  {
    "id": 102,
    "text": "四、结尾收束升华段内部咬合。",
    "start": 437.36,
    "end": 440.64,
    "duration": 3.28
  },
  {
    "id": 103,
    "text": "本段承担全篇论证成果的系统提炼与历史定位，",
    "start": 440.64,
    "end": 444.96,
    "duration": 4.32
  },
  {
    "id": 104,
    "text": "收束在崇高悲剧力量上。",
    "start": 444.96,
    "end": 447.12,
    "duration": 2.16
  },
  {
    "id": 105,
    "text": "首先，全面回收五四追求个性解放女性的生命悲歌，",
    "start": 447.12,
    "end": 451.68,
    "duration": 4.56
  },
  {
    "id": 106,
    "text": "具体表述到答题语句就是：综上所述，",
    "start": 451.68,
    "end": 454.8,
    "duration": 3.12
  },
  {
    "id": 107,
    "text": "繁漪的悲剧是五四时期追求个性解放的叛逆女性在封建宗法黑网与懦弱男权夹击下的生命悲歌。",
    "start": 454.8,
    "end": 462.72,
    "duration": 7.92
  },
  {
    "id": 108,
    "text": "-紧接着，总结曹禺深沉悲敏与崇高悲剧力量的定论，",
    "start": 462.96,
    "end": 467.112,
    "duration": 4.152
  },
  {
    "id": 109,
    "text": "具体表述到答题语句就是：曹禺通过这一“雷雨式”的复杂灵魂，",
    "start": 467.112,
    "end": 472.055,
    "duration": 4.943
  },
  {
    "id": 110,
    "text": "深刻揭露了封建家庭对人性的残酷摧残，",
    "start": 472.055,
    "end": 475.417,
    "duration": 3.362
  },
  {
    "id": 111,
    "text": "展现了极具震撼力的崇高悲剧力量。",
    "start": 475.417,
    "end": 478.382,
    "duration": 2.965
  },
  {
    "id": 112,
    "text": "综上所述，繁漪的悲剧是五四时期追求个性解放的叛逆女性在封建宗法黑网与懦弱男权夹击下的生命悲歌。",
    "start": 478.382,
    "end": 487.28,
    "duration": 8.898
  },
  {
    "id": 113,
    "text": "曹禺通过这一“雷雨式”的复杂灵魂，",
    "start": 487.36,
    "end": 490.24,
    "duration": 2.88
  },
  {
    "id": 114,
    "text": "深刻揭露了封建家庭对人性的残酷摧残，",
    "start": 490.24,
    "end": 493.76,
    "duration": 3.52
  },
  {
    "id": 115,
    "text": "展现了极具震撼力的崇高悲剧力量。",
    "start": 493.76,
    "end": 496.4,
    "duration": 2.64
  }
]