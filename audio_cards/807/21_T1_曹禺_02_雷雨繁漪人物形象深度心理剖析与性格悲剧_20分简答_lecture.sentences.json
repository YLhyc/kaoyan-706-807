[
  {
    "id": 1,
    "text": "题目：结合曹禺《雷雨》具体戏剧冲突，",
    "start": 0.08,
    "end": 4.029,
    "duration": 3.949
  },
  {
    "id": 2,
    "text": "简析繁漪的复杂性格特征及其悲剧成因。。",
    "start": 4.029,
    "end": 7.697,
    "duration": 3.668
  },
  {
    "id": 3,
    "text": "蘩漪是曹禺话剧《雷雨》中性格烈度最高、",
    "start": 7.697,
    "end": 11.364,
    "duration": 3.667
  },
  {
    "id": 4,
    "text": "现代性最强的悲剧典型，",
    "start": 11.364,
    "end": 13.488,
    "duration": 2.124
  },
  {
    "id": 5,
    "text": "被作者誉为拥有“最‘雷雨’的性格”。",
    "start": 13.488,
    "end": 16.962,
    "duration": 3.474
  },
  {
    "id": 6,
    "text": "她是一个深受五四新思潮濡染却深锁于封建死屋、",
    "start": 16.962,
    "end": 21.209,
    "duration": 4.247
  },
  {
    "id": 7,
    "text": "兼具热烈生命渴望与残酷复仇意志的复杂复合体。",
    "start": 21.209,
    "end": 25.2,
    "duration": 3.991
  },
  {
    "id": 8,
    "text": "其性格特征与悲剧成因主要体现在以下四个维度：",
    "start": 25.2,
    "end": 29.92,
    "duration": 4.72
  },
  {
    "id": 9,
    "text": "第一，追求个性自主的原生性灵与决绝抗争。",
    "start": 29.92,
    "end": 34.16,
    "duration": 4.24
  },
  {
    "id": 10,
    "text": "蘩漪受过现代文明浸润，在周公馆沉闷窒息的宗法铁笼中，",
    "start": 34.24,
    "end": 39.28,
    "duration": 5.04
  },
  {
    "id": 11,
    "text": "保留了对爱情与独立生命的炽烈渴望。",
    "start": 39.28,
    "end": 41.52,
    "duration": 2.24
  },
  {
    "id": 12,
    "text": "面对周朴园封建家长制的极权专制，",
    "start": 41.52,
    "end": 44.56,
    "duration": 3.04
  },
  {
    "id": 13,
    "text": "她是全剧唯一敢于当面抗衡的叛逆者。",
    "start": 44.56,
    "end": 48.08,
    "duration": 3.52
  },
  {
    "id": 14,
    "text": "在“逼喝苦药”的标志性冲突中，",
    "start": 48.08,
    "end": 51.6,
    "duration": 3.52
  },
  {
    "id": 15,
    "text": "她从骨子里蔑视家长的伪善规训，即便被强行按着喝下苦汤，",
    "start": 51.68,
    "end": 58.32,
    "duration": 6.64
  },
  {
    "id": 16,
    "text": "其冷峻沉默依然展现出不愿屈从的傲骨。",
    "start": 58.32,
    "end": 61.92,
    "duration": 3.6
  },
  {
    "id": 17,
    "text": "第二，遭遇背弃后爱欲转化为报复的“雷雨式破坏力”。",
    "start": 61.92,
    "end": 66.48,
    "duration": 4.56
  },
  {
    "id": 18,
    "text": "蘩漪反抗伦理网罗将情感寄托于周萍，",
    "start": 66.48,
    "end": 69.36,
    "duration": 2.88
  },
  {
    "id": 19,
    "text": "本质是生命本能被极度压抑后的绝望寄托。",
    "start": 69.36,
    "end": 73.04,
    "duration": 3.68
  },
  {
    "id": 20,
    "text": "当周萍为了名声自私悔罪、企图抽身而走并转恋四凤时，",
    "start": 73.04,
    "end": 78.72,
    "duration": 5.68
  },
  {
    "id": 21,
    "text": "蘩漪最后的生存支柱彻底崩塌。",
    "start": 78.72,
    "end": 81.6,
    "duration": 2.88
  },
  {
    "id": 22,
    "text": "其炽烈的爱欲随即异化为同归于尽的复仇意志，",
    "start": 81.6,
    "end": 86.0,
    "duration": 4.4
  },
  {
    "id": 23,
    "text": "最终在雷雨交加之夜当众引爆两代人的血缘罪恶，",
    "start": 86.0,
    "end": 90.72,
    "duration": 4.72
  },
  {
    "id": 24,
    "text": "将周公馆的伪善撕得粉碎。",
    "start": 90.72,
    "end": 93.584,
    "duration": 2.864
  },
  {
    "id": 25,
    "text": "第三，封建宗法体制的专制扼杀（悲剧的制度根源）。",
    "start": 93.584,
    "end": 98.372,
    "duration": 4.788
  },
  {
    "id": 26,
    "text": "周朴园代表的封建资本家以家长特权构筑了窒息的生存死屋。",
    "start": 98.372,
    "end": 103.993,
    "duration": 5.621
  },
  {
    "id": 27,
    "text": "他为了维护家族体面，将个性鲜明的蘩漪污名化为“疯子”，",
    "start": 103.993,
    "end": 109.613,
    "duration": 5.62
  },
  {
    "id": 28,
    "text": "剥夺其作为正常人的话语权利，",
    "start": 109.613,
    "end": 112.527,
    "duration": 2.914
  },
  {
    "id": 29,
    "text": "并以服药就医进行人身监禁与精神虐杀，",
    "start": 112.527,
    "end": 116.48,
    "duration": 3.953
  },
  {
    "id": 30,
    "text": "彻底封死了女性合理的生存与出路。第四，",
    "start": 116.48,
    "end": 119.84,
    "duration": 3.36
  },
  {
    "id": 31,
    "text": "懦弱男权的自私背叛与个体抗争的孤立绝境（悲剧的直接成因）。",
    "start": 119.84,
    "end": 125.12,
    "duration": 5.28
  },
  {
    "id": 32,
    "text": "周萍虚伪怯懦、始乱终弃，将乱伦责任完全推诿给蘩漪，",
    "start": 125.12,
    "end": 129.44,
    "duration": 4.32
  },
  {
    "id": 33,
    "text": "使其在伦理与情感上陷入双重绝境。",
    "start": 129.44,
    "end": 132.24,
    "duration": 2.8
  },
  {
    "id": 34,
    "text": "在缺乏社会变革依托的前提下，",
    "start": 132.48,
    "end": 135.04,
    "duration": 2.56
  },
  {
    "id": 35,
    "text": "蘩漪脱离社会力量的孤立个人抗争，",
    "start": 135.04,
    "end": 138.48,
    "duration": 3.44
  },
  {
    "id": 36,
    "text": "注定蜕变为反噬自身的毁灭性狂飙。",
    "start": 138.48,
    "end": 141.6,
    "duration": 3.12
  },
  {
    "id": 37,
    "text": "综上所述，",
    "start": 141.6,
    "end": 142.32,
    "duration": 0.72
  },
  {
    "id": 38,
    "text": "蘩漪的悲剧是五四觉醒女性在封建宗法重压与懦弱男权夹击下的生命挽歌。",
    "start": 142.32,
    "end": 149.44,
    "duration": 7.12
  },
  {
    "id": 39,
    "text": "曹禺通过这一性格悲剧，",
    "start": 149.44,
    "end": 150.88,
    "duration": 1.44
  },
  {
    "id": 40,
    "text": "深刻批判了封建大家庭对人性的残酷摧残，",
    "start": 150.72,
    "end": 150.88,
    "duration": 0.16
  },
  {
    "id": 41,
    "text": "展现出动人心魄的现代悲剧力量。",
    "start": 150.72,
    "end": 150.88,
    "duration": 0.16
  }
]