[
  {
    "id": 1,
    "text": "题目：结合小说具体情节，从身份、",
    "start": 0.05,
    "end": 2.711,
    "duration": 2.661
  },
  {
    "id": 2,
    "text": "人生轨迹与性格流变三个维度分析祥子的人物形象及其悲剧成因。。",
    "start": 2.711,
    "end": 8.099,
    "duration": 5.388
  },
  {
    "id": 3,
    "text": "老舍的长篇小说代表作《骆驼祥子》，",
    "start": 8.099,
    "end": 11.302,
    "duration": 3.203
  },
  {
    "id": 4,
    "text": "是中国现代文学史上剖析城市底层平民命运最深刻的现实主义经典。",
    "start": 11.302,
    "end": 18.026,
    "duration": 6.724
  },
  {
    "id": 5,
    "text": "作品通过人力车夫祥子由“人”蜕变为“鬼”的沉沦轨迹，",
    "start": 18.026,
    "end": 22.281,
    "duration": 4.255
  },
  {
    "id": 6,
    "text": "宣告了近代底层劳动者依靠个人奋斗改变命运神话的彻底破灭。",
    "start": 22.281,
    "end": 27.627,
    "duration": 5.346
  },
  {
    "id": 7,
    "text": "其形象特征与悲剧成因主要体现在以下四个核心维度：",
    "start": 27.627,
    "end": 32.045,
    "duration": 4.418
  },
  {
    "id": 8,
    "text": "第一，身份属性：带有乡土美德与小农意识的城市新移民。",
    "start": 32.045,
    "end": 36.678,
    "duration": 4.633
  },
  {
    "id": 9,
    "text": "初入北平的祥子是一个来自破产农村的“乡村自然之子”。",
    "start": 36.678,
    "end": 40.904,
    "duration": 4.226
  },
  {
    "id": 10,
    "text": "他年轻健壮、勤劳本分、自尊要强，",
    "start": 40.904,
    "end": 44.11,
    "duration": 3.206
  },
  {
    "id": 11,
    "text": "将全部生命寄托于拥有一辆属于自己的洋车以自食其力；",
    "start": 44.11,
    "end": 48.592,
    "duration": 4.482
  },
  {
    "id": 12,
    "text": "但其骨子里深植着传统小农狭隘自私的个体奋斗哲学，",
    "start": 48.592,
    "end": 53.271,
    "duration": 4.679
  },
  {
    "id": 13,
    "text": "信奉凭力气吃饭、不问他人死活，",
    "start": 53.271,
    "end": 56.239,
    "duration": 2.968
  },
  {
    "id": 14,
    "text": "在生存方式上与工人阶级群体隔绝。",
    "start": 56.239,
    "end": 59.492,
    "duration": 3.253
  },
  {
    "id": 15,
    "text": "第二，人生轨迹：历经“三起三落”的物质掠夺与命运绞杀。",
    "start": 59.492,
    "end": 64.338,
    "duration": 4.846
  },
  {
    "id": 16,
    "text": "祥子的人生沉沦被严格结构在三次买车与失车的循环中：",
    "start": 64.338,
    "end": 69.096,
    "duration": 4.758
  },
  {
    "id": 17,
    "text": "苦熬三年买来的新车被军阀乱兵劫掠，是一落；",
    "start": 69.096,
    "end": 72.898,
    "duration": 3.802
  },
  {
    "id": 18,
    "text": "凭借卖骆驼拼命再攒的买车钱被反动特务孙侦探敲诈洗劫一空，",
    "start": 72.898,
    "end": 78.492,
    "duration": 5.594
  },
  {
    "id": 19,
    "text": "是二落；被迫与虎妞畸形结合后买下的二手车，",
    "start": 78.492,
    "end": 82.14,
    "duration": 3.648
  },
  {
    "id": 20,
    "text": "因虎妞难产母子双亡只得卖车办丧，是三落。",
    "start": 82.14,
    "end": 85.997,
    "duration": 3.857
  },
  {
    "id": 21,
    "text": "外部社会的三度掠夺，彻底封死了其诚实劳动的出路。",
    "start": 85.997,
    "end": 90.23,
    "duration": 4.233
  },
  {
    "id": 22,
    "text": "第三，性格变迁：",
    "start": 90.23,
    "end": 91.89,
    "duration": 1.66
  },
  {
    "id": 23,
    "text": "从积极自尊的模范车夫蜕变为麻木堕落的社会行尸。",
    "start": 91.89,
    "end": 96.753,
    "duration": 4.863
  },
  {
    "id": 24,
    "text": "在三度重创之后，",
    "start": 96.753,
    "end": 98.473,
    "duration": 1.72
  },
  {
    "id": 25,
    "text": "小福子在暗娼馆的自缢身亡切断了祥子与人性温情的最后纽带，",
    "start": 98.473,
    "end": 103.865,
    "duration": 5.392
  },
  {
    "id": 26,
    "text": "标志着其精神生命的彻底暴毙。",
    "start": 103.865,
    "end": 106.482,
    "duration": 2.617
  },
  {
    "id": 27,
    "text": "他从早先讲体面、厌恶烟酒的积极青年，彻底蜕化为吃喝嫖赌、",
    "start": 106.482,
    "end": 111.743,
    "duration": 5.261
  },
  {
    "id": 28,
    "text": "偷奸耍滑、靠出卖同伴阮明换取赏钱的城市流氓与行尸走肉，",
    "start": 111.743,
    "end": 117.335,
    "duration": 5.592
  },
  {
    "id": 29,
    "text": "展现了健全人性被黑暗旧社会剥蚀殆尽的残酷过程。",
    "start": 117.335,
    "end": 121.549,
    "duration": 4.214
  },
  {
    "id": 30,
    "text": "第四，悲剧成因：外部阶级压迫、",
    "start": 121.549,
    "end": 124.692,
    "duration": 3.143
  },
  {
    "id": 31,
    "text": "城市文明病腐蚀与孤立奋斗局限的必然结果。",
    "start": 124.692,
    "end": 128.197,
    "duration": 3.505
  },
  {
    "id": 32,
    "text": "祥子的毁灭是军阀特务横行、",
    "start": 128.197,
    "end": 130.726,
    "duration": 2.529
  },
  {
    "id": 33,
    "text": "刘四爷残酷剥削以及畸形商业城市欲望吞噬的合力产物；",
    "start": 130.726,
    "end": 135.329,
    "duration": 4.603
  },
  {
    "id": 34,
    "text": "老舍在篇尾将其定性为“个人主义的末路鬼”，",
    "start": 135.329,
    "end": 138.62,
    "duration": 3.291
  },
  {
    "id": 35,
    "text": "深刻揭示了在反动统治制度不倒的前提下，",
    "start": 138.62,
    "end": 142.064,
    "duration": 3.444
  },
  {
    "id": 36,
    "text": "脱离集体抗争的孤立个人奋斗注定粉身碎骨的历史真理。",
    "start": 142.064,
    "end": 146.489,
    "duration": 4.425
  },
  {
    "id": 37,
    "text": "综上所述，",
    "start": 146.489,
    "end": 147.549,
    "duration": 1.06
  },
  {
    "id": 38,
    "text": "祥子的悲剧是一个淳朴劳动者在旧体制绞杀下被毁灭的人性史诗，",
    "start": 147.549,
    "end": 153.703,
    "duration": 6.154
  },
  {
    "id": 39,
    "text": "老舍以此为黑暗旧时代敲响了沉痛的丧钟。",
    "start": 153.703,
    "end": 157.392,
    "duration": 3.689
  }
]