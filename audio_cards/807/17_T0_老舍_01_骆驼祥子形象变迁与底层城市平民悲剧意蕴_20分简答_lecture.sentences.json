[
  {
    "id": 1,
    "text": "题目：结合小说具体情节，从身份、人生轨迹与性格流变三个维度分析祥子的人物形象及其悲剧成因。",
    "start": 0.113,
    "end": 9.637,
    "duration": 9.524
  },
  {
    "id": 2,
    "text": "老舍的长篇小说《骆驼祥子》通过人力车夫祥子由“人”堕落为“鬼”的轨迹，",
    "start": 10.069,
    "end": 16.438,
    "duration": 6.369
  },
  {
    "id": 3,
    "text": "宣告了底层劳动者依靠孤立个人奋斗改变命运的幻灭。",
    "start": 16.754,
    "end": 21.419,
    "duration": 4.665
  },
  {
    "id": 4,
    "text": "其形象特征与悲剧成因主要体现于以下四个方面：",
    "start": 21.637,
    "end": 25.653,
    "duration": 4.016
  },
  {
    "id": 5,
    "text": "第一，身份属性：兼具乡土美德与小农意识的城市新移民。",
    "start": 26.258,
    "end": 31.309,
    "duration": 5.051
  },
  {
    "id": 6,
    "text": "初入北平的祥子出身破产农村，年轻健壮、勤劳要强，",
    "start": 31.857,
    "end": 36.29,
    "duration": 4.433
  },
  {
    "id": 7,
    "text": "将全部希望寄托于买一辆属于自己的洋车。",
    "start": 36.517,
    "end": 39.497,
    "duration": 2.98
  },
  {
    "id": 8,
    "text": "然而他身上保留着传统小农狭隘自私的个体哲学，",
    "start": 40.098,
    "end": 43.656,
    "duration": 3.558
  },
  {
    "id": 9,
    "text": "信奉只靠自己力气吃饭，既不信任同伴，也与有组织的群体相隔绝。",
    "start": 44.057,
    "end": 49.463,
    "duration": 5.406
  },
  {
    "id": 10,
    "text": "第二，人生轨迹：历经“三起三落”的物质掠夺与命运绞杀。",
    "start": 50.074,
    "end": 54.826,
    "duration": 4.752
  },
  {
    "id": 11,
    "text": "祥子的沉沦围绕三次买车与失车展开：苦熬三年攒钱买来的新车被乱兵抢走，是一落；",
    "start": 55.419,
    "end": 63.109,
    "duration": 7.69
  },
  {
    "id": 12,
    "text": "靠卖骆驼再攒的血汗钱被孙侦探敲诈一空，是二落；",
    "start": 63.714,
    "end": 68.224,
    "duration": 4.51
  },
  {
    "id": 13,
    "text": "被迫与虎妞结合后买下的车，因虎妞难产去世只得卖车办丧，是三落。",
    "start": 68.715,
    "end": 74.511,
    "duration": 5.796
  },
  {
    "id": 14,
    "text": "接连的掠夺与打击堵死了他诚实劳动的出路。",
    "start": 74.787,
    "end": 77.897,
    "duration": 3.11
  },
  {
    "id": 15,
    "text": "第三，性格流变：从自尊要强的车夫蜕变为麻木堕落的游民。",
    "start": 78.52,
    "end": 84.094,
    "duration": 5.574
  },
  {
    "id": 16,
    "text": "三落之后，小福子在暗娼馆自缢切断了祥子最后的精神寄托。",
    "start": 84.472,
    "end": 89.253,
    "duration": 4.781
  },
  {
    "id": 17,
    "text": "他从早先讲体面、不吸烟酒的纯朴青年，",
    "start": 89.596,
    "end": 92.868,
    "duration": 3.272
  },
  {
    "id": 18,
    "text": "堕落为吃喝嫖赌、偷奸耍滑、甚至出卖同伴阮明换取赏钱的市井流氓，",
    "start": 93.122,
    "end": 99.567,
    "duration": 6.445
  },
  {
    "id": 19,
    "text": "展现出健全人性被黑暗社会逐步剥蚀的过程。",
    "start": 99.81,
    "end": 103.516,
    "duration": 3.706
  },
  {
    "id": 20,
    "text": "第四，悲剧成因：社会压迫、都市腐蚀与个人奋斗局限的合力结果。",
    "start": 104.186,
    "end": 109.877,
    "duration": 5.691
  },
  {
    "id": 21,
    "text": "祥子的毁灭既是军阀乱兵、特务孙侦探与车厂主刘四爷等外部势力盘剥的产物，",
    "start": 110.328,
    "end": 116.841,
    "duration": 6.513
  },
  {
    "id": 22,
    "text": "也源于畸形都市生活对其道德防线的侵蚀。",
    "start": 117.127,
    "end": 120.527,
    "duration": 3.4
  },
  {
    "id": 23,
    "text": "老舍在结尾将其定性为“个人主义的末路鬼”，",
    "start": 120.527,
    "end": 124.1,
    "duration": 3.573
  },
  {
    "id": 24,
    "text": "揭示了在黑暗旧制度下脱离集体抗争的孤立奋斗终归失败。",
    "start": 124.344,
    "end": 129.497,
    "duration": 5.153
  },
  {
    "id": 25,
    "text": "掩卷而思，祥子的悲剧是一个淳朴劳动者在旧社会压迫下走向精神毁灭的写照，",
    "start": 130.166,
    "end": 137.697,
    "duration": 7.531
  },
  {
    "id": 26,
    "text": "蕴含着老舍对底层平民命运的深切悲悯与对旧制度的沉痛控诉。",
    "start": 138.081,
    "end": 143.155,
    "duration": 5.074
  }
]