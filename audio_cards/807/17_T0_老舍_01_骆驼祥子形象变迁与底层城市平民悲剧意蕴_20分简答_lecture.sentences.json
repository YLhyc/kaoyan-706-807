[
  {
    "id": 1,
    "text": "题目：结合小说具体情节，从身份、",
    "start": 0.08,
    "end": 4.16,
    "duration": 4.08
  },
  {
    "id": 2,
    "text": "人生轨迹与性格流变三个维度分析祥子的人物形象及其悲剧成因。。",
    "start": 4.16,
    "end": 9.84,
    "duration": 5.68
  },
  {
    "id": 3,
    "text": "老舍的长篇小说代表作《骆驼祥子》，",
    "start": 9.84,
    "end": 13.36,
    "duration": 3.52
  },
  {
    "id": 4,
    "text": "是中国现代文学史上剖析城市底层平民命运最深刻的现实主义经典。",
    "start": 13.36,
    "end": 19.2,
    "duration": 5.84
  },
  {
    "id": 5,
    "text": "作品通过人力车夫祥子由“人”蜕变为“鬼”的沉沦轨迹，",
    "start": 19.2,
    "end": 24.56,
    "duration": 5.36
  },
  {
    "id": 6,
    "text": "宣告了近代底层劳动者依靠个人奋斗改变命运神话的彻底破灭。",
    "start": 24.56,
    "end": 30.0,
    "duration": 5.44
  },
  {
    "id": 7,
    "text": "其形象特征与悲剧成因主要体现在以下四个核心维度：",
    "start": 30.0,
    "end": 34.8,
    "duration": 4.8
  },
  {
    "id": 8,
    "text": "第一，身份属性：带有乡土美德与小农意识的城市新移民。",
    "start": 34.8,
    "end": 39.44,
    "duration": 4.64
  },
  {
    "id": 9,
    "text": "初入北平的祥子是一个来自破产农村的“乡村自然之子”。",
    "start": 39.6,
    "end": 45.2,
    "duration": 5.6
  },
  {
    "id": 10,
    "text": "他年轻健壮、勤劳本分、自尊要强，",
    "start": 45.2,
    "end": 48.16,
    "duration": 2.96
  },
  {
    "id": 11,
    "text": "将全部生命寄托于拥有一辆属于自己的洋车以自食其力；",
    "start": 48.16,
    "end": 53.44,
    "duration": 5.28
  },
  {
    "id": 12,
    "text": "但其骨子里深植着传统小农狭隘自私的个体奋斗哲学，",
    "start": 53.44,
    "end": 58.48,
    "duration": 5.04
  },
  {
    "id": 13,
    "text": "信奉凭力气吃饭、不问他人死活，",
    "start": 58.48,
    "end": 61.84,
    "duration": 3.36
  },
  {
    "id": 14,
    "text": "在生存方式上与工人阶级群体隔绝。",
    "start": 61.84,
    "end": 65.28,
    "duration": 3.44
  },
  {
    "id": 15,
    "text": "第二，人生轨迹：历经“三起三落”的物质掠夺与命运绞杀。",
    "start": 65.28,
    "end": 70.32,
    "duration": 5.04
  },
  {
    "id": 16,
    "text": "祥子的人生沉沦被严格结构在三次买车与失车的循环中：",
    "start": 70.32,
    "end": 75.68,
    "duration": 5.36
  },
  {
    "id": 17,
    "text": "苦熬三年买来的新车被军阀乱兵劫掠，是一落；",
    "start": 75.68,
    "end": 80.08,
    "duration": 4.4
  },
  {
    "id": 18,
    "text": "凭借卖骆驼拼命再攒的买车钱被反动特务孙侦探敲诈洗劫一空，",
    "start": 80.08,
    "end": 85.44,
    "duration": 5.36
  },
  {
    "id": 19,
    "text": "是二落；被迫与虎妞畸形结合后买下的二手车，",
    "start": 85.44,
    "end": 89.6,
    "duration": 4.16
  },
  {
    "id": 20,
    "text": "因虎妞难产母子双亡只得卖车办丧，是三落。",
    "start": 89.6,
    "end": 94.32,
    "duration": 4.72
  },
  {
    "id": 21,
    "text": "外部社会的三度掠夺，彻底封死了其诚实劳动的出路。",
    "start": 94.32,
    "end": 99.76,
    "duration": 5.44
  },
  {
    "id": 22,
    "text": "第三，性格变迁：",
    "start": 99.76,
    "end": 101.36,
    "duration": 1.6
  },
  {
    "id": 23,
    "text": "从积极自尊的模范车夫蜕变为麻木堕落的社会行尸。",
    "start": 101.36,
    "end": 105.68,
    "duration": 4.32
  },
  {
    "id": 24,
    "text": "在三度重创之后，",
    "start": 105.68,
    "end": 107.52,
    "duration": 1.84
  },
  {
    "id": 25,
    "text": "小福子在暗娼馆的自缢身亡切断了祥子与人性温情的最后纽带，",
    "start": 107.52,
    "end": 113.76,
    "duration": 6.24
  },
  {
    "id": 26,
    "text": "标志着其精神生命的彻底暴毙。",
    "start": 113.76,
    "end": 116.4,
    "duration": 2.64
  },
  {
    "id": 27,
    "text": "他从早先讲体面、厌恶烟酒的积极青年，彻底蜕化为吃喝嫖赌、",
    "start": 116.4,
    "end": 122.48,
    "duration": 6.08
  },
  {
    "id": 28,
    "text": "偷奸耍滑、靠出卖同伴阮明换取赏钱的城市流氓与行尸走肉，",
    "start": 122.48,
    "end": 128.0,
    "duration": 5.52
  },
  {
    "id": 29,
    "text": "展现了健全人性被黑暗旧社会剥蚀殆尽的残酷过程。",
    "start": 128.24,
    "end": 132.72,
    "duration": 4.48
  },
  {
    "id": 30,
    "text": "第四，悲剧成因：外部阶级压迫、",
    "start": 132.72,
    "end": 135.28,
    "duration": 2.56
  },
  {
    "id": 31,
    "text": "城市文明病腐蚀与孤立奋斗局限的必然结果。",
    "start": 135.28,
    "end": 138.4,
    "duration": 3.12
  },
  {
    "id": 32,
    "text": "祥子的毁灭是军阀特务横行、",
    "start": 138.64,
    "end": 140.96,
    "duration": 2.32
  },
  {
    "id": 33,
    "text": "刘四爷残酷剥削以及畸形商业城市欲望吞噬的合力产物；",
    "start": 140.96,
    "end": 145.52,
    "duration": 4.56
  },
  {
    "id": 34,
    "text": "老舍在篇尾将其定性为“个人主义的末路鬼”，",
    "start": 145.52,
    "end": 150.056,
    "duration": 4.536
  },
  {
    "id": 35,
    "text": "深刻揭示了在反动统治制度不倒的前提下，",
    "start": 150.216,
    "end": 154.056,
    "duration": 3.84
  },
  {
    "id": 36,
    "text": "脱离集体抗争的孤立个人奋斗注定粉身碎骨的历史真理。",
    "start": 154.056,
    "end": 157.176,
    "duration": 3.12
  },
  {
    "id": 37,
    "text": "综上所述，",
    "start": 156.936,
    "end": 157.176,
    "duration": 0.24
  },
  {
    "id": 38,
    "text": "祥子的悲剧是一个淳朴劳动者在旧体制绞杀下被毁灭的人性史诗，",
    "start": 156.936,
    "end": 157.176,
    "duration": 0.24
  },
  {
    "id": 39,
    "text": "老舍以此为黑暗旧时代敲响了沉痛的丧钟。",
    "start": 156.936,
    "end": 157.176,
    "duration": 0.24
  }
]