[
  {
    "id": 1,
    "text": "本题是西华师大 807 在 2024 年考查的真题简答大题，分值为 20 分。",
    "start": 0.1,
    "end": 7.159,
    "duration": 7.059
  },
  {
    "id": 2,
    "text": "题目明确要求从“身份，人生轨迹，性格”等维度综合分析祥子形象。",
    "start": 7.109,
    "end": 13.88,
    "duration": 6.771
  },
  {
    "id": 3,
    "text": "考生必须在 20 分钟内，准确完成身份定性，三起三落轨迹，堕落蜕变心理与阶级成因四大任务。",
    "start": 13.88,
    "end": 22.669,
    "duration": 8.789
  },
  {
    "id": 4,
    "text": "简答题严禁长篇大论的历史背景反衬，必须“直入核心，分点立桩，嵌入证据”。",
    "start": 22.669,
    "end": 30.0,
    "duration": 7.331
  },
  {
    "id": 5,
    "text": "按照“乡村新移民身份 $\\rightarrow$ 三起三落沉浮轨迹 $\\rightarrow$ 由人变鬼的性格异化 $\\rightarrow$ 个人主义末路鬼成因总结”四步对称立桩，在 550—600 字内精准踩满全部采分点。",
    "start": 30.0,
    "end": 50.204,
    "duration": 20.204
  },
  {
    "id": 6,
    "text": "老舍的长篇小说代表作《骆驼祥子》，是中国现代文学史上剖析城市底层平民命运最深刻的现实主义经典。",
    "start": 50.204,
    "end": 59.905,
    "duration": 9.701
  },
  {
    "id": 7,
    "text": "作品通过人力车夫祥子由“人”蜕变为“鬼”的沉沦轨迹，宣告了近代底层劳动者依靠个人奋斗改变命运神话的彻底破灭。",
    "start": 59.905,
    "end": 70.504,
    "duration": 10.599
  },
  {
    "id": 8,
    "text": "其形象特征与悲剧成因主要体现在以下四个核心维度，",
    "start": 70.504,
    "end": 75.751,
    "duration": 5.247
  },
  {
    "id": 9,
    "text": "彻底免除公历年份，直接定性城市平民小说经典与个人奋斗神话破灭，引出四项采分点。",
    "start": 75.751,
    "end": 84.084,
    "duration": 8.333
  },
  {
    "id": 10,
    "text": "第一，身份属性，带有乡土美德与小农意识的城市新移民。",
    "start": 84.084,
    "end": 89.748,
    "duration": 5.664
  },
  {
    "id": 11,
    "text": "加粗动宾立桩，解析“乡村自然之子”的勤劳本分美德，同时点出小农狭隘自私孤立哲学的思想局限。",
    "start": 89.748,
    "end": 98.837,
    "duration": 9.089
  },
  {
    "id": 12,
    "text": "第二，人生轨迹，历经“三起三落”的物质掠夺与命运绞杀。",
    "start": 98.837,
    "end": 104.123,
    "duration": 5.286
  },
  {
    "id": 13,
    "text": "加粗动宾立桩，精准提炼三起三落细节（乱兵抢车，孙侦探敲诈，虎妞难产卖车办丧），做实外部掠夺。",
    "start": 104.123,
    "end": 114.136,
    "duration": 10.013
  },
  {
    "id": 14,
    "text": "第三，性格变迁，从积极自尊的模范车夫蜕变为麻木堕落的社会行尸。",
    "start": 114.136,
    "end": 120.751,
    "duration": 6.615
  },
  {
    "id": 15,
    "text": "加粗动宾立桩，调取小福子暗娼馆自缢切断最后纽带，展示吃喝嫖赌，出卖朋友阮明换赏钱的人性泯灭过程。",
    "start": 120.751,
    "end": 131.011,
    "duration": 10.26
  },
  {
    "id": 16,
    "text": "第四，悲剧成因，外部阶级压迫，城市文明病腐蚀与孤立奋斗局限的必然结果。",
    "start": 131.011,
    "end": 138.446,
    "duration": 7.435
  },
  {
    "id": 17,
    "text": "加粗动宾立桩，引用老舍“个人主义的末路鬼”权威定评，揭示单打独斗脱离社会变革的破灭必然性。",
    "start": 138.446,
    "end": 147.535,
    "duration": 9.089
  },
  {
    "id": 18,
    "text": "综上所述，祥子的悲剧是一个淳朴劳动者在旧体制绞杀下被毁灭的人性史诗，老舍以此为黑暗旧时代敲响了沉痛的丧钟。",
    "start": 147.535,
    "end": 159.306,
    "duration": 11.771
  },
  {
    "id": 19,
    "text": "精炼总结，升华旧时代丧钟的文学史定论。",
    "start": 159.306,
    "end": 163.316,
    "duration": 4.01
  }
]