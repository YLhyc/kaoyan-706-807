[
  {
    "id": 1,
    "text": "题目：结合小说具体情节，从身份、",
    "start": 0.0,
    "end": 3.643,
    "duration": 3.643
  },
  {
    "id": 2,
    "text": "人生轨迹与性格流变三个维度分析祥子的人物形象及其悲剧成因。。",
    "start": 3.643,
    "end": 9.495,
    "duration": 5.852
  },
  {
    "id": 3,
    "text": "老舍的长篇小说代表作《骆驼祥子》，",
    "start": 9.495,
    "end": 12.339,
    "duration": 2.844
  },
  {
    "id": 4,
    "text": "是中国现代文学史上剖析城市底层平民命运最深刻的现实主义经典。",
    "start": 12.339,
    "end": 18.056,
    "duration": 5.717
  },
  {
    "id": 5,
    "text": "作品通过人力车夫祥子由“人”蜕变为“鬼”的沉沦轨迹，",
    "start": 18.056,
    "end": 22.304,
    "duration": 4.248
  },
  {
    "id": 6,
    "text": "宣告了近代底层劳动者依靠个人奋斗改变命运神话的彻底破灭。",
    "start": 22.304,
    "end": 27.657,
    "duration": 5.353
  },
  {
    "id": 7,
    "text": "其形象特征与悲剧成因主要体现在以下四个核心维度：",
    "start": 27.657,
    "end": 32.074,
    "duration": 4.417
  },
  {
    "id": 8,
    "text": "第一，身份属性：带有乡土美德与小农意识的城市新移民。",
    "start": 32.074,
    "end": 36.708,
    "duration": 4.634
  },
  {
    "id": 9,
    "text": "初入北平的祥子是一个来自破产农村的“乡村自然之子”。",
    "start": 36.708,
    "end": 40.934,
    "duration": 4.226
  },
  {
    "id": 10,
    "text": "他年轻健壮、勤劳本分、自尊要强，",
    "start": 40.934,
    "end": 44.136,
    "duration": 3.202
  },
  {
    "id": 11,
    "text": "将全部生命寄托于拥有一辆属于自己的洋车以自食其力；",
    "start": 44.136,
    "end": 49.639,
    "duration": 5.503
  },
  {
    "id": 12,
    "text": "但其骨子里深植着传统小农狭隘自私的个体奋斗哲学，",
    "start": 49.639,
    "end": 56.266,
    "duration": 6.627
  },
  {
    "id": 13,
    "text": "信奉凭力气吃饭、不问他人死活，",
    "start": 56.266,
    "end": 59.522,
    "duration": 3.256
  },
  {
    "id": 14,
    "text": "在生存方式上与工人阶级群体隔绝。",
    "start": 59.522,
    "end": 63.113,
    "duration": 3.591
  },
  {
    "id": 15,
    "text": "第二，人生轨迹：历经“三起三落”的物质掠夺与命运绞杀。",
    "start": 63.113,
    "end": 69.126,
    "duration": 6.013
  },
  {
    "id": 16,
    "text": "祥子的人生沉沦被严格结构在三次买车与失车的循环中：",
    "start": 69.126,
    "end": 72.928,
    "duration": 3.802
  },
  {
    "id": 17,
    "text": "苦熬三年买来的新车被军阀乱兵劫掠，是一落；",
    "start": 72.928,
    "end": 79.3,
    "duration": 6.372
  },
  {
    "id": 18,
    "text": "凭借卖骆驼拼命再攒的买车钱被反动特务孙侦探敲诈洗劫一空，",
    "start": 79.3,
    "end": 82.17,
    "duration": 2.87
  },
  {
    "id": 19,
    "text": "是二落；被迫与虎妞畸形结合后买下的二手车，",
    "start": 82.17,
    "end": 86.026,
    "duration": 3.856
  },
  {
    "id": 20,
    "text": "因虎妞难产母子双亡只得卖车办丧，是三落。",
    "start": 86.026,
    "end": 90.939,
    "duration": 4.913
  },
  {
    "id": 21,
    "text": "外部社会的三度掠夺，彻底封死了其诚实劳动的出路。",
    "start": 90.939,
    "end": 96.783,
    "duration": 5.844
  },
  {
    "id": 22,
    "text": "第三，性格变迁：",
    "start": 96.783,
    "end": 98.503,
    "duration": 1.72
  },
  {
    "id": 23,
    "text": "从积极自尊的模范车夫蜕变为麻木堕落的社会行尸。",
    "start": 98.503,
    "end": 103.895,
    "duration": 5.392
  },
  {
    "id": 24,
    "text": "在三度重创之后，",
    "start": 103.895,
    "end": 106.512,
    "duration": 2.617
  },
  {
    "id": 25,
    "text": "小福子在暗娼馆的自缢身亡切断了祥子与人性温情的最后纽带，",
    "start": 106.512,
    "end": 109.821,
    "duration": 3.309
  },
  {
    "id": 26,
    "text": "标志着其精神生命的彻底暴毙。",
    "start": 109.821,
    "end": 112.793,
    "duration": 2.972
  },
  {
    "id": 27,
    "text": "他从早先讲体面、厌恶烟酒的积极青年，彻底蜕化为吃喝嫖赌、",
    "start": 112.793,
    "end": 117.365,
    "duration": 4.572
  },
  {
    "id": 28,
    "text": "偷奸耍滑、靠出卖同伴阮明换取赏钱的城市流氓与行尸走肉，",
    "start": 117.365,
    "end": 123.382,
    "duration": 6.017
  },
  {
    "id": 29,
    "text": "展现了健全人性被黑暗旧社会剥蚀殆尽的残酷过程。",
    "start": 123.382,
    "end": 128.227,
    "duration": 4.845
  },
  {
    "id": 30,
    "text": "第四，悲剧成因：外部阶级压迫、",
    "start": 128.227,
    "end": 135.358,
    "duration": 7.131
  },
  {
    "id": 31,
    "text": "城市文明病腐蚀与孤立奋斗局限的必然结果。",
    "start": 135.358,
    "end": 138.65,
    "duration": 3.292
  },
  {
    "id": 32,
    "text": "祥子的毁灭是军阀特务横行、",
    "start": 138.65,
    "end": 142.094,
    "duration": 3.444
  },
  {
    "id": 33,
    "text": "刘四爷残酷剥削以及畸形商业城市欲望吞噬的合力产物；",
    "start": 142.094,
    "end": 144.397,
    "duration": 2.303
  },
  {
    "id": 34,
    "text": "老舍在篇尾将其定性为“个人主义的末路鬼”，",
    "start": 144.397,
    "end": 146.519,
    "duration": 2.122
  },
  {
    "id": 35,
    "text": "深刻揭示了在反动统治制度不倒的前提下，",
    "start": 146.519,
    "end": 147.574,
    "duration": 1.055
  },
  {
    "id": 36,
    "text": "脱离集体抗争的孤立个人奋斗注定粉身碎骨的历史真理。",
    "start": 147.574,
    "end": 150.305,
    "duration": 2.731
  },
  {
    "id": 37,
    "text": "综上所述，",
    "start": 150.305,
    "end": 153.558,
    "duration": 3.253
  },
  {
    "id": 38,
    "text": "祥子的悲剧是一个淳朴劳动者在旧体制绞杀下被毁灭的人性史诗，",
    "start": 153.558,
    "end": 155.692,
    "duration": 2.134
  },
  {
    "id": 39,
    "text": "老舍以此为黑暗旧时代敲响了沉痛的丧钟。",
    "start": 155.692,
    "end": 157.169,
    "duration": 1.477
  }
]