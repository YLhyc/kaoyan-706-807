    "duration": 2.0
  },
  {
    "id": 117,
    "text": "辛笛在《风景》中描写列车窗外掠过的荒凉风景与车厢内的麻木众生。",
    "start": 489.688,
    "end": 495.048,
    "duration": 5.36
  },
  {
    "id": 118,
    "text": "诗人以冷眼旁观的蒙太奇剪辑手法，",
    "start": 495.448,
    "end": 498.488,
    "duration": 3.04
  },
  {
    "id": 119,
    "text": "构筑起平静表面下的深刻心理戏剧。",
    "start": 498.488,
    "end": 501.288,
    "duration": 2.8
  },
  {
    "id": 120,
    "text": "感官体验由此升华为严谨的现代智性结构。",
    "start": 501.288,
    "end": 504.968,
    "duration": 3.68
  },
  {
    "id": 121,
    "text": "第四支柱：玄学派智性与古典意境转化（穆旦、",
    "start": 504.968,
    "end": 508.888,
    "duration": 3.92
  },
  {
    "id": 122,
    "text": "陈敬容）。",
    "start": 508.888,
    "end": 509.528,
    "duration": 0.64
  },
  {
    "id": 123,
    "text": "论证推演逻辑：探入语言与思维本体。",
    "start": 509.528,
    "end": 512.648,
    "duration": 3.12
  },
  {
    "id": 124,
    "text": "阐释玄学派对九叶诗人的浸润，将抽象哲学化为肉体痛感。",
    "start": 512.648,
    "end": 517.448,
    "duration": 4.8
  },
  {
    "id": 125,
    "text": "以穆旦《诗八首》对肉身与灵魂撕裂的知性解剖为证。",
    "start": 517.688,
    "end": 522.088,
    "duration": 4.4
  },
  {
    "id": 126,
    "text": "同时指出其对晚唐古典传统的吸纳，",
    "start": 522.088,
    "end": 525.288,
    "duration": 3.2
  },
  {
    "id": 127,
    "text": "证明其并非全盘西化。",
    "start": 525.288,
    "end": 527.448,
    "duration": 2.16
  },
  {
    "id": 128,
    "text": "具体表述到答题语句就是：第四，融汇玄学派哲思追求与古典意境的现代转化。",
    "start": 527.448,
    "end": 534.552,
    "duration": 7.104
  },
  {
    "id": 129,
    "text": "九叶诗派追求现代诗的“智性化”。",
    "start": 534.552,
    "end": 537.512,
    "duration": 2.96
  },
  {
    "id": 130,
    "text": "他们吸收了十七世纪英国玄学派诗人约翰•多恩的手法，",
    "start": 537.512,
    "end": 542.232,
    "duration": 4.72
  },
  {
    "id": 131,
    "text": "善于将抽象的哲学玄想转化为可触可感的肉身痛觉。",
    "start": 542.232,
    "end": 547.032,
    "duration": 4.8
  },
  {
    "id": 132,
    "text": "穆旦在《诗八首》中探讨爱情时，将肉体的欢愉与灵魂的孤独、",
    "start": 547.032,
    "end": 552.312,
    "duration": 5.28
  },
  {
    "id": 133,
    "text": "虚无严密并置。",
    "start": 552.312,
    "end": 553.512,
    "duration": 1.2
  },
  {
    "id": 134,
    "text": "同时他们并不盲目全盘西化。",
    "start": 553.752,
    "end": 556.232,
    "duration": 2.48
  },
  {
    "id": 135,
    "text": "陈敬容与辛笛巧妙汲取晚唐诗风的冷艳蕴藉。",
    "start": 556.232,
    "end": 560.952,
    "duration": 4.72
  },
  {
    "id": 136,
    "text": "他们将中国古典诗歌的含蓄意境，成功化入现代主义的知性框架之中。",
    "start": 560.952,
    "end": 566.952,
    "duration": 6.0
  },
  {
    "id": 137,
    "text": "第四，融汇玄学派哲思追求与古典意境的现代转化。",
    "start": 566.952,
    "end": 571.992,
    "duration": 5.04
  },
  {
    "id": 138,
    "text": "九叶诗派追求现代诗的“智性化”。",
    "start": 571.992,
    "end": 574.552,
    "duration": 2.56
  },
  {
    "id": 139,
    "text": "他们吸收了十七世纪英国玄学派诗人约翰•多恩的手法，",
    "start": 574.872,
    "end": 579.512,
    "duration": 4.64
  },
  {
    "id": 140,
    "text": "善于将抽象的哲学玄想转化为可触可感的肉身痛觉。",
    "start": 579.512,
    "end": 584.232,
    "duration": 4.72
  },
  {
    "id": 141,
    "text": "穆旦在《诗八首》中探讨爱情时，将肉体的欢愉与灵魂的孤独、",
    "start": 584.232,
    "end": 589.672,
    "duration": 5.44
  },
  {
    "id": 142,
    "text": "虚无严密并置。",
    "start": 589.672,
    "end": 591.032,
    "duration": 1.36
  },
  {
    "id": 143,
    "text": "同时他们并不盲目全盘西化。",
    "start": 591.032,
    "end": 593.672,
    "duration": 2.64
  },
  {
    "id": 144,
    "text": "陈敬容与辛笛巧妙汲取晚唐诗风的冷艳蕴藉。",
    "start": 593.672,
    "end": 597.592,
    "duration": 3.92
  },
  {
    "id": 145,
    "text": "他们将中国古典诗歌的含蓄意境，成功化入现代主义的知性框架之中。",
    "start": 597.832,
    "end": 603.592,
    "duration": 5.76
  },
  {
    "id": 146,
    "text": "总结升华段：文学史地位与历史回响。",
    "start": 603.592,
    "end": 607.192,
    "duration": 3.6
  },
  {
    "id": 147,
    "text": "论证推演逻辑：宏观文学史定性。",
    "start": 607.192,
    "end": 610.392,
    "duration": 3.2
  },
  {
    "id": 148,
    "text": "九叶诗派解决了新文学“思想深刻”与“形式现代”的二元对立，",
    "start": 610.392,
    "end": 615.912,
    "duration": 5.52
  },
  {
    "id": 149,
    "text": "摆脱了早期新诗的幼稚粗糙，并构成了八十年代朦胧诗与现代派崛起的先声。",
    "start": 615.912,
    "end": 622.312,
    "duration": 6.4
  },
  {
    "id": 150,
    "text": "具体表述到答题语句就是：九叶诗派在战火硝烟与社会转型的大裂变时代，",
    "start": 622.632,
    "end": 629.192,
    "duration": 6.56
  },
  {
    "id": 151,
    "text": "成功探索出一条既具有深沉现实批判力，",
    "start": 629.192,
    "end": 632.952,
    "duration": 3.76
  },
  {
    "id": 152,
    "text": "又具备现代美学高度的中国新诗之路。",
    "start": 632.952,
    "end": 636.472,
    "duration": 3.52
  },
  {
    "id": 153,
    "text": "他们对现实与现代主义的成功化合，",
    "start": 636.472,
    "end": 639.352,
    "duration": 2.88
  },
  {
    "id": 154,
    "text": "不仅终结了新文学初期诗艺幼稚的局面，",
    "start": 639.352,
    "end": 642.792,
    "duration": 3.44
  },
  {
    "id": 155,
    "text": "更为八十年代新时期诗歌的美学崛起，",
    "start": 642.792,
    "end": 645.752,
    "duration": 2.96
  },
  {
    "id": 156,
    "text": "提供了极其宝贵的先锋谱系与历史经验。",
    "start": 645.752,
    "end": 649.352,
    "duration": 3.6
  },
  {
    "id": 157,
    "text": "九叶诗派在战火硝烟与社会转型的大裂变时代，",
    "start": 649.672,
    "end": 653.912,
    "duration": 4.24
  },
  {
    "id": 158,
    "text": "成功探索出一条既具有深沉现实批判力，",
    "start": 653.912,
    "end": 657.512,
    "duration": 3.6
  },
  {
    "id": 159,
    "text": "又具备现代美学高度的中国新诗之路。",
    "start": 657.512,
    "end": 660.872,
    "duration": 3.36
  },
  {
    "id": 160,
    "text": "他们对现实与现代主义的成功化合，",
    "start": 660.872,
    "end": 663.672,
    "duration": 2.8
  },
  {
    "id": 161,
    "text": "不仅终结了新文学初期诗艺幼稚的局面，",
    "start": 663.672,
    "end": 666.792,
    "duration": 3.12
  },
  {
    "id": 162,
    "text": "更为八十年代新时期诗歌的美学崛起，",
    "start": 666.792,
