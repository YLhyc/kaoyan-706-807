[
  {
    "id": 1,
    "text": "一、宏观结构推演与采分点映射。",
    "start": 0.16,
    "end": 2.96,
    "duration": 2.8
  },
  {
    "id": 2,
    "text": "本题标准分为三十分，论述结构采用高分“破题定性，",
    "start": 2.96,
    "end": 7.52,
    "duration": 4.56
  },
  {
    "id": 3,
    "text": "四大机制支柱展开，历史价值收束”逻辑模型：一、",
    "start": 7.52,
    "end": 11.68,
    "duration": 4.16
  },
  {
    "id": 4,
    "text": "破题总论层（约一百五十字）：准确交代流派名称（九叶诗派、",
    "start": 11.68,
    "end": 16.64,
    "duration": 4.96
  },
  {
    "id": 5,
    "text": "中国新诗派）、时空阵营（四十年代后期国统区、",
    "start": 16.64,
    "end": 20.72,
    "duration": 4.08
  },
  {
    "id": 6,
    "text": "《诗创造》《中国新诗》）、核心代表（穆旦、",
    "start": 20.72,
    "end": 24.16,
    "duration": 3.44
  },
  {
    "id": 7,
    "text": "辛笛、陈敬容、杜运燮、郑敏）、核心纲领（现实主义批判与现代主义技法深度化合）。",
    "start": 24.16,
    "end": 30.56,
    "duration": 6.4
  },
  {
    "id": 8,
    "text": "二、第一支柱：思想维度•介入现实与知识分子反省（穆旦）：采分点为扎根民族苦难、",
    "start": 30.88,
    "end": 38.4,
    "duration": 7.52
  },
  {
    "id": 9,
    "text": "反思自我精神、知性审判力量（《赞美》《隐现》）。",
    "start": 38.4,
    "end": 42.88,
    "duration": 4.48
  },
  {
    "id": 10,
    "text": "三、第二支柱：意象艺术•英美现代派吸纳与复合意象（杜运燮、",
    "start": 42.88,
    "end": 48.48,
    "duration": 5.6
  },
  {
    "id": 11,
    "text": "郑敏）：采分点为借鉴艾略特奥登、",
    "start": 48.48,
    "end": 51.76,
    "duration": 3.28
  },
  {
    "id": 12,
    "text": "反讽悖论象征、意象张力（《滇缅公路》《金黄的稻束》）。",
    "start": 51.76,
    "end": 55.76,
    "duration": 4.0
  },
  {
    "id": 13,
    "text": "四、第三支柱：结构特征•诗的戏剧化与情感距离（辛笛）：采分点为反滥情、",
    "start": 56.08,
    "end": 63.28,
    "duration": 7.2
  },
  {
    "id": 14,
    "text": "客观对应物、声调冲突、蒙太奇剪辑与心理戏剧（《风景》）。",
    "start": 63.28,
    "end": 68.08,
    "duration": 4.8
  },
  {
    "id": 15,
    "text": "五、第四支柱：语言哲学•玄学派知性与古典转化（穆旦、",
    "start": 68.08,
    "end": 73.2,
    "duration": 5.12
  },
  {
    "id": 16,
    "text": "陈敬容）：采分点为思想知性化、肉身感官与深层哲思并置（《诗八首》）、",
    "start": 73.2,
    "end": 79.52,
    "duration": 6.32
  },
  {
    "id": 17,
    "text": "晚唐古典意境吸纳。",
    "start": 79.52,
    "end": 80.96,
    "duration": 1.44
  },
  {
    "id": 18,
    "text": "六、总结提升层（约一百五十字）：文学史评价、",
    "start": 81.2,
    "end": 85.36,
    "duration": 4.16
  },
  {
    "id": 19,
    "text": "克服新诗幼稚病、连接四十年代与八十年代新诗现代化的桥梁。",
    "start": 85.36,
    "end": 90.88,
    "duration": 5.52
  },
  {
    "id": 20,
    "text": "二、逐段内部咬合与考场得分句推导。",
    "start": 90.88,
    "end": 94.64,
    "duration": 3.76
  },
  {
    "id": 21,
    "text": "破题段：流派定性与结合纲领。",
    "start": 94.64,
    "end": 97.44,
    "duration": 2.8
  },
  {
    "id": 22,
    "text": "论证推演逻辑：必须准确交代九叶诗派的正式学名与时代坐标。",
    "start": 97.44,
    "end": 102.72,
    "duration": 5.28
  },
  {
    "id": 23,
    "text": "明确指出他们受西方现代派影响，同时身处国统区大动荡中。",
    "start": 102.96,
    "end": 108.16,
    "duration": 5.2
  },
  {
    "id": 24,
    "text": "引出他们反政治口号又反象牙塔的“两面开战”立场，",
    "start": 108.16,
    "end": 112.8,
    "duration": 4.64
  },
  {
    "id": 25,
    "text": "点出“现实主义与现代主义结合”这一答题总纲。",
    "start": 112.8,
    "end": 116.48,
    "duration": 3.68
  },
  {
    "id": 26,
    "text": "具体表述到答题语句就是：二十世纪四十年代后期在国统区崛起的“九叶诗派”，",
    "start": 116.48,
    "end": 123.264,
    "duration": 6.784
  },
  {
    "id": 27,
    "text": "又称“中国新诗派”，是中国现代新诗走向成熟的重要里程碑。",
    "start": 123.264,
    "end": 128.464,
    "duration": 5.2
  },
  {
    "id": 28,
    "text": "以穆旦、辛笛、陈敬容、杜运燮、郑敏等九位诗人为代表，",
    "start": 128.464,
    "end": 133.504,
    "duration": 5.04
  },
  {
    "id": 29,
    "text": "他们依托《诗创造》与《中国新诗》杂志集结。",
    "start": 133.504,
    "end": 136.784,
    "duration": 3.28
  },
  {
    "id": 30,
    "text": "这群诗人大多受过良好的英美现代文学熏陶。",
    "start": 136.784,
    "end": 140.064,
    "duration": 3.28
  },
  {
    "id": 31,
    "text": "面对国统区腐朽反动的黑暗现实，他们既不满于浅薄直白的政治宣传口号，",
    "start": 140.384,
    "end": 146.864,
    "duration": 6.48
  },
  {
    "id": 32,
    "text": "也拒绝脱离时代的纯形式象牙塔。",
    "start": 146.864,
    "end": 149.744,
    "duration": 2.88
  },
  {
    "id": 33,
    "text": "九叶诗人开创性地提出了将现实主义的批判精神与现代主义的艺术手法深度交融的诗学纲领。",
    "start": 149.744,
    "end": 157.184,
    "duration": 7.44
  },
  {
    "id": 34,
    "text": "这场深刻的美学探索体现在四个核心维度。",
    "start": 157.184,
    "end": 160.384,
    "duration": 3.2
  },
  {
    "id": 35,
    "text": "二十世纪四十年代后期在国统区崛起的“九叶诗派”，",
    "start": 160.704,
    "end": 165.184,
    "duration": 4.48
  },
  {
    "id": 36,
    "text": "又称“中国新诗派”，是中国现代新诗走向成熟的重要里程碑。",
    "start": 165.184,
    "end": 170.384,
    "duration": 5.2
  },
  {
    "id": 37,
    "text": "以穆旦、辛笛、陈敬容、杜运燮、郑敏等九位诗人为代表，",
    "start": 170.384,
    "end": 175.424,
    "duration": 5.04
  },
  {
    "id": 38,
    "text": "他们依托《诗创造》与《中国新诗》杂志集结。",
    "start": 175.424,
    "end": 178.704,
    "duration": 3.28
  },
  {
    "id": 39,
    "text": "这群诗人大多受过良好的英美现代文学熏陶。",
    "start": 178.704,
    "end": 181.984,
    "duration": 3.28
  },
  {
    "id": 40,
    "text": "面对国统区腐朽反动的黑暗现实，他们既不满于浅薄直白的政治宣传口号，",
    "start": 182.304,
    "end": 188.784,
    "duration": 6.48
  },
  {
    "id": 41,
    "text": "也拒绝脱离时代的纯形式象牙塔。",
    "start": 188.784,
    "end": 191.664,
    "duration": 2.88
  },
  {
    "id": 42,
    "text": "九叶诗人开创性地提出了将现实主义的批判精神与现代主义的艺术手法深度交融的诗学纲领。",
    "start": 191.664,
    "end": 199.104,
    "duration": 7.44
  },
  {
    "id": 43,
    "text": "这场深刻的美学探索体现在四个核心维度。",
    "start": 199.104,
    "end": 202.304,
    "duration": 3.2
  },
  {
    "id": 44,
    "text": "第一支柱：现实介入与知识分子反省机制（穆旦）。",
    "start": 202.624,
    "end": 206.784,
    "duration": 4.16
  },
  {
    "id": 45,
    "text": "论证推演逻辑：展开第一个支柱：现实主义面向。",
    "start": 206.784,
    "end": 211.104,
    "duration": 4.32
  },
  {
    "id": 46,
    "text": "九叶不是躲在书斋里的现代派，他们直面民族受难。",
    "start": 211.104,
    "end": 215.184,
    "duration": 4.08
  },
  {
    "id": 47,
    "text": "以穆旦《赞美》中对人民受难肉体的关切为证。",
    "start": 215.184,
    "end": 218.784,
    "duration": 3.6
  },
  {
    "id": 48,
    "text": "更关键的是结合知识分子自我反思，",
    "start": 218.784,
    "end": 221.824,
    "duration": 3.04
  },
  {
    "id": 49,
    "text": "结合《隐现》，阐明其现实主义带有知性反省深度。",
    "start": 221.824,
    "end": 225.744,
    "duration": 3.92
  },
  {
    "id": 50,
    "text": "-具体表述到答题语句就是：第一，",
    "start": 225.904,
    "end": 228.515,
    "duration": 2.611
  },
  {
    "id": 51,
    "text": "时代苦难介入与知识分子反省机制的深度咬合。",
    "start": 228.515,
    "end": 232.531,
    "duration": 4.016
  },
  {
    "id": 52,
    "text": "九叶诗派彻底超越了浪漫主义的个人感伤。",
    "start": 232.531,
    "end": 236.146,
    "duration": 3.615
  },
  {
    "id": 53,
    "text": "他们将诗歌根须深扎于抗日战争与内战的现实土壤。",
    "start": 236.146,
    "end": 240.564,
    "duration": 4.418
  },
  {
    "id": 54,
    "text": "穆旦在《赞美》中倾诉着对农夫泥土般的受难肉体的博大敬意。",
    "start": 240.564,
    "end": 245.584,
    "duration": 5.02
  },
  {
    "id": 55,
    "text": "但在书写苦难时，他们拒绝单一的道德控诉。",
    "start": 245.664,
    "end": 249.664,
    "duration": 4.0
  },
  {
    "id": 56,
    "text": "诗人把自我作为现代知识分子的一员置于审判台前。",
    "start": 249.664,
    "end": 254.224,
    "duration": 4.56
  },
  {
    "id": 57,
    "text": "穆旦在《隐现》中无情剖析自我精神的游移与软弱。",
    "start": 254.224,
    "end": 258.624,
    "duration": 4.4
  },
  {
    "id": 58,
    "text": "这种将时代苦难与知识分子心理反省相交织的知性深度，",
    "start": 258.624,
    "end": 263.664,
    "duration": 5.04
  },
  {
    "id": 59,
    "text": "赋予诗作严峻的现代批判力量。",
    "start": 263.664,
    "end": 266.064,
    "duration": 2.4
  },
  {
    "id": 60,
    "text": "第一，时代苦难介入与知识分子反省机制的深度咬合。",
    "start": 266.36,
    "end": 271.64,
    "duration": 5.28
  },
  {
    "id": 61,
    "text": "九叶诗派彻底超越了浪漫主义的个人感伤。",
    "start": 271.64,
    "end": 275.32,
    "duration": 3.68
  },
  {
    "id": 62,
    "text": "他们将诗歌根须深扎于抗日战争与内战的现实土壤。",
    "start": 275.32,
    "end": 279.96,
    "duration": 4.64
  },
  {
    "id": 63,
    "text": "穆旦在《赞美》中倾诉着对农夫泥土般的受难肉体的博大敬意。",
    "start": 279.96,
    "end": 285.0,
    "duration": 5.04
  },
  {
    "id": 64,
    "text": "但在书写苦难时，他们拒绝单一的道德控诉。",
    "start": 285.0,
    "end": 288.44,
    "duration": 3.44
  },
  {
    "id": 65,
    "text": "诗人把自我作为现代知识分子的一员置于审判台前。",
    "start": 288.76,
    "end": 293.48,
    "duration": 4.72
  },
  {
    "id": 66,
    "text": "穆旦在《隐现》中无情剖析自我精神的游移与软弱。",
    "start": 293.48,
    "end": 298.04,
    "duration": 4.56
  },
  {
    "id": 67,
    "text": "这种将时代苦难与知识分子心理反省相交织的知性深度，",
    "start": 298.04,
    "end": 302.92,
    "duration": 4.88
  },
  {
    "id": 68,
    "text": "赋予诗作严峻的现代批判力量。",
    "start": 302.92,
    "end": 305.56,
    "duration": 2.64
  },
  {
    "id": 69,
    "text": "第二支柱：英美现代派吸纳与意象复合（杜运燮、",
    "start": 305.56,
    "end": 310.28,
    "duration": 4.72
  },
  {
    "id": 70,
    "text": "郑敏）。",
    "start": 310.28,
    "end": 310.68,
    "duration": 0.4
  },
  {
    "id": 71,
    "text": "-论证推演逻辑：展开现代主义的艺术表现支柱。",
    "start": 310.84,
    "end": 314.963,
    "duration": 4.123
  },
  {
    "id": 72,
    "text": "重点剖析意象机制。",
    "start": 314.963,
    "end": 316.699,
    "duration": 1.736
  },
  {
    "id": 73,
    "text": "引入艾略特与奥登的现代诗艺，结合杜运燮《滇缅公路》的长蛇比喻与机械对抗，",
    "start": 316.699,
    "end": 323.644,
    "duration": 6.945
  },
  {
    "id": 74,
    "text": "以及郑敏《金黄的稻束》的静穆哲理，",
    "start": 323.644,
    "end": 326.682,
    "duration": 3.038
  },
  {
    "id": 75,
    "text": "论述复合意象对直抒胸臆的超越。",
    "start": 326.682,
    "end": 329.72,
    "duration": 3.038
  },
  {
    "id": 76,
    "text": "-具体表述到答题语句就是：第二，",
    "start": 329.72,
    "end": 332.628,
    "duration": 2.908
  },
  {
    "id": 77,
    "text": "借鉴英美现代主义营构复杂的诗歌意象体系。",
    "start": 332.628,
    "end": 336.877,
    "duration": 4.249
  },
  {
    "id": 78,
    "text": "九叶诗人系统吸纳了艾略特、奥登以及里尔克的现代诗艺。",
    "start": 336.877,
    "end": 342.245,
    "duration": 5.368
  },
  {
    "id": 79,
    "text": "他们彻底告别了早期新诗单一透明的直抒胸臆。",
    "start": 342.245,
    "end": 346.718,
    "duration": 4.473
  },
  {
    "id": 80,
    "text": "诗作大量运用反讽、悖论、象征与复合意象。",
    "start": 346.718,
    "end": 350.52,
    "duration": 3.802
  },
  {
    "id": 81,
    "text": "杜运燮在《滇缅公路》中把公路比喻为翻滚的长蛇。",
    "start": 350.6,
    "end": 355.24,
    "duration": 4.64
  },
  {
    "id": 82,
    "text": "现代文明的机械暴力与原始自然在此激烈碰撞。",
    "start": 355.24,
    "end": 359.48,
    "duration": 4.24
  },
  {
    "id": 83,
    "text": "郑敏在《金黄的稻束》中借静穆的稻田意象，",
    "start": 359.48,
    "end": 363.0,
    "duration": 3.52
  },
  {
    "id": 84,
    "text": "沉思劳动、生命与死亡的深沉哲思。",
    "start": 363.0,
    "end": 366.44,
    "duration": 3.44
  },
  {
    "id": 85,
    "text": "繁复的意象网络极大地拓展了现代汉语的审美表现力。",
    "start": 366.44,
    "end": 370.52,
    "duration": 4.08
  },
  {
    "id": 86,
    "text": "第二，借鉴英美现代主义营构复杂的诗歌意象体系。",
    "start": 370.68,
    "end": 375.0,
    "duration": 4.32
  },
  {
    "id": 87,
    "text": "九叶诗人系统吸纳了艾略特、奥登以及里尔克的现代诗艺。",
    "start": 375.0,
    "end": 379.8,
    "duration": 4.8
  },
  {
    "id": 88,
    "text": "他们彻底告别了早期新诗单一透明的直抒胸臆。",
    "start": 379.8,
    "end": 383.72,
    "duration": 3.92
  },
  {
    "id": 89,
    "text": "诗作大量运用反讽、悖论、象征与复合意象。",
    "start": 383.72,
    "end": 387.56,
    "duration": 3.84
  },
  {
    "id": 90,
    "text": "杜运燮在《滇缅公路》中把公路比喻为翻滚的长蛇。",
    "start": 387.56,
    "end": 391.4,
    "duration": 3.84
  },
  {
    "id": 91,
    "text": "现代文明的机械暴力与原始自然在此激烈碰撞。",
    "start": 391.8,
    "end": 395.96,
    "duration": 4.16
  },
  {
    "id": 92,
    "text": "郑敏在《金黄的稻束》中借静穆的稻田意象，",
    "start": 395.96,
    "end": 399.56,
    "duration": 3.6
  },
  {
    "id": 93,
    "text": "沉思劳动、生命与死亡的深沉哲思。",
    "start": 399.56,
    "end": 403.0,
    "duration": 3.44
  },
  {
    "id": 94,
    "text": "繁复的意象网络极大地拓展了现代汉语的审美表现力。",
    "start": 403.0,
    "end": 407.08,
    "duration": 4.08
  },
  {
    "id": 95,
    "text": "第三支柱：克服主观滥情与诗的戏剧化结构（辛笛）。",
    "start": 407.08,
    "end": 412.12,
    "duration": 5.04
  },
  {
    "id": 96,
    "text": "论证推演逻辑：分析九叶诗派在诗歌结构形式上的重大突破，",
    "start": 412.12,
    "end": 417.208,
    "duration": 5.088
  },
  {
    "id": 97,
    "text": "即诗歌的戏剧化手法。",
    "start": 417.208,
    "end": 419.288,
    "duration": 2.08
  },
  {
    "id": 98,
    "text": "诗歌不再是单向抒情，而是创造情感距离与客观场景。",
    "start": 419.288,
    "end": 423.928,
    "duration": 4.64
  },
  {
    "id": 99,
    "text": "以辛笛《风景》的列车车窗视角为例，",
    "start": 423.928,
    "end": 426.888,
    "duration": 2.96
  },
  {
    "id": 100,
    "text": "论述蒙太奇与心理冲突，展示理性建构力量。",
    "start": 426.888,
    "end": 431.128,
    "duration": 4.24
  },
  {
    "id": 101,
    "text": "具体表述到答题语句就是：第三，克服主观滥情并确立现代诗的“戏剧化”结构。",
    "start": 431.128,
    "end": 437.928,
    "duration": 6.8
  },
  {
    "id": 102,
    "text": "九叶诗人自觉倡导诗歌的客观化与戏剧化原则。",
    "start": 437.928,
    "end": 441.848,
    "duration": 3.92
  },
  {
    "id": 103,
    "text": "他们刻意拉开诗人与抒情主人公的情感距离，",
    "start": 441.848,
    "end": 445.608,
    "duration": 3.76
  },
  {
    "id": 104,
    "text": "反对宣泄式的口号呐喊。",
    "start": 445.608,
    "end": 447.768,
    "duration": 2.16
  },
  {
    "id": 105,
    "text": "诗人常常把多重互相冲突的声调、视角与观念，",
    "start": 447.768,
    "end": 451.688,
    "duration": 3.92
  },
  {
    "id": 106,
    "text": "置入同一个诗歌文本中。",
    "start": 451.688,
    "end": 453.288,
    "duration": 1.6
  },
  {
    "id": 107,
    "text": "辛笛在《风景》中描写列车窗外掠过的荒凉风景与车厢内的麻木众生。",
    "start": 453.688,
    "end": 459.608,
    "duration": 5.92
  },
  {
    "id": 108,
    "text": "诗人以冷眼旁观的蒙太奇剪辑手法，",
    "start": 459.608,
    "end": 462.408,
    "duration": 2.8
  },
  {
    "id": 109,
    "text": "构筑起平静表面下的深刻心理戏剧。",
    "start": 462.408,
    "end": 465.288,
    "duration": 2.88
  },
  {
    "id": 110,
    "text": "感官体验由此升华为严谨的现代智性结构。",
    "start": 465.288,
    "end": 469.208,
    "duration": 3.92
  },
  {
    "id": 111,
    "text": "第三，克服主观滥情并确立现代诗的“戏剧化”结构。",
    "start": 469.208,
    "end": 473.208,
    "duration": 4.0
  },
  {
    "id": 112,
    "text": "九叶诗人自觉倡导诗歌的客观化与戏剧化原则。",
    "start": 473.528,
    "end": 477.608,
    "duration": 4.08
  },
  {
    "id": 113,
    "text": "他们刻意拉开诗人与抒情主人公的情感距离，",
    "start": 477.608,
    "end": 481.448,
    "duration": 3.84
  },
  {
    "id": 114,
    "text": "反对宣泄式的口号呐喊。",
    "start": 481.448,
    "end": 483.848,
    "duration": 2.4
  },
  {
    "id": 115,
    "text": "诗人常常把多重互相冲突的声调、视角与观念，",
    "start": 483.848,
    "end": 487.688,
    "duration": 3.84
  },
  {
    "id": 116,
    "text": "置入同一个诗歌文本中。",
    "start": 487.688,
