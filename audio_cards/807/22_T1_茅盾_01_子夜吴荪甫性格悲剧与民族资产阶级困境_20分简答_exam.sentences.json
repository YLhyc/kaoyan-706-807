[
  {
    "id": 1,
    "text": "三十年代初，茅盾的长篇巨著《子夜》确立了现代文学社会剖析小说的典范。",
    "start": 0.107,
    "end": 5.916,
    "duration": 5.809
  },
  {
    "id": 2,
    "text": "主人公吴荪甫是中国现代文学史上塑造最为丰满的民族资产阶级典型，",
    "start": 6.202,
    "end": 11.961,
    "duration": 5.759
  },
  {
    "id": 3,
    "text": "其性格特征与悲剧成因主要展现于以下三个层面：",
    "start": 12.299,
    "end": 16.156,
    "duration": 3.857
  },
  {
    "id": 4,
    "text": "第一，怀抱“实业救国”宏图，具备现代企业家的果断魄力。",
    "start": 16.797,
    "end": 21.772,
    "duration": 4.975
  },
  {
    "id": 5,
    "text": "吴荪甫不同于传统买办与封建遗老，他曾游历欧美、通晓现代管理，",
    "start": 22.29,
    "end": 27.514,
    "duration": 5.224
  },
  {
    "id": 6,
    "text": "怀揣发展民族工业、抵制外资倾销的抱负。",
    "start": 27.965,
    "end": 31.016,
    "duration": 3.051
  },
  {
    "id": 7,
    "text": "他苦心经营裕华丝厂，并与同业合组益中信托公司，一举兼并八个小型民族工业厂，",
    "start": 31.469,
    "end": 38.274,
    "duration": 6.805
  },
  {
    "id": 8,
    "text": "企图建立独立自主的工业王国，",
    "start": 38.651,
    "end": 40.896,
    "duration": 2.245
  },
  {
    "id": 9,
    "text": "在商场博弈中展现出茅盾所称“二十世纪机械工业时代的英雄、骑士和王子”般的刚毅与魄力。",
    "start": 41.075,
    "end": 48.711,
    "duration": 7.636
  },
  {
    "id": 10,
    "text": "第二，深陷半殖民地半封建环境，显现似强实弱的阶级两重性。",
    "start": 49.322,
    "end": 54.496,
    "duration": 5.174
  },
  {
    "id": 11,
    "text": "吴荪甫的悲剧根植于民族资产阶级的固有矛盾。",
    "start": 54.808,
    "end": 58.049,
    "duration": 3.241
  },
  {
    "id": 12,
    "text": "对内面对裕华丝厂工人的罢工抗争，他勾结军警特务实施冷酷镇压，",
    "start": 58.324,
    "end": 63.764,
    "duration": 5.44
  },
  {
    "id": 13,
    "text": "克扣工资、开除工人，暴露出资本家凶狠专断的一面；",
    "start": 63.913,
    "end": 68.113,
    "duration": 4.2
  },
  {
    "id": 14,
    "text": "对外遭遇帝国主义经济侵略、双桥镇农村破产与当局盘剥时，",
    "start": 68.377,
    "end": 73.404,
    "duration": 5.027
  },
  {
    "id": 15,
    "text": "他又缺乏真正抗衡的根基，只能陷入高风险的公债投机，呈现外强中干的性格弱点。",
    "start": 73.75,
    "end": 80.632,
    "duration": 6.882
  },
  {
    "id": 16,
    "text": "第三，遭买办金融资本与亲信背叛夹击，走向破产失败的宿命。",
    "start": 81.216,
    "end": 86.87,
    "duration": 5.654
  },
  {
    "id": 17,
    "text": "在半殖民地畸形经济秩序下，民族工业难以脱离外部金融霸权独立发展。",
    "start": 87.161,
    "end": 92.588,
    "duration": 5.427
  },
  {
    "id": 18,
    "text": "公债角逐中，吴荪甫不仅遭买办资本家赵伯韬雄厚外资的压迫，更遭妹夫杜竹斋临阵倒戈。",
    "start": 92.99,
    "end": 100.602,
    "duration": 7.612
  },
  {
    "id": 19,
    "text": "最终资金链断裂、公债惨败，吴荪甫归家狂怒并几欲开枪自尽，",
    "start": 100.836,
    "end": 105.874,
    "duration": 5.038
  },
  {
    "id": 20,
    "text": "次晨只得黯然乘船前往庐山避难，印证了旧中国民族资产阶级实业救国梦的破灭。",
    "start": 106.198,
    "end": 112.472,
    "duration": 6.274
  }
]