[
  {
    "id": 1,
    "text": "二十世纪七十年代末至八十年代初崛起的“朦胧诗”，",
    "start": 0.16,
    "end": 3.92,
    "duration": 3.76
  },
  {
    "id": 2,
    "text": "是中国新诗史上具有划时代意义的美学转折。",
    "start": 3.92,
    "end": 7.44,
    "duration": 3.52
  },
  {
    "id": 3,
    "text": "以北岛、舒婷、顾城、江河、杨炼等为代表的青年诗人，",
    "start": 7.44,
    "end": 11.76,
    "duration": 4.32
  },
  {
    "id": 4,
    "text": "依托民间刊物《今天》集结。",
    "start": 11.76,
    "end": 13.76,
    "duration": 2.0
  },
  {
    "id": 5,
    "text": "他们以强烈的反叛姿态，打破了十七年及文革时期政治工具论诗歌的单一模式。",
    "start": 13.76,
    "end": 19.52,
    "duration": 5.76
  },
  {
    "id": 6,
    "text": "朦胧诗在文坛引发了著名的美学大讨论。",
    "start": 19.76,
    "end": 23.2,
    "duration": 3.44
  },
  {
    "id": 7,
    "text": "谢冕的《在新的崛起面前》、孙绍振的《新的美学原则在崛起》与徐敬亚的《崛起的诗群》，",
    "start": 23.2,
    "end": 31.76,
    "duration": 8.56
  },
  {
    "id": 8,
    "text": "共同确立了新诗现代化的合法性。",
    "start": 31.76,
    "end": 34.72,
    "duration": 2.96
  },
  {
    "id": 9,
    "text": "朦胧诗的思想特征与艺术探索主要体现在四个核心维度。",
    "start": 34.72,
    "end": 39.6,
    "duration": 4.88
  },
  {
    "id": 10,
    "text": "第一，主体意识觉醒与批判怀疑精神的建构。",
    "start": 39.6,
    "end": 43.44,
    "duration": 3.84
  },
  {
    "id": 11,
    "text": "文革时期的诗歌消解了个体，充斥着盲目的政治狂热。",
    "start": 43.68,
    "end": 48.08,
    "duration": 4.4
  },
  {
    "id": 12,
    "text": "朦胧诗首先确立了具有独立反思精神的人格主体。",
    "start": 48.08,
    "end": 52.56,
    "duration": 4.48
  },
  {
    "id": 13,
    "text": "北岛在《回答》中发出震天动地的绝响。",
    "start": 52.56,
    "end": 56.08,
    "duration": 3.52
  },
  {
    "id": 14,
    "text": "诗人宣称“卑鄙是卑鄙者的通行证，",
    "start": 56.08,
    "end": 59.2,
    "duration": 3.12
  },
  {
    "id": 15,
    "text": "高尚是高尚者的墓志铭”。",
    "start": 59.2,
    "end": 61.36,
    "duration": 2.16
  },
  {
    "id": 16,
    "text": "那句“我，不，相，信”不仅是对虚妄说教的否定，",
    "start": 61.36,
    "end": 65.2,
    "duration": 3.84
  },
  {
    "id": 17,
    "text": "更是时代理性与批判精神的庄严宣言。",
    "start": 65.2,
    "end": 67.92,
    "duration": 2.72
  },
  {
    "id": 18,
    "text": "在《宣告》中，北岛进一步写下“在没有英雄的年代里，",
    "start": 68.24,
    "end": 72.56,
    "duration": 4.32
  },
  {
    "id": 19,
    "text": "我只想做一个人”。",
    "start": 72.56,
    "end": 74.4,
    "duration": 1.84
  },
  {
    "id": 20,
    "text": "诗作从神化崇拜转向了冷峻的社会反思，",
    "start": 74.4,
    "end": 78.16,
    "duration": 3.76
  },
  {
    "id": 21,
    "text": "重新确立了诗人在历史面前的独立脊梁。",
    "start": 78.16,
    "end": 81.52,
    "duration": 3.36
  },
  {
    "id": 22,
    "text": "第二，人性尊严的复归与个体生命温度的呼唤。",
    "start": 81.52,
    "end": 85.68,
    "duration": 4.16
  },
  {
    "id": 23,
    "text": "朦胧诗打破了将人性等同于阶级斗争工具的教条，",
    "start": 85.68,
    "end": 89.6,
    "duration": 3.92
  },
  {
    "id": 24,
    "text": "将目光投向了人性的深层律动。",
    "start": 89.6,
    "end": 91.84,
    "duration": 2.24
  },
  {
    "id": 25,
    "text": "舒婷的诗作充满温润的人道关怀与女性自主意识。",
    "start": 92.24,
    "end": 96.72,
    "duration": 4.48
  },
  {
    "id": 26,
    "text": "《致橡树》彻底告别了传统依附式的情感模式。",
    "start": 96.72,
    "end": 100.16,
    "duration": 3.44
  },
  {
    "id": 27,
    "text": "诗作倡导男女双方如木棉与橡树般平等并立、",
    "start": 100.16,
    "end": 104.32,
    "duration": 4.16
  },
  {
    "id": 28,
    "text": "灵魂交融。",
    "start": 104.32,
    "end": 105.28,
    "duration": 0.96
  },
  {
    "id": 29,
    "text": "在《神女峰》中，舒婷更直接批判了千百年来束缚女性的贞操神话与虚妄牺牲。",
    "start": 105.28,
    "end": 111.84,
    "duration": 6.56
  },
  {
    "id": 30,
    "text": "在《祖国啊，我亲爱的祖国》中，诗人将对祖国的深情建立在对历史苦难的深沉承担之上。",
    "start": 112.24,
    "end": 119.44,
    "duration": 7.2
  },
  {
    "id": 31,
    "text": "诗歌重新恢复了人类真挚深沉的情感尊严。",
    "start": 119.44,
    "end": 122.8,
    "duration": 3.36
  },
  {
    "id": 32,
    "text": "第三，象征隐喻系统的开拓与多义性审美空间的建构。",
    "start": 123.176,
    "end": 127.816,
    "duration": 4.64
  },
  {
    "id": 33,
    "text": "朦胧诗彻底摒弃了简单直白的宣传性口号。",
    "start": 127.816,
    "end": 131.336,
    "duration": 3.52
  },
  {
    "id": 34,
    "text": "诗人们普遍借鉴西方现代主义象征手法，",
    "start": 131.336,
    "end": 134.536,
    "duration": 3.2
  },
  {
    "id": 35,
    "text": "大量运用通感、隐喻与意象跳跃。",
    "start": 134.536,
    "end": 137.576,
    "duration": 3.04
  },
  {
    "id": 36,
    "text": "顾城在《一代人》中写道，“黑夜给了我黑色的眼睛，",
    "start": 137.576,
    "end": 141.336,
    "duration": 3.76
  },
  {
    "id": 37,
    "text": "我却用它寻找光明”。",
    "start": 141.336,
    "end": 142.776,
    "duration": 1.44
  },
  {
    "id": 38,
    "text": "诗人用“黑夜”隐喻荒谬动荡的岁月，",
    "start": 143.176,
    "end": 146.456,
    "duration": 3.28
  },
  {
    "id": 39,
    "text": "用“黑眼睛”与“光明”象征不屈的精神探索。",
    "start": 146.456,
    "end": 150.136,
    "duration": 3.68
  },
  {
    "id": 40,
    "text": "而在《弧线》中，顾城更借助鸟儿、",
    "start": 150.136,
    "end": 153.016,
    "duration": 2.88
  },
  {
    "id": 41,
    "text": "圆木、飞浪等流动几何意象，捕捉生命瞬间的动态平衡。",
    "start": 153.016,
    "end": 157.896,
    "duration": 4.88
  },
  {
    "id": 42,
    "text": "繁复的意象叠加打破了语义的单一指向，",
    "start": 157.896,
    "end": 161.096,
    "duration": 3.2
  },
  {
    "id": 43,
    "text": "为读者创造了充满不确定性的多义阐释空间。",
    "start": 161.096,
    "end": 164.376,
    "duration": 3.28
  },
  {
    "id": 44,
    "text": "第四，自由沉郁的情感律动与哲理思辨色彩的融合。",
    "start": 164.696,
    "end": 169.576,
    "duration": 4.88
  },
  {
    "id": 45,
    "text": "朦胧诗人放弃了机械刻板的颂歌节律。",
    "start": 169.576,
    "end": 172.776,
    "duration": 3.2
  },
  {
    "id": 46,
    "text": "诗歌节奏完全服从于诗人内在情绪的跌宕起伏。",
    "start": 172.776,
    "end": 177.016,
    "duration": 4.24
  },
  {
    "id": 47,
    "text": "江河的《纪念碑》与杨炼的《诺日朗》，",
    "start": 177.016,
    "end": 179.896,
    "duration": 2.88
  },
  {
    "id": 48,
    "text": "将古老民族的历史创伤与崇高的悲剧崇高感相结合。",
    "start": 179.896,
    "end": 184.216,
    "duration": 4.32
  },
  {
    "id": 49,
    "text": "诗作熔铸着深沉博大的史诗情怀与哲理反思。",
    "start": 184.616,
    "end": 189.096,
    "duration": 4.48
  },
  {
    "id": 50,
    "text": "诗歌不再只是单纯的情绪宣泄，而成为对民族命运、",
    "start": 189.096,
    "end": 193.416,
    "duration": 4.32
  },
  {
    "id": 51,
    "text": "文化寻根与人类生存困境的深层哲理探索。",
    "start": 193.416,
    "end": 197.496,
    "duration": 4.08
  },
  {
    "id": 52,
    "text": "朦胧诗的出现不仅更新了中国诗歌的现代美学观念，",
    "start": 197.496,
    "end": 201.816,
    "duration": 4.32
  },
  {
    "id": 53,
    "text": "更深远地参与了新时期思想启蒙的历史进程。",
    "start": 201.816,
    "end": 205.736,
    "duration": 3.92
  },
  {
    "id": 54,
    "text": "尽管它曾因意象晦涩而遭受保守势力的责难，",
    "start": 205.976,
    "end": 209.816,
    "duration": 3.84
  },
  {
    "id": 55,
    "text": "但它确立的独立思考姿态与现代诗歌表现范式，",
    "start": 209.816,
    "end": 213.976,
    "duration": 4.16
  },
  {
    "id": 56,
    "text": "为中国当代文学走向世界与现代性奠定了坚实的基石。",
    "start": 213.976,
    "end": 218.136,
    "duration": 4.16
  }
]