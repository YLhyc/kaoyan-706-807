[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "曹禺·雷雨思想意蕴与艺术成就",
    "start": 0.154,
    "end": 2.886,
    "duration": 2.732
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "思想深度→人性悖论→戏剧技艺三层硬核推进：",
    "start": 3.564,
    "end": 9.336,
    "duration": 5.772
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先揭开周鲁两家背后“阶级罪恶 + 不可知命运”双重深度，",
    "start": 9.564,
    "end": 13.976,
    "duration": 4.412
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再切入周朴园虚伪自恋与繁漪“雷雨式”蛮力的复杂人性，",
    "start": 14.204,
    "end": 18.456,
    "duration": 4.252
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后落到“三一律”高压一天与潜台词心灵动作，刚好30分极稳三足鼎立。",
    "start": 18.684,
    "end": 25.256,
    "duration": 6.572
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "三十年代曹禺《雷雨》标志中国现代话剧走向成熟，",
    "start": 25.784,
    "end": 30.036,
    "duration": 4.252
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "融西方古典技巧、古希腊命运悲剧与宗法家庭批判为一体，树现实主义与诗化美学交融典范。",
    "start": 30.344,
    "end": 38.596,
    "duration": 8.252
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 贯通社会历史批判与超越性命运哲思",
    "start": 39.29,
    "end": 42.902,
    "duration": 3.612
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "周鲁两家三十年纠葛与一日溃败撕破宗法伪善：",
    "start": 43.43,
    "end": 48.868,
    "duration": 5.438
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "周朴园江桥故意淹死两千二百小工、逼产后三天的侍萍大年三十抱子投河；",
    "start": 48.883,
    "end": 55.682,
    "duration": 6.799
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "序幕诉对神秘力量敬畏，郁热雷鸣中繁漪越反抗、周萍越逃、周冲越憧憬越坠毁灭，历史批判与命运之谜相互映照。",
    "start": 56.196,
    "end": 67.808,
    "duration": 11.612
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 打破脸谱模式、开掘复杂人性悖论",
    "start": 68.291,
    "end": 71.583,
    "duration": 3.292
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "留旧家具、关窗是掩饰早年罪孽的道德代偿；一旦活侍萍现身，立刻掏五千元支票赎买旧情，暴露冷酷自私；",
    "start": 71.967,
    "end": 82.589,
    "duration": 10.622
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "深受新思潮濡染却深锁封建死屋，对周萍绝望依恋化为困兽之斗，玉石俱焚撕碎伪善，成极具张力“雷雨式性格”。",
    "start": 83.117,
    "end": 95.469,
    "duration": 12.352
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 回溯式高压结构与心灵动作性潜台词",
    "start": 95.93,
    "end": 100.342,
    "duration": 4.412
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "借“三一律”将两代三十年秘密与中间四幕浓缩在盛夏一天（上午到午夜）及周家客厅、鲁家住房两场景，回溯引爆一触即发；",
    "start": 100.87,
    "end": 113.522,
    "duration": 12.652
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "“逼喝苦药”平缓言辞暗涌家长专制绞杀；周家客厅“辨认旧衬衣”把周朴园心理防线溃退外化为心灵交锋。",
    "start": 114.05,
    "end": 125.632,
    "duration": 11.582
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《雷雨》将阶级解剖、命运玄思、人性悖论与精湛戏剧技巧融于一体，结束现代话剧草创摸索，确立经典范式。",
    "start": 126.254,
    "end": 135.946,
    "duration": 9.692
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：专有名词固定写作“繁漪”（不写蘩漪）；",
    "start": 136.438,
    "end": 140.29,
    "duration": 3.852
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "中间四幕浓缩在盛夏一天（上午到午夜）与周家客厅、鲁家住房两个场景（全剧另有十年后序幕与尾声）。",
    "start": 140.728,
    "end": 148.58,
    "duration": 7.852
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出周朴园在哈尔滨、侍萍产后三天的两桩罪恶及支票细节？",
    "start": 149.258,
    "end": 155.35,
    "duration": 6.092
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释《雷雨》“阶级历史批判 + 命运不可知”双重悲剧层？",
    "start": 155.878,
    "end": 161.09,
    "duration": 5.212
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 结合“三一律”“回溯式”“逼喝苦药/旧衬衣”说明曹禺的现代话剧技巧？",
    "start": 161.618,
    "end": 168.67,
    "duration": 7.052
  }
]