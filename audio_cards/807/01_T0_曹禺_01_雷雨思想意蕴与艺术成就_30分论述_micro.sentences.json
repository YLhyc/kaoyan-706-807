[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "曹禺·雷雨思想意蕴与艺术成就",
    "start": 0.314,
    "end": 3.606,
    "duration": 3.292
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "思想深度→人性悖论→戏剧技艺三层硬核推进：",
    "start": 4.534,
    "end": 10.186,
    "duration": 5.652
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先揭开周鲁两家背后“阶级罪恶 + 不可知命运”双重深度，",
    "start": 10.534,
    "end": 15.426,
    "duration": 4.892
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再切入周朴园虚伪自恋与繁漪“雷雨式”蛮力的复杂人性，",
    "start": 15.774,
    "end": 20.346,
    "duration": 4.572
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后落到“三一律”高压一天与潜台词心灵动作，刚好30分极稳三足鼎立。",
    "start": 20.774,
    "end": 27.266,
    "duration": 6.492
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "三十年代曹禺《雷雨》标志中国现代话剧走向成熟，",
    "start": 28.314,
    "end": 32.926,
    "duration": 4.612
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "融西方古典技巧、古希腊命运悲剧与宗法家庭批判为一体，树现实主义与诗化美学交融典范。",
    "start": 33.194,
    "end": 41.806,
    "duration": 8.612
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 贯通社会历史批判与超越性命运哲思",
    "start": 42.774,
    "end": 46.866,
    "duration": 4.092
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "周鲁两家三十年纠葛与一日溃败撕破宗法伪善：",
    "start": 47.874,
    "end": 53.166,
    "duration": 5.292
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "周朴园江桥故意淹死两千二百小工、逼产后三天的侍萍大年三十抱子投河；",
    "start": 53.284,
    "end": 60.726,
    "duration": 7.442
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "序幕诉对神秘力量敬畏，郁热雷鸣中繁漪越反抗、周萍越逃、周冲越憧憬越坠毁灭，历史批判与命运之谜相互映照。",
    "start": 61.734,
    "end": 72.866,
    "duration": 11.132
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 打破脸谱模式、开掘复杂人性悖论",
    "start": 73.874,
    "end": 77.686,
    "duration": 3.812
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "留旧家具、关窗是掩饰早年罪孽的道德代偿；一旦活侍萍现身，立刻掏五千元支票赎买旧情，暴露冷酷自私；",
    "start": 78.454,
    "end": 90.086,
    "duration": 11.632
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "深受新思潮濡染却深锁封建死屋，对周萍绝望依恋化为困兽之斗，玉石俱焚撕碎伪善，成极具张力“雷雨式性格”。",
    "start": 90.854,
    "end": 103.386,
    "duration": 12.532
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 回溯式高压结构与心灵动作性潜台词",
    "start": 104.274,
    "end": 108.406,
    "duration": 4.132
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "借“三一律”将两代三十年秘密与中间四幕浓缩在盛夏一天（上午到午夜）及周家客厅、鲁家住房两场景，回溯引爆一触即发；",
    "start": 109.106,
    "end": 121.078,
    "duration": 11.972
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "“逼喝苦药”平缓言辞暗涌家长专制绞杀；周家客厅“辨认旧衬衣”把周朴园心理防线溃退外化为心灵交锋。",
    "start": 122.126,
    "end": 134.038,
    "duration": 11.912
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《雷雨》将阶级解剖、命运玄思、人性悖论与精湛戏剧技巧融于一体，结束现代话剧草创摸索，确立经典范式。",
    "start": 135.046,
    "end": 145.058,
    "duration": 10.012
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：专有名词固定写作“繁漪”（不写蘩漪）；",
    "start": 146.106,
    "end": 149.598,
    "duration": 3.492
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "中间四幕浓缩在盛夏一天（上午到午夜）与周家客厅、鲁家住房两个场景（全剧另有十年后序幕与尾声）。",
    "start": 150.806,
    "end": 159.858,
    "duration": 9.052
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出周朴园在哈尔滨、侍萍产后三天的两桩罪恶及支票细节？",
    "start": 160.866,
    "end": 167.478,
    "duration": 6.612
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释《雷雨》“阶级历史批判 + 命运不可知”双重悲剧层？",
    "start": 168.406,
    "end": 174.618,
    "duration": 6.212
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 结合“三一律”“回溯式”“逼喝苦药/旧衬衣”说明曹禺的现代话剧技巧？",
    "start": 175.09,
    "end": 182.102,
    "duration": 7.012
  }
]