[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "思想深度→人性悖论→戏剧技艺三层硬核推进：",
    "start": 0.0,
    "end": 4.8,
    "duration": 4.8
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先揭开周鲁两家背后“阶级罪恶 + 不可知命运”双重深度，",
    "start": 4.849,
    "end": 9.129,
    "duration": 4.28
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再切入周朴园虚伪自恋与繁漪“雷雨式”蛮力的复杂人性，",
    "start": 9.579,
    "end": 14.059,
    "duration": 4.48
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后落到“三一律”高压一天与潜台词心灵动作，刚好30分极稳三足鼎立。",
    "start": 14.509,
    "end": 20.429,
    "duration": 5.92
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "三十年代曹禺《雷雨》标志中国现代话剧走向成熟，",
    "start": 20.879,
    "end": 24.879,
    "duration": 4.0
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "融西方古典技巧、古希腊命运悲剧与宗法家庭批判为一体，",
    "start": 25.329,
    "end": 30.049,
    "duration": 4.72
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "树现实主义与诗化美学交融典范。",
    "start": 30.499,
    "end": 33.299,
    "duration": 2.8
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 贯通社会历史批判与超越性命运哲思",
    "start": 33.749,
    "end": 37.909,
    "duration": 4.16
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "周鲁两家三十年纠葛与一日溃败撕破宗法伪善：",
    "start": 38.359,
    "end": 42.599,
    "duration": 4.24
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "周朴园江桥故意淹死两千二百小工、逼产后三天的侍萍大年三十抱子投河；",
    "start": 43.049,
    "end": 49.209,
    "duration": 6.16
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "序幕诉对神秘力量敬畏，",
    "start": 49.659,
    "end": 51.739,
    "duration": 2.08
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "郁热雷鸣中繁漪越反抗、周萍越逃、周冲越憧憬越坠毁灭，",
    "start": 52.269,
    "end": 57.069,
    "duration": 4.8
  },
  {
    "id": "sec0_step1_c2",
    "dom_key": "sec0_step1_c2",
    "text": "历史批判与命运之谜相互映照。",
    "start": 57.599,
    "end": 60.039,
    "duration": 2.44
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 打破脸谱模式、开掘复杂人性悖论",
    "start": 60.569,
    "end": 64.089,
    "duration": 3.52
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "留旧家具、关窗是掩饰早年罪孽的道德代偿；",
    "start": 64.619,
    "end": 68.219,
    "duration": 3.6
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "一旦活侍萍现身，立刻掏五千元支票赎买旧情，暴露冷酷自私；",
    "start": 68.669,
    "end": 74.029,
    "duration": 5.36
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "深受新思潮濡染却深锁封建死屋，对周萍绝望依恋化为困兽之斗，",
    "start": 74.479,
    "end": 80.039,
    "duration": 5.56
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "玉石俱焚撕碎伪善，成极具张力“雷雨式性格”。",
    "start": 80.569,
    "end": 84.369,
    "duration": 3.8
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 回溯式高压结构与心灵动作性潜台词",
    "start": 84.819,
    "end": 88.819,
    "duration": 4.0
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "借“三一律”将两代三十年秘密与中间四幕浓缩在盛夏一天（上午到午夜）及周家客厅、鲁家住房两场景，",
    "start": 89.269,
    "end": 97.629,
    "duration": 8.36
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "回溯引爆一触即发；",
    "start": 98.079,
    "end": 99.759,
    "duration": 1.68
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "“逼喝苦药”平缓言辞暗涌家长专制绞杀；",
    "start": 100.209,
    "end": 103.769,
    "duration": 3.56
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "周家客厅“辨认旧衬衣”把周朴园心理防线溃退外化为心灵交锋。",
    "start": 104.219,
    "end": 109.859,
    "duration": 5.64
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《雷雨》将阶级解剖、命运玄思、人性悖论与精湛戏剧技巧融于一体，",
    "start": 110.309,
    "end": 115.589,
    "duration": 5.28
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "结束现代话剧草创摸索，确立经典范式。",
    "start": 116.039,
    "end": 119.559,
    "duration": 3.52
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：专有名词固定写作“繁漪”（不写蘩漪）；",
    "start": 120.009,
    "end": 123.209,
    "duration": 3.2
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "中间四幕浓缩在盛夏一天（上午到午夜）与周家客厅、鲁家住房两个场景（全剧另有十年后序幕与尾声）。",
    "start": 123.659,
    "end": 132.259,
    "duration": 8.6
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出周朴园在哈尔滨、侍萍产后三天的两桩罪恶及支票细节？",
    "start": 132.709,
    "end": 139.389,
    "duration": 6.68
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释《雷雨》“阶级历史批判 + 命运不可知”双重悲剧层？",
    "start": 139.839,
    "end": 145.359,
    "duration": 5.52
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 结合“三一律”“回溯式”“逼喝苦药/旧衬衣”说明曹禺的现代话剧技巧？",
    "start": 145.809,
    "end": 152.529,
    "duration": 6.72
  }
]