[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣“中国的左拉”大河小说风土与历史切面三层收束：",
    "start": 0.0,
    "end": 5.08,
    "duration": 5.08
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "1.方言俚语再现天回镇赶场袍哥茶馆民俗画；",
    "start": 5.129,
    "end": 9.489,
    "duration": 4.36
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "2.邓幺姑（蔡大嫂）背离木讷丈夫恋罗歪嘴又转嫁顾天成的鲜活反叛；",
    "start": 9.939,
    "end": 16.619,
    "duration": 6.68
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "3.借袍哥/镇商/洋教三股势力写甲午至辛丑前夜死水下的惊雷暗涌。",
    "start": 17.069,
    "end": 23.469,
    "duration": 6.4
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "三十年代中期李劼人《死水微澜》为“大河小说”三部曲开山之作，",
    "start": 23.919,
    "end": 28.919,
    "duration": 5.0
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "再现晚清中西碰撞在四川激起的波澜，郭沫若赞其为“中国的左拉”。",
    "start": 29.369,
    "end": 34.729,
    "duration": 5.36
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 铺陈浓郁巴蜀民俗、绘晚清内陆全景",
    "start": 35.179,
    "end": 39.339,
    "duration": 4.16
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "以成都近郊天回镇为舞台，",
    "start": 39.789,
    "end": 42.109,
    "duration": 2.32
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "细描甲午战争至《辛丑条约》前后四川乡镇滞重生活；",
    "start": 42.559,
    "end": 46.879,
    "duration": 4.32
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "熟用四川方言俚语，再现吃茶摆龙门阵、赶场庙会、袍哥拜码头与婚丧嫁娶，",
    "start": 47.329,
    "end": 54.369,
    "duration": 7.04
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "绘川西民俗画卷。",
    "start": 54.819,
    "end": 56.339,
    "duration": 1.52
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 塑造泼辣底层女性典型、显突破礼教活力",
    "start": 56.869,
    "end": 61.429,
    "duration": 4.56
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "邓幺姑（蔡大嫂）美丽泼辣能干，渴望体面生活，迥异于传统温顺闺秀；",
    "start": 61.879,
    "end": 68.079,
    "duration": 6.2
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "不满木讷丈夫蔡兴顺，与袍哥头目罗歪嘴大胆相恋；",
    "start": 68.529,
    "end": 73.049,
    "duration": 4.52
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "罗潜逃后为护家尊果断转嫁投靠洋教的顾天成，显复杂女性生命活力。",
    "start": 73.579,
    "end": 79.739,
    "duration": 6.16
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 白描中西碰撞漩涡、剖时代巨变“微澜”",
    "start": 80.189,
    "end": 84.549,
    "duration": 4.36
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "借民间帮会罗歪嘴、小镇商人蔡兴顺及投靠洋教作威作福的顾天成蜕变；",
    "start": 84.999,
    "end": 91.559,
    "duration": 6.56
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "真实折射西方殖民势力渗入内陆引起的阶层分化震荡，",
    "start": 92.009,
    "end": 96.409,
    "duration": 4.4
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "写尽晚清表面如死水、内里暗流涌动之真实。",
    "start": 96.859,
    "end": 100.819,
    "duration": 3.96
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：李劼人“大河小说”三部曲开山之作（郭沫若赞“中国的左拉”）；",
    "start": 101.269,
    "end": 106.149,
    "duration": 4.88
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "专名务必写准：“天回镇”“罗歪嘴”；",
    "start": 106.599,
    "end": 109.039,
    "duration": 2.44
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "人物：邓幺姑（蔡大嫂）、蔡兴顺、罗歪嘴（袍哥）、顾天成（投洋教）。",
    "start": 109.569,
    "end": 115.249,
    "duration": 5.68
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 准确写出作者“李劼人”、三部曲“大河小说”、地点“天回镇”与“中国的左拉”评语？",
    "start": 115.699,
    "end": 122.859,
    "duration": 7.16
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合邓幺姑（蔡大嫂）周旋三男的脉络，",
    "start": 123.309,
    "end": 127.109,
    "duration": 3.8
  },
  {
    "id": "drill1_c1",
    "dom_key": "drill1_c1",
    "text": "分析其如何打破传统闺秀悲情套路？",
    "start": 127.559,
    "end": 130.399,
    "duration": 2.84
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2026 真题名解《〈死水微澜〉》及川西地域风俗画简答题？",
    "start": 130.849,
    "end": 137.609,
    "duration": 6.76
  }
]