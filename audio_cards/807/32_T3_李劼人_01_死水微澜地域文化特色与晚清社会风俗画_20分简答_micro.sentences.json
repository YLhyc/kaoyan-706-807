[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "李劼人·死水微澜地域文化特色与晚清社会风俗画",
    "start": 0.314,
    "end": 4.686,
    "duration": 4.372
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣“中国的左拉”大河小说风土与历史切面三层收束：1.方言俚语再现天回镇赶场袍哥茶馆民俗画；",
    "start": 5.654,
    "end": 16.746,
    "duration": 11.092
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "2.邓幺姑（蔡大嫂）背离木讷丈夫恋罗歪嘴又转嫁顾天成的鲜活反叛；",
    "start": 17.674,
    "end": 24.286,
    "duration": 6.612
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "3.借袍哥/镇商/洋教三股势力写甲午至辛丑前夜死水下的惊雷暗涌。",
    "start": 25.254,
    "end": 32.266,
    "duration": 7.012
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "三十年代中期李劼人《死水微澜》为“大河小说”三部曲开山之作，",
    "start": 33.354,
    "end": 38.606,
    "duration": 5.252
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "再现晚清中西碰撞在四川激起的波澜，郭沫若赞其为“中国的左拉”。",
    "start": 38.954,
    "end": 44.646,
    "duration": 5.692
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 铺陈浓郁巴蜀民俗、绘晚清内陆全景",
    "start": 45.574,
    "end": 49.706,
    "duration": 4.132
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "以成都近郊天回镇为舞台，细描甲午战争至《辛丑条约》前后四川乡镇滞重生活；",
    "start": 50.714,
    "end": 58.686,
    "duration": 7.972
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "熟用四川方言俚语，再现吃茶摆龙门阵、赶场庙会、袍哥拜码头与婚丧嫁娶，绘川西民俗画卷。",
    "start": 59.694,
    "end": 69.146,
    "duration": 9.452
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 塑造泼辣底层女性典型、显突破礼教活力",
    "start": 70.154,
    "end": 74.726,
    "duration": 4.572
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "邓幺姑（蔡大嫂）美丽泼辣能干，渴望体面生活，迥异于传统温顺闺秀；",
    "start": 75.734,
    "end": 82.826,
    "duration": 7.092
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "不满木讷丈夫蔡兴顺，与袍哥头目罗歪嘴大胆相恋；",
    "start": 83.914,
    "end": 89.606,
    "duration": 5.692
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "罗潜逃后为护家尊果断转嫁投靠洋教的顾天成，显复杂女性生命活力。",
    "start": 90.114,
    "end": 96.926,
    "duration": 6.812
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 白描中西碰撞漩涡、剖时代巨变“微澜”",
    "start": 97.544,
    "end": 101.956,
    "duration": 4.412
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "借民间帮会罗歪嘴、小镇商人蔡兴顺及投靠洋教作威作福的顾天成蜕变；",
    "start": 102.768,
    "end": 110.06,
    "duration": 7.292
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "真实折射西方殖民势力渗入内陆引起的阶层分化震荡，写尽晚清表面如死水、内里暗流涌动之真实。",
    "start": 111.068,
    "end": 121.76,
    "duration": 10.692
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：李劼人“大河小说”三部曲开山之作（郭沫若赞“中国的左拉”）；",
    "start": 122.768,
    "end": 128.7,
    "duration": 5.932
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "专名务必写准：“天回镇”“罗歪嘴”；",
    "start": 129.748,
    "end": 132.76,
    "duration": 3.012
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "人物：邓幺姑（蔡大嫂）、蔡兴顺、罗歪嘴（袍哥）、顾天成（投洋教）。",
    "start": 133.768,
    "end": 140.22,
    "duration": 6.452
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 准确写出作者“李劼人”、三部曲“大河小说”、地点“天回镇”与“中国的左拉”评语？",
    "start": 141.108,
    "end": 149.92,
    "duration": 8.812
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合邓幺姑（蔡大嫂）周旋三男的脉络，分析其如何打破传统闺秀悲情套路？",
    "start": 150.888,
    "end": 158.82,
    "duration": 7.932
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2026 真题名解《〈死水微澜〉》及川西地域风俗画简答题？",
    "start": 159.216,
    "end": 166.108,
    "duration": 6.892
  }
]