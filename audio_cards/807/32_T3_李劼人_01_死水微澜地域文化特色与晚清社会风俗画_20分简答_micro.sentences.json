[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "李劼人·死水微澜地域文化特色与晚清社会风俗画",
    "start": 0.157,
    "end": 4.566,
    "duration": 4.409
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣“中国的左拉”大河小说风土与历史切面三层收束：1.方言俚语再现天回镇赶场袍哥茶馆民俗画；",
    "start": 5.06,
    "end": 15.952,
    "duration": 10.892
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "2.邓幺姑（蔡大嫂）背离木讷丈夫恋罗歪嘴又转嫁顾天成的鲜活反叛；",
    "start": 16.23,
    "end": 22.162,
    "duration": 5.932
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "3.借袍哥/镇商/洋教三股势力写甲午至辛丑前夜死水下的惊雷暗涌。",
    "start": 22.44,
    "end": 29.172,
    "duration": 6.732
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "三十年代中期李劼人《死水微澜》为“大河小说”三部曲开山之作，",
    "start": 29.653,
    "end": 34.545,
    "duration": 4.892
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "再现晚清中西碰撞在四川激起的波澜，郭沫若赞其为“中国的左拉”。",
    "start": 34.773,
    "end": 39.825,
    "duration": 5.052
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 铺陈浓郁巴蜀民俗、绘晚清内陆全景",
    "start": 40.49,
    "end": 44.262,
    "duration": 3.772
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "以成都近郊天回镇为舞台，细描甲午战争至《辛丑条约》前后四川乡镇滞重生活；",
    "start": 44.752,
    "end": 51.884,
    "duration": 7.132
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "熟用四川方言俚语，再现吃茶摆龙门阵、赶场庙会、袍哥拜码头与婚丧嫁娶，绘川西民俗画卷。",
    "start": 52.412,
    "end": 61.464,
    "duration": 9.052
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 塑造泼辣底层女性典型、显突破礼教活力",
    "start": 62.148,
    "end": 66.72,
    "duration": 4.572
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "邓幺姑（蔡大嫂）美丽泼辣能干，渴望体面生活，迥异于传统温顺闺秀；",
    "start": 67.248,
    "end": 73.66,
    "duration": 6.412
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "不满木讷丈夫蔡兴顺，与袍哥头目罗歪嘴大胆相恋；",
    "start": 74.188,
    "end": 79.16,
    "duration": 4.972
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "罗潜逃后为护家尊果断转嫁投靠洋教的顾天成，显复杂女性生命活力。",
    "start": 79.468,
    "end": 85.96,
    "duration": 6.492
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 白描中西碰撞漩涡、剖时代巨变“微澜”",
    "start": 86.476,
    "end": 90.568,
    "duration": 4.092
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "借民间帮会罗歪嘴、小镇商人蔡兴顺及投靠洋教作威作福的顾天成蜕变；",
    "start": 91.096,
    "end": 98.548,
    "duration": 7.452
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "真实折射西方殖民势力渗入内陆引起的阶层分化震荡，写尽晚清表面如死水、内里暗流涌动之真实。",
    "start": 99.017,
    "end": 109.269,
    "duration": 10.252
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：李劼人“大河小说”三部曲开山之作（郭沫若赞“中国的左拉”）；",
    "start": 109.972,
    "end": 115.344,
    "duration": 5.372
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "专名务必写准：“天回镇”“罗歪嘴”；",
    "start": 115.702,
    "end": 118.994,
    "duration": 3.292
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "人物：邓幺姑（蔡大嫂）、蔡兴顺、罗歪嘴（袍哥）、顾天成（投洋教）。",
    "start": 119.352,
    "end": 124.244,
    "duration": 4.892
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 准确写出作者“李劼人”、三部曲“大河小说”、地点“天回镇”与“中国的左拉”评语？",
    "start": 124.949,
    "end": 132.641,
    "duration": 7.692
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合邓幺姑（蔡大嫂）周旋三男的脉络，分析其如何打破传统闺秀悲情套路？",
    "start": 133.144,
    "end": 140.756,
    "duration": 7.612
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2026 真题名解《〈死水微澜〉》及川西地域风俗画简答题？",
    "start": 141.13,
