[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "李劼人·死水微澜地域文化特色与晚清社会风俗画",
    "start": 0.134,
    "end": 4.56,
    "duration": 4.426
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣“中国的左拉”大河小说风土与历史切面三层收束：1.方言俚语再现天回镇赶场袍哥茶馆民俗画；",
    "start": 5.149,
    "end": 14.836,
    "duration": 9.687
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "2.邓幺姑（蔡大嫂）背离木讷丈夫恋罗歪嘴又转嫁顾天成的鲜活反叛；",
    "start": 15.058,
    "end": 21.693,
    "duration": 6.635
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "3.借袍哥/镇商/洋教三股势力写甲午至辛丑前夜死水下的惊雷暗涌。",
    "start": 22.033,
    "end": 29.141,
    "duration": 7.108
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "三十年代中期李劼人《死水微澜》为“大河小说”三部曲开山之作，",
    "start": 29.715,
    "end": 34.923,
    "duration": 5.207
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "再现晚清中西碰撞在四川激起的波澜，郭沫若赞其为“中国的左拉”。",
    "start": 35.262,
    "end": 40.717,
    "duration": 5.455
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 铺陈浓郁巴蜀民俗、绘晚清内陆全景",
    "start": 41.304,
    "end": 45.209,
    "duration": 3.905
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "以成都近郊天回镇为舞台，细描甲午战争至《辛丑条约》前后四川乡镇滞重生活；",
    "start": 45.783,
    "end": 53.477,
    "duration": 7.694
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "熟用四川方言俚语，再现吃茶摆龙门阵、赶场庙会、袍哥拜码头与婚丧嫁娶，绘川西民俗画卷。",
    "start": 54.064,
    "end": 63.451,
    "duration": 9.387
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 塑造泼辣底层女性典型、显突破礼教活力",
    "start": 64.038,
    "end": 68.529,
    "duration": 4.491
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "邓幺姑（蔡大嫂）美丽泼辣能干，渴望体面生活，迥异于传统温顺闺秀；",
    "start": 69.116,
    "end": 76.055,
    "duration": 6.939
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "不满木讷丈夫蔡兴顺，与袍哥头目罗歪嘴大胆相恋；",
    "start": 76.642,
    "end": 82.201,
    "duration": 5.559
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "罗潜逃后为护家尊果断转嫁投靠洋教的顾天成，显复杂女性生命活力。",
    "start": 82.398,
    "end": 88.699,
    "duration": 6.301
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 白描中西碰撞漩涡、剖时代巨变“微澜”",
    "start": 89.273,
    "end": 93.477,
    "duration": 4.205
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "借民间帮会罗歪嘴、小镇商人蔡兴顺及投靠洋教作威作福的顾天成蜕变；",
    "start": 94.064,
    "end": 101.537,
    "duration": 7.473
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "真实折射西方殖民势力渗入内陆引起的阶层分化震荡，写尽晚清表面如死水、内里暗流涌动之真实。",
    "start": 102.124,
    "end": 111.928,
    "duration": 9.804
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：李劼人“大河小说”三部曲开山之作（郭沫若赞“中国的左拉”）；",
    "start": 112.502,
    "end": 117.943,
    "duration": 5.442
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "专名务必写准：“天回镇”“罗歪嘴”；",
    "start": 118.309,
    "end": 121.29,
    "duration": 2.981
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "人物：邓幺姑（蔡大嫂）、蔡兴顺、罗歪嘴（袍哥）、顾天成（投洋教）。",
    "start": 121.538,
    "end": 128.074,
    "duration": 6.535
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 准确写出作者“李劼人”、三部曲“大河小说”、地点“天回镇”与“中国的左拉”评语？",
    "start": 128.648,
    "end": 136.186,
    "duration": 7.538
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合邓幺姑（蔡大嫂）周旋三男的脉络，分析其如何打破传统闺秀悲情套路？",
    "start": 136.76,
    "end": 144.792,
    "duration": 8.033
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2026 真题名解《〈死水微澜〉》及川西地域风俗画简答题？",
    "start": 145.366,
    "end": 152.305,
    "duration": 6.939
  }
]