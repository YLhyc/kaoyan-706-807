[
  {
    "id": 1,
    "text": "三十年代初，",
    "start": 0.05,
    "end": 1.392,
    "duration": 1.342
  },
  {
    "id": 2,
    "text": "巴金以《家》《春》《秋》构筑的《激流三部曲》，",
    "start": 1.392,
    "end": 4.526,
    "duration": 3.134
  },
  {
    "id": 3,
    "text": "是中国现代文学史上控诉封建宗法制度罪恶、",
    "start": 4.526,
    "end": 8.501,
    "duration": 3.975
  },
  {
    "id": 4,
    "text": "歌颂青年生命觉醒的最具震撼力的史诗画卷。",
    "start": 8.501,
    "end": 12.386,
    "duration": 3.885
  },
  {
    "id": 5,
    "text": "作品以成都高公馆这一典型封建大家族的衰亡为轴心，",
    "start": 12.386,
    "end": 16.903,
    "duration": 4.517
  },
  {
    "id": 6,
    "text": "其深刻的思想内容主要体现于以下三个维度：",
    "start": 16.903,
    "end": 21.015,
    "duration": 4.112
  },
  {
    "id": 7,
    "text": "第一，无情解剖封建宗法制度的专制腐朽，",
    "start": 21.015,
    "end": 24.294,
    "duration": 3.279
  },
  {
    "id": 8,
    "text": "控诉礼教吃人的反动本质。",
    "start": 24.294,
    "end": 26.63,
    "duration": 2.336
  },
  {
    "id": 9,
    "text": "小说以高老太爷为封建大家长权威符号，",
    "start": 26.63,
    "end": 30.268,
    "duration": 3.638
  },
  {
    "id": 10,
    "text": "揭露其以“父为子纲”的虚伪道德对青年一代自由生机的残酷扼杀。",
    "start": 30.268,
    "end": 35.903,
    "duration": 5.635
  },
  {
    "id": 11,
    "text": "婢女鸣凤被高老太爷强行指婚给同辈污浊官僚冯乐山作妾，",
    "start": 35.903,
    "end": 40.841,
    "duration": 4.938
  },
  {
    "id": 12,
    "text": "在反抗无门、绝望至极的黑夜毅然纵身跳入冰冷湖水殉节；",
    "start": 40.841,
    "end": 45.955,
    "duration": 5.114
  },
  {
    "id": 13,
    "text": "长孙媳瑞珏在难产之际，",
    "start": 45.955,
    "end": 48.065,
    "duration": 2.11
  },
  {
    "id": 14,
    "text": "惨遭封建迷信长辈以“避血光之灾”为由强逐至城外阴暗草棚，",
    "start": 48.065,
    "end": 53.695,
    "duration": 5.63
  },
  {
    "id": 15,
    "text": "最终在惨嚎与孤独中断气，",
    "start": 53.695,
    "end": 56.251,
    "duration": 2.556
  },
  {
    "id": 16,
    "text": "淋漓尽致地揭露了封建礼教对年轻生命的血腥吞噬。",
    "start": 56.251,
    "end": 60.371,
    "duration": 4.12
  },
  {
    "id": 17,
    "text": "第二，深刻批判封建家庭内部的“作揖主义”，",
    "start": 60.371,
    "end": 63.704,
    "duration": 3.333
  },
  {
    "id": 18,
    "text": "揭示妥协求全的性格悲剧。",
    "start": 63.704,
    "end": 66.035,
    "duration": 2.331
  },
  {
    "id": 19,
    "text": "长房长孙觉新深受“新潮”洗礼却在传统宗法重压下彻底丧失反抗意志，",
    "start": 66.035,
    "end": 72.152,
    "duration": 6.117
  },
  {
    "id": 20,
    "text": "信奉毫无原则的作揖主义与不抵抗政策。",
    "start": 72.152,
    "end": 75.505,
    "duration": 3.353
  },
  {
    "id": 21,
    "text": "面对婚姻被包办、爱人梅表姐郁郁而终、",
    "start": 75.505,
    "end": 78.591,
    "duration": 3.086
  },
  {
    "id": 22,
    "text": "妻子瑞珏横遭驱逐惨死，他处处委曲求全、委曲求全，",
    "start": 78.591,
    "end": 82.463,
    "duration": 3.872
  },
  {
    "id": 23,
    "text": "最终不仅未能保全家庭安宁，",
    "start": 82.463,
    "end": 85.874,
    "duration": 3.411
  },
  {
    "id": 24,
    "text": "反而沦为杀人礼教的无辜殉葬品与客观帮凶，",
    "start": 85.874,
    "end": 89.406,
    "duration": 3.532
  },
  {
    "id": 25,
    "text": "形成了令人深思的现代性格悲剧。",
    "start": 89.406,
    "end": 92.029,
    "duration": 2.623
  },
  {
    "id": 26,
    "text": "第三，热情歌颂叛逆青年的觉醒决裂，确立奔赴光明的新生活信念。",
    "start": 92.029,
    "end": 97.705,
    "duration": 5.676
  },
  {
    "id": 27,
    "text": "觉慧作为五四新青年的先锋典型，",
    "start": 97.705,
    "end": 100.448,
    "duration": 2.743
  },
  {
    "id": 28,
    "text": "勇敢冲破阶级门第界限与鸣凤相爱，",
    "start": 100.448,
    "end": 103.664,
    "duration": 3.216
  },
  {
    "id": 29,
    "text": "公然在捉鬼闹剧中痛斥巫医迷信，",
    "start": 103.664,
    "end": 106.585,
    "duration": 2.921
  },
  {
    "id": 30,
    "text": "面对家庭长辈的伪善压迫敢于抗争；在高老太爷暴毙、",
    "start": 106.585,
    "end": 111.184,
    "duration": 4.599
  },
  {
    "id": 31,
    "text": "旧制度轰然崩塌的时刻，",
    "start": 111.184,
    "end": 113.015,
    "duration": 1.831
  },
  {
    "id": 32,
    "text": "觉慧断然拒绝沦为封建灵堂里的守孝傀儡，",
    "start": 113.015,
    "end": 116.713,
    "duration": 3.698
  },
  {
    "id": 33,
    "text": "毅然决然登船离家东下，",
    "start": 116.713,
    "end": 118.95,
    "duration": 2.237
  },
  {
    "id": 34,
    "text": "在滔滔江水声中奔向广阔的革命与新生天地，",
    "start": 118.95,
    "end": 122.987,
    "duration": 4.037
  },
  {
    "id": 35,
    "text": "展现了冲决一切宗法网罗的时代叛逆力量。",
    "start": 122.987,
    "end": 126.048,
    "duration": 3.061
  }
]