[
  {
    "id": 1,
    "text": "三十年代至四十年代初，巴金陆续写成《家》《春》《秋》，合称《激流三部曲》，",
    "start": 0.104,
    "end": 6.195,
    "duration": 6.091
  },
  {
    "id": 2,
    "text": "是中国现代文学史上系统控诉封建宗法制度罪恶的长篇系列力作。",
    "start": 6.424,
    "end": 11.858,
    "duration": 5.434
  },
  {
    "id": 3,
    "text": "作品以成都高公馆这一封建大家庭的衰亡为轴心，其思想内容主要体现于以下三个维度：",
    "start": 12.406,
    "end": 19.226,
    "duration": 6.82
  },
  {
    "id": 4,
    "text": "第一，解剖封建宗法制度的专制腐朽，控诉礼教吃人的罪恶本质。",
    "start": 19.847,
    "end": 25.462,
    "duration": 5.615
  },
  {
    "id": 5,
    "text": "小说以高老太爷及第二代家长克明为专制权威的化身，",
    "start": 26.034,
    "end": 30.479,
    "duration": 4.445
  },
  {
    "id": 6,
    "text": "揭露大家庭以虚伪伦理对青年生命与幸福的摧残。",
    "start": 30.849,
    "end": 34.953,
    "duration": 4.104
  },
  {
    "id": 7,
    "text": "《家》中婢女鸣凤被指婚给冯乐山作妾而含恨投湖，",
    "start": 35.546,
    "end": 39.649,
    "duration": 4.103
  },
  {
    "id": 8,
    "text": "瑞珏难产之际遭迷信长辈以“避血光之灾”驱逐出城外草棚惨死；",
    "start": 39.929,
    "end": 45.331,
    "duration": 5.402
  },
  {
    "id": 9,
    "text": "及至《春》《秋》，顺从包办婚姻的蕙表妹忧郁病故，",
    "start": 45.724,
    "end": 49.94,
    "duration": 4.216
  },
  {
    "id": 10,
    "text": "幼女淑贞在恐惧压抑中投井自尽，连续血案撕开了旧礼教的残酷面目。",
    "start": 50.146,
    "end": 55.965,
    "duration": 5.819
  },
  {
    "id": 11,
    "text": "第二，批判封建家庭中的“作揖主义”，揭示妥协顺从的性格悲剧。",
    "start": 56.626,
    "end": 61.735,
    "duration": 5.109
  },
  {
    "id": 12,
    "text": "长房长孙觉新受过五四新思潮影响，却在长辈压迫与宗法责任束缚下奉行“作揖主义”与不抵抗政策。",
    "start": 62.255,
    "end": 70.413,
    "duration": 8.158
  },
  {
    "id": 13,
    "text": "面对包办婚姻、梅表姐病逝与瑞珏惨死，他处处委曲求全，",
    "start": 70.973,
    "end": 75.722,
    "duration": 4.749
  },
  {
    "id": 14,
    "text": "结果既未保住亲人，反在客观上成了旧礼教的牺牲品与帮凶；",
    "start": 75.988,
    "end": 80.848,
    "duration": 4.86
  },
  {
    "id": 15,
    "text": "直到《秋》中克明死去、高家腐化分崩，痛失亲人的觉新才逐步醒悟，走出顺从妥协的泥淖。",
    "start": 81.266,
    "end": 88.951,
    "duration": 7.685
  },
  {
    "id": 16,
    "text": "第三，歌颂叛逆青年的觉醒与反抗，宣告旧家族制度的解体。",
    "start": 89.561,
    "end": 94.885,
    "duration": 5.324
  },
  {
    "id": 17,
    "text": "《家》中五四新青年觉慧敢于打破门第观念爱恋鸣凤、痛斥捉鬼闹剧，",
    "start": 95.246,
    "end": 100.68,
    "duration": 5.434
  },
  {
    "id": 18,
    "text": "并在高老太爷病逝后断然拒绝守孝枷锁，登船离家东下；",
    "start": 101.019,
    "end": 105.617,
    "duration": 4.598
  },
  {
    "id": 19,
    "text": "到《春》中，原本怯懦的淑英亦在觉民、琴等协助下逃出囚笼抗婚出走、赴沪会合觉慧。",
    "start": 106.035,
    "end": 114.001,
    "duration": 7.966
  },
  {
    "id": 20,
    "text": "叛逆队伍的不断壮大与高家最终“树倒猢狲散”的分家结局，",
    "start": 114.134,
    "end": 118.668,
    "duration": 4.534
  },
  {
    "id": 21,
    "text": "彰显了青年一代冲决宗法网罗的时代力量。",
    "start": 118.917,
    "end": 122.148,
    "duration": 3.231
  }
]