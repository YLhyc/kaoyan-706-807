[
  {
    "id": 1,
    "text": "三十年代初，",
    "start": 0.0,
    "end": 1.422,
    "duration": 1.422
  },
  {
    "id": 2,
    "text": "巴金以《家》《春》《秋》构筑的《激流三部曲》，",
    "start": 1.422,
    "end": 4.553,
    "duration": 3.131
  },
  {
    "id": 3,
    "text": "是中国现代文学史上控诉封建宗法制度罪恶、",
    "start": 4.553,
    "end": 8.36,
    "duration": 3.807
  },
  {
    "id": 4,
    "text": "歌颂青年生命觉醒的最具震撼力的史诗画卷。",
    "start": 8.36,
    "end": 12.413,
    "duration": 4.053
  },
  {
    "id": 5,
    "text": "作品以成都高公馆这一典型封建大家族的衰亡为轴心，",
    "start": 12.413,
    "end": 16.933,
    "duration": 4.52
  },
  {
    "id": 6,
    "text": "其深刻的思想内容主要体现于以下三个维度：",
    "start": 16.933,
    "end": 21.044,
    "duration": 4.111
  },
  {
    "id": 7,
    "text": "第一，无情解剖封建宗法制度的专制腐朽，",
    "start": 21.044,
    "end": 24.324,
    "duration": 3.28
  },
  {
    "id": 8,
    "text": "控诉礼教吃人的反动本质。",
    "start": 24.324,
    "end": 26.656,
    "duration": 2.332
  },
  {
    "id": 9,
    "text": "小说以高老太爷为封建大家长权威符号，",
    "start": 26.656,
    "end": 30.296,
    "duration": 3.64
  },
  {
    "id": 10,
    "text": "揭露其以“父为子纲”的虚伪道德对青年一代自由生机的残酷扼杀。",
    "start": 30.296,
    "end": 35.933,
    "duration": 5.637
  },
  {
    "id": 11,
    "text": "婢女鸣凤被高老太爷强行指婚给同辈污浊官僚冯乐山作妾，",
    "start": 35.933,
    "end": 43.462,
    "duration": 7.529
  },
  {
    "id": 12,
    "text": "在反抗无门、绝望至极的黑夜毅然纵身跳入冰冷湖水殉节；",
    "start": 43.462,
    "end": 49.963,
    "duration": 6.501
  },
  {
    "id": 13,
    "text": "长孙媳瑞珏在难产之际，",
    "start": 49.963,
    "end": 51.726,
    "duration": 1.763
  },
  {
    "id": 14,
    "text": "惨遭封建迷信长辈以“避血光之灾”为由强逐至城外阴暗草棚，",
    "start": 51.726,
    "end": 58.517,
    "duration": 6.791
  },
  {
    "id": 15,
    "text": "最终在惨嚎与孤独中断气，",
    "start": 58.517,
    "end": 61.029,
    "duration": 2.512
  },
  {
    "id": 16,
    "text": "淋漓尽致地揭露了封建礼教对年轻生命的血腥吞噬。",
    "start": 61.029,
    "end": 66.065,
    "duration": 5.036
  },
  {
    "id": 17,
    "text": "第二，深刻批判封建家庭内部的“作揖主义”，",
    "start": 66.065,
    "end": 70.414,
    "duration": 4.349
  },
  {
    "id": 18,
    "text": "揭示妥协求全的性格悲剧。",
    "start": 70.414,
    "end": 72.181,
    "duration": 1.767
  },
  {
    "id": 19,
    "text": "长房长孙觉新深受“新潮”洗礼却在传统宗法重压下彻底丧失反抗意志，",
    "start": 72.181,
    "end": 78.621,
    "duration": 6.44
  },
  {
    "id": 20,
    "text": "信奉毫无原则的作揖主义与不抵抗政策。",
    "start": 78.621,
    "end": 83.564,
    "duration": 4.943
  },
  {
    "id": 21,
    "text": "面对婚姻被包办、爱人梅表姐郁郁而终、",
    "start": 83.564,
    "end": 85.903,
    "duration": 2.339
  },
  {
    "id": 22,
    "text": "妻子瑞珏横遭驱逐惨死，他处处委曲求全、委曲求全，",
    "start": 85.903,
    "end": 92.059,
    "duration": 6.156
  },
  {
    "id": 23,
    "text": "最终不仅未能保全家庭安宁，",
    "start": 92.059,
    "end": 95.361,
    "duration": 3.302
  },
  {
    "id": 24,
    "text": "反而沦为杀人礼教的无辜殉葬品与客观帮凶，",
    "start": 95.361,
    "end": 97.735,
    "duration": 2.374
  },
  {
    "id": 25,
    "text": "形成了令人深思的现代性格悲剧。",
    "start": 97.735,
    "end": 100.478,
    "duration": 2.743
  },
  {
    "id": 26,
    "text": "第三，热情歌颂叛逆青年的觉醒决裂，确立奔赴光明的新生活信念。",
    "start": 100.478,
    "end": 103.694,
    "duration": 3.216
  },
  {
    "id": 27,
    "text": "觉慧作为五四新青年的先锋典型，",
    "start": 103.694,
    "end": 106.615,
    "duration": 2.921
  },
  {
    "id": 28,
    "text": "勇敢冲破阶级门第界限与鸣凤相爱，",
    "start": 106.615,
    "end": 108.541,
    "duration": 1.926
  },
  {
    "id": 29,
    "text": "公然在捉鬼闹剧中痛斥巫医迷信，",
    "start": 108.541,
    "end": 111.214,
    "duration": 2.673
  },
  {
    "id": 30,
    "text": "面对家庭长辈的伪善压迫敢于抗争；在高老太爷暴毙、",
    "start": 111.214,
    "end": 113.045,
    "duration": 1.831
  },
  {
    "id": 31,
    "text": "旧制度轰然崩塌的时刻，",
    "start": 113.045,
    "end": 114.362,
    "duration": 1.317
  },
  {
    "id": 32,
    "text": "觉慧断然拒绝沦为封建灵堂里的守孝傀儡，",
    "start": 114.362,
    "end": 116.743,
    "duration": 2.381
  },
  {
    "id": 33,
    "text": "毅然决然登船离家东下，",
    "start": 116.743,
    "end": 118.98,
    "duration": 2.237
  },
  {
    "id": 34,
    "text": "在滔滔江水声中奔向广阔的革命与新生天地，",
    "start": 118.98,
    "end": 123.012,
    "duration": 4.032
  },
  {
    "id": 35,
    "text": "展现了冲决一切宗法网罗的时代叛逆力量。",
    "start": 123.012,
    "end": 126.048,
    "duration": 3.036
  }
]