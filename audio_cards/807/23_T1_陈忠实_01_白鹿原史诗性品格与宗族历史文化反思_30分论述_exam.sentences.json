[
  {
    "id": 1,
    "start": 0.08,
    "end": 3.04,
    "text": "陈忠实创作的长篇小说《白鹿原》，"
  },
  {
    "id": 2,
    "start": 3.04,
    "end": 10.16,
    "text": "是中国当代文学史上展现民族灵魂变迁最雄浑沉厚的现实主义史诗巨著。"
  },
  {
    "id": 3,
    "start": 10.16,
    "end": 14.0,
    "text": "作品以陕西关中平原白鹿村为历史缩影，"
  },
  {
    "id": 4,
    "start": 14.0,
    "end": 20.08,
    "text": "通过白鹿两大家族祖孙三代长达半个世纪的血泪恩怨与兴衰沉浮，"
  },
  {
    "id": 5,
    "start": 20.08,
    "end": 27.2,
    "text": "深刻解剖了二十世纪中国社会剧烈变革中传统宗族文化的内在韧性与裂变阵痛，"
  },
  {
    "id": 6,
    "start": 27.2,
    "end": 30.56,
    "text": "树立了当代文学审视民族历史的精神丰碑。"
  },
  {
    "id": 7,
    "start": 30.8,
    "end": 36.16,
    "text": "第一，在叙事格局上，作品构建了编年史式的宏阔时空架构，"
  },
  {
    "id": 8,
    "start": 36.16,
    "end": 39.68,
    "text": "展现出吞吐历史风云的宏大史诗性品格。"
  },
  {
    "id": 9,
    "start": 39.68,
    "end": 42.96,
    "text": "小说时间跨越从清末同治皮匠起义、"
  },
  {
    "id": 10,
    "start": 42.96,
    "end": 46.56,
    "text": "辛亥革命、军阀混战、国共合作与对峙，"
  },
  {
    "id": 11,
    "start": 46.56,
    "end": 49.84,
    "text": "直至新中国建立前夕的数十年动荡历史。"
  },
  {
    "id": 12,
    "start": 49.84,
    "end": 54.0,
    "text": "陈忠实打破了传统政治意识形态挂帅的公式化叙事，"
  },
  {
    "id": 13,
    "start": 54.0,
    "end": 57.12,
    "text": "开辟了巴尔扎克式“民间秘史”的深邃视角。"
  },
  {
    "id": 14,
    "start": 57.36,
    "end": 60.88,
    "text": "白鹿两家为争夺族长权力、换地建坟、"
  },
  {
    "id": 15,
    "start": 60.88,
    "end": 64.96,
    "text": "以及后代子嗣在国共阵营之间的生死撕杀，"
  },
  {
    "id": 16,
    "start": 64.96,
    "end": 68.8,
    "text": "与外部世界翻天覆地的历史巨浪严密咬合。"
  },
  {
    "id": 17,
    "start": 68.8,
    "end": 73.36,
    "text": "风车水转的时代狂澜落脚于关中农民的生死稼瑟之中，"
  },
  {
    "id": 18,
    "start": 73.36,
    "end": 80.16,
    "text": "全方位绘制了一幅中国北方乡村社会在现代转型期血泪交织的历史全景图。"
  },
  {
    "id": 19,
    "start": 80.536,
    "end": 86.456,
    "text": "第二，在思想精神与人物塑造上，作品以冷峻深邃的文化反思眼光，"
  },
  {
    "id": 20,
    "start": 86.456,
    "end": 92.456,
    "text": "深刻剖析了儒家宗法伦理的坚韧生命力与其扼杀个体人性的双重面向。"
  },
  {
    "id": 21,
    "start": 92.456,
    "end": 96.536,
    "text": "白嘉轩是作品耗费心血塑造的宗法家族精神支柱。"
  },
  {
    "id": 22,
    "start": 96.536,
    "end": 100.696,
    "text": "他腰杆挺得笔直，严格恪守“耕读传家”的儒家纲常，"
  },
  {
    "id": 23,
    "start": 100.696,
    "end": 103.896,
    "text": "在面对兵荒马乱与瘟疫饥荒时沉着坚毅，"
  },
  {
    "id": 24,
    "start": 103.896,
    "end": 107.336,
    "text": "展现出中国传统士农阶层深沉的人格硬气。"
  },
  {
    "id": 25,
    "start": 107.656,
    "end": 110.456,
    "text": "然而，这种儒家道德一旦走向极端，"
  },
  {
    "id": 26,
    "start": 110.456,
    "end": 113.576,
    "text": "便暴露出残酷冷酷的噬人本质。"
  },
  {
    "id": 27,
    "start": 113.576,
    "end": 118.376,
    "text": "白嘉轩严惩赌徒、用枣刺鞭吃败坏门风的亲侄子，"
  },
  {
    "id": 28,
    "start": 118.376,
    "end": 123.336,
    "text": "乃至在田小娥死后联合村民建造“镇魂塔”压制其阴魂，"
  },
  {
    "id": 29,
    "start": 123.336,
    "end": 128.456,
    "text": "无情体现了封建宗族制度对底层叛逆女性自由情欲的残忍剿灭。"
  },
  {
    "id": 30,
    "start": 128.776,
    "end": 134.216,
    "text": "相比之下，鹿子霖则是见风使舵、私欲膨胀的投机者典型，"
  },
  {
    "id": 31,
    "start": 134.216,
    "end": 139.016,
    "text": "两人互为表里，共同构成了中国乡村宗法社会的复杂生态。"
  },
  {
    "id": 32,
    "start": 139.016,
    "end": 143.416,
    "text": "而关中圣人朱先生则是传统儒家文化精神升华的象征，"
  },
  {
    "id": 33,
    "start": 143.416,
    "end": 146.856,
    "text": "他在白鹿书院清修静观，超越党派恩怨，"
  },
  {
    "id": 34,
    "start": 146.856,
    "end": 153.336,
    "text": "具有洞察历史兴亡的先知智慧，寄托着作者对民族优秀传统文化哲理的深情敬意。"
  },
  {
    "id": 35,
    "start": 153.576,
    "end": 163.096,
    "text": "第三，在美学形态与艺术手法上，作品成功实现了原生态关中乡土写实与魔幻神秘主义象征手法的深度融合。"
  },
  {
    "id": 36,
    "start": 163.096,
    "end": 166.136,
    "text": "陈忠实以浓烈浑厚的关中方言为底色，"
  },
  {
    "id": 37,
    "start": 166.136,
    "end": 169.016,
    "text": "生动还原了关中平原的祭祖、修谱、"
  },
  {
    "id": 38,
    "start": 169.016,
    "end": 174.616,
    "text": "祈雨、秦腔与饮食风尚，全书洋溢着苍茫雄浑的原生态地域气息。"
  },
  {
    "id": 39,
    "start": 174.936,
    "end": 180.136,
    "text": "同时，小说创造性地吸收了拉美魔幻现实主义的艺术养分，"
  },
  {
    "id": 40,
    "start": 180.136,
    "end": 183.256,
    "text": "引入了贯穿全篇的“白鹿”精灵传说。"
  },
  {
    "id": 41,
    "start": 183.256,
    "end": 189.016,
    "text": "那只在原野上跃动的雪白神鹿，不仅是这片土地吉祥宁静的文化图腾，"
  },
  {
    "id": 42,
    "start": 189.016,
    "end": 193.816,
    "text": "更象征着超越现实苦难的纯洁人性与历史理想。"
  },
  {
    "id": 43,
    "start": 193.816,
    "end": 197.896,
    "text": "田小娥死后化为飞蛾引发瘟疫的超自然情节，"
  },
  {
    "id": 44,
    "start": 197.896,
    "end": 201.336,
    "text": "与冷峻扎实的现实主义白描互为交融，"
  },
  {
    "id": 45,
    "start": 201.336,
    "end": 205.256,
    "text": "赋予了整部史诗以奇诡神秘的哲学神秘感。"
  },
  {
    "id": 46,
    "start": 205.496,
    "end": 209.816,
    "text": "综上所述，陈忠实《白鹿原》以宏大壮阔的历史容量、"
  },
  {
    "id": 47,
    "start": 209.816,
    "end": 214.056,
    "text": "深沉严峻的宗族文化剖析与雄浑苍劲的地域艺术品格，"
  },
  {
    "id": 48,
    "start": 214.056,
    "end": 218.936,
    "text": "在中国当代长篇小说史上构筑了一座气象万千的艺术高峰。"
  },
  {
    "id": 49,
    "start": 218.936,
    "end": 223.256,
    "text": "它不仅是对渭北高原上数代人生命悲欢的深沉挽歌，"
  },
  {
    "id": 50,
    "start": 223.256,
    "end": 228.296,
    "text": "更是对中华民族近代精神新生所经历的艰难阵痛的庄严立碑。"
  }
]