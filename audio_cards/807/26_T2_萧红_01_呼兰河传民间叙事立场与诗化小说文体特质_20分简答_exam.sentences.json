[
  {
    "id": 1,
    "text": "题型，二十分简答题。",
    "start": 0.08,
    "end": 1.92,
    "duration": 1.84
  },
  {
    "id": 2,
    "text": "分值，二十分。",
    "start": 1.92,
    "end": 3.36,
    "duration": 1.44
  },
  {
    "id": 3,
    "text": "建议考场时间，二十分钟。",
    "start": 3.36,
    "end": 5.44,
    "duration": 2.08
  },
  {
    "id": 4,
    "text": "目标字数，五百五十到六百五十字。",
    "start": 5.44,
    "end": 8.4,
    "duration": 2.96
  },
  {
    "id": 5,
    "text": "答题骨架，文体定性、趋近于、民间叙事立场与国民麻木悲敏剖析、",
    "start": 8.4,
    "end": 14.16,
    "duration": 5.76
  },
  {
    "id": 6,
    "text": "趋近于、散文化诗意结构与后花园象征美学、",
    "start": 14.16,
    "end": 18.24,
    "duration": 4.08
  },
  {
    "id": 7,
    "text": "趋近于、总结史学地位。",
    "start": 18.24,
    "end": 20.56,
    "duration": 2.32
  },
  {
    "id": 8,
    "text": "萧红创作于香港流亡时期的长篇小说《呼兰河传》，",
    "start": 20.56,
    "end": 24.48,
    "duration": 3.92
  },
  {
    "id": 9,
    "text": "是中国现代文学史上一部兼具深沉乡土记忆与卓越文体创新的诗化小说杰作。",
    "start": 24.48,
    "end": 30.4,
    "duration": 5.92
  },
  {
    "id": 10,
    "text": "茅盾曾盛赞其为“一篇叙事诗，一幅多彩的风土画，",
    "start": 30.72,
    "end": 35.36,
    "duration": 4.64
  },
  {
    "id": 11,
    "text": "一串凄婉的歌谣”。",
    "start": 35.36,
    "end": 37.2,
    "duration": 1.84
  },
  {
    "id": 12,
    "text": "作品以独特的民间叙事立场与非传统的散文化小说形制，",
    "start": 37.2,
    "end": 42.32,
    "duration": 5.12
  },
  {
    "id": 13,
    "text": "展现了东北小城荒凉灰暗的生存图景。",
    "start": 42.32,
    "end": 46.08,
    "duration": 3.76
  },
  {
    "id": 14,
    "text": "首先，在民间叙事立场上，小说创造性地采用“童稚视角”与“成熟叙述者冷峻反思”相交织的复调视点，",
    "start": 46.08,
    "end": 55.52,
    "duration": 9.44
  },
  {
    "id": 15,
    "text": "对民间苦难与国民劣根性进行了深沉的悲敏审视。",
    "start": 55.52,
    "end": 59.84,
    "duration": 4.32
  },
  {
    "id": 16,
    "text": "作者以孩子纯真无邪的目光，打量呼兰河小镇的大泥坑、",
    "start": 60.24,
    "end": 64.48,
    "duration": 4.24
  },
  {
    "id": 17,
    "text": "跳大神、放河灯与唱野戏等民间风俗。",
    "start": 64.48,
    "end": 68.56,
    "duration": 4.08
  },
  {
    "id": 18,
    "text": "在这幅看似平静的风俗画卷下，掩藏着令人窒息的愚昧与残忍。",
    "start": 68.56,
    "end": 74.32,
    "duration": 5.76
  },
  {
    "id": 19,
    "text": "小团圆媳妇本是一个健康爱笑的十二岁少女，",
    "start": 74.32,
    "end": 78.08,
    "duration": 3.76
  },
  {
    "id": 20,
    "text": "却被婆婆与全村看客以“治病”之名，",
    "start": 78.08,
    "end": 81.2,
    "duration": 3.12
  },
  {
    "id": 21,
    "text": "在大庭广众之下用滚烫的热水当众连洗三次，",
    "start": 81.2,
    "end": 85.52,
    "duration": 4.32
  },
  {
    "id": 22,
    "text": "在众人的愚昧喧嚣中被活活折磨致死。",
    "start": 85.52,
    "end": 88.8,
    "duration": 3.28
  },
  {
    "id": 23,
    "text": "萧红以冷静克制的笔调，深刻揭露了封建礼教与迷信毒瘤在底层民间社会的自发运转，",
    "start": 89.2,
    "end": 96.72,
    "duration": 7.52
  },
  {
    "id": 24,
    "text": "哀其不幸，怒其不争。",
    "start": 96.72,
    "end": 98.88,
    "duration": 2.16
  },
  {
    "id": 25,
    "text": "其次，在文体特质上，作品彻底打破了近代小说讲求起承转合与强冲突的戏剧化规约，",
    "start": 98.88,
    "end": 106.56,
    "duration": 7.68
  },
  {
    "id": 26,
    "text": "开辟了形散神聚的散文诗小说新范式。",
    "start": 106.56,
    "end": 109.6,
    "duration": 3.04
  },
  {
    "id": 27,
    "text": "全书没有贯穿始终的主人公与核心情节线索，",
    "start": 109.92,
    "end": 113.6,
    "duration": 3.68
  },
  {
    "id": 28,
    "text": "而是由若干相对独立的风俗片断与人物掠影拼接而成。",
    "start": 113.6,
    "end": 118.4,
    "duration": 4.8
  },
  {
    "id": 29,
    "text": "作者以舒缓绵密、纯净本色的语言，",
    "start": 118.4,
    "end": 121.6,
    "duration": 3.2
  },
  {
    "id": 30,
    "text": "营造出一种荒凉幽远、回环往复的音乐韵律。",
    "start": 121.6,
    "end": 125.44,
    "duration": 3.84
  },
  {
    "id": 31,
    "text": "小说中祖父温暖的后花园，充满了倭瓜、",
    "start": 125.44,
    "end": 128.72,
    "duration": 3.28
  },
  {
    "id": 32,
    "text": "黄瓜与蝴蝶自由生长的生机，构成了全书最温暖的生命避难所，",
    "start": 128.72,
    "end": 133.76,
    "duration": 5.04
  },
  {
    "id": 33,
    "text": "与呼兰河城冰冷僵死的严冬风俗形成强烈的美学对照，",
    "start": 133.76,
    "end": 138.48,
    "duration": 4.72
  },
  {
    "id": 34,
    "text": "在诗意抒情中熔铸出沉重的历史苍凉感。",
    "start": 138.48,
    "end": 142.0,
    "duration": 3.52
  },
  {
    "id": 35,
    "text": "综上所述，萧红《呼兰河传》以清澈悲敏的民间立场穿透了小镇的愚昧坚冰，",
    "start": 142.304,
    "end": 148.784,
    "duration": 6.48
  },
  {
    "id": 36,
    "text": "以自由洒脱的诗意笔触重构了现代小说的文体边界。",
    "start": 148.784,
    "end": 153.344,
    "duration": 4.56
  },
  {
    "id": 37,
    "text": "它以凄婉绝美的人性哀歌，在中国现代乡土文学长廊中留下了不可复制的独特光彩。",
    "start": 153.344,
    "end": 159.984,
    "duration": 6.64
  }
]