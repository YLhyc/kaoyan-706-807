[
  {
    "id": 1,
    "text": "试论郭沫若历史剧《屈原》的浪漫主义特质与时代借古讽今意蕴。",
    "start": 0.134,
    "end": 5.186,
    "duration": 5.052
  },
  {
    "id": 2,
    "text": "抗日战争相持阶段，郭沫若创作的五幕历史剧《屈原》，是中国现代话剧史与历史剧创作的代表作。",
    "start": 5.863,
    "end": 13.635,
    "duration": 7.772
  },
  {
    "id": 3,
    "text": "作品诞生于大后方“皖南事变”后的政治阴云之中，",
    "start": 14.313,
    "end": 18.005,
    "duration": 3.692
  },
  {
    "id": 4,
    "text": "作者将深沉的历史意识与炽烈的现实感融为一体，",
    "start": 18.384,
    "end": 21.916,
    "duration": 3.532
  },
  {
    "id": 5,
    "text": "创造性地践行了“失事求似”的历史剧原则，",
    "start": 22.424,
    "end": 25.436,
    "duration": 3.012
  },
  {
    "id": 6,
    "text": "塑造了极具崇高感与殉道精神的悲剧英雄，并在战时大后方鼓舞了民族民主抗争。",
    "start": 25.815,
    "end": 31.827,
    "duration": 6.012
  },
  {
    "id": 7,
    "text": "其思想意蕴与艺术成就主要体现在以下四个方面：",
    "start": 32.565,
    "end": 41.977,
    "duration": 9.412
  },
  {
    "id": 8,
    "text": "第一，践行“失事求似”美学原则，构筑借古讽今的现实批判锋芒。",
    "start": 42.655,
    "end": 53.467,
    "duration": 10.812
  },
  {
    "id": 9,
    "text": "郭沫若认为历史剧创作重在把握历史精神，而非拘泥于琐碎考据，",
    "start": 54.145,
    "end": 57.117,
    "duration": 2.972
  },
  {
    "id": 10,
    "text": "主张“失事求似”，即允许在次要史事上大胆虚构以开掘历史本质。",
    "start": 57.496,
    "end": 60.908,
    "duration": 3.412
  },
  {
    "id": 11,
    "text": "全剧写战国时期屈原坚持联齐抗秦、遭南后郑袖与靳尚诬陷放逐的生死博弈，",
    "start": 61.546,
    "end": 69.278,
    "duration": 7.732
  },
  {
    "id": 12,
    "text": "实质上直指战时重庆国民党统治集团：",
    "start": 69.657,
    "end": 73.269,
    "duration": 3.612
  },
  {
    "id": 13,
    "text": "华美阴鸷的南后、挑拨离间的秦相张仪与昏聩专断的楚怀王，",
    "start": 73.947,
    "end": 76.879,
    "duration": 2.932
  },
  {
    "id": 14,
    "text": "直接影射国民党消极抗日、积极反共的倒行逆施。",
    "start": 77.258,
    "end": 79.55,
    "duration": 2.292
  },
  {
    "id": 15,
    "text": "郭沫若借历史外壳装载现实批判烈火，赋予史剧鲜明的时代战斗品格。",
    "start": 80.268,
    "end": 85.32,
    "duration": 5.052
  },
  {
    "id": 16,
    "text": "第二，承续早期浪漫主义激情，塑造崇高刚烈的悲剧英雄人格。",
    "start": 86.038,
    "end": 94.05,
    "duration": 8.012
  },
  {
    "id": 17,
    "text": "不同于曹禺写实戏剧对家庭伦理与隐微心理的剖析，",
    "start": 94.728,
    "end": 98.9,
    "duration": 4.172
  },
  {
    "id": 18,
    "text": "郭沫若将《女神》时期奔涌的抒情激情注入戏剧之中。",
    "start": 99.279,
    "end": 103.651,
    "duration": 4.372
  },
  {
    "id": 19,
    "text": "剧中的屈原脱离了传统史传中哀怨悱恻的失意文人形象，",
    "start": 104.289,
    "end": 105.701,
    "duration": 1.412
  },
  {
    "id": 20,
    "text": "被重塑为大义凛然、坚守政治理想与民族气节的崇高英雄。",
    "start": 106.08,
    "end": 107.362,
    "duration": 1.282
  },
  {
    "id": 21,
    "text": "他面对群小威逼利诱始终傲骨铮铮；",
    "start": 108.08,
    "end": 111.692,
    "duration": 3.612
  },
  {
    "id": 22,
    "text": "虚构人物婵娟与宋玉的对照更凸显其品格：",
    "start": 112.221,
    "end": 118.273,
    "duration": 6.052
  },
  {
    "id": 23,
    "text": "婵娟误饮鸩酒而在客观上代屈原殉难，映照出真理追随者的纯洁忠贞；",
    "start": 118.951,
    "end": 122.243,
    "duration": 3.292
  },
  {
    "id": 24,
    "text": "宋玉由崇拜屈原堕落为依附权贵的弄臣，反衬出屈原挺立不屈的人格伟力。",
    "start": 122.772,
    "end": 125.544,
    "duration": 2.772
  },
  {
    "id": 25,
    "text": "第三，以第五幕《雷电颂》抒情独白为高潮，确立诗剧合一的美学典范。",
    "start": 126.168,
    "end": 131.82,
    "duration": 5.652
  },
  {
    "id": 26,
    "text": "全剧在第五幕达到戏剧冲突与诗性审美的顶点。",
    "start": 132.349,
    "end": 136.121,
    "duration": 3.772
  },
  {
    "id": 27,
    "text": "屈原被囚于东皇太一庙中，面对沉沉黑夜与漫天风雨，迸发出激越雄浑的抒情独白《雷电颂》。",
    "start": 136.799,
    "end": 144.451,
    "duration": 7.652
  },
  {
    "id": 28,
    "text": "作者将屈原内心的悲愤与宇宙雷电暴风融为一体，",
    "start": 145.129,
    "end": 146.661,
    "duration": 1.532
  },
  {
    "id": 29,
    "text": "呼喊“风！你咆哮吧！咆哮吧！尽力地咆哮吧！”，祈求雷电撕碎黑暗、将泥胎木雕炸裂粉碎。",
    "start": 147.04,
    "end": 150.242,
    "duration": 3.202
  },
  {
    "id": 30,
    "text": "这段长篇自由体独白突破了传统写实戏剧对外部动作的局限，",
    "start": 151.08,
    "end": 151.412,
    "duration": 0.332
  },
  {
    "id": 31,
    "text": "以回环往复的排比句式将舞台冲突升华为内心激情的诗意宣泄，树立了现代抒情诗剧的典范。",
    "start": 151.791,
    "end": 152.273,
    "duration": 0.482
  },
  {
    "id": 32,
    "text": "第四，激活战时剧场动员机制，确立浪漫主义历史剧的经典范式。",
    "start": 153.031,
    "end": 153.603,
    "duration": 0.572
  },
  {
    "id": 33,
    "text": "该剧在重庆国泰大戏院首演即引起强烈反响，有力呼应了战时大后方反独裁、争民主的呼声。",
    "start": 154.281,
    "end": 159.503,
    "duration": 5.222
  },
  {
    "id": 34,
    "text": "它摆脱了考据派历史剧的沉闷说教，将案头诗意与剧场感染力结合起来，",
    "start": 160.181,
    "end": 164.993,
    "duration": 4.812
  },
  {
    "id": 35,
    "text": "使观众在剧场中与屈原的命运产生强烈共鸣，舞台由此化为凝聚反抗意志的公共空间。",
    "start": 165.372,
    "end": 173.144,
    "duration": 7.772
  },
  {
    "id": 36,
    "text": "郭沫若将诗的激情、史的沉思与剧的冲突融为一体，",
    "start": 173.822,
    "end": 176.474,
    "duration": 2.652
  },
  {
    "id": 37,
    "text": "成功建立了独具民族特色的现代浪漫主义历史剧范式。",
    "start": 176.853,
    "end": 179.345,
    "duration": 2.492
  },
  {
    "id": 38,
    "text": "总览全剧，郭沫若历史剧《屈原》以借古讽今的历史眼光、崇高刚烈的英雄品格与诗剧交融的美学建构，",
    "start": 180.023,
    "end": 186.355,
    "duration": 6.332
  },
  {
    "id": 39,
    "text": "开辟了中国现代话剧的抒情诗化道路。",
    "start": 186.734,
    "end": 187.706,
    "duration": 0.972
  },
  {
    "id": 40,
    "text": "它在抗战文艺史上留下了深刻印记，成为中国现代浪漫主义历史剧的经典之作。",
    "start": 188.424,
    "end": 228.047,
    "duration": 39.623
  }
]