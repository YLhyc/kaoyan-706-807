[
  {
    "id": 1,
    "text": "试论郭沫若历史剧《屈原》的浪漫主义特质与时代借古讽今意蕴。",
    "start": 0.16,
    "end": 5.222,
    "duration": 5.062
  },
  {
    "id": 2,
    "text": "抗日战争相持阶段，郭沫若创作的五幕历史剧《屈原》，",
    "start": 5.621,
    "end": 9.836,
    "duration": 4.215
  },
  {
    "id": 3,
    "text": "是中国现代话剧史与历史剧创作的代表作。",
    "start": 10.141,
    "end": 13.344,
    "duration": 3.203
  },
  {
    "id": 4,
    "text": "作品诞生于大后方“皖南事变”后的政治阴云之中，",
    "start": 13.84,
    "end": 17.234,
    "duration": 3.394
  },
  {
    "id": 5,
    "text": "作者将深沉的历史意识与炽烈的现实感融为一体，",
    "start": 17.61,
    "end": 21.368,
    "duration": 3.758
  },
  {
    "id": 6,
    "text": "创造性地践行了“失事求似”的历史剧原则，",
    "start": 21.624,
    "end": 24.878,
    "duration": 3.254
  },
  {
    "id": 7,
    "text": "塑造了极具崇高感与殉道精神的悲剧英雄，并在战时大后方鼓舞了民族民主抗争。",
    "start": 25.031,
    "end": 31.999,
    "duration": 6.968
  },
  {
    "id": 8,
    "text": "其思想意蕴与艺术成就主要体现在以下四个方面：",
    "start": 32.325,
    "end": 36.043,
    "duration": 3.718
  },
  {
    "id": 9,
    "text": "第一，践行“失事求似”美学原则，构筑借古讽今的现实批判锋芒。",
    "start": 36.647,
    "end": 42.476,
    "duration": 5.829
  },
  {
    "id": 10,
    "text": "郭沫若认为历史剧创作重在把握历史精神，而非拘泥于琐碎考据，",
    "start": 42.75,
    "end": 47.894,
    "duration": 5.144
  },
  {
    "id": 11,
    "text": "主张“失事求似”，即允许在次要史事上大胆虚构以开掘历史本质。",
    "start": 48.329,
    "end": 53.848,
    "duration": 5.519
  },
  {
    "id": 12,
    "text": "全剧写战国时期屈原坚持联齐抗秦、遭南后郑袖与靳尚诬陷放逐的生死博弈，",
    "start": 54.414,
    "end": 61.153,
    "duration": 6.739
  },
  {
    "id": 13,
    "text": "实质上直指战时重庆国民党统治集团：",
    "start": 61.416,
    "end": 64.881,
    "duration": 3.465
  },
  {
    "id": 14,
    "text": "华美阴鸷的南后、出卖国家利益的张仪与昏聩专断的楚怀王，",
    "start": 65.133,
    "end": 70.222,
    "duration": 5.089
  },
  {
    "id": 15,
    "text": "直接影射国民党消极抗日、积极反共的倒行逆施。",
    "start": 70.377,
    "end": 74.777,
    "duration": 4.4
  },
  {
    "id": 16,
    "text": "郭沫若借历史外壳装载现实批判烈火，赋予史剧鲜明的时代战斗品格。",
    "start": 75.063,
    "end": 80.723,
    "duration": 5.66
  },
  {
    "id": 17,
    "text": "第二，承续早期浪漫主义激情，塑造崇高刚烈的悲剧英雄人格。",
    "start": 81.346,
    "end": 86.865,
    "duration": 5.519
  },
  {
    "id": 18,
    "text": "不同于曹禺写实戏剧对家庭伦理与隐微心理的剖析，",
    "start": 87.469,
    "end": 91.661,
    "duration": 4.192
  },
  {
    "id": 19,
    "text": "郭沫若将《女神》时期奔涌的抒情激情注入戏剧之中。",
    "start": 92.115,
    "end": 96.233,
    "duration": 4.118
  },
  {
    "id": 20,
    "text": "剧中的屈原脱离了传统史传中哀怨悱恻的失意文人形象，",
    "start": 96.635,
    "end": 101.485,
    "duration": 4.85
  },
  {
    "id": 21,
    "text": "被重塑为大义凛然、坚守政治理想与民族气节的崇高英雄。",
    "start": 101.745,
    "end": 106.375,
    "duration": 4.63
  },
  {
    "id": 22,
    "text": "他面对群小威逼利诱始终傲骨铮铮；",
    "start": 106.64,
    "end": 109.687,
    "duration": 3.047
  },
  {
    "id": 23,
    "text": "虚构人物婵娟与宋玉的对照更凸显其品格：",
    "start": 109.824,
    "end": 113.318,
    "duration": 3.494
  },
  {
    "id": 24,
    "text": "婵娟误饮鸩酒代屈原殉道，映照出真理追随者的纯洁忠贞；",
    "start": 113.51,
    "end": 118.477,
    "duration": 4.967
  },
  {
    "id": 25,
    "text": "宋玉由崇拜屈原堕落为依附权贵的弄臣，反衬出屈原挺立不屈的人格伟力。",
    "start": 118.648,
    "end": 124.918,
    "duration": 6.27
  },
  {
    "id": 26,
    "text": "第三，以第五幕《雷电颂》抒情独白为高潮，确立诗剧合一的美学典范。",
    "start": 125.553,
    "end": 131.337,
    "duration": 5.784
  },
  {
    "id": 27,
    "text": "全剧在第五幕达到戏剧冲突与诗性审美的顶点。",
    "start": 131.906,
    "end": 136.057,
    "duration": 4.151
  },
  {
    "id": 28,
    "text": "屈原被囚于东皇太一庙中，面对沉沉黑夜与漫天风雨，迸发出激越雄浑的抒情独白《雷电颂》。",
    "start": 136.506,
    "end": 144.901,
    "duration": 8.395
  },
  {
    "id": 29,
    "text": "作者将屈原内心的悲愤与宇宙雷电暴风融为一体，",
    "start": 145.447,
    "end": 150.093,
    "duration": 4.646
  },
  {
    "id": 30,
    "text": "呼喊“风！你咆哮吧！咆哮吧！尽力地咆哮吧！”，祈求雷电撕碎黑暗、将泥胎木雕炸裂粉碎。",
    "start": 150.327,
    "end": 158.194,
    "duration": 7.867
  },
  {
    "id": 31,
    "text": "这段长篇自由体独白突破了传统写实戏剧对外部动作的局限，",
    "start": 158.767,
    "end": 163.768,
    "duration": 5.001
  },
  {
    "id": 32,
    "text": "以回环往复的排比句式将舞台冲突升华为内心激情的诗意宣泄，树立了现代抒情诗剧的典范。",
    "start": 164.127,
    "end": 171.981,
    "duration": 7.854
  },
  {
    "id": 33,
    "text": "第四，激活战时剧场动员机制，确立浪漫主义历史剧的经典范式。",
    "start": 172.571,
    "end": 177.466,
    "duration": 4.895
  },
  {
    "id": 34,
    "text": "该剧在重庆国泰大戏院首演即引起强烈反响，有力呼应了战时大后方反独裁、争民主的呼声。",
    "start": 177.926,
    "end": 185.384,
    "duration": 7.458
  },
  {
    "id": 35,
    "text": "它摆脱了考据派历史剧的沉闷说教，将案头诗意与剧场感染力结合起来，",
    "start": 185.743,
    "end": 191.445,
    "duration": 5.702
  },
  {
    "id": 36,
    "text": "使观众在剧场中与屈原的命运产生强烈共鸣，舞台由此化为凝聚反抗意志的公共空间。",
    "start": 191.693,
    "end": 198.52,
    "duration": 6.827
  },
  {
    "id": 37,
    "text": "郭沫若将诗的激情、史的沉思与剧的冲突融为一体，",
    "start": 198.835,
    "end": 203.037,
    "duration": 4.202
  },
  {
    "id": 38,
    "text": "成功建立了独具民族特色的现代浪漫主义历史剧范式。",
    "start": 203.37,
    "end": 207.343,
    "duration": 3.973
  },
  {
    "id": 39,
    "text": "总览全剧，郭沫若历史剧《屈原》以借古讽今的历史眼光、崇高刚烈的英雄品格与诗剧交融的美学建构，",
    "start": 207.999,
    "end": 216.411,
    "duration": 8.412
  },
  {
    "id": 40,
    "text": "开辟了中国现代话剧的抒情诗化道路。",
    "start": 216.745,
    "end": 219.467,
    "duration": 2.722
  },
  {
    "id": 41,
    "text": "它在抗战文艺史上留下了深刻印记，成为中国现代浪漫主义历史剧的经典之作。",
    "start": 219.867,
    "end": 225.728,
    "duration": 5.861
  }
]