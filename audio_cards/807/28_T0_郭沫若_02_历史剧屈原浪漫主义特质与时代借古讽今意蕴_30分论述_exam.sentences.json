[
  {
    "id": 1,
    "text": "试论郭沫若历史剧《屈原》的浪漫主义特质与时代借古讽今意蕴。",
    "start": 0.16,
    "end": 5.212,
    "duration": 5.052
  },
  {
    "id": 2,
    "text": "抗日战争相持阶段，郭沫若创作的五幕历史剧《屈原》，",
    "start": 5.621,
    "end": 9.829,
    "duration": 4.208
  },
  {
    "id": 3,
    "text": "是中国现代话剧史与历史剧创作的代表作。",
    "start": 10.141,
    "end": 13.338,
    "duration": 3.197
  },
  {
    "id": 4,
    "text": "作品诞生于大后方“皖南事变”后的政治阴云之中，",
    "start": 13.84,
    "end": 17.224,
    "duration": 3.384
  },
  {
    "id": 5,
    "text": "作者将深沉的历史意识与炽烈的现实感融为一体，",
    "start": 17.61,
    "end": 21.369,
    "duration": 3.759
  },
  {
    "id": 6,
    "text": "创造性地践行了“失事求似”的历史剧原则，",
    "start": 21.624,
    "end": 24.868,
    "duration": 3.244
  },
  {
    "id": 7,
    "text": "塑造了极具崇高感与殉道精神的悲剧英雄，",
    "start": 25.031,
    "end": 28.59,
    "duration": 3.559
  },
  {
    "id": 8,
    "text": "并在战时大后方鼓舞了民族民主抗争。",
    "start": 28.744,
    "end": 31.989,
    "duration": 3.245
  },
  {
    "id": 9,
    "text": "其思想意蕴与艺术成就主要体现在以下四个方面：",
    "start": 32.325,
    "end": 36.033,
    "duration": 3.708
  },
  {
    "id": 10,
    "text": "第一，践行“失事求似”美学原则，构筑借古讽今的现实批判锋芒。",
    "start": 36.647,
    "end": 42.466,
    "duration": 5.819
  },
  {
    "id": 11,
    "text": "郭沫若认为历史剧创作重在把握历史精神，",
    "start": 42.75,
    "end": 45.846,
    "duration": 3.096
  },
  {
    "id": 12,
    "text": "而非拘泥于琐碎考据，主张“失事求似”，",
    "start": 46.266,
    "end": 49.548,
    "duration": 3.282
  },
  {
    "id": 13,
    "text": "即允许在次要史事上大胆虚构以开掘历史本质。",
    "start": 49.802,
    "end": 53.838,
    "duration": 4.036
  },
  {
    "id": 14,
    "text": "全剧写战国时期屈原坚持联齐抗秦、",
    "start": 54.414,
    "end": 57.55,
    "duration": 3.136
  },
  {
    "id": 15,
    "text": "遭南后郑袖与靳尚诬陷放逐的生死博弈，",
    "start": 57.855,
    "end": 61.143,
    "duration": 3.288
  },
  {
    "id": 16,
    "text": "实质上直指战时重庆国民党统治集团：华美阴鸷的南后、",
    "start": 61.416,
    "end": 66.339,
    "duration": 4.923
  },
  {
    "id": 17,
    "text": "出卖国家利益的张仪与昏聩专断的楚怀王，",
    "start": 66.877,
    "end": 70.212,
    "duration": 3.335
  },
  {
    "id": 18,
    "text": "直接影射国民党消极抗日、积极反共的倒行逆施。",
    "start": 70.377,
    "end": 74.767,
    "duration": 4.39
  },
  {
    "id": 19,
    "text": "郭沫若借历史外壳装载现实批判烈火，",
    "start": 75.063,
    "end": 77.914,
    "duration": 2.851
  },
  {
    "id": 20,
    "text": "赋予史剧鲜明的时代战斗品格。",
    "start": 78.198,
    "end": 80.713,
    "duration": 2.515
  },
  {
    "id": 21,
    "text": "第二，承续早期浪漫主义激情，塑造崇高刚烈的悲剧英雄人格。",
    "start": 81.346,
    "end": 86.855,
    "duration": 5.509
  },
  {
    "id": 22,
    "text": "不同于曹禺写实戏剧对家庭伦理与隐微心理的剖析，",
    "start": 87.469,
    "end": 91.651,
    "duration": 4.182
  },
  {
    "id": 23,
    "text": "郭沫若将《女神》时期奔涌的抒情激情注入戏剧之中。",
    "start": 92.115,
    "end": 96.223,
    "duration": 4.108
  },
  {
    "id": 24,
    "text": "剧中的屈原脱离了传统史传中哀怨悱恻的失意文人形象，",
    "start": 96.635,
    "end": 101.475,
    "duration": 4.84
  },
  {
    "id": 25,
    "text": "被重塑为大义凛然、坚守政治理想与民族气节的崇高英雄。",
    "start": 101.745,
    "end": 106.365,
    "duration": 4.62
  },
  {
    "id": 26,
    "text": "他面对群小威逼利诱始终傲骨铮铮；",
    "start": 106.64,
    "end": 109.677,
    "duration": 3.037
  },
  {
    "id": 27,
    "text": "虚构人物婵娟与宋玉的对照更凸显其品格：",
    "start": 109.824,
    "end": 113.308,
    "duration": 3.484
  },
  {
    "id": 28,
    "text": "婵娟误饮鸩酒代屈原殉道，映照出真理追随者的纯洁忠贞；",
    "start": 113.51,
    "end": 118.467,
    "duration": 4.957
  },
  {
    "id": 29,
    "text": "宋玉由崇拜屈原堕落为依附权贵的弄臣，",
    "start": 118.648,
    "end": 122.013,
    "duration": 3.365
  },
  {
    "id": 30,
    "text": "反衬出屈原挺立不屈的人格伟力。",
    "start": 122.24,
    "end": 124.908,
    "duration": 2.668
  },
  {
    "id": 31,
    "text": "第三，以第五幕《雷电颂》抒情独白为高潮，",
    "start": 125.553,
    "end": 129.07,
    "duration": 3.517
  },
  {
    "id": 32,
    "text": "确立诗剧合一的美学典范。",
    "start": 129.394,
    "end": 131.339,
    "duration": 1.945
  },
  {
    "id": 33,
    "text": "全剧在第五幕达到戏剧冲突与诗性审美的顶点。",
    "start": 131.906,
    "end": 136.047,
    "duration": 4.141
  },
  {
    "id": 34,
    "text": "屈原被囚于东皇太一庙中，面对沉沉黑夜与漫天风雨，",
    "start": 136.506,
    "end": 141.345,
    "duration": 4.839
  },
  {
    "id": 35,
    "text": "迸发出激越雄浑的抒情独白《雷电颂》。",
    "start": 141.674,
    "end": 144.891,
    "duration": 3.217
  },
  {
    "id": 36,
    "text": "作者将屈原内心的悲愤与宇宙雷电暴风融为一体，呼喊“风！",
    "start": 145.447,
    "end": 150.55,
    "duration": 5.103
  },
  {
    "id": 37,
    "text": "你咆哮吧！咆哮吧！",
    "start": 150.84,
    "end": 152.74,
    "duration": 1.9
  },
  {
    "id": 38,
    "text": "尽力地咆哮吧！",
    "start": 153.097,
    "end": 154.235,
    "duration": 1.138
  },
  {
    "id": 39,
    "text": "”，祈求雷电撕碎黑暗、将泥胎木雕炸裂粉碎。",
    "start": 154.82,
    "end": 158.184,
    "duration": 3.364
  },
  {
    "id": 40,
    "text": "这段长篇自由体独白突破了传统写实戏剧对外部动作的局限，",
    "start": 158.767,
    "end": 163.758,
    "duration": 4.991
  },
  {
    "id": 41,
    "text": "以回环往复的排比句式将舞台冲突升华为内心激情的诗意宣泄，",
    "start": 164.127,
    "end": 169.415,
    "duration": 5.288
  },
  {
    "id": 42,
    "text": "树立了现代抒情诗剧的典范。",
    "start": 169.84,
    "end": 171.971,
    "duration": 2.131
  },
  {
    "id": 43,
    "text": "第四，激活战时剧场动员机制，确立浪漫主义历史剧的经典范式。",
    "start": 172.571,
    "end": 177.456,
    "duration": 4.885
  },
  {
    "id": 44,
    "text": "该剧在重庆国泰大戏院首演即引起强烈反响，",
    "start": 177.926,
    "end": 181.495,
    "duration": 3.569
  },
  {
    "id": 45,
    "text": "有力呼应了战时大后方反独裁、争民主的呼声。",
    "start": 181.918,
    "end": 185.374,
    "duration": 3.456
  },
  {
    "id": 46,
    "text": "它摆脱了考据派历史剧的沉闷说教，",
    "start": 185.743,
    "end": 188.323,
    "duration": 2.58
  },
  {
    "id": 47,
    "text": "将案头诗意与剧场感染力结合起来，",
    "start": 188.484,
    "end": 191.436,
    "duration": 2.952
  },
  {
    "id": 48,
    "text": "使观众在剧场中与屈原的命运产生强烈共鸣，",
    "start": 191.693,
    "end": 195.293,
    "duration": 3.6
  },
  {
    "id": 49,
    "text": "舞台由此化为凝聚反抗意志的公共空间。",
    "start": 195.647,
    "end": 198.51,
    "duration": 2.863
  },
  {
    "id": 50,
    "text": "郭沫若将诗的激情、史的沉思与剧的冲突融为一体，",
    "start": 198.835,
    "end": 203.027,
    "duration": 4.192
  },
  {
    "id": 51,
    "text": "成功建立了独具民族特色的现代浪漫主义历史剧范式。",
    "start": 203.37,
    "end": 207.333,
    "duration": 3.963
  },
  {
    "id": 52,
    "text": "总览全剧，郭沫若历史剧《屈原》以借古讽今的历史眼光、",
    "start": 207.999,
    "end": 212.337,
    "duration": 4.338
  },
  {
    "id": 53,
    "text": "崇高刚烈的英雄品格与诗剧交融的美学建构，",
    "start": 212.716,
    "end": 216.401,
    "duration": 3.685
  },
  {
    "id": 54,
    "text": "开辟了中国现代话剧的抒情诗化道路。",
    "start": 216.745,
    "end": 219.457,
    "duration": 2.712
  },
  {
    "id": 55,
    "text": "它在抗战文艺史上留下了深刻印记，",
    "start": 219.867,
    "end": 222.455,
    "duration": 2.588
  },
  {
    "id": 56,
    "text": "成为中国现代浪漫主义历史剧的经典之作。",
    "start": 222.888,
    "end": 225.728,
    "duration": 2.84
  }
]