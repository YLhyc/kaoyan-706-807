[
  {
    "id": 1,
    "text": "试论郭沫若历史剧《屈原》的浪漫主义特质与时代借古讽今意蕴。",
    "start": 0.28,
    "end": 5.8,
    "duration": 5.52
  },
  {
    "id": 2,
    "text": "抗日战争相持阶段，郭沫若创作的五幕历史剧《屈原》，是中国现代话剧史与历史剧创作的代表作。",
    "start": 6.32,
    "end": 14.72,
    "duration": 8.4
  },
  {
    "id": 3,
    "text": "作品诞生于大后方“皖南事变”后的政治阴云之中，",
    "start": 15.24,
    "end": 19.08,
    "duration": 3.84
  },
  {
    "id": 4,
    "text": "作者将深沉的历史意识与炽烈的现实感融为一体，",
    "start": 19.45,
    "end": 23.29,
    "duration": 3.84
  },
  {
    "id": 5,
    "text": "创造性地践行了“失事求似”的历史剧原则，",
    "start": 23.66,
    "end": 27.1,
    "duration": 3.44
  },
  {
    "id": 6,
    "text": "塑造了极具崇高感与殉道精神的悲剧英雄，并在战时大后方鼓舞了民族民主抗争。",
    "start": 27.47,
    "end": 34.186,
    "duration": 6.716
  },
  {
    "id": 7,
    "text": "其思想意蕴与艺术成就主要体现在以下四个方面：",
    "start": 34.686,
    "end": 38.39,
    "duration": 3.704
  },
  {
    "id": 8,
    "text": "第一，践行“失事求似”美学原则，构筑借古讽今的现实批判锋芒。",
    "start": 38.76,
    "end": 44.44,
    "duration": 5.68
  },
  {
    "id": 9,
    "text": "郭沫若认为历史剧创作重在把握历史精神，而非拘泥于琐碎考据，",
    "start": 44.96,
    "end": 50.45,
    "duration": 5.49
  },
  {
    "id": 10,
    "text": "主张“失事求似”，即允许在次要史事上大胆虚构以开掘历史本质。",
    "start": 50.93,
    "end": 56.93,
    "duration": 6.0
  },
  {
    "id": 11,
    "text": "全剧写战国时期屈原坚持联齐抗秦、遭南后郑袖与靳尚诬陷放逐的生死博弈，",
    "start": 57.483,
    "end": 63.77,
    "duration": 6.287
  },
  {
    "id": 12,
    "text": "实质上直指战时重庆国民党统治集团：",
    "start": 64.14,
    "end": 67.82,
    "duration": 3.68
  },
  {
    "id": 13,
    "text": "华美阴鸷的南后、挑拨离间的秦相张仪与昏聩专断的楚怀王，",
    "start": 68.19,
    "end": 73.47,
    "duration": 5.28
  },
  {
    "id": 14,
    "text": "直接影射国民党消极抗日、积极反共的倒行逆施。",
    "start": 73.92,
    "end": 78.16,
    "duration": 4.24
  },
  {
    "id": 15,
    "text": "郭沫若借历史外壳装载现实批判烈火，赋予史剧鲜明的时代战斗品格。",
    "start": 78.68,
    "end": 84.68,
    "duration": 6.0
  },
  {
    "id": 16,
    "text": "第二，承续早期浪漫主义激情，塑造崇高刚烈的悲剧英雄人格。",
    "start": 85.2,
    "end": 90.32,
    "duration": 5.12
  },
  {
    "id": 17,
    "text": "不同于曹禺写实戏剧对家庭伦理与隐微心理的剖析，",
    "start": 90.84,
    "end": 95.0,
    "duration": 4.16
  },
  {
    "id": 18,
    "text": "郭沫若将《女神》时期奔涌的抒情激情注入戏剧之中。",
    "start": 95.37,
    "end": 99.61,
    "duration": 4.24
  },
  {
    "id": 19,
    "text": "剧中的屈原脱离了传统史传中哀怨悱恻的失意文人形象，",
    "start": 100.13,
    "end": 104.93,
    "duration": 4.8
  },
  {
    "id": 20,
    "text": "被重塑为大义凛然、坚守政治理想与民族气节的崇高英雄。",
    "start": 105.33,
    "end": 110.61,
    "duration": 5.28
  },
  {
    "id": 21,
    "text": "他面对群小威逼利诱始终傲骨铮铮；",
    "start": 111.13,
    "end": 114.09,
    "duration": 2.96
  },
  {
    "id": 22,
    "text": "虚构人物婵娟与宋玉的对照更凸显其品格：",
    "start": 114.61,
    "end": 118.37,
    "duration": 3.76
  },
  {
    "id": 23,
    "text": "婵娟误饮鸩酒而在客观上代屈原殉难，映照出真理追随者的纯洁忠贞；",
    "start": 118.785,
    "end": 124.962,
    "duration": 6.177
  },
  {
    "id": 24,
    "text": "宋玉由崇拜屈原堕落为依附权贵的弄臣，反衬出屈原挺立不屈的人格伟力。",
    "start": 125.462,
    "end": 131.58,
    "duration": 6.118
  },
  {
    "id": 25,
    "text": "第三，以第五幕《雷电颂》抒情独白为高潮，确立诗剧合一的美学典范。",
    "start": 132.1,
    "end": 137.859,
    "duration": 5.759
  },
  {
    "id": 26,
    "text": "全剧在第五幕达到戏剧冲突与诗性审美的顶点。",
    "start": 138.359,
    "end": 142.3,
    "duration": 3.941
  },
  {
    "id": 27,
    "text": "屈原被囚于东皇太一庙中，面对沉沉黑夜与漫天风雨，迸发出激越雄浑的抒情独白《雷电颂》。",
    "start": 142.852,
    "end": 150.9,
    "duration": 8.048
  },
  {
    "id": 28,
    "text": "作者将屈原内心的悲愤与宇宙雷电暴风融为一体，",
    "start": 151.42,
    "end": 155.26,
    "duration": 3.84
  },
  {
    "id": 29,
    "text": "呼喊“风！你咆哮吧！咆哮吧！尽力地咆哮吧！”，祈求雷电撕碎黑暗、将泥胎木雕炸裂粉碎。",
    "start": 155.63,
    "end": 163.97,
    "duration": 8.34
  },
  {
    "id": 30,
    "text": "这段长篇自由体独白突破了传统写实戏剧对外部动作的局限，",
    "start": 164.49,
    "end": 169.61,
    "duration": 5.12
  },
  {
    "id": 31,
    "text": "以回环往复的排比句式将舞台冲突升华为内心激情的诗意宣泄，树立了现代抒情诗剧的典范。",
    "start": 170.01,
    "end": 178.33,
    "duration": 8.32
  },
  {
    "id": 32,
    "text": "第四，激活战时剧场动员机制，确立浪漫主义历史剧的经典范式。",
    "start": 178.85,
    "end": 184.05,
    "duration": 5.2
  },
  {
    "id": 33,
    "text": "该剧在重庆国泰大戏院首演即引起强烈反响，有力呼应了战时大后方反独裁、争民主的呼声。",
    "start": 184.57,
    "end": 191.85,
    "duration": 7.28
  },
  {
    "id": 34,
    "text": "它摆脱了考据派历史剧的沉闷说教，将案头诗意与剧场感染力结合起来，",
    "start": 192.37,
    "end": 198.37,
    "duration": 6.0
  },
  {
    "id": 35,
    "text": "使观众在剧场中与屈原的命运产生强烈共鸣，舞台由此化为凝聚反抗意志的公共空间。",
    "start": 198.77,
    "end": 205.97,
    "duration": 7.2
  },
  {
    "id": 36,
    "text": "郭沫若将诗的激情、史的沉思与剧的冲突融为一体，",
    "start": 206.49,
    "end": 211.05,
    "duration": 4.56
  },
  {
    "id": 37,
    "text": "成功建立了独具民族特色的现代浪漫主义历史剧范式。",
    "start": 211.42,
    "end": 215.42,
    "duration": 4.0
  },
  {
    "id": 38,
    "text": "总览全剧，郭沫若历史剧《屈原》以借古讽今的历史眼光、崇高刚烈的英雄品格与诗剧交融的美学建构，",
    "start": 215.94,
    "end": 224.98,
    "duration": 9.04
  },
  {
    "id": 39,
    "text": "开辟了中国现代话剧的抒情诗化道路。",
    "start": 225.35,
    "end": 228.23,
    "duration": 2.88
  },
  {
    "id": 40,
    "text": "它在抗战文艺史上留下了深刻印记，成为中国现代浪漫主义历史剧的经典之作。",
    "start": 228.75,
    "end": 234.83,
    "duration": 6.08
  }
]
