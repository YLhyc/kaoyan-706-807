[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "先锋小说·余华从先锋探索到九十年代创作转型",
    "start": 0.314,
    "end": 4.566,
    "duration": 4.252
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "写什么→谁在讲→为何活的三步对照式转型：",
    "start": 5.654,
    "end": 11.306,
    "duration": 5.652
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "1.题材从《现实一种》血腥拆解转向《活着》《许三观》体认底层坚韧；",
    "start": 11.854,
    "end": 18.506,
    "duration": 6.652
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "2.叙事视点从冰冷生理白描转向“炒猪肝”般烟火民间说话人；",
    "start": 19.434,
    "end": 25.606,
    "duration": 6.172
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "3.生命哲学从虚无荒诞死局升华为“卖血救一乐”的向死而生。",
    "start": 26.534,
    "end": 32.906,
    "duration": 6.372
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "八十年代末至九十年代，余华由激进“先锋形式实验”转向沉潜温厚“民间生存叙事”，",
    "start": 33.914,
    "end": 41.406,
    "duration": 7.492
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "构成新时期当代小说文体演进的核心切片。",
    "start": 41.714,
    "end": 45.286,
    "duration": 3.572
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 叙事重心：形式暴力拆解 → 底层苦难体认",
    "start": 46.294,
    "end": 50.946,
    "duration": 4.652
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "《现实一种》写孩童相害引发兄弟报复乃至尸体拆解，冷酷摧毁宗法温情、视世界为荒诞迷宫；",
    "start": 51.914,
    "end": 60.806,
    "duration": 8.892
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "九十年代《活着》《许三观卖血记》走出暴力迷狂，凝视平民坚韧承受，赋予微小生命厚重尊严。",
    "start": 61.814,
    "end": 70.866,
    "duration": 9.052
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 叙事视角：冷漠零度叙事 → 民间说话人视点",
    "start": 71.914,
    "end": 76.686,
    "duration": 4.772
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "先锋阶段以生理学白描剔除道德人道关怀，将人物物化为被命运玩弄的零件；",
    "start": 77.654,
    "end": 84.946,
    "duration": 7.292
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "转型期在《许三观卖血记》吸纳民间说唱基因，借饥荒年用嘴给孩子“炒猪肝”及循环复沓对话，建烟火温情立场。",
    "start": 85.914,
    "end": 96.886,
    "duration": 10.972
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 生存哲学：虚无绝望 → 向死而生坚韧意志",
    "start": 97.594,
    "end": 102.566,
    "duration": 4.972
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "从揭示命运无从逃脱的死局，转向重新发现中国平民的生存韧性与和解力量；",
    "start": 103.266,
    "end": 110.478,
    "duration": 7.212
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "许三观为救非亲生病儿一乐乘船赴沪一路卖血至休克，以肉身极限践行大爱，",
    "start": 111.526,
    "end": 119.538,
    "duration": 8.012
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "终在家人共享烟火温情中和解，立向死而生哲学。",
    "start": 119.846,
    "end": 124.218,
    "duration": 4.372
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：先锋时期代表作《现实一种》《一九八六年》；",
    "start": 125.226,
    "end": 129.678,
    "duration": 4.452
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "九十年代转型代表作《活着》（福贵）与《许三观卖血记》（许三观卖血救一乐、“炒猪肝”）。",
    "start": 130.686,
    "end": 137.298,
    "duration": 6.612
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 用“题材重心/叙述视角/生存哲学”三步精准对照余华前后两期作品？",
    "start": 138.266,
    "end": 145.998,
    "duration": 7.732
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《现实一种》与《许三观卖血记》“炒猪肝”“赴沪卖血”两个名场景对比口吻？",
    "start": 146.966,
    "end": 154.378,
    "duration": 7.412
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2024 年西华师大真题简答：《从〈许三观卖血记〉看余华创作转型》？",
    "start": 155.346,
    "end": 162.518,
    "duration": 7.172
  }
]