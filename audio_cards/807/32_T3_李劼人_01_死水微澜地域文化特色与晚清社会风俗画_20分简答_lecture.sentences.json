[
  {
    "id": 1,
    "text": "三十年代中期，李劼人发表《死水微澜》，",
    "start": 0.106,
    "end": 3.02,
    "duration": 2.914
  },
  {
    "id": 2,
    "text": "作为其“大河小说”三部曲的开山之作，",
    "start": 3.137,
    "end": 5.586,
    "duration": 2.449
  },
  {
    "id": 3,
    "text": "生动再现了晚清中西碰撞在四川内陆激起的历史波澜。",
    "start": 5.897,
    "end": 9.875,
    "duration": 3.978
  },
  {
    "id": 4,
    "text": "郭沫若赞誉李劼人为“中国的左拉”，",
    "start": 10.028,
    "end": 12.522,
    "duration": 2.494
  },
  {
    "id": 5,
    "text": "其小说的地域文化特色与社会风俗描摹主要体现于以下三个方面：",
    "start": 12.71,
    "end": 17.689,
    "duration": 4.979
  },
  {
    "id": 6,
    "text": "第一，铺陈浓郁的巴蜀地域风俗，展现晚清内陆社会的风貌全景。",
    "start": 18.335,
    "end": 23.554,
    "duration": 5.219
  },
  {
    "id": 7,
    "text": "小说以成都近郊天回镇为舞台，",
    "start": 24.076,
    "end": 26.527,
    "duration": 2.451
  },
  {
    "id": 8,
    "text": "细致描摹了甲午战争至《辛丑条约》签订前后四川乡镇封闭滞重的生活形态。",
    "start": 26.875,
    "end": 32.875,
    "duration": 6.0
  },
  {
    "id": 9,
    "text": "作者娴熟运用地道的四川方言俚语，",
    "start": 33.371,
    "end": 35.922,
    "duration": 2.551
  },
  {
    "id": 10,
    "text": "细腻再现了茶馆吃茶摆龙门阵、赶场庙会、",
    "start": 36.277,
    "end": 39.542,
    "duration": 3.265
  },
  {
    "id": 11,
    "text": "袍哥开堂拜码头及民间婚丧嫁娶等生活细节，",
    "start": 39.778,
    "end": 43.575,
    "duration": 3.797
  },
  {
    "id": 12,
    "text": "勾勒出一幅气韵生动、原汁原味的晚清川西民俗画卷。",
    "start": 43.775,
    "end": 48.176,
    "duration": 4.401
  },
  {
    "id": 13,
    "text": "第二，塑造泼辣敢为的底层女性典型，",
    "start": 48.793,
    "end": 51.904,
    "duration": 3.111
  },
  {
    "id": 14,
    "text": "展现冲破礼教成规的生命活力。",
    "start": 52.377,
    "end": 54.638,
    "duration": 2.261
  },
  {
    "id": 15,
    "text": "女主人公邓幺姑（蔡大嫂）不同于传统闺秀的温顺隐忍，",
    "start": 55.204,
    "end": 59.649,
    "duration": 4.445
  },
  {
    "id": 16,
    "text": "她美丽泼辣、精明能干，渴望富足体面的生活。",
    "start": 60.257,
    "end": 64.083,
    "duration": 3.826
  },
  {
    "id": 17,
    "text": "嫁给天回镇杂货铺老板蔡兴顺后，面对庸懦木讷的丈夫，",
    "start": 64.717,
    "end": 69.441,
    "duration": 4.724
  },
  {
    "id": 18,
    "text": "她毫无忌惮地与蔡兴顺的表兄、袍哥头目罗歪嘴大胆相恋；",
    "start": 69.767,
    "end": 74.484,
    "duration": 4.717
  },
  {
    "id": 19,
    "text": "当罗歪嘴因得罪洋教潜逃败落后，她为保全家庭与自身尊严，",
    "start": 75.025,
    "end": 79.872,
    "duration": 4.847
  },
  {
    "id": 20,
    "text": "果断转嫁投靠教会势力的粮户顾天成，",
    "start": 80.249,
    "end": 83.566,
    "duration": 3.317
  },
  {
    "id": 21,
    "text": "呈现出鲜明复杂的女性生命活力。",
    "start": 83.851,
    "end": 86.583,
    "duration": 2.732
  },
  {
    "id": 22,
    "text": "第三，白描中西势力碰撞的历史漩涡，",
    "start": 87.258,
    "end": 90.124,
    "duration": 2.866
  },
  {
    "id": 23,
    "text": "解剖时代巨变前的“死水”微澜。",
    "start": 90.573,
    "end": 92.944,
    "duration": 2.371
  },
  {
    "id": 24,
    "text": "小说通过罗歪嘴代表的袍哥民间帮会、蔡兴顺代表的小镇商人，",
    "start": 93.325,
    "end": 98.922,
    "duration": 5.597
  },
  {
    "id": 25,
    "text": "以及顾天成由受欺辱到勾结洋教作威作福的曲折蜕变，",
    "start": 99.392,
    "end": 103.996,
    "duration": 4.604
  },
  {
    "id": 26,
    "text": "真实折射出西方殖民势力渗入内陆后引发的阶层分化与社会震荡，",
    "start": 104.447,
    "end": 109.898,
    "duration": 5.451
  },
  {
    "id": 27,
    "text": "深刻呈现出晚清社会表面如死水般沉寂、",
    "start": 110.124,
    "end": 113.551,
    "duration": 3.427
  },
  {
    "id": 28,
    "text": "内里暗流涌动的历史真实。",
    "start": 113.962,
    "end": 115.921,
    "duration": 1.959
  }
]