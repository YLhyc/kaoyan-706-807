[
  {
    "id": 1,
    "text": "三十年代中期，李劼人发表《死水微澜》，",
    "start": 0.05,
    "end": 3.878,
    "duration": 3.828
  },
  {
    "id": 2,
    "text": "作为其著名的“大河小说”三部曲开山之作，",
    "start": 3.878,
    "end": 7.646,
    "duration": 3.768
  },
  {
    "id": 3,
    "text": "在中国现代文学史上成功填补了晚清近代中西碰撞在四川内地激荡的宏大历史风貌。",
    "start": 7.646,
    "end": 15.263,
    "duration": 7.617
  },
  {
    "id": 4,
    "text": "郭沫若赞誉李劼人为“中国的左拉”，",
    "start": 15.263,
    "end": 18.044,
    "duration": 2.781
  },
  {
    "id": 5,
    "text": "其小说艺术特色主要展现于以下三个方面：",
    "start": 18.044,
    "end": 21.628,
    "duration": 3.584
  },
  {
    "id": 6,
    "text": "第一，铺陈浓烈醇厚的巴蜀地域风俗，",
    "start": 21.628,
    "end": 24.969,
    "duration": 3.341
  },
  {
    "id": 7,
    "text": "展现晚清内陆社会的百科全书全景。",
    "start": 24.969,
    "end": 27.993,
    "duration": 3.024
  },
  {
    "id": 8,
    "text": "小说以成都近郊天水镇为舞台，",
    "start": 27.993,
    "end": 30.659,
    "duration": 2.666
  },
  {
    "id": 9,
    "text": "深入剖析了戊戌变法至辛亥革命前夕四川乡村与都市的封闭闭塞；",
    "start": 30.659,
    "end": 36.141,
    "duration": 5.482
  },
  {
    "id": 10,
    "text": "作者以极其地道纯正的四川方言俚语，",
    "start": 36.141,
    "end": 39.05,
    "duration": 2.909
  },
  {
    "id": 11,
    "text": "细致入微地描摹了茶馆吃茶摆龙门阵、赶场庙会、",
    "start": 39.05,
    "end": 43.221,
    "duration": 4.171
  },
  {
    "id": 12,
    "text": "袍哥开堂拜码头以及民间婚丧嫁娶的风情细节，",
    "start": 43.221,
    "end": 47.17,
    "duration": 3.949
  },
  {
    "id": 13,
    "text": "勾勒出一幅气韵生动、原汁原味的晚清川西民俗画卷。",
    "start": 47.17,
    "end": 51.546,
    "duration": 4.376
  },
  {
    "id": 14,
    "text": "第二，塑造泼辣叛逆的底层女性典型，",
    "start": 51.546,
    "end": 54.896,
    "duration": 3.35
  },
  {
    "id": 15,
    "text": "展现冲破礼教禁锢的生命野性。",
    "start": 54.896,
    "end": 57.554,
    "duration": 2.658
  },
  {
    "id": 16,
    "text": "女主人公邓幺姑（蔡大嫂）不同于传统闺秀的温顺隐忍，",
    "start": 57.554,
    "end": 61.936,
    "duration": 4.382
  },
  {
    "id": 17,
    "text": "她美丽泼辣、精明强悍，怀抱对富足体面生活的强烈渴望；",
    "start": 61.936,
    "end": 66.562,
    "duration": 4.626
  },
  {
    "id": 18,
    "text": "在被迫嫁入破落蔡家、面对形同侏儒的傻丈夫后，",
    "start": 66.562,
    "end": 70.589,
    "duration": 4.027
  },
  {
    "id": 19,
    "text": "她毫无道德羁绊地与表兄——袍哥大爷罗歪脖私通偷情；",
    "start": 70.589,
    "end": 75.071,
    "duration": 4.482
  },
  {
    "id": 20,
    "text": "当罗歪脖潜逃败落后，她为维持体面与尊严，",
    "start": 75.071,
    "end": 78.614,
    "duration": 3.543
  },
  {
    "id": 21,
    "text": "毅然决然转嫁投靠洋教势力的顾天成，",
    "start": 78.614,
    "end": 81.822,
    "duration": 3.208
  },
  {
    "id": 22,
    "text": "将一个底层女性在生存逼仄下向死而生、",
    "start": 81.822,
    "end": 85.106,
    "duration": 3.284
  },
  {
    "id": 23,
    "text": "顽强抗争的野性蛮力展现得活灵活现。",
    "start": 85.106,
    "end": 88.409,
    "duration": 3.303
  },
  {
    "id": 24,
    "text": "第三，白描中西势力交汇碰撞的历史漩涡，",
    "start": 88.409,
    "end": 91.968,
    "duration": 3.559
  },
  {
    "id": 25,
    "text": "解剖时代巨变前的“死水”微澜。",
    "start": 91.968,
    "end": 94.428,
    "duration": 2.46
  },
  {
    "id": 26,
    "text": "小说通过罗歪脖代表的袍哥民间秘密帮会、",
    "start": 94.428,
    "end": 97.87,
    "duration": 3.442
  },
  {
    "id": 27,
    "text": "蔡兴顺代表的封建庸碌地主、",
    "start": 97.87,
    "end": 100.414,
    "duration": 2.544
  },
  {
    "id": 28,
    "text": "以及顾天成由受侮辱到勾结洋教作威作福的曲折蜕变，",
    "start": 100.414,
    "end": 105.295,
    "duration": 4.881
  },
  {
    "id": 29,
    "text": "真实折射出西方殖民势力渗入封闭内陆后激起的阶层分化与社会震荡，",
    "start": 105.295,
    "end": 111.474,
    "duration": 6.179
  },
  {
    "id": 30,
    "text": "深刻呈现了旧帝国崩溃前夕古老文明表层如死水般麻木、",
    "start": 111.474,
    "end": 116.563,
    "duration": 5.089
  },
  {
    "id": 31,
    "text": "深层暗流奔涌的历史真实。",
    "start": 116.563,
    "end": 118.848,
    "duration": 2.285
  }
]