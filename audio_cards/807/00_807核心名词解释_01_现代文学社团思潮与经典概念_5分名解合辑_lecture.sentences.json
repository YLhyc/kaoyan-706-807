[
  {
    "id": 1,
    "text": "807 核心名词解释（一）：现代文学核心社团、",
    "start": 0.05,
    "end": 4.276,
    "duration": 4.226
  },
  {
    "id": 2,
    "text": "流派与典型人物（5分名解合辑）。",
    "start": 4.276,
    "end": 7.277,
    "duration": 3.001
  },
  {
    "id": 3,
    "text": "1. 文学研究会。",
    "start": 7.277,
    "end": 8.984,
    "duration": 1.707
  },
  {
    "id": 4,
    "text": "五四时期在北京成立的中国现代文学史上第一个纯文学社团。",
    "start": 8.984,
    "end": 13.884,
    "duration": 4.9
  },
  {
    "id": 5,
    "text": "由周作人、茅盾、叶圣陶、郑振铎等发起，",
    "start": 13.884,
    "end": 17.464,
    "duration": 3.58
  },
  {
    "id": 6,
    "text": "以《小说月报》为主要阵地。",
    "start": 17.464,
    "end": 19.362,
    "duration": 1.898
  },
  {
    "id": 7,
    "text": "核心主张“为人生而艺术”，反对消遣与游戏文学，",
    "start": 19.362,
    "end": 24.108,
    "duration": 4.746
  },
  {
    "id": 8,
    "text": "提倡写实主义与问题小说。",
    "start": 24.108,
    "end": 26.892,
    "duration": 2.784
  },
  {
    "id": 9,
    "text": "代表作有叶圣陶《潘先生在难中》、冰心《寄小读者》等。",
    "start": 26.892,
    "end": 30.849,
    "duration": 3.957
  },
  {
    "id": 10,
    "text": "它确立了中国现代现实主义文学的主流传统。",
    "start": 30.849,
    "end": 35.762,
    "duration": 4.913
  },
  {
    "id": 11,
    "text": "2. 创造社。",
    "start": 35.762,
    "end": 37.428,
    "duration": 1.666
  },
  {
    "id": 12,
    "text": "五四时期在日本东京成立的著名浪漫主义文学社团。",
    "start": 37.428,
    "end": 41.428,
    "duration": 4.0
  },
  {
    "id": 13,
    "text": "主要发起人有郭沫若、郁达夫、成仿吾等，后迁回国内，",
    "start": 41.428,
    "end": 46.367,
    "duration": 4.939
  },
  {
    "id": 14,
    "text": "主办《创造季刊》等刊物。",
    "start": 46.367,
    "end": 48.568,
    "duration": 2.201
  },
  {
    "id": 15,
    "text": "核心主张“为艺术而艺术”，强调文学是自我个性的绝对表现，",
    "start": 48.568,
    "end": 52.931,
    "duration": 4.363
  },
  {
    "id": 16,
    "text": "注重主观直抒胸臆与青春苦闷抒发。",
    "start": 52.931,
    "end": 55.882,
    "duration": 2.951
  },
  {
    "id": 17,
    "text": "代表作有郭沫若《女神》、郁达夫《沉沦》。",
    "start": 55.882,
    "end": 58.613,
    "duration": 2.731
  },
  {
    "id": 18,
    "text": "后期转向倡导无产阶级革命文学，对现代浪漫主义思潮贡献卓越。",
    "start": 58.613,
    "end": 64.124,
    "duration": 5.511
  },
  {
    "id": 19,
    "text": "3. 新月派。",
    "start": 64.124,
    "end": 66.082,
    "duration": 1.958
  },
  {
    "id": 20,
    "text": "二十年代中后期活跃于北京、上海的重要现代诗歌与文学流派。",
    "start": 66.082,
    "end": 70.849,
    "duration": 4.767
  },
  {
    "id": 21,
    "text": "以徐志摩、闻一多、梁实秋为核心，",
    "start": 70.849,
    "end": 74.322,
    "duration": 3.473
  },
  {
    "id": 22,
    "text": "主办《晨报副刊·诗镌》《新月》月刊。",
    "start": 74.322,
    "end": 77.459,
    "duration": 3.137
  },
  {
    "id": 23,
    "text": "针对早期白话诗散漫松弛的倾向，",
    "start": 77.459,
    "end": 80.892,
    "duration": 3.433
  },
  {
    "id": 24,
    "text": "闻一多提出“戴着脚镣跳舞”的新格律诗主张与“音乐美、",
    "start": 80.892,
    "end": 84.892,
    "duration": 4.0
  },
  {
    "id": 25,
    "text": "绘画美、建筑美”三美理论。",
    "start": 84.892,
    "end": 87.611,
    "duration": 2.719
  },
  {
    "id": 26,
    "text": "代表作有闻一多《死水》、徐志摩《再别康桥》。",
    "start": 87.611,
    "end": 90.673,
    "duration": 3.062
  },
  {
    "id": 27,
    "text": "该派极大推进了现代汉诗的格律化与形式规范。",
    "start": 90.673,
    "end": 94.629,
    "duration": 3.956
  },
  {
    "id": 28,
    "text": "4. 语丝文体。",
    "start": 94.629,
    "end": 95.569,
    "duration": 0.94
  },
  {
    "id": 29,
    "text": "二十年代中期伴随北京《语丝》周刊创刊而形成的一种现代散文文体范式。",
    "start": 95.569,
    "end": 101.897,
    "duration": 6.328
  },
  {
    "id": 30,
    "text": "主要代表作家为鲁迅、周作人、钱玄同等。",
    "start": 101.897,
    "end": 106.083,
    "duration": 4.186
  },
  {
    "id": 31,
    "text": "其文体核心特质为“任意而谈，无所顾忌”，",
    "start": 106.083,
    "end": 109.63,
    "duration": 3.547
  },
  {
    "id": 32,
    "text": "主张冲破传统桐城派文人雅调，广泛杂糅文言、白话与外来语，",
    "start": 109.63,
    "end": 114.176,
    "duration": 4.546
  },
  {
    "id": 33,
    "text": "行文冷峻幽默、讽刺辛辣且富于哲理智性。",
    "start": 114.176,
    "end": 117.977,
    "duration": 3.801
  },
  {
    "id": 34,
    "text": "代表作有鲁迅杂文与周作人早期小品，",
    "start": 117.977,
    "end": 121.406,
    "duration": 3.429
  },
  {
    "id": 35,
    "text": "有力拓宽了中国现代随笔杂文的美学边界。",
    "start": 121.406,
    "end": 126.266,
    "duration": 4.86
  },
  {
    "id": 36,
    "text": "5. 现代评论派。",
    "start": 126.266,
    "end": 127.357,
    "duration": 1.091
  },
  {
    "id": 37,
    "text": "二十年代中期围绕北京《现代评论》周刊聚集的具有欧美自由主义倾向的知识分子流派。",
    "start": 127.357,
    "end": 135.101,
    "duration": 7.744
  },
  {
    "id": 38,
    "text": "主要代表人物为胡适、陈西滢、王世杰等。",
    "start": 135.101,
    "end": 138.012,
    "duration": 2.911
  },
  {
    "id": 39,
    "text": "在思想上主张英美绅士的平和温和与法治渐进，",
    "start": 138.012,
    "end": 141.72,
    "duration": 3.708
  },
  {
    "id": 40,
    "text": "倡导“闲话”文体；",
    "start": 141.72,
    "end": 143.229,
    "duration": 1.509
  },
  {
    "id": 41,
    "text": "在文艺上强调学者式的理性公允与适度宽容，",
    "start": 143.229,
    "end": 147.167,
    "duration": 3.938
  },
  {
    "id": 42,
    "text": "曾因“女师大风潮”等政治文化事件与鲁迅等语丝派展开激烈论战，",
    "start": 147.167,
    "end": 152.722,
    "duration": 5.555
  },
  {
    "id": 43,
    "text": "展现了现代自由主义文人的复杂面貌。",
    "start": 152.722,
    "end": 157.857,
    "duration": 5.135
  },
  {
    "id": 44,
    "text": "6. 学衡派。",
    "start": 157.857,
    "end": 159.175,
    "duration": 1.318
  },
  {
    "id": 45,
    "text": "二十年代初以南京《学衡》杂志为核心阵地的文化保守主义知识分子群体。",
    "start": 159.175,
    "end": 164.63,
    "duration": 5.455
  },
  {
    "id": 46,
    "text": "主要代表人物有梅光迪、胡先骃、吴宓等。",
    "start": 164.63,
    "end": 168.151,
    "duration": 3.521
  },
  {
    "id": 47,
    "text": "受美国白璧德“新人文主义”思想影响，",
    "start": 168.151,
    "end": 170.878,
    "duration": 2.727
  },
  {
    "id": 48,
    "text": "在文学革命大潮中主张“昌明国粹，融化新知”，",
    "start": 170.878,
    "end": 175.408,
    "duration": 4.53
  },
  {
    "id": 49,
    "text": "强烈反对激进的新文化运动与废除文言文，",
    "start": 175.408,
    "end": 178.71,
    "duration": 3.302
  },
  {
    "id": 50,
    "text": "捍卫传统儒家人伦道德与古文正统，",
    "start": 178.71,
    "end": 181.438,
    "duration": 2.728
  },
  {
    "id": 51,
    "text": "客观上对反思激进主义思潮具有一定的文化史互证价值。",
    "start": 181.438,
    "end": 187.681,
    "duration": 6.243
  },
  {
    "id": 52,
    "text": "7. “革命加恋爱”小说。",
    "start": 187.681,
    "end": 189.135,
    "duration": 1.454
  },
  {
    "id": 53,
    "text": "大革命失败前后在左翼文学界迅速流行的一种都市政治通俗叙事模式。",
    "start": 189.135,
    "end": 194.647,
    "duration": 5.512
  },
  {
    "id": 54,
    "text": "主要代表作家为蒋光慈、洪灵菲等。",
    "start": 194.647,
    "end": 198.53,
    "duration": 3.883
  },
  {
    "id": 55,
    "text": "其核心模式为小资产阶级知识青年在浪漫情爱受挫后，",
    "start": 198.53,
    "end": 202.712,
    "duration": 4.182
  },
  {
    "id": 56,
    "text": "在革命战友感召下走向工农武装斗争，以革命拯救情爱幻灭。",
    "start": 202.712,
    "end": 207.662,
    "duration": 4.95
  },
  {
    "id": 57,
    "text": "代表作有蒋光慈《短裤党》。",
    "start": 207.662,
    "end": 209.608,
    "duration": 1.946
  },
  {
    "id": 58,
    "text": "该模式虽具动员效应，但后期陷入公式化、",
    "start": 209.608,
    "end": 213.428,
    "duration": 3.82
  },
  {
    "id": 59,
    "text": "概念化与概念传声筒的创作弊端。",
    "start": 213.428,
    "end": 217.921,
    "duration": 4.493
  },
  {
    "id": 60,
    "text": "8. 九叶诗派。",
    "start": 217.921,
    "end": 219.007,
    "duration": 1.086
  },
  {
    "id": 61,
    "text": "四十年代后期以穆旦、郑敏、杜运燮、",
    "start": 219.007,
    "end": 221.552,
    "duration": 2.545
  },
  {
    "id": 62,
    "text": "辛笛等西南联大诗人群为代表的现代诗歌流派，",
    "start": 221.552,
    "end": 225.482,
    "duration": 3.93
  },
  {
    "id": 63,
    "text": "因八十年代出版《九叶集》而得名。",
    "start": 225.482,
    "end": 228.465,
    "duration": 2.983
  },
  {
    "id": 64,
    "text": "诗派自觉反思标语口号化倾向，",
    "start": 228.465,
    "end": 231.012,
    "duration": 2.547
  },
  {
    "id": 65,
    "text": "主张将现实主义历史苦难感与西方现代主义智性沉思熔铸一体，",
    "start": 231.012,
    "end": 236.512,
    "duration": 5.5
  },
  {
    "id": 66,
    "text": "开创“新诗现代化”的综合诗学范式。",
    "start": 236.512,
    "end": 239.545,
    "duration": 3.033
  },
  {
    "id": 67,
    "text": "代表作有穆旦《赞美》《森林之魅》、杜运燮《秋》，",
    "start": 239.545,
    "end": 243.783,
    "duration": 4.238
  },
  {
    "id": 68,
    "text": "标志着现代汉诗本体建构的高度成熟。",
    "start": 243.783,
    "end": 246.964,
    "duration": 3.181
  },
  {
    "id": 69,
    "text": "9. 山药蛋派。",
    "start": 246.964,
    "end": 248.983,
    "duration": 2.019
  },
  {
    "id": 70,
    "text": "抗战相持阶段及解放区时期在山西农村形成的具有浓郁晋西乡土气息的现实主义文学流派。",
    "start": 248.983,
    "end": 257.404,
    "duration": 8.421
  },
  {
    "id": 71,
    "text": "以赵树理为核心，代表作家有马烽、西戎等。",
    "start": 257.404,
    "end": 261.401,
    "duration": 3.997
  },
  {
    "id": 72,
    "text": "作家坚持工农兵方向，以大众化的民间评书说唱笔调，",
    "start": 261.401,
    "end": 265.919,
    "duration": 4.518
  },
  {
    "id": 73,
    "text": "描写农村宗法变革与封建迷信破除。",
    "start": 265.919,
    "end": 269.289,
    "duration": 3.37
  },
  {
    "id": 74,
    "text": "代表作有赵树理《小二黑结婚》《李有才板话》。",
    "start": 269.289,
    "end": 273.399,
    "duration": 4.11
  },
  {
    "id": 75,
    "text": "该派开创了现代小说民族化、大众化的成功范例。",
    "start": 273.399,
    "end": 277.745,
    "duration": 4.346
  },
  {
    "id": 76,
    "text": "10. 荷花淀派。",
    "start": 277.745,
    "end": 278.835,
    "duration": 1.09
  },
  {
    "id": 77,
    "text": "抗战时期及建国初期形成的以孙犁为代表的河北白洋淀乡土抒情文学流派。",
    "start": 278.835,
    "end": 284.654,
    "duration": 5.819
  },
  {
    "id": 78,
    "text": "主要作家有孙犁、刘绍棠、从维熙等。",
    "start": 284.654,
    "end": 287.595,
    "duration": 2.941
  },
  {
    "id": 79,
    "text": "该派以战争风云为背景，避开残酷血腥厮杀，",
    "start": 287.595,
    "end": 291.826,
    "duration": 4.231
  },
  {
    "id": 80,
    "text": "转向开掘底层人民纯朴真挚的人性美与人情美，语言清新秀丽、",
    "start": 291.826,
    "end": 297.013,
    "duration": 5.187
  },
  {
    "id": 81,
    "text": "情景交融，具诗化小说特征。",
    "start": 297.013,
    "end": 299.405,
    "duration": 2.392
  },
  {
    "id": 82,
    "text": "代表作有孙犁《荷花淀》《芦花荡》，在现代革命文学中独树一帜。",
    "start": 299.405,
    "end": 305.419,
    "duration": 6.014
  },
  {
    "id": 83,
    "text": "11. 繁漪。",
    "start": 305.419,
    "end": 307.182,
    "duration": 1.763
  },
  {
    "id": 84,
    "text": "曹禺话剧《雷雨》中的核心女主人公，",
    "start": 307.182,
    "end": 309.971,
    "duration": 2.789
  },
  {
    "id": 85,
    "text": "中国现代戏剧史上塑造得最为卓越的复杂女性典型。",
    "start": 309.971,
    "end": 313.971,
    "duration": 4.0
  },
  {
    "id": 86,
    "text": "她性格具有“雷雨”般最原始、炽烈的生命蛮力，",
    "start": 313.971,
    "end": 317.268,
    "duration": 3.297
  },
  {
    "id": 87,
    "text": "身陷周朴园冷酷封建专制窒息的周公馆，与继子周萍发生畸恋；",
    "start": 317.268,
    "end": 322.401,
    "duration": 5.133
  },
  {
    "id": 88,
    "text": "遭周萍遗弃后由爱生恨，在雷雨之夜撕开一切虚伪遮羞布，",
    "start": 322.401,
    "end": 327.494,
    "duration": 5.093
  },
  {
    "id": 89,
    "text": "最终在乱伦罪恶与儿子死亡的惨烈冲击下精神彻底崩溃，",
    "start": 327.494,
    "end": 333.02,
    "duration": 5.526
  },
  {
    "id": 90,
    "text": "成为封建礼教吃人的反抗者与殉葬品。",
    "start": 333.02,
    "end": 336.734,
    "duration": 3.714
  },
  {
    "id": 91,
    "text": "12. 吴荪甫。",
    "start": 336.734,
    "end": 338.259,
    "duration": 1.525
  },
  {
    "id": 92,
    "text": "茅盾长篇小说《子夜》的主人公，",
    "start": 338.259,
    "end": 340.58,
    "duration": 2.321
  },
  {
    "id": 93,
    "text": "中国现代文学史上最丰满的民族资产阶级典型形象。",
    "start": 340.58,
    "end": 344.58,
    "duration": 4.0
  },
  {
    "id": 94,
    "text": "他精明强干、怀抱“实业救国”工业宏图；",
    "start": 344.58,
    "end": 347.715,
    "duration": 3.135
  },
  {
    "id": 95,
    "text": "对内勾结反动势力残酷镇压丝厂工潮，",
    "start": 347.715,
    "end": 351.954,
    "duration": 4.239
  },
  {
    "id": 96,
    "text": "对外却在半殖民地畸形秩序中惨遭买办金融巨头赵伯韬的资本围剿与亲友背叛，",
    "start": 351.954,
    "end": 359.776,
    "duration": 7.822
  },
  {
    "id": 97,
    "text": "最终在公债市场惨败破产，",
    "start": 359.776,
    "end": 361.832,
    "duration": 2.056
  },
  {
    "id": 98,
    "text": "深刻印证了半殖民地中国民族工业发展道路的必然破灭。",
    "start": 361.832,
    "end": 366.752,
    "duration": 4.92
  },
  {
    "id": 99,
    "text": "13. 《新青年》。",
    "start": 366.752,
    "end": 367.661,
    "duration": 0.909
  },
  {
    "id": 100,
    "text": "五四新文化运动的策源地与核心阵地杂志。",
    "start": 367.661,
    "end": 371.491,
    "duration": 3.83
  },
  {
    "id": 101,
    "text": "陈独秀在上海创刊（初名《青年杂志》），后迁至北京。",
    "start": 371.491,
    "end": 375.61,
    "duration": 4.119
  },
  {
    "id": 102,
    "text": "主要编委有李大钊、鲁迅、胡适、钱玄同等。",
    "start": 375.61,
    "end": 379.637,
    "duration": 4.027
  },
  {
    "id": 103,
    "text": "杂志以“民主（德先生）与科学（赛先生）”为口号，",
    "start": 379.637,
    "end": 383.217,
    "duration": 3.58
  },
  {
    "id": 104,
    "text": "发表《文学改良刍议》《文学革命论》与中国第一篇现代白话小说《狂人日记》，",
    "start": 383.217,
    "end": 388.967,
    "duration": 5.75
  },
  {
    "id": 105,
    "text": "标志着中国现代思想启蒙与新文学革命的正式发轫。",
    "start": 388.967,
    "end": 393.115,
    "duration": 4.148
  },
  {
    "id": 106,
    "text": "14. 《死水微澜》。",
    "start": 393.115,
    "end": 394.387,
    "duration": 1.272
  },
  {
    "id": 107,
    "text": "三十年代中期李劼人发表的长篇小说，",
    "start": 394.387,
    "end": 397.602,
    "duration": 3.215
  },
  {
    "id": 108,
    "text": "其“大河小说”三部曲开山之作。",
    "start": 397.602,
    "end": 401.835,
    "duration": 4.233
  },
  {
    "id": 109,
    "text": "小说以晚清成都近郊天水镇为背景，",
    "start": 401.835,
    "end": 404.563,
    "duration": 2.728
  },
  {
    "id": 110,
    "text": "通过邓幺姑（蔡大嫂）泼辣抗争、",
    "start": 404.563,
    "end": 407.302,
    "duration": 2.739
  },
  {
    "id": 111,
    "text": "罗歪脖袍哥势力与顾天成投靠洋教的曲折命运，",
    "start": 407.302,
    "end": 410.938,
    "duration": 3.636
  },
  {
    "id": 112,
    "text": "原汁原味地展现了川西平原独特的民俗风情与社会结构，",
    "start": 410.938,
    "end": 415.349,
    "duration": 4.411
  },
  {
    "id": 113,
    "text": "深刻解剖了近代中西文化剧烈冲突下内陆社会的死水暗涌。",
    "start": 415.349,
    "end": 420.689,
    "duration": 5.34
  },
  {
    "id": 114,
    "text": "15. 《茶馆》。",
    "start": 420.689,
    "end": 422.808,
    "duration": 2.119
  },
  {
    "id": 115,
    "text": "五十年代后期老舍创作的三幕话剧，",
    "start": 422.808,
    "end": 425.535,
    "duration": 2.727
  },
  {
    "id": 116,
    "text": "中国现代现实主义话剧艺术的巅峰之作。",
    "start": 425.535,
    "end": 430.207,
    "duration": 4.672
  },
  {
    "id": 117,
    "text": "剧作打破传统因果戏结构，独创“图卷戏”散点透视范式，",
    "start": 430.207,
    "end": 434.207,
    "duration": 4.0
  },
  {
    "id": 118,
    "text": "借北京裕泰茶馆半个世纪的变迁，",
    "start": 434.207,
    "end": 436.984,
    "duration": 2.777
  },
  {
    "id": 119,
    "text": "生动串联起七十多位形形色色的各阶层群像，",
    "start": 436.984,
    "end": 440.438,
    "duration": 3.454
  },
  {
    "id": 120,
    "text": "通过王利发等小人物的灭顶之灾，深刻揭示了清末、",
    "start": 440.438,
    "end": 444.388,
    "duration": 3.95
  },
  {
    "id": 121,
    "text": "北洋军阀至国民党反动统治三代旧制度不可逆转的历史灭亡必然性。",
    "start": 444.388,
    "end": 450.372,
    "duration": 5.984
  },
  {
    "id": 122,
    "text": "16. 《屈原》。",
    "start": 450.372,
    "end": 451.935,
    "duration": 1.563
  },
  {
    "id": 123,
    "text": "抗战相持阶段郭沫若在重庆创作的五幕浪漫主义历史剧。",
    "start": 451.935,
    "end": 457.274,
    "duration": 5.339
  },
  {
    "id": 124,
    "text": "剧作秉持“失事求似”的美学原则，",
    "start": 457.274,
    "end": 459.846,
    "duration": 2.572
  },
  {
    "id": 125,
    "text": "借战国时代楚国屈原坚持联齐抗秦、",
    "start": 459.846,
    "end": 462.814,
    "duration": 2.968
  },
  {
    "id": 126,
    "text": "惨遭南后与张仪陷害的崇高悲剧，深刻讽喻国民党消极抗战、",
    "start": 462.814,
    "end": 468.467,
    "duration": 5.653
  },
  {
    "id": 127,
    "text": "积极反共的黑暗现实。",
    "start": 468.467,
    "end": 470.356,
    "duration": 1.889
  },
  {
    "id": 128,
    "text": "剧中屈原在东皇太一庙迸发出的《雷电颂》，",
    "start": 470.356,
    "end": 473.697,
    "duration": 3.341
  },
  {
    "id": 129,
    "text": "以狂飙突进的诗情熔铸了中华民族宁死不屈的反侵略民族魂。",
    "start": 473.697,
    "end": 479.424,
    "duration": 5.727
  }
]