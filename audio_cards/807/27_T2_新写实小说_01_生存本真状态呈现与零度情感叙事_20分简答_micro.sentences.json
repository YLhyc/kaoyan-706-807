[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "精准对应“新写实三驾马车”一人一点：",
    "start": 0.0,
    "end": 3.88,
    "duration": 3.88
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "池莉《烦恼人生》（印家厚一日狼狈→原生态）+ 刘震云《一地鸡毛》（小林因变质豆腐与房子退化→消解崇高磨损）+ 方方《风景》（死婴亡灵冷眼→零度情感旁观），",
    "start": 3.929,
    "end": 15.969,
    "duration": 12.04
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "好记好写无敌稳！",
    "start": 16.419,
    "end": 18.019,
    "duration": 1.6
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "八十年代末至九十年代初伴随市场转型开启，",
    "start": 18.469,
    "end": 22.189,
    "duration": 3.72
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "池莉、刘震云、方方等掀起“新写实小说”流派，",
    "start": 22.639,
    "end": 26.479,
    "duration": 3.84
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "告别典型化原则与先锋形式实验。",
    "start": 26.929,
    "end": 29.929,
    "duration": 3.0
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 聚焦凡俗日常、呈“毛茸茸的原生态”",
    "start": 30.379,
    "end": 34.019,
    "duration": 3.64
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "摒弃非黑即白宏大叙事与概念说教，还生活以“毛茸茸的原生态”本真；",
    "start": 34.469,
    "end": 40.309,
    "duration": 5.84
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《烦恼人生》写操作工印家厚清早至夜的一天：",
    "start": 40.759,
    "end": 44.559,
    "duration": 3.8
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "带儿乘渡轮、抢水、照料啼儿、应付妻子唠叨与单位纠纷，",
    "start": 45.009,
    "end": 49.889,
    "duration": 4.88
  },
  {
    "id": "sec0_step1_c2",
    "dom_key": "sec0_step1_c2",
    "text": "生存负荷纤毫毕现。",
    "start": 50.339,
    "end": 52.139,
    "duration": 1.8
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 消解崇高神话、直面民众微韧生存困境",
    "start": 52.589,
    "end": 56.909,
    "duration": 4.32
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "淡化救世主式英雄，投向在琐碎生活中挣扎的凡夫俗子；",
    "start": 57.359,
    "end": 61.799,
    "duration": 4.44
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《一地鸡毛》写机关小职员小林由意气风发大学生退化为因一斤变质豆腐吵架、为分房调级钻营的庸碌市民，",
    "start": 62.249,
    "end": 70.529,
    "duration": 8.28
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "写出平庸磨损消耗。",
    "start": 70.979,
    "end": 72.739,
    "duration": 1.76
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 确立“零度情感”叙事、建冷静旁观视界",
    "start": 73.189,
    "end": 77.349,
    "duration": 4.16
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "克制主观道德审判与感伤喟叹，如冷眼摄影机般以节制语调记录流程；",
    "start": 77.799,
    "end": 83.759,
    "duration": 5.96
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《风景》借死于襁褓的婴儿亡灵视角，",
    "start": 84.209,
    "end": 86.929,
    "duration": 2.72
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "不动声色叙述汉口棚户区一家粗鄙残酷却又顽强繁衍的生命图景，",
    "start": 87.379,
    "end": 92.819,
    "duration": 5.44
  },
  {
    "id": "sec2_step1_c2",
    "dom_key": "sec2_step1_c2",
    "text": "拓展艺术张力。",
    "start": 93.269,
    "end": 94.509,
    "duration": 1.24
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：八十年代末九十年代初“新写实三驾马车”必记作品：",
    "start": 94.959,
    "end": 100.039,
    "duration": 5.08
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "池莉《烦恼人生》（印家厚）、刘震云《一地鸡毛》（小林与变质豆腐）、方方《风景》（死于襁褓的婴儿视角）。",
    "start": 100.489,
    "end": 108.369,
    "duration": 7.88
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 对齐新写实“三驾马车”池莉、刘震云、方方的三部代表作与主人公/核心道具？",
    "start": 108.819,
    "end": 116.219,
    "duration": 7.4
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合作品讲透“毛茸茸的原生态”“消解崇高与磨损”“零度情感”三大核心概念？",
    "start": 116.669,
    "end": 123.669,
    "duration": 7.0
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2016 真题简答《1980年代后期新写实主义小说艺术特征》？",
    "start": 124.119,
    "end": 130.959,
    "duration": 6.84
  }
]