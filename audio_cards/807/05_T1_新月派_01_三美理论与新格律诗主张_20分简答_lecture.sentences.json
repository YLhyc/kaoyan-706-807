[
  {
    "id": 1,
    "text": "一、全题宏观破题与总揽。",
    "start": 0.08,
    "end": 2.48,
    "duration": 2.4
  },
  {
    "id": 2,
    "text": "一、这一问到底在考什么？",
    "start": 2.48,
    "end": 4.72,
    "duration": 2.24
  },
  {
    "id": 3,
    "text": "本题考查新月诗派针对早期新诗流弊提出的美学主张及其新格律诗建设成就。",
    "start": 4.72,
    "end": 11.36,
    "duration": 6.64
  },
  {
    "id": 4,
    "text": "考生必须准确答出闻一多“戴着镣靠跳舞”的格律法则、",
    "start": 11.36,
    "end": 15.68,
    "duration": 4.32
  },
  {
    "id": 5,
    "text": "“三美”理论的核心内涵以及经典名作的艺术实践。",
    "start": 15.68,
    "end": 18.88,
    "duration": 3.2
  },
  {
    "id": 6,
    "text": "二、答题的总方向是什么？",
    "start": 19.2,
    "end": 21.52,
    "duration": 2.32
  },
  {
    "id": 7,
    "text": "紧扣钱理群《中国现代文学三十年》第六章的学术脉络。",
    "start": 21.52,
    "end": 25.92,
    "duration": 4.4
  },
  {
    "id": 8,
    "text": "将新月派定性为对五四自由诗散文化流弊的理性反拨，",
    "start": 25.92,
    "end": 30.88,
    "duration": 4.96
  },
  {
    "id": 9,
    "text": "讲透形式约束与艺术自由的辩证统一，",
    "start": 30.88,
    "end": 34.16,
    "duration": 3.28
  },
  {
    "id": 10,
    "text": "绝不能只列三美口号。",
    "start": 34.16,
    "end": 36.16,
    "duration": 2.0
  },
  {
    "id": 11,
    "text": "三、分几个板块展开？",
    "start": 36.16,
    "end": 38.08,
    "duration": 1.92
  },
  {
    "id": 12,
    "text": "简答题要求结构精练、得分点突出，",
    "start": 38.08,
    "end": 40.88,
    "duration": 2.8
  },
  {
    "id": 13,
    "text": "分三大板块展开：-第一板块：历史动因与审美原则（反拨散文化流弊、",
    "start": 40.88,
    "end": 47.075,
    "duration": 6.195
  },
  {
    "id": 14,
    "text": "戴着镣靠跳舞）。",
    "start": 47.075,
    "end": 48.477,
    "duration": 1.402
  },
  {
    "id": 15,
    "text": "第二板块：“三美”理论核心维度（音乐美之音尺、",
    "start": 48.477,
    "end": 52.684,
    "duration": 4.207
  },
  {
    "id": 16,
    "text": "绘画美之意象色彩、建筑美之节匀句齐）。",
    "start": 52.684,
    "end": 56.424,
    "duration": 3.74
  },
  {
    "id": 17,
    "text": "第三板块：经典文本实践与文学史功绩（闻一多《死水》以美显丑、",
    "start": 56.424,
    "end": 62.267,
    "duration": 5.843
  },
  {
    "id": 18,
    "text": "徐志摩《再别康桥》轻盈流转、推动新诗成熟）。",
    "start": 62.267,
    "end": 66.24,
    "duration": 3.973
  },
  {
    "id": 19,
    "text": "四、全篇内在逻辑链条是什么？",
    "start": 66.4,
    "end": 69.36,
    "duration": 2.96
  },
  {
    "id": 20,
    "text": "由流派针对的现实弊端与总体创作法则切入（反拨背景）趋近于逐层拆解其形式规范的三大审美维度（核心理论）趋近于结合标志性作品的艺术实践印证其文体成就（实践与地位）。",
    "start": 69.36,
    "end": 85.76,
    "duration": 16.4
  },
  {
    "id": 21,
    "text": "逻辑闭环严密。",
    "start": 85.76,
    "end": 86.88,
    "duration": 1.12
  },
  {
    "id": 22,
    "text": "二、各板块逐句咬合推演。",
    "start": 87.04,
    "end": 89.285,
    "duration": 2.245
  },
  {
    "id": 23,
    "text": "（一）宏观定性与破题总起板块。",
    "start": 89.285,
    "end": 91.98,
    "duration": 2.695
  },
  {
    "id": 24,
    "text": "破题推演逻辑：开头直接界定新月诗派的文学史定位。",
    "start": 91.98,
    "end": 96.92,
    "duration": 4.94
  },
  {
    "id": 25,
    "text": "说明其针对五四早期新诗散文化粗糙流弊的发生背景，",
    "start": 96.92,
    "end": 102.085,
    "duration": 5.165
  },
  {
    "id": 26,
    "text": "提出“戴着镣靠跳舞”的经典命题，",
    "start": 102.085,
    "end": 105.004,
    "duration": 2.919
  },
  {
    "id": 27,
    "text": "顺畅引出下文论述。",
    "start": 105.004,
    "end": 106.8,
    "duration": 1.796
  },
  {
    "id": 28,
    "text": "-逐句咬合推导：具体表述到答题语句就是：新月诗派是中国现代文学史上极具规范意识与美学自觉的现代诗歌流派。，",
    "start": 106.8,
    "end": 116.268,
    "duration": 9.468
  },
  {
    "id": 29,
    "text": "这是对考察对象的历史定性。",
    "start": 116.268,
    "end": 118.635,
    "duration": 2.367
  },
  {
    "id": 30,
    "text": "紧接着指出其发生背景与反拨对象，",
    "start": 118.635,
    "end": 121.594,
    "duration": 2.959
  },
  {
    "id": 31,
    "text": "具体表述到答题语句就是：针对五四早期白话新诗过于散文化与粗糙直白的弊端，",
    "start": 121.594,
    "end": 128.3,
    "duration": 6.706
  },
  {
    "id": 32,
    "text": "闻一多与徐志摩等诗人提出了系统的新格律诗理论。",
    "start": 128.3,
    "end": 132.64,
    "duration": 4.34
  },
  {
    "id": 33,
    "text": "随后亮出核心美学原则与时代功能，",
    "start": 132.856,
    "end": 136.056,
    "duration": 3.2
  },
  {
    "id": 34,
    "text": "具体表述到答题语句就是：他们确立了“戴着镣靠跳舞”的创作法则，",
    "start": 136.056,
    "end": 141.416,
    "duration": 5.36
  },
  {
    "id": 35,
    "text": "以形式的节制拯救了早期新诗的文体危机。",
    "start": 141.416,
    "end": 145.256,
    "duration": 3.84
  },
  {
    "id": 36,
    "text": "新月诗派是中国现代文学史上极具规范意识与美学自觉的现代诗歌流派。",
    "start": 145.256,
    "end": 151.096,
    "duration": 5.84
  },
  {
    "id": 37,
    "text": "针对五四早期白话新诗过于散文化与粗糙直白的弊端，",
    "start": 151.336,
    "end": 156.376,
    "duration": 5.04
  },
  {
    "id": 38,
    "text": "闻一多与徐志摩等诗人提出了系统的新格律诗理论。",
    "start": 156.376,
    "end": 160.536,
    "duration": 4.16
  },
  {
    "id": 39,
    "text": "他们确立了“戴着镣靠跳舞”的创作法则，",
    "start": 160.536,
    "end": 163.976,
    "duration": 3.44
  },
  {
    "id": 40,
    "text": "以形式的节制拯救了早期新诗的文体危机。",
    "start": 163.976,
    "end": 167.736,
    "duration": 3.76
  },
  {
    "id": 41,
    "text": "--。（二",
    "start": 167.736,
    "end": 167.896,
    "duration": 0.16
  },
  {
    "id": 42,
    "text": "）第一板块：“三美”理论的核心维度解析。",
    "start": 168.136,
    "end": 171.096,
    "duration": 2.96
  },
  {
    "id": 43,
    "text": "-论证推演逻辑：系统展开闻一多的“三美”理论。",
    "start": 171.336,
    "end": 175.256,
    "duration": 3.92
  },
  {
    "id": 44,
    "text": "必须指出音乐美强调音尺与汉语内在节拍，",
    "start": 175.256,
    "end": 179.176,
    "duration": 3.92
  },
  {
    "id": 45,
    "text": "绘画美强调辞藻色彩与意象构图，建筑美强调外形节的匀称与句的均齐。",
    "start": 179.176,
    "end": 185.709,
    "duration": 6.533
  },
  {
    "id": 46,
    "text": "避免抽象罗列，讲清每一美的内在技术机制。",
    "start": 185.709,
    "end": 189.629,
    "duration": 3.92
  },
  {
    "id": 47,
    "text": "逐句咬合推导：具体表述到答题语句就是：首先，",
    "start": 189.629,
    "end": 193.736,
    "duration": 4.107
  },
  {
    "id": 48,
    "text": "新月派的核心理论基石是闻一多提出的“三美”主张，",
    "start": 193.736,
    "end": 197.976,
    "duration": 4.24
  },
  {
    "id": 49,
    "text": "即音乐美、绘画美与建筑美。，",
    "start": 197.976,
    "end": 200.536,
    "duration": 2.56
  },
  {
    "id": 50,
    "text": "这是本板块的核心观点立桩。",
    "start": 200.536,
    "end": 202.856,
    "duration": 2.32
  },
  {
    "id": 51,
    "text": "紧接着剖析音乐美的技术机制，具体表述到答题语句就是：在音乐美上，",
    "start": 202.856,
    "end": 208.536,
    "duration": 5.68
  },
  {
    "id": 52,
    "text": "他们强调音尺的整齐与节拍的律动，",
    "start": 208.536,
    "end": 211.656,
    "duration": 3.12
  },
  {
    "id": 53,
    "text": "主张根据现代汉语本身的音调寻求内在和谐，",
    "start": 211.656,
    "end": 215.496,
    "duration": 3.84
  },
  {
    "id": 54,
    "text": "反对杂乱无章的散漫自由。",
    "start": 215.496,
    "end": 217.576,
    "duration": 2.08
  },
  {
    "id": 55,
    "text": "随后剖析绘画美的视觉构造，具体表述到答题语句就是：在绘画美上，",
    "start": 217.896,
    "end": 223.387,
    "duration": 5.491
  },
  {
    "id": 56,
    "text": "他们注重辞藻的选择与意象的色彩造型，",
    "start": 223.387,
    "end": 226.708,
    "duration": 3.321
  },
  {
    "id": 57,
    "text": "追求诗画相通的视觉美感。",
    "start": 226.708,
    "end": 228.858,
    "duration": 2.15
  },
  {
    "id": 58,
    "text": "最后剖析建筑美的外形对称，具体表述到答题语句就是：在建筑美上，",
    "start": 228.858,
    "end": 234.328,
    "duration": 5.47
  },
  {
    "id": 59,
    "text": "他们追求节的匀称与句的均齐，要求排版外形具备严谨的对称结构与形式秩序。",
    "start": 234.328,
    "end": 240.776,
    "duration": 6.448
  },
  {
    "id": 60,
    "text": "首先，新月派的核心理论基石是闻一多提出的“三美”主张，",
    "start": 240.936,
    "end": 246.056,
    "duration": 5.12
  },
  {
    "id": 61,
    "text": "即音乐美、绘画美与建筑美。",
    "start": 246.056,
    "end": 249.176,
    "duration": 3.12
  },
  {
    "id": 62,
    "text": "在音乐美上，他们强调音尺的整齐与节拍的律动，",
    "start": 249.176,
    "end": 253.576,
    "duration": 4.4
  },
  {
    "id": 63,
    "text": "主张根据现代汉语本身的音调寻求内在和谐，",
    "start": 253.576,
    "end": 257.336,
    "duration": 3.76
  },
  {
    "id": 64,
    "text": "反对杂乱无章的散漫自由。",
    "start": 257.336,
    "end": 259.816,
    "duration": 2.48
  },
  {
    "id": 65,
    "text": "在绘画美上，他们注重辞藻的选择与意象的色彩造型，",
    "start": 259.816,
    "end": 264.616,
    "duration": 4.8
  },
  {
    "id": 66,
    "text": "追求诗画相通的视觉美感。",
    "start": 264.616,
    "end": 266.616,
    "duration": 2.0
  },
  {
    "id": 67,
    "text": "在建筑美上，他们追求节的匀称与句的均齐，",
    "start": 266.936,
    "end": 271.016,
    "duration": 4.08
  },
  {
    "id": 68,
    "text": "要求排版外形具备严谨的对称结构与形式秩序。",
    "start": 271.016,
    "end": 275.816,
    "duration": 4.8
  },
  {
    "id": 69,
    "text": "--。（三",
    "start": 275.816,
    "end": 275.976,
    "duration": 0.16
  },
  {
    "id": 70,
    "text": "）第二板块：经典文本艺术实践与双峰印证。",
    "start": 276.296,
    "end": 279.896,
    "duration": 3.6
  },
  {
    "id": 71,
    "text": "-论证推演逻辑：理论必须有经典文本作为骨肉支撑。",
    "start": 280.2,
    "end": 284.585,
    "duration": 4.385
  },
  {
    "id": 72,
    "text": "选用闻一多《死水》与徐志摩《再别康桥》进行双子星对证。",
    "start": 284.585,
    "end": 289.178,
    "duration": 4.593
  },
  {
    "id": 73,
    "text": "分析《死水》在建筑美上的九字四句豆腐块与以美显丑反讽，",
    "start": 289.178,
    "end": 294.19,
    "duration": 5.012
  },
  {
    "id": 74,
    "text": "分析《再别康桥》在音乐美上的流转回环与理性节制，",
    "start": 294.19,
    "end": 298.574,
    "duration": 4.384
  },
  {
    "id": 75,
    "text": "说明形式如何承载深层诗意。",
    "start": 298.574,
    "end": 301.08,
    "duration": 2.506
  },
  {
    "id": 76,
    "text": "-逐句咬合推导：具体表述到答题语句就是：其次，",
    "start": 301.08,
    "end": 304.85,
    "duration": 3.77
  },
  {
    "id": 77,
    "text": "在艺术实践中，新月派诗人展现了高度成熟的文体实验品格。，",
    "start": 304.85,
    "end": 309.811,
    "duration": 4.961
  },
  {
    "id": 78,
    "text": "这是本板块的观点起笔。",
    "start": 309.811,
    "end": 311.795,
    "duration": 1.984
  },
  {
    "id": 79,
    "text": "紧接着引入闻一多《死水》的实证分析，",
    "start": 311.795,
    "end": 314.772,
    "duration": 2.977
  },
  {
    "id": 80,
    "text": "具体表述到答题语句就是：闻一多的《死水》是建筑美与以美显丑反讽的典范之作。",
    "start": 314.772,
    "end": 321.32,
    "duration": 6.548
  },
  {
    "id": 81,
    "text": "随后交代其形式特征与反讽效果，具体表述到答题语句就是：全诗每节四句，",
    "start": 321.48,
    "end": 327.74,
    "duration": 6.26
  },
  {
    "id": 82,
    "text": "每句九字，音尺整赤如同坚固的豆腐块，",
    "start": 327.74,
    "end": 331.112,
    "duration": 3.372
  },
  {
    "id": 83,
    "text": "以绚烂浓郁的辞藻反衬出现实深沉的绝望腐烂。",
    "start": 331.112,
    "end": 335.327,
    "duration": 4.215
  },
  {
    "id": 84,
    "text": "紧接着引入徐志摩《再别康桥》的实证分析，",
    "start": 335.327,
    "end": 338.91,
    "duration": 3.583
  },
  {
    "id": 85,
    "text": "具体表述到答题语句就是：徐志摩的《再别康桥》则是音乐美的化境。",
    "start": 338.91,
    "end": 344.6,
    "duration": 5.69
  },
  {
    "id": 86,
    "text": "随后展开其旋律与情感机制，具体表述到答题语句就是：全诗轻盈流转，",
    "start": 344.76,
    "end": 351.64,
    "duration": 6.88
  },
  {
    "id": 87,
    "text": "回环复沓，将离别愁绪化作流动的韵律，",
    "start": 351.64,
    "end": 355.48,
    "duration": 3.84
  },
  {
    "id": 88,
    "text": "实现了理性节制与丰沛情感的完美融合。",
    "start": 355.48,
    "end": 359.72,
    "duration": 4.24
  },
  {
    "id": 89,
    "text": "其次，在艺术实践中，新月派诗人展现了高度成熟的文体实验品格。",
    "start": 359.72,
    "end": 365.0,
    "duration": 5.28
  },
  {
    "id": 90,
    "text": "闻一多的《死水》是建筑美与以美显丑反讽的典范之作。",
    "start": 365.24,
    "end": 370.76,
    "duration": 5.52
  },
  {
    "id": 91,
    "text": "全诗每节四句，每句九字，音尺整赤如同坚固的豆腐块，",
    "start": 370.76,
    "end": 376.12,
    "duration": 5.36
  },
  {
    "id": 92,
    "text": "以绚烂浓郁的辞藻反衬出现实深沉的绝望腐烂。",
    "start": 376.12,
    "end": 380.68,
    "duration": 4.56
  },
  {
    "id": 93,
    "text": "徐志摩的《再别康桥》则是音乐美的化境。",
    "start": 380.68,
    "end": 384.36,
    "duration": 3.68
  },
  {
    "id": 94,
    "text": "全诗轻盈流转，回环复沓，将离别愁绪化作流动的韵律，",
    "start": 384.36,
    "end": 389.72,
    "duration": 5.36
  },
  {
    "id": 95,
    "text": "实现了理性节制与丰沛情感的完美融合。",
    "start": 389.72,
    "end": 393.16,
    "duration": 3.44
  },
  {
    "id": 96,
    "text": "（四）总结升华板块。",
    "start": 393.4,
    "end": 394.74,
    "duration": 1.34
  },
