[
  {
    "id": 1,
    "text": "试论郭沫若《女神》的自我抒情主人公形象与诗歌美学特色。",
    "start": 0.16,
    "end": 5.52,
    "duration": 5.36
  },
  {
    "id": 2,
    "text": "五四新文化运动高潮时期，郭沫若诗集《女神》的问世，",
    "start": 5.52,
    "end": 10.56,
    "duration": 5.04
  },
  {
    "id": 3,
    "text": "是中国现代新诗史上具有划时代意义的奠基之作。",
    "start": 10.56,
    "end": 14.96,
    "duration": 4.4
  },
  {
    "id": 4,
    "text": "它的成功在于五四时代精神与诗人浪漫主义个性的高度统一，",
    "start": 14.96,
    "end": 20.6,
    "duration": 5.64
  },
  {
    "id": 5,
    "text": "正所谓“个人的郁结，民族的郁结，",
    "start": 20.6,
    "end": 23.76,
    "duration": 3.16
  },
  {
    "id": 6,
    "text": "在浪漫主义这里找到了喷火口”。",
    "start": 23.76,
    "end": 26.72,
    "duration": 2.96
  },
  {
    "id": 7,
    "text": "郭沫若以火山爆发式的激情彻底打破了古典旧体诗歌的格律桎梏，",
    "start": 26.8,
    "end": 32.88,
    "duration": 6.08
  },
  {
    "id": 8,
    "text": "以泛神论哲学为精神基石，",
    "start": 32.88,
    "end": 34.88,
    "duration": 2.0
  },
  {
    "id": 9,
    "text": "塑造了具有多重精神维度的自我抒情主人公，",
    "start": 34.88,
    "end": 39.04,
    "duration": 4.16
  },
  {
    "id": 10,
    "text": "开创了阔大奇异的意象体系与绝端自由的现代新诗体式，",
    "start": 39.04,
    "end": 44.0,
    "duration": 4.96
  },
  {
    "id": 11,
    "text": "确立了中国现代浪漫主义新诗的崇高美学范式。",
    "start": 44.0,
    "end": 48.16,
    "duration": 4.16
  },
  {
    "id": 12,
    "text": "其思想意蕴与艺术成就主要体现在以下四个核心维度：",
    "start": 48.16,
    "end": 53.6,
    "duration": 5.44
  },
  {
    "id": 13,
    "text": "第一，塑造觉醒时代的多维抒情主人公，",
    "start": 53.6,
    "end": 57.44,
    "duration": 3.84
  },
  {
    "id": 14,
    "text": "实现“小我”与民族“大我”的崇高融合。",
    "start": 57.52,
    "end": 61.6,
    "duration": 4.08
  },
  {
    "id": 15,
    "text": "《女神》中的自我绝非狭隘孤立的个人倾诉，",
    "start": 61.6,
    "end": 65.76,
    "duration": 4.16
  },
  {
    "id": 16,
    "text": "而是被五四时代彻底激活的现代主体形象。",
    "start": 65.76,
    "end": 69.6,
    "duration": 3.84
  },
  {
    "id": 17,
    "text": "其抒情主人公呈现出层次丰富的光谱：",
    "start": 69.68,
    "end": 73.44,
    "duration": 3.76
  },
  {
    "id": 18,
    "text": "一是在《凤凰涅槃》中集香木自焚并于死灰中更生、",
    "start": 73.44,
    "end": 78.32,
    "duration": 4.88
  },
  {
    "id": 19,
    "text": "象征古老中华民族浴火重生的“大我”；",
    "start": 78.32,
    "end": 81.92,
    "duration": 3.6
  },
  {
    "id": 20,
    "text": "二是在《女神之再生》中宣告新酿的酒浆不能盛在旧皮囊中、",
    "start": 82.16,
    "end": 88.24,
    "duration": 6.08
  },
  {
    "id": 21,
    "text": "誓死彻底砸碎旧世界的“新人”；",
    "start": 88.24,
    "end": 91.6,
    "duration": 3.36
  },
  {
    "id": 22,
    "text": "三是在《天狗》中以吞食日月的狂暴能量高呼“我便是我”、",
    "start": 91.6,
    "end": 97.68,
    "duration": 6.08
  },
  {
    "id": 23,
    "text": "在中国文学史上首次宣告个体神性与自主意志的“神我”；",
    "start": 97.68,
    "end": 103.04,
    "duration": 5.36
  },
  {
    "id": 24,
    "text": "四是在《晨安》中以博大胸怀向大自然山川与世界人类文明致敬的“世界人”。",
    "start": 103.04,
    "end": 110.864,
    "duration": 7.824
  },
  {
    "id": 25,
    "text": "这些形象交织共振，",
    "start": 110.864,
    "end": 112.304,
    "duration": 1.44
  },
  {
    "id": 26,
    "text": "完整具象化了五四时期被压抑生命力破土而出的时代狂飙。",
    "start": 112.864,
    "end": 118.064,
    "duration": 5.2
  },
  {
    "id": 27,
    "text": "第二，揭示高亢狂飙背后的矛盾与沉郁，",
    "start": 118.064,
    "end": 121.744,
    "duration": 3.68
  },
  {
    "id": 28,
    "text": "立体呈现五四知识分子的精神搏斗。",
    "start": 122.384,
    "end": 125.664,
    "duration": 3.28
  },
  {
    "id": 29,
    "text": "高水平的浪漫主义绝非单一维度的狂热宣泄，",
    "start": 125.664,
    "end": 129.904,
    "duration": 4.24
  },
  {
    "id": 30,
    "text": "《女神》的抒情主人公同时包含着深沉的内在张力与悲凉底色。",
    "start": 130.224,
    "end": 136.384,
    "duration": 6.16
  },
  {
    "id": 31,
    "text": "在火山喷发般的豪迈赞歌背面，",
    "start": 136.384,
    "end": 138.864,
    "duration": 2.48
  },
  {
    "id": 32,
    "text": "深藏着现代个体在旧体制废墟上的孤独、眷恋与忏悔。",
    "start": 138.864,
    "end": 143.184,
    "duration": 4.32
  },
  {
    "id": 33,
    "text": "在《天狗》中，自我的极度膨胀伴随着剥皮食肉的自我凌迟；",
    "start": 143.184,
    "end": 148.784,
    "duration": 5.6
  },
  {
    "id": 34,
    "text": "在《湘累》中，",
    "start": 148.784,
    "end": 150.544,
    "duration": 1.76
  },
  {
    "id": 35,
    "text": "屈原在天马行空的创造之后陷入了不可言说的深沉寂寞；",
    "start": 150.544,
    "end": 155.744,
    "duration": 5.2
  },
  {
    "id": 36,
    "text": "而《凤凰涅槃》在追求主体极致爆发的同时，",
    "start": 155.744,
    "end": 159.824,
    "duration": 4.08
  },
  {
    "id": 37,
    "text": "最终又归结于“一切的一，和谐”的泛神论自我消融。",
    "start": 159.824,
    "end": 164.864,
    "duration": 5.04
  },
  {
    "id": 38,
    "text": "这种高亢与苦闷、狂暴与孤寂的二元交织，",
    "start": 164.864,
    "end": 168.464,
    "duration": 3.6
  },
  {
    "id": 39,
    "text": "真实深刻地度量了早期五四知识分子在启蒙裂变中的复杂心灵脉动。",
    "start": 168.464,
    "end": 174.704,
    "duration": 6.24
  },
  {
    "id": 40,
    "text": "第三，引入斯宾诺莎泛神论哲学，确立物我交融、",
    "start": 174.944,
    "end": 179.104,
    "duration": 4.16
  },
  {
    "id": 41,
    "text": "狂飙飞动的主体性意象体系。",
    "start": 179.104,
    "end": 181.664,
    "duration": 2.56
  },
  {
    "id": 42,
    "text": "郭沫若借鉴西方泛神论思想，提出“一切自然都是神的表现，",
    "start": 181.664,
    "end": 187.184,
    "duration": 5.52
  },
  {
    "id": 43,
    "text": "我即是神”的诗学命题，",
    "start": 187.184,
    "end": 189.344,
    "duration": 2.16
  },
  {
    "id": 44,
    "text": "并在创作中将其转化为独特的“泛我论”美学机制。",
    "start": 189.424,
    "end": 194.224,
    "duration": 4.8
  },
  {
    "id": 45,
    "text": "他彻底打破了人与自然对立的传统界限，",
    "start": 194.224,
    "end": 198.064,
    "duration": 3.84
  },
  {
    "id": 46,
    "text": "将主体意志强力灌注于宇宙万物，使自然的山川、",
    "start": 198.064,
    "end": 202.544,
    "duration": 4.48
  },
  {
    "id": 47,
    "text": "雷电与海洋均成为诗人奔涌情感的具象外化。",
    "start": 202.704,
    "end": 207.104,
    "duration": 4.4
  },
  {
    "id": 48,
    "text": "作品扫除了中国古典传统中常见的纤细、阴柔与感伤意象，",
    "start": 207.104,
    "end": 212.864,
    "duration": 5.76
  },
  {
    "id": 49,
    "text": "在《立在地球边上放号》中以排山倒海的呼告，将地球、",
    "start": 213.104,
    "end": 218.464,
    "duration": 5.36
  },
  {
    "id": 50,
    "text": "海洋与太阳推向极境，",
    "start": 218.464,
    "end": 220.784,
    "duration": 2.32
  },
  {
    "id": 51,
    "text": "赞颂不断毁坏又不断创造的“力的绘画”与“力的舞蹈”，",
    "start": 220.784,
    "end": 226.064,
    "duration": 5.28
  },
  {
    "id": 52,
    "text": "构筑起阔大、奇异与飞动的现代壮美意象群。",
    "start": 226.064,
    "end": 230.624,
    "duration": 4.56
  },
  {
    "id": 53,
    "text": "第四，打破传统声律镣铐，",
    "start": 230.624,
    "end": 233.024,
    "duration": 2.4
  },
  {
    "id": 54,
    "text": "确立“情绪决定形式”的现代自由诗范式。",
    "start": 233.024,
    "end": 237.104,
    "duration": 4.08
  },
  {
    "id": 55,
    "text": "郭沫若坚决反对古典旧诗与早期尝试派新诗的形式规约，",
    "start": 237.104,
    "end": 243.104,
    "duration": 6.0
  },
  {
    "id": 56,
    "text": "主张“诗的本职专在抒情”，",
    "start": 243.104,
    "end": 245.744,
    "duration": 2.64
  },
  {
    "id": 57,
    "text": "强调诗歌的外在节律必须完全服从内在情感的自然流淌。",
    "start": 245.744,
    "end": 250.944,
    "duration": 5.2
  },
  {
    "id": 58,
    "text": "他在创作中主要开创了两类典范形式：一类如《天狗》，",
    "start": 250.944,
    "end": 256.112,
    "duration": 5.168
  },
  {
    "id": 59,
    "text": "以一泻千里、长短错落的狂暴长句随情绪波澜自由舒卷，",
    "start": 256.112,
    "end": 261.232,
    "duration": 5.12
  },
  {
    "id": 60,
    "text": "创造了内蕴火山爆发力的自由体；另一类如《炉中煤》，",
    "start": 261.232,
    "end": 266.512,
    "duration": 5.28
  },
  {
    "id": 61,
    "text": "巧妙运用重叠、排比与自然音韵的复沓，",
    "start": 266.512,
    "end": 269.952,
    "duration": 3.44
  },
  {
    "id": 62,
    "text": "赋予深沉的眷念之情以和谐回环的内在声律。",
    "start": 269.952,
    "end": 271.472,
    "duration": 1.52
  },
  {
    "id": 63,
    "text": "这种彻底破格的文体解放，",
    "start": 271.312,
    "end": 271.472,
    "duration": 0.16
  },
  {
    "id": 64,
    "text": "为中国现代新诗的文体建设拓辟了无限广阔的表现空间。",
    "start": 271.312,
    "end": 271.472,
    "duration": 0.16
  },
  {
    "id": 65,
    "text": "综上所述，郭沫若的《女神》以时代的火山喷火口之势，",
    "start": 271.312,
    "end": 271.472,
    "duration": 0.16
  },
  {
    "id": 66,
    "text": "实现了民族精神、哲学开掘与诗体革命的美学统一。",
    "start": 271.312,
    "end": 271.472,
    "duration": 0.16
  },
  {
    "id": 67,
    "text": "它不仅开创了中国现代浪漫主义新诗的崭新历史，",
    "start": 271.312,
    "end": 271.472,
    "duration": 0.16
  },
  {
    "id": 68,
    "text": "更为中华民族在现代觉醒中树立了一座不可磨灭的精神丰碑。",
    "start": 271.312,
    "end": 271.472,
    "duration": 0.16
  }
]