[
  {
    "id": 1,
    "text": "一、全题宏观破题与总揽。",
    "start": 0.08,
    "end": 2.96,
    "duration": 2.88
  },
  {
    "id": 2,
    "text": "一、这一问到底在考什么？",
    "start": 2.96,
    "end": 5.2,
    "duration": 2.24
  },
  {
    "id": 3,
    "text": "本题考查郭沫若《女神》的艺术特色、",
    "start": 5.2,
    "end": 8.4,
    "duration": 3.2
  },
  {
    "id": 4,
    "text": "自我抒情主人公形象及其文学史地位。",
    "start": 8.4,
    "end": 11.76,
    "duration": 3.36
  },
  {
    "id": 5,
    "text": "考生必须紧扣钱理群《中国现代文学三十年》的权威体系，",
    "start": 11.76,
    "end": 16.8,
    "duration": 5.04
  },
  {
    "id": 6,
    "text": "透视其抒情主人公光谱、内在矛盾、",
    "start": 16.8,
    "end": 20.08,
    "duration": 3.28
  },
  {
    "id": 7,
    "text": "泛神论哲学、意象美学与自由诗体创新。",
    "start": 20.08,
    "end": 23.44,
    "duration": 3.36
  },
  {
    "id": 8,
    "text": "二、答题的总方向是什么？",
    "start": 23.76,
    "end": 26.24,
    "duration": 2.48
  },
  {
    "id": 9,
    "text": "答题必须立足“时代需要与诗人创作个性的统一”这一核心逻辑主线。",
    "start": 26.24,
    "end": 32.32,
    "duration": 6.08
  },
  {
    "id": 10,
    "text": "牢牢把握浪漫主义、个性解放、主体膨胀与形式自由的深度咬合，",
    "start": 32.32,
    "end": 37.92,
    "duration": 5.6
  },
  {
    "id": 11,
    "text": "绝不能平铺直叙罗列诗句。",
    "start": 37.92,
    "end": 40.4,
    "duration": 2.48
  },
  {
    "id": 12,
    "text": "三、分几个板块展开？",
    "start": 40.4,
    "end": 42.48,
    "duration": 2.08
  },
  {
    "id": 13,
    "text": "全篇按五大维度层层递进：-第一板块：自我抒情主人公四副面孔（大我、",
    "start": 42.48,
    "end": 48.658,
    "duration": 6.178
  },
  {
    "id": 14,
    "text": "新人、神我、世界人，小我与民族融合）。",
    "start": 48.658,
    "end": 51.835,
    "duration": 3.177
  },
  {
    "id": 15,
    "text": "第二板块：抒情主人公内在矛盾背面（天狗自爆、",
    "start": 51.835,
    "end": 56.147,
    "duration": 4.312
  },
  {
    "id": 16,
    "text": "湘累寂寞、五四时代心理立体反映）。",
    "start": 56.147,
    "end": 59.324,
    "duration": 3.177
  },
  {
    "id": 17,
    "text": "第三板块：泛神论哲学基础与泛我论机制（我即是神，",
    "start": 59.324,
    "end": 64.09,
    "duration": 4.766
  },
  {
    "id": 18,
    "text": "拆除人与自然隔阂，主体性膨胀）。",
    "start": 64.09,
    "end": 67.04,
    "duration": 2.95
  },
  {
    "id": 19,
    "text": "第四板块：意象系统革新（阔大、奇异、",
    "start": 67.12,
    "end": 70.72,
    "duration": 3.6
  },
  {
    "id": 20,
    "text": "飞动，力的绘画与舞蹈，太阳地球海洋）。",
    "start": 70.72,
    "end": 74.16,
    "duration": 3.44
  },
  {
    "id": 21,
    "text": "第五板块：自由诗体形式革命（情绪决定形式，",
    "start": 74.16,
    "end": 78.4,
    "duration": 4.24
  },
  {
    "id": 22,
    "text": "两型自由诗，天狗与炉中煤）。",
    "start": 78.4,
    "end": 81.44,
    "duration": 3.04
  },
  {
    "id": 23,
    "text": "四、全篇内在逻辑链条是什么？",
    "start": 81.44,
    "end": 84.4,
    "duration": 2.96
  },
  {
    "id": 24,
    "text": "由五四时代与浪漫精神交汇破题，趋近于剖析其时代核心造就的抒情主体形象（人），",
    "start": 84.4,
    "end": 91.36,
    "duration": 6.96
  },
  {
    "id": 25,
    "text": "趋近于揭示主体内心情感波澜与复杂矛盾（心），",
    "start": 91.36,
    "end": 96.08,
    "duration": 4.72
  },
  {
    "id": 26,
    "text": "趋近于溯源其打破人神界限的哲学基础（思），",
    "start": 96.08,
    "end": 100.16,
    "duration": 4.08
  },
  {
    "id": 27,
    "text": "趋近于展现其外化为宏伟画面的意象创造（象），",
    "start": 100.16,
    "end": 104.16,
    "duration": 4.0
  },
  {
    "id": 28,
    "text": "趋近于落实于承载一切情绪的自由诗歌形式革命（体）。",
    "start": 104.16,
    "end": 108.64,
    "duration": 4.48
  },
  {
    "id": 29,
    "text": "环环相扣，逻辑诊密。",
    "start": 108.72,
    "end": 110.96,
    "duration": 2.24
  },
  {
    "id": 30,
    "text": "二、各板块逐句咬合推演。",
    "start": 110.96,
    "end": 114.0,
    "duration": 3.04
  },
  {
    "id": 31,
    "text": "（一）宏观定性与破题总起板块。",
    "start": 114.0,
    "end": 117.04,
    "duration": 3.04
  },
  {
    "id": 32,
    "text": "破题推演逻辑：开头必须高屋建瓴，",
    "start": 117.04,
    "end": 120.4,
    "duration": 3.36
  },
  {
    "id": 33,
    "text": "首先界定《女神》在现代新诗史上的奠基地位。",
    "start": 120.4,
    "end": 124.24,
    "duration": 3.84
  },
  {
    "id": 34,
    "text": "接着引入教材核心理论公式：时代需要与诗人个性的统一，",
    "start": 124.24,
    "end": 129.68,
    "duration": 5.44
  },
  {
    "id": 35,
    "text": "指明浪漫主义作为时代喷火口的作用。",
    "start": 129.68,
    "end": 132.56,
    "duration": 2.88
  },
  {
    "id": 36,
    "text": "最后概括其在抒情主体、哲学基石、",
    "start": 132.8,
    "end": 135.76,
    "duration": 2.96
  },
  {
    "id": 37,
    "text": "意象体系与形式创造上的综合成就，",
    "start": 135.76,
    "end": 138.88,
    "duration": 3.12
  },
  {
    "id": 38,
    "text": "引出分述。",
    "start": 138.88,
    "end": 139.92,
    "duration": 1.04
  },
  {
    "id": 39,
    "text": "逐句咬合推导：具体表述到答题语句就是：郭沫若的诗集《女神》是中国现代新诗史上具有划时代意义的奠基之作。，",
    "start": 139.92,
    "end": 149.184,
    "duration": 9.264
  },
  {
    "id": 40,
    "text": "这是对考察对象的历史定性。",
    "start": 149.184,
    "end": 151.584,
    "duration": 2.4
  },
  {
    "id": 41,
    "text": "紧接着指出其成功的根本原因，具体表述到答题语句就是：它的成功在于五四时代精神与诗人浪漫主义个性的高度统一。",
    "start": 151.584,
    "end": 161.584,
    "duration": 10.0
  },
  {
    "id": 42,
    "text": "随后引用钱理群教材经典原话形象阐释，",
    "start": 161.744,
    "end": 165.744,
    "duration": 4.0
  },
  {
    "id": 43,
    "text": "具体表述到答题语句就是：个人与民族的深层郁结在浪漫主义这里找到了最充沛的喷火口。",
    "start": 165.744,
    "end": 172.801,
    "duration": 7.057
  },
  {
    "id": 44,
    "text": "紧接着指出其喷发带来的文体破坏力，",
    "start": 172.801,
    "end": 175.807,
    "duration": 3.006
  },
  {
    "id": 45,
    "text": "具体表述到答题语句就是：郭沫若以火山爆发式的激情，",
    "start": 175.807,
    "end": 180.129,
    "duration": 4.322
  },
  {
    "id": 46,
    "text": "打破了传统诗歌的僵化樊篱。",
    "start": 180.129,
    "end": 182.384,
    "duration": 2.255
  },
  {
    "id": 47,
    "text": "随后概括其人物塑造成就，具体表述到答题语句就是：它塑造了具有多重精神维度的自我抒情主人公。",
    "start": 182.544,
    "end": 190.891,
    "duration": 8.347
  },
  {
    "id": 48,
    "text": "最后落到哲学、意象与形式的综合建构，",
    "start": 190.891,
    "end": 194.02,
    "duration": 3.129
  },
  {
    "id": 49,
    "text": "具体表述到答题语句就是：它以泛神论哲学为思想基石，",
    "start": 194.02,
    "end": 198.517,
    "duration": 4.497
  },
  {
    "id": 50,
    "text": "创造了阔大奇异的意象系统与绝端自由的现代诗体，",
    "start": 198.517,
    "end": 202.82,
    "duration": 4.303
  },
  {
    "id": 51,
    "text": "在文学史上树立了空前自由的审美丰碑。",
    "start": 202.82,
    "end": 206.144,
    "duration": 3.324
  },
  {
    "id": 52,
    "text": "郭沫若的诗集《女神》是中国现代新诗史上具有划时代意义的奠基之作。",
    "start": 206.224,
    "end": 212.624,
    "duration": 6.4
  },
  {
    "id": 53,
    "text": "它的成功在于五四时代精神与诗人浪漫主义个性的高度统一。",
    "start": 212.624,
    "end": 217.664,
    "duration": 5.04
  },
  {
    "id": 54,
    "text": "个人与民族的深层郁结在浪漫主义这里找到了最充沛的喷火口。",
    "start": 217.664,
    "end": 222.944,
    "duration": 5.28
  },
  {
    "id": 55,
    "text": "郭沫若以火山爆发式的激情，打破了传统诗歌的僵化樊篱。",
    "start": 222.944,
    "end": 227.504,
    "duration": 4.56
  },
  {
    "id": 56,
    "text": "它塑造了具有多重精神维度的自我抒情主人公。",
    "start": 227.744,
    "end": 231.584,
    "duration": 3.84
  },
  {
    "id": 57,
    "text": "它以泛神论哲学为思想基石，创造了阔大奇异的意象系统与绝端自由的现代诗体，",
    "start": 231.584,
    "end": 238.544,
    "duration": 6.96
  },
  {
    "id": 58,
    "text": "在文学史上树立了空前自由的审美丰碑。",
    "start": 238.544,
    "end": 241.824,
    "duration": 3.28
  },
  {
    "id": 59,
    "text": "（二）第一板块：自我抒情主人公的四副面孔。",
    "start": 241.824,
    "end": 245.984,
    "duration": 4.16
  },
  {
    "id": 60,
    "text": "论证推演逻辑：讲透“自我抒情主人公”，",
    "start": 245.984,
    "end": 249.424,
    "duration": 3.44
  },
  {
    "id": 61,
    "text": "首先必须廓清误区：自我绝非小我发泄，",
    "start": 249.424,
    "end": 253.024,
    "duration": 3.6
  },
  {
    "id": 62,
    "text": "而是小我即大我。",
    "start": 253.024,
    "end": 254.944,
    "duration": 1.92
  },
  {
    "id": 63,
    "text": "接着必须完整、准确地列举出钱理群教材概括的四副面孔，",
    "start": 254.944,
    "end": 259.904,
    "duration": 4.96
  },
  {
    "id": 64,
    "text": "并逐一配以标志性名作的最小情节细节，",
    "start": 259.904,
    "end": 263.264,
    "duration": 3.36
  },
  {
    "id": 65,
    "text": "论证其在中国历史上第一次确立了人的尊严与价值。",
    "start": 263.264,
    "end": 266.864,
    "duration": 3.6
  },
  {
    "id": 66,
    "text": "-逐句咬合推导：具体表述到答题语句就是：首先，",
    "start": 267.024,
    "end": 270.895,
    "duration": 3.871
  },
  {
    "id": 67,
    "text": "在精神内涵上，《女神》成功塑造了体现五四时代觉醒的自我抒情主人公形象。，",
    "start": 270.895,
    "end": 277.212,
    "duration": 6.317
  },
  {
    "id": 68,
    "text": "这是第一分论点的核心观点立桩。",
    "start": 277.212,
    "end": 280.064,
    "duration": 2.852
  },
  {
    "id": 69,
    "text": "紧接着澄清小我与大我的辩证关系，",
    "start": 280.208,
    "end": 283.248,
    "duration": 3.04
  },
  {
    "id": 70,
    "text": "具体表述到答题语句就是：这一自我绝非孤立狭隘的个人发泄，",
    "start": 283.248,
    "end": 288.382,
    "duration": 5.134
  },
  {
    "id": 71,
    "text": "而是小我与民族大我的高度融合。",
    "start": 288.382,
    "end": 291.167,
    "duration": 2.785
  },
  {
    "id": 72,
    "text": "随后指出其丰富光谱，具体表述到答题语句就是：抒情主人公呈现出立体丰富的光谱。",
    "start": 291.167,
    "end": 298.128,
    "duration": 6.961
  },
  {
    "id": 73,
    "text": "紧接着剖析第一副面孔与代表作品，",
    "start": 298.208,
    "end": 300.849,
    "duration": 2.641
  },
  {
    "id": 74,
    "text": "具体表述到答题语句就是：其一是觉醒中华民族的“大我”，",
    "start": 300.849,
    "end": 305.917,
    "duration": 5.068
  },
  {
    "id": 75,
    "text": "《凤凰涅盘》中凤凰集香木自焚，在更生歌中象征着古老民族的涅盘重生。",
    "start": 305.917,
    "end": 312.306,
    "duration": 6.389
  },
  {
    "id": 76,
    "text": "随后剖析第二副面孔与代表作品，具体表述到答题语句就是：其二是彻底破坏旧世界的“新人”，",
    "start": 312.306,
    "end": 320.679,
    "duration": 8.373
  },
  {
    "id": 77,
    "text": "《女神之再生》宣告新酿的酒浆不能盛在旧皮囊中，",
    "start": 320.679,
    "end": 325.085,
    "duration": 4.406
  },
  {
    "id": 78,
    "text": "呼唤新太阳的升起。",
    "start": 325.085,
    "end": 326.848,
    "duration": 1.763
  },
  {
    "id": 79,
    "text": "紧接着剖析第三副面孔与代表作品，",
    "start": 326.928,
    "end": 329.808,
    "duration": 2.88
  },
  {
    "id": 80,
    "text": "具体表述到答题语句就是：其三是极度张扬个性价值的“神我”，",
    "start": 329.808,
    "end": 334.52,
    "duration": 4.712
  },
  {
    "id": 81,
    "text": "《天狗》以吞食宇宙的狂暴力量高呼“我便是我”，",
    "start": 334.52,
    "end": 337.983,
    "duration": 3.463
  },
  {
    "id": 82,
    "text": "在历史上第一次宣告了人的价值、尊严与创造力。",
    "start": 337.983,
    "end": 341.831,
    "duration": 3.848
  },
  {
    "id": 83,
    "text": "最后剖析第四副面孔与代表作品，具体表述到答题语句就是：其四是开眼看世界的“世界人”，",
    "start": 341.831,
    "end": 348.949,
    "duration": 7.118
  },
  {
    "id": 84,
    "text": "《晨安》向全世界自然山川与人类文明致敬，",
    "start": 348.949,
    "end": 352.219,
    "duration": 3.27
  },
  {
    "id": 85,
    "text": "展现了前所未有的广阔胸怀。",
    "start": 352.219,
    "end": 354.528,
    "duration": 2.309
  },
  {
    "id": 86,
    "text": "首先，在精神内涵上，《女神》成功塑造了体现五四时代觉醒的自我抒情主人公形象。",
    "start": 354.688,
    "end": 362.128,
    "duration": 7.44
  },
  {
    "id": 87,
    "text": "这一自我绝非孤立狭隘的个人发泄，",
    "start": 362.128,
    "end": 364.928,
    "duration": 2.8
  },
  {
    "id": 88,
    "text": "而是小我与民族大我的高度融合。",
    "start": 364.928,
    "end": 367.968,
    "duration": 3.04
  },
  {
    "id": 89,
    "text": "抒情主人公呈现出立体丰富的光谱。",
    "start": 367.968,
    "end": 371.168,
    "duration": 3.2
  },
  {
    "id": 90,
    "text": "其一是觉醒中华民族的“大我”，《凤凰涅盘》中凤凰集香木自焚，",
    "start": 371.168,
    "end": 376.528,
    "duration": 5.36
  },
  {
    "id": 91,
    "text": "在更生歌中象征着古老民族的涅盘重生。",
    "start": 376.528,
    "end": 379.808,
    "duration": 3.28
  },
  {
    "id": 92,
    "text": "其二是彻底破坏旧世界的“新人”，",
    "start": 380.128,
    "end": 383.008,
    "duration": 2.88
  },
  {
    "id": 93,
    "text": "《女神之再生》宣告新酿的酒浆不能盛在旧皮囊中，",
    "start": 383.008,
    "end": 387.408,
    "duration": 4.4
  },
  {
    "id": 94,
    "text": "呼唤新太阳的升起。",
    "start": 387.408,
    "end": 389.328,
    "duration": 1.92
  },
  {
    "id": 95,
    "text": "其三是极度张扬个性价值的“神我”，",
    "start": 389.328,
    "end": 392.368,
    "duration": 3.04
  },
  {
    "id": 96,
    "text": "《天狗》以吞食宇宙的狂暴力量高呼“我便是我”，",
    "start": 392.368,
    "end": 396.368,
    "duration": 4.0
  },
  {
    "id": 97,
    "text": "在历史上第一次宣告了人的价值、尊严与创造力。",
    "start": 396.368,
    "end": 399.968,
    "duration": 3.6
  },
  {
    "id": 98,
    "text": "其四是开眼看世界的“世界人”，《晨安》向全世界自然山川与人类文明致敬，",
    "start": 400.208,
    "end": 406.288,
    "duration": 6.08
  },
  {
    "id": 99,
    "text": "展现了前所未有的广阔胸怀。",
    "start": 406.288,
    "end": 408.928,
    "duration": 2.64
  },
  {
    "id": 100,
    "text": "（三）第二板块：抒情主人公内在矛盾背面与时代心理。",
    "start": 408.928,
    "end": 413.808,
    "duration": 4.88
  },
  {
    "id": 101,
    "text": "论证推演逻辑：高分论述的关键在于避免将人物脸谱化。",
    "start": 413.808,
    "end": 418.816,
    "duration": 5.008
  },
  {
    "id": 102,
    "text": "必须指出《女神》不仅有狂飙高歌，",
    "start": 418.816,
    "end": 421.536,
    "duration": 2.72
  },
  {
    "id": 103,
    "text": "更有背面的“不和谐音”。",
    "start": 421.536,
    "end": 423.216,
    "duration": 1.68
  },
  {
    "id": 104,
    "text": "以《天狗》的自暴自毁、《湘累》的倦怠孤独为证据，",
    "start": 423.216,
    "end": 426.576,
    "duration": 3.36
  },
  {
    "id": 105,
    "text": "说明高唱自由创造背后深藏着自我消融的悲凉。",
    "start": 426.576,
    "end": 430.416,
    "duration": 3.84
  },
  {
    "id": 106,
    "text": "正是这种矛盾，使它成为五四时代心理的立体反映。",
    "start": 430.416,
    "end": 434.016,
    "duration": 3.6
  },
  {
    "id": 107,
    "text": "-逐句咬合推导：具体表述到答题语句就是：其次，",
    "start": 434.176,
    "end": 438.182,
    "duration": 4.006
  },
  {
    "id": 108,
    "text": "抒情主人公并非单向度的盲目狂热，",
    "start": 438.182,
    "end": 441.345,
    "duration": 3.163
  },
  {
    "id": 109,
    "text": "而是包含着深层矛盾的复杂精神立体。，",
    "start": 441.345,
    "end": 444.718,
    "duration": 3.373
  },
  {
    "id": 110,
    "text": "这是第二分论点的观点立桩。",
    "start": 444.718,
    "end": 447.249,
    "duration": 2.531
  },
  {
    "id": 111,
    "text": "紧接着揭示激昂背后的深层情绪，具体表述到答题语句就是：在激昂狂暴的赞歌背面，",
    "start": 447.249,
    "end": 454.628,
    "duration": 7.379
  },
  {
    "id": 112,
    "text": "深藏着抒情主人公的孤独、倦怠与自叙传式的忏悔。",
    "start": 454.628,
    "end": 459.056,
    "duration": 4.428
  },
  {
    "id": 113,
    "text": "随后切入经典文本实证，具体表述到答题语句就是：《天狗》在自我极度膨胀中伴随着剥皮食肉的自我否定。",
    "start": 459.216,
    "end": 468.079,
    "duration": 8.863
  },
  {
    "id": 114,
    "text": "紧接着补充诗剧文本细节，具体表述到答题语句就是：《湘累》展现了屈原在创造天地之后的深沉寂寞。",
    "start": 468.079,
    "end": 476.522,
    "duration": 8.443
  },
  {
    "id": 115,
    "text": "随后指出热烈喷发之后的心理反拨，",
    "start": 476.522,
    "end": 479.61,
    "duration": 3.088
  },
  {
    "id": 116,
    "text": "具体表述到答题语句就是：《巨炮》流露出热烈喷发之后的虚脱与幻灭。",
    "start": 479.61,
    "end": 485.376,
    "duration": 5.766
  },
  {
    "id": 117,
    "text": "进一步阐明美学深层的内在悖论，具体表述到答题语句就是：在哲学美学上，",
    "start": 485.456,
    "end": 491.698,
    "duration": 6.242
  },
  {
    "id": 118,
    "text": "高唱自由创造的同时又在《凤凰涅盘》中归结为天人合一的自我消融。",
    "start": 491.698,
    "end": 497.442,
    "duration": 5.744
  },
  {
    "id": 119,
    "text": "最后总结这种多声部对五四时代心理的真实投射，",
    "start": 497.442,
    "end": 501.749,
    "duration": 4.307
  },
  {
    "id": 120,
    "text": "具体表述到答题语句就是：这种高亢与苦闷交织的多重声音，",
    "start": 501.749,
    "end": 506.878,
    "duration": 5.129
  },
  {
    "id": 121,
    "text": "真实深刻地反映了五四知识分子在启蒙浪潮中的复杂心理律动。",
    "start": 506.878,
    "end": 512.416,
    "duration": 5.538
  },
  {
    "id": 122,
    "text": "其次，抒情主人公并非单向度的盲目狂热，",
    "start": 512.576,
    "end": 516.256,
    "duration": 3.68
  },
  {
    "id": 123,
    "text": "而是包含着深层矛盾的复杂精神立体。",
    "start": 516.256,
    "end": 519.296,
    "duration": 3.04
  },
  {
    "id": 124,
    "text": "在激昂狂暴的赞歌背面，深藏着抒情主人公的孤独、",
    "start": 519.296,
    "end": 523.696,
    "duration": 4.4
  },
  {
    "id": 125,
    "text": "倦怠与自叙传式的忏悔。",
    "start": 523.696,
    "end": 526.576,
    "duration": 2.88
  },
  {
    "id": 126,
    "text": "《天狗》在自我极度膨胀中伴随着剥皮食肉的自我否定。",
    "start": 526.576,
    "end": 530.976,
    "duration": 4.4
  },
  {
    "id": 127,
    "text": "《湘累》展现了屈原在创造天地之后的深沉寂寞。",
    "start": 530.976,
    "end": 534.336,
    "duration": 3.36
  },
  {
    "id": 128,
    "text": "《巨炮》流露出热烈喷发之后的虚脱与幻灭。",
    "start": 534.496,
    "end": 538.206,
    "duration": 3.71
  },
  {
    "id": 129,
    "text": "在哲学美学上，高唱自由创造的同时又在《凤凰涅盘》中归结为天人合一的自我消融。",
    "start": 538.206,
    "end": 545.627,
    "duration": 7.421
  },
  {
    "id": 130,
    "text": "这种高亢与苦闷交织的多重声音，真实深刻地反映了五四知识分子在启蒙浪潮中的复杂心理律动。",
    "start": 545.627,
    "end": 554.576,
    "duration": 8.949
  },
  {
    "id": 131,
    "text": "（四）第三板块：泛神论哲学基石与“泛我论”机制。",
    "start": 554.576,
    "end": 558.836,
    "duration": 4.26
  },
  {
    "id": 132,
    "text": "论证推演逻辑：《女神》的艺术革命离不开其哲学内核。",
    "start": 558.836,
    "end": 563.659,
    "duration": 4.823
  },
  {
    "id": 133,
    "text": "必须准确解释斯宾诺莎泛神论的来源与郭沫若将其改造为“泛神便是无神，",
    "start": 563.659,
    "end": 570.593,
    "duration": 6.934
  },
  {
    "id": 134,
    "text": "我即是神”。",
    "start": 570.593,
    "end": 571.488,
    "duration": 0.895
  },
  {
    "id": 135,
    "text": "朱栋霖称其为“泛我论”。",
    "start": 571.488,
    "end": 573.501,
    "duration": 2.013
  },
  {
    "id": 136,
    "text": "解释这种哲学如何打破人与自然界限，",
    "start": 573.501,
    "end": 577.08,
    "duration": 3.579
  },
  {
    "id": 137,
    "text": "使自然成为自我的附庸，从而建立起新诗的主体性维度。",
    "start": 577.08,
    "end": 582.224,
    "duration": 5.144
  },
  {
    "id": 138,
    "text": "-逐句咬合推导：具体表述到答题语句就是：第三，",
    "start": 582.224,
    "end": 586.087,
    "duration": 3.863
  },
  {
    "id": 139,
    "text": "在哲学基石上，郭沫若以泛神论思想确立了新诗强烈的主体性维度。，",
    "start": 586.087,
    "end": 591.781,
    "duration": 5.694
  },
  {
    "id": 140,
    "text": "这是第三分论点的提纲窃领。",
    "start": 591.781,
    "end": 594.221,
    "duration": 2.44
  },
  {
    "id": 141,
    "text": "紧接着交代哲学来源与核心命题，具体表述到答题语句就是：郭沫若吸纳了斯宾诺莎泛神论思想，",
    "start": 594.221,
    "end": 602.354,
    "duration": 8.133
  },
  {
    "id": 142,
    "text": "提出“一切自然都是神的表现，我即是神”的诗学命题。",
    "start": 602.354,
    "end": 606.624,
    "duration": 4.27
  },
  {
    "id": 143,
    "text": "随后指出其向诗学机制的转化，具体表述到答题语句就是：这一观念在创作中转化为独特的“泛我论”机制。",
    "start": 606.784,
    "end": 615.287,
    "duration": 8.503
  },
  {
    "id": 144,
    "text": "紧接着阐明其打破客体壁垒的艺术效果，",
    "start": 615.287,
    "end": 618.631,
    "duration": 3.344
  },
  {
    "id": 145,
    "text": "具体表述到答题语句就是：它彻底拆除了人与自然之间的隔阂。",
    "start": 618.631,
    "end": 623.744,
    "duration": 5.113
  },
  {
    "id": 146,
    "text": "随后说明自然被完全主体化的现象，",
    "start": 623.904,
    "end": 626.624,
    "duration": 2.72
  },
  {
    "id": 147,
    "text": "具体表述到答题语句就是：自然界的山川、",
    "start": 626.624,
    "end": 630.01,
    "duration": 3.386
  },
  {
    "id": 148,
    "text": "雷电与风云全被赋予了作者的主体意志。",
    "start": 630.01,
    "end": 633.437,
    "duration": 3.427
  },
  {
    "id": 149,
    "text": "紧接着指出自我的神圣化，具体表述到答题语句就是：赞美地球与宇宙，",
    "start": 633.437,
    "end": 639.283,
    "duration": 5.846
  },
  {
    "id": 150,
    "text": "就是赞美诗人自我的崇高力量。",
    "start": 639.283,
    "end": 641.904,
    "duration": 2.621
  },
  {
    "id": 151,
    "text": "最后总结主体性确立对新诗的开创价值，",
    "start": 641.984,
    "end": 645.904,
    "duration": 3.92
  },
  {
    "id": 152,
    "text": "具体表述到答题语句就是：主体意识的急剧膨胀，",
    "start": 645.904,
    "end": 649.824,
    "duration": 3.92
  },
  {
    "id": 153,
    "text": "使自然万物成为诗人抒发个性激情的精神附庸，",
    "start": 649.824,
    "end": 653.664,
    "duration": 3.84
  },
  {
    "id": 154,
    "text": "为中国新诗注入了浩瀚的主观抒情力量。",
    "start": 653.664,
    "end": 657.024,
    "duration": 3.36
  },
  {
    "id": 155,
    "text": "第三，在哲学基石上，郭沫若以泛神论思想确立了新诗强烈的主体性维度。",
    "start": 657.184,
    "end": 663.584,
    "duration": 6.4
  },
  {
    "id": 156,
    "text": "郭沫若吸纳了斯宾诺莎泛神论思想，",
    "start": 663.904,
    "end": 666.944,
    "duration": 3.04
  },
  {
    "id": 157,
    "text": "提出“一切自然都是神的表现，我即是神”的诗学命题。",
    "start": 666.944,
    "end": 671.184,
    "duration": 4.24
  },
  {
    "id": 158,
    "text": "这一观念在创作中转化为独特的“泛我论”机制。",
    "start": 671.184,
    "end": 674.784,
    "duration": 3.6
  },
  {
    "id": 159,
    "text": "它彻底拆除了人与自然之间的隔阂。",
    "start": 674.784,
    "end": 677.424,
    "duration": 2.64
  },
  {
    "id": 160,
    "text": "自然界的山川、雷电与风云全被赋予了作者的主体意志。",
    "start": 677.424,
    "end": 681.504,
    "duration": 4.08
  },
  {
    "id": 161,
    "text": "赞美地球与宇宙，就是赞美诗人自我的崇高力量。",
    "start": 681.744,
    "end": 685.824,
    "duration": 4.08
  },
  {
    "id": 162,
    "text": "主体意识的急剧膨胀，使自然万物成为诗人抒发个性激情的精神附庸，",
    "start": 685.824,
    "end": 691.424,
    "duration": 5.6
  },
  {
    "id": 163,
    "text": "为中国新诗注入了浩瀚的主观抒情力量。",
    "start": 691.424,
    "end": 694.944,
    "duration": 3.52
  },
  {
    "id": 164,
    "text": "（五）第四板块：阔大奇异飞动的意象系统。",
    "start": 694.944,
    "end": 699.184,
    "duration": 4.24
  },
  {
    "id": 165,
    "text": "论证推演逻辑：思想需要意象作为物质载体。",
    "start": 699.184,
    "end": 703.328,
    "duration": 4.144
  },
  {
    "id": 166,
    "text": "必须点出郭沫若对古典诗歌纤细阴柔之风的反拨，",
    "start": 703.328,
    "end": 707.808,
    "duration": 4.48
  },
  {
    "id": 167,
    "text": "确立地球、海洋、太阳三大中心意象。",
    "start": 707.808,
    "end": 711.568,
    "duration": 3.76
  },
  {
    "id": 168,
    "text": "接着用钱理群归纳的阔大、奇异与飞动三大美学特征进行展开，",
    "start": 711.568,
    "end": 717.088,
    "duration": 5.52
  },
  {
    "id": 169,
    "text": "引入《立在地球边上放号》的力的呼告，",
    "start": 717.088,
    "end": 720.208,
    "duration": 3.12
  },
  {
    "id": 170,
    "text": "分析其浪漫主义壮美风格。",
    "start": 720.208,
    "end": 722.208,
    "duration": 2.0
  },
  {
    "id": 171,
    "text": "-逐句咬合推导：具体表述到答题语句就是：第四，",
    "start": 722.368,
    "end": 726.343,
    "duration": 3.975
  },
  {
    "id": 172,
    "text": "在诗歌意象上，《女神》创造了阔大、",
    "start": 726.343,
    "end": 729.063,
    "duration": 2.72
  },
  {
    "id": 173,
    "text": "奇异与飞动的崭新意象系统。，",
    "start": 729.063,
    "end": 731.574,
    "duration": 2.511
  },
  {
    "id": 174,
    "text": "这是第四分论点的核心观点。",
    "start": 731.574,
    "end": 734.085,
    "duration": 2.511
  },
  {
    "id": 175,
    "text": "紧接着说明其对传统古典诗风的扫荡，",
    "start": 734.085,
    "end": 737.433,
    "duration": 3.348
  },
  {
    "id": 176,
    "text": "具体表述到答题语句就是：郭沫若扫除了中国传统古典诗歌的纤细阴柔之美。",
    "start": 737.433,
    "end": 744.128,
    "duration": 6.695
  },
  {
    "id": 177,
    "text": "随后列出三大核心宇宙意象，具体表述到答题语句就是：他把包容一切的地球、",
    "start": 744.288,
    "end": 750.889,
    "duration": 6.601
  },
  {
    "id": 178,
    "text": "胸涌浩瀚的海洋与光芒万丈的太阳确立为核心意象。",
    "start": 750.889,
    "end": 755.66,
    "duration": 4.771
  },
  {
    "id": 179,
    "text": "紧接着分析奇异性特征，具体表述到答题语句就是：他的意象具有彻底人化的奇异性，",
    "start": 755.66,
    "end": 763.252,
    "duration": 7.592
  },
  {
    "id": 180,
    "text": "地球的雷霆被写成其呼吸的声威。",
    "start": 763.252,
    "end": 766.288,
    "duration": 3.036
  },
  {
    "id": 181,
    "text": "随后分析飞动性特征，具体表述到答题语句就是：他的意象更具有狂飙突进的飞动性。",
    "start": 766.448,
    "end": 773.472,
    "duration": 7.024
  },
  {
    "id": 182,
    "text": "紧接着切入经典篇目实证，具体表述到答题语句就是：《立在地球边上放号》以排山倒海的呼告，",
    "start": 773.472,
    "end": 781.109,
    "duration": 7.637
  },
  {
    "id": 183,
    "text": "赞颂不断毁坏与创造的力的绘画与力的舞蹈。",
    "start": 781.109,
    "end": 784.928,
    "duration": 3.819
  },
  {
    "id": 184,
    "text": "最后总结意象的美学象征意蕴，具体表述到答题语句就是：阔大飞动的壮美意象，",
    "start": 785.088,
    "end": 792.048,
    "duration": 6.96
  },
  {
    "id": 185,
    "text": "全面体现了摧毁旧世界的破坏力与创造新世纪的创造力。",
    "start": 792.048,
    "end": 796.768,
    "duration": 4.72
  },
  {
    "id": 186,
    "text": "第四，在诗歌意象上，《女神》创造了阔大、",
    "start": 796.768,
    "end": 800.448,
    "duration": 3.68
  },
  {
    "id": 187,
    "text": "奇异与飞动的崭新意象系统。",
    "start": 800.448,
    "end": 803.248,
    "duration": 2.8
  },
  {
    "id": 188,
    "text": "郭沫若扫除了中国传统古典诗歌的纤细阴柔之美。",
    "start": 803.248,
    "end": 807.088,
    "duration": 3.84
  },
  {
    "id": 189,
    "text": "他把包容一切的地球、胸涌浩瀚的海洋与光芒万丈的太阳确立为核心意象。",
    "start": 807.408,
    "end": 813.888,
    "duration": 6.48
  },
  {
    "id": 190,
    "text": "他的意象具有彻底人化的奇异性，地球的雷霆被写成其呼吸的声威。",
    "start": 813.888,
    "end": 819.808,
    "duration": 5.92
  },
  {
    "id": 191,
    "text": "他的意象更具有狂飙突进的飞动性。",
    "start": 819.808,
    "end": 822.928,
    "duration": 3.12
  },
  {
    "id": 192,
    "text": "《立在地球边上放号》以排山倒海的呼告，",
    "start": 822.928,
    "end": 826.368,
    "duration": 3.44
  },
  {
    "id": 193,
    "text": "赞颂不断毁坏与创造的力的绘画与力的舞蹈。",
    "start": 826.368,
    "end": 830.368,
    "duration": 4.0
  },
  {
    "id": 194,
    "text": "阔大飞动的壮美意象，全面体现了摧毁旧世界的破坏力与创造新世纪的创造力。",
    "start": 830.608,
    "end": 836.848,
    "duration": 6.24
  },
  {
    "id": 195,
    "text": "（六）第五板块：形式体制的解放与现代自由诗体范式。",
    "start": 836.848,
    "end": 841.568,
    "duration": 4.72
  },
  {
    "id": 196,
    "text": "论证推演逻辑：最后落到诗歌的体式与声音。",
    "start": 841.568,
    "end": 845.784,
    "duration": 4.216
  },
  {
    "id": 197,
    "text": "阐明郭沫若“形式绝端自由”的理论主张与“诗的本职专在抒情”。",
    "start": 845.784,
    "end": 850.984,
    "duration": 5.2
  },
  {
    "id": 198,
    "text": "分析自由诗的两大形态：一是长短不齐的狂暴喷发长句，",
    "start": 850.984,
    "end": 856.104,
    "duration": 5.12
  },
  {
    "id": 199,
    "text": "二是不规则押韵与排比复沓带来的内在旋律（《天狗》与《炉中煤》），",
    "start": 856.104,
    "end": 861.704,
    "duration": 5.6
  },
  {
    "id": 200,
    "text": "指出其在新诗形式建设上的奠基意义。",
    "start": 861.704,
    "end": 864.984,
    "duration": 3.28
  },
  {
    "id": 201,
    "text": "-逐句咬合推导：具体表述到答题语句就是：最后，",
    "start": 864.984,
    "end": 868.771,
    "duration": 3.787
  },
  {
    "id": 202,
    "text": "在形式体制上，《女神》创造了“绝端自由”的现代自由诗体范式。，",
    "start": 868.771,
    "end": 873.554,
    "duration": 4.783
  },
  {
    "id": 203,
    "text": "这是第五分论点的核心观点立桩。",
    "start": 873.554,
    "end": 876.344,
    "duration": 2.79
  },
  {
    "id": 204,
    "text": "紧接着说明其打破旧形式的主张，具体表述到答题语句就是：郭沫若坚决反对旧诗的形式镣靠，",
    "start": 876.344,
    "end": 884.117,
    "duration": 7.773
  },
  {
    "id": 205,
    "text": "主张情绪决定形式，提出诗的本职专在抒情。",
    "start": 884.117,
    "end": 887.704,
    "duration": 3.587
  },
  {
    "id": 206,
    "text": "随后说明其创造的形态谱系，具体表述到答题语句就是：他在创作中主要开创了两种形态。",
    "start": 887.864,
    "end": 895.257,
    "duration": 7.393
  },
  {
    "id": 207,
    "text": "紧接着剖析第一种喷泻式长句形态，",
    "start": 895.257,
    "end": 898.228,
    "duration": 2.971
  },
  {
    "id": 208,
    "text": "具体表述到答题语句就是：一种是如同火山喷涌般一泻无余的狂暴长句，",
    "start": 898.228,
    "end": 904.169,
    "duration": 5.941
  },
  {
    "id": 209,
    "text": "长短错落，随感情节奏自由舒卷。",
    "start": 904.169,
    "end": 906.744,
    "duration": 2.575
  },
  {
    "id": 210,
    "text": "随后剖析第二种内在旋律和谐形态，",
    "start": 906.904,
    "end": 909.784,
    "duration": 2.88
  },
  {
    "id": 211,
    "text": "具体表述到答题语句就是：另一种是巧妙运用复沓、",
    "start": 909.784,
    "end": 913.655,
    "duration": 3.871
  },
  {
    "id": 212,
    "text": "排比与不规则押韵。",
    "start": 913.655,
    "end": 915.214,
    "duration": 1.559
  },
  {
    "id": 213,
    "text": "紧接着切入实证篇目，具体表述到答题语句就是：《天狗》与《炉中煤》在自由变动中取得了内在旋律的和谐统一。",
    "start": 915.214,
    "end": 923.784,
    "duration": 8.57
  },
  {
    "id": 214,
    "text": "最后总结自由诗体对中国新诗文体建设的巨大贡献，",
    "start": 923.864,
    "end": 928.264,
    "duration": 4.4
  },
  {
    "id": 215,
    "text": "具体表述到答题语句就是：这种形式的彻底解放，",
    "start": 928.264,
    "end": 932.184,
    "duration": 3.92
  },
  {
    "id": 216,
    "text": "为中国现代新诗的文体建设开辟了无限广阔的表现空间。",
    "start": 932.184,
    "end": 936.904,
    "duration": 4.72
  },
  {
    "id": 217,
    "text": "最后，在形式体制上，《女神》创造了“绝端自由”的现代自由诗体范式。",
    "start": 936.904,
    "end": 942.504,
    "duration": 5.6
  },
  {
    "id": 218,
    "text": "郭沫若坚决反对旧诗的形式镣靠，主张情绪决定形式，",
    "start": 942.744,
    "end": 947.384,
    "duration": 4.64
  },
  {
    "id": 219,
    "text": "提出诗的本职专在抒情。",
    "start": 947.384,
    "end": 949.624,
    "duration": 2.24
  },
  {
    "id": 220,
    "text": "他在创作中主要开创了两种形态。",
    "start": 949.624,
    "end": 952.664,
    "duration": 3.04
  },
  {
    "id": 221,
    "text": "一种是如同火山喷涌般一泻无余的狂暴长句，",
    "start": 952.664,
    "end": 956.744,
    "duration": 4.08
  },
  {
    "id": 222,
    "text": "长短错落，随感情节奏自由舒卷。",
    "start": 956.744,
    "end": 959.944,
    "duration": 3.2
  },
  {
    "id": 223,
    "text": "另一种是巧妙运用复沓、排比与不规则押韵。",
    "start": 959.944,
    "end": 963.624,
    "duration": 3.68
  },
  {
    "id": 224,
    "text": "《天狗》与《炉中煤》在自由变动中取得了内在旋律的和谐统一。",
    "start": 963.784,
    "end": 968.941,
    "duration": 5.157
  },
  {
    "id": 225,
    "text": "这种形式的彻底解放，为中国现代新诗的文体建设开辟了无限广阔的表现空间。",
    "start": 968.941,
    "end": 976.031,
    "duration": 7.09
  },
  {
    "id": 226,
    "text": "（七）总结升华板块。",
    "start": 976.031,
    "end": 977.535,
    "duration": 1.504
  },
  {
    "id": 227,
    "text": "收口推演逻辑：统领全篇论述，重申《女神》在时代精神、",
    "start": 977.535,
    "end": 982.728,
    "duration": 5.193
  },
  {
    "id": 228,
    "text": "哲学深度与形式革命三个维度的伟大飞跃，",
    "start": 982.728,
    "end": 986.008,
    "duration": 3.28
  },
  {
    "id": 229,
    "text": "给出中国现代浪漫主义新诗至高丰碑的文学史定论。",
    "start": 986.008,
    "end": 990.648,
    "duration": 4.64
  },
  {
    "id": 230,
    "text": "逐句咬合推导：具体表述到答题语句就是：综上所述，",
    "start": 990.648,
    "end": 995.368,
    "duration": 4.72
  },
  {
    "id": 231,
    "text": "郭沫若的《女神》实现了时代精神、",
    "start": 995.368,
    "end": 997.928,
    "duration": 2.56
  },
  {
    "id": 232,
    "text": "哲学深度与形式革命的美学统一。",
    "start": 997.928,
    "end": 1000.568,
    "duration": 2.64
  },
  {
    "id": 233,
    "text": "最后收束在文学史的最高赞誉上，具体表述到答题语句就是：它以空前的个性解放解放了诗歌的形式与心灵，",
    "start": 1000.808,
    "end": 1010.328,
    "duration": 9.52
  },
  {
    "id": 234,
    "text": "确立了中国现代浪漫主义新诗的崇高美学范式。",
    "start": 1010.328,
    "end": 1014.408,
    "duration": 4.08
  },
  {
    "id": 235,
    "text": "综上所述，郭沫若的《女神》实现了时代精神、",
    "start": 1014.408,
    "end": 1018.008,
    "duration": 3.6
  },
  {
    "id": 236,
    "text": "哲学深度与形式革命的美学统一。",
    "start": 1018.008,
    "end": 1020.728,
    "duration": 2.72
  },
  {
    "id": 237,
    "text": "它以空前的个性解放解放了诗歌的形式与心灵，",
    "start": 1021.048,
    "end": 1024.648,
    "duration": 3.6
  },
  {
    "id": 238,
    "text": "确立了中国现代浪漫主义新诗的崇高美学范式。",
    "start": 1024.648,
    "end": 1028.008,
    "duration": 3.36
  }
]