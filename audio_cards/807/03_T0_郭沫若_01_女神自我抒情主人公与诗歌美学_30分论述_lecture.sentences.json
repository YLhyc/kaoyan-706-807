[
  {
    "id": 1,
    "text": "试论郭沫若《女神》的自我抒情主人公形象与诗歌美学特色。",
    "start": 0.16,
    "end": 4.883,
    "duration": 4.723
  },
  {
    "id": 2,
    "text": "五四新文化运动高潮时期，郭沫若诗集《女神》的问世，",
    "start": 5.311,
    "end": 9.255,
    "duration": 3.944
  },
  {
    "id": 3,
    "text": "是中国现代新诗史上的奠基之作。",
    "start": 9.579,
    "end": 12.151,
    "duration": 2.572
  },
  {
    "id": 4,
    "text": "它的成功在于五四时代精神与诗人浪漫主义个性的统一，",
    "start": 12.689,
    "end": 17.014,
    "duration": 4.325
  },
  {
    "id": 5,
    "text": "正所谓“个人的郁结，民族的郁结，",
    "start": 17.436,
    "end": 20.149,
    "duration": 2.713
  },
  {
    "id": 6,
    "text": "在浪漫主义这里找到了喷火口”。",
    "start": 20.438,
    "end": 22.629,
    "duration": 2.191
  },
  {
    "id": 7,
    "text": "郭沫若以火山爆发般的激情打破古典旧诗的格律桎梏，",
    "start": 22.834,
    "end": 27.493,
    "duration": 4.659
  },
  {
    "id": 8,
    "text": "以泛神论哲学为基石，塑造了多重维度的自我抒情主人公，",
    "start": 27.639,
    "end": 32.245,
    "duration": 4.606
  },
  {
    "id": 9,
    "text": "开创了阔大奇异的意象体系与自由新诗体式，",
    "start": 32.388,
    "end": 36.263,
    "duration": 3.875
  },
  {
    "id": 10,
    "text": "确立了现代浪漫主义新诗的崇高美学范式。",
    "start": 36.377,
    "end": 39.657,
    "duration": 3.28
  },
  {
    "id": 11,
    "text": "其思想意蕴与艺术成就主要体现在以下四个方面：",
    "start": 39.956,
    "end": 43.822,
    "duration": 3.866
  },
  {
    "id": 12,
    "text": "第一，塑造觉醒时代的多维抒情主人公，",
    "start": 44.497,
    "end": 47.908,
    "duration": 3.411
  },
  {
    "id": 13,
    "text": "达成“小我”与民族“大我”的崇高融合。",
    "start": 48.328,
    "end": 51.501,
    "duration": 3.173
  },
  {
    "id": 14,
    "text": "《女神》中的自我是被五四时代激活的现代主体形象。",
    "start": 51.949,
    "end": 55.759,
    "duration": 3.81
  },
  {
    "id": 15,
    "text": "其抒情主人公呈现出丰富的精神光谱：",
    "start": 56.28,
    "end": 59.209,
    "duration": 2.929
  },
  {
    "id": 16,
    "text": "一是在《凤凰涅槃》中集香木自焚并于死灰中更生、",
    "start": 59.674,
    "end": 63.722,
    "duration": 4.048
  },
  {
    "id": 17,
    "text": "象征古老中华民族浴火重生的“大我”；",
    "start": 64.014,
    "end": 67.077,
    "duration": 3.063
  },
  {
    "id": 18,
    "text": "二是在《女神之再生》中，借共工、颛顼争帝触折不周山后，",
    "start": 67.291,
    "end": 71.886,
    "duration": 4.595
  },
  {
    "id": 19,
    "text": "女神们拒绝修补破败旧天、",
    "start": 72.044,
    "end": 74.124,
    "duration": 2.08
  },
  {
    "id": 20,
    "text": "高唱“我们要去创造一个新鲜的太阳”的情节，",
    "start": 74.274,
    "end": 77.543,
    "duration": 3.269
  },
  {
    "id": 21,
    "text": "塑造出誓破旧世界、另造新天地的“新人”；",
    "start": 77.68,
    "end": 80.987,
    "duration": 3.307
  },
  {
    "id": 22,
    "text": "三是在《天狗》中以吞食日月的能量高呼“我便是我”、",
    "start": 81.294,
    "end": 85.472,
    "duration": 4.178
  },
  {
    "id": 23,
    "text": "首次宣告个体神性与自主意志的“神我”；",
    "start": 85.885,
    "end": 88.705,
    "duration": 2.82
  },
  {
    "id": 24,
    "text": "四是在《晨安》中向自然山川与世界人类文明致敬的“世界人”。",
    "start": 89.267,
    "end": 94.106,
    "duration": 4.839
  },
  {
    "id": 25,
    "text": "这些形象交织共振，具象化了五四时期生命力破土而出的时代狂飙。",
    "start": 94.381,
    "end": 100.019,
    "duration": 5.638
  },
  {
    "id": 26,
    "text": "第二，揭示高亢狂飙背后的矛盾与沉郁，",
    "start": 100.642,
    "end": 103.847,
    "duration": 3.205
  },
  {
    "id": 27,
    "text": "立体呈现五四知识分子的精神搏斗。",
    "start": 104.193,
    "end": 106.599,
    "duration": 2.406
  },
  {
    "id": 28,
    "text": "成熟的浪漫主义从不流于单一狂热宣泄，",
    "start": 106.982,
    "end": 110.038,
    "duration": 3.056
  },
  {
    "id": 29,
    "text": "《女神》的抒情主人公蕴含着深沉的内在张力与悲凉底色。",
    "start": 110.482,
    "end": 114.599,
    "duration": 4.117
  },
  {
    "id": 30,
    "text": "在火山喷发般的豪迈赞歌背面，",
    "start": 115.031,
    "end": 117.332,
    "duration": 2.301
  },
  {
    "id": 31,
    "text": "深藏着现代个体在旧体制废墟上的孤独、眷恋与忏悔。",
    "start": 117.662,
    "end": 122.227,
    "duration": 4.565
  },
  {
    "id": 32,
    "text": "在《天狗》中，自我的急剧膨胀伴随着剥皮食肉的自我凌迟；",
    "start": 122.487,
    "end": 126.951,
    "duration": 4.464
  },
  {
    "id": 33,
    "text": "在《湘累》中，",
    "start": 127.334,
    "end": 128.074,
    "duration": 0.74
  },
  {
    "id": 34,
    "text": "屈原在天马行空的创造之后陷入不可言说的寥寂；",
    "start": 128.387,
    "end": 132.451,
    "duration": 4.064
  },
  {
    "id": 35,
    "text": "《凤凰涅槃》在追求主体烈度爆发的同时，",
    "start": 132.893,
    "end": 136.024,
    "duration": 3.131
  },
  {
    "id": 36,
    "text": "最终归结于“一切的一，和谐”的泛神论自我消融。",
    "start": 136.298,
    "end": 140.498,
    "duration": 4.2
  },
  {
    "id": 37,
    "text": "高亢与苦闷、狂暴与孤寂的交织，",
    "start": 140.801,
    "end": 143.444,
    "duration": 2.643
  },
  {
    "id": 38,
    "text": "真实度量了五四知识分子在启蒙裂变中的复杂心灵脉动。",
    "start": 143.799,
    "end": 148.159,
    "duration": 4.36
  },
  {
    "id": 39,
    "text": "第三，引入泛神论哲学，确立物我交融、",
    "start": 148.865,
    "end": 152.231,
    "duration": 3.366
  },
  {
    "id": 40,
    "text": "狂飙飞动的主体性意象体系。",
    "start": 152.599,
    "end": 154.826,
    "duration": 2.227
  },
  {
    "id": 41,
    "text": "郭沫若借鉴斯宾诺莎等西方泛神论思想，",
    "start": 155.147,
    "end": 158.161,
    "duration": 3.014
  },
  {
    "id": 42,
    "text": "提出“一切自然只是神的表现，我即是神”的诗学命题，",
    "start": 158.486,
    "end": 162.811,
    "duration": 4.325
  },
  {
    "id": 43,
    "text": "并在创作中转化为独特的“泛我论”美学机制。",
    "start": 163.111,
    "end": 166.477,
    "duration": 3.366
  },
  {
    "id": 44,
    "text": "他打破人与自然对立的传统界限，将主体意志灌注于宇宙万物，",
    "start": 166.908,
    "end": 171.696,
    "duration": 4.788
  },
  {
    "id": 45,
    "text": "使山川、雷电与海洋均成为奔涌情感的外化。",
    "start": 171.981,
    "end": 175.993,
    "duration": 4.012
  },
  {
    "id": 46,
    "text": "作品扫除中国古典传统中常见的纤细、阴柔与感伤意象，",
    "start": 176.195,
    "end": 180.883,
    "duration": 4.688
  },
  {
    "id": 47,
    "text": "在《立在地球边上放号》中以排山倒海的呼告，将地球、",
    "start": 181.045,
    "end": 185.542,
    "duration": 4.497
  },
  {
    "id": 48,
    "text": "海洋与太阳推向极境，",
    "start": 185.631,
    "end": 187.451,
    "duration": 1.82
  },
  {
    "id": 49,
    "text": "赞颂不断毁坏又不断创造的“力的绘画”与“力的舞蹈”，",
    "start": 187.576,
    "end": 191.849,
    "duration": 4.273
  },
  {
    "id": 50,
    "text": "构筑起阔大、奇异与飞动的现代壮美意象群。",
    "start": 192.155,
    "end": 196.316,
    "duration": 4.161
  },
  {
    "id": 51,
    "text": "第四，打破传统声律镣铐，",
    "start": 196.922,
    "end": 199.16,
    "duration": 2.238
  },
  {
    "id": 52,
    "text": "确立“情绪决定形式”的现代自由诗范式。",
    "start": 199.59,
    "end": 203.392,
    "duration": 3.802
  },
  {
    "id": 53,
    "text": "郭沫若反对古典旧诗与早期尝试派新诗的形式规约，",
    "start": 203.671,
    "end": 208.023,
    "duration": 4.352
  },
  {
    "id": 54,
    "text": "主张“诗的本职专在抒情”，",
    "start": 208.395,
    "end": 211.206,
    "duration": 2.811
  },
  {
    "id": 55,
    "text": "强调外在节律必须服从内在情感的自然流淌。",
    "start": 211.469,
    "end": 215.103,
    "duration": 3.634
  },
  {
    "id": 56,
    "text": "他在创作中开创了两类典范形式：一类如《天狗》，",
    "start": 215.806,
    "end": 219.793,
    "duration": 3.987
  },
  {
    "id": 57,
    "text": "以一泻千里、长短错落的句式随情绪波澜自由舒卷，",
    "start": 220.048,
    "end": 225.066,
    "duration": 5.018
  },
  {
    "id": 58,
    "text": "创造了富有火山爆发力的自由体；另一类如《炉中煤》，",
    "start": 225.436,
    "end": 230.028,
    "duration": 4.592
  },
  {
    "id": 59,
    "text": "巧妙运用重叠、排比与自然音韵的复沓，",
    "start": 230.354,
    "end": 233.892,
    "duration": 3.538
  },
  {
    "id": 60,
    "text": "赋予深沉眷念以和谐回环的内在声律。",
    "start": 234.082,
    "end": 237.607,
    "duration": 3.525
  },
  {
    "id": 61,
    "text": "这种大胆破格的文体解放，为中国现代新诗拓辟了广阔的表现空间。",
    "start": 237.801,
    "end": 243.264,
    "duration": 5.463
  },
  {
    "id": 62,
    "text": "要而言之，郭沫若的《女神》以时代喷火口之势，",
    "start": 243.953,
    "end": 247.97,
    "duration": 4.017
  },
  {
    "id": 63,
    "text": "达成了民族精神、哲学开掘与诗体革命的高度统一。",
    "start": 248.22,
    "end": 252.323,
    "duration": 4.103
  },
  {
    "id": 64,
    "text": "它开创了中国现代浪漫主义新诗的崭新篇章，",
    "start": 252.558,
    "end": 255.571,
    "duration": 3.013
  },
  {
    "id": 65,
    "text": "为中国新诗在现代觉醒中奠定了坚实的精神基石。",
    "start": 255.807,
    "end": 259.956,
    "duration": 4.149
  }
]