[
  {
    "id": 1,
    "text": "试论郭沫若《女神》的自我抒情主人公形象与诗歌美学特色。",
    "start": 0.086,
    "end": 5.151,
    "duration": 5.065
  },
  {
    "id": 2,
    "text": "五四新文化运动高潮时期，郭沫若诗集《女神》的问世，",
    "start": 5.395,
    "end": 9.407,
    "duration": 4.012
  },
  {
    "id": 3,
    "text": "是中国现代新诗史上具有划时代意义的奠基之作。",
    "start": 9.628,
    "end": 13.667,
    "duration": 4.039
  },
  {
    "id": 4,
    "text": "它的成功在于五四时代精神与诗人浪漫主义个性的高度统一，",
    "start": 13.989,
    "end": 18.88,
    "duration": 4.891
  },
  {
    "id": 5,
    "text": "正所谓“个人的郁结，民族的郁结，",
    "start": 19.109,
    "end": 21.939,
    "duration": 2.83
  },
  {
    "id": 6,
    "text": "在浪漫主义这里找到了喷火口”。",
    "start": 21.939,
    "end": 24.408,
    "duration": 2.469
  },
  {
    "id": 7,
    "text": "郭沫若以火山爆发式的激情彻底打破了古典旧体诗歌的格律桎梏，",
    "start": 24.66,
    "end": 29.866,
    "duration": 5.206
  },
  {
    "id": 8,
    "text": "以泛神论哲学为精神基石，",
    "start": 30.235,
    "end": 32.393,
    "duration": 2.158
  },
  {
    "id": 9,
    "text": "塑造了具有多重精神维度的自我抒情主人公，",
    "start": 32.506,
    "end": 35.875,
    "duration": 3.369
  },
  {
    "id": 10,
    "text": "开创了阔大奇异的意象体系与绝端自由的现代新诗体式，",
    "start": 36.11,
    "end": 41.211,
    "duration": 5.101
  },
  {
    "id": 11,
    "text": "确立了中国现代浪漫主义新诗的崇高美学范式。",
    "start": 41.293,
    "end": 44.797,
    "duration": 3.504
  },
  {
    "id": 12,
    "text": "其思想意蕴与艺术成就主要体现在以下四个核心维度：",
    "start": 44.98,
    "end": 49.243,
    "duration": 4.263
  },
  {
    "id": 13,
    "text": "第一，塑造觉醒时代的多维抒情主人公，",
    "start": 49.543,
    "end": 52.856,
    "duration": 3.313
  },
  {
    "id": 14,
    "text": "实现“小我”与民族“大我”的崇高融合。",
    "start": 53.208,
    "end": 56.077,
    "duration": 2.869
  },
  {
    "id": 15,
    "text": "《女神》中的自我绝非狭隘孤立的个人倾诉，",
    "start": 56.493,
    "end": 59.656,
    "duration": 3.163
  },
  {
    "id": 16,
    "text": "而是被五四时代彻底激活的现代主体形象。",
    "start": 60.018,
    "end": 63.401,
    "duration": 3.383
  },
  {
    "id": 17,
    "text": "其抒情主人公呈现出层次丰富的光谱：",
    "start": 63.619,
    "end": 66.874,
    "duration": 3.255
  },
  {
    "id": 18,
    "text": "一是在《凤凰涅槃》中集香木自焚并于死灰中更生、",
    "start": 67.079,
    "end": 71.225,
    "duration": 4.146
  },
  {
    "id": 19,
    "text": "象征古老中华民族浴火重生的“大我”；",
    "start": 71.42,
    "end": 74.433,
    "duration": 3.013
  },
  {
    "id": 20,
    "text": "二是在《女神之再生》中宣告新酿的酒浆不能盛在旧皮囊中、",
    "start": 74.658,
    "end": 79.708,
    "duration": 5.05
  },
  {
    "id": 21,
    "text": "誓死彻底砸碎旧世界的“新人”；",
    "start": 79.729,
    "end": 81.989,
    "duration": 2.26
  },
  {
    "id": 22,
    "text": "三是在《天狗》中以吞食日月的狂暴能量高呼“我便是我”、",
    "start": 82.158,
    "end": 87.145,
    "duration": 4.987
  },
  {
    "id": 23,
    "text": "在中国文学史上首次宣告个体神性与自主意志的“神我”；",
    "start": 87.509,
    "end": 92.128,
    "duration": 4.619
  },
  {
    "id": 24,
    "text": "四是在《晨安》中以博大胸怀向大自然山川与世界人类文明致敬的“世界人”。",
    "start": 92.548,
    "end": 98.707,
    "duration": 6.159
  },
  {
    "id": 25,
    "text": "这些形象交织共振，",
    "start": 98.902,
    "end": 100.478,
    "duration": 1.576
  },
  {
    "id": 26,
    "text": "完整具象化了五四时期被压抑生命力破土而出的时代狂飙。",
    "start": 100.764,
    "end": 105.55,
    "duration": 4.786
  },
  {
    "id": 27,
    "text": "第二，揭示高亢狂飙背后的矛盾与沉郁，",
    "start": 105.843,
    "end": 109.13,
    "duration": 3.287
  },
  {
    "id": 28,
    "text": "立体呈现五四知识分子的精神搏斗。",
    "start": 109.41,
    "end": 112.342,
    "duration": 2.932
  },
  {
    "id": 29,
    "text": "高水平的浪漫主义绝非单一维度的狂热宣泄，",
    "start": 113.017,
    "end": 116.51,
    "duration": 3.493
  },
  {
    "id": 30,
    "text": "《女神》的抒情主人公同时包含着深沉的内在张力与悲凉底色。",
    "start": 117.003,
    "end": 122.332,
    "duration": 5.329
  },
  {
    "id": 31,
    "text": "在火山喷发般的豪迈赞歌背面，",
    "start": 122.496,
    "end": 124.772,
    "duration": 2.276
  },
  {
    "id": 32,
    "text": "深藏着现代个体在旧体制废墟上的孤独、眷恋与忏悔。",
    "start": 124.974,
    "end": 129.927,
    "duration": 4.953
  },
  {
    "id": 33,
    "text": "在《天狗》中，自我的极度膨胀伴随着剥皮食肉的自我凌迟；",
    "start": 130.173,
    "end": 134.831,
    "duration": 4.658
  },
  {
    "id": 34,
    "text": "在《湘累》中，",
    "start": 135.244,
    "end": 136.112,
    "duration": 0.868
  },
  {
    "id": 35,
    "text": "屈原在天马行空的创造之后陷入了不可言说的深沉寂寞；",
    "start": 136.211,
    "end": 140.478,
    "duration": 4.267
  },
  {
    "id": 36,
    "text": "而《凤凰涅槃》在追求主体极致爆发的同时，",
    "start": 140.573,
    "end": 143.653,
    "duration": 3.08
  },
  {
    "id": 37,
    "text": "最终又归结于“一切的一，和谐”的泛神论自我消融。",
    "start": 143.728,
    "end": 147.61,
    "duration": 3.882
  },
  {
    "id": 38,
    "text": "这种高亢与苦闷、狂暴与孤寂的二元交织，",
    "start": 147.836,
    "end": 151.388,
    "duration": 3.552
  },
  {
    "id": 39,
    "text": "真实深刻地度量了早期五四知识分子在启蒙裂变中的复杂心灵脉动。",
    "start": 151.691,
    "end": 157.459,
    "duration": 5.768
  },
  {
    "id": 40,
    "text": "第三，引入斯宾诺莎泛神论哲学，确立物我交融、",
    "start": 157.656,
    "end": 161.883,
    "duration": 4.227
  },
  {
    "id": 41,
    "text": "狂飙飞动的主体性意象体系。",
    "start": 161.934,
    "end": 164.237,
    "duration": 2.303
  },
  {
    "id": 42,
    "text": "郭沫若借鉴西方泛神论思想，提出“一切自然都是神的表现，",
    "start": 164.285,
    "end": 168.686,
    "duration": 4.401
  },
  {
    "id": 43,
    "text": "我即是神”的诗学命题，",
    "start": 168.82,
    "end": 170.519,
    "duration": 1.699
  },
  {
    "id": 44,
    "text": "并在创作中将其转化为独特的“泛我论”美学机制。",
    "start": 170.943,
    "end": 174.757,
    "duration": 3.814
  },
  {
    "id": 45,
    "text": "他彻底打破了人与自然对立的传统界限，",
    "start": 174.963,
    "end": 177.938,
    "duration": 2.975
  },
  {
    "id": 46,
    "text": "将主体意志强力灌注于宇宙万物，使自然的山川、",
    "start": 178.271,
    "end": 182.193,
    "duration": 3.922
  },
  {
    "id": 47,
    "text": "雷电与海洋均成为诗人奔涌情感的具象外化。",
    "start": 182.193,
    "end": 186.079,
    "duration": 3.886
  },
  {
    "id": 48,
    "text": "作品扫除了中国古典传统中常见的纤细、阴柔与感伤意象，",
    "start": 186.184,
    "end": 191.015,
    "duration": 4.831
  },
  {
    "id": 49,
    "text": "在《立在地球边上放号》中以排山倒海的呼告，将地球、",
    "start": 191.154,
    "end": 195.457,
    "duration": 4.303
  },
  {
    "id": 50,
    "text": "海洋与太阳推向极境，",
    "start": 195.457,
    "end": 197.243,
    "duration": 1.786
  },
  {
    "id": 51,
    "text": "赞颂不断毁坏又不断创造的“力的绘画”与“力的舞蹈”，",
    "start": 197.295,
    "end": 201.439,
    "duration": 4.144
  },
  {
    "id": 52,
    "text": "构筑起阔大、奇异与飞动的现代壮美意象群。",
    "start": 201.543,
    "end": 205.204,
    "duration": 3.661
  },
  {
    "id": 53,
    "text": "第四，打破传统声律镣铐，",
    "start": 205.362,
    "end": 208.003,
    "duration": 2.641
  },
  {
    "id": 54,
    "text": "确立“情绪决定形式”的现代自由诗范式。",
    "start": 208.048,
    "end": 211.536,
    "duration": 3.488
  },
  {
    "id": 55,
    "text": "郭沫若坚决反对古典旧诗与早期尝试派新诗的形式规约，",
    "start": 211.654,
    "end": 216.617,
    "duration": 4.963
  },
  {
    "id": 56,
    "text": "主张“诗的本职专在抒情”，",
    "start": 216.657,
    "end": 219.34,
    "duration": 2.683
  },
  {
    "id": 57,
    "text": "强调诗歌的外在节律必须完全服从内在情感的自然流淌。",
    "start": 219.383,
    "end": 224.277,
    "duration": 4.894
  },
  {
    "id": 58,
    "text": "他在创作中主要开创了两类典范形式：一类如《天狗》，",
    "start": 224.48,
    "end": 228.589,
    "duration": 4.109
  },
  {
    "id": 59,
    "text": "以一泻千里、长短错落的狂暴长句随情绪波澜自由舒卷，",
    "start": 228.768,
    "end": 233.684,
    "duration": 4.916
  },
  {
    "id": 60,
    "text": "创造了内蕴火山爆发力的自由体；另一类如《炉中煤》，",
    "start": 233.761,
    "end": 238.312,
    "duration": 4.551
  },
  {
    "id": 61,
    "text": "巧妙运用重叠、排比与自然音韵的复沓，",
    "start": 238.538,
    "end": 242.0,
    "duration": 3.462
  },
  {
    "id": 62,
    "text": "赋予深沉的眷念之情以和谐回环的内在声律。",
    "start": 242.324,
    "end": 245.967,
    "duration": 3.643
  },
  {
    "id": 63,
    "text": "这种彻底破格的文体解放，",
    "start": 246.335,
    "end": 248.275,
    "duration": 1.94
  },
  {
    "id": 64,
    "text": "为中国现代新诗的文体建设拓辟了无限广阔的表现空间。",
    "start": 248.45,
    "end": 252.977,
    "duration": 4.527
  },
  {
    "id": 65,
    "text": "综上所述，郭沫若的《女神》以时代的火山喷火口之势，",
    "start": 253.259,
    "end": 257.403,
    "duration": 4.144
  },
  {
    "id": 66,
    "text": "实现了民族精神、哲学开掘与诗体革命的美学统一。",
    "start": 257.655,
    "end": 261.866,
    "duration": 4.211
  },
  {
    "id": 67,
    "text": "它不仅开创了中国现代浪漫主义新诗的崭新历史，",
    "start": 262.411,
    "end": 265.955,
    "duration": 3.544
  },
  {
    "id": 68,
    "text": "更为中华民族在现代觉醒中树立了一座不可磨灭的精神丰碑。",
    "start": 266.38,
    "end": 271.68,
    "duration": 5.3
  }
]
