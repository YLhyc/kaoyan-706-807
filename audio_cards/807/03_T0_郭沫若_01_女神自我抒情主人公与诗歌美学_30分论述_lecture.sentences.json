[
  {
    "id": 1,
    "text": "一、全题宏观破题与总揽。",
    "start": 0.08,
    "end": 2.96,
    "duration": 2.88
  },
  {
    "id": 2,
    "text": "一、这一问到底在考什么？",
    "start": 2.96,
    "end": 5.2,
    "duration": 2.24
  },
  {
    "id": 3,
    "text": "本题考查郭沫若《女神》的艺术特色、",
    "start": 5.2,
    "end": 8.4,
    "duration": 3.2
  },
  {
    "id": 4,
    "text": "自我抒情主人公形象及其文学史地位。",
    "start": 8.4,
    "end": 11.76,
    "duration": 3.36
  },
  {
    "id": 5,
    "text": "考生必须紧扣钱理群《中国现代文学三十年》的权威体系，",
    "start": 11.76,
    "end": 16.8,
    "duration": 5.04
  },
  {
    "id": 6,
    "text": "透视其抒情主人公光谱、内在矛盾、",
    "start": 16.8,
    "end": 20.08,
    "duration": 3.28
  },
  {
    "id": 7,
    "text": "泛神论哲学、意象美学与自由诗体创新。",
    "start": 20.08,
    "end": 23.44,
    "duration": 3.36
  },
  {
    "id": 8,
    "text": "二、答题的总方向是什么？",
    "start": 23.76,
    "end": 26.24,
    "duration": 2.48
  },
  {
    "id": 9,
    "text": "答题必须立足“时代需要与诗人创作个性的统一”这一核心逻辑主线。",
    "start": 26.24,
    "end": 32.32,
    "duration": 6.08
  },
  {
    "id": 10,
    "text": "牢牢把握浪漫主义、个性解放、主体膨胀与形式自由的深度咬合，",
    "start": 32.32,
    "end": 37.92,
    "duration": 5.6
  },
  {
    "id": 11,
    "text": "绝不能平铺直叙罗列诗句。",
    "start": 37.92,
    "end": 40.4,
    "duration": 2.48
  },
  {
    "id": 12,
    "text": "三、分几个板块展开？",
    "start": 40.4,
    "end": 42.48,
    "duration": 2.08
  },
  {
    "id": 13,
    "text": "全篇按五大维度层层递进：-第一板块：自我抒情主人公四副面孔（大我、",
    "start": 42.48,
    "end": 48.658,
    "duration": 6.178
  },
  {
    "id": 14,
    "text": "新人、神我、世界人，小我与民族融合）。",
    "start": 48.658,
    "end": 51.835,
    "duration": 3.177
  },
  {
    "id": 15,
    "text": "第二板块：抒情主人公内在矛盾背面（天狗自爆、",
    "start": 51.835,
    "end": 56.147,
    "duration": 4.312
  },
  {
    "id": 16,
    "text": "湘累寂寞、五四时代心理立体反映）。",
    "start": 56.147,
    "end": 59.324,
    "duration": 3.177
  },
  {
    "id": 17,
    "text": "第三板块：泛神论哲学基础与泛我论机制（我即是神，",
    "start": 59.324,
    "end": 64.09,
    "duration": 4.766
  },
  {
    "id": 18,
    "text": "拆除人与自然隔阂，主体性膨胀）。",
    "start": 64.09,
    "end": 67.04,
    "duration": 2.95
  },
  {
    "id": 19,
    "text": "第四板块：意象系统革新（阔大、奇异、",
    "start": 67.12,
    "end": 70.8,
    "duration": 3.68
  },
  {
    "id": 20,
    "text": "飞动，力的绘画与舞蹈，太阳地球海洋）。",
    "start": 70.8,
    "end": 74.72,
    "duration": 3.92
  },
  {
    "id": 21,
    "text": "第五板块：自由诗体形式革命（情绪决定形式，",
    "start": 74.72,
    "end": 78.96,
    "duration": 4.24
  },
  {
    "id": 22,
    "text": "两型自由诗，天狗与炉中煤）。",
    "start": 78.96,
    "end": 81.44,
    "duration": 2.48
  },
  {
    "id": 23,
    "text": "四、全篇内在逻辑链条是什么？",
    "start": 81.44,
    "end": 84.4,
    "duration": 2.96
  },
  {
    "id": 24,
    "text": "由五四时代与浪漫精神交汇破题，趋近于剖析其时代核心造就的抒情主体形象（人），",
    "start": 84.4,
    "end": 91.36,
    "duration": 6.96
  },
  {
    "id": 25,
    "text": "趋近于揭示主体内心情感波澜与复杂矛盾（心），",
    "start": 91.36,
    "end": 95.68,
    "duration": 4.32
  },
  {
    "id": 26,
    "text": "趋近于溯源其打破人神界限的哲学基础（思），",
    "start": 95.68,
    "end": 99.92,
    "duration": 4.24
  },
  {
    "id": 27,
    "text": "趋近于展现其外化为宏伟画面的意象创造（象），",
    "start": 99.92,
    "end": 104.0,
    "duration": 4.08
  },
  {
    "id": 28,
    "text": "趋近于落实于承载一切情绪的自由诗歌形式革命（体）。",
    "start": 104.0,
    "end": 108.72,
    "duration": 4.72
  },
  {
    "id": 29,
    "text": "环环相扣，逻辑诊密。",
    "start": 109.12,
    "end": 111.2,
    "duration": 2.08
  },
  {
    "id": 30,
    "text": "--。二",
    "start": 111.2,
    "end": 111.36,
    "duration": 0.16
  },
  {
    "id": 31,
    "text": "、各板块逐句咬合推演。",
    "start": 111.68,
    "end": 113.84,
    "duration": 2.16
  },
  {
    "id": 32,
    "text": "（一）宏观定性与破题总起板块。",
    "start": 113.84,
    "end": 117.04,
    "duration": 3.2
  },
  {
    "id": 33,
    "text": "破题推演逻辑：开头必须高屋建瓴，",
    "start": 117.04,
    "end": 120.32,
    "duration": 3.28
  },
  {
    "id": 34,
    "text": "首先界定《女神》在现代新诗史上的奠基地位。",
    "start": 120.32,
    "end": 123.68,
    "duration": 3.36
  },
  {
    "id": 35,
    "text": "接着引入教材核心理论公式：时代需要与诗人个性的统一，",
    "start": 123.68,
    "end": 128.56,
    "duration": 4.88
  },
  {
    "id": 36,
    "text": "指明浪漫主义作为时代喷火口的作用。",
    "start": 128.56,
    "end": 131.28,
    "duration": 2.72
  },
  {
    "id": 37,
    "text": "最后概括其在抒情主体、哲学基石、",
    "start": 131.52,
    "end": 134.56,
    "duration": 3.04
  },
  {
    "id": 38,
    "text": "意象体系与形式创造上的综合成就，",
    "start": 134.56,
    "end": 137.6,
    "duration": 3.04
  },
  {
    "id": 39,
    "text": "引出分述。",
    "start": 137.6,
    "end": 138.8,
    "duration": 1.2
  },
  {
    "id": 40,
    "text": "逐句咬合推导：具体表述到答题语句就是：郭沫若的诗集《女神》是中国现代新诗史上具有划时代意义的奠基之作。，",
    "start": 138.8,
    "end": 148.52,
    "duration": 9.72
  },
  {
    "id": 41,
    "text": "这是对考察对象的历史定性。",
    "start": 148.52,
    "end": 151.03,
    "duration": 2.51
  },
  {
    "id": 42,
    "text": "紧接着指出其成功的根本原因，具体表述到答题语句就是：它的成功在于五四时代精神与诗人浪漫主义个性的高度统一。。",
    "start": 151.03,
    "end": 161.488,
    "duration": 10.458
  },
  {
    "id": 43,
    "text": "随后引用钱理群教材经典原话形象阐释，",
    "start": 161.648,
    "end": 165.648,
    "duration": 4.0
  },
  {
    "id": 44,
    "text": "具体表述到答题语句就是：个人与民族的深层郁结在浪漫主义这里找到了最充沛的喷火口。。",
    "start": 165.648,
    "end": 172.705,
    "duration": 7.057
  },
  {
    "id": 45,
    "text": "紧接着指出其喷发带来的文体破坏力，",
    "start": 172.705,
    "end": 175.711,
    "duration": 3.006
  },
  {
    "id": 46,
    "text": "具体表述到答题语句就是：郭沫若以火山爆发式的激情，",
    "start": 175.711,
    "end": 180.033,
    "duration": 4.322
  },
  {
    "id": 47,
    "text": "打破了传统诗歌的僵化樊篱。。",
    "start": 180.033,
    "end": 182.288,
    "duration": 2.255
  },
  {
    "id": 48,
    "text": "随后概括其人物塑造成就，具体表述到答题语句就是：它塑造了具有多重精神维度的自我抒情主人公。。",
    "start": 182.448,
    "end": 190.839,
    "duration": 8.391
  },
  {
    "id": 49,
    "text": "最后落到哲学、意象与形式的综合建构，",
    "start": 190.839,
    "end": 193.992,
    "duration": 3.153
  },
  {
    "id": 50,
    "text": "具体表述到答题语句就是：它以泛神论哲学为思想基石，",
    "start": 193.992,
    "end": 198.524,
    "duration": 4.532
  },
  {
    "id": 51,
    "text": "创造了阔大奇异的意象系统与绝端自由的现代诗体，",
    "start": 198.524,
    "end": 202.858,
    "duration": 4.334
  },
  {
    "id": 52,
    "text": "在文学史上树立了空前自由的审美丰碑。。",
    "start": 202.858,
    "end": 206.208,
    "duration": 3.35
  },
  {
    "id": 53,
    "text": "郭沫若的诗集《女神》是中国现代新诗史上具有划时代意义的奠基之作。",
    "start": 206.288,
    "end": 212.848,
    "duration": 6.56
  },
  {
    "id": 54,
    "text": "它的成功在于五四时代精神与诗人浪漫主义个性的高度统一。",
    "start": 212.848,
    "end": 218.208,
    "duration": 5.36
  },
  {
    "id": 55,
    "text": "个人与民族的深层郁结在浪漫主义这里找到了最充沛的喷火口。",
    "start": 218.208,
    "end": 223.808,
    "duration": 5.6
  },
  {
    "id": 56,
    "text": "郭沫若以火山爆发式的激情，打破了传统诗歌的僵化樊篱。",
    "start": 223.808,
    "end": 228.448,
    "duration": 4.64
  },
  {
    "id": 57,
    "text": "它塑造了具有多重精神维度的自我抒情主人公。",
    "start": 228.688,
    "end": 232.288,
    "duration": 3.6
  },
  {
    "id": 58,
    "text": "它以泛神论哲学为思想基石，创造了阔大奇异的意象系统与绝端自由的现代诗体，",
    "start": 232.288,
    "end": 239.088,
    "duration": 6.8
  },
  {
    "id": 59,
    "text": "在文学史上树立了空前自由的审美丰碑。",
    "start": 239.088,
    "end": 242.208,
    "duration": 3.12
  },
  {
    "id": 60,
    "text": "--。（二",
    "start": 242.208,
    "end": 242.42,
    "duration": 0.212
  },
  {
    "id": 61,
    "text": "）第一板块：自我抒情主人公的四副面孔。",
    "start": 242.42,
    "end": 245.808,
    "duration": 3.388
  },
  {
    "id": 62,
    "text": "-论证推演逻辑：讲透“自我抒情主人公”，",
    "start": 245.808,
    "end": 249.016,
    "duration": 3.208
  },
  {
    "id": 63,
    "text": "首先必须廓清误区：自我绝非小我发泄，",
    "start": 249.016,
    "end": 252.438,
    "duration": 3.422
  },
  {
    "id": 64,
    "text": "而是小我即大我。",
    "start": 252.438,
    "end": 253.935,
    "duration": 1.497
  },
  {
    "id": 65,
    "text": "接着必须完整、准确地列举出钱理群教材概括的四副面孔，",
    "start": 253.935,
    "end": 259.067,
    "duration": 5.132
  },
  {
    "id": 66,
    "text": "并逐一配以标志性名作的最小情节细节，",
    "start": 259.067,
    "end": 262.703,
    "duration": 3.636
  },
  {
    "id": 67,
    "text": "论证其在中国历史上第一次确立了人的尊严与价值。",
    "start": 262.703,
    "end": 267.408,
    "duration": 4.705
  },
  {
    "id": 68,
    "text": "-逐句咬合推导：具体表述到答题语句就是：首先，",
    "start": 267.408,
    "end": 271.232,
    "duration": 3.824
  },
  {
    "id": 69,
    "text": "在精神内涵上，《女神》成功塑造了体现五四时代觉醒的自我抒情主人公形象。，",
    "start": 271.232,
    "end": 277.47,
    "duration": 6.238
  },
  {
    "id": 70,
    "text": "这是第一分论点的核心观点立桩。",
    "start": 277.47,
    "end": 280.288,
    "duration": 2.818
  },
  {
    "id": 71,
    "text": "紧接着澄清小我与大我的辩证关系，",
    "start": 280.424,
    "end": 283.384,
    "duration": 2.96
  },
  {
    "id": 72,
    "text": "具体表述到答题语句就是：这一自我绝非孤立狭隘的个人发泄，",
    "start": 283.384,
    "end": 288.617,
    "duration": 5.233
  },
  {
    "id": 73,
    "text": "而是小我与民族大我的高度融合。。",
    "start": 288.617,
    "end": 291.511,
    "duration": 2.894
  },
  {
    "id": 74,
    "text": "随后指出其丰富光谱，具体表述到答题语句就是：抒情主人公呈现出立体丰富的光谱。。",
    "start": 291.511,
    "end": 298.744,
    "duration": 7.233
  },
  {
    "id": 75,
    "text": "紧接着剖析第一副面孔与代表作品，",
    "start": 298.824,
    "end": 301.465,
    "duration": 2.641
  },
  {
    "id": 76,
    "text": "具体表述到答题语句就是：其一是觉醒中华民族的“大我”，",
    "start": 301.465,
    "end": 306.533,
    "duration": 5.068
  },
  {
    "id": 77,
    "text": "《凤凰涅盘》中凤凰集香木自焚，在更生歌中象征着古老民族的涅盘重生。。",
    "start": 306.533,
    "end": 312.922,
    "duration": 6.389
  },
  {
    "id": 78,
    "text": "随后剖析第二副面孔与代表作品，具体表述到答题语句就是：其二是彻底破坏旧世界的“新人”，",
    "start": 312.922,
    "end": 321.295,
    "duration": 8.373
  },
  {
    "id": 79,
    "text": "《女神之再生》宣告新酿的酒浆不能盛在旧皮囊中，",
    "start": 321.295,
    "end": 325.701,
    "duration": 4.406
  },
  {
    "id": 80,
    "text": "呼唤新太阳的升起。。",
    "start": 325.701,
    "end": 327.464,
    "duration": 1.763
  },
  {
    "id": 81,
    "text": "紧接着剖析第三副面孔与代表作品，",
    "start": 327.544,
    "end": 330.264,
    "duration": 2.72
  },
  {
    "id": 82,
    "text": "具体表述到答题语句就是：其三是极度张扬个性价值的“神我”，",
    "start": 330.264,
    "end": 334.959,
    "duration": 4.695
  },
  {
    "id": 83,
    "text": "《天狗》以吞食宇宙的狂暴力量高呼“我便是我”，",
    "start": 334.959,
    "end": 338.384,
    "duration": 3.425
  },
  {
    "id": 84,
    "text": "在历史上第一次宣告了人的价值、尊严与创造力。。",
    "start": 338.384,
    "end": 342.188,
    "duration": 3.804
  },
  {
    "id": 85,
    "text": "最后剖析第四副面孔与代表作品，具体表述到答题语句就是：其四是开眼看世界的“世界人”，",
    "start": 342.188,
    "end": 349.227,
    "duration": 7.039
  },
  {
    "id": 86,
    "text": "《晨安》向全世界自然山川与人类文明致敬，",
    "start": 349.227,
    "end": 352.461,
    "duration": 3.234
  },
  {
    "id": 87,
    "text": "展现了前所未有的广阔胸怀。。",
    "start": 352.461,
    "end": 354.744,
    "duration": 2.283
  },
  {
    "id": 88,
    "text": "首先，在精神内涵上，《女神》成功塑造了体现五四时代觉醒的自我抒情主人公形象。",
    "start": 354.904,
    "end": 362.424,
    "duration": 7.52
  },
  {
    "id": 89,
    "text": "这一自我绝非孤立狭隘的个人发泄，",
    "start": 362.424,
    "end": 365.224,
    "duration": 2.8
  },
  {
    "id": 90,
    "text": "而是小我与民族大我的高度融合。",
    "start": 365.224,
    "end": 368.104,
    "duration": 2.88
  },
  {
    "id": 91,
    "text": "抒情主人公呈现出立体丰富的光谱。",
    "start": 368.104,
    "end": 371.144,
    "duration": 3.04
  },
  {
    "id": 92,
    "text": "其一是觉醒中华民族的“大我”，《凤凰涅盘》中凤凰集香木自焚，",
    "start": 371.144,
    "end": 376.104,
    "duration": 4.96
  },
  {
    "id": 93,
    "text": "在更生歌中象征着古老民族的涅盘重生。",
    "start": 376.104,
    "end": 379.464,
    "duration": 3.36
  },
  {
    "id": 94,
    "text": "其二是彻底破坏旧世界的“新人”，",
    "start": 379.784,
    "end": 382.664,
    "duration": 2.88
  },
  {
    "id": 95,
    "text": "《女神之再生》宣告新酿的酒浆不能盛在旧皮囊中，",
    "start": 382.664,
    "end": 387.064,
    "duration": 4.4
  },
  {
    "id": 96,
    "text": "呼唤新太阳的升起。",
    "start": 387.064,
    "end": 388.984,
    "duration": 1.92
  },
  {
    "id": 97,
    "text": "其三是极度张扬个性价值的“神我”，",
    "start": 388.984,
    "end": 392.024,
    "duration": 3.04
  },
  {
    "id": 98,
    "text": "《天狗》以吞食宇宙的狂暴力量高呼“我便是我”，",
    "start": 392.024,
    "end": 396.024,
    "duration": 4.0
  },
  {
    "id": 99,
    "text": "在历史上第一次宣告了人的价值、尊严与创造力。",
    "start": 396.024,
    "end": 399.624,
    "duration": 3.6
  },
  {
    "id": 100,
    "text": "其四是开眼看世界的“世界人”，《晨安》向全世界自然山川与人类文明致敬，",
    "start": 399.864,
    "end": 406.344,
    "duration": 6.48
  },
  {
    "id": 101,
    "text": "展现了前所未有的广阔胸怀。",
    "start": 406.344,
    "end": 409.064,
    "duration": 2.72
  },
  {
    "id": 102,
    "text": "--。（三",
    "start": 409.064,
    "end": 409.224,
    "duration": 0.16
  },
  {
    "id": 103,
    "text": "）第二板块：抒情主人公内在矛盾背面与时代心理。",
    "start": 409.384,
    "end": 413.704,
    "duration": 4.32
  },
  {
    "id": 104,
    "text": "论证推演逻辑：高分论述的关键在于避免将人物脸谱化。",
    "start": 413.704,
    "end": 418.72,
    "duration": 5.016
  },
  {
    "id": 105,
    "text": "必须指出《女神》不仅有狂飙高歌，",
    "start": 418.72,
    "end": 421.44,
    "duration": 2.72
  },
  {
    "id": 106,
    "text": "更有背面的“不和谐音”。",
    "start": 421.44,
    "end": 423.12,
    "duration": 1.68
  },
  {
    "id": 107,
    "text": "以《天狗》的自暴自毁、《湘累》的倦怠孤独为证据，",
    "start": 423.12,
    "end": 426.48,
    "duration": 3.36
  },
  {
    "id": 108,
    "text": "说明高唱自由创造背后深藏着自我消融的悲凉。",
    "start": 426.48,
    "end": 430.32,
    "duration": 3.84
  },
  {
    "id": 109,
    "text": "正是这种矛盾，使它成为五四时代心理的立体反映。",
    "start": 430.32,
    "end": 433.92,
    "duration": 3.6
  },
  {
    "id": 110,
    "text": "-逐句咬合推导：具体表述到答题语句就是：其次，",
    "start": 434.08,
    "end": 438.099,
    "duration": 4.019
  },
  {
    "id": 111,
    "text": "抒情主人公并非单向度的盲目狂热，",
    "start": 438.099,
    "end": 441.272,
    "duration": 3.173
  },
  {
    "id": 112,
    "text": "而是包含着深层矛盾的复杂精神立体。，",
    "start": 441.272,
    "end": 444.656,
    "duration": 3.384
  },
  {
    "id": 113,
    "text": "这是第二分论点的观点立桩。",
    "start": 444.656,
    "end": 447.195,
    "duration": 2.539
  },
  {
    "id": 114,
    "text": "紧接着揭示激昂背后的深层情绪，具体表述到答题语句就是：在激昂狂暴的赞歌背面，",
    "start": 447.195,
    "end": 454.598,
    "duration": 7.403
  },
  {
    "id": 115,
    "text": "深藏着抒情主人公的孤独、倦怠与自叙传式的忏悔。。",
    "start": 454.598,
    "end": 459.04,
    "duration": 4.442
  },
  {
    "id": 116,
    "text": "随后切入经典文本实证，具体表述到答题语句就是：《天狗》在自我极度膨胀中伴随着剥皮食肉的自我否定。。",
    "start": 459.2,
    "end": 468.063,
    "duration": 8.863
  },
  {
    "id": 117,
    "text": "紧接着补充诗剧文本细节，具体表述到答题语句就是：《湘累》展现了屈原在创造天地之后的深沉寂寞。。",
    "start": 468.063,
    "end": 476.506,
    "duration": 8.443
  },
  {
    "id": 118,
    "text": "随后指出热烈喷发之后的心理反拨，",
    "start": 476.506,
    "end": 479.594,
    "duration": 3.088
  },
  {
    "id": 119,
    "text": "具体表述到答题语句就是：《巨炮》流露出热烈喷发之后的虚脱与幻灭。。",
    "start": 479.594,
    "end": 485.36,
    "duration": 5.766
  },
  {
    "id": 120,
    "text": "进一步阐明美学深层的内在悖论，具体表述到答题语句就是：在哲学美学上，",
    "start": 485.44,
    "end": 491.294,
    "duration": 5.854
  },
  {
    "id": 121,
    "text": "高唱自由创造的同时又在《凤凰涅盘》中归结为天人合一的自我消融。。",
    "start": 491.294,
    "end": 496.546,
    "duration": 5.252
  },
  {
    "id": 122,
    "text": "最后总结这种多声部对五四时代心理的真实投射，",
    "start": 496.546,
    "end": 500.486,
    "duration": 3.94
  },
  {
    "id": 123,
    "text": "具体表述到答题语句就是：这种高亢与苦闷交织的多重声音，",
    "start": 500.486,
    "end": 505.175,
    "duration": 4.689
  },
  {
    "id": 124,
    "text": "真实深刻地反映了五四知识分子在启蒙浪潮中的复杂心理律动。。",
    "start": 505.175,
    "end": 510.24,
    "duration": 5.065
  },
  {
    "id": 125,
    "text": "其次，抒情主人公并非单向度的盲目狂热，",
    "start": 510.4,
    "end": 514.08,
    "duration": 3.68
  },
  {
    "id": 126,
    "text": "而是包含着深层矛盾的复杂精神立体。",
    "start": 514.08,
    "end": 517.12,
    "duration": 3.04
  },
  {
    "id": 127,
    "text": "在激昂狂暴的赞歌背面，深藏着抒情主人公的孤独、",
    "start": 517.12,
    "end": 521.52,
    "duration": 4.4
  },
  {
    "id": 128,
    "text": "倦怠与自叙传式的忏悔。",
    "start": 521.52,
    "end": 524.4,
    "duration": 2.88
  },
  {
    "id": 129,
    "text": "《天狗》在自我极度膨胀中伴随着剥皮食肉的自我否定。",
    "start": 524.4,
    "end": 528.8,
    "duration": 4.4
  },
  {
    "id": 130,
    "text": "《湘累》展现了屈原在创造天地之后的深沉寂寞。",
    "start": 528.8,
    "end": 532.16,
    "duration": 3.36
  },
  {
    "id": 131,
    "text": "《巨炮》流露出热烈喷发之后的虚脱与幻灭。",
    "start": 532.32,
    "end": 536.03,
    "duration": 3.71
  },
  {
    "id": 132,
    "text": "在哲学美学上，高唱自由创造的同时又在《凤凰涅盘》中归结为天人合一的自我消融。",
    "start": 536.03,
    "end": 543.451,
    "duration": 7.421
  },
  {
    "id": 133,
    "text": "这种高亢与苦闷交织的多重声音，真实深刻地反映了五四知识分子在启蒙浪潮中的复杂心理律动。",
    "start": 543.451,
    "end": 552.4,
    "duration": 8.949
  },
  {
    "id": 134,
    "text": "---。（四",
    "start": 552.4,
    "end": 552.65,
    "duration": 0.25
  },
  {
    "id": 135,
    "text": "）第三板块：泛神论哲学基石与“泛我论”机制。",
    "start": 552.65,
    "end": 556.9,
    "duration": 4.25
  },
  {
    "id": 136,
    "text": "论证推演逻辑：《女神》的艺术革命离不开其哲学内核。",
    "start": 556.9,
    "end": 561.518,
    "duration": 4.618
  },
  {
    "id": 137,
    "text": "必须准确解释斯宾诺莎泛神论的来源与郭沫若的改造，",
    "start": 561.518,
    "end": 566.214,
    "duration": 4.696
  },
  {
    "id": 138,
    "text": "“泛神便是无神，我即是神”。",
    "start": 566.214,
    "end": 568.256,
    "duration": 2.042
  },
  {
    "id": 139,
    "text": "朱栋霖称其为“泛我论”。",
    "start": 568.256,
    "end": 570.094,
    "duration": 1.838
  },
  {
    "id": 140,
    "text": "解释这种哲学如何打破人与自然界限，",
    "start": 570.094,
    "end": 573.36,
    "duration": 3.266
  },
  {
    "id": 141,
    "text": "使自然成为自我的附庸，从而建立起新诗的主体性维度。",
    "start": 573.36,
    "end": 578.056,
    "duration": 4.696
  },
  {
    "id": 142,
    "text": "-逐句咬合推导：具体表述到答题语句就是：第三，",
    "start": 578.056,
    "end": 581.919,
    "duration": 3.863
  },
  {
    "id": 143,
    "text": "在哲学基石上，郭沫若以泛神论思想确立了新诗强烈的主体性维度。，",
    "start": 581.919,
    "end": 587.613,
    "duration": 5.694
  },
  {
    "id": 144,
    "text": "这是第三分论点的提纲窃领。",
    "start": 587.613,
    "end": 590.053,
    "duration": 2.44
  },
  {
    "id": 145,
    "text": "紧接着交代哲学来源与核心命题，具体表述到答题语句就是：郭沫若吸纳了斯宾诺莎泛神论思想，",
    "start": 590.053,
    "end": 598.186,
    "duration": 8.133
  },
  {
    "id": 146,
    "text": "提出“一切自然都是神的表现，我即是神”的诗学命题。。",
    "start": 598.186,
    "end": 602.456,
    "duration": 4.27
  },
  {
    "id": 147,
    "text": "随后指出其向诗学机制的转化，具体表述到答题语句就是：这一观念在创作中转化为独特的“泛我论”机制。。",
    "start": 602.616,
    "end": 611.184,
    "duration": 8.568
  },
  {
    "id": 148,
    "text": "紧接着阐明其打破客体壁垒的艺术效果，",
    "start": 611.184,
    "end": 614.565,
    "duration": 3.381
  },
  {
    "id": 149,
    "text": "具体表述到答题语句就是：它彻底拆除了人与自然之间的隔阂。。",
    "start": 614.565,
    "end": 619.736,
    "duration": 5.171
  },
  {
    "id": 150,
    "text": "随后说明自然被完全主体化的现象，",
    "start": 619.896,
    "end": 622.616,
    "duration": 2.72
  },
  {
    "id": 151,
    "text": "具体表述到答题语句就是：自然界的山川、",
    "start": 622.616,
    "end": 626.002,
    "duration": 3.386
  },
  {
    "id": 152,
    "text": "雷电与风云全被赋予了作者的主体意志。。",
    "start": 626.002,
    "end": 629.429,
    "duration": 3.427
  },
  {
    "id": 153,
    "text": "紧接着指出自我的神圣化，具体表述到答题语句就是：赞美地球与宇宙，",
    "start": 629.429,
    "end": 635.275,
    "duration": 5.846
  },
  {
    "id": 154,
    "text": "就是赞美诗人自我的崇高力量。。",
    "start": 635.275,
    "end": 637.896,
    "duration": 2.621
  },
  {
    "id": 155,
    "text": "最后总结主体性确立对新诗的开创价值，",
    "start": 637.976,
    "end": 641.896,
    "duration": 3.92
  },
  {
    "id": 156,
    "text": "具体表述到答题语句就是：主体意识的急剧膨胀，",
    "start": 641.896,
    "end": 645.816,
    "duration": 3.92
  },
  {
    "id": 157,
    "text": "使自然万物成为诗人抒发个性激情的精神附庸，",
    "start": 645.816,
    "end": 649.656,
    "duration": 3.84
  },
  {
    "id": 158,
    "text": "为中国新诗注入了浩瀚的主观抒情力量。。",
    "start": 649.656,
    "end": 653.016,
    "duration": 3.36
  },
  {
    "id": 159,
    "text": "第三，在哲学基石上，郭沫若以泛神论思想确立了新诗强烈的主体性维度。",
    "start": 653.176,
    "end": 659.576,
    "duration": 6.4
  },
  {
    "id": 160,
    "text": "郭沫若吸纳了斯宾诺莎泛神论思想，",
    "start": 659.896,
    "end": 662.936,
    "duration": 3.04
  },
  {
    "id": 161,
    "text": "提出“一切自然都是神的表现，我即是神”的诗学命题。",
    "start": 662.936,
    "end": 667.176,
    "duration": 4.24
  },
  {
    "id": 162,
    "text": "这一观念在创作中转化为独特的“泛我论”机制。",
    "start": 667.176,
    "end": 670.776,
    "duration": 3.6
  },
  {
    "id": 163,
    "text": "它彻底拆除了人与自然之间的隔阂。",
    "start": 670.776,
    "end": 673.416,
    "duration": 2.64
  },
  {
    "id": 164,
    "text": "自然界的山川、雷电与风云全被赋予了作者的主体意志。",
    "start": 673.416,
    "end": 677.496,
    "duration": 4.08
  },
  {
    "id": 165,
    "text": "赞美地球与宇宙，就是赞美诗人自我的崇高力量。",
    "start": 677.736,
    "end": 681.656,
    "duration": 3.92
  },
  {
    "id": 166,
    "text": "主体意识的急剧膨胀，使自然万物成为诗人抒发个性激情的精神附庸，",
    "start": 681.656,
    "end": 687.016,
    "duration": 5.36
  },
  {
    "id": 167,
    "text": "为中国新诗注入了浩瀚的主观抒情力量。",
    "start": 687.016,
    "end": 690.776,
    "duration": 3.76
  },
  {
    "id": 168,
    "text": "--。（五",
    "start": 690.776,
    "end": 691.016,
    "duration": 0.24
  },
  {
    "id": 169,
    "text": "）第四板块：阔大奇异飞动的意象系统。",
    "start": 691.416,
    "end": 695.016,
    "duration": 3.6
  },
  {
    "id": 170,
    "text": "论证推演逻辑：思想需要意象作为物质载体。",
    "start": 695.016,
    "end": 698.744,
    "duration": 3.728
  },
  {
    "id": 171,
    "text": "必须点出郭沫若对古典诗歌纤细阴柔之风的反拨，",
    "start": 698.744,
    "end": 703.224,
    "duration": 4.48
  },
  {
    "id": 172,
    "text": "确立地球、海洋、太阳三大中心意象。",
    "start": 703.224,
    "end": 706.984,
    "duration": 3.76
  },
  {
    "id": 173,
    "text": "接着用钱理群归纳的三大美学特征，",
    "start": 706.984,
    "end": 709.864,
    "duration": 2.88
  },
  {
    "id": 174,
    "text": "阔大、奇异与飞动进行展开，引入《立在地球边上放号》的力的呼告，",
    "start": 709.864,
    "end": 715.864,
    "duration": 6.0
  },
  {
    "id": 175,
    "text": "分析其浪漫主义壮美风格。",
    "start": 715.864,
    "end": 717.864,
    "duration": 2.0
  },
  {
    "id": 176,
    "text": "-逐句咬合推导：具体表述到答题语句就是：第四，",
    "start": 718.104,
    "end": 722.094,
    "duration": 3.99
  },
  {
    "id": 177,
    "text": "在诗歌意象上，《女神》创造了阔大、",
    "start": 722.094,
    "end": 724.824,
    "duration": 2.73
  },
  {
    "id": 178,
    "text": "奇异与飞动的崭新意象系统。，",
    "start": 724.824,
    "end": 727.344,
    "duration": 2.52
  },
  {
    "id": 179,
    "text": "这是第四分论点的核心观点。",
    "start": 727.344,
    "end": 729.864,
    "duration": 2.52
  },
  {
    "id": 180,
    "text": "紧接着说明其对传统古典诗风的扫荡，",
    "start": 729.864,
    "end": 733.224,
    "duration": 3.36
  },
  {
    "id": 181,
    "text": "具体表述到答题语句就是：郭沫若扫除了中国传统古典诗歌的纤细阴柔之美。。",
    "start": 733.224,
    "end": 739.944,
    "duration": 6.72
  },
  {
    "id": 182,
    "text": "随后列出三大核心宇宙意象，具体表述到答题语句就是：他把包容一切的地球、",
    "start": 740.104,
    "end": 746.705,
    "duration": 6.601
  },
  {
    "id": 183,
    "text": "胸涌浩瀚的海洋与光芒万丈的太阳确立为核心意象。。",
    "start": 746.705,
    "end": 751.476,
    "duration": 4.771
  },
  {
    "id": 184,
    "text": "紧接着分析奇异性特征，具体表述到答题语句就是：他的意象具有彻底人化的奇异性，",
    "start": 751.476,
    "end": 759.068,
    "duration": 7.592
  },
  {
    "id": 185,
    "text": "地球的雷霆被写成其呼吸的声威。。",
    "start": 759.068,
    "end": 762.104,
    "duration": 3.036
  },
  {
    "id": 186,
    "text": "随后分析飞动性特征，具体表述到答题语句就是：他的意象更具有狂飙突进的飞动性。。",
    "start": 762.264,
    "end": 769.288,
    "duration": 7.024
  },
  {
    "id": 187,
    "text": "紧接着切入经典篇目实证，具体表述到答题语句就是：《立在地球边上放号》以排山倒海的呼告，",
    "start": 769.288,
    "end": 776.925,
    "duration": 7.637
  },
  {
    "id": 188,
    "text": "赞颂不断毁坏与创造的力的绘画与力的舞蹈。。",
    "start": 776.925,
    "end": 780.744,
    "duration": 3.819
  },
  {
    "id": 189,
    "text": "最后总结意象的美学象征意蕴，具体表述到答题语句就是：阔大飞动的壮美意象，",
    "start": 780.904,
    "end": 787.864,
    "duration": 6.96
  },
  {
    "id": 190,
    "text": "全面体现了摧毁旧世界的破坏力与创造新世纪的创造力。。",
    "start": 787.864,
    "end": 792.584,
    "duration": 4.72
  },
  {
    "id": 191,
    "text": "第四，在诗歌意象上，《女神》创造了阔大、",
    "start": 792.584,
    "end": 796.264,
    "duration": 3.68
  },
  {
    "id": 192,
    "text": "奇异与飞动的崭新意象系统。",
    "start": 796.264,
    "end": 799.064,
    "duration": 2.8
  },
  {
    "id": 193,
    "text": "郭沫若扫除了中国传统古典诗歌的纤细阴柔之美。",
    "start": 799.064,
    "end": 802.904,
    "duration": 3.84
  },
  {
    "id": 194,
    "text": "他把包容一切的地球、胸涌浩瀚的海洋与光芒万丈的太阳确立为核心意象。",
    "start": 803.224,
    "end": 809.704,
    "duration": 6.48
  },
  {
    "id": 195,
    "text": "他的意象具有彻底人化的奇异性，地球的雷霆被写成其呼吸的声威。",
    "start": 809.704,
    "end": 815.624,
    "duration": 5.92
  },
  {
    "id": 196,
    "text": "他的意象更具有狂飙突进的飞动性。",
    "start": 815.624,
    "end": 818.744,
    "duration": 3.12
  },
  {
    "id": 197,
    "text": "《立在地球边上放号》以排山倒海的呼告，",
    "start": 818.744,
    "end": 822.184,
    "duration": 3.44
  },
  {
    "id": 198,
    "text": "赞颂不断毁坏与创造的力的绘画与力的舞蹈。",
    "start": 822.184,
    "end": 826.184,
    "duration": 4.0
  },
  {
    "id": 199,
    "text": "阔大飞动的壮美意象，全面体现了摧毁旧世界的破坏力与创造新世纪的创造力。",
    "start": 826.424,
    "end": 833.144,
    "duration": 6.72
  },
  {
    "id": 200,
    "text": "--。（六",
    "start": 833.144,
    "end": 833.304,
    "duration": 0.16
  },
  {
    "id": 201,
    "text": "）第五板块：形式体制的解放与现代自由诗体范式。",
    "start": 833.544,
    "end": 837.624,
    "duration": 4.08
  },
  {
    "id": 202,
    "text": "论证推演逻辑：最后落到诗歌的体式与声音。",
    "start": 837.624,
    "end": 841.752,
    "duration": 4.128
  },
  {
    "id": 203,
    "text": "阐明郭沫若“形式绝端自由”的理论主张与“诗的本职专在抒情”。",
    "start": 841.752,
    "end": 846.952,
    "duration": 5.2
  },
  {
    "id": 204,
    "text": "分析自由诗的两大形态：一是长短不齐的狂暴喷发长句，",
    "start": 846.952,
    "end": 852.072,
    "duration": 5.12
  },
  {
    "id": 205,
    "text": "二是不规则押韵与排比复沓带来的内在旋律（《天狗》与《炉中煤》），",
    "start": 852.072,
    "end": 857.672,
    "duration": 5.6
  },
  {
    "id": 206,
    "text": "指出其在新诗形式建设上的奠基意义。",
    "start": 857.672,
    "end": 860.952,
    "duration": 3.28
  },
  {
    "id": 207,
    "text": "-逐句咬合推导：具体表述到答题语句就是：最后，",
    "start": 860.952,
    "end": 864.712,
    "duration": 3.76
  },
  {
    "id": 208,
    "text": "在形式体制上，《女神》创造了“绝端自由”的现代自由诗体范式。，",
    "start": 864.712,
    "end": 869.461,
    "duration": 4.749
  },
  {
    "id": 209,
    "text": "这是第五分论点的核心观点立桩。",
    "start": 869.461,
    "end": 872.232,
    "duration": 2.771
  },
  {
    "id": 210,
    "text": "紧接着说明其打破旧形式的主张，具体表述到答题语句就是：郭沫若坚决反对旧诗的形式镣靠，",
    "start": 872.232,
    "end": 879.95,
    "duration": 7.718
  },
  {
    "id": 211,
    "text": "主张情绪决定形式，提出诗的本职专在抒情。。",
    "start": 879.95,
    "end": 883.512,
    "duration": 3.562
  },
  {
    "id": 212,
    "text": "随后说明其创造的形态谱系，具体表述到答题语句就是：他在创作中主要开创了两种形态。。",
    "start": 883.672,
    "end": 890.901,
    "duration": 7.229
  },
  {
    "id": 213,
    "text": "紧接着剖析第一种喷泻式长句形态，",
    "start": 890.901,
    "end": 893.77,
    "duration": 2.869
  },
  {
    "id": 214,
    "text": "具体表述到答题语句就是：一种是如同火山喷涌般一泻无余的狂暴长句，",
    "start": 893.77,
    "end": 899.506,
    "duration": 5.736
  },
  {
    "id": 215,
    "text": "长短错落，随感情节奏自由舒卷。。",
    "start": 899.506,
    "end": 901.992,
    "duration": 2.486
  },
  {
    "id": 216,
    "text": "随后剖析第二种内在旋律和谐形态，",
    "start": 902.152,
    "end": 905.032,
    "duration": 2.88
  },
  {
    "id": 217,
    "text": "具体表述到答题语句就是：另一种是巧妙运用复沓、",
    "start": 905.032,
    "end": 909.459,
    "duration": 4.427
  },
  {
    "id": 218,
    "text": "排比与不规则押韵。。",
    "start": 909.459,
    "end": 911.178,
    "duration": 1.719
  },
  {
    "id": 219,
    "text": "紧接着切入实证篇目，具体表述到答题语句就是：《天狗》与《炉中煤》在自由变动中取得了内在旋律的和谐统一。。",
    "start": 911.178,
    "end": 920.632,
    "duration": 9.454
  },
  {
    "id": 220,
    "text": "最后总结自由诗体对中国新诗文体建设的巨大贡献，",
    "start": 920.712,
    "end": 925.112,
    "duration": 4.4
  },
  {
    "id": 221,
    "text": "具体表述到答题语句就是：这种形式的彻底解放，",
    "start": 925.112,
    "end": 929.032,
    "duration": 3.92
  },
  {
    "id": 222,
    "text": "为中国现代新诗的文体建设开辟了无限广阔的表现空间。。",
    "start": 929.032,
    "end": 933.752,
    "duration": 4.72
  },
  {
    "id": 223,
    "text": "最后，在形式体制上，《女神》创造了“绝端自由”的现代自由诗体范式。",
    "start": 933.752,
    "end": 939.352,
    "duration": 5.6
  },
  {
    "id": 224,
    "text": "郭沫若坚决反对旧诗的形式镣靠，主张情绪决定形式，",
    "start": 939.592,
    "end": 945.112,
    "duration": 5.52
  },
  {
    "id": 225,
    "text": "提出诗的本职专在抒情。",
    "start": 945.112,
    "end": 947.672,
    "duration": 2.56
  },
  {
    "id": 226,
    "text": "他在创作中主要开创了两种形态。",
    "start": 947.672,
    "end": 950.632,
    "duration": 2.96
  },
  {
    "id": 227,
    "text": "一种是如同火山喷涌般一泻无余的狂暴长句，",
    "start": 950.632,
    "end": 955.112,
    "duration": 4.48
  },
  {
    "id": 228,
    "text": "长短错落，随感情节奏自由舒卷。",
    "start": 955.112,
    "end": 958.472,
    "duration": 3.36
  },
  {
    "id": 229,
    "text": "另一种是巧妙运用复沓、排比与不规则押韵。",
    "start": 958.472,
    "end": 962.312,
    "duration": 3.84
  },
  {
    "id": 230,
    "text": "《天狗》与《炉中煤》在自由变动中取得了内在旋律的和谐统一。",
    "start": 962.472,
    "end": 967.299,
    "duration": 4.827
  },
  {
    "id": 231,
    "text": "这种形式的彻底解放，为中国现代新诗的文体建设开辟了无限广阔的表现空间。",
    "start": 967.299,
    "end": 973.937,
    "duration": 6.638
  },
  {
    "id": 232,
    "text": "--。（七",
    "start": 973.937,
    "end": 974.138,
    "duration": 0.201
  },
  {
    "id": 233,
    "text": "）总结升华板块。",
    "start": 974.138,
    "end": 975.345,
    "duration": 1.207
  },
  {
    "id": 234,
    "text": "收口推演逻辑：统领全篇论述，重申《女神》在时代精神、",
    "start": 975.345,
    "end": 980.448,
    "duration": 5.103
  },
  {
    "id": 235,
    "text": "哲学深度与形式革命三个维度的伟大飞跃，",
    "start": 980.448,
    "end": 983.728,
    "duration": 3.28
  },
  {
    "id": 236,
    "text": "给出中国现代浪漫主义新诗至高丰碑的文学史定论。",
    "start": 983.728,
    "end": 988.368,
    "duration": 4.64
  },
  {
    "id": 237,
    "text": "逐句咬合推导：具体表述到答题语句就是：综上所述，",
    "start": 988.368,
    "end": 993.088,
    "duration": 4.72
  },
  {
    "id": 238,
    "text": "郭沫若的《女神》实现了时代精神、",
    "start": 993.088,
    "end": 995.648,
    "duration": 2.56
  },
  {
    "id": 239,
    "text": "哲学深度与形式革命的美学统一。。",
    "start": 995.648,
    "end": 998.288,
    "duration": 2.64
  },
  {
    "id": 240,
    "text": "最后收束在文学史的最高赞誉上，具体表述到答题语句就是：它以空前的个性解放解放了诗歌的形式与心灵，",
    "start": 998.528,
    "end": 1008.048,
    "duration": 9.52
  },
  {
    "id": 241,
    "text": "确立了中国现代浪漫主义新诗的崇高美学范式。。",
    "start": 1008.048,
    "end": 1012.128,
    "duration": 4.08
  },
  {
    "id": 242,
    "text": "综上所述，郭沫若的《女神》实现了时代精神、",
    "start": 1012.128,
    "end": 1015.728,
    "duration": 3.6
  },
  {
    "id": 243,
    "text": "哲学深度与形式革命的美学统一。",
    "start": 1015.728,
    "end": 1018.448,
    "duration": 2.72
  },
  {
    "id": 244,
    "text": "它以空前的个性解放解放了诗歌的形式与心灵，",
    "start": 1018.768,
    "end": 1022.368,
    "duration": 3.6
  },
  {
    "id": 245,
    "text": "确立了中国现代浪漫主义新诗的崇高美学范式。",
    "start": 1022.368,
    "end": 1025.728,
    "duration": 3.36
  }
]