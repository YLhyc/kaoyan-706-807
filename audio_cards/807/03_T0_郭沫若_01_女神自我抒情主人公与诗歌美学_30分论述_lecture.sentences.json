[
  {
    "id": 1,
    "text": "试论郭沫若《女神》的自我抒情主人公形象与诗歌美学特色。",
    "start": 0.16,
    "end": 4.893,
    "duration": 4.733
  },
  {
    "id": 2,
    "text": "五四新文化运动高潮时期，郭沫若诗集《女神》的问世，是中国现代新诗史上的奠基之作。",
    "start": 5.311,
    "end": 12.161,
    "duration": 6.85
  },
  {
    "id": 3,
    "text": "它的成功在于五四时代精神与诗人浪漫主义个性的统一，",
    "start": 12.689,
    "end": 17.024,
    "duration": 4.335
  },
  {
    "id": 4,
    "text": "正所谓“个人的郁结，民族的郁结，在浪漫主义这里找到了喷火口”。",
    "start": 17.436,
    "end": 22.639,
    "duration": 5.203
  },
  {
    "id": 5,
    "text": "郭沫若以火山爆发般的激情打破古典旧诗的格律桎梏，以泛神论哲学为基石，",
    "start": 22.834,
    "end": 29.401,
    "duration": 6.567
  },
  {
    "id": 6,
    "text": "塑造了多重维度的自我抒情主人公，开创了阔大奇异的意象体系与自由新诗体式，",
    "start": 29.525,
    "end": 36.273,
    "duration": 6.748
  },
  {
    "id": 7,
    "text": "确立了现代浪漫主义新诗的崇高美学范式。",
    "start": 36.377,
    "end": 39.666,
    "duration": 3.289
  },
  {
    "id": 8,
    "text": "其思想意蕴与艺术成就主要体现在以下四个方面：",
    "start": 39.956,
    "end": 43.832,
    "duration": 3.876
  },
  {
    "id": 9,
    "text": "第一，塑造觉醒时代的多维抒情主人公，达成“小我”与民族“大我”的崇高融合。",
    "start": 44.497,
    "end": 51.511,
    "duration": 7.014
  },
  {
    "id": 10,
    "text": "《女神》中的自我是被五四时代激活的现代主体形象。",
    "start": 51.949,
    "end": 55.769,
    "duration": 3.82
  },
  {
    "id": 11,
    "text": "其抒情主人公呈现出丰富的精神光谱：",
    "start": 56.28,
    "end": 59.219,
    "duration": 2.939
  },
  {
    "id": 12,
    "text": "一是在《凤凰涅槃》中集香木自焚并于死灰中更生、象征古老中华民族浴火重生的“大我”；",
    "start": 59.674,
    "end": 67.087,
    "duration": 7.413
  },
  {
    "id": 13,
    "text": "二是在《女神之再生》中，借共工、颛顼争帝触折不周山后，",
    "start": 67.291,
    "end": 71.896,
    "duration": 4.605
  },
  {
    "id": 14,
    "text": "女神们拒绝修补破败旧天、高唱“我们要去创造一个新鲜的太阳”的情节，",
    "start": 72.044,
    "end": 77.545,
    "duration": 5.501
  },
  {
    "id": 15,
    "text": "塑造出誓破旧世界、另造新天地的“新人”；",
    "start": 77.68,
    "end": 80.996,
    "duration": 3.316
  },
  {
    "id": 16,
    "text": "三是在《天狗》中以吞食日月的能量高呼“我便是我”、首次宣告个体神性与自主意志的“神我”；",
    "start": 81.294,
    "end": 88.715,
    "duration": 7.421
  },
  {
    "id": 17,
    "text": "四是在《晨安》中向自然山川与世界人类文明致敬的“世界人”。",
    "start": 89.267,
    "end": 94.116,
    "duration": 4.849
  },
  {
    "id": 18,
    "text": "这些形象交织共振，具象化了五四时期生命力破土而出的时代狂飙。",
    "start": 94.381,
    "end": 100.029,
    "duration": 5.648
  },
  {
    "id": 19,
    "text": "第二，揭示高亢狂飙背后的矛盾与沉郁，立体呈现五四知识分子的精神搏斗。",
    "start": 100.642,
    "end": 106.609,
    "duration": 5.967
  },
  {
    "id": 20,
    "text": "成熟的浪漫主义从不流于单一狂热宣泄，",
    "start": 106.982,
    "end": 110.051,
    "duration": 3.069
  },
  {
    "id": 21,
    "text": "《女神》的抒情主人公蕴含着深沉的内在张力与悲凉底色。",
    "start": 110.482,
    "end": 114.609,
    "duration": 4.127
  },
  {
    "id": 22,
    "text": "在火山喷发般的豪迈赞歌背面，深藏着现代个体在旧体制废墟上的孤独、眷恋与忏悔。",
    "start": 115.031,
    "end": 122.237,
    "duration": 7.206
  },
  {
    "id": 23,
    "text": "在《天狗》中，自我的急剧膨胀伴随着剥皮食肉的自我凌迟；",
    "start": 122.487,
    "end": 126.961,
    "duration": 4.474
  },
  {
    "id": 24,
    "text": "在《湘累》中，屈原在天马行空的创造之后陷入不可言说的寥寂；",
    "start": 127.334,
    "end": 132.461,
    "duration": 5.127
  },
  {
    "id": 25,
    "text": "《凤凰涅槃》在追求主体烈度爆发的同时，最终归结于“一切的一，和谐”的泛神论自我消融。",
    "start": 132.893,
    "end": 140.508,
    "duration": 7.615
  },
  {
    "id": 26,
    "text": "高亢与苦闷、狂暴与孤寂的交织，真实度量了五四知识分子在启蒙裂变中的复杂心灵脉动。",
    "start": 140.801,
    "end": 148.169,
    "duration": 7.368
  },
  {
    "id": 27,
    "text": "第三，引入泛神论哲学，确立物我交融、狂飙飞动的主体性意象体系。",
    "start": 148.865,
    "end": 154.836,
    "duration": 5.971
  },
  {
    "id": 28,
    "text": "郭沫若借鉴斯宾诺莎等西方泛神论思想，",
    "start": 155.147,
    "end": 158.171,
    "duration": 3.024
  },
  {
    "id": 29,
    "text": "提出“一切自然只是神的表现，我即是神”的诗学命题，",
    "start": 158.486,
    "end": 162.807,
    "duration": 4.321
  },
  {
    "id": 30,
    "text": "并在创作中转化为独特的“泛我论”美学机制。",
    "start": 163.111,
    "end": 166.487,
    "duration": 3.376
  },
  {
    "id": 31,
    "text": "他打破人与自然对立的传统界限，将主体意志灌注于宇宙万物，",
    "start": 166.908,
    "end": 171.705,
    "duration": 4.797
  },
  {
    "id": 32,
    "text": "使山川、雷电与海洋均成为奔涌情感的外化。",
    "start": 171.981,
    "end": 176.003,
    "duration": 4.022
  },
  {
    "id": 33,
    "text": "作品扫除中国古典传统中常见的纤细、阴柔与感伤意象，",
    "start": 176.195,
    "end": 180.893,
    "duration": 4.698
  },
  {
    "id": 34,
    "text": "在《立在地球边上放号》中以排山倒海的呼告，将地球、海洋与太阳推向极境，",
    "start": 181.045,
    "end": 187.461,
    "duration": 6.416
  },
  {
    "id": 35,
    "text": "赞颂不断毁坏又不断创造的“力的绘画”与“力的舞蹈”，",
    "start": 187.576,
    "end": 191.859,
    "duration": 4.283
  },
  {
    "id": 36,
    "text": "构筑起阔大、奇异与飞动的现代壮美意象群。",
    "start": 192.155,
    "end": 196.326,
    "duration": 4.171
  },
  {
    "id": 37,
    "text": "第四，打破传统声律镣铐，确立“情绪决定形式”的现代自由诗范式。",
    "start": 196.922,
    "end": 203.403,
    "duration": 6.481
  },
  {
    "id": 38,
    "text": "郭沫若反对古典旧诗与早期尝试派新诗的形式规约，",
    "start": 203.671,
    "end": 208.033,
    "duration": 4.362
  },
  {
    "id": 39,
    "text": "主张“诗的本职专在抒情”，强调外在节律必须服从内在情感的自然流淌。",
    "start": 208.395,
    "end": 215.113,
    "duration": 6.718
  },
  {
    "id": 40,
    "text": "他在创作中开创了两类典范形式：一类如《天狗》，",
    "start": 215.806,
    "end": 219.803,
    "duration": 3.997
  },
  {
    "id": 41,
    "text": "以一泻千里、长短错落的句式随情绪波澜自由舒卷，创造了富有火山爆发力的自由体；",
    "start": 220.048,
    "end": 227.915,
    "duration": 7.867
  },
  {
    "id": 42,
    "text": "另一类如《炉中煤》，巧妙运用重叠、排比与自然音韵的复沓，",
    "start": 228.443,
    "end": 234.082,
    "duration": 5.639
  },
  {
    "id": 43,
    "text": "赋予深沉眷念以和谐回环的内在声律。",
    "start": 234.082,
    "end": 237.617,
    "duration": 3.535
  },
  {
    "id": 44,
    "text": "这种大胆破格的文体解放，为中国现代新诗拓辟了广阔的表现空间。",
    "start": 237.801,
    "end": 243.274,
    "duration": 5.473
  },
  {
    "id": 45,
    "text": "要而言之，郭沫若的《女神》以时代喷火口之势，达成了民族精神、哲学开掘与诗体革命的高度统一。",
    "start": 243.953,
    "end": 252.333,
    "duration": 8.38
  },
  {
    "id": 46,
    "text": "它开创了中国现代浪漫主义新诗的崭新篇章，为中国新诗在现代觉醒中奠定了坚实的精神基石。",
    "start": 252.558,
    "end": 259.956,
    "duration": 7.398
  }
]