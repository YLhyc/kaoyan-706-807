[
  {
    "id": 1,
    "text": "一、宏观结构推演与采分点映射。",
    "start": 0.16,
    "end": 3.36,
    "duration": 3.2
  },
  {
    "id": 2,
    "text": "本题标准分为二十分，简答题结构采用高分“总领定性，",
    "start": 3.36,
    "end": 8.24,
    "duration": 4.88
  },
  {
    "id": 3,
    "text": "三点机制递进展开，收束总结”逻辑模型：一、",
    "start": 8.24,
    "end": 12.64,
    "duration": 4.4
  },
  {
    "id": 4,
    "text": "总领定性（约五十字）：作品坐标（一九八四年寻根开山作）、",
    "start": 12.64,
    "end": 17.44,
    "duration": 4.8
  },
  {
    "id": 5,
    "text": "人物定性（平民智者、棋呆子、传统文化人格化身）。",
    "start": 17.44,
    "end": 21.76,
    "duration": 4.32
  },
  {
    "id": 6,
    "text": "二、第一点：世俗维度（对“吃”的执着）：采分点为对粮食的敬畏、",
    "start": 22.16,
    "end": 27.981,
    "duration": 5.821
  },
  {
    "id": 7,
    "text": "极低物欲、生命底线的敬畏与物质自足。",
    "start": 27.981,
    "end": 31.803,
    "duration": 3.822
  },
  {
    "id": 8,
    "text": "三、第二点：超越维度（对“棋”的入道）：采分点为道家阴阳虚静、",
    "start": 31.803,
    "end": 37.297,
    "duration": 5.494
  },
  {
    "id": 9,
    "text": "“为棋不为生”、九人盲棋对决、物我两忘。",
    "start": 37.297,
    "end": 40.88,
    "duration": 3.583
  },
  {
    "id": 10,
    "text": "四、第三点：文化寻根维度（生命安顿）：采分点为儒道互补、",
    "start": 41.04,
    "end": 46.24,
    "duration": 5.2
  },
  {
    "id": 11,
    "text": "抵御动荡异化、安身立命的民间精神定力。",
    "start": 46.24,
    "end": 49.52,
    "duration": 3.28
  },
  {
    "id": 12,
    "text": "五、收束总结（约五十字）：烟火与道家哲学的化合、",
    "start": 49.52,
    "end": 54.16,
    "duration": 4.64
  },
  {
    "id": 13,
    "text": "超越浅层反思的文化自觉。。",
    "start": 54.16,
    "end": 56.4,
    "duration": 2.24
  },
  {
    "id": 14,
    "text": "二、逐段内部咬合与考场得分句推导。",
    "start": 56.4,
    "end": 59.6,
    "duration": 3.2
  },
  {
    "id": 15,
    "text": "总领段：明确作家作品与人物定位。",
    "start": 59.92,
    "end": 62.96,
    "duration": 3.04
  },
  {
    "id": 16,
    "text": "论证推演逻辑：直接交代阿城《棋王》在寻根文学中的奠基地位，",
    "start": 62.96,
    "end": 68.32,
    "duration": 5.36
  },
  {
    "id": 17,
    "text": "指出王一生是具有传统哲学内涵的平民典型，",
    "start": 68.32,
    "end": 71.92,
    "duration": 3.6
  },
  {
    "id": 18,
    "text": "引出具体分析。",
    "start": 71.92,
    "end": 73.6,
    "duration": 1.68
  },
  {
    "id": 19,
    "text": "具体表述到答题语句就是：阿城发表于一九八四年的《棋王》，",
    "start": 73.6,
    "end": 78.48,
    "duration": 4.88
  },
  {
    "id": 20,
    "text": "是寻根文学的开山名作。",
    "start": 78.48,
    "end": 80.32,
    "duration": 1.84
  },
  {
    "id": 21,
    "text": "小说塑造的“棋呆子”王一生，是中国当代文学中极具中国传统文化底蕴的平民智者形象。",
    "start": 80.56,
    "end": 88.277,
    "duration": 7.717
  },
  {
    "id": 22,
    "text": "其形象特质与寻根追求主要体现在三个层面。",
    "start": 88.277,
    "end": 92.419,
    "duration": 4.142
  },
  {
    "id": 23,
    "text": "阿城发表于一九八四年的《棋王》，",
    "start": 92.419,
    "end": 95.253,
    "duration": 2.834
  },
  {
    "id": 24,
    "text": "是寻根文学的开山名作。",
    "start": 95.253,
    "end": 97.433,
    "duration": 2.18
  },
  {
    "id": 25,
    "text": "小说塑造的“棋呆子”王一生，是中国当代文学中极具中国传统文化底蕴的平民智者形象。",
    "start": 97.433,
    "end": 105.28,
    "duration": 7.847
  },
  {
    "id": 26,
    "text": "其形象特质与寻根追求主要体现在三个层面。",
    "start": 105.44,
    "end": 109.6,
    "duration": 4.16
  },
  {
    "id": 27,
    "text": "--。要",
    "start": 109.6,
    "end": 109.76,
    "duration": 0.16
  },
  {
    "id": 28,
    "text": "点一：对世俗“吃”的敬畏（生存基石）。",
    "start": 109.76,
    "end": 113.6,
    "duration": 3.84
  },
  {
    "id": 29,
    "text": "论证推演逻辑：必须紧扣小说最具特色的“吃”。",
    "start": 113.6,
    "end": 117.84,
    "duration": 4.24
  },
  {
    "id": 30,
    "text": "王一生吃米粒连桌缝都不放过，这种描写绝不是小气，",
    "start": 117.84,
    "end": 123.04,
    "duration": 5.2
  },
  {
    "id": 31,
    "text": "而是对生命最本质生存权利的敬畏，",
    "start": 123.04,
    "end": 126.24,
    "duration": 3.2
  },
  {
    "id": 32,
    "text": "是其不为外物所役的起点。",
    "start": 126.24,
    "end": 128.64,
    "duration": 2.4
  },
  {
    "id": 33,
    "text": "具体表述到答题语句就是：第一，极度专注世俗生存与物质自足。",
    "start": 128.64,
    "end": 134.768,
    "duration": 6.128
  },
  {
    "id": 34,
    "text": "王一生对“吃”抱有一种虔诚而专注的态度。",
    "start": 134.768,
    "end": 138.528,
    "duration": 3.76
  },
  {
    "id": 35,
    "text": "无论生活多么贫寒困顿，他对待每一粒米、",
    "start": 138.528,
    "end": 141.888,
    "duration": 3.36
  },
  {
    "id": 36,
    "text": "每一滴油都充满了近乎宗教般的敬畏。",
    "start": 141.888,
    "end": 145.328,
    "duration": 3.44
  },
  {
    "id": 37,
    "text": "这种对基本生存物质的执着，并非市快贪婪。",
    "start": 145.328,
    "end": 149.088,
    "duration": 3.76
  },
  {
    "id": 38,
    "text": "它体现了中国传统底层百姓对生命存在最本真的热爱与珍惜。",
    "start": 149.088,
    "end": 154.128,
    "duration": 5.04
  },
  {
    "id": 39,
    "text": "物质上的极低物欲与容易知足，为他的精神自足提供了坚实基础。",
    "start": 154.368,
    "end": 159.728,
    "duration": 5.36
  },
  {
    "id": 40,
    "text": "第一，极度专注世俗生存与物质自足。",
    "start": 159.728,
    "end": 162.848,
    "duration": 3.12
  },
  {
    "id": 41,
    "text": "王一生对“吃”抱有一种虔诚而专注的态度。",
    "start": 162.848,
    "end": 166.368,
    "duration": 3.52
  },
  {
    "id": 42,
    "text": "无论生活多么贫寒困顿，他对待每一粒米、",
    "start": 166.368,
    "end": 169.408,
    "duration": 3.04
  },
  {
    "id": 43,
    "text": "每一滴油都充满了近乎宗教般的敬畏。",
    "start": 169.408,
    "end": 172.128,
    "duration": 2.72
  },
  {
    "id": 44,
    "text": "这种对基本生存物质的执着，并非市快贪婪。",
    "start": 172.448,
    "end": 176.208,
    "duration": 3.76
  },
  {
    "id": 45,
    "text": "它体现了中国传统底层百姓对生命存在最本真的热爱与珍惜。",
    "start": 176.208,
    "end": 181.488,
    "duration": 5.28
  },
  {
    "id": 46,
    "text": "物质上的极低物欲与容易知足，为他的精神自足提供了坚实基础。",
    "start": 181.488,
    "end": 187.568,
    "duration": 6.08
  },
  {
    "id": 47,
    "text": "--。要",
    "start": 187.568,
    "end": 187.728,
    "duration": 0.16
  },
  {
    "id": 48,
    "text": "点二：棋道通禅的虚静超脱（精神超越）。",
    "start": 187.728,
    "end": 190.768,
    "duration": 3.04
  },
  {
    "id": 49,
    "text": "-论证推演逻辑：进入精神超越层面。",
    "start": 190.768,
    "end": 193.594,
    "duration": 2.826
  },
  {
    "id": 50,
    "text": "王一生的象棋是道家庄禅哲学的具体载体。",
    "start": 193.594,
    "end": 197.228,
    "duration": 3.634
  },
  {
    "id": 51,
    "text": "结合道家老者的棋谱点拨、“为棋不为生”的操守，",
    "start": 197.228,
    "end": 201.063,
    "duration": 3.835
  },
  {
    "id": 52,
    "text": "以及九人盲棋对决的静穆高潮，论证以静制动的精神升华。",
    "start": 201.063,
    "end": 205.908,
    "duration": 4.845
  },
  {
    "id": 53,
    "text": "具体表述到答题语句就是：第二，棋道通禅的虚静境界与精神超脱。",
    "start": 205.908,
    "end": 212.128,
    "duration": 6.22
  },
  {
    "id": 54,
    "text": "王一生将象棋升华为安身立命的超越空间。",
    "start": 212.128,
    "end": 215.888,
    "duration": 3.76
  },
  {
    "id": 55,
    "text": "他从检破烂的老人处习得道家棋理。",
    "start": 215.888,
    "end": 218.768,
    "duration": 2.88
  },
  {
    "id": 56,
    "text": "他遵循“为棋不为生”与“阴阳相济”的哲学智慧。",
    "start": 218.768,
    "end": 222.928,
    "duration": 4.16
  },
  {
    "id": 57,
    "text": "面对知青动荡乱世的政治喧嚣与物质匮乏，",
    "start": 222.928,
    "end": 226.448,
    "duration": 3.52
  },
  {
    "id": 58,
    "text": "他完全退回内在的棋艺世界。",
    "start": 226.448,
    "end": 228.448,
    "duration": 2.0
  },
  {
    "id": 59,
    "text": "在车轮大战盲棋对决九人的高潮中，",
    "start": 228.848,
    "end": 231.968,
    "duration": 3.12
  },
  {
    "id": 60,
    "text": "他静穆如铁，神游物外。",
    "start": 231.968,
    "end": 234.208,
    "duration": 2.24
  },
  {
    "id": 61,
    "text": "他展现出物我两忘、以静制动的崇高精神境界。",
    "start": 234.208,
    "end": 238.768,
    "duration": 4.56
  },
  {
    "id": 62,
    "text": "第二，棋道通禅的虚静境界与精神超脱。",
    "start": 238.768,
    "end": 242.688,
    "duration": 3.92
  },
  {
    "id": 63,
    "text": "王一生将象棋升华为安身立命的超越空间。",
    "start": 242.688,
    "end": 246.928,
    "duration": 4.24
  },
  {
    "id": 64,
    "text": "他从检破烂的老人处习得道家棋理。",
    "start": 246.928,
    "end": 250.048,
    "duration": 3.12
  },
  {
    "id": 65,
    "text": "他遵循“为棋不为生”与“阴阳相济”的哲学智慧。",
    "start": 250.208,
    "end": 254.688,
    "duration": 4.48
  },
  {
    "id": 66,
    "text": "面对知青动荡乱世的政治喧嚣与物质匮乏，",
    "start": 254.688,
    "end": 258.448,
    "duration": 3.76
  },
  {
    "id": 67,
    "text": "他完全退回内在的棋艺世界。",
    "start": 258.448,
    "end": 261.328,
    "duration": 2.88
  },
  {
    "id": 68,
    "text": "在车轮大战盲棋对决九人的高潮中，",
    "start": 261.328,
    "end": 264.288,
    "duration": 2.96
  },
  {
    "id": 69,
    "text": "他静穆如铁，神游物外。",
    "start": 264.288,
    "end": 266.528,
    "duration": 2.24
  },
  {
    "id": 70,
    "text": "他展现出物我两忘、以静制动的崇高精神境界。",
    "start": 266.528,
    "end": 270.768,
    "duration": 4.24
  },
  {
    "id": 71,
    "text": "---。要",
    "start": 270.928,
    "end": 271.181,
    "duration": 0.253
  },
  {
    "id": 72,
    "text": "点三：儒道互补与文化寻根追求（哲学落脚点）。",
    "start": 271.181,
    "end": 275.731,
    "duration": 4.55
  },
  {
    "id": 73,
    "text": "论证推演逻辑：升华到文化寻根的主题。",
    "start": 275.731,
    "end": 279.616,
    "duration": 3.885
  },
  {
    "id": 74,
    "text": "王一生展示了一种不同于西方现代主义荒诞焦虑的中国传统生命态度。",
    "start": 279.616,
    "end": 285.376,
    "duration": 5.76
  },
  {
    "id": 75,
    "text": "用道家的超然和民间的朴素安身立命，",
    "start": 285.376,
    "end": 289.056,
    "duration": 3.68
  },
  {
    "id": 76,
    "text": "证明了传统文明的韧性。",
    "start": 289.056,
    "end": 291.296,
    "duration": 2.24
  },
  {
    "id": 77,
    "text": "具体表述到答题语句就是：第三，在传统儒道互补中安顿个体生命。",
    "start": 291.296,
    "end": 297.456,
    "duration": 6.16
  },
  {
    "id": 78,
    "text": "王一生身上体现了阿城对中华传统文明生命智慧的深情寻根。",
    "start": 297.536,
    "end": 302.896,
    "duration": 5.36
  },
  {
    "id": 79,
    "text": "面对狂暴的时代动乱，王一生既没有激进反抗，",
    "start": 302.896,
    "end": 306.896,
    "duration": 4.0
  },
  {
    "id": 80,
    "text": "也没有绝望沉沦。",
    "start": 306.896,
    "end": 308.496,
    "duration": 1.6
  },
  {
    "id": 81,
    "text": "他借助道家的虚静无为抵御精神异化，",
    "start": 308.496,
    "end": 311.616,
    "duration": 3.12
  },
  {
    "id": 82,
    "text": "又依托民间的朴素人伦保持生命温情。",
    "start": 311.616,
    "end": 315.136,
    "duration": 3.52
  },
  {
    "id": 83,
    "text": "作家借助王一生证明，中国古老的文化传统依然蕴藏着能够让现代人安身立命的巨大精神定力。",
    "start": 315.136,
    "end": 322.496,
    "duration": 7.36
  },
  {
    "id": 84,
    "text": "第三，在传统儒道互补中安顿个体生命。",
    "start": 322.736,
    "end": 326.016,
    "duration": 3.28
  },
  {
    "id": 85,
    "text": "王一生身上体现了阿城对中华传统文明生命智慧的深情寻根。",
    "start": 326.016,
    "end": 331.056,
    "duration": 5.04
  },
  {
    "id": 86,
    "text": "面对狂暴的时代动乱，王一生既没有激进反抗，",
    "start": 331.056,
    "end": 334.576,
    "duration": 3.52
  },
  {
    "id": 87,
    "text": "也没有绝望沉沦。",
    "start": 334.576,
    "end": 335.936,
    "duration": 1.36
  },
  {
    "id": 88,
    "text": "他借助道家的虚静无为抵御精神异化，",
    "start": 335.936,
    "end": 339.056,
    "duration": 3.12
  },
  {
    "id": 89,
    "text": "又依托民间的朴素人伦保持生命温情。",
    "start": 339.056,
    "end": 342.176,
    "duration": 3.12
  },
  {
    "id": 90,
    "text": "作家借助王一生证明，中国古老的文化传统依然蕴藏着能够让现代人安身立命的巨大精神定力。",
    "start": 342.496,
    "end": 350.336,
    "duration": 7.84
  },
  {
    "id": 91,
    "text": "--。总",
    "start": 350.336,
    "end": 350.576,
    "duration": 0.24
  },
  {
    "id": 92,
    "text": "结升华段：艺术与思想概括。",
    "start": 350.576,
    "end": 353.136,
    "duration": 2.56
  },
  {
    "id": 93,
    "text": "论证推演逻辑：最后用一句话概括阿城以烟火与道家相合超越政治苦难叙事的文学成就。",
    "start": 353.136,
    "end": 360.656,
    "duration": 7.52
  },
  {
    "id": 94,
    "text": "-具体表述到答题语句就是：阿城通过王一生将凡俗烟火与古典道家精神熔于一炉，",
    "start": 360.816,
    "end": 368.38,
    "duration": 7.564
  },
  {
    "id": 95,
    "text": "完成了从政治苦难反思向东方生命哲学寻根的成功超越。",
    "start": 368.38,
    "end": 373.72,
    "duration": 5.34
  },
  {
    "id": 96,
    "text": "阿城通过王一生将凡俗烟火与古典道家精神熔于一炉，",
    "start": 373.72,
    "end": 378.837,
    "duration": 5.117
  },
  {
    "id": 97,
    "text": "完成了从政治苦难反思向东方生命哲学寻根的成功超越。",
    "start": 378.837,
    "end": 384.176,
    "duration": 5.339
  }
]