[
  {
    "id": 1,
    "text": "四十年代后期，西南联大出身的穆旦、郑敏、杜运燮、",
    "start": 0.103,
    "end": 4.491,
    "duration": 4.388
  },
  {
    "id": 2,
    "text": "袁可嘉与上海的辛笛、杭约赫、陈敬容、唐祈、",
    "start": 5.116,
    "end": 9.304,
    "duration": 4.188
  },
  {
    "id": 3,
    "text": "唐湜等诗人合流，",
    "start": 9.651,
    "end": 11.085,
    "duration": 1.434
  },
  {
    "id": 4,
    "text": "组成“九叶诗派”（当时称“中国新诗派”）。",
    "start": 11.335,
    "end": 14.409,
    "duration": 3.074
  },
  {
    "id": 5,
    "text": "该诗派在现代诗歌史演进的关键节点上，",
    "start": 14.636,
    "end": 17.709,
    "duration": 3.073
  },
  {
    "id": 6,
    "text": "将现实主义历史感与现代主义艺术形式融为一体，",
    "start": 18.106,
    "end": 21.944,
    "duration": 3.838
  },
  {
    "id": 7,
    "text": "其追求现实感与现代性契合的“综合诗学”主要体现在以下三个层面：",
    "start": 22.195,
    "end": 27.594,
    "duration": 5.399
  },
  {
    "id": 8,
    "text": "第一，融汇民族苦难体验与历史意识，坚守严肃的现实介入品格。",
    "start": 28.245,
    "end": 33.566,
    "duration": 5.321
  },
  {
    "id": 9,
    "text": "八十年代初该群体九位诗人的合集《九叶集》出版，",
    "start": 33.795,
    "end": 37.394,
    "duration": 3.599
  },
  {
    "id": 10,
    "text": "“九叶诗派”由此得名。",
    "start": 37.541,
    "end": 38.995,
    "duration": 1.454
  },
  {
    "id": 11,
    "text": "早在战争年代，他们便拒绝逃避现实的唯美倾向。",
    "start": 39.211,
    "end": 42.726,
    "duration": 3.515
  },
  {
    "id": 12,
    "text": "穆旦在《赞美》中直面北方原野上满脸皱纹、",
    "start": 42.941,
    "end": 46.045,
    "duration": 3.104
  },
  {
    "id": 13,
    "text": "背负历史重担的农夫，以沉痛深切的赤子情怀，",
    "start": 46.332,
    "end": 50.186,
    "duration": 3.854
  },
  {
    "id": 14,
    "text": "歌颂古老民族在废墟硝烟中忍辱负重、顽强抗争的生命力量，",
    "start": 50.529,
    "end": 55.779,
    "duration": 5.25
  },
  {
    "id": 15,
    "text": "赋予新诗庄严的历史悲剧感。",
    "start": 56.163,
    "end": 58.224,
    "duration": 2.061
  },
  {
    "id": 16,
    "text": "第二，借鉴西方现代主义诗艺，确立具张力的“智性诗学”。",
    "start": 58.858,
    "end": 63.899,
    "duration": 5.041
  },
  {
    "id": 17,
    "text": "诗派深受艾略特、奥登与里尔克等西方现代诗人启发，",
    "start": 64.595,
    "end": 68.969,
    "duration": 4.374
  },
  {
    "id": 18,
    "text": "主张感性体验与理性思辨的结合。",
    "start": 69.493,
    "end": 72.22,
    "duration": 2.727
  },
  {
    "id": 19,
    "text": "杜运燮在《秋》中打破传统悲秋成式，",
    "start": 73.043,
    "end": 76.084,
    "duration": 3.041
  },
  {
    "id": 20,
    "text": "以机智反讽消解滥觞感伤；",
    "start": 76.532,
    "end": 78.921,
    "duration": 2.389
  },
  {
    "id": 21,
    "text": "郑敏以沉静细腻的哲学冥想审视生命本真；",
    "start": 79.49,
    "end": 83.281,
    "duration": 3.791
  },
  {
    "id": 22,
    "text": "穆旦在《森林之魅》与《诗八首》中剖析现代个体灵魂深处的撕裂与精神困境，",
    "start": 83.575,
    "end": 89.638,
    "duration": 6.063
  },
  {
    "id": 23,
    "text": "开创了现代汉语诗歌潜入潜意识与哲理沉思的新路。",
    "start": 90.142,
    "end": 94.69,
    "duration": 4.548
  },
  {
    "id": 24,
    "text": "第三，克服二元对立倾向，探索“新诗现代化”的综合文体之路。",
    "start": 95.327,
    "end": 100.461,
    "duration": 5.134
  },
  {
    "id": 25,
    "text": "他们在理论上自觉反对将现实主义与现代主义割裂的偏向，",
    "start": 100.954,
    "end": 105.598,
    "duration": 4.644
  },
  {
    "id": 26,
    "text": "既警惕诗歌沦为政治口号的附庸，又排斥脱离生活的形式游戏；",
    "start": 106.065,
    "end": 111.356,
    "duration": 5.291
  },
  {
    "id": 27,
    "text": "通过多维意象叠加、象征跳跃与戏剧化独白，",
    "start": 112.027,
    "end": 115.613,
    "duration": 3.586
  },
  {
    "id": 28,
    "text": "锤炼出兼顾内在骨力与表现张力的现代诗语，",
    "start": 115.874,
    "end": 119.944,
    "duration": 4.07
  },
  {
    "id": 29,
    "text": "奠定了现代新诗成熟期的美学标杆。",
    "start": 120.214,
    "end": 123.013,
    "duration": 2.799
  }
]