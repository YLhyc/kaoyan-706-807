[
  {
    "id": 1,
    "text": "四十年代后期，西南联大出身的穆旦、郑敏、杜运燮、袁可嘉与上海的辛笛、杭约赫、陈敬容、唐祈、唐湜等诗人合流，",
    "start": 0.134,
    "end": 9.786,
    "duration": 9.652
  },
  {
    "id": 2,
    "text": "组成“九叶诗派”（当时称“中国新诗派”）。",
    "start": 10.41,
    "end": 13.102,
    "duration": 2.692
  },
  {
    "id": 3,
    "text": "该诗派在现代诗歌史演进的关键节点上，将现实主义历史感与现代主义艺术形式融为一体，",
    "start": 13.78,
    "end": 16.872,
    "duration": 3.092
  },
  {
    "id": 4,
    "text": "其追求现实感与现代性契合的“综合诗学”主要体现在以下三个层面：",
    "start": 17.251,
    "end": 20.943,
    "duration": 3.692
  },
  {
    "id": 5,
    "text": "第一，融汇民族苦难体验与历史意识，坚守严肃的现实介入品格。",
    "start": 21.621,
    "end": 32.113,
    "duration": 10.492
  },
  {
    "id": 6,
    "text": "八十年代初该群体九位诗人的合集《九叶集》出版，“九叶诗派”由此得名。",
    "start": 32.831,
    "end": 38.323,
    "duration": 5.492
  },
  {
    "id": 7,
    "text": "早在战争年代，他们便拒绝逃避现实的唯美倾向。",
    "start": 39.001,
    "end": 42.733,
    "duration": 3.732
  },
  {
    "id": 8,
    "text": "穆旦在《赞美》中直面北方原野上背负历史重担的农夫，又于《森林之魅》写滇缅丛林征战悲歌，",
    "start": 43.411,
    "end": 53.143,
    "duration": 9.732
  },
  {
    "id": 9,
    "text": "以沉痛深切的赤子情怀，歌颂古老民族在废墟硝烟中忍辱负重、顽强抗争的生命力量，赋予新诗庄严的历史悲剧感。",
    "start": 53.696,
    "end": 60.868,
    "duration": 7.172
  },
  {
    "id": 10,
    "text": "第二，借鉴西方现代主义诗艺，确立具张力的“智性诗学”。",
    "start": 61.561,
    "end": 65.533,
    "duration": 3.972
  },
  {
    "id": 11,
    "text": "诗派深受艾略特、奥登与里尔克等西方现代诗人启发，主张感性体验与理性思辨的结合。",
    "start": 66.251,
    "end": 73.423,
    "duration": 7.172
  },
  {
    "id": 12,
    "text": "杜运燮在《秋》中打破传统悲秋成式，以机智反讽消解滥觞感伤；",
    "start": 74.141,
    "end": 76.713,
    "duration": 2.572
  },
  {
    "id": 13,
    "text": "郑敏以沉静细腻的哲学冥想审视生命本真；",
    "start": 77.242,
    "end": 79.494,
    "duration": 2.252
  },
  {
    "id": 14,
    "text": "穆旦在《诗八首》中剖析现代个体灵魂深处的撕裂与精神困境，",
    "start": 80.172,
    "end": 82.064,
    "duration": 1.892
  },
  {
    "id": 15,
    "text": "开创了现代汉语诗歌潜入潜意识与哲理沉思的新路。",
    "start": 82.443,
    "end": 83.735,
    "duration": 1.292
  },
  {
    "id": 16,
    "text": "第三，克服二元对立倾向，探索“新诗现代化”的综合文体之路。",
    "start": 84.573,
    "end": 93.225,
    "duration": 8.652
  },
  {
    "id": 17,
    "text": "他们在理论上自觉反对将现实主义与现代主义割裂的偏向，",
    "start": 93.863,
    "end": 102.835,
    "duration": 8.972
  },
  {
    "id": 18,
    "text": "既警惕诗歌沦为政治口号的附庸，又排斥脱离生活的形式游戏；",
    "start": 103.346,
    "end": 105.758,
    "duration": 2.412
  },
  {
    "id": 19,
    "text": "通过多维意象叠加、象征跳跃与戏剧化独白，",
    "start": 106.287,
    "end": 112.379,
    "duration": 6.092
  },
  {
    "id": 20,
    "text": "锤炼出兼顾内在骨力与表现张力的现代诗语，奠定了现代新诗成熟期的美学标杆。",
    "start": 113.008,
    "end": 119.18,
    "duration": 6.172
  }
]