[
  {
    "id": 1,
    "text": "四十年代后期，以穆旦、郑敏、杜运燮、",
    "start": 0.05,
    "end": 2.753,
    "duration": 2.703
  },
  {
    "id": 2,
    "text": "辛笛等西南联大诗人群为骨干的“九叶诗派”（中国新诗派），",
    "start": 2.753,
    "end": 7.356,
    "duration": 4.603
  },
  {
    "id": 3,
    "text": "在中国现代诗歌史演进的关键节点上，",
    "start": 7.356,
    "end": 11.814,
    "duration": 4.458
  },
  {
    "id": 4,
    "text": "完成了现实主义历史感悟与现代主义艺术形式的深刻交融。",
    "start": 11.814,
    "end": 16.521,
    "duration": 4.707
  },
  {
    "id": 5,
    "text": "其追求现实感与现代性双向契合的“综合诗学”，",
    "start": 16.521,
    "end": 20.282,
    "duration": 3.761
  },
  {
    "id": 6,
    "text": "主要体现在以下三个层面：",
    "start": 20.282,
    "end": 22.889,
    "duration": 2.607
  },
  {
    "id": 7,
    "text": "第一，融汇民族血肉苦难与深邃历史意识，",
    "start": 22.889,
    "end": 26.128,
    "duration": 3.239
  },
  {
    "id": 8,
    "text": "坚守严肃的现实介入品格。",
    "start": 26.128,
    "end": 28.646,
    "duration": 2.518
  },
  {
    "id": 9,
    "text": "九十年代该群体诗选结集命名为“九叶”，而早在战争年代，",
    "start": 28.646,
    "end": 33.889,
    "duration": 5.243
  },
  {
    "id": 10,
    "text": "他们便断然拒绝逃避现实的唯美主义隐遁。",
    "start": 33.889,
    "end": 37.367,
    "duration": 3.478
  },
  {
    "id": 11,
    "text": "穆旦在《赞美》中走出书斋，直面中国北方原野上满脸皱纹、",
    "start": 37.367,
    "end": 42.359,
    "duration": 4.992
  },
  {
    "id": 12,
    "text": "背负着沉重历史重轭的贫苦农夫，以撕心裂肺的赤子之痛，",
    "start": 42.359,
    "end": 47.108,
    "duration": 4.749
  },
  {
    "id": 13,
    "text": "深情歌颂古老民族在废墟硝烟中忍辱负重、",
    "start": 47.108,
    "end": 50.943,
    "duration": 3.835
  },
  {
    "id": 14,
    "text": "顽强搏击的崇高生命力，赋予新诗以宏大庄严的历史悲剧感。",
    "start": 50.943,
    "end": 56.102,
    "duration": 5.159
  },
  {
    "id": 15,
    "text": "第二，借鉴西方现代主义玄学派与象征派，",
    "start": 56.102,
    "end": 60.287,
    "duration": 4.185
  },
  {
    "id": 16,
    "text": "确立具深度张力的“智性诗学”。",
    "start": 60.287,
    "end": 63.153,
    "duration": 2.866
  },
  {
    "id": 17,
    "text": "诗派深受艾略特、奥登与里尔克现代诗歌理论启发，",
    "start": 63.153,
    "end": 67.451,
    "duration": 4.298
  },
  {
    "id": 18,
    "text": "主张感性体验与理性反思的高度化合。",
    "start": 67.451,
    "end": 70.917,
    "duration": 3.466
  },
  {
    "id": 19,
    "text": "杜运燮在《秋》中打破传统悲秋成式，",
    "start": 70.917,
    "end": 74.163,
    "duration": 3.246
  },
  {
    "id": 20,
    "text": "以充满现代反讽的机智语言解构感伤；",
    "start": 74.163,
    "end": 77.303,
    "duration": 3.14
  },
  {
    "id": 21,
    "text": "郑敏以女性特有的哲学冥想审视生命本真；",
    "start": 77.303,
    "end": 81.276,
    "duration": 3.973
  },
  {
    "id": 22,
    "text": "穆旦更在《森林之魅》与《诗八首》中解剖现代个体灵魂深处的撕裂、",
    "start": 81.276,
    "end": 86.429,
    "duration": 5.153
  },
  {
    "id": 23,
    "text": "情欲压抑与精神荒诞，",
    "start": 86.429,
    "end": 88.478,
    "duration": 2.049
  },
  {
    "id": 24,
    "text": "开创了现代汉语诗歌深潜潜意识与形而上沉思的现代范式。",
    "start": 88.478,
    "end": 93.908,
    "duration": 5.43
  },
  {
    "id": 25,
    "text": "第三，打破二元对立的庸俗思维，",
    "start": 93.908,
    "end": 96.421,
    "duration": 2.513
  },
  {
    "id": 26,
    "text": "开创“新诗现代化”的综合文体新路。",
    "start": 96.421,
    "end": 99.401,
    "duration": 2.98
  },
  {
    "id": 27,
    "text": "他们在理论上自觉反对将现实主义与现代主义割裂开来的偏颇倾向，",
    "start": 99.401,
    "end": 105.235,
    "duration": 5.834
  },
  {
    "id": 28,
    "text": "既警惕将诗歌沦为狂热政治口号的传声筒，",
    "start": 105.235,
    "end": 108.87,
    "duration": 3.635
  },
  {
    "id": 29,
    "text": "又排斥纯形式主义的辞藻游戏；通过多维意象叠加、",
    "start": 108.87,
    "end": 113.626,
    "duration": 4.756
  },
  {
    "id": 30,
    "text": "象征跳跃与戏剧性独白，",
    "start": 113.626,
    "end": 116.019,
    "duration": 2.393
  },
  {
    "id": 31,
    "text": "他们锤炼出一种充满内在骨力与张力的现代诗歌语言，",
    "start": 116.019,
    "end": 120.48,
    "duration": 4.461
  },
  {
    "id": 32,
    "text": "确立了中国现代诗歌成熟期的美学标杆。",
    "start": 120.48,
    "end": 123.576,
    "duration": 3.096
  }
]