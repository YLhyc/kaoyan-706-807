[
  {
    "id": 1,
    "text": "四十年代后期，以穆旦、郑敏、杜运燮、",
    "start": 0.16,
    "end": 4.16,
    "duration": 4.0
  },
  {
    "id": 2,
    "text": "辛笛等西南联大诗人群为骨干的“九叶诗派”（中国新诗派），",
    "start": 4.16,
    "end": 10.0,
    "duration": 5.84
  },
  {
    "id": 3,
    "text": "在中国现代诗歌史演进的关键节点上，",
    "start": 10.0,
    "end": 13.12,
    "duration": 3.12
  },
  {
    "id": 4,
    "text": "完成了现实主义历史感悟与现代主义艺术形式的深刻交融。",
    "start": 13.12,
    "end": 18.24,
    "duration": 5.12
  },
  {
    "id": 5,
    "text": "其追求现实感与现代性双向契合的“综合诗学”，",
    "start": 18.24,
    "end": 22.48,
    "duration": 4.24
  },
  {
    "id": 6,
    "text": "主要体现在以下三个层面：",
    "start": 22.8,
    "end": 25.28,
    "duration": 2.48
  },
  {
    "id": 7,
    "text": "第一，融汇民族血肉苦难与深邃历史意识，",
    "start": 25.28,
    "end": 29.68,
    "duration": 4.4
  },
  {
    "id": 8,
    "text": "坚守严肃的现实介入品格。",
    "start": 29.68,
    "end": 32.56,
    "duration": 2.88
  },
  {
    "id": 9,
    "text": "九十年代该群体诗选结集命名为“九叶”，而早在战争年代，",
    "start": 32.56,
    "end": 37.28,
    "duration": 4.72
  },
  {
    "id": 10,
    "text": "他们便断然拒绝逃避现实的唯美主义隐遁。",
    "start": 37.28,
    "end": 40.96,
    "duration": 3.68
  },
  {
    "id": 11,
    "text": "穆旦在《赞美》中走出书斋，直面中国北方原野上满脸皱纹、",
    "start": 40.96,
    "end": 46.48,
    "duration": 5.52
  },
  {
    "id": 12,
    "text": "背负着沉重历史重轭的贫苦农夫，以撕心裂肺的赤子之痛，",
    "start": 46.48,
    "end": 52.08,
    "duration": 5.6
  },
  {
    "id": 13,
    "text": "深情歌颂古老民族在废墟硝烟中忍辱负重、",
    "start": 52.08,
    "end": 55.84,
    "duration": 3.76
  },
  {
    "id": 14,
    "text": "顽强搏击的崇高生命力，赋予新诗以宏大庄严的历史悲剧感。",
    "start": 56.08,
    "end": 62.16,
    "duration": 6.08
  },
  {
    "id": 15,
    "text": "第二，借鉴西方现代主义玄学派与象征派，",
    "start": 62.16,
    "end": 66.4,
    "duration": 4.24
  },
  {
    "id": 16,
    "text": "确立具深度张力的“智性诗学”。",
    "start": 66.4,
    "end": 69.52,
    "duration": 3.12
  },
  {
    "id": 17,
    "text": "诗派深受艾略特、奥登与里尔克现代诗歌理论启发，",
    "start": 69.52,
    "end": 74.8,
    "duration": 5.28
  },
  {
    "id": 18,
    "text": "主张感性体验与理性反思的高度化合。",
    "start": 74.8,
    "end": 78.32,
    "duration": 3.52
  },
  {
    "id": 19,
    "text": "杜运燮在《秋》中打破传统悲秋成式，",
    "start": 78.32,
    "end": 81.6,
    "duration": 3.28
  },
  {
    "id": 20,
    "text": "以充满现代反讽的机智语言解构感伤；",
    "start": 81.6,
    "end": 85.04,
    "duration": 3.44
  },
  {
    "id": 21,
    "text": "郑敏以女性特有的哲学冥想审视生命本真；",
    "start": 85.04,
    "end": 88.96,
    "duration": 3.92
  },
  {
    "id": 22,
    "text": "穆旦更在《森林之魅》与《诗八首》中解剖现代个体灵魂深处的撕裂、",
    "start": 88.96,
    "end": 95.52,
    "duration": 6.56
  },
  {
    "id": 23,
    "text": "情欲压抑与精神荒诞，",
    "start": 95.52,
    "end": 97.52,
    "duration": 2.0
  },
  {
    "id": 24,
    "text": "开创了现代汉语诗歌深潜潜意识与形而上沉思的现代范式。",
    "start": 97.52,
    "end": 102.96,
    "duration": 5.44
  },
  {
    "id": 25,
    "text": "第三，打破二元对立的庸俗思维，",
    "start": 102.96,
    "end": 106.0,
    "duration": 3.04
  },
  {
    "id": 26,
    "text": "开创“新诗现代化”的综合文体新路。",
    "start": 106.0,
    "end": 109.68,
    "duration": 3.68
  },
  {
    "id": 27,
    "text": "他们在理论上自觉反对将现实主义与现代主义割裂开来的偏颇倾向，",
    "start": 109.68,
    "end": 116.24,
    "duration": 6.56
  },
  {
    "id": 28,
    "text": "既警惕将诗歌沦为狂热政治口号的传声筒，",
    "start": 116.24,
    "end": 119.76,
    "duration": 3.52
  },
  {
    "id": 29,
    "text": "又排斥纯形式主义的辞藻游戏；通过多维意象叠加、",
    "start": 119.76,
    "end": 123.36,
    "duration": 3.6
  },
  {
    "id": 30,
    "text": "象征跳跃与戏剧性独白，",
    "start": 123.2,
    "end": 123.36,
    "duration": 0.16
  },
  {
    "id": 31,
    "text": "他们锤炼出一种充满内在骨力与张力的现代诗歌语言，",
    "start": 123.2,
    "end": 123.36,
    "duration": 0.16
  },
  {
    "id": 32,
    "text": "确立了中国现代诗歌成熟期的美学标杆。",
    "start": 123.2,
    "end": 123.36,
    "duration": 0.16
  }
]