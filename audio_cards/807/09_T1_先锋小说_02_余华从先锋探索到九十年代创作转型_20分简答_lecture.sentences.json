[
  {
    "id": 1,
    "text": "一、宏观结构推演与采分点映射。",
    "start": 0.08,
    "end": 3.12,
    "duration": 3.04
  },
  {
    "id": 2,
    "text": "本题标准分为二十分，简答题结构采用高分“总领定性，",
    "start": 3.12,
    "end": 8.24,
    "duration": 5.12
  },
  {
    "id": 3,
    "text": "三点机制并列推进，收束升华”逻辑模型：一、",
    "start": 8.24,
    "end": 11.92,
    "duration": 3.68
  },
  {
    "id": 4,
    "text": "总领定性（约五十字）：明确转型的实质（从形式激进走向生命温情、",
    "start": 11.92,
    "end": 17.6,
    "duration": 5.68
  },
  {
    "id": 5,
    "text": "先锋成熟标志）。",
    "start": 17.6,
    "end": 18.56,
    "duration": 0.96
  },
  {
    "id": 6,
    "text": "二、第一点：叙事方式转型（形式层面）：从反因果、",
    "start": 18.96,
    "end": 23.412,
    "duration": 4.452
  },
  {
    "id": 7,
    "text": "视点断裂的解构实验，转向线性叙事与民间口语传统（《活着》《许三观卖血记》）。",
    "start": 23.412,
    "end": 30.492,
    "duration": 7.08
  },
  {
    "id": 8,
    "text": "三、第二点：情感温度转型（精神层面）：从零度冷酷的暴力书写，",
    "start": 30.492,
    "end": 36.156,
    "duration": 5.664
  },
  {
    "id": 9,
    "text": "转向对底层人道主义的悲敏、宽容与生存韧性。",
    "start": 36.156,
    "end": 40.64,
    "duration": 4.484
  },
  {
    "id": 10,
    "text": "四、第三点：历史观转型（哲学层面）：从抽象荒诞寓言，",
    "start": 40.8,
    "end": 47.04,
    "duration": 6.24
  },
  {
    "id": 11,
    "text": "走向切入中国现代苦难历史的深沉经验。",
    "start": 47.04,
    "end": 50.56,
    "duration": 3.52
  },
  {
    "id": 12,
    "text": "五、收束升华（约五十字）：指出转型不是倒退妥协，",
    "start": 50.56,
    "end": 55.6,
    "duration": 5.04
  },
  {
    "id": 13,
    "text": "而是经历先锋洗礼后的超越与升华。",
    "start": 55.6,
    "end": 58.72,
    "duration": 3.12
  },
  {
    "id": 14,
    "text": "二、逐段内部咬合与考场得分句推导。",
    "start": 58.72,
    "end": 62.08,
    "duration": 3.36
  },
  {
    "id": 15,
    "text": "总领段：明确转型实质。",
    "start": 62.4,
    "end": 64.48,
    "duration": 2.08
  },
  {
    "id": 16,
    "text": "论证推演逻辑：简答题开门见山，无需冗长铺垫。",
    "start": 64.48,
    "end": 68.48,
    "duration": 4.0
  },
  {
    "id": 17,
    "text": "一句话指出余华的转型轨迹，并概括其文学史意义。",
    "start": 68.48,
    "end": 72.64,
    "duration": 4.16
  },
  {
    "id": 18,
    "text": "具体表述到答题语句就是：余华从二十世纪八十年代后期的先锋实验，",
    "start": 72.64,
    "end": 78.0,
    "duration": 5.36
  },
  {
    "id": 19,
    "text": "转向九十年代的长篇现实主义书写，",
    "start": 78.0,
    "end": 80.72,
    "duration": 2.72
  },
  {
    "id": 20,
    "text": "代表了中国先锋作家从形式激进走向生命温情的深刻蜕变。",
    "start": 80.72,
    "end": 85.28,
    "duration": 4.56
  },
  {
    "id": 21,
    "text": "这一转型集中体现在三个方面。",
    "start": 85.52,
    "end": 88.16,
    "duration": 2.64
  },
  {
    "id": 22,
    "text": "余华从二十世纪八十年代后期的先锋实验，",
    "start": 88.16,
    "end": 91.6,
    "duration": 3.44
  },
  {
    "id": 23,
    "text": "转向九十年代的长篇现实主义书写，",
    "start": 91.6,
    "end": 94.64,
    "duration": 3.04
  },
  {
    "id": 24,
    "text": "代表了中国先锋作家从形式激进走向生命温情的深刻蜕变。",
    "start": 94.64,
    "end": 100.24,
    "duration": 5.6
  },
  {
    "id": 25,
    "text": "这一转型集中体现在三个方面。",
    "start": 100.24,
    "end": 102.88,
    "duration": 2.64
  },
  {
    "id": 26,
    "text": "要点一：叙事形式层面的转型。",
    "start": 102.88,
    "end": 105.52,
    "duration": 2.64
  },
  {
    "id": 27,
    "text": "论证推演逻辑：先从文体和叙事技术切入。",
    "start": 105.84,
    "end": 109.52,
    "duration": 3.68
  },
  {
    "id": 28,
    "text": "对比八十年代短篇《十八岁出门远行》《现实一种》对传统因果和情节的摧毁，",
    "start": 109.52,
    "end": 116.0,
    "duration": 6.48
  },
  {
    "id": 29,
    "text": "与九十年代《活着》《许三观卖血记》对民间线性讲故事传统的重构。",
    "start": 116.0,
    "end": 121.76,
    "duration": 5.76
  },
  {
    "id": 30,
    "text": "具体表述到答题语句就是：第一，从形式本体解构转向传统线性叙事回归。",
    "start": 121.76,
    "end": 128.136,
    "duration": 6.376
  },
  {
    "id": 31,
    "text": "八十年代余华以《十八岁出门远行》《现实一种》等先锋短篇闻名。",
    "start": 128.136,
    "end": 133.416,
    "duration": 5.28
  },
  {
    "id": 32,
    "text": "他注重反因果逻辑、叙述视点断裂与反讽修辞。",
    "start": 133.416,
    "end": 137.656,
    "duration": 4.24
  },
  {
    "id": 33,
    "text": "进入九十年代，余华在《活着》与《许三观卖血记》中放弃了繁复的形式迷宫。",
    "start": 137.656,
    "end": 143.336,
    "duration": 5.68
  },
  {
    "id": 34,
    "text": "他转而采用平实质朴的线性民间叙事。",
    "start": 143.576,
    "end": 146.936,
    "duration": 3.36
  },
  {
    "id": 35,
    "text": "作家借助福贵的第一人称口述与许三观重复回环的口语对话，",
    "start": 146.936,
    "end": 151.976,
    "duration": 5.04
  },
  {
    "id": 36,
    "text": "重建了通俗流畅的讲故事传统。",
    "start": 151.976,
    "end": 154.456,
    "duration": 2.48
  },
  {
    "id": 37,
    "text": "第一，从形式本体解构转向传统线性叙事回归。",
    "start": 154.456,
    "end": 158.296,
    "duration": 3.84
  },
  {
    "id": 38,
    "text": "八十年代余华以《十八岁出门远行》《现实一种》等先锋短篇闻名。",
    "start": 158.296,
    "end": 162.936,
    "duration": 4.64
  },
  {
    "id": 39,
    "text": "他注重反因果逻辑、叙述视点断裂与反讽修辞。",
    "start": 163.256,
    "end": 168.056,
    "duration": 4.8
  },
  {
    "id": 40,
    "text": "进入九十年代，余华在《活着》与《许三观卖血记》中放弃了繁复的形式迷宫。",
    "start": 168.056,
    "end": 174.616,
    "duration": 6.56
  },
  {
    "id": 41,
    "text": "他转而采用平实质朴的线性民间叙事。",
    "start": 174.616,
    "end": 178.376,
    "duration": 3.76
  },
  {
    "id": 42,
    "text": "作家借助福贵的第一人称口述与许三观重复回环的口语对话，",
    "start": 178.376,
    "end": 183.816,
    "duration": 5.44
  },
  {
    "id": 43,
    "text": "重建了通俗流畅的讲故事传统。",
    "start": 183.816,
    "end": 186.376,
    "duration": 2.56
  },
  {
    "id": 44,
    "text": "要点二：情感温度与价值立场的转型。",
    "start": 186.616,
    "end": 190.296,
    "duration": 3.68
  },
  {
    "id": 45,
    "text": "论证推演逻辑：这是余华最核心的灵魂蜕变。",
    "start": 190.296,
    "end": 194.536,
    "duration": 4.24
  },
  {
    "id": 46,
    "text": "紧扣学术得分词“零度情感”，对比其早期的残忍血腥解剖，",
    "start": 194.536,
    "end": 199.656,
    "duration": 5.12
  },
  {
    "id": 47,
    "text": "与九十年代对底层苦难的宽容与悲敏。",
    "start": 199.656,
    "end": 202.936,
    "duration": 3.28
  },
  {
    "id": 48,
    "text": "用福贵与牛相伴的尊严、许三观对一乐的父爱作为坚实论据。",
    "start": 202.936,
    "end": 207.736,
    "duration": 4.8
  },
  {
    "id": 49,
    "text": "具体表述到答题语句就是：第二，从零度情感暴力转向人道主义悲敏与温情。",
    "start": 208.056,
    "end": 214.776,
    "duration": 6.72
  },
  {
    "id": 50,
    "text": "先锋时期的余华被称作冷酷的解剖师。",
    "start": 214.776,
    "end": 218.136,
    "duration": 3.36
  },
  {
    "id": 51,
    "text": "他以剔除道德温度的笔触，平静描摹流血、",
    "start": 218.136,
    "end": 221.816,
    "duration": 3.68
  },
  {
    "id": 52,
    "text": "残杀与存在的荒谬本相。",
    "start": 221.816,
    "end": 224.136,
    "duration": 2.32
  },
  {
    "id": 53,
    "text": "九十年代后余华的创作立场发生根本扭转。",
    "start": 224.136,
    "end": 227.416,
    "duration": 3.28
  },
  {
    "id": 54,
    "text": "他开始深情凝视普通底层百姓的生存韧性。",
    "start": 227.656,
    "end": 231.496,
    "duration": 3.84
  },
  {
    "id": 55,
    "text": "《活着》在无休止的死亡剥夺中，展现福贵与老牛相依为命的生命尊严。",
    "start": 231.496,
    "end": 237.976,
    "duration": 6.48
  },
  {
    "id": 56,
    "text": "《许三观卖血记》中许三观在一次次卖血换命的屈辱中，",
    "start": 237.976,
    "end": 242.456,
    "duration": 4.48
  },
  {
    "id": 57,
    "text": "释出对非亲生儿子一乐深沉博大的父爱。",
    "start": 242.456,
    "end": 246.216,
    "duration": 3.76
  },
  {
    "id": 58,
    "text": "冷酷的解剖最终被博大的人性关怀所融化。",
    "start": 246.216,
    "end": 249.576,
    "duration": 3.36
  },
  {
    "id": 59,
    "text": "第二，从零度情感暴力转向人道主义悲敏与温情。",
    "start": 249.872,
    "end": 254.352,
    "duration": 4.48
  },
  {
    "id": 60,
    "text": "先锋时期的余华被称作冷酷的解剖师。",
    "start": 254.352,
    "end": 257.792,
    "duration": 3.44
  },
  {
    "id": 61,
    "text": "他以剔除道德温度的笔触，平静描摹流血、",
    "start": 257.792,
    "end": 261.712,
    "duration": 3.92
  },
  {
    "id": 62,
    "text": "残杀与存在的荒谬本相。",
    "start": 261.712,
    "end": 264.352,
    "duration": 2.64
  },
  {
    "id": 63,
    "text": "九十年代后余华的创作立场发生根本扭转。",
    "start": 264.352,
    "end": 267.872,
    "duration": 3.52
  },
  {
    "id": 64,
    "text": "他开始深情凝视普通底层百姓的生存韧性。",
    "start": 267.872,
    "end": 271.152,
    "duration": 3.28
  },
  {
    "id": 65,
    "text": "《活着》在无休止的死亡剥夺中，展现福贵与老牛相依为命的生命尊严。",
    "start": 271.392,
    "end": 277.843,
    "duration": 6.451
  },
  {
    "id": 66,
    "text": "《许三观卖血记》中许三观在一次次卖血换命的屈辱中，",
    "start": 277.843,
    "end": 282.912,
    "duration": 5.069
  },
  {
    "id": 67,
    "text": "释出对非亲生儿子一乐深沉博大的父爱。",
    "start": 282.912,
    "end": 286.829,
    "duration": 3.917
  },
  {
    "id": 68,
    "text": "冷酷的解剖最终被博大的人性关怀所融化。",
    "start": 286.829,
    "end": 290.976,
    "duration": 4.147
  },
  {
    "id": 69,
    "text": "要点三：历史深度与现实维度的转型。",
    "start": 290.976,
    "end": 294.432,
    "duration": 3.456
  },
  {
    "id": 70,
    "text": "-论证推演逻辑：从存在哲学的抽象寓言，",
    "start": 294.432,
    "end": 297.582,
    "duration": 3.15
  },
  {
    "id": 71,
    "text": "落脚到中国具体历史的生命承担。",
    "start": 297.582,
    "end": 300.338,
    "duration": 2.756
  },
  {
    "id": 72,
    "text": "先锋短篇往往是关于生存困境的先锋实验场，",
    "start": 300.338,
    "end": 304.078,
    "duration": 3.74
  },
  {
    "id": 73,
    "text": "而长篇则把人物推入具体历史的风暴中，",
    "start": 304.078,
    "end": 307.424,
    "duration": 3.346
  },
  {
    "id": 74,
    "text": "从而赋予作品厚重的沧桑感。",
    "start": 307.424,
    "end": 309.787,
    "duration": 2.363
  },
  {
    "id": 75,
    "text": "具体表述到答题语句就是：第三，从哲学荒诞寓言转向深沉历史命运体验。",
    "start": 309.787,
    "end": 316.192,
    "duration": 6.405
  },
  {
    "id": 76,
    "text": "先锋短篇更多是抽离具体历史语境的哲学荒诞寓言。",
    "start": 316.192,
    "end": 320.752,
    "duration": 4.56
  },
  {
    "id": 77,
    "text": "九十年代长篇则深深扎根于中国现代历史的苦难土壤。",
    "start": 320.752,
    "end": 325.072,
    "duration": 4.32
  },
  {
    "id": 78,
    "text": "余华将内战、大跃进、文革等重大时代风暴，",
    "start": 325.072,
    "end": 328.832,
    "duration": 3.76
  },
  {
    "id": 79,
    "text": "化为普通个体无处逃避的生存背景。",
    "start": 328.832,
    "end": 331.712,
    "duration": 2.88
  },
  {
    "id": 80,
    "text": "文学的重心由此从解构现实，升华为了解与同情现实。",
    "start": 331.952,
    "end": 336.832,
    "duration": 4.88
  },
  {
    "id": 81,
    "text": "第三，从哲学荒诞寓言转向深沉历史命运体验。",
    "start": 336.832,
    "end": 341.392,
    "duration": 4.56
  },
  {
    "id": 82,
    "text": "先锋短篇更多是抽离具体历史语境的哲学荒诞寓言。",
    "start": 341.392,
    "end": 346.032,
    "duration": 4.64
  },
  {
    "id": 83,
    "text": "九十年代长篇则深深扎根于中国现代历史的苦难土壤。",
    "start": 346.032,
    "end": 350.512,
    "duration": 4.48
  },
  {
    "id": 84,
    "text": "余华将内战、大跃进、文革等重大时代风暴，",
    "start": 350.512,
    "end": 354.112,
    "duration": 3.6
  },
  {
    "id": 85,
    "text": "化为普通个体无处逃避的生存背景。",
    "start": 354.112,
    "end": 356.992,
    "duration": 2.88
  },
  {
    "id": 86,
    "text": "文学的重心由此从解构现实，升华为了解与同情现实。",
    "start": 357.232,
    "end": 362.432,
    "duration": 5.2
  },
  {
    "id": 87,
    "text": "总结升华段：辩证评价。",
    "start": 362.432,
    "end": 364.592,
    "duration": 2.16
  },
  {
    "id": 88,
    "text": "论证推演逻辑：最后用一句话总结，",
    "start": 364.592,
    "end": 367.472,
    "duration": 2.88
  },
  {
    "id": 89,
    "text": "强调转型不是妥协退化，而是文学走向成熟的辩证扬弃。",
    "start": 367.472,
    "end": 372.432,
    "duration": 4.96
  },
  {
    "id": 90,
    "text": "具体表述到答题语句就是：余华的转型并非向传统现实主义的简单妥协，",
    "start": 372.432,
    "end": 378.432,
    "duration": 6.0
  },
  {
    "id": 91,
    "text": "而是在历经先锋形式革命洗礼后，对生命本质与汉语文学传统的成熟重构。",
    "start": 378.432,
    "end": 384.512,
    "duration": 6.08
  },
  {
    "id": 92,
    "text": "余华的转型并非向传统现实主义的简单妥协，",
    "start": 384.832,
    "end": 388.672,
    "duration": 3.84
  },
  {
    "id": 93,
    "text": "而是在历经先锋形式革命洗礼后，对生命本质与汉语文学传统的成熟重构。",
    "start": 388.672,
    "end": 394.672,
    "duration": 6.0
  }
]