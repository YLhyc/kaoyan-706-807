[
  {
    "id": 1,
    "text": "一、宏观结构推演与采分点映射。",
    "start": 0.08,
    "end": 3.12,
    "duration": 3.04
  },
  {
    "id": 2,
    "text": "本题标准分为二十分，简答题结构采用高分“总领定性，",
    "start": 3.12,
    "end": 8.24,
    "duration": 5.12
  },
  {
    "id": 3,
    "text": "三点机制并列推进，收束升华”逻辑模型：一、",
    "start": 8.24,
    "end": 11.92,
    "duration": 3.68
  },
  {
    "id": 4,
    "text": "总领定性（约五十字）：明确转型的实质（从形式激进走向生命温情、",
    "start": 11.92,
    "end": 17.6,
    "duration": 5.68
  },
  {
    "id": 5,
    "text": "先锋成熟标志）。",
    "start": 17.6,
    "end": 18.56,
    "duration": 0.96
  },
  {
    "id": 6,
    "text": "二、第一点：叙事方式转型（形式层面）：从反因果、",
    "start": 18.96,
    "end": 23.363,
    "duration": 4.403
  },
  {
    "id": 7,
    "text": "视点断裂的解构实验，转向线性叙事与民间口语传统（《活着》《许三观卖血记》）。",
    "start": 23.363,
    "end": 30.233,
    "duration": 6.87
  },
  {
    "id": 8,
    "text": "三、第二点：情感温度转型（精神层面）：从零度冷酷的暴力书写，",
    "start": 30.233,
    "end": 35.729,
    "duration": 5.496
  },
  {
    "id": 9,
    "text": "转向对底层人道主义的悲敏、宽容与生存韧性。",
    "start": 35.729,
    "end": 40.08,
    "duration": 4.351
  },
  {
    "id": 10,
    "text": "四、第三点：历史观转型（哲学层面）：从抽象荒诞寓言，",
    "start": 40.24,
    "end": 45.28,
    "duration": 5.04
  },
  {
    "id": 11,
    "text": "走向切入中国现代苦难历史的深沉经验。",
    "start": 45.28,
    "end": 48.56,
    "duration": 3.28
  },
  {
    "id": 12,
    "text": "五、收束升华（约五十字）：指出转型不是倒退妥协，",
    "start": 48.56,
    "end": 53.6,
    "duration": 5.04
  },
  {
    "id": 13,
    "text": "而是经历先锋洗礼后的超越与升华。。",
    "start": 53.6,
    "end": 56.88,
    "duration": 3.28
  },
  {
    "id": 14,
    "text": "二、逐段内部咬合与考场得分句推导。",
    "start": 56.88,
    "end": 60.08,
    "duration": 3.2
  },
  {
    "id": 15,
    "text": "总领段：明确转型实质。",
    "start": 60.4,
    "end": 62.48,
    "duration": 2.08
  },
  {
    "id": 16,
    "text": "论证推演逻辑：简答题开门见山，无需冗长铺垫。",
    "start": 62.48,
    "end": 66.48,
    "duration": 4.0
  },
  {
    "id": 17,
    "text": "一句话指出余华的转型轨迹，并概括其文学史意义。",
    "start": 66.48,
    "end": 70.4,
    "duration": 3.92
  },
  {
    "id": 18,
    "text": "具体表述到答题语句就是：余华从二十世纪八十年代后期的先锋实验，",
    "start": 70.4,
    "end": 75.84,
    "duration": 5.44
  },
  {
    "id": 19,
    "text": "转向九十年代的长篇现实主义书写，",
    "start": 75.84,
    "end": 78.56,
    "duration": 2.72
  },
  {
    "id": 20,
    "text": "代表了中国先锋作家从形式激进走向生命温情的深刻蜕变。",
    "start": 78.56,
    "end": 83.28,
    "duration": 4.72
  },
  {
    "id": 21,
    "text": "这一转型集中体现在三个方面。",
    "start": 83.52,
    "end": 86.16,
    "duration": 2.64
  },
  {
    "id": 22,
    "text": "余华从二十世纪八十年代后期的先锋实验，",
    "start": 86.16,
    "end": 89.6,
    "duration": 3.44
  },
  {
    "id": 23,
    "text": "转向九十年代的长篇现实主义书写，",
    "start": 89.6,
    "end": 92.64,
    "duration": 3.04
  },
  {
    "id": 24,
    "text": "代表了中国先锋作家从形式激进走向生命温情的深刻蜕变。",
    "start": 92.64,
    "end": 98.24,
    "duration": 5.6
  },
  {
    "id": 25,
    "text": "这一转型集中体现在三个方面。",
    "start": 98.24,
    "end": 100.88,
    "duration": 2.64
  },
  {
    "id": 26,
    "text": "要点一：叙事形式层面的转型。",
    "start": 100.88,
    "end": 103.52,
    "duration": 2.64
  },
  {
    "id": 27,
    "text": "论证推演逻辑：先从文体和叙事技术切入。",
    "start": 103.84,
    "end": 107.52,
    "duration": 3.68
  },
  {
    "id": 28,
    "text": "对比八十年代短篇《十八岁出门远行》《现实一种》对传统因果和情节的摧毁，",
    "start": 107.52,
    "end": 114.0,
    "duration": 6.48
  },
  {
    "id": 29,
    "text": "与九十年代《活着》《许三观卖血记》对民间线性讲故事传统的重构。",
    "start": 114.0,
    "end": 119.76,
    "duration": 5.76
  },
  {
    "id": 30,
    "text": "具体表述到答题语句就是：第一，从形式本体解构转向传统线性叙事回归。",
    "start": 119.76,
    "end": 126.064,
    "duration": 6.304
  },
  {
    "id": 31,
    "text": "八十年代余华以《十八岁出门远行》《现实一种》等先锋短篇闻名。",
    "start": 126.064,
    "end": 130.944,
    "duration": 4.88
  },
  {
    "id": 32,
    "text": "他注重反因果逻辑、叙述视点断裂与反讽修辞。",
    "start": 130.944,
    "end": 134.704,
    "duration": 3.76
  },
  {
    "id": 33,
    "text": "进入九十年代，余华在《活着》与《许三观卖血记》中放弃了繁复的形式迷宫。",
    "start": 134.704,
    "end": 140.144,
    "duration": 5.44
  },
  {
    "id": 34,
    "text": "他转而采用平实质朴的线性民间叙事。",
    "start": 140.464,
    "end": 143.824,
    "duration": 3.36
  },
  {
    "id": 35,
    "text": "作家借助福贵的第一人称口述与许三观重复回环的口语对话，",
    "start": 143.824,
    "end": 148.864,
    "duration": 5.04
  },
  {
    "id": 36,
    "text": "重建了通俗流畅的讲故事传统。",
    "start": 148.864,
    "end": 151.344,
    "duration": 2.48
  },
  {
    "id": 37,
    "text": "第一，从形式本体解构转向传统线性叙事回归。",
    "start": 151.344,
    "end": 155.184,
    "duration": 3.84
  },
  {
    "id": 38,
    "text": "八十年代余华以《十八岁出门远行》《现实一种》等先锋短篇闻名。",
    "start": 155.184,
    "end": 159.824,
    "duration": 4.64
  },
  {
    "id": 39,
    "text": "他注重反因果逻辑、叙述视点断裂与反讽修辞。",
    "start": 160.144,
    "end": 164.784,
    "duration": 4.64
  },
  {
    "id": 40,
    "text": "进入九十年代，余华在《活着》与《许三观卖血记》中放弃了繁复的形式迷宫。",
    "start": 164.784,
    "end": 171.184,
    "duration": 6.4
  },
  {
    "id": 41,
    "text": "他转而采用平实质朴的线性民间叙事。",
    "start": 171.184,
    "end": 174.624,
    "duration": 3.44
  },
  {
    "id": 42,
    "text": "作家借助福贵的第一人称口述与许三观重复回环的口语对话，",
    "start": 174.624,
    "end": 179.744,
    "duration": 5.12
  },
  {
    "id": 43,
    "text": "重建了通俗流畅的讲故事传统。",
    "start": 179.744,
    "end": 182.144,
    "duration": 2.4
  },
  {
    "id": 44,
    "text": "要点二：情感温度与价值立场的转型。",
    "start": 182.544,
    "end": 186.224,
    "duration": 3.68
  },
  {
    "id": 45,
    "text": "论证推演逻辑：这是余华最核心的灵魂蜕变。",
    "start": 186.224,
    "end": 190.464,
    "duration": 4.24
  },
  {
    "id": 46,
    "text": "紧扣学术得分词“零度情感”，对比其早期的残忍血腥解剖，",
    "start": 190.464,
    "end": 195.584,
    "duration": 5.12
  },
  {
    "id": 47,
    "text": "与九十年代对底层苦难的宽容与悲敏。",
    "start": 195.584,
    "end": 198.944,
    "duration": 3.36
  },
  {
    "id": 48,
    "text": "用福贵与牛相伴的尊严、许三观对一乐的父爱作为坚实论据。",
    "start": 198.944,
    "end": 203.984,
    "duration": 5.04
  },
  {
    "id": 49,
    "text": "具体表述到答题语句就是：第二，从零度情感暴力转向人道主义悲敏与温情。",
    "start": 204.304,
    "end": 211.024,
    "duration": 6.72
  },
  {
    "id": 50,
    "text": "先锋时期的余华被称作冷酷的解剖师。",
    "start": 211.024,
    "end": 214.384,
    "duration": 3.36
  },
  {
    "id": 51,
    "text": "他以剔除道德温度的笔触，平静描摹流血、",
    "start": 214.384,
    "end": 218.064,
    "duration": 3.68
  },
  {
    "id": 52,
    "text": "残杀与存在的荒谬本相。",
    "start": 218.064,
    "end": 220.384,
    "duration": 2.32
  },
  {
    "id": 53,
    "text": "九十年代后余华的创作立场发生根本扭转。",
    "start": 220.384,
    "end": 223.664,
    "duration": 3.28
  },
  {
    "id": 54,
    "text": "他开始深情凝视普通底层百姓的生存韧性。",
    "start": 223.904,
    "end": 227.824,
    "duration": 3.92
  },
  {
    "id": 55,
    "text": "《活着》在无休止的死亡剥夺中，展现福贵与老牛相依为命的生命尊严。",
    "start": 227.824,
    "end": 233.744,
    "duration": 5.92
  },
  {
    "id": 56,
    "text": "《许三观卖血记》中许三观在一次次卖血换命的屈辱中，",
    "start": 233.744,
    "end": 238.064,
    "duration": 4.32
  },
  {
    "id": 57,
    "text": "释出对非亲生儿子一乐深沉博大的父爱。",
    "start": 238.064,
    "end": 241.744,
    "duration": 3.68
  },
  {
    "id": 58,
    "text": "冷酷的解剖最终被博大的人性关怀所融化。",
    "start": 241.744,
    "end": 245.344,
    "duration": 3.6
  },
  {
    "id": 59,
    "text": "第二，从零度情感暴力转向人道主义悲敏与温情。",
    "start": 245.648,
    "end": 250.128,
    "duration": 4.48
  },
  {
    "id": 60,
    "text": "先锋时期的余华被称作冷酷的解剖师。",
    "start": 250.128,
    "end": 253.568,
    "duration": 3.44
  },
  {
    "id": 61,
    "text": "他以剔除道德温度的笔触，平静描摹流血、",
    "start": 253.568,
    "end": 257.488,
    "duration": 3.92
  },
  {
    "id": 62,
    "text": "残杀与存在的荒谬本相。",
    "start": 257.488,
    "end": 260.128,
    "duration": 2.64
  },
  {
    "id": 63,
    "text": "九十年代后余华的创作立场发生根本扭转。",
    "start": 260.128,
    "end": 263.648,
    "duration": 3.52
  },
  {
    "id": 64,
    "text": "他开始深情凝视普通底层百姓的生存韧性。",
    "start": 263.648,
    "end": 266.928,
    "duration": 3.28
  },
  {
    "id": 65,
    "text": "《活着》在无休止的死亡剥夺中，展现福贵与老牛相依为命的生命尊严。",
    "start": 267.088,
    "end": 273.069,
    "duration": 5.981
  },
  {
    "id": 66,
    "text": "《许三观卖血记》中许三观在一次次卖血换命的屈辱中，",
    "start": 273.069,
    "end": 277.768,
    "duration": 4.699
  },
  {
    "id": 67,
    "text": "释出对非亲生儿子一乐深沉博大的父爱。",
    "start": 277.768,
    "end": 281.399,
    "duration": 3.631
  },
  {
    "id": 68,
    "text": "冷酷的解剖最终被博大的人性关怀所融化。",
    "start": 281.399,
    "end": 285.244,
    "duration": 3.845
  },
  {
    "id": 69,
    "text": "--。要",
    "start": 285.244,
    "end": 285.458,
    "duration": 0.214
  },
  {
    "id": 70,
    "text": "点三：历史深度与现实维度的转型。",
    "start": 285.458,
    "end": 288.448,
    "duration": 2.99
  },
  {
    "id": 71,
    "text": "-论证推演逻辑：从存在哲学的抽象寓言，",
    "start": 288.448,
    "end": 291.592,
    "duration": 3.144
  },
  {
    "id": 72,
    "text": "落脚到中国具体历史的生命承担。",
    "start": 291.592,
    "end": 294.343,
    "duration": 2.751
  },
  {
    "id": 73,
    "text": "先锋短篇往往是形而上的实验场，而长篇则把人物推入具体历史的风暴中，",
    "start": 294.343,
    "end": 300.435,
    "duration": 6.092
  },
  {
    "id": 74,
    "text": "从而赋予作品厚重的沧桑感。",
    "start": 300.435,
    "end": 302.793,
    "duration": 2.358
  },
  {
    "id": 75,
    "text": "具体表述到答题语句就是：第三，从哲学荒诞寓言转向深沉历史命运体验。",
    "start": 302.793,
    "end": 308.688,
    "duration": 5.895
  },
  {
    "id": 76,
    "text": "先锋短篇更多是抽离具体历史语境的形而上生存寓言。",
    "start": 308.848,
    "end": 313.408,
    "duration": 4.56
  },
  {
    "id": 77,
    "text": "九十年代长篇则深深扎根于中国现代历史的苦难土壤。",
    "start": 313.408,
    "end": 318.288,
    "duration": 4.88
  },
  {
    "id": 78,
    "text": "余华将内战、大跃进、文革等重大时代风暴，",
    "start": 318.288,
    "end": 321.968,
    "duration": 3.68
  },
  {
    "id": 79,
    "text": "化为普通个体无处逃避的生存背景。",
    "start": 321.968,
    "end": 325.008,
    "duration": 3.04
  },
  {
    "id": 80,
    "text": "文学的重心由此从解构现实，升华为了解与同情现实。",
    "start": 325.008,
    "end": 330.048,
    "duration": 5.04
  },
  {
    "id": 81,
    "text": "第三，从哲学荒诞寓言转向深沉历史命运体验。",
    "start": 330.288,
    "end": 334.688,
    "duration": 4.4
  },
  {
    "id": 82,
    "text": "先锋短篇更多是抽离具体历史语境的形而上生存寓言。",
    "start": 334.688,
    "end": 338.928,
    "duration": 4.24
  },
  {
    "id": 83,
    "text": "九十年代长篇则深深扎根于中国现代历史的苦难土壤。",
    "start": 338.928,
    "end": 343.328,
    "duration": 4.4
  },
  {
    "id": 84,
    "text": "余华将内战、大跃进、文革等重大时代风暴，",
    "start": 343.328,
    "end": 347.168,
    "duration": 3.84
  },
  {
    "id": 85,
    "text": "化为普通个体无处逃避的生存背景。",
    "start": 347.168,
    "end": 349.888,
    "duration": 2.72
  },
  {
    "id": 86,
    "text": "文学的重心由此从解构现实，升华为了解与同情现实。",
    "start": 350.128,
    "end": 355.328,
    "duration": 5.2
  },
  {
    "id": 87,
    "text": "--。总",
    "start": 355.328,
    "end": 355.488,
    "duration": 0.16
  },
  {
    "id": 88,
    "text": "结升华段：辩证评价。",
    "start": 355.488,
    "end": 357.328,
    "duration": 1.84
  },
  {
    "id": 89,
    "text": "论证推演逻辑：最后用一句话总结，",
    "start": 357.328,
    "end": 360.208,
    "duration": 2.88
  },
  {
    "id": 90,
    "text": "强调转型不是妥协退化，而是文学走向成熟的辩证扬弃。",
    "start": 360.208,
    "end": 365.088,
    "duration": 4.88
  },
  {
    "id": 91,
    "text": "具体表述到答题语句就是：余华的转型并非向传统现实主义的简单妥协，",
    "start": 365.088,
    "end": 370.928,
    "duration": 5.84
  },
  {
    "id": 92,
    "text": "而是在历经先锋形式革命洗礼后，对生命本质与汉语文学传统的成熟重构。",
    "start": 370.928,
    "end": 377.168,
    "duration": 6.24
  },
  {
    "id": 93,
    "text": "余华的转型并非向传统现实主义的简单妥协，",
    "start": 377.408,
    "end": 381.248,
    "duration": 3.84
  },
  {
    "id": 94,
    "text": "而是在历经先锋形式革命洗礼后，对生命本质与汉语文学传统的成熟重构。",
    "start": 381.248,
    "end": 387.248,
    "duration": 6.0
  }
]