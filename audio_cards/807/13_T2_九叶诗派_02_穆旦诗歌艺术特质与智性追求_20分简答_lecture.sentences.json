[
  {
    "id": 1,
    "text": "一、宏观结构推演与采分点映射。",
    "start": 0.08,
    "end": 3.04,
    "duration": 2.96
  },
  {
    "id": 2,
    "text": "本题标准分为二十分，简答题结构采用高分“总领定性，",
    "start": 3.04,
    "end": 7.76,
    "duration": 4.72
  },
  {
    "id": 3,
    "text": "三点机制并列推进，收束总结”逻辑模型：一、",
    "start": 7.76,
    "end": 11.76,
    "duration": 4.0
  },
  {
    "id": 4,
    "text": "总领定性（约五十字）：界定穆旦的诗坛地位、",
    "start": 11.76,
    "end": 15.36,
    "duration": 3.6
  },
  {
    "id": 5,
    "text": "核心关键词（现代智性化、肉体与灵魂的辩证融合）。",
    "start": 15.36,
    "end": 19.44,
    "duration": 4.08
  },
  {
    "id": 6,
    "text": "二、第一点：智性机制（感觉与思想的转化）：采分点为英美玄学派滋养、",
    "start": 19.76,
    "end": 25.52,
    "duration": 5.76
  },
  {
    "id": 7,
    "text": "肉体痛感与抽象哲理思辨焊接（《诗八首》）。",
    "start": 25.52,
    "end": 29.12,
    "duration": 3.6
  },
  {
    "id": 8,
    "text": "三、第二点：思想内核（知识分子原罪与分裂）：采分点为反浪漫滥情、",
    "start": 29.12,
    "end": 34.72,
    "duration": 5.6
  },
  {
    "id": 9,
    "text": "冷酷解剖自我、现代人性危机审判（《隐现》）。",
    "start": 34.72,
    "end": 37.52,
    "duration": 2.8
  },
  {
    "id": 10,
    "text": "四、第三点：语言修辞（悖论反讽与张力网络）：采分点为词汇冲突对立、",
    "start": 37.68,
    "end": 43.92,
    "duration": 6.24
  },
  {
    "id": 11,
    "text": "冷硬质感、现代汉语诗意空间拓展（《赞美》）。",
    "start": 43.92,
    "end": 47.52,
    "duration": 3.6
  },
  {
    "id": 12,
    "text": "五、收束总结（约五十字）：新诗现代化最高峰、",
    "start": 47.52,
    "end": 51.44,
    "duration": 3.92
  },
  {
    "id": 13,
    "text": "当代汉语诗歌先锋遗产。",
    "start": 51.44,
    "end": 53.52,
    "duration": 2.08
  },
  {
    "id": 14,
    "text": "二、逐段内部咬合与考场得分句推导。",
    "start": 53.52,
    "end": 56.64,
    "duration": 3.12
  },
  {
    "id": 15,
    "text": "总领段：明确作家地位与美学特征。",
    "start": 57.04,
    "end": 60.0,
    "duration": 2.96
  },
  {
    "id": 16,
    "text": "论证推演逻辑：直接交代穆旦作为九叶主将的文学史地位。",
    "start": 60.0,
    "end": 64.88,
    "duration": 4.88
  },
  {
    "id": 17,
    "text": "指出其核心突破是打破直白抒情，确立现代“智性”原则，",
    "start": 64.88,
    "end": 69.92,
    "duration": 5.04
  },
  {
    "id": 18,
    "text": "引出具体展开。",
    "start": 69.92,
    "end": 71.36,
    "duration": 1.44
  },
  {
    "id": 19,
    "text": "具体表述到答题语句就是：穆旦是二十世纪四十年代九叶诗派最具代表性的诗歌巨匠。",
    "start": 71.36,
    "end": 78.0,
    "duration": 6.64
  },
  {
    "id": 20,
    "text": "他以敏锐深邃的现代哲学思考，打破了早期新诗浮泛直白的抒情模式。",
    "start": 78.24,
    "end": 84.16,
    "duration": 5.92
  },
  {
    "id": 21,
    "text": "穆旦追求现代诗的“智性化”。",
    "start": 84.16,
    "end": 86.48,
    "duration": 2.32
  },
  {
    "id": 22,
    "text": "他将时代苦难、自我怀疑与深层心理体验紧密熔铸在一起。",
    "start": 86.48,
    "end": 91.68,
    "duration": 5.2
  },
  {
    "id": 23,
    "text": "其艺术特质与智性追求主要体现在三个层面。",
    "start": 91.68,
    "end": 95.68,
    "duration": 4.0
  },
  {
    "id": 24,
    "text": "穆旦是二十世纪四十年代九叶诗派最具代表性的诗歌巨匠。",
    "start": 95.68,
    "end": 100.08,
    "duration": 4.4
  },
  {
    "id": 25,
    "text": "他以敏锐深邃的现代哲学思考，打破了早期新诗浮泛直白的抒情模式。",
    "start": 100.4,
    "end": 106.64,
    "duration": 6.24
  },
  {
    "id": 26,
    "text": "穆旦追求现代诗的“智性化”。",
    "start": 106.64,
    "end": 108.8,
    "duration": 2.16
  },
  {
    "id": 27,
    "text": "他将时代苦难、自我怀疑与深层心理体验紧密熔铸在一起。",
    "start": 108.8,
    "end": 114.16,
    "duration": 5.36
  },
  {
    "id": 28,
    "text": "其艺术特质与智性追求主要体现在三个层面。",
    "start": 114.16,
    "end": 118.08,
    "duration": 3.92
  },
  {
    "id": 29,
    "text": "要点一：肉体知觉与形而上思辨的化合（《诗八首》）。",
    "start": 118.08,
    "end": 121.76,
    "duration": 3.68
  },
  {
    "id": 30,
    "text": "-论证推演逻辑：核心阐释穆旦著名的“把思想转化为感觉，",
    "start": 121.76,
    "end": 126.92,
    "duration": 5.16
  },
  {
    "id": 31,
    "text": "把感觉升华为思想”。",
    "start": 126.92,
    "end": 128.715,
    "duration": 1.795
  },
  {
    "id": 32,
    "text": "不能写成纯抽象哲学，而要结合《诗八首》的具体名句，",
    "start": 128.715,
    "end": 133.427,
    "duration": 4.712
  },
  {
    "id": 33,
    "text": "剖析言语制造的夏天与身体拥抱的悖论，",
    "start": 133.427,
    "end": 137.241,
    "duration": 3.814
  },
  {
    "id": 34,
    "text": "证明其知性张力。",
    "start": 137.241,
    "end": 138.812,
    "duration": 1.571
  },
  {
    "id": 35,
    "text": "具体表述到答题语句就是：第一，肉体痛感与抽象哲理思辨的深层并置。",
    "start": 138.812,
    "end": 145.656,
    "duration": 6.844
  },
  {
    "id": 36,
    "text": "穆旦倡导“把思想转化为感觉，把感觉升华为思想”。",
    "start": 145.656,
    "end": 150.056,
    "duration": 4.4
  },
  {
    "id": 37,
    "text": "他绝不作抽象空洞的概念说教，而是将复杂的哲学沉思落实于可触可感的肉身知觉。",
    "start": 150.056,
    "end": 157.176,
    "duration": 7.12
  },
  {
    "id": 38,
    "text": "在《诗八首》中，他探讨两性爱情与生存困境。",
    "start": 157.176,
    "end": 160.776,
    "duration": 3.6
  },
  {
    "id": 39,
    "text": "诗人写下“静静地，我们拥抱在用言语所能造的夏天里”。",
    "start": 161.016,
    "end": 166.456,
    "duration": 5.44
  },
  {
    "id": 40,
    "text": "诗句将肉体的亲昵拥抱，与语言符号筑起的虚妄防线严丝合缝地焊接在一起。",
    "start": 166.456,
    "end": 173.496,
    "duration": 7.04
  },
  {
    "id": 41,
    "text": "感官渴望与理性荒诞的剧烈撞击，构成了极具哲理厚度的智性张力。",
    "start": 173.496,
    "end": 179.016,
    "duration": 5.52
  },
  {
    "id": 42,
    "text": "第一，肉体痛感与抽象哲理思辨的深层并置。",
    "start": 179.016,
    "end": 182.936,
    "duration": 3.92
  },
  {
    "id": 43,
    "text": "穆旦倡导“把思想转化为感觉，把感觉升华为思想”。",
    "start": 183.176,
    "end": 188.296,
    "duration": 5.12
  },
  {
    "id": 44,
    "text": "他绝不作抽象空洞的概念说教，而是将复杂的哲学沉思落实于可触可感的肉身知觉。",
    "start": 188.296,
    "end": 196.056,
    "duration": 7.76
  },
  {
    "id": 45,
    "text": "在《诗八首》中，他探讨两性爱情与生存困境。",
    "start": 196.056,
    "end": 200.296,
    "duration": 4.24
  },
  {
    "id": 46,
    "text": "诗人写下“静静地，我们拥抱在用言语所能造的夏天里”。",
    "start": 200.296,
    "end": 205.096,
    "duration": 4.8
  },
  {
    "id": 47,
    "text": "诗句将肉体的亲昵拥抱，与语言符号筑起的虚妄防线严丝合缝地焊接在一起。",
    "start": 205.416,
    "end": 211.736,
    "duration": 6.32
  },
  {
    "id": 48,
    "text": "感官渴望与理性荒诞的剧烈撞击，构成了极具哲理厚度的智性张力。",
    "start": 211.736,
    "end": 217.176,
    "duration": 5.44
  },
  {
    "id": 49,
    "text": "要点二：知识分子反省机制与自我解剖（《隐现》）。",
    "start": 217.176,
    "end": 221.193,
    "duration": 4.017
  },
  {
    "id": 50,
    "text": "论证推演逻辑：分析穆旦思想维度的深度。",
    "start": 221.193,
    "end": 225.416,
    "duration": 4.223
  },
  {
    "id": 51,
    "text": "他不是高高在上的道德评判者，而是带着痛苦原罪感的反思者。",
    "start": 225.496,
    "end": 231.016,
    "duration": 5.52
  },
  {
    "id": 52,
    "text": "结合《隐现》，阐明其对现代知识分子软弱分裂的剖析。",
    "start": 231.016,
    "end": 235.896,
    "duration": 4.88
  },
  {
    "id": 53,
    "text": "具体表述到答题语句就是：第二，无情解剖知识分子的精神分裂与现代危机。",
    "start": 235.896,
    "end": 242.856,
    "duration": 6.96
  },
  {
    "id": 54,
    "text": "面对战乱与动荡的民族现实，穆旦拒绝浪漫主义的廉价欢呼。",
    "start": 242.856,
    "end": 247.656,
    "duration": 4.8
  },
  {
    "id": 55,
    "text": "他以冷酷的手术刀反躬自省，将自身作为受审对象。",
    "start": 247.976,
    "end": 252.296,
    "duration": 4.32
  },
  {
    "id": 56,
    "text": "在《隐现》中，他逼视知识分子在崇高理想与现实苟且之间的撕裂与软弱。",
    "start": 252.296,
    "end": 258.456,
    "duration": 6.16
  },
  {
    "id": 57,
    "text": "这种带着自我原罪感的沉重反思，表现出对现代人性幽微处的惊悚洞察。",
    "start": 258.456,
    "end": 264.536,
    "duration": 6.08
  },
  {
    "id": 58,
    "text": "诗歌由此获得了极为深沉的思想重量。",
    "start": 264.536,
    "end": 267.016,
    "duration": 2.48
  },
  {
    "id": 59,
    "text": "第二，无情解剖知识分子的精神分裂与现代危机。",
    "start": 267.392,
    "end": 272.112,
    "duration": 4.72
  },
  {
    "id": 60,
    "text": "面对战乱与动荡的民族现实，穆旦拒绝浪漫主义的廉价欢呼。",
    "start": 272.112,
    "end": 277.392,
    "duration": 5.28
  },
  {
    "id": 61,
    "text": "他以冷酷的手术刀反躬自省，将自身作为受审对象。",
    "start": 277.392,
    "end": 282.032,
    "duration": 4.64
  },
  {
    "id": 62,
    "text": "在《隐现》中，他逼视知识分子在崇高理想与现实苟且之间的撕裂与软弱。",
    "start": 282.032,
    "end": 287.472,
    "duration": 5.44
  },
  {
    "id": 63,
    "text": "这种带着自我原罪感的沉重反思，表现出对现代人性幽微处的惊悚洞察。",
    "start": 287.872,
    "end": 294.032,
    "duration": 6.16
  },
  {
    "id": 64,
    "text": "诗歌由此获得了极为深沉的思想重量。",
    "start": 294.032,
    "end": 296.912,
    "duration": 2.88
  },
  {
    "id": 65,
    "text": "要点三：语言形式与悖论意象（《赞美》）。",
    "start": 296.912,
    "end": 299.963,
    "duration": 3.051
  },
  {
    "id": 66,
    "text": "论证推演逻辑：落脚于语言修辞创新。",
    "start": 299.963,
    "end": 303.049,
    "duration": 3.086
  },
  {
    "id": 67,
    "text": "穆旦诗歌极具冲击力，源于悖论修辞与冷硬凝练的词语对立。",
    "start": 303.049,
    "end": 308.192,
    "duration": 5.143
  },
  {
    "id": 68,
    "text": "结合《赞美》对苦难与敬畏的交织，",
    "start": 308.272,
    "end": 311.152,
    "duration": 2.88
  },
  {
    "id": 69,
    "text": "证明其对现代汉语表现疆界的拓展。",
    "start": 311.152,
    "end": 314.272,
    "duration": 3.12
  },
  {
    "id": 70,
    "text": "具体表述到答题语句就是：第三，悖论反讽修辞与高度张力的现代意象网络。",
    "start": 314.272,
    "end": 321.552,
    "duration": 7.28
  },
  {
    "id": 71,
    "text": "穆旦彻底革新了现代汉语的诗歌表达。",
    "start": 321.552,
    "end": 324.432,
    "duration": 2.88
  },
  {
    "id": 72,
    "text": "他大量运用相互矛盾、冲突的词汇组合，",
    "start": 324.432,
    "end": 327.792,
    "duration": 3.36
  },
  {
    "id": 73,
    "text": "制造出动人心魄的意象对立。",
    "start": 327.792,
    "end": 330.112,
    "duration": 2.32
  },
  {
    "id": 74,
    "text": "在《赞美》中，他对民族受难历史的炽热礼赞，",
    "start": 330.432,
    "end": 334.112,
    "duration": 3.68
  },
  {
    "id": 75,
    "text": "与严峻残酷的荒凉现实相互碰撞。",
    "start": 334.112,
    "end": 337.232,
    "duration": 3.12
  },
  {
    "id": 76,
    "text": "语言冷硬、凝练而饱含重压。",
    "start": 337.232,
    "end": 340.272,
    "duration": 3.04
  },
  {
    "id": 77,
    "text": "他打破了古典诗歌和谐宁静的传统范式，",
    "start": 340.272,
    "end": 343.712,
    "duration": 3.44
  },
  {
    "id": 78,
    "text": "开辟了现代汉语容纳复杂现代经验的全新可能。",
    "start": 343.712,
    "end": 347.632,
    "duration": 3.92
  },
  {
    "id": 79,
    "text": "第三，悖论反讽修辞与高度张力的现代意象网络。",
    "start": 347.632,
    "end": 351.872,
    "duration": 4.24
  },
  {
    "id": 80,
    "text": "穆旦彻底革新了现代汉语的诗歌表达。",
    "start": 352.112,
    "end": 355.232,
    "duration": 3.12
  },
  {
    "id": 81,
    "text": "他大量运用相互矛盾、冲突的词汇组合，",
    "start": 355.232,
    "end": 358.592,
    "duration": 3.36
  },
  {
    "id": 82,
    "text": "制造出动人心魄的意象对立。",
    "start": 358.592,
    "end": 361.232,
    "duration": 2.64
  },
  {
    "id": 83,
    "text": "在《赞美》中，他对民族受难历史的炽热礼赞，",
    "start": 361.232,
    "end": 364.672,
    "duration": 3.44
  },
  {
    "id": 84,
    "text": "与严峻残酷的荒凉现实相互碰撞。",
    "start": 364.672,
    "end": 367.712,
    "duration": 3.04
  },
  {
    "id": 85,
    "text": "语言冷硬、凝练而饱含重压。",
    "start": 367.712,
    "end": 370.752,
    "duration": 3.04
  },
  {
    "id": 86,
    "text": "他打破了古典诗歌和谐宁静的传统范式，",
    "start": 370.752,
    "end": 374.112,
    "duration": 3.36
  },
  {
    "id": 87,
    "text": "开辟了现代汉语容纳复杂现代经验的全新可能。",
    "start": 374.112,
    "end": 377.552,
    "duration": 3.44
  },
  {
    "id": 88,
    "text": "总结升华段：历史高度总结。",
    "start": 377.952,
    "end": 380.512,
    "duration": 2.56
  },
  {
    "id": 89,
    "text": "论证推演逻辑：一句话总结穆旦在四十年代诗歌现代化中的最高水准，",
    "start": 380.512,
    "end": 386.112,
    "duration": 5.6
  },
  {
    "id": 90,
    "text": "强调其对当代汉语诗歌的长远启示。",
    "start": 386.112,
    "end": 388.992,
    "duration": 2.88
  },
  {
    "id": 91,
    "text": "具体表述到答题语句就是：穆旦的诗歌代表了四十年代中国新诗现代化的最高水准。",
    "start": 388.992,
    "end": 394.992,
    "duration": 6.0
  },
  {
    "id": 92,
    "text": "他所确立的智性美学范式，成为当代汉语诗歌走向现代成熟的永恒源泉。",
    "start": 395.232,
    "end": 401.532,
    "duration": 6.3
  },
  {
    "id": 93,
    "text": "穆旦的诗歌代表了四十年代中国新诗现代化的最高水准。",
    "start": 401.532,
    "end": 406.59,
    "duration": 5.058
  },
  {
    "id": 94,
    "text": "他所确立的智性美学范式，成为当代汉语诗歌走向现代成熟的永恒源泉。",
    "start": 406.59,
    "end": 412.912,
    "duration": 6.322
  }
]