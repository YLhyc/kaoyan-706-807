[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 3.12,
    "duration": 3.04
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 3.12,
    "end": 6.32,
    "duration": 3.2
  },
  {
    "id": 3,
    "text": "这道题考查中国现代长篇小说史诗标杆《子夜》。",
    "start": 6.32,
    "end": 10.88,
    "duration": 4.56
  },
  {
    "id": 4,
    "text": "在考场上，考生绝不能单纯复述公债炒作的情节，",
    "start": 10.88,
    "end": 15.28,
    "duration": 4.4
  },
  {
    "id": 5,
    "text": "而必须紧扣“吴孙甫悲剧形象的心理流变”与“全景式社会解剖学史诗建构”两大题眼。",
    "start": 15.28,
    "end": 22.32,
    "duration": 7.04
  },
  {
    "id": 6,
    "text": "核心在于回答：吴孙甫为何必然成为中国民族资产阶级实业救国破产的代名词，",
    "start": 22.56,
    "end": 29.2,
    "duration": 6.64
  },
  {
    "id": 7,
    "text": "以及茅盾如何通过网状结构展现半殖民地大都市全景。",
    "start": 29.2,
    "end": 34.16,
    "duration": 4.96
  },
  {
    "id": 8,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 34.16,
    "end": 37.36,
    "duration": 3.2
  },
  {
    "id": 9,
    "text": "答题必须确立“知人论世、经济与艺术融合”的三维流线。",
    "start": 37.36,
    "end": 41.92,
    "duration": 4.56
  },
  {
    "id": 10,
    "text": "首先界定《子夜》回答中国社会性质论战的宏伟地位，",
    "start": 42.24,
    "end": 46.24,
    "duration": 4.0
  },
  {
    "id": 11,
    "text": "其次深入吴孙甫从“雄心勃勃的福特”到暴怒崩溃的心灵蜕变，",
    "start": 46.24,
    "end": 51.68,
    "duration": 5.44
  },
  {
    "id": 12,
    "text": "再次运用政治经济学逻辑解剖买办资本与工人罢工的双重绞杀，",
    "start": 51.68,
    "end": 56.88,
    "duration": 5.2
  },
  {
    "id": 13,
    "text": "最后精细剖析三条线索并进的全景网状结构与吴老太爷入沪名场面。",
    "start": 56.88,
    "end": 62.56,
    "duration": 5.68
  },
  {
    "id": 14,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 62.88,
    "end": 66.0,
    "duration": 3.12
  },
  {
    "id": 15,
    "text": "全题分为四个核心论述维度：第一维度：界定《子夜》作为现代全景式现实主义史诗第一部巨著的文学史坐标；",
    "start": 66.0,
    "end": 74.88,
    "duration": 8.88
  },
  {
    "id": 16,
    "text": "第二维度：深入剖析吴孙甫作为民族资产阶级典型的铁腕意志与走向全面崩溃的心理演变；",
    "start": 74.88,
    "end": 82.4,
    "duration": 7.52
  },
  {
    "id": 17,
    "text": "-第三维度：深刻论述半殖民地半封建中国帝国主义买办资本与阶级矛盾绞杀民族实业的必然宿命；",
    "start": 82.64,
    "end": 91.525,
    "duration": 8.885
  },
  {
    "id": 18,
    "text": "-第四维度：精细剖析多线并进的“社会解剖学”网状结构与吴老太爷暴毙的象征艺术；",
    "start": 91.525,
    "end": 98.892,
    "duration": 7.367
  },
  {
    "id": 19,
    "text": "-第五维度：宏观总结作品为民族资产阶级谱写历史挽歌的经典定论。",
    "start": 98.892,
    "end": 104.96,
    "duration": 6.068
  },
  {
    "id": 20,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 105.12,
    "end": 109.12,
    "duration": 4.0
  },
  {
    "id": 21,
    "text": "全题逻辑严密咬合：第一步先确立史诗巨制地位。",
    "start": 109.12,
    "end": 114.0,
    "duration": 4.88
  },
  {
    "id": 22,
    "text": "第二步剖析史诗核心人物吴孙甫的性格与搏杀。",
    "start": 114.0,
    "end": 118.08,
    "duration": 4.08
  },
  {
    "id": 23,
    "text": "第三步深入剖析驱动这一搏杀失败的社会政治经济客观机制。",
    "start": 118.08,
    "end": 123.68,
    "duration": 5.6
  },
  {
    "id": 24,
    "text": "第四步剖析承载这种复杂机制的艺术形式即网状全景叙事。",
    "start": 123.68,
    "end": 128.96,
    "duration": 5.28
  },
  {
    "id": 25,
    "text": "第五步完成宏观历史论证闭环。",
    "start": 129.2,
    "end": 131.84,
    "duration": 2.64
  },
  {
    "id": 26,
    "text": "二、各板块逐句咬合演练。",
    "start": 131.84,
    "end": 134.16,
    "duration": 2.32
  },
  {
    "id": 27,
    "text": "一、开头破题段内部咬合。",
    "start": 134.16,
    "end": 136.4,
    "duration": 2.24
  },
  {
    "id": 28,
    "text": "本段旨在开门见山确立现实主义巨制第一峰的立论基石。",
    "start": 136.4,
    "end": 141.04,
    "duration": 4.64
  },
  {
    "id": 29,
    "text": "首句直切经典地位，次句交代社会解剖学笔法与回答社会性质论战。",
    "start": 141.04,
    "end": 146.24,
    "duration": 5.2
  },
  {
    "id": 30,
    "text": "首先，首句必须直接亮出该作在现代长篇小说史上的绝对标杆地位，",
    "start": 146.608,
    "end": 152.208,
    "duration": 5.6
  },
  {
    "id": 31,
    "text": "具体表述到答题语句就是：茅盾于一九三三年出版的长篇小说，",
    "start": 152.208,
    "end": 157.058,
    "duration": 4.85
  },
  {
    "id": 32,
    "text": "子夜，是中国现代文学史上第一部真正具备宏大全景史诗品格的现实主义巨著。",
    "start": 157.058,
    "end": 163.328,
    "duration": 6.27
  },
  {
    "id": 33,
    "text": "有了经典定性之后，次句必须迅速说明其思想深度与艺术范式，",
    "start": 163.328,
    "end": 168.268,
    "duration": 4.94
  },
  {
    "id": 34,
    "text": "具体表述到答题语句就是：茅盾以革命现实主义的深刻洞察力，",
    "start": 168.268,
    "end": 173.208,
    "duration": 4.94
  },
  {
    "id": 35,
    "text": "通过民族资本家吴孙甫在一九三零年夏上海滩经济搏杀中的最终溃败，",
    "start": 173.208,
    "end": 178.908,
    "duration": 5.7
  },
  {
    "id": 36,
    "text": "深刻回答了关于中国社会性质的大论战，",
    "start": 178.908,
    "end": 182.138,
    "duration": 3.23
  },
  {
    "id": 37,
    "text": "以高度自觉的“社会解剖学”笔法树立了中国现代长篇小说史上的巍峨丰碑。",
    "start": 182.138,
    "end": 188.028,
    "duration": 5.89
  },
  {
    "id": 38,
    "text": "这句话直接铺陈出思想与艺术两翼齐飞的答题骨架。",
    "start": 188.028,
    "end": 192.208,
    "duration": 4.18
  },
  {
    "id": 39,
    "text": "茅盾于一九三三年出版的长篇小说《子夜》，",
    "start": 192.288,
    "end": 195.648,
    "duration": 3.36
  },
  {
    "id": 40,
    "text": "是中国现代文学史上第一部真正具备宏大全景史诗品格的现实主义巨著。",
    "start": 195.648,
    "end": 201.808,
    "duration": 6.16
  },
  {
    "id": 41,
    "text": "茅盾以革命现实主义的深刻洞察力，",
    "start": 201.808,
    "end": 204.528,
    "duration": 2.72
  },
  {
    "id": 42,
    "text": "通过民族资本家吴孙甫在一九三零年夏上海滩经济搏杀中的最终溃败，",
    "start": 204.528,
    "end": 210.288,
    "duration": 5.76
  },
  {
    "id": 43,
    "text": "深刻回答了关于中国社会性质的大论战，",
    "start": 210.288,
    "end": 213.168,
    "duration": 2.88
  },
  {
    "id": 44,
    "text": "以高度自觉的“社会解剖学”笔法树立了中国现代长篇小说史上的巍峨丰碑。",
    "start": 213.168,
    "end": 218.688,
    "duration": 5.52
  },
  {
    "id": 45,
    "text": "二、第一维度：吴孙甫雄心与崩溃心理轨迹内部咬合。",
    "start": 219.008,
    "end": 223.968,
    "duration": 4.96
  },
  {
    "id": 46,
    "text": "本段任务是深入剖析吴孙甫作为民族工业巨头的铁腕意志、",
    "start": 223.968,
    "end": 228.528,
    "duration": 4.56
  },
  {
    "id": 47,
    "text": "组建益中公司的雄心，以及最终心理崩溃的流变。",
    "start": 228.528,
    "end": 232.688,
    "duration": 4.16
  },
  {
    "id": 48,
    "text": "首先，段首给出结论先行的分论点，",
    "start": 232.688,
    "end": 235.728,
    "duration": 3.04
  },
  {
    "id": 49,
    "text": "具体表述到答题语句就是：第一，在形象塑造艺术上，",
    "start": 235.728,
    "end": 240.208,
    "duration": 4.48
  },
  {
    "id": 50,
    "text": "作品成功塑造了吴孙甫这一兼具雄图霸气与致命软弱的中国民族资产阶级典型。",
    "start": 240.208,
    "end": 246.928,
    "duration": 6.72
  },
  {
    "id": 51,
    "text": "-随后，剖析其追求实业救国的雄心与现代化眼光，",
    "start": 247.168,
    "end": 251.06,
    "duration": 3.892
  },
  {
    "id": 52,
    "text": "具体表述到答题语句就是：吴孙甫绝非平庸猥琐的商人，",
    "start": 251.06,
    "end": 255.535,
    "duration": 4.475
  },
  {
    "id": 53,
    "text": "而是一位具有现代工业眼光、精明果断且具有“机械化实业救国”野心的民族资本巨头。，",
    "start": 255.535,
    "end": 262.345,
    "duration": 6.81
  },
  {
    "id": 54,
    "text": "调取其自比福特与兼并八厂的细节：他傲视上海滩的封建官僚与洋行买办，",
    "start": 262.345,
    "end": 268.377,
    "duration": 6.032
  },
  {
    "id": 55,
    "text": "自比为“中国的亨利•福特”，试图通过兼并八家中小日用工厂组建益中信托公司，",
    "start": 268.377,
    "end": 274.604,
    "duration": 6.227
  },
  {
    "id": 56,
    "text": "建立起独立的现代民族工业帝国。",
    "start": 274.604,
    "end": 277.328,
    "duration": 2.724
  },
  {
    "id": 57,
    "text": "-紧接着，深入剖析其性格在残酷绞杀中的异化扭曲：在性格呈现上，",
    "start": 277.392,
    "end": 283.237,
    "duration": 5.845
  },
  {
    "id": 58,
    "text": "老辣坚毅的铁腕意志与内心的焦虑恐慌构成其复杂心理机制。",
    "start": 283.237,
    "end": 288.865,
    "duration": 5.628
  },
  {
    "id": 59,
    "text": "面对外资买办的金融围剿与工人罢工风潮，",
    "start": 288.865,
    "end": 292.761,
    "duration": 3.896
  },
  {
    "id": 60,
    "text": "吴孙甫的性格从最初的意气风发、杀伐决断，",
    "start": 292.761,
    "end": 296.658,
    "duration": 3.897
  },
  {
    "id": 61,
    "text": "逐步蜕变为刚愎自用、多疑焦躁。",
    "start": 296.658,
    "end": 299.472,
    "duration": 2.814
  },
  {
    "id": 62,
    "text": "-最后，调取公债决战前夜家庭暴怒与杜竹斋背叛的末路细节，",
    "start": 299.472,
    "end": 304.916,
    "duration": 5.444
  },
  {
    "id": 63,
    "text": "完成心理蜕变闭环：在公债市场决战的最后关头，",
    "start": 304.916,
    "end": 309.272,
    "duration": 4.356
  },
  {
    "id": 64,
    "text": "他甚至沦落到在家里殴打妻子与侮辱婢女以发泄虚弱，",
    "start": 309.272,
    "end": 314.281,
    "duration": 5.009
  },
  {
    "id": 65,
    "text": "最终在盟友杜竹斋的致命背叛下全面崩盘，",
    "start": 314.281,
    "end": 318.201,
    "duration": 3.92
  },
  {
    "id": 66,
    "text": "生动再现了一个悲剧英雄走向末路的心理蜕变过程。",
    "start": 318.201,
    "end": 322.992,
    "duration": 4.791
  },
  {
    "id": 67,
    "text": "第一，在形象塑造艺术上，作品成功塑造了吴孙甫这一兼具雄图霸气与致命软弱的中国民族资产阶级典型。",
    "start": 323.072,
    "end": 333.072,
    "duration": 10.0
  },
  {
    "id": 68,
    "text": "吴孙甫绝非平庸猥琐的商人，而是一位具有现代工业眼光、",
    "start": 333.072,
    "end": 337.952,
    "duration": 4.88
  },
  {
    "id": 69,
    "text": "精明果断且具有“机械化实业救国”野心的民族资本巨头。",
    "start": 337.952,
    "end": 342.912,
    "duration": 4.96
  },
  {
    "id": 70,
    "text": "他傲视上海滩的封建官僚与洋行买办，",
    "start": 342.912,
    "end": 345.792,
    "duration": 2.88
  },
  {
    "id": 71,
    "text": "自比为“中国的亨利•福特”，试图通过兼并八家中小日用工厂组建益中信托公司，",
    "start": 345.792,
    "end": 352.592,
    "duration": 6.8
  },
  {
    "id": 72,
    "text": "建立起独立的现代民族工业帝国。",
    "start": 352.592,
    "end": 354.992,
    "duration": 2.4
  },
  {
    "id": 73,
    "text": "在性格呈现上，老辣坚毅的铁腕意志与内心的焦虑恐慌构成其复杂心理机制。",
    "start": 355.232,
    "end": 362.032,
    "duration": 6.8
  },
  {
    "id": 74,
    "text": "面对外资买办的金融围剿与工人罢工风潮，",
    "start": 362.032,
    "end": 365.792,
    "duration": 3.76
  },
  {
    "id": 75,
    "text": "吴孙甫的性格从最初的意气风发、杀伐决断，",
    "start": 365.792,
    "end": 369.632,
    "duration": 3.84
  },
  {
    "id": 76,
    "text": "逐步蜕变为刚愎自用、多疑焦躁。",
    "start": 369.632,
    "end": 372.512,
    "duration": 2.88
  },
  {
    "id": 77,
    "text": "在公债市场决战的最后关头，他甚至沦落到在家里殴打妻子与侮辱婢女以发泄虚弱，",
    "start": 372.512,
    "end": 379.792,
    "duration": 7.28
  },
  {
    "id": 78,
    "text": "最终在盟友杜竹斋的致命背叛下全面崩盘，",
    "start": 379.792,
    "end": 383.632,
    "duration": 3.84
  },
  {
    "id": 79,
    "text": "生动再现了一个悲剧英雄走向末路的心理蜕变过程。",
    "start": 383.632,
    "end": 387.792,
    "duration": 4.16
  },
  {
    "id": 80,
    "text": "三、第二维度：悲剧生成的社会经济机制内部咬合。",
    "start": 388.112,
    "end": 392.672,
    "duration": 4.56
  },
  {
    "id": 81,
    "text": "本段任务是从买办资本金融碾压与工人阶级对抗两方面，",
    "start": 392.672,
    "end": 397.312,
    "duration": 4.64
  },
  {
    "id": 82,
    "text": "深刻解剖民族实业破产的社会政治经济宿命。",
    "start": 397.312,
    "end": 401.392,
    "duration": 4.08
  },
  {
    "id": 83,
    "text": "首先，段首给出统领分论点，具体表述到答题语句就是：第二，",
    "start": 401.392,
    "end": 406.752,
    "duration": 5.36
  },
  {
    "id": 84,
    "text": "在悲剧意蕴生成机制上，吴孙甫的覆灭深刻揭示了在半殖民地半封建旧中国，",
    "start": 406.752,
    "end": 413.312,
    "duration": 6.56
  },
  {
    "id": 85,
    "text": "民族资本主义“实业救国”道路必遭破产的历史宿命。",
    "start": 413.312,
    "end": 417.232,
    "duration": 3.92
  },
  {
    "id": 86,
    "text": "-随后，点出双重社会绞杀网的分析框架：茅盾以深厚的政治经济学素养，",
    "start": 417.392,
    "end": 423.218,
    "duration": 5.826
  },
  {
    "id": 87,
    "text": "剖析了扼杀吴孙甫的双重社会绞杀网。",
    "start": 423.218,
    "end": 426.432,
    "duration": 3.214
  },
  {
    "id": 88,
    "text": "-紧接着，剖析第一重外部帝国主义买办资本赵伯韬的绞杀：一方面，",
    "start": 426.48,
    "end": 432.069,
    "duration": 5.589
  },
  {
    "id": 89,
    "text": "在宏观外部经济上，帝国主义直接扶植的金融买办资本掌握着绝对的资金与政治特权。",
    "start": 432.069,
    "end": 439.522,
    "duration": 7.453
  },
  {
    "id": 90,
    "text": "赵伯韬背后有美帝国主义势力与国民党反动政权的强力庇护，",
    "start": 439.522,
    "end": 444.905,
    "duration": 5.383
  },
  {
    "id": 91,
    "text": "操控着公债内幕行情，使民族实业在投机狂潮面前不堪一击。",
    "start": 444.905,
    "end": 450.08,
    "duration": 5.175
  },
  {
    "id": 92,
    "text": "-随后，剖析第二重内部劳资矛盾激化的绞杀：另一方面，",
    "start": 450.08,
    "end": 454.444,
    "duration": 4.364
  },
  {
    "id": 93,
    "text": "在微观企业内部，身处双重压迫下的民族实业家为了转嫁危机，",
    "start": 454.444,
    "end": 459.601,
    "duration": 5.157
  },
  {
    "id": 94,
    "text": "不得不对工人阶级施加更加残酷的减薪压榨，",
    "start": 459.601,
    "end": 463.37,
    "duration": 3.769
  },
  {
    "id": 95,
    "text": "从而激起益中丝厂工人的猛烈同盟罢工。",
    "start": 463.37,
    "end": 466.742,
    "duration": 3.372
  },
  {
    "id": 96,
    "text": "最后，收束提炼民族资产阶级的历史宿命定论：内外交困的双重围剿，",
    "start": 466.742,
    "end": 472.297,
    "duration": 5.555
  },
  {
    "id": 97,
    "text": "注定了民族资产阶级既无法抗衡强大的帝国主义买办势力，",
    "start": 472.297,
    "end": 477.256,
    "duration": 4.959
  },
  {
    "id": 98,
    "text": "又无法获得无产阶级底层民众的同情，",
    "start": 477.256,
    "end": 480.429,
    "duration": 3.173
  },
  {
    "id": 99,
    "text": "其自立自强的实业神话必然化为历史泡影。",
    "start": 480.429,
    "end": 484.0,
    "duration": 3.571
  },
  {
    "id": 100,
    "text": "第二，在悲剧意蕴生成机制上，吴孙甫的覆灭深刻揭示了在半殖民地半封建旧中国，",
    "start": 484.08,
    "end": 491.28,
    "duration": 7.2
  },
  {
    "id": 101,
    "text": "民族资本主义“实业救国”道路必遭破产的历史宿命。",
    "start": 491.28,
    "end": 495.6,
    "duration": 4.32
  },
  {
    "id": 102,
    "text": "茅盾以深厚的政治经济学素养，剖析了扼杀吴孙甫的双重社会绞杀网。",
    "start": 495.6,
    "end": 501.44,
    "duration": 5.84
  },
  {
    "id": 103,
    "text": "一方面，在宏观外部经济上，帝国主义直接扶植的金融买办资本掌握着绝对的资金与政治特权。",
    "start": 501.44,
    "end": 509.28,
    "duration": 7.84
  },
  {
    "id": 104,
    "text": "赵伯韬背后有美帝国主义势力与国民党反动政权的强力庇护，",
    "start": 509.52,
    "end": 514.96,
    "duration": 5.44
  },
  {
    "id": 105,
    "text": "操控着公债内幕行情，使民族实业在投机狂潮面前不堪一击。",
    "start": 514.96,
    "end": 520.64,
    "duration": 5.68
  },
  {
    "id": 106,
    "text": "另一方面，在微观企业内部，身处双重压迫下的民族实业家为了转嫁危机，",
    "start": 520.64,
    "end": 527.12,
    "duration": 6.48
  },
  {
    "id": 107,
    "text": "不得不对工人阶级施加更加残酷的减薪压榨，",
    "start": 527.12,
    "end": 531.04,
    "duration": 3.92
  },
  {
    "id": 108,
    "text": "从而激起益中丝厂工人的猛烈同盟罢工。",
    "start": 531.04,
    "end": 534.16,
    "duration": 3.12
  },
  {
    "id": 109,
    "text": "内外交困的双重围剿，注定了民族资产阶级既无法抗衡强大的帝国主义买办势力，",
    "start": 534.4,
    "end": 540.96,
    "duration": 6.56
  },
  {
    "id": 110,
    "text": "又无法获得无产阶级底层民众的同情，",
    "start": 540.96,
    "end": 543.92,
    "duration": 2.96
  },
  {
    "id": 111,
    "text": "其自立自强的实业神话必然化为历史泡影。",
    "start": 543.92,
    "end": 547.68,
    "duration": 3.76
  },
  {
    "id": 112,
    "text": "四、第三维度：全景式网状史诗结构与象征艺术内部咬合。",
    "start": 547.68,
    "end": 553.12,
    "duration": 5.44
  },
  {
    "id": 113,
    "text": "本段任务是落脚于文学形式本体，剖析多线并进的社会解剖学网状结构与吴老太爷入沪暴毙的绝妙象征。",
    "start": 553.44,
    "end": 562.4,
    "duration": 8.96
  },
  {
    "id": 114,
    "text": "首先，段首给出统领分论点，具体表述到答题语句就是：第三，",
    "start": 562.4,
    "end": 567.6,
    "duration": 5.2
  },
  {
    "id": 115,
    "text": "在艺术表现机制上，作品构建了宏大繁复、",
    "start": 567.6,
    "end": 570.8,
    "duration": 3.2
  },
  {
    "id": 116,
    "text": "纵横交织的全景式“社会剖析”史诗结构。",
    "start": 570.8,
    "end": 573.68,
    "duration": 2.88
  },
  {
    "id": 117,
    "text": "-随后，说明网状多线叙事对传统线性小说的突破：《子夜》彻底突破了中国传统小说的单一线性视角，",
    "start": 573.888,
    "end": 581.817,
    "duration": 7.929
  },
  {
    "id": 118,
    "text": "开创了多线并进的网状叙事空间。",
    "start": 581.817,
    "end": 584.592,
    "duration": 2.775
  },
  {
    "id": 119,
    "text": "紧接着，梳理以吴孙甫为核心的三大交织社会线索：全书以吴孙甫的实业与金融斗争为核心轴心，",
    "start": 584.592,
    "end": 592.521,
    "duration": 7.929
  },
  {
    "id": 120,
    "text": "同时平行铺展了三条壮阔的社会线索：一是以赵伯韬为代表的买办金融投机狂潮，",
    "start": 592.521,
    "end": 599.26,
    "duration": 6.739
  },
  {
    "id": 121,
    "text": "二是以玛琪、林佩瑶为代表的都市资产阶级腐朽享乐生活，",
    "start": 599.26,
    "end": 604.018,
    "duration": 4.758
  },
  {
    "id": 122,
    "text": "三是以双桥镇农民暴动与益中丝厂工人大罢工为代表的革命浪潮。",
    "start": 604.018,
    "end": 609.568,
    "duration": 5.55
  },
  {
    "id": 123,
    "text": "-最后，调取第一章吴老太爷暴毙的经典名场面展开象征深读：开篇第一章吴老太爷自乡下迁入上海暴毙的名场面，",
    "start": 609.568,
    "end": 619.212,
    "duration": 9.644
  },
  {
    "id": 124,
    "text": "以其紧握《太上感应篇》面对霓虹灯的死相，",
    "start": 619.212,
    "end": 622.7,
    "duration": 3.488
  },
  {
    "id": 125,
    "text": "高度象征了封建宗法僵尸在现代资本主义畸形大都市面前的彻底崩溃，",
    "start": 622.7,
    "end": 628.855,
    "duration": 6.155
  },
  {
    "id": 126,
    "text": "展现出宏阔深邃的史诗营构手笔。",
    "start": 628.855,
    "end": 631.728,
    "duration": 2.873
  },
  {
    "id": 127,
    "text": "第三，在艺术表现机制上，作品构建了宏大繁复、",
    "start": 631.808,
    "end": 635.888,
    "duration": 4.08
  },
  {
    "id": 128,
    "text": "纵横交织的全景式“社会剖析”史诗结构。",
    "start": 635.888,
    "end": 639.728,
    "duration": 3.84
  },
  {
    "id": 129,
    "text": "《子夜》彻底突破了中国传统小说的单一线性视角，",
    "start": 639.728,
    "end": 643.648,
    "duration": 3.92
  },
  {
    "id": 130,
    "text": "开创了多线并进的网状叙事空间。",
    "start": 643.648,
    "end": 646.368,
    "duration": 2.72
  },
  {
    "id": 131,
    "text": "全书以吴孙甫的实业与金融斗争为核心轴心，",
    "start": 646.368,
    "end": 650.208,
    "duration": 3.84
  },
  {
    "id": 132,
    "text": "同时平行铺展了三条壮阔的社会线索：一是以赵伯韬为代表的买办金融投机狂潮，",
    "start": 650.208,
    "end": 656.848,
    "duration": 6.64
  },
  {
    "id": 133,
    "text": "二是以玛琪、林佩瑶为代表的都市资产阶级腐朽享乐生活，",
    "start": 656.848,
    "end": 661.568,
    "duration": 4.72
  },
  {
    "id": 134,
    "text": "三是以双桥镇农民暴动与益中丝厂工人大罢工为代表的革命浪潮。",
    "start": 661.568,
    "end": 666.768,
    "duration": 5.2
  },
  {
    "id": 135,
    "text": "开篇第一章吴老太爷自乡下迁入上海暴毙的名场面，",
    "start": 667.088,
    "end": 671.488,
    "duration": 4.4
  },
  {
    "id": 136,
    "text": "以其紧握《太上感应篇》面对霓虹灯的死相，",
    "start": 671.488,
    "end": 675.008,
    "duration": 3.52
  },
  {
    "id": 137,
    "text": "高度象征了封建宗法僵尸在现代资本主义畸形大都市面前的彻底崩溃，",
    "start": 675.008,
    "end": 680.768,
    "duration": 5.76
  },
  {
    "id": 138,
    "text": "展现出宏阔深邃的史诗营构手笔。",
    "start": 680.768,
    "end": 683.728,
    "duration": 2.96
  },
  {
    "id": 139,
    "text": "五、结尾收束升华段内部咬合。",
    "start": 683.728,
    "end": 686.448,
    "duration": 2.72
  },
  {
    "id": 140,
    "text": "本段承担全篇论证成果的系统提炼与历史定位，",
    "start": 686.768,
    "end": 691.088,
    "duration": 4.32
  },
  {
    "id": 141,
    "text": "收束在长篇小说成熟标杆上。",
    "start": 691.088,
    "end": 693.648,
    "duration": 2.56
  },
  {
    "id": 142,
    "text": "首先，全面回收民族资产阶级时代挽歌的结论，",
    "start": 693.648,
    "end": 697.408,
    "duration": 3.76
  },
  {
    "id": 143,
    "text": "具体表述到答题语句就是：综上所述，",
    "start": 697.408,
    "end": 700.368,
    "duration": 2.96
  },
  {
    "id": 144,
    "text": "茅盾《子夜》通过吴孙甫实业帝国的兴衰崩塌，",
    "start": 700.368,
    "end": 703.968,
    "duration": 3.6
  },
  {
    "id": 145,
    "text": "为近代中国民族资产阶级的历史宿命绘制了雄浑沉痛的时代挽歌。",
    "start": 703.968,
    "end": 709.168,
    "duration": 5.2
  },
  {
    "id": 146,
    "text": "-紧接着，总结其理性解剖与时代容量对长篇小说的奠基意义，",
    "start": 709.464,
    "end": 714.279,
    "duration": 4.815
  },
  {
    "id": 147,
    "text": "具体表述到答题语句就是：它以严谨的理性解剖、",
    "start": 714.279,
    "end": 718.132,
    "duration": 3.853
  },
  {
    "id": 148,
    "text": "宏阔的时代容量与立体的人物塑造，",
    "start": 718.132,
    "end": 721.021,
    "duration": 2.889
  },
  {
    "id": 149,
    "text": "奠定了中国现代长篇小说走向成熟的坚实标杆。",
    "start": 721.021,
    "end": 724.873,
    "duration": 3.852
  },
  {
    "id": 150,
    "text": "综上所述，茅盾《子夜》通过吴孙甫实业帝国的兴衰崩塌，",
    "start": 724.873,
    "end": 729.111,
    "duration": 4.238
  },
  {
    "id": 151,
    "text": "为近代中国民族资产阶级的历史宿命绘制了雄浑沉痛的时代挽歌。",
    "start": 729.111,
    "end": 734.504,
    "duration": 5.393
  },
  {
    "id": 152,
    "text": "它以严谨的理性解剖、宏阔的时代容量与立体的人物塑造，",
    "start": 734.584,
    "end": 739.704,
    "duration": 5.12
  },
  {
    "id": 153,
    "text": "奠定了中国现代长篇小说走向成熟的坚实标杆。",
    "start": 739.704,
    "end": 743.544,
    "duration": 3.84
  }
]