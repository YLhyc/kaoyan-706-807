[
  {
    "id": 1,
    "start": 0.08,
    "end": 4.32,
    "text": "艾青是中国现代新诗发展史上矗立的一座巍峨丰碑，"
  },
  {
    "id": 2,
    "start": 4.32,
    "end": 8.72,
    "text": "被誉为“吹号者”与真正属于人民的伟大抒情诗人。"
  },
  {
    "id": 3,
    "start": 8.72,
    "end": 12.8,
    "text": "艾青以其敏锐的时代触觉与炽热的赤子之心，"
  },
  {
    "id": 4,
    "start": 12.8,
    "end": 17.44,
    "text": "通过贯穿创作始终的“土地”与“太阳”两大核心意象，"
  },
  {
    "id": 5,
    "start": 17.44,
    "end": 22.96,
    "text": "将现代知识分子的个体生命彻底融入受难民族的解放洪流之中，"
  },
  {
    "id": 6,
    "start": 22.96,
    "end": 28.24,
    "text": "开创了现代自由新诗沉雄质朴、博大深沉的全新美学境界。"
  },
  {
    "id": 7,
    "start": 28.56,
    "end": 36.48,
    "text": "第一，在核心意象系统上，艾青营构了“土地”与“太阳”相互对应又辩证统一的象征图谱，"
  },
  {
    "id": 8,
    "start": 36.48,
    "end": 38.88,
    "text": "形成了震撼人心的审美张力。"
  },
  {
    "id": 9,
    "start": 38.88,
    "end": 43.2,
    "text": "“土地”是艾青诗歌中最厚重、最深沉的基底意象。"
  },
  {
    "id": 10,
    "start": 43.2,
    "end": 47.6,
    "text": "在诗人笔下，土地不仅是祖先生息繁衍的物理疆域，"
  },
  {
    "id": 11,
    "start": 47.6,
    "end": 52.08,
    "text": "更是饱受外敌践踏、内乱摧残的苦难民族之生动写照。"
  },
  {
    "id": 12,
    "start": 52.4,
    "end": 56.0,
    "text": "在抗战爆发时期的名作《我爱这土地》中，"
  },
  {
    "id": 13,
    "start": 56.0,
    "end": 61.36,
    "text": "诗人借一只嘶哑歌唱的鸟的意象，高吟“假如我是一只鸟，"
  },
  {
    "id": 14,
    "start": 61.36,
    "end": 66.16,
    "text": "我也应该用嘶哑的喉龙歌唱：这被暴风雨所打击着的土地”，"
  },
  {
    "id": 15,
    "start": 66.16,
    "end": 71.2,
    "text": "将对大地的深情与对民族危亡的肉体痛感紧密相连。"
  },
  {
    "id": 16,
    "start": 71.2,
    "end": 74.48,
    "text": "其成名作《大堰河，我的保姆》中，"
  },
  {
    "id": 17,
    "start": 74.48,
    "end": 78.4,
    "text": "更是将土地的母性与底层保姆大堰河的勤劳、"
  },
  {
    "id": 18,
    "start": 78.4,
    "end": 83.52,
    "text": "屈辱与牺牲熔铸一炉，饱含着对底层劳动人民的无限眷恋。"
  },
  {
    "id": 19,
    "start": 83.68,
    "end": 89.44,
    "text": "而“太阳”（以及火炬、黎明）则是与“土地”相生相依的彼岸意象，"
  },
  {
    "id": 20,
    "start": 89.44,
    "end": 94.32,
    "text": "象征着对光明、自由、真理与民族新生的炽烈渴望。"
  },
  {
    "id": 21,
    "start": 94.32,
    "end": 97.44,
    "text": "在长诗《向太阳》与《黎明的通知》中，"
  },
  {
    "id": 22,
    "start": 97.44,
    "end": 102.4,
    "text": "诗人以极其明朗亢奋的语调，呼唤太阳驱散古老土地上的阴霾，"
  },
  {
    "id": 23,
    "start": 102.4,
    "end": 106.32,
    "text": "形成了苦难与光明交相辉映的宏大艺术格局。"
  },
  {
    "id": 24,
    "start": 106.704,
    "end": 111.984,
    "text": "第二，在情感品格机制上，艾青诗歌充溢着一种博大深沉、"
  },
  {
    "id": 25,
    "start": 111.984,
    "end": 116.544,
    "text": "同情受难人民的“忧郁”情思，展现出崇高的历史担当。"
  },
  {
    "id": 26,
    "start": 116.544,
    "end": 120.384,
    "text": "艾青曾明确指出“忧郁是我的诗的底色”。"
  },
  {
    "id": 27,
    "start": 120.384,
    "end": 124.144,
    "text": "这种忧郁绝非早期浪漫派诗人顾影自怜、"
  },
  {
    "id": 28,
    "start": 124.144,
    "end": 131.664,
    "text": "颓唐感伤的小资产阶级情绪，而是源自对祖国山河破碎与底层劳苦大众悲惨境遇的感同身受。"
  },
  {
    "id": 29,
    "start": 132.064,
    "end": 135.264,
    "text": "在《北方》中，诗人目睹荒凉漫漫的原野、"
  },
  {
    "id": 30,
    "start": 135.264,
    "end": 139.024,
    "text": "贫瘠的村落与被饥紧寒冷折磨的北方人民，"
  },
  {
    "id": 31,
    "start": 139.024,
    "end": 141.184,
    "text": "发出了撕心裂肺的叹息。"
  },
  {
    "id": 32,
    "start": 141.184,
    "end": 145.744,
    "text": "而《我爱这土地》结笔处的千古名句“为什么我的眼里常含泪水？"
  },
  {
    "id": 33,
    "start": 145.744,
    "end": 152.224,
    "text": "因为我对这土地爱得深沉”，以极其质朴的语言将这种忧郁的情感机制推向极境，"
  },
  {
    "id": 34,
    "start": 152.224,
    "end": 158.304,
    "text": "展现出中国知识分子面对民族浩劫时甘愿奉献全副身心的崇高牺牲精神。"
  },
  {
    "id": 35,
    "start": 158.464,
    "end": 167.664,
    "text": "第三，在文体建构与诗体艺术上，艾青彻底打破了旧体格律与早期新月派“戴着镣靠跳舞”的形式束缚，"
  },
  {
    "id": 36,
    "start": 167.664,
    "end": 172.944,
    "text": "创造了散文化、口语化与绘画美高度融合的自由诗体范式。"
  },
  {
    "id": 37,
    "start": 172.944,
    "end": 176.704,
    "text": "艾青主张诗歌应当“不求外在形式的齐整，"
  },
  {
    "id": 38,
    "start": 176.704,
    "end": 178.464,
    "text": "而求内在情绪的律动”。"
  },
  {
    "id": 39,
    "start": 178.784,
    "end": 183.024,
    "text": "他的诗行长短错落，随思想感情的起伏自然舒展，"
  },
  {
    "id": 40,
    "start": 183.024,
    "end": 185.984,
    "text": "大量吸收洗练清新的现代日常口语，"
  },
  {
    "id": 41,
    "start": 185.984,
    "end": 188.144,
    "text": "摒弃了一切浮华雕饰。"
  },
  {
    "id": 42,
    "start": 188.144,
    "end": 191.424,
    "text": "同时，由于艾青早年在法国专修绘画，"
  },
  {
    "id": 43,
    "start": 191.424,
    "end": 194.384,
    "text": "其诗歌具有强烈的造型感与色彩美。"
  },
  {
    "id": 44,
    "start": 194.384,
    "end": 197.904,
    "text": "在《雪落在中国的土地上》中，冰冷的白雪、"
  },
  {
    "id": 45,
    "start": 197.904,
    "end": 201.424,
    "text": "乌黑的夜色与衣衫兰褛的难民剪影并置，"
  },
  {
    "id": 46,
    "start": 201.424,
    "end": 204.384,
    "text": "构成了雕塑般坚实凝练的画面质感，"
  },
  {
    "id": 47,
    "start": 204.384,
    "end": 206.864,
    "text": "达到了“诗中有画”的纯正现代境界。"
  },
  {
    "id": 48,
    "start": 207.104,
    "end": 211.264,
    "text": "综上所述，艾青以“土地”之沉重与“太阳”之炽热，"
  },
  {
    "id": 49,
    "start": 211.264,
    "end": 216.384,
    "text": "为二十世纪中华民族的苦难与奋起留下了最庄严的历史心电图。"
  },
  {
    "id": 50,
    "start": 216.384,
    "end": 220.624,
    "text": "他以沉雄深沉的忧郁情思净化了诗歌的灵魂，"
  },
  {
    "id": 51,
    "start": 220.624,
    "end": 226.064,
    "text": "以从容自由的文体解放确立了中国现代现实主义新诗的崇高标杆，"
  },
  {
    "id": 52,
    "start": 226.064,
    "end": 229.664,
    "text": "在现当代文学史上享有历久弥新的光辉地位。"
  }
]