[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "急救卡·现当代纵向母题链与跨期对比法",
    "start": 0.134,
    "end": 3.87,
    "duration": 3.736
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "“双纵向主脉 + 四维比较锁”现当代全真题救急总闸：",
    "start": 4.446,
    "end": 9.51,
    "duration": 5.064
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "凡遇百年演变题顺抽“乡土农民5步链”或“都市知识分子6站链”；",
    "start": 9.589,
    "end": 15.669,
    "duration": 6.08
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "凡遇陌生双家对比题一律切出“语境→心理姿态→视角修辞→史脉”同框互证。",
    "start": 15.995,
    "end": 22.878,
    "duration": 6.883
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "碰见跨越现当代演变综合大题或未背过的双家比较题，",
    "start": 23.439,
    "end": 28.204,
    "duration": 4.765
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "可即刻调用“两条核心演进主脉”与“横切四维通用公式”，现场串联已背单篇成文。",
    "start": 28.491,
    "end": 35.535,
    "duration": 7.043
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 主脉一：乡土叙事与农民观百年演进线",
    "start": 36.121,
    "end": 40.378,
    "duration": 4.257
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "五四鲁迅《阿Q正传》《祝福》启蒙剖析劣根→三十年代沈从文《边城》湘西抒情赞原始人性→四十年代赵树理《小二黑结婚》写改造翻身；",
    "start": 40.952,
    "end": 56.277,
    "duration": 15.325
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "新时期初汪曾祺《受戒》复归日常和美→寻根文学韩少功阿城深掘文化根性。",
    "start": 56.864,
    "end": 65.574,
    "duration": 8.71
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 主脉二：都市体验与知识分子精神史线",
    "start": 66.161,
    "end": 70.313,
    "duration": 4.153
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "郁达夫《沉沦》敞开零余痛感→三十年代曹禺《雷雨》《子夜》接入宗法与金融危机；",
    "start": 70.9,
    "end": 80.287,
    "duration": 9.387
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "抗战钱锺书《围城》讽文明夹缝、张爱玲《金锁记》剖苍凉人欲→新时期朦胧诗高擎良知再转入新写实零度审视庸常。",
    "start": 80.874,
    "end": 94.219,
    "duration": 13.345
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 技法：比较题“四维同框横切”推演骨架",
    "start": 94.793,
    "end": 98.959,
    "duration": 4.166
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "严禁先甲后乙两张皮！",
    "start": 99.546,
    "end": 102.774,
    "duration": 3.228
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "按“四维同框横切”对撞：一比历史语境与题材重心、二比人物心理或主体姿态、三比视角意象与修辞、四比百年现代化进程价值承接；",
    "start": 103.348,
    "end": 114.831,
    "duration": 11.483
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "每点紧扣各自一个核心细节（如祥子与祥林嫂、延安与京派）交错印证。",
    "start": 115.418,
    "end": 122.904,
    "duration": 7.486
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：注意两个必考节点定位，乡土线是“启蒙剖析→田园抒情→翻身改造→日常和美→文化寻根”；",
    "start": 123.491,
    "end": 133.126,
    "duration": 9.634
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "对比题必须四维同框横切，切忌先甲后乙写成两截！",
    "start": 133.4,
    "end": 138.634,
    "duration": 5.233
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 合书无遗漏默背“乡土农民5站链”与“都市知识分子6站链”全部人名书名？",
    "start": 139.194,
    "end": 146.472,
    "duration": 7.278
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释 2014 年开放式综论（如“谈谈最喜欢的现当代戏剧或女作家”）怎样用四维骨架快速扩篇？",
    "start": 147.046,
    "end": 156.472,
    "duration": 9.426
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 如何避免比较题常犯的“前甲后乙两张皮”重大扣分点？",
    "start": 157.059,
    "end": 162.917,
    "duration": 5.858
  }
]