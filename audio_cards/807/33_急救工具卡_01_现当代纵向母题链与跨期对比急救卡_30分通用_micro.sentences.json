[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "急救卡·现当代纵向母题链与跨期对比法",
    "start": 0.154,
    "end": 3.926,
    "duration": 3.772
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "“双纵向主脉 + 四维比较锁”现当代全真题救急总闸：",
    "start": 4.619,
    "end": 10.471,
    "duration": 5.852
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "凡遇百年演变题顺抽“乡土农民5步链”或“都市知识分子6站链”；",
    "start": 10.699,
    "end": 16.551,
    "duration": 5.852
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "凡遇陌生双家对比题一律切出“语境→心理姿态→视角修辞→史脉”同框互证。",
    "start": 16.909,
    "end": 23.481,
    "duration": 6.572
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "碰见跨越现当代演变综合大题或未背过的双家比较题，",
    "start": 23.926,
    "end": 28.338,
    "duration": 4.412
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "可即刻调用“两条核心演进主脉”与“横切四维通用公式”，现场串联已背单篇成文。",
    "start": 28.646,
    "end": 35.378,
    "duration": 6.732
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 主脉一：乡土叙事与农民观百年演进线",
    "start": 36.086,
    "end": 40.418,
    "duration": 4.332
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "五四鲁迅《阿Q正传》《祝福》启蒙剖析劣根→三十年代沈从文《边城》湘西抒情赞原始人性→四十年代赵树理《小二黑结婚》写改造翻身；",
    "start": 40.896,
    "end": 55.628,
    "duration": 14.732
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "新时期初汪曾祺《受戒》复归日常和美→寻根文学韩少功阿城深掘文化根性。",
    "start": 56.156,
    "end": 65.448,
    "duration": 9.292
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 主脉二：都市体验与知识分子精神史线",
    "start": 66.126,
    "end": 69.738,
    "duration": 3.612
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "郁达夫《沉沦》敞开零余痛感→三十年代曹禺《雷雨》《子夜》接入宗法与金融危机；",
    "start": 70.266,
    "end": 78.518,
    "duration": 8.252
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "抗战钱锺书《围城》讽文明夹缝、张爱玲《金锁记》剖苍凉人欲→新时期朦胧诗高擎良知再转入新写实零度审视庸常。",
    "start": 79.046,
    "end": 92.738,
    "duration": 13.692
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 技法：比较题“四维同框横切”推演骨架",
    "start": 93.371,
    "end": 97.463,
    "duration": 4.092
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "严禁先甲后乙两张皮！",
    "start": 97.991,
    "end": 100.643,
    "duration": 2.652
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "按“四维同框横切”对撞：一比历史语境与题材重心、二比人物心理或主体姿态、三比视角意象与修辞、四比百年现代化进程价值承接；",
    "start": 100.791,
    "end": 111.123,
    "duration": 10.332
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "每点紧扣各自一个核心细节（如祥子与祥林嫂、延安与京派）交错印证。",
    "start": 111.651,
    "end": 118.863,
    "duration": 7.212
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：注意两个必考节点定位，乡土线是“启蒙剖析→田园抒情→翻身改造→日常和美→文化寻根”；",
    "start": 119.492,
    "end": 128.064,
    "duration": 8.572
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "对比题必须四维同框横切，切忌先甲后乙写成两截！",
    "start": 128.422,
    "end": 132.834,
    "duration": 4.412
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 合书无遗漏默背“乡土农民5站链”与“都市知识分子6站链”全部人名书名？",
    "start": 133.542,
    "end": 141.314,
    "duration": 7.772
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释 2014 年开放式综论（如“谈谈最喜欢的现当代戏剧或女作家”）怎样用四维骨架快速扩篇？",
    "start": 141.842,
    "end": 150.574,
    "duration": 8.732
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 如何避免比较题常犯的“前甲后乙两张皮”重大扣分点？",
    "start": 151.082,
    "end": 156.694,
    "duration": 5.612
  }
]