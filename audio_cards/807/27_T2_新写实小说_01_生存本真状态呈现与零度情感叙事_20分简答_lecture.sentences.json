[
  {
    "id": 1,
    "text": "八十年代末至九十年代初，",
    "start": 0.05,
    "end": 2.358,
    "duration": 2.308
  },
  {
    "id": 2,
    "text": "伴随理想主义激情的退潮与现代市场经济转型的开启，",
    "start": 2.358,
    "end": 7.151,
    "duration": 4.793
  },
  {
    "id": 3,
    "text": "中国当代文坛涌现了以池莉、刘震云、",
    "start": 7.151,
    "end": 10.449,
    "duration": 3.298
  },
  {
    "id": 4,
    "text": "方方等为代表的“新写实小说”流派。",
    "start": 10.449,
    "end": 13.653,
    "duration": 3.204
  },
  {
    "id": 5,
    "text": "该派别告别了传统现实主义的典型化与先锋小说的形式玄想，",
    "start": 13.653,
    "end": 18.816,
    "duration": 5.163
  },
  {
    "id": 6,
    "text": "其艺术特色主要体现于以下三个方面：",
    "start": 18.816,
    "end": 22.471,
    "duration": 3.655
  },
  {
    "id": 7,
    "text": "第一，聚焦凡俗日常世俗生存，展现“毛茸茸的原生态”生活本真。",
    "start": 22.471,
    "end": 28.263,
    "duration": 5.792
  },
  {
    "id": 8,
    "text": "新写实作家断然摒弃了非黑即白的宏大历史叙事与启蒙说教，",
    "start": 28.263,
    "end": 33.831,
    "duration": 5.568
  },
  {
    "id": 9,
    "text": "主张还生活以本来面目。",
    "start": 33.831,
    "end": 36.672,
    "duration": 2.841
  },
  {
    "id": 10,
    "text": "池莉在《烦恼人生》中，",
    "start": 36.672,
    "end": 38.624,
    "duration": 1.952
  },
  {
    "id": 11,
    "text": "以细腻平实的笔调记录了钢铁厂操作工印家厚从清晨睁眼到夜晚就寝的一天：",
    "start": 38.624,
    "end": 45.604,
    "duration": 6.98
  },
  {
    "id": 12,
    "text": "挤渡轮、接自来水、照顾啼哭小儿、应付妻子唠叨与单位纠纷；",
    "start": 45.604,
    "end": 50.753,
    "duration": 5.149
  },
  {
    "id": 13,
    "text": "小说以充满烟火气的逼真细节，",
    "start": 50.753,
    "end": 53.561,
    "duration": 2.808
  },
  {
    "id": 14,
    "text": "将普通小人物在柴米油盐中的重重负荷展现得纤毫毕现。",
    "start": 53.561,
    "end": 58.878,
    "duration": 5.317
  },
  {
    "id": 15,
    "text": "第二，解构崇高与英雄神话，直面普通民众微小而坚韧的生存困境。",
    "start": 58.878,
    "end": 65.13,
    "duration": 6.252
  },
  {
    "id": 16,
    "text": "小说消解了传统文学中救世主般的英雄主角，",
    "start": 65.13,
    "end": 69.142,
    "duration": 4.012
  },
  {
    "id": 17,
    "text": "把目光投向在体制与琐屑生活中无力挣扎的凡夫俗子。",
    "start": 69.142,
    "end": 74.036,
    "duration": 4.894
  },
  {
    "id": 18,
    "text": "刘震云在《一地鸡毛》中刻画了机关小职员小林，",
    "start": 74.036,
    "end": 77.979,
    "duration": 3.943
  },
  {
    "id": 19,
    "text": "由昔日意气风发的大学生逐渐退化为因一斤变质豆腐而与妻子大吵大闹、",
    "start": 77.979,
    "end": 84.17,
    "duration": 6.191
  },
  {
    "id": 20,
    "text": "为分房与职称四处钻营讨好的庸碌市民，",
    "start": 84.17,
    "end": 87.46,
    "duration": 3.29
  },
  {
    "id": 21,
    "text": "以冷峻的笔触揭示了日常生活无处不在的平庸异化。",
    "start": 87.46,
    "end": 91.823,
    "duration": 4.363
  },
  {
    "id": 22,
    "text": "第三，确立“零度情感”叙事原则，建构客观冷静的冷眼旁观视界。",
    "start": 91.823,
    "end": 97.318,
    "duration": 5.495
  },
  {
    "id": 23,
    "text": "作家自觉克制主观的道德审判、情感投射与感伤喟叹，",
    "start": 97.318,
    "end": 102.661,
    "duration": 5.343
  },
  {
    "id": 24,
    "text": "叙述者如同冷眼旁观的摄影机，以冷峻、节制、",
    "start": 102.661,
    "end": 106.885,
    "duration": 4.224
  },
  {
    "id": 25,
    "text": "近乎机械的语调记录生活流程。",
    "start": 106.885,
    "end": 109.69,
    "duration": 2.805
  },
  {
    "id": 26,
    "text": "在方方的《风景》中，",
    "start": 109.69,
    "end": 111.222,
    "duration": 1.532
  },
  {
    "id": 27,
    "text": "作者甚至借一个死于襁褓的死婴亡灵视角，",
    "start": 111.222,
    "end": 114.549,
    "duration": 3.327
  },
  {
    "id": 28,
    "text": "冷静叙述汉口棚户区七拐八拐中一家人粗鄙、",
    "start": 114.549,
    "end": 119.237,
    "duration": 4.688
  },
  {
    "id": 29,
    "text": "残酷却又顽强繁衍的生命图景，",
    "start": 119.237,
    "end": 122.258,
    "duration": 3.021
  },
  {
    "id": 30,
    "text": "极大地拓展了现代汉语小说的叙事张力。",
    "start": 122.258,
    "end": 125.424,
    "duration": 3.166
  }
]