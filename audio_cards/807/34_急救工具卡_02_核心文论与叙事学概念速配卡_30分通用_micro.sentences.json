[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "急救卡·核心文论与叙事学概念速配卡",
    "start": 0.314,
    "end": 3.726,
    "duration": 3.412
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "2026 真题已实考“以意逆志 + 意图谬误论《阿Q》”新题型！",
    "start": 4.734,
    "end": 10.906,
    "duration": 6.172
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "八组文论按“作者端/历史派（1–2孟子）→文本中心新批评派（3–4两谬误 + 6反讽 + 8张力悖论）→俄国形式与叙事学（5陌生化 + 7聚焦视角）”精准速配现当代名篇与 60 分文学评论！",
    "start": 11.874,
    "end": 27.566,
    "duration": 15.692
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "本卡专攻“用中外文论阐释经典作品”新型论述题与六十分文学评论写作，精选八组高频理论工具，",
    "start": 28.574,
    "end": 37.266,
    "duration": 8.692
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "每条配“精准定义+名篇套用示范”。",
    "start": 37.654,
    "end": 40.706,
    "duration": 3.052
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 速配01 以意逆志（孟子·逆推作者诗心）",
    "start": 41.634,
    "end": 46.686,
    "duration": 5.052
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "一、以意逆志：“不以文害辞，不以辞害志。以意逆志，是为得之”，主以己心意迎候体会作者诗心，反对拘泥字句；",
    "start": 47.734,
    "end": 59.286,
    "duration": 11.552
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "释《阿Q正传》忌泥偷萝卜画圈滑稽表象，须逆推鲁迅“画出沉默国民魂灵”及揭精神胜利法救世之志。",
    "start": 60.254,
    "end": 70.586,
    "duration": 10.332
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 速配02 知人论世（孟子·身世语境考辨）",
    "start": 71.554,
    "end": 76.286,
    "duration": 4.732
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "二、知人论世：理解作品不能孤立就文论文，须结合创作者身世生平、思想立场与时代背景；",
    "start": 77.174,
    "end": 85.786,
    "duration": 8.612
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "读《狂人日记》与杂文，须联辛亥流产后新文化反礼教潮与鲁迅“呐喊”启蒙心境，辨“吃人”历史沉重。",
    "start": 86.674,
    "end": 96.046,
    "duration": 9.372
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 速配03 意图谬误（新批评·文本自足独立）",
    "start": 96.694,
    "end": 101.426,
    "duration": 4.732
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "三、意图谬误（意图谬见）：维姆萨特与比尔兹利批评以作者主观创作意图取代文本自身意义，主张文本诞生即独立自足；",
    "start": 102.046,
    "end": 112.018,
    "duration": 9.972
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "审《阿Q正传》，“精神胜利法”与末章“大团圆”讽刺结构所蕴普世人性荒诞，远超鲁迅最初设想局部讽刺。",
    "start": 112.946,
    "end": 123.118,
    "duration": 10.172
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 速配04 感受谬误（新批评·重文本肌质结构）",
    "start": 124.086,
    "end": 129.098,
    "duration": 5.012
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "四、感受谬误（感受谬见）：针对印象批评，反对混同作品本身与读者变动情绪反应，主回归具体文本肌质结构；",
    "start": 130.026,
    "end": 139.998,
    "duration": 9.972
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "评《雷雨》或陌生小说忌空泛说“令人感动悲凉”，须扣雷雨夜门窗意象、因果巧合与语言碰撞析张力。",
    "start": 140.926,
    "end": 150.378,
    "duration": 9.452
  },
  {
    "id": "sec4_title_c0",
    "dom_key": "sec4_title_c0",
    "text": "05 · 速配05 陌生化（什克洛夫斯基·打破自动化）",
    "start": 151.346,
    "end": 156.038,
    "duration": 4.692
  },
  {
    "id": "sec4_step0_c0",
    "dom_key": "sec4_step0_c0",
    "text": "五、陌生化：什克洛夫斯基指借语言扭曲、视角移位打破日常“自动化”感知，延长感受难度以唤醒审美；",
    "start": 156.966,
    "end": 166.298,
    "duration": 9.332
  },
  {
    "id": "sec4_step1_c0",
    "dom_key": "sec4_step1_c0",
    "text": "《狂人日记》借迫害狂错觉把长幼礼教陌生化为“吃人”；《孔乙己》用十二岁冷漠童眼制造冷峻悲感。",
    "start": 167.266,
    "end": 177.098,
    "duration": 9.832
  },
  {
    "id": "sec5_title_c0",
    "dom_key": "sec5_title_c0",
    "text": "06 · 速配06 反讽（布鲁克斯·语境歪曲背离）",
    "start": 178.066,
    "end": 182.118,
    "duration": 4.052
  },
  {
    "id": "sec5_step0_c0",
    "dom_key": "sec5_step0_c0",
    "text": "六、反讽：布鲁克斯指“语境对陈述语的明显歪曲”，字面与深层背离生含蓄锋芒；",
    "start": 183.126,
    "end": 189.778,
    "duration": 6.652
  },
  {
    "id": "sec5_step1_c0",
    "dom_key": "sec5_step1_c0",
    "text": "《阿Q正传》以“大团圆”题末章实写枪毙，成悲喜倒错反讽；张爱玲《金锁记》亦常以算计语调反衬畸变。",
    "start": 190.566,
    "end": 200.938,
    "duration": 10.372
  },
  {
    "id": "sec6_title_c0",
    "dom_key": "sec6_title_c0",
    "text": "07 · 速配07 叙述视角（聚焦：零聚焦vs有限聚焦）",
    "start": 201.906,
    "end": 207.278,
    "duration": 5.372
  },
  {
    "id": "sec6_step0_c0",
    "dom_key": "sec6_step0_c0",
    "text": "七、叙述视角（聚焦）：区分“全知（零聚焦）视角”与依托特定人物眼光的“有限（内/外聚焦）视角”；",
    "start": 208.166,
    "end": 217.218,
    "duration": 9.052
  },
  {
    "id": "sec6_step1_c0",
    "dom_key": "sec6_step1_c0",
    "text": "《祝福》用返乡知识分子“我”的第一人称有限视角看祥林嫂惨死，既留审视礼教客观间距，",
    "start": 218.146,
    "end": 226.998,
    "duration": 8.852
  },
  {
    "id": "sec6_step1_c1",
    "dom_key": "sec6_step1_c1",
    "text": "又暴露面对“灵魂有无”时的软弱。",
    "start": 227.266,
    "end": 229.518,
    "duration": 2.252
  },
  {
    "id": "sec7_title_c0",
    "dom_key": "sec7_title_c0",
    "text": "08 · 速配08 张力与悖论（退特·布鲁克斯诗学）",
    "start": 230.526,
    "end": 234.658,
    "duration": 4.132
  },
  {
    "id": "sec7_step0_c0",
    "dom_key": "sec7_step0_c0",
    "text": "八、张力与悖论：退特“张力”指外延与内涵协调统一；布鲁克斯“悖论”指表面矛盾中蕴深层真理；",
    "start": 235.626,
    "end": 245.978,
    "duration": 10.352
  },
  {
    "id": "sec7_step1_c0",
    "dom_key": "sec7_step1_c0",
    "text": "艾青“眼里常含泪水……爱得深沉”及穆旦《赞美》血火创痛与生的希望并存，正是伤痛与至爱碰撞之崇高张力。",
    "start": 246.866,
    "end": 257.558,
    "duration": 10.692
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：专攻“文论阐释经典作品”论述题与 60 分文学评论；",
    "start": 258.566,
    "end": 264.018,
    "duration": 5.452
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "务必分清“新批评”这对姊妹谬误概念（分别从创作端与接受端界定“文本中心”）：“意图谬误”（排斥作者原意）与“感受谬误”（排斥读者主观情绪印象）。",
    "start": 265.066,
    "end": 276.998,
    "duration": 11.932
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背全本卡 8 个文论术语的中外学者归属、核心定义及对应示范名篇？",
    "start": 278.006,
    "end": 285.338,
    "duration": 7.332
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 演练 2026 真题：怎样并用孟子“以意逆志”与新批评“意图谬误”双重视角解读《阿Q正传》？",
    "start": 285.966,
    "end": 295.538,
    "duration": 9.572
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 60分文学评论遇到陌生短篇（如欧亨利/海明威/张爱玲），最优先抽其中哪 3 个工具入文？",
    "start": 296.238,
    "end": 305.93,
    "duration": 9.692
  }
]