[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "2026 真题已实考“以意逆志 + 意图谬误论《阿Q》”新题型！",
    "start": 0.22,
    "end": 5.786,
    "duration": 5.565
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "八组文论按“作者端/历史派（1–2孟子）→文本中心新批评派（3–4两谬误 + 6反讽 + 8张力悖论）→俄国形式与叙事学（5陌生化 + 7聚焦视角）”精准速配现当代名篇与 60 分文学评论！",
    "start": 6.566,
    "end": 23.339,
    "duration": 16.774
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "本卡专攻“用中外文论阐释经典作品”新型论述题与六十分文学评论写作，",
    "start": 24.079,
    "end": 30.047,
    "duration": 5.968
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "精选八组高频理论工具，每条配“精准定义+名篇套用示范”。",
    "start": 30.786,
    "end": 35.529,
    "duration": 4.743
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 速配01 以意逆志（孟子·逆推作者诗心）",
    "start": 36.286,
    "end": 40.76,
    "duration": 4.474
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "一、以意逆志：“不以文害辞，不以辞害志。以意逆志，是为得之”，",
    "start": 41.46,
    "end": 47.11,
    "duration": 5.65
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "主以己心意迎候体会作者诗心，反对拘泥字句；",
    "start": 47.8,
    "end": 51.847,
    "duration": 4.047
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "释《阿Q正传》忌泥偷萝卜画圈滑稽表象，须逆推鲁迅“画出沉默国民魂灵”及揭精神胜利法救世之志。",
    "start": 52.555,
    "end": 60.802,
    "duration": 8.246
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 速配02 知人论世（孟子·身世语境考辨）",
    "start": 61.489,
    "end": 65.891,
    "duration": 4.403
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "二、知人论世：理解作品不能孤立就文论文，须结合创作者身世生平、思想立场与时代背景；",
    "start": 66.608,
    "end": 74.541,
    "duration": 7.933
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "读《狂人日记》与杂文，须联辛亥流产后新文化反礼教潮与鲁迅“呐喊”启蒙心境，",
    "start": 75.334,
    "end": 81.97,
    "duration": 6.636
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "辨“吃人”历史沉重。",
    "start": 82.71,
    "end": 84.062,
    "duration": 1.353
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 速配03 意图谬误（新批评·文本自足独立）",
    "start": 84.778,
    "end": 89.335,
    "duration": 4.557
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "三、意图谬误（意图谬见）：维姆萨特与比尔兹利批评以作者主观创作意图取代文本自身意义，",
    "start": 90.046,
    "end": 98.123,
    "duration": 8.077
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "主张文本诞生即独立自足；",
    "start": 98.839,
    "end": 101.216,
    "duration": 2.377
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "审《阿Q正传》，“精神胜利法”与末章“大团圆”讽刺结构所蕴普世人性荒诞，",
    "start": 101.933,
    "end": 107.87,
    "duration": 5.937
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "远超鲁迅最初设想局部讽刺。",
    "start": 108.629,
    "end": 110.976,
    "duration": 2.347
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 速配04 感受谬误（新批评·重文本肌质结构）",
    "start": 111.674,
    "end": 116.541,
    "duration": 4.867
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "四、感受谬误（感受谬见）：针对印象批评，反对混同作品本身与读者变动情绪反应，",
    "start": 117.278,
    "end": 124.931,
    "duration": 7.653
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "主回归具体文本肌质结构；",
    "start": 125.714,
    "end": 127.769,
    "duration": 2.055
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "评《雷雨》或陌生小说忌空泛说“令人感动悲凉”，须扣雷雨夜门窗意象、因果巧合与语言碰撞析张力。",
    "start": 128.519,
    "end": 137.018,
    "duration": 8.499
  },
  {
    "id": "sec4_title_c0",
    "dom_key": "sec4_title_c0",
    "text": "05 · 速配05 陌生化（什克洛夫斯基·打破自动化）",
    "start": 137.742,
    "end": 142.173,
    "duration": 4.431
  },
  {
    "id": "sec4_step0_c0",
    "dom_key": "sec4_step0_c0",
    "text": "五、陌生化：什克洛夫斯基指借语言扭曲、视角移位打破日常“自动化”感知，",
    "start": 142.921,
    "end": 149.164,
    "duration": 6.242
  },
  {
    "id": "sec4_step0_c1",
    "dom_key": "sec4_step0_c1",
    "text": "延长感受难度以唤醒审美；",
    "start": 149.929,
    "end": 152.183,
    "duration": 2.254
  },
  {
    "id": "sec4_step1_c0",
    "dom_key": "sec4_step1_c0",
    "text": "《狂人日记》借迫害狂错觉把长幼礼教陌生化为“吃人”；《孔乙己》用十二岁冷漠童眼制造冷峻悲感。",
    "start": 152.955,
    "end": 161.074,
    "duration": 8.119
  },
  {
    "id": "sec5_title_c0",
    "dom_key": "sec5_title_c0",
    "text": "06 · 速配06 反讽（布鲁克斯·语境歪曲背离）",
    "start": 161.856,
    "end": 166.103,
    "duration": 4.247
  },
  {
    "id": "sec5_step0_c0",
    "dom_key": "sec5_step0_c0",
    "text": "六、反讽：布鲁克斯指“语境对陈述语的明显歪曲”，字面与深层背离生含蓄锋芒；",
    "start": 166.795,
    "end": 173.657,
    "duration": 6.863
  },
  {
    "id": "sec5_step1_c0",
    "dom_key": "sec5_step1_c0",
    "text": "《阿Q正传》以“大团圆”题末章实写枪毙，成悲喜倒错反讽；",
    "start": 174.461,
    "end": 179.073,
    "duration": 4.612
  },
  {
    "id": "sec5_step1_c1",
    "dom_key": "sec5_step1_c1",
    "text": "张爱玲《金锁记》亦常以算计语调反衬畸变。",
    "start": 179.819,
    "end": 183.159,
    "duration": 3.341
  },
  {
    "id": "sec6_title_c0",
    "dom_key": "sec6_title_c0",
    "text": "07 · 速配07 叙述视角（聚焦：零聚焦vs有限聚焦）",
    "start": 183.878,
    "end": 188.896,
    "duration": 5.018
  },
  {
    "id": "sec6_step0_c0",
    "dom_key": "sec6_step0_c0",
    "text": "七、叙述视角（聚焦）：区分“全知（零聚焦）视角”与依托特定人物眼光的“有限（内/外聚焦）视角”；",
    "start": 189.601,
    "end": 198.48,
    "duration": 8.879
  },
  {
    "id": "sec6_step1_c0",
    "dom_key": "sec6_step1_c0",
    "text": "《祝福》用返乡知识分子“我”的第一人称有限视角看祥林嫂惨死，",
    "start": 199.189,
    "end": 204.314,
    "duration": 5.125
  },
  {
    "id": "sec6_step1_c1",
    "dom_key": "sec6_step1_c1",
    "text": "既留审视礼教客观间距，又暴露面对“灵魂有无”时的软弱。",
    "start": 205.047,
    "end": 209.603,
    "duration": 4.556
  },
  {
    "id": "sec7_title_c0",
    "dom_key": "sec7_title_c0",
    "text": "08 · 速配08 张力与悖论（退特·布鲁克斯诗学）",
    "start": 210.287,
    "end": 214.775,
    "duration": 4.488
  },
  {
    "id": "sec7_step0_c0",
    "dom_key": "sec7_step0_c0",
    "text": "八、张力与悖论：退特“张力”指外延与内涵协调统一；布鲁克斯“悖论”指表面矛盾中蕴深层真理；",
    "start": 215.486,
    "end": 223.796,
    "duration": 8.31
  },
  {
    "id": "sec7_step1_c0",
    "dom_key": "sec7_step1_c0",
    "text": "艾青“眼里常含泪水……爱得深沉”及穆旦《赞美》血火创痛与生的希望并存，",
    "start": 224.556,
    "end": 230.741,
    "duration": 6.185
  },
  {
    "id": "sec7_step1_c1",
    "dom_key": "sec7_step1_c1",
    "text": "正是伤痛与至爱碰撞之崇高张力。",
    "start": 231.581,
    "end": 234.305,
    "duration": 2.724
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：专攻“文论阐释经典作品”论述题与 60 分文学评论；",
    "start": 235.079,
    "end": 240.261,
    "duration": 5.181
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "务必分清“新批评”这对姊妹谬误概念（分别从创作端与接受端界定“文本中心”）：“意图谬误”（排斥作者原意）与“感受谬误”（排斥读者主观情绪印象）。",
    "start": 241.027,
    "end": 253.382,
    "duration": 12.354
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背全本卡 8 个文论术语的中外学者归属、核心定义及对应示范名篇？",
    "start": 254.088,
    "end": 261.117,
    "duration": 7.029
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 演练 2026 真题：怎样并用孟子“以意逆志”与新批评“意图谬误”双重视角解读《阿Q正传》？",
    "start": 261.863,
    "end": 270.807,
    "duration": 8.945
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 60分文学评论遇到陌生短篇（如欧亨利/海明威/张爱玲），最优先抽其中哪 3 个工具入文？",
    "start": 271.589,
    "end": 280.974,
    "duration": 9.385
  }
]