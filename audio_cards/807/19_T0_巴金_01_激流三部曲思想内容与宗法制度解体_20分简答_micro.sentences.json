[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "巴金·激流三部曲思想内容与宗法制度解体",
    "start": 0.154,
    "end": 3.926,
    "duration": 3.772
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "围绕成都高公馆大家庭拆成三层清晰群像：",
    "start": 4.551,
    "end": 9.603,
    "duration": 5.052
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "专制吃人阵营（高老太爷/克明酿成鸣凤、瑞珏、蕙表妹、淑贞惨案）→中间妥协悲剧（觉新“作揖主义”两头落空）→青年觉醒出走（觉慧/觉民/淑英“树倒猢狲散”）。",
    "start": 9.911,
    "end": 26.003,
    "duration": 16.092
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "巴金《家》《春》《秋》合称《激流三部曲》，以成都高公馆大家庭衰亡为轴心，系统控诉封建宗法制度罪恶。",
    "start": 26.472,
    "end": 34.644,
    "duration": 8.172
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 解剖封建宗法专制、控诉礼教吃人",
    "start": 35.335,
    "end": 39.187,
    "duration": 3.852
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "高老太爷与克明化身专制权威，借虚伪伦理摧残青年生命幸福；",
    "start": 39.715,
    "end": 46.527,
    "duration": 6.812
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《家》中鸣凤被指作妾投湖，瑞珏遭迷信“避血光之灾”逐出城外难产死；",
    "start": 47.055,
    "end": 54.587,
    "duration": 7.532
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "《春》《秋》蕙表妹病故、幼女淑贞投井，撕开礼教残酷面目。",
    "start": 54.785,
    "end": 60.237,
    "duration": 5.452
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 批判“作揖主义”、揭示妥协顺从悲剧",
    "start": 60.776,
    "end": 64.548,
    "duration": 3.772
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "觉新受新思潮影响却因责任束缚奉“作揖主义”不抵抗，对包办婚姻、梅表姐病逝与瑞珏惨死步步忍让；",
    "start": 65.076,
    "end": 75.248,
    "duration": 10.172
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "结果既未保住亲人反客观充当礼教帮凶，直至《秋》克明死高家分崩方逐步醒悟走出泥淖。",
    "start": 75.747,
    "end": 85.279,
    "duration": 9.532
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 歌颂叛逆青年觉醒与反抗、宣告解体",
    "start": 85.939,
    "end": 90.111,
    "duration": 4.172
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "觉慧破门第恋鸣凤、斥捉鬼闹剧、拒守孝枷锁登船东下；",
    "start": 90.483,
    "end": 98.335,
    "duration": 7.852
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "怯懦淑英在觉民琴等助下抗婚出走赴沪会合觉慧，叛逆壮大与高家“树倒猢狲散”分家彰显旧宗法解体。",
    "start": 98.553,
    "end": 111.685,
    "duration": 13.132
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：《激流三部曲》指《家》《春》《秋》；",
    "start": 112.275,
    "end": 116.047,
    "duration": 3.772
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "核心人物严格对齐：高老太爷/克明（专制）、鸣凤/瑞珏/蕙表妹/淑贞（受害）、觉新（作揖主义）、觉慧/觉民/淑英（反抗）。",
    "start": 116.405,
    "end": 126.737,
    "duration": 10.332
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出《激流三部曲》三部书名及《家》《春》《秋》各自的控诉重心？",
    "start": 127.425,
    "end": 133.837,
    "duration": 6.412
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 解释巴金刻画觉新“作揖主义”相比单纯塑造坏人老太爷更深刻之处？",
    "start": 134.365,
    "end": 140.937,
    "duration": 6.572
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2025 年真题简答《巴金“激流三部曲”的艺术特点/思想内容》？",
    "start": 141.404,
    "end": 147.816,
    "duration": 6.412
  }
]