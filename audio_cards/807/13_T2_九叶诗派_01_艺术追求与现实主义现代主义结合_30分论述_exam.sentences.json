[
  {
    "id": 1,
    "text": "二十世纪四十年代后期在国统区崛起的“九叶诗派”，",
    "start": 0.08,
    "end": 4.56,
    "duration": 4.48
  },
  {
    "id": 2,
    "text": "又称“中国新诗派”，是中国现代新诗走向成熟的重要里程碑。",
    "start": 4.56,
    "end": 9.76,
    "duration": 5.2
  },
  {
    "id": 3,
    "text": "以穆旦、辛笛、陈敬容、杜运燮、郑敏等九位诗人为代表，",
    "start": 9.76,
    "end": 14.8,
    "duration": 5.04
  },
  {
    "id": 4,
    "text": "他们依托《诗创造》与《中国新诗》杂志集结。",
    "start": 14.8,
    "end": 18.08,
    "duration": 3.28
  },
  {
    "id": 5,
    "text": "这群诗人大多受过良好的英美现代文学熏陶。",
    "start": 18.08,
    "end": 21.36,
    "duration": 3.28
  },
  {
    "id": 6,
    "text": "面对国统区腐朽反动的黑暗现实，他们既不满于浅薄直白的政治宣传口号，",
    "start": 21.68,
    "end": 28.16,
    "duration": 6.48
  },
  {
    "id": 7,
    "text": "也拒绝脱离时代的纯形式象牙塔。",
    "start": 28.16,
    "end": 31.04,
    "duration": 2.88
  },
  {
    "id": 8,
    "text": "九叶诗人开创性地提出了将现实主义的批判精神与现代主义的艺术手法深度交融的诗学纲领。",
    "start": 31.04,
    "end": 38.48,
    "duration": 7.44
  },
  {
    "id": 9,
    "text": "这场深刻的美学探索体现在四个核心维度。",
    "start": 38.48,
    "end": 41.68,
    "duration": 3.2
  },
  {
    "id": 10,
    "text": "第一，时代苦难介入与知识分子反省机制的深度咬合。",
    "start": 42.0,
    "end": 47.28,
    "duration": 5.28
  },
  {
    "id": 11,
    "text": "九叶诗派彻底超越了浪漫主义的个人感伤。",
    "start": 47.28,
    "end": 50.96,
    "duration": 3.68
  },
  {
    "id": 12,
    "text": "他们将诗歌根须深扎于抗日战争与内战的现实土壤。",
    "start": 50.96,
    "end": 55.6,
    "duration": 4.64
  },
  {
    "id": 13,
    "text": "穆旦在《赞美》中倾诉着对农夫泥土般的受难肉体的博大敬意。",
    "start": 55.6,
    "end": 60.64,
    "duration": 5.04
  },
  {
    "id": 14,
    "text": "但在书写苦难时，他们拒绝单一的道德控诉。",
    "start": 60.64,
    "end": 64.08,
    "duration": 3.44
  },
  {
    "id": 15,
    "text": "诗人把自我作为现代知识分子的一员置于审判台前。",
    "start": 64.4,
    "end": 68.72,
    "duration": 4.32
  },
  {
    "id": 16,
    "text": "穆旦在《隐现》中无情剖析自我精神的游移与软弱。",
    "start": 68.72,
    "end": 72.8,
    "duration": 4.08
  },
  {
    "id": 17,
    "text": "这种将时代苦难与知识分子心理反省相交织的知性深度，",
    "start": 72.8,
    "end": 78.0,
    "duration": 5.2
  },
  {
    "id": 18,
    "text": "赋予诗作严峻的现代批判力量。",
    "start": 78.0,
    "end": 80.4,
    "duration": 2.4
  },
  {
    "id": 19,
    "text": "第二，借鉴英美现代主义营构复杂的诗歌意象体系。",
    "start": 80.4,
    "end": 84.32,
    "duration": 3.92
  },
  {
    "id": 20,
    "text": "九叶诗人系统吸纳了艾略特、奥登以及里尔克的现代诗艺。",
    "start": 84.64,
    "end": 89.44,
    "duration": 4.8
  },
  {
    "id": 21,
    "text": "他们彻底告别了早期新诗单一透明的直抒胸胸臆。",
    "start": 89.44,
    "end": 93.28,
    "duration": 3.84
  },
  {
    "id": 22,
    "text": "诗作大量运用反讽、悖论、象征与复合意象。",
    "start": 93.28,
    "end": 97.36,
    "duration": 4.08
  },
  {
    "id": 23,
    "text": "杜运燮在《滇缅公路》中把公路比喻为翻滚的长蛇。",
    "start": 97.36,
    "end": 101.36,
    "duration": 4.0
  },
  {
    "id": 24,
    "text": "现代文明的机械暴力与原始自然在此激烈碰撞。",
    "start": 101.36,
    "end": 104.8,
    "duration": 3.44
  },
  {
    "id": 25,
    "text": "郑敏在《金黄的稻束》中借静穆的稻田意象，",
    "start": 105.04,
    "end": 108.8,
    "duration": 3.76
  },
  {
    "id": 26,
    "text": "沉思劳动、生命与死亡的深沉哲思。",
    "start": 108.8,
    "end": 112.32,
    "duration": 3.52
  },
  {
    "id": 27,
    "text": "繁复的意象网络极大地拓展了现代汉语的审美表现力。",
    "start": 112.32,
    "end": 116.4,
    "duration": 4.08
  },
  {
    "id": 28,
    "text": "第三，克服主观滥情并确立现代诗的“戏剧化”结构。",
    "start": 116.696,
    "end": 121.336,
    "duration": 4.64
  },
  {
    "id": 29,
    "text": "九叶诗人自觉倡导诗歌的客观化与戏剧化原则。",
    "start": 121.336,
    "end": 125.256,
    "duration": 3.92
  },
  {
    "id": 30,
    "text": "他们刻意拉开诗人与抒情主人公的情感距离，",
    "start": 125.256,
    "end": 129.016,
    "duration": 3.76
  },
  {
    "id": 31,
    "text": "反对宣泄式的口号呐喊。",
    "start": 129.016,
    "end": 131.176,
    "duration": 2.16
  },
  {
    "id": 32,
    "text": "诗人常常把多重互相冲突的声调、视角与观念，",
    "start": 131.176,
    "end": 135.096,
    "duration": 3.92
  },
  {
    "id": 33,
    "text": "置入同一个诗歌文本中。",
    "start": 135.096,
    "end": 136.696,
    "duration": 1.6
  },
  {
    "id": 34,
    "text": "辛笛在《风景》中描写列车窗外掠过的荒凉风景与车厢内的麻木众生。",
    "start": 137.096,
    "end": 143.096,
    "duration": 6.0
  },
  {
    "id": 35,
    "text": "诗人以冷眼旁观的蒙太奇剪辑手法，",
    "start": 143.096,
    "end": 146.216,
    "duration": 3.12
  },
  {
    "id": 36,
    "text": "构筑起平静表面下的深刻心理戏剧。",
    "start": 146.216,
    "end": 149.336,
    "duration": 3.12
  },
  {
    "id": 37,
    "text": "感官体验由此升华为严谨的现代智性结构。",
    "start": 149.336,
    "end": 153.016,
    "duration": 3.68
  },
  {
    "id": 38,
    "text": "第四，融汇玄学派哲思追求与古典意境的现代转化。",
    "start": 153.016,
    "end": 157.736,
    "duration": 4.72
  },
  {
    "id": 39,
    "text": "九叶诗派追求现代诗的“智性化”。",
    "start": 158.056,
    "end": 160.776,
    "duration": 2.72
  },
  {
    "id": 40,
    "text": "他们吸收了十七世纪英国玄学派诗人约翰•多恩的手法，",
    "start": 160.776,
    "end": 165.816,
    "duration": 5.04
  },
  {
    "id": 41,
    "text": "善于将抽象的哲学玄想转化为可触可感的肉身痛觉。",
    "start": 165.816,
    "end": 170.536,
    "duration": 4.72
  },
  {
    "id": 42,
    "text": "穆旦在《诗八首》中探讨爱情时，将肉体的欢愉与灵魂的孤独、",
    "start": 170.536,
    "end": 175.736,
    "duration": 5.2
  },
  {
    "id": 43,
    "text": "虚无严密并置。",
    "start": 175.736,
    "end": 177.176,
    "duration": 1.44
  },
  {
    "id": 44,
    "text": "同时他们并不盲目全盘西化。",
    "start": 177.176,
    "end": 179.496,
    "duration": 2.32
  },
  {
    "id": 45,
    "text": "陈敬容与辛笛巧妙汲取晚唐诗风的冷艳蕴藉。",
    "start": 179.736,
    "end": 184.136,
    "duration": 4.4
  },
  {
    "id": 46,
    "text": "他们将中国古典诗歌的含蓄意境，成功化入现代主义的知性框架之中。",
    "start": 184.136,
    "end": 190.456,
    "duration": 6.32
  },
  {
    "id": 47,
    "text": "九叶诗派在战火硝烟与社会转型的大裂变时代，",
    "start": 190.456,
    "end": 194.696,
    "duration": 4.24
  },
  {
    "id": 48,
    "text": "成功探索出一条既具有深沉现实批判力，",
    "start": 194.696,
    "end": 198.376,
    "duration": 3.68
  },
  {
    "id": 49,
    "text": "又具备现代美学高度的中国新诗之路。",
    "start": 198.376,
    "end": 201.736,
    "duration": 3.36
  },
  {
    "id": 50,
    "text": "他们对现实与现代主义的成功化合，",
    "start": 201.976,
    "end": 204.696,
    "duration": 2.72
  },
  {
    "id": 51,
    "text": "不仅终结了新文学初期诗艺幼稚的局面，",
    "start": 204.696,
    "end": 208.216,
    "duration": 3.52
  },
  {
    "id": 52,
    "text": "更为八十年代新时期诗歌的美学崛起，",
    "start": 208.216,
    "end": 211.336,
    "duration": 3.12
  },
  {
    "id": 53,
    "text": "提供了极其宝贵的先锋谱系与历史经验。",
    "start": 211.336,
    "end": 214.536,
    "duration": 3.2
  }
]