[
  {
    "id": 1,
    "text": "四十年代初期，",
    "start": 0.092,
    "end": 1.297,
    "duration": 1.205
  },
  {
    "id": 2,
    "text": "身处沦陷孤岛香港的萧红发表长篇自传体小说《呼兰河传》，",
    "start": 1.319,
    "end": 6.268,
    "duration": 4.949
  },
  {
    "id": 3,
    "text": "在现代文学史上开辟了独具地域特色与女性生命体验的“诗化小说”崭新范式。",
    "start": 6.429,
    "end": 13.061,
    "duration": 6.632
  },
  {
    "id": 4,
    "text": "茅盾赞誉其为“一篇叙事诗，一幅多彩的风土画，",
    "start": 13.217,
    "end": 17.482,
    "duration": 4.265
  },
  {
    "id": 5,
    "text": "一串凄婉的歌谣”，其艺术特色主要展现于以下三个方面：",
    "start": 17.546,
    "end": 21.673,
    "duration": 4.127
  },
  {
    "id": 6,
    "text": "第一，解构传统线性叙事，",
    "start": 21.856,
    "end": 23.91,
    "duration": 2.054
  },
  {
    "id": 7,
    "text": "开辟写意从容的童年追忆散文化文体范式。",
    "start": 24.153,
    "end": 27.671,
    "duration": 3.518
  },
  {
    "id": 8,
    "text": "小说彻底打破了以戏剧性冲突与连贯情节为主线的传统章法，",
    "start": 27.889,
    "end": 32.844,
    "duration": 4.955
  },
  {
    "id": 9,
    "text": "借天真儿童的有限视角，将北方边陲呼兰河小镇的风土人情、",
    "start": 33.084,
    "end": 37.864,
    "duration": 4.78
  },
  {
    "id": 10,
    "text": "街道庙会与生老病死娓娓道来。",
    "start": 38.053,
    "end": 40.859,
    "duration": 2.806
  },
  {
    "id": 11,
    "text": "作者以散文般的自由笔触，",
    "start": 41.054,
    "end": 43.002,
    "duration": 1.948
  },
  {
    "id": 12,
    "text": "将全书结构为互不贯通又在精神上深层咬合的风俗图景，",
    "start": 43.186,
    "end": 48.071,
    "duration": 4.885
  },
  {
    "id": 13,
    "text": "创造了一种兼具史传实感与散文风致的现代文体结构。",
    "start": 48.285,
    "end": 52.887,
    "duration": 4.602
  },
  {
    "id": 14,
    "text": "第二，并置童年暖意与生存严酷，呈现冰火交织的复杂心理张力。",
    "start": 53.139,
    "end": 59.268,
    "duration": 6.129
  },
  {
    "id": 15,
    "text": "小说一边以极其澄澈深情的笔墨，",
    "start": 59.846,
    "end": 63.12,
    "duration": 3.274
  },
  {
    "id": 16,
    "text": "描绘祖父的后花园里黄瓜长了随便吃、",
    "start": 63.161,
    "end": 66.392,
    "duration": 3.231
  },
  {
    "id": 17,
    "text": "蜻蜓飞来任凭飞的纯真与自由，赋予生命以唯一的温暖抚慰；",
    "start": 66.676,
    "end": 72.113,
    "duration": 5.437
  },
  {
    "id": 18,
    "text": "另一边却以冷峻的笔调展现严冬里冰封大地的大泥坑、",
    "start": 72.742,
    "end": 77.626,
    "duration": 4.884
  },
  {
    "id": 19,
    "text": "冻裂的房瓦与乡民麻木迟钝的生存荒原，",
    "start": 77.672,
    "end": 81.029,
    "duration": 3.357
  },
  {
    "id": 20,
    "text": "在极温情与极荒凉的强烈对照中，传达出沉重的人生叹息。",
    "start": 81.118,
    "end": 86.316,
    "duration": 5.198
  },
  {
    "id": 21,
    "text": "第三，直面国民愚昧与封建吃人，展现看客狂欢下的深刻生存悲凉。",
    "start": 86.499,
    "end": 92.826,
    "duration": 6.327
  },
  {
    "id": 22,
    "text": "萧红以超越常人的敏锐洞察力，刻画了小团圆媳妇的惨绝悲剧。",
    "start": 93.285,
    "end": 98.1,
    "duration": 4.815
  },
  {
    "id": 23,
    "text": "一个活泼健壮的十二岁小姑娘，",
    "start": 98.535,
    "end": 100.59,
    "duration": 2.055
  },
  {
    "id": 24,
    "text": "仅仅因为不合封建妇德便遭婆婆长期毒打折磨；",
    "start": 100.823,
    "end": 104.659,
    "duration": 3.836
  },
  {
    "id": 25,
    "text": "在乡邻围观起哄的集体狂欢中，",
    "start": 104.876,
    "end": 107.833,
    "duration": 2.957
  },
  {
    "id": 26,
    "text": "被三次脱光衣服强行按入沸水热汤中“洗澡治病”，",
    "start": 108.07,
    "end": 112.088,
    "duration": 4.018
  },
  {
    "id": 27,
    "text": "最终昏死夭折。",
    "start": 112.473,
    "end": 113.71,
    "duration": 1.237
  },
  {
    "id": 28,
    "text": "人们在施暴与看热闹中展现出的麻木不仁，",
    "start": 113.934,
    "end": 116.841,
    "duration": 2.907
  },
  {
    "id": 29,
    "text": "将中国乡土社会集体无意识的冷酷与荒诞撕裂得令人窒息。",
    "start": 117.048,
    "end": 121.584,
    "duration": 4.536
  }
]
