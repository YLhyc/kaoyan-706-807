[
  {
    "id": 1,
    "text": "四十年代初，",
    "start": 0.106,
    "end": 1.057,
    "duration": 0.951
  },
  {
    "id": 2,
    "text": "旅居香港的萧红写出长篇自传体小说《呼兰河传》，",
    "start": 1.372,
    "end": 5.242,
    "duration": 3.87
  },
  {
    "id": 3,
    "text": "在现代文学史上开辟了独具地域气息与女性生命体验的“诗化小说”路径。",
    "start": 5.559,
    "end": 10.927,
    "duration": 5.368
  },
  {
    "id": 4,
    "text": "茅盾赞誉其为“一篇叙事诗，一幅多彩的风土画，",
    "start": 11.424,
    "end": 15.16,
    "duration": 3.736
  },
  {
    "id": 5,
    "text": "一串凄婉的歌谣”，其艺术特色主要展现于以下三个方面：",
    "start": 15.507,
    "end": 19.47,
    "duration": 3.963
  },
  {
    "id": 6,
    "text": "第一，突破传统线性叙事，开辟写意从容的散文化文体范式。",
    "start": 20.081,
    "end": 25.407,
    "duration": 5.326
  },
  {
    "id": 7,
    "text": "小说打破了以戏剧性冲突和连贯情节为主线的传统章法，",
    "start": 25.659,
    "end": 30.015,
    "duration": 4.356
  },
  {
    "id": 8,
    "text": "借天真儿童的有限视角，将北方边陲呼兰河小镇的风土人情、",
    "start": 30.498,
    "end": 35.139,
    "duration": 4.641
  },
  {
    "id": 9,
    "text": "街道庙会与生老病死娓娓道来。",
    "start": 35.392,
    "end": 37.532,
    "duration": 2.14
  },
  {
    "id": 10,
    "text": "作者以散文般的自由笔调，",
    "start": 37.697,
    "end": 39.484,
    "duration": 1.787
  },
  {
    "id": 11,
    "text": "将全书结构为相对独立又在精神上互相呼应的风俗图景，",
    "start": 39.771,
    "end": 44.248,
    "duration": 4.477
  },
  {
    "id": 12,
    "text": "创造出兼具风土实感与诗意韵致的散文化结构。",
    "start": 44.691,
    "end": 48.882,
    "duration": 4.191
  },
  {
    "id": 13,
    "text": "第二，并置童年暖意与生存严酷，呈现温情与荒凉交织的情感张力。",
    "start": 49.498,
    "end": 55.493,
    "duration": 5.995
  },
  {
    "id": 14,
    "text": "小说一边以澄澈深情的笔墨，",
    "start": 56.035,
    "end": 58.269,
    "duration": 2.234
  },
  {
    "id": 15,
    "text": "描绘祖父后花园里黄瓜长了随便吃、",
    "start": 58.575,
    "end": 61.664,
    "duration": 3.089
  },
  {
    "id": 16,
    "text": "蜻蜓飞来任凭飞的纯真自由，赋予童年以温暖抚慰；",
    "start": 62.033,
    "end": 66.228,
    "duration": 4.195
  },
  {
    "id": 17,
    "text": "另一边却以冷峻笔调展现严冬大泥坑吞没牲畜、",
    "start": 66.597,
    "end": 70.498,
    "duration": 3.901
  },
  {
    "id": 18,
    "text": "冻裂房瓦与乡民麻木生存的沉重画面，",
    "start": 70.795,
    "end": 73.949,
    "duration": 3.154
  },
  {
    "id": 19,
    "text": "在温情与荒凉的强烈对照中，传达出绵长的人生叹息。",
    "start": 74.373,
    "end": 79.063,
    "duration": 4.69
  },
  {
    "id": 20,
    "text": "第三，直面国民愚昧与封建麻木，揭示看客围观下的生存悲凉。",
    "start": 79.728,
    "end": 85.026,
    "duration": 5.298
  },
  {
    "id": 21,
    "text": "萧红以敏锐细腻的感受力刻画了小团圆媳妇的悲剧：",
    "start": 85.719,
    "end": 89.633,
    "duration": 3.914
  },
  {
    "id": 22,
    "text": "一个健壮活泼的十二岁女孩，",
    "start": 90.145,
    "end": 92.286,
    "duration": 2.141
  },
  {
    "id": 23,
    "text": "仅因不合乡俗妇德便遭婆婆长期毒打折磨；在乡邻围观起哄下，",
    "start": 92.378,
    "end": 98.001,
    "duration": 5.623
  },
  {
    "id": 24,
    "text": "三次被按入滚烫热水中“洗澡治病”，最终昏死夭折。",
    "start": 98.221,
    "end": 102.777,
    "duration": 4.556
  },
  {
    "id": 25,
    "text": "人们在施暴与围观中显露出的麻木冷漠，",
    "start": 103.085,
    "end": 105.952,
    "duration": 2.867
  },
  {
    "id": 26,
    "text": "将乡土社会陈腐习惯与集体无意识的残酷揭示得触目惊心。",
    "start": 106.421,
    "end": 111.412,
    "duration": 4.991
  }
]