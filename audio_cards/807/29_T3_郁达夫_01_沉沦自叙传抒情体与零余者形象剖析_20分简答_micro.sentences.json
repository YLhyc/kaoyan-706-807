[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "郁达夫·《沉沦》自叙传抒情体与零余者形象",
    "start": 0.154,
    "end": 4.26,
    "duration": 4.106
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣《沉沦》在创造社早期开创“自叙传”文体、刻画带弱国屈辱痛感的“零余者”、终至“感伤病态美”到后期《迟桂花》人性和谐净化的流变三步推演。",
    "start": 5.228,
    "end": 19.24,
    "duration": 14.012
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "作为五四前期创造社核心小说家，郁达夫以短篇集《沉沦》打破重外部情节定势，",
    "start": 20.208,
    "end": 27.18,
    "duration": 6.972
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "开创现代“自叙传”抒情小说流派，抒写出退潮期青年苦闷。",
    "start": 27.488,
    "end": 32.86,
    "duration": 5.372
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 首创直抒胸臆“自叙传”主情小说体制",
    "start": 33.868,
    "end": 37.4,
    "duration": 3.532
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "吸收浪漫主义及日本“私小说”，主张一切文学皆作家“自叙传”；",
    "start": 38.448,
    "end": 44.38,
    "duration": 5.932
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "《沉沦》弱化戏剧波折，以“他”的精神抑郁为主脉，穿插日记自白、景物烘托与坦率独白，掀个性解放风潮。",
    "start": 45.388,
    "end": 55.56,
    "duration": 10.172
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 刻画压抑反抗的“零余者”抒情主人公",
    "start": 56.488,
    "end": 60.5,
    "duration": 4.012
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "异乡有志难申青年：《沉沦》留日生既遭青春期灵肉压抑，又受弱国屈辱爱国痛感夹击；",
    "start": 61.588,
    "end": 70.96,
    "duration": 9.372
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "孤立自我嫌恶中投海自尽，疾呼“祖国呀，祖国！我的死是你害我的！”，成五四青年精神失落写照。",
    "start": 71.928,
    "end": 82.56,
    "duration": 10.632
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 坦诚“感伤病态美”与后期人性净化流变",
    "start": 83.568,
    "end": 88.3,
    "duration": 4.732
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《春风沉醉的晚上》写亭子间文人与女工陈二妹“同是天涯沦落人”，赋“倡优士子”古典悲悯以平民色泽；",
    "start": 89.0,
    "end": 100.092,
    "duration": 11.092
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "后期《迟桂花》转向宁静和谐人性净化，并深远影响废名、庐隐等主观抒情小说。",
    "start": 101.06,
    "end": 108.672,
    "duration": 7.612
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：《沉沦》为五四前期创造社小说代表，临终呼喊“祖国呀，祖国！我的死是你害我的！”；",
    "start": 109.68,
    "end": 118.032,
    "duration": 8.352
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "早期尚有《春风沉醉的晚上》（1923），后期代表转变作品记住《迟桂花》（1932）。",
    "start": 118.3,
    "end": 125.672,
    "duration": 7.372
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 厘清郁达夫前期《沉沦》《春风沉醉的晚上》与后期转变作《迟桂花》的分期定位？",
    "start": 126.68,
    "end": 134.852,
    "duration": 8.172
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合日记独白结构、双痛感“零余者”与“祖国呀，祖国”解释创造社主观抒情力？",
    "start": 135.74,
    "end": 144.072,
    "duration": 8.332
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 说明“倡优士子”古典悲悯到了《春风沉醉的晚上》怎样接续到现代底层女工身上？",
    "start": 145.04,
    "end": 154.092,
    "duration": 9.052
  }
]