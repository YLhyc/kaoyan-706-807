[
  {
    "id": 1,
    "text": "二十年代中后期，针对五四早期新诗过度散文化、缺乏节制与形式粗糙的“非诗化”倾向，",
    "start": 0.121,
    "end": 8.026,
    "duration": 7.905
  },
  {
    "id": 2,
    "text": "闻一多、徐志摩等新月派诗人发起了著名的现代新诗格律化运动。",
    "start": 8.415,
    "end": 13.475,
    "duration": 5.06
  },
  {
    "id": 3,
    "text": "闻一多在《诗的格律》中系统提出了“戴着脚镣跳舞”的艺术命题，",
    "start": 13.995,
    "end": 18.476,
    "duration": 4.481
  },
  {
    "id": 4,
    "text": "其核心的“三美”理论与美学贡献主要体现于以下三个方面：",
    "start": 18.846,
    "end": 23.253,
    "duration": 4.407
  },
  {
    "id": 5,
    "text": "第一，倡导“音乐的美”，强调音尺节拍与韵律的内在和谐。",
    "start": 23.858,
    "end": 28.647,
    "duration": 4.789
  },
  {
    "id": 6,
    "text": "闻一多认为新诗必须具备听觉上的音乐感，",
    "start": 29.167,
    "end": 32.185,
    "duration": 3.018
  },
  {
    "id": 7,
    "text": "但绝不复古旧体格律，而是根据现代汉语语音特征，以“音尺”（步）的均齐来规范诗行，",
    "start": 32.555,
    "end": 39.607,
    "duration": 7.052
  },
  {
    "id": 8,
    "text": "做到字数不必完全相同，但每行的音尺数量大致相等、停顿自然、押韵严谨。",
    "start": 39.997,
    "end": 46.073,
    "duration": 6.076
  },
  {
    "id": 9,
    "text": "在名篇《死水》中，全诗每行均为四个音尺，平仄相互交错，韵脚回环咬合，赋予全篇如古钟般庄重凝炼、沉郁顿挫的内在声律。",
    "start": 46.593,
    "end": 57.359,
    "duration": 10.766
  },
  {
    "id": 10,
    "text": "第二，追求“绘画的美”，强化意象色彩与辞藻的造型张力。",
    "start": 58.016,
    "end": 62.914,
    "duration": 4.898
  },
  {
    "id": 11,
    "text": "新月派主张诗歌应当借鉴绘画的造型原则，注重词藻的视觉修饰与色彩对比。",
    "start": 63.434,
    "end": 69.458,
    "duration": 6.024
  },
  {
    "id": 12,
    "text": "在《死水》中，诗人将一沟绝望的死水化作视觉奇观，",
    "start": 69.978,
    "end": 73.834,
    "duration": 3.856
  },
  {
    "id": 13,
    "text": "运用“翡翠、桃花、罗绮、云霞”等明艳华丽的色彩词，与“剩菜残羹、绿酒、白沫”等污秽物象形成强烈视觉反差，",
    "start": 74.288,
    "end": 84.199,
    "duration": 9.911
  },
  {
    "id": 14,
    "text": "在审丑与审美的剧烈冲突中，达到了极高境界的绘画造型美。",
    "start": 84.72,
    "end": 89.285,
    "duration": 4.565
  },
  {
    "id": 15,
    "text": "第三，构筑“建筑的美”，确立节的匀称与句的均齐规范。",
    "start": 89.885,
    "end": 94.083,
    "duration": 4.198
  },
  {
    "id": 16,
    "text": "闻一多强调诗的视觉排版必须具备建筑般的对称稳固感，要求“节的匀称”与“句的齐整”。",
    "start": 94.603,
    "end": 101.747,
    "duration": 7.144
  },
  {
    "id": 17,
    "text": "徐志摩在《再别康桥》中深得其精髓，全诗共七节，每节四行，",
    "start": 102.267,
    "end": 107.153,
    "duration": 4.886
  },
  {
    "id": 18,
    "text": "诗行参差中保持大体匀称，如流线型建筑般轻灵流动；",
    "start": 107.523,
    "end": 111.812,
    "duration": 4.289
  },
  {
    "id": 19,
    "text": "新月派通过“三美”理论的深层建构，",
    "start": 112.332,
    "end": 114.928,
    "duration": 2.596
  },
  {
    "id": 20,
    "text": "有力纠正了早期白话诗信马由缰的散漫弊端，为中国新诗确立了现代形式规范。",
    "start": 115.332,
    "end": 122.095,
    "duration": 6.763
  }
]