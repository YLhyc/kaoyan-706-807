[
  {
    "id": 1,
    "text": "二十年代中后期，针对五四早期新诗过度散文化、",
    "start": 0.08,
    "end": 4.72,
    "duration": 4.64
  },
  {
    "id": 2,
    "text": "缺乏节制与形式粗糙的“非诗化”倾向，闻一多、",
    "start": 4.72,
    "end": 9.6,
    "duration": 4.88
  },
  {
    "id": 3,
    "text": "徐志摩等新月派诗人发起了著名的现代新诗格律化运动。",
    "start": 9.6,
    "end": 14.4,
    "duration": 4.8
  },
  {
    "id": 4,
    "text": "闻一多在《诗的格律》中系统提出了“戴着脚镣跳舞”的艺术命题，",
    "start": 14.48,
    "end": 20.88,
    "duration": 6.4
  },
  {
    "id": 5,
    "text": "其核心的“三美”理论与美学贡献主要体现于以下三个方面：",
    "start": 20.88,
    "end": 26.8,
    "duration": 5.92
  },
  {
    "id": 6,
    "text": "第一，倡导“音乐的美”，强调音尺节拍与韵律的内在和谐。",
    "start": 26.8,
    "end": 32.24,
    "duration": 5.44
  },
  {
    "id": 7,
    "text": "闻一多认为新诗必须具备听觉上的音乐感，",
    "start": 32.24,
    "end": 36.64,
    "duration": 4.4
  },
  {
    "id": 8,
    "text": "但绝非复古旧体格律，而是根据现代汉语语音特征，",
    "start": 36.64,
    "end": 41.84,
    "duration": 5.2
  },
  {
    "id": 9,
    "text": "以“音尺”（步）的均齐来规范诗行，做到字数不必完全相同，",
    "start": 41.84,
    "end": 47.76,
    "duration": 5.92
  },
  {
    "id": 10,
    "text": "但每行的音尺数量大致相等、停顿自然、押韵严谨。",
    "start": 47.76,
    "end": 53.04,
    "duration": 5.28
  },
  {
    "id": 11,
    "text": "在名篇《死水》中，全诗每行均为四个音尺，平仄相互交错，",
    "start": 53.04,
    "end": 58.8,
    "duration": 5.76
  },
  {
    "id": 12,
    "text": "韵脚回环咬合，赋予全篇一种如古钟般庄重凝炼、",
    "start": 58.8,
    "end": 64.08,
    "duration": 5.28
  },
  {
    "id": 13,
    "text": "沉郁顿挫的内在音乐声律。",
    "start": 64.08,
    "end": 66.32,
    "duration": 2.24
  },
  {
    "id": 14,
    "text": "第二，追求“绘画的美”，强化意象色彩与辞藻的造型张力。",
    "start": 66.32,
    "end": 71.68,
    "duration": 5.36
  },
  {
    "id": 15,
    "text": "新月派主张诗歌应当借鉴绘画的造型原则，",
    "start": 71.68,
    "end": 76.0,
    "duration": 4.32
  },
  {
    "id": 16,
    "text": "注重词藻的视觉修饰与色彩对比。",
    "start": 76.0,
    "end": 79.84,
    "duration": 3.84
  },
  {
    "id": 17,
    "text": "在《死水》中，诗人将一沟绝望的死水化作视觉奇观，",
    "start": 79.84,
    "end": 85.12,
    "duration": 5.28
  },
  {
    "id": 18,
    "text": "运用“翡翠、桃花、罗绮、云霞”等极其明艳华丽的色彩词，",
    "start": 85.12,
    "end": 90.32,
    "duration": 5.2
  },
  {
    "id": 19,
    "text": "与“剩菜残羹、绿酒、白沫”等污秽物象形成强烈视觉反差，",
    "start": 90.32,
    "end": 97.04,
    "duration": 6.72
  },
  {
    "id": 20,
    "text": "在审丑与审美的极致张力中，达到了极高境界的绘画造型美。",
    "start": 97.04,
    "end": 102.16,
    "duration": 5.12
  },
  {
    "id": 21,
    "text": "第三，构筑“建筑的美”，确立节的匀称与句的均齐规范。",
    "start": 102.16,
    "end": 107.92,
    "duration": 5.76
  },
  {
    "id": 22,
    "text": "闻一多强调诗的视觉排版必须具备建筑般的对称稳固感，",
    "start": 108.16,
    "end": 113.68,
    "duration": 5.52
  },
  {
    "id": 23,
    "text": "要求“节的匀称”与“句的齐整”。",
    "start": 113.68,
    "end": 117.128,
    "duration": 3.448
  },
  {
    "id": 24,
    "text": "徐志摩在《再别康桥》中深得其精髓，全诗共七节，每节四行，",
    "start": 117.128,
    "end": 122.818,
    "duration": 5.69
  },
  {
    "id": 25,
    "text": "诗行参差中保持大体匀称，如流线型建筑般轻灵流动；",
    "start": 122.818,
    "end": 124.24,
    "duration": 1.422
  },
  {
    "id": 26,
    "text": "新月派通过“三美”理论的深层建构，",
    "start": 124.037,
    "end": 124.24,
    "duration": 0.203
  },
  {
    "id": 27,
    "text": "彻底纠正了早期白话诗信马由缰的散漫弊端，",
    "start": 124.037,
    "end": 124.24,
    "duration": 0.203
  },
  {
    "id": 28,
    "text": "为中国新诗确立了现代形式规范。",
    "start": 124.037,
    "end": 124.24,
    "duration": 0.203
  }
]