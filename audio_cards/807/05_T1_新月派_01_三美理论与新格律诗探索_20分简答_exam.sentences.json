[
  {
    "id": 1,
    "text": "二十年代中后期，针对五四早期新诗过度散文化、",
    "start": 0.0,
    "end": 4.401,
    "duration": 4.401
  },
  {
    "id": 2,
    "text": "缺乏节制与形式粗糙的“非诗化”倾向，闻一多、",
    "start": 4.401,
    "end": 8.292,
    "duration": 3.891
  },
  {
    "id": 3,
    "text": "徐志摩等新月派诗人发起了著名的现代新诗格律化运动。",
    "start": 8.292,
    "end": 13.875,
    "duration": 5.583
  },
  {
    "id": 4,
    "text": "闻一多在《诗的格律》中系统提出了“戴着脚镣跳舞”的艺术命题，",
    "start": 13.875,
    "end": 20.836,
    "duration": 6.961
  },
  {
    "id": 5,
    "text": "其核心的“三美”理论与美学贡献主要体现于以下三个方面：",
    "start": 20.836,
    "end": 27.501,
    "duration": 6.665
  },
  {
    "id": 6,
    "text": "第一，倡导“音乐的美”，强调音尺节拍与韵律的内在和谐。",
    "start": 27.501,
    "end": 32.847,
    "duration": 5.346
  },
  {
    "id": 7,
    "text": "闻一多认为新诗必须具备听觉上的音乐感，",
    "start": 32.847,
    "end": 37.54,
    "duration": 4.693
  },
  {
    "id": 8,
    "text": "但绝非复古旧体格律，而是根据现代汉语语音特征，",
    "start": 37.54,
    "end": 42.594,
    "duration": 5.054
  },
  {
    "id": 9,
    "text": "以“音尺”（步）的均齐来规范诗行，做到字数不必完全相同，",
    "start": 42.594,
    "end": 48.615,
    "duration": 6.021
  },
  {
    "id": 10,
    "text": "但每行的音尺数量大致相等、停顿自然、押韵严谨。",
    "start": 48.615,
    "end": 52.442,
    "duration": 3.827
  },
  {
    "id": 11,
    "text": "在名篇《死水》中，全诗每行均为四个音尺，平仄相互交错，",
    "start": 52.442,
    "end": 57.501,
    "duration": 5.059
  },
  {
    "id": 12,
    "text": "韵脚回环咬合，赋予全篇一种如古钟般庄重凝炼、",
    "start": 57.501,
    "end": 62.303,
    "duration": 4.802
  },
  {
    "id": 13,
    "text": "沉郁顿挫的内在音乐声律。",
    "start": 62.303,
    "end": 65.579,
    "duration": 3.276
  },
  {
    "id": 14,
    "text": "第二，追求“绘画的美”，强化意象色彩与辞藻的造型张力。",
    "start": 65.579,
    "end": 69.269,
    "duration": 3.69
  },
  {
    "id": 15,
    "text": "新月派主张诗歌应当借鉴绘画的造型原则，",
    "start": 69.269,
    "end": 73.239,
    "duration": 3.97
  },
  {
    "id": 16,
    "text": "注重词藻的视觉修饰与色彩对比。",
    "start": 73.239,
    "end": 76.904,
    "duration": 3.665
  },
  {
    "id": 17,
    "text": "在《死水》中，诗人将一沟绝望的死水化作视觉奇观，",
    "start": 76.904,
    "end": 81.483,
    "duration": 4.579
  },
  {
    "id": 18,
    "text": "运用“翡翠、桃花、罗绮、云霞”等极其明艳华丽的色彩词，",
    "start": 81.483,
    "end": 86.588,
    "duration": 5.105
  },
  {
    "id": 19,
    "text": "与“剩菜残羹、绿酒、白沫”等污秽物象形成强烈视觉反差，",
    "start": 86.588,
    "end": 92.119,
    "duration": 5.531
  },
  {
    "id": 20,
    "text": "在审丑与审美的极致张力中，达到了极高境界的绘画造型美。",
    "start": 92.119,
    "end": 96.98,
    "duration": 4.861
  },
  {
    "id": 21,
    "text": "第三，构筑“建筑的美”，确立节的匀称与句的均齐规范。",
    "start": 96.98,
    "end": 102.888,
    "duration": 5.908
  },
  {
    "id": 22,
    "text": "闻一多强调诗的视觉排版必须具备建筑般的对称稳固感，",
    "start": 102.888,
    "end": 108.244,
    "duration": 5.356
  },
  {
    "id": 23,
    "text": "要求“节的匀称”与“句的齐整”。",
    "start": 108.244,
    "end": 109.303,
    "duration": 1.059
  },
  {
    "id": 24,
    "text": "徐志摩在《再别康桥》中深得其精髓，全诗共七节，每节四行，",
    "start": 109.303,
    "end": 111.916,
    "duration": 2.613
  },
  {
    "id": 25,
    "text": "诗行参差中保持大体匀称，如流线型建筑般轻灵流动；",
    "start": 111.916,
    "end": 114.215,
    "duration": 2.299
  },
  {
    "id": 26,
    "text": "新月派通过“三美”理论的深层建构，",
    "start": 114.215,
    "end": 117.258,
    "duration": 3.043
  },
  {
    "id": 27,
    "text": "彻底纠正了早期白话诗信马由缰的散漫弊端，",
    "start": 117.258,
    "end": 121.339,
    "duration": 4.081
  },
  {
    "id": 28,
    "text": "为中国新诗确立了现代形式规范。",
    "start": 121.339,
    "end": 124.031,
    "duration": 2.692
  }
]