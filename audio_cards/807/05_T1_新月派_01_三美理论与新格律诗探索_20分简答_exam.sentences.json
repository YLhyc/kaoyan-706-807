[
  {
    "id": 1,
    "text": "二十年代中后期，针对五四早期新诗过度散文化、缺乏节制与形式粗糙的“非诗化”倾向，",
    "start": 0.134,
    "end": 7.226,
    "duration": 7.092
  },
  {
    "id": 2,
    "text": "闻一多、徐志摩等新月派诗人发起了著名的现代新诗格律化运动。",
    "start": 7.85,
    "end": 12.502,
    "duration": 4.652
  },
  {
    "id": 3,
    "text": "闻一多在《诗的格律》中系统提出了“戴着脚镣跳舞”的艺术命题，",
    "start": 13.14,
    "end": 15.512,
    "duration": 2.372
  },
  {
    "id": 4,
    "text": "其核心的“三美”理论与美学贡献主要体现于以下三个方面：",
    "start": 15.891,
    "end": 17.863,
    "duration": 1.972
  },
  {
    "id": 5,
    "text": "第一，倡导“音乐的美”，强调音尺节拍与韵律的内在和谐。",
    "start": 18.541,
    "end": 27.153,
    "duration": 8.612
  },
  {
    "id": 6,
    "text": "闻一多认为新诗必须具备听觉上的音乐感，",
    "start": 27.831,
    "end": 30.883,
    "duration": 3.052
  },
  {
    "id": 7,
    "text": "但绝不复古旧体格律，而是根据现代汉语语音特征，以“音尺”（步）的均齐来规范诗行，",
    "start": 31.262,
    "end": 37.394,
    "duration": 6.132
  },
  {
    "id": 8,
    "text": "做到字数不必完全相同，但每行的音尺数量大致相等、停顿自然、押韵严谨。",
    "start": 37.946,
    "end": 43.958,
    "duration": 6.012
  },
  {
    "id": 9,
    "text": "在名篇《死水》中，全诗每行均为四个音尺，平仄相互交错，韵脚回环咬合，赋予全篇如古钟般庄重凝炼、沉郁顿挫的内在声律。",
    "start": 44.612,
    "end": 54.664,
    "duration": 10.052
  },
  {
    "id": 10,
    "text": "第二，追求“绘画的美”，强化意象色彩与辞藻的造型张力。",
    "start": 55.342,
    "end": 59.634,
    "duration": 4.292
  },
  {
    "id": 11,
    "text": "新月派主张诗歌应当借鉴绘画的造型原则，注重词藻的视觉修饰与色彩对比。",
    "start": 60.272,
    "end": 66.684,
    "duration": 6.412
  },
  {
    "id": 12,
    "text": "在《死水》中，诗人将一沟绝望的死水化作视觉奇观，",
    "start": 67.362,
    "end": 71.294,
    "duration": 3.932
  },
  {
    "id": 13,
    "text": "运用“翡翠、桃花、罗绮、云霞”等明艳华丽的色彩词，与“剩菜残羹、绿酒、白沫”等污秽物象形成强烈视觉反差，",
    "start": 71.673,
    "end": 81.647,
    "duration": 9.974
  },
  {
    "id": 14,
    "text": "在审丑与审美的剧烈冲突中，达到了极高境界的绘画造型美。",
    "start": 82.026,
    "end": 86.228,
    "duration": 4.202
  },
  {
    "id": 15,
    "text": "第三，构筑“建筑的美”，确立节的匀称与句的均齐规范。",
    "start": 86.884,
    "end": 91.216,
    "duration": 4.332
  },
  {
    "id": 16,
    "text": "闻一多强调诗的视觉排版必须具备建筑般的对称稳固感，要求“节的匀称”与“句的齐整”。",
    "start": 91.894,
    "end": 98.506,
    "duration": 6.612
  },
  {
    "id": 17,
    "text": "徐志摩在《再别康桥》中深得其精髓，全诗共七节，每节四行，",
    "start": 99.144,
    "end": 104.156,
    "duration": 5.012
  },
  {
    "id": 18,
    "text": "诗行参差中保持大体匀称，如流线型建筑般轻灵流动；",
    "start": 104.535,
    "end": 108.707,
    "duration": 4.172
  },
  {
    "id": 19,
    "text": "新月派通过“三美”理论的深层建构，",
    "start": 109.385,
    "end": 111.877,
    "duration": 2.492
  },
  {
    "id": 20,
    "text": "有力纠正了早期白话诗信马由缰的散漫弊端，为中国新诗确立了现代形式规范。",
    "start": 112.256,
    "end": 118.468,
    "duration": 6.212
  }
]