[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "体式→灵魂深度→叙事法则",
    "start": 0.224,
    "end": 3.27,
    "duration": 3.046
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "→形式实验四步定鼎现代小说史：先写《狂人日记》打破事件章法立起心理白话新体，",
    "start": 3.98,
    "end": 10.862,
    "duration": 6.882
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再看题材从苦难展览转入国民灵魂深处，",
    "start": 11.637,
    "end": 15.226,
    "duration": 3.589
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "进而抽象出标志性的“看客结构”与“归乡模型”，",
    "start": 15.957,
    "end": 19.299,
    "duration": 3.341
  },
  {
    "id": "hook_c4",
    "dom_key": "hook_c4",
    "text": "最后收归“一篇有一篇之形式”的现代探索。",
    "start": 20.011,
    "end": 23.324,
    "duration": 3.313
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "五四《狂人日记》宣告现代白话小说确立，",
    "start": 24.12,
    "end": 27.162,
    "duration": 3.043
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "《呐喊》《彷徨》以自觉文体意识与精神深度树立现代小说经典范式。",
    "start": 27.93,
    "end": 33.547,
    "duration": 5.617
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 颠覆古典章法、立白话短篇文体范式",
    "start": 34.271,
    "end": 37.963,
    "duration": 3.692
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "《狂人日记》打破章回连贯情节与全知惯性，由“事件叙事”转向“心理叙事”；",
    "start": 38.697,
    "end": 45.219,
    "duration": 6.522
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "提炼洗练哲思现代白话告别过渡生硬，《阿Q正传》获与世界现代文学平视之艺术尊严。",
    "start": 45.902,
    "end": 53.046,
    "duration": 7.144
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 两大题材、将表现重心转向“灵魂深处”",
    "start": 53.807,
    "end": 57.954,
    "duration": 4.147
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "直面“病态社会中不幸的人们”而拒苦难展览，探照灯射向国民内在精神创伤：",
    "start": 58.688,
    "end": 65.354,
    "duration": 6.667
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《药》聚焦华老栓买人血馒头愚昧；",
    "start": 66.135,
    "end": 68.754,
    "duration": 2.619
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "《故乡》震痛在于闰土那声“老爷”；",
    "start": 69.54,
    "end": 72.0,
    "duration": 2.46
  },
  {
    "id": "sec1_step1_c2",
    "dom_key": "sec1_step1_c2",
    "text": "《祝福》解剖祥林嫂在四权罗网中灵魂死灭。",
    "start": 72.694,
    "end": 76.325,
    "duration": 3.631
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 独创“看客结构”与“归乡模型”法则",
    "start": 77.0,
    "end": 80.479,
    "duration": 3.479
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《孔乙己》酒客取乐、《祝福》嚼阿毛血泪、《药》伸长颈项如鸭子，",
    "start": 81.188,
    "end": 85.992,
    "duration": 4.804
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "“看与被看”推向“吃与被吃”寓言；",
    "start": 86.718,
    "end": 88.997,
    "duration": 2.279
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《故乡》始于篷船终于篷船与《在酒楼上》开创“离去—归来—再离去”，写启蒙者遭遇荒寒进退失据。",
    "start": 89.719,
    "end": 97.386,
    "duration": 7.667
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · “一篇有一篇之形式”、融中西实验",
    "start": 98.072,
    "end": 101.54,
    "duration": 3.468
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "《狂人日记》文言小序+白话日记复调反讽；",
    "start": 102.341,
    "end": 105.535,
    "duration": 3.193
  },
  {
    "id": "sec3_step0_c1",
    "dom_key": "sec3_step0_c1",
    "text": "《孔乙己》十二岁小伙计有限视点；",
    "start": 106.319,
    "end": 108.633,
    "duration": 2.315
  },
  {
    "id": "sec3_step0_c2",
    "dom_key": "sec3_step0_c2",
    "text": "《阿Q正传》戏仿正史秩序；",
    "start": 109.407,
    "end": 111.442,
    "duration": 2.035
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "散文诗、象征与反讽浑融，拓宽现代小说审美疆界。",
    "start": 112.16,
    "end": 116.974,
    "duration": 4.814
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "鲁迅立现代小说之体、拓现代小说之深、创现代叙事之型、铸现代文学之魂，",
    "start": 117.73,
    "end": 124.207,
    "duration": 6.478
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "使现代小说起步便告别古典陈规。",
    "start": 125.11,
    "end": 128.2,
    "duration": 3.09
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：代表作为《呐喊》《彷徨》；",
    "start": 128.943,
    "end": 131.608,
    "duration": 2.665
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "概括鲁迅开创现代小说四个贡献时，",
    "start": 132.327,
    "end": 135.247,
    "duration": 2.92
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "避免只背作品名而不写“看客结构”“归乡模型”“一篇有一篇之形式”。",
    "start": 135.976,
    "end": 141.636,
    "duration": 5.66
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出概括鲁迅现代小说开创性贡献的“四字十六字”结语口诀？",
    "start": 142.343,
    "end": 148.483,
    "duration": 6.14
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《药》《故乡》《祝福》讲透“拒绝苦难展览、掘灵魂深处”与“看客/归乡结构”？",
    "start": 149.21,
    "end": 157.209,
    "duration": 7.999
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 举出三篇说明何谓“一篇有一篇之形式”？",
    "start": 157.948,
    "end": 162.528,
    "duration": 4.581
  }
]