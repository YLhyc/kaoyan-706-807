[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "鲁迅·现代小说史开创性贡献",
    "start": 0.154,
    "end": 2.646,
    "duration": 2.492
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "体式→灵魂深度→叙事法则→形式实验四步定鼎现代小说史：",
    "start": 3.349,
    "end": 10.401,
    "duration": 7.052
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先写《狂人日记》打破事件章法立起心理白话新体，再看题材从苦难展览转入国民灵魂深处，",
    "start": 10.709,
    "end": 18.401,
    "duration": 7.692
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "进而抽象出标志性的“看客结构”与“归乡模型”，最后收归“一篇有一篇之形式”的现代探索。",
    "start": 18.629,
    "end": 25.601,
    "duration": 6.972
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "五四《狂人日记》宣告现代白话小说确立，《呐喊》《彷徨》以自觉文体意识与精神深度树立现代小说经典范式。",
    "start": 26.096,
    "end": 36.108,
    "duration": 10.012
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 颠覆古典章法、立白话短篇文体范式",
    "start": 36.815,
    "end": 40.587,
    "duration": 3.772
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "《狂人日记》打破章回连贯情节与全知惯性，由“事件叙事”转向“心理叙事”；",
    "start": 41.072,
    "end": 48.204,
    "duration": 7.132
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "提炼洗练哲思现代白话告别过渡生硬，《阿Q正传》获与世界现代文学平视之艺术尊严。",
    "start": 48.703,
    "end": 58.555,
    "duration": 9.852
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 两大题材、将表现重心转向“灵魂深处”",
    "start": 59.263,
    "end": 63.355,
    "duration": 4.092
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "直面“病态社会中不幸的人们”而拒苦难展览，探照灯射向国民内在精神创伤：",
    "start": 63.883,
    "end": 71.815,
    "duration": 7.932
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《药》聚焦华老栓买人血馒头愚昧；",
    "start": 72.343,
    "end": 76.195,
    "duration": 3.852
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "《故乡》震痛在于闰土那声“老爷”；",
    "start": 76.473,
    "end": 79.205,
    "duration": 2.732
  },
  {
    "id": "sec1_step1_c2",
    "dom_key": "sec1_step1_c2",
    "text": "《祝福》解剖祥林嫂在四权罗网中灵魂死灭。",
    "start": 79.243,
    "end": 83.945,
    "duration": 4.702
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 独创“看客结构”与“归乡模型”法则",
    "start": 84.653,
    "end": 88.615,
    "duration": 3.962
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《孔乙己》酒客取乐、《祝福》嚼阿毛血泪、《药》伸长颈项如鸭子，“看与被看”推向“吃与被吃”寓言；",
    "start": 88.959,
    "end": 98.251,
    "duration": 9.292
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《故乡》始于篷船终于篷船与《在酒楼上》开创“离去—归来—再离去”，写启蒙者遭遇荒寒进退失据。",
    "start": 98.704,
    "end": 109.276,
    "duration": 10.572
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · “一篇有一篇之形式”、融中西实验",
    "start": 109.903,
    "end": 113.275,
    "duration": 3.372
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "《狂人日记》文言小序+白话日记复调反讽；《孔乙己》十二岁小伙计有限视点；《阿Q正传》戏仿正史秩序；",
    "start": 113.803,
    "end": 123.435,
    "duration": 9.632
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "散文诗、象征与反讽浑融，拓宽现代小说审美疆界。",
    "start": 123.768,
    "end": 128.82,
    "duration": 5.052
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "鲁迅立现代小说之体、拓现代小说之深、创现代叙事之型、铸现代文学之魂，使现代小说起步便告别古典陈规。",
    "start": 129.445,
    "end": 140.177,
    "duration": 10.732
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：代表作为《呐喊》《彷徨》；概括鲁迅开创现代小说四个贡献时，避免只背作品名而不写“看客结构”“归乡模型”“一篇有一篇之形式”。",
    "start": 140.663,
    "end": 153.765,
    "duration": 13.102
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出概括鲁迅现代小说开创性贡献的“四字十六字”结语口诀？",
    "start": 154.473,
    "end": 160.485,
    "duration": 6.012
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《药》《故乡》《祝福》讲透“拒绝苦难展览、掘灵魂深处”与“看客/归乡结构”？",
    "start": 161.013,
    "end": 168.459,
    "duration": 7.446
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 举出三篇说明何谓“一篇有一篇之形式”？",
    "start": 168.987,
    "end": 173.885,
    "duration": 4.898
  }
]