[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "鲁迅·现代小说史开创性贡献",
    "start": 0.314,
    "end": 3.046,
    "duration": 2.732
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "体式→灵魂深度→叙事法则→形式实验四步定鼎现代小说史：",
    "start": 4.014,
    "end": 10.706,
    "duration": 6.692
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先写《狂人日记》打破事件章法立起心理白话新体，再看题材从苦难展览转入国民灵魂深处，",
    "start": 11.214,
    "end": 19.066,
    "duration": 7.852
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "进而抽象出标志性的“看客结构”与“归乡模型”，最后收归“一篇有一篇之形式”的现代探索。",
    "start": 19.374,
    "end": 26.386,
    "duration": 7.012
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "五四《狂人日记》宣告现代白话小说确立，《呐喊》《彷徨》以自觉文体意识与精神深度树立现代小说经典范式。",
    "start": 27.314,
    "end": 37.366,
    "duration": 10.052
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 颠覆古典章法、立白话短篇文体范式",
    "start": 38.374,
    "end": 42.546,
    "duration": 4.172
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "《狂人日记》打破章回连贯情节与全知惯性，由“事件叙事”转向“心理叙事”；",
    "start": 43.514,
    "end": 51.486,
    "duration": 7.972
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "提炼洗练哲思现代白话告别过渡生硬，《阿Q正传》获与世界现代文学平视之艺术尊严。",
    "start": 52.454,
    "end": 62.986,
    "duration": 10.532
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 两大题材、将表现重心转向“灵魂深处”",
    "start": 63.954,
    "end": 67.846,
    "duration": 3.892
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "直面“病态社会中不幸的人们”而拒苦难展览，探照灯射向国民内在精神创伤：",
    "start": 68.814,
    "end": 76.186,
    "duration": 7.372
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《药》聚焦华老栓买人血馒头愚昧；",
    "start": 77.194,
    "end": 81.366,
    "duration": 4.172
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "《故乡》震痛在于闰土那声“老爷”；",
    "start": 82.294,
    "end": 85.186,
    "duration": 2.892
  },
  {
    "id": "sec1_step1_c2",
    "dom_key": "sec1_step1_c2",
    "text": "《祝福》解剖祥林嫂在四权罗网中灵魂死灭。",
    "start": 86.154,
    "end": 89.766,
    "duration": 3.612
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 独创“看客结构”与“归乡模型”法则",
    "start": 90.474,
    "end": 93.806,
    "duration": 3.332
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "《孔乙己》酒客取乐、《祝福》嚼阿毛血泪、《药》伸长颈项如鸭子，“看与被看”推向“吃与被吃”寓言；",
    "start": 94.546,
    "end": 104.398,
    "duration": 9.852
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《故乡》始于篷船终于篷船与《在酒楼上》开创“离去—归来—再离去”，写启蒙者遭遇荒寒进退失据。",
    "start": 105.406,
    "end": 116.538,
    "duration": 11.132
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · “一篇有一篇之形式”、融中西实验",
    "start": 117.506,
    "end": 120.798,
    "duration": 3.292
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "《狂人日记》文言小序+白话日记复调反讽；《孔乙己》十二岁小伙计有限视点；《阿Q正传》戏仿正史秩序；",
    "start": 121.846,
    "end": 133.938,
    "duration": 12.092
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "散文诗、象征与反讽浑融，拓宽现代小说审美疆界。",
    "start": 134.466,
    "end": 140.078,
    "duration": 5.612
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "鲁迅立现代小说之体、拓现代小说之深、创现代叙事之型、铸现代文学之魂，使现代小说起步便告别古典陈规。",
    "start": 141.086,
    "end": 152.058,
    "duration": 10.972
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：代表作为《呐喊》《彷徨》；概括鲁迅开创现代小说四个贡献时，避免只背作品名而不写“看客结构”“归乡模型”“一篇有一篇之形式”。",
    "start": 153.106,
    "end": 166.018,
    "duration": 12.912
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出概括鲁迅现代小说开创性贡献的“四字十六字”结语口诀？",
    "start": 166.986,
    "end": 173.878,
    "duration": 6.892
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《药》《故乡》《祝福》讲透“拒绝苦难展览、掘灵魂深处”与“看客/归乡结构”？",
    "start": 174.846,
    "end": 182.978,
    "duration": 8.132
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 举出三篇说明何谓“一篇有一篇之形式”？",
    "start": 183.374,
    "end": 188.226,
    "duration": 4.852
  }
]