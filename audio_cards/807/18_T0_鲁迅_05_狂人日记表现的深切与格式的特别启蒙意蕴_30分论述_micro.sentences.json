[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣鲁迅自己概括的“表现的深切和格式的特别”三步立柱：",
    "start": 0.222,
    "end": 5.627,
    "duration": 5.405
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先剖礼教“吃人”且全家全村构成“共谋网”与“未必无意不吃妹肉”之深切，",
    "start": 6.391,
    "end": 12.168,
    "duration": 5.776
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再拆文言小序vs十三则白话日记复调框架与象征之特别，",
    "start": 12.897,
    "end": 18.072,
    "duration": 5.175
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后塑出“清醒疯子”自审与“救救孩子”启蒙高度。",
    "start": 18.79,
    "end": 22.508,
    "duration": 3.719
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "五四鲁迅发表于《新青年》的《狂人日记》是现代白话小说奠基之作。",
    "start": 23.284,
    "end": 28.219,
    "duration": 4.935
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "鲁迅自括其显示了“表现的深切和格式的特别”，树思想与形式革新典范。",
    "start": 28.95,
    "end": 34.87,
    "duration": 5.92
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · “表现的深切”：礼教“吃人”本质与社会共谋",
    "start": 35.626,
    "end": 39.6,
    "duration": 3.974
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "借狂人非常视角穿透仁义修辞，从历史字缝看出“吃人”二字，宣判专制传统；",
    "start": 40.304,
    "end": 47.22,
    "duration": 6.916
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "“古久先生”簿子、赵贵翁眼色、看客、何先生乃至于长兄织成共谋网；",
    "start": 48.004,
    "end": 54.041,
    "duration": 6.037
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "惊疑“未必无意之中，不吃了我妹子的几片肉”直剖伦理毒害，见启蒙清醒。",
    "start": 54.817,
    "end": 60.703,
    "duration": 5.886
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · “格式的特别”：复合叙事框架与心理象征",
    "start": 61.426,
    "end": 65.464,
    "duration": 4.037
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "开篇理性文言“小序”交代“赴某地候补矣”，隐喻正统对反叛的驯化收编；",
    "start": 66.194,
    "end": 71.861,
    "duration": 5.667
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "随后十三则白话日记呈非逻辑独白，形成互相拆解的结构反讽张力；",
    "start": 72.586,
    "end": 78.376,
    "duration": 5.791
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "融西方象征表现技巧，赋惨白月光、赵贵翁眼色、何先生诊脉以社会象征，立白话小说高度。",
    "start": 79.15,
    "end": 87.283,
    "duration": 8.133
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · “清醒的疯子”：自省与反抗绝望的启蒙精神",
    "start": 88.093,
    "end": 92.449,
    "duration": 4.356
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "既是逼真迫害妄想患者，更是最早质疑“从来如此，便对么？”的觉醒先驱，",
    "start": 93.189,
    "end": 99.353,
    "duration": 6.164
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "敢于在“四千年吃人履历”中直面自身罪责；",
    "start": 100.062,
    "end": 103.334,
    "duration": 3.272
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "末发“救救孩子……”沉痛呼告，蕴含明知传统沉重却反抗绝望之勇气，",
    "start": 104.026,
    "end": 109.847,
    "duration": 5.82
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "升华为挽救民族未来的启蒙宣言。",
    "start": 110.562,
    "end": 113.229,
    "duration": 2.666
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《狂人日记》以“表现的深切”直击传统与国民性病灶，",
    "start": 113.989,
    "end": 117.97,
    "duration": 3.981
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "以“格式的特别”推动叙事从古典向现代转型，成五四先声与奠基之作。",
    "start": 118.728,
    "end": 124.786,
    "duration": 6.058
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅自己概括其成就为“表现的深切和格式的特别”；",
    "start": 125.568,
    "end": 130.543,
    "duration": 4.975
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "末尾呐喊是“救救孩子……”，小序实为讽刺狂人被正统收编“赴某地候补”。",
    "start": 131.295,
    "end": 136.965,
    "duration": 5.669
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 结合文言小序、十三则白话日记与现代象征，解透什么是“格式的特别”？",
    "start": 137.741,
    "end": 145.281,
    "duration": 7.54
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合“四千年吃人履历”与“未必无意不吃妹子肉”，解释何谓“表现的深切”？",
    "start": 145.985,
    "end": 152.879,
    "duration": 6.894
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2014/2015 年真题简答：《狂人日记》中“狂人形象的意义”？",
    "start": 153.607,
    "end": 160.519,
    "duration": 6.912
  }
]