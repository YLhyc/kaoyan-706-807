[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣鲁迅自己概括的“表现的深切和格式的特别”三步立柱：",
    "start": 0.0,
    "end": 5.56,
    "duration": 5.56
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先剖礼教“吃人”且全家全村构成“共谋网”与“未必无意不吃妹肉”之深切，",
    "start": 5.609,
    "end": 11.249,
    "duration": 5.64
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再拆文言小序vs十三则白话日记复调框架与象征之特别，",
    "start": 11.699,
    "end": 17.099,
    "duration": 5.4
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后塑出“清醒疯子”自审与“救救孩子”启蒙高度。",
    "start": 17.549,
    "end": 21.269,
    "duration": 3.72
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "五四鲁迅发表于《新青年》的《狂人日记》是现代白话小说奠基之作。",
    "start": 21.719,
    "end": 27.119,
    "duration": 5.4
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "鲁迅自括其显示了“表现的深切和格式的特别”，树思想与形式革新典范。",
    "start": 27.569,
    "end": 33.489,
    "duration": 5.92
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · “表现的深切”：礼教“吃人”本质与社会共谋",
    "start": 33.939,
    "end": 38.259,
    "duration": 4.32
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "借狂人非常视角穿透仁义修辞，从历史字缝看出“吃人”二字，",
    "start": 38.709,
    "end": 43.709,
    "duration": 5.0
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "宣判专制传统；",
    "start": 44.159,
    "end": 45.559,
    "duration": 1.4
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "“古久先生”簿子、赵贵翁眼色、看客、何先生乃至于长兄织成共谋网；",
    "start": 46.089,
    "end": 51.809,
    "duration": 5.72
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "惊疑“未必无意之中，不吃了我妹子的几片肉”直剖伦理毒害，见启蒙清醒。",
    "start": 52.259,
    "end": 58.099,
    "duration": 5.84
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · “格式的特别”：复合叙事框架与心理象征",
    "start": 58.549,
    "end": 62.629,
    "duration": 4.08
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "开篇理性文言“小序”交代“赴某地候补矣”，隐喻正统对反叛的驯化收编；",
    "start": 63.079,
    "end": 68.479,
    "duration": 5.4
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "随后十三则白话日记呈非逻辑独白，形成互相拆解的结构反讽张力；",
    "start": 68.929,
    "end": 74.969,
    "duration": 6.04
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "融西方象征表现技巧，赋惨白月光、赵贵翁眼色、何先生诊脉以社会象征，",
    "start": 75.419,
    "end": 82.019,
    "duration": 6.6
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "立白话小说高度。",
    "start": 82.469,
    "end": 83.949,
    "duration": 1.48
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · “清醒的疯子”：自省与反抗绝望的启蒙精神",
    "start": 84.399,
    "end": 88.839,
    "duration": 4.44
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "既是逼真迫害妄想患者，更是最早质疑“从来如此，便对么？",
    "start": 89.289,
    "end": 93.809,
    "duration": 4.52
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "”的觉醒先驱，敢于在“四千年吃人履历”中直面自身罪责；",
    "start": 94.339,
    "end": 98.859,
    "duration": 4.52
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "末发“救救孩子……”沉痛呼告，蕴含明知传统沉重却反抗绝望之勇气，",
    "start": 99.389,
    "end": 105.069,
    "duration": 5.68
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "升华为挽救民族未来的启蒙宣言。",
    "start": 105.519,
    "end": 108.359,
    "duration": 2.84
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《狂人日记》以“表现的深切”直击传统与国民性病灶，",
    "start": 108.809,
    "end": 112.489,
    "duration": 3.68
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "以“格式的特别”推动叙事从古典向现代转型，成五四先声与奠基之作。",
    "start": 112.939,
    "end": 119.139,
    "duration": 6.2
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅自己概括其成就为“表现的深切和格式的特别”；",
    "start": 119.589,
    "end": 124.469,
    "duration": 4.88
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "末尾呐喊是“救救孩子……”，",
    "start": 124.999,
    "end": 126.599,
    "duration": 1.6
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "小序实为讽刺狂人被正统收编“赴某地候补”。",
    "start": 127.049,
    "end": 130.649,
    "duration": 3.6
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 结合文言小序、十三则白话日记与现代象征，",
    "start": 131.099,
    "end": 135.659,
    "duration": 4.56
  },
  {
    "id": "drill0_c1",
    "dom_key": "drill0_c1",
    "text": "解透什么是“格式的特别”？",
    "start": 136.109,
    "end": 138.069,
    "duration": 1.96
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合“四千年吃人履历”与“未必无意不吃妹子肉”，",
    "start": 138.519,
    "end": 142.399,
    "duration": 3.88
  },
  {
    "id": "drill1_c1",
    "dom_key": "drill1_c1",
    "text": "解释何谓“表现的深切”？",
    "start": 142.849,
    "end": 144.729,
    "duration": 1.88
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2014/2015 年真题简答：",
    "start": 145.179,
    "end": 148.739,
    "duration": 3.56
  },
  {
    "id": "drill2_c1",
    "dom_key": "drill2_c1",
    "text": "《狂人日记》中“狂人形象的意义”？",
    "start": 149.189,
    "end": 151.309,
    "duration": 2.12
  }
]