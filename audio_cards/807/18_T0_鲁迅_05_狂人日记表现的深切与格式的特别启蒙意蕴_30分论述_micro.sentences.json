[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "鲁迅·狂人日记表现的深切与格式的特别启蒙意蕴",
    "start": 0.154,
    "end": 4.966,
    "duration": 4.812
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣鲁迅自己概括的“表现的深切和格式的特别”三步立柱：",
    "start": 5.597,
    "end": 11.929,
    "duration": 6.332
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先剖礼教“吃人”且全家全村构成“共谋网”与“未必无意不吃妹肉”之深切，",
    "start": 12.317,
    "end": 18.889,
    "duration": 6.572
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再拆文言小序vs十三则白话日记复调框架与象征之特别，",
    "start": 19.197,
    "end": 24.649,
    "duration": 5.452
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后塑出“清醒疯子”自审与“救救孩子”启蒙高度。",
    "start": 24.957,
    "end": 29.529,
    "duration": 4.572
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "五四鲁迅发表于《新青年》的《狂人日记》是现代白话小说奠基之作。",
    "start": 30.012,
    "end": 35.224,
    "duration": 5.212
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "鲁迅自括其显示了“表现的深切和格式的特别”，树思想与形式革新典范。",
    "start": 35.502,
    "end": 42.154,
    "duration": 6.652
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · “表现的深切”：礼教“吃人”本质与社会共谋",
    "start": 42.847,
    "end": 46.699,
    "duration": 3.852
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "借狂人非常视角穿透仁义修辞，从历史字缝看出“吃人”二字，宣判专制传统；",
    "start": 47.202,
    "end": 53.854,
    "duration": 6.652
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "“古久先生”簿子、赵贵翁眼色、看客、何先生乃至于长兄织成共谋网；",
    "start": 54.376,
    "end": 61.668,
    "duration": 7.292
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "惊疑“未必无意之中，不吃了我妹子的几片肉”直剖伦理毒害，见启蒙清醒。",
    "start": 61.946,
    "end": 68.598,
    "duration": 6.652
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · “格式的特别”：复合叙事框架与心理象征",
    "start": 69.227,
    "end": 73.159,
    "duration": 3.932
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "开篇理性文言“小序”交代“赴某地候补矣”，隐喻正统对反叛的驯化收编；",
    "start": 73.687,
    "end": 80.259,
    "duration": 6.572
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "随后十三则白话日记呈非逻辑独白，形成互相拆解的结构反讽张力；",
    "start": 80.697,
    "end": 85.989,
    "duration": 5.292
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "融西方象征表现技巧，赋惨白月光、赵贵翁眼色、何先生诊脉以社会象征，立白话小说高度。",
    "start": 86.377,
    "end": 96.229,
    "duration": 9.852
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · “清醒的疯子”：自省与反抗绝望的启蒙精神",
    "start": 96.738,
    "end": 101.07,
    "duration": 4.332
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "既是逼真迫害妄想患者，更是最早质疑“从来如此，便对么？”的觉醒先驱，",
    "start": 101.598,
    "end": 109.29,
    "duration": 7.692
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "敢于在“四千年吃人履历”中直面自身罪责；",
    "start": 109.598,
    "end": 112.73,
    "duration": 3.132
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "末发“救救孩子……”沉痛呼告，蕴含明知传统沉重却反抗绝望之勇气，升华为挽救民族未来的启蒙宣言。",
    "start": 113.195,
    "end": 123.287,
    "duration": 10.092
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《狂人日记》以“表现的深切”直击传统与国民性病灶，",
    "start": 123.892,
    "end": 128.657,
    "duration": 4.765
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "以“格式的特别”推动叙事从古典向现代转型，成五四先声与奠基之作。",
    "start": 128.672,
    "end": 135.344,
    "duration": 6.672
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅自己概括其成就为“表现的深切和格式的特别”；",
    "start": 135.852,
    "end": 141.064,
    "duration": 5.212
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "末尾呐喊是“救救孩子……”，小序实为讽刺狂人被正统收编“赴某地候补”。",
    "start": 141.422,
    "end": 147.674,
    "duration": 6.252
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 结合文言小序、十三则白话日记与现代象征，解透什么是“格式的特别”？",
    "start": 148.335,
    "end": 155.947,
    "duration": 7.612
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合“四千年吃人履历”与“未必无意不吃妹子肉”，解释何谓“表现的深切”？",
    "start": 156.475,
    "end": 164.167,
    "duration": 7.692
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2014/2015 年真题简答：《狂人日记》中“狂人形象的意义”？",
    "start": 164.695,
    "end": 171.587,
    "duration": 6.892
  }
]