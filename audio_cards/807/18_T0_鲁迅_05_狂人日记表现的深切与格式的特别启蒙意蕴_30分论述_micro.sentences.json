[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "鲁迅·狂人日记表现的深切与格式的特别启蒙意蕴",
    "start": 0.314,
    "end": 5.206,
    "duration": 4.892
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣鲁迅自己概括的“表现的深切和格式的特别”三步立柱：",
    "start": 6.174,
    "end": 11.946,
    "duration": 5.772
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "先剖礼教“吃人”且全家全村构成“共谋网”与“未必无意不吃妹肉”之深切，",
    "start": 12.334,
    "end": 18.666,
    "duration": 6.332
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "再拆文言小序vs十三则白话日记复调框架与象征之特别，",
    "start": 18.934,
    "end": 24.906,
    "duration": 5.972
  },
  {
    "id": "hook_c3",
    "dom_key": "hook_c3",
    "text": "最后塑出“清醒疯子”自审与“救救孩子”启蒙高度。",
    "start": 25.254,
    "end": 29.506,
    "duration": 4.252
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "五四鲁迅发表于《新青年》的《狂人日记》是现代白话小说奠基之作。",
    "start": 30.474,
    "end": 36.086,
    "duration": 5.612
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "鲁迅自括其显示了“表现的深切和格式的特别”，树思想与形式革新典范。",
    "start": 37.094,
    "end": 43.426,
    "duration": 6.332
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · “表现的深切”：礼教“吃人”本质与社会共谋",
    "start": 44.314,
    "end": 48.806,
    "duration": 4.492
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "借狂人非常视角穿透仁义修辞，从历史字缝看出“吃人”二字，宣判专制传统；",
    "start": 49.854,
    "end": 57.946,
    "duration": 8.092
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "“古久先生”簿子、赵贵翁眼色、看客、何先生乃至于长兄织成共谋网；",
    "start": 58.954,
    "end": 65.886,
    "duration": 6.932
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "惊疑“未必无意之中，不吃了我妹子的几片肉”直剖伦理毒害，见启蒙清醒。",
    "start": 66.894,
    "end": 73.546,
    "duration": 6.652
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · “格式的特别”：复合叙事框架与心理象征",
    "start": 74.474,
    "end": 78.526,
    "duration": 4.052
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "开篇理性文言“小序”交代“赴某地候补矣”，隐喻正统对反叛的驯化收编；",
    "start": 79.534,
    "end": 87.426,
    "duration": 7.892
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "随后十三则白话日记呈非逻辑独白，形成互相拆解的结构反讽张力；",
    "start": 88.514,
    "end": 94.206,
    "duration": 5.692
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "融西方象征表现技巧，赋惨白月光、赵贵翁眼色、何先生诊脉以社会象征，立白话小说高度。",
    "start": 94.68,
    "end": 104.492,
    "duration": 9.812
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · “清醒的疯子”：自省与反抗绝望的启蒙精神",
    "start": 105.108,
    "end": 109.44,
    "duration": 4.332
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "既是逼真迫害妄想患者，更是最早质疑“从来如此，便对么？”的觉醒先驱，",
    "start": 110.172,
    "end": 117.424,
    "duration": 7.252
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "敢于在“四千年吃人履历”中直面自身罪责；",
    "start": 117.692,
    "end": 121.024,
    "duration": 3.332
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "末发“救救孩子……”沉痛呼告，蕴含明知传统沉重却反抗绝望之勇气，升华为挽救民族未来的启蒙宣言。",
    "start": 121.992,
    "end": 131.884,
    "duration": 9.892
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《狂人日记》以“表现的深切”直击传统与国民性病灶，",
    "start": 132.892,
    "end": 137.304,
    "duration": 4.412
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "以“格式的特别”推动叙事从古典向现代转型，成五四先声与奠基之作。",
    "start": 137.652,
    "end": 143.664,
    "duration": 6.012
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：鲁迅自己概括其成就为“表现的深切和格式的特别”；",
    "start": 144.712,
    "end": 150.124,
    "duration": 5.412
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "末尾呐喊是“救救孩子……”，小序实为讽刺狂人被正统收编“赴某地候补”。",
    "start": 151.092,
    "end": 157.504,
    "duration": 6.412
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 结合文言小序、十三则白话日记与现代象征，解透什么是“格式的特别”？",
    "start": 158.472,
    "end": 165.884,
    "duration": 7.412
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合“四千年吃人履历”与“未必无意不吃妹子肉”，解释何谓“表现的深切”？",
    "start": 166.932,
    "end": 174.784,
    "duration": 7.852
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2014/2015 年真题简答：《狂人日记》中“狂人形象的意义”？",
    "start": 175.712,
    "end": 183.124,
    "duration": 7.412
  }
]