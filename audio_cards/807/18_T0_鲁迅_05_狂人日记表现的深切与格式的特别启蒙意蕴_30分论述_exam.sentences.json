[
  {
    "id": 1,
    "text": "结合鲁迅《狂人日记》具体文本，试论其“表现的深切和格式的特别”及其启蒙主义思想意蕴。",
    "start": 0.2,
    "end": 7.88,
    "duration": 7.68
  },
  {
    "id": 2,
    "text": "五四新文化运动时期鲁迅发表于《新青年》的白话短篇小说《狂人日记》，",
    "start": 8.4,
    "end": 13.76,
    "duration": 5.36
  },
  {
    "id": 3,
    "text": "是中国现代白话小说的奠基之作。",
    "start": 14.13,
    "end": 17.25,
    "duration": 3.12
  },
  {
    "id": 4,
    "text": "鲁迅后来在《中国新文学大系·小说二集序》中概括其显示了“表现的深切和格式的特别”。",
    "start": 17.77,
    "end": 24.89,
    "duration": 7.12
  },
  {
    "id": 5,
    "text": "小说以冷峻的历史眼光揭开数千年封建宗法礼教的温情帷幕，",
    "start": 25.41,
    "end": 30.05,
    "duration": 4.64
  },
  {
    "id": 6,
    "text": "又以自觉的现代文体意识打破传统叙事格局，树立了五四思想革命与形式革新的典范。",
    "start": 30.42,
    "end": 38.1,
    "duration": 7.68
  },
  {
    "id": 7,
    "text": "其思想意蕴与艺术成就主要体现在以下三个维度：",
    "start": 38.654,
    "end": 42.14,
    "duration": 3.486
  },
  {
    "id": 8,
    "text": "第一，开掘“表现的深切”，揭露宗法礼教“吃人”的本质与社会共谋。",
    "start": 42.51,
    "end": 47.87,
    "duration": 5.36
  },
  {
    "id": 9,
    "text": "鲁迅借狂人的非常视角，穿透历代封建史书仁义道德的虚伪修辞，",
    "start": 48.39,
    "end": 53.91,
    "duration": 5.52
  },
  {
    "id": 10,
    "text": "从历史字缝里看出满本写着的“吃人”二字，向数千年专制传统发出严正宣判。",
    "start": 54.328,
    "end": 60.84,
    "duration": 6.512
  },
  {
    "id": 11,
    "text": "更为深刻的是，小说指出“吃人”不仅是个体恶行，更是一张全社会普遍参与、互为因果的共谋之网。",
    "start": 61.36,
    "end": 70.228,
    "duration": 8.868
  },
  {
    "id": 12,
    "text": "从“古久先生”陈年流水簿子代表的传统积习、乡绅赵贵翁的阴鸷眼色，",
    "start": 70.728,
    "end": 76.2,
    "duration": 5.472
  },
  {
    "id": 13,
    "text": "到街头指点议论的看客与把脉开方的何先生，甚至连同胞长兄也被狂人视为吃人者；",
    "start": 76.57,
    "end": 83.61,
    "duration": 7.04
  },
  {
    "id": 14,
    "text": "小说更借狂人惊疑长兄把妹子的肉混入饭菜、乃至反复自省“我未必无意之中，不吃了我妹子的几片肉”的心理描写，",
    "start": 84.13,
    "end": 93.54,
    "duration": 9.41
  },
  {
    "id": 15,
    "text": "深入剖示了封建伦理对人伦至亲的扭曲与毒害，展现出五四启蒙者触及文明创痛时的清醒。",
    "start": 93.94,
    "end": 101.86,
    "duration": 7.92
  },
  {
    "id": 16,
    "text": "第二，践行“格式的特别”，首创复合叙事框架与心理象征手法。",
    "start": 102.38,
    "end": 107.74,
    "duration": 5.36
  },
  {
    "id": 17,
    "text": "《狂人日记》脱离了中国古代小说注重有头有尾、全知讲述的传统章法，",
    "start": 108.26,
    "end": 114.0,
    "duration": 5.74
  },
  {
    "id": 18,
    "text": "建立了现代小说史上前所未有的双重文本结构。",
    "start": 114.37,
    "end": 118.47,
    "duration": 4.1
  },
  {
    "id": 19,
    "text": "开篇理性冷静的文言“小序”，以正统士大夫口吻交代狂人病愈后“赴某地候补矣”，",
    "start": 118.99,
    "end": 125.95,
    "duration": 6.96
  },
  {
    "id": 20,
    "text": "隐喻封建正统秩序对反叛个性的驯化与收编；",
    "start": 126.32,
    "end": 129.92,
    "duration": 3.6
  },
  {
    "id": 21,
    "text": "随后展开的十三则白话日记，则是狂人充满非逻辑跳跃、惊恐幻觉与真知灼见的内心独白。",
    "start": 130.473,
    "end": 138.04,
    "duration": 7.567
  },
  {
    "id": 22,
    "text": "这种文言与白话、外部世俗常轨与内部精神反叛的并置，",
    "start": 138.56,
    "end": 143.52,
    "duration": 4.96
  },
  {
    "id": 23,
    "text": "形成了互相嘲弄与拆解的结构性反讽张力。",
    "start": 143.92,
    "end": 147.92,
    "duration": 4.0
  },
  {
    "id": 24,
    "text": "同时，鲁迅融汇西方象征主义与表现主义技巧，",
    "start": 148.44,
    "end": 152.28,
    "duration": 3.84
  },
  {
    "id": 25,
    "text": "赋予惨白月光、赵贵翁眼色、何先生诊脉等意象以社会象征意味，",
    "start": 152.65,
    "end": 158.65,
    "duration": 6.0
  },
  {
    "id": 26,
    "text": "奠定了现代白话小说的艺术高度。",
    "start": 159.02,
    "end": 161.74,
    "duration": 2.72
  },
  {
    "id": 27,
    "text": "第三，塑造“清醒的疯子”形象，呈现先驱者自省与反抗绝望的精神。",
    "start": 162.26,
    "end": 168.26,
    "duration": 6.0
  },
  {
    "id": 28,
    "text": "狂人既是描摹逼真的迫害妄想症患者，更是封建死屋中最早觉醒、敢于质疑“从来如此，便对么？”的启蒙先驱。",
    "start": 168.78,
    "end": 178.057,
    "duration": 9.277
  },
  {
    "id": 29,
    "text": "他在严酷的生存压迫下看清了历史延续的吃人链条，并在“四千年吃人履历”的拷问中敢于直面自身罪责，",
    "start": 178.577,
    "end": 187.72,
    "duration": 9.143
  },
  {
    "id": 30,
    "text": "展现出启蒙知识分子严苛的道德诚实与自审品格。",
    "start": 188.09,
    "end": 192.09,
    "duration": 4.0
  },
  {
    "id": 31,
    "text": "篇末狂人在孤立绝境中发出“救救孩子……”的沉痛呐喊，",
    "start": 192.61,
    "end": 197.502,
    "duration": 4.892
  },
  {
    "id": 32,
    "text": "蕴含着五四知识分子明知传统惯性沉重、却依然反抗绝望的先知勇气，",
    "start": 197.857,
    "end": 204.15,
    "duration": 6.293
  },
  {
    "id": 33,
    "text": "将全篇升华为挽救民族未来的启蒙宣言。",
    "start": 204.52,
    "end": 207.88,
    "duration": 3.36
  },
  {
    "id": 34,
    "text": "合其思想与文体而言，鲁迅《狂人日记》以“表现的深切”直击传统文化与国民性病灶，",
    "start": 208.4,
    "end": 215.92,
    "duration": 7.52
  },
  {
    "id": 35,
    "text": "以“格式的特别”推动中国叙事文学从古典向现代转型。",
    "start": 216.29,
    "end": 220.69,
    "duration": 4.4
  },
  {
    "id": 36,
    "text": "它不仅是五四新文化运动的思想先声，更是中国现代小说史上具有划时代意义的奠基之作。",
    "start": 221.21,
    "end": 228.41,
    "duration": 7.2
  }
]
