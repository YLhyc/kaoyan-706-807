[
  {
    "id": 1,
    "text": "结合鲁迅《狂人日记》具体文本，",
    "start": 0.0,
    "end": 2.583,
    "duration": 2.583
  },
  {
    "id": 2,
    "text": "试论其“表现的深切和格式的特别”及其启蒙主义思想意蕴。。",
    "start": 2.583,
    "end": 7.924,
    "duration": 5.341
  },
  {
    "id": 3,
    "text": "五四新文化运动时期鲁迅发表于《新青年》的白话短篇小说《狂人日记》，",
    "start": 7.924,
    "end": 13.482,
    "duration": 5.558
  },
  {
    "id": 4,
    "text": "是中国现代白话小说的奠基与发轫之作。",
    "start": 13.482,
    "end": 17.26,
    "duration": 3.778
  },
  {
    "id": 5,
    "text": "茅盾在《中国新文学大系·小说一集导言》中曾作出经典概括，",
    "start": 17.26,
    "end": 22.477,
    "duration": 5.217
  },
  {
    "id": 6,
    "text": "指出其显示了“表现的深切和格式的特别”。",
    "start": 22.477,
    "end": 26.139,
    "duration": 3.662
  },
  {
    "id": 7,
    "text": "小说以冷峻的历史哲学眼光撕开数千年封建宗法礼教的温情帷幕，",
    "start": 26.139,
    "end": 31.691,
    "duration": 5.552
  },
  {
    "id": 8,
    "text": "又以高度自觉的现代文体意识打破了传统中国叙事的古典格局，",
    "start": 31.691,
    "end": 36.489,
    "duration": 4.798
  },
  {
    "id": 9,
    "text": "树立了五四新文学思想革命与形式革新交相辉映的最高典范。",
    "start": 36.489,
    "end": 41.528,
    "duration": 5.039
  },
  {
    "id": 10,
    "text": "其思想意蕴与艺术成就主要体现在以下三个核心维度：",
    "start": 41.528,
    "end": 45.733,
    "duration": 4.205
  },
  {
    "id": 11,
    "text": "第一，在“表现的深切”上，",
    "start": 45.733,
    "end": 47.781,
    "duration": 2.048
  },
  {
    "id": 12,
    "text": "以深邃的历史哲学批判揭露宗法礼教的“吃人”本质与社会共谋机制。",
    "start": 47.781,
    "end": 55.315,
    "duration": 7.534
  },
  {
    "id": 13,
    "text": "鲁迅借狂人的癫狂之眼，",
    "start": 55.315,
    "end": 57.076,
    "duration": 1.761
  },
  {
    "id": 14,
    "text": "穿透了历代封建史书仁义道德的虚伪修辞，",
    "start": 57.076,
    "end": 60.164,
    "duration": 3.088
  },
  {
    "id": 15,
    "text": "从历史的字缝里看出了满本密密麻麻写着的“吃人”二字，",
    "start": 60.164,
    "end": 67.099,
    "duration": 6.935
  },
  {
    "id": 16,
    "text": "向数千年专制传统发出了惊世骇俗的历史宣判。",
    "start": 67.099,
    "end": 72.041,
    "duration": 4.942
  },
  {
    "id": 17,
    "text": "更深切的是，小说深刻揭示出“吃人”绝非孤立的个体恶行，",
    "start": 72.041,
    "end": 76.16,
    "duration": 4.119
  },
  {
    "id": 18,
    "text": "而是一张全社会普遍参与、互为因果的共谋黑网。",
    "start": 76.16,
    "end": 81.909,
    "duration": 5.749
  },
  {
    "id": 19,
    "text": "从赵贵翁等乡绅统治者的阴鸷目光，",
    "start": 81.909,
    "end": 84.85,
    "duration": 2.941
  },
  {
    "id": 20,
    "text": "到街头指点嗤笑的平民看客，甚至狂人的同胞长兄亦深陷其中；",
    "start": 84.85,
    "end": 90.279,
    "duration": 5.429
  },
  {
    "id": 21,
    "text": "作品通过长兄将妹子的肉混入饭菜逼迫狂人吃下的惊心细节，",
    "start": 90.279,
    "end": 94.213,
    "duration": 3.934
  },
  {
    "id": 22,
    "text": "彻底解剖了封建伦理对人伦至亲的扭曲与异化。",
    "start": 94.213,
    "end": 98.754,
    "duration": 4.541
  },
  {
    "id": 23,
    "text": "这种由家族伦理延伸至民族肌体的全方位病理解剖，",
    "start": 98.754,
    "end": 104.026,
    "duration": 5.272
  },
  {
    "id": 24,
    "text": "展现了五四启蒙者触碰文明创痛时的沉痛清醒。",
    "start": 104.026,
    "end": 109.318,
    "duration": 5.292
  },
  {
    "id": 25,
    "text": "第二，在“格式的特别”上，",
    "start": 109.318,
    "end": 111.082,
    "duration": 1.764
  },
  {
    "id": 26,
    "text": "首创“文言小序＋白话正文”的复合叙事框架与现代心理象征范式。",
    "start": 111.082,
    "end": 117.992,
    "duration": 6.91
  },
  {
    "id": 27,
    "text": "《狂人日记》在形式上彻底脱离了中国古代小说的讲唱说书人传统，",
    "start": 117.992,
    "end": 125.853,
    "duration": 7.861
  },
  {
    "id": 28,
    "text": "建立了中国小说史上前所未有的双重文本互文结构。",
    "start": 125.853,
    "end": 129.316,
    "duration": 3.463
  },
  {
    "id": 29,
    "text": "开篇客观理性的文言小序，",
    "start": 129.316,
    "end": 131.63,
    "duration": 2.314
  },
  {
    "id": 30,
    "text": "以正统士大夫口吻交代狂人病愈后“赴某地候补矣”，",
    "start": 131.63,
    "end": 136.669,
    "duration": 5.039
  },
  {
    "id": 31,
    "text": "隐喻着封建正统意识形态对反叛个性的最终驯化与收编；",
    "start": 136.669,
    "end": 142.142,
    "duration": 5.473
  },
  {
    "id": 32,
    "text": "而随后展开的十三则白话日记，则是狂人充满非逻辑跳跃、",
    "start": 142.142,
    "end": 147.42,
    "duration": 5.278
  },
  {
    "id": 33,
    "text": "惊恐幻觉与真知灼见的心灵独白。",
    "start": 147.42,
    "end": 151.491,
    "duration": 4.071
  },
  {
    "id": 34,
    "text": "这一文言与白话、外部世俗常轨与内部精神反叛的强烈并置，",
    "start": 151.491,
    "end": 154.313,
    "duration": 2.822
  },
  {
    "id": 35,
    "text": "形成了结构性的反讽张力。",
    "start": 154.313,
    "end": 157.717,
    "duration": 3.404
  },
  {
    "id": 36,
    "text": "同时，鲁迅广泛汲取西方现代象征主义与表现主义技巧，",
    "start": 157.717,
    "end": 161.333,
    "duration": 3.616
  },
  {
    "id": 37,
    "text": "赋予惨白的月光、赵贵翁的眼色、",
    "start": 161.333,
    "end": 165.372,
    "duration": 4.039
  },
  {
    "id": 38,
    "text": "何先生的诊脉等具象以多重社会象征意蕴，",
    "start": 165.372,
    "end": 168.929,
    "duration": 3.557
  },
  {
    "id": 39,
    "text": "奠定了现代白话小说的纯正审美高度。",
    "start": 168.929,
    "end": 171.963,
    "duration": 3.034
  },
  {
    "id": 40,
    "text": "第三，在启蒙精神与心理机制上，塑造“清醒的疯子”形象，",
    "start": 171.963,
    "end": 174.157,
    "duration": 2.194
  },
  {
    "id": 41,
    "text": "确立先驱者自省与绝望抗争的启蒙标杆。",
    "start": 174.157,
    "end": 177.689,
    "duration": 3.532
  },
  {
    "id": 42,
    "text": "狂人绝非医学意义上的普通精神病患，",
    "start": 177.689,
    "end": 181.24,
    "duration": 3.551
  },
  {
    "id": 43,
    "text": "而是封建死屋中最早觉醒、",
    "start": 181.24,
    "end": 186.81,
    "duration": 5.57
  },
  {
    "id": 44,
    "text": "敢于向庞大旧秩序独挑战端的启蒙先驱。",
    "start": 186.81,
    "end": 191.144,
    "duration": 4.334
  },
  {
    "id": 45,
    "text": "他在严酷的生存压迫下看清了历史的吃人链条，",
    "start": 191.144,
    "end": 195.352,
    "duration": 4.208
  },
  {
    "id": 46,
    "text": "并在最深沉的心灵拷问中敏锐反思自身是否也曾在无意间吃过妹子的肉，",
    "start": 195.352,
    "end": 197.306,
    "duration": 1.954
  },
  {
    "id": 47,
    "text": "展现了现代启蒙知识分子严苛的自审品格与道德诚实。",
    "start": 197.306,
    "end": 199.644,
    "duration": 2.338
  },
  {
    "id": 48,
    "text": "小说结尾处，",
    "start": 199.644,
    "end": 205.932,
    "duration": 6.288
  },
  {
    "id": 49,
    "text": "狂人在四面楚歌的窒息绝境中发出了“救救孩子……”的泣血呐喊；",
    "start": 205.932,
    "end": 209.382,
    "duration": 3.45
  },
  {
    "id": 50,
    "text": "这一呼喊绝非廉价的乐观许诺，",
    "start": 209.382,
    "end": 213.874,
    "duration": 4.492
  },
  {
    "id": 51,
    "text": "而是五四一代知识分子在深知传统惯性巨大、",
    "start": 213.874,
    "end": 214.978,
    "duration": 1.104
  },
  {
    "id": 52,
    "text": "深陷精神荒原的清醒绝望中，",
    "start": 214.978,
    "end": 216.306,
    "duration": 1.328
  },
  {
    "id": 53,
    "text": "依然孤注一掷抗争到底的先知式生命绝叫，",
    "start": 216.306,
    "end": 219.33,
    "duration": 3.024
  },
  {
    "id": 54,
    "text": "将全剧升华为挽救民族未来的崇高启蒙宪章。",
    "start": 219.33,
    "end": 221.612,
    "duration": 2.282
  },
  {
    "id": 55,
    "text": "综上所述，",
    "start": 221.612,
    "end": 222.886,
    "duration": 1.274
  },
  {
    "id": 56,
    "text": "鲁迅《狂人日记》以“表现的深切”开掘了中国传统文化与国民劣根性的病灶根源，",
    "start": 222.886,
    "end": 224.683,
    "duration": 1.797
  },
  {
    "id": 57,
    "text": "以“格式的特别”完成了中国叙事文学从古典向现代的惊世蜕变。",
    "start": 224.683,
    "end": 229.902,
    "duration": 5.219
  },
  {
    "id": 58,
    "text": "它不仅是五四新文化运动的思想火炬，",
    "start": 229.902,
    "end": 231.946,
    "duration": 2.044
  },
  {
    "id": 59,
    "text": "更是中国现代文学百年来无可替代的开山丰碑。",
    "start": 231.946,
    "end": 233.856,
    "duration": 1.91
  }
]