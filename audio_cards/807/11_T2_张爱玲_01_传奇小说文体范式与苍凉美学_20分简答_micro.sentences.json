[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "写什么日常（倾城之恋）→剖多深心理（金锁记）→用什么意象造冷艳感（月亮泪珠/葱绿配桃红），",
    "start": 0.0,
    "end": 8.64,
    "duration": 8.64
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "三点紧扣四十年代沦陷区上海“苍凉美学”。",
    "start": 8.689,
    "end": 12.329,
    "duration": 3.64
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "四十年代沦陷区上海，",
    "start": 12.779,
    "end": 14.659,
    "duration": 1.88
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "张爱玲以《传奇》小说集在抗战宏大叙事之外开辟都市现代“传奇”视界，",
    "start": 15.109,
    "end": 20.629,
    "duration": 5.52
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "独树苍凉美学。",
    "start": 21.079,
    "end": 22.439,
    "duration": 1.36
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 聚焦乱世日常世俗、揭示荒凉苍凉底色",
    "start": 22.969,
    "end": 27.449,
    "duration": 4.48
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "避开非黑即白意识形态，凝视都市男女物质欲望与生存心理博弈；",
    "start": 27.899,
    "end": 33.139,
    "duration": 5.24
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "白流苏与范柳原在浅水湾斤斤计较自私盘算，",
    "start": 33.589,
    "end": 37.509,
    "duration": 3.92
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "直到战火漫卷香港、断壁残垣生死边缘方获得平凡婚姻，",
    "start": 37.959,
    "end": 42.759,
    "duration": 4.8
  },
  {
    "id": "sec0_step1_c2",
    "dom_key": "sec0_step1_c2",
    "text": "凸显小人物在时代倾覆中的脆弱宿命。",
    "start": 43.209,
    "end": 46.169,
    "duration": 2.96
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 深潜潜意识暗角、解剖病态心理畸变",
    "start": 46.619,
    "end": 50.939,
    "duration": 4.32
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "融传统世情白描与西方现代心理分析为一体；",
    "start": 51.389,
    "end": 54.869,
    "duration": 3.48
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "曹七巧受门第歧视与病残丈夫折磨，将情感寄于金钱，",
    "start": 55.319,
    "end": 60.239,
    "duration": 4.92
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "戴上黄金枷锁后折磨芝寿致死、拆散长安婚事；",
    "start": 60.689,
    "end": 64.889,
    "duration": 4.2
  },
  {
    "id": "sec1_step1_c2",
    "dom_key": "sec1_step1_c2",
    "text": "识破季泽骗局时打翻的酸梅汤滴落如迟迟夜漏，写尽被礼教与金欲吞噬之悲。",
    "start": 65.339,
    "end": 71.819,
    "duration": 6.48
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 古典白描融意象主义、造斑斓鬼气意象",
    "start": 72.269,
    "end": 76.789,
    "duration": 4.52
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "华美冷艳，善用陌生化的通感、奇诡比喻与强对比色彩；",
    "start": 77.239,
    "end": 81.759,
    "duration": 4.52
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "将三十年前月亮比作“红黄湿晕，像朵云轩信笺落泪珠”；",
    "start": 82.209,
    "end": 86.929,
    "duration": 4.72
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "“葱绿配桃红”感官刺激背后弥漫繁华散尽的末世虚无，成苍凉美学范式。",
    "start": 87.499,
    "end": 93.779,
    "duration": 6.28
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：四十年代沦陷区上海《传奇》小说集；",
    "start": 94.229,
    "end": 98.109,
    "duration": 3.88
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "重点代表作：《倾城之恋》（白流苏、范柳原，",
    "start": 98.559,
    "end": 101.999,
    "duration": 3.44
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "香港沦陷促成婚姻）与《金锁记》（曹七巧、芝寿、长安、季泽、酸梅汤夜漏）。",
    "start": 102.449,
    "end": 108.689,
    "duration": 6.24
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 结合《倾城之恋》说明“香港沦陷”与“平凡婚姻”之间的荒诞苍凉逻辑？",
    "start": 109.139,
    "end": 115.619,
    "duration": 6.48
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合曹七巧、芝寿、长安、季泽及“酸梅汤”细节分析《金锁记》心理病态？",
    "start": 116.069,
    "end": 123.349,
    "duration": 7.28
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 概括张爱玲在《传奇》中融合古典世情白描与西方心理/意象主义的独特范式？",
    "start": 123.799,
    "end": 131.599,
    "duration": 7.8
  }
]