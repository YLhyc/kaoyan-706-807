[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "张爱玲·传奇小说文体范式与苍凉美学",
    "start": 0.154,
    "end": 4.246,
    "duration": 4.092
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "写什么日常（倾城之恋）→剖多深心理（金锁记）→用什么意象造冷艳感（月亮泪珠/葱绿配桃红），",
    "start": 4.954,
    "end": 14.966,
    "duration": 10.012
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "三点紧扣四十年代沦陷区上海“苍凉美学”。",
    "start": 15.354,
    "end": 18.806,
    "duration": 3.452
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "四十年代沦陷区上海，张爱玲以《传奇》小说集在抗战宏大叙事之外开辟都市现代“传奇”视界，独树苍凉美学。",
    "start": 19.334,
    "end": 27.826,
    "duration": 8.492
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 聚焦乱世日常世俗、揭示荒凉苍凉底色",
    "start": 28.502,
    "end": 32.834,
    "duration": 4.332
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "避开非黑即白意识形态，凝视都市男女物质欲望与生存心理博弈；",
    "start": 33.35,
    "end": 39.522,
    "duration": 6.172
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "白流苏与范柳原在浅水湾斤斤计较自私盘算，",
    "start": 39.967,
    "end": 45.499,
    "duration": 5.532
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "直到战火漫卷香港、断壁残垣生死边缘方获得平凡婚姻，凸显小人物在时代倾覆中的脆弱宿命。",
    "start": 45.807,
    "end": 53.579,
    "duration": 7.772
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 深潜潜意识暗角、解剖病态心理畸变",
    "start": 54.261,
    "end": 58.353,
    "duration": 4.092
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "融传统世情白描与西方现代心理分析为一体；",
    "start": 58.881,
    "end": 64.173,
    "duration": 5.292
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "曹七巧受门第歧视与病残丈夫折磨，将情感寄于金钱，戴上黄金枷锁后折磨芝寿致死、拆散长安婚事；",
    "start": 64.604,
    "end": 76.216,
    "duration": 11.612
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "识破季泽骗局时打翻的酸梅汤滴落如迟迟夜漏，写尽被礼教与金欲吞噬之悲。",
    "start": 76.494,
    "end": 83.786,
    "duration": 7.292
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 古典白描融意象主义、造斑斓鬼气意象",
    "start": 84.475,
    "end": 88.887,
    "duration": 4.412
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "华美冷艳，善用陌生化的通感、奇诡比喻与强对比色彩；",
    "start": 89.379,
    "end": 94.671,
    "duration": 5.292
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "将三十年前月亮比作“红黄湿晕，像朵云轩信笺落泪珠”；",
    "start": 95.134,
    "end": 100.666,
    "duration": 5.532
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "“葱绿配桃红”感官刺激背后弥漫繁华散尽的末世虚无，成苍凉美学范式。",
    "start": 100.864,
    "end": 107.676,
    "duration": 6.812
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：四十年代沦陷区上海《传奇》小说集；",
    "start": 108.246,
    "end": 112.418,
    "duration": 4.172
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "重点代表作：《倾城之恋》（白流苏、范柳原，香港沦陷促成婚姻）与《金锁记》（曹七巧、芝寿、长安、季泽、酸梅汤夜漏）。",
    "start": 112.776,
    "end": 123.828,
    "duration": 11.052
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 结合《倾城之恋》说明“香港沦陷”与“平凡婚姻”之间的荒诞苍凉逻辑？",
    "start": 124.507,
    "end": 131.559,
    "duration": 7.052
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合曹七巧、芝寿、长安、季泽及“酸梅汤”细节分析《金锁记》心理病态？",
    "start": 132.013,
    "end": 138.768,
    "duration": 6.755
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 概括张爱玲在《传奇》中融合古典世情白描与西方心理/意象主义的独特范式？",
    "start": 139.296,
    "end": 147.125,
    "duration": 7.829
  }
]