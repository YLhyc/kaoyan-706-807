[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "张爱玲·传奇小说文体范式与苍凉美学",
    "start": 0.134,
    "end": 3.727,
    "duration": 3.593
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "写什么日常（倾城之恋）→剖多深心理（金锁记）→用什么意象造冷艳感（月亮泪珠/葱绿配桃红），",
    "start": 4.303,
    "end": 13.729,
    "duration": 9.426
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "三点紧扣四十年代沦陷区上海“苍凉美学”。",
    "start": 14.042,
    "end": 17.765,
    "duration": 3.723
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "四十年代沦陷区上海，张爱玲以《传奇》小说集在抗战宏大叙事之外开辟都市现代“传奇”视界，独树苍凉美学。",
    "start": 18.352,
    "end": 27.817,
    "duration": 9.465
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 聚焦乱世日常世俗、揭示荒凉苍凉底色",
    "start": 28.404,
    "end": 32.882,
    "duration": 4.478
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "避开非黑即白意识形态，凝视都市男女物质欲望与生存心理博弈；",
    "start": 33.469,
    "end": 39.367,
    "duration": 5.897
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "白流苏与范柳原在浅水湾斤斤计较自私盘算，",
    "start": 39.954,
    "end": 45.174,
    "duration": 5.22
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "直到战火漫卷香港、断壁残垣生死边缘方获得平凡婚姻，凸显小人物在时代倾覆中的脆弱宿命。",
    "start": 45.488,
    "end": 53.82,
    "duration": 8.332
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 深潜潜意识暗角、解剖病态心理畸变",
    "start": 54.394,
    "end": 58.338,
    "duration": 3.944
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "融传统世情白描与西方现代心理分析为一体；",
    "start": 58.925,
    "end": 63.963,
    "duration": 5.038
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "曹七巧受门第歧视与病残丈夫折磨，将情感寄于金钱，戴上黄金枷锁后折磨芝寿致死、拆散长安婚事；",
    "start": 64.55,
    "end": 75.174,
    "duration": 10.624
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "识破季泽骗局时打翻的酸梅汤滴落如迟迟夜漏，写尽被礼教与金欲吞噬之悲。",
    "start": 75.501,
    "end": 82.436,
    "duration": 6.935
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 古典白描融意象主义、造斑斓鬼气意象",
    "start": 83.01,
    "end": 87.357,
    "duration": 4.348
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "华美冷艳，善用陌生化的通感、奇诡比喻与强对比色彩；",
    "start": 87.944,
    "end": 93.751,
    "duration": 5.806
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "将三十年前月亮比作“红黄湿晕，像朵云轩信笺落泪珠”；",
    "start": 94.325,
    "end": 100.027,
    "duration": 5.702
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "“葱绿配桃红”感官刺激背后弥漫繁华散尽的末世虚无，成苍凉美学范式。",
    "start": 100.301,
    "end": 106.589,
    "duration": 6.288
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：四十年代沦陷区上海《传奇》小说集；",
    "start": 107.163,
    "end": 111.107,
    "duration": 3.944
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "重点代表作：《倾城之恋》（白流苏、范柳原，香港沦陷促成婚姻）与《金锁记》（曹七巧、芝寿、长安、季泽、酸梅汤夜漏）。",
    "start": 111.434,
    "end": 122.592,
    "duration": 11.158
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 结合《倾城之恋》说明“香港沦陷”与“平凡婚姻”之间的荒诞苍凉逻辑？",
    "start": 123.166,
    "end": 129.949,
    "duration": 6.783
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合曹七巧、芝寿、长安、季泽及“酸梅汤”细节分析《金锁记》心理病态？",
    "start": 130.536,
    "end": 138.295,
    "duration": 7.759
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 概括张爱玲在《传奇》中融合古典世情白描与西方心理/意象主义的独特范式？",
    "start": 138.882,
    "end": 147.227,
    "duration": 8.345
  }
]