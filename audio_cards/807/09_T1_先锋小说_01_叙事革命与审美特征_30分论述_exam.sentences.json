[
  {
    "id": 1,
    "text": "二十世纪八十年代中后期崛起的先锋小说，",
    "start": 0.08,
    "end": 3.84,
    "duration": 3.76
  },
  {
    "id": 2,
    "text": "是中国当代文学史上最具颠覆性的文体革命。",
    "start": 3.84,
    "end": 7.68,
    "duration": 3.84
  },
  {
    "id": 3,
    "text": "以马原、余华、格非、苏童为代表的青年作家，",
    "start": 7.68,
    "end": 12.08,
    "duration": 4.4
  },
  {
    "id": 4,
    "text": "深受西方现代主义与后现代主义思潮影响。",
    "start": 12.08,
    "end": 15.44,
    "duration": 3.36
  },
  {
    "id": 5,
    "text": "他们彻底打破了十七年文学及新时期初期主导的现实主义反映论。",
    "start": 15.44,
    "end": 20.64,
    "duration": 5.2
  },
  {
    "id": 6,
    "text": "先锋小说将文学的重心从“写什么”转向了“怎么写”。",
    "start": 20.96,
    "end": 26.0,
    "duration": 5.04
  },
  {
    "id": 7,
    "text": "作家们将语言形式提升至存在本体的高度。",
    "start": 26.0,
    "end": 30.08,
    "duration": 4.08
  },
  {
    "id": 8,
    "text": "这场革命展现出四个核心维度。",
    "start": 30.08,
    "end": 32.8,
    "duration": 2.72
  },
  {
    "id": 9,
    "text": "第一，消解真实界限与建构叙述圈套。",
    "start": 32.8,
    "end": 36.96,
    "duration": 4.16
  },
  {
    "id": 10,
    "text": "传统小说追求典型环境与现实生活幻觉的逼真呈现。",
    "start": 36.96,
    "end": 41.76,
    "duration": 4.8
  },
  {
    "id": 11,
    "text": "先锋小说则主动拆解这一幻觉。",
    "start": 41.76,
    "end": 44.48,
    "duration": 2.72
  },
  {
    "id": 12,
    "text": "马原在《冈底斯的诱惑》与《虚构》中开创了中国当代小说的元叙事形态。",
    "start": 44.72,
    "end": 50.96,
    "duration": 6.24
  },
  {
    "id": 13,
    "text": "他通过跳出故事层面的直接插话，宣称自己就是那个叫马原的汉人。",
    "start": 50.96,
    "end": 56.72,
    "duration": 5.76
  },
  {
    "id": 14,
    "text": "叙述者身份与故事人物不断交叠换位。",
    "start": 56.72,
    "end": 60.24,
    "duration": 3.52
  },
  {
    "id": 15,
    "text": "这种打破叙事闭合性的叙述圈套，将小说的虚构本质彻底暴露。",
    "start": 60.24,
    "end": 65.84,
    "duration": 5.6
  },
  {
    "id": 16,
    "text": "作品不再是对外在现实的机械摹写，",
    "start": 66.16,
    "end": 69.2,
    "duration": 3.04
  },
  {
    "id": 17,
    "text": "而是语言自我生成的游戏过程。",
    "start": 69.2,
    "end": 71.76,
    "duration": 2.56
  },
  {
    "id": 18,
    "text": "小说由此实现了从生活真实向叙事本体的哲学跨越。",
    "start": 71.76,
    "end": 76.96,
    "duration": 5.2
  },
  {
    "id": 19,
    "text": "第二，解构理性因果与重塑荒诞生存经验。",
    "start": 76.96,
    "end": 81.52,
    "duration": 4.56
  },
  {
    "id": 20,
    "text": "传统现实主义依凭历史理性和严密的心理因果链条推动情节。",
    "start": 81.52,
    "end": 87.44,
    "duration": 5.92
  },
  {
    "id": 21,
    "text": "余华早期的先锋短篇则彻底切断了这一链条。",
    "start": 87.44,
    "end": 91.36,
    "duration": 3.92
  },
  {
    "id": 22,
    "text": "《十八岁出门远行》中少年遭遇毫无缘由的暴力洗劫。",
    "start": 91.52,
    "end": 95.878,
    "duration": 4.358
  },
  {
    "id": 23,
    "text": "《现实一种》中家族血亲之间如同机械齿轮般冰冷相残。",
    "start": 95.878,
    "end": 100.442,
    "duration": 4.564
  },
  {
    "id": 24,
    "text": "余华以冷酷而精确的手术刀式笔触，",
    "start": 100.442,
    "end": 103.555,
    "duration": 3.113
  },
  {
    "id": 25,
    "text": "剔除了道德抒情与价值说教。",
    "start": 103.555,
    "end": 106.045,
    "duration": 2.49
  },
  {
    "id": 26,
    "text": "他运用“零度情感”的叙述腔调，展示出暴力与死亡的不可预测性。",
    "start": 106.045,
    "end": 111.44,
    "duration": 5.395
  },
  {
    "id": 27,
    "text": "这种叙事剥离了生活的温情面纱，直击现代人置身荒诞世界的脆弱本相。",
    "start": 111.52,
    "end": 117.76,
    "duration": 6.24
  },
  {
    "id": 28,
    "text": "第三，迷宫化时间结构与消解确定性历史。",
    "start": 117.76,
    "end": 122.0,
    "duration": 4.24
  },
  {
    "id": 29,
    "text": "先锋小说反对本质主义的历史目的论。",
    "start": 122.0,
    "end": 125.12,
    "duration": 3.12
  },
  {
    "id": 30,
    "text": "格非在《迷舟》与《褐色鸟群》中，",
    "start": 125.12,
    "end": 127.44,
    "duration": 2.32
  },
  {
    "id": 31,
    "text": "将时间处理为多重交织的迷宫。",
    "start": 127.44,
    "end": 130.4,
    "duration": 2.96
  },
  {
    "id": 32,
    "text": "主人公关汉智在关键战役前的行踪与死因，",
    "start": 130.4,
    "end": 134.4,
    "duration": 4.0
  },
  {
    "id": 33,
    "text": "被瓦解为各种偶然细节与记忆误读。",
    "start": 134.4,
    "end": 137.36,
    "duration": 2.96
  },
  {
    "id": 34,
    "text": "宏大的战争风云在偶发性情欲与错位情报中彻底失重。",
    "start": 137.6,
    "end": 142.88,
    "duration": 5.28
  },
  {
    "id": 35,
    "text": "格非借鉴了博尔赫斯的神秘叙事技巧。",
    "start": 142.88,
    "end": 145.92,
    "duration": 3.04
  },
  {
    "id": 36,
    "text": "他让时间在回溯与停滞中不断分叉，",
    "start": 145.92,
    "end": 149.04,
    "duration": 3.12
  },
  {
    "id": 37,
    "text": "表明历史真相无法完全被理性把握。",
    "start": 149.04,
    "end": 152.08,
    "duration": 3.04
  },
  {
    "id": 38,
    "text": "历史叙事最终蜕变为关于记忆与遗忘的哲学玄想。",
    "start": 152.08,
    "end": 156.48,
    "duration": 4.4
  },
  {
    "id": 39,
    "text": "第四，颓败感官意象与南方家族叙事寓言。",
    "start": 156.776,
    "end": 160.936,
    "duration": 4.16
  },
  {
    "id": 40,
    "text": "苏童的先锋写作独具南方水乡的感官特质。",
    "start": 160.936,
    "end": 165.096,
    "duration": 4.16
  },
  {
    "id": 41,
    "text": "《妻妾成群》与《一九三四年的逃亡》构筑了阴郁颓败的南方寓言。",
    "start": 165.096,
    "end": 170.376,
    "duration": 5.28
  },
  {
    "id": 42,
    "text": "作家放弃了传统家族小说的启蒙批判或阶级压迫图景。",
    "start": 170.376,
    "end": 175.176,
    "duration": 4.8
  },
  {
    "id": 43,
    "text": "苏童以近乎病态的敏锐，捕获女性肉体受困的绝望窒息感与欲望异化。",
    "start": 175.176,
    "end": 180.936,
    "duration": 5.76
  },
  {
    "id": 44,
    "text": "飞扬的婴粟花、幽深的水井、挂在回廊的红灯笼，",
    "start": 181.256,
    "end": 185.496,
    "duration": 4.24
  },
  {
    "id": 45,
    "text": "成为宿命论的象征符号。",
    "start": 185.496,
    "end": 187.736,
    "duration": 2.24
  },
  {
    "id": 46,
    "text": "苏童将先锋文体的叙事实验，与古老东方的死亡情调实现了深度交融。",
    "start": 187.736,
    "end": 193.576,
    "duration": 5.84
  },
  {
    "id": 47,
    "text": "先锋小说的文体探索终结了单一现实主义的垄断格局，",
    "start": 193.576,
    "end": 197.976,
    "duration": 4.4
  },
  {
    "id": 48,
    "text": "极大地拓展了汉语小说的叙事空间与审美视界。",
    "start": 197.976,
    "end": 201.576,
    "duration": 3.6
  },
  {
    "id": 49,
    "text": "虽然部分作品在后期陷入了纯技巧玩弄和读者流失的狭隘陷阱，",
    "start": 201.896,
    "end": 207.336,
    "duration": 5.44
  },
  {
    "id": 50,
    "text": "但九十年代后先锋作家重回现实与历史的叙事转型，",
    "start": 207.336,
    "end": 212.056,
    "duration": 4.72
  },
  {
    "id": 51,
    "text": "正是在先锋革命淬炼后的成熟回归。",
    "start": 212.056,
    "end": 214.936,
    "duration": 2.88
  },
  {
    "id": 52,
    "text": "它构成了中国当代文学通往现代审美成熟的重要里程碑。",
    "start": 214.936,
    "end": 219.416,
    "duration": 4.48
  }
]