[
  {
    "id": 1,
    "text": "一、宏观结构推演与采分点映射。",
    "start": 0.16,
    "end": 3.28,
    "duration": 3.12
  },
  {
    "id": 2,
    "text": "本题标准分为三十分，论述结构采用高分“总论破题，",
    "start": 3.28,
    "end": 8.0,
    "duration": 4.72
  },
  {
    "id": 3,
    "text": "四大机制支柱展开，辩证总结提升”逻辑模型：一、",
    "start": 8.0,
    "end": 12.56,
    "duration": 4.56
  },
  {
    "id": 4,
    "text": "破题总论层（约一百五十字）：准确界定先锋小说的历史时空（二十世纪八十年代中后期）、",
    "start": 12.56,
    "end": 19.6,
    "duration": 7.04
  },
  {
    "id": 5,
    "text": "代表作家群（马原、余华、格非、苏童）、",
    "start": 19.6,
    "end": 22.8,
    "duration": 3.2
  },
  {
    "id": 6,
    "text": "核心转向（从“写什么”到“怎么写”的形式本体论革命）。",
    "start": 22.8,
    "end": 26.8,
    "duration": 4.0
  },
  {
    "id": 7,
    "text": "二、第一支柱：叙事视点与元叙事革命（马原）：采分点为元叙事、",
    "start": 27.12,
    "end": 32.72,
    "duration": 5.6
  },
  {
    "id": 8,
    "text": "拆解虚构幻觉、叙述圈套、本体跨越。",
    "start": 32.72,
    "end": 36.32,
    "duration": 3.6
  },
  {
    "id": 9,
    "text": "三、第二支柱：因果逻辑断裂与生存荒诞体验（余华）：采分点为反因果链、",
    "start": 36.32,
    "end": 42.88,
    "duration": 6.56
  },
  {
    "id": 10,
    "text": "零度情感、冷酷叙事、暴力死亡解剖。",
    "start": 42.88,
    "end": 46.08,
    "duration": 3.2
  },
  {
    "id": 11,
    "text": "四、第三支柱：时间迷宫与历史确定性消解（格非）：采分点为博尔赫斯式时间分叉、",
    "start": 46.08,
    "end": 52.72,
    "duration": 6.64
  },
  {
    "id": 12,
    "text": "偶发性解构必然性、记忆与历史真相的虚无。",
    "start": 52.72,
    "end": 55.84,
    "duration": 3.12
  },
  {
    "id": 13,
    "text": "五、第四支柱：感官意象化与家族颓败寓言（苏童）：采分点为南方意象群、",
    "start": 56.24,
    "end": 63.44,
    "duration": 7.2
  },
  {
    "id": 14,
    "text": "空间封闭性、欲望与死亡互渗、文体东方化。",
    "start": 63.44,
    "end": 67.52,
    "duration": 4.08
  },
  {
    "id": 15,
    "text": "六、总结提升层（约一百五十字）：先锋文学的历史功绩（打破垄断、",
    "start": 67.52,
    "end": 72.88,
    "duration": 5.36
  },
  {
    "id": 16,
    "text": "拓宽空间）以及九十年代后的后先锋转型（技巧回落与现实重构）。",
    "start": 72.88,
    "end": 78.16,
    "duration": 5.28
  },
  {
    "id": 17,
    "text": "二、逐段内部咬合与考场得分句推导。",
    "start": 78.48,
    "end": 82.32,
    "duration": 3.84
  },
  {
    "id": 18,
    "text": "破题段：历史定位与本体转向。",
    "start": 82.32,
    "end": 85.36,
    "duration": 3.04
  },
  {
    "id": 19,
    "text": "论证推演逻辑：先锋小说不是题材上的改良，",
    "start": 85.36,
    "end": 89.2,
    "duration": 3.84
  },
  {
    "id": 20,
    "text": "而是文体观念上的哥白尼式革命。",
    "start": 89.2,
    "end": 91.92,
    "duration": 2.72
  },
  {
    "id": 21,
    "text": "要先确立时代节点（八十年代中后期）与核心作家阵营。",
    "start": 91.92,
    "end": 96.64,
    "duration": 4.72
  },
  {
    "id": 22,
    "text": "紧接着必须点破其理论实质：从再现论走向本体论。",
    "start": 96.64,
    "end": 100.64,
    "duration": 4.0
  },
  {
    "id": 23,
    "text": "由叙事变革带出全篇总纲。",
    "start": 101.04,
    "end": 103.6,
    "duration": 2.56
  },
  {
    "id": 24,
    "text": "具体表述到答题语句就是：二十世纪八十年代中后期崛起的先锋小说，",
    "start": 103.6,
    "end": 109.36,
    "duration": 5.76
  },
  {
    "id": 25,
    "text": "是中国当代文学史上最具颠覆性的文体革命。",
    "start": 109.36,
    "end": 113.44,
    "duration": 4.08
  },
  {
    "id": 26,
    "text": "以马原、余华、格非、苏童为代表的青年作家，",
    "start": 113.44,
    "end": 117.36,
    "duration": 3.92
  },
  {
    "id": 27,
    "text": "深受西方现代主义与后现代主义思潮影响。",
    "start": 117.36,
    "end": 120.56,
    "duration": 3.2
  },
  {
    "id": 28,
    "text": "他们彻底打破了十七年文学及新时期初期主导的现实主义反映论。",
    "start": 120.8,
    "end": 126.8,
    "duration": 6.0
  },
  {
    "id": 29,
    "text": "先锋小说将文学的重心从“写什么”转向了“怎么写”。",
    "start": 126.96,
    "end": 131.76,
    "duration": 4.8
  },
  {
    "id": 30,
    "text": "作家们将语言形式提升至存在本体的高度。",
    "start": 131.76,
    "end": 135.6,
    "duration": 3.84
  },
  {
    "id": 31,
    "text": "这场革命展现出四个核心维度。",
    "start": 135.6,
    "end": 138.08,
    "duration": 2.48
  },
  {
    "id": 32,
    "text": "二十世纪八十年代中后期崛起的先锋小说，",
    "start": 138.368,
    "end": 142.128,
    "duration": 3.76
  },
  {
    "id": 33,
    "text": "是中国当代文学史上最具颠覆性的文体革命。",
    "start": 142.128,
    "end": 145.968,
    "duration": 3.84
  },
  {
    "id": 34,
    "text": "以马原、余华、格非、苏童为代表的青年作家，",
    "start": 145.968,
    "end": 150.368,
    "duration": 4.4
  },
  {
    "id": 35,
    "text": "深受西方现代主义与后现代主义思潮影响。",
    "start": 150.368,
    "end": 153.728,
    "duration": 3.36
  },
  {
    "id": 36,
    "text": "他们彻底打破了十七年文学及新时期初期主导的现实主义反映论。",
    "start": 153.728,
    "end": 158.928,
    "duration": 5.2
  },
  {
    "id": 37,
    "text": "先锋小说将文学的重心从“写什么”转向了“怎么写”。",
    "start": 159.248,
    "end": 164.048,
    "duration": 4.8
  },
  {
    "id": 38,
    "text": "作家们将语言形式提升至存在本体的高度。",
    "start": 164.048,
    "end": 167.888,
    "duration": 3.84
  },
  {
    "id": 39,
    "text": "这场革命展现出四个核心维度。",
    "start": 167.888,
    "end": 170.688,
    "duration": 2.8
  },
  {
    "id": 40,
    "text": "--。第",
    "start": 170.688,
    "end": 170.848,
    "duration": 0.16
  },
  {
    "id": 41,
    "text": "一支柱：叙事视点与元叙事革命（马原）。",
    "start": 170.848,
    "end": 174.848,
    "duration": 4.0
  },
  {
    "id": 42,
    "text": "论证推演逻辑：先锋叙事的第一把利刃是打破小说读者的真实幻觉。",
    "start": 174.848,
    "end": 180.288,
    "duration": 5.44
  },
  {
    "id": 43,
    "text": "传统小说作者隐匿在幕后制造逼真世界。",
    "start": 180.608,
    "end": 184.208,
    "duration": 3.6
  },
  {
    "id": 44,
    "text": "马原反其道而行之，通过元叙事直接介入文本。",
    "start": 184.208,
    "end": 188.768,
    "duration": 4.56
  },
  {
    "id": 45,
    "text": "必须结合《冈底斯的诱惑》与《虚构》，",
    "start": 188.768,
    "end": 191.488,
    "duration": 2.72
  },
  {
    "id": 46,
    "text": "扣住“我就是那个叫马原的汉人”这一标志性叙事圈套，",
    "start": 191.488,
    "end": 196.048,
    "duration": 4.56
  },
  {
    "id": 47,
    "text": "阐明文学从反映生活到语言自我生长的哲学升级。",
    "start": 196.048,
    "end": 200.048,
    "duration": 4.0
  },
  {
    "id": 48,
    "text": "-具体表述到答题语句就是：第一，",
    "start": 200.288,
    "end": 202.999,
    "duration": 2.711
  },
  {
    "id": 49,
    "text": "消解真实界限与建构叙述圈套。",
    "start": 202.999,
    "end": 205.71,
    "duration": 2.711
  },
  {
    "id": 50,
    "text": "传统小说追求典型环境与现实生活幻觉的逼真呈现。",
    "start": 205.71,
    "end": 210.298,
    "duration": 4.588
  },
  {
    "id": 51,
    "text": "先锋小说则主动拆解这一幻觉。",
    "start": 210.298,
    "end": 213.009,
    "duration": 2.711
  },
  {
    "id": 52,
    "text": "马原在《冈底斯的诱惑》与《虚构》中开创了中国当代小说的元叙事形态。",
    "start": 213.009,
    "end": 218.848,
    "duration": 5.839
  },
  {
    "id": 53,
    "text": "他通过跳出故事层面的直接插话，宣称自己就是那个叫马原的汉人。",
    "start": 218.928,
    "end": 224.128,
    "duration": 5.2
  },
  {
    "id": 54,
    "text": "叙述者身份与故事人物不断交叠换位。",
    "start": 224.128,
    "end": 227.328,
    "duration": 3.2
  },
  {
    "id": 55,
    "text": "这种打破叙事闭合性的叙述圈套，将小说的虚构本质彻底暴露。",
    "start": 227.328,
    "end": 232.848,
    "duration": 5.52
  },
  {
    "id": 56,
    "text": "作品不再是对外在现实的机械摹写，",
    "start": 232.848,
    "end": 235.808,
    "duration": 2.96
  },
  {
    "id": 57,
    "text": "而是语言自我生成的游戏过程。",
    "start": 235.808,
    "end": 237.968,
    "duration": 2.16
  },
  {
    "id": 58,
    "text": "小说由此实现了从生活真实向叙事本体的哲学跨越。",
    "start": 238.368,
    "end": 242.848,
    "duration": 4.48
  },
  {
    "id": 59,
    "text": "第一，消解真实界限与建构叙述圈套。",
    "start": 242.848,
    "end": 246.048,
    "duration": 3.2
  },
  {
    "id": 60,
    "text": "传统小说追求典型环境与现实生活幻觉的逼真呈现。",
    "start": 246.048,
    "end": 250.288,
    "duration": 4.24
  },
  {
    "id": 61,
    "text": "先锋小说则主动拆解这一幻觉。",
    "start": 250.288,
    "end": 252.768,
    "duration": 2.48
  },
  {
    "id": 62,
    "text": "马原在《冈底斯的诱惑》与《虚构》中开创了中国当代小说的元叙事形态。",
    "start": 252.768,
    "end": 257.888,
    "duration": 5.12
  },
  {
    "id": 63,
    "text": "他通过跳出故事层面的直接插话，宣称自己就是那个叫马原的汉人。",
    "start": 258.128,
    "end": 263.328,
    "duration": 5.2
  },
  {
    "id": 64,
    "text": "叙述者身份与故事人物不断交叠换位。",
    "start": 263.328,
    "end": 266.528,
    "duration": 3.2
  },
  {
    "id": 65,
    "text": "这种打破叙事闭合性的叙述圈套，将小说的虚构本质彻底暴露。",
    "start": 266.528,
    "end": 272.048,
    "duration": 5.52
  },
  {
    "id": 66,
    "text": "作品不再是对外在现实的机械摹写，",
    "start": 272.048,
    "end": 275.008,
    "duration": 2.96
  },
  {
    "id": 67,
    "text": "而是语言自我生成的游戏过程。",
    "start": 275.008,
    "end": 277.168,
    "duration": 2.16
  },
  {
    "id": 68,
    "text": "小说由此实现了从生活真实向叙事本体的哲学跨越。",
    "start": 277.568,
    "end": 281.888,
    "duration": 4.32
  },
  {
    "id": 69,
    "text": "--。第",
    "start": 281.888,
    "end": 282.048,
    "duration": 0.16
  },
  {
    "id": 70,
    "text": "二支柱：因果逻辑断裂与生存荒诞经验（余华）。",
    "start": 282.048,
    "end": 285.968,
    "duration": 3.92
  },
  {
    "id": 71,
    "text": "-论证推演逻辑：第二点直击理性认知秩序的破产。",
    "start": 286.176,
    "end": 290.302,
    "duration": 4.126
  },
  {
    "id": 72,
    "text": "现实主义小说依赖动机与行动的因果链条，",
    "start": 290.302,
    "end": 294.016,
    "duration": 3.714
  },
  {
    "id": 73,
    "text": "给读者以秩序安全感。",
    "start": 294.016,
    "end": 295.873,
    "duration": 1.857
  },
  {
    "id": 74,
    "text": "余华彻底击碎因果律。",
    "start": 295.873,
    "end": 297.73,
    "duration": 1.857
  },
  {
    "id": 75,
    "text": "抓住《十八岁出门远行》的无动机暴力和《现实一种》的机械骨肉相残。",
    "start": 297.73,
    "end": 303.3,
    "duration": 5.57
  },
  {
    "id": 76,
    "text": "引入学术关键词“零度情感”，论证冷漠叙述如何撕开生存本质的荒谬与血腥。",
    "start": 303.3,
    "end": 309.696,
    "duration": 6.396
  },
  {
    "id": 77,
    "text": "-具体表述到答题语句就是：第二，",
    "start": 309.696,
    "end": 312.329,
    "duration": 2.633
  },
  {
    "id": 78,
    "text": "解构理性因果与重塑荒诞生存经验。",
    "start": 312.329,
    "end": 315.367,
    "duration": 3.038
  },
  {
    "id": 79,
    "text": "传统现实主义依凭历史理性和严密的心理因果链条推动情节。",
    "start": 315.367,
    "end": 320.634,
    "duration": 5.267
  },
  {
    "id": 80,
    "text": "余华早期的先锋短篇则彻底切断了这一链条。",
    "start": 320.634,
    "end": 324.482,
    "duration": 3.848
  },
  {
    "id": 81,
    "text": "《十八岁出门远行》中少年遭遇毫无缘由的暴力洗劫。",
    "start": 324.482,
    "end": 328.736,
    "duration": 4.254
  },
  {
    "id": 82,
    "text": "《现实一种》中家族血亲之间如同机械齿轮般冰冷相残。",
    "start": 328.736,
    "end": 333.346,
    "duration": 4.61
  },
  {
    "id": 83,
    "text": "余华以冷酷而精确的手术刀式笔触，",
    "start": 333.346,
    "end": 336.488,
    "duration": 3.142
  },
  {
    "id": 84,
    "text": "剔除了道德抒情与价值说教。",
    "start": 336.488,
    "end": 339.003,
    "duration": 2.515
  },
  {
    "id": 85,
    "text": "他运用“零度情感”的叙述腔调，展示出暴力与死亡的不可预测性。",
    "start": 339.003,
    "end": 344.45,
    "duration": 5.447
  },
  {
    "id": 86,
    "text": "这种叙事剥离了生活的温情面纱，直击现代人置身荒诞世界的脆弱本相。",
    "start": 344.45,
    "end": 350.736,
    "duration": 6.286
  },
  {
    "id": 87,
    "text": "第二，解构理性因果与重塑荒诞生存经验。",
    "start": 350.816,
    "end": 355.136,
    "duration": 4.32
  },
  {
    "id": 88,
    "text": "传统现实主义依凭历史理性和严密的心理因果链条推动情节。",
    "start": 355.136,
    "end": 360.656,
    "duration": 5.52
  },
  {
    "id": 89,
    "text": "余华早期的先锋短篇则彻底切断了这一链条。",
    "start": 360.656,
    "end": 364.576,
    "duration": 3.92
  },
  {
    "id": 90,
    "text": "《十八岁出门远行》中少年遭遇毫无缘由的暴力洗劫。",
    "start": 364.576,
    "end": 369.056,
    "duration": 4.48
  },
  {
    "id": 91,
    "text": "《现实一种》中家族血亲之间如同机械齿轮般冰冷相残。",
    "start": 369.056,
    "end": 374.096,
    "duration": 5.04
  },
  {
    "id": 92,
    "text": "余华以冷酷而精确的手术刀式笔触，",
    "start": 374.416,
    "end": 377.456,
    "duration": 3.04
  },
  {
    "id": 93,
    "text": "剔除了道德抒情与价值说教。",
    "start": 377.456,
    "end": 379.856,
    "duration": 2.4
  },
  {
    "id": 94,
    "text": "他运用“零度情感”的叙述腔调，展示出暴力与死亡的不可预测性。",
    "start": 379.856,
    "end": 384.576,
    "duration": 4.72
  },
  {
    "id": 95,
    "text": "这种叙事剥离了生活的温情面纱，直击现代人置身荒诞世界的脆弱本相。",
    "start": 384.576,
    "end": 390.176,
    "duration": 5.6
  },
  {
    "id": 96,
    "text": "--。第",
    "start": 390.176,
    "end": 390.336,
    "duration": 0.16
  },
  {
    "id": 97,
    "text": "三支柱：迷宫化时间结构与消解确定性历史（格非）。",
    "start": 390.336,
    "end": 394.336,
    "duration": 4.0
  },
  {
    "id": 98,
    "text": "-论证推演逻辑：第三点转向历史观念的重构。",
    "start": 394.576,
    "end": 398.493,
    "duration": 3.917
  },
  {
    "id": 99,
    "text": "新时期初期的反思小说依旧相信历史具有客观必然的规律。",
    "start": 398.493,
    "end": 403.933,
    "duration": 5.44
  },
  {
    "id": 100,
    "text": "格非用迷宫式叙事消解了历史宏大叙事。",
    "start": 403.933,
    "end": 407.632,
    "duration": 3.699
  },
  {
    "id": 101,
    "text": "紧扣《迷舟》和《褐色鸟群》，指出关键历史进程被置换为偶然的欲望、",
    "start": 407.632,
    "end": 413.29,
    "duration": 5.658
  },
  {
    "id": 102,
    "text": "天气或遗忘，以此论证博尔赫斯式时间分叉与历史真实的不确定性。",
    "start": 413.29,
    "end": 419.382,
    "duration": 6.092
  },
  {
    "id": 103,
    "text": "具体表述到答题语句就是：第三，迷宫化时间结构与消解确定性历史。",
    "start": 419.382,
    "end": 425.664,
    "duration": 6.282
  },
  {
    "id": 104,
    "text": "先锋小说反对本质主义的历史目的论。",
    "start": 425.664,
    "end": 428.624,
    "duration": 2.96
  },
  {
    "id": 105,
    "text": "格非在《迷舟》与《褐色鸟群》中，",
    "start": 428.624,
    "end": 431.264,
    "duration": 2.64
  },
  {
    "id": 106,
    "text": "将时间处理为多重交织的迷宫。",
    "start": 431.264,
    "end": 433.984,
    "duration": 2.72
  },
  {
    "id": 107,
    "text": "主人公关汉智在关键战役前的行踪与死因，",
    "start": 433.984,
    "end": 437.664,
    "duration": 3.68
  },
  {
    "id": 108,
    "text": "被瓦解为各种偶然细节与记忆误读。",
    "start": 437.664,
    "end": 440.704,
    "duration": 3.04
  },
  {
    "id": 109,
    "text": "宏大的战争风云在偶发性情欲与错位情报中彻底失重。",
    "start": 441.024,
    "end": 445.824,
    "duration": 4.8
  },
  {
    "id": 110,
    "text": "格非借鉴了博尔赫斯的神秘叙事技巧。",
    "start": 445.824,
    "end": 448.624,
    "duration": 2.8
  },
  {
    "id": 111,
    "text": "他让时间在回溯与停滞中不断分叉，",
    "start": 448.624,
    "end": 451.504,
    "duration": 2.88
  },
  {
    "id": 112,
    "text": "表明历史真相无法完全被理性把握。",
    "start": 451.504,
    "end": 454.704,
    "duration": 3.2
  },
  {
    "id": 113,
    "text": "历史叙事最终蜕变为关于记忆与遗忘的哲学玄想。",
    "start": 454.704,
    "end": 459.104,
    "duration": 4.4
  },
  {
    "id": 114,
    "text": "第三，迷宫化时间结构与消解确定性历史。",
    "start": 459.104,
    "end": 462.624,
    "duration": 3.52
  },
  {
    "id": 115,
    "text": "先锋小说反对本质主义的历史目的论。",
    "start": 463.024,
    "end": 466.544,
    "duration": 3.52
  },
  {
    "id": 116,
    "text": "格非在《迷舟》与《褐色鸟群》中，",
    "start": 466.544,
    "end": 469.024,
    "duration": 2.48
  },
  {
    "id": 117,
    "text": "将时间处理为多重交织的迷宫。",
    "start": 469.024,
    "end": 472.064,
    "duration": 3.04
  },
  {
    "id": 118,
    "text": "主人公关汉智在关键战役前的行踪与死因，",
    "start": 472.064,
    "end": 475.984,
    "duration": 3.92
  },
  {
    "id": 119,
    "text": "被瓦解为各种偶然细节与记忆误读。",
    "start": 475.984,
    "end": 479.344,
    "duration": 3.36
  },
  {
    "id": 120,
    "text": "宏大的战争风云在偶发性情欲与错位情报中彻底失重。",
    "start": 479.344,
    "end": 484.384,
    "duration": 5.04
  },
  {
    "id": 121,
    "text": "格非借鉴了博尔赫斯的神秘叙事技巧。",
    "start": 484.624,
    "end": 487.664,
    "duration": 3.04
  },
  {
    "id": 122,
    "text": "他让时间在回溯与停滞中不断分叉，",
    "start": 487.664,
    "end": 490.784,
    "duration": 3.12
  },
  {
    "id": 123,
    "text": "表明历史真相无法完全被理性把握。",
    "start": 490.784,
    "end": 494.144,
    "duration": 3.36
  },
  {
    "id": 124,
    "text": "历史叙事最终蜕变为关于记忆与遗忘的哲学玄想。",
    "start": 494.144,
    "end": 498.784,
    "duration": 4.64
  },
  {
    "id": 125,
    "text": "--。第",
    "start": 498.784,
    "end": 498.944,
    "duration": 0.16
  },
  {
    "id": 126,
    "text": "四支柱：颓败感官意象与南方家族叙事寓言（苏童）。",
    "start": 498.944,
    "end": 503.504,
    "duration": 4.56
  },
  {
    "id": 127,
    "text": "-论证推演逻辑：第四点丰富审美风格维度，",
    "start": 503.744,
    "end": 507.015,
    "duration": 3.271
  },
  {
    "id": 128,
    "text": "不能只讲干枯的叙事学技巧，还要呈现审美意象。",
    "start": 507.015,
    "end": 510.864,
    "duration": 3.849
  },
  {
    "id": 129,
    "text": "苏童代表了先锋文学中独特的感官与地域向度。",
    "start": 510.864,
    "end": 514.713,
    "duration": 3.849
  },
  {
    "id": 130,
    "text": "紧扣《妻妾成群》与《一九三四年的逃亡》，",
    "start": 514.713,
    "end": 517.599,
    "duration": 2.886
  },
  {
    "id": 131,
    "text": "分析高墙深院、红灯笼、古井等南方阴郁意象群，",
    "start": 517.599,
    "end": 521.255,
    "duration": 3.656
  },
  {
    "id": 132,
    "text": "论证先锋形式与中国传统宿命情调的奇妙化合。",
    "start": 521.255,
    "end": 525.104,
    "duration": 3.849
  },
  {
    "id": 133,
    "text": "-具体表述到答题语句就是：第四，",
    "start": 525.104,
    "end": 527.87,
    "duration": 2.766
  },
  {
    "id": 134,
    "text": "颓败感官意象与南方家族叙事寓言。",
    "start": 527.87,
    "end": 531.061,
    "duration": 3.191
  },
  {
    "id": 135,
    "text": "苏童的先锋写作独具南方水乡的感官特质。",
    "start": 531.061,
    "end": 534.891,
    "duration": 3.83
  },
  {
    "id": 136,
    "text": "《妻妾成群》与《一九三四年的逃亡》构筑了阴郁颓败的南方寓言。",
    "start": 534.891,
    "end": 540.21,
    "duration": 5.319
  },
  {
    "id": 137,
    "text": "作家放弃了传统家族小说的启蒙批判或阶级压迫图景。",
    "start": 540.21,
    "end": 545.104,
    "duration": 4.894
  },
  {
    "id": 138,
    "text": "苏童以近乎病态的敏锐，捕获女性肉体受困的绝望窒息感与欲望异化。",
    "start": 545.264,
    "end": 551.184,
    "duration": 5.92
  },
  {
    "id": 139,
    "text": "飞扬的婴粟花、幽深的水井、挂在回廊的红灯笼，",
    "start": 551.184,
    "end": 555.344,
    "duration": 4.16
  },
  {
    "id": 140,
    "text": "成为宿命论的象征符号。",
    "start": 555.344,
    "end": 557.264,
    "duration": 1.92
  },
  {
    "id": 141,
    "text": "苏童将先锋文体的叙事实验，与古老东方的死亡情调实现了深度交融。",
    "start": 557.264,
    "end": 562.784,
    "duration": 5.52
  },
  {
    "id": 142,
    "text": "第四，颓败感官意象与南方家族叙事寓言。",
    "start": 563.072,
    "end": 567.232,
    "duration": 4.16
  },
  {
    "id": 143,
    "text": "苏童的先锋写作独具南方水乡的感官特质。",
    "start": 567.232,
    "end": 571.392,
    "duration": 4.16
  },
  {
    "id": 144,
    "text": "《妻妾成群》与《一九三四年的逃亡》构筑了阴郁颓败的南方寓言。",
    "start": 571.392,
    "end": 576.672,
    "duration": 5.28
  },
  {
    "id": 145,
    "text": "作家放弃了传统家族小说的启蒙批判或阶级压迫图景。",
    "start": 576.672,
    "end": 581.472,
    "duration": 4.8
  },
  {
    "id": 146,
    "text": "苏童以近乎病态的敏锐，捕获女性肉体受困的绝望窒息感与欲望异化。",
    "start": 581.472,
    "end": 587.232,
    "duration": 5.76
  },
  {
    "id": 147,
    "text": "飞扬的婴粟花、幽深的水井、挂在回廊的红灯笼，",
    "start": 587.472,
    "end": 591.712,
    "duration": 4.24
  },
  {
    "id": 148,
    "text": "成为宿命论的象征符号。",
    "start": 591.712,
    "end": 593.872,
    "duration": 2.16
  },
  {
    "id": 149,
    "text": "苏童将先锋文体的叙事实验，与古老东方的死亡情调实现了深度交融。",
    "start": 593.872,
    "end": 600.192,
    "duration": 6.32
  },
  {
    "id": 150,
    "text": "--。总",
    "start": 600.192,
    "end": 600.352,
    "duration": 0.16
  },
  {
    "id": 151,
    "text": "结提升段：文学史评价与后先锋转型。",
    "start": 600.352,
    "end": 603.552,
    "duration": 3.2
  },
  {
    "id": 152,
    "text": "论证推演逻辑：高分论述结尾必须具备宏观文学史视野。",
    "start": 603.552,
    "end": 608.032,
    "duration": 4.48
  },
  {
    "id": 153,
    "text": "既要肯定先锋小说对单一模式的打破与叙事空间的开拓，",
    "start": 608.192,
    "end": 612.832,
    "duration": 4.64
  },
  {
    "id": 154,
    "text": "也要客观指出其形式狂欢导致的读者流失。",
    "start": 612.832,
    "end": 616.672,
    "duration": 3.84
  },
  {
    "id": 155,
    "text": "最后指出九十年代作家由“形式迷恋”转向“现实关切”（后先锋转型），",
    "start": 616.672,
    "end": 622.592,
    "duration": 5.92
  },
  {
    "id": 156,
    "text": "展现文学史演进的辩证规律。",
    "start": 622.592,
    "end": 625.152,
    "duration": 2.56
  },
  {
    "id": 157,
    "text": "具体表述到答题语句就是：先锋小说的文体探索终结了单一现实主义的垄断格局，",
    "start": 625.152,
    "end": 632.032,
    "duration": 6.88
  },
  {
    "id": 158,
    "text": "极大地拓展了汉语小说的叙事空间与审美视界。",
    "start": 632.032,
    "end": 636.352,
    "duration": 4.32
  },
  {
    "id": 159,
    "text": "虽然部分作品在后期陷入了纯技巧玩弄和读者流失的狭隘陷阱，",
    "start": 636.352,
    "end": 642.032,
    "duration": 5.68
  },
  {
    "id": 160,
    "text": "但九十年代后先锋作家重回现实与历史的叙事转型，",
    "start": 642.032,
    "end": 646.752,
    "duration": 4.72
  },
  {
    "id": 161,
    "text": "正是在先锋革命淬炼后的成熟回归。",
    "start": 646.752,
    "end": 649.632,
    "duration": 2.88
  },
  {
    "id": 162,
    "text": "它构成了中国当代文学通往现代审美成熟的重要里程碑。",
    "start": 649.952,
    "end": 654.832,
    "duration": 4.88
  },
  {
    "id": 163,
    "text": "先锋小说的文体探索终结了单一现实主义的垄断格局，",
    "start": 654.832,
    "end": 659.072,
    "duration": 4.24
  },
  {
    "id": 164,
    "text": "极大地拓展了汉语小说的叙事空间与审美视界。",
    "start": 659.072,
    "end": 663.152,
    "duration": 4.08
  },
  {
    "id": 165,
    "text": "虽然部分作品在后期陷入了纯技巧玩弄和读者流失的狭隘陷阱，",
    "start": 663.152,
    "end": 668.192,
    "duration": 5.04
  },
  {
    "id": 166,
    "text": "但九十年代后先锋作家重回现实与历史的叙事转型，",
    "start": 668.192,
    "end": 672.912,
    "duration": 4.72
  },
  {
    "id": 167,
    "text": "正是在先锋革命淬炼后的成熟回归。",
    "start": 672.912,
    "end": 675.472,
    "duration": 2.56
  },
  {
    "id": 168,
    "text": "它构成了中国当代文学通往现代审美成熟的重要里程碑。",
    "start": 675.712,
    "end": 679.552,
    "duration": 3.84
  }
]