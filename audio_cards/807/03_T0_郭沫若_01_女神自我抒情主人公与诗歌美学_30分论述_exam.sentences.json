[
  {
    "id": 1,
    "text": "试论郭沫若《女神》的自我抒情主人公形象与诗歌美学特色。",
    "start": 0.0,
    "end": 5.435,
    "duration": 5.435
  },
  {
    "id": 2,
    "text": "五四新文化运动高潮时期，郭沫若诗集《女神》的问世，",
    "start": 5.435,
    "end": 9.669,
    "duration": 4.234
  },
  {
    "id": 3,
    "text": "是中国现代新诗史上具有划时代意义的奠基之作。",
    "start": 9.669,
    "end": 14.029,
    "duration": 4.36
  },
  {
    "id": 4,
    "text": "它的成功在于五四时代精神与诗人浪漫主义个性的高度统一，",
    "start": 14.029,
    "end": 19.149,
    "duration": 5.12
  },
  {
    "id": 5,
    "text": "正所谓“个人的郁结，民族的郁结，",
    "start": 19.149,
    "end": 22.157,
    "duration": 3.008
  },
  {
    "id": 6,
    "text": "在浪漫主义这里找到了喷火口”。",
    "start": 22.157,
    "end": 24.7,
    "duration": 2.543
  },
  {
    "id": 7,
    "text": "郭沫若以火山爆发式的激情彻底打破了古典旧体诗歌的格律桎梏，",
    "start": 24.7,
    "end": 30.275,
    "duration": 5.575
  },
  {
    "id": 8,
    "text": "以泛神论哲学为精神基石，",
    "start": 30.275,
    "end": 32.551,
    "duration": 2.276
  },
  {
    "id": 9,
    "text": "塑造了具有多重精神维度的自我抒情主人公，",
    "start": 32.551,
    "end": 36.15,
    "duration": 3.599
  },
  {
    "id": 10,
    "text": "开创了阔大奇异的意象体系与绝端自由的现代新诗体式，",
    "start": 36.15,
    "end": 41.333,
    "duration": 5.183
  },
  {
    "id": 11,
    "text": "确立了中国现代浪漫主义新诗的崇高美学范式。",
    "start": 41.333,
    "end": 45.021,
    "duration": 3.688
  },
  {
    "id": 12,
    "text": "其思想意蕴与艺术成就主要体现在以下四个核心维度：",
    "start": 45.021,
    "end": 53.248,
    "duration": 8.227
  },
  {
    "id": 13,
    "text": "第一，塑造觉醒时代的多维抒情主人公，",
    "start": 53.248,
    "end": 56.534,
    "duration": 3.286
  },
  {
    "id": 14,
    "text": "实现“小我”与民族“大我”的崇高融合。",
    "start": 56.534,
    "end": 60.058,
    "duration": 3.524
  },
  {
    "id": 15,
    "text": "《女神》中的自我绝非狭隘孤立的个人倾诉，",
    "start": 60.058,
    "end": 63.659,
    "duration": 3.601
  },
  {
    "id": 16,
    "text": "而是被五四时代彻底激活的现代主体形象。",
    "start": 63.659,
    "end": 67.119,
    "duration": 3.46
  },
  {
    "id": 17,
    "text": "其抒情主人公呈现出层次丰富的光谱：",
    "start": 67.119,
    "end": 71.463,
    "duration": 4.344
  },
  {
    "id": 18,
    "text": "一是在《凤凰涅槃》中集香木自焚并于死灰中更生、",
    "start": 71.463,
    "end": 74.699,
    "duration": 3.236
  },
  {
    "id": 19,
    "text": "象征古老中华民族浴火重生的“大我”；",
    "start": 74.699,
    "end": 79.769,
    "duration": 5.07
  },
  {
    "id": 20,
    "text": "二是在《女神之再生》中宣告新酿的酒浆不能盛在旧皮囊中、",
    "start": 79.769,
    "end": 87.55,
    "duration": 7.781
  },
  {
    "id": 21,
    "text": "誓死彻底砸碎旧世界的“新人”；",
    "start": 87.55,
    "end": 90.775,
    "duration": 3.225
  },
  {
    "id": 22,
    "text": "三是在《天狗》中以吞食日月的狂暴能量高呼“我便是我”、",
    "start": 90.775,
    "end": 96.606,
    "duration": 5.831
  },
  {
    "id": 23,
    "text": "在中国文学史上首次宣告个体神性与自主意志的“神我”；",
    "start": 96.606,
    "end": 102.071,
    "duration": 5.465
  },
  {
    "id": 24,
    "text": "四是在《晨安》中以博大胸怀向大自然山川与世界人类文明致敬的“世界人”。",
    "start": 102.071,
    "end": 110.541,
    "duration": 8.47
  },
  {
    "id": 25,
    "text": "这些形象交织共振，",
    "start": 110.541,
    "end": 113.057,
    "duration": 2.516
  },
  {
    "id": 26,
    "text": "完整具象化了五四时期被压抑生命力破土而出的时代狂飙。",
    "start": 113.057,
    "end": 117.043,
    "duration": 3.986
  },
  {
    "id": 27,
    "text": "第二，揭示高亢狂飙背后的矛盾与沉郁，",
    "start": 117.043,
    "end": 122.536,
    "duration": 5.493
  },
  {
    "id": 28,
    "text": "立体呈现五四知识分子的精神搏斗。",
    "start": 122.536,
    "end": 125.014,
    "duration": 2.478
  },
  {
    "id": 29,
    "text": "高水平的浪漫主义绝非单一维度的狂热宣泄，",
    "start": 125.014,
    "end": 128.688,
    "duration": 3.674
  },
  {
    "id": 30,
    "text": "《女神》的抒情主人公同时包含着深沉的内在张力与悲凉底色。",
    "start": 128.688,
    "end": 130.213,
    "duration": 1.525
  },
  {
    "id": 31,
    "text": "在火山喷发般的豪迈赞歌背面，",
    "start": 130.213,
    "end": 135.285,
    "duration": 5.072
  },
  {
    "id": 32,
    "text": "深藏着现代个体在旧体制废墟上的孤独、眷恋与忏悔。",
    "start": 135.285,
    "end": 145.689,
    "duration": 10.404
  },
  {
    "id": 33,
    "text": "在《天狗》中，自我的极度膨胀伴随着剥皮食肉的自我凌迟；",
    "start": 145.689,
    "end": 147.876,
    "duration": 2.187
  },
  {
    "id": 34,
    "text": "在《湘累》中，",
    "start": 147.876,
    "end": 149.589,
    "duration": 1.713
  },
  {
    "id": 35,
    "text": "屈原在天马行空的创造之后陷入了不可言说的深沉寂寞；",
    "start": 149.589,
    "end": 155.005,
    "duration": 5.416
  },
  {
    "id": 36,
    "text": "而《凤凰涅槃》在追求主体极致爆发的同时，",
    "start": 155.005,
    "end": 157.696,
    "duration": 2.691
  },
  {
    "id": 37,
    "text": "最终又归结于“一切的一，和谐”的泛神论自我消融。",
    "start": 157.696,
    "end": 160.663,
    "duration": 2.967
  },
  {
    "id": 38,
    "text": "这种高亢与苦闷、狂暴与孤寂的二元交织，",
    "start": 160.663,
    "end": 166.523,
    "duration": 5.86
  },
  {
    "id": 39,
    "text": "真实深刻地度量了早期五四知识分子在启蒙裂变中的复杂心灵脉动。",
    "start": 166.523,
    "end": 168.86,
    "duration": 2.337
  },
  {
    "id": 40,
    "text": "第三，引入斯宾诺莎泛神论哲学，确立物我交融、",
    "start": 168.86,
    "end": 170.983,
    "duration": 2.123
  },
  {
    "id": 41,
    "text": "狂飙飞动的主体性意象体系。",
    "start": 170.983,
    "end": 175.003,
    "duration": 4.02
  },
  {
    "id": 42,
    "text": "郭沫若借鉴西方泛神论思想，提出“一切自然都是神的表现，",
    "start": 175.003,
    "end": 178.311,
    "duration": 3.308
  },
  {
    "id": 43,
    "text": "我即是神”的诗学命题，",
    "start": 178.311,
    "end": 186.225,
    "duration": 7.914
  },
  {
    "id": 44,
    "text": "并在创作中将其转化为独特的“泛我论”美学机制。",
    "start": 186.225,
    "end": 191.197,
    "duration": 4.972
  },
  {
    "id": 45,
    "text": "他彻底打破了人与自然对立的传统界限，",
    "start": 191.197,
    "end": 201.583,
    "duration": 10.386
  },
  {
    "id": 46,
    "text": "将主体意志强力灌注于宇宙万物，使自然的山川、",
    "start": 201.583,
    "end": 205.402,
    "duration": 3.819
  },
  {
    "id": 47,
    "text": "雷电与海洋均成为诗人奔涌情感的具象外化。",
    "start": 205.402,
    "end": 207.943,
    "duration": 2.541
  },
  {
    "id": 48,
    "text": "作品扫除了中国古典传统中常见的纤细、阴柔与感伤意象，",
    "start": 207.943,
    "end": 213.17,
    "duration": 5.227
  },
  {
    "id": 49,
    "text": "在《立在地球边上放号》中以排山倒海的呼告，将地球、",
    "start": 213.17,
    "end": 217.27,
    "duration": 4.1
  },
  {
    "id": 50,
    "text": "海洋与太阳推向极境，",
    "start": 217.27,
    "end": 219.233,
    "duration": 1.963
  },
  {
    "id": 51,
    "text": "赞颂不断毁坏又不断创造的“力的绘画”与“力的舞蹈”，",
    "start": 219.233,
    "end": 224.536,
    "duration": 5.303
  },
  {
    "id": 52,
    "text": "构筑起阔大、奇异与飞动的现代壮美意象群。",
    "start": 224.536,
    "end": 227.594,
    "duration": 3.058
  },
  {
    "id": 53,
    "text": "第四，打破传统声律镣铐，",
    "start": 227.594,
    "end": 228.808,
    "duration": 1.214
  },
  {
    "id": 54,
    "text": "确立“情绪决定形式”的现代自由诗范式。",
    "start": 228.808,
    "end": 233.801,
    "duration": 4.993
  },
  {
    "id": 55,
    "text": "郭沫若坚决反对古典旧诗与早期尝试派新诗的形式规约，",
    "start": 233.801,
    "end": 240.075,
    "duration": 6.274
  },
  {
    "id": 56,
    "text": "主张“诗的本职专在抒情”，",
    "start": 240.075,
    "end": 242.376,
    "duration": 2.301
  },
  {
    "id": 57,
    "text": "强调诗歌的外在节律必须完全服从内在情感的自然流淌。",
    "start": 242.376,
    "end": 246.375,
    "duration": 3.999
  },
  {
    "id": 58,
    "text": "他在创作中主要开创了两类典范形式：一类如《天狗》，",
    "start": 246.375,
    "end": 250.849,
    "duration": 4.474
  },
  {
    "id": 59,
    "text": "以一泻千里、长短错落的狂暴长句随情绪波澜自由舒卷，",
    "start": 250.849,
    "end": 254.343,
    "duration": 3.494
  },
  {
    "id": 60,
    "text": "创造了内蕴火山爆发力的自由体；另一类如《炉中煤》，",
    "start": 254.343,
    "end": 255.552,
    "duration": 1.209
  },
  {
    "id": 61,
    "text": "巧妙运用重叠、排比与自然音韵的复沓，",
    "start": 255.552,
    "end": 257.695,
    "duration": 2.143
  },
  {
    "id": 62,
    "text": "赋予深沉的眷念之情以和谐回环的内在声律。",
    "start": 257.695,
    "end": 259.18,
    "duration": 1.485
  },
  {
    "id": 63,
    "text": "这种彻底破格的文体解放，",
    "start": 259.18,
    "end": 262.452,
    "duration": 3.272
  },
  {
    "id": 64,
    "text": "为中国现代新诗的文体建设拓辟了无限广阔的表现空间。",
    "start": 262.452,
    "end": 266.42,
    "duration": 3.968
  },
  {
    "id": 65,
    "text": "综上所述，郭沫若的《女神》以时代的火山喷火口之势，",
    "start": 266.42,
    "end": 267.529,
    "duration": 1.109
  },
  {
    "id": 66,
    "text": "实现了民族精神、哲学开掘与诗体革命的美学统一。",
    "start": 267.529,
    "end": 268.802,
    "duration": 1.273
  },
  {
    "id": 67,
    "text": "它不仅开创了中国现代浪漫主义新诗的崭新历史，",
    "start": 268.802,
    "end": 270.77,
    "duration": 1.968
  },
  {
    "id": 68,
    "text": "更为中华民族在现代觉醒中树立了一座不可磨灭的精神丰碑。",
    "start": 270.77,
    "end": 271.68,
    "duration": 0.91
  }
]