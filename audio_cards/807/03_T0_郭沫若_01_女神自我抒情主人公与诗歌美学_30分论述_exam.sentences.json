[
  {
    "id": 1,
    "text": "试论郭沫若《女神》的自我抒情主人公形象与诗歌美学特色。",
    "start": 0.05,
    "end": 5.406,
    "duration": 5.356
  },
  {
    "id": 2,
    "text": "五四新文化运动高潮时期，郭沫若诗集《女神》的问世，",
    "start": 5.406,
    "end": 9.64,
    "duration": 4.234
  },
  {
    "id": 3,
    "text": "是中国现代新诗史上具有划时代意义的奠基之作。",
    "start": 9.64,
    "end": 13.999,
    "duration": 4.359
  },
  {
    "id": 4,
    "text": "它的成功在于五四时代精神与诗人浪漫主义个性的高度统一，",
    "start": 13.999,
    "end": 19.124,
    "duration": 5.125
  },
  {
    "id": 5,
    "text": "正所谓“个人的郁结，民族的郁结，",
    "start": 19.124,
    "end": 22.127,
    "duration": 3.003
  },
  {
    "id": 6,
    "text": "在浪漫主义这里找到了喷火口”。",
    "start": 22.127,
    "end": 24.67,
    "duration": 2.543
  },
  {
    "id": 7,
    "text": "郭沫若以火山爆发式的激情彻底打破了古典旧体诗歌的格律桎梏，",
    "start": 24.67,
    "end": 30.246,
    "duration": 5.576
  },
  {
    "id": 8,
    "text": "以泛神论哲学为精神基石，",
    "start": 30.246,
    "end": 32.53,
    "duration": 2.284
  },
  {
    "id": 9,
    "text": "塑造了具有多重精神维度的自我抒情主人公，",
    "start": 32.53,
    "end": 36.12,
    "duration": 3.59
  },
  {
    "id": 10,
    "text": "开创了阔大奇异的意象体系与绝端自由的现代新诗体式，",
    "start": 36.12,
    "end": 41.306,
    "duration": 5.186
  },
  {
    "id": 11,
    "text": "确立了中国现代浪漫主义新诗的崇高美学范式。",
    "start": 41.306,
    "end": 47.052,
    "duration": 5.746
  },
  {
    "id": 12,
    "text": "其思想意蕴与艺术成就主要体现在以下四个核心维度：",
    "start": 47.052,
    "end": 51.234,
    "duration": 4.182
  },
  {
    "id": 13,
    "text": "第一，塑造觉醒时代的多维抒情主人公，",
    "start": 51.234,
    "end": 54.415,
    "duration": 3.181
  },
  {
    "id": 14,
    "text": "实现“小我”与民族“大我”的崇高融合。",
    "start": 54.415,
    "end": 57.567,
    "duration": 3.152
  },
  {
    "id": 15,
    "text": "《女神》中的自我绝非狭隘孤立的个人倾诉，",
    "start": 57.567,
    "end": 61.113,
    "duration": 3.546
  },
  {
    "id": 16,
    "text": "而是被五四时代彻底激活的现代主体形象。",
    "start": 61.113,
    "end": 65.052,
    "duration": 3.939
  },
  {
    "id": 17,
    "text": "其抒情主人公呈现出层次丰富的光谱：",
    "start": 65.052,
    "end": 68.681,
    "duration": 3.629
  },
  {
    "id": 18,
    "text": "一是在《凤凰涅槃》中集香木自焚并于死灰中更生、",
    "start": 68.681,
    "end": 72.537,
    "duration": 3.856
  },
  {
    "id": 19,
    "text": "象征古老中华民族浴火重生的“大我”；",
    "start": 72.537,
    "end": 76.489,
    "duration": 3.952
  },
  {
    "id": 20,
    "text": "二是在《女神之再生》中宣告新酿的酒浆不能盛在旧皮囊中、",
    "start": 76.489,
    "end": 82.173,
    "duration": 5.684
  },
  {
    "id": 21,
    "text": "誓死彻底砸碎旧世界的“新人”；",
    "start": 82.173,
    "end": 84.355,
    "duration": 2.182
  },
  {
    "id": 22,
    "text": "三是在《天狗》中以吞食日月的狂暴能量高呼“我便是我”、",
    "start": 84.355,
    "end": 88.856,
    "duration": 4.501
  },
  {
    "id": 23,
    "text": "在中国文学史上首次宣告个体神性与自主意志的“神我”；",
    "start": 88.856,
    "end": 94.01,
    "duration": 5.154
  },
  {
    "id": 24,
    "text": "四是在《晨安》中以博大胸怀向大自然山川与世界人类文明致敬的“世界人”。",
    "start": 94.01,
    "end": 99.464,
    "duration": 5.454
  },
  {
    "id": 25,
    "text": "这些形象交织共振，",
    "start": 99.464,
    "end": 102.045,
    "duration": 2.581
  },
  {
    "id": 26,
    "text": "完整具象化了五四时期被压抑生命力破土而出的时代狂飙。",
    "start": 102.045,
    "end": 106.594,
    "duration": 4.549
  },
  {
    "id": 27,
    "text": "第二，揭示高亢狂飙背后的矛盾与沉郁，",
    "start": 106.594,
    "end": 110.511,
    "duration": 3.917
  },
  {
    "id": 28,
    "text": "立体呈现五四知识分子的精神搏斗。",
    "start": 110.511,
    "end": 113.238,
    "duration": 2.727
  },
  {
    "id": 29,
    "text": "高水平的浪漫主义绝非单一维度的狂热宣泄，",
    "start": 113.238,
    "end": 117.014,
    "duration": 3.776
  },
  {
    "id": 30,
    "text": "《女神》的抒情主人公同时包含着深沉的内在张力与悲凉底色。",
    "start": 117.014,
    "end": 122.508,
    "duration": 5.494
  },
  {
    "id": 31,
    "text": "在火山喷发般的豪迈赞歌背面，",
    "start": 122.508,
    "end": 124.991,
    "duration": 2.483
  },
  {
    "id": 32,
    "text": "深藏着现代个体在旧体制废墟上的孤独、眷恋与忏悔。",
    "start": 124.991,
    "end": 129.321,
    "duration": 4.33
  },
  {
    "id": 33,
    "text": "在《天狗》中，自我的极度膨胀伴随着剥皮食肉的自我凌迟；",
    "start": 129.321,
    "end": 135.257,
    "duration": 5.936
  },
  {
    "id": 34,
    "text": "在《湘累》中，",
    "start": 135.257,
    "end": 136.221,
    "duration": 0.964
  },
  {
    "id": 35,
    "text": "屈原在天马行空的创造之后陷入了不可言说的深沉寂寞；",
    "start": 136.221,
    "end": 140.585,
    "duration": 4.364
  },
  {
    "id": 36,
    "text": "而《凤凰涅槃》在追求主体极致爆发的同时，",
    "start": 140.585,
    "end": 143.742,
    "duration": 3.157
  },
  {
    "id": 37,
    "text": "最终又归结于“一切的一，和谐”的泛神论自我消融。",
    "start": 143.742,
    "end": 147.855,
    "duration": 4.113
  },
  {
    "id": 38,
    "text": "这种高亢与苦闷、狂暴与孤寂的二元交织，",
    "start": 147.855,
    "end": 151.701,
    "duration": 3.846
  },
  {
    "id": 39,
    "text": "真实深刻地度量了早期五四知识分子在启蒙裂变中的复杂心灵脉动。",
    "start": 151.701,
    "end": 157.666,
    "duration": 5.965
  },
  {
    "id": 40,
    "text": "第三，引入斯宾诺莎泛神论哲学，确立物我交融、",
    "start": 157.666,
    "end": 161.373,
    "duration": 3.707
  },
  {
    "id": 41,
    "text": "狂飙飞动的主体性意象体系。",
    "start": 161.373,
    "end": 164.131,
    "duration": 2.758
  },
  {
    "id": 42,
    "text": "郭沫若借鉴西方泛神论思想，提出“一切自然都是神的表现，",
    "start": 164.131,
    "end": 168.83,
    "duration": 4.699
  },
  {
    "id": 43,
    "text": "我即是神”的诗学命题，",
    "start": 168.83,
    "end": 170.953,
    "duration": 2.123
  },
  {
    "id": 44,
    "text": "并在创作中将其转化为独特的“泛我论”美学机制。",
    "start": 170.953,
    "end": 174.973,
    "duration": 4.02
  },
  {
    "id": 45,
    "text": "他彻底打破了人与自然对立的传统界限，",
    "start": 174.973,
    "end": 178.282,
    "duration": 3.309
  },
  {
    "id": 46,
    "text": "将主体意志强力灌注于宇宙万物，使自然的山川、",
    "start": 178.282,
    "end": 183.433,
    "duration": 5.151
  },
  {
    "id": 47,
    "text": "雷电与海洋均成为诗人奔涌情感的具象外化。",
    "start": 183.433,
    "end": 187.177,
    "duration": 3.744
  },
  {
    "id": 48,
    "text": "作品扫除了中国古典传统中常见的纤细、阴柔与感伤意象，",
    "start": 187.177,
    "end": 192.102,
    "duration": 4.925
  },
  {
    "id": 49,
    "text": "在《立在地球边上放号》中以排山倒海的呼告，将地球、",
    "start": 192.102,
    "end": 197.314,
    "duration": 5.212
  },
  {
    "id": 50,
    "text": "海洋与太阳推向极境，",
    "start": 197.314,
    "end": 199.768,
    "duration": 2.454
  },
  {
    "id": 51,
    "text": "赞颂不断毁坏又不断创造的“力的绘画”与“力的舞蹈”，",
    "start": 199.768,
    "end": 203.586,
    "duration": 3.818
  },
  {
    "id": 52,
    "text": "构筑起阔大、奇异与飞动的现代壮美意象群。",
    "start": 203.586,
    "end": 208.061,
    "duration": 4.475
  },
  {
    "id": 53,
    "text": "第四，打破传统声律镣铐，",
    "start": 208.061,
    "end": 210.017,
    "duration": 1.956
  },
  {
    "id": 54,
    "text": "确立“情绪决定形式”的现代自由诗范式。",
    "start": 210.017,
    "end": 213.14,
    "duration": 3.123
  },
  {
    "id": 55,
    "text": "郭沫若坚决反对古典旧诗与早期尝试派新诗的形式规约，",
    "start": 213.14,
    "end": 218.182,
    "duration": 5.042
  },
  {
    "id": 56,
    "text": "主张“诗的本职专在抒情”，",
    "start": 218.182,
    "end": 221.25,
    "duration": 3.068
  },
  {
    "id": 57,
    "text": "强调诗歌的外在节律必须完全服从内在情感的自然流淌。",
    "start": 221.25,
    "end": 225.614,
    "duration": 4.364
  },
  {
    "id": 58,
    "text": "他在创作中主要开创了两类典范形式：一类如《天狗》，",
    "start": 225.614,
    "end": 229.839,
    "duration": 4.225
  },
  {
    "id": 59,
    "text": "以一泻千里、长短错落的狂暴长句随情绪波澜自由舒卷，",
    "start": 229.839,
    "end": 234.021,
    "duration": 4.182
  },
  {
    "id": 60,
    "text": "创造了内蕴火山爆发力的自由体；另一类如《炉中煤》，",
    "start": 234.021,
    "end": 238.552,
    "duration": 4.531
  },
  {
    "id": 61,
    "text": "巧妙运用重叠、排比与自然音韵的复沓，",
    "start": 238.552,
    "end": 242.346,
    "duration": 3.794
  },
  {
    "id": 62,
    "text": "赋予深沉的眷念之情以和谐回环的内在声律。",
    "start": 242.346,
    "end": 246.345,
    "duration": 3.999
  },
  {
    "id": 63,
    "text": "这种彻底破格的文体解放，",
    "start": 246.345,
    "end": 248.461,
    "duration": 2.116
  },
  {
    "id": 64,
    "text": "为中国现代新诗的文体建设拓辟了无限广阔的表现空间。",
    "start": 248.461,
    "end": 253.27,
    "duration": 4.809
  },
  {
    "id": 65,
    "text": "综上所述，郭沫若的《女神》以时代的火山喷火口之势，",
    "start": 253.27,
    "end": 257.676,
    "duration": 4.406
  },
  {
    "id": 66,
    "text": "实现了民族精神、哲学开掘与诗体革命的美学统一。",
    "start": 257.676,
    "end": 262.422,
    "duration": 4.746
  },
  {
    "id": 67,
    "text": "它不仅开创了中国现代浪漫主义新诗的崭新历史，",
    "start": 262.422,
    "end": 266.39,
    "duration": 3.968
  },
  {
    "id": 68,
    "text": "更为中华民族在现代觉醒中树立了一座不可磨灭的精神丰碑。",
    "start": 266.39,
    "end": 271.68,
    "duration": 5.29
  }
]