[
  {
    "id": 1,
    "text": "试论郭沫若《女神》的自我抒情主人公形象与诗歌美学特色。",
    "start": 0.28,
    "end": 5.32,
    "duration": 5.04
  },
  {
    "id": 2,
    "text": "五四新文化运动高潮时期，郭沫若诗集《女神》的问世，是中国现代新诗史上的奠基之作。",
    "start": 5.84,
    "end": 12.32,
    "duration": 6.48
  },
  {
    "id": 3,
    "text": "它的成功在于五四时代精神与诗人浪漫主义个性的统一，",
    "start": 12.84,
    "end": 17.48,
    "duration": 4.64
  },
  {
    "id": 4,
    "text": "正所谓“个人的郁结，民族的郁结，在浪漫主义这里找到了喷火口”。",
    "start": 17.88,
    "end": 23.4,
    "duration": 5.52
  },
  {
    "id": 5,
    "text": "郭沫若以火山爆发般的激情打破古典旧诗的格律桎梏，以泛神论哲学为基石，",
    "start": 23.92,
    "end": 30.69,
    "duration": 6.77
  },
  {
    "id": 6,
    "text": "塑造了多重维度的自我抒情主人公，开创了阔大奇异的意象体系与自由新诗体式，",
    "start": 31.06,
    "end": 38.07,
    "duration": 7.01
  },
  {
    "id": 7,
    "text": "确立了现代浪漫主义新诗的崇高美学范式。",
    "start": 38.44,
    "end": 41.72,
    "duration": 3.28
  },
  {
    "id": 8,
    "text": "其思想意蕴与艺术成就主要体现在以下四个方面：",
    "start": 42.24,
    "end": 46.0,
    "duration": 3.76
  },
  {
    "id": 9,
    "text": "第一，塑造觉醒时代的多维抒情主人公，达成“小我”与民族“大我”的崇高融合。",
    "start": 46.37,
    "end": 53.09,
    "duration": 6.72
  },
  {
    "id": 10,
    "text": "《女神》中的自我是被五四时代激活的现代主体形象。",
    "start": 53.61,
    "end": 57.61,
    "duration": 4.0
  },
  {
    "id": 11,
    "text": "其抒情主人公呈现出丰富的精神光谱：",
    "start": 58.13,
    "end": 61.17,
    "duration": 3.04
  },
  {
    "id": 12,
    "text": "一是在《凤凰涅槃》中集香木自焚并于死灰中更生、象征古老中华民族浴火重生的“大我”；",
    "start": 61.54,
    "end": 69.38,
    "duration": 7.84
  },
  {
    "id": 13,
    "text": "二是在《女神之再生》中，写诸女神先共议再造太阳、在共工颛顼触折不周山后，女神们拒绝修补破败旧天、高唱“我们要去创造一个新鲜的太阳”的情节，",
    "start": 69.9,
    "end": 82.51,
    "duration": 12.61
  },
  {
    "id": 14,
    "text": "塑造出誓破旧世界、另造新天地的“新人”；",
    "start": 82.88,
    "end": 86.48,
    "duration": 3.6
  },
  {
    "id": 15,
    "text": "三是在《天狗》中以吞食日月的能量高呼“我便是我”、宣告个体神性与自主意志的“神我”；",
    "start": 87.0,
    "end": 94.261,
    "duration": 7.261
  },
  {
    "id": 16,
    "text": "四是在《晨安》中向自然山川与世界人类文明致敬的“世界人”。",
    "start": 94.761,
    "end": 99.68,
    "duration": 4.919
  },
  {
    "id": 17,
    "text": "这些形象交织共振，具象化了五四时期生命力破土而出的时代狂飙。",
    "start": 100.2,
    "end": 106.2,
    "duration": 6.0
  },
  {
    "id": 18,
    "text": "第二，揭示高亢狂飙背后的矛盾与沉郁，立体呈现五四知识分子的精神搏斗。",
    "start": 106.72,
    "end": 112.88,
    "duration": 6.16
  },
  {
    "id": 19,
    "text": "成熟的浪漫主义从不流于单一狂热宣泄，",
    "start": 113.4,
    "end": 116.36,
    "duration": 2.96
  },
  {
    "id": 20,
    "text": "《女神》的抒情主人公蕴含着深沉的内在张力与悲凉底色。",
    "start": 116.73,
    "end": 120.73,
    "duration": 4.0
  },
  {
    "id": 21,
    "text": "在火山喷发般的豪迈赞歌背面，深藏着现代个体在旧体制废墟上的孤独、眷恋与忏悔。",
    "start": 121.25,
    "end": 129.0,
    "duration": 7.75
  },
  {
    "id": 22,
    "text": "在《天狗》中，自我的急剧膨胀伴随着剥皮食肉的自我凌迟；",
    "start": 129.5,
    "end": 134.09,
    "duration": 4.59
  },
  {
    "id": 23,
    "text": "在《湘累》中，屈原在天马行空的创造之后陷入不可言说的寥寂；",
    "start": 134.61,
    "end": 139.65,
    "duration": 5.04
  },
  {
    "id": 24,
    "text": "《凤凰涅槃》在追求主体烈度爆发的同时，最终归结于“一切的一，和谐”的泛神论自我消融。",
    "start": 140.17,
    "end": 147.85,
    "duration": 7.68
  },
  {
    "id": 25,
    "text": "高亢与苦闷、狂暴与孤寂的交织，真实度量了五四知识分子在启蒙裂变中的复杂心灵脉动。",
    "start": 148.37,
    "end": 156.37,
    "duration": 8.0
  },
  {
    "id": 26,
    "text": "第三，引入泛神论哲学，确立物我交融、狂飙飞动的主体性意象体系。",
    "start": 156.89,
    "end": 162.97,
    "duration": 6.08
  },
  {
    "id": 27,
    "text": "郭沫若借鉴斯宾诺莎等西方泛神论思想，",
    "start": 163.49,
    "end": 166.85,
    "duration": 3.36
  },
  {
    "id": 28,
    "text": "提出“一切自然只是神的表现，我即是神”的诗学命题，并在创作中转化为独特的“泛我论”美学机制。",
    "start": 167.22,
    "end": 175.38,
    "duration": 8.16
  },
  {
    "id": 29,
    "text": "他打破人与自然对立的传统界限，将主体意志灌注于宇宙万物，",
    "start": 175.9,
    "end": 181.42,
    "duration": 5.52
  },
  {
    "id": 30,
    "text": "使山川、雷电与海洋均成为奔涌情感的外化。",
    "start": 181.79,
    "end": 185.95,
    "duration": 4.16
  },
  {
    "id": 31,
    "text": "作品扫除中国古典传统中常见的纤细、阴柔与感伤意象，",
    "start": 186.47,
    "end": 191.43,
    "duration": 4.96
  },
  {
    "id": 32,
    "text": "在《立在地球边上放号》中以排山倒海的呼告，将地球、海洋与太阳推向极境，",
    "start": 191.853,
    "end": 198.41,
    "duration": 6.557
  },
  {
    "id": 33,
    "text": "赞颂不断毁坏又不断创造的“力的绘画”与“力的舞蹈”，",
    "start": 198.81,
    "end": 203.13,
    "duration": 4.32
  },
  {
    "id": 34,
    "text": "构筑起阔大、奇异与飞动的现代壮美意象群。",
    "start": 203.5,
    "end": 207.66,
    "duration": 4.16
  },
  {
    "id": 35,
    "text": "第四，打破传统声律镣铐，确立“情绪决定形式”的现代自由诗范式。",
    "start": 208.18,
    "end": 214.74,
    "duration": 6.56
  },
  {
    "id": 36,
    "text": "郭沫若反对古典旧诗与早期尝试派新诗的形式规约，",
    "start": 215.26,
    "end": 219.74,
    "duration": 4.48
  },
  {
    "id": 37,
    "text": "主张“诗的本职专在抒情”，强调外在节律必须服从内在情感的自然流淌。",
    "start": 220.11,
    "end": 226.43,
    "duration": 6.32
  },
  {
    "id": 38,
    "text": "他在创作中开创了两类典范形式：",
    "start": 226.95,
    "end": 229.83,
    "duration": 2.88
  },
  {
    "id": 39,
    "text": "一类如《天狗》，以一泻千里、长短错落的句式随情绪波澜自由舒卷，创造了富有火山爆发力的自由体；",
    "start": 230.2,
    "end": 238.92,
    "duration": 8.72
  },
  {
    "id": 40,
    "text": "另一类如《炉中煤》，巧妙运用重叠、排比与自然音韵的复沓，",
    "start": 239.44,
    "end": 244.72,
    "duration": 5.28
  },
  {
    "id": 41,
    "text": "赋予深沉眷念以和谐回环的内在声律。",
    "start": 245.12,
    "end": 248.389,
    "duration": 3.269
  },
  {
    "id": 42,
    "text": "这种大胆破格的文体解放，为中国现代新诗拓辟了广阔的表现空间。",
    "start": 248.889,
    "end": 254.44,
    "duration": 5.551
  },
  {
    "id": 43,
    "text": "要而言之，郭沫若的《女神》以时代喷火口之势，达成了民族精神、哲学开掘与诗体革命的高度统一。",
    "start": 254.96,
    "end": 263.68,
    "duration": 8.72
  },
  {
    "id": 44,
    "text": "它开创了中国现代浪漫主义新诗的崭新篇章，为中国新诗在现代觉醒中奠定了坚实的精神基石。",
    "start": 264.2,
    "end": 271.96,
    "duration": 7.76
  }
]
