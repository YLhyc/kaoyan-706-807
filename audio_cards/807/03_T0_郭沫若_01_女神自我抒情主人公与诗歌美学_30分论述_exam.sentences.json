[
  {
    "id": 1,
    "text": "试论郭沫若《女神》的自我抒情主人公形象与诗歌美学特色。",
    "start": 0.16,
    "end": 4.893,
    "duration": 4.733
  },
  {
    "id": 2,
    "text": "五四新文化运动高潮时期，郭沫若诗集《女神》的问世，是中国现代新诗史上的奠基之作。",
    "start": 5.311,
    "end": 12.161,
    "duration": 6.85
  },
  {
    "id": 3,
    "text": "它的成功在于五四时代精神与诗人浪漫主义个性的统一，",
    "start": 12.689,
    "end": 17.024,
    "duration": 4.335
  },
  {
    "id": 4,
    "text": "正所谓“个人的郁结，民族的郁结，在浪漫主义这里找到了喷火口”。",
    "start": 17.436,
    "end": 22.639,
    "duration": 5.203
  },
  {
    "id": 5,
    "text": "郭沫若以火山爆发般的激情打破古典旧诗的格律桎梏，以泛神论哲学为基石，",
    "start": 22.834,
    "end": 29.401,
    "duration": 6.567
  },
  {
    "id": 6,
    "text": "塑造了多重维度的自我抒情主人公，开创了阔大奇异的意象体系与自由新诗体式，",
    "start": 29.525,
    "end": 36.278,
    "duration": 6.753
  },
  {
    "id": 7,
    "text": "确立了现代浪漫主义新诗的崇高美学范式。",
    "start": 36.366,
    "end": 39.666,
    "duration": 3.3
  },
  {
    "id": 8,
    "text": "其思想意蕴与艺术成就主要体现在以下四个方面：",
    "start": 39.956,
    "end": 43.832,
    "duration": 3.876
  },
  {
    "id": 9,
    "text": "第一，塑造觉醒时代的多维抒情主人公，达成“小我”与民族“大我”的崇高融合。",
    "start": 44.497,
    "end": 51.511,
    "duration": 7.014
  },
  {
    "id": 10,
    "text": "《女神》中的自我是被五四时代激活的现代主体形象。",
    "start": 51.949,
    "end": 55.769,
    "duration": 3.82
  },
  {
    "id": 11,
    "text": "其抒情主人公呈现出丰富的精神光谱：",
    "start": 56.28,
    "end": 59.219,
    "duration": 2.939
  },
  {
    "id": 12,
    "text": "一是在《凤凰涅槃》中集香木自焚并于死灰中更生、象征古老中华民族浴火重生的“大我”；",
    "start": 59.674,
    "end": 67.087,
    "duration": 7.413
  },
  {
    "id": 13,
    "text": "二是在《女神之再生》中，写诸女神先共议再造太阳、在共工颛顼触折不周山后",
    "start": 67.291,
    "end": 73.745,
    "duration": 6.454
  },
  {
    "id": 14,
    "text": "女神们拒绝修补破败旧天、高唱“我们要去创造一个新鲜的太阳”的情节，",
    "start": 73.981,
    "end": 79.499,
    "duration": 5.518
  },
  {
    "id": 15,
    "text": "塑造出誓破旧世界、另造新天地的“新人”；",
    "start": 79.634,
    "end": 82.95,
    "duration": 3.316
  },
  {
    "id": 16,
    "text": "三是在《天狗》中以吞食日月的能量高呼“我便是我”、宣告个体神性与自主意志的“神我”；",
    "start": 83.248,
    "end": 90.674,
    "duration": 7.426
  },
  {
    "id": 17,
    "text": "四是在《晨安》中向自然山川与世界人类文明致敬的“世界人”。",
    "start": 91.227,
    "end": 96.076,
    "duration": 4.849
  },
  {
    "id": 18,
    "text": "这些形象交织共振，具象化了五四时期生命力破土而出的时代狂飙。",
    "start": 96.341,
    "end": 101.989,
    "duration": 5.648
  },
  {
    "id": 19,
    "text": "第二，揭示高亢狂飙背后的矛盾与沉郁，立体呈现五四知识分子的精神搏斗。",
    "start": 102.602,
    "end": 108.569,
    "duration": 5.967
  },
  {
    "id": 20,
    "text": "成熟的浪漫主义从不流于单一狂热宣泄，",
    "start": 108.942,
    "end": 112.011,
    "duration": 3.069
  },
  {
    "id": 21,
    "text": "《女神》的抒情主人公蕴含着深沉的内在张力与悲凉底色。",
    "start": 112.442,
    "end": 116.569,
    "duration": 4.127
  },
  {
    "id": 22,
    "text": "在火山喷发般的豪迈赞歌背面，深藏着现代个体在旧体制废墟上的孤独、眷恋与忏悔。",
    "start": 116.991,
    "end": 124.197,
    "duration": 7.206
  },
  {
    "id": 23,
    "text": "在《天狗》中，自我的急剧膨胀伴随着剥皮食肉的自我凌迟；",
    "start": 124.447,
    "end": 128.921,
    "duration": 4.474
  },
  {
    "id": 24,
    "text": "在《湘累》中，屈原在天马行空的创造之后陷入不可言说的寥寂；",
    "start": 129.294,
    "end": 134.421,
    "duration": 5.127
  },
  {
    "id": 25,
    "text": "《凤凰涅槃》在追求主体烈度爆发的同时，最终归结于“一切的一，和谐”的泛神论自我消融。",
    "start": 134.853,
    "end": 142.468,
    "duration": 7.615
  },
  {
    "id": 26,
    "text": "高亢与苦闷、狂暴与孤寂的交织，真实度量了五四知识分子在启蒙裂变中的复杂心灵脉动。",
    "start": 142.761,
    "end": 150.129,
    "duration": 7.368
  },
  {
    "id": 27,
    "text": "第三，引入泛神论哲学，确立物我交融、狂飙飞动的主体性意象体系。",
    "start": 150.825,
    "end": 156.796,
    "duration": 5.971
  },
  {
    "id": 28,
    "text": "郭沫若借鉴斯宾诺莎等西方泛神论思想，",
    "start": 157.107,
    "end": 160.131,
    "duration": 3.024
  },
  {
    "id": 29,
    "text": "提出“一切自然只是神的表现，我即是神”的诗学命题，并在创作中转化为独特的“泛我论”美学机制。",
    "start": 160.446,
    "end": 168.447,
    "duration": 8.001
  },
  {
    "id": 30,
    "text": "他打破人与自然对立的传统界限，将主体意志灌注于宇宙万物，",
    "start": 168.868,
    "end": 173.665,
    "duration": 4.797
  },
  {
    "id": 31,
    "text": "使山川、雷电与海洋均成为奔涌情感的外化。",
    "start": 173.941,
    "end": 177.963,
    "duration": 4.022
  },
  {
    "id": 32,
    "text": "作品扫除中国古典传统中常见的纤细、阴柔与感伤意象，",
    "start": 178.155,
    "end": 182.853,
    "duration": 4.698
  },
  {
    "id": 33,
    "text": "在《立在地球边上放号》中以排山倒海的呼告，将地球、海洋与太阳推向极境，",
    "start": 183.005,
    "end": 189.421,
    "duration": 6.416
  },
  {
    "id": 34,
    "text": "赞颂不断毁坏又不断创造的“力的绘画”与“力的舞蹈”，",
    "start": 189.536,
    "end": 193.819,
    "duration": 4.283
  },
  {
    "id": 35,
    "text": "构筑起阔大、奇异与飞动的现代壮美意象群。",
    "start": 194.115,
    "end": 198.286,
    "duration": 4.171
  },
  {
    "id": 36,
    "text": "第四，打破传统声律镣铐，确立“情绪决定形式”的现代自由诗范式。",
    "start": 198.882,
    "end": 205.363,
    "duration": 6.481
  },
  {
    "id": 37,
    "text": "郭沫若反对古典旧诗与早期尝试派新诗的形式规约，",
    "start": 205.631,
    "end": 209.993,
    "duration": 4.362
  },
  {
    "id": 38,
    "text": "主张“诗的本职专在抒情”，强调外在节律必须服从内在情感的自然流淌。",
    "start": 210.355,
    "end": 217.073,
    "duration": 6.718
  },
  {
    "id": 39,
    "text": "他在创作中开创了两类典范形式：一类如《天狗》，",
    "start": 217.766,
    "end": 221.763,
    "duration": 3.997
  },
  {
    "id": 40,
    "text": "以一泻千里、长短错落的句式随情绪波澜自由舒卷，创造了富有火山爆发力的自由体；",
    "start": 222.008,
    "end": 229.875,
    "duration": 7.867
  },
  {
    "id": 41,
    "text": "另一类如《炉中煤》，巧妙运用重叠、排比与自然音韵的复沓，",
    "start": 230.403,
    "end": 235.861,
    "duration": 5.458
  },
  {
    "id": 42,
    "text": "赋予深沉眷念以和谐回环的内在声律。",
    "start": 236.238,
    "end": 239.577,
    "duration": 3.339
  },
  {
    "id": 43,
    "text": "这种大胆破格的文体解放，为中国现代新诗拓辟了广阔的表现空间。",
    "start": 239.761,
    "end": 245.234,
    "duration": 5.473
  },
  {
    "id": 44,
    "text": "要而言之，郭沫若的《女神》以时代喷火口之势，达成了民族精神、哲学开掘与诗体革命的高度统一。",
    "start": 245.913,
    "end": 254.293,
    "duration": 8.38
  },
  {
    "id": 45,
    "text": "它开创了中国现代浪漫主义新诗的崭新篇章，为中国新诗在现代觉醒中奠定了坚实的精神基石。",
    "start": 254.518,
    "end": 261.916,
    "duration": 7.398
  }
]