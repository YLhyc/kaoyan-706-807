[
  {
    "id": 1,
    "text": "郭沫若的诗集《女神》是中国现代新诗史上具有划时代意义的奠基之作。",
    "start": 0.08,
    "end": 6.88,
    "duration": 6.8
  },
  {
    "id": 2,
    "text": "它的成功在于五四时代精神与诗人浪漫主义个性的高度统一。",
    "start": 6.88,
    "end": 12.32,
    "duration": 5.44
  },
  {
    "id": 3,
    "text": "个人与民族的深层郁结在浪漫主义这里找到了最充沛的喷火口。",
    "start": 12.32,
    "end": 18.08,
    "duration": 5.76
  },
  {
    "id": 4,
    "text": "郭沫若以火山爆发式的激情，打破了传统诗歌的僵化樊篱。",
    "start": 18.08,
    "end": 22.8,
    "duration": 4.72
  },
  {
    "id": 5,
    "text": "它塑造了具有多重精神维度的自我抒情主人公。",
    "start": 23.12,
    "end": 26.72,
    "duration": 3.6
  },
  {
    "id": 6,
    "text": "它以泛神论哲学为思想基石，创造了阔大奇异的意象系统与绝端自由的现代诗体，",
    "start": 26.72,
    "end": 33.76,
    "duration": 7.04
  },
  {
    "id": 7,
    "text": "在文学史上树立了空前自由的审美丰碑。",
    "start": 33.76,
    "end": 37.12,
    "duration": 3.36
  },
  {
    "id": 8,
    "text": "首先，在精神内涵上，《女神》成功塑造了体现五四时代觉醒的自我抒情主人公形象。",
    "start": 37.12,
    "end": 43.68,
    "duration": 6.56
  },
  {
    "id": 9,
    "text": "这一自我绝非孤立狭隘的个人发泄，",
    "start": 43.92,
    "end": 47.04,
    "duration": 3.12
  },
  {
    "id": 10,
    "text": "而是小我与民族大我的高度融合。",
    "start": 47.04,
    "end": 50.16,
    "duration": 3.12
  },
  {
    "id": 11,
    "text": "抒情主人公呈现出立体丰富的光谱。",
    "start": 50.16,
    "end": 53.36,
    "duration": 3.2
  },
  {
    "id": 12,
    "text": "其一是觉醒中华民族的“大我”，《凤凰涅盘》中凤凰集香木自焚，",
    "start": 53.36,
    "end": 58.56,
    "duration": 5.2
  },
  {
    "id": 13,
    "text": "在更生歌中象征着古老民族的涅盘重生。",
    "start": 58.56,
    "end": 62.08,
    "duration": 3.52
  },
  {
    "id": 14,
    "text": "其二是彻底破坏旧世界的“新人”，",
    "start": 62.08,
    "end": 64.88,
    "duration": 2.8
  },
  {
    "id": 15,
    "text": "《女神之再生》宣告新酿的酒浆不能盛在旧皮囊中，",
    "start": 64.88,
    "end": 68.96,
    "duration": 4.08
  },
  {
    "id": 16,
    "text": "呼唤新太阳的升起。",
    "start": 68.96,
    "end": 70.32,
    "duration": 1.36
  },
  {
    "id": 17,
    "text": "其三是极度张扬个性价值的“神我”，",
    "start": 70.56,
    "end": 73.68,
    "duration": 3.12
  },
  {
    "id": 18,
    "text": "《天狗》以吞食宇宙的狂暴力量高呼“我便是我”，",
    "start": 73.68,
    "end": 77.36,
    "duration": 3.68
  },
  {
    "id": 19,
    "text": "在历史上第一次宣告了人的价值、尊严与创造力。",
    "start": 77.36,
    "end": 81.2,
    "duration": 3.84
  },
  {
    "id": 20,
    "text": "其四是开眼看世界的“世界人”，《晨安》向全世界自然山川与人类文明致敬，",
    "start": 81.2,
    "end": 87.36,
    "duration": 6.16
  },
  {
    "id": 21,
    "text": "展现了前所未有的广阔胸怀。",
    "start": 87.36,
    "end": 89.6,
    "duration": 2.24
  },
  {
    "id": 22,
    "text": "其次，抒情主人公并非单向度的盲目狂热，",
    "start": 90.0,
    "end": 93.68,
    "duration": 3.68
  },
  {
    "id": 23,
    "text": "而是包含着深层矛盾的复杂精神立体。",
    "start": 93.68,
    "end": 96.72,
    "duration": 3.04
  },
  {
    "id": 24,
    "text": "在激昂狂暴的赞歌背面，深藏着抒情主人公的孤独、",
    "start": 96.72,
    "end": 101.12,
    "duration": 4.4
  },
  {
    "id": 25,
    "text": "倦怠与自叙传式的忏悔。",
    "start": 101.12,
    "end": 104.0,
    "duration": 2.88
  },
  {
    "id": 26,
    "text": "《天狗》在自我极度膨胀中伴随着剥皮食肉的自我否定。",
    "start": 104.0,
    "end": 108.4,
    "duration": 4.4
  },
  {
    "id": 27,
    "text": "《湘累》展现了屈原在创造天地之后的深沉寂寞。",
    "start": 108.4,
    "end": 111.76,
    "duration": 3.36
  },
  {
    "id": 28,
    "text": "《巨炮》流露出热烈喷发之后的虚脱与幻灭。",
    "start": 111.92,
    "end": 115.63,
    "duration": 3.71
  },
  {
    "id": 29,
    "text": "在哲学美学上，高唱自由创造的同时又在《凤凰涅盘》中归结为天人合一的自我消融。",
    "start": 115.63,
    "end": 123.051,
    "duration": 7.421
  },
  {
    "id": 30,
    "text": "这种高亢与苦闷交织的多重声音，真实深刻地反映了五四知识分子在启蒙浪潮中的复杂心理律动。",
    "start": 123.051,
    "end": 132.0,
    "duration": 8.949
  },
  {
    "id": 31,
    "text": "第三，在哲学基石上，郭沫若以泛神论思想确立了新诗强烈的主体性维度。",
    "start": 132.128,
    "end": 138.208,
    "duration": 6.08
  },
  {
    "id": 32,
    "text": "郭沫若吸纳了斯宾诺莎泛神论思想，",
    "start": 138.208,
    "end": 140.848,
    "duration": 2.64
  },
  {
    "id": 33,
    "text": "提出“一切自然都是神的表现，我即是神”的诗学命题。",
    "start": 140.848,
    "end": 145.008,
    "duration": 4.16
  },
  {
    "id": 34,
    "text": "这一观念在创作中转化为独特的“泛我论”机制。",
    "start": 145.008,
    "end": 148.528,
    "duration": 3.52
  },
  {
    "id": 35,
    "text": "它彻底拆除了人与自然之间的隔阂。",
    "start": 148.528,
    "end": 151.008,
    "duration": 2.48
  },
  {
    "id": 36,
    "text": "自然界的山川、雷电与风云全被赋予了作者的主体意志。",
    "start": 151.248,
    "end": 156.048,
    "duration": 4.8
  },
  {
    "id": 37,
    "text": "赞美地球与宇宙，就是赞美诗人自我的崇高力量。",
    "start": 156.048,
    "end": 159.888,
    "duration": 3.84
  },
  {
    "id": 38,
    "text": "主体意识的急剧膨胀，使自然万物成为诗人抒发个性激情的精神附庸，",
    "start": 159.888,
    "end": 165.248,
    "duration": 5.36
  },
  {
    "id": 39,
    "text": "为中国新诗注入了浩瀚的主观抒情力量。",
    "start": 165.248,
    "end": 168.768,
    "duration": 3.52
  },
  {
    "id": 40,
    "text": "第四，在诗歌意象上，《女神》创造了阔大、",
    "start": 168.768,
    "end": 172.368,
    "duration": 3.6
  },
  {
    "id": 41,
    "text": "奇异与飞动的崭新意象系统。",
    "start": 172.368,
    "end": 174.608,
    "duration": 2.24
  },
  {
    "id": 42,
    "text": "郭沫若扫除了中国传统古典诗歌的纤细阴柔之美。",
    "start": 174.848,
    "end": 179.248,
    "duration": 4.4
  },
  {
    "id": 43,
    "text": "他把包容一切的地球、胸涌浩瀚的海洋与光芒万丈的太阳确立为核心意象。",
    "start": 179.248,
    "end": 186.048,
    "duration": 6.8
  },
  {
    "id": 44,
    "text": "他的意象具有彻底人化的奇异性，地球的雷霆被写成其呼吸的声威。",
    "start": 186.048,
    "end": 192.128,
    "duration": 6.08
  },
  {
    "id": 45,
    "text": "他的意象更具有狂飙突进的飞动性。",
    "start": 192.128,
    "end": 194.928,
    "duration": 2.8
  },
  {
    "id": 46,
    "text": "《立在地球边上放号》以排山倒海的呼告，",
    "start": 195.088,
    "end": 198.424,
    "duration": 3.336
  },
  {
    "id": 47,
    "text": "赞颂不断毁坏与创造的力的绘画与力的舞蹈。",
    "start": 198.424,
    "end": 202.386,
    "duration": 3.962
  },
  {
    "id": 48,
    "text": "阔大飞动的壮美意象，全面体现了摧毁旧世界的破坏力与创造新世纪的创造力。",
    "start": 202.386,
    "end": 209.267,
    "duration": 6.881
  },
  {
    "id": 49,
    "text": "最后，在形式体制上，《女神》创造了“绝端自由”的现代自由诗体范式。",
    "start": 209.267,
    "end": 214.688,
    "duration": 5.421
  },
  {
    "id": 50,
    "text": "郭沫若坚决反对旧诗的形式镣靠，主张情绪决定形式，",
    "start": 214.768,
    "end": 219.408,
    "duration": 4.64
  },
  {
    "id": 51,
    "text": "提出诗的本职专在抒情。",
    "start": 219.408,
    "end": 221.648,
    "duration": 2.24
  },
  {
    "id": 52,
    "text": "他在创作中主要开创了两种形态。",
    "start": 221.648,
    "end": 224.688,
    "duration": 3.04
  },
  {
    "id": 53,
    "text": "一种是如同火山喷涌般一泻无余的狂暴长句，",
    "start": 224.688,
    "end": 228.768,
    "duration": 4.08
  },
  {
    "id": 54,
    "text": "长短错落，随感情节奏自由舒卷。",
    "start": 228.768,
    "end": 231.968,
    "duration": 3.2
  },
  {
    "id": 55,
    "text": "另一种是巧妙运用复沓、排比与不规则押韵。",
    "start": 231.968,
    "end": 235.648,
    "duration": 3.68
  },
  {
    "id": 56,
    "text": "《天狗》与《炉中煤》在自由变动中取得了内在旋律的和谐统一。",
    "start": 235.808,
    "end": 240.695,
    "duration": 4.887
  },
  {
    "id": 57,
    "text": "这种形式的彻底解放，为中国现代新诗的文体建设开辟了无限广阔的表现空间。",
    "start": 240.695,
    "end": 247.415,
    "duration": 6.72
  },
  {
    "id": 58,
    "text": "综上所述，郭沫若的《女神》实现了时代精神、",
    "start": 247.415,
    "end": 250.877,
    "duration": 3.462
  },
  {
    "id": 59,
    "text": "哲学深度与形式革命的美学统一。",
    "start": 250.877,
    "end": 253.728,
    "duration": 2.851
  },
  {
    "id": 60,
    "text": "它以空前的个性解放解放了诗歌的形式与心灵，",
    "start": 253.808,
    "end": 257.888,
    "duration": 4.08
  },
  {
    "id": 61,
    "text": "确立了中国现代浪漫主义新诗的崇高美学范式。--",
    "start": 257.888,
    "end": 261.568,
    "duration": 3.68
  }
]