[
  {
    "id": 1,
    "text": "试论郭沫若《女神》的自我抒情主人公形象与诗歌美学特色。",
    "start": 0.16,
    "end": 4.893,
    "duration": 4.733
  },
  {
    "id": 2,
    "text": "五四新文化运动高潮时期，郭沫若诗集《女神》的问世，是中国现代新诗史上的奠基之作。",
    "start": 5.393,
    "end": 12.243,
    "duration": 6.85
  },
  {
    "id": 3,
    "text": "它的成功在于五四时代精神与诗人浪漫主义个性的统一，",
    "start": 12.771,
    "end": 17.106,
    "duration": 4.335
  },
  {
    "id": 4,
    "text": "正所谓“个人的郁结，民族的郁结，在浪漫主义这里找到了喷火口”。",
    "start": 17.518,
    "end": 22.721,
    "duration": 5.203
  },
  {
    "id": 5,
    "text": "郭沫若以火山爆发般的激情打破古典旧诗的格律桎梏，以泛神论哲学为基石，",
    "start": 23.221,
    "end": 29.788,
    "duration": 6.567
  },
  {
    "id": 6,
    "text": "塑造了多重维度的自我抒情主人公，开创了阔大奇异的意象体系与自由新诗体式，",
    "start": 30.138,
    "end": 36.891,
    "duration": 6.753
  },
  {
    "id": 7,
    "text": "确立了现代浪漫主义新诗的崇高美学范式。",
    "start": 37.241,
    "end": 40.541,
    "duration": 3.3
  },
  {
    "id": 8,
    "text": "其思想意蕴与艺术成就主要体现在以下四个方面：",
    "start": 41.041,
    "end": 44.917,
    "duration": 3.876
  },
  {
    "id": 9,
    "text": "第一，塑造觉醒时代的多维抒情主人公，达成“小我”与民族“大我”的崇高融合。",
    "start": 45.582,
    "end": 52.58,
    "duration": 6.998
  },
  {
    "id": 10,
    "text": "《女神》中的自我是被五四时代激活的现代主体形象。",
    "start": 53.08,
    "end": 56.9,
    "duration": 3.82
  },
  {
    "id": 11,
    "text": "其抒情主人公呈现出丰富的精神光谱：",
    "start": 57.411,
    "end": 60.35,
    "duration": 2.939
  },
  {
    "id": 12,
    "text": "一是在《凤凰涅槃》中集香木自焚并于死灰中更生、象征古老中华民族浴火重生的“大我”；",
    "start": 60.805,
    "end": 68.218,
    "duration": 7.413
  },
  {
    "id": 13,
    "text": "二是在《女神之再生》中，写诸女神先共议再造太阳、在共工颛顼触折不周山后",
    "start": 68.718,
    "end": 75.127,
    "duration": 6.409
  },
  {
    "id": 14,
    "text": "女神们拒绝修补破败旧天、高唱“我们要去创造一个新鲜的太阳”的情节，",
    "start": 75.477,
    "end": 80.995,
    "duration": 5.518
  },
  {
    "id": 15,
    "text": "塑造出誓破旧世界、另造新天地的“新人”；",
    "start": 81.345,
    "end": 84.649,
    "duration": 3.304
  },
  {
    "id": 16,
    "text": "三是在《天狗》中以吞食日月的能量高呼“我便是我”、宣告个体神性与自主意志的“神我”；",
    "start": 85.149,
    "end": 92.431,
    "duration": 7.282
  },
  {
    "id": 17,
    "text": "四是在《晨安》中向自然山川与世界人类文明致敬的“世界人”。",
    "start": 93.105,
    "end": 97.954,
    "duration": 4.849
  },
  {
    "id": 18,
    "text": "这些形象交织共振，具象化了五四时期生命力破土而出的时代狂飙。",
    "start": 98.454,
    "end": 103.906,
    "duration": 5.452
  },
  {
    "id": 19,
    "text": "第二，揭示高亢狂飙背后的矛盾与沉郁，立体呈现五四知识分子的精神搏斗。",
    "start": 104.519,
    "end": 110.486,
    "duration": 5.967
  },
  {
    "id": 20,
    "text": "成熟的浪漫主义从不流于单一狂热宣泄，",
    "start": 110.986,
    "end": 114.055,
    "duration": 3.069
  },
  {
    "id": 21,
    "text": "《女神》的抒情主人公蕴含着深沉的内在张力与悲凉底色。",
    "start": 114.486,
    "end": 118.613,
    "duration": 4.127
  },
  {
    "id": 22,
    "text": "在火山喷发般的豪迈赞歌背面，深藏着现代个体在旧体制废墟上的孤独、眷恋与忏悔。",
    "start": 119.113,
    "end": 126.319,
    "duration": 7.206
  },
  {
    "id": 23,
    "text": "在《天狗》中，自我的急剧膨胀伴随着剥皮食肉的自我凌迟；",
    "start": 126.819,
    "end": 131.293,
    "duration": 4.474
  },
  {
    "id": 24,
    "text": "在《湘累》中，屈原在天马行空的创造之后陷入不可言说的寥寂；",
    "start": 131.793,
    "end": 136.92,
    "duration": 5.127
  },
  {
    "id": 25,
    "text": "《凤凰涅槃》在追求主体烈度爆发的同时，最终归结于“一切的一，和谐”的泛神论自我消融。",
    "start": 137.42,
    "end": 145.035,
    "duration": 7.615
  },
  {
    "id": 26,
    "text": "高亢与苦闷、狂暴与孤寂的交织，真实度量了五四知识分子在启蒙裂变中的复杂心灵脉动。",
    "start": 145.535,
    "end": 152.903,
    "duration": 7.368
  },
  {
    "id": 27,
    "text": "第三，引入泛神论哲学，确立物我交融、狂飙飞动的主体性意象体系。",
    "start": 153.599,
    "end": 159.57,
    "duration": 5.971
  },
  {
    "id": 28,
    "text": "郭沫若借鉴斯宾诺莎等西方泛神论思想，",
    "start": 160.07,
    "end": 163.094,
    "duration": 3.024
  },
  {
    "id": 29,
    "text": "提出“一切自然只是神的表现，我即是神”的诗学命题，并在创作中转化为独特的“泛我论”美学机制。",
    "start": 163.444,
    "end": 171.445,
    "duration": 8.001
  },
  {
    "id": 30,
    "text": "他打破人与自然对立的传统界限，将主体意志灌注于宇宙万物，",
    "start": 171.945,
    "end": 176.742,
    "duration": 4.797
  },
  {
    "id": 31,
    "text": "使山川、雷电与海洋均成为奔涌情感的外化。",
    "start": 177.092,
    "end": 181.114,
    "duration": 4.022
  },
  {
    "id": 32,
    "text": "作品扫除中国古典传统中常见的纤细、阴柔与感伤意象，",
    "start": 181.614,
    "end": 186.294,
    "duration": 4.68
  },
  {
    "id": 33,
    "text": "在《立在地球边上放号》中以排山倒海的呼告，将地球、海洋与太阳推向极境，",
    "start": 186.644,
    "end": 193.06,
    "duration": 6.416
  },
  {
    "id": 34,
    "text": "赞颂不断毁坏又不断创造的“力的绘画”与“力的舞蹈”，",
    "start": 193.41,
    "end": 197.681,
    "duration": 4.271
  },
  {
    "id": 35,
    "text": "构筑起阔大、奇异与飞动的现代壮美意象群。",
    "start": 198.031,
    "end": 202.202,
    "duration": 4.171
  },
  {
    "id": 36,
    "text": "第四，打破传统声律镣铐，确立“情绪决定形式”的现代自由诗范式。",
    "start": 202.798,
    "end": 209.279,
    "duration": 6.481
  },
  {
    "id": 37,
    "text": "郭沫若反对古典旧诗与早期尝试派新诗的形式规约，",
    "start": 209.779,
    "end": 214.141,
    "duration": 4.362
  },
  {
    "id": 38,
    "text": "主张“诗的本职专在抒情”，强调外在节律必须服从内在情感的自然流淌。",
    "start": 214.503,
    "end": 221.221,
    "duration": 6.718
  },
  {
    "id": 39,
    "text": "他在创作中开创了两类典范形式：",
    "start": 221.914,
    "end": 224.339,
    "duration": 2.425
  },
  {
    "id": 40,
    "text": "一类如《天狗》，以一泻千里、长短错落的句式随情绪波澜自由舒卷，创造了富有火山爆发力的自由体；",
    "start": 224.888,
    "end": 234.023,
    "duration": 9.135
  },
  {
    "id": 41,
    "text": "另一类如《炉中煤》，巧妙运用重叠、排比与自然音韵的复沓，",
    "start": 234.551,
    "end": 239.999,
    "duration": 5.448
  },
  {
    "id": 42,
    "text": "赋予深沉眷念以和谐回环的内在声律。",
    "start": 240.386,
    "end": 243.725,
    "duration": 3.339
  },
  {
    "id": 43,
    "text": "这种大胆破格的文体解放，为中国现代新诗拓辟了广阔的表现空间。",
    "start": 244.225,
    "end": 249.698,
    "duration": 5.473
  },
  {
    "id": 44,
    "text": "要而言之，郭沫若的《女神》以时代喷火口之势，达成了民族精神、哲学开掘与诗体革命的高度统一。",
    "start": 250.377,
    "end": 258.757,
    "duration": 8.38
  },
  {
    "id": 45,
    "text": "它开创了中国现代浪漫主义新诗的崭新篇章，为中国新诗在现代觉醒中奠定了坚实的精神基石。",
    "start": 259.257,
    "end": 266.655,
    "duration": 7.398
  }
]
