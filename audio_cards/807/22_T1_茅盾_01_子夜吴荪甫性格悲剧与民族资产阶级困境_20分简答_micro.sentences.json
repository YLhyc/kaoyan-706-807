[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "强悍雄心（机械工业时代王子）→内在矛盾（对内镇压工人、对外被迫公债投机）→惨败宿命（赵伯韬资本围剿 + 杜竹斋倒戈 + 赴庐山牯岭避难），",
    "start": 0.0,
    "end": 12.2,
    "duration": 12.2
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "三步把民族资产阶级困局写绝。",
    "start": 12.249,
    "end": 14.969,
    "duration": 2.72
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "三十年代初茅盾《子夜》确立现代社会剖析小说典范，",
    "start": 15.419,
    "end": 19.619,
    "duration": 4.2
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "主人公吴荪甫是现代文学史塑造最为丰满的民族资产阶级典型。",
    "start": 20.069,
    "end": 25.349,
    "duration": 5.28
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · “实业救国”宏图与现代企业家果断魄力",
    "start": 25.799,
    "end": 29.799,
    "duration": 4.0
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "游历欧美通晓管理，怀发展民族工业、抵外资倾销抱负：",
    "start": 30.249,
    "end": 34.969,
    "duration": 4.72
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "经营裕华丝厂并合组益中信托公司一举兼并八小厂；",
    "start": 35.419,
    "end": 39.739,
    "duration": 4.32
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "商场博弈中展现茅盾所称“二十世纪机械工业时代的英雄、骑士和王子”般刚毅魄力。",
    "start": 40.189,
    "end": 47.029,
    "duration": 6.84
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 深陷半殖民地环境、显“似强实弱”两重性",
    "start": 47.559,
    "end": 51.959,
    "duration": 4.4
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "面对裕华丝厂罢工勾结军警特务镇压、克扣工资开除工人，暴露资本家专断；",
    "start": 52.409,
    "end": 58.289,
    "duration": 5.88
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "遭帝国主义侵略、双桥镇破产与当局盘剥时缺抗衡根基，",
    "start": 58.739,
    "end": 63.819,
    "duration": 5.08
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "只得陷高风险公债投机，显似强实弱弱点。",
    "start": 64.269,
    "end": 67.549,
    "duration": 3.28
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 遭买办资本与亲信背叛夹击、破产宿命",
    "start": 67.999,
    "end": 72.399,
    "duration": 4.4
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "半殖民地经济下民族工业难独立：公债遭买办赵伯韬雄厚外资压迫，",
    "start": 72.849,
    "end": 78.289,
    "duration": 5.44
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "更遭二姐夫杜竹斋临阵倒戈；",
    "start": 78.739,
    "end": 81.259,
    "duration": 2.52
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "资金链断裂惨败，归家几欲开枪自尽，当晚黯然决定乘船赴庐山牯岭避难，",
    "start": 81.709,
    "end": 87.949,
    "duration": 6.24
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "印证旧中国实业救国梦破灭。",
    "start": 88.399,
    "end": 90.839,
    "duration": 2.44
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：茅盾《子夜》确立社会剖析小说典范；",
    "start": 91.289,
    "end": 94.969,
    "duration": 3.68
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "主角吴荪甫（裕华丝厂+益中信托公司），对头买办资本家赵伯韬，",
    "start": 95.419,
    "end": 101.139,
    "duration": 5.72
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "倒戈亲信二姐夫杜竹斋；",
    "start": 101.589,
    "end": 103.789,
    "duration": 2.2
  },
  {
    "id": "guard_c3",
    "dom_key": "guard_c3",
    "text": "结局当晚决定乘轮船赴庐山牯岭避难。",
    "start": 104.239,
    "end": 107.599,
    "duration": 3.36
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出吴荪甫所办丝厂、信托公司、对头买办、倒戈亲信及避难地点全部专名？",
    "start": 108.049,
    "end": 116.369,
    "duration": 8.32
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 分析吴荪甫在工人面前的“强”与在帝国主义/金融霸权面前的“弱”构成怎样的阶级两重性？",
    "start": 116.819,
    "end": 124.899,
    "duration": 8.08
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2025 名解“吴荪甫”如何凝练进本篇三步骨架？",
    "start": 125.349,
    "end": 131.789,
    "duration": 6.44
  }
]