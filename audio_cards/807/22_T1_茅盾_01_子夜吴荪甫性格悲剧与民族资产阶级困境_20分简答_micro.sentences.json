[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "茅盾·子夜吴荪甫性格悲剧与民族资产阶级困境",
    "start": 0.176,
    "end": 4.566,
    "duration": 4.39
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "强悍雄心（机械工业时代王子）→内在矛盾（对内镇压工人、对外被迫公债投机）→惨败宿命（赵伯韬资本围剿 + 杜竹斋倒戈 + 赴庐山牯岭避难），",
    "start": 5.03,
    "end": 18.722,
    "duration": 13.692
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "三步把民族资产阶级困局写绝。",
    "start": 19.03,
    "end": 21.442,
    "duration": 2.412
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "三十年代初茅盾《子夜》确立现代社会剖析小说典范，主人公吴荪甫是现代文学史塑造最为丰满的民族资产阶级典型。",
    "start": 21.97,
    "end": 31.582,
    "duration": 9.612
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · “实业救国”宏图与现代企业家果断魄力",
    "start": 32.29,
    "end": 36.542,
    "duration": 4.252
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "游历欧美通晓管理，怀发展民族工业、抵外资倾销抱负：经营裕华丝厂并合组益中信托公司一举兼并八小厂；",
    "start": 37.07,
    "end": 48.602,
    "duration": 11.532
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "商场博弈中展现茅盾所称“二十世纪机械工业时代的英雄、骑士和王子”般刚毅魄力。",
    "start": 49.13,
    "end": 57.382,
    "duration": 8.252
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 深陷半殖民地环境、显“似强实弱”两重性",
    "start": 58.012,
    "end": 62.264,
    "duration": 4.252
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "面对裕华丝厂罢工勾结军警特务镇压、克扣工资开除工人，暴露资本家专断；",
    "start": 62.723,
    "end": 70.735,
    "duration": 8.012
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "遭帝国主义侵略、双桥镇破产与当局盘剥时缺抗衡根基，只得陷高风险公债投机，显似强实弱弱点。",
    "start": 71.186,
    "end": 81.678,
    "duration": 10.492
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 遭买办资本与亲信背叛夹击、破产宿命",
    "start": 82.313,
    "end": 86.725,
    "duration": 4.412
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "半殖民地经济下民族工业难独立：公债遭买办赵伯韬雄厚外资压迫，更遭二姐夫杜竹斋临阵倒戈；",
    "start": 87.253,
    "end": 97.665,
    "duration": 10.412
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "资金链断裂惨败，归家几欲开枪自尽，当晚黯然决定乘船赴庐山牯岭避难，印证旧中国实业救国梦破灭。",
    "start": 98.193,
    "end": 108.765,
    "duration": 10.572
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：茅盾《子夜》确立社会剖析小说典范；",
    "start": 109.416,
    "end": 113.108,
    "duration": 3.692
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "主角吴荪甫（裕华丝厂+益中信托公司），对头买办资本家赵伯韬，倒戈亲信二姐夫杜竹斋；",
    "start": 113.386,
    "end": 120.758,
    "duration": 7.372
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "结局当晚决定乘轮船赴庐山牯岭避难。",
    "start": 121.116,
    "end": 124.328,
    "duration": 3.212
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出吴荪甫所办丝厂、信托公司、对头买办、倒戈亲信及避难地点全部专名？",
    "start": 124.985,
    "end": 133.237,
    "duration": 8.252
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 分析吴荪甫在工人面前的“强”与在帝国主义/金融霸权面前的“弱”构成怎样的阶级两重性？",
    "start": 133.731,
    "end": 142.303,
    "duration": 8.572
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2025 名解“吴荪甫”如何凝练进本篇三步骨架？",
    "start": 142.72,
    "end": 149.132,
    "duration": 6.412
  }
]