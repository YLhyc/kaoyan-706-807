[
  {
    "id": 1,
    "text": "一、宏观结构推演与采分点映射。",
    "start": 0.16,
    "end": 3.36,
    "duration": 3.2
  },
  {
    "id": 2,
    "text": "本题标准分为二十分，简答题结构采用高分“总领定性，",
    "start": 3.36,
    "end": 8.4,
    "duration": 5.04
  },
  {
    "id": 3,
    "text": "三点机制递进展开，收束总结”逻辑模型：一、",
    "start": 8.4,
    "end": 12.56,
    "duration": 4.16
  },
  {
    "id": 4,
    "text": "总领定性（约五十字）：人物双重定性（受害者与施害者）、",
    "start": 12.56,
    "end": 17.76,
    "duration": 5.2
  },
  {
    "id": 5,
    "text": "病态女性典型。",
    "start": 17.76,
    "end": 19.2,
    "duration": 1.44
  },
  {
    "id": 6,
    "text": "二、第一点：异化根源（被动压抑）：门第买卖、",
    "start": 19.2,
    "end": 22.8,
    "duration": 3.6
  },
  {
    "id": 7,
    "text": "肉体荒芜、情欲被扼杀转化为对金钱的疯狂依赖。",
    "start": 22.8,
    "end": 26.8,
    "duration": 4.0
  },
  {
    "id": 8,
    "text": "三、第二点：转折关键（幻灭反扑）：姜季泽骗钱击碎最后的温情幻想，",
    "start": 27.12,
    "end": 33.44,
    "duration": 6.32
  },
  {
    "id": 9,
    "text": "由守财转向仇恨与主动报复。",
    "start": 33.44,
    "end": 36.24,
    "duration": 2.8
  },
  {
    "id": 10,
    "text": "四、第三点：异化恶果（代际毁人）：黄金枷锁砍杀亲生儿女（逼死儿媳芝寿、",
    "start": 36.24,
    "end": 42.88,
    "duration": 6.64
  },
  {
    "id": 11,
    "text": "毁掉女儿长安姻缘），完成恶魔化。",
    "start": 42.88,
    "end": 45.6,
    "duration": 2.72
  },
  {
    "id": 12,
    "text": "五、收束总结（约五十字）：揭示封建礼教与金钱双重罪恶，",
    "start": 45.6,
    "end": 50.8,
    "duration": 5.2
  },
  {
    "id": 13,
    "text": "深渊心理警示。",
    "start": 50.8,
    "end": 51.84,
    "duration": 1.04
  },
  {
    "id": 14,
    "text": "---。二",
    "start": 52.08,
    "end": 52.313,
    "duration": 0.233
  },
  {
    "id": 15,
    "text": "、逐段内部咬合与考场得分句推导。",
    "start": 52.313,
    "end": 55.582,
    "duration": 3.269
  },
  {
    "id": 16,
    "text": "总领段：明确人物双重身份。",
    "start": 55.582,
    "end": 58.151,
    "duration": 2.569
  },
  {
    "id": 17,
    "text": "论证推演逻辑：必须同时点出曹七巧“受害者”与“施害者”的双重特征。",
    "start": 58.151,
    "end": 64.455,
    "duration": 6.304
  },
  {
    "id": 18,
    "text": "不能只骂她恶毒，也不能只同情她悲惨，",
    "start": 64.455,
    "end": 68.191,
    "duration": 3.736
  },
  {
    "id": 19,
    "text": "两者辩证结合。",
    "start": 68.191,
    "end": 69.592,
    "duration": 1.401
  },
  {
    "id": 20,
    "text": "具体表述到答题语句就是：张爱玲在《金锁记》中塑造的曹七巧，",
    "start": 69.592,
    "end": 75.2,
    "duration": 5.608
  },
  {
    "id": 21,
    "text": "是中国现代文学史上最触目惊心的病态女性典型。",
    "start": 75.2,
    "end": 79.362,
    "duration": 4.162
  },
  {
    "id": 22,
    "text": "她既是封建买卖婚姻与金钱罪恶的牺牲品，",
    "start": 79.362,
    "end": 82.82,
    "duration": 3.458
  },
  {
    "id": 23,
    "text": "又是用变态心理摧残下一代的残酷施害者。",
    "start": 82.82,
    "end": 86.279,
    "duration": 3.459
  },
  {
    "id": 24,
    "text": "其形象塑造与心理异化机制主要体现在三个层面。",
    "start": 86.279,
    "end": 90.315,
    "duration": 4.036
  },
  {
    "id": 25,
    "text": "张爱玲在《金锁记》中塑造的曹七巧，",
    "start": 90.315,
    "end": 93.005,
    "duration": 2.69
  },
  {
    "id": 26,
    "text": "是中国现代文学史上最触目惊心的病态女性典型。",
    "start": 93.005,
    "end": 97.04,
    "duration": 4.035
  },
  {
    "id": 27,
    "text": "她既是封建买卖婚姻与金钱罪恶的牺牲品，",
    "start": 97.12,
    "end": 100.8,
    "duration": 3.68
  },
  {
    "id": 28,
    "text": "又是用变态心理摧残下一代的残酷施害者。",
    "start": 100.8,
    "end": 104.4,
    "duration": 3.6
  },
  {
    "id": 29,
    "text": "其形象塑造与心理异化机制主要体现在三个层面。",
    "start": 104.4,
    "end": 108.88,
    "duration": 4.48
  },
  {
    "id": 30,
    "text": "--。要",
    "start": 108.88,
    "end": 109.04,
    "duration": 0.16
  },
  {
    "id": 31,
    "text": "点一：情欲压抑与金钱拜物教（异化起点）。",
    "start": 109.04,
    "end": 113.2,
    "duration": 4.16
  },
  {
    "id": 32,
    "text": "论证推演逻辑：交代异化的起点。",
    "start": 113.2,
    "end": 115.68,
    "duration": 2.48
  },
  {
    "id": 33,
    "text": "麻油店平民女被卖入豪门嫁给残疾人，",
    "start": 115.92,
    "end": 118.96,
    "duration": 3.04
  },
  {
    "id": 34,
    "text": "肉体与情感被扼杀。",
    "start": 118.96,
    "end": 121.04,
    "duration": 2.08
  },
  {
    "id": 35,
    "text": "欲望被压抑后投射向金钱，成为精神替代物。",
    "start": 121.04,
    "end": 124.96,
    "duration": 3.92
  },
  {
    "id": 36,
    "text": "具体表述到答题语句就是：第一，被压抑的情欲与金钱异化互为因果。",
    "start": 124.96,
    "end": 131.736,
    "duration": 6.776
  },
  {
    "id": 37,
    "text": "曹七巧出身低微的麻油店家庭，因贪图钱财的哥嫂而被卖给姜家瘫痪残疾的二少爷。",
    "start": 131.736,
    "end": 138.696,
    "duration": 6.96
  },
  {
    "id": 38,
    "text": "她在青春盛年被迫承受肉体与心灵的双重荒芜。",
    "start": 138.696,
    "end": 142.616,
    "duration": 3.92
  },
  {
    "id": 39,
    "text": "健康的生命本能被彻底扼杀。",
    "start": 142.616,
    "end": 145.096,
    "duration": 2.48
  },
  {
    "id": 40,
    "text": "为了补偿被剥夺的情感，七巧将对生活的全部渴望转移到了对金钱的疯狂占有上。",
    "start": 145.096,
    "end": 151.016,
    "duration": 5.92
  },
  {
    "id": 41,
    "text": "金钱从生存的手段，变成了填补情感虚无的唯一精神支柱。",
    "start": 151.256,
    "end": 157.256,
    "duration": 6.0
  },
  {
    "id": 42,
    "text": "这种物化心理使她的人格发生致命扭曲。",
    "start": 157.256,
    "end": 161.176,
    "duration": 3.92
  },
  {
    "id": 43,
    "text": "第一，被压抑的情欲与金钱异化互为因果。",
    "start": 161.176,
    "end": 165.896,
    "duration": 4.72
  },
  {
    "id": 44,
    "text": "曹七巧出身低微的麻油店家庭，因贪图钱财的哥嫂而被卖给姜家瘫痪残疾的二少爷。",
    "start": 165.896,
    "end": 173.416,
    "duration": 7.52
  },
  {
    "id": 45,
    "text": "她在青春盛年被迫承受肉体与心灵的双重荒芜。",
    "start": 173.656,
    "end": 177.976,
    "duration": 4.32
  },
  {
    "id": 46,
    "text": "健康的生命本能被彻底扼杀。",
    "start": 177.976,
    "end": 180.856,
    "duration": 2.88
  },
  {
    "id": 47,
    "text": "为了补偿被剥夺的情感，七巧将对生活的全部渴望转移到了对金钱的疯狂占有上。",
    "start": 180.856,
    "end": 187.736,
    "duration": 6.88
  },
  {
    "id": 48,
    "text": "金钱从生存的手段，变成了填补情感虚无的唯一精神支柱。",
    "start": 187.736,
    "end": 192.856,
    "duration": 5.12
  },
  {
    "id": 49,
    "text": "这种物化心理使她的人格发生致命扭曲。",
    "start": 192.856,
    "end": 196.056,
    "duration": 3.2
  },
  {
    "id": 50,
    "text": "---。要",
    "start": 196.216,
    "end": 196.42,
    "duration": 0.204
  },
  {
    "id": 51,
    "text": "点二：爱情幻灭与恶毒反扑（心理转折点）。",
    "start": 196.42,
    "end": 199.69,
    "duration": 3.27
  },
  {
    "id": 52,
    "text": "论证推演逻辑：抓住姜季泽骗钱这一关键戏剧冲突。",
    "start": 199.69,
    "end": 203.982,
    "duration": 4.292
  },
  {
    "id": 53,
    "text": "最后的一丝温情幻梦破灭，促使她把心彻底冰封，",
    "start": 203.982,
    "end": 208.069,
    "duration": 4.087
  },
  {
    "id": 54,
    "text": "转为反社会的仇恨与报复。",
    "start": 208.069,
    "end": 210.317,
    "duration": 2.248
  },
  {
    "id": 55,
    "text": "具体表述到答题语句就是：第二，情爱彻底绝望后的恶毒反扑与心理防线崩溃。",
    "start": 210.317,
    "end": 216.856,
    "duration": 6.539
  },
  {
    "id": 56,
    "text": "当姜家分家后，小叔子姜季泽试图以虚假的温情骗取她的私房钱。",
    "start": 216.936,
    "end": 223.096,
    "duration": 6.16
  },
  {
    "id": 57,
    "text": "七巧在短暂的沉醉后瞬间清醒，毅然用酸辣的言语赶走了唯一的恋情寄托。",
    "start": 223.096,
    "end": 229.656,
    "duration": 6.56
  },
  {
    "id": 58,
    "text": "这一事件彻底粉碎了她对真爱的幻想。",
    "start": 229.656,
    "end": 232.936,
    "duration": 3.28
  },
  {
    "id": 59,
    "text": "她意识到金钱之外再无依靠。",
    "start": 232.936,
    "end": 236.056,
    "duration": 3.12
  },
  {
    "id": 60,
    "text": "精神的幻灭促使她由自卫防范走向恶毒反扑。",
    "start": 236.056,
    "end": 240.056,
    "duration": 4.0
  },
  {
    "id": 61,
    "text": "她开始仇视身边所有健康正常的情感关系，",
    "start": 240.296,
    "end": 243.736,
    "duration": 3.44
  },
  {
    "id": 62,
    "text": "以毁灭他人幸福来确认自身的存在感。",
    "start": 243.736,
    "end": 247.336,
    "duration": 3.6
  },
  {
    "id": 63,
    "text": "第二，情爱彻底绝望后的恶毒反扑与心理防线崩溃。",
    "start": 247.336,
    "end": 251.896,
    "duration": 4.56
  },
  {
    "id": 64,
    "text": "当姜家分家后，小叔子姜季泽试图以虚假的温情骗取她的私房钱。",
    "start": 251.896,
    "end": 258.136,
    "duration": 6.24
  },
  {
    "id": 65,
    "text": "七巧在短暂的沉醉后瞬间清醒，毅然用酸辣的言语赶走了唯一的恋情寄托。",
    "start": 258.136,
    "end": 264.216,
    "duration": 6.08
  },
  {
    "id": 66,
    "text": "这一事件彻底粉碎了她对真爱的幻想。",
    "start": 264.536,
    "end": 267.416,
    "duration": 2.88
  },
  {
    "id": 67,
    "text": "她意识到金钱之外再无依靠。",
    "start": 267.416,
    "end": 270.296,
    "duration": 2.88
  },
  {
    "id": 68,
    "text": "精神的幻灭促使她由自卫防范走向恶毒反扑。",
    "start": 270.296,
    "end": 274.456,
    "duration": 4.16
  },
  {
    "id": 69,
    "text": "她开始仇视身边所有健康正常的情感关系，",
    "start": 274.456,
    "end": 277.576,
    "duration": 3.12
  },
  {
    "id": 70,
    "text": "以毁灭他人幸福来确认自身的存在感。--",
    "start": 277.576,
    "end": 280.456,
    "duration": 2.88
  },
  {
    "id": 71,
    "text": "要点三：代际摧残与恶魔化完成（异化顶峰）。",
    "start": 280.912,
    "end": 284.912,
    "duration": 4.0
  },
  {
    "id": 72,
    "text": "论证推演逻辑：异化的恶果落在儿女身上。",
    "start": 284.912,
    "end": 288.432,
    "duration": 3.52
  },
  {
    "id": 73,
    "text": "运用傅雷书评名句“戴着沉重黄金枷锁”的意象，",
    "start": 288.432,
    "end": 292.112,
    "duration": 3.68
  },
  {
    "id": 74,
    "text": "点出折磨芝寿与拆散长安姻缘的具体情节，",
    "start": 292.112,
    "end": 295.952,
    "duration": 3.84
  },
  {
    "id": 75,
    "text": "论证她彻底蜕变为冷酷恶魔。",
    "start": 295.952,
    "end": 298.672,
    "duration": 2.72
  },
  {
    "id": 76,
    "text": "具体表述到答题语句就是：第三，黄金枷锁下的自残自虐与代际转嫁毁灭。",
    "start": 298.672,
    "end": 305.552,
    "duration": 6.88
  },
  {
    "id": 77,
    "text": "分家获得财产后的曹七巧，戴着这副沉重的黄金枷锁劈杀亲人。",
    "start": 305.552,
    "end": 310.832,
    "duration": 5.28
  },
  {
    "id": 78,
    "text": "由于自身情欲无法满足，她对儿女的婚姻产生了病态的嫉妒与控制狂。",
    "start": 310.832,
    "end": 316.352,
    "duration": 5.52
  },
  {
    "id": 79,
    "text": "她用鸦片和流言折磨长媳芝寿致死，",
    "start": 316.352,
    "end": 319.552,
    "duration": 3.2
  },
  {
    "id": 80,
    "text": "又以恶毒手段拆散女儿长安的美满姻缘。",
    "start": 319.552,
    "end": 322.752,
    "duration": 3.2
  },
  {
    "id": 81,
    "text": "她最终完成了从无辜受害者向恶毒施害者的彻底蜕变。",
    "start": 323.072,
    "end": 328.192,
    "duration": 5.12
  },
  {
    "id": 82,
    "text": "第三，黄金枷锁下的自残自虐与代际转嫁毁灭。",
    "start": 328.512,
    "end": 333.792,
    "duration": 5.28
  },
  {
    "id": 83,
    "text": "分家获得财产后的曹七巧，戴着这副沉重的黄金枷锁劈杀亲人。",
    "start": 333.792,
    "end": 339.792,
    "duration": 6.0
  },
  {
    "id": 84,
    "text": "由于自身情欲无法满足，她对儿女的婚姻产生了病态的嫉妒与控制狂。",
    "start": 339.792,
    "end": 345.472,
    "duration": 5.68
  },
  {
    "id": 85,
    "text": "她用鸦片和流言折磨长媳芝寿致死，",
    "start": 345.712,
    "end": 348.592,
    "duration": 2.88
  },
  {
    "id": 86,
    "text": "又以恶毒手段拆散女儿长安的美满姻缘。",
    "start": 348.592,
    "end": 351.952,
    "duration": 3.36
  },
  {
    "id": 87,
    "text": "她最终完成了从无辜受害者向恶毒施害者的彻底蜕变。",
    "start": 351.952,
    "end": 357.312,
    "duration": 5.36
  },
  {
    "id": 88,
    "text": "--。总",
    "start": 357.312,
    "end": 357.552,
    "duration": 0.24
  },
  {
    "id": 89,
    "text": "结升华段：社会批判与哲学深意。",
    "start": 357.552,
    "end": 360.752,
    "duration": 3.2
  },
  {
    "id": 90,
    "text": "论证推演逻辑：概括这一悲剧形象的社会根源与思想深度，",
    "start": 360.752,
    "end": 365.792,
    "duration": 5.04
  },
  {
    "id": 91,
    "text": "点出封建礼教与金钱拜物教的双重扼杀。",
    "start": 365.792,
    "end": 369.072,
    "duration": 3.28
  },
  {
    "id": 92,
    "text": "-具体表述到答题语句就是：曹七巧的悲剧深刻揭示了封建纲常与金钱拜物教对女性肉体与灵魂的双重摧残，",
    "start": 369.312,
    "end": 378.707,
    "duration": 9.395
  },
  {
    "id": 93,
    "text": "展现了人性在畸形环境中逐步走向毁灭的心理深渊。",
    "start": 378.707,
    "end": 383.3,
    "duration": 4.593
  },
  {
    "id": 94,
    "text": "曹七巧的悲剧深刻揭示了封建纲常与金钱拜物教对女性肉体与灵魂的双重摧残，",
    "start": 383.3,
    "end": 390.399,
    "duration": 7.099
  },
  {
    "id": 95,
    "text": "展现了人性在畸形环境中逐步走向毁灭的心理深渊。",
    "start": 390.399,
