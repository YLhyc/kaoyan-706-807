[
  {
    "id": 1,
    "text": "一、全题宏观破题与总揽。",
    "start": 0.08,
    "end": 2.96,
    "duration": 2.88
  },
  {
    "id": 2,
    "text": "一、这道题到底要回答什么？",
    "start": 2.96,
    "end": 5.28,
    "duration": 2.32
  },
  {
    "id": 3,
    "text": "本题是、八零七、专业课中关于鲁迅小说的最高母题，",
    "start": 5.28,
    "end": 8.88,
    "duration": 3.6
  },
  {
    "id": 4,
    "text": "分值为、三十分。",
    "start": 8.88,
    "end": 10.24,
    "duration": 1.36
  },
  {
    "id": 5,
    "text": "考查的核心目的，是要求考生站在百年现代文学史的长河视野中，",
    "start": 10.24,
    "end": 15.2,
    "duration": 4.96
  },
  {
    "id": 6,
    "text": "系统回答鲁迅小说为何能够作为现代小说的源头与高峰，",
    "start": 15.2,
    "end": 20.0,
    "duration": 4.8
  },
  {
    "id": 7,
    "text": "证明其在形式、思想与美学上的全方位奠基价值。",
    "start": 20.0,
    "end": 24.16,
    "duration": 4.16
  },
  {
    "id": 8,
    "text": "二、应该从什么方向回答？",
    "start": 24.4,
    "end": 26.8,
    "duration": 2.4
  },
  {
    "id": 9,
    "text": "回答这道题切忌零散罗列单篇小说的故事情节。",
    "start": 26.8,
    "end": 30.96,
    "duration": 4.16
  },
  {
    "id": 10,
    "text": "必须建立文学史宏观史观，从“文体诞生”、",
    "start": 30.96,
    "end": 34.56,
    "duration": 3.6
  },
  {
    "id": 11,
    "text": "“思想深度”、“叙事结构”和“文体形式”四个递进层次展开，",
    "start": 34.56,
    "end": 39.28,
    "duration": 4.72
  },
  {
    "id": 12,
    "text": "全面论证其如何将中国小说由古代形态推向现代形态。",
    "start": 39.28,
    "end": 44.16,
    "duration": 4.88
  },
  {
    "id": 13,
    "text": "三、从哪些方面展开论述？",
    "start": 44.48,
    "end": 46.96,
    "duration": 2.48
  },
  {
    "id": 14,
    "text": "全篇确立四个核心论述维度：第一是文学史奠基（开端与成熟）。",
    "start": 46.96,
    "end": 53.2,
    "duration": 6.24
  },
  {
    "id": 15,
    "text": "第二是题材开拓与精神深度（两大题材与表现重心内转）。",
    "start": 53.2,
    "end": 58.48,
    "duration": 5.28
  },
  {
    "id": 16,
    "text": "第三是叙事结构模式（“看、被看”与“归乡”模型）。",
    "start": 58.48,
    "end": 62.96,
    "duration": 4.48
  },
  {
    "id": 17,
    "text": "第四是文体形式实验（一篇一形式与中西融合）。",
    "start": 62.96,
    "end": 67.04,
    "duration": 4.08
  },
  {
    "id": 18,
    "text": "四、这四个维度之间的内在逻辑是什么？",
    "start": 67.44,
    "end": 70.88,
    "duration": 3.44
  },
  {
    "id": 19,
    "text": "这四个维度遵循着从历史地位、到思想内容、",
    "start": 70.88,
    "end": 74.72,
    "duration": 3.84
  },
  {
    "id": 20,
    "text": "再到艺术结构的严密推演链条。",
    "start": 74.72,
    "end": 77.6,
    "duration": 2.88
  },
  {
    "id": 21,
    "text": "文学史奠基确立了鲁迅不可替代的源头与标杆地位。",
    "start": 77.6,
    "end": 82.24,
    "duration": 4.64
  },
  {
    "id": 22,
    "text": "题材与精神开掘揭示了现代小说所承载的思想重量与人道深度。",
    "start": 82.24,
    "end": 87.76,
    "duration": 5.52
  },
  {
    "id": 23,
    "text": "叙事结构模式论证了鲁迅如何将社会关系密码转化为稳定的叙事法则。",
    "start": 88.08,
    "end": 93.52,
    "duration": 5.44
  },
  {
    "id": 24,
    "text": "文体形式实验则深入到具体的文本操作技巧，",
    "start": 93.52,
    "end": 96.96,
    "duration": 3.44
  },
  {
    "id": 25,
    "text": "证明其形式上的先锋性与民族性。",
    "start": 96.96,
    "end": 99.52,
    "duration": 2.56
  },
  {
    "id": 26,
    "text": "从宏观奠基，到思想内向，再到结构模型，",
    "start": 99.52,
    "end": 103.12,
    "duration": 3.6
  },
  {
    "id": 27,
    "text": "最后落脚于微观技法，逻辑层层递进，",
    "start": 103.12,
    "end": 106.24,
    "duration": 3.12
  },
  {
    "id": 28,
    "text": "滴水不漏。",
    "start": 106.24,
    "end": 106.88,
    "duration": 0.64
  },
  {
    "id": 29,
    "text": "二、第一板块：引论段逐句咬合精解。",
    "start": 107.2,
    "end": 110.24,
    "duration": 3.04
  },
  {
    "id": 30,
    "text": "本段承担全篇论述的前提确立任务。",
    "start": 110.24,
    "end": 113.52,
    "duration": 3.28
  },
  {
    "id": 31,
    "text": "整段要解决四个连贯的问题：提出开端与成熟的核心判断、",
    "start": 113.52,
    "end": 118.08,
    "duration": 4.56
  },
  {
    "id": 32,
    "text": "交代代表作品与文学史坐标、明确奠基的全面性，",
    "start": 118.08,
    "end": 122.24,
    "duration": 4.16
  },
  {
    "id": 33,
    "text": "并给出下文论述的四大支柱。",
    "start": 122.24,
    "end": 124.4,
    "duration": 2.16
  },
  {
    "id": 34,
    "text": "具体表述到答题语句就是：中国现代小说在鲁迅手中开始，",
    "start": 124.4,
    "end": 128.96,
    "duration": 4.56
  },
  {
    "id": 35,
    "text": "又在鲁迅手中走向完全成熟。",
    "start": 128.96,
    "end": 131.28,
    "duration": 2.32
  },
  {
    "id": 36,
    "text": "这是开篇直接确立全题中心论点的最高定性。",
    "start": 131.6,
    "end": 135.12,
    "duration": 3.52
  },
  {
    "id": 37,
    "text": "有了总判断之后，紧接着调取作品事实作为历史证据，",
    "start": 135.12,
    "end": 139.68,
    "duration": 4.56
  },
  {
    "id": 38,
    "text": "具体表述到答题语句就是：一九一八年《狂人日记》的发表，",
    "start": 139.68,
    "end": 144.08,
    "duration": 4.4
  },
  {
    "id": 39,
    "text": "标志着中国现代白话小说的正式诞生。",
    "start": 144.08,
    "end": 146.88,
    "duration": 2.8
  },
  {
    "id": 40,
    "text": "这是坐实现代小说正式开端的文学史原点。",
    "start": 147.176,
    "end": 150.536,
    "duration": 3.36
  },
  {
    "id": 41,
    "text": "有了开端之后，紧接着对应成熟的标志，",
    "start": 150.536,
    "end": 153.816,
    "duration": 3.28
  },
  {
    "id": 42,
    "text": "具体表述到答题语句就是：《呐喊》与《彷徨》两部小说集，",
    "start": 153.816,
    "end": 158.376,
    "duration": 4.56
  },
  {
    "id": 43,
    "text": "则确立了中国现代小说的经典范式。",
    "start": 158.376,
    "end": 161.496,
    "duration": 3.12
  },
  {
    "id": 44,
    "text": "这是用两部经典集子呼应上一句，完成从“开始”到“成熟”的事实支撑。",
    "start": 161.496,
    "end": 167.096,
    "duration": 5.6
  },
  {
    "id": 45,
    "text": "历史坐标立稳之后，紧接着总领下文展开的四大维度，",
    "start": 167.336,
    "end": 171.736,
    "duration": 4.4
  },
  {
    "id": 46,
    "text": "具体表述到答题语句就是：鲁迅对中国小说史的贡献是全方位而深远的。",
    "start": 171.736,
    "end": 178.296,
    "duration": 6.56
  },
  {
    "id": 47,
    "text": "我们可以从历史奠基、题材与精神深度、",
    "start": 178.296,
    "end": 181.656,
    "duration": 3.36
  },
  {
    "id": 48,
    "text": "结构模式以及形式实验四个维度展开深入论证。",
    "start": 181.656,
    "end": 185.976,
    "duration": 4.32
  },
  {
    "id": 49,
    "text": "这是向阅卷老师亮出全篇严整的四层骨架，",
    "start": 185.976,
    "end": 189.576,
    "duration": 3.6
  },
  {
    "id": 50,
    "text": "完成引论段的规范收束。",
    "start": 189.576,
    "end": 191.416,
    "duration": 1.84
  },
  {
    "id": 51,
    "text": "三、第二板块：主体一•文学史奠基逐句咬合精解。",
    "start": 191.736,
    "end": 196.936,
    "duration": 5.2
  },
  {
    "id": 52,
    "text": "本段旨在从文学史分期与文体起源的角度，",
    "start": 196.936,
    "end": 200.616,
    "duration": 3.68
  },
  {
    "id": 53,
    "text": "论证鲁迅如何同时承担了开创者与集大成者的双重身份。",
    "start": 200.616,
    "end": 205.896,
    "duration": 5.28
  },
  {
    "id": 54,
    "text": "进入第一层，段首结论先行，具体表述到答题语句就是：第一，",
    "start": 205.896,
    "end": 211.256,
    "duration": 5.36
  },
  {
    "id": 55,
    "text": "在文学史奠基上，鲁迅开创了现代白话小说体式，",
    "start": 211.336,
    "end": 215.656,
    "duration": 4.32
  },
  {
    "id": 56,
    "text": "并确立了成熟的范式。",
    "start": 215.656,
    "end": 217.256,
    "duration": 1.6
  },
  {
    "id": 57,
    "text": "这是确立本段的总论点，将论题锁定在文体首创与经典确立上。",
    "start": 217.576,
    "end": 223.336,
    "duration": 5.76
  },
  {
    "id": 58,
    "text": "紧接着深入剖析其与传统小说的断裂与文体革新，",
    "start": 223.336,
    "end": 227.976,
    "duration": 4.64
  },
  {
    "id": 59,
    "text": "具体表述到答题语句就是：《狂人日记》彻底打破了传统章回小说有头有尾、",
    "start": 227.976,
    "end": 234.456,
    "duration": 6.48
  },
  {
    "id": 60,
    "text": "依次展开情节的结构惯例。",
    "start": 234.456,
    "end": 236.776,
    "duration": 2.32
  },
  {
    "id": 61,
    "text": "这是指出其对中国古代叙事传统的根本性颠覆。",
    "start": 236.776,
    "end": 240.296,
    "duration": 3.52
  },
  {
    "id": 62,
    "text": "打破传统之后，紧接着指出其现代小说特质的核心机制，",
    "start": 240.536,
    "end": 244.936,
    "duration": 4.4
  },
  {
    "id": 63,
    "text": "具体表述到答题语句就是：作品借由狂人的心理意识流动来组织篇章，",
    "start": 244.936,
    "end": 250.296,
    "duration": 5.36
  },
  {
    "id": 64,
    "text": "赋予了白话语言前所未有的文学表现力。",
    "start": 250.296,
    "end": 253.416,
    "duration": 3.12
  },
  {
    "id": 65,
    "text": "这是阐述心理叙事机制如何激活白话文的艺术生命。",
    "start": 253.416,
    "end": 257.496,
    "duration": 4.08
  },
  {
    "id": 66,
    "text": "开创完成之后，紧接着论述其如何带领现代小说走向成熟与世界，",
    "start": 257.496,
    "end": 262.936,
    "duration": 5.44
  },
  {
    "id": 67,
    "text": "具体表述到答题语句就是：此后，鲁迅在《呐喊》与《彷徨》中塑造了丰富生动的现代典型群像。",
    "start": 262.936,
    "end": 270.376,
    "duration": 7.44
  },
  {
    "id": 68,
    "text": "《阿Q正传》更代表中国现代文学走向世界，",
    "start": 270.616,
    "end": 273.856,
    "duration": 3.24
  },
  {
    "id": 69,
    "text": "赢得了世界文学之林的尊严。",
    "start": 273.856,
    "end": 276.143,
    "duration": 2.287
  },
  {
    "id": 70,
    "text": "这是以阿Q等经典形象，坐实现代小说成熟并自立于世界文学的最高成就。",
    "start": 276.143,
    "end": 282.051,
    "duration": 5.908
  },
  {
    "id": 71,
    "text": "最后对文学史地位进行总结收口，具体表述到答题语句就是：鲁迅不仅写出了第一篇真正意义上的现代小说，",
    "start": 282.051,
    "end": 290.628,
    "duration": 8.577
  },
  {
    "id": 72,
    "text": "更为后世作家树立了难以逾越的经典范本。",
    "start": 290.628,
    "end": 294.058,
    "duration": 3.43
  },
  {
    "id": 73,
    "text": "这是完成第一板块的因果闭环。",
    "start": 294.058,
    "end": 296.536,
    "duration": 2.478
  },
  {
    "id": 74,
    "text": "四、第三板块：主体二•题材与精神深度逐句咬合精解。",
    "start": 296.752,
    "end": 301.872,
    "duration": 5.12
  },
  {
    "id": 75,
    "text": "本段论述从外部历史坐标，深入到小说表现的社会内容与精神内核。",
    "start": 301.872,
    "end": 307.152,
    "duration": 5.28
  },
  {
    "id": 76,
    "text": "核心是讲透鲁迅如何把现实苦难转化为深层次的精神求索。",
    "start": 307.152,
    "end": 312.112,
    "duration": 4.96
  },
  {
    "id": 77,
    "text": "承接文学史奠基，段首句确立本段中心论点，",
    "start": 312.112,
    "end": 315.792,
    "duration": 3.68
  },
  {
    "id": 78,
    "text": "具体表述到答题语句就是：第二，在题材与精神开掘上，",
    "start": 315.792,
    "end": 320.032,
    "duration": 4.24
  },
  {
    "id": 79,
    "text": "鲁迅开辟了农民与知识分子两大题材，",
    "start": 320.032,
    "end": 322.912,
    "duration": 2.88
  },
  {
    "id": 80,
    "text": "并将笔触深入到“灵魂的深”。",
    "start": 322.912,
    "end": 324.992,
    "duration": 2.08
  },
  {
    "id": 81,
    "text": "这是提炼出题材两极与表现重心内转的核心命题。",
    "start": 325.232,
    "end": 329.872,
    "duration": 4.64
  },
  {
    "id": 82,
    "text": "紧接着剖析鲁迅表现苦难的独特性，",
    "start": 329.872,
    "end": 332.912,
    "duration": 3.04
  },
  {
    "id": 83,
    "text": "具体表述到答题语句就是：鲁迅取材于病态社会的不幸人们，",
    "start": 332.912,
    "end": 337.952,
    "duration": 5.04
  },
  {
    "id": 84,
    "text": "却坚决拒绝浅薄的苦难展览。",
    "start": 337.952,
    "end": 340.672,
    "duration": 2.72
  },
  {
    "id": 85,
    "text": "这是区分普通社会小说与鲁迅哲理深度的关键分水岭。",
    "start": 340.672,
    "end": 345.232,
    "duration": 4.56
  },
  {
    "id": 86,
    "text": "有了原则界定，紧接着调取《药》的情节细节做实证，",
    "start": 345.552,
    "end": 350.112,
    "duration": 4.56
  },
  {
    "id": 87,
    "text": "具体表述到答题语句就是：《药》中只用一床满幅补钉的夹被暗示贫困，",
    "start": 350.112,
    "end": 356.272,
    "duration": 6.16
  },
  {
    "id": 88,
    "text": "正面聚焦的却是华老栓买人血瞒头的精神愚昧。",
    "start": 356.272,
    "end": 360.512,
    "duration": 4.24
  },
  {
    "id": 89,
    "text": "这是证明鲁迅略写物质穷困、详写精神麻木的典型例证。",
    "start": 360.512,
    "end": 365.312,
    "duration": 4.8
  },
  {
    "id": 90,
    "text": "接着调取《故乡》的细节深化论证，",
    "start": 365.632,
    "end": 368.192,
    "duration": 2.56
  },
  {
    "id": 91,
    "text": "具体表述到答题语句就是：《故乡》最震动人心的不是闰土生活的艰难，",
    "start": 368.192,
    "end": 374.192,
    "duration": 6.0
  },
  {
    "id": 92,
    "text": "而是那一声隔膜的“老爷”。",
    "start": 374.192,
    "end": 376.192,
    "duration": 2.0
  },
  {
    "id": 93,
    "text": "这是用经典台词证明封建等级观念对童年纯真灵魂的残酷侵蚀。",
    "start": 376.192,
    "end": 381.952,
    "duration": 5.76
  },
  {
    "id": 94,
    "text": "随后补充《祝福》的宗教心理维度，",
    "start": 381.952,
    "end": 384.672,
    "duration": 2.72
  },
  {
    "id": 95,
    "text": "具体表述到答题语句就是：《祝福》则深刻透析了祥林嫂在封建神权与宗法压迫下的灵魂惊恐。",
    "start": 384.672,
    "end": 392.352,
    "duration": 7.68
  },
  {
    "id": 96,
    "text": "这是指出祥林嫂的悲剧本质在于被剥夺做人资格后的心理地狱。",
    "start": 392.592,
    "end": 398.032,
    "duration": 5.44
  },
  {
    "id": 97,
    "text": "最后提炼题材开掘的美学价值，具体表述到答题语句就是：鲁迅把小说的目光从外在物质苦难转向内在精神创痛，",
    "start": 398.032,
    "end": 407.312,
    "duration": 9.28
  },
  {
    "id": 98,
    "text": "赋予了中国现代小说深沉的哲思内向性。",
    "start": 407.312,
    "end": 410.672,
    "duration": 3.36
  },
  {
    "id": 99,
    "text": "这是总结精神内转对中国小说史的深刻赋能。",
    "start": 410.672,
    "end": 414.112,
    "duration": 3.44
  },
  {
    "id": 100,
    "text": "五、第四板块：主体三•叙事结构模式逐句咬合精解。",
    "start": 414.432,
    "end": 419.232,
    "duration": 4.8
  },
  {
    "id": 101,
    "text": "本段论述从思想内容跃迁到叙事学结构机制。",
    "start": 419.232,
    "end": 422.912,
    "duration": 3.68
  },
  {
    "id": 102,
    "text": "核心是证明鲁迅创造的结构模型具有高度的社会象征功能。",
    "start": 422.912,
    "end": 427.472,
    "duration": 4.56
  },
  {
    "id": 103,
    "text": "段首句提炼两大经典叙事模型，具体表述到答题语句就是：第三，",
    "start": 427.472,
    "end": 432.832,
    "duration": 5.36
  },
  {
    "id": 104,
    "text": "在叙事机制上，鲁迅创造了“看或被看”与“离去，",
    "start": 432.832,
    "end": 437.072,
    "duration": 4.24
  },
  {
    "id": 105,
    "text": "归来，再离去”两大现代结构模型。",
    "start": 437.072,
    "end": 439.712,
    "duration": 2.64
  },
  {
    "id": 106,
    "text": "这是直接亮出叙事学维度的两大核心学术工具。",
    "start": 440.032,
    "end": 443.792,
    "duration": 3.76
  },
  {
    "id": 107,
    "text": "首先剖析“看或被看”模型的展开与深化，",
    "start": 444.256,
    "end": 447.456,
    "duration": 3.2
  },
  {
    "id": 108,
    "text": "具体表述到答题语句就是：在《祝福》与《孔乙己》中，",
    "start": 447.456,
    "end": 451.376,
    "duration": 3.92
  },
  {
    "id": 109,
    "text": "老女人将祥林嫂的痛苦作为消遣，酒客以孔乙己的伤疤取乐。",
    "start": 451.376,
    "end": 456.576,
    "duration": 5.2
  },
  {
    "id": 110,
    "text": "这是阐明看客群体如何通过围观他人痛苦来获得无聊快感。",
    "start": 456.576,
    "end": 462.016,
    "duration": 5.44
  },
  {
    "id": 111,
    "text": "紧接着揭示该结构演进到极点的恐怖机制，",
    "start": 462.016,
    "end": 465.856,
    "duration": 3.84
  },
  {
    "id": 112,
    "text": "具体表述到答题语句就是：《药》更进一步将看客的围观推向了吃与被吃的血腥寓言。",
    "start": 465.856,
    "end": 472.416,
    "duration": 6.56
  },
  {
    "id": 113,
    "text": "这是揭示看客最终演变为剥削与残害启蒙先驱者的同谋。",
    "start": 472.736,
    "end": 477.296,
    "duration": 4.56
  },
  {
    "id": 114,
    "text": "随后提炼该结构的美学意义，具体表述到答题语句就是：这使小说结构本身成为了社会冷漠关系的艺术外化。",
    "start": 477.296,
    "end": 485.936,
    "duration": 8.64
  },
  {
    "id": 115,
    "text": "这是指出结构在此处不是机械的外壳，",
    "start": 485.936,
    "end": 489.216,
    "duration": 3.28
  },
  {
    "id": 116,
    "text": "而是思想的容器。",
    "start": 489.216,
    "end": 490.496,
    "duration": 1.28
  },
  {
    "id": 117,
    "text": "接着转向第二大结构模型，具体表述到答题语句就是：同时，",
    "start": 490.736,
    "end": 495.616,
    "duration": 4.88
  },
  {
    "id": 118,
    "text": "《故乡》与《在酒楼上》确立了始于篷船、",
    "start": 495.616,
    "end": 498.896,
    "duration": 3.28
  },
  {
    "id": 119,
    "text": "终于篷船的圆形归乡模式。",
    "start": 498.896,
    "end": 501.136,
    "duration": 2.24
  },
  {
    "id": 120,
    "text": "这是界定启蒙知识分子空间位移与心理位移的闭环结构。",
    "start": 501.136,
    "end": 505.616,
    "duration": 4.48
  },
  {
    "id": 121,
    "text": "最后揭示归乡模式的内在精神本质，",
    "start": 505.616,
    "end": 508.336,
    "duration": 2.72
  },
  {
    "id": 122,
    "text": "具体表述到答题语句就是：它精准呈现了现代启蒙知识分子无家可归、",
    "start": 508.336,
    "end": 514.256,
    "duration": 5.92
  },
  {
    "id": 123,
    "text": "进退失据的精神漂泊困境。",
    "start": 514.256,
    "end": 516.416,
    "duration": 2.16
  },
  {
    "id": 124,
    "text": "这是完成了对知识分子心灵悲剧结构机制的论述收束。",
    "start": 516.656,
    "end": 521.216,
    "duration": 4.56
  },
  {
    "id": 125,
    "text": "六、第五板块：主体四•文体形式实验逐句咬合精解。",
    "start": 521.216,
    "end": 526.016,
    "duration": 4.8
  },
  {
    "id": 126,
    "text": "本段深入小说具体的修辞、视点与文体创新，",
    "start": 526.016,
    "end": 529.776,
    "duration": 3.76
  },
  {
    "id": 127,
    "text": "证明鲁迅艺术创造的多样性与先锋性。",
    "start": 529.776,
    "end": 533.056,
    "duration": 3.28
  },
  {
    "id": 128,
    "text": "段首句提炼鲁迅的形式创新精神，具体表述到答题语句就是：第四，",
    "start": 533.056,
    "end": 538.976,
    "duration": 5.92
  },
  {
    "id": 129,
    "text": "在文体与技巧探索上，鲁迅秉持“一篇有一篇之形式”的先锋实验精神。",
    "start": 538.976,
    "end": 544.416,
    "duration": 5.44
  },
  {
    "id": 130,
    "text": "这是引用教材原话，定性其强烈的文体自觉意识。",
    "start": 544.656,
    "end": 549.056,
    "duration": 4.4
  },
  {
    "id": 131,
    "text": "紧接着指出其形式创新的深层资源，",
    "start": 549.056,
    "end": 552.256,
    "duration": 3.2
  },
  {
    "id": 132,
    "text": "具体表述到答题语句就是：他创造性融合了西方现代艺术经验与中国本土古典资源。",
    "start": 552.256,
    "end": 559.796,
    "duration": 7.54
  },
  {
    "id": 133,
    "text": "这是交代其技巧兼具现代性与民族根基的成因。",
    "start": 559.796,
    "end": 564.09,
    "duration": 4.294
  },
  {
    "id": 134,
    "text": "有了总体概括，紧接着调取《狂人日记》的视点与文本实验，",
    "start": 564.09,
    "end": 569.028,
    "duration": 4.938
  },
  {
    "id": 135,
    "text": "具体表述到答题语句就是：《狂人日记》以文言小序与白话正文形成双重叙述，",
    "start": 569.028,
    "end": 575.684,
    "duration": 6.656
  },
  {
    "id": 136,
    "text": "构成深刻的反讽互文。",
    "start": 575.684,
    "end": 577.616,
    "duration": 1.932
  },
  {
    "id": 137,
    "text": "这是剖析文言小序的病愈入仕反讽狂人日记的吃人清醒。",
    "start": 577.696,
    "end": 582.336,
    "duration": 4.64
  },
  {
    "id": 138,
    "text": "接着调取《孔乙己》的视点网络作为证据，",
    "start": 582.632,
    "end": 585.512,
    "duration": 2.88
  },
  {
    "id": 139,
    "text": "具体表述到答题语句就是：《孔乙己》以十二岁的小伙计为第一人称有限视点，",
    "start": 585.512,
    "end": 591.874,
    "duration": 6.362
  },
  {
    "id": 140,
    "text": "构筑起精妙的多重叙述网络。",
    "start": 591.874,
    "end": 594.346,
    "duration": 2.472
  },
  {
    "id": 141,
    "text": "这是证明儿童纯真视点对成人社会冷酷暴力的无意识观照。",
    "start": 594.346,
    "end": 599.496,
    "duration": 5.15
  },
  {
    "id": 142,
    "text": "随后调取《阿Q正传》的传记文体革新，",
    "start": 599.496,
    "end": 602.586,
    "duration": 3.09
  },
  {
    "id": 143,
    "text": "具体表述到答题语句就是：《阿Q正传》巧妙改造传统传记文体，",
    "start": 602.586,
    "end": 607.736,
    "duration": 5.15
  },
  {
    "id": 144,
    "text": "叙述距离在冷嘲与悲敏之间灵活流动。",
    "start": 607.736,
    "end": 611.032,
    "duration": 3.296
  },
  {
    "id": 145,
    "text": "这是指出其对传统史传笔法与现代讽刺技巧的超越融合。",
    "start": 611.112,
    "end": 616.392,
    "duration": 5.28
  },
  {
    "id": 146,
    "text": "最后总结其综合文体实验的整体成就，",
    "start": 616.392,
    "end": 619.432,
    "duration": 3.04
  },
  {
    "id": 147,
    "text": "具体表述到答题语句就是：鲁迅还将散文诗笔调、",
    "start": 619.432,
    "end": 623.672,
    "duration": 4.24
  },
  {
    "id": 148,
    "text": "白描勾勒与心理分析融为一体，极大地拓展了现代小说的美学疆域。",
    "start": 623.672,
    "end": 628.712,
    "duration": 5.04
  },
  {
    "id": 149,
    "text": "这是完成形式技巧板块的全面收口。",
    "start": 628.712,
    "end": 631.272,
    "duration": 2.56
  },
  {
    "id": 150,
    "text": "七、第六板块：结语段逐句咬合精解。",
    "start": 631.672,
    "end": 635.592,
    "duration": 3.92
  },
  {
    "id": 151,
    "text": "本段承担全篇成果的提炼与文学史定位的闭环回收。",
    "start": 635.592,
    "end": 640.072,
    "duration": 4.48
  },
  {
    "id": 152,
    "text": "论证行进至尾声，首先以排比句法对主体四大部分进行工整回收，",
    "start": 640.072,
    "end": 645.752,
    "duration": 5.68
  },
  {
    "id": 153,
    "text": "具体表述到答题语句就是：综上所述，",
    "start": 645.752,
    "end": 648.872,
    "duration": 3.12
  },
  {
    "id": 154,
    "text": "鲁迅对中国小说史的贡献是根本性与全局性的。",
    "start": 648.872,
    "end": 652.392,
    "duration": 3.52
  },
  {
    "id": 155,
    "text": "他立现代小说之体，拓现代小说之深，",
    "start": 652.712,
    "end": 656.112,
    "duration": 3.4
  },
  {
    "id": 156,
    "text": "创现代小说之型，铸现代小说之魂。",
    "start": 656.112,
    "end": 659.432,
    "duration": 3.32
  },
  {
    "id": 157,
    "text": "“立现代小说之体”对应主体一奠基，",
    "start": 659.432,
    "end": 662.752,
    "duration": 3.32
  },
  {
    "id": 158,
    "text": "“拓现代小说之深”对应主体二精神，",
    "start": 662.752,
    "end": 666.072,
    "duration": 3.32
  },
  {
    "id": 159,
    "text": "“创现代小说之型”对应主体三结构，",
    "start": 666.072,
    "end": 669.392,
    "duration": 3.32
  },
  {
    "id": 160,
    "text": "“铸现代小说之魂”对应主体四形式。",
    "start": 669.392,
    "end": 672.712,
    "duration": 3.32
  },
  {
    "id": 161,
    "text": "紧接着笔锋强力回扣全篇开篇的成熟命题，",
    "start": 672.792,
    "end": 676.392,
    "duration": 3.6
  },
  {
    "id": 162,
    "text": "具体表述到答题语句就是：中国现代小说因鲁迅的卓越开拓，",
    "start": 676.392,
    "end": 681.432,
    "duration": 5.04
  },
  {
    "id": 163,
    "text": "在起步阶段便跨入了世界文学的成熟高度。",
    "start": 681.432,
    "end": 685.192,
    "duration": 3.76
  },
  {
    "id": 164,
    "text": "这是实现全篇论述在最高学术评价上的完美闭环。",
    "start": 685.192,
    "end": 689.112,
    "duration": 3.92
  }
]