[
  {
    "id": 1,
    "text": "本题是 807 专业课中关于鲁迅小说的最高母题，分值为 30 分。",
    "start": 0.1,
    "end": 6.144,
    "duration": 6.044
  },
  {
    "id": 2,
    "text": "考查的核心目的，是要求考生站在百年现代文学史的长河视野中，系统论证鲁迅小说为何能够作为现代小说的源头与高峰，证明其在文体创生，思想深度，叙事模型与形式实验上的全方位奠基价值。",
    "start": 6.094,
    "end": 23.733,
    "duration": 17.639
  },
  {
    "id": 3,
    "text": "回答这道题切忌零散罗列单篇小说的故事情节。",
    "start": 23.733,
    "end": 28.485,
    "duration": 4.752
  },
  {
    "id": 4,
    "text": "必须建立文学史宏观史观，从“文体创立”，“思想深度”，“叙事结构”和“文体形式”四个递进层次展开，全面论证其如何将中国小说由古代形态推向现代形态。",
    "start": 28.485,
    "end": 42.821,
    "duration": 14.336
  },
  {
    "id": 5,
    "text": "全篇确立四个核心论述维度，",
    "start": 42.821,
    "end": 45.764,
    "duration": 2.943
  },
  {
    "id": 6,
    "text": "第一是文体章法颠覆（从章回到现代短篇，白话语言成熟）。",
    "start": 45.764,
    "end": 51.142,
    "duration": 5.378
  },
  {
    "id": 7,
    "text": "第二是题材开拓与表现重心内转（两大题材聚焦精神病苦）。",
    "start": 51.142,
    "end": 57.08,
    "duration": 5.938
  },
  {
    "id": 8,
    "text": "第三是经典叙事结构模式（“看/被看”结构与“归乡”模型）。",
    "start": 57.079,
    "end": 61.897,
    "duration": 4.818
  },
  {
    "id": 9,
    "text": "第四是“一篇有一篇之形式”的实验技巧（文白反讽，童稚视点，史传戏仿）。",
    "start": 61.897,
    "end": 68.603,
    "duration": 6.706
  },
  {
    "id": 10,
    "text": "这四个维度遵循着从文体确立，到思想重量，到叙事机理，再到微观技巧的严密推演链条。",
    "start": 68.603,
    "end": 77.34,
    "duration": 8.737
  },
  {
    "id": 11,
    "text": "文体范式确立解决了“现代小说是什么形态”的根本问题；",
    "start": 77.34,
    "end": 82.21,
    "duration": 4.87
  },
  {
    "id": 12,
    "text": "表现重心内转解决了“现代小说关注何种精神深度”的思想内核问题；",
    "start": 82.209,
    "end": 88.758,
    "duration": 6.549
  },
  {
    "id": 13,
    "text": "叙事法则营构论证了鲁迅如何将社会关系密码转化为稳定的叙事法则；",
    "start": 88.759,
    "end": 94.944,
    "duration": 6.185
  },
  {
    "id": 14,
    "text": "先锋文体实验则落脚于具体的文本操作技巧，证明其形式上的先锋性与民族性。",
    "start": 94.944,
    "end": 102.548,
    "duration": 7.604
  },
  {
    "id": 15,
    "text": "从文体范式，到思想内向，再到结构模型，最后落脚于微观技法，逻辑层层递进，滴水不漏。",
    "start": 102.548,
    "end": 111.376,
    "duration": 8.828
  },
  {
    "id": 16,
    "text": "中国现代小说在鲁迅笔下诞生，亦在鲁迅手中迅速跨入成熟殿堂。",
    "start": 111.376,
    "end": 117.808,
    "duration": 6.432
  },
  {
    "id": 17,
    "text": "1918 年《狂人日记》的横空出世，不仅宣告了中国现代白话小说的正式确立，更奠定了五四新文学思想启蒙与形式革命的双重标杆；其后《呐喊》与《彷徨》两部小说集，则以卓越的文体自觉与精神深度，树立了中国现代小说的经典范式。",
    "start": 117.808,
    "end": 138.403,
    "duration": 20.595
  },
  {
    "id": 18,
    "text": "鲁迅对现代小说史的贡献是根本性与全局性的，主要体现在以下四个核心维度，",
    "start": 138.403,
    "end": 145.591,
    "duration": 7.188
  },
  {
    "id": 19,
    "text": "直接上刺刀破题，以《狂人日记》与《呐喊》《彷徨》锁定从诞生到成熟的文学史坐标，下引四大支柱。",
    "start": 145.591,
    "end": 154.588,
    "duration": 8.997
  },
  {
    "id": 20,
    "text": "第一，颠覆古典叙事章法，确立现代白话短篇小说的崭新文体范式。",
    "start": 154.588,
    "end": 160.669,
    "duration": 6.081
  },
  {
    "id": 21,
    "text": "加粗动宾立桩，指出其终结章回全知叙事，开辟心理叙事与成熟白话新文体，确立与世界文学平视的尊严。",
    "start": 160.669,
    "end": 170.851,
    "duration": 10.182
  },
  {
    "id": 22,
    "text": "第二，开辟农民与知识分子两大题材，实现表现重心向“灵魂深处”的深度内转。",
    "start": 170.851,
    "end": 178.052,
    "duration": 7.201
  },
  {
    "id": 23,
    "text": "加粗动宾立桩，调取华老栓买药，闰土“老爷”，祥林嫂灵魂暴毙三大经典名场面，做实由物质苦难向精神病苦的开掘。",
    "start": 178.052,
    "end": 188.69,
    "duration": 10.638
  },
  {
    "id": 24,
    "text": "第三，独创“看客结构”与“归乡模型”，将深层社会心理机制外化为现代叙事法则。",
    "start": 188.69,
    "end": 195.917,
    "duration": 7.227
  },
  {
    "id": 25,
    "text": "加粗动宾立桩，解剖酒客取乐，嚼头消遣与鸭颈看客的“看客结构”，以及篷船归乡的知识分子精神漂泊困境。",
    "start": 195.916,
    "end": 206.229,
    "duration": 10.313
  },
  {
    "id": 26,
    "text": "第四，秉持“一篇有一篇之形式”的美学追求，开创了中西艺术经验交融的先锋实验范本。",
    "start": 206.229,
    "end": 213.924,
    "duration": 7.695
  },
  {
    "id": 27,
    "text": "加粗动宾立桩，调取《狂人日记》文白双重视角，《孔乙己》童稚限知视点与《阿Q正传》史传戏仿，证明形式先锋性。",
    "start": 213.924,
    "end": 224.132,
    "duration": 10.208
  },
  {
    "id": 28,
    "text": "综上所述，鲁迅立现代小说之体，拓现代小说之深，创现代叙事之型，铸现代文学之魂。",
    "start": 224.132,
    "end": 232.791,
    "duration": 8.659
  },
  {
    "id": 29,
    "text": "他以卓越的艺术探索，使中国现代小说在起步之时便完成了与古典传统的决裂，确立了足以辉映后世的不朽经典坐标。",
    "start": 232.791,
    "end": 243.533,
    "duration": 10.742
  },
  {
    "id": 30,
    "text": "以“体，深，型，魂”四字工整排比收口，升华历史定评。",
    "start": 243.533,
    "end": 249.562,
    "duration": 6.029
  }
]