[
  {
    "id": 1,
    "text": "试论鲁迅小说对中国现代小说史的开创性贡献。",
    "start": 0.0,
    "end": 5.126,
    "duration": 5.126
  },
  {
    "id": 2,
    "text": "中国现代小说在鲁迅笔下诞生，亦在鲁迅手中迅速跨入成熟殿堂。",
    "start": 5.126,
    "end": 11.553,
    "duration": 6.427
  },
  {
    "id": 3,
    "text": "五四新文化运动时期《狂人日记》的横空出世，",
    "start": 11.553,
    "end": 15.143,
    "duration": 3.59
  },
  {
    "id": 4,
    "text": "不仅宣告了中国现代白话小说的正式确立，",
    "start": 15.143,
    "end": 18.51,
    "duration": 3.367
  },
  {
    "id": 5,
    "text": "更奠定了五四新文学思想启蒙与形式革命的双重标杆；",
    "start": 18.51,
    "end": 23.577,
    "duration": 5.067
  },
  {
    "id": 6,
    "text": "其后《呐喊》与《彷徨》两部小说集，",
    "start": 23.577,
    "end": 26.048,
    "duration": 2.471
  },
  {
    "id": 7,
    "text": "则以卓越的文体自觉与精神深度，",
    "start": 26.048,
    "end": 28.789,
    "duration": 2.741
  },
  {
    "id": 8,
    "text": "树立了中国现代小说的经典范式。",
    "start": 28.789,
    "end": 31.341,
    "duration": 2.552
  },
  {
    "id": 9,
    "text": "鲁迅对现代小说史的贡献是根本性与全局性的，",
    "start": 31.341,
    "end": 35.289,
    "duration": 3.948
  },
  {
    "id": 10,
    "text": "主要体现在以下四个核心维度：",
    "start": 35.289,
    "end": 38.419,
    "duration": 3.13
  },
  {
    "id": 11,
    "text": "第一，颠覆古典叙事章法，确立现代白话短篇小说的崭新文体范式。",
    "start": 38.419,
    "end": 43.173,
    "duration": 4.754
  },
  {
    "id": 12,
    "text": "《狂人日记》彻底终结了中国传统章回小说依附于连贯情节与全知视角的叙事惯性，",
    "start": 43.173,
    "end": 50.16,
    "duration": 6.987
  },
  {
    "id": 13,
    "text": "开创性地借由狂人的心理意识流动来结构全篇，",
    "start": 50.16,
    "end": 56.387,
    "duration": 6.227
  },
  {
    "id": 14,
    "text": "完成了由“事件叙事”向“心理叙事”的文体突围。",
    "start": 56.387,
    "end": 61.827,
    "duration": 5.44
  },
  {
    "id": 15,
    "text": "鲁迅将现代白话提炼为高度洗练、",
    "start": 61.827,
    "end": 66.776,
    "duration": 4.949
  },
  {
    "id": 16,
    "text": "富有哲思与表现张力的文学语言，",
    "start": 66.776,
    "end": 68.763,
    "duration": 1.987
  },
  {
    "id": 17,
    "text": "终结了晚清白话小说拖沓生硬的过渡状态；",
    "start": 68.763,
    "end": 74.603,
    "duration": 5.84
  },
  {
    "id": 18,
    "text": "《阿Q正传》更以其深刻的国民性解剖代表现代汉语小说走入世界文学之林，",
    "start": 74.603,
    "end": 81.153,
    "duration": 6.55
  },
  {
    "id": 19,
    "text": "使中国新小说在发轫之初便获得了与世界现代文学平视的艺术尊严。",
    "start": 81.153,
    "end": 87.182,
    "duration": 6.029
  },
  {
    "id": 20,
    "text": "第二，开辟农民与知识分子两大题材，",
    "start": 87.182,
    "end": 90.179,
    "duration": 2.997
  },
  {
    "id": 21,
    "text": "实现表现重心向“灵魂深处”的深度内转。",
    "start": 90.179,
    "end": 92.662,
    "duration": 2.483
  },
  {
    "id": 22,
    "text": "鲁迅小说直面“病态社会中不幸的人们”，",
    "start": 92.662,
    "end": 96.717,
    "duration": 4.055
  },
  {
    "id": 23,
    "text": "却坚决拒绝廉价的苦难展览。",
    "start": 96.717,
    "end": 98.675,
    "duration": 1.958
  },
  {
    "id": 24,
    "text": "《药》中只用一床满幅补钉的旧夹被虚写清贫，",
    "start": 98.675,
    "end": 103.915,
    "duration": 5.24
  },
  {
    "id": 25,
    "text": "正面镜头却冷峻聚焦于华老栓买人血馒头为子治病的精神愚昧；",
    "start": 103.915,
    "end": 110.471,
    "duration": 6.556
  },
  {
    "id": 26,
    "text": "《故乡》中最撼人心魄的不是农民闰土身受的饥荒与苛税，",
    "start": 110.471,
    "end": 117.028,
    "duration": 6.557
  },
  {
    "id": 27,
    "text": "而是二十年后相见时那一声划出森严阶级鸿沟的“老爷”；",
    "start": 117.028,
    "end": 122.481,
    "duration": 5.453
  },
  {
    "id": 28,
    "text": "《祝福》则以手术刀般的笔触，精准解剖了祥林嫂在封建政权、",
    "start": 122.481,
    "end": 127.668,
    "duration": 5.187
  },
  {
    "id": 29,
    "text": "族权、神权与夫权罗网中从绝望挣扎走向灵魂暴毙的悲剧历程。",
    "start": 127.668,
    "end": 131.95,
    "duration": 4.282
  },
  {
    "id": 30,
    "text": "鲁迅把小说的探照灯从外在物质苦难转向国民内在精神创伤，",
    "start": 131.95,
    "end": 139.084,
    "duration": 7.134
  },
  {
    "id": 31,
    "text": "为现代现实主义文学注入了前所未有的思想骨力。",
    "start": 139.084,
    "end": 144.179,
    "duration": 5.095
  },
  {
    "id": 32,
    "text": "第三，独创“看客结构”与“归乡模型”，",
    "start": 144.179,
    "end": 148.26,
    "duration": 4.081
  },
  {
    "id": 33,
    "text": "将深层社会心理机制外化为现代叙事法则。",
    "start": 148.26,
    "end": 153.57,
    "duration": 5.31
  },
  {
    "id": 34,
    "text": "在叙事结构上，鲁迅创造了“看与被看”的二元对峙机制。",
    "start": 153.57,
    "end": 157.71,
    "duration": 4.14
  },
  {
    "id": 35,
    "text": "《孔乙己》中酒客以落魄文人的伤疤取乐，",
    "start": 157.71,
    "end": 161.626,
    "duration": 3.916
  },
  {
    "id": 36,
    "text": "《祝福》中鲁镇民众将祥林嫂阿毛之死的血泪记忆当做消遣的无聊嚼头，",
    "start": 161.626,
    "end": 168.926,
    "duration": 7.3
  },
  {
    "id": 37,
    "text": "《药》中刑场外伸长颈项如鸭子般的看客群像，",
    "start": 168.926,
    "end": 173.88,
    "duration": 4.954
  },
  {
    "id": 38,
    "text": "将民众被剥夺主体性后的麻木围观推向了“吃与被吃”的精神寓言。",
    "start": 173.88,
    "end": 181.877,
    "duration": 7.997
  },
  {
    "id": 39,
    "text": "同时，《故乡》与《在酒楼上》开创了始于篷船、",
    "start": 181.877,
    "end": 185.839,
    "duration": 3.962
  },
  {
    "id": 40,
    "text": "终于篷船的“离去—归来—再离去”现代归乡模型，",
    "start": 185.839,
    "end": 189.631,
    "duration": 3.792
  },
  {
    "id": 41,
    "text": "精准具象化了启蒙知识分子怀抱理想归乡、遭遇现实荒寒、",
    "start": 189.631,
    "end": 195.297,
    "duration": 5.666
  },
  {
    "id": 42,
    "text": "最终进退失据的普遍精神漂泊困境。",
    "start": 195.297,
    "end": 197.716,
    "duration": 2.419
  },
  {
    "id": 43,
    "text": "第四，秉持“一篇有一篇之形式”的美学追求，",
    "start": 197.716,
    "end": 201.861,
    "duration": 4.145
  },
  {
    "id": 44,
    "text": "开创了中西艺术经验交融的先锋实验范本。",
    "start": 201.861,
    "end": 205.163,
    "duration": 3.302
  },
  {
    "id": 45,
    "text": "鲁迅博采西方现代象征主义、表现主义与中国古典白描、",
    "start": 205.163,
    "end": 211.716,
    "duration": 6.553
  },
  {
    "id": 46,
    "text": "史传笔法，展现了高度开放的文体创造力。",
    "start": 211.716,
    "end": 214.83,
    "duration": 3.114
  },
  {
    "id": 47,
    "text": "《狂人日记》巧妙设置文言小序与白话正文的双重视角，",
    "start": 214.83,
    "end": 219.951,
    "duration": 5.121
  },
  {
    "id": 48,
    "text": "构筑起反思传统文明的复调反讽隐喻；",
    "start": 219.951,
    "end": 224.309,
    "duration": 4.358
  },
  {
    "id": 49,
    "text": "《孔乙己》以十二岁小伙计的有限视点叙事，",
    "start": 224.309,
    "end": 227.302,
    "duration": 2.993
  },
  {
    "id": 50,
    "text": "形成童稚视角与世态炎凉之间的冷峻张力；",
    "start": 227.302,
    "end": 230.403,
    "duration": 3.101
  },
  {
    "id": 51,
    "text": "《阿Q正传》戏仿传统“正史正传”体制，",
    "start": 230.403,
    "end": 232.032,
    "duration": 1.629
  },
  {
    "id": 52,
    "text": "以游戏笔调解构封建史传只为帝王将相立传的森严秩序。",
    "start": 232.032,
    "end": 233.692,
    "duration": 1.66
  },
  {
    "id": 53,
    "text": "散文诗笔调、象征隐喻与辛辣反讽的浑然一体，",
    "start": 233.692,
    "end": 235.317,
    "duration": 1.625
  },
  {
    "id": 54,
    "text": "极大地拓展了现代小说的审美疆界。",
    "start": 235.317,
    "end": 237.233,
    "duration": 1.916
  },
  {
    "id": 55,
    "text": "综上所述，鲁迅立现代小说之体、拓现代小说之深、",
    "start": 237.233,
    "end": 238.687,
    "duration": 1.454
  },
  {
    "id": 56,
    "text": "创现代叙事之型、铸现代文学之魂。",
    "start": 238.687,
    "end": 240.043,
    "duration": 1.356
  },
  {
    "id": 57,
    "text": "他以卓越的艺术探索，",
    "start": 240.043,
    "end": 242.341,
    "duration": 2.298
  },
  {
    "id": 58,
    "text": "使中国现代小说在起步之时便完成了与古典传统的决裂，",
    "start": 242.341,
    "end": 244.637,
    "duration": 2.296
  },
  {
    "id": 59,
    "text": "确立了足以辉映后世的不朽经典坐标。",
    "start": 244.637,
    "end": 245.764,
    "duration": 1.127
  }
]