[
  {
    "id": 1,
    "text": "题目：结合曹禺《雷雨》具体戏剧冲突，",
    "start": 0.113,
    "end": 3.259,
    "duration": 3.146
  },
  {
    "id": 2,
    "text": "简析繁漪的复杂性格特征及其悲剧成因。",
    "start": 3.59,
    "end": 6.594,
    "duration": 3.004
  },
  {
    "id": 3,
    "text": "繁漪是《雷雨》中性格最为炽烈、现代性最突出的悲剧女性，",
    "start": 6.896,
    "end": 11.11,
    "duration": 4.214
  },
  {
    "id": 4,
    "text": "被作者称为拥有“最‘雷雨’的性格”。",
    "start": 11.539,
    "end": 14.006,
    "duration": 2.467
  },
  {
    "id": 5,
    "text": "她是一个受五四新思潮影响却深陷封建死屋的复杂人物，",
    "start": 14.228,
    "end": 18.528,
    "duration": 4.3
  },
  {
    "id": 6,
    "text": "其性格特征与悲剧成因主要体现于以下四个方面：",
    "start": 18.836,
    "end": 22.91,
    "duration": 4.074
  },
  {
    "id": 7,
    "text": "第一，怀抱个性自主的炽烈渴望，敢于当面抗衡家长专制。",
    "start": 23.521,
    "end": 28.471,
    "duration": 4.95
  },
  {
    "id": 8,
    "text": "繁漪受过新式教育，",
    "start": 28.787,
    "end": 30.166,
    "duration": 1.379
  },
  {
    "id": 9,
    "text": "在周公馆沉闷窒息的环境中仍保有着对爱情与独立人格的追求。",
    "start": 30.638,
    "end": 35.604,
    "duration": 4.966
  },
  {
    "id": 10,
    "text": "面对周朴园的封建家长威权，",
    "start": 35.931,
    "end": 37.923,
    "duration": 1.992
  },
  {
    "id": 11,
    "text": "她是全剧唯一敢于正面顶撞的反叛者；",
    "start": 38.156,
    "end": 40.679,
    "duration": 2.523
  },
  {
    "id": 12,
    "text": "在“喝药”一幕的典型冲突中，她从骨子里蔑视封建规训，",
    "start": 41.071,
    "end": 45.006,
    "duration": 3.935
  },
  {
    "id": 13,
    "text": "即便被按住强迫喝下苦药，其冷峻沉默仍透出不屈的傲骨。",
    "start": 45.281,
    "end": 50.48,
    "duration": 5.199
  },
  {
    "id": 14,
    "text": "第二，爱欲受挫后转为绝望报复，爆发“雷雨”般的毁灭力量。",
    "start": 51.099,
    "end": 55.542,
    "duration": 4.443
  },
  {
    "id": 15,
    "text": "繁漪在极度压抑中将全部生命热情孤注一掷地寄托于周萍；",
    "start": 55.943,
    "end": 60.309,
    "duration": 4.366
  },
  {
    "id": 16,
    "text": "当周萍出于怯懦与名声企图抽身、转而爱恋四凤时，",
    "start": 60.623,
    "end": 64.418,
    "duration": 3.795
  },
  {
    "id": 17,
    "text": "繁漪的精神支柱随之坍塌。",
    "start": 64.719,
    "end": 66.666,
    "duration": 1.947
  },
  {
    "id": 18,
    "text": "炽热的爱意转化为玉石俱焚的复仇意志，",
    "start": 66.995,
    "end": 69.968,
    "duration": 2.973
  },
  {
    "id": 19,
    "text": "她在雷雨之夜当众揭开两代人的血缘隐秘，",
    "start": 70.22,
    "end": 73.231,
    "duration": 3.011
  },
  {
    "id": 20,
    "text": "将周公馆掩盖多年的伪善秩序击得粉碎。",
    "start": 73.66,
    "end": 76.729,
    "duration": 3.069
  },
  {
    "id": 21,
    "text": "第三，封建宗法体制的专制扼杀，构成其悲剧的制度根源。",
    "start": 77.394,
    "end": 82.119,
    "duration": 4.725
  },
  {
    "id": 22,
    "text": "周朴园凭借封建家长特权构筑了一座令人窒息的牢笼。",
    "start": 82.665,
    "end": 86.718,
    "duration": 4.053
  },
  {
    "id": 23,
    "text": "为维护家族体面，他将反叛礼教的繁漪斥为“疯子”，",
    "start": 87.086,
    "end": 90.971,
    "duration": 3.885
  },
  {
    "id": 24,
    "text": "剥夺其正常的话语权，并以请医服药为名施以软禁与精神折磨，",
    "start": 91.366,
    "end": 96.508,
    "duration": 5.142
  },
  {
    "id": 25,
    "text": "从制度上堵死了女性追求自由的正常出路。",
    "start": 96.958,
    "end": 100.122,
    "duration": 3.164
  },
  {
    "id": 26,
    "text": "第四，懦弱男权的背叛与孤立抗争的局限，构成其悲剧的直接成因。",
    "start": 100.73,
    "end": 105.924,
    "duration": 5.194
  },
  {
    "id": 27,
    "text": "周萍自私怯懦、始乱终弃，将伦理罪责推诿给繁漪，",
    "start": 106.248,
    "end": 110.104,
    "duration": 3.856
  },
  {
    "id": 28,
    "text": "使其陷入情爱与道德的双重绝境。",
    "start": 110.317,
    "end": 112.715,
    "duration": 2.398
  },
  {
    "id": 29,
    "text": "在缺乏社会变革支撑的前提下，",
    "start": 113.067,
    "end": 115.045,
    "duration": 1.978
  },
  {
    "id": 30,
    "text": "脱离群众力量的个人反抗难免走向扭曲与自我毁灭。",
    "start": 115.385,
    "end": 119.396,
    "duration": 4.011
  },
  {
    "id": 31,
    "text": "归结而言，",
    "start": 120.064,
    "end": 120.804,
    "duration": 0.74
  },
  {
    "id": 32,
    "text": "繁漪的悲剧是五四觉醒女性在封建宗法重压与懦弱男权夹击下的毁灭挽歌，",
    "start": 121.047,
    "end": 127.815,
    "duration": 6.768
  },
  {
    "id": 33,
    "text": "深刻控诉了旧家庭制度对人性的残酷摧残。",
    "start": 128.258,
    "end": 131.897,
    "duration": 3.639
  }
]