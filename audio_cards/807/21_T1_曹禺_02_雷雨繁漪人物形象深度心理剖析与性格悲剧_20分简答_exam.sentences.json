[
  {
    "id": 1,
    "text": "题型，二十分简答题。",
    "start": 0.08,
    "end": 2.32,
    "duration": 2.24
  },
  {
    "id": 2,
    "text": "分值，二十分。",
    "start": 2.32,
    "end": 3.92,
    "duration": 1.6
  },
  {
    "id": 3,
    "text": "建议考场时间，二十分钟。",
    "start": 3.92,
    "end": 6.0,
    "duration": 2.08
  },
  {
    "id": 4,
    "text": "目标字数，五百五十到六百五十字。",
    "start": 6.0,
    "end": 9.12,
    "duration": 3.12
  },
  {
    "id": 5,
    "text": "答题骨架，形象定性、趋近于、繁漪复杂性格的三大特征、",
    "start": 9.12,
    "end": 14.08,
    "duration": 4.96
  },
  {
    "id": 6,
    "text": "趋近于、悲剧生成的双重机制、趋近于、",
    "start": 14.08,
    "end": 17.6,
    "duration": 3.52
  },
  {
    "id": 7,
    "text": "总结升华。",
    "start": 17.6,
    "end": 18.64,
    "duration": 1.04
  },
  {
    "id": 8,
    "text": "繁漪是曹禺话剧《雷雨》中塑造得最深刻饱满的悲剧人物。",
    "start": 18.64,
    "end": 23.04,
    "duration": 4.4
  },
  {
    "id": 9,
    "text": "曹禺在剧本序幕中盛赞其拥有“最‘雷雨’的性格”。",
    "start": 23.44,
    "end": 28.0,
    "duration": 4.56
  },
  {
    "id": 10,
    "text": "她是一个既受封建压迫又敢于绝望反叛、",
    "start": 28.0,
    "end": 32.08,
    "duration": 4.08
  },
  {
    "id": 11,
    "text": "爱到极致又恨到畸形的复杂悲剧典型。",
    "start": 32.08,
    "end": 35.92,
    "duration": 3.84
  },
  {
    "id": 12,
    "text": "首先，在性格特征上，繁漪呈现出炽烈狂暴与矛盾撕裂的三大心理维度。",
    "start": 35.92,
    "end": 42.16,
    "duration": 6.24
  },
  {
    "id": 13,
    "text": "第一是拥有如火如荼、追求自主生命的原生热情。",
    "start": 42.16,
    "end": 46.32,
    "duration": 4.16
  },
  {
    "id": 14,
    "text": "她在窒息阴森的周公馆中保留了罕见的性灵与生命渴望，",
    "start": 46.56,
    "end": 51.12,
    "duration": 4.56
  },
  {
    "id": 15,
    "text": "敢于冲破世俗伦理与继子周萍相爱，",
    "start": 51.12,
    "end": 54.24,
    "duration": 3.12
  },
  {
    "id": 16,
    "text": "展现出追求个体解放的决绝勇气。",
    "start": 54.24,
    "end": 57.04,
    "duration": 2.8
  },
  {
    "id": 17,
    "text": "第二是具有深沉坚韧的反抗骨力。",
    "start": 57.04,
    "end": 59.76,
    "duration": 2.72
  },
  {
    "id": 18,
    "text": "面对周朴园封建家长制的威严专制，",
    "start": 59.76,
    "end": 62.8,
    "duration": 3.04
  },
  {
    "id": 19,
    "text": "她是周公馆中唯一敢于当面顶撞、公然蔑视周朴园统治的叛逆女性，",
    "start": 62.8,
    "end": 68.24,
    "duration": 5.44
  },
  {
    "id": 20,
    "text": "在周朴园逼其“喝药”的残酷冲突中，",
    "start": 68.24,
    "end": 70.8,
    "duration": 2.56
  },
  {
    "id": 21,
    "text": "她从骨子里透露出不屈的傲骨。",
    "start": 70.8,
    "end": 73.12,
    "duration": 2.32
  },
  {
    "id": 22,
    "text": "第三是在绝望受挫中异化出的狠毒报复心理。",
    "start": 73.36,
    "end": 77.68,
    "duration": 4.32
  },
  {
    "id": 23,
    "text": "当遭遇周萍的懦弱背弃并发现其转恋四凤后，",
    "start": 77.68,
    "end": 81.84,
    "duration": 4.16
  },
  {
    "id": 24,
    "text": "繁漪的爱转化为焚毁一切的绝望狂怒，",
    "start": 81.84,
    "end": 85.2,
    "duration": 3.36
  },
  {
    "id": 25,
    "text": "她在雷雨之夜撕开全部罪恶真相，在玉石俱焚中走向毁灭。",
    "start": 85.2,
    "end": 90.08,
    "duration": 4.88
  },
  {
    "id": 26,
    "text": "其次，在悲剧成因上，繁漪的毁灭是封建专制窒息压迫与男权自私背叛共同绞杀的产物。",
    "start": 90.08,
    "end": 97.6,
    "duration": 7.52
  },
  {
    "id": 27,
    "text": "一方面，周朴园所构筑的封建礼教铁笼是扼杀其生命的制度根源。",
    "start": 97.92,
    "end": 103.2,
    "duration": 5.28
  },
  {
    "id": 28,
    "text": "周朴园以虚伪的道德名分将生性热烈的繁漪判定为“疯子”，",
    "start": 103.2,
    "end": 108.16,
    "duration": 4.96
  },
  {
    "id": 29,
    "text": "用逼喝药的暴力规训试图磨灭其独立人格，",
    "start": 108.16,
    "end": 111.84,
    "duration": 3.68
  },
  {
    "id": 30,
    "text": "令其陷入生不如死的精神绝境。",
    "start": 111.84,
    "end": 114.32,
    "duration": 2.48
  },
  {
    "id": 31,
    "text": "另一方面，周萍的自私懦弱是将其推入深渊的直接导火索。",
    "start": 114.32,
    "end": 118.8,
    "duration": 4.48
  },
  {
    "id": 32,
    "text": "周萍始乱终弃，以所谓“悔过”为借口将一切罪责推伟给繁漪并仓皇逃避，",
    "start": 119.04,
    "end": 125.12,
    "duration": 6.08
  },
  {
    "id": 33,
    "text": "彻底击碎了繁漪赖以存活的情感支柱。",
    "start": 125.12,
    "end": 128.16,
    "duration": 3.04
  },
  {
    "id": 34,
    "text": "在无路可走的封建死局中，她的抗争只能演化为病态疯狂的自杀式爆发。",
    "start": 128.16,
    "end": 134.08,
    "duration": 5.92
  },
  {
    "id": 35,
    "text": "综上所述，繁漪的悲剧是五四时期追求个性解放的叛逆女性在封建宗法黑网与懦弱男权夹击下的生命悲歌。",
    "start": 134.456,
    "end": 144.376,
    "duration": 9.92
  },
  {
    "id": 36,
    "text": "曹禺通过这一“雷雨式”的复杂灵魂，",
    "start": 144.376,
    "end": 146.856,
    "duration": 2.48
  },
  {
    "id": 37,
    "text": "深刻揭露了封建家庭对人性的残酷摧残，",
    "start": 146.856,
    "end": 150.456,
    "duration": 3.6
  },
  {
    "id": 38,
    "text": "展现了极具震撼力的崇高悲剧力量。",
    "start": 150.456,
    "end": 152.936,
    "duration": 2.48
  }
]