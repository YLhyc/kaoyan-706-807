[
  {
    "id": 1,
    "text": "穆旦是二十世纪四十年代九叶诗派最具代表性的诗歌巨匠。",
    "start": 0.08,
    "end": 4.88,
    "duration": 4.8
  },
  {
    "id": 2,
    "text": "他以敏锐深邃的现代哲学思考，打破了早期新诗浮泛直白的抒情模式。",
    "start": 4.88,
    "end": 10.96,
    "duration": 6.08
  },
  {
    "id": 3,
    "text": "穆旦追求现代诗的“智性化”。",
    "start": 10.96,
    "end": 13.6,
    "duration": 2.64
  },
  {
    "id": 4,
    "text": "他将时代苦难、自我怀疑与深层心理体验紧密熔铸在一起。",
    "start": 13.6,
    "end": 18.8,
    "duration": 5.2
  },
  {
    "id": 5,
    "text": "其艺术特质与智性追求主要体现在三个层面。",
    "start": 18.8,
    "end": 22.48,
    "duration": 3.68
  },
  {
    "id": 6,
    "text": "第一，肉体痛感与抽象哲理思辨的深层并置。",
    "start": 22.72,
    "end": 26.96,
    "duration": 4.24
  },
  {
    "id": 7,
    "text": "穆旦倡导“把思想转化为感觉，把感觉升华为思想”。",
    "start": 26.96,
    "end": 31.28,
    "duration": 4.32
  },
  {
    "id": 8,
    "text": "他绝不作抽象空洞的概念说教，而是将复杂的哲学沉思落实于可触可感的肉身知觉。",
    "start": 31.28,
    "end": 38.56,
    "duration": 7.28
  },
  {
    "id": 9,
    "text": "在《诗八首》中，他探讨两性爱情与生存困境。",
    "start": 38.56,
    "end": 42.24,
    "duration": 3.68
  },
  {
    "id": 10,
    "text": "诗人写下“静静地，我们拥抱在用言语所能造的夏天里”。",
    "start": 42.48,
    "end": 46.949,
    "duration": 4.469
  },
  {
    "id": 11,
    "text": "诗句将肉体的亲昵拥抱，与语言符号筑起的虚妄防线严丝合缝地焊接在一起。",
    "start": 46.949,
    "end": 53.449,
    "duration": 6.5
  },
  {
    "id": 12,
    "text": "感官渴望与理性荒诞的剧烈撞击，构成了极具哲理厚度的智性张力。",
    "start": 53.449,
    "end": 59.137,
    "duration": 5.688
  },
  {
    "id": 13,
    "text": "第二，无情解剖知识分子的精神分裂与现代危机。",
    "start": 59.137,
    "end": 63.2,
    "duration": 4.063
  },
  {
    "id": 14,
    "text": "面对战乱与动荡的民族现实，穆旦拒绝浪漫主义的廉价欢呼。",
    "start": 63.28,
    "end": 68.24,
    "duration": 4.96
  },
  {
    "id": 15,
    "text": "他以冷酷的手术刀反躬自省，将自身作为受审对象。",
    "start": 68.24,
    "end": 72.88,
    "duration": 4.64
  },
  {
    "id": 16,
    "text": "在《隐现》中，他逼视知识分子在崇高理想与现实苟且之间的撕裂与软弱。",
    "start": 72.88,
    "end": 78.8,
    "duration": 5.92
  },
  {
    "id": 17,
    "text": "这种带着自我原罪感的沉重反思，表现出对现代人性幽微处的惊悚洞察。",
    "start": 78.8,
    "end": 84.56,
    "duration": 5.76
  },
  {
    "id": 18,
    "text": "诗歌由此获得了极为深沉的思想重量。",
    "start": 84.88,
    "end": 87.76,
    "duration": 2.88
  },
  {
    "id": 19,
    "text": "第三，悖论反讽修辞与高度张力的现代意象网络。",
    "start": 87.76,
    "end": 92.24,
    "duration": 4.48
  },
  {
    "id": 20,
    "text": "穆旦彻底革新了现代汉语的诗歌表达。",
    "start": 92.24,
    "end": 95.12,
    "duration": 2.88
  },
  {
    "id": 21,
    "text": "他大量运用相互矛盾、冲突的词汇组合，",
    "start": 95.12,
    "end": 98.64,
    "duration": 3.52
  },
  {
    "id": 22,
    "text": "制造出动人心魄的意象对立。",
    "start": 98.64,
    "end": 100.96,
    "duration": 2.32
  },
  {
    "id": 23,
    "text": "在《赞美》中，他对民族受难历史的炽热礼赞，",
    "start": 100.96,
    "end": 104.56,
    "duration": 3.6
  },
  {
    "id": 24,
    "text": "与严峻残酷的荒凉现实相互碰撞。",
    "start": 104.56,
    "end": 107.52,
    "duration": 2.96
  },
  {
    "id": 25,
    "text": "语言冷硬、凝练而饱含重压。",
    "start": 107.84,
    "end": 110.72,
    "duration": 2.88
  },
  {
    "id": 26,
    "text": "他打破了古典诗歌和谐宁静的传统范式，",
    "start": 110.72,
    "end": 114.16,
    "duration": 3.44
  },
  {
    "id": 27,
    "text": "开辟了现代汉语容纳复杂现代经验的全新可能。",
    "start": 114.16,
    "end": 118.32,
    "duration": 4.16
  },
  {
    "id": 28,
    "text": "穆旦的诗歌代表了四十年代中国新诗现代化的最高水准。",
    "start": 118.32,
    "end": 123.2,
    "duration": 4.88
  },
  {
    "id": 29,
    "text": "他所确立的智性美学范式，成为当代汉语诗歌走向现代成熟的永恒源泉。",
    "start": 123.2,
    "end": 129.44,
    "duration": 6.24
  }
]