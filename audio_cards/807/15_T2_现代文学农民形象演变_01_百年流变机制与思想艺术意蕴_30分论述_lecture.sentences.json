[
  {
    "id": 1,
    "text": "一、宏观结构推演与采分点映射。",
    "start": 0.08,
    "end": 3.2,
    "duration": 3.12
  },
  {
    "id": 2,
    "text": "本题标准分为、三十、分（或、四十、",
    "start": 3.2,
    "end": 6.08,
    "duration": 2.88
  },
  {
    "id": 3,
    "text": "分综合论述大题），结构采用高分“总论破题定位，",
    "start": 6.08,
    "end": 10.24,
    "duration": 4.16
  },
  {
    "id": 4,
    "text": "四大历史阶段梯次演进，总结历史哲学深度”逻辑模型：一、",
    "start": 10.24,
    "end": 15.28,
    "duration": 5.04
  },
  {
    "id": 5,
    "text": "破题总论层（约一百五十字）：点明农民问题在中国革命与现代化中的核心枢纽地位。",
    "start": 15.28,
    "end": 22.16,
    "duration": 6.88
  },
  {
    "id": 6,
    "text": "提炼三段论式演变线索（愚昧待启蒙者、",
    "start": 22.4,
    "end": 25.84,
    "duration": 3.44
  },
  {
    "id": 7,
    "text": "趋近于、历史主体、趋近于、复杂文化载体与欲望沉浮者）。",
    "start": 25.84,
    "end": 31.267,
    "duration": 5.427
  },
  {
    "id": 8,
    "text": "二、第一阶段：五四启蒙（鲁迅）：采分点为反封建、",
    "start": 31.267,
    "end": 35.707,
    "duration": 4.44
  },
  {
    "id": 9,
    "text": "病态灵魂与精神麻木、人道主义启蒙、",
    "start": 35.707,
    "end": 39.407,
    "duration": 3.7
  },
  {
    "id": 10,
    "text": "“哀其不幸，怒其不争”（《故乡》闰土、",
    "start": 39.407,
    "end": 42.367,
    "duration": 2.96
  },
  {
    "id": 11,
    "text": "《祝福》祥林嫂）。",
    "start": 42.367,
    "end": 43.6,
    "duration": 1.233
  },
  {
    "id": 12,
    "text": "三、第二阶段：延安与解放区（赵树理）：采分点为文艺为工农兵方向、",
    "start": 43.76,
    "end": 50.0,
    "duration": 6.24
  },
  {
    "id": 13,
    "text": "历史主人翁确立、反封建迷信、新型青年农民与翻身叙事（《小二黑结婚》）。",
    "start": 50.0,
    "end": 56.56,
    "duration": 6.56
  },
  {
    "id": 14,
    "text": "四、第三阶段：十七年社会主义集体化（柳青）：采分点为农业合作化道路、",
    "start": 56.56,
    "end": 62.88,
    "duration": 6.32
  },
  {
    "id": 15,
    "text": "社会主义新人典型、无私奉献与英雄主义（《创业史》梁生宝）。",
    "start": 62.88,
    "end": 67.6,
    "duration": 4.72
  },
  {
    "id": 16,
    "text": "五、第四阶段：新时期与当代（高晓声、",
    "start": 67.76,
    "end": 71.2,
    "duration": 3.44
  },
  {
    "id": 17,
    "text": "陈忠实）：采分点为历史反思、阿Q精神遗存（《陈换生上城》）、",
    "start": 71.2,
    "end": 76.64,
    "duration": 5.44
  },
  {
    "id": 18,
    "text": "宗法文化守望与人性沉浮（《白鹿原》白嘉轩、",
    "start": 76.64,
    "end": 80.56,
    "duration": 3.92
  },
  {
    "id": 19,
    "text": "鹿三）。",
    "start": 80.56,
    "end": 81.28,
    "duration": 0.72
  },
  {
    "id": 20,
    "text": "六、总结提升层（约一百五十字）：文学史哲学评价、",
    "start": 81.28,
    "end": 85.28,
    "duration": 4.0
  },
  {
    "id": 21,
    "text": "知识分子与民间关系的调适、中国文学现代性的思想基石。",
    "start": 85.28,
    "end": 89.68,
    "duration": 4.4
  },
  {
    "id": 22,
    "text": "二、逐段内部咬合与考场得分句推导。",
    "start": 90.08,
    "end": 93.36,
    "duration": 3.28
  },
  {
    "id": 23,
    "text": "破题段：历史地位与变迁总纲。",
    "start": 93.36,
    "end": 96.4,
    "duration": 3.04
  },
  {
    "id": 24,
    "text": "论证推演逻辑：必须从现代中国的国情开篇。",
    "start": 96.4,
    "end": 99.92,
    "duration": 3.52
  },
  {
    "id": 25,
    "text": "农民是中国现代变革的主体。",
    "start": 99.92,
    "end": 102.0,
    "duration": 2.08
  },
  {
    "id": 26,
    "text": "明确提炼农民形象从五四到当代的整体演进曲线（启蒙对象、",
    "start": 102.0,
    "end": 106.8,
    "duration": 4.8
  },
  {
    "id": 27,
    "text": "趋近于、革命主体、趋近于、文化人性载体），",
    "start": 106.8,
    "end": 110.4,
    "duration": 3.6
  },
  {
    "id": 28,
    "text": "作为贯穿四段的核心绳索。",
    "start": 110.4,
    "end": 112.4,
    "duration": 2.0
  },
  {
    "id": 29,
    "text": "具体表述到答题语句就是：农民问题是中国现代历史与社会变革的核心枢纽。",
    "start": 112.4,
    "end": 118.296,
    "duration": 5.896
  },
  {
    "id": 30,
    "text": "现当代文学中农民形象的百年变迁，",
    "start": 118.296,
    "end": 121.256,
    "duration": 2.96
  },
  {
    "id": 31,
    "text": "深刻折射出中国现代思想文化演进与政权结构更迭的历史律动。",
    "start": 121.256,
    "end": 126.296,
    "duration": 5.04
  },
  {
    "id": 32,
    "text": "从五四时期的启蒙批判，到延安与十七年时期的革命翻身，",
    "start": 126.376,
    "end": 131.096,
    "duration": 4.72
  },
  {
    "id": 33,
    "text": "再到新时期的文化反思与人性复归，",
    "start": 131.096,
    "end": 134.136,
    "duration": 3.04
  },
  {
    "id": 34,
    "text": "农民形象经历了由“愚昧待启蒙者”到“历史创造主体”，",
    "start": 134.136,
    "end": 138.696,
    "duration": 4.56
  },
  {
    "id": 35,
    "text": "再到“复杂文化载体与欲望沉浮者”的深刻蜕变。",
    "start": 138.696,
    "end": 142.456,
    "duration": 3.76
  },
  {
    "id": 36,
    "text": "这一演变历程主要展现为四个历史阶段。",
    "start": 142.776,
    "end": 145.736,
    "duration": 2.96
  },
  {
    "id": 37,
    "text": "农民问题是中国现代历史与社会变革的核心枢纽。",
    "start": 145.736,
    "end": 149.656,
    "duration": 3.92
  },
  {
    "id": 38,
    "text": "现当代文学中农民形象的百年变迁，",
    "start": 149.656,
    "end": 152.616,
    "duration": 2.96
  },
  {
    "id": 39,
    "text": "深刻折射出中国现代思想文化演进与政权结构更迭的历史律动。",
    "start": 152.616,
    "end": 157.816,
    "duration": 5.2
  },
  {
    "id": 40,
    "text": "从五四时期的启蒙批判，到延安与十七年时期的革命翻身，",
    "start": 157.816,
    "end": 162.136,
    "duration": 4.32
  },
  {
    "id": 41,
    "text": "再到新时期的文化反思与人性复归，",
    "start": 162.136,
    "end": 165.096,
    "duration": 2.96
  },
  {
    "id": 42,
    "text": "农民形象经历了由“愚昧待启蒙者”到“历史创造主体”，",
    "start": 165.096,
    "end": 169.496,
    "duration": 4.4
  },
  {
    "id": 43,
    "text": "再到“复杂文化载体与欲望沉浮者”的深刻蜕变。",
    "start": 169.496,
    "end": 173.016,
    "duration": 3.52
  },
  {
    "id": 44,
    "text": "这一演变历程主要展现为四个历史阶段。",
    "start": 173.336,
    "end": 176.536,
    "duration": 3.2
  },
  {
    "id": 45,
    "text": "第一阶段：五四启蒙批判对象（鲁迅《故乡》《祝福》）。",
    "start": 176.536,
    "end": 180.936,
    "duration": 4.4
  },
  {
    "id": 46,
    "text": "论证推演逻辑：从五四立人思想切入。",
    "start": 180.936,
    "end": 184.536,
    "duration": 3.6
  },
  {
    "id": 47,
    "text": "五四作家站在启蒙高地审视农民。",
    "start": 184.536,
    "end": 187.656,
    "duration": 3.12
  },
  {
    "id": 48,
    "text": "结合鲁迅经典的“哀其不幸，怒其不争”，",
    "start": 187.656,
    "end": 191.336,
    "duration": 3.68
  },
  {
    "id": 49,
    "text": "列举《故乡》闰土的麻木木偶化，以及《祝福》祥林嫂被礼教神权吞噬的悲剧，",
    "start": 191.336,
    "end": 197.896,
    "duration": 6.56
  },
  {
    "id": 50,
    "text": "论证农民作为封建病态受害者的思想意蕴。",
    "start": 197.896,
    "end": 201.496,
    "duration": 3.6
  },
  {
    "id": 51,
    "text": "-具体表述到答题语句就是：第一，",
    "start": 201.656,
    "end": 204.429,
    "duration": 2.773
  },
  {
    "id": 52,
    "text": "五四时期的病态灵魂解剖与人道主义启蒙关怀。",
    "start": 204.429,
    "end": 208.696,
    "duration": 4.267
  },
  {
    "id": 53,
    "text": "五四新文学先驱以反封建为己任。",
    "start": 208.696,
    "end": 211.683,
    "duration": 2.987
  },
  {
    "id": 54,
    "text": "农民在作家笔下首先作为宗法礼教毒害下的受害者与病态灵魂呈现。",
    "start": 211.683,
    "end": 217.869,
    "duration": 6.186
  },
  {
    "id": 55,
    "text": "鲁迅在《故乡》中塑造了闰土形象。",
    "start": 217.869,
    "end": 220.643,
    "duration": 2.774
  },
  {
    "id": 56,
    "text": "少年闰土灵动鲜活，中年闰土却被饥荒、",
    "start": 220.643,
    "end": 224.056,
    "duration": 3.413
  },
  {
    "id": 57,
    "text": "苛税与多子折磨成了麻木的“木偶人”。",
    "start": 224.056,
    "end": 227.256,
    "duration": 3.2
  },
  {
    "id": 58,
    "text": "在《祝福》中，祥林嫂在三从四德与神权阴影下沦为乞丐，",
    "start": 227.416,
    "end": 232.856,
    "duration": 5.44
  },
  {
    "id": 59,
    "text": "其关于魂灵的泣血之问被冷漠的看客所吞噬。",
    "start": 232.856,
    "end": 236.696,
    "duration": 3.84
  },
  {
    "id": 60,
    "text": "鲁迅秉持“哀其不幸，怒其不争”的启蒙立场，",
    "start": 236.696,
    "end": 240.536,
    "duration": 3.84
  },
  {
    "id": 61,
    "text": "深刻揭示了宗法制度对农民肉体与精神的残酷扼杀。",
    "start": 240.536,
    "end": 244.616,
    "duration": 4.08
  },
  {
    "id": 62,
    "text": "第一，五四时期的病态灵魂解剖与人道主义启蒙关怀。",
    "start": 245.0,
    "end": 249.88,
    "duration": 4.88
  },
  {
    "id": 63,
    "text": "五四新文学先驱以反封建为己任。",
    "start": 249.88,
    "end": 253.0,
    "duration": 3.12
  },
  {
    "id": 64,
    "text": "农民在作家笔下首先作为宗法礼教毒害下的受害者与病态灵魂呈现。",
    "start": 253.0,
    "end": 259.08,
    "duration": 6.08
  },
  {
    "id": 65,
    "text": "鲁迅在《故乡》中塑造了闰土形象。",
    "start": 259.08,
    "end": 261.88,
    "duration": 2.8
  },
  {
    "id": 66,
    "text": "少年闰土灵动鲜活，中年闰土却被饥荒、",
    "start": 261.88,
    "end": 265.4,
    "duration": 3.52
  },
  {
    "id": 67,
    "text": "苛税与多子折磨成了麻木的“木偶人”。",
    "start": 265.4,
    "end": 268.2,
    "duration": 2.8
  },
  {
    "id": 68,
    "text": "在《祝福》中，祥林嫂在三从四德与神权阴影下沦为乞丐，",
    "start": 268.44,
    "end": 273.88,
    "duration": 5.44
  },
  {
    "id": 69,
    "text": "其关于魂灵的泣血之问被冷漠的看客所吞噬。",
    "start": 273.88,
    "end": 278.04,
    "duration": 4.16
  },
  {
    "id": 70,
    "text": "鲁迅秉持“哀其不幸，怒其不争”的启蒙立场，",
    "start": 278.04,
    "end": 281.96,
    "duration": 3.92
  },
  {
    "id": 71,
    "text": "深刻揭示了宗法制度对农民肉体与精神的残酷扼杀。",
    "start": 281.96,
    "end": 286.52,
    "duration": 4.56
  },
  {
    "id": 72,
    "text": "第二阶段：延安与解放区革命翻身主体（赵树理《小二黑结婚》）。",
    "start": 286.52,
    "end": 291.4,
    "duration": 4.88
  },
  {
    "id": 73,
    "text": "-论证推演逻辑：核心转向：从启蒙对象变为历史主体。",
    "start": 291.64,
    "end": 296.242,
    "duration": 4.602
  },
  {
    "id": 74,
    "text": "《在延安文艺座谈会上的讲话》指引下，",
    "start": 296.242,
    "end": 299.529,
    "duration": 3.287
  },
  {
    "id": 75,
    "text": "工农兵成为主角。",
    "start": 299.529,
    "end": 301.063,
    "duration": 1.534
  },
  {
    "id": 76,
    "text": "以赵树理《小二黑结婚》为证，小二黑和小芹敢于对抗封建家长，",
    "start": 301.063,
    "end": 306.541,
    "duration": 5.478
  },
  {
    "id": 77,
    "text": "表明翻身做主的主体意识觉醒。",
    "start": 306.541,
    "end": 309.39,
    "duration": 2.849
  },
  {
    "id": 78,
    "text": "具体表述到答题语句就是：第二，延安与解放区时期的阶级觉醒与翻身做主叙事。",
    "start": 309.39,
    "end": 316.76,
    "duration": 7.37
  },
  {
    "id": 79,
    "text": "毛泽东《在延安文艺座谈会上的讲话》确立了文艺为工农兵服务的根本方针。",
    "start": 316.76,
    "end": 323.0,
    "duration": 6.24
  },
  {
    "id": 80,
    "text": "农民在文学中的地位发生了翻天覆地的逆转。",
    "start": 323.0,
    "end": 326.68,
    "duration": 3.68
  },
  {
    "id": 81,
    "text": "他们从愚昧落后的启蒙对象，一跃成为革命斗争与根据地建设的历史主体。",
    "start": 326.68,
    "end": 332.44,
    "duration": 5.76
  },
  {
    "id": 82,
    "text": "赵树理的《小二黑结婚》塑造了二黑与小芹等新型青年农民形象。",
    "start": 332.76,
    "end": 338.36,
    "duration": 5.6
  },
  {
    "id": 83,
    "text": "他们勇敢冲破二诸葛、三仙姑等落后迷信家长的阻挠，",
    "start": 338.36,
    "end": 343.32,
    "duration": 4.96
  },
  {
    "id": 84,
    "text": "追求婚姻自主与革命工作。",
    "start": 343.32,
    "end": 345.96,
    "duration": 2.64
  },
  {
    "id": 85,
    "text": "作家运用评书体民间白话，展现了根据地民主政权与土地改革对农民精神面貌的彻底重塑。",
    "start": 345.96,
    "end": 353.8,
    "duration": 7.84
  },
  {
    "id": 86,
    "text": "第二，延安与解放区时期的阶级觉醒与翻身做主叙事。",
    "start": 354.12,
    "end": 359.0,
    "duration": 4.88
  },
  {
    "id": 87,
    "text": "毛泽东《在延安文艺座谈会上的讲话》确立了文艺为工农兵服务的根本方针。",
    "start": 359.0,
    "end": 365.24,
    "duration": 6.24
  },
  {
    "id": 88,
    "text": "农民在文学中的地位发生了翻天覆地的逆转。",
    "start": 365.24,
    "end": 368.92,
    "duration": 3.68
  },
  {
    "id": 89,
    "text": "他们从愚昧落后的启蒙对象，一跃成为革命斗争与根据地建设的历史主体。",
    "start": 368.92,
    "end": 374.68,
    "duration": 5.76
  },
  {
    "id": 90,
    "text": "赵树理的《小二黑结婚》塑造了二黑与小芹等新型青年农民形象。",
    "start": 375.0,
    "end": 380.6,
    "duration": 5.6
  },
  {
    "id": 91,
    "text": "他们勇敢冲破二诸葛、三仙姑等落后迷信家长的阻挠，",
    "start": 380.6,
    "end": 385.56,
    "duration": 4.96
  },
  {
    "id": 92,
    "text": "追求婚姻自主与革命工作。",
    "start": 385.56,
    "end": 388.2,
    "duration": 2.64
  },
  {
    "id": 93,
    "text": "作家运用评书体民间白话，展现了根据地民主政权与土地改革对农民精神面貌的彻底重塑。",
    "start": 388.2,
    "end": 395.8,
    "duration": 7.6
  },
  {
    "id": 94,
    "text": "第三阶段：十七年社会主义新人塑造（柳青《创业史》）。",
    "start": 396.104,
    "end": 400.393,
    "duration": 4.289
  },
  {
    "id": 95,
    "text": "论证推演逻辑：进入社会主义建设时期。",
    "start": 400.393,
    "end": 403.832,
    "duration": 3.439
  },
  {
    "id": 96,
    "text": "农业合作化是时代中心。",
    "start": 403.832,
    "end": 405.982,
    "duration": 2.15
  },
  {
    "id": 97,
    "text": "柳青《创业史》梁生宝是十七年社会主义新人的巅峰代表。",
    "start": 405.982,
    "end": 410.926,
    "duration": 4.944
  },
  {
    "id": 98,
    "text": "分析梁生宝带领群众买稻种、走互助合作道路的公心，",
    "start": 410.926,
    "end": 415.655,
    "duration": 4.729
  },
  {
    "id": 99,
    "text": "论证英雄主义与集体主义的升华。",
    "start": 415.655,
    "end": 418.664,
    "duration": 3.009
  },
  {
    "id": 100,
    "text": "-具体表述到答题语句就是：第三，",
    "start": 418.664,
    "end": 421.466,
    "duration": 2.802
  },
  {
    "id": 101,
    "text": "十七年文学中的社会主义集体化新人塑造与路径探索。",
    "start": 421.466,
    "end": 426.422,
    "duration": 4.956
  },
  {
    "id": 102,
    "text": "新中国成立后，农业合作化与社会主义集体经济成为农村生活的核心轴线。",
    "start": 426.422,
    "end": 433.103,
    "duration": 6.681
  },
  {
    "id": 103,
    "text": "这一时期的文学致力于塑造带领群众走集体化道路的社会主义新人典型。",
    "start": 433.103,
    "end": 439.784,
    "duration": 6.681
  },
  {
    "id": 104,
    "text": "柳青的《创业史》是这一阶段的巅峰之作。",
    "start": 439.864,
    "end": 443.064,
    "duration": 3.2
  },
  {
    "id": 105,
    "text": "主人公梁生宝深怀对党和集体的崇高忠诚。",
    "start": 443.064,
    "end": 446.664,
    "duration": 3.6
  },
  {
    "id": 106,
    "text": "他冒着风雪为互助组买稻种，以无私奉献的公心抵御自私发家致富的郭世富等富农诱惑。",
    "start": 446.664,
    "end": 453.784,
    "duration": 7.12
  },
  {
    "id": 107,
    "text": "作品将农民的命运与新中国社会主义制度的巩固深度绑定，",
    "start": 453.784,
    "end": 458.424,
    "duration": 4.64
  },
  {
    "id": 108,
    "text": "确立了庄严崇高的英雄主义美学。",
    "start": 458.424,
    "end": 460.904,
    "duration": 2.48
  },
  {
    "id": 109,
    "text": "第三，十七年文学中的社会主义集体化新人塑造与路径探索。",
    "start": 461.224,
    "end": 466.424,
    "duration": 5.2
  },
  {
    "id": 110,
    "text": "新中国成立后，农业合作化与社会主义集体经济成为农村生活的核心轴线。",
    "start": 466.424,
    "end": 472.664,
    "duration": 6.24
  },
  {
    "id": 111,
    "text": "这一时期的文学致力于塑造带领群众走集体化道路的社会主义新人典型。",
    "start": 472.664,
    "end": 478.824,
    "duration": 6.16
  },
  {
    "id": 112,
    "text": "柳青的《创业史》是这一阶段的巅峰之作。",
    "start": 478.824,
    "end": 481.864,
    "duration": 3.04
  },
  {
    "id": 113,
    "text": "主人公梁生宝深怀对党和集体的崇高忠诚。",
    "start": 482.184,
    "end": 485.944,
    "duration": 3.76
  },
  {
    "id": 114,
    "text": "他冒着风雪为互助组买稻种，以无私奉献的公心抵御自私发家致富的郭世富等富农诱惑。",
    "start": 485.944,
    "end": 493.304,
    "duration": 7.36
  },
  {
    "id": 115,
    "text": "作品将农民的命运与新中国社会主义制度的巩固深度绑定，",
    "start": 493.304,
    "end": 498.184,
    "duration": 4.88
  },
  {
    "id": 116,
    "text": "确立了庄严崇高的英雄主义美学。",
    "start": 498.184,
    "end": 500.824,
    "duration": 2.64
  },
  {
    "id": 117,
    "text": "第四阶段：新时期与当代文化反思与人性深度（高晓声、",
    "start": 500.824,
    "end": 505.784,
    "duration": 4.96
  },
  {
    "id": 118,
    "text": "陈忠实）。",
    "start": 505.784,
    "end": 506.344,
    "duration": 0.56
  },
  {
    "id": 119,
    "text": "论证推演逻辑：新时期告别概念英雄，",
    "start": 506.664,
    "end": 510.024,
    "duration": 3.36
  },
  {
    "id": 120,
    "text": "回归人性的复杂。",
    "start": 510.024,
    "end": 511.544,
    "duration": 1.52
  },
  {
    "id": 121,
    "text": "以高晓声《陈换生上城》写出改革初期农民阿Q式的自满与依赖。",
    "start": 511.544,
    "end": 517.384,
    "duration": 5.84
  },
  {
    "id": 122,
    "text": "再升华到陈忠实《白鹿原》，分析白嘉轩作为宗法文化硬汉的悲凉，",
    "start": 517.384,
    "end": 522.904,
    "duration": 5.52
  },
  {
    "id": 123,
    "text": "以及鹿三的伦理异化，展现深邃的历史文化沉浮。",
    "start": 522.904,
    "end": 527.544,
    "duration": 4.64
  },
  {
    "id": 124,
    "text": "具体表述到答题语句就是：第四，新时期以来的文化寻根反思与复杂人性深度开掘。",
    "start": 527.544,
    "end": 535.352,
    "duration": 7.808
  },
  {
    "id": 125,
    "text": "新时期打破了单一阶级斗争模式，农民形象获得了多维立体的哲学与文化深度。",
    "start": 535.352,
    "end": 541.992,
    "duration": 6.64
  },
  {
    "id": 126,
    "text": "高晓声的，陈换生上城，以敏锐的讽刺笔触，",
    "start": 541.992,
    "end": 545.912,
    "duration": 3.92
  },
  {
    "id": 127,
    "text": "描摹了新时期农民刚吃饱肚子后的精神依附与阿Q式阿Q精神遗存。",
    "start": 545.912,
    "end": 551.672,
    "duration": 5.76
  },
  {
    "id": 128,
    "text": "陈忠实的《白鹿原》则将农民置于数百年宗法文化的宏大历史兴衰中。",
    "start": 551.992,
    "end": 557.912,
    "duration": 5.92
  },
  {
    "id": 129,
    "text": "白嘉轩作为传统儒家宗法文化的守望者，",
    "start": 557.912,
    "end": 561.592,
    "duration": 3.68
  },
  {
    "id": 130,
    "text": "其一生的硬挺与悲凉极具悲剧意蕴。",
    "start": 561.592,
    "end": 565.112,
    "duration": 3.52
  },
  {
    "id": 131,
    "text": "鹿三从忠义长工沦为亲手刺杀儿媳田小娥的封建贵子手。",
    "start": 565.112,
    "end": 570.472,
    "duration": 5.36
  },
  {
    "id": 132,
    "text": "文学重新恢复了农民作为活生生人的复杂欲望、",
    "start": 570.472,
    "end": 574.392,
    "duration": 3.92
  },
  {
    "id": 133,
    "text": "伦理困境与灵魂沉浮。",
    "start": 574.392,
    "end": 576.312,
    "duration": 1.92
  },
  {
    "id": 134,
    "text": "第四，新时期以来的文化寻根反思与复杂人性深度开掘。",
    "start": 576.632,
    "end": 581.992,
    "duration": 5.36
  },
  {
    "id": 135,
    "text": "新时期打破了单一阶级斗争模式，农民形象获得了多维立体的哲学与文化深度。",
    "start": 581.992,
    "end": 588.632,
    "duration": 6.64
  },
  {
    "id": 136,
    "text": "高晓声的，陈换生上城，以敏锐的讽刺笔触，",
    "start": 588.632,
    "end": 592.632,
    "duration": 4.0
  },
  {
    "id": 137,
    "text": "描摹了新时期农民刚吃饱肚子后的精神依附与阿Q式阿Q精神遗存。",
    "start": 592.632,
    "end": 598.472,
    "duration": 5.84
  },
  {
    "id": 138,
    "text": "陈忠实的《白鹿原》则将农民置于数百年宗法文化的宏大历史兴衰中。",
    "start": 598.792,
    "end": 604.872,
    "duration": 6.08
  },
  {
    "id": 139,
    "text": "白嘉轩作为传统儒家宗法文化的守望者，",
    "start": 604.872,
    "end": 608.632,
    "duration": 3.76
  },
  {
    "id": 140,
    "text": "其一生的硬挺与悲凉极具悲剧意蕴。",
    "start": 608.632,
    "end": 612.152,
    "duration": 3.52
  },
  {
    "id": 141,
    "text": "鹿三从忠义长工沦为亲手刺杀儿媳田小娥的封建贵子手。",
    "start": 612.152,
    "end": 617.592,
    "duration": 5.44
  },
  {
    "id": 142,
    "text": "文学重新恢复了农民作为活生生人的复杂欲望、",
    "start": 617.592,
    "end": 621.832,
    "duration": 4.24
  },
  {
    "id": 143,
    "text": "伦理困境与灵魂沉浮。",
    "start": 621.832,
    "end": 623.912,
    "duration": 2.08
  },
  {
    "id": 144,
    "text": "总结升华段：文学史与中国现代性哲思。",
    "start": 624.232,
    "end": 627.672,
    "duration": 3.44
  },
  {
    "id": 145,
    "text": "论证推演逻辑：总结提升。",
    "start": 627.672,
    "end": 629.912,
    "duration": 2.24
  },
  {
    "id": 146,
    "text": "将文学中的农民变迁，升华为知识分子与民间精神互动的思想历程，",
    "start": 629.912,
    "end": 635.112,
    "duration": 5.2
  },
  {
    "id": 147,
    "text": "展现宏观答题格局。",
    "start": 635.112,
    "end": 636.952,
    "duration": 1.84
  },
  {
    "id": 148,
    "text": "具体表述到答题语句就是：现当代文学农民形象的百年演进，",
    "start": 636.952,
    "end": 641.592,
    "duration": 4.64
  },
  {
    "id": 149,
    "text": "不仅是一部乡土中国的社会变革史，",
    "start": 641.592,
    "end": 644.312,
    "duration": 2.72
  },
  {
    "id": 150,
    "text": "更是一部现代知识分子不断调整与民间关系的情感认同史。",
    "start": 644.312,
    "end": 648.872,
    "duration": 4.56
  },
  {
    "id": 151,
    "text": "文学对农民命运的深情注视与哲学审视，",
    "start": 649.112,
    "end": 652.872,
    "duration": 3.76
  },
  {
    "id": 152,
    "text": "构成了中国文学现代性进程中最沉重也最辉煌的思想基石。",
    "start": 652.872,
    "end": 658.312,
    "duration": 5.44
  },
  {
    "id": 153,
    "text": "现当代文学农民形象的百年演进，不仅是一部乡土中国的社会变革史，",
    "start": 658.312,
    "end": 663.752,
    "duration": 5.44
  },
  {
    "id": 154,
    "text": "更是一部现代知识分子不断调整与民间关系的情感认同史。",
    "start": 663.752,
    "end": 668.472,
    "duration": 4.72
  },
  {
    "id": 155,
    "text": "文学对农民命运的深情注视与哲学审视，",
    "start": 668.712,
    "end": 672.312,
    "duration": 3.6
  },
  {
    "id": 156,
    "text": "构成了中国文学现代性进程中最沉重也最辉煌的思想基石。",
    "start": 672.312,
    "end": 677.672,
    "duration": 5.36
  }
]