[
  {
    "id": 1,
    "text": "自五四新文学运动发轫至当代新时期，现当代文学的发展史在深层意义上也是一部中国农民的精神变迁史与解放史。",
    "start": 0.117,
    "end": 10.131,
    "duration": 10.014
  },
  {
    "id": 2,
    "text": "作为传统农业大国现代转型的核心群体，农民形象在不同时期的思想内涵与审美风貌，",
    "start": 10.616,
    "end": 17.336,
    "duration": 6.72
  },
  {
    "id": 3,
    "text": "折射出时代思潮、社会变革与作家视野的演进。",
    "start": 17.677,
    "end": 21.558,
    "duration": 3.881
  },
  {
    "id": 4,
    "text": "纵观百年历程，农民形象的嬗变主要经历了以下四个阶段：",
    "start": 22.285,
    "end": 26.541,
    "duration": 4.256
  },
  {
    "id": 5,
    "text": "第一，五四启蒙时期：作为“病态国民”与宗法受害者的悲悯凝视。",
    "start": 27.218,
    "end": 32.21,
    "duration": 4.992
  },
  {
    "id": 6,
    "text": "面对封建专制对民众精神的长期摧残，",
    "start": 32.558,
    "end": 35.448,
    "duration": 2.89
  },
  {
    "id": 7,
    "text": "五四启蒙作家秉持“哀其不幸，怒其不争”的忧患意识，借农民形象解剖国民劣根性。",
    "start": 35.774,
    "end": 42.761,
    "duration": 6.987
  },
  {
    "id": 8,
    "text": "鲁迅在《故乡》中描写二十年后重逢的闰土，",
    "start": 43.114,
    "end": 46.348,
    "duration": 3.234
  },
  {
    "id": 9,
    "text": "由昔日红润活泼的少年变为脸如松树皮般苍老木讷的农夫，",
    "start": 46.584,
    "end": 51.206,
    "duration": 4.622
  },
  {
    "id": 10,
    "text": "一声凄楚恭敬的“老爷”，折射出宗法等级对底层灵魂的麻木；",
    "start": 51.478,
    "end": 57.07,
    "duration": 5.592
  },
  {
    "id": 11,
    "text": "《阿Q正传》中的阿Q以“儿子打老子”的精神胜利法自欺欺人，",
    "start": 57.331,
    "end": 61.865,
    "duration": 4.534
  },
  {
    "id": 12,
    "text": "临刑前仍焦虑画圆圈不圆，揭露出传统小农在压迫下丧失自我反思能力的奴性心理；",
    "start": 62.045,
    "end": 69.233,
    "duration": 7.188
  },
  {
    "id": 13,
    "text": "《祝福》中祥林嫂在除夕夜关于“魂灵有无”的叩问，",
    "start": 69.465,
    "end": 73.306,
    "duration": 3.841
  },
  {
    "id": 14,
    "text": "更将农村妇女在政权、族权、神权与夫权绞杀下的悲剧推向顶点。",
    "start": 73.689,
    "end": 79.376,
    "duration": 5.687
  },
  {
    "id": 15,
    "text": "第二，三十年代左翼与写实时期：阶级压迫与破产危机中的挣扎求生。",
    "start": 80.003,
    "end": 86.156,
    "duration": 6.153
  },
  {
    "id": 16,
    "text": "伴随马克思主义传播与阶级意识兴起，文学视野由单纯的精神启蒙转向社会经济结构的剖析。",
    "start": 86.367,
    "end": 94.612,
    "duration": 8.245
  },
  {
    "id": 17,
    "text": "叶圣陶在《多收了三五斗》中描绘江南旧毡帽朋友们“丰收成灾”、惨遭米行贱价盘剥与洋米倾销的困境；",
    "start": 95.172,
    "end": 104.262,
    "duration": 9.09
  },
  {
    "id": 18,
    "text": "茅盾在《春蚕》中展现老通宝倾家荡产养出好蚕茧，",
    "start": 104.725,
    "end": 108.962,
    "duration": 4.237
  },
  {
    "id": 19,
    "text": "却因帝国主义经济入侵与民族工业受挫而负债累累的惨状，",
    "start": 109.314,
    "end": 114.085,
    "duration": 4.771
  },
  {
    "id": 20,
    "text": "揭示自然经济与陈旧观念在现代资本冲击下的解体；",
    "start": 114.495,
    "end": 118.842,
    "duration": 4.347
  },
  {
    "id": 21,
    "text": "老舍在《骆驼祥子》中刻画破产农民进城谋生的代表祥子，",
    "start": 119.336,
    "end": 123.945,
    "duration": 4.609
  },
  {
    "id": 22,
    "text": "他在军阀劫掠、特务敲诈与生活挤压下失去拉车希望，",
    "start": 124.173,
    "end": 128.75,
    "duration": 4.577
  },
  {
    "id": 23,
    "text": "最终沦为“个人主义的末路鬼”，剖析了农民脱离土地后的城市生存悲剧。",
    "start": 129.118,
    "end": 134.605,
    "duration": 5.487
  },
  {
    "id": 24,
    "text": "第三，延安与解放区时期：翻身变革中的精神觉醒与历史主体确立。",
    "start": 135.258,
    "end": 141.052,
    "duration": 5.794
  },
  {
    "id": 25,
    "text": "延安文艺座谈会确立工农兵方向后，农民由被启蒙的受难者转为推动历史变革的主人。",
    "start": 141.435,
    "end": 148.181,
    "duration": 6.746
  },
  {
    "id": 26,
    "text": "赵树理的《小二黑结婚》以明快通俗的民间口语，",
    "start": 148.579,
    "end": 152.17,
    "duration": 3.591
  },
  {
    "id": 27,
    "text": "塑造了抗日民主政权支持下的农村青年小二黑与小芹，",
    "start": 152.382,
    "end": 157.183,
    "duration": 4.801
  },
  {
    "id": 28,
    "text": "他们顶住二诸葛的迷信阻挠、三仙姑的装神弄鬼与恶霸金旺兄弟的迫害，争取到婚姻自主；",
    "start": 157.406,
    "end": 165.168,
    "duration": 7.762
  },
  {
    "id": 29,
    "text": "《李有才板话》则通过老贫农李有才与农会斗争，",
    "start": 165.633,
    "end": 169.522,
    "duration": 3.889
  },
  {
    "id": 30,
    "text": "真实写出了农村民主改革与基层政权改造的曲折；",
    "start": 169.908,
    "end": 174.211,
    "duration": 4.303
  },
  {
    "id": 31,
    "text": "丁玲在《太阳照在桑干河上》中深入暖水屯土改风暴，",
    "start": 174.832,
    "end": 179.02,
    "duration": 4.188
  },
  {
    "id": 32,
    "text": "既塑造了张裕民、程仁等乡村骨干，",
    "start": 179.257,
    "end": 182.119,
    "duration": 2.862
  },
  {
    "id": 33,
    "text": "又细致刻画了老农侯忠全分地后因畏惧地主而悄悄退地、最终真切觉醒的复杂心路。",
    "start": 182.483,
    "end": 189.789,
    "duration": 7.306
  },
  {
    "id": 34,
    "text": "第四，当代十七年至新时期：社会主义改造与现代化转型阵痛中的复归。",
    "start": 190.441,
    "end": 196.891,
    "duration": 6.45
  },
  {
    "id": 35,
    "text": "新中国成立后，农民形象在历史纵深中呈现出更为丰富的层次。",
    "start": 197.672,
    "end": 202.437,
    "duration": 4.765
  },
  {
    "id": 36,
    "text": "十七年文学中，柳青《创业史》既塑造了致力于互助合作的社会主义新人梁生宝，",
    "start": 202.722,
    "end": 208.49,
    "duration": 5.768
  },
  {
    "id": 37,
    "text": "也刻画了勤劳耿直却背负小农私有习惯、在犹豫挣扎中前行的“中间人物”梁三老汉，",
    "start": 208.679,
    "end": 215.628,
    "duration": 6.949
  },
  {
    "id": 38,
    "text": "凸显了农村改造的艰巨；",
    "start": 216.078,
    "end": 217.756,
    "duration": 1.678
  },
  {
    "id": 39,
    "text": "新时期以来，高晓声的“陈奂生系列”直面农村经济转型期农民的日常处境与心理重荷，",
    "start": 218.326,
    "end": 225.698,
    "duration": 7.372
  },
  {
    "id": 40,
    "text": "写出了陈奂生在生活改善与精神惯性之间的尴尬徘徊，",
    "start": 225.847,
    "end": 230.5,
    "duration": 4.653
  },
  {
    "id": 41,
    "text": "在当代语境下接续了鲁迅改造国民性的深沉关怀。",
    "start": 230.861,
    "end": 234.796,
    "duration": 3.935
  },
  {
    "id": 42,
    "text": "放眼百年文学历程，现当代文学中的农民形象经历了从“启蒙客体”到“挣扎者”，再到“革命主体”与“转型期复杂个体”的演进。",
    "start": 235.453,
    "end": 244.934,
    "duration": 9.481
  },
  {
    "id": 43,
    "text": "这一百年的形象流变轨迹，既是作家审美观念随时代演进的写照，",
    "start": 245.585,
    "end": 250.282,
    "duration": 4.697
  },
  {
    "id": 44,
    "text": "也凝结着二十世纪中国社会变革与民族自我反思的经验。",
    "start": 250.636,
    "end": 254.731,
    "duration": 4.095
  }
]