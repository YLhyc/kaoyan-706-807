[
  {
    "id": 1,
    "start": 0.08,
    "end": 4.32,
    "text": "二十世纪八十年代末至九十年代初兴起的“新写实小说”，"
  },
  {
    "id": 2,
    "start": 4.32,
    "end": 10.56,
    "text": "是中国当代文学从理想主义启蒙狂热走向日常生活本体的重大审美转型思潮。"
  },
  {
    "id": 3,
    "start": 10.88,
    "end": 14.32,
    "text": "以池莉、刘震云、方方等为代表的作家群，"
  },
  {
    "id": 4,
    "start": 14.32,
    "end": 18.88,
    "text": "打破了传统现实主义的典型化模式与先锋文学的形式迷宫，"
  },
  {
    "id": 5,
    "start": 18.88,
    "end": 22.24,
    "text": "以冷峻客观的姿态直面普通人的生存困境，"
  },
  {
    "id": 6,
    "start": 22.24,
    "end": 25.12,
    "text": "确立了平民化世俗叙事的新品格。"
  },
  {
    "id": 7,
    "start": 25.12,
    "end": 32.0,
    "text": "首先，在题材与审美追求上，新写实小说执着于“原生态”呈现凡俗人生的生存困境，"
  },
  {
    "id": 8,
    "start": 32.0,
    "end": 34.96,
    "text": "将目光彻底投向琐碎粗力的日常生活。"
  },
  {
    "id": 9,
    "start": 35.2,
    "end": 41.04,
    "text": "作家们坚决摒弃了传统文学对英雄崇高与宏大历史进程的虚妄拔高，"
  },
  {
    "id": 10,
    "start": 41.04,
    "end": 47.12,
    "text": "转而聚焦于普通平民在柴米油盐、人情世故与单位体制重压下的真实挣扎。"
  },
  {
    "id": 11,
    "start": 47.12,
    "end": 53.2,
    "text": "池莉的《烦恼人生》细致入微地记录了武汉工人印家厚从清晨赶渡轮、"
  },
  {
    "id": 12,
    "start": 53.2,
    "end": 57.2,
    "text": "挤公共汽车、换煤气罐直至夜晚归家的整整一天，"
  },
  {
    "id": 13,
    "start": 57.2,
    "end": 60.96,
    "text": "逼真展现出日常生存如流水般的琐屑与沉重。"
  },
  {
    "id": 14,
    "start": 61.2,
    "end": 66.64,
    "text": "刘震云的《一地鸡毛》则通过机关小职员小林为一块变艘的豆腐、"
  },
  {
    "id": 15,
    "start": 66.64,
    "end": 70.8,
    "text": "为老婆调动工作与争夺蜂窝煤等琐事展开叙事，"
  },
  {
    "id": 16,
    "start": 70.8,
    "end": 76.48,
    "text": "深刻揭示了琐碎庸常的世俗生活对个体青春理想的无情消磨。"
  },
  {
    "id": 17,
    "start": 76.48,
    "end": 83.28,
    "text": "其次，在叙事姿态与文体形态上，新写实小说坚决消解宏大意识形态话语，"
  },
  {
    "id": 18,
    "start": 83.28,
    "end": 87.68,
    "text": "倡导“还原生活本来面目”与“零度情感介入”的纪实笔法。"
  },
  {
    "id": 19,
    "start": 88.0,
    "end": 93.04,
    "text": "叙述者彻底放弃了启蒙导师与道德法官的居高临下姿态，"
  },
  {
    "id": 20,
    "start": 93.04,
    "end": 98.08,
    "text": "既不作义愤填膺的道德审判，也不作廉价虚妄的温情抚慰，"
  },
  {
    "id": 21,
    "start": 98.08,
    "end": 103.92,
    "text": "而是以近乎冷漠平静、不偏不倚的“零度叙事”客观陈述生活本相。"
  },
  {
    "id": 22,
    "start": 103.92,
    "end": 107.44,
    "text": "小说普遍采用生活流与自然主义白描技法，"
  },
  {
    "id": 23,
    "start": 107.44,
    "end": 110.72,
    "text": "不刻意追求大起大落的戏剧化情节悬念，"
  },
  {
    "id": 24,
    "start": 110.72,
    "end": 117.84,
    "text": "而是以平实寡淡的叙事节律，真实复原生命在平庸岁月中缓缓流淌的沉重质感。"
  },
  {
    "id": 25,
    "start": 118.128,
    "end": 124.928,
    "text": "综上所述，“新写实小说”思潮以对凡俗人生的冷峻凝视击碎了盲目的浪漫神话，"
  },
  {
    "id": 26,
    "start": 124.928,
    "end": 129.728,
    "text": "以客观原生态的叙事革新拓展了中国写实文学的疆界。"
  },
  {
    "id": 27,
    "start": 129.728,
    "end": 135.248,
    "text": "它促使当代文学从形而上的宏大启蒙真正落地于凡俗人间，"
  },
  {
    "id": 28,
    "start": 135.248,
    "end": 137.568,
    "text": "具有深远的文学史转折意义。"
  }
]