[
  {
    "id": 1,
    "text": "试论五四文学革命的历史发生、理论建设与中国文学的现代转型。",
    "start": 0.16,
    "end": 5.407,
    "duration": 5.247
  },
  {
    "id": 2,
    "text": "五四文学革命是中国文学由古代跨入现代的历史分水岭。",
    "start": 5.927,
    "end": 10.438,
    "duration": 4.511
  },
  {
    "id": 3,
    "text": "它以五四新文化运动的思想启蒙为引擎，以白话文取代文言文为突破口，",
    "start": 10.958,
    "end": 16.497,
    "duration": 5.539
  },
  {
    "id": 4,
    "text": "以“人的文学”为精神内核，打破了数千年古典文学的独尊地位。",
    "start": 16.867,
    "end": 21.322,
    "duration": 4.455
  },
  {
    "id": 5,
    "text": "在现代报刊媒介与觉醒知识分子的推动下，这场革命重塑了文学观念、语言工具、文体范式与主体精神，",
    "start": 21.889,
    "end": 30.342,
    "duration": 8.453
  },
  {
    "id": 6,
    "text": "为百年新文学铸造了启蒙思想基因。",
    "start": 30.799,
    "end": 33.479,
    "duration": 2.68
  },
  {
    "id": 7,
    "text": "其历史脉络与现代转型成就主要体现在以下四个方面：",
    "start": 34.103,
    "end": 38.433,
    "duration": 4.33
  },
  {
    "id": 8,
    "text": "第一，顺应近代历史变革潮流，形成由温和发难到激进论辩的破旧斗争链条。",
    "start": 39.095,
    "end": 45.705,
    "duration": 6.61
  },
  {
    "id": 9,
    "text": "五四文学革命是晚清以来诗界、文界与小说界革命积累而成的必然质变。",
    "start": 46.225,
    "end": 51.495,
    "duration": 5.27
  },
  {
    "id": 10,
    "text": "辛亥革命推翻帝制与现代学堂兴起，催生出具有独立反思意志的现代知识分子群体。",
    "start": 52.015,
    "end": 58.572,
    "duration": 6.557
  },
  {
    "id": 11,
    "text": "以《新青年》为核心阵地，先驱者高举民主与科学大旗：胡适发表《文学改良刍议》，",
    "start": 59.092,
    "end": 65.96,
    "duration": 6.868
  },
  {
    "id": 12,
    "text": "从历史进化论出发提出“不用典、不作无病之呻吟”等八事主张，以温和审慎之态揭开序幕；",
    "start": 66.447,
    "end": 73.863,
    "duration": 7.416
  },
  {
    "id": 13,
    "text": "陈独秀发表《文学革命论》，打出“三大主义”大旗，",
    "start": 74.383,
    "end": 77.919,
    "duration": 3.536
  },
  {
    "id": 14,
    "text": "将旧文学定性为专制政体与封建国民性的温床，展开正面强攻。",
    "start": 78.289,
    "end": 83.505,
    "duration": 5.216
  },
  {
    "id": 15,
    "text": "面对林纾、学衡派与甲寅派等保守阵营的反扑，",
    "start": 84.025,
    "end": 87.919,
    "duration": 3.894
  },
  {
    "id": 16,
    "text": "先驱者在论争中击碎了“文以载道”与游戏消遣的旧秩序，确立了白话新文学的历史合法性。",
    "start": 88.289,
    "end": 95.452,
    "duration": 7.163
  },
  {
    "id": 17,
    "text": "第二，确立“胡适立形式、周作人立内容”的双重架构，奠定新文学的理论根基。",
    "start": 96.076,
    "end": 103.253,
    "duration": 7.177
  },
  {
    "id": 18,
    "text": "文学革命具有鲜明的“理论先行”特征，",
    "start": 103.773,
    "end": 106.598,
    "duration": 2.825
  },
  {
    "id": 19,
    "text": "胡适与周作人分别在形式媒介与思想灵魂两端奠定理论基石。",
    "start": 106.968,
    "end": 112.4,
    "duration": 5.432
  },
  {
    "id": 20,
    "text": "胡适致力于语言工具的解放，在《建设的文学革命论》中提出“国语的文学，文学的国语”，",
    "start": 112.981,
    "end": 120.049,
    "duration": 7.068
  },
  {
    "id": 21,
    "text": "将白话改革升格为现代民族国家建构的文化基石；",
    "start": 120.419,
    "end": 124.734,
    "duration": 4.315
  },
  {
    "id": 22,
    "text": "周作人在《人的文学》中确立了新文学的人道主义灵魂，",
    "start": 125.254,
    "end": 129.485,
    "duration": 4.231
  },
  {
    "id": 23,
    "text": "倡导以“个人主义的人间本位”重新发现人，要求文学如实表现普通人的痛苦与灵肉一致的人性。",
    "start": 129.855,
    "end": 137.726,
    "duration": 7.871
  },
  {
    "id": 24,
    "text": "形式与内容的双重合璧，使新文学挣脱封建经学的附庸地位，",
    "start": 138.246,
    "end": 142.933,
    "duration": 4.687
  },
  {
    "id": 25,
    "text": "确立了以人的解放为目的的独立审美本体。",
    "start": 143.303,
    "end": 146.529,
    "duration": 3.226
  },
  {
    "id": 26,
    "text": "第三，吸纳多元外国文艺思潮，催生新文学社团蜂起与双峰对峙格局。",
    "start": 147.201,
    "end": 153.655,
    "duration": 6.454
  },
  {
    "id": 27,
    "text": "文学革命迅速由激进破坏转向大规模的社团建设，",
    "start": 154.175,
    "end": 158.165,
    "duration": 3.99
  },
  {
    "id": 28,
    "text": "西方现实主义、浪漫主义与象征主义等思潮被中国化吸收。",
    "start": 158.535,
    "end": 163.075,
    "duration": 4.54
  },
  {
    "id": 29,
    "text": "文学研究会与创造社的崛起，标志着现代文学阵营走向成熟：",
    "start": 163.595,
    "end": 168.34,
    "duration": 4.745
  },
  {
    "id": 30,
    "text": "文学研究会高扬“为人生而艺术”的现实主义大旗，注重对社会病态与底层疾苦的写实剖析；",
    "start": 168.71,
    "end": 176.095,
    "duration": 7.385
  },
  {
    "id": 31,
    "text": "创造社高扬“为艺术而艺术”的浪漫主义旗帜，",
    "start": 176.615,
    "end": 180.049,
    "duration": 3.434
  },
  {
    "id": 32,
    "text": "强调主观直抒胸臆、个性张扬与反抗旧世界的狂飙激情。",
    "start": 180.419,
    "end": 185.194,
    "duration": 4.775
  },
  {
    "id": 33,
    "text": "两大社团各具侧重又相互砥砺，构成双峰对峙格局，充实了现代文学的生力军与体裁版图。",
    "start": 185.768,
    "end": 193.177,
    "duration": 7.409
  },
  {
    "id": 34,
    "text": "第四，转化丰硕艺术实绩，开辟启蒙感伤与现代文体多元探索的创作潮流。",
    "start": 193.791,
    "end": 200.436,
    "duration": 6.645
  },
  {
    "id": 35,
    "text": "文学革命在第一个十年内迅速转化为丰硕的艺术实绩，",
    "start": 201.19,
    "end": 205.211,
    "duration": 4.021
  },
  {
    "id": 36,
    "text": "呈现出启蒙、感伤、个性化与多元方法等鲜明特征。",
    "start": 205.745,
    "end": 210.328,
    "duration": 4.583
  },
  {
    "id": 37,
    "text": "以鲁迅《狂人日记》与《阿Q正传》为标志，中国现代小说起步便站在现代哲学与国民性解剖的思想高地；",
    "start": 210.848,
    "end": 218.963,
    "duration": 8.115
  },
  {
    "id": 38,
    "text": "郁达夫《沉沦》的自叙传坦陈与郭沫若《女神》的自由奔涌，",
    "start": 219.49,
    "end": 223.577,
    "duration": 4.087
  },
  {
    "id": 39,
    "text": "度量了现代青年觉醒后的个性张力与时代感伤律动。",
    "start": 224.017,
    "end": 227.956,
    "duration": 3.939
  },
  {
    "id": 40,
    "text": "小说、散文小品、自由新诗与现代话剧的成熟，验证并丰富了文学革命的理论蓝图。",
    "start": 228.476,
    "end": 235.291,
    "duration": 6.815
  },
  {
    "id": 41,
    "text": "从现代文学史演进来看，五四文学革命是一场触及中华民族精神灵魂的伟大文艺革新。",
    "start": 235.917,
    "end": 242.702,
    "duration": 6.785
  },
  {
    "id": 42,
    "text": "它以语言工具的革命打破了思维桎梏，以“人的发现”重构了文学与人生的血肉纽带，",
    "start": 243.222,
    "end": 249.478,
    "duration": 6.256
  },
  {
    "id": 43,
    "text": "确立了中国现代文学百年来生生不息的精神源头。",
    "start": 249.848,
    "end": 253.601,
    "duration": 3.753
  }
]