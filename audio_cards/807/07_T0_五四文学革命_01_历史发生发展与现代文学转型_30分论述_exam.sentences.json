[
  {
    "id": 1,
    "text": "五四文学革命是中国文学由古典向现代转型的伟大历史分水岭。",
    "start": 0.08,
    "end": 5.138,
    "duration": 5.058
  },
  {
    "id": 2,
    "text": "这场全方位的文学革新，以新文化运动的思想启蒙为根本动力，",
    "start": 5.358,
    "end": 10.24,
    "duration": 4.882
  },
  {
    "id": 3,
    "text": "以白话文取代文言文作为形式突破口，",
    "start": 10.46,
    "end": 13.179,
    "duration": 2.719
  },
  {
    "id": 4,
    "text": "并以“人的文学”为思想内容核心。",
    "start": 13.399,
    "end": 15.76,
    "duration": 2.361
  },
  {
    "id": 5,
    "text": "它不仅彻底终结了中国古代古典文学的统治地位，",
    "start": 15.98,
    "end": 19.823,
    "duration": 3.843
  },
  {
    "id": 6,
    "text": "更在现代报刊媒介与知识分子群体的支撑下，",
    "start": 20.043,
    "end": 23.47,
    "duration": 3.427
  },
  {
    "id": 7,
    "text": "完成了文学观念、思想内容、语言工具与文体范式的历史性现代转型，",
    "start": 23.69,
    "end": 29.315,
    "duration": 5.625
  },
  {
    "id": 8,
    "text": "完成了从破坏旧文学到建设新文学的历史飞跃，",
    "start": 29.535,
    "end": 33.277,
    "duration": 3.742
  },
  {
    "id": 9,
    "text": "为中国现代文学奠定了深沉的启蒙精神基因。",
    "start": 33.497,
    "end": 37.117,
    "duration": 3.62
  },
  {
    "id": 10,
    "text": "首先，在历史发生上，文学革命是近代社会变革与思想启蒙浪潮汇聚的必然产物。",
    "start": 37.467,
    "end": 43.947,
    "duration": 6.48
  },
  {
    "id": 11,
    "text": "晚清时期的诗界革命、文界革命与小说界革命拉开了文学变革的序幕。",
    "start": 44.267,
    "end": 50.107,
    "duration": 5.84
  },
  {
    "id": 12,
    "text": "辛亥革命推翻帝制与现代学堂的建立，",
    "start": 50.107,
    "end": 53.147,
    "duration": 3.04
  },
  {
    "id": 13,
    "text": "孕育出具有独立启蒙意识的现代知识分子群体。",
    "start": 53.147,
    "end": 57.227,
    "duration": 4.08
  },
  {
    "id": 14,
    "text": "以《新青年》为核心阵地，文学革命高举民主与科学的两大旗帜。",
    "start": 57.227,
    "end": 62.187,
    "duration": 4.96
  },
  {
    "id": 15,
    "text": "一九一七年胡适发表《文学改良刍议》，",
    "start": 62.187,
    "end": 65.627,
    "duration": 3.44
  },
  {
    "id": 16,
    "text": "从历史进化论出发提出八事主张，温和持重地发难。",
    "start": 65.627,
    "end": 69.787,
    "duration": 4.16
  },
  {
    "id": 17,
    "text": "陈独秀紧接着发表《文学革命论》，",
    "start": 70.027,
    "end": 72.667,
    "duration": 2.64
  },
  {
    "id": 18,
    "text": "旗帜鲜明地提出三大主义，将旧文学定性为专制政体与封建国民性的温床。",
    "start": 72.667,
    "end": 79.227,
    "duration": 6.56
  },
  {
    "id": 19,
    "text": "面对林纾、学衡派与甲寅派的顽固抵抗，",
    "start": 79.227,
    "end": 83.067,
    "duration": 3.84
  },
  {
    "id": 20,
    "text": "先驱者在论战中破除了“文以载道”与游戏消遣的旧观念，",
    "start": 83.067,
    "end": 88.267,
    "duration": 5.2
  },
  {
    "id": 21,
    "text": "确立了新文学的历史合法性。",
    "start": 88.267,
    "end": 90.427,
    "duration": 2.16
  },
  {
    "id": 22,
    "text": "其次，在理论建设上，五四文学革命形成了“胡适立形式、",
    "start": 90.747,
    "end": 95.467,
    "duration": 4.72
  },
  {
    "id": 23,
    "text": "周作人立内容”的双重奠基。",
    "start": 95.467,
    "end": 97.627,
    "duration": 2.16
  },
  {
    "id": 24,
    "text": "文学革命具有鲜明的理论先行特征。",
    "start": 97.627,
    "end": 100.507,
    "duration": 2.88
  },
  {
    "id": 25,
    "text": "胡适致力于语言形式的根本解放。",
    "start": 100.507,
    "end": 102.907,
    "duration": 2.4
  },
  {
    "id": 26,
    "text": "他在《建设的文学革命论》中提出“国语的文学，",
    "start": 102.907,
    "end": 106.347,
    "duration": 3.44
  },
  {
    "id": 27,
    "text": "文学的国语”的宏伟构想，将文学语言改革升格为现代民族国家建构的文化战略。",
    "start": 106.347,
    "end": 112.747,
    "duration": 6.4
  },
  {
    "id": 28,
    "text": "周作人则在《人的文学》中奠定了新文学的思想灵魂。",
    "start": 112.987,
    "end": 117.067,
    "duration": 4.08
  },
  {
    "id": 29,
    "text": "他高扬人道主义大旗，强调以个人主义的人间本位重新发现人，",
    "start": 117.067,
    "end": 122.907,
    "duration": 5.84
  },
  {
    "id": 30,
    "text": "要求新文学必须真挚描写普通人的真实痛苦与灵肉一致的人性。",
    "start": 122.907,
    "end": 128.267,
    "duration": 5.36
  },
  {
    "id": 31,
    "text": "这种形式与内容的双重合璧，使新文学彻底摆脱了封建附庸地位，",
    "start": 128.267,
    "end": 133.707,
    "duration": 5.44
  },
  {
    "id": 32,
    "text": "确立了以人为主体的现代审美本位。",
    "start": 133.707,
    "end": 136.267,
    "duration": 2.56
  },
  {
    "id": 33,
    "text": "第三，在社团建设上，外来思潮的中国化催生了文学生力军的蜂起与两座高峰的对峙。",
    "start": 136.555,
    "end": 144.075,
    "duration": 7.52
  },
  {
    "id": 34,
    "text": "文学革命随后迅速由少数先驱的激进破坏转向大规模的社团自觉建设。",
    "start": 144.075,
    "end": 150.155,
    "duration": 6.08
  },
  {
    "id": 35,
    "text": "各种外国文艺思潮被创造性地中国化吸收。",
    "start": 150.155,
    "end": 153.675,
    "duration": 3.52
  },
  {
    "id": 36,
    "text": "一九二一年文学研究会与创造社的成立标志着新文学走向成熟。",
    "start": 153.675,
    "end": 158.955,
    "duration": 5.28
  },
  {
    "id": 37,
    "text": "文学研究会高扬“为人生”的现实主义旗帜，",
    "start": 159.195,
    "end": 162.555,
    "duration": 3.36
  },
  {
    "id": 38,
    "text": "注重对社会病态的实地观察与冷静解剖。",
    "start": 162.555,
    "end": 166.155,
    "duration": 3.6
  },
  {
    "id": 39,
    "text": "创造社高扬“为艺术”的浪漫主义旗帜，",
    "start": 166.155,
    "end": 169.115,
    "duration": 2.96
  },
  {
    "id": 40,
    "text": "主张直抒胸臆的自我表现与反抗旧世界的个性解放。",
    "start": 169.115,
    "end": 173.515,
    "duration": 4.4
  },
  {
    "id": 41,
    "text": "两社团虽在文学主张上各有侧重，却共同向封建旧文学发起猛攻，",
    "start": 173.515,
    "end": 179.355,
    "duration": 5.84
  },
  {
    "id": 42,
    "text": "形成了互相砥砺的双峰对峙格局，极大充实了新文学的队伍与阵地。",
    "start": 179.355,
    "end": 184.555,
    "duration": 5.2
  },
  {
    "id": 43,
    "text": "最后，在创作实践上，第一个十年的创作潮流展现出波澜壮阔的现代转型趋向。",
    "start": 184.875,
    "end": 191.915,
    "duration": 7.04
  },
  {
    "id": 44,
    "text": "文学革命不仅停留在宣言论争，更迅速转化为丰硕的艺术实绩。",
    "start": 191.915,
    "end": 197.595,
    "duration": 5.68
  },
  {
    "id": 45,
    "text": "创作潮流整体呈现出启蒙、感伤、个性化与多元方法四大趋向。",
    "start": 197.595,
    "end": 203.355,
    "duration": 5.76
  },
  {
    "id": 46,
    "text": "以鲁迅《狂人日记》与《阿Q正传》为标志，",
    "start": 203.355,
    "end": 206.475,
    "duration": 3.12
  },
  {
    "id": 47,
    "text": "新小说以极高的思想起点确立了现代反封建的批判力量。",
    "start": 206.475,
    "end": 211.195,
    "duration": 4.72
  },
  {
    "id": 48,
    "text": "郁达夫《沉沦》的大胆自叙传与郭沫若《女神》的自由奔涌，",
    "start": 211.435,
    "end": 215.995,
    "duration": 4.56
  },
  {
    "id": 49,
    "text": "展现了五四青年苏醒后的个性张力与历史青春期的感伤律动。",
    "start": 215.995,
    "end": 221.035,
    "duration": 5.04
  },
  {
    "id": 50,
    "text": "小说、散文小品、自由诗与现代话剧的全面丰收，",
    "start": 221.035,
    "end": 225.035,
    "duration": 4.0
  },
  {
    "id": 51,
    "text": "并在十年后期逐步向现实主义深度汇聚，",
    "start": 225.035,
    "end": 228.635,
    "duration": 3.6
  },
  {
    "id": 52,
    "text": "全面验证并丰富了文学革命的理论图纸。",
    "start": 228.635,
    "end": 231.515,
    "duration": 2.88
  },
  {
    "id": 53,
    "text": "综上所述，五四文学革命是一场触及民族精神灵魂的伟大文艺复兴。",
    "start": 231.755,
    "end": 237.515,
    "duration": 5.76
  },
  {
    "id": 54,
    "text": "它以语言工具的变革解放了思想的牢笼，",
    "start": 237.515,
    "end": 240.795,
    "duration": 3.28
  },
  {
    "id": 55,
    "text": "以“人的发现”重构了文学与人生的血肉关联，",
    "start": 240.795,
    "end": 244.475,
    "duration": 3.68
  },
  {
    "id": 56,
    "text": "是中国现代文学百年生生不息的最高精神源头。--",
    "start": 244.475,
    "end": 248.235,
    "duration": 3.76
  }
]