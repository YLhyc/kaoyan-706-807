[
  {
    "id": 1,
    "text": "试论五四文学革命的历史发生、理论建设与中国文学的现代转型。",
    "start": 0.16,
    "end": 5.407,
    "duration": 5.247
  },
  {
    "id": 2,
    "text": "五四文学革命是中国文学由古代跨入现代的历史分水岭。",
    "start": 5.831,
    "end": 10.342,
    "duration": 4.511
  },
  {
    "id": 3,
    "text": "它以五四新文化运动的思想启蒙为引擎，以白话文取代文言文为突破口，",
    "start": 10.619,
    "end": 16.158,
    "duration": 5.539
  },
  {
    "id": 4,
    "text": "以“人的文学”为精神内核，打破了数千年古典文学的独尊地位。",
    "start": 16.509,
    "end": 20.964,
    "duration": 4.455
  },
  {
    "id": 5,
    "text": "在现代报刊媒介与觉醒知识分子的推动下，",
    "start": 21.531,
    "end": 24.683,
    "duration": 3.152
  },
  {
    "id": 6,
    "text": "这场革命重塑了文学观念、语言工具、文体范式与主体精神，",
    "start": 25.139,
    "end": 29.984,
    "duration": 4.845
  },
  {
    "id": 7,
    "text": "为百年新文学铸造了启蒙思想基因。",
    "start": 30.441,
    "end": 33.121,
    "duration": 2.68
  },
  {
    "id": 8,
    "text": "其历史脉络与现代转型成就主要体现在以下四个方面：",
    "start": 33.745,
    "end": 38.075,
    "duration": 4.33
  },
  {
    "id": 9,
    "text": "第一，顺应近代历史变革潮流，形成由温和发难到激进论辩的破旧斗争链条。",
    "start": 38.737,
    "end": 45.347,
    "duration": 6.61
  },
  {
    "id": 10,
    "text": "五四文学革命是晚清以来诗界、文界与小说界革命积累而成的必然质变。",
    "start": 45.668,
    "end": 50.938,
    "duration": 5.27
  },
  {
    "id": 11,
    "text": "辛亥革命推翻帝制与现代学堂兴起，催生出具有独立反思意志的现代知识分子群体。",
    "start": 51.312,
    "end": 57.869,
    "duration": 6.557
  },
  {
    "id": 12,
    "text": "以《新青年》为核心阵地，先驱者高举民主与科学大旗：",
    "start": 58.1,
    "end": 62.309,
    "duration": 4.209
  },
  {
    "id": 13,
    "text": "胡适发表《文学改良刍议》，",
    "start": 62.714,
    "end": 64.968,
    "duration": 2.254
  },
  {
    "id": 14,
    "text": "从历史进化论出发提出“不用典、不作无病之呻吟”等八事主张，以温和审慎之态揭开序幕；",
    "start": 65.455,
    "end": 72.871,
    "duration": 7.416
  },
  {
    "id": 15,
    "text": "陈独秀发表《文学革命论》，打出“三大主义”大旗，",
    "start": 73.081,
    "end": 76.617,
    "duration": 3.536
  },
  {
    "id": 16,
    "text": "将旧文学定性为专制政体与封建国民性的温床，展开正面强攻。",
    "start": 76.899,
    "end": 82.115,
    "duration": 5.216
  },
  {
    "id": 17,
    "text": "面对林纾、学衡派与甲寅派等保守阵营的反扑，",
    "start": 82.254,
    "end": 86.148,
    "duration": 3.894
  },
  {
    "id": 18,
    "text": "先驱者在论争中击碎了“文以载道”与游戏消遣的旧秩序，确立了白话新文学的历史合法性。",
    "start": 86.281,
    "end": 93.444,
    "duration": 7.163
  },
  {
    "id": 19,
    "text": "第二，确立“胡适立形式、周作人立内容”的双重架构，奠定新文学的理论根基。",
    "start": 94.068,
    "end": 101.245,
    "duration": 7.177
  },
  {
    "id": 20,
    "text": "文学革命具有鲜明的“理论先行”特征，",
    "start": 101.712,
    "end": 104.537,
    "duration": 2.825
  },
  {
    "id": 21,
    "text": "胡适与周作人分别在形式媒介与思想灵魂两端奠定理论基石。",
    "start": 104.812,
    "end": 110.244,
    "duration": 5.432
  },
  {
    "id": 22,
    "text": "胡适致力于语言工具的解放，在《建设的文学革命论》中提出“国语的文学，文学的国语”，",
    "start": 110.799,
    "end": 117.893,
    "duration": 7.094
  },
  {
    "id": 23,
    "text": "将白话改革升格为现代民族国家建构的文化基石；",
    "start": 118.145,
    "end": 122.46,
    "duration": 4.315
  },
  {
    "id": 24,
    "text": "周作人在《人的文学》中确立了新文学的人道主义灵魂，",
    "start": 122.753,
    "end": 126.984,
    "duration": 4.231
  },
  {
    "id": 25,
    "text": "倡导以“个人主义的人间本位”重新发现人，",
    "start": 127.318,
    "end": 130.722,
    "duration": 3.404
  },
  {
    "id": 26,
    "text": "要求文学如实表现普通人的痛苦与灵肉一致的人性。",
    "start": 131.095,
    "end": 135.189,
    "duration": 4.094
  },
  {
    "id": 27,
    "text": "形式与内容的双重合璧，使新文学挣脱封建经学的附庸地位，",
    "start": 135.471,
    "end": 140.381,
    "duration": 4.91
  },
  {
    "id": 28,
    "text": "确立了以人的解放为目的的独立审美本体。",
    "start": 140.453,
    "end": 143.682,
    "duration": 3.229
  },
  {
    "id": 29,
    "text": "第三，吸纳多元外国文艺思潮，催生新文学社团蜂起与双峰对峙格局。",
    "start": 144.354,
    "end": 150.808,
    "duration": 6.454
  },
  {
    "id": 30,
    "text": "文学革命迅速由激进破坏转向大规模的社团建设，",
    "start": 151.238,
    "end": 155.228,
    "duration": 3.99
  },
  {
    "id": 31,
    "text": "西方现实主义、浪漫主义与象征主义等思潮被中国化吸收。",
    "start": 155.551,
    "end": 160.091,
    "duration": 4.54
  },
  {
    "id": 32,
    "text": "文学研究会与创造社的崛起，标志着现代文学阵营走向成熟：",
    "start": 160.501,
    "end": 165.246,
    "duration": 4.745
  },
  {
    "id": 33,
    "text": "文学研究会高扬“为人生而艺术”的现实主义大旗，注重对社会病态与底层疾苦的写实剖析；",
    "start": 165.556,
    "end": 172.941,
    "duration": 7.385
  },
  {
    "id": 34,
    "text": "创造社高扬“为艺术而艺术”的浪漫主义旗帜，",
    "start": 173.373,
    "end": 176.807,
    "duration": 3.434
  },
  {
    "id": 35,
    "text": "强调主观直抒胸臆、个性张扬与反抗旧世界的狂飙激情。",
    "start": 177.174,
    "end": 181.949,
    "duration": 4.775
  },
  {
    "id": 36,
    "text": "两大社团各具侧重又相互砥砺，构成双峰对峙格局，充实了现代文学的生力军与体裁版图。",
    "start": 182.523,
    "end": 189.932,
    "duration": 7.409
  },
  {
    "id": 37,
    "text": "第四，转化丰硕艺术实绩，开辟启蒙感伤与现代文体多元探索的创作潮流。",
    "start": 190.546,
    "end": 197.191,
    "duration": 6.645
  },
  {
    "id": 38,
    "text": "文学革命在第一个十年内迅速转化为丰硕的艺术实绩，",
    "start": 197.945,
    "end": 201.966,
    "duration": 4.021
  },
  {
    "id": 39,
    "text": "呈现出启蒙、感伤、个性化与多元方法等鲜明特征。",
    "start": 202.5,
    "end": 207.083,
    "duration": 4.583
  },
  {
    "id": 40,
    "text": "以鲁迅《狂人日记》与《阿Q正传》为标志，",
    "start": 207.588,
    "end": 210.49,
    "duration": 2.902
  },
  {
    "id": 41,
    "text": "中国现代小说起步便站在现代哲学与国民性解剖的思想高地；",
    "start": 210.735,
    "end": 215.703,
    "duration": 4.968
  },
  {
    "id": 42,
    "text": "郁达夫《沉沦》的自叙传坦陈与郭沫若《女神》的自由奔涌，",
    "start": 216.23,
    "end": 220.563,
    "duration": 4.333
  },
  {
    "id": 43,
    "text": "度量了现代青年觉醒后的个性张力与时代感伤律动。",
    "start": 220.563,
    "end": 224.696,
    "duration": 4.133
  },
  {
    "id": 44,
    "text": "小说、散文小品、自由新诗与现代话剧的成熟，验证并丰富了文学革命的理论蓝图。",
    "start": 224.942,
    "end": 231.757,
    "duration": 6.815
  },
  {
    "id": 45,
    "text": "从现代文学史演进来看，五四文学革命是一场触及中华民族精神灵魂的伟大文艺革新。",
    "start": 232.383,
    "end": 239.168,
    "duration": 6.785
  },
  {
    "id": 46,
    "text": "它以语言工具的革命打破了思维桎梏，以“人的发现”重构了文学与人生的血肉纽带，",
    "start": 239.587,
    "end": 245.843,
    "duration": 6.256
  },
  {
    "id": 47,
    "text": "确立了中国现代文学百年来生生不息的精神源头。",
    "start": 246.066,
    "end": 249.819,
    "duration": 3.753
  }
]