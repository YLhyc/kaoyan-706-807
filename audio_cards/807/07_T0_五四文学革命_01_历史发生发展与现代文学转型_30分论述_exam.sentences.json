[
  {
    "id": 1,
    "text": "试论五四文学革命的历史发生、理论建设与中国文学的现代转型。",
    "start": 0.16,
    "end": 5.407,
    "duration": 5.247
  },
  {
    "id": 2,
    "text": "五四文学革命是中国文学由古代跨入现代的历史分水岭。",
    "start": 5.907,
    "end": 10.418,
    "duration": 4.511
  },
  {
    "id": 3,
    "text": "它以五四新文化运动的思想启蒙为引擎，以白话文取代文言文为突破口，",
    "start": 10.918,
    "end": 16.457,
    "duration": 5.539
  },
  {
    "id": 4,
    "text": "以“人的文学”为精神内核，打破了数千年古典文学的独尊地位。",
    "start": 16.808,
    "end": 21.263,
    "duration": 4.455
  },
  {
    "id": 5,
    "text": "在现代报刊媒介与觉醒知识分子的推动下，这场革命重塑了文学观念、语言工具、文体范式与主体精神，",
    "start": 21.83,
    "end": 30.283,
    "duration": 8.453
  },
  {
    "id": 6,
    "text": "为百年新文学铸造了启蒙思想基因。",
    "start": 30.74,
    "end": 33.42,
    "duration": 2.68
  },
  {
    "id": 7,
    "text": "其历史脉络与现代转型成就主要体现在以下四个方面：",
    "start": 34.044,
    "end": 38.374,
    "duration": 4.33
  },
  {
    "id": 8,
    "text": "第一，顺应近代历史变革潮流，形成由温和发难到激进论辩的破旧斗争链条。",
    "start": 39.036,
    "end": 45.646,
    "duration": 6.61
  },
  {
    "id": 9,
    "text": "五四文学革命是晚清以来诗界、文界与小说界革命积累而成的必然质变。",
    "start": 46.146,
    "end": 51.416,
    "duration": 5.27
  },
  {
    "id": 10,
    "text": "辛亥革命推翻帝制与现代学堂兴起，催生出具有独立反思意志的现代知识分子群体。",
    "start": 51.916,
    "end": 58.473,
    "duration": 6.557
  },
  {
    "id": 11,
    "text": "以《新青年》为核心阵地，先驱者高举民主与科学大旗：胡适发表《文学改良刍议》，",
    "start": 58.973,
    "end": 65.841,
    "duration": 6.868
  },
  {
    "id": 12,
    "text": "从历史进化论出发提出“不用典、不作无病之呻吟”等八事主张，以温和审慎之态揭开序幕；",
    "start": 66.328,
    "end": 73.744,
    "duration": 7.416
  },
  {
    "id": 13,
    "text": "陈独秀发表《文学革命论》，打出“三大主义”大旗，",
    "start": 74.244,
    "end": 77.78,
    "duration": 3.536
  },
  {
    "id": 14,
    "text": "将旧文学定性为专制政体与封建国民性的温床，展开正面强攻。",
    "start": 78.13,
    "end": 83.346,
    "duration": 5.216
  },
  {
    "id": 15,
    "text": "面对林纾、学衡派与甲寅派等保守阵营的反扑，",
    "start": 83.846,
    "end": 87.74,
    "duration": 3.894
  },
  {
    "id": 16,
    "text": "先驱者在论争中击碎了“文以载道”与游戏消遣的旧秩序，确立了白话新文学的历史合法性。",
    "start": 88.09,
    "end": 95.253,
    "duration": 7.163
  },
  {
    "id": 17,
    "text": "第二，确立“胡适立形式、周作人立内容”的双重架构，奠定新文学的理论根基。",
    "start": 95.877,
    "end": 103.054,
    "duration": 7.177
  },
  {
    "id": 18,
    "text": "文学革命具有鲜明的“理论先行”特征，",
    "start": 103.554,
    "end": 106.379,
    "duration": 2.825
  },
  {
    "id": 19,
    "text": "胡适与周作人分别在形式媒介与思想灵魂两端奠定理论基石。",
    "start": 106.729,
    "end": 112.161,
    "duration": 5.432
  },
  {
    "id": 20,
    "text": "胡适致力于语言工具的解放，在《建设的文学革命论》中提出“国语的文学，文学的国语”，",
    "start": 112.742,
    "end": 119.81,
    "duration": 7.068
  },
  {
    "id": 21,
    "text": "将白话改革升格为现代民族国家建构的文化基石；",
    "start": 120.16,
    "end": 124.475,
    "duration": 4.315
  },
  {
    "id": 22,
    "text": "周作人在《人的文学》中确立了新文学的人道主义灵魂，",
    "start": 124.975,
    "end": 129.206,
    "duration": 4.231
  },
  {
    "id": 23,
    "text": "倡导以“个人主义的人间本位”重新发现人，要求文学如实表现普通人的痛苦与灵肉一致的人性。",
    "start": 129.556,
    "end": 137.427,
    "duration": 7.871
  },
  {
    "id": 24,
    "text": "形式与内容的双重合璧，使新文学挣脱封建经学的附庸地位，",
    "start": 137.927,
    "end": 142.614,
    "duration": 4.687
  },
  {
    "id": 25,
    "text": "确立了以人的解放为目的的独立审美本体。",
    "start": 142.964,
    "end": 146.19,
    "duration": 3.226
  },
  {
    "id": 26,
    "text": "第三，吸纳多元外国文艺思潮，催生新文学社团蜂起与双峰对峙格局。",
    "start": 146.862,
    "end": 153.316,
    "duration": 6.454
  },
  {
    "id": 27,
    "text": "文学革命迅速由激进破坏转向大规模的社团建设，",
    "start": 153.816,
    "end": 157.806,
    "duration": 3.99
  },
  {
    "id": 28,
    "text": "西方现实主义、浪漫主义与象征主义等思潮被中国化吸收。",
    "start": 158.156,
    "end": 162.696,
    "duration": 4.54
  },
  {
    "id": 29,
    "text": "文学研究会与创造社的崛起，标志着现代文学阵营走向成熟：",
    "start": 163.196,
    "end": 167.941,
    "duration": 4.745
  },
  {
    "id": 30,
    "text": "文学研究会高扬“为人生而艺术”的现实主义大旗，注重对社会病态与底层疾苦的写实剖析；",
    "start": 168.291,
    "end": 175.676,
    "duration": 7.385
  },
  {
    "id": 31,
    "text": "创造社高扬“为艺术而艺术”的浪漫主义旗帜，",
    "start": 176.176,
    "end": 179.61,
    "duration": 3.434
  },
  {
    "id": 32,
    "text": "强调主观直抒胸臆、个性张扬与反抗旧世界的狂飙激情。",
    "start": 179.977,
    "end": 184.752,
    "duration": 4.775
  },
  {
    "id": 33,
    "text": "两大社团各具侧重又相互砥砺，构成双峰对峙格局，充实了现代文学的生力军与体裁版图。",
    "start": 185.326,
    "end": 192.735,
    "duration": 7.409
  },
  {
    "id": 34,
    "text": "第四，转化丰硕艺术实绩，开辟启蒙感伤与现代文体多元探索的创作潮流。",
    "start": 193.349,
    "end": 199.994,
    "duration": 6.645
  },
  {
    "id": 35,
    "text": "文学革命在第一个十年内迅速转化为丰硕的艺术实绩，",
    "start": 200.748,
    "end": 204.769,
    "duration": 4.021
  },
  {
    "id": 36,
    "text": "呈现出启蒙、感伤、个性化与多元方法等鲜明特征。",
    "start": 205.303,
    "end": 209.886,
    "duration": 4.583
  },
  {
    "id": 37,
    "text": "以鲁迅《狂人日记》与《阿Q正传》为标志，中国现代小说起步便站在现代哲学与国民性解剖的思想高地；",
    "start": 210.391,
    "end": 218.506,
    "duration": 8.115
  },
  {
    "id": 38,
    "text": "郁达夫《沉沦》的自叙传坦陈与郭沫若《女神》的自由奔涌，",
    "start": 219.033,
    "end": 223.12,
    "duration": 4.087
  },
  {
    "id": 39,
    "text": "度量了现代青年觉醒后的个性张力与时代感伤律动。",
    "start": 223.56,
    "end": 227.499,
    "duration": 3.939
  },
  {
    "id": 40,
    "text": "小说、散文小品、自由新诗与现代话剧的成熟，验证并丰富了文学革命的理论蓝图。",
    "start": 227.999,
    "end": 234.814,
    "duration": 6.815
  },
  {
    "id": 41,
    "text": "从现代文学史演进来看，五四文学革命是一场触及中华民族精神灵魂的伟大文艺革新。",
    "start": 235.44,
    "end": 242.225,
    "duration": 6.785
  },
  {
    "id": 42,
    "text": "它以语言工具的革命打破了思维桎梏，以“人的发现”重构了文学与人生的血肉纽带，",
    "start": 242.725,
    "end": 248.981,
    "duration": 6.256
  },
  {
    "id": 43,
    "text": "确立了中国现代文学百年来生生不息的精神源头。",
    "start": 249.331,
    "end": 253.084,
    "duration": 3.753
  }
]
