[
  {
    "id": 1,
    "text": "新月诗派是中国现代文学史上极具规范意识与美学自觉的现代诗歌流派。",
    "start": 0.16,
    "end": 6.56,
    "duration": 6.4
  },
  {
    "id": 2,
    "text": "针对五四早期白话新诗过于散文化与粗糙直白的弊端，",
    "start": 6.56,
    "end": 11.12,
    "duration": 4.56
  },
  {
    "id": 3,
    "text": "闻一多与徐志摩等诗人提出了系统的新格律诗理论。",
    "start": 11.12,
    "end": 15.12,
    "duration": 4.0
  },
  {
    "id": 4,
    "text": "他们确立了“戴着镣靠跳舞”的创作法则，",
    "start": 15.12,
    "end": 18.16,
    "duration": 3.04
  },
  {
    "id": 5,
    "text": "以形式的节制拯救了早期新诗的文体危机。",
    "start": 18.16,
    "end": 21.44,
    "duration": 3.28
  },
  {
    "id": 6,
    "text": "首先，新月派的核心理论基石是闻一多提出的“三美”主张，",
    "start": 21.84,
    "end": 26.72,
    "duration": 4.88
  },
  {
    "id": 7,
    "text": "即音乐美、绘画美与建筑美。",
    "start": 26.72,
    "end": 29.76,
    "duration": 3.04
  },
  {
    "id": 8,
    "text": "在音乐美上，他们强调音尺的整齐与节拍的律动，",
    "start": 29.76,
    "end": 34.24,
    "duration": 4.48
  },
  {
    "id": 9,
    "text": "主张根据现代汉语本身的音调寻求内在和谐，",
    "start": 34.24,
    "end": 38.08,
    "duration": 3.84
  },
  {
    "id": 10,
    "text": "反对杂乱无章的散漫自由。",
    "start": 38.08,
    "end": 40.48,
    "duration": 2.4
  },
  {
    "id": 11,
    "text": "在绘画美上，他们注重辞藻的选择与意象的色彩造型，",
    "start": 40.48,
    "end": 45.28,
    "duration": 4.8
  },
  {
    "id": 12,
    "text": "追求诗画相通的视觉美感。",
    "start": 45.28,
    "end": 47.44,
    "duration": 2.16
  },
  {
    "id": 13,
    "text": "在建筑美上，他们追求节的匀称与句的均齐，",
    "start": 47.68,
    "end": 51.6,
    "duration": 3.92
  },
  {
    "id": 14,
    "text": "要求排版外形具备严谨的对称结构与形式秩序。",
    "start": 51.6,
    "end": 56.0,
    "duration": 4.4
  },
  {
    "id": 15,
    "text": "其次，在艺术实践中，新月派诗人展现了高度成熟的文体实验品格。",
    "start": 56.0,
    "end": 61.84,
    "duration": 5.84
  },
  {
    "id": 16,
    "text": "闻一多的《死水》是建筑美与以美显丑反讽的典范之作。",
    "start": 61.84,
    "end": 66.64,
    "duration": 4.8
  },
  {
    "id": 17,
    "text": "全诗每节四句，每句九字，音尺整赤如同坚固的豆腐块，",
    "start": 66.64,
    "end": 71.92,
    "duration": 5.28
  },
  {
    "id": 18,
    "text": "以绚烂浓郁的辞藻反衬出现实深沉的绝望腐烂。",
    "start": 71.92,
    "end": 76.16,
    "duration": 4.24
  },
  {
    "id": 19,
    "text": "徐志摩的《再别康桥》则是音乐美的化境。",
    "start": 76.48,
    "end": 80.08,
    "duration": 3.6
  },
  {
    "id": 20,
    "text": "全诗轻盈流转，回环复沓，将离别愁绪化作流动的韵律，",
    "start": 80.08,
    "end": 85.52,
    "duration": 5.44
  },
  {
    "id": 21,
    "text": "实现了理性节制与丰沛情感的完美融合。",
    "start": 85.52,
    "end": 89.28,
    "duration": 3.76
  },
  {
    "id": 22,
    "text": "最后，新月诗派的格律化探索确立了中国现代新诗的审美自足性。",
    "start": 89.28,
    "end": 94.96,
    "duration": 5.68
  },
  {
    "id": 23,
    "text": "他们扭转了早期白话诗非诗化的流弊，",
    "start": 94.96,
    "end": 98.4,
    "duration": 3.44
  },
  {
    "id": 24,
    "text": "推动新诗从破坏旧格律走向自觉建设新规范，",
    "start": 98.4,
    "end": 102.8,
    "duration": 4.4
  },
  {
    "id": 25,
    "text": "在现代诗歌史上树立了兼具形式理性与艺术纯度的经典范式。",
    "start": 102.8,
    "end": 108.4,
    "duration": 5.6
  },
  {
    "id": 26,
    "text": "--",
    "start": 108.4,
    "end": 108.48,
    "duration": 0.08
  }
]