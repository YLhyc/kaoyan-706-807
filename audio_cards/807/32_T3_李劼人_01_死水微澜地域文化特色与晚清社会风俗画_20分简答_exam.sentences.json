[
  {
    "id": 1,
    "text": "三十年代中期，李劼人发表《死水微澜》，作为其“大河小说”三部曲的开山之作，",
    "start": 0.12,
    "end": 5.894,
    "duration": 5.774
  },
  {
    "id": 2,
    "text": "生动再现了晚清中西碰撞在四川内陆激起的历史波澜。",
    "start": 6.264,
    "end": 10.269,
    "duration": 4.005
  },
  {
    "id": 3,
    "text": "郭沫若赞誉李劼人为“中国的左拉”，",
    "start": 10.789,
    "end": 13.293,
    "duration": 2.504
  },
  {
    "id": 4,
    "text": "其小说的地域文化特色与社会风俗描摹主要体现于以下三个方面：",
    "start": 13.663,
    "end": 18.652,
    "duration": 4.989
  },
  {
    "id": 5,
    "text": "第一，铺陈浓郁的巴蜀地域风俗，展现晚清内陆社会的风貌全景。",
    "start": 19.288,
    "end": 24.517,
    "duration": 5.229
  },
  {
    "id": 6,
    "text": "小说以成都近郊天回镇为舞台，细致描摹了甲午战争至《辛丑条约》签订前后四川乡镇封闭滞重的生活形态。",
    "start": 25.037,
    "end": 33.845,
    "duration": 8.808
  },
  {
    "id": 7,
    "text": "作者娴熟运用地道的四川方言俚语，",
    "start": 34.365,
    "end": 36.926,
    "duration": 2.561
  },
  {
    "id": 8,
    "text": "细腻再现了茶馆吃茶摆龙门阵、赶场庙会、袍哥开堂拜码头及民间婚丧嫁娶等生活细节，",
    "start": 37.296,
    "end": 44.604,
    "duration": 7.308
  },
  {
    "id": 9,
    "text": "勾勒出一幅气韵生动、原汁原味的晚清川西民俗画卷。",
    "start": 44.974,
    "end": 49.385,
    "duration": 4.411
  },
  {
    "id": 10,
    "text": "第二，塑造泼辣敢为的底层女性典型，展现冲破礼教成规的生命活力。",
    "start": 49.992,
    "end": 55.847,
    "duration": 5.855
  },
  {
    "id": 11,
    "text": "女主人公邓幺姑（蔡大嫂）不同于传统闺秀的温顺隐忍，",
    "start": 56.403,
    "end": 60.858,
    "duration": 4.455
  },
  {
    "id": 12,
    "text": "她美丽泼辣、精明能干，渴望富足体面的生活。",
    "start": 61.246,
    "end": 65.081,
    "duration": 3.835
  },
  {
    "id": 13,
    "text": "嫁给天回镇杂货铺老板蔡兴顺后，面对庸懦木讷的丈夫，",
    "start": 65.706,
    "end": 70.44,
    "duration": 4.734
  },
  {
    "id": 14,
    "text": "她毫无忌惮地与蔡兴顺的表兄、袍哥头目罗歪嘴大胆相恋；",
    "start": 70.81,
    "end": 75.537,
    "duration": 4.727
  },
  {
    "id": 15,
    "text": "当罗歪嘴因得罪洋教潜逃败落后，她为保全家庭与自身尊严，",
    "start": 76.068,
    "end": 80.925,
    "duration": 4.857
  },
  {
    "id": 16,
    "text": "果断转嫁投靠教会势力的粮户顾天成，呈现出鲜明复杂的女性生命活力。",
    "start": 81.295,
    "end": 87.639,
    "duration": 6.344
  },
  {
    "id": 17,
    "text": "第三，白描中西势力碰撞的历史漩涡，解剖时代巨变前的“死水”微澜。",
    "start": 88.304,
    "end": 94.0,
    "duration": 5.696
  },
  {
    "id": 18,
    "text": "小说通过罗歪嘴代表的袍哥民间帮会、蔡兴顺代表的小镇商人，",
    "start": 94.52,
    "end": 100.127,
    "duration": 5.607
  },
  {
    "id": 19,
    "text": "以及顾天成由受欺辱到勾结洋教作威作福的曲折蜕变，真实折射出西方殖民势力渗入内陆后引发的阶层分化与社会震荡，",
    "start": 100.587,
    "end": 111.103,
    "duration": 10.516
  },
  {
    "id": 20,
    "text": "深刻呈现出晚清社会表面如死水般沉寂、内里暗流涌动的历史真实。",
    "start": 111.473,
    "end": 117.27,
    "duration": 5.797
  }
]