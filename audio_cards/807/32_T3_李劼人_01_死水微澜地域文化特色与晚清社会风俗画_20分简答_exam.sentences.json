[
  {
    "id": 1,
    "text": "三十年代中期，李劼人发表《死水微澜》，作为其“大河小说”三部曲的开山之作，",
    "start": 0.134,
    "end": 5.986,
    "duration": 5.852
  },
  {
    "id": 2,
    "text": "生动再现了晚清中西碰撞在四川内陆激起的历史波澜。",
    "start": 6.61,
    "end": 10.742,
    "duration": 4.132
  },
  {
    "id": 3,
    "text": "郭沫若赞誉李劼人为“中国的左拉”，",
    "start": 11.42,
    "end": 13.792,
    "duration": 2.372
  },
  {
    "id": 4,
    "text": "其小说的地域文化特色与社会风俗描摹主要体现于以下三个方面：",
    "start": 14.171,
    "end": 18.823,
    "duration": 4.652
  },
  {
    "id": 5,
    "text": "第一，铺陈浓郁的巴蜀地域风俗，展现晚清内陆社会的风貌全景。",
    "start": 19.501,
    "end": 24.753,
    "duration": 5.252
  },
  {
    "id": 6,
    "text": "小说以成都近郊天回镇为舞台，细致描摹了甲午战争至《辛丑条约》签订前后四川乡镇封闭滞重的生活形态。",
    "start": 25.431,
    "end": 33.923,
    "duration": 8.492
  },
  {
    "id": 7,
    "text": "作者娴熟运用地道的四川方言俚语，",
    "start": 34.601,
    "end": 37.053,
    "duration": 2.452
  },
  {
    "id": 8,
    "text": "细腻再现了茶馆吃茶摆龙门阵、赶场庙会、袍哥开堂拜码头及民间婚丧嫁娶等生活细节，",
    "start": 37.432,
    "end": 45.084,
    "duration": 7.652
  },
  {
    "id": 9,
    "text": "勾勒出一幅气韵生动、原汁原味的晚清川西民俗画卷。",
    "start": 45.472,
    "end": 49.484,
    "duration": 4.012
  },
  {
    "id": 10,
    "text": "第二，塑造泼辣敢为的底层女性典型，展现冲破礼教成规的生命活力。",
    "start": 50.162,
    "end": 55.854,
    "duration": 5.692
  },
  {
    "id": 11,
    "text": "女主人公邓幺姑（蔡大嫂）不同于传统闺秀的温顺隐忍，",
    "start": 56.492,
    "end": 60.424,
    "duration": 3.932
  },
  {
    "id": 12,
    "text": "她美丽泼辣、精明能干，渴望富足体面的生活。",
    "start": 60.803,
    "end": 64.215,
    "duration": 3.412
  },
  {
    "id": 13,
    "text": "嫁给天回镇杂货铺老板蔡兴顺后，面对庸懦木讷的丈夫，",
    "start": 64.893,
    "end": 69.265,
    "duration": 4.372
  },
  {
    "id": 14,
    "text": "她毫无忌惮地与蔡兴顺的表兄、袍哥头目罗歪嘴大胆相恋；",
    "start": 69.644,
    "end": 73.896,
    "duration": 4.252
  },
  {
    "id": 15,
    "text": "当罗歪嘴因得罪洋教潜逃败落后，她为保全家庭与自身尊严，",
    "start": 74.534,
    "end": 79.426,
    "duration": 4.892
  },
  {
    "id": 16,
    "text": "果断转嫁投靠教会势力的粮户顾天成，呈现出鲜明复杂的女性生命活力。",
    "start": 79.805,
    "end": 85.697,
    "duration": 5.892
  },
  {
    "id": 17,
    "text": "第三，白描中西势力碰撞的历史漩涡，解剖时代巨变前的“死水”微澜。",
    "start": 86.375,
    "end": 91.467,
    "duration": 5.092
  },
  {
    "id": 18,
    "text": "小说通过罗歪嘴代表的袍哥民间帮会、蔡兴顺代表的小镇商人，",
    "start": 92.225,
    "end": 97.277,
    "duration": 5.052
  },
  {
    "id": 19,
    "text": "以及顾天成由受欺辱到勾结洋教作威作福的曲折蜕变，真实折射出西方殖民势力渗入内陆后引发的阶层分化与社会震荡，",
    "start": 97.656,
    "end": 107.953,
    "duration": 10.297
  },
  {
    "id": 20,
    "text": "深刻呈现出晚清社会表面如死水般沉寂、内里暗流涌动的历史真实。",
    "start": 108.332,
    "end": 114.104,
    "duration": 5.772
  }
]