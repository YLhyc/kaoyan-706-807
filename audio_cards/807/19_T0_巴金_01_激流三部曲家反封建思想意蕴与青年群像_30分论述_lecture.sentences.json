[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 3.28,
    "duration": 3.2
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 3.28,
    "end": 6.16,
    "duration": 2.88
  },
  {
    "id": 3,
    "text": "这道题考查巴金的成名史诗《家》。",
    "start": 6.24,
    "end": 9.12,
    "duration": 2.88
  },
  {
    "id": 4,
    "text": "在考场上，考生不能只把小说当作讲苦难故事，",
    "start": 9.12,
    "end": 13.04,
    "duration": 3.92
  },
  {
    "id": 5,
    "text": "而必须紧扣“反封建思想意蕴（礼教杀人）”与“青年群像（觉新妥协versus觉慧叛逆）”两大题眼。",
    "start": 13.04,
    "end": 20.96,
    "duration": 7.92
  },
  {
    "id": 6,
    "text": "核心在于回答：巴金如何通过典型惨剧揭穿封建礼教的杀人本质，",
    "start": 21.28,
    "end": 26.72,
    "duration": 5.44
  },
  {
    "id": 7,
    "text": "又如何通过兄弟两人的性格分流展现时代觉醒的必然性。",
    "start": 26.72,
    "end": 31.44,
    "duration": 4.72
  },
  {
    "id": 8,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 31.44,
    "end": 34.4,
    "duration": 2.96
  },
  {
    "id": 9,
    "text": "答题必须确立“思想批判深度、趋近于、",
    "start": 34.4,
    "end": 37.68,
    "duration": 3.28
  },
  {
    "id": 10,
    "text": "典型人物性格对照、趋近于、抒情艺术风格”的三维推进逻辑。",
    "start": 37.68,
    "end": 42.08,
    "duration": 4.4
  },
  {
    "id": 11,
    "text": "先聚焦鸣凤投湖、梅表姐病亡、瑞珏血光之灾三大名场面剖析礼教杀人机制，",
    "start": 42.48,
    "end": 49.6,
    "duration": 7.12
  },
  {
    "id": 12,
    "text": "次深度解剖觉新的“作揖主义”与觉慧的“出走反叛”，",
    "start": 49.6,
    "end": 53.92,
    "duration": 4.32
  },
  {
    "id": 13,
    "text": "最后升华巴金激昂热烈的青春史诗品格。",
    "start": 53.92,
    "end": 57.6,
    "duration": 3.68
  },
  {
    "id": 14,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 57.6,
    "end": 60.48,
    "duration": 2.88
  },
  {
    "id": 15,
    "text": "全题分为四个核心论述维度：-第一维度：界定《家》作为现代反封建宗法制度抒情史诗的文学史坐标；",
    "start": 60.48,
    "end": 69.294,
    "duration": 8.814
  },
  {
    "id": 16,
    "text": "-第二维度：深入剖析封建家长专制与“礼教杀人”的三大典型悲剧（鸣凤、",
    "start": 69.294,
    "end": 75.787,
    "duration": 6.493
  },
  {
    "id": 17,
    "text": "梅、瑞珏之死）；",
    "start": 75.787,
    "end": 76.947,
    "duration": 1.16
  },
  {
    "id": 18,
    "text": "-第三维度：精细对比青年知识分子群像，",
    "start": 76.947,
    "end": 80.658,
    "duration": 3.711
  },
  {
    "id": 19,
    "text": "深刻剖析觉新妥协自枪与觉慧决绝叛逆的灵魂碰撞；",
    "start": 80.658,
    "end": 85.76,
    "duration": 5.102
  },
  {
    "id": 20,
    "text": "第四维度：精准概括浓烈激越的青春抒情笔调与现实主义家族写实的艺术融合；",
    "start": 85.84,
    "end": 93.04,
    "duration": 7.2
  },
  {
    "id": 21,
    "text": "第五维度：宏观总结作品在埋葬旧体制、",
    "start": 93.04,
    "end": 96.64,
    "duration": 3.6
  },
  {
    "id": 22,
    "text": "启迪青年个性解放上的划时代定论。",
    "start": 96.64,
    "end": 99.6,
    "duration": 2.96
  },
  {
    "id": 23,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 99.6,
    "end": 103.68,
    "duration": 4.08
  },
  {
    "id": 24,
    "text": "全题逻辑严密咬合：第一步先确立反封建最高史诗的历史地位。",
    "start": 103.68,
    "end": 109.12,
    "duration": 5.44
  },
  {
    "id": 25,
    "text": "第二步展开客体批判，揭露封建家长制如何通过礼教吞噬女性生命。",
    "start": 109.28,
    "end": 115.44,
    "duration": 6.16
  },
  {
    "id": 26,
    "text": "第三步剖析面对这种杀人环境，新一代青年主体产生的不同性格反应（妥协与抗争）。",
    "start": 115.44,
    "end": 122.32,
    "duration": 6.88
  },
  {
    "id": 27,
    "text": "第四步剖析传达这种热烈思想的艺术语言特征。",
    "start": 122.32,
    "end": 126.32,
    "duration": 4.0
  },
  {
    "id": 28,
    "text": "第五步完成宏观历史论证闭环。",
    "start": 126.32,
    "end": 128.8,
    "duration": 2.48
  },
  {
    "id": 29,
    "text": "二、各板块逐句咬合演练。",
    "start": 129.28,
    "end": 132.16,
    "duration": 2.88
  },
  {
    "id": 30,
    "text": "一、开头破题段内部咬合。",
    "start": 132.16,
    "end": 134.48,
    "duration": 2.32
  },
  {
    "id": 31,
    "text": "本段旨在开门见山确立反封建抒情史诗的立论基石。",
    "start": 134.48,
    "end": 139.28,
    "duration": 4.8
  },
  {
    "id": 32,
    "text": "首句直切经典地位，次句交代高家堡垒瓦解与反叛进军号角。",
    "start": 139.28,
    "end": 144.32,
    "duration": 5.04
  },
  {
    "id": 33,
    "text": "-首先，首句必须直接亮出该作在现代文学史上的崇高地位，",
    "start": 144.528,
    "end": 149.339,
    "duration": 4.811
  },
  {
    "id": 34,
    "text": "具体表述到答题语句就是：巴金所著的长篇小说《家》是其长篇巨制《激流三部曲》的开篇与代表作，",
    "start": 149.339,
    "end": 157.156,
    "duration": 7.817
  },
  {
    "id": 35,
    "text": "也是中国现代文学史上控诉封建宗法家族制度最强烈的抒情史诗。",
    "start": 157.156,
    "end": 162.768,
    "duration": 5.612
  },
  {
    "id": 36,
    "text": "-有了经典定性之后，次句必须迅速说明其生活原型与时代价值，",
    "start": 162.768,
    "end": 167.568,
    "duration": 4.8
  },
  {
    "id": 37,
    "text": "具体表述到答题语句就是：巴金以自身生活经历为原型，",
    "start": 167.568,
    "end": 171.814,
    "duration": 4.246
  },
  {
    "id": 38,
    "text": "通过成都高公馆这一封建堡垒的瓦解过程，",
    "start": 171.814,
    "end": 175.137,
    "duration": 3.323
  },
  {
    "id": 39,
    "text": "深刻揭露了封建家长专制与陈腐礼教对年轻生命的残酷摧残，",
    "start": 175.137,
    "end": 179.937,
    "duration": 4.8
  },
  {
    "id": 40,
    "text": "热情欧歌了五四新青年的叛逆觉醒，",
    "start": 179.937,
    "end": 182.706,
    "duration": 2.769
  },
  {
    "id": 41,
    "text": "吹响了埋葬封建宗法制度的时代进军号角。，",
    "start": 182.706,
    "end": 186.03,
    "duration": 3.324
  },
  {
    "id": 42,
    "text": "这句话直接铺展开全篇思想与人物两翼。",
    "start": 186.03,
    "end": 189.168,
    "duration": 3.138
  },
  {
    "id": 43,
    "text": "巴金所著的长篇小说《家》是其长篇巨制《激流三部曲》的开篇与代表作，",
    "start": 189.248,
    "end": 194.848,
    "duration": 5.6
  },
  {
    "id": 44,
    "text": "也是中国现代文学史上控诉封建宗法家族制度最强烈的抒情史诗。",
    "start": 194.848,
    "end": 200.528,
    "duration": 5.68
  },
  {
    "id": 45,
    "text": "巴金以自身生活经历为原型，通过成都高公馆这一封建堡垒的瓦解过程，",
    "start": 200.528,
    "end": 206.528,
    "duration": 6.0
  },
  {
    "id": 46,
    "text": "深刻揭露了封建家长专制与陈腐礼教对年轻生命的残酷摧残，",
    "start": 206.528,
    "end": 211.888,
    "duration": 5.36
  },
  {
    "id": 47,
    "text": "热情欧歌了五四新青年的叛逆觉醒，",
    "start": 211.888,
    "end": 214.848,
    "duration": 2.96
  },
  {
    "id": 48,
    "text": "吹响了埋葬封建宗法制度的时代进军号角。",
    "start": 214.848,
    "end": 218.208,
    "duration": 3.36
  },
  {
    "id": 49,
    "text": "二、第一维度：封建宗法制度罪恶与礼教杀人意蕴内部咬合。",
    "start": 218.528,
    "end": 223.808,
    "duration": 5.28
  },
  {
    "id": 50,
    "text": "本段任务是深入剖析家长专制与三位女性惨死的血泪证据，",
    "start": 223.808,
    "end": 228.848,
    "duration": 5.04
  },
  {
    "id": 51,
    "text": "形成密集的史料冲击力。",
    "start": 228.848,
    "end": 231.088,
    "duration": 2.24
  },
  {
    "id": 52,
    "text": "首先，段首给出结论先行的分论点，",
    "start": 231.088,
    "end": 233.968,
    "duration": 2.88
  },
  {
    "id": 53,
    "text": "具体表述到答题语句就是：第一，在思想意蕴上，",
    "start": 233.968,
    "end": 237.888,
    "duration": 3.92
  },
  {
    "id": 54,
    "text": "作品以冷峻写实的批判力量，深刻解剖了封建宗法制度“礼教杀人”的野蛮血腥与腐朽大家族走向崩溃的历史必然性。",
    "start": 237.888,
    "end": 247.488,
    "duration": 9.6
  },
  {
    "id": 55,
    "text": "-随后，剖析高老太爷所代表的独断家长专制网络，",
    "start": 247.648,
    "end": 251.808,
    "duration": 4.16
  },
  {
    "id": 56,
    "text": "具体表述到答题语句就是：高老太爷作为高家最高专制家长，",
    "start": 251.808,
    "end": 257.008,
    "duration": 5.2
  },
  {
    "id": 57,
    "text": "其一人独断的封建权威构成了压制一切人性与生机的庞大黑网。，",
    "start": 257.008,
    "end": 262.624,
    "duration": 5.616
  },
  {
    "id": 58,
    "text": "并揭露腐朽本质：在这个外表“四世同堂”的诗礼簪婴之族内部，",
    "start": 262.624,
    "end": 267.824,
    "duration": 5.2
  },
  {
    "id": 59,
    "text": "不仅充斥着五老爷、四老爷争夺家产的荒淫无耻，",
    "start": 267.824,
    "end": 271.984,
    "duration": 4.16
  },
  {
    "id": 60,
    "text": "更发生了一连串因恪守旧礼教而吞噬纯洁青春的惨剧。",
    "start": 271.984,
    "end": 276.768,
    "duration": 4.784
  },
  {
    "id": 61,
    "text": "-紧接着，密集调取鸣凤投湖、梅表姐病死、",
    "start": 276.816,
    "end": 280.333,
    "duration": 3.517
  },
  {
    "id": 62,
    "text": "瑞珏血光之灾三连例证，具体表述到答题语句就是：纯洁刚烈的丫鬟鸣凤，",
    "start": 280.333,
    "end": 286.927,
    "duration": 6.594
  },
  {
    "id": 63,
    "text": "因不甘被高老太爷强行纳为冯乐山之妾，",
    "start": 286.927,
    "end": 290.664,
    "duration": 3.737
  },
  {
    "id": 64,
    "text": "在绝望中投湖自尽。",
    "start": 290.664,
    "end": 292.422,
    "duration": 1.758
  },
  {
    "id": 65,
    "text": "柔弱温顺的梅表姐，因封建迷信与母亲专制被迫改嫁，",
    "start": 292.422,
    "end": 297.258,
    "duration": 4.836
  },
  {
    "id": 66,
    "text": "在抑郁成疾中吐血而亡。",
    "start": 297.258,
    "end": 299.456,
    "duration": 2.198
  },
  {
    "id": 67,
    "text": "贤良忍让的瑞珏，因高老太爷出殡时的所谓“血光之灾”鬼神迷信，",
    "start": 299.616,
    "end": 305.216,
    "duration": 5.6
  },
  {
    "id": 68,
    "text": "被长辈强行驱逐至城外荒僻阴湿之所分娩，",
    "start": 305.216,
    "end": 309.296,
    "duration": 4.08
  },
  {
    "id": 69,
    "text": "最终惨死于产褥之上。",
    "start": 309.296,
    "end": 311.536,
    "duration": 2.24
  },
  {
    "id": 70,
    "text": "最后，收束提炼礼教吃人本质与旧家庭走向死亡的宿命：巴金通过这三位青年女性的凄惨毁灭，",
    "start": 311.536,
    "end": 319.616,
    "duration": 8.08
  },
  {
    "id": 71,
    "text": "将封建礼教伪善吃人的争凝面目揭露无遗，",
    "start": 319.616,
    "end": 323.296,
    "duration": 3.68
  },
  {
    "id": 72,
    "text": "有力宣示了旧体制无可挽回的死亡宿命。",
    "start": 323.296,
    "end": 326.656,
    "duration": 3.36
  },
  {
    "id": 73,
    "text": "第一，在思想意蕴上，作品以冷峻写实的批判力量，",
    "start": 326.976,
    "end": 331.616,
    "duration": 4.64
  },
  {
    "id": 74,
    "text": "深刻解剖了封建宗法制度“礼教杀人”的野蛮血腥与腐朽大家族走向崩溃的历史必然性。",
    "start": 331.616,
    "end": 338.736,
    "duration": 7.12
  },
  {
    "id": 75,
    "text": "高老太爷作为高家最高专制家长，其一人独断的封建权威构成了压制一切人性与生机的庞大黑网。",
    "start": 338.736,
    "end": 346.576,
    "duration": 7.84
  },
  {
    "id": 76,
    "text": "在这个外表“四世同堂”的诗礼簪婴之族内部，",
    "start": 346.896,
    "end": 350.656,
    "duration": 3.76
  },
  {
    "id": 77,
    "text": "不仅充斥着五老爷、四老爷争夺家产的荒淫无耻，",
    "start": 350.656,
    "end": 354.896,
    "duration": 4.24
  },
  {
    "id": 78,
    "text": "更发生了一连串因恪守旧礼教而吞噬纯洁青春的惨剧。",
    "start": 354.896,
    "end": 360.336,
    "duration": 5.44
  },
  {
    "id": 79,
    "text": "纯洁刚烈的丫鬟鸣凤，因不甘被高老太爷强行纳为冯乐山之妾，",
    "start": 360.336,
    "end": 365.856,
    "duration": 5.52
  },
  {
    "id": 80,
    "text": "在绝望中投湖自尽。",
    "start": 365.856,
    "end": 367.776,
    "duration": 1.92
  },
  {
    "id": 81,
    "text": "柔弱温顺的梅表姐，因封建迷信与母亲专制被迫改嫁，",
    "start": 368.176,
    "end": 372.896,
    "duration": 4.72
  },
  {
    "id": 82,
    "text": "在抑郁成疾中吐血而亡。",
    "start": 372.896,
    "end": 375.296,
    "duration": 2.4
  },
  {
    "id": 83,
    "text": "贤良忍让的瑞珏，因高老太爷出殡时的所谓“血光之灾”鬼神迷信，",
    "start": 375.296,
    "end": 381.216,
    "duration": 5.92
  },
  {
    "id": 84,
    "text": "被长辈强行驱逐至城外荒僻阴湿之所分娩，",
    "start": 381.216,
    "end": 384.976,
    "duration": 3.76
  },
  {
    "id": 85,
    "text": "最终惨死于产褥之上。",
    "start": 384.976,
    "end": 386.896,
    "duration": 1.92
  },
  {
    "id": 86,
    "text": "巴金通过这三位青年女性的凄惨毁灭，",
    "start": 386.896,
    "end": 389.776,
    "duration": 2.88
  },
  {
    "id": 87,
    "text": "将封建礼教伪善吃人的争凝面目揭露无遗，",
    "start": 389.776,
    "end": 393.216,
    "duration": 3.44
  },
  {
    "id": 88,
    "text": "有力宣示了旧体制无可挽回的死亡宿命。",
    "start": 393.216,
    "end": 396.256,
    "duration": 3.04
  },
  {
    "id": 89,
    "text": "三、第二维度：觉新与觉慧青年群像对比塑造内部咬合。",
    "start": 396.576,
    "end": 401.936,
    "duration": 5.36
  },
  {
    "id": 90,
    "text": "本段任务是直击本题第二问，深度解剖觉新的作揖主义与觉慧的反叛出走。",
    "start": 401.936,
    "end": 408.256,
    "duration": 6.32
  },
  {
    "id": 91,
    "text": "首先，段首给出统领分论点，具体表述到答题语句就是：第二，",
    "start": 408.256,
    "end": 413.136,
    "duration": 4.88
  },
  {
    "id": 92,
    "text": "在人物群像塑造上，作品塑造了鲜明对立的青年知识分子典型，",
    "start": 413.136,
    "end": 418.256,
    "duration": 5.12
  },
  {
    "id": 93,
    "text": "生动呈现出新旧交替时期中国青年在叛逆与妥协之间的灵魂阵痛。",
    "start": 418.256,
    "end": 423.776,
    "duration": 5.52
  },
  {
    "id": 94,
    "text": "-随后，剖析觉新的“多余人”与自枪者性质，",
    "start": 423.984,
    "end": 427.496,
    "duration": 3.512
  },
  {
    "id": 95,
    "text": "具体表述到答题语句就是：巴金最为成功的是创造了觉新与觉慧这对性格截然相反的兄弟典型。",
    "start": 427.496,
    "end": 436.277,
    "duration": 8.781
  },
  {
    "id": 96,
    "text": "长房长孙高觉新是封建制度下“多余人”与自枪者的代表。，",
    "start": 436.277,
    "end": 441.326,
    "duration": 5.049
  },
  {
    "id": 97,
    "text": "并提炼其精神症候：他深受五四新潮启蒙，",
    "start": 441.326,
    "end": 445.058,
    "duration": 3.732
  },
  {
    "id": 98,
    "text": "深爱着梅表姐，却因家庭责任与长辈意志，",
    "start": 445.058,
    "end": 448.79,
    "duration": 3.732
  },
  {
    "id": 99,
    "text": "奉行“作揖主义”与“无抵抗主义”。",
    "start": 448.79,
    "end": 451.424,
    "duration": 2.634
  },
  {
    "id": 100,
    "text": "他每一次无原则的委曲求全，不仅埋葬了自己的真爱与青春，",
    "start": 451.504,
    "end": 456.384,
    "duration": 4.88
  },
  {
    "id": 101,
    "text": "更为家族腐朽势力递上了杀害鸣凤与瑞珏的刀刃，",
    "start": 456.384,
    "end": 460.544,
    "duration": 4.16
  },
  {
    "id": 102,
    "text": "成为封建礼教的可悲陪葬品与无意识帮凶。",
    "start": 460.544,
    "end": 464.304,
    "duration": 3.76
  },
  {
    "id": 103,
    "text": "紧接着，转入觉慧狂飙青年的性格分析，",
    "start": 464.304,
    "end": 467.744,
    "duration": 3.44
  },
  {
    "id": 104,
    "text": "具体表述到答题语句就是：而三弟高觉慧则是典型的“五四狂飙青年”与坚定叛逆者。",
    "start": 467.744,
    "end": 474.784,
    "duration": 7.04
  },
  {
    "id": 105,
    "text": "他身上洋溢着火热的革命激情与决绝的抗争意志。，",
    "start": 474.944,
    "end": 479.104,
    "duration": 4.16
  },
  {
    "id": 106,
    "text": "调取其抗争细节：他敢于直面指斥长辈的虚伪残酷，",
    "start": 479.104,
    "end": 483.424,
    "duration": 4.32
  },
  {
    "id": 107,
    "text": "敢于砸破捉鬼迷信的迷津，甚至在祖父威严面前寸步不让。",
    "start": 483.424,
    "end": 488.064,
    "duration": 4.64
  },
  {
    "id": 108,
    "text": "在经历了一系列血泪悲剧后，觉慧毅然斩断与封建腐朽家庭的一切血缘羁绊，",
    "start": 488.064,
    "end": 494.384,
    "duration": 6.32
  },
  {
    "id": 109,
    "text": "登舟东下奔向广阔的时代天地，成为中国文学长廊中个性解放与决绝反叛的光辉典型。",
    "start": 494.384,
    "end": 501.424,
    "duration": 7.04
  },
  {
    "id": 110,
    "text": "-最后，兼顾二哥觉民的温和抗争，",
    "start": 501.664,
    "end": 504.443,
    "duration": 2.779
  },
  {
    "id": 111,
    "text": "补全群像谱系：二弟高觉民则代表了温和理智、",
    "start": 504.443,
    "end": 508.505,
    "duration": 4.062
  },
  {
    "id": 112,
    "text": "坚持自主婚姻的抗争路径，三者共同构成了丰富立体的青年觉醒谱系。",
    "start": 508.505,
    "end": 514.704,
    "duration": 6.199
  },
  {
    "id": 113,
    "text": "第二，在人物群像塑造上，作品塑造了鲜明对立的青年知识分子典型，",
    "start": 514.832,
    "end": 520.672,
    "duration": 5.84
  },
  {
    "id": 114,
    "text": "生动呈现出新旧交替时期中国青年在叛逆与妥协之间的灵魂阵痛。",
    "start": 520.672,
    "end": 526.672,
    "duration": 6.0
  },
  {
    "id": 115,
    "text": "巴金最为成功的是创造了觉新与觉慧这对性格截然相反的兄弟典型。",
    "start": 526.672,
    "end": 532.672,
    "duration": 6.0
  },
  {
    "id": 116,
    "text": "长房长孙高觉新是封建制度下“多余人”与自枪者的代表。",
    "start": 532.672,
    "end": 537.312,
    "duration": 4.64
  },
  {
    "id": 117,
    "text": "他深受五四新潮启蒙，深爱着梅表姐，",
    "start": 537.552,
    "end": 540.912,
    "duration": 3.36
  },
  {
    "id": 118,
    "text": "却因家庭责任与长辈意志，奉行“作揖主义”与“无抵抗主义”。",
    "start": 540.912,
    "end": 546.272,
    "duration": 5.36
  },
  {
    "id": 119,
    "text": "他每一次无原则的委曲求全，不仅埋葬了自己的真爱与青春，",
    "start": 546.272,
    "end": 550.832,
    "duration": 4.56
  },
  {
    "id": 120,
    "text": "更为家族腐朽势力递上了杀害鸣凤与瑞珏的刀刃，",
    "start": 550.832,
    "end": 555.072,
    "duration": 4.24
  },
  {
    "id": 121,
    "text": "成为封建礼教的可悲陪葬品与无意识帮凶。",
    "start": 555.072,
    "end": 558.432,
    "duration": 3.36
  },
  {
    "id": 122,
    "text": "而三弟高觉慧则是典型的“五四狂飙青年”与坚定叛逆者。",
    "start": 558.752,
    "end": 563.712,
    "duration": 4.96
  },
  {
    "id": 123,
    "text": "他身上洋溢着火热的革命激情与决绝的抗争意志。",
    "start": 563.712,
    "end": 567.952,
    "duration": 4.24
  },
  {
    "id": 124,
    "text": "他敢于直面指斥长辈的虚伪残酷，敢于砸破捉鬼迷信的迷津，",
    "start": 567.952,
    "end": 573.312,
    "duration": 5.36
  },
  {
    "id": 125,
    "text": "甚至在祖父威严面前寸步不让。",
    "start": 573.312,
    "end": 576.192,
    "duration": 2.88
  },
  {
    "id": 126,
    "text": "在经历了一系列血泪悲剧后，觉慧毅然斩断与封建腐朽家庭的一切血缘羁绊，",
    "start": 576.192,
    "end": 582.272,
    "duration": 6.08
  },
  {
    "id": 127,
    "text": "登舟东下奔向广阔的时代天地，成为中国文学长廊中个性解放与决绝反叛的光辉典型。",
    "start": 582.272,
    "end": 589.632,
    "duration": 7.36
  },
  {
    "id": 128,
    "text": "二弟高觉民则代表了温和理智、坚持自主婚姻的抗争路径，",
    "start": 589.952,
    "end": 595.072,
    "duration": 5.12
  },
  {
    "id": 129,
    "text": "三者共同构成了丰富立体的青年觉醒谱系。",
    "start": 595.072,
    "end": 598.832,
    "duration": 3.76
  },
  {
    "id": 130,
    "text": "四、第三维度：浓烈抒情笔触与现实主义史诗艺术内部咬合。",
    "start": 598.832,
    "end": 603.872,
    "duration": 5.04
  },
  {
    "id": 131,
    "text": "本段任务是落脚于巴金特有的激情澎湃文风与家族史诗美学。",
    "start": 603.872,
    "end": 608.672,
    "duration": 4.8
  },
  {
    "id": 132,
    "text": "-首先，段首给出统领分论点，具体表述到答题语句就是：第三，",
    "start": 608.912,
    "end": 614.152,
    "duration": 5.24
  },
  {
    "id": 133,
    "text": "在艺术表现机制上，作品将浓烈充沛的抒情笔触融入现实主义家族编年史中，",
    "start": 614.152,
    "end": 621.139,
    "duration": 6.987
  },
  {
    "id": 134,
    "text": "形成了撼动人心的青春抒情史诗风范。",
    "start": 621.139,
    "end": 624.633,
    "duration": 3.494
  },
  {
    "id": 135,
    "text": "随后，引用巴金自白，点出情感驱动的小说机制，",
    "start": 624.633,
    "end": 628.781,
    "duration": 4.148
  },
  {
    "id": 136,
    "text": "具体表述到答题语句就是：巴金曾自白其创作动力是“控诉与控诉”，",
    "start": 628.781,
    "end": 634.677,
    "duration": 5.896
  },
  {
    "id": 137,
    "text": "全书洋溢着炽热而纯真的爱憎情感。",
    "start": 634.677,
    "end": 637.952,
    "duration": 3.275
  },
  {
    "id": 138,
    "text": "小说没有刻意经营繁复的小说技巧，",
    "start": 638.112,
    "end": 640.752,
    "duration": 2.64
  },
  {
    "id": 139,
    "text": "而是以纯粹平实的语言、火山爆发般喷涌的情感波澜，",
    "start": 640.752,
    "end": 645.152,
    "duration": 4.4
  },
  {
    "id": 140,
    "text": "推动情节由压抑走向爆发。",
    "start": 645.152,
    "end": 647.152,
    "duration": 2.0
  },
  {
    "id": 141,
    "text": "-最后，调取高公馆分家闹剧与觉慧离家奔流江水的意象对照，",
    "start": 647.448,
    "end": 652.816,
    "duration": 5.368
  },
  {
    "id": 142,
    "text": "具体表述到答题语句就是：高老太爷死后高公馆诸房为分家而撕破脸皮的丑剧，",
    "start": 652.816,
    "end": 659.903,
    "duration": 7.087
  },
  {
    "id": 143,
    "text": "与觉慧出走时黎明江水奔流的明朗意象形成强烈对照，",
    "start": 659.903,
    "end": 664.842,
    "duration": 4.939
  },
  {
    "id": 144,
    "text": "形成了催人奋起的崇高美学品格。",
    "start": 664.842,
    "end": 667.848,
    "duration": 3.006
  },
  {
    "id": 145,
    "text": "第三，在艺术表现机制上，作品将浓烈充沛的抒情笔触融入现实主义家族编年史中，",
    "start": 667.928,
    "end": 675.208,
    "duration": 7.28
  },
  {
    "id": 146,
    "text": "形成了撼动人心的青春抒情史诗风范。",
    "start": 675.208,
    "end": 678.488,
    "duration": 3.28
  },
  {
    "id": 147,
    "text": "巴金曾自白其创作动力是“控诉与控诉”，",
    "start": 678.488,
    "end": 682.088,
    "duration": 3.6
  },
  {
    "id": 148,
    "text": "全书洋溢着炽热而纯真的爱憎情感。",
    "start": 682.088,
    "end": 685.288,
    "duration": 3.2
  },
  {
    "id": 149,
    "text": "小说没有刻意经营繁复的小说技巧，",
    "start": 685.288,
    "end": 688.168,
    "duration": 2.88
  },
  {
    "id": 150,
    "text": "而是以纯粹平实的语言、火山爆发般喷涌的情感波澜，",
    "start": 688.168,
    "end": 692.888,
    "duration": 4.72
  },
  {
    "id": 151,
    "text": "推动情节由压抑走向爆发。",
    "start": 692.888,
    "end": 695.048,
    "duration": 2.16
  },
  {
    "id": 152,
    "text": "高老太爷死后高公馆诸房为分家而撕破脸皮的丑剧，",
    "start": 695.368,
    "end": 700.168,
    "duration": 4.8
  },
  {
    "id": 153,
    "text": "与觉慧出走时黎明江水奔流的明朗意象形成强烈对照，",
    "start": 700.168,
    "end": 705.528,
    "duration": 5.36
  },
  {
    "id": 154,
    "text": "形成了催人奋起的崇高美学品格。",
    "start": 705.528,
    "end": 708.488,
    "duration": 2.96
  },
  {
    "id": 155,
    "text": "五、结尾收束升华段内部咬合。",
    "start": 708.488,
    "end": 711.368,
    "duration": 2.88
  },
  {
    "id": 156,
    "text": "本段承担全篇论证成果的系统提炼与历史定位，",
    "start": 711.368,
    "end": 715.368,
    "duration": 4.0
  },
  {
    "id": 157,
    "text": "收束在灯塔指引价值上。",
    "start": 715.368,
    "end": 717.128,
    "duration": 1.76
  },
  {
    "id": 158,
    "text": "-首先，全面回收控诉封建神话与觉新觉慧对照成果，",
    "start": 717.368,
    "end": 721.406,
    "duration": 4.038
  },
  {
    "id": 159,
    "text": "具体表述到答题语句就是：综上所述，",
    "start": 721.406,
    "end": 724.29,
    "duration": 2.884
  },
  {
    "id": 160,
    "text": "巴金《家》以血泪控诉撕碎了封建宗法神话，",
    "start": 724.29,
    "end": 727.558,
    "duration": 3.268
  },
  {
    "id": 161,
    "text": "以觉新与觉慧的鲜明对照刻画了青年知识分子觉醒的艰难与必然。",
    "start": 727.558,
    "end": 732.942,
    "duration": 5.384
  },
  {
    "id": 162,
    "text": "紧接着，总结对一代代青年走出牢笼的永恒启蒙意义，",
    "start": 732.942,
    "end": 737.172,
    "duration": 4.23
  },
  {
    "id": 163,
    "text": "具体表述到答题语句就是：它不仅是中国现代文学现实主义与浪漫主义精神熔铸的伟大史诗，",
    "start": 737.172,
    "end": 744.671,
    "duration": 7.499
  },
  {
    "id": 164,
    "text": "更在数代青年走出封建牢笼、追求自由真理的心灵征程中，",
    "start": 744.671,
    "end": 749.285,
    "duration": 4.614
  },
  {
    "id": 165,
    "text": "树立起永不磨灭的灯塔。",
    "start": 749.285,
    "end": 751.208,
    "duration": 1.923
  },
  {
    "id": 166,
    "text": "综上所述，巴金《家》以血泪控诉撕碎了封建宗法神话，",
    "start": 751.368,
    "end": 756.248,
    "duration": 4.88
  },
  {
    "id": 167,
    "text": "以觉新与觉慧的鲜明对照刻画了青年知识分子觉醒的艰难与必然。",
    "start": 756.248,
    "end": 761.608,
    "duration": 5.36
  },
  {
    "id": 168,
    "text": "它不仅是中国现代文学现实主义与浪漫主义精神熔铸的伟大史诗，",
    "start": 761.608,
    "end": 766.968,
    "duration": 5.36
  },
  {
    "id": 169,
    "text": "更在数代青年走出封建牢笼、追求自由真理的心灵征程中，",
    "start": 766.968,
    "end": 771.848,
    "duration": 4.88
  },
  {
    "id": 170,
    "text": "树立起永不磨灭的灯塔。",
