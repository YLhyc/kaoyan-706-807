[
  {
    "id": 1,
    "text": "自五四新文化运动以来，中国现当代知识分子形象的文学书写，",
    "start": 0.2,
    "end": 5.16,
    "duration": 4.96
  },
  {
    "id": 2,
    "text": "深刻折射出知识阶层在启蒙、抗争与历史转折中的精神困境与道路抉择。",
    "start": 5.53,
    "end": 12.33,
    "duration": 6.8
  },
  {
    "id": 3,
    "text": "其百年形象演变主要经历以下三个阶段：",
    "start": 12.85,
    "end": 15.65,
    "duration": 2.8
  },
  {
    "id": 4,
    "text": "第一，五四启蒙时期：先觉者的觉醒与苦闷徘徊。",
    "start": 16.02,
    "end": 20.5,
    "duration": 4.48
  },
  {
    "id": 5,
    "text": "五四早期，鲁迅在《狂人日记》中塑造了看破礼教“吃人”本质的启蒙先驱；",
    "start": 21.02,
    "end": 26.78,
    "duration": 5.76
  },
  {
    "id": 6,
    "text": "随后随着新文化阵营分化，鲁迅在《彷徨》中沉痛剖析了脱离民众的个人启蒙者遭遇的孤立困境。",
    "start": 27.3,
    "end": 34.58,
    "duration": 7.28
  },
  {
    "id": 7,
    "text": "《在酒楼上》的吕纬甫由昔日激进青年沦为替亡弟迁葬、教读“子曰诗云”的颓唐者；",
    "start": 35.1,
    "end": 42.22,
    "duration": 7.12
  },
  {
    "id": 8,
    "text": "《孤独者》中的魏连殳从孤傲抗争妥协为军阀幕僚，",
    "start": 42.74,
    "end": 47.38,
    "duration": 4.64
  },
  {
    "id": 9,
    "text": "揭示出缺乏社会根基的个体反叛面临的精神死局。",
    "start": 47.75,
    "end": 51.99,
    "duration": 4.24
  },
  {
    "id": 10,
    "text": "第二，大革命退潮至四十年代：时代激流下的分化与精神围困。",
    "start": 52.51,
    "end": 57.63,
    "duration": 5.12
  },
  {
    "id": 11,
    "text": "面对革命浪潮与民族危机，知识分子群体发生明显分化：",
    "start": 58.15,
    "end": 62.47,
    "duration": 4.32
  },
  {
    "id": 12,
    "text": "巴金《家》中的觉慧毅然决裂封建家庭奔向新生活，",
    "start": 62.84,
    "end": 67.32,
    "duration": 4.48
  },
  {
    "id": 13,
    "text": "茅盾《动摇》中的方罗兰则在左右势力拉扯中优柔动摇；",
    "start": 67.69,
    "end": 72.49,
    "duration": 4.8
  },
  {
    "id": 14,
    "text": "四十年代，钱锺书在《围城》中刻画了方鸿渐这一留学归国却处处受困的灰色文人典型，",
    "start": 73.01,
    "end": 81.01,
    "duration": 8.0
  },
  {
    "id": 15,
    "text": "他在谋职、婚恋与三闾大学的人际倾轧中进退失据，",
    "start": 81.38,
    "end": 85.78,
    "duration": 4.4
  },
  {
    "id": 16,
    "text": "展现出传统与现代文明夹击下知识阶层的精神困顿。",
    "start": 86.18,
    "end": 90.5,
    "duration": 4.32
  },
  {
    "id": 17,
    "text": "第三，解放区及当代时期：在投身工农、挫折反思中坚守理想。",
    "start": 91.02,
    "end": 96.783,
    "duration": 5.763
  },
  {
    "id": 18,
    "text": "延安文艺座谈会后，文学着重审视知识分子的思想弱点与实践道路：",
    "start": 97.283,
    "end": 102.42,
    "duration": 5.137
  },
  {
    "id": 19,
    "text": "丁玲既在《在医院中》借女医生陆萍揭示现代科学民主意识与落后小生产习气的冲突，",
    "start": 102.79,
    "end": 110.87,
    "duration": 8.08
  },
  {
    "id": 20,
    "text": "也在《太阳照在桑干河上》中塑造了深入实际的领导干部章品，",
    "start": 111.24,
    "end": 116.36,
    "duration": 5.12
  },
  {
    "id": 21,
    "text": "并批评了工作组长文采脱离群众的教条作风；",
    "start": 116.73,
    "end": 120.65,
    "duration": 3.92
  },
  {
    "id": 22,
    "text": "及至当代新时期，谌容《人到中年》中的眼科医生陆文婷在生活重压下仍恪守医者良知，",
    "start": 121.17,
    "end": 128.85,
    "duration": 7.68
  },
  {
    "id": 23,
    "text": "体现出一代知识分子历尽沧桑后的精神坚守。",
    "start": 129.22,
    "end": 132.9,
    "duration": 3.68
  }
]
