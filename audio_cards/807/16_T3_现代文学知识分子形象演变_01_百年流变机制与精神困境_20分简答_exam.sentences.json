[
  {
    "id": 1,
    "text": "自五四新文化运动至延安新文艺体制确立，",
    "start": 0.05,
    "end": 3.684,
    "duration": 3.634
  },
  {
    "id": 2,
    "text": "中国现代知识分子形象的文学书写，",
    "start": 3.684,
    "end": 6.419,
    "duration": 2.735
  },
  {
    "id": 3,
    "text": "深刻折射了现代知识阶层在启蒙觉醒、",
    "start": 6.419,
    "end": 9.692,
    "duration": 3.273
  },
  {
    "id": 4,
    "text": "历史动荡与社会革命中的灵魂挣扎。",
    "start": 9.692,
    "end": 12.89,
    "duration": 3.198
  },
  {
    "id": 5,
    "text": "其形象演变主要经历了以下三个阶段的嬗变：",
    "start": 12.89,
    "end": 17.051,
    "duration": 4.161
  },
  {
    "id": 6,
    "text": "第一，五四启蒙时期：",
    "start": 17.051,
    "end": 18.675,
    "duration": 1.624
  },
  {
    "id": 7,
    "text": "作为“先觉战士”的觉醒与战斗幻灭后的深刻苦闷。",
    "start": 18.675,
    "end": 23.6,
    "duration": 4.925
  },
  {
    "id": 8,
    "text": "五四早期，",
    "start": 23.6,
    "end": 24.5,
    "duration": 0.9
  },
  {
    "id": 9,
    "text": "鲁迅在《狂人日记》中确立了看破传统吃人礼教的现代启蒙先驱形象；",
    "start": 24.5,
    "end": 29.806,
    "duration": 5.306
  },
  {
    "id": 10,
    "text": "然而随着新文化阵营分化，",
    "start": 29.806,
    "end": 32.956,
    "duration": 3.15
  },
  {
    "id": 11,
    "text": "鲁迅在《彷徨》中转而以无情自审的解剖刀，",
    "start": 32.956,
    "end": 36.047,
    "duration": 3.091
  },
  {
    "id": 12,
    "text": "刻画了先觉者在孤独无援中的颓唐与倒退。",
    "start": 36.047,
    "end": 39.467,
    "duration": 3.42
  },
  {
    "id": 13,
    "text": "《在酒楼上》中昔日慷慨激昂的吕纬甫，最终沦为替死者迁葬、",
    "start": 39.467,
    "end": 44.221,
    "duration": 4.754
  },
  {
    "id": 14,
    "text": "教小儿读“子曰诗云”的麻木度日者；",
    "start": 44.221,
    "end": 47.55,
    "duration": 3.329
  },
  {
    "id": 15,
    "text": "《孤独者》中的魏连殳由孤傲叛逆最终妥协沦为军阀幕僚，",
    "start": 47.55,
    "end": 52.834,
    "duration": 5.284
  },
  {
    "id": 16,
    "text": "深刻揭示了脱离广大民众的个体启蒙者必然遭遇的精神死局。",
    "start": 52.834,
    "end": 58.279,
    "duration": 5.445
  },
  {
    "id": 17,
    "text": "第二，三十至四十年代：",
    "start": 58.279,
    "end": 60.474,
    "duration": 2.195
  },
  {
    "id": 18,
    "text": "在阶级分化与抗战乱世中呈现的分化裂变与精神围困。",
    "start": 60.474,
    "end": 65.688,
    "duration": 5.214
  },
  {
    "id": 19,
    "text": "伴随革命大潮与民族危机，知识分子群体发生深刻分化。",
    "start": 65.688,
    "end": 70.354,
    "duration": 4.666
  },
  {
    "id": 20,
    "text": "一部分如巴金《家》中的觉慧毅然冲破封建家庭投身时代浪潮；",
    "start": 70.354,
    "end": 74.899,
    "duration": 4.545
  },
  {
    "id": 21,
    "text": "另一部分则陷入摇摆动荡，",
    "start": 74.899,
    "end": 76.899,
    "duration": 2.0
  },
  {
    "id": 22,
    "text": "如茅盾《动摇》中的方罗兰在左右拉扯中优柔寡断。",
    "start": 76.899,
    "end": 80.535,
    "duration": 3.636
  },
  {
    "id": 23,
    "text": "而在四十年代沦陷与后方，",
    "start": 80.535,
    "end": 83.038,
    "duration": 2.503
  },
  {
    "id": 24,
    "text": "钱锺书在《围城》中刻画了方鸿渐这一灰色无用的海归文人典型，",
    "start": 83.038,
    "end": 88.317,
    "duration": 5.279
  },
  {
    "id": 25,
    "text": "终日困顿于恋爱、谋职与人际内耗的荒谬迷局，",
    "start": 88.317,
    "end": 93.27,
    "duration": 4.953
  },
  {
    "id": 26,
    "text": "展现了旧知识阶层在现代化转型中的精神瘫软。",
    "start": 93.27,
    "end": 97.143,
    "duration": 3.873
  },
  {
    "id": 27,
    "text": "第三，延安与解放区时期：",
    "start": 97.143,
    "end": 99.553,
    "duration": 2.41
  },
  {
    "id": 28,
    "text": "在思想改造与工农结合中实现政治与精神新生。",
    "start": 99.553,
    "end": 103.19,
    "duration": 3.637
  },
  {
    "id": 29,
    "text": "随着延安文艺座谈会确立工农兵方向，",
    "start": 103.19,
    "end": 106.099,
    "duration": 2.909
  },
  {
    "id": 30,
    "text": "文学深刻反思了小资产阶级知识分子的自私空想与软弱动摇。",
    "start": 106.099,
    "end": 111.152,
    "duration": 5.053
  },
  {
    "id": 31,
    "text": "丁玲在《太阳照在桑干河上》中塑造的章品、",
    "start": 111.152,
    "end": 115.968,
    "duration": 4.816
  },
  {
    "id": 32,
    "text": "文采等工作组知识分子，深入土改一线与农民同吃同住同劳动，",
    "start": 115.968,
    "end": 120.781,
    "duration": 4.813
  },
  {
    "id": 33,
    "text": "在火热群众运动的熔炉中洗刷资产阶级虚荣，",
    "start": 120.781,
    "end": 124.269,
    "duration": 3.488
  },
  {
    "id": 34,
    "text": "真正转变为与工农群众休戚与共的无产阶级革命文艺战士。",
    "start": 124.269,
    "end": 128.928,
    "duration": 4.659
  }
]