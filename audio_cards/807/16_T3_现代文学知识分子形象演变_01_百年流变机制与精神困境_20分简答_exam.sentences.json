[
  {
    "id": 1,
    "text": "自五四新文化运动至延安新文艺体制确立，",
    "start": 0.0,
    "end": 3.714,
    "duration": 3.714
  },
  {
    "id": 2,
    "text": "中国现代知识分子形象的文学书写，",
    "start": 3.714,
    "end": 6.448,
    "duration": 2.734
  },
  {
    "id": 3,
    "text": "深刻折射了现代知识阶层在启蒙觉醒、",
    "start": 6.448,
    "end": 9.721,
    "duration": 3.273
  },
  {
    "id": 4,
    "text": "历史动荡与社会革命中的灵魂挣扎。",
    "start": 9.721,
    "end": 12.92,
    "duration": 3.199
  },
  {
    "id": 5,
    "text": "其形象演变主要经历了以下三个阶段的嬗变：",
    "start": 12.92,
    "end": 16.414,
    "duration": 3.494
  },
  {
    "id": 6,
    "text": "第一，五四启蒙时期：",
    "start": 16.414,
    "end": 18.703,
    "duration": 2.289
  },
  {
    "id": 7,
    "text": "作为“先觉战士”的觉醒与战斗幻灭后的深刻苦闷。",
    "start": 18.703,
    "end": 22.618,
    "duration": 3.915
  },
  {
    "id": 8,
    "text": "五四早期，",
    "start": 22.618,
    "end": 23.63,
    "duration": 1.012
  },
  {
    "id": 9,
    "text": "鲁迅在《狂人日记》中确立了看破传统吃人礼教的现代启蒙先驱形象；",
    "start": 23.63,
    "end": 29.555,
    "duration": 5.925
  },
  {
    "id": 10,
    "text": "然而随着新文化阵营分化，",
    "start": 29.555,
    "end": 31.654,
    "duration": 2.099
  },
  {
    "id": 11,
    "text": "鲁迅在《彷徨》中转而以无情自审的解剖刀，",
    "start": 31.654,
    "end": 35.425,
    "duration": 3.771
  },
  {
    "id": 12,
    "text": "刻画了先觉者在孤独无援中的颓唐与倒退。",
    "start": 35.425,
    "end": 39.066,
    "duration": 3.641
  },
  {
    "id": 13,
    "text": "《在酒楼上》中昔日慷慨激昂的吕纬甫，最终沦为替死者迁葬、",
    "start": 39.066,
    "end": 45.314,
    "duration": 6.248
  },
  {
    "id": 14,
    "text": "教小儿读“子曰诗云”的麻木度日者；",
    "start": 45.314,
    "end": 49.373,
    "duration": 4.059
  },
  {
    "id": 15,
    "text": "《孤独者》中的魏连殳由孤傲叛逆最终妥协沦为军阀幕僚，",
    "start": 49.373,
    "end": 53.874,
    "duration": 4.501
  },
  {
    "id": 16,
    "text": "深刻揭示了脱离广大民众的个体启蒙者必然遭遇的精神死局。",
    "start": 53.874,
    "end": 58.983,
    "duration": 5.109
  },
  {
    "id": 17,
    "text": "第二，三十至四十年代：",
    "start": 58.983,
    "end": 61.672,
    "duration": 2.689
  },
  {
    "id": 18,
    "text": "在阶级分化与抗战乱世中呈现的分化裂变与精神围困。",
    "start": 61.672,
    "end": 65.718,
    "duration": 4.046
  },
  {
    "id": 19,
    "text": "伴随革命大潮与民族危机，知识分子群体发生深刻分化。",
    "start": 65.718,
    "end": 66.959,
    "duration": 1.241
  },
  {
    "id": 20,
    "text": "一部分如巴金《家》中的觉慧毅然冲破封建家庭投身时代浪潮；",
    "start": 66.959,
    "end": 68.074,
    "duration": 1.115
  },
  {
    "id": 21,
    "text": "另一部分则陷入摇摆动荡，",
    "start": 68.074,
    "end": 70.383,
    "duration": 2.309
  },
  {
    "id": 22,
    "text": "如茅盾《动摇》中的方罗兰在左右拉扯中优柔寡断。",
    "start": 70.383,
    "end": 72.775,
    "duration": 2.392
  },
  {
    "id": 23,
    "text": "而在四十年代沦陷与后方，",
    "start": 72.775,
    "end": 75.762,
    "duration": 2.987
  },
  {
    "id": 24,
    "text": "钱锺书在《围城》中刻画了方鸿渐这一灰色无用的海归文人典型，",
    "start": 75.762,
    "end": 78.353,
    "duration": 2.591
  },
  {
    "id": 25,
    "text": "终日困顿于恋爱、谋职与人际内耗的荒谬迷局，",
    "start": 78.353,
    "end": 80.557,
    "duration": 2.204
  },
  {
    "id": 26,
    "text": "展现了旧知识阶层在现代化转型中的精神瘫软。",
    "start": 80.557,
    "end": 83.065,
    "duration": 2.508
  },
  {
    "id": 27,
    "text": "第三，延安与解放区时期：",
    "start": 83.065,
    "end": 85.369,
    "duration": 2.304
  },
  {
    "id": 28,
    "text": "在思想改造与工农结合中实现政治与精神新生。",
    "start": 85.369,
    "end": 88.347,
    "duration": 2.978
  },
  {
    "id": 29,
    "text": "随着延安文艺座谈会确立工农兵方向，",
    "start": 88.347,
    "end": 90.922,
    "duration": 2.575
  },
  {
    "id": 30,
    "text": "文学深刻反思了小资产阶级知识分子的自私空想与软弱动摇。",
    "start": 90.922,
    "end": 95.308,
    "duration": 4.386
  },
  {
    "id": 31,
    "text": "丁玲在《太阳照在桑干河上》中塑造的章品、",
    "start": 95.308,
    "end": 99.583,
    "duration": 4.275
  },
  {
    "id": 32,
    "text": "文采等工作组知识分子，深入土改一线与农民同吃同住同劳动，",
    "start": 99.583,
    "end": 105.822,
    "duration": 6.239
  },
  {
    "id": 33,
    "text": "在火热群众运动的熔炉中洗刷资产阶级虚荣，",
    "start": 105.822,
    "end": 124.299,
    "duration": 18.477
  },
  {
    "id": 34,
    "text": "真正转变为与工农群众休戚与共的无产阶级革命文艺战士。",
    "start": 124.299,
    "end": 128.928,
    "duration": 4.629
  }
]