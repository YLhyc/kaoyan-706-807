[
  {
    "id": 1,
    "text": "自五四新文化运动以来，中国现当代知识分子形象的文学书写，深刻折射出知识阶层在启蒙、抗争与历史转折中的精神困境与道路抉择。",
    "start": 0.117,
    "end": 11.948,
    "duration": 11.831
  },
  {
    "id": 2,
    "text": "其百年形象演变主要经历以下三个阶段：",
    "start": 12.498,
    "end": 15.325,
    "duration": 2.827
  },
  {
    "id": 3,
    "text": "第一，五四启蒙时期：先觉者的觉醒与苦闷徘徊。",
    "start": 16.008,
    "end": 20.573,
    "duration": 4.565
  },
  {
    "id": 4,
    "text": "五四早期，鲁迅在《狂人日记》中塑造了看破礼教“吃人”本质的启蒙先驱；",
    "start": 21.073,
    "end": 26.618,
    "duration": 5.545
  },
  {
    "id": 5,
    "text": "随后随着新文化阵营分化，鲁迅在《彷徨》中沉痛剖析了脱离民众的个人启蒙者遭遇的孤立困境。",
    "start": 27.118,
    "end": 33.892,
    "duration": 6.774
  },
  {
    "id": 6,
    "text": "《在酒楼上》的吕纬甫由昔日激进青年沦为替亡弟迁葬、教读“子曰诗云”的颓唐者；",
    "start": 34.392,
    "end": 41.856,
    "duration": 7.464
  },
  {
    "id": 7,
    "text": "《孤独者》中的魏连殳从孤傲抗争妥协为军阀幕僚，",
    "start": 42.356,
    "end": 46.476,
    "duration": 4.12
  },
  {
    "id": 8,
    "text": "揭示出缺乏社会根基的个体反叛面临的精神死局。",
    "start": 46.826,
    "end": 50.885,
    "duration": 4.059
  },
  {
    "id": 9,
    "text": "第二，大革命退潮至四十年代：时代激流下的分化与精神围困。",
    "start": 51.487,
    "end": 56.587,
    "duration": 5.1
  },
  {
    "id": 10,
    "text": "面对革命浪潮与民族危机，知识分子群体发生明显分化：",
    "start": 57.181,
    "end": 61.857,
    "duration": 4.676
  },
  {
    "id": 11,
    "text": "巴金《家》中的觉慧毅然决裂封建家庭奔向新生活，",
    "start": 62.431,
    "end": 66.67,
    "duration": 4.239
  },
  {
    "id": 12,
    "text": "茅盾《动摇》中的方罗兰则在左右势力拉扯中优柔动摇；",
    "start": 67.069,
    "end": 71.022,
    "duration": 3.953
  },
  {
    "id": 13,
    "text": "四十年代，钱锺书在《围城》中刻画了方鸿渐这一留学归国却处处受困的灰色文人典型，",
    "start": 71.522,
    "end": 78.379,
    "duration": 6.857
  },
  {
    "id": 14,
    "text": "他在谋职、婚恋与三闾大学的人际倾轧中进退失据，",
    "start": 78.729,
    "end": 82.924,
    "duration": 4.195
  },
  {
    "id": 15,
    "text": "展现出传统与现代文明夹击下知识阶层的精神困顿。",
    "start": 83.274,
    "end": 87.275,
    "duration": 4.001
  },
  {
    "id": 16,
    "text": "第三，解放区及当代时期：在投身工农、挫折反思中坚守理想。",
    "start": 87.929,
    "end": 93.214,
    "duration": 5.285
  },
  {
    "id": 17,
    "text": "延安文艺座谈会后，文学着重审视知识分子的思想弱点与实践道路：",
    "start": 93.714,
    "end": 99.205,
    "duration": 5.491
  },
  {
    "id": 18,
    "text": "丁玲既在《在医院中》借女医生陆萍揭示现代科学民主意识与落后小生产习气的冲突，",
    "start": 99.58,
    "end": 106.855,
    "duration": 7.275
  },
  {
    "id": 19,
    "text": "也在《太阳照在桑干河上》中塑造了深入实际的领导干部章品，",
    "start": 107.205,
    "end": 111.809,
    "duration": 4.604
  },
  {
    "id": 20,
    "text": "并批评了工作组长文采脱离群众的教条作风；",
    "start": 112.159,
    "end": 115.783,
    "duration": 3.624
  },
  {
    "id": 21,
    "text": "及至当代新时期，谌容《人到中年》中的眼科医生陆文婷在生活重压下仍恪守医者良知，",
    "start": 116.283,
    "end": 123.896,
    "duration": 7.613
  },
  {
    "id": 22,
    "text": "体现出一代知识分子历尽沧桑后的精神坚守。",
    "start": 124.246,
    "end": 128.204,
    "duration": 3.958
  }
]
