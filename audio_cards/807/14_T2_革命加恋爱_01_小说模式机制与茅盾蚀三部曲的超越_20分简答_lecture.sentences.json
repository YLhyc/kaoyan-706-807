[
  {
    "id": 1,
    "text": "大革命失败前后，以蒋光慈等创造社、太阳社作家为代表，",
    "start": 0.103,
    "end": 4.996,
    "duration": 4.893
  },
  {
    "id": 2,
    "text": "在现代文学史上掀起了“革命加恋爱”的小说风潮。",
    "start": 5.37,
    "end": 9.189,
    "duration": 3.819
  },
  {
    "id": 3,
    "text": "这一模式迅速成为三十年代左翼文学吸引青年读者的文体母本，",
    "start": 9.578,
    "end": 14.257,
    "duration": 4.679
  },
  {
    "id": 4,
    "text": "其发生机制、",
    "start": 14.638,
    "end": 15.628,
    "duration": 0.99
  },
  {
    "id": 5,
    "text": "艺术局限以及茅盾的深刻超越主要体现在以下三个方面：",
    "start": 15.838,
    "end": 20.232,
    "duration": 4.394
  },
  {
    "id": 6,
    "text": "第一，建构二元对抗的公式化叙事，",
    "start": 20.499,
    "end": 23.255,
    "duration": 2.756
  },
  {
    "id": 7,
    "text": "借资产阶级浪漫情爱包裹革命政治动员。",
    "start": 23.54,
    "end": 26.513,
    "duration": 2.973
  },
  {
    "id": 8,
    "text": "该模式通常遵循固定的情节套路：",
    "start": 26.8,
    "end": 29.286,
    "duration": 2.486
  },
  {
    "id": 9,
    "text": "小资产阶级知识分子青年在封建或都市恋爱中遭遇挫折，",
    "start": 29.586,
    "end": 33.917,
    "duration": 4.331
  },
  {
    "id": 10,
    "text": "经受苦闷与幻灭后，在革命战友的感召下毅然放弃个人私情，",
    "start": 34.17,
    "end": 38.914,
    "duration": 4.744
  },
  {
    "id": 11,
    "text": "投身工农武装运动，在火热斗争中实现政治觉悟的升华。",
    "start": 39.178,
    "end": 43.556,
    "duration": 4.378
  },
  {
    "id": 12,
    "text": "蒋光慈在《短裤党》《冲出云围的月亮》中以此模式迎合了激进青年的阅读心理，",
    "start": 43.775,
    "end": 49.219,
    "duration": 5.444
  },
  {
    "id": 13,
    "text": "但过度将革命概念化、脸谱化，",
    "start": 49.342,
    "end": 51.604,
    "duration": 2.262
  },
  {
    "id": 14,
    "text": "导致思想说教严重削弱了艺术审美。",
    "start": 51.858,
    "end": 54.654,
    "duration": 2.796
  },
  {
    "id": 15,
    "text": "第二，陷入主观抒情狂热与人物心理简单化的概念化创作弊端。",
    "start": 54.853,
    "end": 59.519,
    "duration": 4.666
  },
  {
    "id": 16,
    "text": "早期模式作品往往缺乏对中国社会复杂阶级关系的实证把握，",
    "start": 59.674,
    "end": 64.352,
    "duration": 4.678
  },
  {
    "id": 17,
    "text": "人物非黑即白，恋爱往往沦为宣讲政论口号的传声筒，",
    "start": 64.401,
    "end": 68.297,
    "duration": 3.896
  },
  {
    "id": 18,
    "text": "革命斗争则被浪漫化为热血冒险，",
    "start": 68.411,
    "end": 70.843,
    "duration": 2.432
  },
  {
    "id": 19,
    "text": "既无法深入解剖知识分子的阶级脱胎之痛，",
    "start": 70.902,
    "end": 74.069,
    "duration": 3.167
  },
  {
    "id": 20,
    "text": "亦回避了革命历史退潮期的残酷与严峻考验。",
    "start": 74.147,
    "end": 77.576,
    "duration": 3.429
  },
  {
    "id": 21,
    "text": "第三，茅盾在《蚀》三部曲中解构虚饰神话，",
    "start": 77.783,
    "end": 81.351,
    "duration": 3.568
  },
  {
    "id": 22,
    "text": "深刻揭示大革命退潮期小资产阶级的精神创伤。",
    "start": 81.669,
    "end": 85.578,
    "duration": 3.909
  },
  {
    "id": 23,
    "text": "茅盾断然拒绝廉价的革命乐观主义，",
    "start": 85.755,
    "end": 89.072,
    "duration": 3.317
  },
  {
    "id": 24,
    "text": "以《幻灭》《动摇》《追求》敏锐记录了动荡岁月中知识分子的灵魂阵痛。",
    "start": 89.072,
    "end": 93.965,
    "duration": 4.893
  },
  {
    "id": 25,
    "text": "无论是静女士投身革命却遭投机分子玩弄的幻灭、",
    "start": 94.345,
    "end": 98.067,
    "duration": 3.722
  },
  {
    "id": 26,
    "text": "方罗兰在右派背叛与工农运动间的优柔动摇，",
    "start": 98.537,
    "end": 102.093,
    "duration": 3.556
  },
  {
    "id": 27,
    "text": "还是章秋柳在政治无望后借放浪情欲麻痹灵魂的疯狂追求，",
    "start": 102.427,
    "end": 107.326,
    "duration": 4.899
  },
  {
    "id": 28,
    "text": "茅盾以冷峻深邃的现实主义笔触还原了历史低潮期生命的真实悲剧，",
    "start": 107.569,
    "end": 112.661,
    "duration": 5.092
  },
  {
    "id": 29,
    "text": "成功将这一模式提升至现代社会心理剖析的高度。",
    "start": 113.013,
    "end": 116.856,
    "duration": 3.843
  }
]
