[
  {
    "id": 1,
    "text": "大革命失败前后，以蒋光慈等后期创造社、太阳社作家为代表，",
    "start": 0.116,
    "end": 5.065,
    "duration": 4.949
  },
  {
    "id": 2,
    "text": "现代文坛兴起了“革命加恋爱”的小说创作风潮。",
    "start": 5.413,
    "end": 8.756,
    "duration": 3.343
  },
  {
    "id": 3,
    "text": "这一模式一度成为三十年代初期左翼文学吸引青年读者的重要样式，",
    "start": 8.978,
    "end": 14.062,
    "duration": 5.084
  },
  {
    "id": 4,
    "text": "其叙事机制、",
    "start": 14.216,
    "end": 15.12,
    "duration": 0.904
  },
  {
    "id": 5,
    "text": "艺术局限以及茅盾的突破主要体现在以下三个方面：",
    "start": 15.28,
    "end": 18.936,
    "duration": 3.656
  },
  {
    "id": 6,
    "text": "第一，建构二元对抗的公式化叙事，以浪漫情爱包裹革命动员。",
    "start": 19.604,
    "end": 24.429,
    "duration": 4.825
  },
  {
    "id": 7,
    "text": "该模式通常遵循固定套路：",
    "start": 24.581,
    "end": 26.487,
    "duration": 1.906
  },
  {
    "id": 8,
    "text": "小资产阶级青年在家庭或都市恋爱中遭遇挫折，",
    "start": 26.895,
    "end": 30.724,
    "duration": 3.829
  },
  {
    "id": 9,
    "text": "陷入苦闷幻灭后，在革命者感召下放弃个人私情，",
    "start": 31.064,
    "end": 35.152,
    "duration": 4.088
  },
  {
    "id": 10,
    "text": "投身工农斗争并坚定革命信仰。",
    "start": 35.311,
    "end": 38.071,
    "duration": 2.76
  },
  {
    "id": 11,
    "text": "蒋光慈在《野祭》《冲出云围的月亮》与洪灵菲在《流亡》中均沿用此类写法，",
    "start": 38.333,
    "end": 43.91,
    "duration": 5.577
  },
  {
    "id": 12,
    "text": "契合了激进青年的阅读心理，但将革命概念化、脸谱化的做法，",
    "start": 44.362,
    "end": 49.13,
    "duration": 4.768
  },
  {
    "id": 13,
    "text": "使思想说教往往削弱了作品的艺术感染力。",
    "start": 49.311,
    "end": 52.347,
    "duration": 3.036
  },
  {
    "id": 14,
    "text": "第二，陷入主观抒情狂热与人物心理简单化的概念化弊端。",
    "start": 53.017,
    "end": 58.33,
    "duration": 5.313
  },
  {
    "id": 15,
    "text": "早期模式作品往往缺乏对中国社会复杂阶级关系的深入体察，",
    "start": 59.194,
    "end": 63.883,
    "duration": 4.689
  },
  {
    "id": 16,
    "text": "人物正邪分明、性格扁平，恋爱多沦为宣讲政治观念的载体，",
    "start": 64.466,
    "end": 69.397,
    "duration": 4.931
  },
  {
    "id": 17,
    "text": "革命斗争则被浪漫化为热血传奇，",
    "start": 69.944,
    "end": 72.539,
    "duration": 2.595
  },
  {
    "id": 18,
    "text": "既难以深入剖析知识分子思想转变的阵痛，",
    "start": 72.706,
    "end": 75.9,
    "duration": 3.194
  },
  {
    "id": 19,
    "text": "也回避了大革命退潮期的严峻考验。",
    "start": 76.3,
    "end": 78.937,
    "duration": 2.637
  },
  {
    "id": 20,
    "text": "第三，茅盾在《蚀》三部曲中摒弃廉价幻象，",
    "start": 79.555,
    "end": 83.357,
    "duration": 3.802
  },
  {
    "id": 21,
    "text": "揭示退潮期知识分子的精神创伤。",
    "start": 83.826,
    "end": 86.287,
    "duration": 2.461
  },
  {
    "id": 22,
    "text": "茅盾拒绝空洞的乐观宣传，",
    "start": 86.886,
    "end": 88.938,
    "duration": 2.052
  },
  {
    "id": 23,
    "text": "以《幻灭》《动摇》《追求》敏锐记录了动荡岁月中青年的精神困惑。",
    "start": 89.35,
    "end": 94.571,
    "duration": 5.221
  },
  {
    "id": 24,
    "text": "无论是静女士投身革命却遭投机分子玩弄后的幻灭、",
    "start": 95.022,
    "end": 98.847,
    "duration": 3.825
  },
  {
    "id": 25,
    "text": "方罗兰在左右夹击中的优柔动摇，",
    "start": 99.074,
    "end": 101.757,
    "duration": 2.683
  },
  {
    "id": 26,
    "text": "还是章秋柳在政治苦闷中借放浪情欲麻痹自我的畸形追求，",
    "start": 102.05,
    "end": 107.152,
    "duration": 5.102
  },
  {
    "id": 27,
    "text": "茅盾均以冷静写实的笔触还原了历史低潮期生命的真实挣扎，",
    "start": 107.793,
    "end": 112.6,
    "duration": 4.807
  },
  {
    "id": 28,
    "text": "将这一题材提升至现代社会心理剖析的新高度。",
    "start": 113.086,
    "end": 116.905,
    "duration": 3.819
  }
]