[
  {
    "id": 1,
    "text": "大革命失败前后，以蒋光慈等创造社、太阳社作家为代表，",
    "start": 0.08,
    "end": 4.4,
    "duration": 4.32
  },
  {
    "id": 2,
    "text": "在现代文学史上掀起了“革命加恋爱”的小说风潮。",
    "start": 4.4,
    "end": 9.12,
    "duration": 4.72
  },
  {
    "id": 3,
    "text": "这一模式迅速成为三十年代左翼文学吸引青年读者的文体母本，",
    "start": 9.52,
    "end": 14.8,
    "duration": 5.28
  },
  {
    "id": 4,
    "text": "其发生机制、",
    "start": 14.8,
    "end": 16.08,
    "duration": 1.28
  },
  {
    "id": 5,
    "text": "艺术局限以及茅盾的深刻超越主要体现在以下三个方面：",
    "start": 16.08,
    "end": 20.64,
    "duration": 4.56
  },
  {
    "id": 6,
    "text": "第一，建构二元对抗的公式化叙事，",
    "start": 20.64,
    "end": 24.08,
    "duration": 3.44
  },
  {
    "id": 7,
    "text": "借资产阶级浪漫情爱包裹革命政治动员。",
    "start": 24.08,
    "end": 27.2,
    "duration": 3.12
  },
  {
    "id": 8,
    "text": "该模式通常遵循固定的情节套路：",
    "start": 27.2,
    "end": 30.24,
    "duration": 3.04
  },
  {
    "id": 9,
    "text": "小资产阶级知识分子青年在封建或都市恋爱中遭遇挫折，",
    "start": 30.24,
    "end": 35.12,
    "duration": 4.88
  },
  {
    "id": 10,
    "text": "经受苦闷与幻灭后，在革命战友的感召下毅然放弃个人私情，",
    "start": 35.12,
    "end": 40.32,
    "duration": 5.2
  },
  {
    "id": 11,
    "text": "投身工农武装运动，在火热斗争中实现政治觉悟的升华。",
    "start": 40.32,
    "end": 45.52,
    "duration": 5.2
  },
  {
    "id": 12,
    "text": "蒋光慈在《短裤党》《冲出云围的月亮》中以此模式迎合了激进青年的阅读心理，",
    "start": 45.52,
    "end": 52.16,
    "duration": 6.64
  },
  {
    "id": 13,
    "text": "但过度将革命概念化、脸谱化，",
    "start": 52.16,
    "end": 54.72,
    "duration": 2.56
  },
  {
    "id": 14,
    "text": "导致思想说教严重削弱了艺术审美。",
    "start": 54.72,
    "end": 57.68,
    "duration": 2.96
  },
  {
    "id": 15,
    "text": "第二，陷入主观抒情狂热与人物心理简单化的概念化创作弊端。",
    "start": 57.68,
    "end": 62.8,
    "duration": 5.12
  },
  {
    "id": 16,
    "text": "早期模式作品往往缺乏对中国社会复杂阶级关系的实证把握，",
    "start": 62.8,
    "end": 67.6,
    "duration": 4.8
  },
  {
    "id": 17,
    "text": "人物非黑即白，恋爱往往沦为宣讲政论口号的传声筒，",
    "start": 67.6,
    "end": 71.92,
    "duration": 4.32
  },
  {
    "id": 18,
    "text": "革命斗争则被浪漫化为热血冒险，",
    "start": 71.92,
    "end": 74.56,
    "duration": 2.64
  },
  {
    "id": 19,
    "text": "既无法深入解剖知识分子的阶级脱胎之痛，",
    "start": 74.56,
    "end": 78.4,
    "duration": 3.84
  },
  {
    "id": 20,
    "text": "亦回避了革命历史退潮期的残酷与严峻考验。",
    "start": 78.4,
    "end": 82.64,
    "duration": 4.24
  },
  {
    "id": 21,
    "text": "第三，茅盾在《蚀》三部曲中解构虚饰神话，",
    "start": 82.64,
    "end": 86.24,
    "duration": 3.6
  },
  {
    "id": 22,
    "text": "深刻揭示大革命退潮期小资产阶级的精神创伤。",
    "start": 86.24,
    "end": 91.12,
    "duration": 4.88
  },
  {
    "id": 23,
    "text": "茅盾断然拒绝廉价的革命乐观主义，",
    "start": 91.12,
    "end": 93.68,
    "duration": 2.56
  },
  {
    "id": 24,
    "text": "以《幻灭》《动摇》《追求》敏锐记录了动荡岁月中知识分子的灵魂阵痛。",
    "start": 93.68,
    "end": 100.56,
    "duration": 6.88
  },
  {
    "id": 25,
    "text": "无论是静女士投身革命却遭投机分子玩弄的幻灭、",
    "start": 100.56,
    "end": 105.2,
    "duration": 4.64
  },
  {
    "id": 26,
    "text": "方罗兰在右派背叛与工农运动间的优柔动摇，",
    "start": 105.2,
    "end": 108.88,
    "duration": 3.68
  },
  {
    "id": 27,
    "text": "还是章秋柳在政治无望后借放浪情欲麻痹灵魂的疯狂追求，",
    "start": 108.88,
    "end": 113.68,
    "duration": 4.8
  },
  {
    "id": 28,
    "text": "茅盾以冷峻深邃的现实主义笔触还原了历史低潮期生命的真实悲剧，",
    "start": 113.68,
    "end": 116.8,
    "duration": 3.12
  },
  {
    "id": 29,
    "text": "成功将这一模式提升至现代社会心理剖析的高度。",
    "start": 116.4,
    "end": 116.8,
    "duration": 0.4
  }
]