[
  {
    "id": 1,
    "text": "简析郁达夫《沉沦》的“自叙传”抒情体制与“零余者”人物形象。",
    "start": 0.2,
    "end": 5.16,
    "duration": 4.96
  },
  {
    "id": 2,
    "text": "作为五四前期创造社的核心小说家，郁达夫凭短篇小说集《沉沦》打破传统叙事重外部情节的定势，",
    "start": 5.68,
    "end": 14.0,
    "duration": 8.32
  },
  {
    "id": 3,
    "text": "开创了现代“自叙传”抒情小说流派，深刻抒写出五四退潮期青年知识分子的心灵苦闷。",
    "start": 14.37,
    "end": 21.73,
    "duration": 7.36
  },
  {
    "id": 4,
    "text": "第一，首创直抒胸臆的“自叙传”主情小说体制，拓宽现代短篇结构边界。",
    "start": 22.25,
    "end": 28.17,
    "duration": 5.92
  },
  {
    "id": 5,
    "text": "郁达夫吸收欧洲浪漫主义及日本“私小说”创作经验，",
    "start": 28.69,
    "end": 33.044,
    "duration": 4.354
  },
  {
    "id": 6,
    "text": "主张一切文学作品皆是作家的“自叙传”。",
    "start": 33.399,
    "end": 36.58,
    "duration": 3.181
  },
  {
    "id": 7,
    "text": "《沉沦》弱化戏剧性外部波折，以留日学生“他”的精神抑郁为主脉，",
    "start": 37.1,
    "end": 42.03,
    "duration": 4.93
  },
  {
    "id": 8,
    "text": "频繁穿插日记自白、自然景物烘托与坦率心理独白，",
    "start": 42.4,
    "end": 46.48,
    "duration": 4.08
  },
  {
    "id": 9,
    "text": "形成信笔直书、以情绪起伏串联全篇的情感型结构，",
    "start": 46.901,
    "end": 51.57,
    "duration": 4.669
  },
  {
    "id": 10,
    "text": "打破传统伦理避讳，掀起震动一时的个性解放风潮。",
    "start": 51.94,
    "end": 56.34,
    "duration": 4.4
  },
  {
    "id": 11,
    "text": "第二，刻画深受社会挤压却不愿同流合污的“零余者”抒情主人公群像。",
    "start": 56.86,
    "end": 62.94,
    "duration": 6.08
  },
  {
    "id": 12,
    "text": "郁达夫笔下的主人公大多是身处异乡或穷困都市、有志难申的苦闷青年。",
    "start": 63.46,
    "end": 70.02,
    "duration": 6.56
  },
  {
    "id": 13,
    "text": "《沉沦》中的留日学生既感青春期灵肉需求遭到世俗压抑，又时时承受“中国留学生”屈辱所激发的爱国痛感，",
    "start": 70.54,
    "end": 79.95,
    "duration": 9.41
  },
  {
    "id": 14,
    "text": "在孤立无援与自我嫌恶中投海自尽，临终疾呼“祖国呀，祖国！我的死是你害我的！”，",
    "start": 80.32,
    "end": 88.13,
    "duration": 7.81
  },
  {
    "id": 15,
    "text": "将个体变态抑郁与弱国国民尊严紧扣在一起，成为五四一代知识青年精神失落的真实写照。",
    "start": 88.5,
    "end": 95.78,
    "duration": 7.28
  },
  {
    "id": 16,
    "text": "第三，呈现率真坦诚的“感伤病态美”，滋养现代表现自我小说传统。",
    "start": 96.3,
    "end": 102.62,
    "duration": 6.32
  },
  {
    "id": 17,
    "text": "郁达夫以毫不遮掩的自我解剖直面现代人性欲、贫病与忧愤，",
    "start": 103.14,
    "end": 108.966,
    "duration": 5.826
  },
  {
    "id": 18,
    "text": "在《春风沉醉的晚上》中让都市亭子间文人与女工陈二妹“同是天涯沦落人”般彼此照拂，",
    "start": 109.316,
    "end": 116.23,
    "duration": 6.914
  },
  {
    "id": 19,
    "text": "赋“倡优士子”古典悲悯以现代平民色泽；",
    "start": 116.6,
    "end": 120.28,
    "duration": 3.68
  },
  {
    "id": 20,
    "text": "而早期《沉沦》《春风沉醉的晚上》等名篇开启的感伤抒情传统，",
    "start": 120.8,
    "end": 125.68,
    "duration": 4.88
  },
  {
    "id": 21,
    "text": "至后期《迟桂花》则逐步转向宁静和谐的人性净化，",
    "start": 126.05,
    "end": 130.13,
    "duration": 4.08
  },
  {
    "id": 22,
    "text": "在现代文坛深远影响了废名、庐隐等主观抒情小说的发展。",
    "start": 130.5,
    "end": 134.98,
    "duration": 4.48
  }
]
