[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 3.12,
    "duration": 3.04
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 3.12,
    "end": 5.84,
    "duration": 2.72
  },
  {
    "id": 3,
    "text": "这道题考查中国现代小说的开山之作《狂人日记》。",
    "start": 5.84,
    "end": 9.68,
    "duration": 3.84
  },
  {
    "id": 4,
    "text": "在考场上，考生必须紧扣茅盾提出的“表现的深切”与“格式的特别”两大题眼。",
    "start": 9.68,
    "end": 16.16,
    "duration": 6.48
  },
  {
    "id": 5,
    "text": "核心在于回答：鲁迅究竟在思想上如何深刻揭露“吃人”礼教，",
    "start": 16.16,
    "end": 21.2,
    "duration": 5.04
  },
  {
    "id": 6,
    "text": "又在形式上如何以文白双重结构与现代意识流打破古典小说模式。",
    "start": 21.2,
    "end": 26.32,
    "duration": 5.12
  },
  {
    "id": 7,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 26.64,
    "end": 29.6,
    "duration": 2.96
  },
  {
    "id": 8,
    "text": "答题必须确立“思想深度（表现之深切）趋近于、",
    "start": 29.6,
    "end": 33.102,
    "duration": 3.502
  },
  {
    "id": 9,
    "text": "文体形式（格式之特别）趋近于、启蒙精神内核”的递进逻辑。",
    "start": 33.102,
    "end": 37.873,
    "duration": 4.771
  },
  {
    "id": 10,
    "text": "先剖析历史字缝里的吃人揭露与社会共谋，",
    "start": 37.873,
    "end": 41.606,
    "duration": 3.733
  },
  {
    "id": 11,
    "text": "次剖析文言序言与白话正文的反讽结构，",
    "start": 41.606,
    "end": 45.132,
    "duration": 3.526
  },
  {
    "id": 12,
    "text": "最后由狂人自我反省与“救救孩子”升华启蒙主题。",
    "start": 45.132,
    "end": 49.28,
    "duration": 4.148
  },
  {
    "id": 13,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 49.44,
    "end": 52.56,
    "duration": 3.12
  },
  {
    "id": 14,
    "text": "全题分为四个核心论述维度：第一维度：界定《狂人日记》作为现代小说发认与思想革命先锋的崇高坐标；",
    "start": 52.56,
    "end": 61.44,
    "duration": 8.88
  },
  {
    "id": 15,
    "text": "第二维度：深入剖析“表现的深切”，",
    "start": 61.44,
    "end": 64.4,
    "duration": 2.96
  },
  {
    "id": 16,
    "text": "历史哲学批判、礼教“吃人”本质与全社会共谋机制；",
    "start": 64.4,
    "end": 68.4,
    "duration": 4.0
  },
  {
    "id": 17,
    "text": "第三维度：精细剖析“格式的特别”，",
    "start": 68.72,
    "end": 71.6,
    "duration": 2.88
  },
  {
    "id": 18,
    "text": "文言序言与白话正文双重视角反讽、",
    "start": 71.6,
    "end": 74.72,
    "duration": 3.12
  },
  {
    "id": 19,
    "text": "主观意识流与象征体系；",
    "start": 74.72,
    "end": 76.88,
    "duration": 2.16
  },
  {
    "id": 20,
    "text": "第四维度：深刻论述狂人启蒙反抗者形象、",
    "start": 76.88,
    "end": 80.48,
    "duration": 3.6
  },
  {
    "id": 21,
    "text": "自我反思机制与“救救孩子”的深沉悲敏；",
    "start": 80.48,
    "end": 83.6,
    "duration": 3.12
  },
  {
    "id": 22,
    "text": "第五维度：宏观总结作品在思想启蒙与文体转型上的开山定论。",
    "start": 83.6,
    "end": 88.48,
    "duration": 4.88
  },
  {
    "id": 23,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 88.8,
    "end": 93.04,
    "duration": 4.24
  },
  {
    "id": 24,
    "text": "全题逻辑严密咬合：第一步先确立名篇作为现代第一篇小说的定论。",
    "start": 93.04,
    "end": 98.8,
    "duration": 5.76
  },
  {
    "id": 25,
    "text": "第二步展开思想内容之深，分析吃人与共谋。",
    "start": 98.8,
    "end": 102.56,
    "duration": 3.76
  },
  {
    "id": 26,
    "text": "第三步探究这种惊世思想如何必须匹配惊世的形式，",
    "start": 102.56,
    "end": 107.36,
    "duration": 4.8
  },
  {
    "id": 27,
    "text": "剖析双重结构。",
    "start": 107.36,
    "end": 108.48,
    "duration": 1.12
  },
  {
    "id": 28,
    "text": "第四步将思想与形式收束到狂人启蒙主体的心理与拯救呼喊中。",
    "start": 108.72,
    "end": 114.64,
    "duration": 5.92
  },
  {
    "id": 29,
    "text": "第五步完成宏观历史论证闭环。",
    "start": 114.64,
    "end": 117.52,
    "duration": 2.88
  },
  {
    "id": 30,
    "text": "二、各板块逐句咬合演练。",
    "start": 117.52,
    "end": 120.24,
    "duration": 2.72
  },
  {
    "id": 31,
    "text": "一、开头破题段内部咬合。",
    "start": 120.24,
    "end": 122.88,
    "duration": 2.64
  },
  {
    "id": 32,
    "text": "本段旨在开门见山确立开山奠基之作的立论基石。",
    "start": 122.88,
    "end": 127.28,
    "duration": 4.4
  },
  {
    "id": 33,
    "text": "首句直切经典地位，次句引入茅盾权威评语，",
    "start": 127.28,
    "end": 131.28,
    "duration": 4.0
  },
  {
    "id": 34,
    "text": "末句开启思想与形式两翼。",
    "start": 131.28,
    "end": 133.28,
    "duration": 2.0
  },
  {
    "id": 35,
    "text": "首先，首句必须直接亮出该作在中国现代文学史上的绝对源头地位，",
    "start": 133.648,
    "end": 139.008,
    "duration": 5.36
  },
  {
    "id": 36,
    "text": "具体表述到答题语句就是：一九一八年鲁迅发表于《新青年》的《狂人日记》，",
    "start": 139.008,
    "end": 144.682,
    "duration": 5.674
  },
  {
    "id": 37,
    "text": "是中国现代白话小说的奠基与发认之作。",
    "start": 144.682,
    "end": 147.981,
    "duration": 3.299
  },
  {
    "id": 38,
    "text": "有了经典定性之后，次句必须迅速引入茅盾的著名判断，",
    "start": 147.981,
    "end": 152.444,
    "duration": 4.463
  },
  {
    "id": 39,
    "text": "具体表述到答题语句就是：茅盾曾精准评价其显示了“表现的深切和格式的特别”。",
    "start": 152.444,
    "end": 158.848,
    "duration": 6.404
  },
  {
    "id": 40,
    "text": "-随后，末句干脆利落地揭示思想革命与形式革新的最高典范，",
    "start": 158.848,
    "end": 164.193,
    "duration": 5.345
  },
  {
    "id": 41,
    "text": "具体表述到答题语句就是：小说以极其犀利的思想锋芒撕破了数千年传统封建礼教的虚伪面具，",
    "start": 164.193,
    "end": 172.744,
    "duration": 8.551
  },
  {
    "id": 42,
    "text": "又以现代西方现代主义意识流与象征手法打破了古典章回小说的传统格局，",
    "start": 172.744,
    "end": 179.585,
    "duration": 6.841
  },
  {
    "id": 43,
    "text": "树立了五四新文学思想革命与形式革新的最高典范。",
    "start": 179.585,
    "end": 184.288,
    "duration": 4.703
  },
  {
    "id": 44,
    "text": "一九一八年鲁迅发表于《新青年》的《狂人日记》，",
    "start": 184.448,
    "end": 187.808,
    "duration": 3.36
  },
  {
    "id": 45,
    "text": "是中国现代白话小说的奠基与发认之作。",
    "start": 187.808,
    "end": 191.328,
    "duration": 3.52
  },
  {
    "id": 46,
    "text": "茅盾曾精准评价其显示了“表现的深切和格式的特别”。",
    "start": 191.328,
    "end": 196.048,
    "duration": 4.72
  },
  {
    "id": 47,
    "text": "小说以极其犀利的思想锋芒撕破了数千年传统封建礼教的虚伪面具，",
    "start": 196.048,
    "end": 201.648,
    "duration": 5.6
  },
  {
    "id": 48,
    "text": "又以现代西方现代主义意识流与象征手法打破了古典章回小说的传统格局，",
    "start": 201.648,
    "end": 207.888,
    "duration": 6.24
  },
  {
    "id": 49,
    "text": "树立了五四新文学思想革命与形式革新的最高典范。",
    "start": 207.888,
    "end": 211.968,
    "duration": 4.08
  },
  {
    "id": 50,
    "text": "二、第一维度：“表现的深切”内部咬合。",
    "start": 212.288,
    "end": 215.648,
    "duration": 3.36
  },
  {
    "id": 51,
    "text": "本段任务是深入剖析“吃人”本质的历史宣判与全社会共谋机制，",
    "start": 215.648,
    "end": 221.088,
    "duration": 5.44
  },
  {
    "id": 52,
    "text": "复原具体情节。",
    "start": 221.088,
    "end": 222.608,
    "duration": 1.52
  },
  {
    "id": 53,
    "text": "首先，段首给出结论先行的分论点，",
    "start": 222.608,
    "end": 225.728,
    "duration": 3.12
  },
  {
    "id": 54,
    "text": "具体表述到答题语句就是：第一，在“表现的深切”上，",
    "start": 225.728,
    "end": 230.288,
    "duration": 4.56
  },
  {
    "id": 55,
    "text": "作品以空前冷峻的哲学历史眼光，深刻揭露了封建宗法家族制度与儒家礼教“吃人”的残酷本质。",
    "start": 230.288,
    "end": 238.128,
    "duration": 7.84
  },
  {
    "id": 56,
    "text": "-随后，调取从历史字缝中看出吃人的标志性命题，",
    "start": 238.288,
    "end": 242.392,
    "duration": 4.104
  },
  {
    "id": 57,
    "text": "具体表述到答题语句就是：鲁迅借狂人的癫狂之眼，",
    "start": 242.392,
    "end": 246.702,
    "duration": 4.31
  },
  {
    "id": 58,
    "text": "穿透了历代封建史书的仁义道德表象。",
    "start": 246.702,
    "end": 249.985,
    "duration": 3.283
  },
  {
    "id": 59,
    "text": "狂人从历史的字缝里看出了“满本都写着两个字是‘吃人’”，",
    "start": 249.985,
    "end": 254.705,
    "duration": 4.72
  },
  {
    "id": 60,
    "text": "发出了震聋发馈的历史宣判。",
    "start": 254.705,
    "end": 257.168,
    "duration": 2.463
  },
  {
    "id": 61,
    "text": "-紧接着，深入剖析人人相食的社会共谋网络，",
    "start": 257.232,
    "end": 261.202,
    "duration": 3.97
  },
  {
    "id": 62,
    "text": "具体表述到答题语句就是：更深切的是，",
    "start": 261.202,
    "end": 264.73,
    "duration": 3.528
  },
  {
    "id": 63,
    "text": "小说揭示出这种“吃人”绝非孤立事件，",
    "start": 264.73,
    "end": 268.038,
    "duration": 3.308
  },
  {
    "id": 64,
    "text": "而是全社会上下一体、人人参与其中的共谋网络。",
    "start": 268.038,
    "end": 272.449,
    "duration": 4.411
  },
  {
    "id": 65,
    "text": "从赵贵翁、何先生等乡绅统治者，到街头指指点点的平民百姓，",
    "start": 272.449,
    "end": 277.963,
    "duration": 5.514
  },
  {
    "id": 66,
    "text": "甚至连狂人自己的同胞长兄亦深陷其中。",
    "start": 277.963,
    "end": 281.712,
    "duration": 3.749
  },
  {
    "id": 67,
    "text": "-最后，调取长兄逼食妹子肉的恐怖细节，",
    "start": 281.712,
    "end": 285.031,
    "duration": 3.319
  },
  {
    "id": 68,
    "text": "提炼亲情异化与思想沉痛，具体表述到答题语句就是：鲁迅通过长兄将妹子的肉混在饭菜里逼迫狂人吃下的恐怖细节，",
    "start": 285.031,
    "end": 295.193,
    "duration": 10.162
  },
  {
    "id": 69,
    "text": "深刻揭露了封建宗法伦理对人伦亲情的彻底扭曲，",
    "start": 295.193,
    "end": 299.549,
    "duration": 4.356
  },
  {
    "id": 70,
    "text": "展现出思想启蒙者面对沉重传统负荷时的刺骨悲凉。",
    "start": 299.549,
    "end": 304.112,
    "duration": 4.563
  },
  {
    "id": 71,
    "text": "第一，在“表现的深切”上，作品以空前冷峻的哲学历史眼光，",
    "start": 304.192,
    "end": 309.232,
    "duration": 5.04
  },
  {
    "id": 72,
    "text": "深刻揭露了封建宗法家族制度与儒家礼教“吃人”的残酷本质。",
    "start": 309.232,
    "end": 314.512,
    "duration": 5.28
  },
  {
    "id": 73,
    "text": "鲁迅借狂人的癫狂之眼，穿透了历代封建史书的仁义道德表象。",
    "start": 314.512,
    "end": 319.472,
    "duration": 4.96
  },
  {
    "id": 74,
    "text": "狂人从历史的字缝里看出了“满本都写着两个字是‘吃人’”，",
    "start": 319.472,
    "end": 324.032,
    "duration": 4.56
  },
  {
    "id": 75,
    "text": "发出了震聋发馈的历史宣判。",
    "start": 324.032,
    "end": 326.272,
    "duration": 2.24
  },
  {
    "id": 76,
    "text": "更深切的是，小说揭示出这种“吃人”绝非孤立事件，",
    "start": 326.512,
    "end": 330.912,
    "duration": 4.4
  },
  {
    "id": 77,
    "text": "而是全社会上下一体、人人参与其中的共谋网络。",
    "start": 330.912,
    "end": 335.152,
    "duration": 4.24
  },
  {
    "id": 78,
    "text": "从赵贵翁、何先生等乡绅统治者，到街头指指点点的平民百姓，",
    "start": 335.152,
    "end": 340.432,
    "duration": 5.28
  },
  {
    "id": 79,
    "text": "甚至连狂人自己的同胞长兄亦深陷其中。",
    "start": 340.432,
    "end": 344.032,
    "duration": 3.6
  },
  {
    "id": 80,
    "text": "鲁迅通过长兄将妹子的肉混在饭菜里逼迫狂人吃下的恐怖细节，",
    "start": 344.032,
    "end": 349.472,
    "duration": 5.44
  },
  {
    "id": 81,
    "text": "深刻揭露了封建宗法伦理对人伦亲情的彻底扭曲，",
    "start": 349.472,
    "end": 353.872,
    "duration": 4.4
  },
  {
    "id": 82,
    "text": "展现出思想启蒙者面对沉重传统负荷时的刺骨悲凉。",
    "start": 353.872,
    "end": 357.952,
    "duration": 4.08
  },
  {
    "id": 83,
    "text": "三、第二维度：“格式的特别”内部咬合。",
    "start": 358.272,
    "end": 361.712,
    "duration": 3.44
  },
  {
    "id": 84,
    "text": "本段任务是深入解剖文言小序与白话正文的张力，",
    "start": 361.712,
    "end": 365.712,
    "duration": 4.0
  },
  {
    "id": 85,
    "text": "以及意识流与象征体系。",
    "start": 365.712,
    "end": 368.192,
    "duration": 2.48
  },
  {
    "id": 86,
    "text": "首先，段首给出统领分论点，具体表述到答题语句就是：第二，",
    "start": 368.192,
    "end": 373.872,
    "duration": 5.68
  },
  {
    "id": 87,
    "text": "在“格式的特别”上，作品首创了“文言序言加白话正文”的复合叙事结构与主观心理体验为主轴的现代小说范式。",
    "start": 373.872,
    "end": 383.072,
    "duration": 9.2
  },
  {
    "id": 88,
    "text": "-随后，剖析脱离古典说书人模式的文言小序功能，",
    "start": 383.312,
    "end": 387.527,
    "duration": 4.215
  },
  {
    "id": 89,
    "text": "具体表述到答题语句就是：小说在形式上彻底脱离了中国古代小说的说书人体制。",
    "start": 387.527,
    "end": 394.694,
    "duration": 7.167
  },
  {
    "id": 90,
    "text": "开篇一段客观理性的文言小序，以正统士大夫口吻交代狂人病愈后“赴某地候补矣”，",
    "start": 394.694,
    "end": 401.86,
    "duration": 7.166
  },
  {
    "id": 91,
    "text": "代表着封建纲常对异端的压制与同化。",
    "start": 401.86,
    "end": 405.232,
    "duration": 3.372
  },
  {
    "id": 92,
    "text": "-紧接着，对比白话正文的癫狂独白：随后展开的十三则白话日记，",
    "start": 405.288,
    "end": 410.478,
    "duration": 5.19
  },
  {
    "id": 93,
    "text": "则是狂人充满非逻辑跳跃、幻觉惊恐与深层洞察的主观心灵独白。",
    "start": 410.478,
    "end": 415.868,
    "duration": 5.39
  },
  {
    "id": 94,
    "text": "随后，揭示这种并置产生的反讽张力：这一文言与白话、",
    "start": 415.868,
    "end": 420.259,
    "duration": 4.391
  },
  {
    "id": 95,
    "text": "外部客观叙述与内在主观癫狂的奇妙并置，",
    "start": 420.259,
    "end": 423.853,
    "duration": 3.594
  },
  {
    "id": 96,
    "text": "构成了极其严密的反讽张力。",
    "start": 423.853,
    "end": 426.248,
    "duration": 2.395
  },
  {
    "id": 97,
    "text": "-最后，指出象征隐喻体系，具体表述到答题语句就是：鲁迅广泛借鉴西方现代心理小说笔法，",
    "start": 426.248,
    "end": 433.794,
    "duration": 7.546
  },
  {
    "id": 98,
    "text": "运用意识流与象征隐喻，赋予月光、",
    "start": 433.794,
    "end": 436.65,
    "duration": 2.856
  },
  {
    "id": 99,
    "text": "恶犬、赵贵翁的眼色等物象以多重社会象征意蕴，",
    "start": 436.65,
    "end": 440.729,
    "duration": 4.079
  },
  {
    "id": 100,
    "text": "创造了中国小说史上前所未有的现代艺术体式。",
    "start": 440.729,
    "end": 444.808,
    "duration": 4.079
  },
  {
    "id": 101,
    "text": "第二，在“格式的特别”上，作品首创了“文言序言加白话正文”的复合叙事结构与主观心理体验为主轴的现代小说范式。",
    "start": 444.888,
    "end": 454.888,
    "duration": 10.0
  },
  {
    "id": 102,
    "text": "小说在形式上彻底脱离了中国古代小说的说书人体制。",
    "start": 454.888,
    "end": 459.208,
    "duration": 4.32
  },
  {
    "id": 103,
    "text": "开篇一段客观理性的文言小序，以正统士大夫口吻交代狂人病愈后“赴某地候补矣”，",
    "start": 459.208,
    "end": 466.168,
    "duration": 6.96
  },
  {
    "id": 104,
    "text": "代表着封建纲常对异端的压制与同化。",
    "start": 466.168,
    "end": 469.048,
    "duration": 2.88
  },
  {
    "id": 105,
    "text": "随后展开的十三则白话日记，则是狂人充满非逻辑跳跃、",
    "start": 469.368,
    "end": 473.848,
    "duration": 4.48
  },
  {
    "id": 106,
    "text": "幻觉惊恐与深层洞察的主观心灵独白。",
    "start": 473.848,
    "end": 477.288,
    "duration": 3.44
  },
  {
    "id": 107,
    "text": "这一文言与白话、外部客观叙述与内在主观癫狂的奇妙并置，",
    "start": 477.288,
    "end": 482.488,
    "duration": 5.2
  },
  {
    "id": 108,
    "text": "构成了极其严密的反讽张力。",
    "start": 482.488,
    "end": 485.048,
    "duration": 2.56
  },
  {
    "id": 109,
    "text": "鲁迅广泛借鉴西方现代心理小说笔法，",
    "start": 485.048,
    "end": 488.008,
    "duration": 2.96
  },
  {
    "id": 110,
    "text": "运用意识流与象征隐喻，赋予月光、",
    "start": 488.008,
    "end": 491.208,
    "duration": 3.2
  },
  {
    "id": 111,
    "text": "恶犬、赵贵翁的眼色等物象以多重社会象征意蕴，",
    "start": 491.208,
    "end": 495.368,
    "duration": 4.16
  },
  {
    "id": 112,
    "text": "创造了中国小说史上前所未有的现代艺术体式。",
    "start": 495.368,
    "end": 498.888,
    "duration": 3.52
  },
  {
    "id": 113,
    "text": "四、第三维度：启蒙精神与“救救孩子”呼喊内部咬合。",
    "start": 499.208,
    "end": 504.808,
    "duration": 5.6
  },
  {
    "id": 114,
    "text": "本段任务是深入剖析狂人的启蒙反叛性格、",
    "start": 504.808,
    "end": 508.328,
    "duration": 3.52
  },
  {
    "id": 115,
    "text": "自我忏悔意识与救救孩子的绝望抗争。",
    "start": 508.328,
    "end": 511.768,
    "duration": 3.44
  },
  {
    "id": 116,
    "text": "首先，段首给出统领分论点，具体表述到答题语句就是：第三，",
    "start": 511.768,
    "end": 517.768,
    "duration": 6.0
  },
  {
    "id": 117,
    "text": "在启蒙主义思想机制与精神品格上，",
    "start": 517.768,
    "end": 520.968,
    "duration": 3.2
  },
  {
    "id": 118,
    "text": "小说通过狂人这一“清醒的疯子”形象，",
    "start": 520.968,
    "end": 523.768,
    "duration": 2.8
  },
  {
    "id": 119,
    "text": "展现了五四先驱在绝望中抗争的伟大精神与深沉悲敏。",
    "start": 523.768,
    "end": 528.808,
    "duration": 5.04
  },
  {
    "id": 120,
    "text": "-随后，剖析狂人敢于向封建礼教宣战的启蒙反叛者本质，",
    "start": 528.968,
    "end": 533.665,
    "duration": 4.697
  },
  {
    "id": 121,
    "text": "具体表述到答题语句就是：狂人绝非普通的精神病患者，",
    "start": 533.665,
    "end": 538.362,
    "duration": 4.697
  },
  {
    "id": 122,
    "text": "而是封建专制社会中最早觉醒、敢于向庞大礼教秩序宣战的启蒙反叛者。",
    "start": 538.362,
    "end": 544.488,
    "duration": 6.126
  },
  {
    "id": 123,
    "text": "-紧接着，深入其严苛的自我剖析精神：他在恐惧中逐步认清了吃人历史的代代相传，",
    "start": 544.536,
    "end": 551.509,
    "duration": 6.973
  },
  {
    "id": 124,
    "text": "并敏锐地反省自身是否也曾无意中吃过妹子的肉，",
    "start": 551.509,
    "end": 555.816,
    "duration": 4.307
  },
  {
    "id": 125,
    "text": "展现了现代知识分子严苛的自我剖析品格。",
    "start": 555.816,
    "end": 559.507,
    "duration": 3.691
  },
  {
    "id": 126,
    "text": "最后，调取“救救孩子”的结笔，升华其启蒙使命，",
    "start": 559.507,
    "end": 563.199,
    "duration": 3.692
  },
  {
    "id": 127,
    "text": "具体表述到答题语句就是：而小说结尾处，",
    "start": 563.199,
    "end": 566.685,
    "duration": 3.486
  },
  {
    "id": 128,
    "text": "狂人在四面楚歌的沉沉黑夜中发出“救救孩子”的沉痛呼喊，",
    "start": 566.685,
    "end": 571.607,
    "duration": 4.922
  },
  {
    "id": 129,
    "text": "不仅寄托着作者对打破历史恶性循环的深切渴望，",
    "start": 571.607,
    "end": 575.914,
    "duration": 4.307
  },
  {
    "id": 130,
    "text": "更将全篇从愤怒的社会控诉升华为拯救民族未来的神圣启蒙使命。",
    "start": 575.914,
    "end": 581.656,
    "duration": 5.742
  },
  {
    "id": 131,
    "text": "第三，在启蒙主义思想机制与精神品格上，",
    "start": 581.736,
    "end": 585.656,
    "duration": 3.92
  },
  {
    "id": 132,
    "text": "小说通过狂人这一“清醒的疯子”形象，",
    "start": 585.656,
    "end": 588.616,
    "duration": 2.96
  },
  {
    "id": 133,
    "text": "展现了五四先驱在绝望中抗争的伟大精神与深沉悲敏。",
    "start": 588.616,
    "end": 593.656,
    "duration": 5.04
  },
  {
    "id": 134,
    "text": "狂人绝非普通的精神病患者，而是封建专制社会中最早觉醒、",
    "start": 593.656,
    "end": 599.096,
    "duration": 5.44
  },
  {
    "id": 135,
    "text": "敢于向庞大礼教秩序宣战的启蒙反叛者。",
    "start": 599.096,
    "end": 602.376,
    "duration": 3.28
  },
  {
    "id": 136,
    "text": "他在恐惧中逐步认清了吃人历史的代代相传，",
    "start": 602.696,
    "end": 606.136,
    "duration": 3.44
  },
  {
    "id": 137,
    "text": "并敏锐地反省自身是否也曾无意中吃过妹子的肉，",
    "start": 606.136,
    "end": 610.056,
    "duration": 3.92
  },
  {
    "id": 138,
    "text": "展现了现代知识分子严苛的自我剖析品格。",
    "start": 610.056,
    "end": 613.656,
    "duration": 3.6
  },
  {
    "id": 139,
    "text": "而小说结尾处，狂人在四面楚歌的沉沉黑夜中发出“救救孩子”的沉痛呼喊，",
    "start": 613.656,
    "end": 619.656,
    "duration": 6.0
  },
  {
    "id": 140,
    "text": "不仅寄托着作者对打破历史恶性循环的深切渴望，",
    "start": 619.656,
    "end": 623.336,
    "duration": 3.68
  },
  {
    "id": 141,
    "text": "更将全篇从愤怒的社会控诉升华为拯救民族未来的神圣启蒙使命。",
    "start": 623.336,
    "end": 628.376,
    "duration": 5.04
  },
  {
    "id": 142,
    "text": "五、结尾收束升华段内部咬合。",
    "start": 628.696,
    "end": 631.416,
    "duration": 2.72
  },
  {
    "id": 143,
    "text": "本段承担全篇论证成果的系统提炼与历史定位，",
    "start": 631.416,
    "end": 635.736,
    "duration": 4.32
  },
  {
    "id": 144,
    "text": "完成宏观历史论证闭环。",
    "start": 635.736,
    "end": 638.136,
    "duration": 2.4
  },
  {
    "id": 145,
    "text": "首先，全面回收思想深切与格式特别的开拓成果，",
    "start": 638.136,
    "end": 642.376,
    "duration": 4.24
  },
  {
    "id": 146,
    "text": "具体表述到答题语句就是：综上所述，",
    "start": 642.376,
    "end": 645.576,
    "duration": 3.2
  },
  {
    "id": 147,
    "text": "鲁迅《狂人日记》以“表现的深切”开掘了中国传统文化与国民劣根性的最深隐痛，",
    "start": 645.576,
    "end": 652.216,
    "duration": 6.64
  },
  {
    "id": 148,
    "text": "以“格式的特别”完成了中国叙事文学从古典向现代的惊世蜕变。",
    "start": 652.216,
    "end": 657.576,
    "duration": 5.36
  },
  {
    "id": 149,
    "text": "-紧接着，总结对新文化运动与整个现代文学的奠基意义，",
    "start": 657.816,
    "end": 662.459,
    "duration": 4.643
  },
  {
    "id": 150,
    "text": "具体表述到答题语句就是：它不仅吹响了五四思想启蒙运动的冲锋号角，",
    "start": 662.459,
    "end": 668.515,
    "duration": 6.056
  },
  {
    "id": 151,
    "text": "更以其博大深沉的哲理力量，确立了中国现代文学百年来不可撼动的开山原点。",
    "start": 668.515,
    "end": 675.176,
    "duration": 6.661
  },
  {
    "id": 152,
    "text": "综上所述，鲁迅《狂人日记》以“表现的深切”开掘了中国传统文化与国民劣根性的最深隐痛，",
    "start": 675.32,
    "end": 682.84,
    "duration": 7.52
  },
  {
    "id": 153,
    "text": "以“格式的特别”完成了中国叙事文学从古典向现代的惊世蜕变。",
    "start": 682.84,
    "end": 688.36,
    "duration": 5.52
  },
  {
    "id": 154,
    "text": "它不仅吹响了五四思想启蒙运动的冲锋号角，",
    "start": 688.36,
    "end": 691.72,
    "duration": 3.36
  },
  {
    "id": 155,
    "text": "更以其博大深沉的哲理力量，确立了中国现代文学百年来不可撼动的开山原点。",
    "start": 691.72,
    "end": 697.72,
    "duration": 6.0
  }
]