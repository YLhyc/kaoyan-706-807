[
  {
    "id": 1,
    "text": "结合鲁迅《狂人日记》具体文本，",
    "start": 0.106,
    "end": 2.367,
    "duration": 2.261
  },
  {
    "id": 2,
    "text": "试论其“表现的深切和格式的特别”及其启蒙主义思想意蕴。",
    "start": 2.665,
    "end": 7.913,
    "duration": 5.248
  },
  {
    "id": 3,
    "text": "五四新文化运动时期鲁迅发表于《新青年》的白话短篇小说《狂人日记》，",
    "start": 8.309,
    "end": 13.632,
    "duration": 5.323
  },
  {
    "id": 4,
    "text": "是中国现代白话小说的奠基之作。",
    "start": 13.952,
    "end": 16.263,
    "duration": 2.311
  },
  {
    "id": 5,
    "text": "鲁迅后来在《中国新文学大系·小说二集序》中概括其显示了“表现的深切和格式的特别”。",
    "start": 16.484,
    "end": 23.638,
    "duration": 7.154
  },
  {
    "id": 6,
    "text": "小说以冷峻的历史眼光揭开数千年封建宗法礼教的温情帷幕，",
    "start": 23.953,
    "end": 28.663,
    "duration": 4.71
  },
  {
    "id": 7,
    "text": "又以自觉的现代文体意识打破传统叙事格局，",
    "start": 28.891,
    "end": 32.772,
    "duration": 3.881
  },
  {
    "id": 8,
    "text": "树立了五四思想革命与形式革新的典范。",
    "start": 33.193,
    "end": 36.372,
    "duration": 3.179
  },
  {
    "id": 9,
    "text": "其思想意蕴与艺术成就主要体现在以下三个维度：",
    "start": 36.73,
    "end": 40.772,
    "duration": 4.042
  },
  {
    "id": 10,
    "text": "第一，开掘“表现的深切”，",
    "start": 41.445,
    "end": 43.629,
    "duration": 2.184
  },
  {
    "id": 11,
    "text": "揭露宗法礼教“吃人”的本质与社会共谋。",
    "start": 43.812,
    "end": 46.837,
    "duration": 3.025
  },
  {
    "id": 12,
    "text": "鲁迅借狂人的非常视角，",
    "start": 47.027,
    "end": 48.821,
    "duration": 1.794
  },
  {
    "id": 13,
    "text": "穿透历代封建史书仁义道德的虚伪修辞，",
    "start": 48.963,
    "end": 52.221,
    "duration": 3.258
  },
  {
    "id": 14,
    "text": "从历史字缝里看出满本写着的“吃人”二字，",
    "start": 52.429,
    "end": 55.974,
    "duration": 3.545
  },
  {
    "id": 15,
    "text": "向数千年专制传统发出严正宣判。",
    "start": 56.114,
    "end": 58.859,
    "duration": 2.745
  },
  {
    "id": 16,
    "text": "更为深刻的是，小说指出“吃人”不仅是个体恶行，",
    "start": 59.13,
    "end": 63.478,
    "duration": 4.348
  },
  {
    "id": 17,
    "text": "更是一张全社会普遍参与、互为因果的共谋之网。",
    "start": 63.772,
    "end": 67.363,
    "duration": 3.591
  },
  {
    "id": 18,
    "text": "从“古久先生”陈年流水簿子代表的传统积习、",
    "start": 67.729,
    "end": 71.424,
    "duration": 3.695
  },
  {
    "id": 19,
    "text": "乡绅赵贵翁的阴鸷眼色，",
    "start": 71.759,
    "end": 73.654,
    "duration": 1.895
  },
  {
    "id": 20,
    "text": "到街头指点议论的看客与把脉开方的何先生，",
    "start": 73.99,
    "end": 77.67,
    "duration": 3.68
  },
  {
    "id": 21,
    "text": "甚至连同胞长兄也被狂人视为吃人者；",
    "start": 77.921,
    "end": 81.089,
    "duration": 3.168
  },
  {
    "id": 22,
    "text": "小说更借狂人惊疑长兄把妹子的肉混入饭菜、",
    "start": 81.415,
    "end": 85.384,
    "duration": 3.969
  },
  {
    "id": 23,
    "text": "乃至反复自省“我未必无意之中，",
    "start": 85.64,
    "end": 88.652,
    "duration": 3.012
  },
  {
    "id": 24,
    "text": "不吃了我妹子的几片肉”的心理描写，",
    "start": 88.912,
    "end": 91.145,
    "duration": 2.233
  },
  {
    "id": 25,
    "text": "深入剖示了封建伦理对人伦至亲的扭曲与毒害，",
    "start": 91.49,
    "end": 95.638,
    "duration": 4.148
  },
  {
    "id": 26,
    "text": "展现出五四启蒙者触及文明创痛时的清醒。",
    "start": 95.882,
    "end": 99.396,
    "duration": 3.514
  },
  {
    "id": 27,
    "text": "第二，践行“格式的特别”，首创复合叙事框架与心理象征手法。",
    "start": 100.066,
    "end": 105.616,
    "duration": 5.55
  },
  {
    "id": 28,
    "text": "《狂人日记》脱离了中国古代小说注重有头有尾、",
    "start": 105.895,
    "end": 109.408,
    "duration": 3.513
  },
  {
    "id": 29,
    "text": "全知讲述的传统章法，",
    "start": 109.761,
    "end": 111.405,
    "duration": 1.644
  },
  {
    "id": 30,
    "text": "建立了现代小说史上前所未有的双重文本结构。",
    "start": 111.838,
    "end": 115.482,
    "duration": 3.644
  },
  {
    "id": 31,
    "text": "开篇理性冷静的文言“小序”，",
    "start": 115.948,
    "end": 118.026,
    "duration": 2.078
  },
  {
    "id": 32,
    "text": "以正统士大夫口吻交代狂人病愈后“赴某地候补矣”，",
    "start": 118.345,
    "end": 122.792,
    "duration": 4.447
  },
  {
    "id": 33,
    "text": "隐喻封建正统秩序对反叛个性的驯化与收编；",
    "start": 123.035,
    "end": 126.638,
    "duration": 3.603
  },
  {
    "id": 34,
    "text": "随后展开的十三则白话日记，则是狂人充满非逻辑跳跃、",
    "start": 126.799,
    "end": 131.093,
    "duration": 4.294
  },
  {
    "id": 35,
    "text": "惊恐幻觉与真知灼见的内心独白。",
    "start": 131.222,
    "end": 133.861,
    "duration": 2.639
  },
  {
    "id": 36,
    "text": "这种文言与白话、外部世俗常轨与内部精神反叛的并置，",
    "start": 134.058,
    "end": 138.407,
    "duration": 4.349
  },
  {
    "id": 37,
    "text": "形成了互相嘲弄与拆解的结构性反讽张力。",
    "start": 138.828,
    "end": 142.13,
    "duration": 3.302
  },
  {
    "id": 38,
    "text": "同时，鲁迅融汇西方象征主义与表现主义技巧，赋予惨白月光、",
    "start": 142.388,
    "end": 147.447,
    "duration": 5.059
  },
  {
    "id": 39,
    "text": "赵贵翁眼色、何先生诊脉等意象以社会象征意味，",
    "start": 147.576,
    "end": 151.247,
    "duration": 3.671
  },
  {
    "id": 40,
    "text": "奠定了现代白话小说的艺术高度。",
    "start": 151.457,
    "end": 154.007,
    "duration": 2.55
  },
  {
    "id": 41,
    "text": "第三，塑造“清醒的疯子”形象，",
    "start": 154.673,
    "end": 157.399,
    "duration": 2.726
  },
  {
    "id": 42,
    "text": "呈现先驱者自省与反抗绝望的精神。",
    "start": 157.69,
    "end": 160.815,
    "duration": 3.125
  },
  {
    "id": 43,
    "text": "狂人既是描摹逼真的迫害妄想症患者，",
    "start": 161.115,
    "end": 164.475,
    "duration": 3.36
  },
  {
    "id": 44,
    "text": "更是封建死屋中最早觉醒、敢于质疑“从来如此，便对么？",
    "start": 164.681,
    "end": 170.125,
    "duration": 5.444
  },
  {
    "id": 45,
    "text": "”的启蒙先驱。",
    "start": 170.227,
    "end": 171.105,
    "duration": 0.878
  },
  {
    "id": 46,
    "text": "他在严酷的生存压迫下看清了历史延续的吃人链条，",
    "start": 171.631,
    "end": 175.704,
    "duration": 4.073
  },
  {
    "id": 47,
    "text": "并在“四千年吃人履历”的拷问中敢于直面自身罪责，",
    "start": 175.953,
    "end": 180.411,
    "duration": 4.458
  },
  {
    "id": 48,
    "text": "展现出启蒙知识分子严苛的道德诚实与自审品格。",
    "start": 180.809,
    "end": 185.631,
    "duration": 4.822
  },
  {
    "id": 49,
    "text": "篇末狂人在孤立绝境中发出“救救孩子……”的沉痛呐喊，",
    "start": 185.91,
    "end": 190.786,
    "duration": 4.876
  },
  {
    "id": 50,
    "text": "蕴含着五四知识分子明知传统惯性沉重、",
    "start": 190.991,
    "end": 194.262,
    "duration": 3.271
  },
  {
    "id": 51,
    "text": "却依然反抗绝望的先知勇气，",
    "start": 194.618,
    "end": 196.846,
    "duration": 2.228
  },
  {
    "id": 52,
    "text": "将全篇升华为挽救民族未来的启蒙宣言。",
    "start": 197.055,
    "end": 200.962,
    "duration": 3.907
  },
  {
    "id": 53,
    "text": "合其思想与文体而言，",
    "start": 201.593,
    "end": 203.205,
    "duration": 1.612
  },
  {
    "id": 54,
    "text": "鲁迅《狂人日记》以“表现的深切”直击传统文化与国民性病灶，",
    "start": 203.542,
    "end": 208.681,
    "duration": 5.139
  },
  {
    "id": 55,
    "text": "以“格式的特别”推动中国叙事文学从古典向现代转型。",
    "start": 208.996,
    "end": 213.798,
    "duration": 4.802
  },
  {
    "id": 56,
    "text": "它不仅是五四新文化运动的思想先声，",
    "start": 214.214,
    "end": 216.892,
    "duration": 2.678
  },
  {
    "id": 57,
    "text": "更是中国现代小说史上具有划时代意义的奠基之作。",
    "start": 217.221,
    "end": 221.347,
    "duration": 4.126
  }
]