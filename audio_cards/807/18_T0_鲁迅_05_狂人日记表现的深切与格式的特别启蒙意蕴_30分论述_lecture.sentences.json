[
  {
    "id": 1,
    "text": "结合鲁迅《狂人日记》具体文本，试论其“表现的深切和格式的特别”及其启蒙主义思想意蕴。",
    "start": 0.05,
    "end": 7.711,
    "duration": 7.661
  },
  {
    "id": 2,
    "text": "五四新文化运动时期鲁迅发表于《新青年》的白话短篇小说《狂人日记》，",
    "start": 8.211,
    "end": 13.407,
    "duration": 5.196
  },
  {
    "id": 3,
    "text": "是中国现代白话小说的奠基之作。",
    "start": 13.92,
    "end": 16.276,
    "duration": 2.356
  },
  {
    "id": 4,
    "text": "鲁迅后来在《中国新文学大系·小说二集序》中概括其显示了“表现的深切和格式的特别”。",
    "start": 16.776,
    "end": 23.808,
    "duration": 7.032
  },
  {
    "id": 5,
    "text": "小说以冷峻的历史眼光揭开数千年封建宗法礼教的温情帷幕，",
    "start": 24.308,
    "end": 29.065,
    "duration": 4.757
  },
  {
    "id": 6,
    "text": "又以自觉的现代文体意识打破传统叙事格局，树立了五四思想革命与形式革新的典范。",
    "start": 29.579,
    "end": 36.567,
    "duration": 6.988
  },
  {
    "id": 7,
    "text": "其思想意蕴与艺术成就主要体现在以下三个维度：",
    "start": 37.067,
    "end": 40.967,
    "duration": 3.9
  },
  {
    "id": 8,
    "text": "第一，开掘“表现的深切”，揭露宗法礼教“吃人”的本质与社会共谋。",
    "start": 41.323,
    "end": 46.619,
    "duration": 5.296
  },
  {
    "id": 9,
    "text": "鲁迅借狂人的非常视角，穿透历代封建史书仁义道德的虚伪修辞，",
    "start": 47.119,
    "end": 52.242,
    "duration": 5.123
  },
  {
    "id": 10,
    "text": "从历史字缝里看出满本写着的“吃人”二字，向数千年专制传统发出严正宣判。",
    "start": 52.722,
    "end": 59.09,
    "duration": 6.368
  },
  {
    "id": 11,
    "text": "更为深刻的是，小说指出“吃人”不仅是个体恶行，更是一张全社会普遍参与、互为因果的共谋之网。",
    "start": 59.59,
    "end": 67.259,
    "duration": 7.669
  },
  {
    "id": 12,
    "text": "从“古久先生”陈年流水簿子代表的传统积习、乡绅赵贵翁的阴鸷眼色，",
    "start": 67.759,
    "end": 73.513,
    "duration": 5.754
  },
  {
    "id": 13,
    "text": "到街头指点议论的看客与把脉开方的何先生，甚至连同胞长兄也被狂人视为吃人者；",
    "start": 73.863,
    "end": 80.711,
    "duration": 6.848
  },
  {
    "id": 14,
    "text": "小说更借狂人惊疑长兄把妹子的肉混入饭菜、乃至反复自省“我未必无意之中，不吃了我妹子的几片肉”的心理描写，",
    "start": 81.211,
    "end": 89.942,
    "duration": 8.731
  },
  {
    "id": 15,
    "text": "深入剖示了封建伦理对人伦至亲的扭曲与毒害，展现出五四启蒙者触及文明创痛时的清醒。",
    "start": 90.292,
    "end": 97.846,
    "duration": 7.554
  },
  {
    "id": 16,
    "text": "第二，践行“格式的特别”，首创复合叙事框架与心理象征手法。",
    "start": 98.346,
    "end": 103.622,
    "duration": 5.276
  },
  {
    "id": 17,
    "text": "《狂人日记》脱离了中国古代小说注重有头有尾、全知讲述的传统章法，",
    "start": 104.122,
    "end": 109.379,
    "duration": 5.257
  },
  {
    "id": 18,
    "text": "建立了现代小说史上前所未有的双重文本结构。",
    "start": 109.729,
    "end": 113.668,
    "duration": 3.939
  },
  {
    "id": 19,
    "text": "开篇理性冷静的文言“小序”，以正统士大夫口吻交代狂人病愈后“赴某地候补矣”，",
    "start": 114.168,
    "end": 121.326,
    "duration": 7.158
  },
  {
    "id": 20,
    "text": "隐喻封建正统秩序对反叛个性的驯化与收编；",
    "start": 121.877,
    "end": 125.641,
    "duration": 3.764
  },
  {
    "id": 21,
    "text": "随后展开的十三则白话日记，则是狂人充满非逻辑跳跃、惊恐幻觉与真知灼见的内心独白。",
    "start": 126.141,
    "end": 134.013,
    "duration": 7.872
  },
  {
    "id": 22,
    "text": "这种文言与白话、外部世俗常轨与内部精神反叛的并置，",
    "start": 134.513,
    "end": 139.382,
    "duration": 4.869
  },
  {
    "id": 23,
    "text": "形成了互相嘲弄与拆解的结构性反讽张力。",
    "start": 139.83,
    "end": 143.225,
    "duration": 3.395
  },
  {
    "id": 24,
    "text": "同时，鲁迅融汇西方象征主义与表现主义技巧，",
    "start": 143.725,
    "end": 147.501,
    "duration": 3.776
  },
  {
    "id": 25,
    "text": "赋予惨白月光、赵贵翁眼色、何先生诊脉等意象以社会象征意味，",
    "start": 147.962,
    "end": 153.436,
    "duration": 5.474
  },
  {
    "id": 26,
    "text": "奠定了现代白话小说的艺术高度。",
    "start": 153.786,
    "end": 156.026,
    "duration": 2.24
  },
  {
    "id": 27,
    "text": "第三，塑造“清醒的疯子”形象，呈现先驱者自省与反抗绝望的精神。",
    "start": 156.526,
    "end": 162.523,
    "duration": 5.997
  },
  {
    "id": 28,
    "text": "狂人既是描摹逼真的迫害妄想症患者，更是封建死屋中最早觉醒、敢于质疑“从来如此，便对么？”的启蒙先驱。",
    "start": 163.023,
    "end": 171.882,
    "duration": 8.859
  },
  {
    "id": 29,
    "text": "他在严酷的生存压迫下看清了历史延续的吃人链条，并在“四千年吃人履历”的拷问中敢于直面自身罪责，",
    "start": 172.382,
    "end": 180.448,
    "duration": 8.066
  },
  {
    "id": 30,
    "text": "展现出启蒙知识分子严苛的道德诚实与自审品格。",
    "start": 180.798,
    "end": 185.661,
    "duration": 4.863
  },
  {
    "id": 31,
    "text": "篇末狂人在孤立绝境中发出“救救孩子……”的沉痛呐喊，",
    "start": 186.464,
    "end": 191.414,
    "duration": 4.95
  },
  {
    "id": 32,
    "text": "蕴含着五四知识分子明知传统惯性沉重、却依然反抗绝望的先知勇气，",
    "start": 191.939,
    "end": 198.094,
    "duration": 6.155
  },
  {
    "id": 33,
    "text": "将全篇升华为挽救民族未来的启蒙宣言。",
    "start": 198.444,
    "end": 202.216,
    "duration": 3.772
  },
  {
    "id": 34,
    "text": "合其思想与文体而言，鲁迅《狂人日记》以“表现的深切”直击传统文化与国民性病灶，",
    "start": 202.716,
    "end": 210.0,
    "duration": 7.284
  },
  {
    "id": 35,
    "text": "以“格式的特别”推动中国叙事文学从古典向现代转型。",
    "start": 210.418,
    "end": 215.036,
    "duration": 4.618
  },
  {
    "id": 36,
    "text": "它不仅是五四新文化运动的思想先声，更是中国现代小说史上具有划时代意义的奠基之作。",
    "start": 215.536,
    "end": 222.552,
    "duration": 7.016
  }
]
