[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "萧红·呼兰河传散文化文体与苍凉诗性",
    "start": 0.134,
    "end": 3.974,
    "duration": 3.84
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "紧扣茅盾三喻与文体内核三步成篇：1.结构上用儿童有限视角串联散文化风俗图景；",
    "start": 4.563,
    "end": 13.976,
    "duration": 9.413
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "2.情感上把“祖父后花园的暖”和“大泥坑冷酷”硬并置出张力；",
    "start": 14.173,
    "end": 20.109,
    "duration": 5.936
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "3.主题上直剖十二岁小团圆媳妇“三次沸水洗澡”遭乡邻围观惨死，写出集体无意识悲凉。",
    "start": 20.396,
    "end": 28.113,
    "duration": 7.716
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "四十年代初萧红旅居香港写成《呼兰河传》，开辟地域与女性体验“诗化小说”路径，",
    "start": 28.7,
    "end": 35.639,
    "duration": 6.939
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "茅盾誉为“一篇叙事诗，一幅多彩的风土画，一串凄婉的歌谣”。",
    "start": 35.926,
    "end": 40.951,
    "duration": 5.025
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 突破线性叙事、辟写意散文化文体范式",
    "start": 41.538,
    "end": 45.665,
    "duration": 4.127
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "打破戏剧冲突与连贯情节主线，借天真儿童的有限视角道来边陲小镇风土、庙会与生老病死；",
    "start": 46.239,
    "end": 55.352,
    "duration": 9.114
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "以散文自由笔调结构为独立又精神呼应的风俗图景，具实感与诗意韵致。",
    "start": 55.939,
    "end": 62.774,
    "duration": 6.835
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 并置童年暖意与生存严酷、显冷暖张力",
    "start": 63.361,
    "end": 68.126,
    "duration": 4.765
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "澄澈笔墨写祖父后花园黄瓜随便吃、蜻蜓任凭飞的纯真自由，予童年温暖抚慰；",
    "start": 68.713,
    "end": 77.253,
    "duration": 8.541
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "另一边冷峻写大泥坑吞牲畜、严冬冻裂房瓦与乡民麻木生存，温情与荒凉强对照传达绵长叹息。",
    "start": 77.84,
    "end": 87.995,
    "duration": 10.155
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 直面国民愚昧麻木、揭看客围观下悲凉",
    "start": 88.582,
    "end": 93.035,
    "duration": 4.452
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "健壮活泼十二岁小团圆媳妇仅因不合妇德遭婆婆毒打，",
    "start": 93.608,
    "end": 99.454,
    "duration": 5.845
  },
  {
    "id": "sec2_step0_c1",
    "dom_key": "sec2_step0_c1",
    "text": "在乡邻起哄看客围观下三次按入滚烫热水“洗澡治病”昏厥夭折；",
    "start": 99.728,
    "end": 105.339,
    "duration": 5.611
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "施暴与围观中的麻木冷漠将乡土陈腐与集体无意识残酷揭示得触目惊心。",
    "start": 105.926,
    "end": 113.308,
    "duration": 7.382
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：四十年代初旅居香港写成；茅盾名评“一篇叙事诗，一幅多彩的风土画，一串凄婉的歌谣”；",
    "start": 113.895,
    "end": 122.813,
    "duration": 8.918
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "核心意象对比：祖父后花园（暖） vs 东二道街大泥坑 & 小团圆媳妇热水澡（冷酷）。",
    "start": 123.036,
    "end": 130.456,
    "duration": 7.421
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背诵茅盾为《呼兰河传》写的三个经典比喻定评？",
    "start": 131.055,
    "end": 136.419,
    "duration": 5.364
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 从“散文化儿童视角”“后花园vs大泥坑冷暖并置”“小团圆媳妇看客围观”三步复述全篇？",
    "start": 136.993,
    "end": 146.132,
    "duration": 9.14
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 回答 2023 真题简答《萧红〈呼兰河传〉内容与风格》怎么组织材料？",
    "start": 146.719,
    "end": 153.971,
    "duration": 7.252
  }
]