[
  {
    "id": 1,
    "text": "八十年代初，汪曾祺以《受戒》《大淖记事》重返当代文坛，",
    "start": 0.109,
    "end": 4.641,
    "duration": 4.532
  },
  {
    "id": 2,
    "text": "在当代文学走出机械教条、回归审美本体的历史转折点上，",
    "start": 4.75,
    "end": 9.415,
    "duration": 4.665
  },
  {
    "id": 3,
    "text": "确立了独特的文体坐标。",
    "start": 9.499,
    "end": 11.172,
    "duration": 1.673
  },
  {
    "id": 4,
    "text": "作为京派文学在当代的薪火传人，",
    "start": 11.396,
    "end": 13.922,
    "duration": 2.526
  },
  {
    "id": 5,
    "text": "其小说的艺术特色与文体革新主要体现于以下三个方面：",
    "start": 14.045,
    "end": 18.327,
    "duration": 4.282
  },
  {
    "id": 6,
    "text": "第一，解构传统情节中心律，",
    "start": 18.577,
    "end": 20.85,
    "duration": 2.273
  },
  {
    "id": 7,
    "text": "开辟写意从容的“散文化小说”崭新范式。",
    "start": 20.971,
    "end": 24.708,
    "duration": 3.737
  },
  {
    "id": 8,
    "text": "汪曾祺断然摒弃了剑拔弩张的戏剧性冲突与因果锁链式的跌宕情节，",
    "start": 25.073,
    "end": 30.885,
    "duration": 5.812
  },
  {
    "id": 9,
    "text": "主张“短篇小说要写得像散文一样随便”。",
    "start": 31.306,
    "end": 34.329,
    "duration": 3.023
  },
  {
    "id": 10,
    "text": "在《受戒》中，小说花费大量笔墨铺叙庵赵庄的民俗风物、",
    "start": 34.728,
    "end": 39.229,
    "duration": 4.501
  },
  {
    "id": 11,
    "text": "荸荠荠菜的季节变迁与和尚收租打牌的日常闲趣；",
    "start": 39.697,
    "end": 43.756,
    "duration": 4.059
  },
  {
    "id": 12,
    "text": "在荸荠田与芦花荡荡漾的清风里，",
    "start": 43.949,
    "end": 46.652,
    "duration": 2.703
  },
  {
    "id": 13,
    "text": "明海与小英子于受戒归来的渡船上互吐心迹，",
    "start": 47.118,
    "end": 50.701,
    "duration": 3.583
  },
  {
    "id": 14,
    "text": "情爱如清泉般自然流淌，通篇展现出气韵生动、",
    "start": 51.071,
    "end": 55.075,
    "duration": 4.004
  },
  {
    "id": 15,
    "text": "情景交融的东方写意画境。",
    "start": 55.169,
    "end": 57.276,
    "duration": 2.107
  },
  {
    "id": 16,
    "text": "第二，承续沈从文人性美学，",
    "start": 57.75,
    "end": 60.146,
    "duration": 2.396
  },
  {
    "id": 17,
    "text": "建构健康自然的人性乌托邦与和美哲学。",
    "start": 60.453,
    "end": 63.592,
    "duration": 3.139
  },
  {
    "id": 18,
    "text": "汪曾祺在小说中极力发掘未被现代文明污染的民间伦理与纯朴德行。",
    "start": 63.963,
    "end": 69.391,
    "duration": 5.428
  },
  {
    "id": 19,
    "text": "在《大淖记事》中，",
    "start": 69.629,
    "end": 70.799,
    "duration": 1.17
  },
  {
    "id": 20,
    "text": "挑夫与锡匠群体身上流淌着粗粝而自尊的生命活力；",
    "start": 71.058,
    "end": 75.788,
    "duration": 4.73
  },
  {
    "id": 21,
    "text": "当十一子惨遭地方恶霸毒打摧残后，",
    "start": 76.403,
    "end": 79.459,
    "duration": 3.056
  },
  {
    "id": 22,
    "text": "巧云冲破世俗门第与道德偏见，",
    "start": 79.974,
    "end": 82.78,
    "duration": 2.806
  },
  {
    "id": 23,
    "text": "在众人注视下毅然端来参汤悉心喂服，",
    "start": 82.984,
    "end": 86.657,
    "duration": 3.673
  },
  {
    "id": 24,
    "text": "以无私纯粹的女性柔情救赎苦难肉身，彰显出一种超越苦难、",
    "start": 87.043,
    "end": 93.214,
    "duration": 6.171
  },
  {
    "id": 25,
    "text": "温润包容的人性神性光辉。",
    "start": 93.355,
    "end": 96.137,
    "duration": 2.782
  },
  {
    "id": 26,
    "text": "第三，融通古典文言与现代白话，锤炼出洗练熨帖、",
    "start": 96.341,
    "end": 101.114,
    "duration": 4.773
  },
  {
    "id": 27,
    "text": "具音乐声律的语言风格。",
    "start": 101.22,
    "end": 102.999,
    "duration": 1.779
  },
  {
    "id": 28,
    "text": "作家秉持语言即文化本体的诗学观念，将六朝笔记的凝练、",
    "start": 103.265,
    "end": 107.915,
    "duration": 4.65
  },
  {
    "id": 29,
    "text": "明清小品的风致与纯正的民间口语水乳交融。",
    "start": 108.011,
    "end": 111.906,
    "duration": 3.895
  },
  {
    "id": 30,
    "text": "其叙述句式短促空灵，用词极度脱水而意蕴丰沛，",
    "start": 112.135,
    "end": 116.37,
    "duration": 4.235
  },
  {
    "id": 31,
    "text": "以不着一字尽得风流的从容节制，",
    "start": 116.61,
    "end": 119.268,
    "duration": 2.658
  },
  {
    "id": 32,
    "text": "实现了中国现代小说语言雅俗共赏、如水银泻地般的诗意回响。",
    "start": 119.486,
    "end": 125.088,
    "duration": 5.602
  }
]
