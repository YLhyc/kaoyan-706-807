[
  {
    "id": 1,
    "text": "八十年代初，汪曾祺以《受戒》《大淖记事》重返当代文坛，",
    "start": 0.124,
    "end": 4.601,
    "duration": 4.477
  },
  {
    "id": 2,
    "text": "在当代文学走出机械教条、回归审美本体的历史转折点上，",
    "start": 4.765,
    "end": 9.374,
    "duration": 4.609
  },
  {
    "id": 3,
    "text": "确立了独特的文体坐标。",
    "start": 9.516,
    "end": 11.122,
    "duration": 1.606
  },
  {
    "id": 4,
    "text": "作为京派文学在当代的薪火传人，",
    "start": 11.411,
    "end": 13.882,
    "duration": 2.471
  },
  {
    "id": 5,
    "text": "其小说的艺术特色与文体革新主要体现于以下三个方面：",
    "start": 14.06,
    "end": 18.287,
    "duration": 4.227
  },
  {
    "id": 6,
    "text": "第一，打破传统情节中心律，",
    "start": 18.954,
    "end": 21.102,
    "duration": 2.148
  },
  {
    "id": 7,
    "text": "开辟写意从容的“散文化小说”崭新范式。",
    "start": 21.507,
    "end": 24.409,
    "duration": 2.902
  },
  {
    "id": 8,
    "text": "汪曾祺摒弃了剑拔弩张的戏剧性冲突与因果锁链式的跌宕情节，",
    "start": 25.016,
    "end": 29.805,
    "duration": 4.789
  },
  {
    "id": 9,
    "text": "主张“短篇小说要写得像散文一样随便”。",
    "start": 30.077,
    "end": 32.853,
    "duration": 2.776
  },
  {
    "id": 10,
    "text": "在《受戒》中，小说花费大量笔墨铺叙庵赵庄的民俗风物、",
    "start": 33.083,
    "end": 37.418,
    "duration": 4.335
  },
  {
    "id": 11,
    "text": "时令劳作与和尚收租打牌的日常闲趣；",
    "start": 37.677,
    "end": 41.036,
    "duration": 3.359
  },
  {
    "id": 12,
    "text": "在荸荠田与芦花荡荡漾的清风里，",
    "start": 41.625,
    "end": 44.154,
    "duration": 2.529
  },
  {
    "id": 13,
    "text": "明海与小英子于受戒归来的渡船上互吐心迹，",
    "start": 44.516,
    "end": 48.214,
    "duration": 3.698
  },
  {
    "id": 14,
    "text": "情爱如清泉般自然流淌，通篇展现出气韵生动、",
    "start": 48.818,
    "end": 52.805,
    "duration": 3.987
  },
  {
    "id": 15,
    "text": "情景交融的东方写意画境。",
    "start": 53.031,
    "end": 55.481,
    "duration": 2.45
  },
  {
    "id": 16,
    "text": "第二，承续沈从文人性美学，",
    "start": 56.146,
    "end": 58.933,
    "duration": 2.787
  },
  {
    "id": 17,
    "text": "建构健康自然的人性乌托邦与和美哲学。",
    "start": 59.102,
    "end": 62.679,
    "duration": 3.577
  },
  {
    "id": 18,
    "text": "汪曾祺在小说中极力发掘未被现代文明侵蚀的民间伦理与纯朴德行。",
    "start": 63.205,
    "end": 69.486,
    "duration": 6.281
  },
  {
    "id": 19,
    "text": "在《大淖记事》中，",
    "start": 69.955,
    "end": 71.01,
    "duration": 1.055
  },
  {
    "id": 20,
    "text": "挑夫与锡匠群体身上流淌着粗粝而自尊的生命活力；",
    "start": 71.296,
    "end": 76.288,
    "duration": 4.992
  },
  {
    "id": 21,
    "text": "十一子惨遭保安队刘号长一伙毒打摧残后，",
    "start": 76.876,
    "end": 80.329,
    "duration": 3.453
  },
  {
    "id": 22,
    "text": "巧云冲破世俗门第与道德偏见，",
    "start": 80.63,
    "end": 83.247,
    "duration": 2.617
  },
  {
    "id": 23,
    "text": "在众人注视下毅然端来参汤悉心喂服，",
    "start": 83.495,
    "end": 86.846,
    "duration": 3.351
  },
  {
    "id": 24,
    "text": "以无私纯粹的女性柔情救赎苦难肉身，彰显出超越苦难、",
    "start": 87.278,
    "end": 92.061,
    "duration": 4.783
  },
  {
    "id": 25,
    "text": "温润包容的人性光辉。",
    "start": 92.329,
    "end": 93.957,
    "duration": 1.628
  },
  {
    "id": 26,
    "text": "第三，融通古典文言与现代白话，锤炼出洗练熨帖、",
    "start": 94.586,
    "end": 99.628,
    "duration": 5.042
  },
  {
    "id": 27,
    "text": "具音乐声律的语言风格。",
    "start": 100.066,
    "end": 101.81,
    "duration": 1.744
  },
  {
    "id": 28,
    "text": "作家秉持语言即文化本体的诗学观念，将六朝笔记的凝练、",
    "start": 102.176,
    "end": 107.149,
    "duration": 4.973
  },
  {
    "id": 29,
    "text": "明清小品的风致与纯正的民间口语水乳交融。",
    "start": 107.638,
    "end": 111.38,
    "duration": 3.742
  },
  {
    "id": 30,
    "text": "其叙述句式短促空灵，用词凝练而意蕴丰沛，",
    "start": 111.751,
    "end": 115.69,
    "duration": 3.939
  },
  {
    "id": 31,
    "text": "以不着一字尽得风流的从容节制，",
    "start": 115.965,
    "end": 118.671,
    "duration": 2.706
  },
  {
    "id": 32,
    "text": "赋予中国现当代小说语言雅俗共赏的诗意神韵。",
    "start": 119.048,
    "end": 122.96,
    "duration": 3.912
  }
]