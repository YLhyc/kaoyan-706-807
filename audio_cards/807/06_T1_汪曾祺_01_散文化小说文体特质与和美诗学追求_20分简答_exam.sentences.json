[
  {
    "id": 1,
    "text": "八十年代初，汪曾祺以《受戒》《大淖记事》重返当代文坛，",
    "start": 0.0,
    "end": 4.792,
    "duration": 4.792
  },
  {
    "id": 2,
    "text": "在当代文学走出机械教条、回归审美本体的历史转折点上，",
    "start": 4.792,
    "end": 11.436,
    "duration": 6.644
  },
  {
    "id": 3,
    "text": "确立了独特的文体坐标。",
    "start": 11.436,
    "end": 14.085,
    "duration": 2.649
  },
  {
    "id": 4,
    "text": "作为京派文学在当代的薪火传人，",
    "start": 14.085,
    "end": 15.683,
    "duration": 1.598
  },
  {
    "id": 5,
    "text": "其小说的艺术特色与文体革新主要体现于以下三个方面：",
    "start": 15.683,
    "end": 21.011,
    "duration": 5.328
  },
  {
    "id": 6,
    "text": "第一，解构传统情节中心律，",
    "start": 21.011,
    "end": 22.658,
    "duration": 1.647
  },
  {
    "id": 7,
    "text": "开辟写意从容的“散文化小说”崭新范式。",
    "start": 22.658,
    "end": 28.841,
    "duration": 6.183
  },
  {
    "id": 8,
    "text": "汪曾祺断然摒弃了剑拔弩张的戏剧性冲突与因果锁链式的跌宕情节，",
    "start": 28.841,
    "end": 31.974,
    "duration": 3.133
  },
  {
    "id": 9,
    "text": "主张“短篇小说要写得像散文一样随便”。",
    "start": 31.974,
    "end": 35.849,
    "duration": 3.875
  },
  {
    "id": 10,
    "text": "在《受戒》中，小说花费大量笔墨铺叙庵赵庄的民俗风物、",
    "start": 35.849,
    "end": 43.989,
    "duration": 8.14
  },
  {
    "id": 11,
    "text": "荸荠荠菜的季节变迁与和尚收租打牌的日常闲趣；",
    "start": 43.989,
    "end": 47.158,
    "duration": 3.169
  },
  {
    "id": 12,
    "text": "在荸荠田与芦花荡荡漾的清风里，",
    "start": 47.158,
    "end": 48.475,
    "duration": 1.317
  },
  {
    "id": 13,
    "text": "明海与小英子于受戒归来的渡船上互吐心迹，",
    "start": 48.475,
    "end": 53.385,
    "duration": 4.91
  },
  {
    "id": 14,
    "text": "情爱如清泉般自然流淌，通篇展现出气韵生动、",
    "start": 53.385,
    "end": 57.79,
    "duration": 4.405
  },
  {
    "id": 15,
    "text": "情景交融的东方写意画境。",
    "start": 57.79,
    "end": 60.493,
    "duration": 2.703
  },
  {
    "id": 16,
    "text": "第二，承续沈从文人性美学，",
    "start": 60.493,
    "end": 64.003,
    "duration": 3.51
  },
  {
    "id": 17,
    "text": "建构健康自然的人性乌托邦与和美哲学。",
    "start": 64.003,
    "end": 66.2,
    "duration": 2.197
  },
  {
    "id": 18,
    "text": "汪曾祺在小说中极力发掘未被现代文明污染的民间伦理与纯朴德行。",
    "start": 66.2,
    "end": 73.203,
    "duration": 7.003
  },
  {
    "id": 19,
    "text": "在《大淖记事》中，",
    "start": 73.203,
    "end": 76.443,
    "duration": 3.24
  },
  {
    "id": 20,
    "text": "挑夫与锡匠群体身上流淌着粗粝而自尊的生命活力；",
    "start": 76.443,
    "end": 80.014,
    "duration": 3.571
  },
  {
    "id": 21,
    "text": "当十一子惨遭地方恶霸毒打摧残后，",
    "start": 80.014,
    "end": 81.892,
    "duration": 1.878
  },
  {
    "id": 22,
    "text": "巧云冲破世俗门第与道德偏见，",
    "start": 81.892,
    "end": 84.541,
    "duration": 2.649
  },
  {
    "id": 23,
    "text": "在众人注视下毅然端来参汤悉心喂服，",
    "start": 84.541,
    "end": 87.087,
    "duration": 2.546
  },
  {
    "id": 24,
    "text": "以无私纯粹的女性柔情救赎苦难肉身，彰显出一种超越苦难、",
    "start": 87.087,
    "end": 93.396,
    "duration": 6.309
  },
  {
    "id": 25,
    "text": "温润包容的人性神性光辉。",
    "start": 93.396,
    "end": 96.381,
    "duration": 2.985
  },
  {
    "id": 26,
    "text": "第三，融通古典文言与现代白话，锤炼出洗练熨帖、",
    "start": 96.381,
    "end": 101.26,
    "duration": 4.879
  },
  {
    "id": 27,
    "text": "具音乐声律的语言风格。",
    "start": 101.26,
    "end": 103.305,
    "duration": 2.045
  },
  {
    "id": 28,
    "text": "作家秉持语言即文化本体的诗学观念，将六朝笔记的凝练、",
    "start": 103.305,
    "end": 108.051,
    "duration": 4.746
  },
  {
    "id": 29,
    "text": "明清小品的风致与纯正的民间口语水乳交融。",
    "start": 108.051,
    "end": 112.175,
    "duration": 4.124
  },
  {
    "id": 30,
    "text": "其叙述句式短促空灵，用词极度脱水而意蕴丰沛，",
    "start": 112.175,
    "end": 116.65,
    "duration": 4.475
  },
  {
    "id": 31,
    "text": "以不着一字尽得风流的从容节制，",
    "start": 116.65,
    "end": 119.526,
    "duration": 2.876
  },
  {
    "id": 32,
    "text": "实现了中国现代小说语言雅俗共赏、如水银泻地般的诗意回响。",
    "start": 119.526,
    "end": 125.088,
    "duration": 5.562
  }
]