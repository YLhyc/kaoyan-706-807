[
  {
    "id": 1,
    "text": "八十年代初，汪曾祺以《受戒》《大淖记事》重返当代文坛，",
    "start": 0.2,
    "end": 5.195,
    "duration": 4.995
  },
  {
    "id": 2,
    "text": "在当代文学走出机械教条、回归审美本体的历史转折点上，确立了独特的文体坐标。",
    "start": 5.565,
    "end": 12.929,
    "duration": 7.364
  },
  {
    "id": 3,
    "text": "作为京派文学在当代的薪火传人，其小说的艺术特色与文体革新主要体现于以下三个方面：",
    "start": 13.429,
    "end": 20.74,
    "duration": 7.311
  },
  {
    "id": 4,
    "text": "第一，打破传统情节中心律，开辟写意从容的“散文化小说”崭新范式。",
    "start": 21.11,
    "end": 26.95,
    "duration": 5.84
  },
  {
    "id": 5,
    "text": "汪曾祺摒弃了剑拔弩张的戏剧性冲突与因果锁链式的跌宕情节，",
    "start": 27.47,
    "end": 32.83,
    "duration": 5.36
  },
  {
    "id": 6,
    "text": "主张“短篇小说要写得像散文一样随便”。",
    "start": 33.2,
    "end": 36.4,
    "duration": 3.2
  },
  {
    "id": 7,
    "text": "在《受戒》中，小说花费大量笔墨铺叙庵赵庄的民俗风物、时令劳作与和尚收租打牌的日常闲趣；",
    "start": 36.92,
    "end": 45.004,
    "duration": 8.084
  },
  {
    "id": 8,
    "text": "在荸荠田与芦花荡荡漾的清风里，明海与小英子于受戒归来的渡船上互吐心迹，",
    "start": 45.504,
    "end": 52.21,
    "duration": 6.706
  },
  {
    "id": 9,
    "text": "情爱如清泉般自然流淌，通篇展现出气韵生动、情景交融的东方写意画境。",
    "start": 52.69,
    "end": 59.09,
    "duration": 6.4
  },
  {
    "id": 10,
    "text": "第二，承续沈从文人性美学，建构健康自然的人性乌托邦与和美哲学。",
    "start": 59.61,
    "end": 65.77,
    "duration": 6.16
  },
  {
    "id": 11,
    "text": "汪曾祺在小说中极力发掘未被现代文明侵蚀的民间伦理与纯朴德行。",
    "start": 66.29,
    "end": 72.204,
    "duration": 5.914
  },
  {
    "id": 12,
    "text": "在《大淖记事》中，挑夫与锡匠群体身上流淌着粗粝而自尊的生命活力；",
    "start": 72.704,
    "end": 78.41,
    "duration": 5.706
  },
  {
    "id": 13,
    "text": "十一子惨遭保安队刘号长一伙毒打摧残后，巧云冲破世俗流言与恶霸淫威，",
    "start": 78.964,
    "end": 84.826,
    "duration": 5.862
  },
  {
    "id": 14,
    "text": "在众人注视下毅然端来参汤悉心喂服，以无私纯粹的女性柔情救赎苦难肉身，",
    "start": 85.176,
    "end": 91.91,
    "duration": 6.734
  },
  {
    "id": 15,
    "text": "彰显出超越苦难、温润包容的人性光辉。",
    "start": 92.55,
    "end": 95.99,
    "duration": 3.44
  },
  {
    "id": 16,
    "text": "第三，融通古典文言与现代白话，锤炼出洗练熨帖、具音乐声律的语言风格。",
    "start": 96.51,
    "end": 104.03,
    "duration": 7.52
  },
  {
    "id": 17,
    "text": "作家秉持语言即文化本体的诗学观念，",
    "start": 104.55,
    "end": 107.67,
    "duration": 3.12
  },
  {
    "id": 18,
    "text": "将六朝笔记的凝练、明清小品的风致与纯正的民间口语水乳交融。",
    "start": 108.04,
    "end": 113.8,
    "duration": 5.76
  },
  {
    "id": 19,
    "text": "其叙述句式短促空灵，用词凝练而意蕴丰沛，以不着一字尽得风流的从容节制，",
    "start": 114.364,
    "end": 121.25,
    "duration": 6.886
  },
  {
    "id": 20,
    "text": "赋予中国现当代小说语言雅俗共赏的诗意神韵。",
    "start": 121.62,
    "end": 125.38,
    "duration": 3.76
  }
]
