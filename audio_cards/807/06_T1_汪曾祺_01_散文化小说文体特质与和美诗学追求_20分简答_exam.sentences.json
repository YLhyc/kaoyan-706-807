[
  {
    "id": 1,
    "text": "八十年代初，汪曾祺以《受戒》《大淖记事》重返当代文坛，",
    "start": 0.124,
    "end": 4.611,
    "duration": 4.487
  },
  {
    "id": 2,
    "text": "在当代文学走出机械教条、回归审美本体的历史转折点上，确立了独特的文体坐标。",
    "start": 4.765,
    "end": 11.132,
    "duration": 6.367
  },
  {
    "id": 3,
    "text": "作为京派文学在当代的薪火传人，其小说的艺术特色与文体革新主要体现于以下三个方面：",
    "start": 11.411,
    "end": 18.297,
    "duration": 6.886
  },
  {
    "id": 4,
    "text": "第一，打破传统情节中心律，开辟写意从容的“散文化小说”崭新范式。",
    "start": 18.954,
    "end": 24.419,
    "duration": 5.465
  },
  {
    "id": 5,
    "text": "汪曾祺摒弃了剑拔弩张的戏剧性冲突与因果锁链式的跌宕情节，",
    "start": 25.016,
    "end": 29.815,
    "duration": 4.799
  },
  {
    "id": 6,
    "text": "主张“短篇小说要写得像散文一样随便”。",
    "start": 30.077,
    "end": 32.862,
    "duration": 2.785
  },
  {
    "id": 7,
    "text": "在《受戒》中，小说花费大量笔墨铺叙庵赵庄的民俗风物、时令劳作与和尚收租打牌的日常闲趣；",
    "start": 33.083,
    "end": 41.046,
    "duration": 7.963
  },
  {
    "id": 8,
    "text": "在荸荠田与芦花荡荡漾的清风里，明海与小英子于受戒归来的渡船上互吐心迹，",
    "start": 41.625,
    "end": 48.224,
    "duration": 6.599
  },
  {
    "id": 9,
    "text": "情爱如清泉般自然流淌，通篇展现出气韵生动、情景交融的东方写意画境。",
    "start": 48.818,
    "end": 55.49,
    "duration": 6.672
  },
  {
    "id": 10,
    "text": "第二，承续沈从文人性美学，建构健康自然的人性乌托邦与和美哲学。",
    "start": 56.146,
    "end": 62.69,
    "duration": 6.544
  },
  {
    "id": 11,
    "text": "汪曾祺在小说中极力发掘未被现代文明侵蚀的民间伦理与纯朴德行。",
    "start": 63.205,
    "end": 69.496,
    "duration": 6.291
  },
  {
    "id": 12,
    "text": "在《大淖记事》中，挑夫与锡匠群体身上流淌着粗粝而自尊的生命活力；",
    "start": 69.955,
    "end": 76.297,
    "duration": 6.342
  },
  {
    "id": 13,
    "text": "十一子惨遭保安队刘号长一伙毒打摧残后，巧云冲破世俗流言与恶霸淫威，",
    "start": 76.876,
    "end": 83.671,
    "duration": 6.795
  },
  {
    "id": 14,
    "text": "在众人注视下毅然端来参汤悉心喂服，以无私纯粹的女性柔情救赎苦难肉身，",
    "start": 83.909,
    "end": 90.963,
    "duration": 7.054
  },
  {
    "id": 15,
    "text": "彰显出超越苦难、温润包容的人性光辉。",
    "start": 91.078,
    "end": 94.372,
    "duration": 3.294
  },
  {
    "id": 16,
    "text": "第三，融通古典文言与现代白话，锤炼出洗练熨帖、具音乐声律的语言风格。",
    "start": 95.0,
    "end": 102.233,
    "duration": 7.233
  },
  {
    "id": 17,
    "text": "作家秉持语言即文化本体的诗学观念，",
    "start": 102.59,
    "end": 105.794,
    "duration": 3.204
  },
  {
    "id": 18,
    "text": "将六朝笔记的凝练、明清小品的风致与纯正的民间口语水乳交融。",
    "start": 106.177,
    "end": 111.804,
    "duration": 5.627
  },
  {
    "id": 19,
    "text": "其叙述句式短促空灵，用词凝练而意蕴丰沛，以不着一字尽得风流的从容节制，",
    "start": 112.165,
    "end": 119.095,
    "duration": 6.93
  },
  {
    "id": 20,
    "text": "赋予中国现当代小说语言雅俗共赏的诗意神韵。",
    "start": 119.462,
    "end": 123.374,
    "duration": 3.912
  }
]