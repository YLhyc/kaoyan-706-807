[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "讲话与解放区·延安文艺座谈会讲话核心命题与历史影响",
    "start": 0.154,
    "end": 5.366,
    "duration": 5.212
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "痛点→理论→作品→体制功过：先用1942延安知识分子暴露/歌颂水土不服说明《讲话》为何诞生，",
    "start": 6.022,
    "end": 15.154,
    "duration": 9.132
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再背下全篇硬核得分点“为什么人/齿轮螺丝钉/普及提高/政治艺术双标/唯一源泉”五组命题，",
    "start": 15.302,
    "end": 22.594,
    "duration": 7.292
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "接着落实《兄妹开荒》、赵树理、《白毛女》民间转化实绩，最后辩证评定十七年体制功与限。",
    "start": 22.822,
    "end": 29.794,
    "duration": 6.972
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "毛泽东《在延安文艺座谈会上的讲话》是现代迈向当代一体化文学体制的枢纽，",
    "start": 30.287,
    "end": 36.779,
    "duration": 6.492
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "以“文艺为工农兵”决断破解五四“走向大众”难题，",
    "start": 37.007,
    "end": 40.699,
    "duration": 3.692
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "奠基“中国作风与中国气派”解放区文艺与十七年体制。",
    "start": 41.007,
    "end": 45.579,
    "duration": 4.572
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 直面战时痛点、化知识分子水土不服",
    "start": 46.237,
    "end": 49.769,
    "duration": 3.532
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "抗战奔赴延安的知识青年习惯亭子间情调与居高临下启蒙姿态，同陕北农村及工农兵产生脱节；",
    "start": 50.297,
    "end": 60.549,
    "duration": 10.252
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "王实味《野百合花》引发“暴露还是歌颂”之争，《讲话》切中小资产阶级偏向，要求深入群众转向无产阶级立场。",
    "start": 61.077,
    "end": 71.489,
    "duration": 10.412
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 系统命题体系、立马克思主义中国化法则",
    "start": 72.122,
    "end": 76.054,
    "duration": 3.932
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "“为什么人的问题，是一个根本的问题，原则的问题”，立“为人民大众，首先为工农兵”；",
    "start": 76.582,
    "end": 84.114,
    "duration": 7.532
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "界定文艺从属政治，喻为“齿轮和螺丝钉”；",
    "start": 84.472,
    "end": 88.244,
    "duration": 3.772
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "战时“普及更为迫切”、在普及基础上提高；",
    "start": 88.692,
    "end": 93.904,
    "duration": 5.212
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "批评立“政治标准第一，艺术标准第二”；",
    "start": 94.132,
    "end": 97.473,
    "duration": 3.341
  },
  {
    "id": "sec1_step1_c2",
    "dom_key": "sec1_step1_c2",
    "text": "人民生活是唯一源泉、源于并高于生活。",
    "start": 97.488,
    "end": 101.344,
    "duration": 3.856
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 涤荡欧化藩篱、以民间形式重构文艺风格",
    "start": 101.867,
    "end": 106.039,
    "duration": 4.172
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "新秧歌《兄妹开荒》以旧形式装新内容；赵树理《小二黑结婚》《李有才板话》创群众说唱“赵树理方向”；",
    "start": 106.567,
    "end": 116.789,
    "duration": 10.222
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《白毛女》融民歌板腔与管弦乐去魅“白毛仙姑”，炼“旧社会逼成鬼、新社会变成人”，",
    "start": 117.266,
    "end": 126.798,
    "duration": 9.532
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "达成意识形态与民间审美统一。",
    "start": 127.026,
    "end": 129.918,
    "duration": 2.892
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 重构组织权力形态、成十七年体制母本",
    "start": 130.626,
    "end": 134.558,
    "duration": 3.932
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "扭转少数精英垄断，确立工农兵主体地位并强化动员效能；塑造文联作协体制、集体写作与评价尺度；",
    "start": 134.989,
    "end": 144.651,
    "duration": 9.662
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "推动大众化民族化之余，在后世机械执行中亦带来政治挂帅压抑艺术个性与题材窄化局限。",
    "start": 145.139,
    "end": 154.271,
    "duration": 9.132
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《讲话》是连接现当代文学的纲领性文献，在历史关头重塑中国文学的主体、功能、美学与体制，",
    "start": 154.886,
    "end": 162.394,
    "duration": 7.508
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "标志向当代人民文艺道路深层转折。",
    "start": 162.409,
    "end": 165.858,
    "duration": 3.449
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：记住《讲话》（1942年）四大理论要点：①为什么人（为人民大众，首先为工农兵） ②政治与文艺（齿轮螺丝钉） ③普及与提高 ④批评双重标准（政治第一、艺术第二）；",
    "start": 166.327,
    "end": 182.789,
    "duration": 16.462
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "代表作品《兄妹开荒》、赵树理、新歌剧《白毛女》。",
    "start": 183.017,
    "end": 187.029,
    "duration": 4.012
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 一口气默背《讲话》的五大核心命题原文金句？",
    "start": 187.486,
    "end": 192.682,
    "duration": 5.196
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 说明《野百合花》论争背景以及《兄妹开荒》《李有才板话》《白毛女》的实践实绩？",
    "start": 193.21,
    "end": 200.518,
    "duration": 7.308
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 如何客观辩证地评价《讲话》作为当代“一体化体制母本”的功绩与历史局限？",
    "start": 200.791,
    "end": 208.403,
    "duration": 7.612
  }
]