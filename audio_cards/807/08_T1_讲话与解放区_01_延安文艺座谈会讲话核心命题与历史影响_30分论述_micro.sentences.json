[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "讲话与解放区·延安文艺座谈会讲话核心命题与历史影响",
    "start": 0.134,
    "end": 5.406,
    "duration": 5.272
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "痛点→理论→作品→体制功过：先用1942延安知识分子暴露/歌颂水土不服说明《讲话》为何诞生，",
    "start": 5.995,
    "end": 15.213,
    "duration": 9.218
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "再背下全篇硬核得分点“为什么人/齿轮螺丝钉/普及提高/政治艺术双标/唯一源泉”五组命题，",
    "start": 15.514,
    "end": 23.295,
    "duration": 7.781
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "接着落实《兄妹开荒》、赵树理、《白毛女》民间转化实绩，最后辩证评定十七年体制功与限。",
    "start": 23.491,
    "end": 31.003,
    "duration": 7.512
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "毛泽东《在延安文艺座谈会上的讲话》是现代迈向当代一体化文学体制的枢纽，",
    "start": 31.577,
    "end": 37.592,
    "duration": 6.015
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "以“文艺为工农兵”决断破解五四“走向大众”难题，",
    "start": 37.853,
    "end": 41.876,
    "duration": 4.022
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "奠基“中国作风与中国气派”解放区文艺与十七年体制。",
    "start": 42.176,
    "end": 46.615,
    "duration": 4.439
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 直面战时痛点、化知识分子水土不服",
    "start": 47.208,
    "end": 51.49,
    "duration": 4.283
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "抗战奔赴延安的知识青年习惯亭子间情调与居高临下启蒙姿态，同陕北农村及工农兵产生脱节；",
    "start": 52.077,
    "end": 61.438,
    "duration": 9.361
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "王实味《野百合花》引发“暴露还是歌颂”之争，《讲话》切中小资产阶级偏向，要求深入群众转向无产阶级立场。",
    "start": 62.025,
    "end": 72.311,
    "duration": 10.285
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 系统命题体系、立马克思主义中国化法则",
    "start": 72.885,
    "end": 77.024,
    "duration": 4.14
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "“为什么人的问题，是一个根本的问题，原则的问题”，立“为人民大众，首先为工农兵”；",
    "start": 77.611,
    "end": 85.188,
    "duration": 7.577
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "界定文艺从属政治，喻为“齿轮和螺丝钉”；",
    "start": 85.463,
    "end": 89.316,
    "duration": 3.853
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "战时“普及更为迫切”、在普及基础上提高；",
    "start": 89.903,
    "end": 94.615,
    "duration": 4.713
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "批评立“政治标准第一，艺术标准第二”；",
    "start": 94.864,
    "end": 97.897,
    "duration": 3.033
  },
  {
    "id": "sec1_step1_c2",
    "dom_key": "sec1_step1_c2",
    "text": "人民生活是唯一源泉、源于并高于生活。",
    "start": 98.171,
    "end": 101.79,
    "duration": 3.619
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 涤荡欧化藩篱、以民间形式重构文艺风格",
    "start": 102.377,
    "end": 107.089,
    "duration": 4.713
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "新秧歌《兄妹开荒》以旧形式装新内容；赵树理《小二黑结婚》《李有才板话》创群众说唱“赵树理方向”；",
    "start": 107.676,
    "end": 117.415,
    "duration": 9.739
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "《白毛女》融民歌板腔与管弦乐去魅“白毛仙姑”，炼“旧社会逼成鬼、新社会变成人”，",
    "start": 118.002,
    "end": 125.944,
    "duration": 7.942
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "达成意识形态与民间审美统一。",
    "start": 126.101,
    "end": 129.043,
    "duration": 2.942
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 重构组织权力形态、成十七年体制母本",
    "start": 129.629,
    "end": 133.821,
    "duration": 4.192
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "扭转少数精英垄断，确立工农兵主体地位并强化动员效能；塑造文联作协体制、集体写作与评价尺度；",
    "start": 134.408,
    "end": 144.641,
    "duration": 10.233
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "推动大众化民族化之余，在后世机械执行中亦带来政治挂帅压抑艺术个性与题材窄化局限。",
    "start": 145.215,
    "end": 154.342,
    "duration": 9.127
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《讲话》是连接现当代文学的纲领性文献，在历史关头重塑中国文学的主体、功能、美学与体制，",
    "start": 154.929,
    "end": 163.717,
    "duration": 8.788
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "标志向当代人民文艺道路深层转折。",
    "start": 164.017,
    "end": 167.415,
    "duration": 3.397
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：记住《讲话》（1942年）四大理论要点：①为什么人（为人民大众，首先为工农兵） ②政治与文艺（齿轮螺丝钉） ③普及与提高 ④批评双重标准（政治第一、艺术第二）；",
    "start": 168.002,
    "end": 184.598,
    "duration": 16.596
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "代表作品《兄妹开荒》、赵树理、新歌剧《白毛女》。",
    "start": 184.873,
    "end": 188.895,
    "duration": 4.022
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 一口气默背《讲话》的五大核心命题原文金句？",
    "start": 189.469,
    "end": 194.429,
    "duration": 4.96
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 说明《野百合花》论争背景以及《兄妹开荒》《李有才板话》《白毛女》的实践实绩？",
    "start": 195.003,
    "end": 202.684,
    "duration": 7.681
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 如何客观辩证地评价《讲话》作为当代“一体化体制母本”的功绩与历史局限？",
    "start": 203.271,
    "end": 210.614,
    "duration": 7.343
  }
]