[
  {
    "id": 1,
    "text": "自五四新文化运动以来，中国现当代知识分子形象的文学书写，深刻折射出知识阶层在启蒙、抗争与历史转折中的精神困境与道路抉择。",
    "start": 0.117,
    "end": 11.948,
    "duration": 11.831
  },
  {
    "id": 2,
    "text": "其百年形象演变主要经历以下三个阶段：",
    "start": 12.498,
    "end": 15.325,
    "duration": 2.827
  },
  {
    "id": 3,
    "text": "第一，五四启蒙时期：先觉者的觉醒与苦闷徘徊。",
    "start": 16.008,
    "end": 20.573,
    "duration": 4.565
  },
  {
    "id": 4,
    "text": "五四早期，鲁迅在《狂人日记》中塑造了看破礼教“吃人”本质的启蒙先驱；",
    "start": 20.886,
    "end": 26.431,
    "duration": 5.545
  },
  {
    "id": 5,
    "text": "随后随着新文化阵营分化，",
    "start": 26.666,
    "end": 28.436,
    "duration": 1.77
  },
  {
    "id": 6,
    "text": "鲁迅在《彷徨》中沉痛剖析了脱离民众的个人启蒙者遭遇的孤立困境。",
    "start": 28.622,
    "end": 33.44,
    "duration": 4.818
  },
  {
    "id": 7,
    "text": "《在酒楼上》的吕纬甫由昔日激进青年沦为替亡弟迁葬、教读“子曰诗云”的颓唐者；",
    "start": 33.7,
    "end": 41.164,
    "duration": 7.464
  },
  {
    "id": 8,
    "text": "《孤独者》中的魏连殳从孤傲抗争妥协为军阀幕僚，",
    "start": 41.46,
    "end": 45.575,
    "duration": 4.115
  },
  {
    "id": 9,
    "text": "揭示出缺乏社会根基的个体反叛面临的精神死局。",
    "start": 45.658,
    "end": 49.706,
    "duration": 4.048
  },
  {
    "id": 10,
    "text": "第二，三十至四十年代：时代激流下的分化与精神围困。",
    "start": 50.308,
    "end": 55.328,
    "duration": 5.02
  },
  {
    "id": 11,
    "text": "面对革命浪潮与民族危机，知识分子群体发生明显分化：",
    "start": 55.807,
    "end": 60.483,
    "duration": 4.676
  },
  {
    "id": 12,
    "text": "巴金《家》中的觉慧毅然决裂封建家庭奔向新生活，",
    "start": 61.057,
    "end": 65.311,
    "duration": 4.254
  },
  {
    "id": 13,
    "text": "茅盾《动摇》中的方罗兰则在左右势力拉扯中优柔动摇；",
    "start": 65.695,
    "end": 69.648,
    "duration": 3.953
  },
  {
    "id": 14,
    "text": "四十年代，钱锺书在《围城》中刻画了方鸿渐这一留学归国却处处受困的灰色文人典型，",
    "start": 69.905,
    "end": 76.762,
    "duration": 6.857
  },
  {
    "id": 15,
    "text": "他在谋职、婚恋与三闾大学的人际倾轧中进退失据，",
    "start": 76.968,
    "end": 81.163,
    "duration": 4.195
  },
  {
    "id": 16,
    "text": "展现出传统与现代文明夹击下知识阶层的精神困顿。",
    "start": 81.404,
    "end": 85.416,
    "duration": 4.012
  },
  {
    "id": 17,
    "text": "第三，解放区及当代时期：在投身工农、挫折反思中坚守理想。",
    "start": 86.059,
    "end": 91.368,
    "duration": 5.309
  },
  {
    "id": 18,
    "text": "延安文艺座谈会后，文学着重审视知识分子的思想弱点与实践道路：",
    "start": 91.647,
    "end": 97.138,
    "duration": 5.491
  },
  {
    "id": 19,
    "text": "丁玲既在《在医院中》借女医生陆萍揭示现代科学民主意识与落后小生产习气的冲突，",
    "start": 97.513,
    "end": 104.788,
    "duration": 7.275
  },
  {
    "id": 20,
    "text": "也在《太阳照在桑干河上》中塑造了深入实际的领导干部章品，",
    "start": 104.997,
    "end": 109.611,
    "duration": 4.614
  },
  {
    "id": 21,
    "text": "并批评了工作组长文采脱离群众的教条作风；",
    "start": 109.881,
    "end": 113.505,
    "duration": 3.624
  },
  {
    "id": 22,
    "text": "及至当代新时期，谌容《人到中年》中的眼科医生陆文婷在生活重压下仍恪守医者良知，",
    "start": 113.823,
    "end": 121.436,
    "duration": 7.613
  },
  {
    "id": 23,
    "text": "体现出一代知识分子历尽沧桑后的精神坚守。",
    "start": 121.722,
    "end": 125.68,
    "duration": 3.958
  }
]