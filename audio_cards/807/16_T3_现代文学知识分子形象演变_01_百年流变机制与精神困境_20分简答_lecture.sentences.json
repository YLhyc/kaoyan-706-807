[
  {
    "id": 1,
    "text": "自五四新文化运动至延安新文艺体制确立，",
    "start": 0.103,
    "end": 3.344,
    "duration": 3.241
  },
  {
    "id": 2,
    "text": "中国现代知识分子形象的文学书写，",
    "start": 3.673,
    "end": 6.171,
    "duration": 2.498
  },
  {
    "id": 3,
    "text": "深刻折射了现代知识阶层在启蒙觉醒、",
    "start": 6.408,
    "end": 9.412,
    "duration": 3.004
  },
  {
    "id": 4,
    "text": "历史动荡与社会革命中的灵魂挣扎。",
    "start": 9.681,
    "end": 12.429,
    "duration": 2.748
  },
  {
    "id": 5,
    "text": "其形象演变主要经历了以下三个阶段的嬗变：",
    "start": 12.878,
    "end": 16.149,
    "duration": 3.271
  },
  {
    "id": 6,
    "text": "第一，五四启蒙时期：",
    "start": 16.374,
    "end": 18.224,
    "duration": 1.85
  },
  {
    "id": 7,
    "text": "作为“先觉战士”的觉醒与战斗幻灭后的深刻苦闷。",
    "start": 18.661,
    "end": 22.362,
    "duration": 3.701
  },
  {
    "id": 8,
    "text": "五四早期，",
    "start": 22.578,
    "end": 23.384,
    "duration": 0.806
  },
  {
    "id": 9,
    "text": "鲁迅在《狂人日记》中确立了看破传统吃人礼教的现代启蒙先驱形象；",
    "start": 23.59,
    "end": 29.192,
    "duration": 5.602
  },
  {
    "id": 10,
    "text": "然而随着新文化阵营分化，",
    "start": 29.514,
    "end": 31.335,
    "duration": 1.821
  },
  {
    "id": 11,
    "text": "鲁迅在《彷徨》中转而以无情自审的解剖刀，",
    "start": 31.614,
    "end": 34.95,
    "duration": 3.336
  },
  {
    "id": 12,
    "text": "刻画了先觉者在孤独无援中的颓唐与倒退。",
    "start": 35.385,
    "end": 38.68,
    "duration": 3.295
  },
  {
    "id": 13,
    "text": "《在酒楼上》中昔日慷慨激昂的吕纬甫，最终沦为替死者迁葬、",
    "start": 39.025,
    "end": 44.101,
    "duration": 5.076
  },
  {
    "id": 14,
    "text": "教小儿读“子曰诗云”的麻木度日者；",
    "start": 44.21,
    "end": 47.359,
    "duration": 3.149
  },
  {
    "id": 15,
    "text": "《孤独者》中的魏连殳由孤傲叛逆最终妥协沦为军阀幕僚，",
    "start": 47.54,
    "end": 52.403,
    "duration": 4.863
  },
  {
    "id": 16,
    "text": "深刻揭示了脱离广大民众的个体启蒙者必然遭遇的精神死局。",
    "start": 52.806,
    "end": 57.949,
    "duration": 5.143
  },
  {
    "id": 17,
    "text": "第二，三十至四十年代：",
    "start": 58.269,
    "end": 60.26,
    "duration": 1.991
  },
  {
    "id": 18,
    "text": "在阶级分化与抗战乱世中呈现的分化裂变与精神围困。",
    "start": 60.453,
    "end": 65.305,
    "duration": 4.852
  },
  {
    "id": 19,
    "text": "伴随革命大潮与民族危机，知识分子群体发生深刻分化。",
    "start": 65.678,
    "end": 70.122,
    "duration": 4.444
  },
  {
    "id": 20,
    "text": "一部分如巴金《家》中的觉慧毅然冲破封建家庭投身时代浪潮；",
    "start": 70.343,
    "end": 75.926,
    "duration": 5.583
  },
  {
    "id": 21,
    "text": "另一部分则陷入摇摆动荡，",
    "start": 75.948,
    "end": 77.964,
    "duration": 2.016
  },
  {
    "id": 22,
    "text": "如茅盾《动摇》中的方罗兰在左右拉扯中优柔寡断。",
    "start": 78.313,
    "end": 82.501,
    "duration": 4.188
  },
  {
    "id": 23,
    "text": "而在四十年代沦陷与后方，",
    "start": 83.025,
    "end": 85.02,
    "duration": 1.995
  },
  {
    "id": 24,
    "text": "钱锺书在《围城》中刻画了方鸿渐这一灰色无用的海归文人典型，",
    "start": 85.329,
    "end": 91.066,
    "duration": 5.737
  },
  {
    "id": 25,
    "text": "终日困顿于恋爱、谋职与人际内耗的荒谬迷局，",
    "start": 91.136,
    "end": 95.445,
    "duration": 4.309
  },
  {
    "id": 26,
    "text": "展现了旧知识阶层在现代化转型中的精神瘫软。",
    "start": 95.494,
    "end": 99.339,
    "duration": 3.845
  },
  {
    "id": 27,
    "text": "第三，延安与解放区时期：",
    "start": 99.543,
    "end": 101.556,
    "duration": 2.013
  },
  {
    "id": 28,
    "text": "在思想改造与工农结合中实现政治与精神新生。",
    "start": 101.62,
    "end": 105.449,
    "duration": 3.829
  },
  {
    "id": 29,
    "text": "随着延安文艺座谈会确立工农兵方向，",
    "start": 105.781,
    "end": 108.35,
    "duration": 2.569
  },
  {
    "id": 30,
    "text": "文学深刻反思了小资产阶级知识分子的自私空想与软弱动摇。",
    "start": 108.422,
    "end": 112.855,
    "duration": 4.433
  },
  {
    "id": 31,
    "text": "丁玲在《太阳照在桑干河上》中塑造的章品、",
    "start": 112.944,
    "end": 115.895,
    "duration": 2.951
  },
  {
    "id": 32,
    "text": "文采等工作组知识分子，深入土改一线与农民同吃同住同劳动，",
    "start": 115.958,
    "end": 120.682,
    "duration": 4.724
  },
  {
    "id": 33,
    "text": "在火热群众运动的熔炉中洗刷资产阶级虚荣，",
    "start": 120.767,
    "end": 124.125,
    "duration": 3.358
  },
  {
    "id": 34,
    "text": "真正转变为与工农群众休戚与共的无产阶级革命文艺战士。",
    "start": 124.259,
    "end": 128.928,
    "duration": 4.669
  }
]
