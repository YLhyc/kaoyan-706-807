[
  {
    "id": 1,
    "text": "自五四新文化运动至延安新文艺体制确立，",
    "start": 0.08,
    "end": 3.84,
    "duration": 3.76
  },
  {
    "id": 2,
    "text": "中国现代知识分子形象的文学书写，",
    "start": 3.84,
    "end": 6.72,
    "duration": 2.88
  },
  {
    "id": 3,
    "text": "深刻折射了现代知识阶层在启蒙觉醒、",
    "start": 6.72,
    "end": 10.16,
    "duration": 3.44
  },
  {
    "id": 4,
    "text": "历史动荡与社会革命中的灵魂挣扎。",
    "start": 10.16,
    "end": 13.6,
    "duration": 3.44
  },
  {
    "id": 5,
    "text": "其形象演变主要经历了以下三个阶段的嬗变：",
    "start": 13.6,
    "end": 17.6,
    "duration": 4.0
  },
  {
    "id": 6,
    "text": "第一，五四启蒙时期：",
    "start": 17.6,
    "end": 19.84,
    "duration": 2.24
  },
  {
    "id": 7,
    "text": "作为“先觉战士”的觉醒与战斗幻灭后的深刻苦闷。",
    "start": 19.84,
    "end": 24.64,
    "duration": 4.8
  },
  {
    "id": 8,
    "text": "五四早期，",
    "start": 24.64,
    "end": 25.6,
    "duration": 0.96
  },
  {
    "id": 9,
    "text": "鲁迅在《狂人日记》中确立了看破传统吃人礼教的现代启蒙先驱形象；",
    "start": 25.6,
    "end": 32.08,
    "duration": 6.48
  },
  {
    "id": 10,
    "text": "然而随着新文化阵营分化，",
    "start": 32.16,
    "end": 34.56,
    "duration": 2.4
  },
  {
    "id": 11,
    "text": "鲁迅在《彷徨》中转而以无情自审的解剖刀，",
    "start": 34.56,
    "end": 38.64,
    "duration": 4.08
  },
  {
    "id": 12,
    "text": "刻画了先觉者在孤独无援中的颓唐与倒退。",
    "start": 38.96,
    "end": 42.88,
    "duration": 3.92
  },
  {
    "id": 13,
    "text": "《在酒楼上》中昔日慷慨激昂的吕纬甫，最终沦为替死者迁葬、",
    "start": 43.04,
    "end": 49.413,
    "duration": 6.373
  },
  {
    "id": 14,
    "text": "教小儿读“子曰诗云”的麻木度日者；",
    "start": 49.413,
    "end": 53.14,
    "duration": 3.727
  },
  {
    "id": 15,
    "text": "《孤独者》中的魏连殳由孤傲叛逆最终妥协沦为军阀幕僚，",
    "start": 53.14,
    "end": 58.402,
    "duration": 5.262
  },
  {
    "id": 16,
    "text": "深刻揭示了脱离广大民众的个体启蒙者必然遭遇的精神死局。",
    "start": 58.402,
    "end": 64.321,
    "duration": 5.919
  },
  {
    "id": 17,
    "text": "第二，三十至四十年代：",
    "start": 64.321,
    "end": 66.732,
    "duration": 2.411
  },
  {
    "id": 18,
    "text": "在阶级分化与抗战乱世中呈现的分化裂变与精神围困。",
    "start": 66.732,
    "end": 71.84,
    "duration": 5.108
  },
  {
    "id": 19,
    "text": "伴随革命大潮与民族危机，知识分子群体发生深刻分化。",
    "start": 71.84,
    "end": 77.36,
    "duration": 5.52
  },
  {
    "id": 20,
    "text": "一部分如巴金《家》中的觉慧毅然冲破封建家庭投身时代浪潮；",
    "start": 77.36,
    "end": 83.12,
    "duration": 5.76
  },
  {
    "id": 21,
    "text": "另一部分则陷入摇摆动荡，",
    "start": 83.12,
    "end": 85.68,
    "duration": 2.56
  },
  {
    "id": 22,
    "text": "如茅盾《动摇》中的方罗兰在左右拉扯中优柔寡断。",
    "start": 85.68,
    "end": 90.4,
    "duration": 4.72
  },
  {
    "id": 23,
    "text": "而在四十年代沦陷与后方，",
    "start": 90.4,
    "end": 93.6,
    "duration": 3.2
  },
  {
    "id": 24,
    "text": "钱锺书在《围城》中刻画了方鸿渐这一灰色无用的海归文人典型，",
    "start": 93.6,
    "end": 99.28,
    "duration": 5.68
  },
  {
    "id": 25,
    "text": "终日困顿于恋爱、谋职与人际内耗的荒谬迷局，",
    "start": 99.52,
    "end": 103.6,
    "duration": 4.08
  },
  {
    "id": 26,
    "text": "展现了旧知识阶层在现代化转型中的精神瘫软。",
    "start": 103.6,
    "end": 107.6,
    "duration": 4.0
  },
  {
    "id": 27,
    "text": "第三，延安与解放区时期：",
    "start": 107.6,
    "end": 109.84,
    "duration": 2.24
  },
  {
    "id": 28,
    "text": "在思想改造与工农结合中实现政治与精神新生。",
    "start": 109.84,
    "end": 113.04,
    "duration": 3.2
  },
  {
    "id": 29,
    "text": "随着延安文艺座谈会确立工农兵方向，",
    "start": 113.04,
    "end": 116.08,
    "duration": 3.04
  },
  {
    "id": 30,
    "text": "文学深刻反思了小资产阶级知识分子的自私空想与软弱动摇。",
    "start": 116.08,
    "end": 121.12,
    "duration": 5.04
  },
  {
    "id": 31,
    "text": "丁玲在《太阳照在桑干河上》中塑造的章品、",
    "start": 121.12,
    "end": 124.72,
    "duration": 3.6
  },
  {
    "id": 32,
    "text": "文采等工作组知识分子，深入土改一线与农民同吃同住同劳动，",
    "start": 124.72,
    "end": 128.72,
    "duration": 4.0
  },
  {
    "id": 33,
    "text": "在火热群众运动的熔炉中洗刷资产阶级虚荣，",
    "start": 128.56,
    "end": 128.72,
    "duration": 0.16
  },
  {
    "id": 34,
    "text": "真正转变为与工农群众休戚与共的无产阶级革命文艺战士。",
    "start": 128.56,
    "end": 128.72,
    "duration": 0.16
  }
]