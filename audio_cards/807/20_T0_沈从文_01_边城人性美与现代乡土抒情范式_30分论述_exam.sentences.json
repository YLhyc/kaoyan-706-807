[
  {
    "id": 1,
    "text": "题型，三十分论述题。",
    "start": 0.08,
    "end": 1.808,
    "duration": 1.728
  },
  {
    "id": 2,
    "text": "分值，三十分。",
    "start": 1.808,
    "end": 2.871,
    "duration": 1.063
  },
  {
    "id": 3,
    "text": "建议考场时间，三十五分钟。",
    "start": 2.871,
    "end": 5.21,
    "duration": 2.339
  },
  {
    "id": 4,
    "text": "目标字数，一千一百五十到一千三百字。",
    "start": 5.21,
    "end": 8.612,
    "duration": 3.402
  },
  {
    "id": 5,
    "text": "答题骨架，文体坐标定性、趋近于“优美、",
    "start": 8.612,
    "end": 11.801,
    "duration": 3.189
  },
  {
    "id": 6,
    "text": "健康、自然”之人性美建构、趋近于、",
    "start": 11.801,
    "end": 14.565,
    "duration": 2.764
  },
  {
    "id": 7,
    "text": "散文化风俗画与抒情小说文体创新、",
    "start": 14.565,
    "end": 17.754,
    "duration": 3.189
  },
  {
    "id": 8,
    "text": "趋近于、牧歌情调与命运哀愁背后的文化批判、",
    "start": 17.754,
    "end": 21.794,
    "duration": 4.04
  },
  {
    "id": 9,
    "text": "趋近于、宏观文学史总结。",
    "start": 21.794,
    "end": 23.92,
    "duration": 2.126
  },
  {
    "id": 10,
    "text": "沈从文所著中篇小说《边城》是中国现代文学史上诗意乡土小说的巅峰之作，",
    "start": 24.08,
    "end": 31.04,
    "duration": 6.96
  },
  {
    "id": 11,
    "text": "也是京派文学追求纯正审美品格的最高代表。",
    "start": 31.04,
    "end": 35.36,
    "duration": 4.32
  },
  {
    "id": 12,
    "text": "沈从文在远离现代工业都市喧嚣的湘西茶峒，",
    "start": 35.36,
    "end": 39.04,
    "duration": 3.68
  },
  {
    "id": 13,
    "text": "以虔诚的心灵建构起一座供奉“人性”的神庙。",
    "start": 39.04,
    "end": 42.96,
    "duration": 3.92
  },
  {
    "id": 14,
    "text": "小说以澄澈温润的散文笔调，将自然山水、",
    "start": 42.96,
    "end": 46.88,
    "duration": 3.92
  },
  {
    "id": 15,
    "text": "古朴民风与至纯人性融铸一炉，开创了现代小说抒情化与风俗化并茂的崭新文体范式。",
    "start": 46.88,
    "end": 55.36,
    "duration": 8.48
  },
  {
    "id": 16,
    "text": "第一，在思想精神与美学品格上，作品旨在重塑一种“优美、",
    "start": 55.68,
    "end": 61.36,
    "duration": 5.68
  },
  {
    "id": 17,
    "text": "健康、自然，而又不悖于人性的人生形式”，",
    "start": 61.36,
    "end": 64.8,
    "duration": 3.44
  },
  {
    "id": 18,
    "text": "构筑了充满至善至美的人性理想殿堂。",
    "start": 64.8,
    "end": 68.24,
    "duration": 3.44
  },
  {
    "id": 19,
    "text": "沈从文笔下的湘西茶峒，是一个未被现代商业金钱关系与机械文明污染的桃花源式社会。",
    "start": 68.24,
    "end": 75.6,
    "duration": 7.36
  },
  {
    "id": 20,
    "text": "在这一纯净空间中，每个人身上都闪烁着中国传统伦理中最纯真的德性光辉。",
    "start": 75.92,
    "end": 82.4,
    "duration": 6.48
  },
  {
    "id": 21,
    "text": "老船夫五十年如一日摆渡于碧溪居，",
    "start": 82.4,
    "end": 85.68,
    "duration": 3.28
  },
  {
    "id": 22,
    "text": "恪尽职守，义不取利，将全部生命的温情倾注于外孙女翠翠身上。",
    "start": 85.68,
    "end": 91.68,
    "duration": 6.0
  },
  {
    "id": 23,
    "text": "翠翠依山傍水生长，天真无邪，空灵澄澈，",
    "start": 91.68,
    "end": 95.6,
    "duration": 3.92
  },
  {
    "id": 24,
    "text": "其在渡船上对挪送朦胧爱恋的萌发，",
    "start": 95.6,
    "end": 98.56,
    "duration": 2.96
  },
  {
    "id": 25,
    "text": "完全是生命天性自然的律动。",
    "start": 98.56,
    "end": 100.72,
    "duration": 2.16
  },
  {
    "id": 26,
    "text": "天保与挪送两兄弟爱上同一个女子，",
    "start": 100.96,
    "end": 103.84,
    "duration": 2.88
  },
  {
    "id": 27,
    "text": "却摒弃世俗勾心斗角，遵循当地古朴的“走马路”唱歌求爱法则，",
    "start": 103.84,
    "end": 109.52,
    "duration": 5.68
  },
  {
    "id": 28,
    "text": "兄让弟先，重情轻利。",
    "start": 109.52,
    "end": 112.08,
    "duration": 2.56
  },
  {
    "id": 29,
    "text": "这种人与人之间真挚互助、自尊自爱、",
    "start": 112.08,
    "end": 115.28,
    "duration": 3.2
  },
  {
    "id": 30,
    "text": "毫无机巧算计的伦理风貌，展现了中国传统原生态文明中最动人的人性底色。",
    "start": 115.28,
    "end": 121.68,
    "duration": 6.4
  },
  {
    "id": 31,
    "text": "第二，在文体建构与小说叙事艺术上，",
    "start": 121.976,
    "end": 125.096,
    "duration": 3.12
  },
  {
    "id": 32,
    "text": "作品打破了传统小说强情节与戏剧化冲突的模式，",
    "start": 125.096,
    "end": 129.576,
    "duration": 4.48
  },
  {
    "id": 33,
    "text": "奠定了散文化、诗意化的现代乡土抒情小说范式。",
    "start": 129.576,
    "end": 133.656,
    "duration": 4.08
  },
  {
    "id": 34,
    "text": "沈从文将小说的叙事重心从紧张的情节推演，",
    "start": 133.656,
    "end": 137.416,
    "duration": 3.76
  },
  {
    "id": 35,
    "text": "转移到如诗如画的环境风物与地方民俗的舒展铺陈上。",
    "start": 137.416,
    "end": 141.496,
    "duration": 4.08
  },
  {
    "id": 36,
    "text": "茶峒的吊脚楼、清澈见底的白河、碧溪居的白塔与渡船，",
    "start": 141.896,
    "end": 146.696,
    "duration": 4.8
  },
  {
    "id": 37,
    "text": "在作者笔下皆具油画般的质感。",
    "start": 146.696,
    "end": 149.176,
    "duration": 2.48
  },
  {
    "id": 38,
    "text": "小说浓墨重彩地描绘了端午节全城出动赛龙舟、",
    "start": 149.176,
    "end": 153.176,
    "duration": 4.0
  },
  {
    "id": 39,
    "text": "捉鸭子的民俗盛况，以及青年男女月夜在对溪山崖上以歌代言的浪漫风情。",
    "start": 153.176,
    "end": 159.416,
    "duration": 6.24
  },
  {
    "id": 40,
    "text": "全篇行文清丽明澈，平缓从容，语言如山泉般自然流淌，",
    "start": 159.416,
    "end": 164.536,
    "duration": 5.12
  },
  {
    "id": 41,
    "text": "大量运用洗练的白描与富于音乐感的节奏，",
    "start": 164.536,
    "end": 168.056,
    "duration": 3.52
  },
  {
    "id": 42,
    "text": "实现了小说、散文与诗歌美学的深度交融。",
    "start": 168.056,
    "end": 171.496,
    "duration": 3.44
  },
  {
    "id": 43,
    "text": "第三，在哲理开掘与文化反思机制上，",
    "start": 171.736,
    "end": 175.176,
    "duration": 3.44
  },
  {
    "id": 44,
    "text": "作品在明朗恬淡的牧歌情调之下，掩映着深沉庄严的命运悲剧感与对现代文明异化的批判。",
    "start": 175.176,
    "end": 183.096,
    "duration": 7.92
  },
  {
    "id": 45,
    "text": "沈从文的田园牧歌绝非浅薄的乐观粉饰，",
    "start": 183.096,
    "end": 187.096,
    "duration": 4.0
  },
  {
    "id": 46,
    "text": "小说始终笼罩着对人生无常与造化弄人的淡淡感伤。",
    "start": 187.096,
    "end": 191.736,
    "duration": 4.64
  },
  {
    "id": 47,
    "text": "天保的意外溺亡、老船夫的猝然长逝、",
    "start": 191.736,
    "end": 195.096,
    "duration": 3.36
  },
  {
    "id": 48,
    "text": "白塔的坍塌与挪送的负气远走，使翠翠陷入了孤寂的漫长等待。",
    "start": 195.096,
    "end": 200.616,
    "duration": 5.52
  },
  {
    "id": 49,
    "text": "“这个人也许永远不回来了，也许‘明天’回来”，",
    "start": 200.776,
    "end": 204.333,
    "duration": 3.557
  },
  {
    "id": 50,
    "text": "这句饱含惆唱的经典结尾，深化了全篇对不可抗拒之宿命力量的叹息。",
    "start": 204.333,
    "end": 210.401,
    "duration": 6.068
  },
  {
    "id": 51,
    "text": "更为深刻的是，沈从文创造湘西世界的根本动力，",
    "start": 210.401,
    "end": 214.585,
    "duration": 4.184
  },
  {
    "id": 52,
    "text": "是以这方纯朴净土作为审视现代都市病态文明的精神镜子。",
    "start": 214.585,
    "end": 219.816,
    "duration": 5.231
  },
  {
    "id": 53,
    "text": "他借边地人民健全硬朗的生命力，无情反衬出现代都市人精神的萎靡堕落与道德的沦丧，",
    "start": 219.896,
    "end": 227.416,
    "duration": 7.52
  },
  {
    "id": 54,
    "text": "体现了深刻的现代性反思。",
    "start": 227.416,
    "end": 229.416,
    "duration": 2.0
  },
  {
    "id": 55,
    "text": "综上所述，沈从文《边城》以至情至性的人性开掘洗涤了现代人的心灵尘埃，",
    "start": 229.416,
    "end": 235.336,
    "duration": 5.92
  },
  {
    "id": 56,
    "text": "以清雅绝俗的抒情文体确立了中国现代抒情小说的高峰标杆。",
    "start": 235.336,
    "end": 240.056,
    "duration": 4.72
  },
  {
    "id": 57,
    "text": "它不仅在文学地理上开拓出永恒的湘西神话，",
    "start": 240.376,
    "end": 244.296,
    "duration": 3.92
  },
  {
    "id": 58,
    "text": "更以其博大深邃的人文关怀，成为世界文学长廊中熠熠生辉的东方诗意经典。",
    "start": 244.296,
    "end": 250.696,
    "duration": 6.4
  }
]