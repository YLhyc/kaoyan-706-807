[
  {
    "id": 1,
    "start": 0.08,
    "end": 7.04,
    "text": "沈从文所著中篇小说《边城》是中国现代文学史上诗意乡土小说的巅峰之作，"
  },
  {
    "id": 2,
    "start": 7.04,
    "end": 11.36,
    "text": "也是京派文学追求纯正审美品格的最高代表。"
  },
  {
    "id": 3,
    "start": 11.36,
    "end": 15.04,
    "text": "沈从文在远离现代工业都市喧嚣的湘西茶峒，"
  },
  {
    "id": 4,
    "start": 15.04,
    "end": 18.96,
    "text": "以虔诚的心灵建构起一座供奉“人性”的神庙。"
  },
  {
    "id": 5,
    "start": 18.96,
    "end": 22.88,
    "text": "小说以澄澈温润的散文笔调，将自然山水、"
  },
  {
    "id": 6,
    "start": 22.88,
    "end": 31.36,
    "text": "古朴民风与至纯人性融铸一炉，开创了现代小说抒情化与风俗化并茂的崭新文体范式。"
  },
  {
    "id": 7,
    "start": 31.68,
    "end": 37.36,
    "text": "第一，在思想精神与美学品格上，作品旨在重塑一种“优美、"
  },
  {
    "id": 8,
    "start": 37.36,
    "end": 40.8,
    "text": "健康、自然，而又不悖于人性的人生形式”，"
  },
  {
    "id": 9,
    "start": 40.8,
    "end": 44.24,
    "text": "构筑了充满至善至美的人性理想殿堂。"
  },
  {
    "id": 10,
    "start": 44.24,
    "end": 51.6,
    "text": "沈从文笔下的湘西茶峒，是一个未被现代商业金钱关系与机械文明污染的桃花源式社会。"
  },
  {
    "id": 11,
    "start": 51.92,
    "end": 58.4,
    "text": "在这一纯净空间中，每个人身上都闪烁着中国传统伦理中最纯真的德性光辉。"
  },
  {
    "id": 12,
    "start": 58.4,
    "end": 61.68,
    "text": "老船夫五十年如一日摆渡于碧溪居，"
  },
  {
    "id": 13,
    "start": 61.68,
    "end": 67.68,
    "text": "恪尽职守，义不取利，将全部生命的温情倾注于外孙女翠翠身上。"
  },
  {
    "id": 14,
    "start": 67.68,
    "end": 71.6,
    "text": "翠翠依山傍水生长，天真无邪，空灵澄澈，"
  },
  {
    "id": 15,
    "start": 71.6,
    "end": 74.56,
    "text": "其在渡船上对挪送朦胧爱恋的萌发，"
  },
  {
    "id": 16,
    "start": 74.56,
    "end": 76.72,
    "text": "完全是生命天性自然的律动。"
  },
  {
    "id": 17,
    "start": 76.96,
    "end": 79.84,
    "text": "天保与挪送两兄弟爱上同一个女子，"
  },
  {
    "id": 18,
    "start": 79.84,
    "end": 85.52,
    "text": "却摒弃世俗勾心斗角，遵循当地古朴的“走马路”唱歌求爱法则，"
  },
  {
    "id": 19,
    "start": 85.52,
    "end": 88.08,
    "text": "兄让弟先，重情轻利。"
  },
  {
    "id": 20,
    "start": 88.08,
    "end": 91.28,
    "text": "这种人与人之间真挚互助、自尊自爱、"
  },
  {
    "id": 21,
    "start": 91.28,
    "end": 97.68,
    "text": "毫无机巧算计的伦理风貌，展现了中国传统原生态文明中最动人的人性底色。"
  },
  {
    "id": 22,
    "start": 97.976,
    "end": 101.096,
    "text": "第二，在文体建构与小说叙事艺术上，"
  },
  {
    "id": 23,
    "start": 101.096,
    "end": 105.576,
    "text": "作品打破了传统小说强情节与戏剧化冲突的模式，"
  },
  {
    "id": 24,
    "start": 105.576,
    "end": 109.656,
    "text": "奠定了散文化、诗意化的现代乡土抒情小说范式。"
  },
  {
    "id": 25,
    "start": 109.656,
    "end": 113.416,
    "text": "沈从文将小说的叙事重心从紧张的情节推演，"
  },
  {
    "id": 26,
    "start": 113.416,
    "end": 117.496,
    "text": "转移到如诗如画的环境风物与地方民俗的舒展铺陈上。"
  },
  {
    "id": 27,
    "start": 117.896,
    "end": 122.696,
    "text": "茶峒的吊脚楼、清澈见底的白河、碧溪居的白塔与渡船，"
  },
  {
    "id": 28,
    "start": 122.696,
    "end": 125.176,
    "text": "在作者笔下皆具油画般的质感。"
  },
  {
    "id": 29,
    "start": 125.176,
    "end": 129.176,
    "text": "小说浓墨重彩地描绘了端午节全城出动赛龙舟、"
  },
  {
    "id": 30,
    "start": 129.176,
    "end": 135.416,
    "text": "捉鸭子的民俗盛况，以及青年男女月夜在对溪山崖上以歌代言的浪漫风情。"
  },
  {
    "id": 31,
    "start": 135.416,
    "end": 140.536,
    "text": "全篇行文清丽明澈，平缓从容，语言如山泉般自然流淌，"
  },
  {
    "id": 32,
    "start": 140.536,
    "end": 144.056,
    "text": "大量运用洗练的白描与富于音乐感的节奏，"
  },
  {
    "id": 33,
    "start": 144.056,
    "end": 147.496,
    "text": "实现了小说、散文与诗歌美学的深度交融。"
  },
  {
    "id": 34,
    "start": 147.736,
    "end": 151.176,
    "text": "第三，在哲理开掘与文化反思机制上，"
  },
  {
    "id": 35,
    "start": 151.176,
    "end": 159.096,
    "text": "作品在明朗恬淡的牧歌情调之下，掩映着深沉庄严的命运悲剧感与对现代文明异化的批判。"
  },
  {
    "id": 36,
    "start": 159.096,
    "end": 163.096,
    "text": "沈从文的田园牧歌绝非浅薄的乐观粉饰，"
  },
  {
    "id": 37,
    "start": 163.096,
    "end": 167.736,
    "text": "小说始终笼罩着对人生无常与造化弄人的淡淡感伤。"
  },
  {
    "id": 38,
    "start": 167.736,
    "end": 171.096,
    "text": "天保的意外溺亡、老船夫的猝然长逝、"
  },
  {
    "id": 39,
    "start": 171.096,
    "end": 176.616,
    "text": "白塔的坍塌与挪送的负气远走，使翠翠陷入了孤寂的漫长等待。"
  },
  {
    "id": 40,
    "start": 176.776,
    "end": 180.333,
    "text": "“这个人也许永远不回来了，也许‘明天’回来”，"
  },
  {
    "id": 41,
    "start": 180.333,
    "end": 186.401,
    "text": "这句饱含惆唱的经典结尾，深化了全篇对不可抗拒之宿命力量的叹息。"
  },
  {
    "id": 42,
    "start": 186.401,
    "end": 190.585,
    "text": "更为深刻的是，沈从文创造湘西世界的根本动力，"
  },
  {
    "id": 43,
    "start": 190.585,
    "end": 195.816,
    "text": "是以这方纯朴净土作为审视现代都市病态文明的精神镜子。"
  },
  {
    "id": 44,
    "start": 195.896,
    "end": 203.416,
    "text": "他借边地人民健全硬朗的生命力，无情反衬出现代都市人精神的萎靡堕落与道德的沦丧，"
  },
  {
    "id": 45,
    "start": 203.416,
    "end": 205.416,
    "text": "体现了深刻的现代性反思。"
  },
  {
    "id": 46,
    "start": 205.416,
    "end": 211.336,
    "text": "综上所述，沈从文《边城》以至情至性的人性开掘洗涤了现代人的心灵尘埃，"
  },
  {
    "id": 47,
    "start": 211.336,
    "end": 216.056,
    "text": "以清雅绝俗的抒情文体确立了中国现代抒情小说的高峰标杆。"
  },
  {
    "id": 48,
    "start": 216.376,
    "end": 220.296,
    "text": "它不仅在文学地理上开拓出永恒的湘西神话，"
  },
  {
    "id": 49,
    "start": 220.296,
    "end": 226.696,
    "text": "更以其博大深邃的人文关怀，成为世界文学长廊中熠熠生辉的东方诗意经典。"
  }
]