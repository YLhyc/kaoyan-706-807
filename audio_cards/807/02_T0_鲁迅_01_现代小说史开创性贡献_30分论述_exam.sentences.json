[
  {
    "id": 1,
    "text": "试论鲁迅小说对中国现代小说史的开创性贡献。",
    "start": 0.16,
    "end": 4.068,
    "duration": 3.908
  },
  {
    "id": 2,
    "text": "中国现代小说在鲁迅笔下诞生，亦在鲁迅手中迅速跨入成熟阶段。",
    "start": 4.42,
    "end": 9.713,
    "duration": 5.293
  },
  {
    "id": 3,
    "text": "五四新文化运动时期《狂人日记》的问世，宣告了中国现代白话小说的确立，",
    "start": 10.076,
    "end": 15.779,
    "duration": 5.703
  },
  {
    "id": 4,
    "text": "并奠定了五四新文学思想启蒙与形式革新的双重标杆；",
    "start": 16.038,
    "end": 20.569,
    "duration": 4.531
  },
  {
    "id": 5,
    "text": "其后《呐喊》与《彷徨》两部小说集，",
    "start": 20.825,
    "end": 23.018,
    "duration": 2.193
  },
  {
    "id": 6,
    "text": "以自觉的文体意识与精神深度，树立了中国现代小说的经典范式。",
    "start": 23.289,
    "end": 28.173,
    "duration": 4.884
  },
  {
    "id": 7,
    "text": "鲁迅对现代小说史的贡献主要体现在以下四个核心维度：",
    "start": 28.489,
    "end": 32.63,
    "duration": 4.141
  },
  {
    "id": 8,
    "text": "第一，颠覆古典叙事章法，确立现代白话短篇小说的崭新文体范式。",
    "start": 33.282,
    "end": 39.196,
    "duration": 5.914
  },
  {
    "id": 9,
    "text": "《狂人日记》打破了中国传统章回小说依附于连贯情节与全知视角的叙事惯性，",
    "start": 39.506,
    "end": 45.575,
    "duration": 6.069
  },
  {
    "id": 10,
    "text": "开创性地借狂人的心理意识流动来结构全篇，由“事件叙事”转向“心理叙事”。",
    "start": 45.836,
    "end": 51.8,
    "duration": 5.964
  },
  {
    "id": 11,
    "text": "鲁迅将现代白话提炼为高度洗练、富有哲思与表现张力的文学语言，",
    "start": 52.093,
    "end": 57.306,
    "duration": 5.213
  },
  {
    "id": 12,
    "text": "告别了晚清白话小说拖沓生硬的过渡状态；",
    "start": 57.522,
    "end": 60.68,
    "duration": 3.158
  },
  {
    "id": 13,
    "text": "《阿Q正传》更以其深刻的国民性解剖代表现代汉语小说走入世界文学之林，",
    "start": 61.005,
    "end": 67.039,
    "duration": 6.034
  },
  {
    "id": 14,
    "text": "使中国新小说在发轫之初便获得了与世界现代文学平视的艺术尊严。",
    "start": 67.365,
    "end": 72.853,
    "duration": 5.488
  },
  {
    "id": 15,
    "text": "第二，开辟农民与知识分子两大题材，将表现重心深切转向“灵魂深处”。",
    "start": 73.498,
    "end": 79.84,
    "duration": 6.342
  },
  {
    "id": 16,
    "text": "鲁迅小说直面“病态社会中不幸的人们”，却拒绝廉价的苦难展览。",
    "start": 80.29,
    "end": 85.34,
    "duration": 5.05
  },
  {
    "id": 17,
    "text": "《药》中只用一床满幅补钉的旧夹被虚写清贫，",
    "start": 85.909,
    "end": 89.386,
    "duration": 3.477
  },
  {
    "id": 18,
    "text": "正面镜头却冷峻聚焦于华老栓买人血馒头为子治病的精神愚昧；",
    "start": 89.631,
    "end": 94.932,
    "duration": 5.301
  },
  {
    "id": 19,
    "text": "《故乡》中最撼人心魄的不是农民闰土身受的饥荒与苛税，",
    "start": 95.187,
    "end": 99.287,
    "duration": 4.1
  },
  {
    "id": 20,
    "text": "而是二十年后相见时那一声划出森严阶级鸿沟的“老爷”；",
    "start": 99.705,
    "end": 104.226,
    "duration": 4.521
  },
  {
    "id": 21,
    "text": "《祝福》则以冷峻细密的笔触，",
    "start": 104.564,
    "end": 106.527,
    "duration": 1.963
  },
  {
    "id": 22,
    "text": "精准解剖了祥林嫂在封建政权、族权、神权与夫权罗网中从绝望挣扎走向灵魂死灭的悲剧历程。",
    "start": 106.815,
    "end": 114.646,
    "duration": 7.831
  },
  {
    "id": 23,
    "text": "鲁迅把小说的探照灯从外在物质苦难转向国民内在精神创伤，",
    "start": 114.943,
    "end": 120.34,
    "duration": 5.397
  },
  {
    "id": 24,
    "text": "为现代现实主义文学注入了深厚的思想骨力。",
    "start": 120.706,
    "end": 124.081,
    "duration": 3.375
  },
  {
    "id": 25,
    "text": "第三，独创“看客结构”与“归乡模型”，将深层社会心理机制外化为现代叙事法则。",
    "start": 124.674,
    "end": 131.418,
    "duration": 6.744
  },
  {
    "id": 26,
    "text": "在叙事结构上，鲁迅创造了“看与被看”的二元对峙机制。",
    "start": 132.101,
    "end": 136.607,
    "duration": 4.506
  },
  {
    "id": 27,
    "text": "《孔乙己》中酒客以落魄文人的伤疤取乐，",
    "start": 136.95,
    "end": 139.862,
    "duration": 2.912
  },
  {
    "id": 28,
    "text": "《祝福》中鲁镇民众将祥林嫂阿毛之死的血泪记忆当作消遣的无聊嚼头，",
    "start": 140.229,
    "end": 145.686,
    "duration": 5.457
  },
  {
    "id": 29,
    "text": "《药》中刑场外伸长颈项如鸭子般的看客群像，",
    "start": 145.964,
    "end": 149.746,
    "duration": 3.782
  },
  {
    "id": 30,
    "text": "将民众失去主体意识后的麻木围观推向“吃与被吃”的精神寓言。",
    "start": 149.951,
    "end": 155.113,
    "duration": 5.162
  },
  {
    "id": 31,
    "text": "同时，《故乡》与《在酒楼上》开创了始于篷船、终于篷船的“离去—归来—再离去”现代归乡模型，",
    "start": 155.389,
    "end": 162.278,
    "duration": 6.889
  },
  {
    "id": 32,
    "text": "具象化了启蒙知识分子怀抱理想归乡、遭遇现实荒寒、进退失据的普遍精神漂泊困境。",
    "start": 162.645,
    "end": 169.602,
    "duration": 6.957
  },
  {
    "id": 33,
    "text": "第四，秉持“一篇有一篇之形式”的美学追求，开创中西艺术经验交融的实验范本。",
    "start": 170.258,
    "end": 177.363,
    "duration": 7.105
  },
  {
    "id": 34,
    "text": "鲁迅博采西方现代象征主义、表现主义与中国古典白描、史传笔法，",
    "start": 177.725,
    "end": 183.52,
    "duration": 5.795
  },
  {
    "id": 35,
    "text": "展现了高度开放的文体创造力。",
    "start": 183.7,
    "end": 185.987,
    "duration": 2.287
  },
  {
    "id": 36,
    "text": "《狂人日记》巧妙设置文言小序与白话正文的双重视角，构筑起反思传统文明的复调反讽隐喻；",
    "start": 186.231,
    "end": 193.829,
    "duration": 7.598
  },
  {
    "id": 37,
    "text": "《孔乙己》以十二岁小伙计的有限视点叙事，形成童稚视角与世态炎凉之间的冷峻张力；",
    "start": 194.042,
    "end": 200.604,
    "duration": 6.562
  },
  {
    "id": 38,
    "text": "《阿Q正传》戏仿传统“正史正传”体制，",
    "start": 200.853,
    "end": 203.676,
    "duration": 2.823
  },
  {
    "id": 39,
    "text": "以游戏笔调打破封建史传只为帝王将相立传的森严秩序。",
    "start": 203.85,
    "end": 208.502,
    "duration": 4.652
  },
  {
    "id": 40,
    "text": "散文诗笔调、象征隐喻与辛辣反讽浑然一体，拓展了现代小说的审美疆界。",
    "start": 208.73,
    "end": 215.0,
    "duration": 6.27
  },
  {
    "id": 41,
    "text": "总而言之，鲁迅立现代小说之体、拓现代小说之深、创现代叙事之型、铸现代文学之魂。",
    "start": 215.669,
    "end": 222.88,
    "duration": 7.211
  },
  {
    "id": 42,
    "text": "他以卓越的艺术探索，使中国现代小说在起步之时便告别了古典陈规，",
    "start": 223.225,
    "end": 228.776,
    "duration": 5.551
  },
  {
    "id": 43,
    "text": "确立了足以照耀后世的经典坐标。",
    "start": 228.868,
    "end": 231.16,
    "duration": 2.292
  }
]