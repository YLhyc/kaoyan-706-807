[
  {
    "id": 1,
    "text": "中国现代小说在鲁迅手中开始，又在鲁迅手中走向完全成熟。",
    "start": 0.08,
    "end": 5.76,
    "duration": 5.68
  },
  {
    "id": 2,
    "text": "一九一八年，狂人日记，的发表，标志着中国现代白话小说的正式诞生。",
    "start": 5.76,
    "end": 11.84,
    "duration": 6.08
  },
  {
    "id": 3,
    "text": "呐喊，与，彷徨，两部小说集，则确立了中国现代小说的经典范式。",
    "start": 11.84,
    "end": 18.24,
    "duration": 6.4
  },
  {
    "id": 4,
    "text": "鲁迅对中国小说史的贡献是全方位而深远的。",
    "start": 18.24,
    "end": 22.24,
    "duration": 4.0
  },
  {
    "id": 5,
    "text": "我们可以从历史奠基、题材与精神深度、",
    "start": 22.4,
    "end": 25.659,
    "duration": 3.259
  },
  {
    "id": 6,
    "text": "结构模式以及形式实验四个维度展开深入论证。",
    "start": 25.659,
    "end": 29.734,
    "duration": 4.075
  },
  {
    "id": 7,
    "text": "第一，在文学史奠基上，鲁迅开创了现代白话小说体式，",
    "start": 29.734,
    "end": 34.215,
    "duration": 4.481
  },
  {
    "id": 8,
    "text": "并确立了成熟的范式。",
    "start": 34.215,
    "end": 36.049,
    "duration": 1.834
  },
  {
    "id": 9,
    "text": "《狂人日记》彻底打破了传统章回小说有头有尾、",
    "start": 36.049,
    "end": 39.919,
    "duration": 3.87
  },
  {
    "id": 10,
    "text": "依次展开情节的结构惯例。",
    "start": 39.919,
    "end": 42.16,
    "duration": 2.241
  },
  {
    "id": 11,
    "text": "作品借由狂人的心理意识流动来组织篇章，",
    "start": 42.24,
    "end": 45.68,
    "duration": 3.44
  },
  {
    "id": 12,
    "text": "赋予了白话语言前所未有的文学表现力。",
    "start": 45.68,
    "end": 48.8,
    "duration": 3.12
  },
  {
    "id": 13,
    "text": "此后，鲁迅在《呐喊》与《彷徨》中塑造了丰富生动的现代典型群像。",
    "start": 48.8,
    "end": 54.24,
    "duration": 5.44
  },
  {
    "id": 14,
    "text": "《阿Q正传》更代表中国现代文学走向世界，",
    "start": 54.24,
    "end": 57.44,
    "duration": 3.2
  },
  {
    "id": 15,
    "text": "赢得了世界文学之林的尊严。",
    "start": 57.44,
    "end": 59.52,
    "duration": 2.08
  },
  {
    "id": 16,
    "text": "鲁迅不仅写出了第一篇真正意义上的现代小说，",
    "start": 59.76,
    "end": 63.52,
    "duration": 3.76
  },
  {
    "id": 17,
    "text": "更为后世作家树立了难以逾越的经典范本。",
    "start": 63.52,
    "end": 66.88,
    "duration": 3.36
  },
  {
    "id": 18,
    "text": "第二，在题材与精神开掘上，鲁迅开辟了农民与知识分子两大题材，",
    "start": 66.88,
    "end": 72.56,
    "duration": 5.68
  },
  {
    "id": 19,
    "text": "并将笔触深入到“灵魂的深”。",
    "start": 72.56,
    "end": 75.04,
    "duration": 2.48
  },
  {
    "id": 20,
    "text": "鲁迅取材于病态社会的不幸人们，却坚决拒绝浅薄的苦难展览。",
    "start": 75.04,
    "end": 80.16,
    "duration": 5.12
  },
  {
    "id": 21,
    "text": "《药》中只用一床满幅补钉的夹被暗示贫困，",
    "start": 80.32,
    "end": 83.907,
    "duration": 3.587
  },
  {
    "id": 22,
    "text": "正面聚焦的却是华老栓买人血瞒头的精神愚昧。",
    "start": 83.907,
    "end": 88.127,
    "duration": 4.22
  },
  {
    "id": 23,
    "text": "《故乡》最震动人心的不是闰土生活的艰难，",
    "start": 88.127,
    "end": 91.713,
    "duration": 3.586
  },
  {
    "id": 24,
    "text": "而是那一声隔膜的“老爷”。",
    "start": 91.713,
    "end": 93.823,
    "duration": 2.11
  },
  {
    "id": 25,
    "text": "《祝福》则深刻透析了祥林嫂在封建神权与宗法压迫下的灵魂惊恐。",
    "start": 93.823,
    "end": 99.52,
    "duration": 5.697
  },
  {
    "id": 26,
    "text": "鲁迅把小说的目光从外在物质苦难转向内在精神创痛，",
    "start": 99.6,
    "end": 104.72,
    "duration": 5.12
  },
  {
    "id": 27,
    "text": "赋予了中国现代小说深沉的哲思内向性。",
    "start": 104.72,
    "end": 108.64,
    "duration": 3.92
  },
  {
    "id": 28,
    "text": "第三，在叙事机制上，鲁迅创造了“看或被看”与“离去，",
    "start": 108.64,
    "end": 114.16,
    "duration": 5.52
  },
  {
    "id": 29,
    "text": "归来，再离去”两大现代结构模型。",
    "start": 114.16,
    "end": 117.28,
    "duration": 3.12
  },
  {
    "id": 30,
    "text": "在《祝福》与《孔乙己》中，老女人将祥林嫂的痛苦作为消遣，",
    "start": 117.28,
    "end": 121.76,
    "duration": 4.48
  },
  {
    "id": 31,
    "text": "酒客以孔乙己的伤疤取乐。",
    "start": 121.76,
    "end": 123.76,
    "duration": 2.0
  },
  {
    "id": 32,
    "text": "《药》更进一步将看客的围观推向了吃与被吃的血腥寓言。",
    "start": 123.92,
    "end": 128.566,
    "duration": 4.646
  },
  {
    "id": 33,
    "text": "这使小说结构本身成为了社会冷漠关系的艺术外化。",
    "start": 128.566,
    "end": 133.009,
    "duration": 4.443
  },
  {
    "id": 34,
    "text": "同时，《故乡》与《在酒楼上》确立了始于篷船、",
    "start": 133.009,
    "end": 136.241,
    "duration": 3.232
  },
  {
    "id": 35,
    "text": "终于篷船的圆形归乡模式。",
    "start": 136.241,
    "end": 138.463,
    "duration": 2.222
  },
  {
    "id": 36,
    "text": "它精准呈现了现代启蒙知识分子无家可归、",
    "start": 138.463,
    "end": 142.098,
    "duration": 3.635
  },
  {
    "id": 37,
    "text": "进退失据的精神漂泊困境。",
    "start": 142.098,
    "end": 144.32,
    "duration": 2.222
  },
  {
    "id": 38,
    "text": "第四，在文体与技巧探索上，鲁迅秉持“一篇有一篇之形式”的先锋实验精神。",
    "start": 144.464,
    "end": 151.424,
    "duration": 6.96
  },
  {
    "id": 39,
    "text": "他创造性融合了西方现代艺术经验与中国本土古典资源。",
    "start": 151.424,
    "end": 155.904,
    "duration": 4.48
  },
  {
    "id": 40,
    "text": "《狂人日记》以文言小序与白话正文形成双重叙述，",
    "start": 155.904,
    "end": 160.064,
    "duration": 4.16
  },
  {
    "id": 41,
    "text": "构成深刻的反讽互文。",
    "start": 160.064,
    "end": 161.984,
    "duration": 1.92
  },
  {
    "id": 42,
    "text": "《孔乙己》以十二岁的小伙计为第一人称有限视点，",
    "start": 161.984,
    "end": 165.584,
    "duration": 3.6
  },
  {
    "id": 43,
    "text": "构筑起精妙的多重叙述网络。",
    "start": 165.584,
    "end": 167.744,
    "duration": 2.16
  },
  {
    "id": 44,
    "text": "《阿Q正传》巧妙改造传统传记文体，",
    "start": 167.904,
    "end": 170.784,
    "duration": 2.88
  },
  {
    "id": 45,
    "text": "叙述距离在冷嘲与悲敏之间灵活流动。",
    "start": 170.784,
    "end": 174.075,
    "duration": 3.291
  },
  {
    "id": 46,
    "text": "鲁迅还将散文诗笔调、白描勾勒与心理分析融为一体，",
    "start": 174.075,
    "end": 178.601,
    "duration": 4.526
  },
  {
    "id": 47,
    "text": "极大地拓展了现代小说的美学疆域。",
    "start": 178.601,
    "end": 181.687,
    "duration": 3.086
  },
  {
    "id": 48,
    "text": "综上所述，鲁迅对中国小说史的贡献是根本性与全局性的。",
    "start": 181.687,
    "end": 186.624,
    "duration": 4.937
  },
  {
    "id": 49,
    "text": "他立现代小说之体，拓现代小说之深，",
    "start": 186.704,
    "end": 189.995,
    "duration": 3.291
  },
  {
    "id": 50,
    "text": "创现代小说之型，铸现代小说之魂。",
    "start": 189.995,
    "end": 193.108,
    "duration": 3.113
  },
  {
    "id": 51,
    "text": "中国现代小说因鲁迅的卓越开拓，在起步阶段便跨入了世界文学的成熟高度。--",
    "start": 193.108,
    "end": 200.224,
    "duration": 7.116
  }
]