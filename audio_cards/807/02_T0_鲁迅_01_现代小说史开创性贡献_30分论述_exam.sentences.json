[
  {
    "id": 1,
    "text": "试论鲁迅小说对中国现代小说史的开创性贡献。",
    "start": 0.134,
    "end": 3.866,
    "duration": 3.732
  },
  {
    "id": 2,
    "text": "中国现代小说在鲁迅笔下诞生，亦在鲁迅手中迅速跨入成熟阶段。",
    "start": 4.543,
    "end": 9.475,
    "duration": 4.932
  },
  {
    "id": 3,
    "text": "五四新文化运动时期《狂人日记》的问世，宣告了中国现代白话小说的确立，",
    "start": 10.193,
    "end": 12.925,
    "duration": 2.732
  },
  {
    "id": 4,
    "text": "并奠定了五四新文学思想启蒙与形式革新的双重标杆；",
    "start": 13.304,
    "end": 16.316,
    "duration": 3.012
  },
  {
    "id": 5,
    "text": "其后《呐喊》与《彷徨》两部小说集，以自觉的文体意识与精神深度，树立了中国现代小说的经典范式。",
    "start": 16.845,
    "end": 20.887,
    "duration": 4.042
  },
  {
    "id": 6,
    "text": "鲁迅对现代小说史的贡献主要体现在以下四个核心维度：",
    "start": 21.605,
    "end": 28.537,
    "duration": 6.932
  },
  {
    "id": 7,
    "text": "第一，颠覆古典叙事章法，确立现代白话短篇小说的崭新文体范式。",
    "start": 29.215,
    "end": 38.587,
    "duration": 9.372
  },
  {
    "id": 8,
    "text": "《狂人日记》打破了中国传统章回小说依附于连贯情节与全知视角的叙事惯性，",
    "start": 39.265,
    "end": 44.957,
    "duration": 5.692
  },
  {
    "id": 9,
    "text": "开创性地借狂人的心理意识流动来结构全篇，由“事件叙事”转向“心理叙事”。",
    "start": 45.336,
    "end": 51.028,
    "duration": 5.692
  },
  {
    "id": 10,
    "text": "鲁迅将现代白话提炼为高度洗练、富有哲思与表现张力的文学语言，",
    "start": 51.706,
    "end": 60.078,
    "duration": 8.372
  },
  {
    "id": 11,
    "text": "告别了晚清白话小说拖沓生硬的过渡状态；",
    "start": 60.876,
    "end": 60.968,
    "duration": 0.092
  },
  {
    "id": 12,
    "text": "《阿Q正传》更以其深刻的国民性解剖代表现代汉语小说走入世界文学之林，",
    "start": 61.497,
    "end": 66.659,
    "duration": 5.162
  },
  {
    "id": 13,
    "text": "使中国新小说在发轫之初便获得了与世界现代文学平视的艺术尊严。",
    "start": 67.038,
    "end": 72.13,
    "duration": 5.092
  },
  {
    "id": 14,
    "text": "第二，开辟农民与知识分子两大题材，将表现重心深切转向“灵魂深处”。",
    "start": 72.808,
    "end": 78.5,
    "duration": 5.692
  },
  {
    "id": 15,
    "text": "鲁迅小说直面“病态社会中不幸的人们”，却拒绝廉价的苦难展览。",
    "start": 79.138,
    "end": 84.11,
    "duration": 4.972
  },
  {
    "id": 16,
    "text": "《药》中只用一床满幅补钉的旧夹被虚写清贫，",
    "start": 84.828,
    "end": 88.04,
    "duration": 3.212
  },
  {
    "id": 17,
    "text": "正面镜头却冷峻聚焦于华老栓买人血馒头为子治病的精神愚昧；",
    "start": 88.419,
    "end": 93.431,
    "duration": 5.012
  },
  {
    "id": 18,
    "text": "《故乡》中最撼人心魄的不是农民闰土身受的饥荒与苛税，而是二十年后相见时那一声划出森严阶级鸿沟的“老爷”；",
    "start": 93.96,
    "end": 102.892,
    "duration": 8.932
  },
  {
    "id": 19,
    "text": "《祝福》则以冷峻细密的笔触，精准解剖了祥林嫂在封建政权、族权、神权与夫权罗网中从绝望挣扎走向灵魂死灭的悲剧历程。",
    "start": 103.421,
    "end": 114.153,
    "duration": 10.732
  },
  {
    "id": 20,
    "text": "鲁迅把小说的探照灯从外在物质苦难转向国民内在精神创伤，",
    "start": 114.682,
    "end": 119.254,
    "duration": 4.572
  },
  {
    "id": 21,
    "text": "为现代现实主义文学注入了深厚的思想骨力。",
    "start": 119.633,
    "end": 123.005,
    "duration": 3.372
  },
  {
    "id": 22,
    "text": "第三，独创“看客结构”与“归乡模型”，将深层社会心理机制外化为现代叙事法则。",
    "start": 123.629,
    "end": 129.961,
    "duration": 6.332
  },
  {
    "id": 23,
    "text": "在叙事结构上，鲁迅创造了“看与被看”的二元对峙机制。",
    "start": 130.559,
    "end": 134.771,
    "duration": 4.212
  },
  {
    "id": 24,
    "text": "《孔乙己》中酒客以落魄文人的伤疤取乐，《祝福》中鲁镇民众将祥林嫂阿毛之死的血泪记忆当作消遣的无聊嚼头，",
    "start": 135.449,
    "end": 143.621,
    "duration": 8.172
  },
  {
    "id": 25,
    "text": "《药》中刑场外伸长颈项如鸭子般的看客群像，",
    "start": 144.05,
    "end": 147.342,
    "duration": 3.292
  },
  {
    "id": 26,
    "text": "将民众失去主体意识后的麻木围观推向“吃与被吃”的精神寓言。",
    "start": 147.721,
    "end": 152.053,
    "duration": 4.332
  },
  {
    "id": 27,
    "text": "同时，《故乡》以始于篷船、终于篷船的架构，与《在酒楼上》共同开创“离去—归来—再离去”现代归乡模型，",
    "start": 152.75,
    "end": 161.362,
    "duration": 8.612
  },
  {
    "id": 28,
    "text": "具象化了启蒙知识分子怀抱理想归乡、遭遇现实荒寒、进退失据的普遍精神漂泊困境。",
    "start": 161.953,
    "end": 168.645,
    "duration": 6.692
  },
  {
    "id": 29,
    "text": "第四，秉持“一篇有一篇之形式”的美学追求，开创中西艺术经验交融的实验范本。",
    "start": 169.3,
    "end": 175.592,
    "duration": 6.292
  },
  {
    "id": 30,
    "text": "鲁迅博采西方现代象征主义、表现主义与中国古典白描、史传笔法，",
    "start": 176.27,
    "end": 181.202,
    "duration": 4.932
  },
  {
    "id": 31,
    "text": "展现了高度开放的文体创造力。",
    "start": 181.581,
    "end": 183.713,
    "duration": 2.132
  },
  {
    "id": 32,
    "text": "《狂人日记》巧妙设置文言小序与白话正文的双重视角，构筑起反思传统文明的复调反讽隐喻；",
    "start": 184.351,
    "end": 191.643,
    "duration": 7.292
  },
  {
    "id": 33,
    "text": "《孔乙己》以十二岁小伙计的有限视点叙事，形成童稚视角与世态炎凉之间的冷峻张力；",
    "start": 192.361,
    "end": 195.213,
    "duration": 2.852
  },
  {
    "id": 34,
    "text": "《阿Q正传》戏仿传统“正史正传”体制，",
    "start": 195.742,
    "end": 197.594,
    "duration": 1.852
  },
  {
    "id": 35,
    "text": "以游戏笔调打破封建史传只为帝王将相立传的森严秩序。",
    "start": 197.973,
    "end": 199.385,
    "duration": 1.412
  },
  {
    "id": 36,
    "text": "散文诗笔调、象征隐喻与辛辣反讽浑然一体，拓展了现代小说的审美疆界。",
    "start": 200.103,
    "end": 207.155,
    "duration": 7.052
  },
  {
    "id": 37,
    "text": "总而言之，鲁迅立现代小说之体、拓现代小说之深、创现代叙事之型、铸现代文学之魂。",
    "start": 207.833,
    "end": 213.925,
    "duration": 6.092
  },
  {
    "id": 38,
    "text": "他以卓越的艺术探索，使中国现代小说在起步之时便告别了古典陈规，",
    "start": 214.603,
    "end": 223.495,
    "duration": 8.892
  },
  {
    "id": 39,
    "text": "确立了足以照耀后世的经典坐标。",
    "start": 224.046,
    "end": 230.218,
    "duration": 6.172
  }
]