[
  {
    "id": 1,
    "text": "试论鲁迅小说对中国现代小说史的开创性贡献。",
    "start": 0.16,
    "end": 4.068,
    "duration": 3.908
  },
  {
    "id": 2,
    "text": "中国现代小说在鲁迅笔下诞生，亦在鲁迅手中迅速跨入成熟阶段。",
    "start": 4.568,
    "end": 9.861,
    "duration": 5.293
  },
  {
    "id": 3,
    "text": "五四新文化运动时期《狂人日记》的问世，宣告了中国现代白话小说的确立，",
    "start": 10.361,
    "end": 16.064,
    "duration": 5.703
  },
  {
    "id": 4,
    "text": "并奠定了五四新文学思想启蒙与形式革新的双重标杆；",
    "start": 16.414,
    "end": 20.945,
    "duration": 4.531
  },
  {
    "id": 5,
    "text": "其后《呐喊》与《彷徨》两部小说集，",
    "start": 21.445,
    "end": 23.638,
    "duration": 2.193
  },
  {
    "id": 6,
    "text": "以自觉的文体意识与精神深度，树立了中国现代小说的经典范式。",
    "start": 23.988,
    "end": 28.872,
    "duration": 4.884
  },
  {
    "id": 7,
    "text": "鲁迅对现代小说史的贡献主要体现在以下四个核心维度：",
    "start": 29.372,
    "end": 33.513,
    "duration": 4.141
  },
  {
    "id": 8,
    "text": "第一，颠覆古典叙事章法，确立现代白话短篇小说的崭新文体范式。",
    "start": 34.165,
    "end": 40.079,
    "duration": 5.914
  },
  {
    "id": 9,
    "text": "《狂人日记》打破了中国传统章回小说依附于连贯情节与全知视角的叙事惯性，",
    "start": 40.579,
    "end": 46.648,
    "duration": 6.069
  },
  {
    "id": 10,
    "text": "开创性地借狂人的心理意识流动来结构全篇，由“事件叙事”转向“心理叙事”。",
    "start": 46.998,
    "end": 52.962,
    "duration": 5.964
  },
  {
    "id": 11,
    "text": "鲁迅将现代白话提炼为高度洗练、富有哲思与表现张力的文学语言，",
    "start": 53.462,
    "end": 58.675,
    "duration": 5.213
  },
  {
    "id": 12,
    "text": "告别了晚清白话小说拖沓生硬的过渡状态；",
    "start": 59.025,
    "end": 62.183,
    "duration": 3.158
  },
  {
    "id": 13,
    "text": "《阿Q正传》更以其深刻的国民性解剖代表现代汉语小说走入世界文学之林，",
    "start": 62.683,
    "end": 68.717,
    "duration": 6.034
  },
  {
    "id": 14,
    "text": "使中国新小说在发轫之初便获得了与世界现代文学平视的艺术尊严。",
    "start": 69.067,
    "end": 74.555,
    "duration": 5.488
  },
  {
    "id": 15,
    "text": "第二，开辟农民与知识分子两大题材，将表现重心深切转向“灵魂深处”。",
    "start": 75.2,
    "end": 81.542,
    "duration": 6.342
  },
  {
    "id": 16,
    "text": "鲁迅小说直面“病态社会中不幸的人们”，却拒绝廉价的苦难展览。",
    "start": 82.042,
    "end": 87.092,
    "duration": 5.05
  },
  {
    "id": 17,
    "text": "《药》中只用一床满幅补钉的旧夹被虚写清贫，",
    "start": 87.661,
    "end": 91.138,
    "duration": 3.477
  },
  {
    "id": 18,
    "text": "正面镜头却冷峻聚焦于华老栓买人血馒头为子治病的精神愚昧；",
    "start": 91.603,
    "end": 96.684,
    "duration": 5.081
  },
  {
    "id": 19,
    "text": "《故乡》中最撼人心魄的不是农民闰土身受的饥荒与苛税，而是二十年后相见时那一声划出森严阶级鸿沟的“老爷”；",
    "start": 97.184,
    "end": 106.223,
    "duration": 9.039
  },
  {
    "id": 20,
    "text": "《祝福》则以冷峻细密的笔触，精准解剖了祥林嫂在封建政权、族权、神权与夫权罗网中从绝望挣扎走向灵魂死灭的悲剧历程。",
    "start": 106.723,
    "end": 116.805,
    "duration": 10.082
  },
  {
    "id": 21,
    "text": "鲁迅把小说的探照灯从外在物质苦难转向国民内在精神创伤，",
    "start": 117.305,
    "end": 122.702,
    "duration": 5.397
  },
  {
    "id": 22,
    "text": "为现代现实主义文学注入了深厚的思想骨力。",
    "start": 123.068,
    "end": 126.443,
    "duration": 3.375
  },
  {
    "id": 23,
    "text": "第三，独创“看客结构”与“归乡模型”，将深层社会心理机制外化为现代叙事法则。",
    "start": 127.036,
    "end": 133.78,
    "duration": 6.744
  },
  {
    "id": 24,
    "text": "在叙事结构上，鲁迅创造了“看与被看”的二元对峙机制。",
    "start": 134.463,
    "end": 138.969,
    "duration": 4.506
  },
  {
    "id": 25,
    "text": "《孔乙己》中酒客以落魄文人的伤疤取乐，《祝福》中鲁镇民众将祥林嫂阿毛之死的血泪记忆当作消遣的无聊嚼头，",
    "start": 139.469,
    "end": 148.205,
    "duration": 8.736
  },
  {
    "id": 26,
    "text": "《药》中刑场外伸长颈项如鸭子般的看客群像，",
    "start": 148.555,
    "end": 152.337,
    "duration": 3.782
  },
  {
    "id": 27,
    "text": "将民众失去主体意识后的麻木围观推向“吃与被吃”的精神寓言。",
    "start": 152.687,
    "end": 157.849,
    "duration": 5.162
  },
  {
    "id": 28,
    "text": "同时，《故乡》以始于篷船、终于篷船的架构，与《在酒楼上》共同开创“离去—归来—再离去”现代归乡模型，",
    "start": 158.349,
    "end": 167.352,
    "duration": 9.003
  },
  {
    "id": 29,
    "text": "具象化了启蒙知识分子怀抱理想归乡、遭遇现实荒寒、进退失据的普遍精神漂泊困境。",
    "start": 167.824,
    "end": 174.765,
    "duration": 6.941
  },
  {
    "id": 30,
    "text": "第四，秉持“一篇有一篇之形式”的美学追求，开创中西艺术经验交融的实验范本。",
    "start": 175.437,
    "end": 182.53,
    "duration": 7.093
  },
  {
    "id": 31,
    "text": "鲁迅博采西方现代象征主义、表现主义与中国古典白描、史传笔法，",
    "start": 183.03,
    "end": 188.825,
    "duration": 5.795
  },
  {
    "id": 32,
    "text": "展现了高度开放的文体创造力。",
    "start": 189.175,
    "end": 191.462,
    "duration": 2.287
  },
  {
    "id": 33,
    "text": "《狂人日记》巧妙设置文言小序与白话正文的双重视角，构筑起反思传统文明的复调反讽隐喻；",
    "start": 191.962,
    "end": 199.56,
    "duration": 7.598
  },
  {
    "id": 34,
    "text": "《孔乙己》以十二岁小伙计的有限视点叙事，形成童稚视角与世态炎凉之间的冷峻张力；",
    "start": 200.06,
    "end": 206.622,
    "duration": 6.562
  },
  {
    "id": 35,
    "text": "《阿Q正传》戏仿传统“正史正传”体制，",
    "start": 207.122,
    "end": 209.945,
    "duration": 2.823
  },
  {
    "id": 36,
    "text": "以游戏笔调打破封建史传只为帝王将相立传的森严秩序。",
    "start": 210.295,
    "end": 214.947,
    "duration": 4.652
  },
  {
    "id": 37,
    "text": "散文诗笔调、象征隐喻与辛辣反讽浑然一体，拓展了现代小说的审美疆界。",
    "start": 215.447,
    "end": 221.717,
    "duration": 6.27
  },
  {
    "id": 38,
    "text": "总而言之，鲁迅立现代小说之体、拓现代小说之深、创现代叙事之型、铸现代文学之魂。",
    "start": 222.386,
    "end": 229.597,
    "duration": 7.211
  },
  {
    "id": 39,
    "text": "他以卓越的艺术探索，使中国现代小说在起步之时便告别了古典陈规，",
    "start": 230.097,
    "end": 235.652,
    "duration": 5.555
  },
  {
    "id": 40,
    "text": "确立了足以照耀后世的经典坐标。",
    "start": 236.002,
    "end": 238.303,
    "duration": 2.301
  }
]
