[
  {
    "id": 1,
    "text": "试论鲁迅小说对中国现代小说史的开创性贡献。",
    "start": 0.2,
    "end": 3.96,
    "duration": 3.76
  },
  {
    "id": 2,
    "text": "中国现代小说在鲁迅笔下诞生，亦在鲁迅手中迅速跨入成熟阶段。",
    "start": 4.48,
    "end": 10.32,
    "duration": 5.84
  },
  {
    "id": 3,
    "text": "五四新文化运动时期《狂人日记》的问世，宣告了中国现代白话小说的确立，",
    "start": 10.84,
    "end": 16.6,
    "duration": 5.76
  },
  {
    "id": 4,
    "text": "并奠定了五四新文学思想启蒙与形式革新的双重标杆；",
    "start": 16.97,
    "end": 21.37,
    "duration": 4.4
  },
  {
    "id": 5,
    "text": "其后《呐喊》与《彷徨》两部小说集，以自觉的文体意识与精神深度，树立了中国现代小说的经典范式。",
    "start": 21.933,
    "end": 29.65,
    "duration": 7.717
  },
  {
    "id": 6,
    "text": "鲁迅对现代小说史的贡献主要体现在以下四个核心维度：",
    "start": 30.17,
    "end": 34.25,
    "duration": 4.08
  },
  {
    "id": 7,
    "text": "第一，颠覆古典叙事章法，确立现代白话短篇小说的崭新文体范式。",
    "start": 34.62,
    "end": 40.3,
    "duration": 5.68
  },
  {
    "id": 8,
    "text": "《狂人日记》打破了中国传统章回小说依附于连贯情节与全知视角的叙事惯性，",
    "start": 40.82,
    "end": 47.3,
    "duration": 6.48
  },
  {
    "id": 9,
    "text": "开创性地借狂人的心理意识流动来结构全篇，由“事件叙事”转向“心理叙事”。",
    "start": 47.67,
    "end": 53.75,
    "duration": 6.08
  },
  {
    "id": 10,
    "text": "鲁迅将现代白话提炼为高度洗练、富有哲思与表现张力的文学语言，",
    "start": 54.27,
    "end": 59.39,
    "duration": 5.12
  },
  {
    "id": 11,
    "text": "告别了晚清白话小说拖沓生硬的过渡状态；",
    "start": 59.84,
    "end": 63.36,
    "duration": 3.52
  },
  {
    "id": 12,
    "text": "《阿Q正传》更以其深刻的国民性解剖代表现代汉语小说走入世界文学之林，",
    "start": 63.88,
    "end": 70.068,
    "duration": 6.188
  },
  {
    "id": 13,
    "text": "使中国新小说在发轫之初便获得了与世界现代文学平视的艺术尊严。",
    "start": 70.614,
    "end": 76.41,
    "duration": 5.796
  },
  {
    "id": 14,
    "text": "第二，开辟农民与知识分子两大题材，将表现重心深切转向“灵魂深处”。",
    "start": 76.93,
    "end": 83.25,
    "duration": 6.32
  },
  {
    "id": 15,
    "text": "鲁迅小说直面“病态社会中不幸的人们”，却拒绝廉价的苦难展览。",
    "start": 83.77,
    "end": 88.57,
    "duration": 4.8
  },
  {
    "id": 16,
    "text": "《药》中只用一床满幅补钉的旧夹被虚写清贫，",
    "start": 89.09,
    "end": 93.186,
    "duration": 4.096
  },
  {
    "id": 17,
    "text": "正面镜头却冷峻聚焦于华老栓买人血馒头为子治病的精神愚昧；",
    "start": 93.542,
    "end": 99.7,
    "duration": 6.158
  },
  {
    "id": 18,
    "text": "《故乡》中最撼人心魄的不是农民闰土身受的饥荒与苛税，而是二十年后相见时那一声划出森严阶级鸿沟的“老爷”；",
    "start": 100.22,
    "end": 110.3,
    "duration": 10.08
  },
  {
    "id": 19,
    "text": "《祝福》则以冷峻细密的笔触，精准解剖了祥林嫂在封建政权、族权、神权与夫权罗网中从绝望挣扎走向灵魂死灭的悲剧历程。",
    "start": 110.82,
    "end": 122.58,
    "duration": 11.76
  },
  {
    "id": 20,
    "text": "鲁迅把小说的探照灯从外在物质苦难转向国民内在精神创伤，",
    "start": 123.1,
    "end": 128.06,
    "duration": 4.96
  },
  {
    "id": 21,
    "text": "为现代现实主义文学注入了深厚的思想骨力。",
    "start": 128.43,
    "end": 131.95,
    "duration": 3.52
  },
  {
    "id": 22,
    "text": "第三，独创“看客结构”与“归乡模型”，将深层社会心理机制外化为现代叙事法则。",
    "start": 132.47,
    "end": 139.27,
    "duration": 6.8
  },
  {
    "id": 23,
    "text": "在叙事结构上，鲁迅创造了“看与被看”的二元对峙机制。",
    "start": 139.79,
    "end": 144.11,
    "duration": 4.32
  },
  {
    "id": 24,
    "text": "《孔乙己》中酒客以落魄文人的伤疤取乐，《祝福》中鲁镇民众将祥林嫂阿毛之死的血泪记忆当作消遣的无聊嚼头，",
    "start": 144.63,
    "end": 153.32,
    "duration": 8.69
  },
  {
    "id": 25,
    "text": "《药》中刑场外伸长颈项如鸭子般的看客群像，",
    "start": 153.69,
    "end": 157.519,
    "duration": 3.829
  },
  {
    "id": 26,
    "text": "将民众失去主体意识后的麻木围观推向“吃与被吃”的精神寓言。",
    "start": 157.876,
    "end": 163.42,
    "duration": 5.544
  },
  {
    "id": 27,
    "text": "同时，《故乡》以始于篷船、终于篷船的架构，与《在酒楼上》共同开创“离去—归来—再离去”现代归乡模型，",
    "start": 163.94,
    "end": 173.19,
    "duration": 9.25
  },
  {
    "id": 28,
    "text": "具象化了启蒙知识分子怀抱理想归乡、遭遇现实荒寒、进退失据的普遍精神漂泊困境。",
    "start": 173.56,
    "end": 180.84,
    "duration": 7.28
  },
  {
    "id": 29,
    "text": "第四，秉持“一篇有一篇之形式”的美学追求，开创中西艺术经验交融的实验范本。",
    "start": 181.36,
    "end": 188.16,
    "duration": 6.8
  },
  {
    "id": 30,
    "text": "鲁迅博采西方现代象征主义、表现主义与中国古典白描、史传笔法，",
    "start": 188.68,
    "end": 194.28,
    "duration": 5.6
  },
  {
    "id": 31,
    "text": "展现了高度开放的文体创造力。",
    "start": 194.65,
    "end": 197.05,
    "duration": 2.4
  },
  {
    "id": 32,
    "text": "《狂人日记》巧妙设置文言小序与白话正文的双重视角，构筑起反思传统文明的复调反讽隐喻；",
    "start": 197.57,
    "end": 205.73,
    "duration": 8.16
  },
  {
    "id": 33,
    "text": "《孔乙己》以十二岁小伙计的有限视点叙事，形成童稚视角与世态炎凉之间的冷峻张力；",
    "start": 206.25,
    "end": 213.77,
    "duration": 7.52
  },
  {
    "id": 34,
    "text": "《阿Q正传》戏仿传统“正史正传”体制，",
    "start": 214.29,
    "end": 217.267,
    "duration": 2.977
  },
  {
    "id": 35,
    "text": "以游戏笔调打破封建史传只为帝王将相立传的森严秩序。",
    "start": 217.637,
    "end": 222.722,
    "duration": 5.085
  },
  {
    "id": 36,
    "text": "散文诗笔调、象征隐喻与辛辣反讽浑然一体，拓展了现代小说的审美疆界。",
    "start": 223.222,
    "end": 229.42,
    "duration": 6.198
  },
  {
    "id": 37,
    "text": "总而言之，鲁迅立现代小说之体、拓现代小说之深、创现代叙事之型、铸现代文学之魂。",
    "start": 229.94,
    "end": 238.02,
    "duration": 8.08
  },
  {
    "id": 38,
    "text": "他以卓越的艺术探索，使中国现代小说在起步之时便告别了古典陈规，",
    "start": 238.54,
    "end": 244.38,
    "duration": 5.84
  },
  {
    "id": 39,
    "text": "确立了足以照耀后世的经典坐标。",
    "start": 244.78,
    "end": 247.34,
    "duration": 2.56
  }
]
