[
  {
    "id": 1,
    "text": "二十世纪二十年代末至三十年代初风靡文坛的“革命加恋爱”小说，",
    "start": 0.08,
    "end": 5.44,
    "duration": 5.36
  },
  {
    "id": 2,
    "text": "是中国现代文学在政治大动荡背景下产生的独特文体范式。",
    "start": 5.44,
    "end": 10.08,
    "duration": 4.64
  },
  {
    "id": 3,
    "text": "一九二七年大革命遭遇惨痛失败，大量处于苦闷彷徨中的小资产阶级知识分子急迫寻求精神出路。",
    "start": 10.08,
    "end": 18.08,
    "duration": 8.0
  },
  {
    "id": 4,
    "text": "创造社与太阳社等左翼作家群体，试图以通俗动人的情感叙事普及阶级革命观念。",
    "start": 18.08,
    "end": 24.24,
    "duration": 6.16
  },
  {
    "id": 5,
    "text": "政治意识形态的宏大诉求，与五四个性解放的个体情欲在此交织化合。",
    "start": 24.48,
    "end": 30.64,
    "duration": 6.16
  },
  {
    "id": 6,
    "text": "该小说模式构成了中国现代文学史上极具代表性的历史现象。",
    "start": 30.64,
    "end": 35.6,
    "duration": 4.96
  },
  {
    "id": 7,
    "text": "其发生机制、思想特征与艺术局限主要体现在四个深层维度。",
    "start": 35.6,
    "end": 40.88,
    "duration": 5.28
  },
  {
    "id": 8,
    "text": "第一，时代危机促发与知识分子心理转型的发生动力。",
    "start": 40.88,
    "end": 45.04,
    "duration": 4.16
  },
  {
    "id": 9,
    "text": "一九二七年大革命的急转直下，导致五四启蒙主义神话彻底破灭。",
    "start": 45.36,
    "end": 50.64,
    "duration": 5.28
  },
  {
    "id": 10,
    "text": "都市中的青年知识分子普遍陷入幻灭、",
    "start": 50.64,
    "end": 53.84,
    "duration": 3.2
  },
  {
    "id": 11,
    "text": "退缩与躁动的精神危机。",
    "start": 53.84,
    "end": 56.0,
    "duration": 2.16
  },
  {
    "id": 12,
    "text": "他们既渴望投身狂暴的阶级解放浪潮以洗刷小资产阶级的软弱原罪，",
    "start": 56.0,
    "end": 61.44,
    "duration": 5.44
  },
  {
    "id": 13,
    "text": "又无法彻底割舍对个人世俗情爱的眷恋。",
    "start": 61.44,
    "end": 64.48,
    "duration": 3.04
  },
  {
    "id": 14,
    "text": "恋爱成为个体生命冲动的直观隐喻，",
    "start": 64.72,
    "end": 67.6,
    "duration": 2.88
  },
  {
    "id": 15,
    "text": "而革命则成为赋予生命神圣政治依托的崇高彼岸。",
    "start": 67.6,
    "end": 72.16,
    "duration": 4.56
  },
  {
    "id": 16,
    "text": "“革命加恋爱”正是在这种弥合个人欲望与阶级归宿的深刻心理矛盾中应运而生。",
    "start": 72.16,
    "end": 79.12,
    "duration": 6.96
  },
  {
    "id": 17,
    "text": "第二，情爱欲望向阶级政治意识形态规训的依附升华。",
    "start": 79.12,
    "end": 83.68,
    "duration": 4.56
  },
  {
    "id": 18,
    "text": "这一模式在思想结构上建立了高度公式化的政治伦理。",
    "start": 83.68,
    "end": 87.52,
    "duration": 3.84
  },
  {
    "id": 19,
    "text": "革命与恋爱最初往往作为激烈的二元对抗出现，",
    "start": 87.76,
    "end": 91.6,
    "duration": 3.84
  },
  {
    "id": 20,
    "text": "但叙事最终必然走向革命对恋爱的规训与征服。",
    "start": 91.6,
    "end": 95.6,
    "duration": 4.0
  },
  {
    "id": 21,
    "text": "蒋光慈在《冲出云围的月亮》与华汉在《地泉》中，",
    "start": 95.6,
    "end": 99.76,
    "duration": 4.16
  },
  {
    "id": 22,
    "text": "将女性塑造为诱发革命热情的催化剂或必须割舍的情感羁绊。",
    "start": 99.76,
    "end": 105.04,
    "duration": 5.28
  },
  {
    "id": 23,
    "text": "主人公只有斩断私情、将狂热的力比多转化为阶级献身热情，",
    "start": 105.04,
    "end": 110.4,
    "duration": 5.36
  },
  {
    "id": 24,
    "text": "才能完成革命主体的凤凰涅盘。",
    "start": 110.4,
    "end": 112.88,
    "duration": 2.48
  },
  {
    "id": 25,
    "text": "恋爱由此蜕变为革命话语的附属装饰。",
    "start": 112.88,
    "end": 115.6,
    "duration": 2.72
  },
  {
    "id": 26,
    "text": "第三，茅盾对公式化模式的现实主义审视与艺术深化。",
    "start": 115.976,
    "end": 121.096,
    "duration": 5.12
  },
  {
    "id": 27,
    "text": "在大量粗糙的概念化作品泛滥之时，",
    "start": 121.096,
    "end": 124.216,
    "duration": 3.12
  },
  {
    "id": 28,
    "text": "茅盾展现出清醒深刻的现实主义大师风范。",
    "start": 124.216,
    "end": 128.056,
    "duration": 3.84
  },
  {
    "id": 29,
    "text": "他在《蚀》三部曲（《幻灭》《动摇》《追求》）与《创造》中，",
    "start": 128.056,
    "end": 131.896,
    "duration": 3.84
  },
  {
    "id": 30,
    "text": "彻底打破了廉价狂热的公式套路。",
    "start": 131.896,
    "end": 134.216,
    "duration": 2.32
  },
  {
    "id": 31,
    "text": "茅盾逼视静女士、方罗兰等动摇者在革命狂潮中的心理波澜。",
    "start": 134.536,
    "end": 140.136,
    "duration": 5.6
  },
  {
    "id": 32,
    "text": "他没有让革命轻易吞并恋爱，而是如实记录了知识分子被时代车轮碾碎的幻灭绝望与灵魂挣扎。",
    "start": 140.136,
    "end": 148.456,
    "duration": 8.32
  },
  {
    "id": 33,
    "text": "茅盾以复杂的心理写实，极大地深化了该题材的思想厚度。",
    "start": 148.456,
    "end": 153.256,
    "duration": 4.8
  },
  {
    "id": 34,
    "text": "第四，概念先行导致的模式化泛滥与艺术局限。",
    "start": 153.256,
    "end": 157.416,
    "duration": 4.16
  },
  {
    "id": 35,
    "text": "尽管这一模式极大地推动了左翼文学的通俗传播，",
    "start": 157.656,
    "end": 161.736,
    "duration": 4.08
  },
  {
    "id": 36,
    "text": "但其自身孕育着严重的艺术先天不足。",
    "start": 161.736,
    "end": 165.256,
    "duration": 3.52
  },
  {
    "id": 37,
    "text": "多数作家受到急功近利宣传心态的驱使，",
    "start": 165.256,
    "end": 168.616,
    "duration": 3.36
  },
  {
    "id": 38,
    "text": "陷入概念化与公式化的泥闹。",
    "start": 168.616,
    "end": 171.256,
    "duration": 2.64
  },
  {
    "id": 39,
    "text": "人物形象高度脸谱化，情节沦为“政治口号加浪漫奇遇”的生硬拼贴。",
    "start": 171.256,
    "end": 176.936,
    "duration": 5.68
  },
  {
    "id": 40,
    "text": "革命过程被高度理想化与传奇化，而恋爱心理则滑向低俗感伤与矫揉造作。",
    "start": 177.176,
    "end": 183.416,
    "duration": 6.24
  },
  {
    "id": 41,
    "text": "它割裂了现实生活的丰富血肉，使文学沦为了政治教条的传声筒。",
    "start": 183.416,
    "end": 188.536,
    "duration": 5.12
  },
  {
    "id": 42,
    "text": "“革命加恋爱”小说模式是特定历史语境下革命意识形态与通俗市民叙事结合的文体产物。",
    "start": 188.536,
    "end": 195.496,
    "duration": 6.96
  },
  {
    "id": 43,
    "text": "它虽然存在明显的艺术缺陷，却深刻折射出中国现代知识分子在历史大裂变中的精神阵痛。",
    "start": 195.736,
    "end": 203.256,
    "duration": 7.52
  },
  {
    "id": 44,
    "text": "它为理解中国当代革命文学规范的形成，",
    "start": 203.256,
    "end": 206.216,
    "duration": 2.96
  },
  {
    "id": 45,
    "text": "提供了不可替代的文体发生学样本。",
    "start": 206.216,
    "end": 208.616,
    "duration": 2.4
  }
]