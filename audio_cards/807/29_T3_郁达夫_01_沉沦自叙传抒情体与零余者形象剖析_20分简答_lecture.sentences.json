[
  {
    "id": 1,
    "text": "简析郁达夫《沉沦》的“自叙传”抒情体制与“零余者”人物形象。",
    "start": 0.114,
    "end": 4.938,
    "duration": 4.824
  },
  {
    "id": 2,
    "text": "作为五四前期创造社的核心小说家，",
    "start": 5.235,
    "end": 7.931,
    "duration": 2.696
  },
  {
    "id": 3,
    "text": "郁达夫凭短篇小说集《沉沦》打破传统叙事重外部情节的定势，",
    "start": 8.29,
    "end": 13.759,
    "duration": 5.469
  },
  {
    "id": 4,
    "text": "开创了现代“自叙传”抒情小说流派，深刻抒写出五四退潮期青年知识分子的心灵苦闷。",
    "start": 14.053,
    "end": 21.246,
    "duration": 7.193
  },
  {
    "id": 5,
    "text": "第一，首创直抒胸臆的“自叙传”主情小说体制，拓宽现代短篇结构边界。",
    "start": 21.933,
    "end": 28.339,
    "duration": 6.406
  },
  {
    "id": 6,
    "text": "郁达夫吸收欧洲浪漫主义及日本“私小说”创作经验，",
    "start": 28.756,
    "end": 32.546,
    "duration": 3.79
  },
  {
    "id": 7,
    "text": "主张一切文学作品皆是作家的“自叙传”。",
    "start": 33.002,
    "end": 35.83,
    "duration": 2.828
  },
  {
    "id": 8,
    "text": "《沉沦》弱化戏剧性外部波折，以留日学生“他”的精神抑郁为主脉，",
    "start": 36.18,
    "end": 41.05,
    "duration": 4.87
  },
  {
    "id": 9,
    "text": "频繁穿插日记自白、自然景物烘托与坦率心理独白，",
    "start": 41.397,
    "end": 45.801,
    "duration": 4.404
  },
  {
    "id": 10,
    "text": "形成信笔直书、以情绪起伏串联全篇的情感型结构，",
    "start": 46.1,
    "end": 50.645,
    "duration": 4.545
  },
  {
    "id": 11,
    "text": "打破传统伦理避讳，掀起震动一时的个性解放风潮。",
    "start": 51.179,
    "end": 55.372,
    "duration": 4.193
  },
  {
    "id": 12,
    "text": "第二，刻画深受社会挤压却不愿同流合污的“零余者”抒情主人公群像。",
    "start": 56.003,
    "end": 61.531,
    "duration": 5.528
  },
  {
    "id": 13,
    "text": "郁达夫笔下的主人公大多是身处异乡或穷困都市、有志难申的苦闷青年。",
    "start": 61.845,
    "end": 67.471,
    "duration": 5.626
  },
  {
    "id": 14,
    "text": "《沉沦》中的留日学生既感青春期灵肉需求遭到世俗压抑，",
    "start": 67.829,
    "end": 72.484,
    "duration": 4.655
  },
  {
    "id": 15,
    "text": "又时时承受“中国留学生”屈辱所激发的爱国痛感，",
    "start": 72.484,
    "end": 76.156,
    "duration": 3.672
  },
  {
    "id": 16,
    "text": "在孤立无援与自我嫌恶中投海自尽，临终疾呼“祖国呀，祖国！我的死是你害我的！”，",
    "start": 76.485,
    "end": 85.404,
    "duration": 8.919
  },
  {
    "id": 17,
    "text": "将个体变态抑郁与弱国国民尊严紧扣在一起，成为五四一代知识青年精神失落的真实写照。",
    "start": 85.51,
    "end": 91.456,
    "duration": 5.946
  },
  {
    "id": 18,
    "text": "第三，呈现率真坦诚的“感伤病态美”，滋养现代表现自我小说传统。",
    "start": 92.048,
    "end": 97.769,
    "duration": 5.721
  },
  {
    "id": 19,
    "text": "郁达夫以毫不遮掩的自我解剖直面现代人性欲、贫病与忧愤，",
    "start": 98.177,
    "end": 102.828,
    "duration": 4.651
  },
  {
    "id": 20,
    "text": "在《春风沉醉的晚上》中让都市亭子间文人与女工陈二妹“同是天涯沦落人”般彼此照拂，",
    "start": 103.382,
    "end": 110.426,
    "duration": 7.044
  },
  {
    "id": 21,
    "text": "赋“倡优士子”古典悲悯以现代平民色泽；",
    "start": 110.7,
    "end": 114.303,
    "duration": 3.603
  },
  {
    "id": 22,
    "text": "至后期《迟桂花》则逐步淡化颓废自伤，转向宁静和谐的人性净化，",
    "start": 114.46,
    "end": 119.533,
    "duration": 5.073
  },
  {
    "id": 23,
    "text": "直接滋养了废名、庐隐等主观抒情小说的发展。",
    "start": 119.686,
    "end": 123.135,
    "duration": 3.449
  }
]