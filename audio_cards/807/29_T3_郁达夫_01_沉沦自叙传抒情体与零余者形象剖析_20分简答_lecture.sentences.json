[
  {
    "id": 1,
    "text": "简析郁达夫《沉沦》的“自叙传”抒情体制与“零余者”人物形象。",
    "start": 0.114,
    "end": 4.938,
    "duration": 4.824
  },
  {
    "id": 2,
    "text": "作为五四前期创造社的核心小说家，",
    "start": 5.438,
    "end": 8.134,
    "duration": 2.696
  },
  {
    "id": 3,
    "text": "郁达夫凭短篇小说集《沉沦》打破传统叙事重外部情节的定势，",
    "start": 8.493,
    "end": 13.962,
    "duration": 5.469
  },
  {
    "id": 4,
    "text": "开创了现代“自叙传”抒情小说流派，深刻抒写出五四退潮期青年知识分子的心灵苦闷。",
    "start": 14.312,
    "end": 21.505,
    "duration": 7.193
  },
  {
    "id": 5,
    "text": "第一，首创直抒胸臆的“自叙传”主情小说体制，拓宽现代短篇结构边界。",
    "start": 22.192,
    "end": 28.598,
    "duration": 6.406
  },
  {
    "id": 6,
    "text": "郁达夫吸收欧洲浪漫主义及日本“私小说”创作经验，",
    "start": 29.098,
    "end": 32.888,
    "duration": 3.79
  },
  {
    "id": 7,
    "text": "主张一切文学作品皆是作家的“自叙传”。",
    "start": 33.344,
    "end": 36.172,
    "duration": 2.828
  },
  {
    "id": 8,
    "text": "《沉沦》弱化戏剧性外部波折，以留日学生“他”的精神抑郁为主脉，",
    "start": 36.672,
    "end": 41.542,
    "duration": 4.87
  },
  {
    "id": 9,
    "text": "频繁穿插日记自白、自然景物烘托与坦率心理独白，",
    "start": 41.892,
    "end": 46.296,
    "duration": 4.404
  },
  {
    "id": 10,
    "text": "形成信笔直书、以情绪起伏串联全篇的情感型结构，",
    "start": 46.646,
    "end": 51.191,
    "duration": 4.545
  },
  {
    "id": 11,
    "text": "打破传统伦理避讳，掀起震动一时的个性解放风潮。",
    "start": 51.725,
    "end": 55.918,
    "duration": 4.193
  },
  {
    "id": 12,
    "text": "第二，刻画深受社会挤压却不愿同流合污的“零余者”抒情主人公群像。",
    "start": 56.549,
    "end": 62.077,
    "duration": 5.528
  },
  {
    "id": 13,
    "text": "郁达夫笔下的主人公大多是身处异乡或穷困都市、有志难申的苦闷青年。",
    "start": 62.577,
    "end": 68.178,
    "duration": 5.601
  },
  {
    "id": 14,
    "text": "《沉沦》中的留日学生既感青春期灵肉需求遭到世俗压抑，又时时承受“中国留学生”屈辱所激发的爱国痛感，",
    "start": 68.678,
    "end": 77.005,
    "duration": 8.327
  },
  {
    "id": 15,
    "text": "在孤立无援与自我嫌恶中投海自尽，临终疾呼“祖国呀，祖国！我的死是你害我的！”，",
    "start": 77.355,
    "end": 86.278,
    "duration": 8.923
  },
  {
    "id": 16,
    "text": "将个体变态抑郁与弱国国民尊严紧扣在一起，成为五四一代知识青年精神失落的真实写照。",
    "start": 86.628,
    "end": 92.593,
    "duration": 5.965
  },
  {
    "id": 17,
    "text": "第三，呈现率真坦诚的“感伤病态美”，滋养现代表现自我小说传统。",
    "start": 93.185,
    "end": 98.906,
    "duration": 5.721
  },
  {
    "id": 18,
    "text": "郁达夫以毫不遮掩的自我解剖直面现代人性欲、贫病与忧愤，",
    "start": 99.406,
    "end": 104.057,
    "duration": 4.651
  },
  {
    "id": 19,
    "text": "在《春风沉醉的晚上》中让都市亭子间文人与女工陈二妹“同是天涯沦落人”般彼此照拂，",
    "start": 104.611,
    "end": 111.655,
    "duration": 7.044
  },
  {
    "id": 20,
    "text": "赋“倡优士子”古典悲悯以现代平民色泽；",
    "start": 112.005,
    "end": 115.608,
    "duration": 3.603
  },
  {
    "id": 21,
    "text": "而早期《沉沦》《春风沉醉的晚上》等名篇开启的感伤抒情传统，",
    "start": 116.108,
    "end": 121.205,
    "duration": 5.097
  },
  {
    "id": 22,
    "text": "至后期《迟桂花》则逐步转向宁静和谐的人性净化，",
    "start": 121.555,
    "end": 125.951,
    "duration": 4.396
  },
  {
    "id": 23,
    "text": "在现代文坛深远影响了废名、庐隐等主观抒情小说的发展。",
    "start": 126.301,
    "end": 131.394,
    "duration": 5.093
  }
]
