[
  {
    "id": 1,
    "text": "简析郁达夫《沉沦》的“自叙传”抒情体制与“零余者”人物形象。",
    "start": 0.114,
    "end": 4.929,
    "duration": 4.815
  },
  {
    "id": 2,
    "text": "作为五四前期创造社的核心小说家，",
    "start": 5.235,
    "end": 7.921,
    "duration": 2.686
  },
  {
    "id": 3,
    "text": "郁达夫凭短篇小说集《沉沦》打破传统叙事重外部情节的定势，",
    "start": 8.29,
    "end": 13.749,
    "duration": 5.459
  },
  {
    "id": 4,
    "text": "开创了现代“自叙传”抒情小说流派，",
    "start": 14.053,
    "end": 16.729,
    "duration": 2.676
  },
  {
    "id": 5,
    "text": "深刻抒写出五四退潮期青年知识分子的心灵苦闷。",
    "start": 17.169,
    "end": 21.236,
    "duration": 4.067
  },
  {
    "id": 6,
    "text": "第一，首创直抒胸臆的“自叙传”主情小说体制，",
    "start": 21.933,
    "end": 26.04,
    "duration": 4.107
  },
  {
    "id": 7,
    "text": "拓宽现代短篇结构边界。",
    "start": 26.492,
    "end": 28.329,
    "duration": 1.837
  },
  {
    "id": 8,
    "text": "郁达夫吸收欧洲浪漫主义及日本“私小说”创作经验，",
    "start": 28.756,
    "end": 32.536,
    "duration": 3.78
  },
  {
    "id": 9,
    "text": "主张一切文学作品皆是作家的“自叙传”。",
    "start": 33.002,
    "end": 35.82,
    "duration": 2.818
  },
  {
    "id": 10,
    "text": "《沉沦》弱化戏剧性外部波折，",
    "start": 36.18,
    "end": 38.274,
    "duration": 2.094
  },
  {
    "id": 11,
    "text": "以留日学生“他”的精神抑郁为主脉，频繁穿插日记自白、",
    "start": 38.736,
    "end": 42.908,
    "duration": 4.172
  },
  {
    "id": 12,
    "text": "自然景物烘托与坦率心理独白，形成信笔直书、",
    "start": 43.143,
    "end": 47.41,
    "duration": 4.267
  },
  {
    "id": 13,
    "text": "以情绪起伏串联全篇的情感型结构，打破传统伦理避讳，",
    "start": 47.863,
    "end": 52.601,
    "duration": 4.738
  },
  {
    "id": 14,
    "text": "掀起震动一时的个性解放风潮。",
    "start": 53.003,
    "end": 55.363,
    "duration": 2.36
  },
  {
    "id": 15,
    "text": "第二，",
    "start": 56.003,
    "end": 56.353,
    "duration": 0.35
  },
  {
    "id": 16,
    "text": "刻画深受社会挤压却不愿同流合污的“零余者”抒情主人公群像。",
    "start": 56.608,
    "end": 61.521,
    "duration": 4.913
  },
  {
    "id": 17,
    "text": "郁达夫笔下的主人公大多是身处异乡或穷困都市、",
    "start": 61.845,
    "end": 65.629,
    "duration": 3.784
  },
  {
    "id": 18,
    "text": "有志难申的苦闷青年。",
    "start": 66.038,
    "end": 67.461,
    "duration": 1.423
  },
  {
    "id": 19,
    "text": "《沉沦》中的留日学生既感青春期灵肉需求遭到世俗压抑，",
    "start": 67.829,
    "end": 72.183,
    "duration": 4.354
  },
  {
    "id": 20,
    "text": "又时时承受“中国留学生”屈辱所激发的爱国痛感，",
    "start": 72.484,
    "end": 76.146,
    "duration": 3.662
  },
  {
    "id": 21,
    "text": "在孤立无援与自我嫌恶中投海自尽，临终疾呼“祖国呀，祖国！",
    "start": 76.485,
    "end": 82.049,
    "duration": 5.564
  },
  {
    "id": 22,
    "text": "我的死是你害我的！",
    "start": 82.308,
    "end": 83.921,
    "duration": 1.613
  },
  {
    "id": 23,
    "text": "”，将个体变态抑郁与弱国国民尊严紧扣在一起，",
    "start": 84.172,
    "end": 87.673,
    "duration": 3.501
  },
  {
    "id": 24,
    "text": "成为五四一代知识青年精神失落的真实写照。",
    "start": 87.941,
    "end": 91.446,
    "duration": 3.505
  },
  {
    "id": 25,
    "text": "第三，呈现率真坦诚的“感伤病态美”，",
    "start": 92.048,
    "end": 95.373,
    "duration": 3.325
  },
  {
    "id": 26,
    "text": "滋养现代表现自我小说传统。",
    "start": 95.628,
    "end": 97.767,
    "duration": 2.139
  },
  {
    "id": 27,
    "text": "郁达夫以毫不遮掩的自我解剖直面现代人性欲、贫病与忧愤，",
    "start": 98.177,
    "end": 102.818,
    "duration": 4.641
  },
  {
    "id": 28,
    "text": "在《春风沉醉的晚上》中让都市亭子间文人与女工陈二妹“同是天涯沦落人”般彼此照拂，",
    "start": 103.382,
    "end": 110.416,
    "duration": 7.034
  },
  {
    "id": 29,
    "text": "赋“倡优士子”古典悲悯以现代平民色泽；",
    "start": 110.7,
    "end": 114.293,
    "duration": 3.593
  },
  {
    "id": 30,
    "text": "至后期《迟桂花》则逐步淡化颓废自伤，",
    "start": 114.46,
    "end": 117.435,
    "duration": 2.975
  },
  {
    "id": 31,
    "text": "转向宁静和谐的人性净化，直接滋养了废名、",
    "start": 117.543,
    "end": 120.912,
    "duration": 3.369
  },
  {
    "id": 32,
    "text": "庐隐等主观抒情小说的发展。",
    "start": 121.049,
    "end": 123.135,
    "duration": 2.086
  }
]