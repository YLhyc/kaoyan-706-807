[
  {
    "id": 1,
    "text": "八十年代中期，",
    "start": 0.113,
    "end": 1.122,
    "duration": 1.009
  },
  {
    "id": 2,
    "text": "面对反思文学的局限与西方现代主义思潮的冲击，",
    "start": 1.46,
    "end": 5.284,
    "duration": 3.824
  },
  {
    "id": 3,
    "text": "中国当代文坛兴起了以“寻根”为旗帜的文学思潮。",
    "start": 5.782,
    "end": 9.705,
    "duration": 3.923
  },
  {
    "id": 4,
    "text": "作家们主张跳出单一的政治社会学批评框架，",
    "start": 10.325,
    "end": 13.759,
    "duration": 3.434
  },
  {
    "id": 5,
    "text": "向民族历史文化心理探求精神资源，",
    "start": 13.994,
    "end": 17.151,
    "duration": 3.157
  },
  {
    "id": 6,
    "text": "其思潮特征与审美追求主要体现于以下三个方面：",
    "start": 17.494,
    "end": 21.534,
    "duration": 4.04
  },
  {
    "id": 7,
    "text": "第一，发表理论宣言，确立向民族传统文化“寻根”的创作自觉。",
    "start": 22.172,
    "end": 27.032,
    "duration": 4.86
  },
  {
    "id": 8,
    "text": "韩少功发表《文学的“根”》，明确提出“文学有根，",
    "start": 27.261,
    "end": 30.782,
    "duration": 3.521
  },
  {
    "id": 9,
    "text": "文学之根应深植于民族传统文化的土壤里”，",
    "start": 31.028,
    "end": 34.179,
    "duration": 3.151
  },
  {
    "id": 10,
    "text": "呼唤作家从楚辞的浪漫奇诡、",
    "start": 34.45,
    "end": 36.858,
    "duration": 2.408
  },
  {
    "id": 11,
    "text": "道家的清虚自守与地域原生民俗中汲取养分，",
    "start": 37.044,
    "end": 40.722,
    "duration": 3.678
  },
  {
    "id": 12,
    "text": "推动当代文学由外部社会批判转向内在民族文化心理的开掘。",
    "start": 40.983,
    "end": 46.215,
    "duration": 5.232
  },
  {
    "id": 13,
    "text": "第二，发掘传统儒道人格精神，重建文化自尊与理想品格。",
    "start": 46.876,
    "end": 51.89,
    "duration": 5.014
  },
  {
    "id": 14,
    "text": "寻根作家力图在现代转型带来的精神迷失中，",
    "start": 52.109,
    "end": 55.477,
    "duration": 3.368
  },
  {
    "id": 15,
    "text": "重拾传统文化的美好品格。",
    "start": 55.755,
    "end": 57.772,
    "duration": 2.017
  },
  {
    "id": 16,
    "text": "阿城在《棋王》中以古朴洗练的笔调塑造了“棋呆子”王一生；",
    "start": 58.155,
    "end": 62.719,
    "duration": 4.564
  },
  {
    "id": 17,
    "text": "他在动荡的知青岁月中将“吃饱”视作踏实的生存底线，",
    "start": 63.122,
    "end": 67.341,
    "duration": 4.219
  },
  {
    "id": 18,
    "text": "在车轮大战中以一敌九下盲棋，连胜八人后与老棋手言和，",
    "start": 67.608,
    "end": 72.648,
    "duration": 5.04
  },
  {
    "id": 19,
    "text": "其淡泊自守、超然自尊的人格境界，",
    "start": 73.018,
    "end": 75.674,
    "duration": 2.656
  },
  {
    "id": 20,
    "text": "体现出传统道家文化在当代生活中的精神延续。",
    "start": 75.969,
    "end": 79.92,
    "duration": 3.951
  },
  {
    "id": 21,
    "text": "第三，融合现代主义象征与地域民俗风情，",
    "start": 80.54,
    "end": 84.139,
    "duration": 3.599
  },
  {
    "id": 22,
    "text": "拓展当代小说的文体边界。",
    "start": 84.538,
    "end": 86.532,
    "duration": 1.994
  },
  {
    "id": 23,
    "text": "寻根文学告别了传统现实主义的单线叙事，",
    "start": 86.841,
    "end": 89.891,
    "duration": 3.05
  },
  {
    "id": 24,
    "text": "吸收拉美魔幻现实主义与现代象征手法，",
    "start": 90.163,
    "end": 93.399,
    "duration": 3.236
  },
  {
    "id": 25,
    "text": "呈现鲜明的地域文化风貌。",
    "start": 93.666,
    "end": 95.56,
    "duration": 1.894
  },
  {
    "id": 26,
    "text": "李杭育的“葛川江系列”展现吴越水乡的野性生命力，",
    "start": 95.881,
    "end": 100.064,
    "duration": 4.183
  },
  {
    "id": 27,
    "text": "贾平凹的“商州系列”勾勒秦岭山地的古老风俗人情，",
    "start": 100.38,
    "end": 104.448,
    "duration": 4.068
  },
  {
    "id": 28,
    "text": "莫言早期作品亦借齐鲁乡土传奇彰显生命活力，在传统与现代、",
    "start": 104.669,
    "end": 110.394,
    "duration": 5.725
  },
  {
    "id": 29,
    "text": "神话与写实的交融中拓宽了当代小说的艺术表现力。",
    "start": 110.573,
    "end": 114.696,
    "duration": 4.123
  }
]