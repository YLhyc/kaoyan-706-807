[
  {
    "id": 1,
    "text": "八十年代中期，面对反思文学的局限与西方现代主义思潮的冲击，中国当代文坛兴起了以“寻根”为旗帜的文学思潮。",
    "start": 0.134,
    "end": 9.106,
    "duration": 8.972
  },
  {
    "id": 2,
    "text": "作家们主张跳出单一的政治社会学批评框架，向民族历史文化心理探求精神资源，",
    "start": 9.73,
    "end": 11.502,
    "duration": 1.772
  },
  {
    "id": 3,
    "text": "其思潮特征与审美追求主要体现于以下三个方面：",
    "start": 11.881,
    "end": 13.373,
    "duration": 1.492
  },
  {
    "id": 4,
    "text": "第一，发表理论宣言，确立向民族传统文化“寻根”的创作自觉。",
    "start": 14.051,
    "end": 25.543,
    "duration": 11.492
  },
  {
    "id": 5,
    "text": "韩少功发表《文学的“根”》，明确提出“文学有根，文学之根应深植于民族传统文化的土壤里”，",
    "start": 26.261,
    "end": 33.233,
    "duration": 6.972
  },
  {
    "id": 6,
    "text": "呼唤作家从楚辞的浪漫奇诡、道家的清虚自守与地域原生民俗中汲取养分，",
    "start": 33.612,
    "end": 40.264,
    "duration": 6.652
  },
  {
    "id": 7,
    "text": "推动当代文学由外部社会批判转向内在民族文化心理的开掘。",
    "start": 40.786,
    "end": 45.478,
    "duration": 4.692
  },
  {
    "id": 8,
    "text": "第二，发掘传统儒道人格精神，重建文化自尊与理想品格。",
    "start": 46.202,
    "end": 51.094,
    "duration": 4.892
  },
  {
    "id": 9,
    "text": "寻根作家力图在现代转型带来的精神迷失中，重拾传统文化的美好品格。",
    "start": 51.812,
    "end": 57.424,
    "duration": 5.612
  },
  {
    "id": 10,
    "text": "阿城在《棋王》中以古朴洗练的笔调塑造了“棋呆子”王一生；",
    "start": 58.142,
    "end": 62.474,
    "duration": 4.332
  },
  {
    "id": 11,
    "text": "他在动荡的知青岁月中将“吃饱”视作踏实的生存底线，",
    "start": 63.192,
    "end": 67.724,
    "duration": 4.532
  },
  {
    "id": 12,
    "text": "在车轮大战中以一敌九下盲棋，连胜八人后与老棋手言和，",
    "start": 68.103,
    "end": 72.665,
    "duration": 4.562
  },
  {
    "id": 13,
    "text": "其淡泊自守、超然自尊的人格境界，体现出传统道家文化在当代生活中的精神延续。",
    "start": 73.217,
    "end": 79.469,
    "duration": 6.252
  },
  {
    "id": 14,
    "text": "第三，融合现代主义象征与地域民俗风情，拓展当代小说的文体边界。",
    "start": 80.163,
    "end": 85.935,
    "duration": 5.772
  },
  {
    "id": 15,
    "text": "寻根文学告别了传统现实主义的单线叙事，",
    "start": 86.573,
    "end": 89.905,
    "duration": 3.332
  },
  {
    "id": 16,
    "text": "吸收拉美魔幻现实主义与现代象征手法，呈现鲜明的地域文化风貌。",
    "start": 90.284,
    "end": 95.696,
    "duration": 5.412
  },
  {
    "id": 17,
    "text": "李杭育的“葛川江系列”展现吴越水乡的野性生命力，",
    "start": 96.374,
    "end": 100.186,
    "duration": 3.812
  },
  {
    "id": 18,
    "text": "贾平凹的“商州系列”勾勒秦岭山地的古老风俗人情，",
    "start": 100.565,
    "end": 104.737,
    "duration": 4.172
  },
  {
    "id": 19,
    "text": "莫言早期作品亦借齐鲁乡土传奇彰显生命活力，",
    "start": 105.287,
    "end": 110.339,
    "duration": 5.052
  },
  {
    "id": 20,
    "text": "在传统与现代、神话与写实的交融中拓宽了当代小说的艺术表现力。",
    "start": 110.718,
    "end": 114.61,
    "duration": 3.892
  }
]