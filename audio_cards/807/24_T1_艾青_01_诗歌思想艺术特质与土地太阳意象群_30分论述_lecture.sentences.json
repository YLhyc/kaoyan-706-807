[
  {
    "id": 1,
    "text": "三十年代民族危亡与全民族抗战时期，",
    "start": 0.11,
    "end": 3.342,
    "duration": 3.232
  },
  {
    "id": 2,
    "text": "艾青以《大堰河——我的保姆》《北方》与《我爱这土地》等代表作，",
    "start": 3.661,
    "end": 8.147,
    "duration": 4.486
  },
  {
    "id": 3,
    "text": "在中国现代新诗史上开辟了现实主义与时代精神交融的新境。",
    "start": 8.595,
    "end": 13.556,
    "duration": 4.961
  },
  {
    "id": 4,
    "text": "作为继郭沫若之后极具时代感召力的现代诗人，",
    "start": 13.806,
    "end": 17.277,
    "duration": 3.471
  },
  {
    "id": 5,
    "text": "艾青打破了前期新诗脱离泥土与民众的文人雅趣，",
    "start": 17.656,
    "end": 21.77,
    "duration": 4.114
  },
  {
    "id": 6,
    "text": "将深沉忧郁的情思与民族抗争激情融为一体。",
    "start": 22.036,
    "end": 26.097,
    "duration": 4.061
  },
  {
    "id": 7,
    "text": "其诗歌的思想意蕴、意象体系与艺术革新，",
    "start": 26.705,
    "end": 30.28,
    "duration": 3.575
  },
  {
    "id": 8,
    "text": "主要体现于以下三个维度：",
    "start": 30.535,
    "end": 32.3,
    "duration": 1.765
  },
  {
    "id": 9,
    "text": "第一，以“土地”与“大堰河”为精神底色，",
    "start": 32.975,
    "end": 35.991,
    "duration": 3.016
  },
  {
    "id": 10,
    "text": "倾注对劳苦大众的挚爱。",
    "start": 36.35,
    "end": 38.05,
    "duration": 1.7
  },
  {
    "id": 11,
    "text": "艾青诗歌的生命根基深植于苦难的中国大地。",
    "start": 38.679,
    "end": 42.228,
    "duration": 3.549
  },
  {
    "id": 12,
    "text": "在成名作《大堰河——我的保姆》中，",
    "start": 42.894,
    "end": 44.919,
    "duration": 2.025
  },
  {
    "id": 13,
    "text": "诗人以地主家庭叛逆之子的赤诚，",
    "start": 45.329,
    "end": 47.991,
    "duration": 2.662
  },
  {
    "id": 14,
    "text": "追忆这位“她的名字就是生她的村庄的名字”、",
    "start": 48.098,
    "end": 51.427,
    "duration": 3.329
  },
  {
    "id": 15,
    "text": "用乳汁养育自己的贫苦农妇；",
    "start": 51.711,
    "end": 53.992,
    "duration": 2.281
  },
  {
    "id": 16,
    "text": "诗篇通过她流尽乳汁后终日洗衣切菜、",
    "start": 54.299,
    "end": 57.824,
    "duration": 3.525
  },
  {
    "id": 17,
    "text": "年节里忙着为孩子制作甜食年糕、",
    "start": 58.205,
    "end": 60.881,
    "duration": 2.676
  },
  {
    "id": 18,
    "text": "直至死后仅以几块白色的木板与几束枯草草草安葬的凄苦生平，",
    "start": 61.214,
    "end": 66.863,
    "duration": 5.649
  },
  {
    "id": 19,
    "text": "真切刻画出中国劳动妇女忍辱负重、深沉慈爱的母亲形象。",
    "start": 67.052,
    "end": 72.326,
    "duration": 5.274
  },
  {
    "id": 20,
    "text": "这种依恋在抗战烽火中升华为集体忧患母题：",
    "start": 72.587,
    "end": 76.107,
    "duration": 3.52
  },
  {
    "id": 21,
    "text": "在《雪落在中国的土地上》中，他叹息“雪落在中国的土地上，",
    "start": 76.571,
    "end": 81.297,
    "duration": 4.726
  },
  {
    "id": 22,
    "text": "寒冷在封锁着中国呀”，写尽饥馑大地与农夫的艰辛；",
    "start": 81.641,
    "end": 86.263,
    "duration": 4.622
  },
  {
    "id": 23,
    "text": "在《我爱这土地》中，诗人化作喉咙嘶哑的飞鸟，",
    "start": 86.431,
    "end": 90.108,
    "duration": 3.677
  },
  {
    "id": 24,
    "text": "以“为什么我的眼里常含泪水？",
    "start": 90.461,
    "end": 92.681,
    "duration": 2.22
  },
  {
    "id": 25,
    "text": "因为我对这土地爱得深沉”的名句，",
    "start": 92.987,
    "end": 95.468,
    "duration": 2.481
  },
  {
    "id": 26,
    "text": "将对苦难祖国的生死挚爱化作振奋民族的精神力量。",
    "start": 95.74,
    "end": 100.322,
    "duration": 4.582
  },
  {
    "id": 27,
    "text": "第二，以“太阳”与“火把”为光明象征，",
    "start": 100.946,
    "end": 103.973,
    "duration": 3.027
  },
  {
    "id": 28,
    "text": "高扬民族救亡与民主理想。",
    "start": 104.414,
    "end": 106.588,
    "duration": 2.174
  },
  {
    "id": 29,
    "text": "与沉郁凝重的土地意象相对照，",
    "start": 107.168,
    "end": 109.362,
    "duration": 2.194
  },
  {
    "id": 30,
    "text": "艾青诗作中奔涌着炽烈灼热的光明向往。",
    "start": 109.707,
    "end": 113.007,
    "duration": 3.3
  },
  {
    "id": 31,
    "text": "在《向太阳》与《火把》等代表性长诗中，",
    "start": 113.451,
    "end": 116.067,
    "duration": 2.616
  },
  {
    "id": 32,
    "text": "“太阳”不再是古典诗歌里孤立的自然景物，",
    "start": 116.412,
    "end": 119.285,
    "duration": 2.873
  },
  {
    "id": 33,
    "text": "而被赋予驱散幽暗历史、",
    "start": 119.6,
    "end": 121.576,
    "duration": 1.976
  },
  {
    "id": 34,
    "text": "冲破封建枷锁与迎接民族新生的时代意蕴。",
    "start": 122.117,
    "end": 125.843,
    "duration": 3.726
  },
  {
    "id": 35,
    "text": "诗人以饱满激越的浪漫情怀，",
    "start": 126.354,
    "end": 128.651,
    "duration": 2.297
  },
  {
    "id": 36,
    "text": "呼唤风雪硝烟中受压迫的四万万同胞挺起脊梁；",
    "start": 129.019,
    "end": 133.252,
    "duration": 4.233
  },
  {
    "id": 37,
    "text": "抒情主人公迎着烈日奔跑、甘愿赴汤蹈火的献身意志，",
    "start": 133.689,
    "end": 138.256,
    "duration": 4.567
  },
  {
    "id": 38,
    "text": "展现出抗战时期知识分子探求民族出路、走向人民的时代觉醒；",
    "start": 138.603,
    "end": 143.878,
    "duration": 5.275
  },
  {
    "id": 39,
    "text": "及至延安时期的《黎明的通知》，",
    "start": 144.156,
    "end": 146.543,
    "duration": 2.387
  },
  {
    "id": 40,
    "text": "光明意象更化为迎接新世界到来的明朗呼告。",
    "start": 146.908,
    "end": 150.963,
    "duration": 4.055
  },
  {
    "id": 41,
    "text": "第三，打破格律与欧化束缚，",
    "start": 151.568,
    "end": 153.987,
    "duration": 2.419
  },
  {
    "id": 42,
    "text": "创立兼具散文美与内在韵律的自由诗体。",
    "start": 154.331,
    "end": 157.651,
    "duration": 3.32
  },
  {
    "id": 43,
    "text": "艾青自觉反思了新月派偏重整齐外形与辞藻雕琢的局限，",
    "start": 158.013,
    "end": 162.535,
    "duration": 4.522
  },
  {
    "id": 44,
    "text": "力主诗歌追求“散文美”与天然律动。",
    "start": 162.915,
    "end": 165.576,
    "duration": 2.661
  },
  {
    "id": 45,
    "text": "他不拘泥于外在押韵和字数齐整，而是大量运用排比、递进、",
    "start": 165.83,
    "end": 170.55,
    "duration": 4.72
  },
  {
    "id": 46,
    "text": "长短句交错与复沓回环，营造如波涛涌动、",
    "start": 170.85,
    "end": 175.041,
    "duration": 4.191
  },
  {
    "id": 47,
    "text": "沉郁顿挫的内在节奏。",
    "start": 175.395,
    "end": 176.925,
    "duration": 1.53
  },
  {
    "id": 48,
    "text": "无论在《雪落在中国的土地上》中反复咏叹农夫与孤寡流离失所的悲怆句式，",
    "start": 177.233,
    "end": 183.333,
    "duration": 6.1
  },
  {
    "id": 49,
    "text": "还是在《北方》中以绘画般的色彩冷暖对比与立体造型勾勒荒原苦难，",
    "start": 183.918,
    "end": 189.922,
    "duration": 6.004
  },
  {
    "id": 50,
    "text": "艾青都以质朴凝练的诗语、",
    "start": 190.197,
    "end": 192.533,
    "duration": 2.336
  },
  {
    "id": 51,
    "text": "不饰雕琢的自然声调与阔大格局拓宽了新诗容量，",
    "start": 192.938,
    "end": 197.052,
    "duration": 4.114
  },
  {
    "id": 52,
    "text": "推动自由体新诗从沙龙案头走向时代大众。",
    "start": 197.277,
    "end": 201.032,
    "duration": 3.755
  },
  {
    "id": 53,
    "text": "由此观之，",
    "start": 201.735,
    "end": 202.515,
    "duration": 0.78
  },
  {
    "id": 54,
    "text": "艾青诗歌以“土地与太阳”的双重意象为现代中国塑造了坚韧的精神图腾，",
    "start": 202.836,
    "end": 208.557,
    "duration": 5.721
  },
  {
    "id": 55,
    "text": "在语言机制上引导新诗回归民族泥土与人民大众。",
    "start": 208.758,
    "end": 213.337,
    "duration": 4.579
  },
  {
    "id": 56,
    "text": "其深沉的忧患意识与执着的光明追求，",
    "start": 213.716,
    "end": 216.586,
    "duration": 2.87
  },
  {
    "id": 57,
    "text": "奠定了中国现代诗歌扎根人民、直面现实的重要传统。",
    "start": 216.677,
    "end": 221.323,
    "duration": 4.646
  }
]