[
  {
    "id": 1,
    "text": "试论曹禺《雷雨》的思想意蕴与艺术成就。",
    "start": 0.16,
    "end": 4.32,
    "duration": 4.16
  },
  {
    "id": 2,
    "text": "三十年代曹禺话剧《雷雨》的问世，",
    "start": 4.32,
    "end": 7.52,
    "duration": 3.2
  },
  {
    "id": 3,
    "text": "标志着中国现代话剧文学走向完全成熟。",
    "start": 7.52,
    "end": 11.12,
    "duration": 3.6
  },
  {
    "id": 4,
    "text": "剧作彻底终结了早期文明戏的简陋直白与五四“问题剧”的生硬说教，",
    "start": 11.12,
    "end": 17.68,
    "duration": 6.56
  },
  {
    "id": 5,
    "text": "创造性地将西方古典戏剧的严密技巧、",
    "start": 17.68,
    "end": 21.04,
    "duration": 3.36
  },
  {
    "id": 6,
    "text": "古希腊式的命运哲学与中国深沉的宗法批判熔铸于一炉。",
    "start": 21.2,
    "end": 26.32,
    "duration": 5.12
  },
  {
    "id": 7,
    "text": "其对思想意蕴的多维开拓、对复杂人性的深层开掘，",
    "start": 26.32,
    "end": 31.2,
    "duration": 4.88
  },
  {
    "id": 8,
    "text": "以及对戏剧时空张力的高压营构，",
    "start": 31.2,
    "end": 34.32,
    "duration": 3.12
  },
  {
    "id": 9,
    "text": "确立了中国现代话剧现实主义与诗化美学交融的经典范式。",
    "start": 34.56,
    "end": 40.24,
    "duration": 5.68
  },
  {
    "id": 10,
    "text": "第一，在思想意蕴上，",
    "start": 40.24,
    "end": 42.24,
    "duration": 2.0
  },
  {
    "id": 11,
    "text": "《雷雨》实现了社会历史批判与形而上命运哲思的有机互证。",
    "start": 42.24,
    "end": 48.0,
    "duration": 5.76
  },
  {
    "id": 12,
    "text": "在经验现实维度上，剧作借由周、",
    "start": 48.0,
    "end": 51.36,
    "duration": 3.36
  },
  {
    "id": 13,
    "text": "鲁两家三十年的恩怨纠葛与一日内的全面崩塌，",
    "start": 51.36,
    "end": 55.6,
    "duration": 4.24
  },
  {
    "id": 14,
    "text": "彻底撕破了封建宗法大家庭温情脉脉的伪善面具。",
    "start": 55.6,
    "end": 58.8,
    "duration": 3.2
  },
  {
    "id": 15,
    "text": "以周朴园为代表的宗法资本家，",
    "start": 58.8,
    "end": 62.08,
    "duration": 3.28
  },
  {
    "id": 16,
    "text": "早年在哈尔滨江桥故意淹死两千包工工人，",
    "start": 62.08,
    "end": 65.84,
    "duration": 3.76
  },
  {
    "id": 17,
    "text": "并在生下周冲的胞兄后逼迫年轻侍萍在大年三十冒雪投河；",
    "start": 65.84,
    "end": 71.52,
    "duration": 5.68
  },
  {
    "id": 18,
    "text": "剧作通过血淋淋的阶级罪恶，",
    "start": 71.52,
    "end": 74.32,
    "duration": 2.8
  },
  {
    "id": 19,
    "text": "深刻指控了封建特权与早期资本积累对底层劳苦大众的残酷压迫。",
    "start": 74.32,
    "end": 80.48,
    "duration": 6.16
  },
  {
    "id": 20,
    "text": "但在超越性哲学维度上，剧作并未止步于阶级罪恶的揭露。",
    "start": 80.88,
    "end": 86.8,
    "duration": 5.92
  },
  {
    "id": 21,
    "text": "曹禺在《〈雷雨〉序》中明确坦言，",
    "start": 86.8,
    "end": 90.24,
    "duration": 3.44
  },
  {
    "id": 22,
    "text": "其创作源于对天地间不可知神秘力量的敬畏。",
    "start": 90.32,
    "end": 94.24,
    "duration": 3.92
  },
  {
    "id": 23,
    "text": "全剧以持续郁热窒息的气候与隐隐雷鸣为背景，",
    "start": 94.24,
    "end": 97.6,
    "duration": 3.36
  },
  {
    "id": 24,
    "text": "营构出超自然的宿命压迫感；蘩漪越是孤注一掷地反抗，",
    "start": 97.6,
    "end": 102.96,
    "duration": 5.36
  },
  {
    "id": 25,
    "text": "周萍越是疯狂地逃离，周冲越是怀抱纯洁憧憬，",
    "start": 103.12,
    "end": 107.36,
    "duration": 4.24
  },
  {
    "id": 26,
    "text": "人物就越迅速地滑向乱伦与自戕的深渊。",
    "start": 107.36,
    "end": 110.96,
    "duration": 3.6
  },
  {
    "id": 27,
    "text": "这种社会现实批判与希腊式命运之谜的互证，",
    "start": 110.96,
    "end": 115.336,
    "duration": 4.376
  },
  {
    "id": 28,
    "text": "赋予了剧作恒久震撼的形而上哲学深度。",
    "start": 115.336,
    "end": 118.776,
    "duration": 3.44
  },
  {
    "id": 29,
    "text": "第二，在人物塑造上，《雷雨》打破了非黑即白的脸谱化模式，",
    "start": 118.776,
    "end": 123.736,
    "duration": 4.96
  },
  {
    "id": 30,
    "text": "深刻揭示了人性的复杂悖论。",
    "start": 123.736,
    "end": 126.136,
    "duration": 2.4
  },
  {
    "id": 31,
    "text": "周朴园绝非单一的封建恶霸，",
    "start": 126.136,
    "end": 128.936,
    "duration": 2.8
  },
  {
    "id": 32,
    "text": "而是一个兼具专制暴虐与温情自恋的复合人格。",
    "start": 128.936,
    "end": 133.336,
    "duration": 4.4
  },
  {
    "id": 33,
    "text": "他对三十年前侍萍的留恋、保留旧家具与关窗的执念，",
    "start": 133.336,
    "end": 138.376,
    "duration": 5.04
  },
  {
    "id": 34,
    "text": "表面上寄托着对未受金钱污染纯真岁月的追怀，",
    "start": 138.376,
    "end": 142.456,
    "duration": 4.08
  },
  {
    "id": 35,
    "text": "实质上是一套旨在掩饰早期罪孽、",
    "start": 142.696,
    "end": 145.576,
    "duration": 2.88
  },
  {
    "id": 36,
    "text": "自我道德美化的心理代偿机制；",
    "start": 145.576,
    "end": 148.296,
    "duration": 2.72
  },
  {
    "id": 37,
    "text": "而当活生生的侍萍出现在面前时，",
    "start": 148.296,
    "end": 151.576,
    "duration": 3.28
  },
  {
    "id": 38,
    "text": "他随即出示五千元支票企图进行经济赎买，",
    "start": 151.576,
    "end": 155.016,
    "duration": 3.44
  },
  {
    "id": 39,
    "text": "彻底撕破了温情脉脉的假象，将阶级自私本质展露无遗。",
    "start": 155.016,
    "end": 159.336,
    "duration": 4.32
  },
  {
    "id": 40,
    "text": "全剧性格烈度最高的核心当属蘩漪。",
    "start": 159.336,
    "end": 162.296,
    "duration": 2.96
  },
  {
    "id": 41,
    "text": "这位深受新思潮濡染却深锁于封建死屋的女性，",
    "start": 162.296,
    "end": 166.536,
    "duration": 4.24
  },
  {
    "id": 42,
    "text": "将对周萍绝望畸形的依恋，化作被压抑生命本能的困兽之斗；",
    "start": 166.536,
    "end": 171.976,
    "duration": 5.44
  },
  {
    "id": 43,
    "text": "其玉石俱焚的决绝反叛，",
    "start": 171.976,
    "end": 174.696,
    "duration": 2.72
  },
  {
    "id": 44,
    "text": "最终撕碎了周公馆温情脉脉的伪善帷幕，",
    "start": 174.696,
    "end": 178.296,
    "duration": 3.6
  },
  {
    "id": 45,
    "text": "铸就了中国现代话剧史上最富悲剧张力的“雷雨式性格”。",
    "start": 178.296,
    "end": 183.736,
    "duration": 5.44
  },
  {
    "id": 46,
    "text": "第三，在艺术形式上，",
    "start": 183.736,
    "end": 185.416,
    "duration": 1.68
  },
  {
    "id": 47,
    "text": "《雷雨》确立了回溯式高压戏剧结构与心灵动作性语言的典范。",
    "start": 185.416,
    "end": 190.936,
    "duration": 5.52
  },
  {
    "id": 48,
    "text": "在戏剧结构上，曹禺借鉴西方古典主义“三一律”，",
    "start": 191.096,
    "end": 195.736,
    "duration": 4.64
  },
  {
    "id": 49,
    "text": "将两代人三十年潜藏的乱伦孽债、阶级仇恨与血缘秘密，",
    "start": 195.736,
    "end": 200.696,
    "duration": 4.96
  },
  {
    "id": 50,
    "text": "高度压缩在盛夏的一天之内（从上午到午夜）与两个封闭场景（周家客厅与鲁家住房）之中。",
    "start": 200.696,
    "end": 209.736,
    "duration": 9.04
  },
  {
    "id": 51,
    "text": "剧作采用高超的回溯式手法，让过去的罪恶化为现时的暗流，",
    "start": 210.056,
    "end": 215.096,
    "duration": 5.04
  },
  {
    "id": 52,
    "text": "在平淡的客套与对话中层层引爆，",
    "start": 215.096,
    "end": 218.616,
    "duration": 3.52
  },
  {
    "id": 53,
    "text": "使全剧从开场便处于危机一触即发的高压状态。",
    "start": 218.616,
    "end": 223.176,
    "duration": 4.56
  },
  {
    "id": 54,
    "text": "在戏剧语言上，剧作彻底摆脱了早期话剧概念化的说教，",
    "start": 223.176,
    "end": 228.696,
    "duration": 5.52
  },
  {
    "id": 55,
    "text": "赋予台词极强的心灵动作性与丰厚的潜台词。",
    "start": 228.696,
    "end": 232.376,
    "duration": 3.68
  },
  {
    "id": 56,
    "text": "在经典的“逼喝苦药”一场中，平缓甚至文雅的言辞背后，",
    "start": 232.376,
    "end": 237.976,
    "duration": 5.6
  },
  {
    "id": 57,
    "text": "奔涌着专制家长意志对个性的窒息绞杀；",
    "start": 237.976,
    "end": 241.656,
    "duration": 3.68
  },
  {
    "id": 58,
    "text": "在雨夜“辨认旧衬衣”的对峙中，",
    "start": 241.656,
    "end": 244.936,
    "duration": 3.28
  },
  {
    "id": 59,
    "text": "周朴园心理防线的节节崩溃被外化为极具张力的交响诗篇。",
    "start": 244.936,
    "end": 250.056,
    "duration": 5.12
  },
  {
    "id": 60,
    "text": "综上所述，《雷雨》将深刻的阶级解剖、古希腊式的命运玄思、",
    "start": 250.056,
    "end": 252.936,
    "duration": 2.88
  },
  {
    "id": 61,
    "text": "复杂的人性悖论与精湛的戏剧技巧熔铸于一炉。",
    "start": 252.776,
    "end": 252.936,
    "duration": 0.16
  },
  {
    "id": 62,
    "text": "它不仅彻底终结了中国现代话剧的草创阶段，",
    "start": 252.776,
    "end": 252.936,
    "duration": 0.16
  },
  {
    "id": 63,
    "text": "更为中国现代文学树立了一座现实主义与诗化美学交融的经典丰碑。",
    "start": 252.776,
    "end": 252.936,
    "duration": 0.16
  }
]