[
  {
    "id": 1,
    "text": "试论曹禺《雷雨》的思想意蕴与艺术成就。",
    "start": 0.05,
    "end": 4.079,
    "duration": 4.029
  },
  {
    "id": 2,
    "text": "三十年代曹禺话剧《雷雨》的问世，",
    "start": 4.079,
    "end": 6.853,
    "duration": 2.774
  },
  {
    "id": 3,
    "text": "标志着中国现代话剧文学走向完全成熟。",
    "start": 6.853,
    "end": 10.245,
    "duration": 3.392
  },
  {
    "id": 4,
    "text": "剧作彻底终结了早期文明戏的简陋直白与五四“问题剧”的生硬说教，",
    "start": 10.245,
    "end": 16.073,
    "duration": 5.828
  },
  {
    "id": 5,
    "text": "创造性地将西方古典戏剧的严密技巧、",
    "start": 16.073,
    "end": 19.486,
    "duration": 3.413
  },
  {
    "id": 6,
    "text": "古希腊式的命运哲学与中国深沉的宗法批判熔铸于一炉。",
    "start": 19.486,
    "end": 24.588,
    "duration": 5.102
  },
  {
    "id": 7,
    "text": "其对思想意蕴的多维开拓、对复杂人性的深层开掘，",
    "start": 24.588,
    "end": 29.072,
    "duration": 4.484
  },
  {
    "id": 8,
    "text": "以及对戏剧时空张力的高压营构，",
    "start": 29.072,
    "end": 31.986,
    "duration": 2.914
  },
  {
    "id": 9,
    "text": "确立了中国现代话剧现实主义与诗化美学交融的经典范式。",
    "start": 31.986,
    "end": 37.154,
    "duration": 5.168
  },
  {
    "id": 10,
    "text": "第一，在思想意蕴上，",
    "start": 37.154,
    "end": 39.229,
    "duration": 2.075
  },
  {
    "id": 11,
    "text": "《雷雨》实现了社会历史批判与形而上命运哲思的有机互证。",
    "start": 39.229,
    "end": 43.953,
    "duration": 4.724
  },
  {
    "id": 12,
    "text": "在经验现实维度上，剧作借由周、",
    "start": 43.953,
    "end": 46.902,
    "duration": 2.949
  },
  {
    "id": 13,
    "text": "鲁两家三十年的恩怨纠葛与一日内的全面崩塌，",
    "start": 46.902,
    "end": 51.148,
    "duration": 4.246
  },
  {
    "id": 14,
    "text": "彻底撕破了封建宗法大家庭温情脉脉的伪善面具。",
    "start": 51.148,
    "end": 55.517,
    "duration": 4.369
  },
  {
    "id": 15,
    "text": "以周朴园为代表的宗法资本家，",
    "start": 55.517,
    "end": 57.902,
    "duration": 2.385
  },
  {
    "id": 16,
    "text": "早年在哈尔滨江桥故意淹死两千包工工人，",
    "start": 57.902,
    "end": 61.768,
    "duration": 3.866
  },
  {
    "id": 17,
    "text": "并在生下周冲的胞兄后逼迫年轻侍萍在大年三十冒雪投河；",
    "start": 61.768,
    "end": 66.909,
    "duration": 5.141
  },
  {
    "id": 18,
    "text": "剧作通过血淋淋的阶级罪恶，",
    "start": 66.909,
    "end": 69.469,
    "duration": 2.56
  },
  {
    "id": 19,
    "text": "深刻指控了封建特权与早期资本积累对底层劳苦大众的残酷压迫。",
    "start": 69.469,
    "end": 75.817,
    "duration": 6.348
  },
  {
    "id": 20,
    "text": "但在超越性哲学维度上，剧作并未止步于阶级罪恶的揭露。",
    "start": 75.817,
    "end": 80.961,
    "duration": 5.144
  },
  {
    "id": 21,
    "text": "曹禺在《〈雷雨〉序》中明确坦言，",
    "start": 80.961,
    "end": 83.431,
    "duration": 2.47
  },
  {
    "id": 22,
    "text": "其创作源于对天地间不可知神秘力量的敬畏。",
    "start": 83.431,
    "end": 87.71,
    "duration": 4.279
  },
  {
    "id": 23,
    "text": "全剧以持续郁热窒息的气候与隐隐雷鸣为背景，",
    "start": 87.71,
    "end": 92.293,
    "duration": 4.583
  },
  {
    "id": 24,
    "text": "营构出超自然的宿命压迫感；蘩漪越是孤注一掷地反抗，",
    "start": 92.293,
    "end": 96.737,
    "duration": 4.444
  },
  {
    "id": 25,
    "text": "周萍越是疯狂地逃离，周冲越是怀抱纯洁憧憬，",
    "start": 96.737,
    "end": 100.981,
    "duration": 4.244
  },
  {
    "id": 26,
    "text": "人物就越迅速地滑向乱伦与自戕的深渊。",
    "start": 100.981,
    "end": 104.764,
    "duration": 3.783
  },
  {
    "id": 27,
    "text": "这种社会现实批判与希腊式命运之谜的互证，",
    "start": 104.764,
    "end": 108.251,
    "duration": 3.487
  },
  {
    "id": 28,
    "text": "赋予了剧作恒久震撼的形而上哲学深度。",
    "start": 108.251,
    "end": 111.678,
    "duration": 3.427
  },
  {
    "id": 29,
    "text": "第二，在人物塑造上，《雷雨》打破了非黑即白的脸谱化模式，",
    "start": 111.678,
    "end": 116.657,
    "duration": 4.979
  },
  {
    "id": 30,
    "text": "深刻揭示了人性的复杂悖论。",
    "start": 116.657,
    "end": 118.988,
    "duration": 2.331
  },
  {
    "id": 31,
    "text": "周朴园绝非单一的封建恶霸，",
    "start": 118.988,
    "end": 121.429,
    "duration": 2.441
  },
  {
    "id": 32,
    "text": "而是一个兼具专制暴虐与温情自恋的复合人格。",
    "start": 121.429,
    "end": 125.547,
    "duration": 4.118
  },
  {
    "id": 33,
    "text": "他对三十年前侍萍的留恋、保留旧家具与关窗的执念，",
    "start": 125.547,
    "end": 130.266,
    "duration": 4.719
  },
  {
    "id": 34,
    "text": "表面上寄托着对未受金钱污染纯真岁月的追怀，",
    "start": 130.266,
    "end": 134.369,
    "duration": 4.103
  },
  {
    "id": 35,
    "text": "实质上是一套旨在掩饰早期罪孽、",
    "start": 134.369,
    "end": 137.254,
    "duration": 2.885
  },
  {
    "id": 36,
    "text": "自我道德美化的心理代偿机制；",
    "start": 137.254,
    "end": 140.095,
    "duration": 2.841
  },
  {
    "id": 37,
    "text": "而当活生生的侍萍出现在面前时，",
    "start": 140.095,
    "end": 142.707,
    "duration": 2.612
  },
  {
    "id": 38,
    "text": "他随即出示五千元支票企图进行经济赎买，",
    "start": 142.707,
    "end": 146.585,
    "duration": 3.878
  },
  {
    "id": 39,
    "text": "彻底撕破了温情脉脉的假象，将阶级自私本质展露无遗。",
    "start": 146.585,
    "end": 151.385,
    "duration": 4.8
  },
  {
    "id": 40,
    "text": "全剧性格烈度最高的核心当属蘩漪。",
    "start": 151.385,
    "end": 154.405,
    "duration": 3.02
  },
  {
    "id": 41,
    "text": "这位深受新思潮濡染却深锁于封建死屋的女性，",
    "start": 154.405,
    "end": 158.36,
    "duration": 3.955
  },
  {
    "id": 42,
    "text": "将对周萍绝望畸形的依恋，化作被压抑生命本能的困兽之斗；",
    "start": 158.36,
    "end": 163.284,
    "duration": 4.924
  },
  {
    "id": 43,
    "text": "其玉石俱焚的决绝反叛，",
    "start": 163.284,
    "end": 165.395,
    "duration": 2.111
  },
  {
    "id": 44,
    "text": "最终撕碎了周公馆温情脉脉的伪善帷幕，",
    "start": 165.395,
    "end": 168.727,
    "duration": 3.332
  },
  {
    "id": 45,
    "text": "铸就了中国现代话剧史上最富悲剧张力的“雷雨式性格”。",
    "start": 168.727,
    "end": 173.702,
    "duration": 4.975
  },
  {
    "id": 46,
    "text": "第三，在艺术形式上，",
    "start": 173.702,
    "end": 175.545,
    "duration": 1.843
  },
  {
    "id": 47,
    "text": "《雷雨》确立了回溯式高压戏剧结构与心灵动作性语言的典范。",
    "start": 175.545,
    "end": 180.547,
    "duration": 5.002
  },
  {
    "id": 48,
    "text": "在戏剧结构上，曹禺借鉴西方古典主义“三一律”，",
    "start": 180.547,
    "end": 184.926,
    "duration": 4.379
  },
  {
    "id": 49,
    "text": "将两代人三十年潜藏的乱伦孽债、阶级仇恨与血缘秘密，",
    "start": 184.926,
    "end": 191.13,
    "duration": 6.204
  },
  {
    "id": 50,
    "text": "高度压缩在盛夏的一天之内（从上午到午夜）与两个封闭场景（周家客厅与鲁家住房）之中。",
    "start": 191.13,
    "end": 198.545,
    "duration": 7.415
  },
  {
    "id": 51,
    "text": "剧作采用高超的回溯式手法，让过去的罪恶化为现时的暗流，",
    "start": 198.545,
    "end": 203.283,
    "duration": 4.738
  },
  {
    "id": 52,
    "text": "在平淡的客套与对话中层层引爆，",
    "start": 203.283,
    "end": 206.871,
    "duration": 3.588
  },
  {
    "id": 53,
    "text": "使全剧从开场便处于危机一触即发的高压状态。",
    "start": 206.871,
    "end": 210.507,
    "duration": 3.636
  },
  {
    "id": 54,
    "text": "在戏剧语言上，剧作彻底摆脱了早期话剧概念化的说教，",
    "start": 210.507,
    "end": 215.727,
    "duration": 5.22
  },
  {
    "id": 55,
    "text": "赋予台词极强的心灵动作性与丰厚的潜台词。",
    "start": 215.727,
    "end": 219.91,
    "duration": 4.183
  },
  {
    "id": 56,
    "text": "在经典的“逼喝苦药”一场中，平缓甚至文雅的言辞背后，",
    "start": 219.91,
    "end": 224.178,
    "duration": 4.268
  },
  {
    "id": 57,
    "text": "奔涌着专制家长意志对个性的窒息绞杀；",
    "start": 224.178,
    "end": 227.269,
    "duration": 3.091
  },
  {
    "id": 58,
    "text": "在雨夜“辨认旧衬衣”的对峙中，",
    "start": 227.269,
    "end": 229.451,
    "duration": 2.182
  },
  {
    "id": 59,
    "text": "周朴园心理防线的节节崩溃被外化为极具张力的交响诗篇。",
    "start": 229.451,
    "end": 234.117,
    "duration": 4.666
  },
  {
    "id": 60,
    "text": "综上所述，《雷雨》将深刻的阶级解剖、古希腊式的命运玄思、",
    "start": 234.117,
    "end": 239.063,
    "duration": 4.946
  },
  {
    "id": 61,
    "text": "复杂的人性悖论与精湛的戏剧技巧熔铸于一炉。",
    "start": 239.063,
    "end": 243.455,
    "duration": 4.392
  },
  {
    "id": 62,
    "text": "它不仅彻底终结了中国现代话剧的草创阶段，",
    "start": 243.455,
    "end": 247.225,
    "duration": 3.77
  },
  {
    "id": 63,
    "text": "更为中国现代文学树立了一座现实主义与诗化美学交融的经典丰碑。",
    "start": 247.225,
    "end": 253.152,
    "duration": 5.927
  }
]