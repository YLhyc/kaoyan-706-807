[
  {
    "id": 1,
    "text": "一九三四年曹禺《雷雨》的发表，标志着中国现代话剧文学走向完全成熟。",
    "start": 0.08,
    "end": 5.92,
    "duration": 5.84
  },
  {
    "id": 2,
    "text": "它彻底终结了早期文明戏与五四“问题剧”的生硬直白。",
    "start": 5.92,
    "end": 10.56,
    "duration": 4.64
  },
  {
    "id": 3,
    "text": "剧作将西方严密戏剧技巧、深邃现代人性审视与尖锐宗法批判融为一体。",
    "start": 10.56,
    "end": 17.2,
    "duration": 6.64
  },
  {
    "id": 4,
    "text": "其思想意蕴的双重维度、人物性格的深层开掘以及戏剧形式的高压营造，",
    "start": 17.2,
    "end": 23.12,
    "duration": 5.92
  },
  {
    "id": 5,
    "text": "共同奠定了这一成熟范式的经典地位。",
    "start": 23.12,
    "end": 25.76,
    "duration": 2.64
  },
  {
    "id": 6,
    "text": "第一，在思想意蕴上，《雷雨》实现了现实社会批判与深层命运悲剧的有机融合。",
    "start": 26.0,
    "end": 32.96,
    "duration": 6.96
  },
  {
    "id": 7,
    "text": "在社会历史维度上，剧作具有极为深刻的反封建批判锋芒。",
    "start": 32.96,
    "end": 37.92,
    "duration": 4.96
  },
  {
    "id": 8,
    "text": "全剧通过周、鲁两家三十年的恩怨纠葛，",
    "start": 37.92,
    "end": 41.12,
    "duration": 3.2
  },
  {
    "id": 9,
    "text": "无情撕开了封建宗法大家庭的伪善帷幕。",
    "start": 41.12,
    "end": 44.4,
    "duration": 3.28
  },
  {
    "id": 10,
    "text": "以周朴园为代表的封建资本家，残酷压迫工人阶级并枪害下层女性。",
    "start": 44.4,
    "end": 49.84,
    "duration": 5.44
  },
  {
    "id": 11,
    "text": "这直接控诉了封建阶级压迫与专制制度对人性的扼杀。",
    "start": 50.08,
    "end": 54.8,
    "duration": 4.72
  },
  {
    "id": 12,
    "text": "在形而上哲学维度上，剧作超越了同时代普通的社会问题剧。",
    "start": 54.8,
    "end": 60.0,
    "duration": 5.2
  },
  {
    "id": 13,
    "text": "曹禺在《雷雨序》中明确表达，其创作源于对天地间不可知神秘事物的敬畏。",
    "start": 60.0,
    "end": 66.0,
    "duration": 6.0
  },
  {
    "id": 14,
    "text": "作品通过弥漫全剧的“郁热”气候与雷雨意象，",
    "start": 66.0,
    "end": 69.92,
    "duration": 3.92
  },
  {
    "id": 15,
    "text": "营构出超自然的宿命压抑感。",
    "start": 69.92,
    "end": 72.24,
    "duration": 2.32
  },
  {
    "id": 16,
    "text": "剧中人物越是奋力挣扎，越加速走向家族伦理的瓦解与个体的毁灭。",
    "start": 72.48,
    "end": 78.08,
    "duration": 5.6
  },
  {
    "id": 17,
    "text": "这种社会批判与希腊式命运悲剧的结合，",
    "start": 78.08,
    "end": 81.44,
    "duration": 3.36
  },
  {
    "id": 18,
    "text": "赋予了剧作恒久的哲学深度。",
    "start": 81.44,
    "end": 83.92,
    "duration": 2.48
  },
  {
    "id": 19,
    "text": "第二，在人物塑造上，《雷雨》打破了非黑即白的脸谱化模式，",
    "start": 83.92,
    "end": 88.8,
    "duration": 4.88
  },
  {
    "id": 20,
    "text": "深刻揭示了人性的复杂性与多面性。",
    "start": 88.8,
    "end": 91.6,
    "duration": 2.8
  },
  {
    "id": 21,
    "text": "首先是周朴园这一经典形象的复杂性格开掘。",
    "start": 92.0,
    "end": 95.6,
    "duration": 3.6
  },
  {
    "id": 22,
    "text": "他既是冷酷镇压工人并专制统治家庭的封建暴君，",
    "start": 95.6,
    "end": 99.76,
    "duration": 4.16
  },
  {
    "id": 23,
    "text": "也是保留着旧日温情幻觉的情感落魄者。",
    "start": 99.76,
    "end": 102.96,
    "duration": 3.2
  },
  {
    "id": 24,
    "text": "他对三十年前侍萍的怀念，既包含自我道德美化的伪善，",
    "start": 102.96,
    "end": 107.52,
    "duration": 4.56
  },
  {
    "id": 25,
    "text": "也潜藏对未受金钱污染纯洁人性的真实追恋。",
    "start": 107.52,
    "end": 111.12,
    "duration": 3.6
  },
  {
    "id": 26,
    "text": "这种善恶交织的人格悖论，打破了传统反面角色的平面化。",
    "start": 111.36,
    "end": 116.16,
    "duration": 4.8
  },
  {
    "id": 27,
    "text": "其次是凡漪作为全剧核心的“雷雨式性格”。",
    "start": 116.16,
    "end": 119.92,
    "duration": 3.76
  },
  {
    "id": 28,
    "text": "她受过现代文明浸润，却被长期禁锢在窒息腐朽的封建死屋之中。",
    "start": 119.92,
    "end": 125.44,
    "duration": 5.52
  },
  {
    "id": 29,
    "text": "她对周萍绝望而畸形的依恋，是生命原动力被扼杀后的残酷反弹。",
    "start": 125.44,
    "end": 130.96,
    "duration": 5.52
  },
  {
    "id": 30,
    "text": "曹禺通过她困兽式的挣扎与玉石俱焚的反抗，",
    "start": 131.2,
    "end": 135.12,
    "duration": 3.92
  },
  {
    "id": 31,
    "text": "展现了女性生命本体最悲壮的精神撕裂。",
    "start": 135.12,
    "end": 138.64,
    "duration": 3.52
  },
  {
    "id": 32,
    "text": "第三，在艺术形式上，《雷雨》确立了回溯式高压戏剧结构与心灵动作性的语言典范。",
    "start": 138.944,
    "end": 146.464,
    "duration": 7.52
  },
  {
    "id": 33,
    "text": "在结构布局上，剧作创造性地化用了西方古典主义“三一律”法则。",
    "start": 146.464,
    "end": 151.984,
    "duration": 5.52
  },
  {
    "id": 34,
    "text": "全剧将两代人三十年的纷繁罪恶与乱伦恩怨，",
    "start": 151.984,
    "end": 155.984,
    "duration": 4.0
  },
  {
    "id": 35,
    "text": "高度浓缩在一天之内与周、鲁两家客厅之中。",
    "start": 155.984,
    "end": 159.264,
    "duration": 3.28
  },
  {
    "id": 36,
    "text": "剧作采用精密的回溯式手法，让过去的隐秘在现时的危机中层层引爆。",
    "start": 159.504,
    "end": 165.744,
    "duration": 6.24
  },
  {
    "id": 37,
    "text": "全剧从一开始便处于危机一触即发的高压状态。",
    "start": 165.744,
    "end": 169.904,
    "duration": 4.16
  },
  {
    "id": 38,
    "text": "在戏剧语言上，对话摆脱了机械生硬的概念化说教，",
    "start": 169.904,
    "end": 174.304,
    "duration": 4.4
  },
  {
    "id": 39,
    "text": "具有深邃的潜台词与心灵动作性。",
    "start": 174.304,
    "end": 177.424,
    "duration": 3.12
  },
  {
    "id": 40,
    "text": "以经典的“逼喝苦药”一场为例，平静台词的深处涌动着极权家长的意志压制与各方力量的惊险角力。",
    "start": 177.424,
    "end": 185.584,
    "duration": 8.16
  },
  {
    "id": 41,
    "text": "台词成功外化了隐秘的心理波澜，使剧作洋溢着交响乐般的诗意张力。",
    "start": 185.904,
    "end": 191.184,
    "duration": 5.28
  },
  {
    "id": 42,
    "text": "综上所述，《雷雨》熔铸了现实主义批判深度、",
    "start": 191.184,
    "end": 194.624,
    "duration": 3.44
  },
  {
    "id": 43,
    "text": "现代主义生命体验与精湛戏剧结构。",
    "start": 194.624,
    "end": 197.664,
    "duration": 3.04
  },
  {
    "id": 44,
    "text": "曹禺以卓越的文学天才，为中国现代话剧树立了不可逾越的艺术丰碑。",
    "start": 197.664,
    "end": 202.944,
    "duration": 5.28
  }
]