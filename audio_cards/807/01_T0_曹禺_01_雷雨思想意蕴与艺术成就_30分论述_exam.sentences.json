[
  {
    "id": 1,
    "text": "试论曹禺《雷雨》的思想意蕴与艺术成就。",
    "start": 0.28,
    "end": 3.48,
    "duration": 3.2
  },
  {
    "id": 2,
    "text": "三十年代曹禺话剧《雷雨》的问世，标志着中国现代话剧文学走向成熟。",
    "start": 4.0,
    "end": 9.52,
    "duration": 5.52
  },
  {
    "id": 3,
    "text": "剧作告别了早期文明戏的简陋直白与五四“问题剧”的生硬说教，",
    "start": 10.04,
    "end": 15.0,
    "duration": 4.96
  },
  {
    "id": 4,
    "text": "将西方古典戏剧的严密技巧、古希腊式的命运悲剧与中国宗法家庭批判融为一体。",
    "start": 15.37,
    "end": 22.17,
    "duration": 6.8
  },
  {
    "id": 5,
    "text": "其多维的思想开掘、复杂的人物群像与高压的戏剧时空，确立了中国现代话剧现实主义与诗化美学交融的典范。",
    "start": 22.73,
    "end": 31.17,
    "duration": 8.44
  },
  {
    "id": 6,
    "text": "第一，贯通社会历史批判与超越性命运哲思，开拓剧作的双重思想深度。",
    "start": 31.69,
    "end": 38.09,
    "duration": 6.4
  },
  {
    "id": 7,
    "text": "在社会现实层面，剧作借周、鲁两家三十年的恩怨纠葛与一日内的全面溃败，",
    "start": 38.61,
    "end": 45.25,
    "duration": 6.64
  },
  {
    "id": 8,
    "text": "撕破了封建宗法大家庭温情脉脉的伪善面具。",
    "start": 45.66,
    "end": 49.54,
    "duration": 3.88
  },
  {
    "id": 9,
    "text": "资本家周朴园早年在哈尔滨江桥故意淹死两千二百个小工，",
    "start": 50.06,
    "end": 54.46,
    "duration": 4.4
  },
  {
    "id": 10,
    "text": "又在侍萍刚生下鲁大海三天后，逼迫她于大年三十冒雪抱子投河；",
    "start": 54.83,
    "end": 59.63,
    "duration": 4.8
  },
  {
    "id": 11,
    "text": "剧作通过血淋淋的阶级罪恶，控诉了封建特权与早期资本积累对底层劳动者的残酷压迫。",
    "start": 60.15,
    "end": 67.83,
    "duration": 7.68
  },
  {
    "id": 12,
    "text": "在超越性哲学层面，剧作并未止步于社会问题的揭露。",
    "start": 68.35,
    "end": 72.19,
    "duration": 3.84
  },
  {
    "id": 13,
    "text": "曹禺在《〈雷雨〉序》中坦言，其创作源于对天地间不可知神秘力量的敬畏。",
    "start": 72.71,
    "end": 78.07,
    "duration": 5.36
  },
  {
    "id": 14,
    "text": "全剧以郁热窒息的盛夏气候与隐隐雷鸣为背景，营造出难以逃脱的宿命压迫感；",
    "start": 78.59,
    "end": 86.27,
    "duration": 7.68
  },
  {
    "id": 15,
    "text": "繁漪越是孤注一掷地反抗，周萍越是仓皇逃离，",
    "start": 86.79,
    "end": 91.049,
    "duration": 4.259
  },
  {
    "id": 16,
    "text": "周冲越是怀抱纯洁憧憬，周萍等越加速坠入乱伦与毁灭的绝境。",
    "start": 91.404,
    "end": 96.84,
    "duration": 5.436
  },
  {
    "id": 17,
    "text": "社会历史批判与命运之谜相互映照，赋予剧作深沉的哲理力量。",
    "start": 97.36,
    "end": 102.72,
    "duration": 5.36
  },
  {
    "id": 18,
    "text": "第二，打破非黑即白的脸谱化模式，开掘复杂人性的深层悖论。",
    "start": 103.24,
    "end": 108.44,
    "duration": 5.2
  },
  {
    "id": 19,
    "text": "周朴园具有专制暴虐与温情自恋的复合人格。",
    "start": 108.96,
    "end": 113.12,
    "duration": 4.16
  },
  {
    "id": 20,
    "text": "他对三十年前侍萍的留恋、保留旧家具与关窗的执念，",
    "start": 113.64,
    "end": 118.36,
    "duration": 4.72
  },
  {
    "id": 21,
    "text": "表面上寄托着对未受金钱污染纯真岁月的追怀，",
    "start": 118.73,
    "end": 122.73,
    "duration": 4.0
  },
  {
    "id": 22,
    "text": "实质上是一套掩饰早年罪孽、自我道德美化的心理代偿机制；",
    "start": 123.1,
    "end": 128.3,
    "duration": 5.2
  },
  {
    "id": 23,
    "text": "一旦活生生的侍萍立在面前，他随即出示五千元支票企图以金钱赎买旧情，",
    "start": 128.82,
    "end": 134.74,
    "duration": 5.92
  },
  {
    "id": 24,
    "text": "将阶级自私的冷酷本色暴露无遗。",
    "start": 135.11,
    "end": 137.83,
    "duration": 2.72
  },
  {
    "id": 25,
    "text": "全剧性格烈度最高的人物当属繁漪。",
    "start": 138.35,
    "end": 141.07,
    "duration": 2.72
  },
  {
    "id": 26,
    "text": "这位深受新思潮濡染却被深锁于封建死屋的女性，将对周萍绝望畸形的依恋化作困兽之斗；",
    "start": 141.59,
    "end": 149.653,
    "duration": 8.063
  },
  {
    "id": 27,
    "text": "其玉石俱焚的决绝反叛，撕碎了周公馆的伪善帷幕，",
    "start": 150.153,
    "end": 154.11,
    "duration": 3.957
  },
  {
    "id": 28,
    "text": "铸就了中国现代话剧史上极具悲剧张力的“雷雨式性格”。",
    "start": 154.59,
    "end": 159.07,
    "duration": 4.48
  },
  {
    "id": 29,
    "text": "第三，营构回溯式高压戏剧结构，锤炼富有心灵动作性的潜台词。",
    "start": 159.59,
    "end": 165.27,
    "duration": 5.68
  },
  {
    "id": 30,
    "text": "在戏剧结构上，曹禺借鉴西方古典主义“三一律”，将两代人三十年潜藏的乱伦孽债、阶级仇恨与血缘秘密，",
    "start": 165.79,
    "end": 174.72,
    "duration": 8.93
  },
  {
    "id": 31,
    "text": "将中间四幕浓缩在盛夏一天之内（从上午到午夜）与两个封闭场景（周家客厅与鲁家住房）之中。",
    "start": 175.09,
    "end": 183.49,
    "duration": 8.4
  },
  {
    "id": 32,
    "text": "剧作采用回溯式手法，让往昔罪恶化作现时暗流，",
    "start": 184.01,
    "end": 188.01,
    "duration": 4.0
  },
  {
    "id": 33,
    "text": "在平淡的客套与对话中层层引爆，使全剧自开场便处于一触即发的高压态势。",
    "start": 188.38,
    "end": 195.02,
    "duration": 6.64
  },
  {
    "id": 34,
    "text": "在戏剧语言上，剧作摆脱早期话剧的概念化说教，赋予台词敏锐的心灵动作性与丰厚潜台词。",
    "start": 195.54,
    "end": 202.74,
    "duration": 7.2
  },
  {
    "id": 35,
    "text": "在“逼喝苦药”一场中，平缓文雅的言辞背后奔涌着专制家长意志对个性的窒息绞杀；",
    "start": 203.26,
    "end": 209.898,
    "duration": 6.638
  },
  {
    "id": 36,
    "text": "在第二幕白天周家客厅“辨认旧衬衣”的对峙中，周朴园心理防线的节节败退被外化为张力十足的心灵交锋。",
    "start": 210.398,
    "end": 218.1,
    "duration": 7.702
  },
  {
    "id": 37,
    "text": "纵观全剧，《雷雨》将深刻的阶级解剖、命运玄思、人性悖论与精湛的戏剧技巧融为一体。",
    "start": 218.62,
    "end": 225.98,
    "duration": 7.36
  },
  {
    "id": 38,
    "text": "它结束了中国现代话剧的草创摸索，确立了现实主义与诗化美学交融的经典范式。",
    "start": 226.5,
    "end": 232.82,
    "duration": 6.32
  }
]
