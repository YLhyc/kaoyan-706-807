[
  {
    "id": 1,
    "text": "试论曹禺《雷雨》的思想意蕴与艺术成就。",
    "start": 0.101,
    "end": 3.545,
    "duration": 3.444
  },
  {
    "id": 2,
    "text": "三十年代曹禺话剧《雷雨》的问世，标志着中国现代话剧文学走向成熟。",
    "start": 4.045,
    "end": 9.757,
    "duration": 5.712
  },
  {
    "id": 3,
    "text": "剧作告别了早期文明戏的简陋直白与五四“问题剧”的生硬说教，",
    "start": 10.257,
    "end": 15.247,
    "duration": 4.99
  },
  {
    "id": 4,
    "text": "将西方古典戏剧的严密技巧、古希腊式的命运悲剧与中国宗法家庭批判融为一体。",
    "start": 15.793,
    "end": 22.23,
    "duration": 6.437
  },
  {
    "id": 5,
    "text": "其多维的思想开掘、复杂的人物群像与高压的戏剧时空，",
    "start": 22.73,
    "end": 27.188,
    "duration": 4.458
  },
  {
    "id": 6,
    "text": "确立了中国现代话剧现实主义与诗化美学交融的典范。",
    "start": 27.538,
    "end": 32.018,
    "duration": 4.48
  },
  {
    "id": 7,
    "text": "第一，贯通社会历史批判与超越性命运哲思，开拓剧作的双重思想深度。",
    "start": 32.671,
    "end": 38.79,
    "duration": 6.119
  },
  {
    "id": 8,
    "text": "在社会现实层面，剧作借周、鲁两家三十年的恩怨纠葛与一日内的全面溃败，",
    "start": 39.29,
    "end": 45.373,
    "duration": 6.083
  },
  {
    "id": 9,
    "text": "撕破了封建宗法大家庭温情脉脉的伪善面具。",
    "start": 45.723,
    "end": 49.359,
    "duration": 3.636
  },
  {
    "id": 10,
    "text": "资本家周朴园早年在哈尔滨江桥故意淹死两千二百个小工，",
    "start": 49.859,
    "end": 54.273,
    "duration": 4.414
  },
  {
    "id": 11,
    "text": "又在侍萍刚生下鲁大海三天后，逼迫她于大年三十冒雪抱子投河；",
    "start": 54.623,
    "end": 60.267,
    "duration": 5.644
  },
  {
    "id": 12,
    "text": "剧作通过血淋淋的阶级罪恶，控诉了封建特权与早期资本积累对底层劳动者的残酷压迫。",
    "start": 60.767,
    "end": 68.028,
    "duration": 7.261
  },
  {
    "id": 13,
    "text": "在超越性哲学层面，剧作并未止步于社会问题的揭露。",
    "start": 68.528,
    "end": 72.308,
    "duration": 3.78
  },
  {
    "id": 14,
    "text": "曹禺在《〈雷雨〉序》中坦言，其创作源于对天地间不可知神秘力量的敬畏。",
    "start": 72.808,
    "end": 78.268,
    "duration": 5.46
  },
  {
    "id": 15,
    "text": "全剧以郁热窒息的盛夏气候与隐隐雷鸣为背景，营造出难以逃脱的宿命压迫感；",
    "start": 78.768,
    "end": 85.12,
    "duration": 6.352
  },
  {
    "id": 16,
    "text": "繁漪越是孤注一掷地反抗，周萍越是仓皇逃离，",
    "start": 85.62,
    "end": 89.04,
    "duration": 3.42
  },
  {
    "id": 17,
    "text": "周冲越是怀抱纯洁憧憬，周萍等越加速坠入乱伦与毁灭的绝境。",
    "start": 89.39,
    "end": 94.424,
    "duration": 5.034
  },
  {
    "id": 18,
    "text": "社会历史批判与命运之谜相互映照，赋予剧作深沉的哲理力量。",
    "start": 94.924,
    "end": 100.413,
    "duration": 5.489
  },
  {
    "id": 19,
    "text": "第二，打破非黑即白的脸谱化模式，开掘复杂人性的深层悖论。",
    "start": 101.02,
    "end": 106.906,
    "duration": 5.886
  },
  {
    "id": 20,
    "text": "周朴园具有专制暴虐与温情自恋的复合人格。",
    "start": 107.406,
    "end": 111.102,
    "duration": 3.696
  },
  {
    "id": 21,
    "text": "他对三十年前侍萍的留恋、保留旧家具与关窗的执念，",
    "start": 111.602,
    "end": 115.769,
    "duration": 4.167
  },
  {
    "id": 22,
    "text": "表面上寄托着对未受金钱污染纯真岁月的追怀，",
    "start": 116.14,
    "end": 119.968,
    "duration": 3.828
  },
  {
    "id": 23,
    "text": "实质上是一套掩饰早年罪孽、自我道德美化的心理代偿机制；",
    "start": 120.341,
    "end": 125.314,
    "duration": 4.973
  },
  {
    "id": 24,
    "text": "一旦活生生的侍萍立在面前，他随即出示五千元支票企图以金钱赎买旧情，",
    "start": 125.814,
    "end": 132.188,
    "duration": 6.374
  },
  {
    "id": 25,
    "text": "将阶级自私的冷酷本色暴露无遗。",
    "start": 132.603,
    "end": 135.489,
    "duration": 2.886
  },
  {
    "id": 26,
    "text": "全剧性格烈度最高的人物当属繁漪。",
    "start": 136.28,
    "end": 139.178,
    "duration": 2.898
  },
  {
    "id": 27,
    "text": "这位深受新思潮濡染却被深锁于封建死屋的女性，将对周萍绝望畸形的依恋化作困兽之斗；",
    "start": 139.875,
    "end": 147.812,
    "duration": 7.937
  },
  {
    "id": 28,
    "text": "其玉石俱焚的决绝反叛，撕碎了周公馆的伪善帷幕，",
    "start": 148.312,
    "end": 152.439,
    "duration": 4.127
  },
  {
    "id": 29,
    "text": "铸就了中国现代话剧史上极具悲剧张力的“雷雨式性格”。",
    "start": 152.891,
    "end": 157.503,
    "duration": 4.612
  },
  {
    "id": 30,
    "text": "第三，营构回溯式高压戏剧结构，锤炼富有心灵动作性的潜台词。",
    "start": 158.13,
    "end": 163.174,
    "duration": 5.044
  },
  {
    "id": 31,
    "text": "在戏剧结构上，曹禺借鉴西方古典主义“三一律”，将两代人三十年潜藏的乱伦孽债、阶级仇恨与血缘秘密，",
    "start": 163.697,
    "end": 172.104,
    "duration": 8.407
  },
  {
    "id": 32,
    "text": "将中间四幕浓缩在盛夏一天之内（从上午到午夜）与两个封闭场景（周家客厅与鲁家住房）之中。",
    "start": 172.454,
    "end": 180.435,
    "duration": 7.981
  },
  {
    "id": 33,
    "text": "剧作采用回溯式手法，让往昔罪恶化作现时暗流，",
    "start": 180.935,
    "end": 185.252,
    "duration": 4.317
  },
  {
    "id": 34,
    "text": "在平淡的客套与对话中层层引爆，使全剧自开场便处于一触即发的高压态势。",
    "start": 185.602,
    "end": 192.501,
    "duration": 6.899
  },
  {
    "id": 35,
    "text": "在戏剧语言上，剧作摆脱早期话剧的概念化说教，赋予台词敏锐的心灵动作性与丰厚潜台词。",
    "start": 193.001,
    "end": 201.165,
    "duration": 8.164
  },
  {
    "id": 36,
    "text": "在“逼喝苦药”一场中，平缓文雅的言辞背后奔涌着专制家长意志对个性的窒息绞杀；",
    "start": 201.665,
    "end": 208.42,
    "duration": 6.755
  },
  {
    "id": 37,
    "text": "在第二幕白天周家客厅“辨认旧衬衣”的对峙中，周朴园心理防线的节节败退被外化为张力十足的心灵交锋。",
    "start": 208.92,
    "end": 217.366,
    "duration": 8.446
  },
  {
    "id": 38,
    "text": "纵观全剧，《雷雨》将深刻的阶级解剖、命运玄思、人性悖论与精湛的戏剧技巧融为一体。",
    "start": 217.995,
    "end": 225.102,
    "duration": 7.107
  },
  {
    "id": 39,
    "text": "它结束了中国现代话剧的草创摸索，确立了现实主义与诗化美学交融的经典范式。",
    "start": 225.602,
    "end": 231.753,
    "duration": 6.151
  }
]
