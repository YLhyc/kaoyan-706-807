[
  {
    "id": 1,
    "text": "试论曹禺《雷雨》的思想意蕴与艺术成就。",
    "start": 0.134,
    "end": 3.266,
    "duration": 3.132
  },
  {
    "id": 2,
    "text": "三十年代曹禺话剧《雷雨》的问世，标志着中国现代话剧文学走向成熟。",
    "start": 3.903,
    "end": 9.275,
    "duration": 5.372
  },
  {
    "id": 3,
    "text": "剧作告别了早期文明戏的简陋直白与五四“问题剧”的生硬说教，",
    "start": 9.953,
    "end": 14.525,
    "duration": 4.572
  },
  {
    "id": 4,
    "text": "将西方古典戏剧的严密技巧、古希腊式的命运悲剧与中国宗法家庭批判融为一体。",
    "start": 14.904,
    "end": 20.876,
    "duration": 5.972
  },
  {
    "id": 5,
    "text": "其多维的思想开掘、复杂的人物群像与高压的戏剧时空，确立了中国现代话剧现实主义与诗化美学交融的典范。",
    "start": 21.554,
    "end": 30.366,
    "duration": 8.812
  },
  {
    "id": 6,
    "text": "第一，贯通社会历史批判与超越性命运哲思，开拓剧作的双重思想深度。",
    "start": 31.044,
    "end": 36.536,
    "duration": 5.492
  },
  {
    "id": 7,
    "text": "在社会现实层面，剧作借周、鲁两家三十年的恩怨纠葛与一日内的全面溃败，",
    "start": 37.174,
    "end": 42.626,
    "duration": 5.452
  },
  {
    "id": 8,
    "text": "撕破了封建宗法大家庭温情脉脉的伪善面具。",
    "start": 43.005,
    "end": 46.297,
    "duration": 3.292
  },
  {
    "id": 9,
    "text": "资本家周朴园早年在哈尔滨江桥故意淹死两千二百个小工，",
    "start": 46.975,
    "end": 51.467,
    "duration": 4.492
  },
  {
    "id": 10,
    "text": "又在侍萍刚生下鲁大海三天后，逼迫她于大年三十冒雪抱子投河；",
    "start": 51.846,
    "end": 57.058,
    "duration": 5.212
  },
  {
    "id": 11,
    "text": "剧作通过血淋淋的阶级罪恶，控诉了封建特权与早期资本积累对底层劳动者的残酷压迫。",
    "start": 57.736,
    "end": 64.508,
    "duration": 6.772
  },
  {
    "id": 12,
    "text": "在超越性哲学层面，剧作并未止步于社会问题的揭露。",
    "start": 65.186,
    "end": 69.118,
    "duration": 3.932
  },
  {
    "id": 13,
    "text": "曹禺在《〈雷雨〉序》中坦言，其创作源于对天地间不可知神秘力量的敬畏。",
    "start": 69.756,
    "end": 75.008,
    "duration": 5.252
  },
  {
    "id": 14,
    "text": "全剧以郁热窒息的盛夏气候与隐隐雷鸣为背景，营造出难以逃脱的宿命压迫感；",
    "start": 75.766,
    "end": 78.378,
    "duration": 2.612
  },
  {
    "id": 15,
    "text": "繁漪越是孤注一掷地反抗，周萍越是仓皇逃离，",
    "start": 78.907,
    "end": 79.829,
    "duration": 0.922
  },
  {
    "id": 16,
    "text": "周冲越是怀抱纯洁憧憬，周萍等越加速坠入乱伦与毁灭的绝境。",
    "start": 80.208,
    "end": 82.5,
    "duration": 2.292
  },
  {
    "id": 17,
    "text": "社会历史批判与命运之谜相互映照，赋予剧作深沉的哲理力量。",
    "start": 83.138,
    "end": 92.31,
    "duration": 9.172
  },
  {
    "id": 18,
    "text": "第二，打破非黑即白的脸谱化模式，开掘复杂人性的深层悖论。",
    "start": 92.988,
    "end": 97.72,
    "duration": 4.732
  },
  {
    "id": 19,
    "text": "周朴园具有专制暴虐与温情自恋的复合人格。",
    "start": 98.438,
    "end": 106.57,
    "duration": 8.132
  },
  {
    "id": 20,
    "text": "他对三十年前侍萍的留恋、保留旧家具与关窗的执念，",
    "start": 107.099,
    "end": 111.271,
    "duration": 4.172
  },
  {
    "id": 21,
    "text": "表面上寄托着对未受金钱污染纯真岁月的追怀，",
    "start": 111.65,
    "end": 115.302,
    "duration": 3.652
  },
  {
    "id": 22,
    "text": "实质上是一套掩饰早年罪孽、自我道德美化的心理代偿机制；",
    "start": 115.681,
    "end": 120.733,
    "duration": 5.052
  },
  {
    "id": 23,
    "text": "一旦活生生的侍萍立在面前，他随即出示五千元支票企图以金钱赎买旧情，",
    "start": 121.262,
    "end": 127.474,
    "duration": 6.212
  },
  {
    "id": 24,
    "text": "将阶级自私的冷酷本色暴露无遗。",
    "start": 127.853,
    "end": 130.465,
    "duration": 2.612
  },
  {
    "id": 25,
    "text": "全剧性格烈度最高的人物当属繁漪。",
    "start": 130.994,
    "end": 133.646,
    "duration": 2.652
  },
  {
    "id": 26,
    "text": "这位深受新思潮濡染却被深锁于封建死屋的女性，将对周萍绝望畸形的依恋化作困兽之斗；",
    "start": 134.324,
    "end": 141.696,
    "duration": 7.372
  },
  {
    "id": 27,
    "text": "其玉石俱焚的决绝反叛，撕碎了周公馆的伪善帷幕，",
    "start": 142.374,
    "end": 146.386,
    "duration": 4.012
  },
  {
    "id": 28,
    "text": "铸就了中国现代话剧史上极具悲剧张力的“雷雨式性格”。",
    "start": 146.765,
    "end": 150.937,
    "duration": 4.172
  },
  {
    "id": 29,
    "text": "第三，营构回溯式高压戏剧结构，锤炼富有心灵动作性的潜台词。",
    "start": 151.615,
    "end": 156.787,
    "duration": 5.172
  },
  {
    "id": 30,
    "text": "在戏剧结构上，曹禺借鉴西方古典主义“三一律”，将两代人三十年潜藏的乱伦孽债、阶级仇恨与血缘秘密，",
    "start": 157.465,
    "end": 165.837,
    "duration": 8.372
  },
  {
    "id": 31,
    "text": "将中间四幕浓缩在盛夏一天之内（从上午到午夜）与两个封闭场景（周家客厅与鲁家住房）之中。",
    "start": 166.306,
    "end": 173.718,
    "duration": 7.412
  },
  {
    "id": 32,
    "text": "剧作采用回溯式手法，让往昔罪恶化作现时暗流，",
    "start": 174.415,
    "end": 178.827,
    "duration": 4.412
  },
  {
    "id": 33,
    "text": "在平淡的客套与对话中层层引爆，使全剧自开场便处于一触即发的高压态势。",
    "start": 179.206,
    "end": 185.258,
    "duration": 6.052
  },
  {
    "id": 34,
    "text": "在戏剧语言上，剧作摆脱早期话剧的概念化说教，赋予台词敏锐的心灵动作性与丰厚潜台词。",
    "start": 185.936,
    "end": 192.948,
    "duration": 7.012
  },
  {
    "id": 35,
    "text": "在“逼喝苦药”一场中，平缓文雅的言辞背后奔涌着专制家长意志对个性的窒息绞杀；",
    "start": 193.666,
    "end": 197.478,
    "duration": 3.812
  },
  {
    "id": 36,
    "text": "在第二幕白天周家客厅“辨认旧衬衣”的对峙中，周朴园心理防线的节节败退被外化为张力十足的心灵交锋。",
    "start": 198.007,
    "end": 200.619,
    "duration": 2.612
  },
  {
    "id": 37,
    "text": "纵观全剧，《雷雨》将深刻的阶级解剖、命运玄思、人性悖论与精湛的戏剧技巧融为一体。",
    "start": 201.297,
    "end": 208.989,
    "duration": 7.692
  },
  {
    "id": 38,
    "text": "它结束了中国现代话剧的草创摸索，确立了现实主义与诗化美学交融的经典范式。",
    "start": 209.707,
    "end": 222.519,
    "duration": 12.812
  }
]