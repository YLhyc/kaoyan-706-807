[
  {
    "id": 1,
    "text": "新时期之初，以北岛、舒婷、顾城为代表的朦胧诗群，在现代文学史上掀起了一场震撼人心的主体复归与审美革命。",
    "start": 0.134,
    "end": 9.466,
    "duration": 9.332
  },
  {
    "id": 2,
    "text": "诗群告别了长期以来机械政治抒情的图解模式，转向对个体尊严的重新确认与历史反思，",
    "start": 10.09,
    "end": 12.342,
    "duration": 2.252
  },
  {
    "id": 3,
    "text": "其思想特征与艺术革新主要表现在以下三个维度：",
    "start": 12.721,
    "end": 13.963,
    "duration": 1.242
  },
  {
    "id": 4,
    "text": "第一，确立怀疑主义理性精神，重构独立崇高的主体尊严。",
    "start": 14.641,
    "end": 26.093,
    "duration": 11.452
  },
  {
    "id": 5,
    "text": "朦胧诗坚决打破了对权威盲从的迷信思维，将批判目光投向历史沉疴与群体盲从。",
    "start": 26.891,
    "end": 33.943,
    "duration": 7.052
  },
  {
    "id": 6,
    "text": "北岛在《回答》中以冷峻决绝的声调铸就了历史判词，",
    "start": 34.661,
    "end": 38.393,
    "duration": 3.732
  },
  {
    "id": 7,
    "text": "其“告诉你吧，世界 / 我——不——相——信！”的震颤呼喊，",
    "start": 38.772,
    "end": 39.584,
    "duration": 0.812
  },
  {
    "id": 8,
    "text": "以绝不妥协的傲然风骨，将抒情主人公塑造成挺立于冰川与废墟之上的现代思想硬汉；",
    "start": 39.963,
    "end": 43.385,
    "duration": 3.422
  },
  {
    "id": 9,
    "text": "顾城在《一代人》中以两行极具哲学张力的诗句，",
    "start": 43.914,
    "end": 45.886,
    "duration": 1.972
  },
  {
    "id": 10,
    "text": "将经历过浩劫的一代青年对光明的执着探求凝练为集体精神图腾，",
    "start": 46.265,
    "end": 48.357,
    "duration": 2.092
  },
  {
    "id": 11,
    "text": "唤醒了青年一代的主体价值意识。",
    "start": 48.736,
    "end": 51.748,
    "duration": 3.012
  },
  {
    "id": 12,
    "text": "第二，呼唤温润博爱的人道主义情怀，确立平等独立的人格尊严。",
    "start": 52.506,
    "end": 64.118,
    "duration": 11.612
  },
  {
    "id": 13,
    "text": "诗群突破了阶级论对情感世界的长期压抑，在人性的真实领地中重新发现爱与温情。",
    "start": 64.796,
    "end": 69.328,
    "duration": 4.532
  },
  {
    "id": 14,
    "text": "舒婷在《致橡树》中以木棉的形象自喻，断然拒绝作为凌霄花借高枝炫耀，",
    "start": 70.006,
    "end": 72.818,
    "duration": 2.812
  },
  {
    "id": 15,
    "text": "也拒绝作为痴情鸟重复单调歌曲，而是以红硕花朵与挺拔橡树并肩挺立于风雨之中，",
    "start": 73.197,
    "end": 74.289,
    "duration": 1.092
  },
  {
    "id": 16,
    "text": "在现代抒情诗中深刻确立了男女平等独立、灵魂深层呼应的人性理想。",
    "start": 74.668,
    "end": 77.75,
    "duration": 3.082
  },
  {
    "id": 17,
    "text": "第三，打破写实线性抒情陈规，开创以隐喻象征为核心的现代主义诗性语法。",
    "start": 78.468,
    "end": 97.322,
    "duration": 18.854
  },
  {
    "id": 18,
    "text": "朦胧诗借鉴西方现代意象派与象征主义手法，大量运用意象跳跃、情绪通感与多义复调结构，",
    "start": 97.978,
    "end": 109.315,
    "duration": 11.337
  },
  {
    "id": 19,
    "text": "将主观内心情感转化为冷峻奇诡的客观对应物。",
    "start": 109.694,
    "end": 115.626,
    "duration": 5.932
  },
  {
    "id": 20,
    "text": "北岛在《回答》中以“镀金的天空”与“冰川”等并置意象寄寓荒诞现实，",
    "start": 116.155,
    "end": 121.127,
    "duration": 4.972
  },
  {
    "id": 21,
    "text": "打破了传统诗歌单一透明的语义格局，",
    "start": 121.506,
    "end": 124.638,
    "duration": 3.132
  },
  {
    "id": 22,
    "text": "在意象的多重歧义与张力碰撞中极大拓展了新诗的审美空间。",
    "start": 125.017,
    "end": 129.379,
    "duration": 4.362
  }
]