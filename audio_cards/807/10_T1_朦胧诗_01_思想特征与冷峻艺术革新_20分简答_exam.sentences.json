[
  {
    "id": 1,
    "text": "新时期之初，以北岛、舒婷、顾城为代表的朦胧诗群，",
    "start": 0.111,
    "end": 4.215,
    "duration": 4.104
  },
  {
    "id": 2,
    "text": "在现代文学史上掀起了一场震撼人心的主体复归与审美革命。",
    "start": 4.666,
    "end": 9.954,
    "duration": 5.288
  },
  {
    "id": 3,
    "text": "诗群告别了长期以来机械政治抒情的图解模式，",
    "start": 10.334,
    "end": 14.231,
    "duration": 3.897
  },
  {
    "id": 4,
    "text": "转向对个体尊严的重新确认与历史反思，",
    "start": 14.476,
    "end": 17.937,
    "duration": 3.461
  },
  {
    "id": 5,
    "text": "其思想特征与艺术革新主要表现在以下三个维度：",
    "start": 18.163,
    "end": 22.193,
    "duration": 4.03
  },
  {
    "id": 6,
    "text": "第一，确立怀疑主义理性精神，重构独立崇高的主体尊严。",
    "start": 22.893,
    "end": 27.657,
    "duration": 4.764
  },
  {
    "id": 7,
    "text": "朦胧诗坚决打破了对权威盲从的迷信思维，",
    "start": 27.78,
    "end": 30.967,
    "duration": 3.187
  },
  {
    "id": 8,
    "text": "将批判目光投向历史沉疴与群体盲从。",
    "start": 31.191,
    "end": 34.878,
    "duration": 3.687
  },
  {
    "id": 9,
    "text": "北岛在《回答》中以冷峻决绝的声调铸就了历史判词，",
    "start": 35.065,
    "end": 39.397,
    "duration": 4.332
  },
  {
    "id": 10,
    "text": "其“告诉你吧，世界 / 我——不——相——信！",
    "start": 39.491,
    "end": 43.932,
    "duration": 4.441
  },
  {
    "id": 11,
    "text": "”的震颤呼喊，以绝不妥协的傲然风骨，",
    "start": 44.177,
    "end": 47.402,
    "duration": 3.225
  },
  {
    "id": 12,
    "text": "将抒情主人公塑造成挺立于冰川与废墟之上的现代思想硬汉；",
    "start": 47.767,
    "end": 53.092,
    "duration": 5.325
  },
  {
    "id": 13,
    "text": "顾城在《一代人》中以两行极具哲学张力的诗句，",
    "start": 53.237,
    "end": 57.079,
    "duration": 3.842
  },
  {
    "id": 14,
    "text": "将经历过浩劫的一代青年对光明的执着探求凝练为集体精神图腾，",
    "start": 57.232,
    "end": 62.686,
    "duration": 5.454
  },
  {
    "id": 15,
    "text": "唤醒了青年一代的主体价值意识。",
    "start": 62.865,
    "end": 65.217,
    "duration": 2.352
  },
  {
    "id": 16,
    "text": "第二，呼唤温润博爱的人道主义情怀，确立平等独立的人格尊严。",
    "start": 65.916,
    "end": 70.774,
    "duration": 4.858
  },
  {
    "id": 17,
    "text": "诗群突破了阶级论对情感世界的长期压抑，",
    "start": 71.249,
    "end": 74.222,
    "duration": 2.973
  },
  {
    "id": 18,
    "text": "在人性的真实领地中重新发现爱与温情。",
    "start": 74.445,
    "end": 77.55,
    "duration": 3.105
  },
  {
    "id": 19,
    "text": "舒婷在《致橡树》中以木棉的形象自喻，",
    "start": 77.787,
    "end": 80.618,
    "duration": 2.831
  },
  {
    "id": 20,
    "text": "断然拒绝作为凌霄花借高枝炫耀，",
    "start": 80.994,
    "end": 83.384,
    "duration": 2.39
  },
  {
    "id": 21,
    "text": "也拒绝作为痴情鸟重复单调歌曲，",
    "start": 83.682,
    "end": 86.262,
    "duration": 2.58
  },
  {
    "id": 22,
    "text": "而是以红硕花朵与挺拔橡树并肩挺立于风雨之中，",
    "start": 86.605,
    "end": 90.663,
    "duration": 4.058
  },
  {
    "id": 23,
    "text": "在现代抒情诗中深刻确立了男女平等独立、",
    "start": 90.835,
    "end": 94.272,
    "duration": 3.437
  },
  {
    "id": 24,
    "text": "灵魂深层呼应的人性理想。",
    "start": 94.532,
    "end": 96.416,
    "duration": 1.884
  },
  {
    "id": 25,
    "text": "第三，打破写实线性抒情陈规，",
    "start": 97.099,
    "end": 99.958,
    "duration": 2.859
  },
  {
    "id": 26,
    "text": "开创以隐喻象征为核心的现代主义诗性语法。",
    "start": 100.384,
    "end": 103.801,
    "duration": 3.417
  },
  {
    "id": 27,
    "text": "朦胧诗借鉴西方现代意象派与象征主义手法，",
    "start": 104.372,
    "end": 107.599,
    "duration": 3.227
  },
  {
    "id": 28,
    "text": "大量运用意象跳跃、情绪通感与多义复调结构，",
    "start": 108.018,
    "end": 111.849,
    "duration": 3.831
  },
  {
    "id": 29,
    "text": "将主观内心情感转化为冷峻奇诡的客观对应物。",
    "start": 112.064,
    "end": 116.028,
    "duration": 3.964
  },
  {
    "id": 30,
    "text": "北岛在《回答》中以“镀金的天空”与“冰川”等并置意象寄寓荒诞现实，",
    "start": 116.231,
    "end": 121.579,
    "duration": 5.348
  },
  {
    "id": 31,
    "text": "打破了传统诗歌单一透明的语义格局，",
    "start": 121.899,
    "end": 124.603,
    "duration": 2.704
  },
  {
    "id": 32,
    "text": "在意象的多重歧义与张力碰撞中极大拓展了新诗的审美空间。",
    "start": 124.893,
    "end": 129.641,
    "duration": 4.748
  }
]