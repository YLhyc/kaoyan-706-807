[
  {
    "id": 1,
    "text": "新时期之初，以北岛、舒婷、顾城为代表的朦胧诗群，",
    "start": 0.0,
    "end": 4.694,
    "duration": 4.694
  },
  {
    "id": 2,
    "text": "在现代文学史上掀起了一场震撼人心的主体复归与审美革命。",
    "start": 4.694,
    "end": 10.359,
    "duration": 5.665
  },
  {
    "id": 3,
    "text": "诗群告别了长期以来机械政治抒情的图解模式，",
    "start": 10.359,
    "end": 14.501,
    "duration": 4.142
  },
  {
    "id": 4,
    "text": "转向对个体尊严的重新确认与历史反思，",
    "start": 14.501,
    "end": 17.001,
    "duration": 2.5
  },
  {
    "id": 5,
    "text": "其思想特征与艺术革新主要表现在以下三个维度：",
    "start": 17.001,
    "end": 22.534,
    "duration": 5.533
  },
  {
    "id": 6,
    "text": "第一，确立怀疑主义理性精神，重构独立崇高的主体尊严。",
    "start": 22.534,
    "end": 25.297,
    "duration": 2.763
  },
  {
    "id": 7,
    "text": "朦胧诗坚决打破了对权威盲从的迷信思维，",
    "start": 25.297,
    "end": 30.832,
    "duration": 5.535
  },
  {
    "id": 8,
    "text": "将批判目光投向历史沉疴与群体盲从。",
    "start": 30.832,
    "end": 34.706,
    "duration": 3.874
  },
  {
    "id": 9,
    "text": "北岛在《回答》中以冷峻决绝的声调铸就了历史判词，",
    "start": 34.706,
    "end": 39.692,
    "duration": 4.986
  },
  {
    "id": 10,
    "text": "其“告诉你吧，世界 / 我——不——相——信！",
    "start": 39.692,
    "end": 43.808,
    "duration": 4.116
  },
  {
    "id": 11,
    "text": "”的震颤呼喊，",
    "start": 43.808,
    "end": 45.12,
    "duration": 1.312
  },
  {
    "id": 12,
    "text": "以纵使面对千百个侵凌者也绝不妥协的傲然风骨，",
    "start": 45.12,
    "end": 49.266,
    "duration": 4.146
  },
  {
    "id": 13,
    "text": "将抒情主人公塑造成挺立于冰川与废墟之上的现代思想硬汉；",
    "start": 49.266,
    "end": 55.113,
    "duration": 5.847
  },
  {
    "id": 14,
    "text": "顾城在《一代人》中以两行极具哲学张力的诗句，",
    "start": 55.113,
    "end": 58.81,
    "duration": 3.697
  },
  {
    "id": 15,
    "text": "将经历过浩劫的一代青年对光明的执着探求凝练为集体精神图腾，",
    "start": 58.81,
    "end": 64.874,
    "duration": 6.064
  },
  {
    "id": 16,
    "text": "实现了生命本体价值的觉醒。",
    "start": 64.874,
    "end": 67.181,
    "duration": 2.307
  },
  {
    "id": 17,
    "text": "第二，呼唤温润博爱的人道主义情怀，确立平等独立的人格尊严。",
    "start": 67.181,
    "end": 72.682,
    "duration": 5.501
  },
  {
    "id": 18,
    "text": "诗群突破了阶级论对情感世界的长期压抑，",
    "start": 72.682,
    "end": 76.316,
    "duration": 3.634
  },
  {
    "id": 19,
    "text": "在人性的真实领地中重新发现爱与温情。",
    "start": 76.316,
    "end": 79.99,
    "duration": 3.674
  },
  {
    "id": 20,
    "text": "舒婷在《致橡树》中以木棉的形象自喻，",
    "start": 79.99,
    "end": 83.196,
    "duration": 3.206
  },
  {
    "id": 21,
    "text": "断然拒绝作为凌霄花借高枝炫耀，",
    "start": 83.196,
    "end": 86.39,
    "duration": 3.194
  },
  {
    "id": 22,
    "text": "也拒绝作为痴情鸟重复单调歌曲，",
    "start": 86.39,
    "end": 89.316,
    "duration": 2.926
  },
  {
    "id": 23,
    "text": "而是以红硕花朵与挺拔橡树并肩挺立于风雨之中，",
    "start": 89.316,
    "end": 93.893,
    "duration": 4.577
  },
  {
    "id": 24,
    "text": "在现代抒情诗中深刻确立了男女平等独立、",
    "start": 93.893,
    "end": 97.53,
    "duration": 3.637
  },
  {
    "id": 25,
    "text": "灵魂深层呼应的人性理想。",
    "start": 97.53,
    "end": 100.324,
    "duration": 2.794
  },
  {
    "id": 26,
    "text": "第三，打破写实线性抒情陈规，",
    "start": 100.324,
    "end": 102.773,
    "duration": 2.449
  },
  {
    "id": 27,
    "text": "开创以隐喻象征为核心的现代主义诗性语法。",
    "start": 102.773,
    "end": 107.05,
    "duration": 4.277
  },
  {
    "id": 28,
    "text": "朦胧诗借鉴西方现代意象派与象征主义手法，",
    "start": 107.05,
    "end": 111.145,
    "duration": 4.095
  },
  {
    "id": 29,
    "text": "大量运用意象跳跃、情绪通感与多义复调结构，",
    "start": 111.145,
    "end": 115.53,
    "duration": 4.385
  },
  {
    "id": 30,
    "text": "将主观内心情感转化为冷峻奇诡的客观对应物。",
    "start": 115.53,
    "end": 119.884,
    "duration": 4.354
  },
  {
    "id": 31,
    "text": "北岛以“镀金的避雷针”与“无花的蔷薇”寄寓荒诞现实，",
    "start": 119.884,
    "end": 124.483,
    "duration": 4.599
  },
  {
    "id": 32,
    "text": "打破了传统诗歌明晰单一的语义闭环，",
    "start": 124.483,
    "end": 127.644,
    "duration": 3.161
  },
  {
    "id": 33,
    "text": "在意象的多重歧义与张力碰撞中极大拓展了新诗的审美空间。",
    "start": 127.644,
    "end": 132.768,
    "duration": 5.124
  }
]