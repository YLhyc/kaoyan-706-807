[
  {
    "id": 1,
    "text": "新时期之初，以北岛、舒婷、顾城为代表的朦胧诗群，",
    "start": 0.089,
    "end": 4.257,
    "duration": 4.168
  },
  {
    "id": 2,
    "text": "在现代文学史上掀起了一场震撼人心的主体复归与审美革命。",
    "start": 4.651,
    "end": 9.995,
    "duration": 5.344
  },
  {
    "id": 3,
    "text": "诗群告别了长期以来机械政治抒情的图解模式，",
    "start": 10.314,
    "end": 14.271,
    "duration": 3.957
  },
  {
    "id": 4,
    "text": "转向对个体尊严的重新确认与历史反思，",
    "start": 14.461,
    "end": 17.98,
    "duration": 3.519
  },
  {
    "id": 5,
    "text": "其思想特征与艺术革新主要表现在以下三个维度：",
    "start": 18.148,
    "end": 22.258,
    "duration": 4.11
  },
  {
    "id": 6,
    "text": "第一，确立怀疑主义理性精神，重构独立崇高的主体尊严。",
    "start": 22.494,
    "end": 27.313,
    "duration": 4.819
  },
  {
    "id": 7,
    "text": "朦胧诗坚决打破了对权威盲从的迷信思维，",
    "start": 27.381,
    "end": 30.935,
    "duration": 3.554
  },
  {
    "id": 8,
    "text": "将批判目光投向历史沉疴与群体盲从。",
    "start": 31.016,
    "end": 34.534,
    "duration": 3.518
  },
  {
    "id": 9,
    "text": "北岛在《回答》中以冷峻决绝的声调铸就了历史判词，",
    "start": 34.666,
    "end": 39.053,
    "duration": 4.387
  },
  {
    "id": 10,
    "text": "其“告诉你吧，世界 / 我——不——相——信！",
    "start": 39.092,
    "end": 43.182,
    "duration": 4.09
  },
  {
    "id": 11,
    "text": "”的震颤呼喊，",
    "start": 43.242,
    "end": 44.667,
    "duration": 1.425
  },
  {
    "id": 12,
    "text": "以纵使面对千百个侵凌者也绝不妥协的傲然风骨，",
    "start": 45.08,
    "end": 49.097,
    "duration": 4.017
  },
  {
    "id": 13,
    "text": "将抒情主人公塑造成挺立于冰川与废墟之上的现代思想硬汉；",
    "start": 49.226,
    "end": 54.828,
    "duration": 5.602
  },
  {
    "id": 14,
    "text": "顾城在《一代人》中以两行极具哲学张力的诗句，",
    "start": 55.073,
    "end": 58.941,
    "duration": 3.868
  },
  {
    "id": 15,
    "text": "将经历过浩劫的一代青年对光明的执着探求凝练为集体精神图腾，",
    "start": 58.941,
    "end": 64.499,
    "duration": 5.558
  },
  {
    "id": 16,
    "text": "实现了生命本体价值的觉醒。",
    "start": 64.834,
    "end": 66.955,
    "duration": 2.121
  },
  {
    "id": 17,
    "text": "第二，呼唤温润博爱的人道主义情怀，确立平等独立的人格尊严。",
    "start": 67.141,
    "end": 72.186,
    "duration": 5.045
  },
  {
    "id": 18,
    "text": "诗群突破了阶级论对情感世界的长期压抑，",
    "start": 72.64,
    "end": 75.983,
    "duration": 3.343
  },
  {
    "id": 19,
    "text": "在人性的真实领地中重新发现爱与温情。",
    "start": 76.276,
    "end": 79.872,
    "duration": 3.596
  },
  {
    "id": 20,
    "text": "舒婷在《致橡树》中以木棉的形象自喻，",
    "start": 79.944,
    "end": 82.842,
    "duration": 2.898
  },
  {
    "id": 21,
    "text": "断然拒绝作为凌霄花借高枝炫耀，",
    "start": 83.156,
    "end": 86.037,
    "duration": 2.881
  },
  {
    "id": 22,
    "text": "也拒绝作为痴情鸟重复单调歌曲，",
    "start": 86.35,
    "end": 88.764,
    "duration": 2.414
  },
  {
    "id": 23,
    "text": "而是以红硕花朵与挺拔橡树并肩挺立于风雨之中，",
    "start": 89.272,
    "end": 93.413,
    "duration": 4.141
  },
  {
    "id": 24,
    "text": "在现代抒情诗中深刻确立了男女平等独立、",
    "start": 93.852,
    "end": 97.285,
    "duration": 3.433
  },
  {
    "id": 25,
    "text": "灵魂深层呼应的人性理想。",
    "start": 97.49,
    "end": 99.508,
    "duration": 2.018
  },
  {
    "id": 26,
    "text": "第三，打破写实线性抒情陈规，",
    "start": 99.699,
    "end": 102.45,
    "duration": 2.751
  },
  {
    "id": 27,
    "text": "开创以隐喻象征为核心的现代主义诗性语法。",
    "start": 102.719,
    "end": 106.587,
    "duration": 3.868
  },
  {
    "id": 28,
    "text": "朦胧诗借鉴西方现代意象派与象征主义手法，",
    "start": 107.01,
    "end": 110.705,
    "duration": 3.695
  },
  {
    "id": 29,
    "text": "大量运用意象跳跃、情绪通感与多义复调结构，",
    "start": 111.105,
    "end": 115.068,
    "duration": 3.963
  },
  {
    "id": 30,
    "text": "将主观内心情感转化为冷峻奇诡的客观对应物。",
    "start": 115.488,
    "end": 119.587,
    "duration": 4.099
  },
  {
    "id": 31,
    "text": "北岛以“镀金的避雷针”与“无花的蔷薇”寄寓荒诞现实，",
    "start": 119.842,
    "end": 124.128,
    "duration": 4.286
  },
  {
    "id": 32,
    "text": "打破了传统诗歌明晰单一的语义闭环，",
    "start": 124.443,
    "end": 127.288,
    "duration": 2.845
  },
  {
    "id": 33,
    "text": "在意象的多重歧义与张力碰撞中极大拓展了新诗的审美空间。",
    "start": 127.602,
    "end": 132.768,
    "duration": 5.166
  }
]
