[
  {
    "id": 1,
    "text": "新时期之初，以北岛、舒婷、顾城为代表的朦胧诗群，",
    "start": 0.16,
    "end": 5.36,
    "duration": 5.2
  },
  {
    "id": 2,
    "text": "在现代文学史上掀起了一场震撼人心的主体复归与审美革命。",
    "start": 5.36,
    "end": 11.28,
    "duration": 5.92
  },
  {
    "id": 3,
    "text": "诗群告别了长期以来机械政治抒情的图解模式，",
    "start": 11.28,
    "end": 15.52,
    "duration": 4.24
  },
  {
    "id": 4,
    "text": "转向对个体尊严的重新确认与历史反思，",
    "start": 15.52,
    "end": 19.68,
    "duration": 4.16
  },
  {
    "id": 5,
    "text": "其思想特征与艺术革新主要表现在以下三个维度：",
    "start": 19.68,
    "end": 24.16,
    "duration": 4.48
  },
  {
    "id": 6,
    "text": "第一，确立怀疑主义理性精神，重构独立崇高的主体尊严。",
    "start": 24.16,
    "end": 29.28,
    "duration": 5.12
  },
  {
    "id": 7,
    "text": "朦胧诗坚决打破了对权威盲从的迷信思维，",
    "start": 29.28,
    "end": 33.6,
    "duration": 4.32
  },
  {
    "id": 8,
    "text": "将批判目光投向历史沉疴与群体盲从。",
    "start": 33.6,
    "end": 37.28,
    "duration": 3.68
  },
  {
    "id": 9,
    "text": "北岛在《回答》中以冷峻决绝的声调铸就了历史判词，",
    "start": 37.28,
    "end": 44.64,
    "duration": 7.36
  },
  {
    "id": 10,
    "text": "其“告诉你吧，世界 / 我——不——相——信！",
    "start": 44.96,
    "end": 49.04,
    "duration": 4.08
  },
  {
    "id": 11,
    "text": "”的震颤呼喊，",
    "start": 49.28,
    "end": 50.8,
    "duration": 1.52
  },
  {
    "id": 12,
    "text": "以纵使面对千百个侵凌者也绝不妥协的傲然风骨，",
    "start": 50.8,
    "end": 55.2,
    "duration": 4.4
  },
  {
    "id": 13,
    "text": "将抒情主人公塑造成挺立于冰川与废墟之上的现代思想硬汉；",
    "start": 55.2,
    "end": 60.4,
    "duration": 5.2
  },
  {
    "id": 14,
    "text": "顾城在《一代人》中以两行极具哲学张力的诗句，",
    "start": 60.4,
    "end": 65.28,
    "duration": 4.88
  },
  {
    "id": 15,
    "text": "将经历过浩劫的一代青年对光明的执着探求凝练为集体精神图腾，",
    "start": 65.28,
    "end": 71.2,
    "duration": 5.92
  },
  {
    "id": 16,
    "text": "实现了生命本体价值的觉醒。",
    "start": 71.2,
    "end": 73.84,
    "duration": 2.64
  },
  {
    "id": 17,
    "text": "第二，呼唤温润博爱的人道主义情怀，确立平等独立的人格尊严。",
    "start": 73.84,
    "end": 80.16,
    "duration": 6.32
  },
  {
    "id": 18,
    "text": "诗群突破了阶级论对情感世界的长期压抑，",
    "start": 80.16,
    "end": 84.04,
    "duration": 3.88
  },
  {
    "id": 19,
    "text": "在人性的真实领地中重新发现爱与温情。",
    "start": 84.04,
    "end": 87.84,
    "duration": 3.8
  },
  {
    "id": 20,
    "text": "舒婷在《致橡树》中以木棉的形象自喻，",
    "start": 87.84,
    "end": 91.84,
    "duration": 4.0
  },
  {
    "id": 21,
    "text": "断然拒绝作为凌霄花借高枝炫耀，",
    "start": 91.84,
    "end": 95.04,
    "duration": 3.2
  },
  {
    "id": 22,
    "text": "也拒绝作为痴情鸟重复单调歌曲，",
    "start": 95.12,
    "end": 98.24,
    "duration": 3.12
  },
  {
    "id": 23,
    "text": "而是以红硕花朵与挺拔橡树并肩挺立于风雨之中，",
    "start": 98.24,
    "end": 103.52,
    "duration": 5.28
  },
  {
    "id": 24,
    "text": "在现代抒情诗中深刻确立了男女平等独立、",
    "start": 103.52,
    "end": 107.12,
    "duration": 3.6
  },
  {
    "id": 25,
    "text": "灵魂深层呼应的人性理想。",
    "start": 107.12,
    "end": 109.6,
    "duration": 2.48
  },
  {
    "id": 26,
    "text": "第三，打破写实线性抒情陈规，",
    "start": 109.6,
    "end": 112.48,
    "duration": 2.88
  },
  {
    "id": 27,
    "text": "开创以隐喻象征为核心的现代主义诗性语法。",
    "start": 112.72,
    "end": 117.44,
    "duration": 4.72
  },
  {
    "id": 28,
    "text": "朦胧诗借鉴西方现代意象派与象征主义手法，",
    "start": 117.44,
    "end": 121.28,
    "duration": 3.84
  },
  {
    "id": 29,
    "text": "大量运用意象跳跃、情绪通感与多义复调结构，",
    "start": 121.28,
    "end": 125.92,
    "duration": 4.64
  },
  {
    "id": 30,
    "text": "将主观内心情感转化为冷峻奇诡的客观对应物。",
    "start": 125.92,
    "end": 130.0,
    "duration": 4.08
  },
  {
    "id": 31,
    "text": "北岛以“镀金的避雷针”与“无花的蔷薇”寄寓荒诞现实，",
    "start": 130.0,
    "end": 132.56,
    "duration": 2.56
  },
  {
    "id": 32,
    "text": "打破了传统诗歌明晰单一的语义闭环，",
    "start": 132.32,
    "end": 132.56,
    "duration": 0.24
  },
  {
    "id": 33,
    "text": "在意象的多重歧义与张力碰撞中极大拓展了新诗的审美空间。",
    "start": 132.32,
    "end": 132.56,
    "duration": 0.24
  }
]