[
  {
    "id": 1,
    "text": "一、全题宏观总揽（四问四答）。",
    "start": 0.08,
    "end": 3.2,
    "duration": 3.12
  },
  {
    "id": 2,
    "text": "一、第一问：这道题到底要回答什么？",
    "start": 3.2,
    "end": 6.16,
    "duration": 2.96
  },
  {
    "id": 3,
    "text": "这道题是西华师大、二零二三年、八零七、",
    "start": 6.32,
    "end": 9.68,
    "duration": 3.36
  },
  {
    "id": 4,
    "text": "大题真题。",
    "start": 9.68,
    "end": 10.8,
    "duration": 1.12
  },
  {
    "id": 5,
    "text": "考查现代自由新诗宗师艾青。",
    "start": 10.8,
    "end": 13.36,
    "duration": 2.56
  },
  {
    "id": 6,
    "text": "在考场上，考生不能简单只背诵《我爱这土地》的诗句，",
    "start": 13.36,
    "end": 17.84,
    "duration": 4.48
  },
  {
    "id": 7,
    "text": "而必须紧扣“土地与太阳意象群”、",
    "start": 17.84,
    "end": 20.88,
    "duration": 3.04
  },
  {
    "id": 8,
    "text": "“忧郁情思的机制”与“自由诗体文体革新”三大命题。",
    "start": 20.88,
    "end": 25.2,
    "duration": 4.32
  },
  {
    "id": 9,
    "text": "核心在于回答：这两个意象如何互为表里，",
    "start": 25.52,
    "end": 29.28,
    "duration": 3.76
  },
  {
    "id": 10,
    "text": "艾青的“忧郁”为何具有人民性，以及自由体新诗如何实现形式突破。",
    "start": 29.28,
    "end": 34.96,
    "duration": 5.68
  },
  {
    "id": 11,
    "text": "二、第二问：应该从什么方向回答？",
    "start": 34.96,
    "end": 37.92,
    "duration": 2.96
  },
  {
    "id": 12,
    "text": "答题必须确立“意象图谱（土地与太阳）趋近于、",
    "start": 37.92,
    "end": 42.12,
    "duration": 4.2
  },
  {
    "id": 13,
    "text": "情感内核（忧郁与悲敏）趋近于、形式美学（散文化自由诗与绘画美）”的三维递进框架。",
    "start": 42.12,
    "end": 50.48,
    "duration": 8.36
  },
  {
    "id": 14,
    "text": "先解剖苦难土地与光明太阳的辩证张力，",
    "start": 50.64,
    "end": 54.4,
    "duration": 3.76
  },
  {
    "id": 15,
    "text": "次深入剖析常含泪水的忧郁非个人感伤而是民族大爱，",
    "start": 54.4,
    "end": 59.28,
    "duration": 4.88
  },
  {
    "id": 16,
    "text": "最后分析打破格律镣靠的口语自由诗创新。",
    "start": 59.28,
    "end": 63.12,
    "duration": 3.84
  },
  {
    "id": 17,
    "text": "三、第三问：从哪些方面展开论述？",
    "start": 63.12,
    "end": 66.08,
    "duration": 2.96
  },
  {
    "id": 18,
    "text": "全题分为四个核心论述维度：第一维度：界定艾青作为“吹号者”与现代自由新诗宗师的文学史坐标；",
    "start": 66.08,
    "end": 74.32,
    "duration": 8.24
  },
  {
    "id": 19,
    "text": "-第二维度：深入剖析“土地”（苦难、",
    "start": 74.48,
    "end": 77.249,
    "duration": 2.769
  },
  {
    "id": 20,
    "text": "母体）与“太阳”（光明、新生）双重核心意象群的辩证统一；",
    "start": 77.249,
    "end": 82.095,
    "duration": 4.846
  },
  {
    "id": 21,
    "text": "-第三维度：深刻论述“深沉忧郁”情思的民族苦难根源与“眼里常含泪水”的崇高担当；",
    "start": 82.095,
    "end": 89.711,
    "duration": 7.616
  },
  {
    "id": 22,
    "text": "-第四维度：精细剖析打破格律束缚、",
    "start": 89.711,
    "end": 92.942,
    "duration": 3.231
  },
  {
    "id": 23,
    "text": "追求情绪律动、融合散文美与绘画造型感的自由诗体艺术；",
    "start": 92.942,
    "end": 98.48,
    "duration": 5.538
  },
  {
    "id": 24,
    "text": "第五维度：宏观总结艾青对现代现实主义新诗传统的定海神针价值。",
    "start": 98.56,
    "end": 103.92,
    "duration": 5.36
  },
  {
    "id": 25,
    "text": "四、第四问：这些方面之间的内在逻辑是什么？",
    "start": 103.92,
    "end": 107.04,
    "duration": 3.12
  },
  {
    "id": 26,
    "text": "全题逻辑严密咬合：第一步先确立人民诗人的崇高地位。",
    "start": 107.04,
    "end": 110.96,
    "duration": 3.92
  },
  {
    "id": 27,
    "text": "第二步剖析艾青最核心的艺术符号，",
    "start": 110.96,
    "end": 113.6,
    "duration": 2.64
  },
  {
    "id": 28,
    "text": "即土地与太阳的双峰对峙。",
    "start": 113.6,
    "end": 115.6,
    "duration": 2.0
  },
  {
    "id": 29,
    "text": "第三步探究驱动这些意象的情感血液，",
    "start": 115.84,
    "end": 119.12,
    "duration": 3.28
  },
  {
    "id": 30,
    "text": "即大爱深沉的忧郁情思。",
    "start": 119.12,
    "end": 121.6,
    "duration": 2.48
  },
  {
    "id": 31,
    "text": "第四步剖析承载这种宏大情感的新诗形式创新。",
    "start": 121.6,
    "end": 125.92,
    "duration": 4.32
  },
  {
    "id": 32,
    "text": "第五步完成宏观历史论证闭环。",
    "start": 125.92,
    "end": 129.12,
    "duration": 3.2
  },
  {
    "id": 33,
    "text": "二、各板块逐句咬合演练。",
    "start": 129.12,
    "end": 131.68,
    "duration": 2.56
  },
  {
    "id": 34,
    "text": "一、开头破题段内部咬合。",
    "start": 131.68,
    "end": 134.32,
    "duration": 2.64
  },
  {
    "id": 35,
    "text": "本段旨在开门见山确立自由新诗宗师的立论基石。",
    "start": 134.32,
    "end": 138.48,
    "duration": 4.16
  },
  {
    "id": 36,
    "text": "首句直切经典地位，次句交代土地与太阳两大意象融铸民族解放。",
    "start": 138.88,
    "end": 144.0,
    "duration": 5.12
  },
  {
    "id": 37,
    "text": "-首先，首句必须直接亮出该作在现代诗歌史上的崇高地位，",
    "start": 144.288,
    "end": 149.021,
    "duration": 4.733
  },
  {
    "id": 38,
    "text": "具体表述到答题语句就是：艾青是中国现代新诗发展史上矗立的一座巍峨丰碑，",
    "start": 149.021,
    "end": 155.528,
    "duration": 6.507
  },
  {
    "id": 39,
    "text": "被誉为“吹号者”与真正属于人民的伟大抒情诗人。",
    "start": 155.528,
    "end": 159.472,
    "duration": 3.944
  },
  {
    "id": 40,
    "text": "有了经典定性之后，次句必须迅速说明其意象体系与美学新境，",
    "start": 159.472,
    "end": 164.599,
    "duration": 5.127
  },
  {
    "id": 41,
    "text": "具体表述到答题语句就是：艾青以其敏锐的时代触觉与炽热的赤子之心，",
    "start": 164.599,
    "end": 170.515,
    "duration": 5.916
  },
  {
    "id": 42,
    "text": "通过贯穿创作始终的“土地”与“太阳”两大核心意象，",
    "start": 170.515,
    "end": 174.459,
    "duration": 3.944
  },
  {
    "id": 43,
    "text": "将现代知识分子的个体生命彻底融入受难民族的解放洪流之中，",
    "start": 174.459,
    "end": 179.783,
    "duration": 5.324
  },
  {
    "id": 44,
    "text": "开创了现代自由新诗沉雄质朴、博大深沉的全新美学境界。，",
    "start": 179.783,
    "end": 184.515,
    "duration": 4.732
  },
  {
    "id": 45,
    "text": "这句话直接铺陈出意象、情感与形式三维展开的论证骨架。",
    "start": 184.515,
    "end": 189.248,
    "duration": 4.733
  },
  {
    "id": 46,
    "text": "艾青是中国现代新诗发展史上矗立的一座巍峨丰碑，",
    "start": 189.328,
    "end": 193.648,
    "duration": 4.32
  },
  {
    "id": 47,
    "text": "被誉为“吹号者”与真正属于人民的伟大抒情诗人。",
    "start": 193.648,
    "end": 197.728,
    "duration": 4.08
  },
  {
    "id": 48,
    "text": "艾青以其敏锐的时代触觉与炽热的赤子之心，",
    "start": 197.728,
    "end": 201.808,
    "duration": 4.08
  },
  {
    "id": 49,
    "text": "通过贯穿创作始终的“土地”与“太阳”两大核心意象，",
    "start": 201.808,
    "end": 206.128,
    "duration": 4.32
  },
  {
    "id": 50,
    "text": "将现代知识分子的个体生命彻底融入受难民族的解放洪流之中，",
    "start": 206.128,
    "end": 211.248,
    "duration": 5.12
  },
  {
    "id": 51,
    "text": "开创了现代自由新诗沉雄质朴、博大深沉的全新美学境界。",
    "start": 211.248,
    "end": 216.288,
    "duration": 5.04
  },
  {
    "id": 52,
    "text": "二、第一维度：“土地”与“太阳”核心意象群剖析内部咬合。",
    "start": 216.608,
    "end": 221.648,
    "duration": 5.04
  },
  {
    "id": 53,
    "text": "本段任务是深入剖析土地的苦难母体象征与太阳的光明新生象征，",
    "start": 221.648,
    "end": 227.008,
    "duration": 5.36
  },
  {
    "id": 54,
    "text": "调取《我爱这土地》《大堰河》与《向太阳》。",
    "start": 227.008,
    "end": 230.688,
    "duration": 3.68
  },
  {
    "id": 55,
    "text": "首先，段首给出结论先行的分论点，",
    "start": 230.688,
    "end": 233.488,
    "duration": 2.8
  },
  {
    "id": 56,
    "text": "具体表述到答题语句就是：第一，在核心意象系统上，",
    "start": 233.488,
    "end": 237.888,
    "duration": 4.4
  },
  {
    "id": 57,
    "text": "艾青营构了“土地”与“太阳”相互对应又辩证统一的象征图谱，",
    "start": 237.888,
    "end": 242.368,
    "duration": 4.48
  },
  {
    "id": 58,
    "text": "形成了震撼人心的审美张力。",
    "start": 242.368,
    "end": 244.368,
    "duration": 2.0
  },
  {
    "id": 59,
    "text": "-随后，剖析“土地”意象的苦难与祖国象征，",
    "start": 244.528,
    "end": 247.721,
    "duration": 3.193
  },
  {
    "id": 60,
    "text": "具体表述到答题语句就是：“土地”是艾青诗歌中最厚重、",
    "start": 247.721,
    "end": 252.111,
    "duration": 4.39
  },
  {
    "id": 61,
    "text": "最深沉的基底意象。",
    "start": 252.111,
    "end": 253.707,
    "duration": 1.596
  },
  {
    "id": 62,
    "text": "在诗人笔下，土地不仅是祖先生息繁衍的物理疆域，",
    "start": 253.707,
    "end": 257.898,
    "duration": 4.191
  },
  {
    "id": 63,
    "text": "更是饱受外敌践踏、内乱摧残的苦难民族之生动写照。",
    "start": 257.898,
    "end": 262.288,
    "duration": 4.39
  },
  {
    "id": 64,
    "text": "-紧接着，调取《我爱这土地》嘶哑歌唱鸟的细节：在抗战爆发时期的名作《我爱这土地》中，",
    "start": 262.288,
    "end": 269.524,
    "duration": 7.236
  },
  {
    "id": 65,
    "text": "诗人借一只嘶哑歌唱的鸟的意象，高吟“假如我是一只鸟，",
    "start": 269.524,
    "end": 274.418,
    "duration": 4.894
  },
  {
    "id": 66,
    "text": "我也应该用嘶哑的喉龙歌唱：这被暴风雨所打击着的土地”，",
    "start": 274.418,
    "end": 279.526,
    "duration": 5.108
  },
  {
    "id": 67,
    "text": "将对大地的深情与对民族危亡的肉体痛感紧密相连。",
    "start": 279.526,
    "end": 284.208,
    "duration": 4.682
  },
  {
    "id": 68,
    "text": "随后，调取《大堰河》中土地与乳母的融合：其成名作《大堰河，",
    "start": 284.416,
    "end": 289.616,
    "duration": 5.2
  },
  {
    "id": 69,
    "text": "我的保姆》中，更是将土地的母性与底层保姆大堰河的勤劳、",
    "start": 289.616,
    "end": 294.496,
    "duration": 4.88
  },
  {
    "id": 70,
    "text": "屈辱与牺牲熔铸一炉，饱含着对底层劳动人民的无限眷恋。",
    "start": 294.496,
    "end": 300.256,
    "duration": 5.76
  },
  {
    "id": 71,
    "text": "最后，推进到“太阳”的互补与升华，",
    "start": 300.256,
    "end": 303.456,
    "duration": 3.2
  },
  {
    "id": 72,
    "text": "具体表述到答题语句就是：而“太阳”（以及火炬、",
    "start": 303.456,
    "end": 307.696,
    "duration": 4.24
  },
  {
    "id": 73,
    "text": "黎明）则是与“土地”相生相依的彼岸意象，",
    "start": 307.696,
    "end": 311.456,
    "duration": 3.76
  },
  {
    "id": 74,
    "text": "象征着对光明、自由、真理与民族新生的炽烈渴望。",
    "start": 311.456,
    "end": 316.256,
    "duration": 4.8
  },
  {
    "id": 75,
    "text": "在长诗《向太阳》与《黎明的通知》中，",
    "start": 316.496,
    "end": 320.096,
    "duration": 3.6
  },
  {
    "id": 76,
    "text": "诗人以极其明朗亢奋的语调，呼唤太阳驱散古老土地上的阴霾，",
    "start": 320.096,
    "end": 325.456,
    "duration": 5.36
  },
  {
    "id": 77,
    "text": "形成了苦难与光明交相辉映的宏大艺术格局。",
    "start": 325.456,
    "end": 329.536,
    "duration": 4.08
  },
  {
    "id": 78,
    "text": "第一，在核心意象系统上，艾青营构了“土地”与“太阳”相互对应又辩证统一的象征图谱，",
    "start": 329.536,
    "end": 337.296,
    "duration": 7.76
  },
  {
    "id": 79,
    "text": "形成了震撼人心的审美张力。",
    "start": 337.296,
    "end": 339.296,
    "duration": 2.0
  },
  {
    "id": 80,
    "text": "“土地”是艾青诗歌中最厚重、最深沉的基底意象。",
    "start": 339.456,
    "end": 343.468,
    "duration": 4.012
  },
  {
    "id": 81,
    "text": "在诗人笔下，土地不仅是祖先生息繁衍的物理疆域，",
    "start": 343.468,
    "end": 347.902,
    "duration": 4.434
  },
  {
    "id": 82,
    "text": "更是饱受外敌践踏、内乱摧残的苦难民族之生动写照。",
    "start": 347.902,
    "end": 352.548,
    "duration": 4.646
  },
  {
    "id": 83,
    "text": "在抗战爆发时期的名作《我爱这土地》中，",
    "start": 352.548,
    "end": 355.926,
    "duration": 3.378
  },
  {
    "id": 84,
    "text": "诗人借一只嘶哑歌唱的鸟的意象，高吟“假如我是一只鸟，",
    "start": 355.926,
    "end": 360.783,
    "duration": 4.857
  },
  {
    "id": 85,
    "text": "我也应该用嘶哑的喉龙歌唱：这被暴风雨所打击着的土地”，",
    "start": 360.783,
    "end": 365.851,
    "duration": 5.068
  },
  {
    "id": 86,
    "text": "将对大地的深情与对民族危亡的肉体痛感紧密相连。",
    "start": 365.851,
    "end": 370.496,
    "duration": 4.645
  },
  {
    "id": 87,
    "text": "其成名作《大堰河，我的保姆》中，",
    "start": 370.656,
    "end": 373.456,
    "duration": 2.8
  },
  {
    "id": 88,
    "text": "更是将土地的母性与底层保姆大堰河的勤劳、",
    "start": 373.456,
    "end": 377.296,
    "duration": 3.84
  },
  {
    "id": 89,
    "text": "屈辱与牺牲熔铸一炉，饱含着对底层劳动人民的无限眷恋。",
    "start": 377.296,
    "end": 382.496,
    "duration": 5.2
  },
  {
    "id": 90,
    "text": "而“太阳”（以及火炬、黎明）则是与“土地”相生相依的彼岸意象，",
    "start": 382.496,
    "end": 387.616,
    "duration": 5.12
  },
  {
    "id": 91,
    "text": "象征着对光明、自由、真理与民族新生的炽烈渴望。",
    "start": 387.616,
    "end": 392.176,
    "duration": 4.56
  },
  {
    "id": 92,
    "text": "在长诗《向太阳》与《黎明的通知》中，",
    "start": 392.496,
    "end": 395.456,
    "duration": 2.96
  },
  {
    "id": 93,
    "text": "诗人以极其明朗亢奋的语调，呼唤太阳驱散古老土地上的阴霾，",
    "start": 395.456,
    "end": 401.056,
    "duration": 5.6
  },
  {
    "id": 94,
    "text": "形成了苦难与光明交相辉映的宏大艺术格局。",
    "start": 401.056,
    "end": 405.616,
    "duration": 4.56
  },
  {
    "id": 95,
    "text": "三、第二维度：深沉忧郁情思与民族悲敏机制内部咬合。",
    "start": 405.616,
    "end": 411.136,
    "duration": 5.52
  },
  {
    "id": 96,
    "text": "本段任务是深入剖析“忧郁底色”的非颓废本质，",
    "start": 411.136,
    "end": 415.056,
    "duration": 3.92
  },
  {
    "id": 97,
    "text": "结合《北方》与眼里常含泪水名句。",
    "start": 415.056,
    "end": 417.776,
    "duration": 2.72
  },
  {
    "id": 98,
    "text": "-首先，段首给出统领分论点，具体表述到答题语句就是：第二，",
    "start": 418.08,
    "end": 423.335,
    "duration": 5.255
  },
  {
    "id": 99,
    "text": "在情感品格机制上，艾青诗歌充溢着一种博大深沉、",
    "start": 423.335,
    "end": 427.933,
    "duration": 4.598
  },
  {
    "id": 100,
    "text": "同情受难人民的“忧郁”情思，展现出崇高的历史担当。",
    "start": 427.933,
    "end": 432.531,
    "duration": 4.598
  },
  {
    "id": 101,
    "text": "随后，剖析忧郁源于民族受难而非小资自怜的机制，",
    "start": 432.531,
    "end": 437.128,
    "duration": 4.597
  },
  {
    "id": 102,
    "text": "具体表述到答题语句就是：艾青曾明确指出“忧郁是我的诗的底色”。",
    "start": 437.128,
    "end": 443.04,
    "duration": 5.912
  },
  {
    "id": 103,
    "text": "这种忧郁绝非早期浪漫派诗人顾影自怜、",
    "start": 443.12,
    "end": 446.8,
    "duration": 3.68
  },
  {
    "id": 104,
    "text": "颓唐感伤的小资产阶级情绪，而是源自对祖国山河破碎与底层劳苦大众悲惨境遇的感同身受。",
    "start": 446.8,
    "end": 455.28,
    "duration": 8.48
  },
  {
    "id": 105,
    "text": "紧接着，调取《北方》原野荒凉叹息：在《北方》中，",
    "start": 455.28,
    "end": 459.6,
    "duration": 4.32
  },
  {
    "id": 106,
    "text": "诗人目睹荒凉漫漫的原野、贫瘠的村落与被饥紧寒冷折磨的北方人民，",
    "start": 459.6,
    "end": 465.52,
    "duration": 5.92
  },
  {
    "id": 107,
    "text": "发出了撕心裂肺的叹息。",
    "start": 465.52,
    "end": 467.44,
    "duration": 1.92
  },
  {
    "id": 108,
    "text": "-最后，调取《我爱这土地》常含泪水名句收束提炼：而《我爱这土地》结笔处的千古名句“为什么我的眼里常含泪水？",
    "start": 467.68,
    "end": 476.121,
    "duration": 8.441
  },
  {
    "id": 109,
    "text": "因为我对这土地爱得深沉”，以极其质朴的语言将这种忧郁的情感机制推向极境，",
    "start": 476.121,
    "end": 482.453,
    "duration": 6.332
  },
  {
    "id": 110,
    "text": "展现出中国知识分子面对民族浩劫时甘愿奉献全副身心的崇高牺牲精神。",
    "start": 482.453,
    "end": 488.4,
    "duration": 5.947
  },
  {
    "id": 111,
    "text": "第二，在情感品格机制上，艾青诗歌充溢着一种博大深沉、",
    "start": 488.48,
    "end": 493.76,
    "duration": 5.28
  },
  {
    "id": 112,
    "text": "同情受难人民的“忧郁”情思，展现出崇高的历史担当。",
    "start": 493.76,
    "end": 498.32,
    "duration": 4.56
  },
  {
    "id": 113,
    "text": "艾青曾明确指出“忧郁是我的诗的底色”。",
    "start": 498.32,
    "end": 502.16,
    "duration": 3.84
  },
  {
    "id": 114,
    "text": "这种忧郁绝非早期浪漫派诗人顾影自怜、",
    "start": 502.16,
    "end": 506.0,
    "duration": 3.84
  },
  {
    "id": 115,
    "text": "颓唐感伤的小资产阶级情绪，而是源自对祖国山河破碎与底层劳苦大众悲惨境遇的感同身受。",
    "start": 506.0,
    "end": 514.24,
    "duration": 8.24
  },
  {
    "id": 116,
    "text": "在《北方》中，诗人目睹荒凉漫漫的原野、",
    "start": 514.56,
    "end": 517.84,
    "duration": 3.28
  },
  {
    "id": 117,
    "text": "贫瘠的村落与被饥紧寒冷折磨的北方人民，",
    "start": 517.84,
    "end": 521.44,
    "duration": 3.6
  },
  {
    "id": 118,
    "text": "发出了撕心裂肺的叹息。",
    "start": 521.44,
    "end": 523.36,
    "duration": 1.92
  },
  {
    "id": 119,
    "text": "而《我爱这土地》结笔处的千古名句“为什么我的眼里常含泪水？",
    "start": 523.36,
    "end": 528.4,
    "duration": 5.04
  },
  {
    "id": 120,
    "text": "因为我对这土地爱得深沉”，以极其质朴的语言将这种忧郁的情感机制推向极境，",
    "start": 528.4,
    "end": 534.96,
    "duration": 6.56
  },
  {
    "id": 121,
    "text": "展现出中国知识分子面对民族浩劫时甘愿奉献全副身心的崇高牺牲精神。",
    "start": 534.96,
    "end": 541.12,
    "duration": 6.16
  },
  {
    "id": 122,
    "text": "四、第三维度：自由新诗的文体革新与形式美学内部咬合。",
    "start": 541.44,
    "end": 546.4,
    "duration": 4.96
  },
  {
    "id": 123,
    "text": "本段任务是落脚于文学形式本体，对比新月派格律束缚，",
    "start": 546.4,
    "end": 550.8,
    "duration": 4.4
  },
  {
    "id": 124,
    "text": "讲透散文美与绘画造型美。",
    "start": 550.8,
    "end": 552.96,
    "duration": 2.16
  },
  {
    "id": 125,
    "text": "-首先，段首给出统领分论点，具体表述到答题语句就是：第三，",
    "start": 553.176,
    "end": 557.987,
    "duration": 4.811
  },
  {
    "id": 126,
    "text": "在文体建构与诗体艺术上，艾青彻底打破了旧体格律与早期新月派“戴着镣靠跳舞”的形式束缚，",
    "start": 557.987,
    "end": 565.805,
    "duration": 7.818
  },
  {
    "id": 127,
    "text": "创造了散文化、口语化与绘画美高度融合的自由诗体范式。",
    "start": 565.805,
    "end": 570.616,
    "duration": 4.811
  },
  {
    "id": 128,
    "text": "-随后，说明其追求内在情绪律动而非齐整外形的主张，",
    "start": 570.616,
    "end": 574.905,
    "duration": 4.289
  },
  {
    "id": 129,
    "text": "具体表述到答题语句就是：艾青主张诗歌应当“不求外在形式的齐整，",
    "start": 574.905,
    "end": 580.364,
    "duration": 5.459
  },
  {
    "id": 130,
    "text": "而求内在情绪的律动”。",
    "start": 580.364,
    "end": 582.118,
    "duration": 1.754
  },
  {
    "id": 131,
    "text": "他的诗行长短错落，随思想感情的起伏自然舒展，",
    "start": 582.118,
    "end": 586.017,
    "duration": 3.899
  },
  {
    "id": 132,
    "text": "大量吸收洗练清新的现代日常口语，",
    "start": 586.017,
    "end": 588.941,
    "duration": 2.924
  },
  {
    "id": 133,
    "text": "摒弃了一切浮华雕饰。",
    "start": 588.941,
    "end": 590.696,
    "duration": 1.755
  },
  {
    "id": 134,
    "text": "-紧接着，深入剖析其留法学画背景带来的绘画造型美：同时，",
    "start": 590.696,
    "end": 595.711,
    "duration": 5.015
  },
  {
    "id": 135,
    "text": "由于艾青早年在法国专修绘画，其诗歌具有强烈的造型感与色彩美。",
    "start": 595.711,
    "end": 601.562,
    "duration": 5.851
  },
  {
    "id": 136,
    "text": "最后，调取《雪落在中国的土地上》雕塑画面感收束：在《雪落在中国的土地上》中，",
    "start": 601.562,
    "end": 608.039,
    "duration": 6.477
  },
  {
    "id": 137,
    "text": "冰冷的白雪、乌黑的夜色与衣衫兰褛的难民剪影并置，",
    "start": 608.039,
    "end": 612.636,
    "duration": 4.597
  },
  {
    "id": 138,
    "text": "构成了雕塑般坚实凝练的画面质感，",
    "start": 612.636,
    "end": 615.771,
    "duration": 3.135
  },
  {
    "id": 139,
    "text": "达到了“诗中有画”的纯正现代境界。",
    "start": 615.771,
    "end": 618.696,
    "duration": 2.925
  },
  {
    "id": 140,
    "text": "第三，在文体建构与诗体艺术上，艾青彻底打破了旧体格律与早期新月派“戴着镣靠跳舞”的形式束缚，",
    "start": 618.776,
    "end": 627.976,
    "duration": 9.2
  },
  {
    "id": 141,
    "text": "创造了散文化、口语化与绘画美高度融合的自由诗体范式。",
    "start": 627.976,
    "end": 633.176,
    "duration": 5.2
  },
  {
    "id": 142,
    "text": "艾青主张诗歌应当“不求外在形式的齐整，",
    "start": 633.176,
    "end": 636.616,
    "duration": 3.44
  },
  {
    "id": 143,
    "text": "而求内在情绪的律动”。",
    "start": 636.616,
    "end": 638.216,
    "duration": 1.6
  },
  {
    "id": 144,
    "text": "他的诗行长短错落，随思想感情的起伏自然舒展，",
    "start": 638.536,
    "end": 642.776,
    "duration": 4.24
  },
  {
    "id": 145,
    "text": "大量吸收洗练清新的现代日常口语，",
    "start": 642.776,
    "end": 645.736,
    "duration": 2.96
  },
  {
    "id": 146,
    "text": "摒弃了一切浮华雕饰。",
    "start": 645.736,
    "end": 647.896,
    "duration": 2.16
  },
  {
    "id": 147,
    "text": "同时，由于艾青早年在法国专修绘画，",
    "start": 647.896,
    "end": 651.176,
    "duration": 3.28
  },
  {
    "id": 148,
    "text": "其诗歌具有强烈的造型感与色彩美。",
    "start": 651.176,
    "end": 654.136,
    "duration": 2.96
  },
  {
    "id": 149,
    "text": "在《雪落在中国的土地上》中，冰冷的白雪、",
    "start": 654.136,
    "end": 657.736,
    "duration": 3.6
  },
  {
    "id": 150,
    "text": "乌黑的夜色与衣衫兰褛的难民剪影并置，",
    "start": 657.736,
    "end": 661.336,
    "duration": 3.6
  },
  {
    "id": 151,
    "text": "构成了雕塑般坚实凝练的画面质感，",
    "start": 661.336,
    "end": 664.296,
    "duration": 2.96
  },
  {
    "id": 152,
    "text": "达到了“诗中有画”的纯正现代境界。",
    "start": 664.296,
    "end": 667.096,
    "duration": 2.8
  },
  {
    "id": 153,
    "text": "五、结尾收束升华段内部咬合。",
    "start": 667.416,
    "end": 670.776,
    "duration": 3.36
  },
  {
    "id": 154,
    "text": "本段承担全篇论证成果的系统提炼与历史定位，",
    "start": 670.776,
    "end": 675.336,
    "duration": 4.56
  },
  {
    "id": 155,
    "text": "完成宏观历史论证闭环。",
    "start": 675.336,
    "end": 677.736,
    "duration": 2.4
  },
  {
    "id": 156,
    "text": "首先，全面回收土地沉重与太阳炽热的时代心电图，",
    "start": 677.736,
    "end": 682.536,
    "duration": 4.8
  },
  {
    "id": 157,
    "text": "具体表述到答题语句就是：综上所述，",
    "start": 682.536,
    "end": 685.896,
    "duration": 3.36
  },
  {
    "id": 158,
    "text": "艾青以“土地”之沉重与“太阳”之炽热，",
    "start": 685.896,
    "end": 689.096,
    "duration": 3.2
  },
  {
    "id": 159,
    "text": "为二十世纪中华民族的苦难与奋起留下了最庄严的历史心电图。",
    "start": 689.096,
    "end": 694.216,
    "duration": 5.12
  },
  {
    "id": 160,
    "text": "-紧接着，总结沉雄忧郁情思与自由文体对现实主义新诗的标杆价值，",
    "start": 694.512,
    "end": 700.763,
    "duration": 6.251
  },
  {
    "id": 161,
    "text": "具体表述到答题语句就是：他以沉雄深沉的忧郁情思净化了诗歌的灵魂，",
    "start": 700.763,
    "end": 707.46,
    "duration": 6.697
  },
  {
    "id": 162,
    "text": "以从容自由的文体解放确立了中国现代现实主义新诗的崇高标杆，",
    "start": 707.46,
    "end": 713.71,
    "duration": 6.25
  },
  {
    "id": 163,
    "text": "在现当代文学史上享有历久弥新的光辉地位。",
    "start": 713.71,
    "end": 717.952,
    "duration": 4.242
  },
  {
    "id": 164,
    "text": "综上所述，艾青以“土地”之沉重与“太阳”之炽热，",
    "start": 718.032,
    "end": 722.192,
    "duration": 4.16
  },
  {
    "id": 165,
    "text": "为二十世纪中华民族的苦难与奋起留下了最庄严的历史心电图。",
    "start": 722.192,
    "end": 727.312,
    "duration": 5.12
  },
  {
    "id": 166,
    "text": "他以沉雄深沉的忧郁情思净化了诗歌的灵魂，",
    "start": 727.312,
    "end": 731.552,
    "duration": 4.24
  },
  {
    "id": 167,
    "text": "以从容自由的文体解放确立了中国现代现实主义新诗的崇高标杆，",
    "start": 731.552,
    "end": 736.992,
    "duration": 5.44
  },
  {
    "id": 168,
    "text": "在现当代文学史上享有历久弥新的光辉地位。",
    "start": 736.992,
    "end": 740.592,
    "duration": 3.6
  }
