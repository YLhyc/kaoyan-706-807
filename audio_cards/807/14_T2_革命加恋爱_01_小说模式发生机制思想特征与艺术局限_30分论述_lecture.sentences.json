[
  {
    "id": 1,
    "text": "一、宏观结构推演与采分点映射。",
    "start": 0.16,
    "end": 3.12,
    "duration": 2.96
  },
  {
    "id": 2,
    "text": "本题标准分为三十分，论述结构采用高分“总论破题，",
    "start": 3.12,
    "end": 7.6,
    "duration": 4.48
  },
  {
    "id": 3,
    "text": "发生机制与思想演进，大师个案超越，",
    "start": 7.6,
    "end": 10.8,
    "duration": 3.2
  },
  {
    "id": 4,
    "text": "艺术局限总结”逻辑模型：一、破题总论层（约一百五十字）：界定时代时空（二十年代末三十年代初大革命失败后）、",
    "start": 10.8,
    "end": 19.92,
    "duration": 9.12
  },
  {
    "id": 5,
    "text": "倡导阵营（创造社、太阳社、左翼文学）、",
    "start": 19.92,
    "end": 23.2,
    "duration": 3.28
  },
  {
    "id": 6,
    "text": "核心范式（政治宏大诉求与个体情欲结合）。",
    "start": 23.2,
    "end": 26.4,
    "duration": 3.2
  },
  {
    "id": 7,
    "text": "二、第一支柱：发生机制•时代挫折与小资产阶级心理补偿：采分点为一九二七年大革命流产、",
    "start": 26.72,
    "end": 34.88,
    "duration": 8.16
  },
  {
    "id": 8,
    "text": "启蒙幻灭、小资产阶级软弱性、欲望与崇高彼岸的调和。",
    "start": 34.88,
    "end": 39.44,
    "duration": 4.56
  },
  {
    "id": 9,
    "text": "三、第二支柱：思想特征•意识形态规训与二元对抗：采分点为二元对抗结构、",
    "start": 39.44,
    "end": 46.32,
    "duration": 6.88
  },
  {
    "id": 10,
    "text": "革命征服恋爱、情欲能量转化为政治献身动力（蒋光慈、",
    "start": 46.32,
    "end": 51.12,
    "duration": 4.8
  },
  {
    "id": 11,
    "text": "华汉）。",
    "start": 51.12,
    "end": 51.52,
    "duration": 0.4
  },
  {
    "id": 12,
    "text": "四、第三支柱：典范超越•茅盾现实主义深化（《蚀》三部曲）：采分点为打破公式化、",
    "start": 51.84,
    "end": 58.8,
    "duration": 6.96
  },
  {
    "id": 13,
    "text": "直面动摇与幻灭、复杂心理写实。",
    "start": 58.8,
    "end": 61.68,
    "duration": 2.88
  },
  {
    "id": 14,
    "text": "五、第四支柱：艺术局限•概念先行与脸谱化模式弊端：采分点为概念化、",
    "start": 61.68,
    "end": 68.16,
    "duration": 6.48
  },
  {
    "id": 15,
    "text": "情节生硬、传奇化拼贴、口号传声筒。",
    "start": 68.16,
    "end": 71.44,
    "duration": 3.28
  },
  {
    "id": 16,
    "text": "六、总结提升层（约一百五十字）：文学史价值定位、",
    "start": 71.68,
    "end": 76.4,
    "duration": 4.72
  },
  {
    "id": 17,
    "text": "知识分子精神阵痛写照、当代革命文学范式源头。",
    "start": 76.4,
    "end": 80.32,
    "duration": 3.92
  },
  {
    "id": 18,
    "text": "二、逐段内部咬合与考场得分句推导。",
    "start": 80.32,
    "end": 83.68,
    "duration": 3.36
  },
  {
    "id": 19,
    "text": "破题段：时代坐标与模式定性。",
    "start": 83.68,
    "end": 86.48,
    "duration": 2.8
  },
  {
    "id": 20,
    "text": "论证推演逻辑：先确立其时代坐标：一九二七年大革命失败后。",
    "start": 86.48,
    "end": 91.36,
    "duration": 4.88
  },
  {
    "id": 21,
    "text": "交代创造社、太阳社的倡导背景，明确其文体本质是个体情爱与革命政治的结合，",
    "start": 91.68,
    "end": 99.04,
    "duration": 7.36
  },
  {
    "id": 22,
    "text": "引出四大论点。",
    "start": 99.04,
    "end": 100.48,
    "duration": 1.44
  },
  {
    "id": 23,
    "text": "具体表述到答题语句就是：二十世纪二十年代末至三十年代初风靡文坛的“革命加恋爱”小说，",
    "start": 100.48,
    "end": 108.0,
    "duration": 7.52
  },
  {
    "id": 24,
    "text": "是中国现代文学在政治大动荡背景下产生的独特文体范式。",
    "start": 108.0,
    "end": 112.64,
    "duration": 4.64
  },
  {
    "id": 25,
    "text": "一九二七年大革命遭遇惨痛失败，大量处于苦闷彷徨中的小资产阶级知识分子急迫寻求精神出路。",
    "start": 112.96,
    "end": 121.36,
    "duration": 8.4
  },
  {
    "id": 26,
    "text": "创造社与太阳社等左翼作家群体，试图以通俗动人的情感叙事普及阶级革命观念。",
    "start": 121.36,
    "end": 128.24,
    "duration": 6.88
  },
  {
    "id": 27,
    "text": "政治意识形态的宏大诉求，与五四个性解放的个体情欲在此交织化合。",
    "start": 128.24,
    "end": 133.68,
    "duration": 5.44
  },
  {
    "id": 28,
    "text": "该小说模式构成了中国现代文学史上极具代表性的历史现象。",
    "start": 134.0,
    "end": 139.36,
    "duration": 5.36
  },
  {
    "id": 29,
    "text": "其发生机制、思想特征与艺术局限主要体现在四个深层维度。",
    "start": 139.36,
    "end": 144.64,
    "duration": 5.28
  },
  {
    "id": 30,
    "text": "二十世纪二十年代末至三十年代初风靡文坛的“革命加恋爱”小说，",
    "start": 145.016,
    "end": 150.376,
    "duration": 5.36
  },
  {
    "id": 31,
    "text": "是中国现代文学在政治大动荡背景下产生的独特文体范式。",
    "start": 150.376,
    "end": 155.016,
    "duration": 4.64
  },
  {
    "id": 32,
    "text": "一九二七年大革命遭遇惨痛失败，大量处于苦闷彷徨中的小资产阶级知识分子急迫寻求精神出路。",
    "start": 155.016,
    "end": 163.016,
    "duration": 8.0
  },
  {
    "id": 33,
    "text": "创造社与太阳社等左翼作家群体，试图以通俗动人的情感叙事普及阶级革命观念。",
    "start": 163.016,
    "end": 169.176,
    "duration": 6.16
  },
  {
    "id": 34,
    "text": "政治意识形态的宏大诉求，与五四个性解放的个体情欲在此交织化合。",
    "start": 169.416,
    "end": 175.336,
    "duration": 5.92
  },
  {
    "id": 35,
    "text": "该小说模式构成了中国现代文学史上极具代表性的历史现象。",
    "start": 175.336,
    "end": 180.296,
    "duration": 4.96
  },
  {
    "id": 36,
    "text": "其发生机制、思想特征与艺术局限主要体现在四个深层维度。",
    "start": 180.296,
    "end": 185.656,
    "duration": 5.36
  },
  {
    "id": 37,
    "text": "第一支柱：发生机制与心理动机。",
    "start": 185.656,
    "end": 188.296,
    "duration": 2.64
  },
  {
    "id": 38,
    "text": "论证推演逻辑：从社会历史与心理学发生学剖析。",
    "start": 188.616,
    "end": 192.936,
    "duration": 4.32
  },
  {
    "id": 39,
    "text": "一九二七年政局剧变使五四启蒙破产，",
    "start": 192.936,
    "end": 196.216,
    "duration": 3.28
  },
  {
    "id": 40,
    "text": "小资产阶级产生严重的精神危机与原罪感。",
    "start": 196.216,
    "end": 199.576,
    "duration": 3.36
  },
  {
    "id": 41,
    "text": "恋爱代表个体本能，革命代表崇高救赎，",
    "start": 199.576,
    "end": 202.776,
    "duration": 3.2
  },
  {
    "id": 42,
    "text": "两者结合是他们寻求合法性与自我安慰的必然途径。",
    "start": 202.776,
    "end": 206.696,
    "duration": 3.92
  },
  {
    "id": 43,
    "text": "具体表述到答题语句就是：第一，时代危机促发与知识分子心理转型的发生动力。",
    "start": 206.696,
    "end": 213.896,
    "duration": 7.2
  },
  {
    "id": 44,
    "text": "一九二七年大革命的急转直下，导致五四启蒙主义神话彻底破灭。",
    "start": 213.896,
    "end": 219.496,
    "duration": 5.6
  },
  {
    "id": 45,
    "text": "都市中的青年知识分子普遍陷入幻灭、",
    "start": 219.496,
    "end": 222.856,
    "duration": 3.36
  },
  {
    "id": 46,
    "text": "退缩与躁动的精神危机。",
    "start": 222.856,
    "end": 225.256,
    "duration": 2.4
  },
  {
    "id": 47,
    "text": "他们既渴望投身狂暴的阶级解放浪潮以洗刷小资产阶级的软弱原罪，",
    "start": 225.256,
    "end": 231.496,
    "duration": 6.24
  },
  {
    "id": 48,
    "text": "又无法彻底割舍对个人世俗情爱的眷恋。",
    "start": 231.496,
    "end": 234.536,
    "duration": 3.04
  },
  {
    "id": 49,
    "text": "恋爱成为个体生命冲动的直观隐喻，",
    "start": 234.776,
    "end": 237.576,
    "duration": 2.8
  },
  {
    "id": 50,
    "text": "而革命则成为赋予生命神圣政治依托的崇高彼岸。",
    "start": 237.576,
    "end": 242.056,
    "duration": 4.48
  },
  {
    "id": 51,
    "text": "“革命加恋爱”正是在这种弥合个人欲望与阶级归宿的深刻心理矛盾中应运而生。",
    "start": 242.056,
    "end": 248.696,
    "duration": 6.64
  },
  {
    "id": 52,
    "text": "第一，时代危机促发与知识分子心理转型的发生动力。",
    "start": 248.696,
    "end": 253.256,
    "duration": 4.56
  },
  {
    "id": 53,
    "text": "一九二七年大革命的急转直下，导致五四启蒙主义神话彻底破灭。",
    "start": 253.256,
    "end": 258.216,
    "duration": 4.96
  },
  {
    "id": 54,
    "text": "都市中的青年知识分子普遍陷入幻灭、",
    "start": 258.376,
    "end": 261.736,
    "duration": 3.36
  },
  {
    "id": 55,
    "text": "退缩与躁动的精神危机。",
    "start": 261.736,
    "end": 264.056,
    "duration": 2.32
  },
  {
    "id": 56,
    "text": "他们既渴望投身狂暴的阶级解放浪潮以洗刷小资产阶级的软弱原罪，",
    "start": 264.056,
    "end": 269.736,
    "duration": 5.68
  },
  {
    "id": 57,
    "text": "又无法彻底割舍对个人世俗情爱的眷恋。",
    "start": 269.736,
    "end": 273.256,
    "duration": 3.52
  },
  {
    "id": 58,
    "text": "恋爱成为个体生命冲动的直观隐喻，",
    "start": 273.256,
    "end": 276.216,
    "duration": 2.96
  },
  {
    "id": 59,
    "text": "而革命则成为赋予生命神圣政治依托的崇高彼岸。",
    "start": 276.216,
    "end": 280.136,
    "duration": 3.92
  },
  {
    "id": 60,
    "text": "“革命加恋爱”正是在这种弥合个人欲望与阶级归宿的深刻心理矛盾中应运而生。",
    "start": 280.296,
    "end": 287.607,
    "duration": 7.311
  },
  {
    "id": 61,
    "text": "第二支柱：思想特征与政治规训。",
    "start": 287.607,
    "end": 290.487,
    "duration": 2.88
  },
  {
    "id": 62,
    "text": "论证推演逻辑：剖析其内在的思想结构。",
    "start": 290.487,
    "end": 294.344,
    "duration": 3.857
  },
  {
    "id": 63,
    "text": "恋爱绝不是与革命平起平坐的，而是最终被政治意识形态规训和吞并。",
    "start": 294.344,
    "end": 300.584,
    "duration": 6.24
  },
  {
    "id": 64,
    "text": "列举蒋光慈《冲出云围的月亮》与华汉《地泉》，",
    "start": 300.584,
    "end": 304.984,
    "duration": 4.4
  },
  {
    "id": 65,
    "text": "阐释情欲如何被置换为阶级斗争的原动力。",
    "start": 304.984,
    "end": 308.824,
    "duration": 3.84
  },
  {
    "id": 66,
    "text": "具体表述到答题语句就是：第二，情爱欲望向阶级政治意识形态规训的依附升华。",
    "start": 308.824,
    "end": 315.304,
    "duration": 6.48
  },
  {
    "id": 67,
    "text": "这一模式在思想结构上建立了高度公式化的政治伦理。",
    "start": 315.624,
    "end": 319.864,
    "duration": 4.24
  },
  {
    "id": 68,
    "text": "革命与恋爱最初往往作为激烈的二元对抗出现，",
    "start": 319.864,
    "end": 323.784,
    "duration": 3.92
  },
  {
    "id": 69,
    "text": "但叙事最终必然走向革命对恋爱的规训与征服。",
    "start": 323.784,
    "end": 327.864,
    "duration": 4.08
  },
  {
    "id": 70,
    "text": "蒋光慈在《冲出云围的月亮》与华汉在《地泉》中，",
    "start": 327.864,
    "end": 331.704,
    "duration": 3.84
  },
  {
    "id": 71,
    "text": "将女性塑造为诱发革命热情的催化剂或必须割舍的情感羁绊。",
    "start": 331.704,
    "end": 336.744,
    "duration": 5.04
  },
  {
    "id": 72,
    "text": "主人公只有斩断私情、将狂热的力比多转化为阶级献身热情，",
    "start": 336.984,
    "end": 342.904,
    "duration": 5.92
  },
  {
    "id": 73,
    "text": "才能完成革命主体的凤凰涅盘。",
    "start": 342.904,
    "end": 346.344,
    "duration": 3.44
  },
  {
    "id": 74,
    "text": "恋爱由此蜕变为革命话语的附属装饰。",
    "start": 346.344,
    "end": 349.864,
    "duration": 3.52
  },
  {
    "id": 75,
    "text": "第二，情爱欲望向阶级政治意识形态规训的依附升华。",
    "start": 349.864,
    "end": 355.064,
    "duration": 5.2
  },
  {
    "id": 76,
    "text": "这一模式在思想结构上建立了高度公式化的政治伦理。",
    "start": 355.064,
    "end": 359.304,
    "duration": 4.24
  },
  {
    "id": 77,
    "text": "革命与恋爱最初往往作为激烈的二元对抗出现，",
    "start": 359.544,
    "end": 363.224,
    "duration": 3.68
  },
  {
    "id": 78,
    "text": "但叙事最终必然走向革命对恋爱的规训与征服。",
    "start": 363.224,
    "end": 367.384,
    "duration": 4.16
  },
  {
    "id": 79,
    "text": "蒋光慈在《冲出云围的月亮》与华汉在《地泉》中，",
    "start": 367.384,
    "end": 371.224,
    "duration": 3.84
  },
  {
    "id": 80,
    "text": "将女性塑造为诱发革命热情的催化剂或必须割舍的情感羁绊。",
    "start": 371.224,
    "end": 376.344,
    "duration": 5.12
  },
  {
    "id": 81,
    "text": "主人公只有斩断私情、将狂热的力比多转化为阶级献身热情，",
    "start": 376.344,
    "end": 381.464,
    "duration": 5.12
  },
  {
    "id": 82,
    "text": "才能完成革命主体的凤凰涅盘。",
    "start": 381.464,
    "end": 383.784,
    "duration": 2.32
  },
  {
    "id": 83,
    "text": "恋爱由此蜕变为革命话语的附属装饰。",
    "start": 384.104,
    "end": 387.384,
    "duration": 3.28
  },
  {
    "id": 84,
    "text": "第三支柱：茅盾的写实突破与大师个案（《蚀》）。",
    "start": 387.384,
    "end": 391.464,
    "duration": 4.08
  },
  {
    "id": 85,
    "text": "论证推演逻辑：高分亮点必须引入茅盾这一异数。",
    "start": 391.464,
    "end": 395.624,
    "duration": 4.16
  },
  {
    "id": 86,
    "text": "在粗暴公式化中，茅盾以《蚀》三部曲打破教条，",
    "start": 395.624,
    "end": 399.224,
    "duration": 3.6
  },
  {
    "id": 87,
    "text": "写出了幻灭、动摇与挣扎，将公式化的“革命加恋爱”升华为严肃深刻的时代精神肖像。",
    "start": 399.224,
    "end": 406.824,
    "duration": 7.6
  },
  {
    "id": 88,
    "text": "具体表述到答题语句就是：第三，茅盾对公式化模式的现实主义审视与艺术深化。",
    "start": 406.824,
    "end": 414.088,
    "duration": 7.264
  },
  {
    "id": 89,
    "text": "在大量粗糙的概念化作品泛滥之时，",
    "start": 414.088,
    "end": 417.208,
    "duration": 3.12
  },
  {
    "id": 90,
    "text": "茅盾展现出清醒深刻的现实主义大师风范。",
    "start": 417.208,
    "end": 421.048,
    "duration": 3.84
  },
  {
    "id": 91,
    "text": "他在《蚀》三部曲（《幻灭》《动摇》《追求》）与《创造》中，",
    "start": 421.048,
    "end": 424.888,
    "duration": 3.84
  },
  {
    "id": 92,
    "text": "彻底打破了廉价狂热的公式套路。",
    "start": 424.888,
    "end": 427.208,
    "duration": 2.32
  },
  {
    "id": 93,
    "text": "茅盾逼视静女士、方罗兰等动摇者在革命狂潮中的心理波澜。",
    "start": 427.608,
    "end": 432.648,
    "duration": 5.04
  },
  {
    "id": 94,
    "text": "他没有让革命轻易吞并恋爱，而是如实记录了知识分子被时代车轮碾碎的幻灭绝望与灵魂挣扎。",
    "start": 432.648,
    "end": 440.008,
    "duration": 7.36
  },
  {
    "id": 95,
    "text": "茅盾以复杂的心理写实，极大地深化了该题材的思想厚度。",
    "start": 440.008,
    "end": 444.328,
    "duration": 4.32
  },
  {
    "id": 96,
    "text": "第三，茅盾对公式化模式的现实主义审视与艺术深化。",
    "start": 444.328,
    "end": 448.408,
    "duration": 4.08
  },
  {
    "id": 97,
    "text": "在大量粗糙的概念化作品泛滥之时，",
    "start": 448.728,
    "end": 451.608,
    "duration": 2.88
  },
  {
    "id": 98,
    "text": "茅盾展现出清醒深刻的现实主义大师风范。",
    "start": 451.608,
    "end": 455.288,
    "duration": 3.68
  },
  {
    "id": 99,
    "text": "他在《蚀》三部曲（《幻灭》《动摇》《追求》）与《创造》中，",
    "start": 455.288,
    "end": 459.368,
    "duration": 4.08
  },
  {
    "id": 100,
    "text": "彻底打破了廉价狂热的公式套路。",
    "start": 459.368,
    "end": 462.248,
    "duration": 2.88
  },
  {
    "id": 101,
    "text": "茅盾逼视静女士、方罗兰等动摇者在革命狂潮中的心理波澜。",
    "start": 462.248,
    "end": 466.968,
    "duration": 4.72
  },
  {
    "id": 102,
    "text": "他没有让革命轻易吞并恋爱，而是如实记录了知识分子被时代车轮碾碎的幻灭绝望与灵魂挣扎。",
    "start": 467.208,
    "end": 476.008,
    "duration": 8.8
  },
  {
    "id": 103,
    "text": "茅盾以复杂的心理写实，极大地深化了该题材的思想厚度。",
    "start": 476.008,
    "end": 480.888,
    "duration": 4.88
  },
  {
    "id": 104,
    "text": "第四支柱：模式化弊端与艺术局限。",
    "start": 480.888,
    "end": 484.248,
    "duration": 3.36
  },
  {
    "id": 105,
    "text": "论证推演逻辑：辩证指出其文体局限。",
    "start": 484.248,
    "end": 487.288,
    "duration": 3.04
  },
  {
    "id": 106,
    "text": "急功近利的宣传导致概念化、脸谱化，",
    "start": 487.608,
    "end": 490.808,
    "duration": 3.2
  },
  {
    "id": 107,
    "text": "浪漫情爱流于感伤造作，革命流于冒险奇遇，",
    "start": 490.808,
    "end": 495.048,
    "duration": 4.24
  },
  {
    "id": 108,
    "text": "损害了文学的真实性与审美价值。",
    "start": 495.048,
    "end": 497.928,
    "duration": 2.88
  },
  {
    "id": 109,
    "text": "具体表述到答题语句就是：第四，概念先行导致的模式化泛滥与艺术局限。",
    "start": 497.928,
    "end": 504.488,
    "duration": 6.56
  },
  {
    "id": 110,
    "text": "尽管这一模式极大地推动了左翼文学的通俗传播，",
    "start": 504.488,
    "end": 508.248,
    "duration": 3.76
  },
  {
    "id": 111,
    "text": "但其自身孕育着严重的艺术先天不足。",
    "start": 508.248,
    "end": 511.048,
    "duration": 2.8
  },
  {
    "id": 112,
    "text": "多数作家受到急功近利宣传心态的驱使，",
    "start": 511.448,
    "end": 514.808,
    "duration": 3.36
  },
  {
    "id": 113,
    "text": "陷入概念化与公式化的泥闹。",
    "start": 514.808,
    "end": 517.368,
    "duration": 2.56
  },
  {
    "id": 114,
    "text": "人物形象高度脸谱化，情节沦为“政治口号加浪漫奇遇”的生硬拼贴。",
    "start": 517.368,
    "end": 523.208,
    "duration": 5.84
  },
  {
    "id": 115,
    "text": "革命过程被高度理想化与传奇化，而恋爱心理则滑向低俗感伤与矫揉造作。",
    "start": 523.208,
    "end": 530.088,
    "duration": 6.88
  },
  {
    "id": 116,
    "text": "它割裂了现实生活的丰富血肉，使文学沦为了政治教条的传声筒。",
    "start": 530.088,
    "end": 534.968,
    "duration": 4.88
  },
  {
    "id": 117,
    "text": "第四，概念先行导致的模式化泛滥与艺术局限。",
    "start": 535.256,
    "end": 539.336,
    "duration": 4.08
  },
  {
    "id": 118,
    "text": "尽管这一模式极大地推动了左翼文学的通俗传播，",
    "start": 539.336,
    "end": 543.016,
    "duration": 3.68
  },
  {
    "id": 119,
    "text": "但其自身孕育着严重的艺术先天不足。",
    "start": 543.016,
    "end": 546.216,
    "duration": 3.2
  },
  {
    "id": 120,
    "text": "多数作家受到急功近利宣传心态的驱使，",
    "start": 546.216,
    "end": 549.336,
    "duration": 3.12
  },
  {
    "id": 121,
    "text": "陷入概念化与公式化的泥闹。",
    "start": 549.336,
    "end": 551.736,
    "duration": 2.4
  },
  {
    "id": 122,
    "text": "人物形象高度脸谱化，情节沦为“政治口号加浪漫奇遇”的生硬拼贴。",
    "start": 551.736,
    "end": 556.856,
    "duration": 5.12
  },
  {
    "id": 123,
    "text": "革命过程被高度理想化与传奇化，而恋爱心理则滑向低俗感伤与矫揉造作。",
    "start": 557.096,
    "end": 563.816,
    "duration": 6.72
  },
  {
    "id": 124,
    "text": "它割裂了现实生活的丰富血肉，使文学沦为了政治教条的传声筒。",
    "start": 563.816,
    "end": 568.856,
    "duration": 5.04
  },
  {
    "id": 125,
    "text": "总结升华段：文学史辩证定位。",
    "start": 568.856,
    "end": 571.576,
    "duration": 2.72
  },
  {
    "id": 126,
    "text": "论证推演逻辑：总结提升。",
    "start": 571.576,
    "end": 573.896,
    "duration": 2.32
  },
  {
    "id": 127,
    "text": "指出其作为革命文学向通俗化探索的先声，",
    "start": 573.896,
    "end": 577.496,
    "duration": 3.6
  },
  {
    "id": 128,
    "text": "以及对后继红色经典叙事规范形成的深远启示。",
    "start": 577.496,
    "end": 581.176,
    "duration": 3.68
  },
  {
    "id": 129,
    "text": "-具体表述到答题语句就是：“革命加恋爱”小说模式是特定历史语境下革命意识形态与通俗市民叙事结合的文体产物。",
    "start": 581.416,
    "end": 590.821,
    "duration": 9.405
  },
  {
    "id": 130,
    "text": "它虽然存在明显的艺术缺陷，却深刻折射出中国现代知识分子在历史大裂变中的精神阵痛。",
    "start": 590.821,
    "end": 598.266,
    "duration": 7.445
  },
  {
    "id": 131,
    "text": "它为理解中国当代革命文学规范的形成，",
    "start": 598.266,
    "end": 601.597,
    "duration": 3.331
  },
  {
    "id": 132,
    "text": "提供了不可替代的文体发生学样本。",
    "start": 601.597,
    "end": 604.536,
    "duration": 2.939
  },
  {
    "id": 133,
    "text": "“革命加恋爱”小说模式是特定历史语境下革命意识形态与通俗市民叙事结合的文体产物。",
    "start": 604.536,
    "end": 611.424,
    "duration": 6.888
  },
  {
    "id": 134,
    "text": "它虽然存在明显的艺术缺陷，却深刻折射出中国现代知识分子在历史大裂变中的精神阵痛。",
    "start": 611.424,
    "end": 618.499,
    "duration": 7.075
  },
  {
    "id": 135,
    "text": "它为理解中国当代革命文学规范的形成，",
    "start": 618.499,
    "end": 621.663,
    "duration": 3.164
  },
  {
    "id": 136,
    "text": "提供了不可替代的文体发生学样本。",
    "start": 621.663,
    "end": 624.456,
    "duration": 2.793
  }
]