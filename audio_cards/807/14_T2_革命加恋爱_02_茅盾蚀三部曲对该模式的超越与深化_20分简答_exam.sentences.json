[
  {
    "id": 1,
    "text": "茅盾创作于大革命失败后的《蚀》三部曲（《幻灭》《动摇》《追求》），",
    "start": 0.08,
    "end": 5.44,
    "duration": 5.36
  },
  {
    "id": 2,
    "text": "是中国现代文学史上直面历史转折的现实主义力作。",
    "start": 5.44,
    "end": 9.76,
    "duration": 4.32
  },
  {
    "id": 3,
    "text": "面对当时文坛泛滥的“革命加恋爱”公式化倾向，",
    "start": 9.76,
    "end": 13.92,
    "duration": 4.16
  },
  {
    "id": 4,
    "text": "茅盾以高度的艺术勇气与写实洞察实现了重大超越。",
    "start": 13.92,
    "end": 18.16,
    "duration": 4.24
  },
  {
    "id": 5,
    "text": "其超越与深化主要体现在三个层面。",
    "start": 18.56,
    "end": 21.52,
    "duration": 2.96
  },
  {
    "id": 6,
    "text": "第一，从概念化的革命狂热转向真实复杂的心理写实。",
    "start": 21.52,
    "end": 26.64,
    "duration": 5.12
  },
  {
    "id": 7,
    "text": "一般左翼作品常将革命写成战无不胜的浪漫进军。",
    "start": 26.64,
    "end": 30.8,
    "duration": 4.16
  },
  {
    "id": 8,
    "text": "茅盾则以亲历者的清醒，揭示了大革命狂潮中知识分子的动摇本相。",
    "start": 30.8,
    "end": 36.16,
    "duration": 5.36
  },
  {
    "id": 9,
    "text": "《幻灭》中静女士从革命热望走向抑郁退缩，",
    "start": 36.16,
    "end": 39.68,
    "duration": 3.52
  },
  {
    "id": 10,
    "text": "《动摇》中方罗兰在革命阵营与反动势力之间的犹疑彷徨。",
    "start": 39.68,
    "end": 43.92,
    "duration": 4.24
  },
  {
    "id": 11,
    "text": "茅盾毫不掩饰小资产阶级在时代巨变中的软弱性。",
    "start": 44.24,
    "end": 48.56,
    "duration": 4.32
  },
  {
    "id": 12,
    "text": "他通过细腻精微的心理剖析，打破了英雄人物的高大全神话。",
    "start": 48.56,
    "end": 53.12,
    "duration": 4.56
  },
  {
    "id": 13,
    "text": "第二，解构政治神话并深化情爱与革命的悲剧性冲突。",
    "start": 53.36,
    "end": 58.08,
    "duration": 4.72
  },
  {
    "id": 14,
    "text": "公式化的“革命加恋爱”往往让革命轻而易举征服恋爱。",
    "start": 58.08,
    "end": 62.64,
    "duration": 4.56
  },
  {
    "id": 15,
    "text": "茅盾则展现了两者深层无法弥合的撕裂。",
    "start": 62.64,
    "end": 65.6,
    "duration": 2.96
  },
  {
    "id": 16,
    "text": "《追求》中章秋柳与张曼青等青年，",
    "start": 65.76,
    "end": 68.577,
    "duration": 2.817
  },
  {
    "id": 17,
    "text": "在革命低潮期试图从感官放纵或世俗婚姻中寻找寄托，",
    "start": 68.577,
    "end": 73.561,
    "duration": 4.984
  },
  {
    "id": 18,
    "text": "最终均陷入精神幻灭。",
    "start": 73.561,
    "end": 75.511,
    "duration": 1.95
  },
  {
    "id": 19,
    "text": "茅盾并没有强行安排大团圆结局或机械的觉悟升华。",
    "start": 75.511,
    "end": 80.279,
    "duration": 4.768
  },
  {
    "id": 20,
    "text": "他如实记录了残酷政治风暴对个体生存与纯洁情爱的摧残，",
    "start": 80.279,
    "end": 85.696,
    "duration": 5.417
  },
  {
    "id": 21,
    "text": "赋予作品沉郁的悲剧力度。",
    "start": 85.696,
    "end": 88.08,
    "duration": 2.384
  },
  {
    "id": 22,
    "text": "第三，开辟了宏大社会剖析与细致人情摹写相结合的史诗品格。",
    "start": 88.16,
    "end": 94.08,
    "duration": 5.92
  },
  {
    "id": 23,
    "text": "茅盾将都市青年微观的情感纠葛，精准锚定在大革命由高涨走向溃败的宏阔历史画卷中。",
    "start": 94.08,
    "end": 102.24,
    "duration": 8.16
  },
  {
    "id": 24,
    "text": "他把阶级分析方法化入严密的日常生活纹理。",
    "start": 102.24,
    "end": 106.0,
    "duration": 3.76
  },
  {
    "id": 25,
    "text": "这彻底告别了早期左翼小说口号化与传奇化的粗糙弊端。",
    "start": 106.0,
    "end": 110.88,
    "duration": 4.88
  },
  {
    "id": 26,
    "text": "茅盾以严肃的现实主义精神，使“革命加恋爱”题材彻底脱离了低俗奇遇的泥闹，",
    "start": 111.2,
    "end": 118.0,
    "duration": 6.8
  },
  {
    "id": 27,
    "text": "真正升华为表现一代现代知识分子灵魂大震荡的精神史诗。",
    "start": 118.0,
    "end": 123.04,
    "duration": 5.04
  }
]