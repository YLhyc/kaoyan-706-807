[
  {
    "id": 1,
    "text": "一、宏观结构推演与采分点映射。",
    "start": 0.08,
    "end": 3.04,
    "duration": 2.96
  },
  {
    "id": 2,
    "text": "本题标准分为三十分，论述结构采用高分“破题定性，",
    "start": 3.04,
    "end": 7.68,
    "duration": 4.64
  },
  {
    "id": 3,
    "text": "四大机制支柱递进展开，总结提升”逻辑模型：一、",
    "start": 7.68,
    "end": 11.84,
    "duration": 4.16
  },
  {
    "id": 4,
    "text": "破题总论层（约一百五十字）：界定寻根思潮时空坐标（八十年代中期）、",
    "start": 11.84,
    "end": 17.44,
    "duration": 5.6
  },
  {
    "id": 5,
    "text": "国际背景（魔幻现实主义与现代主义）、",
    "start": 17.44,
    "end": 20.4,
    "duration": 2.96
  },
  {
    "id": 6,
    "text": "核心宣言（韩少功《文学的“根”》）、",
    "start": 20.4,
    "end": 22.88,
    "duration": 2.48
  },
  {
    "id": 7,
    "text": "作家阵营。",
    "start": 22.88,
    "end": 23.6,
    "duration": 0.72
  },
  {
    "id": 8,
    "text": "二、第一支柱：思维转向•文化心理结构挖掘（韩少功）：采分点为超越浅层政治、",
    "start": 24.0,
    "end": 31.36,
    "duration": 7.36
  },
  {
    "id": 9,
    "text": "深层集体无意识、荒诞寓言与国民劣根性批判（《爸爸爸》丙崽）。",
    "start": 31.36,
    "end": 36.72,
    "duration": 5.36
  },
  {
    "id": 10,
    "text": "三、第二支柱：空间布局•地域文化多元崛起：采分点为边缘反拨中心、",
    "start": 36.72,
    "end": 43.2,
    "duration": 6.48
  },
  {
    "id": 11,
    "text": "地域版图（楚地、高密、商州、葛川江）、",
    "start": 43.2,
    "end": 46.88,
    "duration": 3.68
  },
  {
    "id": 12,
    "text": "民间民俗元气。",
    "start": 46.88,
    "end": 48.16,
    "duration": 1.28
  },
  {
    "id": 13,
    "text": "四、第三支柱：价值态度•野性赞美与伦理反思双重张力：采分点为原始生命强悍（《红高粱家族》）与儒家宗法仁义窒息（《小鲍庄》）的互补。",
    "start": 48.48,
    "end": 60.96,
    "duration": 12.48
  },
  {
    "id": 14,
    "text": "五、第四支柱：文体语言•笔记体传统与现代魔幻融合（阿城）：采分点为白话传统还乡、",
    "start": 60.96,
    "end": 69.28,
    "duration": 8.32
  },
  {
    "id": 15,
    "text": "世俗吃与道家禅意的化合（《棋王》）、",
    "start": 69.28,
    "end": 72.4,
    "duration": 3.12
  },
  {
    "id": 16,
    "text": "民族本土现代性。",
    "start": 72.4,
    "end": 73.68,
    "duration": 1.28
  },
  {
    "id": 17,
    "text": "六、总结提升层（约一百五十字）：文学史地位、",
    "start": 73.84,
    "end": 77.68,
    "duration": 3.84
  },
  {
    "id": 18,
    "text": "思维成熟、连接世界与启迪后继先锋文学。。",
    "start": 77.68,
    "end": 81.28,
    "duration": 3.6
  },
  {
    "id": 19,
    "text": "二、逐段内部咬合与考场得分句推导。",
    "start": 81.28,
    "end": 84.72,
    "duration": 3.44
  },
  {
    "id": 20,
    "text": "破题段：时代坐标与文化本体转向。",
    "start": 84.72,
    "end": 87.92,
    "duration": 3.2
  },
  {
    "id": 21,
    "text": "论证推演逻辑：先指出寻根文学是当代文学从政治反思到文化哲学深化的必由之路。",
    "start": 87.92,
    "end": 94.88,
    "duration": 6.96
  },
  {
    "id": 22,
    "text": "交代西方现代主义与拉美文学冲击的外因，",
    "start": 95.12,
    "end": 99.04,
    "duration": 3.92
  },
  {
    "id": 23,
    "text": "引出韩少功著名的，文学的“根”宣言与代表作家群。",
    "start": 99.04,
    "end": 103.84,
    "duration": 4.8
  },
  {
    "id": 24,
    "text": "具体表述到答题语句就是：二十世纪八十年代中期兴起的“寻根文学”，",
    "start": 103.84,
    "end": 109.76,
    "duration": 5.92
  },
  {
    "id": 25,
    "text": "是中国当代文学摆脱浅层政治社会学模式、",
    "start": 109.76,
    "end": 113.52,
    "duration": 3.76
  },
  {
    "id": 26,
    "text": "走向文化本体哲学的重大转向。",
    "start": 113.52,
    "end": 116.08,
    "duration": 2.56
  },
  {
    "id": 27,
    "text": "在西方现代主义思潮与拉美魔幻现实主义的激发下，",
    "start": 116.32,
    "end": 120.56,
    "duration": 4.24
  },
  {
    "id": 28,
    "text": "青年作家们深刻反思伤痕与反思小说的局限。",
    "start": 120.56,
    "end": 124.64,
    "duration": 4.08
  },
  {
    "id": 29,
    "text": "他们主张向民族精神源头逆流而上。",
    "start": 124.64,
    "end": 127.76,
    "duration": 3.12
  },
  {
    "id": 30,
    "text": "一九八五年韩少功发表《文学的“根”》，",
    "start": 127.76,
    "end": 130.96,
    "duration": 3.2
  },
  {
    "id": 31,
    "text": "明确提出“文学之根应深植于民族传统文化的土壤”。",
    "start": 130.96,
    "end": 135.36,
    "duration": 4.4
  },
  {
    "id": 32,
    "text": "阿城、韩少功、莫言、贾平凹、王安忆等作家应运而生。",
    "start": 135.6,
    "end": 141.12,
    "duration": 5.52
  },
  {
    "id": 33,
    "text": "寻根文学的思潮发生与审美探索主要体现在四个深层维度。",
    "start": 141.12,
    "end": 145.76,
    "duration": 4.64
  },
  {
    "id": 34,
    "text": "二十世纪八十年代中期兴起的“寻根文学”，",
    "start": 146.144,
    "end": 149.424,
    "duration": 3.28
  },
  {
    "id": 35,
    "text": "是中国当代文学摆脱浅层政治社会学模式、",
    "start": 149.424,
    "end": 152.944,
    "duration": 3.52
  },
  {
    "id": 36,
    "text": "走向文化本体哲学的重大转向。",
    "start": 152.944,
    "end": 155.584,
    "duration": 2.64
  },
  {
    "id": 37,
    "text": "在西方现代主义思潮与拉美魔幻现实主义的激发下，",
    "start": 155.584,
    "end": 159.744,
    "duration": 4.16
  },
  {
    "id": 38,
    "text": "青年作家们深刻反思伤痕与反思小说的局限。",
    "start": 159.744,
    "end": 163.664,
    "duration": 3.92
  },
  {
    "id": 39,
    "text": "他们主张向民族精神源头逆流而上。",
    "start": 163.664,
    "end": 166.064,
    "duration": 2.4
  },
  {
    "id": 40,
    "text": "一九八五年韩少功发表《文学的“根”》，",
    "start": 166.384,
    "end": 169.424,
    "duration": 3.04
  },
  {
    "id": 41,
    "text": "明确提出“文学之根应深植于民族传统文化的土壤”。",
    "start": 169.424,
    "end": 174.304,
    "duration": 4.88
  },
  {
    "id": 42,
    "text": "阿城、韩少功、莫言、贾平凹、王安忆等作家应运而生。",
    "start": 174.304,
    "end": 179.584,
    "duration": 5.28
  },
  {
    "id": 43,
    "text": "寻根文学的思潮发生与审美探索主要体现在四个深层维度。。",
    "start": 179.584,
    "end": 184.784,
    "duration": 5.2
  },
  {
    "id": 44,
    "text": "第一支柱：思维转向与深层心理结构（韩少功《爸爸爸》）。",
    "start": 184.784,
    "end": 189.744,
    "duration": 4.96
  },
  {
    "id": 45,
    "text": "-论证推演逻辑：核心是超越浅层政治制度归因，",
    "start": 189.744,
    "end": 194.003,
    "duration": 4.259
  },
  {
    "id": 46,
    "text": "走向民族集体无意识。",
    "start": 194.003,
    "end": 196.02,
    "duration": 2.017
  },
  {
    "id": 47,
    "text": "以韩少功《爸爸爸》为例，分析鸡头寨与丙崽这个文化活化石，",
    "start": 196.02,
    "end": 201.4,
    "duration": 5.38
  },
  {
    "id": 48,
    "text": "阐述其如何解剖民族停滞与蒙昧的深层文化根由。",
    "start": 201.4,
    "end": 206.107,
    "duration": 4.707
  },
  {
    "id": 49,
    "text": "具体表述到答题语句就是：第一，从政治社会学反思转向民族文化心理结构探寻。",
    "start": 206.107,
    "end": 213.504,
    "duration": 7.397
  },
  {
    "id": 50,
    "text": "新时期初期的文学多局限于政治拨乱反正与制度反思。",
    "start": 213.664,
    "end": 219.024,
    "duration": 5.36
  },
  {
    "id": 51,
    "text": "寻根作家则把目光投向了更深厚的历史底层。",
    "start": 219.024,
    "end": 222.864,
    "duration": 3.84
  },
  {
    "id": 52,
    "text": "他们不再满足于探讨文革动荡的政治表象，",
    "start": 222.864,
    "end": 226.304,
    "duration": 3.44
  },
  {
    "id": 53,
    "text": "而是追问产生这些历史悲剧的传统文化心理机制。",
    "start": 226.304,
    "end": 230.704,
    "duration": 4.4
  },
  {
    "id": 54,
    "text": "韩少功在《爸爸爸》中虚构了封闭绝望的湘西鸡头寨。",
    "start": 230.704,
    "end": 235.184,
    "duration": 4.48
  },
  {
    "id": 55,
    "text": "那个只会喊叫“爸爸”与“叉妈妈”的畸形儿丙崽，",
    "start": 235.504,
    "end": 239.344,
    "duration": 3.84
  },
  {
    "id": 56,
    "text": "成为数千年蒙昧停滞文化的活化石。",
    "start": 239.344,
    "end": 242.784,
    "duration": 3.44
  },
  {
    "id": 57,
    "text": "作家借助神话与荒诞象征，完成了对封建集体无意识与国民劣根性的冷峻解剖。",
    "start": 242.784,
    "end": 249.824,
    "duration": 7.04
  },
  {
    "id": 58,
    "text": "第一，从政治社会学反思转向民族文化心理结构探寻。",
    "start": 249.824,
    "end": 254.704,
    "duration": 4.88
  },
  {
    "id": 59,
    "text": "新时期初期的文学多局限于政治拨乱反正与制度反思。",
    "start": 254.704,
    "end": 259.024,
    "duration": 4.32
  },
  {
    "id": 60,
    "text": "寻根作家则把目光投向了更深厚的历史底层。",
    "start": 259.424,
    "end": 263.504,
    "duration": 4.08
  },
  {
    "id": 61,
    "text": "他们不再满足于探讨文革动荡的政治表象，",
    "start": 263.504,
    "end": 266.784,
    "duration": 3.28
  },
  {
    "id": 62,
    "text": "而是追问产生这些历史悲剧的传统文化心理机制。",
    "start": 266.784,
    "end": 271.344,
    "duration": 4.56
  },
  {
    "id": 63,
    "text": "韩少功在《爸爸爸》中虚构了封闭绝望的湘西鸡头寨。",
    "start": 271.344,
    "end": 275.984,
    "duration": 4.64
  },
  {
    "id": 64,
    "text": "那个只会喊叫“爸爸”与“叉妈妈”的畸形儿丙崽，",
    "start": 275.984,
    "end": 279.744,
    "duration": 3.76
  },
  {
    "id": 65,
    "text": "成为数千年蒙昧停滞文化的活化石。",
    "start": 279.744,
    "end": 282.544,
    "duration": 2.8
  },
  {
    "id": 66,
    "text": "作家借助神话与荒诞象征，完成了对封建集体无意识与国民劣根性的冷峻解剖。",
    "start": 282.944,
    "end": 289.344,
    "duration": 6.4
  },
  {
    "id": 67,
    "text": "--。第",
    "start": 289.344,
    "end": 289.504,
    "duration": 0.16
  },
  {
    "id": 68,
    "text": "二支柱：地域版图多元崛起与民间元气。",
    "start": 289.504,
    "end": 293.824,
    "duration": 4.32
  },
  {
    "id": 69,
    "text": "论证推演逻辑：寻根文学在地理空间上的突破是激活边缘。",
    "start": 293.824,
    "end": 299.488,
    "duration": 5.664
  },
  {
    "id": 70,
    "text": "反对单一中心，展现楚文化、齐鲁文化、",
    "start": 299.488,
    "end": 303.168,
    "duration": 3.68
  },
  {
    "id": 71,
    "text": "商州文化、吴越文化各领风骚，用民间鲜活的风俗神话冲破机械公式。",
    "start": 303.168,
    "end": 309.008,
    "duration": 5.84
  },
  {
    "id": 72,
    "text": "具体表述到答题语句就是：第二，地域文化版图的多元崛起与民间原生风貌重现。",
    "start": 309.008,
    "end": 316.048,
    "duration": 7.04
  },
  {
    "id": 73,
    "text": "寻根文学打破了单一中心的大一统叙事，",
    "start": 316.368,
    "end": 319.568,
    "duration": 3.2
  },
  {
    "id": 74,
    "text": "激活了辽阔版图上各具特色的边缘地域文化。",
    "start": 319.568,
    "end": 323.248,
    "duration": 3.68
  },
  {
    "id": 75,
    "text": "阿城沉醉于世俗市井与庄禅虚静，莫言深耕齐鲁胶东高密东北乡，",
    "start": 323.248,
    "end": 329.248,
    "duration": 6.0
  },
  {
    "id": 76,
    "text": "贾平凹构建苍凉神秘的商州古道，李杭育描绘蛮荒野性的葛川江。",
    "start": 329.248,
    "end": 334.848,
    "duration": 5.6
  },
  {
    "id": 77,
    "text": "这些作家从边缘乡土的巫挪、神话、",
    "start": 334.848,
    "end": 338.048,
    "duration": 3.2
  },
  {
    "id": 78,
    "text": "民俗与方言中汲取养分。",
    "start": 338.048,
    "end": 339.968,
    "duration": 1.92
  },
  {
    "id": 79,
    "text": "他们摆脱了教条化现实主义的干瘪概念，",
    "start": 340.288,
    "end": 343.408,
    "duration": 3.12
  },
  {
    "id": 80,
    "text": "为当代文学注入了饱满鲜活的地域水土与民间元气。",
    "start": 343.408,
    "end": 347.968,
    "duration": 4.56
  },
  {
    "id": 81,
    "text": "第二，地域文化版图的多元崛起与民间原生风貌重现。",
    "start": 347.968,
    "end": 352.768,
    "duration": 4.8
  },
  {
    "id": 82,
    "text": "寻根文学打破了单一中心的大一统叙事，",
    "start": 352.768,
    "end": 355.808,
    "duration": 3.04
  },
  {
    "id": 83,
    "text": "激活了辽阔版图上各具特色的边缘地域文化。",
    "start": 355.808,
    "end": 359.408,
    "duration": 3.6
  },
  {
    "id": 84,
    "text": "阿城沉醉于世俗市井与庄禅虚静，莫言深耕齐鲁胶东高密东北乡，",
    "start": 359.728,
    "end": 365.648,
    "duration": 5.92
  },
  {
    "id": 85,
    "text": "贾平凹构建苍凉神秘的商州古道，李杭育描绘蛮荒野性的葛川江。",
    "start": 365.648,
    "end": 371.328,
    "duration": 5.68
  },
  {
    "id": 86,
    "text": "这些作家从边缘乡土的巫挪、神话、",
    "start": 371.328,
    "end": 374.448,
    "duration": 3.12
  },
  {
    "id": 87,
    "text": "民俗与方言中汲取养分。",
    "start": 374.448,
    "end": 376.288,
    "duration": 1.84
  },
  {
    "id": 88,
    "text": "他们摆脱了教条化现实主义的干瘪概念，",
    "start": 376.288,
    "end": 379.168,
    "duration": 2.88
  },
  {
    "id": 89,
    "text": "为当代文学注入了饱满鲜活的地域水土与民间元气。",
    "start": 379.168,
    "end": 383.328,
    "duration": 4.16
  },
  {
    "id": 90,
    "text": "第三支柱：野性生命赞美与伦理反思张力（莫言、",
    "start": 383.568,
    "end": 387.808,
    "duration": 4.24
  },
  {
    "id": 91,
    "text": "王安忆）。",
    "start": 387.808,
    "end": 388.608,
    "duration": 0.8
  },
  {
    "id": 92,
    "text": "论证推演逻辑：寻根绝非简单的复古，",
    "start": 388.608,
    "end": 391.968,
    "duration": 3.36
  },
  {
    "id": 93,
    "text": "而是复杂的辩证审视。",
    "start": 391.968,
    "end": 393.808,
    "duration": 1.84
  },
  {
    "id": 94,
    "text": "一方面肯定未受压抑的野蛮生命力（莫言《红高粱家族》），",
    "start": 393.808,
    "end": 398.528,
    "duration": 4.72
  },
  {
    "id": 95,
    "text": "另一方面反思宗法伦理对人性的僵化扼杀（王安忆《小鲍庄》），",
    "start": 398.528,
    "end": 403.568,
    "duration": 5.04
  },
  {
    "id": 96,
    "text": "构成深刻张力。",
    "start": 403.568,
    "end": 404.848,
    "duration": 1.28
  },
  {
    "id": 97,
    "text": "具体表述到答题语句就是：第三，原初生命活力的炽烈礼赞与文化沉疴的批判张力。",
    "start": 404.848,
    "end": 412.344,
    "duration": 7.496
  },
  {
    "id": 98,
    "text": "寻根文学内部包含着复杂的双重文化态度。",
    "start": 412.344,
    "end": 415.784,
    "duration": 3.44
  },
  {
    "id": 99,
    "text": "一方面，作家们以狂欢化的笔触，歌颂民间未被现代文明污染的野性与生命力。",
    "start": 415.784,
    "end": 422.344,
    "duration": 6.56
  },
  {
    "id": 100,
    "text": "莫言在《红高粱家族》中塑造了敢生敢死、",
    "start": 422.344,
    "end": 425.784,
    "duration": 3.44
  },
  {
    "id": 101,
    "text": "野蛮豪放的爷爷余占鳌和奶奶戴凤莲。",
    "start": 425.784,
    "end": 428.904,
    "duration": 3.12
  },
  {
    "id": 102,
    "text": "他们体内奔腾着原始强悍的血性力量。",
    "start": 429.224,
    "end": 432.264,
    "duration": 3.04
  },
  {
    "id": 103,
    "text": "另一方面，作家们又清醒警惕儒家宗法伦理的僵化窒息。",
    "start": 432.264,
    "end": 437.624,
    "duration": 5.36
  },
  {
    "id": 104,
    "text": "王安忆在《小鲍庄》中反思传统“仁义”观念对个体生命力的压抑。",
    "start": 437.624,
    "end": 443.064,
    "duration": 5.44
  },
  {
    "id": 105,
    "text": "这种赞美与批判的张力，构成了寻根思潮深刻的哲学深度。",
    "start": 443.064,
    "end": 447.944,
    "duration": 4.88
  },
  {
    "id": 106,
    "text": "第三，原初生命活力的炽烈礼赞与文化沉疴的批判张力。",
    "start": 447.944,
    "end": 452.984,
    "duration": 5.04
  },
  {
    "id": 107,
    "text": "寻根文学内部包含着复杂的双重文化态度。",
    "start": 453.304,
    "end": 456.504,
    "duration": 3.2
  },
  {
    "id": 108,
    "text": "一方面，作家们以狂欢化的笔触，歌颂民间未被现代文明污染的野性与生命力。",
    "start": 456.504,
    "end": 462.984,
    "duration": 6.48
  },
  {
    "id": 109,
    "text": "莫言在《红高粱家族》中塑造了敢生敢死、",
    "start": 462.984,
    "end": 466.584,
    "duration": 3.6
  },
  {
    "id": 110,
    "text": "野蛮豪放的爷爷余占鳌和奶奶戴凤莲。",
    "start": 466.584,
    "end": 469.864,
    "duration": 3.28
  },
  {
    "id": 111,
    "text": "他们体内奔腾着原始强悍的血性力量。",
    "start": 469.864,
    "end": 472.664,
    "duration": 2.8
  },
  {
    "id": 112,
    "text": "另一方面，作家们又清醒警惕儒家宗法伦理的僵化窒息。",
    "start": 472.904,
    "end": 477.864,
    "duration": 4.96
  },
  {
    "id": 113,
    "text": "王安忆在《小鲍庄》中反思传统“仁义”观念对个体生命力的压抑。",
    "start": 477.864,
    "end": 483.384,
    "duration": 5.52
  },
  {
    "id": 114,
    "text": "这种赞美与批判的张力，构成了寻根思潮深刻的哲学深度。",
    "start": 483.384,
    "end": 488.664,
    "duration": 5.28
  },
  {
    "id": 115,
    "text": "--。第",
    "start": 488.664,
    "end": 488.824,
    "duration": 0.16
  },
  {
    "id": 116,
    "text": "四支柱：语言文体还乡与现代技巧融合（阿城《棋王》）。",
    "start": 488.824,
    "end": 493.544,
    "duration": 4.72
  },
  {
    "id": 117,
    "text": "-论证推演逻辑：文体层面分析。",
    "start": 493.784,
    "end": 496.552,
    "duration": 2.768
  },
  {
    "id": 118,
    "text": "寻根不仅寻内容之根，更寻汉语之根。",
    "start": 496.552,
    "end": 500.013,
    "duration": 3.461
  },
  {
    "id": 119,
    "text": "阿城《棋王》继承世俗白话与笔记风味，",
    "start": 500.013,
    "end": 503.473,
    "duration": 3.46
  },
  {
    "id": 120,
    "text": "将柴米油盐与道家庄禅结合。",
    "start": 503.473,
    "end": 506.242,
    "duration": 2.769
  },
  {
    "id": 121,
    "text": "同时吸纳现代派神话与魔幻技法，实现现代民族化。",
    "start": 506.242,
    "end": 511.086,
    "duration": 4.844
  },
  {
    "id": 122,
    "text": "具体表述到答题语句就是：第四，中国传统美学语感与现代主义技巧的交融化合。",
    "start": 511.086,
    "end": 518.664,
    "duration": 7.578
  },
  {
    "id": 123,
    "text": "寻根作家在文体上努力摆脱欧化语言的拘又，",
    "start": 518.664,
    "end": 522.504,
    "duration": 3.84
  },
  {
    "id": 124,
    "text": "积极向古典文体传统还乡。",
    "start": 522.504,
    "end": 525.304,
    "duration": 2.8
  },
  {
    "id": 125,
    "text": "阿城的《棋王》借鉴了明清世俗白话短篇与笔记小说的风致。",
    "start": 525.304,
    "end": 530.904,
    "duration": 5.6
  },
  {
    "id": 126,
    "text": "作家将世俗吃喝的烟火气，与王一生棋道通禅的虚静之美融为一体。",
    "start": 530.904,
    "end": 536.584,
    "duration": 5.68
  },
  {
    "id": 127,
    "text": "语言简练冲淡而蕴藉深远。",
    "start": 536.824,
    "end": 539.304,
    "duration": 2.48
  },
  {
    "id": 128,
    "text": "同时作家们普遍化用了拉美魔幻现实主义的神话原型手法。",
    "start": 539.304,
    "end": 544.184,
    "duration": 4.88
  },
  {
    "id": 129,
    "text": "他们将超自然幻象与日常生活严丝合缝地嵌合在一起，",
    "start": 544.184,
    "end": 548.664,
    "duration": 4.48
  },
  {
    "id": 130,
    "text": "创造出极具中国本土气派的现代东方叙事。",
    "start": 548.664,
    "end": 552.264,
    "duration": 3.6
  },
  {
    "id": 131,
    "text": "第四，中国传统美学语感与现代主义技巧的交融化合。",
    "start": 552.632,
    "end": 557.592,
    "duration": 4.96
  },
  {
    "id": 132,
    "text": "寻根作家在文体上努力摆脱欧化语言的拘又，",
    "start": 557.592,
    "end": 561.432,
    "duration": 3.84
  },
  {
    "id": 133,
    "text": "积极向古典文体传统还乡。",
    "start": 561.432,
    "end": 564.232,
    "duration": 2.8
  },
  {
    "id": 134,
    "text": "阿城的《棋王》借鉴了明清世俗白话短篇与笔记小说的风致。",
    "start": 564.232,
    "end": 569.832,
    "duration": 5.6
  },
  {
    "id": 135,
    "text": "作家将世俗吃喝的烟火气，与王一生棋道通禅的虚静之美融为一体。",
    "start": 569.832,
    "end": 575.512,
    "duration": 5.68
  },
  {
    "id": 136,
    "text": "语言简练冲淡而蕴藉深远。",
    "start": 575.752,
    "end": 578.072,
    "duration": 2.32
  },
  {
    "id": 137,
    "text": "同时作家们普遍化用了拉美魔幻现实主义的神话原型手法。",
    "start": 578.072,
    "end": 582.712,
    "duration": 4.64
  },
  {
    "id": 138,
    "text": "他们将超自然幻象与日常生活严丝合缝地嵌合在一起，",
    "start": 582.712,
    "end": 586.792,
    "duration": 4.08
  },
  {
    "id": 139,
    "text": "创造出极具中国本土气派的现代东方叙事。",
    "start": 586.792,
    "end": 590.392,
    "duration": 3.6
  },
  {
    "id": 140,
    "text": "--。总",
    "start": 590.392,
    "end": 590.552,
    "duration": 0.16
  },
  {
    "id": 141,
    "text": "结升华段：当代文学成熟与历史遗产。",
    "start": 590.552,
    "end": 593.592,
    "duration": 3.04
  },
  {
    "id": 142,
    "text": "-论证推演逻辑：总结提升。",
    "start": 593.752,
    "end": 595.787,
    "duration": 2.035
  },
  {
    "id": 143,
    "text": "评价寻根思潮在中国文学由封闭走向世界过程中的里程碑意义，",
    "start": 595.787,
    "end": 601.282,
    "duration": 5.495
  },
  {
    "id": 144,
    "text": "以及对后继文学的孕育作用。",
    "start": 601.282,
    "end": 603.724,
    "duration": 2.442
  },
  {
    "id": 145,
    "text": "具体表述到答题语句就是：寻根文学使中国当代文学在文化哲学上达到了新的思想成熟。",
    "start": 603.724,
    "end": 611.255,
    "duration": 7.531
  },
  {
    "id": 146,
    "text": "它既是对古老华夏文明基因的现代盘点，",
    "start": 611.255,
    "end": 614.715,
    "duration": 3.46
  },
  {
    "id": 147,
    "text": "也是汉语小说与世界现代文学平等对话的艺术宣言。",
    "start": 614.715,
    "end": 619.192,
    "duration": 4.477
  },
  {
    "id": 148,
    "text": "这场思潮不仅为后来的先锋小说奠定了文体准备，",
    "start": 619.272,
    "end": 623.272,
    "duration": 4.0
  },
  {
    "id": 149,
    "text": "更为当代文坛留下了丰厚的民族美学遗产。",
    "start": 623.272,
    "end": 626.952,
    "duration": 3.68
  },
  {
    "id": 150,
    "text": "寻根文学使中国当代文学在文化哲学上达到了新的思想成熟。",
    "start": 626.952,
    "end": 632.552,
    "duration": 5.6
  },
  {
    "id": 151,
    "text": "它既是对古老华夏文明基因的现代盘点，",
    "start": 632.552,
    "end": 635.592,
    "duration": 3.04
  },
  {
    "id": 152,
    "text": "也是汉语小说与世界现代文学平等对话的艺术宣言。",
    "start": 635.592,
    "end": 639.592,
    "duration": 4.0
  },
  {
    "id": 153,
    "text": "这场思潮不仅为后来的先锋小说奠定了文体准备，",
    "start": 639.912,
    "end": 643.832,
    "duration": 3.92
  },
  {
    "id": 154,
    "text": "更为当代文坛留下了丰厚的民族美学遗产。",
    "start": 643.832,
