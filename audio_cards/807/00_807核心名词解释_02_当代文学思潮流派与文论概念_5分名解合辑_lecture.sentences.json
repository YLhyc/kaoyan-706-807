[
  {
    "id": 1,
    "text": "807 核心名词解释（二）：",
    "start": 0.0,
    "end": 2.406,
    "duration": 2.406
  },
  {
    "id": 2,
    "text": "当代文学思潮流派与文论概念（5分名解合辑）。",
    "start": 2.406,
    "end": 6.961,
    "duration": 4.555
  },
  {
    "id": 3,
    "text": "1. 朦胧诗。",
    "start": 6.961,
    "end": 8.381,
    "duration": 1.42
  },
  {
    "id": 4,
    "text": "新时期之初伴随《今天》杂志创立而崛起的重要现代诗歌流派。",
    "start": 8.381,
    "end": 13.413,
    "duration": 5.032
  },
  {
    "id": 5,
    "text": "主要代表诗人有北岛、舒婷、顾城、江河等。",
    "start": 13.413,
    "end": 17.45,
    "duration": 4.037
  },
  {
    "id": 6,
    "text": "诗群打破政治教条抒情，",
    "start": 17.45,
    "end": 19.781,
    "duration": 2.331
  },
  {
    "id": 7,
    "text": "转向对主体独立尊严的确认与历史反思，广泛采用意象隐喻、",
    "start": 19.781,
    "end": 24.978,
    "duration": 5.197
  },
  {
    "id": 8,
    "text": "象征通感与多义歧解手法，因语言朦胧深邃而得名。",
    "start": 24.978,
    "end": 29.582,
    "duration": 4.604
  },
  {
    "id": 9,
    "text": "代表作有北岛《回答》、舒婷《致橡树》、顾城《一代人》。",
    "start": 29.582,
    "end": 34.089,
    "duration": 4.507
  },
  {
    "id": 10,
    "text": "它开启了当代文学的人性复归与诗体革命。",
    "start": 34.089,
    "end": 38.331,
    "duration": 4.242
  },
  {
    "id": 11,
    "text": "2. 先锋小说。",
    "start": 38.331,
    "end": 40.323,
    "duration": 1.992
  },
  {
    "id": 12,
    "text": "八十年代中后期受西方后现代主义影响爆发的文体形式激进实验思潮。",
    "start": 40.323,
    "end": 46.751,
    "duration": 6.428
  },
  {
    "id": 13,
    "text": "主要代表作家有马原、余华、格非、残雪等。",
    "start": 46.751,
    "end": 50.536,
    "duration": 3.785
  },
  {
    "id": 14,
    "text": "核心特征为解构传统因果情节与本质主义主题，",
    "start": 50.536,
    "end": 53.717,
    "duration": 3.181
  },
  {
    "id": 15,
    "text": "注重叙事迷宫建构、零度暴力解剖、时间拼贴与元叙事游戏。",
    "start": 53.717,
    "end": 58.826,
    "duration": 5.109
  },
  {
    "id": 16,
    "text": "代表作有马原《冈底斯的诱惑》、余华《现实一种》。",
    "start": 58.826,
    "end": 64.115,
    "duration": 5.289
  },
  {
    "id": 17,
    "text": "该思潮彻底刷新了当代汉语小说的形式思维与叙事观念。",
    "start": 64.115,
    "end": 70.379,
    "duration": 6.264
  },
  {
    "id": 18,
    "text": "3. 寻根文学。",
    "start": 70.379,
    "end": 70.933,
    "duration": 0.554
  },
  {
    "id": 19,
    "text": "八十年代中期文坛兴起的向民族深层历史文化心理结构探寻的文学思潮。",
    "start": 70.933,
    "end": 77.685,
    "duration": 6.752
  },
  {
    "id": 20,
    "text": "以韩少功发表《文学的“根”》为理论先导，",
    "start": 77.685,
    "end": 78.924,
    "duration": 1.239
  },
  {
    "id": 21,
    "text": "代表作家有韩少功、阿城、李杭育、贾平凹等。",
    "start": 78.924,
    "end": 84.168,
    "duration": 5.244
  },
  {
    "id": 22,
    "text": "主张跳出狭隘的政治社会学批判，深入儒道精神、",
    "start": 84.168,
    "end": 86.573,
    "duration": 2.405
  },
  {
    "id": 23,
    "text": "地域风俗与原始野性中寻觅民族生命力。",
    "start": 86.573,
    "end": 91.708,
    "duration": 5.135
  },
  {
    "id": 24,
    "text": "代表作有阿城《棋王》、韩少功《爸爸爸》。",
    "start": 91.708,
    "end": 94.372,
    "duration": 2.664
  },
  {
    "id": 25,
    "text": "它拓展了当代小说的文化哲学深度。",
    "start": 94.372,
    "end": 98.164,
    "duration": 3.792
  },
  {
    "id": 26,
    "text": "4. 新写实小说。",
    "start": 98.164,
    "end": 101.168,
    "duration": 3.004
  },
  {
    "id": 27,
    "text": "八十年代末至九十年代初兴起于《钟山》等刊物的重要小说流派。",
    "start": 101.168,
    "end": 107.732,
    "duration": 6.564
  },
  {
    "id": 28,
    "text": "主要代表作家有池莉、刘震云、方方等。",
    "start": 107.732,
    "end": 109.5,
    "duration": 1.768
  },
  {
    "id": 29,
    "text": "核心特质为摒弃崇高神话与英雄叙事，",
    "start": 109.5,
    "end": 113.439,
    "duration": 3.939
  },
  {
    "id": 30,
    "text": "转向呈现普通平民日常生存“毛茸茸的原生态”，",
    "start": 113.439,
    "end": 117.361,
    "duration": 3.922
  },
  {
    "id": 31,
    "text": "以客观冷静的零度情感直面琐屑人生烦恼。",
    "start": 117.361,
    "end": 120.733,
    "duration": 3.372
  },
  {
    "id": 32,
    "text": "代表作有池莉《烦恼人生》、刘震云《一地鸡毛》、方方《风景》。",
    "start": 120.733,
    "end": 126.742,
    "duration": 6.009
  },
  {
    "id": 33,
    "text": "它标志着现实主义文学向平民立场的历史归航。",
    "start": 126.742,
    "end": 128.467,
    "duration": 1.725
  },
  {
    "id": 34,
    "text": "5. 文化散文。",
    "start": 128.467,
    "end": 132.871,
    "duration": 4.404
  },
  {
    "id": 35,
    "text": "九十年代初随着余秋雨《文化苦旅》畅销而风靡文坛的一种学者型大散文范式。",
    "start": 132.871,
    "end": 140.489,
    "duration": 7.618
  },
  {
    "id": 36,
    "text": "代表作家有余秋雨、张承志等。",
    "start": 140.489,
    "end": 141.842,
    "duration": 1.353
  },
  {
    "id": 37,
    "text": "其文体特征为将游记考察、",
    "start": 141.842,
    "end": 143.58,
    "duration": 1.738
  },
  {
    "id": 38,
    "text": "宏大历史掌故钩沉与个体生命哲学拷问深度融铸，",
    "start": 143.58,
    "end": 150.424,
    "duration": 6.844
  },
  {
    "id": 39,
    "text": "行文气势磅礴、抒情浓烈，",
    "start": 150.424,
    "end": 152.783,
    "duration": 2.359
  },
  {
    "id": 40,
    "text": "致力于在自然历史废墟上反思中华文明兴衰与文人宿命，",
    "start": 152.783,
    "end": 157.337,
    "duration": 4.554
  },
  {
    "id": 41,
    "text": "极大提升了当代散文的文化厚度与公共传播力。",
    "start": 157.337,
    "end": 161.249,
    "duration": 3.912
  },
  {
    "id": 42,
    "text": "6. 第三代诗歌。",
    "start": 161.249,
    "end": 161.767,
    "duration": 0.518
  },
  {
    "id": 43,
    "text": "八十年代中期继朦胧诗之后崛起的大规模青年青年诗人群体（又称“后朦胧诗”或“新生代诗歌”）。",
    "start": 161.767,
    "end": 169.487,
    "duration": 7.72
  },
  {
    "id": 44,
    "text": "代表派别有“莽汉主义”“他们”等，主要诗人有韩东、于坚等。",
    "start": 169.487,
    "end": 173.848,
    "duration": 4.361
  },
  {
    "id": 45,
    "text": "核心主张“反崇高、反英雄、消解隐喻”，",
    "start": 173.848,
    "end": 179.497,
    "duration": 5.649
  },
  {
    "id": 46,
    "text": "提出“诗到语言为止”，以口语化、口语日常、",
    "start": 179.497,
    "end": 181.365,
    "duration": 1.868
  },
  {
    "id": 47,
    "text": "游戏调侃与反讽姿态解构朦胧诗的英雄主义情结，",
    "start": 181.365,
    "end": 185.263,
    "duration": 3.898
  },
  {
    "id": 48,
    "text": "开辟了平民日常诗学的新天地。",
    "start": 185.263,
    "end": 187.753,
    "duration": 2.49
  },
  {
    "id": 49,
    "text": "7. 打工诗歌。",
    "start": 187.753,
    "end": 190.352,
    "duration": 2.599
  },
  {
    "id": 50,
    "text": "九十年代随着我国南方沿海特区工业化与农民工进城潮兴起的新型底层诗歌流派。",
    "start": 190.352,
    "end": 195.454,
    "duration": 5.102
  },
  {
    "id": 51,
    "text": "主要创作者为进城务工的流动劳工，代表诗人有郑小琼、许立志等。",
    "start": 195.454,
    "end": 202.272,
    "duration": 6.818
  },
  {
    "id": 52,
    "text": "核心特质为真实直击流水线机器轰鸣、加班透支、",
    "start": 202.272,
    "end": 205.958,
    "duration": 3.686
  },
  {
    "id": 53,
    "text": "工伤流血与异乡漂泊的肉体创痛与尊严诉求，语言粗粝真实、",
    "start": 205.958,
    "end": 212.149,
    "duration": 6.191
  },
  {
    "id": 54,
    "text": "血肉模糊，",
    "start": 212.149,
    "end": 213.532,
    "duration": 1.383
  },
  {
    "id": 55,
    "text": "是中国当代工业文明底层劳工最具震撼力的生命证词。",
    "start": 213.532,
    "end": 216.063,
    "duration": 2.531
  },
  {
    "id": 56,
    "text": "8. “双百”方针。",
    "start": 216.063,
    "end": 220.442,
    "duration": 4.379
  },
  {
    "id": 57,
    "text": "五十年代中期党在领导文艺与科学研究工作中提出的核心指导方针。",
    "start": 220.442,
    "end": 227.905,
    "duration": 7.463
  },
  {
    "id": 58,
    "text": "全称为“百花齐放，百家争鸣”，即艺术问题上百花齐放、",
    "start": 227.905,
    "end": 230.542,
    "duration": 2.637
  },
  {
    "id": 59,
    "text": "学术问题上百家争鸣。",
    "start": 230.542,
    "end": 232.695,
    "duration": 2.153
  },
  {
    "id": 60,
    "text": "旨在调动知识分子积极性，",
    "start": 232.695,
    "end": 234.848,
    "duration": 2.153
  },
  {
    "id": 61,
    "text": "促进学术文化与社会主义文艺的多样繁荣，",
    "start": 234.848,
    "end": 237.032,
    "duration": 2.184
  },
  {
    "id": 62,
    "text": "成为当代中国思想文化政策的重要基石，",
    "start": 237.032,
    "end": 240.56,
    "duration": 3.528
  },
  {
    "id": 63,
    "text": "在当代文学体制演进中具有极其深远的历史影响。",
    "start": 240.56,
    "end": 246.048,
    "duration": 5.488
  },
  {
    "id": 64,
    "text": "9. 伤痕文学。",
    "start": 246.048,
    "end": 248.279,
    "duration": 2.231
  },
  {
    "id": 65,
    "text": "新时期初期随着卢新华短篇小说《伤痕》发表而命名并兴起的一股文学思潮。",
    "start": 248.279,
    "end": 256.281,
    "duration": 8.002
  },
  {
    "id": 66,
    "text": "主要代表作有刘心武《班主任》、卢新华《伤痕》、",
    "start": 256.281,
    "end": 257.423,
    "duration": 1.142
  },
  {
    "id": 67,
    "text": "从维熙《大墙下的红玉兰》等。",
    "start": 257.423,
    "end": 262.491,
    "duration": 5.068
  },
  {
    "id": 68,
    "text": "核心特质是以控诉和哀怨的悲情笔调，",
    "start": 262.491,
    "end": 265.459,
    "duration": 2.968
  },
  {
    "id": 69,
    "text": "真实展现浩劫对普通人灵魂与肉体的摧残，",
    "start": 265.459,
    "end": 269.096,
    "duration": 3.637
  },
  {
    "id": 70,
    "text": "呼唤人道主义关怀与真情复归，",
    "start": 269.096,
    "end": 271.468,
    "duration": 2.372
  },
  {
    "id": 71,
    "text": "拉开了新时期文学反思历史的序幕。",
    "start": 271.468,
    "end": 274.187,
    "duration": 2.719
  },
  {
    "id": 72,
    "text": "10. 反思文学。",
    "start": 274.187,
    "end": 275.85,
    "duration": 1.663
  },
  {
    "id": 73,
    "text": "七十年代末在伤痕文学基础上深化发展起来的文学思潮。",
    "start": 275.85,
    "end": 280.686,
    "duration": 4.836
  },
  {
    "id": 74,
    "text": "主要代表作家作品有茹志鹃《剪辑错了的故事》、",
    "start": 280.686,
    "end": 284.7,
    "duration": 4.014
  },
  {
    "id": 75,
    "text": "张贤亮《灵与肉》、高晓声“陈奂生系列”、",
    "start": 284.7,
    "end": 288.618,
    "duration": 3.918
  },
  {
    "id": 76,
    "text": "古华《芙蓉镇》等。",
    "start": 288.618,
    "end": 290.121,
    "duration": 1.503
  },
  {
    "id": 77,
    "text": "思潮不再局限于控诉个人受害遭遇，",
    "start": 290.121,
    "end": 293.101,
    "duration": 2.98
  },
  {
    "id": 78,
    "text": "而是将批判视野延伸至建国后极左路线的历史渊源，从政治、",
    "start": 293.101,
    "end": 297.782,
    "duration": 4.681
  },
  {
    "id": 79,
    "text": "经济与思想根源上展开深层反思，思想深度显著超越伤痕文学。",
    "start": 297.782,
    "end": 302.195,
    "duration": 4.413
  },
  {
    "id": 80,
    "text": "11. 改革文学。",
    "start": 302.195,
    "end": 305.371,
    "duration": 3.176
  },
  {
    "id": 81,
    "text": "八十年代初伴随全党工作重心转移和改革开放全面启动而兴起的主旋律文学思潮。",
    "start": 305.371,
    "end": 313.552,
    "duration": 8.181
  },
  {
    "id": 82,
    "text": "主要代表作有蒋子龙《乔厂长上任记》、张洁《沉重的翅膀》、",
    "start": 313.552,
    "end": 316.9,
    "duration": 3.348
  },
  {
    "id": 83,
    "text": "柯云路《新星》等。",
    "start": 316.9,
    "end": 318.663,
    "duration": 1.763
  },
  {
    "id": 84,
    "text": "核心特质是以火热的政治激情歌颂敢于打破体制僵化、",
    "start": 318.663,
    "end": 324.804,
    "duration": 6.141
  },
  {
    "id": 85,
    "text": "勇挑重担的现代改革开拓者形象，",
    "start": 324.804,
    "end": 327.753,
    "duration": 2.949
  },
  {
    "id": 86,
    "text": "真实反映新旧体制交替之际的观念博弈与时代阵痛，",
    "start": 327.753,
    "end": 331.957,
    "duration": 4.204
  },
  {
    "id": 87,
    "text": "具有极强的现实干预性。",
    "start": 331.957,
    "end": 334.071,
    "duration": 2.114
  },
  {
    "id": 88,
    "text": "12. 《受戒》。",
    "start": 334.071,
    "end": 334.781,
    "duration": 0.71
  },
  {
    "id": 89,
    "text": "八十年代初汪曾祺发表的短篇小说代表作。",
    "start": 334.781,
    "end": 339.25,
    "duration": 4.469
  },
  {
    "id": 90,
    "text": "小说以苏北高邮乡村庵赵庄为背景，打破戏剧性冲突，",
    "start": 339.25,
    "end": 342.581,
    "duration": 3.331
  },
  {
    "id": 91,
    "text": "以从容散淡的笔致描摹水乡风物与和尚世俗生活。",
    "start": 342.581,
    "end": 348.505,
    "duration": 5.924
  },
  {
    "id": 92,
    "text": "通过小和尚明海与农家少女小英子在荸荠田与渡船上的纯真爱恋，",
    "start": 348.505,
    "end": 351.74,
    "duration": 3.235
  },
  {
    "id": 93,
    "text": "展现了不受封建礼教污染的健康自然人性美，",
    "start": 351.74,
    "end": 354.431,
    "duration": 2.691
  },
  {
    "id": 94,
    "text": "确立了新时期“散文化小说”的抒情美学坐标。",
    "start": 354.431,
    "end": 358.168,
    "duration": 3.737
  },
  {
    "id": 95,
    "text": "13. 《红岩》。",
    "start": 358.168,
    "end": 361.917,
    "duration": 3.749
  },
  {
    "id": 96,
    "text": "六十年代初罗广斌、杨益言创作的长篇革命历史小说。",
    "start": 361.917,
    "end": 368.515,
    "duration": 6.598
  },
  {
    "id": 97,
    "text": "作品以重庆解放前夕渣滓洞、白公馆特务集中营为舞台，",
    "start": 368.515,
    "end": 372.94,
    "duration": 4.425
  },
  {
    "id": 98,
    "text": "生动塑造了江姐、许云峰、",
    "start": 372.94,
    "end": 375.21,
    "duration": 2.27
  },
  {
    "id": 99,
    "text": "华子良等视死如归的共产党人英雄群像，",
    "start": 375.21,
    "end": 378.458,
    "duration": 3.248
  },
  {
    "id": 100,
    "text": "展现了残酷狱中斗争与越狱暴动，",
    "start": 378.458,
    "end": 381.398,
    "duration": 2.94
  },
  {
    "id": 101,
    "text": "以崇高的革命英雄主义与牺牲精神，",
    "start": 381.398,
    "end": 384.151,
    "duration": 2.753
  },
  {
    "id": 102,
    "text": "成为十七年中国当代革命历史题材小说的经典红色丰碑。",
    "start": 384.151,
    "end": 388.878,
    "duration": 4.727
  },
  {
    "id": 103,
    "text": "14. 《文学革命论》。",
    "start": 388.878,
    "end": 389.561,
    "duration": 0.683
  },
  {
    "id": 104,
    "text": "五四文学革命纲领性文献。",
    "start": 389.561,
    "end": 392.985,
    "duration": 3.424
  },
  {
    "id": 105,
    "text": "陈独秀在《新青年》发表，明确提出推倒贵族文学、",
    "start": 392.985,
    "end": 394.835,
    "duration": 1.85
  },
  {
    "id": 106,
    "text": "古典文学与山林文学，建设国民文学、",
    "start": 394.835,
    "end": 398.811,
    "duration": 3.976
  },
  {
    "id": 107,
    "text": "写实文学与社会文学的“三大主义”，",
    "start": 398.811,
    "end": 402.72,
    "duration": 3.909
  },
  {
    "id": 108,
    "text": "不仅在形式上倡导白话文，",
    "start": 402.72,
    "end": 404.947,
    "duration": 2.227
  },
  {
    "id": 109,
    "text": "更在思想内容上确立了现代文学面向平民大众与社会现实的革命方向，",
    "start": 404.947,
    "end": 411.088,
    "duration": 6.141
  },
  {
    "id": 110,
    "text": "吹响了中国新文学运动全面决战的进军号角。",
    "start": 411.088,
    "end": 415.121,
    "duration": 4.033
  },
  {
    "id": 111,
    "text": "15. 鸳鸯蝴蝶派。",
    "start": 415.121,
    "end": 417.115,
    "duration": 1.994
  },
  {
    "id": 112,
    "text": "清末民初发端于上海租界、",
    "start": 417.115,
    "end": 421.216,
    "duration": 4.101
  },
  {
    "id": 113,
    "text": "盛行于二十年代前后的现代都市大众通俗文学流派。",
    "start": 421.216,
    "end": 423.733,
    "duration": 2.517
  },
  {
    "id": 114,
    "text": "主要刊物有《礼拜六》等，代表作家有包天笑、徐枕亚、张恨水等。",
    "start": 423.733,
    "end": 428.97,
    "duration": 5.237
  },
  {
    "id": 115,
    "text": "作品以才子佳人言情、社会黑幕与武侠侦探为核心内容，",
    "start": 428.97,
    "end": 433.767,
    "duration": 4.797
  },
  {
    "id": 116,
    "text": "迎合市民阶层消遣娱乐心理，",
    "start": 433.767,
    "end": 436.075,
    "duration": 2.308
  },
  {
    "id": 117,
    "text": "是传统通俗小说向现代商业文化转型过渡的重要文学形态。",
    "start": 436.075,
    "end": 440.942,
    "duration": 4.867
  },
  {
    "id": 118,
    "text": "16. 乡土小说。",
    "start": 440.942,
    "end": 442.515,
    "duration": 1.573
  },
  {
    "id": 119,
    "text": "二十年代鲁迅在《中国新文学大系》中命名的一个现代小说重要流派。",
    "start": 442.515,
    "end": 449.381,
    "duration": 6.866
  },
  {
    "id": 120,
    "text": "主要代表作家为鲁彦、台静农、彭家煌等远离故土的游子。",
    "start": 449.381,
    "end": 453.176,
    "duration": 3.795
  },
  {
    "id": 121,
    "text": "作家身处异乡都市，",
    "start": 453.176,
    "end": 454.95,
    "duration": 1.774
  },
  {
    "id": 122,
    "text": "以悲悯而冷峻的现代启蒙眼光回望闭塞闭塞的原乡，",
    "start": 454.95,
    "end": 459.644,
    "duration": 4.694
  },
  {
    "id": 123,
    "text": "深情描摹乡土风俗与国民劣根性，",
    "start": 459.644,
    "end": 462.834,
    "duration": 3.19
  },
  {
    "id": 124,
    "text": "形成了写实批判与怀乡感伤交织的独特审美风貌。",
    "start": 462.834,
    "end": 467.04,
    "duration": 4.206
  }
]