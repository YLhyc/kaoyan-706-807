[
  {
    "id": 1,
    "text": "八十年代中后期至九十年代，余华的文学创作由激进纯粹的“先锋形式实验”转向沉潜温厚的“民间生存叙事”。",
    "start": 0.113,
    "end": 9.177,
    "duration": 9.064
  },
  {
    "id": 2,
    "text": "这一轨迹体现了作家个体美学探索的成熟，",
    "start": 9.575,
    "end": 12.443,
    "duration": 2.868
  },
  {
    "id": 3,
    "text": "也构成了新时期当代小说文体演进的核心切片，其转型主要体现于以下三个维度：",
    "start": 12.639,
    "end": 19.264,
    "duration": 6.625
  },
  {
    "id": 4,
    "text": "第一，叙事重心由形式暴力的哲学拆解，转向对凡俗底层苦难的深切体认。",
    "start": 19.919,
    "end": 26.423,
    "duration": 6.504
  },
  {
    "id": 5,
    "text": "先锋时期的余华以《现实一种》《一九八六年》闻名，",
    "start": 26.691,
    "end": 30.737,
    "duration": 4.046
  },
  {
    "id": 6,
    "text": "其中《现实一种》着力描写血腥杀戮与非理性本能，通过山岗与山峰两家孩童相害引发的兄弟惨烈报复乃至尸体拆解，",
    "start": 31.012,
    "end": 40.862,
    "duration": 9.85
  },
  {
    "id": 7,
    "text": "冷酷摧毁传统宗法人伦的温情面纱，视世界为荒诞迷宫；",
    "start": 41.17,
    "end": 46.102,
    "duration": 4.932
  },
  {
    "id": 8,
    "text": "进入九十年代，余华在《活着》《许三观卖血记》中走出暴力迷狂，",
    "start": 46.321,
    "end": 51.351,
    "duration": 5.03
  },
  {
    "id": 9,
    "text": "转而凝视普通平民在动荡岁月中的坚韧承受，赋予苦难中的微小生命以厚重的人性尊严。",
    "start": 51.717,
    "end": 59.133,
    "duration": 7.416
  },
  {
    "id": 10,
    "text": "第二，叙事视角由冷漠客观的“零度叙事”，转向温润深情的“民间说话人视点”。",
    "start": 59.818,
    "end": 66.261,
    "duration": 6.443
  },
  {
    "id": 11,
    "text": "先锋探索阶段，余华以近乎冷漠的生理学白描剔除主观道德与人道关怀，",
    "start": 66.625,
    "end": 72.565,
    "duration": 5.94
  },
  {
    "id": 12,
    "text": "将人物物化为被命运玩弄的零件；",
    "start": 72.796,
    "end": 75.439,
    "duration": 2.643
  },
  {
    "id": 13,
    "text": "九十年代转型后，他在《许三观卖血记》中深度吸纳中国传统民间叙事的说唱基因与世俗智慧，",
    "start": 75.806,
    "end": 83.396,
    "duration": 7.59
  },
  {
    "id": 14,
    "text": "通过许三观在饥荒之年用嘴为孩子们“炒猪肝”的辛酸而温馨的场景，",
    "start": 83.674,
    "end": 89.208,
    "duration": 5.534
  },
  {
    "id": 15,
    "text": "以朴拙的循环复沓对话，建构起充满烟火暖意与草根温情的民间叙事立场。",
    "start": 89.561,
    "end": 95.909,
    "duration": 6.348
  },
  {
    "id": 16,
    "text": "第三，生存哲学由虚无荒诞的绝望境地，升华为向死而生的坚韧生命意志。",
    "start": 96.53,
    "end": 103.879,
    "duration": 7.349
  },
  {
    "id": 17,
    "text": "如果说先锋时期揭示的是命运的荒诞与无从逃脱的死局，",
    "start": 104.584,
    "end": 109.257,
    "duration": 4.673
  },
  {
    "id": 18,
    "text": "那么九十年代的余华则重新发现了中国普通平民的生存韧性与和解力量。",
    "start": 109.62,
    "end": 115.478,
    "duration": 5.858
  },
  {
    "id": 19,
    "text": "在《许三观卖血记》中，许三观为挽救非亲生的重病儿子一乐，",
    "start": 116.016,
    "end": 120.55,
    "duration": 4.534
  },
  {
    "id": 20,
    "text": "乘船坐车辗转赴沪一路卖血直至休克抽搐，以肉身的极限损耗践行了父性大爱，",
    "start": 120.841,
    "end": 127.911,
    "duration": 7.07
  },
  {
    "id": 21,
    "text": "最终在家人相伴共享寻常烟火的温情中与艰辛现实达成和解，",
    "start": 128.225,
    "end": 133.627,
    "duration": 5.402
  },
  {
    "id": 22,
    "text": "确立了当代文学中动人心魄的生命哲学。",
    "start": 133.958,
    "end": 136.916,
    "duration": 2.958
  }
]