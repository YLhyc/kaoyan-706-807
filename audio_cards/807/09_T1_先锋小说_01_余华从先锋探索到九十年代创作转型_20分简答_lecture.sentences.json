[
  {
    "id": 1,
    "text": "八十年代中后期至九十年代，",
    "start": 0.113,
    "end": 2.086,
    "duration": 1.973
  },
  {
    "id": 2,
    "text": "余华的文学创作由激进纯粹的“先锋形式实验”转向沉潜温厚的“民间生存叙事”。",
    "start": 2.364,
    "end": 9.167,
    "duration": 6.803
  },
  {
    "id": 3,
    "text": "这一轨迹体现了作家个体美学探索的成熟，",
    "start": 9.575,
    "end": 12.433,
    "duration": 2.858
  },
  {
    "id": 4,
    "text": "也构成了新时期当代小说文体演进的核心切片，",
    "start": 12.639,
    "end": 16.267,
    "duration": 3.628
  },
  {
    "id": 5,
    "text": "其转型主要体现于以下三个维度：",
    "start": 16.801,
    "end": 19.254,
    "duration": 2.453
  },
  {
    "id": 6,
    "text": "第一，叙事重心由形式暴力的哲学拆解，",
    "start": 19.919,
    "end": 23.329,
    "duration": 3.41
  },
  {
    "id": 7,
    "text": "转向对凡俗底层苦难的深切体认。",
    "start": 23.493,
    "end": 26.414,
    "duration": 2.921
  },
  {
    "id": 8,
    "text": "先锋时期的余华以《现实一种》《一九八六年》闻名，",
    "start": 26.691,
    "end": 30.727,
    "duration": 4.036
  },
  {
    "id": 9,
    "text": "小说着力描写血腥杀戮与非理性本能，通过兄杀弟、",
    "start": 31.012,
    "end": 35.332,
    "duration": 4.32
  },
  {
    "id": 10,
    "text": "弟虐兄直至分尸的极端仪式，",
    "start": 35.637,
    "end": 37.892,
    "duration": 2.255
  },
  {
    "id": 11,
    "text": "冷酷摧毁传统宗法人伦的温情面纱，视世界为荒诞迷宫；",
    "start": 38.21,
    "end": 43.133,
    "duration": 4.923
  },
  {
    "id": 12,
    "text": "进入九十年代，",
    "start": 43.361,
    "end": 44.401,
    "duration": 1.04
  },
  {
    "id": 13,
    "text": "余华在《活着》《许三观卖血记》中走出暴力迷狂，",
    "start": 44.688,
    "end": 48.381,
    "duration": 3.693
  },
  {
    "id": 14,
    "text": "转而凝视普通平民在动荡岁月中的坚韧承受，",
    "start": 48.757,
    "end": 52.287,
    "duration": 3.53
  },
  {
    "id": 15,
    "text": "赋予苦难中的微小生命以厚重的人性尊严。",
    "start": 52.704,
    "end": 56.163,
    "duration": 3.459
  },
  {
    "id": 16,
    "text": "第二，叙事视角由冷漠客观的“零度叙事”，",
    "start": 56.858,
    "end": 60.227,
    "duration": 3.369
  },
  {
    "id": 17,
    "text": "转向温润深情的“民间说话人视点”。",
    "start": 60.596,
    "end": 63.291,
    "duration": 2.695
  },
  {
    "id": 18,
    "text": "先锋探索阶段，",
    "start": 63.665,
    "end": 64.718,
    "duration": 1.053
  },
  {
    "id": 19,
    "text": "余华以近乎冷漠的生理学白描剔除主观道德与人道关怀，",
    "start": 64.95,
    "end": 69.595,
    "duration": 4.645
  },
  {
    "id": 20,
    "text": "将人物物化为被命运玩弄的零件；九十年代转型后，",
    "start": 69.836,
    "end": 73.981,
    "duration": 4.145
  },
  {
    "id": 21,
    "text": "他在《许三观卖血记》中深度吸纳中国传统民间叙事的说唱基因与世俗智慧，",
    "start": 74.423,
    "end": 80.426,
    "duration": 6.003
  },
  {
    "id": 22,
    "text": "通过许三观在饥荒之年用嘴为孩子们“炒猪肝”的辛酸而温馨的场景，",
    "start": 80.714,
    "end": 86.238,
    "duration": 5.524
  },
  {
    "id": 23,
    "text": "以朴拙的循环复沓对话，",
    "start": 86.601,
    "end": 88.329,
    "duration": 1.728
  },
  {
    "id": 24,
    "text": "建构起充满烟火暖意与草根温情的民间叙事立场。",
    "start": 88.639,
    "end": 92.939,
    "duration": 4.3
  },
  {
    "id": 25,
    "text": "第三，生存哲学由虚无荒诞的绝望境地，",
    "start": 93.57,
    "end": 97.415,
    "duration": 3.845
  },
  {
    "id": 26,
    "text": "升华为向死而生的坚韧生命意志。",
    "start": 97.87,
    "end": 100.909,
    "duration": 3.039
  },
  {
    "id": 27,
    "text": "如果说先锋时期揭示的是命运的荒诞与无从逃脱的死局，",
    "start": 101.624,
    "end": 106.292,
    "duration": 4.668
  },
  {
    "id": 28,
    "text": "那么九十年代的余华则重新发现了中国农民的生存韧性与和解力量。",
    "start": 106.66,
    "end": 112.047,
    "duration": 5.387
  },
  {
    "id": 29,
    "text": "在《许三观卖血记》中，许三观为挽救非亲生的重病儿子一乐，",
    "start": 112.593,
    "end": 117.117,
    "duration": 4.524
  },
  {
    "id": 30,
    "text": "沿着铁路线一路卖血直至休克抽搐，",
    "start": 117.418,
    "end": 120.543,
    "duration": 3.125
  },
  {
    "id": 31,
    "text": "以肉身的极限损耗践行了父性大爱，",
    "start": 120.943,
    "end": 123.731,
    "duration": 2.788
  },
  {
    "id": 32,
    "text": "最终在家人相伴共享寻常烟火的温情中与艰辛现实达成和解，",
    "start": 124.054,
    "end": 129.446,
    "duration": 5.392
  },
  {
    "id": 33,
    "text": "确立了当代文学中动人心魄的生命哲学。",
    "start": 129.787,
    "end": 132.745,
    "duration": 2.958
  }
]