[
  {
    "id": 1,
    "text": "八十年代中后期至九十年代，",
    "start": 0.0,
    "end": 2.678,
    "duration": 2.678
  },
  {
    "id": 2,
    "text": "余华的文学创作完成了由激进纯粹的“先锋形式实验”向沉潜温厚的“民间生存叙事”的深刻转型。",
    "start": 2.678,
    "end": 10.734,
    "duration": 8.056
  },
  {
    "id": 3,
    "text": "这一轨迹不仅体现了作家个体美学探索的成熟，",
    "start": 10.734,
    "end": 14.414,
    "duration": 3.68
  },
  {
    "id": 4,
    "text": "更构成了新时期当代小说文体演进的核心切片，",
    "start": 14.414,
    "end": 18.389,
    "duration": 3.975
  },
  {
    "id": 5,
    "text": "其转型机制主要体现于以下三个维度：",
    "start": 18.389,
    "end": 21.738,
    "duration": 3.349
  },
  {
    "id": 6,
    "text": "第一，叙事重心由形式暴力的哲学解构，",
    "start": 21.738,
    "end": 25.834,
    "duration": 4.096
  },
  {
    "id": 7,
    "text": "转向对凡俗底层苦难的深切体认。",
    "start": 25.834,
    "end": 29.164,
    "duration": 3.33
  },
  {
    "id": 8,
    "text": "先锋时期的余华以《现实一种》《一九八六年》闻名，",
    "start": 29.164,
    "end": 35.833,
    "duration": 6.669
  },
  {
    "id": 9,
    "text": "小说热衷于解剖血腥杀戮与非理性本能，通过兄杀弟、",
    "start": 35.833,
    "end": 41.012,
    "duration": 5.179
  },
  {
    "id": 10,
    "text": "弟虐兄直至分尸的极端仪式，",
    "start": 41.012,
    "end": 44.313,
    "duration": 3.301
  },
  {
    "id": 11,
    "text": "冷酷摧毁传统宗法人伦的温情面纱，",
    "start": 44.313,
    "end": 47.015,
    "duration": 2.702
  },
  {
    "id": 12,
    "text": "视世界为不可知与荒诞的迷宫；进入九十年代，",
    "start": 47.015,
    "end": 51.392,
    "duration": 4.377
  },
  {
    "id": 13,
    "text": "余华在《活着》《许三观卖血记》中毅然走出病理学式的暴力迷狂，",
    "start": 51.392,
    "end": 57.8,
    "duration": 6.408
  },
  {
    "id": 14,
    "text": "转而凝视中国普通平民在荒诞岁月中的坚韧承受，",
    "start": 57.8,
    "end": 61.564,
    "duration": 3.764
  },
  {
    "id": 15,
    "text": "赋予苦难中的微小生命以崇高的人性重量。",
    "start": 61.564,
    "end": 65.153,
    "duration": 3.589
  },
  {
    "id": 16,
    "text": "第二，叙事视角由冷漠解剖的“零度叙事”，",
    "start": 65.153,
    "end": 69.558,
    "duration": 4.405
  },
  {
    "id": 17,
    "text": "转向温润深情的“民间说话人视点”。",
    "start": 69.558,
    "end": 74.389,
    "duration": 4.831
  },
  {
    "id": 18,
    "text": "先锋探索阶段，",
    "start": 74.389,
    "end": 75.979,
    "duration": 1.59
  },
  {
    "id": 19,
    "text": "余华以手术刀般的冷静机械剔除主观道德与人道关怀，",
    "start": 75.979,
    "end": 81.09,
    "duration": 5.111
  },
  {
    "id": 20,
    "text": "将人物彻底物化为被命运玩弄的零件；九十年代转型后，",
    "start": 81.09,
    "end": 85.816,
    "duration": 4.726
  },
  {
    "id": 21,
    "text": "作家在《许三观卖血记》中深度吸纳了中国传统民间叙事的说唱基因与世俗智慧，",
    "start": 85.816,
    "end": 92.187,
    "duration": 6.371
  },
  {
    "id": 22,
    "text": "通过许三观在饥荒之年用嘴为孩子们“炒猪肝”的荒诞而辛酸的温馨场景，",
    "start": 92.187,
    "end": 99.259,
    "duration": 7.072
  },
  {
    "id": 23,
    "text": "以朴拙的循环复沓对话，",
    "start": 99.259,
    "end": 100.825,
    "duration": 1.566
  },
  {
    "id": 24,
    "text": "生动建构起一种充满烟火暖意与草根温情的民间叙事立场。",
    "start": 100.825,
    "end": 106.458,
    "duration": 5.633
  },
  {
    "id": 25,
    "text": "第三，生存哲学由虚无荒诞的绝望深渊，",
    "start": 106.458,
    "end": 109.472,
    "duration": 3.014
  },
  {
    "id": 26,
    "text": "升华为向死而生的坚韧生命意志。",
    "start": 109.472,
    "end": 112.816,
    "duration": 3.344
  },
  {
    "id": 27,
    "text": "如果说先锋时期揭示的是命运的深渊与不可逃脱的死局，",
    "start": 112.816,
    "end": 118.763,
    "duration": 5.947
  },
  {
    "id": 28,
    "text": "那么九十年代的余华则重新发现了中国农民的生存韧性与和解力量。",
    "start": 118.763,
    "end": 125.356,
    "duration": 6.593
  },
  {
    "id": 29,
    "text": "在《许三观卖血记》中，许三观为挽救非亲生的重病儿子一乐，",
    "start": 125.356,
    "end": 129.726,
    "duration": 4.37
  },
  {
    "id": 30,
    "text": "沿着铁路线一路卖血直至休克抽搐，",
    "start": 129.726,
    "end": 131.581,
    "duration": 1.855
  },
  {
    "id": 31,
    "text": "以肉身的极限损耗践行了父性大爱，",
    "start": 131.581,
    "end": 134.154,
    "duration": 2.573
  },
  {
    "id": 32,
    "text": "最终在黄泥螺与油条的世俗快慰中与残酷世界实现深层和解，",
    "start": 134.154,
    "end": 136.039,
    "duration": 1.885
  },
  {
    "id": 33,
    "text": "确立了中国当代文学中撼人心魄的坚韧生命哲学。",
    "start": 136.039,
    "end": 138.117,
    "duration": 2.078
  }
]