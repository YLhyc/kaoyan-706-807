[
  {
    "id": 1,
    "text": "八十年代中后期至九十年代，",
    "start": 0.109,
    "end": 2.254,
    "duration": 2.145
  },
  {
    "id": 2,
    "text": "余华的文学创作完成了由激进纯粹的“先锋形式实验”向沉潜温厚的“民间生存叙事”的深刻转型。",
    "start": 2.638,
    "end": 10.554,
    "duration": 7.916
  },
  {
    "id": 3,
    "text": "这一轨迹不仅体现了作家个体美学探索的成熟，",
    "start": 10.694,
    "end": 14.33,
    "duration": 3.636
  },
  {
    "id": 4,
    "text": "更构成了新时期当代小说文体演进的核心切片，",
    "start": 14.374,
    "end": 18.488,
    "duration": 4.114
  },
  {
    "id": 5,
    "text": "其转型机制主要体现于以下三个维度：",
    "start": 18.549,
    "end": 21.462,
    "duration": 2.913
  },
  {
    "id": 6,
    "text": "第一，叙事重心由形式暴力的哲学解构，",
    "start": 21.694,
    "end": 25.436,
    "duration": 3.742
  },
  {
    "id": 7,
    "text": "转向对凡俗底层苦难的深切体认。",
    "start": 25.794,
    "end": 28.655,
    "duration": 2.861
  },
  {
    "id": 8,
    "text": "先锋时期的余华以《现实一种》《一九八六年》闻名，",
    "start": 29.124,
    "end": 33.005,
    "duration": 3.881
  },
  {
    "id": 9,
    "text": "小说热衷于解剖血腥杀戮与非理性本能，通过兄杀弟、",
    "start": 33.451,
    "end": 38.212,
    "duration": 4.761
  },
  {
    "id": 10,
    "text": "弟虐兄直至分尸的极端仪式，",
    "start": 38.373,
    "end": 40.547,
    "duration": 2.174
  },
  {
    "id": 11,
    "text": "冷酷摧毁传统宗法人伦的温情面纱，",
    "start": 40.97,
    "end": 43.927,
    "duration": 2.957
  },
  {
    "id": 12,
    "text": "视世界为不可知与荒诞的迷宫；进入九十年代，",
    "start": 44.273,
    "end": 48.067,
    "duration": 3.794
  },
  {
    "id": 13,
    "text": "余华在《活着》《许三观卖血记》中毅然走出病理学式的暴力迷狂，",
    "start": 48.322,
    "end": 53.571,
    "duration": 5.249
  },
  {
    "id": 14,
    "text": "转而凝视中国普通平民在荒诞岁月中的坚韧承受，",
    "start": 53.698,
    "end": 57.643,
    "duration": 3.945
  },
  {
    "id": 15,
    "text": "赋予苦难中的微小生命以崇高的人性重量。",
    "start": 57.756,
    "end": 61.242,
    "duration": 3.486
  },
  {
    "id": 16,
    "text": "第二，叙事视角由冷漠解剖的“零度叙事”，",
    "start": 61.524,
    "end": 64.845,
    "duration": 3.321
  },
  {
    "id": 17,
    "text": "转向温润深情的“民间说话人视点”。",
    "start": 65.113,
    "end": 67.882,
    "duration": 2.769
  },
  {
    "id": 18,
    "text": "先锋探索阶段，",
    "start": 68.088,
    "end": 69.292,
    "duration": 1.204
  },
  {
    "id": 19,
    "text": "余华以手术刀般的冷静机械剔除主观道德与人道关怀，",
    "start": 69.517,
    "end": 74.115,
    "duration": 4.598
  },
  {
    "id": 20,
    "text": "将人物彻底物化为被命运玩弄的零件；九十年代转型后，",
    "start": 74.349,
    "end": 78.756,
    "duration": 4.407
  },
  {
    "id": 21,
    "text": "作家在《许三观卖血记》中深度吸纳了中国传统民间叙事的说唱基因与世俗智慧，",
    "start": 78.983,
    "end": 85.38,
    "duration": 6.397
  },
  {
    "id": 22,
    "text": "通过许三观在饥荒之年用嘴为孩子们“炒猪肝”的荒诞而辛酸的温馨场景，",
    "start": 85.776,
    "end": 91.817,
    "duration": 6.041
  },
  {
    "id": 23,
    "text": "以朴拙的循环复沓对话，",
    "start": 92.144,
    "end": 94.029,
    "duration": 1.885
  },
  {
    "id": 24,
    "text": "生动建构起一种充满烟火暖意与草根温情的民间叙事立场。",
    "start": 94.214,
    "end": 98.957,
    "duration": 4.743
  },
  {
    "id": 25,
    "text": "第三，生存哲学由虚无荒诞的绝望深渊，",
    "start": 99.219,
    "end": 102.856,
    "duration": 3.637
  },
  {
    "id": 26,
    "text": "升华为向死而生的坚韧生命意志。",
    "start": 103.114,
    "end": 106.007,
    "duration": 2.893
  },
  {
    "id": 27,
    "text": "如果说先锋时期揭示的是命运的深渊与不可逃脱的死局，",
    "start": 106.418,
    "end": 110.893,
    "duration": 4.475
  },
  {
    "id": 28,
    "text": "那么九十年代的余华则重新发现了中国农民的生存韧性与和解力量。",
    "start": 111.195,
    "end": 116.439,
    "duration": 5.244
  },
  {
    "id": 29,
    "text": "在《许三观卖血记》中，许三观为挽救非亲生的重病儿子一乐，",
    "start": 116.916,
    "end": 121.708,
    "duration": 4.792
  },
  {
    "id": 30,
    "text": "沿着铁路线一路卖血直至休克抽搐，",
    "start": 121.963,
    "end": 124.957,
    "duration": 2.994
  },
  {
    "id": 31,
    "text": "以肉身的极限损耗践行了父性大爱，",
    "start": 125.316,
    "end": 128.191,
    "duration": 2.875
  },
  {
    "id": 32,
    "text": "最终在黄泥螺与油条的世俗快慰中与残酷世界实现深层和解，",
    "start": 128.253,
    "end": 133.739,
    "duration": 5.486
  },
  {
    "id": 33,
    "text": "确立了中国当代文学中撼人心魄的坚韧生命哲学。",
    "start": 134.114,
    "end": 138.384,
    "duration": 4.27
  }
]
