[
  {
    "id": 1,
    "text": "八十年代中后期至九十年代，余华的文学创作由激进纯粹的“先锋形式实验”转向沉潜温厚的“民间生存叙事”。",
    "start": 0.113,
    "end": 9.177,
    "duration": 9.064
  },
  {
    "id": 2,
    "text": "这一轨迹体现了作家个体美学探索的成熟，",
    "start": 9.575,
    "end": 12.443,
    "duration": 2.868
  },
  {
    "id": 3,
    "text": "也构成了新时期当代小说文体演进的核心切片，其转型主要体现于以下三个维度：",
    "start": 12.639,
    "end": 19.264,
    "duration": 6.625
  },
  {
    "id": 4,
    "text": "第一，叙事重心由形式暴力的哲学拆解，转向对凡俗底层苦难的深切体认。",
    "start": 19.919,
    "end": 26.423,
    "duration": 6.504
  },
  {
    "id": 5,
    "text": "先锋时期的余华以《现实一种》《一九八六年》闻名，",
    "start": 26.691,
    "end": 30.737,
    "duration": 4.046
  },
  {
    "id": 6,
    "text": "小说着力描写血腥杀戮与非理性本能，通过兄杀弟、弟虐兄直至分尸的极端仪式，",
    "start": 31.012,
    "end": 37.902,
    "duration": 6.89
  },
  {
    "id": 7,
    "text": "冷酷摧毁传统宗法人伦的温情面纱，视世界为荒诞迷宫；",
    "start": 38.21,
    "end": 43.142,
    "duration": 4.932
  },
  {
    "id": 8,
    "text": "进入九十年代，余华在《活着》《许三观卖血记》中走出暴力迷狂，",
    "start": 43.361,
    "end": 48.391,
    "duration": 5.03
  },
  {
    "id": 9,
    "text": "转而凝视普通平民在动荡岁月中的坚韧承受，赋予苦难中的微小生命以厚重的人性尊严。",
    "start": 48.757,
    "end": 56.173,
    "duration": 7.416
  },
  {
    "id": 10,
    "text": "第二，叙事视角由冷漠客观的“零度叙事”，转向温润深情的“民间说话人视点”。",
    "start": 56.858,
    "end": 63.301,
    "duration": 6.443
  },
  {
    "id": 11,
    "text": "先锋探索阶段，余华以近乎冷漠的生理学白描剔除主观道德与人道关怀，",
    "start": 63.665,
    "end": 69.605,
    "duration": 5.94
  },
  {
    "id": 12,
    "text": "将人物物化为被命运玩弄的零件；",
    "start": 69.836,
    "end": 72.479,
    "duration": 2.643
  },
  {
    "id": 13,
    "text": "九十年代转型后，他在《许三观卖血记》中深度吸纳中国传统民间叙事的说唱基因与世俗智慧，",
    "start": 72.846,
    "end": 80.436,
    "duration": 7.59
  },
  {
    "id": 14,
    "text": "通过许三观在饥荒之年用嘴为孩子们“炒猪肝”的辛酸而温馨的场景，",
    "start": 80.714,
    "end": 86.248,
    "duration": 5.534
  },
  {
    "id": 15,
    "text": "以朴拙的循环复沓对话，建构起充满烟火暖意与草根温情的民间叙事立场。",
    "start": 86.601,
    "end": 92.949,
    "duration": 6.348
  },
  {
    "id": 16,
    "text": "第三，生存哲学由虚无荒诞的绝望境地，升华为向死而生的坚韧生命意志。",
    "start": 93.57,
    "end": 100.919,
    "duration": 7.349
  },
  {
    "id": 17,
    "text": "如果说先锋时期揭示的是命运的荒诞与无从逃脱的死局，",
    "start": 101.624,
    "end": 106.297,
    "duration": 4.673
  },
  {
    "id": 18,
    "text": "那么九十年代的余华则重新发现了中国农民的生存韧性与和解力量。",
    "start": 106.66,
    "end": 112.055,
    "duration": 5.395
  },
  {
    "id": 19,
    "text": "在《许三观卖血记》中，许三观为挽救非亲生的重病儿子一乐，",
    "start": 112.593,
    "end": 117.127,
    "duration": 4.534
  },
  {
    "id": 20,
    "text": "沿着铁路线一路卖血直至休克抽搐，以肉身的极限损耗践行了父性大爱，",
    "start": 117.418,
    "end": 123.741,
    "duration": 6.323
  },
  {
    "id": 21,
    "text": "最终在家人相伴共享寻常烟火的温情中与艰辛现实达成和解，",
    "start": 124.054,
    "end": 129.456,
    "duration": 5.402
  },
  {
    "id": 22,
    "text": "确立了当代文学中动人心魄的生命哲学。",
    "start": 129.787,
    "end": 132.745,
    "duration": 2.958
  }
]