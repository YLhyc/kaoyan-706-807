[
  {
    "id": 1,
    "text": "九十年代初，陈忠实以长篇小说《白鹿原》的问世，为当代文学贡献了一部厚重雄浑的现实主义力作。",
    "start": 0.28,
    "end": 8.04,
    "duration": 7.76
  },
  {
    "id": 2,
    "text": "作品以关中平原白鹿村半个多世纪的风云变迁为缩影，",
    "start": 8.56,
    "end": 12.8,
    "duration": 4.24
  },
  {
    "id": 3,
    "text": "其史诗品格与宗族文化反思主要体现于以下三个方面：",
    "start": 13.17,
    "end": 17.73,
    "duration": 4.56
  },
  {
    "id": 4,
    "text": "第一，建构家族秘史与民族命运交织的宏阔历史图景。",
    "start": 18.1,
    "end": 22.98,
    "duration": 4.88
  },
  {
    "id": 5,
    "text": "小说跳出单一政治图解的模式，将辛亥革命、军阀混战、抗战烽火直至政权更迭的宏大历史变局，",
    "start": 23.5,
    "end": 31.58,
    "duration": 8.08
  },
  {
    "id": 6,
    "text": "自然融入白、鹿两大家族数代人荣辱沉浮的兴衰史中。",
    "start": 31.95,
    "end": 36.11,
    "duration": 4.16
  },
  {
    "id": 7,
    "text": "从白嘉轩巧计换地奠定家业，到国共两党青年在原上的激烈博弈，",
    "start": 36.63,
    "end": 41.91,
    "duration": 5.28
  },
  {
    "id": 8,
    "text": "作品以厚重笔力描绘出传统宗法农耕社会走向现代解体的全景图卷。",
    "start": 42.28,
    "end": 48.28,
    "duration": 6.0
  },
  {
    "id": 9,
    "text": "第二，剖析儒家宗法伦理与人性本能冲突的文化困境。",
    "start": 48.8,
    "end": 53.52,
    "duration": 4.72
  },
  {
    "id": 10,
    "text": "族长白嘉轩以腰杆挺直的威严姿态，在祠堂前动用严酷族规惩戒败德者，",
    "start": 54.04,
    "end": 60.41,
    "duration": 6.37
  },
  {
    "id": 11,
    "text": "承载着传统儒家伦理的仁义坚守与冷酷专断；",
    "start": 60.78,
    "end": 64.46,
    "duration": 3.68
  },
  {
    "id": 12,
    "text": "田小娥与黑娃则代表受压抑的生命野性与情欲本能，在破窑洞里反抗严苛礼法。",
    "start": 64.98,
    "end": 72.02,
    "duration": 7.04
  },
  {
    "id": 13,
    "text": "田小娥最终惨遭公公鹿三刺杀、白鹿原爆发瘟疫后更被砖塔镇压，",
    "start": 72.54,
    "end": 77.98,
    "duration": 5.44
  },
  {
    "id": 14,
    "text": "揭示了封建礼教对人性自由的压抑与自我反噬。",
    "start": 78.35,
    "end": 82.03,
    "duration": 3.68
  },
  {
    "id": 15,
    "text": "第三，融汇关中民间神话与历史写实，生发深沉的哲理追问。",
    "start": 82.55,
    "end": 88.31,
    "duration": 5.76
  },
  {
    "id": 16,
    "text": "作家将关中民间流传的“白鹿神话”、深谙天道的圣人朱先生的预言，与冷静严谨的历史写实结合起来。",
    "start": 88.83,
    "end": 96.59,
    "duration": 7.76
  },
  {
    "id": 17,
    "text": "通过鹿子霖一生机关算尽却落得家破人亡、于风雪中疯癫冻毙的结局，",
    "start": 97.11,
    "end": 102.55,
    "duration": 5.44
  },
  {
    "id": 18,
    "text": "小说在历史兴替之上对善恶报应、宗族消长与人性幽微作出了深沉的哲理追问，赋予全篇苍茫厚重的历史感。",
    "start": 102.92,
    "end": 112.2,
    "duration": 9.28
  }
]