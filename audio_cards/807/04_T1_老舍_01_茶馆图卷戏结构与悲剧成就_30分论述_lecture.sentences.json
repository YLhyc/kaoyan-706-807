[
  {
    "id": 1,
    "text": "一、全题宏观破题与总揽。",
    "start": 0.08,
    "end": 3.12,
    "duration": 3.04
  },
  {
    "id": 2,
    "text": "一、这一问到底在考什么？",
    "start": 3.12,
    "end": 5.44,
    "duration": 2.32
  },
  {
    "id": 3,
    "text": "本题考查老舍话剧代表作《茶馆》的艺术成就、",
    "start": 5.44,
    "end": 9.36,
    "duration": 3.92
  },
  {
    "id": 4,
    "text": "结构革新、人物群像与悲剧内涵。",
    "start": 9.36,
    "end": 12.48,
    "duration": 3.12
  },
  {
    "id": 5,
    "text": "考生必须从戏剧史的高度，准确把握《茶馆》在戏剧结构、",
    "start": 12.48,
    "end": 17.12,
    "duration": 4.64
  },
  {
    "id": 6,
    "text": "人物度量、幽默意象、京味语言与历史哲学五个维度的非凡造诣。",
    "start": 17.12,
    "end": 22.32,
    "duration": 5.2
  },
  {
    "id": 7,
    "text": "二、答题的总方向是什么？",
    "start": 22.64,
    "end": 24.8,
    "duration": 2.16
  },
  {
    "id": 8,
    "text": "答题必须立足朱栋霖与钱理群教材的权威基石。",
    "start": 24.8,
    "end": 28.96,
    "duration": 4.16
  },
  {
    "id": 9,
    "text": "紧扣“话剧民族化巅峰”与“为旧时代送葬的图卷戏”这一核心评价。",
    "start": 28.96,
    "end": 34.56,
    "duration": 5.6
  },
  {
    "id": 10,
    "text": "绝不能平铺直叙复述剧情，必须讲清老舍如何通过形式探索达成思想的深刻飞跃。",
    "start": 34.56,
    "end": 41.44,
    "duration": 6.88
  },
  {
    "id": 11,
    "text": "三、分几个板块展开？",
    "start": 41.84,
    "end": 43.52,
    "duration": 1.68
  },
  {
    "id": 12,
    "text": "全篇按五大经典维度层层推进：第一板块：结构创新（独创“图卷戏”散点透视三幕、",
    "start": 43.52,
    "end": 49.84,
    "duration": 6.32
  },
  {
    "id": 13,
    "text": "借鉴清明上河图、打破西方三一律、",
    "start": 49.84,
    "end": 52.64,
    "duration": 2.8
  },
  {
    "id": 14,
    "text": "形散神聚）。",
    "start": 52.64,
    "end": 53.52,
    "duration": 0.88
  },
  {
    "id": 15,
    "text": "第二板块：人物群像（没有主角的主角是时代、",
    "start": 53.52,
    "end": 56.88,
    "duration": 3.36
  },
  {
    "id": 16,
    "text": "三个好人的三位一体悲剧破灭、度量时代沉沦）。",
    "start": 56.88,
    "end": 60.24,
    "duration": 3.36
  },
  {
    "id": 17,
    "text": "-第三板块：美学风格与象征高潮（悲喜交融、",
    "start": 60.56,
    "end": 63.845,
    "duration": 3.285
  },
  {
    "id": 18,
    "text": "含泪微笑、三老汉撒纸钱国葬象征）。",
    "start": 63.845,
    "end": 66.549,
    "duration": 2.704
  },
  {
    "id": 19,
    "text": "第四板块：戏剧语言（极简洗练的京味语言、",
    "start": 66.549,
    "end": 69.834,
    "duration": 3.285
  },
  {
    "id": 20,
    "text": "一句顶十句、潜台词丰厚、话剧白话最高典范）。",
    "start": 69.834,
    "end": 73.312,
    "duration": 3.478
  },
  {
    "id": 21,
    "text": "第五板块：历史哲学意蕴（改良救国走不通、",
    "start": 73.312,
    "end": 76.596,
    "duration": 3.284
  },
  {
    "id": 22,
    "text": "以微观茶馆解答宏观时代命题、宣告旧制度灭亡必然性）。",
    "start": 76.596,
    "end": 81.04,
    "duration": 4.444
  },
  {
    "id": 23,
    "text": "四、全篇内在逻辑链条是什么？",
    "start": 81.2,
    "end": 83.84,
    "duration": 2.64
  },
  {
    "id": 24,
    "text": "由剧作在戏剧史上的民族化巅峰地位破题，",
    "start": 83.84,
    "end": 87.28,
    "duration": 3.44
  },
  {
    "id": 25,
    "text": "趋近于剖析其容纳时代的宏阔空间形式，",
    "start": 87.28,
    "end": 90.64,
    "duration": 3.36
  },
  {
    "id": 26,
    "text": "空间结构革新，趋近于深入其空间内活跃的人物命运与阶层图谱，",
    "start": 90.64,
    "end": 95.84,
    "duration": 5.2
  },
  {
    "id": 27,
    "text": "人物群像度量，趋近于升华至全剧的情感爆点与意象仪式，",
    "start": 95.84,
    "end": 100.4,
    "duration": 4.56
  },
  {
    "id": 28,
    "text": "象征美学高潮，趋近于落到承载一切表演与性格的语言艺术，",
    "start": 100.4,
    "end": 105.28,
    "duration": 4.88
  },
  {
    "id": 29,
    "text": "京味白话语言，趋近于最终收束于对历史规律与社会变革的终极裁决，",
    "start": 105.28,
    "end": 111.04,
    "duration": 5.76
  },
  {
    "id": 30,
    "text": "历史哲学深度。",
    "start": 111.04,
    "end": 112.16,
    "duration": 1.12
  },
  {
    "id": 31,
    "text": "层层剥茧，雄辩有力。",
    "start": 112.56,
    "end": 114.32,
    "duration": 1.76
  },
  {
    "id": 32,
    "text": "--。二",
    "start": 114.32,
    "end": 114.56,
    "duration": 0.24
  },
  {
    "id": 33,
    "text": "、各板块逐句咬合推演。",
    "start": 114.8,
    "end": 116.8,
    "duration": 2.0
  },
  {
    "id": 34,
    "text": "（一）宏观定性与破题总起板块。",
    "start": 116.8,
    "end": 119.6,
    "duration": 2.8
  },
  {
    "id": 35,
    "text": "破题推演逻辑：开头必须先声夺人。",
    "start": 119.6,
    "end": 122.784,
    "duration": 3.184
  },
  {
    "id": 36,
    "text": "首先准确界定《茶馆》作为中国话剧现实主义扛鼎之作与民族化最高巅峰的崇高地位。",
    "start": 122.784,
    "end": 129.504,
    "duration": 6.72
  },
  {
    "id": 37,
    "text": "接着交代三幕戏跨越半个世纪的宏大历史横截面，",
    "start": 129.504,
    "end": 133.264,
    "duration": 3.76
  },
  {
    "id": 38,
    "text": "点明其为旧时代谱写挽歌的宏观题旨。",
    "start": 133.264,
    "end": 136.784,
    "duration": 3.52
  },
  {
    "id": 39,
    "text": "最后概括结构、群像、意象、语言与历史哲学五大支柱，",
    "start": 136.784,
    "end": 141.584,
    "duration": 4.8
  },
  {
    "id": 40,
    "text": "引出分述。",
    "start": 141.584,
    "end": 142.384,
    "duration": 0.8
  },
  {
    "id": 41,
    "text": "-逐句咬合推导：具体表述到答题语句就是：老舍的三幕话剧《茶馆》是中国现代话剧现实主义的扛鼎之作，",
    "start": 142.544,
    "end": 151.337,
    "duration": 8.793
  },
  {
    "id": 42,
    "text": "更是中国话剧民族化探索的最高巅峰。，",
    "start": 151.337,
    "end": 154.687,
    "duration": 3.35
  },
  {
    "id": 43,
    "text": "这是对考察对象的历史最高定性。",
    "start": 154.687,
    "end": 157.618,
    "duration": 2.931
  },
  {
    "id": 44,
    "text": "紧接着交代作品截取的三大历史断面，",
    "start": 157.618,
    "end": 160.968,
    "duration": 3.35
  },
  {
    "id": 45,
    "text": "具体表述到答题语句就是：剧作截取清末戊戌维新失败、",
    "start": 160.968,
    "end": 165.783,
    "duration": 4.815
  },
  {
    "id": 46,
    "text": "民国初年军阀混战与抗战胜利后国民党统治崩溃前夕三个历史横断面。。",
    "start": 165.783,
    "end": 172.064,
    "duration": 6.281
  },
  {
    "id": 47,
    "text": "随后点出茶馆变迁与时代挽歌的深刻关联，",
    "start": 172.224,
    "end": 176.064,
    "duration": 3.84
  },
  {
    "id": 48,
    "text": "具体表述到答题语句就是：它以北京裕泰茶馆半个世纪的兴衰变迁，",
    "start": 176.064,
    "end": 182.018,
    "duration": 5.954
  },
  {
    "id": 49,
    "text": "为黑暗旧中国谱写了一曲沉痛恢宏的时代挽歌。。",
    "start": 182.018,
    "end": 186.25,
    "duration": 4.232
  },
  {
    "id": 50,
    "text": "紧接着指出其对西方传统戏剧规范的超越，",
    "start": 186.25,
    "end": 190.059,
    "duration": 3.809
  },
  {
    "id": 51,
    "text": "具体表述到答题语句就是：老舍打破了西方传统戏剧的锁闭式藩篱。。",
    "start": 190.059,
    "end": 195.984,
    "duration": 5.925
  },
  {
    "id": 52,
    "text": "最后用高度凝练的短语概括全剧的核心艺术要素，",
    "start": 196.064,
    "end": 199.984,
    "duration": 3.92
  },
  {
    "id": 53,
    "text": "具体表述到答题语句就是：他以独创的“图卷戏”散点透视结构、",
    "start": 199.984,
    "end": 205.344,
    "duration": 5.36
  },
  {
    "id": 54,
    "text": "卓越的人物群像度量、悲喜交融的幽默意象与炉火纯青的京味语言，",
    "start": 205.344,
    "end": 210.864,
    "duration": 5.52
  },
  {
    "id": 55,
    "text": "宣告了旧时代灭亡的必然宿命。。",
    "start": 210.864,
    "end": 213.264,
    "duration": 2.4
  },
  {
    "id": 56,
    "text": "老舍的三幕话剧《茶馆》是中国现代话剧现实主义的扛鼎之作，",
    "start": 213.424,
    "end": 218.064,
    "duration": 4.64
  },
  {
    "id": 57,
    "text": "更是中国话剧民族化探索的最高巅峰。",
    "start": 218.064,
    "end": 220.784,
    "duration": 2.72
  },
  {
    "id": 58,
    "text": "剧作截取清末戊戌维新失败、民国初年军阀混战与抗战胜利后国民党统治崩溃前夕三个历史横断面。",
    "start": 221.104,
    "end": 230.464,
    "duration": 9.36
  },
  {
    "id": 59,
    "text": "它以北京裕泰茶馆半个世纪的兴衰变迁，",
    "start": 230.464,
    "end": 233.744,
    "duration": 3.28
  },
  {
    "id": 60,
    "text": "为黑暗旧中国谱写了一曲沉痛恢宏的时代挽歌。",
    "start": 233.744,
    "end": 238.064,
    "duration": 4.32
  },
  {
    "id": 61,
    "text": "老舍打破了西方传统戏剧的锁闭式藩篱。",
    "start": 238.064,
    "end": 241.184,
    "duration": 3.12
  },
  {
    "id": 62,
    "text": "他以独创的“图卷戏”散点透视结构、",
    "start": 241.504,
    "end": 244.501,
    "duration": 2.997
  },
  {
    "id": 63,
    "text": "卓越的人物群像度量、悲喜交融的幽默意象与炉火纯青的京味语言，",
    "start": 244.501,
    "end": 250.792,
    "duration": 6.291
  },
  {
    "id": 64,
    "text": "宣告了旧时代灭亡的必然宿命。",
    "start": 250.792,
    "end": 253.712,
    "duration": 2.92
  },
  {
    "id": 65,
    "text": "--。（二",
    "start": 253.712,
    "end": 253.937,
    "duration": 0.225
  },
  {
    "id": 66,
    "text": "）第一板块：独创“图卷戏”散点透视三幕结构。",
    "start": 253.937,
    "end": 257.756,
    "duration": 3.819
  },
  {
    "id": 67,
    "text": "论证推演逻辑：讲透戏剧成就，首推结构革命。",
    "start": 257.756,
    "end": 262.112,
    "duration": 4.356
  },
  {
    "id": 68,
    "text": "必须指出老舍摆脱西方经典以个人为核心的冲突模式，",
    "start": 262.112,
    "end": 266.752,
    "duration": 4.64
  },
  {
    "id": 69,
    "text": "借鉴中国古典长卷画（《清明上河图》）的散点透视手法。",
    "start": 266.752,
    "end": 271.072,
    "duration": 4.32
  },
  {
    "id": 70,
    "text": "说明茶馆作为社会枢纽的功能，阐释三幕横截面展览现实的机制，",
    "start": 271.072,
    "end": 276.112,
    "duration": 5.04
  },
  {
    "id": 71,
    "text": "最终落到“形散而神聚”的艺术化境。",
    "start": 276.112,
    "end": 279.152,
    "duration": 3.04
  },
  {
    "id": 72,
    "text": "-逐句咬合推导：具体表述到答题语句就是：首先，",
    "start": 279.392,
    "end": 283.225,
    "duration": 3.833
  },
  {
    "id": 73,
    "text": "在戏剧结构上，老舍独创了“图卷戏”的散点透视三幕结构，",
    "start": 283.225,
    "end": 287.865,
    "duration": 4.64
  },
  {
    "id": 74,
    "text": "实现了对西方传统戏剧范式的审美超越。，",
    "start": 287.865,
    "end": 291.295,
    "duration": 3.43
  },
  {
    "id": 75,
    "text": "这是第一分论点的核心提炼。",
    "start": 291.295,
    "end": 293.715,
    "duration": 2.42
  },
  {
    "id": 76,
    "text": "紧接着指出其打破传统因果冲突锁闭模式的突破，",
    "start": 293.715,
    "end": 297.952,
    "duration": 4.237
  },
  {
    "id": 77,
    "text": "具体表述到答题语句就是：《茶馆》打破了西方古典戏剧必须依赖单一戏剧冲突或单一家室盛衰的因果锁闭模式。。",
    "start": 297.952,
    "end": 307.232,
    "duration": 9.28
  },
  {
    "id": 78,
    "text": "随后点明民族化审美来源，具体表述到答题语句就是：老舍创造性地借鉴了中国古代长卷画《清明上河图》的散点透视法则。。",
    "start": 307.392,
    "end": 317.165,
    "duration": 9.773
  },
  {
    "id": 79,
    "text": "紧接着阐释茶馆作为公共空间的枢纽功能与片段连缀机制，",
    "start": 317.165,
    "end": 321.985,
    "duration": 4.82
  },
  {
    "id": 80,
    "text": "具体表述到答题语句就是：他以裕泰茶馆为中心社会枢纽，",
    "start": 321.985,
    "end": 326.612,
    "duration": 4.627
  },
  {
    "id": 81,
    "text": "全剧没有贯穿到底的情节主线，而是由数十个散碎生动的市井生活片段有机连缀而成。。",
    "start": 326.612,
    "end": 333.552,
    "duration": 6.94
  },
  {
    "id": 82,
    "text": "随后比喻其长卷展示的历史容量，具体表述到答题语句就是：三幕戏如同一幅徐徐展开的世俗风情长卷。。",
    "start": 333.712,
    "end": 342.581,
    "duration": 8.869
  },
  {
    "id": 83,
    "text": "紧接着说明其跨越半个世纪的黑暗现实展览，",
    "start": 342.581,
    "end": 346.537,
    "duration": 3.956
  },
  {
    "id": 84,
    "text": "具体表述到答题语句就是：它将半个世纪由封建晚清到民国乱世的黑暗现实生动展览。。",
    "start": 346.537,
    "end": 354.032,
    "duration": 7.495
  },
  {
    "id": 85,
    "text": "最后总结形散神聚的美学高度，具体表述到答题语句就是：剧作看似形散，",
    "start": 354.192,
    "end": 360.592,
    "duration": 6.4
  },
  {
    "id": 86,
    "text": "内在却被时代步步走向溃烂的沉痛暗线牢牢统摄，",
    "start": 360.592,
    "end": 365.232,
    "duration": 4.64
  },
  {
    "id": 87,
    "text": "达到了形散而神聚的高超化境。。",
    "start": 365.232,
    "end": 367.712,
    "duration": 2.48
  },
  {
    "id": 88,
    "text": "首先，在戏剧结构上，老舍独创了“图卷戏”的散点透视三幕结构，",
    "start": 368.08,
    "end": 373.68,
    "duration": 5.6
  },
  {
    "id": 89,
    "text": "实现了对西方传统戏剧范式的审美超越。",
    "start": 373.68,
    "end": 376.88,
    "duration": 3.2
  },
  {
    "id": 90,
    "text": "《茶馆》打破了西方古典戏剧必须依赖单一戏剧冲突或单一家室盛衰的因果锁闭模式。",
    "start": 376.88,
    "end": 383.92,
    "duration": 7.04
  },
  {
    "id": 91,
    "text": "老舍创造性地借鉴了中国古代长卷画《清明上河图》的散点透视法则。",
    "start": 383.92,
    "end": 389.28,
    "duration": 5.36
  },
  {
    "id": 92,
    "text": "他以裕泰茶馆为中心社会枢纽，全剧没有贯穿到底的情节主线，",
    "start": 389.52,
    "end": 394.48,
    "duration": 4.96
  },
  {
    "id": 93,
    "text": "而是由数十个散碎生动的市井生活片段有机连缀而成。",
    "start": 394.48,
    "end": 399.2,
    "duration": 4.72
  },
  {
    "id": 94,
    "text": "三幕戏如同一幅徐徐展开的世俗风情长卷。",
    "start": 399.2,
    "end": 402.88,
    "duration": 3.68
  },
  {
    "id": 95,
    "text": "它将半个世纪由封建晚清到民国乱世的黑暗现实生动展览。",
    "start": 402.88,
    "end": 408.16,
    "duration": 5.28
  },
  {
    "id": 96,
    "text": "剧作看似形散，内在却被时代步步走向溃烂的沉痛暗线牢牢统摄，",
    "start": 408.16,
    "end": 413.92,
    "duration": 5.76
  },
  {
    "id": 97,
    "text": "达到了形散而神聚的高超化境。",
    "start": 413.92,
    "end": 416.24,
    "duration": 2.32
  },
  {
    "id": 98,
    "text": "---。（三",
    "start": 416.48,
    "end": 416.707,
    "duration": 0.227
  },
  {
    "id": 99,
    "text": "）第二板块：卓越的人物群像与时代的审判。",
    "start": 416.707,
    "end": 420.565,
    "duration": 3.858
  },
  {
    "id": 100,
    "text": "论证推演逻辑：群像塑造是《茶馆》的灵魂。",
    "start": 420.565,
    "end": 424.195,
    "duration": 3.63
  },
  {
    "id": 101,
    "text": "必须指出登场人物众多且截取切片的独特手法。",
    "start": 424.195,
    "end": 428.734,
    "duration": 4.539
  },
  {
    "id": 102,
    "text": "核心论证王利发、常四爷与秦仲义构成的“三位一体”悲剧：顺民王利发自尽、",
    "start": 428.734,
    "end": 435.542,
    "duration": 6.808
  },
  {
    "id": 103,
    "text": "硬汉常四爷沦为乞丐、实业家秦仲义工厂被没收。",
    "start": 435.542,
    "end": 440.08,
    "duration": 4.538
  },
  {
    "id": 104,
    "text": "三个好人殊途同归的灭顶之灾，雄辩证明审判的真正主角是黑暗时代。",
    "start": 440.16,
    "end": 446.56,
    "duration": 6.4
  },
  {
    "id": 105,
    "text": "逐句咬合推导：具体表述到答题语句就是：其次，",
    "start": 446.56,
    "end": 450.88,
    "duration": 4.32
  },
  {
    "id": 106,
    "text": "在人物塑造上，剧作以卓越的群像谱系度量宏大时代的崩塌，",
    "start": 450.88,
    "end": 456.24,
    "duration": 5.36
  },
  {
    "id": 107,
    "text": "确立了“没有主角的主角是时代”的深刻立意。，",
    "start": 456.24,
    "end": 459.84,
    "duration": 3.6
  },
  {
    "id": 108,
    "text": "这是第二分论点的观点立桩。",
    "start": 459.84,
    "end": 461.76,
    "duration": 1.92
  },
  {
    "id": 109,
    "text": "紧接着交代庞大的人物规模，具体表述到答题语句就是：全剧登场人物多达七十余人。。",
    "start": 462.08,
    "end": 468.626,
    "duration": 6.546
  },
  {
    "id": 110,
    "text": "随后指出老舍独特的切片式勾勒手法，",
    "start": 468.626,
    "end": 471.785,
    "duration": 3.159
  },
  {
    "id": 111,
    "text": "具体表述到答题语句就是：老舍精湛地截取了每个人物在不同历史时期的一截生活切片。。",
    "start": 471.785,
    "end": 479.089,
    "duration": 7.304
  },
  {
    "id": 112,
    "text": "紧接着亮出核心人物悲剧链条，具体表述到答题语句就是：最震撼人心的是王利发、",
    "start": 479.089,
    "end": 485.801,
    "duration": 6.712
  },
  {
    "id": 113,
    "text": "常四爷与秦仲义构成的三位一体悲剧。。",
    "start": 485.801,
    "end": 488.96,
    "duration": 3.159
  },
  {
    "id": 114,
    "text": "随后剖析小商人王利发的命运结局，",
    "start": 489.12,
    "end": 492.16,
    "duration": 3.04
  },
  {
    "id": 115,
    "text": "具体表述到答题语句就是：精明本分、",
    "start": 492.16,
    "end": 495.37,
    "duration": 3.21
  },
  {
    "id": 116,
    "text": "委曲求全以求生存的小商人王利发，",
    "start": 495.37,
    "end": 498.466,
    "duration": 3.096
  },
  {
    "id": 117,
    "text": "最终在茶馆被霸占后自义身亡。。",
    "start": 498.466,
    "end": 501.149,
    "duration": 2.683
  },
  {
    "id": 118,
    "text": "紧接着剖析硬汉常四爷的命运结局，",
    "start": 501.149,
    "end": 504.245,
    "duration": 3.096
  },
  {
    "id": 119,
    "text": "具体表述到答题语句就是：刚正耿直、",
    "start": 504.245,
    "end": 507.341,
    "duration": 3.096
  },
  {
    "id": 120,
    "text": "自食其力的硬汉常四爷，到头来冻饿交加，",
    "start": 507.341,
    "end": 510.85,
    "duration": 3.509
  },
  {
    "id": 121,
    "text": "靠卖花生仁沦为街头流民。。",
    "start": 510.85,
    "end": 513.12,
    "duration": 2.27
  },
  {
    "id": 122,
    "text": "随后剖析实业资本家秦仲义的命运结局，",
    "start": 513.328,
    "end": 516.768,
    "duration": 3.44
  },
  {
    "id": 123,
    "text": "具体表述到答题语句就是：立志实业救国的民族资本家秦仲义，",
    "start": 516.768,
    "end": 521.688,
    "duration": 4.92
  },
  {
    "id": 124,
    "text": "耗尽心血办厂却被反动政权当作逆产拆毁。。",
    "start": 521.688,
    "end": 525.077,
    "duration": 3.389
  },
  {
    "id": 125,
    "text": "最后总结三个好人毁灭对旧制度的审判力量，",
    "start": 525.077,
    "end": 528.655,
    "duration": 3.578
  },
  {
    "id": 126,
    "text": "具体表述到答题语句就是：三位不同阶层的好人共同走向绝境，",
    "start": 528.655,
    "end": 533.552,
    "duration": 4.897
  },
  {
    "id": 127,
    "text": "雄辩地证明了真正被押上历史审判台的是那吃人的黑暗制度。。",
    "start": 533.552,
    "end": 538.448,
    "duration": 4.896
  },
  {
    "id": 128,
    "text": "其次，在人物塑造上，剧作以卓越的群像谱系度量宏大时代的崩塌，",
    "start": 538.608,
    "end": 544.928,
    "duration": 6.32
  },
  {
    "id": 129,
    "text": "确立了“没有主角的主角是时代”的深刻立意。",
    "start": 544.928,
    "end": 548.528,
    "duration": 3.6
  },
  {
    "id": 130,
    "text": "全剧登场人物多达七十余人。",
    "start": 548.528,
    "end": 550.928,
    "duration": 2.4
  },
  {
    "id": 131,
    "text": "老舍精湛地截取了每个人物在不同历史时期的一截生活切片。",
    "start": 550.928,
    "end": 555.728,
    "duration": 4.8
  },
  {
    "id": 132,
    "text": "最震撼人心的是王利发、常四爷与秦仲义构成的三位一体悲剧。",
    "start": 555.728,
    "end": 561.008,
    "duration": 5.28
  },
  {
    "id": 133,
    "text": "精明本分、委曲求全以求生存的小商人王利发，",
    "start": 561.248,
    "end": 565.568,
    "duration": 4.32
  },
  {
    "id": 134,
    "text": "最终在茶馆被霸占后自义身亡。",
    "start": 565.568,
    "end": 568.768,
    "duration": 3.2
  },
  {
    "id": 135,
    "text": "刚正耿直、自食其力的硬汉常四爷，",
    "start": 568.768,
    "end": 571.888,
    "duration": 3.12
  },
  {
    "id": 136,
    "text": "到头来冻饿交加，靠卖花生仁沦为街头流民。",
    "start": 571.888,
    "end": 576.368,
    "duration": 4.48
  },
  {
    "id": 137,
    "text": "立志实业救国的民族资本家秦仲义，",
    "start": 576.368,
    "end": 579.328,
    "duration": 2.96
  },
  {
    "id": 138,
    "text": "耗尽心血办厂却被反动政权当作逆产拆毁。",
    "start": 579.328,
    "end": 583.168,
    "duration": 3.84
  },
  {
    "id": 139,
    "text": "三位不同阶层的好人共同走向绝境，",
    "start": 583.408,
    "end": 586.688,
    "duration": 3.28
  },
  {
    "id": 140,
    "text": "雄辩地证明了真正被押上历史审判台的是那吃人的黑暗制度。",
    "start": 586.688,
    "end": 592.448,
    "duration": 5.76
  },
  {
    "id": 141,
    "text": "--。（四",
    "start": 592.448,
    "end": 592.608,
    "duration": 0.16
  },
  {
    "id": 142,
    "text": "）第三板块：悲喜交融美学与“三老汉撒纸钱”的国葬象征。",
    "start": 593.168,
    "end": 598.928,
    "duration": 5.76
  },
  {
    "id": 143,
    "text": "论证推演逻辑：老舍的幽默绝非浅薄逗乐，",
    "start": 598.928,
    "end": 602.848,
    "duration": 3.92
  },
  {
    "id": 144,
    "text": "而是“含泪的微笑”。",
    "start": 602.848,
    "end": 604.448,
    "duration": 1.6
  },
  {
    "id": 145,
    "text": "必须阐释以喜剧反衬严酷现实的机制。",
    "start": 604.688,
    "end": 608.528,
    "duration": 3.84
  },
  {
    "id": 146,
    "text": "接着详细复原全剧最震撼人心的华彩高潮，",
    "start": 608.528,
    "end": 612.688,
    "duration": 4.16
  },
  {
    "id": 147,
    "text": "第三幕三老汉重聚撒纸钱的场景。",
    "start": 612.688,
    "end": 615.968,
    "duration": 3.28
  },
  {
    "id": 148,
    "text": "深入解析这一仪式不仅是为自己出殡，",
    "start": 615.968,
    "end": 619.248,
    "duration": 3.28
  },
  {
    "id": 149,
    "text": "更是在象征层面上为三个黑暗旧时代举行文化国葬。",
    "start": 619.248,
    "end": 624.368,
    "duration": 5.12
  },
  {
    "id": 150,
    "text": "逐句咬合推导：具体表述到答题语句就是：第三，",
    "start": 624.368,
    "end": 628.608,
    "duration": 4.24
  },
  {
    "id": 151,
    "text": "在美学格调上，剧作展现了悲喜交融的艺术风格，",
    "start": 628.608,
    "end": 632.928,
    "duration": 4.32
  },
  {
    "id": 152,
    "text": "并以“三老汉撒纸钱”铸就了象征美学的华彩巅峰。，",
    "start": 632.928,
    "end": 637.248,
    "duration": 4.32
  },
  {
    "id": 153,
    "text": "这是第三分论点的提纲窃领。",
    "start": 637.248,
    "end": 639.648,
    "duration": 2.4
  },
  {
    "id": 154,
    "text": "紧接着界定老舍式的幽默特质，具体表述到答题语句就是：老舍将融汇英式幽默与民族悲剧心理的含泪微笑推向极境。。",
    "start": 639.648,
    "end": 649.408,
    "duration": 9.76
  },
  {
    "id": 155,
    "text": "随后阐释以喜写悲的作用机制，具体表述到答题语句就是：剧作极善于以世俗喜剧的形式反衬严酷的生存荒谬。。",
    "start": 649.728,
    "end": 658.288,
    "duration": 8.56
  },
  {
    "id": 156,
    "text": "紧接着切入第三幕高潮场景，具体表述到答题语句就是：在第三幕结尾处，",
    "start": 658.664,
    "end": 664.925,
    "duration": 6.261
  },
  {
    "id": 157,
    "text": "王利发、常四爷与秦仲义三位老友重聚。。",
    "start": 664.925,
    "end": 668.409,
    "duration": 3.484
  },
  {
    "id": 158,
    "text": "随后复原其狂欢反讽的动作细节，具体表述到答题语句就是：他们以狂笑写至痛，",
    "start": 668.409,
    "end": 675.594,
    "duration": 7.185
  },
  {
    "id": 159,
    "text": "互相作揖，漫天抛撒检来的冥纸。。",
    "start": 675.594,
    "end": 678.424,
    "duration": 2.83
  },
  {
    "id": 160,
    "text": "紧接着剖析个人层面的出殡意义，具体表述到答题语句就是：这一震撼人心的现代象征仪式，",
    "start": 678.504,
    "end": 686.333,
    "duration": 7.829
  },
  {
    "id": 161,
    "text": "不仅是老人们活着为自己凄凉出殡。。",
    "start": 686.333,
    "end": 689.489,
    "duration": 3.156
  },
  {
    "id": 162,
    "text": "最后升华为时代与历史维度的文化国葬，",
    "start": 689.489,
    "end": 693.066,
    "duration": 3.577
  },
  {
    "id": 163,
    "text": "具体表述到答题语句就是：更是在深层意象上为半个世纪的三个黑暗旧时代举行了一场盛大辛辣的文化国葬。。",
    "start": 693.066,
    "end": 702.744,
    "duration": 9.678
  },
  {
    "id": 164,
    "text": "第三，在美学格调上，剧作展现了悲喜交融的艺术风格，",
    "start": 702.824,
    "end": 707.784,
    "duration": 4.96
  },
  {
    "id": 165,
    "text": "并以“三老汉撒纸钱”铸就了象征美学的华彩巅峰。",
    "start": 707.784,
    "end": 712.424,
    "duration": 4.64
  },
  {
    "id": 166,
    "text": "老舍将融汇英式幽默与民族悲剧心理的含泪微笑推向极境。",
    "start": 712.424,
    "end": 718.184,
    "duration": 5.76
  },
  {
    "id": 167,
    "text": "剧作极善于以世俗喜剧的形式反衬严酷的生存荒谬。",
    "start": 718.184,
    "end": 723.464,
    "duration": 5.28
  },
  {
    "id": 168,
    "text": "在第三幕结尾处，王利发、常四爷与秦仲义三位老友重聚。",
    "start": 723.464,
    "end": 728.744,
    "duration": 5.28
  },
  {
    "id": 169,
    "text": "他们以狂笑写至痛，互相作揖，漫天抛撒检来的冥纸。",
    "start": 728.904,
    "end": 734.344,
    "duration": 5.44
  },
  {
    "id": 170,
    "text": "这一震撼人心的现代象征仪式，不仅是老人们活着为自己凄凉出殡，",
    "start": 734.344,
    "end": 740.184,
    "duration": 5.84
  },
  {
    "id": 171,
    "text": "更是在深层意象上为半个世纪的三个黑暗旧时代举行了一场盛大辛辣的文化国葬。",
    "start": 740.184,
    "end": 747.704,
    "duration": 7.52
  },
  {
    "id": 172,
    "text": "--。（五",
    "start": 747.704,
    "end": 747.864,
    "duration": 0.16
  },
  {
    "id": 173,
    "text": "）第四板块：纯正洗练的京味语言艺术。",
    "start": 748.184,
    "end": 751.384,
    "duration": 3.2
  },
  {
    "id": 174,
    "text": "-论证推演逻辑：老舍是无可争议的语言大师。",
    "start": 751.544,
    "end": 755.272,
    "duration": 3.728
  },
  {
    "id": 175,
    "text": "必须阐明剧作彻底扫除了早期话剧的翻译腔与教条说教，",
    "start": 755.272,
    "end": 760.242,
    "duration": 4.97
  },
  {
    "id": 176,
    "text": "将北京市民口语提炼为艺术语言。",
    "start": 760.242,
    "end": 763.142,
    "duration": 2.9
  },
  {
    "id": 177,
    "text": "分析台词“一句顶十句”的洗练与丰厚潜台词，",
    "start": 763.142,
    "end": 766.87,
    "duration": 3.728
  },
  {
    "id": 178,
    "text": "结合不同人物语言的高度性格化，说明幽默语言作为底层弱者心理护甲的功能。",
    "start": 766.87,
    "end": 773.704,
    "duration": 6.834
  },
  {
    "id": 179,
    "text": "-逐句咬合推导：具体表述到答题语句就是：第四，",
    "start": 773.704,
    "end": 777.485,
    "duration": 3.781
  },
  {
    "id": 180,
    "text": "在戏剧语言上，老舍以纯正洗练的京味台词，",
    "start": 777.485,
    "end": 781.067,
    "duration": 3.582
  },
  {
    "id": 181,
    "text": "确立了中国现代话剧白话文学的最高典范。，",
    "start": 781.067,
    "end": 784.649,
    "duration": 3.582
  },
  {
    "id": 182,
    "text": "这是第四分论点的核心观点。",
    "start": 784.649,
    "end": 787.036,
    "duration": 2.387
  },
  {
    "id": 183,
    "text": "紧接着说明其洗尽铅华的纯化突破，",
    "start": 787.036,
    "end": 790.021,
    "duration": 2.985
  },
  {
    "id": 184,
    "text": "具体表述到答题语句就是：《茶馆》彻底荡涤了中国早期话剧中的欧化翻译腔与概念化说教。。",
    "start": 790.021,
    "end": 797.384,
    "duration": 7.363
  },
  {
    "id": 185,
    "text": "随后说明其对老北京市民口语的艺术提炼，",
    "start": 797.544,
    "end": 801.064,
    "duration": 3.52
  },
  {
    "id": 186,
    "text": "具体表述到答题语句就是：老舍将地道纯正的老北京市民口语提炼为富有诗意与潜台词的艺术语言。。",
    "start": 801.064,
    "end": 809.624,
    "duration": 8.56
  },
  {
    "id": 187,
    "text": "紧接着指出其精炼有力的特点，具体表述到答题语句就是：剧作中的台词一句顶十句，",
    "start": 809.912,
    "end": 816.734,
    "duration": 6.822
  },
  {
    "id": 188,
    "text": "极度洗练且高度性格化。。",
    "start": 816.734,
    "end": 818.725,
    "duration": 1.991
  },
  {
    "id": 189,
    "text": "随后列举各阶层人物的台词神采，具体表述到答题语句就是：唐铁嘴的无耻俏皮、",
    "start": 818.725,
    "end": 825.296,
    "duration": 6.571
  },
  {
    "id": 190,
    "text": "宋恩子与吴祥子的阴阳怪气以及常四爷的刚正硬气无不跃然纸上。。",
    "start": 825.296,
    "end": 830.872,
    "duration": 5.576
  },
  {
    "id": 191,
    "text": "紧接着揭示幽默语言的心理防护功能，",
    "start": 830.952,
    "end": 833.992,
    "duration": 3.04
  },
  {
    "id": 192,
    "text": "具体表述到答题语句就是：幽默的市井调侃化作了底层弱者对抗苦难的精神护甲，",
    "start": 833.992,
    "end": 840.712,
    "duration": 6.72
  },
  {
    "id": 193,
    "text": "语言极具文学张力与回味空间。。",
    "start": 840.712,
    "end": 843.592,
    "duration": 2.88
  },
  {
    "id": 194,
    "text": "第四，在戏剧语言上，老舍以纯正洗练的京味台词，",
    "start": 843.592,
    "end": 848.392,
    "duration": 4.8
  },
  {
    "id": 195,
    "text": "确立了中国现代话剧白话文学的最高典范。",
    "start": 848.392,
    "end": 851.592,
    "duration": 3.2
  },
  {
    "id": 196,
    "text": "《茶馆》彻底荡涤了中国早期话剧中的欧化翻译腔与概念化说教。",
    "start": 851.752,
    "end": 857.353,
    "duration": 5.601
  },
  {
    "id": 197,
    "text": "老舍将地道纯正的老北京市民口语提炼为富有诗意与潜台词的艺术语言。",
    "start": 857.353,
    "end": 864.032,
    "duration": 6.679
  },
  {
    "id": 198,
    "text": "剧作中的台词一句顶十句，极度洗练且高度性格化。",
    "start": 864.032,
    "end": 868.556,
    "duration": 4.524
  },
  {
    "id": 199,
    "text": "唐铁嘴的无耻俏皮、宋恩子与吴祥子的阴阳怪气以及常四爷的刚正硬气无不跃然纸上。",
    "start": 868.556,
    "end": 876.312,
    "duration": 7.756
  },
  {
    "id": 200,
    "text": "幽默的市井调侃化作了底层弱者对抗苦难的精神护甲，",
    "start": 876.392,
    "end": 881.192,
    "duration": 4.8
  },
  {
    "id": 201,
    "text": "语言极具文学张力与回味空间。",
    "start": 881.192,
    "end": 883.992,
    "duration": 2.8
  },
  {
    "id": 202,
    "text": "--。（六",
    "start": 883.992,
    "end": 884.072,
    "duration": 0.08
  },
  {
    "id": 203,
    "text": "）第五板块：深刻的历史哲学意蕴与时代死刑判决。",
    "start": 884.232,
    "end": 888.392,
    "duration": 4.16
  },
  {
    "id": 204,
    "text": "论证推演逻辑：优秀剧作必须具有深邃的历史哲学灵魂。",
    "start": 888.392,
    "end": 893.032,
    "duration": 4.64
  },
  {
    "id": 205,
    "text": "阐明老舍从小茶馆入手回答大时代命题的独特路径。",
    "start": 893.032,
    "end": 897.432,
    "duration": 4.4
  },
  {
    "id": 206,
    "text": "指出改良、实业与顺民三种出路的破灭，",
    "start": 897.752,
    "end": 901.272,
    "duration": 3.52
  },
  {
    "id": 207,
    "text": "雄辩宣告旧时代不可逆转的灭亡宿命，",
    "start": 901.272,
    "end": 904.552,
    "duration": 3.28
  },
  {
    "id": 208,
    "text": "证明唯有彻底社会革命才是中国人民唯一的出路。",
    "start": 904.552,
    "end": 908.392,
    "duration": 3.84
  },
  {
    "id": 209,
    "text": "逐句咬合推导：具体表述到答题语句就是：最后，",
    "start": 908.392,
    "end": 912.152,
    "duration": 3.76
  },
  {
    "id": 210,
    "text": "在思想内涵上，剧作蕴含着深邃的历史哲学反思，",
    "start": 912.152,
    "end": 916.312,
    "duration": 4.16
  },
  {
    "id": 211,
    "text": "雄辩昭示了旧社会灭亡的历史必然性。，",
    "start": 916.312,
    "end": 919.352,
    "duration": 3.04
  },
  {
    "id": 212,
    "text": "这是第五分论点的核心观点立桩。",
    "start": 919.352,
    "end": 921.752,
    "duration": 2.4
  },
  {
    "id": 213,
    "text": "紧接着指出其以小见大的独特视角，",
    "start": 922.072,
    "end": 925.112,
    "duration": 3.04
  },
  {
    "id": 214,
    "text": "具体表述到答题语句就是：老舍没有从正面描写激烈的枪林弹雨与政党交锋，",
    "start": 925.112,
    "end": 931.327,
    "duration": 6.215
  },
  {
    "id": 215,
    "text": "而是通过一座小茶馆的人情冷暖与盛极而衰，",
    "start": 931.327,
    "end": 935.056,
    "duration": 3.729
  },
  {
    "id": 216,
    "text": "回答了重大的历史命题。。",
    "start": 935.056,
    "end": 937.018,
    "duration": 1.962
  },
  {
    "id": 217,
    "text": "随后总结各种资产阶级改良方案的全面幻灭，",
    "start": 937.018,
    "end": 940.747,
    "duration": 3.729
  },
  {
    "id": 218,
    "text": "具体表述到答题语句就是：无论是王利发的改良主义、",
    "start": 940.747,
    "end": 945.064,
    "duration": 4.317
  },
  {
    "id": 219,
    "text": "常四爷的硬骨头道德自救，还是秦仲义的资本救国，",
    "start": 945.064,
    "end": 949.186,
    "duration": 4.122
  },
  {
    "id": 220,
    "text": "在旧体制下全告破灭。。",
    "start": 949.186,
    "end": 950.952,
    "duration": 1.766
  },
  {
    "id": 221,
    "text": "紧接着指出其严密的写实逻辑与死亡判决，",
    "start": 951.08,
    "end": 954.76,
    "duration": 3.68
  },
  {
    "id": 222,
    "text": "具体表述到答题语句就是：剧作以最无情的写实逻辑证明了改良道路走不通，",
    "start": 954.76,
    "end": 960.871,
    "duration": 6.111
  },
  {
    "id": 223,
    "text": "宣告了旧时代不可逆转的死亡判决。。",
    "start": 960.871,
    "end": 963.712,
    "duration": 2.841
  },
  {
    "id": 224,
    "text": "最后升华到全剧昭示的历史真理，具体表述到答题语句就是：彰显出只有彻底变革旧世界才是人民唯一出路的深刻历史真理。。",
    "start": 963.712,
    "end": 973.56,
    "duration": 9.848
  },
  {
    "id": 225,
    "text": "最后，在思想内涵上，剧作蕴含着深邃的历史哲学反思，",
    "start": 973.64,
    "end": 978.84,
    "duration": 5.2
  },
  {
    "id": 226,
    "text": "雄辩昭示了旧社会灭亡的历史必然性。",
    "start": 978.84,
    "end": 982.36,
    "duration": 3.52
  },
  {
    "id": 227,
    "text": "老舍没有从正面描写激烈的枪林弹雨与政党交锋，",
    "start": 982.36,
    "end": 986.84,
    "duration": 4.48
  },
  {
    "id": 228,
    "text": "而是通过一座小茶馆的人情冷暖与盛极而衰，",
    "start": 986.84,
    "end": 991.16,
    "duration": 4.32
  },
  {
    "id": 229,
    "text": "回答了重大的历史命题。",
    "start": 991.16,
    "end": 993.24,
    "duration": 2.08
  },
  {
    "id": 230,
    "text": "无论是王利发的改良主义、常四爷的硬骨头道德自救，",
    "start": 993.24,
    "end": 997.96,
    "duration": 4.72
  },
  {
    "id": 231,
    "text": "还是秦仲义的资本救国，在旧体制下全告破灭。",
    "start": 997.96,
    "end": 1002.12,
    "duration": 4.16
  },
  {
    "id": 232,
    "text": "剧作以最无情的写实逻辑证明了改良道路走不通，",
    "start": 1002.44,
    "end": 1006.52,
    "duration": 4.08
  },
  {
    "id": 233,
    "text": "宣告了旧时代不可逆转的死亡判决，",
    "start": 1006.52,
    "end": 1009.72,
    "duration": 3.2
  },
  {
    "id": 234,
    "text": "彰显出只有彻底变革旧世界才是人民唯一出路的深刻历史真理。",
    "start": 1009.72,
    "end": 1015.72,
    "duration": 6.0
  },
  {
    "id": 235,
    "text": "--。（七",
    "start": 1015.72,
    "end": 1015.96,
    "duration": 0.24
  },
  {
    "id": 236,
    "text": "）总结升华板块。",
    "start": 1016.28,
    "end": 1017.72,
    "duration": 1.44
  },
  {
    "id": 237,
    "text": "收口推演逻辑：统领全剧在结构、群像、",
    "start": 1017.72,
    "end": 1021.64,
    "duration": 3.92
  },
  {
    "id": 238,
    "text": "意象、语言与历史哲学五个维度的非凡造诣，",
    "start": 1021.64,
    "end": 1025.72,
    "duration": 4.08
  },
  {
    "id": 239,
    "text": "再次点题其将民族形式与普遍人类悲剧命运相融的崇高境界，",
    "start": 1025.72,
    "end": 1031.32,
    "duration": 5.6
  },
  {
    "id": 240,
    "text": "完成考场论述的巅峰收束。",
    "start": 1031.32,
    "end": 1033.4,
    "duration": 2.08
  },
  {
    "id": 241,
    "text": "-逐句咬合推导：具体表述到答题语句就是：综上所述，",
    "start": 1033.48,
    "end": 1037.974,
    "duration": 4.494
  },
  {
    "id": 242,
    "text": "《茶馆》在结构创新、群像塑造、象征意象、",
    "start": 1037.974,
    "end": 1041.184,
    "duration": 3.21
  },
  {
    "id": 243,
    "text": "京味语言与历史哲学上均达到了不可逾越的高度。。",
    "start": 1041.184,
    "end": 1045.678,
    "duration": 4.494
  },
  {
    "id": 244,
    "text": "最后落到现代戏剧殿堂的定论，具体表述到答题语句就是：它以民族化的形式开掘了全人类的悲剧命运，",
    "start": 1045.678,
    "end": 1054.88,
    "duration": 9.202
  },
  {
    "id": 245,
    "text": "是无愧于中国现代戏剧史最高殿堂的传世经典。。",
    "start": 1054.88,
    "end": 1059.16,
    "duration": 4.28
  },
  {
    "id": 246,
    "text": "综上所述，《茶馆》在结构创新、群像塑造、",
    "start": 1059.24,
    "end": 1063.16,
    "duration": 3.92
  },
  {
    "id": 247,
    "text": "象征意象、京味语言与历史哲学上均达到了不可逾越的高度。",
    "start": 1063.16,
    "end": 1067.88,
    "duration": 4.72
  },
  {
    "id": 248,
    "text": "它以民族化的形式开掘了全人类的悲剧命运，",
    "start": 1067.88,
    "end": 1071.4,
    "duration": 3.52
  },
  {
    "id": 249,
    "text": "是无愧于中国现代戏剧史最高殿堂的传世经典。",
    "start": 1071.4,
    "end": 1075.32,
    "duration": 3.92
  }
]