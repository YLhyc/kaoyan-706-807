[
  {
    "id": 1,
    "text": "本题是 807 专业课中关于老舍戏剧创作的最高核心大题，分值为 30 分。",
    "start": 0.1,
    "end": 6.912,
    "duration": 6.812
  },
  {
    "id": 2,
    "text": "考查的核心目的，是要求考生系统论述《茶馆》何以成为中国话剧民族化的巅峰之作，全面论证其在图卷戏结构，人物群像，象征仪式，京味语言与历史哲学五大维度的典范贡献。",
    "start": 6.862,
    "end": 22.526,
    "duration": 15.664
  },
  {
    "id": 3,
    "text": "回答这道题不能仅停留在剧情复述上。",
    "start": 22.526,
    "end": 26.562,
    "duration": 4.036
  },
  {
    "id": 4,
    "text": "必须紧扣钱理群与朱栋霖教材的核心学理脉络，从“图卷戏散点透视”，“三位一体悲剧群像”，“三老汉撒纸钱国葬象征”，“京味台词艺术”以及“旧时代灭亡的历史哲学”五个经典维度展开深入剖析。",
    "start": 26.562,
    "end": 43.251,
    "duration": 16.689
  },
  {
    "id": 5,
    "text": "全篇确立五个核心论述维度，",
    "start": 43.251,
    "end": 46.142,
    "duration": 2.891
  },
  {
    "id": 6,
    "text": "第一是结构创新（独创图卷戏散点透视三幕，借鉴清明上河图，形散神聚）。",
    "start": 46.142,
    "end": 53.277,
    "duration": 7.135
  },
  {
    "id": 7,
    "text": "第二是群像谱系度量时代（王利发，常四爷，秦仲义三位一体悲剧）。",
    "start": 53.277,
    "end": 59.475,
    "duration": 6.198
  },
  {
    "id": 8,
    "text": "第三是悲喜交融美学与象征高潮（三老汉撒纸钱的文化国葬象征）。",
    "start": 59.475,
    "end": 65.959,
    "duration": 6.484
  },
  {
    "id": 9,
    "text": "第四是京味台词艺术（一句顶十句，高度个性化与潜台词）。",
    "start": 65.959,
    "end": 71.714,
    "duration": 5.755
  },
  {
    "id": 10,
    "text": "第五是历史哲学意蕴（改良走不通，回答重大时代命题，宣告旧社会死刑）。",
    "start": 71.715,
    "end": 78.369,
    "duration": 6.654
  },
  {
    "id": 11,
    "text": "这五个维度遵循着由空间舞台形式，到舞台行动主体，到审美仪式高潮，到媒介语言本体，再到思想哲学深度的严密推演链条。",
    "start": 78.368,
    "end": 90.412,
    "duration": 12.044
  },
  {
    "id": 12,
    "text": "图卷戏结构提供了容纳半个世纪时代的宏阔空间；",
    "start": 90.413,
    "end": 94.957,
    "duration": 4.544
  },
  {
    "id": 13,
    "text": "群像谱系展现了时代崩溃在具体个体身上的微观投射；",
    "start": 94.957,
    "end": 100.1,
    "duration": 5.143
  },
  {
    "id": 14,
    "text": "撒纸钱仪式将全剧的悲剧能量引爆为形而上的象征升华；",
    "start": 100.1,
    "end": 105.595,
    "duration": 5.495
  },
  {
    "id": 15,
    "text": "京味语言提供了不可替代的民族化文学媒介支撑；",
    "start": 105.595,
    "end": 110.113,
    "duration": 4.518
  },
  {
    "id": 16,
    "text": "历史哲学深度则最终完成了对中国近代历史走向的崇高定评。",
    "start": 110.113,
    "end": 115.855,
    "duration": 5.742
  },
  {
    "id": 17,
    "text": "五环相扣，逻辑缜密，雄辩有力。",
    "start": 115.855,
    "end": 119.201,
    "duration": 3.346
  },
  {
    "id": 18,
    "text": "老舍晚期创作的三幕话剧巅峰《茶馆》，是中国现代现实主义戏剧的扛鼎之作，更是中国话剧民族化探索的最高丰碑。",
    "start": 119.202,
    "end": 129.449,
    "duration": 10.247
  },
  {
    "id": 19,
    "text": "剧作截取清末戊戌变法失败，民国初年军阀混战与抗战胜利后国民党政权崩溃前夕三个历史断面，通过北京裕泰茶馆半个世纪的沉浮衰亡，为黑暗旧中国谱写了一曲沉痛而辛辣的时代挽歌。",
    "start": 129.449,
    "end": 147.088,
    "duration": 17.639
  },
  {
    "id": 20,
    "text": "老舍以独创的“图卷戏”散点透视结构，卓越的人物群像度量，悲喜交融的幽默意象与炉火纯青的京味语言，宣告了旧时代灭亡的历史必然性。",
    "start": 147.088,
    "end": 159.197,
    "duration": 12.109
  },
  {
    "id": 21,
    "text": "其卓越成就主要体现在以下五个核心维度，",
    "start": 159.197,
    "end": 163.455,
    "duration": 4.258
  },
  {
    "id": 22,
    "text": "彻底免除公历年份，直接以现代现实主义扛鼎之作与民族化最高丰碑立论，点明三个历史断面与时代挽歌，引出五大支柱。",
    "start": 163.455,
    "end": 174.718,
    "duration": 11.263
  },
  {
    "id": 23,
    "text": "第一，独创“图卷戏”三幕结构，实现对西方锁闭式传统戏剧的审美超越。",
    "start": 174.718,
    "end": 181.046,
    "duration": 6.328
  },
  {
    "id": 24,
    "text": "加粗动宾立桩，解析借鉴《清明上河图》散点透视法则，阐述数十个市井片段连缀与“形散而神聚”的化境。",
    "start": 181.046,
    "end": 191.02,
    "duration": 9.974
  },
  {
    "id": 25,
    "text": "第二，卓越的群像谱系度量时代崩塌，确立“没有主角的主角是时代”的深邃立意。",
    "start": 191.02,
    "end": 198.494,
    "duration": 7.474
  },
  {
    "id": 26,
    "text": "加粗动宾立桩，调取王利发（自缢后房），常四爷（冻饿交加买不起棺材）与秦仲义（工厂被拆毁）三位好人的共同绝境，证明被审判的主角是黑暗旧制度。",
    "start": 198.494,
    "end": 212.7,
    "duration": 14.206
  },
  {
    "id": 27,
    "text": "第三，熔铸悲喜交融的幽默格调，以“三老汉撒纸钱”铸就象征主义的华彩巅峰。",
    "start": 212.7,
    "end": 220.031,
    "duration": 7.331
  },
  {
    "id": 28,
    "text": "加粗动宾立桩，调取第三幕结尾三位老人互著作揖，狂笑撒冥纸名场面，解析为自己出殡与为旧时代举行“文化国葬”的深层象征意蕴。",
    "start": 220.031,
    "end": 232.661,
    "duration": 12.63
  },
  {
    "id": 29,
    "text": "第四，提炼纯正洗练的京味语言，确立中国现代白话话剧语言的最高典范。",
    "start": 232.661,
    "end": 239.953,
    "duration": 7.292
  },
  {
    "id": 30,
    "text": "加粗动宾立桩，解析老舍台词“一句顶十句”的潜台词深度，调取唐铁嘴俏皮，宋恩子吴祥子阴阳怪气与常四爷刚正硬气。",
    "start": 239.953,
    "end": 251.476,
    "duration": 11.523
  },
  {
    "id": 31,
    "text": "第五，深邃的历史哲学反思，雄辩昭示了旧制度灭亡的历史必然性。",
    "start": 251.476,
    "end": 257.57,
    "duration": 6.094
  },
  {
    "id": 32,
    "text": "加粗动宾立桩，总结王利发改良，常四爷道德自救，秦仲义实业救国的破灭，论证彻底社会变革的历史客观必然性。",
    "start": 257.57,
    "end": 268.508,
    "duration": 10.938
  },
  {
    "id": 33,
    "text": "综上所述，《茶馆》在结构创新，群像度量，象征意象，语言造诣与历史哲学上均达到了不可逾越的高度，是无愧于中国现代戏剧史最高殿堂的传世民族经典。",
    "start": 268.708,
    "end": 282.968,
    "duration": 14.26
  },
  {
    "id": 34,
    "text": "总结五大维度，升华传世民族经典定评。",
    "start": 282.918,
    "end": 287.098,
    "duration": 4.18
  }
]