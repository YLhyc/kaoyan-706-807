[
  {
    "id": 1,
    "text": "一、全题宏观破题与总揽。",
    "start": 0.0,
    "end": 2.272,
    "duration": 2.272
  },
  {
    "id": 2,
    "text": "一、这一问到底在考什么？",
    "start": 2.272,
    "end": 4.545,
    "duration": 2.273
  },
  {
    "id": 3,
    "text": "本题考查五四文学革命的发生背景、",
    "start": 4.545,
    "end": 7.953,
    "duration": 3.408
  },
  {
    "id": 4,
    "text": "发难发展、理论建设、社团格局与创作趋向。",
    "start": 7.953,
    "end": 11.816,
    "duration": 3.863
  },
  {
    "id": 5,
    "text": "考生必须从文学史全貌的高度，讲清中国文学如何从古代文言封建传统全面蜕变为现代白话新文学。",
    "start": 11.816,
    "end": 21.36,
    "duration": 9.544
  },
  {
    "id": 6,
    "text": "二、答题的总方向是什么？",
    "start": 21.52,
    "end": 23.84,
    "duration": 2.32
  },
  {
    "id": 7,
    "text": "紧扣钱理群《中国现代文学三十年》第一章与朱栋霖《中国现代文学史》的权威论述。",
    "start": 23.84,
    "end": 31.19,
    "duration": 7.35
  },
  {
    "id": 8,
    "text": "紧扣“启蒙动力线”、“从破坏转向建设”、",
    "start": 31.19,
    "end": 34.171,
    "duration": 2.981
  },
  {
    "id": 9,
    "text": "“胡适立形周作人立容”三大核心主轴，",
    "start": 34.171,
    "end": 37.366,
    "duration": 3.195
  },
  {
    "id": 10,
    "text": "绝不能仅仅停留在白话文运动表面。",
    "start": 37.366,
    "end": 40.56,
    "duration": 3.194
  },
  {
    "id": 11,
    "text": "三、分几个板块展开？",
    "start": 40.72,
    "end": 42.56,
    "duration": 1.84
  },
  {
    "id": 12,
    "text": "全篇严格按照四大经典板块层层推进：第一板块：历史动因与破旧发难（晚清序幕、",
    "start": 42.56,
    "end": 49.92,
    "duration": 7.36
  },
  {
    "id": 13,
    "text": "新青年与北大阵地、胡适陈独秀发难、",
    "start": 49.92,
    "end": 53.44,
    "duration": 3.52
  },
  {
    "id": 14,
    "text": "论争破旧）。",
    "start": 53.44,
    "end": 54.56,
    "duration": 1.12
  },
  {
    "id": 15,
    "text": "第二板块：初期理论建设双翼（胡适立语言形式与国语文学生成、",
    "start": 54.56,
    "end": 60.4,
    "duration": 5.84
  },
  {
    "id": 16,
    "text": "周作人立人的文学内容灵魂）。",
    "start": 60.4,
    "end": 62.4,
    "duration": 2.0
  },
  {
    "id": 17,
    "text": "第三板块：思潮涌入与社团蜂起（从破坏转向建设、",
    "start": 62.72,
    "end": 67.68,
    "duration": 4.96
  },
  {
    "id": 18,
    "text": "文学研究会与创造社双峰对峙）。",
    "start": 67.68,
    "end": 70.72,
    "duration": 3.04
  },
  {
    "id": 19,
    "text": "第四板块：第一个十年创作潮流与实绩（启蒙、",
    "start": 70.72,
    "end": 75.04,
    "duration": 4.32
  },
  {
    "id": 20,
    "text": "感伤、个性化与多元方法，鲁迅郭沫若郁达夫实绩）。",
    "start": 75.04,
    "end": 79.92,
    "duration": 4.88
  },
  {
    "id": 21,
    "text": "四、全篇内在逻辑链条是什么？",
    "start": 79.92,
    "end": 82.32,
    "duration": 2.4
  },
  {
    "id": 22,
    "text": "由新文化运动启蒙动力破题、趋近于、",
    "start": 82.48,
    "end": 85.6,
    "duration": 3.12
  },
  {
    "id": 23,
    "text": "剖析打破旧文学垄断的发生动因与发难论争（破之历程）趋近于、",
    "start": 85.6,
    "end": 91.36,
    "duration": 5.76
  },
  {
    "id": 24,
    "text": "阐发从形式与内容两端构筑蓝图的理论先声（立之图纸）趋近于、",
    "start": 91.36,
    "end": 97.04,
    "duration": 5.68
  },
  {
    "id": 25,
    "text": "展现集结文学生力军的社团组织与思潮吸收（建设之柱）趋近于、",
    "start": 97.04,
    "end": 102.8,
    "duration": 5.76
  },
  {
    "id": 26,
    "text": "落实于由宣言变为现实的经典艺术创作浪潮（实践之果）。",
    "start": 102.8,
    "end": 107.52,
    "duration": 4.72
  },
  {
    "id": 27,
    "text": "五环咬合，浑然天成。",
    "start": 107.76,
    "end": 109.84,
    "duration": 2.08
  },
  {
    "id": 28,
    "text": "--。二",
    "start": 109.84,
    "end": 110.08,
    "duration": 0.24
  },
  {
    "id": 29,
    "text": "、各板块逐句咬合推演。",
    "start": 110.32,
    "end": 112.4,
    "duration": 2.08
  },
  {
    "id": 30,
    "text": "（一）宏观定性与破题总起板块。",
    "start": 112.4,
    "end": 115.52,
    "duration": 3.12
  },
  {
    "id": 31,
    "text": "破题推演逻辑：开头必须展现宏大史观。",
    "start": 115.52,
    "end": 119.12,
    "duration": 3.6
  },
  {
    "id": 32,
    "text": "界定文学革命作为古典向现代转型的伟大分水岭，",
    "start": 119.12,
    "end": 123.44,
    "duration": 4.32
  },
  {
    "id": 33,
    "text": "交代启蒙动力、白话形式与“人的文学”三大核心支撑。",
    "start": 123.44,
    "end": 127.84,
    "duration": 4.4
  },
  {
    "id": 34,
    "text": "指出其摧毁旧传统、奠定现代文学基因的崇高历史功绩，",
    "start": 128.16,
    "end": 133.2,
    "duration": 5.04
  },
  {
    "id": 35,
    "text": "顺畅引出分述。",
    "start": 133.2,
    "end": 134.64,
    "duration": 1.44
  },
  {
    "id": 36,
    "text": "逐句咬合推导：具体表述到答题语句就是：五四文学革命是中国文学由古代走向现代的伟大历史分水岭。，",
    "start": 134.64,
    "end": 143.937,
    "duration": 9.297
  },
  {
    "id": 37,
    "text": "这是对考察对象的历史最高定性。",
    "start": 143.937,
    "end": 147.014,
    "duration": 3.077
  },
  {
    "id": 38,
    "text": "紧接着指出其思想动力的根本源泉，",
    "start": 147.014,
    "end": 150.31,
    "duration": 3.296
  },
  {
    "id": 39,
    "text": "具体表述到答题语句就是：它以新文化运动的思想启蒙为根本动力。",
    "start": 150.31,
    "end": 156.464,
    "duration": 6.154
  },
  {
    "id": 40,
    "text": "随后指出其文体语言的突破口，具体表述到答题语句就是：它以白话文取代文言文为形式突破口。",
    "start": 156.624,
    "end": 164.322,
    "duration": 7.698
  },
  {
    "id": 41,
    "text": "紧接着指出其思想内容的核心，具体表述到答题语句就是：它以“人的文学”为思想内容核心。",
    "start": 164.322,
    "end": 171.406,
    "duration": 7.084
  },
  {
    "id": 42,
    "text": "随后说明这场革命对旧体系的彻底终结，",
    "start": 171.406,
    "end": 174.66,
    "duration": 3.254
  },
  {
    "id": 43,
    "text": "具体表述到答题语句就是：这场全方位的文学革命彻底终结了中国古典文学的统治地位。",
    "start": 174.66,
    "end": 181.744,
    "duration": 7.084
  },
  {
    "id": 44,
    "text": "紧接着列出文学革命带来的全方位转变，",
    "start": 181.824,
    "end": 184.944,
    "duration": 3.12
  },
  {
    "id": 45,
    "text": "具体表述到答题语句就是：它完成了文学观念、",
    "start": 184.944,
    "end": 188.756,
    "duration": 3.812
  },
  {
    "id": 46,
    "text": "思想内容、语言工具与文体形式的现代转型。",
    "start": 188.756,
    "end": 192.328,
    "duration": 3.572
  },
  {
    "id": 47,
    "text": "随后交代其从破坏到建设的跨越，具体表述到答题语句就是：它在现代报刊媒介与现代知识分子群体的支撑下，",
    "start": 192.328,
    "end": 201.455,
    "duration": 9.127
  },
  {
    "id": 48,
    "text": "完成了从破坏旧文学到建设新文学的历史飞跃。",
    "start": 201.455,
    "end": 205.424,
    "duration": 3.969
  },
  {
    "id": 49,
    "text": "最后落到精神基因的升华，具体表述到答题语句就是：为中国现代文学铸造了深沉的启蒙精神基因。",
    "start": 205.504,
    "end": 213.984,
    "duration": 8.48
  },
  {
    "id": 50,
    "text": "五四文学革命是中国文学由古代走向现代的伟大历史分水岭。",
    "start": 213.984,
    "end": 218.944,
    "duration": 4.96
  },
  {
    "id": 51,
    "text": "它以新文化运动的思想启蒙为根本动力。",
    "start": 218.944,
    "end": 222.144,
    "duration": 3.2
  },
  {
    "id": 52,
    "text": "它以白话文取代文言文为形式突破口。",
    "start": 222.144,
    "end": 225.104,
    "duration": 2.96
  },
  {
    "id": 53,
    "text": "它以“人的文学”为思想内容核心。",
    "start": 225.344,
    "end": 228.464,
    "duration": 3.12
  },
  {
    "id": 54,
    "text": "这场全方位的文学革命彻底终结了中国古典文学的统治地位。",
    "start": 228.464,
    "end": 233.824,
    "duration": 5.36
  },
  {
    "id": 55,
    "text": "它完成了文学观念、思想内容、语言工具与文体形式的现代转型。",
    "start": 233.824,
    "end": 239.664,
    "duration": 5.84
  },
  {
    "id": 56,
    "text": "它在现代报刊媒介与现代知识分子群体的支撑下，",
    "start": 239.664,
    "end": 243.664,
    "duration": 4.0
  },
  {
    "id": 57,
    "text": "完成了从破坏旧文学到建设新文学的历史飞跃，",
    "start": 243.664,
    "end": 247.744,
    "duration": 4.08
  },
  {
    "id": 58,
    "text": "为中国现代文学铸造了深沉的启蒙精神基因。",
    "start": 247.744,
    "end": 251.424,
    "duration": 3.68
  },
  {
    "id": 59,
    "text": "（二）第一板块：历史发生动因与破旧斗争。",
    "start": 251.584,
    "end": 255.308,
    "duration": 3.724
  },
  {
    "id": 60,
    "text": "论证推演逻辑：讲透文学革命的历史发生，",
    "start": 255.308,
    "end": 258.992,
    "duration": 3.684
  },
  {
    "id": 61,
    "text": "不能割裂近代演进。",
    "start": 258.992,
    "end": 260.752,
    "duration": 1.76
  },
  {
    "id": 62,
    "text": "首先点出晚清三界革命的序幕铺垫，",
    "start": 260.752,
    "end": 263.952,
    "duration": 3.2
  },
  {
    "id": 63,
    "text": "接着交代辛亥帝制崩塌与现代知识分子群体的生成条件，",
    "start": 263.952,
    "end": 268.912,
    "duration": 4.96
  },
  {
    "id": 64,
    "text": "随后点出《新青年》民主科学阵地，",
    "start": 268.912,
    "end": 271.792,
    "duration": 2.88
  },
  {
    "id": 65,
    "text": "核心展开胡适《文学改良刍议》的温和发难与陈独秀《文学革命论》三大主义的激进立旗，",
    "start": 271.792,
    "end": 278.672,
    "duration": 6.88
  },
  {
    "id": 66,
    "text": "最后总结批判渊秧蝴蝶派与击溃林纾、",
    "start": 278.672,
    "end": 282.512,
    "duration": 3.84
  },
  {
    "id": 67,
    "text": "学衡派论争的破旧实绩。",
    "start": 282.512,
    "end": 284.432,
    "duration": 1.92
  },
  {
    "id": 68,
    "text": "-逐句咬合推导：具体表述到答题语句就是：首先，",
    "start": 284.592,
    "end": 288.263,
    "duration": 3.671
  },
  {
    "id": 69,
    "text": "在历史发生上，文学革命是近代社会变革与思想启蒙浪潮汇聚的必然产物。，",
    "start": 288.263,
    "end": 294.253,
    "duration": 5.99
  },
  {
    "id": 70,
    "text": "这是第一分论点的核心观点立桩。",
    "start": 294.253,
    "end": 296.958,
    "duration": 2.705
  },
  {
    "id": 71,
    "text": "紧接着交代近代历史积累的序幕，具体表述到答题语句就是：晚清时期的诗界革命、",
    "start": 296.958,
    "end": 303.528,
    "duration": 6.57
  },
  {
    "id": 72,
    "text": "文界革命与小说界革命拉开了文学变革的序幕。",
    "start": 303.528,
    "end": 307.392,
    "duration": 3.864
  },
  {
    "id": 73,
    "text": "随后说明社会转型造就的主体条件，",
    "start": 307.552,
    "end": 310.752,
    "duration": 3.2
  },
  {
    "id": 74,
    "text": "具体表述到答题语句就是：辛亥革命推翻帝制与现代学堂的建立，",
    "start": 310.752,
    "end": 316.445,
    "duration": 5.693
  },
  {
    "id": 75,
    "text": "孕育出具有独立启蒙意识的现代知识分子群体。",
    "start": 316.445,
    "end": 320.579,
    "duration": 4.134
  },
  {
    "id": 76,
    "text": "紧接着指出核心刊物阵地与旗帜，具体表述到答题语句就是：以《新青年》为核心阵地，",
    "start": 320.579,
    "end": 327.605,
    "duration": 7.026
  },
  {
    "id": 77,
    "text": "文学革命高举民主与科学的两大旗帜。",
    "start": 327.605,
    "end": 330.912,
    "duration": 3.307
  },
  {
    "id": 78,
    "text": "随后详细剖析胡适的发难之功，具体表述到答题语句就是：一九一七年胡适发表《文学改良刍议》，",
    "start": 331.072,
    "end": 339.17,
    "duration": 8.098
  },
  {
    "id": 79,
    "text": "从历史进化论出发提出八事主张，温和持重地发难。",
    "start": 339.17,
    "end": 343.621,
    "duration": 4.451
  },
  {
    "id": 80,
    "text": "紧接着剖析陈独秀的革命旗帜，具体表述到答题语句就是：陈独秀紧接着发表《文学革命论》，",
    "start": 343.621,
    "end": 351.462,
    "duration": 7.841
  },
  {
    "id": 81,
    "text": "旗帜鲜明地提出三大主义，将旧文学定性为专制政体与封建国民性的温床。",
    "start": 351.462,
    "end": 358.032,
    "duration": 6.57
  },
  {
    "id": 82,
    "text": "最后总结反击保守派论争的破旧胜利，",
    "start": 358.192,
    "end": 361.392,
    "duration": 3.2
  },
  {
    "id": 83,
    "text": "具体表述到答题语句就是：面对林纾、",
    "start": 361.392,
    "end": 364.592,
    "duration": 3.2
  },
  {
    "id": 84,
    "text": "学衡派与甲寅派的顽固抵抗，先驱者在论战中破除了“文以载道”与游戏消遣的旧观念，",
    "start": 364.592,
    "end": 371.792,
    "duration": 7.2
  },
  {
    "id": 85,
    "text": "确立了新文学的历史合法性。",
    "start": 371.792,
    "end": 373.952,
    "duration": 2.16
  },
  {
    "id": 86,
    "text": "首先，在历史发生上，文学革命是近代社会变革与思想启蒙浪潮汇聚的必然产物。",
    "start": 374.32,
    "end": 381.76,
    "duration": 7.44
  },
  {
    "id": 87,
    "text": "晚清时期的诗界革命、文界革命与小说界革命拉开了文学变革的序幕。",
    "start": 381.76,
    "end": 387.84,
    "duration": 6.08
  },
  {
    "id": 88,
    "text": "辛亥革命推翻帝制与现代学堂的建立，",
    "start": 387.84,
    "end": 391.2,
    "duration": 3.36
  },
  {
    "id": 89,
    "text": "孕育出具有独立启蒙意识的现代知识分子群体。",
    "start": 391.2,
    "end": 394.72,
    "duration": 3.52
  },
  {
    "id": 90,
    "text": "以《新青年》为核心阵地，文学革命高举民主与科学的两大旗帜。",
    "start": 395.04,
    "end": 400.56,
    "duration": 5.52
  },
  {
    "id": 91,
    "text": "一九一七年胡适发表《文学改良刍议》，",
    "start": 400.56,
    "end": 404.08,
    "duration": 3.52
  },
  {
    "id": 92,
    "text": "从历史进化论出发提出八事主张，温和持重地发难。",
    "start": 404.08,
    "end": 408.64,
    "duration": 4.56
  },
  {
    "id": 93,
    "text": "陈独秀紧接着发表《文学革命论》，",
    "start": 408.64,
    "end": 411.52,
    "duration": 2.88
  },
  {
    "id": 94,
    "text": "旗帜鲜明地提出三大主义，将旧文学定性为专制政体与封建国民性的温床。",
    "start": 411.52,
    "end": 417.44,
    "duration": 5.92
  },
  {
    "id": 95,
    "text": "面对林纾、学衡派与甲寅派的顽固抵抗，",
    "start": 417.76,
    "end": 421.04,
    "duration": 3.28
  },
  {
    "id": 96,
    "text": "先驱者在论战中破除了“文以载道”与游戏消遣的旧观念，",
    "start": 421.04,
    "end": 426.0,
    "duration": 4.96
  },
  {
    "id": 97,
    "text": "确立了新文学的历史合法性。",
    "start": 426.0,
    "end": 428.32,
    "duration": 2.32
  },
  {
    "id": 98,
    "text": "（三）第二板块：初期理论建设，胡适立形与周作人立容。",
    "start": 428.32,
    "end": 433.52,
    "duration": 5.2
  },
  {
    "id": 99,
    "text": "论证推演逻辑：文学革命是“理论先行”的典型。",
    "start": 433.52,
    "end": 437.04,
    "duration": 3.52
  },
  {
    "id": 100,
    "text": "必须讲清胡适与周作人的历史分工。",
    "start": 437.36,
    "end": 440.4,
    "duration": 3.04
  },
  {
    "id": 101,
    "text": "胡适管形式：主张历史的文学观念论，",
    "start": 440.4,
    "end": 443.76,
    "duration": 3.36
  },
  {
    "id": 102,
    "text": "提出“国语的文学，文学的国语”，",
    "start": 443.76,
    "end": 446.56,
    "duration": 2.8
  },
  {
    "id": 103,
    "text": "将白话文提升为现代民族国家建构的工具。",
    "start": 446.56,
    "end": 450.08,
    "duration": 3.52
  },
  {
    "id": 104,
    "text": "周作人管内容：发表《人的文学》，",
    "start": 450.08,
    "end": 452.88,
    "duration": 2.8
  },
  {
    "id": 105,
    "text": "高举人道主义与人间本位，把文学确立为重新发现人、",
    "start": 452.88,
    "end": 457.84,
    "duration": 4.96
  },
  {
    "id": 106,
    "text": "同情人生苦难的武器。",
    "start": 457.84,
    "end": 459.44,
    "duration": 1.6
  },
  {
    "id": 107,
    "text": "两者合力完成现代文学的本质确立。",
    "start": 459.68,
    "end": 462.48,
    "duration": 2.8
  },
  {
    "id": 108,
    "text": "逐句咬合推导：具体表述到答题语句就是：其次，",
    "start": 462.48,
    "end": 466.565,
    "duration": 4.085
  },
  {
    "id": 109,
    "text": "在理论建设上，五四文学革命形成了“胡适立形式、",
    "start": 466.565,
    "end": 470.735,
    "duration": 4.17
  },
  {
    "id": 110,
    "text": "周作人立内容”的双重奠基。，",
    "start": 470.735,
    "end": 473.029,
    "duration": 2.294
  },
  {
    "id": 111,
    "text": "这是第二分论点的观点立桩。",
    "start": 473.029,
    "end": 475.531,
    "duration": 2.502
  },
  {
    "id": 112,
    "text": "紧接着指出其突出的理论先行特质，",
    "start": 475.531,
    "end": 478.659,
    "duration": 3.128
  },
  {
    "id": 113,
    "text": "具体表述到答题语句就是：文学革命具有鲜明的理论先行特征。",
    "start": 478.659,
    "end": 484.08,
    "duration": 5.421
  },
  {
    "id": 114,
    "text": "随后切入胡适在形式层面的理论建树，",
    "start": 484.24,
    "end": 487.28,
    "duration": 3.04
  },
  {
    "id": 115,
    "text": "具体表述到答题语句就是：胡适致力于语言形式的根本解放。",
    "start": 487.28,
    "end": 492.154,
    "duration": 4.874
  },
  {
    "id": 116,
    "text": "紧接着阐释国语文学的民族国家战略，",
    "start": 492.154,
    "end": 495.323,
    "duration": 3.169
  },
  {
    "id": 117,
    "text": "具体表述到答题语句就是：他在《建设的文学革命论》中提出“国语的文学，",
    "start": 495.323,
    "end": 501.065,
    "duration": 5.742
  },
  {
    "id": 118,
    "text": "文学的国语”的宏伟构想，将文学语言改革升格为现代民族国家建构的文化战略。",
    "start": 501.065,
    "end": 507.6,
    "duration": 6.535
  },
  {
    "id": 119,
    "text": "随后转入周作人在内容精神上的重大奠基，",
    "start": 507.68,
    "end": 511.04,
    "duration": 3.36
  },
  {
    "id": 120,
    "text": "具体表述到答题语句就是：周作人则在《人的文学》中奠定了新文学的思想灵魂。",
    "start": 511.04,
    "end": 517.12,
    "duration": 6.08
  },
  {
    "id": 121,
    "text": "紧接着展开“人的文学”的核心内涵，",
    "start": 517.496,
    "end": 519.976,
    "duration": 2.48
  },
  {
    "id": 122,
    "text": "具体表述到答题语句就是：他高扬人道主义大旗，",
    "start": 519.976,
    "end": 523.816,
    "duration": 3.84
  },
  {
    "id": 123,
    "text": "强调以个人主义的人间本位重新发现人，",
    "start": 523.816,
    "end": 526.856,
    "duration": 3.04
  },
  {
    "id": 124,
    "text": "要求新文学必须真挚描写普通人的真实痛苦与灵肉一致的人性。",
    "start": 526.856,
    "end": 531.656,
    "duration": 4.8
  },
  {
    "id": 125,
    "text": "最后总结形式与内容合璧后的现代审美独立，",
    "start": 531.656,
    "end": 534.856,
    "duration": 3.2
  },
  {
    "id": 126,
    "text": "具体表述到答题语句就是：这种形式与内容的双重合璧，",
    "start": 534.856,
    "end": 539.016,
    "duration": 4.16
  },
  {
    "id": 127,
    "text": "使新文学彻底摆脱了封建附庸地位，",
    "start": 539.016,
    "end": 541.736,
    "duration": 2.72
  },
  {
    "id": 128,
    "text": "确立了以人为主体的现代审美本位。",
    "start": 541.736,
    "end": 544.056,
    "duration": 2.32
  },
  {
    "id": 129,
    "text": "其次，在理论建设上，五四文学革命形成了“胡适立形式、",
    "start": 544.376,
    "end": 549.096,
    "duration": 4.72
  },
  {
    "id": 130,
    "text": "周作人立内容”的双重奠基。",
    "start": 549.096,
    "end": 551.256,
    "duration": 2.16
  },
  {
    "id": 131,
    "text": "文学革命具有鲜明的理论先行特征。",
    "start": 551.256,
    "end": 554.136,
    "duration": 2.88
  },
  {
    "id": 132,
    "text": "胡适致力于语言形式的根本解放。",
    "start": 554.136,
    "end": 556.536,
    "duration": 2.4
  },
  {
    "id": 133,
    "text": "他在《建设的文学革命论》中提出“国语的文学，",
    "start": 556.536,
    "end": 559.976,
    "duration": 3.44
  },
  {
    "id": 134,
    "text": "文学的国语”的宏伟构想，将文学语言改革升格为现代民族国家建构的文化战略。",
    "start": 559.976,
    "end": 566.376,
    "duration": 6.4
  },
  {
    "id": 135,
    "text": "周作人则在《人的文学》中奠定了新文学的思想灵魂。",
    "start": 566.616,
    "end": 570.696,
    "duration": 4.08
  },
  {
    "id": 136,
    "text": "他高扬人道主义大旗，强调以个人主义的人间本位重新发现人，",
    "start": 570.696,
    "end": 576.536,
    "duration": 5.84
  },
  {
    "id": 137,
    "text": "要求新文学必须真挚描写普通人的真实痛苦与灵肉一致的人性。",
    "start": 576.536,
    "end": 581.896,
    "duration": 5.36
  },
  {
    "id": 138,
    "text": "这种形式与内容的双重合璧，使新文学彻底摆脱了封建附庸地位，",
    "start": 581.896,
    "end": 587.336,
    "duration": 5.44
  },
  {
    "id": 139,
    "text": "确立了以人为主体的现代审美本位。",
    "start": 587.336,
    "end": 590.216,
    "duration": 2.88
  },
  {
    "id": 140,
    "text": "（四）第三板块：外来思潮中国化与社团蜂起格局。",
    "start": 590.376,
    "end": 594.033,
    "duration": 3.657
  },
  {
    "id": 141,
    "text": "论证推演逻辑：破坏旧文学之后，必须依靠社团生力军进行建设。",
    "start": 594.033,
    "end": 599.037,
    "duration": 5.004
  },
  {
    "id": 142,
    "text": "必须说明外国思潮涌入并经过“中国化”过滤的过程。",
    "start": 599.037,
    "end": 603.079,
    "duration": 4.042
  },
  {
    "id": 143,
    "text": "核心展现文学研究会与创造社的双峰对峙：文研会立足国内对立渊蝴，",
    "start": 603.079,
    "end": 608.66,
    "duration": 5.581
  },
  {
    "id": 144,
    "text": "主张为人生与现实主义社会观察，创造社生于海外留日屈辱，",
    "start": 608.66,
    "end": 613.472,
    "duration": 4.812
  },
  {
    "id": 145,
    "text": "主张为艺术、自我表现与浪漫主义个性倾泻。",
    "start": 613.472,
    "end": 616.936,
    "duration": 3.464
  },
  {
    "id": 146,
    "text": "两者同源分流、互相砥砺，共同夯实了新文学基础。",
    "start": 617.016,
    "end": 621.576,
    "duration": 4.56
  },
  {
    "id": 147,
    "text": "逐句咬合推导：具体表述到答题语句就是：第三，",
    "start": 621.576,
    "end": 625.708,
    "duration": 4.132
  },
  {
    "id": 148,
    "text": "在社团建设上，外来思潮的中国化催生了文学生力军的蜂起与两座高峰的对峙。，",
    "start": 625.708,
    "end": 632.354,
    "duration": 6.646
  },
  {
    "id": 149,
    "text": "这是第三分论点的提纲窃领。",
    "start": 632.354,
    "end": 634.77,
    "duration": 2.416
  },
  {
    "id": 150,
    "text": "紧接着说明运动重心由破坏转向建设的关键转折，",
    "start": 634.77,
    "end": 638.999,
    "duration": 4.229
  },
  {
    "id": 151,
    "text": "具体表述到答题语句就是：文学革命随后迅速由少数先驱的激进破坏转向大规模的社团自觉建设。",
    "start": 638.999,
    "end": 647.256,
    "duration": 8.257
  },
  {
    "id": 152,
    "text": "随后说明外来思潮的中国化过滤机制，",
    "start": 647.416,
    "end": 650.536,
    "duration": 3.12
  },
  {
    "id": 153,
    "text": "具体表述到答题语句就是：各种外国文艺思潮被创造性地中国化吸收。",
    "start": 650.536,
    "end": 656.136,
    "duration": 5.6
  },
  {
    "id": 154,
    "text": "紧接着点明两大核心社团的成立标志，",
    "start": 656.584,
    "end": 659.544,
    "duration": 2.96
  },
  {
    "id": 155,
    "text": "具体表述到答题语句就是：一九二一年文学研究会与创造社的成立标志着新文学走向成熟。",
    "start": 659.544,
    "end": 667.26,
    "duration": 7.716
  },
  {
    "id": 156,
    "text": "随后剖析文学研究会的主张与路径，",
    "start": 667.26,
    "end": 670.291,
    "duration": 3.031
  },
  {
    "id": 157,
    "text": "具体表述到答题语句就是：文学研究会高扬“为人生”的现实主义旗帜，",
    "start": 670.291,
    "end": 675.949,
    "duration": 5.658
  },
  {
    "id": 158,
    "text": "注重对社会病态的实地观察与冷静解剖。",
    "start": 675.949,
    "end": 679.384,
    "duration": 3.435
  },
  {
    "id": 159,
    "text": "紧接着剖析创造社的主张与路径，具体表述到答题语句就是：创造社高扬“为艺术”的浪漫主义旗帜，",
    "start": 679.464,
    "end": 687.052,
    "duration": 7.588
  },
  {
    "id": 160,
    "text": "主张直抒胸臆的自我表现与反抗旧世界的个性解放。",
    "start": 687.052,
    "end": 691.336,
    "duration": 4.284
  },
  {
    "id": 161,
    "text": "最后总结两社团双峰对峙的合力作用，",
    "start": 691.336,
    "end": 694.452,
    "duration": 3.116
  },
  {
    "id": 162,
    "text": "具体表述到答题语句就是：两社团虽在文学主张上各有侧重，",
    "start": 694.452,
    "end": 699.32,
    "duration": 4.868
  },
  {
    "id": 163,
    "text": "却共同向封建旧文学发起猛攻，形成了互相砥砺的双峰对峙格局，",
    "start": 699.32,
    "end": 704.578,
    "duration": 5.258
  },
  {
    "id": 164,
    "text": "极大充实了新文学的队伍与阵地。",
    "start": 704.578,
    "end": 707.304,
    "duration": 2.726
  },
  {
    "id": 165,
    "text": "第三，在社团建设上，外来思潮的中国化催生了文学生力军的蜂起与两座高峰的对峙。",
    "start": 707.384,
    "end": 714.904,
    "duration": 7.52
  },
  {
    "id": 166,
    "text": "文学革命随后迅速由少数先驱的激进破坏转向大规模的社团自觉建设。",
    "start": 714.904,
    "end": 720.984,
    "duration": 6.08
  },
  {
    "id": 167,
    "text": "各种外国文艺思潮被创造性地中国化吸收。",
    "start": 720.984,
    "end": 724.504,
    "duration": 3.52
  },
  {
    "id": 168,
    "text": "一九二一年文学研究会与创造社的成立标志着新文学走向成熟。",
    "start": 724.504,
    "end": 729.784,
    "duration": 5.28
  },
  {
    "id": 169,
    "text": "文学研究会高扬“为人生”的现实主义旗帜，",
    "start": 730.024,
    "end": 733.384,
    "duration": 3.36
  },
  {
    "id": 170,
    "text": "注重对社会病态的实地观察与冷静解剖。",
    "start": 733.384,
    "end": 736.984,
    "duration": 3.6
  },
  {
    "id": 171,
    "text": "创造社高扬“为艺术”的浪漫主义旗帜，",
    "start": 736.984,
    "end": 739.944,
    "duration": 2.96
  },
  {
    "id": 172,
    "text": "主张直抒胸臆的自我表现与反抗旧世界的个性解放。",
    "start": 739.944,
    "end": 744.344,
    "duration": 4.4
  },
  {
    "id": 173,
    "text": "两社团虽在文学主张上各有侧重，却共同向封建旧文学发起猛攻，",
    "start": 744.344,
    "end": 750.104,
    "duration": 5.76
  },
  {
    "id": 174,
    "text": "形成了互相砥砺的双峰对峙格局，极大充实了新文学的队伍与阵地。",
    "start": 750.104,
    "end": 755.224,
    "duration": 5.12
  },
  {
    "id": 175,
    "text": "（五）第四板块：第一个十年创作潮流与实绩。",
    "start": 755.384,
    "end": 758.819,
    "duration": 3.435
  },
  {
    "id": 176,
    "text": "论证推演逻辑：理论图纸必须经受创作实践的检验。",
    "start": 758.819,
    "end": 763.062,
    "duration": 4.243
  },
  {
    "id": 177,
    "text": "引用钱理群概括的第一个十年四大趋向：启蒙、",
    "start": 763.062,
    "end": 766.9,
    "duration": 3.838
  },
  {
    "id": 178,
    "text": "感伤、个性化与多元方法。",
    "start": 766.9,
    "end": 768.921,
    "duration": 2.021
  },
  {
    "id": 179,
    "text": "以鲁迅的小说深度、郁达夫的自叙传、",
    "start": 768.921,
    "end": 771.952,
    "duration": 3.031
  },
  {
    "id": 180,
    "text": "郭沫若的自由诗等具体作品为证据，",
    "start": 771.952,
    "end": 774.982,
    "duration": 3.03
  },
  {
    "id": 181,
    "text": "说明新文学在各文体上全面确立了现代审美形态，",
    "start": 774.982,
    "end": 779.225,
    "duration": 4.243
  },
  {
    "id": 182,
    "text": "并指出十年后期自然收束于现实主义的深化。",
    "start": 779.225,
    "end": 783.064,
    "duration": 3.839
  },
  {
    "id": 183,
    "text": "-逐句咬合推导：具体表述到答题语句就是：最后，",
    "start": 783.064,
    "end": 787.026,
    "duration": 3.962
  },
  {
    "id": 184,
    "text": "在创作实践上，第一个十年的创作潮流展现出波澜壮阔的现代转型趋向。，",
    "start": 787.026,
    "end": 793.282,
    "duration": 6.256
  },
  {
    "id": 185,
    "text": "这是第四分论点的核心观点。",
    "start": 793.282,
    "end": 795.784,
    "duration": 2.502
  },
  {
    "id": 186,
    "text": "紧接着指出理论转化为艺术实绩的实证力量，",
    "start": 795.92,
    "end": 800.0,
    "duration": 4.08
  },
  {
    "id": 187,
    "text": "具体表述到答题语句就是：文学革命不仅停留在宣言论争，",
    "start": 800.0,
    "end": 805.195,
    "duration": 5.195
  },
  {
    "id": 188,
    "text": "更迅速转化为丰硕的艺术实绩。",
    "start": 805.195,
    "end": 808.076,
    "duration": 2.881
  },
  {
    "id": 189,
    "text": "随后亮出钱理群总结的四大经典趋向，",
    "start": 808.076,
    "end": 811.622,
    "duration": 3.546
  },
  {
    "id": 190,
    "text": "具体表述到答题语句就是：创作潮流整体呈现出启蒙、",
    "start": 811.622,
    "end": 816.497,
    "duration": 4.875
  },
  {
    "id": 191,
    "text": "感伤、个性化与多元方法四大趋向。",
    "start": 816.497,
    "end": 819.6,
    "duration": 3.103
  },
  {
    "id": 192,
    "text": "紧接着切入鲁迅小说的开创性高度，",
    "start": 819.68,
    "end": 822.4,
    "duration": 2.72
  },
  {
    "id": 193,
    "text": "具体表述到答题语句就是：以鲁迅《狂人日记》与《阿Q正传》为标志，",
    "start": 822.4,
    "end": 827.688,
    "duration": 5.288
  },
  {
    "id": 194,
    "text": "新小说以极高的思想起点确立了现代反封建的批判力量。",
    "start": 827.688,
    "end": 832.533,
    "duration": 4.845
  },
  {
    "id": 195,
    "text": "随后切入郁达夫与郭沫若的个性与感伤潮，",
    "start": 832.533,
    "end": 836.168,
    "duration": 3.635
  },
  {
    "id": 196,
    "text": "具体表述到答题语句就是：郁达夫《沉沦》的大胆自叙传与郭沫若《女神》的自由奔涌，",
    "start": 836.168,
    "end": 842.83,
    "duration": 6.662
  },
  {
    "id": 197,
    "text": "展现了五四青年苏醒后的个性张力与历史青春期的感伤律动。",
    "start": 842.83,
    "end": 848.08,
    "duration": 5.25
  },
  {
    "id": 198,
    "text": "最后总结各大文体的全面收获与向现实主义的收束，",
    "start": 848.16,
    "end": 852.56,
    "duration": 4.4
  },
  {
    "id": 199,
    "text": "具体表述到答题语句就是：小说、散文小品、",
    "start": 852.56,
    "end": 856.56,
    "duration": 4.0
  },
  {
    "id": 200,
    "text": "自由诗与现代话剧的全面丰收，并在十年后期逐步向现实主义深度汇聚，",
    "start": 856.56,
    "end": 862.96,
    "duration": 6.4
  },
  {
    "id": 201,
    "text": "全面验证并丰富了文学革命的理论图纸。",
    "start": 862.96,
    "end": 866.32,
    "duration": 3.36
  },
  {
    "id": 202,
    "text": "最后，在创作实践上，第一个十年的创作潮流展现出波澜壮阔的现代转型趋向。",
    "start": 866.32,
    "end": 872.72,
    "duration": 6.4
  },
  {
    "id": 203,
    "text": "文学革命不仅停留在宣言论争，更迅速转化为丰硕的艺术实绩。",
    "start": 872.96,
    "end": 878.64,
    "duration": 5.68
  },
  {
    "id": 204,
    "text": "创作潮流整体呈现出启蒙、感伤、个性化与多元方法四大趋向。",
    "start": 878.64,
    "end": 885.04,
    "duration": 6.4
  },
  {
    "id": 205,
    "text": "以鲁迅《狂人日记》与《阿Q正传》为标志，",
    "start": 885.04,
    "end": 888.32,
    "duration": 3.28
  },
  {
    "id": 206,
    "text": "新小说以极高的思想起点确立了现代反封建的批判力量。",
    "start": 888.32,
    "end": 892.88,
    "duration": 4.56
  },
  {
    "id": 207,
    "text": "郁达夫《沉沦》的大胆自叙传与郭沫若《女神》的自由奔涌，",
    "start": 893.12,
    "end": 897.68,
    "duration": 4.56
  },
  {
    "id": 208,
    "text": "展现了五四青年苏醒后的个性张力与历史青春期的感伤律动。",
    "start": 897.68,
    "end": 902.72,
    "duration": 5.04
  },
  {
    "id": 209,
    "text": "小说、散文小品、自由诗与现代话剧的全面丰收，",
    "start": 902.72,
    "end": 906.72,
    "duration": 4.0
  },
  {
    "id": 210,
    "text": "并在十年后期逐步向现实主义深度汇聚，",
    "start": 906.72,
    "end": 910.32,
    "duration": 3.6
  },
  {
    "id": 211,
    "text": "全面验证并丰富了文学革命的理论图纸。",
    "start": 910.32,
    "end": 913.2,
    "duration": 2.88
  },
  {
    "id": 212,
    "text": "（六）总结升华板块。",
    "start": 913.36,
    "end": 914.777,
    "duration": 1.417
  },
  {
    "id": 213,
    "text": "收口推演逻辑：总结全篇论述要点。",
    "start": 914.777,
    "end": 917.61,
    "duration": 2.833
  },
  {
    "id": 214,
    "text": "重申文学革命在语言工具与思想启蒙两端的划时代意义，",
    "start": 917.61,
    "end": 922.468,
    "duration": 4.858
  },
  {
    "id": 215,
    "text": "点题其作为百年现代文学母体与精神源头的崇高地位，",
    "start": 922.468,
    "end": 927.123,
    "duration": 4.655
  },
  {
    "id": 216,
    "text": "气魄宏大。",
    "start": 927.123,
    "end": 927.932,
    "duration": 0.809
  },
  {
    "id": 217,
    "text": "逐句咬合推导：具体表述到答题语句就是：综上所述，",
    "start": 927.932,
    "end": 932.183,
    "duration": 4.251
  },
  {
    "id": 218,
    "text": "五四文学革命是一场触及民族精神灵魂的伟大文艺复兴。",
    "start": 932.183,
    "end": 937.04,
    "duration": 4.857
  },
  {
    "id": 219,
    "text": "最后以一句话给出文学史巅峰定论，",
    "start": 937.184,
    "end": 940.544,
    "duration": 3.36
  },
  {
    "id": 220,
    "text": "具体表述到答题语句就是：它以语言工具的变革解放了思想的牢笼，",
    "start": 940.544,
    "end": 946.144,
    "duration": 5.6
  },
  {
    "id": 221,
    "text": "以“人的发现”重构了文学与人生的血肉关联，",
    "start": 946.144,
    "end": 949.904,
    "duration": 3.76
  },
  {
    "id": 222,
    "text": "是中国现代文学百年生生不息的最高精神源头。",
    "start": 949.904,
    "end": 954.144,
    "duration": 4.24
  },
  {
    "id": 223,
    "text": "综上所述，五四文学革命是一场触及民族精神灵魂的伟大文艺复兴。",
    "start": 954.144,
    "end": 959.584,
    "duration": 5.44
  },
  {
    "id": 224,
    "text": "它以语言工具的变革解放了思想的牢笼，",
    "start": 959.824,
    "end": 963.344,
    "duration": 3.52
  },
  {
    "id": 225,
    "text": "以“人的发现”重构了文学与人生的血肉关联，",
    "start": 963.344,
    "end": 967.184,
    "duration": 3.84
  },
  {
    "id": 226,
    "text": "是中国现代文学百年生生不息的最高精神源头。",
    "start": 967.184,
    "end": 971.184,
    "duration": 4.0
  }
]