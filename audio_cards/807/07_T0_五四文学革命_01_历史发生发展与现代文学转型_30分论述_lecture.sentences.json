[
  {
    "id": 1,
    "text": "试论五四文学革命的历史发生、理论建设与中国文学的现代转型。",
    "start": 0.16,
    "end": 5.76,
    "duration": 5.6
  },
  {
    "id": 2,
    "text": "五四文学革命是中国文学由古代形态跨入现代形态的伟大历史分水岭。",
    "start": 5.76,
    "end": 11.68,
    "duration": 5.92
  },
  {
    "id": 3,
    "text": "它以五四新文化运动的思想启蒙为根本引擎，",
    "start": 11.68,
    "end": 15.52,
    "duration": 3.84
  },
  {
    "id": 4,
    "text": "以白话文取代文言文为形式突破口，",
    "start": 15.52,
    "end": 18.64,
    "duration": 3.12
  },
  {
    "id": 5,
    "text": "以“人的文学”为精神内核，",
    "start": 18.64,
    "end": 21.2,
    "duration": 2.56
  },
  {
    "id": 6,
    "text": "全方位终结了数千年中国古典文学的统治地位。",
    "start": 21.2,
    "end": 25.12,
    "duration": 3.92
  },
  {
    "id": 7,
    "text": "在现代报刊媒介与觉醒知识分子群体的强力支撑下，",
    "start": 25.28,
    "end": 29.52,
    "duration": 4.24
  },
  {
    "id": 8,
    "text": "这场革命完成了文学观念、语言工具、",
    "start": 29.52,
    "end": 32.96,
    "duration": 3.44
  },
  {
    "id": 9,
    "text": "文体范式与主体精神的全面现代化重构，",
    "start": 32.96,
    "end": 36.88,
    "duration": 3.92
  },
  {
    "id": 10,
    "text": "为百年中国新文学铸造了深沉的启蒙思想基因。",
    "start": 36.88,
    "end": 41.44,
    "duration": 4.56
  },
  {
    "id": 11,
    "text": "其历史脉络与现代转型成就主要体现在以下四个核心维度：",
    "start": 41.68,
    "end": 47.44,
    "duration": 5.76
  },
  {
    "id": 12,
    "text": "第一，顺应近代历史变革潮流，",
    "start": 47.44,
    "end": 50.64,
    "duration": 3.2
  },
  {
    "id": 13,
    "text": "形成由温和发难到激进论辩的破旧斗争链条。",
    "start": 50.64,
    "end": 55.04,
    "duration": 4.4
  },
  {
    "id": 14,
    "text": "五四文学革命绝非偶发的历史孤例，而是晚清以来诗界、",
    "start": 55.04,
    "end": 60.32,
    "duration": 5.28
  },
  {
    "id": 15,
    "text": "文界与小说界革命的深层汇聚与必然质变。",
    "start": 60.56,
    "end": 64.4,
    "duration": 3.84
  },
  {
    "id": 16,
    "text": "辛亥革命推翻帝制与现代学堂的兴起，",
    "start": 64.4,
    "end": 67.52,
    "duration": 3.12
  },
  {
    "id": 17,
    "text": "催生出具有独立反思意志的现代知识分子群体。",
    "start": 67.76,
    "end": 72.0,
    "duration": 4.24
  },
  {
    "id": 18,
    "text": "以《新青年》为核心阵地，先驱者高举民主与科学两大旗帜：",
    "start": 72.0,
    "end": 77.28,
    "duration": 5.28
  },
  {
    "id": 19,
    "text": "胡适率先发表《文学改良刍议》，",
    "start": 77.28,
    "end": 80.48,
    "duration": 3.2
  },
  {
    "id": 20,
    "text": "从历史进化论出发提出“不用典、",
    "start": 80.48,
    "end": 83.2,
    "duration": 2.72
  },
  {
    "id": 21,
    "text": "不作无病之呻吟”等八事主张，以温和审慎之态揭开序幕；",
    "start": 83.2,
    "end": 88.16,
    "duration": 4.96
  },
  {
    "id": 22,
    "text": "陈独秀紧随其后发表《文学革命论》，",
    "start": 88.16,
    "end": 91.36,
    "duration": 3.2
  },
  {
    "id": 23,
    "text": "旗帜鲜明地打出“三大主义”的大旗，",
    "start": 91.6,
    "end": 95.04,
    "duration": 3.44
  },
  {
    "id": 24,
    "text": "将旧文学定性为专制政体与封建国民性的温床，",
    "start": 95.2,
    "end": 99.28,
    "duration": 4.08
  },
  {
    "id": 25,
    "text": "拉开了正面强攻的序幕。",
    "start": 99.36,
    "end": 101.68,
    "duration": 2.32
  },
  {
    "id": 26,
    "text": "面对林纾、学衡派与甲寅派等保守阵营的反扑，",
    "start": 101.68,
    "end": 105.52,
    "duration": 3.84
  },
  {
    "id": 27,
    "text": "先驱者在激烈论争中彻底击碎了“文以载道”与游戏消遣的旧秩序，",
    "start": 105.896,
    "end": 111.096,
    "duration": 5.2
  },
  {
    "id": 28,
    "text": "确立了白话新文学的历史合法性。",
    "start": 111.096,
    "end": 114.056,
    "duration": 2.96
  },
  {
    "id": 29,
    "text": "第二，确立“胡适立形式、周作人立内容”的双重架构，",
    "start": 114.056,
    "end": 117.896,
    "duration": 3.84
  },
  {
    "id": 30,
    "text": "奠定新文学的理论根基。",
    "start": 117.896,
    "end": 120.376,
    "duration": 2.48
  },
  {
    "id": 31,
    "text": "文学革命具有鲜明的“理论先行”特征，",
    "start": 120.376,
    "end": 123.576,
    "duration": 3.2
  },
  {
    "id": 32,
    "text": "胡适与周作人分别在形式媒介与思想灵魂两端完成了关键奠基。",
    "start": 123.576,
    "end": 129.016,
    "duration": 5.44
  },
  {
    "id": 33,
    "text": "胡适致力于语言工具的根本解放，",
    "start": 129.016,
    "end": 131.736,
    "duration": 2.72
  },
  {
    "id": 34,
    "text": "在《建设的文学革命论》中提出“国语的文学，",
    "start": 131.736,
    "end": 136.094,
    "duration": 4.358
  },
  {
    "id": 35,
    "text": "文学的国语”的宏大战略，",
    "start": 136.094,
    "end": 138.522,
    "duration": 2.428
  },
  {
    "id": 36,
    "text": "将白话文学语言改革升格为现代民族国家建构的文化基石；",
    "start": 138.522,
    "end": 143.783,
    "duration": 5.261
  },
  {
    "id": 37,
    "text": "周作人则在《人的文学》中确立了新文学的人道主义灵魂，",
    "start": 143.783,
    "end": 149.044,
    "duration": 5.261
  },
  {
    "id": 38,
    "text": "倡导以“个人主义的人间本位”重新发现人，",
    "start": 149.044,
    "end": 153.091,
    "duration": 4.047
  },
  {
    "id": 39,
    "text": "要求文学必须如实表现普通人的真实痛苦与灵肉一致的人性。",
    "start": 153.091,
    "end": 158.856,
    "duration": 5.765
  },
  {
    "id": 40,
    "text": "这种形式与内容的双重合璧，",
    "start": 158.856,
    "end": 161.736,
    "duration": 2.88
  },
  {
    "id": 41,
    "text": "使新文学彻底挣脱了封建经学的附庸地位，",
    "start": 161.736,
    "end": 165.576,
    "duration": 3.84
  },
  {
    "id": 42,
    "text": "确立了以人的解放为目的的独立现代审美本体。",
    "start": 165.576,
    "end": 170.136,
    "duration": 4.56
  },
  {
    "id": 43,
    "text": "第三，吸纳多元外国文艺思潮，",
    "start": 170.136,
    "end": 172.696,
    "duration": 2.56
  },
  {
    "id": 44,
    "text": "催生新文学社团蜂起与双峰对峙格局。",
    "start": 172.696,
    "end": 176.216,
    "duration": 3.52
  },
  {
    "id": 45,
    "text": "文学革命随后迅速由先驱的激进破坏转向大规模的社团自觉建设，",
    "start": 176.216,
    "end": 181.096,
    "duration": 4.88
  },
  {
    "id": 46,
    "text": "西方现代现实主义、",
    "start": 181.096,
    "end": 182.856,
    "duration": 1.76
  },
  {
    "id": 47,
    "text": "浪漫主义与象征主义等思潮被深度中国化吸收。",
    "start": 182.856,
    "end": 187.256,
    "duration": 4.4
  },
  {
    "id": 48,
    "text": "文学研究会与创造社的相继崛起，",
    "start": 187.256,
    "end": 189.574,
    "duration": 2.318
  },
  {
    "id": 49,
    "text": "标志着中国现代文学阵营的完全成熟：",
    "start": 189.574,
    "end": 193.105,
    "duration": 3.531
  },
  {
    "id": 50,
    "text": "文学研究会高扬“为人生而艺术”的现实主义大旗，",
    "start": 193.105,
    "end": 197.881,
    "duration": 4.776
  },
  {
    "id": 51,
    "text": "注重对社会病态与底层疾苦的写实剖析；",
    "start": 197.881,
    "end": 201.62,
    "duration": 3.739
  },
  {
    "id": 52,
    "text": "创造社则高扬“为艺术而艺术”的浪漫主义旗帜，",
    "start": 201.62,
    "end": 206.189,
    "duration": 4.569
  },
  {
    "id": 53,
    "text": "强调主观直抒胸臆、个性极致张扬与反抗旧世界的火山狂飙。",
    "start": 206.189,
    "end": 212.296,
    "duration": 6.107
  },
  {
    "id": 54,
    "text": "两大社团虽在审美追求上各有侧重，",
    "start": 212.296,
    "end": 215.496,
    "duration": 3.2
  },
  {
    "id": 55,
    "text": "却共同构成了相互砥砺的双峰对峙格局，",
    "start": 215.496,
    "end": 219.816,
    "duration": 4.32
  },
  {
    "id": 56,
    "text": "极大地充实了中国现代文学的生力军与体裁版图。",
    "start": 219.816,
    "end": 224.296,
    "duration": 4.48
  },
  {
    "id": 57,
    "text": "第四，转化丰硕艺术实绩，",
    "start": 224.296,
    "end": 227.496,
    "duration": 3.2
  },
  {
    "id": 58,
    "text": "开辟启蒙感伤与现代文体多元探索的创作潮流。",
    "start": 227.496,
    "end": 231.816,
    "duration": 4.32
  },
  {
    "id": 59,
    "text": "文学革命不仅停留在宣言论争层面，",
    "start": 232.056,
    "end": 235.016,
    "duration": 2.96
  },
  {
    "id": 60,
    "text": "更迅速在第一个十年内转化为波澜壮阔的艺术实绩，",
    "start": 235.016,
    "end": 239.691,
    "duration": 4.675
  },
  {
    "id": 61,
    "text": "呈现出启蒙、感伤、个性化与多元方法等鲜明特征。",
    "start": 239.691,
    "end": 244.483,
    "duration": 4.792
  },
  {
    "id": 62,
    "text": "以鲁迅《狂人日记》与《阿Q正传》为标志，",
    "start": 244.483,
    "end": 248.65,
    "duration": 4.167
  },
  {
    "id": 63,
    "text": "中国现代小说在起步之时便站在了现代哲学与国民性解剖的思想高地；",
    "start": 248.65,
    "end": 255.109,
    "duration": 6.459
  },
  {
    "id": 64,
    "text": "郁达夫《沉沦》的大胆自叙传坦陈与郭沫若《女神》的自由奔涌，",
    "start": 255.109,
    "end": 260.824,
    "duration": 5.715
  },
  {
    "id": 65,
    "text": "细腻度量了现代青年觉醒后的个性张力与历史青春期的感伤律动。",
    "start": 260.824,
    "end": 266.984,
    "duration": 6.16
  },
  {
    "id": 66,
    "text": "小说、散文小品、自由新诗与现代话剧的全面成熟，",
    "start": 266.984,
    "end": 271.624,
    "duration": 4.64
  },
  {
    "id": 67,
    "text": "雄辩地验证并丰富了文学革命的理论蓝图。",
    "start": 271.624,
    "end": 274.424,
    "duration": 2.8
  },
  {
    "id": 68,
    "text": "综上所述，",
    "start": 274.184,
    "end": 274.424,
    "duration": 0.24
  },
  {
    "id": 69,
    "text": "五四文学革命是一场触及中华民族精神灵魂的伟大文艺复兴。",
    "start": 274.184,
    "end": 274.424,
    "duration": 0.24
  },
  {
    "id": 70,
    "text": "它以语言工具的革命粉碎了思维的桎梏，",
    "start": 274.184,
    "end": 274.424,
    "duration": 0.24
  },
  {
    "id": 71,
    "text": "以“人的发现”重构了文学与人生的血肉纽带，",
    "start": 274.184,
    "end": 274.424,
    "duration": 0.24
  },
  {
    "id": 72,
    "text": "确立了中国现代文学百年来生生不息的最高精神源头。",
    "start": 274.184,
    "end": 274.424,
    "duration": 0.24
  }
]