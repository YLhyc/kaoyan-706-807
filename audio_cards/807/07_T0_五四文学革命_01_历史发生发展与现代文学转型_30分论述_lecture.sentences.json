[
  {
    "id": 1,
    "text": "本题是 807 专业课中关于五四文学革命发生发展与现代文学转型的最高核心母题，分值为 30 分。",
    "start": 0.1,
    "end": 9.568,
    "duration": 9.468
  },
  {
    "id": 2,
    "text": "考查的核心目的，是要求考生系统回答中国文学何以在五四时期完成由古代向现代的历史跃迁，证明其在发生动因，理论建设，社团格局与创作实绩上的全方位奠基贡献。",
    "start": 9.518,
    "end": 25.273,
    "duration": 15.755
  },
  {
    "id": 3,
    "text": "回答这道题绝不能仅停留在罗列白话文口号表面。",
    "start": 25.273,
    "end": 30.22,
    "duration": 4.947
  },
  {
    "id": 4,
    "text": "必须紧扣钱理群《三十年》第一章的核心学理脉络，从“历史发生动因与论争破旧”，“初期理论建设双翼（胡适立形周作人立容）”，“社团蜂起与双峰对峙（文研会与创造社）”以及“第一个十年创作潮流与实绩”四大递进维度展开深入剖析。",
    "start": 30.221,
    "end": 50.426,
    "duration": 20.205
  },
  {
    "id": 5,
    "text": "全篇确立四个核心论述维度，",
    "start": 50.426,
    "end": 53.369,
    "duration": 2.943
  },
  {
    "id": 6,
    "text": "第一是近代历史动因与破旧论争（晚清序幕，新青年，胡适改良，陈独秀革命，论争胜利）。",
    "start": 53.368,
    "end": 62.105,
    "duration": 8.737
  },
  {
    "id": 7,
    "text": "第二是初期理论建设双重奠基（胡适语言形式革命与周作人人的文学思想灵魂）。",
    "start": 62.105,
    "end": 69.319,
    "duration": 7.214
  },
  {
    "id": 8,
    "text": "第三是外国思潮吸纳与社团双峰对峙（文学研究会与创造社各领风骚）。",
    "start": 69.319,
    "end": 75.882,
    "duration": 6.563
  },
  {
    "id": 9,
    "text": "第四是第一个十年创作实绩与潮流趋向（鲁迅启蒙，郁达夫感伤，郭沫若狂飙）。",
    "start": 75.881,
    "end": 83.537,
    "duration": 7.656
  },
  {
    "id": 10,
    "text": "这四个维度遵循着由历史突破，到理论蓝图，到组织建设，再到创作实践的严密推演链条。",
    "start": 83.538,
    "end": 92.236,
    "duration": 8.698
  },
  {
    "id": 11,
    "text": "历史发生与破旧论争解决了新文学破土而出的时代动因与合法性；",
    "start": 92.235,
    "end": 98.225,
    "duration": 5.99
  },
  {
    "id": 12,
    "text": "理论建设双重奠基确立了新文学的形式工具与思想灵魂；",
    "start": 98.225,
    "end": 103.707,
    "duration": 5.482
  },
  {
    "id": 13,
    "text": "社团格局与思潮吸纳展示了新文学从个别先驱走向群体繁荣的建设之基；",
    "start": 103.707,
    "end": 111.064,
    "duration": 7.357
  },
  {
    "id": 14,
    "text": "创作潮流与实绩则以坚实的作品群落证明了现代文学转型的最终确立。",
    "start": 111.064,
    "end": 117.861,
    "duration": 6.797
  },
  {
    "id": 15,
    "text": "四者环环相扣，逻辑闭环浑然天成。",
    "start": 117.86,
    "end": 121.61,
    "duration": 3.75
  },
  {
    "id": 16,
    "text": "五四文学革命是中国文学由古代形态跨入现代形态的伟大历史分水岭。",
    "start": 121.61,
    "end": 128.264,
    "duration": 6.654
  },
  {
    "id": 17,
    "text": "它以五四新文化运动的思想启蒙为根本引擎，以白话文取代文言文为形式突破口，以“人的文学”为精神内核，全方位终结了数千年中国古典文学的统治地位。",
    "start": 128.264,
    "end": 142.001,
    "duration": 13.737
  },
  {
    "id": 18,
    "text": "在现代报刊媒介与觉醒知识分子群体的强力支撑下，这场革命完成了文学观念，语言工具，文体范式与主体精神的全面现代化重构，为百年中国新文学铸造了深沉的启蒙思想基因。",
    "start": 142.001,
    "end": 158.677,
    "duration": 16.676
  },
  {
    "id": 19,
    "text": "其历史脉络与现代转型成就主要体现在以下四个核心维度，",
    "start": 158.677,
    "end": 164.38,
    "duration": 5.703
  },
  {
    "id": 20,
    "text": "彻底免除公历年份，直接以古代走向现代的分水岭定性，交代动力，突破口与思想内核，引出四大维度。",
    "start": 164.38,
    "end": 173.898,
    "duration": 9.518
  },
  {
    "id": 21,
    "text": "第一，顺应近代历史变革潮流，形成由温和发难到激进论辩的破旧斗争链条。",
    "start": 173.898,
    "end": 181.671,
    "duration": 7.773
  },
  {
    "id": 22,
    "text": "加粗动宾立桩，调取晚清三界革命铺垫，《新青年》民主科学旗帜，胡适《文学改良刍议》八事主张，陈独秀《文学革命论》三大主义与击溃林纾学衡派论争，做实破旧实绩。",
    "start": 181.671,
    "end": 197.309,
    "duration": 15.638
  },
  {
    "id": 23,
    "text": "第二，确立“胡适立形式，周作人立内容”的双重架构，奠定新文学的理论根基。",
    "start": 197.309,
    "end": 204.184,
    "duration": 6.875
  },
  {
    "id": 24,
    "text": "加粗动宾立桩，解析胡适“国语的文学，文学的国语”形式革命，与周作人《人的文学》人道主义思想灵魂的双璧合力。",
    "start": 204.184,
    "end": 214.601,
    "duration": 10.417
  },
  {
    "id": 25,
    "text": "第三，吸纳多元外国文艺思潮，催生新文学社团蜂起与双峰对峙格局。",
    "start": 214.601,
    "end": 221.463,
    "duration": 6.862
  },
  {
    "id": 26,
    "text": "加粗动宾立桩，调取文学研究会（为人生而艺术，现实主义）与创造社（为艺术而艺术，浪漫主义自我表现）相互砥砺的格局。",
    "start": 221.463,
    "end": 232.739,
    "duration": 11.276
  },
  {
    "id": 27,
    "text": "第四，转化丰硕艺术实绩，开辟启蒙感伤与现代文体多元探索的创作潮流。",
    "start": 232.739,
    "end": 239.992,
    "duration": 7.253
  },
  {
    "id": 28,
    "text": "加粗动宾立桩，调取鲁迅《狂人日记》《阿Q正传》（哲学高度与国民性解剖），郁达夫《沉沦》（自叙传与感伤）与郭沫若《女神》（狂飙自由），坐实现代文学转型的丰硕实绩。",
    "start": 239.992,
    "end": 255.174,
    "duration": 15.182
  },
  {
    "id": 29,
    "text": "综上所述，五四文学革命是一场触及中华民族精神灵魂的伟大文艺复兴。",
    "start": 255.174,
    "end": 262.088,
    "duration": 6.914
  },
  {
    "id": 30,
    "text": "它以语言工具的革命粉碎了思维的桎梏，以“人的发现”重构了文学与人生的血肉纽带，确立了中国现代文学百年来生生不息的最高精神源头。",
    "start": 262.088,
    "end": 274.471,
    "duration": 12.383
  },
  {
    "id": 31,
    "text": "以语言革命与人的发现双翼收口，升华历史最高精神源头。",
    "start": 274.684,
    "end": 280.233,
    "duration": 5.549
  }
]