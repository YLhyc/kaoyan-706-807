[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "鲁迅·故事新编历史小说创新",
    "start": 0.154,
    "end": 2.486,
    "duration": 2.332
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "“古今杂糅油滑”破神圣→“庄严与荒诞并置”写悲凉→“打通三体”见晚期返璞归真，",
    "start": 3.186,
    "end": 12.158,
    "duration": 8.972
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "三步紧凑精准涵盖《理水》《奔月》《铸剑》《补天》《非攻》五篇核心例证。",
    "start": 12.386,
    "end": 18.318,
    "duration": 5.932
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "鲁迅晚期《故事新编》是历史小说文体试验划时代杰作，摒弃“据事直书”与政论套路，",
    "start": 18.819,
    "end": 25.871,
    "duration": 7.052
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "融合神话、现代心理与杂文笔法开创“新历史小说”。",
    "start": 26.099,
    "end": 30.431,
    "duration": 4.332
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · “古今杂糅”与戏谑“油滑”破历史光环",
    "start": 31.097,
    "end": 34.789,
    "duration": 3.692
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "依古代神话史料骨架打破时空界限，将现代口语、摩登细节与文人论战植入远古；",
    "start": 35.317,
    "end": 43.169,
    "duration": 7.852
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "文化山学者乘奇肱飞车考察大谈“古貌林”“O.K.”，与吃粗粮治水大禹滑稽对照，",
    "start": 43.632,
    "end": 51.884,
    "duration": 8.252
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "丑角式“油滑”成反讽现代病态知识分子之镜。",
    "start": 52.112,
    "end": 56.284,
    "duration": 4.172
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 庄严与荒诞并置、写先驱被消磨之悲",
    "start": 56.947,
    "end": 60.559,
    "duration": 3.612
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "故意将视点由创业高光移向功成后凡俗日常：《奔月》写后羿射尽野兽后每日吃乌鸦炸酱面的英雄末路；",
    "start": 61.086,
    "end": 71.098,
    "duration": 10.012
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《铸剑》黑衣人与眉间尺惨烈复仇，在王公宫女围观金鼎沸水猎奇中沦为娱乐景观，写尽先驱牺牲被麻木消费之悲。",
    "start": 71.626,
    "end": 83.078,
    "duration": 11.452
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 打通小说、神话与杂文界限的晚期境界",
    "start": 83.786,
    "end": 88.198,
    "duration": 4.412
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "融古代神话宏伟想象与现代杂文逻辑解剖为一炉：",
    "start": 88.726,
    "end": 94.018,
    "duration": 5.292
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "既有《补天》绚烂原始生命力，又有《非攻》墨子止战清醒务实，嬉笑怒骂间藏文明困境哲思，显晚期返璞归真功力。",
    "start": 94.535,
    "end": 106.307,
    "duration": 11.772
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《故事新编》以古今杂糅破格与消解神话深度拓展小说艺术边界，立现代历史小说探索美学高峰。",
    "start": 106.887,
    "end": 116.019,
    "duration": 9.132
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：《故事新编》共收八篇，重点记住《补天》《奔月》《理水》《铸剑》《非攻》；",
    "start": 116.504,
    "end": 123.156,
    "duration": 6.652
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "关键技法名“古今杂糅”与“油滑”。",
    "start": 123.434,
    "end": 126.006,
    "duration": 2.572
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出《故事新编》涉及“古今杂糅/油滑”“庄严/荒诞”“神话/务实”的五篇代表作？",
    "start": 126.714,
    "end": 134.486,
    "duration": 7.772
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《理水》《奔月》《铸剑》讲透“油滑”与“先驱牺牲被消磨”二层深意？",
    "start": 135.014,
    "end": 141.746,
    "duration": 6.732
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 这部晚期集子如何突破“据事直书”旧例开创“新历史小说”？",
    "start": 142.222,
    "end": 148.474,
    "duration": 6.252
  }
]