[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "“古今杂糅油滑”破神圣→“庄严与荒诞并置”写悲凉→“打通三体”见晚期返璞归真，",
    "start": 0.0,
    "end": 7.04,
    "duration": 7.04
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "三步紧凑精准涵盖《理水》《奔月》《铸剑》《补天》《非攻》五篇核心例证。",
    "start": 7.089,
    "end": 12.489,
    "duration": 5.4
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "鲁迅晚期《故事新编》是历史小说文体试验划时代杰作，",
    "start": 12.939,
    "end": 16.979,
    "duration": 4.04
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "摒弃“据事直书”与政论套路，",
    "start": 17.429,
    "end": 19.669,
    "duration": 2.24
  },
  {
    "id": "intro_c2",
    "dom_key": "intro_c2",
    "text": "融合神话、现代心理与杂文笔法开创“新历史小说”。",
    "start": 20.119,
    "end": 24.279,
    "duration": 4.16
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · “古今杂糅”与戏谑“油滑”破历史光环",
    "start": 24.729,
    "end": 28.369,
    "duration": 3.64
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "依古代神话史料骨架打破时空界限，",
    "start": 28.819,
    "end": 31.819,
    "duration": 3.0
  },
  {
    "id": "sec0_step0_c1",
    "dom_key": "sec0_step0_c1",
    "text": "将现代口语、摩登细节与文人论战植入远古；",
    "start": 32.269,
    "end": 36.029,
    "duration": 3.76
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "文化山学者乘奇肱飞车考察大谈“古貌林”“O.K.”，",
    "start": 36.479,
    "end": 40.279,
    "duration": 3.8
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "与吃粗粮治水大禹滑稽对照，丑角式“油滑”成反讽现代病态知识分子之镜。",
    "start": 40.729,
    "end": 46.769,
    "duration": 6.04
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 庄严与荒诞并置、写先驱被消磨之悲",
    "start": 47.219,
    "end": 51.539,
    "duration": 4.32
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "故意将视点由创业高光移向功成后凡俗日常：",
    "start": 52.069,
    "end": 55.789,
    "duration": 3.72
  },
  {
    "id": "sec1_step0_c1",
    "dom_key": "sec1_step0_c1",
    "text": "《奔月》写后羿射尽野兽后每日吃乌鸦炸酱面的英雄末路；",
    "start": 56.239,
    "end": 60.559,
    "duration": 4.32
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《铸剑》黑衣人与眉间尺惨烈复仇，",
    "start": 61.009,
    "end": 63.689,
    "duration": 2.68
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "在王公宫女围观金鼎沸水猎奇中沦为娱乐景观，",
    "start": 64.139,
    "end": 68.019,
    "duration": 3.88
  },
  {
    "id": "sec1_step1_c2",
    "dom_key": "sec1_step1_c2",
    "text": "写尽先驱牺牲被麻木消费之悲。",
    "start": 68.469,
    "end": 71.229,
    "duration": 2.76
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 打通小说、神话与杂文界限的晚期境界",
    "start": 71.679,
    "end": 75.839,
    "duration": 4.16
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "融古代神话宏伟想象与现代杂文逻辑解剖为一炉：",
    "start": 76.289,
    "end": 80.409,
    "duration": 4.12
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "既有《补天》绚烂原始生命力，又有《非攻》墨子止战清醒务实，",
    "start": 80.859,
    "end": 85.259,
    "duration": 4.4
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "嬉笑怒骂间藏文明困境哲思，显晚期返璞归真功力。",
    "start": 85.709,
    "end": 90.229,
    "duration": 4.52
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《故事新编》以古今杂糅破格与消解神话深度拓展小说艺术边界，",
    "start": 90.719,
    "end": 95.719,
    "duration": 5.0
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "立现代历史小说探索美学高峰。",
    "start": 96.249,
    "end": 98.889,
    "duration": 2.64
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：《故事新编》共收八篇，",
    "start": 99.339,
    "end": 101.659,
    "duration": 2.32
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "重点记住《补天》《奔月》《理水》《铸剑》《非攻》；",
    "start": 102.109,
    "end": 105.869,
    "duration": 3.76
  },
  {
    "id": "guard_c2",
    "dom_key": "guard_c2",
    "text": "关键技法名“古今杂糅”与“油滑”。",
    "start": 106.399,
    "end": 108.799,
    "duration": 2.4
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出《故事新编》涉及“古今杂糅/油滑”“庄严/荒诞”“神话/务实”的五篇代表作？",
    "start": 109.249,
    "end": 116.369,
    "duration": 7.12
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《理水》《奔月》《铸剑》讲透“油滑”与“先驱牺牲被消磨”二层深意？",
    "start": 116.819,
    "end": 123.379,
    "duration": 6.56
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 这部晚期集子如何突破“据事直书”旧例开创“新历史小说”？",
    "start": 123.829,
    "end": 129.669,
    "duration": 5.84
  }
]