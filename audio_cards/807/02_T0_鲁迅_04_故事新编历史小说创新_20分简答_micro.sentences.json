[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "鲁迅·故事新编历史小说创新",
    "start": 0.134,
    "end": 2.737,
    "duration": 2.603
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "“古今杂糅油滑”破神圣→“庄严与荒诞并置”写悲凉→“打通三体”见晚期返璞归真，",
    "start": 3.326,
    "end": 12.518,
    "duration": 9.192
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "三步紧凑精准涵盖《理水》《奔月》《铸剑》《补天》《非攻》五篇核心例证。",
    "start": 12.844,
    "end": 19.51,
    "duration": 6.666
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "鲁迅晚期《故事新编》是历史小说文体试验划时代杰作，摒弃“据事直书”与政论套路，",
    "start": 20.097,
    "end": 27.023,
    "duration": 6.926
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "融合神话、现代心理与杂文笔法开创“新历史小说”。",
    "start": 27.206,
    "end": 31.737,
    "duration": 4.53
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · “古今杂糅”与戏谑“油滑”破历史光环",
    "start": 32.324,
    "end": 36.19,
    "duration": 3.866
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "依古代神话史料骨架打破时空界限，将现代口语、摩登细节与文人论战植入远古；",
    "start": 36.777,
    "end": 45.018,
    "duration": 8.241
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "文化山学者乘奇肱飞车考察大谈“古貌林”“O.K.”，与吃粗粮治水大禹滑稽对照，",
    "start": 45.605,
    "end": 53.586,
    "duration": 7.981
  },
  {
    "id": "sec0_step1_c1",
    "dom_key": "sec0_step1_c1",
    "text": "丑角式“油滑”成反讽现代病态知识分子之镜。",
    "start": 53.873,
    "end": 57.856,
    "duration": 3.983
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 庄严与荒诞并置、写先驱被消磨之悲",
    "start": 58.43,
    "end": 62.817,
    "duration": 4.387
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "故意将视点由创业高光移向功成后凡俗日常：《奔月》写后羿射尽野兽后每日吃乌鸦炸酱面的英雄末路；",
    "start": 63.391,
    "end": 73.794,
    "duration": 10.403
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "《铸剑》黑衣人与眉间尺惨烈复仇，在王公宫女围观金鼎沸水猎奇中沦为娱乐景观，写尽先驱牺牲被麻木消费之悲。",
    "start": 74.368,
    "end": 85.955,
    "duration": 11.587
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 打通小说、神话与杂文界限的晚期境界",
    "start": 86.529,
    "end": 90.734,
    "duration": 4.205
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "融古代神话宏伟想象与现代杂文逻辑解剖为一炉：",
    "start": 91.308,
    "end": 96.75,
    "duration": 5.442
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "既有《补天》绚烂原始生命力，又有《非攻》墨子止战清醒务实，嬉笑怒骂间藏文明困境哲思，显晚期返璞归真功力。",
    "start": 97.311,
    "end": 107.674,
    "duration": 10.364
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "《故事新编》以古今杂糅破格与消解神话深度拓展小说艺术边界，立现代历史小说探索美学高峰。",
    "start": 108.248,
    "end": 116.945,
    "duration": 8.697
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：《故事新编》共收八篇，重点记住《补天》《奔月》《理水》《铸剑》《非攻》；",
    "start": 117.519,
    "end": 124.77,
    "duration": 7.252
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "关键技法名“古今杂糅”与“油滑”。",
    "start": 124.928,
    "end": 127.44,
    "duration": 2.512
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 写出《故事新编》涉及“古今杂糅/油滑”“庄严/荒诞”“神话/务实”的五篇代表作？",
    "start": 128.027,
    "end": 136.789,
    "duration": 8.762
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合《理水》《奔月》《铸剑》讲透“油滑”与“先驱牺牲被消磨”二层深意？",
    "start": 137.376,
    "end": 144.744,
    "duration": 7.369
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 这部晚期集子如何突破“据事直书”旧例开创“新历史小说”？",
    "start": 145.331,
    "end": 151.476,
    "duration": 6.145
  }
]