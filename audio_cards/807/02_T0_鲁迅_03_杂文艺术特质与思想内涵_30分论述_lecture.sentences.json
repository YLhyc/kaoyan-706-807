[
  {
    "id": 1,
    "text": "试论鲁迅杂文的艺术特质与思想内涵。",
    "start": 0.16,
    "end": 3.361,
    "duration": 3.201
  },
  {
    "id": 2,
    "text": "鲁迅杂文是中国现代散文史与批评史上独步文坛的文体奇观。",
    "start": 3.663,
    "end": 9.118,
    "duration": 5.455
  },
  {
    "id": 3,
    "text": "在现代报刊媒介的催生下，鲁迅将原本被视为边缘零碎的闲话杂感，",
    "start": 9.354,
    "end": 14.538,
    "duration": 5.184
  },
  {
    "id": 4,
    "text": "重构为直接介入现实社会搏斗的思想利刃。",
    "start": 14.664,
    "end": 18.193,
    "duration": 3.529
  },
  {
    "id": 5,
    "text": "它打破了传统文章义理、考据、辞章的狭隘分界，",
    "start": 18.337,
    "end": 22.343,
    "duration": 4.006
  },
  {
    "id": 6,
    "text": "将敏锐的社会批判、深刻的文明解剖、卓越的类型化创造与反规范的语言实验融为一体，",
    "start": 22.593,
    "end": 30.544,
    "duration": 7.951
  },
  {
    "id": 7,
    "text": "坚守现代“立人”理想，铸就了兼具战斗性与诗性美学的现代自由文体典范。",
    "start": 30.989,
    "end": 37.589,
    "duration": 6.6
  },
  {
    "id": 8,
    "text": "其艺术特质与思想内涵主要体现在以下四个核心维度：",
    "start": 37.881,
    "end": 42.462,
    "duration": 4.581
  },
  {
    "id": 9,
    "text": "第一，确立“无体的自由文体”，开创以现代报刊为媒介即时介入现实的斗争范式。",
    "start": 43.118,
    "end": 49.757,
    "duration": 6.639
  },
  {
    "id": 10,
    "text": "鲁迅杂文依托《新青年》《语丝》及《申报·自由谈》等现代报刊而生，",
    "start": 50.104,
    "end": 55.001,
    "duration": 4.897
  },
  {
    "id": 11,
    "text": "天然具备迅速回应时代脉搏与社会思潮的敏锐性。",
    "start": 55.366,
    "end": 59.201,
    "duration": 3.835
  },
  {
    "id": 12,
    "text": "鲁迅倡导文体解放以至无体即有体，摆脱了传统散文、史传与论说的僵化程式，",
    "start": 59.717,
    "end": 66.397,
    "duration": 6.68
  },
  {
    "id": 13,
    "text": "根据论辩需求与主体心境随物赋形，",
    "start": 66.555,
    "end": 69.928,
    "duration": 3.373
  },
  {
    "id": 14,
    "text": "自由穿梭于严密逻辑论证、生活场景叙事、主观激情抒发与深厚历史考据之间。",
    "start": 70.058,
    "end": 76.585,
    "duration": 6.527
  },
  {
    "id": 15,
    "text": "从早期的《热风》到后期的《准风月谈》，这一文体演变为一部现代中国活的“人史”，",
    "start": 76.706,
    "end": 83.126,
    "duration": 6.42
  },
  {
    "id": 16,
    "text": "构成了对半殖民地半封建社会中国人精神图谱最微观的文学记录。",
    "start": 83.395,
    "end": 88.657,
    "duration": 5.262
  },
  {
    "id": 17,
    "text": "第二，坚持决不妥协的批判否定性与“正面文章反面看”的反常规多疑思维。",
    "start": 89.274,
    "end": 95.513,
    "duration": 6.239
  },
  {
    "id": 18,
    "text": "鲁迅杂文的批判锋芒从不停留在政治权力的表层对抗，而是以现代启蒙“立人”为精神轴心，",
    "start": 95.98,
    "end": 103.111,
    "duration": 7.131
  },
  {
    "id": 19,
    "text": "对一切压抑生命自由的宗法旧礼教、等级专制与奴性人格展开毫不含糊的精神解剖。",
    "start": 103.475,
    "end": 110.147,
    "duration": 6.672
  },
  {
    "id": 20,
    "text": "面对错综复杂的社会现象，鲁迅创立了独具一格的“正面文章反面看”的多疑认知方法：",
    "start": 110.399,
    "end": 117.379,
    "duration": 6.98
  },
  {
    "id": 21,
    "text": "在《论“他妈的”》中，他从小民的日常国骂抽丝剥茧，",
    "start": 118.015,
    "end": 122.053,
    "duration": 4.038
  },
  {
    "id": 22,
    "text": "直击背后门第等级观念与血统压迫的荒谬；",
    "start": 122.593,
    "end": 126.081,
    "duration": 3.488
  },
  {
    "id": 23,
    "text": "在《小杂感》与《魏晋风度及文章与药及酒之关系》中，他以逆向思维刺破正人君子与名士风流的伪善外壳。",
    "start": 126.602,
    "end": 135.393,
    "duration": 8.791
  },
  {
    "id": 24,
    "text": "这种直击事物骨髓的冷峻解剖，展现了深刻的认识论力量。",
    "start": 135.793,
    "end": 140.046,
    "duration": 4.253
  },
  {
    "id": 25,
    "text": "第三，践行“由个入类”的文学典型化，创造具有普遍概括力的社会类型共名。",
    "start": 140.698,
    "end": 147.446,
    "duration": 6.748
  },
  {
    "id": 26,
    "text": "鲁迅杂文的现实介入从不流于就事论事的短浅时评，",
    "start": 147.961,
    "end": 152.249,
    "duration": 4.288
  },
  {
    "id": 27,
    "text": "而是善于抓住日常生活中的某一具体个案、甚至“一鼻、一嘴、一毛”的细微病态姿态作为起点，",
    "start": 152.582,
    "end": 160.368,
    "duration": 7.786
  },
  {
    "id": 28,
    "text": "将其置于几千年的文明历史长河中持续勘探，提炼出超越具体人事的普遍社会人格符号。",
    "start": 160.616,
    "end": 168.03,
    "duration": 7.414
  },
  {
    "id": 29,
    "text": "他在《论“费厄泼赖”应该缓行》中由落水狗的论争概括出依附豪强、反咬弱者的“叭儿狗”典型；",
    "start": 168.572,
    "end": 176.376,
    "duration": 7.804
  },
  {
    "id": 30,
    "text": "在论战中创造了假充中立、实为帮凶的“二丑”与诱骗民众走向屠场的“带头羊”。",
    "start": 176.866,
    "end": 183.259,
    "duration": 6.393
  },
  {
    "id": 31,
    "text": "这些艺术共名使具体杂感超越了论争时效，获得了穿越历史的长久生命力。",
    "start": 183.491,
    "end": 190.105,
    "duration": 6.614
  },
  {
    "id": 32,
    "text": "第四，蕴含深沉悲怆的主观诗性，开创反规范拗体与庄谐杂糅的反讽语言。",
    "start": 190.739,
    "end": 197.115,
    "duration": 6.376
  },
  {
    "id": 33,
    "text": "鲁迅杂文从不是冷漠的客观政论，外部社会危机一旦进入其笔端，",
    "start": 197.624,
    "end": 202.295,
    "duration": 4.671
  },
  {
    "id": 34,
    "text": "立刻经过其炽热痛苦的生命体验过滤，转化为内心严峻的心灵搏斗。",
    "start": 202.432,
    "end": 207.899,
    "duration": 5.467
  },
  {
    "id": 35,
    "text": "在《记念刘和珍君》中，沉痛的祭奠在“沉默与爆发”、“写与不写”的剧烈张力中起伏回荡，",
    "start": 208.158,
    "end": 215.348,
    "duration": 7.19
  },
  {
    "id": 36,
    "text": "展现出交响乐般沉郁顿挫的诗性力量。",
    "start": 215.814,
    "end": 218.918,
    "duration": 3.104
  },
  {
    "id": 37,
    "text": "在语言创造上，鲁迅故意打破常规词语搭配习惯，",
    "start": 219.608,
    "end": 223.697,
    "duration": 4.089
  },
  {
    "id": 38,
    "text": "创造出“有理的压迫”以及被称为“跪着的造反”等充满张力的反规范拗体，",
    "start": 224.05,
    "end": 229.616,
    "duration": 5.566
  },
  {
    "id": 39,
    "text": "以刺耳不谐的语词逼迫读者直面真实；",
    "start": 230.006,
    "end": 233.239,
    "duration": 3.233
  },
  {
    "id": 40,
    "text": "同时娴熟运用古雅典故与市井俗语的庄谐杂糅，",
    "start": 233.563,
    "end": 237.892,
    "duration": 4.329
  },
  {
    "id": 41,
    "text": "以大词小用与庄词谐用形成了锋芒锐利的荒诞反讽风格。",
    "start": 238.401,
    "end": 243.492,
    "duration": 5.091
  },
  {
    "id": 42,
    "text": "合而观之，鲁迅杂文将战斗的社会功能与崇高的文学品格融为一体。",
    "start": 244.115,
    "end": 249.857,
    "duration": 5.742
  },
  {
    "id": 43,
    "text": "他以现代散文的自由形式，开拓了中国现代文学批判现实主义与主观抒情相统一的全新疆界，树立了难以企及的艺术典范。",
    "start": 250.291,
    "end": 259.998,
    "duration": 9.707
  }
]