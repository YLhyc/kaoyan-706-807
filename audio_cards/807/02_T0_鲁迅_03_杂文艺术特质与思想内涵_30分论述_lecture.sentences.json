[
  {
    "id": 1,
    "text": "本题是 2025 年西华师大 807 的真题大论述，分值为 30 分。",
    "start": 0.1,
    "end": 6.014,
    "duration": 5.914
  },
  {
    "id": 2,
    "text": "考查的核心目的，是要求考生系统论述鲁迅杂文作为独立现代文学体裁的合法性与独创性，回答其如何将时评随笔提升为兼具思想战斗深度与高超艺术形式的世界级经典文体。",
    "start": 5.964,
    "end": 21.781,
    "duration": 15.817
  },
  {
    "id": 3,
    "text": "回答这道题绝不能将其答成普通的时政议论文或道德说教。",
    "start": 21.78,
    "end": 27.288,
    "duration": 5.508
  },
  {
    "id": 4,
    "text": "必须遵循钱理群《三十年》的核心学理脉络，从“媒介与文体形态（无体自由）”，“思想动力与思维方式（立人与反面看）”，“艺术典型化（由个入类）”以及“诗性抒情与语言实验（拗体反讽）”四大递进维度展开深入剖析。",
    "start": 27.288,
    "end": 45.201,
    "duration": 17.913
  },
  {
    "id": 5,
    "text": "全篇确立四个核心论述维度，",
    "start": 45.201,
    "end": 48.144,
    "duration": 2.943
  },
  {
    "id": 6,
    "text": "第一是现代报刊媒介与“无体的自由文体”（即时介入与随物赋形）。",
    "start": 48.143,
    "end": 54.002,
    "duration": 5.859
  },
  {
    "id": 7,
    "text": "第二是彻底的批判否定性与反常规思维（立人理想与“正面文章反面看”）。",
    "start": 54.003,
    "end": 60.513,
    "duration": 6.51
  },
  {
    "id": 8,
    "text": "第三是文学典型化与社会类型共名（由个入类，叭儿狗，二丑与带头羊）。",
    "start": 60.513,
    "end": 67.492,
    "duration": 6.979
  },
  {
    "id": 9,
    "text": "第四是主观悲怆诗性与反规范语言（记念刘和珍君的诗意与拗体反讽）。",
    "start": 67.492,
    "end": 74.25,
    "duration": 6.758
  },
  {
    "id": 10,
    "text": "这四个维度遵循着由外部生存媒介，到内在思想灵魂，到艺术典型法则，再到语言本体形式的严密推演链条。",
    "start": 74.25,
    "end": 84.367,
    "duration": 10.117
  },
  {
    "id": 11,
    "text": "现代媒介与无体自由解决了杂文的存在形态与介入功能；",
    "start": 84.367,
    "end": 89.693,
    "duration": 5.326
  },
  {
    "id": 12,
    "text": "批判否定性与反常规思维揭示了杂文穿透伪善的核心思想武器；",
    "start": 89.693,
    "end": 96.021,
    "duration": 6.328
  },
  {
    "id": 13,
    "text": "由个入类的类型共名展示了杂文如何突破时效性限制上升为文学典型；",
    "start": 96.021,
    "end": 103.039,
    "duration": 7.018
  },
  {
    "id": 14,
    "text": "主观诗性与反规范语言则落脚在杂文特有的美学格调与修辞破格上。",
    "start": 103.039,
    "end": 109.523,
    "duration": 6.484
  },
  {
    "id": 15,
    "text": "四者步步深入，将鲁迅杂文的文学特质论证得极为透彻。",
    "start": 109.523,
    "end": 114.94,
    "duration": 5.417
  },
  {
    "id": 16,
    "text": "鲁迅杂文是中国现代散文史与批评史上独步文坛的文体奇观。",
    "start": 114.94,
    "end": 120.93,
    "duration": 5.99
  },
  {
    "id": 17,
    "text": "在现代报刊媒介的催生下，鲁迅将原本被视为边缘零碎的闲话杂感，创造性地重构为直接介入现实社会搏斗的思想利刃。",
    "start": 120.93,
    "end": 131.724,
    "duration": 10.794
  },
  {
    "id": 18,
    "text": "它彻底打破了传统文章义理，考据，辞章的狭隘分界，将敏锐的社会批判，深邃的文明解剖，卓越的类型化创造与反规范的语言实验熔于一炉，以彻底的否定性坚守现代“立人”理想，铸就了兼具战斗性与诗性美学的现代自由文体巅峰。",
    "start": 131.724,
    "end": 152.696,
    "duration": 20.972
  },
  {
    "id": 19,
    "text": "其艺术特质与思想内涵主要体现在以下四个核心维度，",
    "start": 152.696,
    "end": 157.93,
    "duration": 5.234
  },
  {
    "id": 20,
    "text": "直接切入现代报刊媒介催生与思想利刃定性，打破传统文章疆界，统领四大论证支柱。",
    "start": 157.931,
    "end": 166.447,
    "duration": 8.516
  },
  {
    "id": 21,
    "text": "第一，确立“无体的自由文体”，开创以现代报刊为媒介即时介入现实的斗争范式。",
    "start": 166.446,
    "end": 173.881,
    "duration": 7.435
  },
  {
    "id": 22,
    "text": "加粗动宾立桩，解析《语丝》《申报·自由谈》等现代报刊媒介生态，阐述“随物赋形”与现代中国活的“人史”价值。",
    "start": 173.881,
    "end": 184.233,
    "duration": 10.352
  },
  {
    "id": 23,
    "text": "第二，坚持彻底的批判否定性与“正面文章反面看”的反常规多疑思维。",
    "start": 184.233,
    "end": 190.613,
    "duration": 6.38
  },
  {
    "id": 24,
    "text": "加粗动宾立桩，调取《论“他妈的”》解剖门第等级与《魏晋风度》反常规思维，坐实以“立人”为灵魂的认知锋芒。",
    "start": 190.613,
    "end": 200.496,
    "duration": 9.883
  },
  {
    "id": 25,
    "text": "第三，践行“由个入类”的文学典型化，创造具有普遍概括力的社会类型共名。",
    "start": 200.496,
    "end": 207.397,
    "duration": 6.901
  },
  {
    "id": 26,
    "text": "加粗动宾立桩，调取《论“费厄泼赖”应该缓行》中的“叭儿狗”，以及“二丑”，“带头羊”共名，揭示超越时效性的典型化力量。",
    "start": 207.397,
    "end": 217.475,
    "duration": 10.078
  },
  {
    "id": 27,
    "text": "第四，熔铸深沉悲怆的主观诗性，开创反规范拗体与庄谐杂糅的反讽语言。",
    "start": 217.475,
    "end": 224.728,
    "duration": 7.253
  },
  {
    "id": 28,
    "text": "加粗动宾立桩，调取《记念刘和珍君》的心灵搏斗与诗性节奏，以及“有理的压迫”，“跪着的造反”拗体悖论修辞，展示语言破格的审美张力。",
    "start": 224.728,
    "end": 236.564,
    "duration": 11.836
  },
  {
    "id": 29,
    "text": "综上所述，鲁迅杂文实现了战斗社会功能与崇高文学品格的完美交融。",
    "start": 236.564,
    "end": 243.153,
    "duration": 6.589
  },
  {
    "id": 30,
    "text": "他以现代散文的自由形式，开拓了中国现代文学批判现实主义与主观抒情相统一的全新疆界，立下了一座不可逾越的艺术丰碑。",
    "start": 243.152,
    "end": 254.688,
    "duration": 11.536
  },
  {
    "id": 31,
    "text": "总结提升，升华杂文作为战斗性与文学品格高度统一的经典地位。",
    "start": 254.689,
    "end": 260.939,
    "duration": 6.25
  }
]