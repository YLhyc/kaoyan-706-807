[
  {
    "id": 1,
    "text": "一、全题宏观破题与总揽。",
    "start": 0.08,
    "end": 3.12,
    "duration": 3.04
  },
  {
    "id": 2,
    "text": "一、这一问到底在考什么？",
    "start": 3.12,
    "end": 5.68,
    "duration": 2.56
  },
  {
    "id": 3,
    "text": "本题考查的是鲁迅杂文的艺术特质与思想内涵。",
    "start": 5.68,
    "end": 9.84,
    "duration": 4.16
  },
  {
    "id": 4,
    "text": "考生必须准确把握鲁迅将随笔杂感改造为独立文学体裁的划时代贡献，",
    "start": 9.84,
    "end": 16.24,
    "duration": 6.4
  },
  {
    "id": 5,
    "text": "透视其文体机制、思想动力、思维模式、",
    "start": 16.24,
    "end": 20.0,
    "duration": 3.76
  },
  {
    "id": 6,
    "text": "抒情特质与语言创造。",
    "start": 20.0,
    "end": 21.84,
    "duration": 1.84
  },
  {
    "id": 7,
    "text": "二、答题的总方向是什么？",
    "start": 22.16,
    "end": 24.56,
    "duration": 2.4
  },
  {
    "id": 8,
    "text": "绝不能把杂文降格为普通的政论议论文或骂人文字。",
    "start": 24.56,
    "end": 28.96,
    "duration": 4.4
  },
  {
    "id": 9,
    "text": "答题必须牢牢立足钱理群《中国现代文学三十年》的学术基底。",
    "start": 28.96,
    "end": 34.0,
    "duration": 5.04
  },
  {
    "id": 10,
    "text": "将杂文作为一种兼具思想战斗性与高超审美创造性的现代文体进行立体剖析。",
    "start": 34.0,
    "end": 40.64,
    "duration": 6.64
  },
  {
    "id": 11,
    "text": "三、分几个板块展开？",
    "start": 40.64,
    "end": 42.32,
    "duration": 1.68
  },
  {
    "id": 12,
    "text": "全篇严格按照五大有机维度展开：-第一板块：媒介特质与文体自由（现代报刊催生、",
    "start": 42.72,
    "end": 49.76,
    "duration": 7.04
  },
  {
    "id": 13,
    "text": "无体自由、现代中国活的人史）。",
    "start": 49.76,
    "end": 52.4,
    "duration": 2.64
  },
  {
    "id": 14,
    "text": "第二板块：思想动力与思维方式（批判否定性、",
    "start": 52.4,
    "end": 56.64,
    "duration": 4.24
  },
  {
    "id": 15,
    "text": "立人理想、正面文章反面看）。",
    "start": 56.64,
    "end": 59.04,
    "duration": 2.4
  },
  {
    "id": 16,
    "text": "第三板块：艺术思维与典型创造（由个到类、",
    "start": 59.04,
    "end": 62.96,
    "duration": 3.92
  },
  {
    "id": 17,
    "text": "提炼社会类型共名、叭儿狗与二丑）。",
    "start": 62.96,
    "end": 65.36,
    "duration": 2.4
  },
  {
    "id": 18,
    "text": "第四板块：审美格调与主观过滤（人事主观化、",
    "start": 65.6,
    "end": 69.44,
    "duration": 3.84
  },
  {
    "id": 19,
    "text": "内心严峻冲突、记念刘和珍君的深沉诗性）。",
    "start": 69.44,
    "end": 72.88,
    "duration": 3.44
  },
  {
    "id": 20,
    "text": "第五板块：语言张力与文体破格（反规范拗体、",
    "start": 72.88,
    "end": 77.12,
    "duration": 4.24
  },
  {
    "id": 21,
    "text": "矛盾悖论搭配、庄谐杂糅的反讽力量）。",
    "start": 77.12,
    "end": 80.08,
    "duration": 2.96
  },
  {
    "id": 22,
    "text": "四、全篇内在逻辑链条是什么？",
    "start": 80.08,
    "end": 82.64,
    "duration": 2.56
  },
  {
    "id": 23,
    "text": "由文体的发生环境与外在自由形态切入（形式之器）趋近于深入其核心思想动力与穿透表象的认知思维（思想之刃）趋近于提炼其将具体现象升华为文学典型的方法论（艺术之轴）趋近于揭示其将社会现实转化为心灵搏斗的深层美学品格（精神之魂）趋近于落在承载这一切反叛力量的语言形式变革上（语言之骨）。",
    "start": 82.64,
    "end": 108.0,
    "duration": 25.36
  },
  {
    "id": 24,
    "text": "层层递进，浑然一体。",
    "start": 108.16,
    "end": 110.24,
    "duration": 2.08
  },
  {
    "id": 25,
    "text": "--。二",
    "start": 110.24,
    "end": 110.4,
    "duration": 0.16
  },
  {
    "id": 26,
    "text": "、各板块逐句咬合推演。",
    "start": 110.72,
    "end": 113.12,
    "duration": 2.4
  },
  {
    "id": 27,
    "text": "（一）宏观定性与破题总起板块。",
    "start": 113.12,
    "end": 116.32,
    "duration": 3.2
  },
  {
    "id": 28,
    "text": "破题推演逻辑：开头必须先声夺人。",
    "start": 116.32,
    "end": 119.6,
    "duration": 3.28
  },
  {
    "id": 29,
    "text": "首先准确界定鲁迅杂文在现代文学史上的划时代地位，",
    "start": 119.6,
    "end": 124.0,
    "duration": 4.4
  },
  {
    "id": 30,
    "text": "指出其依托现代报刊媒介的诞生环境。",
    "start": 124.0,
    "end": 126.88,
    "duration": 2.88
  },
  {
    "id": 31,
    "text": "接着概括其将思想性与艺术性熔铸于一炉的文体特征，",
    "start": 127.2,
    "end": 132.0,
    "duration": 4.8
  },
  {
    "id": 32,
    "text": "最后点出批判否定性与文学范式建构，",
    "start": 132.0,
    "end": 135.36,
    "duration": 3.36
  },
  {
    "id": 33,
    "text": "顺畅引出下文分述。",
    "start": 135.36,
    "end": 137.04,
    "duration": 1.68
  },
  {
    "id": 34,
    "text": "逐句咬合推导：具体表述到答题语句就是：鲁迅杂文是中国现代文学史上极具独创性的现代文体。，",
    "start": 137.04,
    "end": 145.757,
    "duration": 8.717
  },
  {
    "id": 35,
    "text": "这是对考察对象的历史高度定性。",
    "start": 145.757,
    "end": 148.757,
    "duration": 3.0
  },
  {
    "id": 36,
    "text": "紧接着交代文体诞生的媒介环境与功能转变，",
    "start": 148.757,
    "end": 152.828,
    "duration": 4.071
  },
  {
    "id": 37,
    "text": "具体表述到答题语句就是：在现代报刊媒介的催生下，",
    "start": 152.828,
    "end": 157.542,
    "duration": 4.714
  },
  {
    "id": 38,
    "text": "鲁迅将原本边缘化的杂感随笔改造为敏锐介入现实的思想武器。。",
    "start": 157.542,
    "end": 163.328,
    "duration": 5.786
  },
  {
    "id": 39,
    "text": "随后指出其文体突破传统束缚的宏阔气度，",
    "start": 163.488,
    "end": 167.248,
    "duration": 3.76
  },
  {
    "id": 40,
    "text": "具体表述到答题语句就是：鲁迅杂文彻底打破了传统文章的狭隘疆界。。",
    "start": 167.248,
    "end": 173.03,
    "duration": 5.782
  },
  {
    "id": 41,
    "text": "紧接着用四个并列短语精准概括其思想与艺术要素，",
    "start": 173.03,
    "end": 177.385,
    "duration": 4.355
  },
  {
    "id": 42,
    "text": "具体表述到答题语句就是：它将敏锐的社会批判、",
    "start": 177.385,
    "end": 181.344,
    "duration": 3.959
  },
  {
    "id": 43,
    "text": "深邃的文明反思、独特的类型概括与高超的文学修辞熔铸于一炉。。",
    "start": 181.344,
    "end": 186.688,
    "duration": 5.344
  },
  {
    "id": 44,
    "text": "最后落到核心精神与文体价值的收口，",
    "start": 186.768,
    "end": 190.128,
    "duration": 3.36
  },
  {
    "id": 45,
    "text": "具体表述到答题语句就是：它以彻底的批判否定性践行了“立人”的启蒙理想，",
    "start": 190.128,
    "end": 197.328,
    "duration": 7.2
  },
  {
    "id": 46,
    "text": "同时凭借反常规的思维张力与反规范的语言革新，",
    "start": 197.328,
    "end": 201.888,
    "duration": 4.56
  },
  {
    "id": 47,
    "text": "建构起具有深厚诗性力量的现代文体范式。。",
    "start": 201.888,
    "end": 205.808,
    "duration": 3.92
  },
  {
    "id": 48,
    "text": "鲁迅杂文是中国现代文学史上极具独创性的现代文体。",
    "start": 205.808,
    "end": 210.048,
    "duration": 4.24
  },
  {
    "id": 49,
    "text": "在现代报刊媒介的催生下，鲁迅将原本边缘化的杂感随笔改造为敏锐介入现实的思想武器。",
    "start": 210.368,
    "end": 217.808,
    "duration": 7.44
  },
  {
    "id": 50,
    "text": "鲁迅杂文彻底打破了传统文章的狭隘疆界。",
    "start": 217.808,
    "end": 221.328,
    "duration": 3.52
  },
  {
    "id": 51,
    "text": "它将敏锐的社会批判、深邃的文明反思、",
    "start": 221.328,
    "end": 224.688,
    "duration": 3.36
  },
  {
    "id": 52,
    "text": "独特的类型概括与高超的文学修辞熔铸于一炉。",
    "start": 224.688,
    "end": 229.168,
    "duration": 4.48
  },
  {
    "id": 53,
    "text": "它以彻底的批判否定性践行了“立人”的启蒙理想，",
    "start": 229.168,
    "end": 233.568,
    "duration": 4.4
  },
  {
    "id": 54,
    "text": "同时凭借反常规的思维张力与反规范的语言革新，",
    "start": 233.568,
    "end": 237.728,
    "duration": 4.16
  },
  {
    "id": 55,
    "text": "建构起具有深厚诗性力量的现代文体范式。",
    "start": 237.728,
    "end": 241.088,
    "duration": 3.36
  },
  {
    "id": 56,
    "text": "---。（二",
    "start": 241.248,
    "end": 241.452,
    "duration": 0.204
  },
  {
    "id": 57,
    "text": "）第一板块：媒介特质与文体自由。",
    "start": 241.452,
    "end": 244.11,
    "duration": 2.658
  },
  {
    "id": 58,
    "text": "论证推演逻辑：杂文首先是媒介时代的产物。",
    "start": 244.11,
    "end": 247.79,
    "duration": 3.68
  },
  {
    "id": 59,
    "text": "必须先交代其依托现代报刊的传播机制，",
    "start": 247.79,
    "end": 251.266,
    "duration": 3.476
  },
  {
    "id": 60,
    "text": "从而带来即时介入现实的敏锐性。",
    "start": 251.266,
    "end": 254.128,
    "duration": 2.862
  },
  {
    "id": 61,
    "text": "接着引入钱理群核心概念“无体的自由文体”，",
    "start": 254.128,
    "end": 257.808,
    "duration": 3.68
  },
  {
    "id": 62,
    "text": "阐明它打破体式边界、随物赋形的文学自由。",
    "start": 257.808,
    "end": 261.488,
    "duration": 3.68
  },
  {
    "id": 63,
    "text": "最后升华到这一文体记录现代中国人心理结构的“人史”价值。",
    "start": 261.568,
    "end": 266.608,
    "duration": 5.04
  },
  {
    "id": 64,
    "text": "逐句咬合推导：具体表述到答题语句就是：首先，",
    "start": 266.608,
    "end": 270.928,
    "duration": 4.32
  },
  {
    "id": 65,
    "text": "鲁迅确立了杂文作为“无体的自由文体”的现代媒介特质与现实介入功能。，",
    "start": 270.928,
    "end": 276.848,
    "duration": 5.92
  },
  {
    "id": 66,
    "text": "这是第一分论点的核心观点立桩。",
    "start": 276.848,
    "end": 279.168,
    "duration": 2.32
  },
  {
    "id": 67,
    "text": "紧接着指出文体的历史生存土壤，具体表述到答题语句就是：鲁迅杂文依托现代报刊副刊的发展而兴起。。",
    "start": 279.464,
    "end": 288.145,
    "duration": 8.681
  },
  {
    "id": 68,
    "text": "随后阐明报刊机制赋予文体的即时反应速度，",
    "start": 288.145,
    "end": 291.865,
    "duration": 3.72
  },
  {
    "id": 69,
    "text": "具体表述到答题语句就是：它天然具有迅速回应时代震荡、",
    "start": 291.865,
    "end": 296.563,
    "duration": 4.698
  },
  {
    "id": 70,
    "text": "直接介入现实论争的即时性特征。。",
    "start": 296.563,
    "end": 299.304,
    "duration": 2.741
  },
  {
    "id": 71,
    "text": "紧接着从文体规范层面解释其自由度，",
    "start": 299.384,
    "end": 303.064,
    "duration": 3.68
  },
  {
    "id": 72,
    "text": "具体表述到答题语句就是：鲁迅摆脱了传统诗歌、",
    "start": 303.064,
    "end": 307.673,
    "duration": 4.609
  },
  {
    "id": 73,
    "text": "戏剧与小说的僵化形式拘束。。",
    "start": 307.673,
    "end": 310.479,
    "duration": 2.806
  },
  {
    "id": 74,
    "text": "随后说明其随物赋形的调动能力，具体表述到答题语句就是：他在创作中根据现实论争与主体情绪的需要随物赋形。。",
    "start": 310.479,
    "end": 321.704,
    "duration": 11.225
  },
  {
    "id": 75,
    "text": "进一步列举其综合熔铸的文体要素，",
    "start": 321.784,
    "end": 324.504,
    "duration": 2.72
  },
  {
    "id": 76,
    "text": "具体表述到答题语句就是：他在随笔中自由调度逻辑议论、",
    "start": 324.504,
    "end": 329.321,
    "duration": 4.817
  },
  {
    "id": 77,
    "text": "生活叙事、主观抒情与历史联想。。",
    "start": 329.321,
    "end": 331.908,
    "duration": 2.587
  },
  {
    "id": 78,
    "text": "最后以具体作品集串联并提炼出钱理群权威结论，",
    "start": 331.908,
    "end": 336.087,
    "duration": 4.179
  },
  {
    "id": 79,
    "text": "具体表述到答题语句就是：从五四时期的《热风》到后期的《准风月谈》，",
    "start": 336.087,
    "end": 341.459,
    "duration": 5.372
  },
  {
    "id": 80,
    "text": "他的创作构成了现代中国活的“人史”，",
    "start": 341.459,
    "end": 344.444,
    "duration": 2.985
  },
  {
    "id": 81,
    "text": "细致解剖了现代中国人的心理结构与生存境遇。。",
    "start": 344.444,
    "end": 348.424,
    "duration": 3.98
  },
  {
    "id": 82,
    "text": "首先，鲁迅确立了杂文作为“无体的自由文体”的现代媒介特质与现实介入功能。",
    "start": 348.584,
    "end": 355.304,
    "duration": 6.72
  },
  {
    "id": 83,
    "text": "鲁迅杂文依托现代报刊副刊的发展而兴起。",
    "start": 355.304,
    "end": 358.824,
    "duration": 3.52
  },
  {
    "id": 84,
    "text": "它天然具有迅速回应时代震荡、直接介入现实论争的即时性特征。",
    "start": 358.824,
    "end": 364.344,
    "duration": 5.52
  },
  {
    "id": 85,
    "text": "鲁迅摆脱了传统诗歌、戏剧与小说的僵化形式拘束。",
    "start": 364.344,
    "end": 368.584,
    "duration": 4.24
  },
  {
    "id": 86,
    "text": "他在创作中根据现实论争与主体情绪的需要随物赋形。",
    "start": 368.904,
    "end": 373.864,
    "duration": 4.96
  },
  {
    "id": 87,
    "text": "他在随笔中自由调度逻辑议论、生活叙事、",
    "start": 373.864,
    "end": 377.304,
    "duration": 3.44
  },
  {
    "id": 88,
    "text": "主观抒情与历史联想。",
    "start": 377.304,
    "end": 379.544,
    "duration": 2.24
  },
  {
    "id": 89,
    "text": "从五四时期的《热风》到后期的《准风月谈》，",
    "start": 379.544,
    "end": 382.744,
    "duration": 3.2
  },
  {
    "id": 90,
    "text": "他的创作构成了现代中国活的“人史”，",
    "start": 382.744,
    "end": 385.624,
    "duration": 2.88
  },
  {
    "id": 91,
    "text": "细致解剖了现代中国人的心理结构与生存境遇。",
    "start": 385.624,
    "end": 389.224,
    "duration": 3.6
  },
  {
    "id": 92,
    "text": "（三）第二板块：思想动力与思维方式。",
    "start": 389.384,
    "end": 392.653,
    "duration": 3.269
  },
  {
    "id": 93,
    "text": "论证推演逻辑：讲透鲁迅杂文的思想精髓，",
    "start": 392.653,
    "end": 396.624,
    "duration": 3.971
  },
  {
    "id": 94,
    "text": "绝不能停留在表面的激烈攻击。",
    "start": 396.624,
    "end": 399.66,
    "duration": 3.036
  },
  {
    "id": 95,
    "text": "必须指出批判否定性背后的终极归宿是“立人”启蒙理想。",
    "start": 399.66,
    "end": 405.031,
    "duration": 5.371
  },
  {
    "id": 96,
    "text": "接着剖析鲁迅穿透日常表象的认知机制，",
    "start": 405.031,
    "end": 409.001,
    "duration": 3.97
  },
  {
    "id": 97,
    "text": "“正面文章反面看”的反常规多疑思维。",
    "start": 409.001,
    "end": 412.504,
    "duration": 3.503
  },
  {
    "id": 98,
    "text": "以《论“他妈的”》与《魏晋风度及文章与药及酒之关系》两篇标志性文本作为实证支撑。",
    "start": 412.584,
    "end": 420.024,
    "duration": 7.44
  },
  {
    "id": 99,
    "text": "逐句咬合推导：具体表述到答题语句就是：其次，",
    "start": 420.024,
    "end": 424.248,
    "duration": 4.224
  },
  {
    "id": 100,
    "text": "在思想特质上，鲁迅杂文体现出彻底的批判否定性与反常规的心理解剖思维。，",
    "start": 424.248,
    "end": 431.128,
    "duration": 6.88
  },
  {
    "id": 101,
    "text": "这是第二分论点的核心提炼。",
    "start": 431.128,
    "end": 433.608,
    "duration": 2.48
  },
  {
    "id": 102,
    "text": "紧接着说明其对待一切旧权威的不妥协态度，",
    "start": 433.608,
    "end": 437.288,
    "duration": 3.68
  },
  {
    "id": 103,
    "text": "具体表述到答题语句就是：鲁迅杂文始终保持着毫不妥协的怀疑精神。。",
    "start": 437.288,
    "end": 443.128,
    "duration": 5.84
  },
  {
    "id": 104,
    "text": "随后必须立刻补充其建设性的终极价值追求，",
    "start": 443.448,
    "end": 446.808,
    "duration": 3.36
  },
  {
    "id": 105,
    "text": "防止误读为单纯宣泄，具体表述到答题语句就是：这一批判不是虚无的情绪宣泄，",
    "start": 446.808,
    "end": 453.632,
    "duration": 6.824
  },
  {
    "id": 106,
    "text": "而是始终贯穿着呼唤主体精神独立的“立人”理想。。",
    "start": 453.632,
    "end": 457.727,
    "duration": 4.095
  },
  {
    "id": 107,
    "text": "紧接着转入思维机制分析，具体表述到答题语句就是：面对复杂的社会现象，",
    "start": 457.727,
    "end": 464.073,
    "duration": 6.346
  },
  {
    "id": 108,
    "text": "鲁迅创立了“正面文章反面看”的反常规思维路径。。",
    "start": 464.073,
    "end": 468.168,
    "duration": 4.095
  },
  {
    "id": 109,
    "text": "紧接着切入第一个经典例证，具体表述到答题语句就是：在《论“他妈的”》中，",
    "start": 468.248,
    "end": 473.535,
    "duration": 5.287
  },
  {
    "id": 110,
    "text": "他从日常粗话深挖到背后的门第观念与血统压迫。。",
    "start": 473.535,
    "end": 477.651,
    "duration": 4.116
  },
  {
    "id": 111,
    "text": "随后补充第二个文人思想解剖例证，",
    "start": 477.651,
    "end": 480.59,
    "duration": 2.939
  },
  {
    "id": 112,
    "text": "具体表述到答题语句就是：在《魏晋风度及文章与药及酒之关系》中，",
    "start": 480.59,
    "end": 485.881,
    "duration": 5.291
  },
  {
    "id": 113,
    "text": "他洞察到表面反抗礼教的文人内心反而深藏着对崇高价值的执着。。",
    "start": 485.881,
    "end": 491.368,
    "duration": 5.487
  },
  {
    "id": 114,
    "text": "最后总结这一思维方式的破坏与解构力量，",
    "start": 491.528,
    "end": 494.328,
    "duration": 2.8
  },
  {
    "id": 115,
    "text": "具体表述到答题语句就是：这种穿透表象的认知机制，",
    "start": 494.328,
    "end": 498.408,
    "duration": 4.08
  },
  {
    "id": 116,
    "text": "彻底撕碎了旧制度与旧礼教的伪善面具。。",
    "start": 498.408,
    "end": 501.848,
    "duration": 3.44
  },
  {
    "id": 117,
    "text": "其次，在思想特质上，鲁迅杂文体现出彻底的批判否定性与反常规的心理解剖思维。",
    "start": 501.848,
    "end": 508.648,
    "duration": 6.8
  },
  {
    "id": 118,
    "text": "鲁迅杂文始终保持着毫不妥协的怀疑精神。",
    "start": 508.888,
    "end": 512.808,
    "duration": 3.92
  },
  {
    "id": 119,
    "text": "这一批判不是虚无的情绪宣泄，而是始终贯穿着呼唤主体精神独立的“立人”理想。",
    "start": 512.808,
    "end": 519.688,
    "duration": 6.88
  },
  {
    "id": 120,
    "text": "面对复杂的社会现象，鲁迅创立了“正面文章反面看”的反常规思维路径。",
    "start": 519.688,
    "end": 525.928,
    "duration": 6.24
  },
  {
    "id": 121,
    "text": "在《论“他妈的”》中，他从日常粗话深挖到背后的门第观念与血统压迫。",
    "start": 525.928,
    "end": 531.688,
    "duration": 5.76
  },
  {
    "id": 122,
    "text": "在《魏晋风度及文章与药及酒之关系》中，",
    "start": 532.008,
    "end": 535.448,
    "duration": 3.44
  },
  {
    "id": 123,
    "text": "他洞察到表面反抗礼教的文人内心反而深藏着对崇高价值的执着。",
    "start": 535.448,
    "end": 541.048,
    "duration": 5.6
  },
  {
    "id": 124,
    "text": "这种穿透表象的认知机制，彻底撕碎了旧制度与旧礼教的伪善面具。",
    "start": 541.048,
    "end": 547.128,
    "duration": 6.08
  },
  {
    "id": 125,
    "text": "--。（四",
    "start": 547.128,
    "end": 547.288,
    "duration": 0.16
  },
  {
    "id": 126,
    "text": "）第三板块：艺术思维与典型创造。",
    "start": 547.608,
    "end": 551.048,
    "duration": 3.44
  },
  {
    "id": 127,
    "text": "论证推演逻辑：鲁迅杂文之所以具备高超文学性，",
    "start": 551.048,
    "end": 555.264,
    "duration": 4.216
  },
  {
    "id": 128,
    "text": "核心在于其从个案到普遍社会心理的抽象典型化能力。",
    "start": 555.264,
    "end": 560.144,
    "duration": 4.88
  },
  {
    "id": 129,
    "text": "必须讲清三步机制：从一个具体的人、",
    "start": 560.144,
    "end": 563.344,
    "duration": 3.2
  },
  {
    "id": 130,
    "text": "一件事的细微起点切入、趋近于、置于历史结构进行心理剖析、",
    "start": 563.344,
    "end": 568.784,
    "duration": 5.44
  },
  {
    "id": 131,
    "text": "趋近于、提炼出超越具体人事的社会共名。",
    "start": 568.784,
    "end": 572.224,
    "duration": 3.44
  },
  {
    "id": 132,
    "text": "用“叭儿狗”、“二丑”和“带头羊”的实证印证其艺术生命力。",
    "start": 572.624,
    "end": 576.864,
    "duration": 4.24
  },
  {
    "id": 133,
    "text": "逐句咬合推导：具体表述到答题语句就是：第三，",
    "start": 576.864,
    "end": 581.264,
    "duration": 4.4
  },
  {
    "id": 134,
    "text": "在艺术思维上，鲁迅杂文实现了从具体个案到普遍社会精神现象的概括飞跃。，",
    "start": 581.264,
    "end": 587.904,
    "duration": 6.64
  },
  {
    "id": 135,
    "text": "这是第三分论点的提纲窃领。",
    "start": 587.904,
    "end": 589.904,
    "duration": 2.0
  },
  {
    "id": 136,
    "text": "紧接着强调其立足现实生活的具体感，",
    "start": 590.144,
    "end": 593.344,
    "duration": 3.2
  },
  {
    "id": 137,
    "text": "具体表述到答题语句就是：鲁迅的剖析从不流于抽象教条。。",
    "start": 593.344,
    "end": 599.024,
    "duration": 5.68
  },
  {
    "id": 138,
    "text": "随后说明其观察与起笔的具象化特征，",
    "start": 599.024,
    "end": 602.464,
    "duration": 3.44
  },
  {
    "id": 139,
    "text": "具体表述到答题语句就是：他总是抓住日常生活中的具体事件、",
    "start": 602.464,
    "end": 607.824,
    "duration": 5.36
  },
  {
    "id": 140,
    "text": "一句话或一个特定姿态作为解剖起点。。",
    "start": 607.824,
    "end": 610.944,
    "duration": 3.12
  },
  {
    "id": 141,
    "text": "紧接着说明其纵深推进的社会学与历史学分析过程，",
    "start": 611.104,
    "end": 615.344,
    "duration": 4.24
  },
  {
    "id": 142,
    "text": "具体表述到答题语句就是：紧接着，",
    "start": 615.344,
    "end": 618.384,
    "duration": 3.04
  },
  {
    "id": 143,
    "text": "鲁迅将具象个案置于长时段的历史长河与社会结构中持续开掘，",
    "start": 618.384,
    "end": 624.224,
    "duration": 5.84
  },
  {
    "id": 144,
    "text": "提炼出具有深刻讽刺意味与普遍概括力的社会类型共名。。",
    "start": 624.224,
    "end": 629.104,
    "duration": 4.88
  },
  {
    "id": 145,
    "text": "随后列举出最具辨识度的标志性共名符号，",
    "start": 629.104,
    "end": 632.224,
    "duration": 3.12
  },
  {
    "id": 146,
    "text": "具体表述到答题语句就是：他在论辩中创造了“叭儿狗”、",
    "start": 632.224,
    "end": 636.304,
    "duration": 4.08
  },
  {
    "id": 147,
    "text": "“二丑”以及“带头羊”等经典符号。。",
    "start": 636.304,
    "end": 638.864,
    "duration": 2.56
  },
  {
    "id": 148,
    "text": "紧接着结合《论“费厄泼赖”应该缓行》展开剖析，",
    "start": 639.104,
    "end": 643.18,
    "duration": 4.076
  },
  {
    "id": 149,
    "text": "具体表述到答题语句就是：在《论“费厄泼赖”应该缓行》中，",
    "start": 643.18,
    "end": 647.865,
    "duration": 4.685
  },
  {
    "id": 150,
    "text": "“叭儿狗”形象精准概括出依附权势而欺凌弱者的奴性人格，",
    "start": 647.865,
    "end": 652.976,
    "duration": 5.111
  },
  {
    "id": 151,
    "text": "使杂文获得了穿透时代的艺术生命力。。",
    "start": 652.976,
    "end": 656.384,
    "duration": 3.408
  },
  {
    "id": 152,
    "text": "第三，在艺术思维上，鲁迅杂文实现了从具体个案到普遍社会精神现象的概括飞跃。",
    "start": 656.528,
    "end": 664.208,
    "duration": 7.68
  },
  {
    "id": 153,
    "text": "鲁迅的剖析从不流于抽象教条。",
    "start": 664.208,
    "end": 667.328,
    "duration": 3.12
  },
  {
    "id": 154,
    "text": "他总是抓住日常生活中的具体事件、",
    "start": 667.328,
    "end": 670.448,
    "duration": 3.12
  },
  {
    "id": 155,
    "text": "一句话或一个特定姿态作为解剖起点。",
    "start": 670.448,
    "end": 674.208,
    "duration": 3.76
  },
  {
    "id": 156,
    "text": "紧接着，鲁迅将具象个案置于长时段的历史长河与社会结构中持续开掘，",
    "start": 674.208,
    "end": 680.688,
    "duration": 6.48
  },
  {
    "id": 157,
    "text": "提炼出具有深刻讽刺意味与普遍概括力的社会类型共名。",
    "start": 680.688,
    "end": 685.168,
    "duration": 4.48
  },
  {
    "id": 158,
    "text": "他在论辩中创造了“叭儿狗”、“二丑”以及“带头羊”等经典符号。",
    "start": 685.408,
    "end": 690.448,
    "duration": 5.04
  },
  {
    "id": 159,
    "text": "在《论“费厄泼赖”应该缓行》中，",
    "start": 690.448,
    "end": 692.928,
    "duration": 2.48
  },
  {
    "id": 160,
    "text": "“叭儿狗”形象精准概括出依附权势而欺凌弱者的奴性人格，",
    "start": 692.928,
    "end": 698.288,
    "duration": 5.36
  },
  {
    "id": 161,
    "text": "使杂文获得了穿透时代的艺术生命力。",
    "start": 698.288,
    "end": 701.488,
    "duration": 3.2
  },
  {
    "id": 162,
    "text": "--。（五",
    "start": 701.488,
    "end": 701.648,
    "duration": 0.16
  },
  {
    "id": 163,
    "text": "）第四板块：审美格调与主观过滤。",
    "start": 702.048,
    "end": 704.848,
    "duration": 2.8
  },
  {
    "id": 164,
    "text": "-论证推演逻辑：杂文不是冷冰冰的新闻公报，",
    "start": 705.088,
    "end": 708.806,
    "duration": 3.718
  },
  {
    "id": 165,
    "text": "其最具文学魅力的是作者灵魂的深层投射。",
    "start": 708.806,
    "end": 712.524,
    "duration": 3.718
  },
  {
    "id": 166,
    "text": "必须阐明现实人事经过鲁迅主体情感过滤后的内化机制。",
    "start": 712.524,
    "end": 717.481,
    "duration": 4.957
  },
  {
    "id": 167,
    "text": "引入《记念刘和珍君》这一绝对经典文本，",
    "start": 717.481,
    "end": 720.785,
    "duration": 3.304
  },
  {
    "id": 168,
    "text": "剖析其在“写与不写”、“沉默与爆发”之间的心灵剧烈撕扯，",
    "start": 720.785,
    "end": 725.329,
    "duration": 4.544
  },
  {
    "id": 169,
    "text": "论证其沉郁顿挫的诗性特质。",
    "start": 725.329,
    "end": 727.808,
    "duration": 2.479
  },
  {
    "id": 170,
    "text": "-逐句咬合推导：具体表述到答题语句就是：第四，",
    "start": 727.808,
    "end": 731.789,
    "duration": 3.981
  },
  {
    "id": 171,
    "text": "在抒情格调与审美追求上，鲁迅杂文展现出客观人事经主体精神过滤后的深沉诗性。，",
    "start": 731.789,
    "end": 739.122,
    "duration": 7.333
  },
  {
    "id": 172,
    "text": "这是第四分论点的核心观点。",
    "start": 739.122,
    "end": 741.637,
    "duration": 2.515
  },
  {
    "id": 173,
    "text": "紧接着划清与冷漠报道的界限，具体表述到答题语句就是：鲁迅杂文绝非冷漠客观的纪实报道。。",
    "start": 741.637,
    "end": 749.808,
    "duration": 8.171
  },
  {
    "id": 174,
    "text": "随后阐释人事主观化的关键机制，具体表述到答题语句就是：外部的现实危机与论战人事一旦进入鲁迅视野，",
    "start": 749.968,
    "end": 759.375,
    "duration": 9.407
  },
  {
    "id": 175,
    "text": "立刻会经过其炽热痛苦的生命体验的浸润，",
    "start": 759.375,
    "end": 763.056,
    "duration": 3.681
  },
  {
    "id": 176,
    "text": "转化为内在心灵的严峻搏斗。。",
    "start": 763.056,
    "end": 765.511,
    "duration": 2.455
  },
  {
    "id": 177,
    "text": "紧接着切入《记念刘和珍君》的实证分析，",
    "start": 765.511,
    "end": 768.783,
    "duration": 3.272
  },
  {
    "id": 178,
    "text": "具体表述到答题语句就是：在《记念刘和珍君》中，",
    "start": 768.783,
    "end": 772.669,
    "duration": 3.886
  },
  {
    "id": 179,
    "text": "文本并未局限于揭露军阀暴行。。",
    "start": 772.669,
    "end": 775.328,
    "duration": 2.659
  },
  {
    "id": 180,
    "text": "随后剖析其内在情感冲突的往返节奏，",
    "start": 775.488,
    "end": 778.688,
    "duration": 3.2
  },
  {
    "id": 181,
    "text": "具体表述到答题语句就是：作品深层涌动着在“写与不写”、",
    "start": 778.688,
    "end": 783.248,
    "duration": 4.56
  },
  {
    "id": 182,
    "text": "“沉默与爆发”之间剧烈撕扯的情感波澜。。",
    "start": 783.248,
    "end": 786.448,
    "duration": 3.2
  },
  {
    "id": 183,
    "text": "紧接着说明这种生命体验带来的艺术节奏感，",
    "start": 786.448,
    "end": 790.248,
    "duration": 3.8
  },
  {
    "id": 184,
    "text": "具体表述到答题语句就是：这种强烈的生命痛苦赋予了杂文以沉郁顿挫的情感节奏。。",
    "start": 790.248,
    "end": 797.248,
    "duration": 7.0
  },
  {
    "id": 185,
    "text": "最后总结客观批判与主观抒情融合后的诗性境界，",
    "start": 797.384,
    "end": 801.704,
    "duration": 4.32
  },
  {
    "id": 186,
    "text": "具体表述到答题语句就是：冷峻的现实批判与炽烈的抒情力量在此交融，",
    "start": 801.704,
    "end": 808.024,
    "duration": 6.32
  },
  {
    "id": 187,
    "text": "杂文因而获得了震撼人心的诗性特质。。",
    "start": 808.024,
    "end": 811.064,
    "duration": 3.04
  },
  {
    "id": 188,
    "text": "第四，在抒情格调与审美追求上，鲁迅杂文展现出客观人事经主体精神过滤后的深沉诗性。",
    "start": 811.064,
    "end": 818.904,
    "duration": 7.84
  },
  {
    "id": 189,
    "text": "鲁迅杂文绝非冷漠客观的纪实报道。",
    "start": 819.224,
    "end": 822.264,
    "duration": 3.04
  },
  {
    "id": 190,
    "text": "外部的现实危机与论战人事一旦进入鲁迅视野，",
    "start": 822.264,
    "end": 826.424,
    "duration": 4.16
  },
  {
    "id": 191,
    "text": "立刻会经过其炽热痛苦的生命体验的浸润，",
    "start": 826.424,
    "end": 830.184,
    "duration": 3.76
  },
  {
    "id": 192,
    "text": "转化为内在心灵的严峻搏斗。",
    "start": 830.184,
    "end": 832.824,
    "duration": 2.64
  },
  {
    "id": 193,
    "text": "在《记念刘和珍君》中，文本并未局限于揭露军阀暴行。",
    "start": 832.824,
    "end": 837.304,
    "duration": 4.48
  },
  {
    "id": 194,
    "text": "作品深层涌动着在“写与不写”、“沉默与爆发”之间剧烈撕扯的情感波澜。",
    "start": 837.304,
    "end": 842.744,
    "duration": 5.44
  },
  {
    "id": 195,
    "text": "这种强烈的生命痛苦赋予了杂文以沉郁顿挫的情感节奏。",
    "start": 843.064,
    "end": 848.184,
    "duration": 5.12
  },
  {
    "id": 196,
    "text": "冷峻的现实批判与炽烈的抒情力量在此交融，",
    "start": 848.184,
    "end": 852.104,
    "duration": 3.92
  },
  {
    "id": 197,
    "text": "杂文因而获得了震撼人心的诗性特质。。",
    "start": 852.104,
    "end": 855.224,
    "duration": 3.12
  },
  {
    "id": 198,
    "text": "（六）第五板块：语言张力与文体破格。",
    "start": 855.224,
    "end": 859.064,
    "duration": 3.84
  },
  {
    "id": 199,
    "text": "论证推演逻辑：最后必须收束在文学的终极载体，",
    "start": 859.064,
    "end": 863.544,
    "duration": 4.48
  },
  {
    "id": 200,
    "text": "语言形式的革命上。",
    "start": 863.544,
    "end": 864.904,
    "duration": 1.36
  },
  {
    "id": 201,
    "text": "阐释鲁迅有意识地破坏语法规范与惯性搭配，",
    "start": 865.144,
    "end": 869.064,
    "duration": 3.92
  },
  {
    "id": 202,
    "text": "制造“不和谐”的拗体句式，以语言的断裂对抗虚伪的秩序。",
    "start": 869.064,
    "end": 873.784,
    "duration": 4.72
  },
  {
    "id": 203,
    "text": "结合矛盾悖论修辞（如“跪着的造反”）、",
    "start": 873.784,
    "end": 876.904,
    "duration": 3.12
  },
  {
    "id": 204,
    "text": "大词小用与庄谐杂糅，分析其反讽美学机制。",
    "start": 876.904,
    "end": 880.744,
    "duration": 3.84
  },
  {
    "id": 205,
    "text": "逐句咬合推导：具体表述到答题语句就是：最后，",
    "start": 880.744,
    "end": 884.544,
    "duration": 3.8
  },
  {
    "id": 206,
    "text": "在文体语言上，鲁迅杂文以反规范的拗体句式与庄谐杂糅创造了极具冲击力的语言张力。，",
    "start": 884.544,
    "end": 891.944,
    "duration": 7.4
  },
  {
    "id": 207,
    "text": "这是第五分论点的核心观点立桩。",
    "start": 891.944,
    "end": 894.744,
    "duration": 2.8
  },
  {
    "id": 208,
    "text": "紧接着解释其反常语言背后的思想动机，",
    "start": 894.824,
    "end": 898.184,
    "duration": 3.36
  },
  {
    "id": 209,
    "text": "具体表述到答题语句就是：鲁迅为了撕开温情虚伪的语言屏障，",
    "start": 898.184,
    "end": 903.357,
    "duration": 5.173
  },
  {
    "id": 210,
    "text": "故意打破常规的词语搭配习惯。。",
    "start": 903.357,
    "end": 905.923,
    "duration": 2.566
  },
  {
    "id": 211,
    "text": "随后列举教材经典的矛盾悖论短语，",
    "start": 905.923,
    "end": 908.883,
    "duration": 2.96
  },
  {
    "id": 212,
    "text": "具体表述到答题语句就是：他在文本中创造了“有理的压迫”与“跪着的造反”等矛盾悖论修辞。。",
    "start": 908.883,
    "end": 916.184,
    "duration": 7.301
  },
  {
    "id": 213,
    "text": "紧接着分析这种反规范语言的揭露功能，",
    "start": 916.264,
    "end": 919.464,
    "duration": 3.2
  },
  {
    "id": 214,
    "text": "具体表述到答题语句就是：这种刺耳不谐的表达迫使读者直面现实名实分裂的残酷本质。。",
    "start": 919.464,
    "end": 927.051,
    "duration": 7.587
  },
  {
    "id": 215,
    "text": "进一步展开其多源语料的自由熔铸，",
    "start": 927.051,
    "end": 930.079,
    "duration": 3.028
  },
  {
    "id": 216,
    "text": "具体表述到答题语句就是：同时，鲁迅自由穿梭于古文典故、",
    "start": 930.079,
    "end": 934.924,
    "duration": 4.845
  },
  {
    "id": 217,
    "text": "市井俗语与白话口语之间。。",
    "start": 934.924,
    "end": 937.144,
    "duration": 2.22
  },
  {
    "id": 218,
    "text": "随后引入庄词谐用与大词小用的具体例证，",
    "start": 937.36,
    "end": 940.96,
    "duration": 3.6
  },
  {
    "id": 219,
    "text": "具体表述到答题语句就是：他在《商贾的批评》等篇章中大词小用且庄词谐用。。",
    "start": 940.96,
    "end": 947.6,
    "duration": 6.64
  },
  {
    "id": 220,
    "text": "最后总结这种修辞并置产生的高级美学效果，",
    "start": 947.6,
    "end": 951.653,
    "duration": 4.053
  },
  {
    "id": 221,
    "text": "具体表述到答题语句就是：这种将崇高与荒唐并置的修辞策略，",
    "start": 951.653,
    "end": 957.2,
    "duration": 5.547
  },
  {
    "id": 222,
    "text": "产生了极具杀伤力的反讽美学力量。。",
    "start": 957.2,
    "end": 960.4,
    "duration": 3.2
  },
  {
    "id": 223,
    "text": "最后，在文体语言上，鲁迅杂文以反规范的拗体句式与庄谐杂糅创造了极具冲击力的语言张力。",
    "start": 960.48,
    "end": 968.24,
    "duration": 7.76
  },
  {
    "id": 224,
    "text": "鲁迅为了撕开温情虚伪的语言屏障，",
    "start": 968.24,
    "end": 970.96,
    "duration": 2.72
  },
  {
    "id": 225,
    "text": "故意打破常规的词语搭配习惯。",
    "start": 970.96,
    "end": 973.52,
    "duration": 2.56
  },
  {
    "id": 226,
    "text": "他在文本中创造了“有理的压迫”与“跪着的造反”等矛盾悖论修辞。",
    "start": 973.52,
    "end": 978.56,
    "duration": 5.04
  },
  {
    "id": 227,
    "text": "这种刺耳不谐的表达迫使读者直面现实名实分裂的残酷本质。",
    "start": 978.88,
    "end": 983.84,
    "duration": 4.96
  },
  {
    "id": 228,
    "text": "同时，鲁迅自由穿梭于古文典故、市井俗语与白话口语之间。",
    "start": 983.84,
    "end": 988.72,
    "duration": 4.88
  },
  {
    "id": 229,
    "text": "他在《商贾的批评》等篇章中大词小用且庄词谐用。",
    "start": 988.72,
    "end": 993.36,
    "duration": 4.64
  },
  {
    "id": 230,
    "text": "这种将崇高与荒唐并置的修辞策略，",
    "start": 993.36,
    "end": 996.16,
    "duration": 2.8
  },
  {
    "id": 231,
    "text": "产生了极具杀伤力的反讽美学力量。",
    "start": 996.16,
    "end": 998.56,
    "duration": 2.4
  },
  {
    "id": 232,
    "text": "---。（七",
    "start": 998.72,
    "end": 998.939,
    "duration": 0.219
  },
  {
    "id": 233,
    "text": "）总结升华板块。",
    "start": 998.939,
    "end": 1000.252,
    "duration": 1.313
  },
  {
    "id": 234,
    "text": "收口推演逻辑：总结全篇论述要点。",
    "start": 1000.252,
    "end": 1003.316,
    "duration": 3.064
  },
  {
    "id": 235,
    "text": "重申鲁迅杂文将社会功利介入与本体审美价值融为一体的伟大创造，",
    "start": 1003.316,
    "end": 1009.663,
    "duration": 6.347
  },
  {
    "id": 236,
    "text": "再次点题其在中国散文史乃至整个现代文学史上的巅峰坐标，",
    "start": 1009.663,
    "end": 1015.353,
    "duration": 5.69
  },
  {
    "id": 237,
    "text": "完成考场论述的饱满收束。",
    "start": 1015.353,
    "end": 1017.76,
    "duration": 2.407
  },
  {
    "id": 238,
    "text": "-逐句咬合推导：具体表述到答题语句就是：综上所述，",
    "start": 1017.76,
    "end": 1022.101,
    "duration": 4.341
  },
  {
    "id": 239,
    "text": "鲁迅杂文将战斗的社会功能与独立的文学品格高度统一。，",
    "start": 1022.101,
    "end": 1027.063,
    "duration": 4.962
  },
  {
    "id": 240,
    "text": "这是宏观维度的总结。",
    "start": 1027.063,
    "end": 1028.924,
    "duration": 1.861
  },
  {
    "id": 241,
    "text": "紧接着点明其形式层面的突破，具体表述到答题语句就是：它以“无体”的自由形式拓展了中国现代散文的审美边界。。",
    "start": 1028.924,
    "end": 1038.64,
    "duration": 9.716
  },
  {
    "id": 242,
    "text": "随后回扣前文论述的核心要素，具体表述到答题语句就是：它以深邃的启蒙批判、",
    "start": 1038.8,
    "end": 1046.16,
    "duration": 7.36
  },
  {
    "id": 243,
    "text": "典型化的精神透视、深沉的主观诗性与反规范的语言实验，",
    "start": 1046.16,
    "end": 1052.0,
    "duration": 5.84
  },
  {
    "id": 244,
    "text": "奠定了中国现代杂文的崇高美学巅峰。。",
    "start": 1052.0,
    "end": 1055.36,
    "duration": 3.36
  },
  {
    "id": 245,
    "text": "综上所述，鲁迅杂文将战斗的社会功能与独立的文学品格高度统一。",
    "start": 1055.36,
    "end": 1061.36,
    "duration": 6.0
  },
  {
    "id": 246,
    "text": "它以“无体”的自由形式拓展了中国现代散文的审美边界。",
    "start": 1061.6,
    "end": 1066.16,
    "duration": 4.56
  },
  {
    "id": 247,
    "text": "它以深邃的启蒙批判、典型化的精神透视、",
    "start": 1066.16,
    "end": 1069.6,
    "duration": 3.44
  },
  {
    "id": 248,
    "text": "深沉的主观诗性与反规范的语言实验，",
    "start": 1069.6,
    "end": 1072.8,
    "duration": 3.2
  },
  {
    "id": 249,
    "text": "奠定了中国现代杂文的崇高美学巅峰。",
    "start": 1072.8,
    "end": 1075.68,
    "duration": 2.88
  }
]