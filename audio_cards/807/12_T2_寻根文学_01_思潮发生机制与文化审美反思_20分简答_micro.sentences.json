[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "寻根文学·思潮发生机制与文化审美反思",
    "start": 0.354,
    "end": 4.526,
    "duration": 4.172
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "理论发生（韩少功《文学的“根”》跳出政治社会学）→文化精神内核（阿城《棋王》王一生淡泊守道家骨气）→现代派技法结合民俗（李杭育/贾平凹/莫言），",
    "start": 5.574,
    "end": 19.106,
    "duration": 13.532
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "清晰勾勒八十年代中期寻根潮。",
    "start": 19.534,
    "end": 21.786,
    "duration": 2.252
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "八十年代中期面对反思文学局限与西方现代主义冲击，文坛兴起“寻根”思潮，",
    "start": 22.834,
    "end": 30.166,
    "duration": 7.332
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "跳出单一政治社会学批判，向民族历史文化心理探求资源。",
    "start": 30.474,
    "end": 35.406,
    "duration": 4.932
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 发表理论宣言、确立“寻根”创作自觉",
    "start": 36.334,
    "end": 40.306,
    "duration": 3.972
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "韩少功《文学的“根”》提“文学有根，文学之根应深植于民族传统文化的土壤里”；",
    "start": 41.394,
    "end": 48.766,
    "duration": 7.372
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "呼唤从楚辞浪漫奇诡、道家清虚自守与地域民俗汲养分，由外部社会批判转向民族文化心理开掘。",
    "start": 49.694,
    "end": 59.786,
    "duration": 10.092
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 发掘儒道人格精神、重建自尊品格",
    "start": 60.754,
    "end": 64.286,
    "duration": 3.532
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "在现代转型迷失中重拾传统文化美好品格；",
    "start": 65.254,
    "end": 69.946,
    "duration": 4.692
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "阿城《棋王》写“棋呆子”王一生把“吃饱”作底线，车轮战以一敌九下盲棋连胜八人言和，",
    "start": 71.034,
    "end": 80.366,
    "duration": 9.332
  },
  {
    "id": "sec1_step1_c1",
    "dom_key": "sec1_step1_c1",
    "text": "淡泊自守、超然自尊显道家精神当代延续。",
    "start": 80.714,
    "end": 84.646,
    "duration": 3.932
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 融现代主义象征与地域民俗、拓宽文体",
    "start": 85.694,
    "end": 89.866,
    "duration": 4.172
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "告别单线叙事，吸收拉美魔幻现实主义与现代象征手法，呈鲜明地域风貌；",
    "start": 90.858,
    "end": 98.59,
    "duration": 7.732
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "李杭育“葛川江系列”写吴越水乡、贾平凹“商州系列”绘秦岭风俗、莫言早期写齐鲁传奇，拓宽艺术表现力。",
    "start": 99.558,
    "end": 110.05,
    "duration": 10.492
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：核心理论韩少功《文学的“根”》；",
    "start": 111.018,
    "end": 114.31,
    "duration": 3.292
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "核心代表作记住阿城《棋王》（王一生下盲棋）、李杭育“葛川江系列”、贾平凹“商州系列”、莫言早期齐鲁传奇。",
    "start": 115.358,
    "end": 124.89,
    "duration": 9.532
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 背全韩少功宣言文章篇名与“深植民族传统文化土壤”核心主张？",
    "start": 125.858,
    "end": 133.43,
    "duration": 7.572
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 结合阿城《棋王》王一生“以一敌九下盲棋”阐发道家自尊与文化救赎？",
    "start": 134.398,
    "end": 141.93,
    "duration": 7.532
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 列出李杭育、贾平凹、莫言的寻根地域系列及外吸拉美魔幻的融合特征？",
    "start": 142.938,
    "end": 150.91,
    "duration": 7.972
  }
]