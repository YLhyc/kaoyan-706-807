[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "当代思潮流派与文论概念合辑",
    "start": 0.234,
    "end": 3.806,
    "duration": 3.572
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "当代16题最怕“时代错位与流派混淆”：诗歌记住“朦胧（含蓄）→第三代（口语反崇高）→打工（流水线）”；",
    "start": 4.854,
    "end": 15.826,
    "duration": 10.972
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "小说按“伤痕→反思→寻根/改革→先锋/新写实”时间轴推进。",
    "start": 16.834,
    "end": 22.486,
    "duration": 5.652
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 朦胧诗",
    "start": 23.414,
    "end": 24.866,
    "duration": 1.452
  },
  {
    "id": "sec0_s1_c0",
    "dom_key": "sec0_s1_c0",
    "text": "新时期之初伴随《今天》杂志创立而崛起的重要现代诗歌流派。",
    "start": 25.394,
    "end": 32.046,
    "duration": 6.652
  },
  {
    "id": "sec0_s1_c1",
    "dom_key": "sec0_s1_c1",
    "text": "主要代表诗人有北岛、舒婷、顾城、江河等。",
    "start": 33.014,
    "end": 37.746,
    "duration": 4.732
  },
  {
    "id": "sec0_s2_c0",
    "dom_key": "sec0_s2_c0",
    "text": "诗群打破政治教条抒情，转向对主体独立尊严的确认与历史反思，",
    "start": 38.794,
    "end": 45.486,
    "duration": 6.692
  },
  {
    "id": "sec0_s2_c1",
    "dom_key": "sec0_s2_c1",
    "text": "广泛采用意象隐喻、象征通感与多义歧解手法，因语言含蓄晦涩而得名。",
    "start": 45.874,
    "end": 52.406,
    "duration": 6.532
  },
  {
    "id": "sec0_s2_c2",
    "dom_key": "sec0_s2_c2",
    "text": "代表作有北岛《回答》、舒婷《致橡树》。",
    "start": 53.414,
    "end": 57.026,
    "duration": 3.612
  },
  {
    "id": "sec0_s3_c0",
    "dom_key": "sec0_s3_c0",
    "text": "它开启了当代文学的人性复归与诗体革命。",
    "start": 58.034,
    "end": 62.246,
    "duration": 4.212
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 先锋小说",
    "start": 63.254,
    "end": 64.906,
    "duration": 1.652
  },
  {
    "id": "sec1_s1_c0",
    "dom_key": "sec1_s1_c0",
    "text": "八十年代中后期受西方后现代主义影响爆发的文体形式实验思潮。",
    "start": 65.434,
    "end": 72.166,
    "duration": 6.732
  },
  {
    "id": "sec1_s1_c1",
    "dom_key": "sec1_s1_c1",
    "text": "主要代表作家有马原、余华、格非、残雪等。",
    "start": 73.214,
    "end": 77.186,
    "duration": 3.972
  },
  {
    "id": "sec1_s2_c0",
    "dom_key": "sec1_s2_c0",
    "text": "核心特征为打破传统因果情节与既定主题模式，注重叙事迷宫建构、零度暴力白描、时间拼贴与元叙事实验。",
    "start": 78.194,
    "end": 89.046,
    "duration": 10.852
  },
  {
    "id": "sec1_s2_c1",
    "dom_key": "sec1_s2_c1",
    "text": "代表作有马原《冈底斯的诱惑》、余华《现实一种》。",
    "start": 89.394,
    "end": 93.126,
    "duration": 3.732
  },
  {
    "id": "sec1_s3_c0",
    "dom_key": "sec1_s3_c0",
    "text": "该思潮刷新了当代汉语小说的形式思维与叙事观念。",
    "start": 93.591,
    "end": 98.963,
    "duration": 5.372
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 寻根文学",
    "start": 99.631,
    "end": 101.523,
    "duration": 1.892
  },
  {
    "id": "sec2_s1_c0",
    "dom_key": "sec2_s1_c0",
    "text": "八十年代中期文坛兴起的向民族深层历史文化心理结构探寻的文学思潮。",
    "start": 102.531,
    "end": 109.743,
    "duration": 7.212
  },
  {
    "id": "sec2_s2_c0",
    "dom_key": "sec2_s2_c0",
    "text": "以韩少功发表《文学的“根”》为理论先导，代表作家有韩少功、阿城、李杭育、贾平凹等。",
    "start": 110.791,
    "end": 118.563,
    "duration": 7.772
  },
  {
    "id": "sec2_s2_c1",
    "dom_key": "sec2_s2_c1",
    "text": "主张跳出狭隘的政治社会学批判，深入儒道精神、地域风俗与原始野性中寻觅民族生命力。",
    "start": 119.571,
    "end": 127.623,
    "duration": 8.052
  },
  {
    "id": "sec2_s2_c2",
    "dom_key": "sec2_s2_c2",
    "text": "代表作有阿城《棋王》、韩少功《爸爸爸》。",
    "start": 128.551,
    "end": 131.443,
    "duration": 2.892
  },
  {
    "id": "sec2_s3_c0",
    "dom_key": "sec2_s3_c0",
    "text": "它拓展了当代小说的文化哲学深度。",
    "start": 132.611,
    "end": 136.783,
    "duration": 4.172
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 新写实小说",
    "start": 137.791,
    "end": 139.683,
    "duration": 1.892
  },
  {
    "id": "sec3_s1_c0",
    "dom_key": "sec3_s1_c0",
    "text": "八十年代末至九十年代初兴起于《钟山》等刊物的重要小说流派。",
    "start": 140.193,
    "end": 146.205,
    "duration": 6.012
  },
  {
    "id": "sec3_s1_c1",
    "dom_key": "sec3_s1_c1",
    "text": "主要代表作家有池莉、刘震云、方方等。",
    "start": 147.213,
    "end": 150.665,
    "duration": 3.452
  },
  {
    "id": "sec3_s2_c0",
    "dom_key": "sec3_s2_c0",
    "text": "核心特质为摒弃崇高神话与英雄叙事，转向呈现普通平民日常生存“毛茸茸的原生态”，",
    "start": 151.713,
    "end": 160.605,
    "duration": 8.892
  },
  {
    "id": "sec3_s2_c1",
    "dom_key": "sec3_s2_c1",
    "text": "以客观冷静的零度情感直面琐屑人生烦恼。",
    "start": 161.073,
    "end": 164.965,
    "duration": 3.892
  },
  {
    "id": "sec3_s2_c2",
    "dom_key": "sec3_s2_c2",
    "text": "代表作有池莉《烦恼人生》、刘震云《一地鸡毛》。",
    "start": 165.893,
    "end": 169.905,
    "duration": 4.012
  },
  {
    "id": "sec3_s3_c0",
    "dom_key": "sec3_s3_c0",
    "text": "它标志着现实主义文学向平民立场的回归。",
    "start": 170.953,
    "end": 175.365,
    "duration": 4.412
  },
  {
    "id": "sec4_title_c0",
    "dom_key": "sec4_title_c0",
    "text": "05 · 文化散文",
    "start": 176.029,
    "end": 177.681,
    "duration": 1.652
  },
  {
    "id": "sec4_s1_c0",
    "dom_key": "sec4_s1_c0",
    "text": "九十年代初随着余秋雨《文化苦旅》畅销而风靡文坛的一种学者型大散文范式。",
    "start": 178.209,
    "end": 185.661,
    "duration": 7.452
  },
  {
    "id": "sec4_s2_c0",
    "dom_key": "sec4_s2_c0",
    "text": "代表作家有余秋雨、张承志等。",
    "start": 186.393,
    "end": 189.765,
    "duration": 3.372
  },
  {
    "id": "sec4_s3_c0",
    "dom_key": "sec4_s3_c0",
    "text": "其文体特征为将游记考察、历史掌故钩沉与个体生命哲学拷问深度结合，行文气势磅礴、抒情浓烈，",
    "start": 190.733,
    "end": 201.145,
    "duration": 10.412
  },
  {
    "id": "sec4_s3_c1",
    "dom_key": "sec4_s3_c1",
    "text": "致力于在自然历史废墟上反思中华文明兴衰与文人宿命，提升了当代散文的文化厚度与公共传播力。",
    "start": 201.453,
    "end": 209.905,
    "duration": 8.452
  },
  {
    "id": "sec5_title_c0",
    "dom_key": "sec5_title_c0",
    "text": "06 · 第三代诗歌",
    "start": 210.833,
    "end": 212.605,
    "duration": 1.772
  },
  {
    "id": "sec5_s1_c0",
    "dom_key": "sec5_s1_c0",
    "text": "八十年代中期继朦胧诗之后崛起的青年诗人群体（又称“后朦胧诗”或“新生代诗歌”）。",
    "start": 213.1,
    "end": 221.752,
    "duration": 8.652
  },
  {
    "id": "sec5_s2_c0",
    "dom_key": "sec5_s2_c0",
    "text": "代表派别有“莽汉主义”“他们”等，主要诗人有韩东、于坚等。",
    "start": 222.76,
    "end": 228.132,
    "duration": 5.372
  },
  {
    "id": "sec5_s3_c0",
    "dom_key": "sec5_s3_c0",
    "text": "核心主张“反崇高、反英雄、消解隐喻”，提出“诗到语言为止”，",
    "start": 229.14,
    "end": 235.672,
    "duration": 6.532
  },
  {
    "id": "sec5_s3_c1",
    "dom_key": "sec5_s3_c1",
    "text": "以日常口语、游戏调侃与反讽姿态消解朦胧诗的英雄主义情结，开辟了平民日常诗学的新天地。",
    "start": 235.98,
    "end": 243.992,
    "duration": 8.012
  },
  {
    "id": "sec6_title_c0",
    "dom_key": "sec6_title_c0",
    "text": "07 · 打工诗歌",
    "start": 244.92,
    "end": 246.412,
    "duration": 1.492
  },
  {
    "id": "sec6_s1_c0",
    "dom_key": "sec6_s1_c0",
    "text": "九十年代随着我国南方沿海特区工业化与农民工进城潮兴起的新型底层诗歌流派。",
    "start": 246.922,
    "end": 255.254,
    "duration": 8.332
  },
  {
    "id": "sec6_s2_c0",
    "dom_key": "sec6_s2_c0",
    "text": "主要创作者为进城务工的流动劳工，新世纪以来涌现郑小琼、许立志等代表诗人。",
    "start": 256.262,
    "end": 263.874,
    "duration": 7.612
  },
  {
    "id": "sec6_s3_c0",
    "dom_key": "sec6_s3_c0",
    "text": "核心特质为真实直击流水线机器轰鸣、加班透支、工伤流血与异乡漂泊的肉体创痛与尊严诉求，",
    "start": 264.882,
    "end": 274.494,
    "duration": 9.612
  },
  {
    "id": "sec6_s3_c1",
    "dom_key": "sec6_s3_c1",
    "text": "语言粗粝真实、痛感直白，是中国当代工业文明底层劳工极具震撼力的生命证词。",
    "start": 274.922,
    "end": 281.974,
    "duration": 7.052
  },
  {
    "id": "sec7_title_c0",
    "dom_key": "sec7_title_c0",
    "text": "08 · “双百”方针",
    "start": 283.006,
    "end": 284.898,
    "duration": 1.892
  },
  {
    "id": "sec7_s1_c0",
    "dom_key": "sec7_s1_c0",
    "text": "五十年代中期党在领导文艺与科学研究工作中提出的核心指导方针。",
    "start": 285.946,
    "end": 292.318,
    "duration": 6.372
  },
  {
    "id": "sec7_s2_c0",
    "dom_key": "sec7_s2_c0",
    "text": "全称为“百花齐放，百家争鸣”，即艺术问题上百花齐放、学术问题上百家争鸣。",
    "start": 293.326,
    "end": 301.338,
    "duration": 8.012
  },
  {
    "id": "sec7_s3_c0",
    "dom_key": "sec7_s3_c0",
    "text": "旨在调动知识分子积极性，促进学术文化与社会主义文艺的多样繁荣，",
    "start": 302.346,
    "end": 308.878,
    "duration": 6.532
  },
  {
    "id": "sec7_s3_c1",
    "dom_key": "sec7_s3_c1",
    "text": "成为当代中国思想文化政策的重要基石，在当代文学体制演进中具有深远的历史影响。",
    "start": 309.266,
    "end": 316.318,
    "duration": 7.052
  },
  {
    "id": "sec8_title_c0",
    "dom_key": "sec8_title_c0",
    "text": "09 · 伤痕文学",
    "start": 317.326,
    "end": 318.938,
    "duration": 1.612
  },
  {
    "id": "sec8_s1_c0",
    "dom_key": "sec8_s1_c0",
    "text": "新时期初期随着卢新华短篇小说《伤痕》发表而命名并兴起的一股文学思潮。",
    "start": 319.466,
    "end": 326.478,
    "duration": 7.012
  },
  {
    "id": "sec8_s2_c0",
    "dom_key": "sec8_s2_c0",
    "text": "主要代表作有刘心武《班主任》、卢新华《伤痕》、王亚平《神圣的使命》等。",
    "start": 327.446,
    "end": 334.538,
    "duration": 7.092
  },
  {
    "id": "sec8_s3_c0",
    "dom_key": "sec8_s3_c0",
    "text": "核心特质是以控诉和哀怨的悲情笔调，真实展现动乱对普通人灵魂与肉体的摧残，",
    "start": 335.546,
    "end": 343.078,
    "duration": 7.532
  },
  {
    "id": "sec8_s3_c1",
    "dom_key": "sec8_s3_c1",
    "text": "呼唤人道主义关怀与真情复归，拉开了新时期文学反思历史的序幕。",
    "start": 343.506,
    "end": 348.718,
    "duration": 5.212
  },
  {
    "id": "sec9_title_c0",
    "dom_key": "sec9_title_c0",
    "text": "10 · 反思文学",
    "start": 349.606,
    "end": 351.218,
    "duration": 1.612
  },
  {
    "id": "sec9_s1_c0",
    "dom_key": "sec9_s1_c0",
    "text": "七十年代末在伤痕文学基础上深化发展起来的文学思潮。",
    "start": 351.766,
    "end": 357.538,
    "duration": 5.772
  },
  {
    "id": "sec9_s2_c0",
    "dom_key": "sec9_s2_c0",
    "text": "主要代表作家作品有茹志鹃《剪辑错了的故事》、高晓声“陈奂生系列”、古华《芙蓉镇》等。",
    "start": 358.578,
    "end": 367.07,
    "duration": 8.492
  },
  {
    "id": "sec9_s3_c0",
    "dom_key": "sec9_s3_c0",
    "text": "思潮不再局限于控诉个人受害遭遇，而是将批判视野延伸至建国后极左路线的历史渊源，",
    "start": 368.038,
    "end": 376.41,
    "duration": 8.372
  },
  {
    "id": "sec9_s3_c1",
    "dom_key": "sec9_s3_c1",
    "text": "从政治、经济与思想根源上展开深层反思，思想深度显著超越伤痕文学。",
    "start": 376.798,
    "end": 383.09,
    "duration": 6.292
  },
  {
    "id": "sec10_title_c0",
    "dom_key": "sec10_title_c0",
    "text": "11 · 改革文学",
    "start": 384.058,
    "end": 386.07,
    "duration": 2.012
  },
  {
    "id": "sec10_s1_c0",
    "dom_key": "sec10_s1_c0",
    "text": "七十年代末至八十年代初伴随工作重心转移和改革开放大潮兴起的文学思潮。",
    "start": 386.598,
    "end": 394.25,
    "duration": 7.652
  },
  {
    "id": "sec10_s2_c0",
    "dom_key": "sec10_s2_c0",
    "text": "主要代表作有蒋子龙《乔厂长上任记》、张洁《沉重的翅膀》等。",
    "start": 395.298,
    "end": 400.99,
    "duration": 5.692
  },
  {
    "id": "sec10_s3_c0",
    "dom_key": "sec10_s3_c0",
    "text": "核心特质是以火热的政治激情歌颂敢于打破体制僵化、勇挑重担的现代改革开拓者形象，",
    "start": 401.998,
    "end": 410.37,
    "duration": 8.372
  },
  {
    "id": "sec10_s3_c1",
    "dom_key": "sec10_s3_c1",
    "text": "真实反映新旧体制交替之际的观念博弈与时代阵痛，具有很强的现实干预性。",
    "start": 410.718,
    "end": 416.89,
    "duration": 6.172
  },
  {
    "id": "sec11_title_c0",
    "dom_key": "sec11_title_c0",
    "text": "12 · 《受戒》",
    "start": 417.898,
    "end": 419.35,
    "duration": 1.452
  },
  {
    "id": "sec11_s1_c0",
    "dom_key": "sec11_s1_c0",
    "text": "八十年代初汪曾祺发表的短篇小说代表作。",
    "start": 419.85,
    "end": 424.382,
    "duration": 4.532
  },
  {
    "id": "sec11_s2_c0",
    "dom_key": "sec11_s2_c0",
    "text": "小说以苏北高邮乡村庵赵庄为背景，打破戏剧性冲突，以从容散淡的笔致描摹水乡风物与和尚世俗生活。",
    "start": 425.35,
    "end": 436.802,
    "duration": 11.452
  },
  {
    "id": "sec11_s3_c0",
    "dom_key": "sec11_s3_c0",
    "text": "通过小和尚明海与农家少女小英子在荸荠田与渡船上的纯真爱恋，",
    "start": 437.81,
    "end": 445.302,
    "duration": 7.492
  },
  {
    "id": "sec11_s3_c1",
    "dom_key": "sec11_s3_c1",
    "text": "展现了不受封建礼教束缚的健康自然人性美，确立了新时期“散文化小说”的抒情美学坐标。",
    "start": 445.57,
    "end": 453.222,
    "duration": 7.652
  },
  {
    "id": "sec12_title_c0",
    "dom_key": "sec12_title_c0",
    "text": "13 · 《红岩》",
    "start": 454.254,
    "end": 455.546,
    "duration": 1.292
  },
  {
    "id": "sec12_s1_c0",
    "dom_key": "sec12_s1_c0",
    "text": "六十年代初罗广斌、杨益言创作的长篇革命历史小说。",
    "start": 456.674,
    "end": 462.046,
    "duration": 5.372
  },
  {
    "id": "sec12_s2_c0",
    "dom_key": "sec12_s2_c0",
    "text": "作品以重庆解放前夕渣滓洞、白公馆特务集中营为舞台，",
    "start": 463.094,
    "end": 468.706,
    "duration": 5.612
  },
  {
    "id": "sec12_s2_c1",
    "dom_key": "sec12_s2_c1",
    "text": "生动塑造了江姐、许云峰、华子良等视死如归的共产党人英雄群像，",
    "start": 469.174,
    "end": 474.866,
    "duration": 5.692
  },
  {
    "id": "sec12_s2_c2",
    "dom_key": "sec12_s2_c2",
    "text": "展现了残酷狱中斗争与越狱暴动，以崇高的革命英雄主义与牺牲精神；",
    "start": 475.334,
    "end": 481.906,
    "duration": 6.572
  },
  {
    "id": "sec12_s3_c0",
    "dom_key": "sec12_s3_c0",
    "text": "成为十七年中国当代革命历史题材小说的经典代表作。",
    "start": 482.874,
    "end": 488.646,
    "duration": 5.772
  },
  {
    "id": "sec13_title_c0",
    "dom_key": "sec13_title_c0",
    "text": "14 · 《文学革命论》",
    "start": 489.654,
    "end": 491.546,
    "duration": 1.892
  },
  {
    "id": "sec13_s1_c0",
    "dom_key": "sec13_s1_c0",
    "text": "五四文学革命纲领性文献。",
    "start": 492.035,
    "end": 494.967,
    "duration": 2.932
  },
  {
    "id": "sec13_s2_c0",
    "dom_key": "sec13_s2_c0",
    "text": "陈独秀在《新青年》发表，明确提出推倒贵族文学、古典文学与山林文学，",
    "start": 495.975,
    "end": 502.773,
    "duration": 6.798
  },
  {
    "id": "sec13_s2_c1",
    "dom_key": "sec13_s2_c1",
    "text": "建设国民文学、写实文学与社会文学的“三大主义”，不仅在形式上倡导白话文，",
    "start": 502.975,
    "end": 508.947,
    "duration": 5.972
  },
  {
    "id": "sec13_s2_c2",
    "dom_key": "sec13_s2_c2",
    "text": "更在思想内容上确立了现代文学面向平民大众与社会现实的革命方向；",
    "start": 509.255,
    "end": 515.227,
    "duration": 5.972
  },
  {
    "id": "sec13_s3_c0",
    "dom_key": "sec13_s3_c0",
    "text": "吹响了中国新文学运动全面决战的进军号角。",
    "start": 516.195,
    "end": 521.047,
    "duration": 4.852
  },
  {
    "id": "sec14_title_c0",
    "dom_key": "sec14_title_c0",
    "text": "15 · 鸳鸯蝴蝶派",
    "start": 522.055,
    "end": 524.027,
    "duration": 1.972
  },
  {
    "id": "sec14_s1_c0",
    "dom_key": "sec14_s1_c0",
    "text": "清末民初发端于上海租界、盛行于二十年代前后的现代都市大众通俗文学流派。",
    "start": 524.516,
    "end": 532.048,
    "duration": 7.532
  },
  {
    "id": "sec14_s2_c0",
    "dom_key": "sec14_s2_c0",
    "text": "主要刊物有《礼拜六》等，代表作家有包天笑、徐枕亚、张恨水等。",
    "start": 533.096,
    "end": 538.908,
    "duration": 5.812
  },
  {
    "id": "sec14_s3_c0",
    "dom_key": "sec14_s3_c0",
    "text": "作品以才子佳人言情、社会黑幕与武侠侦探为核心内容，迎合市民阶层消遣娱乐心理，",
    "start": 539.916,
    "end": 548.208,
    "duration": 8.292
  },
  {
    "id": "sec14_s3_c1",
    "dom_key": "sec14_s3_c1",
    "text": "是传统通俗小说向现代商业文化转型过渡的重要文学形态。",
    "start": 548.316,
    "end": 553.328,
    "duration": 5.012
  },
  {
    "id": "sec15_title_c0",
    "dom_key": "sec15_title_c0",
    "text": "16 · 乡土小说",
    "start": 554.296,
    "end": 556.308,
    "duration": 2.012
  },
  {
    "id": "sec15_s1_c0",
    "dom_key": "sec15_s1_c0",
    "text": "二十年代兴起、并由鲁迅在一九三五年《中国新文学大系》中概括总结的一个现代小说重要流派。",
    "start": 556.799,
    "end": 565.771,
    "duration": 8.972
  },
  {
    "id": "sec15_s2_c0",
    "dom_key": "sec15_s2_c0",
    "text": "主要代表作家为鲁彦、台静农、彭家煌等远离故土的游子。",
    "start": 566.779,
    "end": 573.311,
    "duration": 6.532
  },
  {
    "id": "sec15_s3_c0",
    "dom_key": "sec15_s3_c0",
    "text": "作家身处异乡都市，以悲悯而冷峻的现代启蒙眼光回望闭塞的原乡，",
    "start": 574.279,
    "end": 581.251,
    "duration": 6.972
  },
  {
    "id": "sec15_s3_c1",
    "dom_key": "sec15_s3_c1",
    "text": "深情描摹乡土风俗与国民劣根性，形成了写实批判与怀乡感伤交织的独特审美风貌。",
    "start": 581.679,
    "end": 589.531,
    "duration": 7.852
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "当代流派重分清“先后演进与区别”：伤痕→反思→寻根/改革→先锋/新写实；",
    "start": 590.579,
    "end": 599.031,
    "duration": 8.452
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "朦胧诗→第三代→打工诗，考场绝不张冠李戴。",
    "start": 600.039,
    "end": 604.171,
    "duration": 4.132
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 按时间轴串出新时期诗歌三代嬗变：朦胧诗（《回答》）→第三代（“反崇高”）→打工诗歌（郑小琼）？",
    "start": 605.179,
    "end": 616.671,
    "duration": 11.492
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 对比伤痕文学与反思文学的深度差异，再辨寻根（文化哲学）与新写实（“毛茸茸的原生态”）？",
    "start": 617.719,
    "end": 626.731,
    "duration": 9.012
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 说清陈独秀《文学革命论》的“三大主义”、汪曾祺《受戒》的美学坐标，以及2026最新真题“打工诗歌”？",
    "start": 627.699,
    "end": 637.631,
    "duration": 9.932
  }
]