[
  {
    "id": 1,
    "text": "二十年代中后期，针对五四早期新诗过度散文化、缺乏节制与形式粗糙的“非诗化”倾向，",
    "start": 0.121,
    "end": 8.026,
    "duration": 7.905
  },
  {
    "id": 2,
    "text": "闻一多、徐志摩等新月派诗人发起了著名的现代新诗格律化运动。",
    "start": 8.415,
    "end": 13.475,
    "duration": 5.06
  },
  {
    "id": 3,
    "text": "闻一多在《诗的格律》中系统提出了“戴着脚镣跳舞”的艺术命题，",
    "start": 13.956,
    "end": 18.437,
    "duration": 4.481
  },
  {
    "id": 4,
    "text": "其核心的“三美”理论与美学贡献主要体现于以下三个方面：",
    "start": 18.674,
    "end": 23.081,
    "duration": 4.407
  },
  {
    "id": 5,
    "text": "第一，倡导“音乐的美”，强调音尺节拍与韵律的内在和谐。",
    "start": 23.686,
    "end": 28.475,
    "duration": 4.789
  },
  {
    "id": 6,
    "text": "闻一多认为新诗必须具备听觉上的音乐感，但绝不复古旧体格律，",
    "start": 28.992,
    "end": 34.011,
    "duration": 5.019
  },
  {
    "id": 7,
    "text": "而是根据现代汉语语音特征，以“音尺”（步）的均齐来规范诗行，",
    "start": 34.406,
    "end": 39.425,
    "duration": 5.019
  },
  {
    "id": 8,
    "text": "做到字数不必完全相同，但每行的音尺数量大致相等、停顿自然、押韵严谨。",
    "start": 39.656,
    "end": 45.891,
    "duration": 6.235
  },
  {
    "id": 9,
    "text": "在名篇《死水》中，全诗每行均为四个音尺，平仄相互交错，",
    "start": 46.091,
    "end": 51.053,
    "duration": 4.962
  },
  {
    "id": 10,
    "text": "韵脚回环咬合，赋予全篇如古钟般庄重凝炼、沉郁顿挫的内在声律。",
    "start": 51.333,
    "end": 56.857,
    "duration": 5.524
  },
  {
    "id": 11,
    "text": "第二，追求“绘画的美”，强化意象色彩与辞藻的造型张力。",
    "start": 57.514,
    "end": 62.412,
    "duration": 4.898
  },
  {
    "id": 12,
    "text": "新月派主张诗歌应当借鉴绘画的造型原则，注重词藻的视觉修饰与色彩对比。",
    "start": 62.916,
    "end": 68.94,
    "duration": 6.024
  },
  {
    "id": 13,
    "text": "在《死水》中，诗人将一沟绝望的死水化作视觉奇观，",
    "start": 69.415,
    "end": 73.271,
    "duration": 3.856
  },
  {
    "id": 14,
    "text": "运用“翡翠、桃花、罗绮、云霞”等明艳华丽的色彩词，",
    "start": 73.725,
    "end": 78.362,
    "duration": 4.637
  },
  {
    "id": 15,
    "text": "与“剩菜残羹、绿酒、白沫”等污秽物象形成强烈视觉反差，",
    "start": 78.641,
    "end": 83.636,
    "duration": 4.995
  },
  {
    "id": 16,
    "text": "在审丑与审美的剧烈冲突中，达到了极高境界的绘画造型美。",
    "start": 84.157,
    "end": 88.722,
    "duration": 4.565
  },
  {
    "id": 17,
    "text": "第三，构筑“建筑的美”，确立节的匀称与句的均齐规范。",
    "start": 89.322,
    "end": 93.52,
    "duration": 4.198
  },
  {
    "id": 18,
    "text": "闻一多强调诗的视觉排版必须具备建筑般的对称稳固感，要求“节的匀称”与“句的齐整”。",
    "start": 93.66,
    "end": 100.804,
    "duration": 7.144
  },
  {
    "id": 19,
    "text": "徐志摩在《再别康桥》中深得其精髓，全诗共七节，每节四行，",
    "start": 100.946,
    "end": 105.832,
    "duration": 4.886
  },
  {
    "id": 20,
    "text": "诗行参差中保持大体匀称，如流线型建筑般轻灵流动；",
    "start": 106.026,
    "end": 110.315,
    "duration": 4.289
  },
  {
    "id": 21,
    "text": "新月派通过“三美”理论的深层建构，",
    "start": 110.598,
    "end": 113.194,
    "duration": 2.596
  },
  {
    "id": 22,
    "text": "有力纠正了早期白话诗信马由缰的散漫弊端，为中国新诗确立了现代形式规范。",
    "start": 113.598,
    "end": 120.361,
    "duration": 6.763
  }
]