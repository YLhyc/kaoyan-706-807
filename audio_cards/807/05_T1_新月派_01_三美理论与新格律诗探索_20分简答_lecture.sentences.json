[
  {
    "id": 1,
    "text": "二十年代中后期，针对五四早期新诗过度散文化、",
    "start": 0.105,
    "end": 4.048,
    "duration": 3.943
  },
  {
    "id": 2,
    "text": "缺乏节制与形式粗糙的“非诗化”倾向，闻一多、",
    "start": 4.362,
    "end": 8.589,
    "duration": 4.227
  },
  {
    "id": 3,
    "text": "徐志摩等新月派诗人发起了著名的现代新诗格律化运动。",
    "start": 8.589,
    "end": 13.286,
    "duration": 4.697
  },
  {
    "id": 4,
    "text": "闻一多在《诗的格律》中系统提出了“戴着脚镣跳舞”的艺术命题，",
    "start": 13.835,
    "end": 18.628,
    "duration": 4.793
  },
  {
    "id": 5,
    "text": "其核心的“三美”理论与美学贡献主要体现于以下三个方面：",
    "start": 19.054,
    "end": 23.553,
    "duration": 4.499
  },
  {
    "id": 6,
    "text": "第一，倡导“音乐的美”，强调音尺节拍与韵律的内在和谐。",
    "start": 23.774,
    "end": 28.874,
    "duration": 5.1
  },
  {
    "id": 7,
    "text": "闻一多认为新诗必须具备听觉上的音乐感，",
    "start": 29.411,
    "end": 32.472,
    "duration": 3.061
  },
  {
    "id": 8,
    "text": "但绝非复古旧体格律，而是根据现代汉语语音特征，",
    "start": 32.807,
    "end": 37.239,
    "duration": 4.432
  },
  {
    "id": 9,
    "text": "以“音尺”（步）的均齐来规范诗行，做到字数不必完全相同，",
    "start": 37.496,
    "end": 42.335,
    "duration": 4.839
  },
  {
    "id": 10,
    "text": "但每行的音尺数量大致相等、停顿自然、押韵严谨。",
    "start": 42.386,
    "end": 46.785,
    "duration": 4.399
  },
  {
    "id": 11,
    "text": "在名篇《死水》中，全诗每行均为四个音尺，平仄相互交错，",
    "start": 46.989,
    "end": 52.209,
    "duration": 5.22
  },
  {
    "id": 12,
    "text": "韵脚回环咬合，赋予全篇一种如古钟般庄重凝炼、",
    "start": 52.402,
    "end": 57.187,
    "duration": 4.785
  },
  {
    "id": 13,
    "text": "沉郁顿挫的内在音乐声律。",
    "start": 57.461,
    "end": 59.731,
    "duration": 2.27
  },
  {
    "id": 14,
    "text": "第二，追求“绘画的美”，强化意象色彩与辞藻的造型张力。",
    "start": 59.974,
    "end": 65.058,
    "duration": 5.084
  },
  {
    "id": 15,
    "text": "新月派主张诗歌应当借鉴绘画的造型原则，",
    "start": 65.538,
    "end": 68.867,
    "duration": 3.329
  },
  {
    "id": 16,
    "text": "注重词藻的视觉修饰与色彩对比。",
    "start": 69.229,
    "end": 71.917,
    "duration": 2.688
  },
  {
    "id": 17,
    "text": "在《死水》中，诗人将一沟绝望的死水化作视觉奇观，",
    "start": 72.108,
    "end": 76.265,
    "duration": 4.157
  },
  {
    "id": 18,
    "text": "运用“翡翠、桃花、罗绮、云霞”等极其明艳华丽的色彩词，",
    "start": 76.265,
    "end": 81.339,
    "duration": 5.074
  },
  {
    "id": 19,
    "text": "与“剩菜残羹、绿酒、白沫”等污秽物象形成强烈视觉反差，",
    "start": 81.41,
    "end": 86.337,
    "duration": 4.927
  },
  {
    "id": 20,
    "text": "在审丑与审美的极致张力中，达到了极高境界的绘画造型美。",
    "start": 86.488,
    "end": 91.773,
    "duration": 5.285
  },
  {
    "id": 21,
    "text": "第三，构筑“建筑的美”，确立节的匀称与句的均齐规范。",
    "start": 92.079,
    "end": 96.627,
    "duration": 4.548
  },
  {
    "id": 22,
    "text": "闻一多强调诗的视觉排版必须具备建筑般的对称稳固感，",
    "start": 96.94,
    "end": 101.224,
    "duration": 4.284
  },
  {
    "id": 23,
    "text": "要求“节的匀称”与“句的齐整”。",
    "start": 101.433,
    "end": 103.696,
    "duration": 2.263
  },
  {
    "id": 24,
    "text": "徐志摩在《再别康桥》中深得其精髓，全诗共七节，每节四行，",
    "start": 103.98,
    "end": 109.05,
    "duration": 5.07
  },
  {
    "id": 25,
    "text": "诗行参差中保持大体匀称，如流线型建筑般轻灵流动；",
    "start": 109.26,
    "end": 113.946,
    "duration": 4.686
  },
  {
    "id": 26,
    "text": "新月派通过“三美”理论的深层建构，",
    "start": 114.172,
    "end": 116.967,
    "duration": 2.795
  },
  {
    "id": 27,
    "text": "彻底纠正了早期白话诗信马由缰的散漫弊端，",
    "start": 117.218,
    "end": 121.078,
    "duration": 3.86
  },
  {
    "id": 28,
    "text": "为中国新诗确立了现代形式规范。",
    "start": 121.299,
    "end": 124.296,
    "duration": 2.997
  }
]
