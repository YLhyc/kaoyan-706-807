[
  {
    "id": 1,
    "text": "二十年代中后期，针对五四早期新诗过度散文化、",
    "start": 0.05,
    "end": 4.377,
    "duration": 4.327
  },
  {
    "id": 2,
    "text": "缺乏节制与形式粗糙的“非诗化”倾向，闻一多、",
    "start": 4.377,
    "end": 8.267,
    "duration": 3.89
  },
  {
    "id": 3,
    "text": "徐志摩等新月派诗人发起了著名的现代新诗格律化运动。",
    "start": 8.267,
    "end": 13.845,
    "duration": 5.578
  },
  {
    "id": 4,
    "text": "闻一多在《诗的格律》中系统提出了“戴着脚镣跳舞”的艺术命题，",
    "start": 13.845,
    "end": 19.065,
    "duration": 5.22
  },
  {
    "id": 5,
    "text": "其核心的“三美”理论与美学贡献主要体现于以下三个方面：",
    "start": 19.065,
    "end": 24.503,
    "duration": 5.438
  },
  {
    "id": 6,
    "text": "第一，倡导“音乐的美”，强调音尺节拍与韵律的内在和谐。",
    "start": 24.503,
    "end": 29.421,
    "duration": 4.918
  },
  {
    "id": 7,
    "text": "闻一多认为新诗必须具备听觉上的音乐感，",
    "start": 29.421,
    "end": 32.817,
    "duration": 3.396
  },
  {
    "id": 8,
    "text": "但绝非复古旧体格律，而是根据现代汉语语音特征，",
    "start": 32.817,
    "end": 37.51,
    "duration": 4.693
  },
  {
    "id": 9,
    "text": "以“音尺”（步）的均齐来规范诗行，做到字数不必完全相同，",
    "start": 37.51,
    "end": 42.564,
    "duration": 5.054
  },
  {
    "id": 10,
    "text": "但每行的音尺数量大致相等、停顿自然、押韵严谨。",
    "start": 42.564,
    "end": 46.999,
    "duration": 4.435
  },
  {
    "id": 11,
    "text": "在名篇《死水》中，全诗每行均为四个音尺，平仄相互交错，",
    "start": 46.999,
    "end": 52.413,
    "duration": 5.414
  },
  {
    "id": 12,
    "text": "韵脚回环咬合，赋予全篇一种如古钟般庄重凝炼、",
    "start": 52.413,
    "end": 57.471,
    "duration": 5.058
  },
  {
    "id": 13,
    "text": "沉郁顿挫的内在音乐声律。",
    "start": 57.471,
    "end": 59.984,
    "duration": 2.513
  },
  {
    "id": 14,
    "text": "第二，追求“绘画的美”，强化意象色彩与辞藻的造型张力。",
    "start": 59.984,
    "end": 65.551,
    "duration": 5.567
  },
  {
    "id": 15,
    "text": "新月派主张诗歌应当借鉴绘画的造型原则，",
    "start": 65.551,
    "end": 69.239,
    "duration": 3.688
  },
  {
    "id": 16,
    "text": "注重词藻的视觉修饰与色彩对比。",
    "start": 69.239,
    "end": 72.118,
    "duration": 2.879
  },
  {
    "id": 17,
    "text": "在《死水》中，诗人将一沟绝望的死水化作视觉奇观，",
    "start": 72.118,
    "end": 76.874,
    "duration": 4.756
  },
  {
    "id": 18,
    "text": "运用“翡翠、桃花、罗绮、云霞”等极其明艳华丽的色彩词，",
    "start": 76.874,
    "end": 81.609,
    "duration": 4.735
  },
  {
    "id": 19,
    "text": "与“剩菜残羹、绿酒、白沫”等污秽物象形成强烈视觉反差，",
    "start": 81.609,
    "end": 86.591,
    "duration": 4.982
  },
  {
    "id": 20,
    "text": "在审丑与审美的极致张力中，达到了极高境界的绘画造型美。",
    "start": 86.591,
    "end": 91.389,
    "duration": 4.798
  },
  {
    "id": 21,
    "text": "第三，构筑“建筑的美”，确立节的匀称与句的均齐规范。",
    "start": 91.389,
    "end": 96.95,
    "duration": 5.561
  },
  {
    "id": 22,
    "text": "闻一多强调诗的视觉排版必须具备建筑般的对称稳固感，",
    "start": 96.95,
    "end": 101.447,
    "duration": 4.497
  },
  {
    "id": 23,
    "text": "要求“节的匀称”与“句的齐整”。",
    "start": 101.447,
    "end": 103.993,
    "duration": 2.546
  },
  {
    "id": 24,
    "text": "徐志摩在《再别康桥》中深得其精髓，全诗共七节，每节四行，",
    "start": 103.993,
    "end": 109.274,
    "duration": 5.281
  },
  {
    "id": 25,
    "text": "诗行参差中保持大体匀称，如流线型建筑般轻灵流动；",
    "start": 109.274,
    "end": 114.187,
    "duration": 4.913
  },
  {
    "id": 26,
    "text": "新月派通过“三美”理论的深层建构，",
    "start": 114.187,
    "end": 117.228,
    "duration": 3.041
  },
  {
    "id": 27,
    "text": "彻底纠正了早期白话诗信马由缰的散漫弊端，",
    "start": 117.228,
    "end": 121.309,
    "duration": 4.081
  },
  {
    "id": 28,
    "text": "为中国新诗确立了现代形式规范。",
    "start": 121.309,
    "end": 124.296,
    "duration": 2.987
  }
]