[
  {
    "id": 1,
    "text": "二十年代中后期，针对五四早期新诗过度散文化、",
    "start": 0.121,
    "end": 4.407,
    "duration": 4.286
  },
  {
    "id": 2,
    "text": "缺乏节制与形式粗糙的“非诗化”倾向，闻一多、",
    "start": 4.751,
    "end": 8.901,
    "duration": 4.15
  },
  {
    "id": 3,
    "text": "徐志摩等新月派诗人发起了著名的现代新诗格律化运动。",
    "start": 9.268,
    "end": 13.465,
    "duration": 4.197
  },
  {
    "id": 4,
    "text": "闻一多在《诗的格律》中系统提出了“戴着脚镣跳舞”的艺术命题，",
    "start": 13.956,
    "end": 18.427,
    "duration": 4.471
  },
  {
    "id": 5,
    "text": "其核心的“三美”理论与美学贡献主要体现于以下三个方面：",
    "start": 18.674,
    "end": 23.071,
    "duration": 4.397
  },
  {
    "id": 6,
    "text": "第一，倡导“音乐的美”，强调音尺节拍与韵律的内在和谐。",
    "start": 23.686,
    "end": 28.465,
    "duration": 4.779
  },
  {
    "id": 7,
    "text": "闻一多认为新诗必须具备听觉上的音乐感，",
    "start": 28.992,
    "end": 32.01,
    "duration": 3.018
  },
  {
    "id": 8,
    "text": "但绝不复古旧体格律，而是根据现代汉语语音特征，",
    "start": 32.373,
    "end": 36.41,
    "duration": 4.037
  },
  {
    "id": 9,
    "text": "以“音尺”（步）的均齐来规范诗行，做到字数不必完全相同，",
    "start": 36.727,
    "end": 41.598,
    "duration": 4.871
  },
  {
    "id": 10,
    "text": "但每行的音尺数量大致相等、停顿自然、押韵严谨。",
    "start": 41.852,
    "end": 45.881,
    "duration": 4.029
  },
  {
    "id": 11,
    "text": "在名篇《死水》中，全诗每行均为四个音尺，平仄相互交错，",
    "start": 46.091,
    "end": 51.043,
    "duration": 4.952
  },
  {
    "id": 12,
    "text": "韵脚回环咬合，赋予全篇如古钟般庄重凝炼、",
    "start": 51.333,
    "end": 55.315,
    "duration": 3.982
  },
  {
    "id": 13,
    "text": "沉郁顿挫的内在声律。",
    "start": 55.454,
    "end": 56.847,
    "duration": 1.393
  },
  {
    "id": 14,
    "text": "第二，追求“绘画的美”，强化意象色彩与辞藻的造型张力。",
    "start": 57.514,
    "end": 62.402,
    "duration": 4.888
  },
  {
    "id": 15,
    "text": "新月派主张诗歌应当借鉴绘画的造型原则，",
    "start": 62.916,
    "end": 66.202,
    "duration": 3.286
  },
  {
    "id": 16,
    "text": "注重词藻的视觉修饰与色彩对比。",
    "start": 66.474,
    "end": 68.93,
    "duration": 2.456
  },
  {
    "id": 17,
    "text": "在《死水》中，诗人将一沟绝望的死水化作视觉奇观，",
    "start": 69.415,
    "end": 73.261,
    "duration": 3.846
  },
  {
    "id": 18,
    "text": "运用“翡翠、桃花、罗绮、云霞”等明艳华丽的色彩词，",
    "start": 73.725,
    "end": 78.352,
    "duration": 4.627
  },
  {
    "id": 19,
    "text": "与“剩菜残羹、绿酒、白沫”等污秽物象形成强烈视觉反差，",
    "start": 78.641,
    "end": 83.63,
    "duration": 4.989
  },
  {
    "id": 20,
    "text": "在审丑与审美的剧烈冲突中，达到了极高境界的绘画造型美。",
    "start": 84.157,
    "end": 88.712,
    "duration": 4.555
  },
  {
    "id": 21,
    "text": "第三，构筑“建筑的美”，确立节的匀称与句的均齐规范。",
    "start": 89.322,
    "end": 93.51,
    "duration": 4.188
  },
  {
    "id": 22,
    "text": "闻一多强调诗的视觉排版必须具备建筑般的对称稳固感，",
    "start": 93.66,
    "end": 98.249,
    "duration": 4.589
  },
  {
    "id": 23,
    "text": "要求“节的匀称”与“句的齐整”。",
    "start": 98.399,
    "end": 100.795,
    "duration": 2.396
  },
  {
    "id": 24,
    "text": "徐志摩在《再别康桥》中深得其精髓，全诗共七节，每节四行，",
    "start": 100.946,
    "end": 105.822,
    "duration": 4.876
  },
  {
    "id": 25,
    "text": "诗行参差中保持大体匀称，如流线型建筑般轻灵流动；",
    "start": 106.026,
    "end": 110.305,
    "duration": 4.279
  },
  {
    "id": 26,
    "text": "新月派通过“三美”理论的深层建构，",
    "start": 110.598,
    "end": 113.184,
    "duration": 2.586
  },
  {
    "id": 27,
    "text": "有力纠正了早期白话诗信马由缰的散漫弊端，",
    "start": 113.598,
    "end": 117.433,
    "duration": 3.835
  },
  {
    "id": 28,
    "text": "为中国新诗确立了现代形式规范。",
    "start": 117.795,
    "end": 120.361,
    "duration": 2.566
  }
]