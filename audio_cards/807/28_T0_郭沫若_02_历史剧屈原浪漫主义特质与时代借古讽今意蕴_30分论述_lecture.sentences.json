[
  {
    "id": 1,
    "text": "本题是 807 专业课中关于郭沫若历史剧的最高核心大题，分值为 30 分。",
    "start": 0.1,
    "end": 6.821,
    "duration": 6.721
  },
  {
    "id": 2,
    "text": "考查的核心目的，是要求考生系统论述郭沫若抗战时期历史剧《屈原》的本体特质，回答其如何将战国历史转化为战时抗争武器，以及浪漫主义诗剧合一的文体创新何以成立。",
    "start": 6.771,
    "end": 22.123,
    "duration": 15.352
  },
  {
    "id": 3,
    "text": "回答这道题绝不能将其答成普通的历史剧故事情节复述。",
    "start": 22.122,
    "end": 27.434,
    "duration": 5.312
  },
  {
    "id": 4,
    "text": "必须紧扣钱理群《三十年》教材的核心理论脉络，从“历史哲学原则与借古讽今政治指向（失事求似）”，“崇高浪漫主义人物塑造（屈原与群像对照）”，“戏剧高潮独白美学（雷电颂诗剧合一）”以及“战时剧场动员与历史剧范式确立”四大递进维度展开深入剖析。",
    "start": 27.434,
    "end": 49.54,
    "duration": 22.106
  },
  {
    "id": 5,
    "text": "全篇确立四个核心论述维度，",
    "start": 49.54,
    "end": 52.483,
    "duration": 2.943
  },
  {
    "id": 6,
    "text": "第一是“失事求似”美学原则与大后方借古讽今的现实批判意蕴。",
    "start": 52.483,
    "end": 58.069,
    "duration": 5.586
  },
  {
    "id": 7,
    "text": "第二是崇高浪漫主义英雄人格塑造（屈原，婵娟殉道与宋玉变节的对比）。",
    "start": 58.069,
    "end": 64.996,
    "duration": 6.927
  },
  {
    "id": 8,
    "text": "第三是第五幕《雷电颂》的独白美学与天人合一象征机制（诗剧交融巅峰）。",
    "start": 64.996,
    "end": 71.519,
    "duration": 6.523
  },
  {
    "id": 9,
    "text": "第四是战时公共剧场动员机制与中国现代浪漫主义历史剧范式的确立。",
    "start": 71.519,
    "end": 77.925,
    "duration": 6.406
  },
  {
    "id": 10,
    "text": "这四个维度遵循着由创作动机与政治哲学，到舞台行动主体，到戏剧审美最高潮，再到剧场接受与文学史价值的严密推演链条。",
    "start": 77.926,
    "end": 90.035,
    "duration": 12.109
  },
  {
    "id": 11,
    "text": "失事求似原则解决了历史与现实的政治隐喻机制；",
    "start": 90.035,
    "end": 94.762,
    "duration": 4.727
  },
  {
    "id": 12,
    "text": "英雄人格塑造确立了全剧的核心行动者与崇高审美基调；",
    "start": 94.761,
    "end": 100.425,
    "duration": 5.664
  },
  {
    "id": 13,
    "text": "雷电颂独白落脚在全剧最震撼人心的诗剧合一本体形式；",
    "start": 100.426,
    "end": 106.364,
    "duration": 5.938
  },
  {
    "id": 14,
    "text": "战时动员与范式确立则升华了全剧在现代文学史与戏剧史上的客观历史贡献。",
    "start": 106.363,
    "end": 113.746,
    "duration": 7.383
  },
  {
    "id": 15,
    "text": "四者步步递进，逻辑闭环浑然一体。",
    "start": 113.746,
    "end": 117.353,
    "duration": 3.607
  },
  {
    "id": 16,
    "text": "抗日战争相持阶段，郭沫若创作的五幕历史剧《屈原》，是中国现代话剧史与历史剧创作无可逾越的里程碑。",
    "start": 117.353,
    "end": 126.832,
    "duration": 9.479
  },
  {
    "id": 17,
    "text": "作品诞生于大后方“皖南事变”后的白色恐怖与政治阴云之中，作者将深沉的历史意识与炽烈的时代现实感融为一体，创造性地践行了“失事求似”的历史剧美学原则。",
    "start": 126.832,
    "end": 141.012,
    "duration": 14.18
  },
  {
    "id": 18,
    "text": "剧作不仅塑造了中国现代文学史上最具崇高感与殉道精神的悲剧英雄典型，更以诗剧交融的浪漫主义形式，完成了战时民族民主抗争的宏大精神动员。",
    "start": 141.011,
    "end": 154.501,
    "duration": 13.49
  },
  {
    "id": 19,
    "text": "其思想意蕴与艺术成就主要体现在以下四个核心维度，",
    "start": 154.501,
    "end": 159.8,
    "duration": 5.299
  },
  {
    "id": 20,
    "text": "直接切入抗战相持阶段与皖南事变政治语境，点明“失事求似”原则与浪漫主义里程碑地位，统领四大论证维度。",
    "start": 159.801,
    "end": 170.087,
    "duration": 10.286
  },
  {
    "id": 21,
    "text": "第一，践行“失事求似”美学原则，构筑借古讽今的现实批判政治锋芒。",
    "start": 170.087,
    "end": 176.623,
    "duration": 6.536
  },
  {
    "id": 22,
    "text": "加粗动宾立桩，解析“失事求似”哲学内涵，调取南后郑袖，张仪与楚怀王直接影射国民党消极抗日，同室操戈的政治现实。",
    "start": 176.623,
    "end": 188.212,
    "duration": 11.589
  },
  {
    "id": 23,
    "text": "第二，承续早期浪漫主义狂飙精神，塑造崇高刚烈的悲剧英雄人格。",
    "start": 188.212,
    "end": 194.775,
    "duration": 6.563
  },
  {
    "id": 24,
    "text": "加粗动宾立桩，比较曹禺现实主义，调取屈原顶天立地人格，并以婵娟饮鸩殉道与宋玉变节构筑正反三位一体对照。",
    "start": 194.774,
    "end": 205.855,
    "duration": 11.081
  },
  {
    "id": 25,
    "text": "第三，熔铸第五幕《雷电颂》抒情独白，确立诗剧合一的戏剧美学高峰。",
    "start": 205.855,
    "end": 212.548,
    "duration": 6.693
  },
  {
    "id": 26,
    "text": "加粗动宾立桩，调取东皇太一庙电闪雷鸣，呼唤“风咆哮”，炸裂泥胎偶像名场面，解析长篇抒情独白打破写实戏剧规约，确立诗剧典范的机制。",
    "start": 212.548,
    "end": 225.855,
    "duration": 13.307
  },
  {
    "id": 27,
    "text": "第四，激活战时剧场动员机制，确立中国现代浪漫主义历史剧的经典范式。",
    "start": 225.855,
    "end": 232.782,
    "duration": 6.927
  },
  {
    "id": 28,
    "text": "加粗动宾立桩，调取重庆国泰大戏院首演引起全民族共振的剧场效应，升华浪漫主义历史剧范式贡献。",
    "start": 232.782,
    "end": 242.613,
    "duration": 9.831
  },
  {
    "id": 29,
    "text": "综上所述，郭沫若历史剧《屈原》以借古讽今的历史理性，崇高炽烈的英雄品格与诗剧交融的美学建构，开辟了中国现代话剧的抒情诗化道路，成为中国现代历史剧史上不可逾越的经典丰碑。",
    "start": 242.613,
    "end": 259.119,
    "duration": 16.506
  },
  {
    "id": 30,
    "text": "以历史理性，英雄品格与诗剧交融三位一体收束，升华经典丰碑定评。",
    "start": 259.119,
    "end": 265.994,
    "duration": 6.875
  }
]