[
  {
    "id": 1,
    "text": "试论郭沫若历史剧《屈原》的浪漫主义特质与时代借古讽今意蕴。",
    "start": 0.086,
    "end": 5.756,
    "duration": 5.67
  },
  {
    "id": 2,
    "text": "抗日战争相持阶段，郭沫若创作的五幕历史剧《屈原》，",
    "start": 6.453,
    "end": 10.907,
    "duration": 4.454
  },
  {
    "id": 3,
    "text": "是中国现代话剧史与历史剧创作无可逾越的里程碑。",
    "start": 11.23,
    "end": 15.759,
    "duration": 4.529
  },
  {
    "id": 4,
    "text": "作品诞生于大后方“皖南事变”后的白色恐怖与政治阴云之中，",
    "start": 16.214,
    "end": 21.479,
    "duration": 5.265
  },
  {
    "id": 5,
    "text": "作者将深沉的历史意识与炽烈的时代现实感融为一体，",
    "start": 21.899,
    "end": 26.405,
    "duration": 4.506
  },
  {
    "id": 6,
    "text": "创造性地践行了“失事求似”的历史剧美学原则。",
    "start": 26.836,
    "end": 30.974,
    "duration": 4.138
  },
  {
    "id": 7,
    "text": "剧作不仅塑造了中国现代文学史上最具崇高感与殉道精神的悲剧英雄典型，",
    "start": 31.218,
    "end": 37.368,
    "duration": 6.15
  },
  {
    "id": 8,
    "text": "更以诗剧交融的浪漫主义形式，",
    "start": 37.629,
    "end": 39.741,
    "duration": 2.112
  },
  {
    "id": 9,
    "text": "完成了战时民族民主抗争的宏大精神动员。",
    "start": 39.964,
    "end": 43.258,
    "duration": 3.294
  },
  {
    "id": 10,
    "text": "其思想意蕴与艺术成就主要体现在以下四个核心维度：",
    "start": 43.451,
    "end": 47.519,
    "duration": 4.068
  },
  {
    "id": 11,
    "text": "第一，践行“失事求似”美学原则，",
    "start": 47.769,
    "end": 50.456,
    "duration": 2.687
  },
  {
    "id": 12,
    "text": "构筑借古讽今的现实批判政治锋芒。",
    "start": 50.684,
    "end": 53.538,
    "duration": 2.854
  },
  {
    "id": 13,
    "text": "郭沫若明确主张历史剧创作的核心在于把握历史精神，",
    "start": 53.779,
    "end": 57.645,
    "duration": 3.866
  },
  {
    "id": 14,
    "text": "而非拘泥于历史事实的琐碎考据，提出作家应当“失事求似”，",
    "start": 57.978,
    "end": 62.939,
    "duration": 4.961
  },
  {
    "id": 15,
    "text": "即允许在非核心史实上进行大胆的艺术虚构，",
    "start": 62.939,
    "end": 66.416,
    "duration": 3.477
  },
  {
    "id": 16,
    "text": "以深刻开掘历史发展之内在本质。",
    "start": 66.456,
    "end": 68.806,
    "duration": 2.35
  },
  {
    "id": 17,
    "text": "全剧表面上取材于战国时期楚国屈原坚持联齐抗秦路线、",
    "start": 68.923,
    "end": 73.528,
    "duration": 4.605
  },
  {
    "id": 18,
    "text": "遭南后郑袖与奸相靳尚诬陷放逐的生死博弈，",
    "start": 73.635,
    "end": 77.215,
    "duration": 3.58
  },
  {
    "id": 19,
    "text": "实质上通篇充满对战时重庆国民党反动政权的严正借古讽今；",
    "start": 77.379,
    "end": 82.364,
    "duration": 4.985
  },
  {
    "id": 20,
    "text": "剧中华美阴鸷的南后、",
    "start": 82.568,
    "end": 84.284,
    "duration": 1.716
  },
  {
    "id": 21,
    "text": "出卖国家利益的张仪与昏聩专断的楚怀王，",
    "start": 84.284,
    "end": 87.547,
    "duration": 3.263
  },
  {
    "id": 22,
    "text": "直接影射国民党统治集团消极抗日、积极反共、",
    "start": 87.811,
    "end": 91.339,
    "duration": 3.528
  },
  {
    "id": 23,
    "text": "制造同室操戈的丑态。",
    "start": 91.376,
    "end": 93.038,
    "duration": 1.662
  },
  {
    "id": 24,
    "text": "郭沫若借历史之壳装载现实政治批判烈火，",
    "start": 93.134,
    "end": 96.351,
    "duration": 3.217
  },
  {
    "id": 25,
    "text": "赋予古典历史以激越的时代战斗品格。",
    "start": 96.639,
    "end": 99.561,
    "duration": 2.922
  },
  {
    "id": 26,
    "text": "第二，承续早期浪漫主义狂飙精神，塑造崇高刚烈的悲剧英雄人格。",
    "start": 99.714,
    "end": 105.085,
    "duration": 5.371
  },
  {
    "id": 27,
    "text": "迥异于曹禺写实戏剧对家庭伦理与深微心理的冷静解剖，",
    "start": 105.298,
    "end": 110.505,
    "duration": 5.207
  },
  {
    "id": 28,
    "text": "郭沫若将早期诗集《女神》中喷薄奔涌的主体激情全面注入戏剧创作。",
    "start": 111.156,
    "end": 117.333,
    "duration": 6.177
  },
  {
    "id": 29,
    "text": "剧中的屈原脱离了传统史传中哀怨悱恻的失意文人形象，",
    "start": 118.123,
    "end": 123.052,
    "duration": 4.929
  },
  {
    "id": 30,
    "text": "被重塑为一位大义凛然、",
    "start": 123.3,
    "end": 125.098,
    "duration": 1.798
  },
  {
    "id": 31,
    "text": "坚守政治理想与民族气节的崇高悲剧英雄。",
    "start": 125.186,
    "end": 128.932,
    "duration": 3.746
  },
  {
    "id": 32,
    "text": "他面对靳尚的诬陷、楚怀王的放逐以及群小的威逼利诱，",
    "start": 129.133,
    "end": 133.661,
    "duration": 4.528
  },
  {
    "id": 33,
    "text": "始终保持独立不羁的人格傲骨；婵娟与宋玉的虚构对照，",
    "start": 133.719,
    "end": 138.215,
    "duration": 4.496
  },
  {
    "id": 34,
    "text": "进一步强化了这一审美崇高感：婵娟以身殉道为屈原饮下鸩酒，",
    "start": 138.435,
    "end": 143.159,
    "duration": 4.724
  },
  {
    "id": 35,
    "text": "衬托出真理殉道者的冰清玉洁；",
    "start": 143.283,
    "end": 146.141,
    "duration": 2.858
  },
  {
    "id": 36,
    "text": "宋玉由崇拜屈原堕落为依附权贵弄臣，",
    "start": 146.242,
    "end": 149.392,
    "duration": 3.15
  },
  {
    "id": 37,
    "text": "反衬出屈原横眉冷对千夫指的人格伟力。",
    "start": 149.516,
    "end": 152.986,
    "duration": 3.47
  },
  {
    "id": 38,
    "text": "第三，熔铸第五幕《雷电颂》抒情独白，",
    "start": 153.259,
    "end": 156.412,
    "duration": 3.153
  },
  {
    "id": 39,
    "text": "确立诗剧合一的戏剧美学高峰。",
    "start": 156.768,
    "end": 158.991,
    "duration": 2.223
  },
  {
    "id": 40,
    "text": "全剧在第五幕达到戏剧冲突与诗性审美的顶峰。",
    "start": 159.58,
    "end": 163.37,
    "duration": 3.79
  },
  {
    "id": 41,
    "text": "屈原被囚禁于东皇太一庙中，面对无边的沉沉黑夜与漫天风暴，",
    "start": 163.677,
    "end": 168.864,
    "duration": 5.187
  },
  {
    "id": 42,
    "text": "迸发出惊天地泣鬼神的抒情独白《雷电颂》。",
    "start": 169.22,
    "end": 173.0,
    "duration": 3.78
  },
  {
    "id": 43,
    "text": "作者将屈原内心的悲愤抗争与宇宙自然的雷电暴风融为一体，",
    "start": 173.269,
    "end": 177.769,
    "duration": 4.5
  },
  {
    "id": 44,
    "text": "创造了天人合一的象征意象系统；屈原呼唤“风！",
    "start": 178.182,
    "end": 182.373,
    "duration": 4.191
  },
  {
    "id": 45,
    "text": "你咆哮吧！咆哮吧！",
    "start": 182.653,
    "end": 184.39,
    "duration": 1.737
  },
  {
    "id": 46,
    "text": "尽力地咆哮吧！",
    "start": 184.432,
    "end": 185.375,
    "duration": 0.943
  },
  {
    "id": 47,
    "text": "”，要求雷电撕碎一切黑暗，将东皇太一等泥胎木雕炸裂为粉碎。",
    "start": 185.752,
    "end": 190.227,
    "duration": 4.475
  },
  {
    "id": 48,
    "text": "这段长篇自由体抒情独白打破了传统写实戏剧关于生活真实与外部动作的拘囿，",
    "start": 190.726,
    "end": 196.729,
    "duration": 6.003
  },
  {
    "id": 49,
    "text": "以激越回环的排比句式，",
    "start": 197.114,
    "end": 198.973,
    "duration": 1.859
  },
  {
    "id": 50,
    "text": "将舞台戏剧动作转化为内在澎湃激情的诗意宣泄，",
    "start": 199.068,
    "end": 202.905,
    "duration": 3.837
  },
  {
    "id": 51,
    "text": "确立了中国现代抒情诗剧的最高典范。",
    "start": 203.317,
    "end": 205.872,
    "duration": 2.555
  },
  {
    "id": 52,
    "text": "第四，激活战时剧场动员机制，",
    "start": 206.067,
    "end": 208.737,
    "duration": 2.67
  },
  {
    "id": 53,
    "text": "确立中国现代浪漫主义历史剧的经典范式。",
    "start": 208.966,
    "end": 212.019,
    "duration": 3.053
  },
  {
    "id": 54,
    "text": "该剧在重庆国泰大戏院首演即引起空前轰动，",
    "start": 212.381,
    "end": 215.988,
    "duration": 3.607
  },
  {
    "id": 55,
    "text": "成为战时大后方反独裁、争民主的一面文化旗帜。",
    "start": 216.187,
    "end": 220.15,
    "duration": 3.963
  },
  {
    "id": 56,
    "text": "它摆脱了学究派考据历史剧的沉闷与说教，",
    "start": 220.413,
    "end": 223.454,
    "duration": 3.041
  },
  {
    "id": 57,
    "text": "将案头文学升华为具有强烈剧场感染力的战斗号角；",
    "start": 223.82,
    "end": 227.707,
    "duration": 3.887
  },
  {
    "id": 58,
    "text": "观众在剧场中与屈原的悲怆命运产生强烈同频共振，",
    "start": 227.91,
    "end": 232.371,
    "duration": 4.461
  },
  {
    "id": 59,
    "text": "使舞台成为凝聚全民族反抗意志的公共空间。",
    "start": 232.576,
    "end": 236.065,
    "duration": 3.489
  },
  {
    "id": 60,
    "text": "在艺术形式上，郭沫若将诗的激情、",
    "start": 236.225,
    "end": 238.944,
    "duration": 2.719
  },
  {
    "id": 61,
    "text": "史的沉思与剧的冲突浑然熔铸，",
    "start": 239.088,
    "end": 241.666,
    "duration": 2.578
  },
  {
    "id": 62,
    "text": "成功建立了独具中国作风与民族特色的现代浪漫主义历史剧范式。",
    "start": 241.741,
    "end": 246.45,
    "duration": 4.709
  },
  {
    "id": 63,
    "text": "综上所述，郭沫若历史剧《屈原》以借古讽今的历史理性、",
    "start": 246.635,
    "end": 250.911,
    "duration": 4.276
  },
  {
    "id": 64,
    "text": "崇高炽烈的英雄品格与诗剧交融的美学建构，",
    "start": 251.082,
    "end": 254.655,
    "duration": 3.573
  },
  {
    "id": 65,
    "text": "开辟了中国现代话剧的抒情诗化道路，",
    "start": 254.693,
    "end": 257.803,
    "duration": 3.11
  },
  {
    "id": 66,
    "text": "成为中国现代历史剧史上不可逾越的经典丰碑。",
    "start": 258.17,
    "end": 262.032,
    "duration": 3.862
  }
]
