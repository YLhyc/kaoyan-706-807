[
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "严格对应“身份→命运→性格→成因”四环紧扣：刚进城带乡土健壮却也带小农自私（因），",
    "start": 0.225,
    "end": 8.779,
    "duration": 8.554
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "随后经买车“三起三落”掠夺击垮生路（轨），",
    "start": 9.525,
    "end": 12.933,
    "duration": 3.408
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "小福子之死压断脊梁使之沦为市井流氓（果），最后定性“个人主义的末路鬼”（理）。",
    "start": 13.681,
    "end": 20.349,
    "duration": 6.667
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "老舍《骆驼祥子》通过车夫祥子由“人”堕落为“鬼”的轨迹，",
    "start": 21.088,
    "end": 25.201,
    "duration": 4.112
  },
  {
    "id": "intro_c1",
    "dom_key": "intro_c1",
    "text": "宣告底层劳动者依靠孤立个人奋斗改变命运的幻灭。",
    "start": 25.933,
    "end": 30.153,
    "duration": 4.22
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 身份属性：乡土美德兼小农意识的新移民",
    "start": 30.839,
    "end": 35.111,
    "duration": 4.272
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "出身破产农村，初入北平健壮、勤劳要强，寄望买辆属于自己的洋车；",
    "start": 35.923,
    "end": 41.752,
    "duration": 5.829
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "保留狭隘自私个体哲学，信奉只靠自己力气吃饭，不信任同伴亦隔绝群体。",
    "start": 42.502,
    "end": 48.786,
    "duration": 6.284
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 人生轨迹：历经“三起三落”的物质掠夺",
    "start": 49.516,
    "end": 53.245,
    "duration": 3.729
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "①苦熬三年买新车被乱兵抢走（一落）；②卖骆驼攒钱被孙侦探敲诈一空（二落）；",
    "start": 53.938,
    "end": 62.179,
    "duration": 8.241
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "③被迫娶虎妞买车，因虎妞难产死只得卖车办丧（三落），诚实谋生出路被彻底堵死。",
    "start": 62.893,
    "end": 71.157,
    "duration": 8.264
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 性格流变：从自尊要强蜕变为麻木游民",
    "start": 71.931,
    "end": 76.298,
    "duration": 4.367
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "三落之后小福子在暗娼馆自缢切断最后精神寄托；",
    "start": 77.114,
    "end": 81.412,
    "duration": 4.299
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "他从讲体面纯朴青年堕为吃喝嫖赌、偷奸耍滑、出卖同伴阮明换赏钱的市井流氓，",
    "start": 82.135,
    "end": 89.45,
    "duration": 7.315
  },
  {
    "id": "sec2_step1_c1",
    "dom_key": "sec2_step1_c1",
    "text": "显健全人性被剥蚀过程。",
    "start": 90.233,
    "end": 92.169,
    "duration": 1.936
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 悲剧成因：社会压迫、都市腐蚀与奋斗局限",
    "start": 92.894,
    "end": 97.421,
    "duration": 4.527
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "既是乱兵、孙侦探与刘四爷外部盘剥产物，亦源于畸形都市对道德的腐蚀；",
    "start": 98.174,
    "end": 104.317,
    "duration": 6.142
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "老舍结尾定性“个人主义的末路鬼”，揭示脱离集体抗争终归失败。",
    "start": 105.053,
    "end": 110.259,
    "duration": 5.206
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "祥子的悲剧是淳朴劳动者在旧社会压迫下走向精神毁灭的写照，",
    "start": 111.014,
    "end": 116.423,
    "duration": 5.409
  },
  {
    "id": "concl_c1",
    "dom_key": "concl_c1",
    "text": "蕴含老舍对底层平民命运的悲悯与对旧制度控诉。",
    "start": 117.194,
    "end": 121.124,
    "duration": 3.93
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：牢记三起三落准确对应：①攒三年买车被乱兵抢走（一落） ②卖骆驼攒钱被孙侦探敲诈（二落） ③虎妞难产卖车办丧（三落）；",
    "start": 121.937,
    "end": 136.164,
    "duration": 14.227
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "结尾老舍定性“个人主义的末路鬼”。",
    "start": 136.938,
    "end": 139.424,
    "duration": 2.486
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 从“身份、轨迹（三起三落）、性格（由人变鬼）、成因”四维完整剖析祥子？",
    "start": 140.223,
    "end": 148.284,
    "duration": 8.061
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 精准复述一落、二落、三落与小福子/阮明事件，避免张冠李戴？",
    "start": 149.01,
    "end": 156.244,
    "duration": 7.233
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 联系现代农民进城主题，说明祥子悲剧何以超越普通贫民苦难控诉？",
    "start": 156.986,
    "end": 164.253,
    "duration": 7.266
  }
]