[
  {
    "id": "title_c0",
    "dom_key": "title_c0",
    "text": "老舍·骆驼祥子形象变迁与底层城市平民悲剧意蕴",
    "start": 0.206,
    "end": 4.886,
    "duration": 4.68
  },
  {
    "id": "hook_c0",
    "dom_key": "hook_c0",
    "text": "严格对应“身份→命运→性格→成因”四环紧扣：刚进城带乡土健壮却也带小农自私（因），",
    "start": 5.368,
    "end": 14.98,
    "duration": 9.612
  },
  {
    "id": "hook_c1",
    "dom_key": "hook_c1",
    "text": "随后经买车“三起三落”掠夺击垮生路（轨），小福子之死压断脊梁使之沦为市井流氓（果），",
    "start": 15.288,
    "end": 23.7,
    "duration": 8.412
  },
  {
    "id": "hook_c2",
    "dom_key": "hook_c2",
    "text": "最后定性“个人主义的末路鬼”（理）。",
    "start": 24.088,
    "end": 26.58,
    "duration": 2.492
  },
  {
    "id": "intro_c0",
    "dom_key": "intro_c0",
    "text": "老舍《骆驼祥子》通过车夫祥子由“人”堕落为“鬼”的轨迹，宣告底层劳动者依靠孤立个人奋斗改变命运的幻灭。",
    "start": 26.994,
    "end": 36.01,
    "duration": 9.016
  },
  {
    "id": "sec0_title_c0",
    "dom_key": "sec0_title_c0",
    "text": "01 · 身份属性：乡土美德兼小农意识的新移民",
    "start": 36.457,
    "end": 40.549,
    "duration": 4.092
  },
  {
    "id": "sec0_step0_c0",
    "dom_key": "sec0_step0_c0",
    "text": "出身破产农村，初入北平健壮、勤劳要强，寄望买辆属于自己的洋车；",
    "start": 41.077,
    "end": 48.529,
    "duration": 7.452
  },
  {
    "id": "sec0_step1_c0",
    "dom_key": "sec0_step1_c0",
    "text": "保留狭隘自私个体哲学，信奉只靠自己力气吃饭，不信任同伴亦隔绝群体。",
    "start": 49.057,
    "end": 56.669,
    "duration": 7.612
  },
  {
    "id": "sec1_title_c0",
    "dom_key": "sec1_title_c0",
    "text": "02 · 人生轨迹：历经“三起三落”的物质掠夺",
    "start": 57.313,
    "end": 61.165,
    "duration": 3.852
  },
  {
    "id": "sec1_step0_c0",
    "dom_key": "sec1_step0_c0",
    "text": "①苦熬三年买新车被乱兵抢走（一落）；②卖骆驼攒钱被孙侦探敲诈一空（二落）；",
    "start": 61.676,
    "end": 71.338,
    "duration": 9.662
  },
  {
    "id": "sec1_step1_c0",
    "dom_key": "sec1_step1_c0",
    "text": "③被迫娶虎妞买车，因虎妞难产死只得卖车办丧（三落），诚实谋生出路被彻底堵死。",
    "start": 71.866,
    "end": 82.278,
    "duration": 10.412
  },
  {
    "id": "sec2_title_c0",
    "dom_key": "sec2_title_c0",
    "text": "03 · 性格流变：从自尊要强蜕变为麻木游民",
    "start": 82.916,
    "end": 87.408,
    "duration": 4.492
  },
  {
    "id": "sec2_step0_c0",
    "dom_key": "sec2_step0_c0",
    "text": "三落之后小福子在暗娼馆自缢切断最后精神寄托；",
    "start": 87.936,
    "end": 93.548,
    "duration": 5.612
  },
  {
    "id": "sec2_step1_c0",
    "dom_key": "sec2_step1_c0",
    "text": "他从讲体面纯朴青年堕为吃喝嫖赌、偷奸耍滑、出卖同伴阮明换赏钱的市井流氓，显健全人性被剥蚀过程。",
    "start": 94.044,
    "end": 105.976,
    "duration": 11.932
  },
  {
    "id": "sec3_title_c0",
    "dom_key": "sec3_title_c0",
    "text": "04 · 悲剧成因：社会压迫、都市腐蚀与奋斗局限",
    "start": 106.684,
    "end": 111.336,
    "duration": 4.652
  },
  {
    "id": "sec3_step0_c0",
    "dom_key": "sec3_step0_c0",
    "text": "既是乱兵、孙侦探与刘四爷外部盘剥产物，亦源于畸形都市对道德的腐蚀；",
    "start": 111.796,
    "end": 119.568,
    "duration": 7.772
  },
  {
    "id": "sec3_step1_c0",
    "dom_key": "sec3_step1_c0",
    "text": "老舍结尾定性“个人主义的末路鬼”，揭示脱离集体抗争终归失败。",
    "start": 120.096,
    "end": 128.108,
    "duration": 8.012
  },
  {
    "id": "concl_c0",
    "dom_key": "concl_c0",
    "text": "祥子的悲剧是淳朴劳动者在旧社会压迫下走向精神毁灭的写照，蕴含老舍对底层平民命运的悲悯与对旧制度控诉。",
    "start": 128.814,
    "end": 138.986,
    "duration": 10.172
  },
  {
    "id": "guard_c0",
    "dom_key": "guard_c0",
    "text": "防混：牢记三起三落准确对应：①攒三年买车被乱兵抢走（一落） ②卖骆驼攒钱被孙侦探敲诈（二落） ③虎妞难产卖车办丧（三落）；",
    "start": 139.694,
    "end": 152.206,
    "duration": 12.512
  },
  {
    "id": "guard_c1",
    "dom_key": "guard_c1",
    "text": "结尾老舍定性“个人主义的末路鬼”。",
    "start": 152.484,
    "end": 155.136,
    "duration": 2.652
  },
  {
    "id": "drill0_c0",
    "dom_key": "drill0_c0",
    "text": "① 从“身份、轨迹（三起三落）、性格（由人变鬼）、成因”四维完整剖析祥子？",
    "start": 155.76,
    "end": 163.193,
    "duration": 7.433
  },
  {
    "id": "drill1_c0",
    "dom_key": "drill1_c0",
    "text": "② 精准复述一落、二落、三落与小福子/阮明事件，避免张冠李戴？",
    "start": 163.721,
    "end": 170.994,
    "duration": 7.273
  },
  {
    "id": "drill2_c0",
    "dom_key": "drill2_c0",
    "text": "③ 联系现代农民进城主题，说明祥子悲剧何以超越普通贫民苦难控诉？",
    "start": 171.522,
    "end": 179.732,
    "duration": 8.21
  }
]