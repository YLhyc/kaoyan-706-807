[
  {
    "id": 1,
    "text": "试论鲁迅杂文的艺术特质与思想内涵。",
    "start": 0.05,
    "end": 3.762,
    "duration": 3.712
  },
  {
    "id": 2,
    "text": "鲁迅杂文是中国现代散文史与批评史上独步文坛的文体奇观。",
    "start": 3.762,
    "end": 9.119,
    "duration": 5.357
  },
  {
    "id": 3,
    "text": "在现代报刊媒介的催生下，",
    "start": 9.119,
    "end": 11.246,
    "duration": 2.127
  },
  {
    "id": 4,
    "text": "鲁迅将原本被视为边缘零碎的闲话杂感，",
    "start": 11.246,
    "end": 14.689,
    "duration": 3.443
  },
  {
    "id": 5,
    "text": "创造性地重构为直接介入现实社会搏斗的思想利刃。",
    "start": 14.689,
    "end": 18.693,
    "duration": 4.004
  },
  {
    "id": 6,
    "text": "它彻底打破了传统文章义理、考据、辞章的狭隘分界，",
    "start": 18.693,
    "end": 23.11,
    "duration": 4.417
  },
  {
    "id": 7,
    "text": "将敏锐的社会批判、深邃的文明解剖、",
    "start": 23.11,
    "end": 27.657,
    "duration": 4.547
  },
  {
    "id": 8,
    "text": "卓越的类型化创造与反规范的语言实验熔于一炉，",
    "start": 27.657,
    "end": 31.475,
    "duration": 3.818
  },
  {
    "id": 9,
    "text": "以彻底的否定性坚守现代“立人”理想，",
    "start": 31.475,
    "end": 34.419,
    "duration": 2.944
  },
  {
    "id": 10,
    "text": "铸就了兼具战斗性与诗性美学的现代自由文体巅峰。",
    "start": 34.419,
    "end": 39.106,
    "duration": 4.687
  },
  {
    "id": 11,
    "text": "其艺术特质与思想内涵主要体现在以下四个核心维度：",
    "start": 39.106,
    "end": 43.629,
    "duration": 4.523
  },
  {
    "id": 12,
    "text": "第一，确立“无体的自由文体”，",
    "start": 43.629,
    "end": 45.658,
    "duration": 2.029
  },
  {
    "id": 13,
    "text": "开创以现代报刊为媒介即时介入现实的斗争范式。",
    "start": 45.658,
    "end": 50.22,
    "duration": 4.562
  },
  {
    "id": 14,
    "text": "鲁迅杂文依托《新青年》《语丝》《申报·自由谈》等现代报刊而生，",
    "start": 50.22,
    "end": 54.737,
    "duration": 4.517
  },
  {
    "id": 15,
    "text": "天然具备迅速回应时代脉搏与社会思潮的敏锐性。",
    "start": 54.737,
    "end": 59.805,
    "duration": 5.068
  },
  {
    "id": 16,
    "text": "鲁迅倡导“无体即有体”，摆脱了传统散文、",
    "start": 59.805,
    "end": 63.125,
    "duration": 3.32
  },
  {
    "id": 17,
    "text": "史传与论说的僵化程式，根据论辩需求与主体心境随物赋形，",
    "start": 63.125,
    "end": 68.702,
    "duration": 5.577
  },
  {
    "id": 18,
    "text": "自由穿梭于严密逻辑论证、生活场景叙事、",
    "start": 68.702,
    "end": 71.903,
    "duration": 3.201
  },
  {
    "id": 19,
    "text": "主观激情抒发与深邃历史考据之间。",
    "start": 71.903,
    "end": 74.991,
    "duration": 3.088
  },
  {
    "id": 20,
    "text": "从早期的《热风》到后期的《准风月谈》，",
    "start": 74.991,
    "end": 78.204,
    "duration": 3.213
  },
  {
    "id": 21,
    "text": "这一文体演变为一部现代中国活的“人史”，",
    "start": 78.204,
    "end": 82.099,
    "duration": 3.895
  },
  {
    "id": 22,
    "text": "构成了对半殖民地半封建社会中国人精神图谱最微观的文学记录。第二，",
    "start": 82.099,
    "end": 88.548,
    "duration": 6.449
  },
  {
    "id": 23,
    "text": "坚持彻底的批判否定性与“正面文章反面看”的反常规多疑思维。",
    "start": 88.548,
    "end": 93.275,
    "duration": 4.727
  },
  {
    "id": 24,
    "text": "鲁迅杂文的批判锋芒从不停留在政治权力的表层对抗，",
    "start": 93.275,
    "end": 98.039,
    "duration": 4.764
  },
  {
    "id": 25,
    "text": "而是以现代启蒙“立人”为精神轴心，",
    "start": 98.039,
    "end": 101.109,
    "duration": 3.07
  },
  {
    "id": 26,
    "text": "对一切压抑生命自由的宗法旧礼教、",
    "start": 101.109,
    "end": 105.389,
    "duration": 4.28
  },
  {
    "id": 27,
    "text": "等级专制与奴性人格展开绝不妥协的精神解剖。",
    "start": 105.389,
    "end": 109.68,
    "duration": 4.291
  },
  {
    "id": 28,
    "text": "面对错综复杂的社会现象，",
    "start": 109.68,
    "end": 111.68,
    "duration": 2.0
  },
  {
    "id": 29,
    "text": "鲁迅创立了独具一格的“正面文章反面看”的多疑认知方法：",
    "start": 111.68,
    "end": 116.044,
    "duration": 4.364
  },
  {
    "id": 30,
    "text": "在《论“他妈的”》中，他从小民的日常国骂抽丝剥茧，",
    "start": 116.044,
    "end": 119.498,
    "duration": 3.454
  },
  {
    "id": 31,
    "text": "直击背后门第等级观念与血统压迫的荒谬；",
    "start": 119.498,
    "end": 123.078,
    "duration": 3.58
  },
  {
    "id": 32,
    "text": "在《小杂感》与《魏晋风度及文章与药及酒之关系》中，",
    "start": 123.078,
    "end": 127.985,
    "duration": 4.907
  },
  {
    "id": 33,
    "text": "他以逆向思维刺破正人君子与名士风流的伪善外壳。",
    "start": 127.985,
    "end": 132.572,
    "duration": 4.587
  },
  {
    "id": 34,
    "text": "这种直击事物骨髓的冷峻解剖，展现了深刻的认识论力量。",
    "start": 132.572,
    "end": 138.028,
    "duration": 5.456
  },
  {
    "id": 35,
    "text": "第三，践行“由个入类”的文学典型化，",
    "start": 138.028,
    "end": 140.573,
    "duration": 2.545
  },
  {
    "id": 36,
    "text": "创造具有普遍概括力的社会类型共名。",
    "start": 140.573,
    "end": 143.482,
    "duration": 2.909
  },
  {
    "id": 37,
    "text": "鲁迅杂文的现实介入绝非就事论事的短浅时评，",
    "start": 143.482,
    "end": 147.29,
    "duration": 3.808
  },
  {
    "id": 38,
    "text": "而是极善于抓住日常生活中的某一具体个案、甚至“一鼻、",
    "start": 147.29,
    "end": 153.401,
    "duration": 6.111
  },
  {
    "id": 39,
    "text": "一嘴、一毛”的细微病态姿态作为起点，",
    "start": 153.401,
    "end": 156.128,
    "duration": 2.727
  },
  {
    "id": 40,
    "text": "进而将其置于几千年的文明历史长河中持续勘探，",
    "start": 156.128,
    "end": 160.819,
    "duration": 4.691
  },
  {
    "id": 41,
    "text": "提炼出超越具体人事的普遍社会人格符号。",
    "start": 160.819,
    "end": 164.092,
    "duration": 3.273
  },
  {
    "id": 42,
    "text": "他在《论“费厄泼赖”应该缓行》中由落水狗的论争概括出依附豪强、",
    "start": 164.092,
    "end": 169.202,
    "duration": 5.11
  },
  {
    "id": 43,
    "text": "反咬弱者的“叭儿狗”典型；在论战中创造了假充中立、",
    "start": 169.202,
    "end": 173.374,
    "duration": 4.172
  },
  {
    "id": 44,
    "text": "实为帮凶的“二丑”与诱骗民众走向屠场的“带头羊”。",
    "start": 173.374,
    "end": 177.167,
    "duration": 3.793
  },
  {
    "id": 45,
    "text": "这些艺术共名使具体杂感超越了论争时效，",
    "start": 177.167,
    "end": 180.877,
    "duration": 3.71
  },
  {
    "id": 46,
    "text": "获得了穿越百年历史的超拔生命力。",
    "start": 180.877,
    "end": 185.944,
    "duration": 5.067
  },
  {
    "id": 47,
    "text": "第四，熔铸深沉悲怆的主观诗性，",
    "start": 185.944,
    "end": 188.356,
    "duration": 2.412
  },
  {
    "id": 48,
    "text": "开创反规范拗体与庄谐杂糅的反讽语言。",
    "start": 188.356,
    "end": 191.447,
    "duration": 3.091
  },
  {
    "id": 49,
    "text": "鲁迅杂文绝非冷漠的客观政论，外部社会危机一旦进入其笔端，",
    "start": 191.447,
    "end": 196.175,
    "duration": 4.728
  },
  {
    "id": 50,
    "text": "立刻经过其炽热痛苦的生命体验过滤，",
    "start": 196.175,
    "end": 199.234,
    "duration": 3.059
  },
  {
    "id": 51,
    "text": "转化为内心严峻的心灵搏斗。",
    "start": 199.234,
    "end": 202.966,
    "duration": 3.732
  },
  {
    "id": 52,
    "text": "在《记念刘和珍君》中，沉痛的祭奠在“沉默与爆发”、",
    "start": 202.966,
    "end": 206.421,
    "duration": 3.455
  },
  {
    "id": 53,
    "text": "“写与不写”的剧烈张力中起伏回荡，",
    "start": 206.421,
    "end": 208.966,
    "duration": 2.545
  },
  {
    "id": 54,
    "text": "展现出交响乐般沉郁顿挫的诗性力量。",
    "start": 208.966,
    "end": 213.031,
    "duration": 4.065
  },
  {
    "id": 55,
    "text": "在语言创造上，鲁迅故意打破常规词语搭配习惯，",
    "start": 213.031,
    "end": 217.763,
    "duration": 4.732
  },
  {
    "id": 56,
    "text": "创造出“有理的压迫”、",
    "start": 217.763,
    "end": 219.218,
    "duration": 1.455
  },
  {
    "id": 57,
    "text": "“跪着的造反”等充满张力的反规范拗体，",
    "start": 219.218,
    "end": 222.842,
    "duration": 3.624
  },
  {
    "id": 58,
    "text": "以刺耳不谐的语词逼迫读者直面真实；",
    "start": 222.842,
    "end": 225.751,
    "duration": 2.909
  },
  {
    "id": 59,
    "text": "同时娴熟运用古雅典故与市井俗语的庄谐杂糅，",
    "start": 225.751,
    "end": 230.468,
    "duration": 4.717
  },
  {
    "id": 60,
    "text": "以大词小用与庄词谐用形成了杀伤力极强的荒诞反讽风格。",
    "start": 230.468,
    "end": 235.013,
    "duration": 4.545
  },
  {
    "id": 61,
    "text": "综上所述，",
    "start": 235.013,
    "end": 236.166,
    "duration": 1.153
  },
  {
    "id": 62,
    "text": "鲁迅杂文实现了战斗社会功能与崇高文学品格的完美交融。",
    "start": 236.166,
    "end": 241.331,
    "duration": 5.165
  },
  {
    "id": 63,
    "text": "他以现代散文的自由形式，",
    "start": 241.331,
    "end": 243.335,
    "duration": 2.004
  },
  {
    "id": 64,
    "text": "开拓了中国现代文学批判现实主义与主观抒情相统一的全新疆界，",
    "start": 243.335,
    "end": 249.107,
    "duration": 5.772
  },
  {
    "id": 65,
    "text": "立下了一座不可逾越的艺术丰碑。",
    "start": 249.107,
    "end": 251.568,
    "duration": 2.461
  }
]