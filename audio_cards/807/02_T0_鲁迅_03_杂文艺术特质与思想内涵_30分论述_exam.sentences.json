[
  {
    "id": 1,
    "text": "试论鲁迅杂文的艺术特质与思想内涵。",
    "start": 0.0,
    "end": 3.792,
    "duration": 3.792
  },
  {
    "id": 2,
    "text": "鲁迅杂文是中国现代散文史与批评史上独步文坛的文体奇观。",
    "start": 3.792,
    "end": 9.149,
    "duration": 5.357
  },
  {
    "id": 3,
    "text": "在现代报刊媒介的催生下，",
    "start": 9.149,
    "end": 11.272,
    "duration": 2.123
  },
  {
    "id": 4,
    "text": "鲁迅将原本被视为边缘零碎的闲话杂感，",
    "start": 11.272,
    "end": 14.719,
    "duration": 3.447
  },
  {
    "id": 5,
    "text": "创造性地重构为直接介入现实社会搏斗的思想利刃。",
    "start": 14.719,
    "end": 18.723,
    "duration": 4.004
  },
  {
    "id": 6,
    "text": "它彻底打破了传统文章义理、考据、辞章的狭隘分界，",
    "start": 18.723,
    "end": 23.14,
    "duration": 4.417
  },
  {
    "id": 7,
    "text": "将敏锐的社会批判、深邃的文明解剖、",
    "start": 23.14,
    "end": 26.089,
    "duration": 2.949
  },
  {
    "id": 8,
    "text": "卓越的类型化创造与反规范的语言实验熔于一炉，",
    "start": 26.089,
    "end": 30.148,
    "duration": 4.059
  },
  {
    "id": 9,
    "text": "以彻底的否定性坚守现代“立人”理想，",
    "start": 30.148,
    "end": 33.127,
    "duration": 2.979
  },
  {
    "id": 10,
    "text": "铸就了兼具战斗性与诗性美学的现代自由文体巅峰。",
    "start": 33.127,
    "end": 37.1,
    "duration": 3.973
  },
  {
    "id": 11,
    "text": "其艺术特质与思想内涵主要体现在以下四个核心维度：",
    "start": 37.1,
    "end": 41.808,
    "duration": 4.708
  },
  {
    "id": 12,
    "text": "第一，确立“无体的自由文体”，",
    "start": 41.808,
    "end": 45.686,
    "duration": 3.878
  },
  {
    "id": 13,
    "text": "开创以现代报刊为媒介即时介入现实的斗争范式。",
    "start": 45.686,
    "end": 50.249,
    "duration": 4.563
  },
  {
    "id": 14,
    "text": "鲁迅杂文依托《新青年》《语丝》《申报·自由谈》等现代报刊而生，",
    "start": 50.249,
    "end": 54.767,
    "duration": 4.518
  },
  {
    "id": 15,
    "text": "天然具备迅速回应时代脉搏与社会思潮的敏锐性。",
    "start": 54.767,
    "end": 58.541,
    "duration": 3.774
  },
  {
    "id": 16,
    "text": "鲁迅倡导“无体即有体”，摆脱了传统散文、",
    "start": 58.541,
    "end": 62.207,
    "duration": 3.666
  },
  {
    "id": 17,
    "text": "史传与论说的僵化程式，根据论辩需求与主体心境随物赋形，",
    "start": 62.207,
    "end": 67.426,
    "duration": 5.219
  },
  {
    "id": 18,
    "text": "自由穿梭于严密逻辑论证、生活场景叙事、",
    "start": 67.426,
    "end": 70.192,
    "duration": 2.766
  },
  {
    "id": 19,
    "text": "主观激情抒发与深邃历史考据之间。",
    "start": 70.192,
    "end": 73.364,
    "duration": 3.172
  },
  {
    "id": 20,
    "text": "从早期的《热风》到后期的《准风月谈》，",
    "start": 73.364,
    "end": 76.854,
    "duration": 3.49
  },
  {
    "id": 21,
    "text": "这一文体演变为一部现代中国活的“人史”，",
    "start": 76.854,
    "end": 83.889,
    "duration": 7.035
  },
  {
    "id": 22,
    "text": "构成了对半殖民地半封建社会中国人精神图谱最微观的文学记录。第二，",
    "start": 83.889,
    "end": 86.652,
    "duration": 2.763
  },
  {
    "id": 23,
    "text": "坚持彻底的批判否定性与“正面文章反面看”的反常规多疑思维。",
    "start": 86.652,
    "end": 94.986,
    "duration": 8.334
  },
  {
    "id": 24,
    "text": "鲁迅杂文的批判锋芒从不停留在政治权力的表层对抗，",
    "start": 94.986,
    "end": 97.877,
    "duration": 2.891
  },
  {
    "id": 25,
    "text": "而是以现代启蒙“立人”为精神轴心，",
    "start": 97.877,
    "end": 101.139,
    "duration": 3.262
  },
  {
    "id": 26,
    "text": "对一切压抑生命自由的宗法旧礼教、",
    "start": 101.139,
    "end": 103.089,
    "duration": 1.95
  },
  {
    "id": 27,
    "text": "等级专制与奴性人格展开绝不妥协的精神解剖。",
    "start": 103.089,
    "end": 107.753,
    "duration": 4.664
  },
  {
    "id": 28,
    "text": "面对错综复杂的社会现象，",
    "start": 107.753,
    "end": 109.71,
    "duration": 1.957
  },
  {
    "id": 29,
    "text": "鲁迅创立了独具一格的“正面文章反面看”的多疑认知方法：",
    "start": 109.71,
    "end": 114.195,
    "duration": 4.485
  },
  {
    "id": 30,
    "text": "在《论“他妈的”》中，他从小民的日常国骂抽丝剥茧，",
    "start": 114.195,
    "end": 118.033,
    "duration": 3.838
  },
  {
    "id": 31,
    "text": "直击背后门第等级观念与血统压迫的荒谬；",
    "start": 118.033,
    "end": 121.216,
    "duration": 3.183
  },
  {
    "id": 32,
    "text": "在《小杂感》与《魏晋风度及文章与药及酒之关系》中，",
    "start": 121.216,
    "end": 128.015,
    "duration": 6.799
  },
  {
    "id": 33,
    "text": "他以逆向思维刺破正人君子与名士风流的伪善外壳。",
    "start": 128.015,
    "end": 132.602,
    "duration": 4.587
  },
  {
    "id": 34,
    "text": "这种直击事物骨髓的冷峻解剖，展现了深刻的认识论力量。",
    "start": 132.602,
    "end": 138.058,
    "duration": 5.456
  },
  {
    "id": 35,
    "text": "第三，践行“由个入类”的文学典型化，",
    "start": 138.058,
    "end": 141.567,
    "duration": 3.509
  },
  {
    "id": 36,
    "text": "创造具有普遍概括力的社会类型共名。",
    "start": 141.567,
    "end": 145.513,
    "duration": 3.946
  },
  {
    "id": 37,
    "text": "鲁迅杂文的现实介入绝非就事论事的短浅时评，",
    "start": 145.513,
    "end": 146.654,
    "duration": 1.141
  },
  {
    "id": 38,
    "text": "而是极善于抓住日常生活中的某一具体个案、甚至“一鼻、",
    "start": 146.654,
    "end": 153.431,
    "duration": 6.777
  },
  {
    "id": 39,
    "text": "一嘴、一毛”的细微病态姿态作为起点，",
    "start": 153.431,
    "end": 157.398,
    "duration": 3.967
  },
  {
    "id": 40,
    "text": "进而将其置于几千年的文明历史长河中持续勘探，",
    "start": 157.398,
    "end": 160.849,
    "duration": 3.451
  },
  {
    "id": 41,
    "text": "提炼出超越具体人事的普遍社会人格符号。",
    "start": 160.849,
    "end": 164.022,
    "duration": 3.173
  },
  {
    "id": 42,
    "text": "他在《论“费厄泼赖”应该缓行》中由落水狗的论争概括出依附豪强、",
    "start": 164.022,
    "end": 169.015,
    "duration": 4.993
  },
  {
    "id": 43,
    "text": "反咬弱者的“叭儿狗”典型；在论战中创造了假充中立、",
    "start": 169.015,
    "end": 173.404,
    "duration": 4.389
  },
  {
    "id": 44,
    "text": "实为帮凶的“二丑”与诱骗民众走向屠场的“带头羊”。",
    "start": 173.404,
    "end": 179.779,
    "duration": 6.375
  },
  {
    "id": 45,
    "text": "这些艺术共名使具体杂感超越了论争时效，",
    "start": 179.779,
    "end": 182.843,
    "duration": 3.064
  },
  {
    "id": 46,
    "text": "获得了穿越百年历史的超拔生命力。",
    "start": 182.843,
    "end": 185.974,
    "duration": 3.131
  },
  {
    "id": 47,
    "text": "第四，熔铸深沉悲怆的主观诗性，",
    "start": 185.974,
    "end": 187.225,
    "duration": 1.251
  },
  {
    "id": 48,
    "text": "开创反规范拗体与庄谐杂糅的反讽语言。",
    "start": 187.225,
    "end": 190.045,
    "duration": 2.82
  },
  {
    "id": 49,
    "text": "鲁迅杂文绝非冷漠的客观政论，外部社会危机一旦进入其笔端，",
    "start": 190.045,
    "end": 195.416,
    "duration": 5.371
  },
  {
    "id": 50,
    "text": "立刻经过其炽热痛苦的生命体验过滤，",
    "start": 195.416,
    "end": 198.718,
    "duration": 3.302
  },
  {
    "id": 51,
    "text": "转化为内心严峻的心灵搏斗。",
    "start": 198.718,
    "end": 201.262,
    "duration": 2.544
  },
  {
    "id": 52,
    "text": "在《记念刘和珍君》中，沉痛的祭奠在“沉默与爆发”、",
    "start": 201.262,
    "end": 205.352,
    "duration": 4.09
  },
  {
    "id": 53,
    "text": "“写与不写”的剧烈张力中起伏回荡，",
    "start": 205.352,
    "end": 208.376,
    "duration": 3.024
  },
  {
    "id": 54,
    "text": "展现出交响乐般沉郁顿挫的诗性力量。",
    "start": 208.376,
    "end": 213.061,
    "duration": 4.685
  },
  {
    "id": 55,
    "text": "在语言创造上，鲁迅故意打破常规词语搭配习惯，",
    "start": 213.061,
    "end": 217.793,
    "duration": 4.732
  },
  {
    "id": 56,
    "text": "创造出“有理的压迫”、",
    "start": 217.793,
    "end": 221.032,
    "duration": 3.239
  },
  {
    "id": 57,
    "text": "“跪着的造反”等充满张力的反规范拗体，",
    "start": 221.032,
    "end": 222.872,
    "duration": 1.84
  },
  {
    "id": 58,
    "text": "以刺耳不谐的语词逼迫读者直面真实；",
    "start": 222.872,
    "end": 227.05,
    "duration": 4.178
  },
  {
    "id": 59,
    "text": "同时娴熟运用古雅典故与市井俗语的庄谐杂糅，",
    "start": 227.05,
    "end": 230.498,
    "duration": 3.448
  },
  {
    "id": 60,
    "text": "以大词小用与庄词谐用形成了杀伤力极强的荒诞反讽风格。",
    "start": 230.498,
    "end": 235.008,
    "duration": 4.51
  },
  {
    "id": 61,
    "text": "综上所述，",
    "start": 235.008,
    "end": 236.196,
    "duration": 1.188
  },
  {
    "id": 62,
    "text": "鲁迅杂文实现了战斗社会功能与崇高文学品格的完美交融。",
    "start": 236.196,
    "end": 241.361,
    "duration": 5.165
  },
  {
    "id": 63,
    "text": "他以现代散文的自由形式，",
    "start": 241.361,
    "end": 243.365,
    "duration": 2.004
  },
  {
    "id": 64,
    "text": "开拓了中国现代文学批判现实主义与主观抒情相统一的全新疆界，",
    "start": 243.365,
    "end": 249.137,
    "duration": 5.772
  },
  {
    "id": 65,
    "text": "立下了一座不可逾越的艺术丰碑。",
    "start": 249.137,
    "end": 251.568,
    "duration": 2.431
  }
]