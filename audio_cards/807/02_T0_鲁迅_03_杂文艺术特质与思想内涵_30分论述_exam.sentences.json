[
  {
    "id": 1,
    "text": "试论鲁迅杂文的艺术特质与思想内涵。",
    "start": 0.16,
    "end": 3.92,
    "duration": 3.76
  },
  {
    "id": 2,
    "text": "鲁迅杂文是中国现代散文史与批评史上独步文坛的文体奇观。",
    "start": 3.92,
    "end": 9.2,
    "duration": 5.28
  },
  {
    "id": 3,
    "text": "在现代报刊媒介的催生下，",
    "start": 9.2,
    "end": 11.52,
    "duration": 2.32
  },
  {
    "id": 4,
    "text": "鲁迅将原本被视为边缘零碎的闲话杂感，",
    "start": 11.52,
    "end": 15.2,
    "duration": 3.68
  },
  {
    "id": 5,
    "text": "创造性地重构为直接介入现实社会搏斗的思想利刃。",
    "start": 15.2,
    "end": 19.28,
    "duration": 4.08
  },
  {
    "id": 6,
    "text": "它彻底打破了传统文章义理、考据、辞章的狭隘分界，",
    "start": 19.28,
    "end": 24.16,
    "duration": 4.88
  },
  {
    "id": 7,
    "text": "将敏锐的社会批判、深邃的文明解剖、",
    "start": 24.16,
    "end": 27.76,
    "duration": 3.6
  },
  {
    "id": 8,
    "text": "卓越的类型化创造与反规范的语言实验熔于一炉，",
    "start": 27.76,
    "end": 31.92,
    "duration": 4.16
  },
  {
    "id": 9,
    "text": "以彻底的否定性坚守现代“立人”理想，",
    "start": 31.92,
    "end": 35.28,
    "duration": 3.36
  },
  {
    "id": 10,
    "text": "铸就了兼具战斗性与诗性美学的现代自由文体巅峰。",
    "start": 35.28,
    "end": 39.28,
    "duration": 4.0
  },
  {
    "id": 11,
    "text": "其艺术特质与思想内涵主要体现在以下四个核心维度：",
    "start": 39.28,
    "end": 44.32,
    "duration": 5.04
  },
  {
    "id": 12,
    "text": "第一，确立“无体的自由文体”，",
    "start": 44.32,
    "end": 47.2,
    "duration": 2.88
  },
  {
    "id": 13,
    "text": "开创以现代报刊为媒介即时介入现实的斗争范式。",
    "start": 47.2,
    "end": 51.6,
    "duration": 4.4
  },
  {
    "id": 14,
    "text": "鲁迅杂文依托《新青年》《语丝》《申报·自由谈》等现代报刊而生，",
    "start": 51.6,
    "end": 57.76,
    "duration": 6.16
  },
  {
    "id": 15,
    "text": "天然具备迅速回应时代脉搏与社会思潮的敏锐性。",
    "start": 57.76,
    "end": 62.24,
    "duration": 4.48
  },
  {
    "id": 16,
    "text": "鲁迅倡导“无体即有体”，摆脱了传统散文、",
    "start": 62.24,
    "end": 66.4,
    "duration": 4.16
  },
  {
    "id": 17,
    "text": "史传与论说的僵化程式，根据论辩需求与主体心境随物赋形，",
    "start": 66.4,
    "end": 72.08,
    "duration": 5.68
  },
  {
    "id": 18,
    "text": "自由穿梭于严密逻辑论证、生活场景叙事、",
    "start": 72.08,
    "end": 75.92,
    "duration": 3.84
  },
  {
    "id": 19,
    "text": "主观激情抒发与深邃历史考据之间。",
    "start": 75.92,
    "end": 79.04,
    "duration": 3.12
  },
  {
    "id": 20,
    "text": "从早期的《热风》到后期的《准风月谈》，",
    "start": 79.04,
    "end": 82.8,
    "duration": 3.76
  },
  {
    "id": 21,
    "text": "这一文体演变为一部现代中国活的“人史”，",
    "start": 82.8,
    "end": 87.28,
    "duration": 4.48
  },
  {
    "id": 22,
    "text": "构成了对半殖民地半封建社会中国人精神图谱最微观的文学记录。第二，",
    "start": 87.28,
    "end": 94.0,
    "duration": 6.72
  },
  {
    "id": 23,
    "text": "坚持彻底的批判否定性与“正面文章反面看”的反常规多疑思维。",
    "start": 94.0,
    "end": 100.16,
    "duration": 6.16
  },
  {
    "id": 24,
    "text": "鲁迅杂文的批判锋芒从不停留在政治权力的表层对抗，",
    "start": 100.16,
    "end": 105.12,
    "duration": 4.96
  },
  {
    "id": 25,
    "text": "而是以现代启蒙“立人”为精神轴心，",
    "start": 105.36,
    "end": 108.72,
    "duration": 3.36
  },
  {
    "id": 26,
    "text": "对一切压抑生命自由的宗法旧礼教、",
    "start": 108.72,
    "end": 111.92,
    "duration": 3.2
  },
  {
    "id": 27,
    "text": "等级专制与奴性人格展开绝不妥协的精神解剖。",
    "start": 111.92,
    "end": 116.64,
    "duration": 4.72
  },
  {
    "id": 28,
    "text": "面对错综复杂的社会现象，",
    "start": 116.96,
    "end": 119.52,
    "duration": 2.56
  },
  {
    "id": 29,
    "text": "鲁迅创立了独具一格的“正面文章反面看”的多疑认知方法：",
    "start": 119.52,
    "end": 125.6,
    "duration": 6.08
  },
  {
    "id": 30,
    "text": "在《论“他妈的”》中，他从小民的日常国骂抽丝剥茧，",
    "start": 125.6,
    "end": 130.8,
    "duration": 5.2
  },
  {
    "id": 31,
    "text": "直击背后门第等级观念与血统压迫的荒谬；",
    "start": 130.8,
    "end": 134.16,
    "duration": 3.36
  },
  {
    "id": 32,
    "text": "在《小杂感》与《魏晋风度及文章与药及酒之关系》中，",
    "start": 134.16,
    "end": 139.744,
    "duration": 5.584
  },
  {
    "id": 33,
    "text": "他以逆向思维刺破正人君子与名士风流的伪善外壳。",
    "start": 139.744,
    "end": 144.464,
    "duration": 4.72
  },
  {
    "id": 34,
    "text": "这种直击事物骨髓的冷峻解剖，展现了深刻的认识论力量。",
    "start": 144.464,
    "end": 149.904,
    "duration": 5.44
  },
  {
    "id": 35,
    "text": "第三，践行“由个入类”的文学典型化，",
    "start": 149.984,
    "end": 153.824,
    "duration": 3.84
  },
  {
    "id": 36,
    "text": "创造具有普遍概括力的社会类型共名。",
    "start": 153.824,
    "end": 156.704,
    "duration": 2.88
  },
  {
    "id": 37,
    "text": "鲁迅杂文的现实介入绝非就事论事的短浅时评，",
    "start": 156.704,
    "end": 160.544,
    "duration": 3.84
  },
  {
    "id": 38,
    "text": "而是极善于抓住日常生活中的某一具体个案、甚至“一鼻、",
    "start": 160.784,
    "end": 166.784,
    "duration": 6.0
  },
  {
    "id": 39,
    "text": "一嘴、一毛”的细微病态姿态作为起点，",
    "start": 167.024,
    "end": 170.864,
    "duration": 3.84
  },
  {
    "id": 40,
    "text": "进而将其置于几千年的文明历史长河中持续勘探，",
    "start": 170.864,
    "end": 175.424,
    "duration": 4.56
  },
  {
    "id": 41,
    "text": "提炼出超越具体人事的普遍社会人格符号。",
    "start": 175.424,
    "end": 179.504,
    "duration": 4.08
  },
  {
    "id": 42,
    "text": "他在《论“费厄泼赖”应该缓行》中由落水狗的论争概括出依附豪强、",
    "start": 179.904,
    "end": 186.544,
    "duration": 6.64
  },
  {
    "id": 43,
    "text": "反咬弱者的“叭儿狗”典型；在论战中创造了假充中立、",
    "start": 186.544,
    "end": 191.984,
    "duration": 5.44
  },
  {
    "id": 44,
    "text": "实为帮凶的“二丑”与诱骗民众走向屠场的“带头羊”。",
    "start": 191.984,
    "end": 197.344,
    "duration": 5.36
  },
  {
    "id": 45,
    "text": "这些艺术共名使具体杂感超越了论争时效，",
    "start": 197.344,
    "end": 201.424,
    "duration": 4.08
  },
  {
    "id": 46,
    "text": "获得了穿越百年历史的超拔生命力。",
    "start": 201.504,
    "end": 204.624,
    "duration": 3.12
  },
  {
    "id": 47,
    "text": "第四，熔铸深沉悲怆的主观诗性，",
    "start": 204.624,
    "end": 207.664,
    "duration": 3.04
  },
  {
    "id": 48,
    "text": "开创反规范拗体与庄谐杂糅的反讽语言。",
    "start": 207.664,
    "end": 210.784,
    "duration": 3.12
  },
  {
    "id": 49,
    "text": "鲁迅杂文绝非冷漠的客观政论，外部社会危机一旦进入其笔端，",
    "start": 210.784,
    "end": 216.944,
    "duration": 6.16
  },
  {
    "id": 50,
    "text": "立刻经过其炽热痛苦的生命体验过滤，",
    "start": 216.944,
    "end": 220.304,
    "duration": 3.36
  },
  {
    "id": 51,
    "text": "转化为内心严峻的心灵搏斗。",
    "start": 220.304,
    "end": 223.264,
    "duration": 2.96
  },
  {
    "id": 52,
    "text": "在《记念刘和珍君》中，沉痛的祭奠在“沉默与爆发”、",
    "start": 223.264,
    "end": 228.944,
    "duration": 5.68
  },
  {
    "id": 53,
    "text": "“写与不写”的剧烈张力中起伏回荡，",
    "start": 229.264,
    "end": 232.864,
    "duration": 3.6
  },
  {
    "id": 54,
    "text": "展现出交响乐般沉郁顿挫的诗性力量。",
    "start": 232.864,
    "end": 237.024,
    "duration": 4.16
  },
  {
    "id": 55,
    "text": "在语言创造上，鲁迅故意打破常规词语搭配习惯，",
    "start": 237.024,
    "end": 241.424,
    "duration": 4.4
  },
  {
    "id": 56,
    "text": "创造出“有理的压迫”、",
    "start": 241.424,
    "end": 243.424,
    "duration": 2.0
  },
  {
    "id": 57,
    "text": "“跪着的造反”等充满张力的反规范拗体，",
    "start": 243.424,
    "end": 247.024,
    "duration": 3.6
  },
  {
    "id": 58,
    "text": "以刺耳不谐的语词逼迫读者直面真实；",
    "start": 247.024,
    "end": 250.384,
    "duration": 3.36
  },
  {
    "id": 59,
    "text": "同时娴熟运用古雅典故与市井俗语的庄谐杂糅，",
    "start": 250.384,
    "end": 251.344,
    "duration": 0.96
  },
  {
    "id": 60,
    "text": "以大词小用与庄词谐用形成了杀伤力极强的荒诞反讽风格。",
    "start": 251.104,
    "end": 251.344,
    "duration": 0.24
  },
  {
    "id": 61,
    "text": "综上所述，",
    "start": 251.104,
    "end": 251.344,
    "duration": 0.24
  },
  {
    "id": 62,
    "text": "鲁迅杂文实现了战斗社会功能与崇高文学品格的完美交融。",
    "start": 251.104,
    "end": 251.344,
    "duration": 0.24
  },
  {
    "id": 63,
    "text": "他以现代散文的自由形式，",
    "start": 251.104,
    "end": 251.344,
    "duration": 0.24
  },
  {
    "id": 64,
    "text": "开拓了中国现代文学批判现实主义与主观抒情相统一的全新疆界，",
    "start": 251.104,
    "end": 251.344,
    "duration": 0.24
  },
  {
    "id": 65,
    "text": "立下了一座不可逾越的艺术丰碑。",
    "start": 251.104,
    "end": 251.344,
    "duration": 0.24
  }
]