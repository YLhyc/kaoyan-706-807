[
  {
    "id": 1,
    "text": "鲁迅杂文是中国现代文学史上极具独创性的现代文体。",
    "start": 0.08,
    "end": 4.4,
    "duration": 4.32
  },
  {
    "id": 2,
    "text": "在现代报刊媒介的催生下，鲁迅将原本边缘化的杂感随笔改造为敏锐介入现实的思想武器。",
    "start": 4.4,
    "end": 11.6,
    "duration": 7.2
  },
  {
    "id": 3,
    "text": "鲁迅杂文彻底打破了传统文章的狭隘疆界。",
    "start": 11.6,
    "end": 14.88,
    "duration": 3.28
  },
  {
    "id": 4,
    "text": "它将敏锐的社会批判、深邃的文明反思、",
    "start": 14.88,
    "end": 18.16,
    "duration": 3.28
  },
  {
    "id": 5,
    "text": "独特的类型概括与高超的文学修辞熔铸于一炉。",
    "start": 18.16,
    "end": 22.16,
    "duration": 4.0
  },
  {
    "id": 6,
    "text": "它以彻底的批判否定性践行了“立人”的启蒙理想，",
    "start": 22.4,
    "end": 26.48,
    "duration": 4.08
  },
  {
    "id": 7,
    "text": "同时凭借反常规的思维张力与反规范的语言革新，",
    "start": 26.48,
    "end": 30.48,
    "duration": 4.0
  },
  {
    "id": 8,
    "text": "建构起具有深厚诗性力量的现代文体范式。",
    "start": 30.48,
    "end": 34.24,
    "duration": 3.76
  },
  {
    "id": 9,
    "text": "首先，鲁迅确立了杂文作为“无体的自由文体”的现代媒介特质与现实介入功能。",
    "start": 34.24,
    "end": 40.64,
    "duration": 6.4
  },
  {
    "id": 10,
    "text": "鲁迅杂文依托现代报刊副刊的发展而兴起。",
    "start": 40.88,
    "end": 44.48,
    "duration": 3.6
  },
  {
    "id": 11,
    "text": "它天然具有迅速回应时代震荡、直接介入现实论争的即时性特征。",
    "start": 44.48,
    "end": 49.92,
    "duration": 5.44
  },
  {
    "id": 12,
    "text": "鲁迅摆脱了传统诗歌、戏剧与小说的僵化形式拘束。",
    "start": 49.92,
    "end": 54.48,
    "duration": 4.56
  },
  {
    "id": 13,
    "text": "他在创作中根据现实论争与主体情绪的需要随物赋形。",
    "start": 54.48,
    "end": 59.28,
    "duration": 4.8
  },
  {
    "id": 14,
    "text": "他在随笔中自由调度逻辑议论、生活叙事、",
    "start": 59.28,
    "end": 62.96,
    "duration": 3.68
  },
  {
    "id": 15,
    "text": "主观抒情与历史联想。",
    "start": 62.96,
    "end": 65.04,
    "duration": 2.08
  },
  {
    "id": 16,
    "text": "从五四时期的《热风》到后期的《准风月谈》，",
    "start": 65.36,
    "end": 69.04,
    "duration": 3.68
  },
  {
    "id": 17,
    "text": "他的创作构成了现代中国活的“人史”，",
    "start": 69.04,
    "end": 72.4,
    "duration": 3.36
  },
  {
    "id": 18,
    "text": "细致解剖了现代中国人的心理结构与生存境遇。",
    "start": 72.4,
    "end": 76.56,
    "duration": 4.16
  },
  {
    "id": 19,
    "text": "其次，在思想特质上，鲁迅杂文体现出彻底的批判否定性与反常规的心理解剖思维。",
    "start": 76.56,
    "end": 84.32,
    "duration": 7.76
  },
  {
    "id": 20,
    "text": "鲁迅杂文始终保持着毫不妥协的怀疑精神。",
    "start": 84.32,
    "end": 87.84,
    "duration": 3.52
  },
  {
    "id": 21,
    "text": "这一批判不是虚无的情绪宣泄，而是始终贯穿着呼唤主体精神独立的“立人”理想。",
    "start": 88.08,
    "end": 94.56,
    "duration": 6.48
  },
  {
    "id": 22,
    "text": "面对复杂的社会现象，鲁迅创立了“正面文章反面看”的反常规思维路径。",
    "start": 94.56,
    "end": 100.56,
    "duration": 6.0
  },
  {
    "id": 23,
    "text": "在《论“他妈的”》中，他从日常粗话深挖到背后的门第观念与血统压迫。",
    "start": 100.56,
    "end": 106.32,
    "duration": 5.76
  },
  {
    "id": 24,
    "text": "在《魏晋风度及文章与药及酒之关系》中，",
    "start": 106.64,
    "end": 110.32,
    "duration": 3.68
  },
  {
    "id": 25,
    "text": "他洞察到表面反抗礼教的文人内心反而深藏着对崇高价值的执着。",
    "start": 110.32,
    "end": 116.56,
    "duration": 6.24
  },
  {
    "id": 26,
    "text": "这种穿透表象的认知机制，彻底撕碎了旧制度与旧礼教的伪善面具。",
    "start": 116.56,
    "end": 122.0,
    "duration": 5.44
  },
  {
    "id": 27,
    "text": "第三，在艺术思维上，鲁迅杂文实现了从具体个案到普遍社会精神现象的概括飞跃。",
    "start": 122.288,
    "end": 129.968,
    "duration": 7.68
  },
  {
    "id": 28,
    "text": "鲁迅的剖析从不流于抽象教条。",
    "start": 129.968,
    "end": 133.088,
    "duration": 3.12
  },
  {
    "id": 29,
    "text": "他总是抓住日常生活中的具体事件、",
    "start": 133.088,
    "end": 136.208,
    "duration": 3.12
  },
  {
    "id": 30,
    "text": "一句话或一个特定姿态作为解剖起点。",
    "start": 136.208,
    "end": 139.968,
    "duration": 3.76
  },
  {
    "id": 31,
    "text": "紧接着，鲁迅将具象个案置于长时段的历史长河与社会结构中持续开掘，",
    "start": 139.968,
    "end": 146.448,
    "duration": 6.48
  },
  {
    "id": 32,
    "text": "提炼出具有深刻讽刺意味与普遍概括力的社会类型共名。",
    "start": 146.448,
    "end": 150.928,
    "duration": 4.48
  },
  {
    "id": 33,
    "text": "他在论辩中创造了“叭儿狗”、“二丑”以及“带头羊”等经典符号。",
    "start": 151.168,
    "end": 156.208,
    "duration": 5.04
  },
  {
    "id": 34,
    "text": "在《论“费厄泼赖”应该缓行》中，",
    "start": 156.208,
    "end": 158.448,
    "duration": 2.24
  },
  {
    "id": 35,
    "text": "“叭儿狗”形象精准概括出依附权势而欺凌弱者的奴性人格，",
    "start": 158.448,
    "end": 163.968,
    "duration": 5.52
  },
  {
    "id": 36,
    "text": "使杂文获得了穿透时代的艺术生命力。",
    "start": 163.968,
    "end": 167.168,
    "duration": 3.2
  },
  {
    "id": 37,
    "text": "第四，在抒情格调与审美追求上，鲁迅杂文展现出客观人事经主体精神过滤后的深沉诗性。",
    "start": 167.168,
    "end": 174.928,
    "duration": 7.76
  },
  {
    "id": 38,
    "text": "鲁迅杂文绝非冷漠客观的纪实报道。",
    "start": 175.168,
    "end": 178.208,
    "duration": 3.04
  },
  {
    "id": 39,
    "text": "外部的现实危机与论战人事一旦进入鲁迅视野，",
    "start": 178.208,
    "end": 182.368,
    "duration": 4.16
  },
  {
    "id": 40,
    "text": "立刻会经过其炽热痛苦的生命体验的浸润，",
    "start": 182.368,
    "end": 186.128,
    "duration": 3.76
  },
  {
    "id": 41,
    "text": "转化为内在心灵的严峻搏斗。",
    "start": 186.128,
    "end": 188.768,
    "duration": 2.64
  },
  {
    "id": 42,
    "text": "在《记念刘和珍君》中，文本并未局限于揭露军阀暴行。",
    "start": 188.768,
    "end": 193.248,
    "duration": 4.48
  },
  {
    "id": 43,
    "text": "作品深层涌动着在“写与不写”、“沉默与爆发”之间剧烈撕扯的情感波澜。",
    "start": 193.248,
    "end": 198.688,
    "duration": 5.44
  },
  {
    "id": 44,
    "text": "这种强烈的生命痛苦赋予了杂文以沉郁顿挫的情感节奏。",
    "start": 199.088,
    "end": 204.208,
    "duration": 5.12
  },
  {
    "id": 45,
    "text": "冷峻的现实批判与炽烈的抒情力量在此交融，",
    "start": 204.208,
    "end": 208.128,
    "duration": 3.92
  },
  {
    "id": 46,
    "text": "杂文因而获得了震撼人心的诗性特质。",
    "start": 208.128,
    "end": 211.168,
    "duration": 3.04
  },
  {
    "id": 47,
    "text": "最后，在文体语言上，鲁迅杂文以反规范的拗体句式与庄谐杂糅创造了极具冲击力的语言张力。",
    "start": 211.168,
    "end": 219.888,
    "duration": 8.72
  },
  {
    "id": 48,
    "text": "鲁迅为了撕开温情虚伪的语言屏障，",
    "start": 220.128,
    "end": 223.088,
    "duration": 2.96
  },
  {
    "id": 49,
    "text": "故意打破常规的词语搭配习惯。",
    "start": 223.088,
    "end": 225.968,
    "duration": 2.88
  },
  {
    "id": 50,
    "text": "他在文本中创造了“有理的压迫”与“跪着的造反”等矛盾悖论修辞。",
    "start": 225.968,
    "end": 231.568,
    "duration": 5.6
  },
  {
    "id": 51,
    "text": "这种刺耳不谐的表达迫使读者直面现实名实分裂的残酷本质。",
    "start": 231.568,
    "end": 236.928,
    "duration": 5.36
  },
  {
    "id": 52,
    "text": "同时，鲁迅自由穿梭于古文典故、市井俗语与白话口语之间。",
    "start": 236.928,
    "end": 242.048,
    "duration": 5.12
  },
  {
    "id": 53,
    "text": "他在《商贾的批评》等篇章中大词小用且庄词谐用。",
    "start": 242.288,
    "end": 246.688,
    "duration": 4.4
  },
  {
    "id": 54,
    "text": "这种将崇高与荒唐并置的修辞策略，",
    "start": 246.688,
    "end": 249.728,
    "duration": 3.04
  },
  {
    "id": 55,
    "text": "产生了极具杀伤力的反讽美学力量。",
    "start": 249.728,
    "end": 252.768,
    "duration": 3.04
  },
  {
    "id": 56,
    "text": "综上所述，鲁迅杂文将战斗的社会功能与独立的文学品格高度统一。",
    "start": 252.768,
    "end": 258.608,
    "duration": 5.84
  },
  {
    "id": 57,
    "text": "它以“无体”的自由形式拓展了中国现代散文的审美边界。",
    "start": 258.608,
    "end": 262.848,
    "duration": 4.24
  },
  {
    "id": 58,
    "text": "它以深邃的启蒙批判、典型化的精神透视、",
    "start": 263.168,
    "end": 266.928,
    "duration": 3.76
  },
  {
    "id": 59,
    "text": "深沉的主观诗性与反规范的语言实验，",
    "start": 266.928,
    "end": 270.208,
    "duration": 3.28
  },
  {
    "id": 60,
    "text": "奠定了中国现代杂文的崇高美学巅峰。--",
    "start": 270.208,
    "end": 273.088,
    "duration": 2.88
  }
]