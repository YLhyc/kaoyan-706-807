[
  {
    "id": 1,
    "text": "试论鲁迅杂文的艺术特质与思想内涵。",
    "start": 0.086,
    "end": 3.562,
    "duration": 3.476
  },
  {
    "id": 2,
    "text": "鲁迅杂文是中国现代散文史与批评史上独步文坛的文体奇观。",
    "start": 3.752,
    "end": 8.703,
    "duration": 4.951
  },
  {
    "id": 3,
    "text": "在现代报刊媒介的催生下，",
    "start": 9.106,
    "end": 11.008,
    "duration": 1.902
  },
  {
    "id": 4,
    "text": "鲁迅将原本被视为边缘零碎的闲话杂感，",
    "start": 11.232,
    "end": 14.399,
    "duration": 3.167
  },
  {
    "id": 5,
    "text": "创造性地重构为直接介入现实社会搏斗的思想利刃。",
    "start": 14.679,
    "end": 18.318,
    "duration": 3.639
  },
  {
    "id": 6,
    "text": "它彻底打破了传统文章义理、考据、辞章的狭隘分界，",
    "start": 18.683,
    "end": 22.91,
    "duration": 4.227
  },
  {
    "id": 7,
    "text": "将敏锐的社会批判、深邃的文明解剖、",
    "start": 23.095,
    "end": 25.877,
    "duration": 2.782
  },
  {
    "id": 8,
    "text": "卓越的类型化创造与反规范的语言实验熔于一炉，",
    "start": 26.049,
    "end": 29.84,
    "duration": 3.791
  },
  {
    "id": 9,
    "text": "以彻底的否定性坚守现代“立人”理想，",
    "start": 30.108,
    "end": 32.828,
    "duration": 2.72
  },
  {
    "id": 10,
    "text": "铸就了兼具战斗性与诗性美学的现代自由文体巅峰。",
    "start": 33.087,
    "end": 36.863,
    "duration": 3.776
  },
  {
    "id": 11,
    "text": "其艺术特质与思想内涵主要体现在以下四个核心维度：",
    "start": 37.059,
    "end": 41.002,
    "duration": 3.943
  },
  {
    "id": 12,
    "text": "第一，确立“无体的自由文体”，",
    "start": 41.138,
    "end": 43.497,
    "duration": 2.359
  },
  {
    "id": 13,
    "text": "开创以现代报刊为媒介即时介入现实的斗争范式。",
    "start": 43.612,
    "end": 47.65,
    "duration": 4.038
  },
  {
    "id": 14,
    "text": "鲁迅杂文依托《新青年》《语丝》《申报·自由谈》等现代报刊而生，",
    "start": 47.834,
    "end": 52.317,
    "duration": 4.483
  },
  {
    "id": 15,
    "text": "天然具备迅速回应时代脉搏与社会思潮的敏锐性。",
    "start": 52.479,
    "end": 56.227,
    "duration": 3.748
  },
  {
    "id": 16,
    "text": "鲁迅倡导“无体即有体”，摆脱了传统散文、",
    "start": 56.419,
    "end": 59.9,
    "duration": 3.481
  },
  {
    "id": 17,
    "text": "史传与论说的僵化程式，根据论辩需求与主体心境随物赋形，",
    "start": 59.9,
    "end": 64.957,
    "duration": 5.057
  },
  {
    "id": 18,
    "text": "自由穿梭于严密逻辑论证、生活场景叙事、",
    "start": 65.054,
    "end": 68.564,
    "duration": 3.51
  },
  {
    "id": 19,
    "text": "主观激情抒发与深邃历史考据之间。",
    "start": 68.688,
    "end": 71.835,
    "duration": 3.147
  },
  {
    "id": 20,
    "text": "从早期的《热风》到后期的《准风月谈》，",
    "start": 71.892,
    "end": 74.912,
    "duration": 3.02
  },
  {
    "id": 21,
    "text": "这一文体演变为一部现代中国活的“人史”，",
    "start": 74.976,
    "end": 78.114,
    "duration": 3.138
  },
  {
    "id": 22,
    "text": "构成了对半殖民地半封建社会中国人精神图谱最微观的文学记录。第二，",
    "start": 78.194,
    "end": 84.176,
    "duration": 5.982
  },
  {
    "id": 23,
    "text": "坚持彻底的批判否定性与“正面文章反面看”的反常规多疑思维。",
    "start": 84.498,
    "end": 90.035,
    "duration": 5.537
  },
  {
    "id": 24,
    "text": "鲁迅杂文的批判锋芒从不停留在政治权力的表层对抗，",
    "start": 90.571,
    "end": 94.57,
    "duration": 3.999
  },
  {
    "id": 25,
    "text": "而是以现代启蒙“立人”为精神轴心，",
    "start": 94.946,
    "end": 97.645,
    "duration": 2.699
  },
  {
    "id": 26,
    "text": "对一切压抑生命自由的宗法旧礼教、",
    "start": 97.831,
    "end": 100.806,
    "duration": 2.975
  },
  {
    "id": 27,
    "text": "等级专制与奴性人格展开绝不妥协的精神解剖。",
    "start": 101.099,
    "end": 105.157,
    "duration": 4.058
  },
  {
    "id": 28,
    "text": "面对错综复杂的社会现象，",
    "start": 105.377,
    "end": 107.316,
    "duration": 1.939
  },
  {
    "id": 29,
    "text": "鲁迅创立了独具一格的“正面文章反面看”的多疑认知方法：",
    "start": 107.712,
    "end": 112.335,
    "duration": 4.623
  },
  {
    "id": 30,
    "text": "在《论“他妈的”》中，他从小民的日常国骂抽丝剥茧，",
    "start": 112.798,
    "end": 116.695,
    "duration": 3.897
  },
  {
    "id": 31,
    "text": "直击背后门第等级观念与血统压迫的荒谬；",
    "start": 117.064,
    "end": 120.617,
    "duration": 3.553
  },
  {
    "id": 32,
    "text": "在《小杂感》与《魏晋风度及文章与药及酒之关系》中，",
    "start": 121.175,
    "end": 125.191,
    "duration": 4.016
  },
  {
    "id": 33,
    "text": "他以逆向思维刺破正人君子与名士风流的伪善外壳。",
    "start": 125.474,
    "end": 129.863,
    "duration": 4.389
  },
  {
    "id": 34,
    "text": "这种直击事物骨髓的冷峻解剖，展现了深刻的认识论力量。",
    "start": 130.102,
    "end": 134.376,
    "duration": 4.274
  },
  {
    "id": 35,
    "text": "第三，践行“由个入类”的文学典型化，",
    "start": 134.643,
    "end": 137.812,
    "duration": 3.169
  },
  {
    "id": 36,
    "text": "创造具有普遍概括力的社会类型共名。",
    "start": 138.018,
    "end": 140.857,
    "duration": 2.839
  },
  {
    "id": 37,
    "text": "鲁迅杂文的现实介入绝非就事论事的短浅时评，",
    "start": 141.527,
    "end": 145.081,
    "duration": 3.554
  },
  {
    "id": 38,
    "text": "而是极善于抓住日常生活中的某一具体个案、甚至“一鼻、",
    "start": 145.472,
    "end": 150.046,
    "duration": 4.574
  },
  {
    "id": 39,
    "text": "一嘴、一毛”的细微病态姿态作为起点，",
    "start": 150.171,
    "end": 152.93,
    "duration": 2.759
  },
  {
    "id": 40,
    "text": "进而将其置于几千年的文明历史长河中持续勘探，",
    "start": 153.391,
    "end": 156.991,
    "duration": 3.6
  },
  {
    "id": 41,
    "text": "提炼出超越具体人事的普遍社会人格符号。",
    "start": 157.358,
    "end": 160.556,
    "duration": 3.198
  },
  {
    "id": 42,
    "text": "他在《论“费厄泼赖”应该缓行》中由落水狗的论争概括出依附豪强、",
    "start": 160.807,
    "end": 166.937,
    "duration": 6.13
  },
  {
    "id": 43,
    "text": "反咬弱者的“叭儿狗”典型；在论战中创造了假充中立、",
    "start": 166.994,
    "end": 171.538,
    "duration": 4.544
  },
  {
    "id": 44,
    "text": "实为帮凶的“二丑”与诱骗民众走向屠场的“带头羊”。",
    "start": 171.758,
    "end": 175.993,
    "duration": 4.235
  },
  {
    "id": 45,
    "text": "这些艺术共名使具体杂感超越了论争时效，",
    "start": 176.024,
    "end": 179.586,
    "duration": 3.562
  },
  {
    "id": 46,
    "text": "获得了穿越百年历史的超拔生命力。",
    "start": 179.738,
    "end": 182.561,
    "duration": 2.823
  },
  {
    "id": 47,
    "text": "第四，熔铸深沉悲怆的主观诗性，",
    "start": 182.803,
    "end": 185.761,
    "duration": 2.958
  },
  {
    "id": 48,
    "text": "开创反规范拗体与庄谐杂糅的反讽语言。",
    "start": 185.934,
    "end": 189.715,
    "duration": 3.781
  },
  {
    "id": 49,
    "text": "鲁迅杂文绝非冷漠的客观政论，外部社会危机一旦进入其笔端，",
    "start": 190.005,
    "end": 195.161,
    "duration": 5.156
  },
  {
    "id": 50,
    "text": "立刻经过其炽热痛苦的生命体验过滤，",
    "start": 195.376,
    "end": 198.367,
    "duration": 2.991
  },
  {
    "id": 51,
    "text": "转化为内心严峻的心灵搏斗。",
    "start": 198.675,
    "end": 200.895,
    "duration": 2.22
  },
  {
    "id": 52,
    "text": "在《记念刘和珍君》中，沉痛的祭奠在“沉默与爆发”、",
    "start": 201.222,
    "end": 205.083,
    "duration": 3.861
  },
  {
    "id": 53,
    "text": "“写与不写”的剧烈张力中起伏回荡，",
    "start": 205.312,
    "end": 207.571,
    "duration": 2.259
  },
  {
    "id": 54,
    "text": "展现出交响乐般沉郁顿挫的诗性力量。",
    "start": 207.571,
    "end": 211.365,
    "duration": 3.794
  },
  {
    "id": 55,
    "text": "在语言创造上，鲁迅故意打破常规词语搭配习惯，",
    "start": 211.607,
    "end": 215.839,
    "duration": 4.232
  },
  {
    "id": 56,
    "text": "创造出“有理的压迫”、",
    "start": 215.894,
    "end": 217.485,
    "duration": 1.591
  },
  {
    "id": 57,
    "text": "“跪着的造反”等充满张力的反规范拗体，",
    "start": 217.753,
    "end": 221.12,
    "duration": 3.367
  },
  {
    "id": 58,
    "text": "以刺耳不谐的语词逼迫读者直面真实；",
    "start": 221.159,
    "end": 224.371,
    "duration": 3.212
  },
  {
    "id": 59,
    "text": "同时娴熟运用古雅典故与市井俗语的庄谐杂糅，",
    "start": 224.849,
    "end": 229.002,
    "duration": 4.153
  },
  {
    "id": 60,
    "text": "以大词小用与庄词谐用形成了杀伤力极强的荒诞反讽风格。",
    "start": 229.325,
    "end": 234.763,
    "duration": 5.438
  },
  {
    "id": 61,
    "text": "综上所述，",
    "start": 234.966,
    "end": 235.747,
    "duration": 0.781
  },
  {
    "id": 62,
    "text": "鲁迅杂文实现了战斗社会功能与崇高文学品格的完美交融。",
    "start": 236.155,
    "end": 240.893,
    "duration": 4.738
  },
  {
    "id": 63,
    "text": "他以现代散文的自由形式，",
    "start": 241.321,
    "end": 243.107,
    "duration": 1.786
  },
  {
    "id": 64,
    "text": "开拓了中国现代文学批判现实主义与主观抒情相统一的全新疆界，",
    "start": 243.325,
    "end": 248.731,
    "duration": 5.406
  },
  {
    "id": 65,
    "text": "立下了一座不可逾越的艺术丰碑。",
    "start": 248.979,
    "end": 251.568,
    "duration": 2.589
  }
]
