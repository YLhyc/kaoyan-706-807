[
  {
    "id": 1,
    "text": "试论鲁迅杂文的艺术特质与思想内涵。",
    "start": 0.16,
    "end": 3.354,
    "duration": 3.194
  },
  {
    "id": 2,
    "text": "鲁迅杂文是中国现代散文史与批评史上独步文坛的文体奇观。",
    "start": 3.663,
    "end": 9.108,
    "duration": 5.445
  },
  {
    "id": 3,
    "text": "在现代报刊媒介的催生下，",
    "start": 9.354,
    "end": 11.099,
    "duration": 1.745
  },
  {
    "id": 4,
    "text": "鲁迅将原本被视为边缘零碎的闲话杂感，",
    "start": 11.348,
    "end": 14.528,
    "duration": 3.18
  },
  {
    "id": 5,
    "text": "重构为直接介入现实社会搏斗的思想利刃。",
    "start": 14.664,
    "end": 18.183,
    "duration": 3.519
  },
  {
    "id": 6,
    "text": "它打破了传统文章义理、考据、辞章的狭隘分界，",
    "start": 18.337,
    "end": 22.334,
    "duration": 3.997
  },
  {
    "id": 7,
    "text": "将敏锐的社会批判、深刻的文明解剖、",
    "start": 22.593,
    "end": 25.704,
    "duration": 3.111
  },
  {
    "id": 8,
    "text": "卓越的类型化创造与反规范的语言实验融为一体，",
    "start": 26.249,
    "end": 30.534,
    "duration": 4.285
  },
  {
    "id": 9,
    "text": "坚守现代“立人”理想，",
    "start": 30.989,
    "end": 32.679,
    "duration": 1.69
  },
  {
    "id": 10,
    "text": "铸就了兼具战斗性与诗性美学的现代自由文体典范。",
    "start": 33.101,
    "end": 37.579,
    "duration": 4.478
  },
  {
    "id": 11,
    "text": "其艺术特质与思想内涵主要体现在以下四个核心维度：",
    "start": 37.881,
    "end": 42.452,
    "duration": 4.571
  },
  {
    "id": 12,
    "text": "第一，确立“无体的自由文体”，",
    "start": 43.118,
    "end": 45.449,
    "duration": 2.331
  },
  {
    "id": 13,
    "text": "开创以现代报刊为媒介即时介入现实的斗争范式。",
    "start": 45.785,
    "end": 49.747,
    "duration": 3.962
  },
  {
    "id": 14,
    "text": "鲁迅杂文依托《新青年》《语丝》及《申报·自由谈》等现代报刊而生，",
    "start": 50.104,
    "end": 54.991,
    "duration": 4.887
  },
  {
    "id": 15,
    "text": "天然具备迅速回应时代脉搏与社会思潮的敏锐性。",
    "start": 55.366,
    "end": 59.191,
    "duration": 3.825
  },
  {
    "id": 16,
    "text": "鲁迅倡导“无体即有体”，摆脱了传统散文、",
    "start": 59.717,
    "end": 63.056,
    "duration": 3.339
  },
  {
    "id": 17,
    "text": "史传与论说的僵化程式，根据论辩需求与主体心境随物赋形，",
    "start": 63.361,
    "end": 68.952,
    "duration": 5.591
  },
  {
    "id": 18,
    "text": "自由穿梭于严密逻辑论证、生活场景叙事、",
    "start": 69.083,
    "end": 72.476,
    "duration": 3.393
  },
  {
    "id": 19,
    "text": "主观激情抒发与深厚历史考据之间。",
    "start": 72.598,
    "end": 75.6,
    "duration": 3.002
  },
  {
    "id": 20,
    "text": "从早期的《热风》到后期的《准风月谈》，",
    "start": 75.731,
    "end": 78.57,
    "duration": 2.839
  },
  {
    "id": 21,
    "text": "这一文体演变为一部现代中国活的“人史”，",
    "start": 78.715,
    "end": 82.141,
    "duration": 3.426
  },
  {
    "id": 22,
    "text": "构成了对半殖民地半封建社会中国人精神图谱最微观的文学记录。",
    "start": 82.42,
    "end": 87.672,
    "duration": 5.252
  },
  {
    "id": 23,
    "text": "第二，",
    "start": 88.299,
    "end": 88.649,
    "duration": 0.35
  },
  {
    "id": 24,
    "text": "坚持决不妥协的批判否定性与“正面文章反面看”的反常规多疑思维。",
    "start": 88.832,
    "end": 94.528,
    "duration": 5.696
  },
  {
    "id": 25,
    "text": "鲁迅杂文的批判锋芒从不停留在政治权力的表层对抗，",
    "start": 95.005,
    "end": 99.199,
    "duration": 4.194
  },
  {
    "id": 26,
    "text": "而是以现代启蒙“立人”为精神轴心，",
    "start": 99.427,
    "end": 102.126,
    "duration": 2.699
  },
  {
    "id": 27,
    "text": "对一切压抑生命自由的宗法旧礼教、",
    "start": 102.5,
    "end": 105.117,
    "duration": 2.617
  },
  {
    "id": 28,
    "text": "等级专制与奴性人格展开毫不含糊的精神解剖。",
    "start": 105.665,
    "end": 109.162,
    "duration": 3.497
  },
  {
    "id": 29,
    "text": "面对错综复杂的社会现象，",
    "start": 109.424,
    "end": 111.404,
    "duration": 1.98
  },
  {
    "id": 30,
    "text": "鲁迅创立了独具一格的“正面文章反面看”的多疑认知方法：",
    "start": 111.803,
    "end": 116.394,
    "duration": 4.591
  },
  {
    "id": 31,
    "text": "在《论“他妈的”》中，他从小民的日常国骂抽丝剥茧，",
    "start": 117.04,
    "end": 121.068,
    "duration": 4.028
  },
  {
    "id": 32,
    "text": "直击背后门第等级观念与血统压迫的荒谬；",
    "start": 121.618,
    "end": 125.096,
    "duration": 3.478
  },
  {
    "id": 33,
    "text": "在《小杂感》与《魏晋风度及文章与药及酒之关系》中，",
    "start": 125.627,
    "end": 129.876,
    "duration": 4.249
  },
  {
    "id": 34,
    "text": "他以逆向思维刺破正人君子与名士风流的伪善外壳。",
    "start": 130.137,
    "end": 134.408,
    "duration": 4.271
  },
  {
    "id": 35,
    "text": "这种直击事物骨髓的冷峻解剖，展现了深刻的认识论力量。",
    "start": 134.818,
    "end": 139.061,
    "duration": 4.243
  },
  {
    "id": 36,
    "text": "第三，践行“由个入类”的文学典型化，",
    "start": 139.723,
    "end": 142.983,
    "duration": 3.26
  },
  {
    "id": 37,
    "text": "创造具有普遍概括力的社会类型共名。",
    "start": 143.353,
    "end": 146.461,
    "duration": 3.108
  },
  {
    "id": 38,
    "text": "鲁迅杂文的现实介入从不流于就事论事的短浅时评，",
    "start": 146.986,
    "end": 151.266,
    "duration": 4.28
  },
  {
    "id": 39,
    "text": "而是善于抓住日常生活中的某一具体个案、甚至“一鼻、一嘴、",
    "start": 151.607,
    "end": 156.599,
    "duration": 4.992
  },
  {
    "id": 40,
    "text": "一毛”的细微病态姿态作为起点，",
    "start": 156.716,
    "end": 159.386,
    "duration": 2.67
  },
  {
    "id": 41,
    "text": "将其置于几千年的文明历史长河中持续勘探，",
    "start": 159.641,
    "end": 163.176,
    "duration": 3.535
  },
  {
    "id": 42,
    "text": "提炼出超越具体人事的普遍社会人格符号。",
    "start": 163.661,
    "end": 167.045,
    "duration": 3.384
  },
  {
    "id": 43,
    "text": "他在《论“费厄泼赖”应该缓行》中由落水狗的论争概括出依附豪强、",
    "start": 167.597,
    "end": 173.185,
    "duration": 5.588
  },
  {
    "id": 44,
    "text": "反咬弱者的“叭儿狗”典型；在论战中创造了假充中立、",
    "start": 173.636,
    "end": 177.939,
    "duration": 4.303
  },
  {
    "id": 45,
    "text": "实为帮凶的“二丑”与诱骗民众走向屠场的“带头羊”。",
    "start": 178.487,
    "end": 182.274,
    "duration": 3.787
  },
  {
    "id": 46,
    "text": "这些艺术共名使具体杂感超越了论争时效，",
    "start": 182.516,
    "end": 186.443,
    "duration": 3.927
  },
  {
    "id": 47,
    "text": "获得了穿越历史的长久生命力。",
    "start": 186.778,
    "end": 189.12,
    "duration": 2.342
  },
  {
    "id": 48,
    "text": "第四，蕴含深沉悲怆的主观诗性，",
    "start": 189.764,
    "end": 192.494,
    "duration": 2.73
  },
  {
    "id": 49,
    "text": "开创反规范拗体与庄谐杂糅的反讽语言。",
    "start": 192.639,
    "end": 196.13,
    "duration": 3.491
  },
  {
    "id": 50,
    "text": "鲁迅杂文从不是冷漠的客观政论，",
    "start": 196.649,
    "end": 198.877,
    "duration": 2.228
  },
  {
    "id": 51,
    "text": "外部社会危机一旦进入其笔端，",
    "start": 199.202,
    "end": 201.31,
    "duration": 2.108
  },
  {
    "id": 52,
    "text": "立刻经过其炽热痛苦的生命体验过滤，",
    "start": 201.457,
    "end": 204.456,
    "duration": 2.999
  },
  {
    "id": 53,
    "text": "转化为内心严峻的心灵搏斗。",
    "start": 204.605,
    "end": 206.914,
    "duration": 2.309
  },
  {
    "id": 54,
    "text": "在《记念刘和珍君》中，沉痛的祭奠在“沉默与爆发”、",
    "start": 207.183,
    "end": 211.212,
    "duration": 4.029
  },
  {
    "id": 55,
    "text": "“写与不写”的剧烈张力中起伏回荡，",
    "start": 211.519,
    "end": 214.363,
    "duration": 2.844
  },
  {
    "id": 56,
    "text": "展现出交响乐般沉郁顿挫的诗性力量。",
    "start": 214.839,
    "end": 217.94,
    "duration": 3.101
  },
  {
    "id": 57,
    "text": "在语言创造上，鲁迅故意打破常规词语搭配习惯，",
    "start": 218.633,
    "end": 222.715,
    "duration": 4.082
  },
  {
    "id": 58,
    "text": "创造出“有理的压迫”、",
    "start": 223.075,
    "end": 224.656,
    "duration": 1.581
  },
  {
    "id": 59,
    "text": "“跪着的造反”等充满张力的反规范拗体，",
    "start": 225.317,
    "end": 228.534,
    "duration": 3.217
  },
  {
    "id": 60,
    "text": "以刺耳不谐的语词逼迫读者直面真实；",
    "start": 228.933,
    "end": 232.156,
    "duration": 3.223
  },
  {
    "id": 61,
    "text": "同时娴熟运用古雅典故与市井俗语的庄谐杂糅，",
    "start": 232.49,
    "end": 236.809,
    "duration": 4.319
  },
  {
    "id": 62,
    "text": "以大词小用与庄词谐用形成了锋芒锐利的荒诞反讽风格。",
    "start": 237.328,
    "end": 242.41,
    "duration": 5.082
  },
  {
    "id": 63,
    "text": "合而观之，鲁迅杂文将战斗的社会功能与崇高的文学品格融为一体。",
    "start": 243.042,
    "end": 248.774,
    "duration": 5.732
  },
  {
    "id": 64,
    "text": "他以现代散文的自由形式，",
    "start": 249.218,
    "end": 251.072,
    "duration": 1.854
  },
  {
    "id": 65,
    "text": "开拓了中国现代文学批判现实主义与主观抒情相统一的全新疆界，",
    "start": 251.406,
    "end": 256.639,
    "duration": 5.233
  },
  {
    "id": 66,
    "text": "树立了难以企及的艺术典范。",
    "start": 256.834,
    "end": 258.925,
    "duration": 2.091
  }
]