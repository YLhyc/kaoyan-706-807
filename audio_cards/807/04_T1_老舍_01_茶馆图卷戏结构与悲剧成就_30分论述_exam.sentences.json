[
  {
    "id": 1,
    "text": "试论老舍话剧《茶馆》的艺术成就与悲剧意蕴。",
    "start": 0.154,
    "end": 3.326,
    "duration": 3.172
  },
  {
    "id": 2,
    "text": "老舍晚期创作的三幕话剧《茶馆》，是中国现当代现实主义戏剧的扛鼎之作，也是中国话剧民族化探索的典范。",
    "start": 4.043,
    "end": 12.775,
    "duration": 8.732
  },
  {
    "id": 3,
    "text": "剧作截取清末戊戌变法失败、民国初年军阀混战与抗战胜利后国民党政权崩溃前夕三个历史断面，",
    "start": 13.453,
    "end": 21.785,
    "duration": 8.332
  },
  {
    "id": 4,
    "text": "通过北京裕泰茶馆半个世纪的沉浮衰亡，为黑暗旧中国谱写了一曲沉痛而辛辣的时代挽歌。",
    "start": 22.335,
    "end": 29.547,
    "duration": 7.212
  },
  {
    "id": 5,
    "text": "老舍以独创的“图卷戏”散点透视结构、丰厚的人物群像、悲喜交融的幽默意象与纯正的京味语言，",
    "start": 30.363,
    "end": 37.815,
    "duration": 7.452
  },
  {
    "id": 6,
    "text": "宣告了旧时代灭亡的历史必然性。",
    "start": 38.194,
    "end": 40.646,
    "duration": 2.452
  },
  {
    "id": 7,
    "text": "其成就主要体现在以下五个维度：",
    "start": 41.324,
    "end": 49.136,
    "duration": 7.812
  },
  {
    "id": 8,
    "text": "第一，独创“图卷戏”三幕结构，突破西方锁闭式传统戏剧的成规。",
    "start": 49.814,
    "end": 60.186,
    "duration": 10.372
  },
  {
    "id": 9,
    "text": "《茶馆》打破了西方古典戏剧依赖单一贯穿主角与严密因果锁闭冲突的既定模式，",
    "start": 60.904,
    "end": 65.836,
    "duration": 4.932
  },
  {
    "id": 10,
    "text": "借鉴中国古代长卷画（如《清明上河图》）的散点透视法则。",
    "start": 66.215,
    "end": 69.267,
    "duration": 3.052
  },
  {
    "id": 11,
    "text": "老舍以裕泰茶馆为中心社会枢纽，全剧不设贯穿到底的情节主线，",
    "start": 69.985,
    "end": 73.357,
    "duration": 3.372
  },
  {
    "id": 12,
    "text": "而是由数十个生动市井生活截面连缀而成。",
    "start": 73.736,
    "end": 76.948,
    "duration": 3.212
  },
  {
    "id": 13,
    "text": "三幕戏如同一幅徐徐展开的世俗风情长卷，将清末至民国乱世的黑暗现实娓娓道出；",
    "start": 77.626,
    "end": 80.398,
    "duration": 2.772
  },
  {
    "id": 14,
    "text": "全剧看似形散，内在却被社会一步步走向溃烂的沉痛暗线牢牢统摄，",
    "start": 80.927,
    "end": 83.499,
    "duration": 2.572
  },
  {
    "id": 15,
    "text": "达到“形散而神聚”的艺术境界。",
    "start": 83.878,
    "end": 86.05,
    "duration": 2.172
  },
  {
    "id": 16,
    "text": "第二，以庞大群像谱系度量时代崩塌，确立“没有主角的主角是时代”的深刻立意。",
    "start": 86.688,
    "end": 92.82,
    "duration": 6.132
  },
  {
    "id": 17,
    "text": "全剧登场人物多达七十余人，老舍精准截取每个人物在不同历史时期的一段生活切片。",
    "start": 93.458,
    "end": 100.07,
    "duration": 6.612
  },
  {
    "id": 18,
    "text": "最为震撼的是王利发、常四爷与秦仲义构成的“三位一体”悲剧：",
    "start": 100.748,
    "end": 105.32,
    "duration": 4.572
  },
  {
    "id": 19,
    "text": "精明本分、委曲求全的小商人王利发，最终在茶馆被特务霸占后自缢后房；",
    "start": 105.699,
    "end": 111.431,
    "duration": 5.732
  },
  {
    "id": 20,
    "text": "刚正耿直、自食其力的硬汉常四爷，到头来冻饿交加，连一口棺材都买不起；",
    "start": 111.96,
    "end": 116.332,
    "duration": 4.372
  },
  {
    "id": 21,
    "text": "立志“实业救国”的民族资本家秦仲义，耗尽心血办厂却被反动政府作为逆产没收拆毁。",
    "start": 116.887,
    "end": 125.179,
    "duration": 8.292
  },
  {
    "id": 22,
    "text": "三位不同阶层的好人走向共同的灭顶之灾，有力证明真正被押上历史审判台的是吃人的旧制度。",
    "start": 125.708,
    "end": 133.69,
    "duration": 7.982
  },
  {
    "id": 23,
    "text": "第三，营造悲喜交融的幽默格调，以“三老汉撒纸钱”写就象征华彩。",
    "start": 134.314,
    "end": 139.566,
    "duration": 5.252
  },
  {
    "id": 24,
    "text": "老舍将融汇英式幽默与民族悲剧心理的“含泪微笑”推向高峰，",
    "start": 140.095,
    "end": 145.957,
    "duration": 5.862
  },
  {
    "id": 25,
    "text": "善于以喜剧形式反衬严酷的生存荒谬。",
    "start": 146.336,
    "end": 149.268,
    "duration": 2.932
  },
  {
    "id": 26,
    "text": "第三幕结尾处，王利发、常四爷与秦仲义三位白发老人重聚，",
    "start": 149.797,
    "end": 156.139,
    "duration": 6.342
  },
  {
    "id": 27,
    "text": "在穷途末路中以狂笑写至痛，互相作揖、漫天抛撒捡来的冥纸。",
    "start": 156.518,
    "end": 161.08,
    "duration": 4.562
  },
  {
    "id": 28,
    "text": "这一极富现代象征意蕴的仪式，既是老人们活着为自己凄凉出殡，",
    "start": 161.609,
    "end": 167.231,
    "duration": 5.622
  },
  {
    "id": 29,
    "text": "更是为半个世纪的三个黑暗旧时代举行了一场盛大而辛辣的葬礼。",
    "start": 167.61,
    "end": 172.302,
    "duration": 4.692
  },
  {
    "id": 30,
    "text": "第四，提炼纯正洗练的京味语言，树立中国现当代白话话剧语言的典范。",
    "start": 172.94,
    "end": 178.192,
    "duration": 5.252
  },
  {
    "id": 31,
    "text": "《茶馆》扫除了早期话剧中的欧化翻译腔与概念化说教，",
    "start": 178.87,
    "end": 182.842,
    "duration": 3.972
  },
  {
    "id": 32,
    "text": "将地道的老北京市民口语提炼为富有诗意与潜台词的舞台语言。",
    "start": 183.221,
    "end": 188.033,
    "duration": 4.812
  },
  {
    "id": 33,
    "text": "老舍的台词“一句顶十句”，高度个性化：",
    "start": 188.831,
    "end": 191.523,
    "duration": 2.692
  },
  {
    "id": 34,
    "text": "唐铁嘴的无耻俏皮、宋恩子与吴祥子的阴阳怪气、常四爷的刚正硬朗，无不跃然台上。",
    "start": 191.902,
    "end": 198.954,
    "duration": 7.052
  },
  {
    "id": 35,
    "text": "幽默的市井调侃化作底层弱者对抗苦难的精神护甲，极富文学张力与咀嚼感。",
    "start": 199.483,
    "end": 206.425,
    "duration": 6.942
  },
  {
    "id": 36,
    "text": "第五，蕴含深沉的历史哲学反思，昭示旧制度灭亡的历史必然性。",
    "start": 207.063,
    "end": 212.275,
    "duration": 5.212
  },
  {
    "id": 37,
    "text": "全剧未正面描写枪林弹雨与政党交锋，却通过一座小茶馆的盛极而衰，",
    "start": 212.804,
    "end": 218.986,
    "duration": 6.182
  },
  {
    "id": 38,
    "text": "以冷峻的写实逻辑解答了重大历史命题：",
    "start": 219.704,
    "end": 222.836,
    "duration": 3.132
  },
  {
    "id": 39,
    "text": "无论是王利发的改良自保、常四爷的道德自救，还是秦仲义的实业救国，在旧体制下全属幻想。",
    "start": 223.215,
    "end": 230.627,
    "duration": 7.412
  },
  {
    "id": 40,
    "text": "剧作通过三个好人的全面破灭，为旧时代判处了无可挽回的死刑，",
    "start": 231.38,
    "end": 236.272,
    "duration": 4.892
  },
  {
    "id": 41,
    "text": "昭示唯有根本的社会变革才是人民的生路。",
    "start": 236.651,
    "end": 239.823,
    "duration": 3.172
  },
  {
    "id": 42,
    "text": "通观全剧，《茶馆》在结构创新、群像度量、象征意象、语言造诣与历史反思上均达到极高的艺术水准，",
    "start": 240.352,
    "end": 248.364,
    "duration": 8.012
  },
  {
    "id": 43,
    "text": "是无愧于中国现当代戏剧史的传世经典。",
    "start": 248.743,
    "end": 251.795,
    "duration": 3.052
  }
]