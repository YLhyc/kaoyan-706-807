[
  {
    "id": 1,
    "text": "老舍的三幕话剧《茶馆》是中国现代话剧现实主义的扛鼎之作，",
    "start": 0.16,
    "end": 5.44,
    "duration": 5.28
  },
  {
    "id": 2,
    "text": "更是中国话剧民族化探索的最高巅峰。",
    "start": 5.44,
    "end": 8.64,
    "duration": 3.2
  },
  {
    "id": 3,
    "text": "剧作截取清末戊戌维新失败、民国初年军阀混战与抗战胜利后国民党统治崩溃前夕三个历史横断面。",
    "start": 8.64,
    "end": 17.2,
    "duration": 8.56
  },
  {
    "id": 4,
    "text": "它以北京裕泰茶馆半个世纪的兴衰变迁，",
    "start": 17.2,
    "end": 20.4,
    "duration": 3.2
  },
  {
    "id": 5,
    "text": "为黑暗旧中国谱写了一曲沉痛恢宏的时代挽歌。",
    "start": 20.4,
    "end": 24.4,
    "duration": 4.0
  },
  {
    "id": 6,
    "text": "老舍打破了西方传统戏剧的锁闭式藩篱。",
    "start": 24.64,
    "end": 27.92,
    "duration": 3.28
  },
  {
    "id": 7,
    "text": "他以独创的“图卷戏”散点透视结构、",
    "start": 27.92,
    "end": 31.04,
    "duration": 3.12
  },
  {
    "id": 8,
    "text": "卓越的人物群像度量、悲喜交融的幽默意象与炉火纯青的京味语言，",
    "start": 31.04,
    "end": 37.04,
    "duration": 6.0
  },
  {
    "id": 9,
    "text": "宣告了旧时代灭亡的必然宿命。",
    "start": 37.04,
    "end": 39.52,
    "duration": 2.48
  },
  {
    "id": 10,
    "text": "首先，在戏剧结构上，老舍独创了“图卷戏”的散点透视三幕结构，",
    "start": 39.52,
    "end": 45.2,
    "duration": 5.68
  },
  {
    "id": 11,
    "text": "实现了对西方传统戏剧范式的审美超越。",
    "start": 45.2,
    "end": 48.16,
    "duration": 2.96
  },
  {
    "id": 12,
    "text": "《茶馆》打破了西方古典戏剧必须依赖单一戏剧冲突或单一家室盛衰的因果锁闭模式。",
    "start": 48.24,
    "end": 55.215,
    "duration": 6.975
  },
  {
    "id": 13,
    "text": "老舍创造性地借鉴了中国古代长卷画《清明上河图》的散点透视法则。",
    "start": 55.215,
    "end": 60.795,
    "duration": 5.58
  },
  {
    "id": 14,
    "text": "他以裕泰茶馆为中心社会枢纽，全剧没有贯穿到底的情节主线，",
    "start": 60.795,
    "end": 65.976,
    "duration": 5.181
  },
  {
    "id": 15,
    "text": "而是由数十个散碎生动的市井生活片段有机连缀而成。",
    "start": 65.976,
    "end": 70.56,
    "duration": 4.584
  },
  {
    "id": 16,
    "text": "三幕戏如同一幅徐徐展开的世俗风情长卷。",
    "start": 70.72,
    "end": 74.4,
    "duration": 3.68
  },
  {
    "id": 17,
    "text": "它将半个世纪由封建晚清到民国乱世的黑暗现实生动展览。",
    "start": 74.4,
    "end": 79.84,
    "duration": 5.44
  },
  {
    "id": 18,
    "text": "剧作看似形散，内在却被时代步步走向溃烂的沉痛暗线牢牢统摄，",
    "start": 79.84,
    "end": 85.68,
    "duration": 5.84
  },
  {
    "id": 19,
    "text": "达到了形散而神聚的高超化境。",
    "start": 85.68,
    "end": 88.72,
    "duration": 3.04
  },
  {
    "id": 20,
    "text": "其次，在人物塑造上，剧作以卓越的群像谱系度量宏大时代的崩塌，",
    "start": 88.72,
    "end": 94.8,
    "duration": 6.08
  },
  {
    "id": 21,
    "text": "确立了“没有主角的主角是时代”的深刻立意。",
    "start": 94.8,
    "end": 98.16,
    "duration": 3.36
  },
  {
    "id": 22,
    "text": "全剧登场人物多达七十余人。",
    "start": 98.48,
    "end": 101.12,
    "duration": 2.64
  },
  {
    "id": 23,
    "text": "老舍精湛地截取了每个人物在不同历史时期的一截生活切片。",
    "start": 101.12,
    "end": 106.4,
    "duration": 5.28
  },
  {
    "id": 24,
    "text": "最震撼人心的是王利发、常四爷与秦仲义构成的三位一体悲剧。",
    "start": 106.4,
    "end": 112.72,
    "duration": 6.32
  },
  {
    "id": 25,
    "text": "精明本分、委曲求全以求生存的小商人王利发，",
    "start": 112.72,
    "end": 116.88,
    "duration": 4.16
  },
  {
    "id": 26,
    "text": "最终在茶馆被霸占后自义身亡。",
    "start": 116.88,
    "end": 119.6,
    "duration": 2.72
  },
  {
    "id": 27,
    "text": "刚正耿直、自食其力的硬汉常四爷，",
    "start": 119.84,
    "end": 123.04,
    "duration": 3.2
  },
  {
    "id": 28,
    "text": "到头来冻饿交加，靠卖花生仁沦为街头流民。",
    "start": 123.04,
    "end": 127.68,
    "duration": 4.64
  },
  {
    "id": 29,
    "text": "立志实业救国的民族资本家秦仲义，",
    "start": 127.68,
    "end": 130.96,
    "duration": 3.28
  },
  {
    "id": 30,
    "text": "耗尽心血办厂却被反动政权当作逆产拆毁。",
    "start": 130.96,
    "end": 135.12,
    "duration": 4.16
  },
  {
    "id": 31,
    "text": "三位不同阶层的好人共同走向绝境，",
    "start": 135.12,
    "end": 138.48,
    "duration": 3.36
  },
  {
    "id": 32,
    "text": "雄辩地证明了真正被押上历史审判台的是那吃人的黑暗制度。",
    "start": 138.48,
    "end": 144.0,
    "duration": 5.52
  },
  {
    "id": 33,
    "text": "第三，在美学格调上，剧作展现了悲喜交融的艺术风格，",
    "start": 144.296,
    "end": 149.256,
    "duration": 4.96
  },
  {
    "id": 34,
    "text": "并以“三老汉撒纸钱”铸就了象征美学的华彩巅峰。",
    "start": 149.256,
    "end": 153.896,
    "duration": 4.64
  },
  {
    "id": 35,
    "text": "老舍将融汇英式幽默与民族悲剧心理的含泪微笑推向极境。",
    "start": 153.896,
    "end": 159.656,
    "duration": 5.76
  },
  {
    "id": 36,
    "text": "剧作极善于以世俗喜剧的形式反衬严酷的生存荒谬。",
    "start": 159.656,
    "end": 164.936,
    "duration": 5.28
  },
  {
    "id": 37,
    "text": "在第三幕结尾处，王利发、常四爷与秦仲义三位老友重聚。",
    "start": 164.936,
    "end": 170.216,
    "duration": 5.28
  },
  {
    "id": 38,
    "text": "他们以狂笑写至痛，互相作揖，漫天抛撒检来的冥纸。",
    "start": 170.376,
    "end": 175.336,
    "duration": 4.96
  },
  {
    "id": 39,
    "text": "这一震撼人心的现代象征仪式，不仅是老人们活着为自己凄凉出殡，",
    "start": 175.336,
    "end": 181.096,
    "duration": 5.76
  },
  {
    "id": 40,
    "text": "更是在深层意象上为半个世纪的三个黑暗旧时代举行了一场盛大辛辣的文化国葬。",
    "start": 181.096,
    "end": 188.856,
    "duration": 7.76
  },
  {
    "id": 41,
    "text": "第四，在戏剧语言上，老舍以纯正洗练的京味台词，",
    "start": 188.856,
    "end": 193.576,
    "duration": 4.72
  },
  {
    "id": 42,
    "text": "确立了中国现代话剧白话文学的最高典范。",
    "start": 193.576,
    "end": 197.016,
    "duration": 3.44
  },
  {
    "id": 43,
    "text": "《茶馆》彻底荡涤了中国早期话剧中的欧化翻译腔与概念化说教。",
    "start": 197.256,
    "end": 202.857,
    "duration": 5.601
  },
  {
    "id": 44,
    "text": "老舍将地道纯正的老北京市民口语提炼为富有诗意与潜台词的艺术语言。",
    "start": 202.857,
    "end": 209.536,
    "duration": 6.679
  },
  {
    "id": 45,
    "text": "剧作中的台词一句顶十句，极度洗练且高度性格化。",
    "start": 209.536,
    "end": 214.06,
    "duration": 4.524
  },
  {
    "id": 46,
    "text": "唐铁嘴的无耻俏皮、宋恩子与吴祥子的阴阳怪气以及常四爷的刚正硬气无不跃然纸上。",
    "start": 214.06,
    "end": 221.816,
    "duration": 7.756
  },
  {
    "id": 47,
    "text": "幽默的市井调侃化作了底层弱者对抗苦难的精神护甲，",
    "start": 221.896,
    "end": 226.376,
    "duration": 4.48
  },
  {
    "id": 48,
    "text": "语言极具文学张力与回味空间。",
    "start": 226.376,
    "end": 229.416,
    "duration": 3.04
  },
  {
    "id": 49,
    "text": "最后，在思想内涵上，剧作蕴含着深邃的历史哲学反思，",
    "start": 229.416,
    "end": 234.056,
    "duration": 4.64
  },
  {
    "id": 50,
    "text": "雄辩昭示了旧社会灭亡的历史必然性。",
    "start": 234.056,
    "end": 237.096,
    "duration": 3.04
  },
  {
    "id": 51,
    "text": "老舍没有从正面描写激烈的枪林弹雨与政党交锋，",
    "start": 237.096,
    "end": 240.936,
    "duration": 3.84
  },
  {
    "id": 52,
    "text": "而是通过一座小茶馆的人情冷暖与盛极而衰，",
    "start": 240.936,
    "end": 244.456,
    "duration": 3.52
  },
  {
    "id": 53,
    "text": "回答了重大的历史命题。",
    "start": 244.456,
    "end": 245.976,
    "duration": 1.52
  },
  {
    "id": 54,
    "text": "无论是王利发的改良主义、常四爷的硬骨头道德自救，",
    "start": 246.216,
    "end": 250.456,
    "duration": 4.24
  },
  {
    "id": 55,
    "text": "还是秦仲义的资本救国，在旧体制下全告破灭。",
    "start": 250.456,
    "end": 254.536,
    "duration": 4.08
  },
  {
    "id": 56,
    "text": "剧作以最无情的写实逻辑证明了改良道路走不通，",
    "start": 254.536,
    "end": 258.536,
    "duration": 4.0
  },
  {
    "id": 57,
    "text": "宣告了旧时代不可逆转的死亡判决，",
    "start": 258.536,
    "end": 261.336,
    "duration": 2.8
  },
  {
    "id": 58,
    "text": "彰显出只有彻底变革旧世界才是人民唯一出路的深刻历史真理。",
    "start": 261.336,
    "end": 266.696,
    "duration": 5.36
  },
  {
    "id": 59,
    "text": "综上所述，《茶馆》在结构创新、群像塑造、",
    "start": 266.936,
    "end": 270.616,
    "duration": 3.68
  },
  {
    "id": 60,
    "text": "象征意象、京味语言与历史哲学上均达到了不可逾越的高度。",
    "start": 270.616,
    "end": 275.416,
    "duration": 4.8
  },
  {
    "id": 61,
    "text": "它以民族化的形式开掘了全人类的悲剧命运，",
    "start": 275.416,
    "end": 279.016,
    "duration": 3.6
  },
  {
    "id": 62,
    "text": "是无愧于中国现代戏剧史最高殿堂的传世经典。--",
    "start": 279.016,
    "end": 282.616,
    "duration": 3.6
  }
]