[
  {
    "id": 1,
    "text": "试论老舍话剧《茶馆》的艺术成就与悲剧意蕴。",
    "start": 0.0,
    "end": 4.401,
    "duration": 4.401
  },
  {
    "id": 2,
    "text": "老舍晚期创作的三幕话剧巅峰《茶馆》，",
    "start": 4.401,
    "end": 7.759,
    "duration": 3.358
  },
  {
    "id": 3,
    "text": "是中国现代现实主义戏剧的扛鼎之作，",
    "start": 7.759,
    "end": 11.213,
    "duration": 3.454
  },
  {
    "id": 4,
    "text": "更是中国话剧民族化探索的最高丰碑。",
    "start": 11.213,
    "end": 14.498,
    "duration": 3.285
  },
  {
    "id": 5,
    "text": "剧作截取清末戊戌变法失败、",
    "start": 14.498,
    "end": 16.941,
    "duration": 2.443
  },
  {
    "id": 6,
    "text": "民国初年军阀混战与抗战胜利后国民党政权崩溃前夕三个历史断面，",
    "start": 16.941,
    "end": 22.889,
    "duration": 5.948
  },
  {
    "id": 7,
    "text": "通过北京裕泰茶馆半个世纪的沉浮衰亡，",
    "start": 22.889,
    "end": 26.084,
    "duration": 3.195
  },
  {
    "id": 8,
    "text": "为黑暗旧中国谱写了一曲沉痛而辛辣的时代挽歌。",
    "start": 26.084,
    "end": 30.381,
    "duration": 4.297
  },
  {
    "id": 9,
    "text": "老舍以独创的“图卷戏”散点透视结构、卓越的人物群像度量、",
    "start": 30.381,
    "end": 35.929,
    "duration": 5.548
  },
  {
    "id": 10,
    "text": "悲喜交融的幽默意象与炉火纯青的京味语言，",
    "start": 35.929,
    "end": 37.78,
    "duration": 1.851
  },
  {
    "id": 11,
    "text": "宣告了旧时代灭亡的历史必然性。",
    "start": 37.78,
    "end": 43.101,
    "duration": 5.321
  },
  {
    "id": 12,
    "text": "其卓越成就主要体现在以下五个核心维度：",
    "start": 43.101,
    "end": 44.192,
    "duration": 1.091
  },
  {
    "id": 13,
    "text": "第一，独创“图卷戏”三幕结构，",
    "start": 44.192,
    "end": 47.439,
    "duration": 3.247
  },
  {
    "id": 14,
    "text": "实现对西方锁闭式传统戏剧的审美超越。",
    "start": 47.439,
    "end": 53.099,
    "duration": 5.66
  },
  {
    "id": 15,
    "text": "《茶馆》打破了西方古典戏剧必须依附单一贯穿主角与严密因果锁闭冲突的既定模式，",
    "start": 53.099,
    "end": 57.621,
    "duration": 4.522
  },
  {
    "id": 16,
    "text": "创造性地借鉴了中国古代长卷画（如《清明上河图》）的散点透视法则。",
    "start": 57.621,
    "end": 66.217,
    "duration": 8.596
  },
  {
    "id": 17,
    "text": "老舍以裕泰茶馆为中心社会枢纽，",
    "start": 66.217,
    "end": 68.911,
    "duration": 2.694
  },
  {
    "id": 18,
    "text": "全剧没有贯穿到底的情节主线，",
    "start": 68.911,
    "end": 71.353,
    "duration": 2.442
  },
  {
    "id": 19,
    "text": "而是由数十个散碎生动的市井生活截面连缀而成。",
    "start": 71.353,
    "end": 74.316,
    "duration": 2.963
  },
  {
    "id": 20,
    "text": "三幕戏如同一幅缓缓展开的世俗风情长卷，",
    "start": 74.316,
    "end": 79.425,
    "duration": 5.109
  },
  {
    "id": 21,
    "text": "将清末至民国乱世的黑暗现实生动展览；全剧看似形散，",
    "start": 79.425,
    "end": 82.608,
    "duration": 3.183
  },
  {
    "id": 22,
    "text": "内在却被时代社会一步步走向崩溃溃烂的沉痛暗线牢牢统摄，",
    "start": 82.608,
    "end": 89.239,
    "duration": 6.631
  },
  {
    "id": 23,
    "text": "达到了“形散而神聚”的化境。",
    "start": 89.239,
    "end": 91.755,
    "duration": 2.516
  },
  {
    "id": 24,
    "text": "第二，卓越的群像谱系度量时代崩塌，",
    "start": 91.755,
    "end": 94.96,
    "duration": 3.205
  },
  {
    "id": 25,
    "text": "确立“没有主角的主角是时代”的深邃立意。",
    "start": 94.96,
    "end": 98.049,
    "duration": 3.089
  },
  {
    "id": 26,
    "text": "全剧登场人物多达七十余人，",
    "start": 98.049,
    "end": 100.361,
    "duration": 2.312
  },
  {
    "id": 27,
    "text": "老舍精湛地截取了每个人物在不同历史时期的一截生活切片。",
    "start": 100.361,
    "end": 105.168,
    "duration": 4.807
  },
  {
    "id": 28,
    "text": "最震撼人心的是王利发、",
    "start": 105.168,
    "end": 107.151,
    "duration": 1.983
  },
  {
    "id": 29,
    "text": "常四爷与秦仲义构成的“三位一体”悲剧：精明本分、",
    "start": 107.151,
    "end": 111.556,
    "duration": 4.405
  },
  {
    "id": 30,
    "text": "委曲求全以求自保的小商人王利发，",
    "start": 111.556,
    "end": 115.025,
    "duration": 3.469
  },
  {
    "id": 31,
    "text": "最终在茶馆被特务霸占后自缢后房；刚正耿直、",
    "start": 115.025,
    "end": 119.11,
    "duration": 4.085
  },
  {
    "id": 32,
    "text": "自食其力的硬汉常四爷，到头来冻饿交加，",
    "start": 119.11,
    "end": 123.282,
    "duration": 4.172
  },
  {
    "id": 33,
    "text": "连一口棺材都买不起；立志“实业救国”的民族资本家秦仲义，",
    "start": 123.282,
    "end": 127.712,
    "duration": 4.43
  },
  {
    "id": 34,
    "text": "耗尽心血办厂却被反动政府作为逆产没收拆毁。",
    "start": 127.712,
    "end": 131.919,
    "duration": 4.207
  },
  {
    "id": 35,
    "text": "三位不同阶层的好人走向共同的灭顶之灾，",
    "start": 131.919,
    "end": 135.499,
    "duration": 3.58
  },
  {
    "id": 36,
    "text": "雄辩地证明了真正被押上历史审判台的是那吃人的旧制度。",
    "start": 135.499,
    "end": 140.755,
    "duration": 5.256
  },
  {
    "id": 37,
    "text": "第三，熔铸悲喜交融的幽默格调，",
    "start": 140.755,
    "end": 143.715,
    "duration": 2.96
  },
  {
    "id": 38,
    "text": "以“三老汉撒纸钱”铸就象征主义的华彩巅峰。",
    "start": 143.715,
    "end": 148.106,
    "duration": 4.391
  },
  {
    "id": 39,
    "text": "老舍将融汇英式幽默与民族悲剧心理的“含泪微笑”推向极境，",
    "start": 148.106,
    "end": 151.646,
    "duration": 3.54
  },
  {
    "id": 40,
    "text": "极善于以喜剧的形式反衬严酷的生存荒谬。",
    "start": 151.646,
    "end": 157.225,
    "duration": 5.579
  },
  {
    "id": 41,
    "text": "在第三幕结尾处，王利发、常四爷与秦仲义三位白发老人重聚，",
    "start": 157.225,
    "end": 162.855,
    "duration": 5.63
  },
  {
    "id": 42,
    "text": "在穷途绝境中以狂笑写至痛，互相作揖、漫天抛撒捡来的冥纸。",
    "start": 162.855,
    "end": 166.78,
    "duration": 3.925
  },
  {
    "id": 43,
    "text": "这一极具现代象征意蕴的仪式，",
    "start": 166.78,
    "end": 168.839,
    "duration": 2.059
  },
  {
    "id": 44,
    "text": "不仅是老人们活着为自己凄凉出殡，",
    "start": 168.839,
    "end": 171.492,
    "duration": 2.653
  },
  {
    "id": 45,
    "text": "更是在深层意象上为半个世纪的三个黑暗旧时代举行了一场盛大而辛辣的文化国葬。",
    "start": 171.492,
    "end": 178.68,
    "duration": 7.188
  },
  {
    "id": 46,
    "text": "第四，提炼纯正洗练的京味语言，",
    "start": 178.68,
    "end": 182.331,
    "duration": 3.651
  },
  {
    "id": 47,
    "text": "确立中国现代白话话剧语言的最高典范。",
    "start": 182.331,
    "end": 184.701,
    "duration": 2.37
  },
  {
    "id": 48,
    "text": "《茶馆》彻底荡涤了中国早期话剧中的欧化翻译腔与概念化说教，",
    "start": 184.701,
    "end": 193.527,
    "duration": 8.826
  },
  {
    "id": 49,
    "text": "将地道的老北京市民口语提炼为富有诗意与潜台词的艺术语言。",
    "start": 193.527,
    "end": 197.65,
    "duration": 4.123
  },
  {
    "id": 50,
    "text": "老舍的台词“一句顶十句”，高度个性化：唐铁嘴的无耻俏皮、",
    "start": 197.65,
    "end": 201.973,
    "duration": 4.323
  },
  {
    "id": 51,
    "text": "宋恩子与吴祥子的阴阳怪气、常四爷的刚正硬朗，",
    "start": 201.973,
    "end": 205.011,
    "duration": 3.038
  },
  {
    "id": 52,
    "text": "无不跃然纸上。",
    "start": 205.011,
    "end": 207.746,
    "duration": 2.735
  },
  {
    "id": 53,
    "text": "幽默的市井调侃化作了底层弱者对抗苦难的精神护甲，",
    "start": 207.746,
    "end": 210.681,
    "duration": 2.935
  },
  {
    "id": 54,
    "text": "语言极具文学张力与咀嚼感。",
    "start": 210.681,
    "end": 215.014,
    "duration": 4.333
  },
  {
    "id": 55,
    "text": "第五，深邃的历史哲学反思，雄辩昭示了旧制度灭亡的历史必然性。",
    "start": 215.014,
    "end": 219.83,
    "duration": 4.816
  },
  {
    "id": 56,
    "text": "全剧未正面描写枪林弹雨与政党交锋，",
    "start": 219.83,
    "end": 222.755,
    "duration": 2.925
  },
  {
    "id": 57,
    "text": "却通过一座小茶馆的盛极而衰，",
    "start": 222.755,
    "end": 225.877,
    "duration": 3.122
  },
  {
    "id": 58,
    "text": "以最无情的写实逻辑解答了重大的历史命题：",
    "start": 225.877,
    "end": 229.839,
    "duration": 3.962
  },
  {
    "id": 59,
    "text": "无论是王利发的改良主义、常四爷的道德自救，",
    "start": 229.839,
    "end": 235.064,
    "duration": 5.225
  },
  {
    "id": 60,
    "text": "还是秦仲义的实业救国，在旧体制下全属幻想。",
    "start": 235.064,
    "end": 239.067,
    "duration": 4.003
  },
  {
    "id": 61,
    "text": "剧作通过三个好人的全面破灭，",
    "start": 239.067,
    "end": 241.449,
    "duration": 2.382
  },
  {
    "id": 62,
    "text": "为旧时代判处了无可挽回的死刑，",
    "start": 241.449,
    "end": 244.468,
    "duration": 3.019
  },
  {
    "id": 63,
    "text": "昭示出唯有彻底的社会变革才是人民唯一生路的深刻历史真理。",
    "start": 244.468,
    "end": 249.949,
    "duration": 5.481
  },
  {
    "id": 64,
    "text": "综上所述，《茶馆》在结构创新、群像度量、象征意象、",
    "start": 249.949,
    "end": 254.53,
    "duration": 4.581
  },
  {
    "id": 65,
    "text": "语言造诣与历史哲学上均达到了不可逾越的高度，",
    "start": 254.53,
    "end": 258.545,
    "duration": 4.015
  },
  {
    "id": 66,
    "text": "是无愧于中国现代戏剧史最高殿堂的传世民族经典。",
    "start": 258.545,
    "end": 262.752,
    "duration": 4.207
  }
]